// A tour of the OS layer Congo needs, through the libc and posix packages:
// memory, files, directories, processes and the environment, each exercised
// and checked, one line printed per step. Build and run it with Congo:
//
//     python tools/congo/congo.py run        (from samples/oslayer)
//
// Everything is raw C: a C string is a 'cstr', a pointer to bytes ending in a
// NUL, and a string literal converts to one, so '"text"' passes straight to C
// (a pointer that may be null, or a buffer, stays a '*u8'); errors come back as C
// reports them. The same program runs on Windows and on Linux, with the
// same output: where the systems differ (the path separator, the shell's
// spelling of an echo, the status 'system' answers) it asks 'isWindows()'. The
// program works in a folder of its own under TEMP (TMPDIR or /tmp on Linux),
// 'oslayer-tour', and removes it, printing no path and no time, so its output
// is the same on every run.

mod oslayer;

import stdio use *;
import libc use * but getenv;
import posix use *;

// How many steps failed, which main returns as the exit status
let failures: Atomic[i32];

fn @initpure init() {
  failures = Atomic[i32].of(0i32);
}

// A step's result: its name, and whether what it checked held
fn step(what: &str, ok: bool) {
  if !ok {failures.add(1i32);};
  printStr(if ok {"  ok    "} else {"  FAIL  "});
  printStr(what);
  printStr("\n");
}

fn same(a: *u8, b: cstr) bool {strcmp(cstr.fromPtr(a), b) == 0i32}

// Memory: a list of i64 grown by doubling with realloc, then freed
fn memory() {
  printStr("memory\n");
  var cap = 2usize;
  var list = malloc(cap * 8usize) as *i64;
  var len = 0usize;
  while len < 100usize {
    if len == cap {
      cap = cap * 2usize;
      list = realloc(list as *u8, cap * 8usize) as *i64;
    };
    list[len] = i64.from(len) * i64.from(len);
    len = len + 1usize;
  };
  var sum = 0i64;
  var i = 0usize;
  while i < len {sum = sum + list[i]; i = i + 1usize;};
  // 0 + 1 + 4 + ... + 99*99 = 99*100*199/6
  step("100 squares kept through 6 reallocs sum to 328350", sum == 328350i64 && cap == 128usize);
  free(list as *u8);
  let zeroed = calloc(16usize, 1usize);
  step("calloc gives zeroed memory", zeroed[0] == 0u8 && zeroed[15] == 0u8);
  free(zeroed);
}

// Files: written, read back, their status taken, removed
fn files() {
  printStr("files\n");
  let name: cstr = "notes.txt";
  let text: cstr = "first line\nsecond line\n";
  let out = fopen(name, "wb");
  let wrote = fwrite(text.ptr(), 1usize, strlen(text), out);
  fflush(out);
  fclose(out);
  step("wrote 23 bytes to notes.txt", wrote == 23usize);

  var buf = new Array[u8, 64] <- fill 0u8;
  let back = fopen(name, "rb");
  let got = fread(&[]buf as *u8, 1usize, 63usize, back);
  fclose(back);
  step("read the same 23 bytes back", got == 23usize && same(&[]buf as *u8, text));

  var st = new Stat(0u64, 0u64, 0u16, 0u32, 0u32, 0u32, 0u64, 0i64, 0i64, 0i64, 0i64);
  step("stat: notes.txt exists, a regular file of 23 bytes",
    stat(name, &mut st) == 0i32 && (st.st_mode & S_IFMT) == S_IFREG && st.st_size == 23i64);
  step("stat: missing.txt does not exist", stat("missing.txt", &mut st) != 0i32);
}

// Directories: made, entered and left, the current one named, listed
fn directories() {
  printStr("directories\n");
  var here = new Array[u8, 4096] <- fill 0u8;
  var there = new Array[u8, 4096] <- fill 0u8;
  let herep: *u8 = &[]here as *u8;
  let therep: *u8 = &[]there as *u8;
  // The separator: '\' on Windows (whose getcwd writes it), '/' on Linux
  let slash = if isWindows() {92u8} else {47u8};
  getcwd(herep, 4096usize);
  step("mkdir made sub", mkdir("sub", 0x1EDu32) == 0i32);
  step("chdir went into sub", chdir("sub") == 0i32);
  getcwd(therep, 4096usize);
  let n = strlen(cstr.fromPtr(herep));
  step("getcwd there is getcwd here with a separator and sub after it",
    strlen(cstr.fromPtr(therep)) == n + 4usize && therep[n] == slash && same(therep + n + 1usize, "sub"));
  step("chdir came back out", chdir("..") == 0i32);
  let full = realpath("sub/../notes.txt", null);
  step("realpath of sub/../notes.txt is here with a separator and notes.txt after it",
    strlen(cstr.fromPtr(full)) == n + 10usize && full[n] == slash && same(full + n + 1usize, "notes.txt"));
  free(full);

  // Listing: the folder holds notes.txt and sub
  var count = 0i32;
  var sawNotes = false;
  var sawSub = false;
  let dir = opendir(".");
  var entry = readdir(dir);
  while entry != null {
    let e = entry as &dirent;
    let name: *u8 = &[]e.d_name as *u8;
    if !same(name, ".") && !same(name, "..") {count = count + 1i32;};
    if same(name, "notes.txt") && e.d_type == DT_REG {sawNotes = true;};
    if same(name, "sub") && e.d_type == DT_DIR {sawSub = true;};
    entry = readdir(dir);
  };
  closedir(dir);
  step("listing found two entries: notes.txt (a file) and sub (a directory)",
    count == 2i32 && sawNotes && sawSub);
}

// Processes and the environment: a variable set, a command run and heard
fn processes() {
  printStr("processes and the environment\n");
  step("setenv set OSLAYER_GREETING", setenv("OSLAYER_GREETING", "hello", 1i32) == 0i32);
  step("getenv reads it back", same(getenv("OSLAYER_GREETING"), "hello"));

  var buf = new Array[u8, 64] <- fill 0u8;
  let bufp: *u8 = &[]buf as *u8;
  let command: cstr = if isWindows() {"echo %OSLAYER_GREETING% from a child"}
    else {"echo $OSLAYER_GREETING from a child"};
  let pipe = popen(command, "r");
  let got = fread(bufp, 1usize, 63usize, pipe);
  let status = pclose(pipe);
  step("popen captured what the child printed, the variable included",
    status == 0i32 && got == 19usize && same(bufp, "hello from a child\n"));
  printStr("        the child said: ");
  printCStr(bufp);
  // 'system' answers the exit status on Windows, and on POSIX the status
  // 'wait' gives, the exit status in its second byte
  let leave: cstr = if isWindows() {"exit /b 7"} else {"exit 7"};
  let code = if isWindows() {system(leave)} else {system(leave) >> 8i32};
  step("system returns the command's exit status", code == 7i32);
}

// Everything made, removed
fn cleanUp() {
  printStr("cleaning up\n");
  step("removed notes.txt", remove("notes.txt") == 0i32);
  step("removed sub", rmdir("sub") == 0i32);
  step("left and removed oslayer-tour", chdir("..") == 0i32 && rmdir("oslayer-tour") == 0i32);
}

fn main() i32 {
  // A folder of our own under TEMP (TMPDIR or /tmp on Linux), cleared of
  // anything a stopped run left
  var temp: cstr = "/tmp";
  if isWindows() {
    temp = cstr.fromPtr(getenv("TEMP"));
  } else {
    let t = getenv("TMPDIR");
    if t != null {temp = cstr.fromPtr(t);};
  };
  chdir(temp);
  if chdir("oslayer-tour") == 0i32 {
    remove("notes.txt");
    rmdir("sub");
    chdir("..");
    rmdir("oslayer-tour");
  };
  mkdir("oslayer-tour", 0x1EDu32);
  if chdir("oslayer-tour") != 0i32 {
    printStr("cannot work in the temporary folder's oslayer-tour\n");
    return 1i32;
  };

  memory();
  files();
  directories();
  processes();
  cleanUp();
  failures.load()
}
