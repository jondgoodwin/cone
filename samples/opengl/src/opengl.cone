// opengl: a window cleared to a colour that the r, g and b keys toggle, until
// escape or closing the window ends it. The window is sdlopengl's, and the
// events are SDL's, through the binding sdl.

mod opengl;

import sdl;

use sdlopengl { SdlOpenGL, Rgba };

mut running = true;
mut background = Rgba[0., 0., 0., 1.];

fn main() i32 {
  // Initialize window and
  mut win SdlOpenGL;
  imm window = &mut win;
  if window.open() == false {
    return -1;
  }
  loadWorld();

  running = true;
  while running {
    // Handle queued user events
    mut event = sdl.Event.empty();
    while sdl.PollEvent(&mut event) {
      if event.type == sdl.QUIT {
        stopWorld();
      }
      if event.type == sdl.KEYDOWN {
        imm keyevent = &event as &sdl.KeyboardEvent;
        handleKey(keyevent.keysym.sym);
      }
    }

    // Handle scene rendering
    window.clear(background);
    window.swapWindow();
  }

  window.close();
  0;
}

fn stopWorld() {
  running = false;
}

fn loadWorld() {
  background = Rgba[0.0, 0.0, 0.0, 1.0];
}

fn handleKey(k u32) { // SDL_Keycode
  imm key = u8[k];
  if key == 27 {  // escape
    stopWorld();
  } elif key == 'r' {
    background.r = 1.0 - background.r;
  } elif key == 'g' {
    background.g = 1.0 - background.g;
  } elif key == 'b' {
    background.b = 1.0 - background.b;
  }
}
