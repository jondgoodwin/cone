// gl: the binding to the C library OpenGL, the part of it this sample uses.
// '@c("gl", system)' makes it a C-named module whose functions take the prefix
// and then the name as written, so 'ClearColor' binds to glClearColor, and the
// platform's system calling convention, which OpenGL's functions use on Windows.

mod @c("gl", system) gl;

pub extern {
  fn ClearColor(r f32, g f32, b f32, a f32);
  fn Clear(bits u32);
}

pub const COLOR_BUFFER_BIT u32 = 0x00004000u;
