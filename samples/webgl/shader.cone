// shader: a WebGL program that draws each vertex in its own colour

mod shader;

import gl;
import mat4 use Mat4;
import buffer use VertexBuffer;

// Vertex shader
imm vsSrc = "
attribute vec3 aVertexPosition;
attribute vec4 aVertexColor;

uniform mat4 uMVMatrix;
uniform mat4 uPMatrix;

varying vec4 vColor;

void main(void) {
	gl_Position = uPMatrix * uMVMatrix * vec4(aVertexPosition, 1.0);
	vColor = aVertexColor;
}
";

// Fragment shader
imm fsSrc = "
precision mediump float;

varying vec4 vColor;

void main(void) {
	gl_FragColor = vColor;
}
";

pub struct ColoredPointShader {
	pgm u32 = 0u;
	posAttr u32 = 0u;
	colorAttr u32 = 0u;
	pmatUnif u32 = 0u;
	mvmatUnif u32 = 0u;

	pub fn init(self &mut) {
		pgm = gl.MakeShader(&[]vsSrc, (&[]vsSrc).len, &[]fsSrc, (&[]fsSrc).len);
		imm vpos = &[]"aVertexPosition";
		posAttr = gl.GetAttrib(pgm, vpos, vpos.len);
		imm vcol = &[]"aVertexColor";
		colorAttr = gl.GetAttrib(pgm, vcol, vcol.len);
		imm uPMat = &[]"uPMatrix";
		pmatUnif = gl.GetUniformLocation(pgm, uPMat, uPMat.len);
		imm uMVMat = &[]"uMVMatrix";
		mvmatUnif = gl.GetUniformLocation(pgm, uMVMat, uMVMat.len);
	}

	pub fn bind(self &, pMatrix &Mat4, mvMatrix &Mat4, posBuffer &VertexBuffer, colorBuffer &VertexBuffer) {
		gl.UniformMatrix4fv(pmatUnif, pMatrix);
		gl.UniformMatrix4fv(mvmatUnif, mvMatrix);

		posBuffer.bind(posAttr);
		colorBuffer.bind(colorAttr);
	}

	fn final(self &uni) {
		gl.DeleteProgram(pgm);
	}
}

