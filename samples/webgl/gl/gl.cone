// gl: the binding to WebGL, which webgl.js supplies to the WebAssembly module
// as imports. '@c("gl")' makes it a C-named module: each function takes the
// prefix and then the name as written, so 'CreateShader' is the import
// glCreateShader, as wasm.syms and webgl.js spell it.

mod @c("gl") gl;

import mat4 use Mat4;

pub const COMPILE_STATUS = 0x8B81u;
pub const VERTEX_SHADER = 0x8B31u;
pub const FRAGMENT_SHADER = 0x8B30u;
pub const LINK_STATUS = 0x8B82u;
pub const ARRAY_BUFFER = 0x8892u;
pub const ELEMENT_ARRAY_BUFFER = 0x8893u;
pub const FLOAT = 0x1406u;
pub const UNSIGNED_SHORT = 0x1403u;
pub const STATIC_DRAW = 0x88E4u;
pub const TRIANGLES = 0x0004u;

pub const COLOR_BUFFER_BIT = 0x4000u;
pub const DEPTH_BUFFER_BIT = 0x0100u;

pub extern {
	fn CreateShader(type u32) u32;
	// fn DeleteShader(shader u32);
	fn ShaderSource(shader u32, src &[]u8);
	fn CompileShader(shader u32);
	fn GetShaderParameter(shader u32, flag u32) u32;
	// fn GetShaderInfoLog(shader u32) *u8;

	fn CreateProgram() u32;
	fn DeleteProgram(pgm u32);
	// fn AttachShader(shaderpgm u32, shader u32);
	// fn LinkProgram(shaderpgm u32);
	// fn GetProgramParameter(shaderpgm u32, flag u32) u32;
	fn UseProgram(shaderpgm u32);
	fn GetAttribLocation(pgm u32, name *u8, namesz u32) u32;
	// fn EnableVertexAttribArray(pgm u32);
	fn GetUniformLocation(pgm u32, name *u8, namelen usize) u32;
	fn UniformMatrix4fv(loc u32, val *Mat4);
	fn BindBuffer(target u32, buffer u32);
	fn VertexAttribPointer(loc u32, size usize, type u32, norm Bool,stride u32,offset u32);
	fn BufferData(target u32, arr *u8, arrsz usize, usage u32);
	fn CreateBuffer() u32;

	fn Clear(flags u32);
	fn DrawArrays(mode u32, hmm u32, nitems usize);
	fn DrawElements(mode u32, nitems usize, nbrtype u32, hmm u32);
	fn GetAspectRatio() f32;

	// The two helpers webgl.js adds to WebGL: compile and link a program from
	// its two shaders' source, and find one of its attributes
	fn MakeShader(vssrc *u8, vssrclen usize, fssrc *u8, fssrclen usize) u32;
	fn GetAttrib(pgm u32, name *u8, namelen usize) u32;
}
