// buffer: WebGL buffers of vertex data and of the indices that pick vertices

mod buffer;

import gl;

pub struct VertexBuffer {
	uid u32 = 0u;
	itemsize u32 = 0u;

	pub fn init(self &mut, itemsz usize, array &[]f32) {
		itemsize = u32[itemsz];
		uid = gl.CreateBuffer();
		gl.BindBuffer(gl.ARRAY_BUFFER, uid);
		imm arr *f32 = array;
		imm arrsize = array.len;
		gl.BufferData(gl.ARRAY_BUFFER, arr as *u8, 4usize*arrsize, gl.STATIC_DRAW);
	}

	pub fn bind(self &, attrId u32) {
		gl.BindBuffer(gl.ARRAY_BUFFER, uid);
		gl.VertexAttribPointer(attrId, itemsize, gl.FLOAT, false, 0, 0);
	}
}

pub struct IndexBuffer {
	uid u32 = 0u;
	itemsize u32 = 0u;

	pub fn init(self &mut, itemsz usize, array &[]u16) {
		itemsize = u32[itemsz];
		uid = gl.CreateBuffer();
		gl.BindBuffer(gl.ELEMENT_ARRAY_BUFFER, uid);
		imm arr *u16 = array;
		imm arrsize = array.len;
		gl.BufferData(gl.ELEMENT_ARRAY_BUFFER, arr as *u8, 2usize*arrsize, gl.STATIC_DRAW);
	}
}
