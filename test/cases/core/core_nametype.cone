// A ':' between a name and its type, in each place they meet: a global and a
// constant, a local and a static, a parameter (with a default, a receiver, a
// closure's, a function type's), a field, a type parameter and what it must
// be, an enum and its integer type. A return type is bare, and a pattern's
// binding, a variant after `let` and before `else`, is written with none.
// The old spelling and its refusals are in core_parse_nametype.

mod core_nametype;

import stdio use *;

let base: i64 = 40;
var @threadlocal count: i64 = 0;
const SCALE: i64 = 2;

struct Pair {
  pub a: i32 = 1;
  pub b: i32 = 2;
  static var made: i32 = 0;

  fn sum(self: &) i32 {
    a + b
  }

  fn grow(self: &mut, step: i32 = 10) {
    a += step;
  }
}

trait Shape {
  fn area(self: &, scale: i32) i32;
}

struct Square is Shape {
  side: i32;
  fn area(self: &, scale: i32) i32 {
    side * side * scale
  }
}

enum Level: u8 {
  Low = 1,
  High = 200;
}

enum Wrapper {
  pub tag: i32;
  _: tag;
  Plain;
  struct Boxed {
    pub n: i32;
  }
}

fn bound[T: Shape](s: &T) i32 {
  s.area(2)
}

fn viaSignature[F: fn(a: i32, b: i32) i32](f: &F, x: i32) i32 {
  f(x, x + 1)
}

fn plus(a: i32, b: i32 = 5) i32 {
  a + b
}

fn apply(f: &<fn(x: i32) i32, n: i32) i32 {
  f(n)
}

fn pick(r: Result[i32, i32]) i32 {
  let Ok(n) = r else { return -1; };
  n
}

fn main() {
  let loc: i32 = 7;
  var moving: i64 = base + count;
  moving += SCALE;
  static var calls: i32 = 0;
  calls += 1;
  let doubled = fn (x: i32) i32 { x * 2 };
  var p: Pair = Pair();
  p.grow();
  p.grow(5);
  let sq: Square = Square(side: 3);
  printInt(i64.from(loc)); printStr(" ");
  printInt(moving); printStr(" ");
  printInt(i64.from(calls)); printStr(" ");
  printInt(i64.from(doubled(loc))); printStr(" ");
  printInt(i64.from(plus(1))); printStr(" ");
  printInt(i64.from(plus(1, 2))); printStr(" ");
  printInt(i64.from(apply(&doubled, 4))); printStr(" ");
  printInt(i64.from(p.sum())); printStr(" ");
  printInt(i64.from(bound(&sq))); printStr(" ");
  printInt(i64.from(viaSignature(&plus, 3))); printStr(" ");
  printInt(i64.from(pick(Ok(9)))); printStr(" ");
  printInt(i64.from(pick(Error(1)))); printStr(" ");
  let lv: Level = Level.High;
  printInt(i64.from(match lv { case Low { 1 } case High { 2 } })); printStr("\n");
}
