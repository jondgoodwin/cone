mod nullable_literal_first;
import stdio use *;
import arena use *;

// A discarded literal of a nullable-pointer enum, the first use that lays out Option[&mut T].
// None holds no borrow, so the arena rule has nothing to refuse.
struct T { pub v: i64; }
fn keep(ar: &mut Arena) i64 { ar.alloc(None[&mut T]); 1 }
fn main() { var a = Arena(); print <- keep(&mut a), "\n"; }
