// A '?' after a term that failed to parse (Bug 111): there is no value for it to hold.
//
// The ')' is no term, so parseTerm reports 1006 and gives no node; the '?' after it used to
// copy the lexer position of that nothing and crashed the compiler.

mod core_parse_failed_propagate;

fn main() { )? }  //~ ErrorBadTerm "Invalid term: expected name, literal, etc."
                  //~^ ErrorNoSemi:14 "Expected ';' to end the statement" follow-on
                  //~^^ ErrorBadTerm:16 "Invalid term: expected name, literal, etc." follow-on
                  //~^^^ ErrorNoSemi:17 "Expected ';' to end the statement" follow-on
//~ ErrorNoRCurly "Expected end of block" follow-on
