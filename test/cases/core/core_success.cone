// The foundation every other group builds on: variables, number types,
// operators, blocks, 'if', 'while', functions, tuples and void.
//
// Everything is printed, because arithmetic that compiles is not arithmetic
// that is right. Function overload has its own scenario; so does everything
// that belongs to another group. Conversions appear only where a number type's
// own coverage needs them, and typemgmt owns their depth.

mod core_success;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showU(label: &str, n: u64) {
  printStr(label);
  printStr(" = ");
  printUInt(n);
  printStr("\n");
}

fn showF(label: &str, n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

// -------- global variables --------

// A global may infer its type from its initial value or state it explicitly
var @threadlocal counter = 0;
var @threadlocal total: i64 = 100i64;
let origin = 7;
let limit: i32 = 50;

// A private global, which is any global not declared 'pub'. Nothing else marks
// it: cases.toml pins that its symbol is spelled and linked like a pub one.
var @threadlocal hiddenTotal = 0;

// Source order does not decide what a function may name. Reaching a name
// analyzes that name's declaration before carrying on, so a function written
// above a global still sees a finished type -- including the case that has no
// other way to work, a global whose type comes from its own initial value.
fn readsWhatFollows() i64 {
  declaredLater + LATER_CONST
}

var @threadlocal declaredLater = 5i64;
const LATER_CONST = 6i64;

fn globals() {
  counter = counter + 1;
  total = total + 1;
  show("global-inferred", counter);
  show("global-typed", total);
  show("global-imm", origin);
  show("global-imm-typed", limit);
  show("global-declared-after-use", readsWhatFollows());
  hiddenTotal = hiddenTotal + 2;
  show("global-private", hiddenTotal);
}

// -------- local variables --------

fn locals() {
  // Inferred, explicitly typed, and assigned after declaration
  var a = 3;
  var b: i32 = 4;
  let c = 5;
  var d: i32;
  d = a + b + c;
  show("local-inferred", a);
  show("local-typed", b);
  show("local-imm", c);
  show("local-assigned-later", d);

  // Assignment is an expression, so it chains right to left
  var e = 0;
  var f = 0;
  e = f = 9;
  show("chained-assign-left", e);
  show("chained-assign-right", f);

  // An inner block has its own scope
  {
    var a = 100;
    show("inner-block-local", a);
  }
  show("outer-after-block", a);
}

// -------- number types --------

fn numbers() {
  // Every signed width holds its own range. A literal wider than i32 needs its
  // suffix: an unsuffixed literal is i32 and is truncated to fit, silently.
  var i8v: i8 = 127;
  var i16v: i16 = 32767;
  var i32v: i32 = 2147483647;
  var i64v: i64 = 9223372036854775807i64;
  var isizev: isize = 42;
  show("i8", i8v);
  show("i16", i16v);
  show("i32", i32v);
  show("i64", i64v);
  show("isize", isizev);

  // ... and every unsigned width
  var u8v: u8 = 255;
  var u16v: u16 = 65535;
  var u32v: u32 = 4294967295;
  var u64v: u64 = 18446744073709551615u64;
  var usizev: usize = 42;
  showU("u8", u8v);
  showU("u16", u16v);
  showU("u32", u32v);
  showU("u64", u64v);
  showU("usize", usizev);

  // Floats keep fractional values; f32 has less precision than f64
  var f32v: f32 = 0.5;
  var f64v: f64 = 0.1;
  showF("f32", f32v);
  showF("f64", f64v);

  // A narrower signed value widens into a wider parameter without a cast
  var small: i16 = 300;
  show("widened-to-i64", small);

  // bool is its own type, not a number
  var flag: bool = true;
  if flag {
    show("bool-true", 1);
  }

  // Explicit conversion between number types, which typemgmt owns in depth
  let truncated = i32.from(2.75);
  show("float-to-int", truncated);
  showF("int-to-float", f64.from(7));
}

// -------- operators --------

fn arithmetic() {
  var a = 17;
  var b = 5;
  show("add", a + b);
  show("subtract", a - b);
  show("multiply", a * b);
  show("divide", a / b);
  show("remainder", a % b);
  show("negate", -a);

  // Multiplication binds tighter than addition; parentheses override it
  show("precedence", 2 + 3 * 4);
  show("parenthesized", (2 + 3) * 4);

  // Floats use the same operators
  showF("float-add", 1.5 + 2.25);
  showF("float-divide", 7.5 / 2.5);
}

fn bitwise() {
  var a = 0x3C;
  var b = 0x0F;
  show("and", a & b);
  show("or", a | b);
  show("xor", a ^ b);
  show("not", ~a);
  show("shift-left", a << 2);
  show("shift-right", a >> 2);
}

fn comparison() {
  var a = 3;
  var b = 4;
  var n = 0;
  if a == b { n = n + 1; }
  if a != b { n = n + 2; }
  if a < b { n = n + 4; }
  if a <= b { n = n + 8; }
  if a > b { n = n + 16; }
  if a >= b { n = n + 32; }
  show("comparison-bits", n);
}

fn logic() {
  var t = true;
  var f = false;
  var n = 0;
  if t && !f { n = n + 1; }
  if f || t { n = n + 2; }
  if !f { n = n + 4; }
  show("logic-bits", n);

  // '&&' does not evaluate its right side when the left side is false
  var sideEffect = 0;
  if f && bump(&mut sideEffect) { sideEffect = sideEffect + 100; }
  show("and-short-circuits", sideEffect);

  // '||' does not evaluate its right side when the left side is true
  var other = 0;
  if t || bump(&mut other) { other = other + 1; }
  show("or-short-circuits", other);

  // '!' is not restricted to bool: a non-bool operand is coerced to bool
  // first, so a nonzero number is true and zero is false
  var five = 5;
  var zero = 0;
  var notBits = 0;
  if !five { notBits = notBits + 1; }
  if !zero { notBits = notBits + 2; }
  show("not-on-number", notBits);

  // '!' binds looser than a comparison, so this negates the comparison rather
  // than its left operand: it means !(five > 50), not (!five) > 50
  var looser = 0;
  if !five > 50 { looser = 1; }
  show("not-binds-looser-than-compare", looser);

  // A comparison and a negated comparison combine in one '&&' chain
  var chained = 0;
  if five > 1 && !five > 50 { chained = 1; }
  show("and-with-negated-compare", chained);
}

fn bump(n: &mut i32) bool {
  *n = *n + 1;
  true
}

fn opassign() {
  var n = 20;
  n += 5;
  show("plus-eq", n);
  n -= 3;
  show("minus-eq", n);
  n *= 2;
  show("mult-eq", n);
  n /= 4;
  show("div-eq", n);
  n %= 7;
  show("rem-eq", n);

  var bits = 0x3C;
  bits &= 0x0F;
  show("and-eq", bits);
  bits |= 0x30;
  show("or-eq", bits);
  bits ^= 0xFF;
  show("xor-eq", bits);
  bits <<= 1;
  show("shl-eq", bits);
  // The counterpart shift, whose value is what distinguishes it from the token
  // check in 'lexical': 390 is 0x186, and shifting it right twice gives 0x61
  bits >>= 2;
  show("shr-eq", bits);
}

fn incrdecr() {
  var n = 10;
  n++;
  show("postfix-incr", n);
  n--;
  show("postfix-decr", n);
  ++n;
  show("prefix-incr", n);
  --n;
  show("prefix-decr", n);

  // A float steps by 1.0 at either width. An f64 once took the integer add
  // meant for an integer, which the verifier refuses
  var f = 1.5f32;
  f++;
  showF("f32-postfix-incr", f64.from(f));
  f--;
  f--;
  showF("f32-postfix-decr", f64.from(f));
  ++f;
  ++f;
  ++f;
  showF("f32-prefix-incr", f64.from(f));
  --f;
  showF("f32-prefix-decr", f64.from(f));
  var d = 1.5f64;
  d++;
  showF("f64-postfix-incr", d);
  d--;
  d--;
  showF("f64-postfix-decr", d);
  ++d;
  ++d;
  ++d;
  showF("f64-prefix-incr", d);
  --d;
  showF("f64-prefix-decr", d);
}

// -------- blocks as expressions --------

fn blocks() {
  // A block's value is the value of its last statement
  let fromBlock = {
    var a = 6;
    a * 7
  };
  show("block-value", fromBlock);

  // Blocks nest, and the inner one's value is the outer one's value
  let nested = {
    {
      3 + 4
    }
  };
  show("nested-block-value", nested);

  // A block with no statements at all. It is legal, it contributes nothing, and
  // it used to kill the compiler: the type check looked for the last statement
  // of a block that has none.
  var counter = 1;
  {
  }
  counter = counter + 1;
  show("empty-block-runs-on", counter);
}

// -------- methods on number types --------

// A number type is a namespace too. Its operators are methods in it under the
// operator's own name, and a few members are ordinary names. A call may name
// any of them the way it names a struct's method, and the operator names are
// how the operator forms above reach the same declarations.
fn methods() {
  var a = 17;
  var b = 5;
  // An operator called by its name, in backticks, is the operator
  show("method-plus-by-name", a.`+`(b));
  // '-' is an overload name on a number: with no argument it selects the
  // negation candidate, and with one the subtraction candidate
  show("method-minus-unary-by-name", a.`-`());
  show("method-minus-binary-by-name", a.`-`(b));
  // A named method, on a value and through a reference to one
  var f = 9.0;
  showF("method-sqrt", f.sqrt());
  showF("method-sqrt-through-ref", (&f).sqrt());
  // The method a condition coerces a number through, called directly
  var truth = 0;
  if a.isTrue() { truth = 1; }
  show("method-istrue", truth);
}

// -------- if --------

fn conditionals() {
  var n = 2;

  // As a statement, with all three clause spellings
  var branch = 0;
  if n == 1 {
    branch = 1;
  } elif n == 2 {
    branch = 2;
  } else {
    branch = 3;
  }
  show("elif-taken", branch);

  // 'else if' means the same thing as 'elif'
  var branch2 = 0;
  if n == 1 {
    branch2 = 1;
  } else if n == 2 {
    branch2 = 2;
  } else {
    branch2 = 3;
  }
  show("else-if-taken", branch2);

  // As an expression, where every branch supplies a value
  let chosen = if n > 0 {10} else {20};
  show("if-expression", chosen);

  // An 'if' with no matching branch and no else runs nothing
  var untouched = 5;
  if n == 99 {
    untouched = 0;
  }
  show("if-not-taken", untouched);
}

// -------- while, break, continue --------

fn loops() {
  // A conditional loop
  var sum = 0;
  var i = 1;
  while i <= 5 {
    sum = sum + i;
    i++;
  }
  show("while-sum", sum);

  // 'break' leaves the loop early
  var found = 0;
  var j = 0;
  while j < 100 {
    if j == 7 {
      found = j;
      break;
    }
    j++;
  }
  show("break-at", found);

  // 'continue' skips the rest of this iteration
  var odds = 0;
  var k = 0;
  while k < 10 {
    k++;
    if k % 2 == 0 {
      continue;
    }
    odds = odds + k;
  }
  show("continue-skips-evens", odds);

  // A loop with no condition is an expression, and 'break' supplies its value
  var m = 0;
  let produced = while {
    m++;
    if m == 4 {
      break m * 10;
    }
  };
  show("loop-expression-value", produced);

  // A lifetime label lets 'break' leave an outer loop from an inner one
  var escaped = 0;
  'outer: while {
    var p = 0;
    while p < 10 {
      p++;
      if p == 3 {
        escaped = p;
        break 'outer;
      }
    }
  }
  show("labeled-break", escaped);

  // A labeled 'break' may carry a value too, and the two loops here take their
  // values from two different breaks: the labeled one supplies the outer
  // loop's value from inside the inner loop, while the unlabeled one supplies
  // the inner loop's value on every iteration that does not escape.
  var n = 0;
  var innerTotal = 0;
  let outerValue = 'esc: while {
    n++;
    let doubled = while {
      if n >= 4 {
        break 'esc n * 100;
      }
      if n < 4 {
        break n * 2;
      }
    };
    innerTotal = innerTotal + doubled;
  };
  show("labeled-break-value", outerValue);
  show("inner-break-total", innerTotal);

  // A loop bound to a name whose every break carries no value has void type:
  // the paths still converge on one basic block, but there is no value for
  // them to converge on. Code generation used to build a phi there anyway,
  // over a count it had never initialized, and emitted one with no incoming
  // entries. Nothing at run time can see that -- only the --verify every
  // 'run' scenario is compiled with rejects it -- so the assertion this case
  // carries is that it compiles at all, and the value shown is only proof the
  // loop ran.
  var q = 0;
  let novalue = while {
    q++;
    if q > 2 { break; } else { break; }
  };
  show("void-loop-as-expression", q);
}

// -------- functions --------

fn twice(n: i32) i32 {
  n * 2
}

// The last expression is the return value; 'return' says so explicitly
fn signOf(n: i32) i32 {
  if n < 0 {
    return -1;
  }
  if n > 0 {
    return 1;
  }
  0
}

// A parameter may declare a default, which later parameters must also do
fn addStep(n: i32, step: i32 = 1) i32 {
  n + step
}

// Every parameter may have a default, and a call leaves off any trailing run
// of them. A default ends at its comma, which begins the next parameter; a
// constant widened to the parameter's type is a default like a literal.
const STEP_CONST = 3;
fn addSteps(a: i64 = 1, b: i64 = STEP_CONST, c: i64 = 5) i64 {
  a * 100 + b * 10 + c
}

// A function with no declared return type returns void
fn recordIt(n: i32) {
  counter = counter + n;
}

// Counts its calls, so a caller can see whether it was evaluated
fn tally() i32 {
  counter = counter + 1;
  counter
}

// Several return values are a tuple
fn minmax(a: i32, b: i32) i32, i32 {
  if a < b {
    return a, b;
  }
  b, a
}

// The same signature spelled through a type alias, and through an alias of an
// alias. An alias is transparent and nothing rewrites it away, so a return
// type written this way stands in the IR as the name it was written with; the
// tuple is found by resolving it.
alias Pair = (i32, i32);
alias PairAgain = Pair;

fn minmaxAlias(a: i32, b: i32) Pair {
  if a < b {
    return a, b;
  }
  b, a
}

fn minmaxAliasAgain(a: i32, b: i32) PairAgain {
  if a < b {
    return a, b;
  }
  b, a
}

fn factorial(n: i32) i32 {
  if n <= 1 {
    return 1;
  }
  n * factorial(n - 1)
}

fn inlined(n: i32) i32 inline {
  n + 1
}

// A return in an inline body leaves the body with its value, not the caller,
// and wherever the call sits, the value is whichever return ran
fn inlinedEarly(n: i32) i32 inline {
  if n == 0 {
    return 5;
  }
  n + 1
}

fn inlinedFirstSquareOver(limit: i32) i32 inline {
  var i = 0;
  while true {
    if i * i > limit {
      return i;
    }
    i = i + 1;
  }
  -1
}

fn functions() {
  show("call", twice(21));
  show("return-negative", signOf(-5));
  show("return-positive", signOf(5));
  show("return-fallthrough", signOf(0));
  show("default-parm-omitted", addStep(10));
  show("default-parm-given", addStep(10, 5));
  show("default-parms-all-omitted", addSteps());
  show("default-parms-first-given", addSteps(4));
  show("default-parms-two-given", addSteps(4, 6));
  show("default-parms-all-given", addSteps(4, 6, 8));
  show("recursion", factorial(5));
  show("inline-call", inlined(41));
  show("inline-return-taken", inlinedEarly(0));
  show("inline-return-passed", inlinedEarly(1));
  show("inline-return-eq", if inlinedEarly(0) == 5 {1} else {0});
  show("inline-return-ne", if inlinedEarly(1) != 2 {1} else {0});
  show("inline-return-lt", if inlinedEarly(0) < 6 {1} else {0});
  show("inline-return-arith", inlinedEarly(0) * 100 + inlinedEarly(1));
  show("inline-return-neg", -inlinedEarly(0));
  show("inline-return-arg", twice(inlinedEarly(0)));
  show("inline-return-loop", inlinedFirstSquareOver(10));

  // A void call is a statement, not a value
  counter = 0;
  recordIt(3);
  show("void-call-effect", counter);
}

// -------- tuples --------

fn tuples() {
  // Several values assigned in one statement
  var a = 1;
  var b = 2;
  a, b = b, a;
  show("tuple-swap-a", a);
  show("tuple-swap-b", b);

  // Each target takes exactly one value, and a '_' is the target of a value the
  // code does not want: it is still evaluated, and dropped at the statement's end
  counter = 0;
  a, _, b = 5, 6, tally();
  show("underscore-parallel-a", a);
  show("underscore-parallel-b", b);
  show("underscore-evaluated", counter);

  // An assignment's value is its rval's, so here the whole value tuple
  let whole = (a, b = 1, 2);
  show("assignment-value", whole.1);
  show("assignment-lval", a);

  // A tuple-typed variable, and access to its elements by position
  var pair: (i32, i32) = minmax(9, 4);
  show("tuple-element-0", pair.0);
  show("tuple-element-1", pair.1);

  // An element by position is an lval, so a reference may be taken to one and
  // written through. Code generation tested the index against a type tag where
  // the index is a literal expression, so the test never matched -- and with
  // the assert behind it compiled out of a Release build, control fell into
  // the next case and read the field access as a string literal. Borrowing a
  // tuple element crashed the compiler.
  let first = &pair.0;
  let second = &mut pair.1;
  *second = 40;
  show("tuple-element-borrowed", *first);
  show("tuple-element-written-through", pair.1);

  // Several return values received into separate variables
  var lo: i32;
  var hi: i32;
  lo, hi = minmax(12, 3);
  show("multi-return-lo", lo);
  show("multi-return-hi", hi);

  // ... and received the same way when the return type is a name standing for
  // the tuple. The type check read the call's type raw and asked whether it was
  // a tuple, so the alias answered no and the assignment was refused for not
  // having enough values; the flow pass read the same field with no test at all
  // and walked the alias's own node as if it were the element list.
  lo, hi = minmaxAlias(12, 3);
  show("multi-return-alias-lo", lo);
  show("multi-return-alias-hi", hi);
  lo, hi = minmaxAliasAgain(12, 3);
  show("multi-return-alias-of-alias-lo", lo);
  show("multi-return-alias-of-alias-hi", hi);

  // The other side of the flow read: destructuring a variable of the aliased
  // type, where the value is not a call's temporary
  var aliased: Pair = minmax(9, 4);
  lo, hi = aliased;
  show("destructured-alias-variable-lo", lo);
  show("destructured-alias-variable-hi", hi);
}

// -------- statics --------

// A static in a function is one copy shared by every call, initialized once
// before anything runs, and kept across calls. Its initializer is a literal,
// as a global's is.
fn tick() i32 {
  static var calls = 0;
  calls = calls + 1;
  calls
}

// Another function's static of the same name is another copy
fn tock() i32 {
  static var calls = 100;
  calls = calls + 1;
  calls
}

// A static declared without 'mut' is immutable, like any other 'imm'
fn fixed() i32 {
  static limit = 40;
  limit + 2
}

// At module scale, a static is one copy per instantiation of the module, as for a
// generic type. A module that is not generic has one, so this is a global by
// another name; the keyword is accepted so `static` reads the same at every scale.
static var @threadlocal moduleStatic = 7;

fn statics() {
  tick();
  tick();
  show("static-shared-across-calls", tick());
  show("static-per-function", tock());
  show("static-imm", fixed());
  moduleStatic = moduleStatic + 1;
  show("static-at-module-scale", moduleStatic);
}

fn main() i32 {
  globals();
  locals();
  numbers();
  arithmetic();
  bitwise();
  comparison();
  logic();
  opassign();
  incrdecr();
  blocks();
  methods();
  conditionals();
  loops();
  functions();
  tuples();
  statics();
  0i32
}
