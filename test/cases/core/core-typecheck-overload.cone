// Overload sets that could never choose, and overload names used as values.
//
// Type-check stage. Two candidates accepting the same parameter signature is a
// property of the set, checked once at the set rather than at any call; return
// types take no part, so differing in one does not separate them. An overload
// name has no value of its own, so it may appear only as a call's callee.

// Return types do not distinguish candidates
fn sameInt overload same(n i32) i32 {
  n
}

fn sameFloat overload same(n i32) f32 {  //~ ErrorDupOverload:1 "accepts the same arguments as sameInt, so overload same could never choose between them"
  1.0
}

// Two declarations that answer to one overload name
fn showInt overload show(n i64) {
  imm ignored = n
  return
}

fn showFloat overload show(n f64) {
  imm ignored = n
  return
}

// Stored rather than called
fn storeIt() {
  imm f = show         //~ ErrorOverloadUse:11 "may only be used as the name being called"
  return
}

// Returned rather than called. The failed return then has no type to match
// against the declared one.
fn returnIt() i64 {    //~ ErrorInvType:15 "This is the declared function's return type" follow-on
  show                 //~ ErrorOverloadUse:3 "may only be used as the name being called"
                       //~^ ErrorInvType:3 "Return expression type does not match return type" follow-on
}
