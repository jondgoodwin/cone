// Thread-local globals: '@threadlocal' after a module global's 'let' or 'var'
// gives every thread its own copy of it, each starting from the initial value.
//
// The first half reads and writes thread-locals on the one thread every
// program has: a typed one, one whose type is inferred, a module 'static', one
// holding a struct, and one lent out by '&mut'. The second half is the claim
// itself. The program starts a second OS thread through Win32's CreateThread
// (kernel32, which the C runtime's own startup links in) or, off Windows, the
// C library's pthread_create, and the thread sees its own copy: the initial
// value, not what main wrote, and a write of its own that main never sees.

mod core_threadlocal;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pair {
  pub a: i64;
  pub b: i64;
}

var @threadlocal slot: i64 = 0i64;
var @threadlocal inferred = 40i64;
static var @threadlocal counted: i64 = 100i64;
pub var @threadlocal pair: Pair = Pair(3i64, 4i64);
var plain: i64 = 7i64;

fn bump(n: &mut i64) {
  *n = *n + 1i64;
}

// A thread's entry, as CreateThread calls it: its argument, and the exit code.
// pthread_create takes the same function, which returns a pointer where this
// returns 32 bits; nothing reads what it returns
alias ThreadStart = &fn(arg: usize) u32;

extern fn @c(system) CreateThread(attrs: usize, stack: usize, start: ThreadStart, arg: usize, flags: u32, id: usize) usize;
extern fn @c(system) WaitForSingleObject(handle: usize, ms: u32) u32;
extern fn @c(system) CloseHandle(handle: usize) i32;

// The same on POSIX: the C library's own, declared on every platform and
// called only on the one that has it
extern fn @c pthread_create(thread: *usize, attr: usize, start: ThreadStart, arg: usize) i32;
extern fn @c pthread_join(thread: usize, result: usize) i32;

// Start a thread running 'worker' and wait for it to end
fn runWorker() {
  if isWindows() {
    let handle = CreateThread(0usize, 0usize, &worker, 0usize, 0u32, 0usize);
    WaitForSingleObject(handle, 0xFFFFFFFFu32);
    CloseHandle(handle);
  }
  else {
    var handle = 0usize;
    pthread_create(&mut handle as *usize, 0usize, &worker, 0usize);
    pthread_join(handle, 0usize);
  }
}

fn worker(arg: usize) u32 {
  show("thread slot starts", slot);
  show("thread counted starts", counted);
  slot = 2i64;
  counted = counted + 5i64;
  show("thread slot", slot);
  show("thread counted", counted);
  plain = plain + 1i64;
  0u32
}

fn main() i32 {
  show("slot", slot);
  slot = 1i64;
  show("slot written", slot);
  inferred = inferred + 2i64;
  show("inferred", inferred);
  counted = counted + 1i64;
  show("counted", counted);
  pair.b = pair.a + pair.b;
  show("pair.b", pair.b);
  bump(&mut slot);
  bump(&mut slot);
  show("slot bumped", slot);

  runWorker();

  // main's copies are as main left them; the ordinary global is shared
  show("slot after join", slot);
  show("counted after join", counted);
  show("plain after join", plain);
  0i32
}
