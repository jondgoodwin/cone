// A local 'let' or 'var' that nothing reads is warned (WarnUnusedVar), and so is
// one that is only written to. A name that starts with '_' says the variable is
// meant, and is exempt. Nothing here is called: a warn scenario is compiled and
// never run.

mod core_warn_unused_var;

fn never(a: i32) {
  let unused = a + 1;       //~ WarnUnusedVar:7 "unused is never used."
  var counter = 0;          //~ WarnUnusedVar:7 "counter is written but never read."
  counter = 5;
}

// Every kind of read counts, and so does one inside a nested block
fn reads(a: i32) i32 {
  let x = a + 1;
  var y = 2;
  y = x;
  var z = 0;
  if a > 0 {
    z += 1;
  }
  let inner = 7;
  { let w = inner; _ = w; }
  x + y + z
}

// The underscore says it is meant, and so does '_' itself
fn meant() {
  let _kept = 3;
  var _scratch = 0;
  _scratch = 1;
  let _ = 4;
}

// A read in a closure is a read
fn captured() i32 {
  let base = 10;
  let add = fn(n: i32) i32 { n + base };
  add(1)
}
