// 'char.from(n)' of a number that is no code point is U+FFFD, the replacement
// character (Bug 43): above 0x10FFFF, a surrogate (0xD800 to 0xDFFF), a negative,
// and a float's conversion (cut toward zero, saturating; a NaN is none). A u8
// is always a code point. The numbers reach 'char.from' through calls, so they
// are run-time values; a constant that is no code point is refused
// (core_typecheck_fromconst).

mod core_char_from;

import stdio use *;

fn zero() f64 { 0.0 }

fn code(c: char) u32 { u32.from(c) }

fn show(label: &str, c: char) {
  printStr(label); printStr(" "); printUInt(u64.from(code(c))); printStr("\n");
}

fn fromU32(n: u32) char { char.from(n) }
fn fromU16(n: u16) char { char.from(n) }
fn fromU64(n: u64) char { char.from(n) }
fn fromI32(n: i32) char { char.from(n) }
fn fromI64(n: i64) char { char.from(n) }
fn fromU8(n: u8) char { char.from(n) }
fn fromF64(x: f64) char { char.from(x) }
fn fromF32(x: f32) char { char.from(x) }

fn main() {
  show("u32 0x10FFFF", fromU32(0x10FFFFu32));
  show("u32 0x110000", fromU32(0x110000u32));
  show("u32 0xD7FF", fromU32(0xD7FFu32));
  show("u32 0xD800", fromU32(0xD800u32));
  show("u32 0xDFFF", fromU32(0xDFFFu32));
  show("u32 0xE000", fromU32(0xE000u32));
  show("u32 max", fromU32(0xFFFFFFFFu32));
  show("u32 65", fromU32(65u32));
  show("u32 0", fromU32(0u32));
  show("u16 0xD7FF", fromU16(0xD7FFu16));
  show("u16 0xD800", fromU16(0xD800u16));
  show("u16 0xDFFF", fromU16(0xDFFFu16));
  show("u16 0xE000", fromU16(0xE000u16));
  show("u16 max", fromU16(0xFFFFu16));
  show("u64 0x10FFFF", fromU64(0x10FFFFu64));
  show("u64 0x110000", fromU64(0x110000u64));
  show("u64 2^32+65", fromU64(0x100000041u64));
  show("u64 max", fromU64(0xFFFFFFFFFFFFFFFFu64));
  show("i32 -1", fromI32(-1i32));
  show("i32 min", fromI32(-2147483648i32));
  show("i32 max", fromI32(2147483647i32));
  show("i32 66", fromI32(66i32));
  show("i64 -1", fromI64(-1i64));
  show("i64 0xD800", fromI64(0xD800i64));
  show("i64 0x10FFFF", fromI64(0x10FFFFi64));
  show("u8 0", fromU8(0u8));
  show("u8 255", fromU8(255u8));
  show("f64 66.9", fromF64(66.9));
  show("f64 -0.5", fromF64(0.0 - 0.5));
  show("f64 -1.0", fromF64(0.0 - 1.0));
  show("f64 1114111.0", fromF64(1114111.0));
  show("f64 1114112.0", fromF64(1114112.0));
  show("f64 55296.0", fromF64(55296.0));
  show("f64 1e30", fromF64(1.0e30));
  show("f64 NaN", fromF64(zero() / zero()));
  show("f64 inf", fromF64(1.0 / zero()));
  show("f32 65.5", fromF32(65.5f32));
  show("f32 -1e30", fromF32(-1.0e30f32));
}
