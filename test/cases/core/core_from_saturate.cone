// A float converted with '.from' to an integer type saturates (Bug 43): a value
// too large gives the type's top, one too small its bottom (0 for an unsigned
// type), a NaN 0, and the fractional part is cut toward zero. No float has an
// undefined result. Every float width into every integer width, at the limits,
// just past them, and at the infinities and NaN, each checked against an
// oracle written with comparisons and the i64 conversion alone, which is
// defined on its own range. The values reach '.from' through a call, so they are
// run-time values; a constant that does not fit is refused (core_typecheck_floatfrom).

mod core_from_saturate;

import stdio use *;

fn zero() f64 { 0.0 }

fn val(i: i32) f64 {
  if i == 0i32 { return 0.0; }
  if i == 1i32 { return -0.0; }
  if i == 2i32 { return 0.4; }
  if i == 3i32 { return 0.9; }
  if i == 4i32 { return 1.0; }
  if i == 5i32 { return -0.4; }
  if i == 6i32 { return -0.9; }
  if i == 7i32 { return -1.0; }
  if i == 8i32 { return -1.5; }
  if i == 9i32 { return 127.0; }
  if i == 10i32 { return 127.5; }
  if i == 11i32 { return 128.0; }
  if i == 12i32 { return -128.0; }
  if i == 13i32 { return -128.5; }
  if i == 14i32 { return -129.0; }
  if i == 15i32 { return 255.0; }
  if i == 16i32 { return 255.5; }
  if i == 17i32 { return 256.0; }
  if i == 18i32 { return 32767.0; }
  if i == 19i32 { return 32768.0; }
  if i == 20i32 { return -32768.0; }
  if i == 21i32 { return -32769.0; }
  if i == 22i32 { return 65535.0; }
  if i == 23i32 { return 65536.0; }
  if i == 24i32 { return 2147483520.0; }
  if i == 25i32 { return 2147483647.0; }
  if i == 26i32 { return 2147483648.0; }
  if i == 27i32 { return -2147483648.0; }
  if i == 28i32 { return -2147483904.0; }
  if i == 29i32 { return 4294967295.0; }
  if i == 30i32 { return 4294967296.0; }
  if i == 31i32 { return 9223372036854774784.0; }
  if i == 32i32 { return 9223372036854775808.0; }
  if i == 33i32 { return -9223372036854775808.0; }
  if i == 34i32 { return -9223372036854777856.0; }
  if i == 35i32 { return 18446744073709549568.0; }
  if i == 36i32 { return 18446744073709551616.0; }
  if i == 37i32 { return 1.0e30; }
  if i == 38i32 { return -1.0e30; }
  if i == 39i32 { return 3.0e38; }
  if i == 40i32 { return zero() / zero(); }
  if i == 41i32 { return 1.0 / zero(); }
  -1.0 / zero()
}

var bad: i32 = 0;

// What a signed type holds from x: the oracle
fn wantS(x: f64, lo: f64, hi: f64, mini: i64, maxi: i64) i64 {
  if x != x { return 0i64; }
  if x <= lo { return mini; }
  if x >= hi { return maxi; }
  i64.from(x)
}

// What an unsigned type holds from x
fn wantU(x: f64, hi: f64, maxu: u64) u64 {
  if x != x { return 0u64; }
  if x <= 0.0 { return 0u64; }
  if x >= hi { return maxu; }
  if x < 9223372036854775808.0 { return u64.from(i64.from(x)); }
  u64.from(i64.from(x - 9223372036854775808.0)) + 9223372036854775808u64
}

fn failS(t: &str, i: i32, got: i64, want: i64) {
  bad = bad + 1;
  printStr("WRONG "); printStr(t); printStr(" value "); printInt(i64.from(i));
  printStr(" got "); printInt(got); printStr(" want "); printInt(want); printStr("\n");
}

fn failU(t: &str, i: i32, got: u64, want: u64) {
  bad = bad + 1;
  printStr("WRONG "); printStr(t); printStr(" value "); printInt(i64.from(i));
  printStr(" got "); printUInt(got); printStr(" want "); printUInt(want); printStr("\n");
}

fn check_i8(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantS(x, -128.0, 128.0, -128i64, 127i64);
  let ws = wantS(f64.from(s), -128.0, 128.0, -128i64, 127i64);
  let gd = i64.from(i8.from(x));
  let gs = i64.from(i8.from(s));
  if gd != wd { failS("i8 from f64", i, gd, wd); }
  if gs != ws { failS("i8 from f32", i, gs, ws); }
}

fn check_i16(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantS(x, -32768.0, 32768.0, -32768i64, 32767i64);
  let ws = wantS(f64.from(s), -32768.0, 32768.0, -32768i64, 32767i64);
  let gd = i64.from(i16.from(x));
  let gs = i64.from(i16.from(s));
  if gd != wd { failS("i16 from f64", i, gd, wd); }
  if gs != ws { failS("i16 from f32", i, gs, ws); }
}

fn check_i32(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantS(x, -2147483648.0, 2147483648.0, -2147483648i64, 2147483647i64);
  let ws = wantS(f64.from(s), -2147483648.0, 2147483648.0, -2147483648i64, 2147483647i64);
  let gd = i64.from(i32.from(x));
  let gs = i64.from(i32.from(s));
  if gd != wd { failS("i32 from f64", i, gd, wd); }
  if gs != ws { failS("i32 from f32", i, gs, ws); }
}

fn check_i64(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantS(x, -9.223372036854776e+18, 9.223372036854776e+18, -9223372036854775808i64, 9223372036854775807i64);
  let ws = wantS(f64.from(s), -9.223372036854776e+18, 9.223372036854776e+18, -9223372036854775808i64, 9223372036854775807i64);
  let gd = i64.from(i64.from(x));
  let gs = i64.from(i64.from(s));
  if gd != wd { failS("i64 from f64", i, gd, wd); }
  if gs != ws { failS("i64 from f32", i, gs, ws); }
}

fn check_isize(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantS(x, -9.223372036854776e+18, 9.223372036854776e+18, -9223372036854775808i64, 9223372036854775807i64);
  let ws = wantS(f64.from(s), -9.223372036854776e+18, 9.223372036854776e+18, -9223372036854775808i64, 9223372036854775807i64);
  let gd = i64.from(isize.from(x));
  let gs = i64.from(isize.from(s));
  if gd != wd { failS("isize from f64", i, gd, wd); }
  if gs != ws { failS("isize from f32", i, gs, ws); }
}

fn check_u8(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantU(x, 256.0, 255u64);
  let ws = wantU(f64.from(s), 256.0, 255u64);
  let gd = u64.from(u8.from(x));
  let gs = u64.from(u8.from(s));
  if gd != wd { failU("u8 from f64", i, gd, wd); }
  if gs != ws { failU("u8 from f32", i, gs, ws); }
}

fn check_u16(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantU(x, 65536.0, 65535u64);
  let ws = wantU(f64.from(s), 65536.0, 65535u64);
  let gd = u64.from(u16.from(x));
  let gs = u64.from(u16.from(s));
  if gd != wd { failU("u16 from f64", i, gd, wd); }
  if gs != ws { failU("u16 from f32", i, gs, ws); }
}

fn check_u32(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantU(x, 4294967296.0, 4294967295u64);
  let ws = wantU(f64.from(s), 4294967296.0, 4294967295u64);
  let gd = u64.from(u32.from(x));
  let gs = u64.from(u32.from(s));
  if gd != wd { failU("u32 from f64", i, gd, wd); }
  if gs != ws { failU("u32 from f32", i, gs, ws); }
}

fn check_u64(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantU(x, 1.8446744073709552e+19, 18446744073709551615u64);
  let ws = wantU(f64.from(s), 1.8446744073709552e+19, 18446744073709551615u64);
  let gd = u64.from(u64.from(x));
  let gs = u64.from(u64.from(s));
  if gd != wd { failU("u64 from f64", i, gd, wd); }
  if gs != ws { failU("u64 from f32", i, gs, ws); }
}

fn check_usize(i: i32) {
  let x = val(i);
  let s = f32.from(x);
  let wd = wantU(x, 1.8446744073709552e+19, 18446744073709551615u64);
  let ws = wantU(f64.from(s), 1.8446744073709552e+19, 18446744073709551615u64);
  let gd = u64.from(usize.from(x));
  let gs = u64.from(usize.from(s));
  if gd != wd { failU("usize from f64", i, gd, wd); }
  if gs != ws { failU("usize from f32", i, gs, ws); }
}

fn main() {
  var i = 0i32;
  while i < 43i32 {
    check_i8(i);
    check_i16(i);
    check_i32(i);
    check_i64(i);
    check_isize(i);
    check_u8(i);
    check_u16(i);
    check_u32(i);
    check_u64(i);
    check_usize(i);
    i = i + 1i32;
  }
  printStr("checked "); printInt(i64.from(i)); printStr(" values into 10 integer types from f64 and f32, wrong: ");
  printInt(i64.from(bad)); printStr("\n");

  // A few by hand
  printInt(i64.from(u8.from(val(37)))); printStr(" u8 of 1e30\n");
  printInt(i64.from(u8.from(val(40)))); printStr(" u8 of NaN\n");
  printInt(i64.from(i8.from(val(38)))); printStr(" i8 of -1e30\n");
  printInt(i64.from(i32.from(val(40)))); printStr(" i32 of NaN\n");
  printInt(i64.from(i32.from(val(37)))); printStr(" i32 of 1e30\n");
  printUInt(u64.from(usize.from(val(7)))); printStr(" usize of -1.0\n");
  printUInt(u64.from(usize.from(val(41)))); printStr(" usize of inf\n");
  printInt(i64.from(i64.from(val(32)))); printStr(" i64 of 2^63\n");
}
