// A raw pointer has no '<-': the send is refused as the missing method it is, as '<-' on an i32 is
// (ErrorNoMbr). It was accepted and left unlowered, and code generation called a method that was not
// there. (Bug 118.)

mod core_ptr_append_refused;

fn main() {
  var p = 0usize as *u32;
  var n = 5i32;
  p <- 1;               //~ ErrorNoMbr "`<-` not found"
  n <- 1;               //~ ErrorNoMbr "`<-` not found"
  let r = &mut p;
  *r <- 2;              //~ ErrorNoMbr "`<-` not found"
}
