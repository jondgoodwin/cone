// Malformed 'overload' declarations.
//
// Parse-stage: the overload name is read as part of the declaration's header,
// so these are all reported while parsing. An overload name that clashes with
// another kind of declaration is in core-parse-names; selection failures are in
// core-typecheck-overload.
//
// Two constructs appear here only because the diagnostic cannot be reached
// without them: a borrowed reference to an anonymous function, whose depth
// belongs to 'closure', and a generic parameter list, whose depth belongs to
// 'generic'.

// 'overload' must be followed by the name of the set being joined
fn missingName overload (n i32) i32 {  //~ ErrorBadOverload:25 "Expected the overload name that follows 'overload'"
  n
}

// A declaration's overload name is shared with others, so it cannot be its own
// concrete name
fn same overload same(n f32) f32 {     //~ ErrorBadOverload:22 "overload name must differ from its own name"
  n
}

// An anonymous function has no concrete name to keep, so it may not join a set
fn anonymous() i32 {
  imm f = &fn overload op(x i32) i32 {x * x}  //~ ErrorBadOverload:26 "An anonymous function may not declare an overload name"
  3i32
}

// A generic declaration is instantiated per argument list, so it cannot be one
// candidate of a set
fn pickOne overload pick(n i32) i32 {
  n
}

fn pickGeneric[T] overload pick(x T, y T) T {  //~ ErrorGenericOverload:32 "A generic function may not declare the overload name"
  if x > y {x} else {y}
}
