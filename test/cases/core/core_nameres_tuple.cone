// A tuple whose elements are neither all types nor all values.
//
// Name-resolution stage only. A tuple's elements decide whether the node is a
// type tuple or a value tuple, and ttupleNameRes makes that decision as it
// resolves them, so a mixed tuple is rejected before type checking begins.
// It is a separate file from core_nameres because the names here all resolve
// fine; what fails is what they resolve to.
//
// Nothing here is called: a reject scenario is compiled and never run.

mod core_nameres_tuple;

// A value tuple with a type name among its elements
fn valueTupleWithType() {
  let pair = 1, i32;      //~ ErrorBadElems:15 "Elements of tuple must be all types or all values"
}

// A declared tuple type with a literal among its elements
fn typeTupleWithValue() {
  var pair (i32, 7) = 0;  //~ ErrorBadElems:16 "Elements of tuple must be all types or all values"
}

// The same rule applies to a global, whose type is resolved in the global area
var @threadlocal globalPair (u8, 3) = 0;  //~ ErrorBadElems:32 "Elements of tuple must be all types or all values"
