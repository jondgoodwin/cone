// '@threadlocal' where the parser refuses it. Only a module's global may be
// thread-local: after its permission, 'mut', with an initial value written.
//
// Each misplaced one is reported at the attribute and dropped, so the
// declaration it was written on still parses. The one written before the
// permission is last, because it is reported with its whole statement skipped.

mod core_parse_threadlocal;

// A local, and a function's static, belong to one call or one function
fn locals() {
  var @threadlocal x = 1i64;   //~ ErrorThreadLocalPlace
  static var @threadlocal n = 0i64;   //~ ErrorThreadLocalPlace
}

// A parameter
fn parms(var @threadlocal p i64) {   //~ ErrorThreadLocalPlace
}

// A field, and a type's static
struct Holder {
  var @threadlocal f i64;   //~ ErrorThreadLocalPlace
  static var @threadlocal s i64 = 0i64;   //~ ErrorThreadLocalPlace
}

// A function and a type have no storage to copy
fn @threadlocal named() {   //~ ErrorThreadLocalPlace
}

struct @threadlocal Empty {   //~ ErrorThreadLocalPlace
}

// A module trait's global is a requirement, which a conforming module meets
mod trait Needs {
  var @threadlocal g i64;   //~ ErrorThreadLocalPlace
}

// 'imm': every thread's copy would be the same forever
let @threadlocal fixed i64 = 1i64;   //~ ErrorThreadLocalImm

// No initial value: an 'init' would give one to its own thread's copy alone.
// 'undef' writes none either.
var @threadlocal unset i64;   //~ ErrorThreadLocalInit
var @threadlocal undefd i64 = undef;   //~ ErrorThreadLocalInit

// Before the permission rather than after it
@threadlocal var early i64 = 0i64;   //~ ErrorThreadLocalPlace

fn after() {
}
