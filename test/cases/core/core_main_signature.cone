// The program's 'main' takes nothing, or C's arguments, an i32 and a **u8 (manual, mod-globals.html).
// Other parameter types are refused: they were accepted, and LLVM then stopped on the call of 'main'
// with an argument of the wrong kind. (Bug 116.)

mod core_main_signature;

fn main(argc: &i32, argv: u8) i32 {   //~ ErrorInvType "`main` takes nothing, or C's arguments"
  3i32
}
