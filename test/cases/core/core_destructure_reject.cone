// Several targets take exactly as many values as there are targets, and '_' is the
// target of a value the code does not want. One target takes the whole of what it is
// given. Refused here:
// - a number of values that is not the targets' (ErrorTargetCount), in a declaration
//   and an assignment, from a call and from a list, more and fewer;
// - a list of values given to one target that is not a tuple (ErrorOneTarget);
// - '_' given what is not a value, a type (ErrorNotTyped): it takes a value, of any type.
// (core_destructure_form: a declaration that is not written 'let a, b = values;'.)

mod core_destructure_reject;

struct Pair { a: i32; b: i32; }

fn divmod(a: i32, b: i32) i32, i32 { a / b, a % b }

fn three() i32, i64, bool { 1, 2, true }

fn declarations() {
  let a, b = three();             //~ ErrorTargetCount:19 "2 targets are given 3 values"
  let c, d, e = divmod(7, 2);     //~ ErrorTargetCount:23 "3 targets are given 2 values"
  let f, g = 1, 2, 3;             //~ ErrorTargetCount:15 "2 targets are given 3 values"
  let h, i, j = 1, 2;             //~ ErrorTargetCount:18 "3 targets are given 2 values"
  let k, l = 5;                   //~ ErrorTargetCount:14 "2 targets are given 1 value"
}

fn assignments() {
  var a: i32 = 0;
  var b: i32 = 0;
  var c: i32 = 0;
  a, b = 1, 2, 3;                 //~ ErrorTargetCount:11 "2 targets are given 3 values"
  a, b, c = 1, 2;                 //~ ErrorTargetCount:14 "3 targets are given 2 values"
  a, b = three();                 //~ ErrorTargetCount:15 "2 targets are given 3 values"
  a, b, c = divmod(1, 2);         //~ ErrorTargetCount:19 "3 targets are given 2 values"
  a, b = 7;                       //~ ErrorTargetCount:10 "2 targets are given 1 value"
}

fn oneTarget() {
  var a: i32 = 0;
  a = 1, 2, 3;                    //~ ErrorOneTarget:8 "3 values are given to one target"
  a = divmod(7, 2);               //~ ErrorInvType:13 "Expression's type does not match lval's type"
  let b: i32 = 4, 5;              //~ ErrorInvType:17 "Initialization value's type does not match variable's declared type"
}

fn notValues() {
  _ = i32;                        //~ ErrorNotTyped:7 "Expected a typed expression"
  _ = Pair;                       //~ ErrorNotTyped:7 "Expected a typed expression"
}
