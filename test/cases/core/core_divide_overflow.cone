// A signed integer '/' of the type's smallest number by -1 panics, since the
// quotient does not fit [Jon 28 Oct]; so does '%'. Dividing -1 into another number, or
// the smallest number by anything else, divides. Worked out by hand: 7 / -1 = -7,
// 7 % -1 = 0; the smallest i64 / 2 = -4611686018427387904 and % 2 = 0 (even);
// then the smallest / -1 panics (a '%' by -1 of the smallest would too, not reached).

mod core_divide_overflow;

import stdio use *;

fn quot(a: i64, b: i64) i64 {
  a / b
}

fn rem(a: i64, b: i64) i64 {
  a % b
}

fn main() {
  let least = -9223372036854775807i64 - 1i64;
  printInt(quot(7i64, -1i64));
  printStr("\n");
  printInt(rem(7i64, -1i64));
  printStr("\n");
  printInt(quot(least, 2i64));
  printStr("\n");
  printInt(rem(least, 2i64));
  printStr("\n");
  printInt(quot(least, -1i64));
  printStr(" is not reached\n");
}
