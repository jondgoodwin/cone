// Parameters of distinct names, in every way a parameter list is declared,
// are unaffected by the refusal of a name given twice (core_nameres_dupparm).
// What stays allowed: the same name in two different functions' lists, a
// parameter named as a field or a global (it shadows, core_shadowing), a
// closure's parameter named as the enclosing function's (the closure's own
// names must differ from each other, not from the code around it), and a
// function type whose parameters are named for the reader.
//
// Each parameter is given a value the others never hold, so a parameter
// bound to the wrong slot would show in the sum.

mod core_params_distinct;

import stdio use *;

var @threadlocal a = 1000;

fn plain(a i32, b i32, c i32) i32 {
  a * 100 + b * 10 + c
}

fn other(c i32, b i32, a i32) i32 {
  a * 100 + b * 10 + c
}

struct Pair {
  a i32;
  b i32;
  fn mix(self &, a i32, b i32) i32 {
    a * 1000 + b * 100 + self.a * 10 + self.b
  }
}

fn generic[T](a T, b T) T {
  b
}

fn apply(f &<fn(a i32, b i32) i32, a i32, b i32) i32 {
  f(a, b)
}

fn closures(a i32, b i32) i32 {
  let full = fn(a i32, b i32) i32 { a * 10 + b };
  let anon = &fn(c i32, d i32) i32 { c * 10 + d };
  full(a, b) * 10000 + anon(b, a) * 100 + apply((x, y) => x - y, 9, 4)
}

fn main() {
  printInt(i64.from(plain(1, 2, 3)));
  printStr("\n");
  printInt(i64.from(other(1, 2, 3)));
  printStr("\n");
  let p = new Pair(a: 3, b: 4);
  printInt(i64.from(p.mix(1, 2)));
  printStr("\n");
  printInt(i64.from(generic(7, 8)));
  printStr("\n");
  printInt(i64.from(closures(5, 6)));
  printStr("\n");
}
