// 'return', 'break' and 'continue' found before the end of their block.
//
// Name-resolution stage only. blockNameRes checks statement order while it
// walks the block, so this fires before any type-check expectation could be
// reached, and before the type checker's own placement rule in
// core-typecheck-blockend. That rule can therefore only be provoked by a
// placement name resolution accepts, which is why the two are separate files
// rather than one.
//
// Nothing here is called: a reject scenario is compiled and never run.

// Anything after a 'return' is unreachable, and the compiler says so rather
// than dropping it
fn afterReturn() i32 {
  return 1               //~ ErrorRetNotLast:3 "return may only appear as the last statement in a block"
  2
}

// The same rule covers 'break'
fn afterBreak() {
  while {
    break                //~ ErrorRetNotLast:5 "break may only appear as the last statement in a block"
    mut unreachable = 1
  }
}

// ... and 'continue'
fn afterContinue() {
  mut i = 0
  while i < 3 {
    i++
    continue             //~ ErrorRetNotLast:5 "continue may only appear as the last statement in a block"
    mut unreachable = 1
  }
}
