// An integer '/' panics where the divisor is zero [Jon 28 Oct], as a vector's does:
// a signed number's, naming the line of the division. The divisor goes through a
// function, so it is not a constant the compiler could see. What ran before the
// division printed: 20 / 4 = 5 and -20 / 4 = -5 are made, 20 / 0 is not.

mod core_divide_zero;

import stdio use *;

fn quot(a: i32, b: i32) i32 {
  a / b
}

fn main() {
  printInt(i64.from(quot(20i32, 4i32)));
  printStr("\n");
  printInt(i64.from(quot(-20i32, 4i32)));
  printStr("\n");
  printInt(i64.from(quot(20i32, 0i32)));
  printStr(" is not reached\n");
}
