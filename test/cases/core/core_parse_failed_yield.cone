// A 'yield' whose value failed to parse (Bug 111): there is nothing to hand the caller.
//
// The second 'yield' is no term, so parseTerm reports 1006 and gives no node; the first
// 'yield' used to copy the lexer position of that nothing and crashed the compiler.

mod core_parse_failed_yield;

fn f() yields i64 { yield yield }  //~ ErrorBadTerm "Invalid term: expected name, literal, etc."
                                   //~^ ErrorNoSemi "Expected ';' to end the statement" follow-on
