// Statement and expression syntax the parser cannot accept.
//
// Parse-stage only: analysis never runs on a file that fails to parse, so a
// name-resolution or type-check expectation here would silently cover nothing.
// Each condition sits in its own function so recovery from one cannot swallow
// the next.

// Two statements on one line need a semicolon between them
fn missingSemicolon() i32 {
  mut x = 1 mut y = 2  //~ ErrorNoSemi:13 "Expected semicolon or end of line"
  x + y
}

// An operator is not a term
fn badTerm(a i32) i32 {
  imm b = %            //~ ErrorBadTerm:11 "Invalid term"
  a
}

// The parenthesis is never closed. The parser notices only once it reaches a
// token it will not skip past, so the diagnostic lands on the following line.
fn unclosedParen(a i32) i32 {
  imm c = (a + 1
  a                    //~ ErrorNoRParen:3 "Expected right parenthesis"
}

// '.' must be followed by a field or method name
fn missingMember(a i32) i32 {
  imm d = a.+          //~ ErrorNoMbr:13 "This should be a named field/method"
  a
}

// 'if' needs a block, and there is neither '{' nor ':'. This diagnostic also
// lands on the following line, where the missing block would have started.
fn missingBlock(a i32) i32 {
  mut n = a
  if n == 1
    n = 2              //~ ErrorNoLCurly:5 "Expected ':' or '{' to start a block"
  n
}
