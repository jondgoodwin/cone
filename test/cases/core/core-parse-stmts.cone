// Statement and expression syntax the parser cannot accept.
//
// Parse-stage only: analysis never runs on a file that fails to parse, so a
// name-resolution or type-check expectation here would silently cover nothing.
// Each condition sits in its own function so recovery from one cannot swallow
// the next.

// Every statement ends with ';'. Two on one line with none between them, and
// the diagnostic is placed where the ';' belongs: after the first statement's
// last token, not on the token that followed it.
fn missingSemicolon() i32 {
  mut x = 1 mut y = 2; //~ ErrorNoSemi:12 "Expected ';' to end the statement"
  x + y;
}

// The ';' is not optional before the '}' that closes the block either: the
// block's value is its last statement's value with or without one, so nothing
// is lost by always writing it
fn missingLastSemicolon() i32 {
  imm x = 1;
  x + 1                //~ ErrorNoSemi:8 "Expected ';' to end the statement"
}

// Nor at the end of a line. The statement runs on into the next line, and the
// diagnostic still lands at the end of the line the ';' belongs on.
fn missingSemicolonAtLineEnd() i32 {
  mut x = 1            //~ ErrorNoSemi:12 "Expected ';' to end the statement"
  mut y = 2;
  x + y;
}

// A block starts with '{'. The ':' that once opened an indented block is
// refused as what it is, rather than as some other missing token.
fn colonBlock(a i32) i32 {
  mut n = a;
  if n == 1:           //~ ErrorColonBlock:12 "A block starts with '{', not ':'"
    n = 2;
  }
  n;
}

// 'pub' declares a name visible outside the namespace that owns it, and a local
// has no such outside
fn pubOnALocal(a i32) i32 {
  pub mut n = a;       //~ ErrorBadPub:3 "'pub' may not precede a local declaration"
  n;
}

// An operator is not a term
fn badTerm(a i32) i32 {
  imm b = %;            //~ ErrorBadTerm:11 "Invalid term"
  a;
}

// The parenthesis is never closed. The parser notices only once it reaches a
// token it will not skip past, so the diagnostic lands on the following line.
fn unclosedParen(a i32) i32 {
  imm c = (a + 1
  a;                    //~ ErrorNoRParen:3 "Expected right parenthesis"
}

// '.' must be followed by a field or method name
fn missingMember(a i32) i32 {
  imm d = a.+;          //~ ErrorNoMbr:13 "This should be a named field/method"
  a;
}

// 'if' needs a block and there is no '{'. This diagnostic also lands on the
// following line, where the missing block would have started. Recovery then
// skips forward to the next '{' it can find, which is the following function's,
// and reads that body as the block -- so the function here is never closed
// and the file ends with it still open. Last in the file for that reason.
fn missingBlock(a i32) i32 {
  mut n = a;
  if n == 1
    n = 2;             //~ ErrorNoLCurly:5 "Expected '{' to start a block"
  n;
}

fn swallowed() i32 {
  1;
}
//~ ErrorNoRCurly follow-on
