// '@threadlocal' globals the type check refuses: an initial value that is not
// a literal, which every global needs and a thread's copy starts from; and a
// type that needs finalizing, since nothing yet finalizes a thread's copy as
// its thread ends: a struct with a 'final', and one held in another struct's
// field or in an array.
//
// A literal of a type with nothing to finalize is accepted beside them.

mod core_typecheck_threadlocal;

struct Handle {
  pub id i64;

  fn final(self &uni) {
  }
}

struct Holder {
  pub h Handle;
}

fn start() i64 {
  5i64;
}

mut @threadlocal computed i64 = start();   //~ ErrorNotLit
mut @threadlocal handle Handle = Handle[1i64];   //~ ErrorThreadLocalFinal
mut @threadlocal inField Holder = Holder[Handle[2i64]];   //~ ErrorThreadLocalFinal
mut @threadlocal inArray Array[Handle, 2] = [Handle[3i64], Handle[4i64]];   //~ ErrorThreadLocalFinal
mut @threadlocal fine Array[i64, 2] = [1i64, 2i64];
