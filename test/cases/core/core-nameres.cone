// Names that resolve to nothing.
//
// Name-resolution stage only: this file parses cleanly, and name resolution
// returns before type checking, so a type-check expectation here would never
// run.

fn unknownName() i32 {
  undeclared + 1       //~ ErrorUnkName:3 "does not refer to a declared name"
}

fn breakOutsideLoop() {
  break                //~ ErrorNoLoop:3 "break may only be used within a while/each/loop block"
}

fn continueOutsideLoop() {
  continue             //~ ErrorNoLoop:3 "continue may only be used within a while/each/loop block"
}

// The unresolved lifetime is reported first as a name, then as a label the
// break cannot reach
fn unknownLifetime() {
  while {
    break 'missing     //~ ErrorUnkName:11 "'missing does not refer to a declared name"
                       //~^ ErrorNoLoop:5 "break's lifetime not found" follow-on
  }
}
