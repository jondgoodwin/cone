// What a defined shift costs. '<<' and '>>' compare a run-time amount with
// the width and use the shift's result only below it (core_shift_defined), but
// where the amount is known to be below the width the compare is not there in
// the optimized code: an amount masked to the width's bits, as '& 63' does for
// a u64, and a constant amount, where generation writes no compare at all. A
// constant amount past the width on a value known only as it runs is 0, or for
// '>>' on a signed value the sign: no shift is written for it.

mod core_genllvm_shift;

pub fn maskedShr(x u64, n u64) u64 {x >> (n & 63u64);}
pub fn maskedShl(x u32, n u32) u32 {x << (n & 31u32);}
pub fn maskedSignedShr(x i16, n i16) i16 {x >> (n & 15i16);}
pub fn constantShl(x u64) u64 {x << 3u64;}
pub fn constantSignedShr(x i8) i8 {x >> 7i8;}
pub fn pastShl(x u64) u64 {x << 64u64;}
pub fn pastSignedShr(x i32) i32 {x >> 40i32;}

fn main() {
}
