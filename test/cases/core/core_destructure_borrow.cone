// A declaration of several names extends a temporary a borrow in its values is rooted in
// (core_destructure, "borrowed temporaries"), where a single name's initializer does:
// a borrow in an extending position. A borrow passed to a call is not one, in a name
// declared alone or among several, and the temporary ends with its statement while the
// name still holds the borrow (ErrorFrozen).

mod core_destructure_borrow;

fn five(n: i32) i32 { n }

fn id(r: &i32) &i32 { r }

fn alone() i32 {
  let a = id(&five(1));      //~ ErrorFrozen:19 "The temporary made here ends with its statement"
  *a
}

fn among() i32 {
  let a, b = id(&five(1)), 2;     //~ ErrorFrozen:22 "The temporary made here ends with its statement"
  *a + b
}
