// An actor field whose initial value is missing, 'heard: u64 = ;' (Bug 111).
//
// The value fails to parse (1006) and consumes nothing, and the actor's generated handle then
// copied the text of that value, which ends before it starts, and crashed the compiler.

mod core_parse_failed_field_value;

import actors;

actor Sink {
    heard: u64 = ;  //~ ErrorBadTerm "Invalid term: expected name, literal, etc."
}

fn main() { }
