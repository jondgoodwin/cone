// Function declaration syntax the parser cannot accept.
//
// Parse-stage only.

mod core_parse_fns;

// A function's parameter list is not optional
fn noParens i32 {      //~ ErrorNoLParen:13 "Expected left parenthesis for parameter declarations"
  1;
}

// A named function is required here; only a borrowed reference may take an
// anonymous one
fn (a i32) i32 {       //~ ErrorNoName:4 "Function declarations must be named"
  a;
}

// A permission's name is not a function's: the lexer reads 'mut' as the
// permission wherever it is written, so every call would read as a
// declaration. Reported once, at the word; the rest parses as written
fn mut() i32 {         //~ ErrorNoName:4 "'mut' is a permission, so it cannot name a function"
  1;
}

// A function declared in the global area must be implemented
fn noBody(a i32) i32;   //~ ErrorNoImpl:1 "Function/method must be implemented"
