// One source compiled for each object format conec writes: COFF (Windows), ELF
// (Linux), Mach-O (macOS) and WebAssembly. Each format lowers COMDATs on its own
// terms (Mach-O none, WebAssembly only the merging kind), and a combination the
// format cannot lower is a hard error inside LLVM's backend, found by a user's
// build and not by a suite that compiles for the host alone. So the source holds
// what carries a COMDAT: a generic function with two instances, a string literal,
// a constant array literal, a global, and a public function that is exported.
// That each run compiles to an object is the claim; what each format makes of the
// COMDATs is the backend's.

mod core_genllvm_formats;

fn twice[T](x: T) (T, T) { return (x, x); }

const table: Array[u32, 4] = [2u32, 3u32, 5u32, 7u32];
var @threadlocal counter: i64 = 0;

pub fn describe(i: usize) &str {
  counter = counter + 1;
  let t = table[i % 4];
  return if t > 3u32 { "large" } else { "small" };
}

pub fn pairs(a: i32, b: f64) i64 {
  let p = twice(a);
  let q = twice(b);
  return i64.from(p.0) + i64.from(p.1) + (q.0 as i64);
}
