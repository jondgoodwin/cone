// Value tuples in a program whose name resolution fails elsewhere.
//
// Name-resolution stage only. One name does not resolve, so type check never
// runs and no value tuple here is given its type. The tree check (--checktree,
// which every run of the suite passes) still walks the program, and a value
// tuple left with no value type at all read to it as a compiler defect: one
// real error was followed by an 'ErrorBadTree' for every value tuple in the
// program, including those in the library modules it imported. A value tuple
// is unknown-typed from the moment name resolution makes it one, as every
// other expression is from its constructor, so the one real error stands alone.
//
// Nothing here is called: a reject scenario is compiled and never run.

mod core_nameres_tuple_vtype;

fn pair(a i32, b i32) i32, i32 {
  b, a;
}

fn swapped() i32 {
  mut x = 1;
  mut y = 2;
  x, y = pair(x, y);
  x, y = y, x;
  x;
}

fn unresolved() {
  nosuchname;             //~ ErrorUnkName:3 "nosuchname does not refer to a declared name"
}
