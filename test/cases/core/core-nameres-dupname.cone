// Two declarations claiming one name in one lexical scope.
//
// Name-resolution stage only: this file parses cleanly, and name resolution
// returns before type checking, so a type-check expectation here would never
// run. A module's duplicates are parse-stage and in core-parse-names, because
// a module hooks its names as it parses; a block's names are hooked one at a
// time as the resolution walk reaches them, so a duplicate local is found
// here. Each is reported twice, at the second declaration and at the first.
//
// A second declaration in an inner block is a shadow, not a duplicate, and
// core-shadowing runs it.

fn duplicateLocal() i32 {
  mut x = 1              //~ ErrorDupName:7 "This is the conflicting definition for that name" follow-on
  mut x = 2              //~ ErrorDupName:7 "Name is already defined"
  x
}

// A lifetime label is a name too, and one an inner loop may not reuse while
// an outer loop still holds it
fn duplicateLabel() {
  'outer: while {        //~ ErrorDupName:17 "This is the conflicting definition for that name" follow-on
    'outer: while {      //~ ErrorDupName:19 "Lifetime is already defined"
      break 'outer
    }
  }
}
