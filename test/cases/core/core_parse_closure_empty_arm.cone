// A closure whose last expression is an 'if' with an empty arm (Bug 111).
//
// The closure's last expression is wrapped in its return before it is type checked, and the
// return's check walked the arms of the 'if' for a 'return' to strip: an arm written '{}' holds
// no statement and the walk read before it. The 'if' has no value without an 'else', which is
// the ordinary error. Here the condition fails as well, as in the first report.

mod core_parse_closure_empty_arm;

fn main() {
    var v = 1;
    var w = fn() { if v() {} };  //~ ErrorNoMbr "Method or field `()` not found."
                                 //~^ ErrorInvType "Conditional expression requires true/false value" follow-on
                                 //~^^ ErrorNoElse "if requires an 'else' clause" follow-on
}
