// A name that declares no value, written where a value is used or thrown away, is refused where it
// stands: a function's name is no value ('f;' is not 'f()'), and a type's name is no typed expression.
// 'let c = f;' and 'let c = (S);' already said so; a statement, a parenthesised name and the value
// '_ =' takes gave no error, and code generation stopped on them.

mod core_name_not_value;

fn f() { }
fn g[T](x: T) { }

struct S {
  x: i32;
  fn m(self: &S) { }
  fn n() { }
}

trait Tr {
  fn t(self: &Tr);
}

alias Al = i32;

fn statements() {
  f;                    //~ ErrorNoSize
  (f);                  //~ ErrorNoSize
  g;                    //~ ErrorNoSize
  S.m;                  //~ ErrorNoSize
  S.n;                  //~ ErrorNoSize
  S.x;                  //~ ErrorFieldViaType
  S;                    //~ ErrorNotTyped "`S` is a type, not a value"
  (S);                  //~ ErrorNotTyped "`S` is a type, not a value"
  Tr;                   //~ ErrorNotTyped "`Tr` is a type, not a value"
  i32;                  //~ ErrorNotTyped "`i32` is a type, not a value"
  Al;                   //~ ErrorNotTyped "is a type, not a value"
  let c = (S);          //~ ErrorNotTyped "`S` is a type, not a value"
  let d = S;            //~ ErrorNotTyped "`S` is a type, not a value"
}

fn assignments() {
  _ = f;                //~ ErrorNoSize
  _ = S;                //~ ErrorNotTyped "`S` is a type, not a value"
  f = f;                //~ ErrorBadLval
}

// A value, and a call, are what these names are for
fn values() i32 {
  let s = S(1i32);
  s;
  (s);
  f();
  S.n();
  s.m();
  _ = f();
  s.x
}
