// An unsigned integer '%' panics where the divisor is zero, and an unsigned '/'
// by a value that is not zero divides, however large (the 'minus one' check is
// a signed number's alone: 250 / 255 = 0 and 250 % 255 = 250 in u8).

mod core_remainder_zero;

import stdio use *;

fn rem(a: u8, b: u8) u8 {
  a % b
}

fn quot(a: u8, b: u8) u8 {
  a / b
}

fn main() {
  printInt(i64.from(quot(250u8, 255u8)));
  printStr("\n");
  printInt(i64.from(rem(250u8, 255u8)));
  printStr("\n");
  printInt(i64.from(rem(250u8, 0u8)));
  printStr(" is not reached\n");
}
