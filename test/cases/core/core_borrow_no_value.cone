// A borrow needs a value to point at. A call that returns nothing, or never returns, gives none,
// so '&f();' (and '&mut', '&uni', '&panic(..)', '&initAll()') is refused where it stands: it was
// accepted, and code generation then stopped on the temporary of no type it tried to make.
// (Bug 114.) A call that does return a value is still borrowed: '&g();' holds a temporary.

mod core_borrow_no_value;

fn f() { }
fn g() i32 { 5i32 }

fn borrows() {
  &f();                 //~ ErrorNotTyped "a borrow needs a value"
  &mut f();             //~ ErrorNotTyped "a borrow needs a value"
  &uni f();             //~ ErrorNotTyped "a borrow needs a value"
  &initAll();           //~ ErrorNotTyped "a borrow needs a value"
  &panic("x");          //~ ErrorNotTyped "a borrow needs a value"
  let r = &f();         //~ ErrorNotTyped "a borrow needs a value"
  &g();
  let ok = &g();
}

fn main() { borrows(); }
