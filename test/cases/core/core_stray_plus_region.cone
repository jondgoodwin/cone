// A stray '+' before a value (Bug 113): '+ n 2;' reads as a region annotation, '+ region value', whose
// region is the variable 'n'. It once reached 'the name of a node that has none' (error 1075); it is
// refused where it stands, and a '+' in a closure's body, which the checker tries silently first, is
// refused there too, where the report once vanished and the compile stopped with nothing said.

mod core_stray_plus_region;

import collections use *;
import actors;

fn plain() i32 {
  var n = 1;
  + n 2;                        //~ ErrorNotRegion "'n' is not a region"
  0i32
}

fn folded() {
  var l = List[i64]();
  let runs = l.parallel().fold(0i64, (acc, c) => + acc 1i64, (a, b) => a + b);  //~ ErrorNotRegion "'acc' is not a region"
}
