// On a GPU target every function is inlined, and Vulkan's SPIR-V allows no
// recursion, so a function that calls itself, directly or through others, is
// refused at the function the cycle returns to.

mod core_gpu_recursion;

fn fact(n u32) u32 {  //~ ErrorGpuRecursion
  if n == 0 {1;} else {n * fact(n - 1);};
}

fn even(n u32) bool {  //~ ErrorGpuRecursion
  if n == 0 {true;} else {odd(n - 1);};
}

fn odd(n u32) bool {
  if n == 0 {false;} else {even(n - 1);};
}

fn square(n u32) u32 {
  n * n;
}

pub fn eval(n u32) u32 {
  if even(n) {fact(n) + square(n);} else {square(n);};
}
