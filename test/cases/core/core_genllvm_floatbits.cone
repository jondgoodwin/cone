// What a float's encoding costs. 'bits' and 'fromBits' are a bitcast, 'signBit'
// a signed compare of the bits with zero, 'mantissa' a mask, and 'exponent' a
// shift, a mask and the bias taken off: the bit operation and nothing more, so
// the optimized code has no call, no branch, no select and no memory access.
// Each is a public function so that a library compile keeps it.

mod core_genllvm_floatbits;

pub fn bits32(x: f32) u32 {x.bits()}
pub fn bits64(x: f64) u64 {x.bits()}
pub fn from32(b: u32) f32 {f32.fromBits(b)}
pub fn from64(b: u64) f64 {f64.fromBits(b)}
pub fn sign32(x: f32) bool {x.signBit()}
pub fn sign64(x: f64) bool {x.signBit()}
pub fn mantissa32(x: f32) u32 {x.mantissa()}
pub fn mantissa64(x: f64) u64 {x.mantissa()}
pub fn exponent32(x: f32) i32 {x.exponent()}
pub fn exponent64(x: f64) i32 {x.exponent()}

fn main() {
}
