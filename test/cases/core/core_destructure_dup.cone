// A name is declared once in a declaration of several, as in any block, and a name
// of the declaration is not yet declared in the values after its '=': they mean the
// names outside.

mod core_destructure_dup;

fn divmod(a: i32, b: i32) i32, i32 { a / b, a % b }

fn names() {
  let d, d = divmod(7, 2);        //~ ErrorDupName:10 "Name is already defined"
                                  //~^ ErrorDupName:7 "This is the conflicting definition for that name"
  let e, f = f, e;                //~ ErrorUnkName:14 "does not refer to a declared name"
                                  //~^ ErrorUnkName:17 "does not refer to a declared name"
}
