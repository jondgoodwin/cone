// A term that failed to parse (Bug 111): the suffixes after it have nothing to apply to.
//
// 'const' is no term, so parseTerm reports 1006 and gives no node; the '[]' after it used to be
// read as an index of that nothing and crashed the compiler. The statement's own follow-on
// errors stand: the ';' it lacks and the value it leaves.

mod core_parse_failed_suffix;

fn main() { const[] }  //~ ErrorBadTerm "Invalid term: expected name, literal, etc."
                       //~^ ErrorNoSemi "Expected ';' to end the statement" follow-on
                       //~^^ ErrorTailOpen "End this line with ';'" follow-on
