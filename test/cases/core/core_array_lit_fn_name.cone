// A function's name as an element of an array literal (row 719): '[f]' once stopped the compiler on
// an access violation. It is refused as 'let c = f;' is (ErrorNoSize). 'h(S)', type arguments in
// parentheses, names no function value either; its message says what was written.

mod core_array_lit_fn_name;

fn f() i32 { 1i32 }
fn h[T](x: T) { }
struct S { x: i32 }

fn elements() {
  let a = [f];                  //~ ErrorNoSize "f names a function"
  let b = [f, f];               //~ ErrorNoSize "f names a function"
                                //~^ ErrorNoSize "f names a function"
}

fn instantiation() {
  h(S);                         //~ ErrorNoSize "h(...) gives the generic function h its type arguments"
  _ = h(S);                     //~ ErrorNoSize "h(...) gives the generic function h its type arguments"
}

fn main() { }
