// Division and remainder that do not panic still give what they always did: by a
// constant (no check made), by -1 and by 1 from a variable, negative operands
// (truncating toward zero, the remainder with the dividend's sign), and a
// 64-bit unsigned beyond the signed range. Worked out by hand:
//   17 / 5 = 3, 17 % 5 = 2; -17 / 5 = -3, -17 % 5 = -2; 17 / -5 = -3, 17 % -5 = 2;
//   -17 / -1 = 17; 9 / 1 = 9; u64 18446744073709551615 / 2 = 9223372036854775807,
//   % 2 = 1; 100 / 7 (constant) = 14, 100 % 7 = 2.

mod core_divide_ok;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printInt(n);
  printStr("\n");
}

fn dv(a: i32, b: i32) i32 { a / b }
fn rm(a: i32, b: i32) i32 { a % b }

fn main() {
  show("17/5 ", i64.from(dv(17i32, 5i32)));
  show("17%5 ", i64.from(rm(17i32, 5i32)));
  show("-17/5 ", i64.from(dv(-17i32, 5i32)));
  show("-17%5 ", i64.from(rm(-17i32, 5i32)));
  show("17/-5 ", i64.from(dv(17i32, -5i32)));
  show("17%-5 ", i64.from(rm(17i32, -5i32)));
  show("-17/-1 ", i64.from(dv(-17i32, -1i32)));
  show("9/1 ", i64.from(dv(9i32, 1i32)));
  let big = 18446744073709551615u64;
  let two = 2u64;
  show("big/2 ", i64.from(big / two));
  show("big%2 ", i64.from(big % two));
  let c = 100i32;
  show("100/7 ", i64.from(c / 7i32));
  show("100%7 ", i64.from(c % 7i32));
}
