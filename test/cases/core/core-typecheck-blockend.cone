// Statements that cannot end the block they finish.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. It is separate from core-nameres-stmtorder
// because name resolution already rejects a 'break' or 'continue' that is not
// last; only a placement name resolution accepts can reach the type checker's
// own rules, which are about which block a correctly-placed one may finish.
//
// It is also separate from core-typecheck because these are the block-ending
// rules rather than disagreeing types, and because fnImplicitReturn runs per
// function ahead of its body, so the two families would otherwise interleave
// in a way that makes neither file's subject readable.
//
// Nothing here is called: a reject scenario is compiled and never run.

// The declared return type needs a value, and a declaration is not one. The
// diagnostic lands on the statement that cannot supply it.
fn declaresNoValue() i32 {
  mut n = 1              //~ ErrorNoRet:7 "A return value is expected but this statement cannot give one."
}

// A loop's own block may not end with the 'break' that leaves it: the loop
// would run exactly once, which is a block and not a loop. Reached here
// through a loop used as an expression, so the loop block is not itself a
// statement of the enclosing block.
fn loopEndsWithBreak() i32 {
  imm produced = while {
    break 1              //~ ErrorBadStmt:5 "Don't end loop block with break, continue or return"
  }
  produced
}

// The same rule covers 'return'
fn loopEndsWithReturn(limit i32) i32 {
  mut i = 0
  while i < limit {
    return 3             //~ ErrorBadStmt:5 "Don't end loop block with break, continue or return"
  }
  0
}

// A plain block nested in a loop may not end with 'break' either. Only a
// conditional block may, because only there does the break depend on anything.
fn plainBlockEndsWithBreak() {
  mut i = 0
  while i < 3 {
    {
      i++
      break              //~ ErrorBadStmt:7 "break/continue may only finish a conditional block"
    }
    i++
  }
}
