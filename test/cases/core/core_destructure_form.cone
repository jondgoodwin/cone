// A declaration of several names is written 'let a, b = values;'. Refused: names with
// no '=' after them, and a type written on a '_' (it takes a value and drops it, so it
// has nothing to hold a type for). The rest of the declaration is still read.

mod core_destructure_form;

fn divmod(a: i32, b: i32) i32, i32 { a / b, a % b }

fn forms() {
  let a, b;                       //~ ErrorDestructForm:7 "takes its values after an '='"
  var c: i32, d: i32;             //~ ErrorDestructForm:7 "takes its values after an '='"
  let _: i32, e = divmod(7, 2);   //~ ErrorDestructForm:7 "'_' takes a value and drops it, so it has no type to write"
  let _: i32 = 5;                 //~ ErrorDestructForm:7 "'_' takes a value and drops it, so it has no type to write"
}
