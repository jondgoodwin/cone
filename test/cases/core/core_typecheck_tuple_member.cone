// A number after '.' that names no tuple element.
//
// Type-check stage. Through a reference, a counted reference or a pointer to a
// tuple, an element past the end is refused as it is on the tuple itself. On a
// receiver with no numbered elements -- a number, a struct, a reference to a
// struct, a slice, a reference to a reference to a tuple -- the number is not
// looked up as a name; it is refused once, with nothing following from it.
// core_tuple_ref holds the spellings that read through.

mod core_typecheck_tuple_member;

struct P {
  pub x i64;
  pub y i64;
}

fn pastTheEnd() {
  imm t = (12i64, 13i64);
  imm r = &t;
  r.2;              //~ ErrorNoMeth:4 "Invalid expression on a tuple"
  imm rc = new Rc[(i64, i64)]((1, 2));
  rc.5;             //~ ErrorNoMeth:5 "Invalid expression on a tuple"
  mut pt = (40i64, 41i64);
  imm p = (&mut pt) as *(i64, i64);
  p.2;              //~ ErrorNoMeth:4 "Invalid expression on a tuple"
  return;
}

fn notATuple() {
  imm n = 5i64;
  n.0;              //~ ErrorNoMbr:4 "A number after '.' names a tuple's element, and this is not a tuple or a reference to one."
  imm s = new P(1, 2);
  s.0;              //~ ErrorNoMbr:4 "A number after '.' names a tuple's element"
  imm sr = &s;
  sr.1;             //~ ErrorNoMbr:5 "A number after '.' names a tuple's element"
  imm a = [1i64, 2i64];
  imm sl = &[]a;
  sl.0;             //~ ErrorNoMbr:5 "A number after '.' names a tuple's element"
  imm t = (12i64, 13i64);
  imm r = &t;
  imm rr = &r;
  rr.0;             //~ ErrorNoMbr:5 "A number after '.' names a tuple's element"
  return;
}
