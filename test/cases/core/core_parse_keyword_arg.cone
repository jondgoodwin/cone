// A keyword written where a name belongs in an argument, with a ':' after it.
//
// Parse-stage only. An argument is read as a term and then, if a ':' follows,
// as 'name: value'. A keyword is no term: parseTerm reports it and gives no
// node, and the ':' is still there. The parser must read past the ':' and the
// value, so the argument list stays in step, and must not look at the node
// that is not there. Each case is one such argument in one place an argument
// list stands: a call, a method's call, a construction's arguments and a
// type's arguments. 'by', 'in', 'as' and 'is' are four of the keywords that
// are no term.
//
// Each case is reported once, at the keyword, and nothing follows.

mod core_parse_keyword_arg;

struct Pair {
  pub a: i32 = 1;
  fn grow(self: &mut, by: i32 = 10) {     //~ ErrorNoRParen
    a += by;                              //~ ErrorBadTerm
  }
}

fn take(x: i32) {
}

fn pick[T: Copy](x: i32) {
}

fn main() {
  var p: Pair = Pair();
  p.grow(by: 5);                          //~ ErrorBadTerm
  take(by: 5);                            //~ ErrorBadTerm
  take(1, in: 5);                         //~ ErrorBadTerm
  take(as: 5);                            //~ ErrorBadTerm
  take(is: 5);                            //~ ErrorBadTerm
  let q: Pair = Pair(by: 5);          //~ ErrorBadTerm
  pick[by: i32](1);                       //~ ErrorBadTerm
}
