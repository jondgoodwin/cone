// An enum that lists Hash and has a payload field that is a float or not Hash, or lists Eq with a payload
// field that has no '==', is refused at the field, with the struct derive's errors.

mod trait_enum_derive_eq_hash_refused;

struct Plain { pub n: i32; }

enum Sample is Eq, Hash {
  Dot;
  Value(f32);   //~ ErrorHashFloat "its field Value(_) is f32"
}

enum Pair is Eq, Hash {
  Dot;
  pub struct Both { pub a: i32; pub b: f64; }   //~ ErrorHashFloat "its field Both.b is f64"
}

enum Holder is Hash {
  Dot;
  Item(Plain);   //~ ErrorHashField "its field Item(_) is Plain, which is not Hash"
}

enum Held is Eq {
  Dot;
  Item(Plain);   //~ ErrorEqField "its field Item(_) is Plain, which has no `==`"
  pub struct Rec { pub p: Plain; }   //~ ErrorEqField "its field Rec.p is Plain"
}

fn main() {
  let a: Sample = Sample.Dot;
  let b: Sample = Sample.Dot;
  let h: Holder = Holder.Dot;
  let e: Held = Held.Dot;
  let c = a == b;
  let _ = h;
  let _ = e;
}
