// An enum with a variant that carries a payload and lists Eq or Hash, writing no body for it, is refused
// naming the first variant that carries one (payload enums aren't derived yet).

mod trait_enum_derive_eq_hash_refused;

enum Shape is Hash {
  Dot;
  pub struct Circle { pub r: i32; }   //~ ErrorEnumDeriveEqHash "variant Circle carries a payload"
}

enum Tagged is Eq {
  Nothing;
  Some(i32);   //~ ErrorEnumDeriveEqHash "variant Some carries a payload"
}
