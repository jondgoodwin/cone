mod trait_is_diamond;

import stdio use *;

// A diamond: two traits that are each 'is' a third, and one struct naming both.
// Each of the two repeats the third's fields (a trait declares its own prefix),
// so the struct is asked for the same prefix twice. Where the two prefixes are
// identical that is one requirement met once, and the struct is accepted; where
// either adds a field of its own the prefixes conflict and it stays refused
// (trait_typecheck_conform).
//
// A run: the struct declares the fields once, and a reference to either trait
// reads them through that one prefix. Each number is worked out by hand beside it.

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

trait Base {
  pub x: i32;
  pub y: i32;
}

trait Left is Base {
  pub x: i32;
  pub y: i32;
  pub fn left(self: &) i32 {x + 1}
}

trait Right is Base {
  pub x: i32;
  pub y: i32;
  pub fn right(self: &) i32 {y + 2}
}

struct Both is Left, Right {
  pub x: i32;
  pub y: i32;
}

fn viaLeft(l: &<Left) i32 {l.left()}
fn viaRight(r: &<Right) i32 {r.right()}
fn viaBase(b: &Base) i32 {b.x * 10 + b.y}

fn main() i32 {
  let b = Both(3, 4);
  show("left", viaLeft(&b));    // x + 1 = 4
  show("right", viaRight(&b));  // y + 2 = 6
  show("base", viaBase(&b));    // 3 * 10 + 4 = 34
  0i32
}
