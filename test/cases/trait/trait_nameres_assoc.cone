// What name resolution refuses of an associated type named in generic code: a
// name no bound of the parameter declares ('C.Nope'), one two bounds each
// declare, and an associated type given as one of the trait's arguments, which
// would fix it in the constraint (an equality constraint, not built).
//
// Verdict: refuse, each where it is written: an unknown name (ErrorUnkName) for
// the first two, the argument count (ErrorArgCount) for the third. Basis:
// doc/manual/mod-substitution.html, "Associated types".

mod trait_nameres_assoc;

trait Seq[T] {
  type Cursor: Iterator[T];
  pub fn iter(self: &) Cursor;
}

trait Shelf {
  type Cursor;
  pub fn shelve(self: &) Cursor;
}

struct Down is Iterator[i64] {
  pub n: i64;
  pub fn next(self: &mut) Option[i64] { None }
}

fn nope[C: Seq[i64]](c: &C) i64 {
  var x: C.Nope = 3;    //~ ErrorUnkName "C.Nope names no associated type: the bounds of C declare Seq's Cursor, and no Nope"
  0i64
}

fn both[C: Seq[i64] + Shelf](c: &C) i64 {
  var x: C.Cursor = c.iter();    //~ ErrorUnkName "Seq and Shelf, both bounds of C, each declare Cursor"
  0i64
}

fn given[C: Seq[i64, Down]](c: &C) i64 {   //~ ErrorArgCount "Seq takes 1 type argument, and this constraint gives 2"
  0i64
}

fn main() {
}
