// A trait declared in a module of its own, for a type in the root to conform to.
// Imported by trait-import-inherit.cone and never compiled on its own, so it
// is listed in cases.toml as a support module.
//
// The root is name resolved first, before this module, so the type that is-a
// Meter reaches it before this module has folded 'twice' in. Meter's
// default method names 'twice' bare, and its own field bare, which is what
// the scenario asks the compiler to get right from the other module's scope.

import traitscale.*;

pub trait Meter {
  pub level i32;

  pub fn doubled(self &) i32 {twice(level);}
  pub fn step(self &mut);
}
