// An enum that does not list Hash is not Hash, though its '==' on two values compiles: a struct deriving
// hash over it is refused as before (ErrorHashField).

mod trait_enum_derive_eq_hash_plain;

enum Plain { P; Q; }

struct UsesPlain is Eq, Hash {
  pub c: Plain;   //~ ErrorHashField "its field c is Plain, which is not Hash"
}

fn main() {
  let a: Plain = Plain.P;
  let b: Plain = Plain.Q;
  let same = a == b;
}
