// A virtual reference is a fat pointer built by coercing a plain reference, not
// something a borrow or an allocation can produce directly. Writing '&<' as an
// operator rather than as a type is rejected here, and so is the retired
// allocation '+<': an allocation is written 'new Rc[mut, Rect](3)', the
// concrete type, and coerces where a virtual reference is wanted.
//
// This is its own file because the diagnostic is raised during name resolution,
// when '&<' followed by a value rather than a type is found not to be a type
// after all. Name resolution errors return before type checking, so anything
// this file also claimed about types would never be reached.

mod trait_nameres;

trait Shape {
  fn area(self &) i32;
}

struct Rect {
  w i32;
  fn area(self &) i32 {w;}
}

fn borrows() {
  mut r = Rect[2];

  // Borrowing a virtual reference from a place
  imm a = &<r;        //~ ErrorBadTerm:11 "May not borrow a virtual reference"

  // The same with a permission, so it is not the bare form alone that fails
  imm b = &<mut r;    //~ ErrorBadTerm:11 "May not borrow a virtual reference"

  // Allocating one into a region, the retired form the reference manual used
  // for closure references
  imm c = +<Rc-mut Rect[3];   //~ ErrorPlusAlloc:11 "written 'new Rc[mut, Rect](...)'"
}
