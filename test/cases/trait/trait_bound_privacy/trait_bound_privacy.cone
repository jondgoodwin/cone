// What a bound still lets through when the member is private to its module:
// the generic is checked from its own module (trait_typecheck_bound_privacy
// refuses the rest), so a generic that lives in the type's module meets the
// type's private members whoever instantiates it, as the generic's body can name
// them. A type with private members meets such a bound from the type's own
// module, from a sister of it and from the module above them.
//
// - vault.cone holds a type with a private field and a private method, traits
//   naming both, and the generics bounded by them, a function, a 'where' and a
//   generic struct with a method.
// - sister.cone and this module instantiate them without being able to name the
//   members.

mod trait_bound_privacy;

import stdio use *;

fn main() i32 {
  imm s = vault.make(7u32);
  print <- vault.getId(&s), "\n";
  print <- vault.callHidden(&s), "\n";
  print <- vault.whereHidden(&s), "\n";
  print <- vault.viaHolder(vault.make(4u32)), "\n";
  imm h = new vault.Holder(vault.make(3u32));
  print <- h.go(), "\n";
  print <- vault.inside(), "\n";
  print <- sister.fromSister(), "\n";
  0i32;
}
