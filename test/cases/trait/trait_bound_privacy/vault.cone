// A module that owns types with private members and the generics, and the
// traits bounding them, that read them (trait_bound_privacy.cone)

pub mod vault;

pub trait Id {
  pub id u32;
}

pub trait Hidden {
  pub fn hidden(self &) u32;
}

pub struct Secret {
  id u32;
  pub other u32;
  fn hidden(self &) u32 { id * 3u32; }
}

pub fn make(n u32) Secret { new Secret(n, 0u32); }

pub fn getId[T Id](x &T) u32 { x.id; }
pub fn callHidden[T Hidden](x &T) u32 { x.hidden(); }
pub fn whereHidden[T](x &T) u32 where T is Hidden { x.hidden(); }

pub struct Holder[T] where T is Hidden {
  pub v T;
  pub fn go(self &) u32 { v.hidden(); }
}

pub fn viaHolder[T Hidden](x T) u32 {
  let h = new Holder(x);
  h.go();
}

// Inside the module, nothing is hidden
pub fn inside() u32 {
  let s = make(2u32);
  getId(&s) + callHidden(&s) + whereHidden(&s) + viaHolder(make(1u32));
}
