// The module holding the generics and the traits that bound them
// (trait_priv_is_generic.cone). Their bodies read and call the members the
// traits name, on types from another module that declare the trait with 'is'.

pub mod lib;

pub trait Id {
  pub id u32;
}

pub trait Hidden {
  pub fn hidden(self &) u32;
}

pub fn getId[T Id](x &T) u32 { x.id }
pub fn callHidden[T Hidden](x &T) u32 { x.hidden() }
pub fn whereHidden[T](x &T) u32 where T is Hidden { x.hidden() }

pub struct Holder[T] where T is Hidden {
  pub v T;
  pub fn go(self &) u32 { v.hidden() }
}

pub fn viaHolder[T Hidden](x T) u32 {
  let h = new Holder(x);
  h.go()
}
