// A module whose types keep their members private and say they meet the traits
// of lib with 'is' (trait_priv_is_generic.cone)

pub mod vault;

import lib use Id, Hidden;

pub struct Sealed is Hidden {
  id u32;
  fn hidden(self &) u32 { id * 3u32 }
}

pub struct Marked is Id {
  id u32;
}

pub fn make(n u32) Sealed { new Sealed(n) }
pub fn mark(n u32) Marked { new Marked(n) }

// From the type's own module, the same generics
pub fn inside() u32 {
  let s = make(2u32);
  lib.callHidden(&s) + lib.whereHidden(&s) + lib.viaHolder(make(1u32))
}
