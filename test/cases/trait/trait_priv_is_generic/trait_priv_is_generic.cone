// A type that declares a trait with 'is' meets it from every module, though the
// member that meets it is private (doc/manual/mod-subtyping.html). A generic in
// another module, bounded by the trait, so takes the type, and its body names the
// member the trait requires: a method called, a field read, through a function's
// bound, a 'where', and a generic struct's method.
//
// - lib.cone holds the traits and the generics; vault.cone the types.
// - This module, a third, instantiates the generics with vault's types.
// trait_typecheck_priv_is_generic pins what stays refused: a type that does not
// declare the trait, and a member the trait does not require.

mod trait_priv_is_generic;

import stdio use *;

fn main() i32 {
  let s = vault.make(7u32);
  print <- lib.callHidden(&s), "\n";
  print <- lib.whereHidden(&s), "\n";
  print <- lib.viaHolder(vault.make(4u32)), "\n";
  let h = lib.Holder(vault.make(3u32));
  print <- h.go(), "\n";
  let m = vault.mark(9u32);
  print <- lib.getId(&m), "\n";
  print <- vault.inside(), "\n";
  let v: &<lib.Hidden = &s;
  print <- v.hidden(), "\n";
  0i32
}
