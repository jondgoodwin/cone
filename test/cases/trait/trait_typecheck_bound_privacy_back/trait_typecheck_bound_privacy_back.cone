// A generic's bound is checked from the generic's module, also when that
// module is the one instantiating it with a type from another: the type's
// private members are the type's module's alone (see trait_typecheck_bound_privacy,
// which instantiates from the type's module and from a third).

mod trait_typecheck_bound_privacy_back;

fn main() i32 {
  lib.fromGenericsOpen();
  0i32;
}
