// The module that owns the types with private members
// (trait_typecheck_bound_privacy_back.cone)

pub mod vault;

pub struct Secret {
  id: u32;
  pub other: u32;
  fn hidden(self: &) u32 { id * 3u32 }
}

pub struct Open {
  pub id: u32;
  pub fn hidden(self: &) u32 { id * 3u32 }
}

pub fn make(n: u32) Secret { Secret(n, 0u32) }
pub fn makeOpen(n: u32) Open { Open(n) }
