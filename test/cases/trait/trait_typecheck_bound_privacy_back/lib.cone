// The module that holds the generics and instantiates them itself with a type
// from another module (trait_typecheck_bound_privacy_back.cone)

pub mod lib;
import vault;

pub trait Id {
  pub id u32;
}

pub trait Hidden {
  pub fn hidden(self &) u32;
}

pub fn getId[T Id](x &T) u32 { x.id; }
pub fn callHidden[T Hidden](x &T) u32 { x.hidden(); }

pub struct Holder[T] where T is Hidden {
  pub v T;
  pub fn go(self &) u32 { v.hidden(); }
}

// The generics' own module is no nearer the type's private members than any
// other: they are refused here as well
fn fromGenerics() u32 {
  imm s = vault.make(5u32);
  getId(&s);             //~ ErrorPrivateMatch:8 "getId requires T is Id, and Secret is not Id. The field `id` of Secret is private to its module"
  callHidden(&s);        //~ ErrorPrivateMatch:13 "callHidden requires T is Hidden, and Secret is not Hidden. The method `hidden` of Secret is private to its module"
  imm h = new Holder(vault.make(6u32)); //~ ErrorPrivateMatch:11 "Holder requires T is Hidden, and Secret is not Hidden."
  0u32;
}

pub fn fromGenericsOpen() u32 {
  imm o = vault.makeOpen(5u32);
  getId(&o) + callHidden(&o);
}
