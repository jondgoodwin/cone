// 'as' names a virtual reference: '&circle as &<Shape' is the conversion a call
// argument gets, attaching the struct's table of methods, and a call through it
// reaches the struct's own method. Each printed value was worked out by hand.

mod trait_as_virtref;

import stdio use *;

trait Shape {
  pub fn area(self: &) i64;
}

struct Circle is Shape {
  r: i64;
  pub fn area(self: &) i64 {3i64 * self.r * self.r}
}

struct Square {
  s: i64;
  pub fn area(self: &) i64 {self.s * self.s}
}

fn viaCall(sh: &<Shape) i64 { sh.area() }

fn main() {
  var c = Circle(2i64);
  var q = Square(5i64);
  let s = &c as &<Shape;
  print <- s.area(), "\n";            // 3*2*2 = 12
  print <- viaCall(&c as &<Shape), "\n";   // 12
  let t = &q as &<Shape;
  print <- t.area(), "\n";            // 5*5 = 25
}
