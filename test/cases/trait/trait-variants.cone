// Trait-based variants: a base type declares a method with no body, each
// derived type implements it, and a virtual reference to the base dispatches to
// whichever one it happens to point at. A union is the closed form of that -- a
// trait whose implementers are declared inside it and are all one size -- and an
// open trait with 'extends' implementers is the same mechanism without the
// closure. Both are here so the two are exercised against one another.
//
// The second half is the inverse operation: recovering the concrete type from a
// virtual reference by matching on it. That is a vtable-pointer comparison
// rather than the tag comparison a plain '&Union' match uses, which is why it
// is here and not in the union group.
//
// Narrowing only works where the concrete type names its base with 'extends'.
// A type that conforms structurally has no nominal relationship to narrow along,
// and matching one crashes code generation; trait-success covers structural
// conformance and does not match on it.

import stdio::*

fn show(label &[]u8, n i64) {
  printStr(label)
  printStr(" = ")
  printInt(n)
  printStr("\n")
}

// -------- the closed form: a union's abstract method --------

// 'incr' has no body, so it is a requirement rather than a default: every
// variant must declare its own. 'fld' is the field every variant shares.
union Extense {
  fld i32

  fn incr(self &mut)

  struct Variant1 {
    nbr i32
    fn incr(self &mut) {nbr += 1}
  }

  struct Variant2 {
    x i32
    y i32
    fn incr(self &mut) {x += 1; y += 1}
  }
}

fn unionVariants() {
  mut one = Variant1[10, 100]
  mut two = Variant2[20, 3, 4]

  // A virtual reference to the union, which is not the same type as '&Extense':
  // it carries the variant's vtable rather than relying on the union's tag.
  mut vref &<mut Extense = &mut one
  vref.incr()
  show("abstract-method-dispatched-to-variant1", one.nbr)

  // The same variable, retargeted to the other variant: one call site, two
  // different implementations
  vref = &mut two
  vref.incr()
  show("abstract-method-dispatched-to-variant2", two.x)
  show("abstract-method-touched-both-fields", two.y)

  // The union's own field is reachable through the virtual reference, and
  // writable through it
  vref.fld = 26
  show("union-field-written-through-vref", two.fld)
  show("union-field-read-through-vref", vref.fld)
}

// A function taking the virtual reference, so dispatch happens where the
// concrete type is not known at all
fn incrTwice(vr &<mut Extense) {
  vr.incr()
  vr.incr()
}

fn unionThroughParameter() {
  mut one = Variant1[1, 5]
  mut two = Variant2[2, 6, 7]
  incrTwice(&mut one)
  incrTwice(&mut two)
  show("dispatch-through-parameter-variant1", one.nbr)
  show("dispatch-through-parameter-variant2", two.x)
}

// -------- the open form: a trait with 'extends' implementers --------

trait Shape {
  fn area(self &) i32
  fn grow(self &mut)
}

struct Rect extends Shape {
  w i32
  h i32

  fn area(self &) i32 {w * h}
  fn grow(self &mut) {w = w + 1}
}

struct Circle extends Shape {
  r i32

  fn area(self &) i32 {3 * r * r}
  fn grow(self &mut) {r = r + 1}
}

fn growAndMeasure(s &<mut Shape) i32 {
  s.grow()
  s.area()
}

fn openTrait() {
  mut rect = Rect[2, 3]
  mut circle = Circle[4]
  show("open-trait-dispatch-rect", growAndMeasure(&mut rect))
  show("open-trait-dispatch-circle", growAndMeasure(&mut circle))
}

// -------- narrowing back to the concrete type --------

// The single-pattern form: an 'if' whose condition binds when the virtual
// reference turns out to point at this type
fn rectWidth(s &<Shape) i32 {
  if imm r &Rect = s {
    r.w
  }
  else {
    0
  }
}

// The multi-arm form. The trait is open, so an 'else' is required however many
// implementers are named.
fn describe(s &<Shape) i32 {
  match s {
    case imm r &Rect {r.w + r.h}
    case imm c &Circle {c.r}
    else {0}
  }
}

// 'case is' tests without binding
fn isCircle(s &<Shape) i32 {
  match s {
    case is &Circle {1}
    else {0}
  }
}

fn narrowingTrait() {
  imm rect = Rect[2, 3]
  imm circle = Circle[4]
  show("narrow-if-binding-taken", rectWidth(&rect))
  show("narrow-if-binding-not-taken", rectWidth(&circle))
  show("narrow-match-first-arm", describe(&rect))
  show("narrow-match-second-arm", describe(&circle))
  show("narrow-match-is-false", isCircle(&rect))
  show("narrow-match-is-true", isCircle(&circle))
}

// The same narrowing on a union's virtual reference
fn narrowingUnion() {
  mut one = Variant1[10, 33]
  mut two = Variant2[20, 4, 5]
  mut vref &<Extense = &one
  if imm v1 &Variant1 = vref {
    show("narrow-union-vref-to-variant1", v1.nbr)
  }
  vref = &two
  match vref {
    case imm v1 &Variant1 {show("narrow-union-vref-wrong-arm", v1.nbr)}
    case imm v2 &Variant2 {show("narrow-union-vref-to-variant2", v2.x + v2.y)}
  }
}

// -------- interaction with the constructs below this tier --------

// Dispatch and narrowing driven by a loop, so the vtable a call loads and the
// arm a match takes both have to follow control flow
fn interactions() {
  mut rect = Rect[1, 1]
  mut circle = Circle[1]
  mut total = 0
  mut i = 0
  while i < 4 {
    mut s &<mut Shape = if i % 2 == 0 {&mut rect} else {&mut circle}
    s.grow()
    total = total + describe(s)
    i++
  }
  show("dispatch-and-narrow-in-loop", total)
}

fn main() i32 {
  unionVariants()
  unionThroughParameter()
  openTrait()
  narrowingTrait()
  narrowingUnion()
  interactions()
  0i32
}
