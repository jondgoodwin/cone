// 'as' to a virtual reference of a trait the type does not meet is refused, as the
// call argument is.

mod trait_as_virtref_refused;

trait Shape {
  pub fn area(self: &) i64;
}

struct Rock {
  w: i64;
}

fn viaCall(sh: &<Shape) i64 { sh.area() }

fn main() {
  var r = Rock(2i64);
  let s = &r as &<Shape;   //~ ErrorInvType:11 "Expression's type does not match the virtual reference wanted"
  viaCall(&r);   //~ ErrorInvType:11 "Expression's type does not match declared parameter"
}
