// An owning virtual reference ('+<so App', '+<rc App') is lent, not moved,
// where a borrowed one is wanted. A method dispatched through it is handed a
// borrowed virtual reference with the permission its 'self' declares, as a
// method called on a plain '+so' owner is handed '&mut' or '&'; so is a
// parameter or a local declared '&<mut App' or '&<App'. The owner stays, and
// is used again after the borrow's last use: before this, the first method
// call moved it (Error 1048 on the second), and on an owner held in a field or
// a global it was refused as a move out of the field or the global.
//
// Every place an owner lives is here: a local, a struct's field, a module's
// global, and a counted owner and a shared copy of one.
//
// Not here, because it is not built: the concrete type's finalizer when an
// owning virtual reference dies, and the region's 'free' of its allocation.
// Nothing reaches either through the vtable, so no type below declares 'final'.

mod trait_vref_owner;

import stdio use *;

trait App {
  pub fn frame(self &mut) Bool;
  pub fn look(self &) i64;
}

struct Spinner {
  pub n i64;
  pub fn frame(self &mut) Bool {n = n + 1; n < 4;}
  pub fn look(self &) i64 {n;}
}

// A second implementer, so that which one each slot reached is in the numbers
struct Doubler {
  pub n i64;
  pub fn frame(self &mut) Bool {n = n * 2; n < 100;}
  pub fn look(self &) i64 {n;}
}

struct Holder {
  pub app +<so App;
}

mut kept +<so App;

fn @initpure init() {
  kept = +so Doubler[3];
}

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn bump(x &<mut App) { x.frame(); }
fn peek(x &<App) i64 { x.look(); }

fn main() i32 {
  initAll();

  // Method calls through a local owner, each lending it
  mut a +<so App = +so Spinner[0];
  a.frame();
  a.frame();
  a.frame();
  show("local-three-frames", a.look());

  // The owner passed where a borrowed virtual reference is wanted
  bump(a);
  bump(a);
  show("passed-twice", peek(a));

  // A borrowed virtual reference lent from the owner by coercion, then the
  // owner used again once the borrow is done with
  imm b &<mut App = a;
  b.frame();
  imm r &<App = a;
  show("lent-borrow-reads", r.look());
  a.frame();
  show("owner-after-borrow", a.look());

  // An owner held in a struct's field
  mut h = Holder[+so Doubler[1]];
  h.app.frame();
  h.app.frame();
  bump(h.app);
  show("field-owner", h.app.look());

  // An owner held in a global
  kept.frame();
  kept.frame();
  show("global-owner", kept.look());

  // A counted owner, and a shared one copied: both copies reach one value
  mut c +<rc App = +rc Spinner[20];
  c.frame();
  c.frame();
  show("counted-owner", c.look());
  imm s +<rc-mut App = +rc-mut Doubler[5];
  imm s2 = s;
  s.frame();
  s2.frame();
  show("shared-owner-copies", s.look());

  0i32;
}
