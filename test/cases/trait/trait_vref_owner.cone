// An owning virtual reference ('Uni[App]', 'Rc[App]') is lent, not moved,
// where a borrowed one is wanted. A method dispatched through it is handed a
// borrowed virtual reference with the permission its 'self' declares, as a
// method called on a plain 'Uni' owner is handed '&mut' or '&'; so is a
// parameter or a local declared '&<mut App' or '&<App'. The owner stays, and
// is used again after the borrow's last use: before this, the first method
// call moved it (Error 1048 on the second), and on an owner held in a field or
// a global it was refused as a move out of the field or the global.
//
// Every place an owner lives is here: a local, a struct's field, a module's
// global, and a counted owner and a shared copy of one. What an owner's death
// does is trait_vref_final's subject, so no type below declares 'final'.
//
// A call through a virtual reference may replace an owner of the type, as it may reshape a
// collection, so the owner a borrow is held into ('a' under 'w', the shared 's' under its copy)
// is declared '+ ShapeKeeping': the promise that a call through it keeps the borrows of its
// caller (mem-shape.html#shapekeeping, "ShapeKeeping"; region_flow_owner_kinds holds the refusal without it).

mod trait_vref_owner;

import stdio use *;

trait App {
  pub fn frame(self &mut) bool;
  pub fn look(self &) i64;
}

struct Spinner {
  pub n i64;
  pub fn frame(self &mut) bool {n = n + 1; n < 4}
  pub fn look(self &) i64 {n}
}

// A second implementer, so that which one each slot reached is in the numbers
struct Doubler {
  pub n i64;
  pub fn frame(self &mut) bool {n = n * 2; n < 100}
  pub fn look(self &) i64 {n}
}

struct Holder {
  pub app Uni[App];
}

let kept Uni[App];

fn @initpure init() {
  kept = new Uni[Doubler](3);
}

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn bump(x &<mut App) { x.frame(); }
fn peek(x &<App) i64 { x.look() }

fn main() i32 {
  initAll();

  // Method calls through a local owner, each lending it
  var a Uni[App + ShapeKeeping] = new Uni[Spinner](0);
  a.frame();
  a.frame();
  a.frame();
  show("local-three-frames", a.look());

  // The owner passed where a borrowed virtual reference is wanted
  bump(a);
  bump(a);
  show("passed-twice", peek(a));

  // A borrowed virtual reference lent from the owner by coercion, then the
  // owner used again once the borrow is done with
  let b &<mut App = a;
  b.frame();
  let r &<App = a;
  show("lent-borrow-reads", r.look());
  a.frame();
  show("owner-after-borrow", a.look());

  // The owner read while a '&<mut' borrow of it is still to be used: it is one
  // more alias (7 read, then 8 after the frame)
  let w &<mut App + ShapeKeeping = a;
  let seen = a.look();
  w.frame();
  show("read-under-mut", seen * 100 + a.look());

  // An owner held in a struct's field
  var h = new Holder(new Uni[Doubler](1));
  h.app.frame();
  h.app.frame();
  bump(h.app);
  show("field-owner", h.app.look());

  // An owner held in a global
  kept.frame();
  kept.frame();
  show("global-owner", kept.look());

  // A counted owner, and a shared one copied: both copies reach one value
  var c Rc[App] = new Rc[Spinner](20);
  c.frame();
  c.frame();
  show("counted-owner", c.look());
  let s Rc[mut, App + ShapeKeeping] = new Rc[mut, Doubler](5);
  let s2 = s;
  s.frame();
  s2.frame();
  show("shared-owner-copies", s.look());

  0i32
}
