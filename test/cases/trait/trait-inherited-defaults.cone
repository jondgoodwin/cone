// Two types that inherit the same trait default.
//
// A trait's default method is cloned into every type that extends the trait
// without declaring its own, and the clone belongs to that type. The point of
// this scenario is the symbols, which cases.toml pins: each implementer gets a
// definition named after itself, and neither is named after the trait. A run
// could not tell the two clones apart -- both would compute the same thing --
// so it compiles, and the calls are there only so the optimizer keeps both.

trait Meter {
  level i32

  fn reading(self &) i32 {level * 2}
  fn step(self &mut)
}

struct Alpha extends Meter {
  fn step(self &mut) {self.level = self.level + 1}
}

struct Beta extends Meter {
  span i32

  fn step(self &mut) {self.level = self.level + 2}
}

fn readingOf(m &<Meter) i32 {
  m.reading()
}

fn both() i32 {
  mut a = Alpha[3]
  mut b = Beta[5, 7]
  readingOf(&a) + readingOf(&b)
}
