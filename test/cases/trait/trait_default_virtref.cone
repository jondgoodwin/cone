// A trait's non-generic default fills its slot of the virtual reference: a type that
// leaves the method to the trait coerces to '&<Greeter' and the call reaches the default;
// a type with its own method of the name still wins through the same reference.
// Each printed value was worked out by hand from the source.

mod trait_default_virtref;

import stdio use *;

trait Greeter {
  pub fn id(self: &) i64;
  pub fn bonus(self: &) i64 {100i64}
  pub fn bump(self: &mut, n: i64) i64 {n + 1i64}
}

struct Plain is Greeter {
  pub fn id(self: &) i64 {1i64}
}

struct Own is Greeter {
  pub fn id(self: &) i64 {2i64}
  pub fn bonus(self: &) i64 {200i64}
  pub fn bump(self: &mut, n: i64) i64 {n + 10i64}
}

fn viaRef(g: &<mut Greeter) i64 {
  g.id() * 1000i64 + g.bonus() + g.bump(5i64) * 100000i64
}

fn main() {
  var p = Plain();
  var o = Own();
  print <- viaRef(&mut p), "\n";   // 1*1000 + 100 + 6*100000 = 601100
  print <- viaRef(&mut o), "\n";   // 2*1000 + 200 + 15*100000 = 1502200
}
