// A plain owner converted into an owning virtual reference is moved into it,
// as it would be into another plain owner: the virtual reference now owns the
// value and releases it (trait_vref_final), so the plain owner may not be used
// again. Before, the conversion left the plain owner live, and both released
// the one value. A counted owner converted is copied instead, and stays usable
// (trait_vref_final's 'counted-from-plain').
//
// One function per case, so that one move cannot stand in for another's.

mod trait_flow_vref_convert;

trait App {
  pub fn look(self &) i64;
}

struct Spinner {
  pub n i64;
  pub fn look(self &) i64 {n;}
}

fn eat(x So[App]) {}

fn intoLocal() i64 {
  imm p = new So[Spinner](0);
  imm a So[App] = p;
  p.n;                             //~ ErrorMove:3 "moved out"
}

fn intoParam() i64 {
  imm p = new So[Spinner](0);
  eat(p);
  p.n;                             //~ ErrorMove:3 "moved out"
}

fn main() {
}
