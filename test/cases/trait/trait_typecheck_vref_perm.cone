// A method dispatched through a virtual reference is chosen only where the
// reference's permission grants what the method's 'self' asks for, as for a
// plain reference: 'self &mut' needs one that permits mutation, and 'self
// &uni' one that is unique. The refusal is the one a plain '&Spinner' calling
// 'frame' gets. Unchecked, a read-only virtual reference would change the
// value it points at.
//
// An owning virtual reference lends with the permission 'self' declares, so
// it is held to the same rule by its own permission: '+<So-imm' and
// '+<Rc-imm' lend no '&mut', and '+<Rc-mut', shared, lends no '&uni'.
// trait_vref_perm runs every pair that is allowed.

mod trait_typecheck_vref_perm;

trait App {
  pub fn frame(self &mut) Bool;
  pub fn look(self &) i64;
  pub fn take(self &uni) i64;
}

struct Spinner {
  pub n i64;
  pub fn frame(self &mut) Bool {n = n + 1; n < 4;}
  pub fn look(self &) i64 {n;}
  pub fn take(self &uni) i64 {n;}
}

// Borrowed virtual references without the permission 'self' asks for
fn readOnly(b &<App) {
  b.frame();   //~ ErrorNoCandidate:4 "No method declared by `frame` accepts the call's arguments"
  b.take();    //~ ErrorNoCandidate:4 "No method declared by `take` accepts the call's arguments"
}

fn immutable(b &<imm App) {
  b.frame();   //~ ErrorNoCandidate:4 "No method declared by `frame` accepts the call's arguments"
}

fn shared(b &<mut App) {
  b.take();    //~ ErrorNoCandidate:4 "No method declared by `take` accepts the call's arguments"
}

// Owning virtual references, refused as a plain owner of that permission is
fn ownedImm(b +<So-imm App) {
  b.frame();   //~ ErrorNoCandidate:4 "No method declared by `frame` accepts the call's arguments"
}

fn countedImm(b +<Rc-imm App) {
  b.frame();   //~ ErrorNoCandidate:4 "No method declared by `frame` accepts the call's arguments"
}

fn countedShared(b +<Rc-mut App) {
  b.take();    //~ ErrorNoCandidate:4 "No method declared by `take` accepts the call's arguments"
}

// The plain reference's refusal, for comparison
fn plainReadOnly(p &Spinner) {
  p.frame();   //~ ErrorNoCandidate:4 "No method declared by `frame` accepts the call's arguments"
}
