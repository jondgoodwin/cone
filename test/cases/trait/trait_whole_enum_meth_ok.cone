// The rule did not move (trait_typecheck_whole_enum_meth): an enum's method written
// 'self: &' is copied into each variant, so the variants meet a pub requirement and
// convert to the trait and to AnyError. A method over the whole enum meets a
// private requirement, which has no slot to fill.

mod trait_whole_enum_meth_ok;

import stdio use *;
import collections use *;

trait T {
  pub fn g(self: &) i32;
}

enum Two is T {
  A, B;
  fn g(self: &) i32 { 7 }
}

trait P {
  fn h(self: &) i32;
}

enum Whole is P {
  A, B;
  fn h(self: &Whole) i32 { 5 }
}

enum Good is Error, Sendable {
  X, Y;
  pub fn toText(self: &, out: &uni TextOut) { out <- "good"; }
}

fn fails() Result[i32, Good] {
  Err[i32, Good](Good.X)
}

fn lift() Result[i32, AnyError] {
  let v = fails()?;
  Ok(v)
}

fn main() i32 {
  let x = Two.B;
  let r: &<T = &x;
  print <- r.g(), "\n";
  let w = Whole.A;
  print <- w.h(), "\n";
  match lift() {
    case is Ok { print <- "ok\n"; }
    case is Err { print <- "err\n"; }
  }
  0
}
