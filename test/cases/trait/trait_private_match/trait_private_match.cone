// What still fits a trait when a member is private to its module
// (trait_typecheck_private_match refuses the rest). The code asking is what
// decides: a private member counts for code inside the module that declares the
// type, and for code in a module that holds the type as its own.
//
// - Inside vault.cone a private field and a private method meet a trait's
//   requirements through a virtual reference, a plain reference and a bound.
// - vault hands out a view it made itself, and this module reads and calls the
//   members through it without being able to name them.
// - A type declaring the trait with 'is' has asserted the fit, private field
//   and all, and is viewed through the trait from here.
// - An enrichment of the type declared in this module is inside the type's
//   encapsulation (doc/manual/mod-extensibility.html#encap, "An enrichment is inside its
//   base's encapsulation"): its private members come across as this module's
//   own, so they meet the traits from here.

mod trait_private_match;

import stdio use *;

struct Gauge extends vault.Secret {
  pub fn plain(self &) u32 { id + 1u32; }
}

trait Id {
  pub id u32;
}

fn showPeek(p &<vault.Peek) u32 { p.id; }
fn showHid(p &<vault.Hid) u32 { p.hidden(); }
fn showId(p &<Id) u32 { p.id; }
fn showPlain(p &Id) u32 { p.id; }
fn boundId[T Id](p &T) u32 { p.id; }

fn main() i32 {
  let s = vault.make(7u32);
  print <- vault.viaVirtual(&s), "\n";
  print <- vault.viaPlain(&s), "\n";
  print <- vault.viaBound(&s), "\n";
  print <- vault.viaBoundHid(&s), "\n";
  print <- showPeek(vault.peek(&s)), "\n";
  print <- showHid(vault.hid(&s)), "\n";
  let n = vault.makeNom(4u32);
  print <- showPeek(&n), "\n";
  let g Gauge = vault.make(9u32);
  print <- showId(&g), "\n";
  print <- showPlain(&g), "\n";
  print <- boundId(&g), "\n";
  print <- showHid(&g), "\n";
  0i32;
}
