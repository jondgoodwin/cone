// The module that owns the private members, and the traits and views it
// chooses to make itself (trait_private_match.cone)

pub mod vault;

pub trait Peek {
  pub id u32;
}

pub trait Hid {
  pub fn hidden(self &) u32;
}

trait Own {
  pub id u32;
  pub fn hidden(self &) u32;
}

pub struct Secret {
  id u32;
  pub other u32;
  fn hidden(self &) u32 { id * 3u32 }
}

// A type that declares the trait itself has asserted the fit, private members
// and all, wherever it is later used
pub struct Nom is Peek {
  id u32;
}

fn ownId(x &<Own) u32 { x.id + x.hidden() }
fn plainOwn(x &Own) u32 { x.id }
fn boundOwn[T Own](x &T) u32 { x.id + x.hidden() }
fn boundHid[T Hid](x &T) u32 { x.hidden() }

pub fn make(n u32) Secret { new Secret(n, 0u32) }
pub fn makeNom(n u32) Nom { new Nom(n) }

// Inside the module the private members count
pub fn viaVirtual(s &Secret) u32 { ownId(s) }
pub fn viaPlain(s &Secret) u32 { plainOwn(s) }
pub fn viaBound(s &Secret) u32 { boundOwn(s) }
pub fn viaBoundHid(s &Secret) u32 { boundHid(s) }

// The module makes the view itself, and hands it out
pub fn peek(s &Secret) &<Peek { s }
pub fn hid(s &Secret) &<Hid { s }
