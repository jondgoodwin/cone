// 'extends' written where a nominal assertion is meant.
//
// The nominal relationship between a concrete type and its abstractions is
// spelled 'is'. 'extends' is reserved for enriching a concrete type with
// methods, which is not implemented, so writing it here is refused rather than
// quietly accepted as what it used to mean. The diagnostic names what to write
// instead, and names the kind it was written on, so both kinds that can write one
// are here.
//
// Parse stage: the clause is diagnosed as it is read, and a parse diagnostic stops
// the compile before name resolution, so nothing in this file is resolved and
// nothing else belongs in it. An enum extending an enum is a different
// relationship that keeps the keyword -- coneref/refenum.html, unimplemented --
// so it is not refused here and there is nothing yet to assert about it.

trait Sensor {
  pub id i32;
}

struct Probe extends Sensor {   //~ ErrorExtends:22 "asserts conformance to an abstraction with 'is'"
  pub id i32;
}

trait Logger extends Sensor {   //~ ErrorExtends:22 "asserts conformance to an abstraction with 'is'"
  pub id i32;
}
