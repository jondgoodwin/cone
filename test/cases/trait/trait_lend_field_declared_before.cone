// Whether a struct meets a trait does not depend on declaration order. 'Ctx' is declared
// before 'Leaf', the type it holds and lends as '&<Named', and 'Named' has a method whose
// signature mentions '&<Named'. The lend is accepted straight out of a method and inside an
// 'Option', as it is when 'Leaf' is declared first.
//
//   Ctx lends its Leaf: name 1, and the Leaf has no parent, so "none"
//   the Option form: Some(&leaf), its name 1

mod trait_lend_field_declared_before;

import stdio use *;

trait Named {
  pub fn name(self: &) i32;
  pub fn parent(self: &) Option[&<Named];
}

struct Ctx {
  cause: Leaf;
  pub fn lent(self: &) &<Named { &cause }
  pub fn wrapped(self: &) Option[&<Named] { Some[&<Named](&cause) }
}

struct Leaf is Named {
  pub fn name(self: &) i32 { 1 }
  pub fn parent(self: &) Option[&<Named] { None[&<Named] }
}

fn main() {
  let c = Ctx(Leaf());
  let n = c.lent();
  printInt(i64.from(n.name()));
  printStr(" ");
  match n.parent() {
    case let Some(p) { printStr("parent"); }
    else { printStr("none"); }
  }
  printStr("\n");
  match c.wrapped() {
    case let Some(p) { printInt(i64.from(p.name())); }
    else { printStr("empty"); }
  }
  printStr("\n");
}
