// The explanation for a structural type lacking a defaulted method also comes at a
// return and at a variable's initialiser.

mod trait_default_structural_return;

trait Greeter {
  pub fn id(self: &) i64;
  pub fn bonus(self: &) i64 {100i64}
}

struct Lacking {
  pub fn id(self: &) i64 {1i64}
}

fn give(l: &Lacking) &<Greeter {   //~ ErrorInvType "declared function's return type"
  return l;   //~ ErrorInvType "Lacking does not declare `is Greeter`, so Greeter's default for `bonus` does not apply"
}

fn main() {
  var l = Lacking();
  let g: &<Greeter = &l;   //~ ErrorInvType "Lacking does not declare `is Greeter`, so Greeter's default for `bonus` does not apply"
}
