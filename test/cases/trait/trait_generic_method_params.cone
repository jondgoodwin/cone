// A trait's generic method is met by a generic method the type declares itself:
// the two methods' type parameters are matched by place, whatever each is
// called, and by bound. The type declares the trait with 'is' (A, whose 'X'
// stands for the trait's 'U'), or only has the method (B, met structurally
// through a bound); a method with two parameters, one bounded, is matched in
// each place. Reached: a direct call, a call through a bound ('[P: Pick]'), a
// bounded parameter, a result of the parameter's type. Each printed value was
// checked by hand against the source.

mod trait_generic_method_params;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

trait Pick {
  pub fn pick[U](self: &, u: U) U;
}

trait Pair {
  pub fn both[A, B: Integer](self: &, a: A, b: B) A;
}

struct Declared is Pick {
  pub v: i64;
  pub fn pick[X](self: &, u: X) X { u }
}

struct Only {
  pub v: i64;
  pub fn pick[Q](self: &, u: Q) Q { u }
}

struct Twin is Pair {
  pub v: i64;
  pub fn both[Left, Right: Integer](self: &, a: Left, b: Right) Left { a }
}

fn viaPick[P: Pick](p: &P) i64 { p.pick(9i64) }
fn viaPair[P: Pair](p: &P) i64 { p.both(4i64, 5i32) }

fn main() {
  let d = Declared(1);
  let o = Only(2);
  let t = Twin(3);
  show("direct-declared", d.pick(7i64));
  show("direct-only", o.pick(8i64));
  show("bound-declared", viaPick(&d));
  show("bound-only", viaPick(&o));
  show("pair", viaPair(&t));
}
