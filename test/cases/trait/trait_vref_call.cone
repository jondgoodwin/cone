// A virtual reference called as a function calls its trait's '()' method,
// dispatched through the vtable, as calling a value or a regular reference
// calls the type's own '()' (doc/reference/refmethop.html, "() Function call
// Operator"). Closure references (doc/reference/refcloref.html) rest on this.
//
// Two implementers behind each trait, so the printed numbers show each call
// reached the one the reference points at: a 'self &mut' '()' through '&<mut',
// whose changes to the value stay, and a 'self &' '()' through '&<'.

mod trait_vref_call;

import stdio use *;

trait Unary {
  pub fn `()`(self &mut, u f32) f32;
}

struct Ribs {
  pub count f32;
  pub depth f32;
  pub fn `()`(self &mut, u f32) f32 {
    count = count + 1.;
    1. - depth * u * count;
  }
}

struct Scale {
  pub k f32;
  pub fn `()`(self &mut, u f32) f32 {k * u;}
}

trait Reading {
  pub fn `()`(self &) i32;
}

struct Dial {
  pub n i32;
  pub fn `()`(self &) i32 {n + 1;}
}

struct Gauge {
  pub n i32;
  pub fn `()`(self &) i32 {n * 10;}
}

fn sample(f &<mut Unary, u f32) f32 {
  f(u);
}

fn read(r &<Reading) i32 {
  r();
}

fn main() {
  mut ribs = new Ribs(2., 0.25);
  mut scale = new Scale(3.);
  print <- sample(&mut ribs, 0.5), "\n";
  print <- sample(&mut ribs, 0.5), "\n";
  print <- ribs.count, "\n";
  print <- sample(&mut scale, 0.5), "\n";

  imm dial = new Dial(4);
  imm gauge = new Gauge(4);
  print <- read(&dial), "\n";
  print <- read(&gauge), "\n";
}
