// What a trait is: a named set of method and field requirements, and the
// virtual reference that dispatches through them at runtime.
//
// Two ways of satisfying a trait are exercised side by side, because they take
// different paths through the compiler. A type may conform structurally, by
// simply declaring what the trait requires and never naming it; or nominally,
// with 'extends', which mixes the trait's fields into the type and inherits any
// method the trait gave a body to. Only the nominal form gives '&Trait', a
// plain reference to a base trait; both give '&<Trait', the fat pointer that
// carries a vtable.
//
// Everything is printed, because a virtual call that compiles is not a virtual
// call that reached the right implementation.
//
// Narrowing a virtual reference back to a concrete type is in trait-narrow
// rather than here: it only works for a type that 'extends', and this file's
// point is that structural conformance is enough for dispatch.

import stdio::*

fn show(label &[]u8, n i64) {
  printStr(label)
  printStr(" = ")
  printInt(n)
  printStr("\n")
}

// -------- structural conformance --------

// A trait declaring one method requirement and naming no implementer.
trait Shape {
  fn area(self &) i32
}

// Rect satisfies Shape with one candidate of an overload set. 'area' is the
// overload name, so neither declaration is called 'area' and neither could be
// found by that name directly; the trait requirement still resolves, to the one
// candidate whose signature it asked for.
struct Rect {
  w i32
  h i32

  fn areaOf overload area(self &) i32 {w * h}
  fn areaScaled overload area(self &, scale i32) i32 {w * h * scale}
}

// Circle satisfies it the same way, so the two vtables are built from
// same-named concrete methods on unrelated types.
struct Circle {
  r i32

  fn areaOf overload area(self &) i32 {3 * r * r}
  fn areaScaled overload area(self &, scale i32) i32 {3 * r * r * scale}
}

// Square satisfies it with a directly named concrete method. Nothing about the
// trait distinguishes this case at the call site; the difference is only in
// which declaration the vtable slot ends up pointing at.
struct Square {
  side i32

  fn area(self &) i32 {side * side}
}

// The single virtual function all three reach.
fn virtualArea(shape &<Shape) i32 {
  shape.area()
}

fn structural() {
  imm rect = Rect[2, 3]
  imm circle = Circle[4]
  imm square = Square[5]
  show("virtual-dispatch-overload-candidate", virtualArea(&rect))
  show("virtual-dispatch-other-overload-candidate", virtualArea(&circle))
  show("virtual-dispatch-concrete-method", virtualArea(&square))

  // The concrete name is still callable directly, and reaches the same code the
  // vtable slot points at
  show("concrete-name-called-directly", (&rect).areaOf())
  show("other-candidate-not-in-vtable", (&rect).areaScaled(10))

  // One virtual reference variable, retargeted to a different concrete type:
  // the same call site loads a different vtable slot the second time
  mut v &<Shape = &rect
  show("virtual-ref-first-target", v.area())
  v = &square
  show("virtual-ref-retargeted", v.area())
}

// -------- a requirement that takes parameters --------

// Every requirement above takes only 'self', and for a long time that was the
// only kind that worked: conformance compared parameter declarations by node
// identity, which a trait's requirement and a separately written implementation
// can never satisfy, and the self parameter is skipped, so a self-only
// requirement was the one shape whose loop compared nothing.
//
// A requirement may take further parameters, and then the implementation's
// parameter types must match it exactly. A virtual reference dispatches through
// a typed vtable slot, so the machine signatures have to line up. Coercion is a
// convenience at a call site, and belongs to type comparison only where
// subtyping is in play, which it is not between a requirement and an
// implementation of it. trait-typecheck-vref holds the rejections.

trait Scaler {
  fn scaled(self &, factor i32) i32
}

// Two implementers whose answers differ for the same argument, so a dispatch
// that folded away, or read the wrong vtable slot, could not print both numbers
struct Box {
  w i32

  fn scaled(self &, factor i32) i32 {w * factor}
}

struct Cup {
  depth i32

  fn scaled(self &, factor i32) i32 {depth - factor}
}

// 'exactly' is the rule, so a requirement of several parameters and one whose
// parameter is itself a reference are where an accidental widening would show
trait Blender {
  fn blend(self &, a i32, b i32) i32
  fn viaRef(self &, r &i32) i32
}

struct Mix {
  k i32

  fn blend(self &, a i32, b i32) i32 {k * a + b}
  fn viaRef(self &, r &i32) i32 {k + *r}
}

struct Churn {
  k i32

  fn blend(self &, a i32, b i32) i32 {k + a * b}
  fn viaRef(self &, r &i32) i32 {k * *r}
}

// The one virtual function both implementers of each trait reach, so every
// argument is marshalled into a call whose callee is not known until it runs
fn scaledBy(s &<Scaler, factor i32) i32 {
  s.scaled(factor)
}

fn blendedBy(b &<Blender) i32 {
  b.blend(4, 5)
}

fn viaRefOf(b &<Blender) i32 {
  imm n = 11
  b.viaRef(&n)
}

fn parameterized() {
  imm box = Box[7]
  imm cup = Cup[100]
  show("parm-requirement-first-impl", scaledBy(&box, 3))
  show("parm-requirement-other-impl", scaledBy(&cup, 3))
  // The same call site with a different argument, so the parameter is really
  // passed through rather than folded into the implementation
  show("parm-requirement-other-argument", scaledBy(&box, 5))

  imm mix = Mix[6]
  imm churn = Churn[3]
  show("two-parm-requirement-first-impl", blendedBy(&mix))
  show("two-parm-requirement-other-impl", blendedBy(&churn))
  show("ref-parm-requirement-first-impl", viaRefOf(&mix))
  show("ref-parm-requirement-other-impl", viaRefOf(&churn))
}

// -------- nominal conformance with 'extends' --------

// A trait may require fields as well as methods, and may give a method a body,
// which becomes the default for any type that does not declare its own.
trait Meter {
  level i32

  fn reading(self &) i32 {level * 2}
  fn step(self &mut)
}

// Gauge takes the default 'reading' and must supply 'step'. 'level' is mixed
// in by 'extends' rather than declared here, so the constructor's first
// positional value fills it.
struct Gauge extends Meter {
  span i32

  fn step(self &mut) {self.level = self.level + 1}
}

// Dial declares its own 'reading', which replaces the default in its vtable.
struct Dial extends Meter {
  fn reading(self &) i32 {self.level * 100}
  fn step(self &mut) {self.level = self.level + 10}
}

// A plain reference to a base trait. This is not a virtual reference: it points
// at the mixed-in prefix of the concrete value, so it can read the trait's
// fields but dispatches nothing.
fn baseLevel(m &Meter) i32 {
  m.level
}

// A virtual reference to the same trait, which does dispatch
fn readingOf(m &<Meter) i32 {
  m.reading()
}

fn stepTwice(m &<mut Meter) {
  m.step()
  m.step()
}

// A field requirement is reached through the vtable too, and is writable
// through a '&<mut' virtual reference. The binding holding the reference is
// 'imm', which is the point: what a write through a reference is checked
// against is the reference's own permission and not the binding's. No
// dereference is injected for a virtual reference, so the field access keeps
// the reference as its object and has to take the permission from it directly,
// where a plain reference gets it from the injected deref.
fn setLevel(imm m &<mut Meter, n i32) {
  m.level = n
}

// The same write with a local binding rather than a parameter
fn setLevelLocally() i32 {
  mut g = Gauge[3, 7]
  imm m &<mut Meter = &mut g
  m.level = 40
  g.level
}

fn nominal() {
  mut g = Gauge[3, 7]
  mut d = Dial[5]

  show("base-trait-ref-reads-field", baseLevel(&g))
  show("base-trait-ref-other-type", baseLevel(&d))

  show("inherited-default-method", readingOf(&g))
  show("overriding-method-replaces-default", readingOf(&d))

  // The mixed-in field is still the type's own field for direct access
  show("mixed-in-field-direct", g.level)
  show("own-field-alongside-mixed-in", g.span)

  stepTwice(&mut g)
  stepTwice(&mut d)
  show("virtual-mutation-through-vref", g.level)
  show("virtual-mutation-other-type", d.level)

  setLevel(&mut g, 40)
  show("virtual-field-written-through-vref", g.level)
  show("virtual-field-read-through-vref", readingOf(&g))
  show("virtual-field-written-through-imm-local", setLevelLocally())
}

// -------- a virtual reference as data --------

// A virtual reference is an ordinary value: it can be a struct's field, and the
// struct then holds one implementation without knowing which.
struct Slot {
  held &<Shape
  uses i32
}

// The field may be set by the constructor and assigned afterwards. Assigning it
// is writing the field, not writing through the reference it holds, so what the
// write is checked against is the struct's permission and the field's own --
// never the permission of the trait reference being stored, which is what a
// '&<Shape' field used to be refused for.
fn storedVirtualRefs() {
  imm rect = Rect[2, 3]
  imm square = Square[5]
  mut v &<Shape = &rect
  mut first = Slot[v, 1]
  show("virtual-ref-in-struct-field", first.held.area())
  v = &square
  mut second = Slot[v, 2]
  show("virtual-ref-field-other-target", second.held.area())
  show("plain-field-alongside-virtual-ref", second.uses)

  // Retargeting the field itself, so the value read back proves the store
  // reached the field rather than merely type checking
  first.held = v
  show("virtual-ref-field-reassigned", first.held.area())
  first.uses = 9
  show("plain-field-reassigned-alongside", first.uses)
}

// -------- interaction with the constructs below this tier --------

// Virtual dispatch chosen by a branch and accumulated in a loop: the
// intersections where the vtable a call loads has to follow control flow.
fn interactions() {
  imm rect = Rect[2, 3]
  imm square = Square[5]

  mut total = 0
  mut i = 0
  while i < 4 {
    mut v &<Shape = if i % 2 == 0 {&rect} else {&square}
    total = total + v.area()
    i++
  }
  show("virtual-dispatch-in-loop-summed", total)

  // A virtual reference returned from a branch, then called once
  imm chosen &<Shape = if true {&square} else {&rect}
  show("virtual-ref-from-branch", chosen.area())
}

fn main() i32 {
  structural()
  parameterized()
  nominal()
  storedVirtualRefs()
  interactions()
  0i32
}
