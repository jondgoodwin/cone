// A structural type that lacks a trait method with no default is refused with the
// plain message: the 'is' explanation is only for a method the trait has a default for.

mod trait_default_structural_nodefault;

trait Greeter {
  pub fn id(self: &) i64;
  pub fn name(self: &) i64;
}

struct Lacking {
  pub fn id(self: &) i64 {1i64}
}

fn viaRef(g: &<Greeter) i64 {
  g.id() + g.name()
}

fn main() {
  var l = Lacking();
  viaRef(&l);   //~ ErrorInvType:10 "Expression's type does not match declared parameter"
}
