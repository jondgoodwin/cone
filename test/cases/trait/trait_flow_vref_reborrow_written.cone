// A written '&uni *v' reborrow of a '&<uni' freezes 'v' while the reborrow is
// still to be used, as the implicit one does (trait_flow_vref_reborrow).

mod trait_flow_vref_reborrow_written;

trait App {
  pub fn look(self: &) i64;
}

fn frozen(v: &<uni App) i64 {
  let r = &uni *v;
  let a = v.look();                //~ ErrorFrozen:11 "may not be borrowed"
  r.look() + a
}

fn main() {
}
