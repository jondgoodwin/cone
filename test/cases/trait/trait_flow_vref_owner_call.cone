// An owning virtual reference lent to one call twice, with no written borrow
// anywhere in the function: a '+<So' owner is 'uni', so a '&<mut' lend of it
// meets a '&<' lend, or a move, of it in the same call, as a plain owner's do
// (ref_flow_ownerlend_call). The receiver of a dispatch is lent too, so a
// 'self &mut' method handed its own receiver as an argument conflicts.
// A 'self &' method handed its receiver as a '&<' argument is two read-only
// lends and is allowed (trait_vref_owner_call runs it).
//
// One function per case, so that one borrow's conflict cannot stand in for
// another's.

mod trait_flow_vref_owner_call;

trait App {
  pub fn mix(self &mut, o &<App);
}

struct Spinner {
  pub n i64;
  pub fn mix(self &mut, o &<App) {}
}

fn both(x &<mut App, y &<App) {}
fn mutAndMove(x &<mut App, y So[App]) {}

fn mutAndRead() {
  imm a So[App] = +So Spinner[1];
  both(a, a);                      //~ ErrorFrozen:11 "may not be borrowed"
}

fn mutThenMove() {
  imm a So[App] = +So Spinner[1];
  mutAndMove(a, a);                //~ ErrorFrozen:17 "may not be moved"
}

fn receiverAndArgument() {
  imm a So[App] = +So Spinner[1];
  a.mix(a);                        //~ ErrorFrozen:3 "as the call's receiver"
}

fn main() {
}
