// An owning virtual reference lent to one call twice, with no written borrow
// anywhere in the function: a 'Uni[App]' owner is 'uni', so a '&<mut' lend of it
// meets a move of it in the same call, as a plain owner's does
// (ref_flow_ownerlend_call). A '&<mut' lend beside a '&<' one, and a 'self
// &mut' method handed its own receiver as a '&<' argument, are no conflict: the
// owner is one more alias, as through a shared path (trait_vref_owner_call runs
// them, as it does a 'self: &' method handed its receiver).
//
// One function per case, so that one borrow's conflict cannot stand in for
// another's.

mod trait_flow_vref_owner_call;

trait App {
  pub fn mix(self: &mut, o: &<App);
}

struct Spinner {
  pub n: i64;
  pub fn mix(self: &mut, o: &<App) {}
}

fn mutAndMove(x: &<mut App, y: Uni[App]) {}

fn mutThenMove() {
  let a: Uni[App] = Uni[Spinner](1);
  mutAndMove(a, a);                //~ ErrorFrozen:17 "may not be moved"
}

fn main() {
}
