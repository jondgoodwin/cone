// What a virtual reference may be made of, and what may be turned into one.
// Every diagnostic here is about a type not fitting where a virtual reference
// is asked for, or about a virtual reference not fitting where a plain type is;
// trait-typecheck-dispatch has the ones about using a virtual reference that
// does typecheck.
//
// Everything is inside a function body. A virtual reference in a parameter's
// type would be checked in the signature pass, whose errors suppress every
// body-pass diagnostic in the file (module.c), so the one function taking one
// is written to be correct.

trait Shape {
  fn area(self &) i32
}

struct Rect {
  w i32
  fn area(self &) i32 {w}
}

// Declares nothing the trait asks for
struct Blob {
  z i32
}

fn virtualArea(s &<Shape) i32 {
  s.area()
}

// A requirement that takes a parameter beyond 'self'. An implementation's
// parameter types must match it exactly: a virtual reference dispatches through
// a typed vtable slot, so the machine signatures have to line up. Coercion is a
// convenience at a call site, and belongs to type comparison only where
// subtyping is in play, which it is not between a requirement and an
// implementation of it -- so neither a widening conversion nor a borrow
// satisfies one. trait-success runs the conforming cases.
trait Scaler {
  fn scaled(self &, factor i32) i32
}

// The right name and arity, the wrong parameter type. i32 coerces to f32 at a
// call, and that is exactly what must not make this conform.
struct WrongParmType {
  w i32

  fn scaled(self &, factor f32) i32 {w}
}

// The right name, arity and value type, reached through a reference. A
// reference to the required type is not the required type.
struct RefInsteadOfValue {
  w i32

  fn scaled(self &, factor &i32) i32 {w}
}

// The right parameter types, one too many of them
struct TooManyParms {
  w i32

  fn scaled(self &, factor i32, extra i32) i32 {w}
}

fn virtualScaled(s &<Scaler) i32 {
  s.scaled(3)
}

fn misuse() {
  imm r = Rect[2]
  imm b = Blob[3]

  // A trait whose implementations differ in size has no one size, so it is not
  // a type a value can have. Only a virtual reference to one is usable, and
  // that is what the diagnostic names as the remedy.
  mut bare Shape   //~ ErrorNoSize:7 "implementations may differ in size"

  // A virtual reference's target must be a struct or trait; a number has no
  // vtable to build
  imm toNumber &<i32 = &r   //~ ErrorInvType:16 "must be to a struct or trait"
                            //~^ ErrorInvType:24 "does not match variable's declared type" follow-on

  // Blob satisfies nothing Shape requires, so no vtable can be built for it and
  // the reference does not coerce
  imm fromBlob &<Shape = &b   //~ ErrorInvType:26 "does not match variable's declared type"

  // The same rejection at a call, where the parameter is what asks
  virtualArea(&b)   //~ ErrorInvType:15 "does not match declared parameter"

  // A virtual reference does not silently become a plain one again: the
  // concrete type has to be recovered by matching on it
  imm ok &<Shape = &r
  imm back &Rect = ok   //~ ErrorInvType:20 "does not match variable's declared type"

  // A parameter the requirement does not declare exactly is a parameter the
  // requirement is not satisfied by, however readily it would coerce at a call
  imm wrongType = WrongParmType[4]
  imm wrongRef = RefInsteadOfValue[5]
  imm tooMany = TooManyParms[6]
  virtualScaled(&wrongType)   //~ ErrorInvType:17 "does not match declared parameter"
  virtualScaled(&wrongRef)    //~ ErrorInvType:17 "does not match declared parameter"
  virtualScaled(&tooMany)     //~ ErrorInvType:17 "does not match declared parameter"
}
