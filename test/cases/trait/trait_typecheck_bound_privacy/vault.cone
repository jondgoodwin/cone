// The module that owns the types with private members, and instantiates the
// generics of another module with them (trait_typecheck_bound_privacy.cone).

pub mod vault;
import lib;

pub struct Secret {
  id: u32;
  pub other: u32;
  fn hidden(self: &) u32 { id * 3u32 }
}

// The same members, public
pub struct Open {
  pub id: u32;
  pub fn hidden(self: &) u32 { id * 3u32 }
}

pub fn make(n: u32) Secret { new Secret(n, 0u32) }
pub fn makeOpen(n: u32) Open { new Open(n) }

// The code in the type's own module can name the members, but a generic's body
// is lib's code and cannot: the type does not meet the bound
fn fromOwner() u32 {
  let s = make(5u32);
  lib.getId(&s);         //~ ErrorPrivateMatch:6 "getId requires T is Id, and Secret is not Id. The field `id` of Secret is private to its module"
  lib.callHidden(&s);    //~ ErrorPrivateMatch:6 "callHidden requires T is Hidden, and Secret is not Hidden. The method `hidden` of Secret is private to its module"
  lib.whereHidden(&s);   //~ ErrorPrivateMatch:6 "whereHidden requires T is Hidden, and Secret is not Hidden."
  lib.viaHolder(s);      //~ ErrorPrivateMatch:6 "viaHolder requires T is Hidden, and Secret is not Hidden."
  let h = new lib.Holder(s); //~ ErrorPrivateMatch:11 "Holder requires T is Hidden, and Secret is not Hidden."
  0u32
}

// The same members made 'pub' meet every bound
fn fromOwnerOpen() u32 {
  let o = makeOpen(5u32);
  lib.getId(&o) + lib.callHidden(&o) + lib.whereHidden(&o) + lib.viaHolder(o)
}
