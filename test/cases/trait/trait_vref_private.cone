// What a trait's private members still do, beside the virtual dispatch that
// cannot reach them (trait_typecheck_vref_private). The vtable holds a trait's
// public members only, so a private method is neither a slot nor a requirement
// (doc/reference/refvirtref.html, "Type Restrictions"), and nothing here
// dispatches to one.
//
// - A public method dispatches through a virtual reference, borrowed or owning,
//   made from a type whose trait also declares a private method.
// - A type's private method fills a public slot: conformance is structural, and
//   the trait's 'pub' is what makes the slot callable. Called on the concrete
//   type it is the same method.
// - A private method is called on the concrete type directly.
// - A trait's default reaches a private requirement through 'self', in each
//   implementer's own copy, where 'self' is the implementer and no dispatch is
//   involved; the default is then dispatched through a virtual reference. An
//   enum's method reaches a variant's private one the same way.

mod trait_vref_private;

import stdio use *;

trait Layer {
  pub fn depth(self &) u32;
  pub fn total(self &) u32 {self.pending() + 100u32;}
  fn pending(self &) u32;
}

struct Plain is Layer {
  pub n u32;
  fn depth(self &) u32 {n;}
  fn pending(self &) u32 {n + 1u32;}
}

enum Signal {
  pub fn total(self &) i32 {self.weight() + 1;}
  fn weight(self &) i32;

  struct Low {
    pub n i32;
    fn weight(self &) i32 {n;}
  }
  struct High {
    pub n i32;
    fn weight(self &) i32 {n * 100;}
  }
}
use Signal;

fn look(l &<Layer) u32 {l.depth();}
fn sum(l &<Layer) u32 {l.total();}
fn weigh(s &Signal) i32 {s.total();}

fn main() {
  imm plain = new Plain(3u32);
  print <- look(&plain), "\n";
  print <- plain.depth(), "\n";
  print <- plain.pending(), "\n";
  print <- sum(&plain), "\n";

  mut owner So[Layer] = new So[Plain](7u32);
  print <- owner.depth(), "\n";
  print <- owner.total(), "\n";

  imm low = Low[2];
  imm high = High[3];
  print <- weigh(&low), "\n";
  print <- weigh(&high), "\n";
}
