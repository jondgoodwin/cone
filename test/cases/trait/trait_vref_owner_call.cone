// An owning virtual reference lent as a borrowed one, each lend ending with its
// call: lent as '&<mut' twice one call after another, lent twice to one call
// as '&<', as '&<mut' beside '&<' (the owner is one more alias, as a place
// reached through a shared path is), and a 'self: &' or 'self: &mut' dispatch
// handed its own receiver as a '&<' argument. None of these holds a written
// borrow, and none conflicts. Two lends that do conflict in one call are
// trait_flow_vref_owner_call.
//
// The owner is '+ ShapeKeeping', and so is the '&<mut' that 'both' takes beside the '&<' borrow: a
// call through a virtual reference may replace an owner of the type, as it may reshape a collection,
// unless the reference promises it keeps the borrows of its caller (region_flow_owner_kinds holds the
// refusal without the mark).

mod trait_vref_owner_call;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

trait App {
  pub fn frame(self: &mut) bool;
  pub fn look(self: &) i64;
  pub fn see(self: &, o: &<App) i64;
  pub fn mix(self: &mut, o: &<App);
}

struct Spinner {
  pub n: i64;
  pub fn frame(self: &mut) bool {n = n + 1; n < 4}
  pub fn look(self: &) i64 {n}
  pub fn see(self: &, o: &<App) i64 {n + o.look()}
  pub fn mix(self: &mut, o: &<App) { n = n + o.look(); }
}

fn nudge(x: &<mut App) { x.frame(); }
fn sum(x: &<App, y: &<App) i64 { x.look() + y.look() }
fn both(x: &<mut App + ShapeKeeping, y: &<App) { x.frame(); }

fn main() {
  let a: Uni[App + ShapeKeeping] = Uni[Spinner](1);
  nudge(a);
  nudge(a);
  show("seq", a.look());
  show("two-read", sum(a, a));
  show("see", a.see(a));
  a.frame();
  show("after", a.look());
  both(a, a);
  show("mut-and-read", a.look());
  a.mix(a);
  show("mix-self", a.look());
}
