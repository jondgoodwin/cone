// Getting the concrete type back from a trait value (downcast), Rust's 'is' and
// downcast_ref / downcast_mut. A virtual reference's vtable says which concrete type
// made it, so 'v is T' is true exactly when that type is T, and a bound pattern
// 'case let T(x)' gives x a reference to the value as T with the trait value's own
// permission: '&<Named' gives '&Cat', '&<mut Named' a '&mut Cat' that writes through,
// '&<uni Named' a '&uni Cat'. A generic type's instance is a type like any other,
// 'v is Box[i64]'.
//
// Through an OWNING trait value ('Uni[Named]', 'Rc[Named]', a field holding one) the
// binding is a borrow of the value, never the owner: the owner is lent, not moved, so
// it is used again after the match, and the borrow writes only where the path to the
// owner may ('&mut' through a 'var' or a '&mut Holder', '&' through a '&Holder').
// (Refusals: trait_typecheck_downcast. Two objects: module_build_link.)

mod trait_downcast;

import stdio use *;

trait Named {
  pub fn label(self: &) i64;
}

struct Cat is Named {
  pub lives: i64;
  pub fn label(self: &) i64 {lives}
}

struct Dog is Named {
  pub barks: i64;
  pub fn label(self: &) i64 {barks * 100}
}

struct Box[T] is Named {
  pub v: T;
  pub fn label(self: &) i64 {7}
}

struct Holder {
  pub inner: Uni[Named];
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn flag(b: bool) i64 { if b {1} else {0} }

// Each concrete type tested, and bound to a reference of its own type
fn isCat(n: &<Named) i64 { flag(n is Cat) }
fn isCatRef(n: &<Named) i64 { flag(n is &Cat) }
fn isDog(n: &<Named) i64 { flag(n is Dog) }

fn which(n: &<Named) i64 {
  match n {
    case let Cat(c) {c.lives * 10}
    case let Dog(d) {d.barks * 1000}
    else {0}
  }
}

fn dogBarks(n: &<Named) i64 {
  if let Dog(d) = n {d.barks} else {-1}
}

// A '&<mut' trait value binds a '&mut': the write reaches the value
fn feed(n: &<mut Named) {
  match n {
    case let Cat(c) {c.lives = c.lives + 1;}
    case let Dog(d) {d.barks = d.barks * 2;}
    else {}
  }
}

// A '&<uni' binds a '&uni', which only a '&uni' parameter takes (a '&mut' is not one)
fn uniLives(c: &uni Cat) i64 {
  c.lives = c.lives + 100;
  c.lives
}

fn takeUni(n: &<uni Named) i64 {
  match n {
    case let Cat(c) {uniLives(c)}
    else {0}
  }
}

// A generic type's instance
fn isBoxI64(n: &<Named) i64 { flag(n is Box[i64]) }
fn isBoxF64(n: &<Named) i64 { flag(n is Box[f64]) }
fn boxed(n: &<Named) i64 {
  match n {
    case let Box[i64](b) {b.v}
    else {-1}
  }
}

// Owners: the binding borrows; the owner is lent and stays
fn ownerLocal() i64 {
  var u: Uni[Named] = Uni[Cat](Cat(5));
  let before = match u {
    case let Cat(c) {c.lives}
    else {0}
  };
  // The binding is a '&mut Cat', lent from the 'var' owner: the write reaches it
  match u {
    case let Cat(c) {c.lives = c.lives + 1;}
    else {}
  }
  if u is Dog { return -1; }
  before * 100 + u.label()
}

// A field through a read-only borrow of its holder: a '&' of the value
fn ownerField(h: &Holder) i64 {
  match h.inner {
    case let Cat(c) {c.lives}
    case let Dog(d) {d.barks}
    else {0}
  }
}

// ... and through a '&mut Holder': a '&mut' that writes
fn ownerFieldMut(h: &mut Holder) {
  if let Cat(c) = h.inner { c.lives = 42; }
}

// An owner a call returns, held by the match itself
fn makeDog() Uni[Named] { Uni[Dog](Dog(3)) }
fn ownerTemp() i64 {
  match makeDog() {
    case let Dog(d) {d.barks}
    else {0}
  }
}

// A counted owner
fn ownerRc() i64 {
  let r: Rc[Named] = Rc[Cat](Cat(11));
  let lives = match r {
    case let Cat(c) {c.lives}
    else {0}
  };
  lives * 100 + r.label()
}

// A generic method's instance binds through its owner field too, the type argument's
// pattern and a named one in turn (the instance's copy of each pattern is bound
// where the binding is made)
struct Kept {
  pub inner: Uni[Named];

  pub fn find[E](self: &) i64 {
    if let E(e) = inner { return 1; }
    if let Dog(d) = inner { return d.barks; }
    0
  }
}

fn main() {
  var c = Cat(9);
  var d = Dog(4);
  show("cat-is-cat", isCat(&c));
  show("cat-is-cat-ref", isCatRef(&c));
  show("cat-is-dog", isDog(&c));
  show("dog-is-cat", isCat(&d));
  show("dog-is-dog", isDog(&d));
  show("which-cat", which(&c));
  show("which-dog", which(&d));
  show("if-let-dog", dogBarks(&d));
  show("if-let-cat", dogBarks(&c));

  feed(&mut c);
  feed(&mut d);
  show("fed-cat", c.lives);
  show("fed-dog", d.barks);
  show("uni-cat", takeUni(&uni c));

  let b = Box[i64](33);
  let bf = Box[f64](1.5);
  show("box-is-box-i64", isBoxI64(&b));
  show("box-f64-is-box-i64", isBoxI64(&bf));
  show("box-f64-is-box-f64", isBoxF64(&bf));
  show("cat-is-box-i64", isBoxI64(&c));
  show("boxed", boxed(&b));
  show("boxed-cat", boxed(&c));

  show("owner-local", ownerLocal());
  var h = Holder(Uni[Dog](Dog(8)));
  show("owner-field-dog", ownerField(&h));
  h.inner = Uni[Cat](Cat(6));
  show("owner-field-cat", ownerField(&h));
  ownerFieldMut(&mut h);
  show("owner-field-mut", ownerField(&h));
  show("owner-field-after", h.inner.label());
  show("owner-temp", ownerTemp());
  show("owner-rc", ownerRc());
  let k = Kept(Uni[Dog](Dog(5)));
  show("generic-owner-other", k.find[Cat]());
  show("generic-owner-same", k.find[Dog]());
}
