// An owning virtual reference releases what it owns exactly as a plain owner
// does: when the last owner goes away, the concrete value is finalized and its
// memory given back through the region's 'free'. Its concrete type is erased,
// so the finalizer and the value's alignment come from the implementer's type
// record, which every vtable carries in its last slot; the alignment says where
// the region's header sits before the value. Before, nothing was ever
// finalized or freed: out of scope, replaced, moved, returned or held in a
// struct, the value leaked.
//
// 'One' is a single-owner region and 'Tally' a counted one; both count their
// allocations and frees, and print each free. 'Tally' also prints each count
// change: '+n' after an 'aliasRef', '-n' after a 'dealiasRef'. Its header is a u32,
// so a Fin (an i64, aligned to 8) sits 8 bytes after it and a Small (an i32,
// aligned to 4) 4 bytes after it: a count read from the wrong place would print
// a wrong number, and a free of the wrong address would crash. 'F<n>' is a
// Fin's 'final', 'S<n>' a Small's, 'H' a Holder's. A move leaves nothing for
// its source to release, so each death appears once, and the counts at the
// end say every allocation was freed.

mod trait_vref_final;

import stdio use *;
import libc;

var @threadlocal allocs = 0i64;
var @threadlocal frees = 0i64;

struct One is RegionRef, Move {
  fn alloc(size usize) *u8 inline { allocs = allocs + 1; malloc(size) }
  fn free(self &uni One) inline { frees = frees + 1; printStr("free "); libc.free(self as *u8); }
}

struct Tally is RegionRef {
  owners u32;
  fn alloc(size usize) *u8 inline { allocs = allocs + 1; malloc(size) }
  fn init(self &new) inline { *self = new Tally(1u32); }
  fn aliasRef(self &uni Tally) inline { owners = owners + 1u32; printStr("+"); printInt(i64.from(owners)); printStr(" "); }
  fn dealiasRef(self &uni Tally) bool inline { owners = owners - 1u32; printStr("-"); printInt(i64.from(owners)); printStr(" "); owners == 0u32 }
  fn free(self &uni Tally) inline { frees = frees + 1; printStr("tfree "); libc.free(self as *u8); }
}

trait App {
  pub fn look(self &) i64;
}

struct Fin {
  pub n i64;
  pub fn look(self &) i64 {n}
  fn final(self &uni) { printStr("F"); printInt(n); printStr(" "); }
}

// A second implementer, of another size and alignment
struct Small {
  pub n i32;
  pub fn look(self &) i64 {i64.from(n)}
  fn final(self &uni) { printStr("S"); printInt(i64.from(n)); printStr(" "); }
}

struct Holder {
  pub app One[App];
  fn final(self &uni) { printStr("H "); }
}

// Its drop is all generated
struct Bare { pub app One[App]; }

fn show(label &str) { printStr(label); printStr(": "); }
fn end() { printStr("|\n"); }

fn take(x One[App]) { printStr("took "); }
fn make(n i64) One[App] { new One[Fin](n) }
fn makeLocal() One[App] { let f = new One[Fin](3); printStr("made "); f }
fn peek(x &<App) i64 { x.look() }

// A move on one path only: the drop flag decides
fn maybeTake(b bool) {
  let a One[App] = new One[Fin](4);
  if b { take(a); }
  printStr("after ");
}

fn main() i32 {
  show("scope"); { let a One[App] = new One[Fin](1); printStr("in "); } end();
  show("replaced"); { var a One[App] = new One[Fin](1); a = new One[Fin](2); printStr("set "); } end();
  show("moved-to-param"); { let a One[App] = new One[Fin](1); take(a); printStr("back "); } end();
  show("plain-to-param"); { let p = new One[Fin](1); take(p); printStr("back "); } end();
  show("returned"); { let a = make(2); printInt(a.look()); printStr(" "); } end();
  show("returned-local"); { let a = makeLocal(); printInt(a.look()); printStr(" "); } end();
  show("moved-on-one-path"); maybeTake(true); end();
  show("kept-on-other-path"); maybeTake(false); end();
  show("field"); { let h = new Holder(new One[Fin](5)); printStr("in "); } end();
  show("field-from-local"); { let a One[App] = new One[Fin](5); let h = new Holder(a); printStr("in "); } end();
  show("field-replaced"); { var h = new Holder(new One[Fin](5)); h.app = new One[Fin](6); printStr("set "); } end();
  show("bare-field"); { let b = new Bare(new One[Fin](6)); printStr("in "); } end();
  show("two-types"); { let a One[App] = new One[Fin](7); let b One[App] = new One[Small](8); printStr("in "); } end();
  show("in-option"); { let o Option[One[App]] = Some[One[App]](new One[Fin](9)); printStr("in "); } end();
  show("counted-moved"); { let c Tally[App] = new Tally[Fin](10); { let d = c; printStr("moved "); } printStr("inner "); } end();
  show("counted-two-aliases"); { let c Tally[mut, App] = new Tally[mut, Fin](11); { let d = c; printStr("copy "); } printStr("inner "); } end();
  show("counted-small"); { let c Tally[mut, App] = new Tally[mut, Small](12); { let d = c; printInt(d.look()); printStr(" "); } printStr("inner "); } end();
  show("counted-from-plain"); { let p = new Tally[mut, Fin](13); { let v Tally[mut, App] = p; printStr("view "); } printStr("inner "); } end();
  show("borrowed"); { let f = new Fin(14); { let b &<App = &f; printInt(peek(b)); printStr(" "); } printStr("inner "); } end();
  printStr("allocs="); printInt(allocs); printStr(" frees="); printInt(frees); printStr("\n");
  0
}
