// An owning virtual reference lent as a borrowed one is borrowed from, as a
// plain owner lent as '&mut' or '&' is: while a local holds the borrow, the
// owner may not be replaced, moved, or lent again (as a method's receiver,
// 'a.look()') past a mutable borrow, until the borrow's last use
// (trait_vref_owner runs the uses that are allowed).
//
// One function per case, so that one borrow's conflict cannot stand in for
// another's.

mod trait_flow_vref_owner;

trait App {
  pub fn frame(self &mut) Bool;
  pub fn look(self &) i64;
}

struct Spinner {
  pub n i64;
  pub fn frame(self &mut) Bool {n = n + 1; n < 4;}
  pub fn look(self &) i64 {n;}
}

fn eat(x So[App]) {}

fn heldReplace() {
  mut a So[App] = +So Spinner[0];
  imm b &<mut App = a;
  a = +So Spinner[5];              //~ ErrorFrozen:3 "may not be changed"
  b.frame();
}

fn heldMove() {
  mut a So[App] = +So Spinner[0];
  imm b &<App = a;
  eat(a);                          //~ ErrorFrozen:7 "may not be moved"
  b.look();
}

fn heldRead() i64 {
  mut a So[App] = +So Spinner[0];
  imm b &<mut App = a;
  imm k = a.look();                //~ ErrorFrozen:11 "may not be borrowed"
  b.frame();
  k;
}

fn main() {
}
