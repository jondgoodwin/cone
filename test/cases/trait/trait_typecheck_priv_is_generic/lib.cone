// The generics and the traits that bound them (trait_typecheck_priv_is_generic.cone)

pub mod lib;

pub trait Hidden {
  pub fn hidden(self: &) u32;
}

pub trait Other {
  pub fn other(self: &) u32;
}

// Calls the method its bound names: a type declaring the bound meets it
pub fn callHidden[T: Hidden](x: &T) u32 { x.hidden() }

// Calls one the bound does not name: the bound promises nothing of it, so it is
// not named from here, though the type declares another trait that does
pub fn callOther[T: Hidden](x: &T) u32 { x.other() }    //~ ErrorNotPublic:43 "May not access the private method/field `other`"
pub fn callSecret[T: Hidden](x: &T) u32 { x.secret() }  //~ ErrorNotPublic:44 "May not access the private method/field `secret`"
