// What stays refused beside trait_priv_is_generic. A type declaring a trait with
// 'is' meets it everywhere, and nothing more: another module's generic bounded
// by the trait names the members the trait requires, and no other member of the
// type; a type that does not declare the trait fails the bound (1505); and code
// that is not a generic's body, written in a third module, reaches no private
// method of the type directly.

mod trait_typecheck_priv_is_generic;

fn fromThird() u32 {
  let s = vault.make(5u32);
  let p = vault.plain(5u32);
  lib.callHidden(&s);    // accepted: the bound names it
  lib.callHidden(&p);    //~ ErrorPrivateMatch:6 "callHidden requires T is Hidden, and Plain is not Hidden. The method `hidden` of Plain is private to its module"
  lib.callOther(&s);
  lib.callSecret(&s);
  s.hidden();            //~ ErrorNotPublic:4 "May not access the private method/field `hidden`"
  0u32
}
