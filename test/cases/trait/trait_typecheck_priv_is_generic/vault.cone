// A module whose types keep their methods private (trait_typecheck_priv_is_generic.cone)

pub mod vault;

import lib use Hidden, Other;

// Declares both traits, with 'is'
pub struct Sealed is Hidden, Other {
  id: u32;
  fn hidden(self: &) u32 { id * 3u32 }
  fn other(self: &) u32 { id * 5u32 }
  fn secret(self: &) u32 { id * 7u32 }
}

// Has the same members and declares neither
pub struct Plain {
  id: u32;
  fn hidden(self: &) u32 { id * 3u32 }
}

pub fn make(n: u32) Sealed { Sealed(n) }
pub fn plain(n: u32) Plain { Plain(n) }
