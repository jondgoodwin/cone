// A virtual reference is a fat pointer built by coercing a plain reference, not
// something a borrow or an allocation can produce directly. Every form of
// writing '&<' or '+<' as an operator rather than as a type is rejected here.
//
// This is its own file because the diagnostic is raised during name resolution,
// when '&<' followed by a value rather than a type is found not to be a type
// after all. Name resolution errors return before type checking, so anything
// this file also claimed about types would never be reached.

trait Shape {
  fn area(self &) i32
}

struct Rect {
  w i32
  fn area(self &) i32 {w}
}

fn borrows() {
  mut r = Rect[2]

  // Borrowing a virtual reference from a place
  imm a = &<r        //~ ErrorBadTerm:11 "May not borrow or allocate a virtual reference"

  // The same with a permission, so it is not the bare form alone that fails
  imm b = &<mut r    //~ ErrorBadTerm:11 "May not borrow or allocate a virtual reference"

  // Allocating one into a region, the form the reference manual uses for
  // closure references
  imm c = +<rc-mut Rect[3]   //~ ErrorBadTerm:11 "May not borrow or allocate a virtual reference"
}
