// A function traitmeter folds in with a wildcard import and names inside a
// trait's default method. Imported by traitmeter.cone and never compiled on its
// own, so it is listed in cases.toml as a support module. Its name carries no
// '-' because a module's name is also its qualifier.

mod traitscale;

pub fn twice(n i32) i32 {
  n * 2i32;
}
