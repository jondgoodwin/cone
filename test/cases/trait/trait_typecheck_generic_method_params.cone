// A trait's generic method is not met by a generic method whose type parameters
// differ in number or in bound from the trait's, matched by place: the same
// signature otherwise, so the refusal is the one a wrong signature gets.

mod trait_typecheck_generic_method_params;

trait Pick {
  pub fn pick[U: Integer](self: &, u: U) U;
}

struct Looser is Pick {   //~ ErrorInvType:8 "none of what it declares has the signature Pick requires"
  v: i64;
  pub fn pick[X](self: &, u: X) X { u }
}

struct MoreParms is Pick {   //~ ErrorInvType:8 "none of what it declares has the signature Pick requires"
  v: i64;
  pub fn pick[X: Integer, Y](self: &, u: X) X { u }
}

struct Exact is Pick {
  v: i64;
  pub fn pick[X: Integer](self: &, u: X) X { u }
}

fn main() i32 { 0 }
