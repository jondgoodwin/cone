// A module whose types keep a field and a method private, and a module whose
// traits name the same members as requirements
// (trait_typecheck_private_match.cone)

pub mod vault;

pub struct Secret {
  id u32;
  pub other u32;
  fn hidden(self &) u32 { id * 3u32; }
}

// The same members, public
pub struct Open {
  pub id u32;
  pub fn hidden(self &) u32 { id * 3u32; }
}

pub struct Counter {
  pub mut total u32;
  fn bump(self &mut) { total = total + 1u32; }
}

pub fn make(n u32) Secret { new Secret(n, 0u32); }
pub fn makeOpen(n u32) Open { new Open(n); }
pub fn makeCounter() Counter { new Counter(0u32); }
