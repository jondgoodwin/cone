// A type extending a trait declared in an imported module, and inheriting a
// default method whose body names what that module folded in.
//
// Modules are name resolved in the order they were loaded, and the root loads
// first, so Gauge is resolved before traitmeter is: Meter's members have to be
// in Gauge's dictionary before Gauge's own bodies are resolved, which means
// Meter is resolved on demand, ahead of its module, in that module's own scope.
// What that scope must contain is what the module's wildcard import will fold
// -- 'twice', which the default method names -- without the fold itself running
// early, since whether 'traitmeter::twice' can be reached from here is decided
// by that fold and when it runs (module-nameres-transit).
//
// It compiles rather than runs for the reason every 'import' scenario does: the
// imported modules' bodies are not generated here.
//
// The imported modules are traitmeter.cone and, through it, traitscale.cone.

import traitmeter;

struct Gauge extends traitmeter::Meter {
  pub span i32;

  pub fn step(self &mut) {level = level + 1;}

  // The inherited default and the inherited field, named bare here as in
  // trait-success, across the module boundary
  pub fn report(self &) i32 {doubled() + level;}
}

fn drive(g &mut Gauge) i32 {
  g.step();
  g.report();
}
