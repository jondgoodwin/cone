// Known defect. Writing through a virtual reference is checked against the
// binding that holds the reference rather than against the reference's own
// permission, so two writes that should be allowed are rejected with ErrorNoMut.
//
// Both cases work when the same thing is written with a plain reference: an
// 'imm' binding holding a '&mut Rect' may write through it, and a struct field
// of type '&i32' may be assigned. Only the virtual forms fail.
//
// trait-success writes through a virtual reference the ways that do work: a
// 'mut' local, and a 'mut' parameter.
//
// Only the first of the two is reported. ErrorNoMut is raised during data-flow
// analysis, which runs per function only while the error count is zero, so the
// first one silences the second. Each fails on its own.

trait Meter {
  level i32
}

struct Gauge extends Meter {
  span i32
}

trait Shape {
  fn area(self &) i32
}

struct Rect {
  w i32
  fn area(self &) i32 {w}
}

struct Slot {
  held &<Shape
}

// The reference is '&<mut', so the write is what the permission is for. The
// binding is 'imm', which is what it is rejected for.
fn writeThroughImmBinding() i32 {
  mut g = Gauge[3, 7]
  imm m &<mut Meter = &mut g
  m.level = 40
  g.level
}

// The struct is 'mut' and the field is an ordinary field, but a field whose
// type is a virtual reference cannot be assigned at all.
fn assignVirtualRefField() i32 {
  imm r = Rect[2]
  mut v &<Shape = &r
  mut s = Slot[v]
  s.held = v
  s.held.area()
}
