// What a virtual reference may be made of, and what may be turned into one.
// Every diagnostic here is about a type not fitting where a virtual reference
// is asked for, or about a virtual reference not fitting where a plain type is;
// trait-typecheck-dispatch has the ones about using a virtual reference that
// does typecheck.
//
// Everything is inside a function body. A virtual reference in a parameter's
// type would be checked in the signature pass, whose errors suppress every
// body-pass diagnostic in the file (module.c), so the one function taking one
// is written to be correct.

trait Shape {
  pub fn area(self &) i32;
}

struct Rect {
  pub w i32;
  fn area(self &) i32 {w;}
}

// Declares nothing the trait asks for
struct Blob {
  pub z i32;
}

fn virtualArea(s &<Shape) i32 {
  s.area();
}

// A requirement that takes a parameter beyond 'self'. An implementation's
// parameter types must match it exactly: a virtual reference dispatches through
// a typed vtable slot, so the machine signatures have to line up. Coercion is a
// convenience at a call site, and belongs to type comparison only where
// subtyping is in play, which it is not between a requirement and an
// implementation of it -- so neither a widening conversion nor a borrow
// satisfies one. trait-success runs the conforming cases.
trait Scaler {
  pub fn scaled(self &, factor i32) i32;
}

// The right name and arity, the wrong parameter type. i32 coerces to f32 at a
// call, and that is exactly what must not make this conform.
struct WrongParmType {
  pub w i32;

  fn scaled(self &, factor f32) i32 {w;}
}

// The right name, arity and value type, reached through a reference. A
// reference to the required type is not the required type.
struct RefInsteadOfValue {
  pub w i32;

  fn scaled(self &, factor &i32) i32 {w;}
}

// The right parameter types, one too many of them
struct TooManyParms {
  pub w i32;

  fn scaled(self &, factor i32, extra i32) i32 {w;}
}

fn virtualScaled(s &<Scaler) i32 {
  s.scaled(3);
}

// A trait that requires a generic method cannot be reached through a virtual
// reference at all, whatever any type declares. A vtable slot holds one machine
// signature and a generic method has one per instantiation, so there is nothing
// to put in the slot. doc/reference/refvirtref.html, "Type
// Restrictions", is the rule. The trait's own declaration is what is wrong, so
// that is where it is reported -- once, when the first virtual reference to the
// trait asks for a vtable, rather than once per coercion site.
trait Sizer {
  pub fn size(self &) i32;
  pub fn pick[T](self &, v T) T;   //~ ErrorGenericVtable:7 "unusable behind a virtual reference"
}

// A default body makes no difference: a default is still a requirement, and it
// still has one signature per instantiation rather than one.
trait Defaulter {
  pub fn tally(self &) i32;
  pub fn pick[T](self &, v T) T {v;}   //~ ErrorGenericVtable:7 "unusable behind a virtual reference"
}

// Declares everything both traits ask for, the generic method included, and
// reaches neither of them through a virtual reference.
struct Boxy {
  pub w i32;

  fn size(self &) i32 {w;}
  fn tally(self &) i32 {w;}
  fn pick[T](self &, v T) T {v;}
}

// A generic method that is private, and a generic function with no receiver,
// are neither vtable slots nor requirements, so neither costs the trait its
// virtual reference. Nothing is reported against Quiet, and Quill coerces.
trait Quiet {
  pub fn span(self &) i32;
  fn hidden[T](self &, v T) T {v;}
  pub fn make[T](v T) T {v;}
}

struct Quill {
  pub w i32;
  fn span(self &) i32 {w;}
}

fn misuse() {
  imm r = Rect[2];
  imm b = Blob[3];

  // A trait whose implementations differ in size has no one size, so it is not
  // a type a value can have. Only a virtual reference to one is usable, and
  // that is what the diagnostic names as the remedy.
  mut bare Shape;   //~ ErrorNoSize:7 "implementations may differ in size"

  // A virtual reference's target must be a trait; a number has no vtable to build
  imm toNumber &<i32 = &r;   //~ ErrorInvType:16 "must be to a trait"
                            //~^ ErrorInvType:24 "does not match variable's declared type" follow-on

  // A plain struct is refused for the same reason, and this is the spelling that
  // used to crash rather than say so. Writing '&<Rect' directly was caught in
  // name resolution; coercing a plain reference into one reached
  // structMakeVtable, which ends by walking the list of derived types that only
  // a trait allocates, and read a NULL one. Whether a virtual reference to a
  // struct should instead work is a language question, and
  // workitems/Types. Struct and Union carries it.
  imm toStruct &<Rect = &r;   //~ ErrorInvType:16 "must be to a trait"
                             //~^ ErrorInvType:25 "does not match variable's declared type" follow-on

  // Blob satisfies nothing Shape requires, so no vtable can be built for it and
  // the reference does not coerce
  imm fromBlob &<Shape = &b;   //~ ErrorInvType:26 "does not match variable's declared type"

  // The same rejection at a call, where the parameter is what asks
  virtualArea(&b);   //~ ErrorInvType:15 "does not match declared parameter"

  // A virtual reference does not silently become a plain one again: the
  // concrete type has to be recovered by matching on it
  imm ok &<Shape = &r;
  imm back &Rect = ok;   //~ ErrorInvType:20 "does not match variable's declared type"

  // A parameter the requirement does not declare exactly is a parameter the
  // requirement is not satisfied by, however readily it would coerce at a call
  imm wrongType = WrongParmType[4];
  imm wrongRef = RefInsteadOfValue[5];
  imm tooMany = TooManyParms[6];
  virtualScaled(&wrongType);   //~ ErrorInvType:17 "does not match declared parameter"
  virtualScaled(&wrongRef);    //~ ErrorInvType:17 "does not match declared parameter"
  virtualScaled(&tooMany);     //~ ErrorInvType:17 "does not match declared parameter"

  // The trait is what is wrong, so the coercion's failure is a consequence of
  // it, and a second coercion to the same trait repeats the consequence without
  // repeating the complaint about the trait.
  imm boxy = Boxy[7];
  imm sized &<Sizer = &boxy;        //~ ErrorInvType:23 "does not match variable's declared type" follow-on
  imm sizedAgain &<Sizer = &boxy;   //~ ErrorInvType:28 "does not match variable's declared type" follow-on
  imm tallied &<Defaulter = &boxy;  //~ ErrorInvType:29 "does not match variable's declared type" follow-on

  // The private and static generic members leave Quiet's virtual reference alone
  imm quill = Quill[8];
  imm spanned &<Quiet = &quill;
}
