// A trait whose requirement takes 'Self' by value is met by the types that declare
// it, but cannot be reached through a virtual reference: a vtable slot has one
// signature, and a by-value 'Self' is the size of whichever type is behind it. A
// struct given as such a virtual reference is refused as it is for a requirement
// using 'Self' by reference ('&Self').

mod trait_typecheck_self_by_value;

trait Addable {
  pub fn plus(self: &, b: Self) Self;
}

struct V is Addable {
  pub n: i64;
  pub fn plus(self: &, b: V) V { V(n + b.n) }
}

fn viaRef(a: &<Addable) { }

fn main() i32 {
  var v = V(1);
  viaRef(&v);   //~ ErrorInvType:10 "does not match declared parameter"
  0
}
