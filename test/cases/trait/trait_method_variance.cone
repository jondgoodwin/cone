// A type's method meets a trait's method when its signature is a subtype of the
// trait's: each parameter may be a supertype of the trait's (contravariant), and
// the result a subtype of the trait's (covariant), where the difference is a
// recast with no run-time conversion -- the signature rule a function reference
// gets. Here: a parameter that asks for less permission than the trait gives
// (a '&P' for the trait's '&mut P'), a result that promises more ('&mut P' for
// '&P'), and a reference to a variant for a reference to its enum on either side;
// a type that declares the trait with 'is'; an enrichment, and a callable's '()'.
// Each is used as a generic's bound, through a virtual reference and through an
// owner; a candidate of exactly the
// trait's signature is the one that meets it when the name has a looser one too.
// trait_typecheck_method_variance holds the differences that need a conversion,
// refused.

mod trait_method_variance;

import stdio use *;

struct P {
  pub x i32;
}

enum Shape {
  struct Circle { pub r i32; }
  struct Square { pub s i32; }
}

trait Probe {
  pub fn look(self &, p &mut P) i32;
  pub fn pick(self &, p &mut P) &P;
  pub fn find(self &, n i32) &Shape;
  pub fn size(self &, s &Shape.Circle) i32;
}

// Every method differs from the trait's by a recast: a read-only parameter, a
// result with more permission, a reference to a variant for one to the enum, a
// reference to the enum for one to the variant
struct Loose {
  pub n i32;
  pub shape Shape.Circle;
  pub fn look(self &, p &P) i32 { p.x + n; }
  pub fn pick(self &, p &mut P) &mut P { p; }
  pub fn find(self &, k i32) &Shape.Circle { &shape; }
  pub fn size(self &, s &Shape) i32 { n + 1; }
}

// The same through a declaration: 'is' checks each method as a bound does
struct Declared is Probe {
  pub n i32;
  pub shape Shape.Circle;
  pub fn look(self &, p &P) i32 { p.x * n; }
  pub fn pick(self &, p &mut P) &mut P { p; }
  pub fn find(self &, k i32) &Shape.Circle { &shape; }
  pub fn size(self &, s &Shape) i32 { n + 2; }
}

// Two candidates for 'look': the trait's own signature meets the requirement, the
// looser one is a method like any other
struct Both {
  pub n i32;
  pub shape Shape;
  pub fn lookMut overload look(self &, p &mut P) i32 { p.x + 1000; }
  pub fn lookRead overload look(self &, p &P) i32 { p.x; }
  pub fn pick(self &, p &mut P) &P { p; }
  pub fn find(self &, k i32) &Shape { &shape; }
  pub fn size(self &, s &Shape.Circle) i32 { n; }
}

fn radius(s &Shape) i32 {
  match s {
    case let c &Shape.Circle {c.r;}
    case let q &Shape.Square {100 + q.s;}
  }
}

fn viaVirtual(g &<Probe, p &mut P) i32 {
  g.look(p) + g.pick(p).x + radius(g.find(4)) + g.size(&Shape.Circle(r: 1));
}

fn viaGeneric[T Probe](g &T, p &mut P) i32 {
  g.look(p) + g.pick(p).x + radius(g.find(4)) + g.size(&Shape.Circle(r: 1));
}

fn viaOwner(g Uni[Probe], p &mut P) i32 {
  g.look(p) + g.pick(p).x + radius(g.find(4)) + g.size(&Shape.Circle(r: 1));
}

// An enrichment of a concrete type, declaring the trait and meeting it by shape
struct Base {
  pub n i32;
}

trait Lens {
  pub fn look(self &, p &mut P) i32;
  pub fn pick(self &, p &mut P) &P;
}

struct Rich extends Base is Lens {
  pub fn look(self &, p &P) i32 { p.x + n; }
  pub fn pick(self &, p &mut P) &mut P { p; }
}

struct Rich2 extends Base {
  pub fn look(self &, p &P) i32 { p.x + n; }
  pub fn pick(self &, p &mut P) &mut P { p; }
}

fn lensVirtual(g &<Lens, p &mut P) i32 { g.look(p) + g.pick(p).x; }
fn lensGeneric[T Lens](g &T, p &mut P) i32 { g.look(p) + g.pick(p).x; }

// A callable whose '()' takes less than the signature gives
struct Adder {
  pub k i32;
  pub fn `()`(self &, p &P) i32 { p.x + k; }
}

fn runit(f &<fn(p &mut P) i32, p &mut P) i32 { f(p); }

fn main() {
  var pt = new P(3);
  let l = new Loose(10, Shape.Circle(14));
  let d = new Declared(2, Shape.Circle(8));
  let b = new Both(7, Shape.Square(9));

  print <- "loose = ", viaVirtual(&l, &mut pt), " ", viaGeneric(&l, &mut pt), "\n";
  print <- "declared = ", viaVirtual(&d, &mut pt), " ", viaGeneric(&d, &mut pt), "\n";
  print <- "both = ", viaVirtual(&b, &mut pt), "\n";
  let r = new Rich(10);
  let r2 = new Rich2(20);
  print <- "enriched = ", lensVirtual(&r, &mut pt), " ", lensGeneric(&r, &mut pt), " ", lensVirtual(&r2, &mut pt), " ", lensGeneric(&r2, &mut pt), "\n";
  let a = new Adder(5);
  print <- "callable = ", runit(&a, &mut pt), "\n";
  print <- "owned = ",viaOwner(new Uni[Loose](new Loose(1, Shape.Circle(5))), &mut pt), "\n";
}
