// A method of a trait or an enum, named through the trait or the enum.
//
// The abstraction's method is a template: each implementer or variant owns a
// clone of it, and the abstraction's own copy is never generated. A path that
// named it -- to call it with the receiver as the first argument, as a struct's
// own method is reached, or to borrow it -- compiled to a call of a null, and
// conec crashed in generation with no diagnostic. The same path through a
// struct, a variant or an implementer names that type's own copy and works, and
// a static function of the abstraction is reached exactly this way
// (trait-nameres-static, trait-success).

enum E {
  pub n i32;
  pub fn twice(self &) i32 {n * 2;}

  struct A {
    pub fn go(self &) i32 {E.twice(self);}   //~ ErrorAbstractMeth:30 "names a method of E"
    pub fn viaVariant(self &) i32 {A.twice(self);}
  }
}

trait T {
  fn get(self &) i32;
  pub fn twice(self &) i32 {Self.get(self) * 2;}   //~ ErrorAbstractMeth:34 "names a method of T"
  pub fn areaOf overload area(self &) i32 {1;}
  pub fn areaScaled overload area(self &, k i32) i32 {k;}
}

struct S is T {
  pub n i32;
  pub fn get(self &) i32 {n;}
  pub fn viaDefault(self &) i32 {T.twice(self);}      //~ ErrorAbstractMeth:36 "names a method of T"
  pub fn viaRequirement(self &) i32 {T.get(self);}    //~ ErrorAbstractMeth:40 "names a method of T"
  pub fn viaOverload(self &) i32 {T.area(self);}      //~ ErrorAbstractMeth:37 "names a method of T"
  pub fn viaImplementer(self &) i32 {S.twice(self);}
}

fn outside(e &E) i32 {
  E.twice(e);          //~ ErrorAbstractMeth:5 "names a method of E"
}

fn borrowed(e &E) i32 {
  imm f = &E.twice;    //~ ErrorAbstractMeth:14 "names a method of E"
  f(e);
}
