// What the parser refuses of an associated type: one fixed in a constraint by
// name, an equality constraint (Rust's 'Item = u8'), which is not built; and a
// bound with no trait after its ':'.
//
// Verdict: refuse, at the '=' and after the ':'. Basis: doc/manual/mod-substitution.html,
// "Associated types": the type meeting the trait says what its associated type is.

mod trait_parse_assoc;

trait Seq[T] {
  type Cursor: Iterator[T];
  pub fn iter(self: &) Cursor;
}

trait Bare {
  type Item: ;    //~ ErrorNoType "Expected a trait after ':'"
}

fn fixed[C: Seq[i64, Cursor = u8]](c: &C) i64 {   //~ ErrorAssocEquality:29 "'Cursor = ...' here is an equality constraint"
  0i64
}

fn main() {
}
