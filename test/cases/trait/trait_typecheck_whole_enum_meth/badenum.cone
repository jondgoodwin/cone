// Another module's error enum whose toText is written over the whole enum
// (trait_typecheck_whole_enum_meth.cone)

pub mod badenum;

import collections use *;

pub enum Bad is Error, Sendable {
  X, Y;
  pub fn toText(self: &Bad, out: &uni TextOut) { out <- "bad"; }
}

pub fn fails() Result[i32, Bad] {
  Err[i32, Bad](Bad.X)
}
