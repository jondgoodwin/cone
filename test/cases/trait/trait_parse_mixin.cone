mod trait_parse_mixin;

// 'mixin' is retired. What it took into a type is declared with 'is' on the
// declaration line -- the struct's or the trait's, the enum's, or the variant's
// -- where every abstraction a type complies with is named in one list.
//
// It stays a keyword so that it can be refused. Released to an identifier,
// 'mixin Named;' would read as a field named 'mixin' of type Named, and a body that
// took a trait in would quietly declare a field instead. Each statement is
// reported once, at the keyword, whatever follows it, and read through so that
// the body recovers.
//
// Parse stage: nothing is built for it, so nothing here is name resolved.

trait Named {
  pub fn label(self &) i32 {1;}
}

struct Plain {
  mixin Named;                //~ ErrorMixin:3 "declare conformance with 'is' on the declaration line"
  pub n i32;
}

trait Abstract {
  mixin Named;                //~ ErrorMixin:3 "'mixin' is retired"
}

enum Closed {
  mixin Named;                //~ ErrorMixin:3 "'mixin' is retired"
  struct Member {
    mixin Named;              //~ ErrorMixin:5 "'mixin' is retired"
    pub m i32;
  }
}

// A fold after it, which a mixin was once refused separately for, is read
// through as part of the one statement
struct Folding {
  mixin Named use label;      //~ ErrorMixin:3 "'mixin' is retired"
  pub f i32;
}
