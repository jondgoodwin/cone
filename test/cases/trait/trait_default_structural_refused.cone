// A trait's defaults come only to a type that declares 'is'. A type that complies
// structurally must declare every method itself, defaulted ones included, so it
// is refused where it is used as the trait through a virtual reference while it
// lacks a defaulted method. The same type with its own 'bonus' is accepted.

mod trait_default_structural_refused;

trait Greeter {
  pub fn id(self: &) i64;
  pub fn bonus(self: &) i64 {100i64}
}

struct Lacking {
  pub fn id(self: &) i64 {1i64}
}

struct Complete {
  pub fn id(self: &) i64 {2i64}
  pub fn bonus(self: &) i64 {200i64}
}

fn viaRef(g: &<Greeter) i64 {
  g.id() + g.bonus()
}

fn main() {
  var l = Lacking();
  var c = Complete();
  viaRef(&c);
  viaRef(&l);   //~ ErrorInvType:10 "Lacking does not declare `is Greeter`, so Greeter's default for `bonus` does not apply: declare `is Greeter` to take its defaults"
}
