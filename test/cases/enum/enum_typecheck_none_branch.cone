// A bare 'None' where an Option is expected names a type, not a value, and the
// value it was meant to give is written 'None[i32][]'. Each refusal below is
// reported where the 'None' is written; it was reported at "init:1:1" with no
// source line, because the block that ends in a type had nothing to point at.
// The branch of an 'if', the arm of a 'match' and a 'return' are the places it
// shows. (refoption.html writes a bare 'None' as an abbreviation of 'None[i32]'
// where the context says the type; the compiler does not build that yet.)

mod enum_typecheck_none_branch;

fn thenArm(cnt i32) Option[i32] {
  if cnt > 0 { None; } else { Some[cnt]; }                //~ ErrorInvType:16 "Expression does not match expected type"
}

fn elseArm(cnt i32) Option[i32] {
  if cnt > 0 { Some[cnt]; } else { None; }                //~ ErrorInvType:36 "Expression does not match expected type"
}

fn returned(cnt i32) Option[i32] {
  if cnt > 0 { Some[cnt]; } else { return None; }         //~ ErrorInvType:43 "Expression does not match expected type"
}

fn matched(cnt i32) Option[i32] {
  match cnt { case 0 { None; } else { Some[cnt]; } }      //~ ErrorInvType:24 "Expression does not match expected type"
}

// With the type written, the value is built
fn written(cnt i32) Option[i32] {
  if cnt > 0 { Some[cnt]; } else { None[i32][]; }
}

fn main() {}
