// A bare 'None' takes the Option it is wanted as from where it goes (a declared
// variable, a return, the branches of an 'if' and the arms of a 'match' that
// have one: generic_infer_expected). Where nothing says, it is refused where it
// is written, naming the type parameter, as the last statement of a block, the arm
// of a match and the branch of an 'if' that start a variable are. It was reported
// at "init:1:1" with no source line, because the block that ends in a type had
// nothing to point at.

mod enum_typecheck_none_branch;

fn blockEnd() {
  let a = { None };                                       //~ ErrorInvType:13 "Could not infer the type parameter T of None"
}

fn thenArm(cnt: i32) {
  let b = if cnt > 0 { None } else { Some(cnt) };        //~ ErrorInvType:24 "Could not infer the type parameter T of None"
}

fn matched(cnt: i32) {
  let c = match cnt { case 0 { None } else { Some(cnt) } };   //~ ErrorInvType:32 "Could not infer the type parameter T of None"
}

// With the type given, the value is built
fn given(cnt: i32) Option[i32] {
  if cnt > 0 { Some(cnt) } else { None }
}

fn written(cnt: i32) Option[i32] {
  if cnt > 0 { Some(cnt) } else { None[i32] }
}

fn main() {}
