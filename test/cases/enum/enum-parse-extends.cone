// What an enum that extends another may write in its declaration.
//
// An extension holds its own copies of its base's variants, and those copies were
// written against the base. So what it declares beside the variants it adds is
// what can be given to every variant of its set, copies included: a method with a
// body, cloned into each of them, and a static function or a static, which stay
// the extension's own. enum-extends runs those. What cannot be given to a copy --
// a requirement it has no body to meet, a field that would move what its methods
// read, a discriminant it was laid out with -- is refused here, where it is
// written, each with its reason.
//
// Parse stage only: each of these is refused where it is written, and a parse
// error stops the compile before name resolution, so nothing here reaches the
// refusals in enum-nameres-extends.
//
// Grammar the clause shares with the concrete enrichment -- 'extends' written
// twice, and 'extends' on a trait -- is in trait-parse-extends.

enum Colors {
  Red, Green, Blue;
}

// A requirement would be answered by every variant of the set, and the copies of
// the base's variants have no body of their own to implement it in
enum WithRequirement extends Colors {
  Magenta;
  pub fn describe(self &) i32;   //~ ErrorEnumExtends:7 "the method describe needs a body"
}

// A field is part of every variant's layout, the copies' included, and their
// methods read the fields where the base put them
enum WithField extends Colors {
  Cyan;
  pub extra i32;          //~ ErrorEnumExtends:7 "declares no common field: extra would change the layout"
}

// The discriminant is a field too, and the base's
enum WithTag extends Colors {
  Violet;
  _ tag;                  //~ ErrorEnumExtends:3 "takes its base's discriminant"
}

// A mixin would splice a trait's fields and requirements in, which is what a field
// and a requirement are
enum WithMixin extends Colors {
  Teal;
  mixin Marker;           //~ ErrorEnumExtends:3 "a mixin belongs on the enum it extends"
}

trait Marker {
  pub fn mark(self &) i32;
}

// The discriminant is the base's, shared with the variants taken from it, so the
// integer type its values are laid out in was settled there
enum Retagged u32 extends Colors {  //~ ErrorEnumExtends:15 "takes its base's discriminant"
  Ochre;
}

// An extension that adds no variant is a second name for its base's set rather
// than a wider one. Reported at the declaration's own name, because the body that
// should have held a variant has ended by then.
enum Nothing extends Colors {       //~ ErrorEnumExtends:6 "adds no variant"
}
