// A 'main' returning a Result that succeeds: the exit status is 0, and what its 'Ok'
// holds is dropped (fin7 below). It takes C's two arguments, which the function the
// entry calls in its stead passes on. The error here meets core's Error, which prints
// it when 'main' fails (enum_main_result prints one).

mod enum_main_result_ok;

import stdio use *;

struct Fin {
  pub id: i32;
  fn final(self: &uni) {
    printStr("fin");
    printInt(i64.from(self.id));
    printStr("\n");
  }
}

struct Plain is Error {
  pub code: i32;
  pub fn toText(self: &, out: &uni TextOut) { out <- "plain failure"; }
}

fn count(argc: i32) Result[i32, Plain] {
  if argc < 1 { Err(Plain(argc)) } else { Ok(argc) }
}

fn main(argc: i32, argv: **u8) Result[Fin, Plain] {
  let n = count(argc)?;
  printStr("arguments counted\n");
  Ok(Fin(7))
}
