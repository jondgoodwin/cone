// The enum is the privacy boundary for its variants. Code written anywhere
// inside an enum's braces -- its own methods, cloned into every variant, its
// static functions, and every variant's own methods -- reads and writes the
// private fields of every variant and of the enum, and calls their private
// methods, through any value and not only through 'self'. An enum that extends
// another sees what its base's code sees, and its copies of the base's variants
// are its own. From outside the enum they stay private: enum-typecheck-privacy
// holds those refusals, a struct's among them.
//
// Every value is printed, and each is worked out beside its line below, so a
// member read from the wrong variant or the wrong value shows as a wrong number.

import stdio use *;

fn show(label &[]u8, n i32) {
  printStr(label);
  printStr(" = ");
  printInt(i64[n]);
  printStr("\n");
}

// -------- one enum, every kind of code inside it --------

// 'secret' is the enum's own private field, spliced into both variants; 'lo' and
// 'hi' are each one variant's, and 'half' and 'twice' each one variant's private
// method. Nothing here is 'pub' but what the code outside calls. 'secret' has a
// default only so that the extension below can be built from outside, where
// its private fields take their defaults.
enum Gauge {
  pub id i32;
  secret i32 = 9;

  // A method of the enum: each variant has its own clone, and every clone reads
  // another value's privates, the other variant's included
  pub fn probe(self &, other &Gauge) i32 {
    match other {
      case imm l &Low {l.lo + other.secret;}
      case imm h &High {h.hi + h.twice() + other.secret;}
    }
  }

  struct Low {
    lo i32;
    fn half(self &) i32 {lo / 2;}
    // A variant's method reads its sibling's private field and calls its
    // sibling's private method
    pub fn peekHigh(self &, h &High) i32 {h.hi * 100 + h.twice();}
  }

  struct High {
    hi i32;
    fn twice(self &) i32 {hi * 2;}
    // ... and writes one
    pub fn lower(self &, l &mut Low) {l.lo = l.lo + hi;}
  }

  // A static function reads a variant's private field and calls its private
  // method through a match on the enum
  pub fn reading(g &Gauge) i32 {
    match g {
      case imm l &Low {l.lo * 10 + l.half();}
      case imm h &High {h.hi * 10 + h.twice();}
    }
  }

  // ... writes one through a match
  pub fn raise(g &mut Gauge) {
    match g {
      case mut l &mut Low {l.lo = l.lo + 1;}
      case mut h &mut High {h.hi = h.hi + 1;}
    }
  }

  // ... and builds a variant, giving the private fields their values
  pub fn low(id i32, v i32) Low {Low[id, 7, v];}
  pub fn high(id i32, v i32) High {High[id, 5, v];}
}

fn oneEnum() {
  mut a = Gauge.low(1, 10);       // secret 7, lo 10
  imm b = Gauge.high(2, 3);       // secret 5, hi 3
  imm ga Gauge = a;
  imm gb Gauge = b;
  show("static-reads-variant-private", Gauge.reading(&ga));    // 10*10 + 10/2 = 105
  show("static-calls-variant-private", Gauge.reading(&gb));    // 3*10 + 3*2 = 36
  show("enum-method-on-low-reads-high", (&a).probe(&gb));      // 3 + 6 + 5 = 14
  show("enum-method-on-high-reads-low", (&b).probe(&ga));      // 10 + 7 = 17
  show("variant-reads-sibling-private", (&a).peekHigh(&b));    // 3*100 + 6 = 306
  (&b).lower(&mut a);                                          // lo 10 + 3 = 13
  mut gm Gauge = a;
  Gauge.raise(&mut gm);                                        // lo 13 + 1 = 14
  show("variant-and-static-write-private", Gauge.reading(&gm)); // 14*10 + 14/2 = 147
}

// -------- an extension, its copies and its base's variants --------

// Rich holds copies of Gauge's Low and High, then Mid, its own. Mid's methods
// build the copies, giving their private fields values, and read the private
// members of a copy, of Gauge's own Low, and of the enum spliced into each. The
// extension's own code reaches the same privates: 'peer', cloned into each copy
// and into Mid, reads a base variant's private field and method and its own
// value's private field bare, and the static function 'peek' reads a copy's
// private field through a match.
enum Rich extends Gauge {
  pub fn peer(self &, base &Gauge.Low) i32 {base.lo * 100 + base.half() * 10 + secret + peek(self);}
  fn peek(r &Rich) i32 {
    match r {
      case imm l &Low {l.lo * 1000;}
      else {0;}
    }
  }

  struct Mid {
    mid i32 = 8;
    pub fn copyLow(self &, v i32) Rich.Low {Rich.Low[1, 2, v];}
    pub fn copyHigh(self &, v i32) Rich.High {Rich.High[1, 3, v];}
    pub fn sum(self &, copy &Rich.Low, base &Gauge.Low) i32 {
      copy.lo * 100 + base.lo * 10 + copy.half() + base.secret;
    }
    pub fn fromRich(self &, r &Rich) i32 {
      match r {
        case imm l &Low {l.lo + l.secret;}
        case imm h &High {h.hi + h.twice() + h.secret;}
        case imm m &Mid {m.mid + m.secret;}
      }
    }
  }
}

fn extension() {
  imm mid = Rich.Mid[1];                // secret 9 and mid 8, by default
  imm copy = (&mid).copyLow(4);         // secret 2, lo 4
  imm high = (&mid).copyHigh(6);        // secret 3, hi 6
  imm base = Gauge.low(1, 3);           // secret 7, lo 3
  show("extension-reads-copy-and-base-private", (&mid).sum(&copy, &base)); // 400 + 30 + 2 + 7 = 439
  imm rl Rich = copy;
  imm rh Rich = high;
  imm rm Rich = mid;
  show("extension-matches-copy-low", (&mid).fromRich(&rl));   // 4 + 2 = 6
  show("extension-matches-copy-high", (&mid).fromRich(&rh));  // 6 + 12 + 3 = 21
  show("extension-matches-own-variant", (&mid).fromRich(&rm)); // 8 + 9 = 17
  // The copy's clone of Gauge's 'probe' is the extension's code, and reads
  // the private members of a value of the base
  imm gh Gauge = Gauge.high(3, 4);      // secret 5, hi 4
  show("copied-method-reads-base-private", (&copy).probe(&gh)); // 4 + 8 + 5 = 17
  show("extension-own-code-reads-copy-and-base-private", (&copy).peer(&base)); // 300 + 1*10 + 2 + 4*1000 = 4312
}

// -------- a generic enum --------

// Each instance's code sees the privates of that instance's variants, as a
// plain enum's does. An Empty is built from outside with 'count' at its default;
// Empty's own method builds the Fulls, giving their private fields values. Each
// match ends in 'else': inside a generic enum's code, arms for every variant are
// not yet counted as exhaustive.
enum Stash[T] {
  count i32 = 6;

  pub fn tally(self &, other &Stash[T]) i32 {
    match other {
      case imm f &Full[T] {f.count + f.size();}
      else {other.count;}
    }
  }

  struct Full {
    item T;
    fn size(self &) i32 {10;}
    pub fn swapFrom(self &mut, other &Full[T]) {item = other.item;}
  }

  struct Empty {
    pub fn fill(self &, c i32, v T) Full[T] {Full[T][c, v];}
    pub fn peek(self &, f &Full[T], d T) T {f.item + d;}
    pub fn itemOf(self &, s &Stash[T]) T {
      match s {
        case imm f &Full[T] {f.item;}
        else {T[countOf(s)];}
      }
    }
  }

  // A static function reads the enum's private field through a value
  fn countOf(s &Stash[T]) i32 {s.count;}
}

fn generic() {
  imm empty = Stash.Empty[i64][];        // count 6, by default
  mut full = (&empty).fill(3, 40);       // count 3, item 40
  imm other = (&empty).fill(4, 50);      // count 4, item 50
  imm sf Stash[i64] = full;
  imm se Stash[i64] = empty;
  show("generic-variant-matches-sibling-private", i32[(&empty).itemOf(&sf)]);  // 40
  show("generic-static-reads-enum-private", i32[(&empty).itemOf(&se)]);        // 6
  show("generic-variant-reads-sibling-private", i32[(&empty).peek(&full, 2)]); // 40 + 2 = 42
  show("generic-enum-method-reads-private", (&empty).tally(&sf));              // 3 + 10 = 13
  show("generic-enum-method-reads-enum-private", (&full).tally(&se));          // 6
  (&mut full).swapFrom(&other);
  imm sw Stash[i64] = full;
  show("generic-variant-writes-other-private", i32[(&empty).itemOf(&sw)]);     // 50
}

fn main() i32 {
  oneEnum();
  extension();
  generic();
  0i32;
}
