// The matchee's form decides what a match takes [topic 2], and a pattern names only
// the variant [topic 6a, 6b].
//
// 'match r' on a place is a match on the value: each test reads the tag where it
// is and takes nothing, so a match that only tests moves nothing out of 'r'; the
// arm that binds takes its payload by value, a copy of a copy type and a move of
// one that owns, and finalizes what it took as the arm ends. 'match &r' (or
// '&mut r') binds a reference of that kind into 'r'. 'match f()' is a temporary
// the match owns, finalized as the match ends. A match with a bound 'if' guard
// holds the value it matches, as before, since the guard reads the binding before
// the arm is chosen.
//
// The finalizer prints its number, so the output is the whole assertion: what is
// finalized, and when. The expected lines are worked out by hand in the comments.

mod enum_match_form;

import stdio use *;

struct Fin {
  pub id i32;
  fn final(self &uni) {
    printStr("fin");
    printInt(i64.from(id));
    printStr(" ");
  }
}

enum E {
  struct A { pub f Fin; }
  struct B { pub n i32; }
}
use E;

// A copy enum: matching it copies what a binding takes
enum Shape {
  struct Circle { pub radius i32; }
  struct Rect { pub w i32; pub h i32; }
  struct Dot {}
}

fn mkE() E { A(new Fin(9)); }
fn show(label &str) {
  printStr(label);
  printStr(": ");
}
fn end() {
  printStr("|\n");
}
fn num(n i32) {
  printInt(i64.from(n));
  printStr(" ");
}

// -------- a test takes nothing --------

// The matches only test, so 'e' is whole after each and used by the next: fin1 comes
// at the function's end, after "end ", and not when the first match ends
fn testsTakeNothing() {
  imm e E = A(new Fin(1));
  match e {
    case is A { printStr("A "); }
    else { printStr("else "); }
  }
  match e {
    case is B { printStr("B "); }
    else { printStr("not-B "); }
  }
  if e is A { printStr("is "); }
  printStr("end ");
}

// An arm that does not bind leaves 'e' too, and the arm that does is the one that
// takes it: after the match, 'e' is whole on the paths of the arms that tested only
fn unboundArm() {
  imm e E = B(2);
  match e {
    case is A { printStr("A "); }
    else {
      match e {
        case imm b B { num(b.n); }
        else { printStr("else "); }
      }
    }
  }
  printStr("end ");
}

// -------- a binding takes --------

// The binding is the matched value's contents moved into the arm: finalized as the
// arm ends, before "end "
fn bindingTakes() {
  imm e E = A(new Fin(3));
  match e {
    case imm a A { printStr("took "); }
    else { printStr("else "); }
  }
  printStr("end ");
}

// A bound 'if' reads the same: its 'else' still has the value
fn boundIfElse() {
  imm e E = B(5);
  if imm a A = e { printStr("then "); }
  else {
    printStr("else ");
    match e {
      case imm b B { num(b.n); }
      else { printStr("other "); }
    }
  }
  printStr("end ");
}

// The payload of an Option or a Result moves out of the matched value the same way:
// the Some arm takes it, the None arm leaves the Option whole
fn optionTakes(o Option[Fin]) {
  match o {
    case is None { printStr("none "); }
    else { printStr("some "); }
  }
  match o {
    case imm f Some { printStr("took "); }
    case is None { printStr("none "); }
  }
  printStr("end ");
}

// -------- a copy is value semantics --------

// 'mut' changes the copy the arm took, never 'r'
fn copyChanges() {
  imm r Result[i32, i32] = Ok[i32, i32](5);
  match r {
    case mut v Ok { v = v + 1; num(v); }
    case imm e Error { printStr("err "); }
  }
  match r {
    case imm v Ok { num(v); }
    case imm e Error { printStr("err "); }
  }
}
fn shapeChanges() {
  imm s Shape = Shape.Circle(2);
  match s {
    case mut c Circle { c.radius = 9; num(c.radius); }
    else { printStr("else "); }
  }
  match s {
    case imm c Circle { num(c.radius); }
    else { printStr("else "); }
  }
}

// -------- a borrow binds a reference into the value --------

// '&mut' is how to change it
fn borrowChanges() {
  mut s Shape = Shape.Circle(2);
  match &mut s {
    case mut c Circle { c.radius = 9; }
    else { printStr("else "); }
  }
  match &s {
    case imm c Circle { num(c.radius); }
    else { printStr("else "); }
  }
}

// A borrow of an owner takes nothing either, and a binding is a reference
fn borrowTakesNothing() {
  imm e E = A(new Fin(6));
  match &e {
    case imm a A { printStr("A "); num(a.f.id); }
    else { printStr("else "); }
  }
  printStr("end ");
}

// -------- a call is a temporary the match owns --------

fn temporary() {
  match mkE() {
    case imm a A { printStr("A "); }
    else { printStr("else "); }
  }
  printStr("end ");
}

// -------- a guard holds the matched value --------

fn guarded(b bool) {
  imm e E = A(new Fin(7));
  match e {
    case imm a A if b { printStr("guarded "); }
    case imm a A { printStr("unguarded "); }
    else { printStr("else "); }
  }
  printStr("end ");
}

// -------- a pattern names only the variant --------

fn area(s &imm Shape) i32 {
  match s {
    case imm c Circle { c.radius * c.radius; }
    case imm r Rect { r.w * r.h; }
    else { 0; }
  }
}
fn isCircle(s &imm Shape) i32 {
  match s {
    case Circle { 1; }
    else { 0; }
  }
}
fn qualified(s &imm Shape) i32 {
  match s {
    case Shape.Circle { 1; }
    case Shape.Rect or Shape.Dot { 2; }
    else { 0; }
  }
}
fn qualifiedBind(s &imm Shape) i32 {
  match s {
    case imm c Shape.Circle { c.radius; }
    else { 0; }
  }
}
fn assertion(s &imm Shape) i32 {
  match s {
    case imm c &Circle { c.radius; }
    else { 0; }
  }
}
fn viaIf(s &imm Shape) i32 {
  if imm c Circle = s { c.radius; } else { 0; }
}
fn viaIs(s &imm Shape) i32 {
  if s is Rect { 1; } else { 0; }
}
fn owned(s Rc[imm, Shape]) i32 {
  match s {
    case imm c Circle { 1; }
    case imm r Rect { 2; }
    else { 0; }
  }
}
fn byValue(s Shape) i32 {
  match s {
    case imm c Circle { c.radius; }
    case imm r Rect { r.h; }
    else { 0; }
  }
}

// -------- a place is read where it stands, and a match on it can be exhaustive --------

struct Holder {
  pub s Shape;
  pub k i32;
}
fn viaField(h &imm Holder) i32 {
  match h.s {
    case imm c Circle { c.radius; }
    case imm r Rect { r.w; }
    case imm d Dot { 0; }
  }
}
fn viaDeref(p &imm Shape) i32 {
  match *p {
    case imm c Circle { c.radius; }
    case imm r Rect { r.w; }
    case imm d Dot { 0; }
  }
}
fn viaTest(h &imm Holder) i32 {
  match h.k {
    case 0 .. 3 { 1; }
    case >3 { 2; }
    else { 3; }
  }
}

fn main() i32 {
  show("tests"); testsTakeNothing(); end();
  show("unbound"); unboundArm(); end();
  show("binding"); bindingTakes(); end();
  show("bound-if-else"); boundIfElse(); end();
  show("option-some"); optionTakes(Some[Fin](new Fin(8))); end();
  show("option-none"); optionTakes(None); end();
  show("copy-r"); copyChanges(); end();
  show("copy-s"); shapeChanges(); end();
  show("borrow"); borrowChanges(); end();
  show("borrow-owner"); borrowTakesNothing(); end();
  show("temporary"); temporary(); end();
  show("guard-true"); guarded(true); end();
  show("guard-false"); guarded(false); end();
  imm c Shape = Shape.Circle(3);
  imm r Shape = Shape.Rect(2, 5);
  imm d Shape = Shape.Dot;
  show("variant-only");
  num(area(&imm c)); num(area(&imm r)); num(area(&imm d));
  num(isCircle(&imm c)); num(isCircle(&imm r));
  num(qualified(&imm c)); num(qualified(&imm r)); num(qualified(&imm d));
  num(qualifiedBind(&imm c)); num(assertion(&imm c)); num(assertion(&imm r));
  num(viaIf(&imm c)); num(viaIs(&imm c)); num(viaIs(&imm r));
  num(owned(new Rc[imm, Shape](Shape.Rect(1, 1)))); num(byValue(r));
  end();
  imm h1 = new Holder(r, 4);
  imm h2 = new Holder(c, 2);
  imm h3 = new Holder(d, 3);
  show("place");
  num(viaField(&imm h1)); num(viaField(&imm h2)); num(viaField(&imm h3));
  num(viaDeref(&imm c)); num(viaDeref(&imm d));
  num(viaTest(&imm h1)); num(viaTest(&imm h2)); num(viaTest(&imm h3));
  end();
  0i32;
}
