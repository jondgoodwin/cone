// What a match must satisfy: every variant accounted for, statement or value, the
// catch-all last, and one type across the arms. What it must cover and what it may not
// repeat is enum_typecheck_match_cover.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. What a pattern may narrow to is in
// enum_typecheck_narrow; how an enum relates to its variants as a type is in
// enum_typecheck_variant.
//
// 'match' is sugar for an 'if' chain, which is why some of these diagnostics say
// 'if' and 'else' where the source says 'match' and 'case'.

mod enum_typecheck_match;

enum Shape {
  kind i32;

  struct Circle {
    pub radius i32;
  }

  struct Rect {
    w i32;
    h i32;
  }
}
use Shape;

// A match naming some but not all variants cannot produce a value, because the
// unnamed variants reach no arm
fn notExhaustive(s &imm Shape) i32 {
  match s {              //~ ErrorMatchNotExhaustive:3 "does not cover Rect"
                         //~^ ErrorInvType:3 "Expression does not match expected type" follow-on
    case let c &Circle {c.radius}
  }
}

// An 'else' matches everything, so any arm after it is unreachable
fn elseNotLast(s &imm Shape) i32 {
  match s {
    else {0}             //~ ErrorInvType:10 "match on everything should be last"
    case let c &Circle {c.radius}
  }
}

// Every arm supplies the value, so every arm has to supply the same type
fn armTypesDiffer(s &imm Shape) i32 {
  match s {
    case let c &Circle {c.radius}
    case let r &Rect {1.5}    //~ ErrorInvType:23 "Expression does not match expected type"
  }
}

// A 'case ==' arm compares the matched value against another value of its type.
// An enum's comparison takes the enum, so an integer literal is not a value it
// has a candidate for -- which variant a value holds is what 'case is' and a
// bound pattern are for.
fn equalityAgainstANumber(s Shape) i32 {
  match s {
    case ==1 {1}         //~ ErrorNoCandidate:10 "No method declared by `==` accepts the call's arguments"
    else {0}
  }
}

// An enum compares for equivalence by its discriminant, which is the whole of the
// value only where every variant is empty. Here the variants carry fields, so the
// comparison is the tags and then the variant's own '==', and neither Circle nor
// Rect declares one. enum_success compares the payload-free form, where '==' is
// exactly the tag, and enum_payload_equality the form whose variants declare '=='.
fn equalityOnPayloadEnum(a Shape, b Shape) bool {
  a == b                 //~ ErrorEnumEquality:5 "Circle carries a payload (kind i32, radius i32) and declares none"
}

// A guard is a condition like an 'if''s, so it has to be one. A bound pattern's
// guard is the last statement of the block that binds its variable, and is
// reported as that block's value.
fn guardNotACondition(s Shape, other Shape) i32 {
  match s {
    case let c Circle if other {c.radius}   //~ ErrorInvType:26 "Expression does not match expected type"
    else {0}
  }
}

// A guarded arm may fail, so it does not account for its variant, and the arm
// that would have made this match exhaustive leaves None unmatched
fn guardedArmNotExhaustive(o Option[i32]) i32 {
  match o {              //~ ErrorMatchNotExhaustive:3 "does not cover None"
                         //~^ ErrorInvType:3 "Expression does not match expected type" follow-on
    case let s Some {s}
    case is None if true {0}
  }
}

// A range compares the matched value with both bounds, so the value has to be
// ordered, and an enum is not: each end reports, at the '..'
fn rangeOnAnEnum(s Shape) i32 {
  match s {
    case 1 ..< 3 {1}      //~ ErrorNoMbr:12 "Method or field `>=` not found"
                         //~^ ErrorInvType:12 "Conditional expression must be coercible" follow-on
                         //~^^ ErrorNoMbr:12 "Method or field `<` not found"
                         //~^^^ ErrorInvType:12 "Conditional expression must be coercible" follow-on
    else {0}
  }
}

// A bool's two values are counted when they are written, 'true' and 'false'; a
// value alone that is anything else is compared with '==' and accounts for neither
fn boolValueNotCounted(b bool, k bool) i32 {
  match b {              //~ ErrorMatchNotExhaustive:3 "does not cover false"
                         //~^ ErrorInvType:3 "Expression does not match expected type" follow-on
    case true {1}
    case k {2}
  }
}

// A value alone is the '==' it means: against a number, an enum has no candidate,
// as 'case ==1' above has none, and a slice compared with a slice is refused as
// '==' on two slices is where their elements have no '==' to compare with
fn valueAloneIsEquality(s Shape, t &Array[Shape], u &Array[Shape]) i32 {
  match s {
    case 1 {1;}           //~ ErrorNoCandidate:10 "No method declared by `==` accepts the call's arguments"
    else {0;}
  }
  match t {
    case u {1}           //~ ErrorRefNoCompare:10 "Shape is an enum whose variant Circle carries fields and declares no `==`"
    else {0}
  }
}