// A pattern a function runs: 'case imm rest using prefix("GET ")' binds what the function gives
// back, 'case using isOdd()' tests with it [match: topic 8a]. The function is an ordinary one
// whose first parameter is the matched value (a method's comes after 'self'), returning an
// Option, whose payload is bound, or a bool, which only tests. The cases are tried top to bottom
// and a function is called at most once for the case that reaches it, so the counters below
// (a method of a struct counts its own calls) say exactly which calls were made. The same
// patterns bind in an 'if', an 'elif' and a let-else, spelled with the matched value after '='.
//
// Everything is printed, so the output is the whole assertion. The expected lines are worked
// out by hand in the comments.

mod enum_match_using;

import stdio use *;

fn prefix(s: &str, p: &str) Option[&str] {
  if s.startsWith(p) { Some(&s[p.len ..]) } else { None[&str] }
}
fn isOdd(n: i32) bool { n % 2 == 1 }
fn inRange(n: i32, lo: i32, hi: i32) bool { n >= lo && n <= hi }
fn half(n: i32) Option[i32] { if n % 2 == 0 { Some(n / 2) } else { None[i32] } }

// A pattern with a state of its own: a method, which counts the calls made on it
struct Pair { pub left: i32; pub right: i32; }
struct Probe {
  pub calls: i32;
  pub fn atLeast(self: &mut, n: i32, floor: i32) bool { self.calls = self.calls + 1; n >= floor }
  pub fn word(self: &mut, s: &str) Option[&str] { self.calls = self.calls + 1; prefix(s, "w:") }
  pub fn next(self: &mut) i32 { self.calls = self.calls + 1; self.calls * 10 }
}

// A pattern that binds a value that owns something, finalized when the arm that took it ends
struct Noisy {
  pub id: i32;
  fn final(self: &uni) { printStr("F"); printInt(self.id); printStr(" "); }
}
fn make(n: i32) Option[Noisy] { if n > 0 { Some(new Noisy(n)) } else { None[Noisy] } }
fn twice(n: i32) Option[Noisy] { if n > 1 { Some(new Noisy(n * 10)) } else { None[Noisy] } }

// ---- a prefix pattern binds the rest ----
fn route(line: &str) i32 {
  match line {
    case let path using prefix("GET ") { printStr("get "); printStr(path); printStr("\n"); 1 }
    case let path using prefix("PUT ") { printStr("put "); printStr(path); printStr("\n"); 2 }
    case "HEAD" { printStr("head\n"); 3 }
    else { printStr("other\n"); 0 }
  }
}

// ---- tests, among cases of other kinds, tried in order ----
fn kind(n: i32) i32 {
  match n {
    case 0 { 100 }
    case 1 { 101 }
    case using isOdd() { 1 }             // 1 is the case above: 101
    case 4 { 104 }                        // the case after a test is still reached
    case using inRange(10, 20) { 2 }
    else { 3 }
  }
}

// ---- a method pattern: each test is one call, made only when its case is reached ----
fn graded(n: i32, p: &mut Probe) i32 {
  match n {
    case using p.atLeast(90) { 4 }
    case using p.atLeast(80) { 3 }
    case using p.atLeast(70) { 2 }
    else { 1 }
  }
}
fn words(s: &str, p: &mut Probe) i32 {
  match s {
    case let w using p.word() { i32.from(w.len) }
    case "none" { -1 }
    else { -2 }
  }
}

// ---- the same patterns in an 'if', an 'elif' and a let-else ----
fn describe(line: &str) i32 {
  if let rest using prefix("GET ") = line { return i32.from(rest.len); }
  elif let other using prefix("DEL ") = line { return 500 + i32.from(other.len); }
  let path using prefix("PUT ") = line else { return -1; };
  1000 + i32.from(path.len)
}

// ---- a guard, and tests joined by '|' ----
fn bucket(n: i32) i32 {
  match n {
    case let h using half() if h > 10 { 1000 + h }
    case let h using half() { h }
    case using isOdd() if n > 100 { 7 }
    case using inRange(1, 3) | using inRange(50, 60) { 8 }
    else { 9 }
  }
}

// ---- the matched value is a call: made once, then every test reads it ----
fn heldOnce(p: &mut Probe) i32 {
  let v = match p.next() {
    case using isOdd() { 1 }
    case using inRange(5, 15) { 2 }
    else { 3 }
  };
  v * 100 + p.calls
}

// ---- a bound value that owns something is finalized as its arm ends ----
fn owned(n: i32) i32 {
  let r = match n {
    case let b using twice() { printStr("twice "); b.id }
    case let c using make() { printStr("once "); c.id }
    else { printStr("none "); 0 }
  };
  printStr("end\n");
  r
}

// ---- several results: a tuple read by position, a struct by field name ----
fn splitAt(s: &str, sep: u8) Option[(usize, usize)] {
  var i = 0usize;
  while i < s.len { if s[i] == sep { return Some((i, s.len - i - 1usize)); } i = i + 1; }
  None[(usize, usize)]
}
fn mul(n: i32) Option[Pair] { if n > 0 { Some(new Pair(n, n * 2)) } else { None[Pair] } }
fn parts(s: &str) i32 {
  match s {
    case let f using splitAt(':') { i32.from(f.0) * 10 + i32.from(f.1) }
    else { -1 }
  }
}
fn product(n: i32) i32 {
  match n {
    case let m using mul() { m.left * m.right }
    else { 0 }
  }
}

// ---- a column of 'match a, b' is tested with a function and binds nothing ----
fn columns(a: i32, b: i32) i32 {
  match a, b {
    case using isOdd(), 0 { 1 }
    case 2, using isOdd() { 2 }
    else { 0 }
  }
}

fn main() i32 {
  let g = route("GET /a");        // get /a
  printInt(g); printStr("\n");    // 1
  let p = route("PUT /bc");       // put /bc
  printInt(p); printStr("\n");    // 2
  printInt(route("HEAD")); printStr("\n");   // head, then 3
  printInt(route("x")); printStr("\n");      // other, then 0

  // 0 and 1 are their own cases; 7 and 15 are odd; 4 is its case; 12 is in 10 .. 20; 30 is none
  printInt(kind(0)); printStr(" "); printInt(kind(1)); printStr(" "); printInt(kind(7)); printStr(" ");
  printInt(kind(4)); printStr(" "); printInt(kind(12)); printStr(" "); printInt(kind(30)); printStr(" ");
  printInt(kind(15)); printStr("\n");      // 100 101 1 104 2 3 1

  // 95 asks one test, 85 two, 75 three, 10 three: the calls add up to 1, 3, 6, 9
  var probe = new Probe(0);
  printInt(graded(95, &mut probe)); printStr(" "); printInt(probe.calls); printStr("\n");   // 4 1
  printInt(graded(85, &mut probe)); printStr(" "); printInt(probe.calls); printStr("\n");   // 3 3
  printInt(graded(75, &mut probe)); printStr(" "); printInt(probe.calls); printStr("\n");   // 2 6
  printInt(graded(10, &mut probe)); printStr(" "); printInt(probe.calls); printStr("\n");   // 1 9

  // "w:abc" is one call and binds "abc"; "none" asks the pattern first (a call), then its own case
  var probe2 = new Probe(0);
  printInt(words("w:abc", &mut probe2)); printStr(" "); printInt(probe2.calls); printStr("\n");  // 3 1
  printInt(words("none", &mut probe2)); printStr(" "); printInt(probe2.calls); printStr("\n");   // -1 2
  printInt(words("zz", &mut probe2)); printStr(" "); printInt(probe2.calls); printStr("\n");     // -2 3

  printInt(describe("GET /abc")); printStr(" ");   // 4
  printInt(describe("DEL 12")); printStr(" ");     // 502
  printInt(describe("PUT 12")); printStr(" ");     // 1002
  printInt(describe("zz")); printStr("\n");        // -1

  // 40: half 20 > 10 is 1020; 8: half 4; 0: half 0; 101: odd, past 100; 3 and 53: in a range; 7: none
  printInt(bucket(40)); printStr(" "); printInt(bucket(8)); printStr(" "); printInt(bucket(0)); printStr(" ");
  printInt(bucket(101)); printStr(" "); printInt(bucket(3)); printStr(" "); printInt(bucket(53)); printStr(" ");
  printInt(bucket(7)); printStr("\n");    // 1020 4 0 7 8 8 9

  // p.next() is called once: 10, which is even and in 5 .. 15, so 2; then calls is 1: 201
  var probe3 = new Probe(0);
  printInt(heldOnce(&mut probe3)); printStr("\n");   // 201

  // 5: twice gives 50, finalized before "end"; 1: twice gives none, make gives 1; 0: neither
  printInt(owned(5)); printStr("\n");   // twice F50 end, then 50
  printInt(owned(1)); printStr("\n");   // once F1 end, then 1
  printInt(owned(0)); printStr("\n");   // none end, then 0

  // "ab:cde" splits at 2 with 3 after: 23; 5 gives left 5 and right 10: 50; -4 gives none: 0
  printInt(parts("ab:cde")); printStr(" "); printInt(parts("abc")); printStr(" ");
  printInt(product(5)); printStr(" "); printInt(product(-4)); printStr("\n");   // 23 -1 50 0

  // (3, 0): odd, zero: 1; (2, 5): two, odd: 2; (2, 4): neither: 0
  printInt(columns(3, 0)); printInt(columns(2, 5)); printInt(columns(2, 4)); printStr("\n");   // 120
  0i32
}
