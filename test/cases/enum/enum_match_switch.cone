// A match on one integer, character or enum tag is an LLVM 'switch' [match: jump tables].
// The leading cases that test the value against constants, ranges and variants are the
// switch's labels; the rest of the cases (a guard, a range too wide to spell out, the
// 'else') are the chain that is its default, tried in order as every match's are. This
// test runs in a release and a debug build (the checks in cases.toml pin the 'switch'
// in the code generated before LLVM's passes), and asserts what each case yields.
//
// Everything is printed, so the output is the whole assertion. The expected lines are
// worked out by hand in the comments.

mod enum_match_switch;

import stdio use *;

const K i32 = 7;

enum Lamp {
  Red;
  Green;
  Blink(i32);
  struct Both { pub a i32; pub b i32; }
}
use Lamp;

trait Measured {
  pub fn size(self &) i32;
}

enum Shape {
  struct Circle is Measured { pub r i32; pub fn size(self &) i32 {r * 10;} }
  struct Square is Measured { pub s i32; pub fn size(self &) i32 {s * 100;} }
  struct Third { pub t i32; }
  struct Fourth { pub u i32; }
}

// Tag values pinned apart, wider than a byte
enum Sparse {
  struct Lo = 5 {}
  struct Mid = 1000 {}
  struct Hi = 70000 {}
}

struct Cell {
  pub kind i32;
}

fn show(label &str) {
  printStr(label);
  printStr(": ");
}
fn end() {
  printStr("|\n");
}
fn num(n i32) {
  printInt(i64.from(n));
  printStr(" ");
}

// -------- a character tokenizer: sixty cases, each its own character --------

// 'a' to 'z' are 1 to 26, '0' to '9' are 27 to 36, and the twenty-four marks after are 37 to 60
fn tok(c char) i32 {
  match c {
    case 'a' { 1; }
    case 'b' { 2; }
    case 'c' { 3; }
    case 'd' { 4; }
    case 'e' { 5; }
    case 'f' { 6; }
    case 'g' { 7; }
    case 'h' { 8; }
    case 'i' { 9; }
    case 'j' { 10; }
    case 'k' { 11; }
    case 'l' { 12; }
    case 'm' { 13; }
    case 'n' { 14; }
    case 'o' { 15; }
    case 'p' { 16; }
    case 'q' { 17; }
    case 'r' { 18; }
    case 's' { 19; }
    case 't' { 20; }
    case 'u' { 21; }
    case 'v' { 22; }
    case 'w' { 23; }
    case 'x' { 24; }
    case 'y' { 25; }
    case 'z' { 26; }
    case '0' { 27; }
    case '1' { 28; }
    case '2' { 29; }
    case '3' { 30; }
    case '4' { 31; }
    case '5' { 32; }
    case '6' { 33; }
    case '7' { 34; }
    case '8' { 35; }
    case '9' { 36; }
    case '+' { 37; }
    case '-' { 38; }
    case '*' { 39; }
    case '/' { 40; }
    case '%' { 41; }
    case '=' { 42; }
    case '<' { 43; }
    case '>' { 44; }
    case '!' { 45; }
    case '&' { 46; }
    case '|' { 47; }
    case '^' { 48; }
    case '~' { 49; }
    case '(' { 50; }
    case ')' { 51; }
    case '[' { 52; }
    case ']' { 53; }
    case '{' { 54; }
    case '}' { 55; }
    case ',' { 56; }
    case ';' { 57; }
    case ':' { 58; }
    case '.' { 59; }
    case '?' { 60; }
    else { 0; }
  }
}

// Classes of character: ranges, an 'or' of single characters and a range after a
// single one. Letters are 1, digits 2, blanks 3, '_' 4, the range of a wide character 5
fn class(c char) i32 {
  match c {
    case 'a' .. 'z' or 'A' .. 'Z' { 1; }
    case '0' .. '9' { 2; }
    case ' ' or '\t' or '\n' { 3; }
    case '_' { 4; }
    case 'α' .. 'ω' { 5; }
    else { 0; }
  }
}

// -------- integers --------

// One case for each kind of test: a negative constant, a named constant, ranges (one
// exclusive, one empty), an 'or', a value an earlier range already took (12 stays the
// range's), a guard that fails (30 goes on to the case that follows), and a range too
// wide to spell out, at the end
fn ranges(n i32) i32 {
  match n {
    case -1 { 1; }
    case K { 2; }
    case 10 .. 12 { 3; }
    case -5 .. -3 { 4; }
    case 20 or 21 { 5; }
    case 12 or 13 { 8; }
    case 40 ..< 43 { 12; }
    case 50 ..< 50 { 13; }
    case 30 if n > 100 { 6; }
    case 31 { 7; }
    case 30 { 11; }
    case 100 .. 100000 { 9; }
    else { 0; }
  }
}

// A range too wide to spell out ends the cases the switch holds: 5 is in it, and it is
// tried before the case that names 5
fn wide(n i32) i32 {
  match n {
    case 1 { 1; }
    case 2 { 2; }
    case 3 .. 1000 { 3; }
    case 5 { 4; }
    else { 0; }
  }
}

fn bytes(b u8) i32 {
  match b {
    case 0 { 1; }
    case 200 { 2; }
    case 250 .. 255 { 3; }
    else { 0; }
  }
}

fn signed(b i8) i32 {
  match b {
    case -128 .. -126 { 1; }
    case 127 { 2; }
    case 0 { 3; }
    else { 0; }
  }
}

fn huge(n u64) i32 {
  match n {
    case 18446744073709551615 { 1; }
    case 0 { 2; }
    case 18446744073709551610 .. 18446744073709551613 { 3; }
    else { 0; }
  }
}

// A cell's field is matched where it is, read once
fn field(c &Cell) i32 {
  match c.kind {
    case 1 { 10; }
    case 2 or 3 { 20; }
    case 4 { 30; }
    else { 40; }
  }
}

// A value that is a call is evaluated once, whichever case takes it
fn bump(calls &mut i32) i32 {
  *calls = *calls + 1;
  *calls + 100;
}
fn held(calls &mut i32) i32 {
  match bump(calls) {
    case 101 { 1; }
    case 102 { 2; }
    case 103 { 3; }
    else { 0; }
  }
}

// Cases that jump out of the match: continue, break, and a return
// i = 1 continues; 2 and 3 add 10 each; 4, 5 and 6 add 100 each; 7 and 8 add 1 each;
// 9 breaks: 20 + 300 + 2
fn scan() i32 {
  var total i32 = 0;
  var i i32 = 0;
  while i < 10 {
    i = i + 1;
    match i {
      case 1 { continue; }
      case 2 or 3 { total = total + 10; }
      case 4 .. 6 { total = total + 100; }
      case 9 { break; }
      else { total = total + 1; }
    }
  }
  total;
}
fn early(n i32) i32 {
  match n {
    case 1 { return 11; }
    case 2 { return 22; }
    else { }
  }
  99;
}

// A match inside a case of another
fn nested(a i32, b i32) i32 {
  match a {
    case 1 {
      match b {
        case 1 { 11; }
        case 2 { 12; }
        else { 10; }
      }
    }
    case 2 {
      match b {
        case 1 { 21; }
        case 2 { 22; }
        else { 20; }
      }
    }
    else { 0; }
  }
}

// -------- enums --------

// Red and Blink with a binding and Both with two fields, and a Green nobody names
fn lamp(l Lamp) i32 {
  match l {
    case Red { 1; }
    case let n Blink { n; }
    case let b Both { b.a + b.b; }
    else { 9; }
  }
}

// An 'or' of variants, and every variant named so that the last is the default
fn kindOf(l Lamp) i32 {
  match l {
    case Red or Green { 1; }
    case Blink { 2; }
    case Both { 3; }
  }
}

// Through a reference
fn viaRef(l &Lamp) i32 {
  match l {
    case Red { 1; }
    case Green { 2; }
    case let n Blink { *n; }
    case let b Both { b.a; }
  }
}

// A guard ends the switch: the cases before it are labels, the rest the chain
fn guardTag(l Lamp) i32 {
  match l {
    case Red { 1; }
    case Green { 2; }
    case let n Blink if n > 10 { 100; }
    case let n Blink { n; }
    case let b Both { b.a; }
  }
}

fn sparse(s Sparse) i32 {
  match s {
    case Lo { 1; }
    case Mid { 2; }
    case Hi { 3; }
  }
}

// A trait pattern is the tags of the variants that comply, and Fourth is the last case
fn measure(s &Shape) i32 {
  match s {
    case let m Measured { m.size(); }
    case is Third { 7; }
    case is Fourth { 8; }
  }
}

fn main() {
  // Each character's own case: the written numbers are its place in the list above
  show("tokens");
  num(tok('a')); num(tok('b')); num(tok('c')); num(tok('d')); num(tok('e')); num(tok('f'));
  num(tok('g')); num(tok('h')); num(tok('i')); num(tok('j')); num(tok('k')); num(tok('l'));
  num(tok('m')); num(tok('n')); num(tok('o')); num(tok('p')); num(tok('q')); num(tok('r'));
  num(tok('s')); num(tok('t')); num(tok('u')); num(tok('v')); num(tok('w')); num(tok('x'));
  num(tok('y')); num(tok('z'));
  end();
  show("digits");
  num(tok('0')); num(tok('1')); num(tok('2')); num(tok('3')); num(tok('4'));
  num(tok('5')); num(tok('6')); num(tok('7')); num(tok('8')); num(tok('9'));
  end();
  show("marks");
  num(tok('+')); num(tok('-')); num(tok('*')); num(tok('/')); num(tok('%')); num(tok('='));
  num(tok('<')); num(tok('>')); num(tok('!')); num(tok('&')); num(tok('|')); num(tok('^'));
  num(tok('~')); num(tok('(')); num(tok(')')); num(tok('[')); num(tok(']')); num(tok('{'));
  num(tok('}')); num(tok(',')); num(tok(';')); num(tok(':')); num(tok('.')); num(tok('?'));
  end();
  // Not one of the sixty: '`' and '@' sit next to 'a' and 'A', and '#', ' ', a capital and '_' are none
  show("none");
  num(tok('`')); num(tok('@')); num(tok('#')); num(tok(' ')); num(tok('A')); num(tok('_'));
  end();

  // 'm' and 'Q' letters, '7' a digit, ' ' '\t' '\n' blanks, '_', alpha and omega, then
  // '-' and the character just beyond omega (0x3ca)
  show("class");
  num(class('m')); num(class('Q')); num(class('7'));
  num(class(' ')); num(class('\t')); num(class('\n')); num(class('_'));
  num(class('α')); num(class('ω')); num(class('-')); num(class('ϊ'));
  end();

  // -1 1; 7 2; 10 11 12 are the range, 3 3 3; 13 is the 'or' after it: 8; -5 -4 -3 4 4 4; -2 0;
  // 20 21 5 5; 22 0; 40 41 42 12 12 12; 43 0; 50 0 (the empty range); 30 11 (the guard fails);
  // 31 7; 99 0; 100 9; 100000 9; 100001 0; 0 0
  show("ranges");
  num(ranges(-1)); num(ranges(7));
  num(ranges(10)); num(ranges(11)); num(ranges(12)); num(ranges(13));
  num(ranges(-5)); num(ranges(-4)); num(ranges(-3)); num(ranges(-2));
  num(ranges(20)); num(ranges(21)); num(ranges(22));
  num(ranges(40)); num(ranges(41)); num(ranges(42)); num(ranges(43));
  num(ranges(50)); num(ranges(30)); num(ranges(31)); num(ranges(99));
  num(ranges(100)); num(ranges(100000)); num(ranges(100001)); num(ranges(0));
  end();

  // 1 1; 2 2; 3 3, 5 is in the wide range, which comes before the case for 5: 3; 1000 3; 1001 0; 0 0
  show("wide");
  num(wide(1)); num(wide(2)); num(wide(3)); num(wide(5)); num(wide(1000)); num(wide(1001)); num(wide(0));
  end();

  // 0 1; 200 2; 199 0; 249 0; 250 3; 255 3; 128 0
  show("bytes");
  num(bytes(0u8)); num(bytes(200u8)); num(bytes(199u8)); num(bytes(249u8)); num(bytes(250u8)); num(bytes(255u8));
  num(bytes(128u8));
  end();

  // -128 -127 -126 1 1 1; -125 0; 127 2; 0 3; 1 0
  show("signed");
  num(signed(-128i8)); num(signed(-127i8)); num(signed(-126i8)); num(signed(-125i8));
  num(signed(127i8)); num(signed(0i8)); num(signed(1i8));
  end();

  // the largest u64 1; 0 2; ...610 and ...613 3 3; ...614 0; ...609 0
  show("huge");
  num(huge(18446744073709551615u64)); num(huge(0u64));
  num(huge(18446744073709551610u64)); num(huge(18446744073709551613u64));
  num(huge(18446744073709551614u64)); num(huge(18446744073709551609u64));
  end();

  // kind 1 10; 2 and 3 20 20; 4 30; 5 40
  show("field");
  let c1 = new Cell(1); let c2 = new Cell(2); let c3 = new Cell(3); let c4 = new Cell(4); let c5 = new Cell(5);
  num(field(&c1)); num(field(&c2)); num(field(&c3)); num(field(&c4)); num(field(&c5));
  end();

  // the call is made once for each match: its value 101, 102, 103, 104 take cases 1 2 3 0
  show("held");
  var calls i32 = 0;
  num(held(&mut calls)); num(held(&mut calls)); num(held(&mut calls)); num(held(&mut calls));
  num(calls);
  end();

  show("jumps");
  num(scan());
  num(early(1)); num(early(2)); num(early(3));
  end();

  show("nested");
  num(nested(1, 1)); num(nested(1, 2)); num(nested(1, 3));
  num(nested(2, 1)); num(nested(2, 2)); num(nested(2, 3));
  num(nested(3, 1));
  end();

  // Red 1; Green 9 (the else); Blink(5) 5; Both(2, 30) 32
  show("lamp");
  num(lamp(Red)); num(lamp(Green)); num(lamp(Blink(5))); num(lamp(Lamp.Both(2, 30)));
  end();

  // Red and Green 1 1; Blink 2; Both 3
  show("kindOf");
  num(kindOf(Red)); num(kindOf(Green)); num(kindOf(Blink(4))); num(kindOf(Lamp.Both(1, 1)));
  end();

  // Red 1; Green 2; Blink(6) 6; Both(7, 8) 7
  show("viaRef");
  let r Lamp = Red; let g Lamp = Green; let bl Lamp = Blink(6); let bo Lamp = Lamp.Both(7, 8);
  num(viaRef(&imm r)); num(viaRef(&imm g)); num(viaRef(&imm bl)); num(viaRef(&imm bo));
  end();

  // Red 1; Green 2; Blink(50) 100, over 10; Blink(5) 5; Both(7, 8) 7
  show("guardTag");
  num(guardTag(Red)); num(guardTag(Green)); num(guardTag(Blink(50))); num(guardTag(Blink(5))); num(guardTag(Lamp.Both(7, 8)));
  end();

  // Lo 1; Mid 2; Hi 3
  show("sparse");
  num(sparse(Sparse.Lo)); num(sparse(Sparse.Mid)); num(sparse(Sparse.Hi));
  end();

  // Circle(3) 30; Square(2) 200; Third 7; Fourth 8
  show("trait");
  let ci = Shape.Circle(3); let sq = Shape.Square(2); let th = Shape.Third(9); let fo = Shape.Fourth(1);
  num(measure(&ci)); num(measure(&sq)); num(measure(&th)); num(measure(&fo));
  end();
  0i32;
}
