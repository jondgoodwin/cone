// What a function's pattern must give back [match: topic 8a]: an Option, whose payload a binding
// takes, or a bool, which a test without a binding reads. A function that gives anything else, or
// that takes other arguments than the matched value and the ones written after it, is refused
// where the pattern is written. enum_parse_match_using is how the pattern is spelled.

mod enum_typecheck_match_using;

fn isOdd(n i32) bool { n % 2 == 1 }
fn half(n i32) Option[i32] { if n % 2 == 0 { Some(n / 2) } else { None[i32] } }
fn nothing(n i32) { }
fn between(n i32, lo i32, hi i32) bool { n >= lo and n <= hi }

fn bindingABool(n i32) i32 {
  match n {
    case let h using isOdd() { 1 }    //~ ErrorUsingForm:27 "a function giving an Option"
    else { 0 }
  }
}

fn bindingNothing(n i32) i32 {
  match n {
    case let h using nothing() { 1 }  //~ ErrorUsingForm:29 "a function giving an Option"
    else { 0 }
  }
}

fn testingAnOption(n i32) i32 {
  match n {
    case using half() { 1 }           //~ ErrorUsingForm:20 "needs a function giving a bool"
    else { 0 }
  }
}

fn bindingInAnIf(n i32) i32 {
  if let h using isOdd() = n { return 1; }   //~ ErrorUsingForm:23 "a function giving an Option"
  0
}

fn tooFewArguments(n i32) i32 {
  match n {
    case using between(1) { 1 }       //~ ErrorFewArgs:23 "requires more arguments"
    else { 0 }
  }
}
