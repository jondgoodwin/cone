// What an enum is: a closed set of variants, with or without payloads, plus the
// pattern matching that recovers which variant a value is.
//
// Everything is printed, because a match that compiles is not a match that
// dispatched to the right arm. The enums here carry no abstract methods: a
// requirement on the enum and the virtual reference that dispatches it are
// trait's subject, and this group needs only enough reference to have something
// to match on.

import stdio.*;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showB(label &[]u8, b Bool) {
  show(label, if b {1;} else {0;});
}

// -------- declaring an enum --------

// A field declared on the enum itself is present in every variant, at the same
// offset, so it can be read from a value whose variant is not yet known.
enum Shape {
  pub kind i32;

  struct Circle {
    pub radius i32;
  }

  struct Rect {
    pub w i32;
    pub h i32;
  }
}

// A variant is a name of its enum, 'Shape.Circle', and a module that wants the
// variants bare says so with 'use'. Every enum in this program is followed by
// one; "naming a variant" below writes them qualified instead.
use Shape;

// An enum with no common field at all, whose variants hold different numbers of
// fields of different types: the tag alone tells them apart, and every variant
// is padded out to the size of the largest.
enum Signal {
  struct Halt {}

  struct Step {
    pub amount i32;
  }

  struct Drift {
    pub rateX f32;
    pub rateY f32;
  }
}
use Signal;

// -------- the payload-free form --------

// A bare name is an empty struct variant. That is what makes one construct serve
// a plain set of named symbols as well as a set carrying payloads, and it is why
// there is no second construct to learn. Tag values run ascending from zero.
enum PhoneType {
  Home, Work, Mobile;
}
use PhoneType;

// The integer type an enum lays its tag values out in, with the values written
// rather than assigned -- which is what lines an enum up with an external
// library's constants. Numbering resumes from the last value written, so Cyan
// follows Blue.
enum Colors u32 {
  Red   = 0xFF0000,
  Green = 0x00FF00,
  Blue  = 0x0000FF,
  Cyan;
}
use Colors;

// An enum compares for equivalence and never for order: which variant a value
// holds is what a comparison can answer, and declaration order is not a
// magnitude. Reading the discriminant answers it whole here, because every
// variant is empty and the value is the tag.
fn payloadFree() {
  mut p PhoneType = Work[];
  showB("payload-free-equal", p == Work[]);
  showB("payload-free-unequal", p == Home[]);
  showB("payload-free-not-equal-op", p != Home[]);

  // A variable of the enum accepts any of its variants
  p = Mobile[];
  showB("payload-free-reassigned", p == Mobile[]);

  // 'is' tests the variant without comparing two values
  showB("payload-free-is", p is Mobile);
  showB("payload-free-is-other", p is Home);

  // A pinned value is still a tag: what the language can observe is which
  // variant a value holds, and the width it is laid out in is asserted by a
  // named check in cases.toml rather than from here.
  mut c Colors = Green[];
  showB("pinned-tag-equal", c == Green[]);
  showB("pinned-tag-unequal", c == Red[]);
  c = Cyan[];
  showB("pinned-tag-numbering-resumed", c == Cyan[]);
}

// -------- what a pinned tag value costs --------

// A pinned value is free everywhere the tag is only compared. It costs at the one
// place the tag is used as more than a comparison: building a virtual reference
// from a plain one has to select the variant's vtable, and the vtable list holds
// one entry per variant, so a tag of 0x2000 cannot index it. Dispatch compares
// against each variant's value instead. Nothing about the call changes, which is
// what these lines assert -- and they are the only coverage of that path, so a
// regression in it shows up as the wrong implementation being reached.
enum Signals u32 {
  pub fn weight(self &) i32;

  pub struct Quiet = 0x10 {
    pub n i32;
    fn weight(self &) i32 {n;}
  }

  pub struct Loud = 0x2000 {
    pub n i32;
    fn weight(self &) i32 {n * 100;}
  }
}
use Signals;

// Dispatch through a plain reference, which is where the compiler inserts the
// coercion to a virtual reference and therefore where the tag selects a vtable
fn weigh(s &Signals) i32 {
  s.weight();
}

fn sparseTagDispatch() {
  imm quiet Signals = Quiet[3];
  imm loud Signals = Loud[5];
  show("sparse-tag-dispatch-first", weigh(&quiet));
  show("sparse-tag-dispatch-second", weigh(&loud));

  // ... and through a virtual reference written by hand, which reaches the same
  // selection from the other side
  imm vq &<Signals = &quiet;
  imm vl &<Signals = &loud;
  show("sparse-tag-vref-first", vq.weight());
  show("sparse-tag-vref-second", vl.weight());

  // A sparse tag still narrows back to the variant it names
  show("sparse-tag-matches", which(&quiet));
  show("sparse-tag-matches-other", which(&loud));
}

fn which(s &Signals) i32 {
  match s {
    case is &Quiet {1;}
    case is &Loud {2;}
  }
}

// A generic enum that declares no integer type widens its discriminant to its
// largest tag value exactly as a plain one does. 256 is the value that proves it:
// a one-byte tag would hold it as 0, the tag of the first variant, and the match
// below would take the wrong arm without any complaint.
enum Pinned[T] {
  struct PinnedLow {pub v T;}
  struct PinnedHigh = 256 {}
}

fn whichPinned(p &Pinned[i32]) i32 {
  match p {
    case is &PinnedLow[i32] {1;}
    case is &PinnedHigh[i32] {2;}
  }
}

fn genericPinnedTag() {
  imm low Pinned[i32] = PinnedLow[i32][7];
  imm high Pinned[i32] = PinnedHigh[i32][];
  show("generic-pinned-tag-first", whichPinned(&low));
  show("generic-pinned-tag-wide", whichPinned(&high));
}

// -------- common members anywhere in the body --------

// What makes a member common is its kind, not its position: a 'struct' is a
// variant and anything else is common. So a common field or method may be
// written after a variant, which a positional rule would read as part of that
// variant or drop silently. The layout still puts common fields first in every
// variant, which is what the positional initializers below rely on.
enum Reading {
  struct Spot { pub at i32; }

  pub scale i32;

  struct Span { pub len i32; }

  pub fn scaled(self &) i32 {scale * 2;}
}
use Reading;

fn commonMembersAnywhere() {
  mut s = Spot[3, 7];
  mut n = Span[4, 9];
  show("common-field-declared-after-a-variant", s.scale);
  show("own-field-after-the-common-one", s.at);
  show("common-field-in-the-later-variant", n.scale);
  show("common-method-declared-last", (&s).scaled());
}

// -------- placing the discriminant --------

// An enum may place its own discriminant, which is done for alignment: the field
// is written as type 'tag' and must be anonymous. Every variant's positional
// initializer then supplies the common fields in the same order, with the tag
// still supplied by the variant rather than by the caller.
//
// 'tag' is recognized only where a field's type is written, so it is not a
// reserved word: 'pub tag i32' elsewhere in the suite still declares a field
// named 'tag'.
enum Aligned {
  pub wide i64;
  _ tag;

  struct Small { pub n i32; }
  struct Large { pub a i64; pub b i64; }
}
use Aligned;

fn widthOf(a &Aligned) i32 {
  match a {
    case is &Small {4;}
    case is &Large {16;}
  }
}

fn placedDiscriminant() {
  mut small = Small[5i64, 3];
  mut large = Large[6i64, 7i64, 8i64];
  show("placed-tag-common-field", i64[small.wide]);
  show("placed-tag-own-field", small.n);
  show("placed-tag-other-variant", i64[large.a + large.b]);
  show("placed-tag-matches", widthOf(&small));
  show("placed-tag-matches-other", widthOf(&large));
}

// -------- declining the padding --------

// '@unsized' declines the padding, so the enum has no one size and is reached
// only through a reference. Its variants keep the tag and the common fields, so
// matching and reading a common field work exactly as they do padded; what is
// given up is holding a value of the enum in a variable, copying it and passing
// it by value. enum-typecheck-unsized holds those refusals.
enum @unsized Packet {
  pub id i32;

  struct Ping {}
  struct Payload { pub a i64; pub b i64; pub c i64; }
}
use Packet;

fn packetSize(p &Packet) i32 {
  match p {
    case is &Ping {0;}
    case imm d &Payload {i32[d.a + d.b + d.c];}
  }
}

// A common field is readable through a reference to the enum without knowing the
// variant, which is what the tag and the shared prefix buy even unpadded
fn readId(p &Packet) i32 {
  p.id;
}

fn unsizedEnum() {
  imm ping = Ping[1];
  imm payload = Payload[2, 3i64, 4i64, 5i64];
  show("unsized-empty-variant", packetSize(&ping));
  show("unsized-payload-variant", packetSize(&payload));
  show("unsized-common-field-through-ref", readId(&payload));
}

// -------- extending an enum --------

// An enum may be declared as an extension of another, adding variants to the set
// the base declared. The base's variants come first in the extension's set and
// keep their tag values there, so one declaration serves both enums and a value
// built as a base variant is a value of either.
//
// The two enums are nonetheless distinct types that do not substitute for each
// other in either direction; enum-typecheck-extends holds those refusals, and the
// match on Suit below is still exhaustive over Suit's own four variants, which is
// the property the whole construct rests on.
enum Suit {
  Clubs, Diamonds, Hearts, Spades;
}
use Suit;

// An extension's own namespace holds the variants it adds; the ones it shares are
// its base's, and folded by the base's 'use' above
enum CardKind extends Suit {
  Joker, Back;
}
use CardKind;

// Exhaustive over the base's own variants, with no arm for the added ones
fn suitRank(s Suit) i32 {
  match s {
    case imm c Clubs {1;}
    case imm d Diamonds {2;}
    case imm h Hearts {3;}
    case imm p Spades {4;}
  }
}

// Exhaustive over the extension's set, which is the base's plus its own. That the
// shared arms are reached at all is what says the tag values agree: the value was
// built by the base's variant and the tag is read here against the extension's set.
fn cardRank(c CardKind) i32 {
  match c {
    case imm x Clubs {1;}
    case imm d Diamonds {2;}
    case imm h Hearts {3;}
    case imm p Spades {4;}
    case imm j Joker {5;}
    case imm b Back {6;}
  }
}

// A payload-carrying base, whose common field and padding the extension shares.
// Pair is exactly the size of Blob, the base's largest, which is what an extension
// may add at most while the variants are padded -- enum-genllvm-extends holds the
// refusal of a wider one.
enum Message {
  pub stamp i32;

  pub struct Text { pub len i32; }
  pub struct Blob { pub a i64; }
}
use Message;

enum MoreMessages extends Message {
  pub struct Empty;
  pub struct Pair { pub x i32; pub y i32; }
}
use MoreMessages;

fn messageSize(m &Message) i32 {
  match m {
    case imm t &Text {t.len;}
    case imm b &Blob {i32[b.a];}
  }
}

fn moreMessageSize(m &MoreMessages) i32 {
  match m {
    case imm t &Text {t.len;}
    case imm b &Blob {i32[b.a];}
    case is &Empty {0;}
    case imm p &Pair {p.x + p.y;}
  }
}

// An '@unsized' enum extends with no size restriction at all, because nothing is
// padded: Wide is larger than either of Packet's variants and costs them nothing
enum @unsized MorePackets extends Packet {
  struct Wide { pub a i64; pub b i64; pub c i64; pub d i64; }
}
use MorePackets;

fn morePacketSize(p &MorePackets) i32 {
  match p {
    case is &Ping {0;}
    case imm d &Payload {i32[d.a + d.b + d.c];}
    case imm w &Wide {i32[w.a + w.b + w.c + w.d];}
  }
}

// Two branches of differing variant type, one the base's and one the extension's:
// the extension is the only set holding both, so it is the type inferred
fn chosenMessage(flag Bool) i32 {
  imm chosen = if flag {Text[1, 7];} else {Pair[2, 3, 5];};
  moreMessageSize(&chosen);
}

fn extendedEnum() {
  // A variant of the base is a value of the base and a value of the extension,
  // with the same tag value in both sets
  imm hearts Suit = Hearts[];
  show("extension-base-variant-in-base", suitRank(hearts));
  imm shared CardKind = Hearts[];
  show("extension-base-variant-in-extension", cardRank(shared));
  imm added CardKind = Back[];
  show("extension-added-variant", cardRank(added));

  // A payload variant the two enums share, reached through either, and the common
  // field the base declared read through the extension's set
  imm blob MoreMessages = Blob[3, 9i64];
  show("extension-shared-payload-variant", moreMessageSize(&blob));
  show("extension-shared-common-field", blob.stamp);
  imm pair MoreMessages = Pair[4, 5, 6];
  show("extension-added-payload-variant", moreMessageSize(&pair));
  show("extension-added-common-field", pair.stamp);

  // ... and the base's own set still reads its own variants
  imm text Message = Text[5, 8];
  show("extension-base-reads-its-own", messageSize(&text));

  imm ping = Ping[1];
  imm wide = Wide[2, 1i64, 2i64, 3i64, 4i64];
  show("unsized-extension-shared-variant", morePacketSize(&ping));
  show("unsized-extension-larger-variant", morePacketSize(&wide));
  show("unsized-extension-common-field", readId(&wide));

  show("extension-branch-inference-shared", chosenMessage(true));
  show("extension-branch-inference-added", chosenMessage(false));
}

// -------- constructing and reading --------

fn construction() {
  // A variant is constructed by naming the variant, not the enum. Its
  // positional initializer starts with the enum's common field.
  mut c = Circle[1, 5];
  mut r = Rect[2, 3, 4];
  show("variant-common-field", c.kind);
  show("variant-own-field", c.radius);
  show("other-variant-common-field", r.kind);
  show("other-variant-own-field", r.w * r.h);

  // The common field is writable through the variant
  c.kind = 7;
  show("common-field-assigned", c.kind);

  // A variant with no fields of its own still constructs, and an enum with no
  // common field is still told apart by its tag
  mut h = Halt[];
  mut st = Step[9];
  mut d = Drift[1.5, 2.5];
  show("empty-variant-matched", stride(&h));
  show("sibling-variant-matched", stride(&st));
  show("float-variant-matched", stride(&d));
}

// An enum whose variants share no field at all: only the tag distinguishes them.
// The conversion is here because show prints integers, not because an enum
// needs one.
fn stride(s &Signal) i32 {
  match s {
    case imm h &Halt {0;}
    case imm t &Step {t.amount;}
    case imm d &Drift {i32[d.rateX + d.rateY];}
  }
}

// -------- the enum type itself --------

// An enum may be passed by value: the parameter is one variant's worth of
// storage, and only the common field is readable without matching.
fn kindOf(s Shape) i32 {
  s.kind;
}

// A value of the enum keeps every byte any variant uses, whichever variant it
// holds. Flag's two small fields sit where Count has padding before its i32, and
// Tally, the largest, is byte-aligned where Count is not, so the one size every
// variant is padded to is Tally's rounded up to Count's alignment.
enum Cell {
  struct Flag {pub on Bool; pub code u8;}
  struct Count {pub n i32;}
  struct Tally {pub a u8; pub b u8; pub c u8; pub d u8; pub e u8; pub f u8; pub g u8; pub h u8; pub i u8;}
}

fn cellValue(c Cell) i32 {
  match c {
    case imm f Flag {if f.on {i32[f.code];} else {-1;};}
    case imm n Count {n.n;}
    case imm t Tally {i32[t.i];}
  }
}

fn enumValues() {
  mut c = Circle[1, 5];
  mut r = Rect[2, 3, 4];

  // An enum-typed variable accepts either variant, and accepts a different one
  // later, because every variant is the same size
  mut s Shape = c;
  show("enum-var-holds-circle", s.kind);
  s = r;
  show("enum-var-reassigned-to-rect", s.kind);

  show("enum-passed-by-value", kindOf(c));
  show("enum-passed-by-value-other", kindOf(r));
  show("enum-by-value-keeps-fields-in-anothers-padding", cellValue(Flag[true, 7u8]));
  show("enum-by-value-keeps-the-aligned-variant", cellValue(Count[40]));
  show("enum-by-value-keeps-the-largest-variant", cellValue(Tally[1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8]));

  // Two branches of differing variant type infer the enum as their common
  // supertype, both by value and by reference
  imm byValue = if true {c;} else {r;};
  show("supertype-inferred-by-value", byValue.kind);
  imm byRef = if false {&c;} else {&r;};
  show("supertype-inferred-by-ref", byRef.kind);

  // A reference to an enum is stated the same way as any other reference
  imm sref &Shape = &r;
  show("enum-reference-common-field", sref.kind);
}

// -------- matching --------

// Matching every variant of a closed enum is exhaustive, so the match is a
// value-producing expression with no 'else' clause
fn area(s &Shape) i32 {
  match s {
    case imm c &Circle {c.radius * c.radius;}
    case imm r &Rect {r.w * r.h;}
  }
}

// 'case is' tests the variant without binding a name to the narrowed value
fn isRect(s &Shape) i32 {
  match s {
    case is &Rect {1;}
    else {0;}
  }
}

// An arm that does not name every variant needs an 'else' to be exhaustive
fn radiusOr(s &Shape, dflt i32) i32 {
  match s {
    case imm c &Circle {c.radius;}
    else {dflt;}
  }
}

// A bound variable may be 'mut', which writes through to the matched value.
// The parameter is '&mut Shape' rather than '&mut Circle' because a mutable
// reference to a variant does not coerce to one to the enum.
fn grow(s &mut Shape) {
  match s {
    case mut c &mut Circle {c.radius = c.radius + 10;}
    case mut r &mut Rect {r.w = r.w + 10;}
  }
}

// The single-pattern form of a match is an 'if' whose condition binds
fn circleRadius(s &Shape) i32 {
  if imm c &Circle = s {
    c.radius;
  }
  else {
    0;
  }
}

fn matching() {
  mut c = Circle[1, 5];
  mut r = Rect[2, 3, 4];
  show("match-dispatch-circle", area(&c));
  show("match-dispatch-rect", area(&r));
  show("match-is-circle", isRect(&c));
  show("match-is-rect", isRect(&r));
  show("match-else-arm-taken", radiusOr(&r, 99));
  show("match-named-arm-taken", radiusOr(&c, 99));
  show("if-binding-taken", circleRadius(&c));
  show("if-binding-not-taken", circleRadius(&r));

  mut sc Shape = c;
  mut sr Shape = r;
  grow(&mut sc);
  grow(&mut sr);
  show("mut-binding-writes-through-circle", radiusOr(&sc, 99));
  show("mut-binding-writes-through-rect", area(&sr));
}

// -------- matching through a type alias --------

// A typedef is a transparent alias and nothing rewrites it away, so a pattern
// spelled through one has to name the same variant the concrete spelling names.
// Exhaustiveness is where that shows: a match naming every variant needs no
// 'else', and it is the exhaustiveness check that has to see through the alias.
// It did not -- it read the reference's target off the name use rather than off
// the type the name resolves to, which yields the reference type itself, so no
// arm ever matched a variant and the match was refused as a value-producing
// expression. Every spelling is paired with the concrete one above, because a
// match that compiles is not a match that dispatched to the right arm.

typedef CircleRef &Circle;
typedef RectRef &Rect;
typedef CircleRefAgain CircleRef;
typedef CircleMut &mut Circle;
typedef RectMut &mut Rect;
typedef CircleVal Circle;
typedef RectVal Rect;

// The same match as 'area', with both arms spelled through an alias
fn areaAlias(s &Shape) i32 {
  match s {
    case imm c CircleRef {c.radius * c.radius;}
    case imm r RectRef {r.w * r.h;}
  }
}

// An alias of an alias, followed to its end
fn areaAliasOfAlias(s &Shape) i32 {
  match s {
    case imm c CircleRefAgain {c.radius * c.radius;}
    case imm r RectRef {r.w * r.h;}
  }
}

// One arm concrete and one aliased: exhaustiveness has to account for both
fn areaMixedSpelling(s &Shape) i32 {
  match s {
    case imm c &Circle {c.radius * c.radius;}
    case imm r RectRef {r.w * r.h;}
  }
}

// 'case is', which binds no name, through an alias
fn whichAlias(s &Shape) i32 {
  match s {
    case is CircleRef {1;}
    case is RectRef {2;}
  }
}

// A 'mut' binding through an alias of '&mut Variant', which writes through
fn growAlias(s &mut Shape) {
  match s {
    case mut c CircleMut {c.radius = c.radius + 10;}
    case mut r RectMut {r.w = r.w + 10;}
  }
}

// Matched by value, where the alias names the variant struct rather than a
// reference to it. This spelling was already right, and is here as the control
// on the two that were not.
fn whichValueAlias(s Shape) i32 {
  match s {
    case imm c CircleVal {1;}
    case imm r RectVal {2;}
  }
}

// The single-pattern 'if' form
fn circleRadiusAlias(s &Shape) i32 {
  if imm c CircleRef = s {
    c.radius;
  }
  else {
    0;
  }
}

// A match that names one variant is not exhaustive however it is spelled, so
// the 'else' is still required
fn radiusOrAlias(s &Shape, dflt i32) i32 {
  match s {
    case imm c CircleRef {c.radius;}
    else {dflt;}
  }
}

fn aliasMatching() {
  mut c = Circle[1, 5];
  mut r = Rect[2, 3, 4];
  show("alias-match-circle", areaAlias(&c));
  show("alias-match-rect", areaAlias(&r));
  show("alias-of-alias-match", areaAliasOfAlias(&c));
  show("alias-mixed-with-concrete", areaMixedSpelling(&r));
  show("alias-case-is-circle", whichAlias(&c));
  show("alias-case-is-rect", whichAlias(&r));
  show("alias-by-value-circle", whichValueAlias(c));
  show("alias-by-value-rect", whichValueAlias(r));
  show("alias-if-binding-taken", circleRadiusAlias(&c));
  show("alias-if-binding-not-taken", circleRadiusAlias(&r));
  show("alias-else-arm-taken", radiusOrAlias(&r, 99));
  show("alias-named-arm-taken", radiusOrAlias(&c, 99));

  mut sc Shape = c;
  mut sr Shape = r;
  growAlias(&mut sc);
  growAlias(&mut sr);
  show("alias-mut-binding-writes-through-circle", radiusOrAlias(&sc, 99));
  show("alias-mut-binding-writes-through-rect", areaAlias(&sr));
}

// A match on a value rather than a variant compares with '=='
fn classify(n i32) i32 {
  match n {
    case ==0 {100;}
    case ==1 {200;}
    else {300;}
  }
}

fn valueMatching() {
  show("value-match-first", classify(0));
  show("value-match-second", classify(1));
  show("value-match-else", classify(9));
}

// -------- Option and Result --------

// Option[T] and Result[T,E] are enums declared by the core library, so they
// match exactly like an enum declared here. Their variants are bare with no
// 'use' written here: core writes 'use pub Option;' and 'use pub Result;', and
// every module's automatic import of core carries a public fold on.
fn unwrapOr(o Option[i32], dflt i32) i32 {
  match o {
    case imm s Some[i32] {s.value;}
    case imm n None[i32] {dflt;}
  }
}

fn signedResult(r Result[i32, i32]) i32 {
  match r {
    case imm k Ok[i32, i32] {k.value;}
    case imm e Error[i32, i32] {0 - e.value;}
  }
}

// A Bool beside a tag is at byte 1, where the i32 variant has padding
fn boolResult(r Result[Bool, i32]) i32 {
  match r {
    case imm k Ok[Bool, i32] {if k.value {1;} else {2;};}
    case imm e Error[Bool, i32] {3;}
  }
}

// An Option whose value type is itself an Option, so the type argument is a
// generic instantiation rather than a plain type. That is the only thing
// separating this from 'unwrapOr' above, and it was once recorded as a defect
// that would not compile.
fn unwrapNested(o Option[Option[i32]], dflt i32) i32 {
  match o {
    case imm s Some[Option[i32]] {unwrapOr(s.value, dflt);}
    case imm n None[Option[i32]] {dflt;}
  }
}

// Option reached by reference rather than by value. '&Option[i32]' is a type of
// a generic instantiation, which used not to parse as one because a borrow
// consumed only the bare name; the whole group matched by value for that reason.
fn unwrapRefOr(o &Option[i32], dflt i32) i32 {
  match *o {
    case imm s Some[i32] {s.value;}
    case imm n None[i32] {dflt;}
  }
}

fn optionAndResult() {
  show("option-some", unwrapOr(Some[7], 99));
  show("option-none", unwrapOr(None[i32][], 99));

  // Both branches of an 'if' infer Option as their supertype
  imm chosen = if true {Some[3];} else {None[i32][];};
  show("option-from-branches", unwrapOr(chosen, 99));

  // A declared Option variable accepts either variant
  mut opt Option[i32] = None[i32][];
  show("option-declared-none", unwrapOr(opt, 42));
  opt = Some[8];
  show("option-declared-reassigned", unwrapOr(opt, 42));

  show("result-ok", signedResult(Ok[i32, i32][5]));
  show("result-error", signedResult(Error[i32, i32][3]));
  show("result-bool-by-value", boolResult(Ok[Bool, i32][true]));

  imm held Option[i32] = Some[6];
  show("option-by-reference", unwrapRefOr(&held, 99));
  imm empty Option[i32] = None[i32][];
  show("option-by-reference-none", unwrapRefOr(&empty, 99));

  // An Option holding an Option, built the way the recorded defect spelled it
  imm nested Option[Option[i32]] = Some[Option[i32]][Some[4]];
  show("option-nested-outer", unwrapNested(nested, 99));
  imm nestedEmpty Option[Option[i32]] = Some[Option[i32]][None[i32][]];
  show("option-nested-inner-none", unwrapNested(nestedEmpty, 99));
}

// -------- naming a variant --------

// A variant is a name of its enum, so 'Enum.Variant' reaches it wherever the enum
// can be named, with no 'use' at all. Signs is folded by nothing in this program.
enum Signs {
  Plus, Minus;
}

// Two enums may each have a variant of one spelling, since each is a name of its
// own enum. Only a fold of both into one module would collide.
enum KeyEvent {
  Quit, Press;
}

enum WindowEvent {
  Quit, Resize;
}

fn signOf(s Signs) i32 {
  match s {
    case is Signs.Plus {1;}
    case is Signs.Minus {-1i32;}
  }
}

fn qualifiedArea(s &Shape) i32 {
  match s {
    case imm c &Shape.Circle {c.radius * c.radius * 3;}
    case imm r &Shape.Rect {r.w * r.h;}
  }
}

fn quits(k KeyEvent, w WindowEvent) i32 {
  mut n = 0;
  if k is KeyEvent.Quit {n = n + 1;}
  if w is WindowEvent.Quit {n = n + 10;}
  n;
}

// A generic enum's variant, reached through the enum and instantiated as the bare
// name is
fn unwrapQualified(o Option[i32], dflt i32) i32 {
  match o {
    case imm s Option.Some[i32] {s.value;}
    case imm n Option.None[i32] {dflt;}
  }
}

fn namingVariants() {
  show("qualified-construct-and-match", signOf(Signs.Minus[]));
  imm c Shape = Shape.Circle[1, 2];
  imm r Shape = Shape.Rect[2, 3, 4];
  show("qualified-pattern-circle", qualifiedArea(&c));
  show("qualified-pattern-rect", qualifiedArea(&r));
  show("same-spelling-in-two-enums", quits(KeyEvent.Quit[], WindowEvent.Resize[]));
  show("same-spelling-other-enum", quits(KeyEvent.Press[], WindowEvent.Quit[]));
  show("qualified-generic-variant", unwrapQualified(Option.Some[5], 99));
  show("qualified-generic-empty", unwrapQualified(Option.None[i32][], 99));
  show("qualified-result", signedResult(Result.Error[i32, i32][6]));
}

// -------- folding some of the variants --------

// A 'use' may admit some of an enum's variants rather than all of them, rename
// one with 'as', spread its list over lines in a block, or take every variant
// 'but' some. What it leaves out is still reached through the enum.
enum Compass {
  North, East, South, West;
}
use Compass North as Up, South;

enum Level {
  Low, Mid, High;
}
use Level {
  Low,
  High as Top,
};

enum Weather {
  Sun, Rain, Snow;
}
use Weather but Snow;

fn heading(c Compass) i32 {
  match c {
    case is Up {1;}
    case is Compass.East {2;}
    case is South {3;}
    else {4;}
  }
}

fn height(l Level) i32 {
  match l {
    case is Low {1;}
    case is Level.Mid {2;}
    case is Top {3;}
  }
}

fn wetness(w Weather) i32 {
  match w {
    case is Sun {0;}
    case is Rain {1;}
    case is Weather.Snow {2;}
  }
}

fn foldingSome() {
  show("folded-under-a-new-name", heading(Up[]));
  show("folded-by-its-own-name", heading(South[]));
  show("left-out-reached-through-the-enum", heading(Compass.West[]));
  show("folded-in-a-block", height(Top[]));
  show("left-out-of-a-block", height(Level.Mid[]));
  show("folded-all-but", wetness(Rain[]));
  show("the-but-reached-through-the-enum", wetness(Weather.Snow[]));
}

// -------- interaction with the constructs below this tier --------

// An enum built in one branch and matched in another, accumulated in a loop:
// the intersections where variant tags and control flow have to agree.
fn stepped(n i32) Shape {
  if n % 2 == 0 {
    Circle[1, n];
  }
  else {
    Rect[2, n, 2];
  }
}

fn interactions() {
  mut total = 0;
  mut i = 0;
  while i < 6 {
    mut s = stepped(i);
    total = total + area(&s);
    i++;
  }
  show("enum-returned-from-branch-summed", total);

  // A match whose arms are the last statement of a function, returning the
  // enum's own common field
  mut acc = 0;
  mut j = 0;
  while j < 4 {
    acc = acc + kindOf(stepped(j));
    j++;
  }
  show("enum-by-value-in-loop", acc);

  // A variant holding a move type infects the enum with move semantics, and the
  // infection walks up the base every variant has. That walk never advanced its
  // cursor, so declaring this enum hung the compiler outright -- no output, no
  // diagnostic. The assertion is therefore that this file compiles at all; the
  // runner's timeout is what catches a regression.
  imm boxed = Boxed[1, Handle[9]];
  show("move-typed-variant", boxed.kind);

  // A variant stands in for its enum wherever the enum is expected, and a
  // struct literal's field is such a place. It used to be the one place it was
  // not: a literal's values were compared for exact type equality where a
  // variable initializer coerces, so the same value the line above accepts was
  // refused one line down.
  imm asVariable Shape = Circle[1, 4];
  imm inField = Framed[Circle[1, 5]];
  show("variant-coerces-in-initializer", area(&asVariable));
  show("variant-coerces-in-struct-literal", area(&inField.s));
}

// A struct with an enum-typed field, for the literal above. It is here rather
// than beside Shape for the same reason Held is: the coercion is the subject,
// not the struct.
struct Framed {
  pub s Shape;
}

// The enum whose declaration is the subject above. Declared down here with the
// other interaction types rather than beside Shape, because it is not what this
// group is about -- only the infection it triggers is.
struct @move Handle {
  pub id i32;
}

enum Held {
  pub kind i32;

  struct Boxed {
    pub h Handle;
  }

  struct Bare {
    n i32;
  }
}
use Held;

// -------- held by value above its declaration --------

// Where an enum is written does not decide whether it can be held. A field, a
// parameter and a local all hold Crate by value here, above its declaration, so
// each asks for its size before the module walk has reached any of its variants.
// A variant not yet reached is not one being laid out -- nothing of it is on the
// demand stack, so it closes no cycle -- and this was once refused as though it
// were one. The variants are laid out when the walk reaches them, and generation
// sizes the enum from them, as it does for every enum.
struct Shipment {
  pub load Crate;
  pub count i64;
}

fn crateWeight(c Crate) i64 {
  mut held Crate = c;
  match held {
    case imm b Bulky {b.kg;}
    case imm s Slim {1i64;}
  }
}

enum Crate {
  struct Bulky {
    pub kg i64;
  }
  Slim;
}
use Crate;

fn heldAboveDeclaration() {
  show("enum-param-above-declaration", crateWeight(Bulky[40]));
  mut s = Shipment[Slim[], 3];
  show("enum-field-above-declaration", crateWeight(s.load) + s.count);
}

// An enum may reach itself through a reference, which is how a tree is written.
// The enum's size is the largest of its variants, so a variant holding it by
// value would be infinite -- enum-typecheck-variant holds that -- but a
// reference answers its own size without asking what it points at, so the cycle
// terminates. Declared rather than built: constructing one needs a nullable
// reference, and enum-nullable-ptr owns that shape.
enum Tree {
  pub depth i32;

  struct Leaf {
    v i64;
  }

  struct Fork {
    pub left &Tree;
    pub right &Tree;
  }
}

// Named through its enum, which is the spelling wherever no 'use' is in force
fn forkDepth(f &Tree.Fork) i32 {
  f.left.depth + f.right.depth;
}

fn main() i32 {
  construction();
  payloadFree();
  sparseTagDispatch();
  genericPinnedTag();
  commonMembersAnywhere();
  placedDiscriminant();
  unsizedEnum();
  extendedEnum();
  enumValues();
  matching();
  aliasMatching();
  valueMatching();
  optionAndResult();
  namingVariants();
  foldingSome();
  interactions();
  heldAboveDeclaration();
  0i32;
}
