// '?.' stays reserved inside a 'try' block [Jon 26 Oct]: optional chaining is written
// 'try { (a?).b }' for now, and '?.' is held so that it may later carry an implied
// try of its own without changing any program's meaning. 'try' is a keyword: it
// names nothing.

mod enum_parse_try;

struct Pt { pub x: i32; }

fn x(p: Option[Pt]) Option[i32] {
  try { p?.x }                 //~ ErrorReserved:10 "'?.' is reserved"
}
