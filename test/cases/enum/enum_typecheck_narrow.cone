// What a pattern is allowed to narrow to: a variant of the enum being matched,
// and nothing else; and, bound through a reference, only through one no other
// reference may change the variant under.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. Both patterns below name a type that exists and
// resolves, so neither is a name-resolution failure -- the type is simply not
// one the matched value could ever be.

mod enum_typecheck_narrow;

enum Shape {
  kind i32;

  struct Circle {
    pub radius i32;
  }

  struct Rect {
    pub w i32;
    h i32;
  }
}
use Shape;

enum Other {
  struct Alpha {
    pub a i32;
  }

  struct Beta {
    b i32;
  }
}
use Other;

// A variant of a different enum is still a variant, and still unreachable from
// this one
fn foreignVariant(s &imm Shape) i32 {
  match s {
    case imm a &Alpha {a.a;}   //~ ErrorInvType:10 "Types are not compatible for this downcast specialization"
    else {0;}
  }
}

// A value that is not an enum has no variant to narrow to at all. The failed
// narrowing leaves a cast the compiler then cannot build.
fn matchNonEnum(n i32) i32 {
  match n {
    case imm c &Circle {c.radius;}   //~ ErrorInvType:10 "Types are not compatible for this downcast specialization"
                                    //~^ ErrorInvType:16 "Unsupported built-in type conversion" follow-on
    else {0;}
  }
}

// A pattern may not narrow across regions. The value is borrowed, so its variant
// is borrowed too; asking for an owning reference would hand the match arm
// storage that nothing gave it ownership of, and the two regions are laid out
// differently besides -- an 'Rc' allocation carries a count the borrow has no
// room for. There is no recast between regions, so the regions must be the same.
fn foreignRegion(s &imm Shape) i32 {
  match s {
    case imm c +Rc-mut Circle {c.radius;}   //~ ErrorInvType "won't downcast safely"
    else {0;}
  }
}

// A value that is already a variant has nothing left to narrow. Naming the
// cause matters here because the usual way in is not a downcast anyone wrote: a
// method with a body declared on an enum is a default, cloned into every variant
// with 'Self' repointed, so inside the copy 'self' is one variant and 'match self'
// asks to narrow it. The two forms below are the same mistake reached the two
// ways, and each says which.
fn matchAVariant(c &Circle) i32 {
  match c {
    case imm r &Rect {r.w;}   //~ ErrorInvType:10 "Circle is one variant of Shape, so it is already narrowed"
    else {0;}
  }
}

enum Gauge {
  reading i32;

  pub struct Low { pub lo i32; }
  struct High { hi i32; }

  // A default, so it is copied into Low and into High
  fn pick(self &) i32 {
    match self {
      // Reported twice, once per copy: the default is cloned into Low and into
      // High, and each copy narrows a 'self' that is already its own variant
      case imm l &Low {l.lo;}   //~ ErrorInvType:12 "Low is one variant of Gauge"
                               //~^ ErrorInvType:12 "High is one variant of Gauge"
      else {0;}
    }
  }
}

// The same default taking 'self' by value. In Flat's copy the pattern names the
// type the value already has, which is no downcast at all, and is the same
// mistake.
enum Level {
  mark i32;

  pub struct Flat { pub f i32; }
  struct Steep { s i32; }

  fn pick(self) i32 {
    match self {
      case imm l Flat {l.f;}   //~ ErrorInvType:12 "Flat is one variant of Level"
                               //~^ ErrorInvType:12 "Steep is one variant of Level"
      else {0;}
    }
  }
}

// -------- through a reference that may alias --------

// A binding through a reference is a reference into the variant's payload, and
// if the value's variant changes while it is used, the payload is read as the
// wrong variant's. Jon's 2018 rule ("Interior References and Shared
// Mutability"): for 'mut' references to shape-changing types, no interior
// references. The compiler refuses the narrowing wherever it cannot see that
// nothing will change the variant: through a reference of unseen origin -- a
// parameter, a field reached through a reference, anything reached through a
// shared owner, a reference a variable holds -- which may be one of several
// references, any of which may change it. A borrow of a local, made where it
// is matched, narrows with any permission: a local is a 'uni' source, and the
// borrow freezes it until the binding's last use (enum_success, 'matching';
// ref_flow_freeze, the change refused). So do 'uni', 'imm' and 'mut1'
// references, which nothing else can change the variant under. 'case is',
// which binds nothing, narrows through any.
fn writeThroughMut(s &mut Shape) {
  match s {
    case mut c &mut Circle {c.radius = c.radius + 10;}   //~ ErrorBadPerm:10 "A 'mut' reference to Shape, not borrowed here"
    else {}
  }
}

fn readThroughRo(s &Shape) i32 {
  if imm c &Circle = s {c.radius;} else {0;}   //~ ErrorBadPerm:6 "A 'ro' reference to Shape, not borrowed here"
}

alias CircleMut = &mut Circle;
fn throughAnAlias(s &mut Shape) {
  match s {
    case mut c CircleMut {c.radius = 1;}   //~ ErrorBadPerm:10 "A 'mut' reference to Shape, not borrowed here"
    case is &mut Rect {}
  }
}

fn boundIfThroughMut(s &mut Shape) i32 {
  if imm c &mut Circle = s {c.radius;} else {0;}   //~ ErrorBadPerm:6 "A 'mut' reference to Shape, not borrowed here"
}

// Borrowed here, but not of a place reached as 'uni': a reborrow through a
// '&mut' parameter, a field of a struct a '&mut' parameter points at, a field
// of what a 'Rc[mut, T]' owner points at
struct Held { pub s Shape; }

fn reborrowOfParam(s &mut Shape) i32 {
  match &mut *s {
    case mut c &mut Circle {c.radius;}   //~ ErrorBadPerm:10 "A 'mut' reference to Shape, not borrowed here"
    else {0;}
  }
}

fn fieldThroughParam(h &mut Held) i32 {
  match &h.s {
    case imm c &Circle {c.radius;}   //~ ErrorBadPerm:10 "A 'ro' reference to Shape, not borrowed here"
    else {0;}
  }
}

fn throughSharedOwner(v Shape) i32 {
  imm u = new Rc[mut, Held](v);
  match &mut u.s {
    case mut c &mut Circle {c.radius;}   //~ ErrorBadPerm:10 "A 'mut' reference to Shape, not borrowed here"
    else {0;}
  }
}

// A borrow of a local, but held in a variable the program names: a copy of it
// would reach the local another way, which freezing does not follow
fn heldInAVariable(v Shape) i32 {
  mut s = v;
  imm r = &mut s;
  match r {
    case mut c &mut Circle {c.radius;}   //~ ErrorBadPerm:10 "A 'mut' reference to Shape, not borrowed here"
    else {0;}
  }
}

// The ones that may: through '&uni' the binding may even write, and '&imm'
// never changes; a borrow of a local, made here, is enum_success's
fn writeThroughUni(s &uni Shape) {
  match s {
    case mut c &uni Circle {c.radius = c.radius + 10;}
    else {}
  }
}

fn readThroughImm(s &imm Shape) i32 {
  if imm c &Circle = s {c.radius;} else {0;}
}

fn testsThroughMut(s &mut Shape) bool {
  s is &mut Circle;
}
