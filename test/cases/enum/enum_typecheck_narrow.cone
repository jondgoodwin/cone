// What a pattern is allowed to narrow to: a variant of the enum being matched,
// and nothing else; and, bound through a reference, only through one no other
// reference may change the variant under.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. Both patterns below name a type that exists and
// resolves, so neither is a name-resolution failure -- the type is simply not
// one the matched value could ever be.

mod enum_typecheck_narrow;

enum Shape {
  kind: i32;

  struct Circle {
    pub radius: i32;
  }

  struct Rect {
    pub w: i32;
    h: i32;
  }
}
use Shape;

enum Other {
  struct Alpha {
    pub a: i32;
  }

  struct Beta {
    b: i32;
  }
}
use Other;

// A variant of a different enum is still a variant, and still unreachable from
// this one
fn foreignVariant(s: &imm Shape) i32 {
  match s {
    case &Alpha(a) {a.a}   //~ ErrorInvType:10 "Types are not compatible for this downcast specialization"
    else {0}
  }
}

// A value that is not an enum has no variant to narrow to at all. The failed
// narrowing leaves a cast the compiler then cannot build.
fn matchNonEnum(n: i32) i32 {
  match n {
    case &Circle(c) {c.radius}   //~ ErrorInvType:10 "Types are not compatible for this downcast specialization"
                                    //~^ ErrorInvType:10 "Unsupported built-in type conversion" follow-on
    else {0}
  }
}

// A pattern written as a reference is a check that the matched value is one of that
// kind, and may not narrow across regions. The value is owned by an 'Rc', so its
// variant is the 'Rc''s; a borrow of it would hand the match arm a reference that
// nothing counts, and the two regions are laid out differently besides -- an 'Rc'
// allocation carries a count the borrow has no room for. There is no recast between
// regions, so the regions must be the same. (Naming the variant alone, 'Circle', is
// the reference the matched value is.)
fn foreignRegion(s: Rc[imm, Shape]) i32 {
  match s {
    case &Circle(c) {c.radius}   //~ ErrorInvType "won't downcast safely"
    else {0}
  }
}

// The same check against a stronger permission than the matched value has
fn foreignPermission(s: &imm Shape) i32 {
  match s {
    case &mut Circle(c) {c.radius}   //~ ErrorInvType "won't downcast safely"
    else {0}
  }
}

// ...and against a matched value that is no reference at all
fn notAReference(s: Shape) i32 {
  match s {
    case &Circle(c) {c.radius}   //~ ErrorInvType:10 "Types are not compatible for this downcast specialization"
                                    //~^ ErrorInvType:10 "Unsupported built-in type conversion" follow-on
    else {0}
  }
}

// A value that is already a variant has nothing left to narrow. Naming the
// cause matters here because the usual way in is not a downcast anyone wrote: a
// method with a body declared on an enum is a default, cloned into every variant
// with 'Self' repointed, so inside the copy 'self' is one variant and 'match self'
// asks to narrow it. The two forms below are the same mistake reached the two
// ways, and each says which.
fn matchAVariant(c: &Circle) i32 {
  match c {
    case &Rect(r) {r.w}   //~ ErrorInvType:10 "Circle is one variant of Shape, so it is already narrowed"
    else {0}
  }
}

enum Gauge {
  reading: i32;

  pub struct Low { pub lo: i32; }
  struct High { hi: i32; }

  // A default, so it is copied into Low and into High
  fn pick(self: &) i32 {
    match self {
      // Reported twice, once per copy: the default is cloned into Low and into
      // High, and each copy narrows a 'self' that is already its own variant
      case &Low(l) {l.lo}   //~ ErrorInvType:12 "Low is one variant of Gauge"
                               //~^ ErrorInvType:12 "High is one variant of Gauge"
      else {0}
    }
  }
}

// The same default taking 'self' by value. In Flat's copy the pattern names the
// type the value already has, which is no downcast at all, and is the same
// mistake.
enum Level {
  mark: i32;

  pub struct Flat { pub f: i32; }
  struct Steep { s: i32; }

  fn pick(self) i32 {
    match self {
      case Flat(l) {l.f}   //~ ErrorInvType:12 "Flat is one variant of Level"
                               //~^ ErrorInvType:12 "Steep is one variant of Level"
      else {0}
    }
  }
}


// -------- through an owner --------

// A reference narrowed into a variant, through a reference other references share, is
// allowed and followed (enum_flow_narrow_shared, enum_narrow_shared_success). One held
// by an owner, an 'Rc', is another owner of the value, and no borrow of anything
// stands for it: it stays refused, whichever way it is written
fn throughOwner(s: Rc[mut, Shape]) i32 {
  match s {
    case Circle(c) {c.radius}   //~ ErrorBadPerm:10 "held by an owner (an 'Rc')"
    else {0}
  }
}

fn throughOwnerBound(s: Rc[mut, Shape]) i32 {
  if let Circle(c) = s {c.radius} else {0}   //~ ErrorBadPerm:6 "held by an owner (an 'Rc')"
}

// ... and a read-only owner is not safe either: 'ro' is a view others may change
fn throughReadOnlyOwner(s: Rc[ro, Shape]) i32 {
  match s {
    case Circle(c) {c.radius}   //~ ErrorBadPerm:10 "another owner could change which variant it holds"
    else {0}
  }
}
