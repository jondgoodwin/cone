// A 'var' variable bound by a match arm is the matched value under its variant's
// name, in the matched value's own storage, and behaves as a plain 'var' local
// does: assigned over, it finalizes what it held, if it still holds anything; and
// moved out (on every path or only on some) and then assigned, it holds the new
// value, which the matched value's variable finalizes as the match ends. Each
// function prints the finalizers it runs, in order, between the marks of its own
// steps; 'plain' and 'plainSome' are the same shapes on a plain 'var' local, to
// read the arm-bound ones against.

mod enum_match_bind_final;

import stdio use *;

struct Fin {
  pub id: i32;
  fn final(self: &uni) {
    printStr("fin");
    printInt(i64.from(id));
    printStr(" ");
  }
}

enum E {
  struct A { pub f: Fin; }
  struct B { pub n: i32; }
}
use E;

fn takeA(a: A) { printStr("took "); }

// Moved, then assigned: nothing to finalize at the assignment; the new value is finalized at the match's end
fn movedThenAssigned() {
  let e: E = A(Fin(1));
  match e {
    case var a A {
      takeA(a);
      a = A(Fin(2));
      printStr("assigned ");
    }
    else {}
  }
  printStr("| ");
}

// Assigned over without a move: the old value is finalized as it is replaced
fn assignedOnly() {
  let e: E = A(Fin(3));
  match e {
    case var a A {
      a = A(Fin(4));
      printStr("assigned ");
    }
    else {}
  }
  printStr("| ");
}

// Moved on some path only: the assignment finalizes the old value on the path that kept it
fn somePath(b: bool) {
  let e: E = A(Fin(5));
  match e {
    case var a A {
      if b { takeA(a); }
      a = A(Fin(6));
      printStr("assigned ");
    }
    else {}
  }
  printStr("| ");
}

// Moved on every path of an 'if', then assigned
fn bothPaths(b: bool) {
  let e: E = A(Fin(11));
  match e {
    case var a A {
      if b { takeA(a); } else { takeA(a); }
      a = A(Fin(10));
      printStr("assigned ");
    }
    else {}
  }
  printStr("| ");
}

// Moved and assigned afresh in each pass of a loop
fn loopMoved() {
  let e: E = A(Fin(7));
  match e {
    case var a A {
      var i: i32 = 0;
      while i < 2 {
        takeA(a);
        a = A(Fin(8 + i));
        i += 1;
      }
      printStr("end ");
    }
    else {}
  }
  printStr("| ");
}

// Assigned over twice, never moved: each replaced value is finalized
fn assignedTwice() {
  let e: E = A(Fin(12));
  match e {
    case var a A {
      a = A(Fin(13));
      a = A(Fin(14));
      printStr("assigned ");
    }
    else {}
  }
  printStr("| ");
}

// The same shapes on a plain 'var' local
fn plain() {
  var a: A = A(Fin(15));
  takeA(a);
  a = A(Fin(16));
  printStr("assigned ");
}
fn plainSome(b: bool) {
  var a: A = A(Fin(17));
  if b { takeA(a); }
  a = A(Fin(18));
  printStr("assigned ");
}

fn main() {
  movedThenAssigned(); printStr("\n");
  assignedOnly(); printStr("\n");
  somePath(true); printStr("\n");
  somePath(false); printStr("\n");
  bothPaths(true); printStr("\n");
  bothPaths(false); printStr("\n");
  loopMoved(); printStr("\n");
  assignedTwice(); printStr("\n");
  plain(); printStr("| \n");
  plainSome(true); printStr("| \n");
  plainSome(false); printStr("| \n");
}
