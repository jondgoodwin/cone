// A match covers every value it can be shown to cover, or ends in 'else' [topic 5, the
// exhaustiveness principle, topic 6.0]. Without an 'else' a match must name every variant
// of an enum, or both values of a bool, statement or value, an 'or' naming several at
// once. 'match a, b' matches several values at once, a case giving a pattern for each
// and '_' for a value it does not care about; the combinations of its columns must be
// covered the same way. Numbers, characters and text cannot be counted, so a column of
// them needs an 'else'. The reject side is enum_typecheck_match_cover.
//
// Everything is printed, so the output is the whole assertion. The expected lines are
// worked out by hand in the comments in main.

mod enum_match_cover;

import stdio use *;

enum Lamp {
  Red;
  Green;
  Blink(i32);
}

enum Shape {
  Dot;
  struct Circle { pub radius i32; }
  struct Rect { pub w i32; pub h i32; }
}
use Lamp;
use Shape;

fn show(label &str) {
  printStr(label);
  printStr(": ");
}
fn end() {
  printStr("|\n");
}
fn num(n i32) {
  printInt(i64.from(n));
  printStr(" ");
}

// -------- one value --------

// A statement match naming every variant, with no 'else'
fn tally(l Lamp, total &mut i32) {
  match l {
    case Red { *total = *total + 1; }
    case Green { *total = *total + 10; }
    case let n Blink { *total = *total + 100 * n; }
  }
}

// An 'or' names several variants at once
fn orCover(s &imm Shape) i32 {
  match s {
    case let c Circle { c.radius }
    case Rect or Dot { 7 }
  }
}

// A bool's two values
fn yesNo(b bool) i32 {
  match b {
    case true { 1 }
    case false { 0 }
  }
}
fn notB(b bool) bool {
  match b {
    case false { true }
    case true { false }
  }
}
fn anyBool(b bool) i32 {
  match b {
    case true or false { 9 }
  }
}
fn bump(b bool, n &mut i32) {
  match b {
    case true { *n = *n + 5; }
    case false { *n = *n + 1; }
  }
}

fn optTally(o Option[i32], t &mut i32) {
  match o {
    case let s Some { *t = *t + s; }
    case None { *t = *t + 1000; }
  }
}

// -------- match a, b --------

fn light(l Lamp, up bool) i32 {
  match l, up {
    case Red, true { 1 }
    case Red, false { 2 }
    case Green, _ { 3 }
    case Blink, _ { 4 }
  }
}

// The last two cases cover what is left of every lamp, each for one value of 'up'
fn lastRow(l Lamp, up bool) i32 {
  match l, up {
    case Red, true { 1 }
    case _, false { 2 }
    case _, true { 3 }
  }
}

// A column of numbers cannot be counted, so the match ends in 'else'
fn withInt(n i32, up bool) i32 {
  match n, up {
    case 0, true { 1 }
    case 0, false { 2 }
    case _, true { 3 }
    else { 4 }
  }
}

// A guarded case may fail, so the cases after it cover the lamp
fn guarded(l Lamp, up bool, k i32) i32 {
  match l, up {
    case Red, _ if k > 0 { 1 }
    case Red, _ { 2 }
    case Green, _ { 3 }
    case Blink, _ { 4 }
  }
}

// The first two cases test a character, so they cover nothing; the rest cover each lamp
fn scan(l Lamp, c char) i32 {
  match l, c {
    case Red, 'G' { 1 }
    case Red or Green, 'A' .. 'F' { 2 }
    case Red, _ { 3 }
    case Green, _ { 4 }
    case Blink, _ { 5 }
  }
}

fn next(c &mut i32) i32 {
  *c = *c + 1;
  *c
}

// The values are evaluated once each, in the order written
fn order() i32 {
  var n i32 = 0;
  let r = match next(&mut n), next(&mut n) {
    case 1, 2 { 10 }
    else { 0 }
  };
  r + 100 * n
}

fn main() i32 {
  // 0 + 1, + 10, + 100 * 2
  show("tally");
  var t i32 = 0;
  tally(Red, &mut t); num(t);
  tally(Green, &mut t); num(t);
  tally(Blink(2), &mut t); num(t);
  end();

  let c Shape = Shape.Circle(4);
  let r Shape = Shape.Rect(2, 3);
  let d Shape = Shape.Dot;
  show("or");
  num(orCover(&imm c)); num(orCover(&imm r)); num(orCover(&imm d));
  end();

  // yesNo 1 0, notB false and true as 0 1, anyBool 9 9, bump 5 then 5 + 1
  show("bool");
  num(yesNo(true)); num(yesNo(false));
  num(yesNo(notB(true))); num(yesNo(notB(false)));
  num(anyBool(true)); num(anyBool(false));
  var n i32 = 0;
  bump(true, &mut n); num(n);
  bump(false, &mut n); num(n);
  end();

  show("matrix");
  num(light(Red, true)); num(light(Red, false)); num(light(Green, true)); num(light(Blink(9), false));
  num(lastRow(Red, true)); num(lastRow(Red, false)); num(lastRow(Green, true)); num(lastRow(Blink(1), false));
  num(withInt(0, true)); num(withInt(0, false)); num(withInt(5, true)); num(withInt(5, false));
  end();

  show("guard");
  num(guarded(Red, true, 1)); num(guarded(Red, true, 0)); num(guarded(Green, false, 0));
  end();

  // Red with G, Green with C, Red with C (the range), Red and Green with z, Blink with G
  show("scan");
  num(scan(Red, 'G')); num(scan(Green, 'C')); num(scan(Red, 'C'));
  num(scan(Red, 'z')); num(scan(Green, 'z')); num(scan(Blink(1), 'G'));
  end();

  // 1 then 2: the first case; and n is 2, so 10 + 200
  show("order");
  num(order());
  end();

  // Some(5) adds 5, then None adds 1000
  show("option");
  var o i32 = 0;
  optTally(Some(5), &mut o); num(o);
  optTally(None, &mut o); num(o);
  end();
  0i32
}
