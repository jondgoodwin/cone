// A name that is a reference others may share ('&', '&mut') is narrowed through a reference
// the compiler declares where the test was made, which the loan walk follows as it follows
// any reference narrowed into a variant (enum_flow_narrow_shared): refused only if
// something could change which variant the enum holds while the name is used as the
// variant. A call handed another name for the enum, a store through one, a swap, and a
// call whose body cannot be seen are such changes (the call or store that cannot reach
// the enum is none: enum_flow_typing_refs). The refusal is at the use that is stale, and
// says the change.

mod enum_flow_typing_reshape;

enum Shape {
  struct Circle { pub radius i32; }
  struct Rect { pub w i32; pub h i32; }
}
use Shape;

fn reset(s &mut Shape) { *s = Shape.Rect(0, 0); }

// A call handed another name for the enum
fn otherName(s &mut Shape, t &mut Shape) i32 {
  if s is Circle {
    reset(t);
    return s.radius;                   //~ ErrorVariantReshape "`s` may no longer be a Circle here: the call at"
  }
  return 0;
}

// ... a store through it
fn storeOther(s &mut Shape, t &mut Shape) i32 {
  if s is Circle {
    *t = Shape.Rect(1, 1);
    return s.radius;                   //~ ErrorVariantReshape "`s` may no longer be a Circle here: the store at"
  }
  return 0;
}

// ... a swap
fn swapOther(s &mut Shape, t &mut Shape, v Shape) i32 {
  mut u = v;
  if s is Circle {
    *t <=> u;
    return s.radius;                   //~ ErrorVariantReshape "`s` may no longer be a Circle here"
  }
  return 0;
}

// ... a call whose body cannot be seen
extern fn mystery(s &mut Shape);

fn unseen(s &mut Shape) i32 {
  if s is Circle {
    mystery(s);
    return s.radius;                   //~ ErrorVariantReshape "its body is not visible here"
  }
  return 0;
}

// ... after a branch that left, and in a match arm
fn afterExit(s &mut Shape, t &mut Shape) i32 {
  if s is Rect { return 0; }
  reset(t);
  return s.radius;                     //~ ErrorVariantReshape "`s` may no longer be a Circle here"
}

fn inMatch(s &mut Shape, t &mut Shape) i32 {
  match s {
    case Circle {
      reset(t);
      return s.radius;                 //~ ErrorVariantReshape "`s` may no longer be a Circle here"
    }
    case Rect { return 0; }
  }
}

// ... and through a loop: the next pass reads the radius of what a pass before changed
fn inLoop(s &mut Shape, t &mut Shape) i32 {
  mut n = 0;
  mut total = 0;
  if s is Circle {
    while n < 3 {
      total += s.radius;               //~ ErrorVariantReshape "`s` may no longer be a Circle here"
      reset(t);
      n += 1;
    }
  }
  return total;
}
