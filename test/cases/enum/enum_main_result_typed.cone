// A 'main' returning a Result whose error is a typed error meeting core's Error (not an
// AnyError) prints it through the trait's report(): 'Error: ', the error's toText and
// each cause under it, to stderr, the exit status 1. The error types here are core's
// alone (no String, no collections): toText writes into the writer it is given.

mod enum_main_result_typed;

import stdio use *;

struct Bus is Error {
  pub unit: u32;
  pub fn toText(self: &, out: &uni TextOut) { out <- "bus ", unit, " stalled"; }
}

struct Driver is Error {
  pub cause: Bus;
  pub fn toText(self: &, out: &uni TextOut) { out <- "driver gave up"; }
  pub fn source(self: &) Option[&<Error] { Some[&<Error](&cause) }
}

fn start() Result[i32, Driver] {
  Err[i32, Driver](Driver(Bus(7u32)))
}

fn main() Result[void, Driver] {
  printStr("start\n");
  let v = start()?;
  printStr("never printed\n");
  Ok(nil)
}
