// A cursor whose inline 'next' returns an Option of a value, consumed by a
// loop over a slice of i64. Compiled as a library (cases.toml), the optimized IR
// shows whether LLVM made it the counted loop that 'sum' below is.

mod enum_payload_loop_option;

pub struct ValCursor['a] {
  arr &'a Array[i64];
  pos usize;
  pub fn next(self &mut) Option[i64] inline {
    if pos >= arr.len { return None[i64][]; }
    imm v = arr[pos];
    pos = pos + 1;
    Some[i64][v];
  }
}

pub fn sumVal(a &Array[i64]) i64 {
  mut c = new ValCursor(a, 0usize);
  mut s = 0i64;
  while true {
    match c.next() {
      case imm e Some {s = s + e;}
      case is None {break;}
    }
  }
  s;
}
