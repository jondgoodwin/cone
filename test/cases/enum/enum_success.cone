// What an enum is: a closed set of variants, with or without payloads, plus the
// pattern matching that recovers which variant a value is.
//
// Everything is printed, because a match that compiles is not a match that
// dispatched to the right arm. The enums here carry no abstract methods: a
// requirement on the enum and the virtual reference that dispatches it are
// trait's subject, and this group needs only enough reference to have something
// to match on.

mod enum_success;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showB(label &[]u8, b Bool) {
  show(label, if b {1;} else {0;});
}

// -------- declaring an enum --------

// A field declared on the enum itself is present in every variant, at the same
// offset, so it can be read from a value whose variant is not yet known.
enum Shape {
  pub kind i32;

  struct Circle {
    pub radius i32;
  }

  struct Rect {
    pub w i32;
    pub h i32;
  }
}

// A variant is a name of its enum, 'Shape.Circle', and a module that wants the
// variants bare says so with 'use'. Every enum in this program is followed by
// one; "naming a variant" below writes them qualified instead.
use Shape;

// An enum with no common field at all, whose variants hold different numbers of
// fields of different types: the tag alone tells them apart, and every variant
// is padded out to the size of the largest.
enum Signal {
  struct Halt {}

  struct Step {
    pub amount i32;
  }

  struct Drift {
    pub rateX f32;
    pub rateY f32;
  }
}
use Signal;

// -------- the payload-free form --------

// A bare name is an empty struct variant. That is what makes one construct serve
// a plain set of named symbols as well as a set carrying payloads, and it is why
// there is no second construct to learn. Tag values run ascending from zero.
enum PhoneType {
  Home, Work, Mobile;
}
use PhoneType;

// The integer type an enum lays its tag values out in, with the values written
// rather than assigned -- which is what lines an enum up with an external
// library's constants. Numbering resumes from the last value written, so Cyan
// follows Blue.
enum Colors u32 {
  Red   = 0xFF0000,
  Green = 0x00FF00,
  Blue  = 0x0000FF,
  Cyan;
}
use Colors;

// An enum that declares no integer type widens its tag to fit its largest value,
// however few variants it has. Two variants would fit a byte, but 0x100 does not,
// so Wide's tag is laid out in two; a one-byte tag would hold Broad as 0, which
// is Narrow's tag, and the comparisons below would say Broad is Narrow. The width
// itself is asserted by a named check in cases.toml.
enum Wide {
  Narrow,
  Broad = 0x100;
}
use Wide;

// An enum compares for equivalence and never for order: which variant a value
// holds is what a comparison can answer, and declaration order is not a
// magnitude. Reading the discriminant answers it whole here, because every
// variant is empty and the value is the tag.
fn payloadFree() {
  mut p PhoneType = Work[];
  showB("payload-free-equal", p == Work[]);
  showB("payload-free-unequal", p == Home[]);
  showB("payload-free-not-equal-op", p != Home[]);

  // A variable of the enum accepts any of its variants
  p = Mobile[];
  showB("payload-free-reassigned", p == Mobile[]);

  // 'is' tests the variant without comparing two values
  showB("payload-free-is", p is Mobile);
  showB("payload-free-is-other", p is Home);

  // A pinned value is still a tag: what the language can observe is which
  // variant a value holds, and the width it is laid out in is asserted by a
  // named check in cases.toml rather than from here.
  mut c Colors = Green[];
  showB("pinned-tag-equal", c == Green[]);
  showB("pinned-tag-unequal", c == Red[]);
  c = Cyan[];
  showB("pinned-tag-numbering-resumed", c == Cyan[]);

  // A tag past a byte, in an enum that declared no type to hold it
  mut w Wide = Broad[];
  showB("widened-tag-equal", w == Broad[]);
  showB("widened-tag-not-first", w == Narrow[]);
}

// -------- what a pinned tag value costs --------

// A pinned value is free everywhere the tag is only compared. It costs at the one
// place the tag is used as more than a comparison: building a virtual reference
// from a plain one has to select the variant's vtable, and the vtable list holds
// one entry per variant, so a tag of 0x2000 cannot index it. Dispatch compares
// against each variant's value instead. Nothing about the call changes, which is
// what these lines assert -- and they are the only coverage of that path, so a
// regression in it shows up as the wrong implementation being reached.
enum Signals u32 {
  pub fn weight(self &) i32;

  pub struct Quiet = 0x10 {
    pub n i32;
    fn weight(self &) i32 {n;}
  }

  pub struct Loud = 0x2000 {
    pub n i32;
    fn weight(self &) i32 {n * 100;}
  }
}
use Signals;

// Dispatch through a plain reference, which is where the compiler inserts the
// coercion to a virtual reference and therefore where the tag selects a vtable
fn weigh(s &Signals) i32 {
  s.weight();
}

fn sparseTagDispatch() {
  imm quiet Signals = Quiet[3];
  imm loud Signals = Loud[5];
  show("sparse-tag-dispatch-first", weigh(&quiet));
  show("sparse-tag-dispatch-second", weigh(&loud));

  // ... and through a virtual reference written by hand, which reaches the same
  // selection from the other side
  imm vq &<Signals = &quiet;
  imm vl &<Signals = &loud;
  show("sparse-tag-vref-first", vq.weight());
  show("sparse-tag-vref-second", vl.weight());

  // A sparse tag still narrows back to the variant it names
  show("sparse-tag-matches", which(&quiet));
  show("sparse-tag-matches-other", which(&loud));
}

fn which(s &Signals) i32 {
  match s {
    case is &Quiet {1;}
    case is &Loud {2;}
  }
}

// A generic enum that declares no integer type widens its discriminant to its
// largest tag value exactly as a plain one does. 256 is the value that proves it:
// a one-byte tag would hold it as 0, the tag of the first variant, and the match
// below would take the wrong arm without any complaint.
enum Pinned[T] {
  struct PinnedLow {pub v T;}
  struct PinnedHigh = 256 {}
}
use Pinned;

fn whichPinned(p &Pinned[i32]) i32 {
  match p {
    case is &PinnedLow[i32] {1;}
    case is &PinnedHigh[i32] {2;}
  }
}

fn genericPinnedTag() {
  imm low Pinned[i32] = PinnedLow[i32][7];
  imm high Pinned[i32] = PinnedHigh[i32][];
  show("generic-pinned-tag-first", whichPinned(&low));
  show("generic-pinned-tag-wide", whichPinned(&high));
}

// A static function of a generic enum is the enum's own, as a trait's is, so
// each instance generates its copy. Generation once gave an instance's static
// function a body and no symbol, and building any variant of the enum crashed
// the compiler. Nothing here calls it: the declaration is the case.
enum Stocked[T] {
  pub count i32;
  fn restock() i32 {30;}
  struct Full {pub item T;}
  struct Out {}
}

fn stockedItem(s Stocked[i64]) i64 {
  match s {
    case imm f Full {f.item + i64[f.count];}
    case is Out {0i64;}
  }
}

// Called bare, from a common method or a variant's method, the enum's static
// function is the instance's copy, and so is a variant's own, declared after
// the method naming it. Each use was bound to the generic's member, which is
// never generated, and the call to it crashed the compiler.
enum Restocked[T] {
  pub count i32;
  fn restock() i32 {30;}
  pub fn reorder(self &) i32 {restock() + count;}
  struct Shelved {
    pub item T;
    pub fn topUp(self &) i32 {restock() + shelf();}
    fn shelf() i32 {2;}
  }
  struct Sold {}
}

fn genericStaticFn() {
  show("generic-enum-with-static-fn", stockedItem(Stocked.Full[i64][4, 9]));
  imm s = Restocked.Shelved[i64][4, 9];
  imm o Restocked[i64] = Restocked.Sold[i64][5];
  show("generic-enum-static-fn-from-variant", i64[(&s).topUp()]);
  show("generic-enum-static-fn-from-common-method", i64[(&s).reorder()]);
  show("generic-enum-static-fn-from-common-method-on-enum", i64[(&o).reorder()]);
}

// -------- common members anywhere in the body --------

// What makes a member common is its kind, not its position: a 'struct' is a
// variant and anything else is common. So a common field or method may be
// written after a variant, which a positional rule would read as part of that
// variant or drop silently. The layout still puts common fields first in every
// variant, which is what the positional initializers below rely on.
enum Reading {
  struct Spot { pub at i32; }

  pub scale i32;

  struct Span { pub len i32; }

  pub fn scaled(self &) i32 {scale * 2;}
}
use Reading;

fn commonMembersAnywhere() {
  mut s = Spot[3, 7];
  mut n = Span[4, 9];
  show("common-field-declared-after-a-variant", s.scale);
  show("own-field-after-the-common-one", s.at);
  show("common-field-in-the-later-variant", n.scale);
  show("common-method-declared-last", (&s).scaled());
}

// -------- placing the discriminant --------

// An enum may place its own discriminant, which is done for alignment: the field
// is written as type 'tag' and must be anonymous. Every variant's positional
// initializer then supplies the common fields in the same order, with the tag
// still supplied by the variant rather than by the caller.
//
// 'tag' is recognized only where a field's type is written, so it is not a
// reserved word: 'pub tag i32' elsewhere in the suite still declares a field
// named 'tag'.
enum Aligned {
  pub wide i64;
  _ tag;

  struct Small { pub n i32; }
  struct Large { pub a i64; pub b i64; }
}
use Aligned;

fn widthOf(a &Aligned) i32 {
  match a {
    case is &Small {4;}
    case is &Large {16;}
  }
}

fn placedDiscriminant() {
  mut small = Small[5i64, 3];
  mut large = Large[6i64, 7i64, 8i64];
  show("placed-tag-common-field", i64[small.wide]);
  show("placed-tag-own-field", small.n);
  show("placed-tag-other-variant", i64[large.a + large.b]);
  show("placed-tag-matches", widthOf(&small));
  show("placed-tag-matches-other", widthOf(&large));
}

// -------- declining the padding --------

// '@unsized' declines the padding, so the enum has no one size and is reached
// only through a reference. Its variants keep the tag and the common fields, so
// matching and reading a common field work exactly as they do padded; what is
// given up is holding a value of the enum in a variable, copying it and passing
// it by value. enum_typecheck_unsized holds those refusals.
enum @unsized Packet {
  pub id i32;

  struct Ping {}
  struct Payload { pub a i64; pub b i64; pub c i64; }
}
use Packet;

fn packetSize(p &Packet) i32 {
  match p {
    case is &Ping {0;}
    case imm d &Payload {i32[d.a + d.b + d.c];}
  }
}

// A common field is readable through a reference to the enum without knowing the
// variant, which is what the tag and the shared prefix buy even unpadded
fn readId(p &Packet) i32 {
  p.id;
}

fn unsizedEnum() {
  imm ping = Ping[1];
  imm payload = Payload[2, 3i64, 4i64, 5i64];
  show("unsized-empty-variant", packetSize(&ping));
  show("unsized-payload-variant", packetSize(&payload));
  show("unsized-common-field-through-ref", readId(&payload));
}

// An enum that extends another is enum_extends' subject: its copies of the base's
// variants, and the layout each of the two then has, are asserted there.

// -------- constructing and reading --------

fn construction() {
  // A variant is constructed by naming the variant, not the enum. Its
  // positional initializer starts with the enum's common field.
  mut c = Circle[1, 5];
  mut r = Rect[2, 3, 4];
  show("variant-common-field", c.kind);
  show("variant-own-field", c.radius);
  show("other-variant-common-field", r.kind);
  show("other-variant-own-field", r.w * r.h);

  // The common field is writable through the variant
  c.kind = 7;
  show("common-field-assigned", c.kind);

  // A variant with no fields of its own still constructs, and an enum with no
  // common field is still told apart by its tag
  mut h = Halt[];
  mut st = Step[9];
  mut d = Drift[1.5, 2.5];
  show("empty-variant-matched", stride(&h));
  show("sibling-variant-matched", stride(&st));
  show("float-variant-matched", stride(&d));
}

// An enum whose variants share no field at all: only the tag distinguishes them.
// The conversion is here because show prints integers, not because an enum
// needs one.
fn stride(s &Signal) i32 {
  match s {
    case imm h &Halt {0;}
    case imm t &Step {t.amount;}
    case imm d &Drift {i32[d.rateX + d.rateY];}
  }
}

// -------- the enum type itself --------

// An enum may be passed by value: the parameter is one variant's worth of
// storage, and only the common field is readable without matching.
fn kindOf(s Shape) i32 {
  s.kind;
}

// A value of the enum keeps every byte any variant uses, whichever variant it
// holds. Flag's two small fields sit where Count has padding before its i32, and
// Tally, the largest, is byte-aligned where Count is not, so the one size every
// variant is padded to is Tally's rounded up to Count's alignment.
enum Cell {
  struct Flag {pub on Bool; pub code u8;}
  struct Count {pub n i32;}
  struct Tally {pub a u8; pub b u8; pub c u8; pub d u8; pub e u8; pub f u8; pub g u8; pub h u8; pub i u8;}
}
use Cell;

fn cellValue(c Cell) i32 {
  match c {
    case imm f Flag {if f.on {i32[f.code];} else {-1;};}
    case imm n Count {n.n;}
    case imm t Tally {i32[t.i];}
  }
}

fn enumValues() {
  mut c = Circle[1, 5];
  mut r = Rect[2, 3, 4];

  // An enum-typed variable accepts either variant, and accepts a different one
  // later, because every variant is the same size
  mut s Shape = c;
  show("enum-var-holds-circle", s.kind);
  s = r;
  show("enum-var-reassigned-to-rect", s.kind);

  show("enum-passed-by-value", kindOf(c));
  show("enum-passed-by-value-other", kindOf(r));
  show("enum-by-value-keeps-fields-in-anothers-padding", cellValue(Flag[true, 7u8]));
  show("enum-by-value-keeps-the-aligned-variant", cellValue(Count[40]));
  show("enum-by-value-keeps-the-largest-variant", cellValue(Tally[1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8]));

  // Two branches of differing variant type infer the enum as their common
  // supertype, both by value and by reference
  imm byValue = if true {c;} else {r;};
  show("supertype-inferred-by-value", byValue.kind);
  imm byRef = if false {&c;} else {&r;};
  show("supertype-inferred-by-ref", byRef.kind);

  // A reference to an enum is stated the same way as any other reference
  imm sref &Shape = &r;
  show("enum-reference-common-field", sref.kind);
}

// -------- matching --------

// Matching every variant of a closed enum is exhaustive, so the match is a
// value-producing expression with no 'else' clause
fn area(s &Shape) i32 {
  match s {
    case imm c &Circle {c.radius * c.radius;}
    case imm r &Rect {r.w * r.h;}
  }
}

// 'case is' tests the variant without binding a name to the narrowed value
fn isRect(s &Shape) i32 {
  match s {
    case is &Rect {1;}
    else {0;}
  }
}

// An arm that does not name every variant needs an 'else' to be exhaustive
fn radiusOr(s &Shape, dflt i32) i32 {
  match s {
    case imm c &Circle {c.radius;}
    else {dflt;}
  }
}

// A bound variable may be 'mut', which writes through to the matched value.
// The parameter is '&mut Shape' rather than '&mut Circle' because a mutable
// reference to a variant does not coerce to one to the enum.
fn grow(s &mut Shape) {
  match s {
    case mut c &mut Circle {c.radius = c.radius + 10;}
    case mut r &mut Rect {r.w = r.w + 10;}
  }
}

// The single-pattern form of a match is an 'if' whose condition binds
fn circleRadius(s &Shape) i32 {
  if imm c &Circle = s {
    c.radius;
  } else {
    0;
  }
}

fn matching() {
  mut c = Circle[1, 5];
  mut r = Rect[2, 3, 4];
  show("match-dispatch-circle", area(&c));
  show("match-dispatch-rect", area(&r));
  show("match-is-circle", isRect(&c));
  show("match-is-rect", isRect(&r));
  show("match-else-arm-taken", radiusOr(&r, 99));
  show("match-named-arm-taken", radiusOr(&c, 99));
  show("if-binding-taken", circleRadius(&c));
  show("if-binding-not-taken", circleRadius(&r));

  mut sc Shape = c;
  mut sr Shape = r;
  grow(&mut sc);
  grow(&mut sr);
  show("mut-binding-writes-through-circle", radiusOr(&sc, 99));
  show("mut-binding-writes-through-rect", area(&sr));
}

// -------- matching through a type alias --------

// A typedef is a transparent alias and nothing rewrites it away, so a pattern
// spelled through one has to name the same variant the concrete spelling names.
// Exhaustiveness is where that shows: a match naming every variant needs no
// 'else', and it is the exhaustiveness check that has to see through the alias.
// It did not -- it read the reference's target off the name use rather than off
// the type the name resolves to, which yields the reference type itself, so no
// arm ever matched a variant and the match was refused as a value-producing
// expression. Every spelling is paired with the concrete one above, because a
// match that compiles is not a match that dispatched to the right arm.

typedef CircleRef &Circle;
typedef RectRef &Rect;
typedef CircleRefAgain CircleRef;
typedef CircleMut &mut Circle;
typedef RectMut &mut Rect;
typedef CircleVal Circle;
typedef RectVal Rect;

// The same match as 'area', with both arms spelled through an alias
fn areaAlias(s &Shape) i32 {
  match s {
    case imm c CircleRef {c.radius * c.radius;}
    case imm r RectRef {r.w * r.h;}
  }
}

// An alias of an alias, followed to its end
fn areaAliasOfAlias(s &Shape) i32 {
  match s {
    case imm c CircleRefAgain {c.radius * c.radius;}
    case imm r RectRef {r.w * r.h;}
  }
}

// One arm concrete and one aliased: exhaustiveness has to account for both
fn areaMixedSpelling(s &Shape) i32 {
  match s {
    case imm c &Circle {c.radius * c.radius;}
    case imm r RectRef {r.w * r.h;}
  }
}

// 'case is', which binds no name, through an alias
fn whichAlias(s &Shape) i32 {
  match s {
    case is CircleRef {1;}
    case is RectRef {2;}
  }
}

// A 'mut' binding through an alias of '&mut Variant', which writes through
fn growAlias(s &mut Shape) {
  match s {
    case mut c CircleMut {c.radius = c.radius + 10;}
    case mut r RectMut {r.w = r.w + 10;}
  }
}

// Matched by value, where the alias names the variant struct rather than a
// reference to it. This spelling was already right, and is here as the control
// on the two that were not.
fn whichValueAlias(s Shape) i32 {
  match s {
    case imm c CircleVal {1;}
    case imm r RectVal {2;}
  }
}

// The single-pattern 'if' form
fn circleRadiusAlias(s &Shape) i32 {
  if imm c CircleRef = s {
    c.radius;
  } else {
    0;
  }
}

// A match that names one variant is not exhaustive however it is spelled, so
// the 'else' is still required
fn radiusOrAlias(s &Shape, dflt i32) i32 {
  match s {
    case imm c CircleRef {c.radius;}
    else {dflt;}
  }
}

fn aliasMatching() {
  mut c = Circle[1, 5];
  mut r = Rect[2, 3, 4];
  show("alias-match-circle", areaAlias(&c));
  show("alias-match-rect", areaAlias(&r));
  show("alias-of-alias-match", areaAliasOfAlias(&c));
  show("alias-mixed-with-concrete", areaMixedSpelling(&r));
  show("alias-case-is-circle", whichAlias(&c));
  show("alias-case-is-rect", whichAlias(&r));
  show("alias-by-value-circle", whichValueAlias(c));
  show("alias-by-value-rect", whichValueAlias(r));
  show("alias-if-binding-taken", circleRadiusAlias(&c));
  show("alias-if-binding-not-taken", circleRadiusAlias(&r));
  show("alias-else-arm-taken", radiusOrAlias(&r, 99));
  show("alias-named-arm-taken", radiusOrAlias(&c, 99));

  mut sc Shape = c;
  mut sr Shape = r;
  growAlias(&mut sc);
  growAlias(&mut sr);
  show("alias-mut-binding-writes-through-circle", radiusOrAlias(&sc, 99));
  show("alias-mut-binding-writes-through-rect", areaAlias(&sr));
}

// A match on a value rather than a variant compares with '=='
fn classify(n i32) i32 {
  match n {
    case ==0 {100;}
    case ==1 {200;}
    else {300;}
  }
}

// A comparison pattern writes the operator and its right operand only: the
// matched value is the left one. Every comparison operator is one.
fn sign(n i32) i32 {
  match n {
    case <0 {-1;}
    case >0 {1;}
    else {0;}
  }
}

fn band(n i32) i32 {
  match n {
    case <=-5 {1;}
    case >=5 {2;}
    case !=0 {3;}
    else {4;}
  }
}

// A range tests both ends: '..' leaves its end out and '...' takes it in. A
// bound is an expression like any operand.
fn ranged(n i32, top i32) i32 {
  match n {
    case 0 .. 3 {1;}
    case 3 ... 6 {2;}
    case -3..0 {3;}
    case 7 .. top + 1 {4;}
    else {0;}
  }
}

// Patterns joined by 'or' match when any one of them does, a range among them
fn primeOrNear(n i32) i32 {
  match n {
    case ==2 or ==3 or ==5 or ==7 {2;}
    case ==-6 or -1...1 or ==6 {1;}
    case < -100 or >100 {9;}
    else {0;}
  }
}

// An 'if' guard after the pattern must hold too. When it does not, the cases
// after it are tried, so the unguarded one below catches the rest.
fn guarded(nbr i32, cnt i32) i32 {
  match nbr {
    case ==4 if cnt > 0 {0;}
    case ==4 {1;}
    else {2;}
  }
}

// A bound pattern's guard reads the variable the pattern binds. A guarded arm
// may fail, so it does not account for its variant: the unguarded 'Some' after
// it does, and with 'None' that makes the match a value without an 'else'.
fn positiveOr(o Option[i32]) i32 {
  match o {
    case imm x Some if x.value > 0 {x.value;}
    case imm x Some {0 - x.value;}
    case is None {1000;}
  }
}

// Through a reference, and on an 'is' pattern joined by 'or'
fn wideCircle(s &Shape) i32 {
  match s {
    case imm c &Circle if c.radius > 10 {c.radius * 2;}
    case imm c &Circle {c.radius;}
    case imm r &Rect if r.w == r.h {100;}
    else {0;}
  }
}

fn moving(s &Signal) i32 {
  match s {
    case is &Step or is &Drift {1;}
    else {0;}
  }
}

// A generic function's match is cloned into each instance, guard and all
fn pickOver[T](o Option[T], floor T) T {
  match o {
    case imm s Some if s.value > floor {s.value;}
    else {floor;}
  }
}

fn inBand[T](x T, lo T, hi T) i32 {
  match x {
    case lo .. hi or ==hi {1;}
    else {0;}
  }
}

fn valueMatching() {
  show("value-match-first", classify(0));
  show("value-match-second", classify(1));
  show("value-match-else", classify(9));

  show("compare-less", sign(-5));
  show("compare-equal-falls-to-else", sign(0));
  show("compare-greater", sign(7));
  show("compare-at-most", band(-5));
  show("compare-at-least", band(5));
  show("compare-not-equal", band(1));
  show("compare-none-hold", band(0));

  show("range-exclusive-start", ranged(0, 9));
  show("range-exclusive-inside", ranged(2, 9));
  show("range-exclusive-end-is-next-range", ranged(3, 9));
  show("range-inclusive-end", ranged(6, 9));
  show("range-negative-start", ranged(-3, 9));
  show("range-below-all", ranged(-4, 9));
  show("range-computed-bound-inside", ranged(9, 9));
  show("range-computed-bound-past", ranged(10, 9));

  show("or-first-alternative", primeOrNear(2));
  show("or-last-alternative", primeOrNear(7));
  show("or-none", primeOrNear(4));
  show("or-range-alternative", primeOrNear(0));
  show("or-after-range", primeOrNear(6));
  show("or-comparisons-low", primeOrNear(-101));
  show("or-comparisons-high", primeOrNear(101));

  show("guard-holds", guarded(4, 1));
  show("guard-fails-next-case", guarded(4, 0));
  show("guard-pattern-fails", guarded(3, 1));

  show("bound-guard-holds", positiveOr(Some[5]));
  show("bound-guard-fails", positiveOr(Some[-5]));
  show("bound-guard-other-variant", positiveOr(None[i32][]));

  mut big Shape = Circle[0, 20];
  mut small Shape = Circle[0, 5];
  mut square Shape = Rect[0, 3, 3];
  mut oblong Shape = Rect[0, 3, 4];
  show("ref-guard-holds", wideCircle(&big));
  show("ref-guard-fails", wideCircle(&small));
  show("ref-guard-second-variant", wideCircle(&square));
  show("ref-guard-to-else", wideCircle(&oblong));

  mut halt Signal = Halt[];
  mut step Signal = Step[2];
  mut drift Signal = Drift[1., 2.];
  show("or-is-first", moving(&step));
  show("or-is-second", moving(&drift));
  show("or-is-neither", moving(&halt));

  show("generic-guard-holds", pickOver(Some[7], 3));
  show("generic-guard-fails", pickOver(Some[2], 3));
  show("generic-guard-other-type", pickOver(Some[9i64], 3i64));
  show("generic-range-inside", inBand(3, 1, 5));
  show("generic-range-or-end", inBand(5, 1, 5));
  show("generic-range-past", inBand(6, 1, 5));
  show("generic-range-float", inBand(2.5, 1., 5.));
}

// -------- Option and Result --------

// Option[T] and Result[T,E] are enums declared by the core library, so they
// match exactly like an enum declared here. Their variants are bare with no
// 'use' written here: core writes 'pub use Option;' and 'pub use Result;', and
// every module's automatic import of core carries a public fold on.
fn unwrapOr(o Option[i32], dflt i32) i32 {
  match o {
    case imm s Some[i32] {s.value;}
    case imm n None[i32] {dflt;}
  }
}

fn signedResult(r Result[i32, i32]) i32 {
  match r {
    case imm k Ok[i32, i32] {k.value;}
    case imm e Error[i32, i32] {0 - e.value;}
  }
}

// A Bool beside a tag is at byte 1, where the i32 variant has padding
fn boolResult(r Result[Bool, i32]) i32 {
  match r {
    case imm k Ok[Bool, i32] {if k.value {1;} else {2;};}
    case imm e Error[Bool, i32] {3;}
  }
}

// An Option whose value type is itself an Option, so the type argument is a
// generic instantiation rather than a plain type. That is the only thing
// separating this from 'unwrapOr' above, and it was once recorded as a defect
// that would not compile.
fn unwrapNested(o Option[Option[i32]], dflt i32) i32 {
  match o {
    case imm s Some[Option[i32]] {unwrapOr(s.value, dflt);}
    case imm n None[Option[i32]] {dflt;}
  }
}

// Option reached by reference rather than by value. '&Option[i32]' is a type of
// a generic instantiation, which used not to parse as one because a borrow
// consumed only the bare name; the whole group matched by value for that reason.
fn unwrapRefOr(o &Option[i32], dflt i32) i32 {
  match *o {
    case imm s Some[i32] {s.value;}
    case imm n None[i32] {dflt;}
  }
}

fn optionAndResult() {
  show("option-some", unwrapOr(Some[7], 99));
  show("option-none", unwrapOr(None[i32][], 99));

  // Both branches of an 'if' infer Option as their supertype
  imm chosen = if true {Some[3];} else {None[i32][];};
  show("option-from-branches", unwrapOr(chosen, 99));

  // A declared Option variable accepts either variant
  mut opt Option[i32] = None[i32][];
  show("option-declared-none", unwrapOr(opt, 42));
  opt = Some[8];
  show("option-declared-reassigned", unwrapOr(opt, 42));

  show("result-ok", signedResult(Ok[i32, i32][5]));
  show("result-error", signedResult(Error[i32, i32][3]));
  show("result-bool-by-value", boolResult(Ok[Bool, i32][true]));

  imm held Option[i32] = Some[6];
  show("option-by-reference", unwrapRefOr(&held, 99));
  imm empty Option[i32] = None[i32][];
  show("option-by-reference-none", unwrapRefOr(&empty, 99));

  // An Option holding an Option, built the way the recorded defect spelled it
  imm nested Option[Option[i32]] = Some[Option[i32]][Some[4]];
  show("option-nested-outer", unwrapNested(nested, 99));
  imm nestedEmpty Option[Option[i32]] = Some[Option[i32]][None[i32][]];
  show("option-nested-inner-none", unwrapNested(nestedEmpty, 99));
}

// -------- naming a variant --------

// A variant is a name of its enum, so 'Enum.Variant' reaches it wherever the enum
// can be named, with no 'use' at all. Signs is folded by nothing in this program.
enum Signs {
  Plus, Minus;
}

// Two enums may each have a variant of one spelling, since each is a name of its
// own enum. Only a fold of both into one module would collide.
enum KeyEvent {
  Quit, Press;
}

enum WindowEvent {
  Quit, Resize;
}

fn signOf(s Signs) i32 {
  match s {
    case is Signs.Plus {1;}
    case is Signs.Minus {-1i32;}
  }
}

fn qualifiedArea(s &Shape) i32 {
  match s {
    case imm c &Shape.Circle {c.radius * c.radius * 3;}
    case imm r &Shape.Rect {r.w * r.h;}
  }
}

// The same variants bound by value. The 'is' test and the conversion that binds
// share the pattern's type node, and a path collapses by replacing the slot that
// held it, so the conversion must take the name the test's slot collapsed to.
// The guarded arm and the bound 'if' each hold a further conversion of it.
fn qualifiedAreaByValue(s Shape) i32 {
  match s {
    case imm c Shape.Circle if c.radius > 5 {0;}
    case imm c Shape.Circle {c.radius * c.radius * 3;}
    case imm r Shape.Rect {r.w * r.h;}
  }
}

fn qualifiedRadiusIf(s Shape) i32 {
  if imm c Shape.Circle = s {c.radius;} else {-1;}
}

fn quits(k KeyEvent, w WindowEvent) i32 {
  mut n = 0;
  if k is KeyEvent.Quit {n = n + 1;}
  if w is WindowEvent.Quit {n = n + 10;}
  n;
}

// A generic enum's variant, reached through the enum and instantiated as the bare
// name is
fn unwrapQualified(o Option[i32], dflt i32) i32 {
  match o {
    case imm s Option.Some[i32] {s.value;}
    case imm n Option.None[i32] {dflt;}
  }
}

fn namingVariants() {
  show("qualified-construct-and-match", signOf(Signs.Minus[]));
  imm c Shape = Shape.Circle[1, 2];
  imm r Shape = Shape.Rect[2, 3, 4];
  show("qualified-pattern-circle", qualifiedArea(&c));
  show("qualified-pattern-rect", qualifiedArea(&r));
  show("qualified-by-value-circle", qualifiedAreaByValue(c));
  show("qualified-by-value-rect", qualifiedAreaByValue(r));
  show("qualified-by-value-guarded", qualifiedAreaByValue(Shape.Circle[1, 6]));
  show("qualified-bound-if", qualifiedRadiusIf(c));
  show("qualified-bound-if-other", qualifiedRadiusIf(r));
  show("same-spelling-in-two-enums", quits(KeyEvent.Quit[], WindowEvent.Resize[]));
  show("same-spelling-other-enum", quits(KeyEvent.Press[], WindowEvent.Quit[]));
  show("qualified-generic-variant", unwrapQualified(Option.Some[5], 99));
  show("qualified-generic-empty", unwrapQualified(Option.None[i32][], 99));
  show("qualified-result", signedResult(Result.Error[i32, i32][6]));
}

// -------- a variant bare in a pattern --------

// A pattern knows the enum of the value it is matched against, so it names a
// variant of that enum bare with no 'use'. Nothing in this section is folded.
enum Season {
  Spring, Summer, Autumn, Winter;
}

enum Figure {
  struct Square {
    pub side i32;
  }

  struct Tri {
    pub base i32;
    pub height i32;
  }
}

fn warmth(s Season) i32 {
  match s {
    case is Summer {3;}
    case is Spring {2;}
    case is Autumn {1;}
    case is Winter {0;}
  }
}

// Through a reference, in every form a pattern takes: a 'case', a bound 'if'
// and its 'elif', and an 'is' test
fn figureArea(f &Figure) i32 {
  match f {
    case imm s &Square {s.side * s.side;}
    case imm t &Tri {t.base * t.height / 2;}
  }
}

fn figureWidth(f &Figure) i32 {
  if imm s &Square = f {s.side;}
  elif imm t &Tri = f {t.base;}
  else {0;}
}

fn isSquare(f &Figure) Bool {
  f is &Square;
}

// The matched value supplies a generic variant's type arguments: on an
// Option[i32], 'Some' is 'Some[i32]'. A generic enum declared here is matched the
// same way, with no 'use' of it.
enum Perhaps[T] {
  struct Surely {
    pub value T;
  }

  struct Nothing {}
}

fn someOr(o Option[i32], dflt i32) i32 {
  match o {
    case imm s Some {s.value;}
    case is None {dflt;}
  }
}

fn surelyOr(p Perhaps[i64], dflt i64) i64 {
  match p {
    case imm s Surely {s.value;}
    case is Nothing {dflt;}
  }
}

// In a generic function each instance's body looks the variant up in its own
// matched value's enum
fn someOrAny[T](o Option[T], dflt T) T {
  match o {
    case imm s Some {s.value;}
    else {dflt;}
  }
}

// The matched value's enum is asked first. Colors is folded into this module and
// has a Red too, but a Lamp is being matched, so 'Red' is the Lamp's. Its tag is
// not Colors.Red's, so the arm taken says which one was meant.
enum Lamp {
  Amber, Red;
}

fn lampCode(l Lamp) i32 {
  match l {
    case is Red {1;}
    case is Amber {2;}
  }
}

fn barePatterns() {
  show("bare-plain-enum", warmth(Season.Autumn[]));
  imm sq Figure = Figure.Square[4];
  imm tr Figure = Figure.Tri[6, 3];
  show("bare-case-through-ref", figureArea(&sq));
  show("bare-case-other-variant", figureArea(&tr));
  show("bare-bound-if", figureWidth(&sq));
  show("bare-bound-elif", figureWidth(&tr));
  showB("bare-is-test-true", isSquare(&sq));
  showB("bare-is-test-false", isSquare(&tr));
  show("bare-generic-args-from-value", someOr(Some[7], 99));
  show("bare-generic-empty", someOr(None[i32][], 99));
  show("bare-own-generic-enum", surelyOr(Perhaps.Surely[i64][8], 99));
  show("bare-own-generic-empty", surelyOr(Perhaps.Nothing[i64][], 99));
  show("bare-in-generic-function", someOrAny[i32](Some[11], 0));
  show("bare-in-generic-function-empty", someOrAny[i32](None[i32][], 12));
  show("bare-matched-enum-first", lampCode(Lamp.Red[]));
  show("bare-matched-enum-other", lampCode(Lamp.Amber[]));
}

// -------- folding some of the variants --------

// A 'use' may admit some of an enum's variants rather than all of them, rename
// one with 'as', spread its list over lines in a block, or take every variant
// 'but' some. What it leaves out is still reached through the enum.
enum Compass {
  North, East, South, West;
}
use Compass North as Up, South;

enum Level {
  Low, Mid, High;
}
use Level {
  Low,
  High as Top,
};

enum Weather {
  Sun, Rain, Snow;
}
use Weather but Snow;

fn heading(c Compass) i32 {
  match c {
    case is Up {1;}
    case is Compass.East {2;}
    case is South {3;}
    else {4;}
  }
}

fn height(l Level) i32 {
  match l {
    case is Low {1;}
    case is Level.Mid {2;}
    case is Top {3;}
  }
}

fn wetness(w Weather) i32 {
  match w {
    case is Sun {0;}
    case is Rain {1;}
    case is Weather.Snow {2;}
  }
}

fn foldingSome() {
  show("folded-under-a-new-name", heading(Up[]));
  show("folded-by-its-own-name", heading(South[]));
  show("left-out-reached-through-the-enum", heading(Compass.West[]));
  show("folded-in-a-block", height(Top[]));
  show("left-out-of-a-block", height(Level.Mid[]));
  show("folded-all-but", wetness(Rain[]));
  show("the-but-reached-through-the-enum", wetness(Weather.Snow[]));
}

// -------- a variant's body names its enum's other names bare --------

// Anything written inside an enum's braces sees every name the enum declares
// bare, and a variant's body is written there: a method of Traffic.Stop builds
// Go[5] with no 'Traffic.' and calls the enum's static bare, exactly as a method
// of Traffic itself would. Nothing here is folded with 'use', so outside the
// braces every one of these names is written through its enum.
enum Traffic {
  fn base() i32 {40;}

  struct Stop {
    pub fn next(self &) Traffic {Go[5];}
    pub fn pause(self &) i32 {base() + 2;}
  }

  struct Hold {
    // A match on a sibling, and an arm building one
    pub fn after(self &, t Traffic) Traffic {
      match t {
        case is Stop {Go[1];}
        else {Stop[];}
      }
    }
  }

  struct Go {
    // The variant's own names are the nearer scope, so 'Hold' in its method is
    // this field and not the sibling variant
    pub Hold i32;
    pub fn held(self &) i32 {Hold;}
  }
}

fn trafficCode(t Traffic) i32 {
  match t {
    case is Stop {1;}
    case is Hold {2;}
    case imm g Go {g.Hold * 10 + 3;}
  }
}

// A generic enum's variant carries the enum's parameters, so it names a sibling
// with them, as the enum's own methods do. A pattern's name written with its
// arguments is taken lexically rather than from the matched value, so 'Full[T]'
// in the match is reached only because it is written inside Slot's braces. The
// common field is bare too, though a generic variant's fields are spliced in only
// when an instance is type checked: the name binds to the enum's field, and a
// bare field is read through self either way.
//
// Each variant names the other, so one of them names a LATER sibling at its
// parameters: an instance's variants are all instantiated before any is type
// checked, so 'Empty[T]' in Full's body finds the instance already made rather
// than starting the whole enum again, endlessly (ErrorInstDepth).
enum Slot[T] {
  pub count i32;

  struct Full {
    pub item T;
    pub fn drain(self &) Slot[T] {Empty[T][count * 10];}
  }

  struct Empty {
    pub fn fill(self &, v T) Slot[T] {Full[T][count + 1, v];}
    pub fn itemOr(self &, s Slot[T], d T) T {
      match s {
        case imm f Full[T] {f.item;}
        else {d;}
      }
    }
  }
}

// Inside a generic enum's variant, a match with an arm for every variant of a
// value of the enum is exhaustive and needs no 'else': with the variants' type
// arguments written, bare, and through a reference, and in a method of the enum,
// which is copied into each variant. The instance lists all its variants before
// any variant's body is type checked, so the match is checked against the whole
// set, and a bare name finds its sibling in it.
enum Tote[T] {
  pub count i32;
  pub fn which(self &, t Tote[T]) i32 {
    match t {
      case is Stuffed[T] {5;}
      case is Hollow[T] {6;}
    }
  }

  struct Stuffed {
    pub item T;
    pub fn code(self &, t Tote[T]) i32 {
      match t {
        case is Stuffed[T] {1;}
        case imm h Hollow[T] {h.count + 20;}
      }
    }
    pub fn codeBare(self &, t Tote[T]) i32 {
      match t {
        case is Stuffed {3;}
        case imm h Hollow {h.count + 40;}
      }
    }
    // The enum's bare name is this instance, so the parameter's type is bare too
    pub fn codeAllBare(self &, t Tote) i32 {
      match t {
        case is Stuffed {7;}
        case imm h Tote.Hollow {h.count + 70;}
      }
    }
  }

  struct Hollow {
    pub fn itemOr(self &, t &Tote[T], d T) T {
      match t {
        case imm s &Stuffed[T] {s.item;}
        case is &Hollow[T] {d;}
      }
    }
  }
}

// Inside a generic enum's braces -- its own methods and statics, and every
// variant's body -- the enum's bare name is the instance being defined, and so is
// a variant's: in Grove[i64], 'Grove' is Grove[i64], and 'Idle' and 'Grove.Idle'
// are Grove.Idle[i64]. So a variant names its enum and builds a sibling with no
// type arguments, where Slot above writes them out. Each bare name reaches the
// instance being cloned, never a second instantiation: 'Idle' in Fruiting's body
// names the LATER sibling, which is instantiated with the enum rather than again.
// The static 'sow' builds a variant bare and is reached from the enum's own
// check, as Crop's below is with its arguments written, and Idle's 'weigh'
// matches a parameter typed bare, exhaustively, with its variants bare.
enum Grove[T] {
  pub rows i64;
  pub fn sow(r i64) Grove {Idle[r];}

  struct Fruiting {
    pub grain T;
    pub fn reap(self &) Grove {Grove.Idle[rows + 1];}
    pub fn keep(self &) Fruiting {Fruiting[rows * 2, grain];}
  }

  struct Idle {
    pub fn plant(self &, y T) Grove {Fruiting[rows + 5, y];}
    pub fn resow(self &) Grove {Grove.sow(rows * 10);}
    pub fn weigh(self &, g Grove) i64 {
      match g {
        case imm f Fruiting {f.grain + rows;}
        case is Grove.Idle {rows * 100;}
      }
    }
  }
}

// Outside the braces the enum is named with its type arguments, as always
fn groveCode(g Grove[i64]) i64 {
  match g {
    case imm f Fruiting {f.grain * 100 + f.rows;}
    case imm i Idle {i.rows;}
  }
}

// A static function of a generic enum that builds a variant reaches that variant
// from the enum's own type check, before the variants are checked in turn. The
// instance lists its variants before the enum itself is checked, so the match in
// the variant's method is exhaustive there as well. Listed only after the enum's
// check, the variant the static built was a miss that instantiated the enum
// again, endlessly (ErrorInstDepth), and its match saw part of the set
// (ErrorNoElse). Two instances, each checked the same way.
enum Crop[T] {
  pub rows i64;
  pub fn sow(r i64) Crop[T] {Fallow[T][r];}
  struct Ripe {pub grain T;}
  struct Fallow {
    pub fn resow(self &) Crop[T] {sow(rows + 1);}
    pub fn weigh(self &, c Crop[T]) i64 {
      match c {
        case imm r Ripe[T] {i64[r.grain] + rows;}
        case imm f Fallow[T] {f.rows * 100 + rows;}
      }
    }
  }
}

// An extension's copy of a base's variant is cloned as it was resolved, inside
// the base's braces, so the 'Low' in its method is the base's: the variant
// 'Tier.Low' written there would be, and the only one its return type admits. A
// variant the extension declares is inside the extension's braces, so its bare
// 'High' is the extension's own copy. Inside either enum's braces its own 'Low'
// is nearer than the Level.Low this module folds in above.
enum Tier {
  struct Low {}
  struct High {
    pub fn drop(self &) Tier {Low[];}
  }
}

enum WideTier extends Tier {
  struct Peak {
    pub fn drop(self &) WideTier {High[];}
  }
}

fn tierCode(t Tier) i32 {
  match t {
    case is Tier.Low {1;}
    case is Tier.High {2;}
  }
}

fn wideTierCode(w WideTier) i32 {
  match w {
    case is WideTier.Low {1;}
    case is WideTier.High {2;}
    case is WideTier.Peak {3;}
  }
}

// A method a value of the enum answers is each variant's too, as its own clone,
// so a variant's method calls it through 'self' as well as bare. The clones join
// the variant after its own methods, so they are not yet type checked when its
// own are; the call analyzes the one it names before comparing signatures, as a
// call to a later method of any type does. A generic enum's variant has its
// clones only once instantiated, and a bare call is still its own clone's: the
// name binds to the enum's method, the instance points it at the enum instance's,
// and type check calls it through 'self' by name. So is an overload name's.
enum Gauge {
  pub level i32;
  pub fn twice(self &) i32 {level * 2;}

  struct Dial {
    pub fn viaSelf(self &) i32 {self.twice() + 1;}
    pub fn viaBare(self &) i32 {twice() + 2;}
  }
}

enum Bin[T] {
  pub level T;
  pub fn twice(self &) T {level * 2;}
  pub fn plus1 overload plus(self &, x T) T {level + x;}
  pub fn plus2 overload plus(self &, x T, y T) T {level + x + y;}

  struct Box {
    pub fn viaSelf(self &) T {self.twice() + 1;}
    pub fn viaBare(self &) T {twice() + 2;}
    pub fn viaOverload(self &) T {plus(10) * 100 + plus(1, 2);}
  }
}

fn variantBodies() {
  imm dial = Gauge.Dial[5];
  show("variant-calls-enum-method-through-self", (&dial).viaSelf());
  show("variant-calls-enum-method-bare", (&dial).viaBare());
  imm box = Bin.Box[i64][7];
  show("generic-variant-calls-enum-method-through-self", (&box).viaSelf());
  show("generic-variant-calls-enum-method-bare", (&box).viaBare());
  show("generic-variant-calls-enum-overload-bare", (&box).viaOverload());
  imm stop = Traffic.Stop[];
  show("variant-builds-sibling-bare", trafficCode((&stop).next()));
  show("variant-calls-enum-static-bare", (&stop).pause());
  imm hold = Traffic.Hold[];
  show("variant-matches-sibling-bare", trafficCode((&hold).after(Traffic.Stop[])));
  show("variant-matches-sibling-else", trafficCode((&hold).after(Traffic.Hold[])));
  imm go = Traffic.Go[8];
  show("variant-own-name-wins-a-clash", (&go).held());
  imm empty = Slot.Empty[i64][4];
  imm filled = (&empty).fill(6);
  show("generic-variant-builds-sibling", (&empty).itemOr(filled, 99));
  show("generic-variant-common-field-bare", filled.count);
  show("generic-variant-sibling-pattern-else", (&empty).itemOr(Slot.Empty[i64][0], 99));
  imm full = Slot.Full[i64][3, 7];
  show("generic-variant-builds-later-sibling", (&full).drain().count);
  imm stuffed Tote[i64] = Tote.Stuffed[i64][2, 9];
  imm hollow Tote[i64] = Tote.Hollow[i64][5];
  imm tote = Tote.Stuffed[i64][0, 0];
  show("generic-variant-exhaustive-match-first", i64[(&tote).code(stuffed)]);
  show("generic-variant-exhaustive-match-last", i64[(&tote).code(hollow)]);
  show("generic-variant-exhaustive-bare-first", i64[(&tote).codeBare(stuffed)]);
  show("generic-variant-exhaustive-bare-last", i64[(&tote).codeBare(hollow)]);
  show("generic-variant-exhaustive-bare-type-first", i64[(&tote).codeAllBare(stuffed)]);
  show("generic-variant-exhaustive-bare-type-last", i64[(&tote).codeAllBare(hollow)]);
  imm totehollow = Tote.Hollow[i64][0];
  show("generic-variant-exhaustive-ref-first", (&totehollow).itemOr(&stuffed, 99));
  show("generic-variant-exhaustive-ref-last", (&totehollow).itemOr(&hollow, 99));
  show("generic-enum-method-exhaustive-first", i64[(&tote).which(stuffed)]);
  show("generic-enum-method-exhaustive-last", i64[(&totehollow).which(hollow)]);
  imm fruiting = Grove.Fruiting[i64][3, 7];
  show("generic-variant-bare-builds-later-sibling", groveCode((&fruiting).reap()));
  imm kept Grove.Fruiting[i64] = (&fruiting).keep();
  show("generic-variant-bare-is-its-own-instance", groveCode(kept));
  imm idle = Grove.Idle[i64][2];
  show("generic-variant-bare-builds-earlier-sibling", groveCode((&idle).plant(4)));
  show("generic-enum-static-bare-builds-variant", groveCode((&idle).resow()));
  show("generic-variant-bare-type-exhaustive-first", (&idle).weigh(fruiting));
  show("generic-variant-bare-type-exhaustive-last", (&idle).weigh(idle));
  imm plot = Crop.Fallow[i64][2];
  show("generic-static-builds-variant-exhaustive-first", (&plot).weigh(Crop.Ripe[i64][5, 40]));
  show("generic-static-builds-variant-exhaustive-last", (&plot).weigh((&plot).resow()));
  imm plot32 = Crop.Fallow[i32][4];
  show("generic-static-builds-variant-second-instance", (&plot32).weigh(Crop.Ripe[i32][1, 7]));
  imm high = WideTier.High[];
  show("extension-copy-means-the-base-sibling", tierCode((&high).drop()));
  imm peak = WideTier.Peak[];
  show("extension-variant-means-its-copy", wideTierCode((&peak).drop()));
}

// -------- interaction with the constructs below this tier --------

// An enum built in one branch and matched in another, accumulated in a loop:
// the intersections where variant tags and control flow have to agree.
fn stepped(n i32) Shape {
  if n % 2 == 0 {
    Circle[1, n];
  } else {
    Rect[2, n, 2];
  }
}

fn interactions() {
  mut total = 0;
  mut i = 0;
  while i < 6 {
    mut s = stepped(i);
    total = total + area(&s);
    i++;
  }
  show("enum-returned-from-branch-summed", total);

  // A match whose arms are the last statement of a function, returning the
  // enum's own common field
  mut acc = 0;
  mut j = 0;
  while j < 4 {
    acc = acc + kindOf(stepped(j));
    j++;
  }
  show("enum-by-value-in-loop", acc);

  // A variant holding a move type infects the enum with move semantics, and the
  // infection walks up the base every variant has. That walk never advanced its
  // cursor, so declaring this enum hung the compiler outright -- no output, no
  // diagnostic. The assertion is therefore that this file compiles at all; the
  // runner's timeout is what catches a regression.
  imm boxed = Boxed[1, Handle[9]];
  show("move-typed-variant", boxed.kind);

  // A variant stands in for its enum wherever the enum is expected, and a
  // struct literal's field is such a place. It used to be the one place it was
  // not: a literal's values were compared for exact type equality where a
  // variable initializer coerces, so the same value the line above accepts was
  // refused one line down.
  imm asVariable Shape = Circle[1, 4];
  imm inField = Framed[Circle[1, 5]];
  show("variant-coerces-in-initializer", area(&asVariable));
  show("variant-coerces-in-struct-literal", area(&inField.s));
}

// A struct with an enum-typed field, for the literal above. It is here rather
// than beside Shape for the same reason Held is: the coercion is the subject,
// not the struct.
struct Framed {
  pub s Shape;
}

// The enum whose declaration is the subject above. Declared down here with the
// other interaction types rather than beside Shape, because it is not what this
// group is about -- only the infection it triggers is.
struct Handle is Move {
  pub id i32;
}

enum Held {
  pub kind i32;

  struct Boxed {
    pub h Handle;
  }

  struct Bare {
    n i32;
  }
}
use Held;

// -------- held by value above its declaration --------

// Where an enum is written does not decide whether it can be held. A field, a
// parameter and a local all hold Crate by value here, above its declaration, so
// each asks for its size before the module walk has reached any of its variants.
// A variant not yet reached is not one being laid out -- nothing of it is on the
// demand stack, so it closes no cycle -- and this was once refused as though it
// were one. Demanding the enum lays its variants out with it, and generation
// sizes the enum from them, as it does for every enum.
struct Shipment {
  pub load Crate;
  pub count i64;
}

fn crateWeight(c Crate) i64 {
  mut held Crate = c;
  match held {
    case imm b Bulky {b.kg;}
    case imm s Slim {1i64;}
  }
}

enum Crate {
  struct Bulky {
    pub kg i64;
  }
  Slim;
}
use Crate;

fn heldAboveDeclaration() {
  show("enum-param-above-declaration", crateWeight(Bulky[40]));
  mut s = Shipment[Slim[], 3];
  show("enum-field-above-declaration", crateWeight(s.load) + s.count);
}

// -------- a static naming a variant above an enum method --------

// A static function whose signature names a variant once demanded that variant
// while the enum was still checking its own members in order. The variant checked
// its clone of each enum method and then compared it with the enum's own -- which
// the enum had not reached yet when it is written below the static. That
// comparison analyzes the enum's method first, so the order the two are written
// in does not decide whether a variant conforms. It once did: Meter's Over was
// refused as not having the 'probe' its enum requires, while Needle, the other
// order, compiled.
enum Meter {
  pub id i32;
  struct Under {pub lo i32;}
  struct Over {pub hi i32;}
  fn highOf(g &Over) i32 {g.hi;}
  pub fn probe(self &, other &Meter) i32 {id * 10 + other.id;}
}

enum Needle {
  pub id i32;
  struct Left {pub lo i32;}
  struct Right {pub hi i32;}
  pub fn probe(self &, other &Needle) i32 {id * 10 + other.id;}
  fn rightOf(g &Right) i32 {g.hi;}
}

fn staticAboveMethod() {
  imm under = Meter.Under[2, 5];
  imm over = Meter.Over[3, 7];
  show("enum-static-above-method", Meter.highOf(&over) * 100 + (&over).probe(&under));
  imm left = Needle.Left[4, 6];
  imm right = Needle.Right[1, 8];
  show("enum-method-above-static", Needle.rightOf(&right) * 100 + (&right).probe(&left));
}

// -------- held by value by its own members --------

// An enum's own members may hold it by value: a method's 'self', a static
// function's parameter, a function written below the enum that a static function
// passes it to, and a struct holding it that a method builds. Every type is laid
// out -- an enum with all its variants -- before any member is checked, so each
// finds the enum's size settled. All four were refused as a cycle when the enum's
// members were checked from inside its first variant's layout, which is where the
// module walk first reached the enum. None is a cycle. A by-value 'self' runs on a
// variant's value, which calls that variant's clone; on a value typed as the enum
// it is refused, and enum_typecheck_variant holds that.
enum Keeper {
  pub id i64;
  pub fn get(self) i64 {id;}
  pub fn take(k Keeper) i64 {k.id + 10;}
  pub fn viaBelow(k &Keeper) i64 {keeperTriple(*k);}
  pub fn boxed(self &) KeeperBox {KeeperBox[*self];}
  struct Full {pub n i64;}
  struct Bare {}
}

fn keeperTriple(k Keeper) i64 {k.id * 3;}

struct KeeperBox {
  pub k Keeper;
}

fn heldByOwnMembers() {
  show("enum-self-by-value", Keeper.Full[1, 4].get());
  imm bare = Keeper.Bare[5];
  show("enum-self-by-value-other-variant", bare.get());
  show("enum-static-by-value", Keeper.take(Keeper.Full[2, 4]));
  imm full Keeper = Keeper.Full[7, 4];
  show("enum-passed-to-function-below", Keeper.viaBelow(&full));
  show("enum-in-struct-built-by-method", (&full).boxed().k.id);
}

// An enum may reach itself through a reference, which is how a tree is written.
// The enum's size is the largest of its variants, so a variant holding it by
// value would be infinite -- enum_typecheck_variant holds that -- but a
// reference answers its own size without asking what it points at, so the cycle
// terminates. Declared rather than built: constructing one needs a nullable
// reference, and enum_nullable_ptr owns that shape.
enum Tree {
  pub depth i32;

  struct Leaf {
    v i64;
  }

  struct Fork {
    pub left &Tree;
    pub right &Tree;
  }
}

// Named through its enum, which is the spelling wherever no 'use' is in force
fn forkDepth(f &Tree.Fork) i32 {
  f.left.depth + f.right.depth;
}

fn main() i32 {
  construction();
  payloadFree();
  sparseTagDispatch();
  genericPinnedTag();
  genericStaticFn();
  commonMembersAnywhere();
  placedDiscriminant();
  unsizedEnum();
  enumValues();
  matching();
  aliasMatching();
  valueMatching();
  optionAndResult();
  namingVariants();
  barePatterns();
  foldingSome();
  variantBodies();
  interactions();
  heldAboveDeclaration();
  staticAboveMethod();
  heldByOwnMembers();
  0i32;
}
