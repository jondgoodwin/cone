// A method with a reference receiver called on a value of the enum is borrowed
// and dispatched on the tag (enum_method_value_dispatch). A by-value receiver
// ('self', copied into each variant) on a value typed as the enum would need its
// variant's copy chosen from the tag on a value, which is not built: refused,
// with the whole of 1150's text pinned, which names the two receivers that do
// work on a value. A '&mut' receiver on a value that is not
// mutable is refused for the borrow alone, not 1150 as well.

mod enum_typecheck_value_dispatch;

enum Kind {
  A;
  B;
  pub fn code(self) i32 { 1 }
  pub fn bump(self: &mut) { }
}

fn main() {
  var k: Kind = Kind.A;
  let c = k.code();       //~ ErrorEnumValueDispatch:12 "`code` takes 'self' by value, so each variant runs its own copy, and which variant a value of Kind is would have to be read from its tag at run time, which is not built for a value receiver. Match to reach the variant, or declare the receiver 'self: &', which is dispatched on the tag (on a value too), or 'self: Kind', one function over the whole enum."
  let j: Kind = Kind.B;
  j.bump();               //~ ErrorBadPerm
}
