// Declarations an enum body will not accept, and arms a match body will not
// accept.
//
// Parse stage only. An enum owns its variants' layout and their relationship to
// it, so a variant restates none of it: not the enum it belongs to, not the type
// parameters it takes, and not a tag value another variant already holds. Each
// diagnostic is reported on the variant, which is where the fix goes, and a
// variant's node carries the position of its name in both of its spellings.
//
// The match arm comes last on purpose: the parser abandons the whole match at
// the first thing that is neither 'case' nor 'else', so any arm written after
// it would be re-parsed as an ordinary statement and report again.

mod enum_parse_blocks;

trait Named {
  pub fn label(self &) i32 {1;}
}

// A variant is already a member of the enum it is written inside, so naming that
// enum in its 'is' restates it. The open trait beside it is the variant's own to
// assert (trait_enum_is), and only the restatement is refused.
enum WithIsa {
  struct BadIsa is Named, WithIsa {  //~ ErrorVariantDcl:10 "remove the 'is'"
    a i32;
  }
}

// A variant takes its enum's type parameters and may not declare its own
enum WithGenericParms {
  struct BadParms[T] {               //~ ErrorVariantDcl:10 "may not declare its own"
    b T;
  }
}

// Two variants holding one tag value are indistinguishable at a match, so the
// second is refused where it is written
enum Clashing {
  First = 3,
  Second = 3;        //~ ErrorDupTag:3 "already taken by variant First"
}

// The values compared are whole, sign included: counting up from -3 reaches -2,
// which Minus holds. (0x100000000 is not 0, which it was when a tag was cut to 32
// bits; enum_success holds that enum, which compiles now.)
enum ClashingNegative {
  Minus = -2,
  Lower = -3,
  Counted;           //~ ErrorDupTag:3 "Tag value -2 is already taken by variant Minus"
}

// A tag value is at most 64 bits, so a negative one past i64's smallest fits no
// integer type an enum may declare, and is refused before one is known
enum PastEveryType {
  Least = -0x8000000000000000,
  Under = -0x8000000000000001;   //~ ErrorTagWidth:12 "Tag value -9223372036854775809 is below -9223372036854775808"
}

// A variant is a name of its enum, in the one namespace the enum's fields and
// methods are names of too, so it may not share a spelling with either. Whichever
// is written second is refused, in either order.
enum SharesAField {
  pub level i32;
  level, other;      //~ ErrorDupName "a variant shares its enum's namespace"
}

enum SharesAMethod {
  measure, weigh;
  fn measure(self &) i32 {1;}   //~ ErrorDupName "every function/method needs its own name"
}

enum Shape {
  kind i32;

  struct Circle {
    radius i32;
  }

  struct Rect {
    w i32;
    h i32;
  }
}
use Shape;

fn stray(s &Shape) i32 {
  match s {
    case is &Circle {1;}
    imm x = 1;        //~ ErrorBadTerm:5 "should be either case or else"
  }
}
