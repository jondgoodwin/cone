// A method called on an empty variant written by its name is called on that variant
// constructed (enum_variant_receiver). A variant that holds values is no value by its
// name alone, so 'Shape.Circle.area()' stays a path through the variant to a method
// whose 'self' is then missing; and a generic enum's empty variant needs its type
// arguments written, since a receiver says nothing of where its value goes.

mod enum_typecheck_variant_receiver;

enum Shape {
  pub k i32 = 1;
  struct Circle {pub radius i32;}
  Dot;

  pub fn area(self &) i32 { k }
}

enum Pending[T] {
  pub k i32 = 5;
  Waiting;
  struct Done {pub v T;}

  pub fn key(self &) i32 { k }
}

fn holdsValues() i32 {
  Shape.Circle.area()        //~ ErrorFewArgs:15 "Function call requires more arguments than specified"
}

fn noTypeArguments() i32 {
  Pending.Waiting.key()      //~ ErrorInvType:11 "Could not infer"
}

fn main() {}
