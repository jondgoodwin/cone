// A variant declared as a type, 'Number i64;', holds that type itself: it has no
// field name, so there is no '.value' to reach it by, and a pattern that binds it
// ('case imm n Number') gives the i64 itself. It is one of three ways to declare a
// variant, beside a struct, which names its fields and may have methods, and a
// bare name, which holds nothing, and one enum may mix all three: each arm's
// binding follows its own variant's declaration. Core's Option and Result are
// declared this way ('Some T;', 'Ok T;', 'Error E;').
//
// What is claimed here: the three forms in one enum, matched by value, through a
// borrow and in a bound 'if'; a guard that names the binding; a payload that moves
// (it is finalized once, by whoever ends up with it); a payload that is a
// reference, whose enum is laid out as the bare pointer it is; a generic enum's
// type-variants and an extension's copy of them; a tag value pinned on one; and
// core's own. The printed lines were each worked out from the source by hand.

mod enum_variant_forms;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// -------- the three forms in one enum --------

enum Token {
  Number i64;
  Word &str;
  struct Op {
    pub prec i32;
    pub right bool;
  }
  End;
}
use Token;

// Each arm binds what its own variant declared: the i64, the &str, the struct
fn describe(t Token) i64 {
  match t {
    case imm n Number { n; }
    case imm w Word { i64.from(w.len); }
    case imm o Op { i64.from(o.prec); }
    case is End { -1; }
  }
}

fn forms() {
  show("number", describe(Number[40i64]));         // the i64 itself: 40
  show("word", describe(Word["hello"]));          // "hello" has 5 bytes
  show("op", describe(Op[2i32, true]));           // the struct's prec: 2
  show("end", describe(End[]));                   // -1
}

// A binding made through a borrow of a local is a borrow of the i64 inside it
fn through() {
  mut t Token = Number[41i64];
  match &mut t {
    case mut n &mut Number { *n = *n + 1i64; }    // changes the number in t
    else { }
  }
  show("through-mut", describe(t));               // 42
  imm u Token = Number[7i64];
  match &imm u {
    case imm n &Number { show("through-imm", *n); }
    else { }
  }
}

// A bound 'if', and a guard that names the binding
fn guards(t Token) i64 {
  if imm n Number = t {
    return match t {
      case imm big Number if big > 100i64 { 100i64; }
      case imm small Number { small; }
      else { 0i64; }
    };
  }
  0i64;
}

fn conditions() {
  show("if-small", guards(Number[5i64]));         // 5
  show("if-big", guards(Number[500i64]));         // the guard holds: 100
  show("if-not", guards(End[]));                  // not a Number: 0
}

// -------- a binding is a copy, a move, or a borrow --------

// 'mut' on a binding of a value is a copy of the number: the matched value
// keeps its own
fn copyOf() {
  imm o Option[i64] = Some[5i64];
  mut got = 0i64;
  match o {
    case mut n Some { n = n + 100i64; got = n; }
    else { }
  }
  show("copy-changed", got);                      // 105
  match o {
    case imm n Some { show("copy-kept", n); }     // 5
    else { }
  }
}

struct Res {
  pub id i64;
  fn final(self &uni) {
    printStr("fin");
    printInt(id);
    printStr(" ");
  }
}

enum Slot {
  Empty;
  Full Res;
}
use Slot;

// The Res moves out of the Slot into the binding, which dies with its arm: it is
// finalized once, there
fn take(s Slot) i64 {
  match s {
    case imm r Full { r.id; }
    case is Empty { 0i64; }
  }
}

fn moves() {
  show("take", take(Full[new Res(7i64)]));       // fin7 is printed as the binding dies, before the line
  printStr("\n");
  imm unmatched Slot = Full[new Res(8i64)];       // never matched: finalized with the enum
  printStr("kept ");
}

// -------- a payload that is a reference: the bare pointer layout --------

enum Held {
  Nothing;
  Some1 &i64;
}
use Held;

fn heldValue(h Held) i64 {
  match h {
    case imm p Some1 { *p; }
    case is Nothing { -1i64; }
  }
}

// Through a borrow the binding is a borrow of the reference
fn heldThrough(h &imm Held) i64 {
  match h {
    case imm p &Some1 { **p; }
    else { -1i64; }
  }
}

fn references() {
  imm n = 9i64;
  imm h Held = Some1[&n];
  show("held", heldValue(h));                    // 9
  show("held-through", heldThrough(&imm h));      // 9
  show("held-none", heldValue(Nothing[]));        // -1
}

// -------- generic, extended, pinned --------

enum Pair[T] {
  Left T;
  Right T;
  Neither;
}

fn pick[T](p Pair[T], dflt T) T {
  match p {
    case imm l Left { l; }
    case imm r Right { r; }
    case is Neither { dflt; }
  }
}

enum Wide extends Pair[i64] {
  Both i64;
}

fn widen(w Wide) i64 {
  match w {
    case imm l Left { l; }
    case imm r Right { r + 1000i64; }
    case imm b Both { b * 2i64; }
    case is Neither { 0i64; }
  }
}

enum Packet u8 {
  Ping = 1;
  Data i64 = 7;
}
use Packet;

fn generics() {
  show("pair-left", pick(Pair.Left[3i64], 0i64));            // 3
  show("pair-right", pick(Pair.Right[4i64], 0i64));          // 4
  show("pair-neither", pick(Pair.Neither[i64][], 55i64));    // the default: 55
  show("wide-left", widen(Wide.Left[3i64]));                 // 3
  show("wide-right", widen(Wide.Right[4i64]));               // 4 + 1000
  show("wide-both", widen(Wide.Both[6i64]));                 // 6 * 2
  imm p Packet = Data[12i64];
  match p {
    case imm d Data { show("packet", d); }                   // 12
    case is Ping { show("packet", 0i64); }
  }
}

// -------- core's Option and Result --------

fn orZero(o Option[i64]) i64 {
  match o {
    case imm n Some { n; }
    case is None { 0i64; }
  }
}

fn code(r Result[i64, bool]) i64 {
  match r {
    case imm n Ok { n; }
    case imm e Error { if e { -1i64; } else { -2i64; }; }
  }
}

fn core() {
  show("some", orZero(Some[12i64]));                     // 12
  show("none", orZero(None[i64][]));                     // 0
  show("ok", code(Ok[i64, bool][33i64]));                // 33
  show("error-true", code(Error[i64, bool][true]));      // -1
  show("error-false", code(Error[i64, bool][false]));    // -2
}

fn main() {
  forms();
  through();
  conditions();
  copyOf();
  moves();
  printStr("|\n");                                 // ends the line 'moves' left open
  references();
  generics();
  core();
}
