// '?' in a generator is refused where it is read: a generator hands its caller its
// items through 'yield', and its 'return' ends the walk, so there is no Result or
// Option of its own for a failure to go to. enum_typecheck_propagate holds the
// refusals type check makes.

mod enum_parse_propagate;

fn evens(xs: Option[i64]) yields i64 {
  let x = xs?;                 //~ ErrorQuesReturn:13 "a generator returns nothing but its items"
  yield x;
}
