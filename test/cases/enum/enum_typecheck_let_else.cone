// The 'else' of a let-else must leave on every path [error-handling: Rust's let-else, ruled
// 26 Oct; match.md, 10 Oct]: through 'return', 'break', 'continue', a call that does not
// return such as 'panic', or an 'if' or 'match' each of whose paths does. One that can go
// on is refused at the spot where a path goes on, saying what it lacks: an 'if' with no
// 'else', a last statement, a loop, an empty block. The forms accepted are run in
// enum_let_else; a plain block ending in the jump is its own scenario,
// enum_typecheck_let_else_block.

mod enum_typecheck_let_else;

fn empty(o: Option[i32]) i32 {
  let Some(n) = o else { };                                  //~ ErrorLetElse:24 "this block is empty"
  n
}

fn lastStatement(o: Option[i32], k: i32) i32 {
  let Some(n) = o else { k; };                               //~ ErrorLetElse:26 "its last statement"
  n
}

fn ifWithoutElse(o: Option[i32], c: bool) i32 {
  let Some(n) = o else { if c { return 1; } };               //~ ErrorLetElse:26 "has no 'else'"
  n
}

fn elseIfWithoutElse(o: Option[i32], k: i32) i32 {
  let Some(n) = o else { if k > 1 { return 1; } else if k > 0 { return 2; } };  //~ ErrorLetElse:26 "has no 'else'"
  n
}

fn oneBranchGoesOn(o: Option[i32], c: bool, k: i32) i32 {
  let Some(n) = o else { if c { return 1; } else { k; } };   //~ ErrorLetElse:52 "its last statement"
  n
}

fn matchArmGoesOn(o: Option[i32], k: i32) i32 {
  let Some(n) = o else {
    match k {
      case 1 { return 1; }
      else { }                                               //~ ErrorLetElse:12 "this block is empty"
    }
  };
  n
}

fn aLoop(o: Option[i32], c: bool) i32 {
  let Some(n) = o else { while c { } };                      //~ ErrorLetElse:34 "loop ends"
  n
}
