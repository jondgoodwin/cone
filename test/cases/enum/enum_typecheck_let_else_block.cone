// A STAND-IN, to be removed: the 'else' of a let-else that ends in a plain block which
// itself ends in the jump, 'else { { return 7; } }', is refused, though it leaves (Rust
// accepts it). Generation does not end the path at a 'return' that ends a plain block in
// an 'if''s branch: 'fn x(c: bool) i32 { if c { { return 7; } } 0 }' gives 0 for
// x(true), so the binding after the 'else' would run. When generation ends the path there,
// ifBlockFallsOut stops refusing the plain block, and this scenario becomes a run that
// prints 7 (its expectation flipped, the annotation removed).

mod enum_typecheck_let_else_block;

fn plainBlock(o: Option[i32]) i32 {
  let Some(n) = o else { { return 7; } };                    //~ ErrorLetElse:26 "plain block"
  n
}
