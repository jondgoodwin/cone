// What an 'else if' test narrows holds in its block and no further: after the chain the
// name is the whole enum again, and a block of an earlier test does not see a later test's variant.

mod enum_flow_else_if_nocarry;

enum State {
  struct Idle {}
  struct Run { pub speed: i64; }
  struct Stop { pub code: i64; }
}
use State;

fn after(s: State) i64 {
  var n = 0i64;
  if s is Idle { n = 1; }
  else if s is Run { n = s.speed; }
  return s.speed + n;   //~ ErrorNoMbr:11 "`speed` not found"
  //~^ ErrorNoMeth:11 "does not support calls"
}

fn earlier(s: State) i64 {
  var n = 0i64;
  if s is Idle { n = s.code; }   //~ ErrorNoMbr:23 "`code` not found"
  //~^ ErrorInvType:23 "does not match lval's type"
  else if s is Stop { n = s.code; }
  return n;
}

fn main() {
  after(State.Idle);
  earlier(State.Idle);
}
