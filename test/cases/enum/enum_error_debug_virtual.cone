// A virtual reference has two forms: its display form is the toText its trait declares,
// called through the vtable, and its debug form is the trait's name, unless the trait
// declares a toDebug, which is called through the vtable too. A sink that declares
// DebugText takes the debug form. Each line below is worked out by hand from the types.

mod enum_error_debug_virtual;

import stdio use *;
import collections use *;

struct Short is Error, Sendable {
  pub code: i32;
  pub fn toText(self: &, out: &uni TextOut) { out <- "short ", code; }
}

struct Probe is DebugText {
  text: String;
  pub fn init(self: &new) {*self = Probe(String());}
  pub fn takeText overload `<-`(self: &mut, s: &str) {
    self.text <- s;
  }
  pub fn textOut(self: &mut) TextOut {
    self.text.textOut()
  }
}

trait Tagged {
  pub fn toDebug(self: &, out: &uni TextOut);
}

struct Tag is Tagged {
  n: i32;
  pub fn toDebug(self: &, out: &uni TextOut) { out <- "tag ", n; }
}

fn show(e: &<Error) {
  print <- e, "\n";
  var p = Probe();
  p <- e;
  print <- p.text, "\n";
}

// A trait that declares its own toDebug is called through the vtable, as toText is
fn showTag(t: &<Tagged) {
  var p = Probe();
  p <- t;
  print <- p.text, "\n";
}

fn main() i32 {
  let sh = Short(7i32);
  show(&sh);
  let tg = Tag(4i32);
  showTag(&tg);
  0
}
