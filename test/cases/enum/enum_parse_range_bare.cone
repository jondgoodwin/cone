// A range pattern written with a bare '..' between its bounds does not say whether
// its upper bound is included, so it is refused where the '..' stands, and read on
// as '..=' so that the rest of the match is checked. '..=' includes the bound and
// '..<' stops before it.

mod enum_parse_range_bare;

fn class(c: char) i32 {
  match c {
    case 'a'..'z' {1}                  //~ ErrorRangeBare:13 "write '..<' to stop before the end, or '..=' to include it"
    case 'A' .. 'Z' {2}                //~ ErrorRangeBare:14 "'..' does not say whether the range includes its end"
    else {0}
  }
}

fn number(n: i32) i32 {
  match n {
    case -5 .. -3 {1}                  //~ ErrorRangeBare:13 "write '..<' to stop before the end"
    else {0}
  }
}
