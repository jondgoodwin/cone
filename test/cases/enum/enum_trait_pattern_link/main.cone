// A program matching, with trait patterns, an enum it did not declare: the package's
// own trait, and a trait of the program's that the variants meet by declaring what it
// requires. The variants' methods are the package's, called through vtables the program
// builds, and the package's own match is called by symbol.
//
// Each printed value was checked by hand against q's source.

mod prog;

import stdio use *;
import q;

trait Sizable {
  pub fn size(self: &) i32;
}

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn ownTrait(s: &q.Shape) i32 {
  match s {
    case q.Measured(m) {m.size()}
    case is Third {7}
  }
}

fn structural(s: &q.Shape) i32 {
  match s {
    case Sizable(m) {m.size() + 1}
    case is Third {7}
  }
}

fn main() {
  let c = q.Shape.Circle(3);
  let s = q.Shape.Square(2);
  let t = q.Shape.Third(9);
  show("imported-trait-circle", i64.from(ownTrait(&c)));   // 3 * 10
  show("imported-trait-square", i64.from(ownTrait(&s)));   // 2 * 100
  show("imported-trait-third", i64.from(ownTrait(&t)));    // the arm after: 7
  show("program-trait-circle", i64.from(structural(&c)));  // 3 * 10 + 1
  show("program-trait-square", i64.from(structural(&s)));  // 2 * 100 + 1
  show("program-trait-third", i64.from(structural(&t)));   // 7
  show("package-match", i64.from(q.measureInside(&s)));    // 200
}
