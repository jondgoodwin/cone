// A package declaring a trait and an enum whose variants comply with it, and matching
// the enum with a trait pattern itself. The program imports both and does the same with
// the enum and with a trait of its own that the variants meet by what they declare.

mod q;

pub trait Measured {
  pub fn size(self: &) i32;
}

pub enum Shape {
  pub struct Circle is Measured {
    pub r: i32;
    pub fn size(self: &) i32 {r * 10}
  }
  pub struct Square is Measured {
    pub s: i32;
    pub fn size(self: &) i32 {s * 100}
  }
  pub struct Third {
    pub t: i32;
  }
}

pub fn measureInside(s: &Shape) i32 {
  match s {
    case let m Measured {m.size()}
    case is Third {7}
  }
}
