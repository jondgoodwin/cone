// The other side of enum_match_borrowed_field: a pattern that takes a non-copy payload out
// of a field of a borrowed 'self' by value still moves it, which a borrow refuses.

mod enum_typecheck_match_borrowed_take;

struct Fin {
  pub id: i32;
  fn final(self: &uni) {}
}

enum E {
  struct A { pub f: Fin; }
  struct B { pub n: i32; }
}
use E;

struct H {
  e: E;
  fn take(self: &) i32 {
    match e {           //~ ErrorMoveField "May not move field 'e'"
      case let A(a) { 1 }
      else { 0 }
    }
  }
}
