// An error held as a trait value is written as text like any value with a toText: a
// virtual reference '&<Error' and a 'Uni[Error + Sendable]' go through the vtable.
// 'print <- e' and 'String() <- e' both lower to that call. Each line below is worked
// out by hand from the types.

mod enum_error_text_virtual;

import stdio use *;
import collections use *;

struct Short is Error, Sendable {
  pub code: i32;
  pub fn toText(self: &, out: &uni TextOut) { out <- "short ", code; }
}

fn show(e: &<Error) {
  // A send of the reference itself
  print <- e, "\n";
  print <- e;
  print <- "\n";
  let s = String() <- e;
  print <- s, "|", s.len(), "\n";
}

fn main() i32 {
  let sh = Short(7i32);
  show(&sh);

  // A Uni[Error + Sendable], as AnyError holds one
  let owner: Uni[Error + Sendable] = Uni[Short](Short(8i32));
  print <- owner, "\n";
  let t = String() <- owner;
  print <- t, "|", t.len(), "\n";
  0
}
