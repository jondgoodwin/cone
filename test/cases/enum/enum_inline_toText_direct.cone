// A direct call of an 'inline' toText, with a writer in hand (not a send), on a plain enum
// and a generic one: from a variant and from a value typed as the whole enum, which
// dispatches on the tag. Hand-checked: Plain writes "alpha" for A and "beta" for B;
// Gen writes "gee-a" for GA and "gee-b" for GB; each is followed by "\n".

mod enum_inline_toText_direct;
import stdio use *;
import collections use *;

enum Plain is Error, Sendable {
  A;
  B;
  pub fn toText(self: &, out: &uni TextOut) inline { self.write(out); }
  fn write(self: &Plain, out: &uni TextOut) inline {
    match self {
      case is A { out <- "alpha"; }
      case is B { out <- "beta"; }
    }
  }
}

enum Gen[T] is Error, Sendable {
  GA;
  GB;
  pub fn toText(self: &, out: &uni TextOut) inline { self.write(out); }
  fn write(self: &Gen[T], out: &uni TextOut) inline {
    match self {
      case is GA { out <- "gee-a"; }
      case is GB { out <- "gee-b"; }
    }
  }
}

fn main() i32 {
  var rec = print.record();
  let va = Plain.A;
  va.toText(&uni rec);
  rec <- "\n";
  let wb: Plain = Plain.B;
  wb.toText(&uni rec);
  rec <- "\n";
  let wa: Plain = Plain.A;
  wa.toText(&uni rec);
  rec <- "\n";
  let ga = Gen.GA[i32];
  ga.toText(&uni rec);
  rec <- "\n";
  let gb: Gen[i64] = Gen.GB[i64];
  gb.toText(&uni rec);
  rec <- "\n";
  0
}
