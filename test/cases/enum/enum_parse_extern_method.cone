// An include file declares a method defined in another object 'extern'. An enum's method
// whose receiver names the enum ('self: &Lamp') is one function over the whole enum
// (enum_method_receiver), defined in one place, so it may be. One written 'self: &' is a
// requirement each variant meets, or a default copied into each, so it is defined in no
// one place for 'extern' to name.

mod enum_parse_extern_method;

pub enum Lamp {
  Red;
  Green;

  pub extern fn describe(self: &Lamp) i32;
  pub extern fn code(self: &) i32;                   //~ ErrorBadExtern:14 "defined in no one place for 'extern' to name"
  pub extern fn tone(self: &Self) i32;               //~ ErrorBadExtern:14 "defined in no one place for 'extern' to name"
}

fn main() {}
