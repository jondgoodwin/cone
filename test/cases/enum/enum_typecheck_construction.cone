// A variant is constructed with parentheses, and an empty one by its name alone
// (enum_construction). Square brackets after a variant give type arguments and
// no values, so the old spelling is refused at the bracket, naming the new one.
// An empty variant takes no parentheses, and a variant that holds values is no
// value by its name alone.

mod enum_typecheck_construction;

enum Lamp {
  Red;
  Blink(i32);
}

enum Shape {
  struct Circle {pub radius: i32;}
  struct Rect {pub w: i32; pub h: i32;}
}

fn oldBrackets() {
  let a = Lamp.Blink[5];      //~ ErrorVariantBracket:21 "A variant is constructed with parentheses: write Blink(...), not Blink[...]. Square brackets after a variant give a generic one its type arguments and never values, written before them, as in Some[i32](5)."
  let b = Lamp.Red[];         //~ ErrorVariantBracket:19 "An empty variant is constructed by its name alone: write Red, not Red[]. Square brackets after a variant give a generic one its type arguments and never values, as in None[i32]."
  let c = Shape.Circle[2];    //~ ErrorVariantBracket:23 "A variant is constructed with parentheses: write Circle(...), not Circle[...]. Square brackets after a variant give a generic one its type arguments and never values, written before them, as in Some[i32](5)."
  let d: Option[i32] = Some[5];   //~ ErrorVariantBracket:28 "A variant is constructed with parentheses: write Some(...), not Some[...]. Square brackets after a variant give a generic one its type arguments and never values, written before them, as in Some[i32](5)."
  let e: Option[i32] = None[];    //~ ErrorVariantBracket:28 "An empty variant is constructed by its name alone: write None, not None[]. Square brackets after a variant give a generic one its type arguments and never values, as in None[i32]."
  let f = Some[i32][5];       //~ ErrorVariantBracket:20 "A variant is constructed with parentheses: write Some(...), not Some[...]. Square brackets after a variant give a generic one its type arguments and never values, written before them, as in Some[i32](5)."
  let g = None[i32][];        //~ ErrorVariantBracket:20 "An empty variant is constructed by its name alone: write None, not None[]. Square brackets after a variant give a generic one its type arguments and never values, as in None[i32]."
}

fn emptyCalled() {
  let h = Lamp.Red();         //~ ErrorVariantEmptyCall:15 "Red is an empty variant, which is constructed by its name alone: write Red, without parentheses."
}

fn noValues() {
  let i = Lamp.Blink;         //~ ErrorNotTyped:16 "Expected a typed expression"
  let j: Lamp = Lamp.Blink;    //~ ErrorNotTyped:22 "Expected a typed expression"
}

fn main() {}
