// The program compares enums it did not declare. The comparison of q's Shape is
// q's, and this program calls it; a generic enum's instance is made here, as
// every object using one makes it.

mod prog;

import stdio use *;
import q;

fn show(label &Array[u8], b bool) {
  printStr(label);
  printStr(" = ");
  printInt(if b {1;} else {0;});
  printStr("\n");
}

fn main() {
  show("same-circle", q.circle(2) == q.circle(2));
  show("other-circle", q.circle(2) == q.circle(3));
  show("same-rect", q.rect(1, 2) == q.rect(1, 2));
  show("other-rect", q.rect(1, 2) == q.rect(1, 3));
  show("circle-vs-rect", q.circle(1) == q.rect(1, 1));
  show("dot", q.dot() == q.dot());
  show("dot-ne", q.dot() != q.circle(0));
  show("inside", q.sameInside(q.rect(4, 4), q.rect(4, 4)));
  imm a q.Maybe[i32] = q.Maybe.Just[7];
  imm b q.Maybe[i32] = q.Maybe.Just[7];
  imm c q.Maybe[i32] = q.Maybe.Nothing[i32][];
  show("maybe-same", a == b);
  show("maybe-other", a == c);
}
