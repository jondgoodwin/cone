// A package declaring enums whose variants carry fields, and each variant's own
// '=='. The comparison the compiler gives such an enum is made here, in the
// package that declares it, and the program that imports the enum calls it: it
// has no body of its own to make it from, only the include file.

mod q;

pub enum Shape {
  pub struct Circle {
    pub radius i32;
    pub fn `==`(self, other Circle) bool { radius == other.radius; }
  }
  pub struct Rect {
    pub w i32;
    pub h i32;
    // Private: the comparison reaches it from inside the package, and the
    // program never names it
    fn `==`(self &, other &Rect) bool { w == other.w and h == other.h; }
  }
  pub struct Dot {}
}

pub fn circle(r i32) Shape { Shape.Circle[r]; }
pub fn rect(w i32, h i32) Shape { Shape.Rect[w, h]; }
pub fn dot() Shape { Shape.Dot[]; }

// The package compares its own, too
pub fn sameInside(a Shape, b Shape) bool { a == b; }

// A generic enum's instance is made by every object that uses it
pub enum Maybe[T] {
  pub struct Nothing {}
  pub struct Just {
    pub v T;
    pub fn `==`(self &, other &Just) bool { v == other.v; }
  }
}
