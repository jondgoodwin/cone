// An enum and the integer type its tag values are laid out in take a ':'
// between them, 'enum Colors: u32', as every declared name does
// (core_parse_nametype holds the rule). The old spelling is refused with no
// word about the old way. The type after the name is then read as a stray
// declaration, and the enum's body is read through to the end of the file.

mod enum_parse_nametype;

enum Spelled u8 {                //~ ErrorNoSemi
                                 //~^ ErrorNoVariants follow-on
                                 //~^^ ErrorBadGloStmt follow-on
  Fine = 1,
  Large = 3;
}
