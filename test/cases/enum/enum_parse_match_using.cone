// A function's pattern, 'using', written wrongly [match: topic 8a]: what a function matches only
// running it says, so a match with one ends in 'else'; the pattern is the call of a function,
// written with its parentheses, and the matched value is left out of its arguments; a binding
// that may fail leaves with an 'else' or is the condition of an 'if'; and a column of
// 'match a, b' binds nothing. enum_typecheck_match_using is what the function must give back.

mod enum_parse_match_using;

fn isOdd(n i32) bool { n % 2 == 1; }
fn half(n i32) Option[i32] { if n % 2 == 0 { Some(n / 2); } else { None[i32]; } }

fn testWithNoElse(n i32) i32 {
  match n {                  //~ ErrorMatchUsing:3 "needs an 'else'"
    case using isOdd() { 1; }
    case 2 { 2; }
  }
}

fn bindingWithNoElse(n i32) i32 {
  match n {                  //~ ErrorMatchUsing:3 "needs an 'else'"
    case let h using half() { h; }
  }
}

fn noCall(n i32) i32 {
  match n {
    case using isOdd { 1; }  //~ ErrorUsingForm:22 "followed by the call of a function"
    else { 0; }
  }
}

fn bindingInAColumn(n i32, m i32) i32 {
  match n, m {
    case let h using half(), 0 { h; }   //~ ErrorMatchColumn:14 "does not bind a variable"
    else { 0; }
  }
}

fn declarationWithNoElse(n i32) i32 {
  let h using half() = n;    //~ ErrorUsingForm:7 "ends in an 'else' that leaves"
  h;
}
