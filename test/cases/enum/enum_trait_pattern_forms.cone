// Trait patterns [match topic 7] beyond a plain enum: an enum that extends another (the
// copies of the base's variants comply as the base's did), a generic enum, a trait pattern
// in a macro's expansion, in a loop, in an 'if' chain written with 'is' (where a trait test
// narrows as the variants it names do), and on an owner, where it can only test.
//
// The expected numbers are worked out by hand in the comments.

mod enum_trait_pattern_forms;

import stdio use *;

trait Measured {
  pub fn size(self: &) i32;
}

trait Boxed[T] {
  pub fn get(self: &) T;
}

enum Shape {
  struct Circle is Measured, Boxed[i32] {
    pub r: i32;
    pub fn size(self: &) i32 {r * 10}
    pub fn get(self: &) i32 {r}
  }
  struct Square is Measured {
    pub s: i32;
    pub fn size(self: &) i32 {s * 100}
  }
  struct Third {
    pub t: i32;
  }
}

enum Rich extends Shape {
  struct Fourth is Measured {
    pub f: i32;
    pub fn size(self: &) i32 {f * 7}
  }
  struct Fifth {}
}

enum Maybe[T] {
  struct Has is Measured {
    pub v: T;
    pub fn size(self: &) i32 {5}
  }
  struct Lacks {}
}

// An enum laid out as a pointer, null standing for its empty variant, has no tag: a trait
// pattern tests it as the variant is tested, by the pointer, and cannot bind
enum Link {
  struct Node is Measured {
    pub p: &i32;
    pub fn size(self: &) i32 {*p}
  }
  struct Empty {}
}

fn link(l: &Link) i32 {
  match l {
    case is Measured {1}
    case is Empty {0}
  }
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// The extension has its own copies of Circle, Square and Third, and the variants it adds
fn rich(s: &Rich) i32 {
  match s {
    case let Measured(m) {m.size()}
    case is Fifth | Third {0}
  }
}

fn gen[T](s: &Maybe[T]) i32 {
  match s {
    case let Measured(m) {m.size()}
    case is Lacks {0}
  }
}

// A generic trait's instance names the variants that declare that instance: only Circle
fn boxed(s: &Shape) i32 {
  match s {
    case let Boxed[i32](b) {b.get()}
    else {0}
  }
}

// A pattern may be written as the virtual reference it binds, which checks that the
// matched value agrees, and the variable may be 'var'
fn written(s: &Shape) i32 {
  match s {
    case let &<Measured(m) {m.size()}
    case is Third {0}
  }
}

fn changing(s: &mut Shape) i32 {
  match s {
    case var Measured(m) {m.size()}
    case is Third {0}
  }
}

// In an 'if' chain: the variants left past a test that names several are the others'
fn chain(s: &Shape) i32 {
  if s is Measured {
    1
  } else {
    s.t
  }
}

fn chainOrder(s: &Shape) i32 {
  if s is Circle {
    1
  } else if s is Measured {
    2
  } else {
    s.t
  }
}

// An owner can be asked, not bound: a virtual reference is a borrow
fn owner(s: Rc[imm, Shape]) i32 {
  match s {
    case is Measured {1}
    case is Third {2}
  }
}

fn looped(s: &Shape) i32 {
  var n = 0;
  each i in 0 ..< 3 {
    match s {
      case let Measured(m) {n = n + m.size();}
      case is Third {n = n + 1;}
    }
  }
  n
}

macro twice[s: &Shape] {
  match s {
    case let Measured(m) {m.size() * 2}
    case is Third {0}
  }
}

fn viaMacro(s: &Shape) i32 {
  twice[s]
}

fn main() i32 {
  let c = Shape.Circle(3);
  let sq = Shape.Square(1);
  let th = Shape.Third(9);
  let f = Rich.Fourth(2);
  let fifth = Rich.Fifth;
  let h = Maybe.Has[i32](1);
  let lacks = Maybe.Lacks[i32];
  show("extension-added-variant", i64.from(rich(&f)));    // 2 * 7
  show("extension-other-variant", i64.from(rich(&fifth)));
  show("generic-trait-circle", i64.from(boxed(&c)));      // Circle(3) gives 3
  show("generic-trait-square", i64.from(boxed(&sq)));     // Square does not declare Boxed[i32]: 0
  show("written-as-virtual-ref", i64.from(written(&sq))); // 1 * 100
  var ms: Shape = Shape.Square(2);
  show("mut-binding", i64.from(changing(&mut ms)));       // 2 * 100
  show("generic-has", i64.from(gen(&h)));                 // 5
  show("generic-lacks", i64.from(gen(&lacks)));
  show("chain-circle", i64.from(chain(&c)));              // the trait's test holds: 1
  show("chain-third", i64.from(chain(&th)));              // by elimination, Third's field: 9
  show("chain-order-circle", i64.from(chainOrder(&c)));   // the first test: 1
  show("chain-order-square", i64.from(chainOrder(&sq)));  // the trait's: 2
  show("chain-order-third", i64.from(chainOrder(&th)));   // by elimination: 9
  let five = 5;
  let node = Link.Node(&five);
  let none = Link.Empty;
  show("pointer-layout-node", i64.from(link(&node)));     // the trait's variant: 1
  show("pointer-layout-empty", i64.from(link(&none)));    // the other: 0
  let own = Rc[imm, Shape](Shape.Circle(1));
  show("owner-test", i64.from(owner(own)));
  show("looped", i64.from(looped(&c)));                   // three times 3 * 10
  show("macro", i64.from(viaMacro(&c)));                  // 2 * (3 * 10)
  0
}
