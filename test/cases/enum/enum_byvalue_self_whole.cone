// A by-value receiver that NAMES the enum ('mut self E') is one function over the whole enum,
// not a copy in each variant: it takes a variant widened to the enum, returns the enum, and
// chains, and it is called on a value typed as the enum as well. (An untyped 'mut self' is the
// variant's own copy instead: enum_byvalue_self_copy.)
//
// Each printed value was checked by hand against the source.

mod enum_byvalue_self_whole;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

enum E {
  pub n i32;
  pub fn setN(var self E, v i32) E { n = v; self; }
  pub fn kind(self &E) i32 { match self { case A {1;} case B {2;} } }
  pub struct A { pub a i32; }
  pub struct B;
}

fn main() {
  let x = E.A(0, 5).setN(1).setN(2);
  show("chain n", i64.from(x.n));              // 2
  show("chain kind", i64.from(x.kind()));      // 1
  let y E = E.B(3);
  let z = y.setN(9);
  show("enum n", i64.from(z.n));               // 9
  show("enum kind", i64.from(z.kind()));       // 2
}
