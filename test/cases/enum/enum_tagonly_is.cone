// A payload-free enum that declares a trait with 'is' is still tag only: '==' and '!=' read the
// discriminant, and no '-eq' function is generated for it. The 'is' entry is stored as a field of the
// enum (IsMixin), and counting it as a payload once gave such an enum a real, unused '-eq' that every
// importer of core carried in its object.

mod enum_tagonly_is;

import stdio use *;

enum Mark is Serialize, Deserialize[Mark] { Low, Mid, High }

fn show(label: &str, b: bool) {
  printStr(label);
  printStr(if b { " = yes\n" } else { " = no\n" });
}

fn main() i32 {
  let a = Mark.Mid;
  show("same", a == Mark.Mid);
  show("different", a == Mark.High);
  show("ne", a != Mark.Low);
  0
}

