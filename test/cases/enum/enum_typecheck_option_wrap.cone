// What the plain-value wrap into an Option does not do: it wraps one level only, it never
// makes a Result's Ok or Err, and Option's '&&' still takes no plain value on the right.

mod enum_typecheck_option_wrap;

enum Bad {
  Code(i32);
}

fn ok(n: i32) Result[i32, Bad] {  //~ ErrorInvType:21 "This is the declared function's return type" follow-on
  if n < 0 { return n; }       //~ ErrorInvType:14 "Return expression type does not match"
  Ok(n)
}

fn main() {
  let a: ??i32 = 5;            //~ ErrorInvType:18 "Initialization value's type"
  let opt: ?i32 = Some(1);
  let b = opt && 5;            //~ ErrorMacroArgType:18 "other"
  let c: Result[i32, Bad] = 5; //~ ErrorInvType:29 "Initialization value's type"
}
