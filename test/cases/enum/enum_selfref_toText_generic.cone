// The same on a generic enum: sent as text, from a variant, a value of the whole enum
// and a Result's error. Hand-checked: One writes "one", Two "two".

mod enum_selfref_toText_generic;
import stdio use *;
import collections use *;

enum Bad[T] is Error, Sendable {
  One;
  Two;
  pub fn toText(self: &, out: &uni TextOut) inline { self.write(out); }
  fn write(self: &Bad[T], out: &uni TextOut) inline {
    match self {
      case is One { out <- "one"; }
      case is Two { out <- "two"; }
    }
  }
}

fn show[T](e: Bad[T]) { print <- e, "\n"; }

fn pick(n: i32) Result[i32, Bad[i32]] {
  if n == 1i32 { Err[i32, Bad[i32]](Bad.One[i32]) } else { Ok[i32, Bad[i32]](n) }
}

fn main() i32 {
  let e = Bad.Two[i32];
  print <- e, "\n";
  show(Bad.One[i64]);
  show(Bad.Two[bool]);
  match pick(1i32) {
    case let Err(x) { print <- x, "\n"; }
    case is Ok { print <- "ok\n"; }
  }
  0
}
