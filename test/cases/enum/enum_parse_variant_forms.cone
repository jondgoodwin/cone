// A variant declared as a type, 'Count i32;', holds its i32 with no name for it.
// An enum with fields every variant shares names everything it holds, so it has
// no such variant: the capitalised 'Count i32;' would read as a variant holding
// an i32 beside a common 'stamp', and the refusal says to declare it as a struct,
// whose field has a name. A lower-case 'count i32;' is a common field, as ever.
//
// The refusal is reported at the variant, once, however many fields are shared.

mod enum_parse_variant_forms;

enum Stamped {
  pub stamp i64;
  pub kind i32;
  Count i32;                 //~ ErrorTypeVariant:3 "Count is declared as a type, and Stamped has fields every variant shares (stamp)"
  struct Named { pub name i32; }
}

// Without a common field the same variant is accepted, and so is every form in
// one enum, bare names and a struct among them
enum Plain {
  Count i32;
  Name &str;
  struct Pair { pub a i32; pub b i32; }
  Nothing;
}

// An 'is' list names abstractions and makes no field, so it does not count
trait Shape { pub fn size(self &) i32; }
enum Shaped is Shape {
  Whole i32;
  pub fn size(self &) i32 { 1; }
}

// A common field written after the variants counts as much as one before
enum Late {
  Count i32;                 //~ ErrorTypeVariant:3 "Count is declared as a type, and Late has fields every variant shares (stamp)"
  struct Other { pub n i32; }
  pub stamp i64;
}
