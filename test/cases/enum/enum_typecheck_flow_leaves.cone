// The negative control for enum_flow_narrow_leaves: when one path of the branch does not
// leave, the name is not known to be a Circle after the 'if'.

mod enum_typecheck_flow_leaves;

enum Shape {
  struct Circle { pub radius: i32; }
  struct Rect { pub w: i32; }
}
use Shape;

fn oneFallsThrough(s: Shape, c: bool) i32 {
  if s is Rect { if c { return 1; } }
  s.radius;                              //~ ErrorNoMbr "radius"
  0
}

fn innerFallsThrough(s: Shape, c: bool) i32 {
  if s is Rect { if c { return 1; } else { c = false; } }
  s.radius;                              //~ ErrorNoMbr "radius"
  0
}
