// How an enum relates to its variants as a type: widening to the enum is free,
// narrowing back to a variant is what matching is for, and the set of variants
// is closed.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. What a pattern may narrow to is in
// enum_typecheck_narrow; what a match must satisfy to be a value is in
// enum_typecheck_match.

mod enum_typecheck_variant;

enum Shape {
  pub kind i32;

  struct Circle {
    pub radius i32;
  }

  struct Rect {
    w i32;
    h i32;
  }
}
use Shape;

// Only the field the enum declares is reachable without knowing the variant. A
// variant's own field is not, however sure the caller is of which variant it is.
fn variantFieldThroughEnum(s &Shape) {
  imm r = s.radius;     //~ ErrorNoMbr:12 "Method or field `radius` not found"
}

// A variant is a name of the enum and never a member of its values, so the
// period that reaches it is through the enum's name, not through a value
fn variantThroughAValue(s &Shape) {
  imm c = s.Circle;     //~ ErrorNoMbr:12 "Method or field `Circle` not found"
}

// An enum value does not narrow to a variant by assignment
fn enumToVariant(s Shape) {
  mut c Circle = s;     //~ ErrorInvType:18 "Initialization value's type does not match variable's declared type"
}

// ... nor does a reference to an enum narrow to a reference to a variant
fn enumRefToVariantRef(s &Shape) {
  imm c &Circle = s;    //~ ErrorInvType:19 "Initialization value's type does not match variable's declared type"
}

// Widening is only free where the reference cannot write: a mutable reference to
// a variant would let the callee store a different variant through it
fn takesMutEnum(s &mut Shape) {
}

fn mutVariantRefToEnum() {
  mut c = Circle[1, 5];
  takesMutEnum(&mut c);   //~ ErrorInvType:16 "Expression's type does not match declared parameter"
}

// An enum's variants are all declared inside it, so nothing outside can join
// the set later
struct Outside is Shape {      //~ ErrorInvType:19 "nothing outside may join the set"
  z i32;
}

// A variant may not hold its own enum by value: the enum is at least as large
// as this variant, which is at least as large as the enum. Through a reference
// it is legal and is how a tree is written, which enum_success covers.
//
// The enum's own laid-out mark does not settle this. It says its own fields --
// the tag -- are done, and its variants are laid out after that, each taking
// the enum as its base. So the size is not known until every variant is, which
// is what the diagnostic says. Before it, this compiled clean and generated a
// layout with the field simply dropped.
enum Container {
  kind i32;

  struct Item {
    n i32;
  }

  struct Nested {
    inner Container;   //~ ErrorNoSize:5 "variant still being laid out"
  }
}

// A generic enum's instance is refused the same way. The instance lists all its
// variants before any is type checked, so the one holding the instance by value
// is found in flight, as a plain enum's is.
enum Crate[T] {
  struct Loose {
    n T;
  }

  struct Boxed {
    inner Crate[T];    //~ ErrorNoSize:5 "variant still being laid out"
  }
}

fn holdsCrate(c &Crate[i32]) {
}

// An enum's method belongs to its variants: each has a clone, and the enum's own
// is never generated. On a variant's value the call reaches that variant's
// clone, and through a reference to the enum the tag selects it. On a value
// typed as the enum, which only a by-value 'self' can be called on, the tag
// would have to select it at run time too, and that is not built -- so it is
// refused. It was not before: with the enum reached from above its declaration,
// the call compiled into a call to a function that does not exist, which only
// LLVM's verifier or the linker caught. The declaration itself is fine, as
// enum_success shows.
enum Reading {
  pub id i32;
  pub fn get(self) i32 {id;}
  struct Low {}
  struct High {pub n i32;}
}

fn readValue(r Reading) i32 {
  r.get();    //~ ErrorEnumValueDispatch:4 "not built for a value receiver"
}
