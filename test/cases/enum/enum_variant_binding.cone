// A pattern binds a name inside the variant [match: topic 6a]: 'case Circle(c)',
// 'if let Some(n) = x', 'let Some(n) = x else {...};'. The variant is named as the pattern
// names it everywhere else, and the one name in the parentheses takes the variant's contents:
// a reference into the matched value for a struct variant matched through a reference, the
// payload for 'Some'. 'var' before the name lets the arm change it, and '_' tests the
// variant and binds nothing, so it may be joined to other patterns with '|' where a name
// that binds may not.
//
// The variant may be written through its enum ('Shape.Circle(c)'), with its type arguments
// ('Some[i32](n)') or as a reference ('&mut Ok(var n)'); an 'if' guard may use the name. Every
// result is printed, so the output is the whole assertion; the expected lines are worked out
// by hand in the comments.

mod enum_variant_binding;

import stdio use *;

enum Shape {
  struct Circle { pub radius: i32; }
  struct Rect { pub w: i32; pub h: i32; }
  struct Dot {}
}
use Shape;

fn num(n: i32) {
  printInt(i64.from(n));
  printStr(" ");
}
fn end() {
  printStr("|\n");
}

// A reference into the matched value; a guard reads the name:
// a circle of radius 2 is 12, a 3 by 3 rect 9, a 3 by 4 rect 12, a dot 0
fn area(s: &Shape) i32 {
  match s {
    case Circle(c) { 3 * c.radius * c.radius }
    case Rect(r) if r.w == r.h { r.w * r.w }
    case Rect(r) { r.w * r.h }
    case Dot { 0 }
  }
}

// Through the enum: Circle(5) is 5, anything else -1
fn viaPath(s: &Shape) i32 {
  match s {
    case Shape.Circle(c) { c.radius }
    else { -1 }
  }
}

// With the type argument written: Some(4) is 4, None 0
fn viaArgs(o: Option[i32]) i32 {
  match o {
    case Some[i32](n) { n }
    case None { 0 }
  }
}

// 'var' changes the arm's own copy: Some(4) gives 5
fn bump(o: Option[i32]) i32 {
  match o {
    case Some(var n) { n = n + 1; n }
    else { 0 }
  }
}

// '_' binds nothing: Ok is 1, Error 2
fn kind(r: Result[i32, i32]) i32 {
  match r {
    case Ok(_) { 1 }
    case Error(_) { 2 }
  }
}

// ... and may be joined: a circle or a rect is 1, a dot 2
fn joined(s: &Shape) i32 {
  match s {
    case Circle(_) | Rect(_) { 1 }
    else { 2 }
  }
}

// In an 'if', an 'elif', and a declaration that leaves
fn viaIf(o: Option[i32]) i32 {
  if let Some(n) = o { n } else { 0 }
}
fn discard(o: Option[i32]) i32 {
  if let Some(_) = o { 1 } else { 0 }
}
fn viaElif(r: Result[i32, i32]) i32 {
  if let Ok(n) = r { n } else if let Error(e) = r { 0 - e } else { 99 }
}
fn leave(o: Option[i32]) i32 {
  let Some(n) = o else { return 0; };
  n + 1
}
fn leaveDiscard(o: Option[i32]) i32 {
  let Some(_) = o else { return 0; };
  7
}

// Written as a reference, the name is a reference into the matched value and 'var' lets
// the arm write through it: Ok(1) becomes 11
fn viaRef(r: &mut Result[i32, i32]) {
  match r {
    case &mut Ok(var n) { *n = *n + 10; }
    else { }
  }
}

fn main() {
  // 12 9 12 0 |
  num(area(&Circle(2)));
  num(area(&Rect(3, 3)));
  num(area(&Rect(3, 4)));
  num(area(&Dot));
  end();
  // 5 -1 4 0 5 |
  num(viaPath(&Circle(5)));
  num(viaPath(&Dot));
  num(viaArgs(Some(4)));
  num(viaArgs(None[i32]));
  num(bump(Some(4)));
  end();
  // 1 2 1 1 2 |
  num(kind(Ok(1)));
  num(kind(Error(1)));
  num(joined(&Circle(1)));
  num(joined(&Rect(1, 1)));
  num(joined(&Dot));
  end();
  // 8 0 1 0 5 -6 2 0 7 0 |
  num(viaIf(Some(8)));
  num(viaIf(None[i32]));
  num(discard(Some(8)));
  num(discard(None[i32]));
  num(viaElif(Ok(5)));
  num(viaElif(Error(6)));
  num(leave(Some(1)));
  num(leave(None[i32]));
  num(leaveDiscard(Some(1)));
  num(leaveDiscard(None[i32]));
  end();
  // 11 |
  var r: Result[i32, i32] = Ok(1);
  viaRef(&mut r);
  match r {
    case Ok(n) { num(n); }
    else { }
  }
  end();
}
