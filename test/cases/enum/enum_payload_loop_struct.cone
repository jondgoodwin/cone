// A cursor whose inline 'next' returns a plain struct of a flag and an i64,
// consumed by a loop over a slice of i64. Compiled as a library (cases.toml), the
// optimized IR shows whether LLVM made it the counted loop it makes of a
// hand-written one.

mod enum_payload_loop_struct;

pub struct Got {
  pub ok bool;
  pub v i64;
}

pub struct PairCursor['a] {
  arr &'a Array[i64];
  pos usize;
  pub fn next(self &mut) Got inline {
    if pos >= arr.len { return new Got(false, 0i64); }
    imm v = arr[pos];
    pos = pos + 1;
    new Got(true, v);
  }
}

pub fn sumPair(a &Array[i64]) i64 {
  mut c = new PairCursor(a, 0usize);
  mut s = 0i64;
  while true {
    imm g = c.next();
    if !g.ok { break; }
    s = s + g.v;
  }
  s;
}
