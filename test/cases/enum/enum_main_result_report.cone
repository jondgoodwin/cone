// A 'main' returning a Result prints its error with the error type's 'report()'
// where it has one, else its 'message()' (enum_main_result is the 'message()' alone).
// 'report()' is the Error trait's default in collections, the message and each cause
// under it, so a chain prints as a chain: here a typed error meeting Error, with
// two causes under it, wrapped by '?' into an AnyError and given two lines of
// context. The text format is INTERIM until the display design lands.

mod enum_main_result_report;

import stdio use *;
import collections use *;

struct Disk is Error, Sendable {
  pub code: i32;
  pub fn message(self: &) String { String.from("disk read failed") }
}

struct Store is Error, Sendable {
  cause: Disk;
  pub fn message(self: &) String { String.from("store unavailable") }
  pub fn source(self: &) Option[&<Error] { Some[&<Error](&cause) }
}

fn open() Result[i32, Store] {
  Err[i32, Store](Store(Disk(5i32)))
}

fn load() Result[i32, AnyError] {
  match open() {
    case let Ok(v) { Ok[i32, AnyError](v) }
    case let Err(e) { Err[i32, AnyError](AnyError.from(e).addContext("loading the settings")) }
  }
}

fn main() Result[void, AnyError] {
  printStr("start\n");
  let v = load()?;
  printStr("never printed\n");
  Ok(nil)
}
