// What copies of one '&mut' borrow of a local enum still do (enum_flow_narrow_mut_copy holds
// what is refused): another variant is stored once the narrowed reference is done with.

mod enum_narrow_mut_copy_success;

import stdio use *;

enum Slot {
  struct Whole { pub n: i64; }
  struct Real { pub f: f64; }
}
use Slot;

fn main() {
  var s: Slot = Whole(7i64);
  let r = &mut s;
  let r2 = r;
  if let Whole(w) = r {
    printInt(w.n);
  }
  *r2 = Real(1.5f64);
  if r is Real { printInt(1i64); }
  *r = Whole(2i64);
  if r2 is Whole { printInt(r2.n); }
}
