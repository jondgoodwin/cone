// Counting enum tags past the largest 64-bit unsigned value. The next number would
// wrap to 0, a duplicate of the first tag, so the variant that would take it is
// refused with the code any tag that does not fit wears (ErrorTagWidth). Found
// while the enum is parsed, which numbers its variants, so it is a parse-stage
// diagnostic of its own file. Width checks against a declared integer type are
// enum_typecheck_tag's.

mod enum_parse_tag_overflow;

enum CountsPastMax {
  CountsLast = 0xFFFFFFFFFFFFFFFF,
  CountsWrapped              //~ ErrorTagWidth:3 "would pass 18446744073709551615"
}

// A tag AT the maximum is fine, so long as nothing counts on from it
enum AtMax {
  AtMaxZero,
  AtMaxLast = 0xFFFFFFFFFFFFFFFF
}
