// The 'else' of a let-else that leaves through a plain block ending in the jump,
// 'else { { return 7; } }', as Rust accepts it: the plain block leaves, so the 'else'
// does. Generation ends the path at the 'return' however deep in plain blocks it is,
// so the binding after the 'else' is not reached, which the values printed show: the
// 'else''s value when the variant is missing, the binding's when it is there. A local
// of the plain block, and one of the function, are finalized once as the 'return'
// leaves, before the value is printed.

mod enum_let_else_block;

import stdio use *;

struct Fin {
  pub id: i32;
  fn final(self: &uni) {
    printStr("fin");
    printInt(i64.from(self.id));
    printStr(" ");
  }
}

fn show(n: i32) {
  printInt(i64.from(n));
  printStr("\n");
}

fn plainBlock(o: Option[i32]) i32 {
  let Some(n) = o else { { return 7; } };
  n
}

fn deeper(o: Option[i32]) i32 {
  let Some(n) = o else { { { return 8; } } };
  n + 100
}

fn withLocals(o: Option[i32]) i32 {
  let outer = Fin(1);
  let Some(n) = o else {
    let inner = Fin(2);
    { return inner.id * 10 + outer.id; }
  };
  n + 200
}

fn main() i32 {
  show(plainBlock(None));
  show(plainBlock(Some(3)));
  show(deeper(None));
  show(deeper(Some(4)));
  show(withLocals(None));
  show(withLocals(Some(5)));
  0
}
