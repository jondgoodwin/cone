// A pattern binds a name inside the variant [match: topic 6a]: 'case let Ok(avg)',
// 'case var Some(n)', 'if let Some(n) = x', 'let Tea(t) = d else {...};'. The 'let' or
// 'var' is in front of the whole pattern, and the parentheses hold exactly one name; a
// variant is never read by position and a pattern does not nest. A binding written in the
// retired order, a name and then the variant, and one that puts 'var' inside the parentheses
// are refused.
//
// Parse stage only. Each malformed pattern is in its own function so the parser's
// resynchronization from one cannot reach the next. The errors are reported where the
// binding is: at the variant for a count, at the thing inside for a nested pattern.

mod enum_parse_variant_binding;

enum Reply {
  Pong;
  Number(i32);
  struct Pair { pub a: i32; pub b: i32; }
}
use Reply;

fn calc(n: i32) i32 { n }

// A variant takes one name: none, or several, are refused (the fields of a struct variant
// are read through the variant bound whole)
fn noName(r: &Reply) i32 {
  match r {
    case let Number() { 1 }               //~ ErrorPatBindCount "exactly one name"
    else { 0 }
  }
}

fn severalNames(r: &Reply) i32 {
  match r {
    case let Pair(a, b) { 1 }             //~ ErrorPatBindCount "exactly one name"
    else { 0 }
  }
}

fn severalNamesIf(r: &Reply) i32 {
  if let Pair(a, b) = r { 1 } else { 0 }  //~ ErrorPatBindCount "exactly one name"
}

fn severalNamesLetElse(r: &Reply) i32 {
  let Pair(a, b) = r else { return 0; };  //~ ErrorPatBindCount "exactly one name"
  1
}

// A pattern does not nest: what is inside the parentheses is a name and nothing else, so
// a value, a call or another pattern there is refused
fn nestedPattern(o: Option[Reply]) i32 {
  match o {
    case let Some(Number(n)) { n }        //~ ErrorPatBindNested "patterns do not nest"
    else { 0 }
  }
}

fn aValue(r: &Reply) i32 {
  match r {
    case let Number(3) { 1 }              //~ ErrorPatBindNested "patterns do not nest"
    else { 0 }
  }
}

fn aCall(r: &Reply, x: i32) i32 {
  match r {
    case let Number(calc(x)) { 1 }        //~ ErrorPatBindNested "patterns do not nest"
    else { 0 }
  }
}

// The name goes inside the variant: a name before the variant, and a variant with no
// parentheses, are refused
fn nameBeforeVariant(r: &Reply) i32 {
  match r {
    case let n Number { n }               //~ ErrorPatBindForm "puts the one name in its parentheses"
    else { 0 }
  }
}

fn nameBeforeVariantIf(r: &Reply) i32 {
  if let n Number = r { n } else { 0 }    //~ ErrorPatBindForm "puts the one name in its parentheses"
}

fn variantAlone(r: &Reply) i32 {
  match r {
    case let Number { 1 }                 //~ ErrorPatBindForm "puts the one name in its parentheses"
    else { 0 }
  }
}

// A declaration of a name takes no 'else', and a name before the variant in a let-else is refused
// once, the whole statement read past
fn nameBeforeVariantLetElse(r: &Reply) i32 {
  let n Number = r else { return 0; };    //~ ErrorPatBindForm "puts the binding in its parentheses"
  1
}

fn declarationElse(r: &Reply) i32 {
  let n: &Reply = r else { return 0; };   //~ ErrorPatBindForm "takes no 'else'"
  1
}

// Several names always take their values too: one error at the 'else', the statement read past
fn pair() (i32, i32) { (1, 2) }
fn declarationsElse() i32 {
  let a, b = pair() else { return 0; };   //~ ErrorPatBindForm:21 "declaration of names takes no 'else'"
  a
}

// 'var' goes in front of the pattern, in place of 'let', and nowhere else
fn varInsideCase(r: &Reply) i32 {
  match r {
    case let Number(var n) { n }          //~ ErrorBadTerm "Invalid term"
                                          //~^ ErrorNoRParen follow-on
    else { 0 }
  }
}
