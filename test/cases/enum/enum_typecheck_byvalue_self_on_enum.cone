// An enum's method that takes 'self' by value is each variant's own copy. A call on a value
// typed as a variant gets that variant's copy; a call on a value typed as the enum would have
// to read which variant's copy to run from the tag, which is not built for a value receiver,
// so it is refused (the variant being known by 'match' or by the value's type is the way).

mod enum_typecheck_byvalue_self_on_enum;

enum E {
  pub n i32;
  pub fn setN(mut self, v i32) Self { n = v; self; }
  pub fn total(self) i32 { n + 100; }
  pub struct A { pub a i32; }
  pub struct B;
}

fn variantValue() {
  imm x = E.A(0, 5).setN(1);
  imm t = E.B(2).total();
}

fn enumValue() {
  imm e E = E.A(0, 5);
  imm x = e.setN(1);                //~ ErrorEnumValueDispatch:12 "not built for a value receiver"
  imm t = e.total();                //~ ErrorEnumValueDispatch:12 "not built for a value receiver"
}

fn main() {}
