// A package declaring an enum whose method names the enum as its receiver
// ('self &Lamp'): one function over the whole enum, generated here, and the program
// that imports the enum calls its symbol. The enum's other methods ('self &') are
// copied into each variant as they always were.

mod q;

pub enum Lamp {
  pub n i32 = 7;
  Red;
  Green;
  Off;

  pub fn describe(self &Lamp) i32 {
    match self {
      case Red { 10 }
      case Green { 20 }
      case Off { 30 }
    }
  }
  pub fn code(self Lamp) i32 {
    match self {
      case Red { 1 }
      case Green { 2 }
      case Off { 3 }
    }
  }
  pub fn next(self &mut Lamp) {
    match self {
      case Red { *self = Lamp.Green; }
      case Green { *self = Lamp.Off; }
      case Off { *self = Lamp.Red; }
    }
  }
  pub fn perVariant(self &) i32 { n }
}

pub fn green() Lamp { Lamp.Green }
pub fn describeInside(l &Lamp) i32 { l.describe() }
