// A program calling the methods of an enum it did not declare. 'describe', 'code' and
// 'next' name the enum as their receiver and are q's one function each, called here by
// symbol; 'perVariant' is copied into each variant, as an imported enum's always was.
//
// Each printed value was checked by hand against q's source.

mod prog;

import stdio use *;
import q;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  imm g = q.green();
  show("describe", i64.from(g.describe()));            // 20
  imm r = q.Lamp.Red;
  show("describeVariant", i64.from(r.describe()));     // 10
  show("code", i64.from(g.code()));                    // 2
  show("inside", i64.from(q.describeInside(&g)));      // 20
  mut l q.Lamp = q.Lamp.Off;
  l.next();
  show("next", i64.from(l.code()));                    // 1
  show("perVariant", i64.from(r.perVariant()));        // 7
  // An empty variant named through the module, 'q.Lamp.Red': the call is on that variant constructed
  show("qualifiedPerVariant", i64.from(q.Lamp.Red.perVariant()));    // 7
  show("qualifiedDescribe", i64.from(q.Lamp.Green.describe()));      // 20
}
