// A method whose receiver names the enum ('self &mut Lamp') is one function over the
// whole enum (enum_method_receiver), and it may store any variant through that receiver. A
// value declared as one variant ('mut l Lamp.Red = Lamp.Red') cannot lend '&mut Lamp':
// Red could end up holding Green. A value declared as the enum can, as can a reference
// to one, and so can a 'var' variable that starts as a variant with no declared type,
// which is the enum (enum_mut_infers_enum).

mod enum_typecheck_method_receiver;

enum Lamp {
  Red;
  Green;

  pub fn next(self &mut Lamp) {
    match self {
      case Red { *self = Lamp.Green; }
      case Green { *self = Lamp.Red; }
    }
  }
}

fn variantValue() {
  var l Lamp.Red = Lamp.Red;
  l.next();                    //~ ErrorNoCandidate:4 "No method declared by `next` accepts the call's arguments."
}

fn enumValue() {
  var l Lamp = Lamp.Red;
  l.next();
}

fn main() {}
