// A generic enum's method whose receiver names the enum is one function over the
// whole enum (enum_method_receiver_generic), so a receiver naming another instance
// than the one being defined ('self: &Opt[i32]' in 'Opt[bool]') is refused once, as
// not the method's type, rather than once for each variant it would be copied into.

mod enum_typecheck_method_receiver_generic;

enum Opt[T] {
  Nada;
  Algo(T);
  pub fn other(self: &Opt[i32]) i32 { 1 }   //~ ErrorInvType
}
use Opt;

fn main() {
  var e: Opt[bool] = Nada[bool];
}
