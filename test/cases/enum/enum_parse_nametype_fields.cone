// What an enum declares takes a ':' between a name and its type, as every
// declared name does (core_parse_nametype holds the rule): a common field,
// and the place the tag itself is laid out, '_: tag'. The old spelling is
// refused with no word about the old way. So is a ':' after the enum's name
// with no integer type after it.

mod enum_parse_nametype_fields;

enum Colored: u8 {
  Fine = 1,
  Large = 3
}

enum Written: {                  //~ ErrorNoType
  Small;
}

enum Fielded {
  pub when i64;                  //~ ErrorNoSemi
  A;
}

enum Placed {
  pub wide: i64;
  _ tag;                         //~ ErrorNoSemi
  B;
}
