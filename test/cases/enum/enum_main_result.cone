// A 'main' returning a Result [Jon 26 Oct, error-handling issue 1]: when it fails, the
// error prints and the process exits with failure. The entry calls a function the
// compiler gave 'main' in its stead, which prints 'Error: ' and the error's
// text to stderr and answers 1; every module's 'final' runs as after any
// 'main'. What 'main' held is dropped as its early return leaves (fin1 below,
// printed to stdout before the error's line goes to stderr).
// enum_main_result_ok is the success, whose status is 0.

mod enum_main_result;

import stdio use *;
import collections use String;

struct Fin {
  pub id: i32;
  fn final(self: &uni) {
    printStr("fin");
    printInt(i64.from(self.id));
    printStr("\n");
  }
}

// The error meets core's Error, as the library's error types do
struct AppErr is Error {
  pub code: i32;
  pub fn toText(self: &, out: &uni TextOut) {
    out <- "step failed with code ", code;
  }
}

fn step(n: i32) Result[i32, AppErr] {
  if n > 2 { return Err(AppErr(n)); }
  Ok(n)
}

fn main() Result[void, AppErr] {
  let keep = Fin(1);
  printStr("start\n");
  let a = step(1)?;
  printStr("first step\n");
  let b = step(a + 2)?;
  printStr("never printed\n");
  Ok(nil)
}
