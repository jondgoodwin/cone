// An '@unsized' enum has no single size, so a pointer to one has no stride: it
// is not moved by '+', '-', '+=', '-=', '++' or '--', before or after, and two
// of them have no difference. A pointer to a variant has one size and is moved
// as any other.

mod enum_typecheck_unsized_stride;

enum @unsized Node {
  pub kind: i32;

  struct Lit { pub val: i32; }
  struct Add { pub a: i64; pub b: i64; }
}
use Node;

fn add(p: *Node, n: usize) *Node {
  p + n                             //~ ErrorNoSize:5 "its value can't be reached by pointer arithmetic"
}

fn subtract(p: *Node, n: usize) *Node {
  p - n                             //~ ErrorNoSize:5 "reached by pointer arithmetic"
}

fn difference(p: *Node, q: *Node) usize {
  p - q                             //~ ErrorNoSize:5 "reached by pointer arithmetic"
}

fn addAssign(p: *Node) {
  var q = p;
  q += 1;                           //~ ErrorNoSize:5 "reached by pointer arithmetic"
}

fn subtractAssign(p: *Node) {
  var q = p;
  q -= 1;                           //~ ErrorNoSize:5 "reached by pointer arithmetic"
}

fn increment(p: *Node) {
  var q = p;
  ++q;                              //~ ErrorNoSize:3 "reached by pointer arithmetic"
}

fn decrement(p: *Node) {
  var q = p;
  --q;                              //~ ErrorNoSize:3 "reached by pointer arithmetic"
}

fn incrementAfter(p: *Node) {
  var q = p;
  q++;                              //~ ErrorNoSize:4 "reached by pointer arithmetic"
}

fn decrementAfter(p: *Node) {
  var q = p;
  q--;                              //~ ErrorNoSize:4 "reached by pointer arithmetic"
}

// One size, so a stride
fn variant(p: *Lit, q: *Lit) usize {
  var r = p + 1usize;
  r -= 1;
  ++r;
  r - q
}
