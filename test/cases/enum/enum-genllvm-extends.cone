// An extension may add no variant larger than its base's largest.
//
// While the variants are padded, the base's largest is what every one of them is
// laid out to -- including the ones the extension shares, which are the base's own
// declarations with one layout each. A wider addition would have to widen them, and
// which width a shared variant had would then depend on which of the two enums
// generation reached first.
//
// Generation stage, and it has to be: nothing before generation has a data layout
// to ask a size of. typemgmt-genllvm-recast checks a reinterpretation's size in the
// same place and for the same reason.
//
// '@unsized' pads nothing, so it has nothing to reconcile and adds variants of any
// size at all; enum-success extends Packet with a variant larger than either of
// its own.

enum Shape {
  pub kind i32;

  struct Circle { pub radius i32; }
  struct Rect { pub w i32; pub h i32; }
}

enum Bigger extends Shape {
  struct Cube {           //~ ErrorEnumExtendsSize:10 "An extension may not add a wider one"
    pub a i64;
    pub b i64;
    pub c i64;
  }
}

// The layout is generated for a type a value of which is built, so the program
// builds one
fn main() i32 {
  imm c Bigger = Bigger.Cube[1, 2i64, 3i64, 4i64];
  0i32;
}
