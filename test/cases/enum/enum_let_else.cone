// A binding that outlives an early exit, 'let Ok(n) = r else {...};' [let-else]: the
// variable is the binding of 'if let Ok(n) = r', and the 'else' runs when the value is
// another variant and must leave on every path -- 'return', 'break', 'continue', a call
// that does not return, or an 'if' or 'match' each of whose paths does. It takes what a
// binding takes (a copy of plain data, a move of an owner, a reference into a borrowed
// value) and may be 'var'.
//
// The finalizer prints its number, so the output is the whole assertion: what is
// finalized, and when. The expected lines are worked out by hand in the comments.

mod enum_let_else;

import stdio use *;

struct Fin {
  pub id: i32;
  fn final(self: &uni) {
    printStr("fin");
    printInt(i64.from(self.id));
    printStr(" ");
  }
}

fn num(n: i32) {
  printInt(i64.from(n));
  printStr(" ");
}
fn end() {
  printStr("|\n");
}

// Ok(4) -> "5 |"; Err -> "0 |", the else leaving
fn plain(r: Result[i32, i32]) i32 {
  let Ok(n) = r else { return 0; };
  return n + 1;
}

// A copy of plain data leaves the place whole: 'r' is used again after the binding.
// Ok(4) -> "4 ok |"
fn copied(r: Result[i32, Fin]) {
  let Ok(n) = r else { return; };
  num(n);
  if r is Ok { printStr("ok "); }
}

// A payload that moves moves out of the place, and is finalized with the binding at
// the function's end, after "end ". Some(Fin(7)) -> "end fin7 |"; None -> "none |"
fn moved(o: Option[Fin]) {
  let Some(f) = o else { printStr("none "); return; };
  printStr("end ");
}

// 'mut' changes the copy: 6 then the original is still 4. Some(4) -> "6 4 |"
fn mutated(o: Option[i32]) {
  var Some(n) = o else { return; };
  n = n + 2;
  num(n);
  let Some(m) = o else { return; };
  num(m);
}

// A reference matchee gives a reference into it, which changes it:
// 'imm n Ok = &mut r else' is an '&mut i32'. Ok(1) -> "10 |"
fn through(r: Result[i32, i32]) {
  var v = r;
  {
    let Ok(n) = &mut v else { return; };
    *n = 10;
  }
  let Ok(k) = v else { return; };
  num(k);
}

fn evenOf(i: i32) Option[i32] {
  if i % 2 == 0 { return Some(i); }
  return None;
}

// 'break' and 'continue' leave too. The odd numbers are skipped, the first even number
// past six ends it: 2 4 6 then done |
fn inLoop() {
  var i = 0;
  while i < 20 {
    i += 1;
    let Some(even) = evenOf(i) else { continue; };
    if even > 6 { break; }
    num(even);
  }
  printStr("done ");
}

// An 'else' that leaves through an 'if' each of whose branches leaves.
// None, true -> 1; None, false -> 2; Some(5) -> 5
fn branches(o: Option[i32], c: bool) i32 {
  let Some(n) = o else { if c { return 1; } else { return 2; } };
  n
}

// Through a match with an 'else', and a match that covers its value, one arm a call
// that does not return. None, 1 -> 10; None, 2 -> 20; Some(3) -> 3; None, true -> 30
fn matched(o: Option[i32], k: i32) i32 {
  let Some(n) = o else {
    match k {
      case 1 { return 10; }
      else { return 20; }
    }
  };
  n
}
fn covered(o: Option[i32], b: bool) i32 {
  let Some(n) = o else {
    match b {
      case true { return 30; }
      case false { panic("not reached"); }
    }
  };
  n
}

// A payload that moves is not reached on a path out through an inner 'if': only the
// binding finalizes it. Some(Fin(9)) -> "end fin9 |"; None, true -> "a |"; None, false -> "b |"
fn movedBranches(o: Option[Fin], c: bool) {
  let Some(f) = o else { if c { printStr("a "); return; } else { printStr("b "); return; } };
  printStr("end ");
}

// One branch breaks, the other continues: 2 4 then done |
fn breakOrContinue() {
  var i = 0;
  while i < 20 {
    i += 1;
    let Some(even) = evenOf(i) else { if i > 4 { break; } else { continue; } };
    num(even);
  }
  printStr("done ");
}

fn main() i32 {
  num(plain(Ok[i32, i32](4))); end();
  num(plain(Err[i32, i32](9))); end();
  copied(Ok[i32, Fin](4)); end();
  moved(Some[Fin](Fin(7))); end();
  moved(None); end();
  mutated(Some[i32](4)); end();
  through(Ok[i32, i32](1)); end();
  inLoop(); end();
  num(branches(None[i32], true)); num(branches(None[i32], false)); num(branches(Some[i32](5), true)); end();
  num(matched(None[i32], 1)); num(matched(None[i32], 2)); num(matched(Some[i32](3), 2));
  num(covered(None[i32], true)); num(covered(Some[i32](4), true)); end();
  movedBranches(Some[Fin](Fin(9)), true); end();
  movedBranches(None, true); end();
  movedBranches(None, false); end();
  breakOrContinue(); end();
  0i32
}
