// A method called on an empty variant written by its name, 'Lamp.Red.get()', is called on
// that variant constructed: the name alone is the value (enum_construction), and a '.'
// after a value reaches its methods. Only a method (one that takes 'self') reads this
// way: a static function written after a variant's name, 'Lamp.Red.make()', is still
// the function the path names, and 'Lamp.make()' through the enum is untouched. A
// variant holding values is no value by its name alone, so its name stays a path (see
// enum_typecheck_variant_receiver). A generic enum's empty variant takes its type
// arguments from where the value goes or has them written, 'None[i32].isSome()'.
//
// Each printed value was checked by hand against the source.

mod enum_variant_receiver;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

enum Lamp {
  pub n i32 = 7;
  Red;
  Green;

  pub fn get(self &) i32 { n }
  pub fn make() i32 { 40 }
}

enum Pending[T] {
  pub k i32 = 5;
  Waiting;
  struct Done {pub v T;}

  pub fn key(self &) i32 { k }
}

use Lamp;

fn main() {
  show("path", i64.from(Lamp.Red.get()));           // 7
  show("parens", i64.from((Lamp.Red).get()));       // 7
  let l = Lamp.Green;
  show("variable", i64.from(l.get()));              // 7
  show("bare", i64.from(Red.get()));                // 7 (after 'use Lamp')
  show("static", i64.from(Lamp.make()));            // 40
  show("typed", i64.from(Pending.Waiting[i64].key()));    // 5
  show("sum", i64.from(Lamp.Green.get() + Red.get()));    // 14
}
