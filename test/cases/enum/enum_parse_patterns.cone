// The shape of a pattern binding: a permission, a name, a type, and -- for the
// single-pattern 'if' form -- the value to match against. And the shape of the
// patterns a '|' joins, each of which has to be one.
//
// Parse stage only. Each malformed pattern is in its own function so the
// parser's resynchronization from one cannot reach the next. Two of them
// resynchronize by skipping forward for a block-opening token, which reports a
// missing block on the way; those are the follow-on annotations.

mod enum_parse_patterns;

enum Shape {
  kind: i32;

  struct Circle {
    radius: i32;
  }

  struct Rect {
    w: i32;
    h: i32;
  }
}
use Shape;

// A binding may only be 'let' or 'var': a permission says nothing a match can act
// on
fn wrongPermission(s: &Shape) i32 {
  if ro &Circle(c) = s {c.radius} else {0}   //~ ErrorInvType:6 "starts with 'let' or 'var'"
}

// A binding is the name inside the variant. After a 'let' in a case goes the name a
// function's pattern binds, 'case let rest using f()'; a type there is no pattern
fn letThenType(s: &Shape) i32 {
  match s {
    case let &Circle {1}           //~ ErrorPatBindForm:14 "binds what a function's pattern gives back"
    else {0}
  }
}

// A name after 'let' is the name of a function's pattern, which 'using' must follow
fn letThenName(s: &Shape) i32 {
  match s {
    case let c {1}                 //~ ErrorPatBindForm:14 "binds what a function's pattern gives back"
    else {0}
  }
}

// The 'if' form binds against a value the condition names, unlike a match arm,
// whose value is the one the match already captured
fn noMatchedValue(s: &Shape) i32 {
  if let &Circle(c) {               //~ ErrorInvType:21 "Expected '=' followed by value to match against"
    1
  } else {                         //~ ErrorNoLCurly follow-on
    0
  }
}

// A pattern names only the variant: the matched value supplies the managed
// reference and its permission, so the retired spelling of one is refused
fn managedSpelling(s: Rc[mut, Shape]) i32 {
  match s {
    case +Rc-mut Circle(c) {c.radius}   //~ ErrorPatManaged:10 "Write 'Circle', not '+Rc-mut Circle'"
    else {0}
  }
}

// A value alone is a pattern: it means equality with the matched value. A
// condition is not one. As a value alone, 'not b' or 'n > 3' would be compared
// with the matched value, and a condition does not stand for a pattern -- the
// comparison '>3' and an 'if' guard say it -- so each is refused, at the start of
// a case, and after a '|'. A
// comparison or a '&&' after a value makes it a condition too. Each is reported
// once, its own '|' included, and the message names the comparison that leaves
// the matched value out, and the 'if' guard.
fn conditionAtStart(n: i32, b: bool) i32 {
  match n {
    case !b {1}                 //~ ErrorPatBare:10 "A condition is not a pattern"
    case n > 3 {2}                 //~ ErrorPatBare:10 "or put the condition in an 'if' guard"
    case 2 && b {3}               //~ ErrorPatBare:10 "A condition is not a pattern"
    else {4}
  }
}

fn conditionAfterOr(n: i32, b: bool) i32 {
  match n {
    case 2 | n > 3 {1}            //~ ErrorPatBare:14 "A condition is not a pattern"
    case 5 | !b {2}            //~ ErrorPatBare:14 "A condition is not a pattern"
    else {3}
  }
}

// '...' is no range operator: a range through its end is 'a ..= b', and one that
// stops before it 'a ..< b'
fn ellipsis(n: i32) i32 {
  match n {
    case 1 ... 3 {1}               //~ ErrorRangeEllipsis:12 "'a ..= b' runs through b"
    else {0}
  }
}
