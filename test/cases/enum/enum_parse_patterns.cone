// The shape of a pattern binding: a permission, a name, a type, and -- for the
// single-pattern 'if' form -- the value to match against. And the shape of the
// patterns an 'or' joins, each of which has to be one.
//
// Parse stage only. Each malformed pattern is in its own function so the
// parser's resynchronization from one cannot reach the next. Two of them
// resynchronize by skipping forward for a block-opening token, which reports a
// missing block on the way; those are the follow-on annotations.

mod enum_parse_patterns;

enum Shape {
  kind i32;

  struct Circle {
    radius i32;
  }

  struct Rect {
    w i32;
    h i32;
  }
}
use Shape;

// A binding may only be 'imm' or 'mut': the others say nothing a match can act
// on
fn wrongPermission(s &Shape) i32 {
  match s {
    case ro c &Circle {c.radius;}   //~ ErrorInvType:10 "Permission not valid for pattern match binding"
    else {0;}
  }
}

// The permission has to be followed by the name the narrowed value binds to
fn noBindingName(s &Shape) i32 {
  match s {
    case imm &Circle {1;}           //~ ErrorNoIdent:14 "Expected variable name for declaration"
                                   //~^ ErrorNoLCurly follow-on
    else {0;}
  }
}

// The type is what says which variant the arm matches, so it is not optional
// the way it is on an ordinary declaration with an initial value
fn noBindingType(s &Shape) i32 {
  match s {
    case imm c {1;}                 //~ ErrorInvType:16 "Expected type specification for pattern match binding"
    else {0;}
  }
}

// The 'if' form binds against a value the condition names, unlike a match arm,
// whose value is the one the match already captured
fn noMatchedValue(s &Shape) i32 {
  if imm c &Circle {               //~ ErrorInvType:20 "Expected '=' followed by value to match against"
    1;
  } else {                         //~ ErrorNoLCurly follow-on
    0;
  }
}

// Each pattern an 'or' joins is a pattern: 'is', a comparison, or a range. A
// value alone is not one: read as a condition, '3' would be true for every
// value matched.
fn bareValueAfterOr(n i32) i32 {
  match n {
    case ==2 or 3 {1;}              //~ ErrorPatBare:17 "A value alone is not a pattern"
    else {0;}
  }
}

// A case that begins with a value alone is refused too. Read as a condition,
// 'case true' would be taken for a false matched value and 'case 1' for every
// value; a named constant, a bare variant, a 'not' and a comparison that does
// not start with its operator are values alone as well. Each is refused once,
// its own 'or' included, and the message names '==' and 'is'.
fn bareBoolAtStart(b Bool) i32 {
  match b {
    case true {1;}                  //~ ErrorPatBare:10 "Write '==' before it"
    else {0;}
  }
}

fn bareIntAtStart(n i32) i32 {
  match n {
    case 1 {10;}                    //~ ErrorPatBare:10 "A value alone is not a pattern"
    case ==3 {30;}
    else {0;}
  }
}

fn bareStrAtStart(s &[]u8) i32 {
  match s {
    case "s" {1;}                   //~ ErrorPatBare:10 "A value alone is not a pattern"
    else {0;}
  }
}

const K = 3;
fn bareConstAtStart(n i32) i32 {
  match n {
    case K or 4 {1;}                //~ ErrorPatBare:10 "A value alone is not a pattern"
    else {0;}
  }
}

fn bareVariantAtStart(s &Shape) i32 {
  match s {
    case Circle {1;}                //~ ErrorPatBare:10 "or 'is' before a variant"
    else {0;}
  }
}

fn bareConditionAtStart(n i32, b Bool) i32 {
  match n {
    case not b {1;}                 //~ ErrorPatBare:10 "A value alone is not a pattern"
    case n > 3 {2;}                 //~ ErrorPatBare:10 "A value alone is not a pattern"
    else {3;}
  }
}
