// A variant's name before a '.' makes a method call its value's, but a variant has
// no static function of its own to reach: the enum's is 'Lamp.make()', and
// 'Lamp.Red.make()' names nothing.

mod enum_nameres_variant_static;

enum Lamp {
  Red;
  Green;

  pub fn make() i32 { 40 }
}

fn main() {
  let a = Lamp.Red.make();    //~ ErrorUnkName:20 "The name make does not refer to a declared name"
}
