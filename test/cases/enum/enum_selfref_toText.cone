// An enum whose 'self: &' toText is 'inline' and calls a helper written over the whole
// enum, sent as text and called directly, on a variant and on a value of the whole
// enum, which dispatches on the tag. Hand-checked: One writes "one", Two "two".

mod enum_selfref_toText;
import stdio use *;
import collections use *;

enum Bad is Error, Sendable {
  One;
  Two;
  pub fn toText(self: &, out: &uni TextOut) inline { self.write(out); }
  fn write(self: &Bad, out: &uni TextOut) inline {
    match self {
      case is One { out <- "one"; }
      case is Two { out <- "two"; }
    }
  }
}

fn show(e: Bad) { print <- e, "\n"; }

fn pick(n: i32) Result[i32, Bad] {
  if n == 1i32 { Err[i32, Bad](Bad.One) } else { Ok[i32, Bad](n) }
}

fn main() i32 {
  let e = Bad.Two;
  print <- e, "\n";
  show(Bad.One);
  show(Bad.Two);
  let s = String() <- Bad.One;
  print <- s, "|", s.len(), "\n";
  match pick(1i32) {
    case let Err(x) { print <- x, "\n"; }
    case is Ok { print <- "ok\n"; }
  }
  0
}
