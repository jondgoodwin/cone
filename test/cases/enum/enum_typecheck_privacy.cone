// An enum's private members, and its variants', are private to the module that
// declares the enum, as every type's are: all of the module's code reaches
// them through any value, not only the code inside the enum's braces
// (enum_privacy runs that). So none of these is refused: a function of the
// module, a generic function instantiated from inside the enum, a sibling
// extension, and the base reaching into what extends it. What a module
// outside reaches is module_privacy_typecheck's.
//
// Type-check stage: the file compiles with no diagnostic.

mod enum_typecheck_privacy;

enum Gauge {
  pub id i32;
  secret i32;

  struct Low {
    lo i32;
    fn half(self &) i32 {lo / 2;}
  }

  struct High {
    pub hi i32;
  }

  // A generic function is the module's, wherever it is instantiated from
  pub fn viaGeneric(l &Low) i32 {peekLo[i32](l, 1);}
}

// A function of the module reads, calls and builds what is private
fn outside(g &Gauge, l &Gauge.Low) i32 {
  imm a = l.lo;
  imm b = l.half();
  imm c = g.secret;
  a + b + c;
}

fn build() Gauge.Low {
  Gauge.Low[1, 2, 3];
}

fn peekLo[T](l &Gauge.Low, t T) i32 {
  l.lo;
}

// Two extensions of one enum, and the base, are all the module's
enum Warm extends Gauge {
  struct Ember {
    ember i32;
    pub fn peekFrost(self &, f &Cold.Frost) i32 {
      f.frost;
    }
    pub fn peekColdCopy(self &, l &Cold.Low) i32 {
      l.lo;
    }
  }
}

enum Cold extends Gauge {
  struct Frost {
    frost i32;
  }
}

enum Base {
  pub id i32;
  struct Plain {}
  pub fn peekAdded(a &Added.Extra) i32 {
    a.extra;
  }
}

enum Added extends Base {
  struct Extra {
    extra i32;
  }
}
