// What a variant declared as a type does not offer. It holds its contents with no
// field name, so a program cannot write '.value' (or any other name) to reach
// them: the message says so and says how to get them, a pattern that binds the
// variant. And a pattern that binds one through a managed reference (an Rc, an
// So) cannot lend what it holds yet, so it is refused where it is written, with
// the remedy.

mod enum_typecheck_variant_forms;

// A value of the variant itself has no field to read
fn viaField() {
  imm s = Some[5i32];
  imm n = s.value;           //~ ErrorNoMbr:12 "`value` is not a field of Some: Some is declared as a type, so what it holds has no field name"
}

// An 'imm' Rc shares the value, so its variant may be narrowed; its contents
// cannot be lent as the binding yet
fn viaManaged(r Rc[imm, Option[i32]]) i32 {
  match r {
    case imm n +Rc-imm Some { 1; }   //~ ErrorTypeVariant:14 "cannot lend the contents of Some as a binding yet"
    else { 0; }
  }
}
