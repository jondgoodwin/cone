// A copy of a '&mut' borrow of a local enum is another name for it. A reference narrowed
// into a variant through one copy was followed as the only name's, so another copy stored
// another variant while it was still to be used, and the payload was read as the old
// variant's (enum_narrow_mut_copy_success holds what stays accepted).

mod enum_flow_narrow_mut_copy;

import stdio use *;

enum Slot {
  struct Whole { pub n: i64; }
  struct Real { pub f: f64; }
}
use Slot;

fn set(a: &mut Slot) { *a = Real(1.5f64); }

fn copiedBefore() {
  var s: Slot = Whole(7i64);
  let r = &mut s;
  let r2 = r;
  if let Whole(w) = r {
    *r2 = Real(1.5f64);
    printInt(w.n);                       //~ ErrorVariantReshape
  }
}

fn copiedInside() {
  var s: Slot = Whole(7i64);
  let r = &mut s;
  if let Whole(w) = r {
    let r2 = r;
    *r2 = Real(1.5f64);
    printInt(w.n);                       //~ ErrorVariantReshape
  }
}

fn nameTested() {
  var s: Slot = Whole(7i64);
  let r = &mut s;
  let r2 = r;
  if r is Whole {
    *r2 = Real(1.5f64);
    printInt(r.n);                       //~ ErrorVariantReshape
  }
}

fn toACallee() {
  var s: Slot = Whole(7i64);
  let r = &mut s;
  if let Whole(w) = r {
    set(r);
    printInt(w.n);                       //~ ErrorVariantReshape
  }
}
