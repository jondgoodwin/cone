// Inside an enum's braces its variants' names come first, over a struct of the
// module with the same name. The errors that follow from meaning the struct are
// reported where values meet the types; a note says at the name that it is the
// variant.

mod enum_variant_shadows_struct;

struct Circle {
  pub r: i64;
}

// 'Circle' in the parentheses is the variant itself
enum Shape {
  Circle(&Circle);
  Dot;
}

fn build(c: &Circle) {
  let s = Shape.Circle(c); //~ ErrorLitFieldType
}

fn main() i32 {
  0i32
}
