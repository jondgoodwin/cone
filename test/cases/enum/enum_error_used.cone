// The control for enum_error_unused: a 'main' returning an error does print through
// core's 'Error.reportFailure', so a program is given its body there and only there.

mod enum_error_used;

struct Bad is Error, Sendable {
  pub fn toText(self: &, out: &uni TextOut) { out <- "bad"; }
}

fn main() Result[i32, Bad] { Err[i32, Bad](Bad()) }
