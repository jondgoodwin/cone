// The columns of 'match a, b' [topic 6d]: a case gives one pattern for each value
// matched, '_' standing for a value it does not care about, and '_' belongs to no
// other match. A pattern in a column tests, and binds nothing: whether a column may
// bind a variable is not decided. enum_typecheck_match_cover is what a match must cover.

mod enum_parse_match_columns;

enum Lamp {
  Red;
  Green;
  Blink(i32);
}
use Lamp;

fn wildInOneValue(n i32) i32 {
  match n {
    case 0 { 1; }
    case _ { 2; }        //~ ErrorMatchColumn:10 "'_' is the pattern of one of the values of 'match a, b'"
    else { 3; }
  }
}

fn tooFewPatterns(l Lamp, up bool) i32 {
  match l, up {
    case Red { 1; }      //~ ErrorMatchColumn:14 "This case has 1 pattern and the match has 2 values"
    else { 2; }
  }
}

fn tooManyPatterns(l Lamp, up bool) i32 {
  match l, up {
    case Red, true, true { 1; }   //~ ErrorMatchColumn:19 "more patterns than the match has values"
    else { 2; }
  }
}

fn bindingInAColumn(l Lamp, up bool) i32 {
  match l, up {
    case let n Blink, true { n; }   //~ ErrorMatchColumn:14 "does not bind a variable"
    else { 2; }
  }
}
