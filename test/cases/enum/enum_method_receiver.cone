// An enum's method with a body is written two ways, and the receiver decides which.
//
// 'self: &' (or 'self: &Self') is the variant: the method is copied into each variant, as a
// trait's default method is, and inside each copy 'self' is that variant. A receiver that
// names the enum, 'self: &Lamp', is ONE function over the whole enum: 'self' is the enum,
// so 'match self' and 'self is Red' work, and the method is called on an enum value or on
// a value of one of its variants alike, a variant widened to the enum. Any reference kind
// names the enum, '&', '&mut', or by value, 'self Lamp'.
//
// A variant may declare a method of the same name as one over the whole enum ('Shade'):
// a value typed as the variant gets the variant's own, a value typed as the enum gets the
// enum's. A variant value calling a method that takes '&mut' of the enum is refused
// (enum_typecheck_method_receiver), since the method could store another variant in it.
//
// Each printed value was checked by hand against the source.

mod enum_method_receiver;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

enum Lamp {
  pub n: i32 = 7;
  Red;
  Green;
  Off;

  // One function over the enum: 'match self' reaches a variant
  pub fn describe(self: &Lamp) i32 {
    match self {
      case Red { 10 }
      case Green { 20 }
      case Off { 30 }
    }
  }
  // 'self is Red' narrows the same way
  pub fn isRed(self: &Lamp) bool { self is Red }
  // By value
  pub fn code(self: Lamp) i32 {
    match self {
      case Red { 1 }
      case Green { 2 }
      case Off { 3 }
    }
  }
  // Through a mutable reference, it changes the value
  pub fn next(self: &mut Lamp) {
    match self {
      case Red { *self = Lamp.Green; }
      case Green { *self = Lamp.Off; }
      case Off { *self = Lamp.Red; }
    }
  }
  // The variant's: copied into each variant
  pub fn perVariant(self: &) i32 { n }
}

fn viaRef(l: &Lamp) i32 { l.describe() }

enum Shade {
  pub k: i32 = 3;
  struct Dark {
    pub fn tone(self: &) i32 { 99 }
  }
  Light;

  pub fn tone(self: &Shade) i32 {
    match self {
      case is Dark { 1 }
      case is Light { 2 }
    }
  }
  // 'Self' names the implementer, so this one is copied into each variant
  pub fn depth(self: &Self) i32 { k }
}

fn main() {
  let r = Lamp.Red;
  let g = Lamp.Green;
  show("describeRed", i64.from(r.describe()));          // 10
  show("describeGreen", i64.from(g.describe()));        // 20
  show("describeOff", i64.from(Lamp.Off.describe()));   // 30
  show("viaRef", i64.from(viaRef(&Lamp.Green)));        // 20
  show("isRed", if r.isRed() {1} else {0});           // 1
  show("isRedG", if g.isRed() {1} else {0});          // 0
  show("code", i64.from(g.code()));                      // 2
  show("perVariant", i64.from(r.perVariant()));          // 7
  var l: Lamp = Lamp.Red;
  l.next();
  show("next1", i64.from(l.describe()));                 // 20
  l.next();
  show("next2", i64.from(l.describe()));                 // 30
  l.next();
  show("next3", i64.from(l.describe()));                 // 10

  let dark = Shade.Dark;
  let light = Shade.Light;
  let asEnum: Shade = Shade.Dark;
  show("variantOwn", i64.from(dark.tone()));             // 99: Dark's own
  show("enumOwn", i64.from(asEnum.tone()));              // 1: the enum's, Dark inside
  show("lightEnum", i64.from(light.tone()));             // 2: Light has none of its own
  show("depth", i64.from(dark.depth()));                 // 3: copied into the variant
}
