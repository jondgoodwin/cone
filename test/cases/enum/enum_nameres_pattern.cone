// An unknown name under a pointer or an array reference in a bound pattern.
//
// A bound pattern desugars to an 'is' test and a conversion that share one type
// node. Only a bare name, or one under a reference, is looked up in the matched
// value's enum; any other shape is resolved as written, here, and reported once
// by name resolution rather than once per node holding it.

mod enum_nameres_pattern;

struct Pt {
  x i32;
}

fn underPointer(p &Pt) i32 {
  if imm v *Nope = p {1;} else {2;}     //~ ErrorUnkName:13 "The name Nope does not refer to a declared name"
}

fn underArrayRef(p &Pt) i32 {
  if imm v &[]Nope = p {1;} else {2;}   //~ ErrorUnkName:15 "The name Nope does not refer to a declared name"
}
