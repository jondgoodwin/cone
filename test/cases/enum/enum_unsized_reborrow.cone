// '&*s' of a reference to an '@unsized' enum borrows with the permission and
// type a '&*s' of a plain struct has: its fields are read through it, and it is
// returned as the reference '&Node'. 'Pair' is the plain struct, as a control.

mod enum_unsized_reborrow;

import stdio use *;

enum @unsized Node {
  pub kind: i32;

  struct Lit { pub val: i32; }
  struct Add { pub a: i64; pub b: i64; }
}
use Node;

struct Pair { pub kind: i32; }

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn read(s: &Node) i32 {
  let x = &*s;
  x.kind
}

fn again(s: &Node) &Node {&*s}

fn readMut(s: &mut Node) i32 {
  let x = &*s;
  x.kind
}

fn readPair(s: &Pair) i32 {
  let x = &*s;
  x.kind
}

fn againPair(s: &Pair) &Pair {&*s}

fn main() {
  var lit = Lit(1, 5);
  var add = Add(2, 30i64, 4i64);
  let pair = Pair(3);

  show("read-lit", i64.from(read(&lit)));
  show("read-add", i64.from(read(&add)));
  show("returned", i64.from(again(&add).kind));
  show("read-mut", i64.from(readMut(&mut lit as &mut Node)));
  match again(&lit) {
    case let &Lit(l) {show("matched-lit", i64.from(l.val));}
    case let &Add(a) {show("matched-add", a.a);}
  }
  show("read-pair", i64.from(readPair(&pair)));
  show("returned-pair", i64.from(againPair(&pair).kind));
}
