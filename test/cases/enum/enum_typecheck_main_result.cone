// A 'main' returning a Result prints its error through core's Error, or with the
// error's 'report()' where the type does not meet it, so an error type with neither
// is refused, at the return type.

mod enum_typecheck_main_result;

struct Silent { pub code: i32; }

fn main() Result[void, Silent] {   //~ ErrorMainResult:17 "Silent is not an Error and declares no 'report(self: &)'"
  Ok(nil)
}
