// A 'main' returning a Result prints its error with the error's 'message()' when it
// fails, so an error type without one is refused, at the return type. (Until core
// has its error trait, the method is asked for by name.)

mod enum_typecheck_main_result;

struct Silent { pub code: i32; }

fn main() Result[void, Silent] {   //~ ErrorMainResult:17 "Silent declares no 'message(self: &)'"
  Ok(nil)
}
