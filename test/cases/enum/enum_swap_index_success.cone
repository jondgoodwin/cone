// What is accepted beside enum_flow_swap_index: a swap in a variant whose other side only
// reads, or calls something that only reads the enum; and a swap of two parts of one
// variant.

mod enum_swap_index_success;

import stdio use *;

enum Slot {
  struct Text { pub s: &str; }
  struct Num { pub a: usize; pub r: Array[usize, 3]; }
}
use Slot;

fn look(m: &Slot) usize { 1usize }

fn show(n: usize) {
  printInt(i64.from(n));
  printStr(" ");
}

fn f(n: &'a mut Slot, m: &'a Slot) {
  var x = [100usize, 200usize];
  var i = 0usize;
  if n is Num {
    n.r[0usize] <-> x[i];                 // r is 100 3 4, x is 2 200
    n.a <-> x[look(m)];                   // a is 200, x is 2 1
    n.r[i] <-> n.r[i + 1usize];           // r is 3 100 4
    show(n.a); show(n.r[0usize]); show(n.r[1usize]); show(n.r[2usize]); show(x[0usize]); show(x[1usize]);
    printStr("\n");
  }
}

fn main() {
  var s: Slot = Num(1usize, [2usize, 3usize, 4usize]);
  let a = &mut s;
  f(a, a);
}
