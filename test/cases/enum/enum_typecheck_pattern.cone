// What a pattern's bare name may fail to name.
//
// A bare variant in a pattern is looked up in the enum of the value being matched
// first, and lexically only when that enum has no variant of the name. The
// matched value's type is known only at type check, so a pattern name that
// nothing answers is left unbound by name resolution and reported here, once,
// by the 'is' test the pattern desugars to -- not again by the conversion and
// the variable that share its type.

mod enum_typecheck_pattern;

enum Colors {
  Red, Green;
}

enum Maybe[T] {
  struct Just {
    pub v T;
  }

  struct Nada {}
}

struct Pt {
  x i32;
}

// A name that is neither a variant of the matched enum nor anything in scope
fn unknownCase(c Colors) i32 {
  match c {
    case is Purple {1;}   //~ ErrorUnkName:13 "The name Purple does not refer to a declared name"
    else {0;}
  }
}

fn unknownIs(c Colors) Bool {
  c is Purple;            //~ ErrorUnkName:8 "The name Purple does not refer to a declared name"
}

// A bound pattern through a reference, the shape a missing 'use' in front of
// 'case imm c &Red' reaches. The binding is still usable in the arm: it takes its
// type from the pattern, which has already been reported, so nothing else is.
fn unknownBound(p &Pt) i32 {
  if imm v &Nope = p {v.x;} else {2;}   //~ ErrorUnkName:13 "The name Nope does not refer to a declared name"
}

fn unknownElif(c &Colors) i32 {
  if imm r &Red = c {1;}
  elif imm w &Nope = c {2;}             //~ ErrorUnkName:15 "The name Nope does not refer to a declared name"
  else {3;}
}

// The matched value supplies a generic variant's type arguments. Written anyway
// on a name only the matched enum has, they are refused, with the two spellings
// that work.
fn writtenArgs(m Maybe[i32]) i32 {
  match m {
    case imm j Just[i32] {j.v;}   //~ ErrorPatArgs:16 "Drop the arguments, or name the variant through its enum, as Maybe.Just"
    else {0;}
  }
}

// A pattern narrows to a type. A name that means a value is not one.
fn valuePattern(p &Pt, x i32) i32 {
  if imm v &x = p {1;} else {2;}        //~ ErrorNotType:13 "x is not a type, so a pattern cannot narrow to it"
}
