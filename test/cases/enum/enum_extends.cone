// An enum that extends another holds COPIES of its base's variants, then its own.
//
// CardKind below has variants CardKind.Clubs .. CardKind.Spades, each its own
// type with Suit's tag value, followed by Joker and Back. Suit.Clubs is a Suit and
// CardKind.Clubs is a CardKind; neither is a value of the other enum, and
// enum-typecheck-extends holds those refusals in both directions. What this file
// claims is what the copies give: each enum lays out its own set, so the base is
// never constrained by what extends it and the extension by what the base chose.
// A later section does the same with a generic enum on either side of the
// clause, Option itself among them, the next extends an extension, the next
// gives an extension methods and statics of its own, which reach its copies, and
// the last names its bases' members bare inside its braces.
//
// Everything is printed, because a match that compiles is not a match that
// dispatched to the right arm. What runtime cannot see -- that an Option-shaped
// base keeps the bare-pointer layout while its extension is tagged, and that each
// set is padded to its own largest variant -- is asserted by the named checks in
// cases.toml.

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// -------- the extension's set: copies, then its own --------

enum Suit {
  Clubs, Diamonds, Hearts, Spades;
}

enum CardKind extends Suit {
  Joker, Back;
}

// Exhaustive over the base's own four, with no arm for anything the extension
// added: a Suit only ever holds one of Suit's variants
fn suitRank(s Suit) i32 {
  match s {
    case is Clubs {1;}
    case is Diamonds {2;}
    case is Hearts {3;}
    case is Spades {4;}
  }
}

// Exhaustive over the extension's six. A bare name in a pattern is looked up in
// the matched value's enum, so on a CardKind 'Hearts' is CardKind's copy
fn cardRank(c CardKind) i32 {
  match c {
    case is Clubs {1;}
    case is Diamonds {2;}
    case is Hearts {3;}
    case is Spades {4;}
    case is Joker {5;}
    case is Back {6;}
  }
}

// The qualified pattern names the copy the same way
fn isHearts(c &CardKind) i32 {
  if c is &CardKind.Hearts {1;} else {0;}
}

fn copiesAndMembership() {
  imm hearts Suit = Suit.Hearts[];
  show("base-variant-in-base", suitRank(hearts));
  imm copied CardKind = CardKind.Hearts[];
  show("copied-variant-in-extension", cardRank(copied));
  imm added CardKind = CardKind.Back[];
  show("added-variant-in-extension", cardRank(added));
  show("qualified-pattern-names-the-copy", isHearts(&copied));
  show("qualified-pattern-other-variant", isHearts(&added));

  // Two branches of differing variant type, one a copy and one added, infer the
  // extension, whose set holds both
  imm chosen = if hearts is Hearts {CardKind.Spades[];} else {CardKind.Joker[];};
  show("branch-inference-copy-and-added", cardRank(chosen));
}

// -------- a 'use' folds every variant, the copies too --------

// This module folds no Suit; 'use CardKind;' brings in CardKind's six, so the
// bare names below build CardKind's copies. Bare in a pattern on a Suit, 'Clubs'
// still means Suit.Clubs: the matched value's enum is asked first.
use CardKind;

fn foldedNames() {
  imm c CardKind = Clubs[];
  show("folded-copy-constructs", cardRank(c));
  imm j CardKind = Joker[];
  show("folded-added-constructs", cardRank(j));
  show("base-pattern-on-base-value", suitRank(Suit.Clubs[]));
}

// -------- methods on the base's variants --------

// A requirement on the base, implemented by each variant, dispatches through the
// extension's copies: each copy carries its own copy of the implementation, owned
// by the extension. The tags are pinned sparse, so building a virtual reference
// selects the vtable by comparing tag values -- the copies' values, which are the
// base's.
enum Signals u32 {
  pub fn weight(self &) i32;

  pub struct Quiet = 0x10 {
    pub n i32;
    pub fn weight(self &) i32 {n;}
  }

  pub struct Loud = 0x2000 {
    pub n i32;
    pub fn weight(self &) i32 {n * 100;}
  }
}

enum MoreSignals extends Signals {
  pub struct Silent {
    pub n i32;
    pub fn weight(self &) i32 {0;}
  }
}

fn weigh(s &Signals) i32 {
  s.weight();
}

fn weighMore(s &MoreSignals) i32 {
  s.weight();
}

fn methodsThroughCopies() {
  imm quiet Signals = Signals.Quiet[3];
  imm loud MoreSignals = MoreSignals.Loud[5];
  imm silent MoreSignals = MoreSignals.Silent[7];
  show("base-method-in-base", weigh(&quiet));
  show("base-method-through-copy", weighMore(&loud));
  show("added-variant-method", weighMore(&silent));
  imm vl &<MoreSignals = &loud;
  show("copy-through-virtual-reference", vl.weight());
  imm q = MoreSignals.Quiet[4];
  show("copy-method-called-directly", (&q).weight());
}

// -------- the base keeps its own layout --------

// Option-shaped: two variants, one empty and one holding a single reference. Maybe
// is laid out as a bare pointer with no tag, where null is Nothing, and extending
// it does not change that. MaybeMore has a third variant, for which there is no
// pointer to be, so it is tagged.
enum Maybe {
  struct Nothing {}
  struct Just { pub p &i32; }
}

enum MaybeMore extends Maybe {
  struct Waiting {}
}

fn readMaybe(m &Maybe) i32 {
  match m {
    case imm j &Just {*j.p;}
    case is &Nothing {-1i32;}
  }
}

fn readMaybeMore(m &MaybeMore) i32 {
  match m {
    case imm j &Just {*j.p;}
    case is &Nothing {-1i32;}
    case is &Waiting {-2i32;}
  }
}

fn optionShapedBase() {
  imm v = 41;
  imm base Maybe = Maybe.Just[&v];
  imm none Maybe = Maybe.Nothing[];
  show("option-shaped-base-just", readMaybe(&base));
  show("option-shaped-base-nothing", readMaybe(&none));
  imm ext MaybeMore = MaybeMore.Just[&v];
  imm extnone MaybeMore = MaybeMore.Nothing[];
  imm waiting MaybeMore = MaybeMore.Waiting[];
  show("extension-just", readMaybeMore(&ext));
  show("extension-nothing", readMaybeMore(&extnone));
  show("extension-added", readMaybeMore(&waiting));
}

// -------- each set is padded to its own largest --------

// A padded extension may add a variant larger than anything its base holds. The
// extension's copies are padded to it; the base's own variants are not.
enum Shape {
  pub kind i32;

  struct Circle { pub radius i32; }
  struct Rect { pub w i32; pub h i32; }
}

enum Solid extends Shape {
  struct Cube { pub a i64; pub b i64; pub c i64; }
}

fn solidSize(s &Solid) i32 {
  match s {
    case imm c &Circle {c.radius;}
    case imm r &Rect {r.w * r.h;}
    case imm q &Cube {i32[q.a + q.b + q.c];}
  }
}

fn shapeKind(s Shape) i32 {
  s.kind;
}

fn largerAddedVariant() {
  imm cube Solid = Solid.Cube[1, 2i64, 3i64, 4i64];
  imm rect Solid = Solid.Rect[2, 3, 5];
  show("larger-added-variant", solidSize(&cube));
  show("copy-padded-to-the-addition", solidSize(&rect));
  show("common-field-through-the-extension", cube.kind);
  show("base-by-value-unchanged", shapeKind(Shape.Circle[6, 1]));
}

// -------- the two may disagree about '@unsized' --------

// A padded base extended by an '@unsized' enum: the copies are laid out unpadded,
// and the base's own variants stay padded. And the other way round: an '@unsized'
// base extended by a padded enum, whose copies are padded to its largest.
enum Packed {
  pub id i32;

  struct Ping {}
  struct Payload { pub a i64; }
}

enum @unsized Loose extends Packed {
  struct Huge { pub a i64; pub b i64; pub c i64; pub d i64; }
}

fn looseSize(p &Loose) i32 {
  match p {
    case is &Ping {0;}
    case imm d &Payload {i32[d.a];}
    case imm h &Huge {i32[h.a + h.b + h.c + h.d];}
  }
}

enum @unsized Message {
  pub stamp i32;

  struct Text { pub len i32; }
  struct Blob { pub a i64; pub b i64; }
}

enum Framed extends Message {
  struct Empty {}
}

fn framedSize(m Framed) i32 {
  match m {
    case imm t Text {t.len;}
    case imm b Blob {i32[b.a + b.b];}
    case is Empty {0;}
  }
}

fn messageSize(m &Message) i32 {
  match m {
    case imm t &Text {t.len;}
    case imm b &Blob {i32[b.a + b.b];}
  }
}

fn unsizedDisagreement() {
  imm ping = Loose.Ping[1];
  imm huge = Loose.Huge[2, 1i64, 2i64, 3i64, 4i64];
  show("unsized-extension-of-padded-copy", looseSize(&ping));
  show("unsized-extension-of-padded-added", looseSize(&huge));
  show("unsized-extension-common-field", huge.id);
  show("padded-base-unchanged", i64[Packed.Payload[3, 9i64].a]);

  // A padded extension of an '@unsized' base holds values by value
  mut f Framed = Framed.Blob[1, 4i64, 5i64];
  show("padded-extension-of-unsized-by-value", framedSize(f));
  f = Framed.Text[2, 6];
  show("padded-extension-reassigned", framedSize(f));
  imm text = Message.Text[3, 8];
  show("unsized-base-unchanged", messageSize(&text));
}

// -------- a generic enum extends and is extended --------

// Option is generic, so what an enum extends is one of its instances, written with
// its arguments. Pending passes its own parameter on: its copies are Option's
// variant templates with Pending's T in place of Option's, so each is a generic
// template of Pending, and an instance of Pending instantiates them with the
// variant it adds.
enum Pending[T] extends Option[T] {
  Waiting;
}

// A bare pattern on an instance of the extension finds the instance's copies, and
// the matched value supplies Some's argument
fn pendingOr(p &Pending[i32], dflt i32) i32 {
  match p {
    case imm s &Some {s.value;}
    case is &None {dflt;}
    case is &Waiting {-1i32;}
  }
}

// The second instantiation, at a reference. Pending[&i32] is tagged, since its
// third variant leaves no pointer to be, and Option[&i32] is still a bare pointer:
// the two are laid out apart, as a base and its extension always are.
fn pendingRef(p &Pending[&i32]) i32 {
  match p {
    case imm s &Some {*s.value;}
    case is &None {0i32;}
    case is &Waiting {-1i32;}
  }
}

fn optionRef(o &Option[&i32]) i32 {
  match o {
    case imm s &Some {*s.value;}
    case is &None {0i32;}
  }
}

// Inside a generic function the pattern is bound per instance
fn pendingAny[T](p Pending[T], dflt T) T {
  match p {
    case imm s Some {s.value;}
    case is None {dflt;}
    case is Waiting {dflt;}
  }
}

// An extension that is not generic extends an instance: its copies are Option's
// templates instantiated at i32 while IntOrWait is resolved, so they are ordinary
// variants
enum IntOrWait extends Option[i32] {
  Waiting;
}

fn intOrWait(p IntOrWait) i32 {
  match p {
    case imm s Some {s.value;}
    case is None {0i32;}
    case is Waiting {-1i32;}
  }
}

// A generic extension of a generic enum declared here, whose variant carries a
// payload and a method of its own, and whose enum gives every variant a method
enum Chance[T] {
  pub fn weight(self) i32 {1;}

  struct Miss {}
  struct Hit {
    pub v T;
    pub fn twice(self) T {v + v;}
  }
}

enum ChanceMore[T] extends Chance[T] {
  struct Pair { pub a T; pub b T; }
}

fn chanceMore(c ChanceMore[i32]) i32 {
  match c {
    case is Miss {0i32;}
    case imm h Hit {h.twice() * 10 + h.weight();}
    case imm p Pair {p.a + p.b;}
  }
}

// The parameters passed on crosswise: Flip's T is Result's E and Flip's E is
// Result's T, so Flip.Ok holds an E and Flip.Error a T. Substitution goes by the
// parameters' names, so this is the case that would take one for the other.
enum Flip[T, E] extends Result[E, T] {
  Neither;
}

fn flip(f Flip[i32, i64]) i64 {
  match f {
    case imm o Ok {o.value;}
    case imm e Error {i64[e.value] * 10;}
    case is Neither {-1;}
  }
}

// A generic enum may extend one that is not. Its copies are Shape's and Signals'
// variants, which already hold their enum's fields and methods, and each becomes a
// generic template of the extension: the common field is read through them, and
// the requirement dispatches through them, per instance
enum Labeled[T] extends Shape {
  struct Label { pub text T; }
}

fn labeledKind(s Labeled[i64]) i32 {
  match s {
    case imm c Circle {c.kind * 10 + c.radius;}
    case imm r Rect {r.kind * 10 + r.w * r.h;}
    case imm l Label {l.kind * 10 + i32[l.text];}
  }
}

enum Weighed[T] extends Signals {
  pub struct Carry {
    pub n i32;
    pub v T;
    pub fn weight(self &) i32 {n + 1;}
  }
}

fn weighWeighed(s &Weighed[i64]) i32 {
  s.weight();
}

fn genericExtensions() {
  imm some Pending[i32] = Pending.Some[5];
  imm none Pending[i32] = Pending.None[i32][];
  imm waiting Pending[i32] = Pending.Waiting[i32][];
  show("generic-extension-copy", pendingOr(&some, 9));
  show("generic-extension-empty-copy", pendingOr(&none, 9));
  show("generic-extension-added", pendingOr(&waiting, 9));

  imm v = 23;
  imm psome Pending[&i32] = Pending.Some[&v];
  imm pwait Pending[&i32] = Pending.Waiting[&i32][];
  imm osome Option[&i32] = Some[&v];
  show("second-instance-copy", pendingRef(&psome));
  show("second-instance-added", pendingRef(&pwait));
  show("base-instance-unchanged", optionRef(&osome));

  show("generic-function-copy", pendingAny[i64](Pending.Some[7i64], 8i64));
  show("generic-function-added", pendingAny[i64](Pending.Waiting[i64][], 8i64));

  show("instance-extension-copy", intOrWait(IntOrWait.Some[4]));
  show("instance-extension-empty-copy", intOrWait(IntOrWait.None[]));
  show("instance-extension-added", intOrWait(IntOrWait.Waiting[]));

  show("user-generic-copy-methods", chanceMore(ChanceMore.Hit[6]));
  show("user-generic-added", chanceMore(ChanceMore.Pair[2, 3]));
  show("user-generic-empty-copy", chanceMore(ChanceMore.Miss[i32][]));

  show("crosswise-ok-holds-e", flip(Flip.Ok[i32, i64][12i64]));
  show("crosswise-error-holds-t", flip(Flip.Error[i32, i64][4]));

  show("generic-over-plain-copy", labeledKind(Labeled.Circle[i64][1, 5]));
  show("generic-over-plain-added", labeledKind(Labeled.Label[i64][2, 6i64]));
  imm loud Weighed[i64] = Weighed.Loud[i64][3];
  imm carry Weighed[i64] = Weighed.Carry[i64][8, 0i64];
  show("generic-over-plain-dispatch-copy", weighWeighed(&loud));
  show("generic-over-plain-dispatch-added", weighWeighed(&carry));
}

// -------- an extension may itself be extended --------

// Each level copies the one below it: Rich's copies of Colors' three, then Cyan
// and Magenta; Richer's copies of Rich's five, then Gold. So Richer has six
// variants, the deepest copies two hops from where they were declared, and every
// one keeps the tag value it had where it was declared. Green pins 0x100 and
// Colors declared no integer type, so the shared discriminant is two bytes wide at
// every level; numbering resumes after it, so Blue is 257, Cyan 258, Magenta 259
// and Gold 260.
enum Colors {
  Red, Green = 0x100, Blue;
}

enum Rich extends Colors {
  Cyan, Magenta;
}

enum Richer extends Rich {
  Gold;
}

// A bare pattern on a Richer finds Richer's own: a copy of a copy, a copy, and
// the one it added
fn richerCode(c Richer) i32 {
  match c {
    case is Red {1;}
    case is Green {2;}
    case is Blue {3;}
    case is Cyan {4;}
    case is Magenta {5;}
    case is Gold {6;}
  }
}

// The middle enum is still exhaustive over its own five, with no arm for Gold
fn richCode(c Rich) i32 {
  match c {
    case is Red {1;}
    case is Green {2;}
    case is Blue {3;}
    case is Cyan {4;}
    case is Magenta {5;}
  }
}

// The same with a generic enum at every level, each passing its parameter on
enum Box[T] {
  struct Has { pub v T; }
  Empty;
}

enum Box2[T] extends Box[T] {
  Soon;
}

enum Box3[T] extends Box2[T] {
  Later;
}

fn box3(b Box3[i32]) i32 {
  match b {
    case imm h Has {h.v;}
    case is Empty {0i32;}
    case is Soon {-1i32;}
    case is Later {77i32;}
  }
}

fn box2(b Box2[i32]) i32 {
  match b {
    case imm h Has {h.v;}
    case is Empty {0i32;}
    case is Soon {-1i32;}
  }
}

fn extensionChains() {
  show("chain-base-variant", richerCode(Richer.Red[]));
  show("chain-pinned-copy", richerCode(Richer.Green[]));
  show("chain-middle-variant", richerCode(Richer.Cyan[]));
  show("chain-deepest-variant", richerCode(Richer.Gold[]));
  show("chain-middle-own-set", richCode(Rich.Magenta[]));

  // A copy of a copy keeps the pinned value and the numbering after it, so a
  // comparison still tells each apart
  imm g Richer = Richer.Green[];
  show("chain-pinned-tag-equal", if g == Richer.Green[] {1;} else {0;});
  show("chain-pinned-tag-unequal", if g == Richer.Red[] {1;} else {0;});
  imm d Richer = Richer.Gold[];
  show("chain-deepest-tag-unequal", if d == Richer.Magenta[] {1;} else {0;});

  show("generic-chain-base-payload", box3(Box3.Has[i32][42]));
  show("generic-chain-base-empty", box3(Box3.Empty[i32][]));
  show("generic-chain-middle-variant", box3(Box3.Soon[i32][]));
  show("generic-chain-deepest-variant", box3(Box3.Later[i32][]));
  show("generic-chain-middle-own-set", box2(Box2.Has[i32][9]));
}

// -------- an extension's own methods and statics --------

// A method with a body that an extension declares is cloned into every variant of
// its set, as a base's is into its variants: into the variants it adds, and into
// its copies of the base's, which were written against the base and know nothing
// of it. So Choir.range is Choir.Tenor's too, and inside that clone 'self' is the
// copy, so a bare 'pitch()' and 'self.pitch()' are Tenor's own implementation. The
// base is not touched: Voice.Tenor has no range. Called on a reference to the
// extension, it is the variant's that runs, selected by the tag, as a base's
// method is -- which is also how a base's variant that declared the name itself
// keeps its own: Alto's range is Alto's, in Voice and in Choir alike.
//
// A static and a static function stay the extension's own, named bare from its
// methods and qualified from outside.
enum Voice {
  pub fn pitch(self &) i32;

  pub struct Bass {
    pub fn pitch(self &) i32 {1;}
  }
  pub struct Tenor {
    pub fn pitch(self &) i32 {2;}
  }
  pub struct Alto {
    pub fn pitch(self &) i32 {3;}
    pub fn range(self &) i32 {99;}
  }
}

enum Choir extends Voice {
  pub static stride i32 = 100;
  pub fn loudest() Choir {Choir.Soprano[];}
  pub fn range(self &) i32 {pitch() * 10 + self.pitch() + stride;}
  pub fn span(self &) i32 {range() + self.range();}

  pub struct Soprano {
    pub fn pitch(self &) i32 {4;}
  }
}

fn choirRange(c &Choir) i32 {
  c.range();
}

fn choirVirtual(c &<Choir) i32 {
  c.range();
}

fn plainExtensionMethods() {
  imm tenor = Choir.Tenor[];
  show("method-on-copy", (&tenor).range());
  show("method-on-copy-calls-bare-and-self", (&tenor).span());
  imm soprano = Choir.Soprano[];
  show("method-on-added", (&soprano).range());
  imm bass Choir = Choir.Bass[];
  show("method-through-extension-copy", choirRange(&bass));
  imm high Choir = Choir.Soprano[];
  show("method-through-extension-added", choirRange(&high));
  show("method-through-virtual-reference-copy", choirVirtual(&bass));
  show("method-through-virtual-reference-added", choirVirtual(&high));
  imm alto = Choir.Alto[];
  show("base-variant-keeps-its-own", (&alto).span());
  imm altos Choir = Choir.Alto[];
  show("base-variant-keeps-its-own-through-extension", choirRange(&altos));
  imm loud = Choir.loudest();
  show("static-function", choirRange(&loud));
  show("static", i64[Choir.stride]);
}

// The same over a generic base. Deferred[T] passes its parameter on to Option, and
// its methods take T; an instance's copies of Option's variants are given the
// instance's methods when they are type checked, as the variant it adds is. The
// static function is named bare from a method, since a generic enum's static is
// reached per instance.
enum Deferred[T] extends Option[T] {
  fn week() i32 {7;}
  pub fn dup(self &, x T) T {x + x;}
  pub fn quad(self &, x T) T {dup(x) + self.dup(x);}
  pub fn weeks(self &, n i32) i32 {n * week();}

  Later;
}

fn deferredQuad(d &Deferred[i32], x i32) i32 {
  d.quad(x);
}

// An extension that is not generic, of an instance
enum Tally extends Option[i32] {
  pub static base i32 = 50;
  pub fn total(self &) i32 {base + 1;}
  pub fn twice(self &) i32 {total() + self.total();}

  Unknown;
}

// And a generic extension of a base that is not: its copies are generic templates
// of the extension, holding the base's fields, so the extension's methods read the
// common field bare and take the instance's T
enum Tagged[T] extends Shape {
  pub fn kinded(self &) i32 {kind * 10 + self.kind;}
  pub fn scaled(self &, t T) T {t * 2;}

  struct Note { pub text T; }
}

fn genericExtensionMethods() {
  imm some = Deferred.Some[5];
  show("generic-method-on-copy", (&some).quad(3));
  imm later = Deferred.Later[i32][];
  show("generic-method-on-added", (&later).quad(4));
  imm none Deferred[i32] = Deferred.None[i32][];
  show("generic-method-through-extension", deferredQuad(&none, 5));
  show("generic-static-function-bare", (&none).weeks(2));
  imm wide = Deferred.Some[6i64];
  show("generic-method-second-instance", (&wide).quad(10i64));

  imm counted = Tally.Some[4];
  show("instance-extension-method-on-copy", (&counted).twice());
  imm unknown Tally = Tally.Unknown[];
  show("instance-extension-method-through-extension", (&unknown).twice());
  show("instance-extension-static", i64[Tally.base]);

  imm circle = Tagged.Circle[i64][3, 5];
  show("generic-over-plain-method-on-copy", (&circle).kinded());
  show("generic-over-plain-method-takes-t", (&circle).scaled(21i64));
  imm note = Tagged.Note[i64][4, 9i64];
  show("generic-over-plain-method-on-added", (&note).kinded());
}

// Down a chain the middle's methods come along with the variants the top copies
// from it: Stage3's copies of Stage2's copies of Stage's variants answer Stage2's
// step, and Stage3's leap calls it bare.
enum Stage {
  First, Second;
}

enum Stage2 extends Stage {
  pub fn step(self &) i32 {10;}
  Third;
}

enum Stage3 extends Stage2 {
  pub fn leap(self &) i32 {step() * 3 + self.step();}
  Fourth;
}

// The same, generic. Crate3 calls its middle's method bare, as Stage3 does: a
// generic base's members reach its extension per instance, and the bare name is
// the instance's (the next section has more).
enum Crate[T] {
  struct Full { pub v T; }
  Bare;
}

enum Crate2[T] extends Crate[T] {
  pub fn twice(self &, x T) T {x + x;}
  Soon;
}

enum Crate3[T] extends Crate2[T] {
  pub fn thrice(self &, x T) T {twice(x) + x;}
  Last;
}

fn chainExtensionMethods() {
  imm first = Stage3.First[];
  show("chain-method-on-copy-of-copy", (&first).leap());
  imm third = Stage3.Third[];
  show("chain-method-on-copy-of-middle-added", (&third).leap());
  imm fourth = Stage3.Fourth[];
  show("chain-method-on-top-added", (&fourth).leap());
  imm middle = Stage2.Second[];
  show("chain-middle-method-in-middle", (&middle).step());

  imm full = Crate3.Full[i32][1];
  show("generic-chain-method-on-copy", (&full).thrice(5));
  imm soon = Crate3.Soon[i32][];
  show("generic-chain-middle-method-on-copy", (&soon).twice(4));
  imm last = Crate3.Last[i32][];
  show("generic-chain-method-on-added", (&last).thrice(6));
  imm own = Crate2.Full[i32][2];
  show("generic-chain-middle-method-in-middle", (&own).twice(7));
}

// -------- the bases' names, bare inside an extension's braces --------

// Inside an extension's braces its bases' names are bare, exactly as its own are:
// their static functions, statics, overload names and methods, down the whole
// chain, in the extension's methods and static functions and in the variants it
// adds. A base that is not generic gives its own members; a generic base's are the
// members of the instance the extension stands on. A nearer name wins: a variant's
// own member over a base's, and a base's over the module's.

fn origin() i32 {1;}    // hidden by Hue's inside the braces below, and only there

enum Hue {
  static base i32 = 100;
  fn origin() i32 {7;}    // private, and an extension reads its base's private names
  fn scale1 overload scale(x i32) i32 {x * 2;}
  fn scale2 overload scale(x i32, y i32) i32 {x * y;}
  pub fn tone(self &) i32 {3;}
  Red, Green;
}

enum Tint extends Hue {
  static lift i32 = 10;
  fn start() i32 {origin() + base;}
  pub fn glow(self &) i32 {start() + tone() + scale(4) + scale(2, 3);}
  pub struct Cyan {
    fn origin() i32 {500;}
    pub fn cyan(self &) i32 {origin() + base + lift;}
  }
}

// Every level's names, from the top of a plain chain
enum Shade extends Tint {
  pub fn deep(self &) i32 {base + lift + origin() + start() + scale(5);}
  pub struct Ink {
    pub fn ink(self &) i32 {base + lift + origin() + glow();}
  }
}

// A generic chain: Bin3 names Bin2's and Bin's statics, static functions, overload
// names and methods bare, and so does the variant it adds
enum Bin[T] {
  static seed i32 = 1000;
  fn first() i32 {40;}
  fn pick1 overload pick(x i32) i32 {x;}
  fn pick2 overload pick(x i32, y i32) i32 {x * y;}
  pub fn once(self &, x T) T {x;}
  pub fn m1 overload m(self &, x T) T {x;}
  pub fn m2 overload m(self &, x T, y T) T {x + y;}
  struct Full { pub v T; }
  Empty;
}

enum Bin2[T] extends Bin[T] {
  static bump i32 = 20;
  fn two() i32 {2;}
  pub fn twice(self &, x T) T {once(x) + x;}
  Soon;
}

enum Bin3[T] extends Bin2[T] {
  fn total() i32 {seed + first() + bump + two();}
  pub fn thrice(self &, x T) T {twice(x) + once(x);}
  pub fn sums(self &) i32 {total() + pick(3) + pick(2, 5);}
  pub fn mixed(self &, x T) T {m(x) + m(x, x);}
  struct Last {
    pub fn lastly(self &, x T) T {twice(x) * 10 + once(x);}
    pub fn lstat(self &) i32 {seed + bump + two() + first();}
    pub fn lown(self &, x T) T {thrice(x) + 1;}   // the extension's own, as bare
  }
}

fn binThrice(b &Bin3[i32], x i32) i32 {
  b.thrice(x);
}

// An extension that is not generic, of an instance, and one more level on top of it
enum Tab extends Bin[i32] {
  pub fn tally(self &) i32 {once(7) + seed + first() + pick(2, 2);}
  struct Unknown {
    pub fn unknown(self &) i32 {once(1) + seed + first();}
  }
}

enum TabTop extends Tab {
  pub fn top(self &) i32 {seed + first() + once(3) + tally();}
  TopOnly;
}

// A generic extension of a plain base
enum Tagline[T] extends Hue {
  pub fn line(self &) i32 {base + origin() + tone() + scale(3);}
  struct Note {
    pub text T;
    pub fn note(self &) i32 {base + origin() + 2;}
  }
}

// A generic base's common field, read bare through self as the extension's own are
enum Measure[T] {
  _ tag;
  pub size T;
  struct Big { pub extra T; }
  Small;
}

enum Measure2[T] extends Measure[T] {
  pub fn doubled(self &) T {size * 2;}
  struct Huge {
    pub fn huge(self &) T {size + 1;}
  }
}

fn bareBaseNames() {
  imm red = Tint.Red[];
  show("base-names-bare-on-copy", (&red).glow());
  imm cyan = Tint.Cyan[];
  show("base-names-bare-on-added", (&cyan).glow());
  show("variant-own-beats-base-static", (&cyan).cyan());
  show("module-name-outside-the-braces", origin());
  imm green = Shade.Green[];
  show("chain-every-level-bare", (&green).deep());
  imm ink = Shade.Ink[];
  show("chain-every-level-bare-in-added", (&ink).ink());
  imm deepcyan = Shade.Cyan[];
  show("chain-copy-keeps-its-own", (&deepcyan).cyan());

  imm full = Bin3.Full[i32][1];
  show("generic-base-methods-bare-on-copy", (&full).thrice(5));
  show("generic-base-statics-bare-on-copy", (&full).sums());
  show("generic-base-method-overload-bare", (&full).mixed(4));
  imm last = Bin3.Last[i32][];
  show("generic-base-methods-bare-on-added", (&last).thrice(6));
  show("generic-base-methods-bare-in-added", (&last).lastly(3));
  show("generic-base-statics-bare-in-added", (&last).lstat());
  show("generic-extension-own-method-bare-in-added", (&last).lown(2));
  imm wide = Bin3.Last[i64][];
  show("generic-base-bare-second-instance", (&wide).lastly(4i64));
  imm soon Bin3[i32] = Bin3.Soon[i32][];
  show("generic-base-bare-through-extension", binThrice(&soon, 7));
  imm mid = Bin2.Soon[i32][];
  show("generic-middle-bare-in-middle", (&mid).twice(4));

  imm counted = Tab.Full[4];
  show("instance-base-bare-on-copy", (&counted).tally());
  imm unknown = Tab.Unknown[];
  show("instance-base-bare-in-added", (&unknown).unknown());
  show("instance-base-bare-on-added", (&unknown).tally());
  imm topped = TabTop.TopOnly[];
  show("instance-chain-bare-on-added", (&topped).top());
  imm topempty = TabTop.Empty[];
  show("instance-chain-bare-on-copy", (&topempty).top());

  imm tgreen = Tagline.Green[i64][];
  show("generic-over-plain-bare-on-copy", (&tgreen).line());
  imm note = Tagline.Note[i64][9i64];
  show("generic-over-plain-bare-in-added", (&note).note());
  show("generic-over-plain-bare-on-added", (&note).line());

  imm big = Measure2.Big[i32][5, 9];
  show("generic-base-field-bare-on-copy", (&big).doubled());
  imm huge = Measure2.Huge[i32][6];
  show("generic-base-field-bare-on-added", (&huge).doubled());
  show("generic-base-field-bare-in-added", (&huge).huge());
}

fn main() i32 {
  copiesAndMembership();
  foldedNames();
  methodsThroughCopies();
  optionShapedBase();
  largerAddedVariant();
  unsizedDisagreement();
  genericExtensions();
  extensionChains();
  plainExtensionMethods();
  genericExtensionMethods();
  chainExtensionMethods();
  bareBaseNames();
  0i32;
}
