// An Option or a Result in a condition: true when it is Some or Ok.
//
// A condition takes a bool, and a value of another type reaches it through its
// type's isTrue method, as a number does. Option's and Result's are core's
// plain function methods, taking 'self: &', so the value is lent to the test
// and not consumed: a payload that moves is still there after it. An
// Option[bool] holding false is Some, so it is true.

mod enum_option_condition;

import stdio use *;

fn said(label: &str, b: bool) {
  printStr(label);
  printStr(if b {" = true\n"} else {" = false\n"});
}

fn half(n: i64) Option[i64] {
  if n % 2 == 0 { Some(n / 2) } else { None }
}

fn parsed(n: i64) Result[i64, i64] {
  if n > 0 { Ok(n) } else { Err(n) }
}

struct Handle is Move {
  pub id: i64;
}

fn main() {
  let some: Option[i64] = Some(3);
  let none: Option[i64] = None;
  if some { printStr("if Some: taken\n"); }
  if none { printStr("if None: taken\n"); } else { printStr("if None: else\n"); }

  let ok: Result[i64, i64] = Ok(3);
  let err: Result[i64, i64] = Err(4);
  if ok { printStr("if Ok: taken\n"); }
  if err { printStr("if Err: taken\n"); } else { printStr("if Err: else\n"); }

  // A while loop runs while its Option is Some, and while its Result is Ok
  var n = 12i64;
  var opt = half(n);
  while opt {
    printStr("while Some: ");
    printInt(n);
    printStr("\n");
    n = n / 2;
    opt = half(n);
  }
  var k = 3i64;
  var res = parsed(k);
  while res {
    printStr("while Ok: ");
    printInt(k);
    printStr("\n");
    k = k - 1;
    res = parsed(k);
  }

  // A call's value, tested where it is made
  said("call Some", if half(8) {true} else {false});
  said("call None", if half(7) {true} else {false});
  said("call Ok", if parsed(1) {true} else {false});
  said("call Err", if parsed(0) {true} else {false});

  // A variant's value, as 'Some(5)' types a 'let'
  let five = Some(5);
  said("variant Some", if five {true} else {false});

  // Not consumed: a payload that moves is still there after the test
  let held: Option[Handle] = Some(Handle(id: 7));
  if held { printStr("a moving payload: tested\n"); }
  match held {
    case let Some(h) { printStr("a moving payload: still "); printInt(h.id); printStr("\n"); }
    case is None { printStr("a moving payload: gone\n"); }
  }

  // Some(false) is Some, and Ok(false) is Ok
  let ob: Option[bool] = Some(false);
  said("Some(false)", if ob {true} else {false});
  let rb: Result[bool, i64] = Ok(false);
  said("Ok(false)", if rb {true} else {false});

  // '!' and the logic operators take a condition too
  said("not None", !none);
  said("Some and Ok", some && ok);
}
