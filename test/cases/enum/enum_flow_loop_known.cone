// Flow typing and a variable of a known variant that a loop stores to. The name is Idle
// going in, so after 'is Idle' fails the branch that follows cannot run on the loop's
// first pass, but it can on the next, which the body's own store brings about. A test that
// failed says the name is one of the others whatever it was believed to be, so the
// 'else' (or the 'else if' that tests the last variant, which is an 'else') reads the
// other variant's fields by name, in a loop of any kind and nested.
//
// The expected lines are worked out by hand in the comments.

mod enum_flow_loop_known;

import stdio use *;

enum State {
  struct Idle {}
  struct Run { pub speed: i32; }
}
use State;

enum Three {
  struct A {}
  struct B { pub b: i32; }
  struct C { pub c: i32; }
}

use Three;

fn num(n: i32) {
  printInt(i64.from(n));
  printStr(" ");
}

// 'else if' naming the last variant. n=0 Idle, stores Run(0); n=1 prints 0, stores Idle;
// n=2 stores Run(20); n=3 prints 20: "0 20 "
fn elseIf() {
  var state: State = State.Idle;
  var n = 0;
  while n < 4 {
    if state is Idle { state = State.Run(n * 10); }
    else if state is Run { num(state.speed); state = State.Idle; }
    n = n + 1;
  }
  printStr("| ");
}

// A plain 'else': n=0 stores Run(1); n=1 prints 1; n=2 stores Run(3); n=3 prints 3: "1 3 "
fn plainElse() {
  var state: State = State.Idle;
  var n = 0;
  while n < 4 {
    if state is Idle { state = State.Run(n + 1); }
    else { num(state.speed); state = State.Idle; }
    n = n + 1;
  }
  printStr("| ");
}

// Nested loops, with 'continue' and 'break'. i=0: j=1 stores Run(1), continues; j=2 prints
// 1, breaks. i=1: stores Run(11), prints 11. i=2: stores Run(21), prints 21: "1 11 21 "
fn nested() {
  var s: State = State.Idle;
  var i = 0;
  while i < 3 {
    var j = 0;
    while j < 2 {
      j = j + 1;
      if s is Idle { s = State.Run(i * 10 + j); continue; }
      else if s is Run { num(s.speed); s = State.Idle; break; }
    }
    i = i + 1;
  }
  printStr("| ");
}

// An 'each' loop: k=0 stores Run(1); k=1 prints 1; k=2 stores Run(3); k=3 prints 3: "1 3 "
fn eachLoop() {
  var state: State = State.Idle;
  each k in 0 ..< 4 {
    if state is Idle { state = State.Run(k + 1); }
    else if state is Run { num(state.speed); state = State.Idle; }
  }
  printStr("| ");
}

// The same in a 'while true' with a 'break', known Run going in and the first test for Run.
// i=0: Run(5), prints 5, stores Idle; i=1: Idle, stores Run(6); i=2: prints 6, stores
// Idle; i=3 leaves: "5 6 "
fn knownRun() {
  var s: State = State.Run(5);
  var i = 0;
  while true {
    if s is Run { num(s.speed); s = State.Idle; }
    else if s is Idle { s = State.Run(i + 5); }
    i = i + 1;
    if i == 3 { break; }
  }
  printStr("| ");
}

// Three variants, known B going in: after 'is B' fails it is A or C, so a second test
// narrows. i=0: B, stores C(7); i=1: C, prints 7, stores A; i=2: A (not B, not C), stores
// B(9); i=3: B, stores C(10): "7 "
fn three() {
  var t: Three = Three.B(1);
  var i = 0;
  while i < 4 {
    if t is B { t = Three.C(i + 7); }
    else if t is C { num(t.c); t = Three.A; }
    else { t = Three.B(9); }
    i = i + 1;
  }
  printStr("| ");
}

fn main() {
  elseIf();
  plainElse();
  nested();
  eachLoop();
  knownRun();
  three();
  printStr("\n");
}
