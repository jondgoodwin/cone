// An 'is' test with a type to its left, where a value is wanted.
//
// 'if Handle is Move' asks of a type what only a value can be asked: its left
// side must be a typed expression. It is refused once, in the test's own
// words, and the 'if' it is the condition of is checked no further (the
// exhaustiveness check that follows asks a value for its variants, and a type
// has none). A type to the right of 'is' is the usual form and is accepted.

mod enum_typecheck_is_type;

struct Handle {}
struct Plain { pub n: i32; }
struct Mobile is Move { pub n: i32; }

fn ifTest() i32 {
  if Handle is Move { 1 } else { 0 }  //~ ErrorInvType:6 "'is' requires a typed expression to the left"
}

fn ifElseIfTest(p: &Plain) i32 {
  if Mobile is Move { 1 }             //~ ErrorInvType:6 "'is' requires a typed expression to the left"
  else if Plain is Move { 2 }         //~ ErrorInvType:11 "'is' requires a typed expression to the left"
  else { 0 }
}

fn statementTest() {
  if Handle is Move { }               //~ ErrorInvType:6 "'is' requires a typed expression to the left"
}

enum Shape {
  struct Dot { pub n: i32; }
  struct Line { pub n: i32; }
}
use Shape;

fn valueIsFine(s: Shape) i32 {
  if s is Dot { 1 } else { 0 }
}
