// Bug 51: as lifetime_arena_refuse_named_same, the lifetimes named apart. Refuse.
mod lifetime_arena_refuse_named_apart;
import stdio use *;
import arena use *;
// as jn_h6, lifetimes named apart
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn keep(ar: &'a mut Arena, x: &'b mut T) i64 {
  let h = ar.alloc(H(Some(x)));  //~ ErrorCallEscape
  h.p.unwrap().v
}
fn main() {
  var a = Arena();
  var t = T(1);
  print <- keep(&mut a, &mut t), "\n";
}
