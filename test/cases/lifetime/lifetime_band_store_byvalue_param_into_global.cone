// A borrow of a by-value parameter stored into a global.
//
// Verdict: refuse, ErrorInvType at the store.
// Basis: Jon, 1 Oct 2026, decision 1 RULED (WI\lifetimes.md): a borrow of a
// by-value parameter is never "returned or stored outward".
// Master d331baab: correct.

mod lifetime_band_store_byvalue_param_into_global;

mut D i64 = 0;
mut G &i64;

fn @initpure init() {
  G = &D;
}

fn stash(x i64) {
  G = &x;                    //~ ErrorInvType:3
}
