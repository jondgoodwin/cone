// Bug 51: the key rule (ErrorKeyBorrow) on the route into DynArena.alloc: through a closure capturing the arena. Refuse.
mod lifetime_arena_key_closure;
import arena use *;
struct Holder { pub r: &i64; }

fn main() {
  var ar = DynArena.empty();
  let x = 7i64;
  let f = fn(v: Holder) i64 { let k = ar.alloc(v); 1 }; //~ ErrorKeyBorrow
  f(Holder(&x));
}
