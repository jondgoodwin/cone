// Bug 51 (spike): a generic helper stores a value of its type parameter in the arena; the caller's type has a 'final' reading a local. Refuse.
mod lifetime_arena_refuse_final_generic;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: &mut T; fn final(self: &uni) { print <- self.p.v, "\n"; } }
fn put[V](ar: &mut Arena, v: V) { ar.alloc(v); }  //~ ErrorCallEscape
fn stash(ar: &mut Arena) {
  var t = T(7);
  put[F](ar, F(&mut t));
}
fn main() {
  var a = Arena();
  stash(&mut a);
}
