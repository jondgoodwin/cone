// An element of a slice parameter is the caller's, so a borrow of it may be
// returned.
//
// Verdict: accept; prints 4.
// Basis: language rule (1 Oct 2026) -- what a borrowed parameter reaches is
// in the caller band.

mod lifetime_band_return_slice_element;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn first(s &Array[i64]) &i64 { &s[0usize]; }

fn main() {
  imm a Array[i64, 3] = [4, 5, 6];
  show("slice-element", *first(&[]a));
}
