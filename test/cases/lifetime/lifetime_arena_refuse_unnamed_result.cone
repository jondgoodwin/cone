// Bug 48/51 (pin): the lab's recursive parser (jn_g1) with no lifetime written: leafB's result may come from p or from ar, so storing it back into the arena is refused. Name which parameter the result comes from (lifetime_arena_ok_named_parser).
mod lifetime_arena_refuse_unnamed_result;
import stdio use *;
import arena use *;
// the lab's recursive parser, lifetimes unwritten
struct Node { pub val: i64; pub l: Option[&mut Node]; pub r: Option[&mut Node]; }
struct P { pub pos: i64; pub depth: i64; }
fn leafB(p: &mut P, ar: &mut Arena) &mut Node {
  p.pos += 1;
  ar.alloc(Node(p.pos, None[&mut Node], None[&mut Node]))
}
fn exprB(p: &mut P, ar: &mut Arena) &mut Node {
  var l = leafB(p, ar);
  p.depth += 1;
  if p.depth < 4 {
    let r = exprB(p, ar);
    let b = ar.alloc(Node(0, Some(l), Some(r)));  //~ ErrorCallEscape
                                                  //~^ ErrorCallEscape
    p.pos += 1;
    l = b;
  }
  l
}
fn main() {
  var a = Arena();
  var p = P(0, 0);
  print <- exprB(&mut p, &mut a).val, "\n";
}
