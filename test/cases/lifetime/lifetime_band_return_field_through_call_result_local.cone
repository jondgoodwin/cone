// A field borrowed through the reference a call returned, where the call was
// handed a local: the field is the local's, gone at the return, so the borrow
// may not be handed back.
//
// Verdict: refuse, ErrorEscape at the returned borrow.
// Basis: language rule (1 Oct 2026) -- a borrow through another reference
// has the lifetime of what that reference points at; a call's result has the
// shortest lifetime of the borrows it was handed (reflifefn.html).
// Master 8963c337: refused, ErrorInvType at the returned borrow -- the
// borrow was left untyped rather than found to escape.

mod lifetime_band_return_field_through_call_result_local;

struct P { pub n i64; pub m i64; }

fn id(p &P) &P { p; }

fn nOf() &i64 {
  imm x = new P(5, 6);
  &id(&x).n;                 //~ ErrorEscape
}
