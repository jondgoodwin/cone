// Recursion: each activation mints its own arena's brand, and a key passed
// down with its arena opens it at every depth.
//
// Verdict: accept; prints 10 and 15.
// Basis: recursion is fine, each activation's brands being distinct as its
// function sees them; a key handed down beside its arena carries the brand
// the callee's signature names for both (invariant lifetimes, settled
// 3 Oct 2026).
// Master 1117c92a: no DynArena, and ''=a' refused at lex.

mod lifetime_inv_recursion;

import stdio use *;
import arena use *;

struct R { pub n i64; }

fn depth(n i64) i64 {
  mut ar = DynArena.empty();
  imm k = ar.alloc(new R(n));
  if n == 0 { return ar[k].n; }
  depth(n - 1) + ar[k].n;
}

fn down(ar &mut DynArena['=a], k &'=a R, n i64) i64 {
  if n == 0 { return ar[k].n; }
  ar[k].n += n;
  down(ar, k, n - 1);
}

fn main() {
  printInt(depth(4));
  printStr(" ");
  mut ar = DynArena.empty();
  imm k = ar.alloc(new R(0));
  printInt(down(&mut ar, k, 5));
  printStr("\n");
}
