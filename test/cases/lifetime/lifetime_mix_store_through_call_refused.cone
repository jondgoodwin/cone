// Row 965's neighbour: a plain store through a reference a call returns gives the borrow to
// what that reference points at. 'h' holds a borrow of what 's' owns from the store on, and
// 'out' takes it from 'h', so 'out' is read after 's' is gone.
//
// Verdict: refuse, ErrorFrozen at 's', which goes out of scope while borrowed.
// Basis: as 'let p = ident(&mut h); *p = &*s;', the store through a name given the
// reference. The compiler accepted it until row 910 (PR 1743) held such a reference in a
// stand-in, and the program read the next owner's value through 'out'.

mod lifetime_mix_store_through_call_refused;

fn ident(x: &mut &usize) &mut &usize { x }

fn plainStore() usize {
  let one = 1usize;
  var out = [&one];
  {
    var h = &one;
    let s = Uni[usize](2222usize);   //~ ErrorFrozen
    *ident(&mut h) = &*s;
    out[0usize] = h;
  }
  let t = Uni[usize](7777usize);
  *out[0usize] + *t
}

fn main() {}
