// Bug 48/51: a value and the arena it is stored in reached by one path (a reference to the arena kept in the arena, as the arena package's teardown does). Compile and run.
mod lifetime_arena_ok_same_path;
import stdio use *;
import arena use *;
struct Chain {
  pub n: i64;
  pub home: &mut Arena;
  fn final(self: &uni) {
    print <- "final ", n, "\n";
    if n < 3i64 { home.alloc(Chain(n + 1i64, home)); }
  }
}
struct Holder { pub ar: &mut Arena; }
struct W { pub a: &mut Arena; }
fn viafield(h: &mut Holder) {
  h.ar.alloc(W(h.ar));
}
fn main() {
  var a = Arena();
  a.alloc(Chain(1, &mut a));
  var h = Holder(&mut a);
  viafield(&mut h);
}
