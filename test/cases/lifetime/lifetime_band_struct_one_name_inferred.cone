// A struct whose fields name one lifetime, its brackets declaring none, takes
// that name as declared: 'Link' is 'Link['a]', and a use names it in
// brackets as it would a declared one.
//
// Verdict: accept; prints 3.
// Basis: a struct using exactly one lifetime name in its fields, with no
// bracket declaration, declares that name.
// Master b07a3adc: refused at parse (ErrorLifetimePlace: no lifetime on a
// field).

mod lifetime_band_struct_one_name_inferred;

import stdio use *;

struct R { pub n i64; }

struct Link {
  pub to &'a R;
  pub fn target(self &) &'a R { to; }
}

fn follow(l Link['x]) &'x R {
  l.target();
}

fn main() {
  imm r = new R(3);
  imm l = new Link(&r);
  printInt(follow(l).n);
  printStr("\n");
}
