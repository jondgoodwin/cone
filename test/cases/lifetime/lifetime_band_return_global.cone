// A borrow of a global has the global lifetime, which outlives every other:
// a function may return it whatever it was handed.
//
// Verdict: accept; prints 3.
// Basis: language rule (1 Oct 2026) -- a borrow of global lifetime may travel
// anywhere; refborref.html, "Lifetime Constraints" (a borrow of a
// global is granted a global lifetime).
// Master d331baab: correct.

mod lifetime_band_return_global;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

mut G i64 = 3;

fn global() &i64 { &G; }

fn main() {
  show("returned-global", *global());
}
