// Bug 55: as lifetime_arena_refuse_arena_in_struct, the local the finalizer reads is the one in a block of the
// caller of the function storing it, the struct holding the arena built in 'main'. Refuse.
mod lifetime_arena_refuse_arena_in_struct_caller;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F {
  pub p: Option[&mut T];
  fn final(self: &uni) {
    match self.p {
      case let Some(r) { print <- r.v, "\n"; }
      case None { print <- "none\n"; }
    }
  }
}
struct HR['a] { pub ar: &'a mut Arena; }
fn stash(h: &'a mut HR['a], x: &'a mut T) {
  let f = h.ar.alloc(F(None));
  f.p = Some(x);  //~ ErrorEscape
}
fn main() {
  var a = Arena();
  var h = HR(&mut a);
  {
    var t = T(7);
    stash(&mut h, &mut t);
  }
}
