// Bug 68: the arena is reached through a field of the same parameter as the stored borrow (c.go() leaves '&self.n' in the arena after c dies). Refuse.
mod lifetime_arena_refuse_field_same_param;
import stdio use *;
import arena use *;
struct N { pub p: &i32; fn final(self: &uni) { print <- "n reads ", *self.p, "\n"; } }
struct Hd { pub ar: &mut Arena; pub base: i32; }
struct C { n: i32; h: &mut Hd; fn go(self: &mut C) { self.h.ar.alloc(N(&self.n)); }  //~ ErrorCallEscape
}
fn scope(h: &mut Hd) { var c = C(5, h); c.go(); }
fn main() { var ar = Arena(); var h = Hd(&mut ar, 10); scope(&mut h); }
