// Bug 48/51 (pin): the lab's recursive_parser form with the node type's held borrows unnamed: a result's unnamed held part may come from an unnamed parameter, so storing it back is refused. Name 'a on the node type too (lifetime_arena_ok_recursive_parser).
mod lifetime_arena_refuse_unnamed_node_recursive;
import stdio use *;
import arena use *;

struct Node { pub val: i64; pub l: Option[&mut Node]; pub r: Option[&mut Node]; }
struct P { pub pos: i64; pub depth: i64; }

// A recursive parser over a plain parser struct; the node results are stored into other nodes.
// Form A: methods of P, results named with the arena's lifetime.
// Form B: free functions with the parser as an ordinary parameter.
fn leafB(p: &mut P, ar: &'a mut Arena) &'a mut Node {
  p.pos += 1;
  ar.alloc(Node(p.pos, None[&mut Node], None[&mut Node]))
}
fn exprB(p: &mut P, ar: &'a mut Arena) &'a mut Node {
  var l = leafB(p, ar);
  p.depth += 1;
  if p.depth < 4 {
    let r = exprB(p, ar);
    let b = ar.alloc(Node(0, Some(l), Some(r)));  //~ ErrorCallEscape
                                                  //~^ ErrorCallEscape
    p.pos += 1;
    l = b;
  }
  l
}

struct Q {
  pub pos: i64;
  pub depth: i64;
  fn leaf(self: &mut, ar: &'a mut Arena) &'a mut Node {
    pos += 1;
    ar.alloc(Node(pos, None[&mut Node], None[&mut Node]))
  }
  fn expr(self: &mut, ar: &'a mut Arena) &'a mut Node {
    var l = self.leaf(ar);
    depth += 1;
    if depth < 4 {
      let r = self.expr(ar);
      let b = ar.alloc(Node(0, Some(l), Some(r)));  //~ ErrorCallEscape
                                                    //~^ ErrorCallEscape
      self.leaf(ar);
      l = b;
    }
    l
  }
}

fn main() {
  var a = Arena();
  var p = P(0, 0);
  let t = exprB(&mut p, &mut a);
  print <- t.val, "\n";
  var q = Q(0, 0);
  let u = q.expr(&mut a);
  print <- u.val, "\n";
}
