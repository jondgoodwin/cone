// The neighbour of lifetime_free_if_arm_read_other_arm with the borrow used
// after the 'if': now the change in the 'else' arm comes before a use.
//
// Verdict: refuse, ErrorFrozen at the change.
// Basis: borrow-freezing rule (26 Sep 2026) -- a change to a source while a
// borrow of it is still to be used is refused.
// Master d331baab: correct.

mod lifetime_free_if_arm_used_after_join;

fn f(c Bool) i64 {
  mut k = 1i64;
  imm r = &mut k;
  if c { *r = 5; } else { k = 2; }   //~ ErrorFrozen
  *r;
}
