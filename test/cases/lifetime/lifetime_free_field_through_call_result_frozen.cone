// A field borrowed through the reference a call returned borrows what the
// call was handed: while the field's borrow is still to be used, 'x' stays
// frozen, as it would for '&x.n'.
//
// Verdict: refuse, ErrorFrozen at the change.
// Basis: refborref.html, "A borrow a method returns" (the returned borrow
// keeps each borrowed argument frozen); language rule (1 Oct 2026) -- a
// borrow through another reference has the lifetime of what it points at.
// Master 8963c337: refused, but for the wrong reason -- the borrow was left
// untyped, so 'printInt(*p)' was refused with ErrorInvType instead.

mod lifetime_free_field_through_call_result_frozen;

import stdio use *;

struct P { pub n i64; pub m i64; }

fn id(p &P) &P { p; }

fn main() {
  mut x = new P(5, 6);
  imm p = &id(&x).n;
  x = new P(7, 8);           //~ ErrorFrozen
  printInt(*p);
}
