// An inner block's borrow swapped into an element of an outer array of
// borrows, which is read after the block: the array holds a borrow of the
// inner owner, as it would after 'a[1] = t'.
//
// Verdict: refuse, ErrorFrozen at the inner owner, which goes out of scope
// while 'a' still holds a borrow of it (ref_flow_freeze's idiom).
// Basis: a swap is a store in both directions (ref_flow_swap); language rule
// (2 Oct 2026), the flow rule -- a variable's lifetime follows what it holds
// now.
// Master b705e902: accepted, and it reads freed memory -- main, run, prints
// "final" and then "read = <garbage>".

mod lifetime_mix_swap_into_array_element;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn main() {
  imm outer = new R(1);
  mut a = [&outer, &outer];
  {
    imm s = new So[R](42);   //~ ErrorFrozen
    mut t = &*s;
    a[1] <=> t;
  }
  printStr("read = ");
  printInt(a[1].n);
  printStr("\n");
}
