// A type named by a path is asked for its lifetimes as one named alone is: a
// variant that declares none takes none.

mod lifetime_path_declares_none_refused;

enum Shape {
  struct Dot {
    pub r: i64;
  }
}

fn variant(d: &Shape.Dot['=c]) i64 { //~ ErrorLifetimeArgs
  d.r
}

fn main() i32 {
  0i32
}
