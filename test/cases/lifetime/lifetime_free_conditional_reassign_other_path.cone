// A borrow reassigned to another source, and the first source changed on that
// same path: there the borrow no longer holds it.
//
// Verdict: accept; prints 2 and 1.
// Basis: borrow-freezing rule (26 Sep 2026) -- an assignment replaces what a
// holder holds (Polonius's precision for local reassignment).
// Rust: NLL accepts (an assignment to the reference kills its loans; by
// reading, not run).
// Master d331baab: correct.

mod lifetime_free_conditional_reassign_other_path;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn f(c bool) i64 {
  mut a = 1i64;
  mut b = 2i64;
  mut r = &mut a;
  if c {
    r = &mut b;
    a = 7;
  }
  *r;
}

fn main() {
  show("reassigned-path", f(true));
  show("kept-path", f(false));
}
