// Bug 65: direct ar: &'a mut Arena stores x of 'a: the arena was lent it.
mod lifetime_arena_ok_two_life_q6_safe;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- "finalizer reads ", r.v, "\n"; } case None { print <- "none\n"; } } } }
fn put(ar: &'a mut Arena, x: &'a mut T) { var f = ar.alloc(F(None)); f.p = Some(x); }
fn main() { var t = T(7); var a = Arena(); put(&mut a, &mut t); }
