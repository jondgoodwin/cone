// A bound of a lifetime the function's signature does not name: nothing in
// it is ''a', so nothing the body or a caller could put a T into lasts it.
//
// Verdict: refuse, ErrorLifetimeUndeclared at the bound, where the function
// is instanced.
// Basis: language rule (3 Oct 2026): a bound adds to the signature's order
// as a 'where' clause does, and a 'where' clause orders only lifetimes the
// signature names (reflifefn.html, "Where clauses ordering lifetimes").
// Master 2cb190a1: refused at parse.

mod lifetime_bound_undeclared;

struct R { pub n i64; }

fn hold[T + 'a](x T) T {                             //~ ErrorLifetimeUndeclared "a bound on T"
  x;
}

fn main() {
  imm r = new R(1);
  hold(&r);
}
