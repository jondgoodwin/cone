// #1202: the same as lifetime_stored_place_closure_elided with the one explicit name: one name ties 'g' and 'v', so the store is legal in the body and the caller is held to the tie (refused there). Pair: lifetime_stored_place_closure_apart (two names, refused in the body).
mod lifetime_stored_place_closure_named;
import stdio use *;
struct H['a] { pub p: &'a i32; }
fn put[F: fn(x: &i32)](g: &'z mut F, v: &'z i32) { g(v); }
fn main() {
  let a = 1;
  var s = H(&a);
  var g = fn(x: &i32) { s.p = x; };
  { let x = 5; put(&mut g, &x); }  //~ ErrorFrozen
  print <- *s.p, "\n";
}
