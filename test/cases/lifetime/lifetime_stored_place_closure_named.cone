// #1202: the same as lifetime_stored_place_closure_elided with the one explicit name: refused, as master refuses a named signature (in the body, where 'g' points at a closure holding a borrow of no lifetime 'z).
mod lifetime_stored_place_closure_named;
import stdio use *;
struct H['a] { pub p: &'a i32; }
fn put[F: fn(x: &i32)](g: &'z mut F, v: &'z i32) { g(v); }  //~ ErrorCallEscape
fn main() {
  let a = 1;
  var s = H(&a);
  var g = fn(x: &i32) { s.p = x; };
  { let x = 5; put(&mut g, &x); }
  print <- *s.p, "\n";
}
