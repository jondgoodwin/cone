// Bug 51: as lifetime_arena_ok_local_alias with the local declared after the arena, which dies first. Refuse.
mod lifetime_arena_refuse_local_alias;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
fn main() {
  var a = Arena();
  var t = T(5);  //~ ErrorFrozen
  let r = &mut a;
  let h = r.alloc(H(&mut t));
  print <- h.p.v, "\n";
}
