// The neighbour of lifetime_free_slice_used_after_push: the view's last use
// comes before the push.
//
// Verdict: accept; prints 1 and 2.
// Basis: refborref.html, "A borrow a method returns" ("until its last use").
// Master d331baab: correct.

mod lifetime_free_slice_after_last_use;

import stdio use *;
import collections use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  mut l = List[i64].empty();
  l.push(1);
  imm s = l.view();
  show("view-len", i64.from(s.len));
  l.push(2);
  show("pushed-after-view", i64.from(l.len()));
}
