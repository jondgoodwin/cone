// A callee given a '&mut Option[&R]' and a shorter borrow may store the
// borrow in the option, so the borrow must live as long as the option's
// place.
//
// Verdict: refuse, ErrorCallEscape at the call.
// Basis: reflifefn.html, "Mutable borrowed reference parameters": a call
// handed a writable borrow of a place that can hold a borrow may store any
// other borrow it was handed there.
// Master a3a2f44d: accepted, and it reads freed memory -- main, run, prints
// "final" and then "2627634912624". Stage 2 fixed it.

mod lifetime_band_call_store_into_option_param;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn st(o &mut Option[&R], r &R) { *o = Some[&R][r]; }

fn main() {
  imm outer = new R(1);
  mut o Option[&R] = Some[&R][&outer];
  {
    imm s = new So[R](42);
    st(&mut o, &*s);         //~ ErrorCallEscape
  }
  match o {
    case imm v Some { printInt(v.value.n); }
    else { printInt(0); }
  }
  printStr("\n");
}
