// A loop in a generic function is walked for each type it is made for; one that rotates 25 references of such a type is refused at the loop, with the instantiation named
mod lifetime_loop_refused_generic;
import stdio use *;
fn spin[T](p0: T, p1: T, p2: T, p3: T, p4: T, p5: T, p6: T, p7: T, p8: T, p9: T, p10: T, p11: T, p12: T, p13: T, p14: T, p15: T, p16: T, p17: T, p18: T, p19: T, p20: T, p21: T, p22: T, p23: T, p24: T) {
  var a0 = p0; var a1 = p1; var a2 = p2; var a3 = p3; var a4 = p4; var a5 = p5; var a6 = p6; var a7 = p7; var a8 = p8; var a9 = p9; var a10 = p10; var a11 = p11; var a12 = p12; var a13 = p13; var a14 = p14; var a15 = p15; var a16 = p16; var a17 = p17; var a18 = p18; var a19 = p19; var a20 = p20; var a21 = p21; var a22 = p22; var a23 = p23; var a24 = p24;
  var i = 0;
  while i < 30 { a0 = a1; a1 = a2; a2 = a3; a3 = a4; a4 = a5; a5 = a6; a6 = a7; a7 = a8; a8 = a9; a9 = a10; a10 = a11; a11 = a12; a12 = a13; a13 = a14; a14 = a15; a15 = a16; a16 = a17; a17 = a18; a18 = a19; a19 = a20; a20 = a21; a21 = a22; a22 = a23; a23 = a24; a24 = p0; i += 1; }  //~ ErrorLoopTangled
}
fn main() {
  let x = 7;
  spin(&x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x, &x);
  print <- x, "\n";
}
