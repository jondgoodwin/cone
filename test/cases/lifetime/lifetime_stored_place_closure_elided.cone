// #1202: a closure that captures a borrow carries one: a call storing a parameter's borrow through it is checked, not skipped. Refuse at the caller. Pair: lifetime_stored_place_closure_named (refused in the body, master's verdict for a named signature).
mod lifetime_stored_place_closure_elided;
import stdio use *;
struct H['a] { pub p: &'a i32; }
fn put[F: fn(x: &i32)](g: &mut F, v: &i32) { g(v); }
fn main() {
  let a = 1;
  var s = H(&a);
  var g = fn(x: &i32) { s.p = x; };
  { let x = 5; put(&mut g, &x); }  //~ ErrorFrozen
  print <- *s.p, "\n";
}
