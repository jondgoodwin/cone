// A borrow returned by a call and read in an 'if' condition, never held: it
// is dead by the time the body pushes onto the list.
//
// Verdict: accept; prints 2.
// Basis: borrow-freezing rule (26 Sep 2026) -- a borrow freezes only while it
// is still to be used; one held by no variable is used once.
// Master d331baab: correct.

mod lifetime_free_condition_temporary_borrow;

import stdio use *;
import collections use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn first(l &List[i64]) &i64 { l[0usize]; }

fn main() {
  mut l = List[i64].empty();
  l.push(1);
  if *first(&l) > 0 {
    l.push(2);
  }
  show("pushed-in-body", i64.from(l.len()));
}
