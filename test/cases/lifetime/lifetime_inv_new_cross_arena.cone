// A key made by 'new b[R](42)' is 'b.alloc(new R(42))': it carries b's invariant
// lifetime, so a's '[]' refuses it as it refuses any key of another arena
// (lifetime_inv_cross_arena), and b's own reads it.

mod lifetime_inv_new_cross_arena;

import stdio use *;
import arena use *;

struct R {
  pub n: i64;
}

fn main() {
  var a = DynArena.empty();
  var b = DynArena.empty();
  let ka = new a[R](1);
  let kb = new b[R](42);
  printInt(b[kb].n);
  printInt(a[ka].n);
  printInt(a[kb].n);                //~ ErrorBrand
  printStr("\n");
}
