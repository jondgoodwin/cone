// The neighbour of lifetime_free_uni_param_frozen: after the reborrow's last
// use the '&uni' parameter is usable again.
//
// Verdict: accept; prints 8.
// Basis: refperm.html, "From 'uni'" and "Borrowed reference recovery" (as
// read into refborref.html's freezing rule).
// Master d331baab: correct.

mod lifetime_free_uni_param_after_last_use;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn f(p &uni i64) i64 {
  imm a = &mut *p;
  *a = 1;
  *p = *p + 7;
  *p;
}

fn main() {
  imm o = new So[i64](0);
  show("uni-after-reborrow", f(o));
}
