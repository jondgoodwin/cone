// Bug 51 (spike): a list of finalizable values stored in the arena. Refuse.
mod lifetime_arena_refuse_list_of_final;
import stdio use *;
import arena use *;
import collections use *;
struct T { pub v: i64; }
struct F { pub p: &mut T; fn final(self: &uni) { print <- "finalizer reads ", self.p.v, "\n"; } }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64]; var i = 0usize; var s = n; while i < 4usize { b[i] += s; s += b[i]; i += 1usize; } s }
fn stash(ar: &mut Arena) {
  var t = T(7);
  var l = List[F]();
  l.push(F(&mut t));
  ar.alloc(l);  //~ ErrorCallEscape
}
fn main() { var a = Arena(); stash(&mut a); print <- clobber(3), "\n"; }
