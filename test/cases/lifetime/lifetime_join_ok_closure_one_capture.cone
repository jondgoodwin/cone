// Bug 62 control: a closure capturing one local, which it only reads. Compile and run (the check must not refuse it).
// Master e9e953096 compiled it too and printed the same: the fix must leave it alone.
mod lifetime_join_ok_closure_one_capture;
import stdio use *;

struct T { pub v: i64; }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
struct H { pub p: Option[&mut T]; }

fn scope(h: &mut H) { var t = T(7); var g = fn() { print <- "t is ", t.v, "\n"; }; g(); }
fn main() { var h = H(None); var y = T(1); scope(&mut h); print <- clobber(3), "\n"; match h.p { case let Some(r) { print <- "holder reads ", r.v, "\n"; } case None { print <- "none\n"; } } }
