// Bug 122 (row 740 step 0 b): returning mk(&local) out of a function whose result is '&'static'.
mod lifetime_refuse_static_ret_caller_return;
import stdio use *;
struct Node['a] { pub l: &'a i64; }
fn mk(l: &'a Node['a]) &'static Node['a] { l }  //~ ErrorEscape
fn leak() &'static Node['static] { var n = 5i64; var nd = Node(&n); mk(&nd) }  //~ ErrorEscape
fn main() { print <- leak().l, "\n"; }
