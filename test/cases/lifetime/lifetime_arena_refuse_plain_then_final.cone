// Bug 51 (spike): a plain node first, then a finalizable one reached through it. Refuse.
mod lifetime_arena_refuse_plain_then_final;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct N { pub p: Option[&mut T]; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- r.v, "\n"; } case None { print <- "none\n"; } } } }
struct G { pub n: &mut N; fn final(self: &uni) { match self.n.p { case let Some(r) { print <- r.v, "\n"; } case None { print <- "none\n"; } } } }
fn main() {
  var a = Arena();
  { var t = T(7);  //~ ErrorFrozen
    let n = a.alloc(N(Some(&mut t)));
    a.alloc(G(n)); }
}
