// The same as lifetime_band_return_if_via_local_param_first with the local's
// arm first.
//
// Verdict: refuse, ErrorEscape at the return.
// Basis: language rule (26 Sep 2026) -- at a join, a borrow takes the shorter
// of its arms' lifetimes.
// Master d331baab: correct (by the order of the arms: the first arm is the
// local's).

mod lifetime_band_return_if_via_local_local_first;

fn f(c bool, a &i64) &i64 {
  imm x = 42i64;
  imm r = if c { &x; } else { a; };
  r;                         //~ ErrorEscape
}
