// A function's where clause orders the lifetimes its parameters and its
// result name. One naming another lifetime orders nothing, and is refused
// (a struct's, the lifetimes it declares: lifetime_band_struct_undeclared_name).
//
// Verdict: refuse, ErrorLifetimeUndeclared at the clause.
// Basis: a misspelled name in a where clause would otherwise order nothing,
// silently.
// Master b07a3adc: refused at parse (ErrorWhereForm: a 'where' clause is a
// type parameter's name, 'is', and a trait).

mod lifetime_band_where_unknown_name;

struct R { pub n i64; }

fn typo(a &'a R, b &'b R) &'b R where 'a >= 'bb {     //~ ErrorLifetimeUndeclared "named by none"
  b;
}
