// #1202: an unnamed borrow written inside a signature that writes names is a fresh name of its own (Jon, 11 Nov): the '&i32' in 'List[&i32]' is not 'a, so storing 'v: &'a i32' there is refused in the body.
mod lifetime_stored_place_list_named;
import stdio use *;
import collections use *;
fn put(g: &'a mut List[&i32], v: &'a i32) { g.push(v); }  //~ ErrorCallEscape
fn main() {
  var g = List[&i32]();
  let x = 5;
  put(&mut g, &x);
}
