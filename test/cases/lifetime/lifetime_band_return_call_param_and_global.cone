// A call handed a parameter's borrow and a global's returns the shorter of
// the two, the caller band's, which may be returned.
//
// Verdict: accept; prints 5 and 9.
// Basis: reflifefn.html (a returned borrow has the lifetime of the shortest
// borrowed argument); Jon, 1 Oct 2026 (WI\lifetimes.md): global outlives the
// caller band.
// Master d331baab: correct.

mod lifetime_band_return_call_param_and_global;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

mut G i64 = 9;

fn pick(c Bool, a &i64, b &i64) &i64 {
  if c { a; } else { b; }
}

fn f(c Bool, p &i64) &i64 {
  pick(c, p, &G);
}

fn main() {
  imm k = 5i64;
  show("call-param", *f(true, &k));
  show("call-global", *f(false, &k));
}
