// A block as the function's final value, giving a borrow of a local declared
// inside it: the local ends with the block.
//
// Verdict: refuse, ErrorEscape at the block's value.
// Basis: mem-borrowing.html#lifetime, "How long a borrow may live" (a borrow of a local may not
// survive the block where it was taken); the band ordering (1 Oct 2026):
// global outlives the caller's band, which outlives the function's blocks.
// Master d331baab: accepted, and it dangles -- main, run, prints 0, not 42.
// Stage 1 fixed it.

mod lifetime_band_return_block_local;

import stdio use *;

fn clobber(n i64) i64 {
  var a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9]
}

fn f() &i64 {
  {
    let x = 42i64;
    &x                      //~ ErrorEscape
  }
}

fn main() {
  let r = f();
  clobber(21);
  printInt(*r);
  printStr("\n");
}
