// A block as the function's final value, giving a borrow of a local declared
// inside it: the local ends with the block.
//
// Verdict: refuse, ErrorEscape at the block's value.
// Basis: refborref.html, "Lifetime Constraints" (a borrow of a local may not
// survive the block where it was taken); Jon's 1 Oct band ordering.
// Master d331baab: accepted, and it dangles -- main, run, prints 0, not 42.
// xfail until Stage 1.

mod lifetime_band_return_block_local;

import stdio use *;

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

fn f() &i64 {
  {
    imm x = 42i64;
    &x;                      //~ ErrorEscape
  }
}

fn main() {
  imm r = f();
  clobber(21);
  printInt(*r);
  printStr("\n");
}
