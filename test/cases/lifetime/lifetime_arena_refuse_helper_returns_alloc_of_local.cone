// Bug 51 (design chat probe f1): a helper returns the handle of a node holding its parameter's borrow; the caller returns it past the local. Refuse.
mod lifetime_arena_refuse_helper_returns_alloc_of_local;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
struct Holder { pub ar: &mut Arena; }
fn stash(h: &mut Holder, x: &mut T) &mut H { h.ar.alloc(H(x)) }
fn make(h: &mut Holder) &mut H { var t = T(77); stash(h, &mut t) }  //~ ErrorEscape
fn main() { var a = Arena(); var h = Holder(&mut a); let n = make(&mut h); print <- clobber(3), " ", n.p.v, "\n"; }
