// The same 'if' with the local's arm first: the order of the arms must not
// matter.
//
// Verdict: refuse, ErrorEscape at the local's arm.
// Basis: language rule (26 Sep 2026) -- at a join, a borrow takes the shorter
// of its arms' lifetimes; the band ordering (1 Oct 2026).
// Master d331baab: accepted, and it dangles -- main, run, prints 0, not 42.
// xfail until Stage 1.

mod lifetime_band_return_if_local_or_param;

import stdio use *;

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

fn f(c Bool, a &i64) &i64 {
  imm x = 42i64;
  if c { &x; } else { a; }   //~ ErrorEscape
}

fn main() {
  imm k = 1i64;
  imm r = f(true, &k);
  clobber(21);
  printInt(*r);
  printStr("\n");
}
