// Bug 51/52: a second parameter's reference stored into the arena, result discarded (once a compiler crash). Refuse.
mod lifetime_arena_refuse_discarded_same;
import stdio use *;
import arena use *;
// named lifetime, a reference from a second parameter stored into the arena: MUST be refused, today and after any fix
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn keep(ar: &'a mut Arena, x: &'a mut T) {
  ar.alloc(H(Some(x)));
}
fn main() {
  var a = Arena();
  {
    var t = T(1);  //~ ErrorFrozen
    keep(&mut a, &mut t);
  }
  print <- a.blockCount(), "\n";
}
