// A value of one arena's brand handed where the declared type states another's stays refused, inferred or
// written: a brand equals only itself.
//
// Verdict: refuse, ErrorBrand: the value's brand is `'=b`, a parameter's, and the declared type names `'=a`.
// Basis: two names already bound to different brands never match.

mod lifetime_inv_infer_declared_refused;

import stdio use *;
import arena use *;

struct Num { pub v: i64; }

fn mixed(ar: &mut DynArena['=a], br: &mut DynArena['=b]) {
  let n = br.alloc(Num(1));
  var head: Option[&'=a mut Num] = None[&'=a mut Num];
  head = Some(n);                //~ ErrorBrand
}

fn main() {}

// A typed let states one brand, the value has another: the stated type is not adopted, for Option and for a user enum
struct Bin { pub p: i64; pub q: i64; }
enum Either[A, B] {
  L(A);
  R(B);
}

fn mixedLetOption(ar: &mut DynArena['=a], br: &mut DynArena['=b]) {
  let n = br.alloc(Num(1));
  let o: Option[&'=a mut Num] = Some(n);   //~ ErrorBrand
}

fn mixedLetEither(ar: &mut DynArena['=a], br: &mut DynArena['=b]) {
  let n = br.alloc(Num(1));
  let e: Either[&'=a mut Num, &'=a mut Bin] = Either.L(n);   //~ ErrorInvType
}
