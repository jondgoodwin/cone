// A declared type's brand is taken for an inferred argument's only where the argument's is a
// brand a call minted. A value of one arena's brand handed where another's is declared stays refused,
// inferred or written.
//
// Verdict: refuse, ErrorInvType (1013) or the key's own refusal: the value's brand is `'=b`, a
// parameter's, and the declared type names `'=a`.
// Basis: a brand equals only itself.

mod lifetime_inv_infer_declared_refused;

import stdio use *;
import arena use *;

struct Node['=a] {
  pub val: i64;
  pub next: Option[&'=a mut Node['=a]];
}

struct Num { pub v: i64; }
struct Bin { pub p: i64; pub q: i64; }
enum Either[A, B] {
  L(A);
  R(B);
}

fn mixed(ar: &mut DynArena['=a], br: &mut DynArena['=b]) {
  let n = br.alloc(Num(1));
  var head: Option[&'=a mut Num] = None[&'=a mut Num];
  head = Some(n);                //~ ErrorBrand
}

fn mixedLet(ar: &mut DynArena['=a], br: &mut DynArena['=b]) {
  let n = br.alloc(Num(1));
  let e: Either[&'=a mut Num, &'=a mut Bin] = Either.L(n);   //~ ErrorInvType
}

fn main() {}
