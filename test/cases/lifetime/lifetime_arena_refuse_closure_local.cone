// Bug 68: a closure stores a borrow of its own local in an arena reached through a captured parameter (k3b). Refuse.
mod lifetime_arena_refuse_closure_local;
import stdio use *;
import arena use *;
struct N { pub p: &i32; fn final(self: &uni) { print <- "n reads ", *self.p, "\n"; } }
struct Hd { pub ar: &mut Arena; pub base: i32; }
fn scope(h: &mut Hd) { var f = fn() { let m = 5; h.ar.alloc(N(&m)); }; f(); }  //~ ErrorCallEscape
fn main() { var ar = Arena(); var h = Hd(&mut ar, 10); scope(&mut h); }
