// A borrow of a global stored through a '&mut &T' parameter into the
// caller's place: global outlives whatever the caller's place is.
//
// Verdict: accept; prints 5.
// Basis: language rule (1 Oct 2026) -- a borrow of global lifetime may travel
// anywhere.
// Master d331baab: correct.

mod lifetime_band_store_global_through_param;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

mut E i64 = 5;

fn point(dst &mut &i64) {
  *dst = &E;
}

fn main() {
  imm zero = 0i64;
  mut r = &zero;
  point(&mut r);
  show("global-through-param", *r);
}
