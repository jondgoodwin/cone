// Bug 51: a local's reference left in the caller's arena, the node not returned. Refuse.
mod lifetime_arena_refuse_local_unnamed;
import stdio use *;
import arena use *;
// the node NOT returned: the local's reference left inside the caller's arena, found again by a global: MUST be refused
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn stash(a: &mut Arena) i64 {
  var t = T(77);
  let h = a.alloc(H(Some(&mut t)));  //~ ErrorCallEscape
  h.p.unwrap().v
}
fn main() {
  var a = Arena();
  print <- stash(&mut a), "\n";
}
