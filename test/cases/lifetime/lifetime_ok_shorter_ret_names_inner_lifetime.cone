// Bug 122 (H2): the outer lifetime is compared, so a result shorter than the parameter's own, '&'b Node['a]' (which implies 'a >= 'b), still compiles and runs.
mod lifetime_ok_shorter_ret_names_inner_lifetime;
import stdio use *;
struct Node['a] { pub l: &'a i64; }
fn mk(l: &'a Node['a]) &'b Node['a] { l }
fn main() { var n = 5i64; var nd = Node(&n); print <- mk(&nd).l, "\n"; }
