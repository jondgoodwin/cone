// A callee given a mutable slice of borrows and a shorter borrow may store
// the borrow in an element, so the borrow must live as long as the array the
// slice points into.
//
// Verdict: refuse, ErrorCallEscape at the call.
// Basis: reflifefn.html, "Mutable borrowed reference parameters": a call
// handed a writable borrow of a place that can hold a borrow may store any
// other borrow it was handed there.
// Master a3a2f44d: accepted, and it reads freed memory -- main, run, prints
// "final" and then "2336632805856". Stage 2 fixed it.

mod lifetime_band_call_store_into_slice_param;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn st(sl &[]mut &R, r &R) { sl[0usize] = r; }

fn main() {
  imm outer = new R(1);
  mut arr = [&outer, &outer];
  {
    imm s = new So[R](42);
    st(&[]mut arr, &*s);     //~ ErrorCallEscape
  }
  printInt(arr[0usize].n);
  printStr("\n");
}
