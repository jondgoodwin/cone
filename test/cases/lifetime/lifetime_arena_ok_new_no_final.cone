// Bug 51 (narrowed): 'new a[H](...)' is 'a.alloc(H(...))'; H has no 'final', so storing a local's borrow in the caller's arena is no store.
mod lifetime_arena_ok_new_no_final;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
fn stash(a: &mut Arena) i64 {
  var t = T(77);
  let h = new a[H](&mut t);
  h.p.v
}
fn main() {
  var a = Arena();
  print <- stash(&mut a), "\n";
}
