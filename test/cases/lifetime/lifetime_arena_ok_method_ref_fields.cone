// Bug 48/51: must compile and run (arena lab e2b_method_with_ref_fields).
mod lifetime_arena_ok_method_ref_fields;
import stdio use *;
import arena use *;
import collections use *;

struct Node { pub val: i64; pub next: Option[&mut Node]; }
struct P { pub pos: i64; pub keep: List[&mut Node]; }

// 1: the natural spelling. The returned &mut Node is taken to borrow from `self` (the first reference parameter), so the caller
//    cannot call another method of P while it holds the node.
fn mk1(self: &mut P, ar: &mut Arena, v: i64) &mut Node { self.pos += 1; ar.alloc(Node(v, None[&mut Node])) }

// 2: the lifetime of the result named: it is the arena's
fn mk2(self: &mut P, ar: &'a mut Arena, v: i64) &'a mut Node { self.pos += 1; ar.alloc(Node(v, None[&mut Node])) }

fn two1(p: &mut P, ar: &mut Arena) i64 {
  let a = mk1(p, ar, 1);
  let b = mk1(p, ar, 2);       // refused? a is still used below
  a.val + b.val
}

fn two2(p: &mut P, ar: &mut Arena) i64 {
  let a = mk2(p, ar, 1);
  let b = mk2(p, ar, 2);
  a.val + b.val
}

fn main() {
  var a = Arena();
  var p = P(0, List[&mut Node]());
  print <- two2(&mut p, &mut a), "\n";
  print <- two1(&mut p, &mut a), "\n";
}
