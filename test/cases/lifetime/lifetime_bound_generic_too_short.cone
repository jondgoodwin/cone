// A generic function bounded by ''a' stores its T argument where ''a'
// borrows are held, and returns one as ''a'. Instantiated with a borrow too
// short for where it goes -- of an owner that dies before the place it was
// stored in, or the result it was returned as, is read -- the use is refused.
//
// Verdict: refuse, ErrorFrozen at each owner, which goes out of scope while
// d, and then e, still holds a borrow of it.
// Basis: language rule (3 Oct 2026): a type argument holding borrows meets
// ''a' only where each is known to last ''a'; a call carries what an
// argument for T holds wherever ''a' flows, so a borrow that is too short is
// refused where it would be used too late (reflifefn.html, "Lifetime
// bounds").
// Master 2cb190a1: refused at parse. This compiler with the refusal turned
// off accepts it, and main, run, prints "final" as s dies and then the
// value read through d from s's freed block, then the same for s2 and e.

mod lifetime_bound_generic_too_short;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn put[T + 'a](d &mut &'a R, x T) {
  *d = x;
}

fn pick[T + 'a](x T, y &'a R) &'a R {
  x;
}

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

fn main() {
  imm g = new R(1);
  mut d = &g;
  {
    imm s = new So[R](42);   //~ ErrorFrozen "goes out of scope while 'd'"
    put(&mut d, &*s);
  }
  clobber(21);
  printStr("read = ");
  printInt(d.n);
  printStr("\n");
  mut e = &g;
  {
    imm s2 = new So[R](43);  //~ ErrorFrozen "goes out of scope while 'e'"
    e = pick(&*s2, &g);
  }
  clobber(22);
  printStr("read = ");
  printInt(e.n);
  printStr("\n");
}
