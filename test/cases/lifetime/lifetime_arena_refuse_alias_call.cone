// Bug 51: the arena reached through a local made by a call on a parameter. Refuse.
mod lifetime_arena_refuse_alias_call;
import stdio use *;
import arena use *;
// the same through a local alias of a parameter's arena: MUST be refused
struct T { pub v: i64; }
struct H {
  pub p: &mut T;
  fn final(self: &uni) { print <- "final reads ", p.v, "\n"; }
}
fn pass(a: &mut Arena) &mut Arena { a }
fn stash(a: &mut Arena) i64 {
  var t = T(77);
  let r = pass(a);
  let h = r.alloc(H(&mut t));  //~ ErrorCallEscape
  h.p.v
}
fn main() {
  var a = Arena();
  print <- stash(&mut a), "\n";
}
