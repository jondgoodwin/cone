// A struct with two borrow fields built from two unannotated borrowed
// parameters and returned: both are the one unnamed caller lifetime, so the
// struct is in the caller band and may go back.
//
// Verdict: accept; prints 3.
// Basis: language rule (2 Oct 2026) -- a struct takes the lifetime of its
// borrowed fields; with one shared lifetime there is no
// shorter one to choose. reflifefn.html: all unannotated borrows in a
// signature share one lifetime.
// Master d331baab: correct.

mod lifetime_mix_struct_two_fields_params_returned;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct R { pub n i64; }

struct P2 {
  pub a &R;
  pub b &R;
}

fn pair(a &R, b &R) P2 { new P2(a, b); }

fn main() {
  imm x = new R(1);
  imm y = new R(2);
  imm w = pair(&x, &y);
  show("two-params-in-struct", w.a.n + w.b.n);
}
