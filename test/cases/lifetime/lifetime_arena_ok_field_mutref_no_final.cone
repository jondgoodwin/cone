// Bug 51 (narrowed): as lifetime_arena_ok_field_no_final, the arena behind a '&mut' field. The node has no 'final', so nothing reads the borrow after the local is gone.
mod lifetime_arena_ok_field_mutref_no_final;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
struct Holder { pub ar: &mut Arena; }
fn stash(h: &'h mut Holder, x: &'x mut T) i64 {
  let n = h.ar.alloc(H(x));
  n.p.v
}
fn make(h: &mut Holder) i64 {
  var t = T(77);
  stash(h, &mut t)
}
fn main() {
  var a = Arena();
  var h = Holder(&mut a);
  print <- make(&mut h), "\n";
}
