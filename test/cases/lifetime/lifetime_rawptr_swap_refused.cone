// A swap stores both ways. A borrowed parameter swapped into a place reached through a raw pointer held in a
// variable is refused, with the place on either side.
//
// Verdict: refuse, ErrorInvType (1013) at the place reached through the pointer.
// Basis: as lifetime_rawptr_store_param_refused (Jon, 18 Nov 2026); swapFlow reads the same place scope as an
// assignment. Lane 735 (row 536).

mod lifetime_rawptr_swap_refused;

struct Cell { r: &i32; n: i32; }

pub fn swapInto(p: *Cell, x: &i32) {
  var mine = x;
  (*p).r <-> mine;   //~ ErrorInvType
}

pub fn swapFrom(p: *Cell, x: &i32) {
  var mine = x;
  mine <-> (*p).r;   //~ ErrorInvType
}

fn main() i32 { 0 }
