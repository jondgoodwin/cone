// A lifetime after a path is refused where the path goes through a value or a
// type parameter, or reaches a function: none is a type named by its path.

mod lifetime_path_names_refused;

struct Plain {
  pub n: i64;
}

struct Wrap {
  pub plain: Plain;
}

// A field of a value is no type's use
fn field(w: &Wrap) i64 {
  w.plain['=c].n //~ ErrorLifetimeArgs
}

// Nor is a type parameter's member
fn parm[T](x: &T.Item['=c]) { //~ ErrorLifetimeArgs
}

struct Maker {
  pub fn make(v: i64) i64 {
    v
  }
}

// Nor is a function reached by path
fn call() i64 {
  Maker.make['=c](1i64) //~ ErrorLifetimeArgs
}

fn main() i32 {
  0i32
}
