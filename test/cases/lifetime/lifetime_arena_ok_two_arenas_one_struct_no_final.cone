// Bug 48/51 (narrowed): two arenas reached through one struct: a.alloc(W(b)) keeps b's reference in a, in a node with no 'final' that is never read.
mod lifetime_arena_ok_two_arenas_one_struct_no_final;
import stdio use *;
import arena use *;
struct W { pub a: &mut Arena; }
struct Two { pub a: &mut Arena; pub b: &mut Arena; }
fn bad(t: &mut Two) {
  t.a.alloc(W(t.b));
}
fn main() {
  var x = Arena();
  var y = Arena();
  var t = Two(&mut x, &mut y);
  bad(&mut t);
}
