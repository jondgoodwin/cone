// The cure for lifetime_arena_refuse_method_ref_fields_unnamed: P names the
// lifetime of the node it points at ('n), the result of mk2 is the arena's,
// and two2 states that the arena outlives P's node (where 'a >= 'n).
mod lifetime_arena_ok_method_ref_fields_where;
import stdio use *;
import arena use *;

struct Node { pub val: i64; }
struct P['n] { pub pos: i64; pub keep: &'n Node; }

fn mk2(self: &mut P['n], ar: &'a mut Arena, v: i64) &'a mut Node { self.pos += 1; ar.alloc(Node(v)) }

fn two2(p: &mut P['n], ar: &'a mut Arena) i64 where 'a >= 'n {
  let a = mk2(p, ar, 1);
  let b = mk2(p, ar, 2);
  a.val + b.val + p.keep.val
}

fn main() {
  var a = Arena();
  let base = Node(100);
  var p = P(0, &base);
  print <- two2(&mut p, &mut a), "\n";
  print <- p.pos, "\n";
}
