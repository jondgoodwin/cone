// A struct whose fields name two lifetimes declares both in its brackets: a
// second undeclared name is refused, where each is written, as is a name its
// brackets do not declare, in a field or in its where clause, and a where
// clause ordering lifetimes on a struct declaring none. A misspelled name
// would otherwise be one more lifetime, unrelated to every other.
//
// Verdict: refuse, ErrorLifetimeUndeclared at each undeclared name.
// Basis: a struct using one lifetime name may leave it undeclared; one using
// two or more declares them all; its where clause orders those it declares.
// Master b07a3adc: refused at parse (ErrorLifetimePlace: no lifetime on a
// field).

mod lifetime_band_struct_undeclared_name;

struct R { pub n i64; }

struct Two {
  pub a &'a R;               //~ ErrorLifetimeUndeclared "brackets declare each"
  pub b &'b R;               //~ ErrorLifetimeUndeclared "brackets declare each"
}

struct Typo['src] {
  pub text &'src R;
  pub more &'scr R;          //~ ErrorLifetimeUndeclared "not one of the lifetimes"
}

struct Pair['a, 'b] where 'a >= 'c {      //~ ErrorLifetimeUndeclared "not one of the lifetimes"
  pub x &'a R;
  pub y &'b R;
}

struct Plain where 'a >= 'b {             //~ ErrorLifetimeUndeclared "declares no lifetimes"
  pub n i64;
}
