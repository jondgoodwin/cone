// ''static' inside a parameter's type -- on what a '&mut' points at -- would
// promise the callee a global borrow there, but nothing checks that what the
// caller lent holds one: only a parameter's own reference written ''static'
// has its argument checked. So it is refused there; in the result, and on a
// parameter's own reference, it is allowed.
//
// Verdict: refuse, ErrorLifetimePlace at the parameter.
// Basis: design: a lifetime is named only where it is checked.

mod lifetime_band_named_static_inside_parm;

fn read(slot &mut &'static i64) i64 {     //~ ErrorLifetimePlace
  **slot;
}

fn own(s &'static i64) &'static i64 {
  s;
}
