// Fields of two structs swapped, an outer struct's and an inner block's that
// holds a borrow of the inner owner: neither side is a whole variable, and
// the outer struct, read after the block, holds the inner owner's borrow.
//
// Verdict: refuse, ErrorFrozen at the inner owner, which goes out of scope
// while 'h' still holds a borrow of it (ref_flow_freeze's idiom).
// Basis: a swap is a store in both directions (ref_flow_swap); language rule
// (2 Oct 2026), the flow rule -- a variable's lifetime follows what it holds
// now.
// Master b705e902: accepted, and it reads freed memory -- main, run, prints
// "final" and then "read = <garbage>".

mod lifetime_mix_swap_between_struct_fields;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

struct H { pub r &R; }

fn main() {
  imm outer = new R(1);
  mut h = new H(&outer);
  {
    imm s = new So[R](42);   //~ ErrorFrozen
    mut h2 = new H(&*s);
    h.r <=> h2.r;
  }
  printStr("read = ");
  printInt(h.r.n);
  printStr("\n");
}
