// A borrow used on every iteration that goes round; the path that changes
// the source then breaks out, and nothing after the loop uses the borrow.
//
// Verdict: accept; prints 5 and 4.
// Basis: borrow-freezing rule (26 Sep 2026) -- a source is frozen only on the
// paths where the borrow is still to be used; the 'break' path carries no
// later use.
// Master d331baab: correct.

mod lifetime_free_break_path_change;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn f(c Bool) i64 {
  mut k = 1i64;
  imm r = &mut k;
  mut i = 0;
  while i < 3 {
    if c {
      k = 5;
      break;
    }
    *r = *r + 1;
    i = i + 1;
  }
  k;
}

fn main() {
  show("break-path", f(true));
  show("loop-path", f(false));
}
