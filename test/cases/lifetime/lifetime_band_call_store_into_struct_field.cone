// A callee given a '&mut' to a struct with a borrow field and another borrow,
// all unannotated, may store the borrow in the field. So at the call the
// borrow must live as long as the struct's place; here it does not.
//
// Verdict: refuse, ErrorCallEscape at the call.
// Basis: reflifefn.html, "Mutable borrowed reference parameters" (the
// 'tryit'/'refstore' rule), which speaks of '&mut &T'; widening it to any
// '&mut' whose target holds a borrow is a reading of that rule (a store
// through a reference may put the borrow anywhere its target can hold one).
// Master d331baab: accepted, and it reads freed memory -- main, run, prints
// "final" and then "read = 1992325939056". Stage 2 fixed it.

mod lifetime_band_call_store_into_struct_field;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

struct H { pub r &R; }

fn st(h &mut H, r &R) { h.r = r; }

fn main() {
  imm outer = new R(1);
  mut h = new H(&outer);
  {
    imm s = new So[R](42);
    st(&mut h, &*s);         //~ ErrorCallEscape
  }
  printStr("read = ");
  printInt(h.r.n);
  printStr("\n");
}
