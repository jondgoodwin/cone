// A method that takes a second parameter and stores it through its '&mut'
// receiver does not meet a trait whose method takes the same parameter and
// stores nothing: a call through the trait would not keep the argument's borrow
// in the receiver, and the struct's method does. What a cursor's 'next' does
// (lifetime_band_struct_cursor_meets_trait) is a method with no other parameter,
// which has nothing to store.
//
// Verdict: refuse, ErrorInvType at the struct (the requirement unmet).
// Basis: an implementation meets a requirement only where it promises at least
// what the requirement does, and a store through a parameter is a promise by
// the signature.

mod lifetime_band_struct_cursor_stores_refused;

struct R { pub n i64; }

trait Taker {
  pub fn take(self &mut, b &R);
}

struct Holder['a] is Taker {    //~ ErrorInvType "the signature Taker requires"
  held &'a R;
  pub fn take(self &mut, b &'a R) { held = b; }
}


