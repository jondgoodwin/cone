// The neighbour of lifetime_free_if_value_either_frozen: after the 'if'
// value's last use both sources are free.
//
// Verdict: accept; prints 1 and 3.
// Basis: the freezing design Jon ruled 26 Sep 2026 (freezing-design.md 1,
// rule 3; 2.11).
// Master d331baab: correct.

mod lifetime_free_if_value_after_last_use;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pt { pub x i64; pub y i64; }

fn f(c Bool) i64 {
  mut p = new Pt(1, 2);
  mut q = new Pt(3, 4);
  imm w = if c { &p; } else { &q; };
  imm x = w.x;
  q.x = 5;
  p.x = 6;
  x;
}

fn main() {
  show("either-then", f(true));
  show("either-else", f(false));
}
