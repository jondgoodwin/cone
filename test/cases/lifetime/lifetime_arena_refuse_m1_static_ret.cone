// Bug 122 (H2): lifetime_arena_ok_m1 with the result's outer lifetime 'a changed to 'static. Refuse.
mod lifetime_arena_refuse_m1_static_ret;
import stdio use *;
import arena use *;
struct Node['a] { pub val: i64; pub l: Option[&'a mut Node['a]]; }
fn leaf(ar: &'a mut Arena) &'a mut Node['a] {
  ar.alloc(Node(1, None))
}
fn mk(ar: &'a mut Arena, l: &'a mut Node['a]) &'static mut Node['a] {
  ar.alloc(Node(5, Some(l)))  //~ ErrorEscape
}
fn main() {
  var a = Arena();
  let x = leaf(&mut a);
  let m = mk(&mut a, x);
  print <- m.val + m.l.unwrap().val, "\n";
}
