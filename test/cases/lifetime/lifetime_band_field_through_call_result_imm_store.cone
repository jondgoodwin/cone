// A field reached through the reference a call returned keeps the field's own
// permission, as one reached through a reference held in a variable does: an
// 'imm' field may not be written, even through a '&mut' reference.
//
// Verdict: refuse, ErrorNoMut at the store into the 'imm' field.
// Basis: refstruct.html -- the container's permission and the field's
// together govern a write; struct_flow_fieldperm pins it through a variable.
// Master 8963c337: accepted -- the field's permission was dropped for a place
// with no variable at its root.

mod lifetime_band_field_through_call_result_imm_store;

struct Q { pub imm k i64; pub mut v i64; }

fn idm(q &mut Q) &mut Q { q; }

fn main() {
  mut x = new Q(1, 2);
  idm(&mut x).v = 3;
  idm(&mut x).k = 5;         //~ ErrorNoMut
}
