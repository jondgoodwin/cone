// Bug 61: a store through a node a struct holds beside its arena is seen at the caller, which lent the node's arena: the body names no helper. Refuse.
mod lifetime_arena_refuse_held_caller_holder;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- "finalizer reads ", r.v, "\n"; } case None { print <- "none\n"; } } } }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
struct Hn { pub ar: &mut Arena; pub f: &mut F; }
fn stash(h: &mut Hn, x: &mut T) { h.f.p = Some(x); }  //~ ErrorEscape
fn scope(q: &mut Arena) { let f = q.alloc(F(None)); var h = Hn(q, f); var t = T(7); stash(&mut h, &mut t); }  //~ ErrorCallEscape
fn main() { var a = Arena(); scope(&mut a); print <- clobber(3), "\n"; }
