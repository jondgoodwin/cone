// A lifetime is written right after the '&', before the permission:
// '&'a mut T', and on a slice '&'a Array[T]'. A '&'a mut' result tied to the
// first parameter alone outlives what the second, named apart, was lent.
//
// Verdict: accept; prints 42 and 7.
// Basis: language rule (1 Oct 2026): 'a and 'b are distinct lifetimes, and a
// result named 'a holds only the 'a argument's borrow. Spelling: the EBNF's
// order ('&' lifetime perm type, ebnf.html 'reftype'), as Rust writes it.
// Unannotated, the result shares 'two''s lifetime, and the block's value
// could not leave it (refused, measured).

mod lifetime_band_named_mut_spelling;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn bump(dst &'a mut i64, inc &'b i64) &'a mut i64 {
  *dst = *dst + *inc;
  dst;
}

fn elementAt(xs &'a Array[i64], at &'b usize) &'a i64 {
  &xs[*at];
}

fn main() {
  mut x = 40i64;
  imm r = {
    imm two = 2i64;
    bump(&mut x, &two);
  };
  show("named-mut", *r);

  imm arr = [5i64, 6i64, 7i64];
  imm e = {
    imm at = 2usize;
    elementAt(&arr, &at);
  };
  show("named-slice", *e);
}
