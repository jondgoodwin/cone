// A nested instance's written brand still equals only itself: the tokens the cursor gives carry
// '=a, so a Walk whose first argument is '=b is refused. The nested brand is now numbered with
// the caller's, so the refusal is by the pattern ('=b, '=a), not by an accident of the numbering.
//
// Verdict: refuse, ErrorBrand at the body that needs T and the cursor's item to be one brand.

mod lifetime_inv_written_nested_brand_refused;

import stdio use *;
import collections use *;

struct Tok['=a] { pub v: i64; }

struct W[T, I: Iterator[T]] {
  pub s: I;
  pub fn one(self: &mut) Option[T] { s.next() }   //~ ErrorBrand
}

fn apart(l: &List[Tok['=a]], t: Tok['=b]) {
  var w = W[&Tok['=b], ListIter[Tok['=a]]](l.iter());
  let r = w.one();
}

fn main() {}
