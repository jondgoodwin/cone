// An arena variable keeps its brand: assigning it another arena, swapping it
// with another, or storing one through a parameter's reference to it would
// leave its keys opening an arena they were never allocated from.
//
// Verdict: refuse, ErrorBrand at each.
// Basis: a value of one invariant lifetime never takes another's place; each
// call of DynArena.empty() mints its own (invariant lifetimes, settled
// 3 Oct 2026).
// Master 1117c92a: no DynArena, and ''=a' refused at lex. This compiler with
// the brand check turned off accepts 'swapped', and main, run, prints
// "final" as the swapped-out arena dies with b's block and then a value
// read from it through the key.

mod lifetime_inv_arena_replaced;

import stdio use *;
import arena use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

fn reassigned() {
  mut a = DynArena.empty();
  a.alloc(new R(1));
  a = DynArena.empty();             //~ ErrorBrand
}

fn swapped() {
  mut a = DynArena.empty();
  imm k = a.alloc(new R(42));
  {
    mut b = DynArena.empty();
    b.alloc(new R(2));
    a <=> b;                        //~ ErrorBrand
  }
  clobber(21);
  printStr("read = ");
  printInt(a[k].n);
  printStr("\n");
}

fn through(ar &mut DynArena['=a]) {
  *ar = DynArena.empty();           //~ ErrorBrand
}

fn main() {
  reassigned();
  swapped();
}
