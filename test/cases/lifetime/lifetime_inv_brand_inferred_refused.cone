// An inferred argument whose brand is really apart from another is still refused: T is taken from
// the token passed ('=a) and the cursor is over '=b tokens, so the body, which needs the one brand,
// is given two. Inference reads each argument in the brands its value holds, and no brand stands
// for another.
//
// Verdict: refuse, ErrorBrand in the instance's body, as for the written spelling in
// lifetime_inv_brand_pattern_refused.

mod lifetime_inv_brand_inferred_refused;

import stdio use *;
import collections use *;

struct Tok['=a] { pub v: i64; }

fn nextOf[T, I: Iterator[T]](x: T, it: &mut I) Option[T] { it.next() }   //~ ErrorBrand

fn apart(l: &List[Tok['=b]], t: Tok['=a]) {
  var it = l.iter();
  let r = nextOf(&t, &mut it);
}

fn main() {}
