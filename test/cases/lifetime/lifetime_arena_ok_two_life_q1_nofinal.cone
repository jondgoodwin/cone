// Bug 65: a node whose death reads no borrow may hold a shorter one (#992's exception).
mod lifetime_arena_ok_two_life_q1_nofinal;
import stdio use *;
import arena use *;
import collections use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; }
struct Hd { pub ar: &mut Arena; }
fn mkF(a: &mut Hd) &mut F { a.ar.alloc(F(None)) }
struct Bx { pub f: &mut F; }
fn put(a: &mut Hd, b: &mut Bx, x: &mut T) { b.f = mkF(a); b.f.p = Some(x); } //~ WarnLifetimeTie
fn scope(q: &mut Arena) { var t = T(7); var h = Hd(q); var g = F(None); var b = Bx(&mut g); put(&mut h, &mut b, &mut t); }
fn main() { var a = Arena(); scope(&mut a); print <- "ok\n"; }
