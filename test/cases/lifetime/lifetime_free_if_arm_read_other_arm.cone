// A mutable borrow used in the 'then' arm; the 'else' arm reads the source,
// which a live mutable borrow of a local forbids -- but on that path the
// borrow is never used again.
//
// Verdict: accept; prints 10 and 3.
// Basis: borrow-freezing rule (26 Sep 2026; restated 1 Oct 2026) -- a borrow
// live in one branch and not the others freezes its source only in that one.
// Master d331baab: correct.

mod lifetime_free_if_arm_read_other_arm;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn f(c Bool) i64 {
  mut k = 1i64;
  imm r = &mut k;
  mut out = 0i64;
  if c { *r = 5; } else { out = k; }
  out + k * 2;
}

fn main() {
  show("borrow-arm", f(true));
  show("read-arm", f(false));
}
