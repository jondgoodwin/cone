// Bug 77, the caller half, the accepting twin of lifetime_band_call_put_list_where_refused: 'l' outlives 'h'.
mod lifetime_band_call_put_list_where_ok;
import stdio use *;
import collections use List;
struct Pt { pub v: i64; }
struct Host['h] { pub r: &'h Pt; }
fn put(h: &mut Host['h], l: &'l mut List[Pt]) where 'l >= 'h { h.r = &l[0usize]; }
fn main() {
  var l = List[Pt]();
  l.push(Pt(1i64));
  var base = Pt(0i64);
  var h = Host(&base);
  put(&mut h, &mut l);
  print <- h.r.v, "\n";
}
