// Bug 62: a closure that only reads the younger local while it writes through the captured holder (the rule's cost: refused). Refuse: the borrows are one value, and a store through it could put the younger one where the holder points.
// Master e9e953096: compiled, and the program printed: t is 7 | none
// (the program only reads 't', and reads a live 7: refused all the same, the rule's cost, for the closure could store it).
mod lifetime_join_refuse_closure_reads_only;
import stdio use *;
struct T { pub v: i64; }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
struct H { pub p: Option[&mut T]; }

fn scope(h: &mut H) { var t = T(7); var g = fn() { h.p = None; print <- "t is ", t.v, "\n"; }; g(); }  //~ ErrorCallEscape
fn main() { var h = H(None); var y = T(1); scope(&mut h); print <- clobber(3), "\n"; match h.p { case let Some(r) { print <- "holder reads ", r.v, "\n"; } case None { print <- "none\n"; } } }
