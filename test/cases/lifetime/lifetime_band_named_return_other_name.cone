// Inside a callee, two distinct caller lifetimes 'a and 'b do not compare:
// a result declared 'a may not be 'b.
//
// Verdict: refuse, ErrorEscape at the returned 'b'. (The code is a guess at
// what a named-lifetime mismatch reports; the refusal is the point.)
// Basis: language rule (1 Oct 2026) -- two different named caller lifetimes
// compare only where their order is declared by a where clause or implied by
// a type in the signature (a borrow of a value holding the other), and
// neither is here.
// Master d331baab: refused at parse ('a read as a loop label). Stage 6 fixed
// it.

mod lifetime_band_named_return_other_name;

fn pick(a &'a i64, b &'b i64) &'a i64 {
  b;                         //~ ErrorEscape
}
