// Two mutable borrows of different fields of one local live at once: the
// fields are disjoint places.
//
// Verdict: accept; prints 10.
// Basis: refborref.html, "Freezing access to the source of a borrow"
// ("Borrowing one field of a struct freezes that field ... but leaves the
// struct's other fields free"); borrow-freezing rule: borrows conflict only
// where their places overlap.
// Rust: accepted (disjoint field borrows; by reading, not run).
// Master d331baab: correct.

mod lifetime_free_disjoint_two_mut_fields;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pt { pub x i64; pub y i64; }

fn main() {
  mut p = new Pt(1, 2);
  imm a = &mut p.x;
  imm b = &mut p.y;
  *a = 3;
  *b = 4;
  show("two-field-borrows", *a + *b + p.x);
}
