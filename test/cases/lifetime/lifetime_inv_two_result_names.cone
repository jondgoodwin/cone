// Two names only a function's result writes, `'=t` and `'=r`, are two unresolved names: neither is a brand
// of its own, yet they are not one another. `empty` builds `List[&'=r mut Road['=t]]()` for the field of
// `Atlas['=t, '=r]`, which is that same instance, and `Atlas.empty()` then mints a brand for each.
//
// Verdict: compiles and runs.
// Basis: the shape of packages/arena/examples/atlas.cone, which an earlier naming of unresolved names (all
// of them the first name) refused with 1588.

mod lifetime_inv_two_result_names;

import stdio use *;
import arena use *;
import collections use *;

struct Town {
  pub people: i64;
}

struct Road['=t] {
  pub from: &'=t Town;
  pub km: i64;
}

struct Atlas['=t, '=r] {
  pub towns: DynArena['=t];
  pub roads: DynArena['=r];
  pub all: List[&'=r mut Road['=t]];

  pub fn empty() Atlas['=t, '=r] {
    Atlas(DynArena.empty(), DynArena.empty(), List[&'=r mut Road['=t]]())
  }

  pub fn town(self: &mut, people: i64) &'=t mut Town {
    towns.alloc(Town(people))
  }

  pub fn join(self: &mut, from: &'=t Town, km: i64) {
    all.push(roads.alloc(Road(from, km)));
  }
}

fn main() {
  var atlas = Atlas.empty();
  let t = atlas.town(40);
  atlas.join(t, 7);
  atlas.join(t, 9);
  printStr("roads: "); printInt(i64.from(atlas.all.len())); printStr("\n");
}
