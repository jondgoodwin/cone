// Bug 68: a closure stores a borrow of its own copy-list variable in an arena it reached through a captured parameter (Bug 66, k3). Refuse.
mod lifetime_arena_refuse_closure_copy;
import stdio use *;
import arena use *;
struct N { pub p: &i32; fn final(self: &uni) { print <- "n reads ", *self.p, "\n"; } }
struct Hd { pub ar: &mut Arena; pub base: i32; }
fn scope(h: &mut Hd) { let n = 5; var f = fn() [n] { h.ar.alloc(N(&n)); }; f(); }  //~ ErrorCallEscape
fn main() { var ar = Arena(); var h = Hd(&mut ar, 10); scope(&mut h); }
