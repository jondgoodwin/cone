// A lifetime is named in the types of a function's signature, a type's
// arguments there included, and of a struct's fields, the places it is
// checked. A variable's type, a borrow expression, the type a construction
// names and a function's brackets are refused, each where its lifetime is
// written: a function's lifetimes are its signature's, declared by being
// named there.
//
// Verdict: refuse, ErrorLifetimePlace at each refused lifetime; 'Holder' and
// 'wrapped' are accepted.
// Basis: a name nothing checks would be a promise nobody keeps; a struct
// declares its lifetimes in its brackets, a function in its signature.
// Master b07a3adc: the field's and the type argument's lifetimes were
// refused too, and the construction's and the function's brackets' read as
// something else and refused there.

mod lifetime_band_named_place_refused;

struct Holder {
  pub r &'a i64;
}

fn wrapped(x &'a i64) Option[&'a i64] {
  Some[&i64][x];
}

fn body(x &i64) i64 {
  imm y &'a i64 = x;         //~ ErrorLifetimePlace
  imm z = &'a y;             //~ ErrorLifetimePlace
  imm h = new Holder['a](x); //~ ErrorLifetimePlace
  *y;
}

fn bracketed['a](x &'a i64) {    //~ ErrorLifetimePlace
}
