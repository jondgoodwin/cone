// A lifetime is named only on a borrowed reference type in a function's
// signature, the one place it is checked. A field's type, a variable's, a
// type's arguments ('Option[&'a i64]') and a borrow expression are refused,
// each where its lifetime is written: lifetimes on types holding borrows are
// not built.
//
// Verdict: refuse, ErrorLifetimePlace at each lifetime.
// Basis: design (lifetimes on struct types and where clauses wait on their
// spelling); a name nothing checks would be a promise nobody keeps.

mod lifetime_band_named_place_refused;

struct Holder {
  pub r &'a i64;             //~ ErrorLifetimePlace
}

fn wrapped(x &'a i64) Option[&'a i64] {    //~ ErrorLifetimePlace
  Some[&i64][x];
}

fn body(x &i64) i64 {
  imm y &'a i64 = x;         //~ ErrorLifetimePlace
  imm z = &'a y;             //~ ErrorLifetimePlace
  *y;
}
