// Bug 51/52: as lifetime_arena_refuse_discarded_same with a plain caller. Refuse.
mod lifetime_arena_refuse_discarded_plain;
import stdio use *;
import arena use *;
// the same store with a plain caller, no inner block: isolates the refusal from main's shape
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn keep(ar: &'a mut Arena, x: &'a mut T) i64 {
  ar.alloc(H(Some(x)));
  1
}
fn main() {
  var a = Arena();
  var t = T(1);  //~ ErrorFrozen
  print <- keep(&mut a, &mut t), "\n";
}
