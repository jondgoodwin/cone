// Bug 48: a node of the arena stored back into the same arena under a named lifetime. Compile.
mod lifetime_arena_ok_arena_node_in_arena;
import arena use *;
struct Node { pub val: i64; pub l: Option[&mut Node]; }
fn two(ar: &'a mut Arena) &'a mut Node {
  let a = ar.alloc(Node(0, None[&mut Node]));
  let b = ar.alloc(Node(0, Some(a)));
  b
}
fn main() {
  var ar = Arena();
  let n = two(&mut ar);
}
