// Bug 48/51: must compile and run (arena lab e2c_method_form).
mod lifetime_arena_ok_method_form;
import stdio use *;
import arena use *;
import collections use *;

struct Node { pub val: i64; pub next: Option[&mut Node]; }
struct P {
  pub pos: i64;
  pub keep: List[&mut Node];

  // natural spelling, as a method
  fn mk1(self: &mut, ar: &mut Arena, v: i64) &mut Node { pos += 1; ar.alloc(Node(v, None[&mut Node])) } //~ WarnLifetimeTie
  // the result's lifetime named
  fn mk2(self: &mut, ar: &'a mut Arena, v: i64) &'a mut Node { pos += 1; ar.alloc(Node(v, None[&mut Node])) }
  fn eat(self: &mut) { pos += 1; }

  fn two1(self: &mut, ar: &mut Arena) i64 {
    let a = self.mk1(ar, 1);
    self.eat();
    a.val
  }
  fn two2(self: &mut, ar: &mut Arena) i64 { //~ WarnLifetimeTie
    let a = self.mk2(ar, 1);
    self.eat();
    a.val
  }
}

fn main() {
  var a = Arena();
  var p = P(0, List[&mut Node]());
  print <- p.two2(&mut a), "\n";
  print <- p.two1(&mut a), "\n";
}
