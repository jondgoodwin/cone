// Bug 51: the key rule (ErrorKeyBorrow) on the route into DynArena.alloc: a struct holding the borrow several levels down. Refuse.
mod lifetime_arena_key_deep;
import arena use *;
struct Holder { pub r: &i64; }

struct C { pub h: Holder; }
struct B { pub c: C; }
struct A { pub b: B; }
fn main() {
  var ar = DynArena.empty();
  let x = 7i64;
  let k = ar.alloc(A(B(C(Holder(&x))))); //~ ErrorKeyBorrow
}
