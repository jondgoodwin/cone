// A callee storing one unannotated borrowed parameter through another
// ('&mut &T'): both share the one unnamed lifetime, so the callee may; the
// caller is the one checked (ref_flow_call refuses a shorter argument).
//
// Verdict: accept; prints 9.
// Basis: reflifefn.html, "Mutable borrowed reference parameters" ('refstore'
// compiles; the call 'tryit' makes is what is refused).
// Master d331baab: correct.

mod lifetime_band_store_param_through_param;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn refstore(dst &mut &i64, src &i64) {
  *dst = src;
}

fn main() {
  imm zero = 0i64;
  imm nine = 9i64;
  mut r = &zero;
  refstore(&mut r, &nine);
  show("stored-through-param", *r);
}
