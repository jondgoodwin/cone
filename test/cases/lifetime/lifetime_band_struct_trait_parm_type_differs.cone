// A struct declaring a lifetime whose method takes a different parameter type
// than its trait's ('i64' for 'i32') does not meet the trait.
//
// Verdict: refuse, ErrorInvType at the struct (the requirement unmet).
// Basis: parameter types between a requirement and its implementation match
// exactly, whatever lifetimes the struct declares.

mod lifetime_band_struct_trait_parm_type_differs;

trait Tk {
  pub fn num(self: &mut, k: i32) i32;
}

struct B['a] is Tk {    //~ ErrorInvType "the signature Tk requires"
  pub t: &'a Array[u8];
  pub fn num(self: &mut, k: i64) i32 { 1 }
}
