// Bug 122 (H2): a '&'static' result is no place for the parameter's own borrow just because the type argument names its lifetime. Refuse.
mod lifetime_refuse_static_ret_names_inner_lifetime;
import stdio use *;
struct Node['a] { pub l: &'a i64; }
fn mk(l: &'a Node['a]) &'static Node['a] { l }  //~ ErrorEscape
fn main() { var n = 5i64; var nd = Node(&n); print <- mk(&nd).l, "\n"; }
