// Bug 48/51: must compile and run (arena lab jn_g2).
mod lifetime_arena_ok_unwrap_push;
import stdio use *;
import arena use *;
import collections use *;
// unwrap of a reference held in a node, then a push, then a use
struct Node { pub val: i64; pub l: Option[&mut Node]; pub kids: List[&mut Node]; }
fn go(n: &mut Node) i64 {
  let x = n.l.unwrap();
  n.kids.push(x);
  x.val
}
fn main() {
  var a = Arena();
  let c = a.alloc(Node(5, None[&mut Node], List[&mut Node]()));
  let r = a.alloc(Node(0, Some(c), List[&mut Node]()));
  print <- go(r), "\n";
}
