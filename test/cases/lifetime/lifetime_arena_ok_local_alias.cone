// Bug 51: a local '&mut' alias of a local arena stores what a direct a.alloc may: a local declared before the arena. Compile and run.
mod lifetime_arena_ok_local_alias;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
fn main() {
  var t = T(5);
  var a = Arena();
  let r = &mut a;
  let h = r.alloc(H(&mut t));
  print <- h.p.v, "\n";
}
