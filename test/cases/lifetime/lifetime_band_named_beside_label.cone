// A tick begins three things: a lifetime on a reference type ('&'a Array[i64]), a
// loop's label (''a: while'), and a character literal ('a'). Each is read as
// what it is in one function, and the label still names the loop a 'break'
// leaves -- though it is spelled as the lifetime is: a label is a name in the
// function's scope, a lifetime a name only its signature compares.
//
// Verdict: accept; prints 3, then 97.
// Basis: reftoken.html, "Lifetime Annotation" (a tick and a letter with no
// closing tick); the loop label is a lifetime token at a statement's start,
// a lifetime on a type follows '&'.

mod lifetime_band_named_beside_label;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn firstOver(xs &'a Array[i64], limit &'b i64) &'a i64 {
  mut i = 0usize;
  'a: while i < xs.len() - 1usize {
    if xs[i] > *limit {
      break 'a;
    }
    i = i + 1usize;
  }
  &xs[i];
}

fn main() {
  imm arr = [1i64, 2i64, 3i64, 4i64];
  imm found = {
    imm limit = 2i64;
    firstOver(&arr, &limit);
  };
  show("first-over", *found);
  imm c = 'a';
  show("char", i64.from(c));
}
