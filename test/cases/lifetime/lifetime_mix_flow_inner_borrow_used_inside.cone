// A variable holding a parameter's borrow is given a borrow of an inner
// block's local, and used only inside that block: a variable's lifetime
// follows what it holds now, so this is safe.
//
// Verdict: accept; prints 1.
// Basis: language rule (2 Oct 2026), the flow rule -- a variable's lifetime
// follows what it currently holds, so a variable may hold borrows of
// different lifetimes over its life; this program is the rule's safe case.
// Rust: accepted (the reference's region need only cover its uses; by
// reading, not run).
// Master d331baab: refused, ErrorInvType at 'r = &y' ("lval outlives the
// borrowed reference you are storing") -- safe code refused. Stage 4 fixed
// it.

mod lifetime_mix_flow_inner_borrow_used_inside;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn f(p &i64) i64 {
  mut r = p;
  mut t = 0i64;
  {
    imm y = 1i64;
    r = &y;
    t = *r;
  }
  t;
}

fn main() {
  imm four = 4i64;
  show("inner-borrow-used-inside", f(&four));
}
