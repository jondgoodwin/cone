// Bug 51 (spike): a closure owning a finalizable value that holds a local, stored in the arena. Refuse.
mod lifetime_arena_refuse_final_owned_by_closure;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: &mut T; fn final(self: &uni) { print <- self.p.v, "\n"; } }
fn stash(ar: &mut Arena) {
  var t = T(7);
  let f = F(&mut t);
  ar.alloc(fn() [g = f] i64 { g.p.v });  //~ ErrorCallEscape
}
fn main() {
  var a = Arena();
  stash(&mut a);
}
