// A variable holding a borrow is borrowed itself, then given a shorter-lived
// borrow. What is read through the second borrow can be that value, so it may
// not be kept where it outlives what it borrows.
//
// Verdict: refuse, ErrorFrozen at the inner local, which ends while a holder
// that read it, or could still read it, is used afterwards.
// Basis: the lifetime invariant (references-and-regions.md): whatever holds a
// borrow must not outlive its referent; and the flow rule (2 Oct 2026), a
// variable's lifetime follows what it holds now, read through a reference to it
// as by its name.
// Master 6e9ae3d48: all accepted, and they dangle. Row 913.

mod lifetime_mix_borrowed_var_repointed_kept;

struct S {
  pub r: &usize;
}
struct W {
  pub p: &mut &usize;
}

fn set(x: &mut &'v usize, v: &'v usize) {
  *x = v;
}

// Stored: 'out' holds what was read through 'p'
fn stored() {
  var a = 1usize;
  var out = [&a];
  {
    var b = 2usize;           //~ ErrorFrozen
    var h = &a;
    var p = &mut h;
    h = &b;
    out[0usize] = *p;
  }
  let v = *out[0usize];
}

// Read through 'p' itself after the source ends
fn readLater() {
  var a = 1usize;
  var h = &a;
  var p = &mut h;
  {
    var b = 2usize;           //~ ErrorFrozen
    h = &b;
  }
  let v = **p;
}

// A field of a struct is borrowed, then stored over
fn fieldBorrowed() {
  var a = 1usize;
  var s = S(&a);
  var p = &mut s.r;
  {
    var b = 2usize;           //~ ErrorFrozen
    s.r = &b;
  }
  let v = **p;
}

// ... and the whole struct replaced
fn wholeReplaced() {
  var a = 1usize;
  var s = S(&a);
  var p = &mut s.r;
  {
    var b = 2usize;           //~ ErrorFrozen
    s = S(&b);
  }
  let v = **p;
}

// The store reaches the variable through another reference to it
fn throughAnother() {
  var a = 1usize;
  var out = [&a];
  {
    var b = 2usize;           //~ ErrorFrozen
    var h = &a;
    var p = &mut h;
    var q = &mut h;
    *q = &b;
    out[0usize] = *p;
  }
  let v = *out[0usize];
}

// ... or through a call
fn throughCall() {
  var a = 1usize;
  var h = &a;
  var p = &mut h;
  {
    var b = 2usize;           //~ ErrorFrozen
    set(&mut h, &b);
  }
  let v = **p;
}

// ... or a swap with another holder
fn throughSwap() {
  var a = 1usize;
  var h = &a;
  var p = &mut h;
  {
    var b = 2usize;           //~ ErrorFrozen
    var k = &b;
    h <-> k;
  }
  let v = **p;
}

// A reference to the reference to it
fn twoDeep() {
  var a = 1usize;
  var h = &a;
  var p = &mut h;
  var pp = &mut p;
  {
    var b = 2usize;           //~ ErrorFrozen
    h = &b;
  }
  let v = ***pp;
}

// The borrow of the variable held inside a struct
fn heldInStruct() {
  var a = 1usize;
  var h = &a;
  let w = W(&mut h);
  {
    var b = 2usize;           //~ ErrorFrozen
    h = &b;
  }
  let v = **w.p;
}
