// A struct declaring lifetimes whose method promises less than its trait
// does: the trait's 'pick' ties its result to the receiver, and its ''b'
// argument apart; the struct's returns the ''b' argument. A call through the
// trait would keep the receiver, not the argument, borrowed for the result,
// so the method does not meet the requirement.
//
// Verdict: refuse, ErrorInvType at the struct (the requirement unmet).
// Basis: an implementation meets a requirement only where it promises at
// least what the requirement does: its result may hold no part the
// requirement's may not (lifetime_band_struct_impl_promises_more is the other
// direction); a struct's lifetimes, parts its trait's 'Self' lacks, are
// compared receiver by receiver, and the ''b' parameter part by part.
// Master b07a3adc: refused at parse (ErrorBadTok: a lifetime in a struct's
// brackets).

mod lifetime_band_struct_trait_promise_differs;

struct R { pub n i64; }

trait Picker {
  pub fn pick(self &, b &'b R) &R;
}

struct Cursor['a] is Picker {    //~ ErrorInvType "the signature Picker requires"
  pub items &[]'a R;
  pub fn pick(self &, b &'b R) &'b R { b; }
}
