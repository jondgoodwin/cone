// A borrow taken through an owner held in a field of a borrowed parameter is
// bounded by whoever holds the owner -- here the caller, through the
// parameter -- so it may be returned.
//
// Verdict: accept; prints 6.
// Basis: reading of the rules above, not a settled rule (an owning reference
// carries no limit itself; a borrow through one is bounded by whoever holds
// the owner).
// Master d331baab: correct.

mod lifetime_band_return_through_owner_field_of_param;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct R { pub n i64; }
struct Box { pub rc Rc[mut, R]; }

fn inner(b &Box) &i64 { &b.rc.n; }

fn main() {
  imm b = new Box(new Rc[mut, R](6));
  show("through-owner-field", *inner(&b));
}
