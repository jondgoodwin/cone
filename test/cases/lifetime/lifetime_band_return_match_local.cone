// A 'match' returned as the function's value, one arm giving a local's
// borrow: refused like the 'if'.
//
// Verdict: refuse, ErrorEscape at the local's arm.
// Basis: Jon, 26 Sep 2026 (Backlog\regions.md): the more conservative
// lifetime at every join; his 1 Oct band ordering.
// Master d331baab: accepted, and it dangles -- main, run, prints 0, not 42.
// xfail until Stage 1.

mod lifetime_band_return_match_local;

import stdio use *;

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

fn f(k i64, a &i64) &i64 {
  imm x = 42i64;
  match k {
    case 0 { a; }
    else { &x; }             //~ ErrorEscape
  }
}

fn main() {
  imm one = 1i64;
  imm r = f(5, &one);
  clobber(21);
  printInt(*r);
  printStr("\n");
}
