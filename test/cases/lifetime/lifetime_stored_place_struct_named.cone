// #1202: the same as lifetime_stored_place_struct_elided with the one explicit name: the same verdict.
mod lifetime_stored_place_struct_named;
import stdio use *;
struct H['a] { pub p: &'a i32; }
fn put(slot: &'z mut H['z], v: &'z i32) { slot.p = v; }
fn main() {
  let a = 1;
  var s = H(&a);
  { let x = 5; put(&mut s, &x); }  //~ ErrorFrozen
  print <- *s.p, "\n";
}
