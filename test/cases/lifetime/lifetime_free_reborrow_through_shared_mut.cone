// A reborrow through a '&mut' borrow, and a write through the '&mut' itself
// while the reborrow is still to be used. In Cone '&mut' is shared-mutable:
// what it reaches is a shared path, frozen by a borrow only against being
// ended, so both writes are allowed. This is where Cone departs from Rust on
// purpose -- Rust's '&mut' is Cone's '&uni', and lifetime_free_uni_param_frozen
// is the refusal Rust would give here.
//
// Verdict: accept; prints 2.
// Basis: language rule (26 Sep 2026) -- Cone's '&mut' is not Rust's: it is
// shareable and does not freeze its source; refborref.html, "Freezing access
// to the source of a borrow" (a source reached through a shared path is
// frozen only against ending). Rust refuses the literal translation ('let r = &mut k; let
// r2 = &mut *r; *r = 1; *r2 = 2;', E0506; by reading, not run), which is the
// '&uni' case, not this one.
// Master d331baab: correct.

mod lifetime_free_reborrow_through_shared_mut;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  mut k = 0i64;
  imm r = &mut k;
  imm r2 = &mut *r;
  *r = 1;
  *r2 = 2;
  show("shared-mut-reborrow", k);
}
