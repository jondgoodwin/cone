// Bug 51: 'new a[H](...)' is 'a.alloc(H(...))': a local's reference stored in the caller's arena. Refuse.
mod lifetime_arena_refuse_new;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
fn stash(a: &mut Arena) i64 {
  var t = T(77);
  let h = new a[H](&mut t);  //~ ErrorCallEscape
  h.p.v
}
fn main() {
  var a = Arena();
  print <- stash(&mut a), "\n";
}
