// A rotation of twelve references settles and the program runs (Bugs 57, 58): no loop is widened
mod lifetime_loop_rotation_long;
import stdio use *;
fn main() {
  let x = 7;
  var a0 = &x; var a1 = &x; var a2 = &x; var a3 = &x; var a4 = &x; var a5 = &x; var a6 = &x; var a7 = &x; var a8 = &x; var a9 = &x; var a10 = &x; var a11 = &x;
  var i = 0;
  while i < 30 { a0 = a1; a1 = a2; a2 = a3; a3 = a4; a4 = a5; a5 = a6; a6 = a7; a7 = a8; a8 = a9; a9 = a10; a10 = a11; a11 = &x; i += 1; }
  print <- *a0, "\n";
}
