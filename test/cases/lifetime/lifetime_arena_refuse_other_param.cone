// Bug 68: the stored borrow is of one parameter, the arena reached through another (m1). Refuse.
mod lifetime_arena_refuse_other_param;
import stdio use *;
import arena use *;
struct N { pub p: &i32; fn final(self: &uni) { print <- "n reads ", *self.p, "\n"; } }
struct Hd { pub ar: &mut Arena; pub base: i32; }
struct C { n: i32; fn go(self: &C, h: &mut Hd) { h.ar.alloc(N(&self.n)); }  //~ ErrorCallEscape
}
fn scope(h: &mut Hd) { let c = C(5); c.go(h); }
fn main() { var ar = Arena(); var h = Hd(&mut ar, 10); scope(&mut h); }
