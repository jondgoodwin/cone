// A parameter's borrow copied into a local and returned from it: copying a
// borrow does not shorten it.
//
// Verdict: accept; prints 4.
// Basis: language rule (1 Oct 2026) -- the lifetime is part of the borrow's
// type, which the copy carries.
// Master d331baab: correct.

mod lifetime_mix_param_kept_in_local_returned;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn keep(a &i64) &i64 {
  mut r = a;
  r;
}

fn main() {
  imm four = 4i64;
  show("param-kept-in-local", *keep(&four));
}
