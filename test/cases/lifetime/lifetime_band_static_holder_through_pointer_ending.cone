// lifetime_band_static_holder_through_pointer with a field '&'a str': a
// record holding a borrow that ends, reached through the raw pointer an
// unannotated method of 'self' returns, carries the receiver's loan, a borrow
// of '*self', so 'self' may not be reshaped, nor written by another path,
// while the record is used.
//
// Verdict: refuse: ErrorShapeReshape at 'self.mark(i)', ErrorFrozen at
// 'self.log.push(i)'.
// Basis: mem-lifetimes.html (an unannotated signature's borrows share one
// lifetime); flow's "A change through another name".
// Master c85d9fa99: refused the same.

mod lifetime_band_static_holder_through_pointer_ending;

import stdio use *;
import libc;
import collections use List;

struct Fault {
  code: u32;
  detail: &'a str;
}

struct Rec {
  n: u32;
  addrs: List[u32];
  failure: Option[Fault];
}

struct Driver {
  blocks: List[*Rec];
  log: List[u32];
  marked: List[u32];

  fn recAt(self: &, i: u32) *Rec {
    *blocks[usize.from(i / 4u32)] + usize.from(i % 4u32)
  }

  fn grow(self: &mut) {
    let block = libc.malloc(4usize * mem.sizeof[Rec]()) as *Rec;
    var j = 0usize;
    while j < 4usize {
      mem.writeRaw[Rec](block + j, Rec(0u32, List[u32].empty(), None[Fault]));
      j = j + 1usize;
    }
    blocks.push(block);
  }

  fn mark(self: &mut, i: u32) {
    marked.push(i);
  }

  fn touch(self: &mut, i: u32) {
    let c = self.recAt(i) as &mut Rec;
    c.addrs.clear();
    self.mark(i);           //~ ErrorShapeReshape "'mark' reshapes the 'Driver'"
    c.addrs.push(7u32);
    self.log.push(i);       //~ ErrorFrozen "'*self' is borrowed (by 'recAt'"
    c.n = c.n + 1u32;
    c.failure = Some[Fault](Fault(3u32, "refused"));
  }

  fn free(self: &mut) {
    var b = 0usize;
    while b < blocks.len() {
      let block = *blocks[b];
      var j = 0usize;
      while j < 4usize {
        mem.finalize[Rec](block + j);
        j = j + 1usize;
      }
      libc.free(block as *u8);
      b = b + 1usize;
    }
  }
}

fn show(d: &Driver, i: u32) {
  let c = d.recAt(i) as &Rec;
  printInt(i64.from(c.n) + i64.from(u64.from(c.addrs.len())));
  printStr(" ");
  match c.failure {
    case let Some(f) {printStr(f.detail);}
    else {printStr("none");}
  }
  printStr("\n");
}

fn main() {
  var d = Driver(List[*Rec].empty(), List[u32].empty(), List[u32].empty());
  d.grow();
  d.touch(1u32);
  show(&d, 1u32);
  {
    let c = d.recAt(2u32) as &mut Rec;
    c.n = 1u32;
  }
  show(&d, 2u32);
  d.free();
}
