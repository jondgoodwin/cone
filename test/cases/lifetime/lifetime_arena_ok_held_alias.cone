// Bug 61: a local alias of a lent struct's arena allocates a number from it and stores no borrow of the other parameter in it. Compile and run.
mod lifetime_arena_ok_held_alias;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct Hd { pub ar: &mut Arena; }
struct N { pub v: i64; }
fn use1(a: &mut Hd, x: &mut T) i64 { let ar = a.ar; let n = ar.alloc(N(x.v)); n.v + x.v } //~ WarnLifetimeTie
fn scope(q: &mut Arena) i64 { var h = Hd(q); var t = T(7); use1(&mut h, &mut t) }
fn main() { var a = Arena(); print <- scope(&mut a), "\n"; }
