// Bug 51: the arena reached through a struct field; a by-value argument to its alloc is a store. Refuse.
mod lifetime_arena_refuse_field;
import stdio use *;
import arena use *;
// the arena reached through a struct field, a parameter's reference stored into it: MUST be refused
struct T { pub v: i64; }
struct H { pub p: &mut T; }
struct Holder { pub ar: Arena; }
fn stash(h: &mut Holder, x: &mut T) i64 {
  let n = h.ar.alloc(H(x));  //~ ErrorCallEscape
  n.p.v
}
fn make(h: &mut Holder) i64 {
  var t = T(77);
  stash(h, &mut t)
}
fn main() {
  var h = Holder(Arena());
  print <- make(&mut h), "\n";
}
