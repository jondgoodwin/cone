// An 'if' value that may hold a borrow of either local keeps both frozen
// until its last use.
//
// Verdict: refuse, ErrorFrozen at the change of 'q'.
// Basis: borrow-freezing rule (26 Sep 2026) -- the sources stay frozen until
// the borrow's last use on any path; read with the language rule (26 Sep
// 2026) that at a join a borrow takes the shorter of its arms' lifetimes.
// Master d331baab: correct.

mod lifetime_free_if_value_either_frozen;

struct Pt { pub x i64; pub y i64; }

fn f(c Bool) i64 {
  mut p = new Pt(1, 2);
  mut q = new Pt(3, 4);
  imm w = if c { &p; } else { &q; };
  q.x = 5;                   //~ ErrorFrozen
  w.x;
}
