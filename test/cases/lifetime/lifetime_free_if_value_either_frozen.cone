// An 'if' value that may hold a borrow of either local keeps both frozen
// until its last use.
//
// Verdict: refuse, ErrorFrozen at the change of 'q'.
// Basis: freezing-design.md 2.11 (how long the sources stay frozen: "until
// the last use on any path"), reading Jon's 26 Sep join ruling ("the more
// conservative of the lifetimes"); the freezing design he ruled 26 Sep.
// Master d331baab: correct.

mod lifetime_free_if_value_either_frozen;

struct Pt { pub x i64; pub y i64; }

fn f(c Bool) i64 {
  mut p = new Pt(1, 2);
  mut q = new Pt(3, 4);
  imm w = if c { &p; } else { &q; };
  q.x = 5;                   //~ ErrorFrozen
  w.x;
}
