// A caller naming its own lifetimes hands a bounded generic a borrow of one
// lifetime for T and a place, or an argument, of another: ''y' is not known
// to last ''x', so the borrow may not go where ''x' borrows are held, nor be
// returned as ''x'. lifetime_bound_generic_relied_on's 'relay' is this call
// with 'where 'y >= 'x'.
//
// Verdict: refuse, ErrorCallEscape at the call that stores, ErrorEscape at
// the return.
// Basis: language rule (3 Oct 2026): a type argument holding borrows meets
// ''a' only where each is known to last it, by a 'where' clause or what the
// types imply; the caller is held to its own order (reflifefn.html,
// "Lifetime bounds").
// Master 2cb190a1: refused at parse. This compiler with both refusals turned
// off accepts it, and main, run, prints "final" as s dies and then the
// value read through d from s's freed block.

mod lifetime_bound_generic_caller_unordered;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn put[T + 'a](d &mut &'a R, x T) {
  *d = x;
}

fn pick[T + 'a](x T, y &'a R) &'a R {
  x;
}

fn relay(d &mut &'x R, v &'y R) {
  put(d, v);                 //~ ErrorCallEscape "lent through 'v'"
}

fn relayPick(v &'y R, w &'x R) &'x R {
  pick(v, w);                //~ ErrorEscape "lent through 'v'"
}

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

fn main() {
  imm g = new R(1);
  mut d = &g;
  {
    imm s = new So[R](42);
    relay(&mut d, &*s);
  }
  clobber(21);
  printStr("read = ");
  printInt(d.n);
  printStr("\n");
  printInt(relayPick(&g, &g).n);
}
