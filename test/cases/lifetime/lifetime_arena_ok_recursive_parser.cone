mod lifetime_arena_ok_recursive_parser;
import stdio use *;
import arena use *;

struct Node['a] { pub val: i64; pub l: Option[&'a mut Node['a]]; pub r: Option[&'a mut Node['a]]; }
struct P { pub pos: i64; pub depth: i64; }

// A recursive parser over a plain parser struct; the node results are stored into other nodes.
// Form A: methods of P, results named with the arena's lifetime.
// Form B: free functions with the parser as an ordinary parameter.
fn leafB(p: &mut P, ar: &'a mut Arena) &'a mut Node['a] {
  p.pos += 1;
  ar.alloc(Node(p.pos, None, None))
}
fn exprB(p: &mut P, ar: &'a mut Arena) &'a mut Node['a] {
  var l = leafB(p, ar);
  p.depth += 1;
  if p.depth < 4 {
    let r = exprB(p, ar);
    let b = ar.alloc(Node(0, Some(l), Some(r)));
    p.pos += 1;
    l = b;
  }
  l
}

struct Q {
  pub pos: i64;
  pub depth: i64;
  fn leaf(self: &mut, ar: &'a mut Arena) &'a mut Node['a] {
    pos += 1;
    ar.alloc(Node(pos, None, None))
  }
  fn expr(self: &mut, ar: &'a mut Arena) &'a mut Node['a] {
    var l = self.leaf(ar);
    depth += 1;
    if depth < 4 {
      let r = self.expr(ar);
      let b = ar.alloc(Node(0, Some(l), Some(r)));
      self.leaf(ar);
      l = b;
    }
    l
  }
}

fn main() {
  var a = Arena();
  var p = P(0, 0);
  let t = exprB(&mut p, &mut a);
  print <- t.val, "\n";
  var q = Q(0, 0);
  let u = q.expr(&mut a);
  print <- u.val, "\n";
}
