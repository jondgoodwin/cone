// A struct built around a parameter's borrow and returned: it holds a caller
// band borrow, so it may go back to the caller.
//
// Verdict: accept; prints 8.
// Basis: language rule (1 Oct 2026) -- lifetimes are infectious (the 2019
// post "Infectious Typing"): a value holding a borrow takes on its lifetime;
// reflifefn.html, "Lifetime Annotations on Fields". Every design under
// consideration for lifetimes on types gives an unannotated 'H' in a
// signature the one unnamed lifetime, so this does not wait on that choice.
// Master d331baab: correct.

mod lifetime_mix_param_in_struct_returned;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct R { pub n i64; }
struct H { pub r &R; }

fn wrap(p &R) H { new H(p); }

fn main() {
  imm x = new R(8);
  imm h = wrap(&x);
  show("param-in-struct", h.r.n);
}
