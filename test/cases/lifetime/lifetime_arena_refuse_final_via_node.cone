// Bug 51 (spike): a plain node holding a local's borrow, then a finalizable node reaching it, stored in the arena. Refuse.
mod lifetime_arena_refuse_final_via_node;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
struct F { pub h: &mut H; fn final(self: &uni) { print <- self.h.p.v, "\n"; } }
fn stash(ar: &mut Arena) {
  var t = T(7);
  let n = ar.alloc(H(&mut t));
  ar.alloc(F(n));  //~ ErrorCallEscape
}
fn main() {
  var a = Arena();
  stash(&mut a);
}
