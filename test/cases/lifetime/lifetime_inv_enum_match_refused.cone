// The lifetime a pattern binding keeps is the matched value's, never loosened: a value of one
// invariant lifetime taken from an enum is refused where another's is wanted.
//
// Verdict: refuse, ErrorBrand at each call.

mod lifetime_inv_enum_match_refused;

import stdio use *;

struct Tok['=a] { pub v: i64; }
enum E['=a] {
  T(Tok['=a]);
  Z;
}
fn same(x: Tok['=a], y: Tok['=a]) i64 { x.v + y.v }
fn cross(e: E['=a], t: Tok['=b]) i64 {
  match e {
    case let T(k) { same(k, t) }      //~ ErrorBrand
    else { 0 }
  }
}
enum Either[A, B] {
  L(A);
  R(B);
}
fn crossg(e: Either[Tok['=a], Tok['=a]], t: Tok['=b]) i64 {
  match e {
    case let L(k) { same(k, t) }      //~ ErrorBrand
    else { 0 }
  }
}
fn main() {}
