// A variable given an inner local's borrow, used, and then given the
// parameter's borrow back before it is returned: at the return it holds only
// the caller's borrow.
//
// Verdict: accept; prints 3 and 4.
// Basis: Jon, 2 Oct 2026 ~00:20, decision 2 RULED (b), flow (WI\lifetimes.md,
// Rulings): a variable's lifetime follows what it currently holds;
// freezing-design.md 2.4 (an assignment replaces what a holder holds).
// Rust: accepted (by reading, not run).
// Master d331baab: refused, ErrorInvType at 'r = &y' -- safe code refused.
// xfail until Stage 4.

mod lifetime_mix_flow_reassigned_back_returned;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

mut T i64 = 0;

fn f(p &i64) &i64 {
  mut r = p;
  {
    imm y = 3i64;
    r = &y;
    T = *r;
  }
  r = p;
  r;
}

fn main() {
  imm four = 4i64;
  imm r = f(&four);
  show("used-inner", T);
  show("returned-param", *r);
}
