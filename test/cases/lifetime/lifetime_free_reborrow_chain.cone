// A chain of reborrows, each used and then given back in turn, innermost
// first.
//
// Verdict: accept; prints 4.
// Basis: refborref.html ("Borrowing through a borrowed reference ... keeps
// frozen whatever r itself froze, while the new borrow is still to be used").
// Rust: NLL accepts (reborrow constraints, RFC 2094; by reading, not run).
// Master d331baab: correct.

mod lifetime_free_reborrow_chain;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  mut k = 1i64;
  imm r = &mut k;
  imm r2 = &mut *r;
  imm r3 = &mut *r2;
  *r3 = 2;
  *r2 = *r2 + 1;
  *r = *r + 1;
  show("reborrow-chain", k);
}
