// A callee handed '&mut h', 'h' a struct whose field is a '&mut &mut &R'
// lent from 'p', itself lent from 'q', may store its other argument three
// levels down ('**h.r = v'): into 'q'. So 'q' holds that borrow afterwards,
// and its source may not end while 'q' is used.
//
// Verdict: refuse, ErrorFrozen where 's' is declared (it ends first).
// Basis: borrow-freezing rule (26 Sep 2026) -- a store through a reference
// puts the stored borrow's loans into what it points at, through every
// writable borrow the argument reaches, at any depth.
// Master b306a838: accepted, and it reads freed memory -- main, run, prints
// "final" (for 's') and then "read = 2254894194720" through 'q'.

mod lifetime_free_call_store_three_levels_frozen;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

struct H2 { pub r &mut &mut &R; }

fn st(h &mut H2, v &R) { **h.r = v; }

fn main() {
  imm outer = new R(1);
  mut q = &outer;
  {
    imm s = new So[R](42);   //~ ErrorFrozen
    mut p = &mut q;
    mut h = new H2(&mut p);
    st(&mut h, &*s);
  }
  printStr("read = ");
  printInt(q.n);
  printStr("\n");
}
