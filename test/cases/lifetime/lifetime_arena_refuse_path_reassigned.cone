// Bug 48/51: the path the arena is reached by is reassigned between taking the value and the store: the stale value is another arena's. Refuse.
mod lifetime_arena_refuse_path_reassigned;
import stdio use *;
import arena use *;
struct W { pub a: &mut Arena; }
struct S { pub home: &mut Arena; }
fn bad(s: &mut S, other: &mut Arena) {
  let old = s.home;
  s.home = other;
  s.home.alloc(W(old));  //~ ErrorCallEscape
}
fn main() {
  var a = Arena();
  var b = Arena();
  var s = S(&mut a);
  bad(&mut s, &mut b);
}
