// A ''static' parameter's borrow stored into a global, bare and inside an
// 'Option': what is handed to it must be global, so it may go anywhere.
//
// Verdict: accept; prints 42 twice.
// Basis: language rule (1 Oct 2026) -- a borrow of global lifetime may
// travel anywhere; refmodule.html names the global lifetime ''static'.
// Master 78fdce5a: correct.

mod lifetime_band_store_static_param_into_global;

import stdio use *;

mut D i64 = 0;
mut E i64 = 42;
mut G &i64;
mut GO Option[&i64];

fn @initpure init() {
  G = &D;
  GO = None[&i64][];
}

fn stash(r &'static i64) {
  G = r;
  GO = Some[&i64][r];
}

fn main() {
  stash(&E);
  printInt(*G);
  printStr("\n");
  match GO {
    case imm e Some {
      printInt(*e.value);
      printStr("\n");
    }
    else {}
  }
}
