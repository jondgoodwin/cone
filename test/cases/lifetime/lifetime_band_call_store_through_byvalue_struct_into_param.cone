// A callee handed, by value, a struct whose field reborrows what the
// parameter 'q' points at, may store its other argument through that field
// ('*w.w = v'): into the caller's place. A borrow of a local stored there
// outlives the local. A by-value argument holding a writable borrow is
// stored through as a '&mut' argument is.
//
// Verdict: refuse, ErrorCallEscape at the call.
// Basis: reflifefn.html, "Mutable borrowed reference parameters", with the
// reading that a by-value argument carrying a borrow is a borrowed argument
// too (lifetimes are infectious, 1 Oct 2026); what a borrowed parameter
// points at outlives the function (decision 1, 1 Oct 2026).
// Master b306a838: accepted, and it reads freed memory -- main, run, prints
// "final" (for 's') and then "read = 2259186082128" through 'q'. A call was
// checked for stores only through an argument that is itself a '&mut'.

mod lifetime_band_call_store_through_byvalue_struct_into_param;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

struct W { pub w &mut &R; }

fn st(w W, v &R) { *w.w = v; }

fn f(q &mut &R) {
  imm s = new So[R](42);
  st(new W(&mut *q), &*s);      //~ ErrorCallEscape
}

fn main() {
  imm outer = new R(1);
  mut q = &outer;
  f(&mut q);
  printStr("read = ");
  printInt(q.n);
  printStr("\n");
}
