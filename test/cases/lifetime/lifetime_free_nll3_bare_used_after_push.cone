// The unsafe neighbour of lifetime_free_nll3_bare_returned_on_one_path: the
// borrow is returned on the path that pushed, so the push may move the
// element it points at.
//
// Verdict: refuse, ErrorFrozen at the push.
// Basis: the freezing design Jon ruled 26 Sep 2026 (freezing-design.md 1: a
// borrow held across a push that may reallocate).
// Rust: refused by NLL and Polonius alike (E0502; by reading, not run).
// Master d331baab: correct.

mod lifetime_free_nll3_bare_used_after_push;

import collections use *;

fn firstAfterPush(l &uni List[i64]) &i64 {
  imm e = l[0usize];
  l.push(7);                 //~ ErrorFrozen
  e;
}
