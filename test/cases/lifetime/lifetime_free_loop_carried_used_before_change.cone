// A borrow carried around a loop's back edge into the next iteration, used
// there before the push, and replaced after it: at each push the holder's
// next use is behind a reassignment, so the list is free.
//
// Verdict: accept; prints 2.
// Basis: borrow-freezing rule (26 Sep 2026) -- the walk follows the back edge
// and drops a holder's conflicts when it is reassigned.
// Master d331baab: correct.

mod lifetime_free_loop_carried_used_before_change;

import stdio use *;
import collections use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  var l = List[i64].empty();
  l.push(1);
  let zero = 0i64;
  var held = &zero;
  var i = 0;
  var t = 0i64;
  while i < 3 {
    t = t + *held;
    l.push(2);
    held = l[0usize];
    i = i + 1;
  }
  show("sum-of-carried", t);
}
