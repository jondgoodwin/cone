// Bug 51: the key rule (ErrorKeyBorrow) on the route into DynArena.alloc: through a generic function. Refuse.
mod lifetime_arena_key_generic;
import arena use *;
struct Holder { pub r: &i64; }

fn put[T](d: &mut DynArena['=a], v: T) &'=a mut T { d.alloc(v) }  //~ ErrorKeyBorrow
fn main() {
  var ar = DynArena.empty();
  let x = 7i64;
  let k = put(&mut ar, Holder(&x)); //~ ErrorKeyBorrow
}
