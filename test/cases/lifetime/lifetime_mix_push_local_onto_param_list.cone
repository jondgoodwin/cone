// A borrow of a local pushed onto a list of borrows the caller lent as
// '&mut': the caller's list outlives the local.
//
// Verdict: refuse, ErrorCallEscape at the push (a call storing a borrow
// through its '&mut' receiver).
// Basis: refborref.html, "Lifetime Constraints"; reflifefn.html, "Mutable
// borrowed reference parameters", widened to a receiver holding borrows --
// agent's reading (design note, cases 9 and 12).
// Master d331baab: accepted, and it reads freed memory -- main, run, prints
// "final" and then "read = 2505422971424". xfail until Stage 2.

mod lifetime_mix_push_local_onto_param_list;

import stdio use *;
import collections use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn fill(l &mut List[&R]) {
  imm x = new So[R](42);
  l.push(&*x);               //~ ErrorCallEscape
}

fn main() {
  mut l = List[&R].empty();
  fill(&mut l);
  printStr("read = ");
  printInt((*l[0usize]).n);
  printStr("\n");
}
