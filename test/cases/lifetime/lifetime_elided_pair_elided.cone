// #1202: a signature with no lifetime written is one explicit name (design-principles.md). This and
// lifetime_elided_pair_named are the same function written both ways; they must give the same verdict.
// Reduced from spatialindex's octree walkRay: a recursive call in a loop handing on 'self' and a closure argument.
mod lifetime_elided_pair_elided;
import stdio use *;
import collections use *;

struct Tree[T] {
  nodes: List[u32];
  items: List[T];
  fn walk[F: fn(t: u32) f32](self: &, node: u32, limit0: f32, visit: &mut F) f32 {
    var limit = limit0;
    let res = visit(node);
    if res < 0. {return -1.;}
    var j = 0u32;
    while j < node {
      limit = walk(node - 1u32, limit, visit);
      if limit < 0. {return -1.;}
      j = j + 1u32;
    }
    limit
  }
  pub fn go[F: fn(t: u32) f32](self: &, visit: &mut F) { walk(3u32, 1., visit); }
  pub fn goAll[F: fn(t: u32) bool](self: &, visit: &mut F) {
    var wrap = fn(t: u32) f32 { if visit(t) { 1. } else { 0. } };
    go(&mut wrap);
  }
}
fn main() {
  var t = Tree[i32](List[u32](), List[i32]());
  var n = 0;
  var g = fn(x: u32) bool { n += 1; true };
  t.goAll(&mut g);
  print <- n, "\n";
}
