// Problem case #1 with the borrow used again after the push: the source is
// still frozen at the push.
//
// Verdict: refuse, ErrorFrozen at the push.
// Basis: the freezing design Jon ruled 26 Sep 2026 (freezing-design.md 1,
// rule 2: while a mutable borrow is still to be used, the source may not be
// touched except through it).
// Rust: the same program with 'capitalize(slice)' after the push is refused
// (E0499; by the RFC's reasoning, not run).
// Master d331baab: correct.

mod lifetime_free_nll1_used_after_push;

import collections use *;

fn capitalize(l &mut List[i64]) { l.push(2); }

fn f() {
  mut data = List[i64].empty();
  imm slice = &mut data;
  capitalize(slice);
  data.push(3);              //~ ErrorFrozen
  capitalize(slice);
}
