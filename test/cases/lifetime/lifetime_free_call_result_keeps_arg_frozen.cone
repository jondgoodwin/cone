// A borrow returned by a call is a borrow of what the call was handed: while
// it is still to be used, the argument's source stays frozen.
//
// Verdict: refuse, ErrorFrozen at the change.
// Basis: refborref.html, "A borrow a method returns" ("the returned borrow
// keeps each borrowed argument frozen, as if it were that borrow itself");
// reflifefn.html's status note.
// Master d331baab: correct.

mod lifetime_free_call_result_keeps_arg_frozen;

fn same(x &mut i64) &mut i64 { x; }

fn f() i64 {
  mut k = 1i64;
  imm r = same(&mut k);
  k = 2;                     //~ ErrorFrozen
  *r;
}
