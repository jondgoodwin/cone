// A swap stores in both directions. A borrowed parameter swapped into a place reached through a call's
// result (the place on the left) is refused: that place is held to the global lifetime.
//
// Verdict: refuse, ErrorInvType (1013) at the place reached through the call.
// Basis: as lifetime_band_store_callresult_ref_param_refused; swapFlow read the same unset scope. Lane 710.

mod lifetime_band_swap_callresult_into_place_refused;

struct Globals { n: i32; r: &i32; }

fn glob() *Globals { null as *Globals }

pub fn swapIn(x: &i32) {
  var mine = x;
  (*glob()).r <-> mine;   //~ ErrorInvType
}

fn main() i32 { 0 }
