// Bug 51 (narrowed): the local declared after the arena dies first, but the node holding its borrow has no 'final' and is read only inside the local's scope.
mod lifetime_arena_ok_local_alias_declared_after;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
fn main() {
  var a = Arena();
  var t = T(5);
  let r = &mut a;
  let h = r.alloc(H(&mut t));
  print <- h.p.v, "\n";
}
