// 'where '=a == '=b' declares two invariant names one brand: inside, a key
// of one opens an arena of the other; at a call, both are bound to the one
// brand the caller gives them.
//
// Verdict: accept; prints 7 9.
// Basis: a where clause declares two invariant names the same brand, so a
// key of one unlocks the other (invariant lifetimes, settled 3 Oct 2026).
// Master 1117c92a: no DynArena, and ''=a' refused at lex.

mod lifetime_inv_where_equal;

import stdio use *;
import arena use *;

struct R { pub n i64; pub m i64; }

fn readN(ar &DynArena['=a], k &'=b R) i64 where '=a == '=b {
  ar[k].n;
}

fn readM(ar &DynArena['=b], k &'=a R) i64 where '=b == '=a {
  ar[k].m;
}

fn main() {
  mut a = DynArena.empty();
  imm k = a.alloc(new R(7, 9));
  printInt(readN(&a, k));
  printStr(" ");
  printInt(readM(&a, k));
  printStr("\n");
}
