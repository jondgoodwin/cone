// A generic 'Peek' adapter over a lending reader: the reader refills ONE buffer
// and lends each line from it, so a line is good only until the next 'next'.
// 'Peek.peek' keeps the line it pulled in its own field 'held', then
// 'skipSource' pulls from the source again, refilling the buffer under the
// held line; 'take' hands the held line back, now another line's bytes. The
// store 'held = src.next()' keeps a borrow of the adapter's own field 'src'
// (the reader lends from itself) in the adapter, which the caller may then
// change: refused where it is written, in the instance for the reader.
//
// Verdict: refuse, ErrorSelfStore, in the instance 'Peek[&Array[u8], Reader]'.
// Basis: lifetimes-design-2026-10-01 section 4.10 (a value holding a borrow
// of its own field). Measured 10 Oct 2026 (lending-iterators-measured-2026-
// 10-10, 3k).
// Master 03de4a12: accepted; 'peek', two 'skipSource' and 'take' printed the
// third line where the first was held ('c' for 'a').
// The same adapter over a list's cursor, whose items outlive its steps, is
// lifetime_band_self_store_peek_list: accepted.

mod lifetime_band_self_store_peek_refused;

import stdio use *;
import collections use *;

struct Reader is Iterator[&Array[u8]] {
  buf List[u8];
  k u8;
  total u8;
  pub fn next(self &mut) Option[&Array[u8]] {
    if k >= total { return None[&Array[u8]][]; }
    k = k + 1u8;
    buf.clear();
    mut i = 0u8;
    while i < k { buf.push('a' + k - 1u8); i = i + 1u8; }
    Some[&Array[u8]][buf.view()];
  }
}

struct Peek[T, I Iterator[T]] {
  pub src I;
  pub held Option[T];

  pub fn peek(self &mut) {
    match held {
      case is Some { return; }
      case is None { }
    }
    held = src.next();   //~ ErrorSelfStore "Stored into 'self.held', the value carries a borrow of 'self.src'"
  }
  pub fn skipSource(self &mut) { src.next(); }
  pub fn take(self &mut) Option[T] {
    imm out = held;
    held = None[T][];
    out;
  }
}

fn main() {
  mut p = new Peek[&Array[u8], Reader](new Reader(List[u8].empty(), 0u8, 4u8), None[&Array[u8]][]);
  p.peek();
  p.skipSource();
  p.skipSource();
  match p.take() {
    case imm e Some { printUInt(u64.from(e[0usize])); }
    case is None { }
  }
  printStr("\n");
}
