// The manual's 'tryit' with 'refval' marked by a lifetime of its own: the
// callee promises not to store one borrow in the other, so the call is
// allowed with 'b' shorter than 'a'.
//
// Verdict: accept; prints 10 (the value copied through, not the borrow).
// Basis: reflifefn.html, "Mutable borrowed reference parameters" ("make the
// refstore function promise it won't store one reference inside the other").
// The manual writes 'refmut &mut &i32', through which '**refmut = ...' could
// not write; '&mut &mut i32' keeps its point. Unannotated, the same program
// is accepted too, 'a' not being used after 'b' ends
// (lifetime_band_call_tryit_store_into_local); 'a' used after that is
// refused there, where named apart it is not.
// Master d331baab: refused at parse ('b read as a loop label). Stage 6 fixed
// it.

mod lifetime_band_named_refstore_independent;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn refstore(refmut &mut &mut i32, refval &'b i32) {
  **refmut = *refval;
}

fn main() {
  mut i = 5;
  mut a = &mut i;
  {
    imm b = 10;
    refstore(&mut a, &b);
  }
  show("named-refstore", i64.from(i));
}
