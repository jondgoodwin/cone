// The neighbour of lifetime_free_call_result_keeps_arg_frozen: after the
// returned borrow's last use, the argument's source is free.
//
// Verdict: accept; prints 7.
// Basis: refborref.html, "A borrow a method returns" ("until its last use").
// Master d331baab: correct.

mod lifetime_free_call_result_after_last_use;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn same(x &mut i64) &mut i64 { x; }

fn main() {
  mut k = 1i64;
  imm r = same(&mut k);
  *r = 5;
  k = k + 2;
  show("source-after-returned-borrow", k);
}
