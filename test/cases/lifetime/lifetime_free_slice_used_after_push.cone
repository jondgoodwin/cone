// A slice view of a list is a borrow of the list: a push while the view is
// still to be used may move the elements it shows.
//
// Verdict: refuse, ErrorFrozen at the push.
// Basis: mem-borrowing.html#returned, "A borrow a function returns".
// Master d331baab: correct.

mod lifetime_free_slice_used_after_push;

import collections use *;

fn f() i64 {
  var l = List[i64].empty();
  l.push(1);
  let s = l.view();
  l.push(2);                 //~ ErrorFrozen
  i64.from(s.len)
}
