// A mutable borrow made before a 'match', used in one arm only; another arm
// changes the source directly. Nothing uses the borrow after the match.
//
// Verdict: accept; prints 5 and 7.
// Basis: borrow-freezing rule (26 Sep 2026; restated 1 Oct 2026) -- a borrow
// active in one branch and not the others leaves its source usable in those.
// Rust: NLL accepts the same shape (by reading; not run).
// Master d331baab: correct.

mod lifetime_free_match_arm_write_other_arm;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pt { pub x i64; pub y i64; }

fn f(k i64) i64 {
  mut p = new Pt(1, 2);
  imm r = &mut p;
  match k {
    case 1 { r.x = 5; }
    else { p.x = 7; }
  }
  p.x;
}

fn main() {
  show("borrow-arm", f(1));
  show("source-arm", f(2));
}
