// Bug 77, the caller half: 'put' stores a borrow derived from 'l' (&l[0]) where 'h' points, and its where clause says 'l >= 'h. The call is checked against it, so a caller that lets 'l' die first is refused (it used to be accepted: the own-loan shortcut skipped the check, and 'h.r' dangled).
mod lifetime_band_call_put_list_where_refused;
import stdio use *;
import collections use List;
struct Pt { pub v: i64; }
struct Host['h] { pub r: &'h Pt; }
fn put(h: &mut Host['h], l: &'l mut List[Pt]) where 'l >= 'h { h.r = &l[0usize]; }
fn main() {
  var base = Pt(0i64);
  var h = Host(&base);
  { var l = List[Pt](); l.push(Pt(1i64)); put(&mut h, &mut l); }  //~ ErrorFrozen
  print <- h.r.v, "\n";
}
