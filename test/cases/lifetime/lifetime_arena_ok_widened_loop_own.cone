// Bug 56: must compile and run: a widened loop, a store of the arena's own node.
mod lifetime_arena_ok_widened_loop_own;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; }
fn stash(ar: &mut Arena) i64 {
  var f1 = ar.alloc(F(None)); var f2 = ar.alloc(F(None)); var f3 = ar.alloc(F(None)); var f4 = ar.alloc(F(None)); var f5 = ar.alloc(F(None)); var f6 = ar.alloc(F(None));
  var i = 0;
  while i < 10 { f1 = f2; f2 = f3; f3 = f4; f4 = f5; f5 = f6; f6 = ar.alloc(F(None)); i += 1; }
  let t = ar.alloc(T(7));
  f1.p = Some(t);
  t.v
}
fn main() {
  var a = Arena();
  print <- stash(&mut a), "\n";
}
