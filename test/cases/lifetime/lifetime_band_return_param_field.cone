// A field reached through a borrowed parameter lives as long as what the
// parameter points at -- the caller's -- so a borrow of it may be returned.
//
// Verdict: accept; prints 7.
// Basis: language rule (1 Oct 2026) -- the caller band; a borrow's lifetime
// is part of the parameter's type.

mod lifetime_band_return_param_field;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pt { pub x i64; pub y i64; }

fn xOf(p &Pt) &i64 { &p.x; }

fn main() {
  imm p = new Pt(7, 8);
  show("field-of-param", *xOf(&p));
}
