// A call handed a parameter's borrow and a local's, its result used only
// inside the function.
//
// Verdict: accept; prints 3.
// Basis: reflifefn.html (the result has the shortest borrowed argument's
// lifetime, here the local's); Jon, 1 Oct 2026, decision 1 (a function's own
// lifetime is usable anywhere inside it).
// Master d331baab: correct.

mod lifetime_mix_call_param_and_local_used_inside;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn larger(a &i64, b &i64) &i64 {
  if *a > *b { a; } else { b; }
}

fn f(p &i64) i64 {
  imm x = 3i64;
  imm r = larger(p, &x);
  *r;
}

fn main() {
  imm one = 1i64;
  show("call-mixed-used-inside", f(&one));
}
