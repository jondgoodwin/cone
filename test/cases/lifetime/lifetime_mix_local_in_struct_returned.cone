// A struct built around a local's borrow and returned: the struct has the
// local's lifetime, so it may not leave the function.
//
// Verdict: refuse, ErrorEscape at the returned struct.
// Basis: reflifefn.html, "Lifetime Annotations on Fields" (its 'makewrap'
// example: "this value is lifetime-constrained to this function and may not
// be returned"); the 2019 post "Infectious Typing".
// Master d331baab: accepted, and it reads freed memory -- main, run, prints
// "final" and then "read = 2041266807264". Stage 4 fixed it.

mod lifetime_mix_local_in_struct_returned;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

struct H { pub r &R; }

fn wrap() H {
  imm x = new So[R](42);
  new H(&*x);                //~ ErrorEscape
}

fn main() {
  imm h = wrap();
  printStr("read = ");
  printInt(h.r.n);
  printStr("\n");
}
