// A 'match' whose arms each give an unannotated borrowed parameter, or a
// global: every arm outlives the function, so the match may be returned.
//
// Verdict: accept; prints 1, 2 and 9.
// Basis: reflifefn.html (all unannotated borrows share one lifetime); Jon,
// 1 Oct 2026 (WI\lifetimes.md): global travels anywhere; his 26 Sep join rule
// (the shortest arm) -- here every arm is in the caller band or global.
// Master d331baab: correct.

mod lifetime_band_return_match_params;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

mut G i64 = 9;

fn choose(k i64, a &i64, b &i64) &i64 {
  match k {
    case 0 { a; }
    case 1 { b; }
    else { &G; }
  }
}

fn main() {
  imm one = 1i64;
  imm two = 2i64;
  show("match-a", *choose(0, &one, &two));
  show("match-b", *choose(1, &one, &two));
  show("match-global", *choose(2, &one, &two));
}
