// A mutable borrow of one field of a local, and the whole struct copied out
// while the borrow is still to be used. The borrow is an alias loan: the struct
// is read beside it, the copy has the field as it was, and the write through
// the borrow follows.
//
// Verdict: accept; prints 123. (Refused, ErrorFrozen at the copy, until 11 Oct
// 2026.)
// Basis: language rule (11 Oct 2026) -- locals lend several '&mut', as
// parameters already do; mem-borrowing.html#freezing, "What a borrow leaves its source free to do".
// Master cb9e00ea: refused.

mod lifetime_free_field_borrow_whole_read;

import stdio use *;

struct Pt { pub x i64; pub y i64; }

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn f() i64 {
  mut p = new Pt(1, 2);
  imm a = &mut p.x;
  imm q = p;
  *a = 3;
  q.x * 100 + q.y * 10 + p.x;
}

fn main() {
  show("copy-beside-field-borrow", f());
}
