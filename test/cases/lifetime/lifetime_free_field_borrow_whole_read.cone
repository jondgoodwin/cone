// A mutable borrow of one field freezes that field, and the whole struct
// overlaps it: copying the whole struct out reads the frozen field.
//
// Verdict: refuse, ErrorFrozen at the copy.
// Basis: refborref.html, "Freezing access to the source of a borrow" (a
// mutable borrow's source "may not be read"; a field borrow freezes "that
// field, and the whole struct with it").
// Master d331baab: correct.

mod lifetime_free_field_borrow_whole_read;

struct Pt { pub x i64; pub y i64; }

fn f() i64 {
  mut p = new Pt(1, 2);
  imm a = &mut p.x;
  imm q = p;                 //~ ErrorFrozen
  *a = 3;
  q.y;
}
