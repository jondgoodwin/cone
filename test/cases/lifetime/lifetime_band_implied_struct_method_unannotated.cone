// A method of a struct declaring ''a', its result written with no lifetime:
// the result has the lifetime of the borrow of 'self', the unnamed one. A
// borrow of an 'H['a]' implies that ''a' outlasts it -- the struct lives no
// longer than what it borrows, so neither does a borrow of the struct -- and
// so the field's ''a' borrow may be returned as the shorter, unnamed one. At
// the call the result keeps 'h' borrowed, the shorter of the two.
//
// Verdict: accept; prints 7 and 9.
// Basis: implied bounds (a borrow of a value holding lifetimes implies each
// of them outlasts the borrow), as Rust's well-formedness of '&'s H<'a>'
// implies ''a: 's', which is what lets its elision read 'fn get(&self) -> &R'.
// Master 19cc839b: refused, ErrorEscape at 'r' ("Returned value carries the
// borrow the caller lent through 'self' (its ''a')").

mod lifetime_band_implied_struct_method_unannotated;

import stdio use *;

struct R { pub n i64; }

struct H['a] {
  pub r &'a R;
  pub fn get(self &) &R { r; }
}

fn twice(h &H) i64 {
  imm got = h.get();
  got.n + 2;
}

fn main() {
  imm a = new R(7);
  imm h = new H(&a);
  imm got = h.get();
  printInt(got.n);
  printStr(" ");
  printInt(twice(&h));
  printStr("\n");
}
