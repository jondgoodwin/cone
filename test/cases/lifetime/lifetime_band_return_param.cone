// A borrowed parameter's borrow came from the caller, so the function may hand
// it back: it is in the caller band, which outlives the function.
//
// Verdict: accept; prints 42.
// Basis: language rule (1 Oct 2026) -- a borrowed reference coming into a
// function from its caller is in the caller's band, whose lifetime is longer
// than the function's; mem-lifetimes.html#returned, "A returned borrow".

mod lifetime_band_return_param;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn same(x &i64) &i64 { x; }

fn main() {
  let k = 42i64;
  let r = same(&k);
  show("returned-param", *r);
}
