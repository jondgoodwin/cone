// '>=' is transitive: with ''a >= 'b and 'b >= 'c', a ''a' borrow may be
// returned where a ''c' one is promised; nothing orders ''c' before ''a',
// so the reverse is refused. Clauses joined by 'and' each hold.
//
// Verdict: refuse, ErrorEscape at the returned ''c' borrow; 'chain' is
// accepted.
// Basis: ''a >= 'b' and ''b >= 'c' make ''a' last at least as long as ''c';
// the order is the clauses' and their transitive closure, nothing more.
// Master b07a3adc: refused at parse (ErrorWhereForm: a 'where' clause is a
// type parameter's name, 'is', and a trait).

mod lifetime_band_where_transitive;

struct R { pub n i64; }

fn chain(a &'a R, b &'b R, c &'c R) &'c R where 'a >= 'b and 'b >= 'c {
  a;
}

fn chainRev(a &'a R, b &'b R, c &'c R) &'a R where 'a >= 'b and 'b >= 'c {
  c;                         //~ ErrorEscape
}
