// Bug 68: an arena held by value in a struct stores a borrow of another field of the same struct; moving the struct moves that field but not the arena's blocks. Refuse.
mod lifetime_arena_refuse_self_field_moves;
import stdio use *;
import arena use *;
struct N { pub p: &i32; fn final(self: &uni) { print <- "n reads ", *self.p, "\n"; } }
struct C { n: i32; ar: Arena; fn go(self: &mut C) { self.ar.alloc(N(&self.n)); }  //~ ErrorCallEscape
}
fn main() { var c = C(5, Arena()); c.go(); var d = c; }
