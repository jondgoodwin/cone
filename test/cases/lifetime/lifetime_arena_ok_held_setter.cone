// Bug 61: a parameter's field that holds an arena is set from another parameter: a store into the struct, not into an arena node. Compile and run.
mod lifetime_arena_ok_held_setter;
import stdio use *;
import arena use *;
struct S { pub home: &mut Arena; }
struct N { pub v: i64; }
fn set(s: &mut S, other: &mut Arena) { s.home = other; }
fn main() {
  var a = Arena();
  var b = Arena();
  var s = S(&mut a);
  set(&mut s, &mut b);
  let n = s.home.alloc(N(5));
  print <- n.v, "\n";
}
