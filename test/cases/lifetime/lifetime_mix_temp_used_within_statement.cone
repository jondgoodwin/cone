// A borrow of a temporary used only within its own statement: the temporary
// is ended at the statement's end, after the use.
//
// Verdict: accept; prints "read = 5", then "final", then "end".
// Basis: Rust's rule for temporaries (dropped at the end of the enclosing
// statement; The Rust Reference, "Destructors"), adopted as Cone's model on
// 2 Oct 2026; #241 built the statement-end finalization.
// Master d331baab: correct.

mod lifetime_mix_temp_used_within_statement;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn mkso(n i64) So[R] { new So[R](n); }
fn id(r &R) &R { r; }

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  show("read", id(mkso(5)).n);
  printStr("end\n");
}
