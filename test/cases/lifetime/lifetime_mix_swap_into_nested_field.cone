// An inner block's borrow swapped into a field of a struct nested in an outer
// one, read after the block: the outer variable holds the inner owner's
// borrow, however deep in its value the swap lands.
//
// Verdict: refuse, ErrorFrozen at the inner owner, which goes out of scope
// while 'g' still holds a borrow of it (ref_flow_freeze's idiom).
// Basis: a swap is a store in both directions (ref_flow_swap); language rule
// (2 Oct 2026), the flow rule -- a variable's lifetime follows what it holds
// now.
// Master b705e902: accepted, and it reads freed memory -- main, run, prints
// "final" and then "read = <garbage>".

mod lifetime_mix_swap_into_nested_field;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

struct H { pub r &R; }
struct G { pub h H; }

fn main() {
  imm outer = new R(1);
  mut g = new G(new H(&outer));
  {
    imm s = new So[R](42);   //~ ErrorFrozen
    mut t = &*s;
    g.h.r <=> t;
  }
  printStr("read = ");
  printInt(g.h.r.n);
  printStr("\n");
}
