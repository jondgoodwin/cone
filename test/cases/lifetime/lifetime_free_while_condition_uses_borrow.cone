// A loop condition reads through a borrow, and the body changes the source:
// the condition is used again on the next iteration, so the source is still
// frozen in the body.
//
// Verdict: refuse, ErrorFrozen at the change.
// Basis: refborref.html ("The last use may be on any path the program can
// take: a later iteration of a loop ... is a use too").
// Rust: refused (E0506; by reading, not run).
// Master d331baab: correct.

mod lifetime_free_while_condition_uses_borrow;

fn f() i64 {
  mut k = 1i64;
  imm r = &k;
  while *r < 3 {
    k = k + 1;               //~ ErrorFrozen
  }
  k;
}
