// Bug 77, the caller half, the accepting twin of lifetime_band_call_put_arena_where_refused: the arena outlives 'h'.
mod lifetime_band_call_put_arena_where_ok;
import stdio use *;
import arena use Arena;
struct Pt { pub v: i64; }
struct Host['h] { pub r: &'h Pt; }
fn put(h: &mut Host['h], a: &'a mut Arena) where 'a >= 'h { h.r = a.alloc(Pt(1i64)); }
fn main() {
  var ar = Arena();
  var base = Pt(0i64);
  var h = Host(&base);
  put(&mut h, &mut ar);
  print <- h.r.v, "\n";
}
