// A lifetime bound on a name that is no type parameter of the function --
// one it does not declare, or written on a function that is not generic --
// and one on its generic type's parameter, from a method's 'where' clause.
//
// Verdict: refuse: ErrorWhereSubject at each bound on no parameter of the
// function, ErrorLifetimeBound at the bound on the type's parameter.
// Basis: language rule (3 Oct 2026): a bound is on a generic function's own
// type parameter; a generic type's parameter takes none yet, since its
// instance's members are made from arguments erased (reflifefn.html,
// "Lifetime bounds"; refgeneric.html, "Where clause").
// Master 2cb190a1: refused at parse.

mod lifetime_bound_nameres_refused;

struct R { pub n i64; }

fn notParm[T](x T, y &'a R) where U + 'a {           //~ ErrorWhereSubject "not a type parameter"
}

fn notGeneric(x &R, y &'a R) where T + 'a {          //~ ErrorWhereSubject "not a type parameter"
}

struct Box[T] {
  pub v T;
  fn put(self &, d &mut &'a R, x T) where T + 'a {   //~ ErrorLifetimeBound "type parameter of the generic type"
  }
}
