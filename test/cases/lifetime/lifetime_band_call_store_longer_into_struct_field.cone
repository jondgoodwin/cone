// The counterpart of lifetime_band_call_store_into_struct_field: the borrow
// handed in lives as long as the struct, so the store the callee may make is
// safe.
//
// Verdict: accept; prints 2.
// Basis: reflifefn.html, "Mutable borrowed reference parameters" (moving 'b'
// to the same scope as 'a' makes the call legal).
// Master d331baab: correct.

mod lifetime_band_call_store_longer_into_struct_field;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct R { pub n i64; }
struct H { pub r &R; }

fn st(h &mut H, r &R) { h.r = r; }

fn main() {
  imm outer = new R(1);
  imm other = new R(2);
  mut h = new H(&outer);
  st(&mut h, &other);
  show("stored-same-scope", h.r.n);
}
