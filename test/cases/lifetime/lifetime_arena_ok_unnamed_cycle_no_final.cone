// Bug 48/51 (narrowed): the lab's parser with a cycle (jn_a5), no lifetime written. The nodes have no 'final', so storing a result that may come from p or ar back into the arena is no store.
mod lifetime_arena_ok_unnamed_cycle_no_final;
import stdio use *;
import arena use *;
// scratch Arena: recursive descent over a token list, parser state in a struct, nodes of different
// sizes, a cycle, and a type written back into a node during a match
struct Ty { pub size: i64; }
struct Num { pub v: i64; pub ty: Option[&mut Ty]; }
struct Bin { pub l: Expr; pub r: Expr; pub ty: Option[&mut Ty]; pub owner: Option[&mut Fun]; }
struct Fun { pub body: Option[Expr]; pub calls: i64; }
enum Expr {
  N(&mut Num);
  B(&mut Bin);
}
struct P { pub pos: usize; pub n: usize; }
fn term(p: &mut P, ar: &mut Arena) Expr {
  p.pos = p.pos + 1usize;
  Expr.N(ar.alloc(Num(1, None[&mut Ty])))
}
fn expr(p: &mut P, ar: &mut Arena, f: &mut Fun) Expr {
  let l = term(p, ar);
  if p.pos >= p.n { return l; }
  let r = expr(p, ar, f);
  Expr.B(ar.alloc(Bin(l, r, None[&mut Ty], Some(f))))
}
fn check(e: &mut Expr, t: &mut Ty) i64 {
  match e {
    case let N(n) { n.ty = Some(t); n.v }
    case let B(b) { b.ty = Some(t); check(&mut b.l, t) + check(&mut b.r, t) }
  }
}
fn main() {
  var ar = Arena();
  let f = ar.alloc(Fun(None[Expr], 0));
  let t = ar.alloc(Ty(8));
  var p = P(0usize, 5usize);
  var e = expr(&mut p, &mut ar, f);
  print <- check(&mut e, t), "\n";
}
