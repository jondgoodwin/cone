// A borrow used on a path that returns early; on the path that goes on, the
// source is changed.
//
// Verdict: accept; prints 1 and 5.
// Basis: borrow-freezing rule (26 Sep 2026) -- an arm ending in 'return'
// contributes nothing to the join.
// Master d331baab: correct.

mod lifetime_free_early_return;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pt { pub x i64; pub y i64; }

fn f(c bool) i64 {
  mut p = new Pt(1, 2);
  imm r = &mut p;
  if c { return r.x; }
  p.x = 5;
  p.x;
}

fn main() {
  show("returned-early", f(true));
  show("changed-after", f(false));
}
