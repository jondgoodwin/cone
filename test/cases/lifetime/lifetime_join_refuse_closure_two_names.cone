// Bug 62: a closure storing a caller's borrow under one name into a caller's holder under another (no younger local, no arena). Refuse: the borrows are one value, and a store through it could put the younger one where the holder points.
// Master e9e953096: compiled, and the program printed: holder reads 0
// (the younger local's function had returned and a call had reused its stack before the read; 7 would have been a live read).
mod lifetime_join_refuse_closure_two_names;
import stdio use *;
struct T { pub v: i64; }
struct H['a] { pub p: Option[&'a mut T]; }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
fn stash(h: &mut H['a], x: &'b mut T) { var g = fn() { h.p = Some(x); }; g(); }  //~ ErrorCallEscape
fn scope(h: &mut H['a]) { var t = T(7); stash(h, &mut t); }
fn main() { var h = H(None); scope(&mut h); print <- clobber(3), "\n"; match h.p { case let Some(r) { print <- "holder reads ", r.v, "\n"; } case None { print <- "none\n"; } } }
