// 'arena[key]' costs nothing at run time: the brands were compared at
// compile time, so the arena's '[]' is the key's own pointer, with no check,
// and once inlined the read is a load through the key.
//
// Verdict: accept; prints 42. The '[]' instance answers its key as it is,
// and the optimized 'main' calls no '[]'.
// Basis: the lock-and-key check is identities compared inside the type
// check, nothing at run time (invariant lifetimes, settled 3 Oct 2026).
// Master 1117c92a: no DynArena, and ''=a' refused at lex.

mod lifetime_inv_index_plain_pointer;

import stdio use *;
import arena use *;

fn main() {
  mut a = DynArena.empty();
  imm k = a.alloc(41i64);
  a[k] += 1;
  printInt(*a[k]);
  printStr("\n");
}
