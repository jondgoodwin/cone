// What a loop may do with arenas: one made in each pass and used within it,
// each pass's arena its own; and a fixed number of arenas, each with its own
// name, made before the loop and used in every pass.
//
// Verdict: accept; prints 3 and 108: the first pass of 'named' adds 2 and
// 11, each later one 2 more than the pass before.
// Basis: an arena minted inside a loop lasts for its pass; a fixed number of
// arenas, each with its own name, is fine (invariant lifetimes, settled
// 3 Oct 2026).
// Master 1117c92a: no DynArena, and ''=a' refused at lex.

mod lifetime_inv_loop_pass_own;

import stdio use *;
import arena use *;

struct R { pub n i64; }

fn perPass() i64 {
  mut sum = 0i64;
  mut i = 0i64;
  while i < 3 {
    mut a = DynArena.empty();
    imm k = a.alloc(new R(i));
    sum = sum + a[k].n;
    i = i + 1;
  }
  sum;
}

fn named() i64 {
  mut small = DynArena.empty();
  mut large = DynArena.empty();
  imm s = small.alloc(new R(1));
  imm l = large.alloc(new R(10));
  mut sum = 0i64;
  mut i = 0;
  while i < 6 {
    small[s].n += 1;
    large[l].n += 1;
    sum = sum + small[s].n + large[l].n;
    i = i + 1;
  }
  sum;
}

fn main() {
  printInt(perPass());
  printStr(" ");
  printInt(named());
  printStr("\n");
}
