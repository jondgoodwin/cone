// Bug 122 (row 740 step 0 a): a '&'static Node['a]' that is really the argument's own borrow, kept in a '&'static' field past the local's block. Refused at the body (and the caller).
mod lifetime_refuse_static_ret_caller_field;
import stdio use *;
struct Node['a] { pub l: &'a i64; }
struct Holder { pub r: &'static Node['static]; }
fn mk(l: &'a Node['a]) &'static Node['a] { l }  //~ ErrorEscape
fn main() {
    var n0 = 1i64; var nd0 = Node(&n0);
    var h = Holder(mk(&nd0));
    {
        var n = 5i64; var nd = Node(&n);  //~ ErrorFrozen
        h.r = mk(&nd);
    }
    print <- h.r.l, "\n";
}
