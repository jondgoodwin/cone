// Bug 51: a scratch arena holding a reference to a local declared after it, result kept. Refuse.
mod lifetime_arena_refuse_scratch_kept;
import stdio use *;
import arena use *;
// scratch arena holding a reference to a local declared AFTER it: MUST be refused
struct T { pub v: i64; }
struct H { pub p: &mut T; fn final(self: &uni) { print <- "f ", p.v, "\n"; } }
fn main() {
  var a = Arena();
  var t = T(1);  //~ ErrorFrozen
  let h = a.alloc(H(&mut t));
  print <- h.p.v, "\n";
}
