// Problem case #2 with a bare element borrow: borrowed and used in one arm,
// the list pushed onto in the other.
//
// Verdict: accept; prints 9 and 2.
// Basis: borrow-freezing rule (26 Sep 2026) -- a source is frozen only on the
// paths where the borrow is still to be used.
// Rust: RFC 2094, problem case #2 -- NLL accepts (not run).
// Master d331baab: correct.

mod lifetime_free_nll2_bare_arm;

import stdio use *;
import collections use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn touch(c bool, l &uni List[i64]) {
  if c {
    imm e = &mut l[0usize];
    *e = 9;
  }
  else {
    l.push(1);
  }
}

fn main() {
  imm l = new So[List[i64]](List[i64].empty());
  l.push(0);
  touch(true, l);
  show("written-in-one-arm", *l[0usize]);
  touch(false, l);
  show("pushed-in-other-arm", i64.from(l.len()));
}
