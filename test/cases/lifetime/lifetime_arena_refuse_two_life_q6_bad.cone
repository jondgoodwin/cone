// Bug 65: direct ar: &'a mut Arena; the caller lends a shorter borrow.
mod lifetime_arena_refuse_two_life_q6_bad;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- "finalizer reads ", r.v, "\n"; } case None { print <- "none\n"; } } } }
fn put(ar: &'a mut Arena, x: &'a mut T) { var f = ar.alloc(F(None)); f.p = Some(x); }
fn scope(a: &mut Arena) { var t = T(7); put(a, &mut t); }  //~ ErrorCallEscape
fn main() { var a = Arena(); scope(&mut a); }
