// The manual's 'refswitch' with the names the other way round: the result
// shares 'ref2''s lifetime, which is 'inner''s, so the caller may not keep it
// past 'inner''s block.
//
// Verdict: refuse, ErrorFrozen where 'inner' goes out of scope while 'ref',
// used after, holds the call's borrow of it. (Written first as ErrorInvType
// at the store, a guess; a store into a local follows what it holds, so the
// refusal is where the source ends, as for any borrow kept past its source.)
// Basis: reflifefn.html, "Returned borrowed references" ("caller once again
// triggers a compiler error").
// Master d331baab: refused at parse ('a read as a loop label), not at the
// store. Stage 6 fixed it.

mod lifetime_band_named_refswitch_returns_named;

fn refswitch(nbr i32, ref1 &'a i32, ref2 &i32) &i32 {
  ref2;
}

fn caller() i32 {
  mut ref &i32;
  imm outer = 5;
  {
    imm inner = 10;                       //~ ErrorFrozen
    ref = refswitch(1, &outer, &inner);
  }
  *ref;
}
