// The manual's 'refswitch' with the names the other way round: the result
// shares 'ref2''s lifetime, which is 'inner''s, so the caller may not keep it
// past 'inner''s block.
//
// Verdict: refuse, ErrorInvType at the caller's store.
// Basis: reflifefn.html, "Returned borrowed references" ("caller once again
// triggers a compiler error").
// Master d331baab: refused at parse ('a read as a loop label), not at the
// store. xfail until Stage 6.

mod lifetime_band_named_refswitch_returns_named;

fn refswitch(nbr i32, ref1 &'a i32, ref2 &i32) &i32 {
  ref2;
}

fn caller() i32 {
  mut ref &i32;
  imm outer = 5;
  {
    imm inner = 10;
    ref = refswitch(1, &outer, &inner);   //~ ErrorInvType
  }
  *ref;
}
