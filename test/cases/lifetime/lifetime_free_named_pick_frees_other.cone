// With 'b' given a lifetime of its own, the result is tied to 'a' alone, so
// 'b' is free while the result is used.
//
// Verdict: accept; prints 1.
// Basis: reflifefn.html ("mark every other borrowed reference with a
// different lifetime annotation"; the 'refswitch' example); borrow-freezing
// rule (26 Sep 2026) -- a returned borrow freezes every borrowed argument,
// and lifetime annotations, once built, narrow that to the arguments named.
// Master d331baab: refused at parse ('b read as a loop label). xfail until
// Stage 6.

mod lifetime_free_named_pick_frees_other;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn pick(a &i64, b &'b i64) &i64 { a; }

fn main() {
  mut a = 1i64;
  mut b = 2i64;
  imm r = pick(&a, &b);
  b = 5;
  show("other-free", *r);
}
