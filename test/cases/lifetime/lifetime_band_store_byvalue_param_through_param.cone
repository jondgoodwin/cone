// A borrow of a by-value parameter stored through a '&mut &T' parameter into
// the caller's place: the by-value parameter ends at the return.
//
// Verdict: refuse, ErrorInvType at the store.
// Basis: Jon, 1 Oct 2026, decision 1 RULED (WI\lifetimes.md): never
// "returned or stored outward".
// Master d331baab: accepted, and it dangles -- main, run, prints 0, not 42.
// xfail until Stage 1.

mod lifetime_band_store_byvalue_param_through_param;

import stdio use *;

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

fn point(dst &mut &i64, x i64) {
  *dst = &x;                 //~ ErrorInvType
}

fn main() {
  imm zero = 0i64;
  mut r = &zero;
  point(&mut r, 42);
  clobber(21);
  printInt(*r);
  printStr("\n");
}
