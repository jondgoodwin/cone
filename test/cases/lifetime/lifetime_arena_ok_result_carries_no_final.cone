// Bug 48 item 4 (narrowed): a result that carries a parameter's loan, stored in the arena in a node with no 'final'. No store, so nothing reads the loan after it ends.
mod lifetime_arena_ok_result_carries_no_final;
import stdio use *;
import arena use *;
struct Node { pub val: i64; pub l: Option[&mut Node]; }
struct W { pub n: &mut Node; }
fn id(p: &mut Node, ar: &mut Arena) &mut Node { p } //~ WarnLifetimeTie
fn go(ar: &mut Arena) i64 {
  var q = Node(1, None[&mut Node]);
  let w = ar.alloc(W(id(&mut q, ar)));
  w.n.val
}
fn main() {
  var a = Arena();
  print <- go(&mut a), "\n";
}
