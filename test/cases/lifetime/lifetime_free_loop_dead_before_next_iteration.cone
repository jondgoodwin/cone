// A variable declared outside a loop is given an element borrow each
// iteration, used, and the list then pushed onto: the holder is reassigned
// before its next use, so it is dead at every push.
//
// Verdict: accept; prints 3.
// Basis: borrow-freezing rule (26 Sep 2026) -- reassigning the holder drops
// its pending conflicts, around a loop as anywhere.
// Rust: NLL accepts the same shape ('held = &v[0]; t += *held; v.push(2);'
// in a loop) -- liveness, by reading; not run.
// Master d331baab: correct.

mod lifetime_free_loop_dead_before_next_iteration;

import stdio use *;
import collections use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  mut l = List[i64].empty();
  l.push(1);
  imm zero = 0i64;
  mut held = &zero;
  mut i = 0;
  mut t = 0i64;
  while i < 3 {
    held = l[0usize];
    t = t + *held;
    l.push(2);
    i = i + 1;
  }
  show("sum-of-firsts", t);
}
