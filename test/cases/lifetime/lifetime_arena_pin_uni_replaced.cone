// Pin: a reference into a Uni's contents stored in an arena node, the Uni replaced. Refuse (ErrorVariantReshape).
mod lifetime_arena_pin_uni_replaced;
import stdio use *;
import arena use *;
// a reference into what a Uni owns, the Uni in an arena node, stored in an arena node, then the Uni replaced: MUST be refused
struct Box { pub v: i64; }
struct O { pub u: Option[Uni[Box]]; }
struct H { pub p: Option[&mut i64]; }
fn go(ar: &mut Arena) i64 {
  let o = ar.alloc(O(Some(Uni[Box](Box(1)))));
  var r = 0i64;
  match &mut o.u {
    case let Some(b) {
      let h = ar.alloc(H(Some(&mut b.v)));
      o.u = None[Uni[Box]];
      r = *h.p.unwrap();  //~ ErrorVariantReshape
    }
    else {}
  }
  r
}
fn main() {
  var a = Arena();
  print <- go(&mut a), "\n";
}
