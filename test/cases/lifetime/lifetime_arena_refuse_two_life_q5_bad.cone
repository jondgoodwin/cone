// Bug 65: Hd['a] holder, caller passes a shorter borrow. Refused in the body for now: the holder form cannot yet name the arena's lifetime (q5_safe is refused too).
mod lifetime_arena_refuse_two_life_q5_bad;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- "finalizer reads ", r.v, "\n"; } case None { print <- "none\n"; } } } }
struct Hd['a] { pub ar: &'a mut Arena; }
fn put(h: &mut Hd['a], x: &'a mut T) { var f = h.ar.alloc(F(None)); f.p = Some(x); }  //~ ErrorEscape
fn scope(a: &mut Arena) { var t = T(7); var h = Hd(a); put(&mut h, &mut t); }
fn main() { var a = Arena(); scope(&mut a); }
