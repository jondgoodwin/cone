// A struct holding a borrow, used and then dead: the source may be changed
// after the struct's last use.
//
// Verdict: accept; prints 1 and 2.
// Basis: borrow-freezing rule (26 Sep 2026) -- a value holding a borrow
// freezes its source only until its last use.
// Master d331baab: correct, but only because a borrow inside a struct
// freezes nothing yet; Stage 3 must keep this passing.

mod lifetime_free_struct_holder_dead_before_change;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct R { pub n i64; }
struct H { pub r &R; }

fn main() {
  mut x = new R(1);
  imm h = new H(&x);
  show("through-struct", h.r.n);
  x.n = 2;
  show("source-after-struct", x.n);
}
