// Bug 51: a scratch arena holding a reference to a local declared before it. Compile and run.
mod lifetime_arena_ok_scratch_before;
import stdio use *;
import arena use *;
// scratch arena holding a reference to a local declared BEFORE it: must compile
struct T { pub v: i64; }
struct H { pub p: &mut T; fn final(self: &uni) { print <- "f ", p.v, "\n"; } }
fn main() {
  var t = T(1);
  var a = Arena();
  let h = a.alloc(H(&mut t));
  print <- h.p.v, "\n";
}
