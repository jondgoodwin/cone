// A borrow held in an array keeps its source frozen while the array is
// used.
//
// Verdict: refuse, ErrorFrozen at the replacement.
// Basis: borrow-freezing rule (26 Sep 2026) -- any value holding a borrow
// keeps the source frozen exactly as the borrow does.
// Master 42f45409: accepted, and it reads freed memory -- main, run, prints
// "final" (the replaced owner) and then a garbage value through the array.
// Stage 3 fixed it.

mod lifetime_free_array_holder_frozen;

import stdio use *;

struct R {
  pub n: i64;
  fn final(self: &uni) {
    printStr("final\n");
  }
}

fn main() {
  let t = new R(1);
  var s = new Uni[R](42);
  let a = [&t, &*s];
  s = new Uni[R](7);          //~ ErrorFrozen
  printStr("read = ");
  printInt(a[1].n);
  printStr("\n");
}
