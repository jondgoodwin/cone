// Pins beside lifetime_bug107_free_by_name_refused: the reborrow and the
// method form are refused as the by-name call is, and a struct naming the
// lifetime its stored borrows share may store what a method returns of it.
//
// Verdict: the two stores into own storage are refused (ErrorSelfStore); the
// 'Sched['a]' store is accepted, its result borrowing 'a and not '*self'.

mod lifetime_bug107_reborrow_method_ok;

struct Tcb { pub id: i32; }
struct Sched { pub cur: Option[&mut Tcb]; pub own: Tcb;
  fn pick(self: &mut, ct: i32) Option[&mut Tcb] { Some[&mut Tcb](&mut self.own) }
  fn step(self: &mut) { self.cur = self.pick(1i32); }   //~ ErrorSelfStore "borrow of '*self'"
}

fn pickFree(s: &mut Sched) Option[&mut Tcb] { Some[&mut Tcb](&mut s.own) }
fn stepReborrow(s: &mut Sched) { s.cur = pickFree(&mut *s); }   //~ ErrorSelfStore "borrow of '*s'"

struct Life['a] { pub cur: Option[&'a mut Tcb]; pub head: Option[&'a mut Tcb];
  fn pick(self: &mut, ct: i32) Option[&'a mut Tcb] { self.head }
  fn step(self: &mut) { self.cur = self.pick(1i32); }
}

fn main() { }
