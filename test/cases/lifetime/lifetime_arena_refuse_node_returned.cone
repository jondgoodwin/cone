// Bug 51 (spike): a node holding a local's borrow returned from the function. Refuse.
mod lifetime_arena_refuse_node_returned;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn stash(ar: &mut Arena) &mut H {
  var t = T(7);
  ar.alloc(H(Some(&mut t)))  //~ ErrorEscape
}
fn main() {
  var a = Arena();
  let h = stash(&mut a);
  print <- h.p.unwrap().v, "\n";
}
