// A borrow of a local stored into a field of a struct passed by value, which
// is then returned: the returned borrow points at the dead local.
//
// Verdict: refuse, ErrorEscape at the return.
// Basis: language rule (1 Oct 2026) -- a borrow of a local is never returned.
// A by-value parameter is the function's own storage, so the store is legal
// (language rule, 2 Oct 2026: a variable's lifetime follows what it holds
// now), and the return of what it then holds is refused.
// Master 277f509d: refused, at the store (ErrorInvType). Stage 4 moved the
// refusal to the return.

mod lifetime_band_store_local_into_byvalue_param_field;

struct H { pub r &i64; }

fn swapIn(mut h H) &i64 {
  imm y = 42i64;
  h.r = &y;
  h.r;                       //~ ErrorEscape
}
