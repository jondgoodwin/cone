// A borrow of a local stored into a field of a struct passed by value, which
// is then returned: the returned borrow points at the dead local.
//
// Verdict: refuse, ErrorInvType at the store.
// Basis: language rule (1 Oct 2026) -- a borrow of a local is never returned.
// Until a value's lifetime is read from what it holds, a by-value
// parameter's field is held to the caller band its type gives it, so the
// store is where this is refused; the stage that reads a value's lifetime
// from its loans may move the refusal to the return.
// Master 277f509d: correct.

mod lifetime_band_store_local_into_byvalue_param_field;

struct H { pub r &i64; }

fn swapIn(mut h H) &i64 {
  imm y = 42i64;
  h.r = &y;                  //~ ErrorInvType
  h.r;
}
