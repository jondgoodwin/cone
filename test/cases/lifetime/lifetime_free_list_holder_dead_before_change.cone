// The neighbour of lifetime_free_list_holder_frozen: the list of borrows is
// used and then dead, so the owner it borrowed through may be replaced.
//
// Verdict: accept; prints 42, then "final" (the replaced owner), then 7, then
// "final".
// Basis: borrow-freezing rule (26 Sep 2026) -- a value holding a borrow
// freezes its source only until its last use.
// Master d331baab: correct (a borrow inside a list freezes nothing yet;
// Stage 3 must keep this passing).

mod lifetime_free_list_holder_dead_before_change;

import stdio use *;
import collections use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  mut s = new So[R](42);
  mut l = List[&R].empty();
  l.push(&*s);
  show("through-list", (*l[0usize]).n);
  s = new So[R](7);
  show("source-after-list", s.n);
}
