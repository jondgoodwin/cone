// A lifetime comparison and a type clause joined by 'and' on a generic
// function: the type clause is a requirement each instance meets, the
// lifetime clause an order its body relies on. 'pick' returns its ''a'
// argument as ''b'. On a generic type's method the same, the type clause a
// condition for the method existing: 'Box.put' stores its ''a' argument where
// ''b' borrows are held.
//
// Verdict: accept; prints 2, 1 and 1.
// Basis: lifetime clauses combine with type clauses by 'and'; ''a >= 'b' lets
// a ''a' borrow be returned where a ''b' one is promised.
// Master b07a3adc: refused at parse (ErrorWhereForm: a 'where' clause is a
// type parameter's name, 'is', and a trait).

mod lifetime_band_where_generic_mixed;

import stdio use *;

struct R { pub n i64; }

fn pick[T](x &'a T, y &'b T) &'b T where 'a >= 'b and T is Copy {
  x;
}

// On a generic type's method, beside a condition on the type's parameter
struct Box[T] {
  pub v T;
  pub fn put(self &, d &mut &'b R, s &'a R) where 'a >= 'b and T is Copy {
    *d = s;
  }
}

fn main() {
  imm r1 = new R(1);
  imm r2 = new R(2);
  imm i1 = 1i64;
  imm i2 = 2i64;
  printInt(pick[R](&r2, &r1).n);
  printStr(" ");
  printInt(*pick[i64](&i1, &i2));
  printStr(" ");
  imm b = new Box[i64](3);
  mut d = &r2;
  b.put(&mut d, &r1);
  printInt(d.n);
  printStr("\n");
}
