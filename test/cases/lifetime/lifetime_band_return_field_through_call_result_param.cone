// A field borrowed through the reference a call returned, where the call was
// handed a borrowed parameter: the field is the caller's, so the borrow may
// be returned.
//
// Verdict: accept; prints 5.
// Basis: language rule (1 Oct 2026) -- the caller band; a borrow through
// another reference has the lifetime of what that reference points at.
// Rust: 'fn n_of(p: &P) -> &i64 { &id(p).n }' accepted (by reading, not run).
// Master 8963c337: refused, ErrorInvType at the returned borrow -- the
// borrow was left untyped.

mod lifetime_band_return_field_through_call_result_param;

import stdio use *;

struct P { pub n i64; pub m i64; }

fn id(p &P) &P { p; }

fn nOf(p &P) &i64 {
  &id(p).n;
}

fn main() {
  imm x = new P(5, 6);
  printInt(*nOf(&x));
  printStr("\n");
}
