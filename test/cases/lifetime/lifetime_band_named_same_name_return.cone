// A result named 'a is the 'a parameter: the caller may keep it as long as
// what it passed for 'a, whatever it passed for 'b.
//
// Verdict: accept; prints 5.
// Basis: reflifefn.html ("the first return value has the same lifetime as
// a"); Jon, 1 Oct 2026 (WI\lifetimes.md): 'a and 'b are distinct lifetimes.
// Master d331baab: refused at parse ('a read as a loop label). xfail until
// Stage 6.

mod lifetime_band_named_same_name_return;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn first(a &'a i64, b &'b i64) &'a i64 {
  a;
}

fn main() {
  imm outer = 5i64;
  mut r = &outer;
  {
    imm inner = 6i64;
    r = first(&outer, &inner);
  }
  show("named-same-name", *r);
}
