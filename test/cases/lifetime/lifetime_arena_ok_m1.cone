// Bug 51 (spike): the arena store rule narrowed (probe m1): a node holding a borrow, whose death reads none. Compiles and runs.
mod lifetime_arena_ok_m1;
import stdio use *;
import arena use *;
struct Node['a] { pub val: i64; pub l: Option[&'a mut Node['a]]; }
fn mk(ar: &'a mut Arena, l: &'a mut Node['a]) &'a mut Node['a] {
  ar.alloc(Node(5, Some(l)))
}
fn leaf(ar: &'a mut Arena) &'a mut Node['a] {
  ar.alloc(Node(1, None))
}
fn main() {
  var a = Arena();
  let x = leaf(&mut a);
  let m = mk(&mut a, x);
  print <- m.val + m.l.unwrap().val, "\n";
}
