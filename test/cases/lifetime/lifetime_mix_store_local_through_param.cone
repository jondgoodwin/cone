// A borrow of a local stored through a '&mut &T' parameter into the caller's
// place: the caller's place outlives the local.
//
// Verdict: refuse, ErrorInvType at the store.
// Basis: refborref.html, "Lifetime Constraints" (stored only in a place whose
// lifetime is the same or smaller); the band ordering (1 Oct 2026: a
// caller's place is in the caller band, a top-block local below it).
// Master d331baab: correct.

mod lifetime_mix_store_local_through_param;

fn point(dst &mut &i64) {
  imm x = 42i64;
  *dst = &x;                 //~ ErrorInvType
}
