// Two names only a function's result writes stay apart from each other: a list of roads kept under `'=t`,
// the first arena's brand, is not the field's `List[&'=r mut Road['=t]]`, kept under `'=r`, the second's.
//
// Verdict: refuse, ErrorLitFieldType (1588) at the literal's list.
// Basis: `'=t` and `'=r` are different names; unresolved, neither counts as a brand of its own, but a value of
// one does not reach the other's place.

mod lifetime_inv_two_result_names_refused;

import stdio use *;
import arena use *;
import collections use *;

struct Town {
  pub people: i64;
}

struct Road['=t] {
  pub from: &'=t Town;
  pub km: i64;
}

struct Atlas['=t, '=r] {
  pub towns: DynArena['=t];
  pub roads: DynArena['=r];
  pub all: List[&'=r mut Road['=t]];

  pub fn bad() Atlas['=t, '=r] {
    Atlas(DynArena.empty(), DynArena.empty(), List[&'=t mut Road['=t]]())   //~ ErrorLitFieldType
  }
}

fn main() {}
