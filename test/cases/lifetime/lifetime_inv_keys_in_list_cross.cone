// A List of one arena's keys takes no other arena's key: 'push' binds the
// list's brand and the key's to the one its signature names, and they
// differ.
//
// Verdict: refuse, ErrorBrand at the pushed key.
// Basis: one brand never stands for another; a generic instance's brands are
// bound at each call through it (invariant lifetimes, settled 3 Oct 2026).
// Master 1117c92a: no DynArena, and ''=a' refused at lex. This compiler with
// the brand check turned off accepts it, and main, run, prints "final" as b
// dies and then a value read from b's freed block through a's '[]'.

mod lifetime_inv_keys_in_list_cross;

import stdio use *;
import arena use *;
import collections use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

fn fill(a &mut DynArena['=a], keys &mut List[&'=a mut R]) {
  keys.push(a.alloc(new R(1)));
  mut b = DynArena.empty();
  keys.push(b.alloc(new R(42)));    //~ ErrorBrand
}

fn listOf(a &mut DynArena['=a]) List[&'=a mut R] {
  mut keys = List[&'=a mut R].empty();
  fill(a, &mut keys);
  keys;
}

fn main() {
  mut a = DynArena.empty();
  imm keys = listOf(&mut a);
  clobber(21);
  printStr("read = ");
  printInt(a[*keys[1usize]].n);
  printStr("\n");
}
