mod lifetime_mix_local_in_option_returned;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn find() Option[&R] {
  imm x = new So[R](42);
  Some[&R][&*x];             //~ ErrorEscape
}

fn main() {
  match find() {
    case imm o Some {
      printStr("read = ");
      printInt(o.value.n);
      printStr("\n");
    }
    else {}
  }
}
