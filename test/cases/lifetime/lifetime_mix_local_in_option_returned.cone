// An 'Option' holding a local's borrow, returned.
//
// Verdict: refuse, ErrorEscape at the returned 'Some'.
// Basis: language rule (1 Oct 2026) -- lifetimes are infectious (the 2019
// post "Infectious Typing"): a value holding a borrow takes on its lifetime;
// borrow-freezing rule (26 Sep 2026): a borrow inside a value may not escape
// what it borrows.
// Master d331baab: accepted, and it reads freed memory -- main, run, prints
// "final" and then "read = 2885103559136". xfail until Stage 4.

mod lifetime_mix_local_in_option_returned;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn find() Option[&R] {
  imm x = new So[R](42);
  Some[&R][&*x];             //~ ErrorEscape
}

fn main() {
  match find() {
    case imm o Some {
      printStr("read = ");
      printInt(o.value.n);
      printStr("\n");
    }
    else {}
  }
}
