// An 'if' choosing between a borrow of 'a and one of 'b has no lifetime the
// callee can name: it may be used inside the function but returned as
// neither.
//
// Verdict: refuse, ErrorEscape at the returned 'if'.
// Basis: language rule (1 Oct 2026) -- distinct named caller lifetimes each
// compare with the global lifetime and with the function's own, but not with
// each other unless a where clause orders them.
// Master d331baab: refused at parse ('a read as a loop label). Stage 6 fixed
// it.

mod lifetime_band_named_if_two_names;

fn pick(c bool, a &'a i64, b &'b i64) &'a i64 {
  if c { a; } else { b; }    //~ ErrorEscape
}
