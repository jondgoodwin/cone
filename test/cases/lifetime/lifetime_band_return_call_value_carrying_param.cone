// The counterpart of lifetime_band_return_call_value_carrying_local: the
// struct passed by value carries a parameter's borrow, so the call's result
// is in the caller band and may be returned.
//
// Verdict: accept; prints 6.
// Basis: reflifefn.html (the result has the shortest borrowed argument's
// lifetime) with the language rule (1 Oct 2026) that lifetimes are
// infectious: the by-value argument carries the caller's borrow, nothing
// shorter.
// Master d331baab: correct.

mod lifetime_band_return_call_value_carrying_param;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct R { pub n i64; }
struct H { pub r &R; }

fn get(h H) &R { h.r; }

fn f(p &R) &R {
  get(new H(p));
}

fn main() {
  imm x = new R(6);
  show("value-carrying-param", f(&x).n);
}
