// Bug 77, the caller half: a holder that holds a borrow of a type parameter may hold a borrow of anything (T could be a 'List[i64]'), so the type test answers "can hold" and the call is checked as before. 'outer' lends its local list to 'inner' along with 'h', a 'Holder['a, T]' that reaches the caller; 'inner' may store a borrow of the list there.
mod lifetime_call_refuse_generic_holder;
import stdio use *;
import collections use List;
struct Holder['a, T] { pub r: &'a T; }
fn inner[T](h: &mut Holder[T], l: &mut List[i64]) { l.push(1i64); }
fn outer[T](h: &mut Holder[T]) {
  var l = List[i64]();
  inner(h, &mut l);  //~ ErrorCallEscape
}
fn main() {
  var base = 3i64;
  var h = Holder[i64](&base);
  outer[i64](&mut h);
  print <- h.r, "\n";
}
