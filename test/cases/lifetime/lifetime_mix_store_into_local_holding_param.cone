// A local's borrow stored through a reference to a local, 'q', that holds the
// caller's borrow: the reference points at 'q', the function's own, and only
// what 'q' holds came from the caller. So the store is legal, and 'q' is read
// before 's' ends. 'q' a copy of a '&R' parameter, of what a '&mut &R'
// parameter points at, and stored into by a call two levels down.
//
// Verdict: accept; prints 3, 4 and 5.
// Basis: language rule (2 Oct 2026), the flow rule -- a variable's lifetime
// follows what it holds now; a store through a reference lands where the
// reference points, not in what that place held before.
// Rust: accepted (by reading, not run).
// Master b306a838: refused the first two with ErrorEscape ("Stored where it
// may outlive this function"): the caller's borrow 'q' held was counted as a
// place 'p' may point at.

mod lifetime_mix_store_into_local_holding_param;

import stdio use *;

struct R { pub n i64; }

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn put(x &mut &mut &R, v &R) { **x = v; }

fn copyOfParam(r &R) {
  imm s = new R(3);
  mut q = r;
  {
    mut p = &mut q;
    *p = &s;
  }
  show("copy", q.n);
}

fn readThroughParam(r &mut &R) {
  imm s = new R(4);
  mut q = *r;
  {
    mut p = &mut q;
    *p = &s;
  }
  show("read-through", q.n);
}

fn storedByCall(r &R) {
  imm s = new R(5);
  mut q = r;
  {
    mut p = &mut q;
    put(&mut p, &s);
  }
  show("by-call", q.n);
}

fn main() {
  imm one = new R(1);
  mut two = &one;
  copyOfParam(&one);
  readThroughParam(&mut two);
  storedByCall(&one);
}
