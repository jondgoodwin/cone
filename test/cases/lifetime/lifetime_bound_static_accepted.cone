// A type parameter bounded by ''static': inside, a T is stored in a global,
// bare and inside an 'Option', and returned as ''static'. Each call hands
// it only global borrows -- a global's, written, or carried by value inside
// an 'Option' -- or a type holding no borrow.
//
// Verdict: accept; prints 4 5 6 7 and 8.
// Basis: language rule (3 Oct 2026): 'T + 'static' says T holds no
// non-static borrow, the form a thread or an actor would ask of what it is
// handed; a borrow of a global lasts every lifetime (mod-namespaces.html names
// the global lifetime ''static'); a type holding no borrow meets any bound.
// Master 2cb190a1: refused at parse.

mod lifetime_bound_static_accepted;

import stdio use *;

let D: i64 = 4;
let E: i64 = 5;
let F: i64 = 6;
let G: &i64;
let GO: Option[&i64];

fn keep[T + 'static](x: T) &'static i64 {
  x
}

fn same[T + 'static](x: T) T {
  x
}

// The stores are the module's 'init': a 'let' global is set there alone, so what a bounded T carries
// into a global is stored from 'init', handed through 'same'
fn @initpure init() {
  G = same(&D);
  GO = same(Some[&i64](&E));
}

fn main() {
  initAll();
  printInt(*G);
  printStr(" ");
  match GO {
    case let Some(e) {
      printInt(*e);
      printStr(" ");
    }
    else {}
  }
  printInt(*keep(&F));
  printStr(" ");
  printInt(same(7i64));
  printStr(" ");
  let r = keep[&i64](&D);
  printInt(*r + 4);
  printStr("\n");
}
