// Bug 68: a function stores a borrow of its own local in an arena reached through a parameter (k3c). Refuse.
mod lifetime_arena_refuse_fn_local;
import stdio use *;
import arena use *;
struct N { pub p: &i32; fn final(self: &uni) { print <- "n reads ", *self.p, "\n"; } }
struct Hd { pub ar: &mut Arena; pub base: i32; }
fn scope(h: &mut Hd) { let n = 5; h.ar.alloc(N(&n)); }  //~ ErrorCallEscape
fn main() { var ar = Arena(); var h = Hd(&mut ar, 10); scope(&mut h); }
