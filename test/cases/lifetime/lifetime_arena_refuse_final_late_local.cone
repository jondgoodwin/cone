// Bug 51 (spike): a finalizable node filled in late with a local of the arena's own function. Refuse.
mod lifetime_arena_refuse_final_late_local;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct N { pub p: Option[&mut T]; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- r.v, "\n"; } case None { print <- "none\n"; } } } }
struct G { pub n: &mut N; fn final(self: &uni) { match self.n.p { case let Some(r) { print <- r.v, "\n"; } case None { print <- "none\n"; } } } }
fn main() {
  var a = Arena();
  let f = a.alloc(F(None));
  { var t = T(7); f.p = Some(&mut t); }  //~ ErrorFrozen
}
