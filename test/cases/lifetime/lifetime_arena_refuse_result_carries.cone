// Bug 48 item 4: a result of type '&mut Node' from 'id(p: &mut Node, ar)' carries p's loan, since a Node reaches a Node;
// storing it into the arena stores p's loan. Refuse.
mod lifetime_arena_refuse_result_carries;
import stdio use *;
import arena use *;
struct Node { pub val: i64; pub l: Option[&mut Node]; }
struct W { pub n: &mut Node; }
fn id(p: &mut Node, ar: &mut Arena) &mut Node { p }
fn go(ar: &mut Arena) i64 {
  var q = Node(1, None[&mut Node]);
  let w = ar.alloc(W(id(&mut q, ar)));  //~ ErrorCallEscape
  w.n.val
}
fn main() {
  var a = Arena();
  print <- go(&mut a), "\n";
}
