// The counterpart of lifetime_band_call_store_two_levels: the borrow a
// callee may store two levels down, into 'q', comes from an owner that
// outlives every use of 'q', so it is accepted.
//
// Verdict: accept, and the read through 'q' finds the stored value.
// Basis: borrow-freezing rule (26 Sep 2026) -- 'q' holds the stored borrow,
// and nothing ends or changes its source while 'q' is used.

mod lifetime_band_call_store_two_levels_outlives;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn put(x &mut &mut &R, v &R) { **x = v; }

fn main() {
  imm outer = new R(1);
  imm s = new So[R](42);
  mut q = &outer;
  {
    mut p = &mut q;
    put(&mut p, &*s);
  }
  printStr("read = ");
  printInt(q.n);
  printStr("\n");
}
