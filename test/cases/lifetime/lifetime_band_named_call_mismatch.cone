// A call made inside a function that names its lifetimes is checked against
// the callee's signature, and the borrows it returns or stores keep the
// lifetimes they came in with. An unannotated helper handed 'a and 'b returns
// a borrow of both, which may not be returned as 'a; and handed a '&mut' to
// a place holding 'b borrows beside an 'a borrow, it could store the 'a one
// there, so the call is refused. The same calls with one name are allowed.
//
// Verdict: refuse, ErrorEscape at the returned call, ErrorCallEscape at the
// storing call.
// Basis: language rule (1 Oct 2026): two names compare only where a where
// clause orders them; reflifefn.html: unannotated, every borrow in a
// signature shares one lifetime, so the helper may return or store either.

mod lifetime_band_named_call_mismatch;

fn pick(x &i64, y &i64) &i64 {
  x;
}

fn put(dst &mut &i64, src &i64) {
  *dst = src;
}

fn first(a &'a i64, b &'b i64) &'a i64 {
  pick(a, b);                //~ ErrorEscape
}

fn firstSame(a &'a i64, b &'a i64) &'a i64 {
  pick(a, b);
}

fn st(dst &mut &'b i64, src &'a i64) {
  put(dst, src);             //~ ErrorCallEscape
}

fn stSame(dst &mut &'b i64, src &'b i64) {
  put(dst, src);
}
