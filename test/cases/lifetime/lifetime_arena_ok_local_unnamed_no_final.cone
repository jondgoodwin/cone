// Bug 51 (narrowed): a local's borrow left in the caller's arena, the node not returned. The node has no 'final', so nothing in the arena reads the borrow once the local is gone.
mod lifetime_arena_ok_local_unnamed_no_final;
import stdio use *;
import arena use *;
// the node NOT returned: the local's reference left inside the caller's arena, found again by a global: MUST be refused
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn stash(a: &mut Arena) i64 {
  var t = T(77);
  let h = a.alloc(H(Some(&mut t)));
  h.p.unwrap().v
}
fn main() {
  var a = Arena();
  print <- stash(&mut a), "\n";
}
