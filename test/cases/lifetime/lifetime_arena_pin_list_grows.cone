// Pin: a reference into a List's block, the List in the arena, the List grown. Refuse.
mod lifetime_arena_pin_list_grows;
import stdio use *;
import arena use *;
import collections use *;
// a reference into a List's block, the List in the arena, stored in an arena node, then the List grows: MUST be refused
struct H { pub p: Option[&mut i64]; }
fn go(ar: &mut Arena) i64 {
  let l = ar.alloc(List[i64]());
  l.push(1);
  let e = &mut l[0usize];
  let h = ar.alloc(H(Some(e)));
  each i in 0usize..<100000usize { l.push(2); }  //~ ErrorShapeReshape
  *h.p.unwrap()
}
fn main() {
  var a = Arena();
  print <- go(&mut a), "\n";
}
