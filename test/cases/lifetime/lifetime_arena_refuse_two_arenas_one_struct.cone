// Bug 48/51: two arenas reached through one struct: a.alloc(W(b)) stores b's reference in a. Refuse.
mod lifetime_arena_refuse_two_arenas_one_struct;
import stdio use *;
import arena use *;
struct W { pub a: &mut Arena; }
struct Two { pub a: &mut Arena; pub b: &mut Arena; }
fn bad(t: &mut Two) {
  t.a.alloc(W(t.b));  //~ ErrorCallEscape
}
fn main() {
  var x = Arena();
  var y = Arena();
  var t = Two(&mut x, &mut y);
  bad(&mut t);
}
