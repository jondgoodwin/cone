// NLL's problem case #1: a mutable borrow held in a variable and used once;
// after that last use the source is free, in the middle of the block.
//
// Verdict: accept; prints 4.
// Basis: borrow-freezing rule (26 Sep 2026) -- a source is frozen until the
// borrow's last use, not the end of the block.
// Rust: RFC 2094, "Problem case #1: references assigned into a variable"
// ('let slice = &mut data[..]; capitalize(slice); data.push('d');') -- NLL
// accepts (from the RFC; not run). Rust's '&mut' of a local is Cone's '&mut'
// of a local: a local is a 'uni' source, frozen entirely by a mutable borrow.
// Master d331baab: correct.

mod lifetime_free_nll1_after_last_use;

import stdio use *;
import collections use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn capitalize(l &mut List[i64]) { l.push(2); }

fn main() {
  mut data = List[i64].empty();
  data.push(1);
  imm slice = &mut data;
  capitalize(slice);
  data.push(3);
  data.push(4);
  show("pushed-after-last-use", i64.from(data.len()));
}
