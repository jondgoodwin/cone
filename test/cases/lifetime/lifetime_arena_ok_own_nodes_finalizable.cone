// Bug 48 exception E1: nodes with a 'final' taken from the arena through a parameter and stored back into other nodes of it, unnamed and named 'a. Needs loanArenaApart's exception (disabled, it is refused 1064/1085).
mod lifetime_arena_ok_own_nodes_finalizable;
import stdio use *;
import arena use *;
struct F { pub v: i64; pub next: Option[&mut F]; fn final(self: &uni) { match self.next { case let Some(n) { print <- "fin ", n.v, "\n"; } case None { } } } }
fn two(ar: &mut Arena) {
  let a = ar.alloc(F(1, None));
  let b = ar.alloc(F(2, None));
  a.next = Some(b);
}
fn three(ar: &'a mut Arena) &'a mut F {
  let a = ar.alloc(F(1, None));
  let b = ar.alloc(F(2, Some(a)));
  a.next = Some(b);
  b
}
fn main() { var ar = Arena(); two(&mut ar); three(&mut ar); }
