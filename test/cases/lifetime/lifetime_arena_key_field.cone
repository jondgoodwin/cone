// Bug 51: the key rule (ErrorKeyBorrow) on the route into DynArena.alloc: a value reached by a field. Refuse.
mod lifetime_arena_key_field;
import arena use *;
struct Holder { pub r: &i64; }

struct Box { pub h: Holder; }
fn main() {
  var ar = DynArena.empty();
  let x = 7i64;
  let b = Box(Holder(&x));
  let k = ar.alloc(b.h); //~ ErrorKeyBorrow
}
