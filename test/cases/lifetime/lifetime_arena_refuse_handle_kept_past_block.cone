// Bug 51 (design chat probe f3): the handle of a node holding an inner-block local's borrow kept past the block. Refuse.
mod lifetime_arena_refuse_handle_kept_past_block;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
struct Holder { pub ar: &mut Arena; }
fn stash(h: &mut Holder, x: &mut T) &mut H { h.ar.alloc(H(x)) }
fn main() { var a = Arena(); var h = Holder(&mut a); var k = stash(&mut h, &mut T(1));
  { var t = T(77); k = stash(&mut h, &mut t); }  //~ ErrorFrozen
  print <- clobber(3), " ", k.p.v, "\n"; }
