// A value holding a borrow made an owning virtual reference, whose type
// names no lifetime: a struct holding a borrow the caller lent, boxed into a
// 'Uni[Show]', and into an 'Arc[Show]', and returned; one holding a local's
// borrow, boxed where a local is declared and where an argument is handed;
// an 'Rc[H]' converted to an 'Rc[Show]'; and a generic function's unbounded
// T boxed, instanced with a struct holding a borrow.
//
// Verdict: refuse, ErrorLifetimeBound at each conversion.
// Basis: Rust's behaviour: a trait object's lifetime bound, left out
// behind an owning pointer, defaults to ''static' ('Box<dyn Trait>' is
// 'Box<dyn Trait + 'static>'; the Reference, "Default trait object lifetime
// bounds"), so a value holding a borrow that is not global may not become
// one. 'Uni[Trait]', 'Rc[Trait]' and 'Arc[Trait]' read the same way
// (mod-substitution.html#virtref; mem-lifetimes.html#bounds, "Lifetime bounds on generics and virtual references").
// Master ff2c3626: accepted, and main, run, prints "final" as the boxed
// value's R dies at the end of the inner block, and then a value read
// through 'keep' from that R's freed block: the conversion dropped every
// loan the value held.

mod lifetime_bound_owning_virt_refused;

import stdio use *;
import sync use Arc;

trait Show {
  pub fn show(self: &) i64;
}

struct R {
  pub n: i64;
  fn final(self: &uni) {
    printStr("final\n");
  }
}

struct H is Show {
  pub r: &R;
  fn show(self: &) i64 {
    self.r.n
  }
}

fn boxit(h: H) Uni[Show] {
  Uni[H](h)              //~ ErrorLifetimeBound "the caller lent through 'h'"
}

fn arcit(h: H) Arc[Show] {
  Arc[H](h)             //~ ErrorLifetimeBound "the caller lent through 'h'"
}

fn take(b: Uni[Show]) i64 {
  b.show()
}

fn boxAny[T: Show](x: T) Uni[Show] {
  Uni[T](x)              //~ ErrorLifetimeBound "the caller lent through 'x'"
}

fn clobber(n: i64) i64 {
  var a: Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9]
}

fn generic() {
  let x = R(4);
  printInt(boxAny(H(&x)).show());
}

fn main() {
  let g = R(1);
  var keep: Uni[Show] = boxit(H(&g));
  {
    let r = Uni[R](42);
    keep = boxit(H(&*r));
  }
  clobber(21);
  printInt(keep.show());
  let x = R(2);
  let b: Uni[Show] = Uni[H](H(&x));   //~ ErrorLifetimeBound "a borrow of 'x'"
  printInt(take(Uni[H](H(&x))));    //~ ErrorLifetimeBound "a borrow of 'x'"
  let a = Rc[H](H(&x));
  let c: Rc[Show] = a;        //~ ErrorLifetimeBound "a borrow of 'x'"
  printStr("\n");
}
