// A mutable local holding a parameter's borrow, given a local's borrow, then
// reborrowed through and returned: the reborrow points at the dead local.
//
// Verdict: refuse, ErrorEscape at the returned reborrow.
// Basis: language rule (2 Oct 2026) -- a variable's lifetime follows what it
// holds now, so 'q' holds the local's borrow and a borrow through it may not
// be returned. Until a variable's lifetime follows what it holds, a borrow
// through a mutable local takes that local's block rather than the lifetime
// its type records, which the assignment has made stale.
// Master 277f509d: correct.

mod lifetime_band_return_reborrow_through_mut_local;

fn f(p &i64) &i64 {
  mut q = p;
  imm x = 42i64;
  q = &x;
  &*q;                       //~ ErrorEscape
}
