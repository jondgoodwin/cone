// #1202: the same with two names and no relation between them: the store could land where 'g' points, which holds no borrow of 'b, so it is refused in the body.
mod lifetime_stored_place_closure_apart;
import stdio use *;
struct H['a] { pub p: &'a i32; }
fn put[F: fn(x: &i32)](g: &'a mut F, v: &'b i32) { g(v); }  //~ ErrorCallEscape
fn main() {
  let a = 1;
  var s = H(&a);
  var g = fn(x: &i32) { s.p = x; };
  { let x = 5; put(&mut g, &x); }
  print <- *s.p, "\n";
}
