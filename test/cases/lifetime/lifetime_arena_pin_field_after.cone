// Pin: a local's reference written into a caller's arena node after allocation. Refuse.
mod lifetime_arena_pin_field_after;
import stdio use *;
import arena use *;
// a local's reference written into a caller's arena node after allocation, read by its finalizer: MUST be refused
struct T { pub v: i64; }
struct H {
  pub p: Option[&mut T];
  fn final(self: &uni) { print <- "final\n"; }
}
fn stash(a: &mut Arena) i64 {
  var t = T(77);
  let h = a.alloc(H(None[&mut T]));
  h.p = Some(&mut t);  //~ ErrorEscape
  h.p.unwrap().v
}
fn main() {
  var a = Arena();
  print <- stash(&mut a), "\n";
}
