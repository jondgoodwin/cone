// An invariant lifetime has no order, so a key is a plain reference: a slice
// does not take one, however it is spelled. The slice is the borrow of core's
// 'Array[T]', '&Array[T]', so it is a reference to a generic instance until name
// resolution settles that it is the slice, and the invariant lifetime is
// refused there (the parser refuses it on the retired '&[]', as in
// lifetime_inv_parse_refused, and on a virtual reference).
//
// Verdict: refuse, ErrorLifetimeInvariant.

mod lifetime_inv_nameres_slice;

struct R { pub n i64; }

fn slice(k &'=a Array[R]) { }   //~ ErrorLifetimeInvariant:12 "a slice or a virtual reference does not take one"

fn main() {
}
