// A borrow found in a loop leaves it through a 'break' and is used after the
// loop; on the paths that go round again, nothing holds it, so the push is
// free.
//
// Verdict: accept; prints 4.
// Basis: borrow-freezing rule (26 Sep 2026) -- a source is frozen only on the
// paths where the borrow is still to be used; a 'break' carries its state to
// the loop's exit.
// Master d331baab: correct.

mod lifetime_free_loop_break_carries_borrow;

import stdio use *;
import collections use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  mut l = List[i64].empty();
  l.push(0);
  imm zero = 0i64;
  mut found = &zero;
  mut i = 1;
  while i < 10 {
    imm e = l[l.len() - 1usize];
    if *e > 3 {
      found = e;
      break;
    }
    l.push(*e + 1);
    i = i + 1;
  }
  show("found-after-break", *found);
}
