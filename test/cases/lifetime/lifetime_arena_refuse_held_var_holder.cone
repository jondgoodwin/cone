// Bug 61: the same with the holder itself a 'var' parameter (it holds the arena and is given a helper's node). Refuse.
mod lifetime_arena_refuse_held_var_holder;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub ar: &mut Arena; pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- "finalizer reads ", r.v, "\n"; } case None { print <- "none\n"; } } } }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
fn mkF(a: &mut F) &mut F { a.ar.alloc(F(a.ar, None)) }
fn stash(var a: &mut F, x: &mut T) { a = mkF(a); a.p = Some(x); }  //~ ErrorEscape
fn scope(q: &mut Arena) { var t = T(7); var h = F(q, None); stash(&mut h, &mut t); }
fn main() { var a = Arena(); scope(&mut a); print <- clobber(3), "\n"; }
