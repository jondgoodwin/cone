// Bug 57 (r670_w): six virtual references rotated in a loop, one holding a borrow of a local, then passed where the bound is ''static'. The loop settles, so the bound check refuses (it accepted while the holders were widened)
mod lifetime_loop_rotation_bound;
import stdio use *;
trait Show { pub fn show(self: &) i64; }
struct R { pub n: i64; }
struct H['b] { pub r: &'b R; fn show(self: &) i64 { r.n } }
fn look(v: &<Show + 'static) i64 { v.show() }
fn main() {
  let x = R(5);
  let hx = H(&x);
  var a: &<Show = &hx; var b: &<Show = &hx; var c: &<Show = &hx; var d: &<Show = &hx; var e: &<Show = &hx; var f: &<Show = &hx;
  var i = 0;
  while i < 10 { a = b; b = c; c = d; d = e; e = f; f = &hx; i += 1; }
  printInt(look(a));  //~ ErrorLifetimeBound
  printStr("\n");
}
