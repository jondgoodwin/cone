// Bug 51: the key rule (ErrorKeyBorrow) on the route into DynArena.alloc: a generic struct a caller instantiates with a reference. Refuse.
mod lifetime_arena_key_instantiate;
import arena use *;
struct Holder { pub r: &i64; }

struct Cell[T] { pub v: T; }
fn main() {
  var ar = DynArena.empty();
  let x = 7i64;
  let k = ar.alloc(Cell[&i64](&x)); //~ ErrorKeyBorrow
}
