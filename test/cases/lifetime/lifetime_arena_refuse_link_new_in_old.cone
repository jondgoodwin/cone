// Bug 51 (spike): an older node made to point at a shorter-lived one. Refuse.
mod lifetime_arena_refuse_link_new_in_old;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
struct G { pub h: Option[&mut H]; }
fn main() {
  var a = Arena();
  let old = a.alloc(G(None));
  {
    var t = T(7);  //~ ErrorFrozen
    let n = a.alloc(H(Some(&mut t)));
    old.h = Some(n);
  }
  print <- old.h.unwrap().p.unwrap().v, "\n";
}
