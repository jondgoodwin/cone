// A borrow through a 'Rc' owner held in a local, returned: the local releases
// its count at the return, so the borrow is bounded by the local's block.
//
// Verdict: refuse, ErrorEscape at the returned borrow.
// Basis: reading of the rules: an owning reference carries no lifetime
// limit, but a borrow taken through one is bounded by whoever holds the owner
// -- here a local. Rust refuses the same shape with 'Rc' (E0515; by reading,
// not run).
// Master d331baab: correct.

mod lifetime_band_return_rc_local_borrow;

struct R { pub n i64; }

fn make() &R {
  imm r = new Rc[mut, R](1);
  &*r;                       //~ ErrorEscape
}
