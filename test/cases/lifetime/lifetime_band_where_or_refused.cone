// A lifetime comparison joins a where clause by '&&' only: one under '||',
// directly or inside a group a '||' joins, or under '!', is refused, and
// so is a comparison of another form than '>=' or '=='. A type clause keeps
// its '||' (generic_typecheck_where_or).
//
// Verdict: refuse, ErrorLifetimeOr at each '||' and '!' over a lifetime
// comparison, ErrorWhereForm at the '>'.
// Basis: a lifetime is never instanced, so no instance settles which
// alternative of a '||' holds, and the body could rely on none of them.
// Master b07a3adc: refused at parse (ErrorWhereForm: a 'where' clause is a
// type parameter's name, 'is', and a trait).

mod lifetime_band_where_or_refused;

struct R { pub n: i64; }

fn orLife[T](x: &'a T, y: &'b T) &'b T where 'a >= 'b || T is Copy {    //~ ErrorLifetimeOr "by '&&' only"
  y
}

fn notLife(x: &'a R, y: &'b R) &'b R where !'a >= 'b {            //~ ErrorLifetimeOr "never under '!'"
  y
}

fn groupedOr[T](x: &'a T, y: &'b T) &'b T where T is Copy || ('a >= 'b && T is Copy) {   //~ ErrorLifetimeOr "by '&&' only"
  y
}

fn badForm(x: &'a R, y: &'b R) where 'a > 'b {                       //~ ErrorWhereForm "compares two lifetimes"
}
