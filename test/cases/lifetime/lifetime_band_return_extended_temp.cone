// A temporary a variable's initializer extends is a local of the function's
// block, ended at the function's end: a borrow of it may be used there, but
// not handed back.
//
// Verdict: refuse, ErrorEscape at the returned variable.
// Basis: language rule (2 Oct 2026) -- temporaries follow Rust, extended to
// the end of the enclosing block; a returned value may carry no borrow of the
// function's own storage. Rust: 'fn f() -> &'static R { let r = &make(); r }'
// is E0515, "cannot return value referencing temporary value"; by reading,
// not run.
// Master 39affbc9: refused, but at the borrow of the temporary itself
// (ErrorBadLval), which every such borrow was.

mod lifetime_band_return_extended_temp;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn mk(n i64) R { new R(n); }

fn handBack() &R {
  imm r = &mk(9);
  r;                         //~ ErrorEscape
}

fn main() {
  printInt(handBack().n);
}
