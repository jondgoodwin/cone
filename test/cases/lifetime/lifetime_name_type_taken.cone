// A type named alone still takes its lifetimes, in a signature and with its
// construction.

mod lifetime_name_type_taken;

struct Cursor['a] {
  pub n: &'a i64;
}

fn read(c: &Cursor['a]) i64 {
  *c.n
}

fn main() i32 {
  let v = 3i64;
  let c = Cursor(&v);
  if read(&c) != 3i64 {
    return 1i32;
  }
  0i32
}
