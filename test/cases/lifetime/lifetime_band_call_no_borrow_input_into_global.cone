// A call handed no borrow, returning one: what it returns can only have come
// from the program's own data (a global, a literal), so it has the global
// lifetime and may be stored into a global.
//
// Verdict: accept; prints 5.
// Basis: reading of reflifefn.html (a returned borrow shares the lifetime
// of the borrows passed in; with none passed in there is nothing shorter
// than global) with the language rule (1 Oct 2026) that a borrow of global
// lifetime may travel anywhere: a borrow result with no borrowed input has
// the global lifetime ('static). Rust's elision refuses such a signature
// without 'static (E0106); Cone's rule differs on purpose.
// Master d331baab: correct.

mod lifetime_band_call_no_borrow_input_into_global;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

mut E i64 = 5;
mut D i64 = 0;
mut G &i64;

fn @initpure init() {
  G = &D;
}

fn mk() &i64 { &E; }

fn point() {
  G = mk();
}

fn main() {
  point();
  show("no-input-into-global", *G);
}
