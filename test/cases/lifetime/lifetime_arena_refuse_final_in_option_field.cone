// Bug 62's stand-aside trusts the outer type: a node with no final holds, by value inside an Option, a part whose
// final reads a local's borrow. The node's type must count its part's final. Refuse.
mod lifetime_arena_refuse_final_in_option_field;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: &mut T; fn final(self: &uni) { print <- self.p.v, "\n"; } }
struct Outer { pub n: i64; pub f: Option[F]; }
fn stash(ar: &mut Arena) {
  var t = T(7);
  ar.alloc(Outer(0, Some(F(&mut t))));  //~ ErrorCallEscape
}
fn main() {
  var a = Arena();
  stash(&mut a);
}
