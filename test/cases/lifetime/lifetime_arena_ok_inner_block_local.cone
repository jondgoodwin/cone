// Bug 51 (spike): a node holding a local declared in an inner block, used within that block. Compiles and runs.
mod lifetime_arena_ok_inner_block_local;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn main() {
  var a = Arena();
  {
    var t = T(7);
    let h = a.alloc(H(Some(&mut t)));
    print <- h.p.unwrap().v, "\n";
  }
  print <- "arena still alive\n";
}
