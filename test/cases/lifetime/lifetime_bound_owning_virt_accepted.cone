// Values made owning virtual references that hold no borrow but a global
// one: a struct holding no borrow, boxed into a 'Uni[Show]' and an
// 'Rc[Show]'; a struct holding a global's borrow, boxed where a local is
// declared, and through a parameter whose borrow is ''static'; a type
// parameter bounded by ''static' boxed, instanced with a struct holding a
// global's borrow; and an unbounded one instanced with a struct holding
// none. A borrowed virtual reference to a local's struct is untouched.
//
// Verdict: accept; prints 3 4 7 7 7 5 6.
// Basis: Rust's behaviour: 'Box<dyn Trait>' is 'Box<dyn Trait + 'static>'
// (the Reference, "Default trait object lifetime bounds"), which a value
// holding no borrow, or only ''static' ones, meets; a borrowed trait object
// '&'r dyn Trait' defaults to ''r' instead (mod-substitution.html#virtref;
// mem-lifetimes.html#bounds, "Lifetime bounds on generics and virtual references").
// Master ff2c3626: correct.

mod lifetime_bound_owning_virt_accepted;

import stdio use *;

trait Show {
  pub fn show(self &) i64;
}

struct R {
  pub n i64;
}

struct H is Show {
  pub r &R;
  fn show(self &) i64 {
    self.r.n
  }
}

struct Circle is Show {
  pub n i64;
  fn show(self &) i64 {
    self.n
  }
}

let D R;

fn @initpure init() {
  D = new R(7);
}

fn boxStatic(r &'static R) Uni[Show] {
  new Uni[H](new H(r))
}

fn boxStaticT[T Show + 'static](x T) Uni[Show] {
  new Uni[T](x)
}

fn boxAny[T Show](x T) Uni[Show] {
  new Uni[T](x)
}

fn look(v &<Show) i64 {
  v.show()
}

fn main() {
  initAll();
  let k Uni[Show] = new Uni[Circle](new Circle(3));
  printInt(k.show());
  printStr(" ");
  let c Rc[Show] = new Rc[Circle](new Circle(4));
  printInt(c.show());
  printStr(" ");
  let g Uni[Show] = new Uni[H](new H(&D));
  printInt(g.show());
  printStr(" ");
  printInt(boxStatic(&D).show());
  printStr(" ");
  printInt(boxStaticT(new H(&D)).show());
  printStr(" ");
  printInt(boxAny(new Circle(5)).show());
  printStr(" ");
  let x = new R(6);
  let h = new H(&x);
  printInt(look(&h));
  printStr("\n");
}
