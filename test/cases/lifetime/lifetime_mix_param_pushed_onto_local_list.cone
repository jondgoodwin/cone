// A parameter's borrow pushed onto a local list of borrows: the list ends
// before the caller's value does.
//
// Verdict: accept; prints 6.
// Basis: refborref.html, "Lifetime Constraints" (stored in a place whose
// lifetime is smaller); the band ordering (1 Oct 2026): the caller's band
// outlives the function's.
// Master d331baab: correct.

mod lifetime_mix_param_pushed_onto_local_list;

import stdio use *;
import collections use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct R { pub n i64; }

fn total(p &R) i64 {
  mut l = List[&R].empty();
  l.push(p);
  l.push(p);
  (*l[0usize]).n + (*l[1usize]).n;
}

fn main() {
  imm x = new R(3);
  show("param-onto-local-list", total(&x));
}
