// Bug 51 (narrowed): a parameter's borrow of another lifetime stored in a node with no 'final'. The arena never reads it, so the store is no store.
mod lifetime_arena_ok_named_apart_no_final;
import stdio use *;
import arena use *;
// as jn_h6, lifetimes named apart
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn keep(ar: &'a mut Arena, x: &'b mut T) i64 {
  let h = ar.alloc(H(Some(x)));
  h.p.unwrap().v
}
fn main() {
  var a = Arena();
  var t = T(1);
  print <- keep(&mut a, &mut t), "\n";
}
