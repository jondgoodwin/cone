// A borrow of a temporary, held in a variable: Rust extends the temporary to
// the end of the enclosing block ('let r = &temp();'), so the borrow is good
// for as long as the variable can be used.
//
// Verdict: accept; prints 7.
// Basis: language rule (2 Oct 2026) -- temporaries that outlive their
// statement follow Rust: extend the temporary to the block for
// 'let r = &temp()'-style, refuse the rest. Rust: the operand of a
// borrow in a 'let' initializer is an extending expression (The Rust
// Reference, "Destructors", temporary lifetime extension); accepted, by
// reading, not run.
// Master d331baab: refused, ErrorBadLval at '&mk()' ("May not borrow a
// temporary value") -- safe code refused. xfail until Stage 5.

mod lifetime_mix_temp_borrow_extended;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct R { pub n i64; }

fn mk() R { new R(7); }

fn main() {
  imm r = &mk();
  show("extended-temporary", r.n);
}
