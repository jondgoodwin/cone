// Bug 48 item 4 (narrowed): a closure-held loan carried by a call's result, stored in a node with no 'final'. No store; the local outlives every use.
mod lifetime_arena_ok_result_closure_no_final;
import stdio use *;
import arena use *;
struct Node { pub val: i64; pub l: Option[&mut Node]; }
struct W { pub n: &mut Node; }
struct P[F: fn() &mut Node] { pub f: F; }
fn pick[F: fn() &mut Node](p: &mut P[F], ar: &mut Arena) &mut Node { (p.f)() }
fn go(ar: &mut Arena) i64 {
  var q = Node(1, None[&mut Node]);
  var p = P(fn() &mut Node { &mut q });
  let w = ar.alloc(W(pick(&mut p, ar)));
  w.n.val
}
fn main() {
  var a = Arena();
  print <- go(&mut a), "\n";
}
