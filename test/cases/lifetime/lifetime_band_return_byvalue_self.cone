// A method taking 'self' by value owns a copy that ends at its return, so a
// borrow of one of its fields may not be returned.
//
// Verdict: refuse, ErrorEscape at the returned borrow.
// Basis: language rule (1 Oct 2026) -- a by-value parameter, 'self' by value
// included, is like a local: a borrow of it is never returned.
// Master d331baab: accepted, and it dangles -- main, run, prints
// 140708072690497, not 42. Stage 1 fixed it.

mod lifetime_band_return_byvalue_self;

import stdio use *;

fn clobber(n i64) i64 {
  mut a Array[i64, 16] = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n];
  a[3] + a[9];
}

struct Pt {
  pub x i64;
  pub y i64;

  pub fn xRef(self) &i64 {
    &self.x;                 //~ ErrorEscape
  }
}

fn main() {
  imm p = new Pt(42, 43);
  imm r = p.xRef();
  clobber(21);
  printInt(*r);
  printStr("\n");
}
