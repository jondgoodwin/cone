// A 'return' inside a loop is a return like any other: a borrow of a local
// may not leave by it, while a parameter's borrow may.
//
// Verdict: refuse, ErrorEscape at the local's return only.
// Basis: refborref.html, "Lifetime Constraints"; the band ordering (1 Oct
// 2026): global outlives the caller's band, which outlives the function's.
// Master d331baab: correct.

mod lifetime_band_return_local_from_loop;

fn f(p &i64) &i64 {
  imm x = 42i64;
  mut i = 0;
  while i < 3 {
    if i == 1 { return p; }
    if i == 2 { return &x; } //~ ErrorEscape
    i = i + 1;
  }
  p;
}
