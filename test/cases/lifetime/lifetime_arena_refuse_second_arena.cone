// Bug 48: a node of a second arena stored into the first: the second may die first. Refuse.
mod lifetime_arena_refuse_second_arena;
import stdio use *;
import arena use *;
struct Node { pub val: i64; pub l: Option[&mut Node]; }
fn cross(a: &'a mut Arena, b: &'a mut Arena) &'a mut Node {
  let x = b.alloc(Node(1, None[&mut Node]));
  a.alloc(Node(2, Some(x)))  //~ ErrorCallEscape
}
fn main() {
  var a = Arena();
  var b = Arena();
  let n = cross(&mut a, &mut b);
  print <- n.val, "\n";
}
