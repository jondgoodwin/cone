// A string literal lives for the whole program, so a function handed no
// borrow may return one, chosen by an 'if'.
//
// Verdict: accept; prints 2 and 3 (the lengths of "on" and "off").
// Basis: reading of the language rule (1 Oct 2026) that a borrow of global
// lifetime may travel anywhere -- a literal is global data
// (refmodule.html calls its lifetime 'static).
// Master d331baab: correct.

mod lifetime_band_return_string_literal;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn onOff(on bool) &Array[u8] {
  if on { "on"; } else { "off"; }
}

fn main() {
  show("literal-on", i64.from(onOff(true).len));
  show("literal-off", i64.from(onOff(false).len));
}
