// A refused loop inside another loop ends the function's flow check there: the two '&mut' of 'y' after it, which the check would refuse, are not reported with half-walked state
mod lifetime_loop_refused_stops;
import stdio use *;
fn main() {
  let x = 7;
  var a0 = &x; var a1 = &x; var a2 = &x; var a3 = &x; var a4 = &x; var a5 = &x; var a6 = &x; var a7 = &x; var a8 = &x; var a9 = &x; var a10 = &x; var a11 = &x; var a12 = &x; var a13 = &x; var a14 = &x; var a15 = &x; var a16 = &x; var a17 = &x; var a18 = &x; var a19 = &x; var a20 = &x; var a21 = &x; var a22 = &x; var a23 = &x;
  var i = 0;
  while i < 3 { var j = 0; while j < 3 { a0 = a1; a1 = a2; a2 = a3; a3 = a4; a4 = a5; a5 = a6; a6 = a7; a7 = a8; a8 = a9; a9 = a10; a10 = a11; a11 = a12; a12 = a13; a13 = a14; a14 = a15; a15 = a16; a16 = a17; a17 = a18; a18 = a19; a19 = a20; a20 = a21; a21 = a22; a22 = a23; a23 = &x; j += 1; }  //~ ErrorLoopTangled
    i += 1; }
  var y = 5; let r = &mut y; let q = &mut y; *r = 1; *q = 2;
  print <- *a0, "\n";
}
