// ''a == 'b' orders each lifetime at least as long as the other: a borrow of
// either may be stored where the other's are held, in both directions.
//
// Verdict: accept; prints 2 and 1.
// Basis: ''a == 'b' says each lasts at least as long as the other.
// Master b07a3adc: refused at parse (ErrorWhereForm: a 'where' clause is a
// type parameter's name, 'is', and a trait).

mod lifetime_band_where_equal_both_ways;

import stdio use *;

struct R { pub n i64; }

fn intoA(d &mut &'a R, s &'b R) where 'a == 'b {
  *d = s;
}

fn intoB(d &mut &'b R, s &'a R) where 'a == 'b {
  *d = s;
}

fn main() {
  imm r1 = new R(1);
  imm r2 = new R(2);
  mut d = &r1;
  intoA(&mut d, &r2);
  printInt(d.n);
  printStr(" ");
  intoB(&mut d, &r1);
  printInt(d.n);
  printStr("\n");
}
