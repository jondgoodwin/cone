// Bug 51 (spike): an older node made to point at a local that dies first. Refuse.
mod lifetime_arena_refuse_link_old;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn main() {
  var a = Arena();
  let old = a.alloc(H(None));
  {
    var t = T(7);  //~ ErrorFrozen
    old.p = Some(&mut t);
  }
  print <- old.p.unwrap().v, "\n";
}
