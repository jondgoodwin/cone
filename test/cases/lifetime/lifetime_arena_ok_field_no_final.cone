// Bug 51 (narrowed): the arena reached through a struct field; a parameter's borrow stored in a node whose death reads no borrow (no 'final'). No store: the handle carries the borrow, and the caller's local outlives every use of it.
mod lifetime_arena_ok_field_no_final;
import stdio use *;
import arena use *;
// the arena reached through a struct field, a parameter's reference stored into it: MUST be refused
struct T { pub v: i64; }
struct H { pub p: &mut T; }
struct Holder { pub ar: Arena; }
fn stash(h: &mut Holder, x: &mut T) i64 {
  let n = h.ar.alloc(H(x));
  n.p.v
}
fn make(h: &mut Holder) i64 {
  var t = T(77);
  stash(h, &mut t)
}
fn main() {
  var h = Holder(Arena());
  print <- make(&mut h), "\n";
}
