// A borrow of a variable made and not yet held, as the variable is given a
// local's borrow: what is read through it may not leave the function.
//
// Verdict: refuse, ErrorEscape at each return or store.
// Basis: the lifetime invariant (references-and-regions.md), and the flow rule
// (2 Oct 2026): a variable that may hold a local's borrow may not be returned,
// and neither may what is read of it through a reference.
// Master 8159838a5: both accepted, and 'returned' dangles -- run, the value
// read after another call is not the local's. Row 921.

mod lifetime_mix_borrow_in_flight_returned;

fn returned(a: &usize) &usize {
  var b = 2usize;
  var h = a;
  let t = (&mut h, {h = &b; 1usize});
  return *t.0;                //~ ErrorEscape
}

fn stored(out: &mut &'a usize, x: &'a usize) {
  var h = x;
  var b = 2usize;
  let t = (&mut h, {h = &b; 1usize});
  *out = *t.0;                //~ ErrorEscape
}

fn main() {}
