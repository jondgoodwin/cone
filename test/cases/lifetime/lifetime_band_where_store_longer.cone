// A where clause orders two caller lifetimes: with ''a >= 'b', a ''a' borrow
// may be stored where ''b' borrows are held, and returned where a ''b' one is
// promised. The caller, holding the callee to the same order, keeps the ''a'
// argument alive for as long as the ''b' place or result is used.
//
// Verdict: accept; prints 1 and 1.
// Basis: ''a >= 'b' says ''a' lasts at least as long as ''b': a borrow of the
// longer lifetime may go wherever one of the shorter may, and not the
// reverse.
// Master b07a3adc: refused at parse (ErrorWhereForm: a 'where' clause is a
// type parameter's name, 'is', and a trait).

mod lifetime_band_where_store_longer;

import stdio use *;

struct R { pub n i64; }

fn put(d &mut &'b R, s &'a R) where 'a >= 'b {
  *d = s;
}

fn longer(a &'a R, b &'b R) &'b R where 'a >= 'b {
  a;
}

fn main() {
  imm r1 = new R(1);
  imm r2 = new R(2);
  mut d = &r2;
  put(&mut d, &r1);
  printInt(d.n);
  printStr(" ");
  printInt(longer(&r1, &r2).n);
  printStr("\n");
}
