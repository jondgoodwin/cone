// A borrow made inside a loop and returned from it on one path; if the loop
// ends without returning, the list is pushed onto and a fresh borrow is
// returned. On the path that pushes, no borrow from the loop is still to be
// used.
//
// Verdict: accept; prints 4 and 7.
// Basis: the freezing design Jon ruled 26 Sep 2026 (freezing-design.md 2.10,
// per-path holds, and 3.3, loops walked to a fixed point).
// Rust: problem case #3 moved into a loop -- the shape NLL refuses and
// Polonius was built to accept (agent's construction from the RFC's
// get_default; Rust's verdicts by reading, not run).
// Master d331baab: correct.

mod lifetime_free_polonius_loop_return;

import stdio use *;
import collections use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn firstEvenOrPush(l &uni List[i64]) &i64 {
  mut i = 0usize;
  while i < l.len() {
    imm e = l[i];
    if *e % 2 == 0 { return e; }
    i = i + 1usize;
  }
  l.push(7);
  l[l.len() - 1usize];
}

fn main() {
  imm l = new So[List[i64]](List[i64].empty());
  l.push(3);
  l.push(4);
  show("found-in-loop", *firstEvenOrPush(l));
  imm m = new So[List[i64]](List[i64].empty());
  m.push(5);
  show("pushed-after-loop", *firstEvenOrPush(m));
}
