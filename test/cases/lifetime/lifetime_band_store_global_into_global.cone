// A borrow of a global stored into a global: both are the global lifetime.
//
// Verdict: accept; prints 5.
// Basis: language rule (1 Oct 2026) -- a borrow of global lifetime may travel
// anywhere.
// Master d331baab: correct.

mod lifetime_band_store_global_into_global;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

mut E i64 = 5;
mut D i64 = 0;
mut G &i64;

fn @initpure init() {
  G = &D;
}

fn point() {
  G = &E;
}

fn main() {
  point();
  show("global-into-global", *G);
}
