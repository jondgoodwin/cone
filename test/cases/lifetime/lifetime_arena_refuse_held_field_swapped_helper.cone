// Bug 61: a helper gives a parameter's field a node of the arena, then it is stored through. Refuse.
mod lifetime_arena_refuse_held_field_swapped_helper;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- "finalizer reads ", r.v, "\n"; } case None { print <- "none\n"; } } } }
struct Hn { pub ar: &mut Arena; pub f: &mut F; }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
fn mkF(a: &mut Hn) &mut F { a.ar.alloc(F(None)) }
fn swap(h: &mut Hn) { h.f = mkF(h); }
fn stash(h: &mut Hn, x: &mut T) { swap(h); h.f.p = Some(x); }
fn scope(q: &mut Arena) { var t = T(7); var g = F(None); var h = Hn(q, &mut g); stash(&mut h, &mut t); }  //~ ErrorCallEscape
fn main() { var a = Arena(); scope(&mut a); print <- clobber(3), "\n"; }
