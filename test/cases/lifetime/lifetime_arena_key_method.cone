// Bug 51: the key rule (ErrorKeyBorrow) on the route into DynArena.alloc: through a method of a struct holding the arena. Refuse.
mod lifetime_arena_key_method;
import arena use *;
struct Holder { pub r: &i64; }

struct Wrap['=a] {
  pub ar: DynArena['=a];
  fn add[T](self: &mut, v: T) &'=a mut T { ar.alloc(v) }  //~ ErrorKeyBorrow
}
fn main() {
  var w = Wrap(DynArena.empty());
  let x = 7i64;
  let k = w.add(Holder(&x)); //~ ErrorKeyBorrow
}
