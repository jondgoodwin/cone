// A borrowed data reference handed in as a parameter is not stored into a place reached through a call's
// result: the place is held to the global lifetime, and the parameter's is the caller's.
//
// Verdict: refuse, ErrorInvType (1013) at the store.
// Basis: the invariant (doc/design/references-and-regions.md, "Lifetimes: one invariant"); a place with no
// variable at its root is the global one. Lane 710: this case runs on both systems and must give the same
// verdict on each (the scope used to be read uninitialised).

mod lifetime_band_store_callresult_ref_param_refused;

struct Globals { n: i32; r: &i32; }

fn glob() *Globals { null as *Globals }

pub fn setRef(x: &i32) {
  (*glob()).r = x;   //~ ErrorInvType
}

fn main() i32 { 0 }
