// A method called on a temporary, returning a borrow of it, kept in a
// variable: the receiver is not extended, so it ends with the statement
// while the variable still holds a borrow of it.
//
// Verdict: refuse, ErrorFrozen at the statement whose temporary ends while
// 'r' still holds a borrow of it (code and position a reading of the rules).
// Basis: language rule (2 Oct 2026) -- temporaries follow Rust: refuse what
// Rust does not extend. Rust: 'let r = make().me(); r.n' is
// E0716 (a method receiver is not an extending expression); by reading, not
// run.
// Master d331baab: accepted, and the temporary is never ended -- main, run,
// prints "read = 4" and "end" with no "final". xfail until Stage 5.

mod lifetime_mix_temp_method_receiver_refused;

import stdio use *;

struct R {
  pub n i64;
  pub fn me(self &) &R { self; }
  fn final(self &uni) {
    printStr("final\n");
  }
}

fn mkso(n i64) So[R] { new So[R](n); }

fn main() {
  {
    imm r = mkso(4).me();    //~ ErrorFrozen
    printStr("read = ");
    printInt(r.n);
    printStr("\n");
  }
  printStr("end\n");
}
