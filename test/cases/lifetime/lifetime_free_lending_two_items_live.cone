// The unsafe neighbour of lifetime_free_lending_return_from_loop: two items
// of a lending iterator held at once. The second 'next' borrows the cursor
// mutably while the first item, a borrow of the cursor, is still to be used.
//
// Verdict: refuse, ErrorFrozen at the second 'next'.
// Basis: the freezing design Jon ruled 26 Sep 2026 (freezing-design.md 1,
// rules 2 and 5: a borrow a method hands back keeps its receiver frozen; a
// local is a 'uni' source). Rust: refused by NLL and Polonius alike (E0499;
// by reading, not run).
// Master d331baab: correct.

mod lifetime_free_lending_two_items_live;

struct Cursor {
  pub n i64;
  pub fn next(self &mut) &mut i64 {
    n = n + 1;
    &mut n;
  }
}

fn f() i64 {
  mut c = new Cursor(0);
  imm a = c.next();
  imm b = c.next();          //~ ErrorFrozen
  *a + *b;
}
