// Bug 56: must compile and run: a list built in an arena in a loop that widens.
mod lifetime_arena_ok_widened_loop_list;
import stdio use *;
import arena use *;
struct N { pub v: i64; pub next: Option[&mut N]; }
fn build(ar: &mut Arena, n: i64) i64 {
  var a = ar.alloc(N(0, None)); var b = ar.alloc(N(0, None)); var c = ar.alloc(N(0, None)); var d = ar.alloc(N(0, None)); var e = ar.alloc(N(0, None)); var f = ar.alloc(N(0, None));
  var i = 0i64;
  while i < n { a = b; b = c; c = d; d = e; e = f; let nn = ar.alloc(N(5, None)); f.next = Some(nn); f = nn; i += 1; }
  a.v + f.v
}
fn main() {
  var a = Arena();
  print <- build(&mut a, 10), "\n";
}
