// A method call whose receiver is borrowed mutably and whose argument reads
// the same local through another method: the receiver's borrow waits for the
// call (two-phase), so the read comes first. A user struct, not a collection.
//
// Verdict: accept; prints 4.
// Basis: refborref.html, "A borrow a method returns" (the receiver's mutable
// borrow "waits for the call"); borrow-freezing rule (26 Sep 2026): a
// receiver's mutable borrow begins only when the call itself begins.
// Rust: RFC 2025's 'vec.push(vec.len())', accepted since two-phase borrows
// (from the RFC; not run).
// Master d331baab: correct.

mod lifetime_free_two_phase_user_method;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Ctr {
  pub n i64;
  pub fn get(self &) i64 { n; }
  pub fn add(self &mut, d i64) { n = n + d; }
}

fn main() {
  mut c = new Ctr(2);
  c.add(c.get());
  show("two-phase-user-method", c.n);
}
