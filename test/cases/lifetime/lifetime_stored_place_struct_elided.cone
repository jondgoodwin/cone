// #1202: a struct that holds a borrow carries one: a store of a parameter's borrow into it is checked, not skipped. Refuse at the caller. Pair: lifetime_stored_place_struct_named, the same verdict.
mod lifetime_stored_place_struct_elided;
import stdio use *;
struct H['a] { pub p: &'a i32; }
fn put(slot: &mut H, v: &i32) { slot.p = v; }
fn main() {
  let a = 1;
  var s = H(&a);
  { let x = 5; put(&mut s, &x); }  //~ ErrorFrozen
  print <- *s.p, "\n";
}
