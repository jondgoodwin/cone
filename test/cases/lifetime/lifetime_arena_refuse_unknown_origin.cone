// Bug 51: the arena reached through a method's result (unknown origin): a local's reference left in it. Refuse.
mod lifetime_arena_refuse_unknown_origin;
import stdio use *;
import arena use *;
// an arena reached through a method's result, a local's reference left in it: MUST be refused
struct T { pub v: i64; }
struct H {
  pub p: &mut T;
  fn final(self: &uni) { print <- "final reads ", p.v, "\n"; }
}
struct S {
  pub a: Arena;
  pub fn arena(self: &mut) &mut Arena { &mut a }
}
fn stash(s: &mut S) i64 {
  var t = T(77);
  let h = s.arena().alloc(H(&mut t));  //~ ErrorCallEscape
  h.p.v
}
fn main() {
  var s = S(Arena());
  print <- stash(&mut s), "\n";
}
