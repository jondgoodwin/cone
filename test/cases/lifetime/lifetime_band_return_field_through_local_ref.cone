// A field borrowed through a local holding a parameter's borrow: the field is
// the caller's, so the borrow may be returned.
//
// Verdict: accept; prints 4.
// Basis: reading of the language rule (1 Oct 2026) that the lifetime is in
// the borrow's type, not in the variable holding it. (refborref.html's
// sentence bounding a borrow "from ... another reference" to its block is
// stricter; see
// lifetime_band_return_reborrow_through_local.) Rust: accepted (by reading,
// not run).
// Master d331baab: refused, ErrorEscape at '&mut q.x' -- safe code refused.
// xfail until Stage 1.

mod lifetime_band_return_field_through_local_ref;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pt { pub x i64; pub y i64; }

fn xOf(p &mut Pt) &mut i64 {
  imm q = p;
  &mut q.x;
}

fn main() {
  mut p = new Pt(3, 0);
  imm r = xOf(&mut p);
  *r = *r + 1;
  show("field-through-local-ref", *r);
}
