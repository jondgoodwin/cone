// A setter method, 'self &mut', storing its argument in a borrow field: the
// receiver is a '&mut' to a place that holds a borrow, so the receiver, a
// local, may hold the argument after the call, and is used after the
// argument's source ends.
//
// Verdict: refuse, ErrorFrozen at the source 's', which goes out of scope
// while 'h' still holds a borrow of it.
// Basis: reflifefn.html, "Mutable borrowed reference parameters", widened to
// a receiver holding a borrow -- a reading of that rule.
// Master d331baab: accepted, and it reads freed memory -- main, run, prints
// "final" and then "read = 1338330988176". Stage 2 fixed it.
// Since stage 8 a store a call may make through a '&mut' into a local follows
// flow, as one written out does: the call is legal, and the local used after
// the borrow's source ends is refused at that end.

mod lifetime_band_call_setter_method;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

struct H {
  pub r &R;
  pub fn set(self &mut, r &R) { self.r = r; }
}

fn main() {
  imm outer = new R(1);
  mut h = new H(&outer);
  {
    imm s = new So[R](42);   //~ ErrorFrozen "goes out of scope while"
    h.set(&*s);
  }
  printStr("read = ");
  printInt(h.r.n);
  printStr("\n");
}
