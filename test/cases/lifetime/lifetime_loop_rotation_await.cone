// Bug 57 (r1555_w2): six references rotated in a loop, then a borrow made by a call to the left of an 'await' in the same statement and used after it. The loop settles, so the await check refuses (it accepted while the holders were widened)
mod lifetime_loop_rotation_await;
import stdio use *;
import actors;
fn ref(r: &u64) &u64 {r}
fn take(r: &u64, n: u64) u64 {*r + n}
fn clobber(n: u64) u64 { var b = [0x1111u64, 0x2222u64, 0x3333u64, 0x4444u64, 0x5555u64, 0x6666u64, 0x7777u64, 0x8888u64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
fn busy(n: u64) u64 { clobber(n) }
actor Clock { pub async fn now(self) u64 {busy(2u64)} }
actor Page {
  clock: Clock;
  body: u64;
  pub async fn held(self) {
    let x = 3u64;
    var a = &x; var b = &x; var c = &x; var d = &x; var e = &x; var f = &x; var i = 0; while i < 10 { a = b; b = c; c = d; d = e; e = f; f = &x; i += 1; }
    body = take(ref(a), await clock.now());  //~ ErrorAwaitLeftCall
    printUInt(body); printStr("\n");
  }
}
fn main() {
  initAll();
  actors.configure(actors.Options(workers: 1u32));
  {
    let p = Page(Clock(), 0u64);
    p.held();
  }
  finalAll();
}
