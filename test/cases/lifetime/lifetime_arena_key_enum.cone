// Bug 51: the key rule (ErrorKeyBorrow) on the route into DynArena.alloc: an enum holding the borrow. Refuse.
mod lifetime_arena_key_enum;
import arena use *;
struct Holder { pub r: &i64; }

enum E { Ref(&i64), Nothing }
fn main() {
  var ar = DynArena.empty();
  let x = 7i64;
  let k = ar.alloc(E.Ref(&x)); //~ ErrorKeyBorrow
}
