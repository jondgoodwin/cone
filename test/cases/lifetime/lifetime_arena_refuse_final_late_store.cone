// Bug 51 (spike): a finalizable node filled in late with a borrow of a local. Refuse.
mod lifetime_arena_refuse_final_late_store;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { print <- self.p.unwrap().v, "\n"; } }
fn stash(ar: &mut Arena) {
  var t = T(7);
  let f = ar.alloc(F(None));
  f.p = Some(&mut t);  //~ ErrorEscape
}
fn main() {
  var a = Arena();
  stash(&mut a);
}
