// Bug 51 (spike): a node whose 'final' reads a borrow of a local, stored in the arena. Refuse: the arena finalizes it after the local is gone.
mod lifetime_arena_refuse_final_reads_local;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: &mut T; fn final(self: &uni) { print <- self.p.v, "\n"; } }
fn stash(ar: &mut Arena) {
  var t = T(7);
  ar.alloc(F(&mut t));  //~ ErrorCallEscape
}
fn main() {
  var a = Arena();
  stash(&mut a);
}
