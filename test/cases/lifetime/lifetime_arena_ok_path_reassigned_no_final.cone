// Bug 48/51 (narrowed): the path the arena is reached by is reassigned between taking the value and the store. The stored node has no 'final', so no arena reads the stale reference.
mod lifetime_arena_ok_path_reassigned_no_final;
import stdio use *;
import arena use *;
struct W { pub a: &mut Arena; }
struct S { pub home: &mut Arena; }
fn bad(s: &mut S, other: &mut Arena) {
  let old = s.home;
  s.home = other;
  s.home.alloc(W(old));
}
fn main() {
  var a = Arena();
  var b = Arena();
  var s = S(&mut a);
  bad(&mut s, &mut b);
}
