// Two arenas made by two calls of DynArena.empty(), side by side: each call
// site mints a brand of its own, and each arena's keys open that arena.
//
// Verdict: accept; prints 1 2 10 20.
// Basis: a function whose result names an invariant lifetime none of its
// parameters does creates a fresh one at each call site (invariant
// lifetimes, settled 3 Oct 2026); 'ar[key]' opens where the two carry the
// same one.
// Master 1117c92a: no DynArena, and ''=a' refused at lex ("Invalid lifetime
// or too-long character literal").

mod lifetime_inv_mint_two_sites;

import stdio use *;
import arena use *;

struct R { pub n i64; }

fn main() {
  mut a = DynArena.empty();
  mut b = DynArena.empty();
  imm a1 = a.alloc(new R(1));
  imm b1 = b.alloc(new R(10));
  imm a2 = a.alloc(new R(2));
  imm b2 = b.alloc(new R(20));
  printInt(a[a1].n);
  printStr(" ");
  printInt(a[a2].n);
  printStr(" ");
  printInt(b[b1].n);
  printStr(" ");
  printInt(b[b2].n);
  printStr("\n");
}
