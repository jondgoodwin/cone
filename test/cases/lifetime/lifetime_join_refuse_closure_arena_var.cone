// Bug 62: a closure giving a 'var' parameter an arena node, the borrow stored into it after. Refuse: the borrows are one value, and a store through it could put the younger one where the holder points.
// Master e9e953096: compiled, and the program printed: none | finalizer reads 2301369602224
// (the younger local's function had returned and a call had reused its stack before the read; 7 would have been a live read).
mod lifetime_join_refuse_closure_arena_var;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- "finalizer reads ", r.v, "\n"; } case None { print <- "none\n"; } } } }
struct Hd { pub ar: &mut Arena; }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
fn mkF(a: &mut Hd) &mut F { a.ar.alloc(F(None)) }
fn mkO(a: &mut Hd) Option[&mut F] { Some(mkF(a)) }
fn stash(a: &mut Hd, var f: &mut F, x: &mut T) { var g = fn() { f = mkF(a); }; g(); f.p = Some(x); }  //~ ErrorEscape
//~^ ErrorCallEscape
//~^^ ErrorEscape
//~^^^ ErrorEscape
fn scope(q: &mut Arena) { var t = T(7); var h = Hd(q); var g = F(None); stash(&mut h, &mut g, &mut t); }
fn main() { var a = Arena(); scope(&mut a); print <- clobber(3), "\n"; }
