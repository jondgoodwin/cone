// A call handed a parameter's borrow and a local's returns the shorter, the
// local's, whichever one the callee actually returns: it may not be returned.
//
// Verdict: refuse, ErrorEscape at the returned call.
// Basis: reflifefn.html (all unannotated borrows in a signature share one
// lifetime; the result has the shortest); Jon, 1 Oct 2026 (WI\lifetimes.md):
// all unannotated borrows are "of the same lifetime".
// Master d331baab: correct.

mod lifetime_band_return_call_param_and_local;

fn first(a &i64, b &i64) &i64 { a; }

fn f(p &i64) &i64 {
  imm x = 1i64;
  first(p, &x);              //~ ErrorEscape:8
}
