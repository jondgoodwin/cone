// Bug 51 (spike): a finalizable value nested a field down in the stored node. Refuse.
mod lifetime_arena_refuse_final_nested;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct F { pub p: &mut T; fn final(self: &uni) { print <- self.p.v, "\n"; } }
struct W { pub f: F; }
fn stash(ar: &mut Arena) {
  var t = T(7);
  ar.alloc(W(F(&mut t)));  //~ ErrorCallEscape
}
fn main() {
  var a = Arena();
  stash(&mut a);
}
