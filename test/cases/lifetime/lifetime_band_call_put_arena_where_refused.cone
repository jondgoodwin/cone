// Bug 77, the caller half, the arena form: 'put' stores a node of 'a' (a.alloc(..)) where 'h' points, with 'a >= 'h. A caller whose arena dies before 'h' is refused.
mod lifetime_band_call_put_arena_where_refused;
import stdio use *;
import arena use Arena;
struct Pt { pub v: i64; }
struct Host['h] { pub r: &'h Pt; }
fn put(h: &mut Host['h], a: &'a mut Arena) where 'a >= 'h { h.r = a.alloc(Pt(1i64)); }
fn main() {
  var base = Pt(0i64);
  var h = Host(&base);
  { var ar = Arena(); put(&mut h, &mut ar); }  //~ ErrorFrozen
  print <- h.r.v, "\n";
}
