// A variable holding a borrow is borrowed itself and given another borrow, in
// ways that stay safe: the new borrow lives as long as everything that reads
// it; the borrow of the variable is made after the last store; what was read
// through it before the store, and a borrow of what it pointed at then, do not
// follow the store; and a reference to the borrowed variable's value that was
// pointed elsewhere reads nothing stored in it afterwards.
//
// Verdict: accept, and run.
// Basis: the lifetime invariant (references-and-regions.md).

mod lifetime_mix_borrowed_var_repointed_ok;

import stdio use *;

fn longer() {
  var a = 1i64;
  var c = 3i64;
  var out = [&a];
  {
    var h = &a;
    var p = &mut h;
    h = &c;
    out[0usize] = *p;
  }
  printInt(*out[0usize]);
  printStr("\n");
}

fn madeAfter() {
  var a = 4i64;
  var out = [&a];
  {
    var b = 2i64;
    var h = &b;
    h = &a;
    var p = &mut h;
    out[0usize] = *p;
  }
  printInt(*out[0usize]);
  printStr("\n");
}

fn readBefore() {
  var a = 5i64;
  var h = &a;
  var p = &mut h;
  let x = *p;
  let r = &**p;
  {
    var b = 2i64;
    h = &b;
    printInt(**p);
    printStr("\n");
  }
  printInt(*x + *r);
  printStr("\n");
}

fn pointedElsewhere() {
  var a = 6i64;
  var g = &a;
  var h = &a;
  var p = &mut h;
  p = &mut g;
  {
    var b = 2i64;
    h = &b;
    printInt(*h);
    printStr("\n");
  }
  printInt(**p);
  printStr("\n");
}

fn main() {
  longer();
  madeAfter();
  readBefore();
  pointedElsewhere();
}
