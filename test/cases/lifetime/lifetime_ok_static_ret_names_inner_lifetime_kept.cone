// Row 742: a '&'static Node['a]' result ties the caller to none of the borrows of its argument but those the argument holds: here the local 'nd' is lent, and the result is kept past its block ('nd' holds only a global's borrow). Prints 7.
mod lifetime_ok_static_ret_names_inner_lifetime_kept;
import stdio use *;
struct Node['a] { pub l: &'a i64; }
let G: i64 = 7;
let GN = Node(&G);
fn pick(l: &'a Node['a]) &'static Node['a] { &GN }
fn main() {
    var keep = &GN;
    {
        var nd = Node(&G);
        keep = pick(&nd);
    }
    print <- keep.l, "\n";
}
