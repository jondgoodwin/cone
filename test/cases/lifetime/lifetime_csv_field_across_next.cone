// The csv Reader reuses its Record: a field borrowed from a record may not be used after the next 'next'. Refuse.
mod lifetime_csv_field_across_next;
import stdio use *;
import collections use *;
import csv;

fn go() usize {
  var r = csv.reader("a,b\r\nc,d\r\n");
  var n = 0usize;
  match r.next() {
    case let Ok(o) {
      match o {
        case let Some(rec) {
          let field = rec.get(0usize);
          let again = r.next();  //~ ErrorShapeReshape
          match field {
            case let Some(f) { n = f.len(); }
            case is None { }
          }
        }
        case is None { }
      }
    }
    case is Err { }
  }
  n
}

fn main() {
  print <- go(), "\n";
}
