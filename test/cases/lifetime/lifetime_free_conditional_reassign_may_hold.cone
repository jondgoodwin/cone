// A borrow reassigned to another source on one path only: after the 'if' it
// may still hold the first source. A 'mut' borrow of a local is an alias loan,
// so the first source is written by name all the same, and the borrow reads
// the new value when it is still the first.
//
// Verdict: accept; prints 272 for the borrow moved to b, 277 for the borrow
// left on a. (Refused, ErrorFrozen at the change, until 11 Oct 2026.)
// Basis: language rule (11 Oct 2026) -- locals lend several '&mut', as
// parameters already do: a 'mut' borrow of a place reached as 'uni' freezes
// only what needs the source unique (moving it, lending it '&uni' or '&imm',
// ending it); the same borrow through a '&mut' parameter always compiled.
// Rust: refused by NLL and Polonius (by reading, not run); that is the '&uni'
// case, not this one.
// Master cb9e00ea: refused.

mod lifetime_free_conditional_reassign_may_hold;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn f(c bool) i64 {
  var a = 1i64;
  var b = 2i64;
  var r = &mut a;
  if c { r = &mut b; }
  a = 7;
  *r + a * 10 + b * 100
}

fn main() {
  show("moved-to-b", f(true));
  show("left-on-a", f(false));
}
