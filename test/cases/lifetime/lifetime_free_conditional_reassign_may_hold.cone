// A borrow reassigned to another source on one path only: after the 'if' it
// may still hold the first source, so that source stays frozen.
//
// Verdict: refuse, ErrorFrozen at the change.
// Basis: borrow-freezing rule (26 Sep 2026) -- at a join a holder holds the
// union of the paths' loans.
// Rust: refused by NLL and Polonius (by reading, not run).
// Master d331baab: correct.

mod lifetime_free_conditional_reassign_may_hold;

fn f(c bool) i64 {
  mut a = 1i64;
  mut b = 2i64;
  mut r = &mut a;
  if c { r = &mut b; }
  a = 7;                     //~ ErrorFrozen
  *r;
}
