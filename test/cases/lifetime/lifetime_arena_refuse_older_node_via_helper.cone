// Bug 51 (design chat probe f4): an older node linked to a newer node holding a local's borrow. Refuse.
mod lifetime_arena_refuse_older_node_via_helper;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
fn clobber(n: i64) i64 { var b = [0x1111i64, 0x2222i64, 0x3333i64, 0x4444i64, 0x5555i64, 0x6666i64, 0x7777i64, 0x8888i64]; var i = 0usize; var s = n; while i < 8usize { b[i] += s; s += b[i]; i += 1usize; } s }
struct G { pub g: Option[&mut H]; }
struct Holder { pub ar: &mut Arena; }
fn link(h: &mut Holder, old: &mut G, x: &mut T) { let n = h.ar.alloc(H(x)); old.g = Some(n); } //~ WarnLifetimeTie
fn scope(h: &mut Holder, old: &mut G) { var t = T(77); link(h, old, &mut t); }  //~ ErrorCallEscape
fn main() { var a = Arena(); var h = Holder(&mut a); var o = G(None); scope(&mut h, &mut o); print <- clobber(3), " ", o.g.unwrap().p.v, "\n"; }  //~ ErrorCallEscape
