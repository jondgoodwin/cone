// Bug 68: an arena reference made from a raw pointer holds no loan, so it is the one trusted route (as DynArena's 'alloc' reaches its inner arena); a borrow of a local that outlives the arena is stored in it twice. Accept.
mod lifetime_arena_ok_raw_inner;
import stdio use *;
import arena use *;
struct N { pub p: &i32; fn final(self: &uni) { print <- "n reads ", *self.p, "\n"; } }
struct W { ar: Arena; fn put(self: &mut W, v: N) { let inner = (&mut self.ar as *Arena) as &mut Arena; inner.alloc(v); } }
fn main() {
  let x = 5;
  var w = W(Arena());
  w.put(N(&x));
  w.put(N(&x));
}
