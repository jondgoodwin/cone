// The cure for lifetime_arena_refuse_method_form_unnamed: the struct names the
// lifetime of the node it points at ('n) and the method states that the arena
// outlives it (where 'a >= 'n). The call is then accepted and runs.
mod lifetime_arena_ok_method_form_where;
import stdio use *;
import arena use *;

struct Node { pub val: i64; }
struct P['n] {
  pub pos: i64;
  pub keep: &'n Node;

  fn mk2(self: &mut, ar: &'a mut Arena, v: i64) &'a mut Node { pos += 1; ar.alloc(Node(v)) }
  fn eat(self: &mut) { pos += 1; }

  fn two2(self: &mut P['n], ar: &'a mut Arena) i64 where 'a >= 'n {
    let a = self.mk2(ar, 1);
    self.eat();
    a.val + self.keep.val
  }
}

fn main() {
  var a = Arena();
  let base = Node(40);
  var p = P(0, &base);
  print <- p.two2(&mut a), "\n";
  print <- p.pos, "\n";
}
