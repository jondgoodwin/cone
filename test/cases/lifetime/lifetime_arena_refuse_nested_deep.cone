struct F { pub p: &mut T; fn final(self: &uni) { print <- "finalizer reads ", self.p.v, "\n"; } }
struct A0 { pub f: F; }
struct A1 { pub n: A0; }
struct A2 { pub n: A1; }
struct A3 { pub n: A2; }
struct A4 { pub n: A3; }
struct A5 { pub n: A4; }
