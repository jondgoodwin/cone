// A callee handed '&mut h', 'h' a struct whose field is a '&mut &R' lent
// from 'q', may store its other argument through that field ('*h.r = v'):
// into 'q' itself. So 'q' holds that borrow afterwards, and its source may
// not end while 'q' is used.
//
// Verdict: refuse, ErrorFrozen where 's' is declared (it ends first).
// Basis: borrow-freezing rule (26 Sep 2026) -- a store through a reference
// puts the stored borrow's loans into what the reference points at, through
// every writable borrow the argument reaches, a struct's fields included;
// reflifefn.html, "Mutable borrowed reference parameters".
// Master b306a838: accepted, and it reads freed memory -- main, run, prints
// "final" (for 's') and then "read = 1416101098480" through 'q'. The store
// was recorded on 'h', not on the 'q' its field points at.

mod lifetime_free_call_store_through_struct_field_frozen;

import stdio use *;

struct R {
  pub n i64;
  fn final(self &uni) {
    printStr("final\n");
  }
}

struct H { pub r &mut &R; }

fn st(h &mut H, v &R) { *h.r = v; }

fn main() {
  imm outer = new R(1);
  mut q = &outer;
  {
    imm s = new So[R](42);   //~ ErrorFrozen
    mut h = new H(&mut q);
    st(&mut h, &*s);
  }
  printStr("read = ");
  printInt(q.n);
  printStr("\n");
}
