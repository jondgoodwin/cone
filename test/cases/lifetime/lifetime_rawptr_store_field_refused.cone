// A borrow stored through a raw pointer held in a field of a struct (a parameter's or a local's) is refused,
// and so is one stored through a pointer to a pointer: any dereference of a raw pointer on the place's path
// makes the holder the pointee.
//
// Verdict: refuse, ErrorInvType (1013) at each store.
// Basis: as lifetime_rawptr_store_param_refused (Jon, 18 Nov 2026). Lane 735 (row 536).

mod lifetime_rawptr_store_field_refused;

struct Cell { r: &i32; n: i32; }
struct Holder { p: *Cell; }

pub fn viaFieldOfParam(h: Holder, x: &i32) {
  (*h.p).r = x;   //~ ErrorInvType
}

pub fn viaFieldAutoDeref(h: Holder, x: &i32) {
  h.p.r = x;   //~ ErrorInvType
}

pub fn viaFieldOfLocal(c: *Cell, x: &i32) {
  var h = Holder(c);
  h.p.r = x;   //~ ErrorInvType
}

pub fn viaPointerToPointer(pp: *(*Cell), x: &i32) {
  (**pp).r = x;   //~ ErrorInvType
}

fn main() i32 { 0 }
