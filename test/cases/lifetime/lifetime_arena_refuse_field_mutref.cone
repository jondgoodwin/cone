// Bug 51: as lifetime_arena_refuse_field, the arena behind a '&mut' field. Refuse.
mod lifetime_arena_refuse_field_mutref;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: &mut T; }
struct Holder { pub ar: &mut Arena; }
fn stash(h: &mut Holder, x: &mut T) i64 {
  let n = h.ar.alloc(H(x));  //~ ErrorCallEscape
  n.p.v
}
fn make(h: &mut Holder) i64 {
  var t = T(77);
  stash(h, &mut t)
}
fn main() {
  var a = Arena();
  var h = Holder(&mut a);
  print <- make(&mut h), "\n";
}
