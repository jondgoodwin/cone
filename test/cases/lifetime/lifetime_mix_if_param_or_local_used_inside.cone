// An 'if' choosing a parameter's borrow or a local's, used only inside the
// function: the shorter lifetime, the local's, is long enough for that.
//
// Verdict: accept; prints 7 and 1.
// Basis: language rule (1 Oct 2026) -- a borrow with a function lifetime is
// usable throughout the function; language rule (26 Sep 2026): at a join, a
// borrow takes the shorter of its arms' lifetimes.
// Master d331baab: correct.

mod lifetime_mix_if_param_or_local_used_inside;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn f(c bool, a &i64) i64 {
  imm x = 7i64;
  imm r = if c { &x; } else { a; };
  *r;
}

fn main() {
  imm one = 1i64;
  show("if-local-used-inside", f(true, &one));
  show("if-param-used-inside", f(false, &one));
}
