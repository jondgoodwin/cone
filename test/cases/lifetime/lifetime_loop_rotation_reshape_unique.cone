// Bug 58 (r1950_w2): six '&mut' references rotated in a loop, then '&mut a[0]' through one and a call that grows the list through the list's own name. The loop settles, so the reshape check refuses the call (it let it through while the holders were widened)
mod lifetime_loop_rotation_reshape_unique;
import collections use *;
import stdio use *;
fn grow(l: &mut List[i64]) { var k = 0; while k < 1000 { l.push(7); k += 1; } }
fn churn() { var k2 = 0; while k2 < 64 { var z = List[i64](); var j = 0; while j < 600 { z.push(99); j += 1; } k2 += 1; } }
fn go() i64 {
  var l = List[i64](); l.push(5);
  var a = &mut l; var b = &mut l; var c = &mut l; var d = &mut l; var e = &mut l; var f = &mut l;
  var i = 0;
  while i < 10 { a = b; b = c; c = d; d = e; e = f; f = &mut l; i += 1; }
  let x = &mut a[0usize];
  grow(&mut l);  //~ ErrorShapeReshape
  churn();
  *x
}
fn main() { print <- go(), "\n"; }
