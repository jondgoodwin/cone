// Bug 48/51 (narrowed): as lifetime_arena_ok_path_reassigned_no_final, the stale value held by a local that is the receiver's path's copy. No node has a 'final'.
mod lifetime_arena_ok_path_reassigned_local_no_final;
import stdio use *;
import arena use *;
struct W { pub a: &mut Arena; }
struct S { pub home: &mut Arena; }
fn bad(s: &mut S, other: &mut Arena) {
  let r = s.home;
  let old = r;
  s.home = other;
  r.alloc(W(old));
  s.home.alloc(W(r));
}
fn main() {
  var a = Arena();
  var b = Arena();
  var s = S(&mut a);
  bad(&mut s, &mut b);
}
