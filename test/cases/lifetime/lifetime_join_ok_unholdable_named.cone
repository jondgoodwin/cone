// The cure for lifetime_join_refuse_unholdable: H names the lifetime of what it
// points at ('x), D names each of its borrows separately, and usef is written
// against those names, so the younger Q is not tied to H's borrow. Accepted and run.
mod lifetime_join_ok_unholdable_named;
import stdio use *;

struct T { pub v: i64; }
struct H['x] { pub p: &'x T; }
struct Q { pub n: i64; }
struct D['h, 'q, 'x] { pub h: &'h mut H['x]; pub q: &'q mut Q; }
fn usef(d: &mut D['h, 'q, 'x]) { d.q.n += 1; }
fn scope(h: &mut H['x]) { var q = Q(1); var d = D(h, &mut q); usef(&mut d); print <- q.n, "\n"; }
fn main() {
  var y = T(7);
  var h = H(&y);
  scope(&mut h);
  print <- "holder reads ", h.p.v, "\n";
}
