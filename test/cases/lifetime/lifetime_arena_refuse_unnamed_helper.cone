// Bug 55 (spike): a helper naming no lifetime stores another parameter in the arena's node. Refuse.
mod lifetime_arena_refuse_unnamed_helper;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct N { pub p: Option[&mut T]; }
struct S['a] { pub p: Option[&'a mut T]; }
struct F { pub p: Option[&mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- r.v, "\n"; } case None { print <- "none\n"; } } } }
struct FS['a] { pub p: Option[&'a mut T]; fn final(self: &uni) { match self.p { case let Some(r) { print <- r.v, "\n"; } case None { print <- "none\n"; } } } }
struct G { pub n: &mut N; fn final(self: &uni) { match self.n.p { case let Some(r) { print <- r.v, "\n"; } case None { print <- "none\n"; } } } }
struct GS['a] { pub n: &'a mut S['a]; fn final(self: &uni) { match self.n.p { case let Some(r) { print <- r.v, "\n"; } case None { print <- "none\n"; } } } }
struct Holder { pub ar: Arena; }
struct HR['a] { pub ar: &'a mut Arena; }
fn stash(ar: &mut Arena, x: &mut T) { let f = ar.alloc(F(None)); f.p = Some(x); }  //~ ErrorEscape
fn main() { var a = Arena(); { var t = T(7); stash(&mut a, &mut t); } }
