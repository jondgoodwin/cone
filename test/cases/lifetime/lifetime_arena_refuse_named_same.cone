// Bug 51: a parameter's reference stored into the caller's arena under one lifetime name ('a on both). Refuse: the arena may outlive 'a.
mod lifetime_arena_refuse_named_same;
import stdio use *;
import arena use *;
// as jn_h5, the allocation bound to a name
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn keep(ar: &'a mut Arena, x: &'a mut T) i64 {
  let h = ar.alloc(H(Some(x)));
  h.p.unwrap().v
}
fn main() {
  var a = Arena();
  var t = T(1);  //~ ErrorFrozen
  print <- keep(&mut a, &mut t), "\n";
}
