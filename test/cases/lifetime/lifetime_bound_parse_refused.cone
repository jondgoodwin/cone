// The spellings a lifetime bound does not take: under an 'or', alone or
// after an 'is'; 'T is 'a', which reads T as a lifetime; an invariant
// lifetime, which has no order to bound by; on a plain reference, which
// names its own lifetime; and on a generic type's parameter, in its
// brackets or its 'where' clause, where no bound is built.
//
// Verdict: refuse: ErrorLifetimeOr at each 'or', ErrorWhereForm at 'T is
// 'a', ErrorLifetimeInvariant at ''=a', ErrorLifetimeBound at the plain
// reference's bound and at each generic type's.
// Basis: language rule (3 Oct 2026): a bound joins a 'where' clause by
// 'and' only, as a lifetime comparison does, since a lifetime is never
// instanced and no instance settles an 'or'; it is written 'T + 'a', in the
// brackets or the 'where' clause, or after an 'is' clause's traits; a bound
// is said of a type whose insides are unknown (refgeneric.html, "Where
// clause"; reflifefn.html, "Lifetime bounds").
// Master 2cb190a1: refused at parse, each for its '+' or lifetime, as no
// bound was built.

mod lifetime_bound_parse_refused;

struct R { pub n i64; }

fn orBound[T](x T, y &'a R) where T + 'a or T is Copy {          //~ ErrorLifetimeOr "by 'and' only"
}

fn orAfterIs[T](x T, y &'a R) where T is Copy + 'a or T is Integer {   //~ ErrorLifetimeOr "by 'and' only"
}

fn isLife[T](x T, y &'a R) where T is 'a {                       //~ ErrorWhereForm "written 'T + 'a'"
}

fn inv[T + '=a](x T) {                                            //~ ErrorLifetimeInvariant "no order"
}

fn plain(x &R + 'a) {                                             //~ ErrorLifetimeBound "virtual reference's"
}

struct Box[T + 'a] {                                              //~ ErrorLifetimeBound "generic type's parameter"
  pub v T;
}

struct Cell[T] where T + 'a {                                     //~ ErrorLifetimeBound "generic type's parameter"
  pub v T;
}
