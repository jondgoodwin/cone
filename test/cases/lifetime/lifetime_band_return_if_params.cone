// An 'if' choosing between two unannotated borrowed parameters: both have the
// one unnamed caller lifetime, so the choice has it too, and may be returned.
//
// Verdict: accept; prints 1 and 2.
// Basis: reflifefn.html ("All borrowed references without annotations are
// understood to have the same lifetime"; its 'refswitch' example); language
// rule (1 Oct 2026): every borrow of the unnamed lifetime ' has the same
// lifetime.
// Master d331baab: correct.

mod lifetime_band_return_if_params;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn refswitch(c Bool, a &i64, b &i64) &i64 {
  if c { a; } else { b; }
}

fn main() {
  imm one = 1i64;
  imm two = 2i64;
  show("if-first", *refswitch(true, &one, &two));
  show("if-second", *refswitch(false, &one, &two));
}
