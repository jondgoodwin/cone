// Bug 51 (spike): the handle alloc returns, which carries the local's borrow, kept past the local. Refuse.
mod lifetime_arena_refuse_handle_outlives;
import stdio use *;
import arena use *;
struct T { pub v: i64; }
struct H { pub p: Option[&mut T]; }
fn main() {
  var a = Arena();
  var keep = a.alloc(H(None));
  {
    var t = T(7);  //~ ErrorFrozen
    keep = a.alloc(H(Some(&mut t)));
  }
  print <- keep.p.unwrap().v, "\n";
}
