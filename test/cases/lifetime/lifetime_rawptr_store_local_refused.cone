// A borrow stored into a place reached through a raw pointer held by a local variable is refused, as through
// a parameter: the local is the pointer's own storage, and what it points at is a different place.
//
// Verdict: refuse, ErrorInvType (1013) at each store.
// Basis: as lifetime_rawptr_store_param_refused (Jon, 18 Nov 2026). Lane 735 (row 536).

mod lifetime_rawptr_store_local_refused;

struct Cell { r: &i32; n: i32; }

fn cell() *Cell { null as *Cell }

pub fn viaLocal(x: &i32) {
  let p = cell();
  (*p).r = x;   //~ ErrorInvType
}

pub fn viaLocalVar(x: &i32) {
  var p = cell();
  p.r = x;   //~ ErrorInvType
}

fn main() i32 { 0 }
