// A borrow used in one arm of a nested 'if'; every other arm, at either
// depth, changes the source directly.
//
// Verdict: accept; prints 4, 5 and 4.
// Basis: borrow-freezing rule (26 Sep 2026) -- a source is frozen only on the
// paths where the borrow is still to be used.
// Master d331baab: correct.

mod lifetime_free_nested_if_inner_arm;

import stdio use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pt { pub x i64; pub y i64; }

fn f(a bool, b bool) i64 {
  mut p = new Pt(1, 2);
  imm r = &mut p;
  if a {
    if b { r.x = 2; } else { p.x = 3; }
  }
  else {
    p.y = 3;
  }
  p.x + p.y;
}

fn main() {
  show("inner-borrow-arm", f(true, true));
  show("inner-source-arm", f(true, false));
  show("outer-source-arm", f(false, false));
}
