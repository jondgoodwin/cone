// A lifetime on a name used alone is refused where it names no type, as after a
// path: a value, a function, a parameter, a global, a const, a module, a field
// or a type parameter.

mod lifetime_name_alone_refused;

let global: i64 = 1i64;
const Limit: i64 = 2i64;

fn twice(v: i64) i64 {
  v + v
}

fn local() i64 {
  let x = 1i64;
  x['=c] //~ ErrorLifetimeArgs
}

fn parm(v: i64) i64 {
  v['=c] //~ ErrorLifetimeArgs
}

fn call() i64 {
  twice['=c](1i64) //~ ErrorLifetimeArgs
}

fn globals() i64 {
  global['=c] //~ ErrorLifetimeArgs
}

fn consts() i64 {
  Limit['=c] //~ ErrorLifetimeArgs
}

fn modules() i64 {
  lifetime_name_alone_refused['=c].Limit //~ ErrorLifetimeArgs
}

fn typeparm[T](x: &T['a]) { //~ ErrorLifetimeArgs
}

struct Counter {
  pub n: i64;
  pub fn get(self: &) i64 {
    n['=c] //~ ErrorLifetimeArgs
  }
}

fn main() i32 {
