// The annotated form of lifetime_mix_struct_getter_result_returned: 'H'
// declares ''a' and its getter returns '&'a R', the field it reads, not a
// borrow of 'H'. So 'h.get()' carries what 'h' holds -- the caller's borrow
// 'p' -- and not 'h', a local: it may be returned.
//
// Verdict: accept; prints 5.
// Basis: a struct's declared lifetime acts as a caller lifetime in its
// methods: a getter's result of the struct's lifetime is where the field
// points, so a call carries what the receiver holds in that lifetime and not
// the receiver (Rust: 'impl<'a> H<'a> { fn get(&self) -> &'a R }').
// Master b07a3adc: refused at parse (ErrorBadTok: a lifetime in a struct's
// brackets).

mod lifetime_mix_struct_getter_annotated_result_returned;

import stdio use *;

struct R { pub n i64; }

struct H['a] {
  pub r &'a R;
  pub fn get(self &) &'a R { r; }
}

fn f(p &R) &R {
  imm h = new H(p);
  h.get();
}

fn main() {
  imm x = new R(5);
  printInt(f(&x).n);
  printStr("\n");
}
