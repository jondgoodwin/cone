// Each atomic intrinsic is one LLVM instruction, carrying the ordering the call
// gave it and the alignment of its type: a load and a store marked atomic, an
// atomicrmw for each read-modify-write, a cmpxchg for compareSwap with both of
// its orderings, min and max signed or unsigned as their type is. A bool is
// acted on as the byte that holds it, and a raw pointer as a pointer. No call
// is left behind.

mod intrinsic_genllvm_atomic;

const acquire = MemOrder.Acquire;

pub fn run(p: *i32, w: *u64, b: *bool, s: **i32) i32 {
  let a = mem.atomicLoad[i32](p, acquire);
  mem.atomicStore[i32](p, a, MemOrder.Release);
  let c = mem.atomicAdd[i32](p, 1i32, MemOrder.Relaxed);
  let d = mem.atomicSub[u64](w, 2u64, MemOrder.AcqRel);
  let e = mem.atomicAnd[i32](p, 3i32, MemOrder.SeqCst);
  let f = mem.atomicOr[bool](b, true, MemOrder.Release);
  let g = mem.atomicXor[i32](p, 5i32, MemOrder.Acquire);
  let h = mem.atomicSwap[*i32](s, p, MemOrder.SeqCst);
  var seen = 0i32;
  var ok = false;
  seen, ok = mem.atomicCompareSwap[i32](p, 6i32, 7i32, MemOrder.AcqRel, MemOrder.Acquire);
  var seenp = p;
  seenp, ok = mem.atomicCompareSwap[*i32](s, p, h, MemOrder.SeqCst, MemOrder.Relaxed);
  mem.atomicStore[bool](b, f, MemOrder.SeqCst);
  a + c + e + g + seen
}

// Min and max compare as their type does: signed for an i32, unsigned for a u32
pub fn minmax(p: *i32, q: *u32) i32 {
  let a = mem.atomicMin[i32](p, 1i32, MemOrder.Relaxed);
  let b = mem.atomicMax[i32](p, 2i32, MemOrder.SeqCst);
  let c = mem.atomicMin[u32](q, 3u32, MemOrder.AcqRel);
  let d = mem.atomicMax[u32](q, 4u32, MemOrder.Acquire);
  a + b + i32.from(c + d)
}
