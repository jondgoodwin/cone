// isDefined and definedInt (TEMPORARY, a provisional mechanism; its final
// design is open) look the name up as the program is compiled, so it is
// written as a string literal: a variable, a parameter or a call's result is
// known only as the program runs, and is refused.

mod intrinsic_typecheck_define;

fn named() &[]u8 {
  "FAST";
}

fn check(name &[]u8) Bool {
  isDefined(name);                                   //~ ErrorDefineName "string literal"
}

fn level() i64 {
  imm name = "LEVEL";
  imm a = definedInt(name);                          //~ ErrorDefineName "string literal"
  a + definedInt(named());                           //~ ErrorDefineName "string literal"
}

fn main() {
  check("FAST");
  level();
}
