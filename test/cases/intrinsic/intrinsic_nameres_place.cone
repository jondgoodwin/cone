// '@intrinsic' is allowed only in the core package [Jon 26 Sep: core only for
// now]: on a function of its root module or of a submodule, or on a function of
// a plain struct one of them declares, which is how core's 'mem' holds them.
// Anywhere else it is refused before its name is looked up, so a name the
// registry does define is refused here too: this module is not core, and
// neither is a struct it declares.

mod intrinsic_nameres_place;

fn @intrinsic countOnes[T](x T) u32;                 //~ ErrorIntrinsicPlace "a module of the core package"

struct Counter {
  fn @intrinsic sizeof[T]() usize;                   //~ ErrorIntrinsicPlace:3 "a module of the core package"
}

fn main() {
}
