// '@intrinsic' is allowed only on a function declared directly in the core
// package's own module [Jon 26 Sep: core only for now]. Anywhere else it is
// refused before its name is looked up, so a name the registry does define is
// refused here too: this module is not core, and neither is a type's body.

mod intrinsic_nameres_place;

fn @intrinsic countOnes[T](x T) u32;                 //~ ErrorIntrinsicPlace "the core package's own module"

struct Counter {
  fn @intrinsic sizeof[T]() usize;                   //~ ErrorIntrinsicPlace:3 "the core package's own module"
}

fn main() {
}
