// A number's methods are of the types they mean something for: 'abs' wants a
// signed integer or a float (an unsigned integer has nothing to take the sign
// of), 'min' and 'max' an integer or a float, and 'floor', 'ceil', 'round' and
// 'fma' a float. The methods an integer or a bool has no such name for are
// refused at the name, and core's mem versions, called at a type outside their
// class, where the instance is made. A bool and a char are no quantity, and
// have none of them.

mod intrinsic_typecheck_numbers;

struct Point {
  pub x: i32;
}

fn main() {
  let u = 5u32;
  let i = 5;
  let f = 1.5;
  let a = u.abs();                    //~ ErrorNoMbr:12 "Method or field `abs` not found"
  let b = i.floor();                  //~ ErrorNoMbr:12 "`floor`"
  let c = i.ceil();                   //~ ErrorNoMbr:12 "`ceil`"
  let d = u.round();                  //~ ErrorNoMbr:12 "`round`"
  let e = i.fma(i, i);                //~ ErrorNoMbr:12 "`fma`"
  let g = true.min(false);            //~ ErrorNoMbr:15 "`min`"
  let h = 'a'.max('b');               //~ ErrorNoMbr:14 "`max`"
  let j = f.min(i);                   //~ ErrorNoCandidate:12 "No method declared by `min` accepts"
  let k = f.fma(2.0);                 //~ ErrorNoCandidate:12 "No method declared by `fma` accepts"
  let l = mem.abs(5u8);               //~ ErrorIntrinsicType:14 "abs acts on a T that is a signed integer type of 8 to 64 bits or a float, and u8 is not one"
  let m = mem.floor(7);               //~ ErrorIntrinsicType:14 "and i32 is not one"
  let n = mem.fma(1, 2, 3);           //~ ErrorIntrinsicType:14 "fma acts on a T that is a float type"
  let o = mem.min(true, false);       //~ ErrorIntrinsicType:14 "min acts on a T that is an integer type of 8 to 64 bits or a float"
  let p = mem.max(Point(1), Point(2));    //~ ErrorIntrinsicType:14 "and Point is not one"
}
