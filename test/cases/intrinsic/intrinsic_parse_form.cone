// '@intrinsic' says the compiler supplies what a function does, expanded at
// each call, so the function never has a symbol. What speaks about a symbol is
// refused beside it: 'extern' (defined elsewhere) and '@c' (its C name). The
// attribute may stand first after 'fn' or after '@c' and '@initpure', as they
// may after each other.
//
// Like intrinsic_nameres_registry, this module is named 'core' and compiled
// against an empty core package (see cases.toml). The parser reports these,
// so the registry is never consulted.

mod core;

extern fn @intrinsic writeRaw[T](p *T, value T);     //~ ErrorBadExtern:8 "An intrinsic is expanded where it is called"
fn @intrinsic @c readRaw[T](p *T) T;                 //~ ErrorCAttr "leaves no symbol for '@c' to name"
fn @c @intrinsic finalize[T](p *T);                  //~ ErrorCAttr "leaves no symbol for '@c' to name"
