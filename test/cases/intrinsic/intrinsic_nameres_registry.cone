// An '@intrinsic' declaration is checked against the compiler's registry, which
// defines each intrinsic's meaning and so its signature: a name the registry
// does not define is refused, and so is a declaration of a defined name that
// says something else -- other type parameters, other parameters, another
// result, a default value, or a body where the registry gives it no fallback.
// A correct declaration raises nothing, with or without the fallback body its
// entry allows: packages/core declares every intrinsic, in its 'mem', and every
// scenario that does not stand in for core compiles those declarations.
//
// This module is named 'core', which is the one place '@intrinsic' is allowed,
// and it is compiled against an empty core package (see cases.toml) so that the
// registry's own names are free to declare here.

mod core;

// A name the registry does not define, even one letter off
fn @intrinsic sizeOf[T]() usize;                     //~ ErrorIntrinsicName "no intrinsic named sizeOf"

// The type parameters
fn @intrinsic alignof() usize;                       //~ ErrorIntrinsicSig "'fn @intrinsic alignof[T]() usize'"
fn @intrinsic needsFinal[T, U]() Bool;               //~ ErrorIntrinsicSig "'fn @intrinsic needsFinal[T]() Bool'"

// The parameters: a borrowed reference is not a raw pointer, one is missing,
// usize is not u32, and a default value would let a call leave one out
fn @intrinsic finalize[T](p &T);                     //~ ErrorIntrinsicSig "'fn @intrinsic finalize[T](p *T)'"
fn @intrinsic writeRaw[T](p *T);                     //~ ErrorIntrinsicSig "'fn @intrinsic writeRaw[T](p *T, value T)'"
fn @intrinsic sliceFromPartsMut[T](p *T, len u32) &[]mut T;   //~ ErrorIntrinsicSig "sliceFromPartsMut[T](p *T, len usize) &[]mut T"
fn @intrinsic moveRaw[T](to *T, from *T, count usize = 1usize); //~ ErrorIntrinsicSig "moveRaw[T](to *T, from *T, count usize)"

// The result: a pointer is not the value, and a writable slice is not the
// read-only one
fn @intrinsic readRaw[T](p *T) *T;                   //~ ErrorIntrinsicSig "'fn @intrinsic readRaw[T](p *T) T'"
fn @intrinsic sliceFromParts[T](p *T, len usize) &[]mut T;    //~ ErrorIntrinsicSig "sliceFromParts[T](p *T, len usize) &[]T"

// The type record is core's struct of that name, pointed at: a pointer to
// anything else is not it, nor is the struct itself. This core's own
// TypeRecord makes a pointer to it the one accepted
pub struct TypeRecord { pub size usize; }
fn @intrinsic typeRecord[T]() *u8;                   //~ ErrorIntrinsicSig "'fn @intrinsic typeRecord[T]() *TypeRecord'"
struct ByValue {
  fn @intrinsic typeRecord[T]() TypeRecord;          //~ ErrorIntrinsicSig "'fn @intrinsic typeRecord[T]() *TypeRecord'"
}
struct Pointed {
  fn @intrinsic typeRecord[T]() *TypeRecord;
}

// The trace's mode is a u32, what a record's trace is handed too; whether a
// type holds a traced reference is a Bool
fn @intrinsic trace[T](p *T, mode u64);              //~ ErrorIntrinsicSig "'fn @intrinsic trace[T](p *T, mode u32)'"
fn @intrinsic holdsTraced[T]() usize;                //~ ErrorIntrinsicSig "'fn @intrinsic holdsTraced[T]() Bool'"

// traceRoots is the one with no type parameter: giving it one is another
// signature, as leaving one off a generic intrinsic is
fn @intrinsic traceRoots[T](mode u32);               //~ ErrorIntrinsicSig "'fn @intrinsic traceRoots(mode u32)'"

// A body for an intrinsic that has no fallback: nothing in Cone can say how
// large a type is
fn @intrinsic sizeof[T]() usize {                    //~ ErrorIntrinsicBody "sizeof has no fallback body"
  8usize;
}

// A plain struct of core may hold intrinsics as its functions, as core's 'mem'
// does, and its correct declarations raise nothing. A method, taking 'self', is
// not one; nor is a function of a generic type or a trait, which would be
// copied into each instance or implementer
struct Holder {
  fn @intrinsic sizeof[T]() usize;
  fn @intrinsic readRaw[T](p *T) T {*p;}
  fn @intrinsic alignof[T](self &) usize;            //~ ErrorIntrinsicPlace:3 "a module of the core package"
}
struct Wrapped[U] {
  fn @intrinsic sizeof[T]() usize;                   //~ ErrorIntrinsicPlace:3 "a module of the core package"
}
trait Sized {
  fn @intrinsic sizeof[T]() usize;                   //~ ErrorIntrinsicPlace:3 "a module of the core package"
}
