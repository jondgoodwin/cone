// Each intrinsic packages/core declares in its 'mem', run on a range of types,
// called as 'mem.sizeof[T]()' and so on, its results
// printed so the output is the assertion. The values were checked by hand
// against the x86-64 layout: a struct's size includes the padding that makes
// the next one in an array aligned (Pad: u8 at 0, i64 at 8, u8 at 16, padded
// to 24), and its alignment is its strictest field's.
//
// The finalizing intrinsics print from each 'final', so the order of the lines
// is the order of the death: a type's own 'final', then each finalizing field's,
// then the owners its fields hold released -- and nothing at all for a type
// with nothing to finalize, or at a slot written or read raw.
//
// The scenario runs twice (cases.toml): once with the compiler's own lowering
// of every intrinsic, and once with '--intrinsic-fallback', where readRaw and
// moveRaw run the Cone bodies core gives them. The one .out file is the
// assertion that the two agree.

mod intrinsic_success;

import stdio use *;

fn show(label &[]u8, n usize) {
  printStr(label);
  printInt(i64[n]);
  printStr("\n");
}

fn yes(label &[]u8, b Bool) {
  printStr(label);
  if b {printStr(" yes\n");} else {printStr(" no\n");}
}

fn showAll(label &[]u8, p *i64, n usize) {
  printStr(label);
  mut i = 0usize;
  while i < n {
    printStr(" ");
    printInt(*(p + i));
    i = i + 1usize;
  }
  printStr("\n");
}

struct Fin {
  pub v i32;
  fn final(self &uni) { printStr("final "); printInt(i64[v]); printStr("\n"); }
}

struct Pad {
  pub a u8;
  pub b i64;
  pub c u8;
}

struct Pair {
  pub a u8;
  pub b u16;
}

struct Empty {
}

// No final of its own: its finalizing field gives it a drop
struct Plain {
  pub f Fin;
}

// No final and no finalizing field, but an owner to release
struct Owns {
  pub r +so Pad;
}

// Its own final, a finalizing field and an owning field
struct Holder {
  pub f Fin;
  pub r +so Fin;
  pub n i32;
  fn final(self &uni) { printStr("holder final "); printInt(i64[n]); printStr("\n"); }
}

fn sizes() {
  printStr("-- sizeof and alignof\n");
  show("sizeof u8 ", mem.sizeof[u8]());
  show("sizeof i64 ", mem.sizeof[i64]());
  show("sizeof Bool ", mem.sizeof[Bool]());
  show("sizeof Pad ", mem.sizeof[Pad]());
  show("sizeof Pair ", mem.sizeof[Pair]());
  show("sizeof Empty ", mem.sizeof[Empty]());
  show("sizeof *u8 ", mem.sizeof[*u8]());
  show("sizeof &[]u8 ", mem.sizeof[&[]u8]());
  show("sizeof +so Fin ", mem.sizeof[+so Fin]());
  show("alignof u8 ", mem.alignof[u8]());
  show("alignof i64 ", mem.alignof[i64]());
  show("alignof Pad ", mem.alignof[Pad]());
  show("alignof Pair ", mem.alignof[Pair]());
  show("alignof Empty ", mem.alignof[Empty]());
  // What an array of n values needs, which is what sizeof is for
  show("four Pads ", mem.sizeof[Pad]() * 4usize);
}

fn needs() {
  printStr("-- needsFinal\n");
  yes("i64", mem.needsFinal[i64]());
  yes("Pad", mem.needsFinal[Pad]());
  yes("*Fin", mem.needsFinal[*Fin]());
  yes("&Fin", mem.needsFinal[&Fin]());
  yes("Fin", mem.needsFinal[Fin]());
  yes("Plain", mem.needsFinal[Plain]());
  yes("Owns", mem.needsFinal[Owns]());
  yes("Holder", mem.needsFinal[Holder]());
  yes("+so Fin", mem.needsFinal[+so Fin]());
}

fn finals() {
  printStr("-- finalize a value with a final\n");
  imm p = malloc(mem.sizeof[Fin]()) as *Fin;
  mem.writeRaw[Fin](p, Fin[1i32]);
  mem.finalize[Fin](p);

  printStr("-- finalize its own final, a finalizing field, an owning field\n");
  imm h = malloc(mem.sizeof[Holder]()) as *Holder;
  mem.writeRaw[Holder](h, Holder[Fin[2i32], +so Fin[3i32], 4i32]);
  mem.finalize[Holder](h);

  printStr("-- finalize a drop with no final of its own\n");
  imm q = malloc(mem.sizeof[Plain]()) as *Plain;
  mem.writeRaw[Plain](q, Plain[Fin[5i32]]);
  mem.finalize[Plain](q);

  printStr("-- finalize an owning reference: its value dies\n");
  imm r = malloc(mem.sizeof[+so Fin]()) as *(+so Fin);
  mem.writeRaw[+so Fin](r, +so Fin[6i32]);
  mem.finalize[+so Fin](r);

  printStr("-- finalize one of two rc owners: nothing dies yet\n");
  {
    imm a = +rc-imm Fin[7i32];
    imm c = malloc(mem.sizeof[+rc-imm Fin]()) as *(+rc-imm Fin);
    mem.writeRaw[+rc-imm Fin](c, a);
    mem.finalize[+rc-imm Fin](c);
    printStr("the other owner is still here\n");
  }

  printStr("-- finalize a type with nothing to finalize\n");
  imm z = malloc(mem.sizeof[Pad]()) as *Pad;
  mem.writeRaw[Pad](z, Pad[1u8, 2i64, 3u8]);
  mem.finalize[Pad](z);
  printStr("nothing happened\n");
}

fn slices() {
  printStr("-- sliceFromParts\n");
  imm p = malloc(mem.sizeof[i64]() * 4usize) as *i64;
  mem.writeRaw[i64](p, 10i64);
  mem.writeRaw[i64](p + 1usize, 20i64);
  mem.writeRaw[i64](p + 2usize, 30i64);
  mem.writeRaw[i64](p + 3usize, 40i64);
  imm s = mem.sliceFromParts[i64](p, 4usize);
  show("len ", s.len);
  printStr("third ");
  printInt(s[2]);
  printStr("\n");
  imm empty = mem.sliceFromParts[i64](p, 0usize);
  show("empty len ", empty.len);

  printStr("-- sliceFromPartsMut writes through\n");
  imm m = mem.sliceFromPartsMut[i64](p, 4usize);
  m[1] = 25i64;
  showAll("block", p, 4usize);
}

fn raws() {
  printStr("-- writeRaw over a live value finalizes nothing\n");
  imm p = malloc(mem.sizeof[Fin]() * 2usize) as *Fin;
  mem.writeRaw[Fin](p, Fin[21i32]);
  mem.writeRaw[Fin](p, Fin[22i32]);
  printStr("written twice\n");

  printStr("-- a local written raw is moved, not finalized at its scope's end\n");
  {
    imm held = Fin[23i32];
    mem.writeRaw[Fin](p + 1usize, held);
    printStr("scope ends\n");
  }

  printStr("-- readRaw moves each out, and the pointer stays usable\n");
  {
    imm first = mem.readRaw[Fin](p);
    imm second = mem.readRaw[Fin](p + 1usize);
    printInt(i64[first.v + second.v]);
    printStr("\n");
  }

  printStr("-- writeRaw into uninitialized memory releases nothing there\n");
  imm r = malloc(mem.sizeof[+so Fin]()) as *(+so Fin);
  mem.writeRaw[+so Fin](r, +so Fin[24i32]);
  imm back = mem.readRaw[+so Fin](r);
  printInt(i64[back.v]);
  printStr("\n");
}

fn moves() {
  printStr("-- moveRaw\n");
  imm p = malloc(mem.sizeof[i64]() * 5usize) as *i64;
  mut i = 0usize;
  while i < 5usize {
    mem.writeRaw[i64](p + i, i64[i] + 1i64);
    i = i + 1usize;
  }
  showAll("start", p, 5usize);
  mem.moveRaw[i64](p + 1usize, p, 4usize);
  showAll("up one", p, 5usize);
  mem.moveRaw[i64](p, p + 1usize, 4usize);
  showAll("down one", p, 5usize);
  mem.moveRaw[i64](p, p + 2usize, 0usize);
  showAll("none moved", p, 5usize);

  printStr("-- moveRaw finalizes nothing, and each value dies once\n");
  imm a = malloc(mem.sizeof[Fin]() * 2usize) as *Fin;
  imm b = malloc(mem.sizeof[Fin]() * 2usize) as *Fin;
  mem.writeRaw[Fin](a, Fin[31i32]);
  mem.writeRaw[Fin](a + 1usize, Fin[32i32]);
  mem.moveRaw[Fin](b, a, 2usize);
  printStr("moved\n");
  mem.finalize[Fin](b);
  mem.finalize[Fin](b + 1usize);
}

// The intrinsics' own names are this module's to use: core folds only 'mem'
// into it, not each intrinsic in it
fn sizeof(label &[]u8) usize {
  printStr(label);
  3usize;
}
fn finalize() {
  printStr("my own finalize\n");
}

fn main() {
  sizes();
  needs();
  finals();
  slices();
  raws();
  moves();
  printStr("-- names of this module's own\n");
  show(" sizeof ", sizeof("mine,"));
  finalize();
  printStr("-- end\n");
}
