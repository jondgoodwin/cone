// What LLVM is given for core's mem.prefetch on a native target: a call of
// llvm.prefetch, no function of its own, with its address then the constants 0
// (for reading), 3 (high locality) and 1 (the data cache). Its argument is
// evaluated first, as any call's is. On a GPU (SPIR-V) or WebAssembly target
// the hint is dropped: intrinsic_genllvm_prefetch_none.

mod intrinsic_genllvm_prefetch;

fn bump(p: *u32) *u32 {
  mem.writeRaw[u32](p, 7u32);
  p
}

pub fn touch(p: *u32) {
  mem.prefetch[u32](p);
}

pub fn touchAfterEffect(p: *u32) {
  mem.prefetch[u32](bump(p));
}
