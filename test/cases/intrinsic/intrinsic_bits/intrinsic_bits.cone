// An integer's bits, core's mem.countOnes, leadingZeros, trailingZeros,
// rotateLeft, rotateRight, shlMasked and shrMasked, each also a method of every
// integer type. On each integer type: the three counts of 0, 1, all ones, the
// top bit alone and a pattern -- a count of 0's bits is the width, never
// undefined -- and the rotates and masked shifts of a pattern by 0, 1, width - 1,
// width, width + 1, 255 and the largest u32, each amount taken modulo the width;
// a masked right shift is arithmetic on a signed type, logical on an unsigned one.
//
// Each count is printed twice, the method's then mem's, and each rotate and
// masked shift is compared with mem's, so the fallback run (cases.toml), where
// mem's run the Cone bodies core gives them while the methods keep the
// compiler's lowering, checks the two against each other. Every value and
// amount comes through 'opaque', C compiled apart (opaque.c), so the optimized
// runs do the work as the program runs. One .out for the three runs.

mod intrinsic_bits;

import stdio use *;

extern {
  fn @c opaque(n u64) u64;
}

fn counts[T](name &Array[u8], label &Array[u8], x T) {
  printStr(name);
  printStr(" ");
  printStr(label);
  printStr(": ones ");
  printUInt(u64.from(x.countOnes()));
  printStr("/");
  printUInt(u64.from(mem.countOnes(x)));
  printStr(", leading ");
  printUInt(u64.from(x.leadingZeros()));
  printStr("/");
  printUInt(u64.from(mem.leadingZeros(x)));
  printStr(", trailing ");
  printUInt(u64.from(x.trailingZeros()));
  printStr("/");
  printUInt(u64.from(mem.trailingZeros(x)));
  printStr("\n");
}

fn allCounts[T](name &Array[u8], width u64, pattern u64) {
  counts[T](name, "0", T.from(opaque(0u64)));
  counts[T](name, "1", T.from(opaque(1u64)));
  counts[T](name, "all ones", ~T.from(opaque(0u64)));
  counts[T](name, "top bit", T.from(opaque(1u64)) << T.from(opaque(width - 1u64)));
  counts[T](name, "pattern", T.from(opaque(pattern)));
}

// The amount at index i, for a type of the given width
fn amount(width u64, i usize) u32 {
  if i == 0usize {return 0u32;}
  if i == 1usize {return 1u32;}
  if i == 2usize {return u32.from(opaque(width - 1u64));}
  if i == 3usize {return u32.from(opaque(width));}
  if i == 4usize {return u32.from(opaque(width + 1u64));}
  if i == 5usize {return u32.from(opaque(255u64));}
  u32.from(opaque(4294967295u64));
}

// Whether the method and mem's intrinsic agree, said only when they do not
fn agree(same bool) {
  if !same {printStr(" (mem differs)");}
}

fn unsignedMoves[T](name &Array[u8], width u64, x T) {
  mut i = 0usize;
  while i < 7usize {
    imm n = amount(width, i);
    printStr(name);
    printStr(" ");
    printUInt(u64.from(x));
    printStr(" by ");
    printUInt(u64.from(n));
    printStr(": rotl ");
    printUInt(u64.from(x.rotateLeft(n)));
    agree(x.rotateLeft(n) == mem.rotateLeft(x, n));
    printStr(", rotr ");
    printUInt(u64.from(x.rotateRight(n)));
    agree(x.rotateRight(n) == mem.rotateRight(x, n));
    printStr(", shlMasked ");
    printUInt(u64.from(x.shlMasked(n)));
    agree(x.shlMasked(n) == mem.shlMasked(x, n));
    printStr(", shrMasked ");
    printUInt(u64.from(x.shrMasked(n)));
    agree(x.shrMasked(n) == mem.shrMasked(x, n));
    printStr("\n");
    i = i + 1usize;
  }
}

fn signedMoves[T](name &Array[u8], width u64, x T) {
  mut i = 0usize;
  while i < 7usize {
    imm n = amount(width, i);
    printStr(name);
    printStr(" ");
    printInt(i64.from(x));
    printStr(" by ");
    printUInt(u64.from(n));
    printStr(": rotl ");
    printInt(i64.from(x.rotateLeft(n)));
    agree(x.rotateLeft(n) == mem.rotateLeft(x, n));
    printStr(", rotr ");
    printInt(i64.from(x.rotateRight(n)));
    agree(x.rotateRight(n) == mem.rotateRight(x, n));
    printStr(", shlMasked ");
    printInt(i64.from(x.shlMasked(n)));
    agree(x.shlMasked(n) == mem.shlMasked(x, n));
    printStr(", shrMasked ");
    printInt(i64.from(x.shrMasked(n)));
    agree(x.shrMasked(n) == mem.shrMasked(x, n));
    printStr("\n");
    i = i + 1usize;
  }
}

fn main() {
  allCounts[u8]("u8", 8u64, 0x2Cu64);
  allCounts[u16]("u16", 16u64, 0x0B40u64);
  allCounts[u32]("u32", 32u64, 0x00F0F000u64);
  allCounts[u64]("u64", 64u64, 0x0000F0F000000000u64);
  allCounts[usize]("usize", 64u64, 0x0000F0F000000000u64);
  allCounts[i8]("i8", 8u64, 0x2Cu64);
  allCounts[i16]("i16", 16u64, 0x0B40u64);
  allCounts[i32]("i32", 32u64, 0x00F0F000u64);
  allCounts[i64]("i64", 64u64, 0x0000F0F000000000u64);
  allCounts[isize]("isize", 64u64, 0x0000F0F000000000u64);

  unsignedMoves[u8]("u8", 8u64, u8.from(opaque(0xB4u64)));
  unsignedMoves[u16]("u16", 16u64, u16.from(opaque(0xB4C1u64)));
  unsignedMoves[u32]("u32", 32u64, u32.from(opaque(0xB4C1D2E3u64)));
  unsignedMoves[u64]("u64", 64u64, opaque(0xB4C1D2E3F5061728u64));
  unsignedMoves[usize]("usize", 64u64, usize.from(opaque(0xB4C1D2E3F5061728u64)));
  signedMoves[i8]("i8", 8u64, i8.from(opaque(0xB4u64)));
  signedMoves[i16]("i16", 16u64, i16.from(opaque(0xB4C1u64)));
  signedMoves[i32]("i32", 32u64, i32.from(opaque(0xB4C1D2E3u64)));
  signedMoves[i64]("i64", 64u64, i64.from(opaque(0xB4C1D2E3F5061728u64)));
  signedMoves[isize]("isize", 64u64, isize.from(opaque(0xB4C1D2E3F5061728u64)));

  // A literal has them too, and mem's take the type from the argument
  printUInt(u64.from(5u8.countOnes()));
  printStr(" ");
  printUInt(u64.from(mem.trailingZeros(8i32)));
  printStr("\n");
}
