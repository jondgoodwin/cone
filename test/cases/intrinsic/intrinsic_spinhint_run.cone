// mem.spinHint is a hint and changes nothing a program can see. A loop that
// spins until a counter reaches 1000 hints on each pass and ends with the
// counter at 1000 and 1000 passes, as it does without the hint; the hint's own
// call is a statement with no value.

mod intrinsic_spinhint_run;

import stdio use *;

fn main() i32 {
  var n = 0u32;
  var passes = 0u32;
  while n < 1000u32 {
    mem.spinHint();
    n = n + 1u32;
    passes = passes + 1u32;
  }
  printStr("n ");
  printUInt(u64.from(n));
  printStr(" passes ");
  printUInt(u64.from(passes));
  printStr("\n");
  0
}
