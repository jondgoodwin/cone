// The target's OS (TEMPORARY, a provisional mechanism; its final design is
// open) is read from the target triple: each run names a triple, and with
// '-D' the OS it expects that triple to be. 'matched' is called when the one
// constant that holds is the expected one, and 'mismatched' when any constant
// disagrees with what is expected; both conditions are constants, so only
// what the build takes is generated.

mod intrinsic_buildconst_triple;

extern fn matched();
extern fn mismatched();

pub fn check() {
  if (isWindows() && isDefined("EXPECT_WINDOWS")) || (isLinux() && isDefined("EXPECT_LINUX"))
      || (isMacOS() && isDefined("EXPECT_MACOS")) || (isWasm() && isDefined("EXPECT_WASM")) {
    matched();
  }
  if (isWindows() && !isDefined("EXPECT_WINDOWS")) || (!isWindows() && isDefined("EXPECT_WINDOWS"))
      || (isLinux() && !isDefined("EXPECT_LINUX")) || (!isLinux() && isDefined("EXPECT_LINUX"))
      || (isMacOS() && !isDefined("EXPECT_MACOS")) || (!isMacOS() && isDefined("EXPECT_MACOS"))
      || (isWasm() && !isDefined("EXPECT_WASM")) || (!isWasm() && isDefined("EXPECT_WASM")) {
    mismatched();
  }
}
