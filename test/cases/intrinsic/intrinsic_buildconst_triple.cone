// The target's OS (TEMPORARY, a provisional mechanism; its final design is
// open) is read from the target triple: each run names a triple, and with
// '-D' the OS it expects that triple to be. 'matched' is called when the one
// constant that holds is the expected one, and 'mismatched' when any constant
// disagrees with what is expected; both conditions are constants, so only
// what the build takes is generated.

mod intrinsic_buildconst_triple;

extern fn matched();
extern fn mismatched();

pub fn check() {
  if (isWindows() and isDefined("EXPECT_WINDOWS")) or (isLinux() and isDefined("EXPECT_LINUX"))
      or (isMacOS() and isDefined("EXPECT_MACOS")) or (isWasm() and isDefined("EXPECT_WASM")) {
    matched();
  }
  if (isWindows() and !isDefined("EXPECT_WINDOWS")) or (!isWindows() and isDefined("EXPECT_WINDOWS"))
      or (isLinux() and !isDefined("EXPECT_LINUX")) or (!isLinux() and isDefined("EXPECT_LINUX"))
      or (isMacOS() and !isDefined("EXPECT_MACOS")) or (!isMacOS() and isDefined("EXPECT_MACOS"))
      or (isWasm() and !isDefined("EXPECT_WASM")) or (!isWasm() and isDefined("EXPECT_WASM")) {
    mismatched();
  }
}
