// What LLVM is given with '--intrinsic-fallback' (cases.toml): moveRaw and
// readRaw, the two intrinsics core gives a Cone body, run that body expanded in
// place, so moveRaw is a loop of raw reads and writes rather than a block move.
// writeRaw has no body, and keeps its lowering, a store.

mod intrinsic_genllvm_fallback;

fn main() {
  imm p = malloc(sizeof[i64]() * 4usize) as *i64;
  writeRaw[i64](p, 1i64);
  moveRaw[i64](p + 1usize, p, 2usize);
  imm v = readRaw[i64](p + 1usize);
}
