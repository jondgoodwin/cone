// On a GPU (SPIR-V, in its OpenCL and Vulkan forms) and on WebAssembly,
// mem.prefetch is nothing: no llvm.prefetch call or declaration reaches the
// module, which a SPIR-V backend would refuse. The call is dropped but not
// its argument: 'bump', which writes through the pointer it returns, is still
// called before the dropped hint. The same source as intrinsic_genllvm_prefetch.

mod intrinsic_genllvm_prefetch_none;

fn bump(p: *u32) *u32 {
  mem.writeRaw[u32](p, 7u32);
  p
}

pub fn touch(p: *u32) {
  mem.prefetch[u32](p);
}

pub fn touchAfterEffect(p: *u32) {
  mem.prefetch[u32](bump(p));
}
