// What LLVM is given for each intrinsic when the compiler's own lowering is
// used: nothing is a function of its own or a call to one. A size is a
// constant, a raw read a load, a raw write a store, a slice the {pointer,
// length} pair, a move of values one block move; and finalizing a type with
// nothing to finalize generates nothing at all.

mod intrinsic_genllvm_lowering;

struct Pad {
  pub a u8;
  pub b i64;
}

fn main() {
  imm p = malloc(sizeof[Pad]() * 4usize + alignof[Pad]()) as *Pad;
  writeRaw[Pad](p, Pad[1u8, 2i64]);
  moveRaw[Pad](p + 1usize, p, 2usize);
  imm v = readRaw[Pad](p + 1usize);
  imm s = sliceFromParts[Pad](p, 3usize);
  imm m = sliceFromPartsMut[Pad](p, 3usize);
  imm f = needsFinal[Pad]();
  finalize[Pad](p);
}
