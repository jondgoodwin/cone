// An integer's bit intrinsics take an integer type of 8 to 64 bits, and
// nothing else: mem's, called with a float, a bool or a struct, are refused
// where the instance is made, lowered or through the fallback body; and a
// float or a bool has no such methods, which only the integer types have.

mod intrinsic_typecheck_bits;

struct Point {
  pub x: i32;
}

fn main() {
  let a = mem.countOnes(1.5f32);              //~ ErrorIntrinsicType:14 "countOnes acts on a T that is an integer type of 8 to 64 bits, and f32 is not one"
  let b = mem.rotateLeft(true, 1u32);         //~ ErrorIntrinsicType:14 "and bool is not one"
  let c = mem.leadingZeros(new Point(1));     //~ ErrorIntrinsicType:14 "and Point is not one"
  let d = 1.5f32.countOnes();                 //~ ErrorNoMbr:17 "countOnes"
  let e = true.leadingZeros();                //~ ErrorNoMbr:15 "leadingZeros"
}
