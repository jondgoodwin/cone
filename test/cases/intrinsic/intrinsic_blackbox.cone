// mem.blackBox returns what it is given, for an integer, a float, a bool, a
// struct and a pointer-sized value, and a pure function of a boxed value is
// computed every time. Worked out by hand:
// - the boxed integer 7 comes back 7, -42 comes back -42, the float 2.5 comes
//   back 2.5;
// - Pair(7, 0.25) comes back with a = 7 and b = 0.25;
// - f(x) = x * x * x + (x >> 2) of a boxed 3 is 27 + 0 = 27, and of a boxed 10
//   is 1000 + 2 = 1002;
// - ten calls adding f of a boxed 3 add 270.

mod intrinsic_blackbox;

import stdio use *;

struct Pair {
  pub a: i64;
  pub b: f64;
}

fn f(x: i64) i64 { x * x * x + (x >> 2i64) }

fn main() i32 {
  printInt(mem.blackBox(7i64)); printStr("\n");
  printInt(mem.blackBox(-42i64)); printStr("\n");
  printFloat(mem.blackBox(2.5)); printStr("\n");
  printStr(if mem.blackBox(true) { "true\n" } else { "false\n" });
  let p = mem.blackBox(Pair(7i64, 0.25));
  printInt(p.a); printStr(" "); printFloat(p.b); printStr("\n");
  printInt(mem.blackBox(f(mem.blackBox(3i64)))); printStr("\n");
  printInt(mem.blackBox(f(mem.blackBox(10i64)))); printStr("\n");
  var total = 0i64;
  var i = 0i64;
  while i < 10i64 {
    total = total + mem.blackBox(f(mem.blackBox(3i64)));
    i = i + 1i64;
  }
  printInt(total); printStr("\n");
  0
}
