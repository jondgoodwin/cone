// An intrinsic may be declared in a submodule of core, not only in its root:
// the place check asks whether the declaring module is the core package's. This
// compile finds a core laid out as a folder (cases.toml), whose one submodule,
// 'mem', declares 'sizeof'; core's public submodule is folded into this module
// as core's public names are, and the call is a constant.
//
// The real core cannot be laid out this way yet: see refintrinsic.html, "Why
// 'mem' is a struct".

mod intrinsic_nameres_submodule;

fn main() {
  imm n = mem.sizeof[i64]();
}
