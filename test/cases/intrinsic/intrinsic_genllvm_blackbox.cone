// What LLVM is given for core's mem.blackBox after optimization. The result is
// never used and the input is a constant, yet the work stays: the boxed 3 is
// not folded into 'f', and the boxed result is not deleted. Each box is a call
// of an empty asm with a side effect and a memory clobber (no function of its
// own), so the multiplies of 'f' are still there and the constant they would
// fold to, 27, is not.

mod intrinsic_genllvm_blackbox;

fn f(x: i64) i64 { x * x * x + (x >> 2i64) }

fn main() {
  mem.blackBox(f(mem.blackBox(3i64)));
}
