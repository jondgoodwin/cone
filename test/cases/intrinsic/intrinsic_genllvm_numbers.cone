// What LLVM is given for a number's abs, min, max, floor, ceil, round and fma:
// the intrinsic that means each, expanded where it is called, with no function of
// its own. Compiled as a library so the public functions are exported, and read
// in the IR before the optimizer (intrinsic_genllvm_numbers in cases.toml).
//   - a float's abs is llvm.fabs, an integer's llvm.abs told its smallest value
//     is not poison (the second operand false), so it wraps as '-x' does;
//   - min and max of floats are llvm.minnum and llvm.maxnum, the number winning
//     over a NaN; of integers llvm.smin and smax, or umin and umax when unsigned;
//   - round is llvm.round (half away from zero), never roundeven.

mod intrinsic_genllvm_numbers;

pub fn absf(x: f64) f64 { x.abs() }
pub fn absi(x: i32) i32 { x.abs() }
pub fn minf(a: f32, b: f32) f32 { a.min(b) }
pub fn maxf(a: f64, b: f64) f64 { a.max(b) }
pub fn mins(a: i64, b: i64) i64 { a.min(b) }
pub fn maxs(a: i8, b: i8) i8 { a.max(b) }
pub fn minu(a: u32, b: u32) u32 { a.min(b) }
pub fn maxu(a: u16, b: u16) u16 { a.max(b) }
pub fn floord(x: f64) f64 { x.floor() }
pub fn ceilf(x: f32) f32 { x.ceil() }
pub fn roundd(x: f64) f64 { x.round() }
pub fn fmaf(x: f32, y: f32, z: f32) f32 { x.fma(y, z) }
pub fn memabs(x: f64) f64 { mem.abs(x) }
