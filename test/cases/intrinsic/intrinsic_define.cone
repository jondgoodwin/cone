// Constants from conec's command line (TEMPORARY, a provisional mechanism;
// its final design is open): '-D NAME' defines NAME as 1, and '-D NAME=123' as
// that integer, decimal or 0x hex, negative too; a name defined twice takes the
// last. isDefined answers whether a name was defined and definedInt its
// integer, 0 for a name never defined, C's convention for '#if'. Each is a
// constant of the compile, so only the side of an 'if' on one that the build
// takes is generated: SLOW is never defined, and the function its side calls
// is defined nowhere. The runs give every spelling of the option: '-D NAME',
// '-DNAME=v', '--define=NAME=v'.

mod intrinsic_define;

import stdio use *;

extern fn slowDefinedNowhere();

fn show(name &[]u8, defined bool, value i64) {
  printStr(name);
  printStr(if defined {" defined, ";} else {" undefined, ";});
  printInt(value);
  printStr("\n");
}

fn main() {
  show("FAST", isDefined("FAST"), definedInt("FAST"));
  show("LEVEL", isDefined("LEVEL"), definedInt("LEVEL"));
  show("NEG", isDefined("NEG"), definedInt("NEG"));
  show("HEX", isDefined("HEX"), definedInt("HEX"));
  show("ZERO", isDefined("ZERO"), definedInt("ZERO"));
  show("TWICE", isDefined("TWICE"), definedInt("TWICE"));
  show("SLOW", isDefined("SLOW"), definedInt("SLOW"));

  if isDefined("SLOW") {slowDefinedNowhere();} else {printStr("not slow\n");}
  if isDefined("FAST") and !isDefined("SLOW") {printStr("fast\n");}
  // A comparison is known only as it runs, so both sides are generated here
  if definedInt("LEVEL") > 40 {printStr("level above 40\n");}
  imm level = definedInt("LEVEL") + 1;
  printInt(level);
  printStr("\n");
}
