// The target's OS (TEMPORARY, a provisional mechanism; its final design is
// open): isWindows, isLinux, isMacOS and isWasm are constants of the compile,
// read from its target triple with no flag. This scenario runs on Windows and
// on Linux and prints the same on both, so what it treats as the build's own is
// either of those two, and the sides it must not generate are macOS's and
// WebAssembly's, which neither takes. (intrinsic_buildconst_triple pins that
// each triple holds exactly one.)
//
// Only the side of an 'if' on them that the build takes is generated, in a
// debug build as in a release one. Each side not taken calls a function
// declared 'extern' and defined nowhere, so the program links only because no
// call to one, and so no reference to its symbol, reaches the object. Both
// sides are still type checked: what is written there must be valid Cone.

mod intrinsic_buildconst_os;

import stdio use *;

extern fn macDefinedNowhere();
extern fn wasmDefinedNowhere();
extern fn otherDefinedNowhere() i32;

fn pick(n i32) {
  // A condition known only as it runs, then constants: the first generated as
  // a test, the dead one not at all, the 'else' reached from the first's test
  if n > 5 {printStr("n > 5\n");}
  elif isMacOS() {macDefinedNowhere();}
  else {printStr("n <= 5\n");}
}

fn main() {
  // A chain of constants: only the true one's block is generated
  if isMacOS() {macDefinedNowhere(); printStr("macos\n");}
  elif isWasm() {wasmDefinedNowhere();}
  elif isWindows() or isLinux() {printStr("windows or linux\n");}
  else {printStr("none of them\n");}

  // '!', 'and' and 'or' of constants are constants
  if !(isWindows() or isLinux()) or isWasm() {macDefinedNowhere();}
  if (isWindows() or isLinux()) and !isMacOS() {printStr("windows or linux, not macos\n");}

  // A true constant is the 'else' of what follows it
  if isWindows() or isLinux() {printStr("first\n");} elif isMacOS() {macDefinedNowhere();} else {wasmDefinedNowhere();}

  // An 'if' giving a value, its dead side giving one too
  let bits = if isWindows() or isLinux() {64;} else {otherDefinedNowhere();};
  printInt(bits);
  printStr("\n");

  // No side is taken: nothing is generated, and the program goes on
  if isMacOS() {macDefinedNowhere();}

  pick(9);
  pick(2);
}
