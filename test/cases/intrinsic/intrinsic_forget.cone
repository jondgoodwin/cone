// mem.forget ends a value without finalizing it: its 'final' never runs and
// whatever it owns is leaked, and the call generates no code. A value that is
// not forgotten is finalized as usual, once, so the two are told apart by
// what is printed. Worked out by hand, in order:
// - 'forget(Loud(1))' prints nothing at all;
// - 'Loud(2)' bound to a variable and left alone prints "final 2" at the end
//   of its block, before "block done";
// - a generic function forgetting its argument ends it quietly, so nothing is
//   printed for 3, and "after 3" follows at once;
// - the value of a call, forgotten at the statement, prints nothing for 4.

mod intrinsic_forget;

import stdio use *;

struct Loud {
  pub n: i64;
  fn final(self: &uni) {
    printStr("final ");
    printInt(n);
    printStr("\n");
  }
}

fn mk(n: i64) Loud { Loud(n) }

fn drop[T](v: T) { mem.forget[T](v); }

fn main() i32 {
  mem.forget[Loud](Loud(1));
  printStr("after 1\n");
  {
    let b = Loud(2);
    printStr("in block\n");
  }
  printStr("block done\n");
  drop[Loud](Loud(3));
  printStr("after 3\n");
  mem.forget[Loud](mk(4));
  printStr("after 4\n");
  0i32
}
