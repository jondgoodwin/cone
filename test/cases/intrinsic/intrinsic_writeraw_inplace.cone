// 'mem.writeRaw[T](p, new T(...))', where T declares the init the
// construction runs, fills p in place: the init's 'self' is p itself, as an
// allocation's value is made where it was allocated, and as a local's is. So
// an init that uses where its value is sees where the value stays -- an
// actor's init sends to its actor that way (concurrency_actor_init_sends).
// Spot's init notes its own address; each line says whether it was the
// place the value was written to, and the value is read back from there.

mod intrinsic_writeraw_inplace;

import stdio use *;
import libc;

mut seen = 0usize;

struct Spot {
  n i64;

  fn init(self &new, n i64) {
    *self = new Spot(n: n);
    self.note();
  }

  fn note(self &) {
    seen = self as *Spot as usize;
  }
}

fn yes(label &[]u8, b bool) {
  printStr(label);
  if b {printStr(" yes\n");} else {printStr(" no\n");}
}

fn main() {
  imm p = libc.malloc(mem.sizeof[Spot]() * 2usize) as *Spot;
  mem.writeRaw[Spot](p, new Spot(5i64));
  yes("raw write in place", seen == p as usize);
  mem.writeRaw[Spot](p + 1usize, new Spot(7i64));
  yes("second slot in place", seen == (p + 1usize) as usize);
  printInt((*p).n + (*(p + 1usize)).n);
  printStr("\n");
  imm here = new Spot(3i64);
  yes("local in place", seen == &here as *Spot as usize);
  libc.free(p as *u8);
}
