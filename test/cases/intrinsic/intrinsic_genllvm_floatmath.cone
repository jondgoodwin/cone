// What LLVM is given for a float's math methods: LLVM's intrinsic where one exists
// (tan, asin, acos, atan, atan2, exp, exp2, ln as llvm.log, log2, log10, pow, powi,
// sinh, cosh, tanh), so it folds and vectorizes, and the C library's function
// only for hypot and cbrt, which LLVM has no intrinsic for (an f32's cbrt is
// 'cbrtf'; its hypot is the double 'hypot' widened and narrowed, since the UCRT has
// no 'hypotf'). The three tests are comparisons, with no call: isNaN is x != x,
// isInfinite and isFinite compare llvm.fabs with the infinity. Compiled as a library,
// read in the IR before the optimizer (intrinsic_genllvm_floatmath in cases.toml).

mod intrinsic_genllvm_floatmath;

pub fn tand(x: f64) f64 { x.tan() }
pub fn asinf(x: f32) f32 { x.asin() }
pub fn acosd(x: f64) f64 { x.acos() }
pub fn atand(x: f64) f64 { x.atan() }
pub fn atan2f(y: f32, x: f32) f32 { y.atan2(x) }
pub fn expd(x: f64) f64 { x.exp() }
pub fn exp2f(x: f32) f32 { x.exp2() }
pub fn lnd(x: f64) f64 { x.ln() }
pub fn log2f(x: f32) f32 { x.log2() }
pub fn log10d(x: f64) f64 { x.log10() }
pub fn powd(x: f64, y: f64) f64 { x.pow(y) }
pub fn powif(x: f32, n: i32) f32 { x.powi(n) }
pub fn sinhd(x: f64) f64 { x.sinh() }
pub fn coshf(x: f32) f32 { x.cosh() }
pub fn tanhd(x: f64) f64 { x.tanh() }
pub fn hypotd(x: f64, y: f64) f64 { x.hypot(y) }
pub fn hypotf32(x: f32, y: f32) f32 { x.hypot(y) }
pub fn cbrtd(x: f64) f64 { x.cbrt() }
pub fn cbrtf32(x: f32) f32 { x.cbrt() }
pub fn nand(x: f64) bool { x.isNaN() }
pub fn infd(x: f64) bool { x.isInfinite() }
pub fn finf(x: f32) bool { x.isFinite() }
