// What a library makes visible is live, whatever calls it (TEMPORARY, a
// provisional mechanism; its final design is open). Compiled as a library, in a
// debug build and a release one: a 'pub' function is exported, so it is in the
// object though nothing in the library calls it, and so is what it calls; a
// private function only the untaken side of an 'if' on a constant of the build
// reaches, or nothing, is not.

mod intrinsic_buildconst_reach_lib;

extern fn macDefinedNowhere();

// Exported, so emitted, with the call it holds: a program that links this
// library needs what it calls
pub fn exportedCall() {
  macDefinedNowhere();
}

// Private, but reached by an exported function
fn liveHelper() i32 {
  7
}

pub fn exportedUser() i32 {
  liveHelper() + 1
}

// Private, and reached from the dead side alone
fn deadHelper() {
  macDefinedNowhere();
}

// Private, and reached from nowhere
fn unusedHelper() i32 {
  3
}

pub fn exportedChoice() {
  if isMacOS() {deadHelper();}
}
