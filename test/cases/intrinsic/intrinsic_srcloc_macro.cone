// 'srcFile()' and 'srcLine()' written in a macro's body answer where the
// macro is used, not where its body is written, as Rust's 'file!()' and
// 'line!()' do: that is how core's 'assertDebug' names its caller's line. A
// macro used inside another's body answers at the outermost use, named with
// arguments or bare. An argument keeps its own place: a macro passed as one,
// on a line of its own, answers on that line.

mod intrinsic_srcloc_macro;

import stdio use *;

fn show(label &[]u8, file &[]u8, line u32) {
  printStr(label);
  printStr(" = ");
  printStr(file);
  printStr(":");
  printUInt(u64.from(line));
  printStr("\n");
}

macro here[label] {
  show(label, srcFile(), srcLine());
}

macro twice[label, arg] {
  here(label);
  arg;
}

macro bare {
  here("bare");
}

macro outer {
  bare;
}

fn main() {
  show("direct", srcFile(), srcLine());
  here("macro");
  twice("outer",
    here("argument"));
  bare;
  outer;
}
