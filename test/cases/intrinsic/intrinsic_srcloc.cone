// 'srcFile()' and 'srcLine()' answer where the call is written: the source
// file's name, without its folders, and the line. Written as a parameter's
// default value, they answer where each call taking the default is -- each
// call its own line, not the declaration's -- and a value passed explicitly
// replaces the default, as any argument does. In an inline function's body,
// the line is the body's.

mod intrinsic_srcloc;

import stdio use *;

fn show(label &[]u8, file &[]u8, line u32) {
  printStr(label);
  printStr(" = ");
  printStr(file);
  printStr(":");
  printUInt(u64[line]);
  printStr("\n");
}

fn here(label &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) {
  show(label, file, line);
}

fn inlined() inline {
  show("inline-body", srcFile(), srcLine());
}

fn main() {
  show("direct", srcFile(), srcLine());
  here("default");
  here("default-again");
  here("explicit", "elsewhere.cone", 7u32);
  inlined();
}
