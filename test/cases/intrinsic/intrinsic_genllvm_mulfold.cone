// What LLVM is given for core's mem.mulFold when the compiler's own lowering is
// used: no function of its own and no call to one, but both operands extended
// to 128 bits, one multiply, the high half shifted down, and the two halves
// xored. On a 64-bit target that multiply is one instruction.

mod intrinsic_genllvm_mulfold;

fn main() {
  mut a = 0x123456789abcdef0u64;
  mut b = 0xfedcba9876543210u64;
  a = mem.mulFold(a, b);
  b = mem.mulFold(b, a);
}
