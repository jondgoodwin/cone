// What LLVM is given for core's mem.spinHint: on x86 a call of
// llvm.x86.sse2.pause, on AArch64 a call of llvm.aarch64.hint(i32 1), which is
// 'yield'; no function of its own. On a GPU (SPIR-V) or WebAssembly target the
// hint is dropped: intrinsic_genllvm_spinhint_none.

mod intrinsic_genllvm_spinhint;

pub fn spin(p: *u32) {
  while mem.readRaw[u32](p) == 0u32 {
    mem.spinHint();
  }
}
