// Every intrinsic built so far acts on a value of its type argument, or on that
// type's layout, so the type must have a size. One that has none is refused
// where the intrinsic is instantiated for it -- here, not at the declaration in
// core, which is not what is wrong. And an intrinsic has no code of its own, so
// a reference to one cannot be borrowed, as a reference to an inline function
// cannot. Every intrinsic so far is generic, so the borrow names an instance,
// which stands where its type arguments were written.

mod intrinsic_typecheck_class;

struct @opaque Handle {
}

fn main() {
  imm n = mem.sizeof[Handle]();                      //~ ErrorIntrinsicType:21 "sizeof needs a type with a size, and Handle is declared @opaque"
  imm p = malloc(8usize) as *Handle;
  mem.finalize[Handle](p);                           //~ ErrorIntrinsicType:15 "finalize needs a type with a size"
  imm f = &mem.needsFinal[i64];                      //~ ErrorInlineRef:26 "a reference to an intrinsic"
}
