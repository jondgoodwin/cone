// 'srcFile()' is text: a '&str', the source file's name. It is a parameter's
// default whether the parameter is declared '&str' or '&Array[u8]' (any '&str'
// converts to a slice of bytes, so the packages' bytes parameters take it), and
// each call taking the default answers its own place, as for the line.

mod intrinsic_srcfile_text;

import stdio use *;

fn asText(label &str, file &str = srcFile(), line u32 = srcLine()) {
  printStr(label);
  printStr(" = ");
  printStr(file);
  printStr(":");
  printUInt(u64.from(line));
  printStr("\n");
}

fn asBytes(label &str, file &Array[u8] = srcFile(), line u32 = srcLine()) {
  printStr(label);
  printStr(" = ");
  printStr(file as &str);
  printStr(":");
  printUInt(u64.from(line));
  printStr("\n");
}

fn main() {
  imm text &str = srcFile();
  printStr(text);
  printStr(" has ");
  printUInt(u64.from(text.len));
  printStr(" bytes\n");
  imm raw &Array[u8] = srcFile();
  printUInt(u64.from(raw.len));
  printStr("\n");
  asText("text");
  asBytes("bytes");
  asText("explicit", "elsewhere.cone", 7u32);
}
