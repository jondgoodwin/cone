// SIMD vectors, 'Vector[T, N]': N lanes of one number type, one value, held in a
// register and worked on a lane at a time by one operation.
//
// Everything is printed, because a vector operation that compiles is not one that
// puts each lane's answer in its lane. Each fact is a hand-worked value: the
// lanes are chosen so that a wrong order, a wrong width or a signed compare of
// unsigned lanes would print something else. A mask is shown as the 1s and 0s of
// 'Vector[u8, 4].from(mask)', since a mask's lanes are not indexed.
//
// The sections: making one, the operators on floats and on integers (with a
// number beside a vector, assignment forms, shifts past the width), comparisons
// and masks, reductions, math, lanes, and where a vector may stand (parameter,
// return value, field, element, through a reference). Conversions are
// vector_convert's, and what a vector refuses is vector_reject_type's.

mod vector_success;

import stdio use *;

fn showB(label: &str, b: bool) {
  printStr(label);
  printStr(" = ");
  printStr(if b { "true" } else { "false" });
  printStr("\n");
}

fn showI(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label: &str, x: f32) {
  printStr(label);
  printStr(" = ");
  printFloat(f64.from(x));
  printStr("\n");
}

fn showV(label: &str, v: Vector[f32, 4]) {
  printStr(label);
  printStr(" =");
  each i in 0usize ..< 4usize {
    printStr(" ");
    printFloat(f64.from(v[i]));
  }
  printStr("\n");
}

fn showD(label: &str, v: Vector[f64, 2]) {
  printStr(label);
  printStr(" = ");
  printFloat(v[0usize]);
  printStr(" ");
  printFloat(v[1usize]);
  printStr("\n");
}

fn showN(label: &str, v: Vector[i32, 4]) {
  printStr(label);
  printStr(" =");
  each i in 0usize ..< 4usize {
    printStr(" ");
    printInt(i64.from(v[i]));
  }
  printStr("\n");
}

fn showU(label: &str, v: Vector[u8, 4]) {
  printStr(label);
  printStr(" =");
  each i in 0usize ..< 4usize {
    printStr(" ");
    printUInt(u64.from(v[i]));
  }
  printStr("\n");
}

fn showM(label: &str, m: Vector[bool, 4]) {
  showU(label, Vector[u8, 4].from(m));
}

// -------- where a vector may stand --------

struct Body {
  pub id: i32;
  pub pos: Vector[f32, 4];
}

struct Safe is Sendable, Shareable {
  pub lanes: Vector[f32, 4];
  pub mask: Vector[bool, 4];
}

fn twice(v: Vector[f32, 4]) Vector[f32, 4] {
  v + v
}

fn ramp(from: f32) Vector[f32, 4] {
  Vector[f32, 4]() <- from, from + 1.0, from + 2.0, from + 3.0
}

fn bump(v: &mut Vector[i32, 4]) {
  v[1usize] = 99;
  v[2usize] += 1;
}

fn firstLane(v: &Vector[i32, 4]) i32 {
  v[0usize]
}

fn main() {
  // -------- making one --------
  let a = Vector[f32, 4]() <- 1.0, 2.0, 3.0, 4.0;
  showV("list", a);
  let b = Vector[f32, 4]() <- fill 0.5;
  showV("fill", b);
  let rest = Vector[f32, 4]() <- 9.0, 3 of 1.0;
  showV("n of after a value", rest);
  let eights = Vector[f32, 4]() <- 2 of 4.0, fill 8.0;
  showV("n of then fill", eights);
  let three = Vector[i32, 3]() <- 5, 6, 7;
  showI("three lanes sum", i64.from(three.sum()));
  let one = Vector[i32, 1]() <- 42;
  showI("one lane", i64.from(one[0usize]));

  // -------- float operators --------
  showV("a + b", a + b);
  showV("a - b", a - b);
  showV("a * b", a * b);
  showV("a / b", a / b);
  showV("-a", -a);
  showV("a * 2.0", a * 2.0);
  showV("2.0 * a", 2.0 * a);
  showV("10.0 - a", 10.0 - a);
  showV("12.0 / a", 12.0 / a);
  showV("a + 1.0", a + 1.0);
  var acc = a;
  acc += b;
  showV("+=", acc);
  acc *= 2.0;
  showV("*=", acc);
  acc -= 1.0;
  showV("-=", acc);
  acc /= 2.0;
  showV("/=", acc);

  // -------- integer operators --------
  let i = Vector[i32, 4]() <- 7, -7, 100, 5;
  let j = Vector[i32, 4]() <- 2, 2, 7, 3;
  showN("i + j", i + j);
  showN("i - j", i - j);
  showN("i * j", i * j);
  showN("i / j", i / j);
  showN("i % j", i % j);
  showN("i & j", i & j);
  showN("i | j", i | j);
  showN("i ^ j", i ^ j);
  showN("~i", ~i);
  showN("-i", -i);
  showN("i << j", i << j);
  showN("i >> j", i >> j);
  showN("i * 3", i * 3);
  showN("1 << j", 1 << j);

  // A shift by the width or more is 0 in every lane, or the sign for a signed '>>'
  let wide = Vector[i32, 4]() <- 32, 33, 31, 100;
  let ones = Vector[i32, 4]() <- fill 1;
  let negs = Vector[i32, 4]() <- fill -8;
  showN("1 << wide", ones << wide);
  showN("-8 >> wide", negs >> wide);
  let top = Vector[u32, 4]() <- fill 8u32;
  let wideu = Vector[u32, 4]() <- 32u32, 33u32, 3u32, 100u32;
  let shru = top >> wideu;
  showI("u32 8 >> 3", i64.from(shru[2usize]));
  showI("u32 8 >> 32", i64.from(shru[0usize]));

  // Unsigned lanes wrap and compare as unsigned
  let x = Vector[u8, 4]() <- 200u8, 100u8, 255u8, 0u8;
  let y = Vector[u8, 4]() <- 100u8, 200u8, 255u8, 1u8;
  showU("u8 x + y", x + y);
  showM("u8 x > y", x > y);
  showM("u8 x < y", x < y);
  showU("u8 x / y", x / y);

  // -------- comparisons and masks --------
  let half = Vector[f32, 4]() <- fill 2.5;
  let m = a > half;
  let upper = Vector[f32, 4]() <- fill 3.5;
  let n = a < upper;
  showM("a > 2.5", m);
  showM("a < 3.5", n);
  let three4 = Vector[f32, 4]() <- fill 3.0;
  let two4 = Vector[f32, 4]() <- fill 2.0;
  showM("a >= 3.0", a >= three4);
  showM("a <= 2.0", a <= two4);
  showM("a == a", a == a);
  showM("a != b", a != b);
  showM("i < j", i < j);
  showM("m & n", m & n);
  showM("m | n", m | n);
  showM("m ^ n", m ^ n);
  showM("~m", ~m);
  showM("m == n", m == n);
  showM("m != n", m != n);
  showB("m.any()", m.any());
  showB("m.all()", m.all());
  showB("(m | n).all()", (m | n).all());
  showB("(m & ~m).any()", (m & ~m).any());
  showV("select", m.select(a, b));
  showV("select with a number", m.select(a, 0.0));
  showV("select a number first", m.select(1.0, a));
  showN("select ints", (i > j).select(i, j));

  // NaN is not equal to itself, nor less than anything, and unequal to everything
  let zero = Vector[f32, 4]() <- fill 0.0;
  let nan = zero / zero;
  showM("nan == nan", nan == nan);
  showM("nan != nan", nan != nan);
  showM("nan < a", nan < a);

  // -------- reductions --------
  showF("a.sum()", a.sum());
  showF("a.product()", a.product());
  showF("a.min()", a.min());
  showF("a.max()", a.max());
  let mixed = Vector[i32, 4]() <- -5, 3, 7, -9;
  showI("signed min", i64.from(mixed.min()));
  showI("signed max", i64.from(mixed.max()));
  showI("i32 sum", i64.from(mixed.sum()));
  showI("i32 product", i64.from(mixed.product()));
  showI("u8 max", i64.from(x.max()));
  showI("u8 min", i64.from(x.min()));
  showI("u8 sum wraps", i64.from(x.sum()));
  let small = Vector[u8, 4]() <- 3u8, 5u8, 7u8, 9u8;
  showI("u8 product wraps", i64.from(small.product()));
  // A float sum is taken lane by lane in order: ((1e8 + 1) + -1e8) + 1 is 1, where adding
  // the pairs first would give 0
  let order = Vector[f32, 4]() <- 1.0e8, 1.0, -1.0e8, 1.0;
  showF("ordered float sum", order.sum());

  // -------- math --------
  let squares = Vector[f32, 4]() <- 1.0, 4.0, 9.0, 16.0;
  showV("sqrt", squares.sqrt());
  showV("sin 0", zero.sin());
  showV("cos 0", zero.cos());
  let pair = Vector[f64, 2]() <- 2.25, 6.25;
  showD("f64 sqrt", pair.sqrt());
  showD("f64 product", pair * pair);

  // -------- lanes --------
  var w = Vector[i32, 4]() <- fill 0;
  w[2usize] = 9;
  w[1usize] += 3;
  w[3usize] = w[2usize] * 2;
  showN("lanes written", w);
  var k = 0usize;
  var total = 0;
  while k < 4usize {
    total += w[k];
    k += 1usize;
  }
  showI("lanes read in a loop", i64.from(total));
  bump(&mut w);
  showN("through &mut", w);
  showI("through &", i64.from(firstLane(&w)));

  // -------- where a vector stands --------
  showV("parameter and return", twice(ramp(1.0)));
  var body = Body(7, ramp(0.0));
  body.pos = body.pos + ramp(10.0);
  showV("field", body.pos);
  showI("field id", i64.from(body.id));
  var row = Array[Vector[f32, 4], 3]() <- fill ramp(2.0);
  row[1usize] = row[1usize] + ramp(10.0);
  showV("element 1", row[1usize]);
  showV("element 2", row[2usize]);
  let safe = Safe(a, m);
  showV("Sendable field", safe.lanes);
  showM("Sendable mask field", safe.mask);

  // size and alignment are the target's: a vector is aligned as its whole is
  showI("sizeof Vector[f32, 4]", i64.from(mem.sizeof[Vector[f32, 4]]()));
  showI("alignof Vector[f32, 4]", i64.from(mem.alignof[Vector[f32, 4]]()));
  showI("sizeof Vector[f32, 3]", i64.from(mem.sizeof[Vector[f32, 3]]()));
  showI("alignof Vector[f32, 3]", i64.from(mem.alignof[Vector[f32, 3]]()));
  showI("sizeof Vector[f64, 2]", i64.from(mem.sizeof[Vector[f64, 2]]()));
  showI("sizeof Vector[u8, 16]", i64.from(mem.sizeof[Vector[u8, 16]]()));
  showI("sizeof Vector[i32, 8]", i64.from(mem.sizeof[Vector[i32, 8]]()));
  showI("sizeof Body", i64.from(mem.sizeof[Body]()));
  showI("alignof Body", i64.from(mem.alignof[Body]()));
}
