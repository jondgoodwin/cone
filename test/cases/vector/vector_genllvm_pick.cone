// A pick of a join is one shufflevector: the join's two vectors picked from, not a
// join of the two and then a pick of that (vector_genllvm_pick in cases.toml). Alone
// in its file so that the join's own shufflevector, which has eight lanes, is
// known to be absent.

mod vector_genllvm_pick;

pub fn zip4(a: Vector[i32, 4], b: Vector[i32, 4]) Vector[i32, 4] {
  a.join(b).(0, 4, 1, 5)
}
