// An integer vector's '%' is checked as its '/' is: a zero in any lane of the
// divisor is a panic, here for unsigned lanes, 16 of them. The report names the
// line of the remainder.

mod vector_panic_remzero;

import stdio use *;

fn main() {
  let a = Vector[u8, 16]() <- fill 200u8;
  let sevens = Vector[u8, 16]() <- fill 7u8;
  let r = a % sevens;
  printStr("200 % 7 = ");
  printUInt(u64.from(r[15usize]));
  printStr("\n");
  let tail = Vector[u8, 16]() <- 15 of 7u8, 0u8;
  let bad = a % tail;
  printUInt(u64.from(bad[0usize]));
  printStr(" is not reached\n");
}
