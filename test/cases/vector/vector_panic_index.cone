// A lane indexed past the last is a panic reporting the index and the number of
// lanes at the line, as an array's index is. Three lanes: the count is the
// vector's own, not its padded size.

mod vector_panic_index;

import stdio use *;

fn main() {
  var v = Vector[f32, 3]() <- 1.0, 2.0, 3.0;
  var k = 0usize;
  while k < 3usize {
    printFloat(f64.from(v[k]));
    printStr("\n");
    k += 1usize;
  }
  v[k] = 9.0;
  printStr("not reached\n");
}
