// What a vector compiles to: one operation on the whole vector where a scalar has
// one on a number, not one for each lane. Compiled as a library, so that its
// public functions are exported and survive the optimizer, and read in the IR
// before and after it (vector_genllvm in cases.toml). The lane counts are not all
// four: eight i32 lanes are one <8 x i32>, which the target then splits as it must.

mod vector_genllvm;

pub fn add4(a: Vector[f32, 4], b: Vector[f32, 4]) Vector[f32, 4] {
  a + b
}

pub fn mul8(a: Vector[i32, 8], b: Vector[i32, 8]) Vector[i32, 8] {
  a * b
}

pub fn scale4(a: Vector[f32, 4], s: f32) Vector[f32, 4] {
  a * s
}

pub fn less4(a: Vector[f32, 4], b: Vector[f32, 4]) Vector[bool, 4] {
  a < b
}

pub fn pick4(m: Vector[bool, 4], a: Vector[f32, 4], b: Vector[f32, 4]) Vector[f32, 4] {
  m.select(a, b)
}

pub fn sum4(a: Vector[f32, 4]) f32 {
  a.sum()
}

pub fn max4(a: Vector[i32, 4]) i32 {
  a.max()
}

pub fn root4(a: Vector[f32, 4]) Vector[f32, 4] {
  a.sqrt()
}

pub fn quot4(a: Vector[i32, 4], b: Vector[i32, 4]) Vector[i32, 4] {
  a / b
}

pub fn shl4(a: Vector[i32, 4], b: Vector[i32, 4]) Vector[i32, 4] {
  a << b
}

pub fn lane2(a: Vector[f32, 4]) f32 {
  a[2usize]
}

// The number methods are LLVM's intrinsics over the whole vector, the same ones
// a number's are over one lane, and the lane-wise 'min' is not the reduction

pub fn abs4(a: Vector[f32, 4]) Vector[f32, 4] {
  a.abs()
}

pub fn absi4(a: Vector[i32, 4]) Vector[i32, 4] {
  a.abs()
}

pub fn minf4(a: Vector[f32, 4], b: Vector[f32, 4]) Vector[f32, 4] {
  a.min(b)
}

pub fn maxi4(a: Vector[i32, 4], b: Vector[i32, 4]) Vector[i32, 4] {
  a.max(b)
}

pub fn minu8(a: Vector[u8, 16], b: Vector[u8, 16]) Vector[u8, 16] {
  a.min(b)
}

pub fn floor4(a: Vector[f32, 4]) Vector[f32, 4] {
  a.floor()
}

pub fn ceil4(a: Vector[f32, 4]) Vector[f32, 4] {
  a.ceil()
}

pub fn round2(a: Vector[f64, 2]) Vector[f64, 2] {
  a.round()
}

pub fn fma4(a: Vector[f32, 4], b: Vector[f32, 4], c: Vector[f32, 4]) Vector[f32, 4] {
  a.fma(b, c)
}

pub fn rem4(a: Vector[f32, 4], b: Vector[f32, 4]) Vector[f32, 4] {
  a % b
}
