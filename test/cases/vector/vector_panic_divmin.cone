// A signed integer vector's '/' panics when any lane divides the type's smallest
// number by -1, whose quotient does not fit [Jon 28 Oct]. A lane of -1 beside
// another number, and the smallest number beside another divisor, are
// fine: only the pair is refused, and the lanes are checked together. The report
// names the line of the division.

mod vector_panic_divmin;

import stdio use *;

fn main() {
  let least = -2147483647 - 1;
  let a = Vector[i32, 4]() <- 5, 6, 7, 8;
  let down = Vector[i32, 4]() <- fill -1;
  let q = a / down;
  printStr("5 / -1 = ");
  printInt(i64.from(q[0usize]));
  printStr("\n");
  let m = Vector[i32, 4]() <- least, least, 7, 8;
  let twos = Vector[i32, 4]() <- fill 2;
  let h = m / twos;
  printStr("least / 2 = ");
  printInt(i64.from(h[0usize]));
  printStr("\n");
  let divisor = Vector[i32, 4]() <- 1, 1, -1, 1;
  let r = m / divisor;
  printStr("only 7 / -1 = ");
  printInt(i64.from(r[2usize]));
  printStr("\n");
  let both = Vector[i32, 4]() <- 1, -1, 1, 1;
  let bad = m / both;
  printInt(i64.from(bad[0usize]));
  printStr(" is not reached\n");
}
