// An integer vector's '/' panics when any lane of the divisor is zero, as a
// number's does [Jon 28 Oct]: the lanes are checked together before the divide,
// so no lane's quotient is made once one of them cannot be. The report names
// the line of the division. What ran before it printed.

mod vector_panic_divzero;

import stdio use *;

fn main() {
  let a = Vector[i32, 4]() <- 10, 20, 30, 40;
  let ok = Vector[i32, 4]() <- 1, 2, 3, 4;
  let q = a / ok;
  printStr("quotient of lane 3 = ");
  printInt(i64.from(q[3usize]));
  printStr("\n");
  let z = Vector[i32, 4]() <- 1, 1, 0, 1;
  let bad = a / z;
  printInt(i64.from(bad[0usize]));
  printStr(" is not reached\n");
}
