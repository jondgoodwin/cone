// 'Vector[T, N].gather(s, idx)' and 'v.scatter(s, idx)': the lanes at s[idx[0]] ... s[idx[N-1]] for a
// vector of usize indices, in any order and with repeats. Each case below has M = N + 3 data
// numbers, data[i] = 3 * (i + 1), and writes what it computes one number to a line.
//   gather reversed: lane i is data[N-1-i] = 3 * (N - i)
//   gather halves:   lane i is data[i/2] = 3 * (i/2 + 1)
//   gather last:     every lane is data[M-1] = 3 * M (the last place the slice has)
//   scatter reversed: out[N-1-i] = i + 1, so out[j] = N - j for j < N and the rest stay 0
//   scatter repeats: idx[i] = i/2, so out[j] is the value of the highest lane i with i/2 == j,
//                    lane 2j+1 (value 2j+2), for j < N/2, and the rest stay 0
//   round trip: gather the reversal, scatter it through the reversal: the data again
// Lanes of one case print on one line, separated by spaces.

mod vector_gather;

import stdio use *;

fn lanes_i32_4(label: &str, v: Vector[i32, 4]) {
  printStr(label);
  printStr(":");
  each i in 0usize ..< 4usize {
    printStr(" ");
    printInt(i64.from(v[i]));
  }
  printStr("\n");
}

fn whole_i32_4(label: &str, s: &Array[i32, 7]) {
  printStr(label);
  printStr(":");
  each i in 0usize ..< 7usize {
    printStr(" ");
    printInt(i64.from(s[i]));
  }
  printStr("\n");
}

fn case_i32_4() {
  let data: Array[i32, 7] = [3, 6, 9, 12, 15, 18, 21];
  let rev = Vector[usize, 4]() <- 3usize, 2usize, 1usize, 0usize;
  let half = Vector[usize, 4]() <- 0usize, 0usize, 1usize, 1usize;
  let last = Vector[usize, 4]() <- 6usize, 6usize, 6usize, 6usize;
  lanes_i32_4("i32_4 gather reversed", Vector[i32, 4].gather(&data, rev));
  lanes_i32_4("i32_4 gather halves", Vector[i32, 4].gather(&data, half));
  lanes_i32_4("i32_4 gather last", Vector[i32, 4].gather(&data, last));
  let v = Vector[i32, 4]() <- 1, 2, 3, 4;
  var out: Array[i32, 7] = [0, 0, 0, 0, 0, 0, 0];
  v.scatter(&mut out, rev);
  whole_i32_4("i32_4 scatter reversed", &out);
  var out2: Array[i32, 7] = [0, 0, 0, 0, 0, 0, 0];
  v.scatter(&mut out2, half);
  whole_i32_4("i32_4 scatter repeats", &out2);
  var back: Array[i32, 7] = [0, 0, 0, 0, 0, 0, 0];
  Vector[i32, 4].gather(&data, rev).scatter(&mut back, rev);
  whole_i32_4("i32_4 round trip", &back);
}

