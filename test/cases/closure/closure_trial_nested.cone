// A closure written inside another closure's body is built once.
//
// Choosing the outer closure's permissions checks copies of it, as trials
// (closureTry), and each copy's body holds a copy of the inner closure, which
// is built as the copy is checked. Those are the trials': an inner closure's
// hidden struct made inside a trial does not join the module, and the instance
// of 'apply' made for it is taken out of the generic's memo once the trial
// closes, so neither is generated. The program carries the two structs it
// writes, the outer and the inner, and one instance of 'apply': this file's
// checks count them in the IR (each closure's number is the serial the
// compiler gave it; the trials' structs take the numbers between).

mod closure_trial_nested;

import stdio use *;

fn apply[F: fn(x: i64) i64](f: F, x: i64) i64 {
  f(x)
}

fn main() {
  var k = 5i64;
  let g = fn (x: i64) i64 { apply(fn (y: i64) i64 { y + k }, x) };
  printInt(g(3));
  printStr("\n");
  printInt(g(30));
  printStr("\n");
}
