// A closure that fails as an argument of a generic call is reported where it
// failed and nothing more: its call is given up without a second report (it ended
// in "Compiler defect: a request for the name of a node that has none",
// ErrorUnreachable, after the real diagnostics). A closure of the wrong arity for
// a signature bound, and one whose body does not type check.

mod closure_typecheck_cascade;

import collections use *;

fn fillGrid[T, F fn(x i32, y i32) T](out &mut List[T], width usize, f &F) {
  out.push(f(1, 2));
}

fn scaled[F fn(x f32) f32](f &F, x f32) f32 { f(x) * 2. + 1.; }

fn main() {
  mut grid = new List[i32]();
  fillGrid(&mut grid, 4usize, (x) => x);   //~ ErrorClosureParm:32 "This closure takes 1 parameter, and the signature it is given to takes 2"
  imm k = 2.;
  scaled(x => x * k + "a", 3.);            //~ ErrorNoCandidate:21 "No method declared by `+` accepts the call's arguments"
}
