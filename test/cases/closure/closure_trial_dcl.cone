// The same places as closure_typecheck_trial_dcl, with the functions written
// right: a function first reached while a closure is tried is checked there,
// loud, once, and is the one the program calls. Each closure is given to a
// generic's signature bound, an overload set, a trait's method, a closure inside
// a closure, a generic function's instance and a type's static function, and the
// functions are written after main. Every value is worked out by hand, with
// k = 2.5:
// - bound: (3.5 + 1) * 2.5 = 11.25;
// - overload: the one-parameter generic takes it; (3 * 2) * 2.5 = 15;
// - trait: (3.5 - 0.5) * 2.5 = 7.5;
// - nested: the inner closure is given 3.5; (3.5 + 0.5) * 2.5 = 10;
// - generic instance: 3.5 * 2.5 = 8.75;
// - static function: (3.5 * 3) * 2.5 = 26.25.

mod closure_trial_dcl;

import stdio use *;

pub trait Calc {
  pub fn run(self &, x f32) f32;
}

fn viaBound[F fn(f32) f32](f &F, x f32) f32 { f(x) }
fn taperOne[F fn(u f32) f32] overload taper(m i32, f &F) f32 { f(f32.from(m)) }
fn taperTwo[F fn(u f32, v f32) f32] overload taper(m i32, f &F) f32 { f(f32.from(m), 2.f) }
fn viaTrait(c &<Calc, x f32) f32 { c.run(x) }

fn main() {
  let k f32 = 2.5;
  print <- viaBound(fn(u f32) f32 { goodBound(u) * k }, 3.5), "\n";
  print <- taper(3, fn(u f32) f32 { goodOverload(u) * k }), "\n";
  print <- viaTrait(fn(x f32) f32 { goodTrait(x) * k }, 3.5), "\n";
  print <- viaBound(fn(u f32) f32 { viaBound(fn(v f32) f32 { goodNested(v) * k }, u) }, 3.5), "\n";
  print <- viaBound(fn(u f32) f32 { goodGeneric[f32](u) * k }, 3.5), "\n";
  print <- viaBound(fn(u f32) f32 { Late.goodStatic(u) * k }, 3.5), "\n";
}

fn goodBound(x f32) f32 {
  var t f32 = 1.;
  x + t
}

fn goodOverload(x f32) f32 {
  var t f32 = 2.;
  x * t
}

fn goodTrait(x f32) f32 {
  var t f32 = 0.5;
  x - t
}

fn goodNested(x f32) f32 {
  var t f32 = 0.5;
  x + t
}

fn goodGeneric[T](x T) T {
  var y = x;
  y
}

struct Late {
  pub n i32;
  pub fn goodStatic(x f32) f32 {
    var t f32 = 3.;
    x * t
  }
}
