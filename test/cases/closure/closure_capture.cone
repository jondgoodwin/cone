// Capture: a closure literal reading a name from the function that encloses it.
//
// The literal is a value of a struct the compiler writes, and what its body
// names of the code around it is borrowed by that struct. (An anonymous
// function, '&fn(x i32) i32 { ... }', is lifted to module scope as it is parsed
// and sees none of it: it is a function reference, with nothing to hold.)
//
// Nothing is called and there is no 'main': the point is whether this compiles
// at all, so the category is 'compile'. closure_literal runs the values.

mod closure_capture;

fn scaleAll(factor i32, v i32) i32 {
  imm scale = fn(x i32) i32 {x * factor;};
  scale(v);
}
