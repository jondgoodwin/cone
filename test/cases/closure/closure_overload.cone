// A closure literal meeting overloaded callees. It is considered only against
// the overloads whose parameter at its position is callable, so an overload
// taking a number never takes it; among those, the one taking as many
// parameters as the literal writes; and where several remain, the literal
// written with its parameters' types picks exactly. Its body is checked against
// none of them. Every value is worked out by hand.

mod closure_overload;

import stdio use *;

fn taperNum overload taper(m i32, t f32) f32 { f32.from(m) * t; }
fn taperOne overload taper(m i32, t &fn(u f32) f32) f32 { t(f32.from(m)); }
fn taperTwo overload taper(m i32, t &fn(u f32, v f32) f32) f32 { t(f32.from(m), 2.); }

// Two of one parameter count, told apart by the parameter's type
fn byFloat overload scale(m i32, t &fn(u f32) f32) f32 { t(f32.from(m)); }
fn byInt overload scale(m i32, t &fn(u i32) f32) f32 { t(m); }

fn main() {
  print <- taper(2, 0.5), "\n";                      // 2 * 0.5: 1
  print <- taper(2, t => 0.5 + t), "\n";             // one parameter, 0.5 + 2: 2.5
  print <- taper(2, (a, b) => a * b), "\n";          // two parameters, 2 * 2: 4
  // The full form with its types picks exactly
  print <- scale(2, fn(u f32) f32 { u + 0.5; }), "\n";    // 2.5
  print <- scale(2, fn(u i32) f32 { 0.25; }), "\n";       // 0.25
}
