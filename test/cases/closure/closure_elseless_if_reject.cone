// An inferring closure ending in an 'if' with no 'else' where some path gives a value and
// another gives nothing is refused, as a named function is: the message says to add an
// 'else', or to end the line with ';' if the closure returns nothing.

mod closure_elseless_if_reject;

fn say() {}

fn mixed() {
  let f = fn(c: bool) { if c { 5 } };   //~ ErrorTailOpen:25 "gives a value on one path and nothing on the other"
  f(true);
}

// An 'else if' chain with no final 'else' where one arm gives a value
fn chain() {
  let f = fn(c: bool) { if c { 5 } else if !c { say(); } };   //~ ErrorTailOpen:25 "gives a value on one path and nothing on the other"
  f(true);
}
