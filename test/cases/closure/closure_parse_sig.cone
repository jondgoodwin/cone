// Anonymous function signatures the parser cannot accept.
//
// Parse stage only: nothing here reaches name resolution, so no expectation
// below depends on a later phase.
//
// Order matters. Recovery from the missing right parenthesis skips forward
// hunting for one and swallows whatever declaration follows, so the
// declaration whose diagnostic must be reached comes before it.

// A signature is required even where every part of it could be inferred from
// the body
fn noParens() {
  imm f = &fn {1;};          //~ ErrorNoLParen:15 "Expected left parenthesis for parameter declarations"
}

// An unterminated parameter list. This is last because recovery from it skips
// forward to find the parenthesis and consumes the rest of the file.
fn noClose() {
  imm g = &fn(x i32 i32 {x;}  //~ ErrorNoRParen:21 "Expected right parenthesis"
}
