// The parts of an anonymous function's signature that must be types, and are
// not.
//
// Type-check stage, and specifically its first sub-phase: a module type checks
// every declaration's signature before it type checks any body or value
// (module.c). Both diagnostics here come from that first sub-phase; the ones
// that come from bodies are in closure_typecheck_use and closure_typecheck_call.
//
// That split used to be forced, because a signature error anywhere suppressed
// every body diagnostic in the file. modTypeCheck now skips only the declaration
// whose own signature failed, so the split is a matter of subject rather than a
// requirement. core_flow_gate is what pins the current rule.

mod closure_typecheck_sig;

// A parameter needs a type. Nothing infers one from how the body uses it, even
// where the body's only use would fix it.
fn untypedParm() {
  imm f = &fn(x) i32 {x;};   //~ ErrorNoType:15 "Declared name must specify a type or value"
}

// '&fn' with a body is a value, not a type, so it cannot be written where a
// type is expected. This is the one place the two readings of '&fn' -- a
// reference to an anonymous function, and a reference to a function signature
// -- are told apart by whether an implementation follows.
fn implAsType(v i32, h &fn(n i32) i32 {n;}) i32 { //~ ErrorNotTyped:24 "Expected a type"
  h(v);
}
