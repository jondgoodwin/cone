// Generics in an overload set that cannot choose: two bound by the same
// signature, so a callable meets both, a call whose argument no candidate takes
// as a callable, and a callable of a signature none is bound by.

mod closure_typecheck_generic_overload;

fn plain(u f32) f32 { u; }
fn wrongShape(a i32, b i32) i32 { a; }

fn firstOne[F fn(u f32) f32] overload taper(m i32, f &F) f32 { f(1.); }
fn secondOne[G fn(u f32) f32] overload taper(m i32, f &G) f32 { f(2.); }

// A function reference meets both: the error names both
fn ambiguous() {
  taper(2, &plain);              //~ ErrorAmbigCandidate:8 "(`firstOne` and `secondOne`)"
}

// So does a closure literal, which can only be told apart by writing its types
fn ambiguousLiteral() {
  taper(2, t => t);              //~ ErrorClosureOverload:12 "more than one overload of taper (firstOne, secondOne)"
}

// A number is no callable, and no other overload takes it
fn notCallable() {
  taper(2, 0.5);                 //~ ErrorNoCandidate:8 "No function declared by `taper` accepts"
}

// A function of a signature neither is bound by
fn otherSignature() {
  taper(2, &wrongShape);         //~ ErrorNoCandidate:8 "No function declared by `taper` accepts"
}
