// A function type written inside another function type's parameter list,
// '&fn(&fn(u32) u32, u32) u32', is two parameters: a function returning one
// u32, then a u32. It is not one parameter returning two values, so a function
// whose one parameter returns two values is refused wherever that type is
// wanted: by a field, a variable and a parameter.
//
// Type-check stage, body sub-phase: every signature here is well formed.
// closure_fnref_comma is the success side, calling a function of the type as
// it is written.

mod closure_typecheck_comma;

// One parameter: a function returning two values
fn w(f &fn(u32) (u32, u32)) u32 {
  mut a u32;
  mut b u32;
  a, b = f(3u);
  a + b;
}

struct K {
  pub k &fn(&fn(u32) u32, u32) u32;
}

fn take(k &fn(&fn(u32) u32, u32) u32) u32 { 0u; }

fn asField() {
  imm s = new K(&w);   //~ ErrorBadArray:17 "Literal value's type does not match expected field's type"
}

fn asVariable() {
  imm k &fn(&fn(u32) u32, u32) u32 = &w;   //~ ErrorInvType:38 "Initialization value's type does not match variable's declared type"
}

fn asArgument() u32 {
  take(&w);   //~ ErrorInvType:8 "Expression's type does not match declared parameter"
}
