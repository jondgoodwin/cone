// Calls made through a value that holds an anonymous function.
//
// Type-check stage, body sub-phase. Separate from closure-typecheck-use because
// what breaks is different: there the closure does not fit the type it is given
// to, here the closure is fine and the call to it is not.
//
// A call through a closure-typed variable is checked against that closure's
// signature and not against anything the variable's name suggests, so it gets
// the same arity and argument-type diagnostics an ordinary call gets. That is
// the fact worth pinning: the signature survives the binding.

fn tooMany() i32 {
  imm f = &fn(n i32) i32 {n}
  f(1, 2)              //~ ErrorManyArgs:4 "Too many arguments specified"
}

fn tooFew() i32 {
  imm g = &fn(n i32) i32 {n}
  g()                  //~ ErrorFewArgs:4 "requires more arguments than specified"
}

fn wrongArgType() i32 {
  imm h = &fn(n i32) i32 {n}
  h(1.5)               //~ ErrorInvType:5 "Expression's type does not match declared parameter"
}
