// A plain function stands as a callable ('&<fn(sig)', '&<mut fn(sig)', an owner)
// when its signature is a subtype of the callable's, the rule a struct's method
// meets a trait's by (trait_method_variance) and a function reference's signature
// gets: each parameter may be a supertype of the callable's (contravariant) and
// the result a subtype (covariant), where the difference is a recast with no
// run-time conversion. Here a parameter that asks for less permission, a result
// that promises more, a reference to the enum for a reference to the variant, a
// reference to the variant for one to the enum, and a result that holds fewer
// borrows than the callable says it may. The callable's stub passes the values as
// they are, so what runs is checked. closure_typecheck_fnref_variance holds the
// differences that need a conversion, refused.

mod closure_fnref_variance;

import stdio use *;

struct P {
  pub x i32;
}

enum Shape {
  struct Circle { pub r i32; }
  struct Square { pub s i32; }
}

fn readOnly(p &P) i32 { p.x; }                 // asks less than the callable gives
fn plain(p &mut P) i32 { p.x + 1; }            // the callable's own signature
fn same(p &mut P) &mut P { p; }                // gives more than the callable says
fn shapeOf(s &Shape) i32 {                     // the enum for the variant
  match s {
    case let c &Shape.Circle {c.r;}
    case let q &Shape.Square {100 + q.s;}
  }
}
fn circ(c &Shape.Circle) &Shape.Circle { c; }  // the variant for the enum
fn first(a &i64, b &'b i64) &i64 { a; }        // the result holds only a: more than the callable says

fn runA(f &<fn(p &mut P) i32, p &mut P) i32 { f(p); }
fn runMut(f &<mut fn(p &mut P) i32, p &mut P) i32 { f(p); }
fn runB(f &<fn(p &mut P) &P, p &mut P) i32 { f(p).x; }
fn runC(f &<fn(s &Shape.Circle) i32, s &Shape.Circle) i32 { f(s); }
fn runD(f &<fn(c &Shape.Circle) &Shape, c &Shape.Circle) i32 { shapeOf(f(c)); }
fn runE(f &<fn(a &i64, b &i64) &i64, a &i64, b &i64) i64 { *f(a, b); }

fn main() {
  var pt = new P(3);
  let c = Shape.Circle(r: 5);
  let x = 4i64;
  let y = 9i64;
  print <- "permission = ", runA(&readOnly, &mut pt), " ", runA(&plain, &mut pt), " ", runMut(&readOnly, &mut pt), "\n";
  print <- "result = ", runB(&same, &mut pt), "\n";
  print <- "enum for variant = ", runC(&shapeOf, &c), "\n";
  print <- "variant for enum = ", runD(&circ, &c), "\n";
  print <- "lifetime = ", runE(&first, &x, &y), "\n";
}
