// After a '+' in a virtual reference's type go a lifetime bound, '+ 'a', or the
// markers of the value it points at, '+ Sendable', '+ Shareable' and
// '+ ShapeKeeping', in either order. A callable that returns nothing takes them
// straight after its parameters: the '+' is not the start of a return type. Another
// name is refused where it is read: the intersection of other traits is not built.
// (closure_typecheck_shareable has the rest of what a marker may not do; a bare
// signature in brackets takes its markers the same way.)

mod closure_parse_marker;

trait Shape { fn area(self: &) f32; }

fn viaNone(s: &<Shape + Shareable) f32 { s.area() }
fn viaBoth(s: &<Shape + Shareable + Sendable) f32 { s.area() }
fn viaCallable(f: &<fn(x: i32) i32 + Shareable, x: i32) i32 { f(x) }
fn viaVoid(f: &<fn(x: i32) + Shareable, x: i32) { f(x); }
fn viaVoidMut(f: &<mut fn(x: i32) + Sendable + Shareable, x: i32) { f(x); }
fn viaKeeping(f: &<mut fn(x: i32) + ShapeKeeping, x: i32) { f(x); }
fn viaKeepingTrait(s: &<Shape + Shareable + ShapeKeeping) f32 { s.area() }
fn viaOther(s: &<Shape + Debug) f32 { s.area() }     //~ ErrorMarkUse "other traits are not intersected yet"
fn viaAlias(f: &<fn(x: i32) i32 + Shapely, x: i32) i32 { f(x) }   //~ ErrorMarkUse "other traits are not intersected yet"
