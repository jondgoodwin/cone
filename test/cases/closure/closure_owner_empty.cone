// An owner of a callable owns a callable that holds nothing, and a plain function.
// A closure that holds and borrows nothing is a value with no size; the owner
// allocates the smallest block the region gives (one byte) and frees it as it
// frees any, with no special case at its death. A plain function goes in through
// a struct of the compiler's holding the reference to it (a pointer's worth of
// block), called through the owner like any closure. Counted by a region that
// prints the size it is asked for and each free, so that nothing leaks and nothing
// is freed twice: every allocation is freed once.

mod closure_owner_empty;

import stdio use *;
import libc;

var @threadlocal allocs = 0i64;
var @threadlocal frees = 0i64;

struct One is RegionRef, Move {
  fn alloc(size usize) *u8 inline { allocs = allocs + 1; printStr("alloc "); printInt(i64.from(size)); printStr("\n"); malloc(size); }
  fn free(self &uni One) inline { frees = frees + 1; printStr("free\n"); libc.free(self as *u8); }
}

struct Words { pub n i32; }

fn twice(x i32) i32 { x * 2; }
fn loud(inv i32, b &Words) { printInt(inv + b.n); printStr("\n"); }
fn quiet(inv i32, b &Words) {}

struct Holder {
  pub twin Uni[fn(inv i32, b &Words)];
}

fn setTwin(h &mut Holder, f &fn(inv i32, b &Words)) {
  h.twin = new Uni[fn(inv i32, b &Words)](f);
}

fn main() {
  let w = new Words(5);
  {
    // Nothing held: one byte
    let empty = new One[fn(inv i32, b &Words)](fn(inv i32, b &Words) {});
    empty(1, &w);
  }
  {
    // A plain function: the reference to it, a pointer's worth
    let f = new One[fn(x i32) i32](&twice);
    printInt(i64.from(f(21))); printStr("\n");
  }
  {
    // The default "no callback", replaced by a function
    var h = new Holder(new Uni[fn(inv i32, b &Words)](&quiet));
    h.twin(2, &w);
    setTwin(&mut h, &loud);
    h.twin(2, &w);
  }
  {
    // A function shared by counted owners, and a closure that holds nothing
    let shared = new Rc[imm, fn(x i32) i32](&twice);
    let again = shared;
    printInt(i64.from(shared(5) + again(6))); printStr("\n");
    let bare = new Rc[imm, fn(x i32) i32](x => x - 1);
    printInt(i64.from(bare(10))); printStr("\n");
  }
  printInt(allocs); printStr(" "); printInt(frees); printStr("\n");
}
