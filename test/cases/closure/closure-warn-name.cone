// A function written where a value is expected has no use for a name, and the
// parser says so.
//
// This is the whole of WarnName's coverage. parseFn reports it when it is given
// a name without ParseMayName, and the only call site that withholds that flag
// is parseexpr.c's '&fn', which is how an anonymous function is written -- so
// no other group can reach the code.
//
// A warn scenario is compiled and never run, so nothing here is called and
// there is no 'main'. The name is ignored rather than rejected, so the file
// still compiles and exits 0.

// A named function at module scope is what a name is for, and warns about
// nothing
fn triple(x i32) i32 {
  x * 3
}

fn named() {
  // Naming the function in a '&fn' expression: the name is dropped, so the
  // warning is reported at the name and not at the 'fn'
  imm f = &fn square(x i32) i32 {x * x}  //~ WarnName:15 "Unnecessary function name is ignored"

  // The same holds where '&fn' is a type rather than a value: there is no
  // implementation for a name to belong to either
  imm g &fn mapper(x i32) i32 = &fn(x i32) i32 {x}  //~ WarnName:13 "Unnecessary function name is ignored"
}

// An anonymous function is the form that warns about nothing
fn anonymous() {
  imm h = &fn(x i32) i32 {x + 1}
}
