// A package compiled on its own, as a library whose include file declares what
// it exports: a generator is a struct and a method made from its body, which the
// include file does not carry for an importer to make again, so a 'pub'
// generator is refused. One that is not 'pub' stays inside the package.

build: release
output: library

q: {
    "src/q.cone"
}
