// A program that walks the generators of a package compiled on its own. Package
// walks is compiled first (package\walks.conebuild, listed under 'link' in
// cases.toml), and this program is compiled against the include file that compile
// generates, which carries each public generator whole, with the private type and
// function its bodies use declared beside them; the program makes each
// generator's struct again from it. The two objects are linked, with conestd, and
// run.

build: debug
output: executable

import walks: "include/walks.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import walks: "include/walks.cone"
    import stdio: "stdio.cone"
}
