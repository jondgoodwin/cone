mod q;

// A 'pub' generator in a library, a function, a generic one and a method: each
// is exported, and what an importer would need to walk it is not
pub fn count(n i64) yields i64 {          //~ ErrorGenForm:5 "A generator cannot be 'pub' in a library yet"
  mut i = 0i64;
  while i < n {
    yield i;
    i = i + 1i64;
  }
}

pub fn first[T](x T) yields T {           //~ ErrorGenForm:5 "A generator cannot be 'pub' in a library yet"
  yield x;
}

pub struct Span {
  pub lo i64;
  pub hi i64;

  pub fn between(self &) yields i64 {     //~ ErrorGenForm:7 "A generator cannot be 'pub' in a library yet"
    mut i = self.lo;
    while i < self.hi {
      yield i;
      i = i + 1i64;
    }
  }

  // Not 'pub': used inside the package only
  fn inside(self &) yields i64 {
    yield self.lo;
  }

  pub fn sum(self &) i64 {
    mut total = 0i64;
    each v in self.inside() { total = total + v; }
    total;
  }
}

fn private(n i64) yields i64 {
  yield n;
}

pub fn usePrivate() i64 {
  mut total = 0i64;
  each v in private(4i64) { total = total + v; }
  total;
}
