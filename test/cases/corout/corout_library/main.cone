mod prog;

// The program walks the generators of package walks, made again here from its
// include file. Every value printed is worked out by hand from the values put in:
// - count(4): 0 1 2 3;
// - clamped(6, 2, 4): 0 to 5 held between 2 and 4: 2 2 2 3 4 4;
// - items over the array 5 6 7, and over two points (1,2) and (3,4), whose
//   x * 10 + y are 12 and 34;
// - the tree in order: 10 20 30 40 50 60 70, then its values by position:
//   40 20 60 10 30 50 70;
// - a counter at 10 asked for 3: 11 12 13, then 2 more: 14 15;
// - a pair (1, 2) of i64 walked by 'each' as it is: 1 2, and swapped: 2 1; a pair
//   of points (8,9) and (6,7), their y swapped: 7 9.

import stdio use *;
import walks;

struct Pt {
  pub x i64;
  pub y i64;
}

fn num(v i64) {
  printInt(v);
  printStr(" ");
}

fn main() {
  each v in walks.count(4i64) { num(v); }
  printStr("\n");
  each v in walks.clamped(6i64, 2i64, 4i64) { num(v); }
  printStr("\n");

  imm ints Array[i64, 3] = [5i64, 6i64, 7i64];
  each v in walks.items(&ints) { num(*v); }
  printStr("\n");
  imm pts Array[Pt, 2] = [new Pt(1i64, 2i64), new Pt(3i64, 4i64)];
  each p in walks.items(&pts) { num(p.x * 10i64 + p.y); }
  printStr("\n");

  imm tree = new walks.Tree([
    new walks.Node(40i64, 1i64, 2i64),
    new walks.Node(20i64, 3i64, 4i64),
    new walks.Node(60i64, 5i64, 6i64),
    new walks.Node(10i64, -1i64, -1i64),
    new walks.Node(30i64, -1i64, -1i64),
    new walks.Node(50i64, -1i64, -1i64),
    new walks.Node(70i64, -1i64, -1i64)]);
  each n in tree.walk() { num(n.val); }
  printStr("\n");
  each v in tree.vals() { num(v); }
  printStr("\n");

  mut c = new walks.Counter(10i64);
  each v in c.up(3i64) { num(v); }
  each v in c.up(2i64) { num(v); }
  printStr("\n");

  imm pair = new walks.Pair[i64](1i64, 2i64);
  each v in pair { num(*v); }
  each v in pair.swapped() { num(*v); }
  printStr("\n");
  imm ppair = new walks.Pair[Pt](new Pt(8i64, 9i64), new Pt(6i64, 7i64));
  each p in ppair.swapped() { num(p.y); }
  printStr("\n");
}
