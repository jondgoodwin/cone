mod prog;

// What an importer cannot name of package vault, whether or not the include file
// carries it. 'scale' and 'inner' are private and are in the file, because the
// public generator 'outer' names them and an importer makes it again; they are
// still private. 'offset' and 'lonelyFree' are private generators' business, and
// are not in the file at all.

import stdio use *;
import vault;

fn main() {
  printInt(vault.scale(1i64));            //~ ErrorNotPublic:18 "scale is private to its module"
  each v in vault.inner(2i64) { }         //~ ErrorNotPublic:19 "inner is private to its module"
  printInt(vault.offset(1i64));           //~ ErrorUnkName:18 "does not refer to a declared name"
  each v in vault.lonelyFree(3i64) { }    //~ ErrorUnkName:19 "does not refer to a declared name"
}
