mod corout_parameter_names_flow;

// A generator's parameters are held under names no source can spell, and a
// diagnostic about one still reads as the author wrote it: here parameters
// called as Iterator's methods are borrowed across a seam and moved out.

struct Fin {
  pub n i64;
  fn final(self &uni) { }
}

fn take(f Fin) {}

// A borrow of a parameter held by value, used after the seam
fn borrowed(count i64) yields i64 {
  imm r = &count;
  yield 1i64;                             //~ ErrorFrozen:3 "of the parameter 'count'"
  yield *r;
}

// A held parameter moved out
fn moved(map Fin) yields i64 {
  take(map);                              //~ ErrorMoveField:8 "May not move 'map' out of the generator"
  yield 1i64;
}
