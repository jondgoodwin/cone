// A program that walks the public generators of package vault, compiled on its
// own (package\vault.conebuild, listed under 'link' in cases.toml). The include
// file that compile generates, golden in include\vault.cone, carries the public
// generators whole and the private ones they reach, and leaves out the private
// generators nothing public reaches, with the functions only those name.

build: debug
output: executable

import vault: "include/vault.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import vault: "include/vault.cone"
    import stdio: "stdio.cone"
}
