mod prog;

// The program walks the public generators of package vault. Values worked out by
// hand: a ledger of 50 sums offset(50) = 150 from the free generator and
// bonus = 50 / 10 = 5 from the method generator, 155; outer(4) hands on inner(4),
// which yields scale(4) = 12; a tally of 5 walks step = 5 + 1 = 6.

import stdio use *;
import vault;

fn main() {
  imm l = vault.makeLedger(50i64);
  printInt(l.sum()); printStr("\n");
  each v in vault.outer(4i64) { printInt(v); printStr("\n"); }
  imm t = new vault.Tally(5i64);
  each v in t.all() { printInt(v); printStr("\n"); }
}
