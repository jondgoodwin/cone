mod corout_parameter_names;

// A generator holds its parameters in the value it is, which declares
// Iterator and so has all of Iterator's methods ('map', 'count', 'sum', ...).
// A parameter is held under a name no source can spell, so whatever the
// author calls it, it cannot collide with a member of that value: a generator
// may take a parameter called 'count', 'map' or 'next' and be walked, summed and
// counted as any generator is. The same holds for the locals that live across
// a 'yield', and for a local that shadows a parameter. Every value printed is
// worked out by hand from the values put in.
//
// Each of the sixteen generators below takes one i64 parameter, named as a
// method of Iterator or as 'final', and for the parameter p hands out
// i * 10 + p for i = 0 .. p-1. So it yields p values, and their total is
// 10 * (0 + 1 + .. + p-1) + p * p = 5p(p-1) + p*p. 'sum' and 'count' are
// the Iterator methods called on the generator.

import stdio use *;
import collections use *;

fn byNext(next: i64) yields i64 {
  var i = 0i64;
  while i < next { yield i * 10i64 + next; i = i + 1i64; }
}
fn byMap(map: i64) yields i64 {
  var i = 0i64;
  while i < map { yield i * 10i64 + map; i = i + 1i64; }
}
fn byFilter(filter: i64) yields i64 {
  var i = 0i64;
  while i < filter { yield i * 10i64 + filter; i = i + 1i64; }
}
fn byTake(take: i64) yields i64 {
  var i = 0i64;
  while i < take { yield i * 10i64 + take; i = i + 1i64; }
}
fn bySkip(skip: i64) yields i64 {
  var i = 0i64;
  while i < skip { yield i * 10i64 + skip; i = i + 1i64; }
}
fn byFold(fold: i64) yields i64 {
  var i = 0i64;
  while i < fold { yield i * 10i64 + fold; i = i + 1i64; }
}
fn byAny(any: i64) yields i64 {
  var i = 0i64;
  while i < any { yield i * 10i64 + any; i = i + 1i64; }
}
fn byAll(all: i64) yields i64 {
  var i = 0i64;
  while i < all { yield i * 10i64 + all; i = i + 1i64; }
}
fn byZip(zip: i64) yields i64 {
  var i = 0i64;
  while i < zip { yield i * 10i64 + zip; i = i + 1i64; }
}
fn byIndexed(indexed: i64) yields i64 {
  var i = 0i64;
  while i < indexed { yield i * 10i64 + indexed; i = i + 1i64; }
}
fn byCount(count: i64) yields i64 {
  var i = 0i64;
  while i < count { yield i * 10i64 + count; i = i + 1i64; }
}
fn byFind(find: i64) yields i64 {
  var i = 0i64;
  while i < find { yield i * 10i64 + find; i = i + 1i64; }
}
fn bySum(sum: i64) yields i64 {
  var i = 0i64;
  while i < sum { yield i * 10i64 + sum; i = i + 1i64; }
}
fn byMin(min: i64) yields i64 {
  var i = 0i64;
  while i < min { yield i * 10i64 + min; i = i + 1i64; }
}
fn byMax(max: i64) yields i64 {
  var i = 0i64;
  while i < max { yield i * 10i64 + max; i = i + 1i64; }
}
fn byFinal(final: i64) yields i64 {
  var i = 0i64;
  while i < final { yield i * 10i64 + final; i = i + 1i64; }
}

// The generated struct's own bookkeeping names, as parameters: no source can
// write those either
fn bookkeeping(state: i64, sub: i64, item: i64, src: i64) yields i64 {
  yield state;
  yield sub;
  yield item;
  yield src;
}

// Locals living across a yield, named as Iterator's methods
fn locals(limit: i64) yields i64 {
  var count = 0i64;
  var sum = 0i64;
  var map = 1i64;
  let next = limit;
  while count < next {
    sum = sum + count;
    yield sum;
    map = map * 2i64;
    count = count + 1i64;
  }
  yield map;
  yield count;
}

// A parameter named as a method, and a local of an inner block named alike,
// which shadows it there only
fn shadow(count: i64) yields i64 {
  yield count;
  {
    let count = 99i64;
    yield count;
  }
  yield count + 1i64;
}

fn upto(n: i64) yields i64 {
  var i = 0i64;
  while i < n { yield i; i = i + 1i64; }
}

// Parameters named as methods beside an ordinary one, a default value, a
// parameter a closure of the body uses, and a 'yield each' of a sub-generator
// whose own parameter is named alike
fn mixed(n: i64, map: i64, count: i64 = 5i64) yields i64 {
  let add = fn(x: i64) i64 { x + count };
  yield add(n);
  yield each upto(map);
  yield each byCount(2i64);
  yield map * count;
}

// A generic generator with parameters named as methods
fn rep[T](count: usize, find: T) yields T {
  var i = 0usize;
  while i < count {
    yield find;
    i = i + 1usize;
  }
}

// A method with parameters named as methods, on a type that has fields of the
// same names: the parameter shadows the field, as in any method, and
// 'self.count' reaches the field
struct Box {
  pub count: i64;
  pub sum: i64;

  fn walk(self: &, sum: i64, map: i64) yields i64 {
    yield self.count;
    yield sum;
    yield self.sum;
    yield map;
    yield count;
  }
}

fn line(total: i64, n: usize) {
  printStr(" "); printInt(total); printStr(" "); printInt(i64.from(n)); printStr("\n");
}

fn printAll[S: Iterator[i64]](s: &mut S) {
  while true {
    match s.next() {
      case let Some(v) { printInt(v); printStr(" "); }
      case is None { break; }
    }
  }
  printStr("\n");
}

fn main() {
  printStr("next");    var a1 = byNext(1i64);      var b1 = byNext(1i64);      line(a1.sum(), b1.count());
  printStr("map");     var a2 = byMap(2i64);       var b2 = byMap(2i64);       line(a2.sum(), b2.count());
  printStr("filter");  var a3 = byFilter(3i64);    var b3 = byFilter(3i64);    line(a3.sum(), b3.count());
  printStr("take");    var a4 = byTake(4i64);      var b4 = byTake(4i64);      line(a4.sum(), b4.count());
  printStr("skip");    var a5 = bySkip(5i64);      var b5 = bySkip(5i64);      line(a5.sum(), b5.count());
  printStr("fold");    var a6 = byFold(6i64);      var b6 = byFold(6i64);      line(a6.sum(), b6.count());
  printStr("any");     var a7 = byAny(7i64);       var b7 = byAny(7i64);       line(a7.sum(), b7.count());
  printStr("all");     var a8 = byAll(8i64);       var b8 = byAll(8i64);       line(a8.sum(), b8.count());
  printStr("zip");     var a9 = byZip(9i64);       var b9 = byZip(9i64);       line(a9.sum(), b9.count());
  printStr("indexed"); var a10 = byIndexed(10i64); var b10 = byIndexed(10i64); line(a10.sum(), b10.count());
  printStr("count");   var a11 = byCount(11i64);   var b11 = byCount(11i64);   line(a11.sum(), b11.count());
  printStr("find");    var a12 = byFind(12i64);    var b12 = byFind(12i64);    line(a12.sum(), b12.count());
  printStr("sum");     var a13 = bySum(13i64);     var b13 = bySum(13i64);     line(a13.sum(), b13.count());
  printStr("min");     var a14 = byMin(14i64);     var b14 = byMin(14i64);     line(a14.sum(), b14.count());
  printStr("max");     var a15 = byMax(15i64);     var b15 = byMax(15i64);     line(a15.sum(), b15.count());
  printStr("final");   var a16 = byFinal(16i64);   var b16 = byFinal(16i64);   line(a16.sum(), b16.count());

  var bk = bookkeeping(1i64, 2i64, 3i64, 4i64);
  printAll(&mut bk);
  var lc = locals(4i64);
  printAll(&mut lc);
  var sh = shadow(7i64);
  printAll(&mut sh);
  var mx = mixed(1i64, 3i64);
  printAll(&mut mx);
  var mx2 = mixed(1i64, 3i64, 2i64);
  printAll(&mut mx2);
  var rp = rep[i64](3usize, 8i64);
  printAll(&mut rp);
  let box = Box(40i64, 50i64);
  var bw = box.walk(6i64, 7i64);
  printAll(&mut bw);
}
