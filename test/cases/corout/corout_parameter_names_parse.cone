mod corout_parameter_names_parse;

// The parameters of a generator are fields of its struct under names no source
// can spell, so the struct cannot find two alike: the generator's declaration
// refuses a parameter named twice itself.

fn twice(count: i64, count: i64) yields i64 {   //~ ErrorDupName:1 "Duplicate name count"
  yield count;
}

fn once(count: i64, map: i64) yields i64 {
  yield count + map;
}
