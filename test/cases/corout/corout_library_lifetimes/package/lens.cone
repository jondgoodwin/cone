// Package lens' source: two generators, methods of a type that declares a
// lifetime, one lent the receiver and one taking it by value, the first calling
// a private method of the type. The include file carries both whole, and the
// program makes their structs again with the type's lifetime in them.

mod lens;

pub struct Window['a] {
  pub items: &'a Array[i64, 4];
  start: usize;

  fn at(self: &, i: usize) i64 { items[start + i] }

  pub fn firstN(self: &, n: usize) yields i64 {
    var i = 0usize;
    while i < n {
      yield self.at(i);
      i = i + 1usize;
    }
  }

  pub fn first(self) yields i64 {
    yield items[start];
  }
}

pub fn window(items: &Array[i64, 4], start: usize) Window {
  Window(items, start)
}
