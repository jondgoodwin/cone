// A program that walks method generators of a package compiled on its own, of a
// type that declares a lifetime. Package lens is compiled first
// (package\lens.conebuild, listed under 'link' in cases.toml).

build: debug
output: executable

import lens: "include/lens.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import lens: "include/lens.cone"
    import stdio: "stdio.cone"
}
