mod prog;

// The program walks Window.firstN and Window.first of package lens, made again
// here from the include file. The array is 10 20 30 40; the window starts at 1,
// so its three items are 20 30 40, and its first is 20.

import stdio use *;
import lens;

fn main() {
  let items = [10i64, 20i64, 30i64, 40i64];
  let w = lens.window(&items, 1usize);
  each v in w.firstN(3usize) { printInt(v); printStr(" "); }
  each v in w.first() { printInt(v); printStr(" "); }
  printStr("\n");
}
