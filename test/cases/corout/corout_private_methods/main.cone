mod prog;

// What an importer cannot call of the types of package vault. 'step' and 'walk' are
// private methods of Tally and are in the include file, because the public
// generator 'all' calls them and an importer makes it again; they are still
// private. 'lonely' is a private generator method nothing public reaches, and is
// not in the file at all.

import stdio use *;
import vault;

fn main() {
  imm t = new vault.Tally(5i64);
  printInt(t.step());                     //~ ErrorNotPublic:13 "May not access the private method/field `step`"
  each v in t.walk() { }                  //~ ErrorNotPublic:14 "May not access the private method/field `walk`"
  imm l = vault.makeLedger(50i64);
  each v in l.lonely() { }                //~ ErrorNoMbr:14 "not found"
}
