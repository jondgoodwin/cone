// A program compiled against the include file of package vault (the golden file of
// the scenario corout_library_private), naming what vault keeps private.

build: debug
output: executable

import vault: "../corout_library_private/include/vault.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import vault: "../corout_library_private/include/vault.cone"
    import stdio: "stdio.cone"
}
