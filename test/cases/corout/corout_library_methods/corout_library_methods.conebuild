// A program that walks a method generator of a package compiled on its own, a
// package with no generator but that one, in a plain type. Package grids is
// compiled first (package\grids.conebuild, listed under 'link' in cases.toml).

build: debug
output: executable

import grids: "include/grids.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import grids: "include/grids.cone"
    import stdio: "stdio.cone"
}
