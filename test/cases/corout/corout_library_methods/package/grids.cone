// Package grids' source: one generator, a method of a plain type, whose body calls
// a private method of its type and a private method of another type. Nothing else
// in the package is a generator or inline, so it is the method generator alone that
// makes the include file carry those private methods and the other type.

mod grids;

struct Helper {
  k i64;

  fn twice(self &, x i64) i64 { x * 2i64 * k; }
}

pub struct Grid {
  pub w i64;
  h Helper;

  fn cell(self &, i i64) i64 { i * w; }

  pub fn cells(self &, n i64) yields i64 {
    mut i = 0i64;
    while i < n {
      yield self.h.twice(self.cell(i));
      i = i + 1i64;
    }
  }
}

pub fn make(w i64) Grid { new Grid(w, new Helper(10i64)); }
