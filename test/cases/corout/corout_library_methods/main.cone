mod prog;

// The program walks Grid.cells of package grids, made again here from the include
// file. The grid is 3 wide and its helper's k is 10, so cell i is i * 3 and
// twice(cell) is cell * 2 * 10: for i = 0 to 3, 0 60 120 180.

import stdio use *;
import grids;

fn main() {
  imm g = grids.make(3i64);
  each v in g.cells(4i64) { printInt(v); printStr(" "); }
  printStr("\n");
}
