mod corout_typecheck;

// Types a generator is held to: what it yields is the one type it declares,
// and the value it gives is walked by 'next', so generic code asks of it what it
// asks of any cursor. The value is a hidden struct, 'count.Gen' in a message,
// that no source names.

fn count(n i64) yields i64 {
  yield n;
}

fn takesBool[S Iterator[bool]](s &mut S) {
}

fn mismatch() yields i64 {
  yield true;                             //~ ErrorBoolNotNbr:9 "A bool is not a number"
}

// A sub-generator yielding another type than this one's
fn handsOn() yields Pt {
  yield each count(2i64);                 //~ ErrorInvType:3 "does not match declared parameter"
}

fn useIt() {
  mut g = count(2i64);
  takesBool(&mut g);                      //~ ErrorWhereUnmet:12 "count.Gen is not Iterator[bool]"
  imm h = count(3i64);
  h.next();                               //~ ErrorBadPerm:3 "which is not mutable"
}

fn notAnIterator() {
  imm n i64 = count(3i64);                //~ ErrorInvType:20 "does not match"
}

// A function cannot hand a generator back under a declared type: the value is
// the hidden struct, and a trait names no value of a size
fn returnsIt() Iterator[i64] {
                                          //~^ ErrorInvType:24 "This is the declared function's return type" follow-on
  count(2i64);                            //~ ErrorInvType:8 "Return expression type does not match"
}

// A method's yield is held to its type as a function's is
struct Holder {
  pub n i64;

  fn wrong(self &) yields i64 {
    yield true;                           //~ ErrorBoolNotNbr:11 "A bool is not a number"
  }
}

// A generic generator is checked for each instance: it yields an i64, which
// is its T at i64 and not at a struct
struct Pt {
  pub x i64;
}

fn five[T](x T) yields T {
  yield 5i64;                             //~ ErrorInvType:9 "does not match declared parameter"
}

fn instances() {
  each a in five(1i64) { }
  each b in five(new Pt(2i64)) { }
}
