mod corout_typecheck;

// Types a generator is held to: what it yields is the one type it declares,
// and the value it gives is walked by 'next', so generic code asks of it what it
// asks of any cursor. The value is a hidden struct, 'count.Gen' in a message,
// that no source names.

fn count(n i64) yields i64 {
  yield n;
}

fn takesBool[S Iterator[bool]](s &mut S) {
}

fn mismatch() yields i64 {
  yield true;                             //~ ErrorBoolNotNbr:9 "A bool is not a number"
}

// A sub-generator yielding another type than this one's
fn handsOn() yields bool {
  yield each count(2i64);                 //~ ErrorInvType:3 "The value yielded does not match the type the generator yields"
}

fn useIt() {
  mut g = count(2i64);
  takesBool(&mut g);                      //~ ErrorWhereUnmet:12 "count.Gen is not Iterator[bool]"
  imm h = count(3i64);
  h.next();                               //~ ErrorBadPerm:3 "which is not mutable"
}

fn notAnIterator() {
  imm n i64 = count(3i64);                //~ ErrorInvType:20 "does not match"
}
