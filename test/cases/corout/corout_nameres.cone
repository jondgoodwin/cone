mod corout_nameres;

// A generator method's body runs in the struct that is the generator, so a bare
// name of the receiver's type is read as it is in any method only for a field,
// which is reached through the receiver. A bare method name is refused, since
// calling it would need the receiver named: write self.bump(). A local or a
// parameter named like a field shadows it, as in any method.

struct Cursor {
  pub n i64;

  fn bump(self &) i64 { n + 1i64; }

  fn go(self &) yields i64 {
    yield bump();                         //~ ErrorBareMbr:11 "must be reached through self, as self.bump"
  }

  fn go2(self &) yields i64 {
    imm f = bump;                         //~ ErrorBareMbr:13 "must be reached through self, as self.bump"
    yield 1i64;
  }
}
