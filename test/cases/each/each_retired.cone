// The comparison forms of 'each' are retired: a range is written 'a ..< b' (before
// b) or 'a .. b' (through b), and counts down with a negative step. Each retired form
// is refused with the spelling that replaces it, read on as that range so that the loop
// behind it is not reported again; '...' is refused the same way, as no range operator.
// Parse stage. The forms are the ones 'each', 'parallel each' and the drain of '<-' read.

mod each_retired;

fn counting(n i32) {
  each i in 0 < n {          //~ ErrorEachCompare:15 "'each i in a < b' is 'each i in a ..< b'"
  }
  each i in 0 <= n {         //~ ErrorEachCompare:15 "'each i in a <= b' is 'each i in a .. b'"
  }
}

fn counting_down(n i32) {
  each i in n > 0 {          //~ ErrorEachCompare:15 "'each i in a > b' is 'each i in a ..< b by -1'"
  }
  each i in n >= 0 by -1 {   //~ ErrorEachCompare:15 "'each i in a >= b' is 'each i in a .. b by -1'"
  }
}

fn in_parallel(n i32) {
  parallel each i in 0 < n { //~ ErrorEachCompare:24 "a ..< b"
  }
}

fn drained() {
  imm xs = new List[i32] <- each 5 < 8;   //~ ErrorEachCompare:36 "a ..< b"
}

fn ellipsis(n i32) {
  each i in 0 ... n {        //~ ErrorRangeEllipsis:15 "'...' is not a range operator"
  }
}
