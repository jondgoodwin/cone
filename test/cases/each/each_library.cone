// What the library gives 'each' to walk: the methods of lists, arrays and slices
// that name how they are walked, 'zip', and the cursors the collections and text
// already had.
//
// Every value printed is worked out by hand from the values put in.
//
// - 'mutItems': the variable is a '&mut' of each item, so '*x = ...' changes the
//   list, the array or the slice in place, and a slice held through a '&mut'
//   parameter;
// - 'drain': the list gives its values up one at a time, and is empty at once. The
//   variable is the value itself (a Fin, whose death prints, is finalized once as
//   each pass ends); a loop left early by 'break' or 'return' finalizes the rest
//   with the cursor, and 'continue' lets a pass's value go;
// - 'indexed': a position and a borrow, for a list and for an array;
// - 'iter' of an array or a slice, and 'zip' of two lists, ending with the shorter;
// - code generic over the cursors, taking items that move;
// - a match that takes the value out of the Option a call answers;
// - the cursors that were there already, each walked by 'each': a string's chars
//   and char indices, a deque's items, a set's, a dictionary's keys, values,
//   entries and pairs, and an ordered dictionary's.

mod each_library;

import stdio use *;
import collections use *;

fn nl() {
  printStr("\n");
}

fn num(n i64) {
  printInt(n);
  printStr(" ");
}

// Prints "fin<id> " when it dies
struct Fin {
  pub id i32;

  fn final(self &uni) {
    printStr("fin");
    printInt(i64.from(id));
    printStr(" ");
  }
}

fn fins(n i32) List[Fin] {
  mut l = List[Fin].empty();
  mut i = 1i32;
  while i <= n {
    l.push(new Fin(i));
    i = i + 1i32;
  }
  l;
}

fn show(l &List[i64]) {
  each x in l {
    num(*x);
  }
  nl();
}

// -------- mutItems --------

fn bump(s &mut Array[i64]) {
  each x in s.mutItems() {
    *x = *x + 1i64;
  }
}

fn changing() {
  mut l = new List[i64];
  l.push(1i64); l.push(2i64); l.push(3i64);
  each x in l.mutItems() {
    *x = *x * 10i64;
  }
  show(&l);                               // 10 20 30
  show(&l);                               // the list is still whole: 10 20 30

  mut a = [1i64, 2i64, 3i64];
  each x in a.mutItems() {
    *x = *x + 100i64;
  }
  each x in a {
    num(*x);
  }
  nl();                                   // 101 102 103

  bump(&mut a);                           // a slice held through a '&mut' parameter
  each x in a {
    num(*x);
  }
  nl();                                   // 102 103 104

  mut none = new List[i64];
  mut count = 0i64;
  each x in none.mutItems() {
    count = count + 1i64;
  }
  num(count);                             // an empty list has no passes: 0
  nl();

  mut names = new List[String];
  names.push(String.from("ab"));
  names.push(String.from("cde"));
  each s in names.mutItems() {
    s.append("!");                        // a '&mut String', changed in place
  }
  each s in names {
    printStr(s.view());
    printStr(" ");
  }
  nl();                                   // ab! cde!
}

// -------- drain --------

fn draining() {
  mut l = fins(3i32);
  each f in l.drain() {
    printStr("saw");
    printInt(i64.from(f.id));
    printStr(" ");
  }
  printStr("len=");
  printInt(i64.from(l.len));
  nl();                                   // saw1 fin1 saw2 fin2 saw3 fin3 len=0

  l.push(new Fin(7i32));                  // the emptied list is ours again
  printStr("len=");
  printInt(i64.from(l.len));
  nl();                                   // len=1 (fin7 when it dies, at the end)
  l.pop();                                // fin7 here: the value popped is dropped
  nl();
}

fn leftEarly() {
  mut l = fins(4i32);
  each f in l.drain() {
    printStr("saw");
    printInt(i64.from(f.id));
    printStr(" ");
    if f.id == 2i32 { break; }
  }
  printStr("len=");
  printInt(i64.from(l.len));
  nl();                                   // saw1 fin1 saw2 fin2 fin3 fin4 len=0
}

fn skipping() {
  mut l = fins(3i32);
  each f in l.drain() {
    if f.id == 2i32 { continue; }
    printStr("saw");
    printInt(i64.from(f.id));
    printStr(" ");
  }
  nl();                                   // saw1 fin1 fin2 saw3 fin3
}

fn firstBig(l &mut List[Fin]) i32 {
  each f in l.drain() {
    if f.id > 1i32 { return f.id; }
  }
  0i32;
}

fn returning() {
  mut l = fins(3i32);
  imm found = firstBig(&mut l);           // fin1 at the first pass's end, fin2 as it returns, fin3 with the cursor
  num(i64.from(found));
  num(i64.from(l.len));
  nl();                                   // 2 0
}

fn strings() {
  mut names = new List[String];
  names.push(String.from("ab"));
  names.push(String.from("cde"));
  mut total = 0usize;
  mut joined = String.from("");
  each s in names.drain() {               // each String is moved out, not borrowed
    total = total + s.len;
    joined.append(s.view());
  }
  num(i64.from(total));
  num(i64.from(names.len));
  printStr(joined.view());
  nl();                                   // 5 0 abcde
}

// A generic function over any cursor, whose items may move
fn countAll[T, S Iterator[T]](s &mut S) i64 {
  mut n = 0i64;
  each x in s {
    n = n + 1i64;
  }
  n;
}

fn generic() {
  mut l = fins(3i32);
  mut cursor = l.drain();
  num(countAll(&mut cursor));             // fin1 fin2 fin3 as each pass ends, then 3
  nl();
}

// The value a call's Option holds, moved out by a match
fn takeAll() {
  mut l = fins(2i32);
  mut n = 0i32;
  while n < 3i32 {
    match l.pop() {
      case mut s Some {
        imm taken = s.value;
        printStr("took");
        printInt(i64.from(taken.id));
        printStr(" ");
      }
      case is None[Fin] { printStr("none "); }
    }
    n = n + 1i32;
  }
  nl();                                   // took2 fin2 took1 fin1 none
}

// -------- indexed --------

fn positions() {
  mut l = new List[i64];
  l.push(5i64); l.push(7i64); l.push(9i64);
  mut weighted = 0i64;
  each i, x in l.indexed() {
    weighted = weighted + i64.from(i) * *x;
    num(i64.from(i));
  }
  nl();                                   // 0 1 2
  num(weighted);
  nl();                                   // 0*5 + 1*7 + 2*9 = 25

  imm a = [4i64, 3i64];
  each i, x in a.indexed() {
    num(i64.from(i) * 100i64 + *x);
  }
  nl();                                   // 4 103

  each pair in l.indexed() {              // one variable takes the pair whole
    num(i64.from(pair.0) + *pair.1);
  }
  nl();                                   // 5 8 11

  mut it = l.indexed();
  each i, x in it {                       // a cursor kept in a variable is advanced where it is
    if i == 1usize { break; }
  }
  each i, x in it {
    num(i64.from(i));
  }
  nl();                                   // resumes after position 1: 2
}

// -------- iter and zip --------

fn zipping() {
  mut xs = new List[i64];
  xs.push(1i64); xs.push(2i64); xs.push(3i64);
  mut ys = new List[String];
  ys.push(String.from("a"));
  ys.push(String.from("bb"));
  each x, y in zip(&xs, &ys) {
    num(*x);
    printStr(y.view());
    printStr(" ");
  }
  nl();                                   // 1 a 2 bb: the shorter ends it
  each y, x in zip(&ys, &xs) {
    printStr(y.view());
    num(*x);
  }
  nl();                                   // a 1 bb 2

  mut n = 0i64;
  each x, y in zip(&xs, &xs) {
    n = n + *x * *y;
  }
  num(n);                                 // 1 + 4 + 9 = 14
  nl();

  imm empty = new List[i64];
  each x, y in zip(&empty, &xs) {
    num(99i64);
  }
  nl();                                   // nothing
}

fn arrayCursors() {
  imm a = [4i64, 5i64, 6i64];
  each x in a.iter() {
    num(*x);
  }
  nl();                                   // 4 5 6
  mut sum = 0i64;
  mut cursor = a.iter();
  each x in cursor {
    sum = sum + *x;
    if *x == 5i64 { break; }
  }
  each x in cursor {
    sum = sum + *x * 100i64;
  }
  num(sum);                               // 4 + 5, then 6 * 100: 609
  nl();
}

// -------- the cursors that were there --------

fn cursors() {
  mut codes = 0u64;
  each c in "abc".chars() {
    codes = codes + u64.from(c);
  }
  num(i64.from(codes));                   // 97 + 98 + 99 = 294
  nl();

  mut at = 0i64;
  each ci in "aéb".charIndices() {
    at = at * 10i64 + i64.from(ci.offset);
  }
  num(at);                                // byte offsets 0, 1, 3 folded in order: 13
  nl();

  mut d = new Deque[i64];
  d.push(1i64); d.push(2i64); d.pushFront(0i64);
  each x in d.items() {
    num(*x);
  }
  nl();                                   // 0 1 2

  mut s = new Set[i64];
  s.insert(4i64);
  mut sum = 0i64;
  each x in s.iter() {
    sum = sum + *x;
  }
  num(sum);                               // 4
  nl();

  mut dict = new Dict[i64, i64];
  dict.insert(1i64, 10i64);
  dict.insert(2i64, 20i64);
  mut ks = 0i64;
  each k in dict.keys() {
    ks = ks + *k;
  }
  mut vs = 0i64;
  each v in dict.values() {
    vs = vs + *v;
  }
  mut es = 0i64;
  each e in dict.entries() {
    es = es + e.key * e.value;
  }
  mut ps = 0i64;
  each k, v in dict.iter() {
    ps = ps + *k + *v;
  }
  num(ks);                                // 3
  num(vs);                                // 30
  num(es);                                // 10 + 40 = 50
  num(ps);                                // 33
  nl();

  mut od = new OrderedDict[i64, i64];
  od.insert(9i64, 90i64);
  od.insert(8i64, 80i64);
  each k in od.keys() {
    num(*k);                              // 9 8
  }
  each v in od.values() {
    num(*v);                              // 90 80
  }
  each e in od.entries() {
    num(e.key + e.value);                 // 99 88
  }
  each k, v in od.iter() {
    num(*k * *v);                         // 810 640
  }
  nl();
}

fn main() i32 {
  changing();
  draining();
  leftEarly();
  skipping();
  returning();
  strings();
  generic();
  takeAll();
  positions();
  zipping();
  arrayCursors();
  cursors();
  0i32;
}
