// A collection whose items move is consumed by a plain 'each': using it afterwards is
// the move error, and says what to write to keep it. A collection of items that copy
// stays usable.

mod each_consume_flow;

import collections use *;

fn useAfter() {
  var names = List[String]();
  names.push(String.from("a"));
  each n in names {
  }
  let k = names.len;                //~ ErrorMove:11 "write 'each x in &names'"
}

fn dictAfter() {
  var d = Dict[String, String]();
  each k, v in d {
  }
  let n = d.len;                    //~ ErrorMove:11 "write 'each x in &d'"
}

fn copiesStay() {
  var l = List[i64]();
  l.push(1i64);
  each x in l {
  }
  let k = l.len;
}

fn main() i32 { 0i32 }
