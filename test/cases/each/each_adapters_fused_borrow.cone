// A chain over a cursor that lends, 'a.iter().map(f).filter(g).sum()' with a
// closure that borrows 'k', compiled as a library (cases.toml): the optimized IR shows
// one loop over the slice with both closures' bodies inline and no call for any item.
// It is not vectorized: the cursor's 'next' answers an Option of a borrow, which is a
// pointer that is null for None, and the test for it stays in the loop (a hand-written
// 'while' over 'a.iter().next()' is the same shape). A cursor that gives numbers is
// vectorized (each_adapters_fused).

mod each_adapters_fused_borrow;

pub fn sumBorrowed(a &Array[i64], k i64) i64 {
  a.iter().map(x => *x * k).filter(y => *y > 3i64).sum();
}
