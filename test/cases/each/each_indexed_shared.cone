// The shared 'indexed()' every cursor declaring 'is Iterator[T]' has: its item is a tuple of
// the position (a usize, counted from 0 as the cursor is walked) and what the cursor gives,
// and 'each i, x in it.indexed()' unpacks it. A list, an array, a slice, chunks, mutItems
// and a zip keep the 'indexed' of their own (the counted loop or the cursor that numbers
// its own kind of item); this is the one for every other cursor: a lending one, a
// generator, a chain, a cursor of one's own, a deque's.
//
// A cursor that lends (its 'next' names no lifetime, so an item is a borrow of the cursor
// and gone at the next step) still lends once numbered: the item's borrow is inside the
// tuple (each_indexed_shared_refused refuses every use that would keep it).
//
// Every value is worked out by hand; xs is 5 10 15 20 25 30.

mod each_indexed_shared;

import stdio use *;
import collections use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn line(i usize, v i64) {
  printStr("  ");
  printInt(i64.from(i));
  printStr(": ");
  printInt(v);
  printStr("\n");
}

// A lending cursor: each item is a borrow of the field 'cur', rewritten by the next step
struct Reader is Iterator[&i64] {
  cur i64;
  n i64;

  pub fn next(self &mut) Option[&i64] {
    if n <= 0i64 { return None; }
    cur = n * 10i64;
    n = n - 1i64;
    Some[&i64](&cur);
  }
}

// A cursor of one's own that does not lend
struct Countdown is Iterator[i64] {
  n i64;

  pub fn next(self &mut) Option[i64] {
    if n <= 0i64 { return None; }
    imm v = n;
    n = n - 1i64;
    Some[i64](v);
  }
}

// Generators: one yielding numbers, one yielding borrows of the list it is lent
fn upto(top i64) yields i64 {
  each i in 1i64 .. top { yield i; }
}

fn items(xs &List[i64]) yields &i64 {
  each x in xs { yield x; }
}

fn firstAtLeast(top i64, wanted i64) i64 {
  each i, v in upto(top).indexed() {
    if v >= wanted { break i64.from(i); }
  } else {
    -1i64;
  }
}

fn main() {
  mut xs = new List[i64];
  each i in 1i64 .. 6i64 { xs.push(i * 5i64); }

  // a lending cursor: Reader(0, 3) gives 30 20 10, numbered 0 1 2
  printStr("reader\n");
  each i, x in new Reader(0i64, 3i64).indexed() { line(i, *x); }          // 0: 30   1: 20   2: 10

  // a generator of numbers: 1 2 3 4 with the positions 0 1 2 3; each pass folds i * 10 + v
  // into the number as two digits (0*10+1, 1*10+2, 2*10+3, 3*10+4)
  mut s = 0i64;
  each i, v in upto(4i64).indexed() { s = s * 100i64 + i64.from(i) * 10i64 + v; }
  show("generator", s);                                                       // 1122334

  // a generator of borrows of xs: sum of position * value
  mut t = 0i64;
  each i, x in items(&xs).indexed() { t += i64.from(i) * *x; }
  show("generator of borrows", t);                // 0*5 + 1*10 + 2*15 + 3*20 + 4*25 + 5*30 = 350

  // the positions are those of the cursor it wraps, so after a filter they count what is
  // left: map gives 10 20 30 40 50 60, filter keeps 30 40 50 60, positions 0 1 2 3
  mut u = 0i64;
  each i, y in xs.iter().map(x => *x * 2i64).filter(y => *y > 20i64).indexed() {
    u += i64.from(i) * y;
  }
  show("map filter", u);                                         // 0*30 + 1*40 + 2*50 + 3*60 = 320

  // skip and take: 15 20 25 numbered 0 1 2
  mut w = 0i64;
  each i, y in xs.iter().map(x => *x).skip(2usize).take(3usize).indexed() { w += i64.from(i) * y; }
  show("skip take", w);                                                       // 0 + 20 + 50 = 70

  // a list's own cursor numbered before a filter: the positions are the original ones,
  // 0 2 4 kept, with the values 5 15 25
  show("indexed then filter, values",
    xs.iter().indexed().filter(p => p.0 % 2usize == 0usize).map(p => *p.1).sum());   // 45
  show("indexed then filter, positions",
    xs.iter().indexed().filter(p => p.0 % 2usize == 0usize).map(p => i64.from(p.0)).sum());   // 6

  // the terminal methods on the numbered cursor
  show("count", i64.from(xs.iter().indexed().count()));                       // 6
  show("fold", xs.iter().indexed().fold(0i64, (acc, p) => acc + i64.from(p.0) * *p.1));   // 350
  show("count none", i64.from(xs.iter().skip(9usize).indexed().count()));     // 0

  // a lending cursor through a filter then numbered: Reader(0, 4) gives 40 30 20 10,
  // the filter keeps 40 30 20
  mut r = 0i64;
  each i, x in new Reader(0i64, 4i64).filter(y => **y > 15i64).indexed() { r += i64.from(i) * *x; }
  show("lending filter", r);                                              // 0*40 + 1*30 + 2*20 = 70

  // a cursor of one's own: Countdown(4) gives 4 3 2 1
  mut c = 0i64;
  each i, v in new Countdown(4i64).indexed() { c += i64.from(i) * v; }
  show("own cursor", c);                                                      // 0 + 3 + 4 + 3 = 10

  // a numbered cursor numbered again: Countdown(3) gives 3 2 1, the outer position i and the
  // pair (inner position, value); each pass adds i * 100 + p.0 * 10 + p.1
  mut tw = 0i64;
  each i, p in new Countdown(3i64).indexed().indexed() {
    tw += i64.from(i) * 100i64 + i64.from(p.0) * 10i64 + p.1;
  }
  show("indexed twice", tw);                                    // 3 + (100 + 10 + 2) + (200 + 20 + 1) = 336

  // a deque's cursor: 2 4 8
  mut dq = new Deque[i64];
  dq.push(4i64); dq.push(8i64); dq.pushFront(2i64);
  mut d = 0i64;
  each i, x in dq.items().indexed() { d += i64.from(i) * *x; }
  show("deque", d);                                                           // 0 + 4 + 16 = 20

  // the position of the first value of at least 6 in 1 2 3 ...: 6 is at 5; none reaches 99
  show("break value", firstAtLeast(9i64, 6i64));                              // 5
  show("else value", firstAtLeast(9i64, 99i64));                              // -1

  // the numbered cursor is itself a cursor: its items map and filter, and a cursor kept in a
  // variable carries on from where 'each' left it (positions go on counting)
  mut it = new Countdown(5i64).indexed();
  each i, v in it { if i == 1usize { break; } }                               // 5 4: stops after 4
  mut rest = 0i64;
  each i, v in it { rest = rest * 100i64 + i64.from(i) * 10i64 + v; }      // 3 2 1 numbered 2 3 4
  show("carry on", rest);                                   // (2*10+3) (3*10+2) (4*10+1) = 233241
}
