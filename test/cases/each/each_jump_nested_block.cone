// A 'return' ending a plain block in an 'each' loop's body ends the path
// there: neither the branch's jump to its 'if''s end nor the loop's step and
// jump back is generated after it. Once they were, in the same basic block,
// LLVM dropped the 'return', and the loop ran on to its end. In an 'if' in
// the body, and as the body's last statement; beside each, a loop that runs
// out, so the run shows both.

mod each_jump_nested_block;

import stdio use *;

fn show(label: &str, n: i32) {
  printStr(label);
  printStr(" = ");
  printInt(i64.from(n));
  printStr("\n");
}

fn inIf(stop: i32) i32 {
  each i in 0 ..< 10 {
    if i == stop { { return i * 10; } }
  }
  -1
}

fn inIfFixed() i32 {
  each i in 0 ..< 10 {
    if i == 4 { { return i * 10; } }
  }
  0
}

fn lastStmt(n: i32) i32 {
  var seen = 0;
  each i in 3 ..< n {
    seen = seen + 1;
    { return i * 100 + seen; }
  }
  seen
}

fn main() i32 {
  show("each-if", inIf(4));
  show("each-if-runs-out", inIf(20));
  show("each-if-constant", inIfFixed());
  show("each-body", lastStmt(9));
  show("each-body-not-entered", lastStmt(3));
  0
}
