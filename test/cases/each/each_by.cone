// minBy, maxBy, minByKey, maxByKey on a cursor: the item an order (or a key) puts first or last.
// Which of several tied items wins is Rust's: minBy and minByKey answer the FIRST of the items
// that tie for least, maxBy and maxByKey the LAST of those that tie for greatest.
//
// ps is six points, written (key, id): (3,0) (1,1) (2,2) (1,3) (3,4) (2,5).
// - least key 1 is tied by ids 1 and 3: the first is id 1.
// - greatest key 3 is tied by ids 0 and 4: the last is id 4.
// - under the reversed order (b before a), the least is the greatest key: the first of 3 is id 0,
//   and the greatest is the least key: the last of key 1 is id 3.
// vs is 4 -4 2 -2 3, with the key 'absolute value' 4 4 2 2 3:
// - least key 2 is tied by 2 and -2: the first is 2; greatest key 4 by 4 and -4: the last is -4.
// fs is 2.5 0.5 1.5: least 0.5, greatest 2.5.

mod each_by;

import stdio use *;
import collections use *;

struct Pt {
  pub k: i64;
  pub id: i64;
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// The id of the point found, or -1 for none (a lending cursor gives &Pt)
fn idOf(label: &str, found: Option[&Pt]) {
  match found {
    case let Some(p) { show(label, p.id); }
    case is None { show(label, -1i64); }
  }
}

fn showOpt(label: &str, o: Option[i64]) {
  match o {
    case let Some(v) { show(label, v); }
    case is None { printStr(label); printStr(" = none\n"); }
  }
}

fn byK(a: &&Pt, b: &&Pt) i32 { a.k <=> b.k }

fn main() {
  var ps = List[Pt]();
  ps.push(Pt(3i64, 0i64)); ps.push(Pt(1i64, 1i64)); ps.push(Pt(2i64, 2i64));
  ps.push(Pt(1i64, 3i64)); ps.push(Pt(3i64, 4i64)); ps.push(Pt(2i64, 5i64));

  // by an order, on a cursor that lends
  idOf("minBy", ps.iter().minBy((a, b) => a.k <=> b.k));                         // 1
  idOf("maxBy", ps.iter().maxBy((a, b) => a.k <=> b.k));                         // 4
  idOf("minBy reversed", ps.iter().minBy((a, b) => b.k <=> a.k));                // 0
  idOf("maxBy reversed", ps.iter().maxBy((a, b) => b.k <=> a.k));                // 3
  idOf("minBy function", ps.iter().minBy(&byK));                                 // 1
  idOf("maxBy function", ps.iter().maxBy(&byK));                                // 4

  // by a key
  idOf("minByKey", ps.iter().minByKey(p => p.k));                                // 1
  idOf("maxByKey", ps.iter().maxByKey(p => p.k));                                // 4


  // numbers by value, with a key of absolute value
  var vs = List[i64]();
  vs.push(4i64); vs.push(-4i64); vs.push(2i64); vs.push(-2i64); vs.push(3i64);
  showOpt("minByKey abs", vs.iter().map(x => *x).minByKey(x => if *x < 0i64 { -*x } else { *x }));   // 2
  showOpt("maxByKey abs", vs.iter().map(x => *x).maxByKey(x => if *x < 0i64 { -*x } else { *x }));   // -4
  showOpt("minBy plain", vs.iter().map(x => *x).minBy((a, b) => *a <=> *b));     // -4
  showOpt("maxBy plain", vs.iter().map(x => *x).maxBy((a, b) => *a <=> *b));     // 4

  // a float key
  var fs = List[f64]();
  fs.push(2.5); fs.push(0.5); fs.push(1.5);
  match fs.iter().map(x => *x).minByKey(x => *x) {
    case let Some(v) { printFloat(v); printStr("\n"); }                          // 0.5
    case is None { printStr("none\n"); }
  }
  match fs.iter().map(x => *x).maxByKey(x => *x) {
    case let Some(v) { printFloat(v); printStr("\n"); }                          // 2.5
    case is None { printStr("none\n"); }
  }

  // none for no items, the one item for one
  showOpt("minBy empty", vs.iter().map(x => *x).skip(5usize).minBy((a, b) => *a <=> *b));            // none
  showOpt("maxBy empty", vs.iter().map(x => *x).skip(5usize).maxBy((a, b) => *a <=> *b));            // none
  showOpt("minByKey empty", vs.iter().map(x => *x).skip(5usize).minByKey(x => *x));                  // none
  showOpt("maxByKey empty", vs.iter().map(x => *x).skip(5usize).maxByKey(x => *x));                  // none
  showOpt("minBy one", vs.iter().map(x => *x).skip(4usize).minBy((a, b) => *a <=> *b));              // 3
  showOpt("maxByKey one", vs.iter().map(x => *x).skip(4usize).maxByKey(x => *x));                    // 3
}
