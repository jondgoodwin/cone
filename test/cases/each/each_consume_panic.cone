// A panic inside an 'each' that consumes its source ends the program as any panic does:
// what was printed is kept, and nothing after the call runs, not the finalizers of the
// items the loop had not reached either.

mod each_consume_panic;

import stdio use *;
import collections use *;

struct Noisy {
  pub n: i32;
  fn final(self: &uni) {
    printStr("final\n");
  }
}

fn main() {
  var l = List[Noisy]();
  l.push(Noisy(1));
  l.push(Noisy(2));
  each x in l {
    printStr("pass\n");
    if x.n == 1 { panic("inside the loop"); }
  }
  printStr("after\n");
}
