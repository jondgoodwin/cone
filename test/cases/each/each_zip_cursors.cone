// A zip of cursors: 'a.mutChunks(n).zip(b.mutChunks(3 * n))' (the method every
// cursor that is an Iterator has, which takes the other cursor by value), walked by a
// plain 'each', numbered by 'indexed()' (three variables: the position and one item from
// each source), and, when both sources can be walked by position, measured and indexed
// itself ('len', 'at': RandomAccess, as Rayon's zip). What each lends is what its own
// source lends.
//
// Each case prints what it saw; the numbers are worked out in the comments.

mod each_zip_cursors;

import stdio use *;
import collections use *;

fn show(label &str, n u64) {
  printStr(label);
  printStr(" = ");
  printUInt(n);
  printStr("\n");
}

fn main() {
  mut a = new List[u32];
  mut b = new List[u32];
  each i in 0usize < 10usize { a.push(0u32); }
  each i in 0usize < 30usize { b.push(0u32); }

  // a in chunks of 2 (5 of them), b in chunks of 6 (5): two outputs in one loop
  each ra, rb in a.mutChunks(2usize).zip(b.mutChunks(6usize)) {
    ra[0usize] = 1u32;
    rb[0usize] = 2u32;
    rb[5usize] = 3u32;
  }
  show("a ones", u64.from(*a[0usize] + *a[2usize] + *a[8usize] + *a[9usize]));    // 1 + 1 + 1 + 0 = 3
  show("b marks", u64.from(*b[0usize] + *b[5usize] + *b[24usize] + *b[29usize])); // 2 + 3 + 2 + 3 = 10

  // numbered: three variables, the position counted from 0
  each y, ra, rb in a.mutChunks(2usize).zip(b.mutChunks(6usize)).indexed() {
    ra[1usize] = u32.from(y);
    rb[1usize] = u32.from(y) * 10u32;
  }
  show("a numbers", u64.from(*a[1usize] + *a[3usize] + *a[9usize]));              // 0 + 1 + 4 = 5
  show("b numbers", u64.from(*b[1usize] + *b[13usize] + *b[25usize]));            // 0 + 20 + 40 = 60

  // the shorter ends it: chunks of 4 of 10 (3 of them) beside chunks of 2 of 30 (15)
  mut passes = 0u64;
  each c, d in a.chunks(4usize).zip(b.mutChunks(2usize)) {
    passes = passes + 1u64;
    d[0usize] = u32.from(c.len);
  }
  show("passes", passes);                                                         // 3
  show("lengths written", u64.from(*b[0usize] + *b[2usize] + *b[4usize] + *b[6usize]));   // 4 + 4 + 2 + 2 (b[6] keeps the 2 it got in the first loop)

  // len, at and split of the zip itself
  imm z = a.chunks(2usize).zip(b.chunks(4usize));    // 5 and 8 chunks: the zip has 5
  show("zip length", u64.from(z.len()));                                          // 5
  imm pair = z.at(3usize);
  show("pair 3: chunk of a", u64.from(pair.0.len));                               // 2
  show("pair 3: chunk of b", u64.from(pair.1.len));                               // 4
  // (no 'split' of this zip: the method zip is the Iterator default, whose Self has lost the
  // chunk cursor's lifetime, and the cursor then fails the zip's ParallelIterable condition.
  // 'parallel each' does not call 'split' yet; a zip of lists, zip(&a, &b), has it)

  // mutItems beside a cursor over another list, the item changed through its '&mut'
  mut count = 0u64;
  each p, c in a.mutItems().zip(b.chunks(3usize)) {
    *p = u32.from(c.len);
    count = count + 1u64;
  }
  show("items zipped: passes", count);                                            // 10 (30 / 3 = 10 chunks, 10 items)
  show("items zipped: a[9]", u64.from(*a[9usize]));                               // 3
}
