// 'zip' over arrays and slices, beside lists and each other: the two sources are
// walked side by side and the shorter ends it. A fixed-size array is passed
// with its '&', as a list is, and a slice parameter as it is; the sources need
// not be of the same kind or the same element type.
//
// Every value printed is worked out by hand from the values put in.

mod each_zip_arrays;

import stdio use *;
import collections use *;

fn nl() {
  printStr("\n");
}

fn num(n i64) {
  printInt(n);
  printStr(" ");
}

// The sum of the products of the pairs of two slices
fn dot(s &Array[i64], t &Array[i64]) i64 {
  mut n = 0i64;
  each x, y in zip(s, t) {
    n = n + *x * *y;
  }
  n;
}

// A slice beside a list, in each order
fn sliceAndList(s &Array[i64], l &List[i64]) i64 {
  mut n = 0i64;
  each x, y in zip(s, l) {
    n = n + *x * *y;
  }
  each y, x in zip(l, s) {
    n = n + *x * *y;
  }
  n;
}

fn main() {
  imm a = [1i64, 2i64, 3i64];
  imm b = [10i64, 20i64];
  mut xs = new List[i64];
  xs.push(4i64); xs.push(5i64); xs.push(6i64); xs.push(7i64);

  // an array and a list, in each order: 1*4 + 2*5 + 3*6, the list's 7 unpaired
  mut n = 0i64;
  each x, y in zip(&a, &xs) {
    n = n + *x * *y;
  }
  num(n);                                 // 32
  nl();

  each y, x in zip(&xs, &a) {
    num(*y);
    num(*x);
  }
  nl();                                   // 4 1 5 2 6 3

  // two arrays: the shorter, b, ends it
  n = 0i64;
  each x, y in zip(&a, &b) {
    n = n + *x * *y;
  }
  num(n);                                 // 1*10 + 2*20 = 50
  nl();

  each y, x in zip(&b, &a) {
    num(*y);
    num(*x);
  }
  nl();                                   // 10 1 20 2

  // an array with itself
  n = 0i64;
  each x, y in zip(&a, &a) {
    n = n + *x * *y;
  }
  num(n);                                 // 1 + 4 + 9 = 14
  nl();

  // two slice parameters, given arrays, either order, and part of an array
  num(dot(&a, &b));                       // 50
  num(dot(&b, &a));                       // 50
  num(dot(&a[1..], &b));                  // [2, 3] with [10, 20]: 20 + 60 = 80
  nl();

  // a slice beside a list: (4 + 10 + 18) twice
  num(sliceAndList(&a, &xs));             // 64
  nl();

  // an empty slice ends it at once
  n = 0i64;
  each x, y in zip(&a[..0], &xs) {
    n = n + 1i64;
  }
  each x, y in zip(&xs, &a[..0]) {
    n = n + 1i64;
  }
  num(n);                                 // 0
  nl();

  // arrays of different element types
  imm d = [true, false, true];
  n = 0i64;
  each x, y in zip(&a, &d) {
    if *y { n = n + *x; }
  }
  num(n);                                 // 1 + 3 = 4
  nl();
}
