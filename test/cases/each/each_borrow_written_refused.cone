// A permission written on an 'each' source is given or refused, never dropped.
// A Set lends its items to be read only, since writing an element would break its
// hash: '&mut' and '&uni' over it are refused, saying to walk '&'. A list, an
// array, a subslice, a Deque and a Dict lend their items with the permission
// (each_borrow_written).

mod each_borrow_written_refused;

import collections use *;

fn setMut() {
  var s = Set[i64]();
  each x in &mut s {                //~ ErrorEachBorrowPerm:13 "has none to change in place"
  }
}

fn setUni() {
  var s = Set[i64]();
  each x in &uni s {                //~ ErrorEachBorrowPerm:13 "walk '&' of it"
  }
}

// The items of a read-only borrow cannot be written
fn readOnly() {
  var l = List[i64]();
  l.push(1i64);
  each x in &l {
    *x = 2i64;                      //~ ErrorNoMut:5 "permission to modify"
  }
}

// A Deque and a Dict have a '&mut' cursor but none for '&uni': an Option or a tuple
// of '&uni' items is refused as a type argument (ErrorUniShared)
fn dequeUni() {
  var d = Deque[i64]();
  each x in &uni d {                //~ ErrorEachBorrowPerm:13 "has none to change in place"
  }
}

fn dictUni() {
  var m = Dict[i64, i64]();
  each k, v in &uni m {             //~ ErrorEachBorrowPerm:16 "walk '&' of it"
  }
}

// A Dict lends its keys to be read only
fn dictKey() {
  var m = Dict[i64, i64]();
  each k, v in &mut m {
    *k = 2i64;                      //~ ErrorNoMut:5 "permission to modify"
  }
}

fn main() i32 { 0i32 }
