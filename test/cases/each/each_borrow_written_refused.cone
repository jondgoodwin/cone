// A permission written on an 'each' source is given or refused, never dropped.
// A Deque, a Set and a Dict lend their items to be read (their 'iter' takes
// '&'): '&mut' and '&uni' over them are refused, saying to walk '&'.
// A list, an array and a subslice lend their items with the permission.

mod each_borrow_written_refused;

import collections use *;

fn dequeMut() {
  var d = Deque[i64]();
  d.push(1i64);
  each x in &mut d {                //~ ErrorEachBorrowPerm:13 "walk '&' of it"
  }
}

fn dequeUni() {
  var d = Deque[i64]();
  each x in &uni d {                //~ ErrorEachBorrowPerm:13 "lends its items to be read"
  }
}

fn setMut() {
  var s = Set[i64]();
  each x in &mut s {                //~ ErrorEachBorrowPerm:13 "has none to change in place"
  }
}

fn dictMut() {
  var m = Dict[i64, i64]();
  each k, v in &mut m {             //~ ErrorEachBorrowPerm:16 "walk '&' of it"
  }
}

fn dictUni() {
  var m = Dict[i64, i64]();
  each pair in &uni m {             //~ ErrorEachBorrowPerm:16 "lends its items to be read"
  }
}

// The items of a read-only borrow cannot be written
fn readOnly() {
  var l = List[i64]();
  l.push(1i64);
  each x in &l {
    *x = 2i64;                      //~ ErrorNoMut:5 "permission to modify"
  }
}

fn main() i32 { 0i32 }
