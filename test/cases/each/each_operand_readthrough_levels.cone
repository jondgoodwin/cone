// A borrow of a value that copies freely (a number, a bool, a char, a plain struct) is read
// through by an operator, as the manual says of any operator, at every level of borrow: a
// loop's `each` hands a borrow of the item, a filter's closure a borrow of that borrow.
//
// - the comparisons, `>`, `<=`, `==`, `!=`, between such a borrow and a value, at one level
//   (`each x in xs`) and at two (`xs.iter().filter(p => ...)`), for i64, f64, bool and char;
//   a value on the left too, when it is typed (a bare `4` on the left is an i32 whatever is
//   on the right);
// - the arithmetic, `+`, `+=` and `-`, on a borrow of a borrow that is written out;
// - `print <- n` for a borrowed `n`: the argument of a `<-` is read through when no overload
//   takes the borrow, so `print` (whose `<-` methods take `self: &`) prints it;
// - a `<-` of a struct of our own: a plain struct borrowed goes to the overload that takes
//   the value, and to the overload that takes the borrow where there is one.
//
// Every value printed is worked out by hand from the values put in.

mod each_operand_readthrough_levels;

import stdio use *;
import collections use *;

struct Point {
  pub x: i64;
  pub y: i64;
}

// Takes a Point by value
struct Sink {
  pub total: i64;
  pub fn add overload `<-`(self: &mut, p: Point) { total += p.x + p.y; }
}

// Takes a Point by value and a borrowed one too: each is called for what it is given
struct Both {
  pub byref: i64;
  pub byval: i64;
  pub fn addRef overload `<-`(self: &mut, p: &Point) { byref += p.x; }
  pub fn addVal overload `<-`(self: &mut, p: Point) { byval += p.y; }
}

fn main() {
  // print <- n for the borrow each hands out
  let ints = new List[i64] <- 1, -2, 3;
  each n in ints { print <- n, " "; }
  print <- "\n";                    // 1 -2 3
  let floats = new List[f64] <- 1.5, 2.5;
  each n in floats { print <- n, " "; }
  print <- "\n";                    // 1.5 2.5
  let bools = new List[bool] <- true, false;
  each n in bools { print <- n, " "; }
  print <- "\n";                    // true false
  let chars = new List[char] <- 'a', 'é';
  each n in chars { print <- n, " "; }
  print <- "\n";                    // a é

  // print <- r for a borrow written out, and for a borrow of one
  let a = 42i64;
  let r = &a;
  let rr = &r;
  let u = 7u64;
  print <- r, " ", rr, " ", &u, "\n";   // 42 42 7

  // A plain struct handed to a `<-` of our own
  let pts = new List[Point] <- new Point(1, 2), new Point(3, 4);
  var sink = new Sink(0);
  each p in pts { sink <- p; }
  print <- sink.total, "\n";            // (1 + 2) + (3 + 4) = 10
  var both = new Both(0, 0);
  each p in pts { both <- p; }          // the borrow overload: x of each, 1 + 3
  both <- new Point(5, 6);              // the value overload: y of it, 6
  print <- both.byref, " ", both.byval, "\n";   // 4 6

  // Comparisons, one level (the item each hands out) ...
  let four = 4i64;
  let nums = new List[i64] <- 3, 5, 7;
  print <- "i64 one:";
  each x in nums { if x > 4 { print <- " ", x; } }
  print <- " |";
  each x in nums { if x <= 5 { print <- " ", x; } }
  print <- " |";
  each x in nums { if x == 5 { print <- " ", x; } }
  print <- " |";
  each x in nums { if x != 5 { print <- " ", x; } }
  print <- " |";
  each x in nums { if four < x { print <- " ", x; } }
  print <- "\n";                        // i64 one: 5 7 | 3 5 | 5 | 3 7 | 5 7

  // ... and two (the closure of a filter sees a borrow of the borrowed item)
  print <- "i64 two:";
  var gt = nums.iter().filter(p => p > 4);
  each x in gt { print <- " ", x; }
  print <- " |";
  var le = nums.iter().filter(p => p <= 5);
  each x in le { print <- " ", x; }
  print <- " |";
  var eq = nums.iter().filter(p => p == 5);
  each x in eq { print <- " ", x; }
  print <- " |";
  var ne = nums.iter().filter(p => p != 5);
  each x in ne { print <- " ", x; }
  print <- " |";
  var lt = nums.iter().filter(p => four < p);
  each x in lt { print <- " ", x; }
  print <- " |";
  var tens = nums.iter().filter(p => p > 4).map(p => p * 10);
  each x in tens { print <- " ", x; }
  print <- "\n";                        // i64 two: 5 7 | 3 5 | 5 | 3 7 | 5 7 | 50 70

  let fl = new List[f64] <- 1.5, 2.5, 3.5;
  print <- "f64 one:";
  each x in fl { if x > 2.0 { print <- " ", x; } }
  print <- " |";
  each x in fl { if x == 2.5 { print <- " ", x; } }
  print <- " |";
  each x in fl { if x != 2.5 { print <- " ", x; } }
  print <- "\n";                        // f64 one: 2.5 3.5 | 2.5 | 1.5 3.5
  print <- "f64 two:";
  var fgt = fl.iter().filter(p => p > 2.0);
  each x in fgt { print <- " ", x; }
  print <- " |";
  var feq = fl.iter().filter(p => p == 2.5);
  each x in feq { print <- " ", x; }
  print <- " |";
  var fne = fl.iter().filter(p => p != 2.5);
  each x in fne { print <- " ", x; }
  print <- "\n";                        // f64 two: 2.5 3.5 | 2.5 | 1.5 3.5

  let bs = new List[bool] <- true, false, true;
  print <- "bool one:";
  each x in bs { if x == true { print <- " ", x; } }
  print <- " |";
  each x in bs { if x != true { print <- " ", x; } }
  print <- "\n";                        // bool one: true true | false
  print <- "bool two:";
  var bt = bs.iter().filter(p => p == true);
  each x in bt { print <- " ", x; }
  print <- " |";
  var bf = bs.iter().filter(p => p != true);
  each x in bf { print <- " ", x; }
  print <- "\n";                        // bool two: true true | false

  let cs = new List[char] <- 'a', 'm', 'z';
  print <- "char one:";
  each x in cs { if x >= 'm' { print <- " ", x; } }
  print <- " |";
  each x in cs { if x == 'm' { print <- " ", x; } }
  print <- " |";
  each x in cs { if x != 'a' { print <- " ", x; } }
  print <- "\n";                        // char one: m z | m | m z
  print <- "char two:";
  var cge = cs.iter().filter(p => p >= 'm');
  each x in cge { print <- " ", x; }
  print <- " |";
  var ceq = cs.iter().filter(p => p == 'm');
  each x in ceq { print <- " ", x; }
  print <- " |";
  var cne = cs.iter().filter(p => p != 'a');
  each x in cne { print <- " ", x; }
  print <- "\n";                        // char two: m z | m | m z

  // A borrow of a borrow written out, against a value, a borrow and a borrow of one
  let six = 6i64;
  let sr = &six;
  let srr = &sr;
  print <- (srr > 4), " ", (srr == sr), " ", (srr < srr), " ", (srr != 6), " ", (four < srr), "\n";
                                        // true true false false true
  print <- srr + 1, " ", srr + srr, " ", srr + sr, " ", sr + srr, " ", four + srr, " ", -srr, "\n";
                                        // 7 12 12 12 10 -6
  var q = 1i64;
  q += srr;
  print <- q, "\n";                     // 1 + 6 = 7
}
