// '&*s', '&mut *s' and '&uni *s' on a slice reference: "borrow what s points at" with
// the permission written, as '&*r' is for any reference. As the source of an 'each'
// they lend each item to be read, changed or lent uniquely; also in a
// 'parallel each', and beside a subslice '&mut s[a ..< b]'. Slice parameters of every
// permission are walked this way, so one spelling serves slices, lists and arrays.

mod each_slice_deref;

import stdio use *;
import collections use *;
import actors;

fn sum(s: &Array[i32]) i32 {
  var t = 0i32;
  each x in &*s {
    t += *x;
  }
  t
}

fn addFive(s: &mut Array[i32]) i32 {
  each x in &mut *s {
    *x = *x + 5i32;
  }
  sum(&*s)
}

fn addSeven(s: &uni Array[i32]) i32 {
  each x in &uni *s {
    *x = *x + 7i32;
  }
  sum(&*s)
}

fn subslice(s: &mut Array[i32]) i32 {
  each x in &mut s[1usize ..< 3usize] {
    *x = *x * 10i32;
  }
  sum(&*s)
}

fn parallelUni(s: &uni Array[i32]) i32 {
  parallel each x in &uni *s {
    *x = *x * 2i32;
  }
  sum(&*s)
}

fn show(label: &str, n: i32) {
  printStr(label);
  printStr(" = ");
  printInt(i64.from(n));
  printStr("\n");
}

fn main() i32 {
  var a = [1i32, 2i32, 3i32, 4i32];
  show("read", sum(&a));                  // 10
  show("&mut *s", addFive(&mut a));       // 6 + 7 + 8 + 9
  show("&uni *s", addSeven(&uni a));      // 13 + 14 + 15 + 16
  show("subslice", subslice(&mut a));     // 13 + 140 + 150 + 16
  show("parallel &uni *s", parallelUni(&uni a));   // 26 + 280 + 300 + 32
  0i32
}
