// A chain of adapters over a cursor that gives numbers, 'cursor.map(f).sum()',
// compiled as a library (cases.toml): the optimized IR shows it is one loop, with the
// closure's body inline and no call for any item, and vectorized as the hand-written
// counted loop is (enum_payload_loop_option, which this cursor is).

mod each_adapters_fused;

pub struct ValCursor['a] is Iterator[i64] {
  arr &'a Array[i64];
  pos usize;
  pub fn next(self &mut) Option[i64] inline {
    if pos >= arr.len { return None[i64][]; }
    imm v = arr[pos];
    pos = pos + 1;
    Some[i64][v];
  }
}

pub fn sumChain(a &Array[i64], k i64) i64 {
  new ValCursor(a, 0usize).map(x => x * k).sum();
}
