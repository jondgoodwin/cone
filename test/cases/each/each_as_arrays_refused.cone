// What 'asArrays' and 'asMutArrays' refuse, said at type check: the rows of 'asArrays' are
// read-only, as the slice it is called on is; 'asMutArrays' needs something that may be
// changed; and N is written in brackets, since no argument says it.

mod each_as_arrays_refused;

import collections use *;

// A row of 'asArrays' is read
fn writeARow(s &Array[u8]) {
  imm rows = s.asArrays[3]();
  rows[0][0] = 1u8;                  //~ ErrorNoMut
}

// A slice that is only read has no 'asMutArrays'
fn mutOfARead(s &Array[u8]) {
  imm rows = s.asMutArrays[3]();     //~ ErrorNoCandidate
}

// A list that cannot be changed has none either
fn mutOfAReadList(l &List[u8]) {
  imm rows = l.asMutArrays[3]();     //~ ErrorNoCandidate
}

// N cannot be inferred from the arguments: it is in none of them
fn noBrackets(s &Array[u8]) {
  imm rows = s.asArrays();           //~ ErrorInvType
}
