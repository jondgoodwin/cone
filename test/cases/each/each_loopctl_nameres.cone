// A loop's 'else' is written after the loop, and so is outside it: it cannot
// name the loop's variables, and its 'break' and 'continue' belong to the loop
// around, of which there may be none.

mod each_loopctl_nameres;

import collections use *;

fn elseNamesTheVariable(l &List[i64]) i64 {
  each x in l {
    if *x > 1i64 { break *x; }
  } else {
    *x;                                      //~ ErrorUnkName:6 "does not refer to a declared name"
  }
}

fn elseNamesTheRangeVariable() i64 {
  each i in 0i64 ..< 5i64 {
    if i > 1i64 { break i; }
  } else {
    i;                                       //~ ErrorUnkName:5 "does not refer to a declared name"
  }
}

fn elseBreaksNothing(l &List[i64]) {
  each x in l {
    if *x > 1i64 { break; }
  } else {
    break;                                   //~ ErrorNoLoop:5 "break may only be used within"
  }
}

fn main() i32 { 0i32; }
