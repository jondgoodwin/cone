// Rows of 0 elements make no sense, so 'asArrays[0]()' is a panic naming the line of its call,
// checked before the count is divided by the row length. (A number generic's argument is only
// a literal of its type: nothing says "greater than 0" at compile time.)

mod each_as_arrays_zero;

import stdio use *;

fn main() {
  mut a Array[u8, 6] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8];
  imm s &Array[u8] = &a;
  printUInt(u64.from(s.asArrays[3]().len));
  printStr(" row(s) of 3\n");
  printUInt(u64.from(s.asArrays[0]().len));
  printStr(" not reached\n");
}
