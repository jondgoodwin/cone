// An 'each' over a range written with a bare '..' between its start and its end is
// refused where the '..' stands, in a loop and in a 'parallel each', with a step and
// without one. It is read on as '..=', so the rest of the loop is checked.

mod each_range_bare;

fn plain(n: i32) {
  each i in 0..n {         //~ ErrorRangeBare:14 "write '..<' to stop before the end, or '..=' to include it"
  }
}

fn spaced(n: i32) {
  each i in 1 .. n by 2 {         //~ ErrorRangeBare:15 "'..' does not say whether the range includes its end"
  }
}

fn backwards(n: i32) {
  each i in n..0 by -1 {         //~ ErrorRangeBare:14 "write '..<' to stop before the end"
  }
}

fn drained(n: i32) {
  let xs = new List[i32] <- each i in 0..n yield i;   //~ ErrorRangeBare:40 "write '..<' to stop before the end"
}
