// What the 'zip' method refuses: it takes another CURSOR ('ys.iter()'), not a collection
// (the function 'zip(&xs, &ys)' is for two collections), and it comes only to a type that
// declares 'is Iterator[T]', so a struct with a 'next' and no declaration is told to
// declare itself.

mod each_zip_method_typecheck;

import collections use *;

// Has a 'next', and does not say it is an Iterator
struct Bare {
  n i64;
  pub fn next(self &mut) Option[i64] {
    if n <= 0i64 { return None[i64][]; }
    n = n - 1i64;
    Some[i64][n];
  }
}

fn notACursor(xs &List[i64], ys &List[i64]) {
  imm n = xs.iter().zip(ys).count();   //~ ErrorInvType:20 "Could not infer all of generic's type parameters"
}

fn undeclared(xs &List[i64]) {
  imm n = new Bare(3i64).zip(xs.iter()).count();   //~ ErrorNoMbr:25 "does not declare itself one. Declare it to get the shared methods: `struct Bare is Iterator[T]`"
                                                    //~^ ErrorNoMeth:25 follow-on
}
