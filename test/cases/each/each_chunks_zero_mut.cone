// 'mutChunks(0)' is a panic as 'chunks(0)' is (each_chunks_zero), on a list
// (whose own 'mutChunks' hands the line of its caller on) and on an array.

mod each_chunks_zero_mut;

import stdio use *;
import collections use *;

fn main() {
  mut grid = [1u64, 2u64, 3u64];
  each c in grid.mutChunks(3usize) {
    printUInt(u64.from(c.len));
    printStr(" element(s) in the array's run\n");
  }
  mut l = new List[u64];
  l.push(1u64);
  each c in l.mutChunks(0usize) {
    printStr("not reached\n");
  }
}
