// The value of a loop is one type, whether it comes from a 'break' or from the
// 'else', and a 'break' with no value gives none.

mod each_loopctl_typecheck;

import collections use *;

fn valueIsNotOneType(l &List[i64]) {
  imm v = each x in l {
    if *x > 1i64 { break *x; }              //~ ErrorInvType:26 "inconsistent with other branches"
  } else {
    "none";
  };
}

fn breakWithoutValue(l &List[i64]) {
  imm v = each x in l {
    if *x > 1i64 { break; }                 //~ ErrorInvType:25 "inconsistent with other branches"
  } else {
    5i64;
  };
}

// A loop used as a statement takes its 'else' for what it does, and its
// 'break's with no value: nothing is refused
fn statement(l &List[i64]) {
  each x in l {
    if *x > 1i64 { break; }
  } else {
    imm n = 5i64;
  }
}

fn main() i32 { 0i32; }
