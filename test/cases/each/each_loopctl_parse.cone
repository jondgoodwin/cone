// Loop control the parser refuses.
//
// - a trailing 'if' goes on 'break', 'continue' and 'return' alone;
// - a loop with a condition, and an 'each', give a value only when they have an
//   'else'; a loop with no condition never runs out, so it has none.

mod each_loopctl_parse;

import collections use *;

fn trailingOnAssignment(c bool) {
  mut n = 0i64;
  n = 1i64 if c;                             //~ ErrorTrailingIf:12 "only on 'break', 'continue' or 'return'"
}

fn eachAsValueWithoutElse(l &List[i64]) {
  imm v = each x in l {                      //~ ErrorNoLoop:23 "each may not be used as an expression"
    if *x > 1i64 { break; }
  };
}

fn whileAsValueWithoutElse(n i64) {
  imm v = while n > 0i64 {                   //~ ErrorNoLoop:26 "while with condition expression may not be used as an expression"
    break;
  };
}

fn forever() {
  imm v = while {
    break 1i64;
  } else {                                   //~ ErrorLoopElse:10 "never runs out"
    2i64;
  };
}

fn main() i32 { 0i32; }
