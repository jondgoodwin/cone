// Runs of 0 elements make no sense, so 'chunks(0)' is a panic, as an index past
// the end is: it names the line of the call. What ran before it printed.

mod each_chunks_zero;

import stdio use *;
import collections use *;

fn main() {
  mut l = new List[u64];
  l.push(1u64);
  l.push(2u64);
  each c in l.chunks(2usize) {
    printUInt(u64.from(c.len));
    printStr(" element(s) in the first run\n");
  }
  each c in l.chunks(0usize) {
    printStr("not reached\n");
  }
}
