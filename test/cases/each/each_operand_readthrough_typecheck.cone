// What an operator still refuses to read through a borrow.
//
// 'total + x' and 'x > 1' read the value through a borrow of a number, a bool or
// a plain struct (each_operand_readthrough). That is a copy, so it is only for a
// value that copies freely. A String, or a struct that moves (it has a finalizer),
// would be moved out of the borrow, which nothing ever does: the operator is
// refused where it always was. Nor is a borrow read through to make two types
// agree: an i32 borrow and an i64 are still two types.

mod each_operand_readthrough_typecheck;

import collections use *;

// A struct that moves: it has a finalizer
struct Tok {
  pub n i32;

  pub fn `==`(self &, other &Tok) bool {
    n == other.n;
  }

  pub fn `+`(self &, other Tok) i32 {
    n + other.n;
  }

  fn final(self &uni) { }
}

// Text declares no '+'
fn text(xs &List[String], t String) {
  each s in xs {
    imm a = t + s;                  //~ ErrorNoMbr:15 "not found"
    imm b = s + t;                  //~ ErrorNoMbr:15 "not found"
  }
}

// A borrow of a struct that moves is compared with a value as it always was: not
// at all. '==' is declared for references, and a reference is compared with one.
fn movesCompare(xs &List[Tok], t Tok) {
  each s in xs {
    imm a = s == t;                 //~ ErrorRefCompareMixed:15 "so the other side must be a reference too"
  }
}

// An operator taking its other operand by value would have to move it out of the
// borrow
fn movesAdd(xs &List[Tok], t Tok) {
  each s in xs {
    imm a = t + s;                  //~ ErrorNoCandidate:15 "accepts the call's arguments"
    imm b = s + s;                  //~ ErrorNoCandidate:15 "accepts the call's arguments"
  }
}

// Two numbers of different types stay two types, borrowed or not
fn differentNumbers(xs &List[i32], ys &List[i64]) {
  each s in xs {
    each y in ys {
      imm a = s + y;                //~ ErrorNoCandidate:17 "accepts the call's arguments"
      imm b = s == y;               //~ ErrorNoCandidate:17 "accepts the call's arguments"
    }
  }
}
