// '&*s', '&mut *s' and '&uni *s' on a slice reference borrow what it points at, with the
// permission written, which cannot be more than the reference has. A '*s' that is not
// the operand of a borrow is still no value: a slice is not copied or held.

mod each_slice_deref_refused;

import collections use *;

fn mutFromRead(s: &Array[i32]) {
  each x in &mut *s {               //~ ErrorBadPerm:13 "cannot obtain this permission"
  }
}

fn uniFromMut(s: &mut Array[i32]) {
  each x in &uni *s {               //~ ErrorBadPerm:13 "cannot obtain this permission"
  }
}

fn uniFromRead(s: &Array[i32]) {
  each x in &uni *s {               //~ ErrorBadPerm:13 "cannot obtain this permission"
  }
}

fn bareDeref(s: &Array[i32]) {
  let a = *s;                       //~ ErrorNotPtr:11 "simple reference"
}

fn main() i32 { 0i32 }
