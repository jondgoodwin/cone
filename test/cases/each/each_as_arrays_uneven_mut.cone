// The '&mut' form refuses a count that is not a multiple of N the same way: a panic naming the
// line of the call, here through an array's slice after the rows of 2 before it ran, and
// through a list, whose own 'mutArrays' hands its caller's line on.

mod each_as_arrays_uneven_mut;

import stdio use *;
import collections use *;

fn main() {
  mut a Array[u8, 6] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8];
  mut s &mut Array[u8] = &mut a;
  printUInt(u64.from(s.mutArrays[2]().len));
  printStr(" row(s) of 2\n");
  mut l = new List[u8];
  each i in 1u8 <= 5u8 { l.push(i); }
  printUInt(u64.from(l.mutArrays[2]().len));
  printStr(" not reached\n");
}
