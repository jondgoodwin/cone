// What the shared 'indexed()' refuses when its cursor lends: the position joins the item in a
// tuple, and the item's borrow of the cursor is still the cursor's, so every use that would
// keep an item past the next step is refused as it is without the numbering
// (stream_chains_lending_flow): a list built from the tuples, a map that keeps the
// item, and two items held at once from a cursor kept in a variable.

mod each_indexed_shared_refused;

import collections use *;

struct Win['a] {
  p: &'a i64;
}

// A cursor whose item is a window onto its own field
struct Reader is Iterator[Win] {
  cur: i64;
  n: i64;

  pub fn next(self: &mut) Option[Win] {
    if n <= 0i64 { return None; }
    cur = n * 10i64;
    n = n - 1i64;
    Some[Win](Win(&cur))
  }
}

fn bare() {
  let k = List[(usize, Win)]() <- each Reader(0i64, 3i64).indexed();   //~ ErrorShapeReshape:58 "could change the shape of a 'IterIndexed'"
                                                                              //~^ ErrorFrozen:58 "goes out of scope while"
}

fn throughMap() {
  let k = List[Win]() <- each Reader(0i64, 3i64).indexed().map(p => p.1);   //~ ErrorShapeReshape:59 "could change the shape of a 'IterMap'"
                                                                              //~^ ErrorFrozen:59 "goes out of scope while"
}

fn twoAtOnce() i64 {
  var r = Reader(0i64, 3i64);
  var it = r.indexed();
  let a = it.next();
  let b = it.next();                                                          //~ ErrorShapeReshape:13 "could change the shape of a 'IterIndexed'"
  match a {
    case let e Some { return *e.1.p; }
    case is None { return 0i64; }
  }
}

fn main() i32 { 0i32 }
