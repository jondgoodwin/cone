// What the shared 'indexed()' is not: a cursor that has a 'next' and does not declare
// 'is Iterator[T]' has no shared methods at all, so no 'indexed()' either.

mod each_indexed_shared_typecheck;

struct Bare {
  n i64;

  pub fn next(self &mut) Option[i64] {
    if n <= 0i64 { return None; }
    let v = n;
    n = n - 1i64;
    Some[i64](v);
  }
}

fn undeclared() {
  each i, v in new Bare(3i64).indexed() { }                         //~ ErrorNoMbr:30 "does not declare itself"
}

fn main() i32 { 0i32; }
