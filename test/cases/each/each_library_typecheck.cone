// What the library's walks refuse, said at type check: changing items through a
// list, a slice or a variable that may not be changed, and writing through the
// borrow a plain 'each' gives (it reads; 'mutItems' is for changing).

mod each_library_typecheck;

import collections use *;

// A slice that is only read has no 'mutItems' to take
fn readOnlySlice(s &Array[i64]) {
  each x in s.mutItems() {           //~ ErrorNoCandidate
    *x = 1i64;
  }
}

// A list that cannot be changed cannot lend its items to be changed
fn immutableList() {
  imm l = new List[i64];
  each x in l.mutItems() {           //~ ErrorBadPerm
    *x = 1i64;
  }
}

// A plain 'each' lends each item to be read
fn writeThroughARead(l &List[i64]) {
  each x in l {
    *x = 1i64;                       //~ ErrorNoMut
  }
}
