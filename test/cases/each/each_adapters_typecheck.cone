// What the adapters refuse. 'sum', 'min' and 'max' are there where the items are
// numbers, so a cursor that lends (its items are borrows) is mapped to values first,
// and a struct has none of them; the closure given to 'map' is typed from the item,
// so its body is checked against it; a chain needs an Iterator to begin.

mod each_adapters_typecheck;

import collections use *;

struct Pt {
  x i32;
  y i32;
}

fn borrowedSum(xs &List[i64]) {
  imm s = lazy(xs.iter()).sum();                //~ ErrorWhereAbsent:26 "it exists only where T is Integer or T is f32 or T is f64"
}

fn structMax(ps &List[Pt]) {
  imm m = lazy(ps.iter()).map(p => *p).max();   //~ ErrorWhereAbsent:39 "that is false for T = Pt"
}

fn badBody(xs &List[i64]) {
  imm n = lazy(xs.iter()).map(x => *x + "a").count();   //~ ErrorNoCandidate:39 "No method declared by `+` accepts the call's arguments"
}

fn notACursor(xs &List[i64]) {
  imm n = lazy(xs).count();                     //~ ErrorInvType:15 "Could not infer all of generic's type parameters"
                                                //~^ ErrorNoMeth:15 "This type does not support calls or field access"
}
