// A count that is not a multiple of N cannot be seen as rows of N, so 'asArrays[N]()' is a
// panic that names the line of its call, as an index past the end does, and not a line in
// core. Six bytes as rows of 3 ran before it; the same six as rows of 4 are the panic, here
// on a list, whose folded-in 'asArrays' hands its caller's line on.

mod each_as_arrays_uneven;

import stdio use *;
import collections use *;

fn main() {
  mut l = new List[u8];
  each i in 1u8 <= 6u8 { l.push(i); }
  printUInt(u64.from(l.asArrays[3]().len));
  printStr(" row(s) of 3\n");
  printUInt(u64.from(l.asArrays[4]().len));
  printStr(" not reached\n");
}
