// 'each' headers the parser cannot read.
//
// The parser reads the whole header: the variables, 'in', the source and a
// range's 'by'. A numeric range it rewrites into a variable declaration and a
// 'while' there and then; anything else it leaves to type check, which builds
// the loop once it knows what the source is. So the header has to be well
// formed before there is anything for a later stage to look at. Each case sits
// in its own function, because the parser abandons the whole 'each' statement at
// the first thing it cannot read and re-reads what follows as a statement of its
// own.

mod each_parse;

// A loop variable name is required directly after 'each'. Giving up here leaves
// the parser on 'in', which is not the start of anything.
fn noVariable() {
  each in;                //~ ErrorNoVar:8 "Missing variable name"
                         //~^ ErrorBadTerm:8 follow-on
  imm ok = 1;
}

// 'in' is required after the loop variable, and the '{' that would have opened
// the body is then read as the start of a second statement on the line.
fn noIn() {
  each i 1 < 2 {         //~ ErrorBadTok:10 "Missing 'in'"
                         //~^ ErrorNoSemi:15 follow-on
  }
}

// A comma after the variable asks for another one
fn missingSecondVariable() {
  each k, in 5 {         //~ ErrorNoVar:11 "Missing variable name"
                         //~^ ErrorBadTerm:11 follow-on
                         //~^^ ErrorNoSemi:13 follow-on
                         //~^^^ ErrorNoSemi:15 follow-on
  }
}

// A numeric range gives one variable, the number: two would unpack a tuple
fn rangeWithTwoVariables() {
  each i, j in 0 < 3 {   //~ ErrorBadTok:18 "one variable"
  }
}

// 'by' is recognized only after a range comparison. '5' is not one, so 'by' is
// never consumed and the parser is still looking for the body's '{' when it
// reaches it.
fn stepWithoutRange() {
  each i in 5 by 1 {     //~ ErrorNoLCurly:15
  }
}

// What follows 'in' has to be an expression. When it is not even a term, there
// is no iterator to look at, and the parser gives up on the 'each' there --
// once crashing, by reading the missing iterator's kind. That is a crash guard
// in a file of other cases: if it regresses, the process dies and every
// expectation here is lost with it.
fn notATerm() {
  each x in ] {          //~ ErrorBadTerm:13 "Invalid term"
  }
}

// 'each' is a statement and never an expression. The only way to write one in
// expression position is behind a lifetime label, which the expression parser
// does accept, so the check lives in the 'each' parser itself. It reports
// through errorMsg with no source position, so cases.toml carries it.
fn asExpression() {
  imm n = 'a: each i in 0 < 5 {
  };
}
