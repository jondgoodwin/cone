// What may be borrowed from, and what may be dereferenced.
//
// Type-check stage only, and separate from ref-typecheck-perm because these
// two families answer different questions: this file asks whether there is a
// place to point at and something to point through, that one asks what the
// pointer is then allowed to do. Neither carries a flow-stage expectation,
// because flow analysis is skipped for every function once any error has been
// reported; those live in ref-flow.

fn twice(n u32) u32 { n * 2u }

struct Counter {
  n i32
  fn doubled(self) i32 {n + n}
}

// A borrow needs a place in memory to point at. A computed value has none.
fn borrowComputed() {
  mut a = 3
  imm r = &(a + 1)      //~ ErrorBadLval:15 "May not borrow a temporary value"
}

// Nor does a literal, which the compiler is free to keep in the instruction
fn borrowLiteral() {
  imm r = &5            //~ ErrorBadLval:12 "May not borrow a temporary value"
}

// A borrow applies to the whole suffixed term, so '&c.doubled()' borrows what
// the method returned rather than the receiver it was called on. That is a
// temporary, and '(&c).doubled()' is how a method is called on a borrowed
// receiver.
fn borrowMethodResult() {
  mut c = Counter[3]
  imm r = &c.doubled()  //~ ErrorBadLval:13 "May not borrow a temporary value"
}

// A constructed literal is a temporary too, so a reference type's own literal
// syntax is not a way to allocate one
fn borrowConstructed() {
  imm r = &Counter[4]   //~ ErrorBadLval:19 "May not borrow a temporary value"
}

// Dereference needs a reference or a pointer. A number is neither.
fn derefNumber() {
  mut a = 3
  imm v = *a            //~ ErrorNotPtr:11 "May only de-reference a simple reference or pointer"
}

// One '*' per level of reference: '&i32' has exactly one to give
fn derefTooFar() {
  mut a = 3
  imm r = &a
  imm v = **r           //~ ErrorNotPtr:11 "May only de-reference a simple reference or pointer"
}

// A reference's value type is part of its type, so a reference to one number
// type is not a reference to another
fn wrongValueType() {
  mut a = 3
  imm r &f32 = &a       //~ ErrorInvType:16 "Initialization value's type does not match variable's declared type"
}

// A function reference points at code, so there is no value behind it to name.
// Dereferencing it leaves a function signature, which is one of the five ways
// a type cannot report a size, and the diagnostic says which.
fn derefFunctionRef() {
  imm f = &twice
  imm g = *f            //~ ErrorNoSize:7 "a function signature is not a value at all"
}
