// What two references cannot be compared for.
//
// '==', '!=' and the orderings on references compare the values they refer to,
// as every other use of a reference reads through it. So the referent has to
// offer the operator, and both sides have to be references. '===' and '!=='
// ask the other question -- do two references point to the same place? -- which
// a value that is not a reference has no answer to. ref_success runs every
// comparison that is allowed.

mod ref_typecheck_compare;

struct Pair {
  pub x i32;
  pub y i32;
}

// An enum whose variants carry fields has a '==' only when each of them declares
// one, and reading through a reference reaches that refusal exactly as comparing
// the values would
enum Shape {
  struct Circle {
    pub radius i32;
  }
  struct Square {
    pub side i32;
  }
}

fn one() i32 { 1; }

// A struct that declares no '==' has none to read through to. The diagnostic
// names '===', which is what a comparison of two such references can ask.
fn noEquality(a &Pair, b &Pair) bool {
  a == b;                 //~ ErrorRefNoCompare:5 "Use `===` to ask"
}

// Nor does it have an order, and a reference has none of its own: the order of
// two addresses is not what '<' on references asks
fn noOrdering(a &Pair, b &Pair) bool {
  a < b;                  //~ ErrorRefNoCompare:5 "no order of their own"
}

// A function has no comparison either, so two function references are compared
// for identity or not at all
fn fnRefs() bool {
  imm f = &one;
  imm g = &one;
  f == g;                 //~ ErrorRefNoCompare:5 "has no comparison"
}

fn payloadEnum(a &Shape, b &Shape) bool {
  a == b;                 //~ ErrorEnumEquality:5 "Circle carries a payload (radius i32) and declares none"
}

// A reference against a value is read through on one side only where the value
// copies freely (each_operand_readthrough). Otherwise it is refused rather than
// read through: the value would have to be moved out of the borrow, and
// '*r != c' says what it compares, and 'r != c' would not. Coin declares only
// '==', so its '!=' would be derived as 'not (a == b)'; the refusal names the
// '!=' that was written, not the '==' it would have become. A finalizer makes
// Coin a type that moves.
struct Coin {
  pub cents i32;
  pub fn `==`(self &, other &Coin) bool {
    cents == other.cents;
  }
  fn final(self &uni) { }
}

fn mixed(r &Coin, c Coin) bool {
  r != c;                 //~ ErrorRefCompareMixed:5 "`!=` on a reference compares the value it refers to"
}

// Identity asks about places, which two numbers do not have
fn identityOnValues(a i32, b i32) bool {
  a === b;                //~ ErrorSameNotRef:5 "not a reference or a pointer"
}
