// A function reference whose function differs from its type in a parameter or
// the result held BY VALUE is refused when the two are not one layout. A variant
// and its enum are different aggregates: a call through '&fn(n i32) Shape' reads
// the result as a Shape, and '&mk', which returns a 'Shape.Circle', wrote another
// shape of bytes (the call printed garbage). A reference to either is one
// pointer, so ref_fnref_byvalue accepts those. A difference that needs a
// conversion (a wider number, a value made an Option) was refused already, as a
// plain mismatch, and is pinned here to stay so. No thunk is built: a wrapper
// function that converts is how one is written.

mod ref_typecheck_fnref_byvalue;

enum Shape {
  struct Circle {
    pub r i32;
  }
  struct Square {
    pub s i32;
  }
}

fn mk(n i32) Shape.Circle { Shape.Circle(r: n); }

fn mkShape(n i32) Shape { Shape.Circle(r: n); }

fn area(s Shape) i32 {
  match s {
    case let c Shape.Circle { c.r; }
    case let q Shape.Square { 100 + q.s; }
  }
}

fn areaAt(n i32, s Shape) i32 { n + area(s); }

fn sumShapes(a Array[Shape, 2]) i32 { 1; }

fn wide(n i64) i64 { n; }

fn narrow(n i32) i32 { n; }

fn first(o Option[i32]) i32 { 1; }

fn plain(n i32) i32 { n; }

fn takesResult(f &fn(n i32) Shape) i32 { 1; }

fn takesParam(f &fn(s Shape.Circle) i32) i32 { 1; }

// A variant returned where the enum is wanted, as an argument
fn viaArgument() i32 {
  takesResult(&mk);                      //~ ErrorFnRefByValue:15 "its result is `Circle` held by value"
}

// The enum taken where the variant is given
fn viaParameter() i32 {
  takesParam(&area);                     //~ ErrorFnRefByValue:14 "its parameter 1 (`s`) is `Shape` held by value"
}

// An initializer, an assignment and a returned reference
fn viaInitializer() {
  let f &fn(n i32) Shape = &mk;          //~ ErrorFnRefByValue:28 "Write a wrapper function"
  var g &fn(n i32) Shape = &mkShape;
  g = &mk;                               //~ ErrorFnRefByValue:7 "its result is `Circle` held by value"
}

fn viaReturn() &fn(n i32) Shape {        //~ ErrorInvType:16 "This is the declared function's return type" follow-on
  &mk;                                   //~ ErrorFnRefByValue:3 "its result is `Circle` held by value"
}

// The position is named: the second parameter
fn viaSecond(f &fn(n i32, s Shape.Circle) i32) i32 { 1; }

fn secondParameter() i32 {
  viaSecond(&areaAt);                    //~ ErrorFnRefByValue:13 "its parameter 2 (`s`) is `Shape` held by value"
}

// An array held by value is its elements in a row, so recast elements that
// differ in layout do too
fn viaArray(f &fn(a Array[Shape.Circle, 2]) i32) i32 { 1; }

fn arrayParameter() i32 {
  viaArray(&sumShapes);                  //~ ErrorFnRefByValue:12 "its parameter 1 (`a`) is `Array[Shape, 2]` held by value"
}

// A conversion is not a recast either, and is refused as a mismatch, as it was
fn viaWideParameter(f &fn(n i32) i64) i64 { 1; }
fn viaNarrowResult(f &fn(n i32) i64) i64 { 1; }
fn viaOptionResult(f &fn(n i32) Option[i32]) i32 { 1; }
fn viaOptionParameter(f &fn(n i32) i32) i32 { 1; }

fn conversions() i32 {
  viaWideParameter(&wide);               //~ ErrorInvType:20
  viaNarrowResult(&narrow);              //~ ErrorInvType:19
  viaOptionResult(&plain);               //~ ErrorInvType:19
  viaOptionParameter(&first);            //~ ErrorInvType:22
}
