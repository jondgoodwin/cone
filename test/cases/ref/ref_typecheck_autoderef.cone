// What a field or a method reached through several references may not do. It is
// what the explicit dereferences refuse: 'r.x' is '(**r).x'. A borrow read out of
// another has the intersection of the permissions gone through (a '&mut' held
// behind a '&' or in a field of a '&Holder' lends only '&'), so a write is
// refused where any level is read-only; and an owner behind a borrow that only
// reads lends only what the borrow does (a '&' lends only '&' of an owner).
// ref_autoderef holds the same shapes where the permissions allow.
//
// Type-check stage only, as ref_typecheck_perm is.

mod ref_typecheck_autoderef;

struct Pt {
  pub x: i32;
  pub y: i32;
  pub fn bump(self: &mut) { x = x + 1; }
}

// a '&' held behind a '&mut': the inner level cannot write
fn writeMutRo(r: &mut &Pt) {
  r.x = 9;                //~ ErrorNoMut:4 "You do not have permission to modify lval"
}

// the same, the dereferences written out
fn writeMutRoExplicit(r: &mut &Pt) {
  (**r).x = 9;            //~ ErrorNoMut:8 "You do not have permission to modify lval"
}

// the method wants 'self: &mut', which that read-only level is not
fn callMutRo(r: &mut &Pt) {
  r.bump();               //~ ErrorInvType:3 "does not match declared parameter"
}

// an owner behind a borrow that only reads
fn writeOwner(r: &Uni[Pt]) {
  r.x = 5;                //~ ErrorNoMut:4 "You do not have permission to modify lval"
}

fn callOwner(r: &Uni[Pt]) {
  r.bump();               //~ ErrorBadPerm:3 "Cannot lend `&mut` of this owner"
}

// two borrows deep
fn writeOwnerTwo(r: &&Uni[Pt]) {
  r.x = 5;                //~ ErrorNoMut:4 "You do not have permission to modify lval"
}

// a '&mut' held behind a '&' reads and lends only '&' (mem-permissions.html#view, "Viewpoint
// Adaptation"), as an owner does: written implicit or explicit, or its method called
fn writeRoMut(r: & &mut Pt) {
  r.x = 9;                //~ ErrorNoMut:4 "You do not have permission to modify lval"
}

fn writeRoMutExplicit(r: & &mut Pt) {
  (**r).x = 9;            //~ ErrorNoMut:8 "You do not have permission to modify lval"
}

fn callRoMut(r: & &mut Pt) {
  r.bump();               //~ ErrorBadPerm:3 "Borrowed reference cannot obtain this permission"
}

// a '&mut' in a field of a '&' holder
struct MutHolder {
  pub r: &mut Pt;
}

fn writeHeld(h: &MutHolder) {
  h.r.x = 30;             //~ ErrorNoMut:6 "You do not have permission to modify lval"
}

fn callHeld(h: &MutHolder) {
  h.r.bump();             //~ ErrorBadPerm:4 "Borrowed reference cannot obtain this permission"
}
