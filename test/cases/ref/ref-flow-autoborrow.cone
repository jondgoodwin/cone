// A borrow the compiler builds for itself carries its source's scope, exactly
// as a borrow written in source does.
//
// ref-flow-call asserts that a call's returned borrow takes the scope of its
// narrowest borrowed argument. That scope is read from the argument's type
// node, and a borrow the compiler injects -- an array auto-borrowed to a slice
// argument, the '&mut' receiver made for an operator that wants an lval, the
// field reborrowed for a folded method -- used to be typed with a reference
// node nothing had scoped, so it reached the call as global: 'sameSlice(arr)'
// stored past 'arr' compiled clean while 'sameSlice(&[]arr)' beside it was
// refused. borrowMutRef and borrowAuto now record the lval's scope as
// borrowTypeCheck does, and dereferencing a borrow expression yields that
// borrow's scope, so every form below is refused with the diagnostic the
// written borrow gets.
//
// Every diagnostic here is a flow diagnostic. Flow keeps going after one of its
// own within a function, so the stores share one function; each returning case
// has its own, because a function has one return.

fn sameSlice(s &[]i32) &[]i32 { s; }
mut GARR [2; i32] = [1, 2];
mut G i32 = 7;

struct Vec {
  pub x i32;
  pub fn `+=`(self &mut, n i32) &i32 { x = x + n; &self.x; }
  pub fn `<-`(self &mut, n i32) &i32 { x = x + n; &self.x; }
}
struct Engine {
  pub fuel i32;
  pub fn cell(self &) &i32 { &self.fuel; }
}
struct Car {
  pub engine Engine use cell;
}

fn storesAutoBorrows() {
  imm outerArr [2; i32] = [0, 0];
  mut slice &[]i32 = &[]outerArr;
  mut r &i32 = &G;
  {
    imm innerArr [2; i32] = [1, 2];
    mut v = Vec[0];
    mut car = Car[Engine[5]];
    imm c = &car;

    // An array auto-borrowed to a slice argument, beside the borrow written out
    slice = sameSlice(innerArr);    //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"
    slice = sameSlice(&[]innerArr); //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"

    // The '&mut' receiver an operator method is handed: op-assign, append, and
    // append of a tuple, which borrows the receiver once into a temporary
    r = (v += 1);                   //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"
    r = (v <- 1);                   //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"
    r = (v <- (1, 2));              //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"

    // The field reborrowed for a folded method, whether the receiver is a
    // borrow expression or a variable holding one
    r = (&car).cell();              //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"
    r = c.cell();                   //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"

    // What is not refused, and what makes the above a lifetime rule rather
    // than a refusal of auto-borrows: an auto-borrow of a global keeps its
    // global lifetime, and the result held inside the block it was borrowed
    // in is fine
    slice = sameSlice(GARR);
    imm kept = sameSlice(innerArr);
    imm keptCell = c.cell();
  }
}

// Returning the result meets returnFlowEscape, as returning the written borrow
// would
fn returnsAutoSlice() &[]i32 {
  imm a [2; i32] = [1, 2];
  sameSlice(a);                     //~ ErrorEscape:12 "Returned borrowed reference outlives the local value it points to"
}
fn returnsOpAssign() &i32 {
  mut v = Vec[0];
  v += 1;                           //~ ErrorEscape:5 "Returned borrowed reference outlives the local value it points to"
}
fn returnsFoldedField() &i32 {
  mut car = Car[Engine[5]];
  (&car).cell();                    //~ ErrorEscape:9 "Returned borrowed reference outlives the local value it points to"
}

// The other half: a parameter's borrow reaches the folded field with the
// parameter's scope, so the result stays returnable, and a global array's
// auto-borrow is global
fn returnsParameterFold(c &Car) &i32 { c.cell(); }
fn returnsGlobalSlice() &[]i32 { sameSlice(GARR); }
