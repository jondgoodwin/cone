// A method declaring 'self &uni' is lent its receiver '&uni' only where a written
// '&uni' could lend it (ref_typecheck_unilocal): a 'var' local, or a part of one held
// by value. A 'let' local, a global and a field of a '&mut' parameter are
// refused; before the receiver could be lent so, each call was refused as having no
// method that accepts it.

mod ref_typecheck_uni_receiver;

struct P { pub x i64; fn bump(self &uni) { x = x + 1; } }
struct H { pub p P; }

var @threadlocal g P = new P(1);

fn immLocal() {
  let p = new P(1);
  p.bump();                           //~ ErrorBadPerm:3 "cannot obtain this permission"
}

fn immField() {
  let h = new H(new P(1));
  h.p.bump();                         //~ ErrorBadPerm:4 "cannot obtain this permission"
}

fn global() {
  g.bump();                           //~ ErrorBadPerm:3 "cannot obtain this permission"
}

fn throughMutParam(h &mut H) {
  h.p.bump();                         //~ ErrorBadPerm:4 "cannot obtain this permission"
}

fn main() {}
