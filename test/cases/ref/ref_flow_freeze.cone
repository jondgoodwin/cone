// A borrow held in a local freezes its source until the borrow's last use.
// A local is a 'uni' source: a read-only borrow lets it be read and borrowed
// read-only again, but not changed, moved or ended; a mutable borrow lets
// nothing touch it but the borrow itself, not even a read. A source reached
// through a shared path -- a '+rc-mut' owner, a '&mut' reference -- others may
// read and change anyway, so a borrow of it needs only that it stays alive:
// the owner may not be moved, replaced, changed where it is held, or ended.
// Each function here touches the source while a borrow of it is still to be
// used, and the error is reported at the touch, naming the borrow and its
// next use.
//
// Each has a function of its own, so that one borrow's conflicts cannot stand
// in for another's. What stays allowed -- the same touches after the borrow's
// last use, reads under a read-only borrow, disjoint fields, a holder
// reassigned first -- is ref_freeze_success. The loop's back edge is
// ref_flow_freeze_loop.

mod ref_flow_freeze;

import stdio use *;

struct Pt { pub x i64; pub y i64; }

// A value with a finalizer, so that moving it and replacing it are moves
struct Fin {
  pub n i64;
  fn final(self &uni) {}
}

fn consume(f Fin) {}

// The source read while a mutable borrow of it is still to be used
fn readUnderMut() {
  mut k = 5;
  imm b = &mut k;
  printInt(k);               //~ ErrorFrozen:12 "may not be read"
  *b = 9;
}

// Changed while a read-only borrow is still to be used: by assignment, and by
// an operator that changes it in place
fn writeUnderShared() {
  mut k = 5;
  imm b = &k;
  k = 6;                     //~ ErrorFrozen:3 "may not be changed"
  k += 1;                    //~ ErrorFrozen:3 "may not be changed"
  printInt(*b);
}

// Moved away, and replaced whole
fn moveUnderShared() {
  mut a = Fin[1];
  imm r = &a;
  consume(a);                //~ ErrorFrozen:11 "may not be moved"
  printInt(r.n);
}

fn replaceUnderShared() {
  mut a = Fin[1];
  imm r = &a;
  a = Fin[2];                //~ ErrorFrozen:3 "may not be changed"
  printInt(r.n);
}

// Swapped while a mutable borrow is still to be used
fn swapUnderMut() {
  mut a = Fin[1];
  mut other = Fin[2];
  imm r = &mut a;
  a <=> other;               //~ ErrorFrozen:3 "may not be changed"
  r.n = 3;
}

// Borrowed read-only while a mutable borrow is still to be used
fn borrowUnderMut() {
  mut p = Pt[1, 2];
  imm r = &mut p;
  imm s = &p;                //~ ErrorFrozen:11 "may not be borrowed until"
  r.x = 2;
  printInt(s.x);
}

// A reborrow through a reference keeps what the reference borrowed frozen:
// the local itself, not what the reference points at (which the reference
// may still write, as ref_freeze_success shows)
fn reborrowKeepsLocalFrozen() {
  mut k = 1;
  imm r = &mut k;
  imm r2 = &mut *r;
  k = 2;                     //~ ErrorFrozen:3 "'k' is borrowed mutably"
  *r2 = 3;
}

// -------- through a shared path: only the owner's liveness --------

fn consumeOwner(p +so-mut Pt) {}

struct Holder { pub p +rc-mut Pt; }

// A field borrowed through a '+so-mut' owner, then the owner moved away. (A
// '+rc-mut' owner is copied, not moved, and a copy keeps the value alive.)
fn sharedOwnerMoved() {
  imm u = +so-mut Pt[1, 2];
  imm b = &mut u.x;
  consumeOwner(u);           //~ ErrorFrozen:16 "'u' is borrowed mutably"
  *b = 3;
}

// ... replaced whole, which releases what the borrow points into
fn sharedOwnerReplaced() {
  mut u = +rc-mut Pt[1, 2];
  imm b = &u.x;
  u = +rc-mut Pt[3, 4];      //~ ErrorFrozen:3 "may not be changed"
  printInt(*b);
}

// ... changed where it is held: the field holding the owner is on the way to
// the borrow, not behind the shared path
fn sharedOwnerFieldReplaced() {
  mut h = Holder[+rc-mut Pt[1, 2]];
  imm b = &mut h.p.x;
  h.p = +rc-mut Pt[3, 4];    //~ ErrorFrozen:4 "may not be changed"
  *b = 5;
}

// ... or borrowed mutably there, which could replace it the same way
fn sharedOwnerFieldBorrowed() {
  mut h = Holder[+rc-mut Pt[1, 2]];
  imm b = &mut h.p.x;
  imm hp = &mut h.p;         //~ ErrorFrozen:12 "may not be borrowed mutably"
  *b = 5;
  *hp = +rc-mut Pt[5, 6];
}

// ... or ended while a variable declared outside its block still holds the
// borrow
fn sharedOwnerEnds() {
  mut zero = 0i64;
  mut r &mut i64 = &mut zero;
  {
    imm u = +rc-mut Pt[1, 2];    //~ ErrorFrozen:9 "goes out of scope while"
    imm b &mut i64 = &mut u.x;
    r = b;
  }
  *r = 4;
}

// The source goes out of scope while a variable declared outside its block
// still holds a borrow of it
fn scopeEnds() {
  mut zero = 0i64;
  mut r &i64 = &zero;
  {
    mut a = 1i64;            //~ ErrorFrozen:9 "goes out of scope while"
    imm b &i64 = &a;
    r = b;
  }
  printInt(*r);
}
