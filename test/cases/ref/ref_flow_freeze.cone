// A borrow held in a local freezes its source until the borrow's last use.
// A local is a 'uni' source: a read-only borrow lets it be read and borrowed
// read-only again, but not changed, moved or ended. A mutable borrow ('mut') of
// it is an alias loan, as a borrow through a shared path is, so it freezes only
// what needs the source unique: the source may not be moved, replaced or ended,
// nor lent '&uni' or '&imm' (ref_alias_mut_success runs what it allows: the
// source read, written and borrowed again, several such borrows at once). A
// source reached through a shared path -- a 'Rc[mut, T]' owner, a '&mut'
// reference -- others may read and change anyway, so a borrow of it needs only
// that it stays alive: the owner may not be moved, replaced, changed where it
// is held, or ended.
// Each function here touches the source while a borrow of it is still to be
// used, and the error is reported at the touch, naming the borrow and its
// next use.
//
// Each has a function of its own, so that one borrow's conflicts cannot stand
// in for another's. What stays allowed -- the same touches after the borrow's
// last use, reads under a read-only borrow, disjoint fields, a holder
// reassigned first -- is ref_freeze_success. The loop's back edge is
// ref_flow_freeze_loop.

mod ref_flow_freeze;

import stdio use *;

struct Pt { pub x: i64; pub y: i64; }

// A value with a finalizer, so that moving it and replacing it are moves
struct Fin {
  pub n: i64;
  fn final(self: &uni) {}
}

fn consume(f: Fin) {}

// Changed while a read-only borrow is still to be used: by assignment, and by
// an operator that changes it in place
fn writeUnderShared() {
  var k = 5;
  let b = &k;
  k = 6;                     //~ ErrorFrozen:3 "may not be changed"
  k += 1;                    //~ ErrorFrozen:3 "may not be changed"
  printInt(*b);
}

// Moved away, and replaced whole
fn moveUnderShared() {
  var a = Fin(1);
  let r = &a;
  consume(a);                //~ ErrorFrozen:11 "may not be moved"
  printInt(r.n);
}

fn replaceUnderShared() {
  var a = Fin(1);
  let r = &a;
  a = Fin(2);            //~ ErrorFrozen:3 "may not be changed"
  printInt(r.n);
}

// Swapped while a mutable borrow is still to be used
fn swapUnderMut() {
  var a = Fin(1);
  var other = Fin(2);
  let r = &mut a;
  a <=> other;               //~ ErrorFrozen:3 "may not be changed"
  r.n = 3;
}

// Lent '&imm' or '&uni' while a mutable borrow is still to be used: an '&imm'
// borrow promises nobody changes what it borrows, and an '&uni' that nobody
// else reaches it, which a mutable borrow held beside it would break
fn immUnderMut(p: &uni Pt) i64 {
  let r = &mut *p;
  let s = &imm *p;           //~ ErrorFrozen:11 "may not be borrowed as 'imm'"
  r.x = 2;
  s.x
}

fn uniUnderMut(p: &uni Pt) i64 {
  let r = &mut *p;
  let s = &uni *p;           //~ ErrorFrozen:11 "may not be borrowed as 'uni'"
  r.x = 2;
  s.x
}

// A reborrow through a reference keeps what the reference borrowed alive: the
// local may not end while the reborrow is used
fn reborrowKeepsLocalAlive() {
  var zero = 0i64;
  var r: &mut i64 = &mut zero;
  {
    var k = 1i64;            //~ ErrorFrozen:9 "goes out of scope while"
    let r1 = &mut k;
    r = &mut *r1;
  }
  *r = 3;
}

// -------- through a shared path: only the owner's liveness --------

fn consumeOwner(p: Uni[Pt]) {}

struct Holder { pub p: Rc[mut, Pt]; }

// A field borrowed through a 'Uni[T]' owner, then the owner moved away. (A
// 'Rc[mut, T]' owner is copied, not moved, and a copy keeps the value alive.)
fn sharedOwnerMoved() {
  let u = Uni[Pt](1, 2);
  let b = &mut u.x;
  consumeOwner(u);           //~ ErrorFrozen:16 "'u' is borrowed mutably"
  *b = 3;
}

// ... replaced whole, which releases what the borrow points into
fn sharedOwnerReplaced() {
  var u = Rc[mut, Pt](1, 2);
  let b = &u.x;
  u = Rc[mut, Pt](3, 4);      //~ ErrorFrozen:3 "may not be changed"
  printInt(*b);
}

// ... changed where it is held: the field holding the owner is on the way to
// the borrow, not behind the shared path
fn sharedOwnerFieldReplaced() {
  var h = Holder(Rc[mut, Pt](1, 2));
  let b = &mut h.p.x;
  h.p = Rc[mut, Pt](3, 4);    //~ ErrorFrozen:4 "may not be changed"
  *b = 5;
}

// ... or borrowed mutably there, which could replace it the same way
fn sharedOwnerFieldBorrowed() {
  var h = Holder(Rc[mut, Pt](1, 2));
  let b = &mut h.p.x;
  let hp = &mut h.p;         //~ ErrorFrozen:12 "may not be borrowed mutably"
  *b = 5;
  *hp = Rc[mut, Pt](5, 6);
}

// ... or ended while a variable declared outside its block still holds the
// borrow
fn sharedOwnerEnds() {
  var zero = 0i64;
  var r: &mut i64 = &mut zero;
  {
    let u = Rc[mut, Pt](1, 2);    //~ ErrorFrozen:9 "goes out of scope while"
    var b: &mut i64 = &mut zero;
    b = &mut u.x;
    r = b;
  }
  *r = 4;
}

// The source goes out of scope while a variable declared outside its block
// still holds a borrow of it. Handed straight to 'r', the borrow would be
// refused by the lifetime check, as would a 'b' initialized with it (a local
// keeps its initializer's lifetime, declared type or not). Reassigned, 'b'
// keeps its initializer's lifetime and not the one it now holds, so the store
// is let through and the scope's end is what refuses it.
fn scopeEnds() {
  var zero = 0i64;
  var r: &i64 = &zero;
  {
    var a = 1i64;            //~ ErrorFrozen:9 "goes out of scope while"
    var b: &i64 = &zero;
    b = &a;
    r = b;
  }
  printInt(*r);
}

// A binding into an enum's variant, narrowed from a borrow of a local, is
// followed by the enum rule, as one narrowed through a shared path is: the local
// is no longer frozen against being written (the borrow is an alias loan), and
// what is refused is a change of variant while the binding is still to be used
// (enum_typecheck_narrow allows the narrowing since the variant cannot change
// underneath). Reported where the binding is used again, naming the change
enum Sh {
  struct Ci { pub r: i64; }
  struct Re { pub w: i64; }
}

fn variantChangedUnderBinding(v: Sh) i64 {
  var s = v;
  match &mut s {
    case var c &mut Ci { s = Sh.Re(2); c.r }   //~ ErrorVariantReshape:40 "which could change which variant the 'Sh' value holds"
    else { 0 }
  }
}

fn resetSh(s: &mut Sh) { *s = Sh.Re(3); }

// ... by a call handed another '&mut' of the enum
fn variantChangedByCall(v: Sh) i64 {
  var s = v;
  match &mut s {
    case var c &mut Ci { resetSh(&mut s); c.r }   //~ ErrorVariantReshape:43 "which could change which variant the 'Sh' value holds"
    else { 0 }
  }
}

// ... or of an enum held in a field
struct ShapeBag { pub shape: Sh; }

fn variantChangedInField(v: Sh) i64 {
  var h = ShapeBag(v);
  match &mut h.shape {
    case var c &mut Ci { h.shape = Sh.Re(2); c.r }   //~ ErrorVariantReshape:46 "which could change which variant the 'Sh' value holds"
    else { 0 }
  }
}

// -------- what a mutable borrow still keeps the local from --------

// Moved away while a mutable borrow is still to be used
fn moveUnderMut() {
  var a = Fin(1);
  let r = &mut a;
  consume(a);                //~ ErrorFrozen:11 "may not be moved"
  r.n = 3;
}

// Replaced whole (its old value finalized)
fn replaceUnderMut() {
  var a = Fin(1);
  let r = &mut a;
  a = Fin(2);            //~ ErrorFrozen:3 "may not be changed"
  r.n = 3;
}
