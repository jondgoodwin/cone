// A slice's method called on a '&uni' slice (ref_unislicemethod) borrows from it,
// so the loan is the borrow's like any other: while an element or a sub-slice
// borrowed '&uni' from the slice is still to be used, the slice may not be
// borrowed again for 'len', not even read-only, and a '&uni' slice cannot be had
// from a '&' or a '&mut' one. Each is one function so that one conflict cannot
// stand in for another.

mod ref_flow_unislicemethod;

fn lenWhileElement(s &uni Array[i64]) usize {
  imm e = &uni s[0usize];
  imm n = s.len();                 //~ ErrorFrozen:11 "may not be borrowed"
  *e = 1;
  n;
}

fn lenWhileSubSlice(s &uni Array[i64]) usize {
  imm h = &uni s[0usize..2usize];
  imm n = s.len();                 //~ ErrorFrozen:11 "may not be borrowed"
  h[0usize] = 1;
  n;
}

fn lenInsideCall(s &uni Array[i64]) {
  setAll(&uni s[0usize..], s.len());   //~ ErrorFrozen:28 "may not be borrowed"
}

fn setAll(s &uni Array[i64], n usize) {}

fn main() {
}
