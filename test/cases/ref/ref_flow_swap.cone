// A swap is a store in both directions, so each side is held to the lifetime
// rule assignment applies: neither may keep a borrowed reference it receives
// from the other past what that reference points at.
//
// ref_flow asserts the rule for 'r = t'. swapFlow checked only that both sides
// were writable, so 'r <=> t' -- which leaves r holding exactly what 'r = t'
// would -- compiled clean, and r pointed at 'inner' after its block had ended.
// swapFlow now runs assignment's check (assignBorrowLifetimeCheck) once for
// each direction, which holds a place outliving the function -- what a
// parameter points at, a global -- to the lifetime of the borrow it receives.
// Two variables of the function exchange what they hold, as the loan walk
// follows it: a variable's lifetime follows what it holds now, so the side
// kept past the source and used there is refused at the source's end, in
// either position.
//
// Every diagnostic here is a flow diagnostic, so the swaps share a function,
// but for the store through a parameter, which the walk would not reach
// beside it.

mod ref_flow_swap;

struct Pt { pub x: i32; pub y: i32; }

// A borrow handed back by a call, as an arena's 'alloc' hands back a borrow of
// the arena: the call's result carries its receiver's borrow
struct Holder {
  pub pt: Pt;
  pub fn get(self: &mut) &mut Pt { &mut self.pt }
}

fn swaps() i32 {
  var outer = Pt(0, 0);
  var r = &mut outer;
  var arr: Array[i32, 2] = [0, 0];
  var slice = &[]mut arr;
  var seen = 0;

  // The outer variable receives a borrow of 'inner'
  {
    var inner = Pt(1, 2);       //~ ErrorFrozen
    var t = &mut inner;
    r <=> t;
  }
  seen = seen + r.x;

  // ... in either position
  {
    var inner = Pt(1, 2);       //~ ErrorFrozen
    var t = &mut inner;
    t <=> r;
  }
  seen = seen + r.x;

  // A borrow a method call returned, of a local of this block
  {
    var h = Holder(Pt(3, 4)); //~ ErrorFrozen
    var hp = h.get();
    r <=> hp;
  }
  seen = seen + r.x;

  // A slice borrows exactly as a single reference does
  {
    var innerArr: Array[i32, 2] = [1, 2]; //~ ErrorFrozen
    var s = &[]mut innerArr;
    slice <=> s;
  }
  seen = seen + slice[0];

  // What is not refused, and what makes the above a lifetime rule rather than
  // a refusal of swapping borrows: two borrows of the same scope, an inner
  // variable holding a borrow of the outer scope, and an outer variable
  // given an inner borrow it does not keep past the block
  var outer2 = Pt(5, 6);
  var r2 = &mut outer2;
  r <=> r2;
  {
    var outer3 = Pt(7, 8);
    var u = &mut outer3;
    u <=> r2;
    seen = seen + u.x;
    var inner2 = Pt(7, 8);
    var t2 = &mut inner2;
    r2 <=> t2;
    seen = seen + r2.x;
  }
  seen + r.x
}

// Through a parameter: what it points at outlives the call, so it may not
// receive a borrow of this function's local
fn swapsThroughParameter(p: &mut &mut Pt) {
  var inner = Pt(1, 2);
  var t = &mut inner;
  *p <=> t;                         //~ ErrorInvType "lval outlives the borrowed reference you are storing"
}
