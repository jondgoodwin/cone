// A swap is a store in both directions, so each side is held to the lifetime
// rule assignment applies: neither may outlive a borrowed reference it receives
// from the other.
//
// ref_flow asserts the rule for 'r = t'. swapFlow checked only that both sides
// were writable, so 'r <=> t' -- which leaves r holding exactly what 'r = t'
// would -- compiled clean, and r pointed at 'inner' after its block had ended.
// swapFlow now runs assignment's check (assignBorrowLifetimeCheck) once for
// each direction. The diagnostic lands on whichever side outlives what it
// receives, in either position.
//
// Every diagnostic here is a flow diagnostic, so the swaps share one function.

mod ref_flow_swap;

struct Pt { pub x i32; pub y i32; }

// A borrow handed back by a call, as an arena's 'alloc' hands back a borrow of
// the arena: the call's result carries its receiver's scope
struct Holder {
  pub pt Pt;
  pub fn get(self &mut) &mut Pt { &mut self.pt; }
}

fn swaps() {
  mut outer = Pt[0, 0];
  mut outer2 = Pt[5, 6];
  mut r = &mut outer;
  mut r2 = &mut outer2;
  mut arr [2; i32] = [0, 0];
  mut slice = &[]mut arr;
  {
    mut inner = Pt[1, 2];
    mut t = &mut inner;

    // The outer variable would receive a borrow of 'inner'
    r <=> t;                        //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"

    // ... in either position
    t <=> r;                        //~ ErrorInvType:11 "lval outlives the borrowed reference you are storing"

    // A borrow a method call returned, of a local of this block
    mut h = Holder[Pt[3, 4]];
    mut hp = h.get();
    r <=> hp;                       //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"

    // A slice borrows exactly as a single reference does
    mut innerArr [2; i32] = [1, 2];
    mut s = &[]mut innerArr;
    slice <=> s;                    //~ ErrorInvType:5 "lval outlives the borrowed reference you are storing"

    // What is not refused, and what makes the above a lifetime rule rather than
    // a refusal of swapping borrows: two borrows of the same scope, and an
    // inner variable holding a borrow of the outer scope, which each side
    // then outlives nothing it receives
    r <=> r2;
    mut u = &mut outer2;
    r <=> u;
    mut inner2 = Pt[7, 8];
    mut t2 = &mut inner2;
    t <=> t2;
  }
}
