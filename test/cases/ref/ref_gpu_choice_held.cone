// On a GPU target a reference held in a variable may not be given different
// places on paths that meet, and then used: that use is a choice made at run
// time. Each is refused at the use, as a frozen borrow is, so a variable
// reassigned before its next use is no choice (module_target_spirv_kinds).

mod ref_gpu_choice_held;

var @threadlocal total: f32 = 0.0;
var @threadlocal scale: f32 = 1.0;

// Given another place on one arm of an 'if'
fn afterIf(c: bool, x: f32) f32 {
  let a = x;
  var r = &a;
  if c {
    r = &scale;
  }
  *r  //~ ErrorGpuRefChoice "'r', used here"
}

// Two locals, one per arm, with no reference to a global at all
fn bothArms(c: bool, x: f32) f32 {
  var a = x;
  var b = x;
  var r = &mut a;
  if c {
    r = &mut a;
  }
  else {
    r = &mut b;
  }
  *r = 2.0;  //~ ErrorGpuRefChoice
  a + b
}

// Reassigned in a loop, and used on the next pass
fn aroundLoop(n: u32) f32 {
  let a = 1.0f;
  var r = &a;
  var sum = 0.0f;
  var i = 0u32;
  while i < n {
    sum = sum + *r;  //~ ErrorGpuRefChoice
    r = &total;
    i = i + 1;
  }
  sum
}

// The refusals are for the code a kernel runs: this kernel reaches every
// function above
fn @compute(64) reaches(inv: Invocation, xs: &Array[f32], out: &mut Array[f32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < xs.len {
    let c = i % 2usize == 0usize;
    let x = xs[i];
    out[i] = afterIf(c, x) + bothArms(c, x) + aroundLoop(inv.globalId[0]);
  }
}
