// A function-reference type whose parameters are written as their types alone,
// with no names: '&fn(u32) u32', as doc/reference/reffnref.html writes it.
//
// Each parameter type below is a different shape to the parser, because a
// parameter normally opens with its name: a built-in type's name, a struct's
// name (a lone name, read as a type only once no body follows the signature),
// a reference type, a generic instance ('Cell[i32]', a name followed by type
// arguments, not an array type), an array type, and another function-reference
// type. Named and unnamed parameters may be mixed, and the names, where given,
// play no part in the type: a function or an anonymous function whose
// parameters are named is passed where the unnamed type is wanted.
//
// The function-reference parameter is last in every list: after '&fn(..) R', a
// comma would be read as a second return type.

mod ref_fnref_unnamed;

import stdio use *;

struct Vec3 {
  pub x i32;
  pub y i32;
  pub z i32;
}

struct Cell[T] {
  pub v T;
}

// A field of unnamed function-reference type, in a struct other than the one
// the parameter names
struct Shape {
  pub size i32;
  pub measure &fn(Vec3) i32;
  pub measureRef &fn(&Vec3, i32) i32;

  // A method's parameter of unnamed function-reference type: the lone name
  // is Vec3, not the Self a method's untyped parameter would be
  pub fn apply(self &, v Vec3, f &fn(Vec3) i32) i32 {
    f(v) + size;
  }
}

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// The reference manual's example
fn incr(nbr u32) u32 {
  nbr + 1u;
}
fn dostuff(fnref &fn(u32) u32) u32 {
  fnref(4u);
}

fn sumOf(v Vec3) i32 { v.x + v.y + v.z; }
fn scaledX(v &Vec3, k i32) i32 { v.x * k; }
fn cellTwice(c Cell[i32]) i32 { c.v * 2; }
fn firstPlusSecond(a Array[i32, 2]) i32 { a[0] + a[1]; }

fn withCell(n i32, f &fn(Cell[i32]) i32) i32 { f(Cell[i32][n]); }
fn withArray(f &fn(Array[i32, 2]) i32) i32 { f([10, 20]); }
fn withNamedArray(f &fn(xs Array[i32, 2]) i32) i32 { f([3, 4]); }
fn withMixed(f &fn(n u32, u32) u32) u32 { f(5u, 6u); }
fn withNested(n u32, f &fn(u32, &fn(u32) u32) u32) u32 { f(n, &incr); }

fn applyTwice(n u32, g &fn(u32) u32) u32 { g(g(n)); }

// In a return type, where the block after the signature is the declared
// function's own
fn pick() &fn(u32) u32 { &incr; }

fn main() {
  show("manual-dostuff", i64[dostuff(&incr)]);
  show("manual-dostuff-anonymous", i64[dostuff(&fn(nbr u32) u32 {nbr + nbr;})]);

  imm v = Vec3[1, 2, 3];
  imm shape = Shape[100, &sumOf, &scaledX];
  imm measure = shape.measure;
  show("field-struct-parm", i64[measure(v)]);
  imm measureRef = shape.measureRef;
  show("field-ref-parm", i64[measureRef(&v, 7)]);
  show("method-fnref-parm", i64[shape.apply(v, &sumOf)]);

  show("generic-instance-parm", i64[withCell(21, &cellTwice)]);
  show("array-parm", i64[withArray(&firstPlusSecond)]);
  show("named-array-parm", i64[withNamedArray(&firstPlusSecond)]);
  show("mixed-parms", i64[withMixed(&fn(a u32, b u32) u32 {a * b;})]);
  show("nested-fnref-parm", i64[withNested(9u, &applyTwice)]);
  imm picked = pick();
  show("returned-fnref", i64[picked(3u)]);
}
