// A borrow's next use may be on the loop's next iteration, or after the loop,
// reached by a path the walk follows around the back edge, through a
// 'continue', or out through a 'break'. The function here ends the source while
// such a use is still to come. (A 'mut' borrow of a local lets the local be
// read and written beside it, around the back edge, through a 'continue' and
// out through a 'break' as anywhere: ref_alias_mut_success runs those.)
//
// Separate from ref_flow_freeze because the case is about which path reaches
// the use, not what the touch was. The lenient loops -- a borrow used only
// through itself around the back edge, one dead before each iteration's
// change -- are in ref_freeze_success.

mod ref_flow_freeze_loop;

import stdio use *;

// The source's block ends at a 'break' while the borrow lives on outside. The
// borrow reaches 'r' through a reassigned 'b', which keeps the lifetime of its
// initializer and not of what it holds, so the lifetime check lets 'r = b'
// through and the scope's end is what refuses it (ref_flow_freeze, scopeEnds)
fn endsAtBreak(c bool) {
  var zero = 0i64;
  var r &i64 = &zero;
  while c {
    var a = 1i64;            //~ ErrorFrozen:9 "goes out of scope while"
    var b &i64 = &zero;
    b = &a;
    r = b;
    if c {
      break;
    }
  }
  printInt(*r);
}
