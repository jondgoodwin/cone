// A function reference meets the signature it is wanted as by the one rule every
// callable meets a signature by (fnSigMeets, as a method meets a trait's): beside a
// recast of its types, the lifetimes it promises are the wanted type's or more, so
// a function whose result holds FEWER borrows than the type says it may stands for
// it. Before, the lifetimes had to agree exactly. A call through the type is
// checked against what it says may flow into the result, and a function that
// returns only 'a' flows less. ref_typecheck_fnref_lifetimes holds the opposite,
// refused.

mod ref_fnref_lifetimes;

import stdio use *;

// Holds only a: less than the wanted type says
fn first(a: &i64, b: &'b i64) &i64 { a }

// Holds either: the wanted type's own
fn either(a: &i64, b: &i64) &i64 { if *a < *b {a} else {b} }

fn apply(f: &fn(a: &i64, b: &i64) &i64, a: &i64, b: &i64) i64 {
  *f(a, b)
}

// The same, taken from a variable
fn viaVariable(a: &i64, b: &i64) i64 {
  let f: &fn(a: &i64, b: &i64) &i64 = &first;
  *f(a, b)
}

fn main() {
  let x = 4i64;
  let y = 9i64;
  print <- apply(&first, &x, &y), "\n";
  print <- apply(&either, &x, &y), "\n";
  print <- viaVariable(&y, &x), "\n";
}
