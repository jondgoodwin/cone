// A function-reference type's parameter written as a lone name is an unnamed
// parameter of the type that name names ('&fn(Vec3) f32'), so a lone name that
// names no type is reported as the unknown name it is.
//
// Name-resolution stage.

mod ref_nameres_fnref;

// Not a parameter named 'x' with no type
fn take(f &fn(x) i32) {}  //~ ErrorUnkName:15 "The name x does not refer to a declared name"

// Nor a method's parameter whose type is inferred as Self: in a struct's field
// or a method's signature, 'self' alone names no type ('Self' does)
struct S {
  pub a i32;
  pub f &fn(self) i32;  //~ ErrorUnkName:13 "The name self does not refer to a declared name"
  fn m(self, g &fn(self) i32) {}  //~ ErrorUnkName:20 "The name self does not refer to a declared name"
}
