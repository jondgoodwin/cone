// What may be borrowed from, and what may be dereferenced.
//
// Type-check stage only, and separate from ref_typecheck_perm because these
// two families answer different questions: this file asks whether there is a
// place to point at and something to point through, that one asks what the
// pointer is then allowed to do. Neither carries a flow-stage expectation,
// because flow analysis is skipped for every function once any error has been
// reported; those live in ref_flow.

mod ref_typecheck_borrow;

fn twice(n u32) u32 { n * 2u; }

struct Counter {
  pub n i32;
  pub fn doubled(self) i32 {n + n;}
}

// A borrow of a computed value, a literal, a method's result ('&c.doubled()'
// borrows what the method returned, not 'c') or a construction borrows a
// temporary, kept to the end of its statement, or of its block where a
// variable's initializer extends it, as Rust keeps one: none is refused here
// (lifetime_mix_temp_borrowed_argument, lifetime_mix_temp_borrow_extended).

// '&g[i]' hands the type's own '&[]' the read-only borrow '&g' as its receiver.
// A '&[]' declaring 'self &mut' refuses it, as a read-only reference is refused
// by any 'self &mut' method, whether 'g' is a mutable value or a read-only
// parameter. The message names the spellings that work: 'g[i]' reads the
// element, and '&mut g[i]' borrows it where 'g' is mutable.
struct Grid {
  pub mut cells Array[i32, 4];
  pub fn `[]`(self, index usize) i32 { cells[index]; }
  pub fn `&[]`(self &mut, index usize) &mut i32 { &mut cells[index]; }
}

fn borrowIndexReadOnlyValue() {
  mut g = new Grid(cells: [1, 2, 3, 4]);
  imm r = &g[1usize];    //~ ErrorNoCandidate:13 "`&x[i]` hands `&[]` a read-only receiver, and this type's `&[]` takes `self &mut`. Write `x[i]` to read the element, or `&mut x[i]`"
  imm v = g[1usize];
  imm w = &mut g[1usize];
}

fn borrowIndexReadOnlyParam(g &Grid, i usize) {
  imm r = &g[i];         //~ ErrorNoCandidate:13 "hands `&[]` a read-only receiver"
  imm v = g[i];
}

// Dereference needs a reference or a pointer. A number is neither.
fn derefNumber() {
  mut a = 3;
  imm v = *a;            //~ ErrorNotPtr:11 "May only de-reference a simple reference or pointer"
}

// Resolving the alias at the dereference does not make an alias of a number
// into something that can be dereferenced. The chain is followed to its end, so
// an alias of an alias is refused on the same terms.
alias Num = i32;
alias Twice = Num;

fn derefAliasedNumber() {
  imm a Num = 3;
  imm v = *a;            //~ ErrorNotPtr:11 "May only de-reference a simple reference or pointer"
  imm b Twice = 4;
  imm w = *b;            //~ ErrorNotPtr:11
}

// One '*' per level of reference: '&i32' has exactly one to give
fn derefTooFar() {
  mut a = 3;
  imm r = &a;
  imm v = **r;           //~ ErrorNotPtr:11 "May only de-reference a simple reference or pointer"
}

// A reference's value type is part of its type, so a reference to one number
// type is not a reference to another
fn wrongValueType() {
  mut a = 3;
  imm r &f32 = &a;       //~ ErrorInvType:16 "Initialization value's type does not match variable's declared type"
}

// A function reference points at code, so there is no value behind it to name.
// Dereferencing it leaves a function signature, which is one of the five ways
// a type cannot report a size, and the diagnostic says which.
fn derefFunctionRef() {
  imm f = &twice;
  imm g = *f;            //~ ErrorNoSize:7 "a function signature is not a value at all"
}

// An inline function has no code of its own: its body is copied into each
// caller and no symbol is emitted, so there is nothing for a reference to
// point at. The refusal is the same wherever the borrow is written -- an
// initializer, an argument, a return value, or an anonymous 'inline' function
// borrowed where it is written. Passing a bare 'incr' where a reference is
// expected is refused already, for any function: a name is never auto-borrowed.
fn incr(n i32) i32 inline { n + 1; }
fn applyTo(n i32, f &fn(n i32) i32) i32 { f(n); }
alias Incr = &fn(n i32) i32;

fn borrowInlineInit() {
  imm r = &incr;         //~ ErrorInlineRef:12 "May not borrow a reference to an inline function"
}

fn borrowInlineArg() i32 {
  applyTo(3, &incr);     //~ ErrorInlineRef:15
}

fn borrowInlineReturn() Incr {
  &incr;                 //~ ErrorInlineRef:4
}

fn borrowInlineAnon() {
  imm r = &fn(n i32) i32 inline { n + 1; };  //~ ErrorInlineRef:12
}
