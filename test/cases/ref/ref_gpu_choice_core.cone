// A kernel reaching a function of core's own that chooses a reference at run
// time is refused, as one reaching a function of the program's is: the rule is
// for the code a kernel runs, whoever wrote it. 'lines' is such a function now
// (its cursor's 'next' hands back a piece of the text or none), so the refusal
// is reported in core.cone, where no annotation can be written; cases.toml names
// its code and message. A kernel that reaches none of core's choices
// (ref_gpu_choice_unreached) is accepted.

mod ref_gpu_choice_core;

fn @compute(64) viaCore(inv: Invocation, xs: &Array[f32], out: &mut Array[f32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < xs.len {
    var it = "ab\ncd".lines();
    match it.next() {
      case let Some(p) { out[i] = f32.from(p.len); }
      case is None { out[i] = 0.; }
    }
  }
}
