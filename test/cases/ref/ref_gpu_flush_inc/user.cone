// Package user, compiled on its own for a GPU target. Its global's inferred type
// is one the include file cannot spell (ErrorIncCheck, as in
// module_include_infer_reject), which fails the compile before generation. The
// choice of reference in 'pick', which no kernel reaches, is held by flow and
// is reported all the same.

mod user;

import coll;

pub var @threadlocal first = coll.Stack(1i64);  //~ ErrorIncCheck "cannot spell the type inferred from the value"

fn pick(c: bool, a: &f32, b: &f32) &f32 {
  if c {a} else {b}  //~ ErrorGpuRefChoice "what the parameter 'a' points at"
}
