// A call returning several borrowed references gives each of them the lifetime
// of the narrowest borrow the call was handed, exactly as a call returning one
// does.
//
// ref_flow_call is the single-value case: a call's returned borrow carries that
// narrowest scope on a reference node fnCallFinalizeArgs builds for the call,
// because the declared return type is one node every call site shares and holds
// the global scope. A call returning a tuple was left with that shared node, so
// every element of it read as a global reference: 'r1, r2 = two(&inner)' stored
// two borrows of a dead local into variables that outlive it, while both
// 'r1 = same(&inner)' and the directly written 'r1, r2 = &inner, &inner2'
// beside it were refused. assignMultRetFlow has always run the same per-lval
// check; it was reading scope 0 for every element. fnCallFinalizeArgs now builds
// the call its own tuple type, whose borrowed elements carry the call's scope.
//
// Returned, the elements are checked against the call's scope; kept in
// variables, they are followed by the loan walk, which gives each element the
// loans of every argument.
//
// Every diagnostic here is a flow diagnostic. Flow keeps going after one of its
// own within a function, so the stores share one function; the returning cases
// have their own, because a function has one return.

mod ref_flow_multiassign;

fn two(x &i32) &i32, &i32 { x, x; }
fn pick(a &i32, b &i32) &i32, &i32 { a, b; }
fn mixed(x &i32) &i32, i32 { x, 1; }
fn same(x &i32) &i32 { x; }

// The same signatures with the tuple named by an alias. An alias is
// transparent and nothing rewrites it away, so a return type written this
// way stands in the IR as the name it was written with, and both assignment
// paths resolve it to reach the element list: the type check asked whether the
// call's type was a tuple and the alias answered no, refusing the assignment
// for not having enough values, and the flow pass read the same field with no
// test at all. A call handed a borrow gets a tuple of its own, which is not the
// alias, so the lifetimes here were already read from a real tuple; a call
// handed none keeps the alias, which is why 'globalPairAlias' below is the one
// that could not be written at all.
alias RefPair = (&i32, &i32);
fn twoAlias(x &i32) RefPair { x, x; }

mut G i32 = 7;
fn globalPair() &i32, &i32 { &G, &G; }
fn globalPairAlias() RefPair { &G, &G; }

// Each element is kept in an outer variable past the block its argument lives
// in, and used there, so the argument may not end while it is still held, as
// ref_flow_call refuses 'r = same(&inner)' kept and used; the element kept in
// a variable of that block beside it is no trouble.
fn storesTupleResults() i32 {
  imm outer = 0;
  mut r1 &i32 = &outer;
  mut r2 &i32 = &outer;
  mut n i32 = 0;
  mut seen = 0;

  // A returned element carries the argument's borrow
  {
    imm inner = 1;                    //~ ErrorFrozen
    mut near &i32 = &inner;
    r1, near = two(&inner);
  }
  seen = seen + *r1;

  // ... and the second element is no different from the first
  {
    imm inner = 1;                    //~ ErrorFrozen
    mut near &i32 = &inner;
    near, r2 = two(&inner);
  }
  seen = seen + *r2;

  // Two borrows: every element carries both, whichever parameter the body
  // happens to return in which position
  {
    imm inner = 1;                    //~ ErrorFrozen
    mut near &i32 = &inner;
    r1, near = pick(&outer, &inner);
  }
  seen = seen + *r1;

  // The borrow survives a call nested in the call
  {
    imm inner = 1;                    //~ ErrorFrozen
    mut near &i32 = &inner;
    r1, near = two(same(&inner));
  }
  seen = seen + *r1;

  // A tuple mixing a borrow with a plain value
  {
    imm inner = 1;                    //~ ErrorFrozen
    r1, n = mixed(&inner);
  }
  seen = seen + *r1 + n;

  // The tuple named by an alias is refused on the same terms, in either
  // position, since resolving the name is all that stands between the
  // assignment and the element list
  {
    imm inner = 1;                    //~ ErrorFrozen
    mut near &i32 = &inner;
    r1, near = twoAlias(&inner);
  }
  seen = seen + *r1;
  {
    imm inner = 1;                    //~ ErrorFrozen
    mut near &i32 = &inner;
    near, r2 = twoAlias(&inner);
  }
  seen = seen + *r2;

  // What is not refused, and what makes the above a lifetime rule rather than
  // a refusal of multi-value assignment: elements borrowed from a global keep
  // their global lifetime, a call handed no borrow returns the declaration's
  // own global scope, borrows of the lvals' own scope are fine, and so is
  // holding both elements in variables of the block they were borrowed in
  {
    imm inner = 1;
    mut near &i32 = &inner;
    mut near2 &i32 = &inner;
    r1, r2 = two(&G);
    r1, r2 = globalPair();
    r1, r2 = two(&outer);
    near, near2 = two(&inner);
    r1, r2 = globalPairAlias();
    r1, r2 = twoAlias(&outer);
    near, near2 = twoAlias(&inner);
    seen = seen + *near + *near2;
  }
  seen + *r1 + *r2;
}

// Returning the tuple meets returnFlowEscape, as returning the single-value
// sibling of this call does in ref_flow_call. The elements have no expressions
// of their own to walk here, so the lifetimes are read from the call's type.
fn returnsTupleResult() &i32, &i32 {
  imm inner = 1;
  two(&inner);                        //~ ErrorEscape "Returned borrowed reference outlives the local value it points to"
}

// The other half: a parameter's borrows passed straight through stay returnable
fn returnsParameterPair(p &i32) &i32, &i32 {
  two(p);
}

// ... and so does a pair borrowed from a global
fn returnsGlobalPair() &i32, &i32 {
  globalPair();
}

// The return side through the alias, on both halves
fn returnsAliasedTupleResult() RefPair {
  imm inner = 1;
  twoAlias(&inner);                   //~ ErrorEscape "Returned borrowed reference outlives the local value it points to"
}

fn returnsAliasedGlobalPair() RefPair {
  globalPairAlias();
}
