// A choice of reference no kernel reaches is held until generation says what a
// kernel reaches (loanGpuHeldFlush). Generation fails here, on the global that
// holds a reference (ErrorGpuRefGlobal), before it ever walks a kernel's calls:
// the held refusal is reported all the same, so the compile fails with both.

mod ref_gpu_flush_gen;

let total: f32 = 0.0;

let held: &f32;  //~ ErrorGpuRefGlobal

fn pick(c: bool, a: &f32, b: &f32) &f32 {
  if c {a} else {b}  //~ ErrorGpuRefChoice "what the parameter 'a' points at"
}

fn @initpure init() {
  held = &total;
}

pub fn get() f32 {
  *held
}
