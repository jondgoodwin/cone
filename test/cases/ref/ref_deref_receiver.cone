// A method called on a written dereference of a borrowed reference,
// '(*r).get()', borrows the place the dereference names, as '(*r).s.get()' does:
// a '&' method through '&S' and '&mut S', a '&mut' method through '&mut S'.
// Printed values are checked by hand: n starts 1; set(2) makes it 2; get reads 2.
// The raw-pointer form '(*p).get()' is refused until 'trust' exists:
// ref_typecheck_deref_pointer_receiver.

mod ref_deref_receiver;

import stdio use *;

struct S {
  pub n: i64;
  pub fn get(self: &) i64 { n }
  pub fn set(self: &mut, v: i64) { n = v; }
}

fn viaImm(r: &S) i64 { (*r).get() }

fn viaMut(r: &mut S) i64 {
  (*r).set(2);
  (*r).get()
}

fn main() {
  var v = S(1);
  printInt(viaImm(&v));
  printStr("\n");
  printInt(viaMut(&mut v));
  printStr("\n");
  printInt(v.n);
  printStr("\n");
}
