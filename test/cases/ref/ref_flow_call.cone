// A borrowed reference returned through a call lives as long as the narrowest
// borrow the call was handed.
//
// ref_flow asserts the lifetime rule between two variables and ref_flow_return
// at a function's own return; this file is the call site. A function's declared
// return type is one node shared by every call, so it carries no scope of its
// own, and a call used to be typed with it directly: 'same(&inner)' read as a
// global reference, and storing or returning it past 'inner' compiled clean
// while 'r = &inner' in the same shape was refused. doc/reference/reflifefn.html
// gives the rule the compiler applies: without lifetime annotations, which have
// no syntax, every borrowed reference in a signature shares one lifetime, so a
// returned reference is understood to have the shortest lifetime among the
// borrowed-reference arguments. fnCallFinalizeArgs puts that scope on a
// reference node built for the call, where the return check and the store
// check read it; the loan walk carries every argument's loans into the result,
// so a result kept in a variable keeps its arguments' sources alive.
//
// Every diagnostic here is a flow diagnostic. Flow keeps going after one of its
// own within a function, so the stores share one function; the returning case
// has its own, because a function has one return.

mod ref_flow_call;

fn same(x &i32) &i32 { x; }
fn pick(a &i32, b &i32) &i32 { a; }
fn sameSlice(s &[]i32) &[]i32 { s; }
fn refstore(dst &mut &i32, src &i32) { *dst = src; }

mut G i32 = 7;
fn fromGlobal() &i32 { &G; }

struct S {
  pub x i32;
  pub fn get(self &) &i32 { &self.x; }
}

// Each result is kept in an outer variable past the block its argument lives
// in, and used there: the argument's variable may not end while it is still
// held, exactly as 'r = &inner' kept and used is refused in ref_flow. (Held
// and not used again, it may be: a variable's lifetime follows what it holds.)
fn storesCallResults() i32 {
  imm outer = 0;
  imm outerArr Array[i32, 2] = [0, 0];
  mut r &i32 = &outer;
  mut slice &[]i32 = &[]outerArr;
  mut seen = 0;

  // The call's result carries the argument's borrow
  {
    imm inner = 1;                  //~ ErrorFrozen
    r = same(&inner);
  }
  seen = seen + *r;

  // ... and keeps it through a call nested in a call
  {
    imm inner = 1;                  //~ ErrorFrozen
    r = same(same(&inner));
  }
  seen = seen + *r;

  // Two borrows: the result carries both, whichever parameter the body
  // happens to return
  {
    imm inner = 1;                  //~ ErrorFrozen
    r = pick(&outer, &inner);
  }
  seen = seen + *r;

  // A slice borrows exactly as a single reference does
  {
    imm innerArr Array[i32, 2] = [1, 2]; //~ ErrorFrozen
    slice = sameSlice(&[]innerArr);
  }
  seen = seen + slice[0];

  // A method call is a call: the receiver borrow is its first argument
  {
    imm s = new S(2);               //~ ErrorFrozen
    r = (&s).get();
  }
  seen = seen + *r;

  // What is not refused, and what makes the above a lifetime rule rather than
  // a refusal of calls: a borrow of a global keeps its global lifetime through
  // a call, a call handed no borrow returns one of the declaration's own
  // global scope, a borrow of the lval's own scope is fine, and so is holding
  // the result inside the block it was borrowed in
  {
    imm inner = 1;
    r = same(&G);
    r = fromGlobal();
    r = same(&outer);
    imm kept = same(&inner);
    seen = seen + *kept;
  }
  seen + *r + slice[0];
}

// Returning the call's result meets returnFlowEscape, as returning '&inner'
// would
fn returnsCallResult() &i32 {
  imm inner = 1;
  same(&inner);                     //~ ErrorEscape:7 "Returned borrowed reference outlives the local value it points to"
}

// The other half: a parameter's borrow passed straight through stays returnable
fn returnsParameterThroughCall(p &i32) &i32 {
  same(p);
}

// A '&mut &T' argument is a place the callee may store any other borrow it was
// handed, and without annotations nothing says it will not. Where it points at
// a local of this function, that is no error at the call: the local may now
// hold the borrow, and is held to it as a store written out would hold it --
// refused where it is used after the borrow's source ends, at that end
// (doc/reference/reflifefn.html, "Mutable borrowed reference parameters").
// Where it points at what a parameter points at, which outlives the
// function, a borrow of this function's own may not be handed beside it: the
// call is refused.
fn storesThroughMutableParameter(p &mut &i32) i32 {
  imm i = 5;
  mut a = &i;
  {
    imm b = 10;                     //~ ErrorFrozen "goes out of scope while 'a' still holds"
    mut c = &b;
    refstore(&mut a, &b);

    // Storing a longer-lived borrow, or storing into a place as short-lived as
    // the borrow, is always allowed
    refstore(&mut a, &i);
    refstore(&mut c, &i);
    refstore(&mut c, &b);
    refstore(p, &b);                //~ ErrorCallEscape:13 "Call could store a borrowed reference"
  }
  *a;
}
