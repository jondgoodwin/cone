// An owner held in a field, reached through a reference whose value others
// share (a '&mut', or a '&' that only reads), lends no '&uni' and no '&imm' of
// what it holds: a '&mut' lends '&mut' at most (mem-borrowing.html#freezing, "What a borrow leaves its source free to do"),
// since another name for the same holder can replace
// the owner while the loan is used. A receiver ('self: &uni'), an argument, a
// local's initializer and a borrow written out are all refused; so is the
// use-after-free the receiver form allowed, 'take' replacing the owner whose value
// it is still reading. ref_owner_field_shared runs what stays allowed.

mod ref_typecheck_owner_field_shared;

struct App {
  pub n: i64;
  pub fn take(self: &uni, other: &mut Holder) i64 { other.app = new Uni[App](9); n }
  pub fn takeUni(self: &uni) i64 { n }
}

struct Holder {
  pub app: Uni[App];
}

struct Outer {
  pub boxed: Uni[Holder];
}

fn needUni(a: &uni App) i64 { a.n }
fn needImm(a: &imm App) i64 { a.n }

fn viaMut(h: &mut Holder) i64 { h.app.takeUni() }                      //~ ErrorBadPerm:34 "Cannot lend `&uni` of this owner"
fn viaWritten(h: &mut Holder) i64 { (&uni *h.app).takeUni() }          //~ ErrorBadPerm:38 "Borrowed reference cannot obtain this permission"
fn viaInit(h: &mut Holder) i64 { let r: &uni App = h.app; r.takeUni() } //~ ErrorBadPerm:53 "Cannot lend `&uni` of this owner"
fn viaArg(h: &mut Holder) i64 { needUni(h.app) }                       //~ ErrorBadPerm:42 "Cannot lend `&uni` of this owner"
fn viaNested(o: &mut Outer) i64 { needUni(o.boxed.app) }               //~ ErrorBadPerm:50 "Cannot lend `&uni` of this owner"
fn viaImmInit(h: &mut Holder) i64 { let r: &imm App = h.app; r.n }      //~ ErrorBadPerm:56 "Cannot lend `&imm` of this owner"
fn viaImmArg(h: &mut Holder) i64 { needImm(h.app) }                    //~ ErrorBadPerm:45 "Cannot lend `&imm` of this owner"
fn viaImmWritten(h: &mut Holder) i64 { let r = &imm *h.app; r.n }      //~ ErrorBadPerm:48 "Borrowed reference cannot obtain this permission"
fn viaRead(h: &Holder) i64 { needImm(h.app) }                          //~ ErrorBadPerm:39 "Cannot lend `&imm` of this owner"

fn viaTwo(h: &mut Holder, h2: &mut Holder) i64 { h.app.take(h2) }      //~ ErrorBadPerm:51 "Cannot lend `&uni` of this owner"

fn main() {
  let a = new Rc[mut, Holder](new Holder(new Uni[App](5)));
  let b = a;
  viaTwo(&mut *a, &mut *b);
}
