// A plain '&' borrow is read-only but not 'imm', so where an '&imm' reference is
// wanted it is refused (ErrorInvType). The message says what to write: '&imm' on
// the borrowed value. Only the words are pinned here; which programs compile does
// not change.

mod ref_typecheck_imm_hint;

fn read(r: &imm i32) i32 { return *r; }

fn main() {
  let n: i32 = 5;
  let direct: &imm i32 = &n;  //~ ErrorInvType:26 "write `&imm n` to lend it as imm"
  let viaOption: Option[&imm i32] = Some(&n);  //~ ErrorInvType:41 "write `&imm n` to lend it as imm"
  let viaOptionQ: ?&imm i32 = Some(&n);  //~ ErrorInvType:35 "write `&imm n` to lend it as imm"
  read(&n);  //~ ErrorInvType:8 "write `&imm n` to lend it as imm"

  // The spelling the hint asks for is accepted
  let fixed: &imm i32 = &imm n;
  let fixedOption: Option[&imm i32] = Some(&imm n);
  read(&imm n);
}
