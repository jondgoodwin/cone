// The refusal of a reference chosen at run time is for GPU code, the functions a
// kernel runs. A plain function making the choice that no kernel calls is not
// refused (it has no GPU form to be wrong), and the kernel here, which does not
// call it, compiles. ref_gpu_choice_kernel has the same function called from a
// kernel, and refused.

mod ref_gpu_choice_unreached;

fn pick(c: bool, a: &f32, b: &f32) &f32 {
  if c {a} else {b}
}

fn @compute(64) plain(inv: Invocation, xs: &Array[f32], out: &mut Array[f32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < xs.len {
    out[i] = xs[i] * 2.;
  }
}
