// A '&uni' array or tuple element is seen where every reference on the way to it
// is 'uni', or what holds it is held by value (ref_typecheck_uni_elem_shared
// holds what a '&' or a '&mut' refuses). Read, wiped and replaced here.

mod ref_uni_elem_held;

import stdio use *;
import collections use *;

struct Item {
  pub n i64;
  fn final(self &uni) { printStr("[freed "); printInt(self.n); printStr("] "); }
}
struct App {
  pub items List[Item];
  pub fn wipe(self &mut) { items = List[Item].empty(); }
  pub fn count(self &) i64 { i64.from(items.len()); }
  pub fn first(self &) i64 { items[0usize].n; }
}
struct Pair['a] { pub cells Array[&'a uni App, 1]; }
struct Tup['a] { pub cells (i64, &'a uni App); }

// the first item (11) times 1000, plus what the list holds after the wipe (0)
fn viaUniPair(p &uni Pair) i64 {
  imm before = p.cells[0].first();
  p.cells[0].wipe();
  before * 1000 + p.cells[0].count();
}
fn viaUniTuple(t &uni Tup) i64 {
  imm before = t.cells.1.first();
  t.cells.1.wipe();
  before * 1000 + t.cells.1.count();
}
fn viaOwner(p So[Pair]) i64 { p.cells[0].first(); }
fn viaLocalArray(a &uni App) i64 {
  imm cells = [a];
  imm before = cells[0].count();
  cells[0].wipe();
  before * 100 + cells[0].count();
}
fn viaLocalTuple(a &uni App) i64 {
  imm t = (7, a);
  t.1.first() + t.0;
}
fn viaHeldPair(a &uni App) i64 {
  imm p = new Pair([a]);
  p.cells[0].first();
}

fn app(n i64) So[App] {
  mut l = List[Item].empty();
  l.push(new Item(n));
  new So[App](l);
}

fn main() {
  imm a1 = app(11);
  imm pair = new So[Pair](new Pair([a1]));
  printInt(viaUniPair(pair)); printStr("\n");
  imm a2 = app(22);
  imm tup = new So[Tup](new Tup((1, a2)));
  printInt(viaUniTuple(tup)); printStr("\n");
  imm a3 = app(33);
  imm owned = new So[Pair](new Pair([a3]));
  printInt(viaOwner(owned)); printStr("\n");
  imm a4 = app(44);
  printInt(viaLocalArray(a4)); printStr("\n");
  imm a5 = app(55);
  printInt(viaLocalTuple(a5)); printStr("\n");
  imm a6 = app(66);
  printInt(viaHeldPair(a6)); printStr("\n");
}
