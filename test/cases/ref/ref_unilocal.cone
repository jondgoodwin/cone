// A source reached as 'uni' is what a local variable is (mem-permissions.html#fromuni, "From uni, for a while"):
// a 'mut' local, or a field or element of one held by value, lends
// '&uni' while nothing else borrows it. The local is frozen against reading and
// changing until the borrow's last use, and usable again after it
// (ref_flow_unilocal refuses the touches in between; ref_typecheck_unilocal
// what cannot lend: an 'imm' local, a global, a place reached through a '&mut').
// This file runs what is allowed: a collection, a struct, an integer, an owner
// and a held reference as the local; a field, an element and two fields at once;
// a lend after a lend, a lend held in a local and used, a lend in a loop, and
// the sibling field of the one lent.

mod ref_unilocal;

import stdio use *;
import collections use *;

struct P { pub x i64; }
struct Pair { pub a i64; pub b i64; }
struct H { pub items List[i64]; pub n i64; }

fn pushOne(l &uni List[i64]) { l.push(7); }
fn bumpP(p &uni P) { p.x = p.x + 1; }
fn bumpN(n &uni i64) { *n = *n + 1; }
fn setBoth(x &uni i64, y &uni i64) { *x = 1; *y = 2; }
fn setRef(slot &uni (&mut i64), v &mut i64) { *slot = v; }
fn bumpOwner(o &uni So[P]) { o.x = o.x + 10; }

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// [1] -> [1, 7]: 2
fn collection() i64 {
  mut l = List[i64].empty();
  l.push(1);
  pushOne(&uni l);
  i64.from(l.len());
}

// {1} -> {2}: 2
fn structure() i64 {
  mut p = new P(1);
  bumpP(&uni p);
  p.x;
}

// 1 -> 3
fn integer() i64 {
  mut n i64 = 1;
  bumpN(&uni n);
  bumpN(&uni n);
  n;
}

// {0, 0} -> {1, 2}: 12 (distinct fields of a local lent to one call)
fn twoFields() i64 {
  mut p = new Pair(0, 0);
  setBoth(&uni p.a, &uni p.b);
  p.a * 10 + p.b;
}

// A field lent twice with the sibling field changed between: 2 items, n 1
fn field() i64 {
  mut h = new H(List[i64].empty(), 0);
  pushOne(&uni h.items);
  h.n = h.n + 1;
  pushOne(&uni h.items);
  i64.from(h.items.len()) * 10 + h.n;
}

// The sibling field changed while the lend is held, then the lend used: 1 item, n 1
fn sibling() i64 {
  mut h = new H(List[i64].empty(), 0);
  imm r = &uni h.items;
  h.n = h.n + 1;
  r.push(1);
  i64.from(h.items.len()) * 10 + h.n;
}

// [1, 2, 3] -> [1, 3, 3]: 3
fn element() i64 {
  mut a = [1i64, 2i64, 3i64];
  bumpN(&uni a[1usize]);
  a[1usize];
}

// Lent, used directly, lent and held, used, used directly again after the
// held lend's last use: 2 + 1 + 1 + 1 = 5 items
fn afterLastUse() i64 {
  mut l = List[i64].empty();
  pushOne(&uni l);
  pushOne(&uni l);
  l.push(5);
  imm u = &uni l;
  u.push(9);
  l.push(6);
  i64.from(l.len());
}

// Lent on every pass of a loop: 3 items
fn inLoop() i64 {
  mut l = List[i64].empty();
  mut i = 0;
  while i < 3 {
    pushOne(&uni l);
    i = i + 1;
  }
  i64.from(l.len());
}

// A reference held in a local is itself lent '&uni' and given another target
fn heldReference() i64 {
  mut a i64 = 1;
  mut b i64 = 2;
  mut r = &mut a;
  setRef(&uni r, &mut b);
  *r = 9;
  b;
}

// An owner held in a local, lent as the owner itself
fn owner() i64 {
  mut o = new So[P](1);
  bumpOwner(&uni o);
  o.x;
}

fn main() {
  show("collection", collection());
  show("structure", structure());
  show("integer", integer());
  show("twoFields", twoFields());
  show("field", field());
  show("sibling", sibling());
  show("element", element());
  show("afterLastUse", afterLastUse());
  show("inLoop", inLoop());
  show("heldReference", heldReference());
  show("owner", owner());
}
