// On a GPU target an array whose elements hold references must break into
// separate values, since no pointer can be kept in GPU memory, and only a
// literal or a constant index lets it: one known only at run time is refused.

mod ref_gpu_indexed;

mut total f32 = 0.0;

struct Cursor['a] {
  pub at &'a f32;
}

const Second = 1u32;

fn ofReferences(i u32, x f32) f32 {
  imm a = x;
  imm refs Array[&f32, 2] = [&a, &total];
  *refs[0] + *refs[Second] + *refs[i];  //~ ErrorGpuRefIndexed
}

fn ofCursors(i u32, x f32) f32 {
  imm a = x;
  imm cs Array[Cursor, 2] = [new Cursor(&a), new Cursor(&total)];
  *cs[i].at;  //~ ErrorGpuRefIndexed
}
