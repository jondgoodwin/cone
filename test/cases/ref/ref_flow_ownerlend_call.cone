// An owner lent where a '&' or '&mut' is wanted is borrowed from, and so is
// one lent as a method's 'self &' or 'self &mut' receiver: a 'So' owner is
// 'uni', and a 'uni' source lent to one call twice is a conflict where one of
// the lends needs the source unique, whether the borrows are written
// ('mutAndMove(&mut *a, a)') or made by the coercion. Each function below
// holds no written borrow at all, so the gate must see the implicit lend as it
// sees a written one: a lend meeting a move, and the receiver lent mutably
// beside an argument moving the same owner. A '&mut' lend beside a '&' or
// another '&mut' one is no conflict, as through a shared path it never was (the
// source is one more alias; ref_alias_mut_success runs them: a counted owner, a
// field of a local and of a '&uni' parameter lent twice too, a receiver lent
// mutably beside an argument that reads the same owner).
// Lends one after another, and two '&' lends to one call, are allowed too
// (ref_ownerlend_call runs them).
//
// One function per case, so that one borrow's conflict cannot stand in for
// another's.

mod ref_flow_ownerlend_call;

struct R {
  pub n i64;
  pub fn absorb(self &mut, o So[R]) { n = n + o.n; }
}

fn mutAndMove(x &mut R, y So[R]) {}

fn mutThenMove() {
  imm a = new So[R](1);
  mutAndMove(a, a);                //~ ErrorFrozen:17 "may not be moved"
}

fn receiverAndMove() {
  imm a = new So[R](1);
  a.absorb(a);                     //~ ErrorFrozen:12 "may not be moved"
}

fn main() {
}
