// An owner lent where a '&' or '&mut' is wanted is borrowed from, and so is
// one lent as a method's 'self &' or 'self &mut' receiver: a 'So' owner is
// 'uni', and a 'uni' source lent to one call twice is a conflict whether the
// borrows are written ('both(&mut *a, &*a)') or made by the coercion. Each
// function below holds no written borrow at all, so the gate must see the
// implicit lend as it sees a written one: a '&mut' lend meeting a '&' one, two
// '&mut' lends, a lend meeting a move, the receiver lent mutably beside an
// argument lending or moving the same owner, a counted owner still 'uni', and
// a field of a local and of a '&uni' parameter lent twice.
// Lends one after another, two '&' lends to one call, and a receiver lent
// mutably beside an argument that only reads it are allowed
// (ref_ownerlend_call runs them).
//
// One function per case, so that one borrow's conflict cannot stand in for
// another's.

mod ref_flow_ownerlend_call;

struct R {
  pub n i64;
  pub fn absorb(self &mut, o So[R]) { n = n + o.n; }
  pub fn peekMut(self &mut, o &R) { n = n + o.n; }
}

struct H {
  pub s So[R];
}

fn both(x &mut R, y &R) {}
fn twoMut(x &mut R, y &mut R) {}
fn mutAndMove(x &mut R, y So[R]) {}

fn mutAndRead() {
  imm a = +So R[1];
  both(a, a);                      //~ ErrorFrozen:11 "may not be borrowed"
}

fn mutTwice() {
  imm a = +So R[1];
  twoMut(a, a);                    //~ ErrorFrozen:13 "may not be borrowed mutably"
}

fn mutThenMove() {
  imm a = +So R[1];
  mutAndMove(a, a);                //~ ErrorFrozen:17 "may not be moved"
}

fn receiverAndMove() {
  imm a = +So R[1];
  a.absorb(a);                     //~ ErrorFrozen:12 "may not be moved"
}

fn receiverAndArgument() {
  imm a = +So R[1];
  a.peekMut(a);                    //~ ErrorFrozen:3 "as the call's receiver"
}

fn countedOwner() {
  imm a = +Rc R[1];
  both(a, a);                      //~ ErrorFrozen:11 "may not be borrowed"
}

fn localField() {
  imm h = new H(+So R[1]);
  both(h.s, h.s);                  //~ ErrorFrozen:14 "may not be borrowed"
}

fn uniParamField(h &uni H) {
  both(h.s, h.s);                  //~ ErrorFrozen:14 "may not be borrowed"
}

fn main() {
}
