// A method called on a written dereference of a raw pointer, '(*p).get()', is
// refused (1056): a pointer is never borrowed from, until 'trust' exists. The
// field form '(*p).s.get()' and the borrowed-reference form '(*r).get()'
// (ref_deref_receiver) compile.

mod ref_typecheck_deref_pointer_receiver;

struct S {
  pub n: i64;
  pub fn get(self: &) i64 { n }
}

fn viaPtr(p: *S) i64 {
  (*p).get()                  //~ ErrorNoCandidate:7
}

fn main() {}
