// On a GPU target no global may hold a reference: a pointer cannot be kept in
// GPU memory. A string literal is a reference to its text, so a global holding
// one is refused too; a byte array a literal fills is the text, and is no reference.

mod ref_gpu_global;

mut total f32 = 0.0;

struct Holder['a] {
  pub at &'a f32;
}

mut held &f32;  //~ ErrorGpuRefGlobal
mut wrapped Holder;  //~ ErrorGpuRefGlobal
imm greeting Array[u8, 5] = "hello";
imm label = "hello";  //~ ErrorGpuRefGlobal

fn @initpure init() {
  held = &total;
  wrapped = new Holder(&total);
}

pub fn get() f32 {
  *held + *wrapped.at;
}
