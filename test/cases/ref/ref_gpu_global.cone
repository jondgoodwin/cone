// On a GPU target no global may hold a reference: a pointer cannot be kept in
// GPU memory. A string literal's global is its text, and is no reference.

mod ref_gpu_global;

mut total f32 = 0.0;

struct Holder['a] {
  pub at &'a f32;
}

mut held &f32;  //~ ErrorGpuRefGlobal
mut wrapped Holder;  //~ ErrorGpuRefGlobal
imm greeting = "hello";

fn @initpure init() {
  held = &total;
  wrapped = new Holder(&total);
}

pub fn get() f32 {
  *held + *wrapped.at;
}
