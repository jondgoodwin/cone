// A reference type that never says what it refers to.
//
// '&' with no pointee parses: parseAmper lets a reference in a parameter
// position leave it to be inferred, which is how a method writes 'self &'.
// parseFnSig is the only thing that fills one in, it fills in 'Self', and it
// looks at the outer node's tag only -- so every spelling below arrives at type
// check still unknown. Each one used to reach genlType and kill the process on
// a NULL LLVM element type: no diagnostic, no exit code, nothing to assert.
//
// They are here together because they are one code with one cause reached four
// ways, and what a reader wants to check is that the nesting does not hide it.
// collection-typecheck-perm holds the slice spelling, '&[]', which is that
// group's.
//
// A regression here does not fail an assertion -- the process dies and takes
// every expectation in this file with it.

fn bare(s &) {                    //~ ErrorNoRefType "must specify the type it refers to"
  return
}

fn nested(s &&) {                 //~ ErrorNoRefType "must specify the type it refers to"
  return
}

fn inTuple(s (&, i32)) {          //~ ErrorNoRefType "must specify the type it refers to"
  return
}

fn behindPointer(s *&) {          //~ ErrorNoRefType "must specify the type it refers to"
  return
}

// The parameter that follows is what shows the signature is not abandoned: the
// incomplete type is one parameter's, and the rest of the list still parses
fn withMore(s &, t i32) {         //~ ErrorNoRefType "must specify the type it refers to"
  return
}
