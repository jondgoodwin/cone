// A '&uni' field is seen -- read, lent or written -- only where every reference
// on the way to it is 'uni' too, or the struct holding it is held by value
// (refperm.html, "Viewpoint Adaptation": a shared reference cannot see through a
// uni reference). Through a '&' or a '&mut' another name could reach the same
// struct, and the one reference that promised to be unique would be reached by
// both: 'a.holder.items[0]' borrowed through one '&mut Cell', then
// 'b.holder.wipe()' through a second, called with the same cell twice, frees the
// element that borrow still reads. Each access below is refused alone; the
// functions at the end are what stays allowed.

mod ref_typecheck_uni_field_shared;

import collections use *;

struct Item { pub n i64; }
struct App {
  pub items List[Item];
  pub fn wipe(self &mut) { items = List[Item].empty(); }
  pub fn count(self &) usize { items.len(); }
}
struct Cell['a] { pub holder &'a uni App; }
struct Pair['a] { pub cell Cell['a]; }

fn readShared(c &Cell) usize { c.holder.count(); }              //~ ErrorUniShared:33 "cannot be seen through a `&` reference"
fn readMut(c &mut Cell) usize { c.holder.count(); }             //~ ErrorUniShared:34 "cannot be seen through a `&mut` reference"
fn wipeMut(c &mut Cell) { c.holder.wipe(); }                    //~ ErrorUniShared:28 "cannot be seen through a `&mut` reference"
fn copyOut(c &mut Cell) { imm h = c.holder; }                   //~ ErrorUniShared:36 "cannot be seen through a `&mut` reference"
fn store(c &mut Cell, h &uni App) { c.holder = h; }             //~ ErrorUniShared:38 "cannot be seen through a `&mut` reference"
fn nested(p &mut Pair) usize { p.cell.holder.count(); }         //~ ErrorUniShared:38 "cannot be seen through a `&mut` reference"

struct Mixed['a] {
  pub cell Cell['a];
  pub fn size(self &mut) usize { cell.holder.count(); }          //~ ErrorUniShared:38 "cannot be seen through a `&mut` reference"
}

// the harm: a borrow of an element, then the second name wipes the list
fn twoNames(a &mut Cell, b &mut Cell) i64 {
  imm e = a.holder.items[0usize];                                //~ ErrorUniShared:12 "cannot be seen through a `&mut` reference"
  b.holder.wipe();                                               //~ ErrorUniShared:4 "cannot be seen through a `&mut` reference"
  e.n;
}

// allowed: a '&uni' holder, an owner of the holder, and the holder held by value
fn readUni(c &uni Cell) usize { c.holder.count(); }
fn wipeUni(c &uni Cell) { c.holder.wipe(); }
fn readOwner(c So[Cell]) usize { c.holder.count(); }
fn readLocal(h &uni App) usize {
  imm held = new Cell(h);
  held.holder.count();
}
fn readValuePair(h &uni App) usize {
  imm p = new Pair(new Cell(h));
  p.cell.holder.count();
}
