// Borrowing a reference to a struct field without parentheses. Marked xfail:
// this is documented behaviour (coneref/refborref.html, "Referring to a field
// or array element": 'imm ref1 = &apoint.x') that the compiler does not
// implement.
//
// parseAmper consumes only the prefixed term, then re-applies the suffixes to
// the borrow, so '&mut p.x' becomes a field access on '&mut p' carrying
// FlagBorrow. fnCallTypeCheck's field branch ignores FlagBorrow and types the
// access as the field's own type, i32 -- so the '*' below is rejected as a
// dereference of a number. Drop the '*fx = 10' line and it type-checks as an
// i32 while genlexpr.c returns the field pointer for FlagBorrow, which fails
// LLVM module verification instead.
//
// The parenthesized form '&mut (p.x)' does work, and ref-success uses it.
// When this scenario starts passing, drop the xfail and move it into
// ref-success alongside that form.

struct Pair {
  x i32
  y i32
}

fn borrowField() {
  mut p = Pair[1, 2]
  imm fx = &mut p.x
  *fx = 10
}
