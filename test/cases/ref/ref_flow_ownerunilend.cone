// An owning reference lent where a '&uni' is wanted is borrowed from, '&uni *o'
// built as if written, so what the borrow forbids its owner is what any mutable
// borrow of what a 'uni' reaches forbids (ref_flow_freeze): held in a local, the
// owner may not be read or moved until the borrow's last use; handed to one call
// twice, the '&uni' borrow still being made meets the second borrow. A shared
// owner ('Rc[mut, T]') has other holders, so it cannot lend a '&uni' at all.
// A use after the borrow's last use is allowed (ref_ownerunilend runs it).
//
// One function per case, so that one borrow's conflict cannot stand in for
// another's.

mod ref_flow_ownerunilend;

struct R {
  pub n i64;
  fn final(self &uni) {}
}

fn take(o So[R]) {}
fn uniAndRead(a &uni R, b &R) i64 { a.n + b.n; }

fn heldRead() i64 {
  imm o = new So[R](4);
  imm p &uni R = o;
  imm k = o.n;                     //~ ErrorFrozen:12 "may not be read"
  p.n + k;
}

fn heldMove() i64 {
  imm o = new So[R](4);
  imm p &uni R = o;
  take(o);                         //~ ErrorFrozen:8 "may not be moved"
  p.n;
}

fn twiceInCall() i64 {
  imm o = new So[R](4);
  uniAndRead(o, o);                //~ ErrorFrozen:17 "may not be borrowed"
}

fn sharedOwner() i64 {
  imm o Rc[mut, R] = new Rc[R](4);
  imm p &uni R = o;                //~ ErrorInvType:18 "does not match"
  p.n;
}

fn main() {
}
