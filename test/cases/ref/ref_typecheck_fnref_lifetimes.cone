// A function reference's function promises the lifetimes the wanted type does or
// more (ref_fnref_lifetimes accepts a result holding fewer borrows). What is
// refused is the opposite: a function whose result may hold both of its borrows
// where the wanted type says the result holds only the first, since a call through
// the type is checked against that and could not know the second must outlive it.

mod ref_typecheck_fnref_lifetimes;

fn either(a &i64, b &i64) &i64 { if *a < *b {a;} else {b;}; }

fn onlyFirst(f &fn(a &i64, b &'b i64) &i64) i64 { 1; }

fn asArgument() i64 {
  onlyFirst(&either);                       //~ ErrorInvType:13 "Expression's type does not match declared parameter"
}

fn asInitializer() {
  let f &fn(a &i64, b &'b i64) &i64 = &either;  //~ ErrorInvType:39 "Initialization value's type does not match variable's declared type"
}
