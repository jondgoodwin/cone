// Passing a '&uni' variable to a call or binding that wants a '&uni' (an
// argument, a receiver, a '&uni' local) implicitly borrows from it: a fresh and
// shorter loan, '&uni *p' built as if written, instead of handing over the
// reference itself. The caller is frozen while the loan is used and uses the
// reference again afterwards (mem-borrowing.html#handle, "Passing a borrow on"). A '&uni'
// slice (a '&uni Array[T]') is borrowed from the same way, handed to a '&uni',
// a '&mut' or a '&' slice.
//
// Each shape is here: one reference handed to a '&uni' parameter twice and in
// a loop; a 'self &uni' method calling '&uni' methods through 'self', bare and
// written out; a '&uni' local, declared and inferred, with the parameter used
// after the local's last use; a call's result derived from the lent reference,
// and the lent reference handed back; the slice in each shape; and a finalizer.
// What the loan forbids while it is used is ref_flow_uniborrow.

mod ref_uniborrow;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Counter {
  pub n i64;

  pub fn get(self &) i64 { n }
  pub fn grow(self &uni) { n = n + 1; }
  pub fn add(self &uni, k i64) { n = n + k; }

  // '&uni' methods through 'self', written out and bare
  pub fn twice(self &uni) { self.grow(); self.grow(); }
  pub fn bare(self &uni) { grow(); grow(); add(10); }
  pub fn both(self &uni) i64 { twice(); bare(); n }

  fn final(self &uni) {
    self.grow();
    self.grow();
    show("final", n);
  }
}

fn fill(q &uni Counter) { q.n = q.n + 10; }
fn pick(q &uni Counter) &uni i64 { &uni q.n }
fn same(q &uni Counter) &uni Counter { q }

// 1 -> 11 -> 21
fn twiceCall(b &uni Counter) i64 {
  fill(b);
  fill(b);
  b.n
}

// 0 -> 30, three loans one after another
fn inLoop(b &uni Counter, k i64) i64 {
  var i i64 = 0;
  while i < k {
    fill(b);
    i = i + 1;
  }
  b.n
}

// a declared local: 1 -> 3 through q, then fill through p -> 13
fn declared(p &uni Counter) i64 {
  let q &uni Counter = p;
  q.n = 3;
  fill(p);
  p.n
}

// an inferred local: 1 -> 11 -> 12 through q, then fill through p -> 22
fn inferred(p &uni Counter) i64 {
  let q = p;
  fill(q);
  q.n = q.n + 1;
  fill(p);
  p.n
}

// the result's borrow of the field ends at its last use: 2 -> 7 (x) -> 17
fn derived(b &uni Counter) i64 {
  let r = pick(b);
  *r = *r + 5;
  let x = *r;
  fill(b);
  x + b.n
}

// the reference handed back by a call is the one lent: 0 -> 1 -> 11
fn throughSame(b &uni Counter) i64 {
  let c = same(b);
  c.n = c.n + 1;
  fill(b);
  b.n
}

// handing the lent reference on as the result: 0 -> 10
fn handBack(b &uni Counter) &uni Counter {
  fill(b);
  b
}

// a cursor used in the loop and then reassigned from a call on itself, as a
// walk does: 5 -> 8, and then 'p' is the reference again once 'cur' is done
fn cursor(p &uni Counter, k i64) i64 {
  var cur = p;
  var i i64 = 0;
  while i < k {
    cur.n = cur.n + 1;
    cur = same(cur);
    i = i + 1;
  }
  let r = cur.n;
  r + p.n
}

// the same with the borrow written out, which master refused: 5 -> 8
fn cursorWritten(p &uni Counter, k i64) i64 {
  var cur = p;
  var i i64 = 0;
  while i < k {
    cur.n = cur.n + 1;
    cur = same(&uni *cur);
    i = i + 1;
  }
  let r = cur.n;
  r + p.n
}

fn sum(s &Array[i64]) i64 { s[0usize] + s[1usize] + s[2usize] }
fn setFirst(s &mut Array[i64], v i64) { s[0usize] = v; }
fn bump(s &uni Array[i64]) { s[0usize] = s[0usize] + 100; }

// [1, 2, 3] -> [4, 2, 3] -> [204, 2, 3]; sum 209 twice, 209 through a '&' local;
// then 304 (bumped through s), 404 (through a '&uni' local), 504 (inferred)
fn slices(s &uni Array[i64]) i64 {
  setFirst(s, 1);
  setFirst(s, 4);
  bump(s);
  bump(s);
  let a = sum(s) + sum(s);
  let t &Array[i64] = s;
  let c = sum(t);
  bump(s);
  let u &uni Array[i64] = s;
  bump(u);
  let w = s;
  bump(w);
  show("slice-sums", a + c);
  s[0usize]
}

fn main() {
  {
    let c = new Uni[Counter](5);
    show("both", c.both());
    show("held", c.get());
  }
  let one = new Uni[Counter](1);
  show("twiceCall", twiceCall(one));
  let zero = new Uni[Counter](0);
  show("inLoop", inLoop(zero, 3));
  let d = new Uni[Counter](1);
  show("declared", declared(d));
  let i = new Uni[Counter](1);
  show("inferred", inferred(i));
  let e = new Uni[Counter](2);
  show("derived", derived(e));
  let f = new Uni[Counter](0);
  show("throughSame", throughSame(f));
  let g = new Uni[Counter](0);
  show("handBack", handBack(g).n);
  let h = new Uni[Counter](5);
  show("cursor", cursor(h, 3));
  let h2 = new Uni[Counter](5);
  show("cursorWritten", cursorWritten(h2, 3));
  let arr = new Uni[Array[i64, 3]]([1, 2, 3]);
  show("slices", slices(arr));
  show("arr0", arr[0usize]);
  show("end", 0);
}
