// An owner held in a field, reached through a counted owner that may change
// ('Rc[mut, T]'), is on a shared path as one reached through a '&mut' is
// (mem-borrowing.html#freezing, "What a borrow leaves its source free to do"): another name for
// the 'Rc' reaches the same holder and can replace the owner while a loan of it
// is used. It lends no '&uni' and no '&imm', as a receiver, an argument, an
// initializer or a borrow written out; so is refused the use-after-free the
// receiver form allowed, 'take' replacing the owner whose value it is still
// reading. ref_owner_field_rc runs what stays allowed.

mod ref_typecheck_owner_field_rc;

struct App {
  pub n: i64;
  pub fn take(self: &uni, other: &mut Holder) i64 { other.app = Uni[App](9); n }
  pub fn takeUni(self: &uni) i64 { n }
}

struct Holder {
  pub app: Uni[App];
}

struct Outer {
  pub inner: Holder;
  pub boxed: Uni[Holder];
}

fn needUni(a: &uni App) i64 { a.n }
fn needImm(a: &imm App) i64 { a.n }

fn rcRecv(a: Rc[mut, Holder]) i64 { a.app.takeUni() }                          //~ ErrorBadPerm:38 "Cannot lend `&uni` of this owner"
fn rcWritten(a: Rc[mut, Holder]) i64 { (&uni *a.app).takeUni() }               //~ ErrorBadPerm:41 "Borrowed reference cannot obtain this permission"
fn rcInit(a: Rc[mut, Holder]) i64 { let r: &uni App = a.app; r.takeUni() }      //~ ErrorBadPerm:56 "Cannot lend `&uni` of this owner"
fn rcArg(a: Rc[mut, Holder]) i64 { needUni(a.app) }                            //~ ErrorBadPerm:45 "Cannot lend `&uni` of this owner"
fn rcImmArg(a: Rc[mut, Holder]) i64 { needImm(a.app) }                         //~ ErrorBadPerm:48 "Cannot lend `&imm` of this owner"
fn rcNested(a: Rc[mut, Outer]) i64 { needUni(a.boxed.app) }                    //~ ErrorBadPerm:53 "Cannot lend `&uni` of this owner"
fn rcInline(a: Rc[mut, Outer]) i64 { needUni(a.inner.app) }                    //~ ErrorBadPerm:53 "Cannot lend `&uni` of this owner"

fn viaRc(a: Rc[mut, Holder]) i64 { let b = a; a.app.take(&mut *b) }            //~ ErrorBadPerm:48 "Cannot lend `&uni` of this owner"

fn main() {
  let a = Rc[mut, Holder](Holder(Uni[App](5)));
  viaRc(a);
}
