// A method declaring 'self &uni' called on a 'mut' local lends it '&uni' for the
// call (ref_uni_receiver), so the call is held to what a written '(&uni p)' is:
// nothing else may borrow the local while the call uses it, as another argument
// or a borrow still to be used. Each case below is refused exactly as its
// written-out form is (an argument's conflict is reported at both borrows). One
// function per case.

mod ref_flow_uni_receiver;

struct P {
  pub x i64;
  fn bump(self &uni) { x = x + 1; }
  fn both(self &uni, o &uni P) { x = x + 1; }
  fn withMut(self &uni, o &mut P) { x = x + 1; }
}

// Another '&uni' of the local in the same call
fn uniArgument() {
  mut p = new P(1);
  p.both(&uni p);                     //~ ErrorFrozen:10 "may not be borrowed as 'uni'"
                                      //~^ ErrorFrozen:3 "as the call's receiver too"
}

// A '&mut' of the local in the same call
fn mutArgument() {
  mut p = new P(1);
  p.withMut(&mut p);                  //~ ErrorFrozen:13 "may not be borrowed mutably"
                                      //~^ ErrorFrozen:3 "as the call's receiver too"
}

// A '&mut' of the local held, then used after the call
fn heldMut() {
  mut p = new P(1);
  imm r = &mut p;
  p.bump();                           //~ ErrorFrozen:3 "may not be borrowed as 'uni'"
  r.x;
}

// A '&' of the local held, then used after the call
fn heldShared() {
  mut p = new P(1);
  imm r = &p;
  p.bump();                           //~ ErrorFrozen:3 "may not be borrowed as 'uni'"
  r.x;
}

fn main() {}
