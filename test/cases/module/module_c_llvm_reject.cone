// A function whose own '@c' string is one of LLVM's intrinsic names.
//
// 'llvm.' names are LLVM's intrinsics, built into the code generator: they are
// not symbols a linker finds, and a call to one the code generator cannot select
// (llvm.x86.sse2.pause) stops the compiler. So a C name beginning 'llvm.' is
// refused where it is written, whether the function is declared 'extern' or
// defined here; a name that only contains or resembles 'llvm' is an ordinary
// C name. Parse stage only. The prefix a C-named module gives is
// module_c_llvm_prefix.

mod module_c_llvm_reject;

extern fn @c("llvm.x86.sse2.pause") cpupause();     //~ ErrorLlvmName
fn @c("llvm.donothing") defined() {}               //~ ErrorLlvmName

// Not intrinsic names
extern fn @c("llvm") bare();
extern fn @c("llvmcall") joined();
extern fn @c("llvm_trap") underscored();
extern fn @c("my_llvm.trap") inside();
