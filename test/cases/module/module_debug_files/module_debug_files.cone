// Debug information names the file each function was written in. This is the
// designated file of a folder module whose sibling file, second.cone, joins it;
// it also imports stdio, a package compiled into this object. Three source files
// are in the program, so three DIFile entries are, and each function's subprogram
// is in its own: the sibling's, not this file's, and stdio's.
//
// It runs in a debug build only, since a release build writes no debug information.

mod module_debug_files;

import stdio use *;

fn main() i32 {
  printStr("first ");
  printInt(fromSecond(20i64));
  printStr("\n");
  0i32;
}
