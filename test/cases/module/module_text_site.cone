// A '<-' to a receiver with 'open(self: &, site: &mut S, spec: &str, file: &str, line: u32)' is
// one event of one call site: the fixed text goes to 'text', each value to the overloaded
// 'value', and 'finish' ends it. The spec is the text with each value as '{name}' (the
// brace's own source text, or its number in a plain list), then each name after a \x01.
// Each call site has a Site of its own, shared by every call of that site.

mod module_text_site;

import stdio use *;

struct Site {
  pub seen: Atomic[u32];
}

struct Rec {
  pub var spec: &str;
  pub var site: u32;
  pub fn text(self: &mut, s: &str) { print <- "text(", s, ") "; }
  pub fn valueI64 overload value(self: &mut, n: i64) { print <- "i64(", n, ") "; }
  pub fn valueStr overload value(self: &mut, s: &str) { print <- "str(", s, ") "; }
  pub fn finish(self: &mut) { print <- "| spec ", self.spec.len, " site call ", self.site, "\n"; }
}

struct Log {
  pub var level: i32;
  pub fn open(self: &, site: &mut Site, spec: &str, file: &str, line: u32) Rec { //~ WarnLifetimeTie
    let n = site.seen.add(1u32) + 1u32;
    Rec(spec, n)
  }
}

fn logIt(log: &Log, id: i64, name: &str) {
  log <- $"user {id} is {name}!";
}

fn main() i32 {
  let log = Log(1);
  logIt(&log, 5i64, "ada");
  logIt(&log, 6i64, "bob");
  let ms = 12i64;
  log <- "took ", ms, " ms";
  0
}
