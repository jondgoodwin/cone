// The marks a C-named function's narrow integers carry for SysV x86-64 and
// wasm32: those clang gives the same C declarations for each. An integer
// narrower than C's 'int' is widened by the caller, and a result by the callee,
// as its type is signed: 'signext' for i8 and i16, 'zeroext' for u8, u16 and a
// Bool, C's 'bool'. A 32-bit integer and a function that is not C-named are
// unmarked.
mod module_c_bool_extend;

extern {
  fn @c narrow(a i8, b u8, c i16, d u16, e Bool, f i32) i8;
  fn @c narrow_u(b u8) u16;
}

pub fn @c cone_bool(n i32, b Bool) Bool {
  n > 0 and b;
}

// Not C-named: Cone's own convention, untouched
fn plain(b Bool, k i8) Bool {
  !b;
}

fn main() {
  imm n = narrow(1, 2, 3, 4, true, 5);
  imm u = narrow_u(6);
  imm c = cone_bool(n into i32, u > 1);
  imm p = plain(c, n);
}
