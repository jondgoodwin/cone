// A GENERIC MODULE whose types enrich bases: Rich extends Base, both declared
// here, Rich first; and Plain extends a base another module declares. Each
// instance's copy takes its enrichment again, from the instance's own copy of
// Base, so it reads and adds the instance's T.
pub mod gauges[T];

import dials;

// Declared before its base: the instance copies it first
pub struct Rich extends Base {
  pub fn thrice(self) T {
    n + twice()
  }
}

pub struct Base {
  pub n: T;

  pub fn twice(self) T {
    n + n
  }
}

// A base another module declares, the same in every instance
pub struct Plain extends dials.Dial {
  pub fn tripled(self) i64 {
    level + doubled()
  }
}

pub fn run(x: T) T {
  let r = Rich(x);
  r.thrice() + r.twice()
}

pub fn plain(x: i64) i64 {
  Plain(x).tripled()
}
