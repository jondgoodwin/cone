// 'extends' INSIDE A GENERIC MODULE: a type enriching a base the module
// declares, and one enriching a base of another module. Each instance,
// gauges[i64] and gauges[f64], enriches its own copy of Rich from its own copy
// of Base, so Rich's methods and Base's read the instance's T; Plain is
// enriched from the other module's Dial in each.
//
// This is the designated file of the scenario's folder; gauges.cone beside it
// is the generic module and dials.cone the ordinary one. Each printed value was
// checked by hand against the source: run(x) is (x + 2x) + 2x = 5x, and
// plain(x) is x + 2x.

mod module_generic_extends;

import stdio use *;

fn main() {
  printStr("gauges[i64].run = ");
  printInt(gauges[i64].run(1i64));          // 5
  printStr("\ngauges[f64].run = ");
  printFloat(gauges[f64].run(0.5));         // 2.5
  printStr("\ngauges[i64].plain = ");
  printInt(gauges[i64].plain(3i64));        // 9
  printStr("\ngauges[f64].plain = ");
  printInt(gauges[f64].plain(4i64));        // 12
  printStr("\n");
}
