// A program whose stitched init and final call the 'init' and the finalizer of
// a package compiled on its own. Package lib is compiled first
// (package\lib.conebuild, listed under 'link' in cases.toml; the folder is not
// named 'lib', which .gitignore ignores), and this program is compiled against lib's
// hand-written include file, which declares lib's 'init', 'final' and the global
// they finalize. The two objects are then linked, with conestd, and run.

build: debug
output: executable

prog: {
    "main.cone"
    import lib: "include/lib.cone"
    import stdio: "stdio.cone"
}
