// Package lib's include file, written by hand: what the program compiles against
// in place of lib's source. It declares lib's 'init' and 'final', so that the
// program's stitched init and final call them, and the global lib's finalizer
// drops, so that the program calls that finalizer -- lib's 'drop', which lib's
// object exports -- rather than 'final' alone. Each is spelled with lib's Cone
// name, as lib's object exports it.

mod lib;

pub struct Handle {
  pub id i64;
  extern fn final(self &uni);
}

pub extern imm value i64;

pub extern mut handle Handle;

extern fn @initpure init();

extern fn final();
