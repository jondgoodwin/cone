// A public inline body of an imported module that reaches the module's private
// declarations. The body is generated here, in the importer, so each private
// name it reaches needs a symbol here too; the compiler crashed in generation
// when it had none. cases.toml pins that each one is declared, and that a
// private name no public body reaches is still absent.
//
// It compiles rather than runs: it spans modules.
//
// The imported module is moduleinline.cone.

import moduleinline;

fn viaFunction() i32 {
  moduleinline.viaHelper();
}

fn viaGenericInline() i64 {
  moduleinline.viaGeneric[i64](5i64);
}

fn viaGlobal() i32 {
  moduleinline.viaGlobal() + *moduleinline.viaGlobalRef();
}

fn viaFnRef() i32 {
  moduleinline.viaFnRef()();
}

fn viaPrivateType() i32 {
  moduleinline.viaHiddenType();
}
