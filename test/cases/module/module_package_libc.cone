// THE libc PACKAGE'S DECLARATIONS ARE THE C RUNTIME'S SYMBOLS. libc is a C
// package in the packages folder, found on the package search path and
// compiled into this object: each function it declares is called here by its C
// name, and each is that symbol, declared once. malloc arrives twice, through
// core's re-export and through this import, and is one declaration; fabsf is an
// inline function over fabs, as the runtime has it on x64, and no symbol; and
// stdout() is an inline call of __acrt_iob_func.
//
// It compiles and stops: what the bindings do when run is libc's own test,
// packages/libc/tests/, which 'congo test' runs.

mod module_package_libc;

import libc use *;

fn main() i32 {
  imm p = calloc(8usize, 1usize);
  free(p);
  free(malloc(16usize));
  imm file = fopen(&[]"module_package_libc.tmp", &[]"rb");
  fclose(file);
  fwrite(&[]"x", 1usize, 1usize, stdout());
  imm d = atan2(1., 1.) + fabs(-1.);
  imm f = atan2f(1f, 1f) + fmodf(7f, 2f) + fabsf(-1f);
  i32[d] + i32[f];
}
