// Package lib's source: setups and no 'init'. A library compile gives the
// module an 'init' that runs them, and exports it for the program's stitched
// init to call.

mod lib;

import stdio use *;

pub struct Handle {
  pub id: i64;
  fn final(self: &uni) {
    printStr("lib handle final ");
    printInt(id);
    printStr("\n");
  }
}

fn make(id: i64) Handle {
  printStr("lib make ");
  printInt(id);
  printStr("\n");
  Handle(id)
}

// Declared in the reverse of the order they run
pub let second: Handle = make(first.id + 1i64);
pub let first: Handle = make(1i64);
