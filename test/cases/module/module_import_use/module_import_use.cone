// AN IMPORT CARRIES A 'use' CLAUSE: which of the module's public names become
// names here, under which spelling, and whether they are public here in turn.
//
// The clause is a global's clause exactly -- a list with 'as', '* but', a block,
// 'pub use' -- with the import's module as the source. Every name it admits is
// bound as an alias with its local spelling, private to the importing module
// unless the import says 'pub'. 'pub import' makes every binding the import
// makes public, the module's own name included; 'pub use' makes only the folds
// public. What a third module sees through a wildcard import is exactly what
// was made public.
//
// The folder holds a tree of four sisters:
//   shapes/shapes.cone     a source, folded selectively by draw
//   units/units.cone       a source, folded by draw and by gallery, differently
//   draw/draw.cone         'pub use' a list with 'as'; '* but' privately
//   gallery/gallery.cone   'use *' of draw; 'pub import' with a block
//
// A module imports another once: a second import, identical or not, is refused
// at parse (module_import_use_parse).

mod module_import_use;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // 3*4 + 2*(3+4) + 1000 + 305
  show("draw-sketch", draw.sketch(3i64, 4i64));
  // 2*(3+4) + (9+16): a renamed fold, and a name reached through the module
  show("draw-frame", draw.frame(3i64, 4i64));
  // A 'pub use' fold is a public name of draw, reached by a path
  show("pub-use-path", draw.area(5i64, 6i64));
  show("pub-use-renamed", draw.edge(5i64, 6i64));
  // 2*3*100 + 2*(2+3) + 0 + 0: area and edge travelled through draw to gallery
  show("transit", gallery.show(2i64, 3i64));
  // 'pub import' publishes the module's own name and every fold alike
  show("pub-import-module", gallery.units.inches(2i64));
  show("pub-import-fold", gallery.ft(2i64));
  0i32;
}
