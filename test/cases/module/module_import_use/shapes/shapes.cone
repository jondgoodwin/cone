// The module draw folds names from selectively. One of its names is private,
// which no clause may fold.

mod shapes;

pub fn area(w i64, h i64) i64 {
  w * h;
}

pub fn perimeter(w i64, h i64) i64 {
  2i64 * (w + h);
}

pub fn diagonal2(w i64, h i64) i64 {
  w * w + h * h;
}

fn secret() i64 {
  7i64;
}
