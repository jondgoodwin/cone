// The values, made in this object and tested in q's

mod prog;

import stdio use *;
import q;

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  let sq = q.Square();
  let ci = q.Circle();
  show("square-is-circle", q.isCircle(&sq));
  show("square-is-square", q.isSquare(&sq));
  show("circle-is-circle", q.isCircle(&ci));
  show("circle-is-square", q.isSquare(&ci));
  show("which-square", q.which(&sq));
  show("which-circle", q.which(&ci));
  0i32
}
