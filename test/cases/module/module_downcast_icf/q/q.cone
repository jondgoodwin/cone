// Two different types meeting one trait whose methods compile to the same code.
// In an optimized program linked with the linker's defaults (link.exe folds
// identical COMDATs, /OPT:ICF), the two 'sides' functions become one, so the two
// vtables differ only in their last slot, each type's own record. A downcast
// compares vtable addresses, so it holds only while those two vtables stay two.
// The tests are here and the values are made in the program, the other object.

mod q;

pub trait Shape {
  pub fn sides(self: &) u32;
}

pub struct Square is Shape {
  pub fn sides(self: &) u32 { 4u32 }
}

pub struct Circle is Shape {
  pub fn sides(self: &) u32 { 4u32 }
}

pub fn isCircle(s: &<Shape) i64 { if s is Circle {1i64} else {0i64} }

pub fn isSquare(s: &<Shape) i64 { if s is Square {1i64} else {0i64} }

pub fn which(s: &<Shape) i64 {
  match s {
    case let Circle(c) {1i64}
    case let Square(sq) {2i64}
    else {0i64}
  }
}
