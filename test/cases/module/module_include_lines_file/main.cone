// The program: compiled against the include file idx's compile generated, and
// linked with idx's object. idx.at is expanded here, from the include file's
// text, and the index check in it names more.cone and the line of the index
// there, not idx.cone, nor the include file's line.

mod prog;

import stdio use *;
import idx;

fn main() {
  imm nums = [10i64, 20i64, 30i64];
  printInt(idx.at(&nums, 1usize));
  printStr("\n");
  printInt(idx.at(&nums, usize.from(idx.count()) + 1usize));
  printStr("\n");
}
