// The package lines list a and b, the whole closure; module p's own lines give
// it a alone. So p's import of b is refused, while a's include file's import of
// b is answered, and its import of c, which no package line names, is refused.

import a: "include/a.cone"
import b: "include/b.cone"

p: {
    "src/p.cone"
    import a: "include/a.cone"
}
