// A debug build describes an enum arm as a type of its own (the target of '&Circle'): a struct holding
// the enum's tag and the arm's fields at the offsets of the arm's LLVM type. A virtual reference ('&<Shape')
// is the pair it is stored as, 'object' (a pointer to nothing) and 'vtable' (a pointer to a struct of the
// trait's slots, a function pointer for each method and the offset of each field). A tuple is a struct of
// '0', '1', ... and a SIMD vector an array of its lanes with the vector flag. An 'Option' of a virtual
// reference is the pair it is stored as, a null 'object' being None.

mod module_debug_shapes;

trait Shape {
  pub sides: i32;
  pub fn area(self: &) f32;
}

struct Disc is Shape {
  pub sides: i32;
  pub r: f32;
  pub fn area(self: &) f32 { r * r * 3. }
}

enum Figure {
  Empty;
  struct Circle {pub radius: f64;}
  struct Rect {pub w: f32; pub h: f32;}
  struct Nest {pub inner: &Figure; pub n: i32;}
}

fn look(s: &<Shape, opt: Option[&<Shape], circle: &Figure.Circle, nest: &Figure.Nest, rect: Figure.Rect,
    tup: (i64, f64), tref: &(i64, f64), wide: Vector[f32, 4], mask: Vector[bool, 4]) f32 {
  let again = s;
  let pair = (1, 2.5);
  let nested = (3, (4, 5.5));
  s.area() + wide.x
}

fn main() {
  let d = Disc(0, 2.);
  let f = Figure.Circle(1.5);
  let w = Vector[f32, 4]() <- 1.0, 2.0, 3.0, 4.0;
  let m = w == w;
  let t: (i64, f64) = (7, 8.5);
  let n = Figure.Nest(&f, 3);
  let o: Option[&<Shape] = Some[&<Shape](&d);
  let r = look(&d, o, &f, &n, Figure.Rect(2., 3.), t, &t, w, m);
}
