// No global is finalized, however it was set: by 'init' in any order, in either
// arm of an 'if', or by a constant value where declared. So 'finalAll()' prints
// nothing, though every global's type has a 'final'.

mod module_final_setup_order;

import stdio use *;

struct B {
  pub n: i64;
  fn final(self: &uni) { printStr("B"); printInt(n); printStr(" "); n = 0; }
}

struct A {
  pub n: i64;
  fn final(self: &uni) { printStr("A"); printInt(n); printStr(" reads b="); printInt(b.n); printStr(" "); }
}

struct Fin {
  pub n: i64;
  fn final(self: &uni) { printStr("F"); printInt(n); printStr(" "); }
}

let a: A;
let b: B;
let c: Fin;
let d: Fin;
let e = Fin(3);

fn which() bool { true }

fn @initpure init() {
  b = B(42);
  a = A(b.n + 1);
  if which() {
    d = Fin(2);
    c = Fin(1);
  } else {
    c = Fin(1);
    d = Fin(2);
  }
}

fn main() i32 {
  initAll();
  printStr("finalAll: ");
  finalAll();
  printStr("\n");
  0i32
}
