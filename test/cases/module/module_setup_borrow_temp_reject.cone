// A setup's store is judged as the same store in 'init' is. A borrow of a
// temporary, which ends with its statement, is not stored in a global: by the
// setup of a global of reference type, directly or through a function that
// hands the borrow back, each refused as 'init' refuses it (ErrorInvType).

mod module_setup_borrow_temp_reject;

struct P { x: i64; }
fn mk() P { P(7i64) }
fn pass(p: &'a P) &'a P { p }

let direct: &P = &mk();            //~ ErrorInvType "outlives the borrowed reference"
let viaFn: &P = pass(&mk());       //~ ErrorInvType "outlives the borrowed reference"

let viaInit: &P;
fn @initpure init() {
  viaInit = &mk();                 //~ ErrorInvType "outlives the borrowed reference"
}
