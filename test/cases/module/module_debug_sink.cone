// A sink that declares DebugText takes its values in the debug form (a string value
// quoted, a struct with its field names) and its literal text as it stands. 'toText(x)'
// on it writes the display form, 'toDebug(x)' on the console writes the debug form, and
// a type with no 'toText' goes to the debug sink.

mod module_debug_sink;

import stdio use *;
import collections use *;

struct Shown {
  name: String;
  n: i32;
}

struct Probe is DebugText {
  text: String;
  pub fn init(self: &new) {*self = Probe(String());}
  pub fn takeText overload `<-`(self: &mut, s: &str) {
    self.text <- s;
  }
  pub fn textOut(self: &mut) TextOut {
    self.text.textOut()
  }
}

fn main() {
  var p = Probe();
  let s = String() <- "hi\n";
  let sh = Shown(String() <- "bob", 3);
  p <- "lit ", s, " ", 5, " ", sh;
  print <- p.text, "\n";

  // One piece
  var q = Probe();
  q <- s;
  print <- q.text, "\n";

  // The override on either kind of sink
  var r = Probe();
  r <- "t=", toText(&s), " d=", toDebug(&s), " n=", toText(&sh.n);
  print <- r.text, "\n";
  print <- "console: ", s, " ", toDebug(&s), " ", toDebug(&sh), "\n";
}
