// A GENERIC MODULE declaring a macro, which every instance holds a copy of:
// its parameter's type is the module's T, substituted, and its body names the
// instance's own global.
pub mod twice[T];

pub var @threadlocal uses: i64 = 0i64;

pub macro dbl[x: T] {
  uses = uses + 1i64;
  x + x
}

// Expanded inside the module's own function
pub fn quad(x: T) T {
  dbl[x] + dbl[x]
}

// Overloaded by repeating the name: the instance's copy holds the pair
pub macro dbl[x: T, y: T] {
  uses = uses + 1i64;
  x + y
}
