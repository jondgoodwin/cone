// A MACRO INSIDE A GENERIC MODULE, treated as a generic type's members are [Jon
// 23 Sep]: each instance, twice[i64] and twice[f64], holds its own copy of dbl,
// whose parameter is the instance's T and whose body counts into the
// instance's global, whether it is expanded in the module's own function or
// named through the instance, 'twice[i64].dbl[4i64]'.
//
// This is the designated file of the scenario's folder; twice.cone beside it is
// the generic module. Each printed value was checked by hand against the source.

mod module_generic_macro;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label: &str, n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn main() {
  show("twice[i64].quad", twice[i64].quad(5i64));      // 20
  showF("twice[f64].quad", twice[f64].quad(0.25));     // 1
  show("twice[i64].dbl", twice[i64].dbl[4i64]);        // 8
  showF("twice[f64].dbl", twice[f64].dbl[1.5]);        // 3

  // quad expands dbl twice; one more expansion named through each instance
  show("twice[i64].uses", twice[i64].uses);            // 3
  show("twice[f64].uses", twice[f64].uses);            // 3
}
