// What a '@workgroup' global holds, held to a kernel's buffer's rule on every
// target: 32-bit numbers, Atomic[u32] and Atomic[i32], and structs and fixed
// arrays of them. Anything else is refused with the field or element that
// holds it, and so is a type that needs finalizing, since nothing finalizes a
// workgroup's copy as its workgroup ends.

mod module_workgroup_data;

struct Handle {
  pub id u32;

  fn final(self &uni) {
  }
}

struct Flags {
  pub on bool;
}

struct Tile {
  pub v Array[f32, 4];
  pub count Atomic[u32];
}

mut @workgroup flag bool;   //~ ErrorWorkgroupData
mut @workgroup wide u64;   //~ ErrorWorkgroupData
mut @workgroup wideCount Atomic[u64];   //~ ErrorWorkgroupData
mut @workgroup flags Array[Flags, 4];   //~ ErrorWorkgroupData
mut @workgroup at *u32;   //~ ErrorWorkgroupData
mut @workgroup maybe Option[u32];   //~ ErrorWorkgroupData
mut @workgroup handle Handle;   //~ ErrorWorkgroupData

// Numbers, their atomics, and structs and arrays of them
mut @workgroup tiles Array[Tile, 8];
mut @workgroup lows Array[Atomic[i32], 16];
mut @workgroup sum f32;
