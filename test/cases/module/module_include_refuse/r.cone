// Package r's root. Each public declaration here reaches into submodule
// 'parts', which r's include file would then have to declare.

mod r;

// A signature naming the submodule's type, a global of it, and a type holding it
pub fn make() parts.Widget {        //~ ErrorIncSubmodule
  parts.Widget[1i64];
}

pub mut spare parts.Widget = parts.Widget[2i64];      //~ ErrorIncSubmodule

pub struct Box {                    //~ ErrorIncSubmodule
  pub w parts.Widget;
}

// A body an importer expands, naming the submodule's function: refused where
// that function is declared, in parts.cone
pub fn bumped() i64 inline {
  parts.bump();
}

// 'pub use' of the submodule's names, and of an enum it holds
pub use parts;                      //~ ErrorIncSubmodule
pub use parts.Mode;                 //~ ErrorIncSubmodule

// None of these is refused: a private function's signature and a private
// 'use' are not in the include file, and a public function that is not
// expanded keeps its body to itself
fn quiet() parts.Widget {
  parts.Widget[3i64];
}

pub fn calls() i64 {
  parts.bump() + quiet().n;
}
