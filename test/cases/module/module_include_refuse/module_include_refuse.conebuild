// A package compiled on its own whose include file would have to declare what
// its submodule holds. A generated include file cannot declare a submodule's
// names yet, so each such reach is refused where it is written
// (ErrorIncSubmodule), and nothing is generated.

build: debug
output: library

r: {
    "r.cone"
    parts: {
        "parts/parts.cone"
    }
}
