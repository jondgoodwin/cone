// '@c(system)' is stdcall only on 32-bit x86 (module_extern_system reads that
// form). On the 64-bit targets it is the C convention: x86-64 ignores stdcall, and
// AArch64 refuses it ("unsupported calling convention"), which stopped every
// package that declares a system function from compiling for arm64.

mod module_system_c_convention;

extern fn @c(system) GetTickCount() u32;

fn ticks() u32 {
  GetTickCount()
}
