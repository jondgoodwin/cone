// A program that drops values of a package's public types whose 'final' is not
// public. Package lib is compiled first (package\lib.conebuild, listed under
// 'link' in cases.toml), and this program is compiled against the include file
// lib's compile generates, then linked with lib's object and conestd.

build: debug
output: executable

import lib: "include/lib.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import lib: "include/lib.cone"
    import stdio: "stdio.cone"
}
