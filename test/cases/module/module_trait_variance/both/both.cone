// A name with two candidates: the one of exactly the trait's signature is the one
// that meets it, the looser one beside it is a function like any other.

mod both is Runner;

import hosts use *;

pub fn look(p: &mut P) i32 {
  p.x + 1000
}

pub fn pick(p: &mut P) &P {
  p
}

pub fn find(c: &Shape.Circle) &Shape {
  c
}

pub fn size(s: &Shape.Circle) i32 {
  s.r
}

pub fn twice(p: &mut P) i32 {
  p.x * 3
}

pub fn inspectMut overload inspect(c: &mut Shape.Circle) i32 {
  c.r + 1000
}

pub fn inspectRead overload inspect(c: &Shape) i32 {
  1
}
