// The types and the module trait the conforming modules beside this one name. A
// module meets a function requirement by a signature that is a subtype of it,
// by a recast alone, as a struct's method meets a trait's (trait_method_variance)
// and a function reference's signature does: see module_trait_variance.

mod hosts;

pub struct P {
  pub x: i32;
}

pub enum Shape {
  pub struct Circle { pub r: i32; }
  pub struct Square { pub s: i32; }
}

pub mod trait Runner {
  pub fn look(p: &mut P) i32;
  pub fn pick(p: &mut P) &P;
  pub fn find(c: &Shape.Circle) &Shape;
  pub fn size(s: &Shape.Circle) i32;
  pub fn twice(p: &mut P) i32;
  pub fn inspect(c: &mut Shape.Circle) i32 { c.r }

  // A default names the requirements, so its copy calls the module's own
  pub fn total(p: &mut P) i32 {
    look(p) + pick(p).x + twice(p)
  }
}
