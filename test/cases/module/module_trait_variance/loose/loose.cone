// Every function differs from the trait's by a recast: a read-only parameter for
// a writable one, a result with more permission, a reference to the enum for one
// to the variant (a parameter), a reference to a variant for one to the enum (a
// result).

mod loose is Runner;

import hosts use *;

pub fn look(p: &P) i32 {
  p.x + 10
}

pub fn pick(p: &mut P) &mut P {
  p
}

pub fn find(c: &Shape.Circle) &Shape.Circle {
  c
}

pub fn size(s: &Shape) i32 {
  match s {
    case &Shape.Circle(c) {c.r}
    case &Shape.Square(q) {100 + q.s}
  }
}

pub fn twice(p: &P) i32 {
  p.x * 2
}

pub fn inspect(c: &Shape) i32 {
  radius(c)
}

fn radius(s: &Shape) i32 {
  match s {
    case &Shape.Circle(c) {c.r}
    case &Shape.Square(q) {100 + q.s}
  }
}
