// A module meets a module trait's function when its signature is a subtype of the
// trait's: each parameter may be a supertype of the trait's (contravariant), and
// the result a subtype of it (covariant), where the difference is a recast with
// no run-time conversion -- the rule a struct's method meets a trait's by
// (trait_method_variance) and a function reference's signature gets. Here a
// parameter that asks for less permission, a result that promises more, and a
// reference to a variant for one to its enum on either side. A function of
// exactly the trait's signature is the one that meets it when the name has a
// looser one too. module_trait_typecheck_variance holds the differences that need
// a conversion, refused.
//
//   hosts/hosts.cone   the types and the trait, with a default naming the others
//   loose/loose.cone   a recast's difference in every function
//   both/both.cone     an exact candidate and a looser one under one name
//   exact/exact.cone   exactly the trait's signatures

mod module_trait_variance;

import stdio use *;

fn show(label &str, n i32) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn radius(s &hosts.Shape) i32 {
  match s {
    case imm c &hosts.Shape.Circle {c.r;}
    case imm q &hosts.Shape.Square {100 + q.s;}
  }
}

fn main() i32 {
  mut p = new hosts.P(3);
  imm c = hosts.Shape.Circle(r: 5);
  mut m hosts.Shape.Circle = hosts.Shape.Circle(r: 7);

  // loose: 13 + 3 + 6
  show("loose-total", loose.total(&mut p));
  show("loose-find", radius(loose.find(&c)));
  show("loose-size", loose.size(&c));
  // both: 1003 + 3 + 9
  show("both-total", both.total(&mut p));
  // exact: 3 + 3 + 6
  show("exact-total", exact.total(&mut p));
  show("exact-inspect", exact.inspect(&mut m));
  show("loose-inspect", loose.inspect(&c));
  show("both-inspect", both.inspectMut(&mut m));
  show("both-inspect-enum", both.inspectRead(&c));
  0i32;
}
