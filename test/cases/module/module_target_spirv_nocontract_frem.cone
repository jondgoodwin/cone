// A remainder on SPIR-V's Vulkan form, OpFRem, is left undecorated: C's fmod
// is exact, and a GPU's remainder matches it only when its driver may fuse
// inside it. A kernel whose only float arithmetic is fmod has no
// NoContraction at all.

mod module_target_spirv_nocontract_frem;

import libc;

fn @compute(64) rem(inv Invocation, xs &[]f32, out &[]mut f32) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len {
    out[i] = libc.fmodf(xs[i], 3.);
  }
}
