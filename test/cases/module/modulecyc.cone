// Imported by module-cycle.cone, and never compiled on its own, so it is
// listed in cases.toml as a support module.
//
// It imports module-cycle.cone back, which closes the loop, and the loop is
// refused here. The root file's name is not an identifier, so it is named as a
// string literal, which 'import' accepts in place of one.

import "module-cycle" use *;      //~ ErrorImportLoop:1 "module-cycle -> modulecyc -> module-cycle"

pub fn subFn(n i64) i64 {
  n + 1i64;
}
