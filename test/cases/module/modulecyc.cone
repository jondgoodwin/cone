// Imported by module_cycle.cone, and never compiled on its own, so it is
// listed in cases.toml as a support module.
//
// It imports module_cycle.cone back, which closes the loop, and the loop is
// refused here. The root file is named with a string literal, which 'import'
// accepts in place of an identifier.

mod modulecyc;

import "module_cycle" use *;      //~ ErrorImportLoop:1 "module_cycle -> modulecyc -> module_cycle"

pub fn subFn(n i64) i64 {
  n + 1i64;
}
