// Imported by module-cycle.cone, and never compiled on its own, so it is
// listed in cases.toml as a support module.
//
// It imports module-cycle.cone back, which is the cycle. The root file's name
// is not an identifier, so it is named as a string literal, which 'import'
// accepts in place of one. Nothing here calls into the root: the import alone
// is what must find the root module rather than parse its file again.

import "module-cycle"::*;

fn subFn(n i64) i64 {
  n + 1i64;
}
