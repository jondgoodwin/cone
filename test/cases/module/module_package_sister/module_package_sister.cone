// A SISTER NAMED LIKE A PACKAGE WINS. 'import stdio' written inside a submodule
// asks its parent's registry first, and only a name the registry does not hold
// goes on to the filesystem and the package search path. So a submodule named
// stdio is what her sister's import reaches, and the stdio package in the
// packages folder is never read.
//
// It RUNS, printing through externs declared here rather than through any stdio:
// this module cannot import the package, because a name its own folder answers
// is its submodule, which is named without being imported.
//
// The folder holds:
//   stdio.cone   a one-file submodule named stdio, with a function the package has not got
//   user.cone    a one-file submodule that imports stdio by name and calls that function

extern fn printStr(str &[]u8);
extern fn printInt(a i64);

fn main() i32 {
  printStr("sister-stdio = ");
  printInt(user.value());
  printStr("\n");
  0i32;
}
