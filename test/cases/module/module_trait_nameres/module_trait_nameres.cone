// What conformance to a module trait refuses once names are bound.
//
// A module's 'is' names a module trait it can reach -- a name of its own, or of
// the registry its parent is, as 'extends' looks -- and nothing else: not a
// struct's trait, not a module, not a function, not a name nobody declared. A
// requirement the module declares nothing for is reported where the 'is' is
// written, one diagnostic per member. A module trait's members have no code or
// storage of their own, so a path through the trait is refused, and 'extends'
// does not take a trait: conforming is spelled 'is'.
//
// Name resolution stage. The one-file modules beside this file each declare
// their own 'mod' line, and each reaches this module's declarations through the
// registry this module is for them:
//   missing.cone    declares neither requirement
//   structy.cone    'is' naming a struct's trait
//   modly.cone      'is' naming a module
//   fnly.cone       'is' naming a function
//   nowhere.cone    'is' naming nothing in reach
//   extender.cone   'extends' naming the module trait

pub mod trait Runner {
  pub fn step(n i64) i64;
  pub mut scale i64;
  pub fn run(n i64) i64 {
    step(n) * scale;
  }
}

pub trait Shape {
  fn area(self) i64;
}

pub fn peek() i64 {
  Runner.run(1i64);            //~ ErrorAbstractMeth "member of module trait Runner"
}
