// A submodule that imports three public names of its parent: a type, a
// function and a global. Each makes this module depend on the parent, which
// contains it, so each closes a loop and is refused where it is written.

mod scaling;

// Re-exported, so solids' wildcard import of this module carries Point on
pub import Point;       //~ ErrorImportLoop "module_import_parent.scaling imports Point of module_import_parent at"
import area;            //~ ErrorImportLoop "move what they share into a sister both import"
import count;           //~ ErrorImportLoop

pub fn scaledArea(n i64) i64 {
  imm p = Point[n, n + 1i64];
  count = count + 1i64;
  area(p) * 2i64;
}

pub fn twice(n i64) i64 {
  n * 2i64;
}
