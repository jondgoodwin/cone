// A submodule that reaches the parent's Point by two routes: the wildcard
// import of its sister scaling, which re-exported it, and an import of the
// parent's name. The wildcard depends on scaling alone and closes no loop; the
// import depends on the parent, and is refused.
//
// 'pub import' makes scaling's name and everything the wildcard folds public
// names of this module, which is what inner, below, imports.

mod solids;

pub import scaling use *;
import Point;           //~ ErrorImportLoop "module_import_parent -> module_import_parent.solids -> module_import_parent"

pub fn volume(d i64) i64 {
  imm p = Point[2i64, 3i64];
  p.x * p.y * d + twice(d);
}
