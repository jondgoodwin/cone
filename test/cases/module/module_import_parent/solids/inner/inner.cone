// Two levels down. The registry is solids' namespace, not the root's: the
// scoped rule holds, and what inner reaches of the level above solids is what
// solids re-exported.
//
// Both names below are names solids BINDS rather than contains -- scaling by
// solids' import of its sister, Point by the wildcard that import folds -- so
// each import depends on solids, inner's parent, and is refused. That holds for
// a module as for a type: scaling is reached through solids' re-export, and
// inner would state its own dependency by importing what holds it.
//
// 'pub mod' so that the root, a grandparent, may name it.

pub mod inner;

import scaling use twice;   //~ ErrorImportLoop "module_import_parent.solids.inner imports scaling of module_import_parent.solids at"
import Point;               //~ ErrorImportLoop "module_import_parent.solids -> module_import_parent.solids.inner -> module_import_parent.solids"

pub fn deep(n i64) i64 {
  imm p = Point[n, 5i64];
  twice(p.y) + n;
}
