// A module for a SPIR-V target: plain functions over i32 and f32, which call
// one another, branch and loop, and touch nothing a GPU lacks (no runtime, no
// allocation, no indexing, whose bounds check calls into conestd). What LLVM's
// SPIR-V backend makes of the rest is not yet asserted anywhere.

mod module_target_spirv;

fn square(x i32) i32 {
  x * x;
}

pub fn sumSquares(a i32, b i32) i32 {
  square(a) + square(b);
}

pub fn triangle(n i32) i32 {
  mut sum = 0;
  mut i = 0;
  while i < n {
    sum = sum + i;
    i = i + 1;
  }
  sum;
}

pub fn scaleAdd(x f32, k f32, c f32) f32 {
  if k < 0.0 {
    c;
  } else {
    x * k + c;
  }
}
