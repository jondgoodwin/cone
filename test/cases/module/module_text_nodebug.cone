// A program that never asks for 'toDebug' generates no debug code: the optimized IR of a
// send of a number, text and a value with its own 'toText' holds no 'toDebug' symbol and no
// 'debugArray' body. Compiled as a library so the public function stays. (Built by the
// compiler before text PR 2 and by this one, the IR differs only in TextOut's 'depth: u32'
// field and the source lines of the core it inlines.)

mod module_text_nodebug;

import stdio use *;

struct Point {
  pub x: i32;
  pub y: i32;
  pub fn toText(self: &, out: &uni TextOut) { out <- "(", self.x, ",", self.y, ")"; }
}

pub fn show(p: &Point, n: u64, s: &str) {
  print <- "point ", p, " n=", n, " s=", s, "\n";
}
