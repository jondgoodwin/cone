// A module that imports no actors and holds a global List
mod cache;

import collections use *;

const items = 4000000usize;

fn makeTable() List[u64] {
  var l = List[u64]();
  var i = 0usize;
  while i < items {
    l.push(7u64);
    i = i + 1usize;
  }
  l
}

let table = makeTable();

pub fn at(i: usize) u64 {table[i]}
