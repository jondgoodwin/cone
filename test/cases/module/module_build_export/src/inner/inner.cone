// Module ex's child. Its public function is exported as the root's are; its
// private one, which nothing expanded names, is not. It holds no body an
// importer expands, so its public type's private method stays internal too.

pub mod inner;

pub fn innerPub() i64 {
  innerPriv();
}

fn innerPriv() i64 {
  3i64;
}

pub struct Quiet {
  pub n i64;

  pub fn shown(self) i64 {
    n;
  }

  fn hidden(self) i64 {
    n + 1i64;
  }
}
