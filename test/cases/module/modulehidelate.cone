// A module loaded after modulehide, which reaches the names modulehide holds by
// folding and is refused. Imported by module_nameres_transit_late.cone and never
// compiled on its own, so it is listed in cases.toml as a support module; the
// annotation below is that scenario's whole expectation, because the diagnostic
// is reported against this file.
//
// It is the control on the refusal in module_nameres_transit.cone, which is the
// root's. Being loaded after the folding module used to be what decided the
// answer; now the refusal is the same from either side of the load order,
// because what it reads is the binding's own visibility.

mod modulehidelate;

import modulehide;

pub fn viaMid(n i64) i64 {
  // A folded name modulehide did not re-export: public in modulesub, private
  // here, and the binding is what the check reads
  modulehide.plain(n);     //~ ErrorNotPublic:14 "private to its module"
}
