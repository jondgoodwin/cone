// A generic struct's static, in an instance only a package uses. Packages g and
// q are compiled on their own; the program imports q.

build: debug
output: executable

import g: "include/g.cone"
import q: "include/q.cone"

prog: {
    "main.cone"
    import g: "include/g.cone"
    import q: "include/q.cone"
    import stdio: "stdio.cone"
}
