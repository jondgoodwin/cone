// Package g: a generic struct with a static, a constant shared by every value of
// one instance (a counter that changed is refused). A static takes a literal and nothing runs for it: no init, no
// final. So an instance only a package uses has nothing to miss in the program.

mod g;

pub struct Box[T] {
  pub item: T;
  static let made: i64 = 2i64;

  pub fn make(item: T) Box[T] {
    Box[T](item)
  }

  pub fn count() i64 {
    made
  }
}
