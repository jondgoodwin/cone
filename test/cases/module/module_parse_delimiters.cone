// What a module trait's body and an extern block still require of ';'.
//
// Parse stage only. ';' delimits their declarations and the last needs none
// (module_body_delimiters), so what remains refused is a missing delimiter BETWEEN two
// declarations that do not end in a block, and a comma in its place. Each diagnostic is
// placed after the token the missing ';' follows, which is where the fix goes.

mod module_parse_delimiters;

// Two requirements with nothing between them
mod trait TwoRequirements {
  pub fn a() i32  //~ ErrorNoSemi
  pub fn b() i32
}

// A global before a requirement
mod trait GlobalThenFn {
  pub let g: i32  //~ ErrorNoSemi
  pub fn f() i32
}

// Two extern functions with nothing between them
extern {
  fn first() i32  //~ ErrorNoSemi
  fn second() i32
}

// A comma is not the delimiter: the first diagnostic is the missing ';', and what the
// comma leaves behind is read as the start of a type
extern {
  fn third() i32, fn fourth() i32  //~ ErrorNoType
                                   //~^ ErrorNoSemi follow-on
}
