// Imported by module_extern_cone_names.cone, and never compiled on its own, so
// it is listed in cases.toml as a support module.
//
// A Cone-named module that declares, with 'extern' and no body, one of each kind
// of thing an include file declares: a public and a private function, a public
// and a private global, and a type's methods, static function and operator, one
// method meeting a trait's requirement. The private ones are reached only
// through the public inline body at the foot, as an include file's private
// names are. 'extern' says only that each is defined elsewhere; the module
// names them, so every one takes the module's Cone name.

mod moduleextern;

pub extern fn twice(n i64) i64;
extern fn hidden() i64;

pub extern mut count i64;
extern imm limit i64;

// A trait's requirement is met by an 'extern' method: its body is in the object
// that defines the type, which is still an implementation
pub trait Measured {
  fn size(self &) i64;
}

pub struct Vec2 is Measured {
  pub x i64;
  pub y i64;

  pub extern fn `+`(self, other Vec2) Vec2;
  pub extern fn len(self) i64;
  pub extern fn size(self &) i64;
  pub extern fn origin() Vec2;
}

pub fn peek() i64 inline {
  hidden() + limit;
}
