// A C thread-local reached from Cone: the submodule cbind (cbind.cone) is
// C-named, and declares 'extern' a thread-local that C would define with
// '_Thread_local' or '__declspec(thread)'. So its symbol is the C name, never
// mangled, and thread_local, as C's definition is. It compiles rather than
// runs because nothing linked in defines the variable; the declaration is the
// subject.

mod module_c_threadlocal;

fn frames() usize {
  cbind.cone_frames;
}

fn push(n usize) {
  cbind.cone_frames = n;
}
