// A CONE PACKAGE FOUND ON THE SEARCH PATH, AND WHAT IT CALLS OF libc. geomath
// is a Cone package in the packages folder that imports libc: found on the
// package search path, it is compiled into this object, its own methods defined
// here, and so is what it calls of libc, which the C runtime supplies. A
// perspective takes its tangent from libc's tanf, and a comparison its absolute
// values from libc's fabsf, an inline function over fabs, which is no symbol.
//
// It compiles and stops: what geomath computes is its own test,
// packages/geomath/tests/, which 'congo test' runs.

mod module_package_geomath;

import geomath use *;

fn main() i32 {
  imm m = Mat4.perspective(pi / 2., 1., 1., 3.);
  if new Vec3(0.1 + 0.2, 0., 0.).equals(new Vec3(0.3, 0., 0.)) {i32.from(m.m[5]);} else {0i32;};
}
