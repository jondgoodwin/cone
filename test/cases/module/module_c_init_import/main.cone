// The program imports a C-named library with an 'init' through its include
// file. The library's object runs that 'init' as it loads, before 'main', and
// the program's stitched init does not call it again: it ran once, and
// "cimp init" is printed once, ahead of the program's own line.

mod prog;

import stdio use *;
import cimp;

fn @initpure init() {
  printStr("prog init\n");
}

fn main() i32 {
  printStr("runs = ");
  printInt(cimp.Count());
  printStr("\n");
  0i32
}
