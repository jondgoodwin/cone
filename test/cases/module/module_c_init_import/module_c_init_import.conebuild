// A program compiled against the include file of a C-named package with an
// 'init' (package\cimp.conebuild, listed under 'link' in cases.toml), linked
// with it and run.

build: debug
output: executable

import cimp: "include/cimp.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import cimp: "include/cimp.cone"
    import stdio: "stdio.cone"
}
