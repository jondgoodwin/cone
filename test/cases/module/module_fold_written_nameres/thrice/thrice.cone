// x arrives by a wildcard, then is listed from a: one side was never written, so
// the two are one binding. The listing makes it written, so listing it a third
// time is refused, whichever order the three were folded in.

mod thrice;

import b use *;
import a use x;
import c use x;                   //~ ErrorDupName:14 "x is already a name of this module, for the same thing"

pub fn th() i64 {
  x() + z();
}
