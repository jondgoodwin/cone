// A module both imported and listed by name. The import binds 'meter', and the
// clause writes the same module in again under the same name. With a wildcard in
// place of the list, the two are one binding (module-extends-nameres).

mod gauge;

import meter;
import relay use meter;           //~ ErrorDupName:18 "meter is already a name of this module, for the same thing"

pub fn g() i64 {
  meter.level();
}
