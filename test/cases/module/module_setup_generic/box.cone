// A generic module with a setup: each instance has a global of its own and a
// setup of its own, run once, with that instance's type
pub mod box[T];

import stdio use *;

fn bump(n: i64) i64 {
  printStr("setup ");
  printInt(n);
  printStr("\n");
  n + 1i64
}

pub let width: i64 = bump(i64.from(#size(T)));
