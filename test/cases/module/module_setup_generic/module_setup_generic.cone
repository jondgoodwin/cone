// A generic module's setup. Each instance of 'box[T]' is a module of its own, so
// it has its own 'width' and runs its own setup: 'box[i32]' prints "setup 4" and
// holds 5, 'box[i64]' prints "setup 8" and holds 9. Both run before the root's
// 'init', in the order the instances were made, which is the order the root's
// 'main' first names them.
//
// This is the designated file of the scenario's folder; 'box.cone' is a
// one-file submodule opening with 'mod'.

mod module_setup_generic;

import stdio use *;

fn @initpure init() {
  printStr("init root\n");
}

fn main() i32 {
  printInt(box[i32].width);
  printStr(" ");
  printInt(box[i64].width);
  printStr(" ");
  printInt(box[i32].width);
  printStr("\n");
  0i32
}
