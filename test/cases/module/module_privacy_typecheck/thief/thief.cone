// A sister of vault: another module, so vault's types' private members are
// out of her reach, a field, a method, a value given by construction and an
// init alike.

mod thief;

import vault;

pub fn steal(v &vault.Vault, l &vault.Gauge.Low) i32 {
  imm a = v.secret;       //~ ErrorNotPublic:12 "May not access the private method/field `secret`."
  imm b = v.peek();       //~ ErrorNotPublic:12 "May not access the private method/field `peek`."
  imm c = l.lo;           //~ ErrorNotPublic:12 "May not access the private method/field `lo`."
  imm w = new vault.Vault(1, 2);  //~ ErrorNotPublic:30 "May not give a value to the private field secret from outside the module that declares Vault."
  imm s = new vault.Sealed(3);    //~ ErrorNotPublic:11 "May not construct Sealed with its private init"
  a + b + c;
}

// An extension of an enum is inside its base's boundary wherever it is
// declared, so this one, in another module, reaches the base's private members
// through any value, and is not refused
enum Warm extends vault.Gauge {
  struct Ember {
    ember i32;
    pub fn peekBase(self &, g &vault.Gauge, l &vault.Gauge.Low) i32 { g.secret + l.lo; }
  }
}
