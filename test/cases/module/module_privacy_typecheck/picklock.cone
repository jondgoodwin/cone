// A file of the root's folder that opens with its own 'mod' line: a one-file
// submodule, a sister of vault and not more of the root, so vault's types'
// private members are out of its reach too.

mod picklock;

import vault;

pub fn pick(v &vault.Vault, g &vault.Gauge) i32 {
  v.secret + g.secret;    //~ ErrorNotPublic:4 "May not access the private method/field `secret`."
                          //~^ ErrorNotPublic:15 "May not access the private method/field `secret`."
}
