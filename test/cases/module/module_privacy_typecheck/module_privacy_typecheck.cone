// A type's private members are private to the module that declares it, and a
// module's parent, its sisters and a file of the parent's folder that opens
// with its own 'mod' line are each another module. So the members vault keeps
// private are refused to this root module, to its sister thief, and to the
// one-file submodule picklock; vault's own code reaches them
// (module_privacy runs that across the files of one module).
//
// The folder holds:
//   vault/vault.cone    the submodule declaring the types, reaching its own
//   thief/thief.cone    a sister, importing vault
//   picklock.cone       a one-file submodule, importing vault
//
// Type-check stage: the tree parses and resolves cleanly, so every diagnostic
// below is reached.

mod module_privacy_typecheck;

// The parent: what vault keeps private is vault's
fn peer(v &vault.Vault) i32 {
  imm a = v.id;
  imm b = v.secret;       //~ ErrorNotPublic:12 "May not access the private method/field `secret`."
  imm c = v.peek();       //~ ErrorNotPublic:12 "May not access the private method/field `peek`."
  imm g = vault.Gauge.low(1);
  imm d = g.lo;           //~ ErrorNotPublic:12 "May not access the private method/field `lo`."
  a + b + c + d;
}

fn build() {
  imm v = new vault.Vault(id: 1, secret: 2);  //~ ErrorNotPublic:40 "May not give a value to the private field secret"
  imm s = new vault.Sealed(3);  //~ ErrorNotPublic:11 "May not construct Sealed with its private init"
  return;
}
