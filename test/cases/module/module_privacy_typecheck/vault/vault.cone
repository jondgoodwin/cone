// A submodule declaring public types with private members. Its own code
// reaches them through any value, and nothing here is refused; every other
// module of the tree is refused them.

mod vault;

pub struct Vault {
  pub id i32;
  secret i32;
  fn peek(self &) i32 { secret; }
  pub fn make(n i32) Vault { new Vault(n, n * 10); }
}

pub struct Sealed {
  pub n i32;
  fn init(self &new, x i32) { *self = new Sealed(n: x); }
}

pub enum Gauge {
  pub id i32;
  secret i32;
  struct Low {
    lo i32;
  }
  pub fn low(n i32) Low { Low[n, n, n]; }
}

fn inside(v &Vault, g &Gauge, l &Gauge.Low) i32 {
  imm s = new Sealed(1);
  v.secret + v.peek() + g.secret + l.lo + s.n;
}
