// A guarded send with constant pieces, to a receiver whose 'wants' reads a flag, costs a
// load, a compare and a branch once optimized: the pieces' text is behind the branch, and
// nothing is made when it is not taken. Compiled as a library so the public function stays.

mod module_text_wants_ir;

import stdio use *;

struct Gate {
  pub var on: bool;
  pub fn wants(self: &) bool { self.on }
  pub fn record(self: &) TextOut { print.record() }
  pub fn append overload `<-`(self: &, s: &str) { print <- s; }
}

pub fn note(g: &Gate) {
  g <- "state ", "of the world", "\n";
}
