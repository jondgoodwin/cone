// A C name meeting a symbol the compiler declared itself. Releasing an owning
// reference declares C's 'free' while bodies are being generated. A private
// declaration of 'free' in an imported module is declared here only when a
// public inline body that reaches it is generated, which is later, in
// releaseBuffer. It shares the compiler's declaration, cast to its own
// signature, rather than being added a second time and renamed 'free.1', which
// nothing defines.
//
// The imported module is modulecfree.cone.

mod module_c_name_late_free;

import modulecfree;

fn soValue() i64 {
  imm a = +so 5i32;
  i64[*a];
}

fn releaseBuffer() {
  modulecfree.release(malloc(16));
}
