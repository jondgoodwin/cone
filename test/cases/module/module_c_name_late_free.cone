// A C name declared late, meeting the declaration already there. A private
// declaration of 'free' in an imported module is declared here only when a
// public inline body that reaches it is generated, in releaseBuffer. By then
// 'free' is declared already: libc declares it, and core's import of libc puts
// libc in every compile. Releasing an owning reference, in soValue, calls it
// too: 'so''s 'free' method, inline in core, calls libc's by name. The late one
// shares it rather than being added a second time and renamed 'free.1', which
// nothing defines.
//
// The imported module is modulecfree.cone.

mod module_c_name_late_free;

import modulecfree;

fn soValue() i64 {
  imm a = +so 5i32;
  i64[*a];
}

fn releaseBuffer() {
  modulecfree.release(malloc(16));
}
