// Declares a type with a private 'isTrue'. Its own conditions reach it, and
// nothing here is refused.

mod vault;

pub struct Switch {
  pub on: i32;
  fn isTrue(self: &) bool { on != 0 }
  pub fn make(n: i32) Switch { Switch(n) }
}

fn inside() i32 {
  let p = Switch(1);
  if p { return 1; }
  if !p { return 2; }
  if true && p { return 3; }
  0
}
