// A sister of vault: a Switch's private 'isTrue' is out of its reach, called by
// name and injected by a condition, by '&&' and by '!' alike.

mod thief;

import vault;

pub fn peek() i32 {
  let p = vault.Switch.make(1);
  let e = p.isTrue();     //~ ErrorNotPublic:12 "May not access the private method/field `isTrue`."
  if p { return 1; }     //~ ErrorNotPublic:6 "May not access the private method/field `isTrue`."
  if true && p { return 2; }  //~ ErrorNotPublic:14 "May not access the private method/field `isTrue`."
  if !p { return 3; }     //~ ErrorNotPublic:7 "May not access the private method/field `isTrue`."
  0
}
