// One C name declared two ways in one compile is refused, as C refuses
// "conflicting types": the object file has one symbol for it. Each is reported
// at the declaration generated second, naming the first. This module is
// generated before its submodules, so the reports land in theirs.
//
// - sub declares 'abs' with another signature, and 'labs' with the system
//   calling convention: ErrorCNameConflict.
// - sub defines 'cone_twice' with a body when this module already has:
//   ErrorCNameDefTwice, whether or not the two bodies agree.
// - cfg and cuse are C-named modules, one defining 'Count' mutable and one
//   declaring it immutable: a global's permission is part of what must agree.

mod module_c_name_reject;

extern {
  fn @c abs(n i32) i32;
  fn @c labs(n i64) i64;
}

pub fn @c cone_twice(n i64) i64 {
  n * 2i64;
}
