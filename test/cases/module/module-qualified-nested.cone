// A path with two hops, 'mod.Type.name', reaching a static function through
// the module that declares the type.
//
// A path is written with periods and parses as a chain of member accesses, one
// node per hop, and name resolution collapses each hop as soon as it knows what
// the name before it binds to. The two-hop form is the one that exercises the
// collapse feeding itself: the inner hop has to leave a resolved type name
// behind for the outer hop to find a namespace in. This pins the one-hop and
// two-hop forms side by side so a regression in either shows.
//
// It compiles rather than runs for the reason module-qualified.cone does: the
// imported module's bodies are not generated here. The symbol check records
// that the two-hop call lowered to the type's static function.
//
// The imported module is modulesyms.cone.

import modulesyms;

fn nested() i32 {
  // One hop, with the type as the final name
  imm made modulesyms.Gadget = modulesyms.Gadget[1];
  // Two hops: module, then type, then the static function
  imm built = modulesyms.Gadget.make(2);
  made.x + built.x;
}
