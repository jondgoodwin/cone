// Declared after holder.cone in the sweep, yet Holder's method uses it as an Error.

pub struct LaterError is Error, Sendable {
  code: i32;

  pub fn toText(self: &, out: &uni TextOut) { out <- self.message().view(); }
  pub fn message(self: &) String { String.from("later") }

  pub fn clone(self: &) LaterError { LaterError(code) }
}
