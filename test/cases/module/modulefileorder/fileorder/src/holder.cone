// Its method makes an AnyError from LaterError, which later.cone declares and
// which says 'is Error' there. The call needs LaterError to meet Error, so its
// 'message' must be known whichever file the type is in.

pub struct Holder {
  err: LaterError;

  pub fn fail(self: &) Option[AnyError] {
    Some[AnyError](AnyError.from(err.clone()))
  }
}

// The length of the AnyError's message: "later" is 5
pub fn messageLength() i64 {
  let h = Holder(LaterError(7i32));
  match h.fail() {
    case let Some(e) { i64.from((String() <- e).len()) }
    case is None { 0i64 }
  }
}
