// Imported by module-typecheck-provenance.cone, and never compiled on its own,
// so it is listed in cases.toml as a support module.
//
// It holds one type-check error, annotated here rather than in the scenario,
// because a diagnostic is reported against the file the node came from and an
// annotation matches only a diagnostic reported against its own file. This is
// the whole point of the scenario: the file named has to be this one.
//
// i64 and f64 have no '+' between them, and the coercion rule never crosses
// integer and float, so this is the smallest error that survives to type check.

fn mismatched() i64 {
  imm bad = 1i64 + 2.0d   //~ ErrorNoCandidate:18 "No method declared by `+`"
  0i64
}
