// C naming, stated by '@c' on a 'mod' line and on a 'fn', and run.
//
// The submodule cio (cio.cone) is C-named with the prefix "print", so its
// 'extern' functions bind to conestd's printStr and printInt, and one override
// binds to the C runtime's labs. This module is Cone-named; its own functions
// take a C name only where '@c' says so:
// - 'pub fn @c("cone_square")' exports a Cone body to C under a chosen name;
// - 'fn @c("cone_cube")' is C-named but private, so it stays internal;
// - 'fn @c("main") start' is the program's entry under any Cone name, which is
//   what the glue a module trait supplies needs.

mod module_c_names;

pub fn @c("cone_square") square(x i64) i64 {
  x * x;
}

fn @c("cone_cube") cube(x i64) i64 {
  x * square(x);
}

fn @c("main") start() i32 {
  cio.Line("square", square(7i64));
  cio.Line("cube", cube(3i64));
  cio.Line("labs", cio.abs(-12i64));
  cio.Line("quad", cio.Quad(5i64));
  cio.Line("count", cio.Count);
  0i32;
}
