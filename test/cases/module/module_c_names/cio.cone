// A C-named module. '@c("print")' on the 'mod' line gives every function and
// global the module owns directly a C name: the prefix, then the name as
// written. So 'Str' is the C function printStr and 'Int' is printInt, both in
// conestd. A function's own '@c("...")' is its whole symbol instead, which is
// how a name outside the prefix is reached: 'abs' is the C runtime's labs.

mod @c("print") cio;

pub extern {
  fn Str(str &[]u8);
  fn Int(a i64);
  fn @c("labs") abs(n i64) i64;
}

// A C-named module may hold bodies too: they are compiled here and spelled as
// C names. A public one is exported under that name (printLine, printQuad,
// printCount); a private one is still internal (printTwice).
pub fn Line(label &[]u8, n i64) {
  Str(label);
  Str(" = ");
  Int(n);
  Str("\n");
}

fn Twice(n i64) i64 {
  n * 2i64;
}

pub fn Quad(n i64) i64 {
  Twice(Twice(n));
}

pub mut Count i64 = 3i64;
