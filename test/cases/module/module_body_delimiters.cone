// Where a module trait's body and an 'extern' block end their declarations. They follow
// the rule every body of braces has (struct_body_delimiters, enum_body_delimiters): ';'
// delimits declarations, so the last needs none before the '}', and a lone ';' is an
// empty declaration, harmless wherever it stands.
//
// The module trait and the extern block are only declared: a requirement names what a
// conforming module would write, and the extern functions are never called, so nothing
// here links against them. What runs is the printed line, which says the program built.

mod module_body_delimiters;

import stdio use *;

// The last requirement and the last global need no ';'
mod trait Shell {
  pub fn start() i32;
  pub fn stop() i32
}

mod trait Settings {
  pub let level: i32 = 1;
  pub let limit: i32
}

// A default fn ends in its block; a ';' after it, one before the first member and a doubled one are empty
// declarations
mod trait Padded {
  ;
  pub fn one() i32 {1};;
  pub fn two() i32 {2}
}

// An extern block's items follow the same rule
extern {
  fn declaredFirst() i32;
  fn declaredLast() i32
}

extern {
  ;
  let declaredGlobal: i32;;
  fn declaredAfter() i32
}

fn main() {
  printStr("built\n");
}
