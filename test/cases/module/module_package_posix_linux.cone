// THE posix PACKAGE BUILT FOR LINUX IS THE C LIBRARY'S OWN FUNCTIONS. posix is
// a C package in the packages folder, found on the package search path and
// compiled into this object. For a Linux target (this scenario's run names the
// triple) a POSIX name is the C library's function of that name, declared
// under a name of posix's own ('stat' is declared as the C symbol stat), and
// the functions that fill in posix's own layouts (stat, lstat, listing a
// directory) are Cone functions under symbols of posix's, so none stands in
// for the C library's. Nothing of the Windows runtime is generated.
//
// It compiles and stops: what the bindings do when run is posix's own test,
// packages/posix/tests/, which 'congo test' runs.

mod module_package_posix_linux;

import posix use *;

fn main() i32 {
  var st = Stat(0u64, 0u64, 0u16, 0u32, 0u32, 0u32, 0u64, 0i64, 0i64, 0i64, 0i64);
  let status = stat("module_package_posix_linux.dir", &mut st);
  let pipe = popen("echo", "r");
  pclose(pipe);
  let moved = chdir("..") + mkdir("module_package_posix_linux.dir", 0x1EDu32);
  let set = setenv("CONE_POSIX_SYMBOLS", "1", 1i32);
  realpath(".", 0usize as *u8);
  let dir = opendir(".");
  readdir(dir);
  closedir(dir);
  status + moved + set
}
