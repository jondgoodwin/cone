// A compute kernel over integers alone: the module declares no float controls,
// so asks nothing of the device it runs on.

mod module_target_spirv_nopreserve;

fn @compute(64) twice(inv: Invocation, out: &mut Array[u32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len { out[i] = out[i] * 2u32; }
}
