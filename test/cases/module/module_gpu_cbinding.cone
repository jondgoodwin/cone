// Support for module_gpu_io_wrapper: a C binding of the kind libc is, an extern
// function and an inline function that calls it. On a GPU the call inside the
// inline function is refused where a kernel calls the function, at generation.

mod @c module_gpu_cbinding;

pub extern {
  fn rand() i32;
}

pub fn roll() i32 inline {
  rand();                                                       //~ ErrorGpuUnavailable
}
