// A module is the files of a folder, established by running one.
//
// This file is its folder's designated file -- the file named for the folder --
// which is what makes the folder a module folder. The compiler is pointed at
// this file alone and finds the rest itself: sibling.cone beside it, and the
// files of every subfolder beneath it, at any depth. Nothing here lists them,
// and that is the point.
//
// It runs rather than merely compiles, and it is the one folder scenario that
// can: a folder module is ONE module however many files it spans, so its
// declarations are the root's and are spelled bare, whichever file each was
// written in. Nothing here crosses a module boundary.
//
// The scenario folder holds sibling.cone, deep/nested.cone and
// deep/deeper/deepest.cone.

mod module_folder_sweep;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// Called from sibling.cone, which is parsed after this file: a module's names do
// not depend on which of its files they were written in, any more than on the
// order they were written in
fn twice(n i64) i64 {
  n * 2i64;
}

fn main() i32 {
  // A sibling file's declarations are this module's own: no qualifier, no
  // import, and no separate module to link against
  show("sibling-fn", siblingAdd(1i64));
  show("sibling-global", siblingTotal);
  // A sibling's global is this module's to write, and what is written is what
  // the next read sees
  siblingTotal = siblingTotal + 1i64;
  show("sibling-global-mutated", siblingTotal);
  // A subfolder is organisational, so its files join this module too
  show("subfolder-fn", nestedScale(3i64));
  // At any depth, and reaching names from every other file of the module
  show("deeper-fn", deepestOf(2i64));
  // And it reaches in both directions
  show("sibling-calls-designated", siblingDoubles(5i64));
  0i32;
}
