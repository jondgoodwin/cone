// The same, with the borrow of a temporary inside a struct value the setup
// stores: the loan walk's refusal (ErrorEscape), which 'init' meets for the
// same store ('w = W(&mk())'), and which the setup meets as it is walked as any
// function's is.

mod module_setup_borrow_struct_reject;

struct P { x: i64; }
struct W { pub p: &P; }
fn mk() P { P(7i64) }

let w: W = W(&mk());               //~ ErrorEscape "carries a borrow of a temporary"
