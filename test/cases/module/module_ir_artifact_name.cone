// The AST dump '--ir' writes is named for the source compiled, not for the
// pseudo-source corelib is injected from: this scenario's check asserts the
// file 'module_ir_artifact_name.ast' exists in the output folder and holds the
// function written below.

mod module_ir_artifact_name;

fn tallyIrArtifact(a: i32, b: i32) i32 {a + b}

fn main() {
  tallyIrArtifact(1i32, 2i32);
}
