// A submodule asking its parent for what the parent does not share. Every
// import of a name of the parent closes a loop through containment, and is
// refused for that (ErrorImportLoop) beside whatever binding it reports.

mod sub;

// Private to the parent, so refused as a private submodule is refused outside
// its parent: containment does not open a parent's private names downward
import secret;          //~ ErrorNotPublic "private to module_import_parent_nameres"
                        //~^ ErrorImportLoop

// A name the parent has not got, and no file answers either
import nothing;         //~ ErrorUnkName "neither a name of"
                        //~^ ErrorImportLoop

// A name this module declares itself, below the header. The import would make
// it mean two things
import shape;           //~ ErrorDupName "which declares it"
                        //~^ ErrorImportLoop

// A 'use' clause folds a module's names, and a struct is not a module. Its
// members are reached through it, as anywhere the type is named
import Point use *;     //~ ErrorBadFold:14 "not a module"
                        //~^ ErrorImportLoop

// Written twice: the import binds the parent's area, and the listed item names
// the same declaration again, through the sister's re-export. A name the module
// WRITES twice is an error even where both stand for one thing [Jon 23 Sep]
import area;    //~ ErrorImportLoop
import sib use area;    //~ ErrorDupName:16 "for the same thing"

fn shape() i64 {
  4i64;
}

pub fn user() i64 {
  area();
}
