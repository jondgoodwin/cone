// A module may declare its 'init' and 'final' public: the declaration is legal,
// and only naming one is refused (module_lifecycle_named_nameres). Here the
// submodule counted's are public and nothing names them, and a public function
// of counted is called by path as ever. 'initAll()' runs counted's 'init' once
// and 'finalAll()' its 'final' once (printed with a count), after this module's.

mod module_lifecycle_unnamed;

import stdio use *;

fn final() {
  printStr("final root\n");
}

fn main() i32 {
  initAll();
  printStr("work ");
  printInt(counted.work(41i64));
  printStr("\n");
  finalAll();
  0i32
}
