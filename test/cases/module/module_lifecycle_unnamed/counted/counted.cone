// A submodule whose 'init' and 'final' are public and which nobody names. The
// program's stitched init and final run each exactly once: the output counts them.

mod counted;

import stdio use *;

var @threadlocal inits = 0i64;
var @threadlocal finals = 0i64;

pub fn @initpure init() {
  inits = inits + 1i64;
  printStr("counted init #");
  printInt(inits);
  printStr("\n");
}

pub fn final() {
  finals = finals + 1i64;
  printStr("counted final #");
  printInt(finals);
  printStr("\n");
}

// An ordinary public function of the same module, called by path
pub fn work(n: i64) i64 {
  n + inits
}
