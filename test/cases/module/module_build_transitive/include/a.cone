// Package a's include file, written by hand. It is a module file like any
// other, so it opens with its 'mod' line and imports what its declarations
// name: b, whose Counter a's functions take and return. The program's build
// description has a package line for b, and that is what answers this import.

mod a;

import b;

pub extern fn start(n i64) b.Counter;

pub extern fn advance(c b.Counter) b.Counter;
