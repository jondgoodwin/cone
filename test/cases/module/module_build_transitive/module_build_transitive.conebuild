// A program compiled against a's include file, which imports b's. The package
// lines at the top list every package of the compile's dependency closure, b
// among them though the program does not import it, so the import a's include
// file writes is answered. The program's own module still imports only what its
// own lines give it. Packages b and a are compiled on their own first (listed
// under 'link' in cases.toml), and all three objects are linked.

build: debug
output: executable

import b: "include/b.cone"
import a: "include/a.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import a: "include/a.cone"
    import stdio: "stdio.cone"
}
