// The program imports a alone. The Counter a returns is b's type, declared in
// b's include file, which a's include file imports; its methods run in b's
// object. The program never names b.

mod prog;

import stdio use *;
import a;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  imm c = a.start(10i64);
  show("count", c.count);
  show("step", c.step);
  show("next", c.next());
  imm d = a.advance(c);
  show("advanced", d.count);
  show("scaled", d.scaled(2i64));
  0i32;
}
