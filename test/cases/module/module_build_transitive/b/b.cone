// Package b, at the bottom of the chain: a public struct with methods. The
// program never imports b; it reaches Counter only through what a returns.

mod b;

pub struct Counter {
  pub count i64;
  pub step i64;

  pub fn next(self) i64 {
    count + step;
  }

  pub fn scaled(self, k i64) i64 {
    (count + step) * k;
  }
}
