// An importer of the extending module. What it sees through solids is solids'
// public surface, and shapes' private name is no part of that.

mod peek;

import solids;

pub fn reach() i64 {
  solids.edge();
}

fn past() i64 {
  solids.secret();                        //~ ErrorNotPublic:10 "private to shapes, which solids extends"
}
