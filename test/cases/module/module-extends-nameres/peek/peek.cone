// An importer of the extending module. What it sees through solids is solids'
// public surface, and shapes' private name is private in solids: not by path,
// and not by a listed clause.

mod peek;

import solids use edge, secret;           //~ ErrorNotPublic:25 "secret is private to solids, so it does not fold"

pub fn reach() i64 {
  solids.edge() + edge();
}

fn past() i64 {
  solids.secret();                        //~ ErrorNotPublic:10 "private to its module"
}
