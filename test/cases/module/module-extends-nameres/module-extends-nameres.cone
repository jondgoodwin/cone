// What 'extends' on a module refuses, once every name is bound.
//
// Name-resolution stage: every declaration parses, and what is refused is what
// an 'extends' names, or what it would make a name mean.
//
// The folder holds:
//   shapes/shapes.cone       the base: public names, and one private
//   solids/solids.cone       extends shapes, redeclares one of its names, and names its private one
//   peek/peek.cone           imports solids and names shapes' private name through it
//   arena/arena.cone         extends a trait, which is the module-trait reading, not built
//   notmod/notmod.cone       extends a function
//   me/me.cone               extends itself
//   ping/ping.cone           extends pong, which extends ping
//   pong/pong.cone
//   outer/outer.cone         extends its own submodule
//   outer/child/child.cone   extends its parent
//   outer/deep/deep.cone     extends a module out of its reach

// A trait of the parent, so its children's registry holds it. 'mod arena extends
// Region' is the spelling the module design brief gives a module conforming to a
// module trait, which is a different reading from reuse and is not built
pub trait Region {
  fn size(self) i64;
}

// A function of the parent, which the registry holds beside its submodules
fn helper() i64 {
  shapes.area(1i64, 1i64);
}
