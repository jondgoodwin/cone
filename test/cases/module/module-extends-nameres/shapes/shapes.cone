// The base solids extends: public names, and two private.

mod shapes;

pub fn area(w i64, h i64) i64 {
  w * h;
}

pub fn perimeter(w i64, h i64) i64 {
  2i64 * (w + h);
}

// Private. solids reaches it, as an enriching type reads its base's private
// names; nothing outside solids does
fn secret() i64 {
  7i64;
}

// Private, and solids redeclares it
fn tally() i64 {
  0i64;
}
