// The base solids extends: public names, two private, and two imports.

mod shapes;

// A dependency of shapes, and a fold. 'tripled' is a name of shapes, so solids
// has it; 'tools' is bound for shapes alone
import tools use tripled;

// Only a dependency: the one name it binds is gauge's own, and solids does not
// take it
import gauge;

// A dependency, and the same module folded in under the same name through
// relay's re-export. The fold makes 'meter' a name of shapes, so solids takes it
import meter;
import relay use meter;

pub fn area(w i64, h i64) i64 {
  w * h;
}

pub fn perimeter(w i64, h i64) i64 {
  2i64 * (w + h);
}

// Private. solids reaches it, as an enriching type reads its base's private
// names; nothing outside solids does
fn secret() i64 {
  7i64;
}

// Private, and solids redeclares it
fn tally() i64 {
  0i64;
}

fn measured() i64 {
  tools.halved(tripled(gauge.reading())) + meter.level();
}
