// A module that extends shapes and then redeclares what it was given.

mod solids extends shapes;

// A module that extends another ADDS to it, as a type that extends one does: one
// name of solids would otherwise mean two things, depending on which module
// reached it. Reported here, at what has to change
pub fn area(w i64, h i64) i64 {          //~ ErrorExtendsOverride "adds to it rather than redeclaring"
  w * h * 2i64;
}

// The same for a private name of shapes: solids has it, so solids may not
// declare it again
fn tally() i64 {                          //~ ErrorExtendsOverride "adds to it rather than redeclaring"
  1i64;
}

pub fn edge() i64 {
  // A public name of shapes, bare: this is what 'extends' is for
  perimeter(1i64, 2i64);
}

fn peek() i64 {
  // A private name of shapes is a private name of solids, so it is reached here
  secret();
}

// What shapes' import folded in is a name of shapes, so it is a name of solids,
// and redeclaring it is the same refusal as for anything shapes declares
fn tripled(n i64) i64 {                   //~ ErrorExtendsOverride "adds to it rather than redeclaring"
  n;
}

// shapes' import of tools states a dependency of shapes, not a part of it, and
// the name it binds stays in shapes: solids names tools only by importing it
fn noImport() i64 {
  tools.halved(8i64);                     //~ ErrorUnkName:3 "The name tools does not refer to a declared name"
}

// For the same reason gauge is no name of solids, so solids may declare one
fn gauge() i64 {
  0i64;
}

// shapes imports meter, but a 'use' clause of shapes also folds the name in
// through relay, and what a fold brings in is a part of shapes: solids has it
fn viaFold() i64 {
  meter.level();
}
