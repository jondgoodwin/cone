// Package g's source: a generic module as a package's root, declaring one of
// each kind an instance holds a copy of -- an enum, a generic type, a generic
// function, a trait and the types taking it, a macro, and a global's 'use'
// clause. Compiled on its own, it makes nothing: each importer compiles every
// instance it uses, and every declaration of it, from the source g's include
// file carries.

mod g[T];

pub var @threadlocal total: T = 0;

// An enum whose variant holds a T
pub enum Slot {
  Empty;
  Full(T);
}

pub var @threadlocal last: Slot = Slot.Empty;

// A generic type: U its own
pub struct Pair[U] {
  pub a: T;
  pub b: U;
  pub fn first(self) T {
    a
  }
}

// A generic function: V its own
pub fn second[V](x: T, v: V) V {
  v
}

// A trait, and a type taking it
pub trait Has {
  pub fn get(self: &) T;
}

pub struct Box is Has {
  pub v: T;
  pub fn get(self: &) T {
    v
  }
}

fn viaRef(h: &<Has) T {
  h.get()
}

// A macro whose parameter is a T
macro dbl[x: T] {
  x + x
}

// A global folding its type's field in
pub struct Dial {
  pub level: T;
}

pub var @threadlocal dial: Dial = Dial(0) use level;

// Adds x to the instance's total through each of them, and answers the total:
// x twice through the macro, once through the trait, once through the
// generic type, once through the generic function, and the last value put
// through the enum and through the fold
pub fn add(x: T) T {
  let b = Box(x);
  let p = Pair[i32](x, 1i32);
  let prior = match last {
    case is Slot.Empty {x}
    case let Slot.Full(v) {v}
  };
  last = Slot.Full(x);
  level = x;
  total = total + dbl[x] + viaRef(&b) + p.first() + second[T](x, x) + prior + level;
  total
}
