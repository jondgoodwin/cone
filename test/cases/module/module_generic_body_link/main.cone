// The program: g[i64] -- every copy its declarations made -- is defined in this
// object and in q's, and the linker keeps one copy, so q's code and this
// program's add to one total and see one last value put. g[f64] is this
// object's alone.
//
// add(x) adds 6x and the value put before (x itself the first time) to the
// total: 35 and 35 for q's two adds of 5, 11 for the program's add of 1; 3.5,
// then 2 for g[f64]'s 0.5 and 0.25.

mod prog;

import stdio use *;
import g;
import q;

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label: &Array[u8], n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn main() i32 {
  show("q.addTwice", q.addTwice(5i64));      // 70
  show("g[i64].add", g[i64].add(1i64));      // 81
  show("q.total", q.total());                // 81
  showF("g[f64].add", g[f64].add(0.5));      // 3.5
  showF("g[f64].add", g[f64].add(0.25));     // 5.5
  0i32
}
