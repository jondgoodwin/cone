// A global declaration with no name, in an imported module.
//
// 'recover' rather than 'reject' because the diagnostics are reported inside
// modulenoname.cone and an inline annotation is matched only against the
// scenario's own source path. The count and the exit status are the assertion,
// and they are what this is about: the compiler reports the malformed
// declaration and stops, where it used to report it and then segfault naming
// the symbol.

import modulenoname::*

fn user() i64 {
  3i64
}
