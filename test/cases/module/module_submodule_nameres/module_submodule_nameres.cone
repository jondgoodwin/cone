// What a path through the module tree may not reach.
//
// Name resolution stage: a submodule is drawn at parse, and what it shows to whom
// is decided where any other name's visibility is.
//
// The folder holds:
//   store/store.cone        a submodule, with a private declaration
//   store/cache/cache.cone  a submodule of store, not written 'pub'
//   log/log.cone            a sister of store

mod module_submodule_nameres;

fn main() i32 {
  // Its own submodule's public name: this is what works, and module_submodule
  // runs it
  store.keep(1i64);

  // A submodule's private declaration. The parent may name the module and may not
  // see through it: a module's private names are its own, and a parent is outside
  // the module however far inside its folder tree it sits
  store.hidden(2i64);         //~ ErrorNotPublic "private to its module"

  // A submodule of a submodule that its declaration does not open. 'cache' is
  // private to store, and this module is store's parent rather than cache's, so
  // it is outside -- written 'pub mod cache;' it would be in reach, which is what
  // module_submodule's 'scaling' pins
  store.cache.hold(3i64);     //~ ErrorNotPublic "private to its module"
  0i32;
}
