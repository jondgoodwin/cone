// Two include files that import each other, both answered by package lines:
// the loop is the compile's to refuse, as between any two modules, whether or
// not Congo's package-level check saw it in the packages' sources.

import a: "include/a.cone"
import b: "include/b.cone"

p: {
    "src/p.cone"
    import a: "include/a.cone"
}
