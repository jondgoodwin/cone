// THE posix PACKAGE CHOOSES ITS SYSTEM'S CALLS BY THE TARGET. posix is a C
// package in the packages folder, over libc and core, found on the package
// search path and compiled into this object. Built for Windows (this
// scenario's runs name the triple), a POSIX name bound to the runtime's
// underscore spelling is that symbol, called (stat calls _stat64, popen
// _popen, chdir _chdir, _findfirst64 itself); one whose arguments differ from
// the runtime's is an inline function, which defines nothing and calls the
// runtime's own (mkdir calls _mkdir, realpath _fullpath). The functions that
// stand for the C library's own on Linux ('stat', 'setenv') are defined under
// symbols of posix's (cone_posix_stat), so that none stands in for the C
// library's, and what they call of the other system is not generated.
//
// It compiles and stops: what the bindings do when run is posix's own test,
// packages/posix/tests/, which 'congo test' runs.

mod module_package_posix;

import posix use *;

fn main() i32 {
  var st = new Stat(0u64, 0u64, 0u16, 0u32, 0u32, 0u32, 0u64, 0i64, 0i64, 0i64, 0i64);
  var info = new FindData64(0u32, 0i64, 0i64, 0i64, 0i64, new Array[u8, 260] <- fill 0u8);
  let status = stat("module_package_posix.dir", &mut st);
  let pipe = popen("echo", "r");
  pclose(pipe);
  let moved = chdir("..") + mkdir("module_package_posix.dir", 0x1EDu32);
  let set = setenv("CONE_POSIX_SYMBOLS", "1", 1i32);
  realpath(".", 0usize as *u8);
  _findfirst64("*", &mut info);
  status + moved + set
}
