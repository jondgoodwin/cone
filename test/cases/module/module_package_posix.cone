// THE posix PACKAGE'S NAMES ARE THE RUNTIME'S SPELLINGS. posix is a C package in
// the packages folder, over libc, found on the package search path and compiled
// into this object. A POSIX name bound to the Windows runtime's underscore
// spelling is that symbol (stat is _stat64, popen _popen, chdir _chdir,
// _findfirst64 itself); one whose arguments differ from the runtime's is an
// inline function, which defines nothing and calls the runtime's own (mkdir
// calls _mkdir, setenv _putenv_s, realpath _fullpath).
//
// It compiles and stops: what the bindings do when run is posix's own test,
// packages/posix/tests/, which 'congo test' runs.

mod module_package_posix;

import posix use *;

fn main() i32 {
  mut st = Stat[0u32, 0u16, 0u16, 0i16, 0i16, 0i16, 0u32, 0i64, 0i64, 0i64, 0i64];
  mut info = FindData64[0u32, 0i64, 0i64, 0i64, 0i64, [260; 0u8]];
  imm status = stat(&[]"module_package_posix.dir", &mut st);
  imm pipe = popen(&[]"echo", &[]"r");
  pclose(pipe);
  imm moved = chdir(&[]"..") + mkdir(&[]"module_package_posix.dir", 0x1EDu32);
  imm set = setenv(&[]"CONE_POSIX_SYMBOLS", &[]"1", 1i32);
  realpath(&[]".", 0usize as *u8);
  _findfirst64(&[]"*", &mut info);
  status + moved + set;
}
