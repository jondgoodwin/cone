// Package h: a public type may not hold a private type in a public field. A
// pub field of a pub type is reached from outside the module, so its type must
// be one the outside can name; were it private, an importer would hold values
// of a type it cannot name and reach into them through the field. The field is
// made private, which h's own code still reaches, or the type is made pub.
// module_include_private_reach is the private field, reached by h's inline
// body in an importer's object.

mod h;

struct Inner {
  pub v i64;
  pub fn get(self) i64 {
    v;
  }
}

pub struct Outer {
  pub inner Inner;  //~ ErrorPubFieldPrivType "The field inner is pub, but its type Inner is private to its module"
}

pub fn make(v i64) Outer {
  new Outer(new Inner(v));
}

pub fn val(o Outer) i64 inline {
  o.inner.get();
}
