// Package h: a private type, Inner, that a public type holds in a public field.
// Nothing names Inner where an importer can see it, yet the importer holds
// values of it through that field and calls its public method, in its own code
// and in the inline body it expands. So the include file declares the method,
// and h's object exports it.

mod h;

struct Inner {
  pub v i64;
  pub fn get(self) i64 {
    v;
  }
}

pub struct Outer {
  pub inner Inner;
}

pub fn make(v i64) Outer {
  Outer[Inner[v]];
}

pub fn val(o Outer) i64 inline {
  o.inner.get();
}
