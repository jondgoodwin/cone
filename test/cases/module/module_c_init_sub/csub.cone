// A C-named submodule with an 'init'. It is part of the program's own compile,
// and still not the stitched init's to run: the C runtime runs it before
// 'main', so the root's 'init' (which is stitched) finds it already run.

mod @c("sub_") csub;

var Ran: i64 = 0i64;

fn @initpure init() {
  Ran = Ran + 5i64;
}

pub fn Get() i64 {
  Ran
}
