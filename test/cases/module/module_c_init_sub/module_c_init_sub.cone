// A C-named module's 'init' runs ahead of the stitched init, whatever imports
// it. The root reads csub's value in its own 'init': it is already 5, which is
// the module's 'init' having run before the program's.

mod module_c_init_sub;

import stdio use *;

imm seen i64;

fn @initpure init() {
  seen = csub.Get();
}

fn main() i32 {
  printStr("seen by init = ");
  printInt(seen);
  printStr("\n");
  printStr("csub = ");
  printInt(csub.Get());
  printStr("\n");
  0i32;
}
