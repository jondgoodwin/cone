// The submodule module_brand_path names its types through: a struct declaring a
// brand, a generic one declaring a brand beside its type parameter, one
// declaring an ordinary lifetime, and an enum whose struct variant is branded.

mod ir;

import arena use *;

pub struct Compile['=c] {
  pub ar: DynArena['=c];
  pub count: i32;
}

pub struct Held['=c, T] {
  pub key: &'=c i64;
  pub extra: T;
}

pub struct View['a] {
  pub of: &'a i64;
}

pub enum @unsized Node['=c] {
  pub line: i64;
  pub struct Leaf {
    pub val: i64;
  }
}

pub fn make(v: i64) i64 {
  v * 10i64
}
