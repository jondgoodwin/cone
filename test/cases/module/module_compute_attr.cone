// '@compute' goes only where a dispatch can run a function by its name: a
// function of a module, not generic, not inline, not C-named.
// An 'extern' one, as a package's include file declares it, is called on
// the CPU as any function is.

mod module_compute_attr;

struct Holder {
  n u32;

  fn @compute(64) method(self &, inv Invocation) {}  //~ ErrorComputeAttr
}

fn @compute(64) generic[T](inv Invocation, a &[]T) {}  //~ ErrorComputeAttr
fn @compute(64) expanded(inv Invocation) inline {}  //~ ErrorComputeAttr
fn @compute(64) @c cnamed(inv Invocation) {}  //~ ErrorComputeAttr

pub extern {
  fn @compute(64) elsewhere(inv Invocation, out &[]mut u32);
}
