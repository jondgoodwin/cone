// What the stream's C-string entry refuses. It takes a `cstr`, which promises the zero that
// ends it. A raw `*u8` does not (it may be null, or point at bytes with no zero), and a `&u8`
// converts to a `*u8`, so neither is a C string: before this, `print <- p` with a `&u8` or a
// `*u8` read memory up to a zero it had no reason to find. `print <-` and `eprint <-` do not
// take a pointer at all now, and `appendCStr` takes only a `cstr`. A `&u8` given to `<-` is a
// number (module_stdio_cstr), so it is not in this list.
//
// - a raw pointer to `<-`, to each stream;
// - a raw pointer, and a borrow of a byte, to `appendCStr`, to each stream.

mod module_stdio_cstr_reject;

import stdio use *;

fn main() {
  let b = 7u8;
  let r = &b;
  let p = r as *u8;
  print <- p;                  //~ ErrorNoCandidate
  eprint <- p;                 //~ ErrorNoCandidate
  print.appendCStr(p);         //~ ErrorNoCandidate
  eprint.appendCStr(p);        //~ ErrorNoCandidate
  print.appendCStr(r);         //~ ErrorNoCandidate
  eprint.appendCStr(r);        //~ ErrorNoCandidate
}
