// Two imported names that a symbol scheme joining module and name with a '_'
// would spell identically: 'z' in module 'modulex_y' and 'y_z' in module
// 'modulex'. cases.toml asserts that they are two symbols: each component of a
// symbol is length-prefixed, so nothing about the characters in a name can
// make two paths coincide.
//
// It compiles rather than runs: it spans modules, which cannot be linked yet.
//
// The imported modules are modulex_y.cone and modulex.cone.

import modulex_y use *;
import modulex use *;

fn both() i64 {
  z() + y_z();
}
