// module-onefile's lexer.cone, grown into a folder: the designated file of
// lexer/, drawing the submodule that one file drew, under the same name.

mod lexer;

// Its own imports come right after its 'mod'. tokens is a sister, found in the
// registry the parent's namespace is
import tokens;

pub fn scan(n i64) i64 {
  tokens.weight(n) + bias();
}

// Private to this module
fn bias() i64 {
  1i64;
}
