// GROWING A ONE-FILE MODULE INTO A FOLDER CHANGES NOTHING for anyone who names
// it: the same name, the same paths, the same symbols.
//
// This is module-onefile with two of its one-file modules grown into folders --
// lexer.cone moved to lexer/lexer.cone, and parser/ast.cone to
// parser/ast/ast.cone -- and nothing else changed. Every function body in the
// tree is the same text, the output is the same, and the symbols check in
// cases.toml lists the same symbols as module-onefile's: the two scenarios are
// the equivalence, and a change that spelled one shape differently would fail
// one of them.
//
// The folder holds:
//   helper.cone               no 'mod': swept into this module
//   lexer/lexer.cone          'mod lexer', a folder submodule, importing tokens
//   tokens.cone               'mod tokens', still one file
//   parser/parser.cone        a folder submodule, importing its sister lexer
//   parser/ast/ast.cone       'pub mod ast', a folder submodule of parser

import stdio use *;

// A standalone 'use' of a submodule folds its public names in
use lexer;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("swept-file", helperAdd(2i64, 3i64));
  show("by-path", lexer.scan(4i64));
  show("folded-by-use", scan(5i64));
  show("sister-import", parser.parse(2i64));
  show("pub-grandchild", parser.ast.depth());
  show("imported-sister", tokens.weight(7i64));
  0i32;
}
