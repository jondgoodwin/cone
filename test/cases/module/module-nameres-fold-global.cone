// What a global's 'use' clause may not admit, and what it may not fold from.
//
// A global is the one-instance analogue of a field, so its clause is expanded
// while the module is name resolved and what it may admit is this stage's
// question: visibility, a name the type has not got, a static, a collision, a
// source that is not a struct, and a 'pub' fold reached through a private global.
//
// The parse-stage half -- a clause on a local, a parameter or a type's static,
// where there is no namespace to fold into -- is struct-parse-fold.

struct Panel {
  pub width i64;
  pub height i64;

  pub fn area(self) i64 {
    width * height;
  }

  // Private to Panel
  fn tally(self) i64 {
    width;
  }

  // Reached through the type rather than through a value
  pub fn scaled(n i64) i64 {
    n * 2i64;
  }
}

trait Surface {
  pub coat i64;
}

// Visibility is transitive: only what the global's type shows folds, whatever
// the clause names
mut a Panel = Panel[1i64, 2i64] use tally;
                                //~^ ErrorNotPublic:37 "is private to Panel"

// A name the type has not got, whether it is listed or left out; and left out, a
// private name is as absent as a missing one, since '*' never folds it
mut b Panel = Panel[1i64, 2i64] use depth;
                              //~^ ErrorNoMbr:37 "has no member named depth"
mut c Panel = Panel[1i64, 2i64] use * but depth, tally;
                                    //~^ ErrorNoMbr:43 "no member named depth to leave out"
                                    //~^^ ErrorNotPublic:50 "tally is private to Panel, so '*' never folds it; there is nothing to leave out"

// A static is reached through the type, not through a value. A global is the
// value route at module scale, exactly as a field is at type scale, so a static
// does not arrive that way -- it is named 'Panel.scaled'.
mut d Panel = Panel[1i64, 2i64] use scaled;
                                //~^ ErrorBadFold:37 "is a static of Panel"

// One namespace, one collision domain: a folded name may not take a spelling the
// module already has, whoever declared it
mut e Panel = Panel[1i64, 2i64] use area as collides;
                              //~^ ErrorDupName:37 "is already a name of this module"

fn collides() i64 {
  1i64;
}

// A fold reaches through a value's own members, and an abstraction has none
mut f Surface use coat;
              //~^ ErrorUseGlobal:15 "is a trait"

// A fold takes its names from a struct
mut g i64 = 1i64 use width;
                //~^ ErrorUseGlobal:18 "is not one"

// A 'pub' fold is reached from outside through the global, so a private global
// has nothing to offer outside itself. Folding privately through it is fine, and
// is what the default does. Reported at the 'use', where the fold is.
mut h Panel = Panel[1i64, 2i64] pub use height as pubHeight;
                            //~^ ErrorNotPublic:37 "Declare it 'pub', or fold privately"
