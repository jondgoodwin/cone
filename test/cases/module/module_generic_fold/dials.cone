// A GENERIC MODULE whose global folds names of its type in with a 'use'
// clause. Each instance holds its own copy of the global and of its type, Dial,
// whose field is the module's T, and its own copies of the folded names,
// reached through its own global: 'level' is dial.level and 'read' dial.read,
// the instance's.
pub mod dials[T];

pub struct Dial {
  pub level: T;

  pub fn read(self) T {
    level + level
  }
}

pub var @threadlocal dial: Dial = Dial(0) use level, read as doubled;

pub fn set(x: T) {
  dial.level = x;
}

// The folded names, bare
pub fn get() T {
  level
}

pub fn twice() T {
  doubled()
}
