// A GLOBAL'S 'USE' CLAUSE INSIDE A GENERIC MODULE, treated as a generic type's
// members are [Jon 23 Sep]: each instance, dials[i64] and dials[f64], holds its
// own global and its own copies of the names the clause folds in, reached
// through that global -- so setting one instance's dial leaves the other's
// alone, and each reads its own T.
//
// This is the designated file of the scenario's folder; dials.cone beside it is
// the generic module. Each printed value was checked by hand against the source.

mod module_generic_fold;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label: &str, n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn main() {
  dials[i64].set(5i64);
  dials[f64].set(2.5);
  show("dials[i64].get", dials[i64].get());        // 5
  showF("dials[f64].get", dials[f64].get());       // 2.5
  show("dials[i64].twice", dials[i64].twice());    // 10
  showF("dials[f64].twice", dials[f64].twice());   // 5
  dials[i64].set(7i64);
  show("dials[i64].get", dials[i64].get());        // 7
  showF("dials[f64].get", dials[f64].get());       // 2.5
}
