// A GENERIC TYPE INSIDE A GENERIC MODULE, treated as a generic type's generic
// method is [Jon 23 Sep]: each instance of the module, pairs[i64] and
// pairs[f64], holds its own copy of Pair[U] with T substituted, and each copy
// has its own instances at its own arguments -- pairs[i64].Pair[f64] holds an
// i64 and an f64. A generic function of the module is named with its type
// argument through the instance, 'pairs[f64].make[i32]', as through any module.
//
// This is the designated file of the scenario's folder; pairs.cone beside it is
// the generic module. Each printed value was checked by hand against the source.

mod module_generic_gentype;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label: &str, n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn main() {
  // U inferred as f64: a pairs[i64].Pair[f64]
  let p = pairs[i64].make(3i64, 2.5);
  show("p.doubled.first", p.doubled().first());      // 6
  showF("p.b", p.b);                                 // 2.5

  // U given through the instance: a pairs[f64].Pair[i32]
  let q = pairs[f64].make[i32](1.5, 7i32);
  showF("q.first", q.first());                       // 1.5
  show("q.keep", q.keep(9i64));                      // 9

  show("pairs[i64].withTag.first", pairs[i64].withTag(4i64).first());   // 4

  // Each instance's own count: make once for i64; make and keep for f64
  show("pairs[i64].made", pairs[i64].made);          // 1
  show("pairs[f64].made", pairs[f64].made);          // 2
}
