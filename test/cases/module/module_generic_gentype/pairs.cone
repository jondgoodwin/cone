// A GENERIC MODULE declaring a generic type, which every instance holds a copy
// of: still generic, with the module's parameter substituted and its own left
// to its own instances, as a generic method is copied with its type. Its
// methods name both parameters, its own name inside its braces is the instance
// being defined, and one of its methods is generic too. A global counts what
// each instance made.
pub mod pairs[T];

pub var @threadlocal made: i64 = 0i64;

// T is the module's, U the type's own
pub struct Pair[U] {
  pub a: T;
  pub b: U;

  pub fn first(self) T {
    a
  }

  // Its own name, given its own parameter, inside its braces
  pub fn doubled(self) Pair[U] {
    Pair[U](a + a, b)
  }

  // A generic method: a third parameter, V
  pub fn keep[V](self, v: V) V {
    made = made + 1i64;
    v
  }
}

pub fn make[U](x: T, y: U) Pair[U] {
  made = made + 1i64;
  Pair[U](x, y)
}

// An instance of the copy named in the module's body
pub fn withTag(x: T) Pair[i32] {
  Pair[i32](x, 7i32)
}
