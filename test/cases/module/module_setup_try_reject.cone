// '?' in a 'let' global's value has no function to return a failure from, and is
// refused for that alone (ErrorQuesReturn). The value it takes is not also
// reported as a local that is not a constant.

mod module_setup_try_reject;

fn f() Result[i64, i32] { Ok(1i64) }

let a: i64 = f()?;       //~ ErrorQuesReturn "this is in none"
