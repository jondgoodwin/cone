// A signed remainder on SPIR-V's Vulkan form is not emitted as OpSRem: the
// RTX 4060's driver computes OpSRem (and OpSMod) unsigned, so that -7 % 3 came
// back 0 where it is -1, while OpSDiv is right. genlGpuSignedRem expands it
// after the pipeline to the dividend less the quotient times the divisor, an
// OpSDiv, OpIMul and OpISub. An unsigned remainder is OpUMod still.

mod module_target_spirv_srem;

fn @compute(64) rem(inv Invocation, xs &Array[i32], ys &Array[u32], out &mut Array[i32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len and i < ys.len {
    imm x = xs[i];
    out[i] = x % 3 + x % xs[0] + i32.from(ys[i] % 5u32);
  }
}
