// Package t, compiled on its own into a library object, which writes its
// include file. It compiles against the include files base's and dep's
// compiles generated, and against the file standing for stdio's.

build: debug
output: library

t: {
    "t.cone"
    "more.cone"
    import base: "../include/base.cone"
    import dep: "../include/dep.cone"
    import stdio: "../stdio.cone"
}
