// A second file of package t. It has no 'mod' line, so it has no imports:
// stdio, which its bodies print through, is imported in t.cone's header, where
// the module's every import is [Jon 23 Sep].

// Assigned by 'init', which the program's stitched init runs before its own
pub imm initValue i64;

fn @initpure init() {
  initValue = 42i64;
}

fn final() {
  printStr("t final\n");
}
