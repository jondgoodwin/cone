// Package t: one of each kind of declaration a library's include file carries,
// compiled on its own. The program compiles against the include file t's
// compile generates, and each value it prints comes from t's object, dep's or
// base's, or from a body the include file carries.

// 'extends' an imported module, and a default fold for a bare 'import t'
mod t extends base use tally;

import base;
import dep pub use Gadget;

// -------- enums --------

// A plain enum, folded in bare for t's own bodies
pub enum Op {
  Add, Sub;
}
use Op;

pub fn addOp() Op {
  Add[];
}

pub fn opCode(op Op) i64 {
  if op is Add {1i64;} else {2i64;}
}

// An enum whose variants carry fields and meet its requirement, one of them
// privately. A program that dispatches on a Shape calls both through vtables
pub enum Shape {
  pub fn area(self &) i64;

  pub struct Square {
    pub side i64;
    pub fn area(self &) i64 {
      side * side;
    }
  }

  pub struct Rect {
    pub w i64;
    pub h i64;
    fn area(self &) i64 {
      w * h;
    }
  }
}

pub fn areaOf(s &Shape) i64 {
  s.area();
}

// -------- a trait with a default --------

pub trait Speaker {
  pub fn loud(self &) i64;
  pub fn twice(self &) i64 {
    loud() * 2i64;
  }
}

pub struct Dog is Speaker {
  pub bark i64;
  pub fn loud(self &) i64 {
    bark;
  }
}

// -------- a macro, and the private function it reaches --------

fn step() i64 {
  5i64;
}

pub macro bumped[x] {
  x + step();
}

// -------- a C-named function --------

pub fn @c t_sum(a i64, b i64) i64 {
  a + b;
}

// -------- what the 'mod' line folds into a bare importer --------

pub fn tally() i64 {
  11i64;
}

// -------- a global folding its type's members in --------

pub struct Knobs {
  pub speed i64;
  pub fn boost(self) i64 {
    speed * 2i64;
  }
}

pub mut knobs Knobs = Knobs[7i64] pub use *;

// -------- globals whose types are inferred --------

pub struct Corner {
  pub x i64;
  pub y i64;
}

pub mut count = 12i64;
pub mut gadget = dep.Gadget[5i64];
pub mut corner = Corner[3i64, 4i64];

// -------- a private type a public one holds --------

struct Inner {
  pub v i64;
}

pub struct Holder {
  inner Inner;
  pub fn get(self) i64 {
    inner.v;
  }
  pub fn make(v i64) Holder {
    Holder[Inner[v]];
  }
}

pub fn makeHolder(v i64) Holder {
  Holder.make(v);
}

// -------- a typedef and a const --------

pub typedef Count i64;

pub const Limit = 50i64;

pub fn limitOf(c Count) Count {
  c + Limit;
}

// -------- private and unreached: left out --------

fn unused() i64 {
  0i64;
}

struct Unseen {
  n i64;
}
