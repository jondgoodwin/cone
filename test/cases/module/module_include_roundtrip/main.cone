// The program: compiled against the include files t's, dep's and base's
// compiles generated, and linked with the three objects. Every value comes
// from one of those objects, or from a body t's include file carries.

mod prog;

import stdio use *;
import t;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// Dispatches on a Shape in this object, which builds the vtables of t's
// variants and so calls both variants' 'area', the private one included
fn areaHere(s &t.Shape) i64 {
  s.area();
}

// What base's Ticket[T] is at each instance, by its condition
struct Token is Move {
  pub id i64;
}
fn moves[X](x &X) i64 where X is Move { 1i64; }
fn copies[X](x &X) i64 where X is Copy { 0i64; }

fn main() i32 {
  initAll();
  show("initValue", t.initValue);

  // Enums
  show("opCode", t.opCode(t.addOp()));
  imm sq t.Shape = t.Shape.Square[3i64];
  imm re t.Shape = t.Shape.Rect[2i64, 5i64];
  show("areaOf square", t.areaOf(&sq));
  show("areaOf rect", t.areaOf(&re));
  show("areaHere square", areaHere(&sq));
  show("areaHere rect", areaHere(&re));

  // A trait's default, taken by t's Dog
  imm dog = new t.Dog(21i64);
  imm speaker = &dog;
  show("twice", speaker.twice());

  // A macro, expanded here, calling t's private function
  show("bumped", t.bumped(10i64));

  // A C-named function
  show("t_sum", t.t_sum(2i64, 3i64));

  // What the 'mod' line folds into a bare import
  show("tally", tally());

  // 'extends': base's function and type, names of t
  show("origin", t.origin());
  show("pairSum", new t.Pair(1i64, 2i64).sum());
  imm ticket = new t.Ticket[i64](6i64);
  imm ticket2 = ticket;
  show("ticketCopies", copies(&ticket) + ticket2.n);
  show("ticketMoves", moves(&new t.Ticket[Token](1i64)));

  // 'pub use' on t's import of dep
  show("gadget", new t.Gadget(4i64).bigger());

  // A global's fold, and the global's members reached through it
  show("speed", t.speed);
  show("boost", t.boost());

  // Globals whose types were inferred
  show("count", t.count);
  show("gadgetSize", t.gadget.size);
  show("corner", t.corner.x + t.corner.y);

  // A public type holding a private one
  show("holder", t.makeHolder(9i64).get());

  // An alias and a const
  show("limitOf", t.limitOf(5i64));
  show("Limit", t.Limit);

  finalAll();
  0i32;
}
