// Package base: what package t extends. Every declaration here becomes a name
// of t as well, still base's own, so a program reaches base's function and
// type through t and links against base's object.

mod base;

pub fn origin() i64 {
  100i64;
}

pub struct Pair {
  pub x i64;
  pub y i64;

  pub fn sum(self) i64 {
    x + y;
  }
}

// Move only where its argument moves: the include file carries the condition,
// and each instance an importer makes decides it
pub struct Ticket[T] is Move if T is Move {
  pub n i64;
}
