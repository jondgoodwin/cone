// The round trip. Packages base, dep and t are each compiled on their own first
// ('link' in cases.toml), and each writes its include file, which must be the
// golden file under include\ ('include'). This program is compiled against
// those golden files, so against exactly what the packages generated, and
// linked with the three objects and conestd.
//
// t's include file imports base, dep and stdio, as t's source does, so each has
// a package line: they answer an include file's imports.

build: debug
output: executable

import base: "include/base.cone"
import dep: "include/dep.cone"
import stdio: "stdio.cone"
import t: "include/t.cone"

prog: {
    "main.cone"
    import t: "include/t.cone"
    import stdio: "stdio.cone"
}
