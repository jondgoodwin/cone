// '@c' written where it says nothing, or where nothing has a symbol for it to name.
//
// Parse stage only: parse errors skip semantic analysis. The module is C-named,
// so its functions are C names already.

mod @c creject;

// A bare '@c' in a module that already gives its functions C names says nothing
extern fn @c twice(n i32) i32;              //~ ErrorCNameTwice
// The string form is the override, and '@c(system)' changes the convention:
// each says something, so neither is refused
extern fn @c("other_name") renamed(n i32) i32;
extern fn @c(system) stdcalled(n i32) i32;

// '@c' takes a string, 'system', or both
extern fn @c(fast) badcc();                 //~ ErrorCAttr
// A function's string is its whole symbol, so an empty one names nothing
extern fn @c("") empty();                   //~ ErrorCAttr
// A type has no symbol
struct @c Pt { x i32; }                     //~ ErrorCAttr
// An inline function leaves no symbol behind, and a generic one has one per instance
fn @c("f") inl() i32 inline { 1; }          //~ ErrorCAttr
fn @c("g") gen[T](x T) T { x; }             //~ ErrorCAttr
// A trait's method is copied into each implementer
trait Shape { fn @c("area") area(self &) i32; }   //~ ErrorCAttr
// The retired spelling: the convention is '@c(system)' on the fn
extern system fn old();                     //~ ErrorCAttr
