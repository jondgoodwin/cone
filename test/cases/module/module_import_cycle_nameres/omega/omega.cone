// Lists gamma's shared twice: through psi, which carries it round the cycle
// the two make, and from gamma itself. psi reads this module before gamma's
// clause has run, so the first listing waits and is made in a later pass. The
// same declaration written twice is refused [Jon 23 Sep], once, and at gamma's
// clause, the one a single pass would have met second -- not once per pass.

mod omega;

import psi use shared;
import gamma pub use shared;              //~ ErrorDupName:22 "shared is already a name of this module, for the same thing"

pub fn o() i64 {
  shared();
}
