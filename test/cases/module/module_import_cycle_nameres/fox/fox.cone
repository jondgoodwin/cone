// Two different shareds under one name: delta's by echo's wildcard, gamma's by
// the clause below it. gamma's arrives first, since echo is mid-fold the first
// time this reads it; delta's arrives in the next pass. The collision is reported
// once, at the clause a single pass would have met it at -- the later one, gamma's
// -- and not again by any pass after.

mod fox;

import echo use *;    //~ ErrorImportLoop
import gamma use shared;    //~ ErrorDupName:18 "shared is already a name of this module. A folded name must be unique: rename it with 'as', or leave it out with 'but'."
