// What 'include', 'extern' and namespace qualification do, established by
// running them.
//
// This is the group's only running program, and it can only be one because a
// program that spans modules cannot be linked yet: an imported module's symbols
// are namespaced while a module compiled on its own emits root-module ones, so
// the two never resolve (workitems/Packages and Separate Compilation.md).
// 'include' is the one composition form that stays inside a single module -- it
// injects another file's global declarations into this one -- so it is the only
// one a running program can establish. Everything 'import' does is in the
// 'compile' scenarios beside this file.
//
// The 'mod' header names this module, which is what makes a declaration of its
// own reachable past a local that hides it. It names the module something other
// than the file's basename deliberately: the declaration is the module's
// identity, and the file is only where the module was found.
//
// The included file is moduleinc.cone.

mod onemod;

import stdio.*;
include moduleinc;

// 'extern' declares a signature the linker resolves, either as a block of them
// or one at a time. These two come from the C runtime the runner already links.
extern {
  fn abs(n i32) i32;
}

extern fn labs(n i64) i64;

// A type is a namespace as well, so a function declared inside one that takes
// no self is reached by qualifying it rather than through a receiver.
struct Counter {
  fn stepOf(n i64) i64 {
    n + 1i64;
  }
}

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// Called from moduleinc.cone, which is parsed before this declaration is
fn twice(n i64) i64 {
  n * 2i64;
}

// A module-level global, reached by its bare name, and reached past a local of
// the same spelling by qualifying it with the module's name. A path starts with
// the name of the namespace it walks, and the 'mod' header is what gives the
// module one.
mut counted i64 = 7i64;

fn pastLocal() i64 {
  imm counted = 1i64;
  counted * 1000i64 + onemod.counted;
}

// Declared above the global whose fold gives it 'cols', because a module's names
// do not depend on the order they were written in: every fold is expanded before
// any of the module's bodies is name resolved
fn foldedFromAbove() i64 {
  cols;
}

// A global folds its type's members in as names of this module. A global is the
// one-instance analogue of a field, so the clause reads exactly as a field's --
// '*', a list, 'as', 'but' -- and what it reaches a member through is one address
// known at compile time rather than an offset from a receiver found at the call.
struct Border {
  pub margin i64;

  pub fn doubledMargin(self) i64 {
    margin * 2i64;
  }
}

struct Settings {
  pub rows i64;
  pub cols i64;

  // A field with a fold clause of its own, so that a fold chains: 'margin' is
  // Border's, held by Settings through 'edge', and held here through 'settings'
  pub edge Border use *;

  pub fn cells(self) i64 {
    rows * cols;
  }

  // An overload name and its two candidates, all folded: the overload name is a
  // binding like any other, and a call through the folded spelling selects among
  // its candidates exactly as one written through the global does
  pub fn growRows overload grow(self, n i64) i64 {
    rows + n;
  }

  pub fn growCols overload grow(self, n f32) i64 {
    cols + i64[n];
  }

  // Private to Settings, so a wildcard fold passes it over and nothing here can
  // name it: module-nameres-fold-global holds that refusal
  fn hidden(self) i64 {
    rows;
  }

  // A static is reached through the type and not through a value, so it does not
  // fold through a global any more than it folds through a field
  pub fn doubled(n i64) i64 {
    n * 2i64;
  }
}

mut settings Settings = Settings[2i64, 3i64, Border[8i64]] use *;

// A second global, folded selectively, renamed, and written in the block form a
// long list would want
mut backup Settings = Settings[5i64, 7i64, Border[1i64]] use {
  rows as backupRows,
  cells as backupCells,
};

fn main() i32 {
  // An included declaration is this module's own: no qualifier needed, and no
  // separate module to link against
  show("included-fn", includedAdd(1i64));
  show("included-global", includedTotal);
  includedTotal = includedTotal + 1i64;
  show("included-global-mutated", includedTotal);
  // The included file calling back into this one, which is only possible
  // because the two share one namespace
  show("included-calls-includer", includedTwice(4i64));
  show("extern-block", i64[abs(-5i32)]);
  show("extern-single", labs(-7i64));
  show("type-qualified", Counter.stepOf(41i64));

  counted = counted + 2i64;
  show("module-global", counted);
  show("module-global-past-local", pastLocal());
  show("module-fn", twice(3i64));

  // A folded field and a folded method are this module's own names, reached with
  // no receiver written
  show("global-fold-field", rows);
  show("global-fold-method", cells());
  show("global-fold-from-above", foldedFromAbove());
  // The folded field is the global's field, so writing it writes the global and
  // the method reads what was written
  rows = rows + 3i64;
  show("global-fold-field-assigned", settings.rows);
  show("global-fold-method-sees-it", cells());
  // A folded name is an entry in the module's own namespace, so the module's name
  // reaches it as it reaches any other
  show("global-fold-qualified", onemod.cols);
  // The second global's fold: renamed, and written in the block form
  show("global-fold-renamed-field", backupRows);
  show("global-fold-renamed-method", backupCells());
  // A fold chains: 'margin' is Border's, Settings holds it through the field
  // 'edge', and this module holds it through the global -- so the receiver is
  // shifted one hop from the global's fixed address
  show("global-fold-chained-field", margin);
  show("global-fold-chained-method", doubledMargin());
  // A folded overload name selects among its candidates by the argument
  show("global-fold-overload-i64", grow(10i64));
  show("global-fold-overload-f32", grow(1.5));
  0i32;
}
