// Included by module-success.cone. It is injected into that module rather than
// compiled on its own, so it is listed in cases.toml as a support module.
//
// Its name carries no '-' because a module name has to be spellable as an
// identifier where a qualifier needs it; the scenario files keep the group's
// 'module-' prefix, the support files keep a prefix an identifier can hold.

fn includedAdd(n i64) i64 {
  n + 100i64
}

mut includedTotal = 5i64

// The including file's declarations are in scope here too: an include makes one
// namespace out of both files, and it reaches in both directions.
fn includedTwice(n i64) i64 {
  twice(n)
}
