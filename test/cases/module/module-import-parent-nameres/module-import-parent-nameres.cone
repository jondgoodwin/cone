// What an import of a PARENT'S name refuses, once the names are bound.
//
// Name-resolution stage: an import of a name of the parent is bound in the fold
// passes, once the parent's namespace is complete, so every refusal here is
// reported there rather than at parse. Each such import also makes the child
// depend on the parent that contains it, a loop, refused before the folds run
// (ErrorImportLoop) [Jon 23 Sep]; what binding reports is reported beside it.
//
// The folder holds:
//   sub/sub.cone   imports a private name, a name this module has not got, a
//                  name it also declares, a struct with a 'use' clause, and a
//                  name it also lists from its sister
//   sib/sib.cone   a sister, re-exporting one of this module's names

pub struct Point {
  pub x i64;
}

pub fn area() i64 {
  2i64;
}

pub fn shape() i64 {
  3i64;
}

// Private: this module's own, and what a submodule may not import. 'pub' is
// what a parent shares downward, as it is what a module shares outward
fn secret() i64 {
  1i64;
}

fn designated() i64 {
  secret() + sub.user();
}
