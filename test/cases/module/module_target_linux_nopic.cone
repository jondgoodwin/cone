// '--nopic' makes the code for Linux not position independent, where it is
// otherwise: the address of the string below is an absolute one, '$string',
// not relative to the instruction pointer ('string(%rip)').
// module_target_linux_pic is the same program without the option.

mod module_target_linux_nopic;

extern fn @c puts(s: cstr) i32;

fn main() {
  puts("not position independent");
}
