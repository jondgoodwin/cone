// isNaN, isInfinite and isFinite on SPIR-V's Vulkan form are integer tests on the
// value's bits, in f32 and f64: a Vulkan driver may assume a float operation sees
// no NaN or infinity, and so answer a float comparison for one wrongly. The module
// holds no other float comparison, and none may come back from the optimiser.
// packages/gpuwork/tests/kernels.cone runs the f32 ones on a GPU.

mod module_target_spirv_floatclass;

fn @compute(64) classify(inv: Invocation, xs: &Array[f32], out: &mut Array[u32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < xs.len {
    let x = xs[i];
    var r = 0u32;
    if x.isNaN() { r |= 1u32; }
    if x.isInfinite() { r |= 2u32; }
    if x.isFinite() { r |= 4u32; }
    out[i] = r;
  }
}

// A buffer holds no f64, so one is made of a u32's bits, the high half
fn @compute(64) classify64(inv: Invocation, highs: &Array[u32], out: &mut Array[u32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < highs.len {
    let x = f64.fromBits(u64.from(highs[i]) << 32u64);
    var r = 0u32;
    if x.isNaN() { r |= 1u32; }
    if x.isInfinite() { r |= 2u32; }
    if x.isFinite() { r |= 4u32; }
    out[i] = r;
  }
}
