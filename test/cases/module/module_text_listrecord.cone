// A send to the console is one record even when its list has entries that are
// not plain values ('3 of "ab"'): the whole statement's text is delivered as one
// record when the statement ends. A function a piece calls that prints writes
// its own record first, so its line comes before the whole of the outer record,
// never between the outer record's pieces.

mod module_text_listrecord;

import stdio use *;

fn shout(n: i32) i32 {
  print <- "[inner ", n, "]\n";
  n * 2
}

// A value whose death prints, made by a piece
struct Noisy {
  pub n: i32;
  fn final(self: &uni) { print <- "[final ", n, "]\n"; }
  pub fn toText(self: &, out: &uni TextOut) { out <- "N", self.n; }
}

fn main() {
  print <- "a", 3 of "xy", shout(1), "b\n";
  print <- 2 of "-", "|", 2 of shout(5), "|\n";
  print <- "n=", 2 of Noisy(7), "\n";
}
