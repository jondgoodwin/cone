// 'extends' and a default fold on one line, the 'use' last. area is shapes'
// public name, and so a public name of this module, which the default may name
// as it names volume, declared here.

mod solids extends shapes use area, volume;

pub fn volume(w i64, h i64, d i64) i64 {
  area(w, h) * d;
}
