// A module holding one thing, which is what a bare import of it folds.
//
// helper is public and not in the default, so an importer reaches it through the
// module's name, which a bare import still binds.

mod bigint use BigInt;

pub struct BigInt {
  pub digits i64;

  pub fn doubled(self) i64 {
    digits * 2i64;
  }
}

pub fn helper(n i64) i64 {
  n + 100i64;
}
