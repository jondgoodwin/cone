// A MODULE'S DEFAULT FOLD: the 'use' on a module's own 'mod' line names what a
// BARE import of it folds [Jon 23 Sep]. A package holding one thing becomes the
// thing where it is imported: 'mod bigint use BigInt;' makes 'import bigint;'
// bind BigInt, beside the name bigint it binds as always.
//
// The clause runs the other way from every other 'use': it folds into the
// importer, not into the module it is written in. It is no export list: 'pub'
// still decides what is reachable, and the clause only chooses the fold an import
// writing none of its own gets. An import's own clause replaces it whole.
//
// This is the root, and each subfolder draws a sister:
//   bigint/bigint.cone     one type, the default, and a helper that is not
//   units/units.cone       a default of two names, and a third name left out
//   shapes/shapes.cone     the base solids extends
//   solids/solids.cone     'extends' and a default together, 'use' last
//   calc/calc.cone         bare imports of bigint, units and solids
//   picky/picky.cone       an import of units with a clause of its own
//   relay/relay.cone       'pub import bigint', re-exporting what the default folds
//   gallery/gallery.cone   a wildcard import of relay: BigInt one module further

mod module_mod_default;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // BigInt[7].doubled() + bigint.helper(7): 14 + 107
  show("single-type", calc.big(7i64));
  // metres(2) + feet(2) + units.inches(2): 2000 + 610 + 50
  show("multi-name", calc.lengths(2i64));
  // area(3, 3) + volume(3, 3, 3): 9 + 27
  show("extends-and-use", calc.solid(3i64));
  // inches(4) + units.metres(4): 100 + 4000
  show("own-clause", picky.measure(4i64));
  // BigInt[5].doubled() + bigint.helper(5): 10 + 105
  show("pub-import-transit", gallery.show(5i64));
  0i32;
}
