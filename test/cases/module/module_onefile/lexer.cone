// A one-file module: its first statement is a 'mod' declaration, so it does not
// join the module whose folder holds it. It is that module's submodule, named for
// this file, private to its parent because the declaration does not say 'pub'.

mod lexer;

// Its own imports come right after its 'mod', as a designated file's do. tokens
// is a sister, found in the registry the parent's namespace is
import tokens;

pub fn scan(n i64) i64 {
  tokens.weight(n) + bias();
}

// Private to this module
fn bias() i64 {
  1i64;
}
