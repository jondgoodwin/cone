// A MODULE RE-EXPORTS AN ENUM'S VARIANTS with 'use pub'.
//
// A variant is a name of its enum, so it is 'Colors.Red' wherever the enum can be
// named, and a module that wants it bare writes 'use Colors;'. That binding is
// the module's own and private to it unless the statement says 'use pub', which
// is the visibility every fold clause has: a 'pub' fold is reached by a path from
// outside, and a wildcard import carries it on. It is how core makes Some, None,
// Ok and Error bare in every program, and this is the same thing between two
// modules of one tree, so it links and runs.
//
// The folder holds:
//   palette/palette.cone   declares Colors, folded 'use pub', and Shade, folded privately
//   canvas/canvas.cone     a sister that imports palette with '.*'
//
// Every enum here is passed by reference. That is not this scenario's subject: an
// enum reached by value from a module whose declarations have not been type
// checked yet is refused as still being laid out, with or without a fold.

import stdio.*;

// The enum a 'use' names may be reached by a path: this folds Shade's variants in
// as names of this module, which palette's private fold of them did not give it
use palette.Shade;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // palette's 'use pub' made Green a public name of palette, reached by a path
  imm green = palette.Green[];
  show("pub-fold-reached-by-path", canvas.score(&green));

  // canvas imported palette with '.*', and a wildcard import carries a public
  // fold on: canvas names Red bare with no 'use' of its own
  show("pub-fold-carried-by-a-wildcard", canvas.firstScore());

  // Folded here, through the path
  imm light = Light[];
  imm dark = Dark[];
  show("folded-through-a-path-light", palette.darkness(&light));
  show("folded-through-a-path-dark", palette.darkness(&dark));

  // And with no fold at all: through the module to the enum, and on to the variant
  imm blue = palette.Colors.Blue[];
  show("qualified-through-the-module", canvas.score(&blue));
  0i32;
}
