// A sister of palette that imports it with '.*'. A wildcard import folds every
// public name of palette's namespace, and palette's 'pub use' put Colors'
// variants there, so Red, Green and Blue are bare here with no 'use' of this
// module's own. Shade's variants are not: palette folded them privately.

mod canvas;

import palette.*;

pub fn score(c &Colors) i64 {
  match c {
    case is &Red {1i64;}
    case is &Green {2i64;}
    case is &Blue {3i64;}
  }
}

pub fn firstScore() i64 {
  imm red = Red[];
  score(&red);
}
