// A module importing draw, and units again.

mod gallery;

// A wildcard import of draw. What it receives from shapes is what draw
// re-exported, 'area' and 'edge', and none of what draw folded from units.
import draw.*;

// The same import spelled as a clause. '.*' is 'use *', so this is an identical
// repeat and is ignored.
import draw use *;

// 'pub import' makes every binding the import makes public: units' own name, so
// a path may walk 'gallery.units.inches', and each name the block folds, so
// 'gallery.ft' is reachable too. Beside it, 'pub use' in draw left the module
// name private; that is the difference between the two spellings.
pub import units use {
  metres,
  feet as ft,
};

// 'pub use' beside 'pub import' adds nothing: the folds are public either way.
// So both spellings together say what 'pub import' says alone, and this is an
// identical repeat of the import above.
pub import units pub use feet as ft, metres;

pub fn show(w i64, h i64) i64 {
  area(w, h) * 100i64 + edge(w, h) + metres(0i64) + ft(0i64);
}
