// A module importing two sisters, each with a 'use' clause.

mod draw;

// Two names of shapes, one renamed, and 'pub use': the FOLDS are public names of
// draw, so a module importing draw with '.*' receives 'area' and 'edge', and a
// path may reach 'draw.area'. The module's own name is not a fold, so 'shapes'
// stays private to draw. diagonal2 is not listed, so it is not a name here, and
// is reached through the module.
import shapes pub use area, perimeter as edge;

// The same import with its list in another order. It says the same thing, so it
// is an identical repeat and ignored: the names are bound once.
import shapes pub use perimeter as edge, area;

// Every public name of units but one, privately: metres and feet are names of
// draw that nothing outside it sees.
import units use * but inches;

pub fn sketch(w i64, h i64) i64 {
  area(w, h) + edge(w, h) + metres(1i64) + feet(1i64);
}

pub fn frame(w i64, h i64) i64 {
  edge(w, h) + shapes.diagonal2(w, h);
}
