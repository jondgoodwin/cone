// What naming an instance of a generic module refuses at type check, where the
// instance is made: arguments that are not types, the wrong number of them, a
// member the instance does not have, a private one named from outside it, and
// an argument of the wrong type for the instance's own function. Each wears the
// code the same mistake wears for a generic type or a module.
//
// Type check stage. stack.cone beside this file is the generic module.

mod module_generic_typecheck;

fn main() i32 {
  stack[5i64].push(1i64);         //~ ErrorNotType:9
  stack[i64, f64].push(1i64);     //~ ErrorArgCount:8
  stack[i64].nope();              //~ ErrorUnkName:14
  stack[i64].secret();            //~ ErrorNotPublic:14
  imm c = stack[i64].hidden;      //~ ErrorNotPublic:22
  stack[i64].push(2.5d);          //~ ErrorInvType:19
  0i32;
}
