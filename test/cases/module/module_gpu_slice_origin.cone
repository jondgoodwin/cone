// In a kernel an element of a slice is an access chain into the buffer or
// the fixed array the slice came from: a GPU has no pointer arithmetic. A
// slice made from a pointer to something else, here a local f32, has neither
// to index, and is refused where it is indexed.

mod module_gpu_slice_origin;

fn first(s &[]f32, i usize) f32 {
  s[i];  //~ ErrorGpuSliceOrigin
}

fn @compute(64) scalar(inv Invocation, out &[]mut f32) {
  mut x = 3.f32;
  imm s = mem.sliceFromParts[f32](&mut x as *f32, 1usize);
  if inv.globalId[0] == 0u32 {
    out[0usize] = first(s, usize.from(inv.localIndex));
  }
}
