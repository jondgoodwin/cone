// The debug form of what the library holds: Option and Result (enums of core's), a fixed
// array and a slice, a List and a Dict (written by hand in collections), and text with
// quotes, a backslash, line ends, a control character and multibyte letters.

mod module_debug_more;

import stdio use *;
import collections use *;

struct Pair {
  a: Option[i32];
  b: Result[i32, String];
  grid: Array[i32, 3];
  names: List[String];
}

fn main() {
  let some: Option[i32] = Some[i32](5);
  let none: Option[i32] = None;
  print <- toDebug(&some), " ", toDebug(&none), "\n";
  let ok: Result[i32, String] = Ok[i32, String](7);
  let bad: Result[i32, String] = Err[i32, String](String() <- "no");
  print <- toDebug(&ok), " ", toDebug(&bad), "\n";
  let arr = Array[i32, 3]() <- 1, 2, 3;
  print <- toDebug(&arr), "\n";
  let xs = List[i64]() <- 4, 5, 6;
  print <- toDebug(&xs), "\n";
  var d = Dict[String, i64]();
  d.insert(String() <- "k", 9);
  print <- toDebug(&d), "\n";
  var names = List[String]();
  names.push(String() <- "x");
  names.push(String() <- "y");
  let grid = Array[i32, 3]() <- 7, 8, 9;
  let p = Pair(Some[i32](1), Ok[i32, String](2), grid, names);
  print <- toDebug(&p), "\n";
  let s = "tab\there \\ \"q\" \x01 café 世";
  print <- toDebug(&s), "\n";
  let q = '\'';
  let e = 'é';
  print <- toDebug(&q), toDebug(&e), "\n";
}
