// scale meets a requirement and offset overrides a default, and each is an i32
// where Runner's is an i64.

mod wrongtype is Runner;       //~ ErrorModTraitMismatch:18 "global scale, but not of the type"
                               //~^ ErrorModTraitMismatch:18 "global offset, but not of the type"

pub fn step(n i64) i64 {
  n;
}

pub mut scale = 2i32;

pub mut offset = 7i32;
