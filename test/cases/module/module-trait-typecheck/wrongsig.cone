// step takes an i32 where Runner's takes an i64. The match is exact, as a struct
// trait's method requirement is: no coercion stands in for the signature.

mod wrongsig is Runner;        //~ ErrorModTraitMismatch:17 "declares step, but not with the signature"

pub fn step(n i32) i64 {
  1i64;
}

pub mut scale = 2i64;
