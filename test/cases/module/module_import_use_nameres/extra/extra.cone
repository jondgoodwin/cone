// A second source, which relay folds privately. It shares one name with lib,
// which is what a module folding both has to settle; and a private name, which a
// 'but' has nothing to leave out of.

mod extra;

pub fn more() i64 {
  4i64;
}

pub fn two() i64 {
  5i64;
}

fn secret() i64 {
  6i64;
}

// A finalizer and a clone: a module's own lifecycle, which a star clause passes
// over, so a 'but' naming either has nothing to leave out.
pub fn final() {
}

pub fn clone() i64 {
  7i64;
}
