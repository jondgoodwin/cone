// 'extern' syntax the parser cannot accept.
//
// Parse stage only: parse errors skip semantic analysis, so nothing here may
// expect a later stage.

// An extern declaration is a signature: the implementation is the linker's
extern fn hasBody(n i32) i32 { n; }   //~ ErrorBadImpl:8 "implementation is not allowed here"

// Last, because recovery from a bad statement inside an extern block skips
// forward far enough to swallow the declaration after the block
extern {
  fn declared(n i32) i32;
  // An extern block holds signatures, not type definitions
  struct NotADeclaration { x i32; }   //~ ErrorNoSemi:3 "Extern expects only functions and variables"
}
