// A log send in an inline function is refused: its call-site kind is a static, and an inline
// function's body is copied into each caller, so there would be one kind per caller, not one
// for the call site written.

mod module_text_site_inline;

struct Site {
  pub var seen: u32;
}

struct Rec {
  pub var n: i32;
  pub fn text(self: &mut, s: &str) { }
  pub fn finish(self: &mut) { }
}

struct Log {
  pub var level: i32;
  pub fn open(self: &, site: &mut Site, spec: &str, file: &str, line: u32) Rec {
    Rec(0)
  }
}

fn logIt(log: &Log) inline {
  log <- "inline";      //~ ErrorBadStatic:7 "one kind per caller"
}

fn main() i32 {
  let log = Log(1);
  logIt(&log);
  0
}
