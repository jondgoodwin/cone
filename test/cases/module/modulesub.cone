// Imported by module-imports.cone, module-qualified.cone and
// module-nameres.cone. It is never compiled on its own, so it is listed in
// cases.toml as a support module.
//
// Its public overload name 'scale' has both a public and a private candidate,
// so an importing module can select a private concrete declaration without ever
// naming that private spelling itself. That is the shape that used to crash
// LLVM generation; see module-imports.cone.
//
// Its name carries no '-' because a module name has to be spellable as an
// identifier for module-qualified.cone to qualify with it.

fn scaleInt overload scale(n i64) i64 {
  n * 2i64
}

fn _scaleFloat overload scale(n f64) f64 {
  n * 2.0d
}

// A private overload name, whose candidate is reachable through nothing public
fn _hiddenOne overload _hidden(n i64) i64 {
  n - 1i64
}

fn plain(n i64) i64 {
  n + 1i64
}
