// Imported by module-imports.cone, module-qualified.cone and
// module-nameres.cone. It is never compiled on its own, so it is listed in
// cases.toml as a support module.
//
// Its public overload name 'scale' has two public candidates, which is the only
// shape a public overload name may have: a private candidate may not join it
// (core-parse-overload-private). Its private function and private overload name
// are what an importer may not reach, by qualifying or by folding.
//
// Its name carries no '-' because a module name has to be spellable as an
// identifier for module-qualified.cone to qualify with it.

fn scaleInt overload scale(n i64) i64 {
  n * 2i64;
}

fn scaleFloat overload scale(n f64) f64 {
  n * 2.0d;
}

// A private function, which module-nameres qualifies and is refused
fn _scaleFloat(n f64) f64 {
  n * 4.0d;
}

// A private overload name, whose candidate is reachable through nothing public
fn _hiddenOne overload _hidden(n i64) i64 {
  n - 1i64;
}

fn plain(n i64) i64 {
  n + 1i64;
}
