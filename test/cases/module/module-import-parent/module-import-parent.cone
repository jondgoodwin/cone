// IMPORT OF A PARENT'S NAME: 'import' takes any name the registry holds, not
// only a module [Jon 23 Sep]. Inside a submodule, 'import Point;' binds this
// module's public Point -- a type, a function, a global, any public declaration
// -- exactly as 'import log;' binds a sister.
//
// This is the designated file of the scenario's folder, so it is the root
// module, and it is the parent both submodules below read. What it shares
// downward is what it marks 'pub', the same bit that shares a name outward.
//
// The folder holds:
//   scaling/scaling.cone        imports the struct, the function and the global
//                               below, and re-exports the struct
//   solids/solids.cone          imports the struct as well, and meets it a second
//                               time through a wildcard import of scaling
//   solids/inner/inner.cone     two levels down: imports from solids what solids
//                               re-exports, a module and a type

import stdio use *;

pub struct Point {
  pub x i64;
  pub y i64;
}

pub fn area(p Point) i64 {
  p.x * p.y;
}

pub mut count i64 = 5i64;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // scaling builds a Point [3, 4] and hands it to area: 12, doubled
  show("type-and-function", scaling.scaledArea(3i64));

  // scaledArea wrote count through its binding, and the binding is this
  // module's global itself, not a copy: 5 becomes 6 here
  show("global-written", count);

  // A Point [2, 3] in solids, times 4, plus scaling's twice(4): 24 + 8
  show("wildcard-and-written", solids.volume(4i64));

  // inner's Point [2, 5], and scaling's twice of its y, plus 2: 10 + 2
  show("two-levels-down", solids.inner.deep(2i64));
  0i32;
}
