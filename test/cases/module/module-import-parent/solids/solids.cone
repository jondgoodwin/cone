// A submodule that reaches the parent's Point by two routes.
//
// The wildcard import of its sister scaling brings Point, because scaling
// re-exported it, and the import below writes Point as well. Both stand for the
// parent's one declaration, and only one of the two was written, so they are
// one binding rather than a duplicate: a name the module writes twice is an
// error, and a name a wildcard also brings is not [Jon 23 Sep].
//
// 'pub import' makes scaling's name and everything the wildcard folds public
// names of this module, which is what inner, below, imports.

mod solids;

pub import scaling use *;
import Point;

pub fn volume(d i64) i64 {
  imm p = Point[2i64, 3i64];
  p.x * p.y * d + twice(d);
}
