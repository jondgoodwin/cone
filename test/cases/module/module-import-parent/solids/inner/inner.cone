// Two levels down. The registry is solids' namespace, not the root's: the
// scoped rule holds, and what inner reaches of the level above solids is what
// solids re-exported.
//
// Both names below are names solids BINDS rather than declares, and both are
// answered once solids' imports are bound. scaling is a module, so the import
// folds from it with its 'use' clause as any module import does; Point is the
// root's struct, which reached solids through scaling's re-export.
//
// 'pub mod' so that the root, a grandparent, may name it.

pub mod inner;

import scaling use twice;
import Point;

pub fn deep(n i64) i64 {
  imm p = Point[n, 5i64];
  twice(p.y) + n;
}
