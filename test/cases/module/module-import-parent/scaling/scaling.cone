// A submodule that imports three public names of its parent: a type, a
// function and a global. Its registry is the parent's namespace, and it holds
// what the parent declares as well as the parent's other children; a name there
// that is not a module is bound here as an alias rather than loaded.
//
// Nothing arrives unasked: without these imports none of the three names is in
// reach here, since a bare name does not climb to the parent.

mod scaling;

// Re-exported. 'pub' on the import makes the binding a public name of this
// module, as it does for a sister, so solids' wildcard import of this module
// carries Point on
pub import Point;
import area;
import count;

pub fn scaledArea(n i64) i64 {
  imm p = Point[n, n + 1i64];
  // The parent's global, read and written through the binding
  count = count + 1i64;
  area(p) * 2i64;
}

pub fn twice(n i64) i64 {
  n * 2i64;
}
