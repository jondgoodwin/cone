// A wildcard import folding another module's names into this one, and what
// LLVM generation emits for each of them.
//
// An imported overload name folds with its candidates, and every candidate of
// a public name is public: a private one may not join it, which
// core-parse-overload-private refuses. That is what lets the importer declare
// exactly the candidates it may see and nothing it may not; a private
// candidate selected through a public name once reached generation as a
// declaration the privacy filter had skipped, and crashed it. So this file's
// assertion is that the fold compiles and which symbols it leaves behind,
// which is why it needs no diagnostics and no output to be worth having.
//
// It compiles rather than runs because the imported module's bodies are never
// generated here, so there is nothing to link the calls against. The symbol
// checks in cases.toml carry what running it would otherwise have shown.
//
// The imported module is modulesub.cone.

import modulesub::*;

fn imports() i64 {
  // Selects one candidate through the overload name ...
  imm doubled = scale(21i64);
  // ... and the other, by argument type
  imm halved = scale(1.5d);
  // A pub concrete name stays directly callable across the import
  imm bumped = plain(7i64);
  // A leading underscore is a character like any other: 'pub' is what makes
  // the name reachable, and the spelling says nothing about it
  imm underscored = _leading(1i64);
  doubled + bumped + underscored + i64[halved];
}
