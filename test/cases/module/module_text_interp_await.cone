// An interpolated string sent to the console with an 'await' in its braces is the
// send list with the await among its pieces (concurrency_actor_print_await): the
// awaited pieces are made first, in the order written, and the statement is one
// record, whole. The counter starts at 40 and is sent 2: 'total 42 and 42, twice 84'.

mod module_text_interp_await;

import stdio use *;
import actors;

actor Counter {
  total: u64;

  fn init(self: &new, start: u64) {
    *self = Self(total: start);
  }

  pub async fn add(self, x: u64) {
    total = total + x;
  }

  pub async fn get(self) u64 {
    total
  }
}

actor Reporter {
  pub async fn report(self, c: Counter) {
    print <- $"total {await c.get()} and {await c.get()}, twice {2u64 * await c.get()}\n";
  }
}

fn main() {
  initAll();
  {
    let c = Counter(40u64);
    c.add(2u64);
    let reporter = Reporter();
    reporter.report(c);
  }
  finalAll();
}
