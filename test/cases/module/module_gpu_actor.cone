// An actor declared in GPU code is refused where it is declared
// (ErrorGpuUnavailable): an actor is mailboxes that worker threads run, and a
// GPU has none. It was once refused only for a missing 'import actors', and
// with the import went on to compile the actors package for the GPU and fail
// inside it. The refusal is made at the declaration, whether or not the module
// imports the package, so the module needs no import to be refused. The
// parallel each and await of GPU code are module_gpu_threads.

mod module_gpu_actor;

actor Counter {                                                 //~ ErrorGpuUnavailable
  total u64;

  fn init(self &new) {
    *self = new Self(total: 0u64);
  }

  pub async do bump(self) {
    total = total + 1u64;
  }
}

// Not refused
fn @compute(64) fine(inv Invocation, xs &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len {
    out[i] = xs[i];
  }
}
