// An import without '::*', which binds the module's own name and folds nothing,
// so its members are reached by qualifying them.
//
// Split from module-imports.cone because the two import forms produce different
// namespaces: what is directly callable here is a name a wildcard import would
// have folded, and the failure they would share -- an unqualified use of an
// unfolded name -- is name resolution's, in module-nameres.cone.
//
// It compiles rather than runs for the same reason module-imports.cone does:
// the imported module's bodies are not generated here, so there is nothing to
// link against. The symbol checks in cases.toml record the namespaced spellings
// the calls resolve to, which is what separate compilation will have to
// reconcile.
//
// The imported module is modulesub.cone.

import modulesub

fn qualified() i64 {
  // A public concrete name, reached through the module that declares it
  imm bumped = modulesub::plain(7i64)
  // An overload name qualifies the same way: the qualifier resolves the name to
  // the overload set, and selection among its candidates happens after that
  imm doubled = modulesub::scale(3i64)
  // and every candidate keeps its own qualified name
  imm alsoDoubled = modulesub::scaleInt(4i64)
  bumped + doubled + alsoDoubled
}
