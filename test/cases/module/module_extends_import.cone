// A module extending a module it IMPORTS, rather than a sister.
//
// The import is what puts moduleextbase in reach -- it binds the module's name
// here -- and 'extends' then names it. Order within the file does not matter:
// what 'extends' names is resolved once every import is bound.
//
// Compiled, not run: a program spanning an import cannot be linked yet, because
// an imported module's bodies are declared and never generated. What running
// would show -- that a name reached through this module calls the base's own
// declaration -- is asserted on the symbols instead.

mod module_extends_import extends moduleextbase;

import moduleextbase;

fn quad(n i64) i64 {
  twice(twice(n)) + total;
}
