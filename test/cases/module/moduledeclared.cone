// Imported by module_declared.cone, and never compiled on its own, so it is
// listed in cases.toml as a support module.
//
// Its 'mod' declaration names it 'renamed', which its filename does not. That
// declared name is the module's identity: it is what the importing module binds,
// what a path through the module is written with, and what its symbols are
// spelled after. The filename is only where the module was found.

mod renamed;

pub fn scaleBy(n i64) i64 {
  n * 4i64;
}

pub imm factor i64 = 5i64;

// A module's own name is in reach inside it, so a declaration of its own that a
// local hides is still reachable -- the same thing the header buys a root file.
pub fn timesFactor() i64 {
  imm factor = 2i64;
  factor * renamed.factor;
}
