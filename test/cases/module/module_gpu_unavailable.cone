// What a GPU has none of, refused where it is written in GPU code (ErrorGpuUnavailable):
// a reference to a function, a pointer to code, since every call is inlined into
// the kernel; a virtual reference made from a reference, which dispatches through
// a table of code pointers; and an allocation, 'new So[T]', 'new Rc[T]', since a
// kernel's memory is its locals and the buffers it is bound. Each was once a
// module the validator refused or a crash in LLVM's SPIR-V backend. A function
// called by name, a generic bound by a signature or a trait, and a struct built
// as a value ('new Ball(2.)') are fine and stand beside them.

mod module_gpu_unavailable;

fn double(x f32) f32 { x * 2.; }
fn viaRef(f &fn(x f32) f32, x f32) f32 { f(x); }
fn viaFn[F fn(x f32) f32](f &F, x f32) f32 { f(x); }

pub trait Shape {
  pub fn dist(self &, x f32) f32;
}
struct Ball {
  pub r f32;
  pub fn dist(self &, x f32) f32 { x - r; }
}
fn viaVref(s &<Shape, x f32) f32 { s.dist(x); }
fn viaStatic[S Shape](s &S, x f32) f32 { s.dist(x); }

fn @compute(64) fnRef(inv Invocation, xs &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len {
    out[i] = viaRef(&double, xs[i]);                              //~ ErrorGpuUnavailable
    out[i] = out[i] + viaRef(&fn(x f32) f32 { x * 3.; }, xs[i]);  //~ ErrorGpuUnavailable
  }
}

fn @compute(64) vref(inv Invocation, xs &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len {
    imm ball = new Ball(2.);
    out[i] = viaVref(&ball, xs[i]);                               //~ ErrorGpuUnavailable
  }
}

fn @compute(64) owners(inv Invocation, xs &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len {
    imm one = new So[f32](xs[i]);                                 //~ ErrorGpuUnavailable
    imm two = new Rc[f32](xs[i]);                                 //~ ErrorGpuUnavailable
    out[i] = *one + *two;
  }
}

// Not refused
fn @compute(64) fine(inv Invocation, xs &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len {
    imm ball = new Ball(2.);
    out[i] = double(xs[i]) + viaFn(x => x * 4., xs[i]) + viaStatic(&ball, xs[i]);
  }
}
