// A child of the root, whose folds the root's 'use child;' runs from inside its
// own. The parent's names are the parent's: a child reaches them only by
// importing them, and it imports nothing here.

mod child;

// An enum's 'use' names the enum as this module's namespace has it
use Dir;                        //~ ErrorUnkName:5 "Dir does not refer to a declared name"

// So does a global's fold, its type and its value both
mut g Panel = Panel[1i64] use width;   //~ ErrorUnkName:7 "Panel does not refer to a declared name"
                                       //~^ ErrorUnkName:15 "Panel does not refer to a declared name"

pub fn pick() i64 {
  3i64;
}
