// A sister of beta that imports her, so beta's folds run from inside alpha's,
// and a type of alpha's that mixes in beta's trait resolves that trait by demand
// from inside alpha's resolution. What alpha declares stays alpha's.

mod alpha;

import beta;

pub enum Heading {
  Up, Down;
}

pub struct Gauge {
  pub level i64;
}

pub struct Dial {
  mixin beta.Knob;
}
