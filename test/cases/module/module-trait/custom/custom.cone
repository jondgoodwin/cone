// Conforms to Runner and overrides two defaults, a global and a function, by
// declaring its own. The copy of 'run' it still takes reads its 'offset', not the
// trait's; the copies of 'calls' and 'tick' are its own storage and code.

mod custom is Runner;

import hosts use Runner;

pub fn step(n i64) i64 {
  n * 10i64;
}

pub mut scale = 3i64;

pub mut offset = 7i64;

pub fn label() i64 {
  2i64;
}
