// The module trait every conforming module in this scenario names, declared in a
// sister module and reached by importing it and folding the trait in.
//
// Two requirements, a function and a global, which each conforming module must
// declare; and five defaults, which a conforming module takes unless it declares
// its own: two globals with initialisers, and three functions with bodies. One
// default names two requirements and a default global, so its copy reads what
// the conforming module has under those names; one names a private helper of
// this module, which its copy keeps reaching; and one writes a default global,
// so each module that took it has storage of its own.

mod hosts;

pub mod trait Runner {
  pub fn step(n i64) i64;
  pub mut scale i64;

  pub mut offset = 100i64;
  pub mut calls = 0i64;

  pub fn run(n i64) i64 {
    step(n) * scale + offset;
  }

  pub fn label() i64 {
    unit();
  }

  pub fn tick() i64 {
    calls = calls + 1i64;
    calls;
  }
}

fn unit() i64 {
  1i64;
}
