// A module's name and a module trait's name, each written where a type must be.
// Neither is a type, and each is refused where it is written, once.
//
// Type check stage.

import stdio;

mod trait Runner {
  pub fn step(n i64) i64;
}

struct Holder {
  m stdio;                     //~ ErrorNotType:5 "stdio is a module, not a type"
}

fn byModule(r stdio) i32 {     //~ ErrorNotType:15 "stdio is a module, not a type"
  0i32;
}

fn byTrait(r Runner) i32 {     //~ ErrorNotType:14 "Runner is a module trait, not a type"
  0i32;
}

fn byRef(r &stdio) i32 {       //~ ErrorNotType:13 "stdio is a module, not a type"
  0i32;
}

fn returns() Runner {}         //~ ErrorNotType:14 "Runner is a module trait, not a type"

fn pick[T](a T) T {
  a;
}

fn main() i32 {
  mut held stdio;              //~ ErrorNotType:12 "stdio is a module, not a type"
  imm x = 3i32;
  imm y = x as Runner;         //~ ErrorNotType:16 "Runner is a module trait, not a type"
  imm z = pick[stdio](1i32);   //~ ErrorNotType:16 "stdio is a module, not a type"
  0i32;
}
