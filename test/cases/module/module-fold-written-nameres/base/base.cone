// A listed name that is this module's own declaration, handed back by rich,
// which extends it. Written here twice: once declared, once listed. With 'use *'
// it is the binding the name has already (module-extends-back).
//
// base is folded before rich. In the other order the clause reads rich round the
// cycle the two make, before rich's 'extends' has run, and that is ErrorCircular.

mod base;

import rich use one;              //~ ErrorDupName:17 "one is already a name of this module, for the same thing"

pub fn one() i64 {
  1i64;
}
