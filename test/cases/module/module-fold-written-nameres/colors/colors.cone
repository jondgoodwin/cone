// Two identical 'use' statements of one enum. 'use Colors;' names the enum, so
// what it binds is written, even though it lists no variant: each variant is
// written twice, and each is refused at the second statement.

mod colors;

enum Colors {
  Red, Green;
}

use Colors;
use Colors;                       //~ ErrorDupName:1 "Red is already a name of this module, for the same thing"
                                  //~^ ErrorDupName:1 "Green is already a name of this module, for the same thing"

pub fn red() i64 {
  imm c Colors = Red[];
  0i64;
}
