// A global's clause listing one member twice: the same member through the same
// global, written twice.

mod panel;

struct Panel {
  w i64;
  h i64;

  pub fn area(self) i64 {
    w * h;
  }
}

mut only Panel = Panel[1i64, 2i64] use area, area;
                                  //~^ ErrorDupName:46 "area is already a name of this module, for the same thing"

pub fn p() i64 {
  area();
}
