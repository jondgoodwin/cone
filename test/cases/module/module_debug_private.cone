// A generated debug form is part of its type: it shows the type's private fields, and a
// field that is another module's type is written by that type's own form, which shows its
// private fields, so the outer form reads none of them. Core's Atomic holds a private field.

mod module_debug_private;

import stdio use *;

struct Counter {
  hits: Atomic[u32];
  label: i32;
}

fn main() {
  let c = Counter(Atomic[u32].of(7u32), 3);
  print <- toDebug(&c), "\n";
}
