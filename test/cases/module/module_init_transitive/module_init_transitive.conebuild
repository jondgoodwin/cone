// A program whose stitched init and final reach a package it does not import.
// Packages b, a and c are compiled on their own first (listed under 'link' in
// cases.toml), each generating its include file; a's and c's import b's, which
// the package line for b answers. So b, and b's submodule, are modules of the
// program's compile, in its module order like any other, and the program's
// stitched pair calls their 'init' and 'final'. All four objects are linked.

build: debug
output: executable

import stdio: "stdio.cone"
import b: "include/b.cone"
import a: "include/a.cone"
import c: "include/c.cone"

prog: {
    "main.cone"
    import stdio: "stdio.cone"
    import a: "include/a.cone"
    import c: "include/c.cone"
}
