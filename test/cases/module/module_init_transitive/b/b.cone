// Package b, at the bottom of a diamond: the program imports a and c, and each
// of them imports b. The program never imports b, so b's 'init' and 'final' are
// reached only through a's and c's include files, which import b's. Its 'init'
// reads its submodule's global, so the submodule's 'init' must run first.

mod b;

import stdio use *;

pub imm value i64;

fn @initpure init() {
  value = sub.base + 7i64;
  printStr("b init, value = ");
  printInt(value);
  printStr("\n");
}

fn final() {
  printStr("b final\n");
}

pub fn get() i64 {
  value;
}
