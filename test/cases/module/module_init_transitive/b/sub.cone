// b's submodule: b contains it, so it depends on nothing b has, and b depends
// on it. Its 'init' runs before b's, and its 'final' after b's.

pub mod sub;

import stdio use *;

pub imm base i64;

fn @initpure init() {
  base = 100i64;
  printStr("b.sub init\n");
}

fn final() {
  printStr("b.sub final\n");
}
