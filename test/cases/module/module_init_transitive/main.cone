// The program imports a and c, never b. Its stitched init runs b's submodule's
// 'init', then b's, once, though two include files import b, then a's and c's,
// then its own; its stitched final runs every finalizer in exactly the reverse.

mod prog;

import stdio use *;
import a;
import c;

fn @initpure init() {
  printStr("prog init\n");
}

fn final() {
  printStr("prog final\n");
}

fn main() i32 {
  initAll();
  printStr("a.readB() = ");
  printInt(a.readB());
  printStr("\nc.twiceB() = ");
  printInt(c.twiceB());
  printStr("\n");
  finalAll();
  0i32;
}
