// Package a, which imports b. Its 'init' reads b's global, so b's 'init' must
// have run before it.

mod a;

import stdio use *;
import b;

fn @initpure init() {
  printStr("a init, b.get() = ");
  printInt(b.get());
  printStr("\n");
}

fn final() {
  printStr("a final\n");
}

pub fn readB() i64 {
  b.value;
}
