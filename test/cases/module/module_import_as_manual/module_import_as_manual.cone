// The reference manual's examples of 'import x as y', run: refinclude.html,
// "Importing under another name" (near, folded), and refmethod.html, "Implicit
// field and method access" (scenery, staging), the two ways round a method
// that hides a module in its own signature. Each example is its sister's text
// as the manual prints it; what follows it in the file is only what calls it.
// The refused example is module_import_as_manual_refused.

mod module_import_as_manual;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // dist2((0,0),(3,4)) = 25
  show("far", near.far(new geometry.Point(0i64, 0i64), new geometry.Point(3i64, 4i64)));
  // d2((1,1),(2,3)) = 1 + 4
  show("folded", folded.close());
  // geo.metric.cm(4) = 40
  show("nested", near.inCm(4i64));
  show("renamed-import", scenery.count(6i64));
  show("own-name", staging.count(7i64));
  0i32;
}
