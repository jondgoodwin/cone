// moduletransit.cone with the 're-export' left off: it folds modulesub's public
// names into itself and keeps them. Imported by module-nameres-transit.cone and
// by modulehidelate.cone, and never compiled on its own, so it is listed in
// cases.toml as a support module.
//
// A fold is private to the module that made it unless the import says 'pub',
// whatever the folded name's visibility where it was declared -- 'plain' and the
// overload name 'scale' are public in modulesub either way. So the pair of files
// differs in one keyword, and that keyword is the whole of what decides whether
// a third module can see through this one.
//
// Its name carries no '-' because a module's name is also its qualifier.

import modulesub.*;

// A name of this module's own, which a qualifier reaches whatever the folds do
pub fn hidOwn(n i64) i64 {
  plain(n) * 10i64;
}
