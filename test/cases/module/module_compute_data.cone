// What a kernel's buffer holds is shared with the CPU byte for byte, so it is
// what Cone and WebGPU lay out alike: 32-bit numbers, their atomics
// (Atomic[u32] and Atomic[i32], each its number), and structs and fixed
// arrays of them. Anything else, however deep in the struct, is refused with
// the field that holds it: an Atomic of a 64-bit number or a bool among them.

mod module_compute_data;

struct Flags {
  on bool;
}

struct Small {
  b u8;
}

struct Wide {
  w u64;
}

struct Rows {
  r Array[Array[i16, 2], 2];
}

struct Addressed {
  p *u32;
}

struct Optional {
  o Option[u32];
}

enum Kind {
  struct Red {}
  struct Blue {}
}

struct Good {
  v Array[f32, 3];
  n u32;
  i i32;
  inner Array[Flagless, 2];
}

struct Flagless {
  a f32;
  b Array[u32, 4];
}

fn @compute(1) bools(a &Array[bool]) {}  //~ ErrorComputeData
fn @compute(1) flags(a &Array[Flags]) {}  //~ ErrorComputeData
fn @compute(1) bytes(a &Array[Small]) {}  //~ ErrorComputeData
fn @compute(1) wide(w Wide) {}  //~ ErrorComputeData
fn @compute(1) doubles(a &mut Array[f64]) {}  //~ ErrorComputeData
fn @compute(1) rows(a &Array[Rows]) {}  //~ ErrorComputeData
fn @compute(1) pointers(a &Array[Addressed]) {}  //~ ErrorComputeData
fn @compute(1) options(a &Array[Optional]) {}  //~ ErrorComputeData
fn @compute(1) kinds(a &Array[Kind]) {}  //~ ErrorComputeData
fn @compute(1) sizes(a &Array[usize]) {}  //~ ErrorComputeData
fn @compute(1) wideCounts(a &mut Array[Atomic[u64]]) {}  //~ ErrorComputeData
fn @compute(1) flagCounts(a &mut Array[Atomic[bool]]) {}  //~ ErrorComputeData

// 32-bit numbers, and structs and fixed arrays of them, nested
fn @compute(1) good(a &Array[Good], g Good, out &mut Array[u32]) {}

// Their atomics, alone and in a struct
struct Tally {
  pub hits Atomic[u32];
  pub low Array[Atomic[i32], 2];
  pub sum f32;
}
fn @compute(1) counts(a &mut Array[Atomic[u32]], b &mut Array[Atomic[i32]], t &mut Array[Tally]) {}
