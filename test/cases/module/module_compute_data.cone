// What a kernel's buffer holds is shared with the CPU byte for byte, so it is
// what Cone and WebGPU lay out alike: 32-bit numbers, and structs and fixed
// arrays of them. Anything else, however deep in the struct, is refused with
// the field that holds it.

mod module_compute_data;

struct Flags {
  on Bool;
}

struct Small {
  b u8;
}

struct Wide {
  w u64;
}

struct Rows {
  r Array[Array[i16, 2], 2];
}

struct Addressed {
  p *u32;
}

struct Optional {
  o Option[u32];
}

enum Kind {
  struct Red {}
  struct Blue {}
}

struct Good {
  v Array[f32, 3];
  n u32;
  i i32;
  inner Array[Flagless, 2];
}

struct Flagless {
  a f32;
  b Array[u32, 4];
}

fn @compute(1) bools(a &[]Bool) {}  //~ ErrorComputeData
fn @compute(1) flags(a &[]Flags) {}  //~ ErrorComputeData
fn @compute(1) bytes(a &[]Small) {}  //~ ErrorComputeData
fn @compute(1) wide(w Wide) {}  //~ ErrorComputeData
fn @compute(1) doubles(a &[]mut f64) {}  //~ ErrorComputeData
fn @compute(1) rows(a &[]Rows) {}  //~ ErrorComputeData
fn @compute(1) pointers(a &[]Addressed) {}  //~ ErrorComputeData
fn @compute(1) options(a &[]Optional) {}  //~ ErrorComputeData
fn @compute(1) kinds(a &[]Kind) {}  //~ ErrorComputeData
fn @compute(1) sizes(a &[]usize) {}  //~ ErrorComputeData

// 32-bit numbers, and structs and fixed arrays of them, nested
fn @compute(1) good(a &[]Good, g Good, out &[]mut u32) {}
