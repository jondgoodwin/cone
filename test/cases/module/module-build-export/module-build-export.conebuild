// A package compiled on its own as a library: which of its definitions it
// exports to the objects that import it, and which it keeps to itself. Built
// 'debug', so the optimiser deletes nothing and each internal definition is
// still there to be seen as internal.

build: debug
output: library

ex: {
    "src/ex.cone"
    inner: {
        "src/inner/inner.cone"
    }
}
