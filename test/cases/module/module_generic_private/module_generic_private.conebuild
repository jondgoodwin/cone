// An optimized program of three objects (the program, package q, package g):
// a generic's instance small enough to inline is the program's own copy there,
// while its static counter, its vtables and q's library copy stay shared.

build: release
output: executable

import g: "include/g.cone"
import q: "include/q.cone"

prog: {
    "main.cone"
    import g: "include/g.cone"
    import q: "include/q.cone"
    import stdio: "stdio.cone"
}
