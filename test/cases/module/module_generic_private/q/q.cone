// Package q, a library compiled on its own, optimized: it keeps every generic
// instance it uses shared (a library's importers may link against them). It
// uses g[i64], holds a trait and a generic struct meeting it, and tests which
// struct a trait object is by comparing vtable addresses (the program makes the
// values, so the vtable q compares with and the one the program built must be
// one, whichever object's copy the linker keeps).

mod q;

import g;

pub trait Shape {
  pub fn sides(self: &) i64;
}

pub struct Wrap[T] is Shape {
  pub n: T;
  pub fn sides(self: &) i64 { 4i64 }
}

pub fn addTwice(n: i64) i64 {
  g[i64].add(n);
  g[i64].add(n)
}

pub fn total() i64 {
  g[i64].total
}

pub fn sameAddress() i64 {
  g[i64].sameAddress()
}

pub fn isWrap(s: &<Shape) i64 {
  if s is Wrap[i64] {1i64} else {0i64}
}

pub fn isWrapF(s: &<Shape) i64 {
  if s is Wrap[f64] {1i64} else {0i64}
}

pub fn sides(s: &<Shape) i64 {
  s.sides()
}
