// The program uses g[i64] as q does: the instance's counter must be one object
// in the program, however the instance's functions are kept. It makes the trait
// objects q tests: a Wrap[i64] through the one vtable q compares with.

mod prog;

import stdio use *;
import g;
import q;

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  initAll();
  // One counter: q's additions, then this object's, then q reads the total
  show("q.addTwice", q.addTwice(5i64));
  show("g[i64].add", g[i64].add(1i64));
  show("q.total", q.total());
  show("g[i64].adds", g[i64].adds);
  show("g[i64].inits", g[i64].inits);

  // The large function, kept shared, adds to the same counter
  show("g[i64].heavy", g[i64].heavy(1i64));

  // A function's address asked for twice in one object is one address
  show("program-same-address", g[i64].sameAddress());
  show("q-same-address", q.sameAddress());

  // A trait object made here, told apart and called through in q
  let w = q.Wrap[i64](7i64);
  show("is-wrap-i64", q.isWrap(&w));
  show("is-wrap-f64", q.isWrapF(&w));
  show("sides", q.sides(&w));
  let v = q.Wrap[f64](0.5);
  show("f64-is-wrap-i64", q.isWrap(&v));
  show("f64-is-wrap-f64", q.isWrapF(&v));
  finalAll();
  0i32
}
