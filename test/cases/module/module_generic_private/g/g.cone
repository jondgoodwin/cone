// Package g's source: a generic module as a package's root, with a static counter
// and a function that answers its own address. Each importer compiles every
// instance it uses from the source g's include file carries.

mod g[T];

pub var @threadlocal total: T = 0;
pub var @threadlocal adds: i64 = 0i64;
pub var @threadlocal inits: i64 = 0i64;

// Each instance's own 'init', run once by the program's stitched init
fn @initpure init() {
  inits = inits + 1i64;
}

// Adds x to the instance's total, and answers the total
pub fn add(x: T) T {
  total = total + x;
  adds = adds + 1i64;
  total
}

// A function too large to be the program's own copy: it stays shared
pub fn heavy(x: T) T {
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total = total + x; total = total + x; total = total + x; total = total + x;
  total
}

// Whether two askings of the function's address, in one object, agree
pub fn sameAddress() i64 {
  let a = &add;
  let b = &add;
  if a as usize == b as usize {1i64} else {0i64}
}
