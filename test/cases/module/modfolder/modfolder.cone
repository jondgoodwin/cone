// The designated file of the folder 'modfolder', imported by
// module_folder_import.cone and never compiled on its own, so the folder is
// listed in cases.toml as a support module under its own name.
//
// Its 'mod' declaration restates the name the folder already gave the module.
// That is all a declaration may do with the name: the folder names the module,
// because a name on the filesystem is one a tool that cannot parse Cone can
// read, and a declaration that disagreed with it would be a second answer.

mod modfolder;

pub fn folderAdd(n i64) i64 {
  n + 1i64;
}
