// A generic module compiled across packages. Package g is a generic module,
// compiled on its own (g\g.conebuild); package q imports it and uses g[i64]
// (q\q.conebuild); both are listed under 'link' in cases.toml. This program
// imports both through the include files their compiles generate -- g's
// carrying g's full source -- and uses g[i64] too, and g[f64] alone. The three
// objects are then linked, with conestd, and the program run. q's include file
// imports g, as q's source does, which the package line for g answers.

build: debug
output: executable

import g: "include/g.cone"
import q: "include/q.cone"

prog: {
    "main.cone"
    import g: "include/g.cone"
    import q: "include/q.cone"
    import stdio: "stdio.cone"
}
