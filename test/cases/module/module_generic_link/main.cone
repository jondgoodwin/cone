// The program: g[i64] is defined in this object and in q's, and the linker
// keeps one copy, so q's code and this program's add to one total. g[f64] is
// this object's alone. The program's stitched init runs each instance's 'init'
// once.

mod prog;

import stdio use *;
import g;
import q;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label &[]u8, n f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn main() i32 {
  initAll();
  // q's code adds to g[i64]'s total, then this program's own code does, and
  // q reads back what the program added: one set of globals
  show("q.addTwice", q.addTwice(5i64));
  show("g[i64].add", g[i64].add(1i64));
  show("q.total", q.total());
  show("g[i64].adds", g[i64].adds);
  show("g[i64].inits", g[i64].inits);

  // An instance only this program uses
  showF("g[f64].add", g[f64].add(0.5d));
  showF("g[f64].add", g[f64].add(0.25d));
  show("g[f64].adds", g[f64].adds);
  show("g[f64].inits", g[f64].inits);
  finalAll();
  0i32;
}
