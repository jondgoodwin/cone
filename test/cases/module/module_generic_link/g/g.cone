// Package g's source: a generic module as a package's root. Compiled on its
// own, it makes nothing: nothing is compiled of a generic module until an
// instance is named, and nothing here names one. Each importer compiles every
// instance it uses from the source g's include file carries.

mod g[T];

pub var @threadlocal total T = 0;
pub var @threadlocal adds i64 = 0i64;
pub var @threadlocal inits i64 = 0i64;

// Each instance's own 'init', run once by the program's stitched init
fn @initpure init() {
  inits = inits + 1i64;
}

// Adds x to the instance's total, and answers the total
pub fn add(x T) T {
  total = total + x;
  adds = adds + 1i64;
  total;
}
