// A GENERIC MODULE declaring a generic function, which every instance holds a
// copy of: still generic, with the module's parameter substituted, and
// instantiated at its own arguments within the instance. A global counts each
// instance's calls.
pub mod tags[T];

pub var @threadlocal calls: i64 = 0i64;

// T is the module's, U the function's own
pub fn tag[U](x: T, y: U) U {
  calls = calls + 1i64;
  y
}

// The module's own function instantiating it at the module's T
pub fn same(x: T) T {
  tag[T](x, x)
}
