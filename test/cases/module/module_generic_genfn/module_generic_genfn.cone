// A GENERIC FUNCTION INSIDE A GENERIC MODULE, treated as a generic type's
// generic method is [Jon 23 Sep]: each instance of the module, tags[i64] and
// tags[f64], holds its own copy of tag[U] with T substituted, and the copy's
// instances are made per module instance and per U -- tags[i64].tag[f64] and
// tags[f64].tag[i64] are two functions, each counting into its own module
// instance's global. Its type argument is inferred, or written through the
// instance.
//
// This is the designated file of the scenario's folder; tags.cone beside it is
// the generic module. Each printed value was checked by hand against the source.

mod module_generic_genfn;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label: &str, n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn main() {
  showF("tags[i64].tag", tags[i64].tag(1i64, 2.5));          // 2.5
  show("tags[f64].tag", tags[f64].tag(1.5, 3i64));           // 3
  show("tags[f64].tag[i64]", tags[f64].tag[i64](0.5, 4i64)); // 4
  show("tags[i64].same", tags[i64].same(6i64));              // 6

  // tag twice and same (which calls tag) once for i64; tag twice for f64
  show("tags[i64].calls", tags[i64].calls);                  // 2
  show("tags[f64].calls", tags[f64].calls);                  // 2
}
