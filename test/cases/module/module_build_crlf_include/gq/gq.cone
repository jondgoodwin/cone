// Package gq's source: a generic enum and a generic struct, each with
// non-inline methods, and a function that instances each at i64 inside gq.

mod gq;

pub enum Maybe[T] {
  Nothing;
  Just(T);

  // A method whose receiver names the whole enum
  pub fn orElse(self: &Maybe[T], other: T) T {
    match self {
      case let Just(v) { *v }
      case is Nothing { other }
    }
  }

  pub fn hidden(self: &Maybe[T]) i64 { secret() + 2i64 }

  // A by-value method with a body, copied into each variant
  pub fn tag(self) i64 { 11i64 }

  // Declared in the enum, met by each variant's own copy
  pub fn isJust(self: &Maybe[T]) bool {
    match self {
      case is Just { true }
      case is Nothing { false }
    }
  }
}

// A private function named by a whole-enum method's body, which an importer's instance carries
fn secret() i64 { 40i64 }

pub use Maybe;

pub struct Cell[T] {
  pub v: T;
  pub fn get(self: &) T { v }
}

pub fn gqSum() i64 {
  let j = Just[i64](5i64);
  let m: Maybe[i64] = Just[i64](5i64);
  let c = Cell[i64](7i64);
  m.orElse(0i64) + c.get() + j.tag()
}




