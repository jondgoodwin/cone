// An import's own clause REPLACES the default whole, so 'one', which lib's
// default names, is not a name here: only 'two' is folded. The module's name is
// bound either way.
//
// A bare import of stars takes its '* but' default, whose 'but' stars reports.

mod picky;

import lib use two;
import stars;

pub fn reach() i64 {
  two() + lib.one() + keep() + one();  //~ ErrorUnkName:32 "one"
}
