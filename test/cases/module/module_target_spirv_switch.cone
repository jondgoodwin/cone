// An if-elif chain on one integer on SPIR-V's Vulkan form: the optimizer
// makes it a switch, which the control flow's structurizer does not take, so
// the switch is first made a tree of comparisons, each branch on its own.
// Every arm's comparison survives: none is left a branch on nothing.

mod module_target_spirv_switch;

struct Pick {
  pub which u32;
}

fn apply(which u32, x f32, y f32) f32 {
  if which == 0u32 { x + y; }
  elif which == 1u32 { x * y; }
  elif which == 2u32 { x - y; }
  elif which == 7u32 { y - x; }
  else { 0.; };
}

fn @compute(64) pick(inv Invocation, p Pick, xs &[]f32, ys &[]f32, out &[]mut f32) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len and i < ys.len {
    out[i] = apply(p.which, xs[i], ys[i]);
  }
}
