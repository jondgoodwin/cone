mod module_builtin_name_parse;

// A name the compiler binds before any source is read -- a built-in type, a
// keyword, a permission, a reserved word -- taken for a global name. The
// built-in has no place in any source, so the one diagnostic is the
// declaration's, and names what the name already is. It once came in two
// halves, the second pointing at an empty line in a file called "init", the
// compiler's own starting point; for a keyword, whose node has no position at
// all, the compile crashed.
//
// The modules named after a built-in are u32.cone and mut.cone, one-file
// submodules, and while/ and yield/, submodule folders: a module's name is bound
// where its folder or its file names it, so no name token is ever read that a
// keyword or a permission would refuse. Each module name is refused twice, at
// its 'mod' line: once in the submodule's own namespace, which holds its own
// name, and once in this one's, which holds its submodule's. The reserved word
// is the exception, reported once: once reported, it is released to be a name.
//
// Parse stage: the duplicate is found as the name is bound.

struct i8 {                 //~ ErrorDupName:8 "i8 is already the name of a built-in type"
}
