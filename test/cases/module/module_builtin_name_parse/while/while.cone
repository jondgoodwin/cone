mod while;                  //~ ErrorDupName:1 "while is a keyword"
                            //~^ ErrorDupName:1 "while is a keyword"

// A submodule folder named after a keyword. The folder names the module, so
// the name is bound, and refused, before the 'mod' line is read. The word
// cannot read as a name, and the line once reported that too, three times
// over; restating the module's own name is now taken as naming it.
