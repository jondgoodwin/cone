mod while;                  //~ ErrorDupName:1 "while is a keyword"
                            //~^ ErrorDupName:1 "while is a keyword"
                            //~^^ ErrorNoName:5 follow-on
                            //~^^^ ErrorNoSemi:4 follow-on
                            //~^^^^ ErrorBadGloStmt:5 follow-on

// A submodule folder named after a keyword. The folder names the module, so
// the name is bound before the 'mod' line is read; the line itself cannot
// name it, which is what the follow-ons are.
