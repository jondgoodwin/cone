mod yield;                  //~ ErrorReserved:1 "'yield' is reserved for a language feature that is not implemented yet"

// A submodule folder named after a word held for a feature not built yet. It
// was refused as a keyword where the folder bound it, in this namespace and in
// the parent's, and then the 'mod' line reported the reserved word too. It is
// now reported once, as the lexer reports one it reads, and released as the
// lexer releases one: the rest of the compile takes it as the name meant, so
// neither namespace nor the 'mod' line reports it again.

pub fn f() {
}
