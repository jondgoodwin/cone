mod mut;                    //~ ErrorDupName:1 "mut is already the name of a built-in permission"
                            //~^ ErrorDupName:1 "mut is already the name of a built-in permission"

// A one-file submodule named after a permission. A permission reads as a
// permission, never as a name, so the 'mod' line restating it was reported as
// having no name, then as a statement missing its ';' and a declaration missing
// its variable. It is now taken as naming the module, as while/ shows for a
// keyword.

pub fn f() {
}
