// Module qualifiers and imported names that resolve to nothing.
//
// Name-resolution stage only: this file parses cleanly, and name resolution
// returns before type checking, so a type-check expectation here would never
// run.
//
// Four of these are ErrorUnkName, because a name that is declared nowhere and
// a member a namespace does not hold are the same failure to find a
// declaration. The quoted substrings and the columns are what tell them apart:
// a path is a chain, so the diagnostic lands on the hop that failed rather than
// at the start of the line. The fifth is ErrorNotPublic and is a different
// thing: the declaration is found, and may not be reached.
//
// A base that is neither a module nor a type is not here: it is a member
// access, it fails at type check, and module_typecheck_notnamespace holds it.
//
// The imported modules are modulesub.cone, without folding, and modulesyms.cone
// folded, so that its type is a name of this module and can begin a path.

mod module_nameres;

import modulesub;
import modulesyms use *;

// An import without a 'use' clause folds nothing, so the module's members are
// not names of this module
fn notFolded() i64 {
  plain(7i64);               //~ ErrorUnkName:3 "The name plain does not refer to a declared name"
}

// A path starts with an ordinary name, so a first hop that names nothing is an
// unknown name like any other
fn noSuchModule() i64 {
  nosuch.plain(7i64);       //~ ErrorUnkName:3 "The name nosuch does not refer to a declared name"
}

fn noSuchMember() i64 {
  modulesub.nothere(7i64);  //~ ErrorUnkName:13 "The name nothere does not refer to a declared name"
}

// A type is a namespace too, and a member it does not hold is the same failure
// as a module's missing member
fn noSuchMemberOfType() i32 {
  Gadget.nothere(1);        //~ ErrorUnkName:10 "The name nothere does not refer to a declared name"
}

// refmodule.html: a declaration not written 'pub' is private and may not be
// referenced outside its module. A path reaches past the import, so this is
// the route the fold cannot filter. Code generation emits no symbol for a
// private declaration of a module it is not generating, so the call site used
// to be left holding nothing to call.
fn privateAcrossModules() f64 {
  modulesub.hiddenScaleFloat(1.5d);  //~ ErrorNotPublic:13 "private to its module"
}
