// A module's '@c(system)': the calling convention every function it names takes.
//
// The submodule win (win.cone) is C-named with the system convention. It
// compiles rather than runs because the runner does not link kernel32, where
// GetTickCount is; the symbols and the calls are the subject.

fn poll() u32 {
  win.ticks() + win.GetTickCount();
}
