// A C-named module with the system calling convention: '@c(system)' on the
// 'mod' line gives every function it owns directly a C name, with no prefix,
// and the platform's system convention (stdcall on x86 Windows).
//
// GetTickCount is 'extern', so it is also imported from a DLL. 'ticks' has a
// body, compiled here: it takes the convention and, through its own
// '@c("ConeTicks")', a symbol of its own choosing, and being public it is
// exported under it. A definition is not imported, so it carries no dllimport.

mod @c(system) win;

pub extern fn GetTickCount() u32;

pub fn @c("ConeTicks") ticks() u32 {
  GetTickCount();
}
