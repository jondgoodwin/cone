// A C binding's inline function that calls what it wraps (libc's 'errno' calls
// the C runtime's '_errno') is refused where a kernel calls it, at generation:
// the call to the C library is inside the binding, not in the kernel
// (ErrorGpuUnavailable; module_gpu_io has the direct calls). It is reported at
// the call inside the binding, which module_gpu_cbinding stands for, and
// nothing is emitted after it.

mod module_gpu_io_wrapper;

import module_gpu_cbinding;

fn @compute(64) wrapped(inv Invocation, xs &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len {
    imm n = module_gpu_cbinding.roll();
    out[i] = xs[i];
  }
}
