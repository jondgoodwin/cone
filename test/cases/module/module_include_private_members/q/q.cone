// Package q: public types whose private members the include file leaves out,
// arranged every way blank lines and comments fall between them. Each private
// body names seed, which the file also leaves out, so a private member the
// generator failed to leave out fails the file's own check. The golden file
// pins what is left: every public member, every field, and the spacing.

mod q;

fn seed() i64 {
  1;
}

// Two private methods last, a blank line between them
pub struct Two {
  pub a i64;
  pub fn go(self) i64 { a + h1() + h2(); }

  fn h1() i64 { seed(); }

  fn h2() i64 { seed() + 1; }
}

// Three private methods last, a blank line between each
pub struct Three {
  pub a i64;

  pub fn go(self) i64 { a + h1() + h2() + h3(); }

  fn h1() i64 { seed(); }

  fn h2() i64 { seed() + 1; }

  fn h3() i64 { seed() + 2; }
}

// Three private methods last, no blank line between them
pub struct Packed {
  pub a i64;

  pub fn go(self) i64 { a + h1() + h2() + h3(); }
  fn h1() i64 { seed(); }
  fn h2() i64 { seed() + 1; }
  fn h3() i64 { seed() + 2; }
}

// Private fields and methods interleaved with public ones, blank lines and
// comments
pub struct Mixed {
  // The public field
  pub a i64;

  // A private field, which the include file keeps
  b i64;
  // A private method, directly under the field
  fn h1(self) i64 { seed() + b; }

  /* A private method under a block comment */
  fn h2() i64 { seed(); }
  fn h3() i64 { seed() + 1; } // a comment after it

  pub fn go(self) i64 { a + b + h1() + h2() + h3() + h4() + h5(); }
  pub fn make(a i64) Mixed { Mixed[a, 1, 2]; }

  // A comment standing on its own

  fn h4() i64 { seed() + 2; }
  c i64;

  // The last private method, under its comment
  fn h5() i64 { seed() + 3; }
}

// A private member first
pub struct First {
  fn h1() i64 { seed(); }

  pub a i64;
  pub fn go(self) i64 { a + h1() + h2(); }
  fn h2() i64 { seed() + 1; }
}

// A private method first, then a private field, then a blank line
pub struct Lead {

  fn h1() i64 { seed(); }
  b i64;

  pub a i64;
  pub fn go(self) i64 { a + b + h1(); }
  pub fn make(a i64) Lead { Lead[1, a]; }
}

// Two private functions last in the module, a blank line between them
fn tail1() i64 {
  seed();
}

fn tail2() i64 {
  seed() + 1;
}
