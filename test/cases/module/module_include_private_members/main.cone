// The program: compiled against the include file q's compile generated, and
// linked with q's object. It calls each type's public methods, whose private
// helpers the include file leaves out and q's object defines.

mod prog;

import stdio use *;
import q;

fn main() i32 {
  printInt(q.Two[5i64].go());
  printStr("\n");
  printInt(q.Three[5i64].go());
  printStr("\n");
  printInt(q.Packed[5i64].go());
  printStr("\n");
  printInt(q.Mixed.make(5i64).go());
  printStr("\n");
  printInt(q.First[5i64].go());
  printStr("\n");
  printInt(q.Lead.make(5i64).go());
  printStr("\n");
  0i32;
}
