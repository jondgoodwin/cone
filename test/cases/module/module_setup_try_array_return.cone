// A function that returns an array type written with brackets ('[i64, i32]', not 'Array[i64, 2]') is refused
// as an array type; a '?' on its result then names that type in its own message, which spells the array it
// cannot read the size of rather than reading one

mod module_setup_try_array_return;

fn f() [i64, i32] { 0 }                   //~ ErrorBadArray
                                          //~^ ErrorBadArray

let a: i64 = f()?;                        //~ ErrorQuesOperand
