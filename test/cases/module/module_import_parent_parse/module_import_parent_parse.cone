// A name of the parent imported twice, which is refused as it is parsed, as a
// module imported twice is: a module imports a name once [Jon 23 Sep].
//
// Parse stage, which is why it is its own scenario: a parse diagnostic stops the
// compile before the names are bound.
//
// The folder holds:
//   sub/sub.cone   imports this module's Point twice

mod module_import_parent_parse;

pub struct Point {
  pub x i64;
}

fn designated() i64 {
  1i64;
}
