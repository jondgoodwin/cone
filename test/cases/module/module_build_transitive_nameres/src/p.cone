// The program imports a. It may use the Counter a hands it, but b itself is
// not a name it has: not bare, since p never imports b, and not through a,
// whose import of b is private to a.

mod p;

import a;

fn main() {
  imm c = a.make();
  imm n = c.count;
  imm d b.Counter = c;     //~ ErrorUnkName "b does not refer to a declared name"
  imm e a.b.Counter = c;   //~ ErrorNotPublic
}
