// A one-file module inside an organisational folder. org/ holds no org.cone, so
// it draws no module and its files are the enclosing module's -- and a module
// must sit directly in its parent module's folder, as a module folder must be a
// direct child of it. The diagnostic, which says where the file may go, is in
// cases.toml, and this file is left out of the compile.

mod nested;

pub fn nestedFn() i64 {
  6i64;
}
