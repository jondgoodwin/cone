// A one-file module beside a module folder of the same name, clash/, whose
// designated file draws a module called clash too. A module is one file or one
// folder, so this pair is refused, naming both paths, and the folder -- the
// shape a file grows into -- is kept. The diagnostic is in cases.toml, and this
// file is left out of the compile.

mod clash;

pub fn fromTheFile() i64 {
  4i64;
}
