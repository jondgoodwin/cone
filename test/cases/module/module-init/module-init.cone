// MODULE INIT AND FINAL: each module declares only its own portion, and the
// program's stitched init and final run them all [Jon 23 Sep].
//
// This is the designated file of the scenario's folder, so it is the root
// module, and its three subfolders each draw a submodule of it:
//   base/base.cone      an 'init' assigning an 'imm' global declared without a
//                       value, and a finalizing global with a value, which gives
//                       base a 'drop' though it declares no 'final'
//   middle/middle.cone  imports base; an 'init' reading base's global, so it
//                       must run after base's, and a 'final' followed by the drop
//                       of a finalizing global its 'init' assigns
//   top/top.cone        imports middle; a 'final' and nothing else
//
// The module order puts each module after everything it depends on, and the
// root after its children: base, middle, top, then this module. 'initAll()'
// runs every 'init' in that order and 'finalAll()' every finalizer in exactly
// the reverse. A module with neither gets no call; top has no 'init'.

import stdio use *;

imm started i64;

fn @initpure init() {
  started = middle.scaled + 1i64;
  printStr("init root: started = ");
  printInt(started);
  printStr("\n");
}

fn final() {
  printStr("final root\n");
}

fn main() i32 {
  initAll();
  printStr("main: scaled = ");
  printInt(middle.scaled);
  printStr(", started = ");
  printInt(started);
  printStr("\n");
  finalAll();
  0i32;
}
