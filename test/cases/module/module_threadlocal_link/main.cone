// The program: it reads and writes q's thread-locals through their 'extern'
// declarations, and q's own code sees what the program wrote, since both
// objects reach this thread's one copy.

mod prog;

import stdio use *;
import q;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("depth", q.depth);
  q.depth = q.depth + 2i64;
  show("depthPlus", q.depthPlus(1i64));
  show("bumpHits", q.bumpHits());
  show("bumpHits", q.bumpHits());
  0i32;
}
