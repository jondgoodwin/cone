// Package q's source: thread-local globals the program reaches from its own
// object. Compiled as a library, the public one is exported, and so is the
// private one the public inline 'bumpHits' names; the include file declares
// each 'extern', and keeps '@threadlocal' on it.

mod q;

// A public thread-local: exported
pub mut @threadlocal depth i64 = 7i64;

// A private thread-local named by the public inline 'bumpHits': exported
mut @threadlocal hits i64 = 10i64;

pub fn bumpHits() i64 inline {
  hits = hits + 1i64;
  hits;
}

// Read in q's object, so the program sees which copy q's code reaches
pub fn depthPlus(n i64) i64 {
  depth + n;
}
