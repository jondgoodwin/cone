// A program using thread-local globals another package defines. Package q is
// compiled on its own first (q\q.conebuild, listed under 'link' in cases.toml),
// which writes its include file, and this program is compiled against it:
// include\q.cone, which the runner requires to be what q's compile generated.
// The two objects are then linked and the program run.

build: debug
output: executable

prog: {
    "main.cone"
    import q: "include/q.cone"
    import stdio: "stdio.cone"
}
