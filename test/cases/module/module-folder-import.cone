// What 'import' reaches when the name it gives resolves to a folder: the module
// that folder holds, files and all.
//
// 'import modfolder' finds modfolder/modfolder.cone -- the designated file of a
// folder named for it -- and the module it draws holds that file, helper.cone
// beside it and parts/scale.cone beneath it. The name bound here is the
// FOLDER's, which is what the module is named for, and cases.toml pins that
// every one of those files' declarations is spelled after it.
//
// It compiles rather than runs: it spans modules.
//
// The imported module is the folder modfolder.

import modfolder;

fn viaFolderName() i64 {
  modfolder.folderAdd(1i64) + modfolder.helperScale(2i64) + modfolder.partsOf(3i64);
}
