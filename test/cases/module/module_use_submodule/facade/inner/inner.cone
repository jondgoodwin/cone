// The submodule facade re-exports. Nothing here says so: a fold's visibility is
// the folding module's to declare.

mod inner;

pub fn innerValue() i64 {
  11i64;
}

// The type of facade's global, which facade names only through its 'use'
pub struct Panel {
  pub w i64;
  pub h i64;

  pub fn area(self) i64 {
    w * h;
  }
}
