// A MODULE FOLDS ITS OWN SUBMODULE'S NAMES with a standalone 'use' [Jon 23 Sep].
//
// A submodule is brought in by its folder and never imported, so an import's
// clause cannot fold it. A standalone 'use' names any namespace the module
// reaches WITHOUT an import -- an enum, a submodule, or a path through
// submodules -- and takes the clause an import's 'use' takes: every public name
// by default, a list with 'as', a block, 'but', and 'pub' first to re-export.
// Each folded name is an alias of the submodule's own declaration, so every call
// here lowers to the submodule's symbol.
//
// The folder holds:
//   scaling/scaling.cone         folded whole but one, which stays reached by path
//   measure/measure.cone         two names folded by a block, one renamed
//   geometry/deep/deep.cone      a submodule's submodule, folded by a path
//   facade/facade.cone           folds its own submodule 'pub use', re-exporting it
//   facade/inner/inner.cone      the submodule facade re-exports
//   reader/reader.cone           a sister importing what facade re-exported

import stdio use *;

// Every public name of scaling but thrice. secret is private to scaling, so the
// fold passes it over
use scaling but thrice;

// A list, written as a block, one name renamed
use measure {
  inches as toInches,
  feet,
};

// A path through submodules, one level deeper: geometry is this module's child,
// and deep is geometry's
use geometry.deep;

// An enum's 'use' beside them, as it always was
enum Dir {
  Up, Down;
}
use Dir;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn score(d &Dir) i64 {
  match d {
    case is &Up {1i64;}
    else {2i64;}
  }
}

fn main() i32 {
  show("whole-fold-twice", twice(21i64));
  show("whole-fold-half", half(42i64));
  // Left out by 'but', and still scaling's by path
  show("but-leaves-it-to-the-path", scaling.thrice(5i64));
  show("listed-and-renamed", toInches(2i64));
  show("listed", feet(6i64));
  show("path-one-level-deeper", depth());
  // facade's 'pub use' made inner's names public names of facade: reached by a
  // path from here, and imported by name by a sister
  show("pub-use-reached-by-path", facade.innerValue());
  show("pub-use-seen-from-a-sister", reader.readInner());
  // facade's global folded area in the second fold pass, and reader took it
  // there: Panel [3, 4], 12
  show("global-fold-after-its-use-reaches-a-sister", reader.readArea());
  imm down = Down[];
  show("enum-use-unchanged", score(&down));
  0i32;
}
