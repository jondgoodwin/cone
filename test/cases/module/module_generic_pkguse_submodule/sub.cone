// q's submodule uses g[i64]. Its instance is made in a submodule's file, which
// the include file's '__uses' (written in the root) cannot record, and g
// declares an 'init' that would never run in a program that does not name
// g[i64] itself: refused (ErrorInstanceUnrecorded).

mod sub;

import g;

pub fn inits() i64 {
  g[i64].inits  //~ ErrorInstanceUnrecorded "made in a submodule's file"
}
