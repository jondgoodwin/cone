// Package q with a submodule that uses an instance of the generic module g,
// compiled on its own: refused, since g's 'init' would never run.

build: debug
output: library

import g: "g.cone"

q: {
    "q.cone"
    import g: "g.cone"
    sub: {
        "sub.cone"
        import g: "g.cone"
    }
}
