// Imports alpha, which imports this module: alpha -> beta -> alpha. alpha has
// no name absent in any pass, and the item waits for one until the passes have
// settled; then it is reported, once, with the message it always had. shared,
// which alpha had not re-exported the first time, is no error.

mod beta;

import alpha use
  own,
  shared,
  absent;                   //~ ErrorNoMbr:3 "alpha has no name absent to fold in."
