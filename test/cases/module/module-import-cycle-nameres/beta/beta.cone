// Imports alpha, which imports this module: alpha -> beta -> alpha. alpha is
// still mid-fold when this import reads it, so what alpha declares is there and
// what it re-exports is not.

mod beta;

import alpha use
  own,
  shared as common,         //~ ErrorCircular:3 "shared is re-exported by alpha, but beta read alpha round a cycle of imports (alpha -> beta -> alpha), before alpha's own folds had run. A re-export does not travel round a cycle of imports."
  absent;                   //~ ErrorNoMbr:3 "alpha has no name absent to fold in."

// A path is read mid-fold too: a module's 'use' of an enum is expanded in the
// fold pass. The second diagnostic follows from the first: the path did not
// resolve, so what the 'use' names is not an enum's name
use alpha.Tone;             //~ ErrorCircular:11 "Tone is re-exported by alpha, but beta read alpha round a cycle of imports (alpha -> beta -> alpha)"
                            //~^ ErrorUseEnum:10 follow-on

pub fn b() i64 {
  // The local spelling the clause gave it
  own() + common();         //~ ErrorCircular:11 "common names shared, which alpha re-exports, but beta read alpha round a cycle of imports (alpha -> beta -> alpha)"
}
