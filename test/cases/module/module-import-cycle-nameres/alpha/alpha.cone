// Imports beta, which imports this module back. alpha's folds start first, and
// its first import is where they stop to fold beta, so the re-export below it
// has not run when beta reads this module.

mod alpha;

import beta;
import gamma pub use shared, Tone;

// Declared, so bound at parse: beta folds it in whatever the order
pub fn own() i64 {
  3i64;
}
