// A wildcard of kappa, read while kappa is mid-fold: kappa -> lambda -> kappa.
// It carries kappa's declarations on and not what kappa re-exports, so more is
// missing here and, through the 'pub use', from lambda's path too.

mod lambda;

import kappa pub use *;

fn f() i64 {
  k() + more();             //~ ErrorCircular:9 "more is re-exported by kappa, but lambda read kappa round a cycle of imports (kappa -> lambda -> kappa)"
}
