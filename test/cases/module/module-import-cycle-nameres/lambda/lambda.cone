// A wildcard of kappa, read while kappa is mid-fold: kappa -> lambda -> kappa.
// Its 'but' is judged against kappa once kappa is complete: extra is a name
// kappa has by then, though not the first time this read it, and is left out
// with no complaint; nothing is a name kappa never has.

mod lambda;

import kappa pub use * but extra, nothing;   //~ ErrorNoMbr:35 "kappa has no member named nothing to leave out."

fn f() i64 {
  k() + more();
}
