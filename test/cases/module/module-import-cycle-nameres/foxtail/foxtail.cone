// fox's two clauses in the other order. gamma's shared arrives first, as it is
// written first, and delta's collides with it in the next pass: reported once,
// at echo's wildcard.

mod foxtail;

import gamma use shared;
import echo use *;          //~ ErrorDupName "shared is already a name of this module. A folded name must be unique: rename it with 'as', or leave it out with 'but'."
