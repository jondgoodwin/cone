// Imports base, so its 'init' runs after base's and may read what base's
// assigned. Its finalizer is its own 'final'; the global its 'init' assigns,
// of a type with a 'final', is not finalized.

mod middle;

import stdio use *;
import base;

struct Logger {
  pub n: i64;
  fn final(self: &uni) {
    printStr("logger final ");
    printInt(n);
    printStr("\n");
  }
}

pub let scaled: i64;
let log: Logger;

fn @initpure init() {
  scaled = base.seed * 10i64;
  log = Logger(7i64);
  printStr("init middle: scaled = ");
  printInt(scaled);
  printStr("\n");
}

fn final() {
  printStr("final middle\n");
}
