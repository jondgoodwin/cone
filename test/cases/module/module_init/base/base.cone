// The first module in the order: it imports nothing of the program's. Its
// 'init' assigns an 'imm' global declared without a value -- once, as a local's
// first assignment -- and its finalizing global, given a literal value, is
// dropped by the 'drop' base is given, though base declares no 'final'.

mod base;

import stdio use *;

pub struct Marker {
  pub id i64;
  fn final(self &uni) {
    printStr("marker final ");
    printInt(id);
    printStr("\n");
  }
}

pub imm seed i64;

// Not a constant, though 'imm': its finalizer takes it as '&uni'
imm mark Marker = Marker[1i64];

fn @initpure init() {
  seed = 5i64;
  printStr("init base: seed = ");
  printInt(seed);
  printStr("\n");
}
