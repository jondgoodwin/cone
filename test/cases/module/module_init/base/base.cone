// The first module in the order: it imports nothing of the program's. Its
// 'init' assigns a 'let' global declared without a value -- once, as a local's
// first assignment -- and a global given a literal value whose type has a
// 'final', which never runs: no global is finalized, and base has no 'final'.

mod base;

import stdio use *;

pub struct Marker {
  pub id: i64;
  fn final(self: &uni) {
    printStr("marker final ");
    printInt(id);
    printStr("\n");
  }
}

pub let seed: i64;

// Not a constant, though 'imm': its type has a drop function
let mark: Marker = Marker(1i64);

fn @initpure init() {
  seed = 5i64;
  printStr("init base: seed = ");
  printInt(seed);
  printStr("\n");
}
