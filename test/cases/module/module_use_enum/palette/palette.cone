// Declares two enums and folds the variants of both in as names of this module:
// Colors publicly, so every module that reaches palette may have them, and Shade
// privately, so its variants are bare here and nowhere else.

mod palette;

pub enum Colors {
  Red, Green, Blue;
}

// 'pub use' makes the folded names public names of palette. A wildcard import of
// palette then carries them on, and a path from outside reaches them as
// 'palette.Green', exactly as it reaches anything else palette declares 'pub'
pub use Colors;

pub enum Shade {
  Light, Dark;
}

// A plain 'use' is private to the module that wrote it. The declaring module gets
// no exception: it writes 'use' like anyone else to have its variants bare
use Shade;

pub fn darkness(s &Shade) i64 {
  match s {
    case is &Dark {2i64;}
    else {1i64;}
  }
}
