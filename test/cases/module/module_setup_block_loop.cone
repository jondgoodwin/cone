// A loop in a block that gives a global its value has breaks to gather and no function
// around it (the compiler once crashed on that). Its locals are started by constants,
// so the block is a setup like any other, and the loop runs there.

mod module_setup_block_loop;
import stdio use *;

fn seven() i64 { 7i64 }

let a: i64 = { var i = 0i64; while i < 3i64 { i += 1i64; }; i };
let b: i64 = { var s = 0i64; each k in 0i64 ..< 4i64 { s += k; }; s };
let c: i64 = { while false { }; 5i64 };
let d: i64 = { var i = 0i64; while i < 3i64 { i = seven(); }; i };

fn main() {
  print <- a; print <- " ";
  print <- b; print <- " ";
  print <- c; print <- " ";
  print <- d; print <- "\n";
}
