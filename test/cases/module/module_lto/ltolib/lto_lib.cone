// The package of module_lto: what the program reaches only by a call out of
// line (a function too long for the ThinLTO link to be sure to inline) and by a
// vtable (a trait object's method), which are both symbols the link must keep
// because another module refers to them.

mod lto_lib;

pub trait Shape {
  pub fn sides(self: &) i64;
}

pub struct Square is Shape {
  pub n: i64;
  pub fn sides(self: &) i64 { 4i64 * n }
}

// The sum of the first n triangular numbers, by a loop
pub fn tetra(n: i64) i64 {
  var total = 0i64;
  var tri = 0i64;
  var i = 1i64;
  while i <= n {
    tri = tri + i;
    total = total + tri;
    i = i + 1i64;
  }
  total
}

pub fn viaTrait(s: &<Shape) i64 {
  s.sides() + 1000i64
}
