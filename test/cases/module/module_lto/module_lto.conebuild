// A program of two objects built with ThinLTO: the program and package lto_lib,
// each compiled to bitcode and linked by conec's ThinLTO link.

build: release
output: executable

import lto_lib: "include/lto_lib.cone"

prog: {
    "main.cone"
    import lto_lib: "include/lto_lib.cone"
    import stdio: "stdio.cone"
}
