// The program of module_lto, built with ThinLTO: it calls a package's function,
// a trait object's method through that package's vtable, and a method of its own
// type from the package.

mod prog;

import stdio use *;
import lto_lib;

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // The triangular numbers 1, 3, 6, 10, 15 sum to 35
  show("tetra", lto_lib.tetra(5i64));
  let sq = lto_lib.Square(3i64);
  // 4 * 3
  show("sides", sq.sides());
  // 4 * 3 + 1000
  show("via-trait", lto_lib.viaTrait(&sq));
  0i32
}
