// A wildcard import of relay receives what relay re-exported and nothing else.

mod reader;

import relay.*;

pub fn read() i64 {
  one() + deux();
}

fn unread() i64 {
  // relay folded 'more' privately, so a wildcard import does not carry it on
  more();                   //~ ErrorUnkName:3 "The name more does not refer to a declared name"
}
