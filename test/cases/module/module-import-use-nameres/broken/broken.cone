// Every way a clause on an import can name what does not fold. Each is reported
// at the name, where the fold runs, and the rest of the clause still folds.

mod broken;

import lib use
  nope,                     //~ ErrorNoMbr:3 "lib has no name nope to fold in"
  hid,                      //~ ErrorNotPublic:3 "hid is private to lib, so it does not fold"
  one as clash,             //~ ErrorDupName:3 "clash is already a name of this module"
  lib,                      //~ ErrorBadFold:3 "lib is the module being imported"
  two;

// Every name of extra but one it has not got. extra's 'two' meets the 'two' the
// import above folded, and the collision is reported at the clause that arrived
// second, since a star clause names nothing to point at; 'but two' would settle it.
import extra use * but nada;  //~ ErrorNoMbr:24 "extra has no member named nada to leave out"
                              //~^ ErrorDupName:14 "two is already a name of this module"

// Declared here, so the fold above that spells 'clash' collides with it. A
// fold is renamed with 'as' or left out with 'but' to settle it.
fn clash() i64 {
  two() + more();
}
