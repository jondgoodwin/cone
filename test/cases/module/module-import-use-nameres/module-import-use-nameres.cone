// What an import's 'use' clause does not put in reach, and what it refuses to
// fold.
//
// Name-resolution stage: a clause is expanded in the module's fold pass, and a
// path and a wildcard import read what it left.
//
// The folder holds:
//   lib/lib.cone         two public names and a private one
//   extra/extra.cone     one public name
//   relay/relay.cone     'pub use' on lib's names, a private '*' of extra's
//   reader/reader.cone   a wildcard import of relay
//   broken/broken.cone   every name a clause may not fold

fn reach() i64 {
  // A 'pub use' fold is a public name of relay
  relay.one();

  // The module's own name is not a fold, so 'pub use' left it private. Only
  // 'pub import' publishes it
  relay.lib.two();          //~ ErrorNotPublic:9 "private to its module"

  // A fold without 'pub' is relay's own
  relay.more();             //~ ErrorNotPublic:9 "private to its module"
}
