// A C-named module defining the global peek declares, declaring the one peek
// defines, and holding a private function spelled as C's 'abs'.

mod @c tally;

pub mut Hits i64 = 5i64;

pub extern {
  imm Greeting [5; u8];
}

fn abs(n i32) i32 {
  n + 98i32;
}

pub fn Private(n i32) i32 {
  abs(n);
}

pub fn Second() i64 {
  i64[Greeting[1]];
}
