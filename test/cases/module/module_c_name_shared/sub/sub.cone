// Declares the C names its parent declares or defines, and defines one its
// parent declares.

mod sub;

extern {
  fn @c abs(n i32) i32;
  fn @c cone_first(n i64) i64;
}

pub fn @c cone_later(n i64) i64 {
  n + 100i64;
}

pub fn absTwice(n i32) i32 {
  abs(n) * 2i32;
}

pub fn first(n i64) i64 {
  cone_first(n);
}
