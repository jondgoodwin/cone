// knob's include file, written by hand. The global is declared 'extern', with
// no value, since knob's object defines it; and it carries the same fold clause
// as the source, which is the only way the include can pass on the names the
// fold puts into knob. The fold reads Config's declaration, written here.

mod knob;

pub struct Config {
  pub speed i64;
  pub scale i64;

  pub extern fn product(self) i64;
}

pub extern mut config Config pub use *;

pub extern fn faster();

pub extern fn doubled() i64;
