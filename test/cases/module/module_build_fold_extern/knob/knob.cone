// Package knob folds its public global's members into its own namespace with a
// 'pub use' clause, so 'speed', 'scale' and 'product' are public names of knob,
// reached through 'config'. Inside knob they are written bare.

mod knob;

pub struct Config {
  pub speed i64;
  pub scale i64;

  pub fn product(self) i64 {
    speed * scale;
  }
}

pub mut config Config = Config[6i64, 7i64] pub use *;

// Reaches the folded names bare, as a program folding knob in does
pub fn faster() {
  speed = speed + 1i64;
}

pub fn doubled() i64 {
  product() * 2i64;
}
