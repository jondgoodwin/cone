// A program compiled against knob's include file, whose 'extern' global carries
// a fold clause. Package knob is compiled on its own first (knob\knob.conebuild,
// listed under 'link' in cases.toml), and the two objects are linked.

build: debug
output: executable

import knob: "include/knob.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import knob: "include/knob.cone"
    import stdio: "stdio.cone"
}
