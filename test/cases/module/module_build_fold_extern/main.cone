// The program folds knob's public names in, and so reaches the names knob's
// global folded bare, as knob itself does: each reads or writes knob's one
// 'config', defined in knob's object.

mod prog;

import stdio use *;
import knob use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("speed", speed);
  show("scale", scale);
  show("product", product());
  faster();
  show("speed", speed);
  show("product", product());
  show("doubled", doubled());
  speed = 10i64;
  show("config.speed", config.speed);
  show("knob.speed", knob.speed);
  show("doubled", doubled());
  0i32;
}
