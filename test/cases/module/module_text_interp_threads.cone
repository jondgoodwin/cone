// An interpolated string sent to the console is one record, as the send list it
// spells is: eight threads each print 60 lines of the same interpolated text,
// pieces of text, numbers and a string among them. A line torn by another thread's
// would not read 'row 7 / 70 :: col end' whole, and the output would differ from
// the 480 identical lines it is blessed as.

mod module_text_interp_threads;

import stdio use *;
import collections use *;
import thread;

fn worker(id: i32) i32 {
  let seven = 7;
  let label = "end";
  var k = 0;
  while k < 60 {
    print <- $"row {seven} / {seven * 10} :: col {label}\n";
    k = k + 1;
  }
  id
}

fn main() i32 {
  var threads = List[thread.Thread[i32]]();
  var i = 0;
  while i < 8 {
    threads <- thread.start(i, &worker);
    i = i + 1;
  }
  var total = 0;
  while threads.len() > 0usize {
    match threads.pop() {
      case let Some(t) { total = total + t.join(); }
      case is None[thread.Thread[i32]] {}
    }
  }
  print <- $"joined {total}\n";
  0
}
