// A C-named module gets no prelude: its 'mod' line takes back the automatic
// import of core every other module carries. It declares what a C library
// defines, in C's types, and needs nothing of core; and core itself imports a
// C package, libc, which a prelude would make a loop.
//
// So core's names are not this module's. Declaring one is no collision --
// 'Option' is a struct here, and 'malloc' is declared as libc declares it --
// and using one that is not declared here finds nothing.
//
// Name resolution only: the refusals are ErrorUnkName, one per core name used.

mod @c module_c_no_prelude;

pub struct Option {
  pub x i32;
}

pub extern fn malloc(size usize) *u8;

pub fn wrapped() Option {
  Option[3i32];
}

pub fn some() {
  imm s = Some[1i32];                 //~ ErrorUnkName "Some"
  imm r = Result[i32, i32];           //~ ErrorUnkName "Result"
}
