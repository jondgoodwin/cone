// 'extern' on a declaration its user needs the body of, or on something that is
// not a function or a global.
//
// Parse stage only: parse errors skip semantic analysis.

mod module_extern_reject;

// An inline function is expanded where it is called, and a generic one is
// instantiated there: neither is defined elsewhere
extern fn inl() i32 inline;                 //~ ErrorBadExtern
extern fn gen[T](x T) T;                    //~ ErrorBadExtern
// A trait's method is a requirement, or a default copied into each implementer
trait Shape { extern fn area(self &) i32; }   //~ ErrorBadExtern
// A generic type's methods are instantiated with it
struct Box[T] { v T; extern fn get(self) T; }   //~ ErrorBadExtern
// A field is part of the value, not a symbol defined elsewhere
struct Holder { extern x i32; }             //~ ErrorBadExtern
// 'extern' is followed by a function, a global, or a block of them
extern mystery fn f();                      //~ ErrorBadExtern
