// A generic module holding what its instances are not built for yet: a module
// trait, which would be each instance's own, and which nothing outside the
// instance has a spelling to name yet

pub mod stack[T];

pub var @threadlocal count: i64 = 0i64;

pub fn push(x: T) {
  count = count + 1i64;
}

pub mod trait Counter {          //~ ErrorGenModBody:15
  pub fn pushes() i64;
}
