// Imported by module_imports_macro_overload.cone. It is never compiled on its
// own, so it is listed in cases.toml as a support module.
//
// It declares macros overloaded by repeating the name, one public pair and one
// private pair that a public macro's body uses, so that an importer must be
// given every macro of a name, not the first alone, to expand them.

mod modulemacro_overload;

pub macro pick[a: i64] {
  a + 1000i64
}

pub macro pick[a: bool] {
  if a { 2000i64 } else { 3000i64 }
}

macro inner[a: i64] {
  a + 4000i64
}

macro inner[a: bool] {
  if a { 5000i64 } else { 6000i64 }
}

pub macro outer[a: i64] {
  inner(a) + inner(true)
}

pub fn bump(n: i64) i64 {
  n + 1i64
}
