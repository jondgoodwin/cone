// What 'import x as y' refuses once names are resolved.
//
// The old name is bound to nothing: a use of it is unknown, and the message
// says which name the module is reached by. A 'use' clause may not fold the
// module's own name back in, which would undo the rename. And a rename meets
// what a clause folds as the module's own name would: the rename is bound as
// the import is parsed, so the fold is what finds the name taken.

mod module_import_as_nameres;

import modulesub as sub use scaleInt as mx; //~ ErrorDupName:29 "mx is already a name of this module"
import modulex as mx;
import moduleearly as early use moduleearly;   //~ ErrorBadFold:33 "moduleearly is the module being imported, and the import binds it already, as early"

fn main() i32 {
  sub.scaleInt(2i64);
  modulesub.scaleInt(2i64);                 //~ ErrorUnkName:3 "this module imports modulesub as sub, which is the name it is reached by here"
  0i32;
}
