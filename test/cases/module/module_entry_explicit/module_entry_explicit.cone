// A PROGRAM THAT STILL CALLS 'initAll()' AND 'finalAll()' ITSELF keeps working.
// The program is live between its init and its final, and a call that finds it
// in the state it asks for does nothing. The entry the compiler builds has run
// the stitched init before 'main' starts, so the first line 'main' prints
// comes after both inits though it is written before the calls to
// 'initAll()', which find nothing to run. The first 'finalAll()' runs the
// finals; a second 'initAll()' after it starts the program again, and the
// entry's own final, when 'main' returns, finalizes that run, once.

mod module_entry_explicit;

import stdio use *;

imm answer i64;

fn @initpure init() {
  answer = helper.base + 2i64;
  printStr("root init\n");
}

fn final() {
  printStr("root final\n");
}

fn main() i32 {
  printStr("main: begin\n");
  initAll();
  initAll();
  printStr("main: answer = ");
  printInt(answer);
  printStr("\n");
  finalAll();
  finalAll();
  printStr("main: between\n");
  initAll();
  printStr("main: again answer = ");
  printInt(answer);
  printStr("\n");
  0i32;
}
