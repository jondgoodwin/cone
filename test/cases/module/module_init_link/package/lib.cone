// Package lib's source. Its 'init' assigns the globals it declares without a
// value, and its finalizer -- the 'drop' it is given, since a global needs
// finalizing -- runs its own 'final' and then those globals'. None of the three
// is public: a library compile exports them because the program's stitched
// init and final call them.

mod lib;

import stdio use *;

pub struct Handle {
  pub id i64;
  fn final(self &uni) {
    printStr("lib handle final ");
    printInt(id);
    printStr("\n");
  }
}

// Assigned at run time, by 'init'
pub imm value i64;

// Assigned by 'init' too, and finalized after lib's 'final'
pub mut handle Handle;

// A private owner, released after handle: the include file keeps it, as it
// keeps every global lib's finalizer finalizes
mut boxed So[Handle];

fn @initpure init() {
  value = 42i64;
  handle = new Handle(9i64);
  boxed = new So[Handle](7i64);
  printStr("lib init\n");
}

fn final() {
  printStr("lib final\n");
}
