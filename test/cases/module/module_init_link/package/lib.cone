// Package lib's source. Its 'init' assigns the globals it declares without a
// value, and its finalizer is its own 'final': its globals, of a type with a
// 'final', are never finalized. Neither 'init' nor 'final' is public: a library
// compile exports them because the program's stitched init and final call
// them.

mod lib;

import stdio use *;

pub struct Handle {
  pub id: i64;
  fn final(self: &uni) {
    printStr("lib handle final ");
    printInt(id);
    printStr("\n");
  }
}

// Assigned at run time, by 'init'
pub let value: i64;

// Assigned by 'init' too, and never finalized
pub let handle: Handle;

// A private owner, never released: no importer reaches it, so the include file
// leaves it out
let boxed: Uni[Handle];

fn @initpure init() {
  value = 42i64;
  handle = Handle(9i64);
  boxed = Uni[Handle](7i64);
  printStr("lib init\n");
}

fn final() {
  printStr("lib final\n");
}
