// The program: its stitched init runs lib's 'init' before its own, since the
// program imports lib, and its stitched final runs its own 'final' before lib's
// finalizer. Every line lib prints, and the value 42, can only have come from
// lib's object: the include file has no bodies.

mod prog;

import stdio use *;
import lib;

imm doubled i64;

fn @initpure init() {
  doubled = lib.value * 2i64;
  printStr("prog init\n");
}

fn final() {
  printStr("prog final\n");
}

fn main() i32 {
  initAll();
  printStr("lib.value = ");
  printInt(lib.value);
  printStr("\ndoubled = ");
  printInt(doubled);
  printStr("\n");
  finalAll();
  0i32;
}
