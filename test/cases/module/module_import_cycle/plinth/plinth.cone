// Imports tower with 'use *', and tower extends this module: plinth -> tower
// -> plinth, the second edge an 'extends'. plinth's folds start first, so tower
// takes plinth's names while plinth is mid-fold, before the re-export below.

mod plinth;

import tower use *;
import gamma pub use more;

pub fn base() i64 {
  7i64;
}

// height is tower's, reached through the wildcard
pub fn viaTower() i64 {
  height() + base();
}
