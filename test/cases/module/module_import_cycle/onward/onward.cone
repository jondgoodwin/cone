// A wildcard of lambda, one wildcard further on from the cycle and in none
// itself. What lambda holds when this reads it is what lambda has carried on so
// far, so in the first pass it has no more to give; more arrives here in the
// pass after it arrives in lambda.

mod onward;

import lambda use *;

pub fn g() i64 {
  more() * 100i64 + k();
}
