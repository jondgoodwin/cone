// Imports beta and bravo, each of which imports this module back. alpha's folds
// start first, and its first import is where they stop to fold beta, so the
// re-export below it has not run when beta or bravo reads this module.

mod alpha;

import beta;
import bravo;
import gamma pub use shared, Tone, Config;

// Declared, so bound at parse: beta finds it in any pass
pub fn own() i64 {
  3i64;
}
