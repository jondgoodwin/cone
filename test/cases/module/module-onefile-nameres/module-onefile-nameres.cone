// What a path may not reach through a one-file module: the privacy a folder
// submodule has, unchanged.
//
// Name resolution stage: a submodule is drawn at parse, and what it shows to whom
// is decided where any other name's visibility is.
//
// The folder holds:
//   store.cone           'mod store', a one-file submodule with a private
//                        declaration
//   parser/parser.cone   a folder submodule
//   parser/ast.cone      'mod ast', a one-file submodule of parser, not 'pub'

fn main() i32 {
  // Its own one-file submodule's public name: this is what works, and
  // module-onefile runs it
  store.keep(1i64);

  // A one-file submodule's private declaration. The parent may name the module
  // and may not see through it
  store.hidden(2i64);         //~ ErrorNotPublic "private to its module"

  // A one-file submodule of a submodule that its declaration does not open. ast
  // is private to parser, and this module is parser's parent rather than ast's,
  // so it is outside -- written 'pub mod ast;' it would be in reach, which is what
  // module-onefile's ast pins
  parser.ast.depth();         //~ ErrorNotPublic "private to its module"
  0i32;
}
