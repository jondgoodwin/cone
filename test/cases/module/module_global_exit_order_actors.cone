// The order of import lines decides the order of the module finalizers, and no
// longer whether a dependency's global is still there for a running actor: no
// global is finalized. Here 'actors' is imported before 'cache', so the actors
// package's finalizer runs after cache's. module_global_exit_order_cache imports
// them the other way round and prints the same.
mod module_global_exit_order_actors;

import stdio use *;
import actors;
import cache;
import thread;
import time use Duration;

actor Reader {
  n: u64 = 0u64;

  pub async fn read(self) {
    thread.sleep(Duration.fromMillis(300i64));
    printStr("behaviour: cache.at(100) (expected 7) ");
    print <- cache.at(100usize);
    printStr("\n");
  }
}

fn main() {
  let r = Reader();
  r.read();
  printStr("main returns\n");
}
