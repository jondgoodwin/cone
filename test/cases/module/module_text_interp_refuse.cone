// What an interpolated string refuses as it is read, each at its own column: a close
// brace with no open one, braces with nothing between them, text after the
// expression in the braces. A brace in the text is '{{'. (The unclosed brace has a
// file of its own, module_text_interp_unclosed; the checks after parsing are
// module_text_interp_refuse_names and module_text_interp_refuse_types.)

mod module_text_interp_refuse;

import stdio use *;
import collections use *;

fn main() i32 {
  let n = 3;
  print <- $"lone } brace {n}\n";      //~ ErrorInterpBrace:19
  print <- $"empty {} braces\n";       //~ ErrorInterpBrace:20
  print <- $"blank { } braces\n";      //~ ErrorInterpBrace:20
  print <- $"two {n; n} things\n";     //~ ErrorInterpExpr:20
  print <- $"fine {{ and }} and {n}\n";
  0
}
