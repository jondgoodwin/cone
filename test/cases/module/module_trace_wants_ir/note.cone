// A log send to a Log, from another package, at an off level: the test is inlined, so it
// is one load of the kind's state and a compare, and no call to 'wants' (the flag that any
// sink is installed is read only when the state is worked out, not on this path).

mod module_trace_wants_ir;

import trace use Log;

pub fn note(log: &Log, n: i32) {
  log <- $"value {n}";
}
