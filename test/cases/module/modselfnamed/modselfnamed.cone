//~ ErrorDupName:1 "conflicting definition"
// The designated file of the folder 'modselfnamed', imported by
// module_parse_dupname.cone and never compiled on its own, so the folder is
// listed in cases.toml as a support module under its own name.
//
// It declares no module: the folder names it, and that name is bound in the
// module's own namespace when the import loads it, before this file is parsed.
// The declaration below spells the same name, so it is the duplicate, and the
// module's half of the diagnostic is reported where a module named only by its
// folder is reported -- line 1, column 1 of its designated file, the annotation
// above.

fn modselfnamed() i64 {    //~ ErrorDupName:1 "already defined"
  1i64;
}
