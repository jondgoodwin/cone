// A module two sisters import under other names. Its type, its function and its
// nested module are each reached through whatever name the importer chose.

mod geometry;

pub struct Point {
  pub x i64;
  pub y i64;
}

pub fn dist2(a Point, b Point) i64 {
  imm dx = b.x - a.x;
  imm dy = b.y - a.y;
  dx * dx + dy * dy;
}
