// A 'use' clause after the rename folds as it does after the module's own name.
// 'pub import' with a rename publishes the new name, and every name the import
// folds -- here the default fold units' 'mod' line names.

mod plot;

import geometry as g use dist2 as d2;
pub import units as u;

pub fn area() i64 {
  d2(new g.Point(1i64, 1i64), new g.Point(4i64, 5i64)) + metres(2i64);
}
