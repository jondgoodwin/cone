// The renamed module's type, function and nested module, each through 'geo',
// and a generic module's instance through 'same'.

mod sketch;

import geometry as geo;
import ident as same;

pub fn width() i64 {
  let a = new geo.Point(1i64, 2i64);
  let b = new geo.Point(4i64, 6i64);
  geo.dist2(a, b) + geo.metric.cm(3i64) + same[i64].of(5i64)
}
