// A method named like the module it returns a type of. Inside Model the name
// geometry is the method, in its own signature too, so the module is imported
// under another name and reached by that.

mod model;

import geometry as geomod;

struct Model {
  n i64;
  fn geometry(self &) geomod.Point {
    new geomod.Point(n, n + 1i64);
  }
}

pub fn reach(n i64) i64 {
  imm p = new Model(n).geometry();
  p.x + p.y;
}
