// Package c's root. Its inline body names a macro of submodule 'parts'. Name
// resolution marks the functions, globals and types an expanded body names,
// and a macro is none of those, so the generator does not see that the body
// reaches into 'parts' and copies it whole. The include file then names
// 'parts', which it does not declare, and its self-check refuses it.

mod c;

pub fn doubled(n i64) i64 inline {
  parts.twice[n];
}
