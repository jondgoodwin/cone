// A package compiled on its own whose generated include file fails its
// self-check: the generator misses a reach into a submodule, and parsing and
// name-resolving what it wrote finds it (ErrorIncCheck). Nothing is written but
// the rejected text, c.cone.rejected, where the name that did not resolve is
// reported.

build: debug
output: library

c: {
    "c.cone"
    parts: {
        "parts/parts.cone"
    }
}
