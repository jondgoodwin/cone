// A C-named module with an 'init', in a library the program never imports: it
// is reached only by the C name of a function it defines, which the program
// declares 'extern'. Its 'init' is run by the C runtime as the library's object
// loads, before the program's 'main'. The module's 'init' is its Cone name
// 'cla.init', not the bare C symbol 'init': clb below has one too.

mod @c cla;

var claRan i64 = 0i64;

fn @initpure init() {
  claRan = 7i64;
}

pub fn ClaRan() i64 {
  claRan
}
