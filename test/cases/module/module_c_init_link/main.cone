// The program imports neither library. It reaches each by the C name of a
// function the library defines, so the program's compile knows nothing of them
// and its stitched init cannot call their 'init's. Each prints what its 'init'
// stored, 7 and 8, which only a run of that 'init' can have put there.

mod prog;

import stdio use *;

extern {
  fn @c ClaRan() i64;
  fn @c ClbRan() i64;
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("cla", ClaRan());
  show("clb", ClbRan());
  0i32
}
