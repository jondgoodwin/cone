// The marks a C-named function's narrow integers carry for Win64, whatever the
// host: those clang gives the same C declarations for x86_64-pc-windows-msvc.
// A Bool is C's 'bool', zero-extended ('zeroext') as an argument and as a
// result, on the declaration, on the definition C calls and at each call. An
// 8- or 16-bit integer carries nothing: Win64 leaves widening it to the callee.
// A function that is not C-named keeps Cone's own convention, unmarked.
mod module_c_bool_shape;

extern {
  fn @c takes_bool(b Bool) Bool;
  fn @c narrow(a i8, b u8, c i16, d u16, e Bool) i8;
}

pub fn @c cone_bool(n i32, b Bool) Bool {
  n > 0 and b;
}

// Not C-named: Cone's own convention, untouched
fn plain(b Bool) Bool {
  !b;
}

fn main() {
  imm t = takes_bool(true);
  imm n = narrow(1, 2, 3, 4, t);
  imm c = cone_bool(i32.from(n), t);
  imm p = plain(c);
}
