// A setup may store a borrow of another global, which lasts as long as it
// does, directly or through a function that hands the borrow back: it prints 7
// twice. (A borrow of a temporary is refused: module_setup_borrow_temp_reject.)

mod module_setup_borrow_global;

import stdio use *;

struct P { x: i64; }
fn mk() P { P(7i64) }
fn pass(p: &'a P) &'a P { p }

let g: P = mk();
let direct: &P = &g;
let viaFn: &P = pass(&g);

fn main() i32 {
  printInt(direct.x);
  printStr(" ");
  printInt(viaFn.x);
  printStr("\n");
  0i32
}
