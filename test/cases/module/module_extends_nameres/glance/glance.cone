// An importer folding every name solids shows. shapes' private name is private
// in solids, so a wildcard passes it over and it is no name here.

mod glance;

import solids use *;

pub fn look() i64 {
  edge() + perimeter(1i64, 1i64);
}

fn past() i64 {
  secret();                               //~ ErrorUnkName:3 "The name secret does not refer to a declared name"
}
