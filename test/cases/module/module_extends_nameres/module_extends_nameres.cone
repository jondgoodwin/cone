// What 'extends' on a module refuses, once every name is bound.
//
// Name-resolution stage: every declaration parses, and what is refused is what
// an 'extends' names, or what it would make a name mean.
//
// The folder holds:
//   shapes/shapes.cone       the base: public names, two private, an import folding a name in, a plain import,
//                            and a module both imported and folded in by a wildcard
//   solids/solids.cone       extends shapes, redeclares a public name, a private one and the folded one, reaches the other private one,
//                            names a module shapes imports without importing it, declares the name of another,
//                            and names the module shapes folded in
//   tools/tools.cone         the module shapes imports with a fold
//   gauge/gauge.cone         the module shapes only imports
//   meter/meter.cone         the module shapes imports and also folds in, by a wildcard of relay
//   relay/relay.cone         re-exports meter
//   peek/peek.cone           imports solids and names shapes' private name through it, by path and in a listed clause
//   glance/glance.cone       wildcard-imports solids, which passes shapes' private name over
//   arena/arena.cone         extends a trait, which is what 'is' says, not 'extends'
//   notmod/notmod.cone       extends a function
//   me/me.cone               extends itself
//   ping/ping.cone           extends pong, which extends ping
//   pong/pong.cone
//   outer/outer.cone         extends its own submodule
//   outer/child/child.cone   extends its parent
//   outer/deep/deep.cone     extends a module out of its reach

mod module_extends_nameres;

// A trait of the parent, so its children's registry holds it. 'mod arena extends
// Region' is the spelling the module design brief once gave a module conforming
// to a module trait, which is a different reading from reuse and is spelled 'is'
pub trait Region {
  fn size(self) i64;
}

// A function of the parent, which the registry holds beside its submodules
fn helper() i64 {
  shapes.area(1i64, 1i64);
}
