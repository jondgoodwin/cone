// A third module, a sister of facade. What facade re-exported with 'pub use' is a
// public name of facade, so an import's clause folds it here like any other.
// The clause is a wildcard, which reads facade afresh in each fold pass and not
// in the pass that reports, so area, which facade's global folds only in the
// second pass, arrives here only because the passes repeat.

mod reader;

import facade use *;

pub fn readInner() i64 {
  innerValue() + 1i64;
}

// area arrived in facade in the second fold pass, through its global
pub fn readArea() i64 {
  area();
}
