// Folded whole by the parent, but one name. Its private name is not folded at
// all: a fold takes only what the source shows.

mod scaling;

pub fn twice(n i64) i64 {
  n * 2i64;
}

pub fn half(n i64) i64 {
  n / 2i64;
}

pub fn thrice(n i64) i64 {
  n * 3i64;
}

fn secret(n i64) i64 {
  n + 100i64;
}
