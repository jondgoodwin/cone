// A 'main' that returns nothing exits 0. The C runtime takes whatever 'main'
// returns as the process's exit status, so a 'main' returning nothing is
// generated returning 0, at the end of its block and at each 'return'. The last
// call before each return leaves a value that is not 0 where a return value
// would be, so a 'main' that returned nothing in particular would exit with it.

mod module_main_void;

import stdio;

mut quiet = false;

fn main() {
  stdio.print <- "hi\n";
  if quiet {
    return;
  }
  stdio.print <- "bye\n";
}
