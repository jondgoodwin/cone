// A 'main' that takes C's argc and argv is called by the entry with the ones
// the runtime gave it. The runner starts the program with no arguments, so
// argc is 1 (the program's own name), and the 3 it returns is the exit status.

mod module_entry_args;

import stdio use *;

fn main(argc i32, argv **u8) i32 {
  if argc == 1i32 {
    printStr("argc is 1\n");
  }
  else {
    printStr("argc is not 1\n");
  }
  3i32;
}
