// The program: it coerces a Tally to each trait Tally is, so the vtables it
// builds call tq's private methods, which only tq's object defines.

mod prog;

import stdio use *;
import tq;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn labelOf(x &<tq.Named) i64 {
  x.label();
}

fn countOf(x &<tq.Counted) i64 {
  x.count();
}

fn sizeOf(x &<tq.Sized) i64 {
  x.size();
}

fn main() i32 {
  imm t = tq.Tally[9i64];
  show("label", labelOf(&t));
  show("count", countOf(&t));
  show("size", sizeOf(&t));
  0i32;
}
