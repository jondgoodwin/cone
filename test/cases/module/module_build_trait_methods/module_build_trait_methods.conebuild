// A program compiled against the include file package tq's own compile
// generates (include\tq.cone, which cases.toml's 'include' requires to be that
// file byte for byte), and linked with tq's object.

build: debug
output: executable

prog: {
    "main.cone"
    import tq: "include/tq.cone"
    import stdio: "stdio.cone"
}
