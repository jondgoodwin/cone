// Package tq's source. Tally meets each requirement of the traits it is with a
// private method, and a program's vtable for Tally calls each of them, so the
// library exports all three: 'label' for Named, the first trait of its 'is'
// list; 'count' for Counted, the second; and 'size' for Sized, which Tally
// meets because Counted is Sized.

mod tq;

pub trait Named {
  pub fn label(self &) i64;
}

pub trait Sized {
  pub fn size(self &) i64;
}

pub trait Counted is Sized {
  pub fn count(self &) i64;
}

pub struct Tally is Named, Counted {
  pub n i64;
  fn label(self &) i64 {
    n;
  }
  fn count(self &) i64 {
    n + 1i64;
  }
  fn size(self &) i64 {
    n + 2i64;
  }
}
