// A variant and its enum held by value are returned as different aggregates, so the
// variant does not stand for the enum where the trait names it: lift returns a
// Shape.Circle for the trait's Shape.

mod byvalueresult is Runner;      //~ ErrorModTraitMismatch:22 "declares lift, but not with the signature"

import hosts use *;

pub fn lift(n i32) Shape.Circle {
  Shape.Circle(r: n);
}
