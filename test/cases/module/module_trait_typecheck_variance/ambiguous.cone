// Two candidates under inspect, each looser than Runner's and neither of its own
// signature: none is the one that meets it, as for a struct's method.

mod ambiguous is Runner;          //~ ErrorModTraitMismatch:18 "declares inspect, but not with the signature"

import hosts use *;

pub fn inspectRead overload inspect(c &Shape.Circle) i32 {
  c.r;
}

pub fn inspectEnum overload inspect(c &Shape) i32 {
  1;
}
