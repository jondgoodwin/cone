// The types and the module trait the conforming modules beside this one name.
// Every member of Runner is a default, so a conforming module declares just the
// one it differs in.

mod hosts;

pub struct P {
  pub x: i32;
}

pub enum Shape {
  pub struct Circle { pub r: i32; }
  pub struct Square { pub s: i32; }
}

pub mod trait Runner {
  pub fn read(p: &P) i32 { 1 }
  pub fn give(p: &mut P) &mut P { p }
  pub fn count(n: i32) i32 { 1 }
  pub fn hold(s: Shape.Circle) i32 { 1 }
  pub fn lift(n: i32) Shape { Shape.Square(s: n) }
  pub fn edit(s: &mut Shape) i32 { 1 }
  pub fn size(s: &Shape) i32 { 1 }
  pub fn inspect(c: &mut Shape.Circle) i32 { 1 }
}
