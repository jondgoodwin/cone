// Package q's source: the definitions the program links against. Compiled as
// a library, each public definition is exported, and so is each private one an
// inline body names, since the program expands that body in its own object.

mod q;

// Public: exported
pub fn addOne(n i64) i64 {
  n + 1i64;
}

// Private, and named by the public inline 'answer': exported
fn secret() i64 {
  40i64;
}

pub fn answer() i64 inline {
  secret() + 2i64;
}

// A private global named by the public inline 'bump': exported
mut hits i64 = 5i64;

pub fn bump() i64 inline {
  hits = hits + 1i64;
  hits;
}

// A public global: exported
pub mut shared i64 = 100i64;

// A private type named by the public inline 'boxed': its public method is
// exported, since the program's copy of that body calls it
struct Box {
  pub n i64;

  pub fn twice(self) i64 {
    n * 2i64;
  }
}

pub fn boxed(n i64) i64 inline {
  Box[n].twice();
}

// A public type's public method: exported
pub struct Acc {
  pub total i64;

  pub fn plus(self, n i64) i64 {
    total + n;
  }
}

// -------- generics: every object that uses an instance defines it --------

// A generic function. q instantiates it at i64 itself (qLarger), so q's object
// defines 'larger[i64]'; the program instantiates it at i64 too, and defines
// the same instance in its own object, and the linker keeps one of the two.
// Its instance at f64 is the program's alone.
pub fn larger[T](a T, b T) T {
  if a > b {a;} else {b;}
}

// Private, and named by a method of the generic type Pair: exported, since the
// program's instances of that method call it from the program's object
fn unit() i64 {
  1i64;
}

// A generic type with methods, instantiated the same two ways: at i64 by q and
// by the program, at f64 by the program alone
pub struct Pair[T] {
  pub a T;
  pub b T;

  pub fn sum(self) T {
    a + b;
  }

  pub fn count(self) i64 {
    unit() + unit();
  }
}

// A private generic a public one instantiates: the program instantiates both,
// and defines both instances, since q has neither
fn same[T](a T) T {
  a;
}

pub fn kept[T](a T) T {
  same(a);
}

// q's own uses of the i64 instances, called by the program
pub fn qLarger() i64 {
  larger[i64](3i64, 9i64);
}

pub fn qPairSum() i64 {
  Pair[i64][20i64, 22i64].sum();
}

// -------- vtables: every object that coerces a type to a trait builds one --------

pub trait Shape {
  pub fn area(self &) i64;
}

pub struct Square is Shape {
  pub side i64;

  pub fn area(self &) i64 {
    side * side;
  }
}

// Tells a Square by comparing the virtual reference's vtable address with the
// one q's object built for Square as Shape. The program builds that vtable too,
// for the reference it passes here, so the two objects' copies must merge into
// one for the comparison to hold.
pub fn isSquare(s &<Shape) i64 {
  if s is &Square {1i64;} else {0i64;}
}

pub fn areaOf(s &<Shape) i64 {
  s.area();
}
