// The program: every value it prints comes from package q's object, through a
// call, an expanded inline body, or a global.

mod prog;

import stdio use *;
import q;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("addOne", q.addOne(4i64));
  show("answer", q.answer());
  show("bump", q.bump());
  show("bump", q.bump());
  show("shared", q.shared);
  show("boxed", q.boxed(8i64));
  imm acc = q.Acc[3i64];
  show("plus", acc.plus(4i64));
  0i32;
}
