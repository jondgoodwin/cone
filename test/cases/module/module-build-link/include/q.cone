// Package q's include file, written by hand: what the program compiles against
// in place of q's source. Everything q's object defines is declared here with
// 'extern' and no body, and q is a Cone-named module, so each declaration is
// spelled with q's Cone name -- the name q's object exports it under. The
// values the program prints can only have come from q's object, linked in.
//
// An inline body is the exception: the program expands it in its own object, so
// it must be q's own. The private names it reaches -- 'secret', 'hits' and the
// type 'Box' -- are declared here too, and resolve against what q exports.

mod q;

pub extern fn addOne(n i64) i64;

extern fn secret() i64;

pub fn answer() i64 inline {
  secret() + 2i64;
}

extern mut hits i64;

pub fn bump() i64 inline {
  hits = hits + 1i64;
  hits;
}

pub extern mut shared i64;

struct Box {
  pub n i64;

  pub extern fn twice(self) i64;
}

pub fn boxed(n i64) i64 inline {
  Box[n].twice();
}

pub struct Acc {
  pub total i64;

  pub extern fn plus(self, n i64) i64;
}
