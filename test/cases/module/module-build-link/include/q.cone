// Package q's include file, written by hand: what the program compiles against
// in place of q's source. The program only declares what an imported module
// defines, so every body here that is not inline is never generated. Those
// bodies are deliberately wrong (each gives 0): the right answers the program
// prints can only have come from q's own object, linked in.
//
// An inline body is the exception: the program expands it in its own object, so
// it must be q's own. The private names it reaches -- 'secret', 'hits' and the
// type 'Box' -- are declared here too, and resolve against what q exports.
//
// Body-less declarations are not built yet, which is why the bodies are here.

mod q;

pub fn addOne(n i64) i64 {
  0i64;
}

fn secret() i64 {
  0i64;
}

pub fn answer() i64 inline {
  secret() + 2i64;
}

mut hits i64 = 0i64;

pub fn bump() i64 inline {
  hits = hits + 1i64;
  hits;
}

pub mut shared i64 = 0i64;

struct Box {
  pub n i64;

  pub fn twice(self) i64 {
    0i64;
  }
}

pub fn boxed(n i64) i64 inline {
  Box[n].twice();
}

pub struct Acc {
  pub total i64;

  pub fn plus(self, n i64) i64 {
    0i64;
  }
}
