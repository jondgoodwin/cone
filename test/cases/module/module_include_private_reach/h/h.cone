// Package h: a type's private members are its module's, so h's inline body
// reaches a public type's private field and private method, and through that
// field a private type's public and private methods. An importer expands the
// body in its own object, so the include file declares every method it calls,
// the private ones too, and h's object exports them. Neither type holds an
// expanded body of its own: h does, which is what exports their private
// methods.

mod h;

struct Inner {
  pub v i64;
  pub fn get(self) i64 {
    v;
  }
  fn twice(self) i64 {
    v * 2i64;
  }
}

pub struct Outer {
  inner Inner;
  fn tag(self) i64 {
    100i64;
  }
}

pub fn make(v i64) Outer {
  new Outer(new Inner(v));
}

pub fn val(o Outer) i64 inline {
  o.inner.get() + o.inner.twice() + o.tag();
}
