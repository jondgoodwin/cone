// Imported by module_c_name_late_free.cone, and never compiled on its own. Its
// declaration of C's 'free' is private, so an importer declares it only when
// the public inline body naming it is generated there.

mod modulecfree;

extern {
  fn @c free(p *u8);
}

pub fn release(p *u8) inline {
  free(p);
}
