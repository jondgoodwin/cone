// A second generic module, instantiated at a type another module declares
pub mod tally[T];

import seq;
import stdio use *;

pub mut seen i64 = 0i64;
pub imm order i64;

fn @initpure init() {
  order = seq.take();
  printStr("init tally, order ");
  printInt(order);
  printStr("\n");
}

pub fn see(x &T) {
  seen = seen + 1i64;
}
