// A program compiled separately from the package it imports, and linked with
// it. Package q is compiled on its own first (q\q.conebuild, listed under 'link'
// in cases.toml), which writes q's include file, and this program is compiled
// against it: include\q.cone, which the runner requires to be what q's compile
// generated, byte for byte ('include' in cases.toml), and which an import line
// names. The two objects are then linked, with conestd, and the program run.
//
// The printing comes through a second import line, to a file standing for
// stdio's include file, whose C functions conestd supplies.

build: debug
output: executable

prog: {
    "main.cone"
    import q: "include/q.cone"
    import stdio: "stdio.cone"
}
