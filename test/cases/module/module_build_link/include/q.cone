// Package q's include file, written by hand: what the program compiles against
// in place of q's source. Everything q's object defines is declared here with
// 'extern' and no body, and q is a Cone-named module, so each declaration is
// spelled with q's Cone name -- the name q's object exports it under. The
// values the program prints can only have come from q's object, linked in.
//
// An inline body is the exception: the program expands it in its own object, so
// it must be q's own. The private names it reaches -- 'secret', 'hits' and the
// type 'Box' -- are declared here too, and resolve against what q exports.

mod q;

pub extern fn addOne(n i64) i64;

extern fn secret() i64;

pub fn answer() i64 inline {
  secret() + 2i64;
}

extern mut hits i64;

pub fn bump() i64 inline {
  hits = hits + 1i64;
  hits;
}

pub extern mut shared i64;

struct Box {
  pub n i64;

  pub extern fn twice(self) i64;
}

pub fn boxed(n i64) i64 inline {
  Box[n].twice();
}

pub struct Acc {
  pub total i64;

  pub extern fn plus(self, n i64) i64;
}

// A generic cannot be 'extern': the program makes each instance it uses from
// the body, so the include carries the generic function's and the generic
// type's full bodies, q's own. The program defines each instance it uses, as q
// defines the ones it uses; the i64 instances are in both objects and merge at
// link. The private 'unit' a method of Pair names is declared, and resolves
// against what q exports.
pub fn larger[T](a T, b T) T {
  if a > b {a;} else {b;}
}

extern fn unit() i64;

pub struct Pair[T] {
  pub a T;
  pub b T;

  pub fn sum(self) T {
    a + b;
  }

  pub fn count(self) i64 {
    unit() + unit();
  }
}

fn same[T](a T) T {
  a;
}

pub fn kept[T](a T) T {
  same(a);
}

pub extern fn qLarger() i64;

pub extern fn qPairSum() i64;

// A trait and a type that fills it. The program coerces a Square to a Shape,
// and so builds the vtable for the pair, as q's object does.
pub trait Shape {
  pub fn area(self &) i64;
}

pub struct Square is Shape {
  pub side i64;

  pub extern fn area(self &) i64;
}

pub extern fn isSquare(s &<Shape) i64;

pub extern fn areaOf(s &<Shape) i64;
