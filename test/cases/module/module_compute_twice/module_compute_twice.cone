// Two compute entry points of one name, in a module and its submodule: a
// dispatch finds a kernel by its name in the module, so the second made is
// refused (genlgpu.c), here the submodule's.

mod module_compute_twice;

fn @compute(64) bake(inv Invocation, out &mut Array[u32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len { out[i] = 1u32; }
}
