// A stdio package in a folder of packages of its own, which module_package_path
// hands the compiler with '--path'. A '--path' folder is searched before the
// packages folder, so this is the stdio that scenario's 'import stdio' reaches.
// It prints through the same C functions the packages folder's stdio does, and
// offers a function that one has not got.

mod stdio;

pub extern {
  fn @c printStr(str &[]u8);
  fn @c printInt(a i64);
}

pub fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}
