// Swept into module-folder-strayend's module, and deliberately malformed: the
// stray block end stops the global-statement parser before this file's own end
// of file.
//
// The diagnostic is reported at the token that should have followed the file,
// which is the next declaration's first token, so the annotation sits on it.

fn sweptFine(n i64) i64 {
  n;
}

}

fn afterTheStrayBlockEnd(n i64) i64 {   //~ ErrorNoEof:1 "Expected end-of-file"
  n
}
