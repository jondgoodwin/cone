// The program: compiled against the include file loc's compile generated, and
// linked with loc's object. Checked[i64].get is compiled here, from the
// include file's text, and its panic names loc.cone and the line of the call
// there, not the include file's line.

mod prog;

import stdio use *;
import loc;

fn main() {
  imm c = new loc.Checked[i64](7i64);
  printInt(loc.half(c.get(true)));
  printStr("\n");
  printInt(c.get(false));
  printStr("\n");
}
