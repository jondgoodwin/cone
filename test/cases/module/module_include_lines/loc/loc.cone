// Package loc: a generic type whose method panics, reporting where it is. The
// include file leaves out and cuts text above the method, and opens with its
// banner, so its lines are not these; its line marks say which lines of this
// file its text is, and the panic names this file and the line of its call.

mod loc;

// Private, and nothing reaches it: left out of the include file
fn unused(x i64) i64 {
  x + 1;
}

// Public, its body left behind: cut to one line
pub fn half(x i64) i64 {
  imm h = x / 2;
  h;
}

// A generic type's method travels whole, and the program compiles it
pub struct Checked[T] {
  pub v T;

  pub fn get(self, ok Bool) T {
    if !ok {panic("Checked.get: not ok");}
    v;
  }
}
