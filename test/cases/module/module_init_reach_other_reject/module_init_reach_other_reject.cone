// What 'init' reads through a generic instance of another module is read as
// its own: another module's generic function, instanced with this module's
// type, calls the type's 'get', which reads 'ga' before 'init' has set it; and
// so does a method of another module's generic type's instance, with a type
// whose 'get' reads 'gb'. The same calls after the sets are accepted.
//
// This is the designated file of the scenario's folder; 'helper.cone' is a
// one-file submodule opening with 'mod'.

mod module_init_reach_other_reject;

import stdio use *;

pub struct P {
  pub x: i64;
  pub fn get(self: &P) i64 { ga }
}

pub struct Q {
  pub x: i64;
  pub fn get(self: &Q) i64 { gb }
}

let a: i64;
let b: i64;
let c: i64;
let d: i64;
let ga: i64;
let gb: i64;

fn @initpure init() {
  a = helper.call[P](&P(0i64));                      //~ ErrorMove "reads global ga, in get"
  b = helper.Holder[Q](10i64).run(&Q(0i64));         //~ ErrorMove "reads global gb, in get"
  ga = 41i64;
  gb = 42i64;
  c = helper.call[P](&P(0i64));
  d = helper.Holder[Q](10i64).run(&Q(0i64));
}

fn main() i32 {
  printInt(a + b + c + d);
  0i32
}
