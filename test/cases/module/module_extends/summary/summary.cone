// An importer that folds the extending module's names in with 'use *'. The
// aliases 'extends' made are public names of solids, so the wildcard carries
// them across like anything solids declares itself.

mod summary;

import solids use *;

pub fn both() i64 {
  area(4i64, 5i64) + volume(1i64, 1i64, 1i64) + corner().sum();
}
