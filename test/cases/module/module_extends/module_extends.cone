// ONE MODULE REUSING ANOTHER: 'mod solids extends shapes'.
//
// A module that extends another takes in the other's declarations and what the
// other's 'use' clauses folded in, private ones included, and adds its own; what
// its importers see is the other's public names and its own. The other's imports
// are its dependencies, not its contents, so the name an import binds to its
// module does not come across. For a module, extending and inheriting are one thing: a module's
// state is static -- one instance, at a fixed address -- so what 'extends' makes
// is an alias per name, and the declaration, its symbol and its state stay the
// base's. That is why a global changed through one module's name is seen through
// the other's.
//
// It RUNS, because every module here is a submodule of this root and is compiled
// into this one object.
//
// The folder holds:
//   base/base.cone        the bottom of the chain, with a private function
//   shapes/shapes.cone    extends base; a function, a type, a global, a private function and global, and an import of tools folding one name in
//   solids/solids.cone    extends shapes, imports tools itself, and adds its own
//   tools/tools.cone      a module shapes and solids each import
//   report/report.cone    imports solids and reaches shapes' names through it by path
//   summary/summary.cone  imports solids with 'use *' and reaches them bare

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // Through the extending module, by path: its own name, and the base's
  show("own", solids.volume(2i64, 3i64, 4i64));
  show("base-fn", solids.area(6i64, 7i64));
  show("chain", solids.unit());
  mut p = solids.corner();
  show("base-type", p.sum());

  // One global, whichever module's name reaches it
  shapes.bump();
  show("base-global", solids.count);
  solids.count = 20i64;
  show("same-global", shapes.count);

  // Inside solids, the bases' private names: shapes' function and global, and
  // base's function two links down. The private global solids changed is the
  // one shapes reads
  show("base-private", solids.inside());
  show("same-private-global", shapes.hiddenNow());

  // Inside solids, what shapes' import folded in, and solids' own import of the
  // module shapes imports: 12 + 5 + 3 = 20
  show("base-fold", solids.borrowed());

  // Through modules that import the extending one
  show("importer", report.total());
  show("importer-type", report.origin().sum());
  show("wildcard", summary.both());
  0i32;
}
