// A module that EXTENDS another: every declaration of shapes, and every name
// shapes folded in, is a name of this module, public where shapes shows it and
// private where shapes keeps it, and it adds its own beside them.
//
// shapes is a sister, reached through the registry the parent is -- the same
// lookup an import of her makes, and nothing is loaded. Nothing binds her name
// here: 'extends' brings her names in, not her.

mod solids extends shapes;

// shapes imports tools too, and that import binds 'tools' for shapes alone: a
// module's imports are its dependencies, not its contents. This module states its
// own. module-extends-nameres pins the name refused without this import
import tools;

// shapes' function, type and global, each by its bare name, and base's function,
// which shapes took from base
pub fn volume(w i64, h i64, d i64) i64 {
  area(w, h) * d * unit();
}

pub fn corner() Point {
  Point[count, 2i64];
}

// shapes' private function and global, and base's private function, which
// shapes took from base: each a name of this module, private here as there
pub fn inside() i64 {
  hidden = hidden + 1i64;
  secret() + hidden + deep();
}

// 'tripled' is what shapes' import folded in, a private name of shapes, so a
// private name of this module; 'tools' is this module's own import
pub fn borrowed() i64 {
  tripled(4i64) + tools.halved(10i64) + scaled(2i64);
}
