// A module that reaches its sisters by importing them, and then asks a standalone
// 'use' to fold what the imports reached. An imported module's names are folded
// by its import's own clause, so each is refused, and so is a 'use' of this
// module itself.

mod reader;

import lib;
import facade;

// One spelling per situation: 'import lib use ...' is how lib's names fold here
use lib;                    //~ ErrorUseImported:5 "lib is imported into this module"

// A path whose first step is an import reaches through it too
use facade.inner;           //~ ErrorUseImported:12 "inner is reached through facade, which is imported into this module"

// A module's own names are its already
use reader;                 //~ ErrorModReach:5 "reader is this module"
