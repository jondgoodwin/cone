// '&fn @c (...)' is the type of a reference to a C-named function and '&fn
// (...)' the type of a reference to a Cone function, and each is used here on
// its own side: called, passed, returned and held in a struct's field. A
// type's '@c' method keeps Cone's convention (a vtable calls it by its Cone
// signature), so a reference to it is a plain '&fn'. The refusals, where one is
// given for the other, are module_c_fnref_reject; what a C-named function
// passes and returns across to C is module_c_byvalue.
mod module_c_fnref;
import stdio use *;

struct Vec3 { pub x: f32; pub y: f32; pub z: f32; }

// A C-named function: the C ABI's convention, and the type '&fn @c (...)'
fn @c cfun(v: Vec3) f32 { v.x * 10. }
// A Cone function: Cone's own, and '&fn (...)'
fn cone(v: Vec3) f32 { v.y }

struct Counter {
  pub n: i32;
  // A C name, but a method: called by its Cone signature
  pub fn @c bump(k: i32) i32 { k + 1 }
}

struct Holder {
  pub viaC: &fn @c (Vec3) f32;
  pub viaCone: &fn(Vec3) f32;
}

fn callC(f: &fn @c (Vec3) f32, v: Vec3) f32 { f(v) }
fn callCone(f: &fn(Vec3) f32, v: Vec3) f32 { f(v) }
fn pickC() &fn @c (Vec3) f32 {
  &cfun
}
fn pickCone() &fn(Vec3) f32 {
  &cone
}

fn show(label: &str, n: i64) {
  printStr(label); printStr(" "); printInt(n); printStr("\n");
}

fn main() {
  let v = Vec3(1., 2., 3.);
  show("callC", i64.from(callC(&cfun, v)));
  show("callCone", i64.from(callCone(&cone, v)));
  let c = pickC();
  show("pickC", i64.from(c(Vec3(2., 0., 0.))));
  let p = pickCone();
  show("pickCone", i64.from(p(Vec3(0., 5., 0.))));

  let h = Holder(&cfun, &cone);
  show("holder viaC", i64.from((h.viaC)(v)));
  show("holder viaCone", i64.from((h.viaCone)(v)));

  // A method's reference is a plain '&fn', whatever its name
  let m: &fn(k: i32) i32 = &Counter.bump;
  show("bump", i64.from(m(7)));
}
