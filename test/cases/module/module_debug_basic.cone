// The debug form of a value, generated when a call asks: field names, the variant's name,
// quoted and escaped text. A type that wrote its own toDebug keeps it, and a generated
// one calls it for a field of that type. The wrapper toDebug(x) asks for it.

mod module_debug_basic;

import stdio use *;
import collections use *;

struct Point {
  x: i32;
  y: i32;
}

struct Segment {
  from: Point;
  to: Point;
  label: String;
  hidden: i32;
}

enum Shape {
  struct Circle { radius: i32; }
  struct Rect { w: i32; h: i32; }
  struct Dot;
}

struct Odd {
  n: i32;
  pub fn toDebug(self: &, out: &uni TextOut) {
    out <- "Odd#", self.n;
  }
}

struct Holder {
  odd: Odd;
  flag: bool;
  c: char;
  f: f64;
}

fn main() {
  let p = Point(1, 2);
  print <- toDebug(&p), "\n";
  let seg = Segment(Point(3, 4), Point(5, 6), String() <- "a \"b\"\n", 7);
  print <- toDebug(&seg), "\n";
  let c: Shape = Shape.Circle(3);
  print <- toDebug(&c), "\n";
  let r: Shape = Shape.Rect(4, 5);
  print <- toDebug(&r), "\n";
  let d: Shape = Shape.Dot;
  print <- toDebug(&d), "\n";
  let h = Holder(Odd(9), true, 'x', 1.5);
  print <- toDebug(&h), "\n";
  let h2 = Holder(Odd(0), false, '\n', 0.25);
  print <- toDebug(&h2), "\n";
  let t = (1, "two", 'c');
  print <- toDebug(&t), "\n";
}
