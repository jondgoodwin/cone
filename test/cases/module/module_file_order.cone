// WHETHER A TYPE MEETS A TRAIT DOES NOT DEPEND ON WHICH FILE DECLARES IT. The
// package fileorder (found by '--path=test/cases/module/modulefileorder') has a
// struct in holder.cone that makes an 'AnyError' from a type declared in
// later.cone, which the sweep reaches afterwards. Type check reaches the
// type's methods first, so the conformance (its 'message' method meeting the
// trait's slot) has to demand them rather than find them unchecked: it was
// refused as a type that does not match 'Error' (Bug 28, found in deflate).

mod module_file_order;

import stdio use *;
import fileorder;

fn main() i32 {
  printStr("message-length = ");
  printInt(fileorder.messageLength());
  printStr("\n");
  0i32
}
