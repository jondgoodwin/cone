// A file beside the package's source root, swept into the package's root
// module by being in src. It has no 'mod' line, and so no imports: every import
// of the module is in its designated file.

fn vecSecret() i64 {
  20i64;
}

// The designated file's declarations are in scope here too
pub fn fromSibling() i64 {
  fromRoot() * 2i64;
}
