// A package laid out for Congo, found on the package search path: its source
// root, src/pkgfiles.cone, is the designated file of its src folder, the
// package's name standing in for the folder's. So src is swept as any module
// folder is: vec.cone beside this file and shapes/area.cone beneath it are this
// module's files, half.cone opens with its own 'mod' line and is a one-file
// submodule, and scale/ holds its own designated file and draws a submodule.
// Nothing here lists them.

mod pkgfiles;

// Calls a private function of vec.cone: one module, one namespace, whichever
// file a name was written in
pub fn fromRoot() i64 {
  vecSecret() + 1i64;
}
