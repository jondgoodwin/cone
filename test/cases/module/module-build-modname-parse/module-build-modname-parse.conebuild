// Each file's 'mod' line is checked against the build description: the module
// the description lists the file in, or, for a file an import line names, the
// import's name. The description is what names a described module, so a line
// naming another is a file in the wrong place, wherever in its module's list
// the file sits.

output: library

q: {
    "src/q.cone"
    "src/second.cone"
    "src/third.cone"
    import dep: "dep.cone"
    kid: {
        "src/kid.cone"
    }
}
