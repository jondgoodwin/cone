// Imported by module-inline-private.cone, and never compiled on its own, so it
// is listed in cases.toml as a support module.
//
// Public inline functions whose bodies name what the module keeps private: a
// function, a global, and a method of a private type -- plain, generic, and
// taken by address. An inline body is generated in each caller, so the importer
// needs a symbol for each private name it reaches. 'unreached' is private and
// named by no public body, so the importer still has no reason to declare it.
//
// Its name carries no '-' because a module's name is also its qualifier.

fn helper() i32 {
  7i32;
}

fn unreached() i32 {
  8i32;
}

mut count i32 = 3i32;

struct Hidden {
  pub n i32;
  pub fn get(self) i32 {
    n + 1i32;
  }
}

pub fn viaHelper() i32 inline {
  helper();
}

pub fn viaGeneric[T](x T) T inline {
  helper();
  x;
}

pub fn viaGlobal() i32 inline {
  count;
}

pub fn viaGlobalRef() &i32 inline {
  &count;
}

pub fn viaFnRef() &fn() i32 inline {
  &helper;
}

pub fn viaHiddenType() i32 inline {
  Hidden[4i32].get();
}
