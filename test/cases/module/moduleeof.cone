// Included by module-include-eof.cone, and deliberately malformed: the stray
// block end stops the global-statement parser before the file's own end of
// file, which is what makes 'include' report ErrorNoEof.
//
// Listed in cases.toml as a support module.

fn includedFine(n i64) i64 {
  n
}

}

fn afterTheStrayBlockEnd(n i64) i64 {
  n
}
