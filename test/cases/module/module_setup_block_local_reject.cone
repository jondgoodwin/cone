// A 'let' global's value may be a block that declares locals started by any value (the
// module_setup_block_locals case: the setup that runs the block holds them). What a block
// cannot do is give a 'var' global its value, which is a literal's alone: the report is made
// once, at the global, and not also at the block's local. A parameter's default that is not
// a literal keeps its own wording.

mod module_setup_block_local_reject;

fn one() i64 { 1i64 }

let ok: i64 = { let y = one(); y + 1i64 };

var c: i64 = { let y = one(); y + 1i64 };                  //~ ErrorNotLit "Variable may only be initialized with a literal value"

fn withDefault(x: i64 = one()) i64 { x }                 //~ ErrorNotLit "Variable may only be initialized with a literal value"
