// A 'let' global's value may be a block, but the block cannot declare a local
// that is computed: a local is no global, so it is not lifted into a setup, and
// only a constant can start it there. The report says that, and that a function
// does the job, rather than naming the local as if it were the fault. (A local
// started by a constant is fine, as it always was.) A 'var' global's block is
// refused the same at its local, and again at the global, which is a literal
// value's alone. A parameter's default that is not a literal keeps the old wording.

mod module_setup_block_local_reject;

fn one() i64 { 1i64 }
fn some() Option[i64] { Some(3i64) }

let ok: i64 = { let y = 5i64; y + 1i64 };

let a: i64 = { let y = one(); y + 1i64 };                  //~ ErrorNotLit "cannot declare a local that is computed at run time"
let b: i64 = { let z = 2i64; let w = one(); w + z };       //~ ErrorNotLit "Put the work in a function, which can declare locals"

var c: i64 = { let y = one(); y + 1i64 };
                                                           //~^ ErrorNotLit "cannot declare a local that is computed at run time"
                                                           //~^^ ErrorNotLit "Variable may only be initialized with a literal value"

// The hidden variable of an 'if let' is a computed local too: only a '?' is left to its own report
let d: i64 = if let Some(x) = some() { x } else { 0i64 };  //~ ErrorNotLit "cannot declare a local that is computed at run time"

fn withDefault(x: i64 = one()) i64 { x }                 //~ ErrorNotLit "Variable may only be initialized with a literal value"
