// A folder submodule beside the one-file ones. Its folder is swept like any
// module folder's, so ast.cone -- which opens with 'mod' -- is a one-file
// submodule of this module rather than one of its files.

mod parser;

// A sister that is one file is imported by name like any sister
import lexer;

pub fn parse(n i64) i64 {
  lexer.scan(n) + ast.depth();
}
