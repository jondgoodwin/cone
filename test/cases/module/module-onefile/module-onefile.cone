// A ONE-FILE MODULE: a file of a module's folder whose first statement is a
// 'mod' declaration is a submodule of its own, in every respect the submodule a
// subfolder draws [Jon 23 Sep]. A folder is only worth its ceremony when a module
// has more than one file.
//
// This is the designated file of the scenario's folder, so it is the root module
// and its folder is swept. What the sweep does with each file is read off that
// file's first statement: helper.cone opens with none and joins this module;
// lexer.cone and tokens.cone open with 'mod' and are modules of their own.
//
// module-onefile-grown is this scenario with lexer.cone moved to lexer/lexer.cone
// and parser/ast.cone to parser/ast/ast.cone, and nothing else changed: the same
// program, the same output and the same symbols, because growing a module from a
// file into a folder changes nothing for anyone who names it.
//
// The folder holds:
//   helper.cone          no 'mod': swept into this module
//   lexer.cone           'mod lexer', private, importing its sister tokens
//   tokens.cone          'mod tokens', private
//   parser/parser.cone   a folder submodule, importing its sister lexer
//   parser/ast.cone      'pub mod ast', a one-file submodule of parser

import stdio use *;

// A standalone 'use' of a one-file submodule folds its public names in, exactly
// as it folds a folder submodule's
use lexer;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // A file with no 'mod' is this module's own, as it always was
  show("swept-file", helperAdd(2i64, 3i64));

  // A one-file submodule reached by path. 'lexer' is private to this module,
  // which does not stop this module naming it: a parent is inside
  show("by-path", lexer.scan(4i64));

  // The same function, folded in by the 'use' above
  show("folded-by-use", scan(5i64));

  // A folder submodule whose import of its sister reaches a one-file module
  // through this module's registry, and whose own one-file child it calls
  show("sister-import", parser.parse(2i64));

  // Two hops, the second into a one-file module written 'pub', which is what
  // lets this module -- its grandparent, not its parent -- name it
  show("pub-grandchild", parser.ast.depth());

  // A one-file module that another one-file module imported, reached by path
  show("imported-sister", tokens.weight(7i64));
  0i32;
}
