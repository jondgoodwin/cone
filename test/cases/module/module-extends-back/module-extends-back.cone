// A module importing, with 'use *', a module that EXTENDS it.
//
// The extending module's public names include an alias for every public name of
// the module it extends, so a wildcard import of it carries those names back
// home. They are the importer's own declarations under their own names, and a
// star clause passes them over rather than calling each one a duplicate.
//
// It is here twice, in both orders, because the order is the point: which of the
// two modules has its folds run first decides whether the extending module holds
// the aliases yet when the importer reads it. The program compiles, and means the
// same, either way.
//
// The folder holds:
//   base/base.cone     imports rich with 'use *'; folded before rich
//   rich/rich.cone     extends base
//   alpha/alpha.cone   extends omega; folded before omega
//   omega/omega.cone   imports alpha with 'use *'

import stdio.*;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("importer-first", base.useRich());
  show("extender-first", omega.useAlpha());
  0i32;
}
