// A star clause folds both's public names but its 'init' and 'final', so 'work'
// is here by its bare name and a bare 'init' names nothing. Leaving either out
// with 'but' is refused: there is nothing to leave out.

mod stars;

import both use * but init, final;  //~ ErrorBadFold:23 "init belongs to both's own lifecycle, so '*' never folds it; there is nothing to leave out"
                              //~^ ErrorBadFold:29 "final belongs to both's own lifecycle, so '*' never folds it; there is nothing to leave out"

fn viastar() i64 {
  init();                   //~ ErrorUnkName:3 "does not refer to a declared name"
  work()
}
