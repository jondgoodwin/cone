// A module naming its own 'init' and 'final': the program runs each once, so a
// call anywhere would run it twice. The bare name, a path through the module's
// own name, and a borrow are all refused.

mod inside;

let seed: i64;

pub fn @initpure init() {
  seed = 3i64;
}

pub fn final() {
}

fn again() {
  init();                   //~ ErrorLifecycleNamed:3 "init is a module's lifecycle function"
  final();                  //~ ErrorLifecycleNamed:3 "final is a module's lifecycle function"
  inside.final();           //~ ErrorLifecycleNamed:10 "final is a module's lifecycle function"
  let borrowed = &final;    //~ ErrorLifecycleNamed:19 "final is a module's lifecycle function"
}
