// A module's 'init' and 'final' are run by the program, once each, and are not
// named: a call, a borrow, or any other use of one by its path is refused
// (ErrorLifecycleNamed), whether the module made it public or not -- a private
// one is not made callable by being public -- and a fold does not carry it away.
// The declaration stays legal either way: both's are 'pub'.
//
// Name-resolution stage. The folder holds:
//   both/both.cone       a public 'init' and 'final', and a public 'work'
//   hidden/hidden.cone   a private 'init' and 'final'
//   inside/inside.cone   a module naming its own: bare, by its own path, borrowed
//   folds/folds.cone     a list clause naming them
//   stars/stars.cone     a star clause leaving them out, and a 'but' naming them

mod module_lifecycle_named_nameres;

fn reach() i64 {
  both.init();              //~ ErrorLifecycleNamed:8 "init is a module's lifecycle function: a module's init and final are run by the runtime, once, and may not be called, borrowed or named"
  both.final();             //~ ErrorLifecycleNamed:8 "final is a module's lifecycle function"
  let borrowed = &both.final;  //~ ErrorLifecycleNamed:24 "final is a module's lifecycle function"
  hidden.init();            //~ ErrorLifecycleNamed:10 "init is a module's lifecycle function"
  hidden.final();           //~ ErrorLifecycleNamed:10 "final is a module's lifecycle function"

  // The module's other public functions are reached as ever
  both.work()
}
