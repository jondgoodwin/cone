// A module's 'init' and 'final' belong to it: a fold does not carry either to
// another module, so a bare 'init()' here could never mean both's. A list naming
// one is refused, as is a 'but' leaving one out of a star, which passes both over
// of its own accord and still folds the rest.

mod folds;

import both use
  init,                     //~ ErrorBadFold:3 "init belongs to both's own lifecycle, so it does not fold"
  final,                    //~ ErrorBadFold:3 "final belongs to both's own lifecycle, so it does not fold"
  work as bothwork;

fn viafold() i64 {
  bothwork()
}
