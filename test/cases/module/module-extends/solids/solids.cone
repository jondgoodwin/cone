// A module that EXTENDS another: every name of shapes is a name of this module,
// public where shapes shows it and private where shapes keeps it, and it adds its
// own beside them.
//
// shapes is a sister, reached through the registry the parent is -- the same
// lookup an import of her makes, and nothing is loaded. Nothing binds her name
// here: 'extends' brings her names in, not her.

mod solids extends shapes;

// shapes' function, type and global, each by its bare name, and base's function,
// which shapes took from base
pub fn volume(w i64, h i64, d i64) i64 {
  area(w, h) * d * unit();
}

pub fn corner() Point {
  Point[count, 2i64];
}

// shapes' private function and global, and base's private function, which
// shapes took from base: each a name of this module, private here as there
pub fn inside() i64 {
  hidden = hidden + 1i64;
  secret() + hidden + deep();
}
