// A module shapes IMPORTS, folding one name in. The fold is a part of shapes, so
// it reaches solids; the import itself is a dependency of shapes, so the name
// 'tools' does not, and solids names tools only by importing it too.

mod tools;

pub fn tripled(n i64) i64 {
  n * 3i64;
}

pub fn halved(n i64) i64 {
  n / 2i64;
}
