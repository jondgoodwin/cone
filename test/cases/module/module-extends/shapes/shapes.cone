// The module solids extends: a function, a type and a global, each public, and
// one name kept private.
//
// It extends base in turn, so what it shows includes base's public names.

mod shapes extends base;

pub fn area(w i64, h i64) i64 {
  w * h * unit();
}

pub struct Point {
  pub x i64;
  pub y i64;

  pub fn sum(self) i64 {
    x + y;
  }
}

// One instance, and it stays this module's: solids reaches it through an alias,
// so a change made through either name is seen through the other
pub mut count = 10i64;

pub fn bump() {
  count = count + 1i64;
}

// Private, and solids reaches both: a module that extends this one is inside its
// boundary, as an enriching type is inside its base's. They are private in
// solids too, so no importer of solids reaches them; module-extends-nameres
// pins that
fn secret() i64 {
  7i64;
}

mut hidden = 5i64;

pub fn hiddenNow() i64 {
  hidden;
}
