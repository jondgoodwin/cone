// The bottom of a chain of 'extends': shapes extends this module, and solids
// extends shapes. What shapes took from here is a public name of shapes, so it
// reaches solids too -- transit, by the same rule an import's re-export follows.

mod base;

pub fn unit() i64 {
  1i64;
}

// Private, and it still reaches solids: shapes takes it as a private name of its
// own, and solids takes every name shapes has
fn deep() i64 {
  100i64;
}
