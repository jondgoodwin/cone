// An importer of the module that extends: what it sees through solids is
// solids' whole surface, shapes' public names among them, reached by path.

mod report;

import solids;

pub fn total() i64 {
  solids.area(2i64, 3i64) + solids.volume(1i64, 2i64, 3i64) + solids.count;
}

pub fn origin() solids.Point {
  solids.Point[0i64, 5i64];
}
