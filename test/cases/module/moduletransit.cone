// The middle module of the load-order case: it folds modulesub's public names
// into itself with a wildcard import, and declares one name of its own.
// Imported by module-nameres-transit.cone, module-transit.cone (through
// modulelate.cone) and moduleearly.cone, and never compiled on its own, so it
// is listed in cases.toml as a support module.
//
// What the scenarios ask is whether 'moduletransit::plain' -- a name this
// module holds only by folding -- can be reached from another module, and the
// answer today depends on which module was loaded first. See
// module-nameres-transit.cone.
//
// Its name carries no '-' because a module's name is also its qualifier.

import modulesub::*;

// A name of this module's own, reachable through the qualifier from anywhere:
// it is in the namespace from parse time, not from the fold
fn midOwn(n i64) i64 {
  plain(n) * 10i64;
}
