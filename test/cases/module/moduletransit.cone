// The middle module of the transit case: it folds modulesub's public names into
// itself with a wildcard import and RE-EXPORTS them, and declares one name of
// its own. Imported by module_transit.cone -- directly, and through both
// moduleearly.cone and modulelate.cone -- and never compiled on its own, so it
// is listed in cases.toml as a support module.
//
// What the scenarios ask is whether 'moduletransit.plain', a name this module
// holds only by folding, can be reached from another module. The answer is the
// 'pub' below and nothing else: transit is not a rule of its own, it is the
// visibility rule read on the binding the fold made. modulehide.cone is this
// file with the 'pub' left off, and its folded names are reachable from nowhere.
//
// Its name carries no '-' because a module's name is also its qualifier.

mod moduletransit;

pub import modulesub use *;

// A name of this module's own, reachable through the qualifier from anywhere:
// it is in the namespace from parse time, not from the fold
pub fn midOwn(n i64) i64 {
  plain(n) * 10i64;
}
