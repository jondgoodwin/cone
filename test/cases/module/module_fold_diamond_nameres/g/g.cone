// One method of one type, folded through two globals. The declaration is the
// same, but each binding is reached through its own global, so 'area' would be
// two things: which global's area is a call of it?

mod g;

struct Panel {
  w i64;
  h i64;

  pub fn area(self) i64 {
    w * h;
  }
}

mut first Panel = new Panel(1i64, 2i64) use area;
mut second Panel = new Panel(3i64, 4i64) use area;
                                      //~^ ErrorDupName:46 "area is already a name of this module"
