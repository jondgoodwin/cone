// A program that never imports the format package carries none of it: the optimized IR of
// a send of a number, text and a value with its own 'toText' holds no symbol of the
// number wrappers. Compiled as a library so the public function stays.

mod module_text_noformat;

import stdio use *;

struct Point {
  pub x: i32;
  pub y: i32;
  pub fn toText(self: &, out: &uni TextOut) { out <- "(", self.x, ",", self.y, ")"; }
}

pub fn show(p: &Point, n: u64, s: &str) {
  print <- "point ", p, " n=", n, " s=", s, "\n";
}
