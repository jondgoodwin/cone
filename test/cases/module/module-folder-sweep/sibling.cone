// A sibling of the designated file, swept into the module by being in its
// folder. It declares no module: the folder is what draws the box, and this file
// simply belongs to it.

fn siblingAdd(n i64) i64 {
  n + 100i64;
}

mut siblingTotal = 7i64;

// The designated file's declarations are in scope here: one module, one
// namespace, whichever file a name was written in
fn siblingDoubles(n i64) i64 {
  twice(n);
}
