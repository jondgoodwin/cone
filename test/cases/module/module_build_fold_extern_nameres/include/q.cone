// q's include file. An 'extern' global's fold reads the global's declared type,
// so where that type is not in view the fold is refused as the type is, once,
// where the type is written; and what a fold refuses on a global with a value it
// refuses on an 'extern' one too.

mod q;

import other;

// A type in view: accepted
pub extern mut @threadlocal fine other.Shown pub use width;

// A type no declaration here or in other names
pub extern mut @threadlocal gone Missing use *;              //~ ErrorUnkName

// A type other declares privately
pub extern mut @threadlocal hidden other.Secret use depth;   //~ ErrorNotPublic

// Not a struct, so there is nothing to fold
pub extern mut @threadlocal count i64 use *;                 //~ ErrorUseGlobal

// A 'pub use' fold through a private global
extern mut @threadlocal inner other.Shown pub use width as innerWidth;   //~ ErrorNotPublic
