// A program built from a build description, and run. 'output: executable' leaves
// the root unnamed in its symbols, so 'main' is the C entry point the linker
// wants, while the description still names the module, 'prog', and checks each
// file's 'mod' line against it.
//
// The printing comes through an import line: 'import stdio' is found where the
// line says, in a one-file module standing for stdio's include file. It only
// declares, and its 'extern' functions are supplied by conestd at link.

build: debug
output: executable

prog: {
    "src/main.cone"
    "src/helpers.cone"
    import stdio: "stdio.cone"
    calc: {
        "src/calc.cone"
        import stdio: "stdio.cone"
    }
}
