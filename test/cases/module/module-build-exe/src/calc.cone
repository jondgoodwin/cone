// Module prog's child 'calc'. Its import of stdio is its own, found where its
// own import line says; the file the line names is the one prog's names, so it
// is one module, read once.

pub mod calc;

import stdio;

pub fn square(n i64) i64 {
  n * n;
}

pub fn cube(n i64) i64 {
  stdio.printStr("cubing\n");
  n * square(n);
}
