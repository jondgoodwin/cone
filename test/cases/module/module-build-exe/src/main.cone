// The program's first listed file, declaring the module the build description
// names.

mod prog;

import stdio use *;

// It returns its exit status: built 'debug', the output is not optimised, and a
// 'main' returning nothing leaves whatever the last call left as the status
fn main() i32 {
  show("helper", helper(4i64));
  show("calc", calc.square(7i64));
  show("calc-cube", calc.cube(2i64));
  0i32;
}
