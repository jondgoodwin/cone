// What a module trait's declaration and a 'mod' line's 'is' refuse as they are
// written.
//
// A module trait holds functions and globals, each a requirement or a default,
// and nothing else: a type it would require is not built, and an import, a type
// or anything else a module holds is not something a module conforms to. A member
// is one name with one signature for a module to match, so a generic function and
// an overload name are refused too, and a name written twice. A marker trait,
// with no body, is accepted.
//
// Parse stage. Each 'is' is written on a 'mod' line, and a module declares itself
// once, so each needs a module of its own: the one-file modules beside this file.
//   pathed.cone     'is' naming a trait by a path
//   listed.cone     'is' naming two traits
//   backward.cone   'is' written before 'extends'
//   uselate.cone    the 'use' written before 'is'
//   unnamed.cone    'is' naming nothing

mod module_trait_parse;

mod trait Refused {
  struct Inner {               //~ ErrorModTraitBody "functions and globals"
    x i32;
  }
  import stdio;                //~ ErrorModTraitBody "functions and globals"
  fn mapped[T](x T) T;         //~ ErrorModTraitBody "cannot be generic"
  fn go overload going() i64;  //~ ErrorModTraitBody "no overload name"
  pub fn kept() i64;
  pub fn kept() i64;           //~ ErrorDupName "already a member of module trait Refused"
}

mod trait Marker;

mod trait;                     //~ ErrorNoName "a name for the module trait"

// A declaration after the last refusal, so that recovery is shown to land back on
// the global statement stream rather than swallowing the rest of the file.
fn tail() i64 {
  2i64;
}
