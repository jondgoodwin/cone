// A generic instance used by two packages and named by the program too. Package g
// (a generic module) and packages q and q2 (which both use g[i64]) are compiled
// on their own, then the program; each init and final of g[i64] runs once.

build: debug
output: executable

import g: "include/g.cone"
import q: "include/q.cone"
import q2: "include/q2.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import g: "include/g.cone"
    import q: "include/q.cone"
    import q2: "include/q2.cone"
    import stdio: "stdio.cone"
}
