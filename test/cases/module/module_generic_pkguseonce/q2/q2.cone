// Package q uses g[i64]; nothing in the program's source names it.

mod q2;

import stdio use *;
import g;

fn @initpure init() {
  printStr("q2 init\n");
}

fn final() {
  printStr("q2 final\n");
}

pub fn addTwice(n: i64) i64 {
  g[i64].add(n);
  g[i64].add(n)
}

pub fn inits() i64 {
  g[i64].inits
}
