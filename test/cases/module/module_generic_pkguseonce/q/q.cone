// Package q uses g[i64]; nothing in the program's source names it.

mod q;

import stdio use *;
import g;

fn @initpure init() {
  printStr("q init\n");
}

fn final() {
  printStr("q final\n");
}

pub fn addTwice(n: i64) i64 {
  g[i64].add(n);
  g[i64].add(n)
}

pub fn inits() i64 {
  g[i64].inits
}
