// Each init and final runs once. Packages q and q2 both use g[i64], and the
// program names it too: three users of one instance, built three times and
// merged at link, and run once by the stitched init: g init, q init, q2 init.
// The finals run in reverse: q2, q, g. The counts and the one total show the
// instance is one.

mod prog;

import stdio use *;
import g;
import q;
import q2;

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("q.addTwice", q.addTwice(5i64));
  show("q2.addTwice", q2.addTwice(1i64));
  show("g[i64].add", g[i64].add(100i64));
  show("q.inits", q.inits());
  show("q2.inits", q2.inits());
  show("g[i64].inits", g[i64].inits);
  0i32
}
