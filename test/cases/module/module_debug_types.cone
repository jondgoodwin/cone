// A debug build describes enums, fixed arrays and nested structs to a debugger. An enum
// whose arms hold nothing is an enumeration type of its tag's integer, with every arm's
// name and number. An enum whose arms hold values is a struct of the enum's name holding
// its tag (that enumeration) and a union of a struct per arm that holds something, each
// named for its arm, its members at the offsets the code generator laid them out at. A
// fixed array is an array type of its elements' type. A struct holding any of these, or
// another plain struct, is described with them as members; a member of a type not
// described is left out, the size unchanged. A generic enum is named with its arguments.

mod module_debug_types;

enum Lamp {
  Red;
  Green;
  Blink;
}

enum Shape {
  Dot;
  struct Circle {pub radius: i32;}
  struct Rect {pub w: i32; pub h: i64;}
}

struct Inner {
  pub a: i16;
  pub b: i64;
}

struct Outer {
  pub inner: Inner;
  pub lamp: Lamp;
  pub grid: Array[i32, 4];
  pub maybe: Option[i64];
  pub name: &str;
  pub last: u8;
}

enum Pending[T] {
  Waiting;
  Done(T);
}

fn pointer(p: Option[*i32], w: Pending[i64]) i64 {
  let again = p;
  let wait = w;
  7
}

fn pick(lamp: Lamp, shape: Shape) i64 {
  let some: Option[i64] = Some(7);
  let nothing: Option[i64] = None;
  let inner = Inner(1, 2);
  let outer = Outer(inner, lamp, [1, 2, 3, 4], some, "x", 9);
  let grid = [10, 20, 30];
  let other = Outer(inner, Lamp.Green, [5, 6, 7, 8], nothing, "y", 3);
  match shape {
    case is Dot {0}
    case let Circle(c) {i64.from(c.radius)}
    case let Rect(r) {r.h + i64.from(outer.last + other.last) + i64.from(grid[1])}
  }
}

fn main() {
  let r = pick(Lamp.Blink, Shape.Rect(2, 5));
  let p = pointer(None, Pending.Waiting);
}
