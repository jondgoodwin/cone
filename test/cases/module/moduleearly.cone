// A module loaded before moduletransit, which then cannot reach the names
// moduletransit holds by folding. Imported by module-nameres-transit-early.cone
// and never compiled on its own, so it is listed in cases.toml as a support
// module; the annotation below is that scenario's whole expectation, because
// the diagnostic is reported against this file.
//
// This is modulelate.cone's call with the load order reversed: this module is
// added to the program when its parse begins, which is before its own import
// statement loads moduletransit, so it resolves first and moduletransit's fold
// has not run. The failure is therefore about load order and not about the
// root; module-nameres-transit.cone is the root's version of it, and the
// comment there says what is pinned and why.

import moduletransit;

pub fn viaMid(n i64) i64 {
  moduletransit.plain(n);  //~ ErrorUnkName:17 "The name plain does not refer to a declared name"
}
