// A module loaded BEFORE moduletransit, which reaches the names moduletransit
// re-exported. Imported by module_transit.cone and never compiled on its own, so
// it is listed in cases.toml as a support module.
//
// It is modulelate.cone's call with the load order reversed: this module is
// added to the program when its parse begins, which is before its own import
// statement loads moduletransit, so it is resolved first. That used to be the
// whole difference between the two files -- this one was refused and
// modulelate's identical call compiled -- and it is now no difference at all,
// because every module's folds are in place before any module's body is
// resolved.

mod moduleearly;

import moduletransit;

pub fn viaEarly(n i64) i64 {
  moduletransit.plain(n);
}
