// A compute entry point returns nothing and takes what a dispatch binds:
// core's Invocation at most once, slices and structs by value, each one
// buffer, at most seven of them, the eighth storage buffer a stage being the
// kernel's error buffer.

mod module_compute_sig;

struct Pair {
  a u32;
  b u32;
}

enum Kind {
  struct Red {}
  struct Blue {}
}

fn @compute(64) returns(inv Invocation) u32 { 0u32; }  //~ ErrorComputeSig
fn @compute(64) scalar(inv Invocation, n u32) {}  //~ ErrorComputeSig
fn @compute(64) borrowed(inv Invocation, p &Pair) {}  //~ ErrorComputeSig
fn @compute(64) tagged(inv Invocation, k Kind) {}  //~ ErrorComputeSig
fn @compute(64) twice(a Invocation, b Invocation) {}  //~ ErrorComputeSig
fn @compute(64) eight(a &[]u32, b &[]u32, c &[]u32, d &[]u32, e &[]u32, f &[]u32, g &[]u32, h &[]mut u32) {}  //~ ErrorComputeSig

// Seven buffers, a struct among them, and Invocation anywhere
fn @compute(64) seven(p Pair, a &[]u32, b &[]u32, inv Invocation, c &[]u32, d &[]u32, e &[]u32, f &[]mut u32) {}
