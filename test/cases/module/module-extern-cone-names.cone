// 'extern' declarations in a Cone-named module take that module's Cone names.
//
// The imported module is moduleextern.cone. Every function, method, operator and
// global it declares is 'extern' and has no body, and it is not C-named, so each
// is declared here under the same encoded name a package compiled on its own
// defines it under: that is how an include file reaches a package's symbols.
// Nothing here links, so the scenario compiles and its checks read the symbols.

import moduleextern use *;

fn reach() i64 {
  imm v = Vec2.origin() + Vec2[1, 2];
  count = twice(v.len()) + (&v).size();
  peek();
}
