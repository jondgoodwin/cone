// Where a nested module block may be written: only in a generated include
// file, known by two things together -- its role, a file an import line names,
// and the generator's banner at its top. The program's own file carries the
// banner and is not an include file; hand.cone is an include file without the
// banner; gen.cone has both, and so may hold a block, but not a 'pub' one.

build: debug
output: executable

import hand: "hand.cone"
import gen: "gen.cone"

prog: {
    "main.cone"
    import hand: "hand.cone"
    import gen: "gen.cone"
}
