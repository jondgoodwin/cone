// An error inside the braces of an interpolated string is reported at its real line
// and column: a name nothing declares, on the string's own line and on a later line
// of a multi-line literal.

mod module_text_interp_refuse_names;

import stdio use *;
import collections use *;

fn main() i32 {
  let n = 3;
  print <- $"unknown {nothing} name\n";    //~ ErrorUnkName:23
  print <- $"
      first {n}
      second {absent}
      ";                                   //~^ ErrorUnkName:15
  0
}
