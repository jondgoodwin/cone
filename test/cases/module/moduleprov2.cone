// Imported by module-typecheck-provenance.cone after moduleprov.cone, and
// never compiled on its own, so it is listed in cases.toml as a support module.
//
// It exists only to be the second module parsed at the same depth. It is
// error-free: what it contributes is that its parse follows moduleprov's, so
// a diagnostic misattributed to the most recently injected source would name
// this file instead of that one.

fn untroubled(n i64) i64 {
  n + 1i64
}
