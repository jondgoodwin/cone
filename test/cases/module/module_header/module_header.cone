// A module's header, as it is accepted: comments, the 'mod' line, then the
// imports, then everything else [Jon 24 Sep]. Comments may sit anywhere in it,
// between the 'mod' line and the first import included.
//
// It is a folder, because the other half of the rule is about a file that is
// not its folder's designated file: second.cone is one of this module's files
// and carries no 'mod' line, which is what it must do, since a 'mod' line would
// make it a one-file module of its own. With no 'mod' line it has no header and
// no imports, since a module's imports are all in its designated file [Jon 23
// Sep]; a 'use' it writes is accepted, since 'use' is no import.
//
// It runs, as any one module compiled into one object does.

mod module_header;

// A comment between the 'mod' line and the imports is still the header, and so
// is a blank line

import stdio use *;

// Its variants are folded in by second.cone's 'use'
enum Tint {
  Red, Blue;
}

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // second.cone's declarations are this module's own
  show("second-file-fn", secondScale(4i64));
  // Blue, bare, is what second.cone's 'use' folded in
  show("second-file-use", secondBlue());
  0i32;
}
