// A file of module_header that is not its designated file, so it carries no
// 'mod' line: the folder is what brings it into the module, and a 'mod' line
// would make it a one-file module instead. So it has no import either, and needs
// none: the designated file's import binds stdio for the whole module, and a
// module's imports are all in its designated file [Jon 23 Sep].
//
// A 'use' is no import, and no placement rule holds it: this file folds Tint's
// variants in, below a declaration, and names them bare.

fn secondScale(n i64) i64 {
  n * 3i64;
}

use Tint;

fn tintCode(t Tint) i64 {
  if t is Blue {2i64;} else {1i64;}
}

fn secondBlue() i64 {
  tintCode(Blue[]);
}
