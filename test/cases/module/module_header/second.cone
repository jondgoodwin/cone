// A file of module_header that is not its designated file, so it carries no
// 'mod' line: the folder is what brings it into the module, and a 'mod' line
// would make it a one-file module instead. It has no import either, and needs
// none: the designated file's import binds stdio for the whole module.

fn secondScale(n i64) i64 {
  n * 3i64;
}
