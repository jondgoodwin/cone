// A stray block end in the main source file, rather than in a file the folder
// swept in.
//
// module-folder-strayend is the same condition in a swept sibling. A '}' at
// global scope ends the statement loop, so without an end-of-file check after it
// everything below would be discarded in silence -- no diagnostic, exit 0, an
// object file emitted from half the source. The declaration below the stray
// brace is here to be that half.
//
// The diagnostic is reported at the token that should have followed the file,
// which is that declaration's first token, so the annotation sits on it.

fn beforeTheStrayBlockEnd(n i64) i64 {
  n;
}

}

fn afterTheStrayBlockEnd(n i64) i64 {   //~ ErrorNoEof:1 "Expected end-of-file"
  n
}
