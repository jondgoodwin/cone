// Where a module's name colliding with another name of this module is reported.
//
// Both bindings of a module's name are made where the compiler knows it rather
// than where the source wrote it: an import binds once the whole statement is
// parsed and the module loaded, and a module node is made before any file of its
// is read. So what is pinned is the position of each half of the diagnostic --
// the import statement, and the 'mod' declaration.
//
// Parse stage, which is why it is its own scenario: a duplicate is found as the
// name is bound, and a parse diagnostic stops the compile before name resolution.
//
// The imported modules are modulesub.cone, which declares no module and so is
// named for its file, and moduledeclared.cone, which declares 'mod renamed'.

// This file's module takes the name of the module the next statement imports, so
// the import's binding is the duplicate and the declaration the original
mod modulesub;          //~ ErrorDupName:1 "conflicting definition"

import modulesub;       //~ ErrorDupName:1 "already defined"

// The other way round: the import binds first, under the name the imported
// module declares for itself rather than its file's, and a declaration of this
// module's is the duplicate
import moduledeclared;  //~ ErrorDupName:1 "conflicting definition"

fn renamed() i64 {      //~ ErrorDupName:1 "already defined"
  1i64;
}
