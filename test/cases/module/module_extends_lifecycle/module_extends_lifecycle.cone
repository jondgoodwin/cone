// A module extending another keeps both lifecycles: the extended module's 'init'
// and 'final' stay its own, run once by the program, and the extender may declare
// its own. This program names only solids, which extends shapes, so shapes comes
// first in the module order: its 'init' runs before solids', and the finalizers
// run in the reverse, solids' then shapes'. Each prints once.

mod module_extends_lifecycle;

import stdio use *;

fn main() i32 {
  initAll();
  printStr("volume ");
  printInt(solids.volume(2i64, 3i64, 4i64));
  printStr("\n");
  finalAll();
  0i32
}
