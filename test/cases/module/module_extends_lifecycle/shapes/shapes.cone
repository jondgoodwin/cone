// The module solids extends: its 'init' and 'final' stay its own. Extending
// makes second names for the same things (a module has one instance), and the
// program runs each lifecycle function once.

mod shapes;

import stdio use *;

let started: i64;

pub fn @initpure init() {
  started = 1i64;
  printStr("shapes init\n");
}

pub fn final() {
  printStr("shapes final\n");
}

pub fn area(w: i64, h: i64) i64 {
  w * h + started - 1i64
}
