// Extends shapes and declares an 'init' and a 'final' of its own. The extender
// does not take shapes' lifecycle functions, so these are its own, not a clash.

mod solids extends shapes;

import stdio use *;

pub fn @initpure init() {
  printStr("solids init\n");
}

pub fn final() {
  printStr("solids final\n");
}

pub fn volume(w: i64, h: i64, d: i64) i64 {
  area(w, h) * d
}
