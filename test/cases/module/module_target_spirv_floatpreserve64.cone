// A compute kernel that compares f64 values declares SignedZeroInfNanPreserve
// for 64 bits, on SPIR-V's Vulkan form, and not for 32: it holds no f32.

mod module_target_spirv_floatpreserve64;

// A buffer holds no f64, so one is made of a u32's bits, the high half
fn @compute(64) nans64(inv: Invocation, highs: &Array[u32], out: &mut Array[u32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < highs.len {
    let t = f64.fromBits(u64.from(highs[i]) << 32u64).sqrt();
    out[i] = if t != t {1u32} else {0u32};
  }
}
