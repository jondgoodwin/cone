// What an import's 'use' clause refuses as it is parsed, and the rule for two
// imports of one module.
//
// A module imports another ONCE, and a second import is refused, naming where
// the first one is. An identical repeat -- the same clause, in any order, with
// the same 'pub' on each binding -- is two ways of bringing in the same thing,
// which is a cleanliness issue [Jon 23 Sep], and the message says it is the same
// import. One that differs in anything would leave the module's name or its
// folds meaning two things.
//
// Parse stage, which is why it is its own scenario: every refusal here is made
// before any name is resolved, and a parse diagnostic stops the compile there.

import modulesub use plain, scaleInt as twice;

// Identical, in another order
import modulesub use scaleInt as twice, plain;      //~ ErrorDupImport:1 "Module modulesub is imported already, the same way"

// A different list
import modulesub use plain;                         //~ ErrorDupImport:1 "Module modulesub is imported already, differently"

// The same list, with a different spelling for one name
import modulesub use plain, scaleInt as double;     //~ ErrorDupImport:1 "imported already, differently"

// The same clause, with the module's own name made public
pub import modulesub use plain, scaleInt as twice;  //~ ErrorDupImport:5 "imported already, differently"

// The same clause, with the folds made public
import modulesub pub use plain, scaleInt as twice;  //~ ErrorDupImport:1 "imported already, differently"

// 'pub' comes first, before the keyword of what it makes public: 'pub use'. The
// clause's own spelling before that ruling is refused, naming the one to write
import moduleprov2 use pub untroubled;              //~ ErrorBadPub:24 "write 'pub use', not 'use pub'"

// Every name rather than two
import modulesub.*;                                 //~ ErrorDupImport:1 "imported already, differently"

// '.*' is 'use *' spelled the older way, so these two are the same import
import moduletransit.*;
import moduletransit use *;                         //~ ErrorDupImport:1 "imported already, the same way"

// 'pub use' beside 'pub import' adds nothing, so these two say the same too
pub import moduleearly use viaEarly;
pub import moduleearly pub use viaEarly;            //~ ErrorDupImport:5 "imported already, the same way"

// '.*' is 'use *' spelled the older way, so writing both says it twice
import modulesyms.* use pubFn;                      //~ ErrorBadFold:21 "'.*' already folds every public name"

// 'but' leaves names out of every name; a list admits only what it names
import modulex use y_z but z;                       //~ ErrorBadFold:24 "'but' leaves a name out of a fold of every member"

// A selective import is a clause, not a path
import modulex_y.z;                                 //~ ErrorBadTerm:18 "a selective import is written with a 'use' clause"
