// A package compiled on its own whose include file cannot write a global's
// inferred type. user's global takes its type from coll.Stack, which coll's
// root re-exports from its private submodule vec: the type is coll.vec.Stack,
// and nothing outside coll may name coll.vec. So the generator cannot spell it
// (ErrorIncCheck), and asks for the type to be written.

build: debug
output: library

import coll: "coll.cone"

user: {
    "user.cone"
    import coll: "coll.cone"
}
