// What 'import x as y' refuses as it is parsed.
//
// The rename binds the module under 'y' at parse, as the module's own name is
// bound there without one, so a rename collides at parse exactly as the
// module's own name would: with a declaration of this module, or with the name
// another import binds. A module is imported once whatever name each import
// binds it under, so a second import of it under another name is two that
// differ.
//
// Parse stage, which is why it is its own scenario: a parse diagnostic stops
// the compile before any name is resolved.

mod module_import_as_parse;

import modulesub as sub;                    //~ ErrorDupName:1 "This is the conflicting definition"

// The same module under another name, and under its own
import modulesub as other;                  //~ ErrorDupImport:1 "Module modulesub is imported already, differently"
import modulesub;                           //~ ErrorDupImport:1 "Module modulesub is imported already, differently"

// The same rename again is the same import twice
import modulesub as sub;                    //~ ErrorDupImport:1 "Module modulesub is imported already, the same way"

// A rename meeting the name another import binds, renamed or not
import moduleearly as sub;                  //~ ErrorDupName:1 "Global name is already defined"

// 'as' takes a name, and a keyword is none
import modulex as mod;                      //~ ErrorNoIdent:19 "Expected the name the import binds the module under here, after 'as'"
import moduleprov2 as;                      //~ ErrorNoIdent:22 "after 'as'"

// A rename meeting a declaration of this module
import modulelate as Point;                 //~ ErrorDupName:1 "This is the conflicting definition"

struct Point {                              //~ ErrorDupName:8 "Global name is already defined"
  x i64;
}
