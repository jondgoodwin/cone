// An import written below the file's header. The header is comments, the 'mod'
// line and then the imports [Jon 24 Sep], so an import after any other
// declaration is refused, whatever it is written after and however the import
// is spelled. The import is still made, so nothing else is reported.
//
// Parse stage, which is why it is its own scenario. A file a folder sweeps in
// has no 'mod' line, and the same rule holds there (module_header_reject).
//
// The imported modules are modulesub.cone, modulex.cone, modulex_y.cone and
// moduleinline.cone.

mod module_parse_header;

// Comments between the 'mod' line and the imports are still the header
import modulesub;

fn first() i64 {
  1i64;
}

// After a function
import modulex_y;                //~ ErrorImportLate "right after the 'mod' line"

enum Light {
  struct On {
  }
  struct Off {
  }
}

// After a type, with a 'use' clause
import modulex use y_z;          //~ ErrorImportLate

// A standalone 'use' folds into this module and is no import, so a 'use' ends
// the header too
use Light;

// A re-export
pub import moduleinline;         //~ ErrorImportLate
