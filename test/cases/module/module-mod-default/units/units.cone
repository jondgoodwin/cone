// A default of two names. inches is as public as they are and is not folded by
// default: the clause chooses among public names, and does not decide which are.

mod units use metres, feet;

pub fn metres(n i64) i64 {
  n * 1000i64;
}

pub fn feet(n i64) i64 {
  n * 305i64;
}

pub fn inches(n i64) i64 {
  n * 25i64;
}
