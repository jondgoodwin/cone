// Three bare imports, each taking its module's default fold. The module's own
// name is bound as always, so what the default leaves out is reached through it.

mod calc;

import bigint;
import units;
import solids;

pub fn big(n i64) i64 {
  imm b = BigInt[n];
  b.doubled() + bigint.helper(n);
}

pub fn lengths(n i64) i64 {
  metres(n) + feet(n) + units.inches(n);
}

pub fn solid(n i64) i64 {
  area(n, n) + volume(n, n, n);
}
