// Every clause a 'mod' line has, in the order ruled [Jon 23 Sep]: 'extends', then
// 'is', then 'use'. plain took Runner's defaults at the end of its own folds,
// before this module's 'extends' read it, so they are plain's declarations here
// like the rest: each member of Runner is met by what plain brought, and nothing
// is copied a second time. So 'tick' is plain's, and counts in plain's storage.
// 'use run' makes a bare import of this module fold 'run', which plain took.

mod layered extends plain is Runner use run;

import hosts use Runner;

pub fn twice(n i64) i64 {
  run(n) + run(n);
}
