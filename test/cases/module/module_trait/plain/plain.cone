// Conforms to Runner and declares only what it requires: every default is taken.
// The 'is' comes before the import that puts Runner in reach, since what it names
// is resolved once every import is bound.

mod plain is Runner;

import hosts use Runner;

pub fn step(n: i64) i64 {
  n + 1i64
}

pub let scale = 2i64;

pub var offset: Atomic[i64];

pub var calls: Atomic[i64];

fn @initpure init() {
  offset = Atomic[i64].of(base);
  calls = Atomic[i64].of(0i64);
}
