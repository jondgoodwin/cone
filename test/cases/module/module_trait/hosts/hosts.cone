// The module trait every conforming module in this scenario names, declared in a
// sister module and reached by importing it and folding the trait in.
//
// Requirements, which each conforming module must declare: a function, a 'let'
// scale, and two atomic globals ('offset' and 'calls'; a module global that is written
// is a 'var' of an atomic, and an atomic is set up by the module's init, so it has
// no initialiser to default). And four defaults, which a conforming module takes
// unless it declares its own: one global with an initialiser, and three functions
// with bodies. One default names two requirements and a default global, so its
// copy reads what the conforming module has under those names; one names a private
// helper of this module, which its copy keeps reaching; and one writes a required
// global, so each module that took it has storage of its own.

mod hosts;

pub mod trait Runner {
  pub fn step(n: i64) i64;
  pub let scale: i64;
  pub var offset: Atomic[i64];
  pub var calls: Atomic[i64];

  pub let base = 100i64;

  pub fn run(n: i64) i64 {
    step(n) * scale + offset.load()
  }

  pub fn label() i64 {
    unit()
  }

  pub fn tick() i64 {
    calls.add(1i64) + 1i64
  }
}

fn unit() i64 {
  1i64
}
