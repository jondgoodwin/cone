// A submodule that names its sisters. A module's own folder draws nothing of
// them -- they are subfolders of its PARENT's folder -- so what puts them in
// reach is the registry the parent is, and an import is what asks it.
//
// The mechanism is the one that will reach an external package: one lookup, two
// kinds of neighbour. What differs is which registry answers, and a module with
// no parent has only the outside world to ask.

mod engine;

// Re-exported. 'pub' on an import makes every binding the import creates a public
// name of this module -- here, the module's own name -- so a path from outside
// may walk 'engine.wheels.turn'. It is the same 'pub' a declaration carries, and
// the same one a fold reads
pub import wheels;

// A wildcard import folds the sister's public names in as names of this module,
// each under a binding of its own. No 'pub', so those bindings are private here:
// a fold is private to the module that made it, which is why 'engine.size' does
// not resolve from outside although 'size' is public in rims
import rims.*;

pub fn drive(n i64) i64 {
  // Through the sister, and then a folded name bare
  wheels.turn(n) + size();
}

// A sister's private name is hers. module-import-nameres pins the refusal
fn spare(n i64) i64 {
  wheels.turn(n);
}
