// IMPORT WITHIN THE TREE: a module reaches a sister by importing her NAME, and
// the name is resolved against the registry its parent is rather than against
// the filesystem.
//
// This is the designated file of the scenario's folder, so it is the root module
// and the three subfolders beside it each draw a submodule of it. A module is the
// registry for its children -- they are public to each other and to it, and
// invisible outside unless it publishes them -- so 'import wheels' written inside
// engine is a lookup in this module's namespace. The sweep has already drawn
// wheels; nothing is loaded, no path is composed, and no file is read twice.
//
// It RUNS, and that is the half a submodule already had and an import did not.
// Every module of the tree is compiled into this one object, so a call across the
// tree links exactly as a call down into it does.
//
// The folder holds:
//   engine/engine.cone    a submodule that imports its two sisters
//   wheels/wheels.cone    a sister, imported by name and re-exported by engine
//   rims/rims.cone        a sister, wildcard-imported so its names are engine's

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // Inside engine, a sister's public name is reached through the sister and a
  // wildcard-imported one is reached bare
  show("sister-call", engine.drive(3i64));

  // engine wrote 'pub import wheels', so the binding the import made is a public
  // name of engine and a path may walk through it. Written 'import wheels' it
  // would be private here, which module-import-nameres pins -- the same bit that
  // decides a folded name decides the module's own binding
  show("re-exported", engine.wheels.turn(4i64));

  // A sister of this module's children is not a child of this module: the root
  // reaches wheels because wheels is its own submodule, not because engine
  // imported her
  show("parent-reach", wheels.turn(5i64));
  0i32;
}
