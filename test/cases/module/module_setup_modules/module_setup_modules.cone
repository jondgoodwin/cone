// Setups across modules. 'lower' declares one setup and no 'init' of its own;
// the module is given an 'init' that runs it, so the program's stitched init
// calls it as it calls any module's, before this module's: "make10" prints
// first. This module's 'derived' reads 'lower''s global through a call into
// 'lower', which has been set by then: "make15". Then this module's 'init'
// ("init"), then 'main'.
//
// The finals run in the exact reverse across modules (rule 6): this module's
// first, 'derived' (F15), then 'lower''s (F10).

mod module_setup_modules;

import stdio use *;

let derived: lower.Fin = lower.make(lower.base.n + 5i64);

fn @initpure init() {
  printStr("init ");
}

fn main() i32 {
  printStr("main ");
  printInt(lower.base.n); printInt(derived.n);
  printStr("\n");
  0i32
}
