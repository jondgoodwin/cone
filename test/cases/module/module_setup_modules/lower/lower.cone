// A setup in a module with no 'init': the compiler gives the module an 'init'
// that runs it.

mod lower;

import stdio use *;

pub struct Fin {
  pub n: i64;
  fn final(self: &uni) { printStr("F"); printInt(n); printStr("\n"); }
}

pub fn make(n: i64) Fin {
  printStr("make"); printInt(n); printStr(" ");
  Fin(n)
}

pub let base: Fin = make(10i64);
