// A compute entry point's workgroup size: up to three constant integers, each
// at least 1, at most 256 invocations in all and 64 along z, WebGPU's
// guaranteed limits. The size is refused where it is written.

mod module_compute_size;

fn @compute(0) none(inv Invocation) {}  //~ ErrorComputeSize
fn @compute(512) wide(inv Invocation) {}  //~ ErrorComputeSize
fn @compute(16, 16, 2) many(inv Invocation) {}  //~ ErrorComputeSize
fn @compute(1, 1, 65) deep(inv Invocation) {}  //~ ErrorComputeSize
fn @compute(1, 2, 3, 4) four(inv Invocation) {}  //~ ErrorComputeSize
fn @compute(size) named(inv Invocation) {}  //~ ErrorComputeSize
fn @compute bare(inv Invocation) {}  //~ ErrorComputeSize

// At the limits
fn @compute(256) line(inv Invocation) {}
fn @compute(16, 16) square(inv Invocation) {}
fn @compute(2, 2, 64) tall(inv Invocation) {}
