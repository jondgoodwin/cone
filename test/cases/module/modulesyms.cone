// Imported by module-symbols.cone, and never compiled on its own, so it is
// listed in cases.toml as a support module.
//
// One declaration of each kind whose imported spelling module-symbols pins: a
// 'mut' global, an 'imm' global, a public and a private function, a C function
// declared 'extern' and '@c' inside a module rather than the root, and a struct with a public
// method, a private method and a static function. The private declarations are
// never named by the importer; whether they get a symbol anyway is the point.
//
// Its name carries no '-' because a module's name is also its qualifier.

pub extern fn @c labs(n i64) i64;

pub mut shared i64 = 5i64;
mut privGlobal i64 = 6i64;
pub imm fixed i64 = 7i64;

pub fn pubFn(n i64) i64 {
  n + 1i64;
}

fn privFn(n i64) i64 {
  n + 2i64;
}

pub struct Gadget {
  pub x i32;

  fn hid(self &) i32 {
    x + 1;
  }

  pub fn get(self &) i32 {
    x + hid();
  }

  pub fn make(n i32) Gadget {
    Gadget[n];
  }
}
