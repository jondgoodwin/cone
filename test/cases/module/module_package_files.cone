// A PACKAGE SPANS THE FILES OF ITS src FOLDER. This scenario's run passes
// '--path=test/cases/module/modulepkgfiles', where the package pkgfiles is laid
// out as Congo lays out every package: its source root is
// pkgfiles/src/pkgfiles.cone. The search path finds that file, and it is the
// designated file of src, named for the package, so the module rules apply
// under src unchanged: its other files join the package's root module, at any
// depth, and a file or subfolder that opens its own module is a submodule.
//
// It RUNS: a module found on the search path is compiled into this object, with
// every file and submodule its sweep found, so each call links.

mod module_package_files;

import stdio use *;
import pkgfiles;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // The root file calls a private function of vec.cone, beside it in src
  show("root-reaches-sibling", pkgfiles.fromRoot());
  // A public function written in vec.cone is the package's own name
  show("sibling-is-the-packages", pkgfiles.fromSibling());
  // shapes/ is organisational, so area.cone's function is the package's too
  show("organisational-subfolder", pkgfiles.fromDeep());
  // half.cone opens with 'pub mod half;', a one-file submodule
  show("one-file-submodule", pkgfiles.half.halve(10i64));
  // scale/scale.cone is a subfolder's designated file, a folder submodule
  show("folder-submodule", pkgfiles.scale.triple(4i64));
  0i32;
}
