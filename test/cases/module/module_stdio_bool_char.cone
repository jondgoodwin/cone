// A bool and a char printed by the stream operator, to each stream: `print <- true` writes
// the text `true` (or `false`), `print <- 'c'` the character as its UTF-8 bytes, so a
// newcomer's `print <- isLeap(2024)` works. Standard output here and standard error in the
// .err, the same text. The int, float, unsigned and string entries beside them print as
// before.
//
// - bool: both values, a function's result, a comparison;
// - char: one to four UTF-8 bytes ('c', 'é' U+00E9, '€' U+20AC, '😀' U+1F600), and '\n';
// - a list of entries mixing every kind, in order.

mod module_stdio_bool_char;

import stdio use *;

fn isLeap(year i64) bool {
  (year % 4 == 0 and year % 100 != 0) or year % 400 == 0;
}

fn main() {
  print <- true, "\n";
  print <- false, "\n";
  print <- 'c', "\n";
  print <- 'é', '€', '😀', '\n';
  print <- "x=", true, '\n';
  print <- "leap: ", isLeap(2024), " ", isLeap(1900), " ", isLeap(2000), '\n';
  print <- "cmp: ", 3 < 4, " ", 4i64 == 5i64, '\n';
  print <- "mixed: ", 42i64, ' ', 2.5d, ' ', 7u64, ' ', true, ' ', 'z', " end", '\n';
  print.flush();

  eprint <- true, "\n";
  eprint <- false, "\n";
  eprint <- 'c', "\n";
  eprint <- 'é', '€', '😀', '\n';
  eprint <- "x=", true, '\n';
  eprint <- "leap: ", isLeap(2024), " ", isLeap(1900), " ", isLeap(2000), '\n';
  eprint <- "cmp: ", 3 < 4, " ", 4i64 == 5i64, '\n';
  eprint <- "mixed: ", 42i64, ' ', 2.5d, ' ', 7u64, ' ', true, ' ', 'z', " end", '\n';
  eprint.flush();
}
