// Imports alpha, which imports this module: alpha -> beta -> alpha. alpha is
// mid-fold the first time this module reads it, so what alpha declares is there
// and what it re-exports is not: shared, and Tone. They arrive in the next pass.

mod beta;

import alpha use own, shared as common;    //~ ErrorImportLoop

// Named through a path, and the path reads alpha too
use alpha.Tone;

fn score(t &alpha.Tone) i64 {
  match t {
    case is &High {20i64;}
    else {10i64;}
  }
}

pub fn b() i64 {
  // The local spelling the clause gave it
  own() + common();
}

pub fn tone() i64 {
  imm hi = High[];
  score(&hi);
}
