// A wildcard of kappa, read while kappa is mid-fold: kappa -> lambda -> kappa.
// The first pass carries kappa's declarations on and not what kappa re-exports;
// the next carries more on too, bare here and, through the 'pub use', from
// lambda's path and lambda's own wildcard importers.

mod lambda;

import kappa pub use *;

pub fn f() i64 {
  k() + more();
}
