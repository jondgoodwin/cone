// A wildcard of alpha, read while alpha is mid-fold: alpha -> bravo -> alpha.
// The two folds below name what alpha re-exports, bare, so the first time they
// run neither name is there. Each waits for the pass that brings it rather than
// being reported missing: a global's fold names its type, and an enum's 'use'
// names the enum.

mod bravo;

import alpha use *;

mut cfg Config = Config[5i64] use speed, twice;
use Tone;

fn score(t &Tone) i64 {
  match t {
    case is &High {20i64;}
    else {10i64;}
  }
}

pub fn b() i64 {
  imm hi = High[];
  speed + twice() + score(&hi);
}
