// A module loaded after modulefold, which reaches the names modulefold holds by
// folding a global. Imported by module_nameres_fold_visibility.cone and never
// compiled on its own, so it is listed in cases.toml as a support module.
//
// Loaded after, for modulelate.cone's reason: a module's folds run when that
// module's turn in the load order comes, and the root's import of modulefold is
// what puts modulefold ahead of this one. From the root the same names are not
// there yet, which is the load-order defect module_nameres_transit pins.
//
// What this file establishes is the binding's own visibility. Both members are
// public in Dial, so the declaration says the same thing about each; what differs
// is the clause that bound them here.

mod modulefoldlate;

import modulefold;

pub fn viaPub() i64 {
  // 'pub use' made this one a public name of modulefold
  modulefold.dialLevel + modulefold.dialRead();
}

pub fn viaPrivate() i64 {
  // and the plain 'use' did not, although 'level' is public in Dial
  modulefold.spareLevel;   //~ ErrorNotPublic:14 "private to its module"
}
