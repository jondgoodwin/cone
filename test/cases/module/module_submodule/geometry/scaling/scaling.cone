// A submodule of a submodule: the tree is a tree, and the walk that drew geometry
// out of the root's folder draws this one out of geometry's with no second rule.
//
// 'pub' opens it to its parent's neighbours. It is the only place that can be
// written, because a parent declares nothing about a subfolder -- the folder is
// the declaration -- and it is the same 'pub' every declaration carries, reaching
// the declaration that draws a module.

pub mod scaling;

pub fn twice(n i64) i64 {
  n * 2i64;
}
