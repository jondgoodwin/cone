// The module tree: a subfolder that holds its own designated file is a SUBMODULE
// of the enclosing module, and names inside it are reached through it by path.
//
// This is the designated file of the scenario's folder, so it is the root module
// and its folder is swept: sibling.cone joins it, and geometry/ does not, because
// geometry/ holds geometry.cone and so draws a module of its own. One probe --
// does this folder hold the file named for it? -- decides both, and it is the same
// probe that made this file sweep at all.
//
// It runs rather than merely compiles. Every module of the tree is compiled into
// this one object, so a submodule's call links exactly as a sibling file's does;
// what a path through the tree costs at the linker is a package question and is
// not this.
//
// The folder holds:
//   sibling.cone              swept into this module
//   geometry/geometry.cone    a submodule, named for its folder
//   geometry/shapes.cone      swept into the submodule, not into this module
//   geometry/detail/helpers.cone   an organisational folder INSIDE a submodule
//   geometry/scaling/scaling.cone  a submodule of the submodule, written 'pub'

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// A submodule's enum, held by value. This module's walk reaches the parameter
// before the submodule's walk reaches the enum's variants, which is only an order
// of work and not a cycle, so the size question is answered as it would be anywhere
fn cornersOf(c geometry.Corner) i64 {
  c.count;
}

fn main() i32 {
  // A file this folder swept in is this module's own, as the folder sweep built
  show("sibling", perimeter(2i64, 3i64));

  // A submodule is a name of this module's namespace that no statement here
  // declares: the folder is the declaration. It is reached by path, which is the
  // ordinary rule for a name in a namespace, and nothing about the path knows it
  // was a folder that put the name there.
  //
  // 'geometry' says nothing about its own visibility, so it is private to this
  // module -- which does not stop THIS module naming it. Privacy is about outside
  // versus inside, and a parent is inside
  show("submodule", geometry.area(3i64, 4i64));

  // The submodule's folder was swept like any module folder, so a declaration in
  // shapes.cone is the submodule's and is reached through the submodule. The file
  // is not a namespace and neither is the folder that grouped it
  show("swept-sibling", geometry.perimeterOf(3i64, 4i64));

  // A global of a submodule, which is one instance like any other module's
  show("submodule-global", geometry.unit);

  // Two hops, through a submodule and then through ITS submodule. 'scaling' is
  // written 'pub', which is what lets a module that is not its parent name it:
  // an unmarked submodule is private to its parent, and this module is scaling's
  // grandparent rather than its parent. Written without the 'pub' it would be
  // ErrorNotPublic here, which module-submodule-nameres pins
  show("nested-submodule", geometry.scaling.twice(5i64));

  // A submodule's enum passed by value, and its common field read from the copy
  show("submodule-enum-by-value", cornersOf(geometry.sharp()));
  0i32;
}
