// A wildcard import, and the private names it leaves behind.
//
// Name-resolution stage only: this file parses cleanly, and name resolution
// returns before type checking, so a type-check expectation here would never
// run.
//
// 'import modulesub::*' folds modulesub's public names into this module, and
// module-imports pins that they arrive. A private name -- a function, an
// overload name, or the concrete candidate of a private overload name -- is
// skipped by the fold (ir/stmt/import.c), so its bare spelling is simply not a
// name of this module and fails as any unknown name does. The qualified route
// to the same declaration is refused differently, as ErrorNotPublic, and
// module-nameres pins that.
//
// The imported module is modulesub.cone.

import modulesub::*;

fn privateFn() f64 {
  _scaleFloat(1.5d);         //~ ErrorUnkName:3 "The name _scaleFloat does not refer to a declared name"
}

fn privateOverloadName() i64 {
  _hidden(1i64);             //~ ErrorUnkName:3 "The name _hidden does not refer to a declared name"
}

fn privateCandidate() i64 {
  _hiddenOne(1i64);          //~ ErrorUnkName:3 "The name _hiddenOne does not refer to a declared name"
}
