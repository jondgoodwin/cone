// The shape of the diamond, but not one: a's x is c1's and b's x is c2's, so
// one name of d would mean two things. Reported at the clause that arrived
// second; 'but x' or a listed 'as' settles it.

mod d;

import a use *;
import b use *;             //~ ErrorDupName:10 "x is already a name of this module"

pub fn y() i64 {
  x();
}
