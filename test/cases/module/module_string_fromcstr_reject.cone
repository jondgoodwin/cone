// What `String.fromCStr` refuses. It takes a `cstr`, which promises the zero that ends it. A
// raw `*u8` does not (it may be null, or point at bytes with no zero), and a `&u8` converts to
// a `*u8`, so neither is a C string: before this, `String.fromCStr(n)` with a `&u8` (an `each`
// over a List of bytes, or a borrow of one byte) copied memory up to a zero it had no reason
// to find. A pointer C may leave null (what `getenv` answers) is asked about first, and
// `cstr.fromPtr(p)` is the caller's word for the rest (module_string_fromcstr).
//
// - a `&u8` from an `each` over a List of bytes, a lone borrow, a borrow of a borrow;
// - a raw pointer, a C function's raw answer, and `null`.

mod module_string_fromcstr_reject;

import collections use List, String;
import libc;

fn main() {
  var l = List[u8].empty();
  l.push(72u8);
  l.push(0u8);
  each n in l {
    let s = String.fromCStr(n);               //~ ErrorInvType
  }
  let b = 7u8;
  let r = &b;
  let rr = &r;
  let lone = String.fromCStr(r);              //~ ErrorInvType
  let twice = String.fromCStr(rr);            //~ ErrorInvType
  let p = r as *u8;
  let raw = String.fromCStr(p);               //~ ErrorCPtrConv
  let env = String.fromCStr(libc.getenv("CONE_FROMCSTR_NEVER_SET"));   //~ ErrorCPtrConv
  let none = String.fromCStr(null);           //~ ErrorNullNotPtr
}
