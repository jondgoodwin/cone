// On the CPU a compute entry point is an ordinary function: the same source a
// kernel is made of runs in a loop that fills core's Invocation as a dispatch
// would, workgroup by workgroup, x fastest.

mod module_compute_cpu;

import stdio use *;

struct Scale {
  pub factor f32;
  pub count u32;
}

fn @compute(4, 2) scaled(inv Invocation, s Scale, a &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0] + 8u32 * inv.globalId[1]);
  if u32.from(i) < s.count {
    out[i] = a[i] * s.factor + f32.from(inv.localIndex);
  }
}

fn main() {
  mut a Array[f32, 16] = [0.f32, 1.f32, 2.f32, 3.f32, 4.f32, 5.f32, 6.f32, 7.f32,
    8.f32, 9.f32, 10.f32, 11.f32, 12.f32, 13.f32, 14.f32, 15.f32];
  mut out Array[f32, 16] = [0.f32, 0.f32, 0.f32, 0.f32, 0.f32, 0.f32, 0.f32, 0.f32,
    0.f32, 0.f32, 0.f32, 0.f32, 0.f32, 0.f32, 0.f32, 0.f32];
  imm s = new Scale(2.f32, 14u32);
  // A dispatch of 2 by 2 workgroups of 4 by 2
  mut gy = 0u32;
  while gy < 2u32 {
    mut gx = 0u32;
    while gx < 2u32 {
      mut ly = 0u32;
      while ly < 2u32 {
        mut lx = 0u32;
        while lx < 4u32 {
          imm inv = new Invocation([gx * 4u32 + lx, gy * 2u32 + ly, 0u32], [lx, ly, 0u32], [gx, gy, 0u32],
            lx + 4u32 * ly, [2u32, 2u32, 1u32]);
          scaled(inv, s, &a, &mut out);
          lx = lx + 1u32;
        }
        ly = ly + 1u32;
      }
      gx = gx + 1u32;
    }
    gy = gy + 1u32;
  }
  mut i = 0usize;
  while i < 16usize {
    printFloat(f64.from(out[i]));
    print <- " ";
    i = i + 1usize;
  }
  print <- "\n";
}
