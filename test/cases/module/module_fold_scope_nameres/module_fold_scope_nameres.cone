// A module's folds resolve against that module's names only, whichever module's
// fold pass reached them.
//
// A module's namespace holds what it declares, what its own folds and imports
// brought in, and its children; nothing arrives from the scope it was entered
// from. The fold passes run dependency-first, so one module's folds often run
// from inside another's -- a parent's 'use' of its child, an import of a sister --
// and a type is resolved by demand from inside another module's resolution. Each
// is resolved in its own module's names, never in the names of the module whose
// pass got there first.
//
// Name-resolution stage: every expectation is a name the module never brought in.
//
// The folder holds:
//   child/child.cone   folded here by 'use', naming what only this module declares
//   alpha/alpha.cone   imports beta, and declares what beta names
//   beta/beta.cone     never imports alpha, and names what only alpha declares

mod module_fold_scope_nameres;

pub enum Dir {
  North, South;
}

pub struct Panel {
  pub width i64;
}

// Runs child's folds from inside this module's own, so this module's names are
// hooked when child's 'use Dir;' and its global's type are resolved
use child;

fn main() i32 {
  0i32;
}
