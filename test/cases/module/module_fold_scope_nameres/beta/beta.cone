// A sister of alpha that never imports her, so none of alpha's names are hers,
// whichever module's pass reaches her folds and her types first.

mod beta;

use Heading;                    //~ ErrorUnkName:5 "Heading does not refer to a declared name"

mut @threadlocal m Gauge = new Gauge(1i64) use level;  //~ ErrorUnkName:20 "Gauge does not refer to a declared name"
                                       //~^ ErrorUnkName:32 "Gauge does not refer to a declared name"

// Resolved by demand when alpha's Dial names it in its 'is'
pub trait Knob {
  pub gauge Gauge;              //~ ErrorUnkName:13 "Gauge does not refer to a declared name"
}
