// A module loaded after moduletransit, which reaches the names moduletransit
// re-exported through the qualifier 'moduletransit.'. Imported by
// module-transit.cone and never compiled on its own, so it is listed in
// cases.toml as a support module.
//
// moduleearly.cone is this file loaded the other way round, and the root file
// reaches the same names from ahead of both. All three resolve, because what
// they read is the 'pub' on moduletransit's import; being late used to be what
// made this one resolve and the other two fail.

import moduletransit;

pub fn viaMid(n i64) i64 {
  // A folded concrete name, a folded overload name, and the module's own name
  moduletransit.plain(n) + moduletransit.scale(n) + moduletransit.midOwn(n);
}
