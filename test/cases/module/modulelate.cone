// A module loaded after moduletransit, which reaches the names moduletransit
// holds by folding through the qualifier 'moduletransit::'. Imported by
// module-transit.cone and never compiled on its own, so it is listed in
// cases.toml as a support module.
//
// This resolves cleanly, and the same lines in the root file do not
// (module-nameres-transit.cone): a module's fold runs when that module's turn
// in the load order comes, and this module's turn is after moduletransit's.
// The root's import of moduletransit is what puts moduletransit ahead of this
// module in that order; moduleearly.cone is the same file loaded the other way
// round.

import moduletransit;

fn viaMid(n i64) i64 {
  // A folded concrete name, a folded overload name, and the module's own name
  moduletransit::plain(n) + moduletransit::scale(n) + moduletransit::midOwn(n);
}
