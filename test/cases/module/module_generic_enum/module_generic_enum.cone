// ENUMS INSIDE A GENERIC MODULE, treated as a generic type's members are [Jon
// 23 Sep]: each instance, slots[i64] and slots[f64], holds its own copy of each
// enum the module declares, with T substituted -- so slots[i64].Slot holds an
// i64 and slots[f64].Slot an f64 -- and its own global of that enum's type.
//
// This is the designated file of the scenario's folder; slots.cone beside it is
// the generic module. Each printed value was checked by hand against the source.

mod module_generic_enum;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label: &str, n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn main() {
  // Nothing put yet: each instance's global holds Empty
  show("slots[i64].get", slots[i64].get(9i64));           // 9
  slots[i64].put(5i64);
  slots[f64].put(2.5);
  slots[f64].put(3.5);
  show("slots[i64].get", slots[i64].get(0i64));           // 5
  showF("slots[f64].get", slots[f64].get(0.0));           // 3.5
  show("slots[i64].puts", slots[i64].puts);               // 1
  show("slots[f64].puts", slots[f64].puts);               // 2

  // The generic enum, at the instance's T and its own U
  show("slots[i64].pick", slots[i64].pick(slots[i64].left(7i64), 1i64));   // 7
  showF("slots[f64].pick", slots[f64].pick(slots[f64].left(1.25), 0.0));   // 1.25

  // The extension, with Slot's variants and its own
  show("slots[i64].widen", slots[i64].widen(slots[i64].both(4i64), 0i64));   // 8
  showF("slots[f64].widen", slots[f64].widen(slots[f64].both(0.75), 0.0));   // 1.5
}
