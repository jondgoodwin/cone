// A GENERIC MODULE declaring enums, each of which every instance holds a copy
// of, with the module's type parameter substituted, as a generic type's
// instance holds its copy of each method: a plain enum whose variant holds a T,
// folded in bare by a standalone 'use'; a generic enum with a parameter of its
// own beside the module's; and an enum extending the first. A global of the
// enum's type is each instance's own.
pub mod slots[T];

// Its variant holds a T
pub enum Slot {
  Empty;
  Full(T);
}

use Slot;

// A parameter of its own, U, beside the module's T
pub enum Either[U] {
  Left(T);
  Right(U);
}

// An enum extending Slot: copies of Slot's variants, then its own
pub enum Wide extends Slot {
  Both(T);
}

// Each instance's own: the last value put, and how many were put
pub var @threadlocal last: Slot = Empty;
pub var @threadlocal puts: i64 = 0i64;

pub fn put(x: T) {
  last = Full(x);
  puts = puts + 1i64;
}

// The last value put, or 'd' before any was
pub fn get(d: T) T {
  match last {
    case is Empty {d}
    case let Full(v) {v}
  }
}

pub fn left(x: T) Either[i32] {
  Either.Left[i32](x)
}

// The T a Left holds, or 'd' for a Right
pub fn pick(e: Either[i32], d: T) T {
  match e {
    case let Left(v) {v}
    case let Right(n) {d}
  }
}

pub fn both(x: T) Wide {
  Wide.Both(x)
}

// What a Wide holds, a Both's twice over
pub fn widen(w: Wide, d: T) T {
  match w {
    case is Wide.Empty {d}
    case let Wide.Full(v) {v}
    case let Wide.Both(v) {v + v}
  }
}
