// Two organisational subfolders declaring one name into the enclosing module.
// A subfolder is not a namespace, so both of these declarations are the module's
// own and one of them is a duplicate -- and each diagnostic names the file it
// was written in, which is the only thing that tells the two apart.

fn shared() i64 {                //~ ErrorDupName "conflicting definition"
  1i64;
}
