// What the folder sweep refuses, and where each refusal is reported.
//
// The designated file of this folder, and the whole scenario is the folder: the
// sweep's diagnostics are about files, so several of them are reported against
// a file this one never names.
//
// Parse stage, which is why it is its own scenario: a parse diagnostic stops the
// compile before name resolution, so nothing here resolves.
//
// The two diagnostics with no line of their own are in cases.toml: which files a
// module holds is a fact about the filesystem, not about a position in a source.

mod misnamed;      //~ ErrorModName "named for its folder"

// A file of this module's own folder is already part of this module. Importing
// it would ask the module to import itself, which is what the folder already
// did without being asked
import sibling;    //~ ErrorModFile "already part of module"

// Nor may a file the folder swept in be injected a second time: 'include'
// reaches the same registry, and a file belongs to one module
include "four/same";   //~ ErrorModFile "already belongs to module"

fn designated() i64 {
  1i64;
}
