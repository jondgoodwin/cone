// A file the folder swept in. It has no module to declare: the designated file
// declares the one they share, and a file with no declaration has nowhere to
// write an import either, which is the property that keeps a module's inbound
// dependency list complete at its own declaration.
//
// A file whose FIRST statement is a 'mod' declaration is not swept in at all: it
// is a one-file module of its own, which module-onefile runs. What is refused
// here is a 'mod' anywhere later, in a file that is already one of the folder's.

fn swept() i64 {
  2i64;
}

mod sibling;       //~ ErrorModDcl "first statement"
