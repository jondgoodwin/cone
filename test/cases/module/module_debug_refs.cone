// A debug build describes references, slices, a List, a String, a closure and a generic
// instance to a debugger. A reference of any permission or region is a pointer to its
// pointee's type, named as a diagnostic spells it. A type that reaches itself through a
// reference ('Node', 'Tree') is described once: its own parts name its forward declaration.

mod module_debug_refs;

import collections use *;

struct Node {
  pub value: i64;
  pub next: Option[&Node];
}

enum Tree {
  Leaf;
  struct Branch {pub left: &Tree; pub right: &Tree; pub weight: i32;}
}

struct Pair[A, B] {
  pub first: A;
  pub second: B;
}

fn reach(node: &Node, owner: &mut Node, tree: &Tree, label: &str, items: &Array[i64], text: String) i64 {
  let list = List[i64]();
  let pair = Pair[i64, f64](3, 4.5);
  let grid = Dict[i64, i64]();
  let raw: *i64 = null;
  let counted = Rc[mut, Node](Node(5, None));
  let sole = Uni[Node](Node(6, None));
  let base = 10;
  let add = fn (x: i64) [base] i64 { x + base };
  let name = label;
  add(items[0]) + base
}

fn main() {
  let leaf: Tree = Tree.Leaf;
  let node = Node(1, None);
  var other = Node(2, None);
  let r = reach(&node, &mut other, &leaf, "x", &[1, 2, 3], String.from("hi"));
}
