// The setups' order follows a generic instance wherever the generic lives. 'a'
// calls another module's generic function with this module's type P, whose
// instance calls P's 'get', which reads 'ga'; 'b' does the same through a method
// of another module's generic type's instance, with Q, which reads 'gb'. Each
// has a global of its own to wait for, so one that went unfollowed shows. Both
// are declared before the globals they read and run after them: the program
// prints 42 and 52, not 1 and 10.
//
// This is the designated file of the scenario's folder; 'helper.cone' is a
// one-file submodule opening with 'mod'.

mod module_setup_generic_callback;

import stdio use *;

pub struct P {
  pub x: i64;
  pub fn get(self: &P) i64 { ga }
}

pub struct Q {
  pub x: i64;
  pub fn get(self: &Q) i64 { gb }
}

fn mk(n: i64) i64 { n }

let a: i64 = helper.call[P](&P(0i64));
let b: i64 = helper.Holder[Q](10i64).run(&Q(0i64));
let ga: i64 = mk(41i64);
let gb: i64 = mk(42i64);

fn main() i32 {
  printInt(a);
  printStr(" ");
  printInt(b);
  printStr("\n");
  0i32
}
