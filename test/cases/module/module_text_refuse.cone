// A value with no 'toText' sent as text is refused, with the type and the method
// named: to a String, to a writer a 'toText' is given, to the console, to a list
// of pieces, and to a trace message's kind of receiver. A type that has one is
// accepted beside them. (A List receiving a point still appends the point:
// module_text_overloads.)

mod module_text_refuse;

import stdio use *;
import collections use *;

struct Mute {
  x: i64;
}

struct Spoken {
  x: i64;
  pub fn toText(self: &, out: &uni TextOut) {
    out <- "spoken ", self.x;
  }
}

fn toString() {
  var s = String();
  let m = Mute(1i64);
  s <- m;                       //~ ErrorNoText "Mute cannot be written as text"
  s <- "a", m, "b";             //~ ErrorNoText "Mute cannot be written as text"
  s <- Spoken(2i64);
}

fn toConsole() {
  let m = Mute(3i64);
  print <- m;                   //~ ErrorNoText "Mute cannot be written as text"
  eprint <- "x", m;             //~ ErrorNoText "Mute cannot be written as text"
  print <- "ok ", Spoken(4i64), "\n";
}

fn toWriter(out: &uni TextOut) {
  let m = Mute(5i64);
  out <- m;                     //~ ErrorNoText "Mute cannot be written as text"
  out <- Spoken(6i64);
}

fn toLocalWriter() {
  var w = print.record();
  let m = Mute(7i64);
  w <- 1, m, 2;                 //~ ErrorNoText "Mute cannot be written as text"
}

fn main() {
  toString();
  toConsole();
}
