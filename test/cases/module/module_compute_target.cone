// A compute entry point is a Vulkan compute shader; SPIR-V's OpenCL form has
// kernels of another kind, and an entry point compiled for it is refused.

mod module_compute_target;

fn @compute(64) fill(inv Invocation, out &[]mut u32) {  //~ ErrorComputeTarget
  imm i = usize.from(inv.globalId[0]);
  if i < out.len { out[i] = inv.globalId[0]; }
}
