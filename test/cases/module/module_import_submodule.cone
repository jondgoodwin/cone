// A submodule of an imported module is generated exactly when that module is.
// modtree is found beside this file, so it is only declared here -- and so is
// every module of its tree: branch, a subfolder's submodule; twig, a one-file
// submodule of branch; and leaf, a one-file submodule of modtree. cases.toml pins
// that each of their functions this file reaches is declared and none is defined.
//
// It compiles rather than runs: it spans modules.
//
// The imported module is the folder modtree.

mod module_import_submodule;

import modtree;

fn viaTree() i64 {
  modtree.treeAdd(1i64) + modtree.branch.grow(2i64)
    + modtree.branch.twig.bend(3i64) + modtree.leaf.fall(4i64);
}
