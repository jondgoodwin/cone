// A struct that holds an actor's handle has a debug form: an actor's state is not the
// caller's to read, so the handle is written as the actor's own name, <Counter>, as a
// trait object is written as its trait's name. A handle of an actor trait is written as
// that trait's name, <ChunkSink>, whichever actor it holds.

mod module_debug_actor;

import stdio use *;
import actors;

actor Counter {
  total: u64;

  fn init(self: &new, start: u64) {
    *self = Self(total: start);
  }

  pub async fn add(self, n: u64) {
    total = total + n;
  }
}

actor trait ChunkSink {
  pub async fn add(self, n: u64);
}

struct Holder {
  id: i32;
  who: Counter;
  spare: Option[Counter];
  sink: ChunkSink;
}

fn main() {
  let c = Counter(5u64);
  let s: ChunkSink = c;
  let h = Holder(7, c, Some[Counter](c), s);
  print <- toDebug(&h), "\n";
  let k = Holder(8, c, None[Counter], s);
  print <- toDebug(&k), "\n";
  print <- toDebug(&s), "\n";
  finalAll();
}
