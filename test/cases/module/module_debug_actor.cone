// A struct that holds an actor's handle has a debug form: an actor's state is not the
// caller's to read, so the handle is written as the fixed mark <Secret>, as a trait
// object is written as its trait's name.

mod module_debug_actor;

import stdio use *;
import actors;

actor Counter {
  total: u64;

  fn init(self: &new, start: u64) {
    *self = Self(total: start);
  }

  pub async fn add(self, n: u64) {
    total = total + n;
  }
}

struct Holder {
  id: i32;
  who: Counter;
  spare: Option[Counter];
}

fn main() {
  let c = Counter(5u64);
  let h = Holder(7, c, Some[Counter](c));
  print <- toDebug(&h), "\n";
  let k = Holder(8, c, None[Counter]);
  print <- toDebug(&k), "\n";
  finalAll();
}
