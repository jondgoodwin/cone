// A sister of engine: a submodule of the same parent, which is what makes the
// two of them a private universe -- public to each other and to the parent,
// invisible outside it unless the parent publishes them.
//
// It says nothing about its own visibility, and that is right: 'pub mod' opens a
// submodule to its parent's NEIGHBOURS, and a sister is not one of those.

mod wheels;

pub fn turn(n i64) i64 {
  n * 2i64;
}

// Private to this module. A sister sees a sister's public surface and no more,
// which is the boundary being a boundary rather than a wall with a door in it
fn hidden(n i64) i64 {
  n + 1i64;
}
