// A debug build describes its parameters and locals to a debugger: each of a number,
// 'bool' or plain struct type is a variable bound to the stack slot that holds it,
// with its name, type and line, and a plain struct's type names its fields with
// their offsets. A function whose return type and parameters are all so described has
// its real subroutine type. A release build carries none of it, and neither does a
// variable of any other type (a reference, a string).

mod module_debug_locals;

struct Point {
  pub x: i32;
  pub y: f64;
}

fn twice(n: i64, f: f64) i64 {
  n * 2
}

fn mix(scale: f64, count: i64, origin: Point, label: &str) f64 {
  let steps = count + 1;
  let corner = Point(3, scale);
  let big = steps > 2;
  let name = label;
  corner.y * scale + origin.y
}

fn main() {
  let r = mix(1.5, 4, Point(1, 2.5), "unit");
  let t = twice(2, r);
}
