// A number's abs, min, max, floor, ceil, round and fma on SPIR-V's Vulkan form: each
// is the LLVM intrinsic of the same meaning, which LLVM's SPIR-V back end selects as
// GLSL.std.450's extended instruction (FAbs, NMin, NMax, Floor, Ceil, Round, Fma
// for floats; SAbs, SMin, SMax for signed integers), and the module validates.
// A float's min and max are llvm.minimum and llvm.maximum, which give a NaN where
// either side is one; the back end selects the same NMin and NMax for them, and
// those answer the other operand where one is a NaN, so a kernel does NOT keep
// the CPU's answer. This test pins the instructions selected, not that gap (open).

mod module_target_spirv_numbers;

fn @compute(64) floats(inv: Invocation, xs: &Array[f32], out: &mut Array[f32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < xs.len {
    let x = xs[i];
    out[i] = x.abs() + x.min(1.0) + x.max(2.0) + x.floor() + x.ceil() + x.round() + x.fma(x, 1.0);
  }
}

fn @compute(64) ints(inv: Invocation, xs: &Array[i32], out: &mut Array[i32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < xs.len {
    let x = xs[i];
    out[i] = x.abs() + x.min(1) + x.max(2);
  }
}
