// The program instances Maybe and Cell at f64, which gq's object never made,
// and calls their non-inline methods: the instance's methods are emitted in
// this object, as every object that uses an instance defines it.

mod prog;

import stdio use *;
import gq;

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("gqSum", gq.gqSum());
  let m: gq.Maybe[f64] = gq.Just[f64](2.5);
  let n: gq.Maybe[f64] = gq.Nothing[f64];
  show("just", if m.isJust() { 1i64 } else { 0i64 });
  show("nothing", if n.isJust() { 1i64 } else { 0i64 });
  printFloat(m.orElse(9.0));
  printStr("\n");
  printFloat(n.orElse(9.0));
  printStr("\n");
  let jf = gq.Just[f64](1.0);
  show("tag", jf.tag());
  let c = gq.Cell[f64](1.5);
  printFloat(c.get());
  printStr("\n");
  let mi: gq.Maybe[i64] = gq.Just[i64](3i64);
  show("i64", mi.orElse(0i64));
  show("hidden", n.hidden());
  0i32
}


