// 'init' RUNS ONCE PER PROCESS [Jon 6 Nov]. The entry the compiler builds has run
// the stitched init before 'main'; the program's own 'finalAll()' runs the finals
// and finishes the program; an 'initAll()' after that does not start it again but
// panics, naming the rule. The line before the call is printed, the line after
// never is, and the process aborts without reaching the entry's own final.

mod module_init_again;

import stdio use *;

fn @initpure init() {
  printStr("root init\n");
}

fn final() {
  printStr("root final\n");
}

fn main() i32 {
  printStr("main: begin\n");
  initAll();
  finalAll();
  printStr("main: before the second init\n");
  initAll();
  printStr("main: not reached\n");
  0i32
}
