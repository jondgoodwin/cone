// A build description that cannot be read, a mistake per line. Each is
// reported where it is written, and nothing is compiled against a description
// that could not be read, so the files it lists are never looked for.

build: fast                 //~ ErrorBuildDesc "'build' is 'debug' or 'release'"
flavour: sweet              //~ ErrorBuildDesc "not a setting of a build description"
import dep: "dep.cone"
import dep: "dep2.cone"     //~ ErrorBuildDesc "says where package dep is found twice"
p: {
    "src/p.cone"
    import dep "dep.cone"   //~ ErrorBuildDesc "Expected ':' after 'import dep'"
    kid: {
        "src/kid.cone"
        import dep: "other.cone"    //~ ErrorBuildDesc "Module kid's 'import dep' names a different file from the description's package line for dep"
    }
    kid: {                  //~ ErrorBuildDesc "already has a child module named kid"
        "src/kid2.cone"
    }
    empty: {
    }                       //~ ErrorBuildDesc "Module empty lists no source file"
}
output: executable          //~ ErrorBuildDesc "A setting comes before the package's module"
import late: "late.cone"    //~ ErrorBuildDesc "A package line comes before the package's module"
