// A kernel's float arithmetic on SPIR-V's Vulkan form is decorated
// NoContraction, so that no driver fuses a multiply and an add into one
// rounding, or reassociates, and the GPU computes what the CPU does: here a
// multiply-add, a subtraction, a division and a negation, each a result the
// module decorates (and the assembly shows).

mod module_target_spirv_nocontract;

fn @compute(64) muladd(inv Invocation, xs &Array[f32], ys &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len and i < xs.len and i < ys.len {
    imm x = xs[i];
    imm y = ys[i];
    out[i] = x * y + 0.25 - x / y - (-y);
  }
}
