// A bare import folds lib's default, and 'one' meets this module's own
// declaration: the ordinary collision, reported at the import that brought the
// second meaning in. Its advice -- rename with 'as', leave out with 'but' -- is
// a clause this import would write, which replaces the default.
//
// lib's default also names 'nope' and 'hid', which lib reports at its own 'mod'
// line; this import says nothing more about them.

mod clash;

import lib;                 //~ ErrorDupName:1 "one is already a name of this module"

fn one() i64 {
  lib.two();
}
