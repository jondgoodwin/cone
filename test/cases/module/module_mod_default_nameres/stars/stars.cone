// A '* but' default: every public name but those listed. A name after 'but' that
// the module has not got leaves nothing out, as it does on an import.

mod stars use * but nada, final, clone;   //~ ErrorNoMbr:21 "stars has no member named nada to leave out"
                            //~^ ErrorBadFold:27 "final belongs to stars's own lifecycle, so '*' never folds it; there is nothing to leave out"
                            //~^^ ErrorBadFold:34 "clone belongs to stars's own lifecycle, so '*' never folds it; there is nothing to leave out"

pub fn keep() i64 {
  4i64
}

// A finalizer and a clone: the module's own lifecycle, which the default's star
// passes over, so a 'but' naming either has nothing to leave out
pub fn final() {
}

pub fn clone() i64 {
  5i64
}
