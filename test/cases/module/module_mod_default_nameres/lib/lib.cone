// A default may name only a public name of its module: it chooses among what
// 'pub' made reachable, and is no export list of its own. Each refusal is
// reported here, and one is still folded by every bare import.

mod lib use
  one,
  nope,                     //~ ErrorNoMbr:3 "lib has no name nope to fold in"
  hid,                      //~ ErrorNotPublic:3 "hid is private to lib, so it cannot be a default fold"
  final,                    //~ ErrorBadFold:3 "final belongs to lib's own lifecycle, so it cannot be a default fold"
  clone;                    //~ ErrorBadFold:3 "clone belongs to lib's own lifecycle, so it cannot be a default fold"

pub fn one() i64 {
  1i64;
}

pub fn two() i64 {
  2i64;
}

fn hid() i64 {
  3i64;
}

// A finalizer and a clone: the module's own lifecycle, which a fold passes over
// whether '*' or a list asks, so a list naming either has nothing to fold.
pub fn final() {
}

pub fn clone() i64 {
  8i64;
}
