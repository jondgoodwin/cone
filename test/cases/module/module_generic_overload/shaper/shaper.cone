// A sister that declares an overload set holding a generic: a plain candidate
// and one bound by a function signature, both public.

mod shaper;

pub fn taperNum overload taper(m i64, t i64) i64 {
  m * t;
}

pub fn taperBy[F fn(u i64) i64] overload taper(m i64, f &F) i64 {
  f(m);
}

// A private set may hold one too
fn privateBy[F fn(u i64) i64] overload twice(f &F, v i64) i64 {
  f(f(v));
}

pub fn callTwice(v i64) i64 {
  twice(x => x + 10i64, v);
}
