// A generic bound by a function signature in an overload set that another module
// declares: the set is reached by a path and by a wildcard import, and the
// generic is instantiated here, in the caller's module, for the closure it is
// given.

mod module_generic_overload;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  imm k = 5i64;
  // The plain candidate: 3 * 4
  show("plain", shaper.taper(3i64, 4i64));
  // The generic, a closure borrowing k: 3 + 5
  show("closure", shaper.taper(3i64, x => x + k));
  // The full form: 3 * 3
  show("typed", shaper.taper(3i64, fn(u i64) i64 { u * u; }));
  // Called inside the module that declares a private set: (1 + 10) + 10
  show("private", shaper.callTwice(1i64));
  0i32;
}
