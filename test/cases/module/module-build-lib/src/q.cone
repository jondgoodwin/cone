// The first file the build description lists for module q, so the one whose
// 'mod' line may declare it. The line restates the name the description gives.

mod q;

import dep;

pub fn addOne(n i64) i64 {
  n + 1i64;
}

// Reaches the child module the description lists, by path
pub fn deep(n i64) i64 {
  inner.triple(n);
}

// Reaches the module an import line names
pub fn viaDep(n i64) i64 {
  dep.twice(n);
}

pub mut counter i64 = 0;
