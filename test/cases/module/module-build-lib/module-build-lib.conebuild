// A package compiled on its own, from a build description: the file Congo
// hands the compiler to say which files make up which module, and where each
// import is. Nothing is swept: the folder holds files the description does not
// list (unlisted.cone), and they are not compiled.
//
// 'output: library' is what names the root. Its declarations are spelled after
// the package's module, 'q', as an importer of q spells them, rather than bare.

build: release
output: library

q: {
    "src/q.cone"
    "src/more.cone"
    import dep: "dep.cone"
    inner: {
        "src/inner/inner.cone"
    }
}
