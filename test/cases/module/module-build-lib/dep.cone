// The file module q's 'import dep' reaches, because the build description's
// import line says it is here. It stands for another package's include file:
// the importer only declares what it defines, and the name the import line
// gives is the module's name, which its 'mod' line restates.

mod dep;

pub fn twice(n i64) i64 {
  n * 2i64;
}
