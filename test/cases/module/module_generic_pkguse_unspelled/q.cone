// Package q uses g[Point]: the include file has no spelling for a type argument
// that is no number type, and g declares an 'init' that would never run in a
// program that does not name g[Point] itself. The include file is refused
// (ErrorInstanceUnrecorded) rather than left to miss it silently.

mod q;

import g;

struct Point {
  x: i64;
}

pub fn inits() i64 {
  g[Point].inits  //~ ErrorInstanceUnrecorded "would never run"
}
