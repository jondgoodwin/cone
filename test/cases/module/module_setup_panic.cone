// A setup that fails panics at start-up (rule 5), before the module's 'init'
// and the program's 'main'. 'first' runs and prints; 'second' calls 'checked',
// which panics, so neither 'init' nor 'main' runs, and nothing finalizes.

mod module_setup_panic;

import stdio use *;

fn good() i64 {
  printStr("good\n");
  1i64
}

fn checked(n: i64) i64 {
  if n == 1i64 { panic("a setup failed"); }
  n
}

let first: i64 = good();
let second: i64 = checked(first);

fn @initpure init() {
  printStr("init\n");
}

fn main() i32 {
  printStr("main\n");
  0i32
}
