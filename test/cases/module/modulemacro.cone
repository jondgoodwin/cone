// Imported by module-imports-macro.cone. It is never compiled on its own, so it
// is listed in cases.toml as a support module.
//
// It declares a public macro beside a public function, so that a wildcard
// import has a macro node to fold. Its name carries no '-' because a module
// name has to be spellable as an identifier.

macro four {
  4i64
}

fn bump(n i64) i64 {
  n + 1i64
}
