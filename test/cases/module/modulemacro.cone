// Imported by module-imports-macro.cone. It is never compiled on its own, so it
// is listed in cases.toml as a support module.
//
// It declares a public macro beside a public function, so that a wildcard
// import has a macro node to fold. Its name carries no '-' because a module
// name has to be spellable as an identifier.
//
// It also declares a function that uses an anonymous function, the second
// declaration kind that once broke an importer of this module rather than the
// module itself: an anonymous function is lifted to module scope while parsing,
// and lifting one into a module that generates no code segfaulted the compile
// of the importing file. This module compiled cleanly on its own throughout,
// which is what made it look like an import defect rather than a closure one.

pub macro four {
  4i64;
}

pub fn bump(n i64) i64 {
  n + 1i64;
}

fn applyTo(v i64, f &fn(n i64) i64) i64 {
  f(v);
}

pub fn useAnon(v i64) i64 {
  applyTo(v, &fn(n i64) i64 {n * n;});
}
