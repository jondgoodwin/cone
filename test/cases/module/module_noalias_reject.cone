// '@noalias' is refused where it cannot be kept: on a function that does not return a
// pointer or a thin reference, and on an inline function whose value is not the call
// that allocates (an inline function has no symbol, so the attribute goes on that call).

mod module_noalias_reject;

extern fn @c("malloc") rawAlloc(bytes: usize) *u8;

fn @noalias count() i32 {7i32}                    //~ ErrorNoAliasAttr
fn @noalias plain(bytes: usize) *u8 inline {rawAlloc(bytes)}
fn @noalias viaCast(bytes: usize) *i32 inline {rawAlloc(bytes) as *i32}
fn @noalias nullPtr() *u8 inline {0usize as *u8}   //~ ErrorNoAliasAttr
fn @noalias number() i32 inline {7i32}             //~ ErrorNoAliasAttr

fn main() i32 {
  let a = count();
  let b = plain(8usize);
  let c = viaCast(8usize);
  let d = nullPtr();
  let e = number();
  0i32
}
