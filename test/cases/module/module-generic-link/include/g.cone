// Package g's include file. A generic cannot be 'extern': an importer compiles
// each instance it uses itself, so the include carries the generic module's
// full source, g's own. Every object that uses an instance defines it, shared
// ('linkonce_odr', a COMDAT of 'any'), and the linker keeps one copy -- of the
// functions and of the globals, so the instance has one set of globals however
// many objects use it.

mod g[T];

pub mut total T = 0;
pub mut adds i64 = 0i64;
pub mut inits i64 = 0i64;

fn @initpure init() {
  inits = inits + 1i64;
}

pub fn add(x T) T {
  total = total + x;
  adds = adds + 1i64;
  total;
}
