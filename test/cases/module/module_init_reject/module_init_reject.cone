// What a module's 'init' refuses about its own globals, and what a module's
// 'init' and 'final' must be. The root's 'init' holds the global cases; each
// file beside it is a one-file submodule holding one declaration case, since a
// module has one 'init' and one 'final'.
//
//   noinit.cone    a global without a value, in a module with no 'init'
//   params.cone    an 'init' taking a parameter
//   nopure.cone    an 'init' not marked '@initpure'
//   finalret.cone  a 'final' returning a value
//   notfn.cone     a global named 'final'
//   owndrop.cone   a 'drop' of the module's own, where its globals need the one
//                  the module is given

mod module_init_reject;

let assigned i64;
let missed i64;               //~ ErrorGlobalUninit:5 "never assigns it one"
let readearly i64;
let twice i64;
var elsewhere i64;            //~ ErrorGlobalUninit:5 "never assigns it one"

fn @initpure init() {
  assigned = 1i64;
  // Before 'init' assigns it, a global of its module holds nothing to read
  let early = readearly;      //~ ErrorMove:15 "has not been initialized"
  readearly = 2i64;
  // A 'let' global is assigned once, as a 'let' local is
  twice = 3i64;
  twice = 4i64;               //~ ErrorNoMut:3 "permission to modify"
}

// Only 'init' assigns a global declared without a value: assigned anywhere
// else, it does not count, and a 'let' one may not be assigned at all
fn setup() {
  elsewhere = 5i64;
  assigned = 6i64;            //~ ErrorNoMut:3 "permission to modify"
}
