// A module whose global finalizes is given a finalizer named 'drop', whose
// symbol ('owndrop.drop') a 'drop' of its own would also be spelled

mod owndrop;

struct Res {
  pub n i64;
  fn final(self &uni) {}
}

mut r Res = Res[1i64];

fn drop() {                   //~ ErrorModLifecycle:1 "may not declare a drop of its own"
}
