// A file in an organisational subfolder of module_header_reject: sub/ holds no
// sub.cone, so its files join the module around it and, like second.cone, have
// no 'mod' line. Its import, below a declaration and 'pub', is refused as one
// with no 'mod' line to follow, not as one written late.

fn third() i64 {
  3i64;
}

pub import "../../modulex";      //~ ErrorImportLate "has no 'mod' line"
