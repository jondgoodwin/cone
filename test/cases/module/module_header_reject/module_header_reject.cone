// An import below the header of a file that is not its folder's designated
// file. second.cone has no 'mod' line, as a file its folder sweeps in must not,
// so its header is its imports alone, and an import after its first
// declaration is refused as one after a 'mod' line is (module_parse_header has
// the spellings).
//
// Parse stage, which is why it is its own scenario.

mod module_header_reject;

fn designated() i64 {
  1i64;
}
