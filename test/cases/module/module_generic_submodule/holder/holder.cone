// A GENERIC MODULE drawn from a folder, holding a one-file submodule, inner.
// Each instance holds its own copy of inner, with T substituted, its own
// globals and its own 'init' and 'final'.
pub mod holder[T];

import seq;
import stdio use *;

pub var @threadlocal kept: T = 0;
pub let order: i64;

fn @initpure init() {
  order = seq.take();
  printStr("init holder, order ");
  printInt(order);
  printStr("\n");
}

fn final() {
  printStr("final holder, inner.hits ");
  printInt(inner.hits);
  printStr("\n");
}

// The module naming its submodule: this instance's copy of it
pub fn keep(x: T) T {
  kept = inner.twice(x);
  kept
}
