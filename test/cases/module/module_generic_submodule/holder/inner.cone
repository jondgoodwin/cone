// The submodule: its parent's T is in scope, as a generic type's methods see
// the type's
pub mod inner;

import stdio use *;

pub var @threadlocal hits: i64 = 0i64;
pub var @threadlocal start: T = 0;

fn @initpure init() {
  start = 1;
  printStr("init inner\n");
}

fn final() {
  printStr("final inner, hits ");
  printInt(hits);
  printStr("\n");
}

pub fn twice(x: T) T {
  hits = hits + 1i64;
  x + x
}
