// A release build, the default, carries debug information: a subprogram for
// each function the object defines (here 'twice', and 'main', the program's
// entry), so a profiler can name them. module_debug_strip is the same program
// stripped.
mod module_debug_info;

fn twice(n: i32) i32 {
  n * 2
}

fn main() {
  let n = twice(21);
}
