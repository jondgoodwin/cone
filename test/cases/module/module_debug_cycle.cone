// A debug form that follows an Rc round a cycle ends: past the writer's depth limit
// (128 open generated bodies: a Node and the Some it holds each count) a body writes
// '...'. The text is long, so the test shows its start, the place the limit is
// reached, and its end: after the '...' come the closers ')}' of what is still open.

mod module_debug_cycle;

import stdio use *;
import collections use *;

struct Node {
  pub var n: i32;
  pub var next: Option[Rc[mut, Node]];
}

fn main() {
  let a = Rc[mut, Node](Node(1, None));
  let b = Rc[mut, Node](Node(2, Some[Rc[mut, Node]](a)));
  a.next = Some[Rc[mut, Node]](b);
  var s = String();
  s <- toDebug(&a);
  let n = s.len();
  print <- s.sub(0usize, 46usize), "\n";
  print <- s.sub(n - 150usize, n - 110usize), "\n";
  print <- s.sub(n - 20usize, n), "\n";
}
