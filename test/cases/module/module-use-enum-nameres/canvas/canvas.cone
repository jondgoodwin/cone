// A sister of palette, wildcard-importing it.

mod canvas;

import palette.*;

// A wildcard import folds what palette shows, and palette folded Shade's variants
// privately: Light is a name of palette that no other module sees. Shade itself is
// public, so the variant is still reached through it.
pub fn shade() {
  imm reached = Shade.Light[];
  imm bare = Light[];           //~ ErrorUnkName:14 "The name Light does not refer to a declared name"
}

// Red arrived with the import, as a public fold of palette's. A fold of this
// module's own that brings in another Red collides with it, as two imports
// folding one name would.
enum Paint {
  Red, Ochre;
}
use Paint;                      //~ ErrorDupName:1 "Red is already a name of this module"
