// What a module's fold of an enum's variants does not put in reach.
//
// A fold is private to the module that made it unless it is 'use pub', exactly as
// an import's fold and a global's are. Name resolution stage: a fold is expanded
// in the module's fold pass, and a path and a wildcard import read what it left.
//
// The folder holds:
//   palette/palette.cone   folds Colors 'use pub' and Shade privately
//   canvas/canvas.cone     a sister that wildcard-imports palette

fn main() i32 {
  // A public fold is a public name of palette, reached by a path
  imm green = palette.Green[];

  // A private one is palette's own, and a path from outside refuses it as it
  // refuses any private name of a module
  imm dark = palette.Dark[];      //~ ErrorNotPublic:22 "private to its module"
  0i32;
}
