// More of module_privacy: no 'mod' line, so the same module as the designated
// file, and its code sees that file's types' private members as its own.

fn forge() Vault {
  new Vault(id: 1, secret: 4);
}

fn audit(v &Vault) i32 {
  v.secret + v.peek();
}

fn seal() Sealed {
  new Sealed(2, 5);
}

struct Clerk {
  scale i32;
  pub fn tally(self &, v &Vault) i32 { v.secret * scale + v.peek(); }
}

// Reached from the designated file
struct Ledger {
  total i32;
  fn bump(self &mut) { total = total + 1; }
}
