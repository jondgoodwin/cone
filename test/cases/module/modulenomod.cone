// Imported by module_parse_nomod.cone, and never compiled on its own, so it is
// listed in cases.toml as a support module.
//
// A lone file an import reached, and so a module whose first file opens with
// its 'mod' line. It opens with a module trait instead: 'mod trait' declares a
// trait of the module and names no module, so it is no 'mod' line, and the
// statement is refused for it.

pub mod trait Sized {   //~ ErrorNoModDcl:1 "begin it with 'mod modulenomod;'"
  pub fn size() i64;
}
