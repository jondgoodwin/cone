// A compute kernel that compares floats, on SPIR-V's Vulkan form: each entry
// point of the module declares SignedZeroInfNanPreserve for 32 bits, without
// which a Vulkan driver may answer 't != t' false for a NaN it computed.
// packages/gpuwork/tests/kernels.cone runs the comparisons on a GPU.

mod module_target_spirv_floatpreserve;

fn @compute(64) nans(inv: Invocation, xs: &Array[f32], out: &mut Array[u32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < xs.len {
    let t = xs[i].trunc();
    out[i] = if t != t {1u32} else {0u32};
  }
}

fn @compute(64) halve(inv: Invocation, out: &mut Array[f32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len { out[i] = out[i] * 0.5; }
}
