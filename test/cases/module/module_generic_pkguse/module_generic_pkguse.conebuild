// A generic instance only a package uses. Package g (a generic module) and
// package q (which uses g[i64]) are compiled on their own; the program imports
// q and never names g[i64]. The program's compile must still build the instance,
// from q's include file, so that its 'init' and 'final' run.

build: debug
output: executable

import g: "include/g.cone"
import q: "include/q.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import g: "include/g.cone"
    import q: "include/q.cone"
    import stdio: "stdio.cone"
}
