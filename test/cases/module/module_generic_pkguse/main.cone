// The program imports package q and never names g[i64], which only q uses. The
// program's stitched init must still run g[i64]'s 'init', once, before q's, and
// its 'final' after q's.

mod prog;

import stdio use *;
import q;

fn main() i32 {
  printInt(q.addTwice(5i64));
  printStr(" ");
  printInt(q.inits());
  printStr("\n");
  0i32
}
