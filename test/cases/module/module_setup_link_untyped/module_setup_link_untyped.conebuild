// A program whose stitched init and final call the 'init' and the finalizer of
// a package compiled on its own. Package lib is compiled first
// (package\lib.conebuild, listed under 'link' in cases.toml; the folder is not
// named 'lib', which .gitignore ignores), and this program is compiled against the
// include file lib's compile generates, which declares lib's 'init', 'final',
// the global they finalize and its type's 'final'. The two objects are then
// linked, with conestd, and run. lib's include file imports stdio, as lib's
// source does, which the package line for stdio answers.

build: debug
output: executable

import lib: "include/lib.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import lib: "include/lib.cone"
    import stdio: "stdio.cone"
}
