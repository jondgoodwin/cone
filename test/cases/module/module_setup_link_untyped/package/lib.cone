// Package lib's source: untyped setups and no 'init'. The type of a 'pub' setup
// is its value's, which the include file must spell out, as it does for a
// typed one. A library compile gives the module an 'init' that runs them, and
// exports it for the program's stitched init to call.

mod lib;

import stdio use *;

pub struct Handle {
  pub id: i64;
  fn final(self: &uni) {
    printStr("lib handle final ");
    printInt(id);
    printStr("\n");
  }
}

fn make(id: i64) Handle {
  printStr("lib make ");
  printInt(id);
  printStr("\n");
  Handle(id)
}

// Declared in the reverse of the order they run
pub let second = make(first.id + 1i64);
pub let first = make(1i64);
