// The program: its stitched init runs lib's setups, which lib's object holds
// and lib's include file declares only as its 'init', before the program's own,
// and no global of either is finalized as the program ends, so no 'handle
// final' line prints. The program calls neither 'initAll()' nor 'finalAll()'.

mod prog;

import stdio use *;
import lib;

let doubled: i64 = lib.second.id * 2i64;

fn main() i32 {
  printStr("lib ");
  printInt(lib.first.id);
  printInt(lib.second.id);
  printStr(" doubled ");
  printInt(doubled);
  printStr("\n");
  0i32
}
