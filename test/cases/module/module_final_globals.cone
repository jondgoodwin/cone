// A module's finalizer finalizes every global whose value has anything to do as
// it dies, the question a local's death asks: an owning reference is released
// (its value finalized, then freed through its region), plain or virtual, single
// or counted, and a tuple or an array is finalized element by element. Before,
// only a global whose type is a struct or an enum was: an owner held in a
// global leaked, and so did a tuple or an array of values that finalize.
//
// The module's own 'final' runs first, then each global in the reverse of the
// order set, once each: 'row' has its value where declared and 'init' never
// sets it, so it is set first and finalized last; 'init' sets the rest in the
// order declared. 'One' is a single-owner region and 'Tally' a counted one; both
// count their allocations and frees and print each free, and 'Tally' prints
// each count change: '+n' after an 'aliasRef', '-n' after a 'dealiasRef'. 'F<n>' is a
// Fin's 'final'. A counted 'Tally' (its count is not atomic) is not Shareable, so it is no longer
// a global: it is a local here, moved into another and released with it. Replacing a global owner
// needed a plain 'var', refused (ErrorGlobalShare), so the owners that are replaced sit in a struct
// behind a lock-guarded global ('Arc[Mutex, Owners]'); the other globals are 'let's set in 'init'. The
// counts at the end say every allocation was freed, and freed once.

mod module_final_globals;

import stdio use *;
import libc;
import sync use Mutex, Arc;

var @threadlocal allocs = 0i64;
var @threadlocal frees = 0i64;

struct One is RegionRef, Move {
  fn alloc(size: usize) *u8 inline { allocs = allocs + 1; malloc(size) }
  fn free(self: &uni One) inline { frees = frees + 1; printStr("free "); libc.free(self as *u8); }
}

struct Tally is RegionRef {
  owners: u32;
  fn alloc(size: usize) *u8 inline { allocs = allocs + 1; malloc(size) }
  fn init(self: &new) inline { *self = Tally(1u32); }
  fn aliasRef(self: &uni Tally) inline { owners = owners + 1u32; printStr("+"); printInt(i64.from(owners)); printStr(" "); }
  fn dealiasRef(self: &uni Tally) bool inline { owners = owners - 1u32; printStr("-"); printInt(i64.from(owners)); printStr(" "); owners == 0u32 }
  fn free(self: &uni Tally) inline { frees = frees + 1; printStr("tfree "); libc.free(self as *u8); }
}

trait App {
  pub fn look(self: &) i64;
}

struct Fin {
  pub n: i64;
  pub fn look(self: &) i64 {n}
  fn final(self: &uni) { printStr("F"); printInt(n); printStr(" "); }
}

struct Owners {
  pub own: One[Fin];
  pub vown: One[App + Shareable];
}

let guard: Arc[Mutex, Owners];
let pair: (Fin, i64);
let row = [Fin(7), Fin(8)];
let sofin: Uni[Fin];
let vso: Uni[App + Shareable];

fn pairOf(n: i64) Fin, i64 { Fin(n), n }

fn @initpure init() {
  guard = Arc[Mutex, Owners](Owners(One[Fin](1), One[Fin](2)));
  pair = pairOf(5);
  sofin = Uni[Fin](4);
  vso = Uni[Fin](6);
}

fn final() {
  printStr("final ");
}

fn main() i32 {
  initAll();
  printStr("shared with a local: ");
  {
    let shared = Tally[mut, Fin](3);
    {
      let loc = shared;
      printInt(loc.look());
      printStr(" ");
    }
  }
  printStr("\nreplaced: ");
  {
    let owners = &mut *guard;
    owners.own = One[Fin](9);
    owners.vown = One[Fin](10);
  }
  printStr("\nfinalAll: ");
  finalAll();
  printStr("\nallocs ");
  printInt(allocs);
  printStr(" frees ");
  printInt(frees);
  printStr("\n");
  0i32
}
