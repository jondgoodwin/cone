// No global is finalized: the module's 'final' runs and that is all, whatever
// the globals hold -- an owning reference, plain or virtual, a tuple, an array,
// a lock around owners. A value assigned over is still finalized, in a global or
// not. The module may declare a 'drop' of its own: no finalizer takes the name.
//
// 'One' is a single-owner region and 'Tally' a counted one; both count their
// allocations and frees and print each free, and 'Tally' prints each count
// change: '+n' after an 'aliasRef', '-n' after a 'dealiasRef'. 'F<n>' is a Fin's
// 'final'. A counted 'Tally' (its count is not atomic) is not Shareable, so it is
// a local here, moved into another and released with it. Replacing a global owner
// needs a plain 'var', refused (ErrorGlobalShare), so the owners that are
// replaced sit in a struct behind a lock-guarded global ('Arc[Mutex, Owners]');
// the other globals are 'let's set in 'init'. The counts at the end say that
// the two owners replaced and the local were freed, and the two the global still
// holds were not.

mod module_final_globals;

import stdio use *;
import libc;
import sync use Mutex, Arc;

var @threadlocal allocs = 0i64;
var @threadlocal frees = 0i64;

struct One is RegionRef, Move {
  fn alloc(size: usize) *u8 inline { allocs = allocs + 1; malloc(size) }
  fn free(self: &uni One) inline { frees = frees + 1; printStr("free "); libc.free(self as *u8); }
}

struct Tally is RegionRef {
  owners: u32;
  fn alloc(size: usize) *u8 inline { allocs = allocs + 1; malloc(size) }
  fn init(self: &new) inline { *self = Tally(1u32); }
  fn aliasRef(self: &uni Tally) inline { owners = owners + 1u32; printStr("+"); printInt(i64.from(owners)); printStr(" "); }
  fn dealiasRef(self: &uni Tally) bool inline { owners = owners - 1u32; printStr("-"); printInt(i64.from(owners)); printStr(" "); owners == 0u32 }
  fn free(self: &uni Tally) inline { frees = frees + 1; printStr("tfree "); libc.free(self as *u8); }
}

trait App {
  pub fn look(self: &) i64;
}

struct Fin {
  pub n: i64;
  pub fn look(self: &) i64 {n}
  fn final(self: &uni) { printStr("F"); printInt(n); printStr(" "); }
}

struct Owners {
  pub own: One[Fin];
  pub vown: One[App + Shareable];
}

let guard: Arc[Mutex, Owners];
let pair: (Fin, i64);
let row = [Fin(7), Fin(8)];
let sofin: Uni[Fin];
let vso: Uni[App + Shareable];

fn pairOf(n: i64) Fin, i64 { Fin(n), n }

fn @initpure init() {
  guard = Arc[Mutex, Owners](Owners(One[Fin](1), One[Fin](2)));
  pair = pairOf(5);
  sofin = Uni[Fin](4);
  vso = Uni[Fin](6);
}

fn final() {
  printStr("final ");
}

// An ordinary function, in a module whose globals' types finalize
fn drop() {
  printStr("\nown drop");
}

fn main() i32 {
  initAll();
  printStr("shared with a local: ");
  {
    let shared = Tally[mut, Fin](3);
    {
      let loc = shared;
      printInt(loc.look());
      printStr(" ");
    }
  }
  printStr("\nreplaced: ");
  {
    let owners = &mut *guard;
    owners.own = One[Fin](9);
    owners.vown = One[Fin](10);
  }
  drop();
  printStr("\nfinalAll: ");
  finalAll();
  printStr("\nallocs ");
  printInt(allocs);
  printStr(" frees ");
  printInt(frees);
  printStr("\n");
  0i32
}
