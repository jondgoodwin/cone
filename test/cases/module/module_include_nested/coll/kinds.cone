// Package coll's one-file submodule kinds.

pub mod kinds;

pub enum Kind {
  Small, Large;
}
use Kind;

// Called only by a body of the root's that the program does not expand: left out
pub fn kindOf(n i64) Kind {
  if n < 10i64 {Small[];} else {Large[];}
}

// A size, which a global of the root's and a field of the root's type hold
pub struct Size {
  pub n i64;

  pub fn twice(self) i64 {
    n * 2i64;
  }
}

// What a parameter of the root's function takes by default
pub const Factor = 3i64;

// Reached by nothing: left out
pub const Unused = 0i64;
