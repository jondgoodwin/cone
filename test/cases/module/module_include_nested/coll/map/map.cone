// Package coll's submodule map: a map of one key, kept on vec's stack, and a
// generic entry.

pub mod map;

import vec;

// Its value is held in a slot, which map's own submodule declares
pub struct Map {
  pub keys vec.Stack;
  vals slot.Slot;

  pub fn of(k i64, v i64) Map {
    Map[vec.stackOf(k, 0i64), slot.Slot[v]];
  }

  pub fn get(self, k i64) i64 {
    if keys.sum() == k {vals.doubled();} else {0i64;}
  }
}

// A generic type and a generic function, whose bodies travel
pub struct Entry[T] {
  pub key i64;
  pub val T;

  pub fn keyPlus(self, n i64) i64 {
    key + n;
  }
}

pub fn entryOf[T](k i64, v T) Entry[T] {
  Entry[T][k, v];
}

// A macro, which travels, and the private function it reaches, which the
// include file declares
pub macro bonus[x] {
  x + base();
}

fn base() i64 {
  4i64;
}
