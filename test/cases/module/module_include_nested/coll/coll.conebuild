// Package coll, compiled on its own into a library object, which writes its
// include file: the root, and a nested module block for each submodule it
// reaches, holding only what it reaches.

build: debug
output: library

coll: {
    "coll.cone"
    kinds: {
        "kinds.cone"
    }
    map: {
        "map/map.cone"
        slot: {
            "map/slot/slot.cone"
        }
    }
    pair: {
        "pair.cone"
    }
    util: {
        "util/util.cone"
    }
    vec: {
        "vec/vec.cone"
    }
}
