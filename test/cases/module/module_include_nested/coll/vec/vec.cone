// Package coll's submodule vec: a small stack of numbers.

pub mod vec;

// A stack of at most three numbers
pub struct Stack {
  pub len i64;
  a i64;
  b i64;
  c i64;

  pub fn empty() Stack {
    Stack[0i64, 0i64, 0i64, 0i64];
  }

  // The stack with one more number on it
  pub fn push(self, v i64) Stack {
    if len == 0i64 {Stack[1i64, v, b, c];}
    elif len == 1i64 {Stack[2i64, a, v, c];}
    else {Stack[3i64, a, b, v];}
  }

  pub fn sum(self) i64 {
    a + b + c;
  }

  pub fn top(self) i64 {
    at(len - 1i64);
  }

  // Private: reached only from the stack's own methods, so left out
  fn at(self, i i64) i64 {
    if i == 0i64 {a;} elif i == 1i64 {b;} else {c;}
  }
}

// A stack holding two numbers
pub fn stackOf(x i64, y i64) Stack {
  Stack.empty().push(x).push(y);
}

// Named by the root's inline body, so declared in the include file
pub fn scaled(s Stack, k i64) i64 {
  s.sum() * k;
}

// Reached by nothing outside vec: left out
pub fn unseen() i64 {
  0i64;
}
