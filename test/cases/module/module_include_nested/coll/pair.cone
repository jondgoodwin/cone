// Package coll's one-file submodule pair: a generic module, whose every
// declaration is instantiated where it is used, so its block holds its whole
// text and the program instantiates it itself.

mod pair[T];

pub struct Pair {
  pub a T;
  pub b T;

  pub fn swap(self) Pair {
    Pair[b, a];
  }
}

pub fn of(a T, b T) Pair {
  Pair[a, b];
}
