// Package coll: a small collections package, laid out as a root and submodules
// the way a collections library is. Its public API lives in the submodules and
// is re-exported here, at the root, which is all an importer sees.

mod coll;

// vec's stack, and the function that makes one
pub use vec Stack, stackOf;

// Everything public of map's: Map, the generic Entry, entryOf and a macro
pub use map;

// An enum a one-file submodule holds, by name and then its variants
pub use kinds Kind;
pub use kinds.Kind;

// A function whose signature names a submodule's type
pub fn countOf(s &vec.Stack) i64 {
  s.len;
}

// A body the program expands: it names vec's function by path and map's
// macro, so the include file declares both
pub fn weighted(s Stack) i64 inline {
  vec.scaled(s, 10i64) + bonus[1i64];
}

// Signatures naming the one-file submodule's enum
pub fn classify(n i64) kinds.Kind {
  kinds.kindOf(n);
}

pub fn code(k Kind) i64 {
  if k is Small {1i64;} else {2i64;}
}

// A generic submodule's instance in a signature
pub fn pairOf(a i64, b i64) pair[i64].Pair {
  pair[i64].of(a, b);
}

// A global of a submodule's type, the type inferred, and a type holding one
pub mut unit = kinds.Size[1i64];

pub struct Sized {
  pub size kinds.Size;

  pub fn get(self) i64 {
    size.twice();
  }
}

// A parameter's default naming a submodule's const, which the program
// evaluates where it calls
pub fn scale(n i64, times i64 = kinds.Factor) i64 {
  n * times;
}

// Private and reached by nothing the program sees: left out, and so is the
// typedef naming it
struct Hidden {
  n i64;
}

typedef Alias Hidden;

// A private function's signature and a private helper's body name submodules'
// names, and neither is in the include file
fn quiet() vec.Stack {
  vec.stackOf(1i64, 2i64);
}

fn helper() i64 {
  util.twice(3i64);
}
