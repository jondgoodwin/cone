// The program, compiled against the include file coll's compile generated
// (the golden file under include\), and linked with coll's object and conestd.

build: debug
output: executable

import stdio: "stdio.cone"
import coll: "include/coll.cone"

prog: {
    "main.cone"
    import coll: "include/coll.cone"
    import stdio: "stdio.cone"
}
