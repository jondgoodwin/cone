// The program: compiled against the include file coll's compile generated, and
// linked with coll's object. Everything it uses it reaches through coll's root.

mod prog;

import stdio use *;
import coll;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // vec's stack, through the root: its methods are coll.vec's
  imm s = coll.stackOf(3i64, 4i64).push(5i64);
  show("sum", s.sum());
  show("top", s.top());
  show("countOf", coll.countOf(&s));

  // An inline body, expanded here: vec's function and map's macro
  show("weighted", coll.weighted(s));
  show("bonus", coll.bonus[2i64]);

  // map's type, which holds vec's stack and map.slot's slot
  imm m = coll.Map.of(7i64, 8i64);
  show("get", m.get(7i64));
  show("miss", m.get(6i64));
  show("keys", m.keys.sum());

  // A generic, instantiated here
  imm e = coll.entryOf[i64](2i64, 30i64);
  show("entry", e.val + e.keyPlus(1i64));

  // The one-file submodule's enum and its variants
  show("classify", coll.code(coll.classify(12i64)));
  imm k coll.Kind = coll.Small[];
  show("small", coll.code(k));

  // A generic submodule's instance: the program instantiates its method
  imm p = coll.pairOf(5i64, 6i64).swap();
  show("pair", p.a * 10i64 + p.b);

  // A global of a submodule's type, and a type holding one
  show("unit", coll.unit.n);
  show("sized", coll.Sized[coll.unit].get());

  // A parameter's default, a submodule's const, evaluated here
  show("scale", coll.scale(4i64));
  show("scaleBy", coll.scale(4i64, 5i64));

  0i32;
}
