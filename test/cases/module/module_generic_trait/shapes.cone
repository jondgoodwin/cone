// A GENERIC MODULE declaring a trait, which every instance holds a copy of with
// the module's parameter substituted, as do the types that take it: each
// instance's Box and Pair are its own Has's. The trait has a requirement and a
// default, each naming T, and is used through a virtual reference and as a
// generic function's bound.
pub mod shapes[T];

pub trait Has {
  pub fn get(self: &) T;           // a requirement
  pub fn twice(self: &) T {        // a default
    self.get() + self.get()
  }
}

pub struct Box is Has {
  pub v: T;
  pub fn get(self: &) T {
    v
  }
}

pub struct Pair is Has {
  pub a: T;
  pub b: T;
  pub fn get(self: &) T {
    a + b
  }
}

// Through a virtual reference: dispatched through this instance's vtables
fn viaRef(h: &<Has) T {
  h.twice()
}

// As a bound
fn viaBound[X: Has](x: &X) T {
  x.get()
}

pub fn run(x: T) T {
  let b = Box(x);
  let p = Pair(x, x);
  viaRef(&b) + viaRef(&p) + viaBound(&b) + viaBound(&p)
}
