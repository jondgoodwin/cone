// A TRAIT INSIDE A GENERIC MODULE, treated as a generic type's members are [Jon
// 23 Sep]: each instance, shapes[i64] and shapes[f64], holds its own copy of
// Has with T substituted, and its own Box and Pair taking that copy, so each
// instance's vtables are its own.
//
// This is the designated file of the scenario's folder; shapes.cone beside it
// is the generic module. Each printed value was checked by hand against the
// source: run(x) is 2x + 4x + x + 2x = 9x.

mod module_generic_trait;

import stdio use *;

fn main() {
  printStr("shapes[i64].run = ");
  printInt(shapes[i64].run(1i64));          // 9
  printStr("\nshapes[f64].run = ");
  printFloat(shapes[f64].run(0.5));         // 4.5
  printStr("\n");
}
