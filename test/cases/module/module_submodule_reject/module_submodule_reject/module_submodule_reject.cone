//~ ErrorDupName:1 "already defined"
// A submodule named like the module whose folder holds it. The parent's own name
// is bound in the parent's namespace before any submodule is drawn, so binding
// this one there is the duplicate. Both halves are reported at the first line of
// a designated file -- this one's on line 1 here, and the parent's on line 1 of
// the scenario's own file -- because the collision is found when the submodule
// is drawn, before either file's 'mod' line is parsed.

mod module_submodule_reject;

pub fn innerFn(n i64) i64 {
  n;
}
