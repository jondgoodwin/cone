// An ordinary submodule, here only so that the import in the scenario's
// designated file has one to name. It is reached by writing 'sub.subFn', never by
// importing it. Its declaration is also where a collision with its name in the
// parent is reported, since a declaration is nearer than the first line of this
// file, where a submodule that declares nothing is reported (bare/bare.cone).

mod sub;           //~ ErrorDupName:1 "conflicting definition"

pub fn subFn(n i64) i64 {
  n;
}
