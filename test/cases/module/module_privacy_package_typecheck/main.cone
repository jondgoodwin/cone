// A program importing package h reaches only what h makes public. A type's
// private members are h's, so they are refused here, though the include file
// declares them for h's own inline body (module_include_private_reach runs
// that body here): Outer's private method and private field.
//
// Type-check stage: the program parses and resolves cleanly, so every
// diagnostic below is reached.

mod prog;

import h;

fn main() i32 {
  imm o = h.make(9i64);
  imm a = o.tag();          //~ ErrorNotPublic:12 "May not access the private method/field `tag`."
  imm i = o.inner;          //~ ErrorNotPublic:12 "May not access the private method/field `inner`."
  i32.from(h.val(o) + a);
}
