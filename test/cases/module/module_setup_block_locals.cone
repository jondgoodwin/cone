// A block that gives a 'let' global its value is run by the module's setup, and declares locals
// as any block does: 'let' and 'var', started by a call or any other value, not only a constant.
// The scope is the block's own: a local is seen from its declaration to the block's end (a block
// inside it too) and by nothing after. The setups run in the order their globals read one another.
// Every value printed is worked out by hand from the code.

mod module_setup_block_locals;
import stdio use *;

fn three() i64 { 3i64 }
fn some() Option[i64] { Some(4i64) }

// 3 + 1 = 4
let a: i64 = { let y = three(); y + 1i64 };
// z = 2, w = three() = 3, 3 + 2 = 5
let b: i64 = { let z = 2i64; let w = three(); w + z };
// y starts at 3 and the loop adds 1 twice: 5
let c: i64 = { var y = three(); y += 1i64; y += 1i64; y };
// a block inside the block sees the outer local: 3 * 2 = 6
let d: i64 = { let x = three(); { let k = x * 2i64; k } };
// the hidden variable of an 'if let': 4
let e: i64 = if let Some(x) = some() { x } else { 0i64 };
// a setup that reads another: a + b = 9
let f: i64 = { let s = a; s + b };

fn main() {
  print <- a; print <- " ";
  print <- b; print <- " ";
  print <- c; print <- " ";
  print <- d; print <- " ";
  print <- e; print <- " ";
  print <- f; print <- "\n";
}
