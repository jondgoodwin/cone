// ONE DECLARATION REACHED BY TWO ROUTES: the diamond.
//
// Two bindings of the same declaration under the same name are not a collision:
// the second is the binding the name has already [Jon 23 Sep]. c declares x; a
// and b each re-export it; d wildcard-imports both, so x reaches d twice, and it
// is one name meaning one thing. Before the rule, d was refused at its second
// import, 'x is already a name of this module'.
//
// Where one route is public and the other private, the binding is public, so a
// re-export is not lost to whichever route folded first. p and q write the same
// two imports in opposite orders, and each re-exports x either way.
//
// The folder holds:
//   c/c.cone   declares x
//   a/a.cone   re-exports c's names
//   b/b.cone   re-exports c's names
//   d/d.cone   wildcard-imports a and b, privately
//   p/p.cone   imports a privately, then b with 'pub use'
//   q/q.cone   imports b with 'pub use', then a privately

import stdio.*;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("diamond", d.y());
  show("public-second", p.x());
  show("public-first", q.x());
  0i32;
}
