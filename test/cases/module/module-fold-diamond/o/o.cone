// 'use Option;' is written, and the implicit core import has brought Some and
// None already, by its wildcard. The module wrote each name once, so each is
// the binding it already has.

mod o;

use Option;

pub fn oo() i64 {
  imm s Option[i64] = Some[7i64];
  match s {
    case imm v Some {v.value;}
    case is None {0i64;}
  }
}
