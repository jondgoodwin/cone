// Module qualifiers and imported names that resolve to nothing.
//
// Name-resolution stage only: this file parses cleanly, and name resolution
// returns before type checking, so a type-check expectation here would never
// run.
//
// All four are ErrorUnkName, because a qualifier that names no module, a
// qualifier that names something that is not a namespace, and a member a
// namespace does not hold are all the same failure to find a declaration. The
// quoted substrings are what tell them apart.
//
// The imported module is modulesub.cone.

import modulesub

// An import without '::*' folds nothing, so the module's members are not names
// of this module
fn notFolded() i64 {
  plain(7i64)               //~ ErrorUnkName:3 "The name plain does not refer to a declared name"
}

fn noSuchModule() i64 {
  nosuch::plain(7i64)       //~ ErrorUnkName:3 "Namespace nosuch does not exist"
}

// A qualifier has to name a module or a type; a function is neither
fn notANamespace() i64 {
  notFolded::plain(7i64)    //~ ErrorUnkName:3 "notFolded is not a valid namespace"
}

fn noSuchMember() i64 {
  modulesub::nothere(7i64)  //~ ErrorUnkName:3 "The name nothere does not refer to a declared name"
}
