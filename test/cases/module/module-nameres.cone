// Module qualifiers and imported names that resolve to nothing.
//
// Name-resolution stage only: this file parses cleanly, and name resolution
// returns before type checking, so a type-check expectation here would never
// run.
//
// Six of these are ErrorUnkName, because a qualifier that names no module, a
// qualifier that names something that is not a namespace, and a member a
// namespace does not hold are all the same failure to find a declaration. The
// quoted substrings are what tell them apart. The seventh is ErrorNotPublic and
// is a different thing: the declaration is found, and may not be reached.
//
// The imported modules are modulesub.cone, without folding, and modulesyms.cone
// folded, so that its type and global are names of this module and can be
// tried as qualifiers.

import modulesub
import modulesyms::*

// An import without '::*' folds nothing, so the module's members are not names
// of this module
fn notFolded() i64 {
  plain(7i64)               //~ ErrorUnkName:3 "The name plain does not refer to a declared name"
}

fn noSuchModule() i64 {
  nosuch::plain(7i64)       //~ ErrorUnkName:3 "Namespace nosuch does not exist"
}

// A qualifier has to name a module or a type; a function is neither
fn notANamespace() i64 {
  notFolded::plain(7i64)    //~ ErrorUnkName:3 "notFolded is not a valid namespace"
}

fn noSuchMember() i64 {
  modulesub::nothere(7i64)  //~ ErrorUnkName:3 "The name nothere does not refer to a declared name"
}

// A type is a namespace, so a qualifier may name one, and a member it does not
// hold is the same failure as a module's missing member
fn noSuchMemberOfType() i32 {
  Gadget::nothere(1)        //~ ErrorUnkName:3 "The name nothere does not refer to a declared name"
}

// ... while a global, like a function, is not a namespace at all
fn globalAsQualifier() i64 {
  shared::x                 //~ ErrorUnkName:3 "shared is not a valid namespace"
}

// refmodule.html: a name beginning with an underscore is private and may not be
// referenced outside its module. Qualifying reaches past the import, so this is
// the path the fold cannot filter. Code generation emits no symbol for a private
// declaration of a module it is not generating, so the call site used to be left
// holding nothing to call.
fn privateAcrossModules() f64 {
  modulesub::_scaleFloat(1.5d)  //~ ErrorNotPublic:3 "private to its module"
}
