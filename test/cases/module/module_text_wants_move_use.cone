// A piece moved into a sink whose 'wants' may decline is maybe-moved afterwards: reading it
// is the ordinary 'moved out' refusal, which conditional moves already get.

mod module_text_wants_move_use;

import stdio use *;
import collections use *;

struct Item {
  pub var id: i32;
  fn final(self: &uni) { }
}

struct Sink {
  pub var on: bool;
  pub var buf: String;
  pub fn wants(self: &) bool { self.on }
  pub fn append overload `<-`(self: &mut, s: &str) { self.buf <- s; }
  pub fn take overload `<-`(self: &mut, i: Item) { self.buf <- "took"; }
}

fn main() i32 {
  var sink = Sink(false, String());
  let it = Item(7);
  sink <- "x", it;
  print <- it.id;        //~ ErrorMove:12 "moved out"
  0
}
