// What an import within the tree does NOT put in reach.
//
// Name-resolution stage: the imports themselves are accepted, and what is
// refused is what each name reaches once the bindings are in place.
//
// The folder holds:
//   left/left.cone        imports its sister and reaches past what she shows
//   left/deep/deep.cone   a submodule of left, which is not in left's universe
//   right/right.cone      the sister, with one public name and one private

fn caller(n i64) i64 {
  left.reach(n);
}
