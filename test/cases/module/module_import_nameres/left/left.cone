// A module that imports its sister and then asks her for more than she shows.
//
// The import binds her name here and nothing else: what it binds is an alias,
// and what a path through it may reach is decided by each name's own visibility
// in her, exactly as a path down into a submodule is.

mod left;

import right;

pub fn reach(n i64) i64 {
  // What she shows
  right.shown(n);
}

fn past(n i64) i64 {
  // and what she does not. Private is about outside versus inside, and a sister
  // is outside: being in the same parent's universe is what lets this module
  // NAME her, never what lets it see through her
  right.hidden(n);          //~ ErrorNotPublic:9 "private to its module"
}

fn absent(n i64) i64 {
  // A name she has not got at all, which is a lookup that found nothing rather
  // than a binding that refused
  right.missing(n);         //~ ErrorUnkName:9 "does not refer to a declared name"
}
