// A generic module holding two things its instances are not built for yet: a
// generic function, whose own parameter a clone would have to carry through,
// and a trait

pub mod stack[T];

pub mut count i64 = 0i64;

pub fn push(x T) {
  count = count + 1i64;
}

pub fn id[U](x U) U {         //~ ErrorGenModBody:5
  x;
}

pub trait Shape {             //~ ErrorGenModBody:11
  fn area(self &) i64;
}
