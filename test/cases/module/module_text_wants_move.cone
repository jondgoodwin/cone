// A piece taken by value that moves (an 'Item' given to the sink's own '<-') now moves
// only if 'wants' says yes. Today's rule for a move on one branch applies as it is: the
// variable is finalized once, at the scope's end when the send was skipped and by the
// callee when it was not. (Using it after the send is refused as any maybe-moved
// variable is: module_text_wants_move_use.)

mod module_text_wants_move;

import stdio use *;
import collections use *;

struct Item {
  pub var id: i32;
  fn final(self: &uni) { print <- "F", self.id, " "; }
}

struct Sink {
  pub var on: bool;
  pub var buf: String;
  pub fn wants(self: &) bool { self.on }
  pub fn textOut(self: &mut) TextOut { self.buf.textOut() }
  pub fn append overload `<-`(self: &mut, s: &str) { self.buf <- s; }
  pub fn take overload `<-`(self: &mut, i: Item) { self.buf <- "took"; }
}

fn run(on: bool) {
  var sink = Sink(on, String());
  let it = Item(7);
  sink <- "x", it;
  print <- sink.buf, " end ";
}

fn main() i32 {
  run(false);
  print <- "\n";
  run(true);
  print <- "\n";
  0
}
