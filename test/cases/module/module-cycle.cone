// An import cycle that comes back to the root file: this file imports
// modulecyc, and modulecyc imports this file.
//
// The root module is named after its file, like an imported module, so the
// import back to it finds the module already parsed rather than reading this
// file a second time as an ordinary module. cases.toml pins that the root's
// declarations are defined once, under their bare names, and that nothing is
// declared under a 'module-cycle_' prefix.
//
// The root's module name is its file name, and the runner requires a scenario
// file to be named 'module-...', which no identifier can spell. 'import'
// accepts a string literal as well as an identifier, so modulecyc names this
// file that way.
//
// It compiles rather than runs: it spans modules.
//
// The imported module is modulecyc.cone.

import modulecyc::*

mut counter i64 = 5i64

fn rootFn(n i64) i64 {
  n * 3i64
}

fn caller() i64 {
  rootFn(subFn(counter))
}
