// The code for Linux is position independent unless '--nopic' says otherwise:
// the usual Linux C compiler links a position independent executable, which
// refuses an object that is not. The address of the string below is taken
// relative to the instruction pointer, 'string(%rip)', only in position
// independent code; without it the address is an absolute one, '$string'.
// module_target_linux_nopic is the same program under '--nopic'.

mod module_target_linux_pic;

extern fn @c puts(s: cstr) i32;

fn main() {
  puts("position independent");
}
