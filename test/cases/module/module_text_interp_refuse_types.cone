// A value with no 'toText' in the braces of an interpolated string is refused as it
// is in a send list: sent, and stored as a String.

mod module_text_interp_refuse_types;

import stdio use *;
import collections use *;

struct Mute {
  x: i64;
}

fn main() i32 {
  let m = Mute(1i64);
  print <- $"mute {m} here\n";      //~ ErrorNoText:20 "Mute cannot be written as text"
  let s = $"mute {m} stored";       //~ ErrorNoText:19 "Mute cannot be written as text"
  0
}
