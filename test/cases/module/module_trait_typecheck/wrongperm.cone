// Runner's scale is 'mut', and this module's is 'imm': a default Runner gives
// writes nothing to it here, but a framework holding the trait may.

mod wrongperm is Runner;       //~ ErrorModTraitMismatch:18 "global scale with a permission other than"

pub fn step(n i64) i64 {
  n;
}

pub imm scale = 2i64;
