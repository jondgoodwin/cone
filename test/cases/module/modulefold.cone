// A module that folds a global's members in as its own names, one clause 'pub'
// and one not. Imported by module-nameres-fold-visibility.cone through
// modulefoldlate.cone, and never compiled on its own, so it is listed in
// cases.toml as a support module.
//
// What the scenario asks is which of the two names another module may reach
// through this module's qualifier. Both members are public in Dial, so what
// decides it is the binding this module made, not the declaration it stands for:
// a fold is private to the module that made it unless the clause says 'pub use'.
//
// Its name carries no '-' because a module's name is also its qualifier.

pub struct Dial {
  pub level i64;

  pub fn read(self) i64 {
    level * 10i64;
  }
}

// Re-exported: the clause says 'pub', so the names it makes are this module's
// public ones. The global has to be public too, since that is what a name folded
// through it is reached by.
pub mut dial Dial = Dial[4i64] pub use level as dialLevel, read as dialRead;

// Folded for this module's own use: the default, so the names are private here
// however public 'level' is in Dial
pub mut spare Dial = Dial[7i64] use level as spareLevel;

// Both folds are usable inside this module, whatever their visibility outside it
pub fn sum() i64 {
  dialLevel + spareLevel;
}
