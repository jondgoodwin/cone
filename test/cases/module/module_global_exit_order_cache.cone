// module_global_exit_order_actors with its first two imports exchanged: 'cache'
// before 'actors', so cache's finalizer runs after the actors package's. Both
// print the same.
mod module_global_exit_order_cache;

import stdio use *;
import cache;
import actors;
import thread;
import time use Duration;

actor Reader {
  n: u64 = 0u64;

  pub async fn read(self) {
    thread.sleep(Duration.fromMillis(300i64));
    printStr("behaviour: cache.at(100) (expected 7) ");
    print <- cache.at(100usize);
    printStr("\n");
  }
}

fn main() {
  let r = Reader();
  r.read();
  printStr("main returns\n");
}
