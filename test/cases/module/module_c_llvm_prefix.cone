// A C-named module whose prefix makes its names LLVM's intrinsic names.
//
// A C-named module gives every function and global it owns the C name of its
// prefix and its declared name. A prefix 'llvm.' makes each of those an LLVM
// intrinsic's name ('llvm.sqrt'), which is no symbol to link and which the code
// generator cannot select. It is refused at each declaration it would name, with
// the module and the name it would build said, since that name is the final one
// and appears nowhere in the source. A function that states its own '@c' string
// is not given the prefix, and is judged by its own string.
//
// Parse stage only.

mod @c("llvm.") module_c_llvm_prefix;

extern fn sqrt(n: f64) f64;                          //~ ErrorLlvmName
extern fn memcpy(n: i32);                            //~ ErrorLlvmName
extern var counter: i32;                             //~ ErrorLlvmName

// Its own string replaces the prefix
extern fn @c("plain_name") renamed(n: i32) i32;
extern fn @c("llvm.trap") ownstring();               //~ ErrorLlvmName
