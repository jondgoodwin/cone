// A GENERIC MODULE: its type parameter in square brackets on its 'mod' line,
// as a generic type writes its own. Nothing of it is compiled until an instance
// is named -- 'stack[i64]' -- and each instance is a module of its own: its own
// globals, its own 'init' and 'final', its own copy of every function and type.
// It conforms to a module trait as any module does, and each instance takes
// the trait's default for itself.
pub mod stack[T] is Counter;

import seq use Counter;
import stdio use *;

// Each instance's own globals
pub mut count i64 = 0i64;   // how many values were pushed
pub mut top T = 0;          // the last value pushed
pub mut sum T = 0;          // every value pushed, added up
pub imm order i64;          // when this instance's 'init' ran

// A type alias of the type parameter
typedef Item T;

// A type of the module, instantiated with it: its field is a T
struct Entry {
  pub value Item;

  pub fn doubled(self) T {
    value + value;
  }
}

fn @initpure init() {
  order = seq.take();
  printStr("init stack, order ");
  printInt(order);
  printStr("\n");
}

fn final() {
  printStr("final stack, count ");
  printInt(count);
  printStr("\n");
}

// Private: reached only from the module's own functions
fn record(x Item) {
  top = x;
  sum = sum + x;
}

// Returns the value doubled, through the module's own type
pub fn push(x T) T {
  record(x);
  count = count + 1i64;
  Entry[x].doubled();
}

// The module's own name inside its body names this instance, bare or with
// its own type argument
pub fn pushes() i64 {
  stack.count;
}

pub fn pushesAgain() i64 {
  stack[T].count;
}
