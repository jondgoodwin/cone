// Hands out numbers in turn, so each 'init' can say when it ran; and declares
// the module trait stack conforms to
pub mod seq;

pub mut next i64 = 1i64;

pub fn take() i64 {
  imm n = next;
  next = next + 1i64;
  n;
}

pub mod trait Counter {
  pub fn pushes() i64;            // a requirement
  pub fn twice() i64 {            // a default
    pushes() * 2i64;
  }
}
