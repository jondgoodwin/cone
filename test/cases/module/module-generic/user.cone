// A sister module using the generic modules its parent holds
pub mod user;

import seq;
import stack;
import tally;
import stdio use *;

pub struct Tag {
  pub id i64;
}

pub imm order i64;

fn @initpure init() {
  order = seq.take();
  printStr("init user, order ");
  printInt(order);
  printStr("\n");
}

// The root's type arguments, so the root's instance: one set of globals
pub fn pushTwice(n i64) {
  stack[i64].push(n);
  stack[i64].push(n);
}

// An instance whose type argument is this module's own type
pub fn seeTag() {
  imm t = Tag[7i64];
  tally[Tag].see(&t);
}
