// '@c' written after '&fn' marks the type of a reference to a C-named function.
// A function written there with a body is an anonymous function, which has no
// name for '@c' to give C spelling to, so it is refused: a closure or an
// anonymous function is Cone's, never C's. (Parse stage only: parse errors skip
// semantic analysis.)
mod module_c_fnref_parse;

struct Vec3 { pub x f32; pub y f32; pub z f32; }

fn main() {
  let f = &fn @c (v Vec3) f32 { v.x };   //~ ErrorCAttr:12 "An anonymous function has no name"
}
