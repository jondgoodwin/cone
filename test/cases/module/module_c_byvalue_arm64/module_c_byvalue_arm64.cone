// Structs passed and returned by value across the C boundary in the shapes the
// arm64 Apple C ABI tells apart, checked against C compiled by the platform's
// own C compiler (cside.c, which the scenario links): homogeneous float
// aggregates of up to four members, nested, in an array and over 16 bytes, in
// SIMD registers; five floats, which are not one, through memory; small
// integer structs in integer registers; a char and a short the caller widens;
// and arguments that run out of registers and are packed on the stack. Each is
// exercised both ways: Cone calling C, and C calling Cone's own C-named
// functions, directly and through a callback, and Cone calling them through a
// reference, '&fn @c (...)', as a direct call does. The same program runs on
// x86-64, where that platform's own rules apply.
mod module_c_byvalue_arm64;
import stdio use *;

struct Vec2 { pub x: f32; pub y: f32; }
struct Quad { pub lo: Vec2; pub hi: Vec2; }
struct Arr4 { pub v: Array[f32, 4]; }
struct Dbl3 { pub a: f64; pub b: f64; pub c: f64; }
struct Dbl4 { pub a: f64; pub b: f64; pub c: f64; pub d: f64; }
struct Flt5 { pub a: f32; pub b: f32; pub c: f32; pub d: f32; pub e: f32; }
struct Rgb { pub r: u8; pub g: u8; pub b: u8; }
struct Int3 { pub a: i32; pub b: i32; pub c: i32; }

extern {
  fn @c quad_code(q: Quad) i64;
  fn @c arr4_code(a: Arr4) i64;
  fn @c dbl3_code(v: Dbl3) i64;
  fn @c dbl4_code(v: Dbl4) i64;
  fn @c flt5_code(v: Flt5) i64;
  fn @c rgb_code(c: Rgb) i64;
  fn @c int3_code(v: Int3) i64;
  fn @c narrow_code(a: i8, b: u8, c: i16, d: u16) i64;
  fn @c eight_then_dbl4(d1: f64, d2: f64, d3: f64, d4: f64, d5: f64, d6: f64, d7: f64, d8: f64, v: Dbl4) i64;
  fn @c eight_then_narrow(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64,
    i: i8, j: i16, k: u8, v: Int3) i64;

  fn @c quad_make(n: i32) Quad;
  fn @c arr4_make(n: i32) Arr4;
  fn @c dbl3_make(n: i32) Dbl3;
  fn @c dbl4_make(n: i32) Dbl4;
  fn @c flt5_make(n: i32) Flt5;
  fn @c rgb_make(n: i32) Rgb;
  fn @c int3_make(n: i32) Int3;
  fn @c narrow_neg(a: i8) i8;
  fn @c narrow_twice(a: u16) u16;

  fn @c c_via_cone_dbl4() i64;
  fn @c c_via_cone_quad() i64;
  fn @c c_via_cone_flt5() i64;
  fn @c c_via_cone_rgb() i64;
  fn @c c_via_cone_narrow() i64;
  fn @c c_via_cone_eight() i64;
  fn @c c_apply_dbl4(f: &fn @c (v: Dbl4, k: f64) Dbl4) i64;
  fn @c c_apply_quad(f: &fn @c (q: Quad) Quad) i64;
}

// Cone's own C-named functions, which C calls
pub fn @c cone_dbl4(v: Dbl4, k: f64) Dbl4 {
  Dbl4(v.a * k, v.b * k, v.c * k, v.d * k)
}
pub fn @c cone_quad(q: Quad) Quad {
  Quad(q.hi, q.lo)
}
pub fn @c cone_flt5(v: Flt5) Flt5 {
  Flt5(v.e, v.d, v.c, v.b, v.a)
}
pub fn @c cone_rgb(c: Rgb) Rgb {
  Rgb(c.b, c.g, c.r)
}
pub fn @c cone_narrow(a: i8, b: u8, c: i16) i16 {
  i16.from(a) + i16.from(b) + c
}
pub fn @c cone_eight_then_narrow(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64,
    i: i8, j: i16, k: u8, v: Int3) i64 {
  (a + b + c + d + e + f + g + h) * 100000000 + i64.from(i) * 1000000 + i64.from(j) * 1000
    + i64.from(k) * 100 + i64.from(v.b * 10 + v.c)
}

fn show(label: &str, n: i64) {
  printStr(label); printStr(" "); printInt(n); printStr("\n");
}

fn main() {
  // Cone calls C, passing structs
  show("quad_code", quad_code(Quad(Vec2(1., 2.), Vec2(3., 4.))));
  show("arr4_code", arr4_code(Arr4([5., 6., 7., 8.])));
  show("dbl3_code", dbl3_code(Dbl3(1., 2., 3.)));
  show("dbl4_code", dbl4_code(Dbl4(1., 2., 3., 4.)));
  show("flt5_code", flt5_code(Flt5(1., 2., 3., 4., 5.)));
  show("rgb_code", rgb_code(Rgb(1, 2, 3)));
  show("int3_code", int3_code(Int3(1, 2, 3)));
  show("narrow_code", narrow_code(-3, 250, -2, 60000));
  show("eight_then_dbl4", eight_then_dbl4(1., 1., 1., 1., 1., 1., 1., 1., Dbl4(1., 2., 3., 4.)));
  show("eight_then_narrow", eight_then_narrow(1, 1, 1, 1, 1, 1, 1, 1, -7, -42, 9, Int3(1, 2, 3)));

  // C returns structs to Cone
  let q = quad_make(1);
  show("quad_make", i64.from(q.lo.x * 1000. + q.lo.y * 100. + q.hi.x * 10. + q.hi.y));
  let a = arr4_make(2);
  show("arr4_make", i64.from(a.v[0] * 1000. + a.v[1] * 100. + a.v[2] * 10. + a.v[3]));
  let d3 = dbl3_make(1);
  show("dbl3_make", i64.from(d3.a * 100. + d3.b * 10. + d3.c));
  let d4 = dbl4_make(1);
  show("dbl4_make", i64.from(d4.a * 1000. + d4.b * 100. + d4.c * 10. + d4.d));
  let f5 = flt5_make(1);
  show("flt5_make", i64.from(f5.a * 10000. + f5.b * 1000. + f5.c * 100. + f5.d * 10. + f5.e));
  let c = rgb_make(4);
  show("rgb_make", i64.from(c.r) * 100 + i64.from(c.g) * 10 + i64.from(c.b));
  let i3 = int3_make(7);
  show("int3_make", i64.from(i3.a) * 100 + i64.from(i3.b) * 10 + i64.from(i3.c));
  show("narrow_neg", i64.from(narrow_neg(5)));
  show("narrow_twice", i64.from(narrow_twice(30000)));

  // C calls Cone's C-named functions, directly and through a callback
  show("c_via_cone_dbl4", c_via_cone_dbl4());
  show("c_via_cone_quad", c_via_cone_quad());
  show("c_via_cone_flt5", c_via_cone_flt5());
  show("c_via_cone_rgb", c_via_cone_rgb());
  show("c_via_cone_narrow", c_via_cone_narrow());
  show("c_via_cone_eight", c_via_cone_eight());
  show("c_apply_dbl4", c_apply_dbl4(&cone_dbl4));
  show("c_apply_quad", c_apply_quad(&cone_quad));

  // Cone calls through a reference to a C-named function, as C passes values
  let viaD: &fn @c (v: Dbl4, k: f64) Dbl4 = &cone_dbl4;
  let rd = viaD(Dbl4(1., 2., 3., 4.), 2.);
  show("ref dbl4", i64.from(rd.a * 1000. + rd.b * 100. + rd.c * 10. + rd.d));
  let viaQ: &fn @c (q: Quad) Quad = &cone_quad;
  let rq = viaQ(Quad(Vec2(1., 2.), Vec2(3., 4.)));
  show("ref quad", i64.from(rq.lo.x * 1000. + rq.lo.y * 100. + rq.hi.x * 10. + rq.hi.y));
  let viaF: &fn @c (v: Flt5) Flt5 = &cone_flt5;
  let rf = viaF(Flt5(1., 2., 3., 4., 5.));
  show("ref flt5", i64.from(rf.a * 10000. + rf.b * 1000. + rf.c * 100. + rf.d * 10. + rf.e));
}
