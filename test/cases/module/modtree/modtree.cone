// The designated file of the folder 'modtree', imported by
// module_import_submodule.cone and never compiled on its own, so the folder is
// listed in cases.toml as a support module under its own name. Its tree holds
// branch (branch/branch.cone), twig beneath branch (branch/twig.cone), and leaf
// (leaf.cone).

mod modtree;

pub fn treeAdd(n i64) i64 {
  n + 1i64;
}
