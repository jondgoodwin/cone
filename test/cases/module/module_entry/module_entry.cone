// THE PROGRAM'S ENTRY: the compiler builds the C 'main' the runtime calls, and
// it runs the stitched init, the program's own 'main', then the stitched final
// [Jon 23 Sep]. This program calls neither 'initAll()' nor 'finalAll()'.
//
// The module order puts 'helper' first and this root last, so the output is
// helper's init, the root's init, 'main', the root's final, helper's final: the
// finals in exactly the reverse. 'main' reads a value only the inits could have
// made (helper's 40, plus 2), and the 7 it returns is the process's exit status.

mod module_entry;

import stdio use *;

imm answer i64;

fn @initpure init() {
  answer = helper.base + 2i64;
  printStr("root init\n");
}

fn final() {
  printStr("root final\n");
}

fn main() i32 {
  printStr("main: answer = ");
  printInt(answer);
  printStr("\n");
  7i32;
}
