// The designated file of geometry/, which is what makes that folder a submodule
// of the module whose folder holds it rather than a place to keep its files.
//
// A submodule is a module in every respect -- its own namespace, its own folder
// sweep, its own subfolders -- and what makes it a child is that its parent owns
// it, so its declarations are spelled after the parent's name, and that it is
// private to that parent unless this declaration says 'pub'.
//
// The name is the folder's, as it is for any module a designated file draws, and
// writing it here restates it rather than choosing it.

mod geometry;

// 'pub' is what lets the parent reach this by path. Everything this module keeps
// to itself is reached only from inside it, which is the boundary a submodule is
// for: a parent may name the module without seeing what the module does not show
pub fn area(w i64, h i64) i64 {
  // Its own child, by its bare name: a submodule of this module is a name of this
  // namespace, exactly as a declaration of this module is
  marginOf(scaling.twice(boxed(w, h)));
}

// Private to this module. module-submodule-nameres pins that the parent may not
// reach it
fn boxed(w i64, h i64) i64 {
  w * h;
}

// A global is one instance whichever module holds it
pub mut unit = 1i64;

// An enum the parent holds by value. The parent is walked before this module is,
// so its parameter asks for the enum's size before any variant here is reached
pub enum Corner {
  pub count i64;
  Sharp, Round;
}
use Corner;

pub fn sharp() Corner {
  Sharp[4i64];
}
