// A file of the submodule's folder, swept into the submodule. It declares no
// module: geometry.cone declares the one they share, exactly as the scenario's
// designated file does for sibling.cone one level up. The sweep is the same walk
// at every level of the tree.

pub fn perimeterOf(w i64, h i64) i64 {
  // This module's other files are in reach here with no qualifier, because they
  // are the same module
  (w + h) * boxed(1i64, 2i64);
}
