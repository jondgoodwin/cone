// A value with no 'toText' goes to a sink declaring DebugText (it takes the debug form, which
// every value has), and is still refused by the console.

mod module_debug_sink_refuse;

import stdio use *;
import collections use *;

struct Mute {
  x: i64;
}

struct Probe is DebugText {
  text: String;
  pub fn init(self: &new) {*self = Probe(String());}
  pub fn takeText overload `<-`(self: &mut, s: &str) {
    self.text <- s;
  }
  pub fn textOut(self: &mut) TextOut {
    self.text.textOut()
  }
}

fn main() {
  let m = Mute(3i64);
  var p = Probe();
  p <- "ok ", m;
  print <- m;                   //~ ErrorNoText "Mute cannot be written as text"
  print <- toDebug(&m);
}
