// Bug 120: a lazy generic whose receiver is written 'Wrap[& R]', not its own type, is
// refused with its errors once, at once. Each instance made by the checks of the one
// before names the type at a ref of the last argument, and every instance was checked
// again to repeat the same errors, two hundred times over, at a cost growing with the
// nesting: the compile took half a minute. An instance made by a member check that
// has reported an error is not checked.

mod generic_lazy_receiver_error;

struct Wrap[R] {
  pub fn lift(self: Wrap[& R]) Wrap[Option[R]] {   //~ ErrorInvType:7 "self parameter for a method must match"
    Wrap[[R]]([](self.v))   //~ ErrorBadArray:10 "exactly one numeric array dimension"
                                //~^ ErrorBadArray:15 "empty array literal"
                                //~^^ ErrorNoMbr:22 "not found"
  }
}

fn main() {
  let w = Wrap[i64]();
}
