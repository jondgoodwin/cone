// Indexing a lazy nested instance. 'Tab[Option[i64]]', made by the member check of
// 'Tab[i64]', waits for a use. Its '[]' (read) and '&[]' (write) are the type's index
// methods; the use checks its members, and the program is generated and run.
// lift makes a table of two empty slots; the second is set to Some(7) through '&[]',
// then both are read back through '[]': slot 0 is none, slot 1 is 7.

mod generic_lazy_index;

import collections use *;
import stdio use *;

struct Tab[R] {
  items: List[R];

  pub fn lift(self: &Tab[R]) Tab[Option[R]] {
    var l = List[Option[R]]();
    l.push(None[R]);
    l.push(None[R]);
    Tab[Option[R]](l)
  }

  pub fn `[]`(self: &Tab[R], i: usize) &R {
    &items[i]
  }

  pub fn `&[]`(self: &mut Tab[R], i: usize) &mut R {
    &mut items[i]
  }
}

fn show(label: &str, o: &Option[i64]) {
  printStr(label);
  printStr(" ");
  match o {
    case let Some(v) {printInt(*v);}
    else {printStr("none");}
  }
  printStr("\n");
}

fn main() {
  let h = Tab[i64](List[i64]());
  var t = h.lift();
  t[1usize] = Some[i64](7i64);
  show("slot0", &t[0usize]);
  show("slot1", &t[1usize]);
}
