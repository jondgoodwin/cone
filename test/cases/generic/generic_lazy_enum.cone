// The same loop through an enum template: 'Pack[R]' giving 'Pack[Option[R]]',
// called twice. The nested instances are of the enum itself, so the enum case
// stops its chain as a struct does.

mod generic_lazy_enum;

import stdio use *;

enum Pack[R] {
  Empty;
  Full(R);
  pub fn lift(self: &Pack[R]) Pack[Option[R]] {
    Full[Option[R]](None[R])
  }
  pub fn isFull(self: &Pack[R]) bool {
    match *self {
      case is Full { true }
      case is Empty { false }
    }
  }
}
use Pack;

fn main() {
  let p = Full[i64](7);
  let q = p.lift();
  let r = q.lift();
  if r.isFull() {
    printStr("done\n");
  }
}
