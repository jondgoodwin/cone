// The same use, with a method that does not compile for the nested instance's
// argument: the coercion to a virtual reference checks the members, and the error
// is reported (the use is not a call, but it needs the method's code).

mod generic_lazy_vtable_error;

import stdio use *;

trait Badder {
  pub fn bad(self: &) i64;
}

struct Wrap[R] is Badder {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }

  pub fn bad(self: &Wrap[R]) i64 {
    let x = self.v + 1;   //~ ErrorNoMbr:20 "not found"
    7
  }
}

fn main() {
  let w = Wrap[i64](5);
  let w2 = w.lift();
  let b: &<Badder = &w2;
  printInt(b.bad());
}
