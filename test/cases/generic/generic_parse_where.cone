// What the parser refuses of a 'where' clause. The first cut reads 'T is
// Name', a trait joined to another with '+', and clauses joined with 'and'.
// What else the reference manual shows a clause saying -- a relation between
// two parameters and a constraint on a type expression -- and 'or' and 'not'
// are not built, and each is one diagnostic at the declaration: recovery skips
// to the block, so the body still parses.
//
// A type with no type parameters has nothing for a clause to constrain, which
// the parser knows as it reads the clause. A function's is known only at name
// resolution, where a method sees whether its type is generic
// (generic_nameres_where).

mod generic_parse_where;

trait Node {}
trait Float {}

fn either[T](x T) T where T is Node or T is Float {   //~ ErrorWhereForm:37 "'or' and 'not'"
  x;
}

fn relation[T, Y](x T, y Y) T where T < Y {           //~ ErrorWhereForm:39 "relation between two parameters"
  x;
}

struct OnExpr[T] where Option[T] is Node {            //~ ErrorWhereForm:30 "relation between two parameters"
  v T;
}

fn negated[T](x T) T where not T is Node {            //~ ErrorWhereForm:28 "type parameter's name, 'is', and a trait"
  x;
}

fn noTrait[T](x T) T where T is {                     //~ ErrorWhereForm:33 "a trait, named"
  x;
}

struct Plain where T is Node {                        //~ ErrorWhereNoParms:14 "nothing to constrain"
  v i32;
}
