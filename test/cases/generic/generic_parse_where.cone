// What the parser reads of a 'where' clause, and what it refuses. It reads
// 'T is Name', a name joined to another with '+', and clauses joined with
// 'and' and 'or', 'and' binding tighter, grouped by parentheses: 'either' and
// 'grouped' below parse clean (generic_constraint_or runs what they mean).
// What else the reference manual shows a clause saying -- a relation between
// two parameters and a constraint on a type expression -- and 'not' are not
// built, and each is one diagnostic at the declaration, as is a clause left
// unfinished or a parenthesis left open: recovery skips to the block, so the
// body still parses.
//
// The inline form after a parameter's name joins its traits with '+' only,
// each required; 'or' there is refused, and the choice is written in a
// 'where' clause instead. Recovery skips to the next parameter.
//
// A type with no type parameters has nothing for a clause to constrain, which
// the parser knows as it reads the clause. A function's is known only at name
// resolution, where a method sees whether its type is generic
// (generic_nameres_where).

mod generic_parse_where;

trait Node {}
trait Float {}

fn either[T](x T) T where T is Node or T is Float {
  x;
}

fn grouped[T, U](x T, y U) T where (T is Node or T is Float) and U is Node + Float or U is Float {
  x;
}

fn relation[T, Y](x T, y Y) T where T < Y {           //~ ErrorWhereForm:39 "relation between two parameters"
  x;
}

struct OnExpr[T] where Option[T] is Node {            //~ ErrorWhereForm:30 "relation between two parameters"
  v T;
}

fn negated[T](x T) T where not T is Node {            //~ ErrorWhereForm:28 "'not' is not built"
  x;
}

fn isNot[T](x T) T where T is Node or T is not Float {   //~ ErrorWhereForm:44 "'not' is not built"
  x;
}

fn noTrait[T](x T) T where T is {                     //~ ErrorWhereForm:33 "a trait, named"
  x;
}

fn dangling[T](x T) T where T is Node or {            //~ ErrorWhereForm:42 "type parameter's name, 'is', and a trait"
  x;
}

fn unclosed[T](x T) T where (T is Node or T is Float {   //~ ErrorWhereForm:54 "closed by a ')'"
  x;
}

fn inlineOr[T Node or Float, U Node](x T, y U) T {    //~ ErrorGenParmOr:20 "written in a 'where' clause"
  x;
}

struct Plain where T is Node {                        //~ ErrorWhereNoParms:14 "nothing to constrain"
  v i32;
}
