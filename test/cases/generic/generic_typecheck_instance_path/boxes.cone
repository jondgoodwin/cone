// A module holding a generic type with a public and a private function, and
// a generic enum with a method

pub mod boxes;

pub struct Box[T] {
  pub v T;
  pub fn make(v T) Box { Box[v]; }
  fn hidden() i64 { 1i64; }
  pub static mut held = 0i64;
}

pub enum Maybe[T] {
  pub fn tell(self) i64 { 2i64; }
  pub struct Yes { pub value T; }
  pub struct No {}
}
