// What a path through an instance of a generic type refuses at type check,
// where the instance is made: a private function named from outside the type's
// module, a method of a generic enum, which has no code of its own (each
// variant has its copy), and a member that is not a function, which a path
// through an instance does not reach yet. The first two wear the code the same
// mistake wears on a path through a type that is not generic.
//
// Type check stage. boxes.cone beside this file is the module holding them.

mod generic_typecheck_instance_path;

fn main() i32 {
  imm b = boxes.Box[i64].make(3i64);
  imm h = boxes.Box[i64].hidden();          //~ ErrorNotPublic:26
  imm t = boxes.Maybe[i64].tell(boxes.Maybe.Yes[4i64]);  //~ ErrorAbstractMeth:28
  imm g = boxes.Box[i64].held;              //~ ErrorUnkName:20 "reaching a member through anything else is not built"
  0i32;
}
