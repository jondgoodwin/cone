// Generic functions and generic types: declaring one type parameter list, and
// what a call or a type literal does with it.
//
// A generic is not a type or a function. It is a template the compiler clones
// once per distinct set of type arguments, so what has to be established is
// which instance a use gets: the type arguments written out, the type arguments
// inferred from the value arguments, two uses at one type argument sharing one
// instance, and two uses at different type arguments getting different ones.
// Only the last of those is visible in what the program prints, so the
// instantiation itself is asserted against the generated LLVM IR, where each
// instance appears under a name carrying its type arguments.
//
// Macros are the other half of this group and live in generic-macro, because
// they are a separate declaration and expansion path that codegen never sees as
// its own entity.
//
// i64 and f64 throughout, so that a printed value needs no conversion: a
// numeric conversion is typemgmt's subject and would be scaffolding here.

import stdio::*

fn show(label &[]u8, n i64) {
  printStr(label)
  printStr(" = ")
  printInt(n)
  printStr("\n")
}

fn showF(label &[]u8, n f64) {
  printStr(label)
  printStr(" = ")
  printFloat(n)
  printStr("\n")
}

fn showB(label &[]u8, b Bool) {
  show(label, if b {1i64} else {0i64})
}

// -------- a generic function --------

// One type parameter standing in for both parameter types and the return type,
// so an instance is wrong unless all three were substituted together.
fn max[T](x T, y T) T {
  if x > y {x} else {y}
}

// Two type parameters, where the second alone decides the return type. An
// instance that confused the two would return the wrong one.
fn pickSecond[T, U](a T, b U) U {
  b
}

struct Point {
  x i64
  y i64
}

fn firstOf[T](a T, b T) T {
  a
}

// A generic nobody instantiates. It is legal -- a module may declare one this
// compilation unit never calls -- and it generates nothing, because a generic is
// only ever a symbol through its instances. Code generation used to walk the
// instance list without asking whether there was one.
fn neverCalled[T](a T) T {
  a
}

fn inferredTypeArgument() {
  // No type argument is written. It is inferred from the value arguments and
  // then fixes the return type too.
  show("inferred-i64", max(2i64, 6i64))
  // A second use at the same type argument: the compiler memoizes instances, so
  // this is the instance the line above created rather than a second one
  show("inferred-i64-again", max(9i64, 4i64))
  showF("inferred-f64", max(3.5d, 6.25d))
}

fn explicitTypeArgument() {
  // The same generic, given its type argument outright
  show("explicit-i64", max[i64](3i64, 8i64))
  showF("explicit-f64", max[f64](3.5d, 2.25d))
}

fn severalTypeParameters() {
  // The return type is U, the second parameter's
  showF("second-of-int-and-float", pickSecond(1i64, 2.5d))
  // Swapped, so a different instance answers, with the other return type
  show("second-of-float-and-int", pickSecond(2.5d, 7i64))
}

fn genericOverAStructType() {
  // A type argument does not have to be a number type; a struct instantiates
  // the same generic just as well
  imm p = firstOf(Point[x: 1i64, y: 2i64], Point[x: 3i64, y: 4i64])
  show("struct-type-argument", p.x)
}

// -------- a generic type --------

struct Box[T] {
  v T

  // A reference receiver, so an instance reached through '&Box[i64]' has a
  // method to dispatch as well as a field to read
  fn get(self &) T {v}
}

struct Pair[T, U] {
  a T
  b U
}

// A generic instantiation names a type: usable as a declared type, as a
// parameter type, and as a generic function's return type.
fn unbox(b Box[i64]) i64 {
  b.v
}

fn boxUp[T](x T) Box[T] {
  Box[T][v: x]
}

fn genericStruct() {
  imm bi = Box[i64][v: 7i64]
  show("box-explicit", bi.v)
  imm bf = Box[f64][v: 1.5d]
  showF("box-other-type-argument", bf.v)
  // The type argument is inferred from the field values instead of written
  imm bn = Box[v: 8i64]
  show("box-inferred", bn.v)
  // The instantiation used as a declared type and as a parameter type
  imm bt Box[i64] = Box[i64][v: 9i64]
  show("box-as-declared-type", unbox(bt))
  // A field of an instance is an ordinary field, and assignable
  mut bm = Box[i64][v: 1i64]
  bm.v = 12i64
  show("box-field-assigned", bm.v)
}

fn severalTypeParametersOnAStruct() {
  imm p = Pair[i64, f64][a: 3i64, b: 4.5d]
  show("pair-first-field", p.a)
  showF("pair-second-field", p.b)
}

// -------- methods on a generic type --------

// A generic's methods are cloned with it, and 'self' is declared as a use of
// 'Self'. The clone used to leave that pointing at the generic, so no method of
// any instance had a receiver matching the instance it belonged to: every one
// was rejected at its declaration and no call found a candidate. Nothing
// downstream had ever run, and it turned out the instance's methods were never
// given an LLVM symbol either, since code generation reaches a generic type's
// instances only through its memoized instantiations.
//
// Two instances, so a method that had been generated once for the generic
// rather than once per instance could not answer both.

struct Holder[T] {
  item T
  count i64

  // A value receiver, whose signature names no type parameter at all
  fn tally(self) i64 {count}
  // A reference receiver returning the type argument
  fn unwrap(self &) T {item}
  // A mutable reference receiver, so the write reaches the caller's value
  fn clear(self &mut) {count = 0i64}

  // -------- operators inside a generic type's method --------
  //
  // Cloning a generic listed each of its methods twice, once at its own index
  // and once appended after the count memcpy had carried over, so every instance
  // method's body was type checked twice on the same node. Lowering is not
  // idempotent: the second visit saw what the first had already lowered. An
  // operator call, by then a use of the operator's own FnDcl, took
  // fnCallTypeCheck's "rewrite to self.method" path and was rejected as a method
  // the instance does not declare, while '+=' had already become a temporary and
  // was rejected as a variable initialized with something other than a literal.
  // So each of these is an operator reached by a different route.

  // No name in it at all, which is the narrowest form of the failure: it was not
  // about the type argument, the fields or the receiver
  fn litSum(self &) i64 {1i64 + 2i64}
  // Arithmetic on a concretely typed field
  fn countPlus(self &, n i64) i64 {count + n}
  // A comparison, whose result type is not its operands'
  fn overCount(self &, n i64) Bool {count > n}
  // Arithmetic on a field of the type argument's type, returning T
  fn itemSum(self &) T {item + item}
  // And a comparison on that type, which each instance resolves for its own T
  fn itemOver(self &, other T) Bool {item > other}
  // An operator assignment, which is the FlagLvalOp/FlagOpAssgn route through
  // fnCallTypeCheck rather than a plain method dispatch
  fn bumpBy(self &mut, n i64) {count += n}
}

fn methodsOnAGenericType() {
  mut hi = Holder[i64][item: 3i64, count: 1i64]
  show("generic-method-value-receiver", hi.tally())
  show("generic-method-ref-receiver-returns-T", (&hi).unwrap())
  (&mut hi).clear()
  show("generic-method-mut-receiver-mutated", hi.tally())

  // A second instance at a different type argument, reaching its own clones
  mut hf = Holder[f64][item: 2.5d, count: 4i64]
  show("other-instance-method", hf.tally())
  showF("other-instance-method-returns-its-T", (&hf).unwrap())
}

fn operatorsInsideAGenericMethod() {
  mut hi = Holder[i64][item: 3i64, count: 1i64]
  show("generic-method-operator-on-literals", (&hi).litSum())
  show("generic-method-operator-on-field", (&hi).countPlus(4i64))
  showB("generic-method-comparison-on-field", (&hi).overCount(0i64))
  show("generic-method-operator-on-T-field", (&hi).itemSum())
  showB("generic-method-comparison-on-T-field", (&hi).itemOver(9i64))
  // The operator assignment writes through the mutable receiver, so the caller's
  // value is what proves it ran rather than a temporary standing in for it
  (&mut hi).bumpBy(5i64)
  show("generic-method-operator-assign", hi.tally())

  // The second instance again, so nothing here passes by one instance answering
  // for both -- and its T is a float, so its T-typed operators are the other
  // type's operators
  mut hf = Holder[f64][item: 2.5d, count: 2i64]
  show("other-instance-operator-on-literals", (&hf).litSum())
  showF("other-instance-operator-on-T-field", (&hf).itemSum())
  showB("other-instance-comparison-on-T-field", (&hf).itemOver(1.5d))
  (&mut hf).bumpBy(3i64)
  show("other-instance-operator-assign", hf.tally())
}

// An instantiation is a type wherever a type goes, including inside another
// type. It is an unlowered call node until type check replaces it with the
// instance it names, so every pass that runs before then has to recognize one
// as a type -- name resolution above all, which is where '*T', '[N; T]' and
// '?T' decide between a type and the expression that shares their syntax. An
// instantiation used to lose that vote, so '*Box[i64]' read as a dereference
// and '[2; Box[i64]]' as an array literal.
//
// '&Box[i64]' used not to be one of these, because the borrow never reached
// this question: '&' consumed the bare name and then re-applied '[i64]' to the
// borrow, so the instantiation was read as a type literal of a reference to the
// generic itself. Now that a borrow applies to the whole suffixed term, the
// instantiation arrives whole and the same vote decides it. That is what a
// generic collection with '&self' methods needed.

fn viaPointer(b *Box[i64]) i64 {
  (*b).v
}

fn viaRef(b &Box[i64]) i64 {
  b.v
}

fn viaRefMethod(b &Box[i64]) i64 {
  b.get()
}

fn optionalBox(o ?Box[i64]) i64 {
  match o {
    case imm s Some[Box[i64]] {s.value.v}
    case imm n None[Box[i64]] {0i64}
  }
}

fn instantiationInsideAnotherType() {
  // Array element type
  mut a [2; Box[i64]] = [Box[i64][v: 3i64], Box[i64][v: 4i64]]
  show("instantiation-as-array-element", a[0].v)
  show("instantiation-as-array-element-second", a[1].v)
  // Written through, so the element type is a real type and not a shape that
  // merely type checked
  a[1].v = 11i64
  show("instantiation-as-array-element-assigned", a[1].v)

  // Pointer target type
  mut one = Box[i64][v: 7i64]
  imm p *Box[i64] = &mut one
  show("instantiation-as-pointer-target", viaPointer(p))

  // Borrowed reference target type, reading a field and dispatching a method
  // whose own receiver is '&self'
  show("instantiation-as-ref-target", viaRef(&one))
  show("instantiation-as-ref-target-method", viaRefMethod(&one))

  // Option's type argument, through the '?' sugar
  show("instantiation-as-option-argument", optionalBox(Some[Box[i64][v: 6i64]]))
  show("instantiation-as-option-argument-none", optionalBox(None[Box[i64]][]))
}

// -------- a node kind the cloner has to know --------
//
// Instantiating a generic deep-copies its body, and the copier dispatches on
// node tag. Its default arm was an assert, which the Release build's /DNDEBUG
// turns into a no-op, so an unlisted tag fell through to a write against an
// uninitialized pointer. 'is' was such a tag -- it builds the same node struct a
// cast does and only the cast's tag was listed -- so a generic whose body tested
// a variant crashed the compiler on an access violation. A union is scaffolding
// here: what is claimed is that the body survives cloning, and 'is' is the
// narrowest construct that reaches the arm.

union Reading {
  at i64
  struct Spot {}
  struct Span { len i64 }
}

fn spanLength[T](r T) i64 {
  if r is Span {
    1i64
  } else {
    0i64
  }
}

fn clonedNodeKinds() {
  mut spot Reading = Spot[3i64]
  mut span Reading = Span[4i64, 9i64]
  show("cloned-is-false", spanLength(spot))
  show("cloned-is-true", spanLength(span))
}

fn genericReturningGeneric() {
  // A generic function whose return type is an instantiation of a generic type
  // with the function's own type parameter
  imm b = boxUp(5i64)
  show("generic-returns-generic", b.v)
}

// -------- a type argument that is not a named type --------

// Every type argument above is a named type -- a number, a struct -- and a name
// was the one shape the instance-name mangler could write. A tuple, an array, a
// function reference and void each wrote nothing at all, so two instances of
// one generic came out under one name and LLVM had to tell them apart by
// appending '.1'. Within a module that is only a confusing symbol; across
// modules 'linkonce' would merge two instances of different types into one.
//
// Each of the four is instantiated below and the names are asserted in
// cases.toml. The values are printed too, because a distinct name is not a
// distinct body: the instance still has to have been substituted at the type it
// was named for.
fn twice(n i64) i64 {
  n * 2i64
}

fn nothing() {
}

fn passThrough[T](a T) T {
  a
}

fn unnamedTypeArguments() {
  imm pair = passThrough((3i64, 4i64))
  show("tuple-type-argument", pair.0)
  // A second tuple of a different arity: one instance per type argument means
  // this is a different instance, which is exactly what one shared name hid
  imm triple = passThrough((5i64, 6i64, 7i64))
  show("tuple-type-argument-other-arity", triple.2)
  imm arr = passThrough([8i64, 9i64])
  show("array-type-argument", arr[1])
  imm fnref = passThrough(&twice)
  show("fn-ref-type-argument", fnref(10i64))
  passThrough(nothing())
  show("void-type-argument", 1i64)
}

fn main() i32 {
  inferredTypeArgument()
  explicitTypeArgument()
  severalTypeParameters()
  genericOverAStructType()
  genericStruct()
  severalTypeParametersOnAStruct()
  methodsOnAGenericType()
  operatorsInsideAGenericMethod()
  instantiationInsideAnotherType()
  clonedNodeKinds()
  genericReturningGeneric()
  unnamedTypeArguments()
  0i32
}
