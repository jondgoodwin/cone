// A nested instance that is never called or built outside the check that made it,
// but is dropped: 'final' is a method the drop needs, so the drop's use must check
// and generate it. 'Wrap[Option[i64]]' (a local) is dropped at the end of main.

mod generic_lazy_final;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }

  fn final(self: &uni) {
    printStr("F ");
  }
}

fn main() {
  let w = Wrap[i64](5);
  let w2 = w.lift();
  printStr("end\n");
}
