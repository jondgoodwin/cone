// A global of a generic struct's instance, 'Pair[Cell]', declared above Cell, so
// checking the global's declared type is what lays Pair[Cell] and Cell out.
// Cell's method, checked from the members queue that layout works on its way
// out, reads the global's fields, one of them through its type argument. The
// declared type is in place before that (varDclTypeCheck); before, the global
// still had the generic call it was written as, and each field read was refused
// as a type with no fields. The printed value was checked by hand: 30 + 4.

mod generic_global_field;

import stdio use *;

struct Pair[T] {
  pub left: T;
  pub tag: u64;
}

let g: Pair[Cell] = Pair[Cell](Cell(4u64), 30u64);

struct Cell {
  pub v: u64;
  pub fn peek(self: &) u64 {g.tag + g.left.v}
}

fn main() {
  printStr("peek = "); printUInt(g.left.peek()); printStr("\n");
}
