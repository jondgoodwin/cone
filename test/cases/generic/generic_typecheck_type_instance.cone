// A clause naming an instance, 'where T is Uni[str]', is unmet by every other
// type, and the refusal names it as written: a function whose argument is
// another owner or an integer; a method absent from the instance that does not
// meet it; an instance of a generic type that differs in its arguments; and an
// instance whose arguments name another parameter ('U is Option[T]'), unmet
// when the two disagree, the refusal naming it at the arguments they came to.

mod generic_typecheck_type_instance;

struct Cell[K] {
  pub k K;
  pub fn text(self &) i64 where K is Uni[str] {1;}
  pub fn opt(self &) i64 where K is Option[i64] {2;}
}

fn soOnly[T](x &T) i64 where T is Uni[str] {3;}
fn holds[T, U](a &T, b &U) i64 where U is Option[T] {4;}

fn main() {
  let rc Rc[str] = "abc";
  soOnly(&rc);                    //~ ErrorWhereUnmet:9 "soOnly requires T is Uni[str], and Rc[str] is not Uni[str]"
  soOnly(&7i32);                  //~ ErrorWhereUnmet:9 "soOnly requires T is Uni[str], and i32 is not Uni[str]"

  let cr = new Cell[Rc[str]]("k");
  cr.text();                      //~ ErrorWhereAbsent:5 "No method text for Cell[Rc[str]]: it exists only where K is Uni[str]"
  let cb = new Cell[Option[bool]](None);
  cb.opt();                       //~ ErrorWhereAbsent:5 "No method opt for Cell[Option[bool]]: it exists only where K is Option[i64]"

  let n = 5i64;
  let o = Some[bool](true);
  holds(&n, &o);                  //~ ErrorWhereUnmet:8 "holds requires U is Option[i64], and Some[bool] is not Option[i64]"
}
