// A generic's type arguments no argument says are read off where its value goes.
// The result the generic makes -- a function's return type, a variant's enum,
// a generic type's own 'Box[T]' -- is matched against the type expected of the
// value, and only the arguments still empty are filled, so a written or inferred
// argument always wins. It is one mechanism for every generic, not a rule about
// 'None': the sources below are a variable, a return, an assignment, a call's
// argument, a struct's field, the branches of an 'if', a block's last value, an
// append, an operand of '==', and an overload set whose candidates agree.
//
// The expected type is read before an unsuffixed integer literal takes its
// default, so 'add(2000000000, 2000000000)' wanted as an i64 adds i64s.
//
// Each printed value was checked by hand against the source.

mod generic_infer_expected;

import stdio use *;
import collections use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

// The payload of an option, or -1 for none
fn orMinus(o Option[i64]) i64 {
  match o {
    case let n Some { n; }
    else { -1; }
  }
}

// The payload of a success, or 1000 more than the error's code
fn resCode(r Result[i64, i32]) i64 {
  match r {
    case let n Ok { n; }
    case let e Error { i64.from(e) + 1000; }
  }
}

// A generic enum of the program's own, its variants named through it
enum Tree[T] {
  Leaf;
  Node(T);
}

fn treeSum(t Tree[i64]) i64 {
  match t {
    case let n Node { n + 1; }
    else { 0; }
  }
}

struct Box[T] {
  pub v T;
}

// A generic type that uses its parameter nowhere in its fields, and one function
// that makes it from nothing: only the expected type can say what T is
struct Tagged[T] {
  pub n i32;
}

fn make[T]() Tagged[T] { new Tagged[T](7); }

// Two parameters: the argument says A, where the value goes says B
struct Pair[A, B] {
  pub a A;
  pub n i32;
}

fn pairOf[A, B](a A) Pair[A, B] { new Pair[A, B](a, 3); }

fn forty[T]() T { 40; }
fn add[T](a T, b T) T { a + b; }
fn same[T](x T) T { x; }

struct Holder {
  pub o Option[i64];
  pub fn zero[T](self &) T { 0; }
}

// A variable, with each variant of core's two enums
fn variables() {
  let a Option[i64] = None;
  show("var none", orMinus(a));
  let b Option[i64] = Some(5);
  show("var some", orMinus(b));
  let c Result[i64, i32] = Ok(6);
  show("var ok", resCode(c));
  let d Result[i64, i32] = Error(7);
  show("var error", resCode(d));
  let e Tree[i64] = Tree.Node(41);
  show("var tree", treeSum(e));
  let f Tree[i64] = Tree.Leaf;
  show("var leaf", treeSum(f));
}

// A function that makes a type from nothing, and a type's own construction
fn types() {
  let g Tagged[i64] = make();
  show("make", i64.from(g.n));
  let h Tagged[f64] = make();
  show("make again", i64.from(h.n));
  let bx Box[i64] = new Box(5);
  show("new", bx.v * 10000000000);
  let p Pair[i32, i64] = pairOf(1i32);
  show("partly", i64.from(p.n));
}

// A function whose result is the parameter itself, and the literal that
// follows the type the value goes to
fn results() {
  let k i32 = forty();
  show("forty", i64.from(k));
  let m i64 = add(2000000000, 2000000000);
  show("add", m);
  let s i64 = same(5);
  show("same", s * 10000000000);
  let w Holder = new Holder(None);
  let z i64 = w.zero();
  show("method", z);
}

fn retNone() Option[i64] {
  return None;
}

fn lastSome() Option[i64] {
  Some(9);
}

fn branches(c bool) Option[i64] {
  if c { None; } else { Some(2); }
}

fn assigned() {
  var o Option[i64] = Some(1);
  show("before", orMinus(o));
  o = None;
  show("after", orMinus(o));
  o = Some(3);
  show("again", orMinus(o));
}

fn arguments() {
  show("arg none", orMinus(None));
  show("arg some", orMinus(Some(4)));
  let w Holder = new Holder(None);
  show("field", orMinus(w.o));
  let v Holder = new Holder(Some(8));
  show("field some", orMinus(v.o));
}

// A call among an overload set's arguments is wanted as the type every candidate
// that could take it declares there
fn sizedByCount overload sized(o Option[i64], n i64) i64 { orMinus(o) + n; }
fn sizedByLabel overload sized(o Option[i64], label &str) i64 { orMinus(o) * 100; }

fn overloads() {
  show("overload", sized(None, 5));
  show("overload str", sized(Some(3), "x"));
}

// The receiver of '<-' and '==' is checked first when the argument is a call
fn operators() {
  var xs = List[Option[i64]].empty();
  xs <- None;
  xs <- Some(4);
  show("append", i64.from(xs.len()));
  show("appended", orMinus(*xs[1]));
  let a Option[i64] = None;
  let b Option[i64] = Some(6);
  show("eq", if a == None {1;} else {0;});
  show("ne", if b != None {1;} else {0;});
  show("not eq", if b == None {1;} else {0;});
}

fn main() {
  variables();
  types();
  results();
  show("return", orMinus(retNone()));
  show("last", orMinus(lastSome()));
  show("if", orMinus(branches(true)));
  show("else", orMinus(branches(false)));
  assigned();
  arguments();
  overloads();
  operators();
}
