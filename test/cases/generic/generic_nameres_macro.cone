// What a macro method's body may not do: name a member of its type bare.
//
// In a method, a bare field or method name means 'self.name', and type check
// reaches it through the method's own receiver. A macro method's body is
// expanded into whichever function uses it, whose self -- if it has one -- is
// not this type's, so the body has to write 'self.name' itself. It is refused
// at name resolution, where the name is known to be a member, which is why
// this is its own stage rather than part of generic_typecheck_macro.
//
// Bare names that are not members stay legal in the body: a static function of
// the type, a global, a function, and the macro's own parameters.
//
// A macro parameter's type is resolved here too, so what it may not name is
// refused here: a function, nothing, or a trait.

mod generic_nameres_macro;

let limit = 100i64;

fn twice(n: i64) i64 {
  n + n
}

struct Gauge {
  level: i64;
  floor: i64 = 0i64;

  fn reading(self: &) i64 {
    self.level
  }

  fn hidden(self: &) i64 {
    self.floor
  }

  fn cap(n: i64) i64 {
    if n > limit {limit} else {n}
  }

  // A field, a method, a private method and another macro method, each bare
  macro bareField[self] {
    level                      //~ ErrorBareMbr:5 "through self"
  }

  macro bareMethod[self] {
    reading()                  //~ ErrorBareMbr:5 "through self"
  }

  macro barePrivateMethod[self] {
    hidden()                  //~ ErrorBareMbr:5 "through self"
  }

  macro bareMacroMethod[self] {
    bareField                  //~ ErrorBareMbr:5 "through self"
  }

  // Through self, and the non-members bare: nothing to report
  macro allowed[self, extra: i64] {
    cap(self.level + self.reading() + self.hidden() + twice(extra) + limit)
  }
}

// A macro parameter's type is resolved where the macro is declared, as its
// body is, and is a type: not a function, and not a name nothing declares
macro typedByAFunction[a: twice] {     //~ ErrorNotType:27 "must be a type"
  a
}

macro typedByNothing[a: Nonesuch] {    //~ ErrorUnkName:25
  a
}

// A macro parameter typed by a trait is refused as not built, as a constraint
// on a macro's type parameter is ('[T: Ordered]', generic_parse): what either
// would accept waits for generics. A generic trait's instance is one too. An
// enum is a closed family whose values a parameter holds, and a reference to
// a trait is a concrete type, so neither is refused.
trait Ordered {
  fn less(self: &, other: &Self) bool;
}

trait Pile[T] {
  fn put(self: &mut, v: T);
}

enum Coin {
  Heads;
  Tails;
}

macro typedByATrait[a: Ordered] {       //~ ErrorGenParmConstr:24 "typed by a trait"
  a
}

macro typedByALazyTrait[a: lazy Ordered] {    //~ ErrorGenParmConstr:33 "typed by a trait"
  a
}

macro typedByATraitInstance[p: Pile[i64]] {   //~ ErrorGenParmConstr:32 "typed by a trait"
  p
}

macro typedByAnEnum[c: Coin] {
  c
}

macro typedByATraitRef[a: &Ordered] {
  a
}
