// The number markers 'Float', 'Signed', 'Unsigned' and 'Numeric', granted by
// the compiler as 'Integer' is: 'Float' to f32 and f64, 'Signed' to the signed
// integers and the floats, 'Unsigned' to the unsigned integers, 'Numeric' to
// all of those. A method of a generic type exists only where its marker is met
// ('Cell[f64]' has 'halve' and no 'bump'). Each printed value was checked by
// hand against the source.

mod generic_number_markers;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn numeric[T](x: T) T where T is Numeric {x}
fn signed[T](x: T) T where T is Signed {x}
fn unsigned[T](x: T) T where T is Unsigned {x}

struct Cell[T] where T is Numeric {
  pub v: T;
  pub fn halve(self: &) T where T is Float {v * 0.5}
  pub fn bump(self: &) T where T is Integer {v + 1}
  pub fn neg(self: &) T where T is Signed {0 - v}
  pub fn same(self: &) T where T is Unsigned {v}
}

fn main() {
  show("numeric i8", i64.from(numeric(7i8)));
  show("numeric u64", i64.from(numeric(8u64)));
  show("numeric usize", i64.from(numeric(9usize)));
  show("numeric f32", i64.from(numeric(10.0f32)));
  show("numeric f64", i64.from(numeric(11.0)));

  show("signed i32", i64.from(signed(12i32)));
  show("signed isize", i64.from(signed(13isize)));
  show("signed f64", i64.from(signed(14.0)));
  show("unsigned u8", i64.from(unsigned(15u8)));
  show("unsigned usize", i64.from(unsigned(16usize)));

  let cf = Cell[f64](9.0);
  show("Cell[f64].halve", i64.from(cf.halve()));
  show("Cell[f64].neg", i64.from(cf.neg()));
  let ci = Cell[i32](20i32);
  show("Cell[i32].bump", i64.from(ci.bump()));
  show("Cell[i32].neg", i64.from(ci.neg()));
  let cu = Cell[u16](22u16);
  show("Cell[u16].same", i64.from(cu.same()));
  show("Cell[u16].bump", i64.from(cu.bump()));
}
