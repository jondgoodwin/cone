// A for-loop over a lazy nested instance. 'Rack[Option[i64]]', made by the member check
// of 'Rack[i64]', waits for a use. 'each' calls its 'iter', which gives a cursor
// ('Cur[Option[i64]]', itself a lazy nested instance of 'Cur') whose 'next' ends the
// loop; the program is generated and run. lift adds 2 to the count: the rack of 1
// lifts to 3, and the loop sees 3, 2, 1, a sum of 6 over 3 steps.

mod generic_lazy_each;

import stdio use *;

struct Cur[R] {
  n: i64;

  pub fn next(self: &mut Cur[R]) Option[i64] {
    if n <= 0i64 { return None; }
    let v = n;
    n = n - 1i64;
    Some[i64](v)
  }

  pub fn lift(self: &Cur[R]) Cur[Option[R]] {
    Cur[Option[R]](n)
  }
}

struct Rack[R] {
  count: i64;

  pub fn iter(self: &Rack[R]) Cur[Option[R]] {
    Cur[R](count).lift()
  }

  pub fn lift(self: &Rack[R]) Rack[Option[R]] {
    Rack[Option[R]](count + 2i64)
  }
}

fn main() {
  let h = Rack[i64](1i64);
  let r = h.lift();
  var total = 0i64;
  var steps = 0i64;
  each v in r {
    total = total + v;
    steps = steps + 1i64;
  }
  printInt(total);
  printStr(" ");
  printInt(steps);
  printStr("\n");
}
