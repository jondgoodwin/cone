// A global of a generic type's instance used above its declaration in file
// order: 'first' reads it before Svc is reached, so checking the global's
// declared type is what lays Box[Svc] out, and Svc's method, which calls a
// generic method on the global, is checked from the members queue that layout
// works on its way out. The declared type is in place before that
// (varDclTypeCheck); before, 'post' was refused as not generic. The printed
// values were checked by hand.

mod generic_global_before;

import stdio use *;

struct Box[S] {
  pub at: u64;
  pub fn post[J](self: &, j: J) u64 {j.run(at)}
}

fn first() u64 {g.at}

struct Add {
  pub n: u64;
  pub fn run(self, at: u64) u64 {at + n}
}

struct Svc {
  pub fn poke(self: &) u64 {g.post[Add](Add(5u64))}
}

fn main() {
  printStr("first = "); printUInt(first()); printStr("\n");
  printStr("poke = "); printUInt(Svc().poke()); printStr("\n");
}

let g: Box[Svc] = Box[Svc](10u64);
