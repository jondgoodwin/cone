// A call to a member its instance's 'where' leaves out, from a method body
// checked inside a layout in flight: deciding the bound 'S: Hosted' of the
// global 'g: Host[Svc]', declared above Svc, checks Svc's 'turn' inside the
// global's held declared type, where Table[i32, Req] and Cells[Req] are made
// while Req is not yet laid out. 'find' with text for an i32 key ('K is u64')
// and 'get' by number for a Req that moves ('V is Copy') each find no member
// that accepts them, as the same calls outside any layout do. Before, the
// members were still in their instances: the calls selected them, and their
// bodies were refused at arguments they were never written for.

mod generic_typecheck_where_in_layout;

trait Hosted {
  pub fn turn(self: &mut) u64;
}

struct Host[S: Hosted] {
  pub at: u64;
}

fn @initpure init() {
  g = Host[Svc](7u64);
}

struct Table[K, V] {
  key: K;
  vals: *V;
  pub fn findKey overload find(self: &, k: &K) u64 {if *k == key {1u64} else {0u64}}
  pub fn findText overload find(self: &, k: &str) u64 where K is u64 {
    let n: u64 = key;
    n + u64.from(k.len())
  }
}

struct Cells[V] {
  vals: *V;
  pub fn getRef overload get(self: &, tag: &str) &V {&*vals}
  pub fn getCopy overload get(self: &, i: u64) V where V is Copy {*vals}
}

let g: Host[Svc];

struct Svc {
  r: Rec;
  pub fn turn(self: &mut) u64 {
    let a = r.ti.find("abc");  //~ ErrorNoCandidate
    let b = r.cr.get(0u64).n;  //~ ErrorNoCandidate
    a + b
  }
}

struct Rec {
  ti: Table[i32, Req];
  cr: Cells[Req];
}

struct Req is Move {
  n: u64;
}

fn main() {
}
