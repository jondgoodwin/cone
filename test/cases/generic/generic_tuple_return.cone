// A generic function returning several values writes a value tuple, in its
// body and on an early return. The template is never analyzed, only each
// instance, so the template's tuples keep no value type; the tree check
// (--checktree, which every run of the suite passes) looks at the instances,
// which were analyzed, in the templates' place. A generic type's method is the
// same.

mod generic_tuple_return;

import stdio use *;

fn split[T](a T, b T) T, T {
  b, a;
}

fn found[T](a T, b T) T, Bool inline {
  if a == b {
    return a, true;
  }
  b, false;
}

struct Box[T] {
  pub v T;
  pub fn both(self &) T, Bool {v, true;}
}

fn main() {
  mut x = 0i64;
  mut y = 0i64;
  x, y = split[i64](1i64, 2i64);
  printInt(x); printStr(" "); printInt(y); printStr("\n");

  mut ok = false;
  x, ok = found[i64](3i64, 3i64);
  printInt(x); if ok {printStr(" found\n");} else {printStr(" not\n");}
  x, ok = found[i64](3i64, 4i64);
  printInt(x); if ok {printStr(" found\n");} else {printStr(" not\n");}

  imm b = Box[i32][5i32];
  mut v = 0i32;
  v, ok = b.both();
  printInt(i64.from(v)); if ok {printStr(" held\n");} else {printStr(" not\n");}
}
