// A generic alias is checked at each use: a bound its parameter declares is
// refused where an argument does not meet it, and the number of arguments must
// be the number of parameters. The bound is also checked when an alias is used
// through another alias.

mod generic_alias_params_refused;

import collections use List;

struct Owned is Move {
  pub n: i64;
}

alias Items[T] = List[T];
alias Plain[T: Copy] = List[T];
alias Both[K, V] = List[K];
alias ViaPlain[T] = Plain[T];

fn okay(a: Plain[i64], b: Items[Owned]) {
}

fn notCopy(a: Plain[Owned]) {         //~ ErrorWhereUnmet "Plain requires T is Copy"
}

fn throughAlias(a: ViaPlain[Owned]) { //~ ErrorWhereUnmet "Plain requires T is Copy"
}

fn tooFew(a: Both[i64]) {             //~ ErrorArgCount "The alias Both takes 2 type arguments, and this gives 1"
}

fn tooMany(a: Items[i64, i64]) {      //~ ErrorArgCount "The alias Items takes 1 type argument, and this gives 2"
}

fn bare(a: Items) {                   //~ ErrorArgCount "The alias Items takes 1 type argument, and this gives 0"
}
