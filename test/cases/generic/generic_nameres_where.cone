// What name resolution refuses of a constraint, once its names are bound. A
// clause's subject is a type parameter of the generic, or of the generic type
// it is a member of, and what it 'is' is a trait or a type (the type met by
// itself alone: 'where T is Bool'). A function is neither, nor is a generic
// type written without its arguments.
//
// The slot after a type parameter's name, '[T ___]', is one: what the name in
// it resolves to is what it means. A trait constrains the parameter; a type
// would make a value parameter, '[N usize]', and neither that nor a parameter
// of another kind is built, so each is refused there.
//
// A function that is neither generic nor a member of a generic type has no
// parameter for a clause to name.

mod generic_nameres_where;

trait Node {}

struct Point {
  pub x i32;
}

struct Box[U] {
  pub v U;
}

fn notParm[T](x T) T where Point is Node {     //~ ErrorWhereSubject:28 "is not one"
  x;
}

fn isType[T](x T) T where T is Point {
  x;
}

fn notTrait[T](x T) T where T is isType {      //~ ErrorWhereTrait:34 "a trait or a type, and this is neither"
  x;
}

fn bareGeneric[T](x T) T where T is Box {      //~ ErrorWhereTrait:37 "a trait or a type, and this is neither"
  x;
}

fn valueParm[N usize]() {                       //~ ErrorGenParmConstr:16 "not built"
}

fn plusType[T Node + i32](x T) T {              //~ ErrorGenParmConstr:22 "not built"
  x;
}

fn plain(x i32) i32 where T is Node {           //~ ErrorWhereNoParms:27 "nothing to constrain"
  x;
}

struct NotGeneric {
  pub v i32;
  pub fn get(self &) i32 where T is Node {      //~ ErrorWhereNoParms:32 "nothing to constrain"
    v;
  }
}
