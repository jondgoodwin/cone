// A generic alias that names itself, directly or inside its own argument, would
// expand without end. Each is refused at the use inside the alias's own
// expansion, and the compiler is not left to run out of stack. 'Nest' also
// reports what the refused argument leaves of 'List' (follow-on errors).

mod generic_alias_cycle;

import collections use List;

alias Self[T] = Self[T];
alias Nest[T] = List[Nest[T]];  //~ ErrorCircular "Nest is defined in terms of itself"
                                //~^ ErrorFieldsRebuild:26 follow-on
alias Fine[T] = List[T];

fn good(a: Fine[Fine[i64]]) {
}

fn direct(a: Self[i64]) {   //~ ErrorCircular "Self is defined in terms of itself"
}

fn nested(a: Nest[i64]) {
}                           //~^ ErrorBadArray:18 follow-on
