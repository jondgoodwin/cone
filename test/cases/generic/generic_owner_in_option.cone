// An optional owning reference in a generic type, '?Uni[T]', behaves in an
// instance as the same field written with the concrete type does: it stays an
// Option (None or Some), not a plain reference. Reached: None and Some in
// 'Box[Foo]' and in the hand-written 'Plain', matched the same way.
// Each printed value was checked by hand.

mod generic_owner_in_option;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

struct Foo { pub v: i64; }

struct Box[T] { pub p: ?Uni[T]; }
struct Plain { pub p: ?Uni[Foo]; }

fn boxed(b: &Box[Foo]) i64 {
  match b.p {
    case is Some { 1 }
    case is None { 2 }
  }
}

fn plain(b: &Plain) i64 {
  match b.p {
    case is Some { 1 }
    case is None { 2 }
  }
}

fn main() {
  var a = Box[Foo](None);
  var b = Plain(None);
  show("box-none", boxed(&a));
  show("plain-none", plain(&b));
  var c = Box[Foo](Some[Uni[Foo]](Uni[Foo](5)));
  var d = Plain(Some[Uni[Foo]](Uni[Foo](5)));
  show("box-some", boxed(&c));
  show("plain-some", plain(&d));
}
