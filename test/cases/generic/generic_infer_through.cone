// Type arguments inferred through the shape of a parameter's type, not only
// from a parameter whose type is the type parameter itself. No call below
// writes a type argument. Each parameter type is matched against its
// argument's type: a pointer, a reference or a slice to T takes T from what
// the argument points at, and an owning reference, 'Rc[mut, T]', is a reference; a generic type's instance takes each of its type
// arguments from the argument's instance of the same generic; a function
// reference's signature, '&fn(a A) R', takes each type from the signature of
// the function the argument references, parameter by parameter and then the
// return type; and a variant passed for its enum is taken as its enum's
// instance.
//
// The intrinsics are the reason this was built: 'mem.finalize(p)' with 'p' a
// '*Fin' had to be written 'mem.finalize[Fin](p)'. They are called here as a
// collection calls them.
//
// Each printed value was checked by hand against the source: the value each
// argument holds, reached through the pointer, reference or slice the call
// passes.

mod generic_infer_through;

import stdio use *;
import collections use *;

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

struct Fin {
  pub v i32;
  fn final(self &uni) { printStr("final "); printInt(i64.from(v)); printStr("\n"); }
}

struct Box[T] {
  pub v T;
}

struct Pair[A, B] {
  pub a A;
  pub b B;
}

fn deref[T](p *T) T { *p; }
fn derefTwice[T](p **T) T { **p; }
fn peek[T](r &T) T { *r; }
fn bump[T](r &mut T, amount T) { *r = *r + amount; }
fn first[T](s &Array[T]) T { s[0]; }
fn peekOwned[T](r &Rc[mut, T]) T { **r; }
fn takeOwned[T](r Rc[mut, T]) T { *r; }
fn firstShared[T](s &Rc[mut, List[T]]) T { *(*s)[0usize]; }
fn apply[A, R](arg A, f &fn(a A) R) R { f(arg); }
fn twice[T](v T, f &fn(a T) T) T { f(f(v)); }
fn unbox[T](b Box[T]) T { b.v; }
fn unboxRef[T](b &Box[T]) T { b.v; }
fn second[A, B](p &Pair[A, B]) B { p.b; }
fn inner[T](b Box[&T]) T { *b.v; }
fn orZero[T](o Option[T], zero T) T {
  match o {
    case imm s Some {s.value;}
    case is None {zero;}
  }
}
fn isSome[T](o Option[T]) bool {
  match o {
    case is Some {true;}
    case is None {false;}
  }
}

fn pointers() {
  mut x = 5i64;
  imm px = &mut x as *i64;
  // T is i64, from '*i64'
  show("pointer", deref(px));
  imm ppx = &px as **i64;
  // T is i64, two pointers down
  show("pointer-to-pointer", derefTwice(ppx));
}

fn references() {
  mut x = 7i64;
  show("reference", peek(&x));
  // T from the reference, and the second argument must agree with it
  bump(&mut x, 3i64);
  show("mutable-reference", x);
}

fn slices() {
  imm arr = [11i64, 12i64];
  imm s &Array[i64] = &arr;
  show("slice", first(s));
  // A reference to a fixed-size array, which the call turns into the slice
  show("array-to-slice", first(&arr));
}

// An owning reference parameter, borrowed or taken by value: the template holds
// 'Rc[mut, T]' as the bracketed call it was written as, never type checked, and
// the match descends through it to its last argument, T. A shared list,
// 'Rc[mut, List[T]]', descends through the reference and then the instance.
fn owning() {
  imm r = new Rc[mut, Box[i64]](13i64);
  show("borrowed-owning-reference", peekOwned(&r).v);
  show("owning-reference", i64.from(takeOwned(new Rc[mut, i64](14))));
  mut l = List[i64].empty();
  l.push(15i64);
  l.push(16i64);
  imm s = new Rc[mut, List[i64]](l);
  show("borrowed-shared-list", firstShared(&s));
}

fn instances() {
  imm b = new Box[i64](4i64);
  show("instance", unbox(b));
  show("reference-to-instance", unboxRef(&b));
  // Two type arguments, each from its own position in the instance
  imm p = new Pair[i32, i64](1i32, 9i64);
  show("two-type-arguments", second(&p));
  // A reference nested inside the instance's type argument
  mut y = 8i64;
  show("reference-inside-instance", inner(new Box[&i64](&y)));
}

fn triangle(n i32) i32 { n * (n + 1) / 2; }
fn widen(n i32) i64 { i64.from(n) * 1000; }
fn half[T](v T) T { v / 2; }
fn doNothing(n i32) { }

// Every call below was 'could not infer': a function reference's signature
// was a shape the match did not descend through
fn functionReferences() {
  // A is i32 from 100 and from triangle's parameter, R i32 from its return
  show("function-reference", i64.from(apply(100, &triangle)));
  // A and R differ, each from its own place in the signature
  show("function-reference-two-types", apply(7, &widen));
  // T from the value, and from both the parameter and return of the signature
  show("function-reference-one-type", i64.from(twice(3, &triangle)));
  // A reference to a generic function's instance, and one held in a local
  show("instance-reference", apply(9i64, &half[i64]));
  imm fr = &triangle;
  show("reference-in-a-local", i64.from(apply(4, fr)));
  // R is void, from a function returning nothing
  apply(5, &doNothing);
}

fn variants() {
  // Some[6i64] is passed where Option[T] is expected: T is i64
  show("variant-for-its-enum", orZero(Some[6i64], 0i64));
  if isSome(Some[2i64]) {printStr("variant-alone yes\n");}
  imm none Option[i64] = None[i64][];
  if isSome(none) {printStr("enum-value yes\n");} else {printStr("enum-value no\n");}
}

fn intrinsics() {
  // The calls a collection makes, none naming its element type
  imm p = malloc(mem.sizeof[i64]() * 3usize) as *i64;
  mem.writeRaw(p, 10i64);
  mem.writeRaw(p + 1usize, 20i64);
  mem.writeRaw(p + 2usize, 30i64);
  mem.moveRaw(p, p + 1usize, 2usize);
  imm s = mem.sliceFromParts(p, 2usize);
  show("sliceFromParts-sum", s[0] + s[1]);
  imm m = mem.sliceFromPartsMut(p, 2usize);
  m[0] = 21i64;
  show("readRaw", mem.readRaw(p));

  imm f = malloc(mem.sizeof[Fin]()) as *Fin;
  mem.writeRaw(f, new Fin(3i32));
  // T is Fin, from '*Fin': its final runs
  mem.finalize(f);
}

fn main() {
  pointers();
  references();
  slices();
  owning();
  instances();
  functionReferences();
  variants();
  intrinsics();
}
