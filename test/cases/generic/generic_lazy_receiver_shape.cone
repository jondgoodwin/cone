// Bug 120, the second shape the mutation run found: a lazy generic with a '&R' receiver
// and a method written with a bare '[]' receiver, instanced where a function takes
// 'Keep[[i64]]'. The compile ends with its errors at once.

mod generic_lazy_receiver_shape;

struct Keep[R] {
  count: i64;
  pub fn bump(self: Keep[& R]) {   //~ ErrorInvType:7 "self parameter for a method must match"
    count = count + 1i64;
  }
  pub fn lift(self: []) [[]] {   //~ ErrorBadArray:21 "empty array literal"
                                //~^ ErrorBadArray:26 "empty array literal"
  }
}

fn sink(k: Keep[[i64]]) {   //~ ErrorBadArray:17 "exactly one numeric array dimension"
}

fn main() {
}
