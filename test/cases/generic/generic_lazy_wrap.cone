// A generic type's method whose result is its own type at a larger argument
// ('Wrap[R]' giving 'Wrap[Option[R]]'), never called. The instance made for
// 'Wrap[i64]' checks 'lift', which names 'Wrap[Option[i64]]'; that nested instance
// has its template in its chain, so its members wait for a use and the chain stops
// (Bug 71: it used to expand without end).

mod generic_lazy_wrap;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }
}

fn main() {
  let w = Wrap[i64](5);
  printInt(w.v);
  printStr("\n");
}
