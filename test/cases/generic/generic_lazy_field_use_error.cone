// Where a user first meets an error in an uncalled method of a nested instance
// (generic_lazy_uncalled_error shows no call, no report): reading a field of the
// nested instance is a use too, so its members are checked then and the error in
// 'bad' is reported, with the instantiation chain pointing at 'lift' and at main.

mod generic_lazy_field_use_error;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }

  pub fn bad(self: &Wrap[R]) {
    let x = self.v + 1;   //~ ErrorNoMbr:20 "not found"
    printInt(5);
  }
}

fn main() {
  let w = Wrap[i64](5);
  let w2 = w.lift();
  let q = &w2.v;
  printInt(7);
}
