// The same chain reached by calling the method twice: the chain is made by the
// first instance's member check whether or not a call asks for it, and is refused
// once, naming the member 'lift'.

mod generic_nest_refused_chain;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {   //~ ErrorInstDepth:42 "member lift"
    Wrap[Option[R]](Some[R](self.v))
  }
}

fn main() {
  let w = Wrap[i64](5);
  let w2 = w.lift();
  let w3 = w2.lift();
  printInt(w.v);
  printStr("\n");
}
