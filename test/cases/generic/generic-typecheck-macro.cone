// Macro uses whose argument list does not match the declaration's parameters.
//
// Split from generic-typecheck-infer because a macro is checked by a different
// path: it has no type arguments to infer and no instance to build, so all it
// can get wrong is how many arguments it was given. Every diagnostic here is
// ErrorManyArgs, and they are told apart by the line each is on.
//
// Left out, because it fails as something other than a macro problem:
//
// - A parameterless macro name as a function's final statement. It is not
//   expanded before the block checks that its last statement can produce a
//   value, so the only diagnostic is ErrorNoRet, which says nothing about
//   macros.
// - A parameterless macro name as the left operand of an operator, 'm + 1i64'.
//   The operator's method call takes the macro name as the thing being called
//   and reports the wrong arity for it, which is the same code this file
//   already covers, at a site that misdescribes the problem.

macro one[p] {
  p
}

macro none {
  4i64
}

fn tooManyArguments() {
  imm r = one[1i64, 2i64]    //~ ErrorManyArgs:14 "number of arguments"
}

fn argumentsToNoParameters() {
  imm r = none[5i64]         //~ ErrorManyArgs:15 "number of arguments"
}

fn noArgumentsAtAll() {
  // A macro that declares parameters, named with none supplied. This is the
  // one arity diagnostic with its own message, because there is no argument
  // list to have counted.
  one                        //~ ErrorManyArgs:3 "expects arguments to be provided"
  imm r = 1i64
}
