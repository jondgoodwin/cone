// A number type meets a trait with methods by its built-in ones: core's Ordered
// ('<=>', the three-way comparison) is met by i32, u64 and f64, and by str. The
// trait writes '&Self' where the number's method takes the number by value, and
// the call in the generic body, 'a.cmp(&b)', reads the referent. The results are
// printed for each, with both orders of a pair and equal values, because a call
// that compiled but read the wrong thing (an address, say) shows here.
// Each printed value was checked by hand against the source.

mod generic_number_ordered;

import stdio use *;
import collections use *;

// The call through the trait's method, with a reference written against Self
fn viaCmp[T: Ordered](a: T, b: T) i32 { a.cmp(&b) }

// The call through the operator
fn viaOp[T: Ordered](a: &T, b: &T) i32 { a <=> b }

// A bound in a where clause
fn lessThan[T](a: T, b: T) bool where T is Ordered { a.cmp(&b) < 0i32 }

fn showI(n: i32) { printInt(n); printStr("\n"); }
fn showB(b: bool) { if b { printStr("true\n"); } else { printStr("false\n"); } }

fn main() {
  showI(viaCmp(3i32, 5i32));
  showI(viaCmp(5i32, 3i32));
  showI(viaCmp(-7i32, -7i32));
  showI(viaCmp(10000000000u64, 9u64));
  showI(viaCmp(9u64, 10000000000u64));
  showI(viaCmp(2.5f64, 2.25f64));
  showI(viaCmp(-1.5f64, 0.5f64));
  showI(viaCmp(0.5f64, 0.5f64));
  let x = 4i32;
  let y = 4i32;
  showI(viaOp(&x, &y));
  showI(viaOp(&1u64, &2u64));
  showI(viaOp(&1.0f64, &0.0f64));
  showI(viaOp("apple", "pear"));
  showI(viaOp("pear", "apple"));
  showI(viaOp("same", "same"));
  let sa = String.from("apple");
  let sb = String.from("pear");
  showI(viaOp(&sa, &sb));
  showI(viaOp(&sb, &sa));
  showI(viaOp(&sa, &sa));
  showB(lessThan(1i32, 2i32));
  showB(lessThan(2.0f64, 1.0f64));
}
