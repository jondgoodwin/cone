// A global whose type is a generic instance nested in another,
// 'Option[Box[Svc]]', declared above Svc, so checking the declared type lays
// both instances out. Svc's method, checked from the members queue that layout
// works on its way out, matches the global and calls a generic method on what
// it binds. The declared type is in place before that (varDclTypeCheck);
// before, the global still had the generic call it was written as, and the
// pattern was refused. The printed value was checked by hand: 20 + 7.

mod generic_global_nested;

import stdio use *;

struct Box[S] {
  pub at: u64;
  pub fn post[J](self: &, j: J) u64 {j.run(at)}
}

let g: Option[Box[Svc]];

fn @initpure init() {
  g = Some[Box[Svc]](Box[Svc](20u64));
}

struct Add {
  pub n: u64;
  pub fn run(self, at: u64) u64 {at + n}
}

struct Svc {
  pub fn poke(self: &) u64 {
    match g {
      case let Some(b) {b.post[Add](Add(7u64))}
      else {0u64}
    }
  }
}

fn main() {
  initAll();
  printStr("poke = "); printUInt(Svc().poke()); printStr("\n");
}
