// A member alias of a generic struct, reached through an instance of it:
// 'Bag[i64].Cur' names what 'alias Cur = List[T];' names in the instance
// (List[i64]). Before, the path was refused (ErrorUnkName, "not built"). The alias is
// pure expansion: a field typed by it, a function returning it, and a
// construction through it are all List[i64]. Printed value checked by hand:
// two pushes, so len = 2.

mod generic_member_alias_instance;

import stdio use *;
import collections use List;

struct Bag[T] {
  pub alias Cur = List[T];
  pub n: u64;
}

struct Holder {
  pub items: Bag[i64].Cur;
}

fn make() Bag[i64].Cur {
  var l = Bag[i64].Cur();
  l.push(5i64);
  l.push(6i64);
  l
}

fn main() {
  let h = Holder(make());
  printStr("len = "); printInt(i64.from(h.items.len())); printStr("\n");
}
