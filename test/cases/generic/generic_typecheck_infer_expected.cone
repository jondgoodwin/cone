// What the type expected of a generic's value does not say. A type argument no
// argument names is read off where the value goes (generic_infer_expected); where
// nothing gives it, the call is refused and the message names the parameters to
// write out. An expected type that does not match what the generic makes says
// nothing, so it is refused as it would be with none, and the ordinary mismatch
// follows where a value of the wrong type is kept.
//
// Not inferred, and so refused: a constructor given to a constructor, which has
// no expected type to take ('Some[None[]]'), a generic whose parameter comes from
// a later argument ('id2(None[], 5)'), 'None[]' as the receiver of a comparison,
// and an overload set whose candidates differ on the parameter. (As the other
// operand of one, 'x == None[]' is typed from x: enum_tag_equality.)

mod generic_typecheck_infer_expected;

struct Tagged[T] {
  pub n i32;
}

fn make[T]() Tagged[T] { new Tagged[T](7); }

fn id2[T](a Option[T], b T) T { b; }

fn wide overload pick(o Option[i64]) i64 { 1; }
fn narrow overload pick(o Option[i32]) i64 { 2; }

fn nothingSaysIt() {
  imm z = None[];                    //~ ErrorInvType:15 "Could not infer the type parameter T of None"
  imm l = make();                    //~ ErrorInvType:15 "Could not infer the type parameter T of make"
}

fn notAnOption() {
  // Wanted as an i32, which is no Option: the expectation says nothing
  imm c i32 = None[];                //~ ErrorInvType:19 "Could not infer the type parameter T of None"
}

fn notWhatIsMade() {
  // The argument says i32; the expectation says i64 and does not overwrite it
  imm a Option[i64] = Some[5i32];    //~ ErrorInvType:27 "Initialization value's type does not match"
}

fn nested() {
  imm n Option[Option[i64]] = Some[None[]];   //~ ErrorInvType:40 "Could not infer the type parameter T of None"
                                              //~^ ErrorInvType:35 "Initialization value's type does not match" follow-on
}

fn laterArgument() {
  imm i = id2(None[], 5);            //~ ErrorInvType:19 "Could not infer the type parameter T of None"
}

fn comparisons(x Option[i64]) {
  imm s = None[] == x;               //~ ErrorInvType:15 "Could not infer the type parameter T of None"
}

fn candidatesDiffer() {
  imm p = pick(None[]);              //~ ErrorInvType:20 "Could not infer the type parameter T of None"
                                     //~^ ErrorAmbigCandidate:15 follow-on
}
