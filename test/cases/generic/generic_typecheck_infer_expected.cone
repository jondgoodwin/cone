// What the type expected of a generic's value does not say. A type argument no
// argument names is read off where the value goes (generic_infer_expected,
// generic_infer_nested); where nothing gives it, the call is refused and the
// message names the parameters to write out. An expected type that does not
// match what the generic makes says nothing, so it is refused as it would be
// with none, and the ordinary mismatch follows where a value of the wrong type
// is kept.
//
// Not inferred, and so refused: an overload set whose candidates differ on the
// parameter.

mod generic_typecheck_infer_expected;

struct Tagged[T] {
  pub n: i32;
}

fn make[T]() Tagged[T] { new Tagged[T](7) }

fn wide overload pick(o: Option[i64]) i64 { 1 }
fn narrow overload pick(o: Option[i32]) i64 { 2 }

fn nothingSaysIt() {
  let z = None;                    //~ ErrorInvType:11 "Could not infer the type parameter T of None"
  let l = make();                    //~ ErrorInvType:15 "Could not infer the type parameter T of make"
}

fn notAnOption() {
  // Wanted as an i32, which is no Option: the expectation says nothing
  let c: i32 = None;                //~ ErrorInvType:16 "Could not infer the type parameter T of None"
}

fn notWhatIsMade() {
  // The argument says i32; the expectation says i64 and does not overwrite it
  let a: Option[i64] = Some(5i32);    //~ ErrorInvType:28 "Initialization value's type does not match"
}

fn candidatesDiffer() {
  let p = pick(None);              //~ ErrorInvType:16 "Could not infer the type parameter T of None"
                                     //~^ ErrorAmbigCandidate:15 follow-on
}
