// A type alias whose target is a generic type's instance, 'Box[Kit]', named
// there for the first time, so checking the alias's target is what lays
// Box[Kit] and Kit out. Kit's method, checked from the members queue that layout
// works on its way out, makes a value through the alias and calls a generic
// method on it. The target is in place before that queue is worked
// (aliasDclTypeCheck); before, the alias still stood for the generic call it
// was written as, and the target was refused as untyped. The same shape as a
// global's declared type (generic_global_method). The printed value was checked
// by hand: 3 + 7.

mod generic_alias_instance;

import stdio use *;

struct Box[S] {
  pub at: u64;
  pub fn post[J](self: &, j: J) u64 {j.run(at)}
}

alias Held = Box[Kit];

struct Add {
  pub n: u64;
  pub fn run(self, at: u64) u64 {at + n}
}

struct Kit {
  pub fn poke(self: &) u64 {
    let h = Held(3u64);
    h.post[Add](Add(7u64))
  }
}

fn main() {
  printStr("alias = "); printUInt(Kit().poke()); printStr("\n");
}
