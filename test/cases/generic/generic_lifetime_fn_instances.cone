// Two function-reference types that differ only in what their named lifetimes
// promise are two types: 'both''s result may hold either argument's borrow,
// 'first''s only the first's. So a generic instantiated with each is two
// instances, and their symbols spell the difference ('G', the promises, '_'
// after the signature's 'F').

mod generic_lifetime_fn_instances;

import stdio use *;

fn passThrough[T](a T) T {
  a;
}

fn both(a &i64, b &i64) &i64 {
  a;
}

fn first(a &i64, b &'b i64) &i64 {
  a;
}

fn main() {
  imm x = 4i64;
  imm f1 &fn(a &i64, b &i64) &i64 = passThrough(&both);
  imm f2 &fn(a &i64, b &'b i64) &i64 = passThrough(&first);
  printInt(*f1(&x, &x) + *f2(&x, &x));
  printStr("\n");
}
