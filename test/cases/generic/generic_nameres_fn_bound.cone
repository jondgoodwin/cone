// A function signature as a generic bound, refused where it is written: a type
// in it that names nothing, and a condition on a type's 'is' entry, which asks
// what a parameter is and takes no signature yet.

mod generic_nameres_fn_bound;

fn unknown[F fn(a &Nothing) i32](f &F) {}                  //~ ErrorUnkName:20 "Nothing"

fn unknownWhere[F](f &F) where F is fn(a &Nothing) i32 {}  //~ ErrorUnkName:43 "Nothing"

trait Marked {}

struct Wrap[F] is Marked if F is fn(x i32) i32 {           //~ ErrorUnbuiltIsCond:36 "function signature"
  pub f &F;
}

fn main() {}
