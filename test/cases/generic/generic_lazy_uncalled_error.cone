// An error in a nested instance's method that no call reaches is not reported:
// 'Wrap[Option[i64]]' (made by Wrap[i64]'s 'lift') has an uncalled 'bad' that does
// not compile for an Option, and the program compiles. Wrap[i64]'s own 'bad' is
// checked, as the first of its chain is eager.

mod generic_lazy_uncalled_error;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }

  pub fn bad(self: &Wrap[R]) i64 {
    self.v + 1
  }
}

fn main() {
  let w = Wrap[i64](5);
  let w2 = w.lift();
  printInt(w.bad());
  printStr("\n");
}
