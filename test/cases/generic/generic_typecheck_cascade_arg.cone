// An argument already reported as bad leaves the call it is given to nothing to
// check, so the report that made it bad is the only one. Two ways it used to say
// more: an overload set whose candidates are generics found none that took the
// bad value ("No function declared by `via` accepts the call's arguments"), and a
// method call that selected no candidate left its result of no type at all, so a
// generic inferring from it was instantiated with a parameter that had none
// ("Declared name must specify a type or value", inside the instance).

mod generic_typecheck_cascade_arg;

fn viaTwo[F fn(a i64, b i64) bool] overload via(f F) bool { f(1, 2); }
fn viaOne[F fn(a i64) bool] overload via(f F) bool { f(1); }

fn gen[T](x T) T { x; }

fn overloaded() {
  let f = (a, b) => false;   //~ ErrorClosureParm:12 "The type of a is not written"
  via(f);
}

fn unbounded() {
  let f = 1 + "a";           //~ ErrorNoCandidate:13 "No method declared by `+` accepts the call's arguments"
  let g = gen(f);
}

fn main() {
  overloaded();
  unbounded();
}
