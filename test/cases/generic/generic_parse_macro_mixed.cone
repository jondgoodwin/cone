// A macro and a function declared under one name in one scope are refused where
// the second is declared, pointed at that one and again at the first: a set of
// same-named declarations holds all macros or all functions. A function's name
// held by a module, or by one type's methods, and a macro of that name, in
// either order. (A field and a macro of one name stay a duplicate name.)

mod generic_parse_macro_mixed;

fn first(a: i32) i32 { a }                   //~ ErrorMacroMixedSet:1 "This is the function `first`"
macro first[a: i32] { a }                    //~ ErrorMacroMixedSet:7 "declared here as a macro"

macro second[a: i32] { a }                   //~ ErrorMacroMixedSet:7 "This is the macro `second`"
fn second(a: i32) i32 { a }                  //~ ErrorMacroMixedSet:1 "declared here as a function"

struct S {
  pub x: i32;

  fn both(self: &, a: i32) i32 { a }         //~ ErrorMacroMixedSet:3 "This is the function `both`"
  macro both[self, a: i32] { a }             //~ ErrorMacroMixedSet:9 "declared here as a macro"

  macro other[self, a: i32] { a }            //~ ErrorMacroMixedSet:9 "This is the macro `other`"
  fn other(self: &, a: i32) i32 { a }        //~ ErrorMacroMixedSet:3 "declared here as a function"
}

fn main() {
}
