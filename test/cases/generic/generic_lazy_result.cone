// The shape that found Bug 71: a wrapper type's method gives the wrapper of a
// Result of its own type argument, as an awaitable's 'orCancelled' would.

mod generic_lazy_result;

import stdio use *;

struct Cancelled {
  n: i64;
}

struct Waitable[R] {
  v: R;

  pub fn orCancelled(self: &Waitable[R]) Waitable[Result[R, Cancelled]] {
    Waitable[Result[R, Cancelled]](Ok[R, Cancelled](self.v))
  }
}

fn main() {
  let w = Waitable[i64](5);
  let w2 = w.orCancelled();
  printInt(w.v);
  printStr("\n");
}
