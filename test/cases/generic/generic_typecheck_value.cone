// What type check refuses of a value parameter's argument. An argument is a
// number written in the brackets, or read off an argument's array size, and
// nothing else: not a variable (a size is decided when the program is
// compiled), not negative, of the parameter's own type when it has a suffix,
// one it can hold, and as many as there are parameters. Two arguments that
// give the one parameter different sizes are refused, naming both. A parameter
// no argument gives a size cannot be inferred.

mod generic_typecheck_value;

fn dot[N usize](a &Array[f32, N], b &Array[f32, N]) f32 {
  0.0;
}

fn count[N usize]() usize {
  N;
}

fn small[N u8]() u8 {
  N;
}

fn main() {
  imm a3 = new Array[f32, 3] <- 1.0, 2.0, 3.0;
  imm a4 = new Array[f32, 4] <- 1.0, 2.0, 3.0, 4.0;
  dot(&a3, &a4);                  //~ ErrorGenValueClash:6 "must agree on it"
  imm n = 3usize;
  count[n]();                     //~ ErrorGenValueArg:9 "written as a number"
  count[-1]();                    //~ ErrorGenValueArg:10 "may not be negative"
  count[3, 4]();                  //~ ErrorArgCount:8 "Incorrect number"
  count[f32]();                   //~ ErrorGenValueArg:9 "written as a number"
  count[3u8]();                   //~ ErrorGenValueArg:9 "is a u8"
  count[]();                      //~ ErrorArgCount:8 "Incorrect number"
  count();                        //~ ErrorInvType:8 "Could not infer"
  small[300]();                   //~ ErrorGenValueArg:9 "does not fit it"
}
