// A generic trait as a constraint is named with its type arguments. Refused
// at the declaration: the trait with none (it names no trait until it has
// them), the wrong number, and, in a condition on an 'is' entry, an instance.

mod generic_nameres_trait_bound;

trait Stack[T] {
  pub fn push(self &mut, v T);
}

trait Pair[A, B] {
  pub fn both(self &, a A, b B);
}

fn bareInline[T, S Stack](s &mut S) {           //~ ErrorGenParmConstr:20 "Stack is a generic trait"
}

fn bareWhere[T, S](s &mut S) where S is Stack { //~ ErrorWhereTrait:41 "Stack is a generic trait"
}

fn tooFew[T, S Pair[T]](s &mut S) {             //~ ErrorArgCount:20 "Pair takes 2 type arguments, and this constraint gives 1"
}

fn tooMany[T, S](s &mut S) where S is Stack[T, T] {   //~ ErrorArgCount:44 "Stack takes 1 type argument, and this constraint gives 2"
}

struct Cond[T] is Move if T is Stack[T] {       //~ ErrorWhereTrait:37 "condition on an 'is' entry"
  pub v T;
}
