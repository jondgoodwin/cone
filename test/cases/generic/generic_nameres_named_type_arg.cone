// A type argument of a generic function is given by position. A name before it,
// 'id[T: i32](3)', is refused where it is written, once, with the form to write
// instead: a generic's parameters are not matched to names the way a struct's
// implicit init matches its fields ('Point(x: 1)'). The positional form beside
// it is accepted. A generic struct's brackets are left alone: 'Pair[a: 1, b: 2.0]'
// is its literal (generic_typecheck_infer).

mod generic_nameres_named_type_arg;

fn id[T](x: T) T { x }

fn two[A, B](a: A, b: B) A { a }

fn ok() i32 {
  id[i32](3) + two[i32, f64](1, 2.0)
}

fn oneArg() i32 {
  id[T: i32](3)                   //~ ErrorNamedArg:7 "Type arguments are not named; give the type, such as `id[i32](3)`"
}

fn secondArg() i32 {
  two[i32, B: f64](1, 2.0)        //~ ErrorNamedArg:13 "Type arguments are not named"
}
