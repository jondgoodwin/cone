// A macro whose body changes a plain parameter, found at type check.
//
// A plain parameter is evaluated once: the expansion binds its argument to a
// variable nothing may change, so an argument the macro assigns to must be
// 'lazy'. The changes type check sees are those that lend the parameter to be
// changed: a mutable borrow written out, an operator that changes its operand in
// place, and a method that takes 'self: &mut'. Each is refused where the body
// writes it, in each expansion. A plain assignment and a swap are refused by
// flow analysis, generic_flow_macro_once.
//
// None of it is refused where the change is through a reference the argument
// is, or where the parameter is 'lazy'.

mod generic_typecheck_macro_once;

struct Tally {
  pub n: i64;
  pub fn bump(self: &mut) { n = n + 1; }
}

macro lendIt[a: i64] {
  let r = &mut a;       //~ ErrorMacroParmAssign:11 "must be lazy"
  *r
}

macro addTo[a: i64] {
  a += 1i64;            //~ ErrorMacroParmAssign:3 "must be lazy"
  a
}

macro bumped[t: Tally] {
  t.bump();             //~ ErrorMacroParmAssign:3 "must be lazy"
  t.n
}

macro lendField[t: Tally] {
  let r = &mut t.n;     //~ ErrorMacroParmAssign:11 "must be lazy"
  *r
}

// Through a reference, and lazy: changed in the caller's place, as written
macro addThrough[r: &mut i64] {
  *r += 1i64;
  *r
}

macro bumpedThrough[t: &mut Tally] {
  t.bump();
  t.n
}

macro addToLazy[a: lazy i64] {
  a += 1i64;
  a
}

macro bumpedLazy[t: lazy Tally] {
  t.bump();
  t.n
}

fn uses() i64 {
  var x = 1i64;
  var t = Tally(n: 0);
  lendIt(x) + addTo(x) + bumped(t) + lendField(t)
    + addThrough(&mut x) + bumpedThrough(&mut t) + addToLazy(x) + bumpedLazy(t)
}
