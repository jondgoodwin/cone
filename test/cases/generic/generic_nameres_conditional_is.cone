// What name resolution refuses of a condition on an 'is' entry, each at the
// declaration and once: a type with no type parameters, which has nothing to
// vary by; a condition on Copy, which is written on Move instead; a condition
// asking about something not one of the type's own type parameters, a type or
// a name that is not declared; an entry naming no trait; a condition naming
// neither a trait nor a type; and a condition on an entry of a trait's 'is'
// list or of an enum's variant, which is not built. A condition that parses
// is otherwise the same as a 'where' clause's (generic_nameres_where).

mod generic_nameres_conditional_is;

trait Tag {}
struct Handle is Move {
  pub id i32;
}

struct NoParms is Move if T is Move {              //~ ErrorIsCondNoParms:27 "has no type parameters"
  pub n i32;
}
struct CopyIf[T] is Copy if T is Copy {            //~ ErrorIsCondCopy:21 "Copy takes no condition"
  pub v T;
}
struct NotParm[T] is Move if Handle is Move {      //~ ErrorWhereSubject:30 "Handle is not one"
  pub v T;
}
struct Unknown[T] is Move if U is Move {           //~ ErrorUnkName:30 "U"
  pub v T;
}
struct NotTrait[T] is Handle if T is Move {        //~ ErrorInvType:23 "names an abstraction"
  pub v T;
}
struct CondNotTrait[T] is Move if T is Option {    //~ ErrorWhereTrait:40 "condition on an 'is' entry"
  pub v T;
}
trait TraitCond[T] is Tag if T is Tag {}           //~ ErrorUnbuiltIsCond:30 "of a trait is not built"

enum Opt[T] is Tag if T is Tag {
  struct Some { pub v T; }
  struct Nada is Tag if T is Tag {}                //~ ErrorUnbuiltIsCond:25 "enum's variant is not built"
}
