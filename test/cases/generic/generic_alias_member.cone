// A generic alias declared inside a struct. In a generic struct, 'Bag[T]', it is
// used by the struct's own field and method; in a plain struct, 'Shelf', it is
// also reached from outside by its path, 'Shelf.Pair[u8]'. (A path through a
// generic instance, 'Bag[i64].Pair', is not built today for any member alias,
// generic or not: it is a compiler defect on master, left alone here.)
// Printed values were counted by hand: 3 pushes, 2 pushes, 1 push.

mod generic_alias_member;

import collections use List;
import stdio use *;

struct Bag[T] {
  pub alias Pair[U] = List[U];
  pub items: Pair[T];
  pub fn bytes(self: &) Pair[u8] {
    var r = Pair[u8]();
    r <- 1, 2;
    r
  }
}

struct Shelf {
  pub alias Pair[U] = List[U];
}

fn main() {
  var b = Bag[i64](List[i64]());
  b.items <- 4, 5, 6;
  printStr("items = "); printInt(i64.from(b.items.len())); printStr("\n");
  let o = b.bytes();
  printStr("bytes = "); printInt(i64.from(o.len())); printStr("\n");
  var s: Shelf.Pair[u8] = List[u8]();
  s <- 9;
  printStr("shelf = "); printInt(i64.from(s.len())); printStr("\n");
}
