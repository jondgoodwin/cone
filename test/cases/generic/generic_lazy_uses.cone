// Nested instances used without a direct call: a reference to the method taken as a
// function value and called through it, a closure naming the method that is never
// called, and a generic function bounded by a trait that calls it on the instance.
// Each reaches the method's body: it is checked, generated and runs.

mod generic_lazy_uses;

import stdio use *;

trait Badder {
  pub fn bad(self: &) i64;
}

struct Wrap[R] is Badder {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }

  pub fn bad(self: &Wrap[R]) i64 {
    7
  }
}

fn viaBound[T: Badder](t: &T) i64 {
  t.bad()
}

fn main() {
  let w = Wrap[i64](5);
  let w2 = w.lift();
  let w3 = w2.lift();
  let w4 = w3.lift();
  let f = &Wrap[Option[Option[i64]]].bad;
  printInt(f(&w3));
  printStr("\n");
  let neverCalled = fn(p: &Wrap[Option[Option[Option[i64]]]]) i64 { p.bad() };
  printInt(viaBound(&w2));
  printStr("\n");
}
