// A generic method's receiver takes part in inference as any argument does
// (generic_infer_receiver), so a receiver and an argument that say two different
// types for one parameter are refused at the argument, as two arguments would be
// (generic_typecheck_infer), rather than left to an instance whose 'self' is not
// the receiver's type.

mod generic_typecheck_infer_receiver;

struct Box[T] {
  pub v: T;
  pub fn withSame[U](self: &Box[Box[U]], d: U) U { d }
}

fn main() {
  let bb = Box[Box[i32]](Box[i32](5));
  let x = bb.withSame(7i64);       //~ ErrorInvType "Inconsistent type for generic function"
}
