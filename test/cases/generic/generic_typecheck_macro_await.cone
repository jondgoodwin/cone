// A compound assignment through a macro '+' whose operand holds an 'await',
// refused: the operand of a function '+' is made into a local before the seam,
// and an expansion substitutes it into the macro's body, where the wait cannot
// be cut. Awaiting into a local first is accepted.

mod generic_typecheck_macro_await;

import actors;

struct S {
  pub x: u64;

  macro `+`[self, o: u64] {
    S(x: self.x + o)
  }
}

fn give(n: u64) u64 { n }

actor Page {
  count: u64;

  pub async fn add(self) {
    var total = S(x: 1u64);
    total += await give(5u64);       //~ ErrorMacroAwait:14
    let v = await give(6u64);
    total += v;
  }
}

fn main() {}
