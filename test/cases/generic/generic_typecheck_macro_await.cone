// A compound assignment through a macro '+' whose operand holds an 'await',
// refused: the operand of a function '+' is made into a local before the seam,
// and an expansion substitutes it into the macro's body, where the wait cannot
// be cut. So is the right operand of an Option's or Result's '||' or '&&', a macro
// method too. Awaiting into a local first is accepted.

mod generic_typecheck_macro_await;

import actors;

struct S {
  pub x: u64;

  macro `+`[self, o: u64] {
    S(x: self.x + o)
  }
}

fn give(n: u64) u64 { n }
fn giveSome(n: u64) Option[u64] { Some(n) }

actor Page {
  count: u64;

  pub async fn add(self) {
    var total = S(x: 1u64);
    total += await give(5u64);       //~ ErrorMacroAwait:14
    let v = await give(6u64);
    total += v;
    let o: Option[u64] = None;
    let r = o || await give(7u64);    //~ ErrorMacroAwait:18
    let s = o && await giveSome(8u64);  //~ ErrorMacroAwait:18
    let r2 = o || v;
  }
}

fn main() {}
