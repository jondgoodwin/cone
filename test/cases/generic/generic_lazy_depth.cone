// A chain that does not stop on its own: 'deep' calls 'lift' and then 'deep' on the
// result, so each call checks the next instance's members, at a larger argument,
// without end. The chain is lazy only until a call asks, so ErrorInstDepth still
// refuses it at the limit.

mod generic_lazy_depth;

import stdio use *;

// (a struct with no 'is' clause: an Option would also check its Deserialize instance in core, which is where the
// limit would then be reported)
struct Pair[R] { a: R; }

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Pair[R]] {   //~ ErrorInstDepth:40 "nested more than 256 deep"
    Wrap[Pair[R]](Pair[R](self.v))
  }

  pub fn deep(self: &Wrap[R]) i64 {
    self.lift().deep()
  }
}

fn main() {
  let w = Wrap[i64](5);
  printInt(w.deep());
}
