// A chain that does not stop on its own: 'deep' calls 'lift' and then 'deep' on the
// result, so each call checks the next instance's members, at a larger argument,
// without end. The chain is lazy only until a call asks, so ErrorInstDepth still
// refuses it at the limit.

mod generic_lazy_depth;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {   //~ ErrorInstDepth:42 "nested more than 256 deep"
    Wrap[Option[R]](Some[R](self.v))
  }

  pub fn deep(self: &Wrap[R]) i64 {
    self.lift().deep()
  }
}

fn main() {
  let w = Wrap[i64](5);
  printInt(w.deep());
}
