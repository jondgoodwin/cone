// '?' over a macro's value parameter.
//
// In a macro's body '?a' cannot be told from 'Option[a]' until the macro is
// used, because 'a' is a parameter, which may stand for a type. A value
// parameter is bound to a value on expansion (a plain one to a variable, a
// 'lazy' one to the argument itself), and '?' of a value is no type and no
// allocation: refused where the macro writes it, in the words '?' is refused with
// anywhere else, and not as a type literal given too many values.
//
// '?' over a type parameter is the Option type, and stays one.

mod generic_typecheck_macro_ques;

macro plain[a: i64] {
  let t = ?a;                 //~ ErrorInvType:11 "'?' is not valid here."
  0i32
}

macro lazyArg[a: lazy i64] {
  let t = ?a;                 //~ ErrorInvType:11 "'?' is not valid here."
  0i32
}

// A type parameter makes '?T' the type Option[T]
macro typed[T][] {
  let none: ?T = None[T];
  0i32
}

fn options[T](x: ?T) i32 { 0i32 }

fn main() i32 {
  let a = plain(5i64);
  let b = lazyArg(6i64);
  let c = typed[i64]();
  let d = options[i64](None[i64]);
  a + b + c + d
}
