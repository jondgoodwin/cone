// A generic function's instance has one address within a program's object: the
// reference to '&half[i64]' taken at two sites, through a type parameter and in
// a struct's method, compares equal, and the instances for two type arguments
// differ. The promise is equality within one object; a program's copy of an
// instance and a library's may differ (generation.md, "Linkage").
mod generic_fn_address;
import stdio use *;

fn half[T](v: T) T { v / 2 }

fn addr(f: &fn(i64) i64) usize { f as usize }

fn viaParam[T]() usize {
  let f = &half[T];
  f as usize
}

struct Site {
  pub k: i64;
  pub fn take(self: &) usize {
    let f = &half[i64];
    f as usize
  }
}

fn same(label: &str,a: usize, b: usize) {
  printStr(label);
  printStr(if a == b { " = same\n" } else { " = different\n" });
}

fn main() {
  let first = &half[i64];
  let second = &half[i64];
  let s = Site(1);
  same("two-sites-in-main", first as usize, second as usize);
  same("passed-to-a-function", addr(first), second as usize);
  same("through-a-type-parameter", viaParam[i64](), first as usize);
  same("inside-a-method", s.take(), first as usize);
  same("other-type-argument", viaParam[f64](), first as usize);
}
