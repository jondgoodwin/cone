// A generic method called on a global of a generic type's instance, from a
// method of the instance's type argument. 'g' is declared above Svc, so checking
// its declared type is what lays Box[Svc] out, and Svc's method is checked from
// the members queue that layout works on its way out. The declared type is in
// place before that (varDclTypeCheck), so 'g.post[Add]' finds the generic
// method; before, 'post' was refused as not generic. 'late' is declared after
// Box[Svc] is laid out, which always compiled, and is called on the same way.
// The printed values were checked by hand.

mod generic_global_method;

import stdio use *;

struct Box[S] {
  pub at: u64;
  pub fn post[J](self: &, j: J) u64 {j.run(at)}
}

let g: Box[Svc] = Box[Svc](10u64);

struct Add {
  pub n: u64;
  pub fn run(self, at: u64) u64 {at + n}
}

struct Svc {
  pub fn poke(self: &) u64 {g.post[Add](Add(5u64))}
  pub fn prod(self: &) u64 {late.post[Add](Add(6u64))}
}

let late: Box[Svc] = Box[Svc](20u64);

fn main() {
  printStr("poke = "); printUInt(Svc().poke()); printStr("\n");
  printStr("prod = "); printUInt(Svc().prod()); printStr("\n");
}
