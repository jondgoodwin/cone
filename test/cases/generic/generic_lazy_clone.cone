// Clone of a lazy nested instance. 'Box[Option[i64]]', made by the member check of
// 'Box[i64]', waits for a use. It declares Clone and writes none, so the compiler gives
// it one that clones its fields in order (a List among them); the use checks its
// members and the clone is generated and run. Cloning is deep: the clone is changed
// afterwards to show the original is not. lift makes n 11 with one number in the list;
// the clone gets a second number and n 99; the original keeps n 11 and one number.

mod generic_lazy_clone;

import collections use *;
import stdio use *;

struct Box[R] is Clone {
  n: i64;
  items: List[i64];

  pub fn lift(self: &Box[R]) Box[Option[R]] {
    var l = List[i64]();
    l.push(5i64);
    Box[Option[R]](n + 10i64, l)
  }
}

fn main() {
  let h = Box[i64](1i64, List[i64]());
  var a = h.lift();
  var c = a.clone();
  c.items.push(6i64);
  c.n = 99i64;
  printInt(a.n);
  printStr(" ");
  printInt(i64.from(a.items.len));
  printStr(" ");
  printInt(c.n);
  printStr(" ");
  printInt(i64.from(c.items.len));
  printStr("\n");
}
