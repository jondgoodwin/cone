// Default is opt-in: a type is made by T() through the bound only if it is a
// number or bool, or declares Default. A struct that declares it must have a value
// for each field: a declared '= value', or a type that is Default itself.

mod generic_typecheck_default;

import collections use *;

fn make[T: Default]() T { T() }

// Moves, and declares no Default
struct Guard {
  n: i32;
  fn final(self: &uni) { }
}

// Has only numbers but declares nothing: no default where none was asked for
struct Mat { a: f32; b: f32 }

// Declares Default, but a field has neither a value nor a Default type
struct Holder is Default { n: i32; g: Guard }    //~ ErrorDefaultField:36 "Holder declares Default, and its field g has no `= value` and is Guard, which is not Default"

// Declares Default but its only init needs an argument, so T() is not a construction
struct NeedsArg is Default {   //~ ErrorDefaultInit:8 "NeedsArg declares Default, and writes an `init`, but none of its inits can be called with no arguments"
  n: i32;
  pub fn init(self: &new, v: i32) { *self = NeedsArg(n: v); }
}

// An init whose extra parameters have defaults is a construction with none
struct Loose is Default {
  n: i32;
  pub fn init(self: &new, v: i32 = 3) { *self = Loose(n: v); }
}

// A field with a declared value is fine; a field of an undeclared struct is not
struct Half is Default { n: i32 = 4; m: Mat }   //~ ErrorDefaultField:38 "Half declares Default, and its field m has no `= value` and is Mat, which is not Default"

fn main() {
  make[Mat]();       //~ ErrorWhereUnmet:7 "make requires T is Default, and Mat is not Default"
  make[Guard]();     //~ ErrorWhereUnmet:7 "make requires T is Default, and Guard is not Default"
  make[char]();      //~ ErrorWhereUnmet:7 "make requires T is Default, and char is not Default"
  make[&i32]();      //~ ErrorWhereUnmet:7 "make requires T is Default, and &ro i32 is not Default"
  make[Loose]();
  let n = i32(5);    //~ ErrorNewType:11 "A number is not constructed"
}
