// A nested instance used without a call: it is handed out as a virtual reference
// to a trait ('&<Badder') and called through it. The coercion needs the instance's
// vtable, so its members are checked then and its methods generated; the call goes
// through the vtable slot.

mod generic_lazy_vtable;

import stdio use *;

trait Badder {
  pub fn bad(self: &) i64;
}

struct Wrap[R] is Badder {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }

  pub fn bad(self: &Wrap[R]) i64 {
    7
  }
}

fn main() {
  let w = Wrap[i64](5);
  let w2 = w.lift();
  let b: &<Badder = &w2;
  printInt(b.bad());
  printStr("\n");
}
