// Core's Clone, "can be duplicated on request". Every Copy type is Clone by the
// compiler's grant, its clone() being the value: numbers, bool, a Copy struct, a
// tuple. A struct that writes a clone has it; one that declares Clone and writes
// none is given one that clones its fields in order (a String and a List among
// them). Option, Result, List and String have clone where their elements do.
// Cloning is deep: each clone is changed afterwards to show the original is not.
// `=` never clones: a Copy value assigned is a copy by the language, and a
// moving value is moved, not cloned. Each printed value was checked by hand.

mod generic_clone_trait;

import stdio use *;
import collections use *;

fn showI(n: i32) { printInt(n); printStr("\n"); }
fn showS(s: &str) { printStr(s); printStr("\n"); }

// The bound as a type parameter's, and as a where clause
fn twice[T: Clone](a: &T) (T, T) { (a.clone(), a.clone()) }
fn dup[T](a: &T) T where T is Clone { a.clone() }

// Copy, and Clone by grant
struct Pt { x: i32; y: i32 }

// Declares Clone and is Copy: its clone is the value
struct Tag is Clone { id: i32; on: bool }

// Derived over Copy and Clone fields, and a List and a String
struct Rec is Clone { id: i32; name: String; xs: List[i32]; at: Pt }

// Derived, nested: a derived struct inside one
struct Outer is Clone { r: Rec; n: i32 }

// Its own clone, counting how often it ran in the value
struct Counted is Clone {
  hits: i32;
  pub fn clone(self: &) Counted { Counted(hits + 1) }
}

fn main() {
  // Numbers and bool through the bound; `=` of a Copy value copies
  showI(dup(&5i32));                      // 5
  let ab = twice(&7i32);
  showI(ab.0 + ab.1);                         // 14
  var p = Pt(1, 2);
  var q = dup(&p);
  q.x = 10;
  showI(p.x * 100 + q.x);                 // 1 * 100 + 10 = 110
  let t = Tag(4, true).clone();
  showI(t.id);                            // 4

  // Derived clone of a struct holding a String and a List: deep
  var r = Rec(1, String.from("ab"), List[i32](), Pt(3, 4));
  r.xs.push(5);
  r.xs.push(6);
  var c = r.clone();
  c.xs.push(7);
  c.id = 2;
  showI(i32.from(r.xs.len));              // 2
  showI(i32.from(c.xs.len));                      // 3
  showI(r.id * 10 + c.id);                // 1 * 10 + 2 = 12
  showS(c.name.view());                   // ab
  showI(c.at.y);                          // 4
  showI(c.xs[2]);                         // 7

  // Nested derive
  let o = Outer(r.clone(), 9);
  let o2 = o.clone();
  showI(o2.n + o2.r.xs[1]);               // 9 + 6 = 15

  // A written clone is used, also through the bound
  let k = Counted(0);
  showI(k.clone().hits);                  // 1
  showI(dup(&k).hits);                    // 1
  showI(dup(&k.clone()).hits);            // 2
  // `=` never clones: assigning a Copy value copies it without calling clone
  let k2 = k;
  showI(k2.hits);                         // 0
  // a tuple and an array of numbers are Clone by grant
  let tp = (3i32, 4i32);
  showI(dup(&tp).1);                      // 4
  let arr = [5i32, 6i32];
  showI(arr.clone()[1]);                  // 6

  // Option and Result, where their contents are Clone
  let on: Option[String] = Some[String](String.from("hi"));
  let on2 = on.clone();
  showS(on2.unwrap().view());             // hi
  let none: Option[i32] = None;
  showI(if none.clone() == None { 1 } else { 0 });   // 1
  let res: Result[i32, String] = Ok[i32, String](3);
  match res.clone() {
    case let Ok(v) { showI(v); }          // 3
    case is Err { showI(-1); }
  }

  // List and String clone; elements cloned, not shared
  var ss = List[String]();
  ss.push(String.from("x"));
  ss.push(String.from("yz"));
  var ss2 = ss.clone();
  ss2.push(String.from("w"));
  showI(i32.from(ss.len) * 10 + i32.from(ss2.len));         // 2 * 10 + 3 = 23
  showS(ss2[1].view());                   // yz

  // resize fills with clones; appendSlice clones a move type's values
  var fill = List[String]();
  fill.resize(3, String.from("ab"));
  fill[0].appendByte(33u8);
  showS(fill[0].view());                  // ab!
  showS(fill[2].view());                  // ab
  var more = List[String]();
  more.appendSlice(ss.view());
  more.appendSlice(ss.view());
  showI(i32.from(more.len));                      // 4
  var nums = List[i32]();
  nums.resize(2, 9);
  nums.appendSlice(nums.clone().view());
  showI(i32.from(nums.len));                      // 4
  showI(nums[3]);                         // 9

  // Dict getCopy of a Clone value: a clone of the value, not a borrow
  var d = Dict[i32, String]();
  d.insert(1, String.from("one"));
  let g = d.getCopy(&1);
  showS(g.unwrap().view());               // one
}
