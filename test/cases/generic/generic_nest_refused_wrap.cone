// A generic type's method whose result is the type itself at a larger argument:
// the instance made for 'Wrap[i64]' checks 'lift', which names 'Wrap[Option[i64]]',
// whose 'lift' names the next, without end. Each instance is made while the previous
// one's members are checked, which are queued, so no expansion is nested in another
// on the stack; the chain's length is counted and refused at the limit, and the
// message names the chain and the method that makes it. 'lift' is never called.

mod generic_nest_refused_wrap;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {   //~ ErrorInstDepth:42 "nested more than 256 deep: Wrap[i64] -> Wrap[Option[i64]] -> ... -> Wrap"
    Wrap[Option[R]](Some[R](self.v))
  }
}

fn main() {
  let w = Wrap[i64](5);
  printInt(w.v);
  printStr("\n");
}
