// '||' and '&&' are methods of the left operand's type, so a left operand whose type
// declares neither cannot be used: a number, a pointer, a struct that has none.
// bool, Option and Result declare them. A number keeps 'isTrue' for a condition, and
// still stands on the right of a bool's operator, where it is converted.
//
// Test the value first: 'n != 0 && ...', 'p != null || ...', 'x is Some && ...'.
//
// Option's and Result's '&&' takes the same type on the right, and no plain value:
// there is no answer of the payload's type when the left is the failure.

mod generic_typecheck_macro_logic;

struct Plain {
  pub n: i64;
}

fn main() {
  let n = 3i64;
  let f = 1.5f64;
  let p: *i64 = null;
  let s = Plain(n: 1);
  let opt: Option[i64] = Some(1);

  let a = n && true;          //~ ErrorNoLogicMethod:11 "`&&` is a method of its left operand's type, and i64 declares none"
  let b = f || false;         //~ ErrorNoLogicMethod:11 "`||`"
  let c = p && true;          //~ ErrorNoLogicMethod:11 "`&&`"
  let d = s || true;          //~ ErrorNoLogicMethod:11 "Plain declares none"
  if n && n > 1 { }           //~ ErrorNoLogicMethod:6 "i64 declares none"
  let e = 2 || true;          //~ ErrorNoLogicMethod:11 "`||`"
  let g = opt && 5;           //~ ErrorMacroArgType:18 "other"

  // Allowed: the same operators on a bool, a number on the right, a number in a condition
  let ok1 = true && n;
  let ok2 = false || n;
  if n { }
}
