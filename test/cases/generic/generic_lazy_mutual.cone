// Mutual recursion between two templates: A[T]'s method returns B[A[T]] and B's
// returns A[B[T]]. The third instance of A has A in its chain, so it waits.

mod generic_lazy_mutual;

import stdio use *;

struct A[T] {
  v: T;

  pub fn toB(self: &A[T]) B[A[T]] {
    B[A[T]](A[T](self.v))
  }
}

struct B[T] {
  v: T;

  pub fn toA(self: &B[T]) A[B[T]] {
    A[B[T]](B[T](self.v))
  }
}

fn main() {
  let a = A[i64](3);
  let b = a.toB();
  let c = b.toA();
  printInt(c.v.v.v);
  printStr("\n");
}
