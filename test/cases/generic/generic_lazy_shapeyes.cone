// Shape inference over a lazy nested instance, the changing way: the nested
// 'Slots[Option[i64]]' has 'grow', which pushes, so once a use checks its members it is
// found shape-changing and 'grow' is refused while a borrow of an element is still to
// be used (ErrorShapeReshape). 'put', which only overwrites in place, is not.

mod generic_lazy_shapeyes;

import collections use *;

struct Slots[R] {
  items: List[R];

  pub fn put(self: &mut Slots[R], r: R) {
    items[0usize] = r;
  }

  pub fn grow(self: &mut Slots[R], r: R) {
    items.push(r);
  }

  pub fn firstMut(self: &mut Slots[R]) &mut R {
    &mut items[0usize]
  }

  pub fn lift(self: &Slots[R]) Slots[Option[R]] {
    Slots[Option[R]](List[Option[R]]())
  }
}

fn main() {
  let h = Slots[i64](List[i64]());
  var n = h.lift();
  n.items.push(Some[i64](4));
  let f = n.firstMut();
  n.put(None[i64]);
  n.grow(None[i64]);   //~ ErrorShapeReshape "reshapes the 'Slots'"
  *f = None[i64];
}
