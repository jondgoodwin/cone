// A bound may name a parameter declared after it, but only one of the
// declaration's own: a name that is no parameter of it is unknown, as ever.

mod generic_nameres_trait_bound_order;

trait Stack[T] {
  pub fn push(self: &mut, v: T);
}

fn unknownAfter[S: Stack[U], T](s: &mut S) {   //~ ErrorUnkName:26 "does not refer to a declared name"
}

struct HolderUnknown[S: Stack[U], T] {       //~ ErrorUnkName:31 "does not refer to a declared name"
  pub inner: S;
}
