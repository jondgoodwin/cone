// The method called twice: each call checks the members of the instance it is
// called on, which names the next instance (itself waiting), so the second call
// finds 'lift' checked and generated, and the third nested instance is never made
// into code.

mod generic_lazy_call;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }
}

fn main() {
  let w = Wrap[i64](5);
  let w3 = w.lift().lift();
  printInt(w3.v.unwrap().unwrap());
  printStr("\n");
}
