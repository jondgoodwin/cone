// A function signature is a bound of a generic function or type
// (generic_fn_bound), and of nothing else that takes brackets. A macro's value
// parameter takes a type, and a bare signature is no type: a function is
// passed as a reference to one, 'f: &fn(x: i32) i32'. The signature's own
// commas do not end the parameter, so the one after it is read as its own.

mod generic_parse_fn_bound;

macro twice[f: fn(x: i32, y: i32) i32, g: i32] { f(1, 2) }        //~ ErrorNoType:15 "Expected a type"

fn main() {}
