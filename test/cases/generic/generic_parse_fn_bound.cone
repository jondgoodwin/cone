// A function signature is a bound of a generic function or type
// (generic_fn_bound), and of nothing else that takes brackets: a macro's
// parameter, or a generic module's, takes no bound at all, a signature
// included. The signature's own commas do not end the parameter.

mod generic_parse_fn_bound;

macro twice[f fn(x i32, y i32) i32, g] { f(1, 2); }        //~ ErrorGenParmConstr:15 "may not carry a constraint or a type"

fn main() {}
