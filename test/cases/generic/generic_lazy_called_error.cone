// The same error, once a call reaches it: calling 'bad' on the nested instance
// checks its members and reports the error (as it was not when no call came).

mod generic_lazy_called_error;

import stdio use *;

struct Wrap[R] {
  v: R;

  pub fn lift(self: &Wrap[R]) Wrap[Option[R]] {
    Wrap[Option[R]](Some[R](self.v))
  }

  pub fn bad(self: &Wrap[R]) {
    let x = self.v + 1;   //~ ErrorNoMbr:20 "not found"
    printInt(5);
  }
}

fn main() {
  let w = Wrap[i64](5);
  let w2 = w.lift();
  w2.bad();
}
