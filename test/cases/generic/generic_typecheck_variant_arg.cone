// A variant given to a generic variant is the enum its place says only when the
// type expected of the whole says one (generic_infer_variant_arg). With none, as
// in a declaration without a type, it is the variant's own type, as it always
// was: 'Some(Color.Red)' is an 'Option[Color.Red]', which is no 'Option[Color]'.
// And a variant of another enum is still refused where an enum is wanted.

mod generic_typecheck_variant_arg;

enum Color { Red; Green; }
enum Shade { Dark; Light; }

fn takes(o Option[Color]) {}

fn noExpectedType() {
  let r = Some(Color.Red);
  takes(r);                          //~ ErrorInvType:9 "Expression's type does not match declared parameter"
}

fn otherEnum() {
  let a Option[Color] = Some(Shade.Dark);   //~ ErrorInvType:29 "Initialization value's type does not match"
  takes(Some(Shade.Light));                 //~ ErrorInvType:13 "Expression's type does not match declared parameter"
}
