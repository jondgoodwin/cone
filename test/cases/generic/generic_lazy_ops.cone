// Operators on a lazy nested instance. 'Acc[Option[i64]]', made by the member check of
// 'Acc[i64]' (a method returning its own type at a larger argument), waits for a use.
// '+', '-' and '==' on it are the type's operator methods: the use checks its members,
// and the program is generated and run. Each value printed was worked out by hand:
// lift adds 10 to the count, so a is 11 and b is 12; a + b is 23; b - a is 1;
// the comparison of a with a copy of itself is true, and with b false.

mod generic_lazy_ops;

import stdio use *;

struct Acc[R] {
  n: i64;

  pub fn lift(self: &Acc[R]) Acc[Option[R]] {
    Acc[Option[R]](n + 10i64)
  }

  pub fn `+`(self, o: Acc[R]) Acc[R] {
    Acc[R](self.n + o.n)
  }

  pub fn `-`(self, o: Acc[R]) Acc[R] {
    Acc[R](self.n - o.n)
  }

  pub fn `==`(self, o: Acc[R]) bool {
    self.n == o.n
  }
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn main() {
  let h = Acc[i64](1i64);
  let a = h.lift();
  let b = Acc[i64](2i64).lift();
  show("sum", (a + b).n);
  show("diff", (b - a).n);
  show("same", if a == Acc[Option[i64]](11i64) {1i64} else {0i64});
  show("other", if a == b {1i64} else {0i64});
}
