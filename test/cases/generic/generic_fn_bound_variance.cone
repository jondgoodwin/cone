// A function signature written as a generic bound, 'F fn(p &mut P) i32', is met by
// the one rule every callable meets a signature by (fnSigMeets, as a function
// reference and a trait's method do), not only by exactly that signature: a plain
// function or a struct's pub '()' whose parameters are the bound's or supertypes of
// them and whose result is the bound's or a subtype, where the difference is a
// recast with no run-time conversion (a read-only borrow for a writable one, a
// reference to the enum for one to the variant). The generic's body is checked at
// the argument, so the call in it passes the bound's values as they are.
// generic_typecheck_fn_bound_variance holds what is refused.

mod generic_fn_bound_variance;

import stdio use *;

struct P {
  pub x i32;
}

enum Shape {
  struct Circle { pub r i32; }
  struct Square { pub s i32; }
}

fn readOnly(p &P) i32 { p.x; }                 // asks less than the bound gives
fn shapeOf(s &Shape) i32 {                     // the enum for the variant
  match s {
    case imm c &Shape.Circle {c.r;}
    case imm q &Shape.Square {100 + q.s;}
  }
}
fn first(a &i64, b &'b i64) &i64 { a; }        // the result holds only a

// A struct whose '()' asks less of the borrow than the bound gives
struct Reads {
  pub fn `()`(self &, p &P) i32 { p.x * 10; }
}

// A struct whose '()' takes the enum where the bound gives the variant
struct Shapes {
  pub fn `()`(self &, s &Shape) i32 { match s {
    case imm c &Shape.Circle {c.r * 100;}
    case imm q &Shape.Square {q.s;}
  } }
}

fn runP[F fn(p &mut P) i32](f &F, p &mut P) i32 { f(p); }
fn runC[F fn(s &Shape.Circle) i32](f &F, s &Shape.Circle) i32 { f(s); }
fn runE[F fn(a &i64, b &i64) &i64](f &F, a &i64, b &i64) i64 { *f(a, b); }

fn main() {
  mut pt = new P(3);
  imm c = Shape.Circle(r: 5);
  imm x = 4i64;
  imm y = 9i64;
  imm reads = new Reads();
  imm shapes = new Shapes();
  print <- "function permission = ", runP(&readOnly, &mut pt), "\n";
  print <- "function enum for variant = ", runC(&shapeOf, &c), "\n";
  print <- "function lifetime = ", runE(&first, &x, &y), "\n";
  print <- "struct permission = ", runP(&reads, &mut pt), "\n";
  print <- "struct enum for variant = ", runC(&shapes, &c), "\n";
}
