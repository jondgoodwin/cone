// An associated type named through a generic instance's path, 'Many[i64].Cursor',
// is the alias the instance declares, as 'C.Cursor' through a type parameter is.
// Reached: as a local's type, as a parameter's type and as a result's; for two
// instances of the same generic type. Each printed value was checked by hand.

mod generic_assoc_instance_path;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

struct Rep[T] is Iterator[T] {
  pub v: T;
  pub left: i64;
  pub fn next(self: &mut) Option[T] {
    if left == 0 { None } else { left = left - 1; Some[T](v) }
  }
}

trait Seq[T] {
  type Cursor: Iterator[T];
  pub fn iter(self: &) Cursor;
}

struct Many[T] is Seq[T] {
  pub alias Cursor = Rep[T];
  pub v: T;
  pub n: i64;
  pub fn iter(self: &) Rep[T] { Rep[T](v, n) }
}

fn count(c: Many[i64].Cursor) i64 { c.left }

fn make(v: u8) Many[u8].Cursor { Rep[u8](v, 2) }

fn main() {
  var c: Many[i64].Cursor = Rep[i64](5, 3);
  show("local", c.v + c.left);
  show("param", count(Rep[i64](1, 4)));
  var d = make(7u8);
  show("result", i64.from(d.v) + d.left);
}
