// A generic's number parameter is inferred from a vector argument's lane count
// as it is from an array's size: 'fn lanes[N: usize](v: Vector[f32, N])' called
// as 'lanes(v)' with 'v: Vector[f32, 4]' takes N = 4, the same instance as the
// written 'lanes[4](v)'. Also the lane type as a type parameter, 'Vector[T, N]'.
// Reached: an inferred count, a written count, an inferred lane type and count
// at two sizes. Each printed value was checked by hand.

mod generic_infer_vector_size;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn lanes[N: usize](v: Vector[f32, N]) i64 { i64.from(N) }

fn lanesAny[T, N: usize](v: Vector[T, N]) i64 { i64.from(N) }

fn main() {
  let a = Vector[f32, 4]() <- fill 1.0;
  let b = Vector[f32, 8]() <- fill 2.0;
  let c = Vector[i16, 4]() <- fill 3;
  show("inferred4", lanes(a));
  show("inferred8", lanes(b));
  show("written4", lanes[4](a));
  show("any-f32x4", lanesAny(a));
  show("any-i16x4", lanesAny(c));
  show("any-f32x8", lanesAny(b));
}
