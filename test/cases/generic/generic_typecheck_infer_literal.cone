// A literal left to the type another argument or a bound gives is held to it:
// one that does not fit the type is refused as it would be anywhere a number of
// that type is wanted, and one for a type that is no number is inconsistent
// with it.

mod generic_typecheck_infer_literal;

trait Stack[T] {
  pub fn push(self &mut, v T);
}

struct Byte {
  pub n u8;
  pub fn push(self &mut, v u8) { n = v; }
}

struct Other {
  pub n i64;
}

fn fill[T, S Stack[T]](s &mut S, v T) {
  s.push(v);
}

fn first[T](a T, b T) T {a;}

fn main() {
  mut byte = new Byte(0);
  fill(&mut byte, 300);                //~ ErrorLitRange:19 "does not fit u8"
  imm small u8 = 3;
  first(small, 300);                   //~ ErrorLitRange:16 "does not fit u8"
  first(new Other(1), 7);              //~ ErrorInvType:23 "Inconsistent type for generic function"
}
