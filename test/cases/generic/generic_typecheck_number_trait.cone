// A number type meets a trait only by methods its built-ins have: i32 has no
// 'greet', bool has no three-way comparison (a bool is no quantity, so it is not
// Ordered), and a trait requiring the number's own method in another shape
// ('cmp' returning bool) is not met. Each is refused where the generic is
// called, naming the type and the trait.

mod generic_typecheck_number_trait;

trait Greeter {
  pub fn greet(self: &) i32;
}

trait WrongCmp {
  pub fn cmp(self: &, o: &Self) bool;
}

fn greetOf[T: Greeter](a: &T) i32 { 1 }
fn order[T: Ordered](a: &T, b: &T) i32 { 1 }
fn wrong[T: WrongCmp](a: &T, b: &T) i32 { 1 }

fn main() {
  let n = 3i32;
  let t = true;
  greetOf(&n);        //~ ErrorWhereUnmet:10 "greetOf requires T is Greeter, and i32 is not Greeter"
  order(&t, &t);      //~ ErrorWhereUnmet:8 "order requires T is Ordered, and bool is not Ordered"
  wrong(&n, &n);      //~ ErrorWhereUnmet:8 "wrong requires T is WrongCmp, and i32 is not WrongCmp"
}
