// A type parameter and what it must be take a ':' between them, '[T: Ordered]',
// '[N: usize]', '[F: fn(a: i32) i32]', as every declared name does
// (core_parse_nametype holds the rule). The old spelling is refused with no
// word about the old way. A macro's value parameter takes its type after a ':'
// the same way, '[a: i32]'. A lifetime bound alone, '[T + 'a]', has no type and
// so no ':'.

mod generic_parse_nametype;

trait Ordered {}

fn bound[T Ordered](a: T) T { a }               //~ ErrorBadTok

fn value[N usize]() usize { 0usize }            //~ ErrorBadTok

fn signature[F fn(a: i32) i32](f: F) { }        //~ ErrorBadTok

struct Box[T Ordered] {                         //~ ErrorBadTok
  pub v: T;
}

// A lifetime bound after the constraint, and a macro's parameter with a type
fn lifetime[T: Ordered + 'a](a: &'a T) &'a T { a }
macro twice[a: i32] { a }

fn lone[T + 'a](a: &'a T) &'a T { a }

// A ':' with no constraint after it
fn nothing[T:](a: T) T { a }                    //~ ErrorNoType
