// The shape that found this: a wrapper type's method gives the wrapper of its own
// type argument inside a Result, as an awaitable's 'orCancelled' would.

mod generic_nest_refused_result;

import stdio use *;

struct Cancelled {
  n: i64;
}

struct Waitable[R] {
  v: R;

  pub fn orCancelled(self: &Waitable[R]) Waitable[Result[R, Cancelled]] {   //~ ErrorInstDepth:57 "Waitable[i64] -> Waitable[Result[i64, Cancelled]] -> ... -> Waitable"
    Waitable[Result[R, Cancelled]](Ok[R, Cancelled](self.v))
  }
}

fn main() {
  let w = Waitable[i64](5);
  let w2 = w.orCancelled();
  printInt(w.v);
  printStr("\n");
}
