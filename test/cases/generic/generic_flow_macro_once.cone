// A macro whose body stores into a plain parameter, found by flow analysis,
// where the macro is used.
//
// A plain parameter is evaluated once: the expansion binds its argument to a
// variable nothing may change, so an argument the macro assigns to must be
// 'lazy'. A store whose refusal needs no type is refused where the macro is
// declared (generic_nameres_macro_once). What is left waits on a type, and
// flow analysis, where a store is checked, refuses it in each expansion: a
// store into, or a swap of, a part of a parameter typed by a type parameter,
// and a store another macro's 'lazy' parameter makes when it is given the
// plain one. What type check refuses is generic_typecheck_macro_once.
//
// None of it is refused where the change is through a reference the argument
// is, or where the parameter is 'lazy'.

mod generic_flow_macro_once;

struct Pair {
  pub a: i64;
  pub b: i64;
}

macro resetPart[T][p: T] {
  p.a = 0i64;           //~ ErrorMacroParmAssign:4 "must be lazy"
  p.a
}

macro swapPart[T][p: T, b: lazy i64] {
  p.a <-> b;            //~ ErrorMacroParmAssign:4 "must be lazy"
  b
}

// The plain parameter given to a macro whose lazy parameter is stored into
macro zero[x: lazy i64] {
  x = 0i64;
  x
}

macro viaZero[a: i64] {
  zero(a)               //~ ErrorMacroParmAssign:8 "must be lazy"
}

// Through a reference, and lazy: changed in the caller's place, as written
macro resetLazy[a: lazy i64] {
  a = 0i64;
  a
}

fn uses() i64 {
  var x = 1i64;
  var y = 2i64;
  var p = Pair(a: 1, b: 2);
  resetPart(p) + swapPart(p, y) + viaZero(x)
    + resetPart(&mut p) + swapPart(&mut p, y) + resetLazy(x) + zero(x)
}
