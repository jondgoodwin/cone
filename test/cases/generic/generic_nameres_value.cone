// What name resolution refuses of a value parameter, '[N usize]'. A size in a
// type is a number or a value parameter alone, 'Array[T, N]'; arithmetic over a
// parameter there, 'N + 1', would need two such sizes compared, and is not
// supported. A value parameter is an integer ('[N f32]', '[N bool]' and
// '[N char]' are not one), takes its type alone with no constraint beside it,
// and is no subject of a 'where' clause, which asks what a type is. A generic
// type does not take one yet: only a function or a method does.

mod generic_nameres_value;

trait Node {}

fn grow[T, N usize](a &Array[T, N + 1]) usize {   //~ ErrorGenValueArith:35 "is not supported"
  N;
}

fn nested[N usize](a &Array[f32, 2 * N, N]) usize {   //~ ErrorGenValueArith:36 "is not supported"
  N;
}

fn real[N f32]() {                                //~ ErrorGenValueParm:11 "not an integer type"
}

fn flag[N bool]() {                               //~ ErrorGenValueParm:11 "not an integer type"
}

fn letter[N char]() {                             //~ ErrorGenValueParm:13 "not an integer type"
}

fn withTrait[N usize + Node]() {                  //~ ErrorGenValueParm:24 "its integer type alone"
}

fn asSubject[N usize]() where N is Node {         //~ ErrorGenValueParm:31 "a number"
}

struct Matrix[N usize] {                          //~ ErrorGenValueParm:17 "a generic type does not take one"
  pub x i32;
}
