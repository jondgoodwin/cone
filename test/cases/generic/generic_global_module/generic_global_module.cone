// A global of a generic type's instance declared in another module, the
// generic type in a third: svc declares 'g: host.Box[Svc]' above Svc, so
// checking the global's declared type is what lays the instance out, and Svc's
// method, which calls a generic method on the global, is checked from the
// members queue that layout works on its way out. The declared type is in
// place before that (varDclTypeCheck); before, 'post' was refused as not
// generic. The root module reads a field through the global and calls the
// generic method on it from outside svc. The printed values were checked by
// hand.
//
// The folder holds:
//   host/host.cone   a submodule declaring the generic type
//   svc/svc.cone     a submodule declaring the global and its type argument

mod generic_global_module;

import stdio use *;

fn main() {
  printStr("at = "); printUInt(svc.g.at); printStr("\n");
  printStr("poke = "); printUInt(svc.Svc().poke()); printStr("\n");
  printStr("post = "); printUInt(svc.g.post[svc.Add](svc.Add(1u64))); printStr("\n");
}
