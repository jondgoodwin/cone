// The global of host's generic type, declared above the type argument whose
// method calls a generic method on it
mod svc;

import host;

pub let g: host.Box[Svc] = host.Box[Svc](10u64);

pub struct Add {
  pub n: u64;
  pub fn run(self, at: u64) u64 {at + n}
}

pub struct Svc {
  pub fn poke(self: &) u64 {g.post[Add](Add(5u64))}
}
