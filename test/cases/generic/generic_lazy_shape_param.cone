// A nested instance reached only through a free function's parameter type. 'Keep[R]'
// holds a list; 'Keep[Option[i64]]' is made by the member check of 'Keep[i64]' and
// named in 'touch's parameter. 'touch' calls nothing on it and reads no field of it, it
// only passes the reference on to 'sink', so no use checks its members. A borrow of an
// element of the instance's list, taken earlier, is read after the call; the compiler
// must still give an answer for the call, and the program compiles and runs.

mod generic_lazy_shape_param;

import collections use *;
import stdio use *;

struct Keep[R] {
  items: List[R];
  count: i64;

  pub fn bump(self: &mut Keep[R]) {
    count = count + 1i64;
  }

  pub fn lift(self: &Keep[R]) Keep[Option[R]] {
    Keep[Option[R]](List[Option[R]](), 0i64)
  }
}

fn sink(k: &mut Keep[Option[i64]]) {
}

fn touch(k: &mut Keep[Option[i64]]) {
  sink(k);
}

fn main() {
  let h = Keep[i64](List[i64](), 0i64);
  var n = h.lift();
  n.items.push(Some[i64](4));
  let r = &mut n;
  let e = &mut r.items[0usize];
  touch(r);
  match *e {
    case let Some(v) {printInt(v);}
    else {printStr("none");}
  }
  printStr("\n");
}
