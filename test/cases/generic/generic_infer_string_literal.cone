// A type argument inferred from a string literal. Where no type is wanted, a
// string literal is the borrow of its text it is, so 'Some["eight"]' is a
// 'Some[&str]', a variant of 'Option[&str]'. That reference type names 'str'
// through a name, as a written '&str' does, and an enum's instance names its
// own enum again at the same type argument, so each such name has to find the
// instance already made. Each shape here is one that did not finish
// compiling when it did not.
//
// Each printed value was checked by hand against the source: the text each
// literal holds, its length, and the numbers the array literal holds.

mod generic_infer_string_literal;

import stdio use *;

fn show(label &str, text &str) {
  printStr(label);
  printStr(" ");
  printStr(text);
  printStr(" ");
  printInt(i64.from(text.len));
  printStr("\n");
}

enum Maybe[T] {
  struct Yes {pub value T;}
  struct No {}
}
use Maybe;

fn id[T](x T) T {
  x;
}

// The variant passed where its enum is wanted, and matched there
fn five(o Option[&str]) {
  match o {
    case imm s Some[&str] { show("matched", s.value); }
    case is None[&str] { printStr("none\n"); }
  }
}

fn main() {
  imm some = Some["eight"];
  show("some", some.value);
  five(Some["seven"]);

  imm nested = Some[Some["x"]];
  show("nested", nested.value.value);

  imm e = "local";
  imm held = Some[e];
  show("local", held.value);

  imm yes = Yes["mine"];
  show("maybe", yes.value);

  imm numbers = Some[[1, 2, 3]];
  printStr("array ");
  printInt(i64.from(numbers.value[0] + numbers.value[1] + numbers.value[2]));
  printStr("\n");

  imm s = id("fn");
  show("id", s);
}
