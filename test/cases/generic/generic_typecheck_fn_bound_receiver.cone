// A function signature bound says which parameters and return a '()' has, and
// leaves what it may do to the permission the generic takes the parameter by.
// '&F' reaches a '()' that takes 'self &', and a callable whose '()' takes
// 'self &mut' given to one is refused at the caller's argument, in the author's
// terms: the generic takes the parameter as '&F', so the callable may only read
// its state (an instance is not made to be refused in its body). '&mut F'
// reaches both (generic_fn_bound keeps what a '&mut F' changed). A '&F' that
// is itself the parameter of a generic called from one is judged where the
// callable is given, and a closure that changes a variable is refused the same
// way (closure_typecheck_dynamic).

mod generic_typecheck_fn_bound_receiver;

struct Tally {
  pub n i32;
  pub fn `()`(self &mut, x i32) { n = n + x; }
}

struct Peek {
  pub n i32;
  pub fn `()`(self &, x i32) {}
}

fn read[F fn(x i32)](f &F, v i32) {
  f(v);
}

fn change[F fn(x i32)](f &mut F, v i32) {
  f(v);
}

fn main() {
  mut tally = new Tally(0);
  mut peek = new Peek(0);
  read(&peek, 1);
  change(&mut tally, 1);
  change(&mut peek, 1);
  read(&tally, 1);    //~ ErrorCallablePerm:8 "read takes `f` as `&F`, so the callable may only read its state; this one changes it (its `()` takes `self &mut`)"
}
