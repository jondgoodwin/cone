// A function signature bound says which parameters and return a '()' has, and
// leaves what it may do to the permission the generic takes the parameter by.
// '&F' reaches a '()' that takes 'self &', and calling one that takes
// 'self &mut' through it is refused where the instance's body calls it, as the
// same call through a '&' is anywhere; '&mut F' reaches both
// (generic_fn_bound keeps what a '&mut F' changed).

mod generic_typecheck_fn_bound_receiver;

struct Tally {
  pub n i32;
  pub fn `()`(self &mut, x i32) { n = n + x; }
}

struct Peek {
  pub n i32;
  pub fn `()`(self &, x i32) {}
}

fn read[F fn(x i32)](f &F, v i32) {
  f(v);                           //~ ErrorNoCandidate:4 "No method declared by `()` accepts the call's arguments"
}

fn change[F fn(x i32)](f &mut F, v i32) {
  f(v);
}

fn main() {
  mut tally = new Tally(0);
  mut peek = new Peek(0);
  read(&peek, 1);
  change(&mut tally, 1);
  change(&mut peek, 1);
  read(&tally, 1);
}
