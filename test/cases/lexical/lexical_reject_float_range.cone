// Float literals the lexer refuses: a value past the range of its type.
//
// A float literal is never given the type it is wanted as. It is f32 unless
// suffixed 'd' or 'f64', decided here, and generated at that type -- so a value
// past f32's range was generated as infinity, even as an f64's initializer or
// argument, and one past f64's range was infinity whatever its suffix. The
// lexer refuses it once, at the literal. A minus sign is no part of the rule.
//
// This is a parse-stage file, so nothing later than the parser runs. The clean
// lines pin the boundary: a value just past f32's maximum that rounds down to
// it still fits, as does anything an f64 holds once it is suffixed.

mod lexical_reject_float_range;

fn main() {
  // Past f32, unsuffixed or suffixed, and wherever it is wanted
  var plain f32 = 1e39;                    //~ ErrorFloatRange:19 "'1e39' does not fit f32"
  var suffixed f32 = 1e39f32;              //~ ErrorFloatRange:22 "'1e39f32'"
  var wanted f64 = 1e39;                   //~ ErrorFloatRange:20 "the 'd' suffix"
  var negative f64 = -1e39;                //~ ErrorFloatRange:23 "'1e39'"
  // Past f64
  var double f64 = 1e400d;                 //~ ErrorFloatRange:20 "'1e400d' does not fit f64"
  // Still fits: f32's maximum, one that rounds down to it, and an f64 suffixed as one
  var top f32 = 3.4028234e38;
  var roundsDown f32 = 3.4028235e38;
  var big f64 = 1e39d;
  var bigger f64 = 1.7e308d;
}
