// The range operators as tokens: '..=' (through its end) and '..<' (before it) are each one
// token, whatever follows them -- a negative bound ('..=-1'), a name with or without a blank
// before it ('..= b', '..=b'), a parenthesis, a character, a float, or a 'by' step -- and a
// bare '..' still ends an open slice ('s[a..]', 's[..]'). Every printed value was checked by
// hand against the source.

mod lexical_range_ops;

import stdio use *;

fn kind(c: char) i32 {
  match c {
    case 'a'..='c' { 1 }
    case 'x' ..= 'z' | '0'..='9' { 2 }
    case '#' ..<'&' { 3 }
    else { 0 }
  }
}

fn within(n: i32) i32 {
  match n {
    case -5..=-3 { 1 }
    case -2 ..= 0 { 2 }
    case 1 ..< 3 { 3 }
    else { 0 }
  }
}

fn main() {
  let b: i32 = 3;
  let n: i32 = 5;

  // each: an empty range, a negative end, a blank before the end or none, a step, a parenthesis
  var sum = 0;
  each i in 0..=-1 { sum += 100; }
  each i in -2..=-1 { sum += i; }
  each i in 0 ..= b { sum += i; }
  each i in 0..=b { sum += 10 * i; }
  each i in 0..=n by 2 { sum += 1000 * i; }
  each i in 3 ..= 0 by -1 { sum += 100000 * i; }
  each i in (0)..=(2) { sum += 7; }
  print <- "each ", sum, "\n";

  var steps = 0;
  each x in 0.0..=1.0 by 0.25 { steps += 1; }
  each x in 0.5 ..= 0.5 { steps += 10; }
  print <- "float ", steps, "\n";

  // slices: through, open, from the start, before
  let a = [10, 20, 30, 40, 50];
  let s = &a[1usize..=3usize];
  let t = &a[..=2usize];
  let u = &a[2usize..];
  let v = &a[..];
  let w = &a[1usize ..< 3usize];
  let x = &a[..<2usize];
  let k: usize = 4;
  let y = &a[k-3..=k-2];
  print <- "slices ", s.len, " ", s[0], " ", t.len, " ", t[2], " ", u.len, " ", v.len, " ", w.len, " ", x.len, " ", y.len, " ", y[1], "\n";

  // case patterns: before a brace, before a bar, after a bar, with negative bounds
  print <- "kind ", kind('b'), kind('c'), kind('d'), kind('y'), kind('5'), kind('$'), kind('&'), "\n";
  print <- "within ", within(-4), within(-3), within(-2), within(0), within(1), within(2), within(3), "\n";
}
