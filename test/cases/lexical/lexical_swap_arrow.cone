// '<->' is the swap token and '<=>' the three-way comparison, each one token
// whatever sits beside it, and neither changes how '<-' (send), '<', '<=' and a
// negative operand lex: '<-' is still the send beside a negative number ('t <- -1',
// 't<--1'), 'a < -b' is still a comparison with a negated right side, and '<->'
// is the swap with or without blanks around it. Swapped places: a local, a
// field, a tuple element, an array element, and a text that is a move type.
// Every printed value was checked by hand against the source.

mod lexical_swap_arrow;

import collections use *;
import stdio use *;

struct Tally {
  pub total: i32;
  pub fn `<-`(self: &mut, n: i32) { total = total + n; }
}

struct Pair {
  pub a: i32;
  pub b: i32;
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn main() {
  // Swaps, spelled with every blank placement
  var x: i32 = 1;
  var y: i32 = 2;
  x <-> y;
  show("swap blanks", x * 10 + y);
  x<->y;
  show("swap none", x * 10 + y);
  x <->y;
  show("swap before", x * 10 + y);
  x<-> y;
  show("swap after", x * 10 + y);

  // What is swapped
  var p = Pair(3, 4);
  p.a <-> p.b;
  show("swap field", p.a * 10 + p.b);
  var t = (5, 6);
  t.0 <-> t.1;
  show("swap tuple element", t.0 * 10 + t.1);
  var arr = [7, 8, 9];
  arr[0] <-> arr[2];
  show("swap array element", arr[0] * 100 + arr[1] * 10 + arr[2]);
  var s1 = String.from("one");
  var s2 = String.from("two");
  s1 <-> s2;
  printStr(s1.view());
  printStr(" ");
  printStr(s2.view());
  printStr("\n");

  // A send beside a negative number, and with no blank before the arrow
  var tally = Tally(0);
  tally <- -1;
  show("send blank negative", tally.total);
  tally<- -2;
  show("send tight negative", tally.total);
  tally <--4;
  show("send arrow dash", tally.total);
  tally<--8;
  show("send tight arrow dash", tally.total);
  tally <-16;
  show("send positive", tally.total);
  tally<-32;
  show("send tight positive", tally.total);

  // A comparison beside a negative, and the three-way comparison beside one
  let a: i32 = 3;
  let b: i32 = 4;
  show("less than negated", if a < -b {1} else {0});
  show("less or equal tight", if a<=b {1} else {0});
  show("three-way", a <=> b);
  show("three-way tight", a<=>b);
  show("three-way negated", a <=> -b);
  show("three-way tight negated", a<=>-b);
  show("three-way combined", (a <=> b) * 100 + (b <=> a) * 10 + (a <=> a));
}
