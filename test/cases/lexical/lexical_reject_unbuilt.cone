// Spellings the lexer knows and no feature reads, each refused with one
// diagnostic and nothing after it.
//
// '?.' is held for None propagation (refoption.html). It is reported and read
// as '.', so the member it reaches parses as it was meant and adds nothing.
//
// '#' is held for metaprogramming (refmeta.html). A '#' word is reported and
// dropped with the rest of its line, so the condition written after '#if' does
// not become a second error.
//
// An attribute is one of '@move', '@opaque' and '@unsized'; any other '@' word
// is reported and dropped, and the declaration it was written in is read
// without it. '@samesize' gets its own wording because it was once an attribute:
// an enum is same-size by default now, and '@unsized' is how one declines it.
//
// Every diagnostic here is the lexer's, so nothing later than the parser runs.
// The count in cases.toml is the point: one each, with no cascade behind any.

mod lexical_reject_unbuilt;

struct Point { pub x i32; }

fn member(p &Point) i32 {
  p?.x;                        //~ ErrorReserved:4 "'?.' is reserved for None propagation"
}

enum @samesize Shape {         //~ ErrorUnkAttr:6 "an enum is same-size by default, and '@unsized' declines it"
  struct Circle {}
  struct Square {}
}

enum @packed Signal {          //~ ErrorUnkAttr:6 "'@packed' is not a Cone attribute"
  struct On {}
  struct Off {}
}

#if windows                    //~ ErrorReserved:1 "'#' is reserved for metaprogramming"

fn body() i32 {
  #if debug                    //~ ErrorReserved:3 "'#' is reserved for metaprogramming"
  1;
}
