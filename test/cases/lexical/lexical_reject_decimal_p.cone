mod lexical_reject_decimal_p;

// The 'p' exponent belongs to hexadecimal literals only (design chat's ruling of 1 Nov
// 2026, delegated by Jon; reported 23 Sep 2026): a decimal literal takes its exponent with
// 'e', and '1p3' is refused once, at the 'p', as '0b1p3' is (lexical_reject_radix). The
// literal still ends where it should, so nothing after it is reported twice.
// lexical_hex_float_suffix holds the hexadecimal exponent.
//
// This is a parse-stage file, so nothing later than the parser runs.

fn main() {
  let a = 1p3;                       //~ ErrorRadixFloat:12 "A decimal literal takes its exponent with 'e'"
  let b = 2.5P-1;                    //~ ErrorRadixFloat:14
  let c = 1_0p+2f32;                 //~ ErrorRadixFloat:14
  // Well formed: the decimal exponent, and the hexadecimal one
  let d = 1e3;
  let e = 0x1p3;
}
