// The run of comments directly above a declaration, as the lexer keeps it and the
// parser attaches it to the declaration's span (--spans prints it as 'doc "..."').
// Raw text, markers included, every kind of declaration, and the cases that end a
// run or never start one. Nothing here is run: the compile is the scenario.

// The module's own line takes its run.
mod lexical_doc_runs;

// A function.
fn plain() {}

// A line comment run
// of two lines
pub fn twoLines() {}

// A blank line below this one breaks the run, so the function has no doc.

fn broken() {}

/* A block comment */
fn block() {}

/* Block comments nest: /* inner */ still the same comment,
   and span lines. */
fn nested() {}

// A line comment under a block
/* and a block under a line */
fn mixed() {}

fn trailing() {} // a trailing comment is no run of its own
fn afterTrailing() {}

/* a block comment on the declaration's own line */ fn sameLine() {}

// A string holding a slash pair is no comment, and adds nothing to a run.
let note: i32 = 0; let text = "// not a comment";

// A global.
let counted: i32 = 3;

// A constant.
const LIMIT: i32 = 10;

// A type alias.
alias Count = i32;

// A struct, its fields and its methods.
pub struct Shape {
  // The width field.
  pub width: i32;

  // Blank line above the next field: no run reaches it from here.

  pub height: i32;
  /* The area method. */
  fn area(self) i32 { 0 }
}

// An enum and its variants.
enum Color {
  // The red variant.
  Red;
  // The green variant.
  Green;
  Blue
}

// A trait and its method.
trait Drawn {
  // The draw method.
  fn draw(self);
}

// A module trait.
mod trait Shell {
  // The start requirement.
  pub fn start() i32;
}

// An extern block's own comment, which no item takes.
extern {
  // An extern function.
  fn declaredFirst() i32;
  // An extern global.
  let declaredGlobal: i32;
}

// An extern function alone.
extern fn declaredAlone() i32;

// A macro.
macro twice[a: i32] { a + a }

// A comment at the end of the file, with no declaration after it
