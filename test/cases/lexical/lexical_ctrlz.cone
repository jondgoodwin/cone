mod lexical_ctrlz;

import stdio use *;

// U+001A, Ctrl-Z, the old DOS end-of-file mark, is not an end of the source.
// Only a null character is (reftoken.html, End-of-File). Between tokens it is
// white space, as every control character is (reftoken.html, Whitespace).
// Ctrl-Z used to end the source wherever a token could begin, so everything
// after the first one below was never read: no 'after', no 'main'.
//
// This file holds raw Ctrl-Z bytes and ends in one, so it is kept byte for
// byte (.gitattributes).

// Between two declarations on one line: the second is read
imm before = 1;imm after = 2;

// In a line comment it no longer ends the comment, so what follows it on the
// line is comment too, not code:  $ is not read

/* A block comment always ran through one  $ and still does */

fn main() i32 {
  printStr("before = ");
  printUInt(u64[before]);
  printStr(", after = ");
  printUInt(u64[after]);
  printStr("\n");
  0;
}

// A trailing Ctrl-Z, as an old DOS editor wrote one, is white space and ends
// nothing: the file still compiles
