// 'and', 'or' and 'not' are ordinary names; the logical operators are '&&', '||' and
// '!'. The words written between operands, in front of one, or as a case's joiner are
// a name where the parser wants an operator or a block, refused as any stray name is.
// There is no message of their own for them.
//
// Parse stage only. The symbols that replaced them are in lexical_logic_symbols.

mod lexical_reject_logic_words;

fn conditions(a bool, b bool, n i32) bool {
  if a and b { return true; }         //~ ErrorNoLCurly
  if a or b { return true; }          //~ ErrorNoLCurly
  if not a { return true; }           //~ ErrorNoLCurly
  if a && b || !a { return true; }
  match n {
    case 0 or 1 { return true; }      //~ ErrorNoLCurly
    case 2 | 3 { return true; }
    else { }
  }
  false
}
