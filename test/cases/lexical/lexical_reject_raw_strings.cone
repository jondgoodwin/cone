mod lexical_reject_raw_strings;

// Raw and triple-quoted literals refused where they are written, by the rules the plain
// and the multi-line literal already have (lexical_reject_mlstring_open and
// lexical_reject_mlstring_margin), applied to the new openings. lexical_raw_strings holds
// the legal forms; lexical_reject_unclosed_raw the literal that never closes.

// Text on the opening line, the rest on the next, in a raw literal
let two = r"one
two";
//~^^ ErrorBadTok:11 "must start on the next line"

// The same in a backtick raw literal
let tick = r`one
two`;
//~^^ ErrorBadTok:12 "must start on the next line"

// And in a triple-quoted one, which must end its line right after its opening quotes
let triple = """one
two""";
//~^^ ErrorBadTok:14 "must start on the next line"

// A raw multi-line literal's line that is indented less than the closing quotes
let less = r"""
    a
  b
    """;
//~^^ ErrorBadTok:3 "indentation: 4 spaces"
