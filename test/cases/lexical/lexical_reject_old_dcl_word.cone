// 'imm' and 'mut' are the permissions of a reference, never the word a declaration
// starts with: that is 'let' (a name that is never given a new value) or 'var' (one
// that may be). The old spelling is refused wherever a declaration begins, with a
// message naming the word that replaces it, and is read as that word so that the
// rest of the declaration parses and checks as written: nothing below is reported
// twice.
//
// Every position that takes a declaration word is here once: a global, a thread-local
// global, a field, a static, a parameter, 'self', a closure's parameter and its state
// entry, a local, and the bindings of 'if' and 'case'.
//
// A permission other than those two is refused as before (core_parse_decls and
// struct_parse); a permission on a reference is unchanged and not refused.
//
// Parse stage only.

mod lexical_reject_old_dcl_word;

imm g1: i32 = 1;                         //~ ErrorDclWord:1 "Write 'let' here"
mut g2: i32 = 2;                         //~ ErrorDclWord:1 "Write 'var' here"
mut @threadlocal g3: i32 = 3;            //~ ErrorDclWord:1 "Write 'var' here"

struct S {
  imm a: i32;                            //~ ErrorDclWord:3 "Write 'let' here"
  pub mut b: i32;                        //~ ErrorDclWord:7 "Write 'var' here"
  static mut count: i32 = 0;             //~ ErrorDclWord:10 "Write 'var' here"
}

enum E {
  pub n: i32;
  pub fn setN(mut self, v: i32) Self {   //~ ErrorDclWord:15 "Write 'var' here"
    n = v;
    self
  }
  pub struct A {
    pub a: i32;
  }
}

fn params(imm p: i32, mut q: i32) i32 {   //~ ErrorDclWord:11 "Write 'let' here"
                                        //~^ ErrorDclWord:23 "Write 'var' here"
  p + q
}

fn locals() {
  imm x = 1;                            //~ ErrorDclWord:3 "Write 'let' here"
  mut y: i32 = 2;                        //~ ErrorDclWord:3 "Write 'var' here"
  let f = fn (imm u: i32) [mut n = 0] i32 { u + n };   //~ ErrorDclWord:15 "Write 'let' here"
                                        //~^ ErrorDclWord:28 "Write 'var' here"
}

fn bindings(o: Option[i32]) i32 {
  if imm a Some[i32] = o {              //~ ErrorDclWord:6 "Write 'let' here"
    return a;
  }
  match o {
    case mut b Some[i32] { b }         //~ ErrorDclWord:10 "Write 'var' here"
    else { 0 }
  }
}
