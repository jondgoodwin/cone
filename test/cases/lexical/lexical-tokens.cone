// Identifiers, comments and the greedy operator rule.
//
// These are facts a clean compile can carry on its own: an identifier that is
// not the identifier next to it is two declarations rather than a duplicate, a
// comment that is a comment produces no token at all, and an operator token that
// split the wrong way would not parse. Nothing here needs a value printed, so
// this scenario compiles and is never run.

// -------- identifiers --------

// Case matters, so these are two distinct globals rather than a duplicate name
mut abc = 1
mut ABC = 2

// A leading and a trailing underscore, and digits after the first character
mut _temp_ = 3
mut to2Return = 4
mut balance_2 = 5

// Unicode letters are identifier characters
mut π = 3.14159
mut ∑ = 0

// Back-ticks admit characters an identifier could not otherwise hold
mut `odd name` = 6
mut `%` = 7

fn identifiers() i32 {
  // Both spellings resolve, and to different declarations
  abc = ABC
  _temp_ = to2Return + balance_2
  `odd name` = `%`
  abc + `odd name`
}

// -------- comments --------

// A line comment on a line of its own.
fn comments() i32 {   // ... and one after code on the same line
  /* A block comment between two statements. */
  mut a = 1 /* and one between two tokens of one statement */ + 2

  /* A block comment
     spanning several
     lines. */

  /* Block comments nest: /* this inner one closes first */ and this text is
     still inside the outer comment. */

  // A block comment opener inside a line comment is not an opener: /*

  /*
  // A line comment inside a block comment is skipped whole.
  */

  // Comment delimiters inside a string literal are just characters
  mut s = "/* not a comment */ // nor this"
  a
}

// -------- operators as tokens --------

// The lexer is greedy: it takes the longest operator that matches. Each of
// these would parse differently, or not at all, if it split short.
fn operators(a i32, b i32) i32 {
  mut n = a

  // Two characters, where the first character alone is also an operator
  n += b
  n -= b
  n *= b
  n /= b
  n %= b
  n &= b
  n |= b
  n ^= b
  n <<= b

  // '++' and '--' against '+' and '-'
  n++
  n--
  ++n
  --n

  // Comparison, where '<' and '>' and '!' and '=' are all operators alone
  mut flag = a == b
  flag = a != b
  flag = a <= b
  flag = a >= b
  flag = a < b
  flag = a > b
  flag = !flag

  // Shifts against comparison
  n = a << 1
  n = a >> 1

  n
}

// '&[]' is one token rather than '&' followed by '[' and ']'; the reference
// groups own what it means.
fn reftokens(sliced &[]i32) usize {
  sliced.len
}
