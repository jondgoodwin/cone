// Words the language has claimed but not implemented, refused as identifiers.
//
// doc/reference/reftoken.html publishes a list of keywords that "are reserved and may
// not be used as identifiers". Nine of them had no token in the lexer and so
// compiled as ordinary names; five more spell the syntax of features described in
// refexcept.html and refcorout.html that reftoken.html has not caught up with.
// Holding all fourteen now costs a rename; letting a program bind one costs that
// program a rewrite when the feature lands.
//
// Three names on reftoken.html's list are deliberately not reserved. 'self' and
// 'this' already work, as a method's first parameter and as the value of a 'with'
// block; core_success and struct_methods pin both. 'actor' names a kind of
// declaration rather than a word with no syntax behind it, so it is a token of
// its own and the parser reports it where the declaration is written --
// trait_parse_kind_modifier.
//
// The lexer reports the word and then releases the name, so the word behaves as
// the identifier the author meant for the rest of the compile. That is why each
// word is reported once, at its first appearance, and why the two uses of
// 'yield' below produce one diagnostic rather than two.
//
// This is a parse-stage file and every diagnostic in it is a parse diagnostic,
// so nothing later than the parser runs and no type-check expectation could be
// added here.

mod lexical_reject_reserved;

fn throw() { }               //~ ErrorReserved:4 "'throw' is reserved"
fn catch() { }               //~ ErrorReserved:4 "'catch' is reserved"
fn panic() { }               //~ ErrorReserved:4 "'panic' is reserved"
fn assert() { }              //~ ErrorReserved:4 "'assert' is reserved"
fn spawn() { }               //~ ErrorReserved:4 "'spawn' is reserved"

fn async() { }               //~ ErrorReserved:4 "'async' is reserved"
fn baseurl() { }             //~ ErrorReserved:4 "'baseurl' is reserved"
fn context() { }             //~ ErrorReserved:4 "'context' is reserved"
fn selfmethod() { }          //~ ErrorReserved:4 "'selfmethod' is reserved"
fn using() { }               //~ ErrorReserved:4 "'using' is reserved"
fn wait() { }                //~ ErrorReserved:4 "'wait' is reserved"

// A reserved word is refused wherever an identifier may appear, not only in a
// declaration's name: as a local variable, and as a parameter.
fn holder(new i32) {         //~ ErrorReserved:11 "'new' is reserved"
  mut local = 1;              //~ ErrorReserved:7 "'local' is reserved"
  mut yield = 2;              //~ ErrorReserved:7 "'yield' is reserved"
  yield = 3;
}
