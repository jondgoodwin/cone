mod lexical_reject_mlstring_margin;

// A multi-line string literal's content line that does not begin with exactly
// the closing quote's whitespace, the literal's margin (doc/reference/
// reftoken.html, "Multi-line String Literals"; Jon's ruling of 24 September
// 2026). Each is refused on its own line, at the first character that differs
// from the margin, and the message says what the margin is. A line of nothing
// but spaces and tabs is exempt: it is an empty line (lexical_mlstring_margin).
//
// The lines' exact spaces and tabs are the subject, so the file is kept byte
// for byte (.gitattributes).

// A line indented less than the closing quote
imm less = "
      a
    b
      ";
//~^^ ErrorBadTok:5 "indentation: 6 spaces"

// As many characters as the margin, but a tab where it has a space
imm tabbed = "
    a
	   b
    ";
//~^^ ErrorBadTok:1 "indentation: 4 spaces"

// Spaces where the margin has tabs, as wide as they are in some editor
imm spaced = "
		a
        b
		";
//~^^ ErrorBadTok:1 "indentation: 2 tabs"

// The margin's characters in another order
imm order = "
	  a
  	b
	  ";
//~^^ ErrorBadTok:1 "the same 3 spaces and tabs, in the same order"

// A line joined to the one before by a backslash is held to the margin too
imm joined = "
    a \
  b
    ";
//~^^ ErrorBadTok:3 "indentation: 4 spaces"

// Each such line is refused, not only the first
imm twice = "
   a
  b
	c
   ";
//~^^^ ErrorBadTok:3 "indentation: 3 spaces"
//~^^^ ErrorBadTok:1 "indentation: 3 spaces"
