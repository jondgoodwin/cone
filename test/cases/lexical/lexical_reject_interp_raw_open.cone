mod lexical_reject_interp_raw_open;

// A raw literal inside an interpolation's braces that never closes. The brace skipper
// does not take it for a literal, so the '}' after it closes the expression, and the
// expression's own lexing then reports the literal at its opening. It is the one such
// literal in the file: an unclosed literal reads on to the end of its source.

let bad = $"{r`}";  //~ ErrorBadTok:14 "never closed"
