mod lexical_reject_ctrlz;

// Code after a Ctrl-Z (U+001A) is read as code. It used to end the source
// wherever a token could begin, so nothing after the first one was reported.
// lexical_ctrlz holds the programs that compile; this holds the errors that
// a Ctrl-Z once hid. Each is a reserved word, which is one diagnostic and
// nothing after it. The file holds raw Ctrl-Z bytes, so it is kept byte for
// byte (.gitattributes).

// Right after the Ctrl-Z, on its line
imm a = 1;imm yield = 2;     //~ ErrorReserved:16 "'yield' is reserved"

// A '#' word is dropped with the rest of its line, the Ctrl-Z and the '$'
// after it included, where the Ctrl-Z used to stop the drop and end the
// source; the line after that is read
#if x  $                     //~ ErrorReserved:1 "'#if'"
imm spawn = 3;                  //~ ErrorReserved:5 "'spawn' is reserved"
