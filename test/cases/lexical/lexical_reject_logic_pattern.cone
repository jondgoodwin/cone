// A case's pattern is a value, a range, a comparison with the matched value or an 'is'.
// '||' and '!' make a condition, which is not a pattern (ErrorPatBare), as 'or' and 'not'
// did: the joiner of patterns is '|'.
//
// Parse stage only. Patterns joined by '|' are in enum_match_alternatives.

mod lexical_reject_logic_pattern;

fn pick(n i32, ready bool) i32 {
  match n {
    case 0 || 1 { 1 }          //~ ErrorPatBare
    case !ready { 2 }          //~ ErrorPatBare
    case 2 | 3 { 3 }
    else { 4 }
  }
}
