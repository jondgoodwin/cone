// '&&', '||' and '!' are the logical operators. They short-circuit and bind as the
// words 'and', 'or' and 'not' did: '!' tighter than a comparison's result, then '&&',
// then '||'. The words are ordinary names now, and the bitwise '|' and '&' are
// untouched (lexical_andand_borrows pins the borrows).
//
// Each printed value was checked by hand against the source.

mod lexical_logic_symbols;

import stdio use *;

var calls i64 = 0;

fn side(result bool) bool {
  calls = calls + 1;
  result
}

// 'and', 'or' and 'not' are names: of functions, variables and fields
fn and(a i64, b i64) i64 {
  a + b
}

struct Gate {
  pub or i64;
  pub not i64;
}

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn truth(b bool) i64 {
  if b { 1 } else { 0 }
}

fn main() {
  let t = true;
  let f = false;

  // short circuit
  if f && side(true) { }
  if t || side(true) { }
  show("skipped", calls);                       // 0
  if t && side(true) { }
  if f || side(true) { }
  show("run", calls);                           // 2

  // precedence: '&&' binds tighter than '||', '!' tighter than both
  show("or-and", truth(t || f && f));           // 1
  show("not-and", truth(!t && f));              // 0
  show("not-group", truth(!(t && f)));          // 1
  show("not-or", truth(!f || f));               // 1
  show("chain", truth(f || f || t));            // 1
  show("chain-and", truth(t && t && f));        // 0
  show("not-not", truth(!!t));                  // 1

  // '!' applies to the comparison it precedes, as 'not' did: '!a == b' is '!(a == b)'
  show("not-compare", truth(!t == f));          // 1: !(t == f), not (!t) == f
  show("not-equal", truth(1 != 2));             // 1

  // comparisons bind tighter than '&&' and '||'
  let n i64 = 5;
  show("range", truth(n > 3 && n < 9));         // 1
  show("outside", truth(n < 3 || n > 9));       // 0

  // the bitwise operators are different tokens
  let a i64 = 12;
  let b i64 = 10;
  show("bit-or", a | b);                        // 14
  show("bit-and", a & b);                       // 8
  show("bit-xor", a ^ b);                       // 6

  // words as names
  let or = 4;
  let not = 5;
  show("names", or + not);                      // 9
  let g = new Gate(or: 7, not: 8);
  show("fields", g.or + g.not);                 // 15
  show("function", and(or, not));               // 9
}
