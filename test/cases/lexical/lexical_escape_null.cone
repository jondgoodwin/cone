mod lexical_escape_null;

import stdio use *;

// The escape sequence \0 is the null character, U+0000, by
// doc/reference/reftoken.html, "Character Literal". It is one byte of value 0
// in a string literal and the value 0 in a character literal. The manual
// names \0 alone and no octal escapes, so the digits after it are digits:
// "\012" is a 0 byte followed by '1' and '2'.
//
// Each string is printed a byte at a time between bars, a byte that is not
// printable ASCII as its value in angle brackets, so a 0 byte shows as <0>,
// followed by the literal's length.

fn show(label &[]u8, text &[]u8) {
  printStr(label);
  printStr(" = |");
  mut i = 0u64;
  while i < text.len {
    imm c = text[i];
    if c < ' ' {
      printStr("<");
      printUInt(u64[c]);
      printStr(">");
    }
    elif c > '~' {
      printStr("<");
      printUInt(u64[c]);
      printStr(">");
    }
    else {
      printChar(u64[c]);
    }
    i = i + 1;
  }
  printStr("|, len ");
  printUInt(u64[text.len]);
  printStr("\n");
}

fn main() i32 {
  // In string literals: alone, first, inside, last, in a row, before digits
  show("alone", "\0");
  show("first", "\0abc");
  show("inside", "a\0b");
  show("last", "abc\0");
  show("two", "\0\0");
  show("digits", "\012");
  show("hex-after", "\0\x41");

  // In a multi-line string literal
  imm multi = "
    x\0y
    ";
  show("multi-line", multi);

  // In character literals: the value 0, a byte like any other char in u8
  imm c u8 = '\0';
  printStr("char = ");
  printUInt(u64[c]);
  printStr("\n");
  imm cu = '\0'u;
  printStr("char-u = ");
  printUInt(u64[cu]);
  printStr("\n");

  0;
}
