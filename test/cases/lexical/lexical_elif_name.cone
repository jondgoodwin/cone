// 'elif' is not a keyword: it is an ordinary name, wherever a name may stand. A global,
// a local, a parameter, a field and a method are each called 'elif' here, and each one
// is read as the name it is: a sum, a field access, a call. 'else if' is the one way
// to chain a further condition, and it sits beside the names without a clash.
//
// Each printed value was checked by hand against the source.

mod lexical_elif_name;

import stdio use *;

let elif: i32 = 10;                     // a global

struct Step {
  elif: i32;                            // a field

  pub fn again(self) i32 { elif + 1 }
}

struct Task {
  n: i32;

  pub fn elif(self, elif: i32) i32 { n + elif }   // a method and its parameter
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn pick(elif: i32) i32 {
  if elif < 0 {
    -1
  } else if elif == 0 {
    0
  } else {
    elif * 2
  }
}

fn main() {
  var elif = 3;                         // a local, shadowing the global
  elif += 1;
  show("local", i64.from(elif));
  show("global", i64.from(lexical_elif_name.elif));
  let s = Step(elif: 7);
  show("field", i64.from(s.elif));
  show("field method", i64.from(s.again()));
  let t = Task(5);
  show("method", i64.from(t.elif(elif)));
  show("parameter negative", i64.from(pick(-4)));
  show("parameter zero", i64.from(pick(0)));
  show("parameter positive", i64.from(pick(elif)));
}
