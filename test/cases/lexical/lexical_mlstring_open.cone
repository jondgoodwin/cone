mod lexical_mlstring_open;

import stdio use *;

// What lexical_reject_mlstring_open leaves legal. A one-line literal is
// unaffected, escaped quotes and a written \n included; a multi-line literal
// whose opening quote ends its line is unaffected, a backslash join included.
// Each is printed followed by a bar.

fn main() i32 {
  let one = "one line";
  printStr(one); printStr("|\n");

  let esc = "say \"hi\"\nnext";
  printStr(esc); printStr("|\n");

  let multi = "
    first
    second
    ";
  printStr(multi); printStr("|\n");

  let joined = "
    a\
    b
    ";
  printStr(joined); printStr("|\n");

  0;
}
