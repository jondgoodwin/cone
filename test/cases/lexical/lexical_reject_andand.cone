// Cone has no '&&': logical and is 'and'. Written after an operand, '&&' used to read as
// the bitwise '&' of a borrow of the right side, which evaluates that side whatever the
// left side is. It is refused at the operator, with the word to write, and read as
// 'and', so the rest of the expression checks as written and nothing is reported twice.
//
// '&&' before an operand or in a type is two borrows and is not refused (see
// lexical_andand_borrows). '||' is not logical or either, but it has never compiled
// into anything: it is not covered here.
//
// Parse stage only.

mod lexical_reject_andand;

fn yes() bool { true; }

fn conditions(a bool, b bool, n i32) bool {
  if a && b { return true; }               //~ ErrorAndAnd:8 "write 'and'"
  if a && b && yes() { return true; }      //~ ErrorAndAnd:8 "write 'and'"
                                           //~^ ErrorAndAnd:13 "write 'and'"
  if n > 3 && n < 9 { return true; }       //~ ErrorAndAnd:12 "write 'and'"
  if a and b && n == 2 { return true; }    //~ ErrorAndAnd:14 "write 'and'"
  if a &&b { return true; }                //~ ErrorAndAnd:8 "write 'and'"
  while a&&b { break; }                    //~ ErrorAndAnd:10 "write 'and'"
  let both = (a) && (b);                   //~ ErrorAndAnd:18 "write 'and'"
  both;
}
