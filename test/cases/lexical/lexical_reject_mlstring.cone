// A multi-line string literal whose closing quote does not begin its line. By
// doc/reference/reftoken.html, "Multi-line String Literals", the closing quote
// must appear at the start of a line after the opening one, indented by nothing
// but spaces or tabs, since its indentation is what is stripped from every
// content line. Here it follows content instead, so there is no indentation to
// strip. The diagnostic is at the opening quote.

mod lexical_reject_mlstring;

fn main() i32 {
  imm s = "
    abc";
  //~^^ ErrorBadTok:11 "closing quote must begin its line"
  0;
}
