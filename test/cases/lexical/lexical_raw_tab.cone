mod lexical_raw_tab;

import stdio use *;

// A raw tab inside a literal is content, in a one-line string, a multi-line
// string and a character literal alike (Jon's ruling of 24 September 2026).
// A one-line string used to drop it without a word, so "a<tab>b" was "ab".
// Every other raw control character is refused (lexical_reject_raw_control).
//
// Each string is printed a byte at a time between bars, a control character
// as its value in angle brackets, so a tab shows as <9>. The file holds raw
// tabs, so it is kept byte for byte (.gitattributes).

fn show(label &[]u8, text &[]u8) {
  printStr(label);
  printStr(" = |");
  mut i = 0u64;
  while i < text.len {
    imm c = text[i];
    if c < ' ' {
      printStr("<");
      printUInt(u64[c]);
      printStr(">");
    }
    else {
      printChar(u64[c]);
    }
    i = i + 1;
  }
  printStr("|, len ");
  printUInt(u64[text.len]);
  printStr("\n");
}

fn main() i32 {
  // In a one-line string: inside, first, last, two in a row
  show("inside", "a	b");
  show("first", "	a");
  show("last", "a	");
  show("two", "a		b");

  // In a multi-line string, past the margin
  imm multi = "
    a	b
    ";
  show("multi-line", multi);

  // A string that spans lines without being a multi-line one still drops
  // each line's end and the spaces and tabs that begin the next; a tab later
  // in the line is content
  show("spanning", "a
	  b	c");

  // In a character literal: the value 9
  imm c = '	';
  printStr("char = ");
  printUInt(u64[c]);
  printStr("\n");
  0;
}
