// Where one statement ends and the next begins, when no semicolon says so.
//
// A follow-on line that starts with an operator usable as either prefix or
// infix is ambiguous, and indentation relative to the statement's first line
// decides it. That is statement inference, not block structure: every block
// here is delimited by braces, as R6.6 requires. The distinction is the point
// of this scenario, so the two readings are separated only by indentation and
// are told apart by the value each produces.

import stdio::*

fn show(label &[]u8, n i64) {
  printStr(label)
  printStr(" = ")
  printInt(n)
  printStr("\n")
}

fn semicolons() {
  // Several statements on one line, separated by semicolons
  mut a = 1; mut b = 2; a = a + b
  show("semicolon-separated", a)

  // A semicolon at the end of a line is allowed but never needed
  mut c = 4;
  show("trailing-semicolon", c)

  // An empty statement is just a semicolon
  ;
  show("empty-statement", 1)
}

fn continuation() {
  mut a = 10
  mut b = 4

  // The follow-on line is indented past the line the statement started on, so
  // '-' is read as subtraction and the statement spans both lines
  mut joined = a
    - b
  show("indented-continues", joined)

  // The follow-on line is not indented past it, so the statement ends at the
  // end of the first line and '- b' is a separate expression statement
  mut split = a
  - b
  show("unindented-breaks", split)

  // The same distinction for '*', which is also both a prefix and infix
  // operator. Indented: multiplication.
  mut product = a
    * b
  show("indented-multiplies", product)
}

fn parens() {
  mut a = 10
  mut b = 4

  // An open parenthesis suspends the rule entirely: the statement continues
  // across lines no matter how the follow-on lines are indented
  mut sum = (a
+ b
  )
  show("open-paren-continues", sum)

  // Call arguments likewise
  show(
"call-spans-lines",
    a + b)
}

fn main() i32 {
  semicolons()
  continuation()
  parens()
  0i32
}
