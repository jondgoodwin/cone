// The 'd' suffix is retired: an unsuffixed float literal is an f64 where nothing
// gives it another type, so it has no use. A number is no longer followed by 'd'
// as part of its token; the 'd' is a name of its own after a finished number, and
// the parser refuses it as it refuses any name where an operator or the end of
// the statement belongs. There is no message of its own for it.
//
// This is a parse-stage file, so nothing later than the parser runs. The suffixes
// that remain, 'f', 'f32' and 'f64', are in lexical_literals.

mod lexical_reject_d_suffix;

fn main() {
  let a = 1.5d;                      //~ ErrorNoSemi
  let b = 2d;                        //~ ErrorNoSemi
  let c = 1e3d;                      //~ ErrorNoSemi
  let e = 1.5;
  let f = 1.5f64;
}
