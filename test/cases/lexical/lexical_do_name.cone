// 'do' is not a keyword: it is an ordinary name, wherever a name may stand. A global,
// a local, a parameter, a field and a method are each called 'do' here, and each one
// is read as the name it is: a call, a field access, a sum.
//
// Each printed value was checked by hand against the source.

mod lexical_do_name;

import stdio use *;

let do: i32 = 10;                       // a global

struct Step {
  do: i32;                              // a field

  pub fn again(self) i32 { do + 1 }
}

struct Task {
  n: i32;

  pub fn do(self, do: i32) i32 { n + do }   // a method and its parameter
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn main() {
  var do = 3;                           // a local, shadowing the global
  do += 1;
  show("local", i64.from(do));
  show("global", i64.from(lexical_do_name.do));
  let s = Step(do: 7);
  show("field", i64.from(s.do));
  show("field method", i64.from(s.again()));
  let t = Task(5);
  show("method", i64.from(t.do(do)));
}
