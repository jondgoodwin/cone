// Multi-line string literals written with CRLF line ends: the companion of
// lexical_mlstring, whose line ends are LF. By doc/reference/reftoken.html,
// "Multi-line String Literals", a line end is one new-line character in the
// content however the file spells it, so each literal here prints what the
// same literal there does. A carriage return left in the content would print
// as \r.
//
// .gitattributes marks this file -text, so git keeps its CRLF line ends in
// every checkout: test/** is otherwise checked out LF.

mod lexical_mlstring_crlf;

import stdio use *;

fn show(label &[]u8, text &[]u8) {
  printStr(label);
  printStr(" = |");
  mut i = 0u64;
  while i < text.len {
    imm c = text[i];
    if c == '\n' {
      printStr("\\n");
    }
    elif c == '\t' {
      printStr("\\t");
    }
    elif c == '\r' {
      printStr("\\r");
    }
    else {
      printChar(u64[c]);
    }
    i = i + 1;
  }
  printStr("|, len ");
  printUInt(u64[text.len]);
  printStr("\n");
}

fn main() i32 {
  // Each content line ends in a new-line, the last one's included
  imm lines = "
   x
   y
   ";
  show("lines", lines);

  // The manual's example, equivalent to "a\nb"
  imm manual = "
   a
   b\
   ";
  show("manual-example", manual);

  // A backslash before a CRLF joins the lines, carriage return and all
  imm joined = "
    one \
    two
    ";
  show("backslash-joins", joined);

	// Tabs: two stripped, the rest content
	imm tabbed = "
		one
			two	three
		";
	show("tabs", tabbed);

  // No content lines at all: the empty string
  imm empty = "
    ";
  show("empty", empty);

  0;
}
