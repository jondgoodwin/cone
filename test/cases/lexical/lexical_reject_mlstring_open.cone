mod lexical_reject_mlstring_open;

// Text after a string literal's opening quote that runs on to another line.
// By doc/manual/syntax-lexical.html#multiline, "Multi-line String Literals", a
// multi-line literal must end its line right after the opening quote, so a
// literal whose opening line holds text is neither that nor a one-line literal.
// Each is refused at its opening quote, on the opening line, and the message
// says the text must start on the next line. lexical_mlstring holds the legal
// multi-line forms, lexical_mlstring_open the one-line literals beside them.

// Text on the opening line, the rest on the next
imm two = "one
two";
//~^^ ErrorBadTok:11 "must start on the next line"

// Text on the opening line of a longer literal, an escape in it stepped over
imm three = "a\"b
c
d";
//~^^^ ErrorBadTok:13 "must start on the next line"

// A margin does not make it legal: the opening line still holds text
imm indented = "x
    y
    ";
//~^^^ ErrorBadTok:16 "must start on the next line"

// A raw tab is content, but the literal that spans lines is still refused: it
// held text after the opening quote (lexical_raw_tab once ran this as a case)
imm tabbed = "a
	  b	c";
//~^^ ErrorBadTok:14 "must start on the next line"
