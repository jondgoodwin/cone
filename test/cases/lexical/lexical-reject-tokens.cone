// Characters the lexer cannot turn into a token.
//
// Every diagnostic here is raised by the lexer, so all of them belong to the
// same stage and accumulate in one file. Each sits in its own declaration so
// that recovery from one cannot swallow the next.

fn badCharacter(a i32) i32 {
  a $ a                //~ ErrorBadTok:5 "Bad character '$' starting unknown token"
                       //~^ ErrorNoSemi:7 follow-on
  a
}

fn badEscape() u32 {
  '\q'                 //~ ErrorBadTok:3 "Invalid escape sequence 'q'"
}

// The bad digit leaves the literal unterminated, so the lexer reports the
// escape and then the literal it could not finish, at the same position.
fn badHexEscape() u32 {
  '\xZZ'               //~ ErrorBadTok:3 "Invalid hexadecimal character 'Z'"
                       //~^ ErrorBadTok:3 "Invalid lifetime or too-long character literal" follow-on
}

fn tooLongCharLit() u32 {
  'ab'                 //~ ErrorBadTok:3 "Invalid lifetime or too-long character literal"
}

fn unclosedTick() i32 {
  mut `oops = 1        //~ ErrorBadTok:7 "Back-ticked identifier requires closing backtick"
  1
}

// The same two diagnostics against a character that is more than one byte.
// The message printed a single byte with a '%c', so a multi-byte character came
// out as a lone lead byte and the diagnostic itself was not valid UTF-8.
fn badHexEscapeUnicode() u32 {
  '\xé'                //~ ErrorBadTok:3 "Invalid hexadecimal character 'é'"
                       //~^ ErrorBadTok:3 "Invalid lifetime or too-long character literal" follow-on
}

// The column a diagnostic reports, and the caret under the echoed source line,
// counted bytes rather than characters -- so both drifted one place right for
// every extra UTF-8 byte earlier on the line. The columns below are the whole
// assertion here, and they are written by hand: bless records whatever the
// compiler produced, which is the thing in doubt.
fn badCharAfterUnicode(café i32) i32 {
  café $ café        //~ ErrorBadTok:8 "Bad character '$' starting unknown token"
                       //~^ ErrorNoSemi:10 follow-on
  1
}
