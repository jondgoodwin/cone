// A suffix after a hex float's exponent is read as a suffix and applied (design chat's
// ruling of 1 Nov 2026, delegated by Jon; reported 23 Sep 2026). A hex float's exponent
// is written in decimal digits, so the 'f' of '0x1.8p1f' ends the exponent and begins the
// suffix: it was read as a hex digit of the exponent and the suffix was silently lost.
// The 'p' exponent itself belongs to hexadecimal literals only: lexical_reject_decimal_p
// refuses it in a decimal one.
//
// A literal's type is shown by its value: 0x1.0000001p0 is 1 + 2^-28, which an f64 holds
// and an f32 rounds to 1, so the suffixed literals print 1.0 and the unsuffixed one does
// not. Each printed value was worked out by hand.

mod lexical_hex_float_suffix;

import stdio use *;

fn showFloat(label: &str, n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn main() {
  // 0x1.8 is 1.5, and p1 doubles it
  showFloat("hex-f", 0x1.8p1f);
  showFloat("hex-f32", 0x1.8p1f32);
  showFloat("hex-f64", 0x1.8p1f64);
  // 0x1p-2 is a quarter; a signed exponent takes the suffix as well
  showFloat("hex-signed-f", 0x1p-2f);
  showFloat("hex-plus-f32", 0x1p+3f32);
  // The suffix is the f32 type: 1 + 2^-28 rounds to 1 there, and f64 keeps it
  showFloat("rounded-by-f", 0x1.0000001p0f);
  // (scaled by 2^28 to a value that prints plainly: 2^28 + 1 - 2^28 is 1)
  showFloat("kept-by-f64", 0x1.0000001p0f64 * 268435456.0 - 268435456.0);
  // Hex digits before the exponent are still digits, 'f' among them
  showFloat("digit-f", 0xf.8p0);
}
