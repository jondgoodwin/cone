// 'local' and 'wait' were reserved words and are released (Jon, 28 Oct 2026: "you can
// release both. If we need something, we'll bring them back"). Each is an ordinary name,
// wherever a name may stand: a global, a local, a parameter, a field and a method are each
// called 'local' or 'wait' here, and each is read as the name it is. 'wait' is a common
// method name, and 'await' covers asynchronous waiting.
//
// Each printed value was checked by hand against the source.

mod lexical_released_words;

import stdio use *;

let local: i32 = 10;                    // a global

struct Gate {
  wait: i32;                            // a field

  pub fn local(self, wait: i32) i32 { wait + 1 }   // a method and a parameter
}

struct Latch {
  n: i32;

  pub fn wait(self) i32 { n * 2 }       // a method
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn main() {
  var wait = 3;                         // a local, named 'wait'
  wait += 1;
  show("local-wait", i64.from(wait));
  show("global-local", i64.from(lexical_released_words.local));
  let g = Gate(7);
  show("field-wait", i64.from(g.wait));
  show("method-local", i64.from(g.local(wait)));
  let l = Latch(5);
  show("method-wait", i64.from(l.wait()));
}
