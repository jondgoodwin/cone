mod lexical_mlstring_margin;

import stdio use *;

// A multi-line string literal's margin, by doc/manual/syntax-lexical.html#multiline,
// "Multi-line String Literals" (the Swift and C# rule, Jon's ruling of 24
// September 2026): the closing quote's whitespace is the margin; a content
// line of nothing but spaces and tabs is an empty line, whatever it holds;
// every other content line begins with exactly the margin, the same
// characters in the same order, and loses it. lexical_mlstring holds the rest
// of the rules, and lexical_reject_mlstring_margin the lines refused.
//
// Every literal is printed a byte at a time between bars, a new-line, tab or
// carriage return spelled as its escape. The file's whitespace-only lines,
// its tabs and its one CRLF-ended literal are its subject, so it is kept byte
// for byte (.gitattributes).

fn show(label: &str, text: &Array[u8]) {
  printStr(label);
  printStr(" = |");
  var i = 0u64;
  while i < text.len {
    let c = text[i];
    if c == '\n' {
      printStr("\\n");
    }
    elif c == '\t' {
      printStr("\\t");
    }
    elif c == '\r' {
      printStr("\\r");
    }
    else {
      printChar(u64.from(c));
    }
    i = i + 1;
  }
  printStr("|, len ");
  printUInt(u64.from(text.len));
  printStr("\n");
}

fn main() i32 {
  // A blank line inside an indented literal is an empty line
  let blank = "
    a

    b
    ";
  show("blank-line", blank);

  // So is a line of fewer spaces than the margin, and one of more
  let spaces = "
    a
  
    b
        
    c
    ";
  show("whitespace-only", spaces);

  // And a line of tabs alone, though the margin is spaces
  let tabsonly = "
    a
		
    b
    ";
  show("tabs-only-line", tabsonly);

  // A margin of tabs: each line begins with the two tabs, and what follows
  // them, spaces included, is content
  let tabs = "
		one
		  two
		";
  show("tab-margin", tabs);

  // A margin of a tab and two spaces: each line begins with those three, in
  // that order, and a tab after them is content
  let mixed = "
	  x
	  	y
	  ";
  show("mixed-margin", mixed);

  // A backslash joins a line to a blank one, which is still an empty line
  let joined = "
    a\

    b
    ";
  show("join-to-blank", joined);

  // A blank last line, right before the closing quote
  let trailing = "
    a

    ";
  show("blank-last-line", trailing);

  // A whitespace-only line ended by a CRLF is an empty line as well
  let crlf = "
    a
  
    b
    ";
  show("crlf-blank-line", crlf);

  0
}
