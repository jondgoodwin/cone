// 'elif' is retired: 'else if' is the one way to chain a further condition, and 'elif'
// is an ordinary name (lexical_elif_name). Written after an 'if' block it is a name
// that starts a statement, and the parser refuses the statement as it refuses any
// name where an operator or the end of the statement belongs; the 'else' that follows
// then stands with no 'if' before it. There is no message of its own for it.
//
// Parse stage only. The accepted spelling is in lexical_elif_name and in core_success.

mod lexical_reject_elif;

fn pick(n: i32) i32 {
  if n < 0 { return -1; }
  elif n == 0 { return 0; }          //~ ErrorNoSemi
                                     //~^ ErrorNoSemi follow-on
  else { return 1; }                 //~ ErrorBadTerm
                                     //~^ ErrorNoSemi follow-on
}

fn pickelse(n: i32) i32 {
  if n < 0 { return -1; }
  else if n == 0 { return 0; }
  else { return 1; }
}
