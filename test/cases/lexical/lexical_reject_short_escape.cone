mod lexical_reject_short_escape;

// A \x, \u or \U escape with fewer hexadecimal digits than it takes, ended by
// the literal's closing quote, a space, a tab or the line's end. The message
// named the character that ended it as an invalid hexadecimal character, so a
// quote came out as ''' or '"', and a tab or a line end was printed raw between
// the quotes, breaking the message across lines. It now says the escape is too
// short and how many digits it takes, naming the escape so far. A character
// that could have been meant as a digit is still named, as '\xZZ' and '\xé' in
// lexical_reject_tokens show. The source's end is the same case, in
// lexical_reject_short_escape_end.
//
// Each is reported at the literal's opening quote, where the lexer reports
// every literal it cannot read. Each is a global so that a literal the lexer
// could not finish leaves nothing else to report but the missing ';'.

// Ended by the closing quote, in a character literal and in a string
imm q1 = '\x4';                 //~ ErrorBadTok:10 "Escape sequence '\\x4' is too short: '\\x' takes 2 hexadecimal digits"
imm q2 = '\u12';                //~ ErrorBadTok:10 "Escape sequence '\\u12' is too short: '\\u' takes 4 hexadecimal digits"
imm q3 = "\x";                  //~ ErrorBadTok:10 "Escape sequence '\\x' is too short: '\\x' takes 2 hexadecimal digits"
imm q4 = "\U1234";              //~ ErrorBadTok:10 "Escape sequence '\\U1234' is too short: '\\U' takes 8 hexadecimal digits"

// Ended by a space or a tab. The character literal then holds more than one
// character, which is the follow-on
imm w1 = '\x4 ';                //~ ErrorBadTok:10 "Escape sequence '\\x4' is too short: '\\x' takes 2 hexadecimal digits"
                                //~^ ErrorBadTok:10 "Invalid lifetime or too-long character literal" follow-on
imm w2 = '\u1	';                //~ ErrorBadTok:10 "Escape sequence '\\u1' is too short: '\\u' takes 4 hexadecimal digits"
                                //~^ ErrorBadTok:10 "Invalid lifetime or too-long character literal" follow-on

// Ended by the line's end. A character literal stops there, unfinished; a
// string runs on to its closing quote on the next line
imm n1 = '\x4
//~^ ErrorBadTok:10 "Escape sequence '\\x4' is too short: '\\x' takes 2 hexadecimal digits"
//~^^ ErrorBadTok:10 "Invalid lifetime or too-long character literal" follow-on
//~^^^ ErrorNoSemi:14 follow-on
imm n2 = "\u12
";
//~^^ ErrorBadTok:10 "Escape sequence '\\u12' is too short: '\\u' takes 4 hexadecimal digits"
