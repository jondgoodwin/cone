mod lexical_char_utf8;

// A character literal written as the character itself is its code point,
// whatever its length in UTF-8: one byte, or the two, three or four a lead byte
// declares. The source is UTF-8 and the literal is read as such, so the char
// is the number the Unicode table gives it, not a byte of its encoding.
// U+00E9 is 233, U+20AC 8364, U+1F600 128512 and U+10FFFF 1114111; U+0080 and
// U+07FF are the first and last of two bytes, U+0800 and U+FFFF of three,
// U+10000 and U+10FFFF of four. The same code points written as escapes are in
// lexical_literals.

import stdio use *;

fn show(label &Array[u8], c char) {
  printStr(label);
  printStr(" = ");
  printUInt(u64.from(c));
  printStr("\n");
}

fn flag(yes bool) char {
  if yes { 'y'; } else { 'n'; }
}

fn main() {
  show("ascii", 'A');
  show("e-acute", 'é');
  show("euro", '€');
  show("emoji", '😀');
  show("first of two bytes", '');
  show("last of two bytes", '߿');
  show("first of three bytes", 'ࠀ');
  show("last of three bytes", '￿');
  show("first of four bytes", '𐀀');
  show("last", '􏿿');
  // Beside a byte it is still a char: compared with another, and no byte
  imm c char = 'é';
  show("compared", flag(c == 'é'));
  show("compared with another", flag(c == 'è'));
}
