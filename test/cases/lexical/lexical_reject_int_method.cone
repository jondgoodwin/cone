// A '.' after integer digits and before a name starts a method call, as it does
// after a variable. The integers have no methods by these names, so each line is
// refused by the type checker, at the name: proof that the lexer ended the number
// at the dot instead of reading a float ('4.' then a stray 'mx'). (The integers'
// real 'max' and 'abs' are called on literals in intrinsic_numbers.)
//
// What stays a float is in lexical_float_method: '3.' alone, '3. + 1.', the
// suffixes ('0.f', '0.f32') and the range '1..4'. A name that begins with the
// letter of a float suffix ('3.foo', '2.double()') is still a name: it was once
// read as a float suffix and the rest left as a stray identifier.

mod lexical_reject_int_method;

fn main() {
  let a = 4.mx(5);         //~ ErrorNoMbr:12 "Method or field `mx` not found"
  let b = 4.sqrt();        //~ ErrorNoMbr:12 "Method or field `sqrt` not found"
  let c = 3.e5;            //~ ErrorNoMbr:12 "Method or field `e5` not found"
  let d = 1_000.ab;        //~ ErrorNoMbr:16 "Method or field `ab` not found"
  let e = 0x1f.foo;        //~ ErrorNoMbr:15 "Method or field `foo` not found"
  let f = 0x1f.ab();       //~ ErrorNoMbr:15 "Method or field `ab` not found"
  let g = 3.foo;           //~ ErrorNoMbr:12 "Method or field `foo` not found"
  let h = 2.double();      //~ ErrorNoMbr:12 "Method or field `double` not found"
}
