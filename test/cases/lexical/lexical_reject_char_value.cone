mod lexical_reject_char_value;

// A character literal is a char, a Unicode scalar value: a code point that is no
// surrogate and not past U+10FFFF. A \u or \U escape can name one that is not,
// and is refused at the literal, which still has a value (U+FFFD) so that
// nothing more is said of it. The last three literals are the edges of the
// range, and are accepted.
//
// The literal once took a trailing 'u' to be a u32 ('a'u). It is a char now,
// which converts explicitly, 'u32.from(c)', and the suffix is refused in those
// words.

imm lowSurrogate = '\uD800';        //~ ErrorBadTok:20 "U+D800 is no Unicode scalar value, so no char"
imm highSurrogate = '\uDFFF';       //~ ErrorBadTok:21 "U+DFFF is no Unicode scalar value"
imm pastTheEnd = '\U00110000';      //~ ErrorBadTok:18 "U+110000 is no Unicode scalar value"
imm wayPast = '\UFFFFFFFF';         //~ ErrorBadTok:15 "U+FFFFFFFF is no Unicode scalar value"
imm suffixed = 'a'u;                //~ ErrorBadTok:16 "A character literal has no 'u' suffix: it is a char"

imm belowSurrogates = '퟿';
imm aboveSurrogates = '';
imm last = '\U0010FFFF';
