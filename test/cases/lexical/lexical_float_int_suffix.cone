// A number written with a fraction or an exponent is a float, and no integer suffix can type it:
// '10.0i64' reached code generation, which built a float constant of an integer type and crashed.
// The float suffixes, a whole number and a method call on one stay as they were. (Bug 117.)

mod lexical_float_int_suffix;

fn main() {
  let a = 10.0i64;      //~ ErrorBadTok "cannot take an integer suffix"
  let b = 1.5u8;        //~ ErrorBadTok "cannot take an integer suffix"
  let c = 1.0e3i16;     //~ ErrorBadTok "cannot take an integer suffix"
  let d = 2e3usize;     //~ ErrorBadTok "cannot take an integer suffix"
  let ok1 = 1.5f32;
  let ok2 = 1e3;
  let ok3 = 10i64;
  let ok4 = 4u8.max(3u8);
}
