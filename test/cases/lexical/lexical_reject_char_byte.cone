mod lexical_reject_char_byte;

// A character literal holding a byte that begins no UTF-8 character: a lone
// continuation byte (0x80), a byte no character may start with (0xFF), and a
// lead byte whose sequence is cut short (0xE2 0x82). Each is refused at the
// literal, which keeps U+FFFD as its value, and the literal is closed as
// it would be were it well formed, so nothing more is said of it.

imm a = '€';           //~ ErrorBadTok:9 "holds the byte 0x80, which begins no UTF-8 character"
imm b = 'ÿ';           //~ ErrorBadTok:9 "holds the byte 0xFF"
imm c = 'â‚';       //~ ErrorBadTok:9 "holds the byte 0xE2"
imm good = 'Ã©';
