// Literal tokens: what the lexer builds from digits, quotes and suffixes.
//
// Every fact is printed, because a literal's whole content is its value and its
// type, and neither is observable from a clean compile. The show helpers are
// scaffolding: one per printable width, calling stdio's concrete print
// functions rather than the '<-' overload set, which core owns.

mod lexical_literals;

import stdio use *;

fn showInt(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showUInt(label &Array[u8], n u64) {
  printStr(label);
  printStr(" = ");
  printUInt(n);
  printStr("\n");
}

fn showFloat(label &Array[u8], n f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn showText(label &Array[u8], text &Array[u8]) {
  printStr(label);
  printStr(" = ");
  printStr(text);
  printStr("\n");
}

fn integers() {
  // Decimal, and the default type when no suffix is given
  showInt("int-dec", 42);
  // Hexadecimal, in both letter cases, with both digit cases
  showInt("int-hex-lower-x", 0x2a);
  showInt("int-hex-upper-X", 0X2A);
  showInt("int-hex-mixed", 0xaB);
  // 'e' and 'E' are hex digits, not a decimal exponent, wherever they fall
  showInt("int-hex-E-last", 0x1E);
  showInt("int-hex-E-first", 0xE0);
  showInt("int-hex-e-only", 0xe);
  showInt("int-hex-all-letters", 0xABCDEF);
  // Underscores are separators and contribute nothing to the value
  showInt("int-underscores", 1_000_000);
  showInt("int-underscores-hex", 0xFF_FF);
  // A leading '-' is not part of the token, but still negates what follows
  showInt("int-negative", -42);
  showInt("int-negative-hex", -0x2a);
  // Every signed suffix
  showInt("int-i8", 127i8);
  showInt("int-i8-min", -128i8);
  showInt("int-i16", 32767i16);
  showInt("int-i16-min", -32768i16);
  showInt("int-i32", 42i32);
  showInt("int-i32-max", 2147483647i32);
  showInt("int-i32-min", -2147483648i32);
  showInt("int-i64", 4294967296i64);
  showInt("int-i64-max", 9223372036854775807i64);
  showInt("int-i64-min", -9223372036854775808i64);
  showInt("int-isize", 42isize);
  // A minus applied twice is a positive value again, which must fit as one
  showInt("int-double-negative", - -127i8);
  // Every unsigned suffix, including the bare 'u' spelling of u32
  showUInt("int-u8", 255u8);
  showUInt("int-u16", 65535u16);
  showUInt("int-u32", 42u32);
  showUInt("int-u32-max", 4294967295u32);
  showUInt("int-u-bare", 42u);
  showUInt("int-u64", 4294967296u64);
  // A minus on an unsigned literal does not make it signed: the negation is
  // taken in the literal's own width
  showUInt("int-u8-negated", -1u8);
  // The widest value a literal can carry, in both bases
  showUInt("int-u64-max", 18446744073709551615u64);
  showUInt("int-u64-max-hex", 0xFFFFFFFFFFFFFFFFu64);
  showUInt("int-usize", 42usize);
}

fn floats() {
  // A decimal point is what makes this a float rather than an integer
  showFloat("float-point", 2.5);
  // A trailing decimal point is still a decimal point
  showFloat("float-trailing-point", 3.);
  // An exponent makes a float even with no decimal point
  showFloat("float-exponent", 25e2);
  showFloat("float-exponent-upper", 25E2);
  showFloat("float-exponent-signed", 25e-2);
  showFloat("float-exponent-plus", 25e+2);
  // A hex float's exponent is 'p' or 'P', a power of two; 'e' stays a digit
  showFloat("float-hex-p", 0x1.8p1);
  showFloat("float-hex-P-signed", 0xAP-1);
  showFloat("float-hex-e-digit", 0x1.Ep2);
  // A suffix makes a float even with neither point nor exponent
  showFloat("float-f", 7f);
  showFloat("float-f32", 7f32);
  showFloat("float-d", 7d);
  showFloat("float-f64", 7f64);
  // Underscores are separators here too
  showFloat("float-underscores", 1_0.5);
  showFloat("float-negative", -2.5);
  // A hex float's exponent is 'p', and it counts powers of two: 0x1.8 is 1.5,
  // so 0x1.8p1 is 3, 0x1p-2 is a quarter and 0xAp+1 is ten doubled
  showFloat("float-hex-exponent", 0x1.8p1);
  showFloat("float-hex-exponent-signed", 0x1p-2);
  showFloat("float-hex-exponent-plus", 0xAp+1);
}

// A char is a Unicode code point and no number, so it is shown by its value
fn showChar(label &Array[u8], c char) {
  showUInt(label, u64.from(c));
}

fn showByte(label &Array[u8], b u8) {
  showUInt(label, u64.from(b));
}

fn chars() {
  // A character literal is a char: a code point, held in 32 bits
  showChar("char-plain", 'A');
  showChar("char-digit", '0');
  showChar("char-space", ' ');
  // Every escape sequence the lexer recognizes
  showChar("char-alarm", '\a');
  showChar("char-backspace", '\b');
  showChar("char-formfeed", '\f');
  showChar("char-newline", '\n');
  showChar("char-return", '\r');
  showChar("char-tab", '\t');
  showChar("char-vtab", '\v');
  showChar("char-single-quote", '\'');
  showChar("char-double-quote", '\"');
  showChar("char-backslash", '\\');
  showChar("char-escaped-space", '\ ');
  // Numeric escapes, in all three widths. \x is the code point of that value,
  // so '\xFF' is U+00FF and not a byte
  showChar("char-hex-escape", '\x41');
  showChar("char-hex-escape-high", '\xFF');
  showChar("char-u-escape", '\u00E9');
  showChar("char-U-escape", '\U0001F600');
  // The escapes at the lengths of UTF-8 (a character written as itself is in
  // lexical_char_utf8)
  showChar("char-u-escape-three-bytes", '\u20AC');
  showChar("char-U-escape-limit", '\U0010FFFF');

  // An ASCII character literal is a byte where a u8 is wanted
  imm byte u8 = 'a';
  showByte("char-as-byte", byte);
  showByte("char-as-byte-argument", 'z');
  showByte("char-as-byte-sum", '0' + 5u8);
  showByte("char-as-byte-difference", byte - 'a');
  showByte("char-as-byte-high-ascii", '\x7F');
  imm bytes Array[u8, 3] = ['x', 'y', '\n'];
  showByte("char-as-byte-array-0", bytes[0]);
  showByte("char-as-byte-array-2", bytes[2]);
  if byte == 'a' { showUInt("char-byte-equal-right", 1); }
  if 'a' == byte { showUInt("char-byte-equal-left", 1); }
  if byte >= 'a' and byte <= 'z' { showUInt("char-byte-in-range", 1); }
  // A char is compared with a char
  imm c char = '\u00E9';
  if c == '\u00E9' { showUInt("char-equal", 1); }
  if c != 'e' { showUInt("char-not-equal", 1); }
  if c > 'z' and 'a' < c { showUInt("char-ordered", 1); }
  // And converted explicitly, either way: to a byte it keeps the low 8 bits
  // (U+20AC is 0xAC), and a number is a char only by asking
  showByte("char-to-byte", u8.from('\u20AC'));
  showChar("char-from-byte", char.from(byte));
  showChar("char-from-number", char.from(233u32));
  showUInt("char-to-u32", u64.from(u32.from(c)));
  showUInt("char-reinterpreted", u64.from(c as u32));
}

fn strings() {
  showText("str-plain", "abcdef");
  // Escape sequences inside a string literal
  showText("str-tabbed", "a\tb");
  showText("str-quoted", "a\"b");
  showText("str-backslash", "a\\b");
  showText("str-hex-escape", "\x41\x42");
  // A unicode escape is re-encoded as UTF-8 in the literal's bytes
  showText("str-u-escape", "\u00e9");
  // A UTF-8 source character passes through unchanged
  showText("str-utf8-source", "π is pi");

  // A string literal's length is its bytes after escapes, and excludes the
  // NUL placed after them: "hello" is an Array[u8, 5], which a copy keeps
  imm hello Array[u8, 5] = "hello";
  imm copied = &[]hello;
  showUInt("str-len-typed-copy", copied.len);
  imm sliced &Array[u8] = "hello";
  showUInt("str-len-slice", sliced.len);
  showUInt("str-len-escaped", (&[]"a\tb").len);
  showUInt("str-len-utf8", (&[]"é").len);
  // The NUL is there for C: a pointer to a literal's bytes, handed to a
  // function that reads up to the terminator, gets the text and stops
  imm cptr *u8 = &[]"c-string" as *u8;
  printStr("str-c-terminated = ");
  printCStr(cptr);
  printStr("|\n");
  globals();
}

// A module-level byte array initialized from a string literal is not a copy:
// its storage is the initialized data, so like the literal it ends in a NUL
// its type does not count. A global array from anything else has no NUL.
imm cglobal Array[u8, 8] = "c-global";
mut cmutable Array[u8, 5] = "c-mut";
imm ctyped Array[u8, 7] = "c-typed";
imm cbytes Array[u8, 3] = [1u8, 2u8, 3u8];

// A slice of a string literal is a constant too, the text's address and its
// length, so it is a literal initializer wherever one is required: a global,
// alone or as a struct's field, by position or by name, a field default, a
// parameter default, a constant and a static
const CSLICE &Array[u8] = "c-const";
imm cslice &Array[u8] = "c-slice";
imm cwritten = &[]"c-written";
mut cslicemut &Array[u8] = "c-before";
struct Named {
  pub id i32;
  pub name &Array[u8] = "c-default";
}
imm cbypos = new Named(1, "c-by-pos");
imm cbyname = new Named(id: 2, name: "c-by-name");
imm cbydefault = new Named(3);

fn sliceDefault(text &Array[u8] = "c-param") &Array[u8] {
  static kept &Array[u8] = "c-static";
  showText("str-static", kept);
  text;
}

fn globals() {
  showText("str-global-slice", cslice);
  showUInt("str-global-slice-len", cslice.len);
  showText("str-global-written", cwritten);
  showText("str-global-slice-mut", cslicemut);
  cslicemut = "c-after";
  showText("str-global-slice-mut", cslicemut);
  showInt("str-global-struct-pos-id", cbypos.id);
  showText("str-global-struct-pos", cbypos.name);
  showInt("str-global-struct-named-id", cbyname.id);
  showText("str-global-struct-named", cbyname.name);
  showText("str-global-struct-default", cbydefault.name);
  showText("str-param-default", sliceDefault());
  showText("str-const", CSLICE);

  showUInt("str-global-len", (&[]cglobal).len);
  imm gptr *u8 = &[]cglobal as *u8;
  printStr("str-global-c-terminated = ");
  printCStr(gptr);
  printStr("|\n");
  showUInt("str-global-typed-len", (&[]ctyped).len);
  printStr("str-global-typed-c-terminated = ");
  printCStr(&[]ctyped as *u8);
  printStr("|\n");
  showUInt("str-global-bytes-len", (&[]cbytes).len);
  // Every Cone store to a mutable one stops at the text: the NUL survives
  // a whole assignment and a write to the last byte
  cmutable = "C-MUT";
  cmutable[4] = '!';
  showUInt("str-global-mut-len", (&[]cmutable).len);
  printStr("str-global-mut-c-terminated = ");
  printCStr(&[]cmutable as *u8);
  printStr("|\n");
  // A local copy of one takes its type, and so has no NUL
  imm copied = cglobal;
  showUInt("str-global-copy-len", (&[]copied).len);
}

fn bools() {
  // 'true' and 'false' are keyword terms, not identifiers
  mut t = true;
  mut f = false;
  if t {
    showInt("bool-true-taken", 1);
  }
  if f {
    showInt("bool-false-taken", 1);
  } else {
    showInt("bool-false-else", 0);
  }
}

fn main() i32 {
  integers();
  floats();
  chars();
  strings();
  bools();
  0i32;
}
