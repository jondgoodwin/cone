mod lexical_reject_unclosed_raw;

// A raw triple-quoted literal whose closing quotes never come: it runs to the end of the
// file and is refused at its opening, as lexical_reject_unclosed_string's plain literal is
// (see there for why it is one per file and last). Two quotes before the end are not three.
//
// Nothing after the opening quotes may hold three double quotes, or they would close the
// literal: that is why the annotations carry no quoted message.

let greeting = r"""never closed "" ;  //~ ErrorBadTok:16
//~ ErrorNoSemi follow-on
