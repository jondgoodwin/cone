// A float literal takes one decimal point, and none after its exponent: a
// further '.' is the dot of a method call on the literal, as it is on a
// variable. Before, '25.0.sqrt()' took the second '.' into the number and the
// parser stopped at 'sqrt'.
//
// The lines after the method calls pin what the lexer must go on doing: a
// trailing point is still a point, a range operator after an integer is not,
// and a number after a dot is a tuple field and never a float.

mod lexical_float_method;

import stdio use *;

fn showFloat(label: &str, n: f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn showInt(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn methods() {
  // The decimal point is taken, and the next dot starts the method call
  showFloat("point-call", 25.0.sqrt());
  showFloat("point-bare", 25.0.sqrt);
  showFloat("point-sin", 0.0.sin());
  showFloat("point-cos", 0.0.cos());
  showFloat("point-chained", 16.0.sqrt().sqrt());
  showFloat("point-underscore", 2_5.0.sqrt());
  // After a suffix, which already ended the number
  showFloat("suffix-f64", 25.0f64.sqrt());
  showFloat("suffix-f", 25.0f.sqrt());
  showFloat("suffix-f32", 25.0f32.sqrt());
  showFloat("suffix-bare", 25f.sqrt());
  // After an exponent, which allows no decimal point
  showFloat("exponent", 1e2.sqrt());
  showFloat("exponent-signed", 2.5e-1.sqrt());
  showFloat("exponent-point", 2.25e0.sqrt());
  // After a hex float's binary exponent
  showFloat("hex", 0x1.0p4.sqrt());
  showFloat("hex-no-point", 0x1p4.sqrt());
}

struct Pair { pub a: i64; pub b: i64; }

fn unchanged() {
  // A trailing point, with no name after it, is still a decimal point
  // (lexical_reject_int_method has the integer methods)
  showFloat("trailing-point", 3.);
  showFloat("trailing-point-sum", 3. + 1.);
  showFloat("point-fraction", 2.5);
  // A point and a float suffix is a float, not a call of a method named f or f32
  showFloat("point-no-suffix", 1.0);
  showFloat("point-suffix-f", 2.f);
  showFloat("point-suffix-f32", 3.f32);
  showFloat("point-suffix-f64", 4.f64);
  showFloat("point-suffix-sqrt", 9.0.sqrt());
  // A hex float's digits after the point, with its exponent, stay a float
  showFloat("hex-point-letter", 0x1.Ep2);
  showFloat("exponent-literal", 25e2);
  showFloat("hex-literal", 0x1.8p1);
  showFloat("paren-call", (25.0).sqrt());
  // A range operator after an integer is not a decimal point
  var total: i64 = 0;
  each i in 1..=4 {
    total = total + i;
  }
  showInt("range-sum", total);
  // A number after a dot names a tuple field, so 't.1.0' is field 0 of field 1
  let nested = (1, (7, 2));
  showInt("tuple-field", nested.1.0);
  let p = Pair(3, 4);
  showInt("struct-field", p.b);
}

fn main() i32 {
  methods();
  unchanged();
  0i32
}
