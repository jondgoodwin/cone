// A raw or triple-quoted literal inside the braces of an interpolated string is stepped
// over whole, so a brace, a quote or a backslash in it closes nothing: the lexer's brace
// skipper reads it as the lexer reads the literal itself (lexical_raw_strings).
// Each printed value was checked by hand against the source.

mod lexical_raw_interp;
import stdio use *;
import collections use *;

fn main() {
  print <- "raw-brace = |", $"{r"}"}", "|\n";             // the raw literal r"}" is }
  print <- "triple-brace = |", $"{"""}"""}", "|\n";      // the triple-quoted """}""" is }
  print <- "raw-backslash = |", $"[{r"\"}]", "|\n";      // a backslash is text: [ \ ]
  print <- "raw-tick-quote = |", $"a{r`"`}b", "|\n";     // a, the quote, b
  print <- "raw-triple-quotes = |", $"{r"""a"}"b"""}!", "|\n";  // a"}"b then !
  print <- "after = |", $"{r"}"}{r"{"}", "|\n";          // } then {
}
