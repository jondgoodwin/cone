mod lexical_reject_char_line_end;

// A raw line end right after a character literal's opening quote. The
// literal took it as its character, so '<new-line>' compiled as the value 10,
// and the line went uncounted, so every later diagnostic in the file came out
// a line early. It is now refused at the opening quote: a new-line is
// written '\n' and a carriage return '\r'. The literal ends where its line
// does, and the line end is counted where any other is.
//
// An unclosed back-ticked identifier right before a line end took the line
// end as its name, or as its missing backtick, in the same way. Its recovery
// now stops at the line end.
//
// Each case is followed by a reserved word, one diagnostic whose line is the
// assertion that the line end was counted. The file holds CRLF lines on
// purpose, so it is kept byte for byte (.gitattributes).
//
// Not here: a carriage return alone, which is refused as itself ("write
// '\r'"). The test runner reads a lone carriage return as a line break, in
// the source and in the compiler's echo of it, so it cannot place one.

// A new-line: the literal ends there, and the ';' on the next line ends the
// statement
let c1 = '
;
//~^^ ErrorBadTok:10 "cannot hold a line's end"
let wait = 1;            //~ ErrorReserved:5

// The form that compiled as 10. The quote on the next line then begins a
// literal of its own, which is not closed, and the parser finds two literals
// in a row
let c2 = '
';
//~^^ ErrorBadTok:10 "cannot hold a line's end"
//~^^^ ErrorNoSemi:11 follow-on
//~^^^ ErrorBadTok:1 "too-long character literal" follow-on
//~^^^^ ErrorBadGloStmt:1 follow-on
let baseurl = 1;         //~ ErrorReserved:5

// A CRLF line end is a line end too
let c3 = '
;
//~^^ ErrorBadTok:10 "cannot hold a line's end"
let context = 1;         //~ ErrorReserved:5

// A backtick right before the line end: the name is empty, and the ';' on
// the next line ends the statement
let b1 = `
;
//~^^ ErrorBadTok:10 "requires closing backtick"
let local = 1;           //~ ErrorReserved:5

// One character before the line end: it is the name, and the line end is
// not taken as the missing backtick
let b2 = `x
;
//~^^ ErrorBadTok:10 "requires closing backtick"
let selfmethod = 1;      //~ ErrorReserved:5

// The same before a CRLF line end
let b3 = `
;
//~^^ ErrorBadTok:10 "requires closing backtick"
let throw = 1;           //~ ErrorReserved:5
