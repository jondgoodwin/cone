// 'let' and 'var' are keywords: the words a declaration starts with. Neither can name
// a function or a variable, and the message says why, rather than leaving the parser
// to cascade from a declaration with no name. The word is read as the name that was
// meant, so the rest of the declaration parses as written.
//
// Parse stage only.

mod lexical_reject_dcl_word_name;

fn let() { }                            //~ ErrorNoName:4 "'let' begins a declaration, so it cannot name a function"

fn names() {
  let let = 1;                          //~ ErrorNoIdent:7 "'let' begins a declaration, so it cannot name a variable"
  var var: i32 = 2;                      //~ ErrorNoIdent:7 "'var' begins a declaration, so it cannot name a variable"
}
