// A zip of two cursors over the SAME buffer would give two passes overlapping parts
// of it, written at the same time. A 'mut' borrow does not keep a second borrow of
// its source away (the source is an alias loan, whether a local or reached through
// a '&mut' parameter), so the loop is refused for lending from the same buffer
// twice while it changes what it lends (ErrorParSources).

mod concurrency_parallel_zip_flow_refused;

import collections use *;
import actors;

fn sameParameter(a &mut List[u32]) {
  parallel each ra, rb in a.mutChunks(2usize).zip(a.mutChunks(3usize)) {   //~ ErrorParSources:46
    ra[0usize] = 1u32;
    rb[0usize] = 2u32;
  }
}

fn sameLocal() {
  mut a = new List[u32];
  a.push(1u32);
  parallel each ra, rb in a.mutChunks(2usize).zip(a.chunks(3usize)) {       //~ ErrorParSources:46
    ra[0usize] = 1u32;
  }
}
