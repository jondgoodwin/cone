// A 'parallel each' walks a source that reports its size and splits in pieces, and
// the cursors the adapters give ('map', 'filter', 'take', 'skip') hand out their items
// one after another and cannot. The message names the chain and says what to write
// instead: the loop's own header and 'yield' on the list the chain starts from.

mod concurrency_parallel_builder_chain_refused;

import collections use *;
import actors;

fn chains(xs &List[i64]) {
  imm a = new List[i64] <- parallel each x in xs.iter().map(x => *x * 2i64) yield x;          //~ ErrorParSource "chain of iterator adapters"
  imm b = new List[i64] <- parallel each xs.iter().filter(x => *x > 1i64);                    //~ ErrorParSource "chain of iterator adapters"
  imm c = new List[i64] <- parallel each x in xs.iter().skip(1usize).take(2usize) yield *x;   //~ ErrorParSource "chain of iterator adapters"
  parallel each x in xs.iter().map(x => *x) {                                                 //~ ErrorParSource "chain of iterator adapters"
    imm y = x;
  }
}

fn main() i32 { 0i32; }
