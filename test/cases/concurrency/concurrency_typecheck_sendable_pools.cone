// A GenPool and a DensePool are Sendable only where their element is, as a
// List is: a pool of borrows, or of a traced reference, may not leave its thread.

mod concurrency_typecheck_sendable_pools;

import pools use *;

fn crosses[T: Sendable]() {}

struct Point {pub x: i32; pub y: i32;}

fn main() {
  crosses[GenPool[Point]]();
  crosses[DensePool[Point]]();
  crosses[GenPool[&mut Point]]();     //~ ErrorNotSendable "a borrowed reference"
  crosses[DensePool[&Point]]();       //~ ErrorNotSendable "a borrowed reference"
}
