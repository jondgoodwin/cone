// What an operation takes is an owner of its bytes, never a borrow, against
// the iocore package: an Op's buffer field is an IoBuf, which a borrowed
// slice, a string literal and a '&mut IoBuf' are not, and its shared bytes
// field is Bytes, frozen and read-only. So a borrow cannot be submitted to
// the kernel (I2, I3): it is refused where the operation is built, as any
// struct or variant literal's field of the wrong type is (that diagnostic's
// code is ErrorBadArray, which names arrays; its message names neither
// type). What a
// completion carries crosses to another thread, Sendable, and a borrow of
// one does not; a Waker crosses, as Target.Post needs. Work for the
// blocking pool (Op.Call) takes an owned buffer too. A cancel group, a
// Request and an external operation's Completer cross threads, which is
// what they are for; a borrow of a Completer does not. The lines without
// annotations compile.

mod concurrency_iocore_submit;

import thread;
import sync use *;
import iobuf use *;
import iocore use *;

fn take(c: Completion) u64 {0u64}
fn peek(c: &mut Completion) u64 {0u64}
fn nudge(w: Waker) bool {w.wake()}
fn work(arg: u64, buf: &mut IoBuf) Outcome {Outcome.Done(0usize)}
fn cancelIt(g: CancelGroup) bool {g.cancel()}
fn dropIt(r: Request) u64 {0u64}
fn endIt(c: Completer) bool {var q = c; q.done(0usize)}
fn endRef(c: &mut Completer) bool {c.done(0usize)}

fn submitting(lp: &mut Loop, sock: Handle, file: Handle) {
  var buf = IoBuf(4096usize);
  let text: &Array[u8] = "hello";
  lp.submit(Op.Send(sock, text), Target.Here(1u64));          //~ ErrorBadArray "does not match expected field's type"
  lp.submit(Op.Send(sock, "hello"), Target.Here(2u64));       //~ ErrorBadArray "does not match expected field's type"
  lp.submit(Op.Recv(sock, &mut buf), Target.Here(3u64));      //~ ErrorBadArray "does not match expected field's type"
  lp.submit(Op.ReadAt(file, 0u64, buf.spare()), Target.Here(4u64));   //~ ErrorBadArray "does not match expected field's type"
  lp.submit(Op.SendBytes(sock, buf.view()), Target.Here(5u64));       //~ ErrorBadArray "does not match expected field's type"
  lp.submit(Op.Recv(sock, buf), Target.Here(6u64));
  var out = IoBuf(10usize);
  out.append("bytes");
  lp.submit(Op.SendBytes(sock, out.freeze()), Target.Here(7u64));
  var job = IoBuf(64usize);
  lp.submit(Op.Call(Lane.general(), &work, 0u64, &mut job), Target.Here(8u64));   //~ ErrorBadArray "does not match expected field's type"
  lp.submit(Op.Call(Lane.general(), &work, 0u64, job), Target.Here(9u64));
  // A datagram's buffer is an owner too
  var dg = IoBuf(64usize);
  lp.submit(Op.SendTo(sock, SocketAddr.localhost(9u16), text), Target.Here(12u64));   //~ ErrorBadArray "does not match expected field's type"
  lp.submit(Op.RecvFrom(sock, &mut dg), Target.Here(13u64));                          //~ ErrorBadArray "does not match expected field's type"
  lp.submit(Op.RecvFrom(sock, dg), Target.Here(14u64));
}

fn crossing(lp: &mut Loop, c: Completion) {
  var mc = c;
  let bad = thread.start(&mut mc, &peek);   //~ ErrorNotSendable "start requires A is Sendable, and &mut Completion is not Sendable"
  let ok = thread.start(mc, &take);
  let w = thread.start(lp.waker(), &nudge);
  var tx: Sender[&mut Completion];   //~ ErrorNotSendable "Sender requires T is Sendable, and &mut Completion is not Sendable"
  var tc: Sender[Completion];
  let g = thread.start(CancelGroup.make(), &cancelIt);
  let r = thread.start(lp.request(OpId.none()), &dropIt);
  let e = thread.start(lp.external(Target.Here(10u64), IoBuf.empty()), &endIt);
  var cm = lp.external(Target.Here(11u64), IoBuf.empty());
  let be = thread.start(&mut cm, &endRef);   //~ ErrorNotSendable "start requires A is Sendable, and &mut Completer is not Sendable"
}

fn main() {
  var lp = Loop.mustMake();
  submitting(&mut lp, Handle.none(), Handle.none());
}
