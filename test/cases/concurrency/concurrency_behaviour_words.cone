// 'async do' is one keyword phrase, two words, and neither means anything
// alone: each is refused where it is written without the other
// (ErrorBehaviourWords), and the declaration it begins is passed over whole,
// so nothing after it is reported as well. 'async fn', the spelling other
// languages use, is told apart and pointed at both of Cone's. And 'async do'
// declares an actor's behaviour, so it stands only in an actor's body: in a
// struct's, a trait's or an enum's body, at a module's top level and in a
// function's body it is refused, naming where it is. A parse diagnostic stops
// the compile before name resolution, which is why these are a file of their
// own.

mod concurrency_behaviour_words;

import actors;

actor Player {
  n u64;

  async do ball(self, k u64) {n = k;}     // a behaviour: fine
  async ping(self) {}                     //~ ErrorBehaviourWords "'async' means nothing alone: an actor's behaviour is declared 'async do name(self, ...)'"
  do pong(self) {}                        //~ ErrorBehaviourWords "'do' means nothing alone"
  async fn serve(self) {}                 //~ ErrorBehaviourWords "'async fn' is not Cone's: 'async' means nothing alone"
  fn helper(self) u64 {n;}                // a synchronous method: fine
}

struct Point {
  x i32;
  async do move(self) {}                  //~ ErrorBehaviourWords "'async do' declares an actor's behaviour, which only an actor's body holds, and this is the body of struct Point. A function here is declared 'fn'."
}

trait Shape {
  async do grow(self);                    //~ ErrorBehaviourWords "this is the body of trait Shape"
}

enum Light {
  Red;
  Green;
  async do flip(self) {}                  //~ ErrorBehaviourWords "this is the body of enum Light"
}

async do orphan() {}                      //~ ErrorBehaviourWords "this is a module's own declarations"

do alone() {}                             //~ ErrorBehaviourWords "'do' means nothing alone"

fn main() {
  async do inner(self) {}                 //~ ErrorBehaviourWords "this is a function's body"
}
