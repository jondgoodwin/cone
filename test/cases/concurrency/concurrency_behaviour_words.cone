// 'async fn' declares an actor's behaviour. 'async' means nothing alone: it is
// refused where it is written without 'fn' (ErrorBehaviourWords), and the
// declaration it begins is passed over whole, so nothing after it is reported as
// well. The spelling 'async do' is one of these: 'async' is followed by a name
// ('do' is an ordinary name, lexical_do_name), not by 'fn', and nothing says
// what the word was once. And 'async fn' declares an actor's behaviour, so it
// stands only in an actor's body: in a struct's, a trait's or an enum's body, at
// a module's top level and in a function's body it is refused, naming where it
// is. A parse diagnostic stops the compile before name resolution, which is why
// these are a file of their own.

mod concurrency_behaviour_words;

import actors;

actor Player {
  n: u64;

  async fn ball(self, k: u64) {n = k;}     // a behaviour: fine
  async ping(self) {}                     //~ ErrorBehaviourWords "'async' means nothing alone: an actor's behaviour is declared 'async fn name(self, ...)'"
  async do serve(self) {}                 //~ ErrorBehaviourWords "'async' means nothing alone: an actor's behaviour is declared 'async fn name(self, ...)'"
  fn helper(self) u64 {n}                // a synchronous method: fine
}

struct Point {
  x: i32;
  async fn move(self) {}                  //~ ErrorBehaviourWords "'async fn' declares an actor's behaviour, which only an actor's body holds, and this is the body of struct Point. A function here is declared 'fn'."
  async do shift(self) {}                 //~ ErrorBehaviourWords "'async' means nothing alone"
}

trait Shape {
  async fn grow(self);                    //~ ErrorBehaviourWords "this is the body of trait Shape"
}

enum Light {
  Red;
  Green;
  async fn flip(self) {}                  //~ ErrorBehaviourWords "this is the body of enum Light"
}

async fn orphan() {}                      //~ ErrorBehaviourWords "this is a module's own declarations"

async do lost() {}                        //~ ErrorBehaviourWords "'async' means nothing alone"

fn main() {
  async fn inner(self) {}                 //~ ErrorBehaviourWords "this is a function's body"
}
