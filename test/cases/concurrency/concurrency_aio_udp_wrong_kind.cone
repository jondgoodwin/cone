// The aio package's UdpSocket is a kind of its own beside Socket (TCP) and
// File, so a call of the wrong kind does not compile: a stream operation
// (read, write, accept) on a UdpSocket, a datagram operation (recvFrom,
// sendTo) on a Socket or a File, and a Socket where a UdpSocket is asked for.
// The right kind compiles (the last behaviour).

mod concurrency_aio_udp_wrong_kind;

import iobuf use Pool;
import iocore use SocketAddr;
import actors;
import aio use Socket, File, UdpSocket;

fn takesUdp(u: &UdpSocket) {}

actor Wrong {
  pool: Pool;

  pub async do streamOnUdp(self, u: UdpSocket) {
    let r = await u.read(pool.mustTake(64usize));        //~ ErrorNoMbr:20 "`read` not found"
    let w = await u.write(pool.mustTake(64usize));       //~ ErrorNoMbr:20 "`write` not found"
    let a = await u.accept();                            //~ ErrorNoMbr:20 "`accept` not found"
  }

  pub async do datagramOnTcp(self, s: Socket) {
    let r = await s.recvFrom(pool.mustTake(64usize));    //~ ErrorNoMbr:20 "`recvFrom` not found"
    let w = await s.sendTo(SocketAddr.localhost(1u16), pool.mustTake(64usize));  //~ ErrorNoMbr:20 "`sendTo` not found"
  }

  pub async do datagramOnFile(self, f: File) {
    let r = await f.recvFrom(pool.mustTake(64usize));    //~ ErrorNoMbr:20 "`recvFrom` not found"
  }

  pub async do tcpForUdp(self, s: Socket) {
    takesUdp(&s);                                        //~ ErrorInvType:14 "does not match declared parameter"
  }

  pub async do right(self, u: UdpSocket) {
    let r = await u.recvFrom(pool.mustTake(64usize));
    let w = await u.sendTo(SocketAddr.localhost(1u16), pool.mustTake(64usize));
    takesUdp(&u);
  }
}

fn main() {}
