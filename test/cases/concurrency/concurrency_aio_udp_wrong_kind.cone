// The aio package's UdpSocket is a kind of its own beside Socket (TCP) and
// File, so a call of the wrong kind does not compile: a stream operation
// (read, write, accept) on a UdpSocket, a datagram operation (recvFrom,
// sendTo) on a Socket or a File, and a Socket where a UdpSocket is asked for.
// The right kind compiles (the last behaviour).

mod concurrency_aio_udp_wrong_kind;

import iobuf use IoBuf;
import iocore use SocketAddr;
import actors;
import aio use Socket, File, UdpSocket;

fn takesUdp(u: &UdpSocket) {}

actor Wrong {
  pub async fn streamOnUdp(self, u: UdpSocket) {
    let r = await u.read(IoBuf(64usize));        //~ ErrorNoMbr:20 "`read` not found"
    let w = await u.write(IoBuf(64usize));       //~ ErrorNoMbr:20 "`write` not found"
    let a = await u.accept();                            //~ ErrorNoMbr:20 "`accept` not found"
  }

  pub async fn datagramOnTcp(self, s: Socket) {
    let r = await s.recvFrom(IoBuf(64usize));    //~ ErrorNoMbr:20 "`recvFrom` not found"
    let w = await s.sendTo(SocketAddr.localhost(1u16), IoBuf(64usize));  //~ ErrorNoMbr:20 "`sendTo` not found"
  }

  pub async fn datagramOnFile(self, f: File) {
    let r = await f.recvFrom(IoBuf(64usize));    //~ ErrorNoMbr:20 "`recvFrom` not found"
  }

  pub async fn tcpForUdp(self, s: Socket) {
    takesUdp(&s);                                        //~ ErrorInvType:14 "does not match declared parameter"
  }

  pub async fn right(self, u: UdpSocket) {
    let r = await u.recvFrom(IoBuf(64usize));
    let w = await u.sendTo(SocketAddr.localhost(1u16), IoBuf(64usize));
    takesUdp(&u);
  }
}

fn main() {}
