// What the thread check refuses. A generic asks for it with the built-in
// marker 'Sendable' ('[T Sendable]', 'where T is Sendable'), as thread.start
// and sync's channel types do, and an instance whose argument is not one is
// refused where it is asked for (ErrorNotSendable), naming what binds the
// argument to its thread and where that sits in it. A type is bound when it
// holds, inline or through an owning reference, any of:
//
// - a borrowed reference, of any permission: its lifetime is checked in one
//   thread alone;
// - an owner that may be aliased whose permission is not race-safe ('mut',
//   'ro'): '+Rc-mut', '+Arc-mut';
// - an owner that may be aliased in a region not declaring ThreadSafe, even
//   'imm': '+Rc-imm', whose count is not atomic;
// - a traced reference, whatever its permission: the collector is single
//   threaded;
// - a raw pointer, whose target nothing checks;
// - an instance of a type declaring 'Sendable' whose type argument is bound.
//
// A 'uni' owner moves, taking its value with it, so what it points at is
// asked in turn: an owner of a struct holding a borrow is refused, and a
// struct reaching itself through one is judged by what else it holds. What a
// thread returns crosses back, and is asked too. The
// message says how a local is judged, since a 'mut' local is the common
// confusion: what is checked is the reference types a value holds.
//
// The last refusal is judged after type check: 'Looped' asks for Sender[Looped]
// while it is itself being laid out, before its field 'w' has a type, so the
// answer waits until every struct is laid out (genericSendableCheckAll).

mod concurrency_typecheck_sendable;

import sync use *;
import thread;

fn crosses[T Sendable]() {}

struct Point {pub x i32; pub y i32;}

// Holds a borrow
struct Holds {pub p &mut Point;}

// Holds an owner whose permission is not race-safe
struct Owns {pub p +Rc-mut Point;}

// Holds one deeper down, in a field's field
struct Inner {pub r &mut i32;}
struct Outer {pub id u64; pub inner Inner;}

// One variant holds a raw pointer
enum Msg {
  struct Stop {}
  struct Data {pub v u64;}
  struct Ptr {pub p *u64;}
}

// Reaches itself through an owner, and holds a raw pointer beside
struct Linked {pub next Option[+So Linked]; pub raw *u8;}

// Declares Sendable: taken at its word, but only where T is Sendable
struct Carrier[T] is Sendable {pub p *T;}

// A traced region
struct tr is RegionRef, Traced {
  fn alloc(size usize) *u8 inline { malloc(size); }
  fn mark(self &uni tr, perm u32, mode u32) { }
}

struct Wrap[T] {pub v T;}

// Asks for a channel of itself while it is being laid out
struct Looped {
  pub back Sender[Looped];   //~ ErrorNotSendable "Looped.w.v is &mut i32, a borrowed reference"
  pub w Wrap[&mut i32];
}

fn bump(n &mut i32) i32 {*n + 1i32;}

fn shared(n i32) +Rc-imm Point {+Rc-imm Point[n, n];}

fn main() {
  crosses[&mut Point]();     //~ ErrorNotSendable "and &mut Point is not Sendable: it is a borrowed reference, and no borrow may leave its thread"
  crosses[&Point]();         //~ ErrorNotSendable "it is a borrowed reference"
  crosses[Holds]();          //~ ErrorNotSendable "Holds.p is &mut Point, a borrowed reference"
  crosses[Owns]();           //~ ErrorNotSendable "Owns.p is +Rc-mut Point, an owner whose permission, mut, is not race-safe"
  crosses[+Rc-imm Point]();  //~ ErrorNotSendable "it is an owner that may be copied, and Rc does not declare ThreadSafe"
  crosses[+Arc-mut Point](); //~ ErrorNotSendable "an owner whose permission, mut, is not race-safe"
  crosses[+tr-imm Point]();  //~ ErrorNotSendable "a reference the tr collector traces"
  crosses[*u64]();           //~ ErrorNotSendable "it is a raw pointer, whose target the compiler cannot check"
  crosses[Outer]();          //~ ErrorNotSendable "Outer.inner.r is &mut i32"
  crosses[+So Holds]();      //~ ErrorNotSendable "+So-uni Holds is not Sendable: Holds.p is &mut Point"
  crosses[+Arc-imm Holds](); //~ ErrorNotSendable "+Arc-imm Holds is not Sendable: Holds.p is &mut Point"
  crosses[Msg]();            //~ ErrorNotSendable "Ptr.p is *u64, a raw pointer"
  crosses[Carrier[&mut Point]]();   //~ ErrorNotSendable "its type argument is &mut Point, a borrowed reference"
  crosses[Option[&mut i32]]();      //~ ErrorNotSendable "Option[&mut i32] is not Sendable: Some.value is &mut i32"
  crosses[Linked]();                //~ ErrorNotSendable "Linked.raw is *u8, a raw pointer"
  crosses[[3; &Point]]();           //~ ErrorNotSendable "[3; &ro Point] is not Sendable: an element is &ro Point"

  // What a thread returns crosses back
  imm r = thread.start(1i32, &shared);   //~ ErrorNotSendable "start requires R is Sendable, and +Rc-imm Point is not Sendable"

  // A borrow of a local may not cross, and the message says how a local is
  // judged: a 'mut' local of a number crosses (concurrency_sendable)
  mut n = 5i32;
  imm u = thread.start(&mut n, &bump);   //~ ErrorNotSendable "start requires A is Sendable, and &mut i32 is not Sendable: it is a borrowed reference"
  imm v = thread.start(&mut n, &bump);   //~ ErrorNotSendable "not how a variable was declared: a local declared 'mut x = 5' holds a number, which is Sendable"

  // A channel of what may not cross is refused where it is made
  mut tx Sender[&mut Point];   //~ ErrorNotSendable "Sender requires T is Sendable"
}
