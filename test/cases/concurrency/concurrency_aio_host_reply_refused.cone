// Bug 46. A hosted job an actor awaits (Host.awaitable) answers through an
// actors.ReplyOf[R], R the Awaitable's: a job whose 'run' answers another type
// than the Awaitable promises is refused when it is compiled, and a job whose
// 'run' takes the envelope of another type than the Awaitable's R is refused
// where it is awaited. Before, 'run' was handed an untyped actors.Reply and R
// was free, so a host-package author could answer the wrong type and the
// 'await' read it back as another (a crash). The truthful twin is in the aio
// package's tests (hosted: SumJob answers a u64 through its ReplyOf[u64]).

mod concurrency_aio_host_reply_refused;

import time use Instant;
import iocore use Loop, Completion, forever;
import actors;
import aio use Host;

fn @initpure init() {
  h = aio.host[Svc](&makeSvc);
}

fn makeSvc() Svc {Svc(0u64)}

let h: Host[Svc];

struct Svc {
  n: u64;
  pub fn turn(self: &mut, lp: &mut Loop) {}
  pub fn complete(self: &mut, lp: &mut Loop, c: &mut Completion) bool {false}
  pub fn wakeAt(self: &) Instant {forever()}
  pub fn end(self: &mut, lp: &mut Loop) {}
}

struct Pair {
  pub a: u64;
  pub b: u64;
}

// Promised a u64, a Pair answered
struct AnswersWrong {
  pub fn run(self, lp: &mut Loop, s: &mut Svc, rp: actors.ReplyOf[u64]) {
    rp.answer(Pair(1u64, 2u64));   //~ ErrorNoCandidate "No method declared by `answer`"
  }
}

// Awaited as an Awaitable[u64], though its envelope is a u32's
struct TakesWrongEnvelope {
  pub fn run(self, lp: &mut Loop, s: &mut Svc, rp: actors.ReplyOf[u32]) {
    rp.answer(1u32);
  }
}

fn awaitWrongEnvelope() actors.Awaitable[u64] {
  h.awaitable[TakesWrongEnvelope, u64](TakesWrongEnvelope())   //~ ErrorWhereUnmet:4 "TakesWrongEnvelope is not HostReplyJob[Svc, u64]"
}

// A job still written against the untyped reply
struct TakesUntyped {
  pub fn run(self, lp: &mut Loop, s: &mut Svc, rp: actors.Reply) {}
}

fn awaitUntyped() actors.Awaitable[u64] {
  h.awaitable[TakesUntyped, u64](TakesUntyped())   //~ ErrorWhereUnmet:4 "TakesUntyped is not HostReplyJob[Svc, u64]"
}

fn main() {}
