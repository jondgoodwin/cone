// What futures refuse:
//
// - a move future awaited twice: Future[Note] moves, as Note does, so the
//   first 'await' takes it and the second finds it moved (ErrorMove);
//   Future[u64] copies, and is awaited twice;
// - an 'await' on a value that is no future, behaviour's reply or operation,
//   which waits for no answer (ErrorAwaitNotFuture);
// - the value of a call of a behaviour that returns nothing, kept in a local
//   or passed on: there is no future (ErrorFutureVoid); called as a
//   statement of its own, it is fire and forget;
// - a future crossing to an actor is Sendable only where its value is:
//   Future[u64] crosses, Future[Rc[imm, u64]] does not (ErrorNotSendable).

mod concurrency_future_refused;

import actors;

struct Note is Move {
  pub n: u64;
}

fn keep(x: u64) {}

actor Maker {
  pub async fn note(self, n: u64) Note {Note(n)}
  pub async fn count(self) u64 {1u64}
  pub async fn tick(self) {}
}

actor Holder {
  pub async fn takeOk(self, f: actors.Future[u64]) {}
  pub async fn takeRc(self, f: actors.Future[Rc[imm, u64]]) {}  //~ ErrorNotSendable "a Future, which is not Sendable"
}

actor Asker {
  m: Maker;

  pub async fn moved(self) {
    let f = m.note(1u64);
    let a = await f;
    let b = await f;            //~ ErrorMove "This variable's value has been moved out"
  }

  pub async fn copied(self) {
    let f = m.count();
    let a = await f;
    let b = await f;
  }

  pub async fn plain(self) {
    let x = 5u64;
    let y = await x;            //~ ErrorAwaitNotFuture "This one awaits a u64, which is none of them"
  }

  pub async fn voided(self) {
    m.tick();
    let t = m.tick();           //~ ErrorFutureVoid "tick returns nothing, so its call gives no future to keep"
  }
}

fn main() {}
