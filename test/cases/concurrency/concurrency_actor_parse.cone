// What an actor's declaration may not say, refused where it is written, at
// parse: a parse diagnostic stops the compile before name resolution, which is
// why these are a file of their own.
//
// - A behaviour carrying a borrow is refused as not Sendable whatever it
//   borrows (ErrorNotSendable): no borrow leaves its thread.
// - The rest is ErrorActorMember: a field is private state, never 'pub'; no
//   static, which every actor of the kind would share across threads; a
//   'pub' function without 'self' would run on no actor; a behaviour is not
//   generic yet; a behaviour's 'self' is the state lent for the message, so
//   'self: &uni' is the finalizer's alone; 'extern' and a macro have no place;
//   and a generic actor is not built, nor a base for an actor to extend (what
//   it says it is, 'is', is checked later: concurrency_actor_trait_is_refused).
// - Behaviours and synchronous methods: a behaviour ('async fn') runs on the
//   state, so it has 'self'; 'init' and 'final' are synchronous, declared
//   'fn'; and a 'fn' with 'self' runs inside the actor alone, so it is never
//   'pub' -- which is also what an actor written before 'async fn' gets for
//   each of its messages, with the spelling to use.
// A behaviour may return a value, which a reply carries back to an 'await'
// (concurrency_await_reply), and so may a synchronous method, called from the
// actor's own methods (fine). A behaviour that is not 'pub' is still a
// message, sent from its own module (concurrency_actor_selfsend,
// concurrency_actor_private).

mod concurrency_actor_parse;

import actors;

actor Bad {
  pub count: u64;                          //~ ErrorActorMember "a field of an actor is never 'pub'"
  static var shared: u64 = 0u64;           //~ ErrorActorMember "An actor has no 'static'"

  pub async fn total(self) u64 {count}
  async fn quiet(self, n: u64) {}
  pub async fn peek(self, r: &u64) {}      //~ ErrorNotSendable "Actor Bad's behaviour peek takes r, a borrowed reference"
  pub async fn pick[T](self, x: T) {}      //~ ErrorActorMember "Actor Bad's behaviour pick is generic"
  pub fn make() u64 {0u64}               //~ ErrorActorMember "make has no 'self', so it would not run on actor Bad"
  pub async fn whole(self: &new) {}      //~ ErrorActorMember "whole's 'self' is actor Bad's state"
  extern fn elsewhere(self);              //~ ErrorActorMember "'extern' declares one defined elsewhere"
  macro twice[x: i64] {x + x}                 //~ ErrorActorMember "does not declare a macro yet"
  fn fine(self) u64 {count}
  async fn loose(n: u64) {}                //~ ErrorActorMember "loose is declared 'async fn', a behaviour of actor Bad's, and has no 'self'"
  pub fn sent(self, n: u64) {}             //~ ErrorActorMember "sent is a 'fn' of actor Bad's: synchronous, run inside the actor by the method that calls it, so nothing outside the actor reaches it, and it is never 'pub'. A message the actor's handle sends is a behaviour, declared 'async fn': 'pub async fn sent(...)'"
}

actor Lifecycle {
  async fn init(self: &new) {}             //~ ErrorActorMember "An actor's initializer is synchronous, declared 'fn': it runs on the thread making the actor"
  async fn final(self: &uni) {}            //~ ErrorActorMember "An actor's 'final' is synchronous, declared 'fn': it runs as the actor dies"
}

actor Many['a] {                          //~ ErrorActorMember "Actor Many names a lifetime among its type parameters"
  pub async fn take(self, x: u64) {}
}

trait Shape {
  fn area(self: &) u64;
}

actor Square extends Shape {              //~ ErrorActorMember "Actor Square names a base"
  pub async fn grow(self) {}
}

fn main() {}
