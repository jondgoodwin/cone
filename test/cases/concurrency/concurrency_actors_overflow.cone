// A run queue that fills. With one worker, so that nothing is stolen, a
// 'Spreader' actor is handed 3000 'Target' actors and sends each one message
// asking for a moment's work. A message sent from a running actor makes its
// target runnable on the sending worker's own run queue, which holds 1024:
// each time it fills, the worker moves half of it to the inject queue, and
// all 3000 still run, each once. Main waits for the count, then reads the
// run's counts from actors.stats(): one worker, no steals, and every target's
// turn and message counted. A target's state is empty: an actor need have no
// fields.
//
// The actors are declared. A target has no 'init', and 'new Target()' makes
// an actor of no fields.

mod concurrency_actors_overflow;

import stdio use *;
import collections use List;
import thread;
import time;
import actors;

const many = 3000u64;
const moment = 1000u64;

struct Results {
  pub done Atomic[u64];
  pub check Atomic[u64];
}

imm results Results;

fn @initpure init() {
  results = new Results(Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

// ---- Target: does some work when asked ----

actor Target {
  pub fn work(self, n u64) {
    mut x = 1u64;
    mut i = 0u64;
    while i < n {
      x = x * 6364136223846793005u64 + i;
      i = i + 1u64;
    }
    results.check.add(x & 1u64);
    results.done.add(1u64);
  }
}

// ---- Spreader: sends every target it holds one message ----

actor Spreader {
  held List[Target];

  fn init(self &new) {
    *self = new Self(List[Target].empty());
  }

  pub fn add(self, t Target) {
    held.push(t);
  }

  pub fn go(self, n u64) {
    mut i = 0usize;
    while i < held.len() {
      held[i].work(n);
      i = i + 1usize;
    }
  }
}

fn main() {
  initAll();
  actors.configure(new actors.Options(workers: 1u32));
  {
    imm s = new Spreader();
    mut i = 0u64;
    while i < many {
      s.add(new Target());
      i = i + 1u64;
    }
    s.go(moment);
  }
  while results.done.load() < many {
    thread.sleep(time.Duration.fromMillis(1));
  }
  finalAll();
  imm st = actors.stats();
  printStr("more targets than a run queue holds, run "); printUInt(results.done.load()); printStr("\n");
  printStr("workers "); printUInt(u64.from(st.workers)); printStr("\n");
  printStr("steals "); printUInt(st.steals); printStr("\n");
  printStr("messages handled "); printUInt(st.messages); printStr("\n");
}
