// The parallel builder, 'new List[T] <- parallel each x in src [if c] yield v':
// the passes of the loop run at the same time on the actors' workers (four,
// started for it), each piece of consecutive passes appending to a list of its
// own, and the lists are joined in the order of the passes before the list is
// used. So the result is the one a plain '<- each' builds, whatever order the
// pieces finish in.
//
// Each case is checked against a plain '<- each' over the same source and the
// same pure function, element by element (the program prints whether each held,
// not how the work was divided), and the order is checked on its own where the
// plain loop would not show it.
//
//   - number ranges: '<' and '<=', signed through zero, ending at the type's
//     maximum, empty, reversed, of one pass
//   - arrays (also behind a reference), a slice of an array, a literal array,
//     lists, a list of structs, an empty list, fewer passes than workers, many
//     more pieces than workers
//   - uneven work: pass i costs (i * i % 97) * 40 rounds, so some are ninety
//     times the others
//   - the header 'if': over a list, an array and a number range, a filter that
//     is never true and one that is always true; the matches stay in order
//   - items that move: a String made in the body, a struct holding one
//   - the drain form, '<- parallel each src', mixed with other entries of the
//     list, built onto a list that already holds values
//   - a loop that changes its items (mutItems) and yields from them
//   - a builder inside a generic function, a method, the body of another
//     parallel each, a function a pass calls that has a builder of its own
//   - outside variables read in the header and the yield
//   - work really is spread over more than one thread

mod concurrency_parallel_builder;

import stdio use *;
import collections use *;
import thread;
import time;
import actors;

fn mix(i u64, n u64) u64 {
  mut x = i + 1u64;
  mut k = 0u64;
  while k < n {
    x = x * 6364136223846793005u64 + k;
    k = k + 1u64;
  }
  x;
}

fn weigh(i u64) u64 {
  mix(i, (i * i) % 97u64 * 40u64);
}

fn report(name &str, ok bool) {
  printStr(name);
  printStr(if ok {": ok\n";} else {": FAILED\n";});
}

// Are the two lists the same length, holding the same numbers in the same order?
fn same(a &List[u64], b &List[u64]) bool {
  if a.len() != b.len() { return false; }
  mut i = 0usize;
  while i < a.len() {
    if *a[i] != *b[i] { return false; }
    i = i + 1usize;
  }
  true;
}

fn numbered(n u64) List[u64] {
  mut l = new List[u64];
  mut k = 0u64;
  while k < n {
    l.push(k * 7u64 % 1013u64);
    k = k + 1u64;
  }
  l;
}

// ---- number ranges ----

fn ranges() {
  imm par = new List[u64] <- parallel each i in 0usize < 3000usize yield weigh(u64.from(i));
  imm plain = new List[u64] <- each i in 0usize < 3000usize yield weigh(u64.from(i));
  report("range < over uneven work", same(&par, &plain) and par.len() == 3000usize);

  imm par2 = new List[u64] <- parallel each i in 10usize <= 2500usize yield weigh(u64.from(i));
  imm plain2 = new List[u64] <- each i in 10usize <= 2500usize yield weigh(u64.from(i));
  report("range <=", same(&par2, &plain2) and par2.len() == 2491usize);

  // The order, on its own: pass i yields i, so the list is 0, 1, 2, ...
  imm order = new List[usize] <- parallel each i in 0usize < 20000usize yield i;
  mut inorder = order.len() == 20000usize;
  mut k = 0usize;
  while k < order.len() {
    if *order[k] != k { inorder = false; }
    k = k + 1usize;
  }
  report("range < in the order of the passes, 20000 of them", inorder);

  imm one = new List[usize] <- parallel each i in 7usize <= 7usize yield i;
  report("range <= of one number", one.len() == 1usize and *one[0usize] == 7usize);
  imm empty = new List[usize] <- parallel each i in 5usize < 5usize yield i;
  report("an empty range gives an empty list", empty.len() == 0usize);
  imm reversed = new List[usize] <- parallel each i in 6usize < 5usize yield i;
  report("a reversed range gives an empty list", reversed.len() == 0usize);

  // -20 .. 29, through zero
  imm signed = new List[i64] <- parallel each i in -20i64 < 30i64 yield i * 3i64 - 7i64;
  mut signedok = signed.len() == 50usize;
  mut s = 0usize;
  while s < signed.len() {
    if *signed[s] != (i64.from(s) - 20i64) * 3i64 - 7i64 { signedok = false; }
    s = s + 1usize;
  }
  report("a signed range through zero", signedok);

  // 250 ..= 255, the last the type's maximum
  imm top = new List[u8] <- parallel each i in 250u8 <= 255u8 yield i;
  report("a range ending at the type's maximum", top.len() == 6usize and *top[0usize] == 250u8 and *top[5usize] == 255u8);
}

// ---- arrays, slices, lists ----

fn doubledSlice(s &Array[u64]) List[u64] {
  new List[u64] <- parallel each x in s yield weigh(*x);
}

fn plainSlice(s &Array[u64]) List[u64] {
  new List[u64] <- each x in s yield weigh(*x);
}

fn viaRef(a &Array[u64, 8]) List[u64] {
  new List[u64] <- parallel each x in a yield *x * 3u64;
}

struct Pt {
  x u64;
  y u64;
}

fn sources() {
  imm a = [3u64, 4u64, 5u64, 6u64, 7u64, 8u64, 9u64, 10u64];
  imm fromarray = new List[u64] <- parallel each x in a yield weigh(*x);
  imm plainarray = new List[u64] <- each x in a yield weigh(*x);
  report("an array", same(&fromarray, &plainarray));

  imm threes = viaRef(&a);
  report("an array behind a reference", threes.len() == 8usize and *threes[0usize] == 9u64 and *threes[7usize] == 30u64);
  report("a slice of the whole array", same(&doubledSlice(&a), &plainSlice(&a)));
  report("a part of an array", same(&doubledSlice(&a[2usize..6usize]), &plainSlice(&a[2usize..6usize])) and doubledSlice(&a[2usize..6usize]).len() == 4usize);
  report("an empty part of an array", doubledSlice(&a[3usize..3usize]).len() == 0usize);

  imm lit = new List[u64] <- parallel each x in [100u64, 200u64, 300u64] yield *x + 1u64;
  report("a literal array", lit.len() == 3usize and *lit[0usize] == 101u64 and *lit[2usize] == 301u64);

  imm l = numbered(5000u64);
  imm fromlist = new List[u64] <- parallel each x in l yield weigh(*x);
  imm plainlist = new List[u64] <- each x in l yield weigh(*x);
  report("a list of 5000", same(&fromlist, &plainlist) and fromlist.len() == 5000usize);
  report("the source list is whole afterwards", l.len() == 5000usize);

  imm few = numbered(2u64);
  imm fromfew = new List[u64] <- parallel each x in few yield *x + 1u64;
  report("fewer passes than workers", fromfew.len() == 2usize and *fromfew[0usize] == 1u64 and *fromfew[1usize] == 8u64);

  imm none = new List[u64];
  imm fromnone = new List[u64] <- parallel each x in none yield *x;
  report("an empty list", fromnone.len() == 0usize);

  mut pts = new List[Pt];
  pts.push(new Pt(1u64, 2u64));
  pts.push(new Pt(10u64, 20u64));
  pts.push(new Pt(100u64, 200u64));
  imm fields = new List[u64] <- parallel each p in pts yield p.x * 1000u64 + p.y;
  report("a list of structs, read through the borrow", fields.len() == 3usize and *fields[0usize] == 1002u64
    and *fields[1usize] == 10020u64 and *fields[2usize] == 100200u64);
}

// ---- the header 'if' ----

fn filters() {
  imm l = numbered(4000u64);
  imm par = new List[u64] <- parallel each x in l if weigh(*x) % 3u64 == 0u64 yield weigh(*x);
  imm plain = new List[u64] <- each x in l if weigh(*x) % 3u64 == 0u64 yield weigh(*x);
  report("a filter over a list of uneven work", same(&par, &plain) and par.len() > 100usize and par.len() < 4000usize);

  imm never = new List[u64] <- parallel each x in l if *x > 100000u64 yield *x;
  report("a filter that is never true", never.len() == 0usize);
  imm always = new List[u64] <- parallel each x in l if *x < 100000u64 yield *x;
  report("a filter that is always true", same(&always, &l));

  imm a = [5u64, 6u64, 7u64, 8u64, 9u64, 10u64];
  imm odd = new List[u64] <- parallel each x in a if *x % 2u64 == 1u64 yield *x;
  report("a filter over an array", odd.len() == 3usize and *odd[0usize] == 5u64 and *odd[1usize] == 7u64 and *odd[2usize] == 9u64);

  // The matches of a range keep the order of the passes: multiples of 7
  imm sevens = new List[usize] <- parallel each i in 0usize < 30000usize if i % 7usize == 0usize yield i;
  mut inorder = sevens.len() == 4286usize;
  mut k = 0usize;
  while k < sevens.len() {
    if *sevens[k] != k * 7usize { inorder = false; }
    k = k + 1usize;
  }
  report("a filter over a range, in order", inorder);
}

// ---- items that move ----

struct Tag {
  name String;
  n u64;
}

fn word(n u64) String {
  mut s = String.from("item-");
  s <- n;
  if n % 10u64 == 0u64 { s <- "-ten"; } else { s <- "-other"; }
  s;
}

fn moving() {
  imm l = numbered(3000u64);
  imm par = new List[String] <- parallel each x in l yield word(*x);
  imm plain = new List[String] <- each x in l yield word(*x);
  mut sameStrings = par.len() == plain.len();
  mut k = 0usize;
  while sameStrings and k < par.len() {
    if par[k].len() != plain[k].len() { sameStrings = false; }
    k = k + 1usize;
  }
  report("Strings made in the body", sameStrings and par.len() == 3000usize);

  imm tags = new List[Tag] <- parallel each x in l if *x % 2u64 == 0u64 yield new Tag(word(*x), *x);
  imm plaintags = new List[Tag] <- each x in l if *x % 2u64 == 0u64 yield new Tag(word(*x), *x);
  mut sameTags = tags.len() == plaintags.len() and tags.len() > 0usize;
  mut t = 0usize;
  while sameTags and t < tags.len() {
    if tags[t].n != plaintags[t].n or tags[t].name.len() != plaintags[t].name.len() { sameTags = false; }
    t = t + 1usize;
  }
  report("structs holding Strings, filtered", sameTags);
}

// ---- the drain form, other entries, a list that already holds values ----

fn forms() {
  imm l = numbered(1000u64);
  imm drained = new List[u64] <- parallel each l;
  report("the drain form, '<- parallel each src'", same(&drained, &l));

  imm mixed = new List[u64] <- 7u64, parallel each x in l yield *x + 1u64, 9u64;
  report("among other entries", mixed.len() == 1002usize and *mixed[0usize] == 7u64 and *mixed[1usize] == 1u64
    and *mixed[1000usize] == *l[999usize] + 1u64 and *mixed[1001usize] == 9u64);

  mut onto = new List[u64];
  onto <- 1u64, 2u64, 3u64;
  onto <- parallel each i in 0usize < 5000usize yield u64.from(i);
  mut ontook = onto.len() == 5003usize and *onto[0usize] == 1u64 and *onto[2usize] == 3u64;
  mut k = 0usize;
  while k < 5000usize {
    if *onto[3usize + k] != u64.from(k) { ontook = false; }
    k = k + 1usize;
  }
  report("built onto a list that already holds values", ontook);

  // 'parallel' is a word only directly before 'each': as an entry it is a name
  imm parallel = 5u64;
  imm named = new List[u64] <- parallel, parallel + 1u64, parallel each x in l yield *x;
  report("'parallel' as a name among the entries", named.len() == 1002usize and *named[0usize] == 5u64
    and *named[1usize] == 6u64 and *named[2usize] == *l[0usize] and *named[1001usize] == *l[999usize]);

  // Two builders in one list of entries
  imm two = new List[u64] <- parallel each i in 0usize < 100usize yield u64.from(i), parallel each i in 0usize < 100usize yield u64.from(i) + 1000u64;
  report("two builders in one list", two.len() == 200usize and *two[99usize] == 99u64 and *two[100usize] == 1000u64 and *two[199usize] == 1099u64);
}

// ---- a loop that changes its items ----

fn changing() {
  mut l = numbered(2000u64);
  imm before = numbered(2000u64);
  imm out = new List[u64] <- parallel each x in l.mutItems() yield *x + 1u64;
  mut ok = out.len() == 2000usize;
  mut k = 0usize;
  while k < out.len() {
    if *out[k] != *before[k] + 1u64 { ok = false; }
    k = k + 1usize;
  }
  report("yielding from the items mutItems lends", ok);
}

// ---- where it is written ----

fn doubleAll[T](xs &List[T]) List[T] where T is Copy {
  new List[T] <- parallel each x in xs yield *x;
}

struct Scaler {
  scale u64;
  items List[u64];

  fn scaled(self &) List[u64] {
    new List[u64] <- parallel each x in items yield *x * scale;
  }
}

// A function a pass calls, which has a builder of its own
fn rowSum(r u64) u64 {
  imm row = new List[u64] <- parallel each c in 0usize < 30usize yield weigh(r * 100u64 + u64.from(c));
  mut total = 0u64;
  each v in row {
    total = total + *v;
  }
  total;
}

fn places() {
  imm l = numbered(2500u64);
  report("a builder in a generic function", same(&doubleAll(&l), &l));
  imm sc = new Scaler(3u64, numbered(800u64));
  imm r = sc.scaled();
  report("a builder in a method, a field read in the yield",
    r.len() == 800usize and *r[5usize] == *sc.items[5usize] * 3u64 and *r[799usize] == *sc.items[799usize] * 3u64);

  // 40 rows of 30 cells, a builder inside a builder's pass
  imm rows = new List[u64] <- parallel each r in 0usize < 40usize yield rowSum(u64.from(r));
  mut plainrows = new List[u64];
  each r in 0usize < 40usize {
    mut total = 0u64;
    each c in 0usize < 30usize {
      total = total + weigh(u64.from(r) * 100u64 + u64.from(c));
    }
    plainrows <- total;
  }
  report("a builder inside a builder's pass", same(&rows, &plainrows) and rows.len() == 40usize);

  // Outside variables are read in the header and the yield
  imm base = 11u64;
  imm limit = 2000u64;
  imm outside = new List[u64] <- parallel each i in 0usize < 3000usize if u64.from(i) < limit yield u64.from(i) * base + limit;
  mut outsideok = outside.len() == 2000usize;
  mut k = 0usize;
  while k < outside.len() {
    if *outside[k] != u64.from(k) * base + limit { outsideok = false; }
    k = k + 1usize;
  }
  report("outside variables read in the header and the yield", outsideok);
}

// ---- spread: which threads ran the passes ----

fn bits(v u64) u64 {
  mut n = 0u64;
  mut x = v;
  while x != 0u64 {
    n = n + (x & 1u64);
    x = x >> 1u64;
  }
  n;
}

fn threadBit(i usize, ran &Atomic[u64]) u64 {
  imm w = actors.workerIndex();
  imm bit = if w == actors.noWorker {1u64 << 63u64;} else {1u64 << u64.from(w);};
  ran.bitOr(bit);
  // Hold this pass until a second thread has run one, or three seconds pass
  mut waited = 0u64;
  while bits(ran.load()) < 2u64 and waited < 3000u64 {
    thread.sleep(time.Duration.fromMillis(1));
    waited = waited + 1u64;
  }
  u64.from(i);
}

fn spread() {
  imm ran = Atomic[u64].of(0u64);      // bit i: worker i ran a pass; bit 63: a thread that is no worker
  imm out = new List[u64] <- parallel each i in 0usize < 400usize yield threadBit(i, &ran);
  mut inorder = out.len() == 400usize;
  mut k = 0usize;
  while k < out.len() {
    if *out[k] != u64.from(k) { inorder = false; }
    k = k + 1usize;
  }
  report("spread: every pass ran, in order", inorder);
  report("spread: more than one thread ran passes", bits(ran.load()) >= 2u64);
}

fn main() {
  initAll();
  actors.configure(new actors.Options(workers: 4u32));

  ranges();
  sources();
  filters();
  moving();
  forms();
  changing();
  places();
  spread();
  finalAll();
}
