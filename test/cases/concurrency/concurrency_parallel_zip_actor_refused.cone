// What a 'parallel each' over a zip refuses in an actor's behaviour, by the rule a
// parallel each there already keeps (concurrency_parallel_each_actor_refused): the
// behaviour returns to its dispatcher while the pieces run, so a list or an array in
// one of its locals, which the cursors of the zip borrow from, is gone by then. A
// zip reaches every source it was given, not the first alone: a field beside a
// local is refused for the local. (A zip of fields through 'self' is fine:
// concurrency_parallel_zip_actor.)

mod concurrency_parallel_zip_actor_refused;

import collections use *;
import actors;

actor Holder {
  items List[u64];
  total Atomic[u64];

  fn init(self &new) {
    *self = new Self(items: new List[u64], total: Atomic[u64].of(0u64));
  }

  // Both sources in locals
  pub async do localLists(self) {
    mut a = new List[u64];
    mut b = new List[u64];
    a.push(1u64);
    b.push(2u64);
    parallel each x, y in zip(&a, &b) {                  //~ ErrorParFrame "lies in the behaviour's own frame"
      total.add(*x + *y);
    }
  }

  // The second source in a local
  pub async do oneLocal(self) {
    mut b = new List[u64];
    b.push(2u64);
    parallel each x, y in items.chunks(1usize).zip(b.chunks(1usize)) {   //~ ErrorParFrame "lies in the behaviour's own frame"
      total.add(u64.from(y.len));
    }
  }

  // The third source of a three-way zip in a local
  pub async do thirdLocal(self) {
    mut c = new List[u64];
    c.push(2u64);
    parallel each x, y, z in items.chunks(1usize).zip(items.chunks(2usize)).zip(c.chunks(1usize)) {   //~ ErrorParFrame "lies in the behaviour's own frame"
      total.add(u64.from(z.len));
    }
  }

  // Allowed: all in the actor's own fields
  pub async do fine(self) {
    parallel each x, y in items.chunks(2usize).zip(items.chunks(3usize)) {
      total.add(u64.from(x.len + y.len));
    }
    parallel each x, y, z in items.chunks(2usize).zip(items.chunks(3usize)).zip(items.chunks(4usize)) {
      total.add(u64.from(x.len + y.len + z.len));
    }
  }
}
