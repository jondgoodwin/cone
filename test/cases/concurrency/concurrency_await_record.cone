// What a seam moves into its continuation's record (actor-continuations, the
// seam's step 3): every value used after the 'await', plus every droppable
// still holding its value, used again or not. A dead variable with nothing to
// do as it dies is left behind. Each 'await' is on a plain function, which
// waits for no answer, so each is refused (ErrorAwaitNotFuture), the message
// naming the record its seam would have, and these pin its parts one at a
// time:
//
// - travels: a droppable never named after the seam is in the record;
// - leftBehind: a number not named after the seam is not, beside one that is;
// - moved: a droppable moved out before the seam holds nothing to carry;
// - assignedFirst: a number stored over whole after the seam before any use
//   was dead there; one read on one path only is live (the loan walk's paths
//   decide, as for a frozen borrow's last use);
// - inLoop: a number read on a loop's next pass is live at the seam;
// - initializer: the local whose initializer holds the 'await' holds nothing
//   yet.
//
// The record's order of death is concurrency_await_droporder's. 'self' is not
// in the record: the dispatcher lends it afresh to what follows the seam.

mod concurrency_await_record;

import actors;

struct Fin {
  pub n: u64;
  fn final(self: &uni) {}
}

fn give() u64 {5u64}
fn tick() {}
fn keep(f: Fin) {}

actor Page {
  body: u64;

  pub async do travels(self) {
    let f = Fin(1u64);
    await tick();     //~ ErrorAwaitNotFuture "move into the continuation's record [f]"
  }

  pub async do leftBehind(self) {
    let used = 3u64;
    let unused = 4u64;
    await tick();     //~ ErrorAwaitNotFuture "move into the continuation's record [used], finalized as if the method were not cut, in the order []; and leave behind [unused]"
    body = used;
  }

  pub async do moved(self) {
    let f = Fin(1u64);
    keep(f);
    await tick();     //~ ErrorAwaitNotFuture "move into the continuation's record [], finalized as if the method were not cut, in the order []; and leave behind []"
  }

  pub async do assignedFirst(self, c: bool) {
    let a = 1u64;
    var b = 2u64;
    await tick();     //~ ErrorAwaitNotFuture "move into the continuation's record [c, a], finalized as if the method were not cut, in the order []; and leave behind [b]"
    if c {
      body = a;
    }
    else {
      b = 4u64;
      body = b;
    }
  }

  pub async do inLoop(self) {
    var i = 0u64;
    let step = 2u64;
    while i < 9u64 {
      await tick();   //~ ErrorAwaitNotFuture "move into the continuation's record [i, step]"
      i = i + step;
    }
  }

  pub async do initializer(self) {
    let n = 2u64;
    let m = await give();  //~ ErrorAwaitNotFuture "move into the continuation's record [], finalized as if the method were not cut, in the order []; and leave behind [n]"
    body = m;
  }
}
