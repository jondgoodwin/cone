// A reader's own dropped Result is still warned inside an actor: the
// 'ignored' behaviour calls 'check' and drops the answer (WarnDiscard), while
// 'price' itself, whose reply the compiler's dispatch code sends, draws
// nothing (concurrency_behaviour_result_nowarn).

mod concurrency_behaviour_result_dropped;

import actors;

fn check(n: u32) Result[u32, u32] {
  if n == 0u32 {Err[u32, u32](7u32)} else {Ok[u32, u32](n)}
}

actor Shop {
  pub async fn price(self, n: u32) Result[u32, u32] {
    if n == 0u32 {Err[u32, u32](7u32)} else {Ok[u32, u32](n * 2u32)}
  }

  pub async fn ignored(self) {
    check(1u32);                      //~ WarnDiscard:10 "is thrown away"
  }
}
