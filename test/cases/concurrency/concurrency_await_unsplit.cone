// Where an 'await' is still not built under '--await-direct', which splits a
// behaviour holding one (concurrency_await_split): each is ErrorUnbuiltAwait
// at the 'await'. (An 'await' in a synchronous 'fn' of the actor is refused
// where it stands, at type check: concurrency_await_place.) Where an 'await'
// cuts inside an expression the rest of the statement runs after the seam
// (concurrency_await_expr, and concurrency_await_places for a place indexed
// more than once, both sides of a swap, a slice's bounds, a parallel
// assignment's places and the entries of a '<-'), with these left:
//
// - an 'await' in the index of a place whose base holds an 'await' of its
//   own that no index made: the base is an expression, made after the index;
// - an 'await' among the entries one '<-' appends that repeat a value, fill or
//   loop: the receiver is borrowed once for all of them, and the value is made
//   again for each, past the seam;
// - an 'await' in an array's contents that repeat a value past the copies
//   written out (ArrayRepeatUnroll, 16), which are filled in memory in a loop,
//   the value made once for each element. (Sixteen or fewer are each a copy
//   of the value, listed, and split as any operand is.)
//
// The behaviour beside them, whose 'await' stands where the split is built,
// reports nothing.

mod concurrency_await_unsplit;

import actors;
import collections use List;

struct Box {
  pub items Array[u64, 4];
}

fn give() u64 {1u64;}
fn box() Box {new Box([1u64, 2u64, 3u64, 4u64]);}

actor Page {
  body u64;
  items Array[u64, 4];

  pub async do message(self) {
    body = await give() + 1u64;
    items[await give()] = 7u64;
    body = items[await give()] + items[await give()];
    items[await give()] <=> items[await give()];
  }

  pub async do based(self) {
    body = (await box()).items[await give()];  //~ ErrorUnbuiltAwait "it stands in the index of a place whose base holds an 'await' too"
  }

  pub async do repeated(self) {
    mut v = List[u64].empty();
    v <- 3 of await give();  //~ ErrorUnbuiltAwait "it stands among the entries a '<-' appends, whose receiver is borrowed once for all of them and would be held across the seam"
    body = v.len();
  }

  pub async do filled(self) {
    imm a = new Array[u64, 20] <- fill await give();  //~ ErrorUnbuiltAwait "it stands in an array's contents that repeat a value or fill a size"
    body = a[0];
  }
}
