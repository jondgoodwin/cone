// Two actors play ping-pong with a million messages, each one a ball the
// other sent. Ball n goes to 'ping' when n is even and to 'pong' when it is
// odd, so each player sees every second number, in the order they were sent,
// and checks it. The player that receives the last ball tells the other to
// leave; each then lets go of its handle to the other, so both die once main
// has let go of its own. Nothing tells the runtime the game is over:
// finalAll() runs the actors module's finalizer, which waits until no actor
// is active and no message is in flight, then stops the workers; main then
// prints what the players' finalizers recorded.
//
// The actor is declared: its fields are its state, 'new Player(first)' runs
// its 'init' on fresh state and answers its handle, and each 'pub' method is
// a message the handle sends. A message carries a handle (meet's 'p'), and the
// state holds one, of the actor's own kind.

mod concurrency_actors_pingpong;

import stdio use *;
import actors;

const balls = 1000000u64;

// What the players' finalizers leave for main to print
struct Results {
  pub seen Atomic[u64];
  pub disorder Atomic[u64];
  pub finals Atomic[u64];
}

imm results Results;

fn @initpure init() {
  results = new Results(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

actor Player {
  peer Option[Player];
  seen u64;
  expect u64;
  disorder u64;

  fn init(self &new, first u64) {
    *self = new Self(peer: None[Player][], seen: 0u64, expect: first, disorder: 0u64);
  }

  pub fn meet(self, p Player) {
    peer = Some[Player][p];
  }

  pub fn ball(self, n u64) {
    if n != expect {
      disorder = disorder + 1u64;
    }
    expect = n + 2u64;
    seen = seen + 1u64;
    match peer {
      case imm p Some {
        if n + 1u64 < balls {
          p.value.ball(n + 1u64);
        } else {
          p.value.leave();
        }
      }
      case is None[Player] {}
    }
    if n + 1u64 == balls {
      peer = None[Player][];
    }
  }

  pub fn leave(self) {
    peer = None[Player][];
  }

  fn final(self &uni) {
    results.seen.add(seen);
    results.disorder.add(disorder);
    results.finals.add(1u64);
  }
}

fn main() {
  initAll();
  {
    imm ping = new Player(0u64);
    imm pong = new Player(1u64);
    ping.meet(pong);
    pong.meet(ping);
    ping.ball(0u64);
  }
  finalAll();
  printStr("balls seen "); printUInt(results.seen.load()); printStr("\n");
  printStr("out of order "); printUInt(results.disorder.load()); printStr("\n");
  printStr("players finalized "); printUInt(results.finals.load()); printStr("\n");
  printStr("messages handled "); printUInt(actors.stats().messages); printStr("\n");
}
