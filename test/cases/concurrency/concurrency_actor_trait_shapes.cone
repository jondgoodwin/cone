// What a trait's behaviour may take and return is what an actor's may: a
// default for a parameter (the trait's own, written where the call is, as the
// actor's handle's is), and a returned tuple, awaited through the handle. The
// totals are worked out by hand: Impl starts at 10, is bumped by the default
// 1 and then by 5, so 16; 'pair(1)' answers (16 + 1, the default scale 3) and
// 'pair(2, 7)' answers (16 + 2, 7).

mod concurrency_actor_trait_shapes;

import stdio use *;
import actors;

actor trait Odd {
  pub async fn pair(self, k: u64, scale: u64 = 3u64) (u64, u64);
  pub async fn bump(self, amt: u64 = 1u64);
}

actor Impl {
  n: u64;

  fn init(self: &new) {
    *self = Self(n: 10u64);
  }

  pub async fn pair(self, k: u64, scale: u64 = 3u64) (u64, u64) {
    (n + k, scale)
  }

  pub async fn bump(self, amt: u64 = 1u64) {
    n = n + amt;
  }
}

actor Asker {
  pub async fn go(self, o: Odd) {
    o.bump();
    o.bump(5u64);
    let p = await o.pair(1u64);
    let q = await o.pair(2u64, 7u64);
    printStr("p "); printUInt(p.0); printStr(" "); printUInt(p.1);
    printStr(" q "); printUInt(q.0); printStr(" "); printUInt(q.1); printStr("\n");
  }
}

fn main() {
  initAll();
  {
    let i = Impl();
    let a = Asker();
    a.go(i);
  }
  finalAll();
}
