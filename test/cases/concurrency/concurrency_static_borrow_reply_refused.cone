// What a behaviour's reply may not carry, though it writes the borrow
// ''static', refused at the return type once the types are known
// (ErrorNotSendable), each saying which part of the rule failed, as for a
// message's parameters (concurrency_static_borrow_actor_refused):
//
// - a permission that is not 'imm', 'opaq' or 'uni': 'ro' and 'mut';
// - what an 'imm' borrow reaches must be safe to read from two threads: an
//   'Rc' is not, nor is a struct holding one;
// - a borrow inside the reply must be written ''static' too: a struct
//   holding a 'ro' one is refused;
// - a borrow not written ''static' at all.
// A behaviour that takes what it replies with is refused at its parameter
// too, which the second annotation on those lines is.
// (A lifetime of any other name is refused at parse:
// concurrency_static_borrow_actor_parse.)

mod concurrency_static_borrow_reply_refused;

import actors;
import sync use *;

imm seed u64 = 7u64;
mut count u64 = 0u64;

struct Point {pub x i32; pub y i32;}

// Holds an owner whose count is not atomic
struct Counted {pub r Rc[imm, Point];}

// Holds a 'ro' borrow of the whole program
struct Reads {pub p &'static Point;}

actor Bad {
  total u64;

  pub async do reads(self) &'static u64 {                //~ ErrorNotSendable "a borrowed reference of permission ro"
    &seed;
  }
  pub async do writes(self) &'static mut u64 {           //~ ErrorNotSendable "a borrowed reference of permission mut"
    &mut count;
  }
  pub async do counted(self, c &'static imm Counted) &'static imm Counted {   //~ ErrorNotSendable "Actor Bad's behaviour counted takes c"
                                                         //~^ ErrorNotSendable "Actor Bad's behaviour counted returns a &imm Counted, which is not Sendable: Counted.r is Rc[imm, Point], an owner that may be copied"
    c;
  }
  pub async do rc(self, c &'static imm Rc[imm, Point]) &'static imm Rc[imm, Point] {  //~ ErrorNotSendable "Actor Bad's behaviour rc takes c"
                                                         //~^ ErrorNotSendable "returns a &imm Rc[imm, Point], which is not Sendable: what the borrow points at is Rc[imm, Point]"
    c;
  }
  pub async do holds(self, r Reads) Reads {              //~ ErrorNotSendable "Actor Bad's behaviour holds takes r"
                                                         //~^ ErrorNotSendable "Actor Bad's behaviour holds returns a Reads, which is not Sendable: Reads.p is &ro Point, a borrowed reference of permission ro"
    r;
  }
  pub async do unwritten(self) &imm u64 {                //~ ErrorNotSendable "a borrowed reference not written 'static"
    &imm seed;
  }
  pub async do fine(self) &'static imm u64 {
    &imm seed;
  }
}

fn main() {}
