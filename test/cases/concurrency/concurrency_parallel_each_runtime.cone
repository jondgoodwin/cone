// A 'parallel each' runs its passes on the actors package's workers, so the
// module it is written in must import the package: this one does not, and the
// loop is refused where it is written, the message saying what to add. (Every
// other scenario of 'parallel each' imports actors.)

mod concurrency_parallel_each_runtime;

fn total(xs &Array[u64]) u64 {
  parallel each x in xs {          //~ ErrorParRuntime "write 'import actors;'"
  }
  0u64;
}
