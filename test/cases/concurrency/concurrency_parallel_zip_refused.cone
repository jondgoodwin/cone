// What a 'parallel each' over a zip refuses. A zip is walked by position, so BOTH
// its sources must report their size and give item k (core's RandomAccess) and be
// cut (ParallelIterable): a cursor that hands its items out one after another (a
// Deque's, a type's own with a 'next', a generator) cannot, and the message says
// to collect it into a list first. The body rules of every parallel each stand: the
// buffers the zip lends from may not be named in the body (the passes write their
// own parts of them at the same time; the rule is for both sources, though only
// one may be mutable), an outside variable is not written, a chunk that 'chunks'
// gives is read-only. And a zip gives two variables (three with 'indexed()'), the
// source of the zip not otherwise.

mod concurrency_parallel_zip_refused;

import collections use *;
import actors;

struct Countdown {
  n u32;

  pub fn next(self &mut) Option[u32] {
    if n == 0u32 { return None[u32][]; }
    n = n - 1u32;
    Some[u32][n];
  }
}

fn countUp(n u32) yields u32 {
  yield n;
}

// A source that cannot be cut or walked by position
fn cannotSplit(a &mut List[u32], d &Deque[u32], l &List[u32]) {
  parallel each x, y in a.mutChunks(2usize).zip(d.items()) {         //~ ErrorParSource "needs every source of the zip to report its size"
  }
  parallel each x, y in zip(d, l) {                                  //~ ErrorParSource "needs every source of the zip to report its size"
  }
  parallel each x, y in l.chunks(2usize).zip(new Countdown(5u32)) {  //~ ErrorParSource "needs every source of the zip to report its size"
  }
  parallel each x, y in a.mutItems().zip(countUp(3u32)) {            //~ ErrorParSource "needs every source of the zip to report its size"
  }
}

// Naming a buffer the zip lends from, whichever source it is
fn namesTheBuffer(a &mut List[u32], b &List[u32]) {
  parallel each ra, rb in a.mutChunks(2usize).zip(b.chunks(3usize)) {
    ra[0usize] = *a[0usize];                //~ ErrorParWrite "may not name a"
    ra[1usize] = *b[0usize];                //~ ErrorParWrite "may not name b"
  }
}

// A chunk 'chunks' gives is read-only
fn writesARead(a &mut List[u32], b &List[u32]) {
  parallel each ra, rb in a.mutChunks(2usize).zip(b.chunks(3usize)) {
    rb[0usize] = 1u32;                      //~ ErrorNoMut
  }
}

// An outside variable is not written
fn writesOutside(a &mut List[u32], b &mut List[u32]) {
  mut count = 0usize;
  parallel each ra, rb in a.mutChunks(2usize).zip(b.mutChunks(3usize)) {
    count = count + 1usize;                 //~ ErrorParWrite "may not write count"
  }
}

// How many variables
fn oneVariable(a &mut List[u32], b &mut List[u32]) {
  parallel each pair in a.mutChunks(2usize).zip(b.mutChunks(3usize)) {      //~ ErrorParSource "gives two variables, one item from each source"
  }
}

fn twoWithIndexed(a &mut List[u32], b &mut List[u32]) {
  parallel each y, pair in a.mutChunks(2usize).zip(b.mutChunks(3usize)).indexed() {   //~ ErrorParSource "gives three variables"
  }
}

fn threeWithoutIndexed(a &mut List[u32], b &mut List[u32]) {
  parallel each y, ra, rb in a.mutChunks(2usize).zip(b.mutChunks(3usize)) {   //~ ErrorParSource "gives two variables, one item from each source"
  }
}
