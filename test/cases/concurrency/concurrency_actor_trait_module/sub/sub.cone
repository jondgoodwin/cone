// The actor trait, 'pub', and an actor that conforms to it without naming it.

mod sub;

import actors;

pub struct Chunk is Sendable {
  pub n: u64;
}

pub actor trait ChunkSink {
  pub async fn accept(self, c: Chunk);
  pub async fn total(self) u64;
}

pub actor Counter {
  sum: u64;

  pub fn init(self: &new) {*self = Self(sum: 0u64);}

  pub async fn accept(self, c: Chunk) {sum = sum + c.n;}

  pub async fn total(self) u64 {sum}
}

pub fn feed(s: ChunkSink, n: u64) {
  s.accept(Chunk(n));
}
