// A float 'fold' gives the same bits on every run and with any number of workers,
// as a float 'sum' does (the blocks are cut by the item count alone and joined by a
// tree fixed by the block count). This scenario runs on four workers; the bits
// printed below were measured on 1, 2, 3, 8 and 16 workers and are the same, and
// the package test of actors (parallelreduce) pins the same values on one worker.
//
//   - a f64 fold of squares of 100,000 items, 30 runs, the same bits
//   - a f32 fold of 70,001 items (a block count that is not a power of two)
//   - the f64 fold equals the serial fixed tree the test computes itself
//   - a float sum of a mixed-sign list, whose order of addition matters most

mod concurrency_parallel_reduce_floatfold;

import stdio use *;
import collections use *;
import actors;

fn report(name &str, ok bool) {
  printStr(name);
  printStr(if ok {": ok\n"} else {": FAILED\n"});
}

fn bitsOf(x f64) u64 {
  var c = x;
  mem.readRaw[u64](&mut c as *f64 as *u64)
}

fn bitsOf32(x f32) u64 {
  var c = x;
  u64.from(mem.readRaw[u32](&mut c as *f32 as *u32))
}

// The same blocks and tree, one thread: a block is n / blocks items rounded up
// (the blocks n / 128 rounded up, at most 256), each folded from 0 front to
// back, and joined by halving, the left total plus the right
fn blockSquares(l &List[f64], lo usize, hi usize) f64 {
  var s = 0.0;
  var k = lo;
  while k < hi {
    s = s + l[k] * l[k];
    k = k + 1usize;
  }
  s
}

fn treeSquares(l &List[f64], blk usize, b0 usize, b1 usize) f64 {
  if b1 - b0 == 1usize {
    let lo = b0 * blk;
    let end = lo + blk;
    return blockSquares(l, lo, if end < l.len() { end } else { l.len() });
  }
  let mid = b0 + (b1 - b0) / 2usize;
  treeSquares(l, blk, b0, mid) + treeSquares(l, blk, mid, b1)
}

fn main() {
  actors.configure(new actors.Options(workers: 4u32));
  var h = new List[f64]();
  var k = 0usize;
  while k < 100000usize {
    h.push(1.0 / (f64.from(k) + 1.0));
    k = k + 1usize;
  }
  let first = h.parallel().fold(0.0, (acc, x) => acc + *x * *x, (a, b) => a + b);
  var same = true;
  var run = 0usize;
  while run < 30usize {
    if bitsOf(h.parallel().fold(0.0, (acc, x) => acc + *x * *x, (a, b) => a + b)) != bitsOf(first) {
      same = false;
    }
    run = run + 1usize;
  }
  report("f64 fold, 30 runs, the same bits", same);
  // 100,000 items: 782 blocks of 128 capped at 256, of 391 items; the last holds 295
  let tree = treeSquares(&h, 391usize, 0usize, 256usize);
  report("f64 fold is the fixed tree's", bitsOf(first) == bitsOf(tree));
  printStr("f64 fold bits ");
  printUInt(bitsOf(first));
  printStr("\n");

  var g = new List[f32]();
  k = 0usize;
  while k < 70001usize {
    g.push(1.0 / (f32.from(k) + 1.0));
    k = k + 1usize;
  }
  let r = g.parallel().fold(0.0f, (acc, x) => acc + *x, (a, b) => a + b);
  printStr("f32 fold bits ");
  printUInt(bitsOf32(r));
  printStr("\n");

  // Mixed signs: large terms cancel, so the result depends on the order of addition
  var m = new List[f64]();
  k = 0usize;
  while k < 50000usize {
    let v = 1.0 / (f64.from(k) + 1.0);
    m.push(if k % 2usize == 0usize { v * 1.0e8 } else { -v * 1.0e8 + 1.0 / 3.0 });
    k = k + 1usize;
  }
  let ms = m.parallel().sum();
  var stable = true;
  run = 0usize;
  while run < 30usize {
    if bitsOf(m.parallel().sum()) != bitsOf(ms) {
      stable = false;
    }
    run = run + 1usize;
  }
  report("mixed-sign sum, 30 runs, the same bits", stable);
  printStr("mixed-sign sum bits ");
  printUInt(bitsOf(ms));
  printStr("\n");
  finalAll();
}
