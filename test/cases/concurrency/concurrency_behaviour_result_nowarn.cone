// A behaviour that answers a Result: the dispatch code the compiler writes
// replies with the Result, it does not throw it away, so compiling the actor
// draws no WarnDiscard. (concurrency_behaviour_result_dropped pins that a
// reader's own dropped Result still warns.)

mod concurrency_behaviour_result_nowarn;

import stdio use *;
import actors;

actor Shop {
  pub async fn price(self, n: u32) Result[u64, u32] {
    if n == 0u32 {Err[u64, u32](7u32)} else {Ok[u64, u32](8u64)}
  }

  // Awaited, the Result goes back in the reply
  pub async fn report(self) {
    match await self.price(4u32) {
      case let Ok(v) {printStr("price "); printUInt(v); printStr("\n");}
      else {printStr("failed\n");}
    }
  }
}

fn main() {
  let s = Shop();
  s.report();
  finalAll();
}
