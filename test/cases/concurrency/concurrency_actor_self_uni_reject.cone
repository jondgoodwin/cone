// A behaviour's bare 'self' is '&uni', so a borrow of the state made before an
// 'await' is ended by the seam, as with any 'self' (ErrorFrozen, the borrow named
// after the 'await'). (A behaviour's 'self: &new' is refused in
// concurrency_actor_parse.)

mod concurrency_actor_self_uni_reject;

import actors;

fn give() u64 {5u64}

actor Held {
  total: u64;

  pub async fn peek(self) u64 { total }

  pub async fn seam(self) {
    let r = &uni self.total;
    await give();                       //~ ErrorFrozen "The borrow 'r' holds of '*self'"
    *r = 3u64;
  }
}
