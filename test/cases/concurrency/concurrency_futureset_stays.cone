// A FutureSet stays in the actor that made it: its queue has no lock, because
// every arrival is appended by that actor's own thread. So it is not Sendable,
// and no message may carry one, to another actor or to itself.

mod concurrency_futureset_stays;

import actors;

actor Taker {
  pub async fn take(self, s: actors.FutureSet[u64]) {}   //~ ErrorNotSendable "FutureSet"
}

fn main() {}
