// The ordering of a LatestCell's shared words, read in the IR (sync.cone's cellStore
// and cellLoad). Every word a writer's put stores (the seq words, the length, the
// time, the data words, and 'latest') goes through cellStore, a release store; every
// word a reader's readNewer loads goes through cellLoad, an acquire load. A plain
// store or load in place of either cannot be caught by a run on x86, so the scenario
// pins the instruction.

mod concurrency_latestcell_orderings;

import sync use *;
import collections use List;

fn main() {
  var w, r = latestCell(16usize);
  var data = List[u8]();
  data.push(7u8);
  data.push(9u8);
  w.put(data.view());
  var out = List[u8]();
  var i = 0usize;
  while i < 16usize {
    out.push(0u8);
    i = i + 1usize;
  }
  r.readNewer(0u64, out.viewMut());
}
