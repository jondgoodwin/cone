// A future whose callee dies without answering is Abandoned, and an 'await'
// on it panics, reported at the 'await'. Stuck's 'count' awaits an operation
// that drops its envelope unanswered, so 'count' stays parked; when Stuck's
// last handle goes, Stuck dies, its parked record is dropped, and with it the
// future's producer's reference, which abandons the future. Asker awaits the
// future: parked on it, it is woken and the panic comes when it resumes;
// arriving later, it sees it at once. Either way the panic is the same, at
// the 'await''s line, naming the request (the program's first future).

mod concurrency_future_abandoned;

import stdio use *;
import actors;

fn startNever(ctx *u8, rp actors.Reply) {}
fn dropNever(ctx *u8) {}
fn never() actors.Awaitable[u64] {
  actors.Awaitable[u64].make(1usize as *u8, &startNever, &dropNever);
}

actor Stuck {
  pub async do count(self) u64 {
    imm n = await never();
    n;
  }
}

actor Asker {
  pub async do collect(self, f actors.Future[u64]) {
    printStr("awaiting\n");
    imm n = await f;
    printStr("never printed\n");
  }
}

fn main() {
  initAll();
  {
    imm a = new Asker();
    {
      imm s = new Stuck();
      imm f = s.count();
      a.collect(f);
    }
  }
  finalAll();
}
