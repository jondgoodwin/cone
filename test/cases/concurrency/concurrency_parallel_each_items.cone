// A 'parallel each' that changes its items, and one with a filter: the items
// are lent to the passes, each pass changing only its own (the items are
// disjoint), by 'mutItems()' on a list, an array or a slice, or a mutable slice
// as the source itself. The body may not name the place the items are lent from
// as well (concurrency_parallel_each_refused), since '&mut' is shared in Cone
// and another pass may be changing the item it would read; a field of a struct
// the items are not in is free to read.
//
// Each case is checked against a plain loop doing the same to a copy of the
// numbers.
//
//   - a list's mutItems, an array's, a slice's (a parameter), a mutable slice
//     passed to the loop as the source
//   - a list of structs, a field of each changed through the pass's variable
//   - uneven work; an empty list
//   - fields of 'self' read in a method whose own list the loop changes
//   - the header filter, 'if', over a list, an array and a number range, and a
//     filter that is never true

mod concurrency_parallel_each_items;

import stdio use *;
import collections use *;
import actors;

fn mix(i u64, n u64) u64 {
  mut x = i + 1u64;
  mut k = 0u64;
  while k < n {
    x = x * 6364136223846793005u64 + k;
    k = k + 1u64;
  }
  x;
}

fn weigh(i u64) u64 {
  mix(i, (i * i) % 97u64 * 40u64);
}

fn report(name &str, ok bool) {
  printStr(name);
  printStr(if ok {": ok\n";} else {": FAILED\n";});
}

struct Body {
  x u64;
  y u64;
}

struct World {
  scale u64;
  bodies List[Body];

  pub fn step(self &mut) {
    parallel each b in bodies.mutItems() {
      b.x = b.x * scale;                // scale is read; bodies is the loop's
      b.y = b.y + scale;
    }
  }
}

fn doubleSlice(s &mut Array[u64]) {
  parallel each x in s.mutItems() {
    *x = *x * 2u64 + weigh(*x) % 10u64;
  }
}

fn asSource(s &mut Array[u64]) {
  parallel each x in s {                // a mutable slice lends its items to change
    *x = *x + 100u64;
  }
}

fn main() {
  initAll();
  actors.configure(new actors.Options(workers: 4u32));

  // A list, uneven work
  mut l = new List[u64];
  mut plain = new List[u64];
  mut i = 0u64;
  while i < 3000u64 {
    l.push(i);
    plain.push(i);
    i = i + 1u64;
  }
  parallel each x in l.mutItems() {
    *x = weigh(*x) % 1000003u64;
  }
  mut want = true;
  mut k = 0usize;
  while k < plain.len {
    if *l[k] != weigh(*plain[k]) % 1000003u64 {
      want = false;
    }
    k = k + 1usize;
  }
  report("a list changed in place, item by item", want and l.len == 3000usize);

  // An array
  mut arr = [1u64, 2u64, 3u64, 4u64, 5u64, 6u64];
  parallel each x in arr.mutItems() {
    *x = *x * *x;
  }
  report("an array changed in place", arr[0usize] == 1u64 and arr[2usize] == 9u64 and arr[5usize] == 36u64);

  // A slice, as a parameter, and mutable as the source itself
  mut nums = [5u64, 6u64, 7u64, 8u64];
  doubleSlice(&mut nums);
  report("a slice's mutItems", nums[0usize] == 10u64 + weigh(5u64) % 10u64 and nums[3usize] == 16u64 + weigh(8u64) % 10u64);
  asSource(&mut nums);
  report("a mutable slice as the source", nums[0usize] == 110u64 + weigh(5u64) % 10u64);

  // Structs, a field of each
  mut world = new World(3u64, new List[Body]);
  mut j = 0u64;
  while j < 500u64 {
    world.bodies.push(new Body(j, 0u64));
    j = j + 1u64;
  }
  world.step();
  world.step();
  mut bodiesOk = true;
  mut b = 0usize;
  while b < world.bodies.len {
    imm body = world.bodies[b];
    if body.x != u64.from(b) * 9u64 or body.y != 6u64 {
      bodiesOk = false;
    }
    b = b + 1usize;
  }
  report("a list of structs, a field changed, scale read through self", bodiesOk);

  // Nothing to change
  mut empty = new List[u64];
  parallel each x in empty.mutItems() {
    *x = 1u64;
  }
  report("an empty list: no pass", empty.len == 0usize);

  // The header filter
  imm odds = Atomic[u64].of(0u64);
  imm evens = Atomic[u64].of(0u64);
  imm values = [1u64, 2u64, 3u64, 4u64, 5u64, 6u64, 7u64, 8u64, 9u64, 10u64];
  parallel each x in values if *x % 2u64 == 1u64 {
    odds.add(*x);
  }
  parallel each x in values if *x % 2u64 == 0u64 {
    evens.add(*x);
  }
  report("a filter over an array", odds.load() == 25u64 and evens.load() == 30u64);

  imm tens = Atomic[u64].of(0u64);
  parallel each n in 0usize < 100usize if n % 10usize == 0usize {
    tens.add(u64.from(n));
  }
  report("a filter over a range", tens.load() == 450u64);

  imm none = Atomic[u64].of(0u64);
  parallel each x in values if *x > 100u64 {
    none.add(1u64);
  }
  report("a filter that is never true", none.load() == 0u64);

  imm filtered = Atomic[u64].of(0u64);
  parallel each x in l if *x % 2u64 == 0u64 {
    filtered.add(1u64);
  }
  mut count = 0u64;
  each x in l {
    if *x % 2u64 == 0u64 {
      count = count + 1u64;
    }
  }
  report("a filter over a list of uneven work", filtered.load() == count);

  finalAll();
}
