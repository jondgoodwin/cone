// What a 'parallel each' body may do with a counted owner (concurrency_parallel_each_reach
// is what it may not). A body may not name a value from outside whose type holds an
// 'Rc' (or a traced reference): its passes run at the same time, and a copy made
// anywhere they reach it writes a count they share. The way through is to borrow
// the contents before the loop ('imm n = &*shared;') and use the borrow in the body:
// a number is safe to share. What the loop may also do: copy an 'Arc', whose count
// is atomic, and make an 'Rc' of its own and copy that.
//
// Four workers run each loop. Every number is worked out by hand.

mod concurrency_parallel_each_counted;

import stdio use *;
import collections use *;
import sync use *;
import actors;

struct Holder {
  shared Rc[imm, u64];
  n u64;
}

fn peek(r &u64) u64 { *r; }

fn report(name &str, ok bool) {
  printStr(name);
  printStr(if ok {": ok\n";} else {": FAILED\n";});
}

fn main() {
  initAll();
  actors.configure(new actors.Options(workers: 4u32));

  imm shared = new Rc[imm, u64](7u64);
  imm holder = new Holder(new Rc[imm, u64](3u64), 10u64);
  mut list = new List[u64];
  mut k = 0u64;
  while k < 200u64 {
    list.push(k);
    k = k + 1u64;
  }

  // The contents borrowed before the loop, which the body uses
  imm sv = &*shared;
  imm hv = &*holder.shared;
  imm hn = holder.n;
  imm total = Atomic[u64].of(0u64);
  parallel each i in 0usize < 1000usize {
    total.add(*sv);                                // read by the borrow
    total.add(peek(sv));                           // lent to a function
    total.add(*hv + hn);                           // a struct's Rc by its borrow, a number beside it
  }
  report("the contents of an Rc, borrowed before the loop", total.load() == 1000u64 * (7u64 + 7u64 + 3u64 + 10u64));

  imm items = Atomic[u64].of(0u64);
  parallel each r in list {
    items.add(*r);                                 // a number, through the pass's borrow
  }
  report("a list of numbers read through the pass's borrow", items.load() == 199u64 * 200u64 / 2u64);

  imm arc = new Arc[imm, u64](5u64);
  imm viaArc = Atomic[u64].of(0u64);
  parallel each i in 0usize < 1000usize {
    imm mine = arc;                                // an Arc is copied atomically
    viaArc.add(*mine);
  }
  report("an Arc copied in the body", viaArc.load() == 5000u64);

  imm own = Atomic[u64].of(0u64);
  parallel each i in 0usize < 1000usize {
    imm made = new Rc[imm, u64](u64.from(i));      // the pass's own Rc,
    imm again = made;                              // and a copy of it
    own.add(*again);
  }
  report("an Rc the pass makes, and copies", own.load() == 999u64 * 1000u64 / 2u64);

  finalAll();
}
