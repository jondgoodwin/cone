// What an actor's behaviour or initializer may take as a borrow of the whole
// program is a borrow written ''static': '&'static imm T', '&'static opaq T'
// or '&'static uni T' (concurrency_static_borrow_send). A borrow not written
// so is refused where it is written, at parse, as it always was
// (ErrorNotSendable), and so is a lifetime of any other name, which no
// message carries. A behaviour's reply is held to the same: it may name
// ''static' (concurrency_static_borrow_reply) and no other lifetime, an
// invariant one included.
//
// Which permission and what it reaches are the thread check's, judged once the
// types are known (concurrency_static_borrow_actor_refused).

mod concurrency_static_borrow_actor_parse;

import actors;

actor Bad {
  total: u64;

  fn init(self: &new, p: &u64) {            //~ ErrorNotSendable "Actor Bad's initializer init takes p, a borrowed reference, which is not Sendable"
    *self = Self(total: *p);
  }

  pub async fn plain(self, p: &imm u64) {}     //~ ErrorNotSendable "Actor Bad's behaviour plain takes p, a borrowed reference, which is not Sendable"
  pub async fn named(self, p: &'a imm u64) {}  //~ ErrorNotSendable "Actor Bad's behaviour named takes p, a borrowed reference, which is not Sendable"
  pub async fn nested(self, p: Option[&'a imm u64]) {}  //~ ErrorNotSendable "Actor Bad's behaviour nested takes p, a borrowed reference"
  pub async fn inside(self, p: Option[&'static imm u64]) {}  // 'static inside: a type is the language's own rule (ErrorLifetimePlace), judged after parse
  pub async fn reply(self) &'a imm u64 {  //~ ErrorNotSendable "Actor Bad's behaviour reply returns a type naming a lifetime other than 'static"
    &imm total
  }
  pub async fn brand(self) &'=a imm u64 {  //~ ErrorNotSendable "returns a type naming a lifetime other than 'static"
    &imm total
  }
  pub async fn kept(self) Option[&'a imm u64] {  //~ ErrorNotSendable "returns a type naming a lifetime other than 'static"
    None[&imm u64]
  }
  pub async fn offered(self, p: &'static imm u64) {}
}

fn main() {}
