// What type check refuses of an actor, at the line the author wrote.
//
// - Its state is private to it: a field reached through the handle, and a
//   synchronous method ('fn'), which runs inside the actor alone, are
//   ErrorNotPublic. The handle carries the behaviours and nothing else.
// - Every argument a behaviour carries, and every argument its 'init' makes
//   the state from, crosses to the thread the actor runs on, so must be
//   Sendable, as a channel's element or a thread's start value must: refused
//   at the parameter, saying what binds it to its thread. What may not leave
//   its thread may still be the state's own (concurrency_actors_rcstate), and
//   a handle crosses (the lines without annotations).
// - 'self.note(n)', note a behaviour, is a send to the actor itself
//   (concurrency_actor_selfsend runs it). Where there is no actor to send to
//   it is ErrorBehaviourSend: in the 'init', which runs before the actor
//   exists, in the 'final', as it dies, and through a state that is not the
//   method's own 'self' -- one made with 'new Self(...)' is in no actor.

mod concurrency_actor_typecheck;

import actors;

struct Log {pub n u64;}

actor Keeper {
  count u64;
  log Rc[mut, Log];

  fn init(self &new, from Rc[mut, Log]) {   //~ ErrorNotSendable "Actor Keeper's initializer takes from, a Rc[mut, Log], which is not Sendable"
    *self = new Self(count: 0u64, log: from);
    self.note(1u64);                        //~ ErrorBehaviourSend "note is a behaviour of actor Keeper's, so calling it sends it to the actor, as a message; this call is in an actor's initializer"
  }

  pub async do note(self, n u64) {count = count + n;}
  pub async do share(self, l Rc[mut, Log]) {log = l;}   //~ ErrorNotSendable "Actor Keeper's behaviour share takes l, a Rc[mut, Log], which is not Sendable: it is an owner whose permission, mut, is not race-safe"
  pub async do raw(self, p *u64) {}                     //~ ErrorNotSendable "behaviour raw takes p, a *u64, which is not Sendable: it is a raw pointer"
  pub async do tell(self, other Keeper) {other.note(count);}
  fn helper(self) {}

  fn fresh(self) {
    mut s = new Self(new Rc[mut, Log](0u64));
    s.note(1u64);                           //~ ErrorBehaviourSend "only this method's own 'self' is the state of an actor the runtime holds"
  }

  fn final(self &uni) {
    self.note(2u64);                        //~ ErrorBehaviourSend "this call is in an actor's finalizer"
  }
}

fn main() {
  initAll();
  {
    imm k = new Keeper(new Rc[mut, Log](0u64));
    k.note(1u64);
    k.tell(k);
    imm c = k.count;   //~ ErrorNotPublic "`count` is part of actor Keeper's private state"
    k.helper();        //~ ErrorNotPublic "`helper` is a synchronous method of actor Keeper's, run only inside the actor: its handle sends the actor's behaviours, declared 'async do', and nothing else."
  }
  finalAll();
}
