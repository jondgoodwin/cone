// An actor runs on the actors package, which its declarations reach: a
// module declaring one without importing the package is refused at the
// actor's name, saying which import to write. Nothing is generated for it.

mod concurrency_actor_runtime;

actor Lonely {                            //~ ErrorActorRuntime "write 'import actors;' after the 'mod' line"
  pub async do hello(self) {}
}

fn main() {}
