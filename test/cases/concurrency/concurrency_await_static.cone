// A ''static' borrow crosses a seam: it is already returnable from a
// function, so this is the same rule at a new program point, checked by the
// loan walk's own test of what is global (a value's lifetime is the shortest
// root among its loans; a value holds none). Each 'await' here is on a plain
// function, which is not built, so it is accepted and reported as not built
// (ErrorUnbuiltAwait), the borrow among what its continuation's record would
// carry, ending nothing:
//
// - a borrow of a global, used after the seam;
// - a reborrow through a borrow of a global: the borrow and the reborrow
//   both travel.
//
// A ''static' borrow a caller lends through a parameter never reaches a seam:
// a behaviour's parameters cross to the actor's thread, so none is a borrow,
// and a synchronous 'fn', which may take one, holds no 'await'
// (concurrency_await_place). A borrow that is not global is refused
// (concurrency_await_borrow).

mod concurrency_await_static;

import actors;

imm seed u64 = 7u64;

fn give() u64 {5u64;}

actor Page {
  body u64;

  pub async do ofGlobal(self) {
    imm r = &seed;
    await give();          //~ ErrorUnbuiltAwait "end the borrows held by []; give back []; move into the continuation's record [r]"
    body = *r;
  }

  pub async do reborrowed(self) {
    imm r = &seed;
    imm q = &*r;
    await give();          //~ ErrorUnbuiltAwait "end the borrows held by []; give back []; move into the continuation's record [r, q]"
    body = *q + *r;
  }
}
