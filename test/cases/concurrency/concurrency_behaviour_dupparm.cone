// A behaviour's parameter named twice is refused when the actor is declared,
// at the actor: the message's fields are made from the parameters, and a
// struct will not hold two fields of one name (the message is the struct's
// 'Only methods can be overloaded' rule, struct.c). The refusal is at parse,
// which stops the compile before name resolution, so this is a file of its
// own, apart from core_nameres_dupparm, which holds the cases name resolution
// finds. A behaviour of distinct names is accepted.

mod concurrency_behaviour_dupparm;

import actors;

actor Twice {                        //~ ErrorDupName:7 "Duplicate name b"
  v: u64;
  pub async fn post(self, b: u64, b: u64) {
  }
}

actor Distinct {
  v: u64;
  pub async fn post(self, b: u64, c: u64) {
  }
}
