// A borrow cannot cross to another actor: a message to an actor behaviour whose argument is a borrowed
// awaited value ('&await c.get()') is refused, as any borrowed argument to a behaviour is. The held-temporary
// acceptance of 'print <- &await ...' does not reach an actor's message.

mod concurrency_await_borrow_actor_msg;

import actors;

actor Counter {
  total: u64;

  fn init(self: &new, start: u64) {
    *self = Self(total: start);
  }

  pub async fn get(self) u64 {
    total
  }
}

actor Sink {
  pub async fn take(self, v: &'static imm u64) {
  }
}

actor Reporter {
  pub async fn last(self, c: Counter, s: Sink) {
    s.take <- &await c.get();   //~ ErrorNoCandidate "accepts the call's arguments"
  }
}



