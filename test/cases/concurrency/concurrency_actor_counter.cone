// An actor, declared: its fields are its state, its 'init' runs on fresh
// state when 'new Counter(start, step)' makes it and answers its handle, and
// each 'pub' method is a message, sent by calling it on a handle.
//
// Four threads are each handed a copy of the handle and send it 10000 bumps;
// main sends 7 more, and asks it to report. Each message runs on whichever
// worker takes the actor up, one at a time, with the state 'mut', so the
// total is exact: 100 + 4 * 10000 * 3 + 7 * 3 = 120121, printed by the
// finalizer once the last handle has gone and the mailbox is empty, which
// finalAll() waits for. The report message, sent before the threads start,
// sees only the starting value. A private method is called from a message,
// on the actor, as any method of a struct is.

mod concurrency_actor_counter;

import stdio use *;
import thread;
import actors;

actor Counter {
  total u64;
  step u64;
  bumps u64;

  fn init(self &new, start u64, step u64) {
    *self = new Self(total: start, step: step, bumps: 0u64);
  }

  pub fn bump(self) {
    total = total + step;
    count();
  }

  pub fn report(self &) {
    printStr("reported "); printUInt(total); printStr("\n");
  }

  fn count(self) {
    bumps = bumps + 1u64;
  }

  fn final(self &uni) {
    printStr("bumps "); printUInt(bumps); printStr("\n");
    printStr("total "); printUInt(total); printStr("\n");
  }
}

fn tenThousand(c Counter) u64 {
  mut i = 0u64;
  while i < 10000u64 {
    c.bump();
    i = i + 1u64;
  }
  i;
}

fn main() {
  initAll();
  actors.configure(new actors.Options(workers: 4u32));
  mut sent = 0u64;
  {
    imm c = new Counter(100u64, 3u64);
    c.report();
    imm t1 = thread.start(c, &tenThousand);
    imm t2 = thread.start(c, &tenThousand);
    imm t3 = thread.start(c, &tenThousand);
    imm t4 = thread.start(c, &tenThousand);
    mut i = 0u64;
    while i < 7u64 {
      c.bump();
      i = i + 1u64;
    }
    sent = t1.join() + t2.join() + t3.join() + t4.join();
  }
  finalAll();
  printStr("threads sent "); printUInt(sent); printStr("\n");
}
