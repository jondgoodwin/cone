// What the parser refuses of a 'parallel each': a number range that does not
// count up by one. Which pass runs first is not defined when they run at the
// same time, so a count down ('>' or '>=') and a 'by' step are not offered, and
// the message says what is. A range with two variables is refused as an
// ordinary one is. Every other refusal is type check's
// (concurrency_parallel_each_refused).
//
mod concurrency_parallel_each_parse;

fn down(n u64) {
  parallel each i in 10u64 ..< 0u64 by -1 {                //~ ErrorParSource "counts up by one"
  }
  parallel each i in n .. 1u64 by -1 {                   //~ ErrorParSource "counts up by one"
  }
}

fn step(n u64) {
  parallel each i in 0u64 ..< n by 2u64 {            //~ ErrorParSource "counts up by one"
  }
  parallel each i in 0u64 .. n by 3u64 {           //~ ErrorParSource "counts up by one"
  }
}

fn pair(n u64) {
  parallel each i, j in 0u64 ..< n {                 //~ ErrorBadTok "A numeric range gives one variable"
  }
}

fn withElse(n u64) {
  parallel each i in 0u64 ..< n {
  } else {                                         //~ ErrorParElse "takes no 'else'"
  }
}
