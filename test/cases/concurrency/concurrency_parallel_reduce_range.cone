// A view of a number range is not built: the comparison spelling of a range is being
// replaced, and ranges get a parallel() with the new range syntax. A range written
// as a comparison under parallel() is refused where it is written, saying so,
// whether a reduction follows or not. (Refused in name resolution, so it is a
// scenario of its own: type check does not run after it.)

mod concurrency_parallel_reduce_range;

import actors;

fn ranges() {
  imm a = (0 < 10).parallel().sum();                     //~ ErrorParReduce "comes with the new range syntax"
  imm b = (0 <= 10).parallel();                          //~ ErrorParReduce "comes with the new range syntax"
}

fn main() i32 { 0i32; }
