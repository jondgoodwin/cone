// What Atomic[T]'s operations become (cases.toml pins it): each everyday
// operation one sequentially consistent atomic instruction; each 'Ordered'
// form one arm per ordering it may take, that ordering's instruction in it;
// and a local operated on only atomically left in memory by the optimizer,
// its atomic add inside the loop, so the count it prints is right.

mod concurrency_genllvm_atomic;

import stdio use *;

fn counted(n u32) u32 {
  mut c = Atomic[u32].of(0u32);
  mut i = 0u32;
  while i < n {
    c.add(3u32);
    i = i + 1u32;
  }
  c.inner();
}

fn main() {
  imm a = Atomic[i16].of(1i16);
  a.addOrdered(2i16, MemOrder.Relaxed[]);
  a.store(a.load() + 1i16);
  printInt(i64[a.load()]);
  printStr("\n");
  printInt(i64[counted(1000u32)]);
  printStr("\n");
}
