// What an awaited operation answers with should be used: an I/O operation's
// answer is a Result, saying whether it worked, as a synchronous call that
// can fail answers, and an 'await' whose value nothing takes drops the
// failure unread. So an 'await' on an operation (an actors.Awaitable) that is
// a statement of its own is warned, in the middle of a behaviour and as its
// last statement, where a behaviour returning nothing drops it too
// (WarnAwaitUnused). It is a warning, not a refusal: the program compiles and
// the answer is dropped. Bound to a local, or used, nothing is said. An
// 'await' on a behaviour's reply is not touched by this. Careless is the
// reference manual's example (refconcio.html, "Awaiting I/O"), verbatim, on
// the aio package's write.

mod concurrency_await_operation_unused;

import libc;
import iobuf use Pool;
import actors;
import aio use Socket;

fn op() actors.Awaitable[Result[u64, u32]] {
  actors.Awaitable[Result[u64, u32]].make(fn(rp actors.Reply) {
    actors.answerNow[Result[u64, u32]](rp, Ok[u64, u32][1u64]);
  });
}

actor Peer {
  pub async do count(self) u64 {3u64;}
}

actor User {
  peer Peer;
  last u64;

  pub async do dropped(self) {
    await op();                       //~ WarnAwaitUnused:5 "is thrown away"
    last = 1u64;
  }

  pub async do droppedLast(self) {
    await op();                       //~ WarnAwaitUnused:5 "bind it"
  }

  pub async do bound(self) {
    imm r = await op();
    match r {
      case imm ok Ok {last = ok.value;}
      else {last = 0u64;}
    }
  }

  pub async do replied(self) {
    await peer.count();
  }
}

actor Careless {
  pool Pool;

  pub async do careless(self, conn Socket) {
    await conn.write(pool.mustTake(64usize));   // warned: the answer is thrown away //~ WarnAwaitUnused:5 "answers with a Result"
  }
}

fn main() {}
