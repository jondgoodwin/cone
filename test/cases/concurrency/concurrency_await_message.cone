// Where an 'await' on a behaviour, and 'selfactor', are refused:
//
// - An 'await' on a behaviour that returns nothing (ErrorAwaitVoid): such a
//   behaviour sends no reply, since whether one is sent is its signature's to
//   say, and a caller that needs to know it finished awaits one that declares
//   a return type. Through another actor's handle and through 'self' alike.
// - A record that would hold a traced reference: a continuation waits in
//   the actor's pending table, off the stack, which the collector does not
//   trace yet (ErrorUnbuiltAwait at the 'await').
// - What a behaviour returns goes back to the actor awaiting it, on its
//   thread: it must be Sendable (ErrorNotSendable at the return type).
// - 'selfactor', the actor's own handle, stands in an actor's methods, its
//   'init' among them (concurrency_actor_init_sends runs one), not its
//   'final', nor a function or another type's method (ErrorSelfActorPlace).
//
// A behaviour holding an 'await' may be named from another of the actor's
// methods: 'self.load()' is a send, which goes on at once and cuts nothing
// (concurrency_actor_selfsend runs it). A behaviour that returns a value may
// be sent with no 'await', its value dropped, and awaited
// (concurrency_await_reply runs both).

mod concurrency_await_message;

import actors;
import collector;

struct Cell {pub n u64;}

actor Peer {
  pub async do ping(self) {}
  pub async do get(self) u64 {3u64;}
  pub async do share(self) Rc[mut, u64] {new Rc[mut, u64](1u64);}   //~ ErrorNotSendable "Actor Peer's behaviour share returns a Rc[mut, u64], which is not Sendable"
}

actor Page {
  peer Peer;
  body u64;

  fn init(self &new, p Peer) {
    *self = new Self(p, 0u64);
    imm me = selfactor;     // the actor is real already
  }

  pub async do quiet(self) {
    await peer.ping();      //~ ErrorAwaitVoid "'await' waits for a behaviour's reply, and ping returns nothing, so it sends none: a behaviour with no return type owes its caller nothing. If the caller needs to know ping finished, declare a return type -- a status saying whether it worked -- and await that."
  }

  async do nothing(self) {}

  pub async do quieter(self) {
    await self.nothing();   //~ ErrorAwaitVoid "and nothing returns nothing, so it sends none"
  }

  pub async do load(self) {
    body = await peer.get();
  }

  pub async do calls(self) {
    self.load();            // a send: no seam here
  }

  pub async do traced(self) {
    imm g = new Gc[mut, Cell](1u64);
    imm v = await peer.get();   //~ ErrorUnbuiltAwait "'await' whose continuation holds a traced reference is not built: g would wait in the actor's pending table"
    body = v + g.n;
  }

  fn final(self &uni) {
    imm me = selfactor;     //~ ErrorSelfActorPlace "this one is in an actor's finalizer"
  }
}

fn outside() {
  imm me = selfactor;       //~ ErrorSelfActorPlace "this one is in a function that is not a method of an actor"
}

struct Plain {
  n u64;
  fn m(self &) {
    imm me = selfactor;     //~ ErrorSelfActorPlace "this one is in a function that is not a method of an actor"
  }
}

fn main() {}
