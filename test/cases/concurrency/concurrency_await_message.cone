// Where an 'await' on a message, and 'selfactor', are refused:
//
// - An 'await' on a message that returns nothing is not built: there is no
//   value for a reply to carry (ErrorUnbuiltAwait, after the seam's rules
//   are checked, naming what its record would carry).
// - A message holding an 'await' is its dispatcher's to call: each seam
//   returns to the dispatcher, and called from another method it would cut
//   that method too, where nothing shows it (ErrorUnbuiltAwait at the call).
// - A record that would hold a traced reference: a continuation waits in
//   the actor's pending table, off the stack, which the collector does not
//   trace yet (ErrorUnbuiltAwait at the 'await').
// - What a message returns goes back to the actor awaiting it, on its
//   thread: it must be Sendable (ErrorNotSendable at the return type).
// - 'selfactor', the actor's own handle, stands only where 'await' may: in
//   an actor's method, not its 'init', which runs before the actor exists,
//   nor its 'final', nor a function or another type's method
//   (ErrorSelfActorPlace).
//
// A message that returns a value may be sent with no 'await', its value
// dropped, and awaited (concurrency_await_reply runs both).

mod concurrency_await_message;

import actors;
import collector;

struct Cell {pub n u64;}

actor Peer {
  pub fn ping(self) {}
  pub fn get(self) u64 {3u64;}
  pub fn share(self) Rc[mut, u64] {new Rc[mut, u64](1u64);}   //~ ErrorNotSendable "Actor Peer's message share returns a Rc[mut, u64], which is not Sendable"
}

actor Page {
  peer Peer;
  body u64;

  fn init(self &new, p Peer) {
    imm me = selfactor;     //~ ErrorSelfActorPlace "this one is in an actor's initializer"
    *self = new Self(p, 0u64);
  }

  pub fn quiet(self) {
    await peer.ping();      //~ ErrorUnbuiltAwait "'await' on a message that returns nothing is not built, so nothing is generated for it. Its seam would end the borrows held by []"
  }

  pub fn load(self) {
    body = await peer.get();
  }

  pub fn calls(self) {
    self.load();            //~ ErrorUnbuiltAwait "A call of load, a method of actor Page holding an 'await', is not built"
  }

  pub fn traced(self) {
    imm g = new Gc[mut, Cell](1u64);
    imm v = await peer.get();   //~ ErrorUnbuiltAwait "'await' whose continuation holds a traced reference is not built: g would wait in the actor's pending table"
    body = v + g.n;
  }

  fn final(self &uni) {
    imm me = selfactor;     //~ ErrorSelfActorPlace "this one is in an actor's finalizer"
  }
}

fn outside() {
  imm me = selfactor;       //~ ErrorSelfActorPlace "this one is in a function that is not a method of an actor"
}

struct Plain {
  n u64;
  fn m(self &) {
    imm me = selfactor;     //~ ErrorSelfActorPlace "this one is in a function that is not a method of an actor"
  }
}

fn main() {}
