// Four producer actors send numbered messages to one consumer actor, which
// checks that each producer's messages arrive in the order that producer
// sent them. Main drives the producers: it sends each of them 50 bursts,
// round-robin, from the main thread (so through the inject queue), and each
// burst makes its producer send the consumer its next 400 numbers, so the
// four producers run on whichever workers take them, at once, and their
// messages interleave in the consumer's mailbox.
//
// The consumer is held only by the producers once main lets go of its handle:
// it dies, and its finalizer reports, once every producer has died and it has
// taken every message in its mailbox. Nobody tells the runtime anything:
// 'finish' waits for quiescence.
//
// The actors are written by hand in the shape the compiler is to generate
// (concurrency_actors_pingpong.cone describes it): a state struct beginning
// with the runtime's Header, a message enum named <Actor>_msg, a dispatch
// function, and a handle holding the '+arc-opaq' owner, with a send function
// per method.

mod concurrency_actors_fanin;

import stdio use *;
import sync use arc;
import actors;

const producers = 4u64;
const bursts = 50u64;
const perBurst = 400u64;

struct Results {
  pub taken Atomic[u64];
  pub disorder Atomic[u64];
  pub from0 Atomic[u64];
  pub from1 Atomic[u64];
  pub from2 Atomic[u64];
  pub from3 Atomic[u64];
  pub sum Atomic[u64];
  pub consumerFinals Atomic[u64];
  pub producerFinals Atomic[u64];
}

imm results Results;

fn @initpure init() {
  results = Results[Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64)];
}

// ---- the consumer ----

struct Consumer_state is Sendable {
  hdr actors.Header;
  last [4; u64];               // the last number taken from each producer
  count [4; u64];
  taken u64;
  disorder u64;
  sum u64;

  pub fn made() Consumer_state {
    Consumer_state[actors.Header.make(), [0u64, 0u64, 0u64, 0u64], [0u64, 0u64, 0u64, 0u64], 0u64, 0u64, 0u64];
  }

  fn take(self &mut, from u64, k u64) {
    if k != last[from] + 1u64 {
      disorder = disorder + 1u64;
    }
    last[from] = k;
    count[from] = count[from] + 1u64;
    taken = taken + 1u64;
    sum = sum + from * 1000000u64 + k;
  }

  fn final(self &uni) {
    results.taken.add(taken);
    results.disorder.add(disorder);
    results.from0.add(count[0]);
    results.from1.add(count[1]);
    results.from2.add(count[2]);
    results.from3.add(count[3]);
    results.sum.add(sum);
    results.consumerFinals.add(1u64);
  }
}

enum Consumer_msg {
  struct Take {pub from u64; pub k u64;}
}

fn Consumer_dispatch(self &mut Consumer_state, msg Consumer_msg) {
  match msg {
    case imm m Consumer_msg.Take {self.take(m.from, m.k);}
  }
}

struct Consumer {
  st +arc-opaq Consumer_state;

  pub fn start() Consumer {
    Consumer[actors.startActor[Consumer_state, Consumer_msg](Consumer_state.made(), &Consumer_dispatch)];
  }
  pub fn take(self &, from u64, k u64) {
    actors.send[Consumer_state, Consumer_msg](st, Consumer_msg.Take[from, k]);
  }
}

// ---- the producers ----

struct Producer_state is Sendable {
  hdr actors.Header;
  id u64;
  next u64;                    // the next number to send
  to Consumer;

  pub fn made(id u64, to Consumer) Producer_state {
    Producer_state[actors.Header.make(), id, 1u64, to];
  }

  fn burst(self &mut, n u64) {
    mut i = 0u64;
    while i < n {
      to.take(id, next);
      next = next + 1u64;
      i = i + 1u64;
    }
  }

  fn final(self &uni) {
    results.producerFinals.add(1u64);
  }
}

enum Producer_msg {
  struct Burst {pub n u64;}
}

fn Producer_dispatch(self &mut Producer_state, msg Producer_msg) {
  match msg {
    case imm m Producer_msg.Burst {self.burst(m.n);}
  }
}

struct Producer {
  st +arc-opaq Producer_state;

  pub fn start(id u64, to Consumer) Producer {
    Producer[actors.startActor[Producer_state, Producer_msg](
      Producer_state.made(actors.sendable(id), actors.sendable(to)), &Producer_dispatch)];
  }
  pub fn burst(self &, n u64) {
    actors.send[Producer_state, Producer_msg](st, Producer_msg.Burst[n]);
  }
}

fn main() {
  initAll();
  imm rt = actors.startWith(actors.Options[workers: 4u32]);
  {
    imm c = Consumer.start();
    imm p0 = Producer.start(0u64, c);
    imm p1 = Producer.start(1u64, c);
    imm p2 = Producer.start(2u64, c);
    imm p3 = Producer.start(3u64, c);
    mut b = 0u64;
    while b < bursts {
      p0.burst(perBurst);
      p1.burst(perBurst);
      p2.burst(perBurst);
      p3.burst(perBurst);
      b = b + 1u64;
    }
  }
  imm st = rt.finish();
  printStr("taken "); printUInt(results.taken.load()); printStr("\n");
  printStr("from each "); printUInt(results.from0.load()); printStr(" ");
  printUInt(results.from1.load()); printStr(" "); printUInt(results.from2.load()); printStr(" ");
  printUInt(results.from3.load()); printStr("\n");
  printStr("sum "); printUInt(results.sum.load()); printStr("\n");
  printStr("out of order "); printUInt(results.disorder.load()); printStr("\n");
  printStr("producers finalized "); printUInt(results.producerFinals.load()); printStr("\n");
  printStr("consumer finalized "); printUInt(results.consumerFinals.load()); printStr("\n");
  printStr("messages handled "); printUInt(st.messages); printStr("\n");
}
