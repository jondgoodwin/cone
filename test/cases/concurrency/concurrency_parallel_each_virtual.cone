// A reference to a trait or a callable hides what is behind it, so a parallel each body
// may name one from outside only if the reference says what is behind it: '+ Shareable'
// (or '+ Sendable', which is Shareable too). Unmarked it is refused, as Rust's
// &dyn Trait is not Sync (closure_typecheck_shareable); a value that is not Shareable
// cannot be made a marked one at all. Here the marked ones run: a '&<Shape + Shareable'
// over two implementers, a '&<fn(..) + Shareable' over a closure that lists a number,
// and a 'So[Shape + Sendable]', each read by every pass.
//
//   Sq(3) has area 9 and Disc(2) 3 * 2 * 2 = 12: 1000 passes each: 9000 and 12000;
//   the closure x * 3 over 0 to 99: 3 * 4950 = 14850;
//   the owned Sq(2), area 4, over 500 passes: 2000.

mod concurrency_parallel_each_virtual;

import stdio use *;
import actors;

trait Shape { pub fn area(self &) u64; }
struct Sq is Shape { pub s u64; pub fn area(self &) u64 { s * s; } }
struct Disc is Shape { pub r u64; pub fn area(self &) u64 { 3u64 * r * r; } }

fn total(sh &<Shape + Shareable, n usize) u64 {
  imm sum = Atomic[u64].of(0u64);
  parallel each i in 0usize < n {
    sum.add(sh.area());
  }
  sum.load();
}

fn totalFn(f &<fn(x u64) u64 + Shareable, n usize) u64 {
  imm sum = Atomic[u64].of(0u64);
  parallel each i in 0usize < n {
    sum.add(f(u64.from(i)));
  }
  sum.load();
}

fn totalOwned(sh So[Shape + Sendable], n usize) u64 {
  imm sum = Atomic[u64].of(0u64);
  parallel each i in 0usize < n {
    sum.add(sh.area());
  }
  sum.load();
}

fn main() {
  initAll();
  actors.configure(new actors.Options(workers: 4u32));
  imm sq = new Sq(3u64);
  imm disc = new Disc(2u64);
  printInt(i64.from(total(&sq, 1000usize)));
  printStr(" ");
  printInt(i64.from(total(&disc, 1000usize)));
  printStr("\n");
  imm k = 3u64;
  printInt(i64.from(totalFn(fn(x u64) [k] u64 { x * k; }, 100usize)));
  printStr("\n");
  printInt(i64.from(totalOwned(new So[Sq](new Sq(2u64)), 500usize)));
  printStr("\n");
}
