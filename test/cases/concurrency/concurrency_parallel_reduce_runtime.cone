// A parallel reduction in a module that does not import the actors package its
// blocks run on is refused where it is written, the message saying to write
// 'import actors;'. 'parallel()' alone, which only makes the view, needs no import.

mod concurrency_parallel_reduce_runtime;

import collections use *;

fn view(xs &List[i64]) {
  imm v = xs.parallel();
}

fn total(xs &List[i64]) i64 {
  xs.parallel().sum();      //~ ErrorParReduce
}

fn folded(xs &List[i64]) i64 {
  xs.parallel().fold(0i64, (acc, x) => acc + *x, (a, b) => a + b);      //~ ErrorParReduce
}

fn found(xs &List[i64]) {
  imm f = xs.parallel().findFirst(x => **x > 3i64);      //~ ErrorParReduce
}

fn main() i32 { 0i32; }
