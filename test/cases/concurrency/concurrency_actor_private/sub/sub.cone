// The actor, its behaviours one public, one not, sent here from its own
// module: 'note' is private to this module, not to the actor.

mod sub;

import actors;

pub actor Greeter {
  count u64;

  pub fn init(self &new) {*self = new Self(count: 0u64);}

  pub async do greet(self, n u64) {count = count + n;}

  async do note(self, c u64) {count = c;}

  fn twice(self &, n u64) u64 {n * 2u64;}
}

pub fn poke(g Greeter) {
  g.note(5u64);
}
