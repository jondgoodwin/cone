// A behaviour's 'pub' is a member's: the handle's method sending it is as
// public as the behaviour, so another module sends Greeter's 'greet' and not
// its 'note', which only its own module (sub) sends, as it may any of its
// private members (ErrorNotPublic). A synchronous method is no member of the
// handle at all, from any module: it runs only inside the actor.

mod concurrency_actor_private;

import actors;

fn main() {
  initAll();
  {
    imm g = new sub.Greeter();
    g.greet(1u64);
    g.note(2u64);           //~ ErrorNotPublic "May not access the private method/field `note`"
    g.twice(3u64);          //~ ErrorNotPublic "`twice` is a synchronous method of actor Greeter's"
  }
  finalAll();
}
