// An actor field of a refused type (Atomic of a reference) is reported where it is declared, and a body
// that uses it, beside a call whose argument is left unchecked, is not walked by flow, which reached a
// call that has no type (Error 1075 in the path walk).

mod concurrency_atomic_ref_use;
import collections use *;
import actors;
actor Painter {
  small: [u64];
  tens: [u64];
  total: Atomic[&u64];
  fn init(self: &) {
    var i = 0usize;
    while i < 6000usize {
    }
  }
  fn sum(self: &, l: List[u64]) u64 {
     each i, x, y in zip(&small, &tens).indexed() {
      total.add(u64.from());
    }
    total.load()
  }
}
