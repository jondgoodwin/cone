// The refusals the reference manual's section on 'await' in an actor's
// methods shows (doc/reference/refconccomm.html, "Awaiting a reply"), each
// block copied there from between the "manual:" lines, verbatim but for each
// line's expected diagnostic, which the page writes as a comment saying what
// is refused. The examples that run are concurrency_await_manual's.
//
// - A borrow used after the 'await' that ended it: the ordinary ErrorFrozen,
//   at the 'await'. Beside it, the same method written to borrow afresh
//   after the 'await', which is accepted.
// - A borrow made before the 'await' for a call made after it: a method's
//   receiver, or an argument. Each is refused at the 'await'; beside them,
//   the 'await' written as a statement of its own first, accepted.
// - A lock borrow named after the 'await'.
// - What is not built yet, each ErrorUnbuiltAwait where it is written: an
//   'await' on anything but a message (a plain function's call standing for
//   an I/O operation's completion), on a message that returns nothing, in a
//   method that is not a message, in a place's index, store or swap, and
//   whose continuation would hold a traced reference; and a call of a message
//   holding an 'await' from another of the actor's methods.

mod concurrency_await_manual_refused;

import actors;
import collector;
import sync use Arc, Mutex;

struct Count {pub n u64;}
struct Cell {pub n u64;}

actor Clock {
  pub fn now(self) u64 {42u64;}
  pub fn tick(self) {}
}

fn compute() u64 {5u64;}
fn add(r &u64, n u64) u64 {*r + n;}

// manual: borrow
actor Meter {
  clock Clock;
  reading u64;

  pub fn stale(self) {
    imm r = &reading;
    imm t = await clock.now();  //~ ErrorFrozen "The borrow 'r' holds of '*self' (made at 44:13) ends at this 'await', where the method returns to its actor's dispatcher to wait, and 'r' is used again at 46:16"
    reading = *r + t;
  }

  pub fn fresh(self) {
    imm t = await clock.now();
    imm r = &reading;           // borrowed after the 'await'
    reading = *r + t;
  }
// manual: end

// manual: in flight
  pub fn store(self, n u64) {reading = n;}

  pub fn receiver(self) {
    self.store(await clock.now());       //~ ErrorFrozen "A borrow of what the caller lent through 'self'"
  }

  pub fn argument(self) {
    imm x = 3u64;
    reading = add(&x, await clock.now()); //~ ErrorFrozen "A borrow of 'x' (made at 65:19) ends at this 'await'"
  }

  pub fn hoisted(self) {
    imm t = await clock.now();
    self.store(t);
  }
// manual: end
}

// The page says this one in words, with no example
actor Tally {
  count Arc[Mutex, Count];
  clock Clock;

  pub fn held(self) {
    imm c = &mut *count;          // takes the lock
    imm t = await clock.now();    //~ ErrorFrozen "The borrow 'c' holds through the lock taken at 81:19 (made at 81:13) ends at this 'await', where the method returns to its actor's dispatcher to wait, and 'c' is used again at 83:5"
    c.n += t;
  }
}


// manual: not built
actor Waiter {
  clock Clock;
  last u64;

  pub fn onFunction(self) {
    last = await compute();       //~ ErrorUnbuiltAwait "'await' is not built yet"
  }

  pub fn onNothing(self) {
    await clock.tick();           //~ ErrorUnbuiltAwait "'await' on a message that returns nothing is not built"
  }

  fn helper(self) u64 {
    await clock.now();            //~ ErrorUnbuiltAwait "'await' is not built yet"
  }

  pub fn caller(self) {
    last = await clock.now();
  }

  pub fn callsCaller(self) {
    self.caller();                //~ ErrorUnbuiltAwait "A call of caller, a method of actor Waiter holding an 'await', is not built"
  }

  pub fn indexed(self) {
    imm items = [1u64, 2u64, 3u64];
    last = items[await clock.now()];  //~ ErrorUnbuiltAwait "it stands in the index of a place"
  }

  pub fn traced(self) {
    imm g = new Gc[mut, Cell](1u64);
    imm t = await clock.now();    //~ ErrorUnbuiltAwait "'await' whose continuation holds a traced reference is not built"
    last = t + g.n;
  }
}
// manual: end
