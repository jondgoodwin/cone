// The refusals the reference manual's sections on 'await' show (refconccomm,
// "Awaiting a reply" and "Storing a future"), each block copied there from
// between the "manual:" lines, verbatim but for each line's diagnostic, which
// the page writes as a comment saying what is refused. The examples that run
// are concurrency_await_manual's and concurrency_future_manual's. Last, two
// of futures: a move one awaited twice; a kept call of 'flush' (ErrorFutureVoid).
// - A borrow used after the 'await' that ended it: the ordinary ErrorFrozen,
//   at the 'await'. Beside it, the same method written to borrow afresh
//   after the 'await', which is accepted.
// - A borrow a call made, written to the left of the 'await' for a call made
//   after it, ErrorAwaitLeftCall: the rest of the statement runs after the
//   'await', and only a plain path is reached again there. Beside it, the
//   call's value bound to a local first, which is borrowed after the
//   'await', accepted.
// - A lock borrow named after the 'await'.
// - An 'await' in a synchronous 'fn' of the actor, ErrorAwaitPlace, beside
//   the behaviour written the way the message teaches: the 'await' at its
//   top, the synchronous work pushed down onto the 'fn'.
// - An 'await' on a behaviour that returns nothing, ErrorAwaitVoid, beside
//   one awaiting a behaviour that answers with a status.
// - An 'await' on a function's call, which waits for no answer,
//   ErrorAwaitNotFuture; and what is not built yet, each ErrorUnbuiltAwait: an
//   'await' in both places a swap exchanges, and one whose continuation would
//   hold a traced reference.

mod concurrency_await_manual_refused;

import actors;
import collector;
import sync use Arc, Mutex;

struct Count {pub n u64;}
struct Cell {pub n u64;}

actor Clock {
  pub async do now(self) u64 {42u64;}
  pub async do tick(self) {}
}

fn compute() u64 {5u64;}
fn add(r &u64, n u64) u64 {*r + n;}

// manual: borrow
actor Meter {
  clock Clock;
  reading u64;

  pub async do stale(self) {
    imm r = &reading;
    imm t = await clock.now();  //~ ErrorFrozen "The borrow 'r' holds of '*self' (made at 49:13) ends at this 'await', where the method returns to its actor's dispatcher to wait, and 'r' is used again at 51:16"
    reading = *r + t;
  }

  pub async do fresh(self) {
    imm t = await clock.now();
    imm r = &reading;           // borrowed after the 'await'
    reading = *r + t;
  }
// manual: end

// manual: from a call
  pub async do fromCall(self) {
    reading = add(&compute(), await clock.now());  //~ ErrorAwaitLeftCall "This borrow, written to the left of an 'await' in the same statement, is made by a call or a temporary, and is used after the 'await'. The rest of the statement runs after the 'await', which ends every borrow: only a plain path -- a local, 'self', a field, an element at a plain index -- is reached again there, never what a call made. Bind what the call makes to a local first, and use the local here."
  }

  pub async do bound(self) {
    imm c = compute();
    reading = add(&c, await clock.now());          // c is borrowed after the 'await'
  }
// manual: end
}

// The page says this one in words, with no example
actor Tally {
  count Arc[Mutex, Count];
  clock Clock;

  pub async do held(self) {
    imm c = &mut *count;          // takes the lock
    imm t = await clock.now();    //~ ErrorFrozen "The borrow 'c' holds through the lock taken at 79:19 (made at 79:13) ends at this 'await', where the method returns to its actor's dispatcher to wait, and 'c' is used again at 81:5"
    c.n += t;
  }
}


// manual: synchronous
actor Reporter {
  clock Clock;
  last u64;

  pub async do report(self) {
    imm t = await clock.now();    // the 'await', at the top of the behaviour
    last = self.format(t);        // the synchronous work, pushed down
  }

  fn format(self &, t u64) u64 {
    t * 1000u64 + last;
  }

  fn stamp(self) {
    last = await clock.now();     //~ ErrorAwaitPlace "This one is in stamp, a 'fn' of actor Reporter's: synchronous"
  }
}
// manual: end

// manual: nothing returned
actor Log {
  pub async do flush(self) {}             // owes its caller nothing
  pub async do commit(self) Bool {true;}  // answers with a status
}

actor Writer {
  log Log;
  saved Bool;

  pub async do save(self) {
    await log.flush();            //~ ErrorAwaitVoid "flush returns nothing, so it sends none"
    saved = await log.commit();   // waits until commit has run, and learns whether it worked
  }
}
// manual: end

// manual: not built
actor Waiter {
  clock Clock;
  last u64;

  pub async do onFunction(self) {
    last = await compute();       //~ ErrorAwaitNotFuture "awaits a u64, which is none of them"
  }

  pub async do swapped(self) {
    mut items = [1u64, 2u64, 3u64];
    items[await clock.now()] <=> items[await clock.now()];  //~ ErrorUnbuiltAwait "it stands in both places a swap exchanges"
                                                            //~^ ErrorUnbuiltAwait "it stands in both places a swap exchanges"
  }

  pub async do traced(self) {
    imm g = new Gc[mut, Cell](1u64);
    imm t = await clock.now();    //~ ErrorUnbuiltAwait "'await' whose continuation holds a traced reference is not built"
    last = t + g.n;
  }
}
// manual: end

// manual: kept twice
struct Report is Move {
  pub lines u64;
}

actor Printer {
  pub async do render(self, n u64) Report {new Report(n * 2u64);}
}

actor Desk {
  printer Printer;

  pub async do twice(self) u64 {
    imm r = printer.render(10u64);
    imm report = await r;
    imm again = await r;          //~ ErrorMove "This variable's value has been moved out"
    report.lines;
  }
}
// manual: end

// manual: nothing to keep
actor Keeper {
  log Log;

  pub async do keep(self) {
    log.flush();                  // sent, and forgotten
    imm f = log.flush();          //~ ErrorFutureVoid "flush returns nothing, so its call gives no future to keep"
  }
}
// manual: end
