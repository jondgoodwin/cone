// A generic actor's const reached through an instance from outside the actor,
// 'Tally[i32].step' and 'Tally[f64].limit', as a struct's const is through its
// instance ('Vec3[f32].zero'): the instance is the handle, and the const is one of
// the actor's braces, the state's. Each is a value (folded, no storage), so it is
// used in an expression and in a const of its own, with no actor started.
//
// Prints step 4, limit 15, their sum 19, and a 'const' computed from both, 8.

mod concurrency_actor_generic_const_path;

import stdio use *;
import actors;

actor Tally[T] {
  total: T;
  pub const step: u64 = 4;
  pub const limit: u64 = 60 / 4;

  fn init(self: &new, start: T) {
    *self = Self(total: start);
  }

  pub async fn bump(self, delta: T) {
    total = total + delta;
  }
}

const twice: u64 = Tally[i32].step * 2;

fn main() {
  printStr("step "); printUInt(Tally[i32].step); printStr("\n");
  printStr("limit "); printUInt(Tally[f64].limit); printStr("\n");
  printStr("sum "); printUInt(Tally[i32].step + Tally[f64].limit); printStr("\n");
  printStr("twice "); printUInt(twice); printStr("\n");
}
