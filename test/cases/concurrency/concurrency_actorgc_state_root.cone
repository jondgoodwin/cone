// The state is a root of the actor's own collector, handed to it between
// messages. One that holds a reference into the region, and a raw pointer to a
// value that holds one, has a reference the collector could not follow, and would
// leave dangling when it moved what the reference points at: ErrorTraceRoot, at
// the actor and (the roots the actors runtime holds the state in) twice more,
// in the package's generated code, where no annotation of this file reaches --
// so the scenario counts its diagnostics.

mod concurrency_actorgc_state_root;

import actors;
import actorgc;

struct Leaf { pub n i64; }
alias LeafRef = ActorGc[mut, Leaf];

struct Pinned { pub leaf LeafRef; }

actor Raw {
  keep Option[LeafRef];
  p *Pinned;

  fn init(self &new) {
    *self = new Self(None[LeafRef], null);
  }
}

fn main() {}
