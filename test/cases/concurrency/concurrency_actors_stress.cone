// A stress run, repeated to catch a race: 100 rounds, one after another, on
// one runtime of 4 workers (or as many as the program's argument says, 0
// for one per logical processor). Each round builds a ring of 8 'Node'
// actors, each holding a handle to the next, and a 'Collector' holding them
// all; main sends 4 tokens into the ring, each to be passed on 2000 times.
// Each node counts the tokens it passes in an '+Rc-mut' tally it holds two
// owners of (an 'Rc' count is not atomic, and needs none: one worker at a
// time runs an actor, and each hand-off of an actor between workers orders
// what the last did before what the next does). The last pass of each
// token reports to the collector; when all 4 have reported, it tells every
// node to let go of its next node, and lets go of the nodes itself, so that
// each node, and then the collector, dies once main has let go of its own
// handles. The collector's finalizer, the round's last, wakes main for the
// next round.
//
// Every round must see exactly 4 * 2001 passes, every tally agree with its
// node's own count, and all 9 actors finalized, each once; a round that does
// not is counted, and the count printed at the end is 0. At the end,
// finalAll() waits for quiescence and stops the workers.
//
// The actors are written by hand in the shape the compiler is to generate
// (concurrency_actors_pingpong.cone describes it).

mod concurrency_actors_stress;

import stdio use *;
import sync use Arc;
import collections use List;
import actors;

const rounds = 100u64;
const ringSize = 8u64;
const tokens = 4u64;
const hops = 2000u64;

struct Results {
  pub passes Atomic[u64];
  pub mismatches Atomic[u64];
  pub finals Atomic[u64];
  pub rounds Atomic[u32];      // rounds whose actors have all died: a futex word
}

imm results Results;

fn @initpure init() {
  results = Results[Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u32].of(0u32)];
}

struct Tally {
  pub n u64;
}

// ---- the messages, declared first, Node's before Collector's, which holds
// a Node (the actors package header says why) ----

enum Node_msg {
  struct Link {pub n Node;}
  struct Token {pub left u64;}
  struct Unlink {}
}

enum Collector_msg {
  struct Join {pub n Node;}
  struct Done {}
}

// ---- Collector: hears each token's end, then unlinks the ring ----

struct Collector_state {
  ring List[Node];
  finished u64;

  pub fn made() Collector_state {
    Collector_state[List[Node].empty(), 0u64];
  }

  fn join(self &mut, n Node) {
    ring.push(n);
  }

  fn done(self &mut) {
    finished = finished + 1u64;
    if finished == tokens {
      mut i = 0usize;
      while i < ring.len() {
        ring[i].unlink();
        i = i + 1usize;
      }
      ring.clear();
    }
  }

  fn final(self &uni) {
    results.finals.add(1u64);
    results.rounds.add(1u32);
    sync.futexWake(&results.rounds);
  }
}

fn Collector_dispatch(self &mut Collector_state, msg Collector_msg) {
  match msg {
    case imm m Collector_msg.Join {self.join(m.n);}
    case is Collector_msg.Done {self.done();}
  }
}

struct Collector {
  mb Arc[opaq, actors.Mailbox[Collector_msg]];

  pub fn start() Collector {
    Collector[actors.startActor[Collector_state, Collector_msg](Collector_state.made(), &Collector_dispatch)];
  }
  pub fn join(self &, n Node) {
    actors.send[Collector_msg](mb, Collector_msg.Join[n]);
  }
  pub fn done(self &) {
    actors.send[Collector_msg](mb, Collector_msg.Done[]);
  }
}

// ---- Node: passes tokens on to the next ----

struct Node_state {
  next Option[Node];
  collector Collector;
  passes u64;
  tally Rc[mut, Tally];
  tallyToo Rc[mut, Tally];

  pub fn made(collector Collector) Node_state {
    imm t = +Rc-mut Tally[0u64];
    Node_state[None[Node][], collector, 0u64, t, t];
  }

  fn link(self &mut, n Node) {
    next = Some[Node][n];
  }

  fn token(self &mut, left u64) {
    passes = passes + 1u64;
    tally.n = tally.n + 1u64;
    if left == 0u64 {
      collector.done();
      return;
    }
    match next {
      case imm n Some {n.value.token(left - 1u64);}
      case is None[Node] {results.mismatches.add(1u64);}
    }
  }

  fn unlink(self &mut) {
    next = None[Node][];
  }

  fn final(self &uni) {
    results.passes.add(passes);
    if tallyToo.n != passes {
      results.mismatches.add(1u64);
    }
    results.finals.add(1u64);
  }
}

fn Node_dispatch(self &mut Node_state, msg Node_msg) {
  match msg {
    case imm m Node_msg.Link {self.link(m.n);}
    case imm m Node_msg.Token {self.token(m.left);}
    case is Node_msg.Unlink {self.unlink();}
  }
}

struct Node {
  mb Arc[opaq, actors.Mailbox[Node_msg]];

  pub fn start(collector Collector) Node {
    Node[actors.startActor[Node_state, Node_msg](Node_state.made(actors.sendable(collector)), &Node_dispatch)];
  }
  pub fn link(self &, n Node) {
    actors.send[Node_msg](mb, Node_msg.Link[n]);
  }
  pub fn token(self &, left u64) {
    actors.send[Node_msg](mb, Node_msg.Token[left]);
  }
  pub fn unlink(self &) {
    actors.send[Node_msg](mb, Node_msg.Unlink[]);
  }
}

// One round: whether everything came out exact
fn round(r u32) Bool {
  results.passes.store(0u64);
  results.mismatches.store(0u64);
  results.finals.store(0u64);
  {
    imm c = Collector.start();
    mut nodes = List[Node].empty();
    mut i = 0u64;
    while i < ringSize {
      nodes.push(Node.start(c));
      i = i + 1u64;
    }
    mut k = 0usize;
    while k < nodes.len() {
      nodes[k].link(*nodes[(k + 1usize) % nodes.len()]);
      c.join(*nodes[k]);
      k = k + 1usize;
    }
    k = 0usize;
    while k < usize[tokens] {
      nodes[k * 2usize].token(hops);
      k = k + 1usize;
    }
  }
  // Wait for the collector's death, the round's last
  while true {
    imm seen = results.rounds.load();
    if seen > r {
      break;
    }
    sync.futexWait(&results.rounds, seen);
  }
  results.passes.load() == tokens * (hops + 1u64)
    and results.mismatches.load() == 0u64
    and results.finals.load() == ringSize + 1u64;
}

// A decimal number's value, from its digits
fn digits(p *u8) u32 {
  mut n = 0u32;
  mut q = p;
  while *q >= 48u8 and *q <= 57u8 {
    n = n * 10u32 + u32[*q - 48u8];
    q = q + 1usize;
  }
  n;
}

fn main(argc i32, argv **u8) {
  initAll();
  mut workers = 4u32;
  if argc > 1i32 {
    workers = digits(*(argv + 1usize));
  }
  actors.configure(actors.Options[workers: workers]);
  mut bad = 0u64;
  mut r = 0u32;
  while u64[r] < rounds {
    if !round(r) {
      bad = bad + 1u64;
    }
    r = r + 1u32;
  }
  finalAll();
  printStr("rounds "); printUInt(rounds); printStr("\n");
  printStr("rounds not exact "); printUInt(bad); printStr("\n");
  printStr("messages handled "); printUInt(actors.stats().messages); printStr("\n");
}
