// What an actor made in place may not do stays refused where a variable's would
// be: an actor that does not conform to the trait is refused as a literal's field
// value though no variable names it, and a value that is no handle of the trait
// is a literal-field mismatch, not an array error.

mod concurrency_actor_trait_in_place_refused;

import actors;

actor trait Ear {
  pub async fn hear(self, n: u64);
}

actor Deaf {
  sum: u64;
  fn init(self: &new) {*self = Self(sum: 0u64);}
  pub async fn other(self) {sum = sum + 1u64;}
}

struct Holder {
  pub ear: Ear;
}

fn main() {
  let a = Holder(Deaf());   //~ ErrorActorTraitConform "Actor Deaf does not conform to actor trait Ear"
  let b = Holder(5u64);     //~ ErrorLitFieldType "does not match expected field's type"
}
