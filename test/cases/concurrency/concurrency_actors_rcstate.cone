// An actor whose state holds what may not cross threads, and whose handle
// crosses anyway. Keeper's state holds an 'Rc[mut, T]' log it has two owners
// of, and a 'So' owner of a note count, and its method changes both through
// borrows; it declares nothing about Sendable. Its handle, Keeper, owns the
// actor's Mailbox and nothing of the state, so it crosses:
//
// - main sends it, in a message, to an Auditor actor, which keeps it in its
//   own state and, on a worker, sends the keeper 100 notes through it;
// - main hands a copy of it to a thread, which sends 50 notes through it and
//   is joined.
//
// Every note arrives, both of the log's owners see the same sum, and the
// keeper is finalized once, on whichever thread let go last, after the
// auditor lets go of it. finalAll() waits for quiescence and stops the
// workers.
//
// The actors are declared. (concurrency_actors_state_unsendable writes such
// an actor's state out by hand, to show that the state itself is refused
// wherever it would cross.)

mod concurrency_actors_rcstate;

import stdio use *;
import collections use List;
import thread;
import actors;

struct Results {
  pub sum Atomic[u64];
  pub notes Atomic[u64];
  pub agree Atomic[u64];
  pub finals Atomic[u64];
}

imm results Results;

fn @initpure init() {
  results = new Results(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

struct Log {
  pub sum u64;
}

struct Count {
  pub n u64;
}

// ---- Keeper: its state holds Rc and So owners ----

actor Keeper {
  log Rc[mut, Log];
  logToo Rc[mut, Log];
  count So[Count];

  fn init(self &new) {
    imm l = new Rc[mut, Log](0u64);
    *self = new Self(l, l, new So[Count](0u64));
  }

  pub fn note(self, n u64) {
    imm c = &mut count.n;
    *c = *c + 1u64;
    add(&mut logToo.sum, n);
  }

  fn final(self &uni) {
    results.sum.add(log.sum);
    results.notes.add(count.n);
    if log.sum == logToo.sum {
      results.agree.add(1u64);
    }
    results.finals.add(1u64);
  }
}

// Add to a log's sum through a borrow of it
fn add(s &mut u64, n u64) {
  *s = *s + n;
}

// ---- Auditor: keeps keepers' handles in its state and uses them ----

actor Auditor {
  watched List[Keeper];

  fn init(self &new) {
    *self = new Self(List[Keeper].empty());
  }

  pub fn watch(self, k Keeper) {
    watched.push(k);
  }

  pub fn drive(self, times u64) {
    mut i = 0usize;
    while i < watched.len() {
      mut t = 1u64;
      while t <= times {
        watched[i].note(t);
        t = t + 1u64;
      }
      i = i + 1usize;
    }
  }

  pub fn forget(self) {
    watched.clear();
  }
}

// A thread's work: 50 notes, 1000 each, through the handle it was handed
fn fromThread(k Keeper) u64 {
  mut i = 0u64;
  while i < 50u64 {
    k.note(1000u64);
    i = i + 1u64;
  }
  i;
}

fn main() {
  initAll();
  actors.configure(new actors.Options(workers: 4u32));
  {
    imm k = new Keeper();
    imm a = new Auditor();
    a.watch(k);
    a.drive(100u64);
    a.forget();
    imm t = thread.start(k, &fromThread);
    imm sent = t.join();
    printStr("the thread sent "); printUInt(sent); printStr("\n");
  }
  finalAll();
  printStr("notes "); printUInt(results.notes.load()); printStr("\n");
  printStr("sum "); printUInt(results.sum.load()); printStr("\n");
  printStr("both owners agree "); printUInt(results.agree.load()); printStr("\n");
  printStr("keeper finalized "); printUInt(results.finals.load()); printStr("\n");
}
