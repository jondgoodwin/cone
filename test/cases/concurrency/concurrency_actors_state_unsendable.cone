// An actor's state is not Sendable when it holds what may not cross threads,
// and it declares nothing to say otherwise: Keeper_state holds an 'Rc[mut, T]'
// owner, so it is refused wherever it would cross as a value -- sent over a
// channel, handed to a thread -- as any struct holding one is
// (concurrency_typecheck_sendable). Only the runtime moves it, as part of the
// actor, behind the Mailbox, which declares Sendable on its own account.
// Keeper, the handle, owns that Mailbox and nothing of the state, so it
// crosses both ways the state may not: the lines without annotations compile.
// (concurrency_actors_rcstate runs such an actor.)
//
// The actor is written out by hand, in the shape an 'actor' declaration
// generates (compiler/c/parser/parseactor.c), because a declared actor's state
// has a name no source can spell: this drives the actors package's own
// machinery directly. The dispatch function is handed each message where it
// lies in its node, and moves each argument out of it.

mod concurrency_actors_state_unsendable;

import sync use *;
import thread;
import actors;

struct Log {pub n u64;}

enum Keeper_msg is Sendable {
  struct Note {pub n u64;}
}

struct Keeper_state {
  log Rc[mut, Log];

  fn init(self &new) {*self = new Keeper_state(new Rc[mut, Log](0u64));}

  fn note(self &mut, n u64) {log.n = log.n + n;}
}

fn Keeper_dispatch(self &mut Keeper_state, msg *Keeper_msg) {
  if &*msg is &Keeper_msg.Note {
    imm p = msg as *Keeper_msg.Note;
    self.note(mem.readRaw[u64](&(*p).n as *u64));
  }
}

struct Keeper {
  mb Arc[opaq, actors.Mailbox[Keeper_msg]];

  fn init(self &new) {
    imm st = actors.makeActor[Keeper_state, Keeper_msg](&Keeper_dispatch);
    mem.writeRaw[Keeper_state](st, new Keeper_state());
    *self = new Keeper(mb: actors.startActor[Keeper_state, Keeper_msg](st));
  }
  pub fn note(self &, n u64) {
    actors.send[Keeper_msg](mb, Keeper_msg.Note[n]);
  }
}

fn keepState(s Keeper_state) u64 {0u64;}
fn keepHandle(k Keeper) u64 {0u64;}

fn main() {
  // The state may not cross
  mut tx Sender[Keeper_state];   //~ ErrorNotSendable "Keeper_state.log is Rc[mut, Log], an owner whose permission, mut, is not race-safe"
  imm t = thread.start(new Keeper_state(), &keepState);   //~ ErrorNotSendable "start requires A is Sendable, and Keeper_state is not Sendable"

  // Its handle may
  mut htx Sender[Keeper];
  imm h = thread.start(new Keeper(), &keepHandle);
}
