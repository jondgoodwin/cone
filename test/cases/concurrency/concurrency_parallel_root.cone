// What a 'parallel each' that changes the items of a source may lend them from:
// something exclusive (concurrency_parallel_root_refused has the rest). Each case
// is worked out by hand.
//
//   - the measured race made safe: a zip reads list a and writes list b, which is taken
//     as '&uni', so no second name for b exists while the passes run; pass k reads a[k]
//     (k) and writes b[2k] and b[2k+1] (k + 1000), so with a of 4096 items the sum of b
//     is 2 * (4096 * 1000 + 0 + 1 + ... + 4095) = 2 * (4,096,000 + 8,386,560)
//     = 24,965,120, and b[0], b[1], b[8191] are 1000, 1000, 5095
//   - a local of the function, a field of one held by value, a struct lent '&uni' and its
//     field, a '&uni' slice of an array: pass k writes k + 1 to item k, so 100 items sum
//     to 5050
//   - a cursor made in a 'let' variable from a local, which the loop follows to the call
//     that made it: the same sum
//   - the caller side: two different locals lent '&uni' and '&' in one call (a 'mut'
//     local lends '&uni' since #520)

mod concurrency_parallel_root;

import stdio use *;
import collections use *;
import actors;

struct Item { pub n: i64; }

// Reads one list, writes another that nothing else names while the passes run
fn lift(a: &List[Item], b: &uni List[Item]) {
  parallel each i, x, pair in a.iter().zip(b.mutArrays[2usize]().mutItems()).indexed() {
    pair[0usize].n = x.n + 1000;
    pair[1usize].n = x.n + 1000;
  }
}

struct Grid {
  pub cells: List[Item];
}

// A field of a struct lent '&uni'
fn number(g: &uni Grid) {
  parallel each i, x in g.cells.mutItems().indexed() {
    x.n = i64.from(i) + 1;
  }
}

// An array's slice lent '&uni'
fn numberSlice(s: &uni Array[Item]) {
  parallel each i, x in s.mutItems().indexed() {
    x.n = i64.from(i) + 1;
  }
}

fn total(l: &List[Item]) i64 {
  var sum = 0i64;
  each x in l { sum = sum + x.n; }
  sum
}

fn filled(count: usize) List[Item] {
  var l = List[Item]();
  each i in 0usize ..< count { l.push(Item(0)); }
  l
}

fn main() {
  initAll();
  actors.configure(actors.Options(workers: 4u32));

  // ---- the zip, the written list taken as '&uni' ----
  var a = List[Item]();
  each i in 0usize ..< 4096usize { a.push(Item(i64.from(i))); }
  var b = filled(8192usize);
  lift(&a, &uni b);
  printInt(total(&b)); printStr(" sum of b (expect 24965120)\n");
  printInt(b[0usize].n); printStr(" "); printInt(b[1usize].n); printStr(" "); printInt(b[8191usize].n);
  printStr(" b[0] b[1] b[8191] (expect 1000 1000 5095)\n");

  // ---- a local ----
  var mine = filled(100usize);
  parallel each i, x in mine.mutItems().indexed() {
    x.n = i64.from(i) + 1;
  }
  printInt(total(&mine)); printStr(" local (expect 5050)\n");

  // ---- a field of a local held by value, and a struct lent '&uni' ----
  var grid = Grid(filled(100usize));
  parallel each i, x in grid.cells.mutItems().indexed() {
    x.n = i64.from(i) + 1;
  }
  printInt(total(&grid.cells)); printStr(" field of a local (expect 5050)\n");
  var grid2 = Grid(filled(100usize));
  number(&uni grid2);
  printInt(total(&grid2.cells)); printStr(" struct lent uni (expect 5050)\n");

  // ---- an array's slice ----
  var items: Array[Item, 100];
  numberSlice(&uni items);
  let seen: &Array[Item] = &items;
  var sliceSum = 0i64;
  each i in 0usize ..< 100usize { sliceSum = sliceSum + seen[i].n; }
  printInt(sliceSum); printStr(" array slice lent uni (expect 5050)\n");

  // ---- a cursor made in a let variable from a local ----
  var other = filled(100usize);
  let cursor = other.mutItems().indexed();
  parallel each i, x in cursor {
    x.n = i64.from(i) + 1;
  }
  printInt(total(&other)); printStr(" imm cursor from a local (expect 5050)\n");

  finalAll();
}
