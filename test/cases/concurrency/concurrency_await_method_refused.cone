// What the 'await' method convention refuses (concurrency_await_method has what
// it accepts):
//
// - a method named 'await' that takes more than 'self': it is called with no
//   argument for the wait (ErrorAwaitMethod);
// - one that gives neither an Awaitable[R] nor a Future[T]: the wait has no
//   operation to start and no future to park on (ErrorAwaitMethod);
// - a type whose 'await' is overloaded: said to be overloaded, not missing
//   (ErrorAwaitMethod);
// - a type with no such method, still ErrorAwaitNotFuture, the message
//   naming the method.

mod concurrency_await_method_refused;

import actors;

struct TakesMore {
  pub n: u64;
  pub fn await(self, extra: u64) actors.Awaitable[u64] {
    actors.Awaitable[u64].make(fn(rp: actors.ReplyOf[u64]) {})
  }
}

struct GivesNumber {
  pub n: u64;
  pub fn await(self) u64 {n}
}

struct Twice {
  pub n: u64;
  pub fn plain overload `await`(self) actors.Awaitable[u64] {
    actors.Awaitable[u64].make(fn(rp: actors.ReplyOf[u64]) {})
  }
  pub fn more overload `await`(self, extra: u64) actors.Awaitable[u64] {
    actors.Awaitable[u64].make(fn(rp: actors.ReplyOf[u64]) {})
  }
}

struct Nothing {
  pub n: u64;
}

actor Asker {
  pub async fn more(self) {
    let t = TakesMore(1u64);
    let v = await t;             //~ ErrorAwaitMethod "takes only 'self'"
  }

  pub async fn number(self) {
    let g = GivesNumber(1u64);
    let v = await g;             //~ ErrorAwaitMethod "the wait is on an Awaitable[R]"
  }

  pub async fn twice(self) {
    let t = Twice(1u64);
    let v = await t;             //~ ErrorAwaitMethod "is overloaded"
  }

  pub async fn none(self) {
    let x = Nothing(1u64);
    let v = await x;             //~ ErrorAwaitNotFuture "an 'await' method taking only 'self'"
  }
}

fn main() {}
