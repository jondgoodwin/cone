// A fold copies its 'init' as the accumulator each block starts from, so the
// type of 'init' must have no finalizer (a number, a plain struct): a String or a
// List copied would be freed twice. Asked of one, the fold is a panic naming the
// rule, after a fold of numbers on the same list ran.

mod concurrency_parallel_reduce_identity;

import stdio use *;
import collections use *;
import actors;

fn main() {
  actors.configure(new actors.Options(workers: 2u32));
  mut l = new List[i64]();
  mut i = 0i64;
  while i < 1000i64 {
    l.push(i);
    i = i + 1i64;
  }
  printStr("numbers ");
  printInt(l.parallel().fold(0i64, (acc, x) => acc + *x, (a, b) => a + b));
  printStr("\n");
  imm kept = l.parallel().fold(new List[i64](), (acc, x) => acc, (a, b) => a);
  printStr("not reached\n");
}
