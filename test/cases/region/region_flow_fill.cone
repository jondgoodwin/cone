// The count a fill literal cannot express for a counted reference.
//
// region_fill_count asserts the amount a fill adds when it can be worked out:
// n holders, or n-1 from a temporary. That amount is a constant in the injected
// alias node, so a count too large for the node to carry is refused rather than
// counted wrongly -- an undercount frees the allocation while the array still
// points at it.
//
// A fill literal's count is always known at compile time: its dimension must be
// a constant, and a count chosen at run time belongs to a List.

mod region_flow_fill;

fn fills() {
  imm r = +Rc-mut 7i32;
  imm many = [40000; r];              //~ ErrorFillCount "too many elements"
}
