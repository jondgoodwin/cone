// A tuple variable is one holder of each counted reference it carries, so
// destructuring it, copying it whole, or overwriting it counts as assigning
// each element would, and the variable releases its elements at scope exit.
//
// Destructuring straight from a call is the other spelling, and was already
// right: the call's temporary hands over the references it was born holding,
// and nothing is counted. Destructuring from a variable copies out of an lvalue
// that keeps its value, and each Rc element gains a holder -- the same '+1' a
// single-value 'a = t' gets. The releases are the balancing side: each new
// holder releases at scope exit, and so does the tuple variable itself, element
// by element. Without either half the run cannot tell: too few adjustments
// leak, too many free what is still held, and stdout shows neither. The
// register numbers in cases.toml were read out of the pre-optimization dump.
//
// 'twiceFromVariable' is the shape that was measured: two objects born at 1,
// destructured into four variables. Each object now gets two '+1' and three
// '-1', and is freed once, by the last release. Before, the elements were never
// counted and 't' never released, so four decrements freed each object twice.
//
// 'mixed' pairs an Rc reference with a plain value: only the reference is
// counted, the integer is copied and nothing else.
//
// 'wholeCopy' copies the tuple without destructuring it, once into a new
// variable and once over a variable that already holds one, which is what
// releases the previous value.
//
// 'soFromVariable' and 'soWholeVariable' are the 'Uni' spelling. A tuple carrying
// a 'Uni' reference is a move type, so destructuring it moves each element to
// its new owner and deactivates 't', so a later use of 't' is refused and the
// scope releases nothing of 't': the two frees are the owners'. Left in its
// variable, the tuple is the owner, and the scope frees both elements through
// it.
//
// 'aliasTrioFromVariable' and 'soAliasFromVariable' are the same two claims with
// the tuple type named by an alias. An alias is transparent and nothing
// rewrites it away, so a return type written this way stands in the IR as the
// name it was written with, and both the type check and the flow pass have to
// resolve it to find the element list. Three elements rather than two, so its
// registers are its own; the adjustments are the same per element as
// 'twiceFromVariable' gets, which is the claim -- an alias counts exactly as the
// spelled-out type does.

mod region_tuple_destructure;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn pair() Rc[mut, i32], Rc[mut, i32] {
  let a = new Rc[mut, i32](1);
  let b = new Rc[mut, i32](2);
  a, b
}

fn twiceFromVariable() {
  let t = pair();
  let a: Rc[mut, i32];
  let b: Rc[mut, i32];
  let c: Rc[mut, i32];
  let d: Rc[mut, i32];
  a, b = t;
  c, d = t;
  show("rc-destructured-twice", i64.from(*a + *b + *c + *d));
}

fn pairMixed() Rc[mut, i32], i32 {
  let a = new Rc[mut, i32](10);
  a, 5i32
}

fn mixed() {
  let t = pairMixed();
  let a: Rc[mut, i32];
  let n: i32;
  let b: Rc[mut, i32];
  let m: i32;
  a, n = t;
  b, m = t;
  show("rc-and-plain-destructured-twice", i64.from(*a + n + *b + m));
}

fn wholeCopy() {
  let t = pair();
  let u = t;
  var v = t;
  v = u;
  show("tuple-copied-whole", i64.from(*u.0 + *v.1));
}

fn pairUni() Uni[i32], Uni[i32] {
  let a = new Uni[i32](100);
  let b = new Uni[i32](200);
  a, b
}

fn soFromVariable() {
  let t = pairUni();
  let a: Uni[i32];
  let b: Uni[i32];
  a, b = t;
  show("so-destructured", i64.from(*a + *b));
}

fn soWholeVariable() {
  let t = pairUni();
  show("so-left-in-tuple", i64.from(*t.0 + *t.1));
}

alias RcTrio = (Rc[mut, i32], Rc[mut, i32], Rc[mut, i32]);
alias UniPair = (Uni[i32], Uni[i32]);

fn trioAlias() RcTrio {
  let a = new Rc[mut, i32](3);
  let b = new Rc[mut, i32](4);
  let c = new Rc[mut, i32](5);
  a, b, c
}

fn aliasTrioFromVariable() {
  let t = trioAlias();
  let a: Rc[mut, i32];
  let b: Rc[mut, i32];
  let c: Rc[mut, i32];
  let d: Rc[mut, i32];
  let e: Rc[mut, i32];
  let f: Rc[mut, i32];
  a, b, c = t;
  d, e, f = t;
  show("alias-rc-destructured-twice", i64.from(*a + *b + *c + *d + *e + *f));
}

fn pairUniAlias() UniPair {
  let a = new Uni[i32](1000);
  let b = new Uni[i32](2000);
  a, b
}

fn soAliasFromVariable() {
  let t = pairUniAlias();
  let a: Uni[i32];
  let b: Uni[i32];
  a, b = t;
  show("alias-so-destructured", i64.from(*a + *b));
}

fn main() i32 {
  twiceFromVariable();
  mixed();
  wholeCopy();
  soFromVariable();
  soWholeVariable();
  aliasTrioFromVariable();
  soAliasFromVariable();
  0i32
}
