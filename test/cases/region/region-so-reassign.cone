// Assigning to a variable that already holds an owning reference releases the
// value it held, in region 'so' as in 'rc': freed once, before the store, in
// every spelling the store has -- a single reference, a slice, a field, and each
// iteration of a loop. A variable that holds nothing releases nothing first:
// one declared without a value, and one whose value was moved out.
//
// genlStore released a previous value only for an 'rc' reference, so every
// reassignment of an 'so' variable leaked what it held. It now hands the old
// value to the same release scope exit uses. The gate is FlagFirstAssign, which
// flow sets on the assignment site when the variable was never initialized;
// a moved-out variable holds nothing either, and the flag now says so too --
// for 'so', where a move is the ordinary hand-over, and for a 'uni' 'rc'
// reference, whose count the reassignment used to drop a second time.

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn take(p +so i32) i64 {
  i64[*p];
}

fn takeUni(p +rc-uni i32) i64 {
  i64[*p];
}

fn firstAssign() {
  mut p +so i32;
  p = +so 1;
  show("first-assignment", i64[*p]);
}

fn reassign() {
  mut p = +so 1;
  p = +so 2;
  show("reassigned", i64[*p]);
}

fn reassignAfterMove() {
  mut p = +so 1;
  imm t = take(p);
  p = +so 2;
  show("reassigned-after-move", i64[*p] + t);
}

fn uniReassignAfterMove() {
  mut p = +rc-uni 1;
  imm t = takeUni(p);
  p = +rc-uni 2;
  show("uni-reassigned-after-move", i64[*p] + t);
}

fn loopAssign() {
  mut p = +so 0;
  mut i = 0;
  while i < 3 {
    p = +so i;
    i = i + 1;
  }
  show("reassigned-in-loop", i64[*p]);
}

fn sliceReassign() {
  mut a = +[]so [4; 7];
  a = +[]so [2; 8];
  show("slice-reassigned", i64[a[1]]);
}

struct Holder {
  pub p +so i32;
}

fn fieldReassign() {
  mut s = Holder[+so 1];
  s.p = +so 2;
  show("field-reassigned", i64[*s.p]);
}

fn main() i32 {
  firstAssign();
  reassign();
  reassignAfterMove();
  uniReassignAfterMove();
  loopAssign();
  sliceReassign();
  fieldReassign();
  0i32;
}
