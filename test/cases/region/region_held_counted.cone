// A value holding a counted reference -- a struct in a field, a tuple or an
// array in an element, however deep -- releases it when it dies, so a copy of
// that value is one more holder of it: its region's 'aliasRef' is called for the
// copy, as for a copy of the reference itself, or each copy's death would
// release the one holder again.
//
// Before, a struct held by value never released its counted field and a tuple
// or array holding a struct was never finalized, so a copy needed no count --
// and got none, leaking the holder the struct was built with. A tuple literal
// copied a counted reference out of a variable without counting it at all,
// and its variable then released that reference a second time: 'imm t = (r,
// 5)' took the count below zero. Each element of a tuple literal is now copied
// on its own, as a struct literal's fields are.
//
// An array's contents repeating a value evaluate it for each element, so a
// variable holding a counted reference is copied into each, one more holder
// per element, and a tuple built from one copies it into each tuple; an
// allocation repeated is a new allocation for each element, which holds the
// one owner it was born with.
//
// 'Tally' prints every count change: '+n' after an 'aliasRef', '-n' after a
// 'dealiasRef', 'tfree' when the count reaches zero, and 'F<n>' is the counted
// value's 'final'. Every line is worked out by hand: one holder at the
// allocation, one more per copy, one fewer per holder going away, locals dying
// newest first.

mod region_held_counted;

import stdio use *;
import libc;

struct Tally is RegionRef {
  owners usize;
  fn alloc(size usize) *u8 inline { malloc(size); }
  fn init(self &new) inline { *self = new Tally(1usize); }
  fn aliasRef(self &uni Tally) inline { owners = owners + 1usize; printStr("+"); printInt(i64.from(owners)); printStr(" "); }
  fn dealiasRef(self &uni Tally) bool inline { owners = owners - 1usize; printStr("-"); printInt(i64.from(owners)); printStr(" "); owners == 0usize; }
  fn free(self &uni Tally) inline { printStr("tfree "); libc.free(self as *u8); }
}

struct Fin {
  pub n i64;
  fn final(self &uni) { printStr("F"); printInt(n); printStr(" "); }
}

struct Shared { pub r Tally[mut, Fin]; }
struct SharedArray { pub a Array[Tally[mut, Fin], 2]; }

fn show(label &[]u8) { printStr(label); printStr(": "); }
fn end() { printStr("|\n"); }

fn take(s Shared) { printStr("in "); }

fn structAlone() { imm s = new Shared(new Tally[mut, Fin](1)); }
fn structCopied() { imm s = new Shared(new Tally[mut, Fin](1)); imm t = s; }
fn structPassed() { imm s = new Shared(new Tally[mut, Fin](1)); take(s); }
fn structLiteral() { imm r = new Tally[mut, Fin](1); imm s = new Shared(r); }
fn arrayCopied() { imm a = [new Tally[mut, Fin](1), new Tally[mut, Fin](2)]; imm b = a; }
fn arrayFieldCopied() { imm s = new SharedArray([new Tally[mut, Fin](1), new Tally[mut, Fin](2)]); imm t = s; }
fn tupleCopied() { imm t = (new Shared(new Tally[mut, Fin](1)), 2i64); imm u = t; }
fn tupleLiteral() { imm r = new Tally[mut, Fin](1); imm t = (r, 5i64); }
fn destructured() { imm t = (new Shared(new Tally[mut, Fin](1)), 2i64); imm a Shared; imm n i64; a, n = t; }
fn optionCopied() { imm o Option[Shared] = Some[Shared][new Shared(new Tally[mut, Fin](1))]; imm p = o; }
fn fillVariable() { imm s = new Shared(new Tally[mut, Fin](1)); imm a = new Array[Shared, 3] <- fill s; }
fn fillTuple() { imm r = new Tally[mut, Fin](1); imm a = new Array[(Tally[mut, Fin], i64), 2] <- fill (r, 5i64); }
fn fillAllocated() { imm a = new Array[Tally[mut, Fin], 2] <- fill new Tally[mut, Fin](3); }
// Past a handful of copies the repeated value is generated once, in a loop,
// which copies or allocates as each element did
fn fillVariableLooped() { imm s = new Shared(new Tally[mut, Fin](1)); imm a = new Array[Shared, 17] <- fill s; }
fn fillAllocatedLooped() { imm a = new Array[Tally[mut, Fin], 17] <- fill new Tally[mut, Fin](4); }

fn main() i32 {
  show("struct-alone"); structAlone(); end();
  show("struct-copied"); structCopied(); end();
  show("struct-passed"); structPassed(); end();
  show("struct-literal"); structLiteral(); end();
  show("array-copied"); arrayCopied(); end();
  show("array-field-copied"); arrayFieldCopied(); end();
  show("tuple-copied"); tupleCopied(); end();
  show("tuple-literal"); tupleLiteral(); end();
  show("destructured"); destructured(); end();
  show("option-copied"); optionCopied(); end();
  show("fill-variable"); fillVariable(); end();
  show("fill-tuple"); fillTuple(); end();
  show("fill-allocated"); fillAllocated(); end();
  show("fill-variable-looped"); fillVariableLooped(); end();
  show("fill-allocated-looped"); fillAllocatedLooped(); end();
  0;
}
