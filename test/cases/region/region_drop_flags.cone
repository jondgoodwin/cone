// An owning reference whose state differs by path at its release carries a
// drop flag, as any finalizing value does (move_drop_flags): the release at
// its scope's end, or at a store over it, runs only on the paths that still
// hold it, and so its region's death -- the value's finalizer, then 'free' --
// or, for a counted owner, its 'dealiasRef', happens once.
//
// - A sole owner moved on one branch; moved whole by one branch of an 'if'
//   used as a value (before drop flags, freed and finalized twice on the
//   path that moved it: heap corruption); given a value on one branch only
//   (before, a garbage pointer freed on the other).
// - A counted owner moved on one branch: its count balances either way, so
//   'free' runs exactly once.
// - A struct holding an owner, a tuple and an array of owners, each moved on
//   one branch.
// - A sole owner reassigned in a loop after a move in an earlier pass.
// - A sole owner assigned its own value, directly or through an 'if' that
//   hands it back on one branch: the value leaves before the store, so the
//   store releases nothing it still is (before, it freed the value it then
//   stored: heap corruption).
//
// The regions print what they do, so the output is the whole assertion.

mod region_drop_flags;

import stdio use *;
import libc;

struct One is RegionRef, Move {
  fn alloc(size usize) *u8 inline { malloc(size); }
  fn free(self &uni One) inline { printStr("free "); libc.free(self as *u8); }
}

struct Cnt is RegionRef {
  owners usize;
  fn alloc(size usize) *u8 inline { malloc(size); }
  fn init(self &new) inline { *self = new Cnt(1usize); }
  fn aliasRef(self &uni Cnt) inline { owners = owners + 1usize; }
  fn dealiasRef(self &uni Cnt) Bool inline { printStr("dealias "); owners = owners - 1usize; owners == 0usize; }
  fn free(self &uni Cnt) inline { printStr("cfree "); libc.free(self as *u8); }
}

struct Fin {
  pub v i32;
  fn final(self &uni) { printStr("F"); printInt(i64.from(v)); printStr(" "); }
}
struct Owns { pub p One[Fin]; pub n i32; }

fn cond(b Bool) Bool { b; }
fn takeOne(p One[Fin]) { printStr("take "); }
fn takeCnt(p Cnt[Fin]) { printStr("take "); }
fn takeOwns(o Owns) { printStr("take "); }
fn takePair(t (One[Fin], One[Fin])) { printStr("take "); }
fn takeArray(a Array[One[Fin], 2]) { printStr("take "); }
fn line(label &[]u8) { printStr("| "); printStr(label); printStr("\n"); }

fn soleMoved(c Bool) { imm b = +One Fin[1]; if cond(c) { takeOne(b); } printStr("end "); }
fn soleHandedOn(c Bool) { imm b = +One Fin[2]; imm y = if cond(c) { b; } else { +One Fin[0]; }; printStr("end "); }
fn soleGivenOnOne(c Bool) { mut p One[Fin]; if cond(c) { p = +One Fin[3]; } printStr("end "); }
fn countedMoved(c Bool) { imm r = +Cnt Fin[4]; if cond(c) { takeCnt(r); } printStr("end "); }
fn structMoved(c Bool) { imm o = new Owns(+One Fin[5], 1); if cond(c) { takeOwns(o); } printStr("end "); }
fn tupleMoved(c Bool) { imm t = (+One Fin[6], +One Fin[7]); if cond(c) { takePair(t); } printStr("end "); }
fn arrayMoved(c Bool) { imm a = [+One Fin[8], +One Fin[9]]; if cond(c) { takeArray(a); } printStr("end "); }
fn reassignedAfterMove() {
  mut b = +One Fin[10];
  mut i = 1;
  while i < 4 {
    if i == 2 { takeOne(b); }
    b = +One Fin[10 + i];
    i = i + 1;
  }
  printStr("end ");
}

fn selfAssigned() { mut p = +One Fin[20]; p = p; printStr("end "); }
fn selfThroughIf(c Bool) { mut p = +One Fin[21]; imm q = +One Fin[22]; p = if cond(c) {p;} else {q;}; printStr("end "); }

fn main() i32 {
  soleMoved(true); line("sole owner moved");
  soleMoved(false); line("sole owner kept");
  soleHandedOn(true); line("sole owner handed on by an if");
  soleHandedOn(false); line("sole owner kept by an if");
  soleGivenOnOne(true); line("sole owner given a value");
  soleGivenOnOne(false); line("sole owner never given one");
  countedMoved(true); line("counted owner moved");
  countedMoved(false); line("counted owner kept");
  structMoved(true); line("struct holding an owner moved");
  structMoved(false); line("struct holding an owner kept");
  tupleMoved(true); line("tuple of owners moved");
  tupleMoved(false); line("tuple of owners kept");
  arrayMoved(true); line("array of owners moved");
  arrayMoved(false); line("array of owners kept");
  reassignedAfterMove(); line("reassigned after a move in an earlier pass");
  selfAssigned(); line("assigned its own value");
  selfThroughIf(true); line("assigned its own value through an if");
  selfThroughIf(false); line("assigned another's value through an if");
  0i32;
}
