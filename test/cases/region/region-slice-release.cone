// An owning slice is released when the scope of the variable holding it ends,
// by whichever owner holds it then. A '+[]so' slice is freed once: moved into
// another variable, into a parameter or out through a return, the source
// releases nothing and the new owner does. A '+[]rc-mut' slice copied into a
// second variable counts the second holder and is freed when the last one goes;
// reassigning one releases the value it held.
//
// flowScopeDealias lists a variable for release by its type. A slice's type is
// ArrayRefTag, which it once passed over, so no owning slice was ever freed;
// generation now extracts the pointer word of the fat {T*, usize} value before
// the release the single-reference forms already had.

import stdio.*;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn soScope() {
  imm a = +[]so [4; 7];
  show("so-scope", i64[a[1]]);
}

fn rcCopied() {
  imm a = +[]rc-mut [4; 8];
  imm b = a;
  show("rc-copied", i64[a[2]] + i64[b[2]]);
}

fn soMoved() {
  imm a = +[]so [4; 9];
  imm b = a;
  show("so-moved", i64[b[0]]);
}

fn takeSo(s +[]so i32) i64 {
  i64[s[3]];
}

fn soArgument() {
  imm a = +[]so [4; 10];
  show("so-argument", takeSo(a));
}

fn makeSo() +[]so i32 {
  imm a = +[]so [4; 11];
  a;
}

fn soReturned() {
  imm r = makeSo();
  show("so-returned", i64[r[1]]);
}

fn rcReassigned() {
  mut a = +[]rc-mut [4; 12];
  a = +[]rc-mut [2; 13];
  show("rc-reassigned", i64[a[1]]);
}

fn main() i32 {
  soScope();
  rcCopied();
  soMoved();
  soArgument();
  soReturned();
  rcReassigned();
  0i32;
}
