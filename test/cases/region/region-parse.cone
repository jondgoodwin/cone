// The two things '+' requires the parser to find: a region name, and -- once a
// '-' has been written -- a permission after it.
//
// Both sites abandon the '+' term and return an incomplete reference node, so
// each drags one ErrorNoSemi behind it as the statement's remainder is
// resynchronized. Each case is in its own function so that recovery from one
// cannot reach the next.

fn missingRegion() {
  imm x = + 5                  //~ ErrorBadTerm "Expected region annotation"
                               //~^ ErrorNoSemi follow-on
}

fn missingPermission() {
  imm y = +rc-5                //~ ErrorBadTerm "Expected permission annotation"
                               //~^ ErrorNoSemi follow-on
}

// A well-formed allocation, so the file's last declaration is not itself the
// thing being recovered from
fn wellFormed() {
  imm z = +rc-mut 7
}
