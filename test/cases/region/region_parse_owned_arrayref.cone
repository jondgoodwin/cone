// There is no owning array reference. A managed reference is thin or virtual;
// a statically sized array is reached by a thin one, its size in the type
// ('Uni[Array[i32, 4]]'); and an array whose length is chosen at run time is the
// body 'Array[T]' held by a fat reference ('Uni[Array[T]]', shared 'Rc[Array[T]]'),
// or a growable List. A borrowed slice, '&Array[T]', is untouched.
//
// '+[]' stays a token only so that it can be refused, once, at the token,
// wherever it is written -- a type or an allocation -- and read through as the
// thin form, so that nothing after it is reported as well.

mod region_parse_owned_arrayref;

alias Owned = +[]Uni i32;                    //~ ErrorOwnedArrayRef:15 "an owned run-time-sized array is a 'Uni[Array[T]]', shared as 'Rc[Array[T]]'"

struct Holder {
  pub items: +[]Rc-mut i32;                  //~ ErrorOwnedArrayRef:14 "There is no owning array reference '+[]'"
}

fn takes(s: +[]Uni i32) { }                   //~ ErrorOwnedArrayRef:13 "a borrowed slice is '&Array[T]'"

fn gives() +[]Rc i32 {                      //~ ErrorOwnedArrayRef:12 "There is no owning array reference"
  let a = +[]Rc [1i32, 2i32, 3i32];         //~ ErrorOwnedArrayRef:11 "There is no owning array reference"
  a
}

fn generic[T](s: &+[]Uni T) T { (*s)[0] }    //~ ErrorOwnedArrayRef:19 "There is no owning array reference"

fn filled(n: usize) {
  let f = +[]Uni [n, 0usize];                //~ ErrorOwnedArrayRef:11 "There is no owning array reference"
}

// A borrowed slice of an array, which stays
fn borrowed() {
  var arr = [1i32, 2i32, 3i32];
  let s = &[]mut arr;
  s[0] = 4i32;
}
