// There is no owning array reference. A managed reference is thin or virtual;
// a statically sized array is reached by a thin one, its size in the type
// ('So[Array[i32, 4]]'); and an array whose length is chosen at run time is the
// body 'Array[T]' held by a fat reference ('So[Array[T]]', shared 'Rc[Array[T]]'),
// or a growable List. A borrowed slice, '&Array[T]' (or '&[]T'), is untouched.
//
// '+[]' stays a token only so that it can be refused, once, at the token,
// wherever it is written -- a type or an allocation -- and read through as the
// thin form, so that nothing after it is reported as well.

mod region_parse_owned_arrayref;

alias Owned = +[]So i32;                    //~ ErrorOwnedArrayRef:15 "an owned run-time-sized array is a 'So[Array[T]]', shared as 'Rc[Array[T]]'"

struct Holder {
  pub items +[]Rc-mut i32;                  //~ ErrorOwnedArrayRef:13 "There is no owning array reference '+[]'"
}

fn takes(s +[]So i32) { }                   //~ ErrorOwnedArrayRef:12 "a borrowed slice is '&Array[T]'"

fn gives() +[]Rc i32 {                      //~ ErrorOwnedArrayRef:12 "There is no owning array reference"
  imm a = +[]Rc [1i32, 2i32, 3i32];         //~ ErrorOwnedArrayRef:11 "There is no owning array reference"
  a;
}

fn generic[T](s &+[]So T) T { (*s)[0]; }    //~ ErrorOwnedArrayRef:18 "There is no owning array reference"

fn filled(n usize) {
  imm f = +[]So [n, 0usize];                //~ ErrorOwnedArrayRef:11 "There is no owning array reference"
}

// A borrowed slice of an array, which stays
fn borrowed() {
  mut arr = [1i32, 2i32, 3i32];
  imm s = &[]mut arr;
  s[0] = 4i32;
}
