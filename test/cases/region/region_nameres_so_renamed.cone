// The single-owner region was called 'So' before it was called 'Uni'. No alias of
// the old name is kept, so it is an unknown name like any other, and the message
// says what it became.

mod region_nameres_so_renamed;

fn param(a: So[i32]) {}                  //~ ErrorUnkName "So is now Uni"

fn make() {
  let a = So[i32](1);               //~ ErrorUnkName "So is now Uni"
}
