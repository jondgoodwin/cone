// What 'new' and 'trynew' refuse about an allocation. An allocation is
// written with 'new', its managed reference type, and in the parentheses its
// init's arguments, 'new Rc[mut, Node](1)', or a finished value, 'new
// Rc[i32](5)': every '+' spelling of one, plain or fallible, whatever its
// value, is refused naming that form. 'trynew' is an allocation that may fail,
// so it takes a managed reference type and nothing else. 'new' cannot allocate
// what no region holds: a borrowed reference, made by borrowing; nor a trait,
// which has no value of its own. A type no init constructs takes exactly one
// value of it, which must be one.
//
// region_new and region_new_value hold what is accepted; trait_nameres the
// retired '+<'.

mod region_typecheck_new;

struct Node { pub v i64; }

// A struct that says it is a region only by its methods
struct Unmarked {
  fn alloc(size usize) *u8 inline { malloc(size) }
}

fn make() i64 { 1 }
struct Point { pub x i64; pub y i64; }
alias Lent = &Node;

trait Shape { pub fn area(self &) i64; }

fn f() {
  let a = +Rc-mut Node[1];       //~ ErrorPlusAlloc "written 'new Rc[mut, Node](...)'"
  let b = +Uni Node[2];           //~ ErrorPlusAlloc "written 'new Uni[Node](...)'"
  let c = ?+Rc Node[3];          //~ ErrorPlusAlloc:12 "written 'trynew Rc[Node](...)'"
  let d = +Rc-mut new Node(4);   //~ ErrorPlusAlloc "written 'new Rc[mut, Node](...)'"
  let e = trynew Point(1, 2);    //~ ErrorTryNewValue "Point is not a managed reference type"
  let g = trynew i64(5);         //~ ErrorTryNewValue "i64 is not a managed reference type"
  let h = new Lent(6);           //~ ErrorNewType "a borrowed reference has none"
  let i = new Rc[mut, Shape](7); //~ ErrorNewType "has no value to construct"
}

// Every '+' allocation, whatever its value, names the 'new' form
fn plus() {
  let n = 7i64;
  let j = +Rc 5;                 //~ ErrorPlusAlloc "written 'new Rc[i32](value)'"
  let k = ?+Rc-mut 6i64;         //~ ErrorPlusAlloc:12 "written 'trynew Rc[mut, i64](value)'"
  let l = +Uni n;                 //~ ErrorPlusAlloc "written 'new Uni[i64](value)'"
  let m = +Rc-imm make();        //~ ErrorPlusAlloc "written 'new Rc[imm, i64](value)'"
  let o = +Rc-mut [1, 2, 3];     //~ ErrorPlusAlloc "written 'new Rc[mut, T](value)', the value in the parentheses, T an array"
  let p = +Uni (1, 2);            //~ ErrorPlusAlloc "T a tuple"
  let q = +Uni Some[i64](3);      //~ ErrorPlusAlloc "written 'new Uni[Some](value)'"
  let r = +Unmarked-mut 1i64;    //~ ErrorPlusAlloc "written 'new Unmarked[mut, i64](value)'"
                                 //~^ ErrorNotRegion "Unmarked is not a region" follow-on
}

// A type no init constructs takes one value of it, which must be one
fn values() {
  let p = new Point(1, 2);
  let a = new Rc[i64](1, 2);     //~ ErrorAllocValue "i64 is not constructed by an init"
  let b = new Uni[i64]();         //~ ErrorAllocValue "i64 is not constructed by an init"
  let c = new Uni[i64](v: 1);     //~ ErrorAllocValue "i64 is not constructed by an init"
  let d = new Rc[mut, Array[i64, 2]](1, 2); //~ ErrorAllocValue "an array is not constructed by an init"
  let e = new Uni[Option[i64]]();  //~ ErrorAllocValue "Option is not constructed by an init"
  let f = new Rc[f64](p);        //~ ErrorInvType "the type the allocation names: f64"
  let g = new Uni[(i64, i64)](5); //~ ErrorInvType "the type the allocation names: a tuple"
}

// A struct's one argument is its finished value only when its type is the
// struct itself: a reference to one, or another struct, goes to the inits,
// here the implicit one, which wants both fields
fn notFinished() {
  let p = new Point(1, 2);
  let a = new Rc[Point](&p);     //~ ErrorBadArray "Not enough values"
  let n = new Node(1);
  let b = new Uni[Point](n);      //~ ErrorBadArray "Not enough values"
}
