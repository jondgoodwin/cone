// An allocation's contents are refused as its value construction's are: an
// array is filled exactly, one written with several sizes with its scalars,
// and its contents follow '<-', so the allocation of one takes nothing in
// parentheses besides them.
//
// Contents after a 'trynew' are built only for an array's allocation, filled
// in place when the memory was had. Any other 'trynew' with contents is
// refused once, with its own code, and nothing after it reports again: the
// collection is allocated with 'trynew' alone and appended to on Some.
//
// A type written where the receiver of '<-' stands, with no parentheses, is
// refused and the form that works is named: an owner of Array[T] or str takes
// no contents and copies a borrow, and what does take contents takes them
// after its parentheses.
//
// What the same contents refuse on a value construction is the array group's
// (array_typecheck_contents, array_typecheck_scalars).

mod region_typecheck_contents;

import collections use *;

fn f() {
  let few = Rc[mut, Array[i32, 4]]() <- 1, 2;                          //~ ErrorArrayContents:38 "give 2 values, and the array holds 4"
  let rows = Uni[Array[i32, 2, 3]]() <- fill Array[i32, 3]() <- (1, 2, 3);   //~ ErrorInvType:62 "filled with its scalars, i32, row by row, not with its rows"
  let args = Rc[mut, Array[i32, 4]](5) <- fill 0;                   //~ ErrorArrayContents:14 "has no init to take arguments"
  let huge = Rc[mut, Array[u8, 65536, 65536]]() <- fill 0u8;          //~ ErrorArrayContents:49 "more than 4294967295 of them"
}

fn noParens() {
  let bytes = Uni[Array[u8]] <- 104u8, 105u8;                           //~ ErrorNotTyped "an owner of it copies a borrow of one, 'Uni[Array[u8]](view)'"
  let shared = Rc[Array[u8]] <- 3 of 1u8;                               //~ ErrorNotTyped "an owner of it copies a borrow of one, 'Rc[Array[u8]](view)'"
  Uni[str] <- 104u8, 105u8;                                             //~ ErrorNotTyped "an owner of it copies a borrow of one, 'Uni[str](view)'"
  let body = Array[u8] <- fill 1u8;                                     //~ ErrorNotTyped "an owner of it copies a borrow of one, 'Uni[Array[u8]](view)'"
  let pair = Uni[Array[u8, 2]] <- 104u8, 105u8;                         //~ ErrorNotTyped "after its parentheses: 'Uni[Array[u8, 2]]() <- ...'"
  let four = Array[i32, 4] <- fill 1;                                   //~ ErrorNotTyped "after its parentheses: 'Array[i32, 4]() <- ...'"
  let number = i32 <- 1, 2;                                             //~ ErrorNotTyped "is a type, not a value: a type's name stands for no value"
}

// A type standing as a statement is no value either, however it is written
struct Pair[T] { first: T; }
fn typeStatements() {
  *i32;                                                                 //~ ErrorNotTyped "is a type, not a value"
  &i32;                                                                 //~ ErrorNotTyped "is a type, not a value"
  Uni[Array[u8]];                                                       //~ ErrorNotTyped "is a type, not a value"
  Array[u8, 2];                                                         //~ ErrorNotTyped "is a type, not a value"
  Pair[i32];                                                            //~ ErrorNotTyped "is a type, not a value"
  (i32, i32);                                                           //~ ErrorNotTyped "is a type, not a value"
  *u8;                                                                  //~ ErrorNotTyped "is a type, not a value"
}

fn fallible() {
  let list = trynew Rc[mut, List[i32]](10) <- 1, 2, 3;                  //~ ErrorTryNewContents:44 "built only for an array's allocation"
  let one = trynew Rc[mut, List[i32]](10) <- 4;                         //~ ErrorTryNewContents:43 "then append on Some"
}
