// An allocation's contents are refused as its value construction's are: an
// array is filled exactly, one written with several sizes with its scalars,
// and its contents follow '<-', so the allocation of one takes nothing in
// parentheses besides them.
//
// What the same contents refuse on a value construction is the array group's
// (array_typecheck_contents, array_typecheck_scalars).

mod region_typecheck_contents;

fn f() {
  imm few = new Rc[mut, Array[i32, 4]] <- 1, 2;                          //~ ErrorArrayContents:40 "give 2 values, and the array holds 4"
  imm rows = new So[Array[i32, 2, 3]] <- fill new Array[i32, 3] <- (1, 2, 3);   //~ ErrorInvType:65 "filled with its scalars, i32, row by row, not with its rows"
  imm args = new Rc[mut, Array[i32, 4]](5) <- fill 0;                   //~ ErrorArrayContents:14 "has no init to take arguments"
  imm huge = new Rc[mut, Array[u8, 65536, 65536]] <- fill 0u8;          //~ ErrorArrayContents:51 "more than 4294967295 of them"
}
