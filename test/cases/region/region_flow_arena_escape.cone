// A reference into an arena held in a local -- a scratch arena -- may not
// leave the arena's life by any route the borrow rules check. The arena
// package's 'a.alloc(v)' returns a '&mut' borrow no longer-lived than the
// borrow of 'a' it was called through, so the rules for any borrow of a local
// apply to it: it may not be returned from the function holding the arena,
// alone, through a variable, in a tuple, or back through a call that
// allocated it; nor stored in a caller's value reached through a parameter,
// or a value of a longer-lived arena; nor kept past the arena in an outer
// variable, a field or an element of one, and used there. A value built around
// an allocation -- a struct, an 'Rc' owning one -- carries the arena's loan,
// and so does one read back out of a list of the arena's, and may not be
// returned or stored through a parameter either. The arena
// package's own tests (packages/arena/tests/scratch.cone) run what a scratch
// may do.
//
// The arena may not be moved, replaced or ended while an allocation held in a
// local, bare or inside a value built around it, is still used:
// region_flow_arena_freeze.

mod region_flow_arena_escape;

import arena use *;
import collections use *;

struct Pt { pub x i64; pub y i64; }
struct Holder { pub r &mut Pt; }

fn returned() &mut Pt {
  mut a = Arena.empty();
  a.alloc(new Pt(1, 2));        //~ ErrorEscape:4 "outlives"
}

fn returnedVar() &mut Pt {
  mut a = Arena.empty();
  imm p = a.alloc(new Pt(1, 2));
  p;                            //~ ErrorEscape:3 "outlives"
}

fn returnedInTuple() (&mut Pt, i64) {
  mut a = Arena.empty();
  (a.alloc(new Pt(1, 2)), 3i64);  //~ ErrorEscape:5 "outlives"
}

fn allocFor(a &mut Arena) &mut Pt { a.alloc(new Pt(9, 9)); }

fn returnedThroughCall() &mut Pt {
  mut a = Arena.empty();
  allocFor(&mut a);             //~ ErrorEscape:11 "outlives"
}

// Kept in an outer variable, or a field or an element of one, past the arena
// and used there
fn outerVariable() i64 {
  mut dummy = new Pt(0, 0);
  mut r = &mut dummy;
  {
    mut a = Arena.empty();      //~ ErrorFrozen "goes out of scope"
    r = a.alloc(new Pt(1, 2));
  }
  r.x;
}

fn outerField() i64 {
  mut dummy = new Pt(0, 0);
  mut h = new Holder(&mut dummy);
  {
    mut a = Arena.empty();      //~ ErrorFrozen "goes out of scope"
    h.r = a.alloc(new Pt(1, 2));
  }
  h.r.x;
}

fn outerElement() i64 {
  mut dummy = new Pt(0, 0);
  mut dummy2 = new Pt(0, 0);
  mut arr = [&mut dummy, &mut dummy2];
  {
    mut a = Arena.empty();      //~ ErrorFrozen "goes out of scope"
    arr[0] = a.alloc(new Pt(1, 2));
  }
  arr[1].x;
}

fn callersValue(h &mut Holder) {
  mut a = Arena.empty();
  h.r = a.alloc(new Pt(1, 2));  //~ ErrorInvType:4 "outlives"
}

// A value built around an allocation, returned or stored through a parameter
fn returnedHolder() Holder {
  mut a = Arena.empty();
  new Holder(a.alloc(new Pt(1, 2))); //~ ErrorEscape "carries a borrow of 'a'"
}

fn returnedRcHolder() Rc[Holder] {
  mut a = Arena.empty();
  new Rc[Holder](new Holder(a.alloc(new Pt(1, 2)))); //~ ErrorEscape "carries a borrow of 'a'"
}

fn returnedFromList() &mut Pt {
  mut a = Arena.empty();
  imm seen = a.alloc(List[&mut Pt].empty());
  seen.push(a.alloc(new Pt(1, 2)));
  *seen[0usize];                 //~ ErrorEscape "carries a borrow of 'a'"
}

fn storedHolder(h &mut Holder) {
  mut a = Arena.empty();
  *h = new Holder(a.alloc(new Pt(1, 2))); //~ ErrorEscape "carries a borrow of 'a'"
}

fn intoLongerArena() {
  mut outer = Arena.empty();
  mut dummy = new Pt(0, 0);
  imm h = outer.alloc(new Holder(&mut dummy));
  {
    mut inner = Arena.empty();
    h.r = inner.alloc(new Pt(1, 2)); //~ ErrorInvType:6 "outlives"
  }
}
