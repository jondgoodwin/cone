// A program allocating from, and tracing references into, a traced region
// declared by a package compiled on its own. Package tracer is compiled first
// (package\tracer.conebuild, listed under 'link' in cases.toml), and this
// program is compiled against the include file tracer's compile generates. The
// two objects are then linked, with conestd, and run.

build: debug
output: executable

import tracer: "include/tracer.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import tracer: "include/tracer.cone"
    import stdio: "stdio.cone"
}
