// The program: it allocates from package tracer's traced region, whose type it
// reaches through the include file tracer's compile generated, and traces
// values holding its references. Each trace -- a record's, and 'mem.trace' in
// line -- is generated in this object and calls tracer's private 'mark' in
// tracer's; each allocation calls its private 'alloc'. Every mark printed, as
// header id / permission / mode, can only have come from tracer's object.

mod prog;

import stdio use *;
import tracer use *;

struct Leaf { pub n i32; }
struct Pair { pub a +tr-mut Leaf; pub b +tr-imm Leaf; }

fn main() i32 {
  imm l1 = +tr-mut Leaf[1i32];
  imm l2 = +tr-imm Leaf[2i32];
  mut pr = Pair[l1, l2];
  printStr("in line:");
  mem.trace[Pair](&mut pr as *Pair, 4u32);
  printStr("\n");

  imm pp = +tr-mut Pair[l1, l2];
  printStr("record:");
  imm tracefn = (mem.typeRecord[Pair]() as &TypeRecord).trace;
  tracefn(&*pp as *u8, 5u32);
  printStr("\n");
  0i32;
}
