// Package tracer's source: a traced region ref, compiled on its own into a
// library object. Every method of 'tr' is private and none is inline, as a
// collector's are: the program's object calls 'alloc' where it allocates, and
// 'mark' from the traces the compiler generates there, so the library exports
// both.

mod tracer;

import stdio use *;

mut nextId = 1i64;

pub struct tr is RegionRef, Traced {
  pub id i64;
  pub ty *TypeRecord;

  fn alloc(size usize, ty *TypeRecord) *u8 {
    imm p = malloc(size);
    mem.writeRaw(p as *tr, tr[nextId, ty]);
    nextId = nextId + 1;
    p;
  }
  fn mark(self &uni tr, perm u32, mode u32) {
    printStr(" mark "); printInt(id);
    printStr("/"); printInt(i64[perm]);
    printStr("/"); printInt(i64[mode]);
  }
}
