// An alias is transparent, so a variable or field whose type is spelled
// through one is released exactly as the aliased type is: an 'So' reference is
// freed, an 'Rc' one is counted down, and a struct with a finalizer is dropped -- at scope exit, on reassignment, and not at all once
// the value has been moved out.
//
// Nothing resolves the alias for the code. A variable declaration keeps the name
// it was written with as its 'vtype' -- the IR dump prints 'imm p Sole' -- so
// every site that asks what a variable or field holds must resolve it with
// itypeGetTypeDcl. flowScopeDealias and genlStore ask flowIsOwningType, and
// genlReleaseOwning resolves its own argument, so those spellings are covered.
// The release of a struct's fields read a field's declared 'vtype' tag raw, so an
// owning field spelled through an alias matched neither region and the struct's
// release walked past it: both the counted and the sole-owner field leaked
// whenever the struct was freed.
//
// The struct here is region-allocated; one on the stack releases its owning
// fields through the same drop (struct_final_owners).
//
// Values are read through a borrow, because what an owning reference points at
// is not this scenario's subject and a borrow reaches it without moving it.
// ref_alias_deref owns reading one through '*p'.

mod region_alias_release;

import stdio use *;

alias Counted = Rc[mut, i32];
alias Sole = So[i32];
alias SoleAgain = Sole;

mut finalized = 0;

struct Fin {
  pub id i32;

  fn final(self &uni) {
    finalized = finalized + 1;
  }
}
alias Finalized = Fin;

struct Held {
  pub r Counted;
  pub s Sole;
}

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn peek(p &i32) i64 {
  i64.from(*p);
}

fn takeSole(p Sole) i64 {
  peek(p);
}

fn locals() {
  imm a Counted = new Rc[mut, i32](1);
  imm b Sole = new So[i32](2);
  imm d SoleAgain = new So[i32](5);
  show("alias-locals", peek(a) + peek(b) + peek(d));
}

fn reassigned() {
  mut p Sole = new So[i32](6);
  p = new So[i32](7);
  show("alias-reassigned", peek(p));
}

fn movedOut() {
  imm p Sole = new So[i32](10);
  imm t = takeSole(p);
  show("alias-moved-out", t);
}

fn finalized1() {
  imm f Finalized = new Fin(11);
}

fn fields() {
  imm owned = new So[Held](r: new Rc[mut, i32](12), s: new So[i32](13));
  show("alias-owning-fields", peek(owned.r) + peek(owned.s));
}

fn main() i32 {
  locals();
  reassigned();
  movedOut();
  finalized1();
  fields();
  show("alias-finalizer-ran", i64.from(finalized));
  0i32;
}
