// The raw blocks layer, core's 'RawBlocks': the three calls every heap region
// goes through for its bytes. A block is allocated, grown with its first bytes
// kept, shrunk with its first bytes kept, and given back; a resize of a null
// block is an allocation; giving back a null block is nothing; a block of no
// bytes may be asked for. 'So' and 'Rc' allocate and release through the same
// calls, so a value of each is made, read and let go beside them.

mod region_raw_blocks;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// The first n bytes of a block added up
fn sum(p *u8, n usize) i64 {
  mut total = 0i64;
  mut k = 0usize;
  while k < n {
    total = total + i64.from(*(p + k));
    k = k + 1usize;
  }
  total;
}

fn main() i32 {
  imm a = RawBlocks.alloc(16usize, 8usize);
  mut k = 0usize;
  mut v = 1u8;
  while k < 16usize {
    *(a + k) = v;
    v = v + 1u8;
    k = k + 1usize;
  }
  show("filled", sum(a, 16usize));

  imm b = RawBlocks.resize(a, 16usize, 4096usize, 8usize);
  show("grown-keeps-its-bytes", sum(b, 16usize));
  *(b + 4095usize) = 7u8;
  show("grown-last-byte", i64.from(*(b + 4095usize)));

  imm c = RawBlocks.resize(b, 4096usize, 8usize, 8usize);
  show("shrunk-keeps-its-bytes", sum(c, 8usize));

  imm d = RawBlocks.resize(null, 0usize, 32usize, 8usize);
  *(d + 31usize) = 9u8;
  show("resize-of-null-allocates", i64.from(*(d + 31usize)));

  imm e = RawBlocks.alloc(0usize, 1usize);
  RawBlocks.release(e);
  RawBlocks.release(c);
  RawBlocks.release(d);
  RawBlocks.release(null);

  imm s = new So[i64](41);
  imm r = new Rc[mut, i64](43);
  show("so-and-rc", *s + *r);
  0i32;
}
