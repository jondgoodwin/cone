// A variant of the nullable-pointer 'Option', held as itself rather than as
// the Option: 'Some[Tr[mut, Leaf]]' is laid out as its enum is, only the
// reference, with no tag before it. Its trace hands that reference to 'mark'.
//
// This compile used to crash: holding a variant through 't &Some[Tr[mut,
// Leaf]]' -- what every match on a borrowed 'Option' of a traced reference
// bound -- makes '*t' a birth, whose slot's record traced the variant as a
// struct of a tag and a field, a GEP into what is only a pointer, which LLVM
// rejected. The record's trace now reads the reference where it is, and so
// does 'mem.trace' of the variant.
//
// 'Tr' prints each mark as the id of the object marked. Each line is
// hand-checked below: Leaf 7 is object 1; 'roots' traces the roots the running
// functions hold.

mod region_traced_variant;

import stdio use *;

mut nextId = 1i64;

struct Tr is RegionRef, Traced {
  pub id i64;

  fn alloc(size usize, ty *TypeRecord) *u8 {
    imm p = malloc(size);
    mem.writeRaw(p as *Tr, new Tr(nextId));
    nextId = nextId + 1;
    p;
  }
  fn mark(self &uni Tr) {
    printStr(" "); printInt(id);
  }
}

struct Leaf { pub n i64; }

// Reads what the borrowed Some holds, lent by the match (a Some is declared as a
// type, and binds what it holds). The roots here are read's one -- 'l' -- and
// main's two: 'o', and the birth of the allocation it wrapped in a Some. All
// three reach Leaf 7.
//   roots: 1 1 1
//   read 7
fn read(t &Tr[mut, Leaf]) i64 {
  imm l = *t;
  printStr("roots:");
  mem.traceRoots(0u32);
  printStr("\n");
  l.n;
}

// Reads the borrowed variant itself, whose dereference is a birth: a Some,
// held as itself, whose trace is the one that crashed. The roots here are the
// birth, and main's two as above. All three reach Leaf 7.
//   variant roots: 1 1 1
fn births(t &Some[Tr[mut, Leaf]]) {
  imm v = *t;
  printStr("variant roots:");
  mem.traceRoots(0u32);
  printStr("\n");
}

// '&imm', since the binding is a reference into the Option and a parameter's
// reference may be one of several (main's own match borrows a local, and may)
fn get(o &imm Option[Tr[mut, Leaf]]) i64 {
  match o {
    case imm s &Some[Tr[mut, Leaf]] {
      births(s as &Some[Tr[mut, Leaf]]);
      read(s);
    }
    else { 0; }
  }
}

fn main() {
  imm o Option[Tr[mut, Leaf]] = Some[Tr[mut, Leaf]][new Tr[mut, Leaf](7)];
  imm n = get(&imm o);
  printStr("read "); printInt(n); printStr("\n");
  // The variant traced in line and by its record: 1 each time
  //   trace: 1
  //   record: 1
  match &o {
    case imm s &Some[Tr[mut, Leaf]] {
      printStr("trace:");
      mem.trace[Some[Tr[mut, Leaf]]](s as *Some[Tr[mut, Leaf]], 0u32);
      printStr("\n");
      printStr("record:");
      imm tracefn = (mem.typeRecord[Some[Tr[mut, Leaf]]]() as &TypeRecord).trace;
      tracefn(s as *u8, 0u32);
      printStr("\n");
    }
    else { }
  }
}
