// What an allocation may allocate, and what may stand in the region slot.
//
// These are the checks ir/exp/allocate.c makes about the allocation expression
// itself. The other two type-check scenarios are about the declaration of the
// region a valid allocation names, which is a separate question and a separate
// family of messages.

struct Nothing { }

fn notAType() { }

fn f() {
  // There is no memory to allocate for a struct with no fields
  imm a = +rc-mut Nothing[]    //~ ErrorInvType "abstract or zero-size type"

  // A region is a struct type. A function name resolves and is a name for
  // something, so the region slot accepts it as far as name resolution and then
  // rejects it three times over: once for not being a type at all, once by the
  // reference type, and once by the allocator check that follows it.
  imm b = +notAType-mut 5      //~ ErrorNotTyped "Expected a type"
                               //~^ ErrorInvType "region must be a struct type" follow-on
                               //~^^ ErrorInvType "Not a valid region" follow-on
}
