// A region the compiler has never heard of, written here in Cone, gets every
// call 'Rc' and 'So' get. The compiler knows no region by name: it calls the
// methods a struct declaring 'is RegionRef' has, at each reference event, and
// what the struct leaves out says what it does. Each method below prints, so
// the output is the whole assertion -- which method was called, in what order,
// and how many owners the count says there are after each.
//
// 'Tally' counts like 'Rc', with a header two fields wide, so the value sits
// sixteen bytes past where 'alloc' returned rather than eight: 'free' printing
// the serial 'init' stored proves each method was handed the header, found from
// the layout rather than from a guess at its size. 'Solo' declares 'Move' and
// no 'aliasRef', so a copy of a reference to it is a move and its one owner's
// going is the death.
//
// Two more leave out what 'Rc' has, and an absent method's operation simply
// does not happen: 'Kept' has 'aliasRef' and no 'dealiasRef', so copies are counted
// but an owner's going reports nothing, the value never dies by count, and its
// 'free' is never called -- it leaks, as such a region's values do until a
// collector frees them. 'Asked' declares 'Move', has 'dealiasRef' and no 'aliasRef',
// so it is a single owner whose going still asks 'dealiasRef', and dies on its
// answer. A region declaring neither 'Move' nor 'aliasRef' is region_collected's.

mod region_regionref;

import stdio use *;
import libc;

fn line(label &[]u8, n usize) {
  printStr(label);
  printInt(i64.from(n));
  printStr("\n");
}

struct Tally is RegionRef {
  owners usize;
  serial u32;
  fn alloc(size usize) *u8 inline { line("alloc ", size); malloc(size); }
  fn init(self &new) inline { printStr("init\n"); *self = new Tally(1usize, 42u32); }
  fn aliasRef(self &uni Tally) inline { owners = owners + 1usize; line("alias, owners ", owners); }
  fn dealiasRef(self &uni Tally) Bool inline { owners = owners - 1usize; line("dealias, owners ", owners); owners == 0usize; }
  // A bare 'free' here is this method; C's is reached through its package
  fn free(self &uni Tally) inline { line("free, serial ", usize.from(serial)); libc.free(self as *u8); }
}

struct Solo is RegionRef, Move {
  fn alloc(size usize) *u8 inline { line("solo alloc ", size); malloc(size); }
  fn free(self &uni Solo) inline { printStr("solo free\n"); libc.free(self as *u8); }
}

struct Kept is RegionRef {
  owners usize;
  fn alloc(size usize) *u8 inline { line("kept alloc ", size); malloc(size); }
  fn init(self &new) inline { *self = new Kept(1usize); }
  fn aliasRef(self &uni Kept) inline { owners = owners + 1usize; line("kept alias, owners ", owners); }
  fn free(self &uni Kept) inline { printStr("kept free\n"); libc.free(self as *u8); }
}

struct Asked is RegionRef, Move {
  fn alloc(size usize) *u8 inline { line("asked alloc ", size); malloc(size); }
  fn dealiasRef(self &uni Asked) Bool inline { printStr("asked dealias\n"); true; }
  fn free(self &uni Asked) inline { printStr("asked free\n"); libc.free(self as *u8); }
}

struct Holder {
  pub r Tally[imm, i32];
}

// The same, with a finalizer that reads what its field owns
struct Logged {
  pub r Tally[imm, i32];
  fn final(self &uni) { line("Logged final, reads ", usize.from(*r)); }
}

// Two copies made and dropped in an inner block, then the original
fn counted() {
  printStr("-- counted\n");
  imm a = +Tally-imm 5i32;
  {
    imm b = a;
    imm c = b;
    line("value ", usize.from(*c));
  }
  printStr("inner block done\n");
}

// A copy passed to a call is one more owner, which the callee's parameter drops
fn peek(r Tally[imm, i32]) i32 { *r; }
fn passed() {
  printStr("-- passed\n");
  imm a = +Tally-imm 6i32;
  line("value ", usize.from(peek(a)));
}

// A single owner: the copy is a move, and it dies once
fn single() {
  printStr("-- single\n");
  imm s = +Solo-mut 7i32;
  imm t = s;
  line("value ", usize.from(*t));
}

// A struct allocated in one region holding an owner in another: its death
// releases the owner its field holds before its own memory goes back. The
// init's arguments come first, before the holder's 'alloc': 'a' copied (its
// alias) here, the inner allocation in 'finalized'.
fn nested() {
  printStr("-- nested\n");
  imm a = +Tally-imm 9i32;
  imm h = new Solo[Holder](a);
  line("through the holder ", usize.from(*h.r));
}

// A value with a finalizer dies in three steps, in this order: its 'final'
// runs, while what its field owns is still there to read; then the owner its
// field holds is released; then its own memory goes back through its region's
// 'free'
fn finalized() {
  printStr("-- finalized\n");
  imm h = new Solo[Logged](+Tally-imm 8i32);
}

// Counted up and never down: no dealiasRef, no death, no free
fn neverDies() {
  printStr("-- never dies\n");
  imm a = +Kept-imm 3i32;
  {
    imm b = a;
    line("value ", usize.from(*b));
  }
  printStr("inner block done\n");
}

// A single owner that is still asked: the copy is a move, and the one going
// calls dealiasRef, whose true is the death
fn askedOnce() {
  printStr("-- asked\n");
  imm s = +Asked-mut 4i32;
  imm t = s;
  line("value ", usize.from(*t));
}

fn main() i32 {
  counted();
  passed();
  single();
  nested();
  finalized();
  neverDies();
  askedOnce();
  printStr("-- end\n");
  0i32;
}
