// An allocation 'new x[T](args)' whose head is no region itself but leads to
// one: its type has an 'allocRegion' method giving the region value the
// allocation is made in. It means 'x.allocRegion().alloc(new T(args))', and a
// type that gets its memory from a region (a List) is handed that region, as it
// is in an arena named directly (region_new_arena). An actor's state has such a
// method, generated by the compiler, which is how 'new self[T](...)' allocates
// in the actor's own region (the actorgc package); this is the rule alone,
// with a type of the program's own that owns an arena. Worked out by hand:
//
//   3     p = Pt(1, 2) made in the world's arena, sum 3
//   7     q = Pt(3, 4), the permission 'mut' written, sum 7
//   2     the arena has given a finalizer header to the two Fins
//   21    the two Fins die with the world's arena, newest first, then "after"
//
// (A type that gets its memory from a region, a List, is handed the region the
// head leads to, which is asked of the head a second time: 'allocRegion' is
// called twice, so it should lend nothing that is still borrowed when it is
// called again. The actor's, lent for the whole program, does not.)

mod region_new_leads;

import stdio use *;
import arena use *;

struct Pt {
  pub x i64;
  pub y i64;
  pub fn sum(self &) i64 { x + y; }
}

struct Fin {
  pub n i64;
  fn final(self &uni) { printInt(n); }
}

// A type that owns an arena: it is no region (its first field is not a
// '*MemRegion'), and it says where its allocations go
struct World {
  pub arena Arena;
  pub fn allocRegion(self &mut) &mut Arena { &mut arena; }
}

fn main() {
  {
    mut w = new World(Arena.empty());
    imm p = new w[Pt](1, 2);
    printInt(p.sum());
    printStr("\n");
    imm q = new w[mut, Pt](3, 4);
    printInt(q.sum());
    printStr("\n");
    new w[Fin](1);
    new w[Fin](2);
    printInt(i64.from(w.arena.finalizers()));
    printStr("\n");
  }
  printStr("\nafter\n");
}
