mod region_flow_owner_kinds;

import stdio use *;
import collections use *;

// region_flow_owner_replace holds the check on 'Uni[Item]' and 'Rc[mut, Item]': a borrow into what an owner
// owns is refused beside a call or a store that could replace the owner through another name. It is no
// different for the owners of other kinds, which this file pins:
//   - an owner of an array ('Uni[Array[Item]]', what a list's 'freeze' gives), the borrow an element's;
//   - an owner of a trait object ('Uni[Gadget]', 'Rc[mut, Gadget]'): the owner's type hides the struct behind
//     it, and a method of the trait lends a borrow into that struct's own state.
// Run, each of these read an Item (or a counter) the callee's replacement had freed, after its 'final' had run.
// region_owner_kinds_success holds what is accepted beside each refusal.

struct Item { pub v: i64; fn final(self: &uni) { printStr("final "); printInt(v); printStr("\n"); } }

trait Gadget {
  pub fn count(self: &mut) &mut i64;
  pub fn bump(self: &mut);
}

struct Real is Gadget {
  pub n: i64;
  pub fn count(self: &mut) &mut i64 { &mut n }
  pub fn bump(self: &mut) { n = n + 1; }
  fn final(self: &uni) { printStr("final real "); printInt(n); printStr("\n"); }
}

struct Holder { pub g: Uni[Gadget]; }

fn mkArr(n: i64) Uni[Array[Item]] {
  var l = List[Item].empty();
  l.push(new Item(n));
  l.push(new Item(n + 100));
  l.freeze()
}
fn mkG(n: i64) Uni[Gadget] { new Uni[Real](new Real(n)) }
fn mkR(n: i64) Rc[mut, Gadget] { new Rc[mut, Real](new Real(n)) }

// The callees: each stores over the owner it is handed
fn replaceArr(a: &mut Uni[Array[Item]]) { *a = mkArr(9); }
fn clobberArr(a: &mut Uni[Array[Item]], e: &mut Item) { *a = mkArr(9); printInt(e.v); }
fn replaceG(o: &mut Uni[Gadget]) { *o = mkG(9); }
fn clobberG(o: &mut Uni[Gadget], c: &mut i64) { *o = mkG(9); printInt(*c); }
fn replaceHolder(h: &mut Holder) { h.g = mkG(9); }
fn replaceR(o: &mut Rc[mut, Gadget]) { *o = mkR(9); }

// ---- An owner of an array

// A local lent '&mut' beside a borrow of one element, in one call
fn arrCall() { var a = mkArr(1); clobberArr(&mut a, &mut a[0usize]); }   //~ ErrorShapeReshape

// The element's borrow held in a name, the owner replaced by a call
fn arrHeld() i64 {
  var a = mkArr(1);
  let e = &mut a[0usize];
  replaceArr(&mut a);                                                   //~ ErrorShapeReshape
  e.v
}

// Two '&mut' parameters that may be one owner
fn arrTwoCall(a: &mut Uni[Array[Item]], b: &mut Uni[Array[Item]]) i64 {
  let e = &mut a[0usize];
  replaceArr(b);                                                        //~ ErrorShapeReshape
  e.v
}

fn arrTwoStore(a: &mut Uni[Array[Item]], b: &mut Uni[Array[Item]]) i64 {
  let e = &mut a[0usize];
  *b = mkArr(9);                                                        //~ ErrorShapeStore
  e.v
}

// ---- An owner of a trait object

// A local lent '&mut' beside the borrow its own method lent
fn gadgetCall() { var o = mkG(1); clobberG(&mut o, o.count()); }        //~ ErrorShapeReshape

// The borrow held in a name, the owner replaced by a call
fn gadgetHeld() i64 {
  var o = mkG(1);
  let c = o.count();
  replaceG(&mut o);                                                     //~ ErrorShapeReshape
  *c
}

// Two '&mut' parameters that may be one owner
fn gadgetTwoCall(a: &mut Uni[Gadget], b: &mut Uni[Gadget]) i64 {
  let c = a.count();
  replaceG(b);                                                          //~ ErrorShapeReshape
  *c
}

fn gadgetTwoStore(a: &mut Uni[Gadget], b: &mut Uni[Gadget]) i64 {
  let c = a.count();
  *b = mkG(9);                                                          //~ ErrorShapeStore
  *c
}

// The owner a field of a struct, replaced by a call through another holder
fn gadgetField(a: &mut Holder, b: &mut Holder) i64 {
  let c = a.g.count();
  replaceHolder(b);                                                     //~ ErrorShapeReshape
  *c
}

// A counted owner of a trait object
fn gadgetRc(a: &mut Rc[mut, Gadget], b: &mut Rc[mut, Gadget]) i64 {
  let c = a.count();
  replaceR(b);                                                          //~ ErrorShapeReshape
  *c
}

// ---- A call through a virtual reference may replace the owner it is lent from
// The object behind a virtual reference is unknown, so a call through a mutable one is assumed to reach
// any owner of the type and replace it, as it is assumed to reshape any collection (mem-shape.html#shapekeeping,
// "ShapeKeeping"): an owner declared '+ ShapeKeeping' is the cure (region_owner_kinds_success).

// Another method of the object, called while a borrow an earlier call lent is held
fn gadgetBump() i64 {
  var o = mkG(1);
  let c = o.count();
  o.bump();                                                             //~ ErrorShapeReshape
  *c
}

// ... a second borrow of the object's state lent while the first is held
fn gadgetSecond() i64 {
  var o = mkG(1);
  let c = o.count();
  let d = o.count();                                                    //~ ErrorShapeReshape
  *c = 4;
  *d
}

// ... the owner in a field, and a counted one
fn gadgetHolderBump(h: &mut Holder) i64 {
  let c = h.g.count();
  h.g.bump();                                                           //~ ErrorShapeReshape
  *c
}

fn gadgetRcBump() i64 {
  let p = mkR(40);
  let c = p.count();
  p.bump();                                                             //~ ErrorShapeReshape
  *c
}

// The owner lent as a '&<mut' beside a '&<' of it, to one call
fn both(x: &<mut Gadget, y: &<Gadget) { x.bump(); }
fn bothLent() {
  let a: Uni[Gadget] = mkG(1);
  both(a, a);                                                           //~ ErrorShapeReshape
}

fn main() {}
