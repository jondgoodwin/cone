// The stable sort's 16-to-32 element leaf runs on a SHORT list as well: the sort's buffer for a
// list of up to 64 elements holds len + 16, so a list of 32 is sorted by the leaf whole (before,
// its buffer held 16 and the 32 were insertion-sorted). The leaf copies elements into the
// buffer and merges them back over the array, so while the merge runs an element can live only
// in the scratch, which no collector traces by itself (the sort roots it through SortScratch).
// The element is a traced reference (8 bytes). A collection (mem.traceRoots) runs inside EVERY
// comparison, and the worst trace is reported: "found 32 of 32" means no element was ever out
// of sight, in the leaf's merge or anywhere else in the sort. The comparisons are counted: the
// leaf makes 141 for this list (the insertion sort it replaces made 177), so the count is what says
// the leaf ran.

mod region_sort_scratch_gc_short;

import stdio use *;
import collections;
import libc;

var @threadlocal nextId = 1i64;
var @threadlocal seen = Array[u64, 1]() <- fill 0u64;
var @threadlocal epoch = 1u32;
var @threadlocal worst = 999i64;
var @threadlocal traces = 0i64;
var @threadlocal lossy = 0i64;
var @threadlocal total = 32i64;

struct Tr is RegionRef, Traced {
  pub id: i64;
  fn alloc(size: usize) *u8 {
    let p = malloc(size);
    mem.writeRaw(p as *Tr, Tr(nextId));
    nextId = nextId + 1;
    p
  }
  fn mark(self: &uni Tr, slot: *usize, perm: u32, mode: u32) {
    let b = id - 1;
    seen[0usize] = seen[0usize] | (1u64 << u64.from(b));
  }
}
struct Leaf { pub n: i32; }
alias Ref = Tr[mut, Leaf];
fn leaf(n: i32) Ref { Tr[mut, Leaf](n) }

// Collect, and count how many of the leaves (ids 1 to 32) were marked
fn trace() {
  seen[0usize] = 0u64;
  mem.traceRoots(epoch);
  epoch = epoch + 1u32;
  var found = 0i64;
  var id = 1i64;
  while id <= total {
    let b = id - 1;
    if (seen[0usize] & (1u64 << u64.from(b))) != 0u64 { found = found + 1; }
    id = id + 1;
  }
  traces = traces + 1;
  if found < worst { worst = found; }
  if found < total { lossy = lossy + 1; }
}

fn byN(a: &Ref, b: &Ref) i32 { trace(); a.n <=> b.n }

fn sortedList(l: &collections.List[Ref]) bool {
  var i = 1usize;
  while i < l.len() { if l[i - 1usize].n > l[i].n { return false; } i = i + 1usize; }
  true
}

fn leafSortBy() {
  var list = collections.List[Ref]();
  var i = 0;
  while i < 32 { list.push(leaf((i * 137) % 32)); i = i + 1; }
  list.sortBy(&byN);
  // a debug build makes 31 more comparisons, to check the order, which are not the sort's
  var checks = 0i64;
  #if #debug {checks = 31i64;}
  printStr("comparisons, each with a collection: ");
  printInt(traces - checks);
  printStr(", worst found ");
  printInt(worst);
  printStr(" of ");
  printInt(total);
  printStr(", collections that lost one: ");
  printInt(lossy);
  printStr("\n");
  printStr(if sortedList(&list) { "in order\n" } else { "not in order\n" });
}

fn main() {
  leafSortBy();
}
