// The block a collection asks its region for is a fresh one: the call 'MemRegion.allocate'
// makes through the region's function carries LLVM's 'noalias' on the pointer it returns
// (the contract in core, above 'MemRegion'). A list grows from nothing to hold three
// numbers, so it makes that call, and the run reads the numbers back.

mod region_alloc_noalias;

import stdio use *;
import collections use *;

fn main() {
  var l = List[i32]();
  l.push(10i32);
  l.push(20i32);
  l.push(30i32);
  printInt(i64.from(l[0usize] + l[1usize] + l[2usize]));
  printStr("\n");
}
