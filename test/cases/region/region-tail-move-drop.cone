// A value the scope hands back is the caller's to finalize, and a local the
// scope still owns is finalized exactly once on the way out.
//
// flowScopeDealias exempted the scope's result from release only on the arm
// that handles owning references. On the other arm -- a value whose type has a
// drop fn -- it asked nothing, so a struct returned by name was finalized by the
// function that built it and then again by the caller that received it. The
// exemption is now asked once, ahead of both arms.
//
// The same list is what releases a local that was moved into a call in final
// position, which region-tail-move measures for 'so' and 'rc' where only the
// emitted IR can see it. A drop fn can say so out loud, so the ordering and the
// exemption are both asserted here by what the program prints: 'hold' and 'tail'
// hand their value on and finalize nothing, 'keepOne' finalizes only the local
// it did not hand on, and 'main' finalizes each of the three it received once,
// in reverse declaration order.
//
// A struct with a drop fn is a move type ('Let's not make copies of finalized
// objects', ir/types/struct.c), so handing one to a call moves it.

import stdio::*;

struct Fin {
  pub tag i32;

  fn final(self &uni) {
    printStr("final ");
    printInt(i64[self.tag]);
    printStr("\n");
  }
}

// The parameter is this block's result, so it is handed back rather than
// finalized here.
fn hold(f Fin) Fin {
  f;
}

// A local that is the block's result.
fn make() Fin {
  imm f = Fin[1i32];
  f;
}

// A local moved into a call in final position.
fn tail() Fin {
  imm f = Fin[2i32];
  hold(f);
}

// One local moved into the call in final position, one not: only the one that
// stayed is finalized here.
fn keepOne() Fin {
  imm a = Fin[3i32];
  imm b = Fin[4i32];
  hold(a);
}

fn main() i32 {
  imm m = make();
  printStr("after make\n");
  imm t = tail();
  printStr("after tail\n");
  imm k = keepOne();
  printStr("after keepOne\n");
  0i32;
}
