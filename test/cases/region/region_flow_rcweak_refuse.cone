// What the rcweak package's weak reference refuses at compile time, by the
// ordinary rules and nothing of its own. A 'Weak[T]' is made only from a shared
// 'Rcw[mut, T]' owner: an 'Rcw[imm, T]' one does not coerce to it, so a weak
// reference can never hand back a mutable owner of an immutable value. It
// cannot be read through, since its value may have died: it is a struct, not a
// reference, and the header address it holds is private. It moves, so a
// weak reference moved away is not there to ask. What it may do is run by the
// package's own tests (packages/rcweak/tests).
//
// A unique 'Rcw' owner is accepted by 'Weak[T].of', which takes its owner by
// value: the unique owner moves in and is given up, which is what makes the
// weak reference safe to make from it, and using the owner afterwards is
// refused as any moved value is.

mod region_flow_rcweak_refuse;

import rcweak use *;

struct Pt { pub x i64; }

fn fromImm() {
  let r = new Rcw[imm, Pt](1);
  let w = Weak[Pt].of(r);         //~ ErrorInvType
}

fn readThrough() i64 {
  let r = new Rcw[mut, Pt](2);
  let w = Weak[Pt].of(r);
  (*w).x                         //~ ErrorNotPtr
                                  //~^ ErrorNoMeth follow-on
}

fn header() {
  let r = new Rcw[mut, Pt](3);
  let w = Weak[Pt].of(r);
  let h = w.hdr;                  //~ ErrorNotPublic
}

fn movedAway() bool {
  let r = new Rcw[mut, Pt](4);
  let w = Weak[Pt].of(r);
  let w2 = w;
  w.alive()                      //~ ErrorMove
}

fn uniGivenUp() i64 {
  let r = new Rcw[Pt](5);
  let w = Weak[Pt].of(r);
  r.x                            //~ ErrorMove
}

fn main() {
}
