// A value moved into a call that is a block's final expression has left the
// scope, so the scope must not release it as well.
//
// blockFlow built the scope's release list before flowLoadValue walked the
// block's result expression, and the walk is what marks a variable moved. A
// local handed to a call in final position -- 'holdSo(a)' as the last
// expression -- was therefore still unmoved when the list was built, so the
// scope freed it after handing it over: a double free for 'So', a count too
// many for 'Rc'. Written as two statements, 'imm r = holdSo(a); r', it was
// already right, because the move was marked while that statement was walked
// and the list was built afterwards. The walk now runs first, and both spellings
// agree.
//
// Every allocation below is handed on -- to a callee that returns its
// parameter, or straight back to the caller -- so nothing in this module may
// free or adjust a count. That is the whole claim and no run can see it, which
// is why this file holds nothing else and why the check in cases.toml can
// exclude both across the whole module rather than having to name a register.
//
// The final position has four spellings and each reaches a different arm of
// blockFlow: the injected block return, a nested block that is the outer
// block's result, an explicit 'return', and a value tuple whose element is the
// call.
//
// What a local that is not handed on still owes is region_tail_move_drop's
// claim, where a drop fn makes the release visible to a run.

mod region_tail_move;

fn holdSo(a So[i32]) So[i32] {
  a;
}

fn holdRc(a Rc[i32]) Rc[i32] {
  a;
}

fn tailCallSo() So[i32] {
  imm a = +So 1i32;
  holdSo(a);
}

fn tailCallRc() Rc[i32] {
  imm a = +Rc 2i32;
  holdRc(a);
}

fn statementForm() So[i32] {
  imm a = +So 4i32;
  imm r = holdSo(a);
  r;
}

fn nestedBlock() So[i32] {
  imm a = +So 5i32;
  { holdSo(a); };
}

fn explicitReturn() So[i32] {
  imm a = +So 6i32;
  return holdSo(a);
}

fn tailTuple() So[i32], i32 {
  imm a = +So 7i32;
  holdSo(a), 8i32;
}
