// An inline function that places memory and then moves its parameter into it
// with 'mem.writeRaw', as an arena's 'alloc' does, is handed a construction by a
// declared init as it stands, 'put(new Thing(next()))': the call's arguments are
// evaluated, the function runs up to its write, and the construction runs there,
// in the place, so nothing is copied from a temporary. The order shows it: 'tick'
// counts the steps (next()), and a Thing records the tick of its argument, and
// of the init that built it; the place records the tick at which it took room.
// Every expected line is worked out by hand, 'argument placed built':
// - 'put' places and then writes its parameter: the argument is evaluated (1),
//   the room taken (2), the init runs in it (3): 1 2 3;
// - 'putVia' passes its parameter on to 'put', which writes it: the same, 1 2 3;
// - 'putTwice' reads its parameter before it writes it, so the parameter is built
//   at the call and moved: argument (1), init (2), then the room (3): 1 3 2;
// - 'putCopy' is not inline, so it is passed a built value, and copies it: 1 3 2;
// - each value is readable where it was placed (its argument, 1, four of them: 4),
//   and none was finalized, though each was passed as a parameter: 0.
// The first four lines print 'argument placed built'; the last two the sum of the
// four arguments read through the references the calls answered, and the finals.

mod region_inline_place;

import stdio use *;
import libc;

mut tick = 0i64;
mut finals = 0i64;

fn next() i64 {
  tick = tick + 1i64;
  tick;
}

struct Thing {
  pub a i64;
  pub built i64;

  pub fn init(self &new, a i64) {
    *self = new Thing(a, next());
  }

  fn final(self &uni) { finals = finals + 1i64; }
}

struct Place {
  pub placed i64;

  // Places, then writes its parameter: the construction waits for the write
  pub fn put[T](self &mut, value T) &mut T inline {
    placed = next();
    imm p = libc.malloc(mem.sizeof[T]()) as *T;
    mem.writeRaw(p, value);
    p as &mut T;
  }

  // Hands its parameter on to a function that writes it
  pub fn putVia[T](self &mut, value T) &mut T inline {
    self.put(value);
  }

  // Uses its parameter before it writes it
  pub fn putTwice[T](self &mut, value T, other &mut Thing) &mut T inline {
    other.a = value.a;
    placed = next();
    imm p = libc.malloc(mem.sizeof[T]()) as *T;
    mem.writeRaw(p, value);
    p as &mut T;
  }

  // The same as 'put', not inline
  pub fn putCopy[T](self &mut, value T) &mut T {
    placed = next();
    imm p = libc.malloc(mem.sizeof[T]()) as *T;
    mem.writeRaw(p, value);
    p as &mut T;
  }
}

fn show(arg i64, placed i64, built i64) {
  printInt(arg);
  printStr(" ");
  printInt(placed);
  printStr(" ");
  printInt(built);
  printStr("\n");
}

fn main() i32 {
  mut place = new Place(0i64);
  mut other = new Thing(0i64, 0i64);

  tick = 0i64;
  imm t1 = place.put(new Thing(next()));
  show(t1.a, place.placed, t1.built);

  tick = 0i64;
  imm t2 = place.putVia(new Thing(next()));
  show(t2.a, place.placed, t2.built);

  tick = 0i64;
  imm t3 = place.putTwice(new Thing(next()), &mut other);
  show(t3.a, place.placed, t3.built);

  tick = 0i64;
  imm t4 = place.putCopy(new Thing(next()));
  show(t4.a, place.placed, t4.built);

  printInt(t1.a + t2.a + t3.a + t4.a);
  printStr("\n");
  printInt(finals);
  printStr("\n");
  0i32;
}
