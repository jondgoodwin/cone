mod region_move_between_refused;

// What region_move_between leaves out: a shared owner cannot give its value up,
// so it cannot move it into another region (Backlog\regions.md, ruled 1 Nov
// 2026). A borrow does not own the value either. One refusal per function.

struct Inner {
  pub n: i64;
  fn final(self: &uni) {}
}

fn sharedIntoRc() {
  let a = Rc[mut, Inner](1);
  let b = a;
  let c = Rc[mut, Inner](*a);       //~ ErrorMoveOut "through a shared owning reference"
}

fn sharedIntoUni() {
  let a = Rc[imm, Inner](2);
  let c = Uni[Inner](*a);           //~ ErrorMoveOut "through a shared owning reference"
}

fn borrowedIntoRc(x: &Inner) {
  let c = Rc[mut, Inner](*x);       //~ ErrorMoveOut "through a borrowed reference"
}
