// A typedef is a transparent alias, so a variable or field whose type is spelled
// through one is released exactly as the aliased type is: an 'so' reference is
// freed, an 'rc' one is counted down, an owning slice is freed, and a struct with
// a finalizer is dropped -- at scope exit, on reassignment, and not at all once
// the value has been moved out.
//
// Nothing resolves the alias for the code. A variable declaration keeps the name
// it was written with as its 'vtype' -- the IR dump prints 'imm p Sole' -- so
// every site that asks what a variable or field holds must resolve it with
// itypeGetTypeDcl. flowScopeDealias and genlStore ask flowIsOwningType, and
// genlReleaseOwning resolves its own argument, so those spellings are covered.
// genlDealiasFlds read a field's declared 'vtype' tag raw, so an owning field
// spelled through an alias matched neither region and the struct's release walked
// past it: both the counted and the sole-owner field leaked whenever the struct
// was freed.
//
// The struct here is region-allocated because that is the only path that reaches
// a struct's owning fields at all; region-owning-field says why.
//
// Values are read through a borrow, because what an owning reference points at
// is not this scenario's subject and a borrow reaches it without moving it.
// ref-typedef-deref owns reading one through '*p'.

import stdio::*;

typedef Counted +rc-mut i32;
typedef Sole +so i32;
typedef Slice +[]so i32;
typedef SoleAgain Sole;

mut finalized = 0;

struct Fin {
  pub id i32;

  fn final(self &uni) {
    finalized = finalized + 1;
  }
}
typedef Finalized Fin;

struct Held {
  pub r Counted;
  pub s Sole;
}

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn peek(p &i32) i64 {
  i64[*p];
}

fn takeSole(p Sole) i64 {
  peek(p);
}

fn locals() {
  imm a Counted = +rc-mut 1;
  imm b Sole = +so 2;
  imm c Slice = +[]so [4; 3];
  imm d SoleAgain = +so 5;
  show("alias-locals", peek(a) + peek(b) + i64[c[1]] + peek(d));
}

fn reassigned() {
  mut p Sole = +so 6;
  p = +so 7;
  mut q Slice = +[]so [8; 2];
  q = +[]so [9; 2];
  show("alias-reassigned", peek(p) + i64[q[0]]);
}

fn movedOut() {
  imm p Sole = +so 10;
  imm t = takeSole(p);
  show("alias-moved-out", t);
}

fn finalized1() {
  imm f Finalized = Fin[11];
}

fn fields() {
  imm owned = +so Held[r: +rc-mut 12, s: +so 13];
  show("alias-owning-fields", peek(owned.r) + peek(owned.s));
}

fn main() i32 {
  locals();
  reassigned();
  movedOut();
  finalized1();
  fields();
  show("alias-finalizer-ran", i64[finalized]);
  0i32;
}
