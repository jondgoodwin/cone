// A program may declare C's 'free' itself and still allocate in 'Uni' and 'Rc'.
// A second declaration of 'free' beside the program's would be renamed 'free.1'
// by LLVM, which nothing defines, so the program would not link. The releases go
// through the raw blocks layer ('cone_rawBlockRelease'), so the program's
// declaration, with its own signature (a Cone function with no return value
// returns '%void' where C's returns LLVM's void), is the module's only 'free'.
// The program's own call reaches the same C function, freeing a buffer from
// core's 'malloc', which core declares and 'free' it does not.

mod region_program_free;

import stdio use *;

extern {
  fn @c free(p *u8);
}

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn soValue() i64 {
  imm a = new Uni[i32](5);
  i64.from(*a);
}

fn rcValue() i64 {
  imm b = new Rc[mut, i32](7);
  i64.from(*b);
}

fn main() i32 {
  imm buf = malloc(16);
  free(buf);
  show("so-released", soValue());
  show("rc-released", rcValue());
  0i32;
}
