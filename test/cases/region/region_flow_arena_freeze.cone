// An arena's allocations come back as '&mut' borrows with no loan on the
// arena: every allocation is fresh and never moved, so the arena declares
// 'NoLoanMut' and a second 'a.alloc' while the first allocation is used is
// fine (region_arena_freeze in collection_freeze_success runs it). What an
// allocation keeps is the arena's life: while one is still to be used the
// arena may not be moved away, replaced, swapped or ended. And an owning
// reference coerced to a borrowed one lends what it owns: the owner may not be
// moved while the borrow is used. Each error is reported at the touch.

mod region_flow_arena_freeze;

import arena use *;

struct Pt { pub x i64; pub y i64; }

fn consume(a Arena) {}
fn consumePt(p +So Pt) {}

// Moved into a call while an allocation is still to be used
fn movedAway() i64 {
  mut a = Arena.empty();
  imm r = a.alloc(Pt[1, 2]);
  consume(a);                   //~ ErrorFrozen:11 "may not be moved"
  r.x;
}

// Moved into another variable
fn movedToVariable() i64 {
  mut a = Arena.empty();
  imm r = a.alloc(Pt[1, 2]);
  { imm b = a; }                //~ ErrorFrozen:13 "may not be moved"
  r.x;
}

// Swapped with another arena
fn swapped() i64 {
  mut a = Arena.empty();
  mut other = Arena.empty();
  imm r = a.alloc(Pt[1, 2]);
  a <=> other;                  //~ ErrorFrozen:3 "may not be changed"
  r.x;
}

// Replaced whole
fn replaced() i64 {
  mut a = Arena.empty();
  imm r = a.alloc(Pt[1, 2]);
  a = Arena.empty();            //~ ErrorFrozen:3 "may not be changed"
  r.x;
}

// An owner moved while the borrow its coercion made is still to be used
fn ownerMoved() i64 {
  imm u = +So Pt[1, 2];
  imm b &Pt = u;
  consumePt(u);                 //~ ErrorFrozen:13 "may not be moved"
  b.x;
}
