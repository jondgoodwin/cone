// A borrow of a sole owner may not be seen as a borrow of a shared one.
//
// 'Rc[T]' is 'Rc[uni, T]': the only owner of its value, a move type. 'Rc[mut, T]',
// 'Rc[imm, T]', 'Rc[ro, T]' and the others may alias, so a read of one copies it. A
// borrow '&Rc[mut, T]' of a 'Rc[T]' would let a read through the borrow copy out
// a second owner of a value promised unique -- and one that may write, while the
// first still believes itself alone. The same holds for any region that does not
// declare 'Move', a user's as much as 'Rc', and for a slice's elements.
//
// Not behind a borrow the same coercion is a move, which consumes the sole
// owner, so it stays allowed. A single owner has no shared view to refuse: 'Uni[mut,
// T]' is not a type (region_typecheck_sole_owner_mut).

mod region_typecheck_uni_view;

struct Fin { pub n: i64; }

struct Arena is RegionRef {
  fn alloc(size: usize) *u8 inline { malloc(size) }
}

fn share(b: &Rc[mut, Fin]) Rc[mut, Fin] { *b }
fn shareOne(b: &Array[Rc[mut, Fin]]) Rc[mut, Fin] { b[0] }
fn shareArena(b: &Arena[mut, Fin]) Arena[mut, Fin] { *b }
fn lookUni(b: &Rc[Fin]) { }

// A borrow's own type may not change on the way out either
fn view(b: &Rc[Fin]) &Rc[mut, Fin] {      //~ ErrorInvType:22 "This is the declared function's return type" follow-on
  b                                     //~ ErrorInvType:3 "Return expression type does not match"
}

fn f() i32 {
  let u = Rc[Fin](1);
  let m = share(&u);                     //~ ErrorInvType
  let i: &Rc[imm, Fin] = &u;               //~ ErrorInvType
  let r: &Rc[ro, Fin] = &u;                //~ ErrorInvType

  let owners = [Rc[Fin](2), Rc[Fin](3)];
  let s = shareOne(&[]owners);           //~ ErrorInvType
  let t = shareOne(&owners);             //~ ErrorInvType

  let a = Arena[Fin](4);
  let c = shareArena(&a);                //~ ErrorInvType

  // Still allowed: the sole owner seen as itself, a shared owner seen as shared,
  // and a move that consumes 'u'
  lookUni(&u);
  let shared = Rc[mut, Fin](6);
  let d = share(&shared);
  let moved: Rc[mut, Fin] = u;
  0
}
