// Moving a value out through a sole owning reference leaves the allocation
// behind, and the owner still gives its memory back: it dies hollow. Nothing
// that moved is finalized there -- the new holder finalizes it, once, at its
// own end.
//
// - The whole value moved out ('*b'): the memory is freed, and nothing else.
// - The value moved out through an owning reference that is the owner's value
//   ('**b'): that allocation dies hollow in turn, before the outer one's
//   memory is freed.
// - An element moved out of the array a sole owner points at ('s[0]'): the
//   memory is freed. Which elements moved is not tracked, so the ones that did
//   not are not finalized either (Fin 25 below): they leak rather than one
//   being finalized twice.
//
// Nothing moves out of a field (move_flow_field), so no struct dies with a
// hole in it.
//
// The regions here print when they free, and the counted one when it is
// asked, so the output is the whole assertion: what was freed, what was
// finalized, and in what order. A hollow owner is released where it would have
// been released whole: at its scope's end, at a return, or when it is
// reassigned. A variable hollowed on only some paths carries a flag saying at
// run time what it still holds: on the path that moved out through it, its
// memory is freed without what moved; on the path that did not, what stayed
// is finalized, then the memory freed ('cond').
//
// Before hollow deaths, every one of these allocations leaked except a whole
// value handed back by a block or a return ('*b'), whose owner was released
// whole: harmless while a death finalized nothing, a second finalize once it
// does. The two regions' 'free' calls C's through its package, as
// region_regionref's do.

mod region_hollow;

import stdio use *;
import libc;

fn show(label &[]u8, n i32) {
  printStr(label);
  printInt(i64.from(n));
  printStr("\n");
}

struct One is RegionRef, Move {
  fn alloc(size usize) *u8 inline { malloc(size); }
  fn free(self &uni One) inline { printStr("one free\n"); libc.free(self as *u8); }
}

struct Cnt is RegionRef {
  owners usize;
  fn alloc(size usize) *u8 inline { malloc(size); }
  fn init(self &new) inline { *self = new Cnt(1usize); }
  fn aliasRef(self &uni Cnt) inline { owners = owners + 1usize; }
  fn dealiasRef(self &uni Cnt) Bool inline { printStr("cnt dealias\n"); owners = owners - 1usize; owners == 0usize; }
  fn free(self &uni Cnt) inline { printStr("cnt free\n"); libc.free(self as *u8); }
}

struct Fin {
  pub v i32;
  fn final(self &uni) { show("final ", v); }
}

fn wholeOne() {
  printStr("-- whole value, single owner\n");
  imm c = { imm b = new One[Fin](1i32); *b; };
  printStr("moved\n");
}

fn wholeCounted() {
  printStr("-- whole value, sole counted owner\n");
  imm c = { imm b = new Cnt[Fin](2i32); imm d = *b; d; };
  printStr("moved\n");
}

fn throughOwned() {
  printStr("-- through an owner it owns\n");
  imm c = { imm b = new One[Cnt[Fin]](new Cnt[Fin](3i32)); imm d = **b; d; };
  printStr("moved\n");
}

fn giveWhole() Fin { imm b = new One[Fin](13i32); *b; }
fn giveCounted() Fin { imm b = new Cnt[Fin](16i32); return *b; }

fn returned() {
  printStr("-- returned\n");
  { imm a = giveWhole(); printStr("got it\n"); }
  { imm a = giveCounted(); printStr("got it\n"); }
}

fn reassigned() {
  printStr("-- reassigned after\n");
  mut b = new One[Fin](19i32);
  imm c = *b;
  b = new One[Fin](20i32);
  printStr("reassigned\n");
}

fn early(c Bool) Fin {
  imm b = new One[Fin](21i32);
  if c { return new Fin(22i32); }
  *b;
}

fn cond(c Bool) {
  imm b = new One[Fin](23i32);
  if c { imm x = *b; printStr("moved\n"); }
  printStr("end of cond\n");
}

fn element() {
  printStr("-- an array's element\n");
  imm s = new One[Array[Fin, 2]]([new Fin(24i32), new Fin(25i32)]);
  imm c = s[0];
  printStr("moved\n");
}

fn main() i32 {
  wholeOne();
  wholeCounted();
  throughOwned();
  returned();
  reassigned();
  printStr("-- returned before the move\n");
  { imm a = early(true); }
  printStr("-- returned after the move\n");
  { imm a = early(false); }
  printStr("-- moved on one path, taken\n");
  cond(true);
  printStr("-- moved on one path, not taken\n");
  cond(false);
  element();
  printStr("-- end\n");
  0i32;
}
