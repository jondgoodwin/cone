mod region_owner_replace_success;

import stdio use *;

// What region_flow_owner_replace leaves alone: a borrow into what an owner owns beside
// anything that cannot free it. A callee that only reads through the owner it is handed,
// or writes the Item (a field of it, or the whole Item in place: its old value finalized,
// the memory the borrow points at kept); an owner of another type replaced; another field
// of the ship; the owner replaced after the borrow's last use, or a local owner no
// borrow points into; a method that does not replace the owner. Every value and every
// 'final' printed is worked out by hand.

struct Item { pub v i64; fn final(self &uni) { printStr("final "); printInt(v); printStr("\n"); } }
struct Other { pub w i64; }
struct Ship { pub fuel i64; pub it Uni[Item]; }
struct ShipRc { pub fuel i64; pub it Rc[mut, Item]; }
struct Game {
  pub fuel i64;
  pub p Uni[Item];
  fn peek(self &mut) i64 { fuel = fuel + 1; fuel }
  fn reset(self &mut) { p = new Uni[Item](50); }
  fn frame(self &mut) i64 { let pp = &mut *p; peek(); pp.v }
}

fn reads(x &mut Uni[Item], y &mut Item) { printInt(x.v); printInt(y.v); printStr("\n"); }
fn writes(x &mut Uni[Item], y &mut Item) { x.v = 5; y.v = y.v + 1; printInt(y.v); printStr("\n"); }
fn inPlace(x &mut Uni[Item], y &mut Item) { **x = new Item(7); printInt(y.v); printStr("\n"); }
fn other(o &mut Uni[Other], y &mut Item) { *o = new Uni[Other](3); printInt(y.v); printStr("\n"); }
fn fuel(s &mut Ship, y &mut Item) { s.fuel = 4; printInt(y.v + s.fuel); printStr("\n"); }

// 1 and 1: the callee reads both names
fn readOnly() { var s = new Uni[Item](1); reads(&mut s, s); }

// the Item is 1, set to 5 through the owner, then 5 + 1 through the borrow
fn writeThrough() { var s = new Uni[Item](2); writes(&mut s, s); }

// the Item 3 is replaced in place by 7 (3 finalized); the owner and the borrow still reach it
fn writeInPlace() { var s = new Uni[Item](3); inPlace(&mut s, s); }

// an owner of another type is replaced; the Item is still 4
fn otherOwner() { var s = new Uni[Item](4); var o = new Uni[Other](1); other(&mut o, s); }

// another field of the ship is written: 5 + 4
fn otherField() { var sh = new Ship(0, new Uni[Item](5)); fuel(&mut sh, sh.it); }

// the borrow is used up first, then the other owner is replaced
fn usedFirst(a &mut Uni[Item], b &mut Uni[Item]) i64 {
  let n = (**a).v;
  *b = new Uni[Item](n + 100);
  n
}

// the owner is replaced after the last use of the borrow
fn lastUse(a &mut Uni[Item]) i64 {
  let y = &mut **a;
  let n = y.v;
  *a = new Uni[Item](n + 10);
  n
}

// a local owner no borrow points into is replaced beside the borrow
fn localOther(a &mut Uni[Item]) i64 {
  let y = &mut **a;
  var t = new Uni[Item](20);
  t = new Uni[Item](21);
  y.v + t.v
}

// the method that holds the borrow calls one that leaves the owner alone, and then one that does not
fn game() i64 {
  var g = new Game(0, new Uni[Item](8));
  let n = g.frame();
  g.reset();
  n + g.p.v
}

// an owner lent as the receiver of its own method: the borrow is the 'self' the method works on, no
// other name for the owner, though the method stores over an owner of its own type in a field and
// the call is handed another borrow (the tally's)
struct Tally { pub v i64; }
struct Chain {
  pub n i64;
  pub next Option[Uni[Chain]];
  fn addAfter(self &mut, x i64, log &mut Tally) { next = Some(new Uni[Chain](x, None)); log.v = log.v + 1; }
}

// the head is 1, the tally 5 + 2
fn chainLocal(log &mut Tally) i64 {
  var head = new Uni[Chain](1, None);
  let l = &mut *log;
  head.addAfter(5, l);
  head.addAfter(6, l);
  head.n
}

// the head is 2, the tally one more
fn chainParam(h &mut Uni[Chain], log &mut Tally) i64 {
  let l = &mut *log;
  h.addAfter(7, l);
  h.n
}

// a counted owner replaced after the last use of the borrow
fn rcAfter(a &mut ShipRc, b &mut ShipRc) i64 {
  let y = &mut *a.it;
  let n = y.v;
  b.it = new Rc[mut, Item](n + 1);
  n
}

fn main() {
  readOnly();
  writeThrough();
  writeInPlace();
  otherOwner();
  otherField();
  var a = new Uni[Item](30);
  var b = new Uni[Item](40);
  printInt(usedFirst(&mut a, &mut b)); printStr("\n");
  printInt(lastUse(&mut a)); printStr("\n");
  printInt(localOther(&mut a)); printStr("\n");
  printInt(game()); printStr("\n");
  var tally = new Tally(5);
  printInt(chainLocal(&mut tally)); printStr("\n");
  printInt(tally.v); printStr("\n");
  var h = new Uni[Chain](2, None);
  printInt(chainParam(&mut h, &mut tally)); printStr("\n");
  printInt(tally.v); printStr("\n");
  var r = new ShipRc(0, new Rc[mut, Item](60));
  var q = new ShipRc(0, new Rc[mut, Item](70));
  printInt(rcAfter(&mut r, &mut q)); printStr("\n");
  printInt(q.it.v); printStr("\n");
}
