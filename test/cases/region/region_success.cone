// Owning references: what '+region-perm value' allocates, which region strategy
// releases it, what permission it may carry, and how it interacts with the
// borrowed references and move semantics the tiers below establish.
//
// Everything is printed. Allocation, aliasing and release are runtime behavior,
// and a program that compiles proves none of it; the pairs that matter are a
// write through one alias followed by a read through another, and a read after
// the alias that made it went out of scope.
//
// Two regions exist, both defined in the core package: 'Rc', which carries a reference
// count and frees at zero, and 'So', which declares 'Move' and is freed by its
// single owner. A third is declared here, because a region is an ordinary
// struct declaring 'is RegionRef' and nothing in the compiler restricts the set
// to the two in core.
//
// Four things are deliberately absent, each with its own xfail scenario naming
// the defect: moving a 'So' reference between variables, releasing a
// region-allocated struct that owns a reference, assigning to an 'Rc' variable
// declared without an initial value, and passing an owning reference to a
// parameter expecting a borrowed one.
//
// An allocation nested inside another one is absent for a different reason: it
// works, and region_nested_alloc covers it.

mod region_success;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// A region is a struct declaring 'is RegionRef', with an 'alloc' static method
// returning '*u8' if anything allocates from it. 'Rc' also declares a counter
// field, an 'init' and the methods that count and free; this one needs none of
// them, which is the smallest region that can allocate. Declaring neither
// 'aliasRef' nor 'Move', its references are copied freely, an owner's going does
// nothing, and nothing is freed a value at a time: an arena's shape.
struct Arena is RegionRef {
  fn alloc(size usize) *u8 inline { malloc(size); }
}

struct Plain {
  pub n i32;
}

struct Held {
  pub r Rc[mut, i32];
  pub n i32;
}

struct Owned {
  pub r So[i32];
  pub n i32;
}

// -------- allocating --------

fn allocates() {
  // '+region-perm value' allocates a copy of the value in the region and yields
  // an owning reference to it, which '*' reads and writes like any reference
  mut r = new Rc[mut, u32](32);
  show("rc-allocated", i64.from(*r));
  *r = *r + 1u;
  show("rc-written-through", i64.from(*r));

  // 'So' is the single-owner region: no counter, freed when its owner dies
  imm s = new So[i32](21);
  show("so-allocated", i64.from(*s));

  // A region is not a fixed set of two. This one is declared above.
  imm a = new Arena[mut, i32](12);
  show("custom-region-allocated", i64.from(*a));

  // The value allocated may be a struct as easily as a number
  imm w = new So[Plain](41);
  show("allocated-struct-field", i64.from(w.n));
}

// An allocation may begin a line, which is where a returned one usually is
fn allocationStartsALine() Rc[mut, i32] {
  imm seed = 41i32;
  new Rc[mut, i32](seed);
}

// -------- reference counting --------

fn counts() {
  // An 'Rc' reference with an aliasable permission may be copied, and both
  // names reach the one allocation: a write through either is seen by the other
  mut first = new Rc[mut, i32](50);
  mut second = first;
  *second = 51;
  show("alias-sees-write", i64.from(*first));
  *first = 52;
  show("original-sees-write", i64.from(*second));

  // The count is what keeps the allocation alive: an alias made and dropped in
  // an inner block releases its share, and the outer reference still reads
  {
    mut inner = first;
    *inner = 53;
  }
  show("alive-after-alias-released", i64.from(*first));
}

// -------- permissions --------

fn permissions() {
  // Without an explicit permission an allocation is 'uni' -- one reference, no
  // aliases -- which is what makes an owning reference a move type by default
  imm sole = new Rc[i32](60);
  show("default-perm-uni", i64.from(*sole));

  // The aliasable permissions an allocation may carry instead
  imm shared = new Rc[imm, i32](61);
  imm readonly = new Rc[ro, i32](62);
  show("imm-perm", i64.from(*shared));
  show("ro-perm", i64.from(*readonly));

  // 'mut' is the one that may be written through, and the permission belongs to
  // the reference rather than to the variable holding it
  imm writable = new Rc[mut, i32](63);
  *writable = 64;
  show("mut-perm-writes", i64.from(*writable));
}

// -------- owning references in a struct --------

fn fields() {
  // A struct field may hold an owning reference. Its value is reached through
  // the field exactly as through a variable.
  mut h = new Held(r: new Rc[mut, i32](70), n: 71);
  show("rc-field", i64.from(*h.r));
  *h.r = 72;
  show("rc-field-written", i64.from(*h.r));
  show("plain-field-beside-it", i64.from(h.n));

  // ... and a 'So' field, which the struct then solely owns
  mut o = new Owned(r: new So[i32](73), n: 74);
  show("so-field", i64.from(*o.r));
  show("plain-field-beside-so", i64.from(o.n));

  // An owning field is an lval like any other, and a tuple assignment reaches
  // two of them at once. The 'Rc' field's previous allocation loses a count on
  // the way; the 'So' one's is only leaked, because genlStore counts 'Rc' alone.
  h.r, o.r = new Rc[mut, i32](75), new So[i32](76);
  show("rc-field-reassigned", i64.from(*h.r));
  show("so-field-reassigned", i64.from(*o.r));
}

// -------- owning references through calls --------

fn makeRc() Rc[mut, i32] { new Rc[mut, i32](80); }
fn takeRc(r Rc[mut, i32]) i32 { *r; }
fn passRc(r Rc[mut, i32]) Rc[mut, i32] { r; }

fn makeSo() So[i32] { new So[i32](83); }
fn takeSo(r So[i32]) i32 { *r; }

// A branch may choose between an existing owning reference and a new allocation,
// because both branches have the one reference type
fn chooseRc(r Rc[mut, i32]) Rc[mut, i32] {
  imm chosen Rc[mut, i32] = if *r == 81 { r; } else { new Rc[mut, i32](82); };
  chosen;
}

// Several return values, one of them owning
fn pairOut() u32, Rc[mut, i32] {
  24u, new Rc[mut, i32](85);
}

fn calls() {
  show("returned-from-call", i64.from(*makeRc()));
  imm r = new Rc[mut, i32](81);
  show("passed-into-call", i64.from(takeRc(r)));
  show("passed-out-and-back", i64.from(*passRc(r)));
  show("branch-kept-argument", i64.from(*chooseRc(r)));
  show("branch-allocated-instead", i64.from(*chooseRc(new Rc[mut, i32](9))));

  // 'So' travels into and out of a call the same way, so long as it lands in
  // no more than one variable on the way
  show("so-into-call", i64.from(takeSo(new So[i32](84))));
  show("so-out-of-call", i64.from(*makeSo()));

  // A tuple return carries an owning reference alongside a plain value
  imm pair = pairOut();
  show("tuple-plain-element", i64.from(pair.0));
  show("tuple-owning-element", i64.from(*pair.1));
}

// -------- owning and borrowed references together --------

fn onlyReads(n &i32) i32 { *n; }

fn withBorrows() {
  // '&*r' borrows from what an owning reference points at, and the borrow is
  // an ordinary borrowed reference: it passes to a function asking for '&i32'
  imm r = new Rc[mut, i32](90);
  imm b = &*r;
  show("borrowed-from-owning", i64.from(*b));
  show("borrow-passed-to-reader", i64.from(onlyReads(b)));

  // Owning references compare the values they refer to, like borrowed ones,
  // and '===' asks whether they are the same allocation. 'r' and 'other' are
  // two separate allocations holding the SAME number, so '==' says they are
  // equal (5 here, 3 by address) while '===' says they are not. The matching
  // 90s are the whole assertion: give 'other' a different number and the two
  // questions stop being told apart.
  imm aliased = r;
  imm other = new Rc[mut, i32](90);
  mut bits = 0;
  if r == aliased { bits = bits + 1; }
  if r != other { bits = bits + 2; }
  if r == other { bits = bits + 4; }
  show("owning-ref-equality-bits", i64.from(bits));

  mut same = 0;
  if r === aliased { same = same + 1; }
  if r !== other { same = same + 2; }
  if r === other { same = same + 4; }
  show("owning-ref-identity-bits", i64.from(same));
}

// -------- assignment and exchange --------

fn assigns() {
  // Assignment through owning references chains the way any assignment does
  mut a = new Rc[mut, i32](100);
  mut b = new Rc[mut, i32](200);
  a = b = makeRc();
  show("chained-assign-left", i64.from(*a));
  show("chained-assign-right", i64.from(*b));

  // Swap exchanges two owning references without either being released
  mut c = new Rc[mut, i32](110);
  mut d = new Rc[mut, i32](120);
  c <=> d;
  show("swap-left", i64.from(*c));
  show("swap-right", i64.from(*d));
}

// -------- allocating in a loop --------

fn repeats() {
  // Each iteration allocates and releases its own value
  mut i = 0;
  mut total = 0;
  while i < 4 {
    mut r = new Rc[mut, i32](i);
    total = total + *r;
    i++;
  }
  show("loop-allocation-total", i64.from(total));
}

// -------- function references --------

// Identity of two function references. 'ref' owns function references and
// compared data references only, so this one pairing was left here. A function
// has no '==' of its own for a reference to read through to, so two function
// references are compared for identity, '===', and ref_typecheck_compare
// asserts that '==' is refused.
//
// 'alsoOne' exists so the comparison can be told apart from one that reads
// through to what the functions are or do: it has the same signature as 'one'
// and returns the same number, so nothing about it differs except which
// function it is. Give it a different body and the case stops discriminating.
fn one() u32 { 1u; }
fn two() u32 { 2u; }
fn alsoOne() u32 { 1u; }

fn fnrefCompares() {
  mut bits = 0;
  if &one === &one { bits = bits + 1; }
  if &one !== &two { bits = bits + 2; }
  if &one === &two { bits = bits + 4; }
  if &one !== &alsoOne { bits = bits + 8; }
  if &one === &alsoOne { bits = bits + 16; }
  show("fnref-identity-bits", i64.from(bits));
}

fn main() i32 {
  allocates();
  show("allocation-starting-a-line", i64.from(*allocationStartsALine()));
  counts();
  permissions();
  fields();
  calls();
  withBorrows();
  assigns();
  repeats();
  fnrefCompares();
  0i32;
}
