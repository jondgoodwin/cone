// A borrow from a pool reached through a '&mut' parameter freezes the pool
// against a change made through a second '&mut' parameter, though the two may
// be one pool at the call: part (b) of the shape-changing rule
// (collection_flow_reshape, which pins it for the collections), here for a
// pool, where the change that would dangle the borrow is 'remove' finalizing
// its value or 'add' moving every value. The borrow is a bare one from
// 'pool[r]' or '&mut pool[r]', or the borrow an 'Option' from 'getMut' holds,
// and the second reference changes the pool by a method, through a function it
// is handed to, or while the first is a field of 'self'.
// Uses the pool package.

mod region_flow_pool_twomut;

import pool use *;

struct Pt { pub x i64; pub y i64; }

// A mutable borrow held while the second reference removes the value
fn mutThenRemove(p &mut Pool[Pt], q &mut Pool[Pt]) i64 {
  imm r = p.add(new Pt(1, 2));
  imm x = &mut p[r];
  q.remove(r);                  //~ ErrorShapeReshape:4 "could change the shape of a 'Pool'"
  x.x;
}

// A read-only borrow held while the second reference removes the value
fn readThenRemove(p &mut Pool[Pt], q &mut Pool[Pt]) i64 {
  imm r = p.add(new Pt(1, 2));
  imm x = p[r];
  q.remove(r);                  //~ ErrorShapeReshape:4 "could change the shape of a 'Pool'"
  x.x;
}

// The borrow inside the Option 'getMut' returns, bound by a match
fn getMutThenRemove(p &mut Pool[Pt], q &mut Pool[Pt]) i64 {
  imm r = p.add(new Pt(1, 2));
  match p.getMut(r) {
    case imm e Some { q.remove(r); e.x; } //~ ErrorShapeReshape
    else { 0; }
  }
}

// The second reference adds, which may move every value
fn mutThenAdd(p &mut Pool[Pt], q &mut Pool[Pt]) i64 {
  imm r = p.add(new Pt(1, 2));
  imm x = &mut p[r];
  q.add(new Pt(3, 4));          //~ ErrorShapeReshape:4 "could change the shape of a 'Pool'"
  x.x;
}

fn dropIt(q &mut Pool[Pt], r Ref[Pt]) {
  q.remove(r);
}

// The second reference handed to a function whose body removes
fn mutThenCall(p &mut Pool[Pt], q &mut Pool[Pt]) i64 {
  imm r = p.add(new Pt(1, 2));
  imm x = &mut p[r];
  dropIt(q, r);                 //~ ErrorShapeReshape:9 "'dropIt' is handed something that reaches a 'Pool'"
  x.x;
}

// The first reference a field of 'self', the second a parameter
struct Game {
  pub pool Pool[Pt];

  fn mutThenRemoveElsewhere(self &mut, q &mut Pool[Pt]) i64 {
    imm r = pool.add(new Pt(1, 2));
    imm x = &mut pool[r];
    q.remove(r);                //~ ErrorShapeReshape:6 "could change the shape of a 'Pool'"
    x.x;
  }
}

fn main() {}
