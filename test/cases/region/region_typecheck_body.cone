// What is refused of a body whose length a reference carries ('str', the body
// of bytes). It has no size of its own, so it is held only through a
// reference, in every region: held by value it is ErrorNoSize, whether a
// local, a parameter or a field, and so is its value read out through a
// reference. It has no value to construct or move in, so an allocation of it
// copies a borrow of one, 'Uni[str](view)': none, or more, or something
// that is not a borrow of one, is refused. A borrow of it reads and does not
// write (a '&mut' of it is ErrorImmutableWrite: str declares Immutable, and
// ref_typecheck_immutable has the rest of that). It
// is the size of a pointer and a count, and converts to nothing narrower or of
// another kind (region_body and ref_body have the slice of bytes it converts to).
//
// An owner of it that is the only holder moves like any: the copy of a
// 'uni' owner is a move, and the original is gone (ErrorMove, which flow
// reports in a function whose own check passed). Written with no permission an
// owner of it is 'imm' and copies (ref_flow_immutable), so 'uni' is written.

mod region_typecheck_body;

struct Bad {
  pub s: str;                     //~ ErrorNoSize:7 "Field s cannot be held by value"
}

fn byValue(s: str) {              //~ ErrorNoSize:12 "str is a dynamically sized body, whose length is carried by a reference to it"
}

fn deref(r: &str, o: Uni[str]) {
  let a = *r;                    //~ ErrorNoSize:7 "Variable a cannot be held by value"
  let b = *o;                    //~ ErrorNoSize:7 "Variable b cannot be held by value"
}

fn allocate(v: &str) {
  let none = Uni[str]();      //~ ErrorAllocValue:14 "its allocation copies a borrow of one"
  let two = Uni[str](v, v);   //~ ErrorAllocValue:13 "str has no value to construct"
  let number = Uni[str](5);   //~ ErrorInvType:25 "copied from a borrow of str"
}

fn write(v: &str) {
  let m = &mut *v;               //~ ErrorImmutableWrite:11 "str declares Immutable"
}

fn convert(v: &str) {
  let n = v as i64;              //~ ErrorInvType:11 "same sized primitive type"
  let p = v as *u8;              //~ ErrorInvType:11 "same sized primitive type"
  let r = v as &i32;             //~ ErrorInvType:11 "same sized primitive type"
}

fn size() {
  let n = mem.sizeof[str]();     //~ ErrorIntrinsicType:21 "The intrinsic sizeof needs a type with a size"
}

fn show(s: &str) {
}

// Flow: a unique owner moves, and the original is gone
fn moved(v: &str) {
  let a = Rc[uni, str](v);
  let b = a;
  show(a);                       //~ ErrorMove:8 "moved out"
}
