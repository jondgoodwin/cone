// Releasing a region-allocated struct that owns an 'rc' reference releases the
// field's referent too.
//
// The struct's drop reaches an owning field with a struct GEP, which yields the
// address of the field, and loads the reference the field holds before handing it
// to the release path. Without the load the counter decremented is whatever sits
// eight bytes before the field.
//
// 'stack' is copied into the allocation, so it and the allocated copy are two
// holders of the counted field, each released as it dies: the allocated one when
// 'owned' goes, then 'stack' itself, whose release is the last and frees it.

mod region_owning_field;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Held {
  pub r +rc-mut i32;
  pub n i32;
}

fn f() {
  mut stack = Held[r: +rc-mut 90, n: 91];
  imm owned = +so stack;
  show("owning-field-of-allocated-struct", i64[*owned.r]);
}

fn main() i32 {
  f();
  0i32;
}
