// Assigning to a variable that already holds an owning reference releases the
// value it held, in region 'Uni' as in 'Rc': freed once, before the store, in
// every spelling the store has -- a single reference, a field, and each
// iteration of a loop. A variable that holds nothing releases nothing first:
// one declared without a value, and one whose value was moved out.
//
// genlStore released a previous value only for an 'Rc' reference, so every
// reassignment of a 'Uni' variable leaked what it held. It now hands the old
// value to the same release scope exit uses. The gate is FlagFirstAssign, which
// flow sets on the assignment site when the variable was never initialized;
// a moved-out variable holds nothing either, and the flag now says so too --
// for 'Uni', where a move is the ordinary hand-over, and for a 'uni' 'Rc'
// reference, whose count the reassignment used to drop a second time.

mod region_uni_reassign;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn take(p Uni[i32]) i64 {
  i64.from(*p);
}

fn takeUni(p Rc[uni, i32]) i64 {
  i64.from(*p);
}

fn firstAssign() {
  var p Uni[i32];
  p = new Uni[i32](1);
  show("first-assignment", i64.from(*p));
}

fn reassign() {
  var p = new Uni[i32](1);
  p = new Uni[i32](2);
  show("reassigned", i64.from(*p));
}

fn reassignAfterMove() {
  var p = new Uni[i32](1);
  let t = take(p);
  p = new Uni[i32](2);
  show("reassigned-after-move", i64.from(*p) + t);
}

fn uniReassignAfterMove() {
  var p = new Rc[uni, i32](1);
  let t = takeUni(p);
  p = new Rc[uni, i32](2);
  show("uni-reassigned-after-move", i64.from(*p) + t);
}

fn loopAssign() {
  var p = new Uni[i32](0);
  var i = 0;
  while i < 3 {
    p = new Uni[i32](i);
    i = i + 1;
  }
  show("reassigned-in-loop", i64.from(*p));
}

struct Holder {
  pub p Uni[i32];
}

fn fieldReassign() {
  var s = new Holder(new Uni[i32](1));
  s.p = new Uni[i32](2);
  show("field-reassigned", i64.from(*s.p));
}

fn main() i32 {
  firstAssign();
  reassign();
  reassignAfterMove();
  uniReassignAfterMove();
  loopAssign();
  fieldReassign();
  0i32;
}
