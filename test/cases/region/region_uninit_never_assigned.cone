// An owning-reference variable that is declared without a value and never
// assigned one owns nothing, so leaving its scope releases nothing.
//
// flowScopeDealias built a release for every 'Uni' and 'Rc' variable in scope
// whether or not it had ever been given a value, so the storage of a variable
// that was only declared was freed: 'free' on whatever the 'Uni' slot happened to
// hold, and a count decrement through whatever the 'Rc' slot happened to hold.
// The program died of heap corruption. Flow already records on the variable that
// it holds a value, and scope exit now asks.
//
// 'var' and 'let' are both here because delayed initialization is allowed for
// either, and each region is here because their releases are different code.

mod region_uninit_never_assigned;

import stdio use *;

fn neverAssignedMut() {
  var r: Rc[mut, i32];
  var s: Uni[i32];
}

fn neverAssignedImm() {
  let r: Rc[mut, i32];
  let s: Uni[i32];
}

fn main() i32 {
  neverAssignedMut();
  printStr("mut-never-assigned = ok\n");
  neverAssignedImm();
  printStr("imm-never-assigned = ok\n");
  0i32
}
