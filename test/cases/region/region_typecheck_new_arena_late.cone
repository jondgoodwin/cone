// The head of 'new a[Pt](1)' is checked on a copy first, to learn whether it is a
// region, with the copy's diagnostics thrown away. A global the head names that
// is checked for the first time there is not the copy's: it is checked once and
// only there, so its own error is the program's. Here the global is written
// after main and is initialized by a call. It was thrown away with the copy, the
// global left marked checked, and this program compiled with no error.

mod region_typecheck_new_arena_late;

import arena use *;

struct Pt {
  pub x: i64;
}

fn main() {
  let p = new ga[Pt](1);
}

var ga = Arena.empty();                    //~ ErrorNotLit:5 "Variable may only be initialized with a literal value"
