// The program: its roots and package keeper's are links of one chain. main
// holds leaf 1; keeper's 'hold', compiled in keeper's object, holds it again
// as its parameter and its own leaf 2 while it calls 'report' back, which
// holds leaf 3. So the roots 'report' traces (through keeper's 'roots') come
// from three frames in two objects: 3 2 1x2. After 'hold' returns, only
// main's is left.

mod prog;

import stdio use *;
import keeper use *;

fn report(n i64) {
  imm held = +tr-mut Leaf[n + 100];
  roots("callback");
}

fn main() i32 {
  imm a = +tr-mut Leaf[1];
  hold(a, &report);
  roots("after");
  0i32;
}
