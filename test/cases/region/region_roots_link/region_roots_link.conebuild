// A program whose frames of traced references and a separately compiled
// package's are links of one chain. Package keeper is compiled first
// (package\keeper.conebuild, listed under 'link' in cases.toml), and this
// program is compiled against the include file keeper's compile generates.
// The two objects are then linked, with conestd, and run.

build: debug
output: executable

import keeper: "include/keeper.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import keeper: "include/keeper.cone"
    import stdio: "stdio.cone"
}
