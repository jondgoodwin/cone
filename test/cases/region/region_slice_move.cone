// A '+[]So' slice moved out of its variable is not released there. Every
// allocation below is handed on -- to another variable that is then returned,
// to a callee that returns its parameter, or straight back to the caller -- so
// nothing in this module may free or adjust a count. A '+[]Rc' slice under its
// default 'uni' permission moves the same way.

mod region_slice_move;

fn movedToVariable() +[]So i32 {
  imm a = +[]So [4; 1];
  imm b = a;
  b;
}

fn hold(s +[]So i32) +[]So i32 {
  s;
}

fn movedToArgument() +[]So i32 {
  imm a = +[]So [4; 2];
  imm r = hold(a);
  r;
}

fn returned() +[]So i32 {
  imm a = +[]So [4; 3];
  a;
}

fn rcMovedToVariable() +[]Rc i32 {
  imm a = +[]Rc [4; 4];
  imm b = a;
  b;
}
