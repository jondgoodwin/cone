// The 'init' method a region or a permission may declare, and the shape it has
// to have when it does.
//
// 'init' is optional on both. Where it exists, allocation calls it on the
// allocation's header, right after 'alloc', and it fills the header in place
// -- core's 'Rc' uses it to set the reference count to one -- so it is
// 'fn init(self &new)', taking nothing else. That it fills in place and
// returns nothing is every struct's init's rule, checked where the method is
// (ir/stmt/fndcl.c); that it takes nothing but self is the region's rule,
// checked in ir/types/region.c where the region is declared, and the
// permission's, checked in ir/types/permission.c where an allocation names the
// permission, which is why the permissions are allocated from below and the
// regions need not be; they are separated from the scenario for the other
// region methods, region_typecheck_region, because the permission half is
// reached by a different call.
//
// The permission cases are this group's only lock permissions: a struct
// declaring 'LockPermission', whose 'init' an allocation runs on the lock in
// its header. Everything else about them is the region_lockperm_* scenarios'.

mod region_typecheck_init;

struct RegionParms is RegionRef {
  fn alloc(size usize) *u8 inline { malloc(size); }
  fn init(self &new, x usize) inline { *self = new RegionParms(); }       //~ ErrorBadAlloc "Region init method may not have parameters but self"
}

struct RegionReturn is RegionRef {
  cnt usize;
  fn alloc(size usize) *u8 inline { malloc(size); }
  fn init() RegionReturn inline { new RegionReturn(1usize); }              //~ ErrorInitDcl "An init fills its value in place"
}

struct permParms is LockPermission {
  held usize;
  fn init(self &new, x bool) inline { *self = new permParms(0usize); }     //~ ErrorInvType "Permission init method may not have parameters but self"
  fn acquireMut(self &uni permParms) { }
  fn releaseMut(self &uni permParms) { }
}

struct permReturn is LockPermission {
  held usize;
  fn init(self &new) usize inline { *self = new permReturn(0usize); 0usize; }  //~ ErrorInitDcl "An init returns nothing"
  fn acquireMut(self &uni permReturn) { }
  fn releaseMut(self &uni permReturn) { }
}

fn f() {
  imm c = new Rc[permParms, i32](3);
  imm d = new Rc[permReturn, i32](4);
}
