// A request for an aligned block whose alignment is not a power of two panics,
// naming it, and nothing after it runs.

mod region_aligned_bad_align;

import stdio use *;

fn main() {
  printStr("asking\n");
  let p = RawBlocks.allocAligned(4096usize, 3000usize);
  printStr("not reached\n");
  RawBlocks.releaseAligned(p);
}
