// A match that binds a payload which is a move type takes it out of the
// scrutinee on the arm's path, so the scrutinee read after the match is a use of
// a moved value: refused, never a copy or a second release. The same shape on a
// counted payload is accepted (region_match_moves, 'localReadAfter'): the arm
// copies, and the scrutinee stays whole.

mod region_match_moves_flow;

fn bad(p: Option[Uni[i32]]) i32 {
  match p {
    case let Some[Uni[i32]](x) { }
    else { }
  }
  let q = p;                    //~ ErrorMove "has been moved out"
  0
}

fn counted(p: Option[Rc[mut, i32]]) i32 {
  match p {
    case let Some[Rc[mut, i32]](x) { }
    else { }
  }
  let q = p;
  0
}

fn main() i32 { 0i32 }
