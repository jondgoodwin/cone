// A region ref that asks for the value's type record. Its 'alloc' takes one
// after the size, 'fn alloc(size usize, ty *TypeRecord) *u8', and that shape is
// the whole request: the compiler passes the record of the allocated value's
// type (core's TypeRecord: size, alignment, finalizer, trace, flags) to such an
// 'alloc', and only to such an 'alloc'. 'Rc' and 'Uni', whose 'alloc' takes the
// size alone, are called as they always were (the 'plain-regions-unchanged'
// check), in the same program.
//
// 'Kept' is a collector's shape, a region that owns death in its own loop: it
// declares no 'aliasRef', no 'dealiasRef' and not 'Move', so the compiler never
// finalizes or frees what it holds. Its 'alloc' writes the header itself --
// the next object and the record -- and links it into a list, printing what
// the record says. 'sweep' is that loop: it walks the list, finds each value
// past its header by the record's alignment, and runs the record's finalizer
// on it, then frees it. So each value's death in the output comes from the
// record alone: 'final', then its fields' finalizers, then the owners its fields
// hold (a 'Uni' one finalized and freed), exactly as the compiler runs it for
// the same type anywhere; nothing for a type with nothing to finalize.
//
// The record 'alloc' is handed is the one 'mem.typeRecord[T]()' gives in the
// same object, so the two compare equal.

mod region_typerecord;

import stdio use *;
import libc;

fn line(label &str, n usize) {
  printStr(label);
  printInt(i64.from(n));
  printStr("\n");
}

// The newest object 'Kept' allocated, as an address; 0 for none
var @threadlocal keptHead = 0usize;

struct Kept is RegionRef {
  pub next usize;      // the object allocated before this one
  pub ty *TypeRecord;  // what 'alloc' was handed

  fn alloc(size usize, ty *TypeRecord) *u8 {
    let rec = ty as &TypeRecord;
    printStr("kept alloc "); printInt(i64.from(size));
    printStr(": value "); printInt(i64.from(rec.size));
    printStr(", align "); printInt(i64.from(rec.align));
    printStr(", flags "); printInt(i64.from(rec.flags));
    printStr("\n");
    let p = malloc(size);
    mem.writeRaw(p as *Kept, new Kept(keptHead, ty));
    keptHead = p as usize;
    p;
  }
}

// Every object 'Kept' holds dies, newest first: its value finalized by its
// record, then its memory freed. The value sits after the header, rounded up
// to the value's alignment, which is where the compiler put it (the
// {region, permission, value} layout, whose permission takes no room).
fn sweep() {
  while keptHead != 0usize {
    let hdr = keptHead as &Kept;
    keptHead = hdr.next;
    let rec = hdr.ty as &TypeRecord;
    let align = rec.align;
    let at = (hdr as usize + mem.sizeof[Kept]() + align - 1usize) & (0usize - align);
    let fin = rec.finalize;
    fin(at as *u8);
    libc.free(hdr as *u8);
  }
}

struct Fin {
  pub v i32;
  fn final(self &uni) { line("Fin final ", usize.from(v)); }
}

// Its death: its own 'final', reading what its field owns, then the owner
struct Holder {
  pub id i32;
  pub inner Uni[Fin];
  fn final(self &uni) { line("Holder final, holds ", usize.from(inner.v)); }
}

struct Plain {
  pub a i64;
  pub b u8;
}

// A value holding an array: its record's size is the whole of it
struct Wide {
  pub a Array[u64, 4];
}

fn main() {
  printStr("-- allocate\n");
  let a = new Kept[mut, Fin](1i32);
  let b = new Kept[mut, Plain](2, 3u8);
  let c = new Kept[mut, Holder](4i32, new Uni[Fin](5i32));
  let d = new Kept[mut, i32](6);
  let e = new Kept[mut, Wide]([7u64, 8u64, 9u64, 10u64]);
  line("read back ", usize.from(a.v) + usize.from(b.b) + usize.from(c.inner.v) + usize.from(*d) + usize.from(e.a[3]));
  // The same record in this object as 'mem.typeRecord' gives
  if (keptHead as &Kept).ty == mem.typeRecord[Wide]() { printStr("same record\n"); }

  printStr("-- Rc and Uni, unchanged\n");
  {
    let r = new Rc[mut, Fin](11i32);
    let s = new Uni[Fin](12i32);
  }

  printStr("-- sweep\n");
  sweep();
  printStr("swept\n");
}
