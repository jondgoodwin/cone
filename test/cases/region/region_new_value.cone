// An allocation's one argument may be a finished value of the value type,
// which is moved in, as though every type had an init taking a finished value
// of itself: 'Rc[i32](5)'. A type no init constructs (a number, an array,
// a tuple, an enum) takes exactly that one value, coerced to it, so a number
// literal adopts the value type and a variant becomes its enum. A struct's one
// argument is the finished value when its type is the struct itself, after
// aliases; otherwise the arguments go to the struct's inits, as for any
// construction.
//
// Each region takes a finished value: Uni, Rc, Arc, Rcw and a region written
// here. The order is printed: the value is evaluated first, then the region's
// 'alloc', then its 'init', then the value is stored, no value init running.
// 'trynew' with a finished value gives Some, or None from a failing region.

mod region_new_value;

import stdio use *;
import libc;
import sync use Arc;
import rcweak;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// A region that says when it is called
struct Loud is RegionRef {
  pub count: usize;
  fn alloc(size: usize) *u8 { printStr("alloc\n"); libc.malloc(size) }
  fn init(self: &new) { printStr("region init\n"); *self = Loud(1usize); }
  fn aliasRef(self: &uni Loud) inline { count = count + 1usize; }
  fn dealiasRef(self: &uni Loud) bool inline { count = count - 1usize; count == 0usize }
  fn free(self: &uni Loud) { printStr("free\n"); libc.free(self as *u8); }
}

// A region whose every allocation fails
struct NeverAllocs is RegionRef {
  fn alloc(size: usize) *u8 inline { 0usize as *u8 }
}

// Only the implicit init, which takes the fields
struct Point {
  pub x: i64;
  pub y: i64;
}

// A declared init, which says when it runs
struct Seeded {
  pub seed: i64;
  pub fn init(self: &new, n: i64) {
    printStr("seeded init\n");
    *self = Seeded(seed: n * 10);
  }
}
alias Seed = Seeded;

fn value(n: i64) i64 {
  printStr("value ");
  printInt(n);
  printStr("\n");
  n
}

fn seeded(n: i64) Seeded {
  Seeded(n)
}

fn regions() {
  let so = Uni[i64](1);
  show("so", *so);
  let rc = Rc[mut, i64](2);
  show("rc", *rc);
  let arc = Arc[imm, i64](3);
  show("arc", *arc);
  let rcw = rcweak.Rcw[mut, i64](4);
  show("rcw", *rcw);
  let loud = Loud[i64](5);
  show("loud", *loud);
}

fn values() {
  // A number literal adopts the value type
  let wide = Rc[u64](6);
  show("number", i64.from(*wide));

  // A variable, moved in
  let n = 7i64;
  let vn = Uni[i64](n);
  show("variable", *vn);

  // A call's result
  let call = Rc[imm, i64](value(8));
  show("call", *call);

  // An array literal and a tuple
  let arr = Rc[mut, Array[i64, 3]]([9, 10, 11]);
  show("array", arr[0] + arr[1] + arr[2]);
  let tup = Uni[(i64, i64)]((12, 13));
  show("tuple", tup.0 * 100 + tup.1);

  // A variant, which becomes its enum
  let opt = Uni[Option[i64]](Some(14i64));
  match *opt {
    case let Some[i64](s) { show("variant", s); }
    else { show("variant-none", 0); }
  }
}

fn structs() {
  // A struct's own value is moved in: no init runs
  let s = Seeded(2);
  let moved = Rc[mut, Seeded](s);
  show("struct-moved", moved.seed);
  // Through an alias of the struct, the same
  let t = Seeded(3);
  let aliased = Uni[Seed](t);
  show("struct-alias", aliased.seed);
  // A call's result of the struct is a finished value too
  let made = Uni[Seeded](seeded(4));
  show("struct-call", made.seed);
  // Anything else goes to the inits: here the declared one
  let built = Rc[mut, Seeded](5);
  show("struct-init", built.seed);

  // The implicit init: the fields, or a finished value
  let p = Point(1, 2);
  let pmoved = Uni[Point](p);
  show("point-moved", pmoved.x * 10 + pmoved.y);
  let pbuilt = Uni[Point](3, 4);
  show("point-init", pbuilt.x * 10 + pbuilt.y);
}

fn order() {
  printStr("-- order\n");
  let n = Loud[mut, i64](value(20));
  show("stored", *n);
  let s = Loud[mut, Seeded](seeded(21));
  show("stored-struct", s.seed);
}

fn fallible() {
  let some = trynew Uni[i64](30);
  match some {
    case let Some[Uni[i64]](x) { show("trynew-some", *x); }
    else { show("trynew-none", 0); }
  }
  let p = Point(3, 1);
  let none = trynew NeverAllocs[mut, Point](p);
  match none {
    case let Some[NeverAllocs[mut, Point]](x) { show("trynew-failing", x.x); }
    else { show("trynew-failing-none", 0); }
  }
}

fn main() i32 {
  regions();
  values();
  structs();
  order();
  fallible();
  0i32
}
