mod region_flow_borrowmoved;

// A variable holding a sole owning reference -- any 'Uni', and 'Rc', which is
// 'Rc[uni, T]' -- whose reference was moved out may not be borrowed, as it may not
// be read: the reference, its referent and a field of its referent are all gone
// with the move. So is a variable hollowed by a move out through its reference.
// Each once compiled clean, because the borrow's own flow step looked at nothing.
//
// A new reference makes the variable borrowable again, and a borrow taken
// before the move is untouched; the unannotated lines assert both.
// move_flow_borrowmoved is the same rule for a value held on the stack.

struct Fin {
  pub n i64;
  fn final(self &uni) {}
  pub fn set(self &mut, v i64) { n = v; }
}

fn main() i32 {
  var a = new Uni[Fin](0i64);
  let before = &a.n;
  let ma = a;
  let ra = &a;                  //~ ErrorMove:13 "moved out"

  var b = new Uni[Fin](0i64);
  let mb = b;
  let rb = &b.n;                //~ ErrorMove:13 "moved out"

  var c = new Uni[Fin](0i64);
  let mc = c;
  let r3 = &mut *c;             //~ ErrorMove:18 "moved out"

  var d = new Uni[Fin](0i64);
  let md = d;
  d.set(5i64);                  //~ ErrorMove:3 "moved out"

  var e = new Rc[Fin](0i64);
  let me = e;
  let re = &e.n;                //~ ErrorMove:13 "moved out"

  var f = new Uni[Fin](0i64);
  let mf = *f;
  let rf = &f.n;                //~ ErrorMove:13 "moved out"

  var g = new Uni[Fin](0i64);
  let mg = g;
  g = new Uni[Fin](1i64);
  g.set(3i64);
  let rg = &mut g.n;

  0i32
}
