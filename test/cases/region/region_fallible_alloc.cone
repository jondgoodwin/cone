// Fallible allocation: '?+region-perm value' yields an 'Option' of the owning
// reference instead of the reference itself. A successful allocation is the
// 'Some' variant holding the reference; a failed one -- the region's 'alloc'
// returned null -- is 'None', where the plain form would have panicked.
//
// Every spelling is measured, because the crash this scenario landed with hit
// all of them: 'rc' and 'so', 'mut' and 'imm', a variable declared with the
// allocation and one assigned it afterwards, matched through a reference and
// by value. The failure path is reached by declaring a region whose 'alloc'
// always returns null, which region-success's 'arena' shows a region is free
// to do; the panic of the plain form has no stable exit status to assert, so it
// is not exercised here.
//
// The layout is the nullable pointer enum-nullable-ptr owns: 'Option[+rc-mut
// i32]' is a bare pointer, and null is 'None'. A check in cases.toml asserts
// that no tag or wrapper struct was emitted for it.
//
// What is not measured: the reference a 'Some' holds is not released when the
// Option goes out of scope, and nothing here asserts that it is.

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// A region whose every allocation fails
struct never {
  fn alloc(size usize) *u8 inline { 0usize as *u8; }
}

// -------- taking the result apart --------

fn readRcMut(o &Option[+rc-mut i32]) i32 {
  match o {
    case imm s &Some[+rc-mut i32] {*s.value;}
    else {-1i32;}
  }
}

fn readRcImm(o &Option[+rc-imm i32]) i32 {
  match o {
    case imm s &Some[+rc-imm i32] {*s.value;}
    else {-1i32;}
  }
}

fn readSoMut(o &Option[+so-mut i32]) i32 {
  match o {
    case imm s &Some[+so-mut i32] {*s.value;}
    else {-1i32;}
  }
}

fn readSoImm(o &Option[+so-imm i32]) i32 {
  match o {
    case imm s &Some[+so-imm i32] {*s.value;}
    else {-1i32;}
  }
}

// Both arms named, since the empty one is the arm a failed allocation takes
fn readNever(o &Option[+never-mut i32]) i32 {
  match o {
    case imm s &Some[+never-mut i32] {*s.value;}
    case imm n &None[+never-mut i32] {-1i32;}
  }
}

fn main() i32 {
  // The allocation succeeds, and the Option holds the reference
  imm a = ?+rc-mut 7i32;
  imm b = ?+rc-imm 8i32;
  imm c = ?+so-mut 9i32;
  imm d = ?+so-imm 10i32;
  show("rc-mut", readRcMut(&a));
  show("rc-imm", readRcImm(&b));
  show("so-mut", readSoMut(&c));
  show("so-imm", readSoImm(&d));

  // The allocation fails, and the Option is empty
  imm e = ?+never-mut 11i32;
  show("failed-allocation", readNever(&e));

  // Assigned into a declared Option variable, and matched by value
  mut f Option[+rc-mut i32] = ?+rc-mut 3i32;
  f = ?+rc-mut 4i32;
  match f {
    case imm s Some[+rc-mut i32] {show("assigned-by-value", i64[*s.value]);}
    else {show("assigned-by-value", -1);}
  }
  0i32;
}
