// Fallible allocation: 'trynew R[perm, T](value)' yields an 'Option' of the owning
// reference instead of the reference itself. A successful allocation is the
// 'Some' variant holding the reference; a failed one -- the region's 'alloc'
// returned null -- is 'None', where the plain form would have panicked.
//
// Every spelling is measured, because the crash this scenario landed with hit
// all of them: 'Rc' and 'Uni', 'var' and 'let', a variable declared with the
// allocation and one assigned it afterwards, matched through a reference and
// by value. The failure path is reached by declaring a region whose 'alloc'
// always returns null, which region_success's 'arena' shows a region is free
// to do; the panic of the plain form is exception_nomemory's.
//
// The layout is the nullable pointer enum_nullable_ptr owns: 'Option[Rc[mut,
// i32]]' is a bare pointer, and null is 'None'. A check in cases.toml asserts
// that no tag or wrapper struct was emitted for it.
//
// What is not measured: the reference a 'Some' holds is not released when the
// Option goes out of scope, and nothing here asserts that it is.

mod region_fallible_alloc;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// A region whose every allocation fails
struct NeverAllocs is RegionRef {
  fn alloc(size usize) *u8 inline { 0usize as *u8 }
}

// -------- taking the result apart --------

// Each is matched through an '&imm' reference, since its binding is a
// reference into the Option
fn readRcMut(o &imm Option[Rc[mut, i32]]) i32 {
  match o {
    case let s &Some[Rc[mut, i32]] {**s}
    else {-1i32}
  }
}

fn readRcImm(o &imm Option[Rc[imm, i32]]) i32 {
  match o {
    case let s &Some[Rc[imm, i32]] {**s}
    else {-1i32}
  }
}

fn readUni(o &imm Option[Uni[i32]]) i32 {
  match o {
    case let s &Some[Uni[i32]] {**s}
    else {-1i32}
  }
}

fn readUniImm(o &imm Option[Uni[imm, i32]]) i32 {
  match o {
    case let s &Some[Uni[imm, i32]] {**s}
    else {-1i32}
  }
}

// Both arms named, since the empty one is the arm a failed allocation takes
fn readNever(o &imm Option[NeverAllocs[mut, i32]]) i32 {
  match o {
    case let s &Some[NeverAllocs[mut, i32]] {**s}
    case let n &None[NeverAllocs[mut, i32]] {-1i32}
  }
}

fn main() i32 {
  // The allocation succeeds, and the Option holds the reference
  let a = trynew Rc[mut, i32](7);
  let b = trynew Rc[imm, i32](8);
  let c = trynew Uni[i32](9);
  let d = trynew Uni[imm, i32](10);
  show("rc-mut", readRcMut(&imm a));
  show("rc-imm", readRcImm(&imm b));
  show("uni", readUni(&imm c));
  show("uni-imm", readUniImm(&imm d));

  // The allocation fails, and the Option is empty
  let e = trynew NeverAllocs[mut, i32](11);
  show("failed-allocation", readNever(&imm e));

  // Assigned into a declared Option variable, and matched by value
  var f Option[Rc[mut, i32]] = trynew Rc[mut, i32](3);
  f = trynew Rc[mut, i32](4);
  match f {
    case let s Some[Rc[mut, i32]] {show("assigned-by-value", i64.from(*s));}
    else {show("assigned-by-value", -1);}
  }
  0i32
}
