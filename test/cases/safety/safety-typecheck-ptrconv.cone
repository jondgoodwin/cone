// Conversions into and out of a pointer that the compiler will not make.
//
// A pointer converts freely to and from another pointer or a reference of the
// same value type, and to nothing else. Every case here is one step outside
// that, and each carries a different message under the one code, so the quoted
// substrings are what tell them apart.
//
// Type check stage only. 'typemgmt' owns 'as' and 'into' in general; what is
// claimed here is only which conversions a pointer takes part in.

fn toNumber(p *i32) {
  // A pointer is not a number, so it does not initialize one
  imm bad i32 = p          //~ ErrorInvType:17 "does not match variable's declared type"
}

fn fromWrongReference() {
  // A reference coerces to a pointer only when the value types are the same
  mut f = 1.5
  imm bad *i32 = &f        //~ ErrorInvType:18 "does not match variable's declared type"
}

fn recastToNumber(p *i32) {
  // 'as' reinterprets between same-sized types; a pointer is not i32-sized
  imm bad = p as i32       //~ ErrorInvType:13 "same sized primitive type"
}

fn convertToNumber(p *i32) {
  // 'into' converts between number types and between pointer-like types, but
  // not across that line
  imm bad = p into i32     //~ ErrorInvType:20 "Unsupported built-in type conversion"
}

fn fromNil() {
  // 'nil' is the void value, not a null pointer. The compiler offers no way to
  // spell a null pointer at all, which is why safety-pointers can establish
  // only the true side of a pointer's truth value.
  imm bad *i32 = nil       //~ ErrorInvType:18 "does not match variable's declared type"
}
