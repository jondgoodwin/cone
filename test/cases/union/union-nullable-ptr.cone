// The nullable-pointer layout: a two-variant union of an empty variant and a
// variant holding a single reference needs no tag, because a null pointer can
// stand for the empty variant. This is the shape 'Option[&T]' has, and the
// compiler optimizes it -- a value of the union is the bare pointer.
//
// It is a scenario of its own because union-success cannot reach it. Every
// union there has a shared field or more than two variants, either of which
// turns the optimization off, so the optimized representation would otherwise
// go ungenerated. What is claimed here is that the two representations behave
// identically: the variant constructs, its field reads and writes, the union
// round-trips a variant, and every form of match recovers which variant it is.
//
// That the tag really is gone is asserted by a named check in cases.toml, since
// runtime cannot see whether one was emitted.
//
// 'Option[&i32]' is exercised on both sides, and the empty one has to name its
// type argument in full -- 'None[&i32][]' rather than 'None[]'. 'Some' infers
// its argument from the value it wraps; 'None' has no value, so its argument can
// only come from the expected type, and generic inference does not look there.
// That is a generic-inference gap and not this layout's; see
// [[Type Inference and Coercion]].

import stdio::*

fn show(label &[]u8, n i64) {
  printStr(label)
  printStr(" = ")
  printInt(n)
  printStr("\n")
}

fn showB(label &[]u8, b Bool) {
  show(label, if b {1} else {0})
}

union Maybe {
  struct Nothing {}

  struct Just {
    p &i32
  }
}

// -------- recovering the variant --------

// Matching through a reference to the union, binding the narrowed value
fn read(m &Maybe) i32 {
  match m {
    case imm j &Just {*j.p}
    case imm n &Nothing {-1i32}
  }
}

// 'case is' tests the variant without binding a name to it
fn present(m &Maybe) Bool {
  match m {
    case is &Just {true}
    else {false}
  }
}

// -------- the shape through the generic Option --------

fn readOption(o &Option[&i32]) i32 {
  match o {
    case imm s &Some[&i32] {*s.value}
    else {-1i32}
  }
}

fn main() i32 {
  imm v = 41
  imm w = 7

  // Both variants are ordinary values of the union
  mut some Maybe = Just[&v]
  mut none Maybe = Nothing[]

  show("match-reference-variant", read(&some))
  show("match-empty-variant", read(&none))
  showB("is-reference-variant", present(&some))
  showB("is-empty-variant", present(&none))

  // 'is' against the value rather than through a reference reaches the same
  // null test from the other side
  showB("value-is-reference-variant", some is Just)
  showB("value-is-empty-variant", none is Nothing)

  // On the variant type itself the field is reachable and writable, where the
  // optimization leaves it occupying the whole value
  mut j = Just[&v]
  show("field-read", *j.p)
  j.p = &w
  show("field-write", *j.p)

  // A variant assigned into the union and recovered from it again survives the
  // round trip, which is the whole of what the representation must guarantee
  mut back Maybe = j
  show("round-trip", read(&back))

  // Assigning the other variant over it empties the same storage
  back = Nothing[]
  show("reassigned-to-empty", read(&back))

  mut opt Option[&i32] = Some[&v]
  show("option-some", readOption(&opt))
  opt = None[&i32][]
  show("option-none", readOption(&opt))
  0i32
}
