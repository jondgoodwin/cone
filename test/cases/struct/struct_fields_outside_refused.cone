// What a field list may not do from outside the type's module. A private field is
// the module's, so it may not be named here, whether the value is taken apart or
// read through a reference; and a type with a finalizer may not be taken apart,
// which is no different outside than in (struct_fields_typecheck).

mod struct_fields_outside_refused;

import struct_fields_vault use *;

fn secret(v: Vault) {
  let s = v.(secret);                //~ ErrorNotPublic:14 "May not access the private method/field `secret`"
}

fn secretThroughReference(v: &Vault) {
  let id, s = v.(id, secret);        //~ ErrorNotPublic:22 "May not access the private method/field `secret`"
}

fn strongbox() {
  let id = openStrongbox().(id);     //~ ErrorFldListFinal:28 "Strongbox has a finalizer, so it cannot be taken apart"
}
