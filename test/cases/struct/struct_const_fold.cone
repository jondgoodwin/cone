// A type's const is the literal it folds to, wherever it is used: before any
// optimization each function below returns or multiplies by the value itself,
// and the module holds no global for a const to be read from. A static, which
// has storage, is a load of its global until the optimizer folds it; that is the
// difference between the two (struct_const_fold's checks, in cases.toml).

mod struct_const_fold;

struct Vec3 {
  x: f64;
  y: f64;
  z: f64;
  pub const up: Vec3 = Vec3(0., 0., 7.);
  pub const two: f64 = 1.0 + 1.0;
  pub const pair: (i32, i32) = (30, 12);
  pub static let held: f64 = 5.0;

  pub fn inside() f64 {
    two * 4.0
  }
}

enum Shade {
  Dark, Light;
  pub const count: u32 = 13;
}

fn upZ() f64 {
  Vec3.up.z
}

fn doubled(a: f64) f64 {
  a * Vec3.two
}

fn pairSum() i32 {
  Vec3.pair.0 + Vec3.pair.1
}

fn shades() u32 {
  Shade.count
}

fn heldValue() f64 {
  Vec3.held
}

fn main() i32 {
  0
}
