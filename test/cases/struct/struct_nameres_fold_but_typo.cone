// A fold's 'but' still refuses a name the folded type never declares, where
// the folded type is an instance whose 'where' leaves members out: a typo
// stays an error. 'dup' is declared (only where V is Copy), so it is
// tolerated at Token; 'dupp' is not declared at all.

mod struct_nameres_fold_but_typo;

struct Token {
  pub id: i32;
  fn final(self: &uni) {}
}

struct Cells[V] {
  pub val: V;
  pub fn get(self: &) &V {&val}
  pub fn dup(self: &) V where V is Copy {val}
}

struct TokHolder {
  pub inner: Cells[Token] use * but dupp;   //~ ErrorNoMbr:37 "has no member named dupp to leave out"
}
