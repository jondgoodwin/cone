// What a struct can declare besides fields: methods, static functions,
// overloaded methods, operator methods and a finalizer.
//
// Every method is called and what it computed is printed, because which
// declaration a call reached is invisible in the source. That matters most for
// an overload set, where the receiver's form -- a value, a '&' reference, a
// '&mut' reference -- is what separates one candidate from another, and for the
// operator methods, where the call site never names the method at all.
//
// A method that takes a reference receiver must be given one. The compiler does
// not borrow the receiver for the caller, so '(&mut c).bump()' is written out.
// The parentheses are the whole point: a borrow applies to the whole suffixed
// term, so '&c.bump()' borrows what the method returned, which is a temporary
// and rejected -- ref-typecheck-borrow pins it. The adjustment goes the other
// way only: a receiver held through a reference is dereferenced to reach a value
// receiver, which is a load and a copy.
//
// Fields, construction and copying are in struct-success. Function overload is
// core's; this file covers only what changes when the candidates are methods.

import stdio::*

fn show(label &[]u8, n i64) {
  printStr(label)
  printStr(" = ")
  printInt(n)
  printStr("\n")
}

// -------- receivers --------

struct Counter {
  n i32

  // A value receiver gets a copy, so it cannot change the caller's value
  fn peek(self) i32 {
    n
  }

  // A '&' receiver reads the caller's value in place
  fn read(self &) i32 {
    n
  }

  // A '&mut' receiver changes it
  fn bump(self &mut) {
    n = n + 1
  }

  // A field is reached by bare name inside a method, and 'self' names the
  // whole receiver where the field name alone will not do
  fn compare(self, other Counter) i32 {
    self.n - other.n
  }

  // A method may default a trailing parameter, exactly as a function may
  fn scaled(self, factor i32 = 3) i32 {
    n * factor
  }

  // 'Self' names the type being declared
  fn twin(self) Self {
    Self[n * 2]
  }
}

fn receivers() {
  mut c = Counter[10]
  show("value-receiver", c.peek())
  show("ref-receiver", (&c).read())
  (&mut c).bump()
  show("mut-ref-receiver", c.peek())
  show("self-and-other", c.compare(Counter[4]))
  show("default-parm-omitted", c.scaled())
  show("default-parm-given", c.scaled(10))
  show("Self-return", c.twin().n)

  // A value receiver really did get a copy
  mut d = Counter[1]
  imm ignored = d.peek()
  show("value-receiver-copies", d.n)

  // A value receiver is reachable through a reference too: the receiver is
  // dereferenced, so the method is handed a copy of what the reference points at
  mut e = Counter[20]
  show("value-receiver-through-ref", (&e).peek())
  show("value-receiver-through-mut-ref", (&mut e).peek())

  // The copy is taken when the call is made, so changing the original through
  // the same reference afterwards cannot reach what the call already returned
  imm twinned = (&mut e).twin()
  (&mut e).bump()
  show("deref-receiver-is-copy", twinned.n)
  show("deref-original-advanced", e.peek())
}

// -------- privacy --------

// A field or method whose name begins with '_' is reachable only from inside
// the type's own methods
struct Account {
  _balance i32 = 0
  owner i32

  fn _fee(self &) i32 {
    2
  }

  fn deposit(self &mut, amount i32) {
    _balance = _balance + amount - _fee()
  }

  fn balance(self) i32 {
    _balance
  }

  // Only a method may give a private field a value in a constructor
  fn opened(who i32, start i32) Account {
    Account[start, who]
  }
}

fn privacy() {
  mut a = Account::opened(5, 100)
  (&mut a).deposit(50)
  show("private-field-via-method", a.balance())
  show("public-field", a.owner)
}

// -------- static functions in a type --------

// A function declared inside a type without a 'self' parameter is a function,
// not a method: it is called through the type's name rather than on a value.
// Overload names work there the same way they do at module level.
struct Maker {
  seed i32

  fn fromInt overload make(n i32) Maker {
    Maker[n]
  }

  fn fromFloat overload make(n f32) Maker {
    Maker[i32[n] + 100]
  }
}

fn statics() {
  show("static-overload-int", Maker::make(3i32).seed)
  show("static-overload-float", Maker::make(4.5f).seed)
  show("static-concrete-name", Maker::fromInt(6i32).seed)
}

// -------- overloaded methods --------

// One overload name across three candidates that differ only in how they take
// the receiver and whether they take a second value
struct Pair {
  a i32
  b i32

  fn sumValue overload sum(self) i32 {
    a + b
  }

  fn sumRef overload sum(self &) i32 {
    a - b
  }

  fn sumOther overload sum(self, other Pair) i32 {
    self.a + other.a
  }

  // A method named on its own inside another method means 'self.method', the
  // same way a bare field name means 'self.field'. The two are rewritten by
  // different code in different places, so both are exercised: 'a' below is the
  // field form and 'sumValue()' is the method form.
  fn viaBareNames(self) i32 {
    a + sumValue()
  }
}

// Selection also has to work when the candidates differ by argument type, with
// one match exact and the other reached by widening
struct Scaler {
  base i32

  fn scaleWide overload scale(self, factor f64) f64 {
    f64[base] * factor
  }

  fn scaleCount overload scale(self, count i32, step i32 = 2) i32 {
    count * step + base
  }
}

fn overloads() {
  mut p = Pair[10, 3]
  show("overload-value-receiver", p.sum())
  show("overload-ref-receiver", (&p).sum())
  show("overload-extra-parm", p.sum(Pair[5, 0]))
  // A reference receiver is only dereferenced when no candidate accepts it as
  // it stands, so the '&' candidate above still wins and this one -- which no
  // candidate takes a reference for -- reaches the value candidate instead
  show("overload-deref-to-value-candidate", (&p).sum(Pair[5, 0]))
  // A candidate keeps its own name and may be called without any selection
  show("overload-concrete-name", p.sumValue())
  // A field and a method, each named on its own inside a method, both reach
  // 'self'. 10 + (10 + 3).
  show("bare-names-reach-self", p.viaBareNames())

  imm s = Scaler[7]
  // f32 widens to the f64 parameter, and no other candidate takes a float
  show("overload-widened-arg", i64[s.scale(2.5f)])
  // Only the i32 candidate takes an integer, and it supplies its own default
  show("overload-default-parm", s.scale(4i32))
  show("overload-default-given", s.scale(4i32, 3i32))
}

// -------- operator methods --------

// An operator is a method under a backquoted name, so it may be overloaded and
// called by its concrete name like any other
struct Vec {
  x i32
  y i32

  fn addVec overload `+`(self, other Vec) Vec {
    Vec[x + other.x, y + other.y]
  }

  fn addScalar overload `+`(self, amount i32) Vec {
    Vec[x + amount, y + amount]
  }

  fn `-`(self) Vec {
    Vec[-x, -y]
  }

  fn `+=`(self &mut, other Vec) Vec {
    x = x + other.x
    y = y + other.y
    *self
  }

  fn `==`(self, other Vec) Bool {
    x == other.x and y == other.y
  }

  fn `()`(self) i32 {
    x - y
  }

  fn `[]`(self, index usize) i32 {
    if index == 0usize {x} else {y}
  }

  // '<-' is the one operator whose right-hand side may be a value tuple, which
  // the compiler lowers into one application per element against a single
  // borrow of the receiver. Counting the applications is what tells that apart
  // from the tuple arriving as one argument.
  fn `<-`(self &mut, amount i32) {
    x = x + amount
    y = y + 1
  }
}

fn operators() {
  mut v = Vec[1, 2]
  imm w = Vec[10, 20]

  imm sum = v + w
  show("operator-add-struct", sum.x)
  imm bumped = v + 5
  show("operator-add-scalar", bumped.y)
  show("operator-concrete-name", v.addVec(w).y)

  imm negated = -w
  show("operator-negate", negated.x)

  v += w
  show("operator-plus-equals", v.x)

  if w == Vec[10, 20] {
    show("operator-equals", 1)
  }
  if not (w == v) {
    show("operator-not-equals", 1)
  }

  show("operator-call", v())
  show("operator-index-0", v[0usize])
  show("operator-index-1", v[1usize])

  // '<-' with one value on the right is an ordinary operator method call
  mut acc = Vec[0, 0]
  acc <- 3
  show("operator-append-one-x", acc.x)
  show("operator-append-one-count", acc.y)

  // ... and with a value tuple it applies once per element, in order, against
  // one borrow of the receiver rather than re-evaluating it each time. The
  // count is what proves the tuple was taken apart rather than passed whole,
  // and the sum is what proves the order and that every element arrived.
  mut many = Vec[0, 0]
  many <- (4, 5, 6)
  show("operator-append-tuple-x", many.x)
  show("operator-append-tuple-count", many.y)
}

// A type may give '&[]' its own meaning, in either of two forms: the indexed
// borrow '&mut v[i]', which takes an index and borrows one element, and the
// whole-value borrow '&[]mut v', which takes none and answers with a slice.
// They sit on two types because one type may not declare both under the
// punctuation name, and an overload name would take the punctuation out of the
// symbols the IR check below pins.
struct List {
  mut items [4; i32]

  fn `[]`(self, index usize) i32 {
    items[index]
  }

  fn `&[]`(self &mut, index usize) &mut i32 {
    &mut items[index]
  }
}

struct Buffer {
  mut cells [3; i32]

  fn `&[]`(self &mut) &[]mut i32 {
    &[]mut cells
  }
}

fn indexing() {
  mut list = List[items: [1, 5, 2, 8]]
  show("index-method", list[3usize])
  imm slot = &mut list[1usize]
  *slot = 50
  show("borrow-index-method", list[1usize])

  // The whole-value form dispatches to the method. The length is what says so:
  // the method's slice spans the array field, three elements long, where a
  // borrow deciding for itself would produce one element of the struct.
  mut buffer = Buffer[cells: [7, 8, 9]]
  imm all &[]mut i32 = &[]mut buffer
  show("whole-value-method-len", i64[all.len])
  show("whole-value-method-elem", all[0])

  // The slice aliases the field rather than copying it, so a write through it
  // is a write to the array
  all[2] = 77
  show("whole-value-method-aliases", buffer.cells[2])

  // Naming the method reaches the same slice, which is what says the operator
  // form selected the method rather than doing something of its own
  imm named &[]mut i32 = (&mut buffer).`&[]`()
  show("whole-value-explicit-call", named[2])

  // List declares '&[]' as well, but only with an index, so no candidate
  // accepts a receiver given none. The borrow keeps its own meaning there:
  // '&[]' over a value that is not an array is a one-element slice of that
  // value, and a declared method that does not fit does not change it.
  imm unfitted &[]mut List = &[]mut list
  show("no-accepting-candidate-stays-a-slice", i64[unfitted.len])
}

// -------- finalizers --------

// A finalizer runs when the value it belongs to is destroyed. Both are counted
// in a global, because nothing the finalizer does is visible any other way.
mut finalized = 0

struct Resource {
  id i32

  fn final(self &uni) {
    finalized = finalized + 1
  }
}

// A struct whose field has a finalizer gets one built for it, which runs the
// type's own finalizer first and then the field's
struct Bundle {
  held Resource
  label i32

  fn final(self &uni) {
    finalized = finalized + 100
  }
}

fn scoped() {
  mut r = Resource[1]
  return
}

fn nested() {
  mut b = Bundle[Resource[2], 3]
  return
}

fn finalizers() {
  finalized = 0
  scoped()
  show("finalizer-ran", finalized)

  finalized = 0
  nested()
  show("finalizer-and-field-ran", finalized)
}

fn main() i32 {
  receivers()
  privacy()
  statics()
  overloads()
  operators()
  indexing()
  finalizers()
  0i32
}
