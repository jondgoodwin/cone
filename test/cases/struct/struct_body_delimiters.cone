// Where a struct or trait body ends its declarations. In a body ';' delimits
// declarations, so the last needs none before the '}': a field, a static, a trait's
// requirement. A declaration that ends in its own block (a method with a body) needs
// none after it either, and a ';' written there, before the first declaration or twice
// in a row is an empty declaration, which is harmless. What a body may NOT do is
// leave out the ';' between two declarations that do not end in a block.
//
// Each printed value was checked by hand against the source.

mod struct_body_delimiters;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

// The last field needs no ';'
struct Point { pub x: i32; pub y: i32 }

// Nor does a static, and the method before it ends in its block
struct Counter {
  pub n: i32;
  pub fn twice(self: &) i32 {n * 2}
  static step: i32 = 5
}

// A ';' after a block-ended declaration, a doubled one and a leading one are empty
// declarations
struct Padded {
  ;
  pub a: i32;;
  pub fn sum(self: &) i32 {a + 1};
  pub b: i32;
  ;
}

// A trait's requirement is a declaration too, its last needs none
trait Named {
  pub fn label(self: &) i32;
  pub fn loud(self: &) i32 {label() * 100};
  pub fn size(self: &) i32
}

struct Crate is Named {
  pub w: i32;
  pub fn label(self: &) i32 {w}
  pub fn size(self: &) i32 {w * 2}
}

fn labelOf(n: &<Named) i32 {n.label()}
fn loudOf(n: &<Named) i32 {n.loud()}
fn sizeOf(n: &<Named) i32 {n.size()}

fn main() {
  let p = Point(3, 4);
  show("point", i64.from(p.x * 10 + p.y));        // 34

  let c = Counter(6);
  show("counter", i64.from(c.twice()));           // 12
  show("static", i64.from(Counter.step));         // 5

  let pad = Padded(7, 8);
  show("padded", i64.from(pad.sum() * 10 + pad.b));   // 88

  let k = Crate(9);
  show("label", i64.from(labelOf(&k)));           // 9
  show("loud", i64.from(loudOf(&k)));             // 900
  show("size", i64.from(sizeOf(&k)));             // 18
}
