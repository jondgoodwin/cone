// A method named like an imported module is a name in its type's namespace
// alone. Outside the type the module's name is the module's, and the method is
// reached through a value. Inside the type the member hides the module:
// struct_typecheck_member_module.
mod struct_member_module_outside;
import stdio use *;
import libc;

struct Clock {
  sec i64;
  fn libc(self &) i64 { sec * 2; }
}

fn stamp(c &Clock) libc.Timespec {
  new libc.Timespec(c.libc(), 7);
}

fn main() {
  imm c = new Clock(21);
  imm t = stamp(&c);
  printInt(t.tv_sec);
  printStr(" ");
  printInt(i64.from(t.tv_nsec));
  printStr("\n");
}
