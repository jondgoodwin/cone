// A field list, `x.(a, b)`, holds the names of fields, or for a tuple the numbers
// of its elements, separated by commas. Parse stage: anything else in it, an
// empty list, an expression, a call, a name followed by something, is one
// refusal at the first thing that is no name, and the list is skipped to its
// closing parenthesis so that nothing after it is reported twice.

mod struct_fields_parse;

struct Pt { pub x: i32; pub y: i32; }

fn empty(p: Pt) {
  let a = p.();                //~ ErrorFldListForm:14 "names none"
}

fn expression(p: Pt) {
  let a = p.(x + 1);           //~ ErrorFldListForm:16 "Name a field"
}

fn call(p: Pt) {
  let a = p.(x, y(1));         //~ ErrorFldListForm:18 "Name a field"
  let b = p.(x);
}

fn leading(p: Pt) {
  let a = p.(1 + x);           //~ ErrorFldListForm:16 "Name a field"
}

fn notName(p: Pt) {
  let a = p.("x", y);          //~ ErrorFldListForm:14 "Name a field"
}
