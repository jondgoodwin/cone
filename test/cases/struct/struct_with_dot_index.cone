// '.[i]' inside a 'with' block: the element of the subject, as 'this[i]'.
//
// '.[4] = 1.6;' is 'numbers[4] = 1.6;' in 'with &mut numbers'. It reads and
// writes, takes an expression for its index, and chains with '.name' and '.[j]'
// on what it reaches. The subject is a list, an array and a list of structs.
//
// Checked by hand:
//   list [10, 20, 30, 40, 50]: '.[1] = .[0] + .[4]' makes it 60; '.[k] = 7' with
//   k = 1 makes it 7; so the sum 10 + 7 + 30 + 40 + 50 = 137.
//   array [1, 2, 3]: '.[2] = .[0] + .[1]' makes it 3; '.[0] = .[2] * 5' makes it 15.
//   points [Pt(1,2), Pt(3,4)]: '.[1].y = .[0].x + .[1].x' is 1 + 3 = 4, '.[0].x = 9'.
//   Printed: 137, 15 2 3, 9 2 3 4, in that order.

mod struct_with_dot_index;

import stdio use *;
import collections use *;

struct Pt {
  x: i32;
  y: i32;
}

fn main() i32 {
  let k = 1usize;
  var nums = List[i32]();
  nums <- 10, 20, 30, 40, 50;
  with &mut nums {
    .[1] = .[0] + .[4];
    .[k] = 7;
  }
  printInt(nums[0] + nums[1] + nums[2] + nums[3] + nums[4]);
  printStr("\n");

  var arr = [1, 2, 3];
  with &mut arr {
    .[2] = .[0] + .[1];
    .[0] = .[2] * 5;
  }
  printInt(arr[0]);
  printStr(" ");
  printInt(arr[1]);
  printStr(" ");
  printInt(arr[2]);
  printStr("\n");

  var pts = List[Pt]();
  pts <- Pt(1, 2), Pt(3, 4);
  with &mut pts {
    .[1].y = .[0].x + .[1].x;
    .[0].x = 9;
  }
  printInt(pts[0].x);
  printStr(" ");
  printInt(pts[0].y);
  printStr(" ");
  printInt(pts[1].x);
  printStr(" ");
  printInt(pts[1].y);
  printStr("\n");
  0
}
