// What the borrowed-operand lookup does not reach (struct_operand_borrow).
//
// Only the comparison operators borrow their operands. An arithmetic operator's
// right operand is a value, so a '+' declared against '&Self' is not found by
// 'a + b', and a comparison written for values is not found by a borrowed
// operand of a different type.

mod struct_operand_borrow_refused;

struct V {
  n: i32;
  pub fn `+`(self: &, o: &V) i32 { n + o.n }
}

fn arithmeticTakesValues() {
  let a = V(1);
  let b = V(2);
  let c = a + b;       //~ ErrorNoCandidate:13 "No method declared by `+` accepts the call's arguments"
  return;
}

struct W {
  n: i32;
  pub fn `==`(self: &, o: &W) bool { n == o.n }
}

fn otherTypeIsNotBorrowed() {
  let a = W(1);
  let b = V(2);
  let c = a == b;      //~ ErrorNoCandidate:13 "No method declared by `==` accepts the call's arguments"
  return;
}
