// A program naming the consts of a type in another package, compiled against
// that package's include file, include\constlib.cone, which the runner requires
// to be what constlib's compile generated ('include' in cases.toml); the
// printing comes through a file standing for stdio's include file.

build: release
output: executable

prog: {
    "main.cone"
    import constlib: "include/constlib.cone"
    import stdio: "stdio.cone"
}
