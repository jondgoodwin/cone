// Package constlib, compiled on its own: a type with consts, public and
// private, that a program in another package names through the type. A const
// has no symbol in the object, so what reaches the program is the include file's
// copy of its declaration.

mod constlib;

pub struct Pt {
  pub x: i32;
  pub y: i32;
  pub const origin: Pt = Pt(0, 0);
  pub const unit: i32 = 10;
  pub const span: i32 = unit * 4;
  const hidden: i32 = 7;

  pub fn shifted(self) i32 {
    x + hidden
  }
}

pub enum Mode {
  Fast, Slow;
  pub const dflt: Mode = Slow;
  pub const ticks: u32 = 3;
}

pub fn modeCode(m: Mode) i32 {
  match m {
    case is Fast {1}
    case is Slow {2}
  }
}
