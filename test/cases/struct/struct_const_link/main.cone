// The program: a pub const of a type of another package, named through the
// type, of a struct, a number, a struct of the type itself, and an enum's
// variant and number. It is the same literal in this object as it is in the
// package's.

mod prog;

import stdio use *;
import constlib use *;

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  show("unit", i64.from(Pt.unit));
  // unit * 4
  show("span", i64.from(Pt.span));
  show("origin.y", i64.from(Pt.origin.y));
  // x (3) + hidden (7), the package's own method
  show("shifted", i64.from(Pt(3, 4).shifted()));
  show("ticks", i64.from(Mode.ticks));
  show("dflt code", i64.from(modeCode(Mode.dflt)));
  0
}
