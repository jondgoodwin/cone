// What a struct or trait body's delimiting ';' still requires.
//
// Parse stage only. ';' delimits a body's declarations, the last needing none
// (struct_body_delimiters), so what remains refused is a missing delimiter BETWEEN
// two declarations that do not end in a block, and a comma where the ';' goes. Each
// diagnostic is placed after the token the missing ';' follows, which is where the
// fix goes.

mod struct_parse_delimiters;

// Two fields with nothing between them
struct TwoFields {
  x: i32  //~ ErrorNoSemi
  y: i32
}

// A field before a method
struct FieldThenMethod {
  x: i32  //~ ErrorNoSemi
  fn get(self: &) i32 {x}
}

// A static before a field
struct StaticThenField {
  static step: i32 = 1  //~ ErrorNoSemi
  x: i32
}

// A trait's requirement before another
trait TwoRequirements {
  fn a(self: &) i32  //~ ErrorNoSemi
  fn b(self: &) i32
}

// A comma is not the delimiter of a struct's fields (it is a variant list's): the
// first diagnostic is the missing ';', and the comma left behind is read as a
// declaration of its own
struct CommaFields {
  x: i32, y: i32  //~ ErrorNoSemi
                  //~^ ErrorNoSemi follow-on
}
