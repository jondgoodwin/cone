// Package lendee, compiled on its own: functions taking a struct of more than
// 16 bytes, each passed a pointer its caller lends or copies, which an
// optimizer compiling the caller cannot see into. Each that writes what its
// argument came from reads its parameter after.

mod lendee;

pub struct Big {
  pub a i64;
  pub b i64;
  pub c i64;
}

pub fn digits(v Big) i64 {
  v.a + v.b * 10 + v.c * 100;
}

pub fn viaMut(v Big, q &mut Big) i64 {
  q.a = 9;
  q.b = 9;
  q.c = 9;
  digits(v);
}

pub mut glob Big = new Big(1, 2, 3);

pub fn writesGlobal(v Big) i64 {
  glob.a = 7;
  glob.b = 7;
  glob.c = 7;
  digits(v);
}

pub fn writeThenRead(v Big, s &[]mut Big) i64 {
  s[1usize] = new Big(7, 8, 9);
  digits(v);
}

pub fn bump(mut v Big) i64 {
  v.a = v.a + 100;
  digits(v);
}

pub fn depth(v Big, n i64) i64 {
  if n == 0 {
    digits(v);
  }
  else {
    depth(v, n - 1) + v.a;
  }
}

pub fn same(v Big) Big {
  v;
}

pub fn take(v Big, n i64) i64 {
  digits(v) * 1000 + n;
}
