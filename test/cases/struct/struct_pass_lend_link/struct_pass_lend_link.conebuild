// A program passing structs of more than 16 bytes to a package compiled on
// its own, linked with it: each call a real one, optimised, whose callee the
// caller's optimizer cannot see into. Compiled against lendee's include file,
// include\lendee.cone, which the runner requires to be what lendee's compile
// generated ('include' in cases.toml); the printing comes through a file
// standing for stdio's include file.

build: release
output: executable

prog: {
    "main.cone"
    import lendee: "include/lendee.cone"
    import stdio: "stdio.cone"
}
