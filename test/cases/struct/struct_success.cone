// A struct as data: declaring fields, building values, reading and changing
// them, and what happens when a struct value is copied around.
//
// Everything a struct value holds is printed, because a constructor that
// compiles is not a constructor that put the values in the right fields --
// positional and named forms have to agree, and a defaulted field has to come
// out with its default rather than whatever was next in the list.
//
// Methods, operator methods and finalizers are in struct_methods; opaque types
// cannot be instantiated and so are in struct_opaque. This file declares no
// method at all, so a failure here is about field layout and nothing else.

mod struct_success;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showF(label &str, n f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

// -------- declaration --------

// A field states its type; a trailing field may also state a default value
struct Point {
  pub x i32;
  pub y i32;
  pub z i32 = 7;
}

// A field may declare its own permission ahead of its name
struct Holder {
  pub mut count i32;
}

// A struct with no fields at all is legal and its values may be passed around
struct Empty {
}

// A field takes a value on the terms a variable initializer does: a string
// literal is borrowed as the slice, and an untyped number literal adopts the
// field's type
struct Label {
  pub name &str;
  pub big i64 = 0i64;
  pub ratio f64 = 0.0;
}

// A field's type may be another struct, so struct values nest
struct Segment {
  pub head Point;
  pub tail Point;
}

// A global's initializer may be a struct literal whose fields are struct
// literals: generation builds the whole value as one constant, level by level,
// and a nested literal's defaulted field is filled in there as in a function
imm route = new Segment(new Point(21, 22, 23), new Point(24, 25));

// -------- construction --------

fn construction() {
  // Positional: values are matched to fields in declaration order
  imm a = new Point(1, 2, 3);
  show("positional-x", a.x);
  show("positional-y", a.y);
  show("positional-z", a.z);

  // Named: order is free, and the compiler puts each value in its own field
  imm b = new Point(y: 20, x: 10, z: 30);
  show("named-x", b.x);
  show("named-y", b.y);
  show("named-z", b.z);

  // A field with a default may be left out of either form
  imm c = new Point(4, 5);
  show("default-omitted", c.z);
  imm d = new Point(x: 6, y: 7);
  show("default-omitted-named", d.z);

  // A field's declared permission is part of the field, not of the constructor
  mut h = new Holder(count: 3);
  show("perm-field", h.count);

  // A value is coerced to its field's type in either form; named, it is the
  // value that is coerced, not the name wrapped around it
  imm lp = new Label("by-position", 5000000000, 0.5);
  printStr(lp.name);
  printStr("\n");
  show("literal-by-position-i64", lp.big);
  showF("literal-by-position-f64", lp.ratio);
  imm ln = new Label(ratio: 0.5, big: 5000000000, name: "by-name");
  printStr(ln.name);
  printStr("\n");
  show("literal-by-name-i64", ln.big);
  showF("literal-by-name-f64", ln.ratio);

  // A zero-size value still constructs and still copies
  imm e = new Empty();
  imm e2 = e;

  // A struct-typed field is built with its own constructor
  imm s = new Segment(new Point(1, 2, 3), new Point(4, 5, 6));
  show("nested-head-x", s.head.x);
  show("nested-tail-z", s.tail.z);

  // The same nesting as a global, built once rather than on each call
  show("global-nested-head-y", route.head.y);
  show("global-nested-tail-x", route.tail.x);
  show("global-nested-tail-default", route.tail.z);
}

// -------- field access --------

fn access() {
  mut p = new Point(1, 2, 3);

  // A field is read and written through '.'
  p.x = 40;
  p.y = p.x + 2;
  show("assigned-field", p.x);
  show("field-from-field", p.y);

  // A nested field is reached one '.' at a time
  mut s = new Segment(new Point(1, 2, 3), new Point(4, 5, 6));
  s.tail.y = s.head.y + 100;
  show("nested-assign", s.tail.y);

  // A reference to a struct reaches the fields without being dereferenced
  imm rp = &mut p;
  rp.x = 60;
  show("field-through-ref", p.x);

  // A field may be borrowed on its own. The '&' binds to the name before the
  // '.', so the parentheses are what make this a reference to the field
  // rather than a field of a reference.
  imm r = &(p.z);
  show("field-borrow", *r);

  // A struct may be declared without a value and assigned one later. It is the
  // whole value that flow analysis tracks: filling the fields in one at a time
  // instead leaves the variable uninitialized as far as it is concerned.
  mut late Point;
  late = new Point(11, 12, 13);
  show("late-init", late.x + late.y + late.z);

  // 'with' makes a value the subject of the block, so '.name' reaches its
  // fields without repeating the value's name
  mut w = new Point(0, 0, 0);
  with &mut w {
    .x = 3;
    .y = .x * 2;
    .z = .x + .y;
  }
  show("with-x", w.x);
  show("with-y", w.y);
  show("with-z", w.z);
}

// -------- copying --------

// A struct parameter receives a copy, so changing it cannot reach the caller
fn shift(mut p Point) Point {
  p.x = p.x + 1000;
  p;
}

fn copying() {
  mut original = new Point(1, 2, 3);

  // Assignment copies every field
  mut duplicate = original;
  duplicate.x = 99;
  show("copy-source-unchanged", original.x);
  show("copy-target-changed", duplicate.x);

  // So does passing to and returning from a function
  imm shifted = shift(original);
  show("arg-source-unchanged", original.x);
  show("returned-copy", shifted.x);

  // A whole struct value may be assigned over another one
  original = new Point(7, 8, 9);
  show("whole-assign-x", original.x);
  show("whole-assign-z", original.z);
}

// -------- fields of other types --------

// A field's type may be any type, and f32 fields prove the compiler is not
// quietly treating every field as a machine word
struct Circle {
  pub radius f32;
  pub filled bool;
}

fn othertypes() {
  imm c = new Circle(2.5, true);
  showF("float-field", f64.from(c.radius));
  if c.filled {
    show("bool-field", 1);
  }
}

// -------- interaction with control flow --------

// A struct value is an ordinary value, so it flows through branches and loops
fn pick(n i32) Point {
  if n > 0 {
    return new Point(1, 1, 1);
  }
  new Point(2, 2, 2);
}

fn controlflow() {
  show("returned-from-branch", pick(1).x);
  show("returned-from-fallthrough", pick(0).x);

  // A struct chosen by an 'if' expression
  imm chosen = if pick(1).x == 1 {new Point(5, 6, 7);} else {new Point(0, 0, 0);};
  show("if-expression-struct", chosen.y);

  // A struct accumulated across loop iterations
  mut acc = new Point(0, 0, 0);
  mut i = 1;
  while i <= 4 {
    acc.x = acc.x + i;
    acc.y = acc.y + acc.x;
    i++;
  }
  show("loop-accumulated-x", acc.x);
  show("loop-accumulated-y", acc.y);
}

// -------- structs that reach themselves --------

// A struct may hold itself, or another struct that holds it, through a
// reference. All three forms were refused until analysis learned to answer a
// type still being laid out rather than refuse it, so Cone could not express a
// linked list or a tree at all.
//
// What separates them from the infinite forms is not recursion but size, and it
// belongs to the type being asked. A reference answers its own size -- a pointer
// is a pointer whatever it points at -- so a cycle through one always
// terminates. struct_typecheck_nosize holds the by-value forms that are still
// refused.
//
// Declared and reached by reference rather than built and traversed: a list
// needs a nullable reference, and the enum machinery for that belongs to the
// enum group. The named check in cases.toml is what asserts these reach code
// generation as genuinely self-referential types, which runtime cannot see.

// The list node the whole rule exists for. 'next' is a reference, so laying out
// Node never asks Node for its size.
struct Node {
  pub v i64;
  pub next &Node;
}

fn nodeNext(n &Node) i64 {
  n.next.v;
}

// One by value, one by reference: Owner holds Held by value, so Held must be
// sized -- and it is, because its own field is a reference. The cycle breaks on
// the second hop rather than the first.
// Owner holds Held by value, so Held must be sized -- and it is, because its
// own field is a reference. The cycle is broken on the second hop rather than
// the first, which is the case that says the rule is about each field's own
// type and not about whether a cycle exists anywhere.
struct Owner {
  pub v i64;
  pub held Held;
}

struct Held {
  pub back &Owner;
}

fn ownerBack(o &Owner) i64 {
  o.held.back.v;
}

// Neither asks the other.
struct Left {
  pub v i64;
  pub r &Right;
}

struct Right {
  pub l &Left;
}

fn leftRound(l &Left) i64 {
  l.r.l.v;
}

// -------- statics in a type --------

// A static in a type is one copy shared by every value of the type. It is not
// a field: no value carries it, and it is reached as Type.name from outside
// and by its bare name from the type's own functions and methods.
struct Tally {
  pub n i32;
  pub static mut made = 0;

  pub fn make(n i32) Tally {
    made = made + 1;
    new Tally(n);
  }

  pub fn madeSoFar(self) i32 {
    made;
  }
}

fn typeStatics() {
  imm a = Tally.make(1);
  imm b = Tally.make(2);
  show("type-static-shared-by-two-values", a.madeSoFar() + b.madeSoFar());
  show("type-static-through-the-type", Tally.made);
  Tally.made = 10;
  show("type-static-assigned-through-the-type", b.madeSoFar());
}

// -------- defaults that are aggregates --------

// A default is a constant, and a constant may be an aggregate written in
// place: a construction of constants, by position or by name and nested, an
// array by its elements or by a fill, a tuple. Each is the same value it would
// be as a named constant, which may stand in for it.
const Corner = new Point(70, 71, 72);

struct Defaults {
  pub at Point = new Point(1, 2, 3);
  pub named Point = new Point(y: 5, x: 4);
  pub span Segment = new Segment(new Point(6, 7, 8), new Point(9, 10));
  pub bytes Array[u8, 4] = [11u8, 12u8, 13u8, 14u8];
  pub filled Array[u8, 4] = new Array[u8, 4] <- fill 15u8;
  pub pair (i32, i32) = (16, 17);
  pub corner Point = Corner;
  pub inferred = new Point(18, 19);
}

// A generic struct's defaults are its own in every instance
struct Tagged[T] {
  pub v T;
  pub at Point = new Point(20, 21, 22);
}

fn aggregateDefaults() {
  imm d = new Defaults();
  show("default-construction", d.at.x + d.at.y + d.at.z);
  show("default-construction-named", d.named.x * 10 + d.named.y);
  show("default-construction-named-takes-default", d.named.z);
  show("default-nested", d.span.head.z + d.span.tail.x);
  show("default-nested-takes-default", d.span.tail.z);
  show("default-array", i32.from(d.bytes[0]) + i32.from(d.bytes[3]));
  show("default-array-fill", i32.from(d.filled[2]));
  show("default-tuple", d.pair.0 * 100 + d.pair.1);
  show("default-named-const", d.corner.y);
  show("default-inferred-type", d.inferred.x + d.inferred.z);

  // A value given replaces the default, by name or by position, and the
  // fields not given still take theirs
  imm e = new Defaults(at: new Point(30, 31, 32));
  show("default-replaced-by-name", e.at.x);
  show("default-kept-beside-it", e.named.x);
  imm f = new Defaults(new Point(33, 34, 35), new Point(36, 37, 38));
  show("default-replaced-by-position", f.named.z);
  show("default-kept-after-them", i32.from(f.filled[0]));

  // Each value gets its own copy of the default
  mut g = new Defaults();
  g.at.x = 40;
  g.bytes[1] = 41u8;
  imm h = new Defaults();
  show("default-changed-in-one", g.at.x + i32.from(g.bytes[1]));
  show("default-unchanged-in-another", h.at.x + i32.from(h.bytes[1]));

  imm ti = new Tagged[i32](v: 1);
  imm tf = new Tagged[f32](v: 2.);
  show("default-generic", ti.at.x + tf.at.z);
}

fn main() i32 {
  construction();
  access();
  copying();
  othertypes();
  controlflow();
  typeStatics();
  aggregateDefaults();
  0i32;
}
