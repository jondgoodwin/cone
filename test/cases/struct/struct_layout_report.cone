// '--layout' prints what the target lays out for each struct and enum: size,
// alignment, each field's offset and the bytes of padding, and marks a struct
// padded by a quarter of its size or more PADDED. 'Padded' puts a u8 either side
// of a u64 (two 7-byte gaps), 'Tight' holds the same fields with the wide one
// first (one 6-byte tail). Both are checked on a 64-bit target.

mod struct_layout_report;

struct Padded {
  a: u8;
  b: u64;
  c: u8;
}

struct Tight {
  b: u64;
  a: u8;
  c: u8;
}

struct Small {
  x: u32;
  y: u32;
}

fn main() i32 {
  let p = Padded(1, 2, 3);
  let t = Tight(2, 1, 3);
  let s = Small(4, 5);
  _ = p; _ = t; _ = s;
  0
}
