// Enriching a type that lives in another module, which is what 'extends' is for.
//
// Everything struct_extends establishes holds with the two types in one file.
// What this adds is the boundary: the base is imported, its declaration is
// resolved on demand from the other module's scope, and the enrichment is still
// inside its encapsulation boundary -- it reads a private field and calls a
// private method of a type it does not own. That is the coupling the design takes
// knowingly: a type that may be extended has its representation in its contract,
// and SemVer is what protects the base's author.
//
// A compile rather than a run, because a program spanning modules cannot be
// linked yet (compiler/c/doc/nodes/module.md). What a run would add is covered by
// struct_extends, whose pair sits in one file.

mod struct_extends_import;

import structmeter use *;

struct Gauge extends Meter {
  pub fn doubled(self) i32 {
    cm + cm;
  }
  pub fn peek(self) i32 {
    scale;
  }
  pub fn viaPrivateMethod(self) i32 {
    hidden();
  }
}

fn acrossTheBoundary() i32 {
  // A value from the base's own static, bound to the enriched name
  imm g Gauge = Meter.make();
  g.doubled() + g.peek() + g.viaPrivateMethod() + g.scaled();
}

fn substitutesAcrossTheBoundary(m Meter) i32 {
  imm g Gauge = m;
  g.doubled();
}

// The base's finalizer is private and calls a private method; the enrichment's
// copy of it is generated here, as this type's own
struct LoggedHandle extends Handle {
  pub fn twice(self &) i32 {
    fd + fd;
  }
}

fn finalizesAcrossTheBoundary() {
  imm h LoggedHandle = Handle[3];
}
