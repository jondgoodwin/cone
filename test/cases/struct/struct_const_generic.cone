// A generic struct or enum may hold a 'const': each instance has its own copy,
// folded like any type const, and its type may name the type parameter.
//
// Vec3[T].zero is a Vec3[T] whose three fields are the instance's zero. Each
// value printed is worked out in the comments.

mod struct_const_generic;

import stdio use *;

struct Vec3[T] {
  pub x: T;
  pub y: T;
  pub z: T;
  pub const dim: i32 = 3;
  pub const zero: Vec3[T] = Vec3[T](T.from(0), T.from(0), T.from(0));
  pub const unit: Vec3[T] = Vec3[T](T.from(1), T.from(0), T.from(0));

  pub fn dimPlus(n: i32) i32 {
    dim + n
  }
  pub fn sumUnit() T {
    unit.x + unit.y + unit.z
  }
}

enum Pick[T] {
  Low, High;
  pub const dflt: Pick[T] = High;
  pub const size: u32 = 2;
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() i32 {
  // The same const name in two instances, each its own
  show("i32 zero.x", i64.from(Vec3[i32].zero.x));
  show("i32 unit.x", i64.from(Vec3[i32].unit.x));
  printStr("f64 unit.x = "); printFloat(Vec3[f64].unit.x); printStr("\n");
  printStr("f64 zero.z = "); printFloat(Vec3[f64].zero.z); printStr("\n");
  // 3, and 3 + 4
  show("dim", i64.from(Vec3[i32].dim));
  show("dimPlus", i64.from(Vec3[f32].dimPlus(4)));
  // 1 + 0 + 0
  show("sumUnit", i64.from(Vec3[i64].sumUnit()));
  show("Pick size", i64.from(Pick[u8].size));
  let k: i64 = match Pick[u8].dflt {
    case is High {2}
    case is Low {1}
  };
  show("Pick dflt", k);
  0
}
