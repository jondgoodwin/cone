// 'Self' as a qualifier, which resolves to nothing.
//
// Name-resolution stage only: this file parses cleanly, and name resolution
// returns before type checking, so a type-check expectation here would never
// run.
//
// 'Self' names the type being declared, and struct-methods uses it as a type
// and in a literal. As a qualifier it fails: a qualified path is walked from
// the module's namespace and never consults the hook table
// (design/phases/name-resolution.md, section 2), and 'Self' is bound in the
// type's namespace, not the module's. The type's own name works from the same
// position -- struct-methods pins 'Pair::sumValue(p)' -- so this is the one
// spelling of the type a qualifier cannot use. Pinned as it is today, so that
// a lookup which consulted the enclosing type would change it visibly.

struct Pair {
  a i32

  fn make(n i32) Pair {
    Pair[n]
  }

  fn viaSelf(self) Pair {
    Self::make(a)          //~ ErrorUnkName:5 "Namespace Self does not exist"
  }
}
