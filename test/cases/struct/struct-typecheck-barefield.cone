// A field named on its own, where there is no receiver to reach it through.
//
// Inside a method, a bare field name means 'self.field', and the compiler
// rewrites it to that. The rewrite needs a self to build, so it needs to be
// inside a method -- and the two places a field name resolves without one are
// here.
//
// Type-check stage, and that is itself new: the rewrite used to happen during
// name resolution, which had no types to work from, so both of these failed
// before type checking began and the first reported that the name 'self' -- a
// name the author never wrote -- did not exist.

struct Point {
  x i32

  // A static function has no receiver, so a field name in one has nothing to
  // qualify it. The rewrite is refused rather than attempted against whatever
  // the enclosing function's first parameter happens to be.
  fn origin() i32 {
    x   //~ ErrorUnkName:5 "there is no self here to reach it through"
  }
}

// A field's default value is analyzed with no function around it at all. Two
// rules refuse this and the literal one is reached first, which is the better
// diagnostic of the two: it names the rule the author broke rather than the
// receiver the compiler could not build.
struct Pair {
  a i32
  b i32 = a   //~ ErrorNotLit:11 "Field default must be a literal value"
}
