// An opaque struct: a type whose size and layout the program does not know.
//
// This is a 'compile' scenario rather than a 'run' one because there is no way
// to make an opaque value. Nothing declares its fields, so no constructor can
// build one and no variable may hold one -- which is the point of the type. Its
// values come from somewhere outside the program, and only a reference to one
// can be passed around here. So there is nothing to print and nothing to check
// at runtime; that the declarations type-check and generate is the whole claim.
//
// A struct with an empty body is a different thing: it is a zero-size type, its
// values do construct, and struct-success covers it.

// An opaque type declares no fields, but may declare methods
struct @opaque Handle {
  fn tag(self &) i32 {
    3
  }
}

// A method on an opaque type is reached through a reference to a value the
// program never created
fn label(h &Handle) i32 {
  h.tag()
}

// An opaque type may appear wherever only a reference to it is needed
fn compare(a &Handle, b &Handle) i32 {
  label(a) - label(b)
}
