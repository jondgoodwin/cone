// A type's const is private to its module unless it is 'pub', as a function or
// a static of the type is: named through the type from another module, a pub
// one is read and a private one is refused. Name resolution stage, where a path
// through a type is bound.

mod struct_const_private;

import structconstmod use *;

fn full() i32 {
  Gauge.full
}

fn reserve() i32 {
  Gauge.reserve     //~ ErrorNotPublic:9 "reserve is private to its module"
}
