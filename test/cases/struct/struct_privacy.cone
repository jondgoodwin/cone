// A member not marked 'pub' is private to its type, not to one value of it
// (refstruct.html): the type's own methods and static functions reach it
// through any value of the type, as they do through 'self'. A local, a
// parameter, a borrow written out, a by-value call, a field read and a field
// written are each done, since a method's receiver and a field's are reached
// the same way but lowered apart.
//
// A generic type's instance owns its methods, so it reaches the private
// members of another value of the same instance. Another instance, another
// type's code and a function of the module stay outside:
// struct_typecheck_methods holds those refusals.
//
// Every value is printed and worked out beside its line, so a member read from
// the wrong value shows as a wrong number.

mod struct_privacy;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Counter {
  n i32;
  fn bump(self &mut) { n = n + 1; }
  fn get(self) i32 { n; }

  // A static function: a private method called on a local, borrowed for it and
  // borrowed written out
  pub fn make() Counter {
    mut c = Counter[10];
    c.bump();
    (&mut c).bump();
    c;
  }

  // A private method taking 'self' by value, called on a local
  pub fn peek() i32 {
    imm c = Counter[7];
    c.get();
  }

  // A private field written through a parameter, in a static function
  pub fn reset(o &mut Counter, to i32) {
    o.n = to;
  }

  // A method: a private method called on a parameter, and a private field of
  // that parameter read
  pub fn absorb(self &mut, o &mut Counter) {
    o.bump();
    n = n + o.n;
  }

  pub fn total(self &) i32 { n; }
}

// A method reaching another value's private field
struct Meter {
  scale i32;
  pub fn make(s i32) Meter { Meter[s]; }
  pub fn same(self &, other &Meter) i32 {
    scale * 100 + other.scale;
  }
}

// A generic type's instance, reaching another value of itself
struct Cell[T] {
  v T;
  fn peek(self &) T { v; }
  pub fn make(v T) Cell[T] { Cell[T][v]; }
  pub fn plus(self &, o &Cell[T]) T { v + o.v + o.peek(); }
}

fn main() {
  mut a = Counter.make();
  show("private-method-on-a-local", a.total());    // 10, bumped twice: 12
  show("by-value-private-method", Counter.peek());  // 7

  mut b = Counter.make();                           // 12
  Counter.reset(&mut b, 3);
  show("private-field-written", b.total());         // 3
  a.absorb(&mut b);                                 // b 4, a 12 + 4
  show("private-method-on-a-parameter", b.total()); // 4
  show("private-field-of-a-parameter", a.total());  // 16

  imm m = Meter.make(2);
  imm o = Meter.make(5);
  show("another-value-s-private-field", m.same(&o)); // 205

  imm c = Cell[i32].make(3);
  imm d = Cell[i32].make(4);
  show("same-instance-s-private", c.plus(&d));      // 3 + 4 + 4 = 11
}
