// '.[' is the short form of 'this[' and nothing else: after a value's name a '.'
// still wants a field or method name, so 'xs.[1]' is refused at parse.

mod struct_parse_dot_index;

fn dotAfterAName(xs: &[i32]) i32 {
  return xs.[1];
  //~^ ErrorNoMbr:13 "This should be a named field/method"
  //~^^ ErrorNoSemi:14 follow-on
  //~^^^ ErrorNoSemi:15 follow-on
  //~^^^^ ErrorBadTerm:15 follow-on
}
