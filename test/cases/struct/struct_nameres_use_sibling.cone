// What a type body's 'use' may name, and what it may admit of it.
//
// Name resolution stage: a sibling fold is expanded into the type's dictionary
// while the type is resolved, right after the base's members are taken, so
// everything here is reported there. A name-resolution diagnostic stops the
// compile before type checking, so nothing here reaches it.
//
// Where the clause may be written at all, and its grammar, are a stage earlier in
// struct_parse_fold. What a FIELD's clause may admit is struct_nameres_fold: the
// two are separate because a field fold reaches a part it must find a receiver
// for, and a sibling fold reaches a type whose receiver is already right.

mod struct_nameres_use_sibling;

struct Meter {
  pub mut cm i32;
  scale i32;
  pub fn scaled(self) i32 {
    cm * scale;
  }
}

struct Trig extends Meter {
  pub fn sine(self) i32 {
    cm;
  }
  fn secret(self) i32 {
    cm;
  }
}

struct LogExp extends Meter {
  pub fn sine(self) i32 {
    cm + 1;
  }
}

struct Ender extends Meter {
  pub fn logOf(self) i32 {
    cm;
  }
  fn final(self &uni) {
  }
}

trait Shape {
  pub fn area(self &) i32;
}

enum Event {
  tag i32;
  pub struct Click { pub x i32; }
}

struct Other {
  pub k i32;
}

struct OtherKid extends Other {
  pub fn twice(self) i32 {
    k * 2;
  }
}

// A sibling is a type that declared the same base, so a type with no base has
// nothing to share and nothing a sibling's receiver could be
struct NoBase {
  use Trig;                      //~ ErrorUseSibling "has no base to share"
}

// A type whose base is a different one: its methods read fields this type does
// not have, which is exactly what the shared base rules out
struct WrongBase extends Meter {
  use OtherKid;                  //~ ErrorUseSibling "does not share"
}

// The base itself is reached by 'extends' already, so folding it would collide
// on every name rather than add one
struct FoldsItsBase extends Meter {
  use Meter;                     //~ ErrorUseSibling "through the 'extends' that starts from it"
}

// And so is every type further down the chain
struct Mid extends Meter {
  pub fn middle(self) i32 {
    cm;
  }
}

struct FoldsAnAncestor extends Mid {
  use Meter;                     //~ ErrorUseSibling "through the 'extends' that starts from it"
}

// An abstraction holds no value, so it has no members a fold could reach through
// one; what a concrete type asserts about an abstraction is conformance
struct OnTrait extends Meter {
  use Shape;                     //~ ErrorUseSibling "write 'is'"
}

// An enum's variant set is its identity rather than a member set to fold
struct OnEnum extends Meter {
  use Event;                     //~ ErrorUseSibling "its variant set is its identity"
}

struct FoldsItself extends Meter {
  use FoldsItself;               //~ ErrorUseSibling "cannot fold itself in"
}

// A name the sibling has not got, named in the list and left out with 'but'. A
// private name is as absent as a missing one, since the fold never admits it
struct NoSuchName extends Meter {
  use Trig cosine;               //~ ErrorNoMbr "has no member named cosine to fold in"
}

struct NoSuchExclusion extends Meter {
  use Trig but cosine, secret;   //~ ErrorNoMbr "has no member named cosine to leave out"
                                 //~^ ErrorNotPublic "secret is private to Trig, so '*' never folds it; there is nothing to leave out"
}

// A sibling is inside the BASE's boundary, not inside this type's, so what it
// declares privately stays its own
struct TakesPrivate extends Meter {
  use Trig secret;               //~ ErrorNotPublic "is private to Trig"
}

// What comes to the sibling from the base they share is here already, by the
// same route: a sibling fold admits what the sibling adds
struct TakesBaseMethod extends Meter {
  use Trig scaled;               //~ ErrorBadFold "comes to Trig from the base they share"
}

struct TakesBaseField extends Meter {
  use Trig cm;                   //~ ErrorBadFold "comes to Trig from the base they share"
}

// A finalizer belongs to its own type's values' lifecycle and does not fold
struct TakesFinal extends Meter {
  use Ender final;               //~ ErrorBadFold "lifecycle"
}

// Two siblings declaring one name is the collision this construct exists to let
// one declaration settle, with 'as' or 'but' -- unsettled, it is an error here
struct Clash extends Meter {
  use Trig;
  use LogExp;                    //~ ErrorDupName "rename it with 'as', or leave it out with 'but'"
}

// And a folded name colliding with one this type declares itself
struct ClashesWithOwn extends Meter {
  use Trig sine;                 //~ ErrorDupName "rename it with 'as'"
  pub fn sine(self) i32 {
    cm;
  }
}

// Two types folding each other in: neither can be complete first, and the one
// reached by demand is where that shows
struct Ring1 extends Meter {
  use Ring2;
}

struct Ring2 extends Meter {
  use Ring1;                     //~ ErrorCircular "is not complete until"
}
