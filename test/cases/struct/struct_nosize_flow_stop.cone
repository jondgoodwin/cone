// A struct that holds itself by value is refused with its infinite size (ErrorNoSize), and the
// compile ends there: the list of it that main makes is not walked by flow, which would go round
// the cycle for ever.

mod struct_nosize_flow_stop;

import collections use *;

struct R {
  m: R        //~ ErrorNoSize "Field m cannot be held by value: R contains R by value: infinite size"
}

fn main() {
  var l = List[R]();
}
