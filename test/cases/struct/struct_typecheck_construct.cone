// Struct constructors that do not agree with the type they name.
//
// Type-check stage. A constructor is matched against the declaration field by
// field, so every way of getting the list wrong is found at the constructor
// itself. Method and operator calls, and the privacy of an access, are in
// struct_typecheck_methods.

mod struct_typecheck_construct;

struct Point {
  pub x i32;
  pub y i32;
}

// A field without a default must be given a value
fn tooFew() {
  imm p = new Point(1);  //~ ErrorBadArray:11 "Not enough values specified"
  return;
}

fn tooMany() {
  imm p = new Point(1, 2, 3);  //~ ErrorBadArray:11 "Too many values specified"
  return;
}

// A named form must name a field of the type, and the diagnostic reports the
// field left without a value rather than the name that matched nothing
fn unnamedField() {
  imm p = new Point(x: 1, nosuch: 2);  //~ ErrorBadArray:11 "Cannot find named value matching the field y"
  return;
}

// A value's type must be the field's type. Only the first value is reported,
// because the check stops at the field it could not fill.
fn wrongType() {
  imm p = new Point(1., 2);  //~ ErrorBadArray:21 "does not match expected field's type"
  return;
}

// Any code of the module that declares a type may give its private field a
// value, by position or by name, so neither of these is refused. Code outside
// the module may not (module_privacy_typecheck); leaving a private field to
// its default is allowed from anywhere (struct_methods).
struct Guarded {
  pub open i32;
  secret i32 = 0;
}

fn privateField() {
  imm g = new Guarded(1, 2);
  return;
}

fn privateFieldNamed() {
  imm g = new Guarded(open: 1, secret: 2);
  return;
}
