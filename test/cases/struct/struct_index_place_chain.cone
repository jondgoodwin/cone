// A place reached through an index and then a field or another index, written
// to: a store, an operator changing it in place, a `&mut` borrow of it, or a
// `self: &mut` method called on it. Every index in the chain of field and index
// steps goes through the type's `&[]`, the element's mutable borrow, however
// many there are ('a[g].b[i].n = 5' has two), as one index does
// (struct_index_set_position). The same sequence runs on a local, on a `&mut`
// parameter and through `self`, and each prints the same lines.

mod struct_index_place_chain;

import collections use *;
import stdio use *;

struct Inner {
  pub adv: List[i64];
  pub n: i64;
  pub fn reset(self: &mut) { n = 0; adv.clear(); }
  pub fn grow(self: &mut, v: i64) { adv.push(v); n = n + 1; }
}

struct Mid {
  pub items: List[Inner];
}

fn fresh() Inner { Inner(List[i64].empty(), 0) }

fn sumOf(xs: &List[i64]) i64 {
  var s = 0i64;
  var i = 0usize;
  while i < xs.len() {
    s = s + *xs[i];
    i++;
  }
  s
}

fn showInner(label: &str, x: &Inner) {
  printStr(label);
  printStr(": n=");
  printInt(x.n);
  printStr(" len=");
  printUInt(u64.from(x.adv.len()));
  printStr(" sum=");
  printInt(sumOf(&x.adv));
  printStr("\n");
}

fn pushTo(l: &mut List[i64], v: i64) { l.push(v); }

struct UI {
  pub fields: List[Inner];
  pub groups: List[Mid];

  pub fn make() UI {
    var u = UI(List[Inner].empty(), List[Mid].empty());
    u.fields.push(fresh());
    var m = Mid(List[Inner].empty());
    m.items.push(fresh());
    u.groups.push(m);
    u
  }

  pub fn dump(self: &, tag: &str) {
    printStr(tag);
    printStr(" groups=");
    printUInt(u64.from(groups[0usize].items.len()));
    printStr("\n");
    showInner("  field 0", fields[0usize]);
    showInner("  item 0", groups[0usize].items[0usize]);
    showInner("  item 1", groups[0usize].items[1usize]);
  }

  // The sequence, through 'self': bare field names and 'self.' both
  pub fn bySelf(self: &mut) {
    fields[0usize].adv.push(10);
    self.fields[0usize].adv.push(20);
    let a = &mut fields[0usize].adv;
    a.push(30);
    fields[0usize].n = 4;
    self.fields[0usize].n += 1;
    groups[0usize].items[0usize].n = 5;
    self.groups[0usize].items[0usize].adv.push(7);
    groups[0usize].items.push(fresh());
    self.groups[0usize].items[1usize] = Inner(List[i64].empty(), 8);
    let r = &mut groups[0usize].items[0usize];
    r.n = 11;
    self.groups[0usize].items[1usize].n += 2;
    groups[0usize].items[0usize].reset();
    self.groups[0usize].items[1usize].grow(3);
    pushTo(&mut fields[0usize].adv, 99);
    self.dump("self");
    fields[0usize].adv.clear();
    fields[0usize].adv.push(1);
    self.dump("self again");
  }
}

// The sequence, through a '&mut' parameter
fn byParam(u: &mut UI) {
  u.fields[0usize].adv.push(10);
  u.fields[0usize].adv.push(20);
  let a = &mut u.fields[0usize].adv;
  a.push(30);
  u.fields[0usize].n = 4;
  u.fields[0usize].n += 1;
  u.groups[0usize].items[0usize].n = 5;
  u.groups[0usize].items[0usize].adv.push(7);
  u.groups[0usize].items.push(fresh());
  u.groups[0usize].items[1usize] = Inner(List[i64].empty(), 8);
  let r = &mut u.groups[0usize].items[0usize];
  r.n = 11;
  u.groups[0usize].items[1usize].n += 2;
  u.groups[0usize].items[0usize].reset();
  u.groups[0usize].items[1usize].grow(3);
  pushTo(&mut u.fields[0usize].adv, 99);
  u.dump("param");
  u.fields[0usize].adv.clear();
  u.fields[0usize].adv.push(1);
  u.dump("param again");
}

// The sequence, through a local
fn byLocal() {
  var u = UI.make();
  u.fields[0usize].adv.push(10);
  u.fields[0usize].adv.push(20);
  let a = &mut u.fields[0usize].adv;
  a.push(30);
  u.fields[0usize].n = 4;
  u.fields[0usize].n += 1;
  u.groups[0usize].items[0usize].n = 5;
  u.groups[0usize].items[0usize].adv.push(7);
  u.groups[0usize].items.push(fresh());
  u.groups[0usize].items[1usize] = Inner(List[i64].empty(), 8);
  let r = &mut u.groups[0usize].items[0usize];
  r.n = 11;
  u.groups[0usize].items[1usize].n += 2;
  u.groups[0usize].items[0usize].reset();
  u.groups[0usize].items[1usize].grow(3);
  pushTo(&mut u.fields[0usize].adv, 99);
  u.dump("local");
  u.fields[0usize].adv.clear();
  u.fields[0usize].adv.push(1);
  u.dump("local again");
}

fn main() {
  byLocal();
  var p = UI.make();
  byParam(&mut p);
  var s = UI.make();
  s.bySelf();
}
