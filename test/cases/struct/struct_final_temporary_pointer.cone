// A temporary is finalized at the end of its statement whatever is made from
// it. A raw pointer made from one dangles afterwards, as a pointer to a local
// does after its block; keeping it valid is the programmer's job, and the
// pointer here is never read. A call whose receiver is a '&mut' to a struct
// holding a raw pointer, given a borrow of a temporary, finalizes that
// temporary too: the compiler no longer assumes the call kept the borrow.
//
// Worked out by hand, in order: 'id(&mk(2)) as *R' finalizes the 2 at its
// statement's end, before "after p"; the two calls of 'bag.add(&mk(3))' and
// 'bag.add(&mk(4))' each finalize their own temporary, before the line after.

mod struct_final_temporary_pointer;

import stdio use *;

struct R {
  pub n: i64;
  fn final(self: &uni) {
    printStr("  final ");
    printInt(n);
    printStr("\n");
  }
}

fn mk(n: i64) R { R(n) }
fn id(r: &R) &R { r }

struct Bag {
  p: *u8;
  pub total: i64;
  pub fn add(self: &mut, r: &R) i64 {
    total = total + r.n;
    total
  }
}

fn main() i32 {
  let p = id(&mk(2)) as *R;
  printStr("after p\n");
  var bag = Bag(null, 0i64);
  bag.add(&mk(3));
  printStr("after add\n");
  let t = bag.add(&mk(4));
  printStr("total ");
  printInt(t);
  printStr("\n");
  0i32
}
