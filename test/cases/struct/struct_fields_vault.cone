// The module another scenario takes apart the types of, for struct_fields_outside
// and struct_fields_outside_refused. A field not `pub` is private to this module,
// so outside it a field list may name the public fields only; the private ones are
// not named, and die with the statement. `Strongbox` has a finalizer, so it is
// not taken apart anywhere, outside its module no differently than inside it.

mod struct_fields_vault;

pub struct Token is Move {
  pub id: i32;
}

pub struct Vault {
  pub id: i32;
  secret: Token;
  pub tag: Token;
}

pub struct Strongbox {
  pub id: i32;
  fn final(self: &uni) { }
}

pub fn openVault() Vault { Vault(1, Token(2), Token(3)) }
pub fn openStrongbox() Strongbox { Strongbox(4) }
