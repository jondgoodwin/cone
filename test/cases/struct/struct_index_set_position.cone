// An index in set position, on a type declaring both '[]' and '&[]': a store
// to the element, a store to its field, an operator changing either in place,
// and a 'self &mut' method called on it all go through '&[]', the element's
// mutable borrow, as Rust's IndexMut is chosen for a place written to. A read
// goes through '[]'. A type declaring no '&[]' is unchanged: 'x[i] = v' on it
// is no place.

mod struct_index_set_position;

import stdio use *;

struct Pt {
  pub x i64;
  pub y i64;
  pub fn bump(self &mut) { x = x + 1; }
  pub fn sum(self &) i64 { x + y; }
}

// Two points, reached by index; counts how each is reached
struct Two {
  a Pt;
  b Pt;
  pub reads i64;
  pub writes i64;
  pub fn `[]`(self &mut, i usize) &Pt {
    reads = reads + 1;
    if i == 0usize { &a; } else { &b; };
  }
  pub fn `&[]`(self &mut, i usize) &mut Pt {
    writes = writes + 1;
    if i == 0usize { &mut a; } else { &mut b; };
  }
}

fn main() {
  mut t = new Two(new Pt(1, 2), new Pt(3, 4), 0, 0);
  t[0usize] = new Pt(10, 20);
  t[1usize].x = 30;
  t[1usize].y += 5;
  t[0usize].bump();
  printInt(t[0usize].sum());
  printStr(" ");
  printInt(t[1usize].sum());
  printStr(" ");
  printInt(t.reads);
  printStr(" ");
  printInt(t.writes);
  printStr("\n");
}
