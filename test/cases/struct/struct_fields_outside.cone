// Another module's struct, taken apart by its public fields. The private field it
// holds is not named, and dies with the statement as any field not named does.
// A compile, because a program spanning modules cannot be linked yet; the
// shapes run in struct_fields_take, and a private field named from here is
// struct_fields_outside_refused.

mod struct_fields_outside;

import struct_fields_vault use *;

fn publicFields() i32 {
  let id, tag = openVault().(id, tag);
  id + tag.id
}

fn oneField() i32 {
  let v = openVault();
  let tag = v.(tag);
  tag.id
}

fn throughReference(v: &Vault) i32 {
  let id = v.(id);
  id
}
