// Not a scenario: the module struct_const_private names a type of. A type's const
// is public with 'pub' as any member is, and private to this module without it.

mod structconstmod;

pub struct Gauge {
  pub reading: i32;
  pub const full: i32 = 100;
  const reserve: i32 = 15;

  pub fn low(self) bool {
    reading < reserve
  }
}
