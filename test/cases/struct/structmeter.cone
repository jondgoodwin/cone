// A base in a module of its own, for struct_extends_import: the motivating case
// for 'extends' is enriching somebody else's type, so the pair has to be able to
// sit on opposite sides of a module boundary. 'scale' is private, which is the
// point: an enrichment declared elsewhere is still inside this type's
// encapsulation boundary.

mod structmeter;

pub struct Meter {
  pub mut cm i32;
  scale i32;

  pub fn scaled(self) i32 {
    cm * scale;
  }
  fn hidden(self) i32 {
    scale + scale;
  }
  pub fn make() Meter {
    Meter[4, 5];
  }
}

// A base with a private finalizer that calls a private method: an enrichment
// declared elsewhere finalizes with its own copy of it, whose body stays bound here
pub struct Handle {
  pub fd i32;

  fn release(self &) i32 {
    fd;
  }
  fn final(self &uni) {
    release();
  }
}
