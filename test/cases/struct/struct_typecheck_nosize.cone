// Every way a declaration can name a type that cannot say how large it is.
//
// One family, one diagnostic, and its own file rather than a share of
// struct_typecheck_decl: the reasons differ but the fact does not, so what a
// reader wants side by side is which cause produced which message and which
// remedy it named. struct_opaque is the other half of the opaque cases -- what
// such a type may do, which is be pointed at.
//
// A size is missing infectiously as often as directly, so the message names the
// declaration that actually lacks the size rather than the type the field
// happens to hold, and uncounted lines below it name the hops in between. Those
// lines carry no code and so are not annotated here; the annotation is on the
// diagnostic that counts.

mod struct_typecheck_nosize;

// -------- still being laid out --------

// A struct's field may not be the struct itself: the value would have to
// contain a copy of itself. Held through a reference it is legal and is how a
// linked list is written, which struct-recursive covers.
struct SelfHolding {
  inner SelfHolding;  //~ ErrorNoSize:3 "still being laid out"
}

// The same one level down. An array's size is its length times its element's,
// so an array of a struct still being laid out has none either -- and the array
// is what reports, because it asks its element that question when the array type
// is formed, which is earlier and nearer the cause than the field holding it.
// Nothing asked at all before that, and laying this struct out ran the compiler
// out of stack.
struct SelfArraying {
  v i64;
  more [2; SelfArraying];  //~ ErrorNoSize:8 "still being laid out"
}

// A typedef is the type it names, so a struct held by value through an alias
// still contains itself, whichever side of the struct the alias is written on.
// A typedef naming a *reference* to the struct is the legal form, and is taken
// as a parameter and a 'self' in trait_success and typemgmt_success: the
// reference is the one being checked there, and its size never depended on
// what it points at.
typedef AliasHeld AliasHolding;

struct AliasHolding {
  inner AliasHeld;  //~ ErrorNoSize:3 "still being laid out"
}

// Two structs that hold each other by value are a cycle through the pair, and
// laying every type out before checking any member does not change that: a
// layout still asks each field's type for its size, and one of the two is always
// asked while it is in flight. Both fields report, and the second names the hop
// that carries the cycle back ("... Mutual2 has no size because its field m has
// type Mutual1", an uncounted line).
struct Mutual1 {
  m Mutual2;  //~ ErrorNoSize:3 "Mutual1 is still being laid out"
}

struct Mutual2 {
  m Mutual1;  //~ ErrorNoSize:3 "Mutual1 is still being laid out"
}

// -------- declared @opaque --------

struct @opaque Handle {
}

// A field holds its type by value
struct Holder {
  h Handle;   //~ ErrorNoSize:3 "is declared @opaque"
}

// An enrichment is its base's representation, so an enrichment of an opaque
// type is opaque too, although the attribute is written on the base alone
struct RichHandle extends Handle {
  pub fn tag(self &) i32 {
    1;
  }
}

fn enrichedInVariable() {
  mut r RichHandle;   //~ ErrorNoSize:7 "is declared @opaque"
  return;
}

// So does a variable
fn inVariable() {
  mut h Handle;   //~ ErrorNoSize:7 "is declared @opaque"
  return;
}

// Opacity is infectious, so a field may name a type that is unsized only
// because of something further down. The diagnostic names Handle, which is
// where the author has to go, not Nested, which is where they already are.
struct Nested {
  h Handle;   //~ ErrorNoSize:3 "is declared @opaque"
}

struct Outer {
  n Nested;   //~ ErrorNoSize:3 "is declared @opaque"
}

// An array of them is refused where the array is written rather than where it
// is held, because the array is then a type with no size. That is also why the
// reference below is refused: a reference to an opaque type is the whole point
// of the type, but a reference to an *array* of them still needs the array to
// be a type, and it is not.
struct Slots {
  many [4; Handle];   //~ ErrorNoSize:8 "is declared @opaque"
}

fn behindRef(p &[4; Handle]) i32 {   //~ ErrorNoSize:17 "is declared @opaque"
  0;
}
