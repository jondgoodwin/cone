// A type's 'const' where it is not built, and where it is not written whole.
//
// Parse stage. A trait's requirement of a constant (`const max: Self;`) is not
// built: refused where written, whatever the value. A const, like a module's,
// is given its value; 'static' applies to a variable, which a const is not; and
// a name is one name in the type. (A generic type's const is built:
// struct_const_generic.)

mod struct_const_parse;

trait Shape {
  const sides: i32 = 4;       //~ ErrorConstPlace:9 "this is a trait"
  fn area(self) i32;
}

struct Plain {
  n: i32;
  const a: i32 = 1;
  const a: i32 = 2;           //~ ErrorDupName:9 "Duplicate name a"
  const b: i32;               //~ ErrorNoInit
  static const c: i32 = 1;    //~ ErrorBadStatic
  const : i32 = 3;            //~ ErrorNoIdent
}
