// What a folded field is not: a field of the type. It is a name for storage
// inside another type's value, so it cannot be named in the type's literal and
// meets no trait's field requirement. A folded method does count toward
// conformance, which struct_fold establishes through a virtual reference.
//
// Type-check stage. What a clause may admit is decided earlier, while the type
// is name resolved, and is in struct_nameres_fold.

mod struct_typecheck_fold;

struct Engine {
  pub fuel i32;

  pub fn power(self &) i32 {fuel * 2;}
}

struct Car {
  pub engine Engine use fuel, power;
  pub seats i32;
}

// A type literal names the type's own fields. A folded name is not one, so
// the flat constructor the old manual offered for 'use *' does not exist:
// the engine stays a real field, and 'Car[engine: Engine[1], seats: 2]' is
// the literal.
fn literal() {
  imm c = Car[fuel: 1, seats: 2];   //~ ErrorBadArray:14 "Cannot find named value matching the field engine"
  return;
}

// A trait's field requirement is met only by a field the type has
trait Fuelled {
  pub fuel i32;
}

fn fuelOf(f &<Fuelled) i32 {
  f.fuel;
}

fn conformance() {
  imm c = Car[Engine[3], 2];
  fuelOf(&c);                       //~ ErrorInvType:10
  return;
}
