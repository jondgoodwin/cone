// A struct, array or tuple of 64 bytes or less returned by a Cone function
// comes back in registers or through its caller's slot, never one register
// per field: LLVM returns a first-class aggregate so, and on Win64 sends a
// third and fourth float through the x87 stack. So a struct of 2 to 4 floats,
// or 2 doubles, returns as one vector; any other of up to 16 bytes, but one
// or two scalars, as an integer or two; one of 17 to 64 bytes through a slot
// its caller passes ('sret'). Arguments are passed as before. The preir
// checks pin each shape, on the definition and the call; each result is read
// back field by field, from a direct call, a call through a '&fn', a call
// through a vtable slot, a result chosen by an 'if', and one returned on.

mod struct_return_registers;

import stdio use *;

fn showF(label &[]u8, a f64) {
  printStr(label);
  printStr(" = ");
  printFloat(a);
  printStr("\n");
}

fn showI(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct V4 {
  pub x f32;
  pub y f32;
  pub z f32;
  pub w f32;
  fn scaled(self, k f32) V4 { new V4(x * k, y * k, z * k, w * k); }
}

struct V3 {
  pub x f32;
  pub y f32;
  pub z f32;
}

struct V2 {
  pub x f32;
  pub y f32;
}

struct D2 {
  pub a f64;
  pub b f64;
}

// 3 bytes: an i32, its fourth byte zero
struct Rgb {
  pub r u8;
  pub g u8;
  pub b u8;
}

// 6 bytes, with a Bool and padding: an i64
struct Flags {
  pub n i32;
  pub on Bool;
  pub off Bool;
}

// 10 bytes of fields, mixed: two i64s
struct Mixed {
  pub a i32;
  pub f f32;
  pub c u16;
}

// Two scalars, returned as they were
struct Pair {
  pub a i32;
  pub b i32;
}

// 36 bytes: through the caller's slot
struct M3 {
  pub m Array[f32, 9];
}

// 24 bytes of integers: through the caller's slot too
struct Three {
  pub a i64;
  pub b i64;
  pub c i64;
}

trait Shape {
  pub fn corner(self &) V4;
  pub fn box(self &) Three;
}

struct Square is Shape {
  pub s f32;
  fn corner(self &) V4 { new V4(s, s, 0., 1.); }
  fn box(self &) Three { new Three(1, 2, 3); }
}

fn v4(a f32) V4 { new V4(a, a + 1., a + 2., a + 3.); }
fn v3(a f32) V3 { new V3(a, a * 2., a * 3.); }
fn v2(a f32) V2 { new V2(a, -a); }
fn d2(a f64) D2 { new D2(a, a / 4.); }
fn arr4(a f32) Array[f32, 4] { [a, a * 10., a * 100., a * 1000.]; }
fn rgb(a u8) Rgb { new Rgb(a, a + 1u8, a + 2u8); }
fn flags(n i32) Flags { new Flags(n, n > 0i32, n < 0i32); }
fn mixed(a i32) Mixed { new Mixed(a, 1.5, 7u16); }
fn pair(a i32) Pair { new Pair(a, a * 3i32); }
fn m3(a f32) M3 { new M3(new Array[f32, 9] <- fill a); }
fn three(a i64) Three { new Three(a, a * 2, a * 3); }
fn tuple(a f32) (f32, f32, f32) { (a, a + 0.5, a + 0.25); }

// A result chosen by an 'if', and one returned on
fn pick(c Bool) V4 { if c { v4(10.); } else { v4(20.); }; }
fn passOn(a u8) Rgb { rgb(a); }

fn cond(c Bool) Bool { c; }

fn look(s &<Shape) f32 {
  imm c = s.corner();
  c.x + c.y * 10. + c.z * 100. + c.w * 1000.;
}

fn main() {
  imm a = v4(1.);
  showF("v4", f64.from(a.x + a.y * 10. + a.z * 100. + a.w * 1000.));
  imm s = a.scaled(2.);
  showF("method", f64.from(s.w));
  imm b = v3(2.);
  showF("v3", f64.from(b.x + b.y * 10. + b.z * 100.));
  imm c = v2(3.);
  showF("v2", f64.from(c.x * 10. + c.y));
  imm d = d2(1.);
  showF("d2", d.a + d.b);
  imm e = arr4(1.);
  showF("array", f64.from(e[0usize] + e[1usize] + e[2usize] + e[3usize]));
  imm g = rgb(10u8);
  showI("rgb", i64.from(g.r) * 10000 + i64.from(g.g) * 100 + i64.from(g.b));
  imm f = flags(5i32);
  showI("flags", i64.from(f.n) * 100 + (if f.on {10;} else {0;}) + (if f.off {1;} else {0;}));
  imm h = flags(-5i32);
  showI("flags-negative", i64.from(h.n) * 100 + (if h.on {10;} else {0;}) + (if h.off {1;} else {0;}));
  imm m = mixed(5i32);
  showI("mixed", i64.from(m.a) * 100 + i64.from(m.c));
  showF("mixed-float", f64.from(m.f));
  imm p = pair(4i32);
  showI("pair", i64.from(p.a) * 100 + i64.from(p.b));
  imm n = m3(4.);
  showF("m3", f64.from(n.m[0usize] + n.m[8usize]));
  imm t = three(7);
  showI("three", t.a * 10000 + t.b * 100 + t.c);
  imm u = tuple(1.);
  showF("tuple", f64.from(u.0 + u.1 * 10. + u.2 * 100.));
  showF("if", f64.from(pick(cond(true)).x * 100. + pick(cond(false)).x));
  showI("passed-on", i64.from(passOn(40u8).b));

  imm viaFn &fn(a f32) V4 = &fn(a f32) V4 {new V4(a, a, a, a + 1.);};
  imm r = viaFn(5.);
  showF("fnref", f64.from(r.x + r.w * 10.));
  imm viaFnInt &fn(a u8) Rgb = &fn(a u8) Rgb {new Rgb(a, a, a + 1u8);};
  showI("fnref-int", i64.from(viaFnInt(8u8).b));
  imm viaFnSlot &fn(a i64) Three = &fn(a i64) Three {new Three(a, a, a + 1);};
  showI("fnref-slot", viaFnSlot(8).c);

  imm sq = new Square(3.);
  showF("vtable", f64.from(look(&sq)));
  imm sh &<Shape = &sq;
  showI("vtable-slot", sh.box().c);
}
