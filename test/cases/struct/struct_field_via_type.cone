// A field named through its type has no value: a field belongs to a value of the type. Its const and its
// static are what a type holds for itself, and are read through the type.

mod struct_field_via_type;

struct Count {
  pub n: u32 = 13;
  pub const fixed: u32 = 4;
}

enum Shade {
  Dark, Light;
  pub count: u32 = 13;
}

fn fromStruct() u32 {
  Count.n                 //~ ErrorFieldViaType
}

fn fromEnum() u32 {
  Shade.count             //~ ErrorFieldViaType
}

fn fromConst() u32 {
  Count.fixed
}
