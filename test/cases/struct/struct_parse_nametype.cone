// A field's name and its type take a ':' between them, as every declared name
// does (core_parse_nametype holds the rule and the other places). The old
// spelling is refused with no word about the old way. The type that follows
// the name is then read as a field of its own, which is why each case here
// writes a different type: two such fields would be reported again as one
// name declared twice.

mod struct_parse_nametype;

struct Fields {
  pub kept: i32;
  pub x f32 = 0.;           //~ ErrorNoSemi
}

struct Plain {
  pub y u8;                 //~ ErrorNoSemi
}

struct Shared {
  static var count i16 = 0;   //~ ErrorNoSemi
}

// A field of a variant struct
enum Shape {
  struct Circle {
    pub r u16;              //~ ErrorNoSemi
  }
  struct Dot;
}
