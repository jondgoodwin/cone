// A bool reaches a number by its explicit conversion, 'T.from(b)', which gives
// 0 for false and 1 for true, in each position where an implicit one is
// refused (typemgmt_typecheck_boolnbr): an initializer, an assignment, an
// argument, a return, a construction's field, an index into an array and into
// a pointer, an operand of arithmetic and of a comparison, a global, and the
// signed and float targets. Each bool comes in as a parameter, so the
// conversion is not folded away; the global's is a literal converted, which
// folds to a constant.

mod typemgmt_bool_number;

import stdio use *;

fn show(label &str, n u64) {
  printStr(label);
  printStr(" = ");
  printUInt(n);
  printStr("\n");
}

struct Counted {
  pub n usize;
}

fn wantUsize(n usize) usize {
  n;
}

fn returned(b bool) u16 {
  return u16.from(b);
}

imm globalCount u8 = u8.from(true);

fn positions(yes bool, no bool) {
  imm x usize = usize.from(yes);
  show("initializer-true", u64.from(x));
  imm z usize = usize.from(no);
  show("initializer-false", u64.from(z));

  mut n u32 = 7u32;
  n = u32.from(yes);
  show("assignment", u64.from(n));

  show("argument", u64.from(wantUsize(usize.from(yes))));
  show("return", u64.from(returned(yes)));
  imm c = new Counted(n: usize.from(yes));
  show("field", u64.from(c.n));

  imm cells Array[u64, 2] = [10u64, 20u64];
  show("array-index-true", cells[usize.from(yes)]);
  show("array-index-false", cells[usize.from(no)]);
  imm p *u64 = &cells[0];
  show("pointer-index", p[usize.from(yes)]);

  mut total usize = 1usize;
  total = total + usize.from(yes);
  total += usize.from(yes);
  show("arithmetic", u64.from(total));
  show("comparison", u64.from(bool.from(1u8 == u8.from(yes))));

  show("global", u64.from(globalCount));
  imm i i64 = i64.from(yes);
  show("signed", u64.from(i));
  imm f f64 = f64.from(yes) + 0.5d;
  show("float-plus-half-times-two", u64.from(f * 2.0d));
}

fn main() i32 {
  positions(true, false);
  0i32;
}
