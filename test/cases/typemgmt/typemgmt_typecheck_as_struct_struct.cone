// 'as' from one struct to another is refused, whatever their sizes: no struct is
// a subtype of another, so it is no coercion. P and Q are the same size.
// The same-size recast returns under 'trust', which is not built yet.

mod typemgmt_typecheck_as_struct_struct;

struct P {
  x: i32;
}

struct Q {
  y: i32;
}

struct Big {
  a: i64;
  b: i64;
}

fn pToQ(p: P) Q {
  p as Q    //~ ErrorAsTarget:3 "`as` may not make Q from P"
}

fn pToBig(p: P) Big {
  p as Big    //~ ErrorAsTarget:3 "`as` may not make Big from P"
}
