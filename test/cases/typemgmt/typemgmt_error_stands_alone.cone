// A first error stands alone: the types it leaves bad are named "this type" in what follows and
// no later check reaches the compiler's "node that has none" arm (Error 1075).

mod typemgmt_error_stands_alone;

struct V {
  x: i64;
  macro `+`[self, o: i64] { i8(x: self.x + o) }     //~ ErrorNewType
}

struct Pair[T] {
  a: T;
  b: T
}

struct Outer is Hash {          //~ ErrorHashNoEq
  inner: Pair                   //~ ErrorArgCount
                                //~^ ErrorHashField follow-on
}

struct P {
  x: i64
}

fn fill() {
  let a = &Array[u8, 4]() <- fill 0u8;     //~ ErrorArrayContents
                                           //~^ ErrorFillSize follow-on
}

fn plus() {
  var c = V(x: 10);
  c += V(x: 2);        //~ ErrorMacroArgType
                       //~^ ErrorInvType follow-on
}

fn deref(b: i64) {
  let q = *b as P;     //~ ErrorNotPtr
                       //~^ ErrorAsTarget follow-on
}

fn types_as_value() {
  var t = (i32, bool);     //~ ErrorNotTyped
}
