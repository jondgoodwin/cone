// An expression made only of integer literals with no suffix is one literal worked out
// exactly across every value i64 and u64 hold together, so an intermediate or a result above
// i64's maximum is fine where the place's type holds it (the manual, syntax-lexical, "Number
// literals"; Row 764). Every line prints 'ok'. The expected values are written out by hand.

mod typemgmt_litwide;

import stdio use *;

fn ok(label: &str, good: bool) {
  printStr(label);
  if good { printStr(": ok\n"); } else { printStr(": FAILED\n"); }
}

fn takesU64(x: u64) u64 { x }

fn main() {
  let a: u64 = 1 << 63;
  ok("the top bit", a == 9223372036854775808u64);
  let b: u64 = 0x8000000000000000 | 1;
  ok("top bit or one", b == 9223372036854775809u64);
  let c: u64 = 9223372036854775807 + 1;
  ok("i64's maximum plus one", c == 9223372036854775808u64);
  let d: u64 = 18446744073709551615 - 1;
  ok("u64's maximum less one", d == 18446744073709551614u64);
  let e: u64 = 18446744073709551615 >> 60;
  ok("u64's maximum shifted right", e == 15u64);
  let f: u64 = -1 & 18446744073709551615;
  ok("minus one and u64's maximum", f == 18446744073709551615u64);
  let g: u64 = 18446744073709551615 / 3;
  ok("division", g == 6148914691236517205u64);
  let h: u64 = 18446744073709551615 % 1000;
  ok("remainder", h == 615u64);
  let i: u64 = 4294967296 * 4294967295;
  ok("product", i == 18446744069414584320u64);
  let j: u64 = 9223372036854775807 + 9223372036854775807;
  ok("two maxima", j == 18446744073709551614u64);
  let k: i64 = 18446744073709551615 + -9223372036854775808;
  ok("back down into an i64", k == 9223372036854775807i64);
  let l: i64 = 9223372036854775807 + 1 - 2;
  ok("an intermediate above i64's maximum", l == 9223372036854775806i64);
  let m: i64 = -(1 << 63);
  ok("i64's minimum, negated shift", m == -9223372036854775807i64 - 1);
  let n: i64 = -1 << 63;
  ok("minus one shifted left", n == -9223372036854775807i64 - 1);
  let o: i64 = -9223372036854775808 >> 63;
  ok("i64's minimum shifted right is arithmetic", o == -1i64);
  let p: u64 = 1 << 63 >> 63;
  ok("up and down", p == 1u64);
  let q: u64 = 0xFFFFFFFFFFFFFFFF ^ 0xFF;
  ok("xor", q == 18446744073709551360u64);
  let r: u64 = -9223372036854775808 / -1;
  ok("i64's minimum over minus one", r == 9223372036854775808u64);
  let s: i64 = -7 / 2;
  ok("division truncates", s == -3i64);
  let t: i64 = -7 % 3;
  ok("remainder of a negative", t == -1i64);
  let u: i64 = 5 - 9;
  ok("ordinary", u == -4i64);
  ok("in an argument", takesU64(1 << 63) == 9223372036854775808u64);
  let v: u64 = 1 << 62;
  ok("below the top", v == 4611686018427387904u64);
}
