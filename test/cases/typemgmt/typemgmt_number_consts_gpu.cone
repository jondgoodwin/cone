// The constants of the number types fold in a GPU kernel: 'f32.pi', 'u32.maxValue'
// and the generic 'T.maxValue' are literals in the kernel, so nothing reaches the
// SPIR-V module as a global variable for them (they have no storage).

mod typemgmt_number_consts_gpu;

fn top[T]() T { T.maxValue }

fn @compute(64) consts(inv: Invocation, xs: &Array[f32], out: &mut Array[f32], ints: &mut Array[u32]) {
  let i = usize.from(inv.globalId[0]);
  if i < out.len && i < xs.len && i < ints.len {
    out[i] = xs[i] * f32.pi + f32.epsilon;
    ints[i] = u32.maxValue - top[u32]() + u32.bits;
  }
}
