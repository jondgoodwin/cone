// A number type's constants are the ones it declares: 'f64.nope' and 'u8.pi' name
// none, and a generic's 'T.maxValue' is refused at an instance without it (a
// struct with no such const), as a type's other missing members are.

mod typemgmt_typecheck_number_consts;

struct Plain { pub n: i32; }

fn top[T]() T { T.maxValue }  //~ ErrorUnkName:19 "Plain has no constant or member named maxValue"

fn main() i32 {
  let a = top[Plain]();
  let b = f64.nope;      //~ ErrorNoMbr:15 "f64 has no constant"
  let c = u8.pi;         //~ ErrorNoMbr:14 "u8 has no constant"
  0
}
