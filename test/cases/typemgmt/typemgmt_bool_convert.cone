// Converting a number to Bool, implicitly where a Bool is wanted and
// explicitly with 'Bool.from(x)', gives the answer a condition gives for the
// same value: the isTrue rule (refif.html, reftypesafe.html "Implicit Coercion
// to Bool"). An integer is true unless it is 0; a float is false for 0 and -0
// and true for every other value, NaN included.
//
// Each line prints the three answers side by side: the number passed as a
// Bool, 'from', and 'if'. The values are the ones that tell "not zero" apart from
// "keep the low bit": 2, 256, -128i8, u64's top bit and 2^32 all have a low bit
// of 0 and are true; 0.5 and -0.25 become 0 if a float is turned into an
// integer first, and are true.

mod typemgmt_bool_convert;

import stdio use *;

fn b(x Bool) i64 {
  if x {1;} else {0;}
}

fn show3(label &[]u8, coerced Bool, fromed Bool, cond Bool) {
  printStr(label);
  printStr(" = ");
  printInt(b(coerced));
  printStr(" ");
  printInt(b(fromed));
  printStr(" ");
  printInt(b(cond));
  printStr("\n");
}

fn cond32(n i32) Bool { if n {true;} else {false;} }
fn cond64(n i64) Bool { if n {true;} else {false;} }
fn condF(n f64) Bool { if n {true;} else {false;} }

fn int32(label &[]u8, n i32) {
  show3(label, n, Bool.from(n), cond32(n));
}

fn float64(label &[]u8, n f64) {
  show3(label, n, Bool.from(n), condF(n));
}

fn main() {
  // Signed 32-bit
  int32("i32 0", 0);
  int32("i32 1", 1);
  int32("i32 2", 2);
  int32("i32 -1", -1);
  int32("i32 256", 256);

  // Other widths and signedness
  mut u u8 = 255u8;
  show3("u8 255", u, Bool.from(u), if u {true;} else {false;});
  u = 254u8;
  show3("u8 254", u, Bool.from(u), if u {true;} else {false;});
  u = 0u8;
  show3("u8 0", u, Bool.from(u), if u {true;} else {false;});
  mut s i8 = -128i8;
  show3("i8 -128", s, Bool.from(s), if s {true;} else {false;});
  mut h u16 = 512u16;
  show3("u16 512", h, Bool.from(h), if h {true;} else {false;});
  mut big u64 = 9223372036854775808u64;
  show3("u64 2^63", big, Bool.from(big), if big {true;} else {false;});
  mut w i64 = 4294967296;
  show3("i64 2^32", w, Bool.from(w), cond64(w));
  w = 0;
  show3("i64 0", w, Bool.from(w), cond64(w));

  // Floats
  mut zero f64 = 0.0;
  float64("f64 0.0", zero);
  mut negzero f64 = -zero;
  show("f64 -0.0 sign bit", i64.from((negzero as u64) >> 63));
  float64("f64 -0.0", negzero);
  float64("f64 0.5", 0.5);
  float64("f64 -0.25", -0.25);
  mut nan f64 = zero / zero;
  show("f64 NaN == NaN", b(nan == nan));
  float64("f64 NaN", nan);
  mut half f32 = 0.5;
  show3("f32 0.5", half, Bool.from(half), if half {true;} else {false;});
  mut fz f32 = 0.0;
  show3("f32 0.0", fz, Bool.from(fz), if fz {true;} else {false;});

  // A Bool converts to itself
  mut t Bool = true;
  show3("Bool true", t, Bool.from(t), t);
}

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}
