// The constants of the number types, named through the type: 'f64.pi', 'u32.maxValue'
// (mod-globals.html, "A type's const"; guide-numbers.html). Each is a folded value
// with no storage. The float ones are checked against their IEEE 754 encodings,
// written out below from the standard (binary32 and binary64); the integers' bounds
// are the two's-complement ones of the type's width. 'minValue' is the most negative
// finite float and 'minPositive' the smallest normal one. The methods 'a.min(b)' and
// 'a.max(b)' are untouched.
//
// Also a generic function reaching one through its type parameter, 'T.maxValue',
// resolved per instance.

mod typemgmt_number_consts;

import stdio use *;

fn ok(label: &str, good: bool) {
  printStr(label);
  printStr(if good {" ok\n"} else {" BAD\n"});
}

fn top[T]() T { T.maxValue }
fn bottom[T]() T { T.minValue }
fn width[T]() u32 { T.bits }

fn main() i32 {
  // binary64: sign 1, exponent 11, fraction 52
  let p = f64.pi; ok("f64 pi", p.bits() == 0x400921FB54442D18u64);
  let t = f64.tau; ok("f64 tau", t.bits() == 0x401921FB54442D18u64);
  let e = f64.e; ok("f64 e", e.bits() == 0x4005BF0A8B145769u64);
  let i = f64.inf; ok("f64 inf", i.bits() == 0x7FF0000000000000u64);
  let n = f64.nan; ok("f64 nan", n.bits() == 0x7FF8000000000000u64);
  let ep = f64.epsilon; ok("f64 epsilon", ep.bits() == 0x3CB0000000000000u64);
  let lo = f64.minValue; ok("f64 minValue", lo.bits() == 0xFFEFFFFFFFFFFFFFu64);
  let hi = f64.maxValue; ok("f64 maxValue", hi.bits() == 0x7FEFFFFFFFFFFFFFu64);
  let mp = f64.minPositive; ok("f64 minPositive", mp.bits() == 0x0010000000000000u64);
  // binary32: sign 1, exponent 8, fraction 23
  let p3 = f32.pi; ok("f32 pi", p3.bits() == 0x40490FDBu32);
  let t3 = f32.tau; ok("f32 tau", t3.bits() == 0x40C90FDBu32);
  let e3 = f32.e; ok("f32 e", e3.bits() == 0x402DF854u32);
  let i3 = f32.inf; ok("f32 inf", i3.bits() == 0x7F800000u32);
  let n3 = f32.nan; ok("f32 nan", n3.bits() == 0x7FC00000u32);
  let ep3 = f32.epsilon; ok("f32 epsilon", ep3.bits() == 0x34000000u32);
  let lo3 = f32.minValue; ok("f32 minValue", lo3.bits() == 0xFF7FFFFFu32);
  let hi3 = f32.maxValue; ok("f32 maxValue", hi3.bits() == 0x7F7FFFFFu32);
  let mp3 = f32.minPositive; ok("f32 minPositive", mp3.bits() == 0x00800000u32);
  ok("nan is not itself", n != n);

  // Integer bounds
  printInt(i64.from(i8.minValue)); printStr(" "); printInt(i64.from(i8.maxValue)); printStr("\n");
  printInt(i64.from(i16.minValue)); printStr(" "); printInt(i64.from(i16.maxValue)); printStr("\n");
  printInt(i64.from(i32.minValue)); printStr(" "); printInt(i64.from(i32.maxValue)); printStr("\n");
  printInt(i64.minValue); printStr(" "); printInt(i64.maxValue); printStr("\n");
  printUInt(u64.from(u8.minValue)); printStr(" "); printUInt(u64.from(u8.maxValue)); printStr("\n");
  printUInt(u64.from(u16.maxValue)); printStr(" "); printUInt(u64.from(u32.maxValue)); printStr("\n");
  printUInt(u64.maxValue); printStr(" "); printUInt(u64.minValue); printStr("\n");
  printUInt(u64.from(u8.bits)); printStr(" "); printUInt(u64.from(i16.bits)); printStr(" ");
  printUInt(u64.from(u32.bits)); printStr(" "); printUInt(u64.from(i64.bits)); printStr("\n");
  ok("usize bits", usize.bits == 64u32 || usize.bits == 32u32);

  // Through a type parameter
  printUInt(u64.from(top[u8]())); printStr("\n");
  printInt(top[i64]()); printStr("\n");
  printInt(i64.from(bottom[i8]())); printStr("\n");
  let tf = top[f32](); ok("top f32", tf.bits() == 0x7F7FFFFFu32);
  printUInt(u64.from(width[u16]())); printStr("\n");

  // The methods are still the methods
  printInt(i64.from(3i32.max(7i32))); printStr(" "); printInt(i64.from(3i32.min(7i32))); printStr("\n");
  0
}
