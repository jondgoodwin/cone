// A method declaring 'self &Uni[Node]' is found only through a Uni[Node]. A
// receiver of another owner kind, a plain value or a borrow has no such method
// (a method of 'self &Rc[Node]' wants an Rc, and so on), and the form is
// allowed only for an owner of the method's own type.

mod typemgmt_typecheck_owner_self;

import sync use Arc;

struct Node {
  n i64;

  pub fn viaUni(self &Uni[Node]) i64 { self.n; }
  pub fn viaRc(self &Rc[Node]) i64 { self.n; }
}

struct Other {
  m i64;

  pub fn mine(self &Uni[Other]) i64 { self.m; }
  pub fn notMine(self &Uni[Node]) i64 { 0i64; }   //~ ErrorInvType:7 "self parameter for a method must match, or be a reference to, its type"
}

fn wrongKind(r Rc[Node], s Uni[Node], v &Node) {
  imm a = r.viaUni();                             //~ ErrorNoCandidate:12 "No method declared by `viaUni` accepts the call's arguments"
  imm b = s.viaRc();                             //~ ErrorNoCandidate:12 "No method declared by `viaRc` accepts the call's arguments"
  imm c = v.viaUni();                             //~ ErrorNoCandidate:12 "No method declared by `viaUni` accepts the call's arguments"
}

fn fine(s Uni[Node]) {
  imm a = s.viaUni();
}
