// 'as' to a struct that holds a reference from a number is refused: a number
// would forge the reference, the address 0xDEADBEEF00 read as a &i32. Holder is
// one reference, eight bytes, the size of the u64.

mod typemgmt_typecheck_as_struct_ref;

struct Holder {
  r: &i32;
}

fn forge() Holder {
  0xDEADBEEF00u64 as Holder    //~ ErrorAsTarget:3 "`as` may not make Holder from u64"
}
