// Branches with no type in common are refused whatever the callee wants of
// them: a float and a string literal meet in no type, so an operator's operand
// and a generic's argument fail as an overload set's does
// (typemgmt_typecheck_meet).

mod typemgmt_callee_first_refuse;

fn id[T](x: T) T {
  x
}

fn noCommonType(c: bool) {
  var w: i64 = 1;
  let a = w + (if c {2.5} else {"a"});       //~ ErrorInvType:22 "Expression does not match expected type"
                                             //~^ ErrorInvType:33 "Expression does not match expected type"
  let b = id(if c {2.5} else {"a"});         //~ ErrorInvType:30 "Branch's expression type inconsistent with other branches"
}
