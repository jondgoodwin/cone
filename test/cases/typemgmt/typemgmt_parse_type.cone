// Every place the grammar requires a type and none is written. The parser
// reports each one just after the token that asked for it, naming that token.
// Until it did, the missing type silently became the unknown type, and 'as'
// and 'into' surfaced it at type check as a size or conversion complaint, the
// 'into' one located at a phantom 'init:1:1'.
//
// The casts are this group's own. The other sites share the one helper that
// requires the type, parseTypeReq, so they sit beside them: a change to what
// it reports is read against all of them at once.

mod typemgmt_parse_type;

fn casts() {
  imm a = 3 as;                        //~ ErrorNoType:15 "Expected a type after 'as'"
  imm b = 3 into;                      //~ ErrorNoType:17 "Expected a type after 'into'"
  imm c = 3 as i64 into;               //~ ErrorNoType:24 "Expected a type after 'into'"
}

typedef Missing;                       //~ ErrorNoType:16 "Expected a type after the typedef's name"

fn isTest(x i32) Bool {
  x is;                                //~ ErrorNoType:7 "Expected a type after 'is'"
}

enum Suit {
  Clubs, Diamonds;
}

fn caseIs(s Suit) i32 {
  match s {
    case is {1;}                       //~ ErrorNoType:12 "Expected a type after 'is'"
    else {2;}
  }
}

fn twoResults() i32, {                 //~ ErrorNoType:21 "Expected a type after ','"
  1;
}

trait Shown { }

fn shown[T Shown +](x T) { }           //~ ErrorNoType:19 "Expected a type after '+'"

trait Holds[T] { }

fn held[T](x T) where T is Holds[i32,] { }   //~ ErrorNoType:38 "Expected a type after ','"
