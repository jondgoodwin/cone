// What a number literal with no suffix cannot be, where it takes its type from
// its place, its operand or the branches beside it (typemgmt_floatlit has what
// it can be).
//
// A float literal becomes an f32 only if its value fits one; a float literal is
// never an integer, so a float beside integers, or into an integer place, is a
// mismatch; an integer literal, or an expression made only of integer literals,
// is refused where its value does not fit the integer type that is given it,
// whatever it was computed from; and the branches of an 'if' that are literals
// follow the branches that are not only when those are numbers of one type.
// Each case is in its own function, so that one refusal does not hide the next.
//
// The unannotated lines are the neighbours that must still compile.

mod typemgmt_typecheck_floatlit;

import stdio use *;

// An expression of integer literals meeting an overloaded call is the one literal it
// stands for, as '6' is: an integer for each integer and float type the call takes
fn ambiguousInOverload() {
  print <- 2 * 3;                    //~ ErrorAmbigCandidate "More than one method declared by `<-` accepts these arguments"
  print <- 2.0 * 3.0;
}

fn tooBigForF32() {
  let a: f32 = 1e39;                  //~ ErrorFloatRange "Float literal 1e+39 does not fit f32"
}

fn tooBigSumForF32() {
  let a: f32 = 3e38 + 3e38;           //~ ErrorFloatRange "does not fit f32"
}

fn floatIntoInteger() {
  let b: i32 = 1.5;                   //~ ErrorInvType
}

fn sumPastU8() {
  let c: u8 = 200 + 100;              //~ ErrorLitRange "The value 300 of this expression of literals does not fit u8"
}

fn productPastI8(n: i8) i8 {
  let d: i8 = 16 * 8;                 //~ ErrorLitRange "The value 128 of this expression of literals does not fit i8"
  d
}

fn floatSumIntoInteger() {
  let e: i32 = 1 + 2.5;               //~ ErrorInvType
}

fn floatBesideInteger(k: i32) i32 {
  let f = 1.5 + k;                   //~ ErrorNoCandidate "No method declared by `+` accepts the call's arguments"
  k
}

fn literalPastBranchType(c: bool, u: u8) {
  let g = if c { 300 } else { u };   //~ ErrorLitRange "Integer literal '300' does not fit u8"
}

fn floatBranchBesideInteger(c: bool, u: u8) {
  let h = if c { 2.5 } else { u };   //~ ErrorInvType "Branch's expression type inconsistent with other branches"
}

fn integerAndFloatBranches(c: bool) {
  let i = if c { 1.5 } else { 2 };   //~ ErrorInvType "Branch's expression type inconsistent with other branches"
}

fn elementsThatDiffer(u: u8, f: f32) {
  let l = [1.5, 2];                  //~ ErrorBadArray "Inconsistent type of array literal value"
  let m = [2.5, u];                  //~ ErrorBadArray "Inconsistent type of array literal value"
  let n = [1.5, 2.5, f];
  let o = [1, 2, u];
}

fn branchesThatDiffer(c: bool, a: f32, b: f64) {
  let j = if c { 1.5 } else { a };
  let k = if c { b } else { a };
}

fn neighbours(c: bool, u: u8, f: f32) {
  let a: u8 = 100 + 100;
  let b = if c { 255 } else { u };
  let d: f32 = 3e38;
  let e = if c { 1.5 } else { f };
}
