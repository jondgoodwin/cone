// 'x as T' is refused at the instance where T is a char or a struct, which is
// where the type is known, and accepted where T is a number of the same size, as
// 'as' stays for now. The error stands at the cast, with the instantiating call
// named below it.

mod typemgmt_typecheck_as_generic;

struct Secret {
  v: u32;
}

fn bits[T](x: u32) T {
  x as T    //~ ErrorAsTarget:3 "`as` may not make a char from u32"
            //~^ ErrorAsTarget:3 "`as` may not make Secret from u32"
}

fn asNumber() i32 {
  bits[i32](5u32)
}

fn asChar() char {
  bits[char](5u32)
}

fn asSecret() Secret {
  bits[Secret](5u32)
}
