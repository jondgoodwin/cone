// 'as' to a char from a number of the same size is refused: a char is a code
// point, and 0xFFFFFFFF is none. The message names char.from, the conversion
// that is spelled for the purpose today.

mod typemgmt_typecheck_as_char_u32;

fn forge() char {
  0xFFFFFFFFu32 as char    //~ ErrorAsTarget:3 "`as` may not make a char from u32"
}
