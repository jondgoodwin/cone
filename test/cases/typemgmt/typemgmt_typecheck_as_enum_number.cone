// 'as' to an enum from a number is refused: an enum's value names a variant by
// its tag, and a number that merely has the same size could name none. 200u8 is
// the size of Color (one byte), and would be a tag no variant has. Only a
// coercion makes an enum by 'as', a variant as its enum (typemgmt_as_variant_enum).

mod typemgmt_typecheck_as_enum_number;

enum Color { Red, Green, Blue }

fn forge() Color {
  200u8 as Color    //~ ErrorAsTarget:3 "`as` may not make Color from u8"
}
