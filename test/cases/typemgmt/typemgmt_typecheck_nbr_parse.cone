// A number type's 'parse' and 'tryFrom' given what they do not take: none or
// more than one argument, no call at all, text for a conversion and a number
// for text. The first four are the compiler's own diagnostics; the last two are
// the generic functions it rewrites to refusing the argument.
//
// bool and char are no quantities and have neither method.

mod typemgmt_typecheck_nbr_parse;

fn none() {
  let a = i32.parse();            //~ ErrorNbrParse "reads one text"
  let b = u8.tryFrom();           //~ ErrorNbrTryFrom "converts one number"
}

fn many() {
  let a = i64.parse("1", "2");    //~ ErrorNbrParse "reads one text"
  let b = f32.tryFrom(1, 2);      //~ ErrorNbrTryFrom "converts one number"
}

fn nameless() {
  let f = u64.parse;              //~ ErrorNbrParse "reads one text"
}

fn wrongArgument() {
  let a = i32.parse(5);           //~ ErrorInvType "declared parameter"
  let b = u8.tryFrom("7");        //~ ErrorWhereUnmet "requires S is Numeric"
}

fn main() {}
