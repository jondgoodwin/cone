// A bool is not a number, so it coerces implicitly to none.
//
// bool is a 1-bit unsigned to the compiler, and an unsigned of fewer bits
// coerces to a wider one, so 'imm x usize = true' and indexing by a bool used
// to compile, a bool reading as 0 or 1 wherever a number was wanted. The type
// safety rules (reftypesafe.html, "Implicit Coercion") name only the other
// direction, a number to bool through isTrue. A bool converts to a number only
// explicitly, 'T.from(b)', which typemgmt_bool_number runs in each position
// refused here.
//
// Type-check stage only. Each position is a different caller of the one
// coercion, so each is shown: an initializer, an assignment, an argument, a
// return, a construction's field, an index into an array, into a pointer and
// through a struct's '[]', an operand of an arithmetic operator and of a
// comparison, a global, and the
// unsigned, signed and float targets. Where no type is wanted, a branch of
// each meets in no type at all.

mod typemgmt_typecheck_boolnbr;

struct Counted {
  pub n usize;

  pub fn `[]`(self, index usize) usize { n + index; }
}

fn wantUsize(n usize) usize {
  n;
}

imm globalCount u8 = true;          //~ ErrorBoolNotNbr:22 "A bool is not a number, and u8 is wanted here"

fn initializer(b bool) {
  imm x usize = b;                  //~ ErrorBoolNotNbr:17 "Convert it explicitly, 'usize.from(b)'"
  imm lit u64 = true;               //~ ErrorBoolNotNbr:17 "and u64 is wanted here"
}

fn assignment(b bool) {
  mut n u32 = 0u32;
  n = b;                            //~ ErrorBoolNotNbr:7 "and u32 is wanted here"
}

fn argument(b bool) {
  wantUsize(b);                     //~ ErrorBoolNotNbr:13 "and usize is wanted here"
}

fn returned(b bool) u16 {
  return b;                         //~ ErrorBoolNotNbr:10 "and u16 is wanted here"
}

fn constructed(b bool) {
  imm c = new Counted(n: b);        //~ ErrorBoolNotNbr:26 "and usize is wanted here"
}

fn indexed(b bool, p *i32) {
  imm cells Array[i32, 2] = [10, 20];
  imm a = cells[b];                 //~ ErrorBoolNotNbr:17 "and usize is wanted here"
  imm q = p[b];                     //~ ErrorBoolNotNbr:13 "is wanted here"
  imm c = new Counted(n: 1usize);
  imm m = c[b];                     //~ ErrorBoolNotNbr:13 "and usize is wanted here"
}

fn arithmetic(b bool) {
  mut n usize = 1usize;
  imm sum = n + b;                  //~ ErrorBoolNotNbr:17 "and usize is wanted here"
  n += b;                           //~ ErrorBoolNotNbr:8 "and usize is wanted here"
  imm same = 1u8 == b;              //~ ErrorBoolNotNbr:21 "and u8 is wanted here"
}

fn signedAndFloat(b bool) {
  imm i i64 = b;                    //~ ErrorBoolNotNbr:15 "and i64 is wanted here"
  imm f f64 = b;                    //~ ErrorBoolNotNbr:15 "and f64 is wanted here"
}

fn branches(c bool, b bool) {
  imm m = if c {b;} else {1u8;};    //~ ErrorInvType:26 "Branch's expression type inconsistent with other branches"
}
