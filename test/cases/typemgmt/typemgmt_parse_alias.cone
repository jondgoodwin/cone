// The alias statement at the parse stage: the retired 'typedef', and an
// 'alias' with its '=' left out.
//
// 'typedef' is retired: an alias is declared 'alias Name = type;'. It stays a
// keyword so that it can be refused. Released to an identifier, 'typedef Count
// i64;' would be two names and a type at module scale, and the report would be
// about none of what the author wrote. Each statement is reported once, at the
// keyword, whatever follows it -- with 'pub' before it, with an '=' written, or
// with a type running over lines -- and read through, so that the declarations
// after it parse as written.
//
// An 'alias' with no '=' is reported where the '=' belongs, after the name, and
// its type is still read, so the statement ends where it was written.
//
// Parse stage: nothing is built for any of them, so nothing here is name
// resolved.

mod typemgmt_parse_alias;

typedef Count i64;                     //~ ErrorTypedef:1 "'typedef' is retired: an alias is declared 'alias Name = type;'"
pub typedef Shared &i32;               //~ ErrorTypedef:5 "'typedef' is retired"
typedef Written = i64;                 //~ ErrorTypedef:1 "'typedef' is retired"
typedef Callback &fn(a i32,            //~ ErrorTypedef:1 "'typedef' is retired"
                     b i32) i32;

alias Plain i64;                       //~ ErrorAliasEq:12 "Expected '=' after the alias's name"

// Read as written after every refusal above
alias Kept = i64;

fn kept() Kept {
  1;
}
