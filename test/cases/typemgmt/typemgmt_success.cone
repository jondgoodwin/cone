// Where a value changes type: what the compiler will do implicitly, what it
// makes you ask for, and what arithmetic each one actually performs.
//
// The three capabilities are distinct and are established separately here.
// Coercion is implicit and only ever widens within one kind of number.
// Conversion, written 'Type[value]' or 'value into Type', constructs the
// closest value in the target type and may lose information. Reinterpretation,
// written 'value as Type', keeps the bits and changes only how they are read.
//
// Every result is printed, because a conversion that compiles is not a
// conversion that computes the right value: truncation direction, narrowing
// wrap-around and two's-complement reinterpretation are all invisible to the
// type checker and all easy to get wrong in code generation.
//
// 'core' owns the number types themselves, so nothing here exists to show that
// i32 has a range.
//
// The fourth capability, 'typedef', is the absence of a change of type: the
// alias and the type it names are one type, so a value crosses between them
// with nothing generated for the crossing. It is established last, because what
// makes it an alias rather than a new type is that the coercions and
// conversions above apply to it unchanged.

mod typemgmt_success;

import stdio use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn showU(label &[]u8, n u64) {
  printStr(label);
  printStr(" = ");
  printUInt(n);
  printStr("\n");
}

fn showF(label &[]u8, n f64) {
  printStr(label);
  printStr(" = ");
  printFloat(n);
  printStr("\n");
}

fn showB(label &[]u8, b Bool) {
  show(label, if b {1;} else {0;});
}

fn twice(n i32) i32 {
  n * 2;
}

// -------- explicit conversion, the constructor form --------

// A global's initializer must be a literal, so a conversion can only reach one
// by assignment. The receiving end of that assignment is tested below.
mut total i32 = 0;

fn conversions() {
  // A float converts to an integer by truncating toward zero, in both
  // directions -- not by rounding and not by flooring
  show("f64-to-i32", i32[2.75]);
  show("f64-to-i32-negative", i32[-2.75]);

  // An integer converts to a float exactly, while it still fits. The source is
  // a typed variable rather than a literal, because a literal would have
  // coerced to a float on its own and would establish nothing about crossing
  // between the integer and float kinds -- which coercion refuses.
  mut count i32 = 7;
  showF("i32-to-f64", f64[count]);
  showF("i32-to-f32", f64[f32[count]]);

  // Narrowing keeps the low bits: 300 is 0x12C, and an i8 keeps 0x2C
  mut wide i64 = 300i64;
  show("i64-to-i8-wraps", i8[wide]);

  // Crossing between signed and unsigned reinterprets the two's-complement
  // encoding rather than clamping or raising
  mut minusOne i32 = -1;
  showU("i32-to-u8-negative", u8[minusOne]);
  showU("i32-to-u32-negative", u32[minusOne]);

  // f64 to f32 keeps only what f32 can represent. 16777217 is 2^24 + 1, the
  // smallest integer an f32 cannot hold, so a round trip through f32 does not
  // return the value that went in, while a round trip through f64 does. The
  // 'd' suffix matters: an unsuffixed float literal is f32, so writing the
  // value without it would lose the precision before any conversion did.
  mut exact f64 = 16777217.0d;
  show("f64-round-trip", i32[exact]);
  show("f64-to-f32-loses-precision", i32[f32[exact]]);

  // The same distinction seen from the literal's side
  mut unsuffixed f64 = 16777217.0;
  show("unsuffixed-float-literal-is-f32", i32[unsuffixed]);
  mut suffixed f64 = 16777217.0d;
  show("suffixed-float-literal-is-f64", i32[suffixed]);

  // Bool converts to and from the number types
  mut flag Bool = true;
  show("bool-to-i32", i32[flag]);
  if Bool[5] {
    show("nonzero-to-bool", 1);
  }
  if not Bool[0] {
    show("zero-to-bool", 0);
  }

  // The operand is an arbitrary expression, not just a literal
  showF("converted-call-result", f64[twice(3)]);

  // A conversion is an ordinary expression on the right of an assignment
  total = i32[2.3e1];
  show("assigned-conversion", total);
}

// -------- explicit conversion, the 'into' form --------

fn intoForm() {
  // 'into' converts exactly as the constructor form does
  showF("into-f64", 3 into f64);
  show("into-i32", 2.75 into i32);

  // Including the coercion to Bool that a condition would have done anyway
  mut n i32 = 5;
  if n into Bool {
    show("into-bool", 1);
  }
}

// -------- converting into a struct, repeatedly --------

// A conversion whose target is a struct cannot be a bitcast -- LLVM does not
// bitcast an aggregate -- so it is done by storing into stack space and loading
// it back under the other type. That space was allocated where the conversion
// stands, which inside a loop is a fresh frame slot every iteration that
// mem2reg cannot promote away. The loop below overflowed the stack; it is long
// enough to do so at the 1MB Windows default and short enough to be free.
//
// It reads the enum's common field back so the conversion is not dead, and
// 'enum' owns the enum itself -- what is claimed here is only that the
// conversion happens on the stack the function already has.
enum Extense {
  pub fld i32;

  struct Variant1 {
    pub nbr i32;
  }

  struct Variant2 {
    pub x i32;
    pub y i32;
  }
}
use Extense;

fn intoStructInLoop() {
  mut e Extense = Variant2[20, 3, 4];
  mut i = 0;
  while i < 400000 {
    mut one = Variant1[10, i];
    e = one into Extense;
    i = i + 1;
  }
  show("into-struct-in-loop", e.fld);
}

// -------- converting a reference or a pointer to Bool --------

fn referenceToBool() {
  // A reference and a pointer each convert to Bool, and the two forms of
  // explicit conversion agree about it. 'ref' owns references and 'safety'
  // owns pointers; what is claimed here is only that the conversion exists in
  // both spellings and produces the same value.
  mut n i32 = 7;
  imm r &i32 = &n;
  imm p *i32 = &n;
  showB("ref-to-bool", Bool[r]);
  showB("ptr-to-bool", Bool[p]);
  showB("ref-into-bool", r into Bool);
  showB("ptr-into-bool", p into Bool);

  // The conversion asks whether the reference is non-null, not whether what it
  // addresses is non-zero. A reference to a zero is the case that tells those
  // two readings apart, and it is true. The compiler offers no way to spell a
  // null reference or pointer, so the false side cannot be reached from here.
  mut zero i32 = 0;
  imm rz &i32 = &zero;
  imm pz *i32 = &zero;
  showB("ref-to-zero-is-true", Bool[rz]);
  showB("ptr-to-zero-is-true", Bool[pz]);
}

// -------- reinterpretation --------

// Two spellings of the same eight bytes, for the struct half of 'as'
struct Halves {
  pub lo i32;
  pub hi i32;
}

struct Whole {
  pub n i64;
}

fn reinterpretation() {
  // 'as' does not convert: the bits are unchanged and only their reading
  // changes. 1.0f32 is 0x3F800000, which read as an i32 is 1065353216.
  mut one f32 = 1.0;
  show("f32-bits-as-i32", one as i32);

  // The same bits an i32 reads as -1 an u32 reads as 4294967295
  mut minusOne i32 = -1;
  showU("i32-bits-as-u32", minusOne as u32);

  // A struct target is allowed when the sizes agree, which is the rule
  // reftrust.html states. Two i32 fields and one i64 field occupy the same
  // eight bytes, so the halves of the i64 are the two i32s.
  // typemgmt_genllvm_recast holds the sizes that do not agree.
  mut halves = Halves[1, 2];
  imm whole = halves as Whole;
  show("struct-recast-same-size", if whole.n == 0i64 {0;} else {1;});

  // ... and back again, which is what makes the reinterpretation faithful
  imm back = whole as Halves;
  show("struct-recast-round-trip-low", back.lo);
  show("struct-recast-round-trip-high", back.hi);

  // Casts chain left to right, each applying to the one before it, and 'as'
  // and 'into' chain with each other. A second cast did not parse at all. The
  // bits -1 has as an i32 read as a u32 are 4294967295, and that value
  // converted to an i64 stays 4294967295; converted first, -1 is an i64 whose
  // bits read as a u64 are all ones.
  show("chained-as-then-into", minusOne as u32 into i64);
  showU("chained-into-then-as", minusOne into i64 as u64);
  // A reference reaches an address only through a pointer
  imm addr = &minusOne as *i32 as usize;
  imm ptr = &minusOne as *i32;
  showB("chained-as-through-pointer", addr == ptr as usize);
}

// -------- implicit coercion --------

// Coercion runs wherever a value meets an expected type: an argument, an
// initializer, an assignment or a return. Only the argument case is shown for
// each rule, because it is one rule and one code path.
fn wantI64(n i64) i64 {
  n;
}

fn wantU64(n u64) u64 {
  n;
}

fn wantF64(n f64) f64 {
  n;
}

fn wantF32(n f32) f32 {
  n;
}

// Each returns an unsuffixed literal too wide for i32, so the return value is
// a position where the literal meets its type
fn fillI64() i64 {
  5000000000;
}

fn fillU64() u64 {
  18446744073709551615;
}

fn fillF64() f64 {
  5000000000;
}

fn fillF32() f32 {
  5000000000;
}

// A struct literal's field is the last position where a literal meets its type
struct Span {
  pub big i64;
  pub wide f64;
}

// An unsuffixed float literal is an f32, and reaches an f64 by widening, as any
// f32 does. Widened, it is still a literal, so it may initialize what only a
// literal may: a global, a static, a parameter's default and a typed constant.
// 0.5 and -0.25 are exact in f32, so the values printed do not depend on the
// precision the literal is built at; 0.1 is not, and its global must hold what
// the same literal gives a local.
imm widenedGlobal f64 = 0.5;
mut widenedMutGlobal f64 = -0.25;
imm widenedTenth f64 = 0.1;
const WidenedConst f64 = 0.5;

fn widenedStatic() f64 {
  static s f64 = 0.5;
  s;
}

fn widenedDefault(x f64 = -0.25) f64 {
  x;
}

// A named constant stands for its value. Its use is typed as the constant is --
// an untyped integer constant is an i32 -- and reaches a wider number of its
// kind by the same widening, folded into a literal of that type, so a constant
// may initialize what only a literal may, as its literal could. The constants at
// the edges of their own types are the ones a fold extending the wrong way
// would move: a negative i8 must stay negative, and a u8 of all ones must stay
// 255.
const Five = 5;
const Half = 0.5;
const LowestByte i8 = -128;
const AllOnesByte u8 = -1;
const FiveAgain = Five;
const FiveWide i64 = Five;
imm constGlobal i64 = Five;
imm constFloatGlobal f64 = Half;
imm constLowest i64 = LowestByte;
imm constAllOnes u32 = AllOnesByte;
imm constOfConst i64 = FiveAgain;

fn constStatic() i64 {
  static s i64 = Five;
  s;
}

fn constDefault(x i64 = LowestByte) i64 {
  x;
}

fn coercions() {
  // A narrower number widens into a wider one of the same kind, silently
  mut small i16 = 300;
  show("signed-widens", wantI64(small));
  mut byteVal u8 = 200;
  showU("unsigned-widens", wantU64(byteVal));
  mut single f32 = 1.5;
  showF("float-widens", wantF64(single));

  // An unsuffixed integer literal has no settled type yet, so it takes on
  // whatever number type it meets -- unlike a typed value, which would need a
  // conversion to cross between integer and float or between signed and
  // unsigned
  mut asByte u8 = 5;
  mut asLong i64 = 5;
  mut asSingle f32 = 5;
  mut asDouble f64 = 5;
  showU("literal-to-u8", asByte);
  show("literal-to-i64", asLong);
  showF("literal-to-f32", asSingle);
  showF("literal-to-f64", asDouble);

  // Taking on the type means being built at that width. A literal that does not
  // fit the 32-bit default is the case that tells the two apart: converting from
  // the default would drop every bit above the low 32 and then widen the
  // remainder back, which is how i64's maximum came out as -1 and its minimum
  // as 0. None of these carries a suffix.
  mut widest i64 = 9223372036854775807;
  show("literal-fills-i64", widest);
  mut lowest i64 = -9223372036854775808;
  show("literal-fills-i64-negative", lowest);
  mut unsignedWidest u64 = 18446744073709551615;
  showU("literal-fills-u64", unsignedWidest);
  mut aboveI32 i64 = 5000000000;
  show("literal-above-i32-range", aboveI32);

  // The width is adopted wherever the literal meets its type, not only in an
  // initializer. A call's argument is the position that used to differ: it is
  // type checked before its callee is resolved, so the parameter type reaches
  // it by coercion, and the coercion converted from the 32-bit default.
  show("literal-fills-i64-argument", wantI64(5000000000));
  showU("literal-fills-u64-argument", wantU64(18446744073709551615));
  show("literal-fills-i64-return", fillI64());
  showU("literal-fills-u64-return", fillU64());
  aboveI32 = 6000000000;
  show("literal-fills-i64-assignment", aboveI32);
  imm span = Span[5000000000, 5000000000];
  show("literal-fills-i64-field", span.big);

  // A float target is the same rule: the literal becomes a float of the whole
  // value, not a float of its low 32 bits. Each is read back through i64 so the
  // value printed is exact; 5000000000 is 9765625 * 2^9 and 6000000000 is
  // 5859375 * 2^10, both of which f32 holds exactly.
  mut asWideDouble f64 = 5000000000;
  show("literal-fills-f64", i64[asWideDouble]);
  mut asWideSingle f32 = 5000000000;
  show("literal-fills-f32", i64[asWideSingle]);
  asWideDouble = 6000000000;
  show("literal-fills-f64-assignment", i64[asWideDouble]);
  asWideSingle = 6000000000;
  show("literal-fills-f32-assignment", i64[asWideSingle]);
  show("literal-fills-f64-argument", i64[wantF64(5000000000)]);
  show("literal-fills-f32-argument", i64[wantF32(5000000000)]);
  show("literal-fills-f64-return", i64[fillF64()]);
  show("literal-fills-f32-return", i64[fillF32()]);
  show("literal-fills-f64-field", i64[span.wide]);
  mut negativeDouble f64 = -5000000000;
  show("literal-fills-f64-negative", i64[negativeDouble]);

  // A literal must fit the type it takes (typemgmt_typecheck_litrange holds the
  // values that do not), and these are the ends that do. A minus is folded into
  // the literal and recorded, so i8 takes -128 but not 128; an unsigned type
  // takes a negated literal in its own width, as a suffixed one does; and u64's
  // maximum, which has the same bits as -1, reaches a float as itself.
  mut byteTop u8 = 255;
  showU("literal-fills-u8", byteTop);
  mut byteBottom i8 = -128;
  show("literal-fills-i8-negative", byteBottom);
  mut allOnes u32 = 0xFFFFFFFF;
  showU("literal-fills-u32-hex", allOnes);
  mut negatedByte u8 = -1;
  showU("literal-negated-into-u8", negatedByte);
  mut beyondI64 f64 = 18446744073709551615;
  showF("literal-fills-f64-beyond-i64", beyondI64);

  showF("float-literal-widened-global", widenedGlobal);
  showF("float-literal-widened-mut-global", widenedMutGlobal);
  showF("float-literal-widened-const", WidenedConst);
  showF("float-literal-widened-static", widenedStatic());
  showF("float-literal-widened-default", widenedDefault());
  imm localTenth f64 = 0.1;
  showB("float-literal-global-agrees-with-local", widenedTenth == localTenth);

  show("const-widened-global", constGlobal);
  showF("const-widened-float-global", constFloatGlobal);
  show("const-widened-negative-global", constLowest);
  showU("const-widened-unsigned-global", constAllOnes);
  show("const-of-const-widened-global", constOfConst);
  show("const-widened-typed-const", FiveWide);
  show("const-widened-static", constStatic());
  show("const-widened-default", constDefault());
  imm localLowest i64 = LowestByte;
  showB("const-global-agrees-with-local", constLowest == localLowest);

  // A number coerces to Bool in a condition, by way of its 'isTrue' method
  mut n i32 = 3;
  if n {
    show("number-coerces-to-bool", 1);
  }

  // An operator coerces its right operand to the left operand's type, so
  // mixed widths need no conversion written out in that direction. The other
  // direction is not symmetric and is in typemgmt_typecheck_meet.
  mut wide i64 = 100i64;
  show("right-operand-widens", wide + small);
  mut double f64 = 1.5d;
  showF("float-right-operand-widens", double + single);
}

// -------- an unsuffixed literal meeting Bool --------

// Bool is a 1-bit unsigned number type, so it is the one number type an
// unsuffixed integer literal must not be built at: its only values are true and
// false, and every other value reaches it through 'isTrue' -- non-zero is true.
// Built at Bool's width instead, the constant was masked to its low bit, and
// the positions that coerce disagreed with the positions that do not: 2 read as
// false in an initializer, an assignment, a return, 'not' and 'and', and as
// true as an argument, in a struct literal and in an 'if'. So every position is
// asserted here, and each with a value whose low bit is 0, because 1 and -1
// happen to survive the masking and would show nothing.

fn wantBool(b Bool) Bool {
  b;
}

fn fillBool() Bool {
  2;
}

struct Gauge {
  pub flag Bool;
}

fn literalToBool() {
  mut initialized Bool = 2;
  showB("literal-to-bool-initializer", initialized);
  mut assigned Bool = true;
  assigned = 2;
  showB("literal-to-bool-assignment", assigned);
  showB("literal-to-bool-argument", wantBool(2));
  showB("literal-to-bool-return", fillBool());
  imm gauge = Gauge[2];
  showB("literal-to-bool-field", gauge.flag);
  show("literal-to-bool-condition", if 2 {1;} else {0;});
  show("literal-to-bool-not", if not 2 {1;} else {0;});
  show("literal-to-bool-and", if 2 and 4 {1;} else {0;});
  show("literal-to-bool-or", if 0 or 2 {1;} else {0;});

  // Zero is the false end of the same rule, and a literal Bool is untouched by
  // it -- 'true' and 'false' carry Bool from the parser and were never untyped
  mut zeroed Bool = 0;
  showB("zero-literal-to-bool", zeroed);
  showB("zero-literal-to-bool-argument", wantBool(0));
  mut yes Bool = true;
  showB("true-stays-true", yes);
  mut no Bool = false;
  showB("false-stays-false", no);
}

// -------- branches agreeing on one type --------

fn branches() {
  // Two branches of different widths meet at the wider of the two, and the
  // narrower branch is coerced to it
  showF("float-branches-meet-at-f64", if true {5f;} else {7d;});
  showF("float-branches-else", if false {5f;} else {7d;});

  mut narrow i16 = 3;
  mut wide i64 = 4i64;
  show("int-branches-meet-at-i64", if true {narrow;} else {wide;});

  // Two variants of one enum meet at the enum, and a third value then meets
  // the type already reached rather than a sibling variant. That second step
  // used to fail: the meet widened to the enum and then compared the third
  // value against it, and an enum and a variant of it were not considered to
  // have a supertype. Two branches worked and three did not, so the count is the
  // whole point of these two lines. 'enum' owns enums; what is claimed here is
  // only that the type in common survives a third value.
  show("two-variants-meet-at-the-enum", sides(if true {Wide[1, 4];} else {Tall[2, 5];}));
  show("three-variants-still-meet", sides(if false {Wide[1, 4];} elif true {Tall[2, 5];} else {Wide[1, 6];}));

  // ... and the same through references, where the meet has no size to satisfy
  imm w = Wide[1, 7];
  imm t = Tall[2, 8];
  imm u = Wide[1, 9];
  show("three-references-meet", sidesRef(if false {&w;} elif true {&t;} else {&u;}));
}

// The enum the meet above settles on, and a reader of it. Both are here rather
// than in 'enum' because the subject is the meet, not the enum.
enum Boxy {
  pub kind i32;

  struct Wide {
    pub n i32;
  }

  struct Tall {
    pub n i32;
  }
}
use Boxy;

fn sides(b Boxy) i64 {
  i64[b.kind];
}

fn sidesRef(b &Boxy) i64 {
  i64[b.kind];
}

// -------- conversion where coercion cannot decide --------

fn pickInt overload pick(n i64) i64 {
  n * 2i64;
}

fn pickFloat overload pick(n f64) f64 {
  n * 3.0;
}

fn disambiguate() {
  // 'pick(3)' would be ambiguous: an unsuffixed literal is acceptable to both
  // candidates. Converting the argument settles its type and so settles which
  // candidate accepts the call.
  show("conversion-picks-int", pick(i64[3]));
  showF("conversion-picks-float", pick(f64[3]));
}

// -------- typedef, an alias rather than a change of type --------

typedef Count i64;
// An alias of an alias, so that resolution has to follow the whole chain rather
// than one link of it
typedef Tally Count;
typedef Ratio f64;

struct Reading {
  pub level i64;

  // A static function, reached by qualifying the type it is declared in -- and
  // by qualifying an alias of that type, below
  pub fn make(n i64) Reading {
    Reading[n];
  }
}

// An alias of a type that is not a number, named where a reference wants its
// referent
typedef ReadingRef &Reading;

// An alias of the struct itself, to be named as a type, to build a value in a
// literal, and to qualify the struct's own members. An alias is a binding rather
// than a type of its own, so a path's base is asked of the declaration at the
// end of the chain and 'Sample.make' walks Reading's namespace.
typedef Sample Reading;

// An alias of an array, to be indexed through a reference to it. This is the
// one position where the alias used not to be transparent: the index resolved
// the reference but read the tag off the pointee unresolved, so it matched
// neither the array arm nor the slice arm, left the index with no element type,
// and came out as a return-type mismatch on a function that is correct. 'array'
// owns arrays; what is established here is that naming one through an alias
// changes nothing about indexing it.
typedef Cells [3; i64];

// Each of the four positions below is a use of the alias as a type: a global, a
// parameter, a return type, and a local in the function further down.
mut recorded Count = 3i64;

fn bumped(n Count) Tally {
  // The aliased type's operators are reached through the alias, which has no
  // methods of its own
  n + 1i64;
}

fn levelOf(r ReadingRef) i64 {
  r.level;
}

fn levelOfSample(s Sample) i64 {
  s.level;
}

fn cellAt(c &Cells, i usize) i64 {
  c[i];
}

// An alias of a reference written above the struct it names, and taken as that
// struct's own 'self'. Reaching 'MarkRef' first checks the reference, which
// checks Mark from inside it, and Mark's method then holds a 'MarkRef' while the
// reference is still in flight. A reference is one pointer whatever it points
// at, so there is no cycle; it was once refused as one, and only in this order
// -- written below the struct, the same alias always compiled.
typedef MarkRef &Mark;

struct Mark {
  pub at i64;

  pub fn position(self MarkRef) i64 {at;}
}

fn typedefs() {
  mut running Count = 40i64;
  running = bumped(running);
  show("typedef-local", running);
  show("typedef-global", recorded);

  // Transparent in both directions: an i64 parameter takes a Count argument
  // with no conversion written, and the coercion rules above are the alias's
  // rules too, so a narrower number still widens into it
  show("typedef-passes-as-aliased-type", wantI64(running));
  mut narrow i16 = 12;
  mut widened Count = narrow;
  show("typedef-receives-coercion", widened);

  // A reference to the alias is a reference to the struct it names
  imm sample = Reading[9i64];
  show("typedef-struct-ref", levelOf(&sample));

  // An alias of a struct builds a value in a literal, and the value is the
  // struct's: a reference to it is a reference to the struct, and a parameter
  // declared with the alias takes a value built under the struct's own name
  imm viaAlias = Sample[4i64];
  show("typedef-struct-literal", levelOfSample(viaAlias));
  show("typedef-struct-literal-is-the-struct", levelOf(&viaAlias));
  show("typedef-struct-parameter-takes-struct", levelOfSample(sample));

  // An alias qualifies what it names: 'Sample.make' reaches the static function
  // 'Reading.make' declares, and the value it returns is the struct's
  imm made = Sample.make(7i64);
  show("typedef-alias-qualifies", levelOfSample(made));

  // An alias of a number converts in the constructor form as the number does,
  // truncating toward zero as i64 would
  show("typedef-number-literal", Count[3.7]);

  // And a reference to an aliased array indexes as the array it names. The
  // second index is what shows the element reached is the one meant rather than
  // a constant that happens to be right.
  mut cells Cells = [11i64, 22i64, 33i64];
  show("typedef-array-ref-index-first", cellAt(&cells, 0));
  show("typedef-array-ref-index-last", cellAt(&cells, 2));

  // Conversion targets the aliased type through the alias, and reads it back
  mut scaled Ratio = f64[running] / 2.0d;
  showF("typedef-in-conversion", scaled);

  imm mark = Mark[8i64];
  show("typedef-above-struct-self", (&mark).position());
}

fn main() i32 {
  conversions();
  intoForm();
  intoStructInLoop();
  referenceToBool();
  reinterpretation();
  coercions();
  literalToBool();
  branches();
  disambiguate();
  typedefs();
  0i32;
}
