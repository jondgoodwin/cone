// What an expression of integer literals with '|', '&', '^', '<<' or '>>' cannot be
// (typemgmt_litbits has what it can be): a value past the type it is given, a shift
// by a negative count or by 64 or more, and a complement, which has no value without
// a width and so stays refused where it is not typed (Row 762).

mod typemgmt_typecheck_litbits;

fn shiftPastU8() {
  let b: u8 = 1 << 8;                 //~ ErrorLitRange "The value 256 of this expression of literals does not fit u8"
}

fn orPastU8() {
  let c: u8 = 0x100 | 1;              //~ ErrorLitRange "does not fit u8"
}

fn negativeCount() {
  let d: i64 = 1 << -1;               //~ ErrorConstShift "not from 0 to 63"
}

fn pastWidth() {
  let e: i64 = 1 << 64;               //~ ErrorConstShift "not from 0 to 63"
}

fn pastRange() {
  let f: i64 = 3 << 63;               //~ ErrorConstShift "does not fit 64 bits"
}

fn complementStaysRefused() {
  let z: u64 = ~0;                    //~ ErrorInvType
}
