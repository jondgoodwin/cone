// 'as' from an enum to one of its variants is refused, the reverse of the
// coercion that makes it a recast: nothing checks which variant the value holds,
// so a Square read as a Circle would take its side for a radius. A pattern asks
// the question, and the message points to it. A variant as another variant is no
// coercion either.

mod typemgmt_typecheck_as_enum_variant;

enum Shape {
  struct Circle { pub r: i32; }
  struct Square { pub s: i32; }
}

fn downcast(s: Shape) Shape.Circle {
  s as Shape.Circle    //~ ErrorAsTarget:3 "`as` may not make Circle from the enum Shape"
}

fn sideways() Shape.Circle {
  Shape.Square(1) as Shape.Circle    //~ ErrorAsTarget:8 "`as` may not make Circle from Square"
}
