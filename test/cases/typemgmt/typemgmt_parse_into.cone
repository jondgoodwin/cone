// The retired 'into' operator. It did two jobs, and each has its replacement:
// a value converts with its type's method, 'u64.from(n)', and a reference
// narrows to a variant only where the variant the value holds is checked, by a
// 'match' or a bound 'if'.
//
// It stays a keyword so that it can be refused, once at each use, at the word,
// whatever stands before it and whatever type follows -- a number, bool, a
// reference to a variant, a generic's type parameter, or none -- and the type
// is read through, so that the rest of the expression parses as written.
//
// Parse stage: nothing is built for any of them, so nothing here is name
// resolved.

mod typemgmt_parse_into;

enum Shape {
  struct Circle {
    pub radius i32;
  }
  struct Rect {
    pub w i32;
    pub h i32;
  }
}
use Shape;

fn number(n i32) u64 {
  n into u64;                          //~ ErrorInto:5 "'into' is retired: a value converts with its type's method, 'T.from(x)'"
}

fn truth(n i32) bool {
  (n & 3) into bool;                   //~ ErrorInto:11 "'T.from(x)'"
}

fn radius(s Shape) i32 {
  imm c = &s into &Circle;             //~ ErrorInto:14 "a reference narrows to a variant with a check, by a 'match' or 'if imm x &Variant = &value'"
  c.radius;
}

fn convert[T](n i32) T {
  n into T;                            //~ ErrorInto:5 "'into' is retired"
}

fn chained(n i32) u64 {
  n as u32 into u64 + 1;               //~ ErrorInto:12 "'into' is retired"
}

fn noType(n i32) {
  imm m = n into;                      //~ ErrorInto:13 "'into' is retired"
}

// Read as written after every refusal above
fn kept(n i32) u64 {
  u64.from(n);
}
