// What 'as' to an enum or struct still does: a coercion that changes only the type.
// A variant as its enum, by value, and a type as itself. Every other 'as' to a
// struct, an enum or a char is refused (the typemgmt_typecheck_as_* scenarios).
// 'x as T' for a generic T is checked where T is known: a number of the same
// size is accepted for now.

mod typemgmt_as_variant_enum;

import stdio use *;

enum Shape {
  struct Circle { pub r: i32; }
  struct Square { pub s: i32; }
}

struct P {
  pub x: i32;
}

fn show(label: &str, n: i32) {
  printStr(label);
  printStr(" = ");
  printInt(i64.from(n));
  printStr("\n");
}

fn side(s: Shape) i32 {
  match s {
    case let Shape.Circle(c) {c.r}
    case let Shape.Square(q) {100 + q.s}
  }
}

fn bits[T](x: u32) T {
  x as T
}

fn main() i32 {
  // A variant held in a variable, and a variant just made, read as the enum
  let c = Shape.Circle(7);
  show("circle-as-enum", side(c as Shape));
  show("square-made-as-enum", side(Shape.Square(5) as Shape));
  // A type as itself
  let p = P(3);
  let q = p as P;
  show("struct-as-itself", q.x);
  // A number as a number of the same size, through a generic
  show("generic-number", bits[i32](9u32));
  0
}
