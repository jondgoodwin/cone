// An integer literal whose value does not fit the type it is given.
//
// A literal's value was built at the width of its type and every bit above it
// silently dropped: '300u8' and 'mut n u8 = 300' stored 44, and
// 'mut n i32 = 3000000000' stored -1294967296. Each is now refused, pointed at
// the literal, whether the type comes from its suffix or from where it stands:
// an initializer, an assignment, an argument, a return value, a struct field,
// an 'if' whose expected type reaches its branches, a global, and a constant
// nothing uses. An array literal's elements are not given the type the array
// is wanted as, so they reach a narrow type only by suffix, list and fill form
// alike.
//
// A minus is folded into the literal it precedes, and the literal records it,
// so the digits written are what is measured: a signed type takes one more
// negated than not ('-128i8' fits, '128i8' does not), and a minus applied
// twice is a positive value again.
//
// The unannotated lines are the neighbours that must still compile: each
// type's two ends. The values they hold are printed by lexical_literals and
// typemgmt_success. A literal nothing gives a type is checked against its i32
// default in typemgmt_genllvm_litrange.

mod typemgmt_typecheck_litrange;

struct Byte {
  pub b: u8;
}

fn wantU8(n: u8) u8 {
  n
}

fn fillU8() u8 {
  256                            //~ ErrorLitRange
}

let global: u8 = 300;              //~ ErrorLitRange
const Limit: u8 = 300;             //~ ErrorLitRange

fn suffixes() {
  let a = 256u8;                  //~ ErrorLitRange "'256u8' does not fit u8, whose values run from 0 to 255"
  let b = 128i8;                  //~ ErrorLitRange
  let c = -129i8;                 //~ ErrorLitRange "'-129i8' does not fit i8, whose values run from -128 to 127"
  let d = - -128i8;               //~ ErrorLitRange "'128i8'"
  let e = -256u8;                 //~ ErrorLitRange
  let f = 65536u16;               //~ ErrorLitRange
  let g = -32769i16;              //~ ErrorLitRange
  let h = 4294967296u32;          //~ ErrorLitRange
  let i = 2147483648i32;          //~ ErrorLitRange
  let j = 9223372036854775808i64; //~ ErrorLitRange
  let k = [256u8, 1u8];           //~ ErrorLitRange
  let l = new Array[u8, 3] <- fill 256u8;   //~ ErrorLitRange

  // Still compiled: each type's two ends
  let a1 = 255u8;
  let b1 = 127i8;
  let c1 = -128i8;
  let e1 = -1u8;
  let j1 = -9223372036854775808i64;
  let u1 = 18446744073709551615u64;
}

fn positions(v: bool) {
  var b: u8 = 256;                 //~ ErrorLitRange
  let c: i8 = -129;                //~ ErrorLitRange "'-129' does not fit i8"
  b = 300;                        //~ ErrorLitRange
  wantU8(256);                    //~ ErrorLitRange
  let s = new Byte(256);          //~ ErrorLitRange
  let t: u8 = if v {256} else {1}; //~ ErrorLitRange
  let d: i32 = 3000000000;         //~ ErrorLitRange
  let e: i64 = 9223372036854775808; //~ ErrorLitRange
  let f: i64 = 18446744073709551615; //~ ErrorLitRange "'18446744073709551615' does not fit i64"
  let g: i64 = -9223372036854775809; //~ ErrorLitRange

  // Still compiled: each type's two ends
  var b1: u8 = 255;
  let c1: i8 = -128;
  let d1: i32 = -2147483648;
  let e1: i64 = -9223372036854775808;
  let f1: u64 = 18446744073709551615;
}

// Binary and octal literals are measured as hexadecimal ones are: by the digits
// written, against the type the suffix or the position gives them.
fn radixes() {
  let a = 0b1_0000_0000u8;        //~ ErrorLitRange "'0b1_0000_0000u8' does not fit u8"
  let b = 0o400u8;                //~ ErrorLitRange "'0o400u8' does not fit u8"
  let c = 0b1000_0000i8;          //~ ErrorLitRange "'0b1000_0000i8' does not fit i8"
  let d = -0b1000_0001i8;         //~ ErrorLitRange "'-0b1000_0001i8' does not fit i8"
  var e: u8 = 0b1_0000_0000;       //~ ErrorLitRange
  let f: i8 = 0o200;               //~ ErrorLitRange
  wantU8(0o400);                  //~ ErrorLitRange

  // Still compiled: each type's two ends
  let a1 = 0b1111_1111u8;
  let b1 = 0o377u8;
  let c1 = 0b111_1111i8;
  let d1 = -0b1000_0000i8;
  var e1: u8 = 0o377;
  let f1: u64 = 0b1111111111111111111111111111111111111111111111111111111111111111;
}
