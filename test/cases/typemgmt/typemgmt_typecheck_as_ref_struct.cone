// 'as' to a struct from a reference is refused: it would read the address as
// the struct's bytes, and a struct of a pointer's size would take it.

mod typemgmt_typecheck_as_ref_struct;

struct P {
  x: i32;
}

struct Holder {
  r: &i32;
}

fn byValue(p: &P) P {
  p as P    //~ ErrorAsTarget:3 "`as` may not make P from a reference"
}

fn address(p: &P) Holder {
  p as Holder    //~ ErrorAsTarget:3 "`as` may not make Holder from a reference"
}
