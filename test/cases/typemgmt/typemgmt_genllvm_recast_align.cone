// A reinterpretation goes through a stack slot, stored as the source's type and
// loaded as the target's (genlRecast). The load is aligned as the target is, so the
// slot must be aligned for the target as well as the source: eight bytes that are
// an array of u8 (alignment 1) read as a struct holding a u64 (alignment 8) sit in
// a slot of alignment 8. A slot aligned for the source alone made a load that
// is misaligned for the vector payload of an enum (vector_success's Shape), where
// the hardware faults on it; with no vector in it, the slot's alignment in the IR
// is what shows the difference.

mod typemgmt_genllvm_recast_align;

struct Word {
  pub x: u64;
}

pub fn asWord(a: Array[u8, 8]) u64 {
  let w = a as Word;
  w.x
}
