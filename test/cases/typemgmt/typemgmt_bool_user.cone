// A struct with 'isTrue' is tested through it in an 'if' condition, a 'while'
// condition and under '!', the three places the syntax asks a truth question. Every
// other place wants a bool (typemgmt_bool_refused).

mod typemgmt_bool_user;

import stdio use *;

struct Gate {
  pub open: i32;
  pub fn isTrue(self: &) bool { open != 0 }
}

fn main() {
  let shut = Gate(0);
  let wide = Gate(2);

  if wide { printStr("if wide: yes\n"); }
  if shut { printStr("if shut: yes\n"); } else { printStr("if shut: no\n"); }

  if !shut { printStr("not shut: yes\n"); }
  if !wide { printStr("not wide: yes\n"); } else { printStr("not wide: no\n"); }

  var laps: i32 = 0;
  var door = Gate(3);
  while door {
    door = Gate(door.open - 1);
    laps = laps + 1;
  }
  printStr("while laps = ");
  printInt(i64.from(laps));
  printStr("\n");
}
