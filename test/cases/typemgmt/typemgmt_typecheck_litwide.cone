// What an expression of integer literals cannot be once it is worked out across every value
// i64 and u64 hold (typemgmt_litwide has what it can be): a value i64 does not hold into an
// i64, and a value below i64's minimum or above u64's maximum, for + - * and unary minus as
// for a shift (Row 764).

mod typemgmt_typecheck_litwide;

fn shiftIntoI64() {
  let a: i64 = 1 << 63;                          //~ ErrorLitRange "The value 9223372036854775808 of this expression of literals does not fit i64"
}

fn sumIntoI64() {
  let b: i64 = 9223372036854775807 + 1;          //~ ErrorLitRange "does not fit i64"
}

fn sumPastU64() {
  let c: u64 = 18446744073709551615 + 1;         //~ ErrorLitRange "beyond every integer type"
}

fn differencePastI64() {
  let d: i64 = 0 - 9223372036854775809;          //~ ErrorLitRange "beyond every integer type"
}

fn productPastU64() {
  let e: u64 = 4294967296 * 4294967296;          //~ ErrorLitRange "beyond every integer type"
}

fn negationPastI64() {
  let f: i64 = -(9223372036854775807 + 2);       //~ ErrorLitRange "beyond every integer type"
}

fn shiftPastU64() {
  let g: u64 = 2 << 63;                          //~ ErrorConstShift "does not fit 64 bits"
}
