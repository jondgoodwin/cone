// An expression made only of integer literals with no suffix, using '|', '&', '^', '<<'
// or '>>', is one literal worked out exactly, as '200 + 50' is, and takes the type of
// its place (the manual, syntax-lexical, "Number literals"). Every line prints 'ok'.

mod typemgmt_litbits;

import stdio use *;

fn ok(label: &str, good: bool) {
  printStr(label);
  if good { printStr(": ok\n"); } else { printStr(": FAILED\n"); }
}

fn takesU64(x: u64) u64 { x }
fn takesI64(x: i64) i64 { x }
fn takesU8(x: u8) u8 { x }

fn main() {
  let y: u64 = 1 << 40;
  ok("shift left into a u64", y == 1099511627776u64);
  let m: u8 = 0xF0 | 0x0F;
  ok("or into a u8", m == 255u8);
  let a: u8 = 0xFF & 0x3C;
  ok("and into a u8", a == 60u8);
  let x: u16 = 0xFF ^ 0x0F;
  ok("xor into a u16", x == 240u16);
  let r: u8 = 255 >> 4;
  ok("shift right into a u8", r == 15u8);
  let s: i64 = -16 >> 2;
  ok("shift right of a negative is arithmetic", s == -4i64);
  let o: i8 = -1 & 0x7F;
  ok("and of a negative into an i8", o == 127i8);
  let n: i64 = (1 << 33) | (1 << 2);
  ok("nested", n == 8589934596i64);
  ok("in an argument", takesU64(1 << 62 >> 1) == 2305843009213693952u64);
  ok("a mask in an argument", takesU8(0xF0 | 0x0F) == 255u8);
  ok("an i64 argument", takesI64(1 << 40) == 1099511627776i64);
  let xs = [10, 20, 30];
  ok("an index", xs[(1 ^ 0)] == 20);
  let d = 1 << 4;
  ok("default is i32", d == 16);
  let k: u8 = 5;
  ok("beside a typed operand", k + (1 ^ 0) == 6u8);
}
