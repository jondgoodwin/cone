// Explicit conversions written in the constructor form, 'Type[value]', that
// the compiler will not build.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. The 'as' and 'into' forms report through a
// different node and are in typemgmt-typecheck-cast; coercion is in
// typemgmt-typecheck-coerce.
//
// A tuple supplies a non-number source type without declaring one, which is
// what 'struct' would otherwise be dragged in for.

fn fromNonNumber() {
  mut pair (i32, i32) = 1, 2
  imm n = i32[pair]      //~ ErrorBadArray:15 "May only create number literal from another number"
}

fn tooManyValues() {
  imm n = i32[1, 2]      //~ ErrorBadArray:14 "Number literal requires one value"
}

// The operand of a conversion is a value. A type name in that position is not
// a zero-argument construction of it.
fn fromTypeName() {
  imm n = i32[f32]       //~ ErrorNotTyped:15 "Expected a typed expression"
}
