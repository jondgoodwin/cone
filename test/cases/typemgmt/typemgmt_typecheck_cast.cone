// The cast operator 'as' rejecting what it cannot do: it keeps the bits, and so
// needs both types to be the same size on every target.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. A number's conversion method, 'from', reports
// through a different node and is in typemgmt_typecheck_convert.

mod typemgmt_typecheck_cast;

// 'as' reinterprets a bit pattern, so a wider target would have to invent bits
fn reinterpretToWider() {
  mut n i32 = 1;
  imm wide = n as u64;    //~ ErrorInvType:14 "May only reinterpret value to the same sized primitive type"
}

// A slice is two words wide and usize and isize one, so there is no bit
// pattern to keep. Converting it with 'from' is refused for its own reason, in
// typemgmt_typecheck_convert.
fn sliceReinterpreted(s &Array[i32]) {
  imm n = s as usize;     //~ ErrorInvType:11 "May only reinterpret value to the same sized primitive type"
  imm m = s as isize;     //~ ErrorInvType:11 "May only reinterpret value to the same sized primitive type"
}

// usize and isize are as wide as a pointer, 64 bits on x64 and 32 on wasm32,
// so no fixed-width number reinterprets as either, nor either as one, even
// where the widths agree: the program would compile on one target and not on
// another. Each converts with 'from' (typemgmt_number_from). usize and isize
// with each other, or with a pointer, are the same size everywhere, and
// reinterpret (typemgmt_number_from, pointerSizedAs).
fn pointerSizedReinterpreted(w u64, m i64, u usize, s isize) {
  imm a = w as usize;     //~ ErrorPtrSizedAs:11 "usize and isize are pointer-sized"
  imm b = u as u64;       //~ ErrorPtrSizedAs:11 "usize and isize are pointer-sized"
  imm c = m as isize;     //~ ErrorPtrSizedAs:11 "usize and isize are pointer-sized"
  imm d = s as i64;       //~ ErrorPtrSizedAs:11 "usize and isize are pointer-sized"
  imm e = w as isize;     //~ ErrorPtrSizedAs:11 "usize and isize are pointer-sized"
  imm f = s as f64;       //~ ErrorPtrSizedAs:11 "usize and isize are pointer-sized"
}
