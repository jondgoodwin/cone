// A method may take as its 'self' a borrow of the owner of its type,
// 'self &So[Node]', 'self &Rc[Node]' or 'self &Arc[Node]'. It is found only
// when the receiver is an owner of that kind (tried after the ordinary
// selection), the owner is borrowed for the call and is still the caller's
// after, and inside the method 'self' reads through to the value.
//
// Every number is worked out by hand: a Node holds 'n'; viaSo adds 1, viaRc
// adds 2, viaArc adds 3, and plain adds nothing.
//   So  Node(10): viaSo = 11
//   Rc  Node(20): viaRc = 22
//   Arc Node(30): viaArc = 33
//   plain on the So (called after viaSo, so the owner is still there) = 10
//   plain on the Rc likewise = 20

mod typemgmt_owner_self;

import stdio use *;
import sync use Arc;

struct Node {
  n i64;

  pub fn viaSo(self &So[Node]) i64 { self.n + 1i64; }
  pub fn viaRc(self &Rc[Node]) i64 { self.n + 2i64; }
  pub fn viaArc(self &Arc[Node]) i64 { self.n + 3i64; }
  pub fn plain(self &) i64 { n; }
}

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  imm a = new So[Node](10i64);
  show("So", a.viaSo());
  imm b = new Rc[Node](20i64);
  show("Rc", b.viaRc());
  imm c = new Arc[Node](30i64);
  show("Arc", c.viaArc());
  show("So owner still the caller's", a.plain());
  show("Rc owner still the caller's", b.plain());
}
