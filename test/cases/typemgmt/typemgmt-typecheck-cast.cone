// The two cast operators rejecting what they cannot do: 'as', which keeps the
// bits and so needs both types to be the same size, and 'into', which needs a
// conversion between the two types to exist at all.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. The constructor form of conversion reports
// through a different node and is in typemgmt-typecheck-convert.
//
// A tuple supplies a non-number source type without declaring one, which is
// what 'struct' would otherwise be dragged in for.

// 'as' reinterprets a bit pattern, so a wider target would have to invent bits
fn reinterpretToWider() {
  mut n i32 = 1
  imm wide = n as u64    //~ ErrorInvType:14 "May only reinterpret value to the same sized primitive type"
}

fn convertFromNonNumber() {
  mut pair (i32, i32) = 1, 2
  imm n = pair into i32  //~ ErrorInvType:21 "Unsupported built-in type conversion"
}

// Coercion to Bool is defined for the number, reference and pointer types, and
// is reported separately from the other unsupported conversions
fn convertNonNumberToBool() {
  mut pair (i32, i32) = 1, 2
  imm b = pair into Bool //~ ErrorInvType:11 "Only numbers and ref/ptr may convert to Bool"
}
