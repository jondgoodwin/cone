// Explicit conversions written in the constructor form, 'Type[value]', that
// the compiler will not build.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. The 'as' and 'into' forms report through a
// different node and are in typemgmt-typecheck-cast; coercion is in
// typemgmt-typecheck-coerce.
//
// A tuple supplies a non-number source type without declaring one, which is
// what 'struct' would otherwise be dragged in for.

fn fromNonNumber() {
  mut pair (i32, i32) = 1, 2;
  imm n = i32[pair];      //~ ErrorBadArray:15 "May only create number literal from another number"
}

fn tooManyValues() {
  imm n = i32[1, 2];      //~ ErrorBadArray:14 "Number literal requires one value"
}

// The operand of a conversion is a value. A type name in that position is not
// a zero-argument construction of it.
fn fromTypeName() {
  imm n = i32[f32];       //~ ErrorNotTyped:15 "Expected a typed expression"
}

// Bool is the one number type that takes a source which is not a number: a
// reference or a pointer converts to it by null test, and typemgmt-success
// runs both. That does not make the target unconstrained -- Bool accepts what
// 'into Bool' accepts and nothing else, which a tuple is not.
fn boolFromNonConvertible() {
  mut pair (i32, i32) = 1, 2;
  imm b = Bool[pair];     //~ ErrorBadArray:16 "May only create Bool from a number, reference or pointer"
}

// A pointer converting to Bool does not make it convert to an integer. 'p into
// usize' is refused too, so the constructor form is agreeing with the
// conversion path rather than making a permitted conversion unreachable.
// Reinterpretation, 'p as usize', is a different question and is not this one.
fn pointerToInteger(p *i32) {
  imm n = usize[p];       //~ ErrorBadArray:17 "May only create number literal from another number"
}

// A reference type has no constructor form: a reference is borrowed or
// allocated, never built from a value. An alias is the only way to spell one
// before '[', and what refuses it is the literal's catch-all for a type it has
// no arm for, under the same code as the number cases above, rather than a
// diagnostic of its own. Pinned as it is today.
typedef IntRef &i32;

fn referenceAliasLiteral() {
  mut n = 5;
  imm borrowed = IntRef[&n];    //~ ErrorBadArray:24 "Unknown type literal type"
}
