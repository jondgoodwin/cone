// An alias used as the base of a path, which does not resolve.
//
// A path is collapsed during name resolution, as soon as the name before the
// period is bound (design/phases/name-resolution.md, section 4). An alias is
// bound to a typedef, not to the struct it names, and what the typedef stands
// for is not reliably known yet -- the declaration may not have been walked --
// so the path is left for type check, which has no namespace to walk either.
//
// Pinned as it is today, so that a collapse which followed the alias would
// change it visibly. typemgmt-success pins that the same alias works as a type
// and in a literal, which is what makes this the one failure a typedef has of
// its own: everywhere else an alias is the type it names.

struct Reading {
  level i64;

  fn make(n i64) Reading {
    Reading[n];
  }
}

typedef Sample Reading;

fn viaAlias() Reading {
  Sample.make(1i64);      //~ ErrorUnkName:3 "reaching a member through anything else is not built"
}
