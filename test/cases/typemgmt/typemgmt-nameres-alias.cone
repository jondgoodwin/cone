// An alias used as a qualifier, which resolves to nothing.
//
// Name-resolution stage only: this file parses cleanly, and name resolution
// returns before type checking, so a type-check expectation here would never
// run. It is the one failure a typedef has of its own: everywhere else an
// alias is the type it names, and misusing one is misusing that type.
//
// A qualified path walks module and struct namespaces
// (design/phases/name-resolution.md, section 2), and an alias is neither: the
// walk does not follow it to the struct it names, although a type position
// does. Pinned as it is today, so that a walk which followed the alias would
// change it visibly. typemgmt-success pins that the same alias works as a type
// and in a literal.

struct Reading {
  level i64

  fn make(n i64) Reading {
    Reading[n]
  }
}

typedef Sample Reading

fn viaAlias() Reading {
  Sample::make(1i64)      //~ ErrorUnkName:3 "Sample is not a valid namespace"
}
