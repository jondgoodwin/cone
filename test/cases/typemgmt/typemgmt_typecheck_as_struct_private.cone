// 'as' to a struct from a number is refused: it would make a value with its
// fields filled from the bits, past whatever a constructor checks. Secret has a
// field only its own methods are to set; 12345u32 is the size of that field.

mod typemgmt_typecheck_as_struct_private;

struct Secret {
  v: u32;
  fn make(v: u32) Secret { Secret(v) }
}

fn forge() Secret {
  12345u32 as Secret    //~ ErrorAsTarget:3 "`as` may not make Secret from u32"
}
