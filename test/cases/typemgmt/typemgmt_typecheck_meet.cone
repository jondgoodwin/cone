// Contexts that have to settle on one type for several values and cannot,
// which is where coercion is asked for by the shape of the code rather than by
// a declared type.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. Coercion into a declared type is in
// typemgmt_typecheck_coerce.
//
// Split from that file because the failure here is not "this value will not
// coerce to that type" but "no type exists that both values reach", and
// because the operator case reports through overload selection instead.
//
// referenceBranches is also a crash guard: the supertype search once read any
// two pointees as structs, and a reference to a number crashed the compiler.
// Should that regress, the process dies and every expectation here is lost.

mod typemgmt_typecheck_meet;

// Branches of an 'if' used as a value are coerced to the widest type among
// them, so two branches of the same kind agree. Two different kinds have no
// common type and neither branch is at fault, so the second one is reported.
fn signedAndUnsignedBranches() {
  mut signed i32 = 1;
  mut unsigned u32 = 1;
  imm x = if true {signed;} else {unsigned;};  //~ ErrorInvType:34 "Branch's expression type inconsistent with other branches"
}

fn integerAndFloatBranches() {
  mut signed i32 = 1;
  imm y = if true {signed;} else {2.5;};       //~ ErrorInvType:34 "Branch's expression type inconsistent with other branches"
}

// Two references meet only when they point at the same type, or at structs
// sharing a base trait. References to two different number types, or to a
// struct and a number, have no type in common, and that is reported in every
// context that folds several values into one: an 'if', a 'match', a loop's
// breaks and an array literal's elements.
struct Pt {x i32;}

fn referenceBranches(c Bool, a i32, b i64, p Pt) {
  imm r = if c {&a;} else {&b;};             //~ ErrorInvType:27 "Branch's expression type inconsistent with other branches"
  imm s = if c {&p;} else {&b;};             //~ ErrorInvType:27 "Branch's expression type inconsistent with other branches"
  imm t = if c {&b;} else {&p;};             //~ ErrorInvType:27 "Branch's expression type inconsistent with other branches"
  imm u = match c {case true {&a;} else {&b;}};  //~ ErrorInvType:41 "Branch's expression type inconsistent with other branches"
  imm v = while {if c {break &a;} else {break &b;}};  //~ ErrorInvType:47 "Branch's expression type inconsistent with other branches"
  imm w = [&a, &b];                          //~ ErrorBadArray:16 "Inconsistent type of array literal value"
}

// An operator coerces its right operand to the left operand's type, and not
// the other way round: the candidate set is the left type's, and i16 declares
// no '+' that accepts an i64. Widening is therefore asymmetric, even though
// the same two values in the other order need no conversion at all.
fn operandOrderIsNotSymmetric() {
  mut small i16 = 3;
  mut wide i64 = 4i64;
  imm z = small + wide;                      //~ ErrorNoCandidate:17 "accepts the call's arguments"
}
