// A per-platform 'extern': the declarations of the branch the build takes are
// declared and called, those of the branches it does not are declared nowhere, so
// the object holds no reference to a symbol only another platform defines. This is
// how a package binds one OS's C library on that OS alone. Both an 'extern' block
// and a lone 'extern fn' at the module's level, in a branch.

mod meta_if_extern;

extern {
  #if #os == .windows || #os == .linux {
    fn takenInBlockDefinedNowhere() i32;
  }
  #elif #os == .macos {
    fn macInBlockDefinedNowhere() i32;
  }
  #else {
    fn otherInBlockDefinedNowhere() i32;
  }
}

#if #os == .windows || #os == .linux {
  extern fn takenAloneDefinedNowhere() i32;
}
#else {
  extern fn otherAloneDefinedNowhere() i32;
}

pub fn total() i32 {
  #if #os == .windows || #os == .linux {
    takenInBlockDefinedNowhere() + takenAloneDefinedNowhere()
  }
  #else {
    otherInBlockDefinedNowhere() + otherAloneDefinedNowhere() + macInBlockDefinedNowhere()
  }
}
