// The module that declares the types. Reflection sees what the reflecting code could name: code
// written in this module sees every field of these types, private ones too; code written in
// another module sees the public ones, unless the type opted in with '@reflect'.

mod q;

import stdio use *;

pub struct Account {
  pub id: i32;
  secret: i32;
}

pub struct @reflect Open {
  pub id: i32;
  hidden: i32;
}

pub fn make(id: i32, secret: i32) Account {
  Account(id, secret)
}

pub fn makeOpen(id: i32, hidden: i32) Open {
  Open(id, hidden)
}

// Written here: the type's own scope
pub fn countHere[T]() i64 {
  var n = 0i64;
  #each #f in #fields(T) {
    n = n + 1;
  }
  n
}

// A method of a generic type, written here: it sees the private fields of T when T is declared here
pub struct Probe[T] {
  pub tag: i32;

  pub fn count(self: &) i64 {
    var n = 0i64;
    #each #f in #fields(T) {
      n = n + 1;
    }
    n
  }
}
