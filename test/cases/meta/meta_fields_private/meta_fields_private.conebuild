// The program, and q, the module that declares the types. A generic written in q reflects over q's
// types as q's own code does; one written in the program reflects as any other module does.

build: debug
output: executable

import stdio: "stdio.cone"
import q: "q.cone"

prog: {
    "main.cone"
    import q: "q.cone"
    import stdio: "stdio.cone"
}
