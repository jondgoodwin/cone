// Reflection from a module that does not declare the type (q does): '#fields' lists the public
// fields, and the private ones too once the type has opted in with '@reflect'. The printed values
// were checked by hand against q.cone:
//   Account here    code written in q sees both fields of Account, id and secret: 2
//   Account probe   a method of q's generic Probe sees both: 2
//   Account there   this module sees the public one, id: 1
//   names there     the name of that field is "id"
//   Open there      Open is '@reflect': this module sees id and hidden: 2
//   names of Open   id then hidden

mod prog;

import stdio use *;
import q;

fn countThere[T]() i64 {
  var n = 0i64;
  #each #f in #fields(T) {
    n = n + 1;
  }
  n
}

fn names[T]() {
  #each #f in #fields(T) {
    printStr(#f.name);
    printStr(" ");
  }
  printStr("\n");
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  show("Account here", q.countHere[q.Account]());
  let probe = q.Probe[q.Account](0);
  show("Account probe", probe.count());
  show("Account there", countThere[q.Account]());
  names[q.Account]();
  show("Open there", countThere[q.Open]());
  names[q.Open]();
}
