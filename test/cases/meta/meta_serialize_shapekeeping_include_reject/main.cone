// The program: a type of another package that appends to a String it was handed a '&mut' of is refused behind
// '&<mut Serializer + ShapeKeeping' (q's include file, generated by q's compile, does not record it), as it is
// inside one package (meta_serialize_shapekeeping_reject).

mod prog;

import stdio use *;
import collections use String;
import q;

struct Pt { pub n: i32; pub m: i32; }

fn main() i32 {
  var o = String();
  var s = q.HoldsOut(&mut o);
  serializeValue(&Pt(1, 2), &mut s);                   //~ ErrorNotShapeKeeping:29 "does not record it as `ShapeKeeping`"
  0i32
}
