// The program: a type of another package that keeps shape (a text format that appends to a String it owns)
// goes behind '&<mut Serializer + ShapeKeeping' in serializeValue, because q's include file records
// ShapeKeeping for it (the package's own compile found it).

mod prog;

import stdio use *;
import collections use String;
import q;

struct Pt { pub n: i32; pub m: i32; }

fn main() i32 {
  var s = q.OwnsOut(String());
  serializeValue(&Pt(1, 2), &mut s);
  printInt(i64.from(s.out.len()));
  printStr("\n");
  0i32
}
