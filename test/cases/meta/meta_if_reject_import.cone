// An import in a '#if' is allowed where an import would be allowed anyway: in the
// header. Past it, in a branch that follows a declaration or another branch that
// declares, it is refused as it is anywhere else, taken or not.

mod meta_if_reject_import;

import stdio use *;

#if #debug {
  import ioerror;
}

fn first() { }

#if #debug {
  import path;                                   //~ ErrorImportLate "Imports belong right after the 'mod' line"
}
#else {
  import time;                                   //~ ErrorImportLate "Imports belong right after the 'mod' line"
}

#if #debug {
  fn second() { }
}
#if #debug {
  import env;                                    //~ ErrorImportLate "Imports belong right after the 'mod' line"
}
