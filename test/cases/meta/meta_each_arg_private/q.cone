// The module that declares the types. Code written here sees every field of these types, private
// ones too, so a loop among a call's arguments written here builds a value from all of them.

mod q;

pub struct Account {
  pub id: i32;
  secret: i32;
}

pub struct @reflect Open {
  pub id: i32;
  hidden: i32;
}

// (Generic, as the program calls it: a plain function of q would need q's object linked in)
pub fn make[N](id: N, secret: N) Account {
  Account(id, secret)
}

pub fn secretOf[A](a: &A) i32 { a.secret }

// Written here: the type's own scope, so the private field is described and named
pub fn copyOf[T](src: &T) T {
  T(#each #f in #fields(T) { #f: src.#f })
}
