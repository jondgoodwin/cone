// Building a value from its fields with a loop among a call's arguments, where a field is private.
// The loop is reflection, so the rule of '#fields(T)' decides what it sees (meta_fields_private):
// a generic written in the type's own module describes every field, private ones too, and builds the
// value (q.copyOf, called from here); written here, it would be refused for a private field unless the
// type opted in with '@reflect' (meta_each_arg_reject_private). The printed values, checked by hand:
//   Account   q.copyOf copies q.make(5, 9): its id and its private secret, read by q.secretOf: 5 9
// (An '@reflect' type is described from another module, but a construction from there still may not
// give a value to its private field: meta_each_arg_reject_private.)

mod prog;

import stdio use *;
import q;

fn main() {
  let a = q.copyOf(&q.make[i32](5, 9));
  printStr("Account ");
  printInt(a.id);
  printStr(" ");
  printInt(q.secretOf(&a));
  printStr("\n");
}
