// A SPIR-V target is a GPU and not whatever else its triple says: '#os' is .gpu
// and '#arch' is .spirv, so the function answers the one value the facts give it
// (the check in cases.toml), and a branch for any other platform is not read for
// anything but its syntax -- this one calls a function a GPU cannot call.

mod meta_if_gpu;

extern fn hostOnlyDefinedNowhere() i32;

pub fn gpuFacts() i32 {
  #if #os == .gpu && #arch == .spirv {
    7
  }
  #else {
    hostOnlyDefinedNowhere()
  }
}
