// A layout fact asked of a type whose layout is still being settled is refused, not answered by the
// order the declarations are laid out in. 'Svc' holds 'Host[Svc]', whose parameter must meet 'Hosted': that
// fit is decided inside Svc's own layout, which checks Svc's 'hello', and 'hello' asks Svc for its size.
// The error is at the question and says which layout is in flight.

mod meta_layout_reject_cycle;

trait Hosted {
  fn hello(self: &Self) usize;
}

struct Host[S: Hosted] {
  pub s: *S;
}

struct Svc {
  pub h: Host[Svc];
  pub v: i32;

  fn hello(self: &Self) usize {
    #size(Svc)                     //~ ErrorMetaLayout:5 "asks about the layout of 'Svc'"
  }
}

fn main() {
}
