// A loop among a call's arguments written in a module that does not declare the type: '#fields(T)'
// refuses a type with a private field that has not opted in with '@reflect', as it does for a loop
// of statements (meta_fields_reject_private), so no value is built from the public fields alone.

mod prog;

import q;

fn copyOf[T](src: &T) T {
  T(#each #f in #fields(T) { #f: src.#f })     //~ ErrorMetaFieldsPrivate:5 "private field 'secret' of 'Account'"
                                                   //~^ ErrorNotPublic:34 "give a value to the private field hidden"
                                                   //~^^ ErrorNotPublic:37 "access the private method/field `hidden`"
}

fn main() {
  copyOf(&q.make(1, 2));
  copyOf(&q.makeOpen(1, 2));
}
