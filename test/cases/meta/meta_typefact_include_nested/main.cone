// The program, built without WIDE, against q's include file (q was built with it). q decided the
// build facts: the include file holds the branch q took, so the program shares q's static
// (an i64: 2^32 on the first call, 2^33 on the second), takes 7 for an integer and 8 for a float
// from 'pick' (the type question q left), and an integer Cell has the field q's WIDE branch gave it.

mod prog;

import stdio use *;
import q;

fn main() i32 {
  printInt(q.bump(1i32));
  printStr("\n");
  printInt(q.fromQ());
  printStr("\n");
  printInt(q.pick(1i32));
  printStr("\n");
  printInt(q.pick(1.5));
  printStr("\n");
  let c = q.Cell[i32](1i32, 9i64);
  printInt(c.wide);
  printStr("\n");
  let d = q.Cell[f64](1.5);
  printInt(d.size());
  printStr("\n");
  0i32
}
