// Package q, built release with -D WIDE: a generic function whose type question holds a
// build question, with a static of a different type in each branch of it. The build fact is
// q's to decide, so the include file holds the branch q took (the i64 static), and the program
// -- built without WIDE -- clones that, not the i32 one; both objects then share one static of
// one type. (Were the chain kept whole, the program would pick the i32 branch, and q's inlined
// i64 code would write eight bytes through the program's four-byte static.)

mod q;

pub fn bump[T](x: T) i64 {
  #if T is Integer {
    #if #defined("WIDE") {
      static var n: i64 = 0;
      n = n + 4294967296;
      n
    } #else {
      static var n: i32 = 0;
      n = n + 1;
      i64.from(n)
    }
  } #else {
    0
  }
}

pub fn fromQ() i64 { bump(1i32) }

// The other nesting: the build question around the type question. q decides it, and the file
// holds the type question alone, which the program decides for its own type.
pub fn pick[T](x: T) i64 {
  #if #defined("WIDE") {
    #if T is Integer { 7 } #else { 8 }
  } #else {
    9
  }
}

pub struct Cell[T] {
  pub v: T;
  #if #defined("WIDE") {
    #if T is Integer {
      pub wide: i64;
    }
  }
  pub fn size(self: &) i64 { 1 }
}
