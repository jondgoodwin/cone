// The module that declares the types: Account has a private field and has not opted in; Open has one and has.

mod q;

pub struct Account {
  pub id: i32;
  secret: i32;
}

pub struct @reflect Open {
  pub id: i32;
  hidden: i32;
}

pub fn make(id: i32, secret: i32) Account { Account(id, secret) }
pub fn makeOpen(id: i32, hidden: i32) Open { Open(id, hidden) }
