// The opt-in opens reflection, not plain access. Without '@reflect' the walk is refused as before; with it, a
// plain 'o.hidden' written from outside the module is still refused, while the walk through 'v.#f' is accepted.

mod prog;

import q;

fn sum[T](v: &T) i32 {
  var n = 0;
  #each #f in #fields(T) {                     //~ ErrorMetaFieldsPrivate:3 "private field 'secret' of 'Account'"
    n = n + v.#f;
  }
  n
}

fn main() {
  sum(&q.make(1, 2));
  let o = q.makeOpen(1, 2);
  sum(&o);
  let h = o.hidden;                            //~ ErrorNotPublic:12 "access the private method/field `hidden`"
}
