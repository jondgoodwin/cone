// A description of a field is asked for what it holds, or spliced: a bare '#f', a property a field
// does not have, and the attributes (not built yet) are each refused where they stand

mod meta_fields_reject_parse;

struct Point {
  pub x: i32;
}

fn bare[T]() i64 {
  var n = 0i64;
  #each #f in #fields(T) {
    let x = #f;                                  //~ ErrorMetaFields:13 "describes a field of the type"
    n = n + 1;
  }
  n
}

fn unknown[T]() i64 {
  var n = 0i64;
  #each #f in #fields(T) {
    let x = #f.colour;                           //~ ErrorMetaFields:16 "A field description answers"
    n = n + 1;
  }
  n
}

fn attrs[T]() i64 {
  var n = 0i64;
  #each #f in #fields(T) {
    let x = #f.attrs;                            //~ ErrorMetaFields:16 "Attributes on fields are not built yet"
    n = n + 1;
  }
  n
}

fn main() {
  bare[Point]();
  unknown[Point]();
  attrs[Point]();
}
