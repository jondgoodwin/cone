// An array type written with brackets ('[u8, #size(Big)]', not 'Array[u8, n]') has no size to read, and its
// contents ('<- fill 0') asked for one: the compile reports the array type and ends there, rather than
// reading the size that is not there.

mod meta_array_bracket_length;

struct Big {
  pub a: i64;
}

fn main() {
  let a = [u8, #size(Big)]() <- fill 0;    //~ ErrorBadArray
                                           //~^ ErrorBadArray
}
