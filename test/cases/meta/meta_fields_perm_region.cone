// '#f.perm' and '#f.region' (mod-generativity.html#metafields) stand where a permission and a region
// do: as the arguments of a region reference type. Read back by making a value from them and
// putting it where the field's own type goes. 'let c: #f.type = #f.region[#f.perm, i32](5)' compiles
// only if the region and the permission are the field's own: Rc and mut for one field, Arc and imm
// for the other (an imm value is not the same type as a mut one, nor an Arc as an Rc).
//
// The printed values were checked by hand against the source:
//   6   'shared' is Rc(1): the field's 1 plus the made value 5
//   7   'worker' is Arc(2): the field's 2 plus the made value 5

mod meta_fields_perm_region;

import stdio use *;
import sync use Arc;

struct Pool {
  pub var shared: Rc[mut, i32];
  pub let worker: Arc[imm, i32];
}

fn probe[T](v: &T) {
  #each #f in #fields(T) {
    let c: #f.type = #f.region[#f.perm, i32](5);
    printInt(*v.#f + *c);
    printStr("\n");
  }
}

fn main() {
  let p = Pool(Rc[mut, i32](1), Arc[imm, i32](2));
  probe(&p);
}
