// '#if' on a '-D' number compares with '!=' (Bug 75)
// (run with -DLEVEL=3 and --define=NEG=-7)
mod meta_if_define_ne;

import stdio use *;

fn main() {
  var n = 0;
  #if #define("LEVEL") != 3 { n = n + 1; }
  #if #define("LEVEL") != 4 { n = n + 10; }
  #if #define("LEVEL") != 3 { n = n + 100; }
  #else { n = n + 1000; }
  #if #define("NEG") != -7 { n = n + 10000; }
  #if #define("NEG") != 0 && #define("LEVEL") != 2 { n = n + 100000; }
  printStr("n = ");
  printInt(n);
  printStr("\n");
}
