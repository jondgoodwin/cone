// What a loop among a call's arguments makes is checked as the arguments written out would be, for
// the instance that has them: the named arguments belong to a construction of a struct alone, and a
// value that does not suit its field is the construction's ordinary error.

mod meta_each_arg_reject_check;

struct One {
  pub x: i32;
}

fn plain(x: i32) i32 { x }

// The loop is not a construction here, and a function takes no argument by name
fn callPlain[T](s: &T) i32 {
  plain(#each #f in #fields(T) { #f: s.#f })      //~ ErrorNamedArg:38 "Named arguments are not supported in a call; pass `x` by position"
}

fn main() {
  callPlain(&One(1));
}
