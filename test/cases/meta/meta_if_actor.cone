// '#if' in an actor's body: a field and a behaviour that exist only on the build
// that takes their branch. An actor's declarations are generated from the text of
// its fields and parameters, so a branch not taken must leave nothing in that
// text; this one's field names a type nothing declares, and its behaviour a name
// nothing declares, and the program links only because neither is read for more
// than its syntax. '-D FAST' in the run.

mod meta_if_actor;

import stdio use *;
import actors;

actor Tally {
  total: u64;
  #if #defined("FAST") {
    step: u64;
  }
  #else {
    slow: UndeclaredType;
  }

  fn init(self: &new, start: u64) {
    *self = Self(total: start, step: 5u64);
  }

  #if #defined("FAST") {
    pub async fn bump(self) {
      total = total + step;
    }
  }
  #else {
    pub async fn bump(self) {
      total = total + nothingDeclaredAnywhere;
    }
  }

  pub async fn report(self: &) {
    printStr("total "); printUInt(total); printStr("\n");
  }
}

fn main() {
  initAll();
  actors.configure(actors.Options(workers: 2u32));
  {
    let t = Tally(10u64);
    t.bump();
    t.bump();
    t.report();
  }
  finalAll();
}
