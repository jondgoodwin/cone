// What a meta variable at a module's level refuses: a 'var' (a count belongs to one function's
// passes), and a value that is no number or list.

mod meta_each_reject_module;

var #count = 0;                                  //~ ErrorMetaVar:1 "fixed"
let #bad = oops;                                 //~ ErrorMetaVar:12 "integer"

fn main() {}
