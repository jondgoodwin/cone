// Collections serialize where their elements do (row 333c), so a List[Plain] of an undeclared struct is refused. Refused:
// a struct that declares Serialize with a List[Plain] field (at the field, naming it and its type), a Dict[String, Plain]
// field the same way, and serializeValue of a List[Plain] (at the call, by the bound, naming Plain).

mod meta_serialize_list_reject;

import collections use *;

struct Plain { pub a: i32; }
struct Item is Serialize { pub id: i32; pub tags: List[Plain]; }   //~ ErrorSerializeField "its field tags is List"
struct Item2 is Serialize { pub id: i32; pub m: Dict[String, Plain]; }   //~ ErrorSerializeField "its field m is Dict"

struct Sink is Serializer { pub out: String;
  pub fn boolean(self: &mut, b: bool) {}
  pub fn int(self: &mut, n: i64) {}
  pub fn uint(self: &mut, n: u64) {}
  pub fn float(self: &mut, x: f64) {}
  pub fn text(self: &mut, s: &str) {}
  pub fn bytes(self: &mut, b: &Array[u8]) {}
  pub fn none(self: &mut) {}
  pub fn beginSeq(self: &mut, len: usize) {}
  pub fn endSeq(self: &mut) {}
  pub fn beginMap(self: &mut, len: usize) {}
  pub fn mapKey(self: &mut) {}
  pub fn mapValue(self: &mut) {}
  pub fn endMap(self: &mut) {}
  pub fn beginRecord(self: &mut, typeName: &str, len: usize) {}
  pub fn field(self: &mut, name: &str, index: usize) {}
  pub fn endRecord(self: &mut) {}
  pub fn unitVariant(self: &mut, enumName: &str, index: u32, name: &str) {}
  pub fn beginVariant(self: &mut, enumName: &str, index: u32, name: &str, len: usize) {}
  pub fn endVariant(self: &mut) {}
}

fn main() {
  var s = Sink(String());
  serializeValue(&List[Plain](), &mut s);   //~ ErrorWhereUnmet "List is Serialize only where T is Serialize, and that is false for T = Plain"
}
