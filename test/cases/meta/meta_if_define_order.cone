// '#if' on a '-D' number orders with '<', '<=', '>' and '>=' as well as '==' and '!='
// (run with -DLEVEL=3 and --define=NEG=-7)
mod meta_if_define_order;

import stdio use *;

fn main() {
  var n = 0;
  #if #define("LEVEL") > 2 { n = n + 1; }
  #if #define("LEVEL") > 3 { n = n + 10; }
  #if #define("LEVEL") >= 3 { n = n + 100; }
  #if #define("LEVEL") < 3 { n = n + 1000; }
  #if #define("LEVEL") <= 3 { n = n + 10000; }
  #if 2 < #define("LEVEL") && #define("NEG") < 0 { n = n + 100000; }
  #if #define("NEG") >= 0 { n = n + 1000000; }
  printStr("n = ");
  printInt(n);
  printStr("\n");
}
