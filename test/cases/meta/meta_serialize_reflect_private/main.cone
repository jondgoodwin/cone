// An '@reflect' type from another module with a private field goes through core's serializeValue walk (the opt-in
// opens reflection to the walk, which is core's code, as it does to any module). q declares Open(id: 1, hidden: 2).
// The printed lines, checked by hand against the type and the walk: a record of 2 fields in declaration order,
// 'id' (index 0) with int 1, then the private 'hidden' (index 1) with int 2, then the record's end.
// (deserializeValue of such a type is still refused, ErrorFieldsRebuild: the rebuild of a private field is not part of the '@reflect' opt-in.)

mod prog;

import stdio use *;
import q;

struct Recorder is Serializer { pub n: i32;
  pub fn boolean(self: &mut, b: bool) {}
  pub fn int(self: &mut, n: i64) { printStr("int "); printInt(n); printStr("\n"); }
  pub fn uint(self: &mut, n: u64) {}
  pub fn float(self: &mut, x: f64) {}
  pub fn text(self: &mut, s: &str) {}
  pub fn bytes(self: &mut, b: &Array[u8]) {}
  pub fn none(self: &mut) {}
  pub fn beginSeq(self: &mut, len: usize) {}
  pub fn endSeq(self: &mut) {}
  pub fn beginMap(self: &mut, len: usize) {}
  pub fn mapKey(self: &mut) {}
  pub fn mapValue(self: &mut) {}
  pub fn endMap(self: &mut) {}
  pub fn beginRecord(self: &mut, typeName: &str, len: usize) { printStr("record "); printInt(i64.from(len)); printStr("\n"); }
  pub fn field(self: &mut, name: &str, index: usize) { printStr("field "); printStr(name); printStr(" "); printInt(i64.from(index)); printStr("\n"); }
  pub fn endRecord(self: &mut) { printStr("endrecord\n"); }
  pub fn unitVariant(self: &mut, enumName: &str, index: u32, name: &str) {}
  pub fn beginVariant(self: &mut, enumName: &str, index: u32, name: &str, len: usize) {}
  pub fn endVariant(self: &mut) {}
}

fn main() {
  var rec = Recorder(0);
  serializeValue(&q.makeOpen(1, 2), &mut rec);
}
