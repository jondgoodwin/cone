// The module that declares the type: Open has a private field and has opted in with '@reflect'.

mod q;

// (Generic, so that the 'serialize' the compiler supplies is compiled where the program instantiates it: a plain
// type's method would need q's object linked in)
pub struct @reflect Open[N] is Serialize {
  pub id: N;
  hidden: N;
}

pub fn makeOpen[N](id: N, hidden: N) Open[N] { Open[N](id, hidden) }
