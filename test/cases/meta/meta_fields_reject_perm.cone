// '#f.perm' is the field's own permission: a field written 'let' is 'imm', so a value made with it
// cannot be written through. The error names the pass of the loop that made it

mod meta_fields_reject_perm;

struct Cell {
  pub let a: Rc[imm, i32];
}

fn probe[T](v: &T) {
  #each #f in #fields(T) {
    let c = #f.region[#f.perm, i32](5);
    *c = 6;                               //~ ErrorNoMut:5 "do not have permission to modify"
  }
}

fn main() {
  let s = Cell(Rc[imm, i32](1));
  probe(&s);
}
