// '#size' and '#align' are the code generator's constants: this front end has not worked the size out when
// a '#if' is decided, so a '#if' on one is refused, not decided by whatever falls out.

mod meta_layout_if;

struct Big {
  pub a: i64;
  pub b: i64;
  pub c: i64;
}

fn main() {
  #if #size(Big) > 16 {                 //~ ErrorMetaLayoutConst:7 "#size"
    let x = 1;
  }
}
