// A generic cloned for a type with no fields to describe: a number, an enum. The error is at the
// loop, in the instance, and says which call made it

mod meta_fields_reject_type;

fn count[T]() i64 {
  var n = 0i64;
  #each #f in #fields(T) {                       //~ ErrorMetaFieldsType:3 "describes the fields of a struct"
    n = n + 1;
  }
  n
}

fn main() {
  count[i32]();
}
