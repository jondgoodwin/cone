// The usual way to meet the refusal: a '#if' in a generic that asks the size of its type parameter. The
// condition is read where the generic is written, so it is refused there, once, not at each instance.

mod meta_layout_if_generic;

fn wide[T](v: T) i32 {
  #if #size(T) > 16 {                   //~ ErrorMetaLayoutConst:7 "#size"
    1
  }
  #else {
    0
  }
}

fn main() i32 {
  wide(1i64)
}
