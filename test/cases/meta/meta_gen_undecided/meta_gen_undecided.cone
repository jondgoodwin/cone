// A loop over #fields(U) kept undecided: U is still open when an instance of the generic module
// copies the generic type that holds the loop, so the copy keeps the loop as written, with its
// fields and its methods, and each instance of the copy decides it for its own U.
//
// This is the designated file of the scenario's folder; gencols.cone beside it is the generic
// module. The printed values were checked by hand against the source:
//   body   gencols[i64].Cols[Body] holds tag, mass, id: 1, and the getters read 2 and 3
//   point  gencols[i32].Cols[Point] is the same copy's sibling with other fields, x and y: 9 4 5
//   other  gencols[i64].Cols[Point], the same module instance as body and another U: 6 7 8
//   both   gencols[Body].Both[i64]: the loop over the module's T is decided, so it holds extra,
//          mass, id: 5 6 7

mod meta_gen_undecided;

import stdio use *;

pub struct Body {
  pub mass: i64;
  pub id: i32;
}

pub struct Point {
  pub x: i32;
  pub y: i32;
}

fn main() {
  let b = gencols[i64].Cols[Body](1i64, 2i64, 3i32);
  print <- "body ", b.tag, " ", b.get_mass(), " ", b.get_id(), "\n";
  let p = gencols[i32].Cols[Point](9i32, 4i32, 5i32);
  print <- "point ", p.tag, " ", p.get_x(), " ", p.get_y(), "\n";
  let o = gencols[i64].Cols[Point](6i64, 7i32, 8i32);
  print <- "other ", o.tag, " ", o.x, " ", o.y, "\n";
  let t = gencols[Body].Both[i64](5i64, 6i64, 7i32);
  print <- "both ", t.extra, " ", t.mass, " ", t.id, "\n";
}
