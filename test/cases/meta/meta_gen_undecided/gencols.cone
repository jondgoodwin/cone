// A generic module holding generic types whose loops are over #fields: every instance of the
// module holds a copy of each, still generic. Cols's loop is over its own U, still open when the
// copy is made, so the copy keeps the loop as written and each instance of the copy decides it.
// Both's loop is over the module's T, which the module's instance has decided.
pub mod gencols[T];

pub struct Cols[U] {
  pub tag: T;
  #each #f in #fields(U) {
    pub #f: #f.type;
    pub fn #name("get_", #f)(self: &) #f.type {
      self.#f
    }
  }
}

pub struct Both[V] {
  pub extra: V;
  #each #f in #fields(T) {
    pub #f: #f.type;
  }
}
