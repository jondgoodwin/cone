// --meta-ir writes <name>.meta: each outermost '#each' with the IR of every pass the parser
// made of it, so what the loop expanded to can be read before name resolution has run. The
// check reads that file: the loop over 3 and 5, then the loop over two types, whose inner
// loop is part of the outer one's passes and is not written twice.

mod meta_each_dump;

fn scaled(n: i32) i32 {
  var s = 0;
  #each #x in [3, 5] {
    s = s + #x * n;
  }
  s
}

fn sizes() i64 {
  var s = 0i64;
  #each #T in (i8, u16) {
    #each #k in [100, 200] {
      let v: #T = 1;
      s = s + i64.from(#k);
    }
  }
  s
}
