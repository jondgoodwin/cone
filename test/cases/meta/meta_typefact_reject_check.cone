// The branch an instance of a generic takes is type checked as any code is, and the
// error is reported for that instance. The integer branch below is wrong for every
// integer, and an instance that takes the float branch never reads it: only the
// integer instance is refused.

mod meta_typefact_reject_check;

fn checked[T](x: T) i32 {
  #if T is Float {
    1
  } #else {
    x.leadingZeros() + true                      //~ ErrorBoolNotNbr:24 "A bool is not a number"
  }
}

fn main() {
  checked(1.5);
  checked(1i32);
}
