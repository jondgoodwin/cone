// The program against q's include file: it expands q's generic bodies holding $"..." for its
// own types. Hand-checked output: each line is the text the pieces spell.

mod prog;

import stdio use *;
import collections use *;
import q;

fn show(s: &String) {
  printStr(s.view());
  printStr("\n");
}

fn main() i32 {
  let n = 42i32;
  let t = q.Tag(7i32);
  show(&q.sent(&n));
  show(&q.sent(&t));
  show(&q.stored(&n));
  show(&q.stored(&t));
  show(&q.fromQ());
  0i32
}
