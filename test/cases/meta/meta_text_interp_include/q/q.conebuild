// Package q, compiled on its own into a library object, which writes its
// include file.

build: release
output: library

import collections: "../../../../../packages/collections/src/collections.cone"
import libc: "../../../../../packages/libc/src/libc.cone"

q: {
    "q.cone"
    import collections: "../../../../../packages/collections/src/collections.cone"
    import libc: "../../../../../packages/libc/src/libc.cone"
}
