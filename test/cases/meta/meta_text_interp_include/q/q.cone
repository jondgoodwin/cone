// Package q: generic bodies holding an interpolated string, $"...", sent directly and stored.
// The include file keeps the body as the parser's pieces; the program, which has only that
// file, expands each instance from it for its own type.

mod q;

import collections use *;

pub struct Tag {
  pub id: i32;
  pub fn toText(self: &, out: &uni TextOut) {
    out <- $"#{self.id}";
  }
}

// A direct send of an interpolated string, in a String the function holds
pub fn sent[T](x: &T) String {
  var s = String();
  s <- $"sent {x} twice {x}!";
  s
}

// An interpolated string stored as a String
pub fn stored[T](x: &T) String {
  let s = $"stored {x} {{braces}}";
  s
}

pub fn fromQ() String { sent(&Tag(1i32)) }
