// The program: compiled against the include file q's compile generated, and linked
// with q's object. It clones q's generics for its own types, and so decides each
// '#if' on a type parameter the include file kept.
//
// A build fact inside such a chain was decided by q, so the include file holds the branch q
// took (q is built 'debug'). The printed values were checked by hand: weight takes 1
// for a float; an integer takes the inner '#if #debug' branch q took, 2; a bool takes 3. The float Rec has scale 4, the integer one bits 5.

mod prog;

import stdio use *;
import q;

fn main() i32 {
  printInt(q.weight(1.5));
  printStr("\n");
  printInt(q.weight(1i32));
  printStr("\n");
  printInt(q.weight(true));
  printStr("\n");
  printInt(q.Rec[f64](1.5, 4i64).scaled());
  printStr("\n");
  printInt(q.Rec[i32](1i32, 5i64).bitsOf());
  printStr("\n");
  0i32
}
