// Package q, compiled on its own into a library object that writes its include
// file. Its generics hold '#if' on what a type parameter is: a function, and a struct
// with a field and a method under one. A generic is cloned where it is used, from
// the include file's text, so the file keeps each such chain whole (a chain on the
// facts of the build alone is cut to the branch taken, as in meta_if_include). The
// chain below nests the two: the build fact sits inside the type's branch (a chain
// asking about both at once is refused), so q decides it and the file holds the branch
// q took, with the question about the type left for the program's clone.

mod q;

pub fn weight[T](x: T) i64 {
  #if T is Float {
    1
  } #elif T is Integer {
    #if #debug {
      2
    } #else {
      20
    }
  } #else {
    3
  }
}

pub struct Rec[T] {
  pub v: T;
  #if T is Float {
    pub scale: i64;
    pub fn scaled(self: &) i64 { scale }
  } #else {
    pub bits: i64;
    pub fn bitsOf(self: &) i64 { bits }
  }
}
