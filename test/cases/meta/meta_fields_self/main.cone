// A trait default in module p walks '#fields(Self)' and is taken into Account, declared here with a
// private field. The printed values were checked by hand against the source:
//   id=7 secret=42   both fields of Account(7, 42), the private one too, in declaration order
//   2                what 'describe' returns: the number of fields walked

mod prog;

import stdio use *;

struct Account is p.Describe {
  pub id: i32;
  secret: i32;
}

fn main() {
  let a = Account(7, 42);
  printInt(a.describe());
  printStr("\n");
}
