// A trait, written in a module that declares no type of its own, whose default walks the fields of
// 'Self': the type the default is taken into. The default is cloned into that type, so it sees what
// the type's own scope sees, the private fields too, though this module is not the type's.

pub mod p;

import stdio use *;

pub trait Describe {
  pub fn describe(self: &) i64 {
    var n = 0i64;
    #each #f in #fields(Self) {
      printStr(#f.name);
      printStr("=");
      printInt(self.#f);
      printStr(" ");
      n = n + 1;
    }
    printStr("\n");
    n
  }
}
