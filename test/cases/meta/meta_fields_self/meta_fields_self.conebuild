// The program, and p, its child module, which declares a trait whose default walks the fields of
// 'Self'. The type that takes the default in is the program's own, with a private field.

build: debug
output: executable

prog: {
    "main.cone"
    import stdio: "stdio.cone"
    p: {
        "p.cone"
        import stdio: "stdio.cone"
    }
}
