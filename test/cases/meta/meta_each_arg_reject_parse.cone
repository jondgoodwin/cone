// A '#each' among a call's arguments makes one named argument per field, so its block holds exactly
// that, '#f: value'. A block that is anything else, an argument named by a written name, and a
// '#each' in any other expression position are each refused where they stand.

mod meta_each_arg_reject_parse;

struct Point {
  pub x: i32;
  pub y: i32;
}

fn notNamed[T](s: &T) T {
  T(#each #f in #fields(T) { s.#f })               //~ ErrorMetaEachArg:31 "exactly that"
}

fn bareVar[T](s: &T) T {
  T(#each #f in #fields(T) { #f })                 //~ ErrorMetaEachArg:33 "exactly that"
}

fn twoArgs[T](s: &T) T {
  T(#each #f in #fields(T) { #f: s.#f, #f: s.#f }) //~ ErrorMetaEachArg:40 "exactly that"
}

fn fixedName[T](s: &T) T {
  T(#each #f in #fields(T) { x: s.#f })            //~ ErrorMetaEachArgName:31 "would be given to every field"
}

fn overList() Point {
  Point(#each #x in [1, 2] { #x: 1 })              //~ ErrorMetaEachPlace:21 "goes through the fields of a type parameter"
}

fn inValue[T](s: &T) i32 {
  let v = 1 + #each #f in #fields(T) { s.#f };     //~ ErrorMetaEachPlace:15 "inside an expression"
  v
}

fn inIndex(a: &[i32]) i32 {
  a[#each #i in [0] { #i }]                        //~ ErrorMetaEachPlace:5 "inside an expression"
}
