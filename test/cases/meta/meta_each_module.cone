// A meta constant at a module's level: 'let #sizes = [8, 16, 32];' is held by the parser to the end of
// the file, gone from the code, and every function and generic below it reads it as one in its own
// body would be read.
//
// The printed values were checked by hand against the source:
//   total      the items 8 + 16 + 32 of '#sizes': 56
//   scaled     '#base' is 100 and '#bumps' holds 1 and 2: 100 * 1 + 100 * 2 = 300
//   generic    the same list through a generic, for i32 and for i64: 56 each, 112

mod meta_each_module;

import stdio use *;

let #sizes = [8, 16, 32];
let #base = 100;
let #bumps = [1, 2];

fn total() i64 {
  var s = 0i64;
  #each #s in #sizes {
    s = s + #s;
  }
  s
}

fn scaled() i64 {
  var s = 0i64;
  #each #b in #bumps {
    s = s + #base * #b;
  }
  s
}

fn viaGeneric[T]() i64 {
  var s = 0i64;
  #each #s in #sizes {
    s = s + #s;
  }
  s
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn main() {
  show("total", total());
  show("scaled", scaled());
  show("generic", viaGeneric[i32]() + viaGeneric[i64]());
}
