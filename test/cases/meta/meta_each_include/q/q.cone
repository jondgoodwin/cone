// Package q, compiled on its own (with -D WIDE) into a library object that writes its include
// file. Its generics hold a '#each', and a generic is cloned where it is used, from the include
// file's text, so the file keeps each '#each' whole: the importer reads the loop again and makes
// the passes itself. What it must not decide again is anything of the build: a '#if' on a fact
// of the build inside the loop's body is cut to the branch q took, once, whatever number of
// passes read it, and the importer (built without WIDE) makes its passes of that branch.
//
// A chain that asks about the build and a type at once is refused (meta_typefact_reject_*); here
// the build's '#if' is inside the loop and the type's after it, each a chain of its own.

mod q;

pub fn weigh[T](x: T) i64 {
  var s = 0i64;
  #each #k in [1, 2, 3] {
    #if #defined("WIDE") {
      s = s + i64.from(#k) * 100;
    } #else {
      s = s + i64.from(#k);
    }
  }
  #if T is Float { s + 1000 } #else { s }
}

// A meta variable belongs to the body it is declared in, which the file copies whole
pub fn counted[T](x: T) i64 {
  var #i = 0;
  var s = 0i64;
  #each #n in [10, 20, 30] {
    #i += 1;
    s = s + i64.from(#n) * #i;
  }
  s
}

// A loop over types in a generic's body
pub fn widths[T](x: T) i64 {
  var s = 0i64;
  #each #U in (i8, i16, i64) {
    s = s * 100 + i64.from(mem.sizeof[#U]());
  }
  s
}
