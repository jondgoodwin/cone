// The program: compiled against the include file q's compile generated, and linked with q's
// object. It clones q's generics for its own types, and so reads each '#each' in them again
// from the text the include file kept, and makes the passes itself.
//
// q was built with -D WIDE and this program without it. The printed values were checked by hand:
//   weigh(1.5)    the WIDE branch q took: (1 + 2 + 3) * 100 = 600, and a float adds 1000: 1600
//   weigh(1i32)   600
//   counted       10 * 1 + 20 * 2 + 30 * 3 = 140, for either type
//   widths        sizes 1, 2 and 8 run together as base 100 digits: ((0 * 100 + 1) * 100 + 2) * 100 + 8 = 10208

mod prog;

import stdio use *;
import q;

fn main() i32 {
  printInt(q.weigh(1.5));
  printStr("\n");
  printInt(q.weigh(1i32));
  printStr("\n");
  printInt(q.counted(1.5));
  printStr("\n");
  printInt(q.counted(true));
  printStr("\n");
  printInt(q.widths(1i32));
  printStr("\n");
  0i32
}
