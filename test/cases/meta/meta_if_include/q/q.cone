// Package q, compiled on its own into a library object that writes its include
// file: '#if' at a module's level and in a type's braces. The include file keeps
// the '#if' text whole -- a program that imports q evaluates it for its own
// target -- and cuts each branch's declarations as it cuts any: a public function
// becomes an 'extern', a private one is left out. A branch the build did not
// take is left as written, since the program reads it for syntax alone and drops
// it. Every private body names seed, which the file also leaves out, so one left
// in fails the file's own check.

mod q;

fn seed() i64 {
  1
}

#if #os == .windows || #os == .linux {
  pub fn platform() i64 { seed() + 10 }
  fn hidden() i64 { seed() }
}
#else {
  pub fn platform() i64 { nameNotDeclaredAnywhere() }
}

pub struct Rec {
  pub a: i64;
  #if #os == .windows || #os == .linux {
    pub b: i64;
    fn aside(self) i64 { seed() + b }
  }
  #else {
    pub b: UndeclaredType;
  }
  pub fn total(self) i64 { a + b + platform() }
}
