// A layout fact asked of a type whose layout is in flight through a chain of by-value fields is refused,
// and the message names the types of the cycle, one holding the next by value. 'Top' holds 'Mid' by value.
// Mid's layout settles 'Host[Mid]', whose parameter must meet 'Hosted': that fit checks Mid's 'hello', and
// 'hello' asks for the size of Top, whose layout is in flight because it is waiting on Mid.

mod meta_layout_reject_chain;

trait Hosted {
  fn hello(self: &Self) usize;
}

struct Host[S: Hosted] {
  pub s: *S;
}

struct Top {
  pub m: Mid;
  pub w: i32;
}

struct Mid {
  pub h: Host[Mid];
  pub v: i32;

  fn hello(self: &Self) usize {
    #size(Top)                     //~ ErrorMetaLayout:5 "Top contains Mid"
  }
}

fn main() {
}
