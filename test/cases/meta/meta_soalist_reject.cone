// What SoaList[T] refuses where T is a move type (a String field): 'push' of a whole row exists only
// where T is Copy, because a row is taken apart field by field and a field that moves cannot be
// moved out of an owned value. Such a T is built and read by column ('ns.name.push(s)'), which is
// accepted. The refusal is at the call, and the SoaList itself is made.

mod meta_soalist_reject;

import collections use *;

struct Named {
  pub name: String;
  pub id: i32;
}

fn byColumn(ns: &mut SoaList[Named], s: String) {
  ns.name.push(s);
  ns.id.push(1);
}

fn pushMove(ns: &mut SoaList[Named], row: Named) {
  ns.push(row);                      //~ ErrorWhereAbsent:5 "it exists only where T is Copy, and Named is not Copy"
}

fn main() {}
