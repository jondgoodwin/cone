// The program against q's include file: it expands q's generic 'note' for its own types, and
// a sink prints each event's field names. Hand-checked: the names are the braces' source
// text: "item", "count" and "count + 1" (the expression's own text); the message is the
// text with the values spelled in.

mod prog;

import stdio use *;
import trace use Level, Log;
import q;

let log: Log;

fn @initpure init() {
  log = Log.make("app", Level.Info);
}

struct Printer is trace.Sink {
  pub n: i64;

  pub fn enabled(self: &, k: &trace.Info) bool {true}

  pub fn record(self: &, e: &trace.Event) {
    let k = e.kind;
    printStr("fields:");
    var i = 0usize;
    while i < e.values.len {
      printStr(" ");
      printStr(k.names[i]);
      i = i + 1usize;
    }
    printStr(" | ");
    printStr(e.message);
    printStr("\n");
  }
}

fn main() i32 {
  trace.install(Uni[Printer](0));
  trace.setDefaultLevel(Level.Info);
  q.note(&log, &q.Pair(1i32, 2i32), 1i32);
  q.note(&log, &q.Tag(9u64), 2i32);
  q.note(&log, &7i32, 3i32);
  0i32
}
