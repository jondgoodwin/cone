// The program, compiled against the include file q's compile generated (the golden file
// under include\), and linked with q's and trace's objects.

build: debug
output: executable

import stdio: "stdio.cone"
import q: "include/q.cone"
import trace: "../../../../packages/trace/src/trace.cone"
import libc: "../../../../packages/libc/src/libc.cone"

prog: {
    "main.cone"
    import q: "include/q.cone"
    import stdio: "stdio.cone"
    import trace: "../../../../packages/trace/src/trace.cone"
    import libc: "../../../../packages/libc/src/libc.cone"
}
