// Package q, compiled on its own into a library object, which writes its include file.

build: release
output: library

import trace: "../../../../../packages/trace/src/trace.cone"
import libc: "../../../../../packages/libc/src/libc.cone"

q: {
    "q.cone"
    import trace: "../../../../../packages/trace/src/trace.cone"
    import libc: "../../../../../packages/libc/src/libc.cone"
}
