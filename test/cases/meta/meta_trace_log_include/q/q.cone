// Package q: a generic function sending '$"..."' to a trace Log. The braces' names come from
// their source text; the include file prints the body again and the program, which has only
// that file, must read the names back for each instance it expands.

mod q;

import trace use Log;

pub struct Pair {
  pub a: i32;
  pub b: i32;
}

pub struct Tag {
  pub id: u64;
}

pub fn note[T](log: &Log, item: &T, count: i32) {
  log <- $"item {item} count={count} next {count + 1}";
}
