// A package whose types reshape storage they own, and lend borrows of it: the include file records them
// ShapeChanging (and ShapeKeeping), and the importer applies the in-package rule from that.
mod q;
import collections use List, String;

pub struct Pt { pub x: i64; pub y: i64; }
pub trait Holder { pub fn first(self: &) &Pt; pub fn add(self: &mut, p: Pt); }
pub trait Adder { pub fn add(self: &mut, p: Pt); }
pub struct Bag {
  items: List[Pt];
  pub fn empty() Bag { Bag(List[Pt]()) }
  pub fn first(self: &) &Pt { &items[0usize] }
  pub fn add(self: &mut, p: Pt) { items.push(p); }
  pub fn count(self: &) usize { items.len() }
}
pub trait Viewer { pub fn view(self: &) &str; pub fn reset(self: &mut); }
pub struct Buf {
  buf: String;
  pub fn make() Buf { Buf(String()) }
  pub fn view(self: &) &str { buf.view() }
  pub fn reset(self: &mut) { self.buf = String(); }
}
