// The program: a type of another package that changes shape (Bag lends a borrow of what it owns and pushes onto it)
// goes behind '&<mut Adder + ShapeKeeping' of a trait that lends nothing from self, as it does inside one package.
// (The same type behind a trait that lends from self is refused: meta_shapekeeping_lends_include_reject.)

mod prog;

import stdio use *;
import q;

fn viaAdder(h: &<mut q.Adder + ShapeKeeping) { h.add(q.Pt(1i64, 0i64)); }

fn main() i32 {
  var b = q.Bag.empty();
  viaAdder(&mut b);
  printInt(i64.from(b.count()));
  printStr("\n");
  0i32
}
