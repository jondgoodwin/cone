// What an instance with generated members refuses: two members of one name (a generated field and
// a written one, two generated by names that join to one word, a generated method and a written
// one), and a type parameter whose fields cannot be described. The error is pointed at the template's
// member that is made twice, and the instance is not made.

mod meta_gen_reject_check;

struct HasCount {
  pub count: i64;
}

struct XAx {
  pub x: i32;
  pub ax: i32;
}

struct Named[T] {
  pub count: i64;
  #each #f in #fields(T) {
    pub #f: #f.type;                             //~ ErrorMetaGenClash:9 "two members named 'count'"
  }
}

struct Joined[T] {
  #each #f in #fields(T) {
    pub #f: #f.type;                             //~ ErrorMetaGenClash:9 "two members named 'ax'"
    pub #name("a", #f): #f.type;
  }
}

struct Methods[T] {
  pub fn get_count(self: &) i64 { 0 }
  #each #f in #fields(T) {
    pub fn #name("get_", #f)(self: &) i64 { 1 } //~ ErrorMetaGenClash:9 "a method"
  }
}

struct Wrapped[T] {
  #each #f in #fields(T) {
    pub #f: #f.type;                             //~ ErrorMetaFieldsType:9 "describes the fields of a struct"
  }
}

fn useNamed(a: &Named[HasCount]) {}
fn useJoined(a: &Joined[XAx]) {}
fn useMethods(a: &Methods[HasCount]) {}
fn useWrapped(a: &Wrapped[i32]) {}

fn main() {}
