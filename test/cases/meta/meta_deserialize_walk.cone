// Deserialization through core's data model (deserializeValue, Deserializer, Partial): a scripted
// deserializer (a list of tokens read in order) stands for a format. The printed lines were checked by
// hand against the scripts in main:
//   whole     {p: {y: -2, zzz: [1], x: 1}, name: "hi", f: 2, u: 200, b: true}: members in any order, the
//             unknown 'zzz' (a nested value) skipped, the integer 2
//             read into the f32 field as 2.0, p.x 1 and p.y -2; the String is made in the arena's region:
//             the arena holds no block before and one after
//   missing   {p: {x: 1}} for Pt: 'p' is unknown so skipped, and x is the first member not found
//   missing2  the top-level record for Rcd without 'name': the error names it
//   range     Small's i8 field 'k' given 300: a Range error naming the field (k)
//   custom    Tag declares Deserialize[Tag], so its own function runs (not a record): its text "t" is read, 7

mod meta_deserialize_walk;

import stdio use *;
import collections use *;
import arena use *;

// A scripted deserializer: a list of tokens, read in order. kinds: 0 begin, 1 end, 2 name, 3 int,
// 4 float, 5 text, 6 bool, 7 null
struct Script is Deserializer {
  pub kinds: List[i32];
  pub ints: List[i64];
  pub floats: List[f64];
  pub texts: List[String];
  pub pos: usize;

  pub fn add(self: &mut, kind: i32, n: i64, x: f64, s: &str) {
    self.kinds.push(kind); self.ints.push(n); self.floats.push(x); self.texts.push(String.from(s));
  }
  pub fn begin(self: &mut) { self.add(0, 0i64, 0.0, ""); }
  pub fn end(self: &mut) { self.add(1, 0i64, 0.0, ""); }
  pub fn name(self: &mut, s: &str) { self.add(2, 0i64, 0.0, s); }
  pub fn int(self: &mut, n: i64) { self.add(3, n, 0.0, ""); }
  pub fn float(self: &mut, x: f64) { self.add(4, 0i64, x, ""); }
  pub fn text(self: &mut, s: &str) { self.add(5, 0i64, 0.0, s); }
  pub fn boolean(self: &mut, b: bool) { self.add(6, if b { 1i64 } else { 0i64 }, 0.0, ""); }
  pub fn nothing(self: &mut) { self.add(7, 0i64, 0.0, ""); }

  fn kind(self: &) i32 { if self.pos < self.kinds.len() { self.kinds[self.pos] } else { 1 } }

  pub fn readBool(self: &mut) Result[bool, DataError] {
    if self.kind() != 6 { return Err[bool, DataError](DataError.mismatch("expected a bool")); }
    let b = self.ints[self.pos] != 0i64; self.pos = self.pos + 1usize; Ok[bool, DataError](b)
  }
  pub fn readInt(self: &mut) Result[i64, DataError] {
    if self.kind() != 3 { return Err[i64, DataError](DataError.mismatch("expected an integer")); }
    let n = self.ints[self.pos]; self.pos = self.pos + 1usize; Ok[i64, DataError](n)
  }
  pub fn readUInt(self: &mut) Result[u64, DataError] {
    if self.kind() != 3 { return Err[u64, DataError](DataError.mismatch("expected an integer")); }
    let n = self.ints[self.pos]; self.pos = self.pos + 1usize;
    if n < 0i64 { return Err[u64, DataError](DataError.range("negative")); }
    Ok[u64, DataError](u64.from(n))
  }
  pub fn readFloat(self: &mut) Result[f64, DataError] {
    let k = self.kind();
    var x = 0.0;
    if k == 4 { x = self.floats[self.pos]; }
    else if k == 3 { x = f64.from(self.ints[self.pos]); }
    else { return Err[f64, DataError](DataError.mismatch("expected a number")); }
    self.pos = self.pos + 1usize; Ok[f64, DataError](x)
  }
  pub fn readText(self: &mut) Result[&str, DataError] {
    let k = self.kind();
    if k != 5 && k != 2 { return Err[&str, DataError](DataError.mismatch("expected text")); }
    let at = self.pos; self.pos = self.pos + 1usize;
    Ok[&str, DataError](self.texts[at].view())
  }
  pub fn readTextInto(self: &mut, out: &uni TextOut) Result[void, DataError] {
    let k = self.kind();
    if k != 5 && k != 2 { return Err[void, DataError](DataError.mismatch("expected text")); }
    let at = self.pos; self.pos = self.pos + 1usize;
    out <- self.texts[at].view();
    Ok[void, DataError](nil)
  }
  pub fn readBytes(self: &mut) Result[&Array[u8], DataError] { Err[&Array[u8], DataError](DataError.custom("no bytes")) }
  pub fn readNone(self: &mut) Result[bool, DataError] {
    if self.kind() == 7 { self.pos = self.pos + 1usize; return Ok[bool, DataError](true); }
    Ok[bool, DataError](false)
  }
  pub fn beginSeq(self: &mut) Result[void, DataError] { if self.kind() != 0 { return Err[void, DataError](DataError.mismatch("expected a begin")); } self.pos = self.pos + 1usize; Ok[void, DataError](nil) }
  pub fn nextElement(self: &mut) Result[bool, DataError] { if self.kind() == 1 { self.pos = self.pos + 1usize; return Ok[bool, DataError](false); } Ok[bool, DataError](true) }
  pub fn beginMap(self: &mut) Result[void, DataError] { if self.kind() != 0 { return Err[void, DataError](DataError.mismatch("expected a begin")); } self.pos = self.pos + 1usize; Ok[void, DataError](nil) }
  pub fn nextEntry(self: &mut) Result[bool, DataError] { if self.kind() == 1 { self.pos = self.pos + 1usize; return Ok[bool, DataError](false); } Ok[bool, DataError](true) }
  pub fn beginRecord(self: &mut, typeName: &str) Result[void, DataError] { if self.kind() != 0 { return Err[void, DataError](DataError.mismatch("expected a begin")); } self.pos = self.pos + 1usize; Ok[void, DataError](nil) }
  pub fn nextField(self: &mut) Result[FieldKey, DataError] {
    let k = self.kind();
    if k == 1 { self.pos = self.pos + 1usize; return Ok[FieldKey, DataError](FieldKey.End); }
    if k == 2 { return Ok[FieldKey, DataError](FieldKey.Name); }
    Ok[FieldKey, DataError](FieldKey.Index(0usize))
  }
  pub fn beginVariant(self: &mut) Result[FieldKey, DataError] { Err[FieldKey, DataError](DataError.custom("no variants")) }
  pub fn endVariant(self: &mut) Result[void, DataError] { Err[void, DataError](DataError.custom("no variants")) }
  pub fn skipValue(self: &mut) Result[void, DataError] {
    var depth = 0i32;
    var go = true;
    while go {
      let k = self.kind();
      self.pos = self.pos + 1usize;
      if k == 0 { depth = depth + 1; }
      else if k == 1 { depth = depth - 1; }
      if depth == 0 && k != 2 { go = false; }
    }
    Ok[void, DataError](nil)
  }
}


struct Pt { pub x: i32; pub y: i32; }
struct Rcd { pub name: String; pub p: Pt; pub f: f32; pub u: u8; pub b: bool; }
struct Small { pub k: i8; }

struct Tag is Deserialize[Tag] {
  pub id: i32;
  pub fn deserialize(d: &<mut Deserializer + ShapeKeeping, r: *MemRegion) Result[Tag, DataError] {
    match d.readText() {
      case let Ok(t) { Ok[Tag, DataError](Tag(if t == "t" { 7 } else { 0 })) }
      case let Err(e) { Err[Tag, DataError](e) }
    }
  }
}
struct Holder { pub t: Tag; pub n: i32; }

fn fresh() Script { Script(List[i32](), List[i64](), List[f64](), List[String](), 0usize) }

fn main() {
  var arena = Arena();
  var d = fresh();
  d.begin();
  d.name("p"); d.begin(); d.name("y"); d.int(-2i64); d.name("zzz"); d.begin(); d.int(1i64); d.end(); d.name("x"); d.int(1i64); d.end();
  d.name("name"); d.text("hi");
  d.name("f"); d.int(2i64); d.name("u"); d.int(200i64); d.name("b"); d.boolean(true);
  d.end();
  print <- "blocks before ", arena.blockCount(), "\n";
  match deserializeValue[Rcd](&mut d, arena.region) {
    case let Ok(r) { print <- r.name.view(), " ", r.p.x, " ", r.p.y, " ", r.f, " ", r.u, " ", r.b, "\n"; }
    case let Err(e) { print <- "error: ", e, "\n"; }
  }
  print <- "blocks after ", arena.blockCount(), "\n";

  var d2 = fresh();
  d2.begin(); d2.name("p"); d2.begin(); d2.name("x"); d2.int(1i64); d2.end(); d2.end();
  match deserializeValue[Pt](&mut d2, heapRegion()) {
    case let Ok(r) { print <- "ok\n"; }
    case let Err(e) { print <- "missing: ", e, "\n"; }
  }

  var d3 = fresh();
  d3.begin(); d3.name("p"); d3.begin(); d3.name("x"); d3.int(1i64); d3.name("y"); d3.int(3i64); d3.end(); d3.end();
  match deserializeValue[Rcd](&mut d3, heapRegion()) {
    case let Ok(r) { print <- "ok\n"; }
    case let Err(e) { print <- "missing2: ", e, "\n"; }
  }

  var d4 = fresh();
  d4.begin(); d4.name("k"); d4.int(300i64); d4.end();
  match deserializeValue[Small](&mut d4, heapRegion()) {
    case let Ok(r) { print <- "ok\n"; }
    case let Err(e) { print <- "range: ", e, "\n"; }
  }

  var d6 = fresh();
  d6.begin(); d6.name("t"); d6.text("t"); d6.name("n"); d6.int(4i64); d6.end();
  match deserializeValue[Holder](&mut d6, heapRegion()) {
    case let Ok(r) { print <- "custom: ", r.t.id, " ", r.n, "\n"; }
    case let Err(e) { print <- "error: ", e, "\n"; }
  }
}
