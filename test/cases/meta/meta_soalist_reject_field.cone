// A T with a field named as a SoaList method ('len', 'push', 'get', 'isEmpty', 'remove',
// 'swapRemove') is refused: the instance would have a field and a method of one name. The refusal
// is located in collections.cone (the method's own line), so the scenario lists it as unlocated;
// the call that follows, which finds the field where the method was called, is annotated here.

mod meta_soalist_reject_field;

import collections use *;

struct Ln {
  pub len: i32;
  pub id: i32;
}

fn main() {
  var ps = SoaList[Ln]();
  ps.id.push(1);
  let n = ps.len();                //~ ErrorFldArgs
}
