// SoaList[T] is Sendable where T is: a list of plain rows crosses to where a Sendable is asked for,
// a list of rows with a raw pointer does not (a raw pointer's target cannot be checked), and a
// list of rows with a String does, as a List of Strings does.

mod meta_soalist_reject_send;

import collections use *;

struct Plain {
  pub a: i32;
  pub b: i64;
}

struct Owns {
  pub name: String;
  pub id: i32;
}

struct Raw {
  pub p: *i32;
  pub n: i32;
}

fn crosses[T: Sendable]() {}

fn main() {
  crosses[SoaList[Plain]]();
  crosses[SoaList[Owns]]();
  crosses[SoaList[Raw]]();                 //~ ErrorNotSendable "raw pointer"
}
