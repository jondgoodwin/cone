// '#fields(T)' names a type parameter of the generic it is written in: a type, or a function that
// is not generic, has no instance to clone for

mod meta_fields_reject_nameres;

struct Point {
  pub x: i32;
}

fn plain() i64 {
  var n = 0i64;
  #each #f in #fields(Point) {                   //~ ErrorMetaFields:3 "describes the fields of a generic's type parameter"
    n = n + 1;
  }
  n
}

fn main() {
  plain();
}
