// A value that does not suit its field is the construction's own error, in the instance that has
// it: Flag's 'n' is an i32, and the 'true' the loop gives every field is no value for it.

mod meta_each_arg_reject_type;

struct Flag {
  pub on: bool;
  pub n: i32;
}

fn wrong[T]() T {
  T(#each #f in #fields(T) { #f: true })            //~ ErrorBoolNotNbr:34 "i32 is wanted"
}

fn main() {
  wrong[Flag]();
}
