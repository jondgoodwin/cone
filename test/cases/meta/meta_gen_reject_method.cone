// A written method named like a field the loop generated: the generated fields enter the instance
// first, so the written method is the second member of the name. It is refused once for each
// clash, at the method, naming the type argument and the field (ErrorMetaGenClash), and the
// instance is made with no methods, so a body that calls the method (isEmpty calls len) is not
// checked against the field and adds no second error. An instance whose type has no such field
// is made whole.

mod meta_gen_reject_method;

struct Q {
  pub len: i64;
  pub id: i32;
}

struct Both {
  pub len: i64;
  pub push: i64;
}

struct Fine {
  pub id: i32;
}

struct Cols[T] {
  #each #f in #fields(T) {
    pub #f: #f.type;
  }
  pub fn len(self: &) usize { 0usize }           //~ ErrorMetaGenClash:7 "Field 'len' of 'Q' clashes with the method 'len' of 'Cols'"
  pub fn isEmpty(self: &) bool { self.len() == 0usize }
}

struct Pair[T] {
  #each #f in #fields(T) {
    pub #f: #f.type;
  }
  pub fn len(self: &) usize { 0usize }           //~ ErrorMetaGenClash:7 "Field 'len' of 'Both' clashes"
  pub fn push(self: &mut) { }                    //~ ErrorMetaGenClash:7 "Field 'push' of 'Both' clashes"
  pub fn count(self: &) usize { self.len() }
}

fn useQ(a: &Cols[Q]) {}
fn useBoth(a: &Pair[Both]) {}

fn useFine(a: &Cols[Fine]) usize { a.len() + 1usize }

fn main() {}
