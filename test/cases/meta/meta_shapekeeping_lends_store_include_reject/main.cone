// The program: Buf of package q (its `reset` stores a new String over the one it owns, and `view` lends a borrow of
// it) is refused behind '&<mut Viewer + ShapeKeeping', since Viewer lends from self (`view`), as it is inside one
// package.

mod prog;

import stdio use *;
import q;

fn useIt(h: &<mut q.Viewer + ShapeKeeping) usize {
  let v = h.view();
  h.reset();
  v.len()
}

fn main() i32 {
  var b = q.Buf.make();
  printInt(i64.from(useIt(&mut b)));                    //~ ErrorNotShapeKeeping:27 "whose include file records it as `ShapeChanging`"
  0i32
}
