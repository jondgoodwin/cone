// The module that declares the type: Open has a private field and has opted in with '@reflect'.

mod q;

pub struct @reflect Open {
  pub id: i64;
  hidden: i64;
}

// (Generic, as the program calls it: a plain function of q would need q's object linked in)
pub fn makeOpen[N](id: N, hidden: N) Open { Open(id, hidden) }
