// The opt-in opens reflection to code of any module, the splice included (the 1 Nov ruling): a generic written
// here, in a module that does not declare Open, reads and writes Open's private field 'hidden' through 'v.#f'.
// The printed values, checked by hand: Open(3, 40) summed is 43; after 'bump' adds 1 through the splice to
// each field it is Open(4, 41), summed 45.

mod prog;

import stdio use *;
import q;

fn sum[T](v: &T) i64 {
  var n = 0i64;
  #each #f in #fields(T) {
    n = n + v.#f;
  }
  n
}

fn bump[T](v: &mut T) {
  #each #f in #fields(T) {
    v.#f = v.#f + 1;
  }
}

fn main() {
  var o = q.makeOpen(3, 40);
  printInt(sum(&o));
  printStr("\n");
  bump(&mut o);
  printInt(sum(&o));
  printStr("\n");
}
