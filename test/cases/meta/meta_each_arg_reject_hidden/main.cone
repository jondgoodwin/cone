// Generic code that builds a value of its type argument from all the fields of T, as SoaList[T]
// does to run T's finalizer: for a type with a private field (opened to reflection by '@reflect'),
// the module that declares it is the only one that may give that field a value. Refused with
// ErrorFieldsRebuild, naming the field and the type (and the generic type whose code it is, for a
// method), where the generic gives the value, and not as ErrorNotPublic, which is for a literal
// written outside the module. A type with public fields is built.

mod prog;

import q;

fn zeroed[T]() T {
  T(#each #f in #fields(T) { #f: 0i32 })       //~ ErrorFieldsRebuild:34 "This generic code must rebuild a 'Hidden' from each of its fields here, and the field 'secret' is private"
}

struct Rows[T] {
  n: i32;
  fn make(self: &) T {
    T(#each #f in #fields(T) { #f: 0i32 })     //~ ErrorFieldsRebuild:36 "'Rows' must rebuild a 'Hidden' from each of its fields here"
  }
}

fn main() {
  zeroed[q.Open]();
  zeroed[q.Hidden]();
  Rows[q.Open](1).make();
  Rows[q.Hidden](1).make();
}
