// '#if' around imports, where an import would be allowed anyway: in the module's
// header, right after its 'mod' line. The branch the build takes brings its imports
// in as though they were written there; one it does not take is read for syntax
// alone, so its import names a package that exists nowhere and is never looked for.
// A branch that only imports does not end the header: an import may follow it.

mod meta_if_import;

#if #os == .windows || #os == .linux {
  import stdio use *;
}
#else {
  import aPackageThatExistsNowhere;
}

#if #debug {
  import strutil_that_is_not_taken_either;
}
#elif #defined("NEVER") {
  import another_nowhere;
}

fn main() i32 {
  printInt(42i64);
  printStr("\n");
  0i32
}
