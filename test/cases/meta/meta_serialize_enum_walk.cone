// An enum that declares Serialize and writes no 'serialize' is given one: each variant is written through the
// Serializer in the data model. The printed lines were checked by hand against the types below:
//   unit variant        Dot holds nothing: 'unitVariant', the name only
//   type variant        Circle(f32) holds one value: 'beginVariant' (index 1 in declaration order), the value, 'endvariant'
//   record variant      Rect is a struct inside the enum: 'beginVariant' (index 2), then the ordinary record walk of its
//                       fields (record 2, field w 0, field h 1, in order), 'endvariant'
//   generic enum        Maybe[i32] is Serialize because i32 is: Nothing is a unit variant, Just a type variant holding the 7
//   enum in a record    Holder's field 'shape' is walked through the enum's own Serialize, after the field name

mod meta_serialize_enum_walk;

import stdio use *;
import collections use *;

struct Recorder is Serializer { pub log: String;
  pub fn boolean(self: &mut, b: bool) { self.log <- "bool ", b, "\n"; }
  pub fn int(self: &mut, n: i64) { self.log <- "int ", n, "\n"; }
  pub fn uint(self: &mut, n: u64) { self.log <- "uint ", n, "\n"; }
  pub fn float(self: &mut, x: f64) { self.log <- "float ", x, "\n"; }
  pub fn text(self: &mut, s: &str) { self.log <- "text ", s, "\n"; }
  pub fn bytes(self: &mut, b: &Array[u8]) { self.log <- "bytes ", b.len(), "\n"; }
  pub fn none(self: &mut) { self.log <- "none\n"; }
  pub fn beginSeq(self: &mut, len: usize) { self.log <- "seq ", len, "\n"; }
  pub fn endSeq(self: &mut) { self.log <- "endseq\n"; }
  pub fn beginMap(self: &mut, len: usize) { self.log <- "map ", len, "\n"; }
  pub fn mapKey(self: &mut) { self.log <- "key\n"; }
  pub fn mapValue(self: &mut) { self.log <- "value\n"; }
  pub fn endMap(self: &mut) { self.log <- "endmap\n"; }
  pub fn beginRecord(self: &mut, typeName: &str, len: usize) { self.log <- "record ", len, "\n"; }
  pub fn field(self: &mut, name: &str, index: usize) { self.log <- "field ", name, " ", index, "\n"; }
  pub fn endRecord(self: &mut) { self.log <- "endrecord\n"; }
  pub fn unitVariant(self: &mut, enumName: &str, index: u32, name: &str) { self.log <- "unit ", enumName, ".", name, " ", index, "\n"; }
  pub fn beginVariant(self: &mut, enumName: &str, index: u32, name: &str, len: usize) { self.log <- "variant ", enumName, ".", name, " ", index, " ", len, "\n"; }
  pub fn endVariant(self: &mut) { self.log <- "endvariant\n"; }
}

enum Shape is Serialize {
  Dot,
  Circle(f32);
  pub struct Rect { pub w: i32; pub h: i32; }
}

enum Maybe[T] is Serialize if T is Serialize {
  Nothing,
  Just(T);
}

struct Holder is Serialize { pub id: i32; pub shape: Shape; }

fn show[T](title: &str, v: &T) {
  var rec = Recorder(String());
  serializeValue(v, &mut rec);
  print <- "== ", title, "\n";
  printStr(rec.log.view());
}

fn main() {
  show("Dot", &Shape.Dot);
  show("Circle", &Shape.Circle(1.5f32));
  show("Rect", &Shape.Rect(3, -4));
  let n: Maybe[i32] = Maybe.Nothing[i32];
  show("Nothing", &n);
  let j: Maybe[i32] = Maybe.Just[i32](7);
  show("Just", &j);
  show("Holder", &Holder(9, Shape.Dot));
}
