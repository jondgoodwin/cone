// A generic written in another module than the type's, cloned for a type with a private field it
// cannot see and no '@reflect': refused, naming the type, the field and the opt-in, rather than
// listing the public fields only and giving a serializer or an 'equals' the wrong answer

mod prog;

import q;

fn countThere[T]() i64 {
  var n = 0i64;
  #each #f in #fields(T) {                     //~ ErrorMetaFieldsPrivate:3 "private field 'secret' of 'Account'"
    n = n + 1;
  }
  n
}

fn main() {
  countThere[q.Account]();
}
