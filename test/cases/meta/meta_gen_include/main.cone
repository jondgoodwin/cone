// The program: compiled against the include file q's compile generated, and linked with q's
// object. It clones q's Twin for its own types, and so makes the members of q's loop for them.
//
// The printed values were checked by hand: Twin[Pt](3, 4, 5, 6) holds x, old_x, y, old_y; get_x reads
// 3 and get_y reads 5; old_y reads 6; total adds the module's meta constant #bumps = [1, 2]: 3.

mod prog;

import stdio use *;
import q;

struct Pt {
  pub x: i32;
  pub y: i32;
}

fn main() i32 {
  let t = q.Twin[Pt](3, 4, 5, 6);
  printInt(i64.from(t.get_x()));
  printStr("\n");
  printInt(i64.from(t.get_y()));
  printStr("\n");
  printInt(i64.from(t.old_y));
  printStr("\n");
  printInt(t.total());
  printStr("\n");
  0i32
}
