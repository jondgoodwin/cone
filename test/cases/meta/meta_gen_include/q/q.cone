// Package q, compiled on its own into a library object that writes its include file. Its
// generic struct holds a '#each #f in #fields(T)' that makes a field and a method for each field
// of T. A generic is cloned where it is used, from the include file's text, so the file keeps
// the loop whole and the program that imports it makes the members for its own types.

mod q;

let #bumps = [1, 2];

pub struct Twin[T] {
  #each #f in #fields(T) {
    pub #f: #f.type;
    pub #name("old_", #f): #f.type;
    pub fn #name("get_", #f)(self: &) #f.type {
      self.#f
    }
  }
  pub fn total(self: &) i64 {
    var n = 0i64;
    #each #b in #bumps {
      n = n + #b;
    }
    n
  }
}
