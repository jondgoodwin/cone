// What '#if' on what a type parameter is refuses when names are resolved. Both
// branches are name resolved where the generic is written, whichever an instance
// takes, so a name that exists nowhere is reported in either; and a question about
// something that is no type parameter of the generic it stands in is refused.

mod meta_typefact_reject_nameres;

// ---- outside a generic: a name that is no type parameter
fn plain() i32 {
  #if i32 is Integer {                           //~ ErrorMetaTypeFact:7 "asks about a type parameter of the generic function or type it stands in"
    1
  } #else {
    2
  }
}

// ---- a name that does not exist, in a branch no instance takes
fn missing[T](x: T) i32 {
  #if T is Float {
    1
  } #else {
    nowhere(x)                                   //~ ErrorUnkName:5 "nowhere"
  }
}

fn missingtaken[T](x: T) i32 {
  #if T is Float {
    nowhere2(x)                                  //~ ErrorUnkName:5 "nowhere2"
  } #else {
    2
  }
}

// ---- a trait that does not exist
fn badclause[T](x: T) i32 {
  #if T is Nothing {                             //~ ErrorUnkName:12 "Nothing"
    1
  } #else {
    2
  }
}

fn main() {
  missing(1.5);
  missing(1i32);
  missingtaken(1.5);
  missingtaken(1i32);
  badclause(1.5);
  plain();
}
