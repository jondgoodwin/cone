// A loop among a call's arguments kept undecided: U is still open when an instance of the generic
// module copies the generic type and function that hold the loop, so the copy keeps the loop as
// written and each instance of the copy decides it for its own U. This is the designated file of
// the scenario's folder; genmake.cone beside it is the generic module. The printed values were
// checked by hand:
//   body    genmake[i64].Maker[Body] copies Body(4, 5): 4 5
//   point   genmake[i32].Maker[Point] copies Point(9, 8, 7), another module instance and another U: 9 8 7
//   other   genmake[i64].Maker[Point], the first module instance with the second U: 1 2 3
//   build   genmake[i64].build[Body] and genmake[i32].build[Point], the free function: 6 7 and 3 2 1

mod meta_each_arg_undecided;

import stdio use *;

pub struct Body {
  pub mass: i64;
  pub id: i32;
}

pub struct Point {
  pub x: i32;
  pub y: i32;
  pub z: i32;
}

fn main() {
  let mb = genmake[i64].Maker[Body](0i64);
  let b = mb.copy(&Body(4i64, 5i32));
  print <- "body ", b.mass, " ", b.id, "\n";
  let mp = genmake[i32].Maker[Point](0i32);
  let p = mp.copy(&Point(9i32, 8i32, 7i32));
  print <- "point ", p.x, " ", p.y, " ", p.z, "\n";
  let mo = genmake[i64].Maker[Point](0i64);
  let o = mo.copy(&Point(1i32, 2i32, 3i32));
  print <- "other ", o.x, " ", o.y, " ", o.z, "\n";
  let bb = genmake[i64].build[Body](&Body(6i64, 7i32));
  let bp = genmake[i32].build[Point](&Point(3i32, 2i32, 1i32));
  print <- "build ", bb.mass, " ", bb.id, " and ", bp.x, " ", bp.y, " ", bp.z, "\n";
}
