// A generic module holding a generic type and a generic function whose bodies build a U from
// '#each #f in #fields(U) { #f: ... }'. U is still open when an instance of the module copies them,
// so the copy keeps the loop as written and each instance of the copy decides it for its own U.
pub mod genmake[N];

pub struct Maker[U] {
  pub base: N;
  pub fn copy(self: &, src: &U) U {
    U(#each #f in #fields(U) { #f: src.#f })
  }
}

pub fn build[U](src: &U) U {
  U(#each #f in #fields(U) { #f: src.#f })
}
