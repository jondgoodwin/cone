// Package q, built with '-D WIDE' and used by a program built without it. The
// include file keeps only the branch q was built with, so the program reads the
// layout q's object holds and the function q's object defines, whatever its own
// facts are: a '#if' it kept would be read again for the program's target. The
// branch not taken names things that exist nowhere, and its text is not in the file.

mod q;

#if #defined("WIDE") {
  pub struct Wide {
    pub a: i64;
    pub b: i64;
    pub c: i64;
  }
  pub fn value() i64 { 5 }
}
#else {
  pub struct Wide {
    pub a: i64;
    pub b: UndeclaredType;
  }
  pub fn value() i64 { nameNotDeclaredAnywhere() }
}

// A generic function's body is in the file, for the program to expand: the
// statement and the value it holds are the ones q's facts chose
pub fn pick[T](x: T) T {
  #if #defined("WIDE") { x } #else { nameNotDeclaredAnywhere() }
}

pub fn scaled[T](x: T) i64 {
  let k = #if #defined("WIDE") { 10i64 } #else { 20i64 };
  k + 1
}

pub fn sum(w: &Wide) i64 {
  #if #defined("WIDE") { w.a + w.b + w.c } #else { w.a }
}

pub struct Rec {
  pub a: i64;
  #if #defined("WIDE") {
    pub b: i64;
    pub fn both(self) i64 { a + b }
  }
  #else {
    pub fn both(self) i64 { a }
  }
}
