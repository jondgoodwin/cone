// The program, built without '-D WIDE': q was built with it. It holds a Wide
// of three fields, calls q's value and q's function that reads them, and builds
// a Rec of two fields: what q's object holds, not what its own facts would choose.

mod prog;

import stdio use *;
import q;

fn main() i32 {
  let w = q.Wide(3i64, 4i64, 5i64);
  printInt(w.c);
  printStr("\n");
  printInt(q.value());
  printStr("\n");
  printInt(q.sum(&w));
  printStr("\n");
  printInt(q.pick(9i64));
  printStr("\n");
  printInt(q.scaled(0i32));
  printStr("\n");
  printInt(q.Rec(6i64, 7i64).both());
  printStr("\n");
  0i32
}
