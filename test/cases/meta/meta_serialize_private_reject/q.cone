// The module that declares the types: Account has a private field and has not opted in with '@reflect'; Open has one and has.

mod q;

pub struct Account {
  pub id: i32;
  secret: i32;
}

pub struct @reflect Open {
  pub id: i32;
  hidden: i32;
}

pub fn makeAccount() Account { Account(1, 2) }
pub fn makeOpen() Open { Open(1, 2) }
