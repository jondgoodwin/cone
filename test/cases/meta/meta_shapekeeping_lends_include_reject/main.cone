// The program: Bag of package q (an include file records it ShapeChanging: it pushes onto a List it owns and lends a
// borrow of it) is refused behind '&<mut Holder + ShapeKeeping', since Holder lends from self (`first`), as it is
// inside one package. Without this the call's borrow `e` would dangle after `add` grows the list.

mod prog;

import stdio use *;
import q;

fn useIt(h: &<mut q.Holder + ShapeKeeping) i64 {
  let e = h.first();
  h.add(q.Pt(1i64, 0i64));
  e.x
}

fn main() i32 {
  var b = q.Bag.empty();
  b.add(q.Pt(7i64, 0i64));
  printInt(useIt(&mut b));                              //~ ErrorNotShapeKeeping:18 "whose include file records it as `ShapeChanging`"
  0i32
}
