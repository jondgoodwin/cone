// What an iterator chain feeding '<-' refuses when the source lends and the builder would KEEP
// the borrowed item.
//
// A lending cursor ('next' names no lifetime) gives a borrow of the cursor itself, valid
// until the next step. A list built from the items as values (stream_chains_lending) holds
// nothing of the cursor. A list of items that themselves carry the borrow ('Win' holds
// one) would hold a window into a buffer the next step overwrites, so every such form is
// refused, whatever adapters sit in the chain: the next step reshapes the cursor while the
// built list still holds a borrow into it (1339), and the cursor is gone at the end of the
// statement while the list lives on (1168).

mod stream_chains_lending_flow;

import collections use *;

struct Win['a] {
  p: &'a i64;
}

// A cursor whose item is a window onto its own field
struct Reader is Iterator[Win] {
  cur: i64;
  n: i64;

  pub fn next(self: &mut) Option[Win] {
    if n <= 0i64 { return None; }
    cur = n * 10i64;
    n = n - 1i64;
    Some[Win](new Win(&cur))
  }
}

fn bare() {
  let k = new List[Win] <- each new Reader(0i64, 3i64);             //~ ErrorShapeReshape:33 "could change the shape of a 'Reader'"
                                                                    //~^ ErrorFrozen:33 "goes out of scope while"
}

fn headerYield() {
  let k = new List[Win] <- each w in new Reader(0i64, 3i64) yield w; //~ ErrorShapeReshape:38 "could change the shape of a 'Reader'"
                                                                    //~^ ErrorFrozen:38 "goes out of scope while"
}

fn throughFilter() {
  let k = new List[Win] <- each new Reader(0i64, 3i64).filter(w => *w.p > 10i64); //~ ErrorShapeReshape:55 "could change the shape of a 'IterFilter'"
                                                                    //~^ ErrorFrozen:55 "goes out of scope while"
}

fn throughSkipTake() {
  let k = new List[Win] <- each new Reader(0i64, 3i64).skip(1usize).take(2usize); //~ ErrorShapeReshape:68 "could change the shape of a 'IterTake'"
                                                                    //~^ ErrorFrozen:68 "goes out of scope while"
}

fn main() i32 { 0i32 }
