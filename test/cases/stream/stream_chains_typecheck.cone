// What an iterator chain feeding an 'each' entry of '<-' refuses once types are known.
//
// A chain copies the items it gives borrowed as a list does, so the cursor of a list
// of Strings, which lends them, has none to copy: the message says to drain the source
// or to make a value from each item. A chain whose closure makes the value (a new
// String from each) hands it over, and a 'drain()' moves the Strings: both are fine
// (stream_chains).

mod stream_chains_typecheck;

import collections use *;

fn lentStrings(src &List[String]) {
  imm out = new List[String] <- each src.iter();                                //~ ErrorDrainItem:41 "a type that moves"
}

fn lentStringsSkipped(src &List[String]) {
  imm out = new List[String] <- each src.iter().skip(1usize);                   //~ ErrorDrainItem:48 "a type that moves"
}

fn wrongType(src &List[i64]) {
  mut out = new List[String];
  out <- each src.iter().map(x => *x + 1i64);                                   //~ ErrorNoCandidate:25 "<-"
}

fn main() i32 { 0i32; }
