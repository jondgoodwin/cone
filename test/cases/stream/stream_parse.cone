// An 'each' entry of '<-' the parser refuses.
//
// - an 'each' with variables gives what it appends with 'yield', after its source
//   and any 'if'; a body in braces, or none, is refused;
// - 'yield' needs a value.
// ('each src' with no variables needs nothing more, and a 'yield' outside such a
// header is a generator's, corout_parse's.)

mod stream_parse;

import collections use *;

fn noYield(src &List[i64]) {
  mut out = new List[i64];
  out <- each x in src;                      //~ ErrorEachEntry:23 "gives the value to append with 'yield'"
}

fn bodyInBraces(src &List[i64]) {
  mut out = new List[i64];
  out <- each x in src { *x; };              //~ ErrorEachEntry:24 "gives the value to append with 'yield'"
}

fn yieldOfNothing(src &List[i64]) {
  mut out = new List[i64];
  out <- each x in src yield;                //~ ErrorEachEntry:29 "'yield' needs the value to append"
}

fn main() i32 { 0i32; }
