// An iterator chain feeding '<- each' when the source LENDS: a cursor whose 'next' names no
// lifetime gives borrows of the cursor itself (its one buffer, refilled on every step), so an
// item is gone at the next step. A builder that makes a value from each item (a number
// copied, 'map' to a number, a field read) is safe and runs; one that would keep the
// borrowed item is refused (stream_chains_lending_flow).
//
// The chains are the ones of stream_chains over a lending cursor: map, filter, skip and take,
// zip beside a list's cursor, the header form with 'if' and 'yield', and a generator that
// yields borrows of a list it is lent.
//
// Every value printed is worked out by hand. Reader(0, 3) gives 30, 20, 10 (it counts n
// down, writing n * 10 into its one field 'cur', and lends that field); ys is 1 2 3.

mod stream_chains_lending;

import stdio use *;
import collections use *;

fn shows(label: &str, xs: &List[i64]) {
  printStr(label);
  printStr(" =");
  each x in xs {
    printStr(" ");
    printInt(*x);
  }
  printStr("\n");
}

// A lending cursor: each item is a borrow of the field 'cur', rewritten by the next step
struct Reader is Iterator[&i64] {
  cur: i64;
  n: i64;

  pub fn next(self: &mut) Option[&i64] {
    if n <= 0i64 { return None; }
    cur = n * 10i64;
    n = n - 1i64;
    Some[&i64](&cur)
  }
}

// A generator that yields borrows of the list it is lent
fn items(xs: &List[i64]) yields &i64 {
  each x in xs { yield x; }
}

fn main() {
  // map to a value: 30 20 10 plus one
  let a = new List[i64] <- each new Reader(0i64, 3i64).map(x => *x + 1i64);
  shows("map", &a);                                    // 31 21 11

  // a filter then a map: Reader(0, 4) gives 40 30 20 10; those over 20 are 40 30
  let b = new List[i64] <- each new Reader(0i64, 4i64).filter(x => *x > 20i64).map(x => *x);
  shows("filter-map", &b);                             // 40 30

  // the bare form copies a borrowed number as it does from a list
  let c = new List[i64] <- each new Reader(0i64, 3i64);
  shows("bare-copy", &c);                              // 30 20 10

  // the header form: kept above 10, the value read through the borrow
  let d = new List[i64] <- each x in new Reader(0i64, 3i64) if *x > 10i64 yield *x;
  shows("header", &d);                                 // 30 20

  // zip beside a list's cursor: 30+1, 20+2, 10+3
  var ys = new List[i64];
  ys <- 1i64, 2i64, 3i64;
  let z = new List[i64] <- each new Reader(0i64, 3i64).zip(ys.iter()).map(p => *p.0 + *p.1);
  shows("zip", &z);                                    // 31 22 13

  // skip one and take one of 30 20 10: 20
  let w = new List[i64] <- each new Reader(0i64, 3i64).skip(1usize).take(1usize).map(x => *x);
  shows("skip-take", &w);                              // 20

  // a generator yielding borrows of ys, ys extended to 1 2 3 4: the even ones times ten
  ys <- 4i64;
  let g = new List[i64] <- each items(&ys).filter(x => *x % 2i64 == 0i64).map(x => *x * 10i64);
  shows("generator", &g);                              // 20 40
  let h = new List[i64] <- each items(&ys);
  shows("generator-bare", &h);                         // 1 2 3 4
}
