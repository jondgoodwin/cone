// What an iterator chain feeding an 'each' entry of '<-' keeps borrowed while it appends.
//
// The chain starts at a borrow of the list it reads, and the entry appends through a
// borrow of the receiver, both held for every pass. So a chain that starts at the
// list being appended to is refused as 'xs <- each xs' is, whatever adapters follow
// ('.drain()' too), by the shape-changing rule (a 'mut' borrow of a local is an
// alias loan, as one through a reference other code shares is); a chain whose closure
// only reads the list being built is no danger and runs (stream_chains: the
// closure reads its length, which the append does not move); and a chain that
// starts at a list reached through a reference other code shares is refused by
// the same rule.

mod stream_chains_flow;

import collections use *;

fn mapsItself() {
  var xs = new List[i64];
  xs <- 1i64, 2i64;
  xs <- each xs.iter().map(x => *x * 2i64);                 //~ ErrorShapeReshape:23 "could change the shape of a 'List'"
}

fn filtersItself() {
  var xs = new List[i64];
  xs <- 1i64, 2i64;
  xs <- each xs.iter().filter(x => *x > 1i64).map(x => *x); //~ ErrorShapeReshape:46 "could change the shape of a 'List'"
}

fn drainsItself() {
  var xs = new List[i64];
  xs <- 1i64, 2i64;
  xs <- each xs.drain().map(x => x * 2i64);                 //~ ErrorShapeReshape:24 "could change the shape of a 'List'"
}

fn throughAReference(out: &mut List[i64], src: &List[i64]) {
  out <- each src.iter().map(x => *x);                      //~ ErrorShapeReshape:25 "could change the shape of a 'List'"
}

fn main() i32 { 0i32 }
