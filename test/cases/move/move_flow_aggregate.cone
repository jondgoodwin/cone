// What it costs to move a move value out of part of something, rather than out
// of a whole variable.
//
// Moving a field out is refused (move_flow_field has every shape), and the
// refused move leaves the struct as it was: its fields are still readable.
// Moving an array element deactivates the variable holding the whole array, not
// just the element moved, so the elements not moved go with it. Moving out of
// a global is refused outright, since a global has no scope in which a
// deactivated state could be recovered.
//
// Split from move_flow_deactivate because these are rules about which sources
// may be moved from and what else the move takes down with it, not about which
// operations move. One function, because flow analysis stops after the first
// error.

mod move_flow_aggregate;

struct Handle is Move {
  pub id i32;
}

struct Wrapper {
  pub h Handle;
  pub n i32;
}

// A global of move type, for the case below
mut shared = Handle[1];

fn main() i32 {
  // Moving the field out is refused, and the struct is still whole: neither
  // its other field nor the field itself is refused as moved out
  mut w = Wrapper[Handle[2], 3];
  imm taken = w.h;           //~ ErrorMoveField:16 "field 'h'"
  imm useN = w.n;
  imm useH = w.h.id;

  // An indexed element behaves the same way: the array variable is deactivated,
  // so the elements not moved are unreachable too
  mut arr [2; Handle] = [Handle[4], Handle[5]];
  imm first = arr[0];
  imm useSecond = arr[1].id; //~ ErrorMove:19 "moved out"

  // A global has no owner to hand the value back to, so the move is refused
  imm stolen = shared;       //~ ErrorInvType:16 "out of a global variable"

  0i32;
}
