// A type holding a List of itself moves (move_recursive_list), so the List's
// methods that exist only where the element is Copy are absent from it, as they
// are for any element that moves: 'resize' is refused at its call, and the
// declaration itself is accepted. A struct, an enum and two structs each
// holding a List of the other all answer the same, whichever is laid out first.

mod move_typecheck_recursive_list;

import collections use *;

struct Node {
  pub id i64;
  pub kids List[Node];
}

enum Tree {
  Leaf(i64);
  Branch(List[Tree]);
}

struct Pa {
  pub bs List[Pb];
}

struct Pb {
  pub as_ List[Pa];
}

// The List's element holds the type in a tuple, the List is a value of a
// Dict, or a generic struct holds it in a List
struct Tagged {
  pub id i64;
  pub kids List[(i32, Tagged)];
}

struct Grouped {
  pub groups Dict[String, List[Grouped]];
}

struct Wrap[T] {
  pub v List[T];
}

struct Wrapped {
  pub w List[Wrap[Wrapped]];
}

fn nested(tg &mut List[(i32, Tagged)], gs &mut List[Grouped], ws &mut List[Wrapped]) {
  tg.resize(2usize, (1i32, new Tagged(1, List[(i32, Tagged)].empty())));   //~ ErrorWhereAbsent "No method resize for List[a tuple]"
  gs.resize(2usize, new Grouped(Dict[String, List[Grouped]].empty()));     //~ ErrorWhereAbsent "No method resize for List[Grouped]"
  ws.resize(2usize, new Wrapped(List[Wrap[Wrapped]].empty()));             //~ ErrorWhereAbsent "No method resize for List[Wrapped]"
}

fn grow(ns &mut List[Node], ts &mut List[Tree], pas &mut List[Pa], pbs &mut List[Pb], n Node) {
  ns.resize(2usize, n);                                    //~ ErrorWhereAbsent "No method resize for List[Node]: it exists only where T is Copy, and Node is not Copy"
  ts.resize(2usize, Tree.Leaf(1));                         //~ ErrorWhereAbsent "No method resize for List[Tree]"
  pas.resize(2usize, new Pa(List[Pb].empty()));            //~ ErrorWhereAbsent "No method resize for List[Pa]"
  pbs.resize(2usize, new Pb(List[Pa].empty()));            //~ ErrorWhereAbsent "No method resize for List[Pb]"
}
