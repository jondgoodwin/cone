// A tuple holding a move value is itself a move value, and naming a move value
// in a tuple literal deactivates the source.
//
// A tuple is like a struct: if any element's type has move semantics, so does
// the tuple's. A tuple type has no declaration to carry the MoveType flag, so
// itypeIsMove asks its elements instead. A tuple literal has no storage of its
// own either, so flowHandleMove deactivates each move-typed element's source and
// leaves a copyable element's alone.
//
// Before this was so, the tuple copied freely: two variables held the one
// handle, and the variable it was built from still did too.
//
// One function again, because flow diagnostics accumulate within a function.

mod move_flow_tuple;

struct Handle is Move {
  pub id i32;
}

fn pair() Handle, i32 {
  Handle[1], 2;
}

fn take(t (Handle, i32)) i32 {
  t.1;
}

fn main() i32 {
  // Building the tuple moves the handle out of its variable ...
  imm h = Handle[3];
  imm n = 4;
  imm t = h, n;
  imm useH = h.id;      //~ ErrorMove "moved out"
  // ... while the copyable element stays where it was
  imm useN = n;

  // The tuple moves like the handle it holds: the second copy is refused
  imm t2 = t;
  imm t3 = t;           //~ ErrorMove "moved out"

  // A tuple returned by a call holds the value the same way
  imm p = pair();
  imm p2 = p;
  imm p3 = p;           //~ ErrorMove "moved out"

  // Assigning it moves it too
  mut a = pair();
  imm b = pair();
  a = b;
  imm useB = b;         //~ ErrorMove "moved out"

  // Passing it to a function moves it there
  imm q = Handle[5], 6;
  take(q);
  take(q);              //~ ErrorMove "moved out"

  0i32;
}
