// Two owners of one region that differ only in permission meet as the closest
// permission both coerce to, for every pair of static permissions: 'Rc', 'Uni'
// (which takes no 'mut') and a few of 'Arc', in an 'if', a 'match' (its arms the
// other way round), a loop's breaks, a closure's return and an array literal.
// Each case checks the value of the arm taken, that a source whose coercion
// copies it is still usable, and that the two values were finalized once each.
// A line per pair gives the joined permission and 'ok'; a failed check prints
// 'BAD' before it. ('opaq' reaches no value, so only the releases are checked.)

mod move_permission_meet_pairs;

import stdio use *;
import sync use Arc;

var @threadlocal finals: i32 = 0;
var @threadlocal sum: i32 = 0;
var @threadlocal bad: i32 = 0;

struct N {
  pub n: i32;
  fn final(self: &uni) { finals += 1; sum += n; }
}

fn want(what: &str, got: i32, expect: i32) {
  if got != expect {
    printStr("BAD value "); printStr(what); printStr(" "); printInt(got); printStr("\n");
    bad += 1;
  }
}

fn done(what: &str) {
  if finals != 2 || sum != 11 {
    printStr("BAD release "); printStr(what); printStr(" "); printInt(finals);
    printStr(" "); printInt(sum); printStr("\n");
    bad += 1;
  }
  finals = 0;
  sum = 0;
}

fn report(what: &str) {
  printStr(what);
  printStr(if bad == 0 {" ok\n"} else {" BAD\n"});
  bad = 0;
}

fn if_Rc_uni_mut(c: bool) {
  let a = Rc[uni, N](N(1));
  let b = Rc[mut, N](N(10));
  let r = if c {a} else {b};
  want("Rc_uni_mut", r.n, if c {1} else {10});
  want("Rc_uni_mut kept", b.n, 10);
}
fn match_Rc_uni_mut(c: bool) {
  let a = Rc[uni, N](N(1));
  let b = Rc[mut, N](N(10));
  let r = match c { case true {b} else {a} };
  want("Rc_uni_mut", r.n, if c {10} else {1});
  want("Rc_uni_mut kept", b.n, 10);
}
fn break_Rc_uni_mut(c: bool) {
  let a = Rc[uni, N](N(1));
  let b = Rc[mut, N](N(10));
  let r = while { if c { break a; } if !c { break b; } };
  want("Rc_uni_mut", r.n, if c {1} else {10});
  want("Rc_uni_mut kept", b.n, 10);
}
fn closure_Rc_uni_mut(c: bool) {
  let pick = fn(c: bool) {
    let a = Rc[uni, N](N(1));
    let b = Rc[mut, N](N(10));
    if c {b} else {a}
  };
  let r = pick(c);
  want("Rc_uni_mut", r.n, if c {10} else {1});
}
fn array_Rc_uni_mut() {
  let a = Rc[uni, N](N(1));
  let b = Rc[mut, N](N(10));
  let l = [a, b];
  want("Rc_uni_mut", l[0u].n, 1);
  want("Rc_uni_mut", l[1u].n, 10);
  want("Rc_uni_mut kept", b.n, 10);
}
