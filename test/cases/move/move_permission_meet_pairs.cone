fn run0() {
  if_Rc_uni_mut(true); done("if Rc_uni_mut true");
  if_Rc_uni_mut(false); done("if Rc_uni_mut false");
  match_Rc_uni_mut(true); done("match Rc_uni_mut true");
  match_Rc_uni_mut(false); done("match Rc_uni_mut false");
  break_Rc_uni_mut(true); done("break Rc_uni_mut true");
  break_Rc_uni_mut(false); done("break Rc_uni_mut false");
  closure_Rc_uni_mut(true); done("closure Rc_uni_mut true");
  closure_Rc_uni_mut(false); done("closure Rc_uni_mut false");
  array_Rc_uni_mut(); done("array Rc_uni_mut");
  report("Rc uni mut: mut");
  if_Rc_uni_imm(true); done("if Rc_uni_imm true");
