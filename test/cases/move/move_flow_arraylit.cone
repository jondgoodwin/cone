// Naming a move value in an array literal's element deactivates the source, and
// so does naming one in an array's contents, once for each element it fills.
//
// The list form '[a, b]' gives every element a holder of its own, so each value
// is moved or copied on the same rule as a function call's argument: arrayLitFlow
// hands each one to flowHandleMoveOrCopy, exactly as move_flow_literal's type
// literal does with its field values.
//
// An array's contents that repeat a value, 'Array[Handle, 2]() <- fill x' or
// '<- 2 of x', evaluate x for each element. A construction there builds a new
// value each time, so a move type repeats freely; a variable there is moved
// into the first element, and the second finds it gone, by the same rule. So
// it is for any collection's 'n of x', which appends in a loop, and for an
// array's contents repeating a value many times, which generate it once, in a
// loop: the second element finds the variable gone, and is refused once.
//
// While array literals were treated as leaves by flow analysis, the list form
// compiled clean and the read below was a use after move.

mod move_flow_arraylit;

struct Handle is Move {
  pub id: i32;
}

// A collection whose '<-' takes a Handle
struct Bag {
  pub count: i32;
  pub fn put overload `<-`(self: &mut, h: Handle) { count = count + 1; }
}

// 'n of x' appends x evaluated once for each, in a loop: a variable is moved
// by the first pass and gone for the next, as in any loop
fn repeatedIntoBag() {
  var bag = Bag(0);
  bag <- 2 of Handle(1);
  let kept = Handle(2);
  bag <- 2 of kept;                                //~ ErrorMove
}

fn main() i32 {
  let hd = Handle(7);
  let arr: Array[Handle, 2] = [hd, Handle(8)];

  let two = Array[Handle, 2]() <- fill Handle(9);
  let one = Array[Handle, 3]() <- 2 of Handle(10), Handle(11);

  let kept = Handle(12);
  let twice = Array[Handle, 2]() <- fill kept;  //~ ErrorMove

  let built = Array[Handle, 20]() <- fill Handle(13);
  let kept2 = Handle(14);
  let gone = Array[Handle, 20]() <- fill kept2;  //~ ErrorMove

  hd.id                     //~ ErrorMove
}
