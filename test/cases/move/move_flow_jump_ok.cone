// A path that ends in 'break' or 'continue' leaves the code after the branch it
// ends, as a 'return' does: a value moved on it is not moved for that code. The
// state the jump leaves goes to its loop instead, which joins it where the loop
// ends with every other path out of its body, so a value it moved is moved after
// the loop, and on the next pass of a loop whose variable it is
// (move_flow_jump has the refusals).
//
// Each function runs once down each path. The finalizer prints its number, so
// the output is the whole assertion: every value finalized exactly once, by
// whoever holds it last.
//
// - The backlog's three shapes: a pass's own value moved on a branch that
//   continues, in an 'each' over a drain, in a 'while', and with the move and the
//   'continue' inside two 'if's; and the same on a branch that breaks.
// - A value declared before the loop, moved on a branch that breaks, read after
//   the branch in the same pass; moved and given a new value on a branch that
//   continues, read on the next pass and after the loop; moved and given a new
//   value on a branch that breaks, read after the loop; in a loop with no
//   condition, moved on a branch that continues and given a new value at the
//   top of each pass, read after the loop.
// - A labelled 'break' out of an outer loop and a labelled 'continue' of one,
//   from inside an inner loop.
// - The jump in a 'match' arm, in a 'let ... else', in both arms of an 'if', in
//   a loop with an 'else' (a 'break' with a value), in an 'each' over a range.
// - A sole owner hollowed on a branch that continues.

mod move_flow_jump_ok;

import stdio use *;
import collections use *;

struct Fin {
  pub v: i32;
  fn final(self: &uni) { printStr("F"); printInt(i64.from(v)); printStr(" "); }
}

fn take(f: Fin) { printStr("take"); printInt(i64.from(f.v)); printStr(" "); }
fn look(f: &Fin) i32 { f.v }
fn show(f: &Fin) { printInt(i64.from(f.v)); printStr(" "); }
fn line(label: &str) { printStr("| "); printStr(label); printStr("\n"); }
fn opt(i: i32) Option[i32] { if i == 2 { None } else { Some(i) } }

struct Ev { pub kind: u32; pub buf: List[u8]; }
fn takeEv(e: Ev) { }

fn events() List[Ev] {
  var l = List[Ev].empty();
  l.push(Ev(1u32, List[u8].empty()));
  var b = List[u8].empty();
  b.push(7u8);
  b.push(8u8);
  l.push(Ev(2u32, b));
  var c = List[u8].empty();
  c.push(9u8);
  l.push(Ev(3u32, c));
  l
}

// The backlog's shape: each over a drain
fn eachCont(l: &mut List[Ev]) usize {
  var n = 0usize;
  each ev in l.drain() {
    var e = ev;
    if e.kind == 1u32 {
      takeEv(e);
      continue;
    }
    n = n + e.buf.len();
  }
  n
}

fn whileCont() {
  var i = 0;
  while i < 3 {
    i = i + 1;
    let a = Fin(i);
    if i == 2 { take(a); continue; }
    show(&a);
  }
  printStr("end ");
}

fn nestedCont(ok: bool) {
  var i = 0;
  while i < 3 {
    i = i + 1;
    let a = Fin(10 + i);
    if i == 2 {
      if ok {
        take(a);
        continue;
      }
    }
    show(&a);
  }
  printStr("end ");
}

fn whileBreak() {
  var i = 0;
  while i < 3 {
    i = i + 1;
    let a = Fin(20 + i);
    if i == 2 { take(a); break; }
    show(&a);
  }
  printStr("end ");
}

fn outerBreak(n: i32) {
  let a = Fin(30);
  var i = 0;
  while i < 3 {
    i = i + 1;
    if i == n { take(a); break; }
    show(&a);
  }
  printStr("end ");
}

fn refilledCont() {
  var a = Fin(40);
  var i = 0;
  while i < 3 {
    i = i + 1;
    if i == 2 { take(a); a = Fin(41); continue; }
    show(&a);
  }
  show(&a);
  printStr("end ");
}

fn refilledBreak(n: i32) {
  var a = Fin(45);
  var i = 0;
  while i < 3 {
    i = i + 1;
    if i == n { take(a); a = Fin(46); break; }
  }
  show(&a);
  printStr("end ");
}

// A loop with no condition leaves only by its break, after the pass's store:
// what a continue moved is given a new value first
fn givenAtTop(n: i32) {
  var a = Fin(100);
  var i = 0;
  while {
    i = i + 1;
    a = Fin(100 + i);
    if i < n { take(a); continue; }
    if i >= n { break; }
  }
  show(&a);
  printStr("end ");
}

fn labelledBreak(n: i32) {
  let a = Fin(50);
  var i = 0;
  'outer: while i < 3 {
    i = i + 1;
    var j = 0;
    while j < 2 {
      j = j + 1;
      if i == n { take(a); break 'outer; }
    }
    show(&a);
  }
  printStr("end ");
}

fn labelledCont() {
  'outer: each i in 1 ..= 3 {
    let a = Fin(55 + i);
    each j in 1 ..= 2 {
      if i == 2 { take(a); continue 'outer; }
    }
    show(&a);
  }
  printStr("end ");
}

fn matchCont() {
  var i = 0;
  while i < 3 {
    i = i + 1;
    let a = Fin(60 + i);
    match i {
      case 2 { take(a); continue; }
      else { }
    }
    show(&a);
  }
  printStr("end ");
}

fn letElseCont() {
  var i = 0;
  while i < 3 {
    i = i + 1;
    let a = Fin(65 + i);
    let Some(k) = opt(i) else { take(a); continue; };
    printInt(i64.from(look(&a) + k));
    printStr(" ");
  }
  printStr("end ");
}

fn bothJump() {
  var i = 0;
  while i < 4 {
    i = i + 1;
    let a = Fin(70 + i);
    if i == 2 { take(a); continue; }
    if i == 4 { take(a); break; } else { show(&a); continue; }
  }
  printStr("end ");
}

fn loopElse(n: i32) {
  let a = Fin(80);
  var i = 0;
  let r = while i < 3 {
    i = i + 1;
    if i == n { take(a); break 1; }
    show(&a);
  } else {
    0
  };
  printInt(i64.from(r));
  printStr(" end ");
}

fn eachRange() {
  each i in 1 ..= 3 {
    let a = Fin(85 + i);
    if i == 2 { take(a); continue; }
    show(&a);
  }
  printStr("end ");
}

fn hollowCont() {
  var i = 0;
  while i < 3 {
    i = i + 1;
    let b = Uni[Fin](90 + i);
    if i == 2 { take(*b); continue; }
    show(&*b);
  }
  printStr("end ");
}

fn main() i32 {
  var l = events();
  printInt(i64.from(eachCont(&mut l))); printStr(" "); line("each over a drain, continue");
  whileCont(); line("while, continue");
  nestedCont(true); line("two ifs, continue taken");
  nestedCont(false); line("two ifs, continue not taken");
  whileBreak(); line("while, break");
  outerBreak(2); line("declared before the loop, break taken");
  outerBreak(9); line("declared before the loop, break not taken");
  refilledCont(); line("given a new value, continue");
  refilledBreak(2); line("given a new value, break taken");
  refilledBreak(9); line("given a new value, break not taken");
  givenAtTop(3); line("no condition, given a value at the top of each pass");
  labelledBreak(2); line("labelled break taken");
  labelledBreak(9); line("labelled break not taken");
  labelledCont(); line("labelled continue");
  matchCont(); line("match arm, continue");
  letElseCont(); line("let else, continue");
  bothJump(); line("both arms jump");
  loopElse(2); line("loop with else, break taken");
  loopElse(9); line("loop with else, ran out");
  eachRange(); line("each over a range, continue");
  hollowCont(); line("hollowed, continue");
  0i32
}
