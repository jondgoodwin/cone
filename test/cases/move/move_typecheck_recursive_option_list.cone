// A type holding a List of an Option of itself moves (move_recursive_option_list),
// because the List does, and an Option of a type that moves moves. So the List's
// methods that exist only where its element is Copy are absent from it: 'resize'
// is refused at its call, and the declarations are accepted. The member's clause
// is decided once Option[Node] has been laid out, not while Node's layout is in
// flight, so the answer does not depend on the order the declarations are written.

mod move_typecheck_recursive_option_list;

import collections use *;

struct Node {
  pub id i64;
  pub kids List[Option[Node]];
}

enum Tree {
  Leaf(i64);
  Branch(List[Option[Tree]]);
}

struct Pa {
  pub bs List[Option[Pb]];
}

struct Pb {
  pub as_ List[Option[Pa]];
}

fn grow(ns &mut List[Option[Node]], ts &mut List[Option[Tree]], pas &mut List[Option[Pa]], pbs &mut List[Option[Pb]]) {
  ns.resize(2usize, None[Node]);       //~ ErrorWhereAbsent "No method resize for List[Option[Node]]"
  ts.resize(2usize, None[Tree]);       //~ ErrorWhereAbsent "No method resize for List[Option[Tree]]"
  pas.resize(2usize, None[Pa]);        //~ ErrorWhereAbsent "No method resize for List[Option[Pa]]"
  pbs.resize(2usize, None[Pb]);        //~ ErrorWhereAbsent "No method resize for List[Option[Pb]]"
}
