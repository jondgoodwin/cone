// The one field of a variant, taken out by a match that holds the value it
// takes apart in a variable of its own (a call's answer, or a value the match
// consumes), moves with the whole of that value. The variant has nothing else to
// leave behind, so the matched value is not finalized again: every path out of
// the match finalizes each Fin exactly once.
//
// - an Option a call answers, 'Some', whose payload moves into a variable;
// - a Result, 'Ok' moving its payload, the other arm leaving the value alone;
// - a value held in a variable that the match consumes whole;
// - the payload handed back, passed on, and kept past the match;
// - an arm that does not take the payload (it dies with the matched value).

mod move_match_payload;

import stdio use *;

struct Fin {
  pub id i32;

  fn final(self &uni) {
    printStr("fin");
    printInt(i64.from(id));
    printStr(" ");
  }
}

fn nl() {
  printStr("\n");
}

fn maybe(n i32) Option[Fin] {
  if n > 0i32 { return Some[Fin][new Fin(n)]; }
  None[Fin][];
}

fn result(n i32) Result[Fin, i32] {
  if n > 0i32 { return Ok[Fin, i32][new Fin(n)]; }
  Error[Fin, i32][n];
}

fn take(f Fin) {
  printStr("take");
  printInt(i64.from(f.id));
  printStr(" ");
}

// The payload handed back out of the match
fn unwrapOr(n i32) Fin {
  match maybe(n) {
    case mut s Some { s.value; }
    case is None[Fin] { new Fin(100i32); }
  }
}

fn options() {
  match maybe(1i32) {
    case mut s Some {
      imm f = s.value;
      printStr("got");
      printInt(i64.from(f.id));
      printStr(" ");
    }
    case is None[Fin] { printStr("none "); }
  }
  nl();                                    // got1 fin1
  match maybe(0i32) {
    case mut s Some { take(s.value); }
    case is None[Fin] { printStr("none "); }
  }
  nl();                                    // none
  match maybe(2i32) {
    case mut s Some { take(s.value); }     // passed on, finalized there
    case is None[Fin] { printStr("none "); }
  }
  nl();                                    // take2 fin2
}

fn results() {
  match result(3i32) {
    case mut ok Ok {
      imm f = ok.value;
      printStr("ok");
      printInt(i64.from(f.id));
      printStr(" ");
    }
    case mut bad Error { printStr("bad "); }
  }
  nl();                                    // ok3 fin3
  match result(-1i32) {
    case mut ok Ok { take(ok.value); }
    case mut bad Error {
      printStr("bad");
      printInt(i64.from(bad.value));
      printStr(" ");
    }
  }
  nl();                                    // bad-1
}

fn held() {
  imm r Result[Fin, i32] = Ok[Fin, i32][new Fin(4i32)];
  match r {                                // r is consumed whole
    case mut ok Ok { take(ok.value); }
    case mut bad Error { printStr("bad "); }
  }
  nl();                                    // take4 fin4
}

fn kept() {
  mut keep = new Fin(0i32);
  match maybe(5i32) {
    case mut s Some { keep <=> s.value; }  // swapped, not taken: the 5 dies with the matched value
    case is None[Fin] {}
  }
  printStr("kept");
  printInt(i64.from(keep.id));
  printStr(" ");
  nl();                                    // fin0 kept5 ... then fin5 at the end of the function
}

fn notTaken() {
  match maybe(6i32) {
    case mut s Some { printStr("seen "); }  // the payload is left in the value, finalized with it
    case is None[Fin] {}
  }
  nl();                                    // seen fin6
}

fn main() i32 {
  options();
  results();
  held();
  kept();
  notTaken();
  imm back = unwrapOr(7i32);
  printStr("back");
  printInt(i64.from(back.id));
  printStr(" ");
  imm other = unwrapOr(0i32);
  printStr("back");
  printInt(i64.from(other.id));
  printStr(" ");
  nl();                                    // back7 back100
  0i32;
}
