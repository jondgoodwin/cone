// Nothing moves out of a field. A move-typed value held by a struct's field,
// or by a tuple's element, may not be moved out of it: the struct would be left
// with a hole in it, which it could neither be used with nor finalized with.
// Swap a value in with '<->' (move_success), or move the whole struct, which
// takes every field with it.
//
// The refusal is the same wherever the struct is -- a local, a parameter, a
// by-value 'self', behind a sole owner or a shared one or a borrow, a
// temporary, a generic's instance -- wherever the value is going -- a
// variable, a call, a literal, a by-value 'self', back to the caller directly
// or through a block, an 'if' or a loop's 'break' -- and however deep the field
// is. A value reached through a field is refused too: what an owning reference
// held in a field points at, or an element of an array held in one. The struct
// is not deactivated by the refused move, so nothing after it is refused as a
// use of a moved-out value. Copying a copy-typed field is unaffected.

mod move_flow_field;

struct Handle is Move {
  pub id: i32;
  pub fn byValue(self) i32 { id }
}

struct Wrapper {
  pub h: Handle;
  pub n: i32;
}

struct Nest {
  pub w: Wrapper;
}

struct Holder {
  pub r: Uni[Handle];
  pub n: i32;
}

struct Row {
  pub hs: Array[Handle, 2];
}

struct Keeper {
  pub h: Handle;
  pub n: i32;

  // The field of a by-value 'self', named bare and through 'self'
  pub fn give(self) Handle {
    h                                //~ ErrorMoveField:5 "field 'h'"
  }
  pub fn keep(self) i32 {
    let k = self.h;                   //~ ErrorMoveField:17 "field 'h'"
    k.id
  }
}

struct Wrap[T] {
  pub v: T;
  pub n: i32;

  // Refused where T is a move type, and only there
  pub fn unwrap(self) T {
    v                                //~ ErrorMoveField:5 "field 'v'"
  }
}

fn take(h: Handle) {}
fn makeWrapper() Wrapper { Wrapper(Handle(1), 2) }

fn intoLocal() i32 {
  let w = Wrapper(Handle(1), 2);
  let h = w.h;                        //~ ErrorMoveField:12 "field 'h'"
  w.n
}

fn intoCall(w: Wrapper) {
  take(w.h);                          //~ ErrorMoveField:9 "field 'h'"
}

fn intoLiteral(w: Wrapper) Wrapper {
  Wrapper(w.h, 3)                //~ ErrorMoveField:12 "field 'h'"
}

fn intoSelf(w: Wrapper) i32 {
  w.h.byValue()                      //~ ErrorMoveField:4 "field 'h'"
}

fn assigned(w: Wrapper) {
  var h = Handle(4);
  h = w.h;                            //~ ErrorMoveField:8 "field 'h'"
}

fn nested(n: Nest) Handle {
  n.w.h                              //~ ErrorMoveField:6 "field 'h'"
}

fn returned(w: Wrapper) Handle {
  return w.h;                         //~ ErrorMoveField:11 "field 'h'"
}

fn outOfBlock(w: Wrapper) Handle {
  {w.h}                             //~ ErrorMoveField:5 "field 'h'"
}

fn outOfIf(w: Wrapper, pick: bool) Handle {
  if pick {w.h} else {Handle(5)}  //~ ErrorMoveField:13 "field 'h'"
}

fn outOfLoop(w: Wrapper) Handle {
  while {
    if true {break w.h;};             //~ ErrorMoveField:21 "field 'h'"
  }
}

fn boundFromBlock(w: Wrapper) {
  let h = {w.h};                     //~ ErrorMoveField:13 "field 'h'"
}

fn ofTemporary() {
  let h = makeWrapper().h;            //~ ErrorMoveField:24 "field 'h'"
}

fn throughSoleOwner() {
  let b = Uni[Wrapper](Handle(6), 7);
  let h = b.h;                        //~ ErrorMoveField:12 "field 'h'"
}

fn throughCountedOwner() {
  let b = Rc[Wrapper](Handle(8), 9);
  let h = b.h;                        //~ ErrorMoveField:12 "field 'h'"
}

fn throughSharedOwner() {
  let b = Rc[mut, Wrapper](Handle(10), 11);
  let h = b.h;                        //~ ErrorMoveField:12 "field 'h'"
}

fn throughBorrow(r: &mut Wrapper) Handle {
  r.h                                //~ ErrorMoveField:4 "field 'h'"
}

// An owning reference held in a field: neither it nor what it points at
fn owningField(o: Holder) {
  let r = o.r;                        //~ ErrorMoveField:12 "field 'r'"
}

fn throughOwningField(o: Holder) {
  let h = *o.r;                       //~ ErrorMoveField:11 "through field 'r'"
}

fn elementOfArrayField(row: Row) {
  let h = row.hs[0];                  //~ ErrorMoveField:17 "through field 'hs'"
}

fn tupleElement() {
  let t = Handle(12), 13;
  let h = t.0;                        //~ ErrorMoveField:12 "element 0"
}

fn genericInstance() i32 {
  let w = Wrap[Handle](Handle(14), 15);
  let h = w.unwrap();
  let c = Wrap[i32](16, 17);
  c.unwrap()
}

// Not refused: a copy-typed field copies, and the whole struct moves
fn copiedField(w: Wrapper) i32 {
  let n = w.n;
  let id = w.h.id;
  let whole = w;
  n + id + whole.n
}

fn main() i32 {
  0i32
}
