// A move value may not be moved out through a borrowed reference.
//
// A borrowed reference does not own what it points at: the value still belongs
// to the place that was borrowed, which will finalize or free it at the end of
// its own scope. Moving the value out through the borrow would make a second
// owner of it, and both would finalize it. So every way a value can leave --
// returned, bound, assigned, passed, built into a literal or a tuple, handed
// back by a block, an 'if' or a loop, or taken as a method's by-value 'self' --
// is refused when its source is reached through a borrow. The permission does
// not matter: a '&uni' is the only way to the value while it lives, but it
// still does not own it. A field reached through a borrow is refused as a
// field, before the borrow is asked about (move_flow_field).
//
// A copy value reads out through a borrow freely, and a move value can still be
// taken out of a borrowed place with swap or left-assignment, which leave the
// place holding a value; move_success runs both.
//
// One refusal per function, so that each is reported whatever flow analysis
// does after the first error in a function.

mod move_flow_borrow;

struct @move Handle {
  pub id i32;
  pub fn byValue(self) i32 { id; }
}

struct Wrapper {
  pub h Handle;
  pub n i32;
}

fn returned(r &Handle) Handle {
  *r;                              //~ ErrorMoveOut:3 "through a borrowed reference"
}

fn returnedMut(r &mut Handle) Handle {
  *r;                              //~ ErrorMoveOut:3 "through a borrowed reference"
}

fn returnedUni(r &uni Handle) Handle {
  *r;                              //~ ErrorMoveOut:3 "through a borrowed reference"
}

fn returnedEarly(r &Handle, c Bool) Handle {
  if c {
    return *r;                     //~ ErrorMoveOut:12 "through a borrowed reference"
  }
  Handle[1];
}

fn bound(r &Handle) {
  imm h = *r;                      //~ ErrorMoveOut:11 "through a borrowed reference"
}

fn assigned(r &Handle, d Handle) {
  mut h = d;
  h = *r;                          //~ ErrorMoveOut:7 "through a borrowed reference"
}

fn take(h Handle) {}

fn passed(r &Handle) {
  take(*r);                        //~ ErrorMoveOut:8 "through a borrowed reference"
}

fn selfByValue(r &Handle) i32 {
  r.byValue();                     //~ ErrorMoveOut:3 "through a borrowed reference"
}

fn element(s &[]Handle) {
  imm h = s[0];                    //~ ErrorMoveOut:12 "through a borrowed reference"
}

fn literal(r &Handle) Wrapper {
  Wrapper[*r, 2];                  //~ ErrorMoveOut:11 "through a borrowed reference"
}

fn tuple(r &Handle) (Handle, i32) {
  (*r, 3);                         //~ ErrorMoveOut:4 "through a borrowed reference"
}

fn block(r &Handle) {
  imm h = { *r; };                 //~ ErrorMoveOut:13 "through a borrowed reference"
}

fn branch(r &Handle, c Bool) Handle {
  if c { *r; } else { Handle[4]; } //~ ErrorMoveOut:10 "through a borrowed reference"
}

fn loopBreak(r &Handle, c Bool) {
  imm h = while {
    if c { break *r; }             //~ ErrorMoveOut:18 "through a borrowed reference"
  };
}

fn main() {
}
