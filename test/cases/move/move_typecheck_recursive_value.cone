// A type may hold a List of itself (move_recursive_list) because a List holds
// its elements through a pointer, but not itself by value: directly, in an
// array or in an enum's variant stays refused as infinitely sized.
//
// Not pinned: an Option of the type, held by value or as a List's element, is
// refused too (the error is reported inside core's Option, whose payload holds
// the type by value), and a tuple holding the type by value is accepted.

mod move_typecheck_recursive_value;

struct ByArray {
  pub id i64;
  pub two Array[ByArray, 2];        //~ ErrorNoSize "An array cannot be made of this element type: ByArray contains ByArray by value: infinite size"
}

enum Chain {
  End;
  Link(Chain);                      //~ ErrorNoSize "Chain contains Link contains Chain by value: infinite size"
}
