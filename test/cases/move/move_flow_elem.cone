// Nothing moves out of an indexed element of an array held by value. A
// move-typed value held by an element of a local array, a parameter or a
// temporary may not be moved out of it: the array would be left with a hole in
// it, which it could neither be used with nor finalized with, and the elements
// that stayed would never be finalized. Swap a value in with '<=>', or move the
// whole array, which takes every element with it.
//
// The refusal is the same wherever the value is going -- a variable, a call, back
// to the caller -- and however deep the element is. The refused move does not
// deactivate the array, so nothing after it is refused as a use of a moved-out
// value. Copying a copy-typed element, reading a field of an element, swapping
// an element and borrowing one are unaffected.

mod move_flow_elem;

struct Handle is Move {
  pub id i32;
}

fn take(h Handle) {}
fn make() Array[Handle, 2] { [new Handle(1), new Handle(2)]; }

fn intoLocal() i32 {
  mut arr Array[Handle, 2] = [new Handle(1), new Handle(2)];
  imm first = arr[0];        //~ ErrorMoveElem:18 "element of an array"
  arr[1].id;
}

fn intoCall() {
  mut arr Array[Handle, 2] = [new Handle(1), new Handle(2)];
  take(arr[1]);              //~ ErrorMoveElem:11 "element of an array"
  take(arr[0]);              //~ ErrorMoveElem:11 "element of an array"
}

fn fromParam(arr Array[Handle, 2]) {
  take(arr[0]);              //~ ErrorMoveElem:11 "element of an array"
}

fn handedBack(arr Array[Handle, 2]) Handle {
  arr[1];                    //~ ErrorMoveElem:6 "element of an array"
}

fn fromTemporary() {
  take([new Handle(1), new Handle(2)][0]); //~ ErrorMoveElem:38 "element of an array"
  take(make()[1]);           //~ ErrorMoveElem:14 "element of an array"
}

fn nested() {
  mut grid Array[Array[Handle, 2], 2] = [[new Handle(1), new Handle(2)], [new Handle(3), new Handle(4)]];
  take(grid[1][0]);          //~ ErrorMoveElem:15 "element of an array"
}

// What is not a move out of an element
fn allowed() i32 {
  mut nums = [1, 2, 3];
  imm n = nums[1];
  mut arr Array[Handle, 2] = [new Handle(1), new Handle(2)];
  mut out = new Handle(9);
  arr[0] <=> out;
  imm id = arr[1].id;
  imm both = arr;
  n + id + out.id;
}

fn main() i32 {
  0i32;
}
