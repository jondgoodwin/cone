// A local declared without a value may be read only where every path reaching
// the read has given it one, whatever its type. The check once ran only for a
// variable that moves or has something to do as it dies (move_flow_paths); a
// number, a struct of plain data, a borrowed reference or a raw pointer given
// its value in one arm of an 'if' was read on the paths that gave it nothing,
// and a reference dereferenced then pointed at garbage. The accepted
// neighbours are in move_flow_maybe_uninit_ok.

mod move_flow_maybe_uninit;

struct Pt {
  pub x i32;
  pub y i32;
}

enum Dir {
  Up, Down, Left;
}

mut gcell i32 = 7;

// A number given a value on one branch only
fn numberOneArm(c i32) i32 {
  mut n i32;
  if c > 0 { n = 2; }
  n + 1;                //~ ErrorMove:3 "may not have been given a value"
}

// A borrowed reference given one on one branch, then dereferenced
fn refDeref(c i32, x &i32) i32 {
  mut r &i32;
  if c > 0 { r = x; }
  *r;                   //~ ErrorMove:4 "may not have been given a value"
}

// A struct of plain data, then a field read
fn structField(c i32) i32 {
  mut p Pt;
  if c > 0 { p = new Pt(1, 2); }
  p.x;                  //~ ErrorMove:3 "may not have been given a value"
}

// A raw pointer, then read through
fn rawPointer(c i32) i32 {
  mut p *i32;
  if c > 0 { p = &gcell; }
  *p;                   //~ ErrorMove:4 "may not have been given a value"
}

// An 'if' with an 'else' that assigns in one arm only
fn oneArmOfTwo(c i32) i32 {
  mut n i32;
  if c > 0 { n = 2; } else { gcell = 3; }
  n;                    //~ ErrorMove:3 "may not have been given a value"
}

// A match with one arm assigning
fn matchOneArm(d Dir) i32 {
  mut n i32;
  match d {
    case is Up { n = 1; }
    case is Down { gcell = 2; }
    case is Left { gcell = 3; }
  }
  n;                    //~ ErrorMove:3 "may not have been given a value"
}

// A loop that may not run
fn loopMayNotRun(c i32) i32 {
  mut n i32;
  mut i = 0;
  while i < c {
    n = i;
    i = i + 1;
  }
  n;                    //~ ErrorMove:3 "may not have been given a value"
}

// A 'while' with a condition that is literally true still has the condition's
// exit: only a loop with no condition is left by its 'break' alone
fn whileTrueMayExit(c i32) i32 {
  mut n i32;
  mut i = 0;
  while true {
    if i < c { i = i + 1; }
    else { n = i * 2; break; }
  }
  n;                    //~ ErrorMove:3 "may not have been given a value"
}

// The first pass of a loop reads what only a later pass assigns: the walk in
// source order has not met an assignment yet
fn readBeforeAssign(c i32) i32 {
  mut n i32;
  mut i = 0;
  mut sum = 0;
  while i < c {
    if i > 0 { sum = sum + n; }   //~ ErrorMove:28 "has not been initialized"
    n = i;
    i = i + 1;
  }
  sum;
}
