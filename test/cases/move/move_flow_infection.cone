// Which types get move semantics. Each case moves a value of one such type and
// then uses the source, so the diagnostic is the evidence that the type is a
// move type; a copy type would produce nothing here.
//
// Four ways a type becomes non-copyable are reachable without a region: the
// @move attribute, an inferred finalizer, a field that is itself a move type (a
// tuple holding one included), and an array whose element type is -- a tuple holding a move type included,
// and whether the array's type is written out or inferred from its literal. The
// two spellings of the same array type have to agree. The fifth the reference manual lists -- a
// field that is a reference into another data structure -- is not: a borrowed
// reference is a move type only under a permission that forbids aliasing, and
// borrowing 'uni' is rejected outright. That case belongs to 'region'.
//
// One function again, because flow analysis stops running after the first error.

mod move_flow_infection;

// Declared non-copyable outright
struct @move Attributed {
  pub id i32;
}

// A finalizer implies the value owns something a copy would duplicate
struct Finalized {
  pub id i32;
  fn final(self &uni Finalized) { }
}

// An enrichment is its base's representation under a second name, so it moves
// as its base does -- the attribute included, which is written on the base
// alone. A generic one is enriched later, as its instance is type checked.
struct EnrichedAttr extends Attributed {
  pub fn peek(self &) i32 {
    id;
  }
}

struct @move AttrBox[T] {
  pub v T;
}

struct EnrichedBox[T] extends AttrBox[T] {
  pub fn get(self &) T {
    self.v;
  }
}

// A field that cannot be copied makes the whole struct uncopyable
struct HasMoveField {
  pub h Attributed;
  pub n i32;
}

// A tuple field holding a move value is such a field, as the bare tuple moves:
// directly, nested in another tuple, as a generic's type argument, and in an
// enum's variant, which moves the enum too
struct HasTupleField {
  pub t (Finalized, i32);
}

struct HasNestedTuple {
  pub t ((Finalized, i32), i32);
}

struct Holder[T] {
  pub v T;
}

enum TupleVariant {
  pub id i32;
  struct Holds { pub t (Finalized, i32); }
  struct Empty {}
}

// An enum moves when one of its variants does, and every holder has to see it
// however the declarations are ordered: the enum's own static function, and a
// struct and a function written above the enum. Every type is laid out -- an
// enum with all its variants -- before any member is checked, so each does.
// Before, the struct written above laid the enum out, and checked its members,
// ahead of any variant, so the enum did not yet move and all three compiled
// clean: 'dup' copied its parameter twice, 'twice' moved out through a borrowed
// reference twice, and main copies a HoldsLater twice. With the enum reached
// through its first variant instead, 'dup' was refused as a cycle it is not.
struct HoldsLater {
  pub l Later;
}

fn sinkLater(l Later) i32 {1;}

enum Later {
  pub id i32;
  pub fn dup(l Later) i32 {imm a = l; imm b = l; 1;}   //~ ErrorMove:47 "moved out"
  pub fn twice(l &Later) i32 {
    sinkLater(*l) + sinkLater(*l);   //~ ErrorMoveOut:15 "through a borrowed reference"
                                     //~^ ErrorMoveOut:31 "through a borrowed reference"
  }
  struct Plain {}
  struct Carries { pub a Attributed; }
}

fn main() i32 {
  imm a = Attributed[1];
  imm a2 = a;
  imm useA = a.id;           //~ ErrorMove:14 "moved out"

  imm b = Finalized[2];
  imm b2 = b;
  imm useB = b.id;           //~ ErrorMove:14 "moved out"

  imm c = HasMoveField[Attributed[3], 4];
  imm c2 = c;
  imm useC = c.n;            //~ ErrorMove:14 "moved out"

  imm ct = HasTupleField[(Finalized[3], 4)];
  imm ct2 = ct;
  imm useCt = ct;            //~ ErrorMove:15 "moved out"

  imm cn = HasNestedTuple[((Finalized[3], 4), 5)];
  imm cn2 = cn;
  imm useCn = cn;            //~ ErrorMove:15 "moved out"

  imm cg = Holder[(Finalized, i32)][(Finalized[3], 4)];
  imm cg2 = cg;
  imm useCg = cg;            //~ ErrorMove:15 "moved out"

  imm cv = TupleVariant.Holds[1, (Finalized[3], 4)];
  imm cv2 = cv;
  imm useCv = cv;            //~ ErrorMove:15 "moved out"

  imm ce TupleVariant = TupleVariant.Empty[1];
  imm ce2 = ce;
  imm useCe = ce;            //~ ErrorMove:15 "moved out"

  mut d [2; Attributed] = [Attributed[5], Attributed[6]];
  imm d2 = d;
  imm useD = d[0].id;        //~ ErrorMove:14 "moved out"

  // The same array type inferred from its literal rather than written out
  imm di = [Attributed[5], Attributed[6]];
  imm di2 = di;
  imm useDi = di[0].id;      //~ ErrorMove:15 "moved out"

  imm bi = [Finalized[5], Finalized[6]];
  imm bi2 = bi;
  imm useBi = bi[0].id;      //~ ErrorMove:15 "moved out"

  // An array of tuples holding a move value, written out and inferred
  imm dt [2; (Attributed, i32)] = [(Attributed[5], 1), (Attributed[6], 2)];
  imm dt2 = dt;
  imm useDt = dt;            //~ ErrorMove:15 "moved out"

  imm ti = [(Attributed[5], 1), (Attributed[6], 2)];
  imm ti2 = ti;
  imm useTi = ti;            //~ ErrorMove:15 "moved out"

  imm e = EnrichedAttr[7];
  imm e2 = e;
  imm useE = e.id;           //~ ErrorMove:14 "moved out"

  // Moved across to the base's name, which leaves the enrichment's source gone too
  imm f = EnrichedAttr[8];
  imm f2 Attributed = f;
  imm useF = f.id;           //~ ErrorMove:14 "moved out"

  imm g = EnrichedBox[i32][9];
  imm g2 = g;
  imm useG = g.v;            //~ ErrorMove:14 "moved out"

  imm h = HoldsLater[Later.Plain[1]];
  imm h2 = h;
  imm useH = h.l.id;         //~ ErrorMove:14 "moved out"

  0i32;
}
