// Which types get move semantics. Each case moves a value of one such type and
// then uses the source, so the diagnostic is the evidence that the type is a
// move type; a copy type would produce nothing here.
//
// Four ways a type becomes non-copyable are reachable without a region: the
// built-in trait 'Move' declared, an inferred finalizer, a field that is itself a move type (a
// tuple holding one included), and an array whose element type is -- a tuple holding a move type included,
// and whether the array's type is written out or inferred from its literal. The
// two spellings of the same array type have to agree. The fifth the reference manual lists -- a
// field that is a reference into another data structure -- is not: a borrowed
// reference is a move type only under a permission that forbids aliasing, and
// borrowing 'uni' is rejected outright. That case belongs to 'region'.
//
// One function again, because flow analysis stops running after the first error.

mod move_flow_infection;

// Declared non-copyable outright
struct Attributed is Move {
  pub id i32;
}

// A finalizer implies the value owns something a copy would duplicate
struct Finalized {
  pub id i32;
  fn final(self &uni Finalized) { }
}

// An enrichment is its base's representation under a second name, so it moves
// as its base does -- a declared 'Move' included, which is written on the base
// alone. A generic one is enriched later, as its instance is type checked.
struct EnrichedAttr extends Attributed {
  pub fn peek(self &) i32 {
    id;
  }
}

struct AttrBox[T] is Move {
  pub v T;
}

struct EnrichedBox[T] extends AttrBox[T] {
  pub fn get(self &) T {
    self.v;
  }
}

// A 'clone' method makes neither a finalizing type nor one holding a move field
// copyable. No copy calls it: a copy is bitwise, so a copy of a finalizing value
// would be finalized again.
struct FinalizedClone {
  pub id i32;
  fn final(self &uni) { }
  pub fn clone(self &) Self { new Self(id); }
}

struct MoveFieldClone {
  pub h Attributed;
  pub fn clone(self &) Self { new Self(new Attributed(h.id)); }
}

// A field that cannot be copied makes the whole struct uncopyable
struct HasMoveField {
  pub h Attributed;
  pub n i32;
}

// A tuple field holding a move value is such a field, as the bare tuple moves:
// directly, nested in another tuple, as a generic's type argument, and in an
// enum's variant, which moves the enum too
struct HasTupleField {
  pub t (Finalized, i32);
}

struct HasNestedTuple {
  pub t ((Finalized, i32), i32);
}

struct Holder[T] {
  pub v T;
}

enum TupleVariant {
  pub id i32;
  struct Holds { pub t (Finalized, i32); }
  struct Empty {}
}

// A variant declaring 'Move' makes its enum move too, as one that moves by
// inference does: if any variant moves, the enum moves [Jon 26 Sep]. Before,
// the declaration reached the variant alone, so a value typed as the enum was
// copied however it was made. Plain, generic, and an extension, whose copy of
// the variant declares it too.
enum DeclaredVariant {
  struct Moves is Move { pub n i32; }
  struct Stays {}
}

enum DeclaredGeneric[T] {
  struct Moves is Move { pub x T; }
  struct Stays {}
}

enum DeclaredExtended extends DeclaredVariant {
  struct Added {}
}

// An enum moves when one of its variants does, and every holder has to see it
// however the declarations are ordered: the enum's own static function, and a
// struct and a function written above the enum. Every type is laid out -- an
// enum with all its variants -- before any member is checked, so each does.
// Before, the struct written above laid the enum out, and checked its members,
// ahead of any variant, so the enum did not yet move and all three compiled
// clean: 'dup' copied its parameter twice, 'twice' moved out through a borrowed
// reference twice, and main copies a HoldsLater twice. With the enum reached
// through its first variant instead, 'dup' was refused as a cycle it is not.
struct HoldsLater {
  pub l Later;
}

fn sinkLater(l Later) i32 {1;}

enum Later {
  pub id i32;
  pub fn dup(l Later) i32 {let a = l; let b = l; 1;}   //~ ErrorMove:47 "moved out"
  pub fn twice(l &Later) i32 {
    sinkLater(*l) + sinkLater(*l);   //~ ErrorMoveOut:15 "through a borrowed reference"
                                     //~^ ErrorMoveOut:31 "through a borrowed reference"
  }
  struct Plain {}
  struct Carries { pub a Attributed; }
}

fn main() i32 {
  let a = new Attributed(1);
  let a2 = a;
  let useA = a.id;           //~ ErrorMove:14 "moved out"

  let b = new Finalized(2);
  let b2 = b;
  let useB = b.id;           //~ ErrorMove:14 "moved out"

  let bc = new FinalizedClone(2);
  let bc2 = bc;
  let useBc = bc.id;         //~ ErrorMove:15 "moved out"

  let mc = new MoveFieldClone(new Attributed(2));
  let mc2 = mc;
  let useMc = mc.h.id;       //~ ErrorMove:15 "moved out"

  let c = new HasMoveField(new Attributed(3), 4);
  let c2 = c;
  let useC = c.n;            //~ ErrorMove:14 "moved out"

  let ct = new HasTupleField((new Finalized(3), 4));
  let ct2 = ct;
  let useCt = ct;            //~ ErrorMove:15 "moved out"

  let cn = new HasNestedTuple(((new Finalized(3), 4), 5));
  let cn2 = cn;
  let useCn = cn;            //~ ErrorMove:15 "moved out"

  let cg = new Holder[(Finalized, i32)]((new Finalized(3), 4));
  let cg2 = cg;
  let useCg = cg;            //~ ErrorMove:15 "moved out"

  let cv = TupleVariant.Holds(1, (new Finalized(3), 4));
  let cv2 = cv;
  let useCv = cv;            //~ ErrorMove:15 "moved out"

  let ce TupleVariant = TupleVariant.Empty(1);
  let ce2 = ce;
  let useCe = ce;            //~ ErrorMove:15 "moved out"

  let dv DeclaredVariant = DeclaredVariant.Moves(1);
  let dv2 = dv;
  let useDv = dv;            //~ ErrorMove:15 "moved out"

  let dg DeclaredGeneric[i32] = DeclaredGeneric.Stays;
  let dg2 = dg;
  let useDg = dg;            //~ ErrorMove:15 "moved out"

  let dx DeclaredExtended = DeclaredExtended.Added;
  let dx2 = dx;
  let useDx = dx;            //~ ErrorMove:15 "moved out"

  var d Array[Attributed, 2] = [new Attributed(5), new Attributed(6)];
  let d2 = d;
  let useD = d[0].id;        //~ ErrorMove:14 "moved out"

  // The same array type inferred from its literal rather than written out
  let di = [new Attributed(5), new Attributed(6)];
  let di2 = di;
  let useDi = di[0].id;      //~ ErrorMove:15 "moved out"

  let bi = [new Finalized(5), new Finalized(6)];
  let bi2 = bi;
  let useBi = bi[0].id;      //~ ErrorMove:15 "moved out"

  // An array of tuples holding a move value, written out and inferred
  let dt Array[(Attributed, i32), 2] = [(new Attributed(5), 1), (new Attributed(6), 2)];
  let dt2 = dt;
  let useDt = dt;            //~ ErrorMove:15 "moved out"

  let ti = [(new Attributed(5), 1), (new Attributed(6), 2)];
  let ti2 = ti;
  let useTi = ti;            //~ ErrorMove:15 "moved out"

  let e = new EnrichedAttr(7);
  let e2 = e;
  let useE = e.id;           //~ ErrorMove:14 "moved out"

  // Moved across to the base's name, which leaves the enrichment's source gone too
  let f = new EnrichedAttr(8);
  let f2 Attributed = f;
  let useF = f.id;           //~ ErrorMove:14 "moved out"

  let g = new EnrichedBox[i32](9);
  let g2 = g;
  let useG = g.v;            //~ ErrorMove:14 "moved out"

  let h = new HoldsLater(Later.Plain(1));
  let h2 = h;
  let useH = h.l.id;         //~ ErrorMove:14 "moved out"

  0i32;
}
