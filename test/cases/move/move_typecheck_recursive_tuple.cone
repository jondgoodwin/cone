// A tuple holds its elements by value, so a type holding itself in a tuple is
// infinitely sized, as it is held directly (move_typecheck_recursive_value):
// in a tuple, a tuple within a tuple, an array of tuples, a tuple holding an
// array, either of two structs each holding the other in a tuple, an enum's
// variant holding a tuple of the enum, an array of those, and a struct holding
// a tuple of an enum whose variant holds the struct.

mod move_typecheck_recursive_tuple;

struct InTuple {
  pub k: (i32, InTuple);                 //~ ErrorNoSize "InTuple contains InTuple by value: infinite size"
}

struct Nested {
  pub k: ((Nested, i32), i32);           //~ ErrorNoSize "Nested contains Nested by value: infinite size"
}

struct InArray {
  pub k: Array[(i32, InArray), 2];       //~ ErrorNoSize "An array cannot be made of this element type: InArray contains InArray by value: infinite size"
}

struct HoldsArray {
  pub k: (i32, Array[HoldsArray, 2]);    //~ ErrorNoSize "An array cannot be made of this element type: HoldsArray contains HoldsArray by value: infinite size"
}

struct Pa {
  pub k: (i32, Pb);                      //~ ErrorNoSize "Pa contains Pb contains Pa by value: infinite size"
}

struct Pb {
  pub k: (Pa, i32);                      //~ ErrorNoSize "Pa contains Pb contains Pa by value: infinite size"
}

enum Link {
  End;
  Next((i32, Link));                    //~ ErrorNoSize "Link contains Next contains Link by value: infinite size"
}

enum Links {
  End;
  Many(Array[(i32, Links), 3]);         //~ ErrorNoSize "An array cannot be made of this element type: Links contains Many contains Links by value: infinite size"
}

enum Shape {
  Empty;
  Held(Owner);                          //~ ErrorNoSize "Shape contains Held contains Owner contains Shape by value: infinite size"
}

struct Owner {
  pub k: (i32, Shape);                   //~ ErrorNoSize "Shape contains Held contains Owner contains Shape by value: infinite size"
}
