// 'Move' and 'Copy' are the two built-in traits every type has exactly one of.
// The compiler grants them from what it infers; a type may also declare one.
// Declaring 'is Move' makes a type move (move_flow_infection). Declaring 'is
// Copy' is an assertion, refused where the type moves after all: it declares
// 'Move' too, or has a 'final', or a field that moves, or enriches a base that
// moves, or is an enum with a variant that moves. Accepted where it copies
// (move_success).

mod move_typecheck_copy;

struct Handle is Move {
  pub id i32;
}

struct Both is Move, Copy {                  //~ ErrorCopyMove "declares both Move and Copy"
  pub id i32;
}

struct BothOtherWay is Copy, Move {          //~ ErrorCopyMove "declares both Move and Copy"
  pub id i32;
}

struct Finalizes is Copy {                   //~ ErrorCopyMove "its 'final' makes it move"
  pub id i32;
  fn final(self &uni) { }
}

struct HoldsHandle is Copy {                 //~ ErrorCopyMove "its field 'h' moves"
  pub n i32;
  pub h Handle;
}

struct HoldsOwner is Copy {                  //~ ErrorCopyMove "its field 'p' moves"
  pub p +so i32;
}

struct Enriched extends Handle is Copy {    //~ ErrorCopyMove "the base it enriches, Handle, moves"
  pub fn get(self &) i32 { id; }
}

enum Carrying is Copy {                      //~ ErrorCopyMove "one of its variants moves"
  pub id i32;
  struct Plain {}
  struct Carries { pub h Handle; }
}

// A variant that declares 'Move' is one that moves, as one moving by inference is
enum Declaring is Copy {                     //~ ErrorCopyMove "one of its variants moves"
  struct Plain {}
  struct Moves is Move { pub n i32; }
}

struct Box[T] is Copy {                      //~ ErrorCopyMove "its field 'v' moves"
  pub v T;
}

fn main() i32 {
  imm b = Box[Handle][Handle[1]];
  0i32;
}
