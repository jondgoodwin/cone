// A type holding a List of itself moves, because the List does (a type with a
// field that moves moves), and it need not declare 'is Move' to say so. Whether
// it moves is settled from its fields after the List of it is made, so a method
// of that List that exists only where its element is Copy ('resize') is still
// left out of it (move_typecheck_recursive_list), not kept because the element
// looked Copy while it was being laid out.
//
// - a struct holding a List of itself, two deep, walked and pushed onto;
// - an enum with a variant holding a List of the enum, matched;
// - two structs each holding a List of the other;
// - the same struct declaring 'is Move';
// - a Dict whose values are the struct holding it;
// - a struct that copies, declared below the function that resizes a List of
//   it: the method stays;
// - the type held where the List's element is a tuple, a Dict's value or an
//   argument of a generic struct.
//
// Inside a variant's own body 'Self' is the variant (refenum.html), so a
// variant that holds a List of its enum names the enum: 'Branch(List[Tree])'.

mod move_recursive_list;

import stdio use *;
import collections use *;

fn grow(xs &mut List[Pt], p Pt) {
  xs.resize(3usize, p);
}

struct Pt {
  pub x i64;
  pub y i64;
}

struct Tagged {
  pub id i64;
  pub kids List[(i32, Tagged)];
}

struct Grouped {
  pub groups Dict[String, List[Grouped]];
}

struct Wrap[T] {
  pub v List[T];
}

struct Wrapped {
  pub w List[Wrap[Wrapped]];
}

fn say(n i64) {
  printInt(n);
  printStr("\n");
}

struct Node {
  pub id i64;
  pub kids List[Node];
}

fn total(n &Node) i64 {
  mut s = n.id;
  each k in n.kids { s = s + total(k); }
  s;
}

enum Tree {
  Leaf(i64);
  Branch(List[Tree]);
}

fn leaves(t &Tree) i64 {
  match t {
    case is Leaf { 1; }
    case imm b Branch {
      mut n = 0i64;
      each k in b { n = n + leaves(k); }
      n;
    }
  }
}

struct Pa {
  pub id i64;
  pub bs List[Pb];
}

struct Pb {
  pub id i64;
  pub as_ List[Pa];
}

fn sumA(a &Pa) i64 {
  mut s = a.id;
  each b in a.bs { s = s + sumB(b); }
  s;
}

fn sumB(b &Pb) i64 {
  mut s = b.id;
  each a in b.as_ { s = s + sumA(a); }
  s;
}

struct Declared is Move {
  pub id i64;
  pub kids List[Declared];
}

struct Reg {
  pub id i64;
  pub subs Dict[i64, Reg];
}

fn main() {
  // Node: root 0 holds a (1, holding 11) and 2
  mut a = new Node(1, List[Node].empty());
  a.kids.push(new Node(11, List[Node].empty()));
  mut root = new Node(0, List[Node].empty());
  root.kids.push(a);
  root.kids.push(new Node(2, List[Node].empty()));
  say(i64.from(root.kids.len()));
  say(total(&root));

  // Tree: Branch[Leaf, Branch[Leaf, Leaf]] has three leaves
  mut inner = List[Tree].empty();
  inner.push(Tree.Leaf(5));
  inner.push(Tree.Leaf(6));
  mut outer = List[Tree].empty();
  outer.push(Tree.Leaf(4));
  outer.push(Tree.Branch(inner));
  imm t = Tree.Branch(outer);
  say(leaves(&t));

  // Pa 100 holds Pb 20, which holds Pa 3
  mut pa3 = List[Pa].empty();
  pa3.push(new Pa(3, List[Pb].empty()));
  mut pbs = List[Pb].empty();
  pbs.push(new Pb(20, pa3));
  imm top = new Pa(100, pbs);
  say(sumA(&top));

  // Declared
  mut d = new Declared(7, List[Declared].empty());
  d.kids.push(new Declared(8, List[Declared].empty()));
  say(d.id + (*d.kids[0usize]).id);

  // Reg
  mut r = new Reg(1, Dict[i64, Reg].empty());
  r.subs.insert(5, new Reg(2, Dict[i64, Reg].empty()));
  say(i64.from(r.subs.len()));

  // Pt copies, so its List has resize
  mut pts = List[Pt].empty();
  grow(&mut pts, new Pt(1, 2));
  say(i64.from(pts.len()));

  // Tagged, Grouped and Wrapped
  mut tg = new Tagged(9, List[(i32, Tagged)].empty());
  tg.kids.push((1i32, new Tagged(10, List[(i32, Tagged)].empty())));
  say(i64.from(tg.kids.len()));
  mut gr = new Grouped(Dict[String, List[Grouped]].empty());
  say(i64.from(gr.groups.len()));
  mut wd = new Wrapped(List[Wrap[Wrapped]].empty());
  say(i64.from(wd.w.len()));
}
