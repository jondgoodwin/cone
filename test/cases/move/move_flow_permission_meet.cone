// Where owners meet at another permission, a 'uni' one moves, as it does where
// that permission is wanted of it, so it may not be used after. The permission
// they meet at is the one the value has, and no more.
mod move_flow_permission_meet;

struct N { pub n: i32; }

fn afterIf(c: bool) i32 {
  let a = Rc[N](N(1));
  let b = Rc[mut, N](N(2));
  let r = if c {a} else {b};
  a.n                                                       //~ ErrorMove "moved out"
}

fn afterMatch(c: bool) i32 {
  let a = Rc[N](N(1));
  let b = Rc[imm, N](N(2));
  let r = match c { case true {b} else {a} };
  a.n                                                       //~ ErrorMove "moved out"
}

fn afterBreak(c: bool) i32 {
  let a = Rc[N](N(1));
  let b = Rc[ro, N](N(2));
  let r = while { if c { break a; } if !c { break b; } };
  a.n                                                       //~ ErrorMove "moved out"
}

fn afterArray() i32 {
  let a = Rc[N](N(1));
  let b = Rc[mut1, N](N(2));
  let l = [a, b];
  a.n                                                       //~ ErrorMove "moved out"
}

// A sole owner moves whatever it meets
fn afterSole(c: bool) i32 {
  let a = Uni[N](N(1));
  let b = Uni[imm, N](N(2));
  let r = if c {a} else {b};
  b.n                                                       //~ ErrorMove "moved out"
}

fn writeMet(c: bool) {
  let a = Rc[mut, N](N(1));
  let b = Rc[imm, N](N(2));
  let r = if c {a} else {b};
  r.n = 3;                                                  //~ ErrorNoMut
}
