// Which operations deactivate a move value's source, and the neighbouring flow
// state of a variable that never held a value at all.
//
// Every case is in one function on purpose. Data flow analysis runs per function
// and only when that function's own type check raised nothing (fnDclTypeCheck
// compares the error count against the one it entered with), so a function that
// raises a flow diagnostic reports no further flow diagnostics of its own --
// but a later function still gets its own flow pass. Within a function they
// accumulate.

mod move_flow_deactivate;

struct Handle is Move {
  pub id i32;
}

// A move type because its field is one, and an enrichment of it: one
// representation under two names
struct Wrapper {
  pub h Handle;
}

struct RichWrapper extends Wrapper {
  pub fn id(self &) i32 { h.id }
}

fn take(h Handle) i32 {
  h.id
}

fn main() i32 {
  // Assigning to another variable moves the value out of this one
  let a = new Handle(1);
  let b = a;
  let useA = a.id;      //~ ErrorMove:14 "moved out"

  // Passing it to a function moves it there
  let c = new Handle(2);
  take(c);
  take(c);              //~ ErrorMove:8 "moved out"

  // A move in only one branch still deactivates the source, because the join
  // cannot know which way control went
  let d = new Handle(3);
  if useA > 0 { take(d); }
  take(d);              //~ ErrorMove:8 "moved out"

  // A value moved on through a second variable leaves that one empty too
  let e = new Handle(4);
  let f = e;
  let g = f;
  take(f);              //~ ErrorMove:8 "moved out"

  // Handing a value across to its enrichment's name moves it, and so does
  // handing one back to the base's. The two share one representation, so the
  // value crosses in a recast, and the recast once hid the source from flow:
  // it stayed usable and the value was finalized under both names.
  let i = new Wrapper(new Handle(5));
  let j RichWrapper = i;
  let useI = i.h.id;    //~ ErrorMove:14 "moved out"
  let k = new RichWrapper(new Handle(6));
  let l Wrapper = k;
  let useK = k.h.id;    //~ ErrorMove:14 "moved out"

  // A block or an 'if' used as a value moves what it hands back, so binding
  // one moves its source out as binding the source itself would. It once
  // checked the source and left it usable, and finalized in both places.
  let m = new Handle(7);
  let n = {m};
  take(m);              //~ ErrorMove:8 "moved out"
  let o = new Wrapper(new Handle(8));
  let p = if useA > 0 {o} else {o};
  let useO = o.h.id;    //~ ErrorMove:14 "moved out"

  // The other state flow analysis rejects a use in: declared, never given a
  // value. Distinct from deactivation, and reported with the same code.
  var h Handle;
  take(h);              //~ ErrorMove:8 "has not been initialized"

  0i32
}
