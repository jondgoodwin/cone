// A value dies at the end of its scope on the path that still holds it, and
// only there. Where whether a variable holds its value at a release differs
// by path -- moved on one branch, given a value on one, moved in an earlier
// pass of a loop -- the variable carries a hidden flag, set where its value
// arrives and cleared where it leaves, and the release at its scope's end or
// at a store over it runs only when the flag says the value is there. Where
// every path agrees, there is no flag (move_drop_flags_agree).
//
// Each function runs once down each path. The finalizer prints its number,
// so the output is the whole assertion: every value finalized exactly once,
// by whoever holds it last, at the point its holder dies.
//
// - Moved on one branch: finalized by the callee on that path, at its scope's
//   end on the other.
// - Moved on both branches, and on two arms of three of an 'elif' chain.
// - Handed on by a block, an 'if', a loop's 'break' or a 'match' used as a
//   value, on one path: the new holder finalizes it there, its own scope's end
//   on the others.
// - Handed back from the function by an 'if' on one branch: the other branch's
//   local is finalized as the function ends.
// - Given a value on one branch only: finalized on that path, and nothing
//   run over storage that never held a value on the other.
// - Moved, then returned early; moved in a loop and broken out of; moved and
//   continued past; reassigned after a move in an earlier pass of a loop.
// - Moved in the right operand of '&&', which runs on one path.
// - A match's binding moved on one arm: the matched value is finalized when
//   the arm that moves it does not run.
// - Destructured into on one path.
// - A block, or an 'if' arm, whose last statement is a declaration, in a
//   function with a flag: its local is finalized once, at the block's end.

mod move_drop_flags;

import stdio use *;

struct Fin {
  pub v i32;
  fn final(self &uni) { printStr("F"); printInt(i64.from(v)); printStr(" "); }
}

enum E {
  struct A { pub f Fin; }
  struct B { pub n i32; }
}
use E;

fn cond(b bool) bool { b }
fn take(f Fin) { printStr("take "); }
fn takeE(e E) { printStr("takeE "); }
fn line(label &str) { printStr("| "); printStr(label); printStr("\n"); }

fn oneBranch(c bool) { let a = new Fin(1); if cond(c) { take(a); } printStr("end "); }
fn bothBranches(c bool) { let a = new Fin(2); if cond(c) { take(a); } else { take(a); } printStr("end "); }
fn elifs(n i32) {
  let a = new Fin(3);
  if n == 0 { take(a); }
  elif n == 1 { printStr("kept "); }
  else { take(a); }
  printStr("end ");
}

fn ifValue(c bool) { let a = new Fin(4); let y = if cond(c) {a} else {new Fin(0)}; printStr("end "); }
fn blockValue(c bool) { let a = new Fin(5); let y = { if cond(c) {a} else {new Fin(0)} }; printStr("end "); }
fn breakValue(c bool) {
  let a = new Fin(6);
  let y = while { if cond(c) {break a;} else {break new Fin(0);}; };
  printStr("end ");
}
fn matchValue(e E) {
  let a = new Fin(7);
  let y = match e { case is A {a} else {new Fin(0)} };
  printStr("end ");
}
fn handedBack(c bool) Fin {
  let a = new Fin(8);
  let b = new Fin(9);
  if cond(c) {a} else {b}
}

fn givenOnOne(c bool) { var f Fin; if cond(c) { f = new Fin(10); } printStr("end "); }

fn earlyReturn(c bool) {
  let a = new Fin(11);
  let b = new Fin(12);
  if cond(c) { take(a); return; }
  take(b);
  printStr("end ");
}
fn loopBreak(n i32) {
  let a = new Fin(13);
  var i = 0;
  while i < 3 {
    if i == n { take(a); break; }
    i = i + 1;
  }
  printStr("end ");
}
fn loopContinue() {
  var i = 0;
  while i < 3 {
    let a = new Fin(20 + i);
    i = i + 1;
    if i == 2 { take(a); continue; }
    printStr("kept ");
  }
  printStr("end ");
}
fn loopCarried() {
  var a = new Fin(30);
  var i = 1;
  while i < 4 {
    if i == 2 { take(a); a = new Fin(30 + i * 10); }
    else { a = new Fin(30 + i); }
    i = i + 1;
  }
  printStr("end ");
}
fn andOperand(c bool) {
  let a = new Fin(14);
  if cond(c) && { take(a); true } { printStr("then "); }
  printStr("end ");
}
fn matchBinding(c bool) {
  let e E = A(new Fin(15));
  match e {
    case let a A { if cond(c) { takeE(a); } else { printStr("keep "); } }
    else { printStr("else "); }
  }
  printStr("end ");
}
fn pair() (Fin, Fin) { (new Fin(16), new Fin(17)) }
fn destructured(c bool) {
  var x Fin;
  var y Fin;
  if cond(c) { x, y = pair(); }
  printStr("end ");
}
fn declaredLast(c bool) {
  let a = new Fin(18);
  if cond(c) { take(a); let b = new Fin(19); }
  { let d = new Fin(40); { let e = new Fin(41); } }
  printStr("end ");
}

fn main() i32 {
  oneBranch(true); line("one branch, taken");
  oneBranch(false); line("one branch, not taken");
  bothBranches(true); line("both branches, then");
  bothBranches(false); line("both branches, else");
  elifs(0); line("elif, first");
  elifs(1); line("elif, second");
  elifs(2); line("elif, else");
  ifValue(true); line("if value, taken");
  ifValue(false); line("if value, not taken");
  blockValue(true); line("block value, taken");
  blockValue(false); line("block value, not taken");
  breakValue(true); line("break value, taken");
  breakValue(false); line("break value, not taken");
  matchValue(A(new Fin(70))); line("match value, taken");
  matchValue(B(1)); line("match value, not taken");
  { let x = handedBack(true); printStr("got "); } line("handed back, then");
  { let x = handedBack(false); printStr("got "); } line("handed back, else");
  givenOnOne(true); line("given a value, taken");
  givenOnOne(false); line("given a value, not taken");
  earlyReturn(true); line("returned early");
  earlyReturn(false); line("did not return");
  loopBreak(1); line("moved in a loop and broken out of");
  loopBreak(5); line("loop never moved it");
  loopContinue(); line("moved and continued past");
  loopCarried(); line("reassigned after a move in an earlier pass");
  andOperand(true); line("and, right operand ran");
  andOperand(false); line("and, right operand skipped");
  matchBinding(true); line("binding moved");
  matchBinding(false); line("binding kept");
  destructured(true); line("destructured into");
  destructured(false); line("never given values");
  declaredLast(true); line("a block ending in its declaration, moved");
  declaredLast(false); line("a block ending in its declaration, kept");
  0i32
}
