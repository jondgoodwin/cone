// A type may hold a List of an Option of itself, for the List holds its
// elements through a pointer: 'List[Option[Node]]' inside Node names the
// 'Option[Node]' as 'List[Node]' names Node, without laying it out while Node's
// own layout is in flight. A type argument that is itself an instance is a
// name, not a value held; whatever holds one by value lays it out when it asks
// for its size (move_recover_recursive_option_value is where that stays refused).
//
// - a struct holding a List of an Option of itself, walked with absent children;
// - an enum with a variant holding a List of an Option of the enum, matched;
// - an Option of a List of an Option of the struct, a Dict value and an owning
//   reference to an Option of it;
// - a List of a generic struct holding the type by value;
// - two structs each holding a List of an Option of the other.
//
// 'resize' exists only where the element is Copy, and an Option of a moving
// type is not: it is absent from these Lists (move_typecheck_recursive_option_list).

mod move_recursive_option_list;

import stdio use *;
import collections use *;

fn say(n i64) {
  printInt(n);
  printStr("\n");
}

struct Node {
  pub id i64;
  pub kids List[Option[Node]];
}

// Counts every present node under n, n included, and the absent slots
fn present(n &Node) i64 {
  var s = 1i64;
  each k in n.kids {
    match k {
      case let c Some { s = s + present(c); }
      else { }
    }
  }
  s;
}

fn absent(n &Node) i64 {
  var s = 0i64;
  each k in n.kids {
    match k {
      case let c Some { s = s + absent(c); }
      else { s = s + 1; }
    }
  }
  s;
}

enum Tree {
  Leaf(i64);
  Branch(List[Option[Tree]]);
}

fn leaves(t &Tree) i64 {
  match t {
    case is Leaf { 1; }
    case let b Branch {
      var n = 0i64;
      each k in b {
        match k {
          case let c Some { n = n + leaves(c); }
          else { }
        }
      }
      n;
    }
  }
}

struct Holder {
  pub id i64;
  pub opt Option[List[Option[Holder]]];
  pub table Dict[i64, Option[Holder]];
  pub own Option[Uni[Option[Holder]]];
}

struct Wrap[T] {
  pub v T;
}

struct Boxed {
  pub id i64;
  pub ws List[Wrap[Boxed]];
}

struct Pa {
  pub id i64;
  pub bs List[Option[Pb]];
}

struct Pb {
  pub id i64;
  pub as_ List[Option[Pa]];
}

fn sumA(a &Pa) i64 {
  var s = a.id;
  each b in a.bs {
    match b {
      case let x Some { s = s + sumB(x); }
      else { }
    }
  }
  s;
}

fn sumB(b &Pb) i64 {
  var s = b.id;
  each a in b.as_ {
    match a {
      case let x Some { s = s + sumA(x); }
      else { }
    }
  }
  s;
}

fn main() {
  // Node 0 holds Some(1) holding Some(11), None, and Some(2): four present, two absent
  var one = new Node(1, List[Option[Node]].empty());
  one.kids.push(Some(new Node(11, List[Option[Node]].empty())));
  one.kids.push(None);
  var root = new Node(0, List[Option[Node]].empty());
  root.kids.push(Some(one));
  root.kids.push(None);
  root.kids.push(Some(new Node(2, List[Option[Node]].empty())));
  say(i64.from(root.kids.len()));
  say(present(&root));
  say(absent(&root));

  // Branch[Leaf, absent, Branch[Leaf, Leaf]] has three leaves
  var inner = List[Option[Tree]].empty();
  inner.push(Some[Tree](Tree.Leaf(5)));
  inner.push(Some[Tree](Tree.Leaf(6)));
  var outer = List[Option[Tree]].empty();
  outer.push(Some[Tree](Tree.Leaf(4)));
  outer.push(None);
  outer.push(Some[Tree](Tree.Branch(inner)));
  let t = Tree.Branch(outer);
  say(leaves(&t));

  // Holder
  var h = new Holder(7, None, Dict[i64, Option[Holder]].empty(), None);
  say(h.id + i64.from(h.table.len()));
  h.opt = Some(List[Option[Holder]].empty());
  match &h.opt {
    case let l Some { say(i64.from(l.len())); }
    else { say(-1); }
  }

  // Boxed
  var bx = new Boxed(3, List[Wrap[Boxed]].empty());
  bx.ws.push(new Wrap[Boxed](new Boxed(4, List[Wrap[Boxed]].empty())));
  say(bx.id + bx.ws[0usize].v.id);

  // Pa 100 holds Pb 20, which holds Pa 3 and an absent slot
  var pa3 = List[Option[Pa]].empty();
  pa3.push(Some(new Pa(3, List[Option[Pb]].empty())));
  pa3.push(None);
  var pbs = List[Option[Pb]].empty();
  pbs.push(Some(new Pb(20, pa3)));
  let top = new Pa(100, pbs);
  say(sumA(&top));
}
