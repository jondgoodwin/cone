// An owner whose permission changes in one branch moves on that path, so it may
// not be used after the branch, as with no branch and no change.
mod move_flow_permission_branch;

struct Noisy { pub n: i32; }

fn read(r: Rc[mut, Noisy]) {}

fn afterIf(c: bool) i32 {
  let a = Rc[Noisy](Noisy(25));
  let b = Rc[mut, Noisy](Noisy(26));
  let r: Rc[mut, Noisy] = if c {a} else {b};
  a.n                                                       //~ ErrorMove "moved out"
}

fn afterArgument(c: bool) i32 {
  let a = Rc[Noisy](Noisy(25));
  read(if c {a} else {Rc[mut, Noisy](Noisy(26))});
  a.n                                                       //~ ErrorMove "moved out"
}

fn afterBreak(c: bool) i32 {
  let a = Rc[Noisy](Noisy(25));
  let r: Rc[mut, Noisy] = while { if c { break a; } if !c { break Rc[mut, Noisy](Noisy(26)); } };
  a.n                                                       //~ ErrorMove "moved out"
}
