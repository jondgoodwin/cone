// Bracket forms the compiler will not accept as an array type or literal.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. '[...]' is one syntax that becomes an array type
// when its first element is a type and an array literal when it is a value, so
// the two are checked together here; what an existing array will not accept is
// in array-reject-use.
//
fn dimensionCount() {
  // An array type carries exactly one dimension
  mut twoDims [2, 3; i32]   //~ ErrorBadArray:15 "exactly one numeric array dimension"
}

fn literalDimensionCount() {
  // ...and so does a literal in the fill form. This is the case that used to
  // kill the compiler: the check returned without giving the literal a type,
  // and the binding below then read the type that was never written.
  imm twoDims = [2, 3; 0]   //~ ErrorBadArray:17 "may only specify one dimension"
}

fn literalFillCount() {
  // A fill form fills with one value, and the same early return applies
  imm twoFills = [2; 1, 2]   //~ ErrorBadArray:18 "fill value may only be one value"
}

fn dimensionForm() {
  // ...and that dimension must be spelled as an integer literal
  mut fractional [2.0; i32]   //~ ErrorBadArray:19 "Integer literal must be used for array dimensions"
}

fn elementCount() {
  // An array type carries exactly one element type
  mut twoElems [3; i32, f32]   //~ ErrorBadArray:16 "Exactly one element type must be specified"
}

fn literalElements() {
  // Every element of a multi-value literal must have the first element's type
  imm mixed = [1, 2.5]   //~ ErrorBadArray:19 "Inconsistent type of array literal value"
}

fn fillDimensionType() {
  // The count in the '[N; value]' fill form must reach usize
  imm fromFloat = [1.5; 0]   //~ ErrorBadArray:19 "dimension must coerce to usize"
}

fn fillDimensionConst() {
  // ...and it must be constant, since it becomes part of the array's type
  mut count usize = 3
  imm fromVar = [count; 0]   //~ ErrorBadArray:17 "dimension value must be a constant"
}
