// Borrowing an element of an array that is a field of a call's result,
// '&make().m[1]': the borrow of a temporary, held to the end of its statement.
//
// array_rvalue_index pins the by-value read, 'make().m[1]'. A borrow of the
// same element needs the temporary to stay where it was made until the
// statement that holds the borrow ends, and was once refused with a
// cascade of 'does not support calls or field access'. The borrow is taken
// in each position that wants one: a 'let', an argument, a mutable borrow
// written through, and a bare statement whose borrow is dropped at once.
//
// Each element is different, so a borrow of the wrong one prints the wrong
// number.

mod array_borrow_rvalue_index;

import stdio use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

struct Pack {
  pub k: i32;
  pub m: Array[i32, 3];
}

fn make() Pack { Pack(1, [10, 20, 30]) }

fn read(p: &i32) i64 { i64.from(*p) }

fn main() i32 {
  let r = &make().m[1];
  show("let", i64.from(*r));
  show("argument", read(&make().m[2]));
  let a = &mut make().m[2];
  *a = 5;
  show("mutable", i64.from(*a));
  &make().m[0];
  show("bare statement ran", 1);
  0i32
}
