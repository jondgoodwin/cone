// What the array type 'Array[T, n]' will not accept once its name has
// resolved: a size that is not an integer literal, 'Array' without its
// brackets, and the fill literal's spelling of an array type in a generic,
// which only the instance reveals to be a type.
//
// Type-check stage only. Wrong arguments to 'Array' and the fill literal's
// spelling written out are refused by name resolution, which ends the
// compile, so they are in array_nameres_spelling.

mod array_typecheck_size;

const Three usize = 3;

fn sizes() {
  mut fractional Array[i32, 2.0];   //~ ErrorBadArray "size must be an integer literal"
  // A named constant is no literal, though the fill literal's count may be one
  mut named Array[i32, Three];      //~ ErrorBadArray "size must be an integer literal"
  // Only the first argument is the element type; every other is a size
  mut typed Array[i32, 2, i32];     //~ ErrorBadArray "size must be an integer literal"
}

fn varSize() {
  mut n usize = 3;
  mut computed Array[i32, n];       //~ ErrorBadArray "size must be an integer literal"
}

fn bare() {
  // Alone, 'Array' names no type
  mut whole Array;                  //~ ErrorArrayTypeArgs "only with its element type"
}

// In a template '[2; T]' could still be a fill literal, T a value; its
// instance shows T is a type, and so a type spelled as a fill literal
fn pairOf[T](x T) T {
  mut held [2; T];                  //~ ErrorArrayTypeOld "is written 'Array[T, n]'"
  x;
}
fn usesPairOf() i32 {
  pairOf(3);
}
