// An array's construction is its contents, which fill it exactly: too few
// values or too many are refused, and so is an array constructed with none
// or given init arguments, since an array has no init.
//
// How many values an entry gives is array_typecheck_counts's.

mod array_typecheck_contents;

fn sizes() {
  imm few = new Array[i32, 4] <- 1, 2;               //~ ErrorArrayContents:31 "give 2 values, and the array holds 4"
  imm many = new Array[i32, 2] <- 1, 2, 3;           //~ ErrorArrayContents:32 "give 3 values, and the array holds 2"
  imm over = new Array[i32, 2] <- 1, 2, 3, fill 0;   //~ ErrorArrayContents:32 "give 3 values, and the array holds 2"
}

fn construction() {
  imm bare = new Array[i32, 3];                      //~ ErrorArrayContents:14 "constructed with the values that fill it"
  imm args = new Array[i32, 3](1) <- fill 0;         //~ ErrorArrayContents:14 "has no init to take arguments"
}
