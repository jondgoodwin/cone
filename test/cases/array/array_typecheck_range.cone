// An array type's size is 0 through 4294967295, because the array is built
// with a 32-bit count. A negative size once read its two's complement as the
// count ('Array[i32, -1]' was 4294967295 elements), and a larger one was cut
// to its low 32 bits ('Array[i8, 4294967297]' was one element).
//
// Type-check stage only. The sizes that are accepted are declared alongside,
// so that a refusal that reached too far would show here as well.

mod array_typecheck_range;

fn sizes() {
  mut negative Array[i32, -1];         //~ ErrorBadArray "size may not be negative"
  mut nested Array[i32, 2, -3];        //~ ErrorBadArray "size may not be negative"
  mut wrapped Array[i8, 4294967297];   //~ ErrorBadArray "size may be at most 4294967295"
  mut empty Array[i32, 0];
  mut negzero Array[i32, -0];
  mut largest Array[i8, 4294967295];
}
