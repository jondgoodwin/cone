// The array type is written 'Array[T, n]': the element type, then one size
// for each dimension. Name resolution lowers it, and refuses here what it
// cannot lower: the fill literal's spelling with a type where its value goes,
// and a first argument that is not a type. ('Array[T]' with no size is the body
// of a run-time length, array_body's.)
//
// Name-resolution stage, which ends the compile, so the sizes type check
// judges are in array_typecheck_size.

mod array_nameres_spelling;

struct Holder {
  pub cells [3; i32];               //~ ErrorArrayTypeOld:13 "is written 'Array[T, n]'"
}

fn oldSpelling() {
  mut grid [2; [3; f32]];           //~ ErrorArrayTypeOld:12 "is written 'Array[T, n]'"
                                    //~^ ErrorArrayTypeOld:16 "is written 'Array[T, n]'"
}

fn sizeFirst() {
  mut swapped Array[3, i32];        //~ ErrorArrayTypeElem "first argument is its element type"
}
