// What an array value will not accept: initializers that are not of its type,
// indices it cannot use, and member access it does not have.
//
// Type-check stage only, so every diagnostic below is reached. The bracket
// forms that never become a well-formed array type or literal at all are in
// array_reject_shape.
//
// Not here: an index past the end. 'a[7]' on an 'Array[i32, 3]' compiles clean
// and with no warning, so there is no diagnostic to assert. See the group's
// cases.toml.

mod array_reject_use;

fn shortInitializer() {
  // The initializer's length is part of its type, so a literal of the wrong
  // length is a different array type rather than a short one
  mut a Array[u8, 4] = [1u8, 2u8];   //~ ErrorInvType:24 "Initialization value's type does not match variable's declared type"
}

fn wrongElementType() {
  // Each element is coerced to the declared element type, as a variable's
  // initializer is, and an i64 does not coerce to a u8 -- narrowing is a
  // conversion, never a coercion -- so this stays an Array[i64, 4] value being
  // given to an Array[u8, 4]. An unsuffixed literal would take the u8; array_literal_coerce
  // holds that side.
  mut a Array[u8, 4] = [1i64, 2i64, 3i64, 4i64];   //~ ErrorInvType:24 "Initialization value's type does not match variable's declared type"
}

fn tooManyIndices() {
  // One dimension takes one index
  mut a Array[i32, 3] = [1, 2, 3];
  imm elem = a[1, 2];   //~ ErrorBadIndex:15 "Incorrect number of indexing arguments"
}

fn signedIndex() {
  // An array index must be unsigned; only a pointer accepts a signed one
  mut a Array[i32, 3] = [1, 2, 3];
  mut i i32 = 1;
  imm elem = a[i];   //~ ErrorBadIndex:15 "Array index must be an unsigned integer"
}

fn noMembers() {
  // An array has no methods or fields of its own -- '.len' belongs to a slice
  mut a Array[i32, 3] = [1, 2, 3];
  imm n = a.len;   //~ ErrorNoMeth:12 "Invalid operation on an array"
}
