// The contents of an array written with several sizes are its scalars, so
// they give exactly the product of its sizes, each a scalar: a row is refused
// where a scalar is wanted, and so is a product past 4294967295, the most an
// array's size may be. An element type that is itself an array mixes the two
// spellings, and takes no contents until whether they are its scalars or its
// elements is settled.
//
// The nested spelling's contents are its rows, which array_contents_scalars
// runs; what the contents of a one-size array refuse is
// array_typecheck_contents's and array_typecheck_counts's.

mod array_typecheck_scalars;

fn counts() {
  let few = Array[i32, 2, 3]() <- 1, 2, 3;                  //~ ErrorArrayContents:32 "give 3 values, and the array holds 6 scalars of i32"
  let many = Array[i32, 2, 2]() <- 1, 2, 3, 4, 5;           //~ ErrorArrayContents:33 "give 5 values, and the array holds 4 scalars of i32"
}

fn rows() {
  let grid = Array[i32, 2, 3]() <- fill Array[i32, 3]() <- (1, 2, 3);   //~ ErrorInvType:57 "filled with its scalars, i32, row by row, not with its rows"
}

fn sizes() {
  let huge = Array[u8, 65536, 65536]() <- fill 0u8;        //~ ErrorArrayContents:40 "more than 4294967295 of them"
  let mixed = Array[Array[u8, 4], 2, 3]() <- fill 0u8;      //~ ErrorArrayContents:43 "takes no contents yet"
}
