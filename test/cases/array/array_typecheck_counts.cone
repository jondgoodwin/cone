// What an entry of an array's contents may give. Its size is fixed, so the
// count of 'n of x' is a constant, from 0 through 4294967295 as an array's
// size is; a value must be the element type; and a pair 'k: v' is no value.
//
// The count of 'n of x' on a growable collection is collection_typecheck_contents's.

mod array_typecheck_counts;

fn counts(n usize) {
  imm runtime = new Array[i32, 3] <- n of 0;               //~ ErrorRepeatCount:38 "the count before 'of' in its contents is a constant"
  imm negative = new Array[i32, 3] <- -1 of 0, fill 1;     //~ ErrorRepeatCount:40 "may not be negative"
  imm huge = new Array[i8, 3] <- 4294967296 of 7i8;        //~ ErrorRepeatCount:34 "may be at most 4294967295"
}

fn values() {
  imm text = new Array[i32, 2] <- fill "two";              //~ ErrorInvType:40 "does not match the array's element type"
  imm pairs = new Array[i32, 2] <- 1: 2, 3;                //~ ErrorPairAppend:36 "not pairs"
}
