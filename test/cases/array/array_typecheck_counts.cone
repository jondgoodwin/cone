// What an entry of an array's contents may give. Its size is fixed, so the
// count of 'n of x' is a constant, from 0 through 4294967295 as an array's
// size is; a value must be the element type; and a pair 'k: v' is no value.
//
// The count of 'n of x' on a growable collection is collection_typecheck_contents's.

mod array_typecheck_counts;

fn counts(n: usize) {
  let runtime = Array[i32, 3]() <- n of 0;               //~ ErrorRepeatCount:36 "the count before 'of' in its contents is a constant"
  let negative = Array[i32, 3]() <- -1 of 0, fill 1;     //~ ErrorRepeatCount:38 "may not be negative"
  let huge = Array[i8, 3]() <- 4294967296 of 7i8;        //~ ErrorRepeatCount:32 "may be at most 4294967295"
}

fn values() {
  let text = Array[i32, 2]() <- fill "two";              //~ ErrorInvType:38 "does not match the array's element type"
  let pairs = Array[i32, 2]() <- 1: 2, 3;                //~ ErrorPairAppend:34 "not pairs"
}
