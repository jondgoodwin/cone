// What '[]' and '.len' will not accept. An empty array literal has its element
// type from the type expected where it is written, so with none expected, or
// an array of some elements expected, it is refused. '.len' reads no value,
// so a receiver that runs code is refused rather than dropping the code.
//
// Type-check stage only.

mod array_reject_empty;

fn three() Array[i32, 3] {
  return [1, 2, 3];
}

fn nothingExpected() {
  let a = [];   //~ ErrorBadArray:11 "An empty array literal '[]' takes its element type from the type expected where it is written"
}

fn someExpected() {
  var a: Array[i32, 2] = [];   //~ ErrorBadArray:26 "An empty array literal '[]' has no elements, and the array expected here holds 2."
}

fn receiverRunsCode() {
  let n = three().len;   //~ ErrorBadArray:18 "The length of an array is its type's, so '.len' reads no value"
}
