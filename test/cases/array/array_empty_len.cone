// The empty array literal '[]' and the count of an array, 'a.len'.
//
// '[]' takes its element type from the type expected where it is written: a
// declared variable, a parameter, a field, a return. The array it makes holds
// no elements, so the expected type is 'Array[T, 0]'. 'a.len' is the count the
// array's type states, a 'usize' constant: nothing is read at run time, so the
// same count answers for an array that holds nothing, for the first
// dimension of one written with several sizes, and for the element of an array
// of arrays. array_reject_empty has what neither accepts.

mod array_empty_len;

import stdio use *;

fn showU(label: &str, n: u64) {
  printStr(label);
  printStr(" = ");
  printUInt(n);
  printStr("\n");
}

struct Holder {
  pub var none: Array[i32, 0];
  pub var trio: Array[i32, 3];
}

fn countOf(a: Array[i32, 0]) usize {
  return a.len;
}

fn nothing() Array[u8, 0] {
  return [];
}

fn viaBorrow(a: &Array[i32, 5]) usize {
  return a.len;
}

fn main() i32 {
  // A declared variable, a parameter, a field and a return give '[]' its type
  var a: Array[i32, 0] = [];
  showU("variable", a.len);
  showU("parameter", countOf([]));
  let h = Holder([], [7, 8, 9]);
  showU("field none", h.none.len);
  showU("field trio", h.trio.len);
  let g = nothing();
  showU("return", g.len);

  // The count is the type's: a filled array, a borrow of one, several sizes,
  // an element that is itself an array, and the call form
  var b: Array[i32, 5] = [1, 2, 3, 4, 5];
  showU("b", b.len);
  showU("b borrowed", viaBorrow(&b));
  showU("b called", b.len());
  var grid = Array[i32, 2, 3]() <- fill 0;
  showU("grid rows", grid.len);
  showU("grid row", grid[1].len);
  let rows: Array[Array[u8, 4], 3] = [[1u8, 2u8, 3u8, 4u8], [5u8, 6u8, 7u8, 8u8], [9u8, 10u8, 11u8, 12u8]];
  showU("rows", rows.len);
  showU("rows[2]", rows[2].len);

  // It is a constant, so it sizes an array
  var c: Array[i32, 3] = [0, 0, 0];
  var i: usize = 0;
  var sum: u64 = 0;
  while i < c.len {
    sum = sum + u64.from(i);
    i = i + 1;
  }
  showU("loop sum", sum);
  return 0;
}
