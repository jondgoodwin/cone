// A named constant sizes an array type: 'Array[T, Three]', for a usize
// constant, an untyped integer one, or a constant naming another.

mod array_const_size;

import stdio use *;

const Three: usize = 3;
const Four = 4;
const Alias: usize = Three;

fn main() i32 {
  var a = Array[i32, Three]() <- 10, 20, 30;
  var b = Array[i32, Four]() <- fill 7;
  var c = Array[i32, Alias]() <- fill 5;
  printInt(a[0] + a[1] + a[2]);
  printStr("\n");
  printInt(b[3]);
  printStr("\n");
  printInt(c[2]);
  printStr("\n");
  0
}
