// Bracket forms the compiler will not accept as an array literal.
//
// Type-check stage only: this file parses and resolves cleanly, so every
// diagnostic below is reached. What the array type 'Array[T, n]' will not
// accept is in array_typecheck_size and array_nameres_spelling; what an
// existing array will not accept is in array_reject_use.
//

mod array_reject_shape;

fn literalDimensionCount() {
  // A literal in the fill form carries exactly one count. This is the case
  // that used to kill the compiler: the check returned without giving the
  // literal a type, and the binding below then read the type that was never
  // written.
  imm twoDims = [2, 3; 0];   //~ ErrorBadArray:17 "may only specify one dimension"
}

fn literalFillCount() {
  // A fill form fills with one value, and the same early return applies
  imm twoFills = [2; 1, 2];   //~ ErrorBadArray:18 "fill value may only be one value"
}

fn listOfType() {
  // A list whose element is a type is no literal, and no array type either:
  // the type has its element type and size in 'Array[i32, 3]'
  mut noSize [i32];   //~ ErrorBadArray:14 "exactly one numeric array dimension"
}

fn literalElements() {
  // Every element of a multi-value literal must have the first element's type
  imm mixed = [1, 2.5];   //~ ErrorBadArray:19 "Inconsistent type of array literal value"
}

fn fillDimensionType() {
  // The count in the '[N; value]' fill form must reach usize
  imm fromFloat = [1.5; 0];   //~ ErrorBadArray:19 "dimension must coerce to usize"
}

fn fillDimensionConst() {
  // ...and it must be constant, since it becomes part of the array's type
  mut count usize = 3;
  imm fromVar = [count; 0];   //~ ErrorBadArray:17 "dimension value must be a constant"
}

// A reinterpretation of a constant is a constant (core_constcast), but its
// count is known only once generated, and the array's type needs it now
// (accepted, it reached generation with a count of zero and hung the compiler)
const Recount usize = 3usize as usize;
fn fillDimensionCast() {
  imm fromCast = [3usize as usize; 0];   //~ ErrorBadArray:18 "an integer literal, or a named constant holding one"
  imm fromCastConst = [Recount; 0];      //~ ErrorBadArray:23 "an integer literal, or a named constant holding one"
}
