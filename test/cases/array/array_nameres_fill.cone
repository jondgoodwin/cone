// The fill literal, '[n; x]', is retired: an array of n values is constructed
// with its contents, 'new Array[T, n] <- fill x' (array_contents). Name
// resolution refuses it wherever it is written, once it can tell a value for
// x from a type, which is the old array type's spelling and
// array_nameres_spelling's.

mod array_nameres_fill;

fn take(a Array[i32, 3]) {}

mut global = [3; 0];               //~ ErrorFillLiteral:14 "new Array[T, n] <- fill x"

fn written() {
  imm zeros = [4; 0];              //~ ErrorFillLiteral:15 "new Array[T, n] <- fill x"
  imm twoCounts = [2, 3; 0];       //~ ErrorFillLiteral:19 "new Array[T, n] <- fill x"
  take([3; 1]);                    //~ ErrorFillLiteral:8 "new Array[T, n] <- fill x"
}
