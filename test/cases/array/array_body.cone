// 'Array[T]', the body of T values whose count is known only at run time, held
// only through a reference that carries the count. Its borrow is the slice,
// '&Array[T]', which is the same type as '&[]T': either spelling is accepted
// wherever the other is. An owner of it ('So', 'Rc', 'Sync's 'Arc') is a
// pointer and a count, reaches 'len', indexes and takes a borrowed range as
// the slice does, and is lent as a slice where one is wanted, inferring a
// generic's element type. A fixed array's borrow, '&Array[T, n]', converts to
// the slice.
//
// Each printed value was worked out by hand from the sources: the numbers are
// 10, 20, 30, 40 and their sum is 100.

mod array_body;

import stdio use *;
import sync use Arc;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn flag(b bool) i64 { if b {1;} else {0;}; }

// The same sum, with the slice written each way
fn sumBody(xs &Array[i32]) i32 {
  mut t = 0i32;
  mut i = 0usize;
  while i < xs.len {
    t = t + xs[i];
    i = i + 1usize;
  }
  t;
}
fn sumSlice(xs &[]i32) i32 { sumBody(xs); }
fn sumBack(xs &Array[i32]) i32 { sumSlice(xs); }

// A writable borrow of the body, written each way
fn doubleBody(xs &mut Array[i32]) {
  mut i = 0usize;
  while i < xs.len {
    xs[i] = xs[i] * 2;
    i = i + 1usize;
  }
}
fn doubleSlice(xs &[]mut i32) { doubleBody(xs); }

// A generic over the element, inferred from a slice, a fixed array's borrow and an owner
fn count[T](xs &Array[T]) usize { xs.len; }

// The body through an alias
alias Ints = Array[i32];
fn sumAlias(xs &Ints) i32 { sumBody(xs); }

// Held in a struct, borrowed and owned
struct Holder {
  pub lent &Array[i32];
  pub shared Rc[imm, Array[i32]];
}

fn main() {
  imm fixed Array[i32, 4] = [10, 20, 30, 40];

  // One type, two spellings
  show("body", i64.from(sumBody(&fixed)));
  show("slice", i64.from(sumSlice(&fixed)));
  show("back", i64.from(sumBack(&fixed)));
  show("alias", i64.from(sumAlias(&fixed)));
  imm a &Array[i32] = &fixed;
  imm b &[]i32 = a;
  imm c &Array[i32] = b;
  show("same", flag(a === b and b === c));

  // Writing through the body's borrow, and the slice's
  mut work Array[i32, 4] = [1, 2, 3, 4];
  doubleBody(&mut work);
  doubleSlice(&mut work);
  show("doubled", i64.from(sumBody(&work)));

  // Owners are a pointer and a count: copies of the elements, lent as slices
  imm one = new So[Array[i32]](&fixed);
  imm shared = new Rc[imm, Array[i32]](&fixed);
  imm atomic = new Arc[imm, Array[i32]](&fixed);
  show("So len", i64.from(one.len));
  show("Rc len", i64.from(shared.len));
  show("Arc len", i64.from(atomic.len));
  show("So sum", i64.from(sumBody(one)));
  show("Rc sum", i64.from(sumSlice(shared)));
  show("Arc sum", i64.from(sumBody(atomic)));
  show("So index", i64.from(one[2usize]));
  show("Rc index", i64.from(shared[3usize]));

  // A borrowed range of an owner is a slice, and so is its element's borrow
  imm tail = &shared[1usize..];
  show("range len", i64.from(tail.len));
  show("range first", i64.from(tail[0usize]));
  show("range sum", i64.from(sumBody(&one[1usize..3usize])));
  imm last = &one[3usize];
  show("element borrow", i64.from(*last));

  // The element type inferred
  show("count slice", i64.from(count(&fixed)));
  show("count fixed", i64.from(count(a)));
  show("count So", i64.from(count(one)));
  show("count Rc", i64.from(count(shared)));

  // Held in a struct
  imm held = new Holder(&fixed, shared);
  show("holder", i64.from(held.lent.len) * 100 + i64.from(held.shared.len));
  imm copy = held.shared;
  show("Rc copies", i64.from(copy.len));
  show("an empty range", i64.from(count(&shared[2usize..2usize])));

  // Held writable, an owner's elements change and its length does not: lent
  // as the writable slice, assigned through, borrowed writable
  mut grown = new So[Array[i32]](&fixed);
  doubleBody(grown);
  show("lent writable", i64.from(sumBody(grown)));
  grown[1usize] = 5;
  show("assigned", i64.from(grown[1usize]));
  imm elem = &mut grown[2usize];
  *elem = 7;
  show("element", i64.from(grown[2usize]));
  imm part = &mut grown[2usize..];
  part[1usize] = 8;
  show("range", i64.from(grown[3usize]));
  show("same length", i64.from(grown.len));
  imm cell = new Rc[mut, Array[i32]](&fixed);
  doubleBody(cell);
  cell[0usize] = cell[0usize] + 1;
  show("Rc[mut]", i64.from(cell[0usize]));
}
