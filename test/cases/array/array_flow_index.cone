// An index on the left of an assignment is a value, and is read like one.
//
// Flow stage. An assignment reads its right side; its left side is a target,
// but the index an element is chosen by is a value in its own right. It was
// not read at all, so the same expression was checked on the right and not on
// the left -- 'imm x = a[i]' caught an uninitialized index and 'a[i] = 5' did
// not. Swap read both of its sides all along.
//
// 'ref' holds the other half, writing through an uninitialized reference,
// which is the same gap and was a silent store through uninitialized memory.

mod array_flow_index;

fn readsTheIndex() {
  var a: Array[i32, 3] = [1, 2, 3];
  var i: usize;
  a[i] = 5;               //~ ErrorMove:5 "has not been initialized"
}

// The *base* of a partial write is not read ('a[0] = 5' does not read the
// elements it leaves), but flow tracks the whole array rather than its
// elements, so an element is stored only into an array that holds a value
// (move_flow_uninit_borrow).
fn storesIntoNothing() {
  var a: Array[i32, 3];
  a[0] = 5;               //~ ErrorMove:4 "stored only into a variable"
  return;
}
