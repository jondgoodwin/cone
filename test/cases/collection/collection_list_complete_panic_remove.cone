// A program error in a List method is a panic naming the line of its call: remove(i) at the length.
// What ran before it printed.

mod collection_list_complete_panic_remove;

import stdio use *;
import collections use *;

fn main() {
  var l = List[i64]();
  l.push(1i64);
  l.push(2i64);
  printStr("before\n");
  l.remove(2usize);
}
