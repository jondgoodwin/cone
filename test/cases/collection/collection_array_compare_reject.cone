// What a comparison of two fixed arrays refuses: elements with no '==', another
// length, and an ordering, which an array does not have, as a slice has none.

mod collection_array_compare_reject;

struct Plain {
  pub n: i32;
}

fn noEq() bool {
  var a: Array[Plain, 1] = [Plain(1)];
  var b: Array[Plain, 1] = [Plain(1)];
  a == b                //~ ErrorRefNoCompare:5 "Plain declares no `==`"
}

fn noNe() bool {
  var a: Array[Plain, 1] = [Plain(1)];
  var b: Array[Plain, 1] = [Plain(1)];
  a != b                //~ ErrorRefNoCompare:5 "`!=` on two arrays compares their elements"
}

fn lengths() bool {
  var a: Array[i32, 3] = [1, 2, 3];
  var b: Array[i32, 2] = [1, 2];
  a == b                //~ ErrorInvType:5 "same element type and length"
}

fn order() bool {
  var a: Array[i32, 3] = [1, 2, 3];
  var b: Array[i32, 3] = [1, 2, 3];
  a < b                 //~ ErrorRefNoCompare:5 "an array has no order"
}
