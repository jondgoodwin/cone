// What stays accepted beside collection_flow_args_store's refusals of a store
// over a variable inside a call's argument: a store to another variable there,
// a store to a field the borrow does not reach, a scalar changed by a value that
// stores it first ('x += {x = 5; 1}'), 'x += x', a '<-' whose later entry reads
// the list or stores another variable, and a store once the call is made.

mod collection_args_store_success;

import stdio use *;
import collections use *;

struct H { pub items: List[List[usize]]; pub n: usize; }

fn lists() List[List[usize]] {
  var l = List[List[usize]]();
  l.push(List[usize]());
  l
}

fn other() {
  var l = lists();
  var q = lists();
  l[0usize].push({q = lists(); q.push(List[usize]()); 5usize});
  printInt(i64.from(l[0usize][0usize])); printStr(" ");
  printInt(i64.from(q.len())); printStr("\n");
}

fn sibling() {
  var s = H(lists(), 0usize);
  s.items[0usize].push({s.n = 3usize; 7usize});
  printInt(i64.from(s.items[0usize][0usize])); printStr(" ");
  printInt(i64.from(s.n)); printStr("\n");
}

fn scalars() {
  var x = 1usize;
  x += {x = 5usize; 1usize};
  printInt(i64.from(x)); printStr(" ");
  x += x;
  printInt(i64.from(x)); printStr("\n");
}

fn entries() {
  var l = List[usize]();
  var n = 0usize;
  l <- 4usize, l.len();
  l <- {n = 9usize; n}, n + 1usize;
  var i = 0usize;
  while i < l.len() { printInt(i64.from(l[i])); printStr(" "); i = i + 1usize; }
  printInt(i64.from(n)); printStr("\n");
}

fn after() {
  var l = lists();
  l[0usize].push(5usize);
  l = lists();
  printInt(i64.from(l[0usize].len())); printStr("\n");
}

fn main() i32 {
  other();
  sibling();
  scalars();
  entries();
  after();
  0
}
