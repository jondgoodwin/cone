// What collection_flow_store_owner leaves alone: a store beside a borrow into a collection
// an owning reference holds, when the store cannot free what the borrow points into --
// another field of the ship, a borrow used up before the store, locals the function owns
// (two names for no one thing), and the same shared ship stored over after its borrow's
// last use.

mod collection_store_owner_success;

import collections use *;
import stdio use *;

struct Item { pub n i64; }
struct Ship { pub fuel i64; pub vec Uni[List[Item]]; }

fn mkvec(n i64) Uni[List[Item]] {
  var l = List[Item].empty();
  l.push(new Item(n));
  new Uni[List[Item]](l);
}

fn mk(n i64) Ship { new Ship(0, mkvec(n)); }

// Another field of the other ship written: the list is not touched
fn otherField(a &mut Ship, b &mut Ship) i64 {
  let e = a.vec[0usize];
  b.fuel = 7;
  e.n + b.fuel;
}

// The borrow used up before the other ship's owner is replaced
fn usedFirst(a &mut Ship, b &mut Ship) i64 {
  let n = a.vec[0usize].n;
  b.vec = mkvec(99);
  n + b.vec[0usize].n;
}

// Two locals are two ships
fn twoLocals() i64 {
  var s = mk(5);
  var t = mk(1);
  let e = s.vec[0usize];
  t.vec = mkvec(6);
  e.n * 100 + t.vec[0usize].n;
}

// One shared ship, named twice, replaced after the last use of the borrow
fn sharedAfter(r Rc[mut, Ship], q Rc[mut, Ship]) i64 {
  let n = r.vec[0usize].n;
  q.vec = mkvec(77);
  n + r.vec[0usize].n;
}

fn main() {
  var a = mk(10);
  var b = mk(20);
  printInt(otherField(&mut a, &mut b));
  printStr("\n");
  var c = mk(10);
  var d = mk(20);
  printInt(usedFirst(&mut c, &mut d));
  printStr("\n");
  printInt(twoLocals());
  printStr("\n");
  let r = new Rc[mut, Ship](mk(10));
  printInt(sharedAfter(r, r));
  printStr("\n");
}
