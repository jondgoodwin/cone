// A program error in a List method is a panic naming the line of its call: copyFrom(src) of a different length.
// What ran before it printed.

mod collection_list_complete_panic_copyfrom;

import stdio use *;
import collections use *;

fn main() {
  var l = List[i64]();
  l.push(1i64);
  l.push(2i64);
  let m = List[i64]();
  printStr("before\n");
  l.copyFrom(m.view());
}
