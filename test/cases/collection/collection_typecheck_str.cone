// What is refused of text. A range of it makes a part only when borrowed, since
// the text itself has no size to hold; it is indexed by a number of bytes, not
// by anything else; and a character-or-boundary question is a program error at
// run time, which collection_str and the collections package's strboundary
// test cover.
//
// Type check stage.

mod collection_typecheck_str;

fn unborrowed(s &str) {
  imm part = s[1usize..];        //~ ErrorBadIndex "A range of text makes a part of it only when borrowed"
}

fn ownerUnborrowed(o So[str]) {
  imm part = o[1usize..<2usize];  //~ ErrorBadIndex "A range of text makes a part of it only when borrowed"
}

fn badIndex(s &str) {
  imm c = s[1.5];                //~ ErrorNoCandidate "No method declared by `[]` accepts the call's arguments"
}

fn write(s &str) {
  s[0usize] = 65u8;              //~ ErrorBadLval "Expression must be lval"
}
