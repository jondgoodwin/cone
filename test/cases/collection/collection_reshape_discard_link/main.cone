// A value of another package's type behind a '&<mut Scorer + ShapeKeeping'. The
// program holds q's include file, which has no method bodies; q's compile read
// 'Tally.bump', whose body and callee discard values with '_', and recorded the
// type ShapeKeeping, so it passes here.
//
// Each printed value was checked by hand against q's source.

mod prog;

import stdio use *;
import q;

trait Scorer { pub fn bump(self: &mut, w: &mut q.World); }

fn show(label: &Array[u8], n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn through(w: &mut q.World, s: &<mut Scorer + ShapeKeeping) i64 {
  s.bump(w);
  w.score
}

fn main() {
  var w = q.world();
  var t = q.Tally(10);
  show("through", through(&mut w, &mut t));     // 1 + 1 + 10
  var c = q.Clearer();
  c.bump(&mut w);
  show("after clear", w.score);                 // 12
}
