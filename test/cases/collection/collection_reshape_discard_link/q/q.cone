// A package compiled on its own (http3's 'zzpart', reduced): its include file records
// which of its types reshape nothing a caller borrows, which the compile reads from
// the bodies of their public methods and of what those call. Those bodies hold '_'
// targets. A '_' writes no place, so 'Tally', whose 'bump' discards values that
// reshape nothing (in its own body, and in 'note', which it calls), is recorded
// ShapeKeeping, as 'Cell' is. 'Clearer' discards what 'Cell.take' hands back, and
// 'take' reshapes the Cell it reaches through a '&mut' parameter: not recorded.

mod q;

// Changes shape: a method writes the pointer it owns and one lends a borrow of what
// it points at
pub struct Cell {
  ptr: *i64;
  pub n: i64;

  pub fn put(self: &mut, p: *i64) { ptr = p; }
  pub fn take(self: &mut) *i64 {
    let p = ptr;
    ptr = null;
    p
  }
  pub fn count(self: &) i64 { n }
  pub fn first(self: &) &i64 { ptr as &i64 }
}

pub struct World {
  pub score: i64;
  pub cell: Cell;
}

fn note(w: &mut World) {
  _ = w.cell.count();
  w.score = w.score + 1;
}

pub struct Tally {
  pub n: i64;

  pub fn bump(self: &mut, w: &mut World) {
    note(w);
    _ = w.cell.count();
    if n > 0 {_ = w.score;}
    w.score = w.score + n;
  }
}

pub struct Clearer {
  pub fn bump(self: &mut, w: &mut World) { _ = w.cell.take(); }
}

pub fn world() World { World(1, Cell(null, 0)) }
