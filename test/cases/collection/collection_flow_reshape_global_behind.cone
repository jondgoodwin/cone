// A 'var' global that could hold what a method behind a virtual reference lends: its owner's value
// has what 'Shape' asks for, so it may be what a 'part' lends, though it never says it is a
// 'Shape'. A call through a virtual reference between the loan and its use may store over the
// global, so it is refused. (collection_reshape_global_behind_success holds a global that could
// not.)

mod collection_flow_reshape_global_behind;

trait Shape {
  pub fn part(self: &) Option[&<Shape] { None }
  pub fn poke(self: &, out: &uni i64);
}

struct Tree is Shape {
  pub fn poke(self: &, out: &uni i64) {}
}

struct Quiet {
  pub fn poke(self: &, out: &uni i64) {}
}

var held: Option[Rc[mut, Quiet]] = None[Rc[mut, Quiet]];

fn pokeAll(s: &Tree, other: &<Shape, out: &uni i64) {
  var at = s.part();
  var more = true;
  while more {
    match at {
      case let Some(p) {
        other.poke(&uni *out);                       //~ ErrorShapeReshape "a 'var' global reaches"
        at = p.part();                               //~ ErrorShapeReshape "a 'var' global reaches"
      }
      case is None { more = false; }
    }
  }
}

fn main() {}
