// A reference a call returned, read through to a String ('ui.items[0usize].label'), is
// followed as the name it would be given is: a view of that String, handed to a call
// that could reshape that String through another name, is refused (collection_flow_reshape
// refuses the same through a name: 'imm item = ui.items[0usize]; ...item.label.view()').
// A 'List[Item]' element is reached by '[]', a call, so the view had no loan on the String
// and the call that grew the very String went unchecked: with 'ed' and 'src' one value,
// 'ed.grow(src.items[0usize].label.view())' read the old block after it was freed.
// A call can reach that String only through the struct that holds it (here 'Item', or
// whatever holds an 'Item'), or through a reference to a String: a 'Dl' that has a String
// of its own reaches another one (collection_reshape_through_call_success).
// collection_reshape_through_call_success holds what is accepted beside each refusal.

mod collection_flow_reshape_through_call;

import collections use *;

struct Item { pub label String; pub n i32; }

struct Ed {
  pub items List[Item];

  // Appends s to the first label: the label's block may move
  pub fn grow(self &mut, s &str) {
    let r = &mut items[0usize];
    r.label.append(s);
  }
}

// Through two parameters of one type: the caller may have made them one value
fn twoParams(ed &mut Ed, src &mut Ed) {
  ed.grow(src.items[0usize].label.view());    //~ ErrorShapeReshape:5 "'grow' is handed something that reaches a 'String'"
}

// The same through a name, as it was refused already
fn named(ed &mut Ed, src &mut Ed) {
  let item = src.items[0usize];
  ed.grow(item.label.view());                 //~ ErrorShapeReshape:5 "'grow' is handed something that reaches a 'String'"
}

// A String that grows from a view of another String reached the same way
fn appendTo(out &mut String, ui &Ed) {
  out.append(ui.items[0usize].label.view());  //~ ErrorShapeReshape:6 "'append' reshapes the 'String' it is called on"
}

fn main() {}
