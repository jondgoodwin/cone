// 'of' and 'fill' are words only in a list after '<-'. Anywhere else they are
// names, so a count before 'of' or a value after 'fill' is what a name could
// not be followed by, and the statement is malformed where it continues.
//
// collection_contents uses both as names where they are not words.

mod collection_parse_contents;

fn outside() {
  imm repeated = 3 of 4;        //~ ErrorNoSemi:19
                                //~^ ErrorNoSemi:22 follow-on
  imm filled = fill 0;          //~ ErrorNoSemi:20
}

fn inside() {}
