// A package compiled against another's include file. q.cone stands for q's
// generated include file, the one collection_shapekeeping_link builds: it has no
// method bodies, and records ShapeKeeping on the types whose methods reshape
// nothing a caller borrows. user.cone passes q's types behind a
// '&<mut Scorer + ShapeKeeping'.

build: debug
output: library

import q: "q.cone"

user: {
    "user.cone"
    import q: "q.cone"
}
