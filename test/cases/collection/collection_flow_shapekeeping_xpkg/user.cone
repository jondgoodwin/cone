// A type of a package whose include file has no bodies goes behind a
// '+ ShapeKeeping' reference only if the file records it (the file is q.cone;
// collection_shapekeeping_link builds one and runs what passes). 'Tally' is
// recorded, and passes. 'Putter' pushes into a Cell it reaches through a
// '&mut' parameter, and 'Mixed' has one such method beside one that does not,
// so neither is recorded: each is refused at the pass, as a body the compiler
// cannot read is.

mod user;

import q;

trait Scorer { pub fn bump(self &mut, w &mut q.World); }

fn through(w &mut q.World, s &<mut Scorer + ShapeKeeping) i64 {
  s.bump(w);
  w.score
}

fn recorded(w &mut q.World) i64 {
  var t = new q.Tally(1);
  through(w, &mut t)
}

fn putter(w &mut q.World) i64 {
  var p = new q.Putter();
  through(w, &mut p)   //~ ErrorNotShapeKeeping "Putter is a type of a package whose include file"
}

fn mixed(w &mut q.World) i64 {
  var m = new q.Mixed(1);
  through(w, &mut m)   //~ ErrorNotShapeKeeping "Mixed is a type of a package whose include file"
}
