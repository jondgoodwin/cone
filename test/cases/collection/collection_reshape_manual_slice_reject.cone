// What stays refused beside collection_reshape_manual_idioms (the manual's mem-shape page): a function that
// views a list it was handed while pushing to another argument, and a caller that makes the slice from the
// very list the callee pushes to. The caller answers for its slice.

mod collection_reshape_manual_slice_reject;

import collections use *;

fn emit(src: &List[u8], out: &mut List[u8]) u8 {
  let s = src.view();
  out.push(1u8);                //~ ErrorShapeReshape:6 "'push' reshapes the 'List' it is called on"
  s[0usize]
}

fn emitSlice(src: &Array[u8], out: &mut List[u8]) u8 {
  let first = src[0usize];
  out.push(first);
  src[0usize]
}

fn callerOwn(out: &mut List[u8]) u8 {
  emitSlice(out.view(), out)//~ ErrorShapeReshape:12 "'emitSlice' is handed something that reaches a 'List'"
}
