// A range index written with a bare '..' between a start and an end does not say
// whether the end is included, so it is refused where it stands, and read on as
// '..=' so that the rest of the range is checked ('a..=b' includes b and 'a..<b'
// stops before it). A '..' with no end ('a..' runs to the end) or no start is not
// between two operands. '..=' must say where it ends, as '..<' must.

mod collection_parse_range_bare;

fn between(s: &Array[i32]) {
  let r = &s[1..3];   //~ ErrorRangeBare:15 "write '..<' to stop before the end, or '..=' to include it"
}

fn spaced(s: &Array[i32], a: usize, b: usize) {
  let r = &s[a .. b + 1];   //~ ErrorRangeBare:16 "'..' does not say whether the range includes its end"
}

fn named(s: &Array[i32], a: usize, b: usize) {
  let r = &s[a..b];   //~ ErrorRangeBare:15 "write '..<' to stop before the end"
}

fn open(s: &Array[i32]) {
  let r = &s[1..=];    //~ ErrorBadIndex:18 "must say where it ends"
}
