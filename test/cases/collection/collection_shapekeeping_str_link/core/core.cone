// A core package of the one type the compiler makes, 'str', compiled on its own
// into a library object before the program is compiled. The runner builds it
// because cases.toml lists it under 'link'. Its one method is not inline, so
// its include file records 'str' as keeping the shape of what a caller borrows.

mod core;

pub struct @opaque str {
  pub fn probeLen(self: &) usize { 7usize }
}
