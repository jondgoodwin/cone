// A program compiled separately from the core it imports, and linked with it.
// Core is compiled on its own first (core\core.conebuild, listed under 'link' in
// cases.toml), which writes its include file, and this program is compiled
// against it: include\core.cone, which the runner requires to be what core's
// compile generated, byte for byte ('include' in cases.toml). A line naming core
// stands outside the program's module, as Congo writes it: core is the prelude.

build: debug
output: executable

import core: "include/core.cone"

prog: {
    "main.cone"
}
