// The compiler makes 'str' and core only gives it methods, so the include file of
// a core with a method on it that is not inline records ShapeKeeping on the type
// the compiler made. The program takes 'str' as the file says, rather than
// refusing it as a type that declares ShapeKeeping itself (ErrorShapeKeepingDeclared).
//
// The exit status is the check: 0 when the call gives core's 7, whatever the text.

mod prog;

fn main() i32 {
  let s: &str = "abc";
  if s.probeLen() == 7usize { 0 } else { 1 }
}
