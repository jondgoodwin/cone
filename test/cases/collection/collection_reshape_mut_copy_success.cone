// What copies of one '&mut' borrow of a local still do beside a view taken through one of
// them (collection_flow_reshape_mut_copy holds what is refused): write an element, read, and
// change the shape once the view is used for the last time.

mod collection_reshape_mut_copy_success;

import stdio use *;
import collections use *;

fn length(a: &List[i32]) { printInt(i64.from(a.len())); }

fn elementWrite() {
  var l = List[i32]();
  l.push(7i32);
  let r = &mut l;
  let r2 = r;
  let v = &(*r)[0usize];
  (*r2)[0usize] = 9i32;
  printInt(i64.from(*v));
}

fn reads() {
  var l = List[i32]();
  l.push(7i32);
  let r = &mut l;
  let r2 = r;
  let v = &(*r)[0usize];
  printInt(i64.from((*r2).len()));
  length(r2);
  length(r);
  printInt(i64.from(*v));
}

fn viewEnds() {
  var l = List[i32]();
  l.push(7i32);
  let r = &mut l;
  let r2 = r;
  let v = &(*r)[0usize];
  printInt(i64.from(*v));
  *r2 = List[i32]();
  r2.push(3i32);
  r.push(4i32);
  printInt(i64.from((*r)[1usize]));
}

fn anotherList() {
  var l = List[i32]();
  l.push(7i32);
  let r = &mut l;
  let r2 = r;
  var m = List[i32]();
  let v = &(*r)[0usize];
  m.push(1i32);
  m = List[i32]();
  printInt(i64.from(*v));
  r2.push(2i32);
  printInt(i64.from(m.len() + (*r2).len()));
}

// An element borrowed from a local list and handed on is a name for the element alone: the
// callee may reshape another list of the same type
fn bump(other: &mut List[i32], c: &mut i32) { other.push(*c); *c = *c + 1i32; }

fn elementHandedOn(other: &mut List[i32]) {
  var cs = List[i32]();
  cs.push(5i32);
  var k = 0usize;
  while k < cs.len() {
    let c = &mut cs[k];
    bump(other, c);
    k = k + 1usize;
  }
  printInt(i64.from(cs[0usize]));
}

fn main() {
  elementWrite();
  reads();
  viewEnds();
  anotherList();
  var o = List[i32]();
  elementHandedOn(&mut o);
  printInt(i64.from(o.len()));
}
