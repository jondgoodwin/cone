// A slice of part of a slice is bounds-checked against the length the slice
// carries: the start may not pass the end, nor the end the length.
//
// As for collection_bounds_slice, the check only announces itself by aborting,
// so it is asserted in the generated LLVM IR by the named check in cases.toml.
// The slice arrives as a parameter and the bounds are parameters, so nothing
// about them is known until run time and the comparisons survive.
//
// One function, so the IR the check reads is this one's.

mod collection_bounds_subslice;

fn part(s &[]i32, a usize, b usize) &[]i32 {
  &s[a..b];
}
