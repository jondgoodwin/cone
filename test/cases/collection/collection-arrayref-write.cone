// Defect: an element cannot be assigned through a reference to a fixed-size
// array without an explicit dereference.
//
// 'v' is a '&mut [3; i32]', so writing v[0] should be allowed. It is not:
// iexpGetLvalInfo in src/c-compiler/ir/iexp.c takes the permission from the
// reference
// only when the indexed object is an ArrayRefTag or a PtrTag. A RefTag whose
// value type is an array falls through to the permission of the variable
// holding the reference, which for a parameter is 'imm', and the write is
// refused with ErrorNoMut "You do not have permission to modify lval".
//
// Reading is unaffected -- 'v[0]' as a value compiles -- and spelling the
// dereference out works, because the DerefTag case does consult the
// reference's permission. Both forms are below so that a fix that repaired
// only the write would still be caught by the reads.
//
// xfail: this file should compile clean.

fn writesDirect(v &mut [3; i32]) {
  v[0] = 9
}

fn writesThroughDeref(v &mut [3; i32]) {
  (*v)[0] = 9
}

fn readsDirect(v &mut [3; i32]) i32 {
  v[1]
}
