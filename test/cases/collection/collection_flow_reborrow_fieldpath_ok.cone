// Bug 93 (lane 465, row 339), accepted: the view ends before the field of the original is
// written, through the reborrow and through a '&uni' one. Prints 5, 5 and 45 (the length of
// the view taken before each append, then of the grown String).

mod collection_flow_reborrow_fieldpath_ok;

import stdio use *;
import collections use *;

struct Rd {
  pub buf: String;
  pub n: i32;
  pub fn view(self: &mut) &str { self.buf.view() }
}

fn viewEnds(r: &mut Rd) usize {
  let y: &mut Rd = r;
  let len = y.view().len;
  r.buf.append("0123456789012345678901234567890123456789");
  len
}

fn viewEndsUni(r: &uni Rd) usize {
  let y: &uni Rd = r;
  let len = y.view().len;
  r.buf.append("0123456789012345678901234567890123456789");
  len
}

fn main() {
  var r = Rd(String(), 1);
  r.buf.append("hello");
  print <- viewEnds(&mut r), "\n";
  var q = Rd(String(), 2);
  q.buf.append("hello");
  print <- viewEndsUni(&uni q), "\n";
  print <- r.view().len, "\n";
}
