// Bug 80. A heap allocation too big to get panics, naming the bytes asked for: the heap region and the
// raw blocks layer answered null, which the collection kept as its block with the room it asked for,
// and went on (wrap).

mod collection_heap_huge_wrap;

import stdio use *;
import collections use *;

fn main() {
  printStr("before\n");
  var l = List[u64].withCapacity(2305843009213693952usize);
  l.push(7u64);
  printStr("went on\n");
}
