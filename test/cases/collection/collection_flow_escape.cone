// A slice may not be stored where it would outlive the array it points at.
//
// ref_flow establishes the same rule for a plain borrowed reference.
// assignlvalrtype in ir/exp/assign.c used to reach the store check
// (ErrorInvType "lval outlives the borrowed reference you are storing") only
// when both the lval's type and the rval's type were RefTag, so an
// ArrayRefTag on either side skipped it and the assignment below was
// accepted. A slice borrows exactly as a reference does and carries the same
// scope, so both tags now reach it. That check holds a place outliving the
// function -- here, what a parameter points at -- to the borrow's lifetime; a
// slice kept in a variable of the function is the loan walk's, as ref_flow
// shows for a plain reference.
//
// The escape this prevents is real: after the function returns, the caller's
// slice would name storage that no longer exists, and a write through it
// would corrupt the stack. The sibling case -- a function returning a slice
// borrowed from one of its own locals -- is asserted by ref_flow_return,
// which owns the escape rule for return values.

mod collection_flow_escape;

fn escapingSlice(escaping &mut &[]mut i32) {
  mut inner Array[i32, 2] = [7, 8];
  *escaping = &[]mut inner;   //~ ErrorInvType "lval outlives the borrowed reference you are storing"
  // A slice of part of it lives exactly as long
  *escaping = &mut inner[0..1];   //~ ErrorInvType "lval outlives the borrowed reference you are storing"
}
