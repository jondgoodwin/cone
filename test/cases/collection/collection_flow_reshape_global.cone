// A view of a String, or of an element of a List, held in a 'mut' GLOBAL, or in anything reached from
// one, across a call that may reshape it. A function may write a global by its name, whatever it is
// handed, and the loan walk does not follow which one, so the same inference that judges every call
// judges this: a callee that reshapes the container's type through a global (its body, or what it calls,
// read by the shape inference) is refused, and so is one the compiler cannot read (a virtual call, a
// closure, a Cone function whose body is not here; collection_flow_reshape_global_opaque holds the calls
// through function values and to C). Only the intrinsics, an init, and a call through a
// virtual reference marked '+ ShapeKeeping' are let through unasked. An 'imm' global cannot change, so a
// borrow into it is untouched. collection_reshape_global_success holds what is accepted.
//
// Each function is a program that read freed memory when it was accepted: 'growFirst' appends to the big
// String the view points into, which moves its block.

mod collection_flow_reshape_global;

import collections use *;

struct Item { pub label String; }

struct Ed {
  pub items List[Item];
  pub fn growFirst(self &mut, s &str) {
    imm r = &mut items[0usize];
    r.label.append(s);
  }
}

mut gl Ed;
fn @initpure init() { gl = new Ed(List[Item].empty()); }

// The direct form: a visible function that writes the global by its name
fn grow(s &str) { gl.growFirst(s); }

fn direct() {
  grow(gl.items[0usize].label.view());                        //~ ErrorShapeReshape "points into a 'mut' global"
}

// The same view held in a name, and a call made while it is held
fn held() usize {
  imm v = gl.items[0usize].label.view();
  grow("more");                                               //~ ErrorShapeReshape "through a global"
  v.len;
}

// A closure held by an owner that is 'imm' can write a global through its captured function, and a
// '&<fn' called with the view, however read-only, can too
struct Holder { pub f Uni[imm, fn(s &str)]; }

fn viaHolder(h &Holder) {
  h.f(gl.items[0usize].label.view());                         //~ ErrorShapeReshape "points into a 'mut' global"
}

fn viaFn(f &<fn(s &str)) {
  f(gl.items[0usize].label.view());                           //~ ErrorShapeReshape "points into a 'mut' global"
}

// The view passed on through a helper that calls the closure: the helper's body runs code the compiler
// cannot see
fn useHolder(h &Holder, s &str) { h.f(s); }

fn viaHelper(h &Holder) {
  useHolder(h, gl.items[0usize].label.view());                //~ ErrorShapeReshape "runs code the compiler cannot see"
}
