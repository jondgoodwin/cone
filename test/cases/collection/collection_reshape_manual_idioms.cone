// The two cures for error 1339 that the packages use and the manual's mem-shape page names beside the
// three (swap a field into a local; pass a slice as a parameter). Each example here is the manual's.

mod collection_reshape_manual_idioms;

import stdio use *;
import collections use *;

struct Dec {
  inp: List[u8];
  hist: List[u8];

  // The swap: hist is a local for the length of the borrow of inp
  fn stepSwap(self: &mut) u8 {
    var h = List[u8]();
    h <-> hist;
    let s = inp.view();
    grow(&mut h);
    let first = s[0usize];
    h <-> hist;
    first
  }
}

fn grow(l: &mut List[u8]) { l.push(7u8); }

// The slice parameter: emit is not asked about src, so the caller that made the slice answers for it
fn emitSlice(src: &Array[u8], out: &mut List[u8]) u8 {
  let first = src[0usize];
  out.push(first);
  src[0usize]
}

fn caller(out: &mut List[u8]) u8 {
  var src = List[u8]();
  src.push(9u8);
  emitSlice(src.view(), out)
}

fn main() {
  var d = Dec(List[u8](), List[u8]());
  d.inp.push(5u8);
  printInt(i64.from(d.stepSwap()));
  printStr(" ");
  printInt(i64.from(d.hist.len()));
  printStr(" ");
  var out = List[u8]();
  printInt(i64.from(caller(&mut out)));
  printStr(" ");
  printInt(i64.from(out.len()));
  printStr("\n");
}
