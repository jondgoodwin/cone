// The manual's mem-shape page, "Pass a slice as a parameter": a function handed a slice is not asked
// about it, and the caller that made the slice answers for it (the refusal is collection_reshape_manual_slice_reject).

mod collection_reshape_manual_idioms;

import stdio use *;
import collections use *;

fn emitSlice(src: &Array[u8], out: &mut List[u8]) u8 {
  let first = src[0usize];
  out.push(first);
  src[0usize]
}

fn caller(out: &mut List[u8]) u8 {
  var src = List[u8]();
  src.push(9u8);
  emitSlice(src.view(), out)
}

fn main() {
  var out = List[u8]();
  printInt(i64.from(caller(&mut out)));
  printStr(" ");
  printInt(i64.from(out.len()));
  printStr("\n");
}
