// A program compiled against the include file of package q, which is compiled on its own first
// (q\q.conebuild, listed under 'link' in cases.toml) and writes it: include\q.cone, which the runner
// requires to be what q's compile generated, byte for byte ('include' in cases.toml). The two objects
// are then linked, with conestd, and the program run.

build: debug
output: executable

import libc: "../../../../packages/libc/src/libc.cone"
import q: "include/q.cone"
import stdio: "stdio.cone"

prog: {
    "main.cone"
    import q: "include/q.cone"
    import stdio: "stdio.cone"
}
