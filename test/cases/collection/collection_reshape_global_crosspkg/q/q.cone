// A package whose methods and functions have bodies the program that imports it does not hold: the
// include file it generates declares each 'extern', with a Cone path as its symbol (not C's name).
// 'Buf' owns storage and holds a '&fn' (as every collection's region does), so it changes shape and
// a reference to it reaches something callable.

mod q;

import libc;

pub struct Buf is ShapeChanging {
  pub p *u8;
  pub n usize;
  pub hook &fn(n usize) usize;

  pub fn make() Buf {
    imm b = new Buf(libc.malloc(8usize) as *u8, 8usize, &nothing);
    *b.p = 7u8;
    *(b.p + 1usize) = 9u8;
    b;
  }
  pub fn first(self &) &u8 { &*p; }
  pub fn grow(self &mut) { p = libc.realloc(p, n * 2usize) as *u8; n = n * 2usize; }
  pub fn len(self &) usize { n; }
  pub fn at(self &, i usize) u8 { *(p + i); }
}

fn nothing(n usize) usize { n; }

pub fn measure(b &Buf) usize { b.n; }
