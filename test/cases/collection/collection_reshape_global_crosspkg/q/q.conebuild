// Package q, compiled on its own into a library object before the program is compiled (the runner
// builds it because cases.toml lists it under 'link'). Its functions are not 'inline' or generic, so
// the include file it writes cuts each to an 'extern' and the program does not hold a body.

build: debug
output: library

import libc: "../../../../../packages/libc/src/libc.cone"

q: {
    "q.cone"
    import libc: "../../../../../packages/libc/src/libc.cone"
}
