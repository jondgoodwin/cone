// A program error in a List method is a panic naming the line of its call: insert(i, v) past the length.
// What ran before it printed.

mod collection_list_complete_panic_insert;

import stdio use *;
import collections use *;

fn main() {
  var l = List[i64]();
  l.push(1i64);
  l.push(2i64);
  printStr("before\n");
  l.insert(3usize, 9i64);
}
