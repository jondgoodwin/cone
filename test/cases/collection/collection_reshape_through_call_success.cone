// What the check for a view taken through a reference a call returned accepts
// (the refusals are collection_flow_reshape_through_call): the view copied out first,
// handed to a call that reads only or that grows nothing the view points into, used up
// before the call, and taken from a list the function owns.

mod collection_reshape_through_call_success;

import stdio use *;
import collections use *;

struct Item { pub label String; pub n i32; }

struct Ed {
  pub items List[Item];

  // Appends s to the first label: the label's block may move
  pub fn grow(self &mut, s &str) {
    let r = &mut items[0usize];
    r.label.append(s);
  }
}

struct Dl {
  pub chars String;
  pub cmds List[u32];
  pub fn text(self &mut, s &str) { chars.append(s); cmds.push(1u32); }
  pub fn textLen(self &mut, s &str) { cmds.push(u32.from(s.len)); }
  pub fn total(self &, s &str) usize { chars.view().len + s.len; }
}

struct Ui {
  pub items List[Item];
  pub dl Dl;
}

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn show2(label &str, s &str) {
  printStr(label);
  printStr(" = ");
  printStr(s);
  printStr("\n");
}

// Copied out first: no borrow is left to wait
fn copyFirst(ed &mut Ed, src &mut Ed) {
  let c = String.from(src.items[0usize].label.view());
  ed.grow(c.view());
}

// A callee that grows nothing the view points into
fn countOnly(dl &mut Dl, ui &Ui) {
  dl.textLen(ui.items[0usize].label.view());
}

// A callee that only reads
fn readOnly(dl &Dl, ui &Ui) usize {
  dl.total(ui.items[0usize].label.view());
}

// The view used up before the call that grows
fn usedUp(dl &mut Dl, ui &Ui) {
  let n = i64.from(ui.items[0usize].label.view().len);
  dl.text("next");
  show("usedUp", n);
}

// A list this function owns cannot be reached by another name
fn ownList(dl &mut Dl) {
  var items = List[Item].empty();
  items.push(new Item(String.from("own"), 1));
  dl.text(items[0usize].label.view());
}

// The viewed String is a field of an 'Item'; 'dl' holds a String of its own and no 'Item', so
// the call cannot reach the viewed one, whether 'ui' is shared, read-only or a field beside it
fn otherOwner(dl &mut Dl, ui &Ui) {
  dl.text(ui.items[0usize].label.view());
}

fn eachLabel(dl &mut Dl, ui &Ui) {
  var k = 0usize;
  while k < ui.items.len() {
    dl.text(ui.items[k].label.view());
    k = k + 1usize;
  }
}

struct Panel {
  pub items List[Item];
  pub dl Dl;
  pub fn push(self &mut) { dl.text(items[0usize].label.view()); }
}

// An element of a 'List[String]', which is not what 'dl' holds either
fn textsToDl(dl &mut Dl, texts &List[String]) {
  dl.text(texts[0usize].view());
}

fn main() i32 {
  var ed = new Ed(List[Item].empty());
  ed.items.push(new Item(String.from("ab"), 1));
  copyFirst(&mut ed, &mut ed);
  show2("copyFirst", ed.items[0usize].label.view());

  var ui = new Ui(List[Item].empty(), new Dl(String.empty(), List[u32].empty()));
  ui.items.push(new Item(String.from("hello"), 2));
  var dl = new Dl(String.empty(), List[u32].empty());
  countOnly(&mut dl, &ui);
  show("countOnly", i64.from(*dl.cmds[0usize]));
  show("readOnly", i64.from(readOnly(&dl, &ui)));
  usedUp(&mut dl, &ui);
  ownList(&mut dl);
  show2("ownList", dl.chars.view());

  var dl2 = new Dl(String.empty(), List[u32].empty());
  otherOwner(&mut dl2, &ui);
  eachLabel(&mut dl2, &ui);
  var names = List[String].empty();
  names.push(String.from("ab"));
  textsToDl(&mut dl2, &names);
  show2("otherOwner", dl2.chars.view());
  var panel = new Panel(List[Item].empty(), new Dl(String.empty(), List[u32].empty()));
  panel.items.push(new Item(String.from("xy"), 3));
  panel.push();
  panel.push();
  show2("panel", panel.dl.chars.view());
  0;
}
