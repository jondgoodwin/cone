// Appending a view of a String to that same String: 'appendBytes' copies the
// bytes in one block after its reserve (#1076), and a reserve that grows the
// block moves or frees what the view points into, so the copy would read freed
// memory. Each shape is refused at the receiver, as a List's 'appendSlice' of its
// own view is (collection_flow_args_borrow): the view as the argument, the send
// operator's '<-' with the view, and either one through a view held in a 'let'.

mod collection_flow_string_self_append;

import collections use *;

fn direct() {
  var s = String.from("hello");
  s.appendBytes(s.view());    //~ ErrorFrozen:3 "as the call's receiver"
}

fn sent() {
  var s = String.from("hello");
  s <- s.view();              //~ ErrorFrozen:3 "as the call's receiver"
}

fn heldBytes() {
  var s = String.from("hello");
  let v = s.view();
  s.appendBytes(v);           //~ ErrorFrozen:3 "as the call's receiver"
}

fn heldSent() {
  var s = String.from("hello");
  let v = s.view();
  s <- v;                     //~ ErrorFrozen:3 "as the call's receiver"
}

fn main() {
  direct();
  sent();
  heldBytes();
  heldSent();
}
