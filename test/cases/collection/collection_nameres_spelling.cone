// The retired slice type. A slice is the borrow of core's 'Array[T]', written
// '&Array[T]'; the old '&[]T' is refused, once, where the type is told from the
// value that '&[]x' borrows, and the message gives the new spelling. The
// permission goes before 'Array', as on any other borrow: '&[]mut T' is
// '&mut Array[T]'. One case for each permission a slice may be written with.
//
// Name resolution stage only. The borrow '&[]x', which makes a slice of a
// value, is not refused; collection_success holds it.

mod collection_nameres_spelling;

fn plain(s &[]u8) {          //~ ErrorSliceSpelling:12 "A slice is spelled '&Array[T]', not '&[]T'"
  return;
}

fn writable(s &[]mut u8) {   //~ ErrorSliceSpelling:15 "'&[]mut T' is now '&mut Array[T]'"
  return;
}

fn shared(s &[]imm u8) {     //~ ErrorSliceSpelling:13 "A slice is spelled"
  return;
}

fn unique(s &[]uni u8) {     //~ ErrorSliceSpelling:13 "A slice is spelled"
  return;
}

fn hidden(s &[]opaq u8) {    //~ ErrorSliceSpelling:13 "A slice is spelled"
  return;
}

fn readOnly(s &[]ro u8) {    //~ ErrorSliceSpelling:15 "A slice is spelled"
  return;
}
