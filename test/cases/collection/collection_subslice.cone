// A slice of part of an array or a slice, borrowed with a range index:
// '&s[a..b]' spans a through b, '&s[a..<b]' stops before b, a
// missing start is 0 and a missing end is the end ('&s[a..]', '&s[..b]',
// '&s[..<b]', '&s[..]') -- doc/reference/refarrayref.html, "Subslices".
//
// Each printed value was checked by hand against the source: the text "Abcd"
// sliced by each form, sums over the integers each range spans, a write
// through a mutable subslice seen in the array it was taken from, a slice
// taken of a slice (its offsets are relative to it), and an empty slice at the
// end. A subslice has the lifetime of what it was borrowed from, so a function
// may return one of its parameter. In a nested borrow, '&m[1][0..<2]' or
// '&m[0..<2][1]', the outer range or index reaches through the inner one, a
// reference to a row or a slice of rows; conec crashed on it until generation
// indexed through that reference rather than taking it for the borrow at the
// chain's root.
//
// What a range past the end does -- a panic, as an index past the end does --
// cannot be run: collection_bounds_subslice asserts the check in the IR.

mod collection_subslice;

import stdio use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" ");
  printInt(n);
  printStr("\n");
}

fn text(label &str, s &Array[u8]) {
  printStr(label);
  printStr(" [");
  printStr(s as &str);
  printStr("]\n");
}

fn sum(s &Array[i64]) i64 {
  mut t = 0i64;
  mut i = 0usize;
  while i < s.len {
    t = t + s[i];
    i = i + 1usize;
  }
  t;
}

// A subslice of a parameter lives as long as the parameter's borrow, so it
// may be returned
fn middle(s &Array[u8]) &Array[u8] {
  &s[1..<s.len - 1usize];
}

fn forms() {
  imm s &Array[u8] = &"Abcd";
  text("excludes-end", &s[1..<3]);
  text("includes-end", &s[1..3]);
  text("to-the-end", &s[2..]);
  text("from-the-start", &s[..<2]);
  text("through-from-the-start", &s[..2]);
  text("whole", &s[..]);
  text("returned-from-parameter", middle(s));
  imm e = &s[4..];
  show("empty-at-the-end", i64.from(e.len));
}

fn arrays() {
  mut arr = [1i64, 2i64, 3i64, 4i64, 5i64];
  // 2 + 3 + 4
  show("of-an-array", sum(&arr[1..<4]));
  imm m = &mut arr[0..<2];
  m[1] = 20i64;
  show("written-through", arr[1]);
  // Through a reference to the array: 4 + 5
  imm r = &arr;
  show("through-a-reference", sum(&r[3..]));
  // A slice of a slice: [20, 3, 4] then its [1..], 3 + 4
  imm part &Array[i64] = &arr[1..<4];
  show("slice-of-a-slice", sum(&part[1..]));
  // Run-time bounds
  mut lo = 1usize;
  mut hi = 3usize;
  show("run-time-bounds", sum(&arr[lo..hi]));
}

// An element of a row in a slice of rows, borrowed, plus the row's other two
fn rowElem(rows &Array[Array[i64, 3]]) i64 {
  imm e = &rows[1][2];
  *e + rows[1][0] + rows[1][1];
}

// A range in a nested borrow: the inner link is a reference to a row, or a
// slice of rows, which the outer index or range reaches through
fn nested() {
  mut m Array[Array[i64, 3], 2] = [[1i64, 2i64, 3i64], [4i64, 5i64, 6i64]];
  // Row 1's [0..2]: 4 + 5
  show("range-of-a-row", sum(&m[1][0..<2]));
  // Row 1's [1..] is [5, 6], and its [1] row 1's last
  imm w = &mut m[1][1..];
  w[1] = 60i64;
  show("written-through-a-row", m[1][2]);
  // Rows [0..2], then row 1: 4 + 5 + 60
  show("row-of-a-range", sum(&m[0..<2][1]));
  // Rows [1..], then its row 0, row 1 of m, and that row's [1..]: 5 + 60
  show("range-of-a-row-of-a-range", sum(&m[1..][0][1..]));
  // 60 + 4 + 5
  show("element-of-a-row-of-a-slice", rowElem(&[]m));
}

fn main() {
  forms();
  arrays();
  nested();
}
