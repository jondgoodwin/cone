// A '&mut' borrow of a 'var' global's collection, with no call between the borrow and its last use that
// could reshape the global: accepted (collection_flow_reshape_global_excl holds the refusals).
// 'bump' writes a number, which reshapes no collection.

mod collection_reshape_global_excl_success;

import stdio use *;
import collections use *;

struct It { pub v: i64; }

var gl: List[It];
var count: i64;

fn @initpure init() { gl = List[It](); count = 0i64; }

fn bump() { count = count + 1i64; }

fn main() i32 {
  gl.push(It(7i64));
  let c = &mut gl[0usize];
  bump();
  c.v = c.v + 35i64;
  printInt(gl[0usize].v);        // 7 + 35 = 42
  printStr("\n");
  printInt(count);               // one bump: 1
  printStr("\n");
  0
}
