// An index through a type's '[]' is a place behind the borrow '[]' lends: a
// non-copyable element is not moved out of it (Rust's "cannot move out of
// index"), by a 'let', an argument taken by value or a return. The message
// names the ways that work: borrow it, '&l[i]'; swap a value in; take it out
// with 'remove'. A slice's element is refused the same way.

mod collection_flow_index_move;

import collections use *;

fn take(s: String) usize { s.len() }

fn byLet(l: &List[String]) usize {
  let s = l[0usize];            //~ ErrorMoveElem:12 "Borrow it, '&x[i]'; swap a value in, '<->' or 'swap'; or take it out, 'remove'"
  s.len()
}

fn byArgument(l: &List[String]) usize {
  take(l[0usize])               //~ ErrorMoveElem:9 "indexed element"
}

fn byReturn(l: &List[String]) String {
  l[0usize]                     //~ ErrorMoveElem:4 "indexed element"
}

fn fromSlice(s: &Array[String]) usize {
  let e = s[0usize];            //~ ErrorMoveElem:12 "indexed element"
  e.len()
}

// A match on the place moves nothing of itself (collection_index_place_success
// matches one with 'case is'); an arm binding the String by value moves it out
enum Tag { Named(String), Plain }

fn byMatchBinding(l: &List[Tag]) usize {
  match l[0usize] {             //~ ErrorMoveElem:10 "May not move a value out of an indexed element, which the collection still holds. Borrow it, '&x[i]'; swap a value in, '<->' or 'swap'; or take it out, 'remove'."
    case let Named(s) { s.len() }
    else { 0usize }
  }
}
