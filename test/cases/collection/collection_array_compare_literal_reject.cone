// What an array literal compared with a wider array is still refused: a value
// that does not fit the element type, another length, and a value that is not a
// literal, or is one with a suffix, of another element type.

mod collection_array_compare_literal_reject;

fn fits(a: Array[u8, 2]) bool {
  a == [1, 300]               //~ ErrorLitRange:12
}

fn length(a: Array[i64, 3]) bool {
  a == [1, 2]                 //~ ErrorInvType:5 "same element type and length"
}

fn variable(a: Array[i64, 2], b: Array[i32, 2]) bool {
  a == b                      //~ ErrorInvType:5 "same element type and length"
}

fn element(a: Array[i64, 2], x: i32) bool {
  [x, 2] == a                 //~ ErrorInvType:10 "same element type and length"
}

fn suffix(a: Array[i64, 2]) bool {
  a != [1i32, 2]              //~ ErrorInvType:5 "same element type and length"
}

fn floats(a: Array[i64, 2]) bool {
  a == [1.0, 2.0]             //~ ErrorInvType:5 "same element type and length"
}
