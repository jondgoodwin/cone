// Bug 93 (row 345). A store through a call that is not the collection's index method but returns a
// place rooted at a parameter ('*r.at(0) = s', 'at' returning '&mut' to an element) frees the element
// it replaces, as 'r.items[0] = s' does. With the view into that element held it is refused.

mod collection_flow_store_through_place_call;

import collections use *;

fn mkS() String { var s = String(); s.append("0123456789012345678901234567890123456789"); s }

struct Rd { pub items: List[String]; pub n: i32;
  pub fn view(self: &mut) &str { self.items[0usize].view() }
  pub fn at(self: &mut, i: usize) &mut String { &mut self.items[i] } }

fn byString(r: &mut Rd) u8 {
  let y: &mut Rd = r;
  let v = y.view();
  *r.at(0usize) = String();                             //~ ErrorShapeStore
  v[0usize]
}

fn main() {
}
