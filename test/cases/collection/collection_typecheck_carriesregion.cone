// A type may declare 'CarriesRegion': its memory comes from a region it is
// handed when it is made, and it keeps. The compiler holds it to the one shape
// that makes the handing work (structCarriesRegionCheck): the type declares an
// init, and every init it declares ends with the parameter 'region *MemRegion',
// which a construction naming no region leaves out and is handed the heap's.
// Where the type keeps the region is its own business. Four types fail it: one
// with no init at all, one whose init lacks the parameter, one whose parameter
// has the wrong type, and one that puts it before another parameter; 'Good'
// meets it, with two inits.

mod collection_typecheck_carriesregion;

// No init: nothing to hand a region to
struct Bare is CarriesRegion {   //~ ErrorRegionMark:8 "declares CarriesRegion, so it declares an init"
  pub n: i64;
}

// An init that takes no region
struct Blind is CarriesRegion {
  pub n: i64;

  pub fn init(self: &new, n: i64) { *self = Blind(n); }   //~ ErrorRegionMark:7 "each of its inits ends with the parameter"
}

// A parameter named for the region, of another type
struct Wrong is CarriesRegion {
  pub n: i64;

  pub fn init(self: &new, region: *u8) { *self = Wrong(0i64); }   //~ ErrorRegionMark:7 "each of its inits ends with the parameter"
}

// The region first, with another parameter after it
struct Early is CarriesRegion {
  pub n: i64;

  pub fn init(self: &new, region: *MemRegion, n: i64) { *self = Early(n); }   //~ ErrorRegionMark:7 "each of its inits ends with the parameter"
}

// Two inits, each ending with the region
struct Good is CarriesRegion {
  pub n: i64;
  pub region: *MemRegion;

  pub fn initEmpty overload init(self: &new, region: *MemRegion) { *self = Good(0i64, region); }
  pub fn initOne overload init(self: &new, n: i64, region: *MemRegion) { *self = Good(n, region); }
}
