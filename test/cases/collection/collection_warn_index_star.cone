// The transitional '*x[i]': written when 'x[i]' was the borrow '[]' lends, it
// keeps that meaning (the element, read through the borrow), and under
// '--warn-index-star' is reported so the '*' can be dropped. Silent without
// the option. A slice's element and '*&x[i]' are no such spelling and are not
// reported. (No package is imported: the collections package still spells
// its own reads '*x[i]', which this option would report too.)

mod collection_warn_index_star;

struct Bag {
  pub var items: Array[i64, 2];
  pub fn `[]`(self: &, i: usize) &i64 { &items[i] }
}

struct Refs {
  pub var items: Array[&i64, 1];
  pub fn `[]`(self: &, i: usize) &&i64 { &items[i] }
}

fn main() {
  let b = Bag(items: [1, 2]);
  let a = *b[0usize];           //~ WarnIndexStar:11 "write `x[i]`, not `*x[i]`"
  let r = Refs(items: [&a]);
  let c = **r[0usize];          //~ WarnIndexStar:12 "write `x[i]`, not `*x[i]`"
  let s = &[1i64, 2i64];
  let d = s[0usize] + *&b[1usize] + b[0usize];
}
