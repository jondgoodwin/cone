  var d = oneDict();
  var r = &uni d;
  var m = &mut r;
  let n = &mut m;
  let key = 1i32;
  match (***n).get(&key) {
    case let Some(g) {
    **m = Dict[i32, i32]();    //~ ErrorShapeStore "This store could change the shape"
      return *g;
