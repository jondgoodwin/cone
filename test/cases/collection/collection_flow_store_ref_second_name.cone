  0i32
}

fn thenInPlaceDict() i32 {
  var d = oneDict();
  var r = &uni d;
  let key = 1i32;
  match (*r).get(&key) {
    case let Some(g) {
    *(*(&mut r)) = Dict[i32, i32]();    //~ ErrorFrozen "It may not be changed"
      return *g;
    }
    else {}
  }
  0i32
}

