  var d = oneDict();
  var r = &uni d;
  var m = &mut r;
  let key = 1i32;
  match (**m).get(&key) {
    case let Some(g) {
      let n = &mut m;
    ***n = Dict[i32, i32]();    //~ ErrorShapeStore "This store could change the shape"
      return *g;
    }
    else {}
  }
  0i32
}

// ---- Shape: the view taken first, the reference variable lent after ----

fn thenStoreShape() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  match &*r {
    case let &Circle(c) {
      let m = &mut r;
    **m = Square(99);
    return c.r;                  //~ ErrorVariantReshape "is used here after the"
    }
    else {}
  }
  0i32
}

fn thenCallShape() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  match &*r {
    case let &Circle(c) {
      let m = &mut r;
    setShape(m);
    return c.r;                  //~ ErrorVariantReshape "is used here after the"
    }
    else {}
  }
  0i32
}

fn thenLentCallShape() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  match &*r {
    case let &Circle(c) {
    setShape(&mut r);
    return c.r;                  //~ ErrorVariantReshape "is used here after the"
    }
    else {}
  }
  0i32
}

fn thenMethodShape() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  match &*r {
    case let &Circle(c) {
      let m = &mut r;
    reshape(&mut **m);
    return c.r;                  //~ ErrorVariantReshape "is used here after the"
    }
    else {}
  }
  0i32
}

fn thenReturnedShape() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  match &*r {
    case let &Circle(c) {
    **idShape(&mut r) = Square(99);
    return c.r;                  //~ ErrorVariantReshape "is used here after the"
    }
    else {}
  }
  0i32
}

fn thenInPlaceShape() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  match &*r {
    case let &Circle(c) {
    *(*(&mut r)) = Square(99);    //~ ErrorFrozen "It may not be changed"
    return c.r;
    }
    else {}
  }
  0i32
}

fn thenUniShape() i32 {
  var s: Shape = Circle(5);
