  var d = oneDict();
  var r = &uni d;
  let key = 1i32;
  match (*r).get(&key) {
    case let Some(g) {
    **idDict(&mut r) = Dict[i32, i32]();    //~ ErrorShapeStore "This store could change the shape"
      return *g;
