// A view into what a reference borrows is frozen against the name it was taken by. A
// writable borrow of the variable holding the reference ('&mut r') is a second name for the
// same storage, so a store or a call through either is judged against a view taken by the
// other: whichever of the view and the borrow comes second
// (collection_store_ref_second_name_success holds what is accepted beside each refusal).
// Every form is made of a 'List', of a 'Dict' and of an enum's variant. A variant
// narrowed from '&**m' with 'm' made first was refused already (throughStoreShape,
// throughCallShape, throughDeepShape), the 'mut' reference being a path others share.
// A borrow made and dereferenced in one place is no second name: '*&mut r' is 'r', so
// '*(*(&mut r))' is refused as '*r' is, the view's place being frozen (thenInPlace*).

mod collection_flow_store_ref_second_name;

import collections use *;

enum Shape {
  struct Circle { pub r: i32; }
  struct Square { pub s: i32; }
}
use Shape;

fn oneList() List[i32] {
  var l = List[i32]();
  l.push(7i32);
  l
}

fn oneDict() Dict[i32, i32] {
  var d = Dict[i32, i32]();
  d.insert(1i32, 7i32);
  d
}

fn setList(m: &mut &uni List[i32]) {
  **m = List[i32]();
}
fn setDict(m: &mut &uni Dict[i32, i32]) {
  **m = Dict[i32, i32]();
}
fn setShape(m: &mut &uni Shape) {
  **m = Square(99);
}
fn reshape(s: &mut Shape) {
  *s = Square(99);
}

fn idList(m: &mut &uni List[i32]) &mut &uni List[i32] {
  return m;
}
fn idDict(m: &mut &uni Dict[i32, i32]) &mut &uni Dict[i32, i32] {
  return m;
}
fn idShape(m: &mut &uni Shape) &mut &uni Shape {
  return m;
}

// ---- List: the view taken first, the reference variable lent after ----

fn thenStoreList() i32 {
  var l = oneList();
  var r = &uni l;
  let v = &(*r)[0usize];
  let m = &mut r;
  **m = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}

fn thenCallList() i32 {
  var l = oneList();
  var r = &uni l;
  let v = &(*r)[0usize];
  let m = &mut r;
  setList(m);    //~ ErrorShapeReshape
  *v
}

fn thenLentCallList() i32 {
  var l = oneList();
  var r = &uni l;
  let v = &(*r)[0usize];
  setList(&mut r);    //~ ErrorShapeReshape
  *v
}

fn thenMethodList() i32 {
  var l = oneList();
  var r = &uni l;
  let v = &(*r)[0usize];
  let m = &mut r;
  (**m).clear();    //~ ErrorShapeReshape
  *v
}

fn thenReturnedList() i32 {
  var l = oneList();
  var r = &uni l;
  let v = &(*r)[0usize];
  **idList(&mut r) = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}

fn thenInPlaceList() i32 {
  var l = oneList();
  var r = &uni l;
  let v = &(*r)[0usize];
  *(*(&mut r)) = List[i32]();    //~ ErrorFrozen "It may not be changed"
  *v
}

fn thenUniList() i32 {
  var l = oneList();
  var r = &uni l;
  let v = &(*r)[0usize];
  let m = &uni r;
  **m = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}

// ---- List: the view taken through the second name, the change by the first ----

fn throughStoreList() i32 {
  var l = oneList();
  var r = &uni l;
  let m = &mut r;
  let v = &(**m)[0usize];
  *r = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}

fn throughCallList() i32 {
  var l = oneList();
  var r = &uni l;
  let m = &mut r;
  let v = &(**m)[0usize];
  (*r).clear();    //~ ErrorShapeReshape
  *v
}

fn throughDeepList() i32 {
  var l = oneList();
  var r = &uni l;
  var m = &mut r;
  let n = &mut m;
  let v = &(***n)[0usize];
  **m = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}

fn deepAfterList() i32 {
  var l = oneList();
  var r = &uni l;
  var m = &mut r;
  let v = &(**m)[0usize];
  let n = &mut m;
  ***n = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}

// ---- Dict: the view taken first, the reference variable lent after ----

fn thenStoreDict() i32 {
  var d = oneDict();
  var r = &uni d;
  let key = 1i32;
  match (*r).get(&key) {
    case let Some(g) {
      let m = &mut r;
    **m = Dict[i32, i32]();    //~ ErrorShapeStore "This store could change the shape"
      return *g;
    }
    else {}
  }
  0i32
}

fn thenCallDict() i32 {
  var d = oneDict();
  var r = &uni d;
  let key = 1i32;
  match (*r).get(&key) {
    case let Some(g) {
      let m = &mut r;
    setDict(m);    //~ ErrorShapeReshape
      return *g;
    }
    else {}
  }
  0i32
}

fn thenLentCallDict() i32 {
  var d = oneDict();
  var r = &uni d;
  let key = 1i32;
  match (*r).get(&key) {
    case let Some(g) {
    setDict(&mut r);    //~ ErrorShapeReshape
      return *g;
    }
    else {}
  }
  0i32
}

