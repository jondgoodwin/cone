// ---- Other ways to the same second name ----

// Narrowed by the 'uni' reference itself, no '&'
fn narrowedByUni() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  match r {
    case let &Circle(c) {
      let m = &mut r;
      **m = Square(99);
      return c.r;                  //~ ErrorVariantReshape "is used here after the"
    }
    else {}
  }
  0i32
}

// ... and by one read through the 'mut' borrow of it
fn narrowedThrough() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  var m = &mut r;
  match *m {
    case let &Circle(c) {
      *r = Square(99);
      return c.r;                  //~ ErrorVariantReshape "is used here after the"
    }
    else {}
  }
  0i32
}

// ... and of a borrow held in a name before the 'match'
fn narrowedBound() i32 {
  var s: Shape = Circle(5);
  var r = &uni s;
  let x: &Shape = &*r;
  match x {
    case let &Circle(c) {
      let m = &mut r;
      **m = Square(99);
      return c.r;                  //~ ErrorVariantReshape "is used here after the"
    }
    else {}
  }
  0i32
}

// The reference variable is a 'mut' one that nothing else writes by yet
fn mutRefStore() i32 {
  var l = oneList();
  var r = &mut l;
  let v = &(*r)[0usize];
  let m = &mut r;
  **m = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}
fn mutRefCall() i32 {
  var l = oneList();
  var r = &mut l;
  let v = &(*r)[0usize];
  let m = &mut r;
  (**m).push(8i32);    //~ ErrorShapeReshape
  *v
}

// A view that writes
fn writingView() i32 {
  var l = oneList();
  var r = &uni l;
  let v = &mut (*r)[0usize];
  let m = &mut r;
  **m = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}

// The 'uni' reference is a struct's field, or the 'mut' borrow of it is held in one
struct Holder {
  pub r: &uni List[i32];
}
struct Keeper {
  pub m: &mut &uni List[i32];
}
fn fieldThenLent() i32 {
  var l = oneList();
  var w = Holder(&uni l);
  let v = &(*w.r)[0usize];
  let m = &mut w.r;
  **m = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}
fn wholeThenLent() i32 {
  var l = oneList();
  var w = Holder(&uni l);
  let v = &(*w.r)[0usize];
  let m = &uni w;
  *(*m).r = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}
fn fieldKeeps() i32 {
  var l = oneList();
  var r = &uni l;
  var w = Keeper(&mut r);
  let v = &(**w.m)[0usize];
  *r = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}

// The view is into what an owner owns, the owner reached through the reference
fn ownerThenLent() i32 {
  var o = Uni[List[i32]](oneList());
  var r = &uni o;
  let v = &(**r)[0usize];
  let m = &mut r;
  **m = Uni[List[i32]](oneList());    //~ ErrorShapeStore "This store could change the shape"
  *v
}
fn ownerThrough() i32 {
  var o = Uni[List[i32]](oneList());
  var r = &uni o;
  let m = &mut r;
  let v = &(***m)[0usize];
  *r = Uni[List[i32]](oneList());    //~ ErrorShapeStore "This store could change the shape of a 'List'"
  *v
}
// ... and the owner's list itself changed by the other name. The way to it is written
// by 'm', so the list is what the view is asked of, not its owner alone
fn ownerThroughPush() i32 {
  var o = Uni[List[i32]](oneList());
  var r = &uni o;
  let m = &mut r;
  let v = &(***m)[0usize];
  (**r).push(1i32);    //~ ErrorShapeReshape "This call could change the shape of a 'List'"
  *v
}
fn ownerThroughClear() i32 {
  var o = Uni[List[i32]](oneList());
  var r = &uni o;
  let m = &mut r;
  let v = &(***m)[0usize];
  (**r).clear();    //~ ErrorShapeReshape "This call could change the shape of a 'List'"
  *v
}

// The reference variable is a parameter
fn parameterLent(var r: &uni List[i32]) i32 {
  let v = &(*r)[0usize];
  let m = &mut r;
  **m = List[i32]();    //~ ErrorShapeStore "This store could change the shape"
  *v
}
