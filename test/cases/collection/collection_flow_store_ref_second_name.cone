  var d = oneDict();
  var r = &uni d;
  let m = &mut r;
  let key = 1i32;
  match (**m).get(&key) {
    case let Some(g) {
    *r = Dict[i32, i32]();    //~ ErrorShapeStore "This store could change the shape"
      return *g;
