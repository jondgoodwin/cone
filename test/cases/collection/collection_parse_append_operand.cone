// A '<-' whose entry is missing, or is not a term, is one ErrorBadTerm at the token
// that is not a term, and the compile goes on to its end: the parser's refused term
// is NULL, and the entry list, the entry forms 'of' and ':' and a nest count all
// read it. A '-' before a refused operand is the same.
//
// Each shape is its own function so a refusal's recovery cannot reach the next.

mod collection_parse_append_operand;

fn nothing() {
  var x = 1;
  x <- ;                        //~ ErrorBadTerm:8
}

fn greater() {
  var x = 1;
  x <- >;                       //~ ErrorBadTerm:8
}

fn greaterThenName() {
  var x = 1;
  let y = 2;
  x <- > y;                     //~ ErrorBadTerm:8
                                //~^ ErrorNoSemi:9 follow-on
}

fn closeParen() {
  var x = 1;
  x <- );                       //~ ErrorBadTerm:8
}

fn keyword() {
  var x = 1;
  x <- else;                    //~ ErrorBadTerm:8
}

fn equals() {
  var x = 1;
  x <- =;                       //~ ErrorBadTerm:8
}

fn comma() {
  var x = 1;
  x <- ,;                       //~ ErrorBadTerm:8
}

fn secondEntry() {
  var x = 1;
  x <- 1, else;                 //~ ErrorBadTerm:11
}

fn countOf() {
  var x = 1;
  x <- else of 3;               //~ ErrorBadTerm:8
}

fn pair() {
  var x = 1;
  x <- else: 3;                 //~ ErrorBadTerm:8
}

fn member() {
  var x = 1;
  x.y <- ;                      //~ ErrorBadTerm:10
}

fn indexed() {
  var x = 1;
  x[0] <- ;                     //~ ErrorBadTerm:11
}

fn minus() {
  let a = -;                    //~ ErrorBadTerm:12
}

fn minusGreater() {
  let a = - >;                  //~ ErrorBadTerm:13
}

fn casePattern(n: i32) i32 {
  match n {
    case ; { }                  //~ ErrorBadTerm:10
                                //~^ ErrorNoLCurly:10 follow-on
    else { }
  }
  0
}

fn caseRangeEnd(n: i32) i32 {
  match n {
    case ..> { }                //~ ErrorBadTerm:10
    else { }                    //~ ErrorNoLCurly:5 follow-on
  }
  0
}

fn main() i32 { 0i32 }
