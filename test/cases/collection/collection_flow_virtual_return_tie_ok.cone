// Bug 92 (lane 461): what collection_flow_virtual_return_tie leaves accepted. A trait that
// lends from its receiver, with '+ ShapeKeeping', and a type whose state is only numbers (no
// storage that moves or frees): its borrow survives the next call through the reference, and
// reads the new value.

mod collection_flow_virtual_return_tie_ok;

import stdio use *;

trait Gadget {
  pub fn count(self: &mut) &mut i64;
  pub fn bump(self: &mut);
}

struct Real is Gadget {
  pub n: i64;
  pub fn count(self: &mut) &mut i64 { &mut n }
  pub fn bump(self: &mut) { n = n + 1i64; }
}

fn run(x: &<mut Gadget + ShapeKeeping) i64 {
  let c = x.count();
  x.bump();
  *c
}

fn main() {
  var r = Real(1i64);
  print <- run(&mut r), "\n";
}
