// A type may declare 'ShapeChanging', but the declaration only asserts what the
// compiler finds from the type's methods (shapeinfer.h): that one writes storage
// the type owns, and one returns a borrow. A type declaring it where the compiler
// finds nothing is refused, so the declaration and the methods cannot drift
// apart. Each type here lacks one thing: it writes no storage, it lends no
// borrow, or what it writes is a position. 'Good' declares it and has both.

mod collection_typecheck_shapemark;

import collections use *;

struct Pt { pub x i64; pub y i64; }

// Lends a borrow, and nothing writes its storage
struct Reader is ShapeChanging {   //~ ErrorShapeMark:8 "declares ShapeChanging"
  items List[Pt];

  fn first(self &) &Pt { items[0usize]; }
}

// Writes its storage, and lends nothing
struct Sink is ShapeChanging {     //~ ErrorShapeMark:8 "declares ShapeChanging"
  items List[Pt];

  fn add(self &mut, p Pt) { items.push(p); }
}

// Lends a borrow, and writes only a position
struct Walker is ShapeChanging {   //~ ErrorShapeMark:8 "declares ShapeChanging"
  items List[Pt];
  at usize;

  fn first(self &) &Pt { items[at]; }
  fn advance(self &mut) { at = at + 1usize; }
}

// Both
struct Good is ShapeChanging {
  items List[Pt];

  fn first(self &) &Pt { items[0usize]; }
  fn add(self &mut, p Pt) { items.push(p); }
}
