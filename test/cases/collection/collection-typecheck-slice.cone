// What a slice is not: it is neither a simple reference you can dereference nor
// a type with members of its own beyond the two counts it carries.
//
// Type-check stage only, so every diagnostic below is reached. The permission
// and value-type rules are in collection-typecheck-perm; they are a separate
// question -- this file asks what operations a slice supports at all, that one
// asks what a well-formed slice is then allowed to do.

// A slice is a fat value, a data pointer and a length together, not an address.
// There is nothing behind it to dereference, so the whole array must be reached
// by indexing rather than by '*'.
fn derefSlice() {
  mut b [3; i32] = [1, 2, 3]
  imm s = &[]mut b
  imm whole = *s        //~ ErrorNotPtr:15 "May only de-reference a simple reference or pointer"
}

// 'len' and 'maxlen' are the only names a slice answers to
fn unknownMember() {
  mut b [3; i32] = [1, 2, 3]
  imm s = &[]mut b
  imm n = s.first       //~ ErrorNoMeth:12 "Invalid operation on an array ref"
}

// A slice is not callable. Only '[' selects an element; '(' has no meaning.
fn callSlice() {
  mut b [3; i32] = [1, 2, 3]
  imm s = &[]mut b
  imm n = s()           //~ ErrorNoMeth:12 "Invalid operation on an array ref"
}

// The length is a value the slice reports, not storage it owns, so it cannot be
// the target of an assignment
fn assignLen() {
  mut b [3; i32] = [1, 2, 3]
  imm s = &[]mut b
  s.len = 5             //~ ErrorBadLval:4 "Expression must be lval"
}
