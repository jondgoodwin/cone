// In a debug build the stable sort panics when a comparison that is not a consistent
// order leaves the values not in order by it (a release build returns some permutation:
// collection_sort_stable_bad_order). A comparison that always answers "before" cannot be
// satisfied by any arrangement of two or more values.

mod collection_sort_stable_bad_order_debug;

import stdio use *;
import collections use *;

fn alwaysBefore(a: &i32, b: &i32) i32 { -1i32 }

fn main() {
  var l = List[i32]();
  var i = 0i32;
  while i < 50i32 { l.push((i * 7i32) % 50i32); i = i + 1i32; }
  printStr("sorting\n");
  l.sortBy(&alwaysBefore);
  printStr("not reached in a debug build\n");
}
