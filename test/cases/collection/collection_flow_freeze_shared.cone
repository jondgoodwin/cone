// A borrow a method returns out of a container that may move its elements
// when it changes (it declares 'ShapeChanging': List, Deque, String, Dict,
// Pool) may not be followed by a change of the container's shape while the
// borrow is still to be used, though the path it was reached through is shared
// (collection_flow_freeze): through a '&mut' parameter, a counted owner, or a
// field of 'self'. The borrow, read-only or writable, is an alias loan, as
// every borrow through a shared path is: the path stays readable, lendable and
// writable (collection_freeze_shared_success runs what it lets through), and a
// change of its shape through the same name or another is refused by the shape
// check, ErrorShapeReshape; so is a pool's value removed. (A read-only borrow of
// a local, which no other name reaches, freezes it: collection_flow_freeze.)
//
// This is part (a) of the rule, the same name. A change through another
// name for the container -- two '&mut' parameters the caller made one list, or
// a copy of a '&mut' -- is part (b), refused by collection_flow_reshape.

mod collection_flow_freeze_shared;

import collections use *;
import pool use *;

struct Pt { pub x i64; pub y i64; }

// An element borrowed through a '&mut' parameter, then the list pushed onto
fn elementThenPush(l &mut List[Pt], p Pt) i64 {
  let e = l[0usize];
  l.push(p);                    //~ ErrorShapeReshape
  e.x;
}

// A mutable element borrow, then the list pushed onto: the element may move
fn mutElementThenPush(l &mut List[Pt], p Pt) {
  let e = &mut l[0usize];
  l.push(p);                    //~ ErrorShapeReshape:4 "could change the shape of a 'List'"
  e.x = 5;
}

// The slice 'viewMut' lends, then the list pushed onto: the slice's block moves
fn viewMutThenPush(l &mut List[i64]) {
  let s = l.viewMut();
  l.push(2);                    //~ ErrorShapeReshape:4 "could change the shape of a 'List'"
  s[0usize] = 1;
}

// A cursor over a deque, then the deque pushed onto: the iterator's block moves
fn cursorThenPush(dq &mut Deque[i64]) {
  var it = dq.items();
  dq.push(9);                   //~ ErrorShapeReshape
  it.next();
}

// A String's view, then the String grown
fn viewThenAppend(s &mut String) usize {
  let v = s.view();
  s.appendByte('c');            //~ ErrorShapeReshape
  v.len;
}

// A pool's value borrowed, then removed
fn borrowThenRemove(p &mut Pool[Pt], id Ref[Pt]) i64 {
  let e = p[id];
  p.remove(id);                 //~ ErrorShapeReshape
  e.x;
}

// Through a shared owner, by the same name
fn ownerThenPush(p Pt) i64 {
  let l = new Rc[mut, List[Pt]](List[Pt].empty());
  let e = l[0usize];
  l.push(p);                    //~ ErrorShapeReshape
  e.x;
}

// Through a field of 'self'
struct Bag {
  pub items List[Pt];
  pub text String;

  fn growWhileHeld(self &mut, p Pt) i64 {
    let e = items[0usize];
    items.push(p);              //~ ErrorShapeReshape
    e.x;
  }

  fn viewWhileGrowing(self &mut) usize {
    let v = text.view();
    text.appendByte('c');       //~ ErrorShapeReshape
    v.len;
  }

  // The borrow a method on 'self' returns, its own field changed meanwhile
  fn firstThenPush(self &mut, p Pt) i64 {
    let e = self.items[0usize];
    self.items.push(p);         //~ ErrorShapeReshape
    e.x;
  }
}

// Through counted owners of a struct holding a list behind an owner of its own: the
// list pushed onto through another owner of the struct, or by a call handed one
struct Item { pub n i64; }
struct Ship { pub fuel i64; pub vec Uni[List[Item]]; }

fn grows(s &mut Ship) { s.vec.push(new Item(9)); }

fn pushOther(r Rc[mut, Ship], q Rc[mut, Ship]) i64 {
  let e = r.vec[0usize];
  q.vec.push(new Item(1));      //~ ErrorShapeReshape
  e.n;
}

fn callGrows(r Rc[mut, Ship], q Rc[mut, Ship]) i64 {
  let e = r.vec[0usize];
  grows(&mut *q);               //~ ErrorShapeReshape
  e.n;
}
