// A range index at the parse stage. '...' is no range operator ('a..b' runs
// through b and 'a..<b' stops before it), whether or not it names an end, and is
// refused where it stands; and 'a..<' stops before an end it does not name, so it
// must say where it ends ('a..' runs to the end).

mod collection_parse_range;

fn tail(s &Array[i32]) {
  imm r = &s[1...];   //~ ErrorRangeEllipsis:15 "'...' is not a range operator"
}

fn through(s &Array[i32]) {
  imm r = &s[1...3];   //~ ErrorRangeEllipsis:15 "'a .. b' runs through b"
}

fn before(s &Array[i32]) {
  imm r = &s[1..<];    //~ ErrorBadIndex:18 "must say where it ends"
}
