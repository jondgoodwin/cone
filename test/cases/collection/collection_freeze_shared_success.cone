// What freezing a container's shared path still allows (the refusals are
// collection_flow_freeze_shared). A borrow a method returned out of a list, a
// deque or a String reached through a '&mut' parameter or a field of 'self'
// freezes that path only until the borrow's last use, and only against what
// it forbids: a read-only borrow lets the path be read and borrowed read-only
// again, and a push or an append after its last use is fine. A mutable borrow a
// method returned (a mutable element, the slice 'viewMut' lends) is an alias loan
// (11 Oct 2026): the path stays readable, lendable and writable while it is
// used, and only a change of shape is refused. A change through another name,
// two references to one list, is refused too (collection_flow_reshape).

mod collection_freeze_shared_success;

import stdio use *;
import collections use *;

struct Pt { pub x: i64; pub y: i64; }

// A counted owner of a struct holding a list behind an owner of its own
struct Item { pub n: i64; }
struct Ship { pub fuel: i64; pub vec: Uni[List[Item]]; }

fn noShape(s: &mut Ship) { s.fuel = s.fuel + 1; }

// An element borrowed through the owner, then another field written and the whole
// lent '&mut' to a call that only writes a field: a read-only element borrow through
// a shared path is an alias loan, so the path stays lendable and writable, and only a
// change of the list's shape is refused (collection_flow_reshape_owners)
fn elemViaRc(r: Rc[mut, Ship]) i64 {
  let e = r.vec[0usize];
  r.fuel = 3;
  noShape(&mut *r);
  e.n
}

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// The element's last use is before the push
fn endsBeforePush(l: &mut List[Pt]) i64 {
  let e = l[0usize];
  let x = e.x;
  l.push(Pt(x + 10, 0));
  l[1usize].x
}

// The path read, and borrowed read-only again, while the element is used
fn readsUnderElement(l: &mut List[Pt]) i64 {
  let e = l[0usize];
  let n = i64.from(l.len());
  let f = l[1usize];
  let v = l.view();
  n * 1000 + i64.from(v.len) * 100 + e.x * 10 + f.x
}

// A mutable element borrow, then the list read: its length, another element,
// and a second mutable borrow of it, which writes the same element
fn mutElementThenRead(l: &mut List[Pt]) i64 {
  let e = &mut l[0usize];
  let n = l.len();
  let o = l[1usize].y;
  let f = &mut l[0usize];
  e.x = 5;
  f.y = f.y + 100;
  i64.from(n) * 1000 + o * 100 + e.x + f.y
}

// The slice 'viewMut' lends, then the list lent again and viewed: the slices
// are one memory
fn viewMutTwice(l: &mut List[i64]) i64 {
  let s = l.viewMut();
  let t = l.viewMut();
  let v = l.view();
  s[0usize] = 1;
  t[0usize] = t[0usize] + 10;
  s[0usize] * 100 + v[0usize]
}

// A cursor used up before the deque is pushed onto
fn cursorThenPush(dq: &mut Deque[i64]) i64 {
  var it = dq.items();
  var sum = 0i64;
  var more = true;
  while more {
    match it.next() {
      case Some(n) { sum = sum + *n; }
      else { more = false; }
    }
  }
  dq.push(sum);
  *dq[dq.len() - 1usize]
}

// A String viewed, the view used up, then the String grown
fn viewThenAppend(s: &mut String) usize {
  let n = s.view().len;
  s.appendByte('c');
  n * 10usize + s.len()
}

// Through a field of 'self'
struct Bag {
  pub items: List[Pt];
  pub text: String;

  fn growAfterHeld(self: &mut, p: Pt) i64 {
    let e = items[0usize];
    let seen = e.x + i64.from(items.len());
    items.push(p);
    seen * 10 + items[2usize].x
  }

  fn readsWhileViewed(self: &mut) usize {
    let v = text.view();
    let n = text.len() + v.len;
    text.appendByte('d');
    n * 10usize + text.len()
  }
}

fn main() {
  var list = List[Pt].empty();
  list.push(Pt(1, 2));
  show("ends-before-push", endsBeforePush(&mut list));

  var two = List[Pt].empty();
  two.push(Pt(3, 0));
  two.push(Pt(4, 0));
  show("reads-under-element", readsUnderElement(&mut two));

  var pair = List[Pt].empty();
  pair.push(Pt(1, 2));
  pair.push(Pt(3, 4));
  show("mut-element-then-read", mutElementThenRead(&mut pair));

  var ints = List[i64].empty();
  ints.push(0);
  show("view-mut-twice", viewMutTwice(&mut ints));

  var items = List[Item].empty();
  items.push(Item(8));
  let ship = Rc[mut, Ship](1, Uni[List[Item]](items));
  show("elem-via-rc", elemViaRc(ship) * 100 + ship.fuel);

  var dq = Deque[i64].empty();
  dq.push(2);
  dq.push(3);
  show("cursor-then-push", cursorThenPush(&mut dq));

  var text = String.from("ab");
  show("view-then-append", i64.from(viewThenAppend(&mut text)));

  var bag = Bag(List[Pt].empty(), String.from("xy"));
  bag.items.push(Pt(5, 0));
  bag.items.push(Pt(6, 0));
  show("self-field-grown", bag.growAfterHeld(Pt(7, 0)));
  show("self-field-viewed", i64.from(bag.readsWhileViewed()));
}
