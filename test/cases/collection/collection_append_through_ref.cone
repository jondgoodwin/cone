// '<-' on a variable that holds a reference takes its borrow from the reference,
// never from the variable: a 'let' variable holding an 'Rc[mut, ...]' or an
// 'Arc[mut, ...]' is appended to, one entry or several, because the variable is
// not changed -- the 'self: &mut' borrow is made against the owner, which is
// 'mut'; so is a '&mut' parameter. '=' through such a variable is the same:
// a field, the whole value and an element are stored through the owner. The
// refusals are collection_typecheck_append_through_ref's.
// Every value below is worked out by hand from the statements.

mod collection_append_through_ref;

import stdio use *;
import collections use *;
import sync use Arc;

struct Pt { pub x: i64; pub y: i64; }

fn show(label: &str, xs: &List[i32]) {
  printStr(label);
  printInt(i64.from(xs.len()));
  printStr(":");
  each x in xs { printStr(" "); printInt(i64.from(*x)); }
  printStr("\n");
}

// A parameter lent mutably appends as it always did
fn viaMutRef(l: &mut List[i32]) {
  l <- 6;
  l <- 7, 8;
}

fn main() {
  // A 'let' variable holding an 'Rc[mut, List]'
  let r = Rc[mut, List[i32]](List[i32].empty());
  r <- 1;
  r <- 2, 3;
  show("rc ", &*r);               // 3: 1 2 3

  // ... holding an 'Arc[mut, List]'
  let a = Arc[mut, List[i32]](List[i32].empty());
  a <- 4;
  a <- 5, 6, 7;
  show("arc ", &*a);               // 4: 4 5 6 7

  // ... and a copy of the owner is the same list
  let b = a;
  b <- 8;
  show("arc copy ", &*a);           // 5: 4 5 6 7 8

  // A '&mut' parameter
  var m = List[i32].empty();
  viaMutRef(&mut m);
  show("param ", &m);              // 3: 6 7 8

  // '=' through a 'let' variable holding an owner whose permission is 'mut'
  let p = Rc[mut, Pt](Pt(1, 2));
  p.x = 10;                        // the field
  *p = Pt(p.x + 1, 30);        // the whole value
  let q = Arc[mut, Pt](Pt(3, 4));
  q.y = 40;
  printInt(p.x); printStr(" "); printInt(p.y); printStr(" ");
  printInt(q.x); printStr(" "); printInt(q.y); printStr("\n");   // 11 30 3 40
  r[0] = 9;                        // an element
  a[1] = 50;
  show("rc elem ", &*r);            // 3: 9 2 3
  show("arc elem ", &*a);           // 5: 4 50 6 7 8
}
