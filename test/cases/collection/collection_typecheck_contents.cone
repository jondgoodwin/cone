// What a list after '<-' refuses at type check. A constant count of 'n of x'
// is checked as an array's size is, 0 through 4294967295, and a count is a
// usize. A pair needs a '<-' taking a key and a value; 'fill' needs the
// collection to say how full it is, through 'len()' and 'capacity()'; and an
// entry form is written only in the list, not inside a tuple used as a value.
//
// An array's contents refuse more, since its size is fixed: array_typecheck_counts.

mod collection_typecheck_contents;

import stdio use *;
import collections use *;

fn counts(n i32) {
  mut xs = new List[i32];
  xs <- -1 of 0;                //~ ErrorRepeatCount:10 "may not be negative"
  xs <- 4294967296 of 0;        //~ ErrorRepeatCount:9 "may be at most 4294967295"
  xs <- n of 0;                 //~ ErrorInvType:9 "The count before 'of' is a usize"
}

fn forms() {
  mut xs = new List[i32];
  xs <- 1: 2;                   //~ ErrorPairAppend:9 "List declares none"
  print <- fill "x";            //~ ErrorFillSize:12 "IOStream has no 'len' method"
  xs <- (2 of 0, 1).1;          //~ ErrorEntryPlace:10 "is written only there"
}
