// A slice may not be stored where it would outlive the array it points at.
//
// ref-flow establishes the same rule for a plain borrowed reference, reporting
// ErrorInvType "lval outlives the borrowed reference you are storing".
// assignlvalrtype in ir/exp/assign.c used to reach that check only when both
// the lval's type and the rval's type were RefTag, so an ArrayRefTag on either
// side skipped it and the assignment below was accepted. A slice borrows
// exactly as a reference does and carries the same scope, so both tags now
// reach it.
//
// The escape this prevents is real: after the block ends, 'escaping' would name
// storage that no longer exists, and a write through it would corrupt the
// frame. The sibling case -- a function returning a slice borrowed from one of
// its own locals -- is asserted by ref-flow-return, which owns the escape rule
// for return values.

fn escapingSlice() {
  mut b [3; i32] = [1, 2, 3]
  mut escaping = &[]mut b
  {
    mut inner [2; i32] = [7, 8]
    escaping = &[]mut inner   //~ ErrorInvType "lval outlives the borrowed reference you are storing"
  }
}
