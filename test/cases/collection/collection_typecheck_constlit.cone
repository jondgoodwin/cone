// What a borrowed array literal may not be. A literal whose elements are all
// constants borrows as a constant (collection_const_literal), and a constant
// is read-only; a literal with a computed element has no place in memory at
// all, so it is a temporary, which a borrow refuses as it refuses '&(a + 1)'
// -- but for one a variable's initializer borrows, which lasts to the end of
// the block (lifetime_mix_temp_borrow_extended), so these borrow in a
// statement of its own.

mod collection_typecheck_constlit;

// A constant cannot be written, so neither a mutable reference nor a mutable
// slice is borrowed from one, as '&mut "text"' is not
fn mutFromConstant() {
  imm r = &mut [1, 2, 3];     //~ ErrorBadPerm:11 "Borrowed reference cannot obtain this permission"
  imm s = &[]mut [1, 2, 3];   //~ ErrorBadPerm:11 "Borrowed reference cannot obtain this permission"
}

// An element read from a variable is computed, so the literal is a temporary
fn computedElement() {
  mut x = 1;
  mut y = 2;
  &[x, y];                    //~ ErrorBadLval:4 "May not borrow a temporary value"
  &[][x, 2];                  //~ ErrorBadLval:6 "May not borrow a temporary value"
}
