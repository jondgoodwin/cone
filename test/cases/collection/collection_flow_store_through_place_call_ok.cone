// Bug 93 (row 345), accepted: a store through a place-returning method ('*r.at(0) = 5') of a
// scalar element while a view into another field's String is held frees nothing the view points into.
// Prints the view's first byte ('0', 48), then the stored scalar (5).

mod collection_flow_store_through_place_call_ok;

import stdio use *;
import collections use *;

fn mkS() String { var s = String(); s.append("0123456789012345678901234567890123456789"); s }

struct Rd { pub items: List[String]; pub counts: List[i32]; pub n: i32;
  pub fn view(self: &mut) &str { self.items[0usize].view() }
  pub fn at(self: &mut, i: usize) &mut i32 { &mut self.counts[i] } }

fn scalar(r: &mut Rd) u8 {
  let y: &mut Rd = r;
  let v = y.view();
  *r.at(0usize) = 5;
  v[0usize]
}

fn main() {
  var l = List[String]();
  l.push(mkS());
  var c = List[i32]();
  c.push(1);
  var r = Rd(l, c, 1);
  print <- scalar(&mut r), " ", r.counts[0usize], "\n";
}
