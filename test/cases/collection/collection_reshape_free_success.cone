// What the check on a borrow a free function hands out accepts (the refusals are
// collection_flow_reshape_free). The same neighbours as for a method's borrow:
// - a free function that only reads the other reference, called while the
//   borrow is held;
// - the borrow used up before the list changes, and the list changed before the
//   borrow is taken;
// - a list the function owns, a result that is a number, and one whose signature
//   says it is 'static: none of them holds the list;
// - a type whose lender and whose only writer are free functions, when the writer
//   sets an element or moves a position, writes no storage, so the type does not
//   change shape; and one that does change shape, its borrow used up first.

mod collection_reshape_free_success;

import stdio use *;
import collections use *;
import libc;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn first(xs: &List[i64]) &i64 { &xs[0usize] }

fn headOf(xs: &List[i64]) i64 { *xs[0usize] }

fn label(xs: &List[i64]) &'static str { "abc" }

fn total(xs: &List[i64]) i64 {
  var sum = 0i64;
  var i = 0usize;
  while i < xs.len() {
    sum = sum + *xs[i];
    i = i + 1usize;
  }
  sum
}

// A function that only reads the other name
fn readOnlyFree(l: &mut List[i64], m: &mut List[i64]) i64 {
  let a = first(l);
  let t = total(m);
  *a * 100 + t
}

// The borrow used up before the other name pushes
fn usedFirst(l: &mut List[i64], m: &mut List[i64]) i64 {
  let x = *first(l);
  m.push(1);
  x * 10 + i64.from(l.len())
}

// The list changed before the borrow is taken
fn grownFirst(l: &mut List[i64], m: &mut List[i64]) i64 {
  m.push(1);
  let a = first(l);
  *a
}

// A result that is a number, or 'static, holds nothing of the list
fn numberResult(l: &mut List[i64], m: &mut List[i64]) i64 {
  let h = headOf(l);
  m.push(1);
  h
}

fn staticResult(l: &mut List[i64], m: &mut List[i64]) i64 {
  let t = label(l);
  m.push(1);
  i64.from(t.len())
}

// A list the function owns
fn localList() i64 {
  var xs = List[i64].empty();
  xs.push(3);
  let x = *first(&xs);
  xs.push(4);
  x * 10 + i64.from(xs.len())
}

// A cursor over a block it does not own: the free function that moves it writes a
// number, never the pointer
struct Cursor {
  ptr: *i64;
  at: usize;
}

fn cursorFirst(c: &Cursor) &i64 { (c.ptr + c.at) as &i64 }

fn advance(c: &mut Cursor) { c.at = c.at + 1usize; }

fn cursorAdvances(c: &mut Cursor, d: &mut Cursor) i64 {
  let e = cursorFirst(c);
  advance(d);
  *e
}

// A wrapper whose free writer sets an element: no storage is replaced or freed
struct Slots {
  items: List[i64];
}

fn slotFirst(s: &Slots) &i64 { &s.items[0usize] }

fn setSlot(s: &mut Slots, v: i64) { s.items.set(0usize, v); }

fn slotsSet(a: &mut Slots, b: &mut Slots) i64 {
  let e = slotFirst(a);
  setSlot(b, 41);
  *e
}

// A wrapper that does change shape through a free function, its borrow used up
// before the change
struct Bag {
  items: List[i64];
}

fn bagFirst(b: &Bag) &i64 { &b.items[0usize] }

fn bagAdd(b: &mut Bag, v: i64) { b.items.push(v); }

fn bagUsedFirst(a: &mut Bag, b: &mut Bag) i64 {
  let x = *bagFirst(a);
  bagAdd(b, 9);
  x * 10 + i64.from(a.items.len())
}

fn bagAddedFirst(a: &mut Bag, b: &mut Bag) i64 {
  bagAdd(b, 8);
  let e = bagFirst(a);
  *e
}

fn main() {
  var shared = List[i64].empty();
  shared.push(7);
  shared.push(5);
  let one = &mut shared;
  let other = one;
  show("read-only-free", readOnlyFree(one, other));
  show("used-first", usedFirst(one, other));
  show("grown-first", grownFirst(one, other));
  show("number-result", numberResult(one, other));
  show("static-result", staticResult(one, other));
  show("local-list", localList());

  let block = libc.malloc(2usize * mem.sizeof[i64]()) as *i64;
  mem.writeRaw(block, 3);
  mem.writeRaw(block + 1usize, 4);
  var cur = Cursor(block, 0usize);
  let cone = &mut cur;
  let ctwo = cone;
  show("cursor-advances", cursorAdvances(cone, ctwo));
  show("cursor-at", i64.from(cur.at));

  var slots = Slots(List[i64].empty());
  slots.items.push(40);
  let sone = &mut slots;
  let stwo = sone;
  show("slots-set", slotsSet(sone, stwo));

  var bag = Bag(List[i64].empty());
  bag.items.push(6);
  let bone = &mut bag;
  let btwo = bone;
  show("bag-used-first", bagUsedFirst(bone, btwo));
  show("bag-added-first", bagAddedFirst(bone, btwo));
}
