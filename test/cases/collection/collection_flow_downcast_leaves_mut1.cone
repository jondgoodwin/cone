// The same rule as collection_flow_downcast_leaves where the shared owner is 'Rc[mut1]' or
// 'Arc[mut1]': a copy of a 'mut1' handle writes as a 'mut' one does, so the list another
// holder stores over may not be viewed by a result that leaves after a downcast.

mod collection_flow_downcast_leaves_mut1;

import collections use *;
import sync use Arc;

trait Counter { pub fn count(self: &) i32; }

struct RcHolder {
  pub rc: Rc[mut1, List[i32]];
  pub fn count(self: &) i32 { return 1i32; }
}

struct ArcHolder {
  pub rc: Arc[mut1, List[i32]];
  pub fn count(self: &) i32 { return 1i32; }
}

fn rcMut1(h: &<Counter, zero: &i32) &i32 {
  if let RcHolder(c) = h { return &(*c.rc)[0usize]; }     //~ ErrorEscape:43 "past a shared owner"
  return zero;
}

fn arcMut1(h: &<Counter, zero: &i32) &i32 {
  if let ArcHolder(c) = h { return &(*c.rc)[0usize]; }    //~ ErrorEscape:44 "past a shared owner"
  return zero;
}

fn main() {}
