// A call that reshapes a list through a global, handed nothing that reaches the list. A 'mut' global
// that reaches a type is a program-wide fact: a view into a collection of that type reached through a
// reference a caller lent could be a view into that global, which a callee cannot tell, so it is asked of
// every call (collection_flow_reshape_global_param holds the rest of that rule). This is the oldest form of
// it, a visible callee that reshapes the global by its name.

mod collection_flow_reshape_through_global;

import collections use *;

struct Pt { pub x i64; pub y i64; }

mut pool List[Pt];

fn @initpure init() {
  pool = List[Pt].empty();
}

fn resetPool() {
  pool.clear();
}

fn viaGlobal(l &mut List[Pt]) i64 {
  imm e = l[0usize];
  resetPool();                  //~ ErrorShapeReshape:12 "'resetPool' changes the shape of a 'List' through a global"
  e.x;
}
