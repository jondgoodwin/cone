// An 'Rc[mut, &uni ..]' with one holder: a store by the very name the borrow was taken
// through is refused as it always was, the borrow freezing '*o' until its last use. The
// rule that follows a second holder (collection_flow_store_uni_held_shared) changes
// nothing here.

mod collection_flow_store_uni_held_one;

import collections use *;

fn oneHolder() i32 {
  var l = List[i32]();
  l.push(7i32);
  var r = &uni l;
  let o = Rc[mut, &uni List[i32]](r);
  let v = &(**o)[0usize];
  **o = List[i32]();             //~ ErrorFrozen "'*o' is borrowed"
  *v
}

fn main() {
}
