// A borrow a method returns keeps the method's receiver loaned while it is
// used, the Rust way: 'list[0usize]' borrows 'list' read-only, so while the
// element is still to be used the list may be read but not changed -- a push
// may move every element -- and a method returning a mutable borrow freezes
// its receiver entirely: while the slice 'viewMut' lends is still to be used,
// the list may not be pushed onto, lent again by 'viewMut', or read through
// 'view' (a write through the slice is collections' own 'list' test). A call's arguments are in flight until it is made: an
// argument may not touch what an earlier one borrowed in a way that borrow
// forbids, except that a method receiver's mutable borrow is two-phase and
// meets the arguments as a read-only borrow would ('v.push(v.len())' is
// collection_freeze_success). Each error is reported at the touch.
//
// THE HOLE, documented rather than refused (Jon, 26 Sep 2026: to be closed by
// part (b) of the shape-changing rule; 'uni' reborrowing is built, the rule is
// not enforced yet). A collection reached as
// 'uni' -- a local, a field of one -- is loaned this way against every other
// access; one reached through a shared path freezes only that same path
// (collection_flow_freeze_shared). An element borrow through a shared path is
// not checked against a push through another alias, which leaves it dangling.
// Each of these compiles today:
//   A. a parameter:       fn f(l &mut List[Pt], m &mut List[Pt]) { imm e = l[0usize]; m.push(p); e.x; }
//                         (called with the same list twice)
//   B. a field of 'self': struct Bag { items List[Pt]; fn grow(self &mut, o &mut Bag) {
//                           imm e = items[0usize]; o.items.push(p); e.x; } }   (b.grow(&mut b)-alike)
//   C. a 'Rc[mut, T]' owner: imm l = new Rc[mut, List[Pt]](List[Pt].empty()); imm l2 = l;
//                         imm e = l[0usize]; l2.push(p); e.x;
//   D. a collection allocated in an arena and held by name:
//                         imm l = a.alloc(List[Pt].empty()); imm l2 = l;
//                         imm e = l[0usize]; l2.push(p); e.x;
//   E. a reference made from a pointer: imm l = ptr as &mut List[Pt]; imm e = l[0usize];
//                         (ptr as &mut List[Pt]).push(p); e.x;
// List, Deque, String, Dict and Pool declare 'ShapeChanging', the marker the
// check that refuses these will read; today it makes a returned borrow freeze
// its own path.

mod collection_flow_freeze;

import collections use *;
import pool use *;

struct Pt { pub x i64; pub y i64; }

// A plain struct whose method lends a mutable borrow of its field
struct Cell {
  pub v i64;
  pub fn get(self &mut) &mut i64 { &mut v; }
}

// Pushed onto while a borrow of an element is still to be used
fn pushWhileElementHeld() i64 {
  mut list = List[Pt].empty();
  list.push(new Pt(1, 2));
  imm first = list[0usize];
  list.push(new Pt(3, 4));      //~ ErrorFrozen:3 "may not be borrowed mutably"
  first.x;
}

// Pushed onto while the mutable slice 'viewMut' lent is still to be used
fn pushWhileViewMutHeld() i64 {
  mut list = List[i64].empty();
  list.push(1);
  imm s = list.viewMut();
  list.push(2);                 //~ ErrorFrozen:3 "may not be borrowed"
  s[0usize] = 5;
  s[0usize];
}

// Lent mutably a second time while the first mutable slice is still to be used
fn secondViewMut() {
  mut list = List[i64].empty();
  list.push(1);
  imm s = list.viewMut();
  imm t = list.viewMut();       //~ ErrorFrozen:11 "may not be borrowed"
  s[0usize] = 5;
  t[0usize] = 6;
}

// Read through 'view' while the mutable slice is still to be used
fn viewUnderViewMut() i64 {
  mut list = List[i64].empty();
  list.push(1);
  imm s = list.viewMut();
  imm r = list.view();          //~ ErrorFrozen:11 "may not be borrowed"
  s[0usize] = 5;
  r[0usize];
}

// A String grown while the mutable slice of its bytes is still to be used
fn appendWhileBytesHeld() {
  mut str = String.from("ab");
  imm b = str.viewMut();
  str.appendByte('c');          //~ ErrorFrozen:3 "may not be borrowed"
  b[0usize] = 'x';
}

// Read while a mutable borrow a method returned is still to be used
fn readUnderReturnedMut() i64 {
  mut c = new Cell(5);
  imm r = c.get();
  imm seen = c.v;               //~ ErrorFrozen:15 "may not be read"
  *r = 6;
  seen;
}

// A value removed from a pool while a borrow of it is still to be used
fn removeWhileHeld() i64 {
  mut p = Pool[Pt].empty();
  imm id = p.add(new Pt(1, 2));
  imm e = p[id];
  p.remove(id);                 //~ ErrorFrozen:3 "may not be borrowed mutably"
  e.x;
}

fn fill(l &mut List[i64], n usize) { l.push(i64.from(n)); }

// An explicit mutable borrow is not two-phase: a later argument may not read it
fn explicitThenRead() {
  mut v = List[i64].empty();
  fill(&mut v, v.len());        //~ ErrorFrozen:16 "may not be borrowed"
}

fn takeLast(l &mut List[i64]) i64 {
  match l.pop() {
    case imm n Some { n.value; }
    else { 0; }
  }
}

// A receiver's reserved borrow meets its arguments as a read-only borrow:
// one borrowing the receiver mutably is refused
fn receiverThenMutArg() {
  mut v = List[i64].empty();
  v.push(takeLast(&mut v));     //~ ErrorFrozen:19 "may not be borrowed mutably"
}

// Activated at the call, a receiver's mutable borrow may not meet what another
// argument carries: the slice 'view' lends would dangle once 'append' grows
// the string
fn appendOwnView() {
  mut s = String.from("ab");
  s.append(s.view());           //~ ErrorFrozen:3 "as the call's receiver"
}
