// A borrow a method returns keeps the method's receiver loaned while it is
// used, the Rust way: 'list[0usize]' borrows 'list' read-only, so while the
// element is still to be used the list may be read but not changed -- a push
// may move every element. A method returning a mutable borrow ('viewMut', a
// mutable element) is an alias loan, as any 'mut' borrow of a local is
// (collection_freeze_success runs what it lets through: the list read, lent
// again and viewed beside it); what it forbids is a change of shape, a push
// that may move the storage the slice points into, which the shape check
// refuses (ErrorShapeReshape), as it does through a shared path. A call's
// arguments are in flight until it is made: an argument may not touch what an
// earlier one borrowed in a way that borrow forbids, and a method receiver's
// mutable borrow is two-phase and meets the arguments as a read-only borrow
// would ('v.push(v.len())' is collection_freeze_success). Each error is
// reported at the touch.
//
// A collection reached as 'uni' -- a local, a field of one -- is loaned this
// way against every other access a read-only borrow forbids; one reached through
// a shared path freezes only that same path (collection_flow_freeze_shared), and
// a change through another name for it, or a call that might make one, is
// refused too (collection_flow_reshape, collection_flow_reshape_owners: two
// '&mut' parameters, a field of 'self' and another reference to the whole, a
// 'Rc[mut, T]' owner and a copy, a collection allocated in an arena and held by
// name, a reference made from a pointer). List, Deque, String, Dict and Pool
// declare 'ShapeChanging', the marker those checks read.

mod collection_flow_freeze;

import collections use *;
import pool use *;

struct Pt { pub x: i64; pub y: i64; }

// Pushed onto while a borrow of an element is still to be used
fn pushWhileElementHeld() i64 {
  var list = List[Pt].empty();
  list.push(new Pt(1, 2));
  let first = list[0usize];
  list.push(new Pt(3, 4));      //~ ErrorFrozen:3 "may not be borrowed mutably"
  first.x
}

// Pushed onto while the mutable slice 'viewMut' lent is still to be used: the
// push may move the storage the slice points into
fn pushWhileViewMutHeld() i64 {
  var list = List[i64].empty();
  list.push(1);
  let s = list.viewMut();
  list.push(2);                 //~ ErrorShapeReshape:7 "could change the shape of a 'List'"
  s[0usize] = 5;
  s[0usize]
}

// A String grown while the mutable slice of its bytes is still to be used
fn appendWhileBytesHeld() {
  var str = String.from("ab");
  let b = str.viewMut();
  str.appendByte('c');          //~ ErrorShapeReshape:6 "could change the shape of a 'String'"
  b[0usize] = 'x';
}

// A value removed from a pool while a borrow of it is still to be used
fn removeWhileHeld() i64 {
  var p = Pool[Pt].empty();
  let id = p.add(new Pt(1, 2));
  let e = p[id];
  p.remove(id);                 //~ ErrorFrozen:3 "may not be borrowed mutably"
  e.x
}

// Activated at the call, a receiver's mutable borrow may not meet what another
// argument carries: the slice 'view' lends would dangle once 'append' grows
// the string
fn appendOwnView() {
  var s = String.from("ab");
  s.append(s.view());           //~ ErrorFrozen:3 "as the call's receiver"
}
