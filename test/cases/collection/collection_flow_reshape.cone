// Part (b) of the rule for a borrow into a collection that changes shape through
// a path others share: the borrow is allowed, and refused when something could
// reshape the collection while it is still to be used, by another name for it
// or by a call that might make one. A change through the same name is the loan's
// own freezing (collection_flow_freeze_shared). Nothing here is decided by a
// method's name: a call reshapes when its receiver is a collection it may
// write a header field of (layer 2, read from its body; layer 1 where the body is
// not visible, which assumes it does), or when it is handed something that
// reaches a collection of that type by a path it may write, and it, or what it
// calls, reshapes one. Element writes ('set') reshape nothing; 'clear', 'pop' and
// 'truncate' each write the length.
//
// Each function is two names for one list the caller may have made one.

mod collection_flow_reshape;

import collections use *;

struct Pt { pub x i64; pub y i64; }

// Another reference pushes
fn twoNames(l &mut List[Pt], m &mut List[Pt], p Pt) i64 {
  imm e = l[0usize];
  m.push(p);                    //~ ErrorShapeReshape:4 "'push' writes a field of the 'List' it is called on"
  e.x;
}

// Another reference clears, pops or truncates: no pointer moves, but the
// elements end
fn clearOther(l &mut List[Pt], m &mut List[Pt]) i64 {
  imm e = l[0usize];
  m.clear();                    //~ ErrorShapeReshape:4 "'clear' writes a field of the 'List' it is called on"
  e.x;
}

fn popOther(l &mut List[Pt], m &mut List[Pt]) i64 {
  imm e = l[0usize];
  m.pop();                      //~ ErrorShapeReshape:4 "'pop' writes a field of the 'List' it is called on"
  e.x;
}

fn truncateOther(l &mut List[Pt], m &mut List[Pt]) i64 {
  imm e = l[0usize];
  m.truncate(0usize);           //~ ErrorShapeReshape:4 "'truncate' writes a field of the 'List' it is called on"
  e.x;
}

// A call handed the other reference, whose body pushes
fn bump(q &mut List[Pt], p Pt) {
  q.push(p);
}

fn viaCall(l &mut List[Pt], m &mut List[Pt], p Pt) i64 {
  imm e = l[0usize];
  bump(m, p);                   //~ ErrorShapeReshape:7 "'bump' is handed something that reaches a 'List'"
  e.x;
}

// ... through what it calls
fn bumpTwice(q &mut List[Pt], p Pt) {
  bump(q, p);
  bump(q, p);
}

fn viaTwoCalls(l &mut List[Pt], m &mut List[Pt], p Pt) i64 {
  imm e = l[0usize];
  bumpTwice(m, p);              //~ ErrorShapeReshape:12 "'bumpTwice' is handed something that reaches a 'List'"
  e.x;
}

// ... through functions that call each other, whose bodies are not all checked when
// this one is: the verdict waits until they are
fn evenPush(l &mut List[Pt], m &mut List[Pt], n i64, p Pt) i64 {
  imm e = l[0usize];
  if n > 0 {
    oddPush(l, m, n - 1, p);    //~ ErrorShapeReshape:12 "'oddPush' is handed something that reaches a 'List'"
  }
  e.x;
}

fn oddPush(l &mut List[Pt], m &mut List[Pt], n i64, p Pt) {
  if n > 0 {
    evenPush(l, m, n - 1, p);
  }
  else {
    m.push(p);
  }
}

// Handed a struct that holds the other reference
struct Holder { pub target &mut List[Pt]; }

fn fill(h &mut Holder, p Pt) {
  h.target.push(p);
}

fn viaHolder(l &mut List[Pt], h &mut Holder, p Pt) i64 {
  imm e = l[0usize];
  fill(h, p);                   //~ ErrorShapeReshape:7 "'fill' is handed something that reaches a 'List'"
  e.x;
}

// A struct that wraps a list, two references to it
struct Bag {
  pub items List[Pt];

  fn first(self &) &Pt { items[0usize]; }
  fn add(self &mut, p Pt) { items.push(p); }
}

fn twoBags(a &mut Bag, b &mut Bag, p Pt) i64 {
  imm e = a.first();
  b.add(p);                     //~ ErrorShapeReshape:4 "'add' writes a field of the 'Bag' it is called on"
  e.x;
}

// A method of the same struct, the borrow of one field and a push through
// another reference to the whole
fn fieldAndOther(a &mut Bag, b &mut Bag, p Pt) i64 {
  imm e = a.items[0usize];
  b.items.push(p);              //~ ErrorShapeReshape:10 "'push' writes a field of the 'List' it is called on"
  e.x;
}

// A function pointer: the compiler cannot see what it does
fn viaPointer(l &mut List[Pt], m &mut List[Pt], f &fn(q &mut List[Pt])) i64 {
  imm e = l[0usize];
  f(m);                         //~ ErrorShapeReshape:4 "its body is not visible here"
  e.x;
}

// A function defined elsewhere: its body is not here, so one handed the other
// reference is assumed to reshape what it reaches
extern fn elsewhere(q &mut List[Pt]);

fn viaExtern(l &mut List[Pt], m &mut List[Pt]) i64 {
  imm e = l[0usize];
  elsewhere(m);                 //~ ErrorShapeReshape:12 "its body is not visible here"
  e.x;
}

// The String methods: the body of 'appendByte' is read, and writes the length
fn invisibleMethod(s &mut String, t &mut String) usize {
  imm v = s.view();
  t.appendByte('c');            //~ ErrorShapeReshape:4 "'appendByte' writes a field of the 'String' it is called on"
  v.len;
}

// A call that reshapes through a global, handed nothing that reaches the list
mut pool List[Pt];

fn @initpure init() {
  pool = List[Pt].empty();
}

fn resetPool() {
  pool.clear();
}

fn viaGlobal(l &mut List[Pt]) i64 {
  imm e = l[0usize];
  resetPool();                  //~ ErrorShapeReshape:12 "'resetPool' changes the shape of a 'List' through a global"
  e.x;
}

// The borrow in flight: handed to the same call as the reference that changes it,
// or waiting for a call made around it
fn twoArgs(a &Pt, n usize) i64 {
  a.x + i64.from(n);
}

fn grow(q &mut List[Pt], p Pt) usize {
  q.push(p);
  q.len();
}

fn inFlight(l &mut List[Pt], m &mut List[Pt], p Pt) i64 {
  twoArgs(l[0usize], grow(m, p));   //~ ErrorShapeReshape:26 "'grow' is handed something that reaches a 'List'"
}

// A result that may hold the view lent to it (an unannotated signature shares
// one lifetime), used after the other String grows
fn pickText(target &str) &str {
  if target == "ab" {"first";} else {"second";};
}

fn growAfterPick(out &mut String, x &String) usize {
  imm t = pickText(x.view());
  out.append("!");              //~ ErrorShapeReshape:6 "'append' writes a field of the 'String' it is called on"
  t.len;
}

// A String's view appended to another String, both reached through references
// a caller may have made one
fn appendView(out &mut String, x &String) {
  out.append(x.view());         //~ ErrorShapeReshape:6 "'append' writes a field of the 'String' it is called on"
}

fn main() {}
