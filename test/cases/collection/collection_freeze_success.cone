// What a borrow a method returns still allows. It keeps the receiver loaned
// only until its last use, and only against what it forbids: while a
// read-only element borrow is used, the list may still be read; after its last
// use the list may be pushed onto again. A method receiver's mutable borrow is
// two-phase, so 'v.push(v.len())' reads 'v' for its argument before the push
// borrows it. An arena (it declares 'NoLoanMut') lends allocations with no loan
// on itself: any number are live at once, a function it is lent to may
// allocate for its caller twice, and a value allocated in it may hold a
// '&mut' of it. An owning reference coerced to a borrow may be moved after the
// borrow's last use. Each case prints what it read through the borrow.
//
// A mutable borrow of a local is an alias loan (ref_alias_mut_success): one a
// method returned out of a list, or of a struct's field, lets the source be
// read, lent again and written beside it. The refusals are
// collection_flow_freeze and region_flow_arena_freeze.

mod collection_freeze_success;

import stdio use *;
import collections use *;
import pool use *;
import arena use *;

struct Pt { pub x: i64; pub y: i64; }

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

// Two-phase receivers: the argument reads the list the push then changes
fn twoPhase() {
  var v = List[i64].empty();
  v.push(i64.from(v.len()));
  v.push(i64.from(v.len()));
  v.push(*v[1usize] + 10);
  show("two-phase-pushes", *v[0usize] + *v[1usize] * 10 + *v[2usize] * 100);
}

// A read-only element borrow: the list may be read while it is used, and
// pushed onto after its last use
fn readThenPush() {
  var list = List[Pt].empty();
  list.push(Pt(1, 2));
  let first = list[0usize];
  show("list-read-under-element", i64.from(list.len()) * 100 + first.x);
  list.push(Pt(3, 4));
  show("pushed-after-last-use", i64.from(list.len()));
}

// A borrow returned through another: a String element of a local list, and
// its bytes, read while the list is read
fn elementChain() {
  var names = List[String].empty();
  names.push(String.from("core"));
  let bytes = names[0usize].view();
  show("element-view", i64.from(bytes.len) * 10 + i64.from(names.len()));
  names.push(String.from("stdio"));
  show("pushed-after-view", i64.from(names.len()));
}

// A borrow in a loop, dead before the push on every iteration
fn loopThenPush() {
  var v = List[i64].empty();
  v.push(1);
  var i = 0usize;
  while i < 3usize {
    let last = v[v.len() - 1usize];
    v.push(*last * 2);
    i = i + 1usize;
  }
  show("doubled-in-loop", *v[3usize]);
}

// A pool's value read while the pool is read, then removed
fn poolRead() {
  var p = Pool[Pt].empty();
  let id = p.add(Pt(7, 8));
  let e = p[id];
  show("pool-read-under-borrow", i64.from(p.len()) * 100 + e.x);
  p.remove(id);
  show("pool-after-remove", i64.from(p.len()));
}

struct Node {
  pub n: i64;
  pub home: &mut Arena;
}

// A scratch function allocating for its caller
fn make(s: &mut Arena, n: i64) &mut Pt { s.alloc(Pt(n, n)) }

// Allocations live together, and one may hold a '&mut' of its arena
fn arenaAllocations() {
  var a = Arena.empty();
  let r1 = a.alloc(Pt(1, 2));
  let r2 = a.alloc(Pt(3, 4));
  let x = make(&mut a, 5);
  let y = make(&mut a, 6);
  let node = a.alloc(Node(7, &mut a));
  show("arena-live-together", r1.x + r2.x * 10 + x.x * 100 + y.x * 1000 + node.n * 10000);
}

// A mutable borrow a method returned is an alias loan, as every 'mut' borrow of a
// local is: while the slice 'viewMut' lends is used, the list is read, lent by
// 'viewMut' again and viewed; a change of shape is what collection_flow_freeze
// refuses
fn viewMutBorrowsAlias() {
  var list = List[i64].empty();
  list.push(1);
  let s = list.viewMut();
  let t = list.viewMut();
  let r = list.view();
  let n = list.len();
  s[0usize] = 5;
  t[0usize] = t[0usize] + 10;
  show("views-alias", r[0usize] * 10 + i64.from(n));
}

// A plain struct whose method lends a mutable borrow of its field, read beside it
struct Cell {
  pub v: i64;
  pub fn get(self: &mut) &mut i64 { &mut v }
}

fn cellReadUnderMut() {
  var c = Cell(5);
  let r = c.get();
  let seen = c.v;
  *r = 6;
  show("cell-read-under-mut", seen * 10 + c.v);
}

fn fill(l: &mut List[i64], n: usize) { l.push(i64.from(n)); }

fn takeLast(l: &mut List[i64]) i64 {
  match l.pop() {
    case let n Some { n }
    else { 0 }
  }
}

// An explicit mutable borrow beside a read of the list in one call, and a
// receiver's push beside an argument borrowing the list mutably: the borrows
// are all aliases, and the argument is worked out before the push
fn explicitAndReceiver() {
  var v = List[i64].empty();
  fill(&mut v, v.len());
  v.push(7);
  v.push(takeLast(&mut v));
  show("explicit-borrow-and-receiver", i64.from(v.len()) * 100 + *v[0usize] * 10 + *v[1usize]);
}

fn consumePt(p: Uni[Pt]) i64 { p.x }

// An owning reference coerced to a borrow, moved after the borrow's last use
fn ownedLent() {
  let u = Uni[Pt](4, 5);
  let b: &Pt = u;
  show("owned-lent", b.y);
  show("owner-moved-after", consumePt(u));
}

fn main() {
  twoPhase();
  readThenPush();
  elementChain();
  loopThenPush();
  poolRead();
  viewMutBorrowsAlias();
  cellReadUnderMut();
  explicitAndReceiver();
  arenaAllocations();
  ownedLent();
}
