// What is accepted beside collection_flow_swap_index: two elements of one collection, an
// index that only reads or calls something that changes nothing, one that changes another
// collection, an index that grows the collection written as the left side (its address is
// made before the right side's), and two stores in one assignment, each made before the
// next target is reached.

mod collection_swap_index_success;

import collections use *;
import stdio use *;

struct Item { pub a: Array[usize, 3]; }

// Adds sixty-four numbers, 0 to 63, and answers where the first of them is
fn growNums(m: &mut List[usize]) usize {
  let at = m.len();
  var i = 0usize;
  while i < 64usize { m.push(i); i += 1usize; }
  at
}
fn growItems(m: &mut List[Item]) usize {
  var i = 0usize;
  while i < 64usize { m.push(Item([7usize, 8usize, 9usize])); i += 1usize; }
  0usize
}
fn first() usize { 0usize }

fn show(n: usize) {
  printInt(i64.from(n));
  printStr(" ");
}
fn line() { printStr("\n"); }

fn elements() {
  var l = List[usize]();
  l.push(10usize);
  l.push(20usize);
  l.push(30usize);
  var i = 0usize;
  l[i] <-> l[i + 1usize];                     // 20 10 30
  l[first()] <-> l[l.len() - 1usize];         // 30 10 20
  show(*l[0usize]); show(*l[1usize]); show(*l[2usize]); line();
}

fn twoLists() {
  var l = List[usize]();
  l.push(10usize);
  var other = List[usize]();
  other.push(5usize);
  l[0usize] <-> other[growNums(&mut other)];  // l's 10 for other's element 1, which is 0
  show(*l[0usize]); show(*other[1usize]); show(other.len()); line();   // 0 10 65
}

// The left side's index grows the list before either element is reached
fn leftGrows() {
  var l = List[usize]();
  l.push(10usize);
  l[growNums(&mut l)] <-> l[0usize];          // element 1 (0) for element 0 (10)
  show(*l[0usize]); show(*l[1usize]); show(l.len()); line();           // 0 10 65

  var items = List[Item]();
  items.push(Item([1usize, 2usize, 3usize]));
  var x = [4usize, 5usize];
  x[growItems(&mut items)] <-> items[0usize].a[1usize];
  show(x[0usize]); show(items[0usize].a[1usize]); show(items.len()); line();   // 2 4 65
}

// Each target is stored into before the next one is reached
fn twoStores() {
  var items = List[Item]();
  items.push(Item([1usize, 2usize, 3usize]));
  var x = [4usize, 5usize];
  items[0usize].a[0usize], x[growItems(&mut items)] = 11usize, 12usize;
  show(items[0usize].a[0usize]); show(x[0usize]); show(items.len()); line();   // 11 12 65
}

fn owned() {
  var u = Uni[Item](Item([1usize, 2usize, 3usize]));
  var x = [4usize, 5usize];
  var i = 1usize;
  u.a[0usize] <-> x[i];                       // u is 5 2 3, x is 4 1
  u.a[1usize] <-> u.a[first()];               // u is 2 5 3
  show(u.a[0usize]); show(u.a[1usize]); show(u.a[2usize]); show(x[1usize]); line();  // 2 5 3 1
}

fn main() {
  elements();
  twoLists();
  leftGrows();
  twoStores();
  owned();
}
