// A range index with an end but no start, '..b', does not say whether the end is
// included any more than 'a..b' does, so it is refused in every slice form -- a
// borrow, a '&mut' or '&uni' borrow, a segment copy -- and read on as '..=b' so
// that nothing after it is reported twice. '..=b' and '..<b' are the two ways to
// write it; with no end, 's[..]' and 's[a..]' have nothing to include or leave out.

mod collection_parse_range_prefix;

fn borrowed(s: &Array[i32]) {
  let r = &s[..3];   //~ ErrorRangeBare:14 "write '..<' to stop before the end, or '..=' to include it"
}

fn spaced(s: &Array[i32], b: usize) {
  let r = &s[.. b + 1];   //~ ErrorRangeBare:14 "'..' does not say whether the range includes its end"
}

fn mutable(s: &mut Array[i32]) {
  let r = &mut s[..2];   //~ ErrorRangeBare:18 "write '..<' to stop before the end"
}

fn unique(s: &uni Array[i32]) {
  let r = &uni s[..2];   //~ ErrorRangeBare:18 "write '..<' to stop before the end"
}

fn segment(a: &mut Array[i32], b: &Array[i32]) {
  a[..2] = b;   //~ ErrorRangeBare:5 "write '..<' to stop before the end"
}
