// The other ways to have two names for one collection, each refused as two
// '&mut' parameters are (collection_flow_reshape): a field of 'self' and another
// reference to the whole, a shared 'Rc[mut, T]' owner and a copy of it, a list
// allocated in an arena and held by name twice, and a reference made from a
// pointer twice. An element is borrowed through one name and the other pushes.

mod collection_flow_reshape_owners;

import collections use *;
import arena use *;

struct Pt { pub x i64; pub y i64; }

struct Bag {
  pub items List[Pt];

  fn otherPushes(self &mut, other &mut Bag, p Pt) i64 {
    imm e = items[0usize];
    other.items.push(p);          //~ ErrorShapeReshape:16 "'push' reshapes the 'List' it is called on"
    e.x;
  }
}

fn ownerCopy(p Pt) i64 {
  imm l = new Rc[mut, List[Pt]](List[Pt].empty());
  imm l2 = l;
  imm e = l[0usize];
  l2.push(p);                     //~ ErrorShapeReshape:5 "'push' reshapes the 'List' it is called on"
  e.x;
}

fn arenaHandle(a &mut Arena, p Pt) i64 {
  imm l = a.alloc(List[Pt].empty());
  imm l2 = l;
  imm e = l[0usize];
  l2.push(p);                     //~ ErrorShapeReshape:5 "'push' reshapes the 'List' it is called on"
  e.x;
}

fn fromPointer(ptr *List[Pt], p Pt) i64 {
  imm l = ptr as &mut List[Pt];
  imm l2 = ptr as &mut List[Pt];
  imm e = l[0usize];
  l2.push(p);                     //~ ErrorShapeReshape:5 "'push' reshapes the 'List' it is called on"
  e.x;
}

fn main() {}
