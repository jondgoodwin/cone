// A value of another package's type behind a '&<mut Scorer + ShapeKeeping'. The
// program holds q's include file, which has no method bodies; it takes 'Tally' as
// that file says, recorded as keeping the shape of what a caller borrows (the
// refusals of the types it does not record are collection_flow_shapekeeping_xpkg).
//
// Each printed value was checked by hand against q's source.

mod prog;

import stdio use *;
import q;

trait Scorer { pub fn bump(self &mut, w &mut q.World); }

fn show(label &Array[u8], n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn through(w &mut q.World, s &<mut Scorer + ShapeKeeping) i64 {
  s.bump(w);
  w.score;
}

fn main() {
  var w = q.world();
  var t = new q.Tally(10);
  show("through", through(&mut w, &mut t));     // 1 + 10
  show("hp", w.hp);                             // 7
}
