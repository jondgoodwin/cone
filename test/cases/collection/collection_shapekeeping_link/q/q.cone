// A package compiled on its own whose types go behind a '+ ShapeKeeping' reference in
// the program that imports it. The program has only the include file, with no method
// bodies, so the package's own compile says in that file which of its types reshape
// nothing a caller borrows: it appends ShapeKeeping to the 'is' list of 'Tally', whose
// every method writes fields only, and of 'Cell', which changes shape itself but
// reaches nothing through a parameter. 'Putter' pushes into a Cell it reaches through
// a '&mut' parameter, and 'Mixed' has one method that does and one that does not;
// neither is recorded, so neither goes behind such a reference.

mod q;

// Changes shape: a method writes the pointer it owns and one lends a borrow of what
// it points at
pub struct Cell {
  ptr *i64;
  pub n i64;

  pub fn put(self &mut, p *i64) { ptr = p; }
  pub fn first(self &) &i64 { ptr as &i64 }
}

pub struct World {
  pub score i64;
  pub hp i64;
  pub cell Cell;
}

pub struct Tally {
  pub n i64;

  pub fn bump(self &mut, w &mut World) {
    w.score = w.score + n;
    w.hp = 7;
  }
}

pub struct Putter {
  pub fn bump(self &mut, w &mut World) { w.cell.put(null); }
}

pub struct Mixed {
  pub n i64;

  pub fn bump(self &mut, w &mut World) { w.score = w.score + n; }
  pub fn reset(self &mut, w &mut World) { w.cell.put(null); }
}

pub fn world() World { new World(1, 5, new Cell(null, 0)) }
