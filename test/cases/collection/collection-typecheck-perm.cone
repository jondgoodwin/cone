// The permission a slice may carry, and the element type it may claim.
//
// Type-check stage only, and separate from collection-typecheck-slice because
// the two ask different questions: that file asks which operations a slice
// supports at all, this one asks what a well-formed slice is then allowed to
// do. Together they would be past the three-to-six diagnostics one scenario
// should carry.
//
// Nothing here is a flow-stage expectation. Whether a write through a slice is
// permitted is decided by data-flow analysis, which is skipped for every
// function once any error has been reported, so such a diagnostic sharing a
// file with a type-check one would never run. Those are in collection-flow.

fn writesThrough(s &[]mut i32) { }

// A slice is borrowed under the same permission rule as any other reference:
// a writing slice cannot be taken from an immutable array
fn mutSliceFromImm() {
  imm settled [3; i32] = [1, 2, 3]
  imm s = &[]mut settled     //~ ErrorBadPerm:11 "Borrowed reference cannot obtain this permission"
}

// The element type is part of the slice's type and is not coerced. A slice of
// i32 is not a slice of u8 however the two elements would convert.
fn wrongElementType() {
  mut b [3; i32] = [1, 2, 3]
  imm s &[]u8 = &[]b         //~ ErrorInvType:17 "Initialization value's type does not match variable's declared type"
}

// A reading slice does not become a writing one at a call, exactly as a 'ro'
// reference does not become a 'mut' one
fn roSliceToMutParm() {
  mut b [3; i32] = [1, 2, 3]
  imm s = &[]b
  writesThrough(s)           //~ ErrorInvType:17 "Expression's type does not match declared parameter"
}

// The auto-borrow that lets an array be passed where a slice is expected
// produces a 'ro' slice and only a 'ro' slice, so a writing parameter has to be
// handed a slice the caller borrowed explicitly
fn autoBorrowIsReadOnly() {
  mut b [3; i32] = [1, 2, 3]
  writesThrough(b)           //~ ErrorInvType:17 "Expression's type does not match declared parameter"
}

// The slice's permission, not the array's, limits what may be borrowed out of
// an element: this array is mutable and this slice is not
fn mutElemFromRoSlice() {
  mut b [3; i32] = [1, 2, 3]
  imm s = &[]b
  imm r = &mut s[0]          //~ ErrorBadPerm:11 "Borrowed reference cannot obtain this permission"
}
