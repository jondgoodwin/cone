// The retired slice type, '&[]T', with a lifetime written on it or a slice as
// its own element. The lifetime goes after the '&', as on any borrow: '&[]'a T'
// is '&'a Array[T]', and '&[]'a mut T' is '&'a mut Array[T]'. A slice of
// slices is refused at each '&[]', the inner one and the outer.
//
// Name resolution stage only.

mod collection_nameres_spelling_lifetime;

fn lifetime(xs &[]'a u8) &'a u8 {   //~ ErrorSliceSpelling:16 "a lifetime goes after the '&'"
  return &xs[0];
}

fn lifetimeMut(xs &[]'a mut u8) {   //~ ErrorSliceSpelling:19 "A slice is spelled"
  return;
}

fn nested(rows &[]&[]u8) {          //~ ErrorSliceSpelling:16 "A slice is spelled"
                                    //~^ ErrorSliceSpelling:19 "A slice is spelled"
  return;
}
