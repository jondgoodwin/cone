// Error 1339, a sibling field handed as an argument. A view of one field and a call that is handed
// '&mut' of another field of the same struct (held by value): the call cannot reach the field the view
// is into, so it is accepted, as a push through the sibling field's own method is. The call may still
// write what the borrow holds by reference, which the body is asked of as before.

mod collection_flow_sibling_arg_success;

import stdio use *;
import collections use *;

fn grow(h: &mut List[u8]) { h.push(9u8); }
fn dec(src: &Array[u8], h: &mut List[u8]) { h.push(src[0usize]); }

struct D {
  inp: List[u8];
  hist: List[u8];

  fn p2(self: &mut) u8 {
    inp.push(5u8);
    let s = inp.view();
    grow(&mut hist);
    s[0usize]
  }
  fn p3(self: &mut) u8 {
    inp.push(7u8);
    dec(inp.view(), &mut hist);
    hist.view()[0usize]
  }
}

fn viaRef(d: &mut D) u8 {
  d.inp.push(8u8);
  let s = d.inp.view();
  grow(&mut d.hist);
  s[0usize]
}

fn main() {
  var d = D(List[u8](), List[u8]());
  printStr("p2 = ");
  printInt(i64.from(d.p2()));
  printStr("\n");
  var e = D(List[u8](), List[u8]());
  printStr("p3 = ");
  printInt(i64.from(e.p3()));
  printStr("\n");
  var f = D(List[u8](), List[u8]());
  printStr("viaRef = ");
  printInt(i64.from(viaRef(&mut f)));
  printStr("\n");
}
