// A panic inside the panic's hook, with CONE_BACKTRACE on: the first panic
// prints its backtrace (masked here), the second a line of its own and none.
mod exception_backtrace_double;

import stdio use *;

#if #os == .windows {
extern fn @c _putenv(setting: *u8) i32;
} #else {
extern fn @c putenv(setting: *u8) i32;
}

fn switchOn(setting: &Array[u8, 17]) {
  #if #os == .windows {
    _putenv(&setting[0usize] as *u8);
  } #else {
    putenv(&setting[0usize] as *u8);
  }
}

fn broken(msg: &str, file: &str, line: u32) {
  printStr("hook entered\n");
  panic("the hook failed too");
}

fn third(n: i32) i32 {
  if n > 0 { panic("three calls down"); }
  n + 1
}

fn second(n: i32) i32 { third(n) + 1 }

fn first(n: i32) i32 { second(n) + 1 }

fn main() {
  var setting = Array[u8, 17]() <- fill 0u8;
  let text = "CONE_BACKTRACE=1";
  let bytes: &Array[u8] = text;
  var i = 0usize;
  while i < bytes.len { setting[i] = bytes[i]; i = i + 1usize; }
  switchOn(&setting);
  setPanicHook(&broken);
  printStr("before\n");
  printInt(i64.from(first(1i32)));
}
