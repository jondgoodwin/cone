// A range whose end is past the slice's count panics, reporting the range and
// the count. An inclusive range counts its end: '1..3' is reported as the
// half-open range it is, '1..<4'.

mod exception_bounds_range;

import stdio use *;

fn part(s &Array[i32], a usize, b usize) &Array[i32] {
  &s[a..b];
}

fn main() {
  imm nums = [10, 20, 30, 40, 50];
  printUInt(u64.from(part(&nums, 1usize, 3usize).len));
  printStr("\n");
  printUInt(u64.from(part(&nums, 2usize, 6usize).len));
  printStr("\n");
}
