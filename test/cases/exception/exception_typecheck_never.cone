// A function returning Never must not return: it ends in a call that does not
// return, or in an 'if' each of whose paths does, and it never says 'return'.
// Each way of breaking that is refused where the function would return.

mod exception_typecheck_never;

import stdio use *;

// Its last statement is an expression that returns
fn endsInCall() Never {
  printStr("x");      //~ ErrorNeverReturns:11 "must not return"
}

// An 'if' with a path that falls through: here, no 'else'
fn missingElse(n i32) Never {
  if n > 0 {panic("positive");}      //~ ErrorNeverReturns:3 "must not return"
}

// An 'if' one of whose branches returns
fn oneBranchReturns(n i32) Never {
  if n > 0 {panic("positive");} else {printStr("y");}      //~ ErrorNeverReturns:3 "must not return"
}

// A 'return' anywhere in it
fn saysReturn(n i32) Never {
  if n > 0 {return;};      //~ ErrorNeverReturns:13 "must not return"
  panic("not positive");
}

// An empty body, which returns at once
fn empty() Never {}      //~ ErrorNeverReturns:18 "must not return"

// A last statement that is not an expression at all
fn endsInDeclaration() Never {
  imm x = 3;      //~ ErrorNeverReturns:7 "must end in a call that does not return"
}

// None of these is refused: each ends in a call returning Never, or an 'if'
// every path of which does
fn fine(n i32) Never {
  if n > 0 {panic("positive");} else {todo();}
}

fn alsoFine() Never {
  unreachable();
}
