// A panic ending a plain block in an 'if''s branch ends the path there, as a
// 'return' would: the branch's jump to the 'if''s end is not generated after
// it, and the program aborts at the call, so nothing after it runs.

mod exception_panic_nested;

import stdio use *;

fn check(n: i32) i32 {
  if n < 0 { { panic("negative"); } }
  n + 1
}

fn main() {
  printInt(i64.from(check(4)));
  printStr("\n");
  printInt(i64.from(check(-1)));
  printStr("after\n");
}
