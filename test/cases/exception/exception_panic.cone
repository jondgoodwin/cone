// A panic ends the program: what it printed before is kept, since stdout is
// flushed first; one line goes to stderr naming the file, the line of the
// call and the message; and the program aborts, so nothing after the call
// runs -- not the rest of main, and not the finalizer of the value still in
// scope.

mod exception_panic;

import stdio use *;

struct Noisy {
  pub n i32;
  fn final(self &uni) {
    printStr("finalized\n");
  }
}

fn main() {
  imm held = new Noisy(1);
  printStr("before\n");
  panic("the sky is falling");
  printStr("after\n");
}
