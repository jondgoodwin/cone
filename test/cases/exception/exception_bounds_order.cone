// A range that starts after it ends panics, saying so, whether or not either
// end is within the count.

mod exception_bounds_order;

import stdio use *;

fn part(s &[]i32, a usize, b usize) &[]i32 {
  &s[a..b];
}

fn main() {
  imm nums = [10, 20, 30, 40, 50];
  printUInt(u64[part(&nums, 2usize, 2usize).len]);
  printStr("\n");
  printUInt(u64[part(&nums, 4usize, 2usize).len]);
  printStr("\n");
}
