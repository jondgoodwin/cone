// 'assert' panics when its condition does not hold, and reports the line it
// was called on, not a line inside core. With no message of its own, the
// message is "assertion failed". Asserts that hold do nothing.

mod exception_assert;

import stdio use *;

fn main() {
  imm a = 3;
  imm b = 4;
  assert(a < b);
  assert(a + b == 7, "sums add up");
  printStr("both held\n");
  assert(a > b);
  printStr("not reached\n");
}
