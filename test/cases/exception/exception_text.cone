// A panic's message is text, a '&str': a String's view is one, with no cast,
// where it is built at run time. So is the message the hook is handed, and the
// file name in it: a hook declared with '&str' parameters takes them as they
// come. 'assert' takes its message the same way, and a function of the
// program's own that forwards a text message to 'panic' declares it '&str'.

mod exception_text;

import stdio use *;
import collections use *;

fn report(msg &str, file &str, line u32) {
  printStr("hook: ");
  printStr(msg);
  printStr(" in ");
  printStr(file);
  printStr(":");
  printUInt(u64.from(line));
  printStr("\n");
}

fn main() {
  setPanicHook(&report);
  mut msg = String.from("job ");
  msg <- 7u64;
  msg <- " of ";
  msg <- 12u64;
  msg <- " failed";
  assert(msg.len() > 0usize, msg.view());
  printStr("held\n");
  assert(msg.len() == 0usize, msg.view());
  printStr("not reached\n");
}
