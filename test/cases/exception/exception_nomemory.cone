// An allocation whose region's 'alloc' answers null panics, reporting the size
// asked for and the line of the allocation. A fallible allocation, '?+NeverAllocs',
// answers None instead (region_fallible_alloc). The region here fails every
// allocation; its values need no header, so the size is the value's alone,
// eight bytes for an i64.

mod exception_nomemory;

import stdio use *;

struct NeverAllocs is RegionRef {
  fn alloc(size usize) *u8 inline { 0usize as *u8; }
}

fn main() {
  printStr("allocating\n");
  imm r = +NeverAllocs 5i64;
  printStr("not reached\n");
}
