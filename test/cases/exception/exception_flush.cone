// A panic flushes what the program printed to stdout before its own line goes
// to stderr, even text with no line end yet; then the hook runs and prints
// after it. The check that fails is a slice's range, past the count, whose
// end needs more than 32 bits.

mod exception_flush;

import stdio use *;

fn hook(msg &Array[u8], file &Array[u8], line u32) {
  printStr("hook: ");
  printStr(msg);
  printStr(" @ ");
  printStr(file);
  printStr(":");
  printUInt(u64.from(line));
  printStr("\n");
}

fn cut(a &Array[u8], s usize, e usize) &Array[u8] {
  &a[s..e];
}

fn main() {
  printStr("no line end yet");
  eprintStr("stderr first|");
  setPanicHook(&hook);
  imm whole = "abcdef";
  printStr(cut(whole, 2usize, 4usize));
  imm part = cut(whole, 3usize, 99999999999usize);
  printStr(part);
}
