// An index at or past a slice's count panics, reporting the index, the count
// and the line of the index: the check the compiler inserts calls the C
// runtime's entry for it.

mod exception_bounds_index;

import stdio use *;

fn at(s &Array[i32], i usize) i32 {
  s[i];
}

fn main() {
  imm nums = [10, 20, 30];
  printInt(i64.from(at(&nums, 2usize)));
  printStr("\n");
  printInt(i64.from(at(&nums, 5usize)));
  printStr("\n");
}
