// A panic on a thread already panicking -- here the hook's own -- ends the
// program at once: its line says so, and the rest of the hook does not run.

mod exception_double;

import stdio use *;

fn broken(msg &Array[u8], file &Array[u8], line u32) {
  printStr("hook entered\n");
  panic("the hook failed too");
  printStr("hook finished\n");
}

fn main() {
  setPanicHook(&broken);
  panic("first failure");
}
