// A debug build: 'assertDebugMsg' panics with its own message. Used in a
// macro of the program's own, it names the line where that macro is used,
// not a line of the macro's body. The condition is substituted, not
// evaluated first, so it reads the argument written at each use.

mod exception_assertdebug_msg;

import stdio use *;

macro checkPositive[n] {
  assertDebugMsg(n > 0, "not positive");
}

fn main() {
  imm count = 0;
  checkPositive(count + 2);
  printStr("2 is positive\n");
  checkPositive(count);
  printStr("not reached\n");
}
