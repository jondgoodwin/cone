// A panic on a thread the program started names the thread, by its identity,
// which differs from run to run, so the scenario masks it: 'panic in thread
// <id> at ...'. A panic on the thread the program started on names none (every
// other scenario here). The whole program ends, the main thread waiting in
// 'join' included.

mod exception_thread;

import stdio use *;
import thread;

fn work(n i32) i32 {
  if n > 0 {
    panic("from a thread");
  }
  n;
}

fn main() {
  printStr("starting\n");
  imm t = thread.start(1, &work);
  t.join();
  printStr("not reached\n");
}
