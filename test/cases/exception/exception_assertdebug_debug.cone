// A debug build: 'isDebugBuild()' is true. 'assertDebug' and 'assertDebugMsg'
// run their conditions, which print, do nothing when they hold, and when one
// does not, panic with 'assertion failed' at the line of the use, as 'assert'
// does.

mod exception_assertdebug_debug;

import stdio use *;

fn noisy(ok bool) bool {
  printStr("condition evaluated\n");
  ok;
}

fn main() {
  if isDebugBuild() {printStr("debug build\n");} else {printStr("release build\n");}
  assertDebug(noisy(true));
  assertDebugMsg(noisy(true), "holds");
  printStr("both held\n");
  assertDebug(noisy(false));
  printStr("not reached\n");
}
