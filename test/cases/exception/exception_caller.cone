// A helper that panics on its caller's behalf reports its caller's location,
// Swift's way: it declares 'file' and 'line' parameters defaulting to
// 'srcFile()' and 'srcLine()', which answer where each call taking the default
// is, and hands them on. Here through two helpers, the outer defaulting its
// own and passing them to the inner, which passes them to 'assert': what is
// reported is the line of main's call.

mod exception_caller;

import stdio use *;

fn inner(n i32, file &Array[u8], line u32) {
  assert(n > 0, "must be positive", file, line);
}

fn requirePositive(n i32, file &Array[u8] = srcFile(), line u32 = srcLine()) {
  inner(n, file, line);
}

fn main() {
  requirePositive(5);
  printStr("five is positive\n");
  requirePositive(-5);
  printStr("not reached\n");
}
