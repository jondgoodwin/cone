// 'unreachable()' ends a 'match' arm the author believed could not be taken;
// taken, it panics with its own message, at the line it was written on.

mod exception_unreachable;

import stdio use *;

fn name(n i32) &Array[u8] {
  match n {
    case ==1 {"one";}
    case ==2 {"two";}
    else {unreachable();}
  }
}

fn main() {
  printStr(name(2));
  printStr("\n");
  printStr(name(3));
  printStr("\n");
}
