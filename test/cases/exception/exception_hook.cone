// The hook set with 'setPanicHook' is called once the panic's line is on
// stderr, with the message and the location, and before the program ends.
// Setting another replaces the first. This hook writes what it was given to
// stdout, which is flushed, as a panic flushes it first.

mod exception_hook;

import stdio use *;

fn first(msg &[]u8, file &[]u8, line u32) {
  printStr("first hook: not called\n");
}

fn report(msg &[]u8, file &[]u8, line u32) {
  printStr("hook: ");
  printStr(msg);
  printStr(" at ");
  printStr(file);
  printStr(":");
  printUInt(u64[line]);
  printStr("\n");
}

fn main() {
  setPanicHook(&first);
  setPanicHook(&report);
  printStr("hooked\n");
  panic("stop here");
}
