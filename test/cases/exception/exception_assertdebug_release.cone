// A release build: 'isDebugBuild()' is false, and an 'if' on it is folded
// away. 'assertDebug' and 'assertDebugMsg' are folded away whole, so their
// conditions, which print when they run, never run, and failing ones do not
// panic. 'assert' is checked all the same, and its condition runs.

mod exception_assertdebug_release;

import stdio use *;

fn debugBanner() {
  printStr("debug build\n");
}

fn debugOnly(ok Bool) Bool {
  printStr("debug-only condition evaluated\n");
  ok;
}

fn always(ok Bool) Bool {
  printStr("condition evaluated\n");
  ok;
}

fn main() {
  if isDebugBuild() {debugBanner();} else {printStr("release build\n");}
  assertDebug(debugOnly(false));
  assertDebugMsg(debugOnly(false), "not checked in a release build");
  printStr("assertDebug skipped\n");
  assert(always(false), "checked in every build");
  printStr("not reached\n");
}
