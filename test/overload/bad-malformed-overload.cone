// Negative fixture: malformed overload declarations.
// Expected: Error 1053 "Expected the overload name that follows 'overload'",
// Error 1053 "A declaration's overload name must differ from its own name same",
// and Error 1053 "An anonymous function may not declare an overload name"

fn missingName overload (n i32) i32:
  n

fn same overload same(n f32) f32:
  n

fn anonymous() i32:
  imm f = &fn overload op(x i32) i32 {x * x}
  3i32
