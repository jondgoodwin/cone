// Negative fixture: two candidates each accept the argument by widening it.
// Fewer or narrower coercions do not win, so the call is ambiguous.
// Expected: Error 1057 "More than one function declared by widen accepts these
// arguments. Call a concrete name or convert the arguments."

fn widenMid overload widen(n i32) i32:
  n

fn widenWide overload widen(n i64) i64:
  n * 2i64

fn manycoercible():
  widen(5i16)
