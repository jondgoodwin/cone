// Negative fixture: two candidates of one overload set accept the same
// parameter signature, so the overload name could never choose between them.
// Return types do not distinguish them.
// Expected: Error 1056 "sameFloat accepts the same arguments as sameInt, so
// overload same could never choose between them." for the module set, and the
// same diagnostic naming the method set's candidates.

fn sameInt overload same(n i32) i32:
  n

fn sameFloat overload same(n i32) f32:
  f32[n]

struct Holder:
  v i32

  fn dupOne overload dup(self, n i32) i32:
    v + n
  fn dupTwo overload dup(self, n i32) f32:
    f32[v]
