// Overloaded operator methods: unique concrete names plus explicit overload names.
// Covers user-declared operator methods plus the pointer/reference operator
// candidates that the compiler declares for its built-in types.

import stdio::*

// Operator methods declared on a struct, including one overload set on `+`
struct Vec2:
  x f32
  y f32

  fn addVec overload `+`(self, other Vec2) Vec2:
    Vec2[x + other.x, y + other.y]
  fn addScalar overload `+`(self, scalar f32) Vec2:
    Vec2[x + scalar, y + scalar]
  fn `+=`(self &mut, other Vec2) Vec2:
    x = x + other.x
    y = y + other.y
    *self
  fn `()`(self) f32:
    x - y
  fn `[]`(self, index usize) f32:
    if index == 0 {x} else {y}

fn vecOps() f32:
  mut a = Vec2[1., 2.]
  imm b = Vec2[3., 4.]
  imm sum = a + b
  imm bumped = a + 10.
  // The operator's concrete name is an ordinary method that may be called directly
  imm named = a.addVec(b)
  a += b
  imm called = a()
  imm first = a[0]
  called + first + named.x

// Pointer operators: comparison, arithmetic, difference, and op-assign.
// `-` names two compiler-declared candidates: pointer minus offset, and
// the difference between two pointers of the same type.
fn ptrOps(mut a *i32, b *i32) Bool:
  b[*a] = a[0]
  mut r i32 = 4
  if !a:
    r = *a
  --a
  a++
  a = a + 2
  a = a - 1
  imm diff = b - a
  a += 4
  a -= 4
  imm same = a == b
  imm order = a < b
  a <= b

// Reference comparison operators
fn refOps() Bool:
  mut m = 3
  mut n = 4
  imm rm = &m
  imm rn = &n
  imm eq = rm == rn
  imm ne = rm != rn
  imm lt = rm < rn
  rm >= rn

// Number operators reach the compiler's intrinsic methods, where `-` names
// both the unary negation and the binary subtraction candidates
fn numberOps() f32:
  mut i = 5
  i = i + 2
  i = i * 3
  i = i - 1
  i -= 1
  mut f = 2.5
  f = f + 1.
  f = -f
  f

fn opmain():
  imm v = vecOps() + numberOps()
  imm r = refOps()
