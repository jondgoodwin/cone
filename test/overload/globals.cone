// Overloaded global and static functions: unique concrete names plus explicit
// overload names, selection through the overload name, and direct concrete calls.

import stdio::*

// A module-level overload set with an exact match and a coercible match
fn showInt overload show(n i64):
  print <- n

fn showFloat overload show(n f64):
  print <- n

fn showText overload show(text &[]u8):
  // A &[]u8 value would suit both the &[]u8 and *u8 candidates of <-,
  // so this calls stdio's concrete function rather than the overload name
  printStr(text)

fn globals():
  // Exact match on the i64 candidate
  show(42i64)
  // i32 widens to i64; the f64 and &[]u8 candidates accept nothing here
  show(7i32)
  // Exact match on the f64 candidate
  show(2.5d)
  show("global overload")
  // Every candidate keeps its own name and may be called without selection
  showInt(9i64)
  showFloat(1.5d)

// A private concrete candidate may be selected through a public overload name
fn _secretUnsigned overload emit(n u64):
  print <- n

fn emitText overload emit(text &[]u8):
  printStr(text)

fn visibility():
  emit(3u64)
  emit("public spelling")

// One overload name may take a default parameter on one of its candidates
fn repeatText overload repeat(text &[]u8, times i64 = 2i64):
  mut n = times
  while n > 0:
    printStr(text)
    n = n - 1

fn repeatNumber overload repeat(n i64):
  print <- n

fn defaults():
  repeat("twice")
  repeat("thrice", 3i64)
  repeat(5i64)

// Static (non-method) functions declared inside a type share the same rules
struct Maker:
  seed i32

  fn fromInt overload make(n i32) Maker:
    Maker[n]
  fn fromFloat overload make(n f32) Maker:
    Maker[i32[n]]

fn statics() i32:
  imm a = Maker::make(3i32)
  imm b = Maker::make(4.5f)
  imm c = Maker::fromInt(6i32)
  a.seed + b.seed + c.seed

fn globalmain():
  globals()
  visibility()
  defaults()
  imm seeds = statics()
