// Negative fixture: two declarations claim the same concrete name.
// Every function and method needs its own name; overloading is opt-in through
// a separate overload name.
// Expected: Error 1011 "Duplicate name ..." for the module function and
// Error 1011 "Duplicate name twice: every function/method needs its own name."
// for the method.

fn once(n i32) i32:
  n

fn once(n f32) f32:
  n

struct Holder:
  v i32

  fn twice(self) i32:
    v
  fn twice(self, n i32) i32:
    v * n
