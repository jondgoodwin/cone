// Negative fixture: an overload name used as a value rather than as a callee.
// Only the concrete name may be borrowed, stored, or returned.
// Expected: Error 1060 "The overload name show may only be used as the name
// being called. Use a concrete name for its value." (reported for each use)

fn showInt overload show(n i64):
  imm ignored = n

fn showFloat overload show(n f64):
  imm ignored = n

fn takeAddress():
  imm p = &show

fn storeIt():
  imm f = show

fn returnIt() i64:
  show
