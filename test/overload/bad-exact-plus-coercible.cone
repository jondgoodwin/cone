// Negative fixture: one candidate matches exactly and another matches by coercion.
// The exact match is not preferred, so the call is ambiguous.
// Expected: Error 1057 "More than one function declared by widen accepts these
// arguments. Call a concrete name or convert the arguments."

fn widenNarrow overload widen(n i32) i32:
  n

fn widenWide overload widen(n i64) i64:
  n * 2i64

fn exactplus():
  widen(5i32)
