// Negative fixture: two candidates accept the call exactly.
// One takes a defaulted second parameter, so both accept a single argument.
// Neither wins, because return types and declaration order never take part.
// Expected: Error 1057 "More than one function declared by pick accepts these
// arguments. Call a concrete name or convert the arguments."

fn pickOne overload pick(n i32) i32:
  n

fn pickTwo overload pick(n i32, step i32 = 1i32) i32:
  n * step

fn twoexact():
  pick(3i32)
