// An overload name folded into another module by a wildcard import.
// The importing module resolves the overload name, selects among its
// candidates, and lowers each call to the concrete declaration it selects.

import importsub::*

fn imports() i64:
  // Selects the public candidate through the overload name
  imm doubled = scale(21i64)
  // Selects the private candidate through the public overload name. The caller
  // never looks up the private concrete spelling, so this is allowed, and
  // generation must still emit a symbol for a private candidate declared in a
  // module whose function bodies this compile does not generate.
  imm halved = scale(1.5d)
  // A public concrete name stays directly callable across the import
  imm bumped = plain(7i64)
  doubled + bumped + i64[halved]
