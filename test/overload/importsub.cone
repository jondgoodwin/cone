// Supporting module for imports.cone. It is imported, never compiled directly.
//
// Its public overload name 'scale' has both a public and a private candidate,
// so an importing module can select a private concrete declaration without ever
// naming that private spelling itself.

fn scaleInt overload scale(n i64) i64:
  n * 2i64

fn _scaleFloat overload scale(n f64) f64:
  n * 2.0d

// A private overload name is not folded by a wildcard import at all
fn _hiddenOne overload _hidden(n i64) i64:
  n - 1i64

fn plain(n i64) i64:
  n + 1i64
