// Negative fixture: an overload name collides with a different kind of binding.
// An overload name must be unused or already bound to an overload set.
// Expected: Error 1055 "Overload name label is already declared as something
// that is not an overload name." for the module function, and the same error
// for the method whose overload name is already a concrete method.

fn label(n i32) i32:
  n

fn labelFloat overload label(n f32) f32:
  n

struct Holder:
  v i32

  fn size(self) i32:
    v
  fn sizeScaled overload size(self, n i32) i32:
    v * n
