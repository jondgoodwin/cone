// Negative fixture: no candidate accepts the call's arguments.
// Expected: Error 1056 "No method declared by `add` accepts the call's arguments."

struct Point:
  x f32
  y f32

  fn addValue overload add(self) f32:
    x + y
  fn addOther overload add(self, other Point) f32:
    self.x + other.x

fn nomatch():
  imm pt = Point[1., 2.]
  pt.add(3i32, 4i32, 5i32)
