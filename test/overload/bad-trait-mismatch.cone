// Negative fixture: a type declares the trait's method name, but nothing it
// declares has the signature the trait requires. The trait's default is not
// silently added alongside it.
// Expected: Error 1013 "Type declares area, but none of what it declares has
// the signature Shape requires"

trait Shape:
  fn area(self &) f32:
    1.

struct Blob extends Shape:
  r f32

  fn areaScaled overload area(self &, scale f32) f32:
    r * scale

fn conform() f32:
  imm b = Blob[2.]
  (&b).areaScaled(3.)
