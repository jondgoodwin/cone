// llmchat: talk to a Qwen3 running on your GPU.
//
//   congo run --release examples/llmchat.cone -- --model C:\src\llm-models\Qwen3-8B-Q4_K_M.gguf
//
//   --model <path.gguf>   the model (Qwen3, or any ChatML GGUF of the qwen3 or llama layout)
//   --temp <t>            sampling temperature, default 0.7; 0 picks the most likely token every time
//   --ctx <n>             positions of context, default 4096 (the KV cache lives on the GPU: 288 KiB a position
//                         for the 8B, so 8192 is 2.25 GiB); a context that will not fit is refused with the
//                         largest that would
//   --think               show Qwen3's thinking (<think> ... </think>) before each answer. Without it the
//                         model is given its own empty thinking block and answers directly
//   --top-k <k>           default 20     --top-p <p>   default 0.8 (0.95 with --think)    --seed <n>
//   --validate            run with the Vulkan validation layer on, where installed (slower; for checking the GPU code)
//
// It is a multi-turn chat in ChatML: each line you type is a turn, the reply streams as it is made, and the
// conversation stays in the GPU's KV cache, so a turn costs only its own tokens. After each reply it prints the
// reply's tokens and tokens a second. `/reset` starts a new conversation; the end of the input (Ctrl-Z then
// Enter on Windows, Ctrl-D elsewhere) or `/quit` ends the program. Input may be piped.
//
// --voice talks instead of typing (package voicechat: Parakeet hears you, Qwen3 answers with thinking off, Kokoro says
// each sentence as it is finished, and speaking over the reply cuts it off):
//
//   congo run --release examples/llmchat.cone -- --model <path.gguf> --voice [--audio system|dummy|disk in.raw out.raw]
//
//   --audio system        the real microphone and speakers (the default; this makes sound), or
//   --audio disk in.raw out.raw   SDL's disk driver: the microphone is a raw f32 file (44.1 kHz mono), the speaker is
//                         written to one (44.1 kHz stereo); no device, no sound. --audio dummy: silence in, nothing out
//   --voice-name <v>      a Kokoro voice (af_heart, am_michael, bf_emma, bm_george ...) or a blend: af_heart:0.7,bf_emma:0.3
//                         (written af_heart:0.7+bf_emma:0.3 in the llmchat.cmd launcher, which splits at commas)
//   --speed <x>           speech speed, default 1.0
//   --threshold-scale <k> how much louder than the room speech must be to cut the reply while it plays (default 3;
//                         1 with a headset)
//   --end-silence-ms <ms>  the silence that ends your turn when what you said so far ends a sentence (Parakeet wrote a full
//                         stop, question mark or exclamation mark): default 400
//   --unfinished-silence-ms <ms>   the silence that ends it when what you said does not (you paused in the middle of a
//                         sentence); speech before then is joined to the same turn: default 1500. Set it equal to
//                         --end-silence-ms to end every pause as before. README.md of voicechat has the numbers
//   Saying goodbye, bye or stop (alone: "Goodbye!", "OK, stop.") ends the conversation, as does Ctrl-C.
//   --seconds <n>         stop after n seconds (default: until Ctrl-C)      --max-tokens <n>   longest reply (400)
//   --no-timings          do not print the per-turn timing lines
//   --no-gpu-warm         do not run light work on the GPU while you speak (that work, only while you are speaking,
//                         keeps the GPU's clock up so Parakeet takes 0.1 s, not 0.3 s)
//   --stt-model <f> --stt-vocab <f> --tts-dir <d>   where Parakeet's and Kokoro's converted files are
//                         (default C:\src\speech-models)      --temp, --top-k, --top-p, --seed as above
//                         --ctx as above, but 2048 by default with --voice (a spoken exchange is about 75 tokens; the 8B
//                         with all three models then leaves 1.4 GiB of the GPU's 8 free; when the context fills, a new
//                         conversation begins and the model has forgotten the old one)

mod llmchat;

import stdio use *;
import collections use List, String;
import path use Path;
import process;
import time use Instant;
import random use Rng;
import gpu use *;
import llmrun use *;
import voicechat;

// Everything one reply reports
struct Reply {
  tokens: usize;
  prefillSeconds: f64;
  decodeSeconds: f64;
  // The context filled before the model finished
  full: bool;
}

fn say(msg: &str) {
  eprintStr(msg);
}

fn usage() {
  say("usage: llmchat --model <path.gguf> [--temp 0.7] [--ctx 4096] [--think] [--top-k 20] [--top-p 0.8] [--seed n] [--validate] [--voice [--audio system|dummy|disk in.raw out.raw] [--voice-name af_heart] [--speed 1.0]]\n");
}

fn bytesOf(s: &str) List[u8] {
  var out = List[u8].empty();
  let b: &Array[u8] = s;
  var i = 0usize;
  while i < b.len { out.push(b[i]); i = i + 1usize; }
  out
}

// Run the turn's tokens, then generate until the model ends its turn or the context is full, printing as it goes
fn reply(engine: &mut Engine, device: &mut Device, vocab: &ModelTokens, sampler: &TokenSampler, rng: &mut Rng,
    turn: List[u32], thinking: bool) Result[Reply, String] {
  let t0 = Instant.now();
  var logits = List[f32].empty();
  match engine.feed(device, turn.view(), true) {
    case var Ok(l) { logits <-> l; }
    case let Err(e) { return Err[Reply, String](e.copy()); }
  }
  let t1 = Instant.now();
  var stream = TextStream.make();
  var made = 0usize;
  var full = false;
  var more = true;
  while more {
    let id = sampler.sample(logits.view(), rng);
    if vocab.isStop(id) {
      more = false;
    } else {
      writeBytes(stream.push(&vocab.tok, id, thinking).view());
      made = made + 1usize;
      if engine.pos >= engine.ctx {
        full = true;
        more = false;
      } else {
        var one = List[u32].empty();
        one.push(id);
        match engine.feed(device, one.view(), true) {
          case var Ok(l) { logits <-> l; }
          case let Err(e) { return Err[Reply, String](e.copy()); }
        }
      }
    }
  }
  writeBytes(stream.finish().view());
  let t2 = Instant.now();
  Ok[Reply, String](Reply(made, t1.since(t0).secondsF64(), t2.since(t1).secondsF64(), full))
}

// --voice: a spoken conversation (package voicechat). The options not already read by main.
fn talk(args: &List[String], device: &mut Device, model: &str, temperature: f64, ctx: usize, topK: usize, topP: f64,
    seed: u64) i32 {
  var o = voicechat.VoiceOptions.defaults(model);
  o.temperature = temperature;
  // a spoken exchange is short (about 75 tokens), so voice mode asks for 2048 positions unless --ctx says otherwise: with the
  // 8B that is 576 MiB of the GPU's memory back for the three models to share (7.15 GiB of 8 are in use at 4096)
  o.ctx = 2048usize;
  match argValue(args, "--ctx") { case is Some { o.ctx = ctx; } case is None {} }
  o.topK = topK;
  o.topP = topP;
  o.seed = seed;
  // a blend is written af_heart:0.7,bf_emma:0.3, or with + for the comma (a .cmd file splits its arguments at commas)
  match argValue(args, "--voice-name") { case var Some(v) { o.voice = v; o.voice.replaceByte('+', ','); } case is None {} }
  match argValue(args, "--speed") {
    case let Some(t) {
      match parseFloat(t.view()) {
        case let Some(x) { o.speed = f32.from(x); }
        case is None { say("llmchat: --speed is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }
  match argValue(args, "--threshold-scale") {
    case let Some(t) {
      match parseFloat(t.view()) {
        case let Some(x) { o.thresholdScale = f32.from(x); }
        case is None { say("llmchat: --threshold-scale is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }
  match argValue(args, "--end-silence-ms") {
    case let Some(t) {
      match parseUInt(t.view()) {
        case let Some(x) { o.endSilenceMs = u32.from(x); }
        case is None { say("llmchat: --end-silence-ms is not a number of milliseconds\n"); return 2i32; }
      }
    }
    case is None {}
  }
  match argValue(args, "--unfinished-silence-ms") {
    case let Some(t) {
      match parseUInt(t.view()) {
        case let Some(x) { o.unfinishedSilenceMs = u32.from(x); }
        case is None { say("llmchat: --unfinished-silence-ms is not a number of milliseconds\n"); return 2i32; }
      }
    }
    case is None {}
  }
  match argValue(args, "--seconds") {
    case let Some(t) {
      match parseUInt(t.view()) {
        case let Some(x) { o.runSeconds = u32.from(x); }
        case is None { say("llmchat: --seconds is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }
  match argValue(args, "--max-tokens") {
    case let Some(t) {
      match parseUInt(t.view()) {
        case let Some(x) { o.maxTokens = usize.from(x); }
        case is None { say("llmchat: --max-tokens is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }
  match argValue(args, "--stt-model") { case var Some(v) { o.sttModel = v; } case is None {} }
  match argValue(args, "--stt-vocab") { case var Some(v) { o.sttVocab = v; } case is None {} }
  match argValue(args, "--tts-dir") { case var Some(v) { o.ttsDir = v; } case is None {} }
  if hasFlag(args, "--no-timings") { o.echoTimings = false; }
  if hasFlag(args, "--no-gpu-warm") { o.keepWarm = false; }
  // --audio system | dummy | disk <in.raw> <out.raw>; without it, the real devices
  var i = 0usize;
  while i < args.len() {
    if args[i].view() == "--audio" {
      if i + 1usize >= args.len() { say("llmchat: --audio needs system, dummy or disk <in.raw> <out.raw>\n"); return 2i32; }
      o.audio = args[i + 1usize].copy();
      if o.audio.view() == "disk" {
        if i + 3usize >= args.len() { say("llmchat: --audio disk needs <in.raw> <out.raw>\n"); return 2i32; }
        o.inFile = args[i + 2usize].copy();
        o.outFile = args[i + 3usize].copy();
      }
    }
    i = i + 1usize;
  }
  voicechat.run(device, &o)
}

fn main() i32 {
  let args = process.args();
  var modelPath = String.empty();
  match argValue(&args, "--model") {
    case var Some(p) { modelPath = p; }
    case is None { usage(); return 2i32; }
  }
  var temperature = 0.7;
  match argValue(&args, "--temp") {
    case let Some(t) {
      match parseFloat(t.view()) {
        case let Some(x) { temperature = x; }
        case is None { say("llmchat: --temp is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }
  var ctx = 4096usize;
  match argValue(&args, "--ctx") {
    case let Some(t) {
      match parseUInt(t.view()) {
        case let Some(x) { ctx = usize.from(x); }
        case is None { say("llmchat: --ctx is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }
  let thinking = hasFlag(&args, "--think");
  var topK = 20usize;
  match argValue(&args, "--top-k") {
    case let Some(t) {
      match parseUInt(t.view()) {
        case let Some(x) { topK = usize.from(x); }
        case is None { say("llmchat: --top-k is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }
  var topP = 0.8;
  if thinking { topP = 0.95; }
  match argValue(&args, "--top-p") {
    case let Some(t) {
      match parseFloat(t.view()) {
        case let Some(x) { topP = x; }
        case is None { say("llmchat: --top-p is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }
  var seed = u64.from(Instant.now().nanos());
  match argValue(&args, "--seed") {
    case let Some(t) {
      match parseUInt(t.view()) {
        case let Some(x) { seed = x; }
        case is None { say("llmchat: --seed is not a number\n"); return 2i32; }
      }
    }
    case is None {}
  }

  utf8Console();
  // No window and no Vulkan validation layer unless --validate: with the layer every Vulkan call costs several
  // times as much (recording a token's 722 dispatches took 11 ms with it and 1 to 3 ms without, on the 1.7B)
  var instance = if hasFlag(&args, "--validate") { Instance.create("llmchat") } else { Instance.createHeadless("llmchat", false) };
  var none = Surface.none();
  var adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  if !adapter.isValid() { say("llmchat: no GPU with Vulkan 1.3\n"); return 1i32; }
  var device = adapter.requestComputeDevice(&ComputeRequest(largeBuffers: true));
  if !device.isValid() { say("llmchat: the GPU could not be opened for compute\n"); return 1i32; }

  if hasFlag(&args, "--voice") {
    return talk(&args, &mut device, modelPath.view(), temperature, ctx, topK, topP, seed);
  }

  say("loading the model ...\n");
  let loadStart = Instant.now();
  let modelFile = Path.from(modelPath.view());
  var engine: Engine = match Engine.open(&mut device, &modelFile, &LoadOptions(ctx, 64usize)) {
    case var Ok(e) { e }
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  };
  var vocab: ModelTokens = match loadTokens(engine.ggufModel()) {
    case var Ok(v) { v }
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  };
  if !vocab.hasChatMl {
    say("llmchat: this model's vocabulary has no ChatML tokens (<|im_start|>, <|im_end|>, <think>, </think>)\n");
    return 1i32;
  }
  var rng = Rng.fromSeed(seed);
  let sampler = TokenSampler.make(f32.from(temperature), topK, f32.from(topP));
  say("ready in ");
  say(oneDecimal(loadStart.elapsed().secondsF64()).view());
  say(" s: ");
  say(engine.info.arch.view());
  say(", ");
  var counts = String.empty();
  counts <- u64.from(engine.shape().layers);
  counts <- " layers, context ";
  counts <- u64.from(engine.ctx);
  say(counts.view());
  say(". Type a message; /reset starts over, /quit leaves.\n");

  // After a reply that ended with the model's <|im_end|>, the engine has not run it: the next turn starts with it
  var closeFirst = false;
  var conversing = true;
  while conversing {
    printStr("\n> ");
    print.flush();
    match readLine() {
      case let Some(line) {
        let text = String.fromBytes(line.view());
        let t = text.trim();
        if t.len() == 0usize {
          // nothing typed
        } else if t.view() == "/quit" {
          conversing = false;
        } else if t.view() == "/reset" {
          engine.reset();
          closeFirst = false;
          printStr("(a new conversation)\n");
        } else {
          var turn = List[u32].empty();
          if closeFirst {
            let c = vocab.closeTurn();
            var i = 0usize;
            while i < c.len() { turn.push(*c[i]); i = i + 1usize; }
          }
          let u = vocab.userTurn(t.view(), thinking);
          var i = 0usize;
          while i < u.len() { turn.push(*u[i]); i = i + 1usize; }
          if engine.pos + turn.len() + 1usize > engine.ctx {
            printStr("(the context is full: /reset starts a new conversation, or restart with a larger --ctx)\n");
          } else {
            let turnLength = turn.len();
            match reply(&mut engine, &mut device, &vocab, &sampler, &mut rng, turn, thinking) {
              case let Ok(r) {
                printStr("\n[");
                printUInt(u64.from(r.tokens));
                printStr(" tokens, ");
                var rate = 0.0;
                if r.decodeSeconds > 0.0 { rate = f64.from(r.tokens) / r.decodeSeconds; }
                printStr(oneDecimal(rate).view());
                printStr(" tokens/s; the ");
                printUInt(u64.from(turnLength));
                printStr(" tokens of the turn took ");
                printStr(oneDecimal(r.prefillSeconds).view());
                printStr(" s]\n");
                if r.full {
                  printStr("(the context is full: /reset starts a new conversation)\n");
                  closeFirst = false;
                } else {
                  closeFirst = true;
                }
              }
              case let Err(m) { say(m.view()); say("\n"); conversing = false; }
            }
          }
        }
      }
      case is None { conversing = false; }
    }
  }
  device.endFrame();
  device.waitIdle();
  0i32
}
