// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import fs;
import path use Path;
import gguf;
import llmrun use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- LlmError(String.from("llmrun: the context is full (32 positions)")), "llmrun: the context is full (32 positions)", "plain");
  says(String() <- LlmError.from(fs.FsError(String.from("mapFile"), Path.from("m.gguf"), Path.from(""), 2i32)), "llmrun: mapFile m.gguf: No such file or directory", "from fs");
  says(String() <- LlmError.from(gguf.GgufError.make(gguf.ErrorKind.BadMagic, 24u64, "the file ends inside a string")), "llmrun: gguf: at offset 24: the file ends inside a string", "from gguf");
  done()
}
