// Choosing a token: argmax, the top-k selection, and the temperature / top-k / top-p sampler against the
// distributions they should draw from. No GPU.

mod sampler;

import testing use *;
import libc;
import collections use List;
import random use Rng;
import llmrun use *;

// logits whose softmax at temperature 1 is p
fn logitsOf(p: &Array[f64]) List[f32] {
  var l = List[f32].empty();
  var i = 0usize;
  while i < p.len { l.push(f32.from(libc.log(p[i]))); i = i + 1usize; }
  l
}

// How many of n draws were each of the first 'bins' tokens, as fractions
fn frequencies(s: &TokenSampler, logits: &List[f32], rng: &mut Rng, n: usize, bins: usize) List[f64] {
  var counts = List[f64].empty();
  var b = 0usize;
  while b < bins { counts.push(0.0); b = b + 1usize; }
  var i = 0usize;
  while i < n {
    let id = usize.from(s.sample(logits.view(), rng));
    if id < bins { counts.set(id, *counts[id] + 1.0); }
    i = i + 1usize;
  }
  b = 0usize;
  while b < bins { counts.set(b, *counts[b] / f64.from(n)); b = b + 1usize; }
  counts
}

fn main() i32 {
  var rng = Rng.fromSeed(5u64);

  // ---- argmax and the top-k selection ----
  let ties = [1.0f, 3.0, 2.0, 3.0, 0.5];
  expectUInt(u64.from(argmax(&ties)), 1u64, "argmax takes the lowest id among equal logits");
  let top = topCandidates(&ties, 3usize);
  expectUInt(u64.from(top.len()), 3u64, "the top 3 are 3");
  expectUInt(u64.from(top[0usize].id), 1u64, "...the first is id 1 (3.0)");
  expectUInt(u64.from(top[1usize].id), 3u64, "...then id 3 (3.0, a later id)");
  expectUInt(u64.from(top[2usize].id), 2u64, "...then id 2 (2.0)");
  expectUInt(u64.from(topCandidates(&ties, 99usize).len()), 5u64, "asking for more than there are gives them all");
  expectUInt(u64.from(topCandidates(&ties, 1usize)[0usize].id), 1u64, "the top 1 is the argmax");

  // ---- greedy ----
  let p4 = [0.5, 0.3, 0.15, 0.05];
  let l4 = logitsOf(&p4);
  let greedy = TokenSampler.greedy();
  expectUInt(u64.from(greedy.sample(l4.view(), &mut rng)), 0u64, "greedy takes the largest");
  expectUInt(u64.from(TokenSampler.make(0.0, 40usize, 0.9).sample(l4.view(), &mut rng)), 0u64, "temperature 0 is greedy whatever else is set");

  // ---- the distribution at temperature 1: the probabilities themselves ----
  let n = 40000usize;
  let f1 = frequencies(&TokenSampler.make(1.0, 0usize, 1.0), &l4, &mut rng, n, 4usize);
  expectFloat(*f1[0usize], 0.5, 0.01, "temperature 1, no cuts: token 0 is drawn half the time");
  expectFloat(*f1[1usize], 0.3, 0.01, "...token 1 30 per cent");
  expectFloat(*f1[2usize], 0.15, 0.01, "...token 2 15 per cent");
  expectFloat(*f1[3usize], 0.05, 0.01, "...token 3 5 per cent");

  // ---- top-k ----
  let f2 = frequencies(&TokenSampler.make(1.0, 2usize, 1.0), &l4, &mut rng, n, 4usize);
  expectFloat(*f2[0usize], 0.5 / 0.8, 0.01, "top-k 2: token 0 is 5/8");
  expectFloat(*f2[1usize], 0.3 / 0.8, 0.01, "...token 1 is 3/8");
  expectFloat(*f2[2usize] + *f2[3usize], 0.0, 0.0, "...and tokens 2 and 3 are never drawn");
  expectUInt(u64.from(TokenSampler.make(5.0, 1usize, 1.0).sample(l4.view(), &mut rng)), 0u64, "top-k 1 is greedy at any temperature");

  // ---- top-p ----
  let f3 = frequencies(&TokenSampler.make(1.0, 0usize, 0.7), &l4, &mut rng, n, 4usize);
  expectFloat(*f3[0usize], 0.5 / 0.8, 0.01, "top-p 0.7: the nucleus is the first two (0.5 + 0.3 reaches 0.7)");
  expectFloat(*f3[2usize] + *f3[3usize], 0.0, 0.0, "...so tokens 2 and 3 are never drawn");
  expectUInt(u64.from(TokenSampler.make(1.0, 0usize, 0.01).sample(l4.view(), &mut rng)), 0u64, "a tiny top-p keeps the best one");

  // ---- the nucleus is chosen at temperature 1, the temperature then applied to it (llama.cpp's order) ----
  // top-p 0.7 keeps tokens 0 and 1 (0.5 + 0.3); at temperature 2 they are drawn in the ratio sqrt(.5) : sqrt(.3)
  let f6 = frequencies(&TokenSampler.make(2.0, 0usize, 0.7), &l4, &mut rng, n, 4usize);
  expectFloat(*f6[0usize], 0.7071 / (0.7071 + 0.5477), 0.01, "top-p 0.7 then temperature 2: tokens 0 and 1 in the ratio of their square roots");
  expectFloat(*f6[2usize] + *f6[3usize], 0.0, 0.0, "...and no other token is drawn");

  // ---- temperature flattens and sharpens ----
  let f4 = frequencies(&TokenSampler.make(2.0, 0usize, 1.0), &l4, &mut rng, n, 4usize);
  // p^(1/2) normalised: sqrt(.5) .. = 0.7071 0.5477 0.3873 0.2236 over 1.8657
  expectFloat(*f4[0usize], 0.7071 / 1.8657, 0.01, "temperature 2 flattens: token 0 is about 38 per cent");
  expectFloat(*f4[3usize], 0.2236 / 1.8657, 0.01, "...token 3 about 12 per cent");
  let f5 = frequencies(&TokenSampler.make(0.05, 0usize, 1.0), &l4, &mut rng, 2000usize, 4usize);
  expectFloat(*f5[0usize], 1.0, 0.0, "temperature 0.05 draws the best every time");

  // ---- the same seed, the same draws ----
  var ra = Rng.fromSeed(77u64);
  var rb = Rng.fromSeed(77u64);
  let s = TokenSampler.make(1.0, 0usize, 1.0);
  var same = true;
  var i = 0usize;
  while i < 200usize {
    if s.sample(l4.view(), &mut ra) != s.sample(l4.view(), &mut rb) { same = false; }
    i = i + 1usize;
  }
  expectBool(same, true, "two generators with one seed draw the same tokens");

  // ---- a vocabulary-sized draw (top-k off): finite, in range ----
  var big = List[f32].empty();
  i = 0usize;
  while i < 151936usize { big.push(f32.from(i % 97usize) * 0.1); i = i + 1usize; }
  let id = usize.from(TokenSampler.make(0.8, 0usize, 0.95).sample(big.view(), &mut rng));
  expectBool(id < 151936usize, true, "a draw over 151936 logits is a token of the vocabulary");
  done()
}
