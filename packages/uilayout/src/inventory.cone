// ======== InvModel: items, stacks and bags, and the rules for moving them ========
//
// Pure logic, no layout: what an inventory window shows and what a drop may do.
//
//   Item types   a name, an icon handle, a stack limit, a bag size (0: not a bag),
//                a category bit and a fallback colour
//   Containers   a row of slots. A root container is a character's pack or a chest;
//                a bag owns one (its slots are the bag's size)
//   Items        one stack (a type and a count) or one bag, living in a slot of a container
//
// THE RULES (what the tests pin):
//   - a stack moves whole, or in part (the count asked), to an empty slot
//   - onto a stack of the same type it merges, up to the stack limit; onto a full stack: refused
//   - onto a bag it goes into the bag (the first stack of its type with room, then the first
//     empty slot); a bag that cannot take all of it refuses; a bag can take a bag only if
//     the bag going in is SMALLER (fewer slots), so bags nest and never loop; a root
//     container takes any bag
//   - onto anything else the two swap, if each may stand where the other was
//   - a container may accept only some categories (an equipment slot)
//   - a bag's contents travel with it

pub const DR_PLACED = 1u32;           // moved into an empty slot
pub const DR_MERGED = 2u32;           // joined a stack, all of it
pub const DR_MERGED_PARTIAL = 3u32;   // joined a stack, the stack filled and some stayed behind
pub const DR_SWAPPED = 4u32;
pub const DR_INTO_BAG = 5u32;
pub const DR_SPLIT = 6u32;            // part of a stack moved to an empty slot
pub const DR_ACCEPTED = 10u32;        // a generic drop target took it (the application acts)
pub const DR_BOUND = 11u32;           // a hotbar slot bound it
pub const DR_NOTHING = 20u32;         // the source slot is empty
pub const DR_SAME = 21u32;            // dropped where it came from
pub const DR_FULL = 22u32;            // the stack there is full
pub const DR_BAG_FULL = 23u32;        // the bag has no room for it
pub const DR_BAG_TOO_BIG = 24u32;     // a bag may only go into a larger bag
pub const DR_FILTER = 25u32;          // the container takes another category
pub const DR_NOT_ALLOWED = 26u32;     // a swap that one side cannot take
pub const DR_NO_TARGET = 27u32;       // dropped on nothing
pub const DR_KIND = 28u32;            // the target does not take this kind of payload

pub fn accepted(code: u32) bool {code < 20u32}

pub struct ItemType {
  pub name: String;
  pub icon: u32 = 0u32;           // a texture handle the renderer knows; 0: draw the colour
  pub maxStack: u32 = 1u32;
  pub bagSlots: u32 = 0u32;
  pub category: u32 = 1u32;       // one bit
  pub color: u32 = 0x808080ffu32;
}

pub struct Item {
  pub kind: u32 = 0u32;           // index into the types; 0: this slot of the table is free
  pub count: u32 = 0u32;
  pub container: u32 = 0u32;      // where it lives (0: nowhere)
  pub slot: u32 = 0u32;
  pub bag: u32 = 0u32;            // the container this bag item owns (0 for a non-bag)
}

pub struct Container {
  pub nslots: u32 = 0u32;
  pub first: usize = 0usize;      // its first slot in InvModel.slots
  pub owner: u32 = 0u32;          // the bag item that owns it; 0 for a root container
  pub accept: u32 = 0u32;         // category mask; 0 takes anything
  pub live: bool = false;
}

pub struct InvModel {
  pub types: List[ItemType];
  pub items: List[Item];
  pub containers: List[Container];
  pub slots: List[u32];           // item id in each slot, 0 for empty

  pub fn make() InvModel {
    var m = InvModel(List[ItemType].empty(), List[Item].empty(), List[Container].empty(), List[u32].empty());
    m.types.push(ItemType(name: String.from("(none)")));
    m.items.push(Item());
    m.containers.push(Container());
    m
  }

  // ---- definitions ----

  pub fn defineType(self: &mut, name: &str, icon: u32, maxStack: u32, bagSlots: u32, category: u32, color: u32) u32 {
    types.push(ItemType(name: String.from(name), icon: icon, maxStack: maxStack, bagSlots: bagSlots, category: category, color: color));
    u32.from(types.len() - 1usize)
  }

  // A root container (a pack, a chest, an equipment row)
  pub fn makeContainer(self: &mut, nslots: u32, accept: u32) u32 {
    let id = u32.from(containers.len());
    containers.push(Container(nslots: nslots, first: slots.len(), owner: 0u32, accept: accept, live: true));
    var i = 0u32;
    while i < nslots {
      slots.push(0u32);
      i = i + 1u32;
    }
    id
  }

  // A new item, in no container yet. A bag gets its own container
  pub fn newItem(self: &mut, kind: u32, count: u32) u32 {
    let id = u32.from(items.len());
    items.push(Item(kind: kind, count: count));
    if types[usize.from(kind)].bagSlots > 0u32 {
      let c = makeContainer(types[usize.from(kind)].bagSlots, 0u32);
      containers[usize.from(c)].owner = id;
      items[usize.from(id)].bag = c;
      items[usize.from(id)].count = 1u32;
    }
    id
  }

  // ---- reading ----

  pub fn itemAt(self: &, container: u32, slot: u32) u32 {
    let c = usize.from(container);
    if c == 0usize || c >= containers.len() || slot >= containers[c].nslots {return 0u32;}
    *slots[containers[c].first + usize.from(slot)]
  }

  pub fn countAt(self: &, container: u32, slot: u32) u32 {
    let it = itemAt(container, slot);
    if it == 0u32 {0u32} else {items[usize.from(it)].count}
  }

  pub fn typeOf(self: &, item: u32) u32 {items[usize.from(item)].kind}

  pub fn isBag(self: &, item: u32) bool {item != 0u32 && items[usize.from(item)].bag != 0u32}

  pub fn slotCount(self: &, container: u32) u32 {containers[usize.from(container)].nslots}

  // How many of one type a container holds, bags' contents included
  pub fn total(self: &, container: u32, kind: u32) u32 {
    var n = 0u32;
    var s = 0u32;
    while s < containers[usize.from(container)].nslots {
      let it = itemAt(container, s);
      if it != 0u32 {
        if items[usize.from(it)].kind == kind {n = n + items[usize.from(it)].count;}
        if items[usize.from(it)].bag != 0u32 {n = n + total(items[usize.from(it)].bag, kind);}
      }
      s = s + 1u32;
    }
    n
  }

  pub fn freeSlots(self: &, container: u32) u32 {
    var n = 0u32;
    var s = 0u32;
    while s < containers[usize.from(container)].nslots {
      if itemAt(container, s) == 0u32 {n = n + 1u32;}
      s = s + 1u32;
    }
    n
  }

  // The container a container sits in (through its bag), 0 for a root
  pub fn parentContainer(self: &, container: u32) u32 {
    let owner = containers[usize.from(container)].owner;
    if owner == 0u32 {0u32} else {items[usize.from(owner)].container}
  }

  // Whether 'inner' is 'outer' or inside one of its bags
  pub fn isInside(self: &, inner: u32, outer: u32) bool {
    var c = inner;
    var guard = 0;
    while c != 0u32 && guard < 64 {
      if c == outer {return true;}
      c = parentContainer(c);
      guard = guard + 1;
    }
    false
  }

  // ---- writing, without rules ----

  fn putInSlot(self: &mut, item: u32, container: u32, slot: u32) {
    slots.set(containers[usize.from(container)].first + usize.from(slot), item);
    if item != 0u32 {
      items[usize.from(item)].container = container;
      items[usize.from(item)].slot = slot;
    }
  }

  fn takeFromSlot(self: &mut, container: u32, slot: u32) {
    slots.set(containers[usize.from(container)].first + usize.from(slot), 0u32);
  }

  // Puts an item in a slot (which must be empty), no questions asked
  pub fn put(self: &mut, item: u32, container: u32, slot: u32) {putInSlot(item, container, slot);}

  // Adds 'count' of a type to a container: onto stacks with room first, then empty slots
  // (never into bags). Returns how many did not fit
  pub fn add(self: &mut, container: u32, kind: u32, count: u32) u32 {
    var left = count;
    let limit = types[usize.from(kind)].maxStack;
    var s = 0u32;
    while s < containers[usize.from(container)].nslots && left > 0u32 {
      let it = itemAt(container, s);
      if it != 0u32 && items[usize.from(it)].kind == kind && items[usize.from(it)].count < limit {
        let room = limit - items[usize.from(it)].count;
        let take = if left < room {left} else {room};
        items[usize.from(it)].count = items[usize.from(it)].count + take;
        left = left - take;
      }
      s = s + 1u32;
    }
    s = 0u32;
    while s < containers[usize.from(container)].nslots && left > 0u32 {
      if itemAt(container, s) == 0u32 {
        let take = if left < limit {left} else {limit};
        let it = newItem(kind, take);
        putInSlot(it, container, s);
        left = left - take;
      }
      s = s + 1u32;
    }
    left
  }

  // ---- the rules ----

  // May this item stand in this container (category, and the bag rule)? Returns 0 if so,
  // else the refusal
  pub fn mayStandIn(self: &, item: u32, container: u32) u32 {
    let cont = containers[usize.from(container)];
    let tp = &types[usize.from(items[usize.from(item)].kind)];
    if cont.accept != 0u32 && (tp.category & cont.accept) == 0u32 {return DR_FILTER;}
    if items[usize.from(item)].bag != 0u32 && cont.owner != 0u32 {
      // inside a bag: only a bag with fewer slots, and never into itself or its own contents
      if isInside(container, items[usize.from(item)].bag) {return DR_BAG_TOO_BIG;}
      if tp.bagSlots >= cont.nslots {return DR_BAG_TOO_BIG;}
    }
    0u32
  }

  // Where 'count' of a type would go in a container: true if all of it fits (stacks of the
  // same type with room, then empty slots)
  pub fn roomFor(self: &, container: u32, kind: u32, count: u32) bool {
    let limit = types[usize.from(kind)].maxStack;
    var left = count;
    var s = 0u32;
    while s < containers[usize.from(container)].nslots {
      let it = itemAt(container, s);
      if it == 0u32 {
        if left <= limit {return true;}
        left = left - limit;
      }
      else if items[usize.from(it)].kind == kind && items[usize.from(it)].count < limit {
        let room = limit - items[usize.from(it)].count;
        if left <= room {return true;}
        left = left - room;
      }
      s = s + 1u32;
    }
    left == 0u32
  }

  fn amount(self: &, item: u32, want: u32) u32 {
    let have = items[usize.from(item)].count;
    if want == 0u32 || want > have {have} else {want}
  }

  // What would moving 'want' (0: all) of the stack in (srcC, srcS) onto (dstC, dstS) do? The
  // outcome code, without doing it
  pub fn check(self: &, srcC: u32, srcS: u32, dstC: u32, dstS: u32, want: u32) u32 {
    let s = itemAt(srcC, srcS);
    if s == 0u32 {return DR_NOTHING;}
    if srcC == dstC && srcS == dstS {return DR_SAME;}
    let refuse = mayStandIn(s, dstC);
    let n = amount(s, want);
    let t = itemAt(dstC, dstS);
    if t == 0u32 {
      if refuse != 0u32 {return refuse;}
      return if n == items[usize.from(s)].count {DR_PLACED} else {DR_SPLIT};
    }
    let sk = items[usize.from(s)].kind;
    let tk = items[usize.from(t)].kind;
    let limit = types[usize.from(sk)].maxStack;
    if sk == tk && limit > 1u32 {
      if refuse != 0u32 {return refuse;}
      if items[usize.from(t)].count >= limit {return DR_FULL;}
      let room = limit - items[usize.from(t)].count;
      return if n <= room && n == items[usize.from(s)].count {DR_MERGED} else {DR_MERGED_PARTIAL};
    }
    // onto a bag: into it
    let tb = items[usize.from(t)].bag;
    if tb != 0u32 && t != s {
      let inward = mayStandIn(s, tb);
      if inward == 0u32 {
        if !roomFor(tb, sk, n) {return DR_BAG_FULL;}
        return DR_INTO_BAG;
      }
      // a bag that is not smaller falls through to a swap; any other refusal stands
      if inward != DR_BAG_TOO_BIG {return inward;}
    }
    // swap
    if n != items[usize.from(s)].count {return DR_NOT_ALLOWED;}
    if refuse != 0u32 {return refuse;}
    let back = mayStandIn(t, srcC);
    if back != 0u32 {return back;}
    // a bag may not swap into its own contents
    if isInside(dstC, items[usize.from(s)].bag) && items[usize.from(s)].bag != 0u32 {return DR_BAG_TOO_BIG;}
    if isInside(srcC, items[usize.from(t)].bag) && items[usize.from(t)].bag != 0u32 {return DR_BAG_TOO_BIG;}
    DR_SWAPPED
  }

  // Does the move 'check' describes. Returns the outcome (a refusal changes nothing)
  pub fn move(self: &mut, srcC: u32, srcS: u32, dstC: u32, dstS: u32, want: u32) u32 {
    let code = check(srcC, srcS, dstC, dstS, want);
    if !accepted(code) {return code;}
    let s = itemAt(srcC, srcS);
    let t = itemAt(dstC, dstS);
    let n = amount(s, want);
    if code == DR_PLACED {
      takeFromSlot(srcC, srcS);
      putInSlot(s, dstC, dstS);
    }
    else if code == DR_SPLIT {
      let part = newItem(items[usize.from(s)].kind, n);
      items[usize.from(s)].count = items[usize.from(s)].count - n;
      putInSlot(part, dstC, dstS);
    }
    else if code == DR_MERGED || code == DR_MERGED_PARTIAL {
      let limit = types[usize.from(items[usize.from(s)].kind)].maxStack;
      let room = limit - items[usize.from(t)].count;
      let take = if n < room {n} else {room};
      items[usize.from(t)].count = items[usize.from(t)].count + take;
      items[usize.from(s)].count = items[usize.from(s)].count - take;
      if items[usize.from(s)].count == 0u32 {
        takeFromSlot(srcC, srcS);
        items[usize.from(s)].kind = 0u32;
      }
      else if code == DR_MERGED {return DR_MERGED_PARTIAL;}
    }
    else if code == DR_INTO_BAG {
      let bagC = items[usize.from(t)].bag;
      moveInto(s, srcC, srcS, bagC, n);
    }
    else {
      // swap
      takeFromSlot(srcC, srcS);
      takeFromSlot(dstC, dstS);
      putInSlot(t, srcC, srcS);
      putInSlot(s, dstC, dstS);
    }
    code
  }

  // Moves n of the stack s (from srcC/srcS) into a container: onto stacks with room, then empty slots
  fn moveInto(self: &mut, s: u32, srcC: u32, srcS: u32, dst: u32, n: u32) {
    let kind = items[usize.from(s)].kind;
    let limit = types[usize.from(kind)].maxStack;
    var left = n;
    if items[usize.from(s)].bag != 0u32 {
      // a bag goes in whole, to the first empty slot
      takeFromSlot(srcC, srcS);
      var k = 0u32;
      while k < containers[usize.from(dst)].nslots {
        if itemAt(dst, k) == 0u32 {
          putInSlot(s, dst, k);
          return;
        }
        k = k + 1u32;
      }
      return;
    }
    var k = 0u32;
    while k < containers[usize.from(dst)].nslots && left > 0u32 {
      let it = itemAt(dst, k);
      if it != 0u32 && items[usize.from(it)].kind == kind && items[usize.from(it)].count < limit {
        let room = limit - items[usize.from(it)].count;
        let take = if left < room {left} else {room};
        items[usize.from(it)].count = items[usize.from(it)].count + take;
        left = left - take;
      }
      k = k + 1u32;
    }
    k = 0u32;
    while k < containers[usize.from(dst)].nslots && left > 0u32 {
      if itemAt(dst, k) == 0u32 {
        let take = if left < limit {left} else {limit};
        let it = newItem(kind, take);
        putInSlot(it, dst, k);
        left = left - take;
      }
      k = k + 1u32;
    }
    items[usize.from(s)].count = items[usize.from(s)].count - n;
    if items[usize.from(s)].count == 0u32 {
      takeFromSlot(srcC, srcS);
      items[usize.from(s)].kind = 0u32;
    }
  }
}
