// ======== Small numeric helpers ========

pub fn minf(a: f32, b: f32) f32 inline {if a < b {a} else {b}}
pub fn maxf(a: f32, b: f32) f32 inline {if a > b {a} else {b}}
pub fn absf(a: f32) f32 inline {if a < 0. {-a} else {a}}
pub fn clampf(v: f32, lo: f32, hi: f32) f32 inline {if v < lo {lo} else if v > hi {hi} else {v}}
pub fn floorf(v: f32) f32 inline {libc.floorf(v)}
pub fn ceilf(v: f32) f32 inline {libc.ceilf(v)}
pub fn roundf(v: f32) f32 inline {libc.floorf(v + 0.5)}
pub fn minu(a: usize, b: usize) usize inline {if a < b {a} else {b}}
pub fn maxu(a: usize, b: usize) usize inline {if a > b {a} else {b}}
