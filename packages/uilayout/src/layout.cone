// ======== Layout: measure, then arrange ========
//
// MEASURE (measureNode) answers "how big do you want to be, given these box
// constraints?" for the border box (padding in, margin out), and caches the
// answer with the constraints it was for. ARRANGE (arrangeNode) is told the
// final size and places the children inside it, each in the parent's pixels
// (relative to the parent's border box). The two passes are those of Flutter's
// RenderBox and WPF's Measure/Arrange; the flex distribution follows the CSS
// Flexbox Level 1 specification, 9.7 "Resolving Flexible Lengths".
//
// A node of fixed size on both axes is a relayout boundary: its measure never
// looks at its content, and a change inside it does not dirty its ancestors'
// measures. Arrange is skipped for a node whose size is unchanged and which is
// not dirty; its dirty descendants are still visited.

// ---- entry point ----

// Lays out the whole Ui: the root layer, then the overlay. 'm' measures text:
// fn(text &str, font u32, size f32) Vec2
pub fn layout[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, m &mut F) {
  ui.stats = new Stats;
  layoutRoot(ui, ui.root, m);
  layoutRoot(ui, ui.overlay, m);
  updateGlobals(ui, ui.root, 0., 0.);
  updateGlobals(ui, ui.overlay, 0., 0.);
  refreshFields(ui, m);
  placeTooltip(ui, m);
}

fn layoutRoot[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, m &mut F) {
  let w = ui.nodes[id].prefW;
  let h = ui.nodes[id].prefH;
  measureNode(ui, id, w, w, h, h, m);
  ui.nodes[id].x = 0.;
  ui.nodes[id].y = 0.;
  arrangeNode(ui, id, w, h, m);
}

fn updateGlobals(ui &mut Ui, id usize, ox f32, oy f32) {
  ui.nodes[id].gx = ox + ui.nodes[id].x;
  ui.nodes[id].gy = oy + ui.nodes[id].y;
  var c = ui.nodes[id].first;
  while c != NIL {
    if ui.nodes[c].visible {updateGlobals(ui, c, ui.nodes[id].gx, ui.nodes[id].gy);}
    c = ui.nodes[c].next;
  }
}

// ---- text ----

fn textSize[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, m &mut F) Vec2 {
  let font = u32.from(ui.styleNum0(id, P_FONT, 0.));
  let size = ui.styleNum0(id, P_FONT_SIZE, 14.);
  if ui.nodes[id].tValid and ui.nodes[id].tFont == font and ui.nodes[id].tSize == size {
    return new Vec2(ui.nodes[id].tW, ui.nodes[id].tH);
  }
  let v = m(ui.texts[id].view(), font, size);
  ui.stats.textMeasures = ui.stats.textMeasures + 1u32;
  ui.nodes[id].tValid = true;
  ui.nodes[id].tFont = font;
  ui.nodes[id].tSize = size;
  ui.nodes[id].tW = v.x;
  ui.nodes[id].tH = v.y;
  v
}

// ---- measure ----

pub fn measureNode[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, cminW f32, cmaxW f32, cminH f32, cmaxH f32, m &mut F) Vec2 {
  if !ui.nodes[id].visible {return new Vec2(0., 0.);}
  if ui.nodes[id].cValid and (ui.nodes[id].dirty & D_MEASURE) == 0u32 and cacheFits(ui, id, cminW, cmaxW, cminH, cmaxH) {
    ui.stats.measureHits = ui.stats.measureHits + 1u32;
    if ui.nodes[id].cConstrained {ui.clampSeen = true;}
    return new Vec2(ui.nodes[id].cW, ui.nodes[id].cH);
  }
  ui.stats.measured = ui.stats.measured + 1u32;
  let outerClamp = ui.clampSeen;
  ui.clampSeen = false;
  let loW = clampf(ui.nodes[id].minW, cminW, cmaxW);
  let hiW = clampf(ui.nodes[id].maxW, loW, cmaxW);
  let loH = clampf(ui.nodes[id].minH, cminH, cmaxH);
  let hiH = clampf(ui.nodes[id].maxH, loH, cmaxH);
  let px = ui.padOf(id, 0u32) + ui.padOf(id, 2u32);
  let py = ui.padOf(id, 1u32) + ui.padOf(id, 3u32);
  let fixedW = ui.nodes[id].prefW >= 0.;
  let fixedH = ui.nodes[id].prefH >= 0.;
  var w = 0.;
  var h = 0.;
  var wantW = 0.;
  var wantH = 0.;
  if fixedW and fixedH {
    wantW = ui.nodes[id].prefW;
    wantH = ui.nodes[id].prefH;
  }
  else {
    var availW = hiW - px;
    var availH = hiH - py;
    if fixedW {availW = clampf(ui.nodes[id].prefW, loW, hiW) - px;}
    if fixedH {availH = clampf(ui.nodes[id].prefH, loH, hiH) - py;}
    let c = contentSize(ui, id, maxf(0., availW), maxf(0., availH), m);
    wantW = if fixedW {ui.nodes[id].prefW} else {c.x + px};
    wantH = if fixedH {ui.nodes[id].prefH} else {c.y + py};
  }
  w = clampf(wantW, loW, hiW);
  h = clampf(wantH, loH, hiH);
  // the answer depends on the bounds when a bound changed it, or a child was changed by one
  let constrained = ui.clampSeen or wantW > hiW or wantH > hiH or wantW < loW or wantH < loH;
  ui.nodes[id].cConstrained = constrained;
  ui.clampSeen = outerClamp or constrained;
  ui.nodes[id].cMinW = cminW;
  ui.nodes[id].cMaxW = cmaxW;
  ui.nodes[id].cMinH = cminH;
  ui.nodes[id].cMaxH = cmaxH;
  ui.nodes[id].cW = w;
  ui.nodes[id].cH = h;
  ui.nodes[id].cValid = true;
  ui.nodes[id].dirty = ui.nodes[id].dirty & (D_MEASURE ^ 4294967295u32);
  new Vec2(w, h)
}

// Whether the cached answer stands for these constraints. It does for the very same
// constraints, and for others that admit it when no bound shaped it: a node's size is its
// content's own unless a bound cut or raised it, or cut a child (the 'constrained' flag
// measureNode records), and a size that no bound shaped is the same under any bounds that allow it
fn cacheFits(ui &Ui, id usize, cminW f32, cmaxW f32, cminH f32, cmaxH f32) bool {
  let n = ui.nodes[id];
  if n.cMinW == cminW and n.cMaxW == cmaxW and n.cMinH == cminH and n.cMaxH == cmaxH {return true;}
  !n.cConstrained and n.cW >= cminW and n.cW <= cmaxW and n.cH >= cminH and n.cH <= cmaxH
}

// A child's size with its margins, measured loose inside 'availW' x 'availH'
fn measureOuter[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, availW f32, availH f32, m &mut F) Vec2 {
  let mw = ui.nodes[id].marL + ui.nodes[id].marR;
  let mh = ui.nodes[id].marT + ui.nodes[id].marB;
  let v = measureNode(ui, id, 0., maxf(0., availW - mw), 0., maxf(0., availH - mh), m);
  new Vec2(v.x + mw, v.y + mh)
}

// The size a node's content wants inside 'availW' x 'availH' (padding already taken off)
fn contentSize[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, availW f32, availH f32, m &mut F) Vec2 {
  let mode = ui.nodes[id].layout;
  if ui.nodes[id].first == NIL {
    return intrinsicSize(ui, id, m);
  }
  if mode == LK_ROW or mode == LK_COLUMN {return flexContent(ui, id, availW, availH, m);}
  if mode == LK_GRID {return gridContent(ui, id, availW, availH, m);}
  if mode == LK_DOCK {return dockContent(ui, id, availW, availH, m);}
  if mode == LK_SPLIT {return splitContent(ui, id, availW, availH, m);}
  if mode == LK_SCROLL {return scrollContent(ui, id, availW, availH, m);}
  // STACK, ANCHOR and ABS: the farthest extent of any child
  var cw = 0.;
  var ch = 0.;
  var c = ui.nodes[id].first;
  while c != NIL {
    if ui.nodes[c].visible {
      let o = measureOuter(ui, c, availW, availH, m);
      var ex = o.x;
      var ey = o.y;
      if mode == LK_ABS or ui.nodes[c].outOfFlow {
        ex = ui.nodes[c].absX + o.x;
        ey = ui.nodes[c].absY + o.y;
      }
      elif mode == LK_ANCHOR {
        ex = o.x + maxf(0., ui.nodes[c].offL);
        ey = o.y + maxf(0., ui.nodes[c].offT);
      }
      cw = maxf(cw, ex);
      ch = maxf(ch, ey);
    }
    c = ui.nodes[c].next;
  }
  new Vec2(cw, ch)
}

// What a node with no children wants: its text, plus a toggle's box
fn intrinsicSize[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, m &mut F) Vec2 {
  if ui.texts[id].len() == 0usize {
    if ui.nodes[id].kind == K_TOGGLE {
      let s = ui.styleNum0(id, P_SIZE, 20.);
      return new Vec2(s, s);
    }
    return new Vec2(0., 0.);
  }
  let t = textSize(ui, id, m);
  if ui.nodes[id].kind == K_TOGGLE {
    let s = ui.styleNum0(id, P_SIZE, 20.);
    return new Vec2(s + ui.gapOf(id) + t.x, maxf(s, t.y));
  }
  t
}

// ---- arrange ----

pub fn arrangeNode[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, w f32, h f32, m &mut F) {
  if !ui.nodes[id].visible {return;}
  let needs = (ui.nodes[id].dirty & (D_ARRANGE | D_MEASURE)) != 0u32 or !ui.nodes[id].aValid or ui.nodes[id].aW != w or ui.nodes[id].aH != h;
  ui.nodes[id].w = w;
  ui.nodes[id].h = h;
  if !needs {
    ui.stats.arrangeSkips = ui.stats.arrangeSkips + 1u32;
    if (ui.nodes[id].dirty & D_SUB) != 0u32 {
      var c = ui.nodes[id].first;
      while c != NIL {
        if ui.nodes[c].dirty != 0u32 and ui.nodes[c].visible {arrangeNode(ui, c, ui.nodes[c].w, ui.nodes[c].h, m);}
        c = ui.nodes[c].next;
      }
      ui.nodes[id].dirty = ui.nodes[id].dirty & (D_SUB ^ 4294967295u32);
    }
    return;
  }
  ui.stats.arranged = ui.stats.arranged + 1u32;
  let mode = ui.nodes[id].layout;
  if mode == LK_ROW or mode == LK_COLUMN {flexArrange(ui, id, w, h, m);}
  elif mode == LK_GRID {gridArrange(ui, id, w, h, m);}
  elif mode == LK_ANCHOR {anchorArrange(ui, id, w, h, m);}
  elif mode == LK_ABS {absArrange(ui, id, w, h, m);}
  elif mode == LK_DOCK {dockArrange(ui, id, w, h, m);}
  elif mode == LK_SPLIT {splitArrange(ui, id, w, h, m);}
  elif mode == LK_SCROLL {scrollArrange(ui, id, w, h, m);}
  else {stackArrange(ui, id, w, h, m);}
  placeOutOfFlow(ui, id, w, h, m);
  ui.nodes[id].aValid = true;
  ui.nodes[id].aW = w;
  ui.nodes[id].aH = h;
  ui.nodes[id].dirty = 0u32;
}

// Puts a child at (x, y) of its parent with a final size, and arranges it
fn place[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, c usize, x f32, y f32, w f32, h f32, m &mut F) {
  ui.nodes[c].x = x;
  ui.nodes[c].y = y;
  arrangeNode(ui, c, w, h, m);
}

fn isFlow(ui &Ui, c usize) bool {ui.nodes[c].visible and !ui.nodes[c].outOfFlow}

// Children taken out of the flow sit at (absX, absY) from the container's corner
fn placeOutOfFlow[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, w f32, h f32, m &mut F) {
  var c = ui.nodes[id].first;
  while c != NIL {
    if ui.nodes[c].visible and ui.nodes[c].outOfFlow {
      let v = measureNode(ui, c, 0., UNBOUNDED, 0., UNBOUNDED, m);
      place(ui, c, ui.nodes[c].absX, ui.nodes[c].absY, v.x, v.y, m);
    }
    c = ui.nodes[c].next;
  }
}

// LK_ABS: every child sits at its own (absX, absY) at its natural size, free to overflow
fn absArrange[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, w f32, h f32, m &mut F) {
  var c = ui.nodes[id].first;
  while c != NIL {
    if isFlow(ui, c) {
      let v = measureNode(ui, c, 0., UNBOUNDED, 0., UNBOUNDED, m);
      place(ui, c, ui.nodes[c].absX, ui.nodes[c].absY, v.x, v.y, m);
    }
    c = ui.nodes[c].next;
  }
}

// The content box of a node of size w x h, inside its padding: (left, top) and (width, height) as an Aabb2's min and max
fn inner(ui &Ui, id usize, w f32, h f32) Aabb2 {
  let l = ui.padOf(id, 0u32);
  let t = ui.padOf(id, 1u32);
  let iw = maxf(0., w - l - ui.padOf(id, 2u32));
  let ih = maxf(0., h - t - ui.padOf(id, 3u32));
  new Aabb2(new Vec2(l, t), new Vec2(iw, ih))
}

// Offset of a box of size 'size' in a space of 'space', aligned
fn alignedOffset(ui &Ui, align u32, space f32, size f32) f32 {
  if align == ALIGN_CENTER {(space - size) * 0.5}
  elif align == ALIGN_END {space - size}
  else {0.}
}

// ---- stack ----

fn stackArrange[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, w f32, h f32, m &mut F) {
  let box = inner(ui, id, w, h);
  let l = box.min.x;
  let t = box.min.y;
  let iw = box.max.x;
  let ih = box.max.y;
  var c = ui.nodes[id].first;
  while c != NIL {
    if isFlow(ui, c) {
      let ax = if ui.nodes[c].alignSelf != ALIGN_AUTO {ui.nodes[c].alignSelf} else {ui.nodes[id].alignItems};
      let ay = if ui.nodes[c].alignSelfY != ALIGN_AUTO {ui.nodes[c].alignSelfY} else {ui.nodes[id].alignItemsY};
      let mw = ui.nodes[c].marL + ui.nodes[c].marR;
      let mh = ui.nodes[c].marT + ui.nodes[c].marB;
      let nat = measureNode(ui, c, 0., maxf(0., iw - mw), 0., maxf(0., ih - mh), m);
      var cw = nat.x;
      var ch = nat.y;
      if ax == ALIGN_STRETCH and ui.nodes[c].prefW < 0. {cw = clampf(iw - mw, ui.nodes[c].minW, ui.nodes[c].maxW);}
      if ay == ALIGN_STRETCH and ui.nodes[c].prefH < 0. {ch = clampf(ih - mh, ui.nodes[c].minH, ui.nodes[c].maxH);}
      let x = l + ui.nodes[c].marL + alignedOffset(ui, ax, iw - mw, cw);
      let y = t + ui.nodes[c].marT + alignedOffset(ui, ay, ih - mh, ch);
      place(ui, c, x, y, cw, ch, m);
    }
    c = ui.nodes[c].next;
  }
}

// ---- flex: row and column ----

fn flexContent[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, availW f32, availH f32, m &mut F) Vec2 {
  let horiz = ui.nodes[id].layout == LK_ROW;
  let gap = ui.gapOf(id);
  var main = 0.;
  var cross = 0.;
  var count = 0usize;
  var c = ui.nodes[id].first;
  while c != NIL {
    if isFlow(ui, c) {
      let o = measureOuter(ui, c, availW, availH, m);
      var om = if horiz {o.x} else {o.y};
      let oc = if horiz {o.y} else {o.x};
      if ui.nodes[c].basis >= 0. {
        let mm = if horiz {ui.nodes[c].marL + ui.nodes[c].marR} else {ui.nodes[c].marT + ui.nodes[c].marB};
        om = ui.nodes[c].basis + mm;
      }
      main = main + om;
      cross = maxf(cross, oc);
      count = count + 1usize;
    }
    c = ui.nodes[c].next;
  }
  if count > 1usize {main = main + gap * f32.from(count - 1usize);}
  if horiz {new Vec2(main, cross)} else {new Vec2(cross, main)}
}

fn flexArrange[F fn(text &str, font u32, size f32) Vec2](ui &mut Ui, id usize, w f32, h f32, m &mut F) {
  let horiz = ui.nodes[id].layout == LK_ROW;
  let gap = ui.gapOf(id);
  let box = inner(ui, id, w, h);
  let l = box.min.x;
  let t = box.min.y;
  let iw = box.max.x;
  let ih = box.max.y;
  let innerMain = if horiz {iw} else {ih};
  let innerCross = if horiz {ih} else {iw};

  var kids = List[usize].empty();
  var base = List[f32].empty();      // flex base size (border box, main axis)
  var hyp = List[f32].empty();       // base clamped by min and max
  var mar = List[f32].empty();       // margins on the main axis
  var lo = List[f32].empty();
  var hi = List[f32].empty();
  var c = ui.nodes[id].first;
  while c != NIL {
    if isFlow(ui, c) {
      let o = measureOuter(ui, c, iw, ih, m);
      let mm = if horiz {ui.nodes[c].marL + ui.nodes[c].marR} else {ui.nodes[c].marT + ui.nodes[c].marB};
      let nat = (if horiz {o.x} else {o.y}) - mm;
      let b = if ui.nodes[c].basis >= 0. {ui.nodes[c].basis} else {nat};
      let mn = if horiz {ui.nodes[c].minW} else {ui.nodes[c].minH};
      let mx = if horiz {ui.nodes[c].maxW} else {ui.nodes[c].maxH};
      kids.push(c);
      base.push(b);
      hyp.push(clampf(b, mn, mx));
      mar.push(mm);
      lo.push(mn);
      hi.push(mx);
    }
    c = ui.nodes[c].next;
  }
  let n = kids.len();
  if n == 0usize {return;}
  var target = List[f32].empty();
  var frozen = List[bool].empty();
  var sumHyp = 0.;
  var i = 0usize;
  while i < n {
    sumHyp = sumHyp + *hyp[i] + *mar[i];
    target.push(*hyp[i]);
    frozen.push(false);
    i = i + 1usize;
  }
  let gaps = gap * f32.from(n - 1usize);
  let initialFree = innerMain - gaps - sumHyp;
  let growing = initialFree >= 0.;
  // 9.7 steps 3 and 4: freeze the inflexible, then loop
  i = 0usize;
  while i < n {
    let k = *kids[i];
    let factor = if growing {ui.nodes[k].grow} else {ui.nodes[k].shrink};
    if factor == 0. or (growing and *base[i] > *hyp[i]) or (!growing and *base[i] < *hyp[i]) {
      frozen.set(i, true);
    }
    i = i + 1usize;
  }
  var guard = 0usize;
  while guard <= n {
    guard = guard + 1usize;
    var unfrozen = 0usize;
    var frozenSum = 0.;
    var unfrozenBase = 0.;
    var sumGrow = 0.;
    var sumScaled = 0.;
    i = 0usize;
    while i < n {
      let k = *kids[i];
      if *frozen[i] {frozenSum = frozenSum + *target[i] + *mar[i];}
      else {
        unfrozen = unfrozen + 1usize;
        unfrozenBase = unfrozenBase + *base[i] + *mar[i];
        sumGrow = sumGrow + ui.nodes[k].grow;
        sumScaled = sumScaled + ui.nodes[k].shrink * *base[i];
      }
      i = i + 1usize;
    }
    if unfrozen == 0usize {break;}
    var free = innerMain - gaps - frozenSum - unfrozenBase;
    if growing and sumGrow < 1. {
      let limited = initialFree * sumGrow;
      if limited < free {free = limited;}
    }
    i = 0usize;
    while i < n {
      if !*frozen[i] {
        let k = *kids[i];
        var tgt = *base[i];
        if growing {
          if sumGrow > 0. {tgt = *base[i] + free * ui.nodes[k].grow / sumGrow;}
        }
        else {
          if sumScaled > 0. {tgt = *base[i] + free * (ui.nodes[k].shrink * *base[i]) / sumScaled;}
        }
        target.set(i, tgt);
      }
      i = i + 1usize;
    }
    // clamp and total the violations
    var total = 0.;
    var clampedList = List[f32].empty();
    i = 0usize;
    while i < n {
      let tg = *target[i];
      if !*frozen[i] {
        let cl = clampf(tg, *lo[i], *hi[i]);
        total = total + (cl - tg);
        clampedList.push(cl);
      }
      else {clampedList.push(tg);}
      i = i + 1usize;
    }
    i = 0usize;
    while i < n {
      if !*frozen[i] {
        let tg = *target[i];
        let cl = *clampedList[i];
        if total == 0. or (total > 0. and cl > tg) or (total < 0. and cl < tg) {
          frozen.set(i, true);
          target.set(i, cl);
        }
        else {target.set(i, tg);}
      }
      i = i + 1usize;
    }
    if total == 0. {break;}
  }
  // main-axis positions
  var used = gaps;
  i = 0usize;
  while i < n {
    used = used + *target[i] + *mar[i];
    i = i + 1usize;
  }
  let left = innerMain - used;
  var startOff = 0.;
  var extra = 0.;
  if left > 0. {
    let jf = ui.nodes[id].justify;
    if jf == JUSTIFY_CENTER {startOff = left * 0.5;}
    elif jf == JUSTIFY_END {startOff = left;}
    elif jf == JUSTIFY_BETWEEN {if n > 1usize {extra = left / f32.from(n - 1usize);}}
    elif jf == JUSTIFY_AROUND {
      extra = left / f32.from(n);
      startOff = extra * 0.5;
    }
    elif jf == JUSTIFY_EVENLY {
      extra = left / f32.from(n + 1usize);
      startOff = extra;
    }
  }
  var pos = (if horiz {l} else {t}) + startOff;
  i = 0usize;
  while i < n {
    let k = *kids[i];
    let tm = *target[i];
    let marStart = if horiz {ui.nodes[k].marL} else {ui.nodes[k].marT};
    let crossMar = if horiz {ui.nodes[k].marT + ui.nodes[k].marB} else {ui.nodes[k].marL + ui.nodes[k].marR};
    let crossStart = if horiz {ui.nodes[k].marT} else {ui.nodes[k].marL};
    let align = if ui.nodes[k].alignSelf != ALIGN_AUTO {ui.nodes[k].alignSelf} else {ui.nodes[id].alignItems};
    let prefCross = if horiz {ui.nodes[k].prefH} else {ui.nodes[k].prefW};
    let minCross = if horiz {ui.nodes[k].minH} else {ui.nodes[k].minW};
    let maxCross = if horiz {ui.nodes[k].maxH} else {ui.nodes[k].maxW};
    var crossSize = 0.;
    if align == ALIGN_STRETCH and prefCross < 0. {
      crossSize = clampf(maxf(0., innerCross - crossMar), minCross, maxCross);
    }
    else {
      let v = if horiz {measureNode(ui, k, tm, tm, 0., maxf(0., innerCross - crossMar), m)}
              else {measureNode(ui, k, 0., maxf(0., innerCross - crossMar), tm, tm, m)};
      crossSize = if horiz {v.y} else {v.x};
    }
    let crossOff = alignedOffset(ui, align, innerCross - crossMar, crossSize);
    let mainPos = pos + marStart;
    let crossPos = (if horiz {t} else {l}) + crossStart + crossOff;
    if horiz {place(ui, k, mainPos, crossPos, tm, crossSize, m);}
    else {place(ui, k, crossPos, mainPos, crossSize, tm, m);}
    pos = pos + tm + *mar[i] + gap + extra;
    i = i + 1usize;
  }
}
