// A panel in the world, with the ray-to-pixel mapping worked out by hand.
//
// A panel of 200 x 100 pixels, 2 m wide (so 1 m tall, 100 px to the metre), centred at (0, 1, -2) and
// facing +z (the identity rotation).
//   A ray from (0, 1, 0) along -z hits the middle: pixel (100, 50) at t = 2.
//   A ray from (0.5, 1.25, 0) along -z: local (0.5, 0.25): u = 0.5/2 + 0.5 = 0.75, v = 0.5 - 0.25/1 = 0.25
//   -> pixel (150, 25).
//   The corners are at (-1, 1.5, -2) top left, (1, 1.5, -2), (1, 0.5, -2), (-1, 0.5, -2).
//   A ray from behind (0, 1, -4) along +z misses a single-sided panel and hits a double-sided one.
//   A ray along the plane misses; a ray past the edge (x = 1.2) misses; maxT shorter than 2 misses.
// Turned a quarter turn about +y the panel faces +x and its right is -z. Put at (3, 1, 0), a ray from
//   (6, 1, -0.5) along -x hits local x = +0.5: pixel x = 150, y = 50, at t = 3. The same panel is
//   missed by a ray from (0, 1, -0.5) along +x, which comes from behind.
// The Ui inside works as a screen does: a button laid out in it is pressed by a ray, hover and click.

mod panel3d;

import testing use *;
import geomath use *;
import collections use *;
import uilayout use *;

fn near(got: f32, want: f32, label: &Array[u8]) {
  expectFloat(f64.from(got), f64.from(want), 0.001, label);
}

fn main() i32 {
  var m = fn(t: &str, font: u32, size: f32) Vec2 { Vec2(f32.from(t.len()) * 8., 16.) };
  var p = Panel3d.make(200., 100., 2., Transform3(Vec3(0., 1., -2.), Quat.identity(), Vec3(1., 1., 1.)));
  near(p.heightMeters, 1., "the height follows the pixel shape");

  match p.pick(Ray3(Vec3(0., 1., 0.), Vec3(0., 0., -1.)), 100.) {
    case Some(h) {
      near(h.t, 2., "centre: t");
      near(h.x, 100., "centre: x");
      near(h.y, 50., "centre: y");
    }
    else { expect(false, "the centre ray hits"); }
  }
  match p.pick(Ray3(Vec3(0.5, 1.25, 0.), Vec3(0., 0., -1.)), 100.) {
    case Some(h) {
      near(h.x, 150., "off centre: x");
      near(h.y, 25., "off centre: y (up is toward the top)");
      near(h.u, 0.75, "off centre: u");
      near(h.v, 0.25, "off centre: v");
    }
    else { expect(false, "the off-centre ray hits"); }
  }
  let c = p.corners();
  near(c[0usize].x, -1., "top left x");
  near(c[0usize].y, 1.5, "top left y");
  near(c[2usize].x, 1., "bottom right x");
  near(c[2usize].y, 0.5, "bottom right y");
  near(c[3usize].z, -2., "on the plane");
  near(p.pixelToWorld(100., 50.).y, 1., "pixel to world: the centre");

  match p.pick(Ray3(Vec3(0., 1., -4.), Vec3(0., 0., 1.)), 100.) {
    case is Some { expect(false, "a single-sided panel is missed from behind"); }
    else {}
  }
  p.doubleSided = true;
  match p.pick(Ray3(Vec3(0., 1., -4.), Vec3(0., 0., 1.)), 100.) {
    case Some(h) { near(h.x, 100., "double sided: hit from behind"); }
    else { expect(false, "a double-sided panel is hit from behind"); }
  }
  p.doubleSided = false;
  match p.pick(Ray3(Vec3(0., 1., 0.), Vec3(1., 0., 0.)), 100.) {
    case is Some { expect(false, "a ray along the plane's normal's perpendicular misses"); }
    else {}
  }
  match p.pick(Ray3(Vec3(1.2, 1., 0.), Vec3(0., 0., -1.)), 100.) {
    case is Some { expect(false, "past the edge misses"); }
    else {}
  }
  match p.pick(Ray3(Vec3(0., 1., 0.), Vec3(0., 0., -1.)), 1.5) {
    case is Some { expect(false, "a short ray misses"); }
    else {}
  }

  // turned to face +x
  let turned = Transform3(Vec3(3., 1., 0.), Quat.angleAxis(pi / 2., Vec3(0., 1., 0.)), Vec3(1., 1., 1.));
  var q = Panel3d.make(200., 100., 2., turned);
  near(q.normal().x, 1., "turned: it faces +x");
  match q.pick(Ray3(Vec3(6., 1., -0.5), Vec3(-1., 0., 0.)), 100.) {
    case Some(h) {
      near(h.t, 3., "turned: t");
      near(h.x, 150., "turned: local +x is world -z, so z = -0.5 is right of centre");
      near(h.y, 50., "turned: y");
    }
    else { expect(false, "the turned panel is hit from the front"); }
  }
  match q.pick(Ray3(Vec3(0., 1., -0.5), Vec3(1., 0., 0.)), 100.) {
    case is Some { expect(false, "the turned panel is missed from behind"); }
    else {}
  }

  // the Ui inside
  let b = button(&mut p.ui, p.ui.root, "Go");
  p.ui.setAnchors(b, 0.5, 0.5, 0.5, 0.5);
  p.ui.setPivot(b, 0.5, 0.5);
  layout(&mut p.ui, &mut m);
  expect(p.pointerFromRay(Ray3(Vec3(0., 1., 0.), Vec3(0., 0., -1.)), 100.), "the pointer reaches the panel");
  expect(p.ui.hasState(b, ST_HOVER), "the button under the ray is hovered");
  pointerDown(&mut p.ui, BTN_LEFT);
  pointerUp(&mut p.ui, BTN_LEFT);
  let evs = p.ui.takeEvents();
  var clicks = 0;
  var i = 0usize;
  while i < evs.len() {
    if evs[i].kind == UE_CLICK && evs[i].node == b {clicks = clicks + 1;}
    i = i + 1usize;
  }
  expectInt(i64.from(clicks), 1i64, "a click by ray reaches the button");
  expect(!p.pointerFromRay(Ray3(Vec3(5., 1., 0.), Vec3(0., 0., -1.)), 100.), "a ray that misses");
  expect(!p.ui.hasState(b, ST_HOVER), "and the hover ends");
  done()
}
