// Widget rows: a widget's row in its kind's table is freed with its node and reused by the next
// widget of that kind, so creating and destroying in a loop holds the tables at a steady size.

mod rows;

import testing use *;
import collections use *;
import uilayout use *;

fn main() i32 {
  var ui = Ui.make(800., 600.);
  // N sliders, made and destroyed one at a time
  var i = 0;
  while i < 50 {
    let s = slider(&mut ui, ui.root, 0., 10., 3., 0.);
    ui.destroy(s);
    i = i + 1;
  }
  expectInt(i64.from(ui.sliders.len()), 1i64, "50 sliders made and destroyed: one row");
  // the same for the other kinds
  let pack = ui.inv.makeContainer(4u32, 0u32);
  i = 0;
  while i < 50 {
    let t = toggle(&mut ui, ui.root, "t", true);
    let f = textField(&mut ui, ui.root, "hello");
    let k = knob(&mut ui, ui.root, 0., 1., 0.5, 0.);
    let w = window(&mut ui, "w", 0., 0., 200., 100.);
    let tb = tabs(&mut ui, ui.root);
    addTab(&mut ui, tb, "one");
    let l = listBox(&mut ui, ui.root);
    let m = minimap(&mut ui, ui.root, 64., 1u32);
    let g = inventoryGrid(&mut ui, ui.root, pack, 2u32);
    ui.destroy(t); ui.destroy(f); ui.destroy(k); ui.destroy(w); ui.destroy(tb); ui.destroy(l); ui.destroy(m);
    ui.destroy(g);
    i = i + 1;
  }
  expectInt(i64.from(ui.toggles.len()), 1i64, "toggles steady");
  expectInt(i64.from(ui.fields.len()), 1i64, "fields steady");
  expectInt(i64.from(ui.knobs.len()), 1i64, "knobs steady");
  expectInt(i64.from(ui.windows.len()), 1i64, "windows steady");
  expectInt(i64.from(ui.tabsets.len()), 1i64, "tabsets steady");
  expectInt(i64.from(ui.tabpages.len()), 0i64, "a tab set's pages go with it");
  expectInt(i64.from(ui.lists.len()), 1i64, "lists steady");
  expectInt(i64.from(ui.minimaps.len()), 1i64, "minimaps steady");
  expectInt(i64.from(ui.slots.len()), 4i64, "slots steady: the 4 of one grid");

  // widgets made after a destroy work, and two live at once do not share a row
  let a = slider(&mut ui, ui.root, 0., 10., 3., 0.);
  let b = slider(&mut ui, ui.root, 0., 100., 40., 0.);
  expectFloat(f64.from(sliderValue(&ui, a)), 3., 0.001, "a reused row holds the new slider's value");
  expectFloat(f64.from(sliderValue(&ui, b)), 40., 0.001, "and the next one its own");
  ui.destroy(a);
  let c = slider(&mut ui, ui.root, 0., 1., 0.25, 0.);
  expectFloat(f64.from(sliderValue(&ui, c)), 0.25, 0.001, "a row freed in the middle is reused");
  expectFloat(f64.from(sliderValue(&ui, b)), 40., 0.001, "and the slider still alive is untouched");
  expectInt(i64.from(ui.sliders.len()), 2i64, "two live sliders, two rows");

  // a field reusing a row is the only one the scan finds for its node
  let f1 = textField(&mut ui, ui.root, "abc");
  ui.destroy(f1);
  let f2 = textField(&mut ui, ui.root, "wxyz");
  expectInt(i64.from(ui.fields[ui.nodes[f2].data].caret), 4i64, "a reused field row is the new field's");
  expectInt(i64.from(ui.fields[ui.nodes[f2].data].node), i64.from(f2), "and names its node");

  // markers: clearing frees rows in place; live handles keep their value; the next markers reuse the rows
  let mm = minimap(&mut ui, ui.root, 100., 1u32);
  let mm2 = minimap(&mut ui, ui.root, 100., 1u32);
  let m0 = minimapAddMarker(&mut ui, mm, 0.1, 0.1, 0xff0000ffu32, 6.);
  let m1 = minimapAddMarker(&mut ui, mm2, 0.2, 0.2, 0xff0000ffu32, 6.);
  let m2 = minimapAddMarker(&mut ui, mm, 0.3, 0.3, 0xff0000ffu32, 6.);
  minimapClearMarkers(&mut ui, mm);
  expectInt(i64.from(ui.markers.len()), 3i64, "clearing keeps every row in place");
  expectFloat(f64.from(ui.markers[m1].u), 0.2, 0.001, "a live marker keeps its handle");
  let m3 = minimapAddMarker(&mut ui, mm2, 0.4, 0.4, 0xff0000ffu32, 6.);
  let m4 = minimapAddMarker(&mut ui, mm2, 0.5, 0.5, 0xff0000ffu32, 6.);
  expectInt(i64.from(ui.markers.len()), 3i64, "two new markers reuse the two freed rows");
  expectInt(i64.from(m3 != m1 && m4 != m1 && m3 != m4), 1i64, "and none shares the live marker's row");
  expectFloat(f64.from(ui.markers[m1].u), 0.2, 0.001, "the live marker is untouched");
  // destroying the minimap frees its markers
  ui.destroy(mm2);
  var live = 0;
  var k = 0usize;
  while k < ui.markers.len() {
    if ui.markers[k].owner != NIL {live = live + 1;}
    k = k + 1usize;
  }
  expectInt(i64.from(live), 0i64, "a destroyed minimap leaves no live markers");
  var j = 0;
  while j < 50 {
    let mmx = minimap(&mut ui, ui.root, 100., 1u32);
    minimapAddMarker(&mut ui, mmx, 0.5, 0.5, 0xff0000ffu32, 6.);
    ui.destroy(mmx);
    j = j + 1;
  }
  expectInt(i64.from(ui.markers.len()), 3i64, "50 minimaps with a marker each: the table holds steady");

  // hotbars drop destroyed ids
  let bar = hotbar(&mut ui, ui.root, 3u32);
  let bar2 = hotbar(&mut ui, ui.root, 3u32);
  expectInt(i64.from(ui.input.hotbars.len()), 2i64, "two bars");
  ui.destroy(bar);
  expectInt(i64.from(ui.input.hotbars.len()), 1i64, "a destroyed bar's id is dropped");
  expectInt(i64.from(*ui.input.hotbars[0] == bar2), 1i64, "and the live bar's stays");
  let outer = ui.create(ui.root, K_PLAIN);
  hotbar(&mut ui, outer, 2u32);
  expectInt(i64.from(ui.input.hotbars.len()), 2i64, "a bar inside a panel");
  ui.destroy(outer);
  expectInt(i64.from(ui.input.hotbars.len()), 1i64, "destroying the panel above a bar drops it too");
  done()
}
