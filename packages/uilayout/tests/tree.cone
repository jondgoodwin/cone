// The tree's links and what dies with a node. Built by hand:
//
//   root's children a, b, c. insertBefore(d, b) gives a d b c. detach(b) gives a d c and b has no
//   parent; appending b to d makes b a descendant of d and of root. raise(a) moves a last: d c a.
//   destroy(d) frees d and b; the next node made reuses d's id (the free list is last in, first out) and
//   is a clean node: alive, no children, no parent until it is placed, default properties.
//   Destroying the focused node blurs; destroying a node takes its listeners with it; destroying the
//   source of a drag ends the drag.
//   Adding a child of fixed size to a parent of fixed size relays out the parent's children but
//   measures nothing but the child (the parent is a relayout boundary): 1 measured; the parent and the
//   child are arranged (2), the root is only passed through.

mod tree;

import testing use *;
import geomath use *;
import collections use *;
import uilayout use *;

fn order(ui &Ui, parent usize) String {
  var s = String.empty();
  var c = ui.firstChild(parent);
  while c != NIL {
    s.appendInt(i64.from(c));
    s.append(" ");
    c = ui.nextSibling(c);
  }
  s
}

fn main() i32 {
  var m = fn(t &str, font u32, size f32) Vec2 { new Vec2(f32.from(t.len()) * 8., 16.) };
  var ui = Ui.make(800., 600.);
  let a = ui.create(ui.root, K_PLAIN);
  let b = ui.create(ui.root, K_PLAIN);
  let c = ui.create(ui.root, K_PLAIN);
  expectInt(i64.from(ui.childCount(ui.root)), 3i64, "three children");
  expectInt(i64.from(ui.childAt(ui.root, 1usize)), i64.from(b), "the second child is b");
  let d = ui.create(0usize, K_PLAIN);
  expectInt(i64.from(ui.parentOf(d)), 0i64, "a node made with no parent has none");
  ui.insertBefore(ui.root, d, b);
  var got = String.empty();
  got.appendInt(i64.from(a)); got.append(" ");
  got.appendInt(i64.from(d)); got.append(" ");
  got.appendInt(i64.from(b)); got.append(" ");
  got.appendInt(i64.from(c)); got.append(" ");
  expectStr(order(&ui, ui.root).view(), got.view(), "insertBefore puts d before b");
  ui.detach(b);
  expectInt(i64.from(ui.parentOf(b)), 0i64, "detached: no parent");
  expectInt(i64.from(ui.childCount(ui.root)), 3i64, "detached: root has three left (a d c)");
  ui.append(d, b);
  expect(ui.isWithin(b, d) and ui.isWithin(b, ui.root) and !ui.isWithin(d, b), "b is below d and root, d is not below b");
  ui.raise(a);
  expectInt(i64.from(ui.nodes[ui.root].last), i64.from(a), "raise: a is last");
  expectInt(i64.from(ui.nodes[ui.root].first), i64.from(d), "raise: d is first");

  // listener and focus die with the node
  ui.nodes[b].focusable = true;
  focusSet(&mut ui, b);
  expectInt(i64.from(ui.input.focus), i64.from(b), "b is focused");
  listen(&mut ui, b, EK_CLICK, LP_BUBBLE, 5u32, 0u32);
  expectInt(i64.from(ui.input.listeners.len()), 1i64, "a listener is registered");
  ui.destroy(d);
  expectInt(i64.from(ui.input.focus), 0i64, "destroying the focused node's ancestor blurs");
  expectInt(i64.from(ui.input.listeners.len()), 0i64, "the listener went with b");
  expect(!ui.alive(d) and !ui.alive(b), "d and b are dead");
  let e = ui.create(ui.root, K_LABEL);
  expectInt(i64.from(e), i64.from(d), "the next node reuses d's id");
  expect(ui.alive(e) and ui.childCount(e) == 0usize and ui.nodes[e].kind == K_LABEL, "and it is a clean node");
  expectInt(i64.from(ui.nodes[e].first), 0i64, "no children carried over");

  // destroying a drag source cancels the drag
  let s = ui.create(ui.root, K_PLAIN);
  ui.setLayout(s, LK_ANCHOR);
  ui.setOffsets(s, 100., 100., 0., 0.);
  ui.setSize(s, 40., 40.);
  ui.nodes[s].pointer = PM_STOP;
  setDragSource(&mut ui, s, 9u32, 1u32, 2u32);
  layout(&mut ui, &mut m);
  pointerMove(&mut ui, 120., 120.);
  pointerDown(&mut ui, BTN_LEFT);
  pointerMove(&mut ui, 300., 300.);
  expect(isDragging(&ui), "a drag is under way");
  ui.destroy(s);
  expect(!isDragging(&ui), "destroying its source ends it");
  pointerUp(&mut ui, BTN_LEFT);

  // a fixed-size child added to a fixed-size parent
  var ui2 = Ui.make(800., 600.);
  let p = ui2.create(ui2.root, K_PLAIN);
  ui2.setSize(p, 200., 200.);
  ui2.setFlex(p, LK_COLUMN, 0.);
  let k = ui2.create(p, K_PLAIN);
  ui2.setSize(k, 50., 50.);
  layout(&mut ui2, &mut m);
  let k2 = ui2.create(p, K_PLAIN);
  ui2.setSize(k2, 50., 50.);
  layout(&mut ui2, &mut m);
  expectInt(i64.from(ui2.stats.measured), 1i64, "only the new child is measured");
  expectInt(i64.from(ui2.stats.arranged), 2i64, "the parent and the new child are arranged (the root is only passed through)");
  expectFloat(f64.from(ui2.nodes[k2].y), 50., 0.01, "and the new child is placed after the first");

  // toggling visibility and removing
  ui2.setVisible(k, false);
  layout(&mut ui2, &mut m);
  expectFloat(f64.from(ui2.nodes[k2].y), 0., 0.01, "a hidden node leaves no gap");
  ui2.setVisible(k, true);
  layout(&mut ui2, &mut m);
  expectFloat(f64.from(ui2.nodes[k2].y), 50., 0.01, "and a shown one takes its place again");
  done()
}
