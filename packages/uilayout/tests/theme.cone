// Theme state resolution, by the rule in theme.cone: the value whose state mask is a subset of
// the node's state and has the most bits wins; a tie goes to the nearest style, and within one
// style to the one set last.
//
// A small theme:   base:   fg white, fg disabled grey, pad 6
//                  button (parent base): bg 0x10 base, hover 0x20, pressed 0x30, hover+pressed 0x40
//                  danger (parent button): bg 0x90 base
//                  danger2 (parent button): bg 0x91 base, and its own hover 0x92
//
//   button, no state              -> 0x10      button, hover            -> 0x20
//   button, pressed               -> 0x30      button, hover + pressed  -> 0x40 (two bits beat one)
//   button, focused only          -> 0x10      (no focused variant: the base)
//   button, hover + focused       -> 0x20      (the hover variant's mask is a subset)
//   danger, no state              -> 0x90      (its own base is nearer than button's base)
//   danger, hover                 -> 0x20      (a state variant beats any base)
//   danger2, hover                -> 0x92      (same bits, the nearer style wins)
//   danger2 set twice: the later setting wins
//   fg of a disabled danger       -> grey (inherited through two parents); pad 6 inherited
//   an unset property             -> the caller's fallback
// And with the standard theme on live nodes: a button under the pointer reads the hover fill,
// pressed while the button is down, disabled once disabled, and focused after Tab.

mod theme;

import testing use *;
import geomath use *;
import collections use *;
import uilayout use *;

fn main() i32 {
  {
  var t = Theme.empty();
  let base = t.style("base", 0usize);
  t.setColor(base, P_FG, 0u32, 0xffffffffu32);
  t.setColor(base, P_FG, ST_DISABLED, 0x808080ffu32);
  t.setNum(base, P_PAD, 0u32, 6.);
  let button = t.style("button", base);
  t.setColor(button, P_BG, 0u32, 0x10u32);
  t.setColor(button, P_BG, ST_HOVER, 0x20u32);
  t.setColor(button, P_BG, ST_PRESSED, 0x30u32);
  t.setColor(button, P_BG, ST_HOVER | ST_PRESSED, 0x40u32);
  let danger = t.style("danger", button);
  t.setColor(danger, P_BG, 0u32, 0x90u32);
  let danger2 = t.style("danger2", button);
  t.setColor(danger2, P_BG, 0u32, 0x91u32);
  t.setColor(danger2, P_BG, ST_HOVER, 0x92u32);

  expectUInt(u64.from(t.color(button, P_BG, 0u32, 0u32)), 0x10u64, "button");
  expectUInt(u64.from(t.color(button, P_BG, ST_HOVER, 0u32)), 0x20u64, "button hover");
  expectUInt(u64.from(t.color(button, P_BG, ST_PRESSED, 0u32)), 0x30u64, "button pressed");
  expectUInt(u64.from(t.color(button, P_BG, ST_HOVER | ST_PRESSED, 0u32)), 0x40u64, "two bits beat one");
  expectUInt(u64.from(t.color(button, P_BG, ST_FOCUSED, 0u32)), 0x10u64, "focused only: the base");
  expectUInt(u64.from(t.color(button, P_BG, ST_HOVER | ST_FOCUSED, 0u32)), 0x20u64, "hover + focused: the hover variant");
  expectUInt(u64.from(t.color(danger, P_BG, 0u32, 0u32)), 0x90u64, "danger base");
  expectUInt(u64.from(t.color(danger, P_BG, ST_HOVER, 0u32)), 0x20u64, "a state variant beats a nearer base");
  expectUInt(u64.from(t.color(danger2, P_BG, ST_HOVER, 0u32)), 0x92u64, "the nearer style wins a tie");
  expectUInt(u64.from(t.color(danger2, P_BG, 0u32, 0u32)), 0x91u64, "danger2 base");
  t.setColor(danger2, P_BG, 0u32, 0x93u32);
  expectUInt(u64.from(t.color(danger2, P_BG, 0u32, 0u32)), 0x93u64, "the later setting wins within a style");
  expectUInt(u64.from(t.color(danger, P_FG, ST_DISABLED, 0u32)), 0x808080ffu64, "disabled foreground inherited from base");
  expectUInt(u64.from(t.color(danger, P_FG, 0u32, 0u32)), 0xffffffffu64, "foreground inherited");
  expectFloat(f64.from(t.num(danger, P_PAD, 0u32, 99.)), 6., 0.001, "pad inherited through two parents");
  expectUInt(u64.from(t.color(danger, P_BORDER, 0u32, 0x1234u32)), 0x1234u64, "an unset property falls back");
  expectInt(i64.from(t.find("danger")), i64.from(danger), "lookup by name");
  expectInt(i64.from(t.find("nope")), 0i64, "an unknown name is 0");
  expectInt(i64.from(t.style("button", base)), i64.from(button), "naming a style again returns it");

  }

  // live nodes, the standard theme
  var m = fn(s &str, font u32, size f32) Vec2 { new Vec2(f32.from(s.len()) * 8., 16.) };
  var ui = Ui.make(400., 300.);
  let row = ui.create(ui.root, K_PLAIN);
  ui.setFlex(row, LK_ROW, 8.);
  let b = button(&mut ui, row, "OK");
  let b2 = button(&mut ui, row, "Other");
  layout(&mut ui, &mut m);
  let face = ui.theme.color(ui.nodes[b].style, P_BG, 0u32, 0u32);
  let hover = ui.theme.color(ui.nodes[b].style, P_BG, ST_HOVER, 0u32);
  expect(face != hover, "the standard theme has a hover fill");
  expectUInt(u64.from(ui.styleColor(b, P_BG, 0u32)), u64.from(face), "idle button reads its face");
  pointerMove(&mut ui, ui.nodes[b].gx + 5., ui.nodes[b].gy + 5.);
  expectUInt(u64.from(ui.styleColor(b, P_BG, 0u32)), u64.from(hover), "hovered button reads the hover fill");
  expectUInt(u64.from(ui.styleColor(b2, P_BG, 0u32)), u64.from(face), "the other button is unaffected");
  pointerDown(&mut ui, BTN_LEFT);
  expect(ui.hasState(b, ST_PRESSED), "pressed while down");
  expectUInt(u64.from(ui.styleColor(b, P_BG, 0u32)), u64.from(ui.theme.color(ui.nodes[b].style, P_BG, ST_HOVER | ST_PRESSED, 0u32)), "pressed+hover fill");
  pointerUp(&mut ui, BTN_LEFT);
  expect(!ui.hasState(b, ST_PRESSED), "released");
  expect(ui.hasState(b, ST_FOCUSED), "a button pressed is focused");
  ui.setEnabled(b2, false);
  expectUInt(u64.from(ui.styleColor(b2, P_FG, 0u32)), u64.from(ui.theme.color(ui.nodes[b2].style, P_FG, ST_DISABLED, 0u32)), "disabled text");
  let clicks = ui.takeEvents();
  var n = 0;
  var i = 0usize;
  while i < clicks.len() {
    if clicks[i].kind == UE_CLICK && clicks[i].node == b {n = n + 1;}
    i = i + 1usize;
  }
  expectInt(i64.from(n), 1i64, "one click reported for the button");
  // a disabled button takes no click
  pointerMove(&mut ui, ui.nodes[b2].gx + 5., ui.nodes[b2].gy + 5.);
  pointerDown(&mut ui, BTN_LEFT);
  pointerUp(&mut ui, BTN_LEFT);
  expectInt(i64.from(ui.takeEvents().len()), 0i64, "a disabled button reports nothing");
  done()
}
