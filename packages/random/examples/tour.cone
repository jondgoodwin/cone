// A seeded generator, dice, a shuffled deck, a normal number, and a generator
// seeded from the OS. The same seed prints the same lines on every machine.
//
//   congo run examples/tour.cone

mod tour;

import stdio use *;
import collections use *;
import random;

fn main() i32 {
  var rng = random.Rng.fromSeed(42u64);

  // A die, 1 to 6 with no modulo bias, and a number in [-10, 10): 1 and -3
  printStr("die ");
  printInt(i64.from(rng.below(6u64)) + 1i64);
  printStr(", range ");
  printInt(rng.rangeI64(-10i64, 10i64));
  printStr("\n");

  // A shuffled order of five cards: indexes 0 to 4
  let order = rng.permutation(5usize);
  printStr("order");
  var i = 0usize;
  while i < order.len() {
    printStr(" ");
    printInt(i64.from(*order[i]));
    i = i + 1usize;
  }
  printStr("\n");

  // A number in [0, 1) and a normal one
  printStr("unit ");
  printFloat(rng.unit());
  printStr(", normal ");
  printFloat(rng.normal());
  printStr("\n");

  // Seeded from the OS: different on every run, so only the shape is printed
  match random.Rng.fromEntropy() {
    case Some(var fresh) {
      let roll = fresh.rangeI64(1i64, 7i64);
      if roll >= 1i64 && roll <= 6i64 { printStr("entropy die in 1..6\n"); }
    }
    case is None { printStr("the OS gave no entropy\n"); }
  }
  0i32
}
