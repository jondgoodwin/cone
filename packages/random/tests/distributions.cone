// Normal (Marsaglia polar) and exponential (inversion) numbers, and the
// logarithm they are made with.
//
// The pins are BIT PATTERNS from an independent Python transcription of the
// same operations. They hold on any machine whose compiler runs each float
// operation separately and in the order written, which conec does on x86-64
// (no fused multiply-add, no reassociation): the package's logarithm is not
// libm's 'log' (see 'naturalLog'), so a different C library cannot change a
// bit. This run is Windows; Linux is expected to agree and is not tested yet.
// The comparison with libm's 'log' is a tolerance, not a pin.

mod distributions;

import testing use *;
import random;
import libc;

fn bitsOf(x f64) u64 { x as u64 }

fn main() i32 {
  // The logarithm, pinned (ln 10 is where libm's last bit differs from this)
  expectUInt(bitsOf(random.naturalLog(1.0d)), 0x0000000000000000u64, "ln 1");
  expectUInt(bitsOf(random.naturalLog(2.0d)), 0x3fe62e42fefa39efu64, "ln 2");
  expectUInt(bitsOf(random.naturalLog(0.5d)), 0xbfe62e42fefa39efu64, "ln 0.5");
  expectUInt(bitsOf(random.naturalLog(10.0d)), 0x40026bb1bbb55515u64, "ln 10");
  expectUInt(bitsOf(random.naturalLog(0.1d)), 0xc0026bb1bbb55515u64, "ln 0.1");

  // Within a few units in the last place of the C library's, over many decades
  var g = random.Rng.fromSeed(1u64);
  var worst = 0.0d;
  var n = 0i64;
  while n < 20000i64 {
    // 10^(-12 .. 12): the exponent is the draw
    let x = libc.pow(10.0d, g.unit() * 24.0d - 12.0d);
    let want = libc.log(x);
    let got = random.naturalLog(x);
    let err = if want == 0.0d { libc.fabs(got) } else { libc.fabs((got - want) / want) };
    if err > worst { worst = err; }
    n = n + 1i64;
  }
  expect(worst < 1.0d / 1000000000000000.0d, "ln within 1e-15 of libm, relative");

  // Normal numbers from seed 11
  var r = random.Rng.fromSeed(11u64);
  expectUInt(bitsOf(r.normal()), 0xbfb6539cafab4c81u64, "normal 1 bits");
  expectUInt(bitsOf(r.normal()), 0xbfc0a6b7d8b68811u64, "normal 2 bits");
  expectUInt(bitsOf(r.normal()), 0xbff93446ac0afd85u64, "normal 3 bits");
  expectUInt(bitsOf(r.normal()), 0xbfd6407b1dc54509u64, "normal 4 bits");
  expectUInt(bitsOf(r.normal()), 0xbfe144de0c3c9a4cu64, "normal 5 bits");
  expectUInt(bitsOf(r.normal()), 0xbfd0196fb1c2115au64, "normal 6 bits");

  // 100000 normals: mean, variance and the share within one deviation
  // (expected 0, 1 and 0.6827; the standard errors are 0.003, 0.0045 and 0.0015)
  r = random.Rng.fromSeed(11u64);
  var sum = 0.0d;
  var sumSq = 0.0d;
  var within = 0i64;
  n = 0i64;
  while n < 100000i64 {
    let x = r.normal();
    sum = sum + x;
    sumSq = sumSq + x * x;
    if x > -1.0d and x < 1.0d { within = within + 1i64; }
    n = n + 1i64;
  }
  let mean = sum / 100000.0d;
  expectFloat(mean, 0.0d, 0.015d, "normal mean");
  expectFloat(sumSq / 100000.0d - mean * mean, 1.0d, 0.025d, "normal variance");
  expectFloat(f64.from(within) / 100000.0d, 0.6827d, 0.008d, "normal share within one deviation");
  expectInt(within, 68163i64, "normal share, pinned");

  // normalWith and exponentialWith are the standard ones, scaled
  var a = random.Rng.fromSeed(12u64);
  var b = random.Rng.fromSeed(12u64);
  let scaled = a.normalWith(10.0d, 2.0d);
  let plain = b.normal();
  expectUInt(bitsOf(scaled), bitsOf(10.0d + 2.0d * plain), "normalWith is mean + deviation * normal");
  let rate = a.exponentialWith(4.0d);
  let unitRate = b.exponential();
  expectUInt(bitsOf(rate), bitsOf(unitRate / 4.0d), "exponentialWith is exponential / rate");

  // The spare half of a pair: a copy taken between the two calls goes on to
  // give the same second number, and 'jump' drops it
  var c = random.Rng.fromSeed(14u64);
  c.normal();
  var d = c.copyOf();
  expectUInt(bitsOf(c.normal()), bitsOf(d.normal()), "a copy keeps the spare");
  c = random.Rng.fromSeed(14u64);
  c.normal();
  c.jump();
  d = random.Rng.fromSeed(14u64);
  d.normal();
  d.normal();
  d.jump();
  expectUInt(bitsOf(c.normal()), bitsOf(d.normal()), "jump drops the spare, so the next normal is a fresh pair");

  // Exponential numbers from seed 13
  r = random.Rng.fromSeed(13u64);
  expectUInt(bitsOf(r.exponential()), 0x3fd1c1eead050a0au64, "exponential 1 bits");
  expectUInt(bitsOf(r.exponential()), 0x3ff86e5d9befcbbcu64, "exponential 2 bits");
  expectUInt(bitsOf(r.exponential()), 0x400a5af3f02b5f6cu64, "exponential 3 bits");
  expectUInt(bitsOf(r.exponential()), 0x3fbce444ecf59b0fu64, "exponential 4 bits");

  // 100000 of them: mean 1 (standard error 0.003), never negative
  r = random.Rng.fromSeed(13u64);
  var total = 0.0d;
  var least = 100.0d;
  n = 0i64;
  while n < 100000i64 {
    let x = r.exponential();
    total = total + x;
    if x < least { least = x; }
    n = n + 1i64;
  }
  expectFloat(total / 100000.0d, 1.0d, 0.015d, "exponential mean");
  expect(least >= 0.0d, "exponential is never negative");

  done()
}
