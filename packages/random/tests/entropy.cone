// Seeding from the OS. The numbers are random, so this checks what cannot
// depend on them: that the OS answers, that two generators seeded from it are
// not twins (core's process-wide hash seed would make them twins), that the
// state is nonzero, and that 'fromEntropyOr' takes the OS's answer when there
// is one. The chance of any check failing by luck is below 2^-60.

mod entropy;

import testing use *;
import random;

fn firstDraws(r: &mut random.Rng) u64 {
  r.next() ^ (r.next() * 3u64) ^ (r.next() * 5u64)
}

fn main() i32 {
  var a = random.Rng.fromSeed(0u64);
  var b = random.Rng.fromSeed(0u64);
  match random.Rng.fromEntropy() {
    case var Some(r) { a <-> r; }
    case is None { expect(false, "the OS gave entropy"); }
  }
  match random.Rng.fromEntropy() {
    case var Some(r) { b <-> r; }
    case is None { expect(false, "the OS gave entropy again"); }
  }
  let sa = a.state();
  let sb = b.state();
  expect((sa.0 | sa.1 | sa.2 | sa.3) != 0u64, "entropy state is nonzero");
  expect(sa.0 != sb.0 || sa.1 != sb.1 || sa.2 != sb.2 || sa.3 != sb.3, "two entropy generators differ");
  // Not the state fromSeed(0) gives, which the swap above started them with
  let z = random.Rng.fromSeed(0u64).state();
  expect(sa.0 != z.0 || sa.1 != z.1, "entropy replaced the starting state");
  expect(firstDraws(&mut a) != firstDraws(&mut b), "their draws differ");

  // fromEntropyOr: the OS answers, so the fallback seed is not used. A twin
  // of the fallback generator would draw the same numbers
  var c = random.Rng.fromEntropyOr(99u64);
  var f = random.Rng.fromSeed(99u64);
  expect(firstDraws(&mut c) != firstDraws(&mut f), "fromEntropyOr used the OS, not its fallback");

  done()
}
