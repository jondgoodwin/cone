// A constant-speed chase, the 'along' options for a ride (a centripetal
// spline, end ramps, headings of their own), and the re-exported easing ids.
// D is target 1; X, Y and Q property keys.
//
// CONSTANT-SPEED CHASE. Nearness 1 chasing 1.45 at 0.45 per 0.4 s (1.125 a
//   second): 1.225 at 0.2 s, and on 1.45 for good from 0.4 s, never past it,
//   in one step or in small ones. It stays registered (a goal that moves is
//   chased from where it is, at the same speed: set back to 1 at 1 s, 1.225
//   at 1.2 s). With 'endsOnArrival' it ends on reaching the goal, the field
//   keeping it. A Vec3 from the origin to (3,4,0) at 5 a second is at (1.5,2,0)
//   at 0.5 s (the straight line); a rotation from the identity to 90 degrees
//   about y at 90 degrees a second is 45 degrees at 0.5 s. 'chaseSettle' (99%
//   per 2 s) is 9.9 of 10 at 2 s; the time-constant chase is as before.
// CENTRIPETAL SPLINE. Through (0,0,0) (10,0,0) (10,0.5,0) (0,0.5,0) both
//   splines pass through the points; half way along the middle span the
//   uniform one is at x = 11.25, the centripetal one at x = 10.102157 (its
//   Barry-Goldman pyramid with knots at the square roots of the chords).
// END RAMPS. Over 10 s with 2 s ramps the progress is 0.125 at 2 s, 0.5 at
//   5 s, 0.625 at 6 s, 0.875 at 8 s and (0.5 - 1 / pi) / 8 = 0.0227113 at 1 s
//   (the speed 1 - cos from rest over 2 s, 1/8 of the whole a second in
//   between). Along a 100 m line by arc length that is 2.27113 m at 1 s.
// HEADINGS. Per-waypoint headings 0.1, 3.0 and -3.0 radians unwind to 0.1, 3.0
//   and 3.283185 (the short way round). Along a two-span path the heading is
//   those at the waypoints (3.0 at the middle one) and a Catmull-Rom between
//   (1.5323009 half way along the first span); +Z then faces (sin h, cos h).
// RE-EXPORT. EASE_* are tweenstack's own names.

mod followup;

import libc;
import testing use *;
import collections use *;
import geomath use *;
import tweenstack use *;

const D = 1u32;
const X = 1030u32;
const Y = 1031u32;
const Q = 1032u32;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

fn countKind(evs &List[AnimEvent], kind u32) i64 {
  mut n = 0i64;
  mut i = 0usize;
  while i < evs.len() { if (*evs[i]).kind == kind { n = n + 1i64; } i = i + 1usize; }
  n;
}

fn pts4() List[Vec3] {
  mut l = List[Vec3].empty();
  l.push(new Vec3(0., 0., 0.));
  l.push(new Vec3(10., 0., 0.));
  l.push(new Vec3(10., 0.5, 0.));
  l.push(new Vec3(0., 0.5, 0.));
  l;
}

fn pts3() List[Vec3] {
  mut l = List[Vec3].empty();
  l.push(new Vec3(0., 0., 0.));
  l.push(new Vec3(10., 0., 0.));
  l.push(new Vec3(10., 10., 0.));
  l;
}

fn main() i32 {
  // ---- constant-speed chase ----
  {
    mut reg = Animators.make();
    reg.setF32(D, X, 1.);
    imm h = reg.start(&Anim.chaseSpeed(D, X, Value.ofF32(1.45), 0.45, 0.4));
    expect(!reg.isPure(h), "a chase is not pure");
    reg.tick(0.2f64);
    near(reg.valueF32(D, X, -1.), 1.225, 0.00001, "1.225 at 0.2 s");
    reg.tick(0.4f64);
    near(reg.valueF32(D, X, -1.), 1.45, 0.00001, "on the goal at 0.4 s");
    reg.tick(1.0f64);
    near(reg.valueF32(D, X, -1.), 1.45, 0.0, "and capped there, exactly");
    expect(reg.isRunning(h), "it stays registered on its goal");
    reg.setGoal(h, 0u32, Value.ofF32(1.));
    reg.tick(1.2f64);
    near(reg.valueF32(D, X, -1.), 1.225, 0.00001, "a goal that moved is chased at the same speed");
    reg.tick(3.0f64);
    near(reg.valueF32(D, X, -1.), 1., 0.0, "and reached");
    expect(reg.isRunning(h), "still registered");
  }
  {
    // small steps and one step agree; the speed does not depend on the frame rate
    mut r1 = Animators.make();
    mut r2 = Animators.make();
    r1.setF32(D, X, 0.);
    r2.setF32(D, X, 0.);
    r1.start(&Anim.chaseSpeed(D, X, Value.ofF32(10.), 3., 1.));
    r2.start(&Anim.chaseSpeed(D, X, Value.ofF32(10.), 3., 1.));
    mut t f64 = 0.;
    mut i = 0;
    while i < 20 { t = t + 0.1f64; r1.tick(t); i = i + 1; }
    r2.tick(2.0f64);
    near(r1.valueF32(D, X, -1.), 6., 0.0001, "3 a second for 2 s: 6, in small steps");
    near(r2.valueF32(D, X, -1.), 6., 0.0001, "and in one step");
  }
  {
    mut reg = Animators.make();
    reg.setF32(D, X, 0.);
    imm h = reg.start(&Anim.chaseSpeed(D, X, Value.ofF32(2.), 1., 1.).endsOnArrival(true));
    reg.tick(1.0f64);
    expect(reg.isRunning(h), "not there yet");
    reg.takeEvents();
    reg.tick(2.5f64);
    near(reg.valueF32(D, X, -1.), 2., 0.0, "arrived");
    expect(!reg.exists(h), "and gone");
    imm evs = reg.takeEvents();
    expectInt(countKind(&evs, EV_ENDED), 1i64, "one ended event");
    expectInt(i64.from((*evs[0]).reason), i64.from(END_FINISHED), "finished");
    reg.tick(9.0f64);
    near(reg.valueF32(D, X, -1.), 2., 0.0, "the field keeps the goal");
  }
  {
    mut reg = Animators.make();
    reg.setVec3(D, X, new Vec3(0., 0., 0.));
    reg.start(&Anim.chaseSpeed(D, X, Value.ofVec3(new Vec3(3., 4., 0.)), 5., 1.));
    reg.tick(0.5f64);
    imm v = reg.valueVec3(D, X, new Vec3(-1., -1., -1.));
    near(v.x, 1.5, 0.0001, "vec3 straight line: x");
    near(v.y, 2., 0.0001, "vec3 straight line: y");
    reg.setQuat(D, Q, Quat.identity());
    imm goal = new Quat(0., sin(pi / 4.), 0., cos(pi / 4.));
    reg.start(&Anim.chaseSpeed(D, Q, Value.ofQuat(goal), pi / 2., 1.));
    reg.tick(1.0f64);
    imm q = reg.valueQuat(D, Q, Quat.identity());
    near(q.y, 0.382683, 0.0001, "a rotation turns at a constant angle a second: y");
    near(q.w, 0.923880, 0.0001, "and w");
    reg.tick(5.0f64);
    near(reg.valueQuat(D, Q, Quat.identity()).dot(goal), 1., 0.00001, "and arrives");
  }
  {
    mut reg = Animators.make();
    reg.setF32(D, X, 0.);
    reg.start(&Anim.chaseSettle(D, X, Value.ofF32(10.), 2.));
    reg.tick(2.0f64);
    near(reg.valueF32(D, X, -1.), 9.9, 0.001, "settle: 99% of the way in 2 s");
  }

  // ---- centripetal spline ----
  {
    imm flat = Curve3.catmull(&pts4());
    imm cen = Curve3.centripetal(&pts4());
    imm a = flat.point(0.5);
    imm b = cen.point(0.5);
    near(a.x, 11.25, 0.0001, "uniform, half way along the middle span: x");
    near(b.x, 10.102157, 0.0001, "centripetal: x");
    near(a.y, 0.25, 0.0001, "uniform y");
    near(b.y, 0.25, 0.0001, "centripetal y");
    imm c1 = cen.point(1. / 3.);
    near(c1.x, 10., 0.001, "centripetal passes through the second point: x");
    near(c1.y, 0., 0.001, "y");
    near(cen.point(0.).x, 0., 0.0001, "starts at the first point");
    near(cen.point(1.).x, 0., 0.0001, "ends at the last");
    near(cen.point(1.).y, 0.5, 0.0001, "ends at the last: y");
    expect(cen.length() < flat.length(), "and it is the shorter path");
    mut reg = Animators.make();
    reg.start(&Anim.along(D, X, &cen, 4.).withLinear());
    reg.tick(2.0f64);
    near(reg.valueVec3(D, X, new Vec3(-1., -1., -1.)).x, 10.102157, 0.0001, "an along animator rides it");
  }

  // ---- end ramps ----
  {
    imm e = Easing.endRamps(2.);
    near(e.applyOver(0.2, 10.), 0.125, 0.00001, "ramps: 0.125 at 2 s");
    near(e.applyOver(0.5, 10.), 0.5, 0.00001, "0.5 at 5 s");
    near(e.applyOver(0.6, 10.), 0.625, 0.00001, "0.625 at 6 s");
    near(e.applyOver(0.8, 10.), 0.875, 0.00001, "0.875 at 8 s");
    near(e.applyOver(0.1, 10.), 0.0227113, 0.00001, "0.0227113 at 1 s");
    near(e.applyOver(0.9, 10.), 1. - 0.0227113, 0.00001, "and the mirror at 9 s");
    near(e.applyOver(0.6, 10.) - e.applyOver(0.5, 10.), 0.125, 0.00001, "steady between: 1/8 a second");
    near(e.applyOver(0.7, 10.) - e.applyOver(0.6, 10.), 0.125, 0.00001, "still");
    near(e.applyOver(0., 10.), 0., 0.0, "zero at the start");
    near(e.applyOver(1., 10.), 1., 0.0, "one at the end");
    mut line = List[Vec3].empty();
    line.push(new Vec3(0., 0., 0.));
    line.push(new Vec3(100., 0., 0.));
    imm curve = Curve3.poly(&line);
    mut reg = Animators.make();
    reg.start(&Anim.along(D, X, &curve, 10.).byArcLength(true).withEndRamps(2.));
    reg.tick(1.0f64);
    near(reg.valueVec3(D, X, new Vec3(-1., -1., -1.)).x, 2.27113, 0.001, "along with ramps: 2.27113 m at 1 s");
    reg.tick(5.0f64);
    near(reg.valueVec3(D, X, new Vec3(-1., -1., -1.)).x, 50., 0.001, "50 m at 5 s");
    reg.tick(6.0f64);
    near(reg.valueVec3(D, X, new Vec3(-1., -1., -1.)).x, 62.5, 0.001, "62.5 m at 6 s");
    // a transition takes them too, and a longer one lengthens only the steady part
    reg.setF32(D, Y, 0.);
    reg.start(&Anim.transitionFrom(D, Y, Value.ofF32(0.), Value.ofF32(8.), 10.).withEndRamps(2.));
    reg.tick(8.0f64);
    near(reg.valueF32(D, Y, -1.), 8. * 0.125, 0.0001, "a transition with ramps (started at 6 s): 2 s in, 1/8 of the way");
  }

  // ---- headings ----
  {
    mut raw = List[f32].empty();
    raw.push(0.1); raw.push(3.0); raw.push(-3.0);
    imm un = unwindHeadings(&raw);
    near(*un[0usize], 0.1, 0.00001, "unwound: first as given");
    near(*un[1usize], 3.0, 0.00001, "second");
    near(*un[2usize], 3.283185, 0.0001, "third the short way round, not -3");
    imm curve = Curve3.poly(&pts3());
    near(headingAlong(&curve, &un, 0.5), 3.0, 0.0001, "the heading at the middle waypoint");
    near(headingAlong(&curve, &un, 0.25), 1.5323009, 0.0001, "and half way along the first span");
    mut reg = Animators.make();
    reg.start(&Anim.along(D, X, &curve, 4.).withLinear().facingHeadings(Q, &raw));
    reg.tick(1.0f64);
    imm f1 = reg.valueQuat(D, Q, Quat.identity()) * new Vec3(0., 0., 1.);
    near(f1.x, 0.99926, 0.0001, "facing at 1 s: forward x = sin h");
    near(f1.z, 0.038486, 0.0001, "forward z = cos h");
    reg.tick(2.0f64);
    imm f2 = reg.valueQuat(D, Q, Quat.identity()) * new Vec3(0., 0., 1.);
    near(f2.x, 0.14112, 0.0001, "at the middle waypoint: sin 3");
    near(f2.z, -0.98999, 0.0001, "cos 3");
    near(reg.valueQuat(D, Q, Quat.identity()).length(), 1., 0.0001, "unit quaternion");
    reg.tick(4.0f64);
    imm f3 = reg.valueQuat(D, Q, Quat.identity()) * new Vec3(0., 0., 1.);
    near(f3.x, -0.14112, 0.0001, "at the end: the third heading (sin 3.283185)");
    near(f3.z, -0.98999, 0.0001, "cos");
    // the travel is not affected, and the direction-based facing is still there
    mut reg2 = Animators.make();
    reg2.start(&Anim.along(D, X, &curve, 4.).withLinear().facing(Q));
    reg2.tick(1.0f64);
    imm g1 = reg2.valueQuat(D, Q, Quat.identity()) * new Vec3(0., 0., 1.);
    near(g1.x, 1., 0.0001, "facing the direction of travel: along +x");
  }

  // ---- re-exported easing ids ----
  {
    mut reg = Animators.make();
    reg.setF32(D, X, 0.);
    reg.setF32(D, Y, 0.);
    reg.start(&Anim.transition(D, X, Value.ofF32(10.), 1.).withEase(EASE_IN_QUAD));
    reg.start(&Anim.transition(D, Y, Value.ofF32(10.), 1.).withEase(EASE_LINEAR));
    reg.tick(0.5f64);
    near(reg.valueF32(D, X, -1.), 2.5, 0.00001, "EASE_IN_QUAD from tweenstack alone: 0.25 of 10");
    near(reg.valueF32(D, Y, -1.), 5., 0.00001, "EASE_LINEAR");
    expectInt(i64.from(EASE_COUNT), 36i64, "and the count");
    expect(Easing.of(EASE_IN_OUT_BOUNCE).id == EASE_IN_OUT_BOUNCE, "an easing value takes them");
  }
  done();
}
