// Value: one animated field's value, whatever its type. Five floats and a
// kind (keyframetracks' TK_F32, TK_VEC2, TK_VEC3, TK_QUAT, TK_COLOR), so the
// registry can hold fields of every type in one list without a reference to
// anything. A Vec2 uses x y, a Vec3 x y z, a Quat x y z w (the order glTF and
// geomath have it), a Color red green blue alpha in x y z w (linear sRGB).
// Floats not used by the kind are zero.
//
// MIXING. 'mixValue' goes between a and b at t (t may leave 0..1, which
// extrapolates along the same line, or the same great circle for a
// quaternion): numbers and vectors linearly, a quaternion by exact slerp
// along the shortest arc, a colour linearly in linear light unless the
// animator asks for OKLab.

pub const NO_KIND = 99u32;

fn clamp01(s: f32) f32 { if s < 0. { 0. } else if s > 1. { 1. } else { s } }

pub struct Value {
  pub kind: u32;
  pub x: f32;
  pub y: f32;
  pub z: f32;
  pub w: f32;

  pub fn ofF32(v: f32) Value { Value(TK_F32, v, 0., 0., 0.) }
  pub fn ofVec2(v: Vec2) Value { Value(TK_VEC2, v.x, v.y, 0., 0.) }
  pub fn ofVec3(v: Vec3) Value { Value(TK_VEC3, v.x, v.y, v.z, 0.) }
  pub fn ofQuat(q: Quat) Value { Value(TK_QUAT, q.x, q.y, q.z, q.w) }
  pub fn ofColor(c: Color) Value { Value(TK_COLOR, c.red, c.green, c.blue, c.alpha) }

  // The value that adds nothing: zeros, the identity rotation for a quaternion
  pub fn rest(kind: u32) Value {
    if kind == TK_QUAT { return Value(kind, 0., 0., 0., 1.); }
    Value(kind, 0., 0., 0., 0.)
  }

  pub fn asF32(self) f32 { x }
  pub fn asVec2(self) Vec2 { Vec2(x, y) }
  pub fn asVec3(self) Vec3 { Vec3(x, y, z) }
  pub fn asQuat(self) Quat { Quat(x, y, z, w) }
  pub fn asColor(self) Color { Color(x, y, z, w) }

  // Component i (0 to 3)
  pub fn get(self, i: usize) f32 {
    if i == 0usize { return x; }
    if i == 1usize { return y; }
    if i == 2usize { return z; }
    w
  }

  pub fn setAt(self, i: usize, v: f32) Value {
    if i == 0usize { return Value(kind, v, y, z, w); }
    if i == 1usize { return Value(kind, x, v, z, w); }
    if i == 2usize { return Value(kind, x, y, v, w); }
    Value(kind, x, y, z, v)
  }

  // The number of floats the kind uses
  pub fn comps(self) usize { kindComps(kind) }
}

// A value is one of the supported kinds
pub fn supportedKind(kind: u32) bool {
  kind == TK_F32 || kind == TK_VEC2 || kind == TK_VEC3 || kind == TK_QUAT || kind == TK_COLOR
}

// Between a and b at t (see the header). 'space' is a colour's mixing space
// (SPACE_LINEAR or SPACE_OKLAB)
pub fn mixValue(a: Value, b: Value, t: f32, space: u32) Value {
  if a.kind == TK_QUAT {
    let q = slerpQuat(Quat(a.x, a.y, a.z, a.w), Quat(b.x, b.y, b.z, b.w), t);
    return Value(TK_QUAT, q.x, q.y, q.z, q.w);
  }
  if a.kind == TK_COLOR && space == SPACE_OKLAB {
    let c = mixColor(Color(a.x, a.y, a.z, a.w), Color(b.x, b.y, b.z, b.w), t, SPACE_OKLAB);
    return Value(TK_COLOR, c.red, c.green, c.blue, c.alpha);
  }
  Value(a.kind, a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t, a.w + (b.w - a.w) * t)
}

// The value of a kind from the floats of a keyframetracks sample (a bool or
// an integer is a number)
pub fn valueFromFloats(kind: u32, f: &List[f32]) Value {
  let n = f.len();
  var v = Value.rest(kind);
  if kind == TK_BOOL || kind == TK_DISCRETE { v = Value.rest(TK_F32); }
  var i = 0usize;
  while i < n && i < 4usize { v = v.setAt(i, *f[i]); i = i + 1usize; }
  v
}
