// Anim: an animator as a value. It is plain data, built by a named function,
// storable, copyable, sendable, and it does nothing until a registry starts
// it ('Animators.start'). The kinds:
//
//   transition  from a value to a value over a duration, eased. 'from' is the
//               value the field has when it starts, unless given
//   keys        a keyframetracks Clip: tracks addressed by (target, property),
//               with markers
//   along       a curve in space (Curve3) with an optional facing rotation
//   chase       STEPPED: approaches a goal the host moves, with a time
//               constant (x += (goal - x) * (1 - exp(-dt / tau)))
//   spring      a damped spring towards a goal: closed form while the goal is
//               fixed (a function of time), carrying position and velocity
//               over when the goal moves
//   group       other animators, each at an offset: together, sequence,
//               stagger, lagged (a lag ratio), a Timeline with labels. A group
//               is an animator, so groups nest and take every timing field
//               below
//
// TIMING on every animator: delay, repeat (a count, fractions allowed, or
// FOREVER), direction (normal, reverse, alternate), hold (what a member of a
// group shows before it starts and after it ends: nothing, the end, the
// start, both; a lone animator's hold before its start is what it writes
// during its delay) and rate. A stepped kind (chase, spring) honours delay,
// hold and rate; it does not repeat or run in reverse (its state only moves
// forward).
//
// There is no weight, no layer and no combine mode: an animator writes the
// field it animates, directly, and ends. How effects combine is the author's
// own formula over separate values.

pub const FOREVER = 1.0e30;

pub fn isForever(x f64) bool { x >= 1.0e29f64; }

pub const AK_TRANSITION = 0u32;
pub const AK_KEYS = 1u32;
pub const AK_ALONG = 2u32;
pub const AK_CHASE = 3u32;
pub const AK_SPRING = 4u32;
pub const AK_GROUP = 5u32;

pub const DIR_NORMAL = 0u32;
pub const DIR_REVERSE = 1u32;
pub const DIR_ALTERNATE = 2u32;

pub const HOLD_NONE = 0u32;
pub const HOLD_END = 1u32;
pub const HOLD_START = 2u32;
pub const HOLD_BOTH = 3u32;

// What a subtree holds, so a pass can skip what it cannot concern
pub const F_STEPPED = 1u32;
pub const F_MARKERS = 2u32;
pub const F_NEEDS_INIT = 4u32;

pub const SETTLE_EPS = 0.0005;

pub struct Anim {
  pub kind u32;
  // the field a single-field kind animates, and its type
  pub target u32;
  pub prop u32;
  pub vkind u32;
  // transition, chase, spring
  pub hasFrom bool;
  pub from Value;
  pub to Value;
  // the length of one iteration; for a group, the end of its last member
  pub dur f32;
  // how long it is active for: dur, except for a stepped kind (it lives until
  // it is done, or for its life) and a group holding one
  pub life f32;
  pub easing Easing;
  pub space u32;
  // spring and chase
  pub zeta f32;
  pub omega f32;
  pub tau f32;
  pub slot u32;
  pub inheritVel bool;
  // timing
  pub delay f32;
  pub repeat f32;
  pub direction u32;
  pub hold u32;
  pub rate f32;
  // a registry stops the other running animators of the same exclusive group
  // (0 for none) when this one starts
  pub xgroup u32;
  // keys and along
  pub clips List[Clip];
  pub curves List[Curve3];
  pub faceProp u32;
  pub arc bool;
  // group
  pub kids List[Anim];
  pub offs List[f32];
  // nodes in this subtree, and what it holds
  pub size usize;
  pub flags u32;

  fn blank(kind u32) Anim {
    new Anim(kind, 0u32, 0u32, TK_F32, false, Value.rest(TK_F32), Value.rest(TK_F32), 0., 0., Easing.of(EASE_IN_OUT_CUBIC),
      SPACE_LINEAR, 0.5, 8., 0.4, 0u32, true, 0., 1., DIR_NORMAL, HOLD_END, 1., 0u32, List[Clip].empty(),
      List[Curve3].empty(), 0u32, false, List[Anim].empty(), List[f32].empty(), 1usize, 0u32);
  }

  pub fn copy(self &) Anim {
    mut a = new Anim(kind, target, prop, vkind, hasFrom, from, to, dur, life, easing, space, zeta, omega, tau, slot,
      inheritVel, delay, repeat, direction, hold, rate, xgroup, List[Clip].empty(), List[Curve3].empty(), faceProp, arc,
      List[Anim].empty(), List[f32].empty(), size, flags);
    mut i = 0usize;
    while i < clips.len() { a.clips.push(clips[i].copy()); i = i + 1usize; }
    i = 0usize;
    while i < curves.len() { a.curves.push(curves[i].copy()); i = i + 1usize; }
    i = 0usize;
    while i < kids.len() { a.kids.push(kids[i].copy()); a.offs.push(*offs[i]); i = i + 1usize; }
    a;
  }

  // ---- the kinds ----

  // 'target.prop' going to 'to' over 'dur' seconds, from whatever it holds when this starts
  pub fn transition(target u32, prop u32, to Value, dur f32) Anim {
    mut a = Anim.blank(AK_TRANSITION);
    a.target = target; a.prop = prop; a.vkind = to.kind; a.to = to; a.from = Value.rest(to.kind); a.dur = dur; a.life = dur;
    a.flags = F_NEEDS_INIT;
    a;
  }

  // The same from a given value
  pub fn transitionFrom(target u32, prop u32, from Value, to Value, dur f32) Anim {
    mut a = Anim.transition(target, prop, to, dur);
    a.hasFrom = true; a.from = from; a.flags = 0u32;
    a;
  }

  // The clip's tracks, linearly timed (the clip's own loop mode becomes
  // repeat and direction: LOOP is repeat FOREVER, PINGPONG is repeat FOREVER,
  // alternate)
  pub fn keys(clip &Clip) Anim {
    mut a = Anim.blank(AK_KEYS);
    a.clips.push(clip.copy());
    a.dur = clip.length;
    a.life = clip.length;
    a.easing = Easing.linear();
    if clip.mode == LOOP_LOOP { a.repeat = FOREVER; }
    if clip.mode == LOOP_PINGPONG { a.repeat = FOREVER; a.direction = DIR_ALTERNATE; }
    if clip.markers.len() > 0usize { a.flags = F_MARKERS; }
    a;
  }

  // One track of a property, as a clip of its own
  pub fn keysTrack(target u32, prop u32, track &Track) Anim {
    mut c = Clip.make("", LOOP_ONCE);
    c.addTrack(target, prop, track.copy());
    Anim.keys(&c);
  }

  // A point riding 'curve' (target.prop, a Vec3) over 'dur' seconds. With
  // 'byArcLength' it moves at one speed along the curve, else at the curve's
  // parameter speed
  pub fn along(target u32, prop u32, curve &Curve3, dur f32) Anim {
    mut a = Anim.blank(AK_ALONG);
    a.target = target; a.prop = prop; a.vkind = TK_VEC3; a.dur = dur; a.life = dur;
    a.curves.push(curve.copy());
    a;
  }

  // Also write the rotation facing the direction of travel (+Z forward, +Y
  // up) to the property 'faceProp'
  pub fn facing(mut self, faceProp u32) Anim { self.faceProp = faceProp; self; }
  pub fn byArcLength(mut self, on bool) Anim { arc = on; self; }

  // STEPPED: target.prop approaching a goal (first 'goal'; the host moves it
  // with Animators.setGoal on the animator's slot) within a time constant of
  // 'tau' seconds. It never ends unless given a life with 'withLife'.
  pub fn chase(target u32, prop u32, goal Value, tau f32) Anim {
    mut a = Anim.blank(AK_CHASE);
    a.target = target; a.prop = prop; a.vkind = goal.kind; a.to = goal; a.from = Value.rest(goal.kind);
    a.tau = tau; a.dur = FOREVER; a.life = FOREVER; a.easing = Easing.linear();
    a.flags = F_STEPPED | F_NEEDS_INIT;
    a;
  }

  // A damped spring (damping ratio zeta, angular frequency omega in radians a
  // second) towards 'goal'. It carries the velocity the field had when it
  // started (see withInheritVelocity), and ends when it has settled.
  pub fn spring(target u32, prop u32, goal Value, zeta f32, omega f32) Anim {
    mut a = Anim.blank(AK_SPRING);
    a.target = target; a.prop = prop; a.vkind = goal.kind; a.to = goal; a.from = Value.rest(goal.kind);
    a.zeta = zeta; a.omega = omega; a.dur = springSettle(zeta, omega, SETTLE_EPS); a.life = FOREVER;
    a.easing = Easing.linear();
    a.flags = F_STEPPED | F_NEEDS_INIT;
    a;
  }

  // A spring given as a mass on a spring has it
  pub fn springStiff(target u32, prop u32, goal Value, stiffness f32, damping f32, mass f32) Anim {
    Anim.spring(target, prop, goal, springZeta(stiffness, damping, mass), springOmegaOf(stiffness, mass));
  }

  // ---- modifiers ----

  pub fn withFrom(mut self, v Value) Anim {
    hasFrom = true;
    from = v;
    if kind == AK_TRANSITION { flags = flags & (F_STEPPED | F_MARKERS); }
    self;
  }
  pub fn withEase(mut self, id u32) Anim { easing = Easing.of(id); self; }
  pub fn withEaseParams(mut self, id u32, p0 f32, p1 f32) Anim { easing = Easing.withParams(id, p0, p1); self; }
  pub fn withEasing(mut self, e Easing) Anim { easing = e; self; }
  pub fn withLinear(mut self) Anim { easing = Easing.linear(); self; }
  pub fn withBezier(mut self, x1 f32, y1 f32, x2 f32, y2 f32) Anim { easing = Easing.bezier(x1, y1, x2, y2); self; }
  pub fn withSpace(mut self, s u32) Anim { space = s; self; }

  // How long a stepped animator lives, in seconds
  pub fn withLife(mut self, seconds f32) Anim { dur = seconds; life = seconds; self; }
  pub fn withSlot(mut self, s u32) Anim { slot = s; self; }
  pub fn withInheritVelocity(mut self, on bool) Anim { inheritVel = on; self; }

  pub fn withDelay(mut self, d f32) Anim { delay = d; self; }

  // More than one iteration is a loop, and a loop that still has the default
  // ease (cubic in-out) is made linear, so its repeats join without a pause;
  // an ease chosen after this call is kept
  pub fn withRepeat(mut self, n f32) Anim {
    repeat = n;
    if n > 1. and !easing.bez and easing.id == EASE_IN_OUT_CUBIC { easing = Easing.linear(); }
    self;
  }
  pub fn forever(mut self) Anim {
    repeat = FOREVER;
    if !easing.bez and easing.id == EASE_IN_OUT_CUBIC { easing = Easing.linear(); }
    self;
  }
  pub fn withDirection(mut self, d u32) Anim { direction = d; self; }
  pub fn withHold(mut self, h u32) Anim { hold = h; self; }
  pub fn withRate(mut self, r f32) Anim { rate = r; self; }

  // Starting this stops the running animators of the exclusive group 'g'
  pub fn exclusive(mut self, g u32) Anim { xgroup = g; self; }

  // ---- reading ----

  pub fn isStepped(self &) bool { kind == AK_CHASE or kind == AK_SPRING; }
  pub fn isGroup(self &) bool { kind == AK_GROUP; }

  // Iterations: a stepped kind has one
  pub fn iterations(self &) f32 { if self.isStepped() { 1.; } else { repeat; }; }

  pub fn rateOf(self &) f64 { if rate < 0.000001 { 0.000001f64; } else { f64.from(rate); }; }

  // The time it takes in its parent's timeline: delay, then the iterations at
  // the rate (FOREVER if it has no end)
  pub fn span(self &) f64 {
    imm d = f64.from(dur);
    imm n = f64.from(self.iterations());
    if isForever(d) or isForever(n) { return 1.0e30f64; }
    f64.from(delay) + d * n / self.rateOf();
  }

  // The same, counting a stepped kind by how long it lives rather than how
  // long it nominally takes
  pub fn lifeSpan(self &) f64 {
    imm d = f64.from(life);
    imm n = f64.from(self.iterations());
    if isForever(d) or isForever(n) { return 1.0e30f64; }
    f64.from(delay) + d * n / self.rateOf();
  }

  // The animator has no end
  pub fn isEndless(self &) bool { isForever(self.span()); }

  // How many animators the tree holds
  pub fn count(self &) usize { size; }
}

fn flagsOfKids(a &Anim) u32 {
  mut f = 0u32;
  mut i = 0usize;
  while i < a.kids.len() { f = f | a.kids[i].flags; i = i + 1usize; }
  f;
}

fn capTime(x f64) f32 { if x >= 1.0e29f64 { FOREVER; } else { f32.from(x); }; }

// A group of copies of 'parts' at the given offsets
fn buildGroup(parts &List[Anim], offs &List[f32]) Anim {
  mut a = Anim.blank(AK_GROUP);
  mut size = 1usize;
  mut end f64 = 0.;
  mut lend f64 = 0.;
  mut i = 0usize;
  while i < parts.len() {
    imm k = parts[i].copy();
    size = size + k.size;
    imm e = f64.from(*offs[i]) + k.span();
    if e > end { end = e; }
    imm le = f64.from(*offs[i]) + k.lifeSpan();
    if le > lend { lend = le; }
    a.kids.push(k);
    a.offs.push(*offs[i]);
    i = i + 1usize;
  }
  a.dur = capTime(end);
  a.life = capTime(lend);
  a.size = size;
  a.flags = flagsOfKids(&a);
  a;
}

// All the parts at once; ends when the last ends
pub fn together(parts &List[Anim]) Anim {
  mut offs = List[f32].empty();
  mut i = 0usize;
  while i < parts.len() { offs.push(0.); i = i + 1usize; }
  buildGroup(parts, &offs);
}

// Each part starts when the one before ends
pub fn sequence(parts &List[Anim]) Anim {
  mut offs = List[f32].empty();
  mut t f64 = 0.;
  mut i = 0usize;
  while i < parts.len() {
    offs.push(capTime(t));
    t = t + parts[i].span();
    if t > 1.0e30f64 { t = 1.0e30f64; }
    i = i + 1usize;
  }
  buildGroup(parts, &offs);
}

// Each part starts 'lag' seconds after the one before
pub fn stagger(parts &List[Anim], lag f32) Anim {
  mut offs = List[f32].empty();
  mut i = 0usize;
  while i < parts.len() { offs.push(lag * f32.from(i)); i = i + 1usize; }
  buildGroup(parts, &offs);
}

// Manim's lag ratio: each part starts the fraction 'ratio' of the way
// through the one before (0 is together, 1 is a sequence)
pub fn lagged(parts &List[Anim], ratio f32) Anim {
  mut offs = List[f32].empty();
  mut cur f64 = 0.;
  mut i = 0usize;
  while i < parts.len() {
    offs.push(capTime(cur));
    imm start = cur;
    imm end = start + parts[i].span();
    cur = (1.0f64 - f64.from(ratio)) * start + f64.from(ratio) * end;
    if cur > 1.0e30f64 { cur = 1.0e30f64; }
    i = i + 1usize;
  }
  buildGroup(parts, &offs);
}

// Copies of 'parts' that are one exclusive group: starting one stops the others
pub fn oneOf(parts &List[Anim], g u32) List[Anim] {
  mut out = List[Anim].empty();
  mut i = 0usize;
  while i < parts.len() { out.push(parts[i].copy().exclusive(g)); i = i + 1usize; }
  out;
}

fn findName(names &List[String], name &str) i64 {
  mut i = 0usize;
  while i < names.len() {
    if names[i].view() == name { return i64.from(i); }
    i = i + 1usize;
  }
  -1i64;
}

// A Timeline lays animators on a line the way GSAP's does: each is placed at
// the end of what is there so far (add), at a time (addAt), with the last
// one (addWith), after it (addAfter) or relative to a named label or to the
// start or end of a named member (addAtLabel, addAtStartOf, addAtEndOf).
// 'build' makes one group.
pub struct Timeline {
  pub items List[Anim];
  pub offs List[f32];
  pub itemNames List[String];
  pub labelNames List[String];
  pub labelTimes List[f32];
  pub lastStart f64;
  pub lastEnd f64;
  pub end f64;

  pub fn make() Timeline {
    new Timeline(List[Anim].empty(), List[f32].empty(), List[String].empty(), List[String].empty(), List[f32].empty(),
      0., 0., 0.);
  }

  fn place(self &mut, a &Anim, at f64) {
    imm t = if at < 0. { 0.; } else { at; };
    self.items.push(a.copy());
    self.offs.push(capTime(t));
    self.itemNames.push(String.from(""));
    self.lastStart = t;
    self.lastEnd = t + a.span();
    if self.lastEnd > 1.0e30f64 { self.lastEnd = 1.0e30f64; }
    if self.lastEnd > self.end { self.end = self.lastEnd; }
  }

  pub fn add(mut self, a &Anim) Timeline { imm at = self.end; self.place(a, at); self; }
  pub fn addAt(mut self, a &Anim, t f32) Timeline { self.place(a, f64.from(t)); self; }
  pub fn addWith(mut self, a &Anim, off f32) Timeline { imm at = self.lastStart + f64.from(off); self.place(a, at); self; }
  pub fn addAfter(mut self, a &Anim, off f32) Timeline { imm at = self.lastEnd + f64.from(off); self.place(a, at); self; }

  // At a label's time plus 'off'; an unknown label is time 0
  pub fn addAtLabel(mut self, a &Anim, name &str, off f32) Timeline {
    imm i = findName(&self.labelNames, name);
    imm base = if i >= 0i64 { f64.from(*self.labelTimes[usize.from(i)]); } else { 0.; };
    self.place(a, base + f64.from(off));
    self;
  }

  // At the start of the member named 'name' plus 'off'
  pub fn addAtStartOf(mut self, a &Anim, name &str, off f32) Timeline {
    imm i = findName(&self.itemNames, name);
    imm base = if i >= 0i64 { f64.from(*self.offs[usize.from(i)]); } else { 0.; };
    self.place(a, base + f64.from(off));
    self;
  }

  // At the end of the member named 'name' plus 'off'
  pub fn addAtEndOf(mut self, a &Anim, name &str, off f32) Timeline {
    imm i = findName(&self.itemNames, name);
    mut base f64 = 0.;
    if i >= 0i64 { base = f64.from(*self.offs[usize.from(i)]) + self.items[usize.from(i)].span(); }
    self.place(a, base + f64.from(off));
    self;
  }

  // Name the member added last
  pub fn named(mut self, name &str) Timeline {
    if self.itemNames.len() > 0usize {
      imm k = self.itemNames.len() - 1usize;
      self.itemNames.set(k, String.from(name));
    }
    self;
  }

  // A label at a time
  pub fn label(mut self, name &str, t f32) Timeline {
    self.labelNames.push(String.from(name));
    self.labelTimes.push(t);
    self;
  }

  // A label at the end of what is there so far
  pub fn labelHere(mut self, name &str) Timeline {
    self.labelNames.push(String.from(name));
    self.labelTimes.push(capTime(self.end));
    self;
  }

  pub fn build(self &) Anim { buildGroup(&self.items, &self.offs); }
}
