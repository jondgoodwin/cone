// Curve3: a path in space for an 'along' animator to ride. A curve is plain
// data (its kind and control points) with a table of arc lengths, so it can
// be walked by distance as well as by parameter. Parameter u runs 0 to 1
// over the whole curve.
//
// - CURVE_POLY: straight segments between the points.
// - CURVE_CATMULL: a uniform Catmull-Rom spline through the points (a
//   tangent at each point of half the chord between its neighbours, the end
//   points using the one-sided chord). It passes through every point.
// - CURVE_CATMULL_CENTRIPETAL: a Catmull-Rom spline whose knots are spaced by
//   the square root of the chord between points (alpha 0.5), so a corner
//   between unevenly spaced points never overshoots into a loop, where the
//   uniform one can stray metres (a hairpin of 10 m legs and a 0.5 m turn: the
//   uniform spline's middle span bulges 1.25 m past the turn, this one 0.1 m).
//   It passes through every point. Past each end a point is mirrored (twice
//   the end point less its neighbour), so the path leaves and arrives along
//   its first and last chord.
// - CURVE_BEZIER: a chain of cubic Beziers; the points are p0 c0 c1 p1 c2
//   c3 p2 ... (3n + 1 of them), the same control points geomath's
//   CubicBezier3 takes.
//
// A parameter-speed walk (u = progress) runs fast where the control points
// are far apart; the arc-length walk ('uAtFraction') runs at one speed.

pub const CURVE_POLY = 0u32;
pub const CURVE_CATMULL = 1u32;
pub const CURVE_BEZIER = 2u32;
pub const CURVE_CATMULL_CENTRIPETAL = 3u32;

// Samples of the arc-length table to a segment. A long segment (hundreds of
// metres, like a balloon ride) needs many: against a 4096-sample reference, 16
// put the table 0.134 m out, 32 0.035 m, 64 0.009 m.
const ARC_SAMPLES = 64usize;

pub struct Curve3 {
  pub kind: u32;
  pub pts: List[Vec3];
  pub lens: List[f32];
  pub total: f32;

  pub fn make(kind: u32, points: &List[Vec3]) Curve3 {
    var c = Curve3(kind, List[Vec3].empty(), List[f32].empty(), 0.);
    var i = 0usize;
    while i < points.len() { c.pts.push(*points[i]); i = i + 1usize; }
    c.measure();
    c
  }

  pub fn poly(points: &List[Vec3]) Curve3 { Curve3.make(CURVE_POLY, points) }
  pub fn catmull(points: &List[Vec3]) Curve3 { Curve3.make(CURVE_CATMULL, points) }
  pub fn centripetal(points: &List[Vec3]) Curve3 { Curve3.make(CURVE_CATMULL_CENTRIPETAL, points) }
  pub fn bezier(points: &List[Vec3]) Curve3 { Curve3.make(CURVE_BEZIER, points) }

  pub fn copy(self: &) Curve3 { Curve3.make(kind, &pts) }

  // The number of segments (0 for a curve with fewer than two points, or
  // for a Bezier chain that is not 3n + 1 points)
  pub fn segments(self: &) usize {
    if pts.len() < 2usize { return 0usize; }
    if kind == CURVE_BEZIER {
      if (pts.len() - 1usize) % 3usize != 0usize { return 0usize; }
      return (pts.len() - 1usize) / 3usize;
    }
    pts.len() - 1usize
  }

  fn at(self: &, i: usize) Vec3 { *pts[i] }

  // The point of segment seg at its local parameter s (0 to 1)
  fn segPoint(self: &, seg: usize, s: f32) Vec3 {
    if kind == CURVE_POLY { return self.at(seg).lerp(self.at(seg + 1usize), s); }
    if kind == CURVE_BEZIER {
      let b = CubicBezier3(self.at(seg * 3usize), self.at(seg * 3usize + 1usize), self.at(seg * 3usize + 2usize),
        self.at(seg * 3usize + 3usize));
      return b.point(s);
    }
    let p0 = self.at(seg);
    let p1 = self.at(seg + 1usize);
    var m0 = Vec3(0., 0., 0.);
    var m1 = Vec3(0., 0., 0.);
    if kind == CURVE_CATMULL_CENTRIPETAL {
      self.centripetalTangents(seg, &mut m0, &mut m1);
    } else {
      m0 = self.catmullTangent(seg);
      m1 = self.catmullTangent(seg + 1usize);
    }
    let s2 = s * s;
    let s3 = s2 * s;
    p0 * (2. * s3 - 3. * s2 + 1.) + m0 * (s3 - 2. * s2 + s) + p1 * (-2. * s3 + 3. * s2) + m1 * (s3 - s2)
  }

  fn segTangent(self: &, seg: usize, s: f32) Vec3 {
    if kind == CURVE_POLY { return self.at(seg + 1usize) - self.at(seg); }
    if kind == CURVE_BEZIER {
      let b = CubicBezier3(self.at(seg * 3usize), self.at(seg * 3usize + 1usize), self.at(seg * 3usize + 2usize),
        self.at(seg * 3usize + 3usize));
      return b.tangent(s);
    }
    let p0 = self.at(seg);
    let p1 = self.at(seg + 1usize);
    var m0 = Vec3(0., 0., 0.);
    var m1 = Vec3(0., 0., 0.);
    if kind == CURVE_CATMULL_CENTRIPETAL {
      self.centripetalTangents(seg, &mut m0, &mut m1);
    } else {
      m0 = self.catmullTangent(seg);
      m1 = self.catmullTangent(seg + 1usize);
    }
    let s2 = s * s;
    p0 * (6. * s2 - 6. * s) + m0 * (3. * s2 - 4. * s + 1.) + p1 * (-6. * s2 + 6. * s) + m1 * (3. * s2 - 2. * s)
  }

  // Control point i of a centripetal spline, with one mirrored point past
  // each end
  fn mirrored(self: &, i: i64) Vec3 {
    let n = i64.from(pts.len());
    if i < 0i64 { return self.at(0usize) * 2. - self.at(1usize); }
    if i >= n { return self.at(pts.len() - 1usize) * 2. - self.at(pts.len() - 2usize); }
    self.at(usize.from(i))
  }

  // The spacing of knots: the square root of the chord (a tiny step for
  // doubled points, which would otherwise divide by zero)
  fn knotStep(a: Vec3, b: Vec3) f32 {
    let d = (b - a).length();
    if d < 0.0001 { 0.01 } else { d.sqrt() }
  }

  // The tangents (derivative with respect to the span's own parameter) of the
  // cubic Hermite that equals the centripetal Catmull-Rom (Barry and
  // Goldman's pyramid) between points seg and seg + 1
  fn centripetalTangents(self: &, seg: usize, m0: &mut Vec3, m1: &mut Vec3) {
    let i = i64.from(seg);
    let a = self.mirrored(i - 1i64);
    let b = self.mirrored(i);
    let c = self.mirrored(i + 1i64);
    let d = self.mirrored(i + 2i64);
    let k1 = Curve3.knotStep(a, b);
    let k2 = Curve3.knotStep(b, c);
    let k3 = Curve3.knotStep(c, d);
    *m0 = ((b - a) * (1. / k1) - (c - a) * (1. / (k1 + k2)) + (c - b) * (1. / k2)) * k2;
    *m1 = ((c - b) * (1. / k2) - (d - b) * (1. / (k2 + k3)) + (d - c) * (1. / k3)) * k2;
  }

  // Half the chord between a point's neighbours (the end points' own side)
  fn catmullTangent(self: &, i: usize) Vec3 {
    let n = pts.len();
    let a = if i > 0usize { i - 1usize } else { i };
    let b = if i + 1usize < n { i + 1usize } else { i };
    let d = (self.at(b) - self.at(a)) * 0.5;
    // an end point uses the whole chord of its one neighbour
    if a == i || b == i { return d * 2.; }
    d
  }

  // Which segment and where in it for the whole-curve parameter u
  pub fn locate(self: &, u: f32, seg: &mut usize, s: &mut f32) {
    let n = self.segments();
    if n == 0usize { *seg = 0usize; *s = 0.; return; }
    let x = clamp01(u) * f32.from(n);
    var k = usize.from(libc.floorf(x));
    if k >= n { k = n - 1usize; }
    *seg = k;
    *s = x - f32.from(k);
  }

  // The point at the whole-curve parameter u (0 to 1)
  pub fn point(self: &, u: f32) Vec3 {
    if self.segments() == 0usize { return if pts.len() > 0usize { self.at(0usize) } else { Vec3(0., 0., 0.) }; }
    var seg = 0usize;
    var s: f32 = 0.;
    self.locate(u, &mut seg, &mut s);
    self.segPoint(seg, s)
  }

  // The unit direction of travel at u (the last good direction at a cusp)
  pub fn direction(self: &, u: f32) Vec3 {
    if self.segments() == 0usize { return Vec3(0., 0., 1.); }
    var seg = 0usize;
    var s: f32 = 0.;
    self.locate(u, &mut seg, &mut s);
    var t = self.segTangent(seg, s);
    if t.lengthSquared() < 0.0000001 {
      // a stopped tangent (a doubled control point): nudge along the curve
      t = self.segPoint(seg, clamp01(s + 0.01)) - self.segPoint(seg, clamp01(s - 0.01));
    }
    if t.lengthSquared() < 0.00000001 { return Vec3(0., 0., 1.); }
    t.normalize()
  }

  // Fill the arc-length table: ARC_SAMPLES samples to a segment
  fn measure(self: &mut) {
    lens.clear();
    total = 0.;
    let n = self.segments();
    lens.push(0.);
    if n == 0usize { return; }
    let m = n * ARC_SAMPLES;
    var prev = self.point(0.);
    var i = 1usize;
    while i <= m {
      let p = self.point(f32.from(i) / f32.from(m));
      total = total + p.distance(prev);
      lens.push(total);
      prev = p;
      i = i + 1usize;
    }
  }

  // The length of the curve
  pub fn length(self: &) f32 { total }

  // The parameter u at which the fraction f (0 to 1) of the length is behind
  pub fn uAtFraction(self: &, f: f32) f32 {
    if total <= 0. || lens.len() < 2usize { return clamp01(f); }
    let want = clamp01(f) * total;
    var lo = 0usize;
    var hi = lens.len() - 1usize;
    while hi - lo > 1usize {
      let mid = (lo + hi) / 2usize;
      if *lens[mid] <= want { lo = mid; } else { hi = mid; }
    }
    let l0 = *lens[lo];
    let l1 = *lens[hi];
    let k = if l1 > l0 { (want - l0) / (l1 - l0) } else { 0. };
    (f32.from(lo) + k) / f32.from(lens.len() - 1usize)
  }
}

// ---------------------------------------------------------------------------
// Headings along a curve

fn wrapAngle(a: f32) f32 { a - 2. * pi * libc.floorf((a + pi) / (2. * pi)) }

// Headings (angles in radians) given at each waypoint of a path, unwound so
// each is the SHORT way round from the one before: the first as given, each
// next the one before plus the wrapped difference. Over a whole ride the
// angle then runs on past a half turn (a ride that turns once round ends a
// full turn from where it began) rather than flipping back across the seam.
pub fn unwindHeadings(raw: &List[f32]) List[f32] {
  var out = List[f32].empty();
  var i = 0usize;
  while i < raw.len() {
    if i == 0usize {
      out.push(*raw[0usize]);
    } else {
      let prev = *out[i - 1usize];
      out.push(prev + wrapAngle(*raw[i] - prev));
    }
    i = i + 1usize;
  }
  out
}

// The heading at the whole-curve parameter u: a uniform Catmull-Rom through
// the unwound headings 'h' of the waypoints (one per control point where the
// span ends: points for a polyline or Catmull-Rom curve, every third for a
// Bezier chain), along the span's own parameter, the end headings repeated
// past each end
pub fn headingAlong(c: &Curve3, h: &List[f32], u: f32) f32 {
  let n = h.len();
  if n == 0usize { return 0.; }
  if n == 1usize { return *h[0usize]; }
  var seg = 0usize;
  var s: f32 = 0.;
  c.locate(u, &mut seg, &mut s);
  let i = i64.from(seg);
  let last = i64.from(n) - 1i64;
  let i0 = if i - 1i64 < 0i64 { 0i64 } else if i - 1i64 > last { last } else { i - 1i64 };
  let i1 = if i < 0i64 { 0i64 } else if i > last { last } else { i };
  let i2 = if i + 1i64 > last { last } else { i + 1i64 };
  let i3 = if i + 2i64 > last { last } else { i + 2i64 };
  let h0 = *h[usize.from(i0)];
  let h1 = *h[usize.from(i1)];
  let h2 = *h[usize.from(i2)];
  let h3 = *h[usize.from(i3)];
  let s2 = s * s;
  let s3 = s2 * s;
  0.5 * (2. * h1 + (h2 - h0) * s + (2. * h0 - 5. * h1 + 4. * h2 - h3) * s2 + (3. * h1 - h0 - 3. * h2 + h3) * s3)
}
