// The breathing clock, worked by hand.
//
// WAVEFORM (rest, drive 0): inspiration is the first 40 per cent of the cycle, a half cosine: fill 0.5 at 20 per cent, 1 at
// 40. Then the passive recoil, an exponential with k = 2.8 over the 50 per cent between 40 and 90: fill (e^-ks - e^-k) /
// (1 - e^-k); at its middle (s = 0.5) that is (0.2466 - 0.0608) / 0.9392 = 0.1978; then the pause, fill 0, to the end.
// At drive 1 inspiration is 50 per cent and there is no pause: at 100 per cent the fill is 0 again, at s = 1.
//
// RATE AND DEPTH. Rate 0.22 a second at rest (13 a minute), 0.85 flat out (51 a minute); drive 0.5 gives 0.22 +
// 0.63 x 0.5^0.9 = 0.22 + 0.63 x 0.5359 = 0.5576. Depth 1 at rest, 3.2 at drive 1, and at drive 0.5 1 + 2.2 x 0.75 = 2.65:
// the breath deepens before it quickens.
//
// A RESTING MINUTE makes 13.2 breaths on average; the cycle-to-cycle variability of a few per cent leaves the count between
// 12 and 14.
//
// A HARD WALK. Work 0.9 against the threshold 0.55 is 0.35 over it: the debt gains 0.14 x 0.35 = 0.049 a second, so about
// 0.8 after 20 s with the quick times. Ventilation drive closes on the target (0.9 plus 0.8 of the debt, held to 1) with a
// time constant of 4 s. Stopped, the target falls to 0.8 x the debt, and the debt is repaid at 7 per cent a second: still
// breathing hard (drive over 0.35) five seconds after the stop, and calm (under 0.1) a minute and a half on.

mod breath;

import testing use *;
import collections use List;
import geomath use *;
import bonepose use *;
import facerig use *;
import animlayers use *;
import livingbody use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn testWaveform() {
  near(lungFill(0., 0., false), 0., 0.00001, "empty at the start of the cycle");
  near(lungFill(0.2, 0., false), 0.5, 0.0001, "half full at half of the inspiration");
  near(lungFill(0.4, 0., false), 1., 0.0001, "full at the end of the inspiration");
  near(lungFill(0.65, 0., false), 0.1978, 0.0005, "the recoil's middle");
  near(lungFill(0.95, 0., false), 0., 0.00001, "the pause");
  near(lungFill(0.5, 1., false), 1., 0.0001, "flat out, inspiration ends at half of the cycle");
  near(lungFill(0.999, 1., false), 0.0, 0.01, "flat out, the exhalation ends at the cycle's end");
  // monotone up then down
  var ok = true;
  var prev = 0.f;
  var i = 1;
  while i <= 40 {
    let f = lungFill(f32.from(i) / 100., 0., false);
    if f < prev { ok = false; }
    prev = f;
    i = i + 1;
  }
  expectBool(ok, true, "the fill rises all through the inspiration");
  ok = true;
  prev = 1.;
  while i <= 90 {
    let f = lungFill(f32.from(i) / 100., 0., false);
    if f > prev + 0.000001 { ok = false; }
    prev = f;
    i = i + 1;
  }
  expectBool(ok, true, "and falls all through the expiration");
  expectBool(lungFill(0.95, 0., true) == 0. && lungFill(0.80, 0., true) == 0., true, "a sigh pauses longer: empty from 78 per cent");
}

fn testRateDepth() {
  let b = Breathing.make(ExertionParams.realistic(), 1.75, 1u32);
  near(b.rateFor(0.), 0.22, 0.00001, "rest rate");
  near(b.rateFor(1.), 0.85, 0.00001, "flat out rate");
  near(b.rateFor(0.5), 0.5576, 0.001, "drive 0.5");
  near(b.depthFor(0.), 1., 0.00001, "rest depth");
  near(b.depthFor(1.), 3.2, 0.00001, "flat out depth");
  near(b.depthFor(0.5), 2.65, 0.0001, "drive 0.5 depth: deeper before quicker");
  expectBool(b.depthFor(0.5) / b.depthFor(1.) > b.rateFor(0.5) / b.rateFor(1.) - 0.3, true, "depth leads rate");
}

fn testRest() {
  var b = Breathing.make(ExertionParams.realistic(), 1.75, 7u32);
  var cycles = 0;
  var lastPhase = b.phase;
  var t = 0;
  var maxFill = 0.f;
  var maxChest = 0.f;
  var minBelly = 1.f;
  while t < 3600 {
    let s = b.update(1. / 60., 0.);
    if s.phase < lastPhase { cycles = cycles + 1; }
    lastPhase = s.phase;
    if s.fill > maxFill { maxFill = s.fill; }
    if s.chest > maxChest { maxChest = s.chest; }
    if s.belly < minBelly { minBelly = s.belly; }
    t = t + 1;
  }
  expectBool(cycles >= 12 && cycles <= 14, true, "a minute of rest is 12 to 14 breaths");
  near(b.drive, 0., 0.00001, "and no drive builds");
  near(maxFill, 1., 0.01, "the lungs fill");
  expectBool(maxChest > 0.004 && maxChest < 0.012, true, "the chest travels a few millimetres at rest");
  expectBool(minBelly >= -0.0001, true, "the belly is never drawn in at rest");
}

fn testExertion() {
  var b = Breathing.make(ExertionParams.quick(), 1.75, 3u32);
  var t = 0;
  var maxStep = 0.f;
  var last = b.phase;
  while t < 60 * 20 {
    let s = b.update(1. / 60., 0.9);
    var d = s.phase - last;
    if d < 0. { d = d + 1.; }
    if d > maxStep { maxStep = d; }
    last = s.phase;
    t = t + 1;
  }
  expectBool(b.drive > 0.9, true, "twenty seconds of a hard walk: the drive is up");
  expectBool(b.debt > 0.5, true, "and there is a debt");
  expectBool(b.state.rate > 0.7, true, "breathing fast");
  expectBool(b.state.depth > 2.3, true, "and deep");
  expectBool(maxStep <= 0.85 / 60. * 1.2 * 1.15, true, "the phase never jumped: its step never passed rate x dt");
  // the pause is gone, the exhalation is drawing the belly in, the shoulders lift
  var minBelly = 1.f;
  var maxShoulders = 0.f;
  var k = 0;
  while k < 120 {
    let s = b.update(1. / 60., 0.9);
    if s.belly < minBelly { minBelly = s.belly; }
    if s.shoulders > maxShoulders { maxShoulders = s.shoulders; }
    k = k + 1;
  }
  expectBool(minBelly < 0., true, "the belly is drawn in on the hard exhalation");
  expectBool(maxShoulders > 0.008, true, "the shoulders lift");
  // stopped
  k = 0;
  while k < 60 * 5 { b.update(1. / 60., 0.); k = k + 1; }
  expectBool(b.drive > 0.35, true, "five seconds after stopping: still breathing hard");
  while k < 60 * 90 { b.update(1. / 60., 0.); k = k + 1; }
  expectBool(b.drive < 0.1, true, "a minute and a half on: calm");
  expectBool(b.debt < 0.1, true, "and the debt is repaid");
}

fn testSigh() {
  var b = Breathing.make(ExertionParams.realistic(), 1.75, 9u32);
  var t = 0;
  while t < 300 { b.update(1. / 60., 0.); t = t + 1; }
  b.sigh();
  var deepest = 0.f;
  t = 0;
  while t < 60 * 12 {
    let s = b.update(1. / 60., 0.);
    if s.depth > deepest { deepest = s.depth; }
    t = t + 1;
  }
  expectBool(deepest > 1.9, true, "a sigh is a breath twice the size");
}

fn testBones() {
  let s = humanoid(1.75);
  var d = zeroPose(s.boneCount());
  var st = new BreathState(0.4, 1., 1., 0.22, 0., 0., true, 1., 0.007, 0.01, 0.005, 0.);
  applyBreathPose(&st, &humanoidBreathBones(), &mut d);
  let chestAngle = 2. * acos(clampf(d.rotation(CHEST).w, -1., 1.));
  near(chestAngle, radians(1.1), 0.0001, "a resting breath leans the chest back 1.1 degrees");
  expectBool(d.rotation(CHEST).x > 0., true, "about +x: back");
  near((*d.locals[CLAVICLE_L]).translation.y, 0.005, 0.00001, "the clavicles lift with the shoulders");
  near((*d.locals[PELVIS]).translation.y, 0., 0.00001, "the pelvis is left alone");
}

fn main() i32 {
  testWaveform();
  testRateDepth();
  testRest();
  testExertion();
  testSigh();
  testBones();
  done()
}
