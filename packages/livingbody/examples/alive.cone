// alive: bodies that look alive, drawn headless on a real GPU.
//
//   congo run --release packages/livingbody/examples/alive.cone -- --out DIR [--scene man|horse|all]
//   GPU_POWER_PREFERENCE=low-power congo run --release packages/livingbody/examples/alive.cone -- --out DIR
//
// SCENE 1, THE MANNEQUIN. garmentdrape's plain test mannequin (a 1.75 m figure of tapered tubes on bonepose's 19-bone
// skeleton). It stands idle for eight seconds: it breathes (livingbody's one clock; the chest and belly are soft-region morph
// targets under render's skinning), shifts its weight from foot to foot, fidgets, and looks around (an attention that
// picks directions, a face rig that splits each shift between eyes and head, a look-at chain that carries the head's turn
// down the neck and spine); a head of hair (strandflow: cards on strands solved by xpbdsoftbody's rope) hangs and swings in a
// gusty breeze; then it walks briskly for ten seconds (walkgait, with its own sine breath and weight shift switched off, ours
// layered on instead), and stops out of breath: the breath is fast and deep, the shoulders lift, the belly is drawn in on the
// exhalation, the mouth opens, a posture (a poseik state machine over a blend space of delta poses) takes it forward, and over
// the next ten seconds everything settles back. Exertion's time constants are the 'quick' ones (a sixth of the body's own).
//
// SCENE 2, A FOUR-LEGGED TEST BODY (creaturerig's plainBody, not a species) walking and trotting in a wind, with a mane (strands
// riding the neck's bones) and a tail (strands riding the tail's), a barrel and a flank that breathe and lag, and its head
// turning to look about.
//
// Each picture is a BMP, OUT/NAME.bmp. It prints the cost of a frame, by phase (microseconds a frame, the 50th percentile of a
// soak), and the GPU time of a frame. With the Vulkan SDK, validation is on and must say nothing; the process exits 1 if it
// does, if a Vulkan call failed, or if a check below fails.

mod alive;

import stdio use *;
import libc;
import time use Instant;
import geomath use *;
import collections use *;
import mesh use Mesh;
import sdf use taperedCapsule, smoothUnion;
import sdfmesh use surfaceNet;
import gpu use *;
import render use *;
import path as filepath;
import bonepose use *;
import poseik use *;
import walkgait use Walker;
import creaturerig use *;
import leggedgait use *;
import garmentdrape use BodyRig, humanoidMannequin;
import xpbdsoftbody use Collider;
import clothrope use WindField;
import strandflow use *;
import animlayers use *;
import livingbody use *;

const W = 640u32;
const H = 512u32;

fn cstrEquals(a *u8, b &str) bool {
  var i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8;
}

// ------------------------------------------------------------------------------ timing

fn sortInto(v &mut List[i64]) {
  var i = 1usize;
  while i < v.len() {
    let x = *v[i];
    var j = i;
    while j > 0usize and *v[j - 1usize] > x { v.set(j, *v[j - 1usize]); j = j - 1usize; }
    v.set(j, x);
    i = i + 1usize;
  }
}

struct Phase {
  name String;
  micros List[i64];
}

struct Costs {
  phases List[Phase];

  fn make() Costs { new Costs(List[Phase].empty()); }

  fn add(self &mut, name &str, micros i64) {
    var i = 0usize;
    while i < phases.len() {
      if phases[i].name.view() == name { phases[i].micros.push(micros); return; }
      i = i + 1usize;
    }
    var p = new Phase(String.from(name), List[i64].empty());
    p.micros.push(micros);
    phases.push(p);
  }

  fn report(self &mut, label &str) {
    printStr(label); print <- ": p50 microseconds a frame\n";
    var total i64 = 0i64;
    var i = 0usize;
    while i < phases.len() {
      sortInto(&mut phases[i].micros);
      let m = *phases[i].micros[phases[i].micros.len() / 2usize];
      total = total + m;
      print <- "  "; printStr(phases[i].name.view()); print <- " "; print <- m; print <- "\n";
      i = i + 1usize;
    }
    print <- "  (sum of the p50s) "; print <- total; print <- "\n";
  }
}

// ------------------------------------------------------------------------------ the stage

struct Stage {
  out Texture;
  depth Texture;
  renderer Renderer;
  post Post;
  queries QuerySet;
  resolved Buffer;
  tick Buffer;
  shot Buffer;
  light Light;
  groundMesh MeshHandle;
  groundMat MaterialHandle;
  morpher Morpher;
}

fn checkerImage() Image {
  Image.checker(256, 256, 8, 8, new Color(0.30, 0.36, 0.20, 1.), new Color(0.26, 0.32, 0.18, 1.));
}

fn slab(center Vec3, size Vec3) Mat4 { Mat4.fromTrs(center, Quat.identity(), size); }

fn makeStage(device &mut Device) Stage {
  let outDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var out = device.createTexture(&outDesc);
  let depthDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var renderer = Renderer.create(device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var post = Post.create(device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, W, H);
  var queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32);
  var resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);
  var tick = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var shot = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var sky = Sky.dusk(radians(48.), radians(215.));
  sky.zenith = new Color(0.14, 0.28, 0.62, 1.);
  sky.horizon = new Color(0.55, 0.62, 0.74, 1.);
  sky.sunColor = new Color(40., 36., 30., 1.);
  sky.glow = new Color(0.35, 0.28, 0.16, 1.);
  sky.ground = new Color(0.10, 0.12, 0.08, 1.);
  renderer.setSky(device, &sky);
  let light = sky.sunLight(new Color(2.2, 2.0, 1.75, 1.), new Color(0.08, 0.1, 0.14, 1.));
  let settings = ShadowSettings.medium();
  renderer.setShadows(device, &settings);
  let img = checkerImage();
  let tex = renderer.addTexture(device, &img);
  var gm = PbrMaterial.standard(new Color(1., 1., 1., 1.), 0., 0.9);
  gm.texture = tex;
  let groundMat = renderer.addPbrMaterial(device, &gm);
  let gmesh = Mesh.cube(0.5);
  let groundMesh = renderer.addMesh(device, &gmesh);
  var morpher = Morpher.create(device);
  new Stage(out, depth, renderer, post, queries, resolved, tick, shot, light, groundMesh, groundMat, morpher);
}

// One frame drawn (after the morph pre-pass); the GPU time of 'render' in ms, and the picture written if `name` is not empty
fn drawFrame(device &mut Device, st &mut Stage, camera &Camera, list &DrawList, name &str) f64 {
  var encoder = device.createCommandEncoder();
  st.morpher.update(device, &mut encoder, &st.renderer);
  encoder.writeTimestamp(&st.queries, 0u32);
  st.renderer.render(device, &mut encoder, &st.post.hdr, &st.depth, camera, &st.light, list);
  encoder.writeTimestamp(&st.queries, 1u32);
  st.post.apply(&mut encoder, &st.out);
  encoder.resolveQuerySet(&st.queries, 0u32, 2u32, &st.resolved, 0u64);
  encoder.copyBufferToBuffer(&st.resolved, 0u64, &st.tick, 0u64, 16u64);
  if name.len() > 0usize { encoder.copyTextureToBuffer(&st.out, &st.shot); }
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  let ticks = st.tick.mappedRange() as *u64;
  let ms = f64.from(*(ticks + 1usize) - *ticks) * f64.from(device.timestampPeriod) * 1.0e-6d;
  if name.len() > 0usize {
    let image = Image.fromTexels(st.shot.mappedRange(), i32.from(W), i32.from(H), false);
    if !image.save(&filepath.Path.from(name)) { print <- "COULD NOT WRITE "; printStr(name); print <- "\n"; }
  }
  ms;
}

fn fileName(dir &str, name &str) String {
  var s = String.from(dir);
  s <- "/";
  s <- name;
  s <- ".bmp";
  s;
}

fn numbered(base &str, i i32) String {
  var s = String.from(base);
  s <- "-";
  if i < 10 { s <- "0"; }
  s <- i64.from(i);
  s;
}

fn camera(eye Vec3, at Vec3, fov f32) Camera {
  var c = Camera.make();
  c.fov = radians(fov);
  c.near = 0.05;
  c.far = 200.;
  c.lookAt(eye, at, new Vec3(0., 1., 0.));
  c.background = new Color(0.5, 0.65, 0.9, 1.);
  c;
}

// ------------------------------------------------------------------------------ the mannequin

fn flat(x f32, z f32) f32 { 0.; }

struct Person {
  rig BodyRig;
  walker Walker;
  life LivingHumanoid;
  anim Animator;
  pWinded usize;
  pSpeed usize;
  morphed MorphHandle;
  bodyMesh MeshHandle;
  bodyMat MaterialHandle;
  base Pose;
  baseModels List[Transform3];
  pose Pose;
  models List[Transform3];
  bones List[Transform3];       // the bones in the world
  mats List[Mat4];
  pins List[LimbPin];
  weights usize;
  flags u32;
  hair StrandSim;
  hairMesh MeshHandle;
  hairMat MaterialHandle;
  hairScratch Mesh;
  hairSeen List[bool];
  hairColliders List[Collider];
  eyeMesh MeshHandle;
  pupilMesh MeshHandle;
  eyeMat MaterialHandle;
  pupilMat MaterialHandle;
  eyeCentreL Vec3;
  eyeCentreR Vec3;
}

// Where the hair grows: the crown and the sides and back of the head, not the face (model space of the 1.75 m mannequin,
// whose head joint is at y 1.5225 and whose head tube rises 0.166 m from it)
fn scalp(p Vec3, n Vec3) f32 {
  let lower = if p.z > 0.02 { 1.57; } else { 1.60; };
  let up = smoothstep(lower, lower + 0.03, p.y);
  let forehead = if p.z < -0.04 { smoothstep(1.645, 1.67, p.y); } else { 1.; };
  up * forehead;
}

fn regionTable() List[SoftRegion] {
  var r = List[SoftRegion].empty();
  // the belly: below the chest, in front, breathing with the belly and lagging at 3 Hz
  r.push(SoftRegion.make("belly", SPINE, new Vec3(0., 0.03, 0.), new Vec3(0., 0., -1.), new Vec3(0.17, 0.10, 0.11))
    .breathing(REGION_BELLY, 1.).jiggling(3., 0.2, 0.03, new Vec3(0.6, 1., 0.8)));
  // the chest wall in front, at the sides and behind
  r.push(SoftRegion.make("chest front", CHEST, new Vec3(0., 0.05, 0.), new Vec3(0., 0., -1.), new Vec3(0.17, 0.11, 0.11))
    .breathing(REGION_CHEST, 1.).jiggling(4.5, 0.25, 0.012, new Vec3(0.5, 1., 0.6)));
  r.push(SoftRegion.make("chest left", CHEST, new Vec3(0., 0.0, 0.), new Vec3(-1., 0., 0.), new Vec3(0.10, 0.12, 0.12)).breathing(REGION_CHEST, 0.6));
  r.push(SoftRegion.make("chest right", CHEST, new Vec3(0., 0.0, 0.), new Vec3(1., 0., 0.), new Vec3(0.10, 0.12, 0.12)).breathing(REGION_CHEST, 0.6));
  r.push(SoftRegion.make("back", CHEST, new Vec3(0., 0.0, 0.), new Vec3(0., 0., 1.), new Vec3(0.17, 0.12, 0.10)).breathing(REGION_CHEST, 0.35));
  r;
}

// The posture layer's deltas: neutral, slumped, bent over with the hands towards the knees
fn postureClip(kind i32, count usize) Clip {
  var p = zeroPose(count);
  let x = new Vec3(1., 0., 0.);
  if kind == 1 {
    deltaRotate(&mut p, SPINE, Quat.angleAxis(radians(-9.), x));
    deltaRotate(&mut p, CHEST, Quat.angleAxis(radians(-7.), x));
    deltaRotate(&mut p, NECK, Quat.angleAxis(radians(5.), x));
    deltaRotate(&mut p, UPPER_ARM_L, Quat.angleAxis(radians(8.), x));
    deltaRotate(&mut p, UPPER_ARM_R, Quat.angleAxis(radians(8.), x));
  }
  if kind == 2 {
    deltaRotate(&mut p, PELVIS, Quat.angleAxis(radians(-14.), x));
    deltaRotate(&mut p, SPINE, Quat.angleAxis(radians(-18.), x));
    deltaRotate(&mut p, CHEST, Quat.angleAxis(radians(-12.), x));
    deltaRotate(&mut p, NECK, Quat.angleAxis(radians(12.), x));
    deltaRotate(&mut p, HEAD, Quat.angleAxis(radians(8.), x));
    deltaRotate(&mut p, UPPER_ARM_L, Quat.angleAxis(radians(40.), x));
    deltaRotate(&mut p, UPPER_ARM_R, Quat.angleAxis(radians(40.), x));
    deltaRotate(&mut p, FOREARM_L, Quat.angleAxis(radians(16.), x));
    deltaRotate(&mut p, FOREARM_R, Quat.angleAxis(radians(16.), x));
    deltaTranslate(&mut p, PELVIS, new Vec3(0., -0.03, 0.));
  }
  var c = Clip.make(1., true);
  c.addKey(0., &p);
  c;
}

fn makePerson(device &mut Device, st &mut Stage, seed u32) Person {
  var rig = humanoidMannequin(1.75);
  let skel = humanoid(1.75);
  let regions = regionTable();
  let tg = buildRegionTargets(&rig.mesh, &rig.restModels, &regions);
  let nTargets = tg.count();
  let sr = SoftRegions.make(regionTable(), tg, &rig.restModels);
  let life = LivingHumanoid.make(&skel, 1.75, ExertionParams.quick(), seed, sr);
  // the morph set for the body: the regions' targets
  var mt = MorphTargets.empty(rig.mesh.positions.len());
  let noTan = List[Vec3].empty();
  var t = 0usize;
  while t < nTargets {
    mt.addSparse(&life.regions.tg.targets.indicesOf(t), &life.regions.tg.targets.positionsOf(t), &life.regions.tg.targets.normalsOf(t), &noTan);
    t = t + 1usize;
  }
  let set = st.morpher.addSet(device, &mt, &rig.mesh);
  let baseMesh = st.renderer.addSkinnedMesh(device, &rig.mesh, &rig.skin);
  var enc0 = device.createCommandEncoder();
  let copy = st.morpher.addCopy(device, &mut enc0, &mut st.renderer, baseMesh, set, false);
  device.queue.submit(enc0.finish());
  device.endFrame();
  device.waitIdle();
  var bm = PbrMaterial.standard(new Color(0.74, 0.55, 0.44, 1.), 0., 0.55);
  let bodyMat = st.renderer.addPbrMaterial(device, &bm);
  // the posture state machine: upright, or tired (a blend space of the deltas, by how winded)
  let zero = zeroPose(skel.boneCount());
  var anim = Animator.make(&zero);
  let cNeutral = anim.addClip(postureClip(0, skel.boneCount()));
  let cSlump = anim.addClip(postureClip(1, skel.boneCount()));
  let cBent = anim.addClip(postureClip(2, skel.boneCount()));
  var space = BlendSpace1D.empty();
  space.add(0., postureClip(0, skel.boneCount()));
  space.add(0.55, postureClip(1, skel.boneCount()));
  space.add(1., postureClip(2, skel.boneCount()));
  let iSpace = anim.addSpace(space);
  let pWinded = anim.addParam(0.);
  let pSpeed = anim.addParam(0.);
  let sUpright = anim.addClipState(cNeutral, 1.);
  let sTired = anim.addSpaceState(iSpace, pWinded, 1.);
  let toTired = anim.addTransition(i32.from(sUpright), sTired, 1.4, -1.);
  anim.addCondition(toTired, pWinded, CMP_GREATER, 0.45);
  anim.addCondition(toTired, pSpeed, CMP_LESS, 0.3);
  let toUpright = anim.addTransition(i32.from(sTired), sUpright, 2.5, -1.);
  anim.addCondition(toUpright, pWinded, CMP_LESS, 0.2);
  var walker = Walker.make(1.75, seed);
  walker.ownIdle = false;
  let rp = skel.restPose();
  // the hair: strands rooted on the scalp in the head bone's frame, a gusty breeze
  var hairStyle = StrandStyle.hair();
  hairStyle.length = 0.34;
  hairStyle.cardWidth = 0.034;
  hairStyle.cardTipWidth = 0.013;
  hairStyle.rootHold = 0.04;
  var sim = StrandSim.make(Medium.air(WindField.breeze(new Vec3(0.9, 0., 0.5))), 1u32);
  let headRest = *rig.restModels[HEAD];
  let hg = sim.addGroup(headRest, hairStyle);
  let roots0 = rootsOnMesh(hg, &rig.mesh, 320usize, &scalp, new Vec3(0., -1., 0.35), 0.9, 77u32);
  var roots = List[StrandRoot].empty();
  let inv = headRest.inverse();
  var ri = 0usize;
  while ri < roots0.len() {
    let r = roots0[ri];
    roots.push(new StrandRoot(hg, inv.transformPoint(r.pos), (inv.rotation * r.dir).normalize(), (inv.rotation * r.normal).normalize(), r.seed));
    ri = ri + 1usize;
  }
  sim.addStrands(&roots);
  let cnt = cardCounts(&sim);
  let hairMesh = st.renderer.addDynamicMesh(device, u32.from(cnt.0), u32.from(cnt.1));
  let fibres = paintFibers(4, 64, 256, 14, 5u32);
  var img = new Image(fibres.width, fibres.height, 4, List[u8].empty());
  var q = 0usize;
  while q < fibres.rgba.len() { img.pixels.push(*fibres.rgba[q]); q = q + 1usize; }
  let hairTex = st.renderer.addCutoutTexture(device, &img, 0.45);
  var hm = PbrMaterial.standard(new Color(0.34, 0.17, 0.07, 1.), 0., 0.6);
  hm.texture = hairTex;
  hm.alphaMode = ALPHA_MASK;
  hm.alphaCutoff = 0.45;
  hm.specularScale = 0.35;
  let hairMat = st.renderer.addPbrMaterial(device, &hm);
  // which bones the hair meets
  var seen = List[bool].empty();
  var b = 0usize;
  while b < rig.boneCount() {
    seen.push(b == HEAD or b == NECK or b == CHEST);
    b = b + 1usize;
  }
  // eyes: two spheres and their pupils, on the head bone, turned by the face rig
  let eyeMesh = st.renderer.addMesh(device, &Mesh.sphere(0.0155, 16));
  let pupilMesh = st.renderer.addMesh(device, &Mesh.sphere(0.0072, 12));
  var em = PbrMaterial.standard(new Color(0.92, 0.9, 0.86, 1.), 0., 0.25);
  em.clearcoat = 1.;
  em.clearcoatRoughness = 0.04;
  let eyeMat = st.renderer.addPbrMaterial(device, &em);
  var pm = PbrMaterial.standard(new Color(0.03, 0.025, 0.02, 1.), 0., 0.1);
  pm.clearcoat = 1.;
  pm.clearcoatRoughness = 0.03;
  let pupilMat = st.renderer.addPbrMaterial(device, &pm);
  let socket = skel.sockets[SOCKET_EYE].offset.translation;
  new Person(rig, walker, life, anim, pWinded, pSpeed, copy, st.morpher.mesh(copy), bodyMat, rp.copy(), List[Transform3].empty(), rp.copy(),
    List[Transform3].empty(), List[Transform3].empty(), List[Mat4].empty(), List[LimbPin].empty(), nTargets, 0u32,
    sim, hairMesh, hairMat, Mesh.empty(), seen, List[Collider].empty(), eyeMesh, pupilMesh, eyeMat, pupilMat,
    socket + new Vec3(-0.032, 0., 0.003), socket + new Vec3(0.032, 0., 0.003));
}

// The feet the walker has planted, as pins in the model's space (the model faces yaw 0 here)
fn footPins(p &mut Person, at Vec3) {
  p.pins.clear();
  var side = 0;
  while side < 2 {
    let f = if side == 0 { p.walker.left; } else { p.walker.right; };
    let sgn = if side == 0 { -1.; } else { 1.; };
    let thigh = if side == 0 { THIGH_L; } else { THIGH_R; };
    let rot = Quat.angleAxis(f.yaw, new Vec3(0., 1., 0.)) * Quat.angleAxis(f.pitch * (1. - p.walker.air), new Vec3(1., 0., 0.));
    p.pins.push(new LimbPin(thigh, f.ankle - at, rot, new Vec3(sgn * 0.12, 0., -1.).normalize(), 0.5235988, 1.));
    side = side + 1;
  }
}

// A frame of the person at ground point `at` moving `speed` m/s along -z doing `work`
fn stepPerson(p &mut Person, at Vec3, speed f32, work f32, dt f32) {
  p.walker.update(&p.rig.skeleton, &mut p.base, &mut p.baseModels, at, 0., speed, 0., true, &flat, dt);
  let calm = 1. - smoothstep(0.05, 0.4, speed);
  p.life.tick(&p.rig.skeleton, dt, work, calm);
  // the posture
  p.anim.setParam(p.pWinded, p.life.state.winded);
  p.anim.setParam(p.pSpeed, speed);
  let posture = p.anim.update(dt);
  p.life.setPosture(posture);
  p.life.fadePosture(1., 0.1);
  footPins(p, at);
  let world = new Transform3(at, Quat.identity(), new Vec3(1., 1., 1.));
  p.life.compose(&p.rig.skeleton, &p.base, &world, &p.pins, &mut p.pose, &mut p.models);
  p.bones.clear();
  var i = 0usize;
  while i < p.models.len() { p.bones.push(world * *p.models[i]); i = i + 1usize; }
}

// The hair a frame: its frame is the head bone's, its colliders the head, neck, shoulders and trunk where they are now
fn stepHair(p &mut Person, dt f32) {
  p.hair.setFrame(0usize, *p.bones[HEAD]);
  // three capsules (a box costs several times a capsule's contact test): the skull, the neck, the shoulders and upper back
  p.hairColliders.clear();
  let hb = *p.bones[HEAD];
  let nb = *p.bones[NECK];
  let cb = *p.bones[CHEST];
  p.hairColliders.push(Collider.capsule(hb.transformPoint(new Vec3(0., 0.05, 0.004)), hb.transformPoint(new Vec3(0., 0.125, 0.004)), 0.094));
  p.hairColliders.push(Collider.capsule(nb.transformPoint(new Vec3(0., -0.03, 0.)), hb.transformPoint(new Vec3(0., 0.02, 0.)), 0.075));
  p.hairColliders.push(Collider.capsule(cb.transformPoint(new Vec3(-0.12, 0.09, 0.02)), cb.transformPoint(new Vec3(0.12, 0.09, 0.02)), 0.085));
  if (libc.getenv("NOHAIRCOL") as usize) == 0usize { p.hair.setColliders(0usize, &p.hairColliders); }
  p.hair.step(dt);
}

fn drawPerson(st &mut Stage, device &mut Device, p &mut Person, list &mut DrawList) {
  p.rig.skinMatrices(&p.bones, &mut p.mats);
  st.morpher.setWeights(&mut st.renderer, p.morphed, &p.life.regions.weights);
  list.addSkinned(p.bodyMesh, p.bodyMat, Mat4.identity(), p.mats.view());
  // the eyes: each turned by the face rig's rotation for it
  let head = (*p.bones[HEAD]).toMat4();
  var side = 0;
  while side < 2 {
    let centre = if side == 0 { p.eyeCentreL; } else { p.eyeCentreR; };
    let q = if side == 0 { p.life.frame.eyeL; } else { p.life.frame.eyeR; };
    let m = head * Mat4.fromTranslation(centre) * Mat4.fromQuat(q);
    list.add(p.eyeMesh, p.eyeMat, m);
    list.add(p.pupilMesh, p.pupilMat, m * Mat4.fromTranslation(new Vec3(0., 0., -0.0132)));
    side = side + 1;
  }
  // the hair
  writeCards(&p.hair, &mut p.hairScratch, 4u32, 1.);
  st.renderer.writeDynamicMesh(device, p.hairMesh, &p.hairScratch);
  list.add(p.hairMesh, p.hairMat, Mat4.identity());
}

fn manSpeed(t f32) f32 {
  if t < 8. { return 0.; }
  if t < 9.4 { return 1.9 * smoothstep(8., 9.4, t); }
  if t < 17.5 { return 1.9; }
  if t < 18.6 { return 1.9 * (1. - smoothstep(17.5, 18.6, t)); }
  0.;
}

fn manWork(t f32) f32 { if t >= 8. and t < 18. { 0.9; } else { 0.; }; }

fn runMan(device &mut Device, st &mut Stage, outDir &str) bool {
  var ok = true;
  var p = makePerson(device, st, 11u32);
  let dt = 1. / 60.;
  var z f32 = 0.;
  var t f32 = 0.;
  var frame = 0;
  var shots = 0;
  var costs = Costs.make();
  var maxChest f32 = 0.;
  var minBelly f32 = 0.;
  var gpuMs f64 = 0d;
  var gpuFrames = 0;
  var sceneList = DrawList.empty();
  while t < 36. {
    let speed = manSpeed(t);
    z = z - speed * dt;
    let at = new Vec3(0., 0., z);
    let c0 = Instant.now();
    stepPerson(&mut p, at, speed, manWork(t), dt);
    costs.add("person: walker, life, layers, pins, look-at, springs", c0.elapsed().nanos() / 1000i64);
    let c1 = Instant.now();
    stepHair(&mut p, dt);
    costs.add("hair: strand step", c1.elapsed().nanos() / 1000i64);
    if p.life.state.chest > maxChest { maxChest = p.life.state.chest; }
    if p.life.state.belly < minBelly { minBelly = p.life.state.belly; }
    // pictures: the lungs empty and full (standing and winded) from the side; sequences; the hair close
    let fill = p.life.state.fill;
    var name = String.empty();
    var cam = camera(new Vec3(4.4, 1.0, z - 0.4), new Vec3(0., 0.88, z), 30.);
    if t >= 2. and t < 7.9 {
      if fill < 0.03 and !hasShot(&p, 0) { name = String.from("stand-empty"); markShot(&mut p, 0); }
      if fill > 0.97 and !hasShot(&p, 1) { name = String.from("stand-full"); markShot(&mut p, 1); }
    }
    if t >= 21. and t < 30. {
      if fill < 0.03 and !hasShot(&p, 2) { name = String.from("winded-empty"); markShot(&mut p, 2); }
      if fill > 0.99 and !hasShot(&p, 3) { name = String.from("winded-full"); markShot(&mut p, 3); }
    }
    // the torso close, empty and full, side on
    if t >= 2. and t < 7.9 {
      if fill < 0.03 and hasShot(&p, 0) and !hasShot(&p, 4) and name.len() == 0usize { name = String.from("torso-empty"); markShot(&mut p, 4); cam = camera(new Vec3(1.3, 1.3, z - 1.6), new Vec3(0., 1.2, z), 30.); }
      if fill > 0.97 and hasShot(&p, 1) and !hasShot(&p, 5) and name.len() == 0usize { name = String.from("torso-full"); markShot(&mut p, 5); cam = camera(new Vec3(1.3, 1.3, z - 1.6), new Vec3(0., 1.2, z), 30.); }
    }
    if t >= 6.3 and !hasShot(&p, 6) { name = String.from("hair-stand-back"); markShot(&mut p, 6); cam = camera(new Vec3(0.55, 1.5, z + 1.2), new Vec3(0., 1.45, z), 30.); }
    if t >= 13.0 and !hasShot(&p, 7) { name = String.from("hair-walk-side"); markShot(&mut p, 7); cam = camera(new Vec3(1.5, 1.5, z - 0.2), new Vec3(0., 1.45, z - 0.1), 30.); }
    if t >= 24.0 and !hasShot(&p, 8) { name = String.from("hair-winded"); markShot(&mut p, 8); cam = camera(new Vec3(-0.7, 1.45, z - 1.3), new Vec3(0., 1.35, z), 30.); }
    let seqStand = t >= 1.0 and t < 7.0 and frame % 45 == 0;
    let seqWalk = t >= 11.0 and t < 12.2 and frame % 9 == 0;
    let seqWinded = t >= 18.6 and t < 30.6 and frame % 90 == 0;
    if seqStand or seqWalk or seqWinded {
      var nm = String.from(if seqStand { "seq-stand"; } elif seqWalk { "seq-walk"; } else { "seq-winded"; });
      nm <- "-";
      nm <- i64.from(frame);
      name = nm.copy();
      cam = if seqWalk { camera(new Vec3(3.6, 1.15, z - 0.6), new Vec3(0., 0.95, z - 0.2), 34.); }
        else { camera(new Vec3(-1.9, 1.3, z - 3.0), new Vec3(0., 1.0, z), 30.); };
    }
    if name.len() > 0usize {
      var list = DrawList.empty();
      list.add(st.groundMesh, st.groundMat, slab(new Vec3(0., -0.05, z - 8.), new Vec3(40., 0.1, 60.)));
      drawPerson(st, device, &mut p, &mut list);
      drawFrame(device, st, &cam, &list, fileName(outDir, name.view()).view());
      shots = shots + 1;
    }
    t = t + dt;
    frame = frame + 1;
  }
  print <- "man: "; print <- i64.from(shots); print <- " pictures; largest chest travel "; print <- maxChest * 1000.; print <- " mm; belly drawn in to ";
  print <- minBelly * 1000.; print <- " mm\n";

  // the soak: 600 more frames of the brisk walk (work 0.9), all of it drawn, a frame at a time
  var soak = Costs.make();
  var gpuSum f64 = 0d;
  var gpuN = 0;
  var k = 0;
  while k < 700 {
    z = z - 1.9 * dt;
    let at = new Vec3(0., 0., z);
    let a0 = Instant.now();
    stepPerson(&mut p, at, 1.9, 0.9, dt);
    soak.add("person: walker, life, layers, pins, look-at, springs", a0.elapsed().nanos() / 1000i64);
    let a1 = Instant.now();
    stepHair(&mut p, dt);
    soak.add("hair: strand step", a1.elapsed().nanos() / 1000i64);
    let a2 = Instant.now();
    var list = DrawList.empty();
    list.add(st.groundMesh, st.groundMat, slab(new Vec3(0., -0.05, z - 8.), new Vec3(40., 0.1, 60.)));
    drawPerson(st, device, &mut p, &mut list);
    soak.add("draw list: skin matrices, morph weights, hair cards written and uploaded", a2.elapsed().nanos() / 1000i64);
    let cam = camera(new Vec3(4.4, 1.0, z - 0.4), new Vec3(0., 0.88, z), 30.);
    let a3 = Instant.now();
    let ms = drawFrame(device, st, &cam, &list, "");
    soak.add("render call, the wait for the GPU, readback of the timestamps", a3.elapsed().nanos() / 1000i64);
    if k >= 60 { gpuSum = gpuSum + ms; gpuN = gpuN + 1; }
    k = k + 1;
  }
  soak.report("man (soak of 700 frames)");
  print <- "  GPU time of a frame (skinned morphed body, eyes, hair cards, shadows, post), mean: "; print <- gpuSum / f64.from(gpuN); print <- " ms\n";
  let cnt = cardCounts(&p.hair);
  print <- "  hair: "; print <- i64.from(p.hair.strandCount()); print <- " strands, "; print <- i64.from(p.hair.particleCount()); print <- " particles, "; print <- i64.from(cnt.0);
  print <- " card vertices, "; print <- i64.from(cnt.1 / 3usize); print <- " triangles\n";
  p.hair.stop();
  ok;
}

fn hasShot(p &Person, k i32) bool { (p.flags & (1u32 << u32.from(k))) != 0u32; }
fn markShot(p &mut Person, k i32) { p.flags = p.flags | (1u32 << u32.from(k)); }

// ------------------------------------------------------------------------------ the four-legged test body

struct BodyField {
  a List[Vec3];
  b List[Vec3];
  ra List[f32];
  rb List[f32];
  k f32;

  pub fn distance(self &, p Vec3) f32 {
    var d = 3.0e38;
    var i = 0usize;
    while i < a.len() {
      let c = taperedCapsule(p, *a[i], *b[i], *ra[i], *rb[i]);
      d = if i == 0usize { c; } else { smoothUnion(d, c, k); };
      i = i + 1usize;
    }
    d;
  }
}

// The body: a capsule on every segment of the rig (a joint to its child), meshed by surface nets
fn bodyMesh(rig &Rig, cell f32, blend f32) Mesh {
  var f = new BodyField(List[Vec3].empty(), List[Vec3].empty(), List[f32].empty(), List[f32].empty(), blend);
  var lo = new Vec3(1.0e9, 1.0e9, 1.0e9);
  var hi = new Vec3(-1.0e9, -1.0e9, -1.0e9);
  var big f32 = 0.;
  var i = 0usize;
  while i < rig.boneCount() {
    let p = rig.skeleton.parentOf(i);
    if p >= 0i32 {
      let pa = rig.restPosition(usize.from(p));
      let pb = rig.restPosition(i);
      f.a.push(pa); f.b.push(pb);
      f.ra.push(*rig.radii[usize.from(p)]); f.rb.push(*rig.radii[i]);
      lo = lo.min(pa.min(pb));
      hi = hi.max(pa.max(pb));
      if *rig.radii[i] > big { big = *rig.radii[i]; }
      if *rig.radii[usize.from(p)] > big { big = *rig.radii[usize.from(p)]; }
    }
    i = i + 1usize;
  }
  let m = new Vec3(big + 0.05, big + 0.05, big + 0.05);
  let net = surfaceNet(&f, new Aabb3(lo - m, hi + m), cell, 1u32, false);
  net.toMesh();
}

fn makeSkin(w &VertexWeights) Skin {
  var s = Skin.empty();
  var v = 0usize;
  while v < w.vertexCount() {
    s.push(u32.from(w.joint(v, 0usize)), u32.from(w.joint(v, 1usize)), u32.from(w.joint(v, 2usize)), u32.from(w.joint(v, 3usize)),
      w.weight(v, 0usize), w.weight(v, 1usize), w.weight(v, 2usize), w.weight(v, 3usize));
    v = v + 1usize;
  }
  s;
}

struct Horse {
  rig Rig;
  loco Locomotion;
  morphed MorphHandle;
  bodyMesh MeshHandle;
  bodyMat MaterialHandle;
  breathing Breathing;
  regions SoftRegions;
  attention Attention;
  look LookChain;
  headBone usize;
  bodyBone usize;
  pose Pose;
  models List[Transform3];
  mats List[Mat4];
  strands StrandSim;
  strandMesh MeshHandle;
  strandMat MaterialHandle;
  scratch Mesh;
  groupBone List[usize];
  colliders List[Collider];
  neckBones List[usize];
  tailBones List[usize];
  spineBones List[usize];
  state BreathState;
  flags u32;
}

fn horseRegions(rig &Rig) List[SoftRegion] {
  let s0 = usize.from(rig.boneIndex("spine/s0"));
  let s1 = usize.from(rig.boneIndex("spine/s1"));
  var r = List[SoftRegion].empty();
  r.push(SoftRegion.make("barrel left", s1, new Vec3(0., 0., 0.), new Vec3(-1., 0., 0.), new Vec3(0.12, 0.17, 0.26)).breathing(REGION_CHEST, 1.));
  r.push(SoftRegion.make("barrel right", s1, new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), new Vec3(0.12, 0.17, 0.26)).breathing(REGION_CHEST, 1.));
  r.push(SoftRegion.make("belly", s1, new Vec3(0., 0., 0.), new Vec3(0., -1., 0.), new Vec3(0.17, 0.12, 0.26)).breathing(REGION_BELLY, 0.8)
    .jiggling(2.6, 0.18, 0.035, new Vec3(0.5, 1., 0.6)));
  r.push(SoftRegion.make("flank left", s0, new Vec3(0., 0., 0.), new Vec3(-1., 0., 0.), new Vec3(0.12, 0.15, 0.22)).jiggling(3.2, 0.2, 0.03, new Vec3(1., 1., 0.7)));
  r.push(SoftRegion.make("flank right", s0, new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), new Vec3(0.12, 0.15, 0.22)).jiggling(3.2, 0.2, 0.03, new Vec3(1., 1., 0.7)));
  r;
}

fn chainBones(rig &Rig, name &str) List[usize] {
  var out = List[usize].empty();
  let c = rig.chainIndex(name);
  if c < 0i32 { return out; }
  var i = 0usize;
  while i < rig.chains[usize.from(c)].bones.len() { out.push(*rig.chains[usize.from(c)].bones[i]); i = i + 1usize; }
  out;
}

fn makeHorse(device &mut Device, st &mut Stage, seed u32) Horse {
  var built = buildRig(&plainBody(&BodyParams.quadruped()));
  let rig = built.take();
  let mesh = bodyMesh(&rig, 0.03, 0.02);
  let params = WeightParams.standard();
  let w = heatWeights(&rig, &mesh, &params);
  let skin = makeSkin(&w);
  let regions = horseRegions(&rig);
  let tg = buildRegionTargets(&mesh, &rig.restModels, &regions);
  let nT = tg.count();
  let sr = SoftRegions.make(horseRegions(&rig), tg, &rig.restModels);
  var mt = MorphTargets.empty(mesh.positions.len());
  let noTan = List[Vec3].empty();
  var t = 0usize;
  while t < nT {
    mt.addSparse(&sr.tg.targets.indicesOf(t), &sr.tg.targets.positionsOf(t), &sr.tg.targets.normalsOf(t), &noTan);
    t = t + 1usize;
  }
  let set = st.morpher.addSet(device, &mt, &mesh);
  let baseMesh = st.renderer.addSkinnedMesh(device, &mesh, &skin);
  var enc0 = device.createCommandEncoder();
  let copy = st.morpher.addCopy(device, &mut enc0, &mut st.renderer, baseMesh, set, false);
  device.queue.submit(enc0.finish());
  device.endFrame();
  device.waitIdle();
  var bm = PbrMaterial.standard(new Color(0.30, 0.17, 0.09, 1.), 0., 0.62);
  let bodyMat = st.renderer.addPbrMaterial(device, &bm);
  let spine = chainBones(&rig, "spine");
  let neck = chainBones(&rig, "neck");
  let tail = chainBones(&rig, "tail");
  let head = chainBones(&rig, "head");
  // look-at: the front of the spine, the neck, the head
  var lb = List[usize].empty();
  var ls = List[f32].empty();
  lb.push(*spine[spine.len() - 1usize]); ls.push(0.05);
  var k = 0usize;
  while k < neck.len() { lb.push(*neck[k]); ls.push(0.15 + 0.1 * f32.from(k)); k = k + 1usize; }
  lb.push(*head[0usize]); ls.push(0.4);
  var look = LookChain.make(lb, ls, *spine[0usize], new Vec3(0., 0., -0.08));
  look.normalized();
  look.maxYaw = radians(70.);
  // strands: a mane on each neck bone's stretch of the crest, a tail on each tail bone's
  var sim = StrandSim.make(Medium.air(WindField.breeze(new Vec3(2.8, 0., 1.2))), 1u32);
  var gb = List[usize].empty();
  var roots = List[StrandRoot].empty();
  k = 0usize;
  while k < neck.len() {
    let b = *neck[k];
    let nextB = if k + 1usize < neck.len() { *neck[k + 1usize]; } else { *head[0usize]; };
    var mst = StrandStyle.mane();
    mst.fall = new Vec3(0.9, -1., 0.15).normalize();
    let g = sim.addGroup(*rig.restModels[b], mst);
    gb.push(b);
    let up = new Vec3(0., *rig.radii[b] * 0.8, 0.);
    var pts = List[Vec3].empty(); var dirs = List[Vec3].empty(); var nrm = List[Vec3].empty();
    pts.push(rig.restPosition(b) + up); pts.push(rig.restPosition(nextB) + up);
    dirs.push(new Vec3(0., 0.9, 0.4).normalize()); dirs.push(new Vec3(0., 0.9, 0.4).normalize());
    nrm.push(new Vec3(1., 0., 0.)); nrm.push(new Vec3(1., 0., 0.));
    let rs = rootsAlongPath(g, &pts, &dirs, &nrm, 22usize, 0.8, seed + u32.from(k) * 13u32);
    let inv = (*rig.restModels[b]).inverse();
    var i = 0usize;
    while i < rs.len() {
      roots.push(new StrandRoot(g, inv.transformPoint(rs[i].pos), (inv.rotation * rs[i].dir).normalize(), (inv.rotation * rs[i].normal).normalize(), rs[i].seed));
      i = i + 1usize;
    }
    k = k + 1usize;
  }
  k = 0usize;
  while k < tail.len() {
    let b = *tail[k];
    let nextB = if k + 1usize < tail.len() { *tail[k + 1usize]; } else { b; };
    var tst = StrandStyle.tail();
    tst.length = 0.62;
    let g = sim.addGroup(*rig.restModels[b], tst);
    gb.push(b);
    var pts = List[Vec3].empty(); var dirs = List[Vec3].empty(); var nrm = List[Vec3].empty();
    let a = rig.restPosition(b);
    let bpos = if nextB != b { rig.restPosition(nextB); } else { a + new Vec3(0., 0., 0.06); };
    pts.push(a); pts.push(bpos);
    dirs.push(new Vec3(0., -0.35, 1.).normalize()); dirs.push(new Vec3(0., -0.35, 1.).normalize());
    nrm.push(new Vec3(1., 0., 0.)); nrm.push(new Vec3(1., 0., 0.));
    let rs = rootsAlongPath(g, &pts, &dirs, &nrm, 16usize, 0.9, seed + 500u32 + u32.from(k) * 17u32);
    let inv = (*rig.restModels[b]).inverse();
    var i = 0usize;
    while i < rs.len() {
      roots.push(new StrandRoot(g, inv.transformPoint(rs[i].pos), (inv.rotation * rs[i].dir).normalize(), (inv.rotation * rs[i].normal).normalize(), rs[i].seed));
      i = i + 1usize;
    }
    k = k + 1usize;
  }
  sim.addStrands(&roots);
  let cnt = cardCounts(&sim);
  let strandMesh = st.renderer.addDynamicMesh(device, u32.from(cnt.0), u32.from(cnt.1));
  let fibres = paintFibers(4, 64, 256, 14, 9u32);
  var img = new Image(fibres.width, fibres.height, 4, List[u8].empty());
  var q = 0usize;
  while q < fibres.rgba.len() { img.pixels.push(*fibres.rgba[q]); q = q + 1usize; }
  let tex = st.renderer.addCutoutTexture(device, &img, 0.45);
  var hm = PbrMaterial.standard(new Color(0.05, 0.035, 0.025, 1.), 0., 0.6);
  hm.texture = tex;
  hm.alphaMode = ALPHA_MASK;
  hm.alphaCutoff = 0.45;
  hm.specularScale = 0.4;
  let strandMat = st.renderer.addPbrMaterial(device, &hm);
  let loco = Locomotion.make(&rig);
  new Horse(rig, loco, copy, st.morpher.mesh(copy), bodyMat, Breathing.make(ExertionParams.quick(), 1.5, seed), sr,
    Attention.make(AttentionParams.standard(), seed), look, *head[0usize], *spine[0usize], Pose.empty(), List[Transform3].empty(), List[Mat4].empty(),
    sim, strandMesh, strandMat, Mesh.empty(), gb, List[Collider].empty(), neck, tail, spine,
    new BreathState(0., 0., 1., 0.22, 0., 0., true, 0., 0., 0., 0., 0.), 0u32);
}

fn horseSpeed(t0 f32) f32 {
  let t = t0 - 4.;
  if t < 3. { return 0.; }
  if t < 5. { return 1.35 * smoothstep(3., 5., t); }
  if t < 11. { return 1.35; }
  if t < 13. { return 1.35 + (3.2 - 1.35) * smoothstep(11., 13., t); }
  if t < 22. { return 3.2; }
  if t < 25. { return 3.2 * (1. - smoothstep(22., 25., t)); }
  0.;
}

fn horseWork(speed f32) f32 { clampf(speed / 4., 0., 1.) * 1.1; }

fn stepHorse(h &mut Horse, x f32, z f32, speed f32, dt f32) {
  h.loco.update(&h.rig, dt, x, z, 0., &flat);
  h.pose = h.loco.pose.copy();
  h.rig.skeleton.modelTransforms(&h.pose, &mut h.models);
  h.state = h.breathing.update(dt, horseWork(speed));
  // looking: the attention's direction from the head, in the body's frame
  h.attention.update(dt, &List[Vec3].empty());
  let headW = (*h.models[h.headBone]).transformPoint(new Vec3(0., 0., -0.08));
  let bodyRot = (*h.models[h.bodyBone]).rotation;
  h.look.aim(&h.rig.skeleton, &mut h.pose, &mut h.models, headW + bodyRot * h.attention.direction() * 4., 0.8);
  h.regions.update(dt, &h.loco.world, &h.models, &h.state);
  // the strands: each group on its bone, the body's capsules as colliders
  h.colliders.clear();
  var i = 0usize;
  while i < h.rig.boneCount() {
    let p = h.rig.skeleton.parentOf(i);
    let isTrunk = h.rig.boneChain[i] == h.rig.boneChain[h.bodyBone] or i == *h.neckBones[0usize] or i == h.headBone;
    if p >= 0i32 and isTrunk {
      let a = h.loco.world.transformPoint((*h.models[usize.from(p)]).translation);
      let b = h.loco.world.transformPoint((*h.models[i]).translation);
      h.colliders.push(Collider.capsule(a, b, *h.rig.radii[usize.from(p)] * 0.98));
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < h.groupBone.len() {
    h.strands.setFrame(i, h.loco.world * *h.models[*h.groupBone[i]]);
    h.strands.setColliders(i, &h.colliders);
    i = i + 1usize;
  }
  h.strands.step(dt);
}

fn drawHorse(st &mut Stage, device &mut Device, h &mut Horse, list &mut DrawList) {
  h.mats.clear();
  let sk = skinTransforms(&h.rig, &h.models);
  var i = 0usize;
  while i < sk.len() { h.mats.push(sk[i].toMat4()); i = i + 1usize; }
  st.morpher.setWeights(&mut st.renderer, h.morphed, &h.regions.weights);
  list.addSkinned(h.bodyMesh, h.bodyMat, h.loco.world.toMat4(), h.mats.view());
  writeCards(&h.strands, &mut h.scratch, 4u32, 1.);
  st.renderer.writeDynamicMesh(device, h.strandMesh, &h.scratch);
  list.add(h.strandMesh, h.strandMat, Mat4.identity());
}

fn runHorse(device &mut Device, st &mut Stage, outDir &str) bool {
  var h = makeHorse(device, st, 5u32);
  let dt = 1. / 60.;
  var t f32 = 0.;
  var z f32 = 0.;
  var frame = 0;
  var shots = 0;
  var maxBelly f32 = 0.;
  while t < 30. {
    let speed = horseSpeed(t);
    z = z - speed * dt;
    stepHorse(&mut h, 0., z, speed, dt);
    if h.state.belly > maxBelly { maxBelly = h.state.belly; }
    var name = String.empty();
    var cam = camera(new Vec3(5.2, 1.3, z - 0.6), new Vec3(0., 0.8, z - 0.6), 36.);
    let fill = h.state.fill;
    if t < 6.5 and fill < 0.02 and t > 0.5 and (h.flags & 1u32) == 0u32 { name = String.from("horse-empty"); h.flags = h.flags | 1u32; cam = camera(new Vec3(3.2, 1.0, z - 0.1), new Vec3(0., 0.8, z - 0.1), 34.); }
    if t < 6.5 and fill > 0.995 and t > 0.5 and (h.flags & 2u32) == 0u32 { name = String.from("horse-full"); h.flags = h.flags | 2u32; cam = camera(new Vec3(3.2, 1.0, z - 0.1), new Vec3(0., 0.8, z - 0.1), 34.); }
    if t >= 2.5 and t < 2.6 and (h.flags & 4u32) == 0u32 { name = String.from("horse-stand-3q"); h.flags = h.flags | 4u32; cam = camera(new Vec3(-2.6, 1.5, z - 3.2), new Vec3(0., 0.9, z), 34.); }
    if t >= 12. and t < 12.6 and frame % 9 == 0 { name = String.from("horse-walk"); name <- "-"; name <- i64.from(frame); }
    if t >= 20. and t < 20.6 and frame % 6 == 0 { name = String.from("horse-trot"); name <- "-"; name <- i64.from(frame); }
    if name.len() > 0usize {
      var list = DrawList.empty();
      list.add(st.groundMesh, st.groundMat, slab(new Vec3(0., -0.05, z - 8.), new Vec3(40., 0.1, 60.)));
      drawHorse(st, device, &mut h, &mut list);
      drawFrame(device, st, &cam, &list, fileName(outDir, name.view()).view());
      shots = shots + 1;
    }
    t = t + dt;
    frame = frame + 1;
  }
  print <- "horse: "; print <- i64.from(shots); print <- " pictures\n";
  // the soak: a trot, all drawn
  var soak = Costs.make();
  var gpuSum f64 = 0d;
  var gpuN = 0;
  var k = 0;
  while k < 600 {
    z = z - 3.2 * dt;
    let a0 = Instant.now();
    stepHorse(&mut h, 0., z, 3.2, dt);
    soak.add("horse: locomotion, breath, look, soft regions, strands (mane and tail)", a0.elapsed().nanos() / 1000i64);
    let a2 = Instant.now();
    var list = DrawList.empty();
    list.add(st.groundMesh, st.groundMat, slab(new Vec3(0., -0.05, z - 8.), new Vec3(40., 0.1, 60.)));
    drawHorse(st, device, &mut h, &mut list);
    soak.add("draw list: skin matrices, morph weights, strand cards written and uploaded", a2.elapsed().nanos() / 1000i64);
    let cam = camera(new Vec3(5.2, 1.3, z - 0.6), new Vec3(0., 0.8, z - 0.6), 36.);
    let a3 = Instant.now();
    let ms = drawFrame(device, st, &cam, &list, "");
    soak.add("render call and the wait for the GPU", a3.elapsed().nanos() / 1000i64);
    if k >= 60 { gpuSum = gpuSum + ms; gpuN = gpuN + 1; }
    k = k + 1;
  }
  soak.report("horse (soak of 600 frames at a trot)");
  print <- "  GPU time of a frame, mean: "; print <- gpuSum / f64.from(gpuN); print <- " ms\n";
  let cnt = cardCounts(&h.strands);
  print <- "  strands: "; print <- i64.from(h.strands.strandCount()); print <- " in "; print <- i64.from(h.strands.groupCount()); print <- " groups, ";
  print <- i64.from(h.strands.particleCount()); print <- " particles, "; print <- i64.from(cnt.1 / 3usize); print <- " card triangles\n";
  h.strands.stop();
  true;
}

fn main(argc i32, argv **u8) i32 {
  var outDir = String.from(".");
  var scene = String.from("all");
  var a = 1;
  while a < argc {
    if cstrEquals(*(argv + usize.from(a)), "--out") and a + 1 < argc {
      outDir = String.empty();
      var q = 0usize;
      let s = *(argv + usize.from(a + 1));
      while *(s + q) != 0u8 { outDir.appendByte(*(s + q)); q = q + 1usize; }
      a = a + 1;
    }
    if cstrEquals(*(argv + usize.from(a)), "--scene") and a + 1 < argc {
      scene = String.empty();
      var q = 0usize;
      let s = *(argv + usize.from(a + 1));
      while *(s + q) != 0u8 { scene.appendByte(*(s + q)); q = q + 1usize; }
      a = a + 1;
    }
    a = a + 1;
  }
  var instance = Instance.create("livingbody alive");
  if !instance.isValid() { print <- "FAIL: no Vulkan instance\n"; return 1i32; }
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  var device = adapter.requestDevice();
  if !device.isValid() { print <- "FAIL: no device\n"; return 1i32; }
  var st = makeStage(&mut device);
  if !st.renderer.isValid() { print <- "FAIL: no renderer\n"; return 1i32; }
  var ok = true;
  if scene.view() == "all" or scene.view() == "man" { if !runMan(&mut device, &mut st, outDir.view()) { ok = false; } }
  if scene.view() == "all" or scene.view() == "horse" { if !runHorse(&mut device, &mut st, outDir.view()) { ok = false; } }
  if failures() != 0u32 { print <- "FAIL: a Vulkan call failed\n"; ok = false; }
  if validationMessages() != 0u32 { print <- "FAIL: validation messages\n"; ok = false; }
  if ok { print <- "ok\n"; return 0i32; }
  1i32;
}
