// Soft regions: the chest and belly that breathe, and the flesh that lags and jiggles, on top of skinning.
//
// THE METHOD, in two halves.
//
// 1. THE SHAPE: SOFT-SELECTION MORPH TARGETS. A region is a place on the skin: a point inside the body on a bone's axis,
//    and the way out through the skin from there. A ray from the point finds the skin of whatever mesh the body is (so the
//    same table serves a mannequin and a quadruped), and around that landmark an ellipsoid of influence moves the surface
//    by a centimetre in a direction: OUT along the skin's normal for a breath, and along each world axis for a jiggle.
//    This is facerig's landmark-driven deformation (a soft-selection brush with a falloff, as a modelling package has it),
//    and facerig's own 'buildTargets' builds them: a region table is a FaceSpec of landmarks and a list of influences, so
//    nothing was written twice. The targets go to render's morph pre-pass, which sums weight x displacement and then
//    skins: the flesh moves, and the bones carry it.
// 2. THE MOTION: A DAMPED SPRING PER REGION. Soft tissue lags the bone it hangs on and rings when the bone stops. Each
//    region is a mass on a second-order spring (natural frequency f, damping ratio zeta) following its landmark's world
//    position as the bone carries it: y'' = w^2 (a - y) + 2 zeta w (a' - y'), the textbook mass-spring-damper
//    ("secondary motion"; the jiggle bones of Unity's DynamicBone and Unreal's physics-asset chains do the same to a
//    bone). It is stepped semi-implicitly in substeps of at most 6 ms, so it is stable at any frame rate, and the
//    displacement y - a is held to a maximum (a tissue has only so much give). The displacement, in the world, is turned
//    back into the bind pose's frame (the bone's current rotation undone and its rest rotation done), because the morph
//    comes BEFORE the skinning, which turns it again to where it started: what shows is the displacement the spring made.
//    Its weights are in centimetres of travel along x, y and z, three targets per region, so a spring in any direction is
//    a signed sum of three fixed shapes (render's morph weights are not limited to 0..1).
//
// A cheek is a region on the head bone with a frequency of 6 Hz; a belly one at 3 Hz and a damping ratio of 0.2; a
// horse's flank one on a spine bone. The frequencies and ratios are tuned by eye, not measured on tissue.

pub const REGION_NONE = 0u32;
pub const REGION_CHEST = 1u32;      // breathes with the chest wall
pub const REGION_BELLY = 2u32;      // breathes with the belly

pub struct SoftRegion {
  pub name: String;
  pub bone: usize;
  pub from: Vec3;            // a point inside the body, in the bone's frame at rest
  pub dir: Vec3;             // the way out through the skin, in the bone's frame at rest
  pub radii: Vec3;           // the region's reach, metres along the model's x, y and z
  pub breath: u32;           // REGION_*
  pub breathGain: f32;       // the share of the breath's travel this region shows
  pub jiggle: bool;
  pub freq: f32;             // the spring's natural frequency, Hz
  pub zeta: f32;             // its damping ratio
  pub maxDisp: f32;          // the most it gives, metres
  pub gain: Vec3;            // the share of the lag it shows along each WORLD axis

  pub fn make(name: &str, bone: usize, from: Vec3, dir: Vec3, radii: Vec3) SoftRegion {
    SoftRegion(String.from(name), bone, from, dir.normalize(), radii, REGION_NONE, 1., false, 3., 0.2, 0.03,
      Vec3(1., 1., 1.))
  }

  // The region rises and falls with the breath: REGION_CHEST or REGION_BELLY, showing 'gain' of its travel
  pub fn breathing(self, kind: u32, gain: f32) SoftRegion {
    var r = self;
    r.breath = kind;
    r.breathGain = gain;
    r
  }

  // The region lags and rings: a spring of 'freq' Hz and damping ratio 'zeta', giving at most 'maxDisp' metres
  pub fn jiggling(self, freq: f32, zeta: f32, maxDisp: f32, gain: Vec3) SoftRegion {
    var r = self;
    r.jiggle = true;
    r.freq = freq;
    r.zeta = zeta;
    r.maxDisp = maxDisp;
    r.gain = gain;
    r
  }
}

// A target is built for one centimetre of travel
const UNIT = 0.01f;

// The targets of a region table over a mesh, and which is which
pub struct RegionTargets {
  pub targets: FaceTargets;
  pub breathTarget: List[i32];     // for each region: its breath target, or -1
  pub axisTarget: List[i32];       // three a region (x, y, z), or -1
  pub landmarks: List[Vec3];       // where each region found the skin, model space at rest
  pub normals: List[Vec3];         // and the way out there

  pub fn count(self: &) usize { targets.count() }
}

// The nearest hit of a ray on a mesh: the distance, or -1
fn skinDistance(mesh: &Mesh, origin: Vec3, dir: Vec3) f32 {
  let ray = Ray3(origin, dir);
  var best: f32 = -1.;
  var t = 0usize;
  while t + 2usize < mesh.indices.len() {
    let a = *mesh.positions[usize.from(*mesh.indices[t])];
    let b = *mesh.positions[usize.from(*mesh.indices[t + 1usize])];
    let c = *mesh.positions[usize.from(*mesh.indices[t + 2usize])];
    match ray.intersectTriangle(a, b, c) {
      case let Some(d) { if best < 0. || d < best { best = d; } }
      case is None { }
    }
    t = t + 3usize;
  }
  best
}

// Build the targets of a region table over 'mesh' (bind pose, with normals) for a skeleton whose bones are 'restModels'
// at rest
pub fn buildRegionTargets(mesh: &Mesh, restModels: &List[Transform3], regions: &List[SoftRegion]) RegionTargets {
  var spec = FaceSpec.empty();
  spec.scale = UNIT;
  var units = List[UnitDef].empty();
  var breathUnit = List[i32].empty();
  var axisUnit = List[i32].empty();
  var landmarks = List[Vec3].empty();
  var normals = List[Vec3].empty();
  var ri = 0usize;
  while ri < regions.len() {
    let r = &regions[ri];
    let m = *restModels[r.bone];
    let p0 = m.transformPoint(r.from);
    let d = (m.rotation * r.dir).normalize();
    let t = skinDistance(mesh, p0, d);
    let lm = if t >= 0. { p0 + d * t } else { p0 + d * 0.1 };
    landmarks.push(lm);
    normals.push(d);
    var label = String.from("r");
    label <- i64.from(ri);
    spec.add(label.view(), lm);
    let rad = r.radii * (1. / UNIT);
    if r.breath != REGION_NONE {
      var u = UnitDef.morph(r.name.view(), 1000u32 + u32.from(ri) * 4u32, SIDE_BOTH);
      u.add(Influence.moveNear(label.view(), d, rad));
      breathUnit.push(i32.from(units.len()));
      units.push(u);
    } else {
      breathUnit.push(-1i32);
    }
    if r.jiggle {
      var k = 0u32;
      while k < 3u32 {
        let axis = if k == 0u32 { Vec3(1., 0., 0.) } else if k == 1u32 { Vec3(0., 1., 0.) } else { Vec3(0., 0., 1.) };
        var u = UnitDef.morph(r.name.view(), 1001u32 + u32.from(ri) * 4u32 + k, SIDE_BOTH);
        u.add(Influence.moveNear(label.view(), axis, rad));
        axisUnit.push(i32.from(units.len()));
        units.push(u);
        k = k + 1u32;
      }
    } else {
      axisUnit.push(-1i32); axisUnit.push(-1i32); axisUnit.push(-1i32);
    }
    ri = ri + 1usize;
  }
  let built = buildTargets(mesh, &spec, &units);
  var bt = List[i32].empty();
  var at = List[i32].empty();
  ri = 0usize;
  while ri < regions.len() {
    let bu = *breathUnit[ri];
    bt.push(if bu >= 0i32 { *built.unitTarget[usize.from(bu)] } else { -1i32 });
    var k = 0usize;
    while k < 3usize {
      let au = *axisUnit[ri * 3usize + k];
      at.push(if au >= 0i32 { *built.unitTarget[usize.from(au)] } else { -1i32 });
      k = k + 1usize;
    }
    ri = ri + 1usize;
  }
  RegionTargets(built, bt, at, landmarks, normals)
}

// One region's spring
pub struct Spring {
  pub y: Vec3;               // the mass, world
  pub v: Vec3;
  pub anchor: Vec3;          // the landmark's world position last frame
  pub ready: bool;
  pub offset: Vec3;          // y - anchor, after the limit and the gains

  // The spring follows a moving anchor 'a' for 'dt' seconds: natural frequency 'freq' Hz, damping ratio 'zeta'
  pub fn step(self: &mut, a: Vec3, dt: f32, freq: f32, zeta: f32) {
    if !ready || (a - anchor).length() > 0.6 {
      y = a;
      v = Vec3(0., 0., 0.);
      anchor = a;
      ready = true;
      offset = Vec3(0., 0., 0.);
      return;
    }
    if dt <= 0.00001 { return; }
    var av = (a - anchor) * (1. / dt);
    if av.length() > 14. { av = av.normalize() * 14.; }
    let w = 2. * pi * freq;
    var n = 1;
    while n < 8 && dt / f32.from(n) > 0.006 { n = n + 1; }
    let h = dt / f32.from(n);
    var k = 0;
    while k < n {
      let ak = anchor.lerp(a, f32.from(k) / f32.from(n));
      let acc = (ak - y) * (w * w) + (av - v) * (2. * zeta * w);
      v = v + acc * h;
      y = y + v * h;
      k = k + 1;
    }
    anchor = a;
    offset = y - a;
  }
}

pub struct SoftRegions {
  pub regions: List[SoftRegion];
  pub tg: RegionTargets;
  pub inBone: List[Vec3];        // each landmark in its bone's rest frame
  pub restRot: List[Quat];
  pub springs: List[Spring];
  pub weights: List[f32];        // one a target: this frame's morph weights

  pub fn make(regions: List[SoftRegion], tg: RegionTargets, restModels: &List[Transform3]) SoftRegions {
    var inBone = List[Vec3].empty();
    var rr = List[Quat].empty();
    var sp = List[Spring].empty();
    var i = 0usize;
    while i < regions.len() {
      let b = regions[i].bone;
      inBone.push((*restModels[b]).inverse().transformPoint(*tg.landmarks[i]));
      rr.push((*restModels[b]).rotation);
      sp.push(Spring(Vec3(0., 0., 0.), Vec3(0., 0., 0.), Vec3(0., 0., 0.), false, Vec3(0., 0., 0.)));
      i = i + 1usize;
    }
    var w = List[f32].empty();
    w.resize(tg.count(), 0.);
    SoftRegions(regions, tg, inBone, rr, sp, w)
  }

  // Advance 'dt' seconds with the skeleton posed ('models', in the model's space) and the model at 'world'. The morph
  // weights (one a target) are in 'weights' afterwards.
  pub fn update(self: &mut, dt: f32, world: &Transform3, models: &List[Transform3], breath: &BreathState) {
    var i = 0usize;
    while i < regions.len() {
      let r = &regions[i];
      let bone = world.rotation;
      let m = (*world) * (*models[r.bone]);
      if r.jiggle {
        let a = m.transformPoint(*inBone[i]);
        springs[i].step(a, dt, r.freq, r.zeta);
        var off = springs[i].offset;
        if off.length() > r.maxDisp { off = off.normalize() * r.maxDisp; }
        off = off * r.gain;
        // undo the bone's turn since rest, so that the skinning, which turns it again, leaves it as it is in the world
        let b = *restRot[i] * (m.rotation.conjugate() * off);
        var k = 0usize;
        while k < 3usize {
          let t = *tg.axisTarget[i * 3usize + k];
          if t >= 0i32 {
            let c = if k == 0usize { b.x } else if k == 1usize { b.y } else { b.z };
            weights.set(usize.from(t), c / UNIT);
          }
          k = k + 1usize;
        }
      }
      let bt = *tg.breathTarget[i];
      if bt >= 0i32 {
        let travel = if r.breath == REGION_CHEST { breath.chest } else { breath.belly };
        weights.set(usize.from(bt), travel * r.breathGain / UNIT);
      }
      i = i + 1usize;
    }
  }

  // The largest weight magnitude now, centimetres
  pub fn largest(self: &) f32 {
    var m: f32 = 0.;
    var i = 0usize;
    while i < weights.len() { m = fmaxf(m, absf(*weights[i])); i = i + 1usize; }
    m
  }
}
