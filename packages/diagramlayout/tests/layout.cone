// diagramlayout on the CPU: the graph model, the layered layout, the force layout, the
// router, incremental relayout, sequence diagrams and the 3-D tube mesh, each against
// something worked out by hand or an independent measure.
//
// 1. Model: a node added twice by key is one node; removing a node kills its edges; a
//    group's box holds its members.
// 2. Layered: a chain runs down in order; a diamond puts its two middle nodes in one row,
//    the top between them; a cycle is broken with one reversed edge and still lays out;
//    two edges that cross in the first order cross nowhere after the sweeps; boxes in a
//    layer are 'nodeSep' apart; left to right runs x increasing along edges.
// 3. Router: with a wall of boxes between two nodes every route is horizontal and vertical
//    segments, leaves the source's border and enters the target's, and no segment enters any
//    box; nothing falls back.
// 4. Incremental: a 40-node graph laid out, a leaf added, laid out again with stability: the
//    old nodes move by far less than if the graph is laid out afresh (measured, printed).
//    The same for removing a node, and for the force layout.
// 5. Force: a ring of 12 nodes ends with its edges within 25% of one another's length and no
//    box overlapping.
// 6. Sequence: three participants and a call, a call, two returns: the activations, their
//    nesting depth, the rows in order, and the gap a long label asks for.
// 7. Tube mesh: normals are unit; the vertices of the tube part lie at the radius from the path.

mod layout;

import testing use *;
import stdio use *;
import collections use *;
import geomath use *;
import mesh use Mesh;
import diagramlayout use *;

fn absf(a: f32) f32 { if a < 0. { return -a; } a }

fn box(g: &mut Graph, key: &str) u32 { g.addNode(key, key, 80., 32.) }

fn model() {
  var g = Graph.make();
  let a = box(&mut g, "a");
  let b = box(&mut g, "b");
  let a2 = box(&mut g, "a");
  expectUInt(u64.from(a), u64.from(a2), "adding a key twice gives the same node");
  expectUInt(u64.from(g.liveNodes()), 2u64, "two nodes");
  g.addEdge(a, b);
  g.addEdge(a, b);
  expectUInt(u64.from(g.liveEdges()), 1u64, "a second edge between the same nodes is the first");
  g.removeNode(b);
  expectUInt(u64.from(g.liveEdges()), 0u64, "removing a node removes its edges");
  let b2 = box(&mut g, "b");
  expect(b2 != b, "a removed node's id is not reused");
  let grp = g.addGroup("G", -1);
  g.setGroup(a, i32.from(grp));
  g.setGroup(b2, i32.from(grp));
  g.nodes[usize.from(a)].x = 100.;
  g.nodes[usize.from(a)].y = 50.;
  g.nodes[usize.from(b2)].x = 300.;
  g.nodes[usize.from(b2)].y = 150.;
  g.fitGroups(10., 20.);
  // members span x 60..340, y 34..166; with 10 padding and a 20 head: x 50, w 300, y 4, h 152 + 20
  expectFloat(f64.from(g.groups[usize.from(grp)].x), 50.0, 0.01, "group left");
  expectFloat(f64.from(g.groups[usize.from(grp)].w), 300.0, 0.01, "group width");
  expectFloat(f64.from(g.groups[usize.from(grp)].y), 4.0, 0.01, "group top (head included)");
  expectFloat(f64.from(g.groups[usize.from(grp)].h), 172.0, 0.01, "group height");
}

fn layered() {
  // chain
  var g = Graph.make();
  let a = box(&mut g, "a");
  let b = box(&mut g, "b");
  let c = box(&mut g, "c");
  g.addEdge(a, b);
  g.addEdge(b, c);
  let st = layoutLayered(&mut g, &LayeredOptions.make());
  expectUInt(u64.from(st.layers), 3u64, "a chain has three layers");
  expect(g.nodes[usize.from(a)].y < g.nodes[usize.from(b)].y && g.nodes[usize.from(b)].y < g.nodes[usize.from(c)].y, "chain runs down");
  expectFloat(f64.from(g.nodes[usize.from(a)].x), f64.from(g.nodes[usize.from(c)].x), 0.01, "a chain is straight");
  // rank gap = rankSep + box height
  expectFloat(f64.from(g.nodes[usize.from(b)].y - g.nodes[usize.from(a)].y), 70.0 + 32.0, 0.01, "layer spacing is rankSep plus the box");

  // diamond
  var d = Graph.make();
  let da = box(&mut d, "a");
  let db = box(&mut d, "b");
  let dc = box(&mut d, "c");
  let dd = box(&mut d, "d");
  d.addEdge(da, db);
  d.addEdge(da, dc);
  d.addEdge(db, dd);
  d.addEdge(dc, dd);
  let sd = layoutLayered(&mut d, &LayeredOptions.make());
  expectUInt(u64.from(sd.crossings), 0u64, "a diamond has no crossings");
  expectFloat(f64.from(d.nodes[usize.from(db)].y), f64.from(d.nodes[usize.from(dc)].y), 0.01, "b and c share a row");
  let lo = if d.nodes[usize.from(db)].x < d.nodes[usize.from(dc)].x { d.nodes[usize.from(db)].x } else { d.nodes[usize.from(dc)].x };
  let hi = if d.nodes[usize.from(db)].x < d.nodes[usize.from(dc)].x { d.nodes[usize.from(dc)].x } else { d.nodes[usize.from(db)].x };
  expect(d.nodes[usize.from(da)].x > lo && d.nodes[usize.from(da)].x < hi, "the top sits between the two");
  expectFloat(f64.from(hi - lo), 80.0 + 36.0, 0.5, "two boxes in a row are nodeSep apart");

  // a cycle
  var cy = Graph.make();
  let ca = box(&mut cy, "a");
  let cb = box(&mut cy, "b");
  let cc = box(&mut cy, "c");
  cy.addEdge(ca, cb);
  cy.addEdge(cb, cc);
  cy.addEdge(cc, ca);
  let sc = layoutLayered(&mut cy, &LayeredOptions.make());
  expectUInt(u64.from(sc.reversed), 1u64, "one edge of a 3-cycle is reversed");
  expectUInt(u64.from(sc.layers), 3u64, "and it lays out in three layers");

  // crossing removal: tops t1 t2, bottoms b1 b2, edges t1->b2 and t2->b1 in ids that start crossed
  var x = Graph.make();
  let t1 = box(&mut x, "t1");
  let t2 = box(&mut x, "t2");
  let b1 = box(&mut x, "b1");
  let b2 = box(&mut x, "b2");
  x.addEdge(t1, b2);
  x.addEdge(t2, b1);
  let sx = layoutLayered(&mut x, &LayeredOptions.make());
  expectUInt(u64.from(sx.crossings), 0u64, "two crossing edges are uncrossed by the sweeps");

  // left to right
  var lr = Graph.make();
  let la = box(&mut lr, "a");
  let lb = box(&mut lr, "b");
  lr.addEdge(la, lb);
  var opt = LayeredOptions.make();
  opt.direction = DIR_LR;
  layoutLayered(&mut lr, &opt);
  expect(lr.nodes[usize.from(la)].x < lr.nodes[usize.from(lb)].x, "left to right: x grows along the edge");
  expectFloat(f64.from(lr.nodes[usize.from(la)].y), f64.from(lr.nodes[usize.from(lb)].y), 0.01, "and they share a row");
  // a long edge makes dummies
  var lg = Graph.make();
  let l1 = box(&mut lg, "1");
  let l2 = box(&mut lg, "2");
  let l3 = box(&mut lg, "3");
  lg.addEdge(l1, l2);
  lg.addEdge(l2, l3);
  lg.addEdge(l1, l3);
  let sl = layoutLayered(&mut lg, &LayeredOptions.make());
  expectUInt(u64.from(sl.dummies), 1u64, "a edge over one layer makes one dummy");
}

// A graph of n nodes: a spine and branches, deterministic
fn bigGraph(g: &mut Graph, n: u32) {
  var i = 0u32;
  while i < n {
    var key = String.from("n");
    key.appendUInt(u64.from(i));
    g.addNode(key.view(), key.view(), 70., 30.);
    i = i + 1u32;
  }
  // a random recursive tree with extra cross edges (a linear congruential generator: the same every run)
  var seed = 12345u32;
  i = 1u32;
  while i < n {
    seed = seed * 1664525u32 + 1013904223u32;
    let parent = (seed >> 8u32) % i;
    g.addEdge(parent, i);
    seed = seed * 1664525u32 + 1013904223u32;
    if i > 3u32 && (seed >> 12u32) % 3u32 == 0u32 {
      seed = seed * 1664525u32 + 1013904223u32;
      g.addEdge((seed >> 8u32) % (i - 1u32), i);
    }
    i = i + 1u32;
  }
}

// How many pairs of live nodes that shared a row before swapped their left-right order
fn orderFlips(before: &List[Vec2], after: &List[Vec2], g: &Graph) u32 {
  var n = 0u32;
  var a = 0usize;
  while a < before.len() && a < after.len() {
    if g.nodes[a].alive {
      var b = a + 1usize;
      while b < before.len() && b < after.len() {
        if g.nodes[b].alive && absf((*before[a]).y - (*before[b]).y) < 0.5 {
          let d0 = (*before[a]).x - (*before[b]).x;
          let d1 = (*after[a]).x - (*after[b]).x;
          if d0 * d1 < 0. { n = n + 1u32; }
        }
        b = b + 1usize;
      }
    }
    a = a + 1usize;
  }
  n
}

fn incremental() {
  // layered
  var g = Graph.make();
  bigGraph(&mut g, 40u32);
  var opt = LayeredOptions.make();
  opt.routeEdges = false;
  layoutLayered(&mut g, &opt);
  let before = g.snapshot();
  let leaf = g.addNode("new", "new", 70., 30.);
  g.addEdge(12u32, leaf);
  var stable = LayeredOptions.make();
  stable.stability = 1.;
  layoutLayered(&mut g, &stable);
  let afterStable = g.snapshot();
  let dStable = displacement(&before, &afterStable, &g);
  // from scratch: the same graph with every node forgotten
  var h = Graph.make();
  bigGraph(&mut h, 40u32);
  h.addNode("new", "new", 70., 30.);
  h.addEdge(12u32, 40u32);
  layoutLayered(&mut h, &opt);
  let dFresh = displacement(&before, &h.snapshot(), &g);
  print <- "layered, one leaf added to 40 nodes: stable mean ", dStable.mean, " worst ", dStable.worst, " moved ", dStable.moved,
    "; fresh mean ", dFresh.mean, " worst ", dFresh.worst, " moved ", dFresh.moved, "\n";
  let flipsStable = orderFlips(&before, &afterStable, &g);
  let flipsFresh = orderFlips(&before, &h.snapshot(), &g);
  print <- "  pairs in one row whose left-right order flipped: stable ", flipsStable, ", fresh ", flipsFresh, "\n";
  expect(dStable.mean < dFresh.mean * 0.8, "a layered relayout moves the old nodes less than a fresh layout (mean)");
  expect(dStable.worst * 2. < dFresh.worst, "and its worst move is under half the fresh layout's");
  expect(flipsStable * 4u32 <= flipsFresh + 1u32, "and keeps the order within rows (a quarter of the flips or fewer)");

  // removing a node
  var g2 = Graph.make();
  bigGraph(&mut g2, 40u32);
  layoutLayered(&mut g2, &opt);
  let before2 = g2.snapshot();
  g2.removeNode(39u32);
  layoutLayered(&mut g2, &stable);
  let dRem = displacement(&before2, &g2.snapshot(), &g2);
  var h2 = Graph.make();
  bigGraph(&mut h2, 40u32);
  h2.removeNode(39u32);
  layoutLayered(&mut h2, &opt);
  let dRemFresh = displacement(&before2, &h2.snapshot(), &g2);
  print <- "layered, one leaf removed: mean ", dRem.mean, " worst ", dRem.worst, " moved ", dRem.moved, "; fresh mean ", dRemFresh.mean,
    " worst ", dRemFresh.worst, "\n";
  expect(dRem.mean < 20. && dRem.mean < dRemFresh.mean * 1.0 + 0.001, "removing a leaf moves the rest less than a fresh layout");

  // force
  var f = Graph.make();
  bigGraph(&mut f, 30u32);
  var fo = ForceOptions.make();
  layoutForce(&mut f, &fo);
  let fb = f.snapshot();
  let fl = f.addNode("new", "new", 70., 30.);
  f.addEdge(5u32, fl);
  layoutForce(&mut f, &fo);
  let dForce = displacement(&fb, &f.snapshot(), &f);
  print <- "force, one node added to 30: mean ", dForce.mean, " worst ", dForce.worst, " moved ", dForce.moved, "\n";
  var fresh = Graph.make();
  bigGraph(&mut fresh, 30u32);
  fresh.addNode("new", "new", 70., 30.);
  fresh.addEdge(5u32, 30u32);
  layoutForce(&mut fresh, &fo);
  let dFreshF = displacement(&fb, &fresh.snapshot(), &f);
  print <- "force, from scratch: mean ", dFreshF.mean, " worst ", dFreshF.worst, "\n";
  expect(dForce.mean * 2. < dFreshF.mean, "a force relayout moves the old nodes far less than a fresh one");
}

fn forceRing() {
  var g = Graph.make();
  var i = 0u32;
  while i < 12u32 {
    var key = String.from("r");
    key.appendUInt(u64.from(i));
    g.addNode(key.view(), key.view(), 60., 28.);
    i = i + 1u32;
  }
  i = 0u32;
  while i < 12u32 { g.addEdge(i, (i + 1u32) % 12u32); i = i + 1u32; }
  let st = layoutForce(&mut g, &ForceOptions.make());
  var shortest = 1.0e30f;
  var longest = 0.0f;
  i = 0u32;
  while i < 12u32 {
    let a = g.nodes[usize.from(i)];
    let b = g.nodes[usize.from((i + 1u32) % 12u32)];
    let len = new Vec2(a.x - b.x, a.y - b.y).length();
    if len < shortest { shortest = len; }
    if len > longest { longest = len; }
    i = i + 1u32;
  }
  print <- "ring of 12: edge lengths ", shortest, " to ", longest, ", overlaps left ", st.overlapsLeft, "\n";
  expect(longest < shortest * 1.25, "a ring's edges come out within 25% of one another");
  expectUInt(u64.from(st.overlapsLeft), 0u64, "no boxes overlap");
}

fn segmentHitsBox(a: Vec2, b: Vec2, x0: f32, y0: f32, x1: f32, y1: f32) bool {
  // axis-aligned segment against the open box
  if absf(a.y - b.y) < 0.01 {
    let lo = if a.x < b.x { a.x } else { b.x };
    let hi = if a.x < b.x { b.x } else { a.x };
    return a.y > y0 + 0.01 && a.y < y1 - 0.01 && hi > x0 + 0.01 && lo < x1 - 0.01;
  }
  let lo = if a.y < b.y { a.y } else { b.y };
  let hi = if a.y < b.y { b.y } else { a.y };
  a.x > x0 + 0.01 && a.x < x1 - 0.01 && hi > y0 + 0.01 && lo < y1 - 0.01
}

fn routing() {
  // s at the left, t at the right, a wall of three boxes between them
  var g = Graph.make();
  let s = g.addNode("s", "s", 60., 40.);
  let t = g.addNode("t", "t", 60., 40.);
  g.nodes[usize.from(s)].x = 60.;
  g.nodes[usize.from(s)].y = 200.;
  g.nodes[usize.from(t)].x = 460.;
  g.nodes[usize.from(t)].y = 200.;
  var k = 0u32;
  while k < 3u32 {
    var key = String.from("w");
    key.appendUInt(u64.from(k));
    let w = g.addNode(key.view(), key.view(), 50., 120.);
    g.nodes[usize.from(w)].x = 260.;
    g.nodes[usize.from(w)].y = 80. + f32.from(k) * 160.;
    k = k + 1u32;
  }
  g.addEdge(s, t);
  var rop = RouteOptions.make();
  rop.flow = FLOW_HORIZONTAL;
  let st = routeEdges(&mut g, &rop);
  expectUInt(u64.from(st.fallback), 0u64, "a route is found round the wall");
  let route = &g.edges[0usize].route;
  expect(route.len() >= 2usize, "the route has points");
  var axis = true;
  var hits = false;
  var p = 1usize;
  while p < route.len() {
    let a = *route[p - 1usize];
    let b = *route[p];
    if absf(a.x - b.x) > 0.01 && absf(a.y - b.y) > 0.01 { axis = false; }
    var n = 0usize;
    while n < g.nodes.len() {
      if segmentHitsBox(a, b, g.left(n), g.top(n), g.right(n), g.bottom(n)) { hits = true; }
      n = n + 1usize;
    }
    p = p + 1usize;
  }
  expect(axis, "every segment is horizontal or vertical");
  expect(!hits, "no segment enters a box");
  expectFloat(f64.from((*route[0usize]).x), f64.from(g.right(usize.from(s))), 0.01, "starts on the source's east side");
  expectFloat(f64.from((*route[route.len() - 1usize]).x), f64.from(g.left(usize.from(t))), 0.01, "ends on the target's west side");
  // with the wall gone the route is a straight line
  var h = Graph.make();
  let s2 = h.addNode("s", "s", 60., 40.);
  let t2 = h.addNode("t", "t", 60., 40.);
  h.nodes[usize.from(s2)].x = 60.;
  h.nodes[usize.from(s2)].y = 100.;
  h.nodes[usize.from(t2)].x = 300.;
  h.nodes[usize.from(t2)].y = 100.;
  h.addEdge(s2, t2);
  routeEdges(&mut h, &rop);
  expectUInt(u64.from(h.edges[0usize].route.len()), 2u64, "an open way is one straight segment");
}

fn sequence() {
  var d = SequenceDiagram.make();
  let client = d.addParticipant("Client", 80., 30.);
  let server = d.addParticipant("Server", 80., 30.);
  let db = d.addParticipant("Database", 90., 30.);
  d.addMessage(client, server, "connect(address)", 200., MSG_CALL);
  d.addMessage(server, db, "load player", 90., MSG_CALL);
  d.addMessage(db, server, "player", 50., MSG_RETURN);
  d.addMessage(server, client, "welcome", 60., MSG_RETURN);
  layoutSequence(&mut d, &SequenceOptions.make());
  expect(d.participants[0usize].x < d.participants[1usize].x && d.participants[1usize].x < d.participants[2usize].x, "participants run left to right");
  expect(d.participants[1usize].x - d.participants[0usize].x >= 200.0 + 28., "the long label's gap is wide enough");
  expect(d.messages[0usize].y < d.messages[1usize].y && d.messages[2usize].y < d.messages[3usize].y, "messages run down in order");
  expectUInt(u64.from(d.activations.len()), 2u64, "two calls open two activations");
  // the server's activation runs from the connect call to the welcome return, the database's from its call to its return
  let sa = d.activations[0usize];
  let da = d.activations[1usize];
  expectUInt(u64.from(sa.participant), u64.from(server), "first activation is the server's");
  expectFloat(f64.from(sa.y0), f64.from(d.messages[0usize].y - 6.), 0.01, "it opens at the call");
  expectFloat(f64.from(sa.y1), f64.from(d.messages[3usize].y + 6.), 0.01, "and closes at the return to the client");
  expectUInt(u64.from(da.participant), u64.from(db), "second is the database's");
  expectFloat(f64.from(da.y1), f64.from(d.messages[2usize].y + 6.), 0.01, "it closes at its return");
  expectUInt(u64.from(sa.depth), 0u64, "not nested");
  // nesting: a second call to the server while it is busy sits one level in
  var e = SequenceDiagram.make();
  let a = e.addParticipant("A", 60., 30.);
  let b = e.addParticipant("B", 60., 30.);
  e.addMessage(a, b, "one", 40., MSG_CALL);
  e.addMessage(a, b, "two", 40., MSG_CALL);
  e.addMessage(b, a, "r2", 40., MSG_RETURN);
  e.addMessage(b, a, "r1", 40., MSG_RETURN);
  layoutSequence(&mut e, &SequenceOptions.make());
  expectUInt(u64.from(e.activations.len()), 2u64, "two nested activations");
  expectUInt(u64.from(e.activations[1usize].depth), 1u64, "the second is nested");
  expect(e.activations[1usize].x > e.activations[0usize].x, "and drawn to the right");
  expect(e.activations[1usize].y1 < e.activations[0usize].y1, "it closes first (the later return closes the inner)");
}

fn tube() {
  var path = List[Vec3].empty();
  var i = 0u32;
  while i <= 10u32 { path.push(new Vec3(f32.from(i) * 0.2, 0., 0.)); i = i + 1u32; }
  let m = tubeMesh(&path, 0.05, 0.3, 0.12, 8u32);
  var worstNormal = 0.0f;
  var v = 0usize;
  while v < m.normals.len() {
    let l = m.normals[v].length();
    if absf(l - 1.) > worstNormal { worstNormal = absf(l - 1.); }
    v = v + 1usize;
  }
  expectFloat(f64.from(worstNormal), 0.0, 0.001, "normals are unit length");
  // the tube part: vertices whose x is below the cone's base (2.0 - 0.3 = 1.7) lie 0.05 from the x axis
  var worstR = 0.0f;
  v = 0usize;
  while v < m.positions.len() {
    let p = *m.positions[v];
    if p.x < 1.69 {
      let r = (p.y * p.y + p.z * p.z).sqrt();
      if absf(r - 0.05) > worstR { worstR = absf(r - 0.05); }
    }
    v = v + 1usize;
  }
  expectFloat(f64.from(worstR), 0.0, 0.0005, "the tube's vertices lie at its radius from the path");
  // the tip is at the path's end
  var tipX = 0.0f;
  v = 0usize;
  while v < m.positions.len() { if (*m.positions[v]).x > tipX { tipX = (*m.positions[v]).x; } v = v + 1usize; }
  expectFloat(f64.from(tipX), 2.0, 0.001, "the arrow's tip is the path's end");
  // triangles: rings 0..k (k + 1 of them, the last at the cone's base) -> 2 * 8 * k, the cone 8, the base disc 8
  expect(m.indices.len() % 3usize == 0usize, "whole triangles");
  expect(m.indices.len() / 3usize >= 2usize * 8usize * 5usize + 16usize, "a mesh of rings, a cone and a base");
}

fn main() i32 {
  model();
  layered();
  incremental();
  forceRing();
  routing();
  sequence();
  tube();
  done()
}
