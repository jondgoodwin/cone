// ======== Drawing a graph and a sequence diagram on a vector2d Canvas ========
//
// Boxes (rounded, filled by the node's kind), their labels, group boxes with
// a title, routed edges with rounded corners and arrowheads, edge labels with a
// halo; for a sequence diagram: head boxes, dashed lifelines, activation bars,
// arrows and labels. All in the canvas's pixel units; the caller sizes the canvas
// and clears it.

pub struct DiagramStyle {
  pub fontSize f32;
  pub kindFills List[Color];       // by node kind (wraps)
  pub kindStrokes List[Color];
  pub textColor Color;
  pub edgeColor Color;
  pub edgeWidth f32;
  pub radius f32;                  // box corners
  pub cornerRadius f32;            // route corners
  pub groupFill Color;
  pub groupStroke Color;
  pub background Color;
  pub arrow ArrowStyle;

  pub fn light() DiagramStyle {
    mut fills = List[Color].empty();
    mut strokes = List[Color].empty();
    fills.push(new Color(0.84, 0.91, 0.99, 1.));
    strokes.push(new Color(0.22, 0.42, 0.75, 1.));
    fills.push(new Color(0.88, 0.96, 0.86, 1.));
    strokes.push(new Color(0.30, 0.58, 0.28, 1.));
    fills.push(new Color(0.99, 0.92, 0.80, 1.));
    strokes.push(new Color(0.78, 0.52, 0.12, 1.));
    fills.push(new Color(0.96, 0.86, 0.92, 1.));
    strokes.push(new Color(0.68, 0.25, 0.50, 1.));
    fills.push(new Color(0.90, 0.88, 0.97, 1.));
    strokes.push(new Color(0.42, 0.34, 0.72, 1.));
    fills.push(new Color(0.88, 0.93, 0.93, 1.));
    strokes.push(new Color(0.25, 0.55, 0.58, 1.));
    new DiagramStyle(14., fills, strokes, new Color(0.10, 0.11, 0.14, 1.), new Color(0.30, 0.33, 0.40, 1.), 1.6, 6., 8.,
      new Color(0.96, 0.97, 0.99, 1.), new Color(0.62, 0.66, 0.74, 1.), new Color(1., 1., 1., 1.),
      ArrowStyle.make(ARROW_TRIANGLE, 11., 8.));
  }
}

// A polyline with its corners rounded by quadratic curves of radius up to 'r'
pub fn roundedPath(pts &List[Vec2], r f32) VectorPath {
  mut p = VectorPath.make();
  imm n = pts.len();
  if n == 0usize { return p; }
  p.moveTo((*pts[0usize]).x, (*pts[0usize]).y);
  mut i = 1usize;
  while i + 1usize < n {
    imm a = *pts[i - 1usize];
    imm b = *pts[i];
    imm c = *pts[i + 1usize];
    imm la = a.distance(b);
    imm lc = b.distance(c);
    imm rr = minf2(r, minf2(la, lc) * 0.5);
    imm din = (b - a).normalize();
    imm dout = (c - b).normalize();
    imm s = b - din * rr;
    imm e = b + dout * rr;
    p.lineTo(s.x, s.y);
    p.quadTo(b.x, b.y, e.x, e.y);
    i = i + 1usize;
  }
  p.lineTo((*pts[n - 1usize]).x, (*pts[n - 1usize]).y);
  p;
}

fn wrapIndex(v &List[Color], k u32) Color {
  if v.len() == 0usize { return new Color(0.8, 0.8, 0.8, 1.); }
  *v[usize.from(k) % v.len()];
}

// The middle of a route's longest segment
fn labelSpot(route &List[Vec2]) Vec2 {
  mut best = 0.0f;
  mut spot = new Vec2(0., 0.);
  mut i = 1usize;
  while i < route.len() {
    imm d = route[i].distance(*route[i - 1usize]);
    if d >= best { best = d; spot = (*route[i]).lerp(*route[i - 1usize], 0.5); }
    i = i + 1usize;
  }
  spot;
}

pub fn drawGraph(c &mut Canvas, g &Graph, st &DiagramStyle) {
  // groups, outermost first (a child draws over its parent)
  mut gi = 0usize;
  while gi < g.groups.len() {
    if g.groups[gi].alive and g.groups[gi].w > 0. {
      imm gr = g.groups[gi];
      c.fillRoundRect(gr.x, gr.y, gr.w, gr.h, st.radius + 2., &Paint.solid(st.groupFill));
      c.strokeRoundRect(gr.x, gr.y, gr.w, gr.h, st.radius + 2., &Paint.solid(st.groupStroke), &StrokeStyle.dashed(1.2, 6., 4.));
      c.text(gr.label.view(), gr.x + 10., gr.y + 6., 0., 0., st.fontSize * 0.9, st.groupStroke);
    }
    gi = gi + 1usize;
  }
  // edges under the boxes
  mut e = 0usize;
  while e < g.edges.len() {
    if g.edges[e].alive and g.edges[e].route.len() >= 2usize {
      imm path = roundedPath(&g.edges[e].route, st.cornerRadius);
      mut style = StrokeStyle.make(st.edgeWidth);
      style.join = JOIN_ROUND;
      c.strokeArrows(&path, &Paint.solid(st.edgeColor), &style, &ArrowStyle.none(), &st.arrow);
      if g.edges[e].label.len() > 0usize {
        imm spot = labelSpot(&g.edges[e].route);
        c.textHalo(g.edges[e].label.view(), spot.x, spot.y, 0.5, 0.5, st.fontSize * 0.85, st.textColor, st.background, 3.);
      }
    }
    e = e + 1usize;
  }
  // boxes
  mut n = 0usize;
  while n < g.nodes.len() {
    if g.nodes[n].alive {
      imm nd = g.nodes[n];
      imm fill = wrapIndex(&st.kindFills, nd.kind);
      imm stroke = wrapIndex(&st.kindStrokes, nd.kind);
      c.fillRoundRect(nd.x - nd.w * 0.5, nd.y - nd.h * 0.5, nd.w, nd.h, st.radius, &Paint.solid(fill));
      c.strokeRoundRect(nd.x - nd.w * 0.5, nd.y - nd.h * 0.5, nd.w, nd.h, st.radius, &Paint.solid(stroke), &StrokeStyle.make(1.6));
      c.text(nd.label.view(), nd.x, nd.y, 0.5, 0.5, st.fontSize, st.textColor);
    }
    n = n + 1usize;
  }
}

pub fn drawSequence(c &mut Canvas, d &SequenceDiagram, st &DiagramStyle) {
  imm np = d.participants.len();
  // lifelines
  mut i = 0usize;
  while i < np {
    imm p = d.participants[i];
    c.line(p.x, d.lifelineTop, p.x, d.lifelineBottom, &Paint.solid(st.groupStroke), &StrokeStyle.dashed(1.2, 6., 5.));
    i = i + 1usize;
  }
  // activations
  i = 0usize;
  while i < d.activations.len() {
    imm a = d.activations[i];
    c.fillRect(a.x, a.y0, a.w, a.y1 - a.y0, new Color(1., 1., 1., 1.));
    c.strokeRoundRect(a.x, a.y0, a.w, a.y1 - a.y0, 0., &Paint.solid(st.edgeColor), &StrokeStyle.make(1.2));
    i = i + 1usize;
  }
  // messages
  imm filled = ArrowStyle.make(ARROW_TRIANGLE, 10., 7.);
  imm open = ArrowStyle.make(ARROW_OPEN, 9., 8.);
  imm half = 6.0f;
  mut m = 0usize;
  while m < d.messages.len() {
    imm msg = d.messages[m];
    imm a = d.participants[usize.from(msg.from)];
    imm b = d.participants[usize.from(msg.to)];
    mut path = VectorPath.make();
    mut style = StrokeStyle.make(1.5);
    if msg.kind == MSG_SELF {
      imm x0 = a.x + half;
      path.moveTo(x0, msg.y);
      path.lineTo(x0 + 34., msg.y);
      path.lineTo(x0 + 34., msg.y + 20.);
      path.lineTo(x0, msg.y + 20.);
      c.strokeArrows(&path, &Paint.solid(st.edgeColor), &style, &ArrowStyle.none(), &open);
      c.text(msg.label.view(), x0 + 40., msg.y + 4., 0., 0.5, st.fontSize * 0.9, st.textColor);
    } else {
      imm dir = if b.x > a.x { 1.0f; } else { -1.0f; };
      // the arrow runs from the edge of the source's bar to the edge of the target's
      imm x0 = a.x + dir * half;
      imm x1 = b.x - dir * half;
      path.moveTo(x0, msg.y);
      path.lineTo(x1, msg.y);
      if msg.kind == MSG_RETURN { style = StrokeStyle.dashed(1.5, 7., 4.); }
      imm head = if msg.kind == MSG_CALL { &filled; } else { &open; };
      c.strokeArrows(&path, &Paint.solid(st.edgeColor), &style, &ArrowStyle.none(), head);
      c.textHalo(msg.label.view(), (x0 + x1) * 0.5, msg.y - 5., 0.5, 1., st.fontSize * 0.9, st.textColor, st.background, 3.);
    }
    m = m + 1usize;
  }
  // head boxes top and bottom
  i = 0usize;
  while i < np {
    imm p = d.participants[i];
    imm fill = wrapIndex(&st.kindFills, u32.from(i));
    imm stroke = wrapIndex(&st.kindStrokes, u32.from(i));
    imm yTop = d.lifelineTop - p.h;
    c.fillRoundRect(p.x - p.w * 0.5, yTop, p.w, p.h, st.radius, &Paint.solid(fill));
    c.strokeRoundRect(p.x - p.w * 0.5, yTop, p.w, p.h, st.radius, &Paint.solid(stroke), &StrokeStyle.make(1.6));
    c.text(p.name.view(), p.x, yTop + p.h * 0.5, 0.5, 0.5, st.fontSize, st.textColor);
    c.fillRoundRect(p.x - p.w * 0.5, d.lifelineBottom, p.w, p.h, st.radius, &Paint.solid(fill));
    c.strokeRoundRect(p.x - p.w * 0.5, d.lifelineBottom, p.w, p.h, st.radius, &Paint.solid(stroke), &StrokeStyle.make(1.6));
    c.text(p.name.view(), p.x, d.lifelineBottom + p.h * 0.5, 0.5, 0.5, st.fontSize, st.textColor);
    i = i + 1usize;
  }
}
