// The diagramlayout package (a working name; the owner names packages): diagrams
// from data, laid out and routed, drawn in 2-D by vector2d and in 3-D by render.
// A program reaches it with 'import diagramlayout', and gets:
//
// - Graph (graph.cone): nodes with a size, a key, ports and a kind; edges;
//   groups; stable integer ids, with the key giving a graph updated from changed
//   code the same node again; 'displacement' between two layouts.
// - layoutLayered (layered.cone): Sugiyama layered layout, top to bottom, left to
//   right or reversed; incremental when nodes already have positions.
// - layoutForce (force.cone): Fruchterman-Reingold in the plane or in space,
//   incremental, with group cohesion and overlap removal.
// - routeEdges (route.cone): orthogonal connector routing that avoids the boxes.
// - SequenceDiagram, layoutSequence (sequence.cone): lifelines, messages,
//   activations.
// - drawGraph, drawSequence, roundedPath (draw.cone): the 2-D drawing on a
//   vector2d Canvas.
// - Diagram3d, buildDiagram3d, drawList3d, placeLabels, tubeMesh (scene3d.cone):
//   the 3-D rendition through render, boxes and tubes, labels by msdftext.
//
// A graph from code that changed:
//
//   g.addNode("render", "render", 96., 34.);           // by key: the same id if it exists
//   g.addEdgeByKey("render", "gpu");
//   g.removeNodeByKey("oldpkg");
//   layoutLayered(&mut g, &LayeredOptions.make());       // nodes that were placed stay near where they were
//
// Its files are one module, and only this one, the root, imports:
//
//   graph.cone, layered.cone, force.cone, route.cone, sequence.cone, draw.cone, scene3d.cone

mod diagramlayout;

import libc;
import collections use *;
import geomath use *;
import gpu use *;
import mesh use Mesh;
import render use Renderer, Camera, DrawList, MeshHandle, MaterialHandle, PbrMaterial;
import vector2d use *;
import msdftext use Font, Atlas, TextRenderer, TextStyle, TextHandle, SPACE_WORLD, layoutText, LayoutOptions, worldTransform, billboardPlacement;
