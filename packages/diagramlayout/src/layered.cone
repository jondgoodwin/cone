// ======== Layered layout (Sugiyama) ========
//
// The four classic phases (Sugiyama, Tagawa and Toda 1981; Gansner et al.
// 1993 "A technique for drawing directed graphs"), each a named method:
//
// 1. CYCLE REMOVAL: depth-first search; an edge to a node still on the stack
//    is reversed for the layout (and drawn the right way round).
// 2. LAYERING: longest path from the sources (every edge points down a layer),
//    then each source pulled down to sit one layer above its nearest successor
//    (it shortens its long edges). Not Gansner's network simplex: that minimises
//    the total edge length exactly; this is a heuristic.
// 3. CROSSING MINIMISATION: an edge spanning layers is cut by dummy vertices,
//    one a layer; layers are ordered by the barycentre heuristic (a vertex goes
//    to the mean position of its neighbours in the layer above, then below, in
//    alternate sweeps), with a transpose pass (swap neighbours when it lowers
//    the crossings), keeping the best order seen. The first order comes from
//    the previous layout's coordinates when there is one, and a sweep that does
//    not lower the crossings is not kept: so a graph that changed a little keeps
//    the order it had.
// 4. COORDINATES: not Brandes and Koepf: each layer in turn is placed at the
//    mean of its neighbours' positions in the layer next to it (weights 1, 2 and
//    4 for real-real, real-dummy, dummy-dummy edges, so long edges run
//    straight), subject to a minimum separation, solved exactly by weighted
//    isotonic regression (pool adjacent violators), in alternate down and up
//    sweeps. Each node that has an earlier position is also pulled to it with
//    a weight of 'stability' times 4, and the result is then shifted so its
//    placed nodes sit, on average, where they were.
//
// Then the edges are routed (route.cone). The direction (top to bottom, left to
// right, and their reverses) is a mapping of the same layout.

pub const DIR_TB = 0u32;
pub const DIR_LR = 1u32;
pub const DIR_BT = 2u32;
pub const DIR_RL = 3u32;

pub struct LayeredOptions {
  pub direction: u32;
  pub nodeSep: f32;                 // between boxes in a layer
  pub rankSep: f32;                 // between layers
  pub margin: f32;
  pub stability: f32;               // 0: a layout from scratch; 1: strongly attached to the earlier positions
  pub sweeps: u32;
  pub routeEdges: bool;

  pub fn make() LayeredOptions { LayeredOptions(DIR_TB, 36., 70., 24., 0., 24u32, true) }
}

pub struct LayeredStats {
  pub layers: u32;
  pub dummies: u32;
  pub crossings: u32;               // between adjacent layers, dummies counted
  pub reversed: u32;                // edges reversed to break cycles
}

struct Work {
  nodeOf: List[i32];                // vertex -> node id, or -1 for a dummy
  rank: List[i32];
  ext: List[f32];                   // across
  thick: List[f32];                 // along the ranks
  cx: List[f32];                    // across coordinate
  up: List[List[usize]];
  down: List[List[usize]];
  layers: List[List[usize]];
  pos: List[usize];
}

fn newWork() Work {
  Work(List[i32].empty(), List[i32].empty(), List[f32].empty(), List[f32].empty(), List[f32].empty(),
    List[List[usize]].empty(), List[List[usize]].empty(), List[List[usize]].empty(), List[usize].empty())
}

fn addVertex(w: &mut Work, node: i32, rank: i32, ext: f32, thick: f32) usize {
  w.nodeOf.push(node);
  w.rank.push(rank);
  w.ext.push(ext);
  w.thick.push(thick);
  w.cx.push(0.);
  w.up.push(List[usize].empty());
  w.down.push(List[usize].empty());
  w.pos.push(0usize);
  w.nodeOf.len() - 1usize
}

// ---- 1. cycle removal ----

fn dfsCycles(v: usize, outs: &List[List[usize]], ea: &List[usize], eb: &List[usize], color: &mut List[u32], flip: &mut List[bool]) {
  color.set(v, 1u32);
  var k = 0usize;
  while k < outs[v].len() {
    let e = *outs[v][k];
    let t = *eb[e];
    if *color[t] == 1u32 { flip.set(e, true); }
    else if *color[t] == 0u32 { dfsCycles(t, outs, ea, eb, color, flip); }
    k = k + 1usize;
  }
  color.set(v, 2u32);
}

// ---- 3. crossings ----

fn countCrossings(w: &Work, l: usize) u32 {
  // edges between layer l and l + 1 as (upper position, lower position)
  var a = List[usize].empty();
  var b = List[usize].empty();
  var i = 0usize;
  while i < w.layers[l].len() {
    let v = *w.layers[l][i];
    var k = 0usize;
    while k < w.down[v].len() {
      a.push(i);
      b.push(*w.pos[*w.down[v][k]]);
      k = k + 1usize;
    }
    i = i + 1usize;
  }
  var n = 0u32;
  var p = 0usize;
  while p < a.len() {
    var q = p + 1usize;
    while q < a.len() {
      if (*a[p] < *a[q] && *b[p] > *b[q]) || (*a[p] > *a[q] && *b[p] < *b[q]) { n = n + 1u32; }
      q = q + 1usize;
    }
    p = p + 1usize;
  }
  n
}

fn totalCrossings(w: &Work) u32 {
  var n = 0u32;
  var l = 0usize;
  while l + 1usize < w.layers.len() { n = n + countCrossings(w, l); l = l + 1usize; }
  n
}

fn setPositions(w: &mut Work, l: usize) {
  var i = 0usize;
  while i < w.layers[l].len() { w.pos.set(*w.layers[l][i], i); i = i + 1usize; }
}

// Crossings of the edges at layer l (with the layers either side), for the transpose pass
fn localCrossings(w: &Work, l: usize) u32 {
  var n = 0u32;
  if l > 0usize { n = n + countCrossings(w, l - 1usize); }
  if l + 1usize < w.layers.len() { n = n + countCrossings(w, l); }
  n
}

fn reorder(w: &mut Work, l: usize, useUp: bool) {
  let cnt = w.layers[l].len();
  var key = List[f32].empty();
  // keyed by vertex: fill all with the current position, then neighbours' mean
  var k = 0usize;
  while k < w.pos.len() { key.push(f32.from(*w.pos[k])); k = k + 1usize; }
  var idx = List[usize].empty();
  var i = 0usize;
  while i < cnt {
    let v = *w.layers[l][i];
    idx.push(v);
    var s = 0.0f;
    var cntN = 0usize;
    if useUp {
      while cntN < w.up[v].len() { s = s + f32.from(*w.pos[*w.up[v][cntN]]); cntN = cntN + 1usize; }
    } else {
      while cntN < w.down[v].len() { s = s + f32.from(*w.pos[*w.down[v][cntN]]); cntN = cntN + 1usize; }
    }
    if cntN > 0usize { key.set(v, s / f32.from(cntN)); }
    i = i + 1usize;
  }
  sortByKey(&mut idx, &key);
  i = 0usize;
  while i < cnt { w.layers[l].set(i, *idx[i]); i = i + 1usize; }
  setPositions(w, l);
}

// The crossings among the edges of u and v (to the layers above and below) if u is left of v
fn crossPair(w: &Work, u: usize, v: usize) u32 {
  var n = 0u32;
  var i = 0usize;
  while i < w.up[u].len() {
    var j = 0usize;
    while j < w.up[v].len() { if *w.pos[*w.up[u][i]] > *w.pos[*w.up[v][j]] { n = n + 1u32; } j = j + 1usize; }
    i = i + 1usize;
  }
  i = 0usize;
  while i < w.down[u].len() {
    var j = 0usize;
    while j < w.down[v].len() { if *w.pos[*w.down[u][i]] > *w.pos[*w.down[v][j]] { n = n + 1u32; } j = j + 1usize; }
    i = i + 1usize;
  }
  n
}

fn transpose(w: &mut Work) {
  var improved = true;
  var rounds = 0u32;
  while improved && rounds < 8u32 {
    improved = false;
    var l = 0usize;
    while l < w.layers.len() {
      var i = 0usize;
      while i + 1usize < w.layers[l].len() {
        let a = *w.layers[l][i];
        let b = *w.layers[l][i + 1usize];
        // the crossings between a's and b's edges with a left of b, against with b left of a
        if crossPair(w, b, a) < crossPair(w, a, b) {
          w.layers[l].set(i, b);
          w.layers[l].set(i + 1usize, a);
          w.pos.set(b, i);
          w.pos.set(a, i + 1usize);
          improved = true;
        }
        i = i + 1usize;
      }
      l = l + 1usize;
    }
    rounds = rounds + 1u32;
  }
}

fn copyLayers(w: &Work) List[List[usize]] {
  var out = List[List[usize]].empty();
  var l = 0usize;
  while l < w.layers.len() {
    var row = List[usize].empty();
    var i = 0usize;
    while i < w.layers[l].len() { row.push(*w.layers[l][i]); i = i + 1usize; }
    out.push(row);
    l = l + 1usize;
  }
  out
}

// ---- 4. coordinates ----

// The nondecreasing y closest to t in the weighted least-squares sense (pool adjacent violators)
fn isotonic(t: &List[f32], wt: &List[f32]) List[f32] {
  var mean = List[f32].empty();
  var weight = List[f32].empty();
  var count = List[usize].empty();
  var i = 0usize;
  while i < t.len() {
    mean.push(*t[i]);
    weight.push(*wt[i]);
    count.push(1usize);
    while mean.len() >= 2usize && *mean[mean.len() - 1usize] < *mean[mean.len() - 2usize] {
      let n = mean.len();
      let w2 = *weight[n - 1usize];
      let w1 = *weight[n - 2usize];
      let merged = (*mean[n - 2usize] * w1 + *mean[n - 1usize] * w2) / (w1 + w2);
      let c = *count[n - 1usize] + *count[n - 2usize];
      mean.pop();
      weight.pop();
      count.pop();
      mean.set(n - 2usize, merged);
      weight.set(n - 2usize, w1 + w2);
      count.set(n - 2usize, c);
    }
    i = i + 1usize;
  }
  var out = List[f32].withCapacity(t.len());
  var b = 0usize;
  while b < mean.len() {
    var k = 0usize;
    while k < *count[b] { out.push(*mean[b]); k = k + 1usize; }
    b = b + 1usize;
  }
  out
}

fn edgeWeight(w: &Work, a: usize, b: usize) f32 {
  let da = *w.nodeOf[a] < 0;
  let db = *w.nodeOf[b] < 0;
  if da && db { return 4.; }
  if da || db { return 2.; }
  1.
}

fn sepBetween(w: &Work, a: usize, b: usize, o: &LayeredOptions) f32 {
  let dummy = *w.nodeOf[a] < 0 || *w.nodeOf[b] < 0;
  (*w.ext[a] + *w.ext[b]) * 0.5 + if dummy { o.nodeSep * 0.35 } else { o.nodeSep }
}

// mode 0: neighbours above, 1: below, 2: both
fn placeLayer(w: &mut Work, l: usize, mode: u32, anchor: &List[f32], hasAnchor: &List[bool], o: &LayeredOptions) {
  let cnt = w.layers[l].len();
  if cnt == 0usize { return; }
  var targets = List[f32].empty();
  var weights = List[f32].empty();
  var offs = List[f32].empty();
  var off = 0.0f;
  var i = 0usize;
  while i < cnt {
    let v = *w.layers[l][i];
    if i > 0usize { off = off + sepBetween(w, *w.layers[l][i - 1usize], v, o); }
    offs.push(off);
    var num = 0.0f;
    var den = 0.0f;
    if mode != 1u32 {
      var k = 0usize;
      while k < w.up[v].len() {
        let n = *w.up[v][k];
        let wt = edgeWeight(w, v, n);
        num = num + wt * *w.cx[n];
        den = den + wt;
        k = k + 1usize;
      }
    }
    if mode != 0u32 {
      var k = 0usize;
      while k < w.down[v].len() {
        let n = *w.down[v][k];
        let wt = edgeWeight(w, v, n);
        num = num + wt * *w.cx[n];
        den = den + wt;
        k = k + 1usize;
      }
    }
    if *hasAnchor[v] && o.stability > 0. {
      let a = o.stability * 4.;
      num = num + a * *anchor[v];
      den = den + a;
    }
    if den <= 0. { num = *w.cx[v] * 0.05; den = 0.05; }
    targets.push(num / den - off);
    weights.push(den);
    i = i + 1usize;
  }
  let y = isotonic(&targets, &weights);
  i = 0usize;
  while i < cnt { w.cx.set(*w.layers[l][i], *y[i] + *offs[i]); i = i + 1usize; }
}

// Nodes with no edges, in rows from (x0, y) down, wrapping at 'width' (at least 600)
fn placeLoose(g: &mut Graph, loose: &List[usize], o: &LayeredOptions, x0: f32, y: f32, width: f32) {
  let limit = maxf2(width, 600.);
  var x = 0.0f;
  var rowTop = y;
  var rowH = 0.0f;
  var i = 0usize;
  while i < loose.len() {
    let n = *loose[i];
    if x > 0. && x + g.nodes[n].w > limit { x = 0.; rowTop = rowTop + rowH + o.nodeSep; rowH = 0.; }
    g.nodes[n].x = x0 + x + g.nodes[n].w * 0.5;
    g.nodes[n].y = rowTop + g.nodes[n].h * 0.5;
    g.nodes[n].placed = true;
    x = x + g.nodes[n].w + o.nodeSep;
    if g.nodes[n].h > rowH { rowH = g.nodes[n].h; }
    i = i + 1usize;
  }
}

// ---- the layout ----

// Lays the live nodes of 'g' out in layers and writes their positions (and, if
// 'routeEdges', their edges' routes). Nodes that have a position ('placed')
// guide the order and, by 'stability', the coordinates.
pub fn layoutLayered(g: &mut Graph, o: &LayeredOptions) LayeredStats {
  let horizontal = o.direction == DIR_LR || o.direction == DIR_RL;
  var w = newWork();
  var vOf = List[i32].empty();
  // nodes with no edge to another live node are not layered: they are set in rows below the picture at the end
  var connected = List[bool].empty();
  var i = 0usize;
  while i < g.nodes.len() { connected.push(false); i = i + 1usize; }
  i = 0usize;
  while i < g.edges.len() {
    if g.edges[i].alive && g.edges[i].from != g.edges[i].to {
      let fa = usize.from(g.edges[i].from);
      let fb = usize.from(g.edges[i].to);
      if g.nodes[fa].alive && g.nodes[fb].alive { connected.set(fa, true); connected.set(fb, true); }
    }
    i = i + 1usize;
  }
  var loose = List[usize].empty();
  i = 0usize;
  while i < g.nodes.len() {
    if g.nodes[i].alive && *connected[i] {
      let ext = if horizontal { g.nodes[i].h } else { g.nodes[i].w };
      let thick = if horizontal { g.nodes[i].w } else { g.nodes[i].h };
      vOf.push(i32.from(addVertex(&mut w, i32.from(i), 0, ext, thick)));
    } else {
      vOf.push(-1);
      if g.nodes[i].alive { loose.push(i); }
    }
    i = i + 1usize;
  }
  let nReal = w.nodeOf.len();
  if nReal == 0usize {
    placeLoose(g, &loose, o, 0., o.margin, 0.);
    return LayeredStats(0u32, 0u32, 0u32, 0u32);
  }

  // Edges between distinct live nodes, once each way
  var ea = List[usize].empty();
  var eb = List[usize].empty();
  var eid = List[usize].empty();
  i = 0usize;
  while i < g.edges.len() {
    if g.edges[i].alive {
      let a = *vOf[usize.from(g.edges[i].from)];
      let b = *vOf[usize.from(g.edges[i].to)];
      if a >= 0 && b >= 0 && a != b {
        ea.push(usize.from(a));
        eb.push(usize.from(b));
        eid.push(i);
      }
    }
    i = i + 1usize;
  }
  // 1. cycles
  var outs = List[List[usize]].empty();
  i = 0usize;
  while i < nReal { outs.push(List[usize].empty()); i = i + 1usize; }
  i = 0usize;
  while i < ea.len() { outs[*ea[i]].push(i); i = i + 1usize; }
  var color = List[u32].empty();
  i = 0usize;
  while i < nReal { color.push(0u32); i = i + 1usize; }
  var flip = List[bool].empty();
  i = 0usize;
  while i < ea.len() { flip.push(false); i = i + 1usize; }
  i = 0usize;
  while i < nReal {
    if *color[i] == 0u32 { dfsCycles(i, &outs, &ea, &eb, &mut color, &mut flip); }
    i = i + 1usize;
  }
  var reversed = 0u32;
  i = 0usize;
  while i < ea.len() {
    if *flip[i] {
      let t = *ea[i];
      ea.set(i, *eb[i]);
      eb.set(i, t);
      reversed = reversed + 1u32;
    }
    i = i + 1usize;
  }
  // 2. layering: Kahn, longest path
  var indeg = List[u32].empty();
  var succ = List[List[usize]].empty();
  var pred = List[List[usize]].empty();
  i = 0usize;
  while i < nReal { indeg.push(0u32); succ.push(List[usize].empty()); pred.push(List[usize].empty()); i = i + 1usize; }
  i = 0usize;
  while i < ea.len() {
    succ[*ea[i]].push(*eb[i]);
    pred[*eb[i]].push(*ea[i]);
    indeg.set(*eb[i], *indeg[*eb[i]] + 1u32);
    i = i + 1usize;
  }
  var queue = List[usize].empty();
  i = 0usize;
  while i < nReal { if *indeg[i] == 0u32 { queue.push(i); } i = i + 1usize; }
  var head = 0usize;
  while head < queue.len() {
    let v = *queue[head];
    head = head + 1usize;
    var k = 0usize;
    while k < succ[v].len() {
      let t = *succ[v][k];
      if *w.rank[t] < *w.rank[v] + 1 { w.rank.set(t, *w.rank[v] + 1); }
      indeg.set(t, *indeg[t] - 1u32);
      if *indeg[t] == 0u32 { queue.push(t); }
      k = k + 1usize;
    }
  }
  // sources pulled down to just above their nearest successor
  i = 0usize;
  while i < nReal {
    if pred[i].len() == 0usize && succ[i].len() > 0usize {
      var m = *w.rank[*succ[i][0usize]];
      var k = 1usize;
      while k < succ[i].len() { if *w.rank[*succ[i][k]] < m { m = *w.rank[*succ[i][k]]; } k = k + 1usize; }
      w.rank.set(i, m - 1);
    }
    i = i + 1usize;
  }
  // 3. dummies
  i = 0usize;
  while i < ea.len() {
    var prev = *ea[i];
    let last = *eb[i];
    var r = *w.rank[prev] + 1;
    while r < *w.rank[last] {
      let d = addVertex(&mut w, -1, r, 4., 0.);
      w.down[prev].push(d);
      w.up[d].push(prev);
      prev = d;
      r = r + 1;
    }
    w.down[prev].push(last);
    w.up[last].push(prev);
    i = i + 1usize;
  }
  var maxRank = 0i32;
  i = 0usize;
  while i < w.rank.len() { if *w.rank[i] > maxRank { maxRank = *w.rank[i]; } i = i + 1usize; }
  let nLayers = usize.from(maxRank) + 1usize;
  // layer lists, ordered by the earlier positions where there are some
  var across = List[f32].empty();
  var known = List[bool].empty();
  i = 0usize;
  while i < w.nodeOf.len() {
    let nid = *w.nodeOf[i];
    if nid >= 0 && g.nodes[usize.from(nid)].placed {
      let nn = &g.nodes[usize.from(nid)];
      across.push(if horizontal { nn.y } else { nn.x });
      known.push(true);
    } else { across.push(0.); known.push(false); }
    i = i + 1usize;
  }
  // unplaced vertices take the mean of placed neighbours (up then down), repeated a few times
  var pass = 0u32;
  while pass < 6u32 {
    i = 0usize;
    while i < w.nodeOf.len() {
      if !*known[i] {
        var s = 0.0f;
        var c = 0u32;
        var k = 0usize;
        while k < w.up[i].len() { if *known[*w.up[i][k]] { s = s + *across[*w.up[i][k]]; c = c + 1u32; } k = k + 1usize; }
        k = 0usize;
        while k < w.down[i].len() { if *known[*w.down[i][k]] { s = s + *across[*w.down[i][k]]; c = c + 1u32; } k = k + 1usize; }
        if c > 0u32 { across.set(i, s / f32.from(c)); known.set(i, true); }
      }
      i = i + 1usize;
    }
    pass = pass + 1u32;
  }
  var anyKnown = false;
  i = 0usize;
  while i < w.nodeOf.len() { if *known[i] { anyKnown = true; } i = i + 1usize; }
  var l = 0usize;
  while l < nLayers { w.layers.push(List[usize].empty()); l = l + 1usize; }
  var orderKey = List[f32].empty();
  i = 0usize;
  while i < w.nodeOf.len() {
    orderKey.push(if anyKnown && *known[i] { *across[i] } else if anyKnown { 1.0e9 + f32.from(i) } else { f32.from(i) });
    i = i + 1usize;
  }
  var allIdx = List[usize].empty();
  i = 0usize;
  while i < w.nodeOf.len() { allIdx.push(i); i = i + 1usize; }
  sortByKey(&mut allIdx, &orderKey);
  i = 0usize;
  while i < allIdx.len() {
    let v = *allIdx[i];
    w.layers[usize.from(*w.rank[v])].push(v);
    i = i + 1usize;
  }
  l = 0usize;
  while l < nLayers { setPositions(&mut w, l); l = l + 1usize; }

  // crossing minimisation, keeping the best order
  var best = copyLayers(&w);
  var bestCross = totalCrossings(&w);
  // With earlier positions and a stability above 0 only local swaps are tried: the barycentre sweeps would
  // reorder whole layers for the sake of one crossing, which is the reshuffle incremental layout avoids
  var sweep = 0u32;
  if anyKnown && o.stability > 0. {
    transpose(&mut w);
    let c0 = totalCrossings(&w);
    if c0 < bestCross { bestCross = c0; best = copyLayers(&w); }
    sweep = o.sweeps;
  }
  while sweep < o.sweeps && bestCross > 0u32 {
    if sweep % 2u32 == 0u32 {
      l = 1usize;
      while l < nLayers { reorder(&mut w, l, true); l = l + 1usize; }
    } else {
      l = nLayers;
      while l > 1usize { l = l - 1usize; reorder(&mut w, l - 1usize, false); }
    }
    transpose(&mut w);
    let c = totalCrossings(&w);
    if c < bestCross { bestCross = c; best = copyLayers(&w); }
    sweep = sweep + 1u32;
  }
  w.layers = best;
  l = 0usize;
  while l < nLayers { setPositions(&mut w, l); l = l + 1usize; }

  // 4. coordinates
  var anchor = List[f32].empty();
  var hasAnchor = List[bool].empty();
  i = 0usize;
  while i < w.nodeOf.len() {
    let nid = *w.nodeOf[i];
    let placed = nid >= 0 && g.nodes[usize.from(nid)].placed;
    hasAnchor.push(placed);
    anchor.push(*across[i]);
    i = i + 1usize;
  }
  l = 0usize;
  while l < nLayers {
    var x = 0.0f;
    var j = 0usize;
    while j < w.layers[l].len() {
      let v = *w.layers[l][j];
      if j > 0usize { x = x + sepBetween(&w, *w.layers[l][j - 1usize], v, o); }
      w.cx.set(v, if *hasAnchor[v] && o.stability > 0. { *anchor[v] } else { x });
      j = j + 1usize;
    }
    l = l + 1usize;
  }
  var round = 0u32;
  while round < 10u32 {
    l = 1usize;
    while l < nLayers { placeLayer(&mut w, l, 0u32, &anchor, &hasAnchor, o); l = l + 1usize; }
    l = nLayers;
    while l > 1usize { l = l - 1usize; placeLayer(&mut w, l - 1usize, 1u32, &anchor, &hasAnchor, o); }
    round = round + 1u32;
  }
  l = 0usize;
  while l < nLayers { placeLayer(&mut w, l, 2u32, &anchor, &hasAnchor, o); l = l + 1usize; }

  // rank coordinates
  var layerThick = List[f32].empty();
  l = 0usize;
  while l < nLayers {
    var t = 0.0f;
    var j = 0usize;
    while j < w.layers[l].len() { if *w.thick[*w.layers[l][j]] > t { t = *w.thick[*w.layers[l][j]]; } j = j + 1usize; }
    layerThick.push(t);
    l = l + 1usize;
  }
  var layerPos = List[f32].empty();
  var y = 0.0f;
  l = 0usize;
  while l < nLayers {
    if l == 0usize { y = *layerThick[0usize] * 0.5; } else { y = y + *layerThick[l - 1usize] * 0.5 + o.rankSep + *layerThick[l] * 0.5; }
    layerPos.push(y);
    l = l + 1usize;
  }
  let total = y + *layerThick[nLayers - 1usize] * 0.5;
  // write (remembering where the placed nodes were)
  var prevPos = List[Vec2].empty();
  i = 0usize;
  while i < nReal {
    let pn = usize.from(*w.nodeOf[i]);
    prevPos.push(Vec2(g.nodes[pn].x, g.nodes[pn].y));
    i = i + 1usize;
  }
  i = 0usize;
  while i < nReal {
    let nid = usize.from(*w.nodeOf[i]);
    let a = *w.cx[i];
    var r = *layerPos[usize.from(*w.rank[i])];
    if o.direction == DIR_BT || o.direction == DIR_RL { r = total - r; }
    if horizontal { g.nodes[nid].x = r; g.nodes[nid].y = a; } else { g.nodes[nid].x = a; g.nodes[nid].y = r; }
    i = i + 1usize;
  }
  // place: align to the earlier positions (mean shift), or to the margin
  var sx = 0.0f;
  var sy = 0.0f;
  var cnt = 0u32;
  var lo = Vec2(1.0e30, 1.0e30);
  i = 0usize;
  while i < nReal {
    let nid = usize.from(*w.nodeOf[i]);
    lo = lo.min(Vec2(g.left(nid), g.top(nid)));
    if g.nodes[nid].placed {
      sx = sx + (*prevPos[i]).x - g.nodes[nid].x;
      sy = sy + (*prevPos[i]).y - g.nodes[nid].y;
      cnt = cnt + 1u32;
    }
    i = i + 1usize;
  }
  var shift = Vec2(o.margin - lo.x, o.margin - lo.y);
  if cnt > 0u32 { shift = Vec2(sx / f32.from(cnt), sy / f32.from(cnt)); }
  i = 0usize;
  while i < nReal {
    let nid = usize.from(*w.nodeOf[i]);
    g.nodes[nid].x = g.nodes[nid].x + shift.x;
    g.nodes[nid].y = g.nodes[nid].y + shift.y;
    i = i + 1usize;
  }
  i = 0usize;
  while i < nReal {
    let nid = usize.from(*w.nodeOf[i]);
    g.nodes[nid].placed = true;
    i = i + 1usize;
  }
  if loose.len() > 0usize {
    var lo2 = Vec2(1.0e30, 1.0e30);
    var hi2 = Vec2(-1.0e30, -1.0e30);
    i = 0usize;
    while i < nReal {
      let nid = usize.from(*w.nodeOf[i]);
      lo2 = lo2.min(Vec2(g.left(nid), g.top(nid)));
      hi2 = hi2.max(Vec2(g.right(nid), g.bottom(nid)));
      i = i + 1usize;
    }
    placeLoose(g, &loose, o, lo2.x, hi2.y + o.rankSep, hi2.x - lo2.x);
  }
  LayeredStats(u32.from(nLayers), u32.from(w.nodeOf.len() - nReal), bestCross, reversed)
}
