// ======== Sequence diagrams ========
//
// Participants across the top, each with a lifeline running down; messages
// between them in time order, one row each; activations (the thin bars on a
// lifeline while a participant is busy) worked out from the messages.
//
// MESSAGES: MSG_CALL (a solid line, filled head: the caller waits), MSG_ASYNC
// (a solid line, open head: no wait), MSG_RETURN (a dashed line, open head),
// MSG_SELF (a loop out of and back to the same lifeline).
// ACTIVATIONS (UML 2): a call to B opens an activation of B at its row; the next
// return from B to the caller closes the most recent open activation of B. A call
// with no return closes at the end of the last row B sends from. Activations on
// one lifeline nest, each drawn a few pixels right of the one it sits in.
// SPACING: a message that spans several lifelines asks its label's width spread
// over the gaps it crosses; each gap is the largest such demand, at least 'minGap'.
// The sequence is in the order given: layout does not reorder messages (time is
// the vertical axis and means something). Not built: combined fragments (alt, loop,
// opt), lifeline creation and destruction.
// NOTES (Mermaid 'Note over A,B', 'Note left of A', 'Note right of A'): a box of the
// caller's measured size, in a row of its own between two messages ('before' is the
// index of the message it comes before; the number of messages for one at the end).
// 'over' centres on its participant, or spans from one lifeline to another; 'left of' and
// 'right of' sit beside the lifeline. Layout widens the gaps (and the margin on the left,
// the width on the right) so a note covers no other lifeline and stays inside the picture.

pub const MSG_CALL = 0u32;
pub const MSG_ASYNC = 1u32;
pub const MSG_RETURN = 2u32;
pub const MSG_SELF = 3u32;

pub struct Participant {
  pub name: String;
  pub w: f32;                       // the head box
  pub h: f32;
  pub x: f32;                       // lifeline x (the centre), written by layout
}

pub struct Message {
  pub from: u32;
  pub to: u32;
  pub label: String;
  pub labelW: f32;                  // the label's width, from the caller's measurement
  pub kind: u32;
  pub y: f32;                       // written by layout
}

pub struct Activation {
  pub participant: u32;
  pub y0: f32;
  pub y1: f32;
  pub depth: u32;
  pub x: f32;                       // the bar's left edge
  pub w: f32;
}

pub const NOTE_OVER = 0u32;         // over one participant (from == to) or spanning from one to another
pub const NOTE_LEFT = 1u32;         // left of 'from'
pub const NOTE_RIGHT = 2u32;        // right of 'from'

pub struct Note {
  pub kind: u32;                    // NOTE_...
  pub from: u32;                    // a participant
  pub to: u32;                      // the other end of an 'over' note (equal to 'from' for a single participant)
  pub text: String;                 // '\n' starts a new line when drawn
  pub w: f32;                       // the box's size, from the caller's measurement (text and padding)
  pub h: f32;
  pub before: u32;                  // the index of the message this note comes before
  pub x: f32;                       // the box's left edge, written by layout
  pub y: f32;                       // its top edge
}

pub struct SequenceDiagram {
  pub participants: List[Participant];
  pub messages: List[Message];
  pub activations: List[Activation];
  pub notes: List[Note];
  pub width: f32;
  pub height: f32;
  pub lifelineTop: f32;
  pub lifelineBottom: f32;
  pub rowHeight: f32;

  pub fn make() SequenceDiagram {
    SequenceDiagram(List[Participant](), List[Message](), List[Activation](), List[Note](), 0., 0., 0., 0., 0.)
  }

  // A note of the measured box size w x h, placed before message 'before' (the message count: at the end).
  // For NOTE_OVER, 'to' may be another participant (the note spans both); for NOTE_LEFT and NOTE_RIGHT it is ignored.
  pub fn addNote(self: &mut, kind: u32, from: u32, to: u32, text: &str, w: f32, h: f32, before: u32) u32 {
    notes.push(Note(kind, from, if kind == NOTE_OVER { to } else { from }, String.from(text), w, h, before, 0., 0.));
    u32.from(notes.len() - 1usize)
  }

  pub fn addParticipant(self: &mut, name: &str, w: f32, h: f32) u32 {
    participants.push(Participant(String.from(name), w, h, 0.));
    u32.from(participants.len() - 1usize)
  }

  pub fn addMessage(self: &mut, from: u32, to: u32, label: &str, labelW: f32, kind: u32) u32 {
    var k = kind;
    if from == to { k = MSG_SELF; }
    messages.push(Message(from, to, String.from(label), labelW, k, 0.));
    u32.from(messages.len() - 1usize)
  }
}

pub struct SequenceOptions {
  pub minGap: f32;
  pub margin: f32;
  pub rowHeight: f32;               // between messages
  pub activationWidth: f32;
  pub headGap: f32;                 // from the head boxes to the first message
  pub tailGap: f32;

  pub fn make() SequenceOptions { SequenceOptions(150., 30., 46., 12., 34., 30.) }
}

pub fn layoutSequence(d: &mut SequenceDiagram, o: &SequenceOptions) {
  let np = d.participants.len();
  if np == 0usize { return; }
  // gaps
  var gap = List[f32]();
  var i = 0usize;
  while i + 1usize < np { gap.push(o.minGap); i = i + 1usize; }
  i = 0usize;
  while i < np {
    // the head boxes must not touch
    if i + 1usize < np {
      let need = (d.participants[i].w + d.participants[i + 1usize].w) * 0.5 + 24.;
      if need > *gap[i] { gap.set(i, need); }
    }
    i = i + 1usize;
  }
  var m = 0usize;
  while m < d.messages.len() {
    let a = usize.from(d.messages[m].from);
    let b = usize.from(d.messages[m].to);
    if a != b {
      let lo = if a < b { a } else { b };
      let hi = if a < b { b } else { a };
      let per = (d.messages[m].labelW + 28.) / f32.from(hi - lo);
      var g = lo;
      while g < hi { if per > *gap[g] { gap.set(g, per); } g = g + 1usize; }
    } else {
      // a self message's loop and label go to the right: ask the next gap for its width
      if a + 1usize < np {
        let need = d.messages[m].labelW + 50.;
        if need > *gap[a] { gap.set(a, need); }
      }
    }
    m = m + 1usize;
  }
  // notes ask for gaps: an 'over' that spans lifelines spreads its width over the gaps it crosses;
  // a note beside a lifeline needs the gap on that side as wide as the box and its clearances
  var nt = 0usize;
  while nt < d.notes.len() {
    let nn = &d.notes[nt];
    let a = usize.from(nn.from);
    let b = usize.from(nn.to);
    if nn.kind == NOTE_OVER && a != b {
      let lo = if a < b { a } else { b };
      let hi = if a < b { b } else { a };
      let per = (nn.w - 20.) / f32.from(hi - lo);
      var g = lo;
      while g < hi { if per > *gap[g] { gap.set(g, per); } g = g + 1usize; }
    } else if nn.kind == NOTE_LEFT && a > 0usize {
      if nn.w + 18. > *gap[a - 1usize] { gap.set(a - 1usize, nn.w + 18.); }
    } else if nn.kind == NOTE_RIGHT && a + 1usize < np {
      if nn.w + 18. > *gap[a] { gap.set(a, nn.w + 18.); }
    }
    nt = nt + 1usize;
  }
  var x = o.margin + d.participants[0usize].w * 0.5;
  i = 0usize;
  while i < np {
    d.participants[i].x = x;
    if i + 1usize < np { x = x + *gap[i]; }
    i = i + 1usize;
  }
  // note boxes' left edges; a box that sticks out on the left moves everything right
  nt = 0usize;
  var minLeft = 1.0e30f;
  var maxRight = 0.0f;
  while nt < d.notes.len() {
    let a = usize.from(d.notes[nt].from);
    let b = usize.from(d.notes[nt].to);
    let kind = d.notes[nt].kind;
    let ax = d.participants[a].x;
    var left = 0.0f;
    if kind == NOTE_OVER {
      let bx = d.participants[b].x;
      let lox = if ax < bx { ax } else { bx };
      let hix = if ax < bx { bx } else { ax };
      if d.notes[nt].w < hix - lox + 20. { d.notes[nt].w = hix - lox + 20.; }
      left = (lox + hix) * 0.5 - d.notes[nt].w * 0.5;
    } else if kind == NOTE_LEFT {
      left = ax - 10. - d.notes[nt].w;
    } else {
      left = ax + 10.;
    }
    d.notes[nt].x = left;
    if left < minLeft { minLeft = left; }
    if left + d.notes[nt].w > maxRight { maxRight = left + d.notes[nt].w; }
    nt = nt + 1usize;
  }
  if d.notes.len() > 0usize && minLeft < 4. {
    let shift = 4. - minLeft;
    i = 0usize;
    while i < np { d.participants[i].x = d.participants[i].x + shift; i = i + 1usize; }
    nt = 0usize;
    while nt < d.notes.len() { d.notes[nt].x = d.notes[nt].x + shift; nt = nt + 1usize; }
    x = x + shift;
    maxRight = maxRight + shift;
  }
  var headH = 0.0f;
  i = 0usize;
  while i < np { if d.participants[i].h > headH { headH = d.participants[i].h; } i = i + 1usize; }
  d.lifelineTop = o.margin + headH;
  var y = d.lifelineTop + o.headGap;
  d.rowHeight = o.rowHeight;
  // rows in time order: the notes that come before message m, then message m; the notes at the end last
  m = 0usize;
  while m <= d.messages.len() {
    nt = 0usize;
    while nt < d.notes.len() {
      let at = usize.from(d.notes[nt].before);
      if at == m || (m == d.messages.len() && at > m) {
        d.notes[nt].y = y - 12.;
        y = y - 12. + d.notes[nt].h + o.rowHeight * 0.6;
      }
      nt = nt + 1usize;
    }
    if m < d.messages.len() {
      d.messages[m].y = y;
      y = y + o.rowHeight + if d.messages[m].kind == MSG_SELF { o.rowHeight * 0.4 } else { 0. };
    }
    m = m + 1usize;
  }
  d.lifelineBottom = y - o.rowHeight * 0.4 + o.tailGap;
  d.height = d.lifelineBottom + headH + o.margin;
  d.width = d.participants[np - 1usize].x + d.participants[np - 1usize].w * 0.5 + o.margin;
  if d.width < x + o.margin { d.width = x + o.margin; }
  if d.width < maxRight + 4. { d.width = maxRight + 4.; }
  // activations
  d.activations.clear();
  var open = List[List[usize]]();      // per participant, the indices into activations of the still open ones
  i = 0usize;
  while i < np { open.push(List[usize]()); i = i + 1usize; }
  var lastSend = List[f32]();
  i = 0usize;
  while i < np { lastSend.push(0.); i = i + 1usize; }
  m = 0usize;
  while m < d.messages.len() {
    let msg = &d.messages[m];
    let from = usize.from(msg.from);
    let to = usize.from(msg.to);
    lastSend.set(from, msg.y);
    if msg.kind == MSG_CALL {
      let depth = u32.from(open[to].len());
      d.activations.push(Activation(msg.to, msg.y - 6., msg.y, depth, 0., o.activationWidth));
      open[to].push(d.activations.len() - 1usize);
    } else if msg.kind == MSG_RETURN {
      if open[from].len() > 0usize {
        let a = *open[from][open[from].len() - 1usize];
        open[from].pop();
        d.activations[a].y1 = msg.y + 6.;
      }
    }
    m = m + 1usize;
  }
  // unclosed: to the last row the participant sent from, at least a short bar
  i = 0usize;
  while i < d.activations.len() {
    if d.activations[i].y1 <= d.activations[i].y0 + 6.01 {
      let p = usize.from(d.activations[i].participant);
      let end = if *lastSend[p] > d.activations[i].y0 { *lastSend[p] + 6. } else { d.activations[i].y0 + 18. };
      d.activations[i].y1 = end;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < d.activations.len() {
    let p = usize.from(d.activations[i].participant);
    d.activations[i].x = d.participants[p].x - o.activationWidth * 0.5 + f32.from(d.activations[i].depth) * o.activationWidth * 0.5;
    i = i + 1usize;
  }
}
