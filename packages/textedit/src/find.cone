// ======== Find and replace ========
//
// Literal search over a TextBuffer, with options: case sensitivity (ASCII folding) and whole words
// (the match must not touch a word character on either side). A needle may span lines. The scan
// walks the buffer a piece at a time (TextBuffer.chunk), looking for the needle's first byte in the
// piece with a plain loop, and checks the rest byte by byte only at those candidates; so it runs at
// memory speed over a large file and never copies it.
//
// Regular expressions are not built.

pub struct FindOptions {
  pub needle: String;
  pub matchCase: bool = false;
  pub wholeWord: bool = false;

  pub fn make(needle: &str) FindOptions {new FindOptions(String.from(needle))}
}

fn foldByte(b: u8, matchCase: bool) u8 {
  if !matchCase && b >= 65u8 && b <= 90u8 {b + 32u8} else {b}
}

fn isWordByte(b: u8) bool {charClass(b) == 1u32}

// Whether the needle matches the buffer at 'off' (and, for whole words, stands alone there)
fn matchesAt(buf: &TextBuffer, o: &FindOptions, off: usize) bool {
  let n = o.needle.len();
  if off + n > buf.len() {return false;}
  var i = 0usize;
  while i < n {
    if foldByte(buf.byteAt(off + i), o.matchCase) != foldByte(o.needle[i], o.matchCase) {return false;}
    i = i + 1usize;
  }
  if o.wholeWord {
    if off > 0usize && isWordByte(buf.byteAt(off - 1usize)) && isWordByte(o.needle[0usize]) {return false;}
    if off + n < buf.len() && isWordByte(buf.byteAt(off + n)) && isWordByte(o.needle[n - 1usize]) {return false;}
  }
  true
}

// The first match starting at or after 'from', or NOT_FOUND
pub fn findNext(buf: &TextBuffer, o: &FindOptions, from: usize) usize {
  let n = o.needle.len();
  if n == 0usize || from >= buf.len() {return NOT_FOUND;}
  let first = foldByte(o.needle[0usize], o.matchCase);
  var at = from;
  while at < buf.len() {
    let c = buf.chunk(at);
    if c.len() == 0usize {return NOT_FOUND;}
    var i = 0usize;
    while i < c.len() {
      if foldByte(c[i], o.matchCase) == first && matchesAt(buf, o, at + i) {return at + i;}
      i = i + 1usize;
    }
    at = at + c.len();
  }
  NOT_FOUND
}

// The last match that starts before 'before' (a match may end after it), or NOT_FOUND
pub fn findPrev(buf: &TextBuffer, o: &FindOptions, before: usize) usize {
  let n = o.needle.len();
  if n == 0usize || before == 0usize {return NOT_FOUND;}
  var i = if before > buf.len() {buf.len()} else {before};
  while i > 0usize {
    i = i - 1usize;
    if matchesAt(buf, o, i) {return i;}
  }
  NOT_FOUND
}

// The starts of all non-overlapping matches, in order
pub fn findAll(buf: &TextBuffer, o: &FindOptions) List[usize] {
  var out = List[usize].empty();
  let n = o.needle.len();
  var at = 0usize;
  while n > 0usize {
    let m = findNext(buf, o, at);
    if m == NOT_FOUND {break;}
    out.push(m);
    at = m + n;
  }
  out
}

// Selects the next match after the primary caret, wrapping round; false when there is none
pub fn selectNext(d: &mut Doc, o: &FindOptions) bool {
  let from = d.caret(d.caretCount() - 1usize).hi();
  var m = findNext(d.buffer(), o, from);
  if m == NOT_FOUND {m = findNext(d.buffer(), o, 0usize);}
  if m == NOT_FOUND {return false;}
  d.setSelection(m, m + o.needle.len());
  true
}

// Selects the previous match before the primary caret, wrapping round
pub fn selectPrev(d: &mut Doc, o: &FindOptions) bool {
  let from = d.caret(d.caretCount() - 1usize).lo();
  var m = findPrev(d.buffer(), o, from);
  if m == NOT_FOUND {m = findPrev(d.buffer(), o, d.len() + 1usize);}
  if m == NOT_FOUND {return false;}
  d.setSelection(m, m + o.needle.len());
  true
}

// Replaces the selection if it is a match, then selects the next match; false when none is left
pub fn replaceNext(d: &mut Doc, o: &FindOptions, repl: &str) bool {
  let c = d.caret(d.caretCount() - 1usize);
  if !c.isEmpty() && c.hi() - c.lo() == o.needle.len() && matchesAt(d.buffer(), o, c.lo()) {
    var los = List[usize].empty();
    var his = List[usize].empty();
    los.push(c.lo());
    his.push(c.hi());
    d.replaceRanges(&los, &his, repl);
    d.setCaret(c.lo() + repl.len());
  }
  selectNext(d, o)
}

// Replaces every match, as one undo step; answers how many
pub fn replaceAll(d: &mut Doc, o: &FindOptions, repl: &str) usize {
  let starts = findAll(d.buffer(), o);
  if starts.len() == 0usize {return 0usize;}
  var his = List[usize].withCapacity(starts.len());
  var i = 0usize;
  while i < starts.len() {
    his.push(*starts[i] + o.needle.len());
    i = i + 1usize;
  }
  d.replaceRanges(&starts, &his, repl);
  starts.len()
}
