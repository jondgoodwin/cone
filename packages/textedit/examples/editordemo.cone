// The code editor on a real GPU, headless: a real Cone source file shown with highlighting, a click and a
// bracket pair, a selection, a scripted edit with auto-indent and undo and redo, three carets at once, the
// same file in a proportional font, and a 10,000-line file with its frame costs.
//
//   congo run --release examples/editordemo.cone -- <out folder> [a .cone file to show]
//   GPU_POWER_PREFERENCE=low-power congo run ...      the same on the integrated GPU
//
// Everything the "user" does is pushed through the Ui's own input functions (pointerMove, pointerDown,
// keyDown, textInput, wheel): the SDL window never exists, so no real keystroke or mouse input is involved.
//
// THE RENDERER IS THIS PROGRAM'S, not the package's: uilayout makes a DrawList and leaves drawing to the
// host. This one is the smallest that shows an editor: rectangles and borders as signed-distance quads
// (editorlist.slang) under the text, which is msdftext's, laid out here and drawn in groups of one size and
// colour. Text is clipped a glyph at a time, not a pixel, which is fine for an editor whose text starts at
// its gutter's edge and ends at its right edge.

mod editordemo;

import libc;
import fs;
import path use Path;
import stdio use *;
import process;
import sdl;
import collections use *;
import geomath use *;
import gpu use *;
import msdftext use *;
import imagedecode use *;
import uilayout use * but ALIGN_CENTER;
import textedit use *;

const W = 1280u32;
const H = 720u32;
const PRIM_FLOATS = 20usize;
const PRIM_BYTES = 80u64;

// ---- the renderer ----

struct Rig {
  font: Font;
  atlas: Atlas;
  shader: ShaderModule;
  groupLayout: BindGroupLayout;
  layout: PipelineLayout;
  pipeline: RenderPipeline;
  uniforms: Buffer;
  group: BindGroup;
  instances: Buffer;
  capacity: u32;
  text: TextRenderer;
  slots: List[TextHandle];
  target: Texture;
  readback: Buffer;
  prims: u32 = 0u32;
  glyphs: u32 = 0u32;

  fn make(device: &mut Device, font: Font) Rig {
    var atlas = Atlas.create(AtlasConfig.standard());
    // the printable ASCII now, not in the middle of a frame (3 ms a glyph)
    var cp = 32u32;
    while cp < 127u32 {
      atlas.ensure(&font, font.glyphOf(cp));
      cp = cp + 1u32;
    }
    var shader = device.createShaderModule(&EDITORLIST_SPIRV);
    let entries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT)];
    var groupLayout = device.createBindGroupLayout(&entries);
    let groupLayouts = [&groupLayout];
    var layout = device.createPipelineLayout(&groupLayouts, 0u32);
    let attributes = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 0u64, 0u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 16u64, 1u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 32u64, 2u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 48u64, 3u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 64u64, 4u32)];
    let buffers = [new VertexBufferLayout(arrayStride: PRIM_BYTES, stepMode: VERTEX_STEP_MODE_INSTANCE, attributes: &attributes)];
    let desc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, vertexEntryPoint: "vertexMain",
      buffers: &buffers, fragmentModule: &shader, fragmentEntryPoint: "fragmentMain", colorFormat: TEXTURE_FORMAT_RGBA8_UNORM,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var pipeline = device.createRenderPipeline(&desc);
    var uniforms = device.createBuffer(16u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    let bindings = [BindGroupEntry.buffer(0u32, &uniforms)];
    var group = device.createBindGroup(&groupLayout, &bindings);
    var instances = device.createBuffer(PRIM_BYTES * 256u64, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
    var text = TextRenderer.create(device, &atlas, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
    let targetDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
    var target = device.createTexture(&targetDesc);
    var readback = device.createBuffer(u64.from(W * H * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    new Rig(font: font, atlas: atlas, shader: shader, groupLayout: groupLayout, layout: layout, pipeline: pipeline, uniforms: uniforms,
      group: group, instances: instances, capacity: 256u32, text: text, slots: List[TextHandle].empty(), target: target, readback: readback)
  }

  // The list drawn into the target. 'copyOut' also copies the picture to the readback buffer. Nanoseconds
  // spent preparing (prep), recording and submitting (record) and waiting for the GPU (wait) go into 'times'
  fn paint(self: &mut, device: &mut Device, list: &DrawList, copyOut: bool, times: &mut List[i64]) {
    let t0 = sdl.GetTicksNS();
    var data = List[f32].withCapacity(list.cmds.len() * PRIM_FLOATS);
    var clips = List[f32].empty();
    var c0 = -1000000.f;
    var c1 = -1000000.f;
    var c2 = 1000000.f;
    var c3 = 1000000.f;
    var count = 0u32;
    var texts = List[usize].empty();                  // indices of DC_TEXT commands, with the clip each had
    var textClips = List[f32].empty();
    var i = 0usize;
    while i < list.cmds.len() {
      let d = list.cmds[i];
      let k = d.kind;
      if k == DC_CLIP_PUSH {
        clips.push(c0);
        clips.push(c1);
        clips.push(c2);
        clips.push(c3);
        c0 = maxf(c0, d.x);
        c1 = maxf(c1, d.y);
        c2 = minf(c2, d.x + d.w);
        c3 = minf(c3, d.y + d.h);
      }
      elif k == DC_CLIP_POP {
        if clips.len() >= 4usize {
          let top = clips.len() - 4usize;
          c0 = *clips[top];
          c1 = *clips[top + 1usize];
          c2 = *clips[top + 2usize];
          c3 = *clips[top + 3usize];
          clips.truncate(top);
        }
      }
      elif k == DC_RECT || k == DC_BORDER {
        data.push(d.x - 1.);
        data.push(d.y - 1.);
        data.push(d.x + d.w + 1.);
        data.push(d.y + d.h + 1.);
        data.push(d.x + d.w * 0.5);
        data.push(d.y + d.h * 0.5);
        data.push(d.w * 0.5);
        data.push(d.h * 0.5);
        pushColor(&mut data, d.color);
        data.push(if k == DC_RECT {0.} else {1.});
        data.push(d.radius);
        data.push(d.thick);
        data.push(0.);
        data.push(c0);
        data.push(c1);
        data.push(c2);
        data.push(c3);
        count = count + 1u32;
      }
      elif k == DC_LINE {
        data.push(minf(d.x, d.w) - d.thick - 1.);
        data.push(minf(d.y, d.h) - d.thick - 1.);
        data.push(maxf(d.x, d.w) + d.thick + 1.);
        data.push(maxf(d.y, d.h) + d.thick + 1.);
        data.push(d.x);
        data.push(d.y);
        data.push(d.w);
        data.push(d.h);
        pushColor(&mut data, d.color);
        data.push(2.);
        data.push(0.);
        data.push(d.thick);
        data.push(0.);
        data.push(c0);
        data.push(c1);
        data.push(c2);
        data.push(c3);
        count = count + 1u32;
      }
      elif k == DC_TEXT {
        texts.push(i);
        textClips.push(c0);
        textClips.push(c1);
        textClips.push(c2);
        textClips.push(c3);
      }
      i = i + 1usize;
    }
    prims = count;
    // The texts: laid out, each glyph placed in pixels, grouped by size and colour into one draw each
    var gSize = List[f32].empty();
    var gColor = List[u32].empty();
    var gQuads = List[List[GlyphQuad]].empty();
    var t = 0usize;
    while t < texts.len() {
      let d = list.cmds[*texts[t]];
      let s = list.textOf(*texts[t]);
      let lay = layoutText(&font, &mut atlas, s, &LayoutOptions.make(d.size));
      var px = d.x;
      if d.align == TA_CENTER {px = px + (d.w - lay.width) * 0.5;}
      elif d.align == TA_RIGHT {px = px + d.w - lay.width;}
      px = libc.floorf(px + 0.5);
      let py = libc.floorf(d.y + (d.h - lay.height) * 0.5 + 0.5);
      var g = 0usize;
      var found = false;
      while g < gSize.len() && !found {
        if *gSize[g] == d.size && *gColor[g] == d.color {found = true;} else {g = g + 1usize;}
      }
      if !found {
        gSize.push(d.size);
        gColor.push(d.color);
        gQuads.push(List[GlyphQuad].empty());
      }
      let cl0 = *textClips[t * 4usize];
      let cl1 = *textClips[t * 4usize + 1usize];
      let cl2 = *textClips[t * 4usize + 2usize];
      let cl3 = *textClips[t * 4usize + 3usize];
      var q = 0usize;
      while q < lay.quads.len() {
        let gq = lay.quads[q];
        let x0 = gq.x0 + px;
        let x1 = gq.x1 + px;
        let y0 = gq.y0 + py;
        let y1 = gq.y1 + py;
        if x0 >= cl0 - 2. && x1 <= cl2 + 2. && y0 >= cl1 - 2. && y1 <= cl3 + 2. {
          gQuads[g].push(new GlyphQuad(x0, y0, x1, y1, gq.u0, gq.v0, gq.u1, gq.v1));
        }
        q = q + 1usize;
      }
      t = t + 1usize;
    }
    text.syncAtlas(device, &atlas);
    var g = 0usize;
    var nGlyphs = 0usize;
    while g < gSize.len() {
      while slots.len() <= g {slots.push(text.addText(device, SPACE_OVERLAY));}
      var quads = List[GlyphQuad].withCapacity(gQuads[g].len());
      var qi = 0usize;
      while qi < gQuads[g].len() {
        quads.push(*gQuads[g][qi]);
        qi = qi + 1usize;
      }
      let lay = new TextLayout(List[PlacedGlyph].empty(), quads, List[LineInfo].empty(), 0., 0., 0., *gSize[g]);
      nGlyphs = nGlyphs + gQuads[g].len();
      let rgba = *gColor[g];
      let style = TextStyle.plain(new Color(f32.from((rgba >> 24u32) & 255u32) / 255., f32.from((rgba >> 16u32) & 255u32) / 255.,
        f32.from((rgba >> 8u32) & 255u32) / 255., f32.from(rgba & 255u32) / 255.));
      text.set(device, *slots[g], &lay, &style, overlayTransform(f32.from(W), f32.from(H), 0., 0.));
      g = g + 1usize;
    }
    while g < slots.len() {
      text.clearText(*slots[g]);
      g = g + 1usize;
    }
    glyphs = u32.from(nGlyphs);
    // The shapes' data to the GPU
    var params = new Array[f32, 4] <- f32.from(W), f32.from(H), 0., 0.;
    device.queue.writeBuffer(&uniforms, 0u64, &params as *u8, 16u64);
    if count > capacity {
      device.queue.releaseBuffer(&mut instances);
      capacity = count * 2u32;
      instances = device.createBuffer(u64.from(capacity) * PRIM_BYTES, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
    }
    if count > 0u32 {
      let raw: *f32 = data.view() as *f32;
      device.queue.writeBuffer(&instances, 0u64, raw as *u8, u64.from(count) * PRIM_BYTES);
    }
    let t1 = sdl.GetTicksNS();
    var encoder = device.createCommandEncoder();
    let color = new RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_CLEAR, clearValue: new Color(0.06, 0.06, 0.07, 1.));
    var pass = encoder.beginRenderPass(&color);
    if count > 0u32 {
      pass.setPipeline(&pipeline);
      pass.setBindGroup(0u32, &group);
      pass.setVertexBuffer(0u32, &instances, 0u64);
      pass.draw(6u32, count, 0u32, 0u32);
    }
    pass.end();
    text.renderOverlay(&mut encoder, &target);
    if copyOut {encoder.copyTextureToBuffer(&target, &readback);}
    device.queue.submit(encoder.finish());
    let t2 = sdl.GetTicksNS();
    device.endFrame();
    device.waitIdle();
    let t3 = sdl.GetTicksNS();
    times.push(i64.from(t1 - t0));
    times.push(i64.from(t2 - t1));
    times.push(i64.from(t3 - t2));
  }

  // The last picture as a PNG
  fn savePng(self: &, file: &Path) {
    let px = readback.mappedRange();
    var samples = List[u16].withCapacity(usize.from(W * H * 4u32));
    var i = 0usize;
    while i < usize.from(W * H * 4u32) {
      samples.push(u16.from(*(px + i)));
      i = i + 1usize;
    }
    let opts = PngWrite.make(6u8, 8u8);
    let bytes = encodePngSamples(i32.from(W), i32.from(H), samples.view(), &opts);
    fs.writeFile(file, bytes.view());
  }
}

fn pushColor(data: &mut List[f32], c: u32) {
  data.push(f32.from((c >> 24u32) & 255u32) / 255.);
  data.push(f32.from((c >> 16u32) & 255u32) / 255.);
  data.push(f32.from((c >> 8u32) & 255u32) / 255.);
  data.push(f32.from(c & 255u32) / 255.);
}

// ---- the program's use of the editor ----

// One frame of the Ui and the editor: layout, the queued events applied, the draw list made again if it changed
fn frame(ui: &mut Ui, ed: &mut Editor, font: &Font, atlas: &mut Atlas) {
  var m = fn(t: &str, face: u32, size: f32) Vec2 {
    let lay = layoutText(font, atlas, t, &LayoutOptions.make(size));
    new Vec2(lay.width, lay.height)
  };
  layout(ui, &mut m);
  ed.pump(ui, &mut m, &coneTokenizer);
  ed.refresh(ui, &mut m, &coneTokenizer);
}

fn click(ui: &mut Ui, p: Vec2, mods: u32) {
  pointerMove(ui, p.x + 1., p.y);
  ui.input.mods = mods;
  pointerDown(ui, BTN_LEFT);
  pointerUp(ui, BTN_LEFT);
  ui.input.mods = 0u32;
}

// A key pressed and let go (the Ui keeps the modifiers of the last key event until told otherwise)
fn press(ui: &mut Ui, code: u32, mods: u32) {
  keyDown(ui, code, mods);
  keyUp(ui, code, 0u32);
}

fn typeString(ui: &mut Ui, s: &str) {
  let n = s.len();
  var i = 0usize;
  while i < n {
    if s[i] == 10u8 {
      keyDown(ui, KEY_ENTER, 0u32);
    }
    else {
      textInput(ui, u32.from(s[i]));
    }
    i = i + 1usize;
  }
}

fn p50(v: &List[i64]) i64 {
  var c = List[i64].empty();
  var i = 0usize;
  while i < v.len() {
    c.push(*v[i]);
    i = i + 1usize;
  }
  c.sortBy(fn(a: &i64, b: &i64) i32 { if *a < *b {-1i32} elif *a > *b {1i32} else {0i32} });
  if c.len() == 0usize {0i64} else {*c[c.len() / 2usize]}
}

fn readText(file: &Path) String {
  match fs.readFile(file) {
    case let s Ok { String.from(s.view()) }
    case is Error { String.empty() }
  }
}

fn describe(label: &str, ed: &Editor) {
  print <- label, ": ", u64.from(ed.doc.lineCount()), " lines, ", u64.from(ed.doc.caretCount()), " caret(s), draw lists made ",
    u64.from(ed.rebuilds), ", lines tokenized ", u64.from(ed.linesTokenized), "\n";
}

fn run(device: &mut Device, outDir: &str, sample: &Path) {
  let outPath = Path.from(outDir);
  fs.makeDirAll(&outPath);
  // ---- fonts ----
  var monoRig = loadRig(device, "C:/Windows/Fonts/consola.ttf");
  var propRig = loadRig(device, "C:/Windows/Fonts/segoeui.ttf");
  match &mut monoRig {
    case var rig Some {
      match &mut propRig {
        case var rig2 Some { shots(device, rig, rig2, &outPath, sample); }
        case is None { print <- "no Segoe UI font on this machine\n"; }
      }
    }
    case is None { print <- "no Consolas font on this machine\n"; }
  }
}

fn loadRig(device: &mut Device, file: &str) Option[Rig] {
  var rig: Option[Rig] = None;
  match fs.readFile(&Path.from(file)) {
    case let bytes Ok {
      match Font.load(bytes.view()) {
        case let f Ok { rig = Some[Rig](Rig.make(device, f)); }
        case is Error {}
      }
    }
    case is Error {}
  }
  rig
}

fn shots(device: &mut Device, rig: &mut Rig, rig2: &mut Rig, outPath: &Path, sample: &Path) {
  var times = List[i64].empty();
  var list = DrawList.make();
  let source = readText(sample);
  var ui = Ui.make(f32.from(W), f32.from(H));
  var ed = Editor.make(&mut ui, ui.root, source.view());
  ed.style.size = 15.;
  ed.style.font = 0u32;
  let status = label(&mut ui, ui.root, "");
  ui.setOffsets(ed.node, 20., 20., 0., 0.);
  ui.setSize(ed.node, f32.from(W) - 40., f32.from(H) - 70.);
  ui.setOffsets(status, 24., f32.from(H) - 38., 0., 0.);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  print <- "sample file: ", u64.from(source.len()), " bytes, ", u64.from(ed.doc.lineCount()), " lines\n";

  // 1. the file, scrolled down to where the code is, with the editor not focused
  pointerMove(&mut ui, 300., 300.);
  wheel(&mut ui, 0., -22.);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  ui.setText(status, "1: Cone source, highlighted, scrolled by the wheel");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  drawUi(&ui, &mut list);
  rig.paint(device, &list, true, &mut times);
  rig.savePng(&outPath.join("01-highlighted.png"));
  describe("shot 1", &ed);

  // 2. a click inside the parentheses of a call: the caret and its bracket pair
  let opts = FindOptions.make("applyEdit(&mut core");
  let at = findNext(ed.doc.buffer(), &opts, 0usize);
  print <- "target offset ", u64.from(at), "\n";
  ed.doc.setCaret(at + 10usize);
  ed.dirtyAll();
  ed.showLine(&ui, ed.doc.buffer().lineOf(at), 0.35);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  click(&mut ui, ed.pointOf(&ui, at + 10usize), 0u32);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  ui.setText(status, "2: a click, the caret line, and the bracket pair");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  drawUi(&ui, &mut list);
  rig.paint(device, &list, true, &mut times);
  rig.savePng(&outPath.join("02-click-brackets.png"));
  print <- "bracket pair at ", u64.from(ed.matchA), " and ", u64.from(ed.matchB), "\n";

  // 3. a drag across six lines
  let from = ed.pointOf(&ui, ed.doc.buffer().lineStart(ed.doc.buffer().lineOf(at) + 2usize) + 4usize);
  let to = ed.pointOf(&ui, ed.doc.buffer().lineStart(ed.doc.buffer().lineOf(at) + 7usize) + 22usize);
  pointerMove(&mut ui, from.x, from.y);
  pointerDown(&mut ui, BTN_LEFT);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  pointerMove(&mut ui, to.x, to.y);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  pointerUp(&mut ui, BTN_LEFT);
  ui.setText(status, "3: a drag selects six lines");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  drawUi(&ui, &mut list);
  rig.paint(device, &list, true, &mut times);
  rig.savePng(&outPath.join("03-selection.png"));
  print <- "selected ", u64.from(ed.doc.selectedText().len()), " bytes\n";

  // 4. an edit: to the end of the line, Enter, a new block typed with auto-indent, then a few undos
  press(&mut ui,KEY_ESCAPE, 0u32);
  click(&mut ui, ed.pointOf(&ui, at + 3usize), 0u32);
  press(&mut ui,KEY_END, 0u32);
  press(&mut ui,KEY_ENTER, 0u32);
  typeString(&mut ui, "if core.version == 0u64 {\nimm fresh = true;\n");
  typeString(&mut ui, "}");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  ui.setText(status, "4: typed an if block: Enter indents, a brace opens a level");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  drawUi(&ui, &mut list);
  rig.paint(device, &list, true, &mut times);
  rig.savePng(&outPath.join("04-edit.png"));
  print <- "undo steps after the edit: ", u64.from(ed.doc.hist.undoCount()), "\n";
  press(&mut ui,KEY_Z, MOD_CTRL);
  press(&mut ui,KEY_Z, MOD_CTRL);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  ui.setText(status, "5: two undos (a step is a run of typing; the closing brace and the last line are gone)");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  drawUi(&ui, &mut list);
  rig.paint(device, &list, true, &mut times);
  rig.savePng(&outPath.join("05-undo.png"));
  press(&mut ui,KEY_Y, MOD_CTRL);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  ui.setText(status, "6: one redo");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  drawUi(&ui, &mut list);
  rig.paint(device, &list, true, &mut times);
  rig.savePng(&outPath.join("06-redo.png"));

  // 5. three carets (alt+click) and one keystroke
  while ed.doc.undo() {}
  let l0 = ed.doc.buffer().lineOf(at);
  ed.doc.setCaret(ed.doc.buffer().lineStart(l0 + 1usize));
  ed.dirtyAll();
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  click(&mut ui, ed.pointOf(&ui, ed.doc.buffer().lineStart(l0 + 3usize)), MOD_ALT);
  click(&mut ui, ed.pointOf(&ui, ed.doc.buffer().lineStart(l0 + 5usize)), MOD_ALT);
  typeString(&mut ui, "// ");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  ui.setText(status, "7: three carets, one typed comment marker");
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  drawUi(&ui, &mut list);
  rig.paint(device, &list, true, &mut times);
  rig.savePng(&outPath.join("07-multicaret.png"));
  describe("shot 7", &ed);
  press(&mut ui,KEY_Z, MOD_CTRL);
  frame(&mut ui, &mut ed, &rig.font, &mut rig.atlas);
  print <- "after undoing the three-caret keystroke: ", u64.from(ed.doc.caretCount()), " caret(s)\n";

  // 6. the same file in a proportional font (Segoe UI): the editor measures every run
  var ed3 = Editor.make(&mut ui, ui.root, source.view());
  ed3.style.size = 15.;
  ed3.style.mono = false;
  ui.setOffsets(ed3.node, 20., 20., 0., 0.);
  ui.setSize(ed3.node, f32.from(W) - 40., f32.from(H) - 70.);
  ui.setVisible(ed.node, false);
  frame(&mut ui, &mut ed3, &rig2.font, &mut rig2.atlas);
  let at3 = findNext(ed3.doc.buffer(), &opts, 0usize);
  ed3.showLine(&ui, ed3.doc.buffer().lineOf(at3), 0.3);
  frame(&mut ui, &mut ed3, &rig2.font, &mut rig2.atlas);
  let w0 = ed3.pointOf(&ui, at3);
  pointerMove(&mut ui, 400., 300.);
  click(&mut ui, new Vec2(w0.x + 80., w0.y), 0u32);
  press(&mut ui, KEY_RIGHT, MOD_CTRL | MOD_SHIFT);
  press(&mut ui, KEY_RIGHT, MOD_CTRL | MOD_SHIFT);
  ui.setText(status, "9: proportional font: runs measured, a double-click-style word selection with ctrl+shift+right");
  frame(&mut ui, &mut ed3, &rig2.font, &mut rig2.atlas);
  drawUi(&ui, &mut list);
  rig2.paint(device, &list, true, &mut times);
  rig2.savePng(&outPath.join("09-proportional.png"));
  ui.setVisible(ed3.node, false);

  // 7. a 10,000-line file: frame costs
  var big = String.empty();
  while true {
    big.append(source.view());
    if big.view().len() > 10000usize * 38usize {break;}
  }
  var ed2 = Editor.make(&mut ui, ui.root, big.view());
  ed2.style.size = 15.;
  ui.setOffsets(ed2.node, 20., 20., 0., 0.);
  ui.setSize(ed2.node, f32.from(W) - 40., f32.from(H) - 70.);
  ui.setVisible(ed.node, false);
  frame(&mut ui, &mut ed2, &rig.font, &mut rig.atlas);
  print <- "big file: ", u64.from(ed2.doc.lineCount()), " lines, ", u64.from(big.len()), " bytes\n";
  // scroll to line ~4,500 with the wheel, then click in the text: the caret and focus are there
  pointerMove(&mut ui, 400., 300.);
  wheel(&mut ui, 0., -1500.);
  frame(&mut ui, &mut ed2, &rig.font, &mut rig.atlas);
  click(&mut ui, new Vec2(500., 300.), 0u32);
  print <- "the big editor has the focus: ", i64.from(ui.input.focus == ed2.node), " (1 = yes)\n";
  frame(&mut ui, &mut ed2, &rig.font, &mut rig.atlas);
  ui.setText(status, "8: a 10,000-line file, scrolled to line ~4,500");
  frame(&mut ui, &mut ed2, &rig.font, &mut rig.atlas);
  drawUi(&ui, &mut list);
  var scratchTimes = List[i64].empty();
  rig.paint(device, &list, true, &mut scratchTimes);
  rig.savePng(&outPath.join("08-big-file.png"));
  describe("shot 8", &ed2);

  // frame costs: nanoseconds, 200 frames each
  let lenBefore = ed2.doc.len();
  textInput(&mut ui, 120u32);
  print <- "queued: ", i64.from(hasHostEvents(&ui, ed2.node)), " focused ", i64.from(ed2.focused), "\n";
  frame(&mut ui, &mut ed2, &rig.font, &mut rig.atlas);
  print <- "typing grew the text by ", u64.from(ed2.doc.len() - lenBefore), " bytes\n";
  var idleModel = List[i64].empty();
  var typeModel = List[i64].empty();
  var scrollModel = List[i64].empty();
  var idleGpu = List[i64].empty();
  var typeGpu = List[i64].empty();
  var scrollGpu = List[i64].empty();
  var typePrep = List[i64].empty();
  var typeRecord = List[i64].empty();
  var typeWait = List[i64].empty();
  var f = 0u32;
  while f < 200u32 {
    // idle: nothing changed
    let a0 = sdl.GetTicksNS();
    frame(&mut ui, &mut ed2, &rig.font, &mut rig.atlas);
    drawUi(&ui, &mut list);
    let a1 = sdl.GetTicksNS();
    idleModel.push(i64.from(a1 - a0));
    var tt = List[i64].empty();
    rig.paint(device, &list, false, &mut tt);
    idleGpu.push(*tt[0usize] + *tt[1usize] + *tt[2usize]);
    // a keystroke
    let b0 = sdl.GetTicksNS();
    textInput(&mut ui, 120u32);
    frame(&mut ui, &mut ed2, &rig.font, &mut rig.atlas);
    drawUi(&ui, &mut list);
    let b1 = sdl.GetTicksNS();
    typeModel.push(i64.from(b1 - b0));
    var tk = List[i64].empty();
    rig.paint(device, &list, false, &mut tk);
    typeGpu.push(*tk[0usize] + *tk[1usize] + *tk[2usize]);
    typePrep.push(*tk[0usize]);
    typeRecord.push(*tk[1usize]);
    typeWait.push(*tk[2usize]);
    // a wheel step
    let c0 = sdl.GetTicksNS();
    wheel(&mut ui, 0., -1.);
    frame(&mut ui, &mut ed2, &rig.font, &mut rig.atlas);
    drawUi(&ui, &mut list);
    let c1 = sdl.GetTicksNS();
    scrollModel.push(i64.from(c1 - c0));
    var ts = List[i64].empty();
    rig.paint(device, &list, false, &mut ts);
    scrollGpu.push(*ts[0usize] + *ts[1usize] + *ts[2usize]);
    f = f + 1u32;
  }
  print <- "frame cost on the 10,000-line file, p50 of 200 frames, microseconds:\n";
  print <- "  idle frame:     editor+uilayout ", p50(&idleModel) / 1000i64, "   renderer and GPU ", p50(&idleGpu) / 1000i64, "\n";
  print <- "  one keystroke:  editor+uilayout ", p50(&typeModel) / 1000i64, "   renderer and GPU ", p50(&typeGpu) / 1000i64,
    "  (prep ", p50(&typePrep) / 1000i64, ", record+submit ", p50(&typeRecord) / 1000i64, ", wait for GPU ", p50(&typeWait) / 1000i64, ")\n";
  print <- "  one wheel step: editor+uilayout ", p50(&scrollModel) / 1000i64, "   renderer and GPU ", p50(&scrollGpu) / 1000i64, "\n";
  print <- "  draw commands in the list: ", u64.from(list.cmds.len()), ", glyphs ", u64.from(rig.glyphs), ", rect primitives ", u64.from(rig.prims), "\n";
  print <- "  lines tokenized in all: ", u64.from(ed2.linesTokenized), ", draw lists made: ", u64.from(ed2.rebuilds), "\n";
}

// The editor's clipboard and the system's, joined with SDL: what the host does around 'pump'. Run with
// --clipboard, it checks a round trip with the real system clipboard, putting back what was there
// (and doing nothing at all if the clipboard holds something that is not text)
fn clipboardRoundTrip() {
  if !sdl.Init(sdl.INIT_VIDEO) {
    print <- "clipboard: SDL's video would not start\n";
    return;
  }
  // (SDL's Windows clipboard wants a window to open it with: a hidden one, never shown, takes no input)
  let window = sdl.CreateWindow(cstr.fromLiteral("textedit clipboard"), 64, 64, sdl.WINDOW_HIDDEN);
  let hadText = sdl.HasClipboardText();
  var before = String.empty();
  if hadText {
    let p = sdl.GetClipboardText();
    before = String.from(cstr.fromPtr(p).view());
    sdl.free(p);
  }
  // (a clipboard that holds a picture or files has no text: leave it alone)
  var ui = Ui.make(400., 200.);
  var ed = Editor.make(&mut ui, ui.root, "alpha beta gamma\n");
  ui.setSize(ed.node, 400., 200.);
  var m = fn(t: &str, face: u32, size: f32) Vec2 { new Vec2(f32.from(t.len()) * 8., 20.) };
  layout(&mut ui, &mut m);
  ed.refresh(&mut ui, &mut m, &coneTokenizer);
  click(&mut ui, new Vec2(100., 10.), 0u32);
  ed.pump(&mut ui, &mut m, &coneTokenizer);
  ed.doc.selectWordAt(8usize);
  press(&mut ui, KEY_C, MOD_CTRL);
  ed.pump(&mut ui, &mut m, &coneTokenizer);
  print <- "copied: \"", ed.clipboard.view(), "\" written ", i64.from(ed.clipboardWritten), "\n";
  if ed.clipboardWritten {
    // (another program may hold the Windows clipboard open for a moment: try again a few times)
    var ok = false;
    var tries = 0u32;
    while !ok && tries < 10u32 {
      ok = sdl.SetClipboardText(cstr.fromLiteral(ed.clipboard.view()));
      if !ok {sdl.Delay(100u32);}
      tries = tries + 1u32;
    }
    print <- "SDL_SetClipboardText: ", i64.from(ok), " after ", u64.from(tries), " tries ", sdl.GetError().view(), "\n";
    ed.clipboardWritten = false;
  }
  // ... the host reads the system clipboard before a paste
  press(&mut ui, KEY_END, 0u32);
  press(&mut ui, KEY_V, MOD_CTRL);
  if ed.needsClipboard(&ui) {
    let p = sdl.GetClipboardText();
    ed.clipboard = String.from(cstr.fromPtr(p).view());
    sdl.free(p);
  }
  ed.pump(&mut ui, &mut m, &coneTokenizer);
  print <- "clipboard round trip through SDL: the first line is now \"", ed.doc.buffer().lineText(0usize).view(), "\" (expected \"alpha beta gammabeta\")\n";
  if hadText {sdl.SetClipboardText(cstr.fromLiteral(before.view()));}
  sdl.DestroyWindow(window);
  sdl.Quit();
}

fn main() i32 {
  let args = process.args();
  var i = 1usize;
  while i < args.len() {
    if (*args[i]).view() == "--clipboard" {
      clipboardRoundTrip();
      return 0;
    }
    i = i + 1usize;
  }
  var out = String.from("editor-shots");
  var sample = String.from("C:/src/cone-wt-textedit/packages/textedit/src/doc.cone");
  if args.len() > 1usize {out = String.from((*args[1usize]).view());}
  if args.len() > 2usize {sample = String.from((*args[2usize]).view());}
  var instance = Instance.create("textedit demo");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 {preference = POWER_PREFERENCE_LOW_POWER;}
  }
  var adapter = instance.requestAdapter(&none, preference);
  var device = adapter.requestDevice();
  print <- "adapter ", adapter.name.view(), "\n";
  run(&mut device, out.view(), &Path.from(sample.view()));
  0
}

