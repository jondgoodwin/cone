// How the text buffer holds up on a large file. Builds a text of about 50 MB (a million and a half lines),
// loads it, then times edits at the top, the middle and the end, line lookups, a find across the whole text,
// and a replace-all as one undo step. Run in release mode:
//
//   congo run --release examples/bench.cone

mod textbench;

import stdio use *;
import sdl;
import collections use *;
import textedit use *;

fn micros(from: u64, to: u64) i64 {i64.from((to - from) / 1000u64)}

fn main() i32 {
  var text = String.withCapacity(60000000usize);
  var n = 0u32;
  while text.len() < 50000000usize {
    text.append("    imm line = core.buf.lineOf(e.pos); // number ");
    text.appendUInt(u64.from(n));
    text.append("\n");
    n = n + 1u32;
  }
  print <- "text: ", u64.from(text.len()), " bytes, ", u64.from(n), " lines\n";
  let t0 = sdl.GetTicksNS();
  var doc = Doc.fromText(text.view());
  let t1 = sdl.GetTicksNS();
  print <- "load (one copy and the line index): ", micros(t0, t1) / 1000i64, " ms\n";
  var at = List[usize].empty();
  at.push(10usize);
  at.push(doc.len() / 2usize);
  at.push(doc.len() - 5usize);
  var k = 0usize;
  while k < 3usize {
    var times = List[i64].empty();
    var i = 0u32;
    while i < 20u32 {
      doc.setCaret(*at[k]);
      let a = sdl.GetTicksNS();
      doc.insertText("x");
      let b = sdl.GetTicksNS();
      times.push(micros(a, b));
      i = i + 1u32;
    }
    times.sortBy(fn(x: &i64, y: &i64) i32 { if *x < *y {-1i32} else if *x > *y {1i32} else {0i32} });
    print <- "a keystroke at ", u64.from(*at[k]), ": p50 ", *times[10usize], " us, worst ", *times[19usize], " us (", u64.from(doc.buffer().pieceCount()), " pieces)\n";
    k = k + 1usize;
  }
  let c = sdl.GetTicksNS();
  var sum = 0usize;
  var l = 0usize;
  while l < doc.lineCount() {
    sum = sum + doc.buffer().lineLen(l);
    l = l + 1usize;
  }
  let d = sdl.GetTicksNS();
  print <- "lineLen of every line: ", micros(c, d) / 1000i64, " ms (", u64.from(sum), " bytes)\n";
  let e = sdl.GetTicksNS();
  let opts = FindOptions.make("number 1499999");
  let found = findNext(doc.buffer(), &opts, 0usize);
  let f = sdl.GetTicksNS();
  print <- "find near the end of the text: ", micros(e, f) / 1000i64, " ms (offset ", u64.from(found), ")\n";
  let g = sdl.GetTicksNS();
  let replaced = replaceAll(&mut doc, &FindOptions.make("number 1499"), "num 1499");
  let h = sdl.GetTicksNS();
  print <- "replace all: ", u64.from(replaced), " replacements in ", micros(g, h) / 1000i64, " ms, one undo step: ", u64.from(doc.hist.undoCount()), " steps in all\n";
  let i2 = sdl.GetTicksNS();
  doc.undo();
  let j = sdl.GetTicksNS();
  print <- "undoing it: ", micros(i2, j) / 1000i64, " ms\n";
  0
}
