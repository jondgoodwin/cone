// Doc: carets, selections, editing and undo, with answers worked out by hand.

mod doctest;

import testing use *;
import collections use *;
import textedit use *;

fn txt(d &Doc) String {d.buffer().all();}
fn head(d &Doc) i64 {i64.from(d.caret(d.caretCount() - 1usize).head);}

fn alwaysCode(off usize) bool {true;}

fn main() i32 {
  // typing merges by character class: "ab cd" is three steps (ab, space, cd)
  mut d = Doc.make();
  d.insertText("a");
  d.insertText("b");
  expectInt(i64.from(d.hist.undoCount()), 1i64, "ab is one step");
  d.insertText(" ");
  d.insertText("c");
  d.insertText("d");
  expectStr(txt(&d).view(), "ab cd", "typed text");
  expectInt(i64.from(d.hist.undoCount()), 3i64, "three steps: ab, space, cd");
  expectInt(head(&d), 5i64, "caret after the text");
  d.undo();
  expectStr(txt(&d).view(), "ab ", "undo one word");
  expectInt(head(&d), 3i64, "caret restored");
  d.undo();
  d.undo();
  expectStr(txt(&d).view(), "", "undone to empty");
  d.redo();
  expectStr(txt(&d).view(), "ab", "redo");
  expectInt(head(&d), 2i64, "caret after redo");
  expect(d.isDirty(), "dirty before save");
  d.markSaved();
  expect(!d.isDirty(), "clean after save");

  // backspace merges
  mut b = Doc.fromText("hello");
  b.setCaret(5usize);
  b.deleteBackward(false);
  b.deleteBackward(false);
  b.deleteBackward(false);
  expectStr(txt(&b).view(), "he", "three backspaces");
  expectInt(i64.from(b.hist.undoCount()), 1i64, "one step");
  b.undo();
  expectStr(txt(&b).view(), "hello", "undo restores all three");
  expectInt(head(&b), 5i64, "and the caret");

  // replace a selection
  mut r = Doc.fromText("hello world");
  r.setSelection(6usize, 11usize);
  r.insertText("X");
  expectStr(txt(&r).view(), "hello X", "selection replaced");
  expectInt(head(&r), 7i64, "caret after X");

  // multiple carets: one keystroke, one undo
  mut m = Doc.fromText("a\nb\nc");
  m.setCaret(1usize);
  m.addCaret(3usize);
  m.addCaret(5usize);
  expectInt(i64.from(m.caretCount()), 3i64, "three carets");
  m.insertText("!");
  expectStr(txt(&m).view(), "a!\nb!\nc!", "three insertions");
  expectInt(i64.from(m.caret(0usize).head), 2i64, "caret 0");
  expectInt(i64.from(m.caret(1usize).head), 5i64, "caret 1");
  expectInt(i64.from(m.caret(2usize).head), 8i64, "caret 2");
  expectInt(i64.from(m.hist.undoCount()), 1i64, "one undo step");
  m.undo();
  expectStr(txt(&m).view(), "a\nb\nc", "undone together");
  expectInt(i64.from(m.caret(1usize).head), 3i64, "carets restored");
  m.redo();
  expectStr(txt(&m).view(), "a!\nb!\nc!", "redone together");
  m.deleteBackward(false);
  expectStr(txt(&m).view(), "a\nb\nc", "backspace at three carets");

  // carets that meet merge
  mut mm = Doc.fromText("abc");
  mm.setCaret(1usize);
  mm.addCaret(2usize);
  mm.move(MOVE_LEFT, false);
  expectInt(i64.from(mm.caretCount()), 2i64, "carets 1 and 2 moved left are at 0 and 1: still two");
  mm.move(MOVE_LEFT, false);
  expectInt(i64.from(mm.caretCount()), 1i64, "both at 0 merge into one");

  // auto-indent
  mut a = Doc.fromText("  foo(");
  a.setCaret(6usize);
  a.newline(true);
  expectStr(txt(&a).view(), "  foo(\n    ", "indent plus a level after an opening bracket");
  expectInt(head(&a), 11i64, "caret at the end of the indent");
  mut c2 = Doc.fromText("fn() {}");
  c2.setCaret(6usize);
  c2.newline(true);
  expectStr(txt(&c2).view(), "fn() {\n  \n}", "braces open out onto three lines");
  expectInt(head(&c2), 9i64, "caret on the middle line, indented");
  mut p = Doc.fromText("\tx = 1");
  p.setCaret(6usize);
  p.newline(true);
  expectStr(txt(&p).view(), "\tx = 1\n\t", "the indent is copied");
  p.undo();
  expectStr(txt(&p).view(), "\tx = 1", "undo");

  // movement: goal column
  mut v = Doc.fromText("abcdef\nab\nabcdef");
  v.setCaret(5usize);
  v.move(MOVE_DOWN, false);
  expectInt(head(&v), 9i64, "down onto a short line goes to its end (offset 9)");
  v.move(MOVE_DOWN, false);
  expectInt(head(&v), 15i64, "down again returns to column 5 (offset 10 + 5)");
  v.move(MOVE_UP, false);
  v.move(MOVE_UP, false);
  expectInt(head(&v), 5i64, "and back up");
  v.move(MOVE_UP, false);
  expectInt(head(&v), 0i64, "up from the first line goes to the start");
  v.move(MOVE_DOC_END, true);
  expectInt(i64.from(v.caret(0usize).anchor), 0i64, "extend keeps the anchor");
  expectInt(head(&v), 16i64, "to the end");
  v.move(MOVE_LEFT, false);
  expectInt(head(&v), 0i64, "left of a selection collapses to its start");

  // tabs count to the next stop
  mut t = Doc.fromText("\tab");
  expectInt(i64.from(t.colOf(1usize)), 4i64, "after a tab: column 4");
  expectInt(i64.from(t.colOf(3usize)), 6i64, "after tab, a, b: column 6");
  expectInt(i64.from(t.offsetAtCol(0usize, 5u32)), 2i64, "column 5 is offset 2");

  // words
  mut w = Doc.fromText("foo bar_baz  qux");
  expectInt(i64.from(w.wordRight(0usize)), 4i64, "word right from 0");
  expectInt(i64.from(w.wordRight(4usize)), 13i64, "bar_baz is one word");
  expectInt(i64.from(w.wordLeft(13usize)), 4i64, "word left");
  expectInt(i64.from(w.wordLeft(4usize)), 0i64, "word left again");
  w.selectWordAt(5usize);
  expectStr(w.selectedText().view(), "bar_baz", "double click selects the word");
  w.setCaret(16usize);
  w.deleteBackward(true);
  expectStr(txt(&w).view(), "foo bar_baz  ", "delete word backward");

  // indent and outdent
  mut i = Doc.fromText("a\nb\n\nc");
  i.setSelection(0usize, 6usize);
  i.tab(false);
  expectStr(txt(&i).view(), "  a\n  b\n\n  c", "indent three lines, skipping the empty one");
  i.tab(true);
  expectStr(txt(&i).view(), "a\nb\n\nc", "outdent");
  i.undo();
  expectStr(txt(&i).view(), "  a\n  b\n\n  c", "undo the outdent");
  mut tt = Doc.fromText("x");
  tt.setCaret(1usize);
  tt.tab(false);
  expectStr(txt(&tt).view(), "x  ", "tab at a caret inserts the unit");

  // paste: a piece per caret
  mut pp = Doc.fromText("..\n..");
  pp.setCaret(2usize);
  pp.addCaret(5usize);
  pp.paste("x\ny");
  expectStr(txt(&pp).view(), "..x\n..y", "two lines to two carets");
  mut p1 = Doc.fromText("ab");
  p1.setCaret(1usize);
  p1.paste("1\n2");
  expectStr(txt(&p1).view(), "a1\n2b", "a multi-line paste to one caret");

  // CRLF
  mut cr = Doc.fromText("a\r\nb");
  expect(cr.crlf, "crlf detected");
  cr.setCaret(3usize);
  cr.deleteBackward(false);
  expectStr(txt(&cr).view(), "ab", "backspace over CRLF removes both bytes");
  cr.undo();
  expectStr(txt(&cr).view(), "a\r\nb", "undone");
  cr.setCaret(1usize);
  cr.newline(false);
  expectStr(txt(&cr).view(), "a\r\n\r\nb", "newlines are CRLF in a CRLF file");

  // UTF-8
  mut u = Doc.fromText("aéb");
  u.setCaret(3usize);
  u.move(MOVE_LEFT, false);
  expectInt(head(&u), 1i64, "left over a two-byte letter");
  u.deleteForward(false);
  expectStr(txt(&u).view(), "ab", "delete removes the whole letter");

  // delete lines
  mut dl = Doc.fromText("one\ntwo\nthree");
  dl.setCaret(5usize);
  dl.deleteLines();
  expectStr(txt(&dl).view(), "one\nthree", "delete the middle line");
  dl.setCaret(6usize);
  dl.deleteLines();
  expectStr(txt(&dl).view(), "one", "delete the last line takes the break before it");

  // brackets
  imm bt = Doc.fromText("f(a[1], {b})");
  imm all = fn(off usize) bool {true;};
  expectInt(i64.from(bt.matchBracket(1usize, &all, 1000usize)), 11i64, "( matches )");
  expectInt(i64.from(bt.matchBracket(11usize, &all, 1000usize)), 1i64, ") matches (");
  expectInt(i64.from(bt.matchBracket(8usize, &all, 1000usize)), 10i64, "{ matches }");
  expectInt(i64.from(bt.matchBracket(3usize, &all, 1000usize)), 5i64, "[ matches ]");
  expect(bt.matchBracket(0usize, &all, 1000usize) == NOT_FOUND, "f is no bracket");
  imm unclosed = Doc.fromText("(((");
  expect(unclosed.matchBracket(0usize, &all, 1000usize) == NOT_FOUND, "no match");
  done();
}
