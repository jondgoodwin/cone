// A panic on a thread the program started ends the whole program, as one on
// the main thread does: nothing unwinds, so there is no losing one thread
// while the rest go on. The main thread is waiting in 'join' when it happens.
// Its .exit is a panic's, the status the Microsoft C library's 'abort' ends a
// program with, 0xC0000409. Its stderr, unchecked here since it names the
// thread by an identity that differs from run to run, says: panic in thread
// <id> at threadpanic.cone:16: from a thread.

mod threadpanic;

import stdio use *;
import thread;

fn work(n i32) i32 {
  if n > 0 {
    panic("from a thread");
  }
  n;
}

fn main() i32 {
  printStr("starting\n");
  imm t = thread.start(1, &work);
  t.join();
  printStr("not reached\n");
  0;
}
