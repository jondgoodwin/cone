// The futex and parking. A waiter sleeps while its word holds what it
// expects, and returns once main changes the word and wakes it; 'futexWakeAll'
// wakes every waiter; a word that already differs returns at once; a timeout
// returns false. 'park' sleeps until an 'unpark': one sent before the park is
// not lost, and a thread can unpark main through the ThreadRef it was handed.
//
// A waiter always loops on the word, as every futex user must: a wait may
// return spuriously, and a wake may come before the wait. So what is checked
// is that each wait returns and sees the changed word, never how many times
// it slept. 'testing' counts its checks in globals, so every check is made on
// the main thread.

mod futex;

import testing use *;
import thread;

fn load(word *u32) u32 { mem.atomicLoad[u32](word, MemOrder.SeqCst[]); }

// Wait until the word is no longer 0; answer what it became
fn waitChange(word *u32) u32 {
  while load(word) == 0u32 {
    thread.futexWait(word, 0u32);
  }
  load(word);
}

// Count this waiter in, then wait for the word to change
struct Waiter {
  pub word *u32;
  pub ready *u32;
}

fn countedWait(w Waiter) u32 {
  mem.atomicAdd[u32](w.ready, 1u32, MemOrder.SeqCst[]);
  waitChange(w.word);
}

fn parkThenAnswer(n i64) i64 {
  thread.park();
  n + 1;
}

// Unpark whoever handed us their ThreadRef
fn unparkBack(back thread.ThreadRef) u32 {
  thread.sleep(10000000u64);
  back.unpark();
  back.id();
}

// Wait for main's go-ahead, then park: main's unpark came first
fn parkAfterGo(go *u32) u32 {
  waitChange(go);
  thread.park();
  1u32;
}

fn main() i32 {
  // One waiter, woken
  mut word = 0u32;
  imm w = thread.start(&mut word as *u32, &waitChange);
  thread.sleep(20000000u64);
  mem.atomicStore[u32](&mut word as *u32, 5u32, MemOrder.SeqCst[]);
  thread.futexWake(&mut word as *u32);
  expectUInt(u64[w.join()], 5u64, "the waiter returned with the new value");

  // Three waiters, all woken at once
  mut shared = 0u32;
  mut ready = 0u32;
  imm waiter = Waiter[&mut shared as *u32, &mut ready as *u32];
  imm a = thread.start(waiter, &countedWait);
  imm b = thread.start(waiter, &countedWait);
  imm c = thread.start(waiter, &countedWait);
  while load(&mut ready as *u32) < 3u32 { thread.sleep(1000000u64); }
  thread.sleep(10000000u64);
  mem.atomicStore[u32](&mut shared as *u32, 9u32, MemOrder.SeqCst[]);
  thread.futexWakeAll(&mut shared as *u32);
  expectUInt(u64[a.join() + b.join() + c.join()], 27u64, "wakeAll woke all three waiters");

  // A word that already differs does not sleep
  mut other = 3u32;
  expect(thread.futexWait(&mut other as *u32, 4u32), "a wait on a changed word returns true");

  // A timeout returns false
  expect(!thread.futexWait(&mut other as *u32, 3u32, 5000000u64), "a timed-out wait returns false");

  // park, then unpark from main
  imm p = thread.start(41i64,&parkThenAnswer);
  thread.sleep(20000000u64);
  p.unpark();
  expectInt(p.join(), 42, "a parked thread returned after unpark");

  // unpark before park is not lost: on main itself ...
  imm me = thread.current();
  me.unpark();
  thread.park();
  expect(true, "main's own unpark before its park was kept");

  // ... and on a thread unparked before it parks
  mut go = 0u32;
  imm late = thread.start(&mut go as *u32, &parkAfterGo);
  late.unpark();
  mem.atomicStore[u32](&mut go as *u32, 1u32, MemOrder.SeqCst[]);
  thread.futexWake(&mut go as *u32);
  expectUInt(u64[late.join()], 1u64, "a thread unparked before it parked did not sleep");

  // A thread unparks main, through the ThreadRef main handed it
  imm back = thread.start(thread.current(), &unparkBack);
  thread.park();
  expectUInt(u64[back.join()], u64[me.id()], "a thread unparked main through its ThreadRef");
  done();
}
