// Many 'Arc[imm, Array[i64]]' made, read by two threads and freed, one after
// another, so the heap block of each sits beside the blocks of its neighbours.
// Allocating one by copying a borrow once wrote a NUL one byte past its
// elements, outside the block, on top of the next block's heap header; the C
// library's heap noticed only when that neighbour was freed or merged, so
// arcarray died now and then with 0xC0000374 (heap corruption), and only when
// the neighbours happened to be placed so. Here every round makes two arrays
// of 8 numbers (each block asks for 8 + 64 = 72 bytes, the size where a byte
// more is the next block), starts a reader on each, and frees both arrays
// when the last owner goes, whichever thread that is, 1000 rounds in a row.
//
// Worked out by hand: a reader returns 8 * 1000 + 36 = 8036 (the numbers are
// 1 through 8); a round has two readers, 16072; 1000 rounds, 16072000.

mod arcarrays;

import testing use *;
import thread;
import sync use *;

fn reader(m Arc[imm, Array[i64]]) u64 {
  mut sum = 0u64;
  mut i = 0usize;
  while i < m.len {
    sum = sum + u64.from(m[i]);
    i = i + 1usize;
  }
  u64.from(m.len) * 1000u64 + sum;
}   // this thread's owner of m goes here

fn main() i32 {
  initAll();
  mut a thread.Thread[u64];
  mut b thread.Thread[u64];
  mut total = 0u64;
  mut round = 0u32;
  while round < 1000u32 {
    {
      imm numbers = new Array[i64, 8] <- 1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64;
      imm m = new Arc[imm, Array[i64]](&numbers);
      imm n = new Arc[imm, Array[i64]](&numbers);
      a = thread.start(m, &reader);
      b = thread.start(n, &reader);
    }   // main's owners go: the readers hold the only ones
    total = total + a.join() + b.join();
    round = round + 1u32;
  }
  expectUInt(total, 16072000u64, "1000 rounds of two readers, each 8 numbers summing to 36");
  done();
}
