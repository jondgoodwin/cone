// The thread package: operating-system threads. A deliberately small layer:
// the scheduler is to be written in Cone above it, and a program that wants
// an OS thread of its own uses it directly. The futex that everything which
// blocks is built on, and the locks and the channels built on the futex, are
// the sync package's, which this package imports for its parking and its
// own atomic counts.
//
//   mod sums;
//   import thread;
//
//   fn triangle(n i64) i64 { ... }
//
//   fn main() {
//     imm t = thread.start(100i64, &triangle);  // runs triangle(100)
//     ...                                       // main goes on
//     imm total = t.join();                     // waits; 5050
//   }
//
// What it has:
//
//   thread.start(arg, &f)              a new thread running f(arg): a Thread[R]
//   thread.startWith(opts, arg, &f)    the same, with a name and a stack size
//   t.join()                           wait for it; what f returned
//   t.detach()                         let it run on alone
//   t.id()  t.name()  t.unpark()  t.threadRef()
//   thread.current()                   the running thread, as a ThreadRef
//   r.id()  r.name()  r.unpark()  r.copy()
//   thread.parallelism()               how many threads can run at once
//   thread.sleep(ns)                   sleep, to within about a millisecond
//   thread.yieldNow()                  let another thread run
//   thread.park()                      sleep until this thread is unparked
//
// Deliberately not here: killing a thread, priorities, pinning a thread to a
// processor, a flag asking a thread to stop, and scoped threads (a function
// that joins every thread it starts before it returns, so they may borrow).
// Windows only for now, with the posix side to come: every call the package
// makes to the OS is in its own section below, beside nothing else.
//
// STARTING A THREAD. 'thread.start(arg, &f)' starts a new OS thread
// running 'f(arg)', and returns its handle at once, a Thread[R]. f is a plain
// function taking one A and returning an R, which may be 'void'; a closure
// cannot capture anything yet, so a function and one value is the whole of
// what a thread is given, and a struct carries more than one. 'arg' is MOVED
// in: the thread owns it, and it dies there, when f is done with it (or in f,
// if f moves it on).
//
// - The type arguments A and R are inferred from the argument and from f's
//   signature. A number literal keeps its own type, i32 unless suffixed, and
//   must agree with f's parameter: 'thread.start(100i64, &triangle)'.
// - The function comes last, after the argument. A parameter typed as a
//   function reference with a return type ('&fn(a A) R') swallows a comma
//   after it as the start of a second return type, so it can only be the last
//   parameter. And 'spawn', the name this was designed with, is reserved.
// - A and R must be Sendable, which the compiler checks where 'start' is
//   called: what may cross to another thread is a value the thread owns
//   outright (a number, a struct of them, a '+so' owner, a 'uni' owner of
//   what may cross itself) or an owner of an 'imm' or 'opaq' value whose
//   region's count is atomic: an '+arc-imm' owner (the sync package's 'arc',
//   after 'import sync use arc'), which 'start' copies (one owner more, going
//   when the thread is done with it), so that the value dies once, after the
//   last thread lets it go (tests/arcshare.cone). Refused, naming what is at
//   fault: a borrowed reference of any permission (to the starting thread's
//   stack or anywhere else), a 'mut' or 'ro' owner, an 'rc' owner of any
//   permission but 'uni' (its count is not atomic), a '+gc' reference, and a
//   raw pointer, since nothing checks what it points at. A struct carrying raw
//   pointers the program shares safely, with the sync package's atomics or
//   locks, declares 'is Sendable', a promise the compiler takes on trust
//   (tests/counter.cone).
//
// 'thread.startWith(thread.Options[name: "worker", stackSize: s], arg, &f)'
// does the same with options, each of which has a default:
//
// - 'name' ("" by default) is copied when the thread starts, so the slice
//   need only live through the call. It is Cone's: the thread and its
//   handle see it through 'name()', and the OS and its debuggers do not.
// - 'stackSize' (0 by default) is how many bytes of address space to reserve
//   for the thread's stack. 0 is the executable's default (1 MB as the Visual
//   C++ linker writes it); Windows rounds any other size up to its allocation
//   granularity, and a size of 4 GB or more is taken as 4 GB less one byte.
//   Running past the end of a stack is a trap.
//
// A thread that cannot be started, or a block the C library cannot allocate,
// is a panic: what went wrong on stderr, then the C library's 'abort'. A
// panic, or a trap, on any thread ends the whole process, the other threads
// with it.
//
// THE HANDLE. A Thread[R] is the one owner of its thread, a move type:
//
// - 't.join()' waits for the thread to finish and returns what f returned.
//   It takes the handle, so a thread is joined once.
// - 't.detach()' takes the handle and lets the thread run on alone. What f
//   returns is then finalized on the thread when f is done, since nobody
//   will read it.
// - A handle that dies unjoined and undetached JOINS: its finalizer waits for
//   the thread, and finalizes what f returned. A handle held in a local waits
//   at the end of the local's block. That is tidiness, not safety: a handle
//   can be kept where it never dies (a global, a leaked allocation), and a
//   process ends without finalizing anything its threads still hold, so no
//   program may depend on the join for its correctness. Join what must be
//   finished.
// - 't.id()', 't.name()' and 't.unpark()' are the thread's own, as below;
//   't.threadRef()' is a ThreadRef to it, to hand to others.
//
// A handle's methods take it by value or borrow it, as any value's do; a
// handle held in a field or in a collection cannot be moved out to join,
// since Cone does not yet move a value out of a struct's field (or an
// Option's), so such a handle is joined by its container's death.
//
// When 'main' returns, the process ends, and every thread still running ends
// with it, detached or not. Handles in main's own locals have been joined by
// then, as each died at the end of its block.
//
// WHO IS RUNNING. 'thread.current()' is a ThreadRef to the thread calling it.
// A ThreadRef keeps its thread's identity alive, not the thread, and may be
// sent to other threads; it is a move type, and 'r.copy()' makes another.
//
// - 'id()' is the OS's thread id, a u32, the same seen from the thread and
//   from its handle. The OS may give an id to a new thread once the thread
//   that had it has ended and its handle is gone.
// - 'name()' is the name 'startWith' was given, or "". The main thread, and
//   any thread this package did not start, has the empty name.
// - A thread this package did not start (main, or one started through the OS
//   directly) gets its identity the first time it asks, by 'current()' or
//   'park()', and never gives it back, since nothing runs when such a thread
//   ends: one small block per such thread.
//
// 'thread.parallelism()' is how many logical processors the machine has, in
// all processor groups: how many threads can truly run at once, at least 1.
// It is not the number this process may use, which an affinity mask or a job
// object can make smaller.
//
// 'thread.sleep(ns)' sleeps at least ns nanoseconds, on Windows' high
// resolution waitable timer: a 1 ms sleep takes 1 to 2 ms, where a plain
// Win32 'Sleep' can take up to the 15.6 ms of the system's timer tick. Where
// that timer is not available (before Windows 10 version 1803), it falls
// back to 'Sleep', rounded up to whole milliseconds. 'sleep(0)' gives up the
// rest of the thread's time slice to another thread of the same priority
// that is ready to run. 'yieldNow()' gives it to any thread ready to run on
// the same processor. Each returns at once if there is none.
//
// PARKING. Each thread has one parking token, which it starts without.
// 'thread.park()' takes the token, sleeping until there is one to take;
// 't.unpark()' (or 'r.unpark()', on its handle or a ThreadRef) makes it
// available. So an unpark sent before the park is not lost: the park takes it
// and returns at once. Unparks do not count: two before a park are one token,
// and the park after next sleeps. 'park' returns only once it has a token,
// never spuriously, but what it waits for should still be checked by the
// thread after it returns, since an unpark may be meant for an earlier park.
// It is built on the sync package's futex, over an Atomic[u32] in the
// thread's identity.
//
// THE FUTEX, AND THE LOCKS, are the sync package's: 'sync.futexWait(&word,
// expected, timeoutNs)', 'sync.futexWake(&word)' and 'sync.futexWakeAll(&word)'
// on an Atomic[u32] word, and Mutex, RwLock, Condvar and Once over them. The
// futex was this package's first, on a raw '*u32'; it moved to sync when the
// word became an Atomic[u32], since sync's locks need it and this package
// needs sync, and packages may not import each other in a loop.
//
// NOT ON A STARTED THREAD, YET: '+gc'. The collector package's collector is
// single threaded: its root chain is one C global and its heap is not
// synchronized. A traced ('+gc') reference made, held, reached or dropped on
// a thread this package started corrupts it. The thread check refuses one
// handed to 'start' or returned from a thread, but nothing stops a started
// thread from making one of its own; a concurrent collector is a later design.
//
// Thread-local globals ('mut @threadlocal x T = literal;') give each thread its
// own copy, which starts as the literal. Nothing finalizes a thread's copies
// when it ends. The 'testing' package counts its checks in globals, so a
// package's tests make their checks on the main thread.

mod thread;

import libc;
import sync;

// ---------------------------------------------------------------------------
// Windows: the C runtime's thread start, and kernel32. A thread is started by
// the C runtime's '_beginthreadex', not kernel32's 'CreateThread', so that
// the runtime Cone programs link against sets up and tears down its own
// per-thread state. The rest are kernel32's, on every link line already.
// Parking sleeps and wakes through the sync package's futex.
// ---------------------------------------------------------------------------

// A thread's entry, as '_beginthreadex' calls it: its argument, and the exit code
typedef Entry &fn(arg *u8) u32;

extern fn @c _beginthreadex(security *u8, stack u32, entry Entry, arg *u8, flags u32, id *u32) usize;

extern {
  fn @c(system) WaitForSingleObject(handle usize, ms u32) u32;
  fn @c(system) CloseHandle(handle usize) i32;
  fn @c(system) GetCurrentThreadId() u32;
  fn @c(system) SwitchToThread() i32;
  fn @c(system) Sleep(ms u32);
  fn @c(system) GetActiveProcessorCount(group u16) u32;
  fn @c(system) CreateWaitableTimerExW(attrs *u8, name *u16, flags u32, access u32) usize;
  fn @c(system) SetWaitableTimer(timer usize, due *i64, period i32, routine *u8, arg *u8, resume i32) i32;
}

const infinite = 0xFFFFFFFFu32;                // INFINITE
const stackIsReservation = 0x10000u32;         // STACK_SIZE_PARAM_IS_A_RESERVATION
const timerHighResolution = 0x2u32;            // CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
const timerAllAccess = 0x1F0003u32;            // TIMER_ALL_ACCESS
const allProcessorGroups = 0xFFFFu16;          // ALL_PROCESSOR_GROUPS

// ---------------------------------------------------------------------------
// Program errors
// ---------------------------------------------------------------------------

// A panic, reported at the line calling 'die'
fn die(msg &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) Never {
  panic(msg, file, line);
}

// ---------------------------------------------------------------------------
// A thread's identity: its Info block
// ---------------------------------------------------------------------------

// One per thread, from its start (or, for a thread 'start' did not begin, from
// the first time it asks for itself) until the last thing holding it lets go:
// the thread itself while it runs, its handle until joined or detached, and
// each ThreadRef. The name's bytes follow it in the same block.
struct Info {
  pub refs Atomic[u32];    // how many hold it
  pub id Atomic[u32];      // the OS thread id
  pub park Atomic[u32];    // the parking state, a futex word
  pub nameLen u32;
}

// The parking states: no token, a token, and a thread asleep waiting for one.
// 'park' subtracts 1, so a token becomes none and none becomes parked.
const parkEmpty = 0u32;
const parkNotified = 1u32;
const parkParked = 0xFFFFFFFFu32;

fn infoNew(name &[]u8, refs u32, id u32) *Info {
  imm size = mem.sizeof[Info]();
  imm p = libc.malloc(size + name.len) as *Info;
  if p as usize == 0usize {
    die("thread: out of memory");
  }
  (*p).refs = Atomic[u32].of(refs);
  (*p).id = Atomic[u32].of(id);
  (*p).park = Atomic[u32].of(parkEmpty);
  (*p).nameLen = u32[name.len];
  if name.len > 0usize {
    libc.memcpy((p as *u8) + size, name, name.len);
  }
  p;
}

fn infoHold(p *Info) {
  (*p).refs.addOrdered(1u32, MemOrder.Relaxed[]);
}

fn infoRelease(p *Info) {
  if (*p).refs.subOrdered(1u32, MemOrder.AcqRel[]) == 1u32 {
    libc.free(p as *u8);
  }
}

fn infoId(p *Info) u32 {
  (*p).id.loadOrdered(MemOrder.Relaxed[]);
}

// The thread's parking word, as the futex takes it
fn parkWord(p *Info) &Atomic[u32] {
  &(*p).park as &Atomic[u32];
}

fn infoName(p *Info) &[]u8 {
  mem.sliceFromParts[u8]((p as *u8) + mem.sizeof[Info](), usize[(*p).nameLen]);
}

// This thread's Info, or 0 before it has one
mut @threadlocal me usize = 0usize;

// This thread's Info, made the first time a thread 'start' did not begin asks
// for it. The thread's own hold on it is never released, since nothing runs
// when such a thread ends.
fn mine() *Info {
  if me == 0usize {
    me = infoNew("", 1u32, GetCurrentThreadId()) as usize;
  }
  me as *Info;
}

// Make the thread's token available, waking it if it is parked
fn unparkInfo(p *Info) {
  if (*p).park.swapOrdered(parkNotified, MemOrder.Release[]) == parkParked {
    sync.futexWake(parkWord(p));
  }
}

// ---------------------------------------------------------------------------
// Starting a thread
// ---------------------------------------------------------------------------

// What 'start' hands the new thread: one block, freed by whichever of the
// thread and its handle lets go of it last ('refs', first, so the handle
// reaches it without knowing A). 'result' holds a value once f returns, until
// 'join' moves it out or the last holder finalizes it.
struct Packet[A, R] {
  pub refs Atomic[u32];    // 2 while both thread and handle hold it
  pub info *Info;
  pub result R;
  pub f &fn(a A) R;
  pub arg A;
}

// Let go of a packet, whatever its argument's type, since 'refs' is its first
// field: whether this was the last hold on it
fn packetRelease(pkt *u8) Bool {
  (pkt as &Atomic[u32]).subOrdered(1u32, MemOrder.AcqRel[]) == 1u32;
}

// Where a new thread begins: move the argument out, call f with it, store
// what f returns. If the handle was detached, nobody will read the result,
// and the thread finalizes it and frees the block.
fn entry[A, R](p *u8) u32 {
  imm pk = p as *Packet[A, R];
  enter((*pk).info);
  imm f = (*pk).f;
  imm r = f(mem.readRaw[A](&(*pk).arg as *A));
  mem.writeRaw[R](&(*pk).result as *R, r);
  leave();
  if (*pk).refs.subOrdered(1u32, MemOrder.AcqRel[]) == 1u32 {
    mem.finalize[R](&(*pk).result as *R);
    libc.free(p);
  }
  0u32;
}

// The thread takes up its identity, and gives up its hold on it at the end
fn enter(info *Info) {
  me = info as usize;
  (*info).id.storeOrdered(GetCurrentThreadId(), MemOrder.Relaxed[]);
}

fn leave() {
  imm info = me as *Info;
  me = 0usize;
  infoRelease(info);
}

// Start the OS thread: its handle, or 0. The id is stored before the handle
// is returned, so the handle's 'id()' is right from the first; the thread
// stores the same id itself, for its own 'current()'.
fn launch(entry Entry, pkt *u8, info *Info, stackSize usize) usize {
  imm stack = if stackSize > 0xFFFFFFFFusize {0xFFFFFFFFu32;} else {u32[stackSize];};
  mut id = 0u32;
  imm handle = _beginthreadex(0usize as *u8, stack, entry, pkt, stackIsReservation, &mut id as *u32);
  (*info).id.storeOrdered(id, MemOrder.Relaxed[]);
  handle;
}

// How to start a thread, for 'startWith': its name, and the bytes to reserve
// for its stack, 0 for the executable's default
pub struct Options {
  pub name &[]u8 = "";
  pub stackSize usize = 0usize;
}

// A new thread running f(arg), with no name and the default stack. 'arg' is
// moved in.
pub fn start[A Sendable, R Sendable](arg A, f &fn(a A) R) Thread[R] {
  startWith[A, R](Options[], arg, f);
}

// A new thread running f(arg), named and with the stack 'opts' says
pub fn startWith[A Sendable, R Sendable](opts Options, arg A, f &fn(a A) R) Thread[R] {
  imm pk = libc.malloc(mem.sizeof[Packet[A, R]]()) as *Packet[A, R];
  if pk as usize == 0usize {
    die("thread: out of memory");
  }
  imm info = infoNew(opts.name, 2u32, 0u32);
  (*pk).refs = Atomic[u32].of(2u32);
  (*pk).info = info;
  (*pk).f = f;
  mem.writeRaw[A](&(*pk).arg as *A, arg);
  imm handle = launch(&entry[A, R], pk as *u8, info, opts.stackSize);
  if handle == 0usize {
    die("thread: the thread could not be started");
  }
  Thread[R].made(pk as *u8, &(*pk).result as *R, info, handle);
}

// ---------------------------------------------------------------------------
// The handle
// ---------------------------------------------------------------------------

// A started thread's one owner. 'handle' is the OS's handle to it, and 0 once
// the handle has been joined or detached, which its finalizer checks.
pub struct Thread[R] {
  pkt *u8;
  result *R;
  info *Info;
  handle usize;

  fn made(pkt *u8, result *R, info *Info, handle usize) Thread[R] {
    Thread[R][pkt, result, info, handle];
  }

  // Wait for the thread to finish, and answer what its function returned
  pub fn join(mut self) R {
    WaitForSingleObject(handle, infinite);
    CloseHandle(handle);
    handle = 0usize;
    // The thread has ended, so the block is this handle's alone
    imm r = mem.readRaw[R](result);
    libc.free(pkt);
    infoRelease(info);
    r;
  }

  // Let the thread run on alone; it finalizes its own result
  pub fn detach(mut self) {
    CloseHandle(handle);
    handle = 0usize;
    if packetRelease(pkt) {
      // It had already finished
      mem.finalize[R](result);
      libc.free(pkt);
    }
    infoRelease(info);
  }

  // The thread's OS id, its name, and making its parking token available
  pub fn id(self &) u32 { infoId(info); }
  pub fn name(self &) &[]u8 { infoName(info); }
  pub fn unpark(self &) { unparkInfo(info); }

  // A ThreadRef to the thread, to hand to others
  pub fn threadRef(self &) ThreadRef {
    infoHold(info);
    ThreadRef.of(info);
  }

  // Dying unjoined joins, and finalizes the result nobody took
  fn final(self &uni) {
    if handle != 0usize {
      WaitForSingleObject(handle, infinite);
      CloseHandle(handle);
      mem.finalize[R](result);
      libc.free(pkt);
      infoRelease(info);
    }
  }
}

// ---------------------------------------------------------------------------
// ThreadRef: a thread's identity, which may be sent to other threads
// ---------------------------------------------------------------------------

pub struct ThreadRef is Sendable {
  info *Info;

  fn of(info *Info) ThreadRef { ThreadRef[info]; }

  // The thread's OS id, its name, and making its parking token available
  pub fn id(self &) u32 { infoId(info); }
  pub fn name(self &) &[]u8 { infoName(info); }
  pub fn unpark(self &) { unparkInfo(info); }

  // Another ThreadRef to the same thread
  pub fn copy(self &) ThreadRef {
    infoHold(info);
    ThreadRef[info];
  }

  fn final(self &uni) { infoRelease(info); }
}

// The thread calling it
pub fn current() ThreadRef {
  imm info = mine();
  infoHold(info);
  ThreadRef.of(info);
}

// ---------------------------------------------------------------------------
// The running thread
// ---------------------------------------------------------------------------

// How many logical processors the machine has, at least 1
pub fn parallelism() u32 {
  imm n = GetActiveProcessorCount(allProcessorGroups);
  if n == 0u32 {1u32;} else {n;};
}

// Let another thread ready to run on this processor have it
pub fn yieldNow() {
  SwitchToThread();
}

// Sleep at least ns nanoseconds, on the high resolution timer where there is one
pub fn sleep(ns u64) {
  if ns == 0u64 {
    Sleep(0u32);
    return;
  }
  imm timer = CreateWaitableTimerExW(0usize as *u8, 0usize as *u16, timerHighResolution, timerAllAccess);
  if timer != 0usize {
    // Relative (negative), in 100 ns units, rounded up
    mut due = 0i64 - i64[(ns + 99u64) / 100u64];
    if SetWaitableTimer(timer, &mut due as *i64, 0i32, 0usize as *u8, 0usize as *u8, 0i32) != 0i32 {
      WaitForSingleObject(timer, infinite);
      CloseHandle(timer);
      return;
    }
    CloseHandle(timer);
  }
  Sleep(msCeil(ns));
}

// Nanoseconds as whole milliseconds, rounded up, and short of INFINITE
fn msCeil(ns u64) u32 {
  imm ms = ns / 1000000u64 + (if ns % 1000000u64 != 0u64 {1u64;} else {0u64;});
  if ms >= u64[infinite] {infinite - 1u32;} else {u32[ms];};
}

// Take this thread's parking token, sleeping until there is one
pub fn park() {
  imm info = mine();
  // A token becomes none, and this returns; none becomes parked, and it sleeps
  if (*info).park.subOrdered(1u32, MemOrder.Acquire[]) == parkNotified {
    return;
  }
  mut old = 0u32;
  mut taken = false;
  while !taken {
    sync.futexWait(parkWord(info), parkParked);
    old, taken = (*info).park.compareSwapOrdered(parkNotified, parkEmpty,
      MemOrder.Acquire[], MemOrder.Acquire[]);
  }
}
