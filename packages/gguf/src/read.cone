// ======== Reading a GGUF file's header, metadata and tensor table ========
//
// The reader walks a byte slice with a cursor that remembers its first
// failure: after a read goes wrong every later read answers zero and does
// nothing, so a parse is written as straight-line code and asks once, at each
// place a count could make a loop long, whether it has failed. A count read
// from the file is checked against the bytes left before it is used for a
// loop or a reservation, so a hostile count costs nothing.

// The deepest nesting of arrays inside arrays that is followed
fn maxDepth() u32 { 8u32; }

// The most dimensions a tensor has (ggml's own limit)
fn maxDims() u32 { 4u32; }

// The largest alignment accepted
fn maxAlignment() u64 { 0x80000000u64; }

struct Cursor {
  pos usize;
  failed bool;
  err GgufError;

  fn make() Cursor {
    new Cursor(0usize, false, GgufError.make(ErrorKind.Truncated, 0u64, ""));
  }

  fn fail(self &mut, kind ErrorKind, at usize, reason &str) {
    if failed { return; }
    failed = true;
    err = GgufError.make(kind, u64.from(at), reason);
  }

  // True when n more bytes are there; otherwise the cursor has failed
  fn need(self &mut, d &Array[u8], n u64, what &str) bool {
    if failed { return false; }
    imm left = u64.from(d.len - pos);
    if n > left {
      self.fail(ErrorKind.Truncated, pos, what);
      return false;
    }
    true;
  }

  fn rd8(self &mut, d &Array[u8], what &str) u8 {
    if not self.need(d, 1u64, what) { return 0u8; }
    imm v = d[pos];
    pos = pos + 1usize;
    v;
  }

  fn rd16(self &mut, d &Array[u8], what &str) u16 {
    if not self.need(d, 2u64, what) { return 0u16; }
    imm v = u16.from(d[pos]) | (u16.from(d[pos + 1usize]) << 8u16);
    pos = pos + 2usize;
    v;
  }

  fn rd32(self &mut, d &Array[u8], what &str) u32 {
    if not self.need(d, 4u64, what) { return 0u32; }
    imm v = u32.from(d[pos]) | (u32.from(d[pos + 1usize]) << 8u32)
          | (u32.from(d[pos + 2usize]) << 16u32) | (u32.from(d[pos + 3usize]) << 24u32);
    pos = pos + 4usize;
    v;
  }

  fn rd64(self &mut, d &Array[u8], what &str) u64 {
    if not self.need(d, 8u64, what) { return 0u64; }
    mut v = 0u64;
    mut i = 7usize;
    while true {
      v = (v << 8u64) | u64.from(d[pos + i]);
      if i == 0usize { break; }
      i = i - 1usize;
    }
    pos = pos + 8usize;
    v;
  }

  // A string: a u64 length, then that many bytes (no terminator)
  fn rdString(self &mut, d &Array[u8], what &str) String {
    imm n = self.rd64(d, what);
    if failed { return String.empty(); }
    if not self.need(d, n, what) { return String.empty(); }
    imm len = usize.from(n);
    imm s = String.fromBytes(&d[pos..<pos + len]);
    pos = pos + len;
    s;
  }
}

// The fewest bytes one element of an array of this type takes in the file, to
// check a count against the bytes left
fn minElementBytes(t &ValueType) u64 {
  match t {
    case is U8 { 1u64; }
    case is I8 { 1u64; }
    case is Bool { 1u64; }
    case is U16 { 2u64; }
    case is I16 { 2u64; }
    case is U32 { 4u64; }
    case is I32 { 4u64; }
    case is F32 { 4u64; }
    case is U64 { 8u64; }
    case is I64 { 8u64; }
    case is F64 { 8u64; }
    case is Str { 8u64; }
    case is Items { 12u64; }
  }
}

// Reads one value of the type the file named. After a failure the value
// answered is a placeholder, which the caller drops.
fn readValue(c &mut Cursor, d &Array[u8], t &ValueType, depth u32) Value {
  match t {
    case is U8 { return Value.U8(c.rd8(d, "the file ends inside a value")); }
    case is I8 { return Value.I8(i8.from(c.rd8(d, "the file ends inside a value"))); }
    case is U16 { return Value.U16(c.rd16(d, "the file ends inside a value")); }
    case is I16 { return Value.I16(i16.from(c.rd16(d, "the file ends inside a value"))); }
    case is U32 { return Value.U32(c.rd32(d, "the file ends inside a value")); }
    case is I32 { return Value.I32(i32.from(c.rd32(d, "the file ends inside a value"))); }
    case is F32 { return Value.F32(c.rd32(d, "the file ends inside a value") as f32); }
    case is Bool { return Value.Bool(c.rd8(d, "the file ends inside a value") != 0u8); }
    case is U64 { return Value.U64(c.rd64(d, "the file ends inside a value")); }
    case is I64 { return Value.I64(i64.from(c.rd64(d, "the file ends inside a value"))); }
    case is F64 { return Value.F64(c.rd64(d, "the file ends inside a value") as f64); }
    case is Str { return Value.Str(c.rdString(d, "the file ends inside a string")); }
    case is Items {
      imm at = c.pos;
      if depth >= maxDepth() {
        c.fail(ErrorKind.TooDeep, at, "arrays are nested deeper than 8 levels");
        return Value.U8(0u8);
      }
      imm code = c.rd32(d, "the file ends inside an array header");
      imm n = c.rd64(d, "the file ends inside an array header");
      if c.failed { return Value.U8(0u8); }
      match ValueType.fromCode(code) {
        case imm et Some {
          // Each element takes at least minElementBytes, so a count the bytes
          // left cannot hold is truncation, found before anything is reserved
          imm left = u64.from(d.len - c.pos);
          if n > left / minElementBytes(&et) {
            c.fail(ErrorKind.Truncated, at, "an array holds more elements than the file has bytes for");
            return Value.U8(0u8);
          }
          mut items = List[Value].withCapacity(usize.from(n));
          mut i = 0u64;
          while i < n and not c.failed {
            items.push(readValue(c, d, &et, depth + 1u32));
            i = i + 1u64;
          }
          return Value.Items(et.copy(), items);
        }
        case is None {
          c.fail(ErrorKind.BadValueType, at, "an array's element type is not a metadata type");
          return Value.U8(0u8);
        }
      }
    }
  }
}

// What a tensor's type and dimensions make: its element count and its bytes,
// or a fault (0 none; 1 no dimensions or more than 4; 2 a dimension of zero;
// 3 more elements than a 64-bit count holds; 4 a first dimension that is not
// a whole number of blocks; 5 more bytes than a 64-bit count holds)
struct Geometry {
  elements u64;
  bytes u64;
  fault u32;
}

fn faultText(fault u32) &str {
  if fault == 1u32 { return "a tensor has no dimensions or more than 4"; }
  if fault == 2u32 { return "a tensor has a dimension of zero"; }
  if fault == 3u32 { return "a tensor has more elements than a 64-bit count holds"; }
  if fault == 4u32 { return "a tensor's first dimension is not a whole number of blocks"; }
  "a tensor is more bytes than a 64-bit count holds";
}

fn geometry(kind &TensorType, dims &Array[u64]) Geometry {
  if dims.len == 0usize or dims.len > usize.from(maxDims()) { return new Geometry(0u64, 0u64, 1u32); }
  mut elements = 1u64;
  mut i = 0usize;
  while i < dims.len {
    if dims[i] == 0u64 { return new Geometry(0u64, 0u64, 2u32); }
    if elements > 0xFFFFFFFFFFFFFFFFu64 / dims[i] { return new Geometry(0u64, 0u64, 3u32); }
    elements = elements * dims[i];
    i = i + 1usize;
  }
  imm bs = u64.from(kind.blockSize());
  if dims[0usize] % bs != 0u64 { return new Geometry(0u64, 0u64, 4u32); }
  imm blocks = elements / bs;
  imm bb = u64.from(kind.blockBytes());
  if blocks > 0xFFFFFFFFFFFFFFFFu64 / bb { return new Geometry(0u64, 0u64, 5u32); }
  new Geometry(elements, blocks * bb, 0u32);
}

// Rounds n up to a multiple of a, a power of two
fn alignUp(n u64, a u64) u64 { (n + a - 1u64) & ~(a - 1u64); }

fn failed(c &mut Cursor) Result[Model, GgufError] {
  mut e = GgufError.make(ErrorKind.Truncated, 0u64, "");
  e <=> c.err;
  Error[Model, GgufError](e);
}

fn problem(kind ErrorKind, at u64, reason &str) Result[Model, GgufError] {
  Error[Model, GgufError](GgufError.make(kind, at, reason));
}

// Reads the header, the metadata and the tensor table of a GGUF file, given as
// its bytes. Nothing of the tensors' data is copied: 'Model.tensorBytes' finds it
// again in the same bytes. Every tensor is checked to lie inside the file, at
// an offset that keeps the file's alignment.
pub fn parse(file &Array[u8]) Result[Model, GgufError] {
  mut c = Cursor.make();

  // Magic and version
  if file.len < 4usize {
    return problem(ErrorKind.Truncated, 0u64, "the file is shorter than the 4-byte magic");
  }
  if file[0usize] != 'G' or file[1usize] != 'G' or file[2usize] != 'U' or file[3usize] != 'F' {
    return problem(ErrorKind.BadMagic, 0u64, "the file does not start with GGUF");
  }
  c.pos = 4usize;
  imm version = c.rd32(file, "the file ends inside the header");
  if c.failed { return failed(&mut c); }
  if version == 0x03000000u32 or version == 0x02000000u32 {
    return problem(ErrorKind.BigEndian, 4u64, "this is a big-endian GGUF file, which is not read");
  }
  if version != 2u32 and version != 3u32 {
    return problem(ErrorKind.UnsupportedVersion, 4u64, "the version is not 2 or 3");
  }
  imm tensorCount = c.rd64(file, "the file ends inside the header");
  imm metaCount = c.rd64(file, "the file ends inside the header");
  if c.failed { return failed(&mut c); }
  // A key (8 + 0 bytes), a type (4) and a value (1 or more) take 13 bytes at least;
  // a tensor entry (name 8, dimension count 4, one dimension 8, type 4, offset 8) 32
  imm left = u64.from(file.len - c.pos);
  if metaCount > left / 13u64 {
    return problem(ErrorKind.Truncated, 16u64, "the metadata count is more than the file has bytes for");
  }
  if tensorCount > left / 32u64 {
    return problem(ErrorKind.Truncated, 8u64, "the tensor count is more than the file has bytes for");
  }

  // Metadata
  mut meta = List[MetaEntry].withCapacity(usize.from(metaCount));
  mut i = 0u64;
  while i < metaCount and not c.failed {
    imm keyAt = c.pos;
    imm key = c.rdString(file, "the file ends inside a metadata key");
    imm code = c.rd32(file, "the file ends inside a metadata entry");
    if c.failed { break; }
    match ValueType.fromCode(code) {
      case imm t Some {
        mut v = readValue(&mut c, file, &t, 0u32);
        if c.failed { break; }
        each e in meta {
          if e.key.view() == key.view() {
            return problem(ErrorKind.DuplicateKey, u64.from(keyAt), "a metadata key is written twice");
          }
        }
        meta.push(new MetaEntry(key, v));
      }
      case is None {
        c.fail(ErrorKind.BadValueType, c.pos - 4usize, "a metadata value has a type that does not exist");
      }
    }
    i = i + 1u64;
  }
  if c.failed { return failed(&mut c); }

  // The alignment
  mut alignment = 32u64;
  each e in meta {
    if e.key.view() == "general.alignment" {
      match e.value.asU64() {
        case imm a Some { alignment = a; }
        case is None {
          return problem(ErrorKind.BadAlignment, 0u64, "general.alignment is not an unsigned integer");
        }
      }
    }
  }
  if alignment == 0u64 or (alignment & (alignment - 1u64)) != 0u64 or alignment > maxAlignment() {
    return problem(ErrorKind.BadAlignment, 0u64, "general.alignment is not a power of two up to 2^31");
  }

  // The tensor table: name, dimensions, type, offset
  mut tensors = List[Tensor].withCapacity(usize.from(tensorCount));
  i = 0u64;
  while i < tensorCount and not c.failed {
    imm entryAt = c.pos;
    imm name = c.rdString(file, "the file ends inside a tensor name");
    imm ndims = c.rd32(file, "the file ends inside a tensor entry");
    if c.failed { break; }
    if ndims == 0u32 or ndims > maxDims() {
      return problem(ErrorKind.BadDimensions, u64.from(entryAt), faultText(1u32));
    }
    mut dims = List[u64].withCapacity(usize.from(ndims));
    mut k = 0u32;
    while k < ndims {
      dims.push(c.rd64(file, "the file ends inside a tensor entry"));
      k = k + 1u32;
    }
    imm code = c.rd32(file, "the file ends inside a tensor entry");
    imm offset = c.rd64(file, "the file ends inside a tensor entry");
    if c.failed { break; }
    match TensorType.fromCode(code) {
      case imm kind Some {
        imm geo = geometry(&kind, dims.view());
        if geo.fault != 0u32 {
          return problem(ErrorKind.BadDimensions, u64.from(entryAt), faultText(geo.fault));
        }
        each prev in tensors {
          if prev.name.view() == name.view() {
            return problem(ErrorKind.DuplicateTensor, u64.from(entryAt), "a tensor name is written twice");
          }
        }
        tensors.push(new Tensor(name, kind.copy(), dims, offset, geo.elements, geo.bytes));
      }
      case is None {
        return problem(ErrorKind.BadTensorType, u64.from(c.pos - 12usize), "a tensor has a type this package does not read");
      }
    }
    i = i + 1u64;
  }
  if c.failed { return failed(&mut c); }

  // The data: after the table, at the next multiple of the alignment
  mut dataStart = alignUp(u64.from(c.pos), alignment);
  imm fileLen = u64.from(file.len);
  if dataStart > fileLen {
    if tensors.len() > 0usize {
      return problem(ErrorKind.Truncated, fileLen, "the file ends before the tensor data begins");
    }
    dataStart = fileLen;
  }
  imm dataLen = fileLen - dataStart;
  each t in tensors {
    if t.offset % alignment != 0u64 {
      return problem(ErrorKind.BadAlignment, dataStart, "a tensor's offset is not a multiple of the alignment");
    }
    if t.offset > dataLen or t.bytes > dataLen - t.offset {
      return problem(ErrorKind.BadOffset, dataStart + t.offset, "a tensor reaches past the end of the file");
    }
  }
  Ok[Model, GgufError](new Model(version, alignment, dataStart, meta, tensors));
}
