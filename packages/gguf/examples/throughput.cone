// How fast each type dequantises: 16 Mi elements of each read to f32, the speed
// printed in millions of elements a second. Run it in a release build, for a
// debug build is many times slower:
//
//   congo run --release examples/throughput.cone

mod throughput;

import stdio use *;
import collections use *;
import time use *;
import gguf;

fn report(name &str, start Instant, elements u64) {
  let secs = start.elapsed().secondsF64();
  printStr(name);
  printStr(" ");
  printInt(i64.from(f64.from(elements) / secs / 1000000.0d));
  printStr(" Melements/s\n");
}

fn main() i32 {
  let count = 16777216usize;
  var x = List[f32].withCapacity(65536usize);
  var i = 0usize;
  while i < 65536usize { x.push(f32.from(i32.from(i % 1000usize) - 500i32) / 500.0); i = i + 1usize; }
  let kinds = [gguf.TensorType.F32, gguf.TensorType.F16, gguf.TensorType.BF16, gguf.TensorType.Q4_0, gguf.TensorType.Q8_0, gguf.TensorType.Q4_K, gguf.TensorType.Q6_K];
  var k = 0usize;
  while k < 7usize {
    // 64 Ki elements quantised once, read 256 times
    var bytes = List[u8].empty();
    match gguf.quantize(&kinds[k], x.view(), &mut bytes) {
      case is Ok {}
      case is Error { printStr("quantize failed\n"); return 1i32; }
    }
    var out = List[f32].empty();
    let t = Instant.now();
    var r = 0usize;
    while r < count / 65536usize {
      out.clear();
      match gguf.dequantize(&kinds[k], bytes.view(), 65536usize, &mut out) {
        case is Ok {}
        case is Error { printStr("dequantize failed\n"); return 1i32; }
      }
      r = r + 1usize;
    }
    report(kinds[k].name(), t, u64.from(count));
    k = k + 1usize;
  }
  0i32;
}
