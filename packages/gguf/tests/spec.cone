// A GGUF file laid out by hand from the format (not by the package's Writer):
// magic, version, counts, metadata of several types including an array of
// strings (a tokenizer's vocabulary) and an f32, a tensor table of a Q8_0 and
// an F32 tensor, padding to 32, and the data. The reader must find every
// field where the format puts it. The same bytes with version 2 read the
// same, and with 'general.alignment' 64 the data moves.

mod spec;

import testing use *;
import collections use *;
import gguf use *;

fn orS(o: Option[&str], d: &str) &str { match o { case let Some(v) { return v; } case is None { return d; } } }
fn orU(o: Option[u64], d: u64) u64 { match o { case let Some(v) { return v; } case is None { return d; } } }
fn orF(o: Option[f64], d: f64) f64 { match o { case let Some(v) { return v; } case is None { return d; } } }

struct Bld {
  out: List[u8];

  fn w8(self: &mut, v: u32) { out.push(u8.from(v & 255u32)); }
  fn w32(self: &mut, v: u32) {
    out.push(u8.from(v & 255u32));
    out.push(u8.from((v >> 8u32) & 255u32));
    out.push(u8.from((v >> 16u32) & 255u32));
    out.push(u8.from((v >> 24u32) & 255u32));
  }
  fn w64(self: &mut, v: u64) {
    self.w32(u32.from(v & 0xFFFFFFFFu64));
    self.w32(u32.from(v >> 32u64));
  }
  fn wstr(self: &mut, s: &str) {
    self.w64(u64.from(s.len()));
    var i = 0usize;
    while i < s.len() { out.push(s[i]); i = i + 1usize; }
  }
  fn magic(self: &mut) {
    self.w8(71u32); self.w8(71u32); self.w8(85u32); self.w8(70u32);
  }
  fn padTo(self: &mut, a: usize) {
    while out.len() % a != 0usize { out.push(0u8); }
  }
}

fn hand(version: u32, alignmentKv: u32) List[u8] {
  var b = Bld(List[u8].empty());
  b.magic();
  b.w32(version);
  b.w64(2u64);                                  // tensors
  b.w64(if alignmentKv > 0u32 { 5u64 } else { 4u64 });   // metadata entries
  b.wstr("general.architecture");  b.w32(8u32);  b.wstr("llama");
  b.wstr("llama.block_count");     b.w32(4u32);  b.w32(32u32);
  b.wstr("tokenizer.ggml.tokens"); b.w32(9u32);  b.w32(8u32);  b.w64(3u64);
  b.wstr("<unk>"); b.wstr("a"); b.wstr("ab");
  b.wstr("llama.rope.freq_base");  b.w32(6u32);  b.w32(0x461C4000u32);   // 10000.0
  if alignmentKv > 0u32 {
    b.wstr("general.alignment");   b.w32(4u32);  b.w32(alignmentKv);
  }
  // tensors: w, 32 x Q8_0 (34 bytes) at 0; v, 2 x 2 F32 (16 bytes) at the next 32 or 64
  let a = if alignmentKv > 0u32 { usize.from(alignmentKv) } else { 32usize };
  b.wstr("w");  b.w32(1u32);  b.w64(32u64);       b.w32(8u32);  b.w64(0u64);
  b.wstr("v");  b.w32(2u32);  b.w64(2u64);  b.w64(2u64);  b.w32(0u32);
  b.w64(u64.from((34usize + a - 1usize) / a * a));
  b.padTo(a);
  // w: d = 0.5 (0x3800), qs[j] = j - 16
  b.w8(0x00u32); b.w8(0x38u32);
  var j = 0u32;
  while j < 32u32 { b.w8(j + 240u32); j = j + 1u32; }       // (j - 16) & 255 = j + 240
  b.padTo(a);
  // v: 1.0 2.0 3.0 4.0
  b.w32(0x3f800000u32); b.w32(0x40000000u32); b.w32(0x40400000u32); b.w32(0x40800000u32);
  var result = List[u8].empty();
  result <-> b.out;
  result
}

fn check(bytes: &List[u8], version: u32, alignment: u64, label: &str) {
  match parse(bytes.view()) {
    case let Ok(m) {
      expectUInt(u64.from(m.version), u64.from(version), label);
      expectUInt(m.alignment, alignment, label);
      expectUInt(u64.from(m.meta.len()), if alignment == 32u64 { 4u64 } else { 5u64 }, label);
      expectUInt(u64.from(m.tensors.len()), 2u64, label);
      expectStr(orS(m.text("general.architecture"), ""), "llama", label);
      expectUInt(orU(m.uint("llama.block_count"), 0u64), 32u64, label);
      expectFloat(orF(m.float("llama.rope.freq_base"), 0.0), 10000.0, 0.0, label);
      match m.list("tokenizer.ggml.tokens") {
        case let Some(l) {
          expectUInt(u64.from(l.len()), 3u64, label);
          expectStr(orS(l.text(0usize), ""), "<unk>", label);
          expectStr(orS(l.text(2usize), ""), "ab", label);
          expect(l.elem == ValueType.Str, label);
        }
        case is None { expect(false, label); }
      }
      // the data begins at the next multiple of the alignment after the table
      expectUInt(m.dataStart % alignment, 0u64, label);
      expectUInt(u64.from(bytes.len()), m.dataStart + m.tensors[1usize].offset + 16u64, label);
      expectUInt(m.tensors[0usize].offset, 0u64, label);
      expectUInt(m.tensors[1usize].offset, (34u64 + alignment - 1u64) / alignment * alignment, label);
      expectStr(m.tensors[0usize].name.view(), "w", label);
      expect(m.tensors[0usize].kind == TensorType.Q8_0, label);
      expectUInt(m.tensors[0usize].elements, 32u64, label);
      expectUInt(m.tensors[0usize].bytes, 34u64, label);
      expectStr(m.tensors[1usize].name.view(), "v", label);
      expect(m.tensors[1usize].kind == TensorType.F32, label);
      expectUInt(m.tensors[1usize].rowLength(), 2u64, label);
      expectUInt(m.tensors[1usize].rowCount(), 2u64, label);
      // w dequantises: -8 .. 7.5; v is 1 2 3 4
      match tensorToF32(&m, bytes.view(), m.tensors[0usize]) {
        case let Ok(w) {
          expectFloat(f64.from(*w[0usize]), -8.0, 0.0, label);
          expectFloat(f64.from(*w[31usize]), 7.5, 0.0, label);
        }
        case is Err { expect(false, label); }
      }
      match tensorToF32(&m, bytes.view(), m.tensors[1usize]) {
        case let Ok(v) {
          expectFloat(f64.from(*v[0usize]) + f64.from(*v[1usize]) * 10.0 + f64.from(*v[2usize]) * 100.0 + f64.from(*v[3usize]) * 1000.0, 4321.0, 0.0, label);
        }
        case is Err { expect(false, label); }
      }
    }
    case let Err(e) {
      let msg = e.message();
      expectStr(msg.view(), "<parsed>", label);
    }
  }
}

fn main() i32 {
  let v3 = hand(3u32, 0u32);
  check(&v3, 3u32, 32u64, "version 3");
  let v2 = hand(2u32, 0u32);
  check(&v2, 2u32, 32u64, "version 2");
  let a64 = hand(3u32, 64u32);
  check(&a64, 3u32, 64u64, "alignment 64");
  let a8 = hand(3u32, 8u32);
  check(&a8, 3u32, 8u64, "alignment 8");
  done()
}
