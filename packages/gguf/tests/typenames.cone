// The text of a tensor type, every variant: ggml's spelling, with the underscore.
// Pinned so the text cannot drift when the way it is asked for changes.

mod typenames;

import testing use *;
import collections use String;
import gguf use *;

fn check(k: TensorType, want: &str, label: &str) {
  expectStr((String() <- toText(&k)).view(), want, label);
}

fn main() i32 {
  check(TensorType.F32, "F32", "F32");
  check(TensorType.F16, "F16", "F16");
  check(TensorType.Q4_0, "Q4_0", "Q4_0");
  check(TensorType.Q8_0, "Q8_0", "Q8_0");
  check(TensorType.Q4_K, "Q4_K", "Q4_K");
  check(TensorType.Q6_K, "Q6_K", "Q6_K");
  check(TensorType.BF16, "BF16", "BF16");
  done()
}
