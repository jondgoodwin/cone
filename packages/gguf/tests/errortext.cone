// The one line each error of this package gives a person is pinned here, with
// the number fields at their widest, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import gguf use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- GgufError.make(ErrorKind.BadMagic, 0u64, "not a GGUF file"), "gguf: not a GGUF file", "no offset");
  says(String() <- GgufError.make(ErrorKind.BadMagic, 24u64, "the file ends inside a string"), "gguf: at offset 24: the file ends inside a string", "offset");
  says(String() <- GgufError.make(ErrorKind.BadMagic, 18446744073709551615u64, "x"), "gguf: at offset 18446744073709551615: x", "widest offset");
  done()
}
