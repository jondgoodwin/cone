// Models written by the package's Writer and read back: metadata of every
// type (scalars, strings, arrays of each type, an empty array, arrays of
// arrays), tensors of every supported type and in one to four dimensions, the
// table's fields, where the data begins and where each tensor sits (aligned),
// the typed accessors, and the same for each of several alignments.

mod roundtrip;

import testing use *;
import collections use *;
import gguf use *;

// An Option's value, or the fallback (the language's '||' on an Option is not built yet)
fn orS(o: Option[&str], d: &str) &str { match o { case let v Some { return v; } case is None { return d; } } }
fn orU(o: Option[u64], d: u64) u64 { match o { case let v Some { return v; } case is None { return d; } } }
fn orI(o: Option[i64], d: i64) i64 { match o { case let v Some { return v; } case is None { return d; } } }
fn orF(o: Option[f64], d: f64) f64 { match o { case let v Some { return v; } case is None { return d; } } }
fn orB(o: Option[bool], d: bool) bool { match o { case let v Some { return v; } case is None { return d; } } }
fn orZ(o: Option[usize], d: usize) usize { match o { case let v Some { return v; } case is None { return d; } } }

fn same(model: &Model, key: &str, want: Value) {
  match model.get(key) {
    case let v Some { expect(v.same(&want), key); }
    case is None { expect(false, key); }
  }
}

// A sequence of pseudo-random floats in [-1, 1)
fn floats(n: usize, seed: u32) List[f32] {
  var x = seed;
  var out = List[f32].withCapacity(n);
  var i = 0usize;
  while i < n {
    x = x * 1664525u32 + 1013904223u32;
    out.push(f32.from(i32.from((x >> 8u32) & 0xFFFFu32) - 32768i32) / 32768.0);
    i = i + 1usize;
  }
  out
}

fn sameBytes(a: &Array[u8], b: &Array[u8]) bool {
  if a.len != b.len { return false; }
  var i = 0usize;
  while i < a.len {
    if a[i] != b[i] { return false; }
    i = i + 1usize;
  }
  true
}

fn arrU32(items: &Array[u32]) Value {
  var l = List[Value].empty();
  var i = 0usize;
  while i < items.len { l.push(Value.U32(items[i])); i = i + 1usize; }
  Value.Items(ValueType.U32, l)
}

fn strs(a: &str, b: &str, c: &str) Value {
  var l = List[Value].empty();
  l.push(Value.fromText(a)); l.push(Value.fromText(b)); l.push(Value.fromText(c));
  Value.Items(ValueType.Str, l)
}

fn emptyU32() Value { Value.Items(ValueType.U32, List[Value].empty()) }

fn written(w: &Writer) List[u8] {
  match w.finish() {
    case var ok Ok { var b = List[u8].empty(); b <=> ok; return b; }
    case let e Error {
      let m = e.message();
      expectStr(m.view(), "<written>", "finish");
      return List[u8].empty();
    }
  }
}

// One tensor to add: made from n floats, stored as this type
fn add(w: &mut Writer, name: &str, kind: TensorType, dims: &Array[u64], seed: u32) {
  var n = 1usize;
  var i = 0usize;
  while i < dims.len { n = n * usize.from(dims[i]); i = i + 1usize; }
  let values = floats(n, seed);
  match w.addValues(name, kind, dims, values.view()) {
    case is Ok {}
    case let e Error {
      let m = e.message();
      expectStr(m.view(), "<added>", name);
    }
  }
}

fn metadataFile() List[u8] {
  var w = Writer.make();
  w.putText("general.architecture", "llama");
  w.putText("general.name", "tiny model é✓");
  w.putText("empty", "");
  w.put("t.u8", Value.U8(200u8));
  w.put("t.i8", Value.I8(-5i8));
  w.put("t.u16", Value.U16(65000u16));
  w.put("t.i16", Value.I16(-30000i16));
  w.put("t.u32", Value.U32(4000000000u32));
  w.put("t.i32", Value.I32(-2000000000i32));
  w.put("t.f32", Value.F32(0.15625));
  w.put("t.true", Value.Bool(true));
  w.put("t.false", Value.Bool(false));
  w.put("t.u64", Value.U64(0xFFFFFFFFFFFFFFFFu64));
  w.put("t.i64", Value.I64(-9223372036854775807i64 - 1i64));
  w.put("t.f64", Value.F64(-1.0e300));
  w.put("a.u8", Value.Items(ValueType.U8, List[Value].empty()));
  w.put("a.u32", arrU32(&[1u32, 2u32, 4000000000u32]));
  var fl = List[Value].empty();
  fl.push(Value.F32(1.5)); fl.push(Value.F32(-2.5));
  w.put("a.f32", Value.Items(ValueType.F32, fl));
  var bl = List[Value].empty();
  bl.push(Value.Bool(true)); bl.push(Value.Bool(false)); bl.push(Value.Bool(true));
  w.put("a.bool", Value.Items(ValueType.Bool, bl));
  var dl = List[Value].empty();
  dl.push(Value.F64(0.1));
  w.put("a.f64", Value.Items(ValueType.F64, dl));
  var il = List[Value].empty();
  il.push(Value.I64(-1i64)); il.push(Value.I64(9223372036854775807i64));
  w.put("a.i64", Value.Items(ValueType.I64, il));
  w.put("a.str", strs("a", "bc", ""));
  // arrays of arrays: [[1, 2], [], [3]]
  var nested = List[Value].empty();
  nested.push(arrU32(&[1u32, 2u32]));
  nested.push(emptyU32());
  nested.push(arrU32(&[3u32]));
  w.put("a.nested", Value.Items(ValueType.Items, nested));
  // put again: the value is replaced, and keeps its place
  w.put("t.u8", Value.U8(201u8));
  match w.finish() {
    case var ok Ok {
      var bytes = List[u8].empty();
      bytes <=> ok;
      return bytes;
    }
    case let e Error {
      let m = e.message();
      expectStr(m.view(), "<written>", "metadata file");
      return List[u8].empty();
    }
  }
}

fn modelOf(bytes: &List[u8]) Model {
  match parse(bytes.view()) {
    case var ok Ok {
      var m = Model.empty();
      m <=> ok;
      return m;
    }
    case let e Error {
      let msg = e.message();
      expectStr(msg.view(), "<parsed>", "parse");
      return Model.empty();
    }
  }
}

fn main() i32 {
  // -------- metadata of every type --------
  let file = metadataFile();
  let model = modelOf(&file);
  expectUInt(u64.from(model.version), 3u64, "version 3");
  expectUInt(model.alignment, 32u64, "default alignment 32");
  expectUInt(u64.from(model.meta.len()), 23u64, "23 metadata entries");
  expectUInt(u64.from(model.tensors.len()), 0u64, "no tensors");
  expectStr(model.meta[0usize].key.view(), "general.architecture", "order kept: first");
  expectStr(model.meta[3usize].key.view(), "t.u8", "order kept: the replaced key stays in place");
  same(&model, "general.architecture", Value.fromText("llama"));
  same(&model, "general.name", Value.fromText("tiny model é✓"));
  same(&model, "empty", Value.fromText(""));
  same(&model, "t.u8", Value.U8(201u8));
  same(&model, "t.i8", Value.I8(-5i8));
  same(&model, "t.u16", Value.U16(65000u16));
  same(&model, "t.i16", Value.I16(-30000i16));
  same(&model, "t.u32", Value.U32(4000000000u32));
  same(&model, "t.i32", Value.I32(-2000000000i32));
  same(&model, "t.f32", Value.F32(0.15625));
  same(&model, "t.true", Value.Bool(true));
  same(&model, "t.false", Value.Bool(false));
  same(&model, "t.u64", Value.U64(0xFFFFFFFFFFFFFFFFu64));
  same(&model, "t.i64", Value.I64(-9223372036854775807i64 - 1i64));
  same(&model, "t.f64", Value.F64(-1.0e300));
  same(&model, "a.u8", Value.Items(ValueType.U8, List[Value].empty()));
  same(&model, "a.u32", arrU32(&[1u32, 2u32, 4000000000u32]));
  same(&model, "a.str", strs("a", "bc", ""));
  var nested = List[Value].empty();
  nested.push(arrU32(&[1u32, 2u32]));
  nested.push(emptyU32());
  nested.push(arrU32(&[3u32]));
  same(&model, "a.nested", Value.Items(ValueType.Items, nested));
  expect(!model.has("missing"), "a missing key");
  // a value is not its look-alike of another type
  match model.get("t.u32") {
    case let v Some { expect(!v.same(&Value.I32(-294967296i32)), "U32 is not I32"); }
    case is None { expect(false, "t.u32"); }
  }

  // -------- the typed accessors --------
  expectStr(orS(model.text("general.architecture"), ""), "llama", "text");
  expect((model.text("t.u32") is None), "text of a number");
  expect(orU(model.uint("t.u8"), 0u64) == 201u64, "uint of a u8");
  expect(orU(model.uint("t.u32"), 0u64) == 4000000000u64, "uint of a u32");
  expect(orU(model.uint("t.u64"), 0u64) == 0xFFFFFFFFFFFFFFFFu64, "uint of a u64");
  expect((model.uint("t.i8") is None), "uint of a negative");
  expect(orI(model.int("t.i8"), 0i64) == -5i64, "int of an i8");
  expect(orI(model.int("t.u32"), 0i64) == 4000000000i64, "int of a u32");
  expect((model.int("t.u64") is None), "int of a u64 past i64");
  expect((model.int("t.f32") is None), "int of a float");
  expectFloat(orF(model.float("t.f32"), 0.0), 0.15625, 0.0, "float of an f32");
  expectFloat(orF(model.float("t.f64"), 0.0), -1.0e300, 0.0, "float of an f64");
  expect((model.float("t.u8") is None), "float of an int");
  expect(orB(model.flag("t.true"), false), "flag true");
  expect(!orB(model.flag("t.false"), true), "flag false");
  match model.list("a.str") {
    case let l Some {
      expectUInt(u64.from(l.len()), 3u64, "list length");
      expectStr(orS(l.text(1usize), "?"), "bc", "list text");
      expect((l.text(3usize) is None), "list text out of range");
      expect((l.int(0usize) is None), "list int of a string");
    }
    case is None { expect(false, "a.str list"); }
  }
  match model.list("a.u32") {
    case let l Some {
      expect(orI(l.int(2usize), 0i64) == 4000000000i64, "list int");
      expect((l.text(2usize) is None), "list text of an int");
    }
    case is None { expect(false, "a.u32 list"); }
  }
  match model.list("a.f32") {
    case let l Some { expectFloat(orF(l.float(1usize), 0.0), -2.5, 0.0, "list float"); }
    case is None { expect(false, "a.f32 list"); }
  }
  expect((model.list("t.u8") is None), "list of a scalar");

  // -------- tensors of every type --------
  var w = Writer.make();
  w.putText("general.architecture", "test");
  add(&mut w, "a.f32", TensorType.F32, &[3u64, 2u64], 1u32);
  add(&mut w, "b.f16", TensorType.F16, &[5u64], 2u32);
  add(&mut w, "c.bf16", TensorType.BF16, &[4u64, 2u64], 3u32);
  add(&mut w, "d.q4_0", TensorType.Q4_0, &[64u64, 3u64], 4u32);
  add(&mut w, "e.q8_0", TensorType.Q8_0, &[32u64, 2u64, 2u64], 5u32);
  add(&mut w, "f.q4_k", TensorType.Q4_K, &[256u64, 2u64], 6u32);
  add(&mut w, "g.q6_k", TensorType.Q6_K, &[512u64], 7u32);
  add(&mut w, "h.f32x4", TensorType.F32, &[2u64, 2u64, 2u64, 2u64], 8u32);
  let tfile = written(&w);
  let tm = modelOf(&tfile);
  expectUInt(u64.from(tm.tensors.len()), 8u64, "8 tensors");
  expectUInt(tm.dataStart % 32u64, 0u64, "data begins on the alignment");
  expectUInt(u64.from(tfile.len()) - tm.dataStart, tm.tensors[7usize].offset + tm.tensors[7usize].bytes, "the file ends with the last tensor");

  // The table: name, type, dims, element count, bytes, order, alignment
  let names = ["a.f32", "b.f16", "c.bf16", "d.q4_0", "e.q8_0", "f.q4_k", "g.q6_k", "h.f32x4"];
  let elems = [6u64, 5u64, 8u64, 192u64, 128u64, 512u64, 512u64, 16u64];
  let sizes = [24u64, 10u64, 16u64, 108u64, 136u64, 288u64, 420u64, 64u64];
  let kinds = ["F32", "F16", "BF16", "Q4_0", "Q8_0", "Q4_K", "Q6_K", "F32"];
  let ndims = [2usize, 1usize, 2usize, 2usize, 3usize, 2usize, 1usize, 4usize];
  var prevEnd = 0u64;
  var t = 0usize;
  while t < 8usize {
    let info = tm.tensors[t];
    expectStr(info.name.view(), names[t], "tensor name");
    expectStr(info.kind.name(), kinds[t], "tensor type name");
    expectUInt(info.elements, elems[t], "tensor elements");
    expectUInt(info.bytes, sizes[t], "tensor bytes");
    expectUInt(u64.from(info.dims.len()), u64.from(ndims[t]), "tensor dimensions");
    expectUInt(info.offset % 32u64, 0u64, "tensor offset aligned");
    expect(info.offset >= prevEnd, "tensors do not overlap");
    prevEnd = info.offset + info.bytes;
    // The bytes are what was added: quantise the same values again
    let values = floats(usize.from(info.elements), 1u32 + u32.from(t));
    var want = List[u8].empty();
    match quantize(&info.kind, values.view(), &mut want) {
      case is Ok {}
      case is Error { expect(false, "quantize"); }
    }
    expect(sameBytes(tm.tensorBytes(tfile.view(), info), want.view()), "tensor bytes read back");
    expectUInt(u64.from(tm.tensorBytes(tfile.view(), info).len), info.bytes, "tensor view length");
    t = t + 1usize;
  }
  expectUInt(tm.tensors[3usize].rowLength(), 64u64, "row length");
  expectUInt(tm.tensors[3usize].rowCount(), 3u64, "row count");
  expectUInt(tm.tensors[3usize].rowBytes(), 36u64, "row bytes: two Q4_0 blocks");
  expectUInt(tm.tensors[4usize].rowCount(), 4u64, "rows of a 3-d tensor: product of the others");

  // find and indexOf
  match tm.find("f.q4_k") {
    case let info Some { expectUInt(info.elements, 512u64, "find"); }
    case is None { expect(false, "find"); }
  }
  expect((tm.find("nope") is None), "find misses");
  expectUInt(u64.from(orZ(tm.indexOf("c.bf16"), 99usize)), 2u64, "indexOf");

  // The plain floats read back whole
  match tensorToF32(&tm, tfile.view(), tm.tensors[0usize]) {
    case let got Ok {
      let want = floats(6usize, 1u32);
      var i = 0usize;
      while i < 6usize {
        expectFloat(f64.from(*got[i]), f64.from(*want[i]), 0.0, "F32 tensor read back exactly");
        i = i + 1usize;
      }
    }
    case is Error { expect(false, "tensorToF32 of an F32 tensor"); }
  }
  match tensorToF32(&tm, tfile.view(), tm.tensors[1usize]) {
    case let got Ok {
      let want = floats(5usize, 2u32);
      var i = 0usize;
      while i < 5usize {
        expectFloat(f64.from(*got[i]), f64.from(halfToF32(f32ToHalf(*want[i]))), 0.0, "F16 tensor read back as the rounded half");
        i = i + 1usize;
      }
    }
    case is Error { expect(false, "tensorToF32 of an F16 tensor"); }
  }
  // A row of the 3-row Q4_0 matrix is the same as that part of the whole
  match tensorToF32(&tm, tfile.view(), tm.tensors[3usize]) {
    case let whole Ok {
      var row = List[f32].empty();
      match rowToF32(&tm, tfile.view(), tm.tensors[3usize], 2u64, &mut row) {
        case is Ok {}
        case is Error { expect(false, "rowToF32"); }
      }
      expectUInt(u64.from(row.len()), 64u64, "a row has 64 elements");
      var i = 0usize;
      var same = true;
      while i < 64usize {
        if *row[i] != *whole[128usize + i] { same = false; }
        i = i + 1usize;
      }
      expect(same, "row 2 is elements 128 to 191 of the whole");
      match rowToF32(&tm, tfile.view(), tm.tensors[3usize], 3u64, &mut row) {
        case is Ok { expect(false, "row 3 of 3 rows"); }
        case let e Error { expect(e.kind == ErrorKind.BadSize, "row out of range: BadSize"); }
      }
    }
    case is Error { expect(false, "tensorToF32 of a Q4_0 tensor"); }
  }

  // -------- alignments --------
  let aligns = [1u32, 2u32, 8u32, 32u32, 64u32, 4096u32];
  var a = 0usize;
  while a < 6usize {
    var aw = Writer.make();
    aw.setAlignment(aligns[a]);
    add(&mut aw, "x", TensorType.F32, &[3u64], 11u32);
    add(&mut aw, "y", TensorType.Q8_0, &[32u64], 12u32);
    add(&mut aw, "z", TensorType.F16, &[7u64], 13u32);
    let af = written(&aw);
    let am = modelOf(&af);
    expectUInt(am.alignment, u64.from(aligns[a]), "alignment read back");
    expectUInt(am.dataStart % u64.from(aligns[a]), 0u64, "data start aligned");
    var k = 0usize;
    while k < 3usize {
      expectUInt(am.tensors[k].offset % u64.from(aligns[a]), 0u64, "tensor offset aligned");
      k = k + 1usize;
    }
    expectUInt(am.tensors[0usize].offset, 0u64, "the first tensor is at the start of the data");
    // x is 12 bytes, y 34, z 14: each starts at the next multiple
    let al = u64.from(aligns[a]);
    expectUInt(am.tensors[1usize].offset, (12u64 + al - 1u64) / al * al, "second offset");
    let yEnd = am.tensors[1usize].offset + 34u64;
    expectUInt(am.tensors[2usize].offset, (yEnd + al - 1u64) / al * al, "third offset");
    expectUInt(u64.from(af.len()), am.dataStart + am.tensors[2usize].offset + 14u64, "file length");
    a = a + 1usize;
  }

  // A model with no tensors reads, and an empty one too
  var ew = Writer.make();
  let ef = written(&ew);
  expectUInt(u64.from(ef.len()), 32u64, "an empty model is the header padded to 32");
  let em = modelOf(&ef);
  expectUInt(u64.from(em.meta.len() + em.tensors.len()), 0u64, "nothing in it");
  done()
}
