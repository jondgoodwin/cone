// The text of an error kind, every variant: lower case, from 'kindName' (which
// another package still calls) and from the kind's toText. Pinned so the text cannot
// drift when the way it is asked for changes.

mod kindnames;

import testing use *;
import collections use String;
import http use *;

fn both(k: ErrorKind, want: &str, label: &str) {
  expectStr(kindName(k), want, label);
  expectStr((String() <- toText(&k)).view(), want, label);
}

fn main() i32 {
  both(ErrorKind.Malformed, "malformed", "Malformed");
  both(ErrorKind.TooLarge, "too large", "TooLarge");
  both(ErrorKind.Unsupported, "unsupported", "Unsupported");
  both(ErrorKind.Closed, "closed", "Closed");
  both(ErrorKind.TimedOut, "timed out", "TimedOut");
  both(ErrorKind.Refused, "refused", "Refused");
  both(ErrorKind.Reset, "reset", "Reset");
  done()
}
