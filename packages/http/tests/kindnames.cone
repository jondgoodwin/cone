// The text of an error kind, every variant: lower case. Pinned so the text cannot
// drift when the way it is asked for changes.

mod kindnames;

import testing use *;
import http use *;

fn main() i32 {
  expectStr(kindName(ErrorKind.Malformed), "malformed", "Malformed");
  expectStr(kindName(ErrorKind.TooLarge), "too large", "TooLarge");
  expectStr(kindName(ErrorKind.Unsupported), "unsupported", "Unsupported");
  expectStr(kindName(ErrorKind.Closed), "closed", "Closed");
  expectStr(kindName(ErrorKind.TimedOut), "timed out", "TimedOut");
  expectStr(kindName(ErrorKind.Refused), "refused", "Refused");
  expectStr(kindName(ErrorKind.Reset), "reset", "Reset");
  done()
}
