// Methods, statuses, heads, bodies and errors: the version-independent
// facts every core shares. Methods are tokens compared case-sensitively,
// safe and idempotent per RFC 9110; reason phrases are the registered ones;
// a response to HEAD, a 1xx, 204 and 304 have no body.

mod messages;

import testing use *;
import collections use String;
import http use *;

fn main() i32 {
  expect(methodOf("GET") == Method.Get, "GET");
  expect(methodOf("PATCH") == Method.Patch, "PATCH");
  expect(methodOf("get") == Method.Other, "methods are case-sensitive");
  expectStr(methodToken(Method.Delete), "DELETE", "a method's token");
  let token: &str = methodToken(Method.Put);
  let phrase: &str = reasonPhrase(204u16);
  let kind: &str = kindName(ErrorKind.Closed);
  expect(token == "PUT" && phrase == "No Content" && kind == "closed", "methods, phrases and kinds are text");
  expect(isSafe(Method.Head) && !isSafe(Method.Post), "safe");
  expect(isIdempotent(Method.Put) && isIdempotent(Method.Delete) && !isIdempotent(Method.Post)
    && !isIdempotent(Method.Patch), "idempotent");

  let r = RequestHead.make("PURGE", "/cache", "example.com");
  expect(r.method == Method.Other, "an extension method");
  expectStr(r.methodName(), "PURGE", "keeps its spelling");
  let g = RequestHead.get("/", "h:8080");
  expectStr(g.methodName(), "GET", "a registered method's name");
  expectStr(g.authority.view(), "h:8080", "the authority");
  expect(g.version == Version.Http11 && g.headers.isEmpty(), "HTTP/1.1, no fields yet");

  expectStr(reasonPhrase(200u16), "OK", "200");
  expectStr(reasonPhrase(404u16), "Not Found", "404");
  expectStr(reasonPhrase(413u16), "Content Too Large", "413's RFC 9110 name");
  expectStr(reasonPhrase(431u16), "Request Header Fields Too Large", "431");
  expectStr(reasonPhrase(299u16), "", "an unregistered code");
  expect(isInformational(103u16) && isSuccess(206u16) && isRedirect(308u16) && isClientError(451u16)
    && isServerError(503u16), "classes");
  expect(!responseHasBody(Method.Head, 200u16), "a response to HEAD has no body");
  expect(!responseHasBody(Method.Get, 204u16) && !responseHasBody(Method.Get, 304u16)
    && !responseHasBody(Method.Get, 100u16), "204, 304 and 1xx have none");
  expect(responseHasBody(Method.Get, 200u16) && responseHasBody(Method.Post, 404u16), "others have one");

  let e = BodyLength.empty();
  let s = BodyLength.sized(42u64);
  let u = BodyLength.unsized();
  expect(e.isEmpty() && s.isSized() && s.length == 42u64 && u.isUnsized(), "body lengths");

  let err = HttpError.make(ErrorKind.TooLarge, 431u16, "the head is longer than maxHeadBytes");
  expectStr(err.message().view(), "too large: the head is longer than maxHeadBytes", "an error's message");
  expect(err.status == 431u16 && !err.noResponse, "its status");
  expect(err.scope == ErrorScope.Connection, "an error made plainly ends the connection");
  match err.code {
    case let Some(c) {expect(false, "and names no protocol code");}
    case is None[u64] {expect(true, "and names no protocol code");}
  }
  expect(!err.isRetrySafe(), "a TooLarge is not safe to retry");

  let refused = HttpError.coded(ErrorKind.Refused, 7u64, ErrorScope.Stream, "REFUSED_STREAM");
  expectStr(refused.message().view(), "refused: REFUSED_STREAM", "a refused stream's message");
  expect(refused.isRetrySafe() && refused.scope == ErrorScope.Stream, "a refused stream may be retried");
  match refused.code {
    case let Some(c) {expectUInt(c, 7u64, "its code");}
    case is None[u64] {expect(false, "its code");}
  }
  let reset = HttpError.coded(ErrorKind.Reset, 8u64, ErrorScope.Stream, "CANCEL");
  expect(!reset.isRetrySafe(), "a reset stream is not safe to retry");
  let rk: &str = kindName(ErrorKind.Reset);
  let fk: &str = kindName(ErrorKind.Refused);
  let tk: &str = kindName(ErrorKind.TimedOut);
  expect(rk == "reset" && fk == "refused" && tk == "timed out", "the new kinds' names");
  done()
}
