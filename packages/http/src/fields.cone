// ======== Fields: names and values checked, and a message's list of them ========

// ---------------------------------------------------------------------------
// Characters (RFC 9110, section 5.6)
// ---------------------------------------------------------------------------

// A token's character: a letter, a digit, or one of !#$%&'*+-.^_`|~
pub fn isTchar(c: u8) bool {
  if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {return true;}
  c == '!' || c == '#' || c == '$' || c == '%' || c == '&' || c == '\'' || c == '*' ||
    c == '+' || c == '-' || c == '.' || c == '^' || c == '_' || c == '`' || c == '|' || c == '~'
}

// One or more token characters
pub fn isToken(s: &Array[u8]) bool {
  if s.len == 0usize {return false;}
  var i = 0usize;
  while i < s.len {
    if !isTchar(s[i]) {return false;}
    i = i + 1usize;
  }
  true
}

// A field value's visible character: VCHAR, or obs-text (0x80 and above)
pub fn isFieldVchar(c: u8) bool {(c >= 0x21u8 && c <= 0x7Eu8) || c >= 0x80u8}

// Optional whitespace: a space or a tab
pub fn isOws(c: u8) bool {c == ' ' || c == '\t'}

// s without the spaces and tabs at either end
pub fn trimOws(s: &Array[u8]) &Array[u8] {
  var a = 0usize;
  var b = s.len;
  while a < b && isOws(s[a]) {a = a + 1usize;}
  while b > a && isOws(s[b - 1usize]) {b = b - 1usize;}
  &s[a ..< b]
}

// Why s is not a field name, or "" when it is one
pub fn checkFieldName(s: &str) &str {
  if s.isEmpty() {return "a field's name is empty";}
  var i = 0usize;
  while i < s.len() {
    let c = s[i];
    if isOws(c) {return "a field's name has a space or a tab in it, or before its colon";}
    if !isTchar(c) {return "a field's name has a character no token may hold";}
    i = i + 1usize;
  }
  ""
}

// Why s, its ends already trimmed, is not a field value, or "" when it is
// one
pub fn checkFieldValue(s: &Array[u8]) &str {
  var i = 0usize;
  while i < s.len {
    let c = s[i];
    if c == '\r' || c == '\n' {return "a field's value holds a CR or an LF";}
    if c == 0u8 {return "a field's value holds a NUL";}
    if !isFieldVchar(c) && !isOws(c) {return "a field's value holds a control character";}
    i = i + 1usize;
  }
  ""
}

// ASCII's lower case of c
pub fn lowerAscii(c: u8) u8 {if c >= 'A' && c <= 'Z' {c + 32u8} else {c}}

// Whether a and b are the same, ignoring ASCII case
pub fn eqIgnoreCase(a: &Array[u8], b: &Array[u8]) bool {
  if a.len != b.len {return false;}
  var i = 0usize;
  while i < a.len {
    if lowerAscii(a[i]) != lowerAscii(b[i]) {return false;}
    i = i + 1usize;
  }
  true
}

// Whether the comma-separated list 'list' has 'token' as a member, ignoring
// case and the spaces around each member
pub fn listHas(list: &Array[u8], token: &str) bool {
  var start = 0usize;
  while start <= list.len {
    var end = start;
    while end < list.len && list[end] != ',' {end = end + 1usize;}
    if eqIgnoreCase(trimOws(&list[start ..< end]), token) {return true;}
    start = end + 1usize;
  }
  false
}

// ---------------------------------------------------------------------------
// Headers
// ---------------------------------------------------------------------------

// Where one field sits in a Headers' byte block: its name's and its value's
// byte ranges
struct Span {
  ns: u32;
  ne: u32;
  vs: u32;
  ve: u32;
}

// removeIf's test: a field 'remove' marked for dropping (its name range is empty,
// which no field's is)
fn spanDead(x: &Span) bool {x.ns == x.ne}

// A message's header or trailer fields, in order (see the package's header,
// FIELDS). The names and values are one byte block, and a table of u32 ranges
// into it says where each field's are, so a head kept and 'clear'ed is refilled
// with no allocation once its block and table have grown to its largest.
// A message has at most 100 fields (the parser's limit): 'add' past it is refused.
pub struct Headers is Default {
  bytes: String;
  spans: List[Span];

  // No fields: 'Headers()'
  pub fn initEmpty overload init(self: &new) {*self = Headers(String(), List[Span]());}

  pub fn len(self: &) usize {spans.len()}
  pub fn isEmpty(self: &) bool {spans.len() == 0usize}
  pub fn nameAt(self: &, i: usize) &str {
    let sp = &spans[i];
    &bytes.view()[usize.from(sp.ns) ..< usize.from(sp.ne)]
  }
  pub fn valueAt(self: &, i: usize) &Array[u8] {
    let sp = &spans[i];
    &bytes.view()[usize.from(sp.vs) ..< usize.from(sp.ve)]
  }

  // Add a field after the others: false, and nothing added, when the name is
  // not a token, or the value, its spaces and tabs at either end dropped, is
  // not a field value, or the message already has 100 fields
  pub fn add(self: &mut, name: &str, value: &Array[u8]) bool {
    let v = trimOws(value);
    if !checkFieldName(name).isEmpty() || !checkFieldValue(v).isEmpty() {return false;}
    if spans.len() >= 100usize {return false;}
    self.push(name, v);
    true
  }

  // Append a checked field
  fn push(self: &mut, name: &str, v: &Array[u8]) {
    let ns = bytes.len();
    bytes.appendBytes(name);
    let ne = bytes.len();
    bytes.appendBytes(v);
    spans.push(Span(u32.from(ns), u32.from(ne), u32.from(ne), u32.from(bytes.len())));
  }

  // Add a field whose value is a number written in decimal
  pub fn addUInt(self: &mut, name: &str, n: u64) bool {
    if !checkFieldName(name).isEmpty() || spans.len() >= 100usize {return false;}
    let ns = bytes.len();
    bytes.appendBytes(name);
    let ne = bytes.len();
    bytes.appendUInt(n);
    spans.push(Span(u32.from(ns), u32.from(ne), u32.from(ne), u32.from(bytes.len())));
    true
  }

  // Replace every field of this name with one holding value: false, and
  // nothing changed, when add would refuse it
  pub fn set(self: &mut, name: &str, value: &Array[u8]) bool {
    let v = trimOws(value);
    if !checkFieldName(name).isEmpty() || !checkFieldValue(v).isEmpty() {return false;}
    if spans.len() - self.count(name) >= 100usize {return false;}
    self.remove(name);
    self.push(name, v);
    true
  }

  // Remove every field of this name: how many. No scratch list: the fields are
  // marked, their bytes closed up in the block, and the table's removeIf drops them.
  pub fn remove(self: &mut, name: &str) usize {
    var gone = 0usize;
    var i = 0usize;
    while i < spans.len() {
      if eqIgnoreCase(self.nameAt(i), name) {
        spans.set(i, Span(spans[i].ns, spans[i].ns, 0u32, 0u32));
        gone = gone + 1usize;
      }
      i = i + 1usize;
    }
    if gone == 0usize {return 0usize;}
    // Close up the kept fields' bytes, in order (each moves down, never up)
    var w = 0usize;
    i = 0usize;
    while i < spans.len() {
      if !spanDead(&spans[i]) {
        let sns = spans[i].ns;
        let sne = spans[i].ne;
        let svs = spans[i].vs;
        let sve = spans[i].ve;
        let ns = usize.from(sns);
        let ln = usize.from(sve) - ns;
        let m = bytes.viewMut();
        var k = 0usize;
        while k < ln {m[w + k] = m[ns + k]; k = k + 1usize;}
        let shift = u32.from(ns - w);
        spans.set(i, Span(sns - shift, sne - shift, svs - shift, sve - shift));
        w = w + ln;
      }
      i = i + 1usize;
    }
    bytes.truncate(w);
    spans.removeIf(&spanDead);
    gone
  }

  // The first value of a field of this name, or None
  pub fn get(self: &, name: &str) Option[&Array[u8]] {
    var i = 0usize;
    while i < spans.len() {
      if eqIgnoreCase(self.nameAt(i), name) {return Some[&Array[u8]](self.valueAt(i));}
      i = i + 1usize;
    }
    None
  }

  // How many fields have this name
  pub fn count(self: &, name: &str) usize {
    var n = 0usize;
    var i = 0usize;
    while i < spans.len() {
      if eqIgnoreCase(self.nameAt(i), name) {n = n + 1usize;}
      i = i + 1usize;
    }
    n
  }

  pub fn has(self: &, name: &str) bool {self.count(name) > 0usize}

  // Whether any field of this name lists token among its comma-separated
  // members, ignoring case: 'hasToken("Connection", "close")'
  pub fn hasToken(self: &, name: &str, token: &str) bool {
    var i = 0usize;
    while i < spans.len() {
      if eqIgnoreCase(self.nameAt(i), name) && listHas(self.valueAt(i), token) {return true;}
      i = i + 1usize;
    }
    false
  }

  // Every value of this name, in order, joined by ", " (RFC 9110, 5.3); ""
  // when there is none
  pub fn joined(self: &, name: &str) String {
    var out = String();
    var first = true;
    var i = 0usize;
    while i < spans.len() {
      if eqIgnoreCase(self.nameAt(i), name) {
        if !first {out.append(", ");}
        out.appendBytes(self.valueAt(i));
        first = false;
      }
      i = i + 1usize;
    }
    out
  }

  // Another Headers holding the same fields
  pub fn clone(self: &) Headers {
    var h = Headers();
    h.bytes.appendBytes(bytes.view());
    var i = 0usize;
    while i < spans.len() {
      h.spans.push(spans[i]);
      i = i + 1usize;
    }
    h
  }

  // No fields; the block and table keep their room
  pub fn clear(self: &mut) {bytes.clear(); spans.clear();}
}
