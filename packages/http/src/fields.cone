// ======== Fields: names and values checked, and a message's list of them ========

// ---------------------------------------------------------------------------
// Characters (RFC 9110, section 5.6)
// ---------------------------------------------------------------------------

// A token's character: a letter, a digit, or one of !#$%&'*+-.^_`|~
pub fn isTchar(c: u8) bool {
  if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {return true;}
  c == '!' || c == '#' || c == '$' || c == '%' || c == '&' || c == '\'' || c == '*' ||
    c == '+' || c == '-' || c == '.' || c == '^' || c == '_' || c == '`' || c == '|' || c == '~'
}

// One or more token characters
pub fn isToken(s: &Array[u8]) bool {
  if s.len == 0usize {return false;}
  var i = 0usize;
  while i < s.len {
    if !isTchar(s[i]) {return false;}
    i = i + 1usize;
  }
  true
}

// A field value's visible character: VCHAR, or obs-text (0x80 and above)
pub fn isFieldVchar(c: u8) bool {(c >= 0x21u8 && c <= 0x7Eu8) || c >= 0x80u8}

// Optional whitespace: a space or a tab
pub fn isOws(c: u8) bool {c == ' ' || c == '\t'}

// s without the spaces and tabs at either end
pub fn trimOws(s: &Array[u8]) &Array[u8] {
  var a = 0usize;
  var b = s.len;
  while a < b && isOws(s[a]) {a = a + 1usize;}
  while b > a && isOws(s[b - 1usize]) {b = b - 1usize;}
  &s[a ..< b]
}

// Why s is not a field name, or "" when it is one
pub fn checkFieldName(s: &str) &str {
  if s.isEmpty() {return "a field's name is empty";}
  var i = 0usize;
  while i < s.len() {
    let c = s[i];
    if isOws(c) {return "a field's name has a space or a tab in it, or before its colon";}
    if !isTchar(c) {return "a field's name has a character no token may hold";}
    i = i + 1usize;
  }
  ""
}

// Why s, its ends already trimmed, is not a field value, or "" when it is
// one
pub fn checkFieldValue(s: &Array[u8]) &str {
  var i = 0usize;
  while i < s.len {
    let c = s[i];
    if c == '\r' || c == '\n' {return "a field's value holds a CR or an LF";}
    if c == 0u8 {return "a field's value holds a NUL";}
    if !isFieldVchar(c) && !isOws(c) {return "a field's value holds a control character";}
    i = i + 1usize;
  }
  ""
}

// ASCII's lower case of c
pub fn lowerAscii(c: u8) u8 {if c >= 'A' && c <= 'Z' {c + 32u8} else {c}}

// Whether a and b are the same, ignoring ASCII case
pub fn eqIgnoreCase(a: &Array[u8], b: &Array[u8]) bool {
  if a.len != b.len {return false;}
  var i = 0usize;
  while i < a.len {
    if lowerAscii(a[i]) != lowerAscii(b[i]) {return false;}
    i = i + 1usize;
  }
  true
}

// Whether the comma-separated list 'list' has 'token' as a member, ignoring
// case and the spaces around each member
pub fn listHas(list: &Array[u8], token: &str) bool {
  var start = 0usize;
  while start <= list.len {
    var end = start;
    while end < list.len && list[end] != ',' {end = end + 1usize;}
    if eqIgnoreCase(trimOws(&list[start ..< end]), token) {return true;}
    start = end + 1usize;
  }
  false
}

// ---------------------------------------------------------------------------
// Headers
// ---------------------------------------------------------------------------

// One field: its name as written, and its value
pub struct Field {
  fname: String;
  fvalue: String;

  pub fn blank() Field {Field(String.empty(), String.empty())}
  pub fn name(self: &) &str {fname.view()}
  pub fn value(self: &) &Array[u8] {fvalue.view()}
}

// A message's header or trailer fields, in order (see the package's header,
// FIELDS)
pub struct Headers {
  fields: List[Field];

  // No fields: 'Headers()'
  pub fn initEmpty overload init(self: &new) {*self = Headers(List[Field].empty());}
  pub fn empty() Headers {Headers(List[Field].empty())}

  pub fn len(self: &) usize {fields.len()}
  pub fn isEmpty(self: &) bool {fields.len() == 0usize}
  pub fn nameAt(self: &, i: usize) &str {fields[i].fname.view()}
  pub fn valueAt(self: &, i: usize) &Array[u8] {fields[i].fvalue.view()}

  // Add a field after the others: false, and nothing added, when the name is
  // not a token or the value, its spaces and tabs at either end dropped, is
  // not a field value
  pub fn add(self: &mut, name: &str, value: &Array[u8]) bool {
    let v = trimOws(value);
    if !checkFieldName(name).isEmpty() || !checkFieldValue(v).isEmpty() {return false;}
    fields.push(Field(String.from(name), String.fromBytes(v)));
    true
  }

  // Add a field whose value is a number written in decimal
  pub fn addUInt(self: &mut, name: &str, n: u64) bool {
    var s = String.empty();
    s.appendUInt(n);
    self.add(name, s.view())
  }

  // Replace every field of this name with one holding value: false, and
  // nothing changed, when add would refuse it
  pub fn set(self: &mut, name: &str, value: &Array[u8]) bool {
    let v = trimOws(value);
    if !checkFieldName(name).isEmpty() || !checkFieldValue(v).isEmpty() {return false;}
    self.remove(name);
    fields.push(Field(String.from(name), String.fromBytes(v)));
    true
  }

  // Remove every field of this name: how many
  pub fn remove(self: &mut, name: &str) usize {
    var gone = 0usize;
    var rev = List[Field].empty();
    while fields.len() > 0usize {
      var f = Field.blank();
      match fields.pop() {
        case var Some(s) {f <-> s;}
        case is None[Field] {}
      }
      if eqIgnoreCase(f.fname.view(), name) {gone = gone + 1usize;}
      else {rev.push(f);}
    }
    while rev.len() > 0usize {
      var f = Field.blank();
      match rev.pop() {
        case var Some(s) {f <-> s;}
        case is None[Field] {}
      }
      fields.push(f);
    }
    gone
  }

  // The first value of a field of this name, or None
  pub fn get(self: &, name: &str) Option[&Array[u8]] {
    var i = 0usize;
    while i < fields.len() {
      if eqIgnoreCase(fields[i].fname.view(), name) {return Some[&Array[u8]](fields[i].fvalue.view());}
      i = i + 1usize;
    }
    None
  }

  // How many fields have this name
  pub fn count(self: &, name: &str) usize {
    var n = 0usize;
    var i = 0usize;
    while i < fields.len() {
      if eqIgnoreCase(fields[i].fname.view(), name) {n = n + 1usize;}
      i = i + 1usize;
    }
    n
  }

  pub fn has(self: &, name: &str) bool {self.count(name) > 0usize}

  // Whether any field of this name lists token among its comma-separated
  // members, ignoring case: 'hasToken("Connection", "close")'
  pub fn hasToken(self: &, name: &str, token: &str) bool {
    var i = 0usize;
    while i < fields.len() {
      if eqIgnoreCase(fields[i].fname.view(), name) && listHas(fields[i].fvalue.view(), token) {return true;}
      i = i + 1usize;
    }
    false
  }

  // Every value of this name, in order, joined by ", " (RFC 9110, 5.3); ""
  // when there is none
  pub fn joined(self: &, name: &str) String {
    var out = String.empty();
    var first = true;
    var i = 0usize;
    while i < fields.len() {
      if eqIgnoreCase(fields[i].fname.view(), name) {
        if !first {out.append(", ");}
        out.appendBytes(fields[i].fvalue.view());
        first = false;
      }
      i = i + 1usize;
    }
    out
  }

  // Another Headers holding the same fields
  pub fn copy(self: &) Headers {
    var h = Headers.empty();
    var i = 0usize;
    while i < fields.len() {
      h.fields.push(Field(fields[i].fname.copy(), fields[i].fvalue.copy()));
      i = i + 1usize;
    }
    h
  }

  pub fn clear(self: &mut) {fields.clear();}
}
