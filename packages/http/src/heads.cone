// ======== Heads: a request's and a response's, whatever the version ========

// A request's head (see the package's header, HEADS)
pub struct RequestHead is Default {
  pub method: Method;
  pub target: String;       // the path and query: '/a/b?c'
  pub authority: String;    // 'host' or 'host:port'
  pub scheme: String;       // 'http' or 'https', or "" when not known
  pub version: Version;
  pub headers: Headers;
  other: String;            // Method.Other's token

  // A request: method is any token, a registered one or not
  pub fn make(method: &str, target: &str, authority: &str) RequestHead {
    let m = methodOf(method);
    let o = if m == Method.Other {String.from(method)} else {String()};
    RequestHead(m, String.from(target), String.from(authority), String(),
      Version.Http11, Headers(), o)
  }

  // A GET of target from authority
  pub fn get(target: &str, authority: &str) RequestHead {RequestHead.make("GET", target, authority)}

  // Nothing yet: a request head to swap another out with
  pub fn init(self: &new) {
    *self = RequestHead(Method.Get, String(), String(), String(),
      Version.Http11, Headers(), String());
  }

  // The method's token: 'GET', or an extension's spelling
  pub fn methodName(self: &) &str {
    if method == Method.Other {other.view()} else {methodToken(method)}
  }
}

// A response's head (see the package's header, HEADS)
pub struct ResponseHead is Default {
  pub status: u16;
  pub version: Version;
  pub headers: Headers;

  pub fn make(status: u16) ResponseHead {ResponseHead(status, Version.Http11, Headers())}

  // Nothing yet: a response head to swap another out with
  pub fn init(self: &new) {*self = ResponseHead(0u16, Version.Http11, Headers());}
}
