// ======== Heads: a request's and a response's, whatever the version ========

// A request's head (see the package's header, HEADS)
pub struct RequestHead {
  pub method Method;
  pub target String;       // the path and query: '/a/b?c'
  pub authority String;    // 'host' or 'host:port'
  pub scheme String;       // 'http' or 'https', or "" when not known
  pub version Version;
  pub headers Headers;
  other String;            // Method.Other's token

  // A request: method is any token, a registered one or not
  pub fn make(method &Array[u8], target &Array[u8], authority &Array[u8]) RequestHead {
    imm m = methodOf(method);
    imm o = if m == Method.Other[] {String.from(method);} else {String.empty();};
    new RequestHead(m, String.from(target), String.from(authority), String.empty(),
      Version.Http11[], Headers.empty(), o);
  }

  // A GET of target from authority
  pub fn get(target &Array[u8], authority &Array[u8]) RequestHead {RequestHead.make("GET", target, authority);}

  // Nothing yet: a request head to swap another out with
  pub fn empty() RequestHead {
    new RequestHead(Method.Get[], String.empty(), String.empty(), String.empty(),
      Version.Http11[], Headers.empty(), String.empty());
  }

  // The method's token: 'GET', or an extension's spelling
  pub fn methodName(self &) &Array[u8] {
    if method == Method.Other[] {other.view();} else {methodToken(method);};
  }
}

// A response's head (see the package's header, HEADS)
pub struct ResponseHead {
  pub status u16;
  pub version Version;
  pub headers Headers;

  pub fn make(status u16) ResponseHead {new ResponseHead(status, Version.Http11[], Headers.empty());}

  // Nothing yet: a response head to swap another out with
  pub fn empty() ResponseHead {new ResponseHead(0u16, Version.Http11[], Headers.empty());}
}
