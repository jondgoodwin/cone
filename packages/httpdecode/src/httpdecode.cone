// An HTTP body decoded as it arrives. 'Decoder' is the sink a fetch's body goes
// to (actorhttp's Client.streamTo): it asks for the encodings it can decode,
// waits for the response's head, and puts between the body and the caller's sink
// the stage the head's Content-Encoding names (gzip, deflate or zstd:
// 'Stage[deflate.Inflater]' or 'Stage[zstd.Decompressor]'), or none for a body
// that is not encoded. What reaches the caller's sink is the decoded bytes,
// chunk by chunk, and the one 'end'.
//
//   let sink = MySink();                                   // a ChunkSink
//   let d = httpdecode.Decoder(sink, actorhttp.defaultMaxBody);
//   imm r = await d.open(client.clone(), Request.get(url));   // Result[BodyHead, FetchError]
//
// WHY A PACKAGE OF ITS OWN. A codec stage needs its codec, and a program that
// imports actorhttp should not link deflate and zstd unless it decodes. So this
// package, which imports both, sits over actorhttp and stages; neither imports it.
//
// THE CREDIT is still the fetch's one window. The Decoder relays each buffer
// the decoder stage gives back to the body's source (actorhttp's BodySource),
// and the stage gives the input chunk back once it has fed it and pulled its
// output out, so a slow sink slows the stage, the stage the fetch.
//
// THE LIMIT is on bytes OUT: 'limit' is what the decompression may produce
// (past it the decoder fails with the codec's own TooLarge error, and the sink's
// one end is Failed). Use actorhttp.defaultMaxBody, the limit a client's
// get/send/fetchWhole applies to a body, so that a decoded body is held to the
// same bound as an undecoded one.
//
// HOW IT ENDS. A corrupt stream ends the sink with Failed(the codec's own
// error, message and typed error intact). The rest of the body the server is
// still sending is given back unread, so the fetch runs to its end; a caller who
// wants the download stopped cancels the group the request was sent in. A
// Content-Encoding this package cannot decode (br, several codings listed) ends
// the sink with Failed("httpdecode: unsupported Content-Encoding"), the head
// answered as it came. A failure before the head is the caller's Err and the
// sink's Failed end, as for streamTo. 'Content-Encoding' stays in the head as
// the server sent it.

mod httpdecode;

import iobuf use IoBuf;
import collections use Deque, AnyError;
import http use *;
import httpclient;
import actors;
import actorhttp use Client, BodyHead, FetchError;
import stages use ChunkSink, ChunkSource, Ending, Stage;
import deflate;
import zstd;

// What 'open' asks for with Accept-Encoding, unless the request has its own
pub const acceptEncoding = "gzip, deflate, zstd";

enum Coding {
  Identity;
  Gzip;
  Zlib;
  Zstd;
  Other;
}

// The coding a head names. 'deflate' is zlib's, as RFC 9110 says it is
fn codingOf(h: &Headers) Coding {
  match h.get("Content-Encoding") {
    case let Some(v) {
      var i = 0usize;
      while i < v.len {
        if v[i] == 44u8 {return Coding.Other;}
        i = i + 1usize;
      }
      if h.hasToken("Content-Encoding", "gzip") || h.hasToken("Content-Encoding", "x-gzip") {Coding.Gzip}
      else if h.hasToken("Content-Encoding", "deflate") {Coding.Zlib}
      else if h.hasToken("Content-Encoding", "zstd") {Coding.Zstd}
      else if h.hasToken("Content-Encoding", "identity") {Coding.Identity}
      else {Coding.Other}
    }
    case is None[&Array[u8]] {Coding.Identity}
  }
}

fn handBack(up: &Option[ChunkSource], b: IoBuf) {
  match up {
    case let &Some(u) {u.giveBack(b);}
    case is None {}
  }
}

pub actor Decoder is ChunkSink, ChunkSource {
  sink: ChunkSink;
  limit: u64;
  up: Option[ChunkSource];       // the body's source, whom every buffer goes back to
  target: Option[ChunkSink];     // where chunks go once the head has said (the decoder stage, or the sink)
  chosen: bool;                  // the head has said (or has failed)
  refused: bool;                 // ...and its coding is one we cannot decode
  backlog: Deque[IoBuf];         // chunks that came before the head's answer was seen
  early: Option[Ending];         // the 'end' that came before it

  // A decoder in front of 'sink', the output of a decompression held to 'limit' bytes
  pub fn init(self: &new, sink: ChunkSink, limit: usize) {
    *self = Self(sink: sink, limit: u64.from(limit), up: None[ChunkSource], target: None[ChunkSink],
      chosen: false, refused: false, backlog: Deque[IoBuf](), early: None[Ending]);
  }

  // The fetch of 'req' (Client.streamTo), asking for the encodings this can
  // decode unless the request names its own, its body decoded to the sink.
  // Answered when the head arrives, as streamTo is
  pub async fn open(self, client: Client, req: httpclient.Request) Result[BodyHead, FetchError] {
    var r = req;
    if !r.headers.has("Accept-Encoding") {r.headers.add("Accept-Encoding", acceptEncoding);}
    let res = await client.streamTo(r, selfactor);
    match &res {
      case let &Ok(head) {self.choose(codingOf(&head.headers));}
      else {self.choose(Coding.Identity);}
    }
    res
  }

  fn choose(self: &mut, c: Coding) {
    if chosen {return;}
    chosen = true;
    if c == Coding.Gzip {
      var t = deflate.Inflater.make(deflate.Format.Gzip);
      t.setLimit(limit);
      target = Some[ChunkSink](asSink(Stage[deflate.Inflater](sink, t)));
    } else if c == Coding.Zlib {
      var t = deflate.Inflater.make(deflate.Format.Zlib);
      t.setLimit(limit);
      target = Some[ChunkSink](asSink(Stage[deflate.Inflater](sink, t)));
    } else if c == Coding.Zstd {
      var t = zstd.Decompressor.make();
      t.setLimit(limit);
      target = Some[ChunkSink](asSink(Stage[zstd.Decompressor](sink, t)));
    } else if c == Coding.Identity {
      target = Some[ChunkSink](sink);
    } else {
      refused = true;
      sink.end(Ending.Failed(AnyError.msg("httpdecode: unsupported Content-Encoding")));
    }
    match &target {
      case let &Some(t) {t.attach(selfactor);}
      else {}
    }
    each b in backlog.drain() {self.forward(b);}
    match early.take() {
      case let Some(how) {self.finish(how);}
      else {}
    }
  }

  fn forward(self: &mut, c: IoBuf) {
    match &target {
      case let &Some(t) {t.accept(c);}
      case is None {handBack(&up, c);}
    }
  }

  fn finish(self: &mut, how: Ending) {
    if refused {return;}
    match &target {
      case let &Some(t) {t.end(how);}
      case is None {}
    }
  }

  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source);
  }

  pub async fn accept(self, c: IoBuf) {
    if chosen {self.forward(c);} else {backlog.push(c);}
  }

  pub async fn end(self, how: Ending) {
    if chosen {self.finish(how);} else {early = Some[Ending](how);}
  }

  // A buffer back from the stage (or the sink): on to the body's source
  pub async fn giveBack(self, b: IoBuf) {
    handBack(&up, b);
  }
}

// An actor as the trait it is a stage of (a conversion at a call, which Some[ChunkSink](x) does not make)
fn asSink(s: ChunkSink) ChunkSink {s}
