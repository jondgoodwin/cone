// An HTTP body decoded as it arrives: two plain functions over actorhttp's BodyStream.
// 'request' asks for the encodings this can decode; 'to' reads the response's head
// and sends the body to the caller's sink, with the stage the head's Content-Encoding
// names (gzip, deflate or zstd: 'TransformStage[deflate.Inflater]' or
// 'TransformStage[zstd.Decompressor]') put between the body and the sink, or none for a
// body that is not encoded. What reaches the caller's sink is the decoded bytes, chunk
// by chunk, and the one 'end'.
//
//   let sink = MySink();                                           // a ChunkSink
//   let body = await client.stream(httpdecode.request(req))?;     // Result[BodyStream, FetchError]
//   httpdecode.to(body, sink, actorhttp.defaultMaxBody);          // reads the head, sends the body on
//
// WHY A PACKAGE OF ITS OWN. A codec stage needs its codec, and a program that
// imports actorhttp should not link deflate and zstd unless it decodes. So this
// package, which imports both, sits over actorhttp and stages; neither imports it.
//
// THE CREDIT is still the fetch's one window: 'body.to' attaches the decoder stage
// as the body's sink, and the stage gives its input chunk back once it has fed it and
// pulled its output out, so a slow sink slows the stage, the stage the fetch.
//
// THE LIMIT bounds bytes OUT, the DECODED output: 'limit' is what the
// decompression may produce (past it the decoder fails with the codec's own
// TooLarge error, and the sink's one end is Failed). This differs from
// fetchWhole (and get/send), whose limit counts bytes ON THE WIRE, the
// undecoded body. Use actorhttp.defaultMaxBody, the same number, so that a
// decoded body is held to the same bound as an undecoded one; the wire side of
// a compressed body is not bounded by it.
//
// HOW IT ENDS. The caller's sink gets exactly one 'end' on every path 'to' takes. A
// corrupt or oversized stream ends the sink Failed (the codec's own error, message
// and typed error intact), and the failed stage's stop ends the fetch, so the
// server's remaining bytes are not read. A Content-Encoding this package cannot
// decode (br, several codings listed) ends the sink Failed("httpdecode: unsupported
// Content-Encoding") at once, with no 'attach' and no chunk, and the body is dropped,
// which cancels the fetch. A failure before the head is the caller's Err from
// 'client.stream': the caller still has the sink and 'to' was never called, so the
// sink is untouched. 'Content-Encoding' stays in the head as the server sent it.

mod httpdecode;

import collections use AnyError;
import http use *;
import httpclient;
import actorhttp use BodyStream;
import stages use ChunkSink, Ending, TransformStage;
import deflate;
import zstd;

// What 'request' asks for with Accept-Encoding, unless the request has its own
pub const acceptEncoding = "gzip, deflate, zstd";

enum Coding {
  Identity;
  Gzip;
  Zlib;
  Zstd;
  Other;
}

// The coding a head names. 'deflate' is zlib's, as RFC 9110 says it is
fn codingOf(h: &Headers) Coding {
  match h.get("Content-Encoding") {
    case let Some(v) {
      var i = 0usize;
      while i < v.len {
        if v[i] == 44u8 {return Coding.Other;}
        i = i + 1usize;
      }
      if h.hasToken("Content-Encoding", "gzip") || h.hasToken("Content-Encoding", "x-gzip") {Coding.Gzip}
      else if h.hasToken("Content-Encoding", "deflate") {Coding.Zlib}
      else if h.hasToken("Content-Encoding", "zstd") {Coding.Zstd}
      else if h.hasToken("Content-Encoding", "identity") {Coding.Identity}
      else {Coding.Other}
    }
    case is None[&Array[u8]] {Coding.Identity}
  }
}

// The request with Accept-Encoding for the encodings 'to' can decode, unless it names its own
pub fn request(req: httpclient.Request) httpclient.Request {
  var r = req;
  if !r.headers.has("Accept-Encoding") {r.headers.add("Accept-Encoding", acceptEncoding);}
  r
}

// The body sent to 'sink', decoded as its head's Content-Encoding says; 'limit' bounds the
// decoded bytes. The sink gets exactly one 'end' (see HOW IT ENDS). Before the head there is no
// body, so there is nothing to call this with: when 'client.stream(httpdecode.request(req))'
// answers Err, the sink was never handed over and was never touched, and it is still the
// caller's to end (or drop)
pub fn to(body: BodyStream, sink: ChunkSink, limit: usize) {
  let c = codingOf(&body.headers);
  let lim = u64.from(limit);
  if c == Coding.Gzip {
    var t = deflate.Inflater.make(deflate.Format.Gzip);
    t.setLimit(lim);
    body.to(TransformStage[deflate.Inflater](sink, t));
  } else if c == Coding.Zlib {
    var t = deflate.Inflater.make(deflate.Format.Zlib);
    t.setLimit(lim);
    body.to(TransformStage[deflate.Inflater](sink, t));
  } else if c == Coding.Zstd {
    var t = zstd.Decompressor.make();
    t.setLimit(lim);
    body.to(TransformStage[zstd.Decompressor](sink, t));
  } else if c == Coding.Identity {
    body.to(sink);
  } else {
    // 'body' is dropped on return, unchosen: its final cancels the fetch
    sink.end(Ending.Failed(AnyError.msg("httpdecode: unsupported Content-Encoding")));
  }
}
