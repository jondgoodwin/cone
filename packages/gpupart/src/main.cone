// gpupart's main: pattern's kernel on the GPU and pattern's function on the
// CPU, every word compared

const COUNT = 4096u32;

// The 32 bits of an f32 ('as' reinterprets)
fn bits(f f32) u32 { f as u32; }

fn main() i32 {
  mut instance = Instance.create("gpupart");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  if (libc.getenv(&"GPUWORK_REPORT" as *u8) as usize) != 0usize {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr("\n");
  }

  // The kernel, from the module Congo built from gpu/ and put beside this
  // program. Its bindings: the settings and the cells it writes
  imm spirv = readSpirv("gpupart.spv");
  require(spirv.len() > 5usize, "gpupart.spv beside the program");
  mut kernel = Kernel.make(&device, spirv.view(), "fill", &[READ, READ_WRITE]);
  require(kernel.isValid(), "the fill kernel");
  expectUInt(u64.from(kernel.workgroup[0usize]), 64u64, "its workgroup, 64, read from the SPIR-V");

  imm settings = new Settings(0x9e3779b9u32, 1.75, 0.25);

  // On the GPU: a cell an invocation, three words a cell
  mut works = Works.make();
  mut job = Job.make(&mut device);
  imm settingsSlot = job.give(uploadValue(&mut device, &settings));
  imm cellSlot = job.give(zeroed(&mut device, 3usize * usize.from(COUNT)));
  require(job.dispatch(&mut device, &kernel, &[settingsSlot, cellSlot], COUNT / 64u32), "the dispatch");
  imm cellBack = job.readback(&mut device, cellSlot);
  imm ticket = works.submit(&mut device, job, Target.Here[0u64]);
  mut answers = List[Completion].empty();
  works.waitFor(&mut device, ticket, &mut answers);
  require(answers.len() == 1usize and answers[0usize].ok, "the GPU ran the job");
  expectUInt(u64.from(answers[0usize].failures.len()), 0u64, "no invocation failed a check");
  imm words = answers[0usize].words(cellBack);
  require(words.len() == 3usize * usize.from(COUNT), "three words a cell from the GPU");

  // On the CPU: the same function, called as src/ calls any of gpu/'s, and
  // every word compared
  mut compared = 0u64;
  mut identical = 0u64;
  mut i = 0u32;
  while i < COUNT {
    imm c = pattern.cell(i, settings);
    imm at = 3usize * usize.from(i);
    if *words[at] == c.hash { identical = identical + 1u64; }
    if *words[at + 1usize] == bits(c.unit) { identical = identical + 1u64; }
    if *words[at + 2usize] == bits(c.mixed) { identical = identical + 1u64; }
    compared = compared + 3u64;
    i = i + 1u32;
  }
  print <- compared, " values compared, ", identical, " identical\n";
  expectUInt(identical, compared, "every value the GPU wrote is the CPU's, bit for bit");
  expectUInt(u64.from(refusals()), 0u64, "nothing refused");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}
