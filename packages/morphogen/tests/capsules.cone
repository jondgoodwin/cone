// CapsuleSet: many tapered capsules, built into a grid, viewed as
// sdf.Capsules. Only a failure prints.
//
// - One capsule, built or not: 'taperedCapsule' to 1e-6 wherever that is
//   under the cap (reach - 12 x blend), the cap beyond it, inside the grid.
// - Chains: two capsules end to end in one chain ('extend') have no bulge
//   at the joint; as two chains ('add'), the joint swells by k.
// - Skipping is exact: 'distanceAll' gives the bits of the field written
//   out plainly (the hard union m of every capsule; the smooth union from
//   m + 4k of every chain nearer than m + 8k, each chain the hard union of
//   its capsules; held to the cap), asking every capsule, at 2048 hashed
//   points.
// - 400 random capsules in a box, in chains of three (radii 0.01 to 0.05,
//   blend 0.02, reach 0.4, buckets of 0.2): at 8192 hashed points the grid gives
//   'distanceAll''s bits, and the field lies between m - 4k and m wherever
//   it is under the cap.
// - Continuity: at 8192 hashed pairs 1/256 apart, |d(p) - d(q)| is at most
//   |p - q| (1 + 1e-3): no jump at a bucket's edge, at the cap, or where a
//   capsule joins the union.
// - Outside the grid's box: the cap plus the distance to the box, a bound
//   (at most m - 4k).
// - A fork of three capsules meshed by surface nets: closed, 'validate'
//   clean, Euler 2 (one fused piece), sparse sampling the same bits as
//   dense.

mod capsules;

import testing use *;
import stdio use *;
import geomath use *;
import collections use *;
import noise;
import mesh;
import sdf use *;
import sdfmesh use *;
import morphogen use *;

fn v(x f32, y f32, z f32) Vec3 { new Vec3(x, y, z); }
fn absf(a f32) f32 { if a < 0. { 0. - a; } else { a; }; }
fn minf(a f32, b f32) f32 { if a < b { a; } else { b; }; }

fn hashed(i i32, salt u32, lo Vec3, hi Vec3) Vec3 {
  imm h = noise.hash2(i, 0, salt);
  imm s = hi - lo;
  v(lo.x + s.x * noise.toUnit(h.x), lo.y + s.y * noise.toUnit(h.y), lo.z + s.z * noise.toUnit(h.z));
}

// The hard union of every capsule
fn hard(c &Capsules, p Vec3) f32 {
  mut m f32 = 3.4028235e38;
  mut k = 0usize;
  while k < c.count() {
    m = minf(m, taperedCapsule(p, c.a[k], c.b[k], c.ra[k], c.rb[k]));
    k = k + 1usize;
  }
  m;
}

// The field written out plainly, every capsule asked: each chain's hard
// union, smooth-unioned from m + 4k if nearer than m + 8k
fn plain(c &Capsules, p Vec3) f32 {
  imm m = hard(c, p);
  mut d = m + 4. * c.blend;
  mut k = 0usize;
  while k < c.count() {
    mut e = taperedCapsule(p, c.a[k], c.b[k], c.ra[k], c.rb[k]);
    while k + 1usize < c.count() and c.chain[k + 1usize] == c.chain[k] {
      k = k + 1usize;
      e = minf(e, taperedCapsule(p, c.a[k], c.b[k], c.ra[k], c.rb[k]));
    }
    if e < m + 8. * c.blend { d = smoothUnion(d, e, c.blend); }
    k = k + 1usize;
  }
  minf(d, c.cap());
}

// A chain has no bulge at its joints; two chains meeting there do
fn chains() {
  mut c = CapsuleSet.make(0.01, 1.);
  c.add(v(0., 0., 0.), v(1., 0., 0.), 0.1, 0.1);
  c.extend(v(1., 0., 0.), v(2., 0., 0.), 0.1, 0.1);
  expectFloat(f64.from(c.view().distance(v(1., 0.5, 0.))), 0.4d, 1e-6d, "a chain: no bulge at the joint");
  mut s = CapsuleSet.make(0.01, 1.);
  s.add(v(0., 0., 0.), v(1., 0., 0.), 0.1, 0.1);
  s.add(v(1., 0., 0.), v(2., 0., 0.), 0.1, 0.1);
  expectFloat(f64.from(s.view().distance(v(1., 0.5, 0.))), 0.39d, 1e-6d, "two chains: the joint swells by k");
}

fn one() {
  imm a = v(0., 0., 0.);
  imm b = v(1., 0.2, 0.);
  mut c = CapsuleSet.make(0.01, 0.3);
  c.add(a, b, 0.1, 0.04);
  mut exact = true;
  mut i = 0;
  while i < 512 {
    imm p = hashed(i, 5u32, v(-0.6, -0.6, -0.6), v(1.6, 0.8, 0.6));
    imm want = minf(taperedCapsule(p, a, b, 0.1, 0.04), c.view().cap());
    if absf(c.view().distance(p) - want) > 0.000001 { exact = false; }
    i = i + 1;
  }
  expect(exact, "one capsule, unbuilt: taperedCapsule, capped");
  c.build(0.25);
  imm f = c.view();
  mut built = true;
  i = 0;
  while i < 512 {
    imm p = hashed(i, 5u32, v(-0.6, -0.6, -0.6), v(1.6, 0.8, 0.6));
    if f.distance(p) != f.distanceAll(p) and f.bounds().expand(0.3).contains(p) { built = false; }
    i = i + 1;
  }
  expect(built, "one capsule, built: the same bits");
}

fn cloud() CapsuleSet {
  mut c = CapsuleSet.make(0.02, 0.4);
  mut i = 0;
  while i < 400 {
    imm a = hashed(i, 1u32, v(-1., -1., -1.), v(1., 1., 1.));
    imm d = hashed(i, 2u32, v(-0.3, -0.3, -0.3), v(0.3, 0.3, 0.3));
    imm r = hashed(i, 3u32, v(0.01, 0.01, 0.), v(0.05, 0.05, 0.));
    if i % 3 == 0 { c.add(a, a + d, r.x, r.y); } else { c.extend(a, a + d, r.x, r.y); }
    i = i + 1;
  }
  c;
}

fn skipping() {
  imm set = cloud();
  imm c = set.view();
  mut same = true;
  mut i = 0;
  while i < 2048 {
    imm p = hashed(i, 9u32, v(-1.2, -1.2, -1.2), v(1.2, 1.2, 1.2));
    if c.distanceAll(p) != plain(&c, p) { same = false; }
    i = i + 1;
  }
  expect(same, "skipping far capsules leaves the bits");
}

fn grid() {
  mut set = cloud();
  set.build(0.2);
  imm c = set.view();
  mut same = true;
  mut between = true;
  mut i = 0;
  while i < 8192 {
    imm p = hashed(i, 11u32, v(-1.2, -1.2, -1.2), v(1.2, 1.2, 1.2));
    imm got = c.distance(p);
    if got != c.distanceAll(p) { same = false; }
    if got < c.cap() {
      imm m = hard(&c, p);
      if got > m or got < m - 4. * c.blend { between = false; }
    }
    i = i + 1;
  }
  expect(same, "the grid gives every capsule's bits");
  expect(between, "between m - 4k and m");
  // Continuity
  mut ratio f32 = 0.;
  i = 0;
  while i < 8192 {
    imm p = hashed(i, 13u32, v(-1.2, -1.2, -1.2), v(1.2, 1.2, 1.2));
    imm dir = hashed(i, 14u32, v(-1., -1., -1.), v(1., 1., 1.)).normalize() * 0.00390625;
    imm r = absf(c.distance(p + dir) - c.distance(p)) / 0.00390625;
    if r > ratio { ratio = r; }
    i = i + 1;
  }
  expect(ratio <= 1.001, "no jumps");
  // Outside the box
  imm box = c.bounds();
  imm far = box.max + v(1., 2., 0.5);
  imm got = c.distance(far);
  expect(got <= hard(&c, far) - 4. * c.blend, "outside: a bound");
  expect(got > 1., "outside: the cap plus the box's distance");
}

// A fork: a trunk and two branches from its top
fn fork() {
  mut set = CapsuleSet.make(0.03, 0.5);
  set.add(v(0., 0., 0.), v(0., 0.5, 0.), 0.12, 0.08);
  set.add(v(0., 0.5, 0.), v(-0.3, 0.9, 0.), 0.06, 0.03);
  set.add(v(0., 0.5, 0.), v(0.35, 0.85, 0.1), 0.06, 0.03);
  set.build(0.15);
  imm f = set.view();
  imm box = f.bounds();
  imm sparse = surfaceNet(&f, box, 0.02, 1u32, true);
  imm dense = surfaceNet(&f, box, 0.02, 1u32, false);
  mut problems = List[String].empty();
  imm pm = sparse.toPolyMesh(&mut problems);
  expectInt(i64.from(problems.len()), 0, "fork: no quads refused");
  imm invalid = pm.validate();
  if !expectInt(i64.from(invalid.len()), 0, "fork: validate clean") { printStr(invalid[0usize].view()); print <- "\n"; }
  expectInt(i64.from(pm.vertexCount()) - i64.from(pm.edgeCount()) + i64.from(pm.faceCount()), 2, "fork: Euler 2");
  imm sm = sparse.toMesh();
  imm dm = dense.toMesh();
  expectUInt(u64.from(mesh.meshHash(&sm)), u64.from(mesh.meshHash(&dm)), "fork: sparse is dense");
}

fn main() i32 {
  one();
  chains();
  skipping();
  grid();
  fork();
  done();
}
