// same thing it agreed too (the script prints the differences it found, to be decided by hand).

mod semantics;
import testing use *;
import collections use *;
import regex;
import stdio;

// The answer, asked of the pattern as written (the bounded backtracker answers groups
// on a short text) and of the same pattern with a dead alternative of 132000 states
// added (a program too big for the backtracker's bits, so the Pike VM answers): the two
// must agree.
//
// Why padding, and why not every case in debug: a package test is its own module and
// cannot reach a private item of 'regex' (a non-'pub' name is private to its module), so
// there is no non-public engine selector to call; the padding is the only way to force the
// Pike VM. Compiling 132000 states for each case is what takes the time (about 60 s for
// all of them in a debug build), so a debug build pads every fourth case and a release
// build every case.
//
// A padded pattern that fails to compile although the original did (the limit is 200000
// states and the padding takes 132000, so an original of 68000 states or more would) is not
// compared, and is counted in 'padErrors'; 'main' prints the count and the .out pins it.
// No case in this file is that big, so it is 0: a case added that is, shows as a changed
// count, to be looked at, rather than as a silently skipped comparison.
var @threadlocal padErrors = 0usize;
var @threadlocal askCount = 0usize;
fn ask(kind: &str, pat: &str, text: &str, repl: &str) String {
  let a = askOne(kind, pat, text, repl);
  if a.view().startsWith("ERR") { return a; }
  askCount = askCount + 1;
  #if #debug { if askCount % 4 != 0 { return a; } }
  var padded = String.from("(?:");
  padded.append(pat);
  padded.append(")|(?:\\z[a-z]{1000}){132}");
  let b = askOne(kind, padded.view(), text, repl);
  if b.view().startsWith("ERR") { padErrors = padErrors + 1; return a; }
  if b.view() == a.view() { return a; }
  var s = String.from("ENGINES DIFFER: ");
  s.append(a.view());
  s.append(" / ");
  s.append(b.view());
  s
}

// Every match as 'start..end', found by asking for the groups again and again
fn capsList(re: &regex.Regex, t: &str) String {
  var out = String();
  var pos = 0usize;
  var lastEnd = 0xFFFFFFFFFFFFFFFFusize;
  var first = true;
  while pos <= t.len() {
    match re.capturesFrom(t, pos) {
      case let Some(c) {
        let m = c.span(0).unwrap();
        if m.start == m.end && m.end == lastEnd { pos = m.end + 1; }
        else {
          if !first { out.append(" "); }
          first = false;
          out <- m.start, "..", m.end;
          lastEnd = m.end;
          pos = m.end;
        }
      }
      case is None { pos = t.len() + 1; }
    }
  }
  if first { out.append("-"); }
  out
}

// The answer to a question, in the notation gen_cases.py explains
fn askOne(kind: &str, pat: &str, text: &str, repl: &str) String {
  let bytes = kind == "bfind" || kind == "bcaps";
  var out = String();
  var built = regex.Regex.parse(pat);
  if bytes { built = regex.Regex.parseBytes(pat); }
  match built {
    case let Ok(re) {
      var hay = String.from(text);
      if bytes { hay = unhex(text); }
      let t = hay.view();
      if kind == "find" || kind == "bfind" {
        var it = re.matches(t);
        var first = true;
        var go = true;
        while go {
          match it.next() {
            case let Some(m) {
              if !first { out.append(" "); }
              first = false;
              out <- m.start, "..", m.end;
            }
            case is None { go = false; }
          }
        }
        if first { out.append("-"); }
        if capsList(&re, t).view() != out.view() { out.append(" !CAPS-DIFFER"); }
      }
      else if kind == "caps" || kind == "bcaps" {
        match re.captures(t) {
          case let Some(c) {
            var i = 0usize;
            while i < c.len() {
              if i > 0 { out.append(","); }
              match c.span(i) {
                case let Some(m) { out <- m.start, "..", m.end; }
                case is None { out.append("_"); }
              }
              i = i + 1;
            }
          }
          case is None { out.append("none"); }
        }
      }
      else if kind == "ismatch" { out.append(if re.isMatch(t) { "true" } else { "false" }); }
      else if kind == "split" {
        var it = re.split(t);
        var go = true;
        while go {
          match it.next() {
            case let Some(part) { out <- "[", part, "]"; }
            case is None { go = false; }
          }
        }
      }
      else if kind == "replace" { out = re.replace(t, repl); }
      else if kind == "replaceall" { out = re.replaceAll(t, repl); }
    }
    case let Err(e) { out <- "ERR ", e; }
  }
  out
}

fn unhex(h: &str) String {
  var s = String();
  var i = 0usize;
  while i + 1 < h.len() {
    s.appendByte(hexByte(h[i]) * 16u8 + hexByte(h[i + 1]));
    i = i + 2;
  }
  s
}

fn hexByte(c: u8) u8 { if c >= 'a' { c - 'a' + 10u8 } else { c - '0' } }

