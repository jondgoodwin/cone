// ======== The Pike VM: every thread at once, one byte at a time ========
//
// The text is read once, left to right. Each byte moves every live thread (a
// state with the capture positions it has seen) to the next list, in priority
// order; a state is in a list once, so work for a byte is bounded by the number
// of states, and a search takes time proportional to (states x text). Threads
// are kept in the order a backtracking engine would try them, which is what
// makes the first match found the one Perl-style engines give (leftmost-first).

const noPos = 0xFFFFFFFFFFFFFFFFusize;
const restoreBit = 0x80000000u32;
// The bounded backtracker's visited bits: 32 KB, RE2's figure. States x positions within this many
// bits are answered by the backtracker (when groups are wanted), others by the Pike VM.
const backtrackBudget = 262144usize;

// A step to take in an epsilon closure: explore a state, or put a slot back
struct Frame {
  pub tag: u32;
  pub val: usize;
}

// The scratch of a search. Two lists of threads share the arrays, the second
// list a program's states further on. Built for one program and slot count.
struct Pike {
  pub n: usize;
  pub nslots: usize;
  pub dense: List[u32];
  pub sparse: List[u32];
  pub lens: List[usize];
  pub slots: List[usize];
  pub stack: List[Frame];
  pub cur: List[usize];
  // The slots of the match a search found
  pub result: List[usize];
  // How many slots the Pike run in progress keeps (the whole match's two, or all)
  pub act: usize;
  // The arrays above are filled when the first Pike run needs them
  pub ready: bool;
  // The bounded backtracker's visited bits: one for each state at each position
  pub visited: List[u64];

  pub fn start(prog: &Program, nslots: usize) Pike {
    let n = prog.insts.len();
    var lens = List[usize]();
    lens.push(0); lens.push(0);
    var cur = List[usize]();
    var result = List[usize]();
    var k = 0usize;
    while k < nslots { cur.push(noPos); result.push(noPos); k = k + 1; }
    Pike(n, nslots, List[u32](), List[u32](), lens, List[usize](), List[Frame](), cur, result, nslots, false, List[u64]())
  }

  // The working arrays of the Pike VM, made at its first use: a search the
  // backtracker answers never needs them
  fn ensure(self: &mut) {
    if ready { return; }
    ready = true;
    dense = List[u32](2 * n) <- fill 0u32;
    sparse = List[u32](2 * n) <- fill 0u32;
    slots = List[usize](2 * n * nslots) <- fill 0usize;
  }

  // Search from byte 'from' (see 'pikeRun'). With groups wanted, the bounded
  // backtracker answers whenever its visited bits fit the budget; a text too long
  // for that is searched by the Pike VM for the match's bounds only, and the
  // backtracker then finds the groups within the match.
  pub fn search(self: &mut, prog: &Program, text: &Array[u8], from: usize, earliest: bool) bool {
    if nslots <= 2 { return pikeRun(prog, text, from, earliest, nslots); }
    let tlen = text.len;
    if from <= tlen && n * (tlen - from + 1) <= backtrackBudget {
      return backtrack(prog, text, from, tlen, false);
    }
    if !pikeRun(prog, text, from, earliest, 2) { return false; }
    let s = *result[0];
    let e = *result[1];
    if n * (e - s + 1) <= backtrackBudget {
      if backtrack(prog, text, s, e, true) { return true; }
    }
    // a match too long for the bits
    pikeRun(prog, text, s, earliest, nslots)
  }

  // The bounded backtracker: the same answer as the Pike VM's, found by trying the
  // alternatives in priority order with a stack, depth first. A state at a position
  // is tried once (the first time it failed, or the search would have ended), so
  // the time is bounded by states x positions: the budget. The bytes read stop at
  // 'limit'; a match is looked for from 'from' on, or at 'from' alone if anchored.
  fn backtrack(self: &mut, prog: &Program, text: &Array[u8], from: usize, limit: usize, anchored: bool) bool {
    let ns = nslots;
    let words = (n * (limit - from + 1) + 63) / 64;
    visited.clear();
    var z = 0usize;
    while z < words { visited.push(0u64); z = z + 1; }
    var k = 0usize;
    while k < ns { cur.set(k, noPos); k = k + 1; }
    let plen = prog.prefix.len();
    var p = from;
    while p <= limit {
      if plen > 0 && !anchored {
        let at = findPrefix(text, p, prog.prefix.view());
        if at == noPos || at > limit { return false; }
        p = at;
      }
      stack.push(Frame(prog.start, p));
      while stack.len() > 0 {
        let f = stack.pop().unwrap();
        if (f.tag & restoreBit) != 0 {
          cur.set(usize.from(f.tag & 0x7FFFFFFF), f.val);
          continue;
        }
        var sid = f.tag;
        var pos = f.val;
        while true {
          let bit = (pos - from) * n + usize.from(sid);
          let word = bit / 64;
          let mask = 1u64 << u64.from(bit % 64);
          let seen = *visited[word];
          if (seen & mask) != 0u64 { break; }
          visited.set(word, seen | mask);
          let inst = &prog.insts[usize.from(sid)];
          let op = inst.op;
          if op == opByte {
            if pos < limit && text[pos] >= inst.lo && text[pos] <= inst.hi {
              pos = pos + 1;
              sid = inst.next;
            }
            else { break; }
          }
          else if op == opSparse {
            var go = false;
            if pos < limit {
              let byte = text[pos];
              var t = usize.from(inst.x);
              let end = t + usize.from(inst.y);
              while t < end {
                let tr = &prog.trans[t];
                if byte < tr.lo { break; }
                if byte <= tr.hi { sid = tr.next; pos = pos + 1; go = true; break; }
                t = t + 1;
              }
            }
            if !go { break; }
          }
          else if op == opSplit {
            stack.push(Frame(inst.x, pos));
            sid = inst.next;
          }
          else if op == opSave {
            let slot = usize.from(inst.x);
            if slot < ns {
              stack.push(Frame(restoreBit | inst.x, *cur[slot]));
              cur.set(slot, pos);
            }
            sid = inst.next;
          }
          else if op == opLook {
            if holds(inst.x, text, pos) { sid = inst.next; }
            else { break; }
          }
          else if op == opMatch {
            k = 0;
            while k < ns { result.set(k, *cur[k]); k = k + 1; }
            stack.clear();
            return true;
          }
          else { break; }
        }
      }
      if anchored { return false; }
      p = p + 1;
    }
    false
  }

  // Whether a search can end the moment it finds any match
  // 'earliest', else it runs to the leftmost-first one. The match's slots are in
  // 'result'. 'from' is where the search begins; the text before it is context
  // for the assertions.
  fn pikeRun(self: &mut, prog: &Program, text: &Array[u8], from: usize, earliest: bool, ns: usize) bool {
    ensure();
    act = ns;
    let tlen = text.len;
    var matched = false;
    var w = 0usize;
    lens.set(0, 0);
    lens.set(1, 0);
    var k = 0usize;
    while k < ns { cur.set(k, noPos); k = k + 1; }
    let plen = prog.prefix.len();
    var p = from;
    while true {
      if !matched && *lens[w] == 0 && plen > 0 {
        let at = findPrefix(text, p, prog.prefix.view());
        if at == noPos { break; }
        p = at;
      }
      if !matched {
        if ns <= 2 && prog.seed.len() > 0 { seedThreads(prog, text, w, p); }
        else { closure(prog, text, w, p, prog.start); }
      }
      if *lens[w] == 0 {
        if matched || p >= tlen { break; }
        p = p + 1;
        continue;
      }
      let nw = 1 - w;
      lens.set(nw, 0);
      var i = 0usize;
      let count = *lens[w];
      let byte = if p < tlen { text[p] } else { 0u8 };
      while i < count {
        let sid = *dense[w * n + i];
        let inst = &prog.insts[usize.from(sid)];
        let op = inst.op;
        if op == opByte {
          if p < tlen && byte >= inst.lo && byte <= inst.hi {
            enter(prog, text, w, nw, sid, p + 1, inst.next);
          }
        }
        else if op == opSparse {
          if p < tlen {
            var t = usize.from(inst.x);
            let end = t + usize.from(inst.y);
            while t < end {
              let tr = &prog.trans[t];
              if byte < tr.lo { break; }
              if byte <= tr.hi {
                enter(prog, text, w, nw, sid, p + 1, tr.next);
                break;
              }
              t = t + 1;
            }
          }
        }
        else if op == opMatch {
          let base = (w * n + usize.from(sid)) * ns;
          k = 0;
          while k < ns { result.set(k, *slots[base + k]); k = k + 1; }
          matched = true;
          if earliest { return true; }
          break;
        }
        i = i + 1;
      }
      if p >= tlen { break; }
      p = p + 1;
      w = nw;
    }
    matched
  }

  // The same as 'closure' from the start state, for a search that keeps at most the
  // whole match's slots: the states startStates found, those not in the list yet
  fn seedThreads(self: &mut, prog: &Program, text: &Array[u8], w: usize, at: usize) {
    // a thread that cannot read the byte at 'at' would die in this very step: not added
    if at >= text.len { return; }
    let byte = text[at];
    let ns = act;
    let base = w * n;
    var i = 0usize;
    let count = prog.seed.len();
    while i < count {
      if byte < *prog.seedLo[i] || byte > *prog.seedHi[i] { i = i + 1; continue; }
      let sid = *prog.seed[i];
      let si = usize.from(*sparse[base + usize.from(sid)]);
      let used = *lens[w];
      if !(si < used && *dense[base + si] == sid) {
        dense.set(base + used, sid);
        sparse.set(base + usize.from(sid), u32.from(used));
        lens.set(w, used + 1);
        if ns == 2 {
          let row = (base + usize.from(sid)) * 2;
          slots.set(row, at);
          slots.set(row + 1, noPos);
        }
      }
      i = i + 1;
    }
  }

  // Move the thread of state 'sid' (list w) along to 'next' in list nw at position at
  fn enter(self: &mut, prog: &Program, text: &Array[u8], w: usize, nw: usize, sid: u32, at: usize, next: u32) {
    let ns = act;
    let base = (w * n + usize.from(sid)) * ns;
    var k = 0usize;
    while k < ns { cur.set(k, *slots[base + k]); k = k + 1; }
    closure(prog, text, nw, at, next);
  }

  // Add state sid0 and everything it leads to without reading a byte to list w,
  // in priority order, with the slots in 'cur' (as changed by Save states on the way)
  fn closure(self: &mut, prog: &Program, text: &Array[u8], w: usize, at: usize, sid0: u32) {
    let ns = act;
    let base = w * n;
    stack.push(Frame(sid0, 0));
    while stack.len() > 0 {
      let f = stack.pop().unwrap();
      if (f.tag & restoreBit) != 0 {
        cur.set(usize.from(f.tag & 0x7FFFFFFF), f.val);
        continue;
      }
      var sid = f.tag;
      while true {
        let si = usize.from(*sparse[base + usize.from(sid)]);
        let count = *lens[w];
        if si < count && *dense[base + si] == sid { break; }
        dense.set(base + count, sid);
        sparse.set(base + usize.from(sid), u32.from(count));
        lens.set(w, count + 1);
        let inst = &prog.insts[usize.from(sid)];
        let op = inst.op;
        if op == opSplit {
          stack.push(Frame(inst.x, 0));
          sid = inst.next;
        }
        else if op == opSave {
          let slot = usize.from(inst.x);
          if slot < ns {
            stack.push(Frame(restoreBit | inst.x, *cur[slot]));
            cur.set(slot, at);
          }
          sid = inst.next;
        }
        else if op == opLook {
          if holds(inst.x, text, at) { sid = inst.next; }
          else { break; }
        }
        else if op == opFail { break; }
        else {
          // a state that reads a byte, or the match: the thread waits here
          let row = (base + usize.from(sid)) * ns;
          var k = 0usize;
          while k < ns { slots.set(row + k, *cur[k]); k = k + 1; }
          break;
        }
      }
    }
  }
}

fn isWordAt(text: &Array[u8], i: usize) bool { i < text.len && isWordByte(text[i]) }

// Whether the assertion holds between the bytes at at - 1 and at
fn holds(kind: u32, text: &Array[u8], at: usize) bool {
  if kind == lkStartText { at == 0 }
  else if kind == lkEndText { at == text.len }
  else if kind == lkStartLine { at == 0 || text[at - 1] == '\n' }
  else if kind == lkEndLine { at == text.len || text[at] == '\n' }
  else {
    let before = at > 0 && isWordAt(text, at - 1);
    let after = isWordAt(text, at);
    if kind == lkWord { before != after } else { before == after }
  }
}

// Where the bytes of prefix next occur at or after from, or noPos
fn findPrefix(text: &Array[u8], from: usize, prefix: &Array[u8]) usize {
  let m = prefix.len;
  if text.len < m { return noPos; }
  let last = text.len - m;
  let first = prefix[0];
  var i = from;
  while i <= last {
    if text[i] == first {
      var k = 1usize;
      while k < m && text[i + k] == prefix[k] { k = k + 1; }
      if k == m { return i; }
    }
    i = i + 1;
  }
  noPos
}
