// The regex package in a few lines: a pattern with named groups, a capture, and a
// replacement that uses the groups.

mod tour;

import stdio use *;
import collections use *;
import regex;

fn main() i32 {
  match regex.Regex.parse("(?P<year>[0-9]{4})-(?P<month>[0-9]{2})") {
    case let Ok(re) {
      match re.captures("due 2026-11, paid 2026-12") {
        case let Some(c) { printStr(c.named("year").unwrap()); printStr("\n"); }
        case is None {}
      }
      printStr(re.replaceAll("2026-11 and 2026-12", "$month/$year").view());
      printStr("\n");
    }
    case let Err(e) {
      let m = String() <- e;
      printStr(m.view());
      return 1i32;
    }
  }
  0i32
}
