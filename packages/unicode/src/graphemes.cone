// Extended grapheme clusters (UAX #29, "what a user sees as one character"), over
// the graphemeStarts and graphemeVals tables of unicodetables.cone. The same module
// as unicode.cone: it uses that file's runOf. Word and sentence breaks are not here.
//
// graphemes(s)   a cursor over the clusters of s, each a borrowed &str slice of s
//                (no allocation), as core's lines and splitOn give theirs
// graphemeCount  how many clusters s has
// nextGraphemeBoundary(s, at)   the byte index where the cluster that starts at 'at'
//                ends, for an editor's cursor movement; s.len() when it runs to the end
//
// The rules are those of the table's version, GB3 to GB13 and GB999 with the
// Indic conjunct rule GB9c (Devanagari and the other scripts whose consonants are
// joined by a virama). GB9c is UAX #29 revision 49's (Unicode 18.0.0):
// \p{InCB=Linker} \p{InCB=Extend}* × \p{InCB=Consonant}, with nothing asked of what
// stands before the Linker (earlier revisions also asked for a Consonant there). A
// Linker inside the Extend run starts the match again, so the state below treats it as
// a fresh Linker. A cluster is never empty, so a text of n code points has
// between 1 and n clusters and the empty text has none. The default rules only: no
// tailoring (so a Hangul or Indic syllable is as the default says), and a byte that
// is no well-formed UTF-8 is not special (a &str has none).

// Property byte of a code point: the low four bits are Grapheme_Cluster_Break
const gcbOther = 0u8;
const gcbCR = 1u8;
const gcbLF = 2u8;
const gcbControl = 3u8;
const gcbExtend = 4u8;
const gcbZWJ = 5u8;
const gcbRegional = 6u8;
const gcbPrepend = 7u8;
const gcbSpacingMark = 8u8;
const gcbL = 9u8;
const gcbV = 10u8;
const gcbT = 11u8;
const gcbLV = 12u8;
const gcbLVT = 13u8;

fn graphemeProps(x: u32) u8 {
  if x < 0x80u32 {
    // ASCII: CR, LF and the controls; nothing else is special
    if x == 13u32 { return gcbCR; }
    if x == 10u32 { return gcbLF; }
    if x < 32u32 || x == 127u32 { return gcbControl; }
    return gcbOther;
  }
  graphemeVals[runOf(&graphemeStarts, x)]
}

fn utf8Width(b: u8) usize inline {
  if b < 0xC0u8 { 1usize }
  else if b < 0xE0u8 { 2usize }
  else if b < 0xF0u8 { 3usize }
  else { 4usize }
}

// The code point at byte i, which takes w bytes (clamped by the caller to the text)
fn codeAt(b: &Array[u8], i: usize, w: usize) u32 inline {
  let b0 = u32.from(b[i]);
  if w == 1usize { b0 }
  else if w == 2usize { ((b0 & 0x1Fu32) << 6u32) | (u32.from(b[i + 1usize]) & 0x3Fu32) }
  else if w == 3usize {
    ((b0 & 0x0Fu32) << 12u32) | ((u32.from(b[i + 1usize]) & 0x3Fu32) << 6u32)
      | (u32.from(b[i + 2usize]) & 0x3Fu32)
  }
  else {
    ((b0 & 0x07u32) << 18u32) | ((u32.from(b[i + 1usize]) & 0x3Fu32) << 12u32)
      | ((u32.from(b[i + 2usize]) & 0x3Fu32) << 6u32) | (u32.from(b[i + 3usize]) & 0x3Fu32)
  }
}

// Whether no break falls between a code point of Grapheme_Cluster_Break g0 and one
// of g1, by the pair rules GB3 to GB9b alone (the rules that look at one pair)
fn pairJoins(g0: u8, g1: u8) bool inline {
  if g0 == gcbCR && g1 == gcbLF { return true; }                     // GB3
  if g0 >= gcbCR && g0 <= gcbControl { return false; }               // GB4
  if g1 >= gcbCR && g1 <= gcbControl { return false; }               // GB5
  if g0 == gcbL && (g1 == gcbL || g1 == gcbV || g1 == gcbLV || g1 == gcbLVT) { return true; }   // GB6
  if (g0 == gcbLV || g0 == gcbV) && (g1 == gcbV || g1 == gcbT) { return true; }                 // GB7
  if (g0 == gcbLVT || g0 == gcbT) && g1 == gcbT { return true; }                                // GB8
  if g1 == gcbExtend || g1 == gcbZWJ || g1 == gcbSpacingMark { return true; }                   // GB9, GB9a
  g0 == gcbPrepend                                                                              // GB9b
}

// The byte index where the grapheme cluster starting at byte 'at' ends: the next
// boundary after 'at'. 'at' should be a boundary (0, or what this returned before,
// or any char boundary an editor's cursor sits on): the cluster is read forward
// from there, so a char boundary inside a cluster starts a cluster of its own,
// not the rest of the one around it. s.len() when 'at' is the end or past it.
pub fn nextGraphemeBoundary(s: &str, at: usize) usize {
  let b: &Array[u8] = s;
  let n = b.len;
  if at >= n { return n; }
  var w = utf8Width(b[at]);
  if at + w > n { w = n - at; }
  let p0 = graphemeProps(codeAt(b, at, w));
  var pos = at + w;
  var g0 = p0 & 15u8;
  // GB11: 1 after an Extended_Pictographic (and its Extend run), 2 after a ZWJ that follows
  var pict = if (p0 & 16u8) != 0u8 { 1u8 } else { 0u8 };
  // GB12 and GB13: the length of the run of regional indicators so far
  var ri = if g0 == gcbRegional { 1u32 } else { 0u32 };
  // GB9c: 2 after a Linker and its run of Extend (a further Linker starts it again), else 0
  var incb = if ((p0 >> 5u8) & 3u8) == 2u8 { 2u8 } else { 0u8 };
  while pos < n {
    var w1 = utf8Width(b[pos]);
    if pos + w1 > n { w1 = n - pos; }
    let p1 = graphemeProps(codeAt(b, pos, w1));
    let g1 = p1 & 15u8;
    let ib1 = (p1 >> 5u8) & 3u8;
    let pict1 = (p1 & 16u8) != 0u8;
    var joined = pairJoins(g0, g1);
    if !joined {
      if g0 != gcbControl && g0 != gcbCR && g0 != gcbLF && g1 != gcbControl && g1 != gcbCR && g1 != gcbLF {
        if incb == 2u8 && ib1 == 1u8 { joined = true; }                         // GB9c
        else if pict == 2u8 && pict1 { joined = true; }                         // GB11
        else if g0 == gcbRegional && g1 == gcbRegional && (ri & 1u32) == 1u32 { joined = true; }   // GB12, GB13
      }
    }
    if !joined { break; }
    // The state past p1
    if pict1 { pict = 1u8; }
    else if pict == 1u8 && g1 == gcbExtend { pict = 1u8; }
    else if pict == 1u8 && g1 == gcbZWJ { pict = 2u8; }
    else { pict = 0u8; }
    ri = if g1 == gcbRegional { ri + 1u32 } else { 0u32 };
    if ib1 == 2u8 { incb = 2u8; }
    else if ib1 != 3u8 { incb = 0u8; }
    g0 = g1;
    pos = pos + w1;
  }
  pos
}

// A cursor over the extended grapheme clusters of a text: 'next' gives each as a
// borrow of the text, and None after the last. The text may not change while the
// cursor is used.
pub struct Graphemes['a] is Iterator[&str] {
  text: &'a str;
  pos: usize;

  pub fn next(self: &mut) Option[&'a str] inline {
    let b: &Array[u8] = text;
    if pos >= b.len { return None; }
    let start = pos;
    pos = nextGraphemeBoundary(text, start);
    Some[&str](&b[start..<pos] as &str)
  }
}

// The grapheme clusters of s, in order: 'each g in graphemes(s)'. Together they are
// exactly s.
pub fn graphemes(s: &str) Graphemes inline { Graphemes(s, 0usize) }

// How many grapheme clusters s has (0 for the empty text)
pub fn graphemeCount(s: &str) usize {
  var n = 0usize;
  var pos = 0usize;
  let len = s.len();
  while pos < len {
    pos = nextGraphemeBoundary(s, pos);
    n += 1usize;
  }
  n
}
