// The Zone of an IANA zone name, or None if the package holds no such zone. Use it
// when zonedata.named answers NoSource
pub fn zone(name: &str) Option[Zone] {
  match find(name) {
    case let Some(bytes) {
      match Zone.fromTzif(bytes) {
        case let Ok(z) { Some[Zone](z) }
        case let Err(e) { None }
      }
    }
    case is None { None }
  }
}
