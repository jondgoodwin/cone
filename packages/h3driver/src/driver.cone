// The Driver: its tables, the completions it is handed, and the turn that
// moves each connection along (see the package's header).
//
// How it is built. Listeners and connections are records in two GenPools;
// each connection's streams are records in a GenPool of its own, found
// from a stream's number by a Dict (the stream map: the number is HTTP/3's
// and QUIC's alike). A ConnId or ReqId is a record's cell and generation, so
// an id kept after its record went names nothing. Every operation the
// driver submits carries a token: the package's mark in the top byte, the
// driver's number in the next, then the operation's kind, and the record's
// generation (its low 16 bits) and cell: a completion for a record that has
// gone, or whose cell another occupies now, is the driver's (true) and is
// dropped, its buffer going home. A completion, a call or a wake time marks
// a connection dirty; 'turn' drives each: QUIC's events, the bytes HTTP/3 has
// credit for, HTTP/3's events, what HTTP/3 writes, the streams QUIC may open
// now, the datagrams QUIC makes, round after round until nothing moves. A
// connection whose QUIC and HTTP/3 have both closed answers what is left on
// it, sends its one Closed, and goes once its sends are answered.

// A token: the mark (top byte), the driver's number (the next), the kind
// (the next), the record's generation, low 16 bits (the next two), its cell
// (the low three)
const tokMark = 0x33u64;
const markShift = 56u64;
const numberShift = 48u64;
const kindShift = 40u64;
const genShift = 24u64;
const genMask = 0xFFFFu64;
const indexMask = 0xFFFFFFu64;
const kRecvL = 1u64;          // a listener's receive: the listener
const kRecvC = 2u64;          // a client connection's receive: the connection
const kSend = 3u64;           // a connection's send: the connection
const kVerify = 4u64;         // a client's certificate check on the blocking pool: the connection

const noBound = 0xFFFFFFFFFFFFFFFFusize;   // a Chain bounded elsewhere (QUIC's window, the watermarks)

// THE BLOCK BUDGET (the package's header). A stream's records in this driver
// and in HTTP/3 each hold a block from the first byte, so a stream costs a
// smallest block twice; a connection's other streams beyond its requests are
// the control stream, QPACK's two, and QUIC's sixteen unidirectional.
const streamExtras = 20usize;
const streamLayers = 2usize;

// The part of the pool's maxBytes that peers' blocks may take (iobuf's try
// bank: three quarters of maxBytes at the default, a quarter held back)
fn poolShare() usize {(stats().maxBytes / 4usize) * 3usize}

// The bytes of blocks beyond their bytes that a connection's streams may
// hold: its share of the pool
fn blockBudget(share: usize, maxConnections: u32) usize {
  var conns = usize.from(maxConnections);
  if conns == 0usize {conns = 1usize;}
  share / conns
}

const maxRounds = 16usize;                 // rounds of one connection's turn before it waits for the next
const minRecvSize = 1500usize;             // a receive's buffer at the least: an Ethernet frame's payload
const unread = 0xFFFFFFFFFFFFFFFFu64;      // a new server connection's IDs: read at once, whatever quic's epoch

// A listening UDP socket and the TLS context of its connections
struct Lst {
  handle: Handle;
  ctx: quic.Context;
  localQ: quic.Addr;
  recvSize: usize;
  token: u64;
  accepting: bool;          // new connections are taken (stopListening ends it)
  conns: u32;               // its connections, which send on its socket
  h3cfg: http3.Config;      // its connections' HTTP/3 (maxRequestStreams the context's stream limit)
  owed: u32;                // receives the buffer pool refused a buffer for: made again by a later turn
}

// A connection: the value (its QUIC, its HTTP/3, its streams: h3conn.cone) and what the driver keeps of it
struct Conn {
  core: H3Conn;
  listener: RecId;           // a server's listener
  handle: Handle;           // the socket it sends on: its own (a client's) or its listener's
  peer: SocketAddr;
  ids: List[CidKey];        // a server's: the keys the routing table has for it
  idEpoch: u64;             // ...as of this idsEpoch
  recvsOut: u32;            // a client's socket's receives in flight
  sendsOut: u32;            // its datagrams in flight to the kernel
  dirty: bool;
  freeing: bool;            // its end has been taken up (its route keys are gone)
}

// The driver of HTTP/3 connections on one Loop (see the package's header, THE DRIVER)
pub struct Driver {
  tokBase: u64;
  client: Result[quic.Context, quic.QuicError];   // every client connection's TLS context, or why there is none
  h3cfg: http3.Config;
  recvDepth: u32;
  sendDepth: u32;
  sendWatermark: u64;
  maxConnections: u32;
  maxWaiting: u32;
  wakeStep: Duration;
  clientIdLimit: u64;           // a client connection's stream numbers stay under this (quic.Config.streamIdLimit)
  handshakeTimeout: Duration;   // the handshake deadline of the server Contexts the plug-in makes (cfg.transport's)
  share: usize;                // the pool's bytes the connections share (THE BLOCK BUDGET), as the pool was when this was made
  listeners: Listeners;
  conns: Connections;
  routes: Dict[CidKey, RecId];   // a server's: every connection ID to its connection
  dirty: List[u32];
  ready: Deque[Event];          // events, until takeEvents moves them
  nextWake: Instant;
  lossPerMille: u32;
  lossState: u64;
  st: DriverStats;

  // A driver whose connections take cfg's bounds. Its client connections'
  // TLS context is made from cfg.quic now; a failure there is every
  // connect's answer
  pub fn make(cfg: Config) Driver {
    let qcfg, hcfg, recvDepth, sendDepth, sendWatermark, maxConnections, maxWaiting, wakeStep =
      cfg.(transport, protocol, recvDepth, sendDepth, sendWatermark, maxConnections, maxWaiting, wakeStep);
    let number = u64.from(numberNext.add(1u32) & 0xFFu32);
    let idLimit = qcfg.streamIdLimit;
    let hsTimeout = qcfg.handshakeTimeout;
    Driver(tokBase: (tokMark << markShift) | (number << numberShift),
      client: quic.Context.client(qcfg), h3cfg: hcfg, recvDepth: recvDepth, sendDepth: sendDepth,
      sendWatermark: sendWatermark, maxConnections: maxConnections, maxWaiting: maxWaiting,
      wakeStep: wakeStep, clientIdLimit: idLimit, handshakeTimeout: hsTimeout, share: poolShare(), listeners: Listeners(4usize), conns: Connections(16usize),
      routes: Dict[CidKey, RecId](), dirty: List[u32](), ready: Deque[Event](),
      nextWake: forever(), lossPerMille: 0u32, lossState: 0u64, st: DriverStats.zero())
  }

  // Its counters, as they are now
  pub fn stats(self: &) DriverStats {st}

  // Connections it holds
  pub fn live(self: &) usize {conns.len()}

  // Whether a token is one of this driver's operations
  pub fn owns(self: &, token: u64) bool {(token >> numberShift) == (tokBase >> numberShift)}

  // Drop perMille of every thousand datagrams this driver would send, by a
  // fixed pseudo-random sequence from seed (see the package's header, LOSS)
  pub fn injectLoss(self: &mut, perMille: u32, seed: u64) {
    lossPerMille = perMille;
    lossState = if seed == 0u64 {0x9E3779B97F4A7C15u64} else {seed};
  }

  fn tok(self: &, kind: u64, s: RecId) u64 {
    tokBase | (kind << kindShift) | ((u64.from(s.gen) & genMask) << genShift) | (u64.from(s.index) & indexMask)
  }

  // ---------------------------------------------------------------------------
  // Hosting: the four calls aio's I/O thread makes, and the events
  // ---------------------------------------------------------------------------

  // Its turn: every connection a completion or a call touched, or whose wake
  // time has come, moved as far as it can go
  pub fn turn(self: &mut, lp: &mut Loop) {
    let now = Instant.now();
    var d = 0usize;
    while d < dirty.len() {
      let i = *dirty[d];
      d = d + 1usize;
      if conns.isLive(i) {self.drive(lp, i, now, false);}
    }
    dirty.clear();
    var next = forever();
    var k = 0usize;
    while k < conns.bound() {
      let cell = u32.from(k);
      k = k + 1usize;
      if !conns.isLive(cell) {continue;}
      let c = conns.borrowMutAt(cell).unwrap();
      if c.core.wantsTurn() {
        self.drive(lp, cell, now, false);
      } else if c.core.wake <= now {
        self.drive(lp, cell, now, true);
      }
      if conns.isLive(cell) {
        let c2 = conns.borrowAt(cell).unwrap();
        if c2.core.wantsTurn() {next = Instant();}
        else if c2.core.wake < next {next = c2.core.wake;}
      }
    }
    // A listener owed receives (the pool refused their buffers) makes them
    // again as soon as the pool gives one, and looks again a step later else
    k = 0usize;
    while k < listeners.bound() {
      let cell = u32.from(k);
      k = k + 1usize;
      if !listeners.isLive(cell) {continue;}
      let l = listeners.borrowMutAt(cell).unwrap();
      if l.owed == 0u32 {continue;}
      if !lp.isOpen(l.handle) {
        l.owed = 0u32;
        continue;
      }
      while listeners.borrowAt(cell).unwrap().owed > 0u32 {
        let l1 = listeners.borrowAt(cell).unwrap();
        match IoBuf.tryMake(l1.recvSize) {
          case var Some(b) {
            let lsock = l1.handle;
            let ltok = self.tok(kRecvL, listeners.slotAt(cell));
            lp.submit(Op.RecvFrom(lsock, b), Target.Here(ltok));
            let l2 = listeners.borrowMutAt(cell).unwrap();
            l2.owed = l2.owed - 1u32;
          }
          else {break;}
        }
      }
      if listeners.borrowAt(cell).unwrap().owed > 0u32 && now + wakeStep < next {next = now + wakeStep;}
    }
    nextWake = next;
  }

  // A completion: true when its token is this driver's, which takes what it
  // needs from it (a receive's datagram, a send's end, the verifier's answer).
  // BATCHING (RECEIVES): a receive's answer is one datagram, routed and
  // started again here; a batched receive (recvmmsg, GRO, URO) would route
  // each of its datagrams in turn at the same two places (route for a
  // listener's, handleInput for a client's) and start one batch again
  pub fn complete(self: &mut, lp: &mut Loop, comp: &mut Completion) bool {
    if !self.owns(comp.token) {return false;}
    let kind = (comp.token >> kindShift) & 0xFFu64;
    let cell = u32.from(comp.token & indexMask);
    let gen = (comp.token >> genShift) & genMask;
    let now = Instant.now();
    if kind == kRecvL {
      if !listeners.isLive(cell) || (u64.from(listeners.slotAt(cell).gen) & genMask) != gen {return true;}
      let cancelled = comp.status == diagCancelled();
      if comp.isDone() {
        st.datagramsIn = st.datagramsIn + 1u64;
        st.bytesIn = st.bytesIn + u64.from(comp.buf.len());
        let from = comp.peer;
        self.route(lp, cell, datagramOf(comp), &from, now);
      } else if !cancelled {
        st.recvFailed = st.recvFailed + 1u64;
      }
      let l = listeners.borrowMutAt(cell).unwrap();
      if !cancelled && lp.isOpen(l.handle) {
        // A receive serves every connection of the listener, so a pool that
        // refuses its buffer (iobuf's tryMake) ends none of them: the receive
        // is owed, and a later turn makes it when the pool has room again
        match IoBuf.tryMake(l.recvSize) {
          case var Some(b) {lp.submit(Op.RecvFrom(l.handle, b), Target.Here(comp.token));}
          else {
            l.owed = l.owed + 1u32;
            st.bufferRefused = st.bufferRefused + 1u64;
          }
        }
      }
      return true;
    }
    if !conns.isLive(cell) || (u64.from(conns.slotAt(cell).gen) & genMask) != gen {return true;}
    let c = conns.borrowMutAt(cell).unwrap();
    if kind == kRecvC {
      c.recvsOut = c.recvsOut - 1u32;
      let cancelled = comp.status == diagCancelled();
      if comp.isDone() {
        st.datagramsIn = st.datagramsIn + 1u64;
        st.bytesIn = st.bytesIn + u64.from(comp.buf.len());
        if !c.core.ended && comp.buf.len() > 0usize {
          c.core.datagramIn(datagramOf(comp), now);
          self.markDirty(cell);
        }
      } else if !cancelled {
        st.recvFailed = st.recvFailed + 1u64;
      }
      if !cancelled && !c.core.ended {
        c.recvsOut = c.recvsOut + 1u32;
        let size = recvSizeOf(c.core.server, self.clientUdp());
        match IoBuf.tryMake(size) {
          case var Some(b) {lp.submit(Op.RecvFrom(c.handle, b), Target.Here(comp.token));}
          else {
            // The pool (iobuf's tryMake) is within its reserve of maxBytes:
            // this connection ends Overloaded, its buffers going home
            c.recvsOut = c.recvsOut - 1u32;
            st.bufferRefused = st.bufferRefused + 1u64;
            c.core.h.starve("the buffer pool is full (iobuf maxBytes): no buffer for a receive");
            c.core.work = true;
            self.markDirty(cell);
          }
        }
      }
    } else if kind == kSend {
      c.sendsOut = c.sendsOut - 1u32;
      if !comp.isDone() && comp.status != diagCancelled() {st.sendFailed = st.sendFailed + 1u64;}
      self.markDirty(cell);
    } else if kind == kVerify {
      c.core.callDone(comp, now);
      self.markDirty(cell);
    }
    true
  }

  // The latest the loop's poll may wait: now while work or events are ready,
  // else the earliest connection's wake time (forever when none has one)
  pub fn wakeAt(self: &) Instant {
    if dirty.len() > 0usize || ready.len() > 0usize {return Instant();}
    nextWake
  }

  // Its end, the Loop still alive: every connection closed now (its requests
  // Failed, its Closed told), every socket closed
  pub fn end(self: &mut, lp: &mut Loop) {
    self.abortAll(lp);
    var k = 0usize;
    while k < conns.bound() {
      let cell = u32.from(k);
      k = k + 1usize;
      if conns.isLive(cell) {self.free(lp, cell);}
    }
    k = 0usize;
    while k < listeners.bound() {
      let cell = u32.from(k);
      k = k + 1usize;
      if listeners.isLive(cell) {
        lp.close((listeners.borrowAt(cell).unwrap()).handle);
        listeners.removeAt(cell);
      }
    }
  }

  // The events made so far, moved to out, in order: how many
  pub fn takeEvents(self: &mut, out: &mut List[Event]) usize {
    var n = 0usize;
    while true {
      match ready.popFront() {
        case let Some(e) {out.push(e);}
        case is None[Event] {break;}
      }
      n = n + 1usize;
    }
    n
  }

  // A turn, then the events: how many
  pub fn pump(self: &mut, lp: &mut Loop, out: &mut List[Event]) usize {
    self.turn(lp);
    self.takeEvents(out)
  }

  // For a thread that drives nothing else: pump, poll the loop until the
  // earlier of 'until' and wakeAt (not at all while events are ready), hand
  // the driver each answer (one not its own is dropped, counted), pump
  pub fn poll(self: &mut, lp: &mut Loop, until: Instant, out: &mut List[Event]) usize {
    var n = self.pump(lp, out);
    var limit = until;
    let w = self.wakeAt();
    if w < limit {limit = w;}
    if n > 0usize {limit = Instant();}
    var cs = List[Completion]();
    lp.poll(limit, &mut cs);
    var k = 0usize;
    while k < cs.len() {
      if !self.complete(lp, &mut cs[k]) {st.unclaimed = st.unclaimed + 1u64;}
      k = k + 1usize;
    }
    n + self.pump(lp, out)
  }

  // ---------------------------------------------------------------------------
  // Connections
  // ---------------------------------------------------------------------------

  // A client connection to addr, the server's certificate checked against
  // serverName: its id, or why it could not be begun (see the package's
  // header, CONNECTIONS)
  pub fn connect(self: &mut, lp: &mut Loop, addr: SocketAddr, serverName: &str, token: u64) Result[ConnId, Failure] {
    st.connects = st.connects + 1u64;
    if conns.len() >= usize.from(maxConnections) {
      return Err[ConnId, Failure](Failure.make(Stage.Limit, 0u32, ErrorKind.Refused, "maxConnections reached"));
    }
    let Some(remoteQ) = quicAddr(&addr) else {
      return Err[ConnId, Failure](Failure.make(Stage.Connect, 0u32, ErrorKind.Unsupported, "only IPv4 addresses (quic's Addr)"));
    };
    let bindAt = if addr.isLoopback() {SocketAddr.localhost(0u16)} else {SocketAddr.v4(0u8, 0u8, 0u8, 0u8, 0u16)};
    let handle = lp.bindUdp(bindAt)?;
    var localQ = quic.Addr.v4(0u8, 0u8, 0u8, 0u8, 0u16);
    match lp.localAddr(handle) {
      case let Ok(a) {
        match quicAddr(&a) {
          case let Some(q) {localQ = q;}
          case is None[quic.Addr] {}
        }
      }
      case let Err(e) {}
    }
    let now = Instant.now();
    match self.newClient(serverName, &localQ, &remoteQ, now) {
      case let Ok(q) {
        var core = H3Conn.forClient(q, h3cfg, token, blockBudget(share, maxConnections), wakeStep, clientIdLimit, now);
        core.sendWatermark = sendWatermark;
        let s = conns.add(Conn(core: core, listener: RecId.none(), handle: handle, peer: addr,
          ids: List[CidKey](), idEpoch: 0u64, recvsOut: 0u32, sendsOut: 0u32, dirty: false, freeing: false));
        let size = recvSizeOf(false, self.clientUdp());
        var r = 0u32;
        while r < recvDepth {
          match IoBuf.tryMake(size) {
            case var Some(b) {
              let rtok = self.tok(kRecvC, s);
              lp.submit(Op.RecvFrom(handle, b), Target.Here(rtok));
            }
            else {
              // The pool (iobuf's tryMake) is within its reserve of maxBytes:
              // no connection is made; the receives posted are cancelled with
              // the socket, and their completions find no connection
              st.bufferRefused = st.bufferRefused + 1u64;
              lp.close(handle);
              conns.removeAt(s.index);
              return Err[ConnId, Failure](Failure.make(Stage.Connect, 0u32, ErrorKind.Overloaded, "the buffer pool is full (iobuf maxBytes): no buffer for a receive"));
            }
          }
          r = r + 1u32;
        }
        conns.borrowMut(s).unwrap().recvsOut = recvDepth;
        self.markDirty(s.index);
        return Ok[ConnId, Failure](ConnId(s.index, s.gen));
      }
      case let Err(e) {
        lp.close(handle);
        return Err[ConnId, Failure](Failure.from(e));
      }
    }
  }

  // A client's QUIC connection, from the driver's client context
  fn newClient(self: &mut, serverName: &str, localQ: &quic.Addr, remoteQ: &quic.Addr,
      now: Instant) Result[quic.Connection, quic.QuicError] {
    match &client {
      case let Ok(ctx) {return quic.Connection.client(ctx, serverName, localQ, remoteQ, now);}
      case let Err(e) {return Err[quic.Connection, quic.QuicError](e.clone());}
    }
  }

  // The largest UDP payload a client connection takes
  fn clientUdp(self: &) usize {
    match &client {
      case let Ok(ctx) {return ctx.config().maxUdpPayload;}
      case let Err(e) {}
    }
    quic.defaultMaxUdpPayload
  }

  // A server's UDP socket at addr, its connections made with ctx (a server's
  // Context: its certificate and key, and QUIC's bounds; HTTP/3's
  // maxRequestStreams is taken from its maxStreamsBidi): its id, or why not
  pub fn listen(self: &mut, lp: &mut Loop, addr: SocketAddr, ctx: quic.Context, token: u64) Result[ListenerId, Failure] {
    if !ctx.isServer() {
      return Err[ListenerId, Failure](Failure.make(Stage.Tls, 0u32, ErrorKind.Unsupported, "listen takes a server's Context"));
    }
    let handle = lp.bindUdp(addr)?;
    var localQ = quic.Addr.v4(0u8, 0u8, 0u8, 0u8, 0u16);
    match lp.localAddr(handle) {
      case let Ok(a) {
        match quicAddr(&a) {
          case let Some(q) {localQ = q;}
          case is None[quic.Addr] {}
        }
      }
      case let Err(e) {}
    }
    var hc = h3cfg;
    hc.maxRequestStreams = usize.from(ctx.config().maxStreamsBidi);
    let size = recvSizeOf(true, ctx.config().maxUdpPayload);
    let s = listeners.add(Lst(handle, ctx, localQ, size, token, true, 0u32, hc, 0u32));
    var r = 0u32;
    while r < recvDepth {
      match IoBuf.tryMake(size) {
        case var Some(b) {lp.submit(Op.RecvFrom(handle, b), Target.Here(self.tok(kRecvL, s)));}
        else {
          // The pool (iobuf's tryMake) is within its reserve of maxBytes: no
          // listener is made
          st.bufferRefused = st.bufferRefused + 1u64;
          lp.close(handle);
          listeners.removeAt(s.index);
          return Err[ListenerId, Failure](Failure.make(Stage.Connect, 0u32, ErrorKind.Overloaded, "the buffer pool is full (iobuf maxBytes): no buffer for a receive"));
        }
      }
      r = r + 1u32;
    }
    Ok[ListenerId, Failure](ListenerId(s.index, s.gen))
  }

  // A listener's address (its port, when it was bound to port 0)
  pub fn localAddr(self: &, lp: &Loop, l: ListenerId) Result[SocketAddr, IoError] {
    match listeners.borrow(RecId(l.index, l.gen)) {
      case let Some(p) {lp.localAddr(p.handle)}
      else {Err[SocketAddr, IoError](IoError.ofKind(IoErrorKind.InvalidInput))}
    }
  }

  // Take no more connections on a listener; its socket closes once the
  // connections on it have ended. False for a listener that has gone
  pub fn stopListening(self: &mut, lp: &mut Loop, l: ListenerId) bool {
    var there = false;
    match listeners.borrow(RecId(l.index, l.gen)) {
      case let Some(q) {there = true;}
      else {}
    }
    if !there {return false;}
    let p = listeners.borrowMutAt(l.index).unwrap();
    p.accepting = false;
    if p.conns == 0u32 {
      let handle = p.handle;
      lp.close(handle);
      listeners.removeAt(l.index);
    }
    true
  }

  // End a connection gracefully: a GOAWAY, what is open finishes, then the
  // close (see CONNECTIONS). False for one that has gone
  pub fn close(self: &mut, lp: &mut Loop, conn: ConnId) bool {
    if !self.connLive(conn) || conns.borrowAt(conn.index).unwrap().core.ended {return false;}
    conns.borrowMutAt(conn.index).unwrap().core.goAway();
    self.markDirty(conn.index);
    true
  }

  // End a connection now: every request on it Failed (Closed), the close
  // sent with H3_NO_ERROR
  pub fn abort(self: &mut, lp: &mut Loop, conn: ConnId) bool {
    if !self.connLive(conn) || conns.borrowAt(conn.index).unwrap().core.ended {return false;}
    let c = conns.borrowMutAt(conn.index).unwrap();
    c.core.h.abort(http3.h3NoError);
    c.core.work = true;
    self.markDirty(conn.index);
    true
  }

  // Every connection aborted and driven to its end now
  pub fn abortAll(self: &mut, lp: &mut Loop) {
    let now = Instant.now();
    var k = 0usize;
    while k < conns.bound() {
      let cell = u32.from(k);
      k = k + 1usize;
      if !conns.isLive(cell) {continue;}
      let c = conns.borrowMutAt(cell).unwrap();
      if c.core.ended {continue;}
      // Should HTTP/3 have closed already, QUIC's close goes all the same
      c.core.abortNow();
      self.drive(lp, cell, now, false);
      if conns.isLive(cell) {
        let c2 = conns.borrowMutAt(cell).unwrap();
        if !c2.core.ended {
          // QUIC had not closed (its close went, or nothing could): it ends now
          c2.core.forceEnd(now);
          self.afterTurn(lp, cell);
        }
      }
    }
  }

  // Whether a connection is open: made, and not yet ended
  pub fn isOpen(self: &, conn: ConnId) bool {
    self.connLive(conn) && !conns.borrowAt(conn.index).unwrap().core.ended
  }

  // Whether a client connection takes new requests: open, its QUIC not
  // closed, and no GOAWAY received (a request made now is not refused at once)
  pub fn takesRequests(self: &, conn: ConnId) bool {
    if !self.connLive(conn) {return false;}
    let cr = conns.borrowAt(conn.index).unwrap();
    cr.core.alive() && cr.core.canRequest()
  }

  // ...and whether a request made now goes to QUIC at once: none of its
  // requests waits for the peer's stream limit (or for the handshake). A
  // client that asks this keeps the rest of its requests in its own order
  // (httpclient's scheduler), one at most waiting here
  pub fn hasRoom(self: &, conn: ConnId) bool {
    self.connLive(conn) && conns.borrowAt(conn.index).unwrap().core.hasRoom()
  }

  // A connection's other end
  pub fn peer(self: &, conn: ConnId) SocketAddr {
    if !self.connLive(conn) {return SocketAddr.localhost(0u16);}
    conns.borrowAt(conn.index).unwrap().peer
  }

  // The stream records a connection holds: its own and the peer's control
  // and QPACK streams, and every request stream QUIC still holds or whose
  // request awaits its answer (0 for one that has gone)
  pub fn streamRecords(self: &, conn: ConnId) usize {
    if !self.connLive(conn) {return 0usize;}
    conns.borrowAt(conn.index).unwrap().core.streamRecords()
  }

  // Whether id names a connection that is still there (borrow it by
  // conns.borrowAt(id.index) or borrowMutAt)
  fn connLive(self: &, id: ConnId) bool {
    if id.isNone() {return false;}
    match conns.borrow(RecId(id.index, id.gen)) {
      case let Some(c) {true}
      else {false}
    }
  }

  // ---------------------------------------------------------------------------
  // Requests
  // ---------------------------------------------------------------------------

  // A request on a client connection, its events carrying token: its id, or
  // ReqId.none() when it is Failed at once (see REQUESTS)
  pub fn request(self: &mut, lp: &mut Loop, conn: ConnId, head: RequestHead, body: BodyLength, token: u64) ReqId {
    st.requests = st.requests + 1u64;
    var usable = self.connLive(conn);
    if usable {
      let c0 = conns.borrowAt(conn.index).unwrap();
      usable = c0.core.alive();
    }
    if !usable {
      self.failNow(token, conn, Stage.Closed, ErrorKind.Closed, "the connection is closed, or not a client's");
      return ReqId.none();
    }
    let cr = conns.borrowMutAt(conn.index).unwrap();
    if !cr.core.canRequest() {
      self.failNow(token, conn, Stage.Closed, ErrorKind.Refused, "the connection takes no more requests (a GOAWAY, or its end)");
      return ReqId.none();
    }
    if cr.core.waiting() >= usize.from(maxWaiting) {
      self.failNow(token, conn, Stage.Limit, ErrorKind.Refused, "maxWaiting requests already wait for the peer's stream limit");
      return ReqId.none();
    }
    let slot = cr.core.sendRequest(head, body, token, Instant.now());
    self.markDirty(conn.index);
    ReqId(conn, slot.index, slot.gen)
  }

  // A server's response to a request: its head now, its body by sendData and
  // finish. False when the request has gone
  pub fn respond(self: &mut, req: ReqId, head: ResponseHead, body: BodyLength,
      file: &Array[u8] = srcFile(), line: u32 = srcLine()) bool {
    if !self.strmLive(req) {return false;}
    let ok = conns.borrowMutAt(req.conn.index).unwrap().core.respondTo(RecId(req.index, req.gen), head, body, file, line);
    self.markDirty(req.conn.index);
    ok
  }

  // A server's interim response (a 1xx) before its final one
  pub fn sendInterim(self: &mut, req: ReqId, head: ResponseHead,
      file: &Array[u8] = srcFile(), line: u32 = srcLine()) bool {
    if !self.strmLive(req) {return false;}
    let ok = conns.borrowMutAt(req.conn.index).unwrap().core.interimTo(RecId(req.index, req.gen), head, file, line);
    self.markDirty(req.conn.index);
    ok
  }

  // Body bytes of a request (a client's) or a response (a server's), moved
  // in: None once taken (or dropped, the request having gone), or Some(buf)
  // back when the stream holds sendWatermark bytes in QUIC or writeWatermark
  // in HTTP/3 (Writable follows when there is room)
  pub fn sendData(self: &mut, req: ReqId, buf: IoBuf, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Option[IoBuf] {
    if !self.strmLive(req) {return None;}
    self.markDirty(req.conn.index);
    conns.borrowMutAt(req.conn.index).unwrap().core.sendBody(RecId(req.index, req.gen), buf, file, line)
  }

  // The body is whole: the stream's end follows it
  pub fn finish(self: &mut, req: ReqId, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    self.finishWith(req, HttpHeaders(), file, line);
  }

  // The body is whole, these trailer fields follow it, and the stream ends
  pub fn finishWith(self: &mut, req: ReqId, trailers: HttpHeaders, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if !self.strmLive(req) {return;}
    conns.borrowMutAt(req.conn.index).unwrap().core.finishBody(RecId(req.index, req.gen), trailers, file, line);
    self.markDirty(req.conn.index);
  }

  // The program is done with n bytes of a request's body that Data events
  // handed out: HTTP/3 may hand out more (see CREDIT AND MEMORY)
  pub fn release(self: &mut, req: ReqId, n: usize) {
    if !self.connLive(req.conn) {return;}
    conns.borrowMutAt(req.conn.index).unwrap().core.releaseBody(RecId(req.index, req.gen), n);
    self.markDirty(req.conn.index);
  }

  // A server's request whose body the program no longer wants (it answered without reading the upload, or
  // dropped it): the client is asked to stop sending it, STOP_SENDING with H3_NO_ERROR (RFC 9114 section 4.1);
  // what this end sends goes on, and the request no longer waits for the client's End to be Done. The twin of
  // httpconn's Driver.stopBody. False, and nothing done, when req names no request, is a client's, or was
  // read whole already
  pub fn stopBody(self: &mut, req: ReqId) bool {
    if !self.strmLive(req) {return false;}
    let ok = conns.borrowMutAt(req.conn.index).unwrap().core.stopBodyOf(RecId(req.index, req.gen));
    self.markDirty(req.conn.index);
    ok
  }

  // Give a request up: its exchange is reset both ways
  // (H3_REQUEST_CANCELLED), and it is answered Cancelled now. False when it
  // has had its final answer
  pub fn cancel(self: &mut, lp: &mut Loop, req: ReqId) bool {
    if !self.strmLive(req) {return false;}
    let ok = conns.borrowMutAt(req.conn.index).unwrap().core.cancelRequest(RecId(req.index, req.gen), Instant.now());
    self.pull(req.conn.index);
    self.markDirty(req.conn.index);
    ok
  }

  // Whether a request's final answer is still to come
  fn strmLive(self: &, req: ReqId) bool {
    if req.isNone() || !self.connLive(req.conn) {return false;}
    conns.borrowAt(req.conn.index).unwrap().core.live(RecId(req.index, req.gen))
  }

  // A request Failed at once, never made
  fn failNow(self: &mut, token: u64, conn: ConnId, stage: Stage, kind: ErrorKind, detail: &str) {
    var e = Event.make(EventKind.Failed, token, conn, ReqId.none(), 0u64);
    e.failure = Failure.make(stage, 0u32, kind, detail);
    e.failure.unsent = true;
    e.failure.error.noResponse = true;
    st.failed = st.failed + 1u64;
    self.emit(e);
  }

  // ---------------------------------------------------------------------------
  // A connection's turn
  // ---------------------------------------------------------------------------

  fn markDirty(self: &mut, i: u32) {
    let c = conns.borrowMutAt(i).unwrap();
    if !c.dirty {
      c.dirty = true;
      dirty.push(i);
    }
  }

  fn emit(self: &mut, e: Event) {
    st.events = st.events + 1u64;
    ready.push(e);
  }

  // Move connection i as far as it can go now; byWake: its wake time asked. The connection's value does
  // the work (h3conn.cone: QUIC's events, the bytes HTTP/3 has credit for, HTTP/3's events and what it
  // writes, the datagrams QUIC makes, round after round until nothing moves); this takes its datagrams
  // to the kernel, at most sendDepth in flight (past that the connection's QUIC holds what it has until
  // one is answered: its own retransmission covers a send the kernel drops)
  fn drive(self: &mut, lp: &mut Loop, i: u32, now: Instant, byWake: bool) {
    let c0 = conns.borrowMutAt(i).unwrap();
    c0.dirty = false;
    if c0.core.ended {
      if c0.sendsOut == 0u32 {self.free(lp, i);}
      return;
    }
    c0.core.startTurn(byWake);
    st.turns = st.turns + 1u64;
    if byWake {st.wakeTurns = st.wakeTurns + 1u64;}
    // BATCHING (SENDS): each datagram is one SendTo now; a batched send (sendmmsg, GSO, USO) would gather
    // the payloads this loop takes from takeDatagram into one operation
    while conns.borrowAt(i).unwrap().sendsOut < sendDepth {
      let c = conns.borrowMutAt(i).unwrap();
      match c.core.takeDatagram(now) {
        case var Some(b) {
          let len = b.len();
          if self.lose() {
            st.lost = st.lost + 1u64;
            continue;
          }
          st.datagramsOut = st.datagramsOut + 1u64;
          st.bytesOut = st.bytesOut + u64.from(len);
          c.sendsOut = c.sendsOut + 1u32;
          let sock = c.handle;
          let to = c.peer;
          let stok = self.tok(kSend, conns.slotAt(i));
          lp.submit(Op.SendTo(sock, to, b), Target.Here(stok));
        }
        case is None[IoBuf] {break;}
      }
    }
    conns.borrowMutAt(i).unwrap().core.finishTurn(now);
    self.afterTurn(lp, i);
  }

  // Whether injectLoss drops the next datagram
  fn lose(self: &mut) bool {
    if lossPerMille == 0u32 {return false;}
    // xorshift64
    var x = lossState;
    x = x ^ (x << 13u64);
    x = x ^ (x >> 7u64);
    x = x ^ (x << 17u64);
    lossState = x;
    (x % 1000u64) < u64.from(lossPerMille)
  }

  // What a turn leaves for the driver: the value's events and counters, the verifier's work for the
  // blocking pool, a server's routing keys, and the end of the connection
  fn afterTurn(self: &mut, lp: &mut Loop, i: u32) {
    self.pull(i);
    let c = conns.borrowMutAt(i).unwrap();
    if c.core.wantsCall() {
      // (A pool that refuses the job's buffer ends QUIC; the op does nothing)
      let vop = c.core.takeCall();
      let vtok = self.tok(kVerify, conns.slotAt(i));
      lp.submit(vop, Target.Here(vtok));
    }
    self.refreshIds(i);
    let c2 = conns.borrowMutAt(i).unwrap();
    if c2.core.ended && !c2.freeing {
      // QUIC and HTTP/3 have both closed: no datagram routes to it any more, and it goes once its sends are answered
      c2.freeing = true;
      while c2.ids.len() > 0usize {
        match c2.ids.pop() {
          case let Some(key) {let gone = routes.remove(&key);}
          case is None[CidKey] {}
        }
      }
      if c2.sendsOut == 0u32 || c2.core.server {self.free(lp, i);}
    }
  }

  // The events and counters connection i's value has made, to the driver's: each event told which
  // connection it is about, and where its other end is
  fn pull(self: &mut, i: u32) {
    let cid = ConnId(i, conns.slotAt(i).gen);
    let c = conns.borrowMutAt(i).unwrap();
    let n = c.core.takeCounts();
    st.requests = st.requests + n.requests;
    st.accepted = st.accepted + n.accepted;
    st.connected = st.connected + n.connected;
    st.done = st.done + n.done;
    st.failed = st.failed + n.failed;
    st.cancelled = st.cancelled + n.cancelled;
    st.closed = st.closed + n.closed;
    st.cleanCloses = st.cleanCloses + n.cleanCloses;
    st.bufferRefused = st.bufferRefused + n.bufferRefused;
    st.budgetEnded = st.budgetEnded + n.budgetEnded;
    st.idleWakes = st.idleWakes + n.idleWakes;
    st.clamped = st.clamped + n.clamped;
    while true {
      match c.core.takeEvent() {
        case var Some(e) {
          e.conn = cid;
          if !e.req.isNone() {e.req.conn = cid;}
          if e.kind == EventKind.Accepted || e.kind == EventKind.Connected || e.kind == EventKind.Closed {e.peer = c.peer;}
          if e.kind == EventKind.Accepted {e.listener = ListenerId(c.listener.index, c.listener.gen);}
          st.events = st.events + 1u64;
          ready.push(e);
        }
        case is None[Event] {break;}
      }
    }
  }

  // A server connection's routing keys, read again when its connection IDs
  // have changed (ROUTING)
  fn refreshIds(self: &mut, i: u32) {
    let c = conns.borrowMutAt(i).unwrap();
    if !c.core.server || c.core.ended {return;}
    let epoch = c.core.idsEpoch();
    if epoch == c.idEpoch {return;}
    c.idEpoch = epoch;
    // The first key (the client's own choice) stays; the rest are read again
    while c.ids.len() > 1usize {
      match c.ids.pop() {
        case let Some(key) {let gone = routes.remove(&key);}
        case is None[CidKey] {}
      }
    }
    var bytes = List[u8]();
    let n = c.core.ids(&mut bytes);
    let slot = conns.slotAt(i);
    var k = 0usize;
    while k < n {
      match cidKey(bytes.view(), k * quic.localIdLen, quic.localIdLen) {
        case let Some(key) {
          let previous = routes.insert(key, slot);
          c.ids.push(key);
        }
        case is None[CidKey] {}
      }
      k = k + 1usize;
    }
  }

  // ---------------------------------------------------------------------------
  // A server's datagrams
  // ---------------------------------------------------------------------------

  // A datagram to listener li's socket, to the connection its Destination
  // Connection ID names, or a new connection when it is a client's Initial
  fn route(self: &mut, lp: &mut Loop, li: u32, d: &Array[u8], from: &SocketAddr, now: Instant) {
    var key = CidKey(0u64, 0u64, 0u64, 0u32);
    match destId(d) {
      case let Some(k) {key = k;}
      case is None[CidKey] {
        st.unrouted = st.unrouted + 1u64;
        return;
      }
    }
    match routes.getCopy(&key) {
      case let Some(slot) {
        var handled = false;
        match conns.borrowMut(slot) {
          case let Some(cp) {
            if !cp.core.ended {
              cp.core.datagramIn(d, now);
              handled = true;
            }
          }
          else {}
        }
        if handled {
          self.markDirty(slot.index);
          return;
        }
      }
      case is None[RecId] {}
    }
    let l = listeners.borrowMutAt(li).unwrap();
    if !isInitial(d) || !l.accepting {
      st.unrouted = st.unrouted + 1u64;
      return;
    }
    if conns.len() >= usize.from(maxConnections) {
      st.refused = st.refused + 1u64;
      return;
    }
    var peerQ = quic.Addr.v4(0u8, 0u8, 0u8, 0u8, 0u16);
    match quicAddr(from) {
      case let Some(a) {peerQ = a;}
      case is None[quic.Addr] {
        st.refused = st.refused + 1u64;
        return;
      }
    }
    match quic.Connection.accept(&l.ctx, d, &l.localQ, &peerQ, now) {
      case let Ok(q) {
        var core = H3Conn.forServer(q, l.h3cfg, l.token, blockBudget(share, maxConnections), wakeStep,
          l.ctx.config().streamIdLimit, now);
        core.sendWatermark = sendWatermark;
        let s = conns.add(Conn(core: core, listener: listeners.slotAt(li), handle: l.handle, peer: *from,
          ids: List[CidKey](), idEpoch: unread, recvsOut: 0u32, sendsOut: 0u32, dirty: false, freeing: false));
        l.conns = l.conns + 1u32;
        let c = conns.borrowMut(s).unwrap();
        // The client's own choice of ID first: its Initials carry it until
        // it has the server's
        let previous = routes.insert(key, s);
        c.ids.push(key);
        self.refreshIds(s.index);
        self.markDirty(s.index);
      }
      case let Err(e) {st.refused = st.refused + 1u64;}
    }
  }

  // Its record goes: a client's socket closes (its receives answer
  // Cancelled, and are dropped), a server's listener loses one connection
  fn free(self: &mut, lp: &mut Loop, i: u32) {
    let c = conns.borrowMutAt(i).unwrap();
    if c.core.server {
      let lrec = c.listener;
      match listeners.borrowMut(lrec) {
        case let Some(l) {
          l.conns = l.conns - 1u32;
          if !l.accepting && l.conns == 0u32 {
            let lhandle = l.handle;
            lp.close(lhandle);
            listeners.removeAt(lrec.index);
          }
        }
        else {}
      }
    } else {
      lp.close(c.handle);
    }
    while c.ids.len() > 0usize {
      match c.ids.pop() {
        case let Some(key) {let gone = routes.remove(&key);}
        case is None[CidKey] {}
      }
    }
    conns.removeAt(i);
  }
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

// A receive's buffer for a socket whose connections take maxUdp: at least an
// Ethernet frame's payload
fn recvSizeOf(server: bool, maxUdp: usize) usize {if maxUdp > minRecvSize {maxUdp} else {minRecvSize}}

// The first n bytes of a chain, at most: its first buffer moved out whole
// when it holds no more, else n bytes copied out
fn takeUpTo(ch: &mut Chain, n: usize) Option[IoBuf] {
  if ch.firstLen() <= n {
    match ch.popFront() {
      case let Some(b) {return Some[IoBuf](b);}
      case is None[IoBuf] {}
    }
    return Some[IoBuf](IoBuf());
  }
  // None, the chain as it was, when the pool refuses the copy's buffer
  var b = match IoBuf.tryMake(n) {
    case var Some(got) {got}
    else {return None;}
  };
  let got = ch.take(mem.sliceFromPartsMut(b.base(), n));
  b.setLen(got);
  Some[IoBuf](b)
}

// A received datagram's bytes, lent from the completion's buffer for the
// call they go to. Made from its parts: the checker cannot see that the
// driver (handed alongside) reaches no Completion, so 'buf.view()' there is
// refused (1339); the completion outlives the call, and nothing in it
// changes the buffer
fn datagramOf(comp: &Completion) &Array[u8] {mem.sliceFromParts(comp.buf.base(), comp.buf.len())}

// iocore's outcome number for Cancelled
fn diagCancelled() u32 {diag.outcomeCancelled}

// The first of a connection's streams waiting for QUIC to open them, of a
// kind, or RecId.none()
fn waitFront(c: &H3Conn, bidi: bool) RecId {
  if bidi {
    match c.waitBidi.peekFront() {
      case let Some(sl) {return *sl;}
      case is None[&RecId] {}
    }
  } else {
    match c.waitUni.peekFront() {
      case let Some(sl) {return *sl;}
      case is None[&RecId] {}
    }
  }
  RecId.none()
}

fn waitPop(c: &mut H3Conn, bidi: bool) {
  if bidi {
    let gone = c.waitBidi.popFront();
  } else {
    let gone = c.waitUni.popFront();
  }
}

// Whether a stream record is still there
fn hasStream(c: &H3Conn, slot: RecId) bool {
  match c.streams.borrow(slot) {
    case let Some(s) {true}
    else {false}
  }
}

