// The HTTP/3 half of actorhttp's refusedsend test: a response whose bytes the buffer pool refuses a buffer for resets
// that one stream. The test actor takes each request from the queue route, takes every 16 KiB buffer the try bank will
// give (the datagrams' 4 KiB class is left alone), and answers: the handler's write answers closed, the client's fetch
// fails, the refusal is counted, a request in hand on the same connection is answered after, and so is the next.

mod refusedsend;

import stdio use *;
import libc;
import fs;
import path use Path;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import iobuf use IoBuf, stats;
import iocore use SocketAddr;
import http use *;
import httpclient;
import tls;
import actors;
import actorhttp use HttpClient, Server, ServerConfig, Exchange, FetchError, HttpRoutes;
import h3driver;

fn yes(b: bool) &str {if b {"yes"} else {"NO"}}

fn certs(name: &str) Path {
  var p = String.from("../../../../../tls/tests/certs/");
  p.append(name);
  Path.fromString(p)
}

fn readText(name: &str) String {
  var out = String();
  let file = certs(name);
  match fs.readFile(&file) {
    case var Ok(r) {out <-> r;}
    case let Err(e) {}
  }
  out
}

fn url(port: u16, path: &str) String {
  var u = String.from("https://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u
}

fn client(port: u16) HttpClient {
  var cfg = httpclient.Config.make();
  cfg.maxRetries = 0u32;
  cfg.tlsConfig.verify = tls.Verifier.roots(readText("ca.pem").view());
  cfg.tlsConfig.offline = true;
  cfg.http3 = Some[&fn(t: &tls.ClientConfig) Uni[httpclient.Http3]](&h3driver.plugin);
  cfg.http3Origins.push(url(port, ""));
  HttpClient.make(cfg, actorhttp.defaultMaxBody)
}

fn piece() String {
  var s = String.withCapacity(1048576usize);
  var i = 0usize;
  while i < 1048576usize {
    s.appendByte(97u8);
    i = i + 1usize;
  }
  s
}

actor Taker {
  server: Server;

  pub async fn open(self, cfg: ServerConfig, var ports: Sender[u16]) {
    let r = await actorhttp.listen(SocketAddr.localhost(0u16), cfg);
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {server <-> *ok;}
      case let &mut Err(e) {printStr("listen failed\n"); libc.exit(1i32);}
    }
    ports.send(server.port());
  }

  // /nap is kept until /fill has been answered. Reports whether /fill's write answered closed
  pub async fn serve(self, want: u32, var done: OneshotSender[u64]) {
    var kept = List[Exchange]();
    var held = List[IoBuf]();
    var left = want;
    var report = 0u64;
    var pins = List[IoBuf]();
    match IoBuf.tryMake(4096usize) {case var Some(b) {pins.push(b);} else {}}
    match IoBuf.tryMake(65536usize) {case var Some(b) {pins.push(b);} else {}}
    while left > 0u32 {
      left = left - 1u32;
      match await server.next() {
        case var Ok(got) {
          var ex = got;
          let p = String.from(ex.request.path());
          if p.view() == "/nap" {
            kept.push(ex);
          } else if p.view() == "/fill" {
            while true {
              match IoBuf.tryMake(16384usize) {
                case var Some(b) {held.push(b);}
                else {break;}
              }
            }
            ex.start(ResponseHead.make(200u16), BodyLength.unsized());
            let w = await ex.write(piece());
            held = List[IoBuf]();
            report = match w {
              case is Ok {0u64}
              case is Err {1u64}
            };
          } else {
            ex.text(200u16, "hello");
          }
        }
        case let Err(e) {break;}
      }
    }
    while kept.len() > 0usize {
      var ex = kept.pop().unwrap();
      ex.text(200u16, "rested");
    }
    done.send(report);
  }

  pub async fn count(self, var done: OneshotSender[u64]) {done.send(await server.refusedBuffers());}

  pub async fn stop(self) {server.close();}
}

actor Fetch {
  client: HttpClient;

  // 'want' empty: the fetch is to fail
  pub async fn run(self, u: String, want: String, var done: OneshotSender[u64]) {
    let r = await client.get(u.view());
    var ok = false;
    match &r {
      case let &Ok(x) {ok = x.status == 200u16 && x.version == Version.Http3 && x.body.view() == want.view();}
      case let &Err(e) {ok = want.len() == 0usize;}
    }
    done.send(if ok {1u64} else {0u64});
  }
}

fn fetch(c: &HttpClient, u: String, want: &str) OneshotReceiver[u64] {
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  Fetch(c.clone()).run(u, String.from(want), tx);
  rx
}

fn say(what: &str, ok: bool) {
  printStr("HTTP/3: ");
  printStr(what);
  printStr(": ");
  printStr(yes(ok));
  printStr("\n");
}

fn serving(taker: &Taker, want: u32) OneshotReceiver[u64] {
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  taker.serve(want, tx);
  rx
}

fn counted(taker: &Taker) u64 {
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  taker.count(tx);
  rx.recv() || 0u64
}

fn main() i32 {
  initAll();
  var ptx: Sender[u16];
  var prx: Receiver[u16];
  ptx, prx = Channel[u16].make();
  let certFile = certs("server.pem");
  let keyFile = certs("server.key");
  let taker = Taker(Server.none());
  taker.open(ServerConfig.make().secure(tls.ServerConfig.make(&certFile, &keyFile)).offerHttp3(&h3driver.plugin)
    .routes(HttpRoutes.make().queue("", "/")), ptx.clone());
  let port = prx.recv() || 0u16;
  let c = client(port);
  let first = serving(&taker, 1u32);
  let hello = fetch(&c, url(port, "/hello"), "hello");
  say("a request is answered", (hello.recv() || 0u64) == 1u64);
  let one = first.recv() || 9u64;
  let second = serving(&taker, 2u32);
  let nap = fetch(&c, url(port, "/nap"), "rested");
  let fill = fetch(&c, url(port, "/fill"), "");
  say("the write answers closed", (second.recv() || 0u64) == 1u64);
  say("the fetch fails", (fill.recv() || 0u64) == 1u64);
  say("the other request on the connection is answered", (nap.recv() || 0u64) == 1u64);
  say("one refusal counted", counted(&taker) == 1u64);
  let third = serving(&taker, 1u32);
  let again = fetch(&c, url(port, "/hello"), "hello");
  say("the next request is answered", (again.recv() || 0u64) == 1u64);
  let three = third.recv() || 9u64;
  say("the pool refused", stats().refused > 0u64);
  taker.stop();
  finalAll();
  0
}
