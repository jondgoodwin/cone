// HTTP/3 between actors, on loopback (the tls package's test certificates):
// actorhttp servers made with 'offerHttp3' (this package's plug-in), which
// listen on UDP beside TCP at the same port and say so in an Alt-Svc field,
// and actorhttp clients whose httpclient.Config names the plug-in. Checked:
// a client that learns h3 from the first response's Alt-Svc sends the next
// over HTTP/3; one with prior knowledge sends the first; a GET, a POST with
// a body and a stream of server-sent events over HTTP/3, the server's
// handler seeing Version.Http3; a body past the limit answered 413 over
// HTTP/3 and the next request answered; twenty GETs awaited at once by four
// actors through one client, every one over HTTP/3; a server asked for
// HTTP/3 without TLS refuses to listen.

mod served;

import stdio use *;
import fs;
import path use Path;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import iocore use SocketAddr;
import http use *;
import httpclient use Response, Request;
import tls;
import sse;
import actors;
import actorhttp use Client, Server, ServerConfig, Exchange, FetchError, EventStream;
import h3driver;

fn yes(b: bool) &str {if b {"yes"} else {"NO"}}

fn versionName(v: Version) &str {
  if v == Version.Http3 {"HTTP/3"}
  else if v == Version.Http2 {"HTTP/2"}
  else if v == Version.Http11 {"HTTP/1.1"}
  else {"other"}
}

// ---------------------------------------------------------------------------
// The server's side
// ---------------------------------------------------------------------------

actor Handler {
  ex: Exchange;

  pub async fn run(self) {
    let path = String.from(ex.request.path());
    let p = path.view();
    if p == "/events" {
      ex.startEvents();
      let a = sse.Event.named("h3", "one");
      let b = sse.Event.message("two");
      let r1 = await ex.sendEvent(&a);
      let r2 = await ex.sendEvent(&b);
      let f = await ex.finish();
    } else {
      var t = String.from(ex.request.methodName());
      t.append(" ");
      t.append(path.view());
      t.append(" ");
      t.append(versionName(ex.request.head.version));
      if ex.request.body.len() > 0usize {
        t.append(" ");
        t.append(ex.request.body.view());
      }
      ex.text(200u16, t.view());
    }
  }
}

actor Acceptor {
  server: Server;

  pub async fn open(self, cfg: ServerConfig, ports: Sender[u16]) {
    let r = await actorhttp.listen(SocketAddr.localhost(0u16), cfg);
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {server <-> *ok;}
      case let &mut Err(e) {
        printStr("listen failed: ");
        printStr(e.message().view());
        printStr("\n");
      }
    }
    ports.send(if server.offersHttp3() {server.port()} else {0u16});
  }

  pub async fn serve(self) {
    while true {
      let n = await server.next();
      match n {
        case var Ok(ok) {
          let h = Handler(ok);
          h.run();
        }
        case let Err(e) {break;}
      }
    }
  }

  pub async fn stop(self) {
    server.close();
  }
}

// ---------------------------------------------------------------------------
// The client's side
// ---------------------------------------------------------------------------

fn certs(name: &str) Path {
  var p = String.from("../../../../../tls/tests/certs/");
  p.append(name);
  Path.fromString(p)
}

fn readText(name: &str) String {
  var out = String.empty();
  let file = certs(name);
  match fs.readFile(&file) {
    case var Ok(r) {out <-> r;}
    case let Err(e) {}
  }
  out
}

fn url(port: u16, path: &str) String {
  var u = String.from("https://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u
}

// A client that trusts the test root, with the HTTP/3 plug-in; 'prior' an
// origin it knows speaks HTTP/3 (none when 0)
fn trusting(prior: u16) Client {
  var cfg = httpclient.Config.make();
  cfg.tlsConfig.verify = tls.Verifier.roots(readText("ca.pem").view());
  cfg.tlsConfig.offline = true;
  cfg.http3 = Some[&fn(t: &tls.ClientConfig) Uni[httpclient.Http3]](&h3driver.plugin);
  if prior != 0u16 {cfg.http3Origins.push(url(prior, ""));}
  Client.make(cfg, actorhttp.defaultMaxBody)
}

fn say(what: &str, r: Result[Response, FetchError]) {
  printStr(what);
  printStr(": ");
  match &r {
    case let &Ok(ok) {
      printUInt(u64.from(ok.status));
      printStr(" ");
      printStr(versionName(ok.version));
      printStr(" ");
      printStr(ok.body.view());
      match ok.headers.get("Alt-Svc") {
        case let Some(a) {printStr(" (Alt-Svc)");}
        else {}
      }
      printStr("\n");
    }
    case let &Err(e) {
      printStr("failed: ");
      printStr(e.message().view());
      printStr("\n");
    }
  }
}

fn overH3(r: Result[Response, FetchError]) bool {
  match &r {
    case let &Ok(ok) {ok.status == 200u16 && ok.version == Version.Http3}
    else {false}
  }
}

actor Many {
  client: Client;

  pub async fn run(self, port: u16, n: u32, done: Sender[u64]) {
    var good = 0u64;
    var k = 0u32;
    while k < n {
      if overH3(await client.get(url(port, "/many").view())) {good = good + 1u64;}
      k = k + 1u32;
    }
    done.send(good);
  }
}

actor Prober {
  client: Client;
  prior: Client;

  pub async fn run(self, port: u16, smallPort: u16, done: OneshotSender[u64]) {
    // Learned from Alt-Svc: the first over HTTP/2, the next over HTTP/3
    say("first", await client.get(url(port, "/first").view()));
    say("second", await client.get(url(port, "/second").view()));
    var post = Request.make("POST", url(port, "/echo").view());
    post.body = String.from("over h3");
    say("post", await client.send(post));

    // Events over HTTP/3
    let r = await client.events(Request.get(url(port, "/events").view()));
    match r {
      case let Ok(es) {
        printStr("events: status ");
        printUInt(u64.from(es.status));
        printStr(" ");
        printStr(versionName(es.version));
        printStr(", event stream: ");
        printStr(yes(es.isEventStream()));
        printStr("\n");
        var going = true;
        while going {
          let n = await es.next();
          match n {
            case let Ok(ok) {
              match ok {
                case let Some(ev) {
                  printStr("  ");
                  printStr(ev.kind());
                  printStr(": ");
                  printStr(ev.data.view());
                  printStr("\n");
                }
                case is None[sse.Event] {going = false;}
              }
            }
            case let Err(er) {
              printStr("  error\n");
              going = false;
            }
          }
        }
      }
      case let Err(e) {printStr("events failed\n");}
    }

    // Prior knowledge: the first over HTTP/3
    say("prior knowledge, first", await prior.get(url(smallPort, "/hello").view()));
    // A body past the server's limit: 413 over HTTP/3, and the next answered
    var big = Request.make("POST", url(smallPort, "/echo").view());
    big.body = String.from("a body longer than the sixteen bytes the server takes");
    match await prior.send(big) {
      case let Ok(ok) {
        printStr("past the limit: ");
        printUInt(u64.from(ok.status));
        printStr(" ");
        printStr(versionName(ok.version));
        printStr("\n");
      }
      case let Err(e) {
        printStr("past the limit: failed: ");
        printStr(e.message().view());
        printStr("\n");
      }
    }
    say("after it", await prior.get(url(smallPort, "/after").view()));
    var d = done;
    d.send(1u64);
  }
}

fn take[T](rx: &mut Receiver[T], dflt: T) T {
  match rx.recv() {
    case let Some(v) {v}
    else {dflt}
  }
}

fn main() i32 {
  initAll();
  var ptx: Sender[u16];
  var prx: Receiver[u16];
  ptx, prx = Channel[u16].make();
  {
    let certFile = certs("server.pem");
    let keyFile = certs("server.key");
    let acceptor = Acceptor(Server.none());
    acceptor.open(ServerConfig.make().secure(tls.ServerConfig.make(&certFile, &keyFile)).offerHttp2()
      .offerHttp3(&h3driver.plugin), ptx.clone());
    let port = take[u16](&mut prx, 0u16);
    acceptor.serve();
    var smallCfg = ServerConfig.make().secure(tls.ServerConfig.make(&certFile, &keyFile)).offerHttp3(&h3driver.plugin);
    smallCfg.maxBody = 16usize;
    let small = Acceptor(Server.none());
    small.open(smallCfg, ptx.clone());
    let smallPort = take[u16](&mut prx, 0u16);
    small.serve();
    printStr("two servers listen, TCP and UDP: ");
    printStr(yes(port != 0u16 && smallPort != 0u16));
    printStr("\n");
    // HTTP/3 without TLS: refused
    let plain = Acceptor(Server.none());
    plain.open(ServerConfig.make().offerHttp3(&h3driver.plugin), ptx.clone());
    let plainPort = take[u16](&mut prx, 0u16);
    printStr("a plain server asked for HTTP/3 listens: ");
    printStr(yes(plainPort != 0u16));
    printStr("\n");
    let client = trusting(0u16);
    {
      var tx: OneshotSender[u64];
      var rx: OneshotReceiver[u64];
      tx, rx = Oneshot[u64].make();
      let p = Prober(client.clone(), trusting(smallPort));
      p.run(port, smallPort, tx);
      rx.recv();
    }
    {
      var dtx: Sender[u64];
      var drx: Receiver[u64];
      dtx, drx = Channel[u64].make();
      var k = 0u32;
      while k < 4u32 {
        let m = Many(client.clone());
        m.run(port, 5u32, dtx.clone());
        k = k + 1u32;
      }
      var good = 0u64;
      k = 0u32;
      while k < 4u32 {
        good = good + take[u64](&mut drx, 0u64);
        k = k + 1u32;
      }
      printStr("twenty at once through one client, each 200 over HTTP/3: ");
      printUInt(good);
      printStr("\n");
    }
    acceptor.stop();
    small.stop();
  }
  finalAll();
  printStr("end\n");
  0i32
}
