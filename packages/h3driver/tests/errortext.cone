// The one line each error of this package gives a person is pinned here, with the
// number fields in play, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use String;
import h3driver use *;
import http use ErrorKind;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- Failure.make(Stage.Connect, 0u32, ErrorKind.Closed, "refused"), "connect: closed: refused", "no OS code");
  says(String() <- Failure.make(Stage.Connect, 10061u32, ErrorKind.Closed, "refused"), "connect: closed: refused (OS error 10061)", "OS code");
  done()
}
