// A listener that names nothing has no address: the driver answers with an
// IoError of the kind InvalidInput and no system number, the same on every
// system (a failure of the driver's own, not the system's).

mod handles;

import testing use *;
import iocore use Loop;
import ioerror use IoErrorKind;
import h3driver use *;

fn main() i32 {
  var lp = Loop.mustMake();
  let drv = Driver.make(Config.make());
  match drv.localAddr(&lp, ListenerId.none()) {
    case let Ok(a) {expect(false, "no address for a listener that names nothing");}
    case let Err(e) {
      expect(e.kind() == IoErrorKind.InvalidInput, "its address: InvalidInput");
      expectUInt(u64.from(e.code), 0u64, "...with no system number");
      expect(e.message().view() == "invalid input", "...and says so");
    }
  }
  done()
}
