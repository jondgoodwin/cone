// The text of h3driver's enums, every variant: a stage's lower-case name, and an
// event kind's variant name. Pinned so the text cannot drift when the way it is
// asked for changes.

mod names;

import testing use *;
import h3driver use *;

fn stage(s: Stage, want: &str, label: &str) {
  expectStr(stageName(s), want, label);
}

fn event(k: EventKind, want: &str, label: &str) {
  expectStr(eventName(k), want, label);
}

fn main() i32 {
  stage(Stage.Resolve, "resolve", "stage Resolve");
  stage(Stage.Connect, "connect", "stage Connect");
  stage(Stage.Read, "read", "stage Read");
  stage(Stage.Write, "write", "stage Write");
  stage(Stage.Http, "http", "stage Http");
  stage(Stage.Tls, "tls", "stage Tls");
  stage(Stage.Closed, "closed", "stage Closed");
  stage(Stage.Limit, "limit", "stage Limit");
  event(EventKind.Connected, "Connected", "event Connected");
  event(EventKind.Accepted, "Accepted", "event Accepted");
  event(EventKind.Closed, "Closed", "event Closed");
  event(EventKind.Request, "Request", "event Request");
  event(EventKind.Response, "Response", "event Response");
  event(EventKind.Interim, "Interim", "event Interim");
  event(EventKind.Data, "Data", "event Data");
  event(EventKind.End, "End", "event End");
  event(EventKind.Writable, "Writable", "event Writable");
  event(EventKind.Done, "Done", "event Done");
  event(EventKind.Failed, "Failed", "event Failed");
  event(EventKind.Cancelled, "Cancelled", "event Cancelled");
  event(EventKind.TimedOut, "TimedOut", "event TimedOut");
  done()
}
