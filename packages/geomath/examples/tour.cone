// A tour of the geomath package: a camera for a scene and what it can see, a
// turn applied to a point, a smooth blend between two orientations, a
// placement undone by its inverse, a ray picking a box, a curve, a color and
// a rectangle of pixels. Run it from the repository's
// root with
//
//     python tools/congo/congo.py run packages/geomath/examples/tour.cone

mod tour;

import stdio use *;
import geomath use *;

// A number to four decimal places. printFloat keeps six significant digits,
// which prints a rounding error such as -4.37114e-08 where 0 is meant
fn num(v f32) {
  imm scaled = f64.from(v) * 10000.;
  imm mag = if scaled < 0. {-scaled;} else {scaled;};
  imm n = i64.from(mag + 0.5);
  if scaled < 0. and n > 0i64 {printStr("-");};
  printInt(n / 10000i64);
  printStr(".");
  imm frac = n % 10000i64;
  if frac < 1000i64 {printStr("0");};
  if frac < 100i64 {printStr("0");};
  if frac < 10i64 {printStr("0");};
  printInt(frac);
}

fn vec2(label &str, v Vec2) {
  printStr(label);
  printStr(" (");
  num(v.x); printStr(", ");
  num(v.y); printStr(")\n");
}

fn vec3(label &str, v Vec3) {
  printStr(label);
  printStr(" (");
  num(v.x); printStr(", ");
  num(v.y); printStr(", ");
  num(v.z); printStr(")\n");
}

fn quat(label &str, q Quat) {
  printStr(label);
  printStr(" (");
  num(q.x); printStr(", ");
  num(q.y); printStr(", ");
  num(q.z); printStr(", ");
  num(q.w); printStr(")\n");
}

// A matrix as it is written on paper, row by row, though it is stored by column
fn mat(label &str, m Mat4) {
  printStr(label);
  printStr("\n");
  mut row = 0usize;
  while row < 4usize {
    printStr("  ");
    mut col = 0usize;
    while col < 4usize {
      // A space where a minus sign would go keeps the columns lined up
      imm v = m.cell(row, col);
      printStr("  ");
      if v > -0.00005 {printStr(" ");};
      num(v);
      col = col + 1usize;
    };
    printStr("\n");
    row = row + 1usize;
  };
}

fn containment(label &str, c i32) {
  printStr(label);
  if c == Inside {printStr(" inside\n");}
  elif c == Outside {printStr(" outside\n");}
  else {printStr(" partly inside\n");}
}

fn main() i32 {
  // The camera: a 60-degree lens on a 16:9 screen, seeing from 0.1 to 100
  // units away, standing at (0, 2, 5) and looking at the origin. Depth runs
  // from 0 at the near plane to 1 at the far one
  imm projection = Mat4.perspective(radians(60.), 16. / 9., 0.1, 100.);
  mat("perspective, 60 degrees, 16:9:", projection);
  imm eye = new Vec3(0., 2., 5.);
  imm view = Mat4.lookAt(eye, new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  mat("view from (0, 2, 5) looking at the origin:", view);
  // What the camera looks at is straight ahead of it, down its -z, as far
  // away as the camera stands from it
  vec3("the origin, seen by the camera:", view * new Vec3(0., 0., 0.));
  printStr("its distance from the eye: ");
  num(eye.length());
  printStr("\n");
  // What the camera can see: a box at the origin, a sphere behind it
  imm frustum = Frustum.fromMatrix(projection * view);
  containment("a unit box at the origin is", frustum.testAabb(Aabb3.fromCenter(new Vec3(0., 0., 0.), new Vec3(1., 1., 1.))));
  containment("a ball behind the camera is", frustum.testSphere(new Sphere(new Vec3(0., 2., 8.), 1.)));
  printStr("\n");

  // A quarter turn about z takes x to y
  imm quarter = Quat.angleAxis(pi / 2., new Vec3(0., 0., 1.));
  quat("a quarter turn about z:", quarter);
  vec3("x turned by it:", quarter * new Vec3(1., 0., 0.));

  // Halfway from facing ahead to that quarter turn is an eighth of a turn
  imm half = Quat.identity().slerp(quarter, 0.5);
  quat("halfway there, by slerp:", half);
  quat("an eighth turn, made directly:", Quat.angleAxis(pi / 4., new Vec3(0., 0., 1.)));
  vec3("x turned by the halfway orientation:", half * new Vec3(1., 0., 0.));
  printStr("\n");

  // Something placed at (1, 2, 3), turned a quarter about z and scaled by
  // 2; its inverse undoes all three
  imm placed = new Transform3(new Vec3(1., 2., 3.), quarter, new Vec3(2., 2., 2.));
  mat("placed at (1, 2, 3), turned, scaled by 2:", placed.toMat4());
  imm corner = placed.transformPoint(new Vec3(1., 1., 1.));
  vec3("its corner (1, 1, 1), placed:", corner);
  vec3("and brought back by the inverse:", placed.inverse().transformPoint(corner));
  printStr("\n");

  // A ray from the camera straight ahead picks the box it meets first
  imm ray = new Ray3(eye, (new Vec3(0., 0., 0.) - eye).normalize());
  match ray.intersectAabb(Aabb3.fromCenter(new Vec3(0., 0., 0.), new Vec3(1., 1., 1.))) {
    case imm h Some {
      printStr("the ray from the eye meets the box after ");
      num(h.value);
      vec3(", at", ray.at(h.value));
    }
    else {printStr("the ray misses the box\n");}
  }

  // A cubic Bezier arch, and its middle
  imm arch = new CubicBezier2(new Vec2(0., 0.), new Vec2(0., 2.), new Vec2(2., 2.), new Vec2(2., 0.));
  vec2("the arch's middle:", arch.point(0.5));
  vec2("which way it runs there:", arch.tangent(0.5));
  printStr("\n");

  // A color and a rectangle of pixels are plain values
  imm orange = new Color(1., 0.5, 0.);
  printStr("orange: ");
  num(orange.red); printStr(" "); num(orange.green); printStr(" ");
  num(orange.blue); printStr(" alpha "); num(orange.alpha); printStr("\n");
  imm screen = new IRect(0, 0, 1280, 720);
  printStr("screen: ");
  printInt(screen.w); printStr(" by "); printInt(screen.h); printStr("\n");
  0i32;
}
