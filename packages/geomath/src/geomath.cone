// The geomath package: the numbers 2-D and 3-D worlds are built from. A
// program reaches it with 'import geomath', and gets value types:
//
// - Vectors: Vec2, Vec3 and Vec4, a point or a direction (and Vec2 a texture
//   coordinate), with the operators, dot and cross products, lengths and
//   distances, 'normalize', component-wise min, max, abs and clamp, lerp,
//   reflect, project and the angle between two; DVec3, a 64-bit position for
//   a world too large for f32, converted to and from Vec3.
// - Rotation and placement: Quat, an orientation; Mat3, a 3x3 matrix (a
//   rotation and scale, a normal matrix, or a 2-D placement); Mat4, a 4x4
//   matrix (projections, look-at, placements); Transform3 (translation,
//   rotation, scale) and Transform2 (translation, angle, scale).
// - Shapes: Aabb2 and Aabb3 (axis-aligned boxes), Rect (f32 corner and size)
//   and IRect (whole pixels), Circle and Sphere, Plane, Ray2 and Ray3, and
//   Frustum; with the tests between them: ray against box, sphere, plane and
//   triangle with the distance to the hit, box and sphere against a frustum,
//   box against box, point in box, closest points, and in 2-D ray and segment
//   intersections, point in rect and point in polygon.
// - Curves and polygons: quadratic and cubic Bezier curves in 2-D and 3-D,
//   polylines, and 2-D polygons' signed area, convex hull and triangulation.
// - Color: red, green, blue and alpha.
//
// Each is a small struct passed by value: a method returns a new value and
// never changes the one it is called on. Numbers are f32, but for DVec3.
//
// Its conventions are the industry's:
//
// - Space is right-handed: x to the right, y up, z towards the viewer, so a
//   camera looks down its own -z. A positive angle turns counterclockwise when
//   seen from the tip of the axis looking back: a quarter turn about z takes x
//   to y. In 2-D, a positive angle turns x towards y.
// - Angles are radians everywhere, a camera's field of view included.
//   'radians' and 'degrees' convert.
// - A matrix is stored column by column (column-major): Mat4's m[0..3] is its
//   first column, and its translation is m[12], m[13], m[14]. 'a * b' applies
//   b first, then a, and 'm * p' transforms the point p (its w taken as 1).
// - After projection, depth runs from 0 at the near plane to 1 at the far one,
//   as Vulkan, Direct3D, Metal and WebGPU want it: Mat4.perspective,
//   Mat4.orthographic and Frustum.fromMatrix. OpenGL's -1 to 1 is
//   Mat4.perspectiveGl, Mat4.orthographicGl and Frustum.fromMatrixGl.
// - A quaternion is (x, y, z, w), w the scalar part; a rotation is a unit
//   quaternion, and 'a * b' is the rotation b followed by a.
// - A plane is the points p where normal.dot(p) + d = 0; its normal points to
//   its positive side, which for a frustum's planes is the inside.
// - A ray's hit is an Option[f32], the multiple of its direction at which it
//   hits: with a unit direction, the distance. A ray starting inside a solid
//   (a box or a sphere) hits it at 0.
//
// Every sine, cosine, tangent and inverse of one in this package goes through
// its own functions below ('geomath.sin', 'geomath.cos', ...), so that
// deterministic versions can later be put in, in one place. For now they are
// the f32 methods the compiler builds in and the libc package's; square roots
// are the compiler's. A list of points or indices it makes (a sampled curve, a
// hull, a triangulation) is a collections List; one it reads is a slice, so a
// fixed array ('&points') and a List ('list.view()') both serve.
//
// The package is one file, since a package a program finds on the search path
// (rather than one Congo builds) is compiled from its src/<name>.cone alone.
//
// It began as a port of the Pegasus3D browser's world libraries (xyz, quat,
// matrix4, xyzmath, color and rect), whose names and conventions were
// OpenGL's; where it differs from them now it follows the industry.

mod geomath;

import libc;
import collections use List;

// Pi: a half turn, in radians
pub imm pi f32 = 3.14159265358979;

// An angle in degrees, in radians
pub fn radians(degrees f32) f32 {degrees * (pi / 180.);}

// An angle in radians, in degrees
pub fn degrees(radians f32) f32 {radians * (180. / pi);}

// -------- trigonometry: every use in the package goes through these --------

pub fn sin(a f32) f32 {a.sin();}
pub fn cos(a f32) f32 {a.cos();}
pub fn tan(a f32) f32 {libc.tanf(a);}
pub fn asin(x f32) f32 {libc.asinf(x);}
pub fn acos(x f32) f32 {libc.acosf(x);}

// The angle of the direction (x, y), from -pi to pi
pub fn atan2(y f32, x f32) f32 {libc.atan2f(y, x);}

// -------- scalar helpers --------

// The largest f32, which stands in for infinity in the slab tests
imm huge f32 = 3.4028235e38;

// Two numbers are equal when they differ by less than a ten-millionth, or by
// no more than f32's precision at the larger one (FLT_EPSILON)
fn almostEqual(a f32, b f32) Bool {
  imm diff = libc.fabsf(a - b);
  imm aa = libc.fabsf(a);
  imm bb = libc.fabsf(b);
  imm largest = if bb > aa {bb;} else {aa;};
  diff < 0.0000001 or diff <= largest * 1.1920929e-7;
}

fn fmin(a f32, b f32) f32 {if a < b {a;} else {b;};}
fn fmax(a f32, b f32) f32 {if a > b {a;} else {b;};}
fn fabs(a f32) f32 {libc.fabsf(a);}
fn fclamp(v f32, lo f32, hi f32) f32 {if v < lo {lo;} elif v > hi {hi;} else {v;};}

// A color: red, green and blue from 0 to 1, and alpha from 0 (invisible) to 1
// (opaque), which a literal may leave out. Color[1., 0.5, 0.] is orange
pub struct Color {
  pub red f32;
  pub green f32;
  pub blue f32;
  pub alpha f32 = 1.;

  // A shade of gray, 0 black and 1 white
  pub fn gray(level f32) Color {Color[level, level, level, 1.];}
}

// ======== Vectors: Vec2, Vec3 and Vec4, and DVec3, a 64-bit position ========

// A point or direction in the plane, or a texture coordinate (x across the
// image, y up it)
pub struct Vec2 {
  pub x f32;
  pub y f32;

  // The unit vector at 'angle' radians from x, counterclockwise
  pub fn fromAngle(angle f32) Vec2 {Vec2[cos(angle), sin(angle)];}

  pub fn add overload `+`(self, o Vec2) Vec2 {Vec2[x + o.x, y + o.y];}
  pub fn sub overload `-`(self, o Vec2) Vec2 {Vec2[x - o.x, y - o.y];}
  pub fn neg overload `-`(self) Vec2 {Vec2[-x, -y];}
  pub fn scale overload `*`(self, s f32) Vec2 {Vec2[x * s, y * s];}

  // Component by component
  pub fn mult overload `*`(self, o Vec2) Vec2 {Vec2[x * o.x, y * o.y];}

  pub fn dot(self, o Vec2) f32 {x * o.x + y * o.y;}

  // The 2-D cross product, a number: the z of the 3-D cross product of the
  // two in the plane z = 0. Positive when o is counterclockwise of self
  pub fn cross(self, o Vec2) f32 {x * o.y - y * o.x;}

  // Self turned a quarter turn counterclockwise
  pub fn perp(self) Vec2 {Vec2[-y, x];}

  pub fn length(self) f32 {(x * x + y * y).sqrt();}
  pub fn lengthSquared(self) f32 {x * x + y * y;}
  pub fn distance(self, o Vec2) f32 {(self - o).length();}
  pub fn distanceSquared(self, o Vec2) f32 {(self - o).lengthSquared();}

  // The vector of length 1 in the same direction. The zero vector has no
  // direction, and gives (1, 0)
  pub fn normalize(self) Vec2 {
    imm len = length();
    if len > 0. {
      imm inv = 1. / len;
      Vec2[x * inv, y * inv];
    } else {
      Vec2[1., 0.];
    };
  }

  // The point the fraction t of the way from self to 'to' (0 is self, 1 is 'to')
  pub fn lerp(self, to Vec2, t f32) Vec2 {
    imm s = 1. - t;
    Vec2[s * x + t * to.x, s * y + t * to.y];
  }

  pub fn min(self, o Vec2) Vec2 {Vec2[fmin(x, o.x), fmin(y, o.y)];}
  pub fn max(self, o Vec2) Vec2 {Vec2[fmax(x, o.x), fmax(y, o.y)];}
  pub fn abs(self) Vec2 {Vec2[fabs(x), fabs(y)];}

  // Each component held between lo's and hi's
  pub fn clamp(self, lo Vec2, hi Vec2) Vec2 {Vec2[fclamp(x, lo.x, hi.x), fclamp(y, lo.y, hi.y)];}

  // Self bounced off a surface whose unit normal is n
  pub fn reflect(self, n Vec2) Vec2 {self - n * (2. * dot(n));}

  // The part of self along 'onto', which need not be a unit vector
  pub fn project(self, onto Vec2) Vec2 {
    imm len2 = onto.lengthSquared();
    if len2 > 0. {onto * (dot(onto) / len2);} else {Vec2[0., 0.];};
  }

  // The angle between the two, from 0 to pi, whichever way round
  pub fn angle(self, o Vec2) f32 {
    imm lens = (lengthSquared() * o.lengthSquared()).sqrt();
    if lens > 0. {acos(fclamp(dot(o) / lens, -1., 1.));} else {0.;};
  }

  // The angle that turns self to o, from -pi to pi, counterclockwise positive
  pub fn signedAngle(self, o Vec2) f32 {atan2(cross(o), dot(o));}

  // Self turned 'angle' radians counterclockwise
  pub fn rotate(self, angle f32) Vec2 {
    imm c = cos(angle);
    imm s = sin(angle);
    Vec2[x * c - y * s, x * s + y * c];
  }

  // Equal but for rounding: see almostEqual
  pub fn equals(self, o Vec2) Bool {almostEqual(x, o.x) and almostEqual(y, o.y);}
}

// A point or direction in space
pub struct Vec3 {
  pub x f32;
  pub y f32;
  pub z f32;

  pub fn add overload `+`(self, o Vec3) Vec3 {Vec3[x + o.x, y + o.y, z + o.z];}
  pub fn sub overload `-`(self, o Vec3) Vec3 {Vec3[x - o.x, y - o.y, z - o.z];}
  pub fn neg overload `-`(self) Vec3 {Vec3[-x, -y, -z];}

  // Each component multiplied by one number
  pub fn scale overload `*`(self, s f32) Vec3 {Vec3[x * s, y * s, z * s];}

  // Component by component: x by x, y by y, z by z
  pub fn mult overload `*`(self, o Vec3) Vec3 {Vec3[x * o.x, y * o.y, z * o.z];}

  // The dot product. It does not normalize either vector
  pub fn dot(self, o Vec3) f32 {x * o.x + y * o.y + z * o.z;}

  // The cross product: perpendicular to both, by the right-hand rule
  pub fn cross(self, o Vec3) Vec3 {
    Vec3[y * o.z - z * o.y, z * o.x - x * o.z, x * o.y - y * o.x];
  }

  pub fn length(self) f32 {(x * x + y * y + z * z).sqrt();}
  pub fn lengthSquared(self) f32 {x * x + y * y + z * z;}
  pub fn distance(self, o Vec3) f32 {(self - o).length();}
  pub fn distanceSquared(self, o Vec3) f32 {(self - o).lengthSquared();}

  // The vector of length 1 in the same direction. The zero vector has no
  // direction, and gives (1, 0, 0), as Pegasus had it
  pub fn normalize(self) Vec3 {
    imm len = length();
    if len > 0. {
      imm inv = 1. / len;
      Vec3[x * inv, y * inv, z * inv];
    } else {
      Vec3[1., 0., 0.];
    };
  }

  // The point the fraction t of the way from self to 'to' (0 is self, 1 is 'to')
  pub fn lerp(self, to Vec3, t f32) Vec3 {
    imm s = 1. - t;
    Vec3[s * x + t * to.x, s * y + t * to.y, s * z + t * to.z];
  }

  pub fn min(self, o Vec3) Vec3 {Vec3[fmin(x, o.x), fmin(y, o.y), fmin(z, o.z)];}
  pub fn max(self, o Vec3) Vec3 {Vec3[fmax(x, o.x), fmax(y, o.y), fmax(z, o.z)];}
  pub fn abs(self) Vec3 {Vec3[fabs(x), fabs(y), fabs(z)];}

  // Each component held between lo's and hi's
  pub fn clamp(self, lo Vec3, hi Vec3) Vec3 {
    Vec3[fclamp(x, lo.x, hi.x), fclamp(y, lo.y, hi.y), fclamp(z, lo.z, hi.z)];
  }

  // Self bounced off a surface whose unit normal is n
  pub fn reflect(self, n Vec3) Vec3 {self - n * (2. * dot(n));}

  // The part of self along 'onto', which need not be a unit vector
  pub fn project(self, onto Vec3) Vec3 {
    imm len2 = onto.lengthSquared();
    if len2 > 0. {onto * (dot(onto) / len2);} else {Vec3[0., 0., 0.];};
  }

  // The angle between the two, from 0 to pi
  pub fn angle(self, o Vec3) f32 {
    imm lens = (lengthSquared() * o.lengthSquared()).sqrt();
    if lens > 0. {acos(fclamp(dot(o) / lens, -1., 1.));} else {0.;};
  }

  // x and y, dropping z
  pub fn xy(self) Vec2 {Vec2[x, y];}

  // With a fourth component: w 1 for a point, 0 for a direction
  pub fn extend(self, w f32) Vec4 {Vec4[x, y, z, w];}

  // Equal but for rounding: see almostEqual
  pub fn equals(self, o Vec3) Bool {
    almostEqual(x, o.x) and almostEqual(y, o.y) and almostEqual(z, o.z);
  }

  pub fn isZero(self) Bool {
    almostEqual(x, 0.) and almostEqual(y, 0.) and almostEqual(z, 0.);
  }
}

// A four-component vector: a point or direction in homogeneous coordinates,
// or any four numbers taken together
pub struct Vec4 {
  pub x f32;
  pub y f32;
  pub z f32;
  pub w f32;

  pub fn add overload `+`(self, o Vec4) Vec4 {Vec4[x + o.x, y + o.y, z + o.z, w + o.w];}
  pub fn sub overload `-`(self, o Vec4) Vec4 {Vec4[x - o.x, y - o.y, z - o.z, w - o.w];}
  pub fn neg overload `-`(self) Vec4 {Vec4[-x, -y, -z, -w];}
  pub fn scale overload `*`(self, s f32) Vec4 {Vec4[x * s, y * s, z * s, w * s];}
  pub fn mult overload `*`(self, o Vec4) Vec4 {Vec4[x * o.x, y * o.y, z * o.z, w * o.w];}
  pub fn dot(self, o Vec4) f32 {x * o.x + y * o.y + z * o.z + w * o.w;}
  pub fn length(self) f32 {(x * x + y * y + z * z + w * w).sqrt();}
  pub fn lengthSquared(self) f32 {x * x + y * y + z * z + w * w;}

  // The vector of length 1 in the same direction; zero stays zero
  pub fn normalize(self) Vec4 {
    imm len = length();
    if len > 0. {self * (1. / len);} else {self;};
  }

  pub fn lerp(self, to Vec4, t f32) Vec4 {self * (1. - t) + to * t;}

  // x, y and z, dropping w
  pub fn xyz(self) Vec3 {Vec3[x, y, z];}

  pub fn equals(self, o Vec4) Bool {
    almostEqual(x, o.x) and almostEqual(y, o.y) and almostEqual(z, o.z) and almostEqual(w, o.w);
  }
}

// A position in 64 bits, for a world too large for f32 (whose step is about a
// metre ten thousand kilometres out). Work near a place is done in f32 relative
// to it: 'relativeTo' gives that, and adding a Vec3 comes back
pub struct DVec3 {
  pub x f64;
  pub y f64;
  pub z f64;

  // The same point, widened
  pub fn from(v Vec3) DVec3 {DVec3[f64[v.x], f64[v.y], f64[v.z]];}

  // The same point, narrowed to f32
  pub fn toVec3(self) Vec3 {Vec3[f32[x], f32[y], f32[z]];}

  // Where self is seen from 'origin', in f32
  pub fn relativeTo(self, origin DVec3) Vec3 {(self - origin).toVec3();}

  pub fn add overload `+`(self, o DVec3) DVec3 {DVec3[x + o.x, y + o.y, z + o.z];}
  pub fn addVec3 overload `+`(self, o Vec3) DVec3 {DVec3[x + f64[o.x], y + f64[o.y], z + f64[o.z]];}
  pub fn sub overload `-`(self, o DVec3) DVec3 {DVec3[x - o.x, y - o.y, z - o.z];}
  pub fn neg overload `-`(self) DVec3 {DVec3[-x, -y, -z];}
  pub fn scale overload `*`(self, s f64) DVec3 {DVec3[x * s, y * s, z * s];}
  pub fn dot(self, o DVec3) f64 {x * o.x + y * o.y + z * o.z;}
  pub fn length(self) f64 {(x * x + y * y + z * z).sqrt();}
  pub fn lengthSquared(self) f64 {x * x + y * y + z * z;}
  pub fn distance(self, o DVec3) f64 {(self - o).length();}
}

// ======== Quat: an orientation, or a rotation, as a quaternion ========

// Eberly's constants for the fast slerp below, as Pegasus had them
imm slerpU [8; f32] = [0.333333333333333f, 0.100000000000000f, 0.047619047619048f,
  0.027777777777778f, 0.018181818181818f, 0.012820512820513f, 0.009523809523810f,
  0.013978731275863f];
imm slerpV [8; f32] = [0.333333333333333f, 0.400000000000000f, 0.428571428571429f,
  0.444444444444444f, 0.454545454545455f, 0.461538461538462f, 0.466666666666667f,
  0.894638801655200f];

// An orientation, or a rotation, as a quaternion: (x, y, z) the vector part
// and w the scalar part. A rotation is a unit quaternion.
pub struct Quat {
  pub x f32;
  pub y f32;
  pub z f32;
  pub w f32;

  // No rotation at all
  pub fn identity() Quat {Quat[0., 0., 0., 1.];}

  // A turn of 'angle' radians about 'axis', which must be a unit vector
  pub fn angleAxis(angle f32, axis Vec3) Quat {
    imm s = sin(angle * 0.5);
    Quat[axis.x * s, axis.y * s, axis.z * s, cos(angle * 0.5)];
  }

  // Turns of rot.x, rot.y and rot.z radians about the x, y and z axes: first
  // about x, then about the turned y, then about the twice-turned z. It is the
  // product of the three single turns, x * y * z
  pub fn fromEulerXyz(rot Vec3) Quat {
    imm cx = cos(rot.x * 0.5);
    imm cy = cos(rot.y * 0.5);
    imm cz = cos(rot.z * 0.5);
    imm sx = sin(rot.x * 0.5);
    imm sy = sin(rot.y * 0.5);
    imm sz = sin(rot.z * 0.5);
    Quat[sx * cy * cz + cx * sy * sz,
      cx * sy * cz - sx * cy * sz,
      cx * cy * sz + sx * sy * cz,
      cx * cy * cz - sx * sy * sz];
  }

  // The same, taken in the order y, x, z: the product y * x * z
  pub fn fromEulerYxz(rot Vec3) Quat {
    imm cx = cos(rot.x * 0.5);
    imm cy = cos(rot.y * 0.5);
    imm cz = cos(rot.z * 0.5);
    imm sx = sin(rot.x * 0.5);
    imm sy = sin(rot.y * 0.5);
    imm sz = sin(rot.z * 0.5);
    Quat[sx * cy * cz + cx * sy * sz,
      cx * sy * cz - sx * cy * sz,
      cx * cy * sz - sx * sy * cz,
      cx * cy * cz + sx * sy * sz];
  }

  // The shortest turn that takes the direction of u to the direction of v.
  // When they point exactly opposite ways, any half turn will do, and this
  // takes one about an axis perpendicular to u. (After lolengine.net's
  // "quaternion from two vectors", as Pegasus had it.)
  pub fn fromVectors(u Vec3, v Vec3) Quat {
    imm normuv = (u.dot(u) * v.dot(v)).sqrt();
    mut real = normuv + u.dot(v);
    mut axis = u.cross(v);
    if real < 0.000001 * normuv {
      real = 0.;
      axis = if fabs(u.x) > fabs(u.z) {Vec3[-u.y, u.x, 0.];} else {Vec3[0., -u.z, u.y];};
    };
    imm inv = 1. / (real * real + axis.dot(axis)).sqrt();
    Quat[axis.x * inv, axis.y * inv, axis.z * inv, real * inv];
  }

  // The rotation o followed by the rotation self (the Hamilton product)
  pub fn mult overload `*`(self, o Quat) Quat {
    imm va = Vec3[x, y, z];
    imm vb = Vec3[o.x, o.y, o.z];
    imm vaxb = va.cross(vb);
    Quat[w * vb.x + o.w * va.x + vaxb.x,
      w * vb.y + o.w * va.y + vaxb.y,
      w * vb.z + o.w * va.z + vaxb.z,
      w * o.w - va.dot(vb)];
  }

  // The vector v turned by this rotation (self must be a unit quaternion);
  // 'q * v' is the same
  pub fn rotate overload `*`(self, v Vec3) Vec3 {
    imm ix = w * v.x + y * v.z - z * v.y;
    imm iy = w * v.y + z * v.x - x * v.z;
    imm iz = w * v.z + x * v.y - y * v.x;
    imm iw = -x * v.x - y * v.y - z * v.z;
    Vec3[ix * w - iw * x - iy * z + iz * y,
      iy * w - iw * y - iz * x + ix * z,
      iz * w - iw * z - ix * y + iy * x];
  }

  pub fn dot(self, o Quat) f32 {x * o.x + y * o.y + z * o.z + w * o.w;}
  pub fn length(self) f32 {(x * x + y * y + z * z + w * w).sqrt();}
  pub fn lengthSquared(self) f32 {x * x + y * y + z * z + w * w;}

  // The vector part negated: for a unit quaternion, the opposite rotation
  pub fn conjugate(self) Quat {Quat[-x, -y, -z, w];}

  // The quaternion of length 1 in the same direction; zero stays zero
  pub fn normalize(self) Quat {
    imm len = length();
    if len == 0. {
      Quat[0., 0., 0., 0.];
    } else {
      imm inv = 1. / len;
      Quat[x * inv, y * inv, z * inv, w * inv];
    };
  }

  // The quaternion that multiplied by self gives the identity: the conjugate
  // divided by the length squared. Zero stays zero
  pub fn inverse(self) Quat {
    imm len2 = lengthSquared();
    if len2 > 0. {
      imm inv = 1. / len2;
      Quat[-x * inv, -y * inv, -z * inv, w * inv];
    } else {
      self;
    };
  }

  // The orientation the fraction t of the way from self to 'to', blended
  // straight and normalized (nlerp), the short way round. Cheaper than slerp,
  // it turns faster in the middle than at the ends
  pub fn lerp(self, to Quat, t f32) Quat {
    imm s = if dot(to) < 0. {-t;} else {t;};
    imm u = 1. - t;
    Quat[u * x + s * to.x, u * y + s * to.y, u * z + s * to.z, u * w + s * to.w].normalize();
  }

  // The orientation the fraction t of the way from self to 'to' along the
  // shortest arc, turning at an even rate (spherical linear interpolation).
  // It is David Eberly's fast approximation, accurate to about a millionth,
  // which needs no trigonometry (adapted from Cesium.js, as Pegasus had it)
  pub fn slerp(self, to Quat, t f32) Quat {
    mut d = dot(to);
    mut sign f32 = 1.;
    if d < 0. {
      sign = -1.;
      d = -d;
    };
    imm dm1 = d - 1.;
    imm topp = 1. - t;
    imm sqrT = t * t;
    imm sqrD = topp * topp;
    // Each series is 1 + b0 (1 + b1 (1 + ... (1 + b7))), summed from the inside
    mut ct f32 = 1.;
    mut cd f32 = 1.;
    mut i = 8usize;
    while i > 0usize {
      i = i - 1usize;
      ct = 1. + (slerpU[i] * sqrT - slerpV[i]) * dm1 * ct;
      cd = 1. + (slerpU[i] * sqrD - slerpV[i]) * dm1 * cd;
    };
    ct = sign * t * ct;
    cd = topp * cd;
    Quat[cd * x + ct * to.x, cd * y + ct * to.y, cd * z + ct * to.z, cd * w + ct * to.w];
  }
}

// ======== Matrices: Mat3 and Mat4, each stored column by column ========

// A 3x3 matrix, stored column by column: the cell in row r and column c is
// m[3 * c + r].
//     m[0] m[3] m[6]
//     m[1] m[4] m[7]
//     m[2] m[5] m[8]
// It is a rotation and scale in space (and the normal matrix, which carries
// normals as a Mat4 carries points), or a placement in the plane, whose
// translation is m[6], m[7] (Transform2.toMat3).
pub struct Mat3 {
  pub m [9; f32];

  pub fn identity() Mat3 {Mat3[[1f, 0f, 0f,  0f, 1f, 0f,  0f, 0f, 1f]];}

  // Scaling by s.x, s.y and s.z along the axes
  pub fn fromScale(s Vec3) Mat3 {Mat3[[s.x, 0f, 0f,  0f, s.y, 0f,  0f, 0f, s.z]];}

  // The rotation a unit quaternion describes
  pub fn fromQuat(q Quat) Mat3 {
    imm x2 = q.x + q.x;
    imm y2 = q.y + q.y;
    imm z2 = q.z + q.z;
    imm xx = q.x * x2;
    imm xy = q.x * y2;
    imm xz = q.x * z2;
    imm yy = q.y * y2;
    imm yz = q.y * z2;
    imm zz = q.z * z2;
    imm wx = q.w * x2;
    imm wy = q.w * y2;
    imm wz = q.w * z2;
    Mat3[[1. - (yy + zz), xy + wz, xz - wy,
      xy - wz, 1. - (xx + zz), yz + wx,
      xz + wy, yz - wx, 1. - (xx + yy)]];
  }

  // The upper left 3x3 of a Mat4: its rotation and scale, without its
  // translation
  pub fn fromMat4(a Mat4) Mat3 {
    Mat3[[a.m[0], a.m[1], a.m[2],  a.m[4], a.m[5], a.m[6],  a.m[8], a.m[9], a.m[10]]];
  }

  // The matrix that carries normals as 'a' carries points: the inverse of
  // its 3x3, transposed. Under a scaling that is not the same along every
  // axis, a normal is not carried as the points are, or it would lean
  pub fn normalMatrix(a Mat4) Mat3 {fromMat4(a).inverse().transpose();}

  // The cell in row 'row' and column 'col', each 0 to 2
  pub fn cell(self, row usize, col usize) f32 {m[3usize * col + row];}

  // The matrix product: o applied first, then self
  pub fn mult overload `*`(self, o Mat3) Mat3 {
    mut r = Mat3[[9; 0f]];
    mut col = 0usize;
    while col < 3usize {
      imm c = 3usize * col;
      mut row = 0usize;
      while row < 3usize {
        r.m[c + row] = m[row] * o.m[c] + m[3usize + row] * o.m[c + 1usize]
          + m[6usize + row] * o.m[c + 2usize];
        row = row + 1usize;
      };
      col = col + 1usize;
    };
    r;
  }

  // The vector v carried through the matrix
  pub fn transform overload `*`(self, v Vec3) Vec3 {
    Vec3[m[0] * v.x + m[3] * v.y + m[6] * v.z,
      m[1] * v.x + m[4] * v.y + m[7] * v.z,
      m[2] * v.x + m[5] * v.y + m[8] * v.z];
  }

  // A 2-D point carried through a 2-D placement (its third component taken as
  // 1, so it is moved), and a 2-D direction (taken as 0, so it is not)
  pub fn transformPoint2(self, p Vec2) Vec2 {
    Vec2[m[0] * p.x + m[3] * p.y + m[6], m[1] * p.x + m[4] * p.y + m[7]];
  }
  pub fn transformVector2(self, v Vec2) Vec2 {
    Vec2[m[0] * v.x + m[3] * v.y, m[1] * v.x + m[4] * v.y];
  }

  // Rows and columns exchanged
  pub fn transpose(self) Mat3 {
    Mat3[[m[0], m[3], m[6],  m[1], m[4], m[7],  m[2], m[5], m[8]]];
  }

  pub fn determinant(self) f32 {
    m[0] * (m[4] * m[8] - m[7] * m[5]) - m[3] * (m[1] * m[8] - m[7] * m[2])
      + m[6] * (m[1] * m[5] - m[4] * m[2]);
  }

  // The matrix that undoes this one: its adjugate over its determinant. A
  // matrix that flattens space (determinant 0) has none, and gives all zeros
  pub fn inverse(self) Mat3 {
    // As written on paper: a b c / d e f / g h i
    imm a = m[0];
    imm b = m[3];
    imm c = m[6];
    imm d = m[1];
    imm e = m[4];
    imm f = m[7];
    imm g = m[2];
    imm h = m[5];
    imm i = m[8];
    imm det = determinant();
    if det == 0. {return Mat3[[9; 0f]];}
    imm inv = 1. / det;
    Mat3[[(e * i - f * h) * inv, (f * g - d * i) * inv, (d * h - e * g) * inv,
      (c * h - b * i) * inv, (a * i - c * g) * inv, (b * g - a * h) * inv,
      (b * f - c * e) * inv, (c * d - a * f) * inv, (a * e - b * d) * inv]];
  }
}

// A 4x4 transformation matrix, stored column by column: the cell in row r and
// column c is m[4 * c + r].
//     m[0] m[4] m[8]  m[12]
//     m[1] m[5] m[9]  m[13]
//     m[2] m[6] m[10] m[14]
//     m[3] m[7] m[11] m[15]
pub struct Mat4 {
  pub m [16; f32];

  pub fn identity() Mat4 {
    Mat4[[1f, 0f, 0f, 0f,  0f, 1f, 0f, 0f,  0f, 0f, 1f, 0f,  0f, 0f, 0f, 1f]];
  }

  // A move by t
  pub fn fromTranslation(t Vec3) Mat4 {identity().withTranslation(t);}

  // Scaling by s.x, s.y and s.z along the axes
  pub fn fromScale(s Vec3) Mat4 {identity().scale(s);}

  // A perspective projection, right-handed, looking down -z: 'fovY' the
  // vertical field of view in radians, 'aspect' the width over the height,
  // 'near' and 'far' the distances to the clipping planes. Depth runs from 0
  // at the near plane to 1 at the far one, as Vulkan, Direct3D, Metal and
  // WebGPU want it
  pub fn perspective(fovY f32, aspect f32, near f32, far f32) Mat4 {
    imm f = 1. / tan(fovY * 0.5);
    mut r = Mat4[[16; 0f]];
    r.m[0] = f / aspect;
    r.m[5] = f;
    r.m[10] = far / (near - far);
    r.m[11] = -1.;
    r.m[14] = near * far / (near - far);
    r;
  }

  // The same, with OpenGL's depth, from -1 at the near plane to 1 at the far
  pub fn perspectiveGl(fovY f32, aspect f32, near f32, far f32) Mat4 {
    imm f = 1. / tan(fovY * 0.5);
    mut r = Mat4[[16; 0f]];
    r.m[0] = f / aspect;
    r.m[5] = f;
    r.m[10] = (far + near) / (near - far);
    r.m[11] = -1.;
    r.m[14] = 2. * far * near / (near - far);
    r;
  }

  // An orthographic projection, right-handed, looking down -z, of the box
  // from 'left' to 'right', 'bottom' to 'top', and 'near' to 'far' away.
  // Depth runs from 0 at the near plane to 1 at the far one
  pub fn orthographic(left f32, right f32, bottom f32, top f32, near f32, far f32) Mat4 {
    mut r = identity();
    r.m[0] = 2. / (right - left);
    r.m[5] = 2. / (top - bottom);
    r.m[10] = 1. / (near - far);
    r.m[12] = (right + left) / (left - right);
    r.m[13] = (top + bottom) / (bottom - top);
    r.m[14] = near / (near - far);
    r;
  }

  // The same, with OpenGL's depth, from -1 at the near plane to 1 at the far
  // (glOrtho's matrix)
  pub fn orthographicGl(left f32, right f32, bottom f32, top f32, near f32, far f32) Mat4 {
    mut r = identity();
    r.m[0] = 2. / (right - left);
    r.m[5] = 2. / (top - bottom);
    r.m[10] = 2. / (near - far);
    r.m[12] = (right + left) / (left - right);
    r.m[13] = (top + bottom) / (bottom - top);
    r.m[14] = (far + near) / (near - far);
    r;
  }

  // The rotation a unit quaternion describes
  pub fn fromQuat(q Quat) Mat4 {
    imm r = Mat3.fromQuat(q);
    Mat4[[r.m[0], r.m[1], r.m[2], 0f,
      r.m[3], r.m[4], r.m[5], 0f,
      r.m[6], r.m[7], r.m[8], 0f,
      0f, 0f, 0f, 1f]];
  }

  // Scaled by 'scale', turned by 'rotation', then moved by 'translation': how
  // a thing is placed in its parent
  pub fn fromTrs(translation Vec3, rotation Quat, scale Vec3) Mat4 {
    fromQuat(rotation).scale(scale).withTranslation(translation);
  }

  // The view matrix of a camera at 'eye' looking at 'target', 'up' saying
  // which way is up: it carries world coordinates into the camera's, in which
  // the camera looks down its own -z
  pub fn lookAt(eye Vec3, target Vec3, up Vec3) Mat4 {
    imm fwd = (target - eye).normalize();
    imm side = fwd.cross(up).normalize();
    imm nup = side.cross(fwd);
    Mat4[[side.x, nup.x, -fwd.x, 0f,
      side.y, nup.y, -fwd.y, 0f,
      side.z, nup.z, -fwd.z, 0f,
      -side.dot(eye), -nup.dot(eye), fwd.dot(eye), 1f]];
  }

  // The inverse of lookAt: something at 'eye' facing 'target', its own -z
  // pointing at it. This one carries its local coordinates into the world's,
  // to place a thing, where lookAt makes a camera's view
  pub fn targetTo(eye Vec3, target Vec3, up Vec3) Mat4 {
    imm fwd = (target - eye).normalize();
    imm side = fwd.cross(up).normalize();
    imm nup = side.cross(fwd);
    Mat4[[side.x, side.y, side.z, 0f,
      nup.x, nup.y, nup.z, 0f,
      -fwd.x, -fwd.y, -fwd.z, 0f,
      eye.x, eye.y, eye.z, 1f]];
  }

  // The cell in row 'row' and column 'col', each 0 to 3
  pub fn cell(self, row usize, col usize) f32 {m[4usize * col + row];}

  // Its translation: where it carries the origin
  pub fn translation(self) Vec3 {Vec3[m[12], m[13], m[14]];}

  // The matrix with its first three columns scaled by s.x, s.y and s.z: the
  // scaling happens before what the matrix already does
  pub fn scale(self, s Vec3) Mat4 {
    mut r = self;
    r.m[0] = m[0] * s.x;
    r.m[1] = m[1] * s.x;
    r.m[2] = m[2] * s.x;
    r.m[4] = m[4] * s.y;
    r.m[5] = m[5] * s.y;
    r.m[6] = m[6] * s.y;
    r.m[8] = m[8] * s.z;
    r.m[9] = m[9] * s.z;
    r.m[10] = m[10] * s.z;
    r;
  }

  // The matrix with its translation replaced by t
  pub fn withTranslation(self, t Vec3) Mat4 {
    mut r = self;
    r.m[12] = t.x;
    r.m[13] = t.y;
    r.m[14] = t.z;
    r;
  }

  // The matrix product: o applied first, then self
  pub fn mult overload `*`(self, o Mat4) Mat4 {
    mut r = Mat4[[16; 0f]];
    mut col = 0usize;
    while col < 4usize {
      imm c = 4usize * col;
      mut row = 0usize;
      while row < 4usize {
        r.m[c + row] = m[row] * o.m[c] + m[4usize + row] * o.m[c + 1usize]
          + m[8usize + row] * o.m[c + 2usize] + m[12usize + row] * o.m[c + 3usize];
        row = row + 1usize;
      };
      col = col + 1usize;
    };
    r;
  }

  // The point p carried through the matrix, its w taken as 1 and the result's
  // w dropped: right for every placement, but not for a projection (see
  // projectPoint). 'm * p' is the same
  pub fn transformPoint overload `*`(self, p Vec3) Vec3 {
    Vec3[m[0] * p.x + m[4] * p.y + m[8] * p.z + m[12],
      m[1] * p.x + m[5] * p.y + m[9] * p.z + m[13],
      m[2] * p.x + m[6] * p.y + m[10] * p.z + m[14]];
  }

  // The four components carried through the matrix
  pub fn transformVec4 overload `*`(self, v Vec4) Vec4 {
    Vec4[m[0] * v.x + m[4] * v.y + m[8] * v.z + m[12] * v.w,
      m[1] * v.x + m[5] * v.y + m[9] * v.z + m[13] * v.w,
      m[2] * v.x + m[6] * v.y + m[10] * v.z + m[14] * v.w,
      m[3] * v.x + m[7] * v.y + m[11] * v.z + m[15] * v.w];
  }

  // The direction v carried through the matrix: turned and scaled, not moved
  pub fn transformVector(self, v Vec3) Vec3 {
    Vec3[m[0] * v.x + m[4] * v.y + m[8] * v.z,
      m[1] * v.x + m[5] * v.y + m[9] * v.z,
      m[2] * v.x + m[6] * v.y + m[10] * v.z];
  }

  // The point p carried through the matrix and divided by the w that comes
  // out: through a projection, where p lands on the screen, and its depth
  pub fn projectPoint(self, p Vec3) Vec3 {
    imm h = self * p.extend(1.);
    h.xyz() * (1. / h.w);
  }

  // Rows and columns exchanged
  pub fn transpose(self) Mat4 {
    Mat4[[m[0], m[4], m[8], m[12],  m[1], m[5], m[9], m[13],
      m[2], m[6], m[10], m[14],  m[3], m[7], m[11], m[15]]];
  }

  pub fn determinant(self) f32 {
    imm b00 = m[0] * m[5] - m[1] * m[4];
    imm b01 = m[0] * m[6] - m[2] * m[4];
    imm b02 = m[0] * m[7] - m[3] * m[4];
    imm b03 = m[1] * m[6] - m[2] * m[5];
    imm b04 = m[1] * m[7] - m[3] * m[5];
    imm b05 = m[2] * m[7] - m[3] * m[6];
    imm b06 = m[8] * m[13] - m[9] * m[12];
    imm b07 = m[8] * m[14] - m[10] * m[12];
    imm b08 = m[8] * m[15] - m[11] * m[12];
    imm b09 = m[9] * m[14] - m[10] * m[13];
    imm b10 = m[9] * m[15] - m[11] * m[13];
    imm b11 = m[10] * m[15] - m[11] * m[14];
    b00 * b11 - b01 * b10 + b02 * b09 + b03 * b08 - b04 * b07 + b05 * b06;
  }

  // The matrix that undoes this one, for any matrix, a projection included
  // (by cofactors, as gl-matrix has it). A matrix that flattens space
  // (determinant 0) has none, and gives all zeros
  pub fn inverse(self) Mat4 {
    imm b00 = m[0] * m[5] - m[1] * m[4];
    imm b01 = m[0] * m[6] - m[2] * m[4];
    imm b02 = m[0] * m[7] - m[3] * m[4];
    imm b03 = m[1] * m[6] - m[2] * m[5];
    imm b04 = m[1] * m[7] - m[3] * m[5];
    imm b05 = m[2] * m[7] - m[3] * m[6];
    imm b06 = m[8] * m[13] - m[9] * m[12];
    imm b07 = m[8] * m[14] - m[10] * m[12];
    imm b08 = m[8] * m[15] - m[11] * m[12];
    imm b09 = m[9] * m[14] - m[10] * m[13];
    imm b10 = m[9] * m[15] - m[11] * m[13];
    imm b11 = m[10] * m[15] - m[11] * m[14];
    imm det = b00 * b11 - b01 * b10 + b02 * b09 + b03 * b08 - b04 * b07 + b05 * b06;
    if det == 0. {return Mat4[[16; 0f]];}
    imm inv = 1. / det;
    Mat4[[(m[5] * b11 - m[6] * b10 + m[7] * b09) * inv,
      (m[2] * b10 - m[1] * b11 - m[3] * b09) * inv,
      (m[13] * b05 - m[14] * b04 + m[15] * b03) * inv,
      (m[10] * b04 - m[9] * b05 - m[11] * b03) * inv,
      (m[6] * b08 - m[4] * b11 - m[7] * b07) * inv,
      (m[0] * b11 - m[2] * b08 + m[3] * b07) * inv,
      (m[14] * b02 - m[12] * b05 - m[15] * b01) * inv,
      (m[8] * b05 - m[10] * b02 + m[11] * b01) * inv,
      (m[4] * b10 - m[5] * b08 + m[7] * b06) * inv,
      (m[1] * b08 - m[0] * b10 - m[3] * b06) * inv,
      (m[12] * b04 - m[13] * b02 + m[15] * b00) * inv,
      (m[9] * b02 - m[8] * b04 - m[11] * b00) * inv,
      (m[5] * b07 - m[4] * b09 - m[6] * b06) * inv,
      (m[0] * b09 - m[1] * b07 + m[2] * b06) * inv,
      (m[13] * b01 - m[12] * b03 - m[14] * b00) * inv,
      (m[8] * b03 - m[9] * b01 + m[10] * b00) * inv]];
  }
}

// ======== Transforms: Transform3 in space, Transform2 in the plane ========
//
// Placements kept as their parts. A transform scales first, then turns, then moves, as Mat4.fromTrs does.
// Composing two keeps that form, which is exact while the scaling is the
// same along every axis (or the turns are about the scaled axes); a shear
// that scaling along one axis then turning would make cannot be held, and a
// Mat4 is then the placement to use. The inverse is exact on the same terms.

// A placement in space: scaled by 'scale', turned by 'rotation', then moved by
// 'translation'
pub struct Transform3 {
  pub translation Vec3;
  pub rotation Quat;
  pub scale Vec3;

  // Leaving everything where it is
  pub fn identity() Transform3 {Transform3[Vec3[0., 0., 0.], Quat.identity(), Vec3[1., 1., 1.]];}

  // Where the point p, in the placed thing's coordinates, is in its parent's
  pub fn transformPoint(self, p Vec3) Vec3 {rotation * (p * scale) + translation;}

  // A direction in the placed thing's coordinates, in its parent's: turned
  // and scaled, not moved
  pub fn transformVector(self, v Vec3) Vec3 {rotation * (v * scale);}

  // o placed within self: o applied first, then self
  pub fn mult overload `*`(self, o Transform3) Transform3 {
    Transform3[transformPoint(o.translation), rotation * o.rotation, scale * o.scale];
  }

  // The placement that undoes this one
  pub fn inverse(self) Transform3 {
    imm inv = Vec3[1. / scale.x, 1. / scale.y, 1. / scale.z];
    imm back = rotation.conjugate();
    Transform3[-((back * translation) * inv), back, inv];
  }

  // The same placement as a matrix
  pub fn toMat4(self) Mat4 {Mat4.fromTrs(translation, rotation, scale);}
}

// A placement in the plane: scaled by 'scale', turned 'angle' radians
// counterclockwise, then moved by 'translation'
pub struct Transform2 {
  pub translation Vec2;
  pub angle f32;
  pub scale Vec2;

  // Leaving everything where it is
  pub fn identity() Transform2 {Transform2[Vec2[0., 0.], 0., Vec2[1., 1.]];}

  // Where the point p, in the placed thing's coordinates, is in its parent's
  pub fn transformPoint(self, p Vec2) Vec2 {(p * scale).rotate(angle) + translation;}

  // A direction, turned and scaled, not moved
  pub fn transformVector(self, v Vec2) Vec2 {(v * scale).rotate(angle);}

  // o placed within self: o applied first, then self
  pub fn mult overload `*`(self, o Transform2) Transform2 {
    Transform2[transformPoint(o.translation), angle + o.angle, scale * o.scale];
  }

  // The placement that undoes this one
  pub fn inverse(self) Transform2 {
    imm inv = Vec2[1. / scale.x, 1. / scale.y];
    Transform2[-(translation.rotate(-angle) * inv), -angle, inv];
  }

  // The same placement as a 3x3 matrix, which carries a 2-D point p as
  // (p.x, p.y, 1): see Mat3.transformPoint2
  pub fn toMat3(self) Mat3 {
    imm c = cos(angle);
    imm s = sin(angle);
    Mat3[[c * scale.x, s * scale.x, 0f,
      -s * scale.y, c * scale.y, 0f,
      translation.x, translation.y, 1f]];
  }
}

// ======== Shapes ========
//
// Boxes, rectangles, circles, spheres, planes and frusta, and the tests of a
// point, a box or a sphere against them.

// What a test of a box or a sphere against a frustum answers
pub const Outside = 0;         // wholly outside: nothing of it can be seen
pub const Inside = 1;          // wholly inside
pub const Intersecting = 2;    // partly inside, or too near a corner to tell

// -------- boxes --------

// An axis-aligned box in space: every point from 'min' to 'max'. A box with
// min above max on any axis holds nothing: 'empty' makes one, to grow with
// 'enclose' or 'union'
pub struct Aabb3 {
  pub min Vec3;
  pub max Vec3;

  // The box holding nothing, which any point or box added makes that point or box
  pub fn empty() Aabb3 {Aabb3[Vec3[huge, huge, huge], Vec3[-huge, -huge, -huge]];}

  // The box centred at 'center', reaching 'halfExtents' from it along each axis
  pub fn fromCenter(center Vec3, halfExtents Vec3) Aabb3 {
    Aabb3[center - halfExtents, center + halfExtents];
  }

  // The smallest box holding every point; empty if there are none
  pub fn fromPoints(points &[]Vec3) Aabb3 {
    mut b = empty();
    mut i = 0usize;
    while i < points.len {
      b = b.enclose(points[i]);
      i = i + 1usize;
    }
    b;
  }

  pub fn isEmpty(self) Bool {min.x > max.x or min.y > max.y or min.z > max.z;}
  pub fn center(self) Vec3 {(min + max) * 0.5;}
  pub fn size(self) Vec3 {max - min;}
  pub fn halfExtents(self) Vec3 {(max - min) * 0.5;}

  // The smallest box holding both
  pub fn union(self, o Aabb3) Aabb3 {Aabb3[min.min(o.min), max.max(o.max)];}

  // The smallest box holding self and the point p
  pub fn enclose(self, p Vec3) Aabb3 {Aabb3[min.min(p), max.max(p)];}

  // Grown by 'margin' on every side (shrunk, if it is negative)
  pub fn expand(self, margin f32) Aabb3 {
    imm m = Vec3[margin, margin, margin];
    Aabb3[min - m, max + m];
  }

  // Whether p is in the box, its faces included
  pub fn contains(self, p Vec3) Bool {
    p.x >= min.x and p.x <= max.x and p.y >= min.y and p.y <= max.y
      and p.z >= min.z and p.z <= max.z;
  }

  // Whether the two share any point, touching faces included
  pub fn overlaps(self, o Aabb3) Bool {
    min.x <= o.max.x and max.x >= o.min.x and min.y <= o.max.y and max.y >= o.min.y
      and min.z <= o.max.z and max.z >= o.min.z;
  }

  // The point of the box nearest p: p itself when it is inside
  pub fn closestPoint(self, p Vec3) Vec3 {p.clamp(min, max);}

  // The smallest box holding this one carried through m, a placement (not a
  // projection): its centre carried as a point, and its reach along each new
  // axis the sum of the old reaches, each times how far m leans it that way
  // (Arvo's method)
  pub fn transformed(self, m Mat4) Aabb3 {
    imm c = m * center();
    imm h = halfExtents();
    imm e = Vec3[fabs(m.m[0]) * h.x + fabs(m.m[4]) * h.y + fabs(m.m[8]) * h.z,
      fabs(m.m[1]) * h.x + fabs(m.m[5]) * h.y + fabs(m.m[9]) * h.z,
      fabs(m.m[2]) * h.x + fabs(m.m[6]) * h.y + fabs(m.m[10]) * h.z];
    Aabb3[c - e, c + e];
  }
}

// An axis-aligned box in the plane: every point from 'min' to 'max'
pub struct Aabb2 {
  pub min Vec2;
  pub max Vec2;

  pub fn empty() Aabb2 {Aabb2[Vec2[huge, huge], Vec2[-huge, -huge]];}

  pub fn fromCenter(center Vec2, halfExtents Vec2) Aabb2 {
    Aabb2[center - halfExtents, center + halfExtents];
  }

  pub fn fromPoints(points &[]Vec2) Aabb2 {
    mut b = empty();
    mut i = 0usize;
    while i < points.len {
      b = b.enclose(points[i]);
      i = i + 1usize;
    }
    b;
  }

  pub fn isEmpty(self) Bool {min.x > max.x or min.y > max.y;}
  pub fn center(self) Vec2 {(min + max) * 0.5;}
  pub fn size(self) Vec2 {max - min;}
  pub fn halfExtents(self) Vec2 {(max - min) * 0.5;}
  pub fn union(self, o Aabb2) Aabb2 {Aabb2[min.min(o.min), max.max(o.max)];}
  pub fn enclose(self, p Vec2) Aabb2 {Aabb2[min.min(p), max.max(p)];}

  pub fn expand(self, margin f32) Aabb2 {
    imm m = Vec2[margin, margin];
    Aabb2[min - m, max + m];
  }

  pub fn contains(self, p Vec2) Bool {
    p.x >= min.x and p.x <= max.x and p.y >= min.y and p.y <= max.y;
  }

  pub fn overlaps(self, o Aabb2) Bool {
    min.x <= o.max.x and max.x >= o.min.x and min.y <= o.max.y and max.y >= o.min.y;
  }

  pub fn closestPoint(self, p Vec2) Vec2 {p.clamp(min, max);}

  // The smallest box holding this one carried through a 2-D placement
  pub fn transformed(self, m Mat3) Aabb2 {
    imm c = m.transformPoint2(center());
    imm h = halfExtents();
    imm e = Vec2[fabs(m.m[0]) * h.x + fabs(m.m[3]) * h.y, fabs(m.m[1]) * h.x + fabs(m.m[4]) * h.y];
    Aabb2[c - e, c + e];
  }
}

// -------- rectangles --------

// A rectangle in the plane: its corner at (x, y), 'w' wide and 'h' high. It
// holds its left and bottom edges but not its right and top, so rectangles
// laid side by side share no point
pub struct Rect {
  pub x f32;
  pub y f32;
  pub w f32;
  pub h f32;

  pub fn min(self) Vec2 {Vec2[x, y];}
  pub fn max(self) Vec2 {Vec2[x + w, y + h];}
  pub fn center(self) Vec2 {Vec2[x + w * 0.5, y + h * 0.5];}
  pub fn size(self) Vec2 {Vec2[w, h];}
  pub fn contains(self, p Vec2) Bool {p.x >= x and p.x < x + w and p.y >= y and p.y < y + h;}
  pub fn toAabb(self) Aabb2 {Aabb2[min(), max()];}
}

// A rectangle of whole pixels: its corner at (x, y), 'w' wide and 'h' high,
// holding the pixels from x to x + w - 1 and y to y + h - 1
pub struct IRect {
  pub x i32;
  pub y i32;
  pub w i32;
  pub h i32;

  pub fn contains(self, px i32, py i32) Bool {px >= x and px < x + w and py >= y and py < y + h;}
  pub fn toRect(self) Rect {Rect[f32[x], f32[y], f32[w], f32[h]];}
}

// -------- round shapes --------

// A disc in the plane: the points no further than 'radius' from 'center'
pub struct Circle {
  pub center Vec2;
  pub radius f32;

  pub fn contains(self, p Vec2) Bool {p.distanceSquared(center) <= radius * radius;}

  // The point of the disc nearest p: p itself when it is inside
  pub fn closestPoint(self, p Vec2) Vec2 {
    imm d = p - center;
    imm len2 = d.lengthSquared();
    if len2 <= radius * radius {p;} else {center + d * (radius / len2.sqrt());};
  }

  pub fn overlaps(self, o Circle) Bool {
    imm r = radius + o.radius;
    center.distanceSquared(o.center) <= r * r;
  }
}

// A ball in space: the points no further than 'radius' from 'center'
pub struct Sphere {
  pub center Vec3;
  pub radius f32;

  pub fn contains(self, p Vec3) Bool {p.distanceSquared(center) <= radius * radius;}

  // The point of the ball nearest p: p itself when it is inside
  pub fn closestPoint(self, p Vec3) Vec3 {
    imm d = p - center;
    imm len2 = d.lengthSquared();
    if len2 <= radius * radius {p;} else {center + d * (radius / len2.sqrt());};
  }

  pub fn overlaps(self, o Sphere) Bool {
    imm r = radius + o.radius;
    center.distanceSquared(o.center) <= r * r;
  }

  // Whether the ball and the box share any point
  pub fn overlapsAabb(self, b Aabb3) Bool {
    b.closestPoint(center).distanceSquared(center) <= radius * radius;
  }
}

// -------- planes --------

// A plane: the points p where normal.dot(p) + d = 0. The normal points to its
// positive side; with a unit normal, 'signedDistance' is a distance
pub struct Plane {
  pub normal Vec3;
  pub d f32;

  // The plane through 'point' facing 'normal', which is normalized here
  pub fn fromPointNormal(point Vec3, normal Vec3) Plane {
    imm n = normal.normalize();
    Plane[n, -n.dot(point)];
  }

  // The plane through three points, facing the side from which they run
  // counterclockwise
  pub fn fromPoints(a Vec3, b Vec3, c Vec3) Plane {fromPointNormal(a, (b - a).cross(c - a));}

  // The same plane with a unit normal
  pub fn normalize(self) Plane {
    imm len = normal.length();
    if len > 0. {Plane[normal * (1. / len), d / len];} else {self;};
  }

  // How far p is from the plane, positive on the side the normal faces
  // (in units of the normal's length)
  pub fn signedDistance(self, p Vec3) f32 {normal.dot(p) + d;}

  // The point of the plane nearest p
  pub fn closestPoint(self, p Vec3) Vec3 {
    p - normal * (signedDistance(p) / normal.lengthSquared());
  }
}

// -------- frusta --------

// What a camera can see: the space inside six planes, each facing inward,
// in the order left, right, bottom, top, near, far
pub struct Frustum {
  pub planes [6; Plane];

  // The frustum a view-projection matrix sees, for the depth from 0 to 1 that
  // Mat4.perspective and Mat4.orthographic make (Gribb and Hartmann's method:
  // each plane is a sum or difference of the matrix's rows)
  pub fn fromMatrix(vp Mat4) Frustum {fromRows(vp, false);}

  // The same, for OpenGL's depth from -1 to 1 (Mat4.perspectiveGl)
  pub fn fromMatrixGl(vp Mat4) Frustum {fromRows(vp, true);}

  fn fromRows(vp Mat4, gl Bool) Frustum {
    imm m = vp.m;
    // Row i of the matrix is (m[i], m[4 + i], m[8 + i], m[12 + i]); a point
    // is inside when -w <= x <= w, -w <= y <= w and 0 <= z <= w (or -w <= z)
    imm r0 = Vec4[m[0], m[4], m[8], m[12]];
    imm r1 = Vec4[m[1], m[5], m[9], m[13]];
    imm r2 = Vec4[m[2], m[6], m[10], m[14]];
    imm r3 = Vec4[m[3], m[7], m[11], m[15]];
    imm near = if gl {r3 + r2;} else {r2;};
    Frustum[[plane(r3 + r0), plane(r3 - r0), plane(r3 + r1), plane(r3 - r1),
      plane(near), plane(r3 - r2)]];
  }

  fn plane(v Vec4) Plane {Plane[Vec3[v.x, v.y, v.z], v.w].normalize();}

  // Whether p is inside, on a plane counting as inside
  pub fn containsPoint(self, p Vec3) Bool {
    mut i = 0usize;
    while i < 6usize {
      if planes[i].signedDistance(p) < 0. {return false;}
      i = i + 1usize;
    }
    true;
  }

  // Whether the sphere is Outside, Inside or Intersecting
  pub fn testSphere(self, s Sphere) i32 {
    mut result = Inside;
    mut i = 0usize;
    while i < 6usize {
      imm dist = planes[i].signedDistance(s.center);
      if dist < -s.radius {return Outside;}
      if dist < s.radius {result = Intersecting;}
      i = i + 1usize;
    }
    result;
  }

  // Whether the box is Outside, Inside or Intersecting. For each plane it
  // takes the corner furthest along the plane's normal: if that is outside,
  // so is the box. A box near a corner of the frustum, outside it but not
  // wholly behind any one plane, is answered Intersecting
  pub fn testAabb(self, b Aabb3) i32 {
    mut result = Inside;
    mut i = 0usize;
    while i < 6usize {
      imm n = planes[i].normal;
      imm far = Vec3[if n.x >= 0. {b.max.x;} else {b.min.x;},
        if n.y >= 0. {b.max.y;} else {b.min.y;},
        if n.z >= 0. {b.max.z;} else {b.min.z;}];
      imm near = Vec3[if n.x >= 0. {b.min.x;} else {b.max.x;},
        if n.y >= 0. {b.min.y;} else {b.max.y;},
        if n.z >= 0. {b.min.z;} else {b.max.z;}];
      if planes[i].signedDistance(far) < 0. {return Outside;}
      if planes[i].signedDistance(near) < 0. {result = Intersecting;}
      i = i + 1usize;
    }
    result;
  }

  // Whether any of the sphere or box may be seen: not Outside
  pub fn intersectsSphere(self, s Sphere) Bool {testSphere(s) != Outside;}
  pub fn intersectsAabb(self, b Aabb3) Bool {testAabb(b) != Outside;}
}

// ======== Rays ========
//
// Rays and the hits they make; segments, triangles and the closest points on
// them.
//
// A hit is the multiple t of the ray's direction at which it happens, so the
// point hit is 'ray.at(t)', and with a unit direction t is the distance. Only
// t >= 0 counts: what is behind the origin is missed.

// A half-line in space: from 'origin', along 'direction'
pub struct Ray3 {
  pub origin Vec3;
  pub direction Vec3;

  // The point t directions along
  pub fn at(self, t f32) Vec3 {origin + direction * t;}

  // Where it crosses the plane; a ray running along the plane misses it
  pub fn intersectPlane(self, p Plane) Option[f32] {
    imm denom = p.normal.dot(direction);
    if fabs(denom) < 0.000001 {return None[f32][];}
    imm t = -p.signedDistance(origin) / denom;
    if t >= 0. {Some[f32][t];} else {None[f32][];};
  }

  // Where it first enters the ball; 0 when it starts inside
  // (Ericson, Real-Time Collision Detection, 5.3.2)
  pub fn intersectSphere(self, s Sphere) Option[f32] {
    imm m = origin - s.center;
    imm a = direction.dot(direction);
    imm b = m.dot(direction);
    imm c = m.dot(m) - s.radius * s.radius;
    if c <= 0. {return Some[f32][0.];}
    // Outside and pointing away
    if b > 0. {return None[f32][];}
    imm disc = b * b - a * c;
    if disc < 0. {return None[f32][];}
    Some[f32][(-b - disc.sqrt()) / a];
  }

  // Where it first enters the box; 0 when it starts inside. Between the
  // two planes of each axis, the ray is inside for a span of t (the slab
  // test); it is in the box where the three spans overlap
  pub fn intersectAabb(self, b Aabb3) Option[f32] {
    mut enter f32 = 0.;
    mut exit = huge;
    imm sx = slab(origin.x, direction.x, b.min.x, b.max.x);
    imm sy = slab(origin.y, direction.y, b.min.y, b.max.y);
    imm sz = slab(origin.z, direction.z, b.min.z, b.max.z);
    enter = fmax(enter, fmax(sx.x, fmax(sy.x, sz.x)));
    exit = fmin(exit, fmin(sx.y, fmin(sy.y, sz.y)));
    if enter <= exit {Some[f32][enter];} else {None[f32][];};
  }

  // Where it hits the triangle a, b, c, from either side
  // (Moller and Trumbore's method)
  pub fn intersectTriangle(self, a Vec3, b Vec3, c Vec3) Option[f32] {
    imm e1 = b - a;
    imm e2 = c - a;
    imm p = direction.cross(e2);
    imm det = e1.dot(p);
    // Running along the triangle's plane
    if fabs(det) < 0.0000001 {return None[f32][];}
    imm inv = 1. / det;
    imm s = origin - a;
    imm u = s.dot(p) * inv;
    if u < 0. or u > 1. {return None[f32][];}
    imm q = s.cross(e1);
    imm v = direction.dot(q) * inv;
    if v < 0. or u + v > 1. {return None[f32][];}
    imm t = e2.dot(q) * inv;
    if t >= 0. {Some[f32][t];} else {None[f32][];};
  }

  // The point of the ray nearest p
  pub fn closestPoint(self, p Vec3) Vec3 {
    imm len2 = direction.lengthSquared();
    if len2 == 0. {return origin;}
    at(fmax(0., (p - origin).dot(direction) / len2));
  }
}

// The span of t, as (enter, exit), in which o + t d lies between lo and hi.
// A ray running parallel to the planes is inside for every t, or for none
fn slab(o f32, d f32, lo f32, hi f32) Vec2 {
  if d == 0. {
    if o < lo or o > hi {return Vec2[huge, -huge];}
    return Vec2[-huge, huge];
  }
  imm inv = 1. / d;
  imm t1 = (lo - o) * inv;
  imm t2 = (hi - o) * inv;
  Vec2[fmin(t1, t2), fmax(t1, t2)];
}

// A half-line in the plane: from 'origin', along 'direction'
pub struct Ray2 {
  pub origin Vec2;
  pub direction Vec2;

  pub fn at(self, t f32) Vec2 {origin + direction * t;}

  // Where it crosses the segment from a to b, ends included. A ray running
  // along the segment's line misses it
  pub fn intersectSegment(self, a Vec2, b Vec2) Option[f32] {
    // origin + t direction = a + s (b - a): crossing both sides with (b - a)
    // leaves t, and with direction leaves s
    imm e = b - a;
    imm denom = direction.cross(e);
    if fabs(denom) < 0.0000001 {return None[f32][];}
    imm w = a - origin;
    imm t = w.cross(e) / denom;
    imm s = w.cross(direction) / denom;
    if t >= 0. and s >= 0. and s <= 1. {Some[f32][t];} else {None[f32][];};
  }

  // Where it first enters the disc; 0 when it starts inside
  pub fn intersectCircle(self, c Circle) Option[f32] {
    imm m = origin - c.center;
    imm a = direction.dot(direction);
    imm b = m.dot(direction);
    imm cc = m.dot(m) - c.radius * c.radius;
    if cc <= 0. {return Some[f32][0.];}
    if b > 0. {return None[f32][];}
    imm disc = b * b - a * cc;
    if disc < 0. {return None[f32][];}
    Some[f32][(-b - disc.sqrt()) / a];
  }

  // The point of the ray nearest p
  pub fn closestPoint(self, p Vec2) Vec2 {
    imm len2 = direction.lengthSquared();
    if len2 == 0. {return origin;}
    at(fmax(0., (p - origin).dot(direction) / len2));
  }
}

// Where the segment from p1 to p2 crosses the one from q1 to q2, ends
// included. Segments on one line are taken as not crossing
pub fn segmentIntersection(p1 Vec2, p2 Vec2, q1 Vec2, q2 Vec2) Option[Vec2] {
  imm r = p2 - p1;
  imm e = q2 - q1;
  imm denom = r.cross(e);
  if fabs(denom) < 0.0000001 {return None[Vec2][];}
  imm w = q1 - p1;
  imm t = w.cross(e) / denom;
  imm s = w.cross(r) / denom;
  if t >= 0. and t <= 1. and s >= 0. and s <= 1. {Some[Vec2][p1 + r * t];} else {None[Vec2][];};
}

// The point of the segment from a to b nearest p
pub fn closestPointOnSegment3 overload closestPointOnSegment(p Vec3, a Vec3, b Vec3) Vec3 {
  imm ab = b - a;
  imm len2 = ab.lengthSquared();
  if len2 == 0. {return a;}
  a + ab * fclamp((p - a).dot(ab) / len2, 0., 1.);
}

pub fn closestPointOnSegment2 overload closestPointOnSegment(p Vec2, a Vec2, b Vec2) Vec2 {
  imm ab = b - a;
  imm len2 = ab.lengthSquared();
  if len2 == 0. {return a;}
  a + ab * fclamp((p - a).dot(ab) / len2, 0., 1.);
}

// The point of the triangle a, b, c nearest p: which of its corners, edges or
// face is nearest is found from where p lies against each (Ericson,
// Real-Time Collision Detection, 5.1.5)
pub fn closestPointOnTriangle(p Vec3, a Vec3, b Vec3, c Vec3) Vec3 {
  imm ab = b - a;
  imm ac = c - a;
  imm ap = p - a;
  imm d1 = ab.dot(ap);
  imm d2 = ac.dot(ap);
  if d1 <= 0. and d2 <= 0. {return a;}
  imm bp = p - b;
  imm d3 = ab.dot(bp);
  imm d4 = ac.dot(bp);
  if d3 >= 0. and d4 <= d3 {return b;}
  imm vc = d1 * d4 - d3 * d2;
  if vc <= 0. and d1 >= 0. and d3 <= 0. {return a + ab * (d1 / (d1 - d3));}
  imm cp = p - c;
  imm d5 = ab.dot(cp);
  imm d6 = ac.dot(cp);
  if d6 >= 0. and d5 <= d6 {return c;}
  imm vb = d5 * d2 - d1 * d6;
  if vb <= 0. and d2 >= 0. and d6 <= 0. {return a + ac * (d2 / (d2 - d6));}
  imm va = d3 * d6 - d5 * d4;
  if va <= 0. and d4 - d3 >= 0. and d5 - d6 >= 0. {
    return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6)));
  }
  imm denom = 1. / (va + vb + vc);
  a + ab * (vb * denom) + ac * (vc * denom);
}

// The weights (u, v, w) of the corners a, b and c that make p, the point of
// their plane nearest it: p = u a + v b + w c, and u + v + w = 1
pub fn barycentric(p Vec3, a Vec3, b Vec3, c Vec3) Vec3 {
  imm v0 = b - a;
  imm v1 = c - a;
  imm v2 = p - a;
  imm d00 = v0.dot(v0);
  imm d01 = v0.dot(v1);
  imm d11 = v1.dot(v1);
  imm d20 = v2.dot(v0);
  imm d21 = v2.dot(v1);
  imm denom = d00 * d11 - d01 * d01;
  imm v = (d11 * d20 - d01 * d21) / denom;
  imm w = (d00 * d21 - d01 * d20) / denom;
  Vec3[1. - v - w, v, w];
}

// ======== Curves ========
//
// Bezier curves, quadratic and cubic, in the plane and in space; and
// polylines, runs of points joined by straight segments.
//
// A Bezier curve runs from its first control point (t = 0) to its last
// (t = 1), drawn towards the ones between. 'point' is where it is at t, and
// 'tangent' which way and how fast it is going there: the derivative, not
// normalized, so its length is the speed along the curve as t runs. 'sample'
// makes it a polyline of 'segments' straight pieces, evenly spaced in t.

// A quadratic Bezier curve in the plane: from p0 to p2, drawn towards p1
pub struct QuadraticBezier2 {
  pub p0 Vec2;
  pub p1 Vec2;
  pub p2 Vec2;

  pub fn point(self, t f32) Vec2 {
    imm u = 1. - t;
    p0 * (u * u) + p1 * (2. * u * t) + p2 * (t * t);
  }

  pub fn tangent(self, t f32) Vec2 {(p1 - p0) * (2. * (1. - t)) + (p2 - p1) * (2. * t);}

  pub fn sample(self, segments u32) List[Vec2] {
    mut pts = List[Vec2].withCapacity(usize[segments] + 1usize);
    mut i = 0u32;
    while i <= segments {
      pts.push(point(f32[i] / f32[segments]));
      i = i + 1u32;
    }
    pts;
  }
}

// A cubic Bezier curve in the plane: from p0 to p3, leaving p0 towards p1 and
// arriving at p3 from p2
pub struct CubicBezier2 {
  pub p0 Vec2;
  pub p1 Vec2;
  pub p2 Vec2;
  pub p3 Vec2;

  pub fn point(self, t f32) Vec2 {
    imm u = 1. - t;
    p0 * (u * u * u) + p1 * (3. * u * u * t) + p2 * (3. * u * t * t) + p3 * (t * t * t);
  }

  pub fn tangent(self, t f32) Vec2 {
    imm u = 1. - t;
    (p1 - p0) * (3. * u * u) + (p2 - p1) * (6. * u * t) + (p3 - p2) * (3. * t * t);
  }

  pub fn sample(self, segments u32) List[Vec2] {
    mut pts = List[Vec2].withCapacity(usize[segments] + 1usize);
    mut i = 0u32;
    while i <= segments {
      pts.push(point(f32[i] / f32[segments]));
      i = i + 1u32;
    }
    pts;
  }
}

// A quadratic Bezier curve in space
pub struct QuadraticBezier3 {
  pub p0 Vec3;
  pub p1 Vec3;
  pub p2 Vec3;

  pub fn point(self, t f32) Vec3 {
    imm u = 1. - t;
    p0 * (u * u) + p1 * (2. * u * t) + p2 * (t * t);
  }

  pub fn tangent(self, t f32) Vec3 {(p1 - p0) * (2. * (1. - t)) + (p2 - p1) * (2. * t);}

  pub fn sample(self, segments u32) List[Vec3] {
    mut pts = List[Vec3].withCapacity(usize[segments] + 1usize);
    mut i = 0u32;
    while i <= segments {
      pts.push(point(f32[i] / f32[segments]));
      i = i + 1u32;
    }
    pts;
  }
}

// A cubic Bezier curve in space
pub struct CubicBezier3 {
  pub p0 Vec3;
  pub p1 Vec3;
  pub p2 Vec3;
  pub p3 Vec3;

  pub fn point(self, t f32) Vec3 {
    imm u = 1. - t;
    p0 * (u * u * u) + p1 * (3. * u * u * t) + p2 * (3. * u * t * t) + p3 * (t * t * t);
  }

  pub fn tangent(self, t f32) Vec3 {
    imm u = 1. - t;
    (p1 - p0) * (3. * u * u) + (p2 - p1) * (6. * u * t) + (p3 - p2) * (3. * t * t);
  }

  pub fn sample(self, segments u32) List[Vec3] {
    mut pts = List[Vec3].withCapacity(usize[segments] + 1usize);
    mut i = 0u32;
    while i <= segments {
      pts.push(point(f32[i] / f32[segments]));
      i = i + 1u32;
    }
    pts;
  }
}

// -------- polylines --------

// The length of the polyline through the points, in order
pub fn polylineLength2 overload polylineLength(points &[]Vec2) f32 {
  mut len f32 = 0.;
  mut i = 1usize;
  while i < points.len {
    len = len + points[i].distance(points[i - 1usize]);
    i = i + 1usize;
  }
  len;
}

pub fn polylineLength3 overload polylineLength(points &[]Vec3) f32 {
  mut len f32 = 0.;
  mut i = 1usize;
  while i < points.len {
    len = len + points[i].distance(points[i - 1usize]);
    i = i + 1usize;
  }
  len;
}

// The point 'distance' along the polyline from its first point, held to the
// polyline: at or before 0 its first point, at or past its length its last.
// No points at all give the origin
pub fn polylinePointAt2 overload polylinePointAt(points &[]Vec2, distance f32) Vec2 {
  if points.len == 0usize {return Vec2[0., 0.];}
  mut left = distance;
  mut i = 1usize;
  while i < points.len {
    imm a = points[i - 1usize];
    imm b = points[i];
    imm seg = a.distance(b);
    if left <= seg {
      if seg == 0. or left <= 0. {return a;}
      return a.lerp(b, left / seg);
    }
    left = left - seg;
    i = i + 1usize;
  }
  points[points.len - 1usize];
}

pub fn polylinePointAt3 overload polylinePointAt(points &[]Vec3, distance f32) Vec3 {
  if points.len == 0usize {return Vec3[0., 0., 0.];}
  mut left = distance;
  mut i = 1usize;
  while i < points.len {
    imm a = points[i - 1usize];
    imm b = points[i];
    imm seg = a.distance(b);
    if left <= seg {
      if seg == 0. or left <= 0. {return a;}
      return a.lerp(b, left / seg);
    }
    left = left - seg;
    i = i + 1usize;
  }
  points[points.len - 1usize];
}

// ======== Polygons ========
//
// Polygons in the plane, each given as its corners in order, the last joined
// back to the first: area and winding, point in polygon, convex hull and
// triangulation.

// Twice the area of the triangle o, a, b, signed: positive when the three run
// counterclockwise, 0 when they are on one line
fn turn(o Vec2, a Vec2, b Vec2) f32 {(a - o).cross(b - o);}

// The polygon's area, positive when its corners run counterclockwise and
// negative when they run clockwise (the shoelace formula)
pub fn polygonSignedArea(points &[]Vec2) f32 {
  mut sum f32 = 0.;
  mut i = 0usize;
  while i < points.len {
    imm j = if i + 1usize == points.len {0usize;} else {i + 1usize;};
    sum = sum + points[i].cross(points[j]);
    i = i + 1usize;
  }
  sum * 0.5;
}

// Whether the corners run counterclockwise
pub fn polygonIsCounterClockwise(points &[]Vec2) Bool {polygonSignedArea(points) > 0.;}

// Whether p is inside the polygon, by the even-odd rule: a ray from p to the
// right crosses its edges an odd number of times. A point exactly on an edge
// may be answered either way
pub fn polygonContains(points &[]Vec2, p Vec2) Bool {
  mut inside = false;
  if points.len == 0usize {return false;}
  mut j = points.len - 1usize;
  mut i = 0usize;
  while i < points.len {
    imm a = points[i];
    imm b = points[j];
    if (a.y > p.y) != (b.y > p.y) {
      imm crossX = a.x + (b.x - a.x) * (p.y - a.y) / (b.y - a.y);
      if p.x < crossX {inside = !inside;}
    }
    j = i;
    i = i + 1usize;
  }
  inside;
}

// Whether a comes before b: by x, then by y
fn before(a Vec2, b Vec2) Bool {a.x < b.x or (a.x == b.x and a.y < b.y);}

// Sort the points by x, then by y (heapsort, in place)
fn sortPoints(pts &mut List[Vec2]) {
  imm n = pts.len();
  if n < 2usize {return;}
  mut start = n / 2usize;
  while start > 0usize {
    start = start - 1usize;
    siftDown(pts, start, n);
  }
  mut end = n - 1usize;
  while end > 0usize {
    pts.swap(0usize, end);
    siftDown(pts, 0usize, end);
    end = end - 1usize;
  }
}

fn siftDown(pts &mut List[Vec2], start usize, end usize) {
  mut root = start;
  while 2usize * root + 1usize < end {
    mut child = 2usize * root + 1usize;
    if child + 1usize < end and before(*pts[child], *pts[child + 1usize]) {child = child + 1usize;}
    if !before(*pts[root], *pts[child]) {return;}
    pts.swap(root, child);
    root = child;
  }
}

// The convex hull: the smallest convex polygon holding every point, its
// corners counterclockwise from the one with the least x (and of those the
// least y). Points on its edges are not corners. Andrew's monotone chain: the
// points sorted by x, the lower hull is swept left to right and the upper
// right to left, each dropping a corner that does not turn left
pub fn convexHull(points &[]Vec2) List[Vec2] {
  mut sorted = List[Vec2].withCapacity(points.len);
  mut i = 0usize;
  while i < points.len {
    sorted.push(points[i]);
    i = i + 1usize;
  }
  sortPoints(&mut sorted);
  imm n = sorted.len();
  if n < 3usize {return sorted;}
  mut hull = List[Vec2].withCapacity(2usize * n);
  i = 0usize;
  while i < n {
    imm p = *sorted[i];
    while hull.len() >= 2usize and turn(*hull[hull.len() - 2usize], *hull[hull.len() - 1usize], p) <= 0. {
      hull.pop();
    }
    hull.push(p);
    i = i + 1usize;
  }
  imm lower = hull.len() + 1usize;
  i = n - 1usize;
  while i > 0usize {
    i = i - 1usize;
    imm p = *sorted[i];
    while hull.len() >= lower and turn(*hull[hull.len() - 2usize], *hull[hull.len() - 1usize], p) <= 0. {
      hull.pop();
    }
    hull.push(p);
  }
  // The last is the first again
  hull.pop();
  hull;
}

// Whether p is inside the triangle a, b, c or on its edges, the triangle
// running the way 'sign' says (1 counterclockwise, -1 clockwise)
fn inTriangle(p Vec2, a Vec2, b Vec2, c Vec2, sign f32) Bool {
  sign * turn(a, b, p) >= 0. and sign * turn(b, c, p) >= 0. and sign * turn(c, a, p) >= 0.;
}

// The polygon cut into triangles, as indices into 'points', three to a
// triangle, each running counterclockwise: n corners give n - 2 triangles.
// The polygon must be simple (its edges do not cross), and may run either
// way. Ear clipping: a corner that turns the polygon's way, with no other
// corner inside the triangle it makes with its neighbours, is cut off with
// that triangle, until three corners are left. O(n^2) for n corners, and
// more for many reflex corners. A polygon that is not simple, or has three
// corners on one line with no ear elsewhere, still gets n - 2 triangles, but
// some may overlap or have no area
pub fn triangulatePolygon(points &[]Vec2) List[u32] {
  mut tris = List[u32].empty();
  imm n = points.len;
  if n < 3usize {return tris;}
  imm sign f32 = if polygonSignedArea(points) < 0. {-1.;} else {1.;};
  // The corners still in the polygon, as a ring: each one's neighbours
  mut next = List[usize].withCapacity(n);
  mut prev = List[usize].withCapacity(n);
  mut i = 0usize;
  while i < n {
    next.push(if i + 1usize == n {0usize;} else {i + 1usize;});
    prev.push(if i == 0usize {n - 1usize;} else {i - 1usize;});
    i = i + 1usize;
  }
  mut left = n;
  mut cur = 0usize;
  mut tried = 0usize;
  while left > 3usize {
    imm p = *prev[cur];
    imm nx = *next[cur];
    // After a whole round with no ear, cut the corner anyway
    if tried > left or isEar(points, &next,p, cur, nx, sign) {
      emitTriangle(&mut tris, p, cur, nx, sign);
      next.set(p, nx);
      prev.set(nx, p);
      left = left - 1usize;
      tried = 0usize;
      cur = nx;
    } else {
      cur = nx;
      tried = tried + 1usize;
    }
  }
  emitTriangle(&mut tris, *prev[cur], cur, *next[cur], sign);
  tris;
}

// Whether the corner c, between p and nx, is an ear: it turns the polygon's
// way, and no other corner still in the polygon lies in its triangle
fn isEar(points &[]Vec2, next &List[usize],p usize, c usize, nx usize, sign f32) Bool {
  imm a = points[p];
  imm b = points[c];
  imm d = points[nx];
  if sign * turn(a, b, d) <= 0. {return false;}
  mut j = *next[nx];
  while j != p {
    imm q = points[j];
    // A corner at the same place as one of the three (where a polygon touches
    // itself) does not block the ear
    if !(q.equals(a) or q.equals(b) or q.equals(d)) and inTriangle(q, a, b, d, sign) {
      return false;
    }
    j = *next[j];
  }
  true;
}

// The triangle p, c, nx, counterclockwise
fn emitTriangle(tris &mut List[u32], p usize, c usize, nx usize, sign f32) {
  if sign > 0. {
    tris.push(u32[p]);
    tris.push(u32[c]);
    tris.push(u32[nx]);
  } else {
    tris.push(u32[nx]);
    tris.push(u32[c]);
    tris.push(u32[p]);
  }
}
