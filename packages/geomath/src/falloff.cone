// ======== Falloff curves: the weight of a brush or a soft selection by distance ========
//
// A falloff is a function from d, the distance from a centre as a fraction of
// a radius, to a weight: 1 at the centre (d = 0), 0 at the radius and beyond
// (d >= 1), and between them a shape. These are Blender's brush curve presets
// (Brush Curve > Falloff, and the proportional-editing falloffs), written as
// functions of p = 1 - d, the way in from the rim:
//
//   FalloffSmooth       3 p^2 - 2 p^3 (1 minus the cubic smoothstep of d): a soft peak and a soft rim
//   FalloffSmoothSharp  the smooth curve squared: a narrower peak, the same soft rim
//   FalloffRoot         sqrt(p): a bulging, pointed peak, a steep rim
//   FalloffSharp        p^2: a pointed peak, a long soft tail
//   FalloffLinear       p: a cone
//   FalloffSphere       sqrt(1 - d^2): the dome of a sphere, a flat peak and a vertical rim
//   FalloffConstant     1 inside the radius: a hard disc
//
// and two more that facerig used, now shared:
//
//   FalloffGauss        exp(-4.5 d^2), brought to 0 at d = 1 by a smoothstep from 0.7
//   FalloffPlateau      1 up to d = 0.5, then the smooth fall: a whole region moves as one
//
// A custom curve (a list of control points) needs a list, which this package
// does not make; sculpt's 'Falloff' holds one beside these.

pub const FalloffSmooth = 0u32;
pub const FalloffGauss = 1u32;
pub const FalloffPlateau = 2u32;
pub const FalloffSmoothSharp = 3u32;
pub const FalloffRoot = 4u32;
pub const FalloffSharp = 5u32;
pub const FalloffLinear = 6u32;
pub const FalloffSphere = 7u32;
pub const FalloffConstant = 8u32;

// The weight at distance fraction d (any number; below 0 counts as 0, 1 and
// beyond gives 0) of the preset 'kind'. An unknown kind gives FalloffSmooth.
pub fn falloffWeight(kind u32, d f32) f32 {
  if d >= 1. { return 0.; }
  let x = if d < 0. {0.;} else {d;};
  let p = 1. - x;
  if kind == FalloffGauss {
    let g = libc.expf(-4.5 * x * x);
    return g * (1. - falloffStep(0.7, 1., x));
  }
  if kind == FalloffPlateau { return 1. - falloffStep(0.5, 1., x); }
  if kind == FalloffSmoothSharp {
    let s = 1. - falloffStep(0., 1., x);
    return s * s;
  }
  if kind == FalloffRoot { return libc.sqrtf(p); }
  if kind == FalloffSharp { return p * p; }
  if kind == FalloffLinear { return p; }
  if kind == FalloffSphere { return libc.sqrtf(1. - x * x); }
  if kind == FalloffConstant { return 1.; }
  1. - falloffStep(0., 1., x);
}

// 0 below 'a', 1 above 'b', the cubic smoothstep between
fn falloffStep(a f32, b f32, x f32) f32 {
  let raw = (x - a) / (b - a);
  let t = if raw < 0. {0.;} elif raw > 1. {1.;} else {raw;};
  t * t * (3. - 2. * t);
}
