// ======== Curves ========
//
// Bezier curves, quadratic and cubic, in the plane and in space; and
// polylines, runs of points joined by straight segments.
//
// A Bezier curve runs from its first control point (t = 0) to its last
// (t = 1), drawn towards the ones between. 'point' is where it is at t, and
// 'tangent' which way and how fast it is going there: the derivative, not
// normalized, so its length is the speed along the curve as t runs. Sampling
// one into a polyline is sculpt's ('sampleCurve').

// A quadratic Bezier curve in the plane: from p0 to p2, drawn towards p1
pub struct QuadraticBezier2 {
  pub p0: Vec2;
  pub p1: Vec2;
  pub p2: Vec2;

  pub fn point(self, t: f32) Vec2 {
    let u = 1. - t;
    p0 * (u * u) + p1 * (2. * u * t) + p2 * (t * t)
  }

  pub fn tangent(self, t: f32) Vec2 {(p1 - p0) * (2. * (1. - t)) + (p2 - p1) * (2. * t)}
}

// A cubic Bezier curve in the plane: from p0 to p3, leaving p0 towards p1 and
// arriving at p3 from p2
pub struct CubicBezier2 {
  pub p0: Vec2;
  pub p1: Vec2;
  pub p2: Vec2;
  pub p3: Vec2;

  pub fn point(self, t: f32) Vec2 {
    let u = 1. - t;
    p0 * (u * u * u) + p1 * (3. * u * u * t) + p2 * (3. * u * t * t) + p3 * (t * t * t)
  }

  pub fn tangent(self, t: f32) Vec2 {
    let u = 1. - t;
    (p1 - p0) * (3. * u * u) + (p2 - p1) * (6. * u * t) + (p3 - p2) * (3. * t * t)
  }
}

// A quadratic Bezier curve in space
pub struct QuadraticBezier3 {
  pub p0: Vec3;
  pub p1: Vec3;
  pub p2: Vec3;

  pub fn point(self, t: f32) Vec3 {
    let u = 1. - t;
    p0 * (u * u) + p1 * (2. * u * t) + p2 * (t * t)
  }

  pub fn tangent(self, t: f32) Vec3 {(p1 - p0) * (2. * (1. - t)) + (p2 - p1) * (2. * t)}
}

// A cubic Bezier curve in space
pub struct CubicBezier3 {
  pub p0: Vec3;
  pub p1: Vec3;
  pub p2: Vec3;
  pub p3: Vec3;

  pub fn point(self, t: f32) Vec3 {
    let u = 1. - t;
    p0 * (u * u * u) + p1 * (3. * u * u * t) + p2 * (3. * u * t * t) + p3 * (t * t * t)
  }

  pub fn tangent(self, t: f32) Vec3 {
    let u = 1. - t;
    (p1 - p0) * (3. * u * u) + (p2 - p1) * (6. * u * t) + (p3 - p2) * (3. * t * t)
  }
}

// -------- polylines --------

// The length of the polyline through the points, in order
pub fn polylineLength2 overload polylineLength(points: &Array[Vec2]) f32 {
  var len: f32 = 0.;
  var i = 1usize;
  while i < points.len {
    len = len + points[i].distance(points[i - 1usize]);
    i = i + 1usize;
  }
  len
}

pub fn polylineLength3 overload polylineLength(points: &Array[Vec3]) f32 {
  var len: f32 = 0.;
  var i = 1usize;
  while i < points.len {
    len = len + points[i].distance(points[i - 1usize]);
    i = i + 1usize;
  }
  len
}

// The point 'distance' along the polyline from its first point, held to the
// polyline: at or before 0 its first point, at or past its length its last.
// No points at all give the origin
pub fn polylinePointAt2 overload polylinePointAt(points: &Array[Vec2], distance: f32) Vec2 {
  if points.len == 0usize {return Vec2(0., 0.);}
  var left = distance;
  var i = 1usize;
  while i < points.len {
    let a = points[i - 1usize];
    let b = points[i];
    let seg = a.distance(b);
    if left <= seg {
      if seg == 0. || left <= 0. {return a;}
      return a.lerp(b, left / seg);
    }
    left = left - seg;
    i = i + 1usize;
  }
  points[points.len - 1usize]
}

pub fn polylinePointAt3 overload polylinePointAt(points: &Array[Vec3], distance: f32) Vec3 {
  if points.len == 0usize {return Vec3(0., 0., 0.);}
  var left = distance;
  var i = 1usize;
  while i < points.len {
    let a = points[i - 1usize];
    let b = points[i];
    let seg = a.distance(b);
    if left <= seg {
      if seg == 0. || left <= 0. {return a;}
      return a.lerp(b, left / seg);
    }
    left = left - seg;
    i = i + 1usize;
  }
  points[points.len - 1usize]
}

// -------- the uniform cubic B-spline --------

// A uniform cubic B-spline over [lo, hi] with n = coefficients.len coefficients, which makes n - 3 equal spans.
// The value at x is a blend of four neighbouring coefficients with the cubic B-spline weights; the curve is smooth
// to the second derivative and does not pass through its coefficients (equal coefficients give a constant, evenly
// rising ones a straight line). x outside [lo, hi] is held to the nearest end. Fewer than 4 coefficients, or a range
// that is not lo < hi, give 0. Evaluated in f64 and returned as f32. (shapefit's 'fitPenalisedSpline' finds the
// coefficients from points.)
pub fn bsplineAt(coefficients: &Array[f32], lo: f32, hi: f32, x: f32) f32 {
  f32.from(bsplineEval(coefficients, lo, hi, x, false))
}

// The slope (derivative with respect to x) of the same curve
pub fn bsplineSlopeAt(coefficients: &Array[f32], lo: f32, hi: f32, x: f32) f32 {
  f32.from(bsplineEval(coefficients, lo, hi, x, true))
}

fn bsplineEval(coefficients: &Array[f32], lo: f32, hi: f32, x: f32, slope: bool) f64 {
  if coefficients.len < 4usize || !(lo < hi) {return 0.0;}
  let spans = coefficients.len - 3usize;
  let width = f64.from(hi) - f64.from(lo);
  var xc = f64.from(x);
  if xc < f64.from(lo) {xc = f64.from(lo);}
  if xc > f64.from(hi) {xc = f64.from(hi);}
  let u = (xc - f64.from(lo)) / width * f64.from(spans);
  var s = usize.from(libc.floor(u));
  if s > spans - 1usize {s = spans - 1usize;}
  let t = u - f64.from(s);
  let c0 = f64.from(coefficients[s]);
  let c1 = f64.from(coefficients[s + 1usize]);
  let c2 = f64.from(coefficients[s + 2usize]);
  let c3 = f64.from(coefficients[s + 3usize]);
  let m = 1.0 - t;
  if slope {
    let d0 = -0.5 * m * m;
    let d1 = (9.0 * t * t - 12.0 * t) / 6.0;
    let d2 = (-9.0 * t * t + 6.0 * t + 3.0) / 6.0;
    let d3 = 0.5 * t * t;
    return (c0 * d0 + c1 * d1 + c2 * d2 + c3 * d3) * f64.from(spans) / width;
  }
  let b0 = m * m * m / 6.0;
  let b1 = (3.0 * t * t * t - 6.0 * t * t + 4.0) / 6.0;
  let b2 = (-3.0 * t * t * t + 3.0 * t * t + 3.0 * t + 1.0) / 6.0;
  let b3 = t * t * t / 6.0;
  c0 * b0 + c1 * b1 + c2 * b2 + c3 * b3
}
