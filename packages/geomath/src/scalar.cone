// ======== Angles, trigonometry, and the scalar helpers the other files use ========

// Pi: a half turn, in radians
pub imm pi f32 = 3.14159265358979;

// An angle in degrees, in radians
pub fn radians(degrees f32) f32 inline {degrees * (pi / 180.);}

// An angle in radians, in degrees
pub fn degrees(radians f32) f32 inline {radians * (180. / pi);}

// -------- trigonometry: every use in the package goes through these --------

pub fn sin(a f32) f32 inline {a.sin();}
pub fn cos(a f32) f32 inline {a.cos();}
pub fn tan(a f32) f32 inline {libc.tanf(a);}
pub fn asin(x f32) f32 inline {libc.asinf(x);}
pub fn acos(x f32) f32 inline {libc.acosf(x);}

// The angle of the direction (x, y), from -pi to pi
pub fn atan2(y f32, x f32) f32 inline {libc.atan2f(y, x);}

// -------- scalar helpers --------

// The largest f32, which stands in for infinity in the slab tests
imm huge f32 = 3.4028235e38;

// Two numbers are equal when they differ by less than a ten-millionth, or by
// no more than f32's precision at the larger one (FLT_EPSILON)
fn almostEqual(a f32, b f32) bool {
  imm diff = libc.fabsf(a - b);
  imm aa = libc.fabsf(a);
  imm bb = libc.fabsf(b);
  imm largest = if bb > aa {bb;} else {aa;};
  diff < 0.0000001 or diff <= largest * 1.1920929e-7;
}

fn fmin(a f32, b f32) f32 inline {if a < b {a;} else {b;};}
fn fmax(a f32, b f32) f32 inline {if a > b {a;} else {b;};}
fn fabs(a f32) f32 inline {libc.fabsf(a);}
fn fclamp(v f32, lo f32, hi f32) f32 inline {if v < lo {lo;} elif v > hi {hi;} else {v;};}
