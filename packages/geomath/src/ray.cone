// ======== Rays ========
//
// Rays and the hits they make; segments, triangles and the closest points on
// them.
//
// A hit is the multiple t of the ray's direction at which it happens, so the
// point hit is 'ray.at(t)', and with a unit direction t is the distance. Only
// t >= 0 counts: what is behind the origin is missed.

// A half-line in space: from 'origin', along 'direction'
pub struct Ray3 {
  pub origin Vec3;
  pub direction Vec3;

  // The point t directions along
  pub fn at(self, t f32) Vec3 inline {origin + direction * t}

  // Where it crosses the plane; a ray running along the plane misses it
  pub fn intersectPlane(self, p Plane) Option[f32] {
    let denom = p.normal.dot(direction);
    if fabs(denom) < 0.000001 {return None;}
    let t = -p.signedDistance(origin) / denom;
    if t >= 0. {Some[f32](t)} else {None}
  }

  // Where it first enters the ball; 0 when it starts inside
  // (Ericson, Real-Time Collision Detection, 5.3.2)
  pub fn intersectSphere(self, s Sphere) Option[f32] {
    let m = origin - s.center;
    let a = direction.dot(direction);
    let b = m.dot(direction);
    let c = m.dot(m) - s.radius * s.radius;
    if c <= 0. {return Some[f32](0.);}
    // Outside and pointing away
    if b > 0. {return None;}
    let disc = b * b - a * c;
    if disc < 0. {return None;}
    Some[f32]((-b - disc.sqrt()) / a)
  }

  // Where it first enters the box; 0 when it starts inside. Between the
  // two planes of each axis, the ray is inside for a span of t (the slab
  // test); it is in the box where the three spans overlap
  pub fn intersectAabb(self, b Aabb3) Option[f32] {
    var enter f32 = 0.;
    var exit = huge;
    let sx = slab(origin.x, direction.x, b.min.x, b.max.x);
    let sy = slab(origin.y, direction.y, b.min.y, b.max.y);
    let sz = slab(origin.z, direction.z, b.min.z, b.max.z);
    enter = fmax(enter, fmax(sx.x, fmax(sy.x, sz.x)));
    exit = fmin(exit, fmin(sx.y, fmin(sy.y, sz.y)));
    if enter <= exit {Some[f32](enter)} else {None}
  }

  // Where it hits the triangle a, b, c, from either side
  // (Moller and Trumbore's method)
  pub fn intersectTriangle(self, a Vec3, b Vec3, c Vec3) Option[f32] {
    let e1 = b - a;
    let e2 = c - a;
    let p = direction.cross(e2);
    let det = e1.dot(p);
    // Running along the triangle's plane
    if fabs(det) < 0.0000001 {return None;}
    let inv = 1. / det;
    let s = origin - a;
    let u = s.dot(p) * inv;
    if u < 0. || u > 1. {return None;}
    let q = s.cross(e1);
    let v = direction.dot(q) * inv;
    if v < 0. || u + v > 1. {return None;}
    let t = e2.dot(q) * inv;
    if t >= 0. {Some[f32](t)} else {None}
  }

  // The point of the ray nearest p
  pub fn closestPoint(self, p Vec3) Vec3 {
    let len2 = direction.lengthSquared();
    if len2 == 0. {return origin;}
    at(fmax(0., (p - origin).dot(direction) / len2))
  }
}

// The span of t, as (enter, exit), in which o + t d lies between lo and hi.
// A ray running parallel to the planes is inside for every t, or for none
fn slab(o f32, d f32, lo f32, hi f32) Vec2 {
  if d == 0. {
    if o < lo || o > hi {return new Vec2(huge, -huge);}
    return new Vec2(-huge, huge);
  }
  let inv = 1. / d;
  let t1 = (lo - o) * inv;
  let t2 = (hi - o) * inv;
  new Vec2(fmin(t1, t2), fmax(t1, t2))
}

// A half-line in the plane: from 'origin', along 'direction'
pub struct Ray2 {
  pub origin Vec2;
  pub direction Vec2;

  pub fn at(self, t f32) Vec2 inline {origin + direction * t}

  // Where it crosses the segment from a to b, ends included. A ray running
  // along the segment's line misses it
  pub fn intersectSegment(self, a Vec2, b Vec2) Option[f32] {
    // origin + t direction = a + s (b - a): crossing both sides with (b - a)
    // leaves t, and with direction leaves s
    let e = b - a;
    let denom = direction.cross(e);
    if fabs(denom) < 0.0000001 {return None;}
    let w = a - origin;
    let t = w.cross(e) / denom;
    let s = w.cross(direction) / denom;
    if t >= 0. && s >= 0. && s <= 1. {Some[f32](t)} else {None}
  }

  // Where it first enters the disc; 0 when it starts inside
  pub fn intersectCircle(self, c Circle) Option[f32] {
    let m = origin - c.center;
    let a = direction.dot(direction);
    let b = m.dot(direction);
    let cc = m.dot(m) - c.radius * c.radius;
    if cc <= 0. {return Some[f32](0.);}
    if b > 0. {return None;}
    let disc = b * b - a * cc;
    if disc < 0. {return None;}
    Some[f32]((-b - disc.sqrt()) / a)
  }

  // The point of the ray nearest p
  pub fn closestPoint(self, p Vec2) Vec2 {
    let len2 = direction.lengthSquared();
    if len2 == 0. {return origin;}
    at(fmax(0., (p - origin).dot(direction) / len2))
  }
}

// Where the segment from p1 to p2 crosses the one from q1 to q2, ends
// included. Segments on one line are taken as not crossing
pub fn segmentIntersection(p1 Vec2, p2 Vec2, q1 Vec2, q2 Vec2) Option[Vec2] {
  let r = p2 - p1;
  let e = q2 - q1;
  let denom = r.cross(e);
  if fabs(denom) < 0.0000001 {return None;}
  let w = q1 - p1;
  let t = w.cross(e) / denom;
  let s = w.cross(r) / denom;
  if t >= 0. && t <= 1. && s >= 0. && s <= 1. {Some[Vec2](p1 + r * t)} else {None}
}

// The point of the segment from a to b nearest p
pub fn closestPointOnSegment3 overload closestPointOnSegment(p Vec3, a Vec3, b Vec3) Vec3 {
  let ab = b - a;
  let len2 = ab.lengthSquared();
  if len2 == 0. {return a;}
  a + ab * fclamp((p - a).dot(ab) / len2, 0., 1.)
}

pub fn closestPointOnSegment2 overload closestPointOnSegment(p Vec2, a Vec2, b Vec2) Vec2 {
  let ab = b - a;
  let len2 = ab.lengthSquared();
  if len2 == 0. {return a;}
  a + ab * fclamp((p - a).dot(ab) / len2, 0., 1.)
}

// The point of the triangle a, b, c nearest p: which of its corners, edges or
// face is nearest is found from where p lies against each (Ericson,
// Real-Time Collision Detection, 5.1.5)
pub fn closestPointOnTriangle(p Vec3, a Vec3, b Vec3, c Vec3) Vec3 {
  let ab = b - a;
  let ac = c - a;
  let ap = p - a;
  let d1 = ab.dot(ap);
  let d2 = ac.dot(ap);
  if d1 <= 0. && d2 <= 0. {return a;}
  let bp = p - b;
  let d3 = ab.dot(bp);
  let d4 = ac.dot(bp);
  if d3 >= 0. && d4 <= d3 {return b;}
  let vc = d1 * d4 - d3 * d2;
  if vc <= 0. && d1 >= 0. && d3 <= 0. {return a + ab * (d1 / (d1 - d3));}
  let cp = p - c;
  let d5 = ab.dot(cp);
  let d6 = ac.dot(cp);
  if d6 >= 0. && d5 <= d6 {return c;}
  let vb = d5 * d2 - d1 * d6;
  if vb <= 0. && d2 >= 0. && d6 <= 0. {return a + ac * (d2 / (d2 - d6));}
  let va = d3 * d6 - d5 * d4;
  if va <= 0. && d4 - d3 >= 0. && d5 - d6 >= 0. {
    return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6)));
  }
  let denom = 1. / (va + vb + vc);
  a + ab * (vb * denom) + ac * (vc * denom)
}

// The weights (u, v, w) of the corners a, b and c that make p, the point of
// their plane nearest it: p = u a + v b + w c, and u + v + w = 1
pub fn barycentric(p Vec3, a Vec3, b Vec3, c Vec3) Vec3 {
  let v0 = b - a;
  let v1 = c - a;
  let v2 = p - a;
  let d00 = v0.dot(v0);
  let d01 = v0.dot(v1);
  let d11 = v1.dot(v1);
  let d20 = v2.dot(v0);
  let d21 = v2.dot(v1);
  let denom = d00 * d11 - d01 * d01;
  let v = (d11 * d20 - d01 * d21) / denom;
  let w = (d00 * d21 - d01 * d20) / denom;
  new Vec3(1. - v - w, v, w)
}
