// Rotations and inverses of the geomath package, checked with the testing
// package: each value is compared to one worked out by hand, within a
// tolerance, and only a failure prints, so rotations.out holds the summary
// alone. The numbers are f32, whose rounding shows around the seventh digit,
// so a value near 1 is checked to within a hundred-thousandth and one near 13
// to within a ten-thousandth.
//
// The turn used throughout is a third of a turn about the diagonal (1, 1, 1):
// it carries x to y, y to z and z to x, so a point (a, b, c) goes to
// (c, a, b). Its quaternion is (s d, s d, s d, cos 60deg), where d = 1/sqrt(3)
// is each component of the unit diagonal and s = sin 60deg = sqrt(3)/2, which
// makes every component exactly 1/2.
//
// - The quaternion, and the axes and a point it turns; lengths are kept.
// - Its inverse is its conjugate, (-1/2, -1/2, -1/2, 1/2); it undoes the turn,
//   and the product with it is the identity, (0, 0, 0, 1).
// - Three third-turns are a whole turn, which as a quaternion is
//   (0, 0, 0, -1): the double cover, the same rotation as the identity.
// - A quaternion that is not a unit, (1, 2, 2, 0), length squared 9: its
//   inverse is the conjugate over 9, and the product with it is the identity.
// - The turn's matrix: its columns are where it carries the axes, so x's
//   column is (0, 1, 0); it carries a point where the quaternion does.
// - A placement, doubled, turned and moved to (1, 2, 3), and its inverse,
//   which halves, turns back (a, b, c) to (b, c, a), and moves by minus the
//   turned-back origin halved, -(2, 3, 1) / 2 = (-1, -1.5, -0.5).
// - slerp a third of the way to a quarter turn about z is a twelfth of a turn,
//   (0, 0, sin 15deg, cos 15deg) = (0, 0, 0.258819, 0.965926); the method is
//   an approximation, good to about a millionth.
// - The turn as a Mat3: its columns, the point, a determinant of 1, and its
//   transpose and inverse turning back; a product's order; a Mat3 with a
//   determinant of 20 inverted by hand, and one with none; the normal matrix
//   of a stretch; the top left of a placement.
// - The placement as a Transform3: a point, a direction (not moved), its
//   Mat4, its inverse part by part, composition with a move, and with its
//   inverse.
// - DVec3: a position beyond f32's reach seen from a nearby origin, lengths
//   and distances in the billions; Vec4's length, dot, normalize and lerp.
//
// Where one helper checks the three parts of a point with one label, the
// expected value a failure prints says which part it was.

mod rotations;

import testing use *;
import geomath use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, within f64, label &[]u8) {
  expectFloat(got.x, x, within, label);
  expectFloat(got.y, y, within, label);
  expectFloat(got.z, z, within, label);
}

fn quat(got Quat, x f32, y f32, z f32, w f32, label &[]u8) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
  expectFloat(got.w, w, near, label);
}

fn main() i32 {
  imm third = Quat.angleAxis(2. * pi / 3., Vec3[1., 1., 1.].normalize());
  // Every other check assumes a rotation, which must be a unit quaternion
  requireFloat(third.dot(third), 1., near, "the third turn is a unit quaternion");
  quat(third, 0.5, 0.5, 0.5, 0.5, "the third turn");
  point(third.rotate(Vec3[1., 0., 0.]), 0., 1., 0., near, "x turns to y");
  point(third.rotate(Vec3[0., 1., 0.]), 0., 0., 1., near, "y turns to z");
  point(third.rotate(Vec3[0., 0., 1.]), 1., 0., 0., near, "z turns to x");
  // 3, 4, 12: 9 + 16 + 144 = 169, length 13 before and after
  imm p = Vec3[3., 4., 12.];
  point(third.rotate(p), 12., 3., 4., 0.0001, "a point turned");
  expectFloat(third.rotate(p).length(), 13., 0.0001, "turning keeps length");

  imm back = third.inverse();
  quat(back, -0.5, -0.5, -0.5, 0.5, "the inverse is the conjugate");
  quat(third * back, 0., 0., 0., 1., "the turn times its inverse");
  point(back.rotate(third.rotate(p)), 3., 4., 12., 0.0001, "the inverse undoes the turn");
  quat(third * third * third, 0., 0., 0., -1., "three third-turns");

  imm odd = Quat[1., 2., 2., 0.];
  quat(odd.inverse(), -0.111111, -0.222222, -0.222222, 0., "inverse of a non-unit");
  quat(odd * odd.inverse(), 0., 0., 0., 1., "a non-unit times its inverse");

  imm m = Mat4.fromQuat(third);
  expectFloat(m.cell(0usize, 0usize), 0., near, "matrix row 0 column 0");
  expectFloat(m.cell(1usize, 0usize), 1., near, "matrix row 1 column 0");
  expectFloat(m.cell(2usize, 1usize), 1., near, "matrix row 2 column 1");
  expectFloat(m.cell(0usize, 2usize), 1., near, "matrix row 0 column 2");
  point(m * p, 12., 3., 4., 0.0001, "the matrix turns as the quaternion does");

  imm placed = Mat4.fromTrs(Vec3[1., 2., 3.], third, Vec3[2., 2., 2.]);
  imm unplaced = placed.inverse();
  // x doubled is (2, 0, 0), turned (0, 2, 0), moved (1, 4, 3)
  point(placed * Vec3[1., 0., 0.], 1., 4., 3., near, "a placement");
  point(unplaced * Vec3[1., 4., 3.], 1., 0., 0., near, "the inverse placement");
  // (5, 6, 7) less (1, 2, 3) is (4, 4, 4), halved (2, 2, 2), which turning leaves
  point(unplaced * Vec3[5., 6., 7.], 2., 2., 2., near, "the inverse of a point on the diagonal");
  expectFloat(unplaced.cell(0usize, 3usize), -1., near, "inverse translation x");
  expectFloat(unplaced.cell(1usize, 3usize), -1.5, near, "inverse translation y");
  expectFloat(unplaced.cell(2usize, 3usize), -0.5, near, "inverse translation z");
  // The identity's cells, stored by column: 1 on the diagonal, m[0], m[5],
  // m[10] and m[15]
  imm id = unplaced * placed;
  mut i = 0usize;
  while i < 16usize {
    imm want f32 = if i % 5usize == 0usize {1.;} else {0.;};
    expectFloat(id.m[i], want, near, "the inverse times the placement is the identity");
    i = i + 1usize;
  };

  imm quarter = Quat.angleAxis(pi / 2., Vec3[0., 0., 1.]);
  quat(Quat.identity().slerp(quarter, 1. / 3.), 0., 0., 0.258819, 0.965926,
    "a third of the way to a quarter turn");

  matrices3(third, p);
  transforms(third);
  wide();
  done();
}

fn matrices3(third Quat, p Vec3) {
  imm r = Mat3.fromQuat(third);
  expectFloat(r.cell(1usize, 0usize), 1., near, "Mat3 row 1 column 0");
  expectFloat(r.cell(2usize, 1usize), 1., near, "Mat3 row 2 column 1");
  expectFloat(r.cell(0usize, 2usize), 1., near, "Mat3 row 0 column 2");
  point(r * p, 12., 3., 4., 0.0001, "Mat3 turns as the quaternion does");
  expectFloat(r.determinant(), 1., near, "a turn keeps volume");
  // A turn's inverse is its transpose
  point(r.transpose() * Vec3[12., 3., 4.], 3., 4., 12., 0.0001, "Mat3 transpose turns back");
  point(r.inverse() * Vec3[12., 3., 4.], 3., 4., 12., 0.0001, "Mat3 inverse turns back");
  // Scaled along x first, then turned: x goes to (2, 0, 0), then to (0, 2, 0)
  point((r * Mat3.fromScale(Vec3[2., 1., 1.])) * Vec3[1., 0., 0.], 0., 2., 0., near,
    "Mat3 product: the right-hand one first");

  // Written on paper as 2 1 0 / 1 3 0 / 0 0 4: determinant 4 (2*3 - 1*1) = 20,
  // and the inverse of its top left 2x2 is 1/5 (3 -1 / -1 2)
  imm a = Mat3[[2f, 1f, 0f,  1f, 3f, 0f,  0f, 0f, 4f]];
  expectFloat(a.determinant(), 20., near, "Mat3 determinant");
  imm ai = a.inverse();
  expectFloat(ai.cell(0usize, 0usize), 0.6, near, "Mat3 inverse row 0 column 0");
  expectFloat(ai.cell(0usize, 1usize), -0.2, near, "Mat3 inverse row 0 column 1");
  expectFloat(ai.cell(1usize, 0usize), -0.2, near, "Mat3 inverse row 1 column 0");
  expectFloat(ai.cell(1usize, 1usize), 0.4, near, "Mat3 inverse row 1 column 1");
  expectFloat(ai.cell(2usize, 2usize), 0.25, near, "Mat3 inverse row 2 column 2");
  point(ai * (a * Vec3[1., 2., 3.]), 1., 2., 3., near, "Mat3 inverse undoes it");
  // A flattening matrix has no inverse: all zeros
  expectFloat(Mat3.fromScale(Vec3[1., 0., 1.]).inverse().m[0], 0., near, "Mat3 singular inverse");

  // The plane x = y has the normal (1, -1, 0). Stretched to twice its width
  // along x, its points (t, t, z) go to (2t, t, z), the plane x = 2y, whose
  // normal is (1, -2, 0): the normal matrix, diag(1/2, 1, 1), gives
  // (1/2, -1, 0), the same direction
  imm stretch = Mat4.fromScale(Vec3[2., 1., 1.]);
  point(Mat3.normalMatrix(stretch) * Vec3[1., -1., 0.], 0.5, -1., 0., near, "normal matrix");
  // The top left of a placement: its turn and scale, without its move
  imm placedR = Mat3.fromMat4(Mat4.fromTrs(Vec3[1., 2., 3.], third, Vec3[2., 2., 2.]));
  point(placedR * Vec3[1., 0., 0.], 0., 2., 0., near, "Mat3 from a Mat4");
}

// Transform3: the same placement as the Mat4 above, doubled, turned a third
// about the diagonal and moved to (1, 2, 3)
fn transforms(third Quat) {
  imm t = Transform3[Vec3[1., 2., 3.], third, Vec3[2., 2., 2.]];
  point(t.transformPoint(Vec3[1., 0., 0.]), 1., 4., 3., near, "Transform3 point");
  point(t.transformVector(Vec3[1., 0., 0.]), 0., 2., 0., near, "Transform3 vector: not moved");
  point(t.toMat4() * Vec3[1., 0., 0.], 1., 4., 3., near, "Transform3 as a Mat4");
  imm u = t.inverse();
  point(u.translation, -1., -1.5, -0.5, near, "Transform3 inverse translation");
  quat(u.rotation, -0.5, -0.5, -0.5, 0.5, "Transform3 inverse rotation");
  point(u.scale, 0.5, 0.5, 0.5, near, "Transform3 inverse scale");
  point(u.transformPoint(Vec3[1., 4., 3.]), 1., 0., 0., near, "Transform3 inverse undoes it");
  // Composed with a move by (0, 0, 1) that acts first: (1, 0, 0) goes to
  // (1, 0, 1), doubled (2, 0, 2), turned (2, 2, 0), moved (3, 4, 3). The
  // composed translation is where t puts (0, 0, 1): (0, 0, 2) turned to
  // (2, 0, 0), moved to (3, 2, 3)
  imm up = Transform3[Vec3[0., 0., 1.], Quat.identity(), Vec3[1., 1., 1.]];
  imm tu = t * up;
  point(tu.transformPoint(Vec3[1., 0., 0.]), 3., 4., 3., near, "Transform3 composed");
  point(tu.translation, 3., 2., 3., near, "Transform3 composed translation");
  point((t * u).transformPoint(Vec3[5., 6., 7.]), 5., 6., 7., near, "Transform3 times its inverse");
  point(Transform3.identity().transformPoint(Vec3[5., 6., 7.]), 5., 6., 7., near,
    "Transform3 identity");
}

// DVec3 and Vec4
fn wide() {
  // 100000000.25 is beyond f32, whose step there is 8, but a double holds it;
  // seen from 100000000 it is 0.25 away, which f32 holds exactly
  imm far = DVec3[100000000.25d, 0d, 0d];
  imm origin = DVec3[100000000d, 0d, 0d];
  point(far.relativeTo(origin), 0.25, 0., 0., near, "DVec3 relative to an origin");
  imm back = origin + Vec3[0.25, 0., 0.];
  expectFloat(back.x, 100000000.25d, 0.000001d, "DVec3 plus a Vec3");
  // 3e9, 4e9: length 5e9
  imm big = DVec3[3000000000d, 4000000000d, 0d];
  expectFloat(big.length(), 5000000000d, 0.001d, "DVec3 length");
  expectFloat(big.distance(DVec3[3000000000d, 0d, 0d]), 4000000000d, 0.001d, "DVec3 distance");
  expectFloat((big - big * 0.5d).x, 1500000000d, 0.001d, "DVec3 scale and subtract");
  point(DVec3.from(Vec3[1., 2., 3.]).toVec3(), 1., 2., 3., near, "DVec3 to and from Vec3");

  imm v = Vec4[1., 2., 2., 4.];
  expectFloat(v.length(), 5., near, "Vec4 length");
  expectFloat(v.dot(Vec4[1., 1., 1., 1.]), 9., near, "Vec4 dot");
  imm n = v.normalize();
  expectFloat(n.w, 0.8, near, "Vec4 normalize");
  point(Vec3[1., 2., 3.].extend(1.).xyz(), 1., 2., 3., near, "Vec3 extended and back");
  expectFloat(Vec4[0., 0., 0., 0.].lerp(v, 0.5).w, 2., near, "Vec4 lerp");
}
