// The geomath package in the plane, checked with the testing package against
// values worked out by hand; only a failure prints, so plane.out holds the
// summary alone.
//
// - Vec2: length, normalize, dot, the 2-D cross product (its sign is the
//   turn's direction), perp, rotate, fromAngle, the angle between two and the
//   signed angle, reflect, project, min, max, abs, clamp, lerp, distance.
// - Transform2 and its Mat3: scaled, turned a quarter and moved; composed;
//   inverted (with a scaling the same both ways, where the inverse is exact).
// - Aabb2, Rect (which holds its left and bottom edges, not its right and
//   top), IRect and Circle: contains, closest point, overlaps, and a box
//   carried through a 2-D placement.
// - Ray2 against segments (across, behind, past an end, touching an end,
//   along) and a circle; segment against segment.
// - Polygons: signed area of a square both ways round, of an L and of an
//   arrowhead; point in polygon. (The convex hull's checks are sculpt's, in
//   its hulls test, and triangulation's mesh's, in its polygons test.)

mod plane;

import testing use *;
import geomath use *;

imm near = 0.00001d;
imm close = 0.0001d;

fn pt(got Vec2, x f32, y f32, label &Array[u8]) {
  expectFloat(got.x, x, close, label);
  expectFloat(got.y, y, close, label);
}

fn hit(h Option[f32]) f32 {
  match h {
    case imm s Some {s;}
    else {-1.;}
  }
}

// Where two segments cross, or (-99, -99) when they do not
fn crossing(h Option[Vec2]) Vec2 {
  match h {
    case imm s Some {s;}
    else {new Vec2(-99., -99.);}
  }
}

fn vectors() {
  expectFloat(new Vec2(3., 4.).length(), 5., near, "Vec2 length");
  pt(new Vec2(3., 4.).normalize(), 0.6, 0.8, "Vec2 normalize");
  pt(new Vec2(0., 0.).normalize(), 1., 0., "Vec2 normalize zero");
  expectFloat(new Vec2(1., 2.).dot(new Vec2(3., 4.)), 11., near, "Vec2 dot");
  // y is counterclockwise of x: positive; x is clockwise of y: negative
  expectFloat(new Vec2(1., 0.).cross(new Vec2(0., 1.)), 1., near, "Vec2 cross, counterclockwise");
  expectFloat(new Vec2(0., 1.).cross(new Vec2(1., 0.)), -1., near, "Vec2 cross, clockwise");
  pt(new Vec2(1., 2.).perp(), -2., 1., "Vec2 perp");
  pt(new Vec2(1., 0.).rotate(pi / 2.), 0., 1., "Vec2 rotate a quarter");
  pt(Vec2.fromAngle(pi), -1., 0., "Vec2 from a half turn");
  expectFloat(new Vec2(1., 0.).signedAngle(new Vec2(0., 1.)), 1.570796, close, "signed angle counterclockwise");
  expectFloat(new Vec2(1., 0.).signedAngle(new Vec2(0., -1.)), -1.570796, close, "signed angle clockwise");
  expectFloat(new Vec2(1., 0.).angle(new Vec2(0., -1.)), 1.570796, close, "angle, either way round");
  pt(new Vec2(1., -1.).reflect(new Vec2(0., 1.)), 1., 1., "Vec2 reflect");
  pt(new Vec2(3., 4.).project(new Vec2(0., 2.)), 0., 4., "Vec2 project");
  pt(new Vec2(1., 5.).min(new Vec2(3., 2.)), 1., 2., "Vec2 min");
  pt(new Vec2(1., 5.).max(new Vec2(3., 2.)), 3., 5., "Vec2 max");
  pt(new Vec2(-1., 2.).abs(), 1., 2., "Vec2 abs");
  pt(new Vec2(5., -5.).clamp(new Vec2(0., 0.), new Vec2(1., 1.)), 1., 0., "Vec2 clamp");
  pt(new Vec2(0., 0.).lerp(new Vec2(10., 20.), 0.25), 2.5, 5., "Vec2 lerp");
  expectFloat(new Vec2(1., 1.).distance(new Vec2(4., 5.)), 5., near, "Vec2 distance");
}

fn placements() {
  // (1, 1) scaled by (2, 3) is (2, 3), turned a quarter (-3, 2), moved by
  // (1, 2) to (-2, 4)
  imm t = new Transform2(new Vec2(1., 2.), pi / 2., new Vec2(2., 3.));
  pt(t.transformPoint(new Vec2(1., 1.)), -2., 4., "Transform2 point");
  pt(t.transformVector(new Vec2(1., 1.)), -3., 2., "Transform2 vector: not moved");
  imm m = t.toMat3();
  pt(m.transformPoint2(new Vec2(1., 1.)), -2., 4., "Transform2 as a Mat3: point");
  pt(m.transformVector2(new Vec2(1., 1.)), -3., 2., "Transform2 as a Mat3: vector");
  // Doubled both ways: (1, 1) goes to (2, 2), (-2, 2), (-1, 4). Its inverse
  // turns (1, 2) back a quarter to (2, -1), halves it and negates it
  imm u = new Transform2(new Vec2(1., 2.), pi / 2., new Vec2(2., 2.));
  imm ui = u.inverse();
  pt(ui.translation, -1., 0.5, "Transform2 inverse translation");
  expectFloat(ui.angle, -1.570796, close, "Transform2 inverse angle");
  pt(ui.scale, 0.5, 0.5, "Transform2 inverse scale");
  pt(ui.transformPoint(new Vec2(-1., 4.)), 1., 1., "Transform2 inverse undoes it");
  // Composed with a move of (1, 0) that acts first: the origin goes to (1, 0),
  // then to (2, 0), (0, 2), (1, 4)
  imm c = u * new Transform2(new Vec2(1., 0.), 0., new Vec2(1., 1.));
  pt(c.transformPoint(new Vec2(0., 0.)), 1., 4., "Transform2 composed");
  pt(Transform2.identity().transformPoint(new Vec2(3., 4.)), 3., 4., "Transform2 identity");
  // The Mat3 of the composed placement, multiplied, is the same
  pt((u.toMat3() * new Transform2(new Vec2(1., 0.), 0., new Vec2(1., 1.)).toMat3()).transformPoint2(new Vec2(0., 0.)),
    1., 4., "Mat3 product of two placements");
}

fn shapes() {
  imm pts Array[Vec2, 3] = [new Vec2(1., 2.), new Vec2(-3., 5.), new Vec2(4., -1.)];
  imm b = Aabb2.fromPoints(&pts);
  pt(b.min, -3., -1., "Aabb2 from points: min");
  pt(b.max, 4., 5., "Aabb2 from points: max");
  pt(b.center(), 0.5, 2., "Aabb2 centre");
  pt(b.size(), 7., 6., "Aabb2 size");
  expect(b.contains(new Vec2(0., 0.)), "Aabb2 contains a point");
  expect(!b.contains(new Vec2(5., 0.)), "Aabb2 does not contain a point");
  pt(b.closestPoint(new Vec2(10., 10.)), 4., 5., "Aabb2 nearest point");
  pt(b.expand(1.).min, -4., -2., "Aabb2 expanded");
  pt(b.enclose(new Vec2(0., 9.)).max, 4., 9., "Aabb2 enclosing a point");
  pt(b.union(new Aabb2(new Vec2(-5., 0.), new Vec2(0., 1.))).min, -5., -1., "Aabb2 union");
  expect(b.overlaps(new Aabb2(new Vec2(4., 5.), new Vec2(6., 6.))), "Aabb2 touching at a corner overlaps");
  expect(!b.overlaps(new Aabb2(new Vec2(4.5, 0.), new Vec2(6., 6.))), "Aabb2 apart");
  expect(Aabb2.empty().isEmpty(), "Aabb2 empty");
  // Turned a quarter, (x, y) to (-y, x), and moved 10 along x
  imm moved = new Aabb2(new Vec2(0., 0.), new Vec2(2., 1.)).transformed(new Transform2(new Vec2(10., 0.), pi / 2., new Vec2(1., 1.)).toMat3());
  pt(moved.min, 9., 0., "Aabb2 transformed: min");
  pt(moved.max, 10., 2., "Aabb2 transformed: max");

  imm r = new Rect(1., 2., 3., 4.);
  expect(r.contains(new Vec2(1., 2.)), "Rect holds its corner");
  expect(!r.contains(new Vec2(4., 3.)), "Rect does not hold its right edge");
  expect(!r.contains(new Vec2(2., 6.)), "Rect does not hold its top edge");
  expect(r.contains(new Vec2(3.9, 5.9)), "Rect holds a point just inside its far corner");
  pt(r.center(), 2.5, 4., "Rect centre");
  pt(r.max(), 4., 6., "Rect far corner");
  pt(r.toAabb().max, 4., 6., "Rect as a box");
  imm ir = new IRect(0, 0, 10, 5);
  expect(ir.contains(9, 4), "IRect holds its last pixel");
  expect(!ir.contains(10, 0), "IRect does not hold the pixel past it");
  expect(!ir.contains(-1, 0), "IRect does not hold the pixel before it");
  expectFloat(ir.toRect().w, 10., near, "IRect as a Rect");

  imm circle = new Circle(new Vec2(0., 0.), 2.);
  expect(circle.contains(new Vec2(1., 1.)), "Circle contains a point");
  expect(!circle.contains(new Vec2(2., 1.)), "Circle does not contain a point");
  pt(circle.closestPoint(new Vec2(0., 10.)), 0., 2., "Circle nearest point");
  expect(circle.overlaps(new Circle(new Vec2(3., 0.), 1.)), "touching circles overlap");
  expect(!circle.overlaps(new Circle(new Vec2(4., 0.), 1.)), "circles apart");
}

fn intersections() {
  imm r = new Ray2(new Vec2(0., 0.), new Vec2(1., 0.));
  expectFloat(hit(r.intersectSegment(new Vec2(3., -1.), new Vec2(3., 1.))), 3., near, "Ray2 crosses a segment");
  expectFloat(hit(new Ray2(new Vec2(0., 0.), new Vec2(2., 0.)).intersectSegment(new Vec2(3., -1.), new Vec2(3., 1.))), 1.5, near,
    "Ray2 t counts directions");
  expectFloat(hit(r.intersectSegment(new Vec2(-3., -1.), new Vec2(-3., 1.))), -1., near, "Ray2 misses a segment behind");
  expectFloat(hit(r.intersectSegment(new Vec2(3., 1.), new Vec2(3., 2.))), -1., near, "Ray2 passes a segment's end");
  expectFloat(hit(r.intersectSegment(new Vec2(3., 0.), new Vec2(3., 2.))), 3., near, "Ray2 touches a segment's end");
  expectFloat(hit(r.intersectSegment(new Vec2(1., 0.), new Vec2(5., 0.))), -1., near, "Ray2 along a segment misses it");
  expectFloat(hit(r.intersectCircle(new Circle(new Vec2(5., 0.), 1.))), 4., near, "Ray2 enters a circle");
  expectFloat(hit(r.intersectCircle(new Circle(new Vec2(0., 0.), 1.))), 0., near, "Ray2 starting in a circle");
  expectFloat(hit(r.intersectCircle(new Circle(new Vec2(5., 3.), 1.))), -1., near, "Ray2 misses a circle");
  pt(r.closestPoint(new Vec2(3., 4.)), 3., 0., "Ray2 nearest point");
  pt(r.at(2.), 2., 0., "Ray2 point at t");

  // The diagonals of the square from (0, 0) to (4, 4) cross at its centre
  pt(crossing(segmentIntersection(new Vec2(0., 0.), new Vec2(4., 4.), new Vec2(0., 4.), new Vec2(4., 0.))), 2., 2.,
    "segments cross");
  // y = x from (0, 0) to (1, 1), and y = 2 - x from (2, 0) to (3, -1): their
  // lines meet at (1, 1), which is not on the second
  pt(crossing(segmentIntersection(new Vec2(0., 0.), new Vec2(1., 1.), new Vec2(2., 0.), new Vec2(3., -1.))), -99., -99.,
    "segments whose lines cross elsewhere");
  pt(crossing(segmentIntersection(new Vec2(0., 0.), new Vec2(4., 0.), new Vec2(0., 1.), new Vec2(4., 1.))), -99., -99.,
    "parallel segments");
  pt(crossing(segmentIntersection(new Vec2(0., 0.), new Vec2(4., 0.), new Vec2(2., 0.), new Vec2(2., 3.))), 2., 0.,
    "a segment ending on another");
  pt(closestPointOnSegment(new Vec2(3., 4.), new Vec2(0., 0.), new Vec2(10., 0.)), 3., 0., "nearest point of a 2-D segment");
}

fn polygons() {
  imm square Array[Vec2, 4] = [new Vec2(0., 0.), new Vec2(2., 0.), new Vec2(2., 2.), new Vec2(0., 2.)];
  imm cw Array[Vec2, 4] = [new Vec2(0., 0.), new Vec2(0., 2.), new Vec2(2., 2.), new Vec2(2., 0.)];
  expectFloat(polygonSignedArea(&square), 4., near, "square's area, counterclockwise");
  expectFloat(polygonSignedArea(&cw), -4., near, "square's area, clockwise");
  expect(polygonIsCounterClockwise(&square), "square counterclockwise");
  expect(!polygonIsCounterClockwise(&cw), "square clockwise");
  // An L: the square 4 by 4 less the 3 by 3 above and right of (1, 1): 16 - 9
  imm ell Array[Vec2, 6] = [new Vec2(0., 0.), new Vec2(4., 0.), new Vec2(4., 1.), new Vec2(1., 1.), new Vec2(1., 4.), new Vec2(0., 4.)];
  expectFloat(polygonSignedArea(&ell), 7., near, "the L's area");
  expect(polygonContains(&square, new Vec2(1., 1.)), "point in a square");
  expect(!polygonContains(&square, new Vec2(3., 1.)), "point beside a square");
  expect(polygonContains(&ell, new Vec2(0.5, 3.)), "point in the L's upright");
  expect(polygonContains(&ell, new Vec2(3., 0.5)), "point in the L's foot");
  expect(!polygonContains(&ell, new Vec2(2., 2.)), "point in the L's notch");
  // An arrowhead, its back notched in to (1, 2): (4*4 - 1*4) / 2 = 6
  imm arrow Array[Vec2, 4] = [new Vec2(0., 0.), new Vec2(4., 2.), new Vec2(0., 4.), new Vec2(1., 2.)];
  expectFloat(polygonSignedArea(&arrow), 6., near, "arrowhead's area");
}

fn main() i32 {
  vectors();
  placements();
  shapes();
  intersections();
  polygons();
  done();
}
