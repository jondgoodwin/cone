// The noise package against its Slang twin, noise.slang, on a real GPU.
//
// parity.slang draws a 64 x 256 rgba8unorm target, each pixel one quantity
// (its column: a hash word, or one float of a noise's result) at one sample
// point (its row), its 32 bits one byte per channel, so the readback holds
// the GPU's exact bits. This program computes the same table with the Cone
// package and compares, quantity by quantity:
//
// - The hashes (pcg, pcg2d, pcg3d, pcg4d, hash1, and the hash to float
//   conversions) and the cellular noises' cell ids must be identical: they
//   are integer arithmetic, and the decision of which cell is nearest.
// - Value, gradient (plain and periodic), the vector to the nearest cell
//   point, the fractal sums and the domain warps use only add, subtract,
//   multiply and floor, compiled with '-fp-mode precise' (no contraction):
//   they must be identical too.
// - Cellular F1 and F2 are square roots of such sums, which Vulkan does not
//   round correctly: they must agree to 3 units in the last place.
// - Phacelle noise uses exp, cos, sin and division, which Vulkan computes
//   to looser bounds than the CPU's C library: it must agree to 0.002, its
//   side vector (multiplications only) exactly.
//
// Rows 128 to 255 are the first 128 moved about a thousand cells away, where
// an f32 keeps fewer bits below the point. Every sample point is a multiple
// of 1/32, exact in binary.
//
// Only a failure prints. With NOISE_PARITY_REPORT set, it also prints the
// adapter and, for each quantity, how many of the 256 agree bit for bit and
// the largest difference. GPU_POWER_PREFERENCE=low-power tests the
// integrated GPU where there are two.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll (which loads Vulkan);
// no window, no display of its own, and no Vulkan SDK (with it, validation
// and synchronization validation are on, and must say nothing).

mod parity;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use * but Queue;
import gpu use *;
import noise use *;

const WIDTH = 64u32;
const HEIGHT = 256u32;

// The 32 bits of an f32, and the f32 of 32 bits ('as' reinterprets)
fn bits(f f32) u32 { f as u32; }
fn fromBits(b u32) f32 { b as f32; }

// Sample point 'a' (0 to 255), as parity.slang's 'samplePoint'
fn samplePoint(a u32) Vec3 {
  imm gx = a % 16u32;
  imm gy = a / 16u32;
  mut x = f32.from(gx) * 0.40625 - 3.21875;
  mut y = f32.from(gy) * 0.34375 + 0.53125;
  mut z = f32.from(gx ^ gy) * 0.28125 - 1.90625;
  if a >= 128u32 {
    x = x + 1000.25;
    y = y - 777.5;
    z = z + 4096.125;
  }
  new Vec3(x, y, z);
}

// Its four words, as parity.slang's 'sampleWords'
fn sampleWords(a u32) UVec4 { new UVec4(a * 2654435761u32, a + 2147483632u32, a * a * 40503u32, ~a); }

fn pick2(n Noise2, c u32) f32 { if c == 0u32 { n.value; } elif c == 1u32 { n.d.x; } else { n.d.y; }; }
fn pick3(n Noise3, c u32) f32 {
  if c == 0u32 { n.value; } elif c == 1u32 { n.d.x; } elif c == 2u32 { n.d.y; } else { n.d.z; };
}

// Quantity 'q' at sample point 'a', as 32 bits: parity.slang's 'quantity'
fn quantity(q u32, a u32) u32 {
  imm p3 = samplePoint(a);
  imm p2 = new Vec2(p3.x, p3.y);
  imm w = sampleWords(a);
  imm seed = 7u32;
  if q == 0u32 { return pcg(w.x); }
  if q < 3u32 {
    imm h = pcg2d(new UVec2(w.x, w.y));
    return if q == 1u32 { h.x; } else { h.y; };
  }
  if q < 6u32 {
    imm h = pcg3d(new UVec3(w.x, w.y, w.z));
    return if q == 3u32 { h.x; } elif q == 4u32 { h.y; } else { h.z; };
  }
  if q < 10u32 {
    imm h = pcg4d(w);
    return if q == 6u32 { h.x; } elif q == 7u32 { h.y; } elif q == 8u32 { h.z; } else { h.w; };
  }
  if q == 10u32 { return hash1(i32.from(a) - 128, seed); }
  if q == 11u32 { return bits(toUnit(pcg(w.x))); }
  if q == 12u32 { return bits(toSigned(pcg(w.x))); }
  if q < 16u32 { return bits(pick2(value2(p2, seed), q - 13u32)); }
  if q < 19u32 { return bits(pick2(gradient2(p2, seed), q - 16u32)); }
  if q < 23u32 { return bits(pick3(value3(p3, seed), q - 19u32)); }
  if q < 27u32 { return bits(pick3(gradient3(p3, seed), q - 23u32)); }
  if q < 30u32 { return bits(pick2(gradient2Periodic(p2, 4, seed), q - 27u32)); }
  if q < 34u32 { return bits(pick3(gradient3Periodic(p3, 5, seed), q - 30u32)); }
  if q < 39u32 {
    imm c = cellular2(p2, 1., seed);
    if q == 36u32 { return c.id; }
    return bits(if q == 34u32 { c.f1; } elif q == 35u32 { c.f2; } elif q == 37u32 { c.toNearest.x; }
      else { c.toNearest.y; });
  }
  if q < 45u32 {
    imm c = cellular3(p3, 1., seed);
    if q == 41u32 { return c.id; }
    return bits(if q == 39u32 { c.f1; } elif q == 40u32 { c.f2; } elif q == 42u32 { c.toNearest.x; }
      elif q == 43u32 { c.toNearest.y; } else { c.toNearest.z; });
  }
  if q < 48u32 { return bits(pick2(fbm2(p2, seed, 5, 2., 0.5), q - 45u32)); }
  if q == 48u32 { return bits(ridged2(p2, seed, 5, 2., 0.5).value); }
  if q == 49u32 { return bits(billow2(p2, seed, 5, 2., 0.5).value); }
  if q < 54u32 { return bits(pick3(fbm3(p3, seed, 4, 2., 0.5), q - 50u32)); }
  if q == 54u32 { return bits(ridged3(p3, seed, 4, 2., 0.5).value); }
  if q == 55u32 { return bits(billow3(p3, seed, 4, 2., 0.5).value); }
  if q == 56u32 { return bits(warp2(p2, seed, 4, 4.)); }
  if q == 57u32 { return bits(warp3(p3, seed, 3, 4.)); }
  if q < 62u32 {
    imm ph = phacelle2(p2, new Vec2(0.6, 0.8), 1., 0.25, 0.5, seed);
    return bits(if q == 58u32 { ph.value.x; } elif q == 59u32 { ph.value.y; } elif q == 60u32 { ph.side.x; }
      else { ph.side.y; });
  }
  if q == 62u32 { return bits(value2Periodic(p2, 3, seed).value); }
  bits(value3Periodic(p3, 3, seed).value);
}

// Whether quantity 'q' is a word (compared as bits, never as a number)
fn isWord(q u32) bool { q <= 10u32 or q == 36u32 or q == 41u32; }

// How far quantity 'q' may differ, in units in the last place: cellular
// F1 and F2 are square roots, which Vulkan computes to within about 3 ulps,
// not correctly rounded as the CPU does
fn ulpTolerance(q u32) u64 { if q == 34u32 or q == 35u32 or q == 39u32 or q == 40u32 { 3u64; } else { 0u64; }; }

// How far quantity 'q' may differ, as a number: Phacelle's phase, a blend of
// sixteen cosines and sines (to within 2^-11 each on a GPU) weighted by
// exponentials, then normalized
fn tolerance(q u32) f64 { if q == 58u32 or q == 59u32 { 0.002d; } else { 0d; }; }

// The difference between two f32s in units in the last place, by their
// order as integers (-0 and +0 the same)
fn ulps(a u32, b u32) u64 {
  imm ia = if (a & 0x80000000u32) != 0u32 { -i64.from(a & 0x7fffffffu32); } else { i64.from(a); };
  imm ib = if (b & 0x80000000u32) != 0u32 { -i64.from(b & 0x7fffffffu32); } else { i64.from(b); };
  u64.from(if ia > ib { ia - ib; } else { ib - ia; });
}

fn main() i32 {
  mut instance = Instance.create("noise parity");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize {
    if libc.strcmp(env, &"low-power" as *u8) == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  imm report = (libc.getenv(&"NOISE_PARITY_REPORT" as *u8) as usize) != 0usize;
  mut adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");

  imm target = new TextureDescriptor(WIDTH, HEIGHT, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut color = device.createTexture(&target);
  require(color.isValid(), "a 64 x 256 target");
  mut readback = device.createBuffer(u64.from(WIDTH * HEIGHT * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm p = readback.mappedRange();

  mut shader = device.createShaderModule(&PARITY_SPIRV);
  mut layout = device.createEmptyPipelineLayout(0u32);
  imm noBuffers = List[VertexBufferLayout].empty();
  imm desc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, buffers: noBuffers.view(),
    fragmentModule: &shader, colorFormat: TEXTURE_FORMAT_RGBA8_UNORM);
  mut pipeline = device.createRenderPipeline(&desc);
  require(pipeline.isValid(), "the parity pipeline");
  {
    mut encoder = device.createCommandEncoder();
    imm attachment = new RenderPassColorAttachment(view: color.createView(), clearValue: new Color(0., 0., 0., 0.));
    mut pass = encoder.beginRenderPass(&attachment);
    pass.setPipeline(&pipeline);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
    encoder.copyTextureToBuffer(&color, &readback);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
  }

  if report {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr("\nquantity  exact/256  max|diff|  max ulps\n");
  }
  mut q = 0u32;
  while q < WIDTH {
    mut exact = 0u32;
    mut maxDiff = 0d;
    mut maxUlps = 0u64;
    mut a = 0u32;
    while a < HEIGHT {
      imm at = p + usize.from((a * WIDTH + q) * 4u32);
      imm gpuBits = u32.from(*at) | (u32.from(*(at + 1usize)) << 8u32) | (u32.from(*(at + 2usize)) << 16u32)
        | (u32.from(*(at + 3usize)) << 24u32);
      imm cpuBits = quantity(q, a);
      if gpuBits == cpuBits {
        exact = exact + 1u32;
      } elif !isWord(q) {
        imm d = f64.from(fromBits(gpuBits)) - f64.from(fromBits(cpuBits));
        imm ad = if d < 0d { -d; } else { d; };
        if ad > maxDiff { maxDiff = ad; }
        imm u = ulps(gpuBits, cpuBits);
        if u > maxUlps { maxUlps = u; }
      }
      a = a + 1u32;
    }
    if report {
      printUInt(u64.from(q));
      printStr("  ");
      printUInt(u64.from(exact));
      printStr("  ");
      printFloat(maxDiff);
      printStr("  ");
      printUInt(maxUlps);
      printStr("\n");
    }
    imm ok = if isWord(q) { exact == HEIGHT; } elif tolerance(q) > 0d { maxDiff <= tolerance(q); }
      else { maxUlps <= ulpTolerance(q); };
    if !ok {
      printStr("quantity ");
      printUInt(u64.from(q));
      printStr(": ");
    }
    if isWord(q) {
      expectUInt(u64.from(exact), u64.from(HEIGHT), "every sample bit for bit");
    } elif tolerance(q) > 0d {
      expectFloat(maxDiff, 0d, tolerance(q), "within the tolerance");
    } elif ulpTolerance(q) > 0u64 {
      expect(maxUlps <= ulpTolerance(q), "every sample to within 3 ulps (a square root)");
    } else {
      expectUInt(u64.from(exact), u64.from(HEIGHT), "every sample bit for bit");
    }
    q = q + 1u32;
  }

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}

