// The noise package's Phacelle noise: oriented stripes. Only a failure
// prints.
//
// - Fully normalized (normalization 1), the result's value, (cos, sin) of
//   the phase, has length 1 wherever the blend does not cancel.
// - 'side' is the direction across the stripes, (-dir.y, dir.x), times 2 pi
//   times the frequency.
// - The stripes run along 'dir': over 400 points, a step of 0.05 along it
//   changes the stripes' value (the cosine) far less, on average, than the
//   same step across it, where the phase advances 2 pi freq x 0.05 = 0.31
//   radians.
// - Across the stripes, the cosine's rate of change is close to -sin times
//   'side' (the original's stated use of 'side'): within 30% on average.
// - Another seed, other cells; the same seed, the same stripes.

mod phacelle;

import testing use *;
import libc;
import geomath use *;
import noise use *;

fn main() i32 {
  imm seed = 5u32;
  imm dir = Vec2[0.6, 0.8];
  imm across = Vec2[-0.8, 0.6];

  // ---- Normalized, and the side vector ----
  imm r = phacelle2(Vec2[1.3, -0.7], dir, 1., 0., 1., seed);
  expectFloat(f64[r.value.length()], 1d, 0.00001d, "fully normalized: (cos, sin) of length 1");
  expectFloat(f64[r.side.x], -0.8d * 6.28318530717959d, 0.00001d, "side is across the stripes times 2 pi (x)");
  expectFloat(f64[r.side.y], 0.6d * 6.28318530717959d, 0.00001d, "side is across the stripes times 2 pi (y)");
  imm r2 = phacelle2(Vec2[1.3, -0.7], dir, 2., 0., 1., seed);
  expectFloat(f64[r2.side.length()], 2d * 6.28318530717959d, 0.0001d, "and times the frequency");

  // ---- Stripes along dir ----
  imm step f32 = 0.05;
  mut alongSum = 0d;
  mut acrossSum = 0d;
  mut derivErr = 0d;
  mut derivSize = 0d;
  mut j = 0;
  while j < 20 {
    mut i = 0;
    while i < 20 {
      imm p = Vec2[f32[i] * 0.31 - 3.1, f32[j] * 0.27 + 0.2];
      imm c = phacelle2(p, dir, 1., 0.25, 1., seed);
      imm a = phacelle2(Vec2[p.x + dir.x * step, p.y + dir.y * step], dir, 1., 0.25, 1., seed);
      imm x = phacelle2(Vec2[p.x + across.x * step, p.y + across.y * step], dir, 1., 0.25, 1., seed);
      alongSum = alongSum + libc.fabs(f64[a.value.x - c.value.x]);
      acrossSum = acrossSum + libc.fabs(f64[x.value.x - c.value.x]);
      // The cosine's derivative across the stripes, against -sin x side
      imm h f32 = 0.001953125;
      imm xp = phacelle2(Vec2[p.x + across.x * h, p.y + across.y * h], dir, 1., 0.25, 1., seed);
      imm xm = phacelle2(Vec2[p.x - across.x * h, p.y - across.y * h], dir, 1., 0.25, 1., seed);
      imm fd = (f64[xp.value.x] - f64[xm.value.x]) / (2d * f64[h]);
      imm analytic = -f64[c.value.y] * f64[c.side.dot(across)];
      derivErr = derivErr + libc.fabs(fd - analytic);
      derivSize = derivSize + libc.fabs(analytic);
      i = i + 1;
    }
    j = j + 1;
  }
  expect(alongSum * 4d < acrossSum, "a step along the stripes changes them under a quarter as much as one across");
  expect(derivErr < 0.3d * derivSize, "across the stripes the cosine changes at about -sin x side");

  // ---- Seeds ----
  imm q = Vec2[0.4, 2.2];
  expect(phacelle2(q, dir, 1., 0., 0.5, seed).value.x != phacelle2(q, dir, 1., 0., 0.5, seed + 1u32).value.x,
    "another seed, other stripes");
  expectFloat(f64[phacelle2(q, dir, 1., 0., 0.5, seed).value.y], f64[phacelle2(q, dir, 1., 0., 0.5, seed).value.y],
    0d, "the same seed and point, the same stripes");
  done();
}
