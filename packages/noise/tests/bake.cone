// The first real use of compute: noise's fBm baked into a 64 x 64 x 64 3-D
// texture by a compute shader (bake.slang, over noise.slang), and compared
// with the Cone package at every voxel.
//
// Voxel (x, y, z) is the point (-2.03125 + x / 16, 0.53125 + y / 16,
// 1.25 + z / 16), every coordinate a multiple of 1/32, so exact in binary;
// each is one multiply and one add, written in the same order on both sides.
// The shader writes, a voxel an invocation, 4 x 4 x 4 a workgroup:
//
// - 'values', an r32float 3-D storage texture: fbm3 (4 octaves, lacunarity
//   2, gain 0.5, seed 7);
// - 'hashes', an r32uint 3-D storage texture: hash3(x, y, z, seed).x;
// - 'derivatives', a storage buffer of the analytic derivative and the value
//   again, (d.x, d.y, d.z, value) a voxel.
//
// All three are read back and compared, all 262,144 voxels:
//
// - the hashes must be identical (integer arithmetic);
// - fBm and its derivative use only add, subtract, multiply and floor,
//   compiled with '-fp-mode precise', so they must be identical too: 0 units
//   in the last place, the same rule as the parity test's.
//
// Only a failure prints. With NOISE_BAKE_REPORT set, it also prints the
// adapter and, for each quantity, how many voxels agree bit for bit and the
// largest difference. GPU_POWER_PREFERENCE=low-power tests the integrated
// GPU where there are two.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll (which loads Vulkan);
// no window and no Vulkan SDK (with it, validation and synchronization
// validation are on, and must say nothing).

mod bake;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import gpu use *;
import noise use *;

const SIZE = 64u32;
const VOXELS = 262144usize;
const SEED = 7u32;
const OX f32 = -2.03125;
const OY f32 = 0.53125;
const OZ f32 = 1.25;
const STEP f32 = 0.0625;

fn preference() u32 {
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize and libc.strcmp(env, &"low-power" as *u8) == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

// The 32 bits of an f32, and the f32 of 32 bits ('as' reinterprets)
fn bits(f f32) u32 { f as u32; }
fn fromBits(b u32) f32 { b as f32; }

// The difference between two f32s in units in the last place, by their
// order as integers (-0 and +0 the same)
fn ulps(a u32, b u32) u64 {
  imm ia = if (a & 0x80000000u32) != 0u32 { -i64.from(a & 0x7fffffffu32); } else { i64.from(a); };
  imm ib = if (b & 0x80000000u32) != 0u32 { -i64.from(b & 0x7fffffffu32); } else { i64.from(b); };
  u64.from(if ia > ib { ia - ib; } else { ib - ia; });
}

// How one quantity compared, voxel by voxel
struct Tally {
  pub exact u32;
  pub maxDiff f64;
  pub maxUlps u64;

  pub fn add(self &mut, gpuBits u32, cpuBits u32) {
    if gpuBits == cpuBits {
      exact = exact + 1u32;
      return;
    }
    imm d = f64.from(fromBits(gpuBits)) - f64.from(fromBits(cpuBits));
    imm ad = if d < 0d { -d; } else { d; };
    if ad > maxDiff { maxDiff = ad; }
    imm u = ulps(gpuBits, cpuBits);
    if u > maxUlps { maxUlps = u; }
  }

  pub fn report(self &, name &[]u8) {
    printStr(name);
    printStr("  ");
    printUInt(u64.from(exact));
    printStr("  ");
    printFloat(maxDiff);
    printStr("  ");
    printUInt(maxUlps);
    printStr("\n");
  }
}

fn main() i32 {
  mut instance = Instance.create("noise bake");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  imm report = (libc.getenv(&"NOISE_BAKE_REPORT" as *u8) as usize) != 0usize;
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");

  imm valuesDesc = TextureDescriptor[width: SIZE, height: SIZE, format: TEXTURE_FORMAT_R32_FLOAT,
    usage: TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_COPY_SRC, depthOrArrayLayers: SIZE,
    dimension: TEXTURE_DIMENSION_3D];
  mut values = device.createTexture(&valuesDesc);
  imm hashesDesc = TextureDescriptor[width: SIZE, height: SIZE, format: TEXTURE_FORMAT_R32_UINT,
    usage: TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_COPY_SRC, depthOrArrayLayers: SIZE,
    dimension: TEXTURE_DIMENSION_3D];
  mut hashes = device.createTexture(&hashesDesc);
  mut derivatives = device.createBuffer(u64.from(VOXELS) * 16u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_SRC);
  mut valuesBack = device.createBuffer(u64.from(VOXELS) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut hashesBack = device.createBuffer(u64.from(VOXELS) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut derivativesBack = device.createBuffer(u64.from(VOXELS) * 16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  require(values.isValid() and hashes.isValid() and derivatives.isValid(), "the 3-D textures and the buffer");

  mut shader = device.createShaderModule(&BAKE_SPIRV);
  imm entries = [
    BindGroupLayoutEntry[binding: 0u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_STORAGE_TEXTURE,
      format: TEXTURE_FORMAT_R32_FLOAT, viewDimension: TEXTURE_VIEW_DIMENSION_3D],
    BindGroupLayoutEntry[binding: 1u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_STORAGE_TEXTURE,
      format: TEXTURE_FORMAT_R32_UINT, viewDimension: TEXTURE_VIEW_DIMENSION_3D],
    BindGroupLayoutEntry[binding: 2u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE]];
  mut groupLayout = device.createBindGroupLayout(&entries);
  imm groupLayouts = [&groupLayout];
  mut layout = device.createPipelineLayout(&groupLayouts, 24u32);
  imm pipelineDesc = ComputePipelineDescriptor[layout: &layout, module: &shader, entryPoint: "bakeMain"];
  mut pipeline = device.createComputePipeline(&pipelineDesc);
  imm valuesView = values.createView();
  imm hashesView = hashes.createView();
  imm groupEntries = [BindGroupEntry.texture(0u32, &valuesView), BindGroupEntry.texture(1u32, &hashesView),
    BindGroupEntry.buffer(2u32, &derivatives)];
  mut group = device.createBindGroup(&groupLayout, &groupEntries);
  require(pipeline.isValid() and group.isValid(), "the bake pipeline and its bind group");

  {
    mut encoder = device.createCommandEncoder();
    mut pass = encoder.beginComputePass();
    imm origin Array[f32, 4] = [OX, OY, OZ, STEP];
    imm words Array[u32, 2] = [SEED, SIZE];
    pass.setPipeline(&pipeline);
    pass.setBindGroup(0u32, &group);
    pass.setImmediates(0u32, &origin as *u8, 16u32);
    pass.setImmediates(16u32, &words as *u8, 8u32);
    pass.dispatchWorkgroups(SIZE / 4u32, SIZE / 4u32, SIZE / 4u32);
    pass.end();
    encoder.copyTextureToBuffer(&values, &valuesBack);
    encoder.copyTextureToBuffer(&hashes, &hashesBack);
    encoder.copyBufferToBuffer(&derivatives, 0u64, &derivativesBack, 0u64, u64.from(VOXELS) * 16u64);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
  }

  // Every voxel, on the CPU, compared
  imm v = valuesBack.mappedRange() as *u32;
  imm h = hashesBack.mappedRange() as *u32;
  imm d = derivativesBack.mappedRange() as *u32;
  mut hashExact = 0u32;
  mut value = Tally[0u32, 0d, 0u64];
  mut dx = Tally[0u32, 0d, 0u64];
  mut dy = Tally[0u32, 0d, 0u64];
  mut dz = Tally[0u32, 0d, 0u64];
  mut again = Tally[0u32, 0d, 0u64];
  mut z = 0u32;
  while z < SIZE {
    mut y = 0u32;
    while y < SIZE {
      mut x = 0u32;
      while x < SIZE {
        imm at = usize.from(x + SIZE * (y + SIZE * z));
        imm p = Vec3[OX + f32.from(x) * STEP, OY + f32.from(y) * STEP, OZ + f32.from(z) * STEP];
        imm n = fbm3(p, SEED, 4, 2., 0.5);
        if *(h + at) == hash3(i32.from(x), i32.from(y), i32.from(z), SEED).x { hashExact = hashExact + 1u32; }
        value.add(*(v + at), bits(n.value));
        dx.add(*(d + at * 4usize), bits(n.d.x));
        dy.add(*(d + at * 4usize + 1usize), bits(n.d.y));
        dz.add(*(d + at * 4usize + 2usize), bits(n.d.z));
        again.add(*(d + at * 4usize + 3usize), bits(n.value));
        x = x + 1u32;
      }
      y = y + 1u32;
    }
    z = z + 1u32;
  }

  if report {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr("\nquantity  exact/262144  max|diff|  max ulps\n");
    printStr("hash  ");
    printUInt(u64.from(hashExact));
    printStr("\n");
    value.report("fbm (texture)");
    again.report("fbm (buffer)");
    dx.report("d.x");
    dy.report("d.y");
    dz.report("d.z");
  }
  expectUInt(u64.from(hashExact), u64.from(VOXELS), "every voxel's hash, bit for bit");
  expectUInt(u64.from(value.exact), u64.from(VOXELS), "every voxel's fBm in the 3-D texture, bit for bit");
  expectUInt(u64.from(again.exact), u64.from(VOXELS), "every voxel's fBm in the storage buffer, bit for bit");
  expectUInt(u64.from(dx.exact), u64.from(VOXELS), "every voxel's derivative in x, bit for bit");
  expectUInt(u64.from(dy.exact), u64.from(VOXELS), "every voxel's derivative in y, bit for bit");
  expectUInt(u64.from(dz.exact), u64.from(VOXELS), "every voxel's derivative in z, bit for bit");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}

