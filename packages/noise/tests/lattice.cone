// The noise package's value and gradient noise, 2-D and 3-D. Only a failure
// prints.
//
// - At a lattice point value noise is the point's own random value, the
//   hash's first word as toSigned gives it, and gradient noise is 0 with
//   the point's gradient as its derivative: there the fade weights are 1 for
//   that corner and 0 for the rest, and the fade's derivative is 0.
// - Ranges, over a 40 x 40 (and 16 x 16 x 16) grid of points off the
//   lattice: value noise in [-1, 1), a blend of values in that range with
//   weights summing to 1. Gradient noise's corner ramps are g.(p - corner)
//   with each component of g in [-1, 1), so each is at most the sum of the
//   offsets' sizes along the axes, and the blend of those along one axis,
//   (1 - fade(t)) t + fade(t) (1 - t), is at most 1/2 (at t = 1/2): gradient
//   noise is within [-1, 1] in 2-D and [-1.5, 1.5] in 3-D.
// - The analytic derivative against central differences of the value, h =
//   2^-9: the difference quotient is within about h^2 times the third
//   derivative of the true one, and within f32's rounding of the value
//   (about 1e-7) over h, so within 2e-3.
// - Tiling: the periodic forms repeat exactly every 'period' cells (a shift
//   by a whole number of cells is exact in f32 here); the plain forms do not.
// - Seeds: another seed gives another field; the same seed, the same one.

mod lattice;

import testing use *;
import libc;
import geomath use *;
import noise use *;

fn near(got f32, want f32, within f64, label &Array[u8]) { expectFloat(f64.from(got), f64.from(want), within, label); }

// The worst difference between the analytic derivative and central
// differences over a grid of 2-D points
fn derivative2(kind i32, seed u32) f64 {
  imm h f32 = 0.001953125;
  mut worst = 0d;
  mut j = 0;
  while j < 12 {
    mut i = 0;
    while i < 12 {
      imm p = new Vec2(f32.from(i) * 0.37 - 2.1, f32.from(j) * 0.29 + 0.4);
      imm n = if kind == 0 { value2(p, seed); } else { gradient2(p, seed); };
      imm xp = if kind == 0 { value2(new Vec2(p.x + h, p.y), seed).value; } else { gradient2(new Vec2(p.x + h, p.y), seed).value; };
      imm xm = if kind == 0 { value2(new Vec2(p.x - h, p.y), seed).value; } else { gradient2(new Vec2(p.x - h, p.y), seed).value; };
      imm yp = if kind == 0 { value2(new Vec2(p.x, p.y + h), seed).value; } else { gradient2(new Vec2(p.x, p.y + h), seed).value; };
      imm ym = if kind == 0 { value2(new Vec2(p.x, p.y - h), seed).value; } else { gradient2(new Vec2(p.x, p.y - h), seed).value; };
      imm ex = libc.fabs((f64.from(xp) - f64.from(xm)) / (2d * f64.from(h)) - f64.from(n.d.x));
      imm ey = libc.fabs((f64.from(yp) - f64.from(ym)) / (2d * f64.from(h)) - f64.from(n.d.y));
      if ex > worst { worst = ex; }
      if ey > worst { worst = ey; }
      i = i + 1;
    }
    j = j + 1;
  }
  worst;
}

fn at3(kind i32, p Vec3, seed u32) Noise3 { if kind == 0 { value3(p, seed); } else { gradient3(p, seed); }; }

fn derivative3(kind i32, seed u32) f64 {
  imm h f32 = 0.001953125;
  mut worst = 0d;
  mut k = 0;
  while k < 6 {
    mut j = 0;
    while j < 6 {
      mut i = 0;
      while i < 6 {
        imm p = new Vec3(f32.from(i) * 0.37 - 1.1, f32.from(j) * 0.29 + 0.4, f32.from(k) * 0.43 - 0.7);
        imm n = at3(kind, p, seed);
        imm dx = (f64.from(at3(kind, new Vec3(p.x + h, p.y, p.z), seed).value) - f64.from(at3(kind, new Vec3(p.x - h, p.y, p.z), seed).value))
          / (2d * f64.from(h));
        imm dy = (f64.from(at3(kind, new Vec3(p.x, p.y + h, p.z), seed).value) - f64.from(at3(kind, new Vec3(p.x, p.y - h, p.z), seed).value))
          / (2d * f64.from(h));
        imm dz = (f64.from(at3(kind, new Vec3(p.x, p.y, p.z + h), seed).value) - f64.from(at3(kind, new Vec3(p.x, p.y, p.z - h), seed).value))
          / (2d * f64.from(h));
        imm e = libc.fabs(dx - f64.from(n.d.x)) + libc.fabs(dy - f64.from(n.d.y)) + libc.fabs(dz - f64.from(n.d.z));
        if e > worst { worst = e; }
        i = i + 1;
      }
      j = j + 1;
    }
    k = k + 1;
  }
  worst;
}

fn main() i32 {
  imm seed = 1234u32;

  // ---- At lattice points ----
  imm v = value2(new Vec2(3., -2.), seed);
  near(v.value, toSigned(hash2(3, -2, seed).x), 0d, "value2 at (3, -2) is its lattice value");
  near(v.d.x, 0., 0d, "value2's derivative at a lattice point is 0 (x)");
  near(v.d.y, 0., 0d, "value2's derivative at a lattice point is 0 (y)");
  imm v3 = value3(new Vec3(-1., 4., 2.), seed);
  near(v3.value, toSigned(hash3(-1, 4, 2, seed).x), 0d, "value3 at (-1, 4, 2) is its lattice value");
  imm g = gradient2(new Vec2(3., -2.), seed);
  imm hg = hash2(3, -2, seed);
  near(g.value, 0., 0d, "gradient2 is 0 at a lattice point");
  near(g.d.x, toSigned(hg.x), 0d, "gradient2's derivative there is the point's gradient (x)");
  near(g.d.y, toSigned(hg.y), 0d, "gradient2's derivative there is the point's gradient (y)");
  imm g3 = gradient3(new Vec3(-1., 4., 2.), seed);
  imm hg3 = hash3(-1, 4, 2, seed);
  near(g3.value, 0., 0d, "gradient3 is 0 at a lattice point");
  near(g3.d.x, toSigned(hg3.x), 0d, "gradient3's derivative there is the point's gradient (x)");
  near(g3.d.y, toSigned(hg3.y), 0d, "gradient3's derivative there is the point's gradient (y)");
  near(g3.d.z, toSigned(hg3.z), 0d, "gradient3's derivative there is the point's gradient (z)");

  // ---- Ranges ----
  mut v2lo f32 = 0.;
  mut v2hi f32 = 0.;
  mut g2max f32 = 0.;
  mut j = 0;
  while j < 40 {
    mut i = 0;
    while i < 40 {
      imm p = new Vec2(f32.from(i) * 0.173 - 3.3, f32.from(j) * 0.191 - 3.9);
      imm a = value2(p, seed).value;
      if a < v2lo { v2lo = a; }
      if a > v2hi { v2hi = a; }
      imm b = libc.fabsf(gradient2(p, seed).value);
      if b > g2max { g2max = b; }
      i = i + 1;
    }
    j = j + 1;
  }
  expect(v2lo >= -1. and v2hi < 1., "value2 within [-1, 1)");
  expect(v2lo < -0.5 and v2hi > 0.5, "value2 spreads over its range");
  expect(g2max <= 1., "gradient2 within [-1, 1]");
  expect(g2max > 0.3, "gradient2 is not flat");
  mut v3max f32 = 0.;
  mut g3max f32 = 0.;
  mut k = 0;
  while k < 16 {
    j = 0;
    while j < 16 {
      mut i = 0;
      while i < 16 {
        imm p = new Vec3(f32.from(i) * 0.173 - 1.3, f32.from(j) * 0.191 - 1.9, f32.from(k) * 0.211 + 0.05);
        imm a = libc.fabsf(value3(p, seed).value);
        if a > v3max { v3max = a; }
        imm b = libc.fabsf(gradient3(p, seed).value);
        if b > g3max { g3max = b; }
        i = i + 1;
      }
      j = j + 1;
    }
    k = k + 1;
  }
  expect(v3max <= 1., "value3 within [-1, 1]");
  expect(g3max <= 1.5, "gradient3 within [-1.5, 1.5]");
  expect(g3max > 0.3, "gradient3 is not flat");

  // ---- Derivatives against finite differences ----
  expectFloat(derivative2(0, seed), 0d, 0.002d, "value2's derivative");
  expectFloat(derivative2(1, seed), 0d, 0.002d, "gradient2's derivative");
  expectFloat(derivative3(0, seed), 0d, 0.004d, "value3's derivative (the sum over x, y and z)");
  expectFloat(derivative3(1, seed), 0d, 0.004d, "gradient3's derivative (the sum over x, y and z)");

  // ---- Tiling ----
  imm p2 = new Vec2(1.40625, -2.71875);
  imm t0 = gradient2Periodic(p2, 4, seed);
  imm t1 = gradient2Periodic(new Vec2(p2.x + 4., p2.y - 8.), 4, seed);
  near(t1.value, t0.value, 0d, "gradient2Periodic repeats every 4 cells");
  near(t1.d.x, t0.d.x, 0d, "and so does its derivative");
  imm u0 = value2Periodic(p2, 3, seed);
  imm u1 = value2Periodic(new Vec2(p2.x - 3., p2.y + 6.), 3, seed);
  near(u1.value, u0.value, 0d, "value2Periodic repeats every 3 cells, across 0");
  imm p3 = new Vec3(0.40625, -1.21875, 2.59375);
  imm w0 = gradient3Periodic(p3, 5, seed);
  imm w1 = gradient3Periodic(new Vec3(p3.x - 5., p3.y + 10., p3.z - 15.), 5, seed);
  near(w1.value, w0.value, 0d, "gradient3Periodic repeats every 5 cells");
  near(w1.d.z, w0.d.z, 0d, "and so does its derivative");
  imm x0 = value3Periodic(p3, 3, seed);
  imm x1 = value3Periodic(new Vec3(p3.x + 3., p3.y - 3., p3.z + 6.), 3, seed);
  near(x1.value, x0.value, 0d, "value3Periodic repeats every 3 cells");
  imm inTile = new Vec2(1.40625, 2.28125);
  near(gradient2Periodic(inTile, 4, seed).value, gradient2(inTile, seed).value, 0d,
    "a period changes nothing in a cell whose corners are all within the first tile");
  expect(gradient2(new Vec2(p2.x + 4., p2.y - 8.), seed).value != t0.value, "the plain form does not repeat");

  // ---- Seeds ----
  expect(gradient2(p2, seed).value != gradient2(p2, seed + 1u32).value, "another seed, another gradient2");
  expect(value3(p3, seed).value != value3(p3, seed + 1u32).value, "another seed, another value3");
  near(gradient3(p3, seed).value, gradient3(p3, seed).value, 0d, "the same seed and point, the same value");
  done();
}
