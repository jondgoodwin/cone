// The noise package's fractal sums (fBm, ridged, billowed) and domain
// warps. Only a failure prints.
//
// - One octave of fBm is gradient noise seeded by hash1(0, seed); two are
//   that plus half of gradient noise at twice the frequency seeded by
//   hash1(1, seed), whose derivative counts twice (the chain rule) times
//   half: exactly, the same operations in the same order.
// - Ranges, over a 32 x 32 grid, 5 octaves of gain 0.5: 2-D gradient noise
//   is within [-1, 1], so fBm within 1 + 1/2 + ... + 1/16 = 1.9375 either
//   way, a ridged layer (1 - |n|)^2 within [0, 1] so ridged within
//   [0, 1.9375], and a billowed one 2|n| - 1 within [-1, 1].
// - Derivatives against central differences (h = 2^-9), 3 octaves, at
//   points where no octave's noise is within 0.02 of 0 (a ridged or
//   billowed layer has a crease there, and no derivative).
// - A warp of strength 0 is the fBm at the point itself; a warp moves it.

mod fractal;

import testing use *;
import libc;
import geomath use *;
import noise use *;

// Whether some octave of 'octaves' has its noise within 0.02 of 0 near 'p'
fn nearCrease(p Vec2, seed u32, octaves i32) bool {
  var freq f32 = 1.;
  var i = 0;
  while i < octaves {
    if libc.fabsf(gradient2(new Vec2(p.x * freq, p.y * freq), hash1(i, seed)).value) < 0.02 { return true; }
    freq = freq * 2.;
    i = i + 1;
  }
  false
}

fn sum2(kind i32, p Vec2, seed u32) Noise2 {
  if kind == 0 { fbm2(p, seed, 3, 2., 0.5) } elif kind == 1 { ridged2(p, seed, 3, 2., 0.5) }
  else { billow2(p, seed, 3, 2., 0.5) }
}

// The worst difference between the analytic derivative and central
// differences, over the points of a 12 x 12 grid away from creases
fn derivative2(kind i32, seed u32) f64 {
  let h f32 = 0.001953125;
  var worst = 0.0;
  var j = 0;
  while j < 12 {
    var i = 0;
    while i < 12 {
      let p = new Vec2(f32.from(i) * 0.37 - 2.1, f32.from(j) * 0.29 + 0.4);
      if !nearCrease(p, seed, 3) {
        let n = sum2(kind, p, seed);
        let dx = (f64.from(sum2(kind, new Vec2(p.x + h, p.y), seed).value) - f64.from(sum2(kind, new Vec2(p.x - h, p.y), seed).value))
          / (2.0 * f64.from(h));
        let dy = (f64.from(sum2(kind, new Vec2(p.x, p.y + h), seed).value) - f64.from(sum2(kind, new Vec2(p.x, p.y - h), seed).value))
          / (2.0 * f64.from(h));
        let e = libc.fabs(dx - f64.from(n.d.x)) + libc.fabs(dy - f64.from(n.d.y));
        if e > worst { worst = e; }
      }
      i = i + 1;
    }
    j = j + 1;
  }
  worst
}

fn main() i32 {
  let seed = 31u32;
  let p = new Vec2(0.8125, -1.4375);

  // ---- One and two octaves ----
  let one = fbm2(p, seed, 1, 2., 0.5);
  let g0 = gradient2(p, hash1(0, seed));
  expectFloat(f64.from(one.value), f64.from(g0.value), 0.0, "one octave of fbm2 is gradient2 under hash1(0, seed)");
  expectFloat(f64.from(one.d.x), f64.from(g0.d.x), 0.0, "and so is its derivative");
  let two = fbm2(p, seed, 2, 2., 0.5);
  let g1 = gradient2(new Vec2(p.x * 2., p.y * 2.), hash1(1, seed));
  expectFloat(f64.from(two.value), f64.from(g0.value + 0.5 * g1.value), 0.0, "two octaves: plus half the next at twice the frequency");
  expectFloat(f64.from(two.d.y), f64.from(g0.d.y + g1.d.y), 0.0, "whose derivative counts 2 x 1/2 = 1 times");
  let p3 = new Vec3(0.8125, -1.4375, 2.25);
  let one3 = fbm3(p3, seed, 1, 2., 0.5);
  expectFloat(f64.from(one3.value), f64.from(gradient3(p3, hash1(0, seed)).value), 0.0, "one octave of fbm3 is gradient3");
  expectFloat(f64.from(fbm2(p, seed, 0, 2., 0.5).value), 0.0, 0.0, "no octaves: 0");

  // ---- Ranges ----
  var fbmMax f32 = 0.;
  var ridgedLo f32 = 10.;
  var ridgedHi f32 = -10.;
  var billowMax f32 = 0.;
  var j = 0;
  while j < 32 {
    var i = 0;
    while i < 32 {
      let q = new Vec2(f32.from(i) * 0.213 - 3.3, f32.from(j) * 0.187 + 1.9);
      let f = libc.fabsf(fbm2(q, seed, 5, 2., 0.5).value);
      if f > fbmMax { fbmMax = f; }
      let r = ridged2(q, seed, 5, 2., 0.5).value;
      if r < ridgedLo { ridgedLo = r; }
      if r > ridgedHi { ridgedHi = r; }
      let b = libc.fabsf(billow2(q, seed, 5, 2., 0.5).value);
      if b > billowMax { billowMax = b; }
      i = i + 1;
    }
    j = j + 1;
  }
  expect(fbmMax <= 1.9375 and fbmMax > 0.3, "fbm2 within [-1.9375, 1.9375], and not flat");
  expect(ridgedLo >= 0. and ridgedHi <= 1.9375, "ridged2 within [0, 1.9375]");
  expect(ridgedHi - ridgedLo > 0.3, "ridged2 is not flat");
  expect(billowMax <= 1.9375, "billow2 within [-1.9375, 1.9375]");

  // ---- Derivatives ----
  expectFloat(derivative2(0, seed), 0.0, 0.01, "fbm2's derivative");
  expectFloat(derivative2(1, seed), 0.0, 0.01, "ridged2's derivative, away from its creases");
  expectFloat(derivative2(2, seed), 0.0, 0.01, "billow2's derivative, away from its creases");
  {
    let h f32 = 0.001953125;
    let q = new Vec3(0.3, 1.7, -0.45);
    let n = ridged3(q, seed, 2, 2., 0.5);
    let dz = (f64.from(ridged3(new Vec3(q.x, q.y, q.z + h), seed, 2, 2., 0.5).value)
      - f64.from(ridged3(new Vec3(q.x, q.y, q.z - h), seed, 2, 2., 0.5).value)) / (2.0 * f64.from(h));
    expectFloat(f64.from(n.d.z), dz, 0.01, "ridged3's derivative along z");
    let b = billow3(q, seed, 2, 2., 0.5);
    let bx = (f64.from(billow3(new Vec3(q.x + h, q.y, q.z), seed, 2, 2., 0.5).value)
      - f64.from(billow3(new Vec3(q.x - h, q.y, q.z), seed, 2, 2., 0.5).value)) / (2.0 * f64.from(h));
    expectFloat(f64.from(b.d.x), bx, 0.01, "billow3's derivative along x");
  }

  // ---- Domain warp ----
  expectFloat(f64.from(warp2(p, seed, 4, 0.)), f64.from(fbm2(p, seed, 4, 2., 0.5).value), 0.0,
    "warp2 of strength 0 is the fbm at the point");
  expectFloat(f64.from(warp3(p3, seed, 3, 0.)), f64.from(fbm3(p3, seed, 3, 2., 0.5).value), 0.0,
    "warp3 of strength 0 is the fbm at the point");
  expect(warp2(p, seed, 4, 4.) != fbm2(p, seed, 4, 2., 0.5).value, "strength 4 moves it");
  expect(warp2(p, seed, 4, 4.) != warp2(p, seed + 1u32, 4, 4.), "another seed, another warp");
  expectFloat(f64.from(warp3(p3, seed, 3, 4.)), f64.from(warp3(p3, seed, 3, 4.)), 0.0, "the same seed and point, the same warp");
  done()
}
