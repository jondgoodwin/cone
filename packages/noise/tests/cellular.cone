// The noise package's cellular (Worley) noise. Only a failure prints.
//
// - Against brute force: at 400 points in 2-D and 125 in 3-D, F1, F2, the
//   id and the vector to the nearest point equal those of a search of every
//   cell within three (7 x 7, 7 x 7 x 7), each feature point placed as the
//   package places it (the cell's middle, moved by jitter x (toUnit - 1/2)
//   along each axis), the id the hash's third (2-D) or fourth (3-D) word.
//   The search's pruning must lose nothing.
// - Jitter 0: the points are the cells' middles, so at (0.75, 0.5) F1 is
//   0.25 (to (0.5, 0.5), in cell (0, 0)) and F2 0.75 (to (1.5, 0.5)); both
//   exact in binary.
// - F1 <= F2 everywhere, and the id is constant across a cell's region: two
//   points near the same feature point share it.

mod cellular;

import testing use *;
import libc;
import geomath use *;
import noise use *;

// Brute-force 2-D cellular noise over the 7 x 7 cells about 'p': F1 and F2
// squared, the id, the offset to the nearest
struct Brute {
  pub f1 f32;
  pub f2 f32;
  pub id u32;
  pub n Vec3;
}

fn brute2(p Vec2, jitter f32, seed u32) Brute {
  imm fx = libc.floorf(p.x);
  imm fy = libc.floorf(p.y);
  mut best = Brute[3.4028235e38, 3.4028235e38, 0u32, Vec3[0., 0., 0.]];
  mut j = -3;
  while j <= 3 {
    mut i = -3;
    while i <= 3 {
      imm h = hash2(i32.from(fx) + i, i32.from(fy) + j, seed);
      imm dx = f32.from(i) + 0.5 + jitter * (toUnit(h.x) - 0.5) - (p.x - fx);
      imm dy = f32.from(j) + 0.5 + jitter * (toUnit(h.y) - 0.5) - (p.y - fy);
      imm d2 = dx * dx + dy * dy;
      if d2 < best.f1 {
        best = Brute[d2, best.f1, h.z, Vec3[dx, dy, 0.]];
      } elif d2 < best.f2 {
        best.f2 = d2;
      }
      i = i + 1;
    }
    j = j + 1;
  }
  best;
}

fn brute3(p Vec3, jitter f32, seed u32) Brute {
  imm fx = libc.floorf(p.x);
  imm fy = libc.floorf(p.y);
  imm fz = libc.floorf(p.z);
  mut best = Brute[3.4028235e38, 3.4028235e38, 0u32, Vec3[0., 0., 0.]];
  mut k = -3;
  while k <= 3 {
    mut j = -3;
    while j <= 3 {
      mut i = -3;
      while i <= 3 {
        imm h = hash3(i32.from(fx) + i, i32.from(fy) + j, i32.from(fz) + k, seed);
        imm dx = f32.from(i) + 0.5 + jitter * (toUnit(h.x) - 0.5) - (p.x - fx);
        imm dy = f32.from(j) + 0.5 + jitter * (toUnit(h.y) - 0.5) - (p.y - fy);
        imm dz = f32.from(k) + 0.5 + jitter * (toUnit(h.z) - 0.5) - (p.z - fz);
        imm d2 = dx * dx + dy * dy + dz * dz;
        if d2 < best.f1 {
          best = Brute[d2, best.f1, h.w, Vec3[dx, dy, dz]];
        } elif d2 < best.f2 {
          best.f2 = d2;
        }
        i = i + 1;
      }
      j = j + 1;
    }
    k = k + 1;
  }
  best;
}

fn main() i32 {
  imm seed = 99u32;

  // ---- Against brute force ----
  mut agree2 = 0;
  mut ordered = 0;
  mut j = 0;
  while j < 20 {
    mut i = 0;
    while i < 20 {
      imm p = Vec2[f32.from(i) * 0.231 - 2.3, f32.from(j) * 0.257 + 7.1];
      imm c = cellular2(p, 1., seed);
      imm b = brute2(p, 1., seed);
      if c.f1 == b.f1.sqrt() and c.f2 == b.f2.sqrt() and c.id == b.id and c.toNearest.x == b.n.x
          and c.toNearest.y == b.n.y {
        agree2 = agree2 + 1;
      }
      if c.f1 <= c.f2 { ordered = ordered + 1; }
      i = i + 1;
    }
    j = j + 1;
  }
  expectInt(i64.from(agree2), 400i64, "cellular2 is brute force's at 400 points (jitter 1)");
  expectInt(i64.from(ordered), 400i64, "F1 <= F2 at all 400");
  mut agree3 = 0;
  mut k = 0;
  while k < 5 {
    j = 0;
    while j < 5 {
      mut i = 0;
      while i < 5 {
        imm p = Vec3[f32.from(i) * 0.431 - 1.3, f32.from(j) * 0.457 + 2.1, f32.from(k) * 0.389 - 0.6];
        imm c = cellular3(p, 1., seed);
        imm b = brute3(p, 1., seed);
        if c.f1 == b.f1.sqrt() and c.f2 == b.f2.sqrt() and c.id == b.id and c.toNearest.z == b.n.z {
          agree3 = agree3 + 1;
        }
        i = i + 1;
      }
      j = j + 1;
    }
    k = k + 1;
  }
  expectInt(i64.from(agree3), 125i64, "cellular3 is brute force's at 125 points (jitter 1)");
  imm half = cellular2(Vec2[0.3, 0.9], 0.5, seed);
  imm halfBrute = brute2(Vec2[0.3, 0.9], 0.5, seed);
  expect(half.f1 == halfBrute.f1.sqrt() and half.id == halfBrute.id, "and with jitter 0.5");

  // ---- Jitter 0: a regular grid ----
  imm grid = cellular2(Vec2[0.75, 0.5], 0., seed);
  expectFloat(f64.from(grid.f1), 0.25d, 0d, "jitter 0: F1 is the distance to the cell's middle");
  expectFloat(f64.from(grid.f2), 0.75d, 0d, "jitter 0: F2 to the next cell's middle");
  expectUInt(u64.from(grid.id), u64.from(hash2(0, 0, seed).z), "jitter 0: the id is cell (0, 0)'s hash");
  expectFloat(f64.from(grid.toNearest.x), -0.25d, 0d, "the vector to the nearest point (x)");
  imm grid3 = cellular3(Vec3[0.5, 0.5, 0.875], 0., seed);
  expectFloat(f64.from(grid3.f1), 0.375d, 0d, "3-D, jitter 0: F1");
  expectFloat(f64.from(grid3.f2), 0.625d, 0d, "3-D, jitter 0: F2, to the cell above");
  expectUInt(u64.from(grid3.id), u64.from(hash3(0, 0, 0, seed).w), "3-D, jitter 0: the id is cell (0, 0, 0)'s hash");

  // ---- The id is constant near a feature point ----
  imm c0 = cellular2(Vec2[5.3, -1.7], 1., seed);
  imm pointAt = Vec2[5.3 + c0.toNearest.x, -1.7 + c0.toNearest.y];
  imm c1 = cellular2(Vec2[pointAt.x + 0.01, pointAt.y - 0.01], 1., seed);
  expectUInt(u64.from(c1.id), u64.from(c0.id), "a point beside the nearest feature point has the same id");
  expect(c1.f1 < 0.015, "and is within 0.015 of it");
  expect(cellular2(Vec2[5.3, -1.7], 1., seed + 1u32).id != c0.id, "another seed, other cells");
  done();
}
