// The 'Path' type and its methods, each expected value worked out on paper from
// the rules at the top of the package's source (the same rules the free
// functions in 'lexical' check, here reached as methods):
// - a literal becomes a Path where one is wanted by value (a variable, an
//   argument, a result), and any other text is copied in with 'Path.from';
//   where a Path is wanted borrowed a literal is lent as a temporary one
//   (literalborrow.cone);
// - 'parent', 'join' and 'normalize' answer a new Path; 'name', 'stem',
//   'extension' and 'volume' answer a piece of the path's own text;
// - two Paths are equal when their text is the same bytes, and hash alike.
//
// Where Windows' rules and POSIX's differ (a drive, a share and '\'), each
// case gives both answers, 'os(windows, posix)'; see 'lexical'.

mod methods;

import testing use *;
import collections use *;
import path use Path;

// The answer for this system: Windows' or POSIX's
fn os(windows &str, posix &str) &str { if isWindows() {windows} else {posix}; }

// A literal given where a Path is wanted
fn lenOf(p Path) usize { p.view().len() }
fn made() Path { "made/it.txt" }

fn parentIs(p Path, want &str) {
  let got = p.parent();
  expectStr(got.view(), want, "parent");
}

fn nameIs(p Path, name &str, stem &str, ext &str) {
  expectStr(p.name(), name, "name");
  expectStr(p.stem(), stem, "stem");
  expectStr(p.extension(), ext, "extension");
}

// Both forms of join: the other as a Path, and as text
fn joinIs(a Path, b Path, want &str) {
  let got = a.join(&b);
  expectStr(got.view(), want, "join a Path");
  let viaText = a.join(b.view());
  expectStr(viaText.view(), want, "join text");
}

fn normalIs(p Path, want &str) {
  let got = p.normalize();
  expectStr(got.view(), want, "normalize");
}

fn partsAre(p Path, want &str) {
  let ps = p.parts();
  let got = String.join(ps.view(), "|");
  expectStr(got.view(), want, "parts");
}

fn hashOf(p &Path) u64 {
  var h = Hasher.withSeed(7u64);
  p.hash(&mut h);
  h.finish()
}

fn main() i32 {
  // A literal becomes a Path wherever one is wanted by value: bytes kept as
  // written
  let declared Path = "C:\\work\\a.txt";
  expectStr(declared.view(), "C:\\work\\a.txt", "a literal declared as a Path");
  expectUInt(u64.from(lenOf("four")), 4, "a literal given for a Path");
  let result = made();
  expectStr(result.view(), "made/it.txt", "a literal returned as a Path");
  // Any other text is copied in
  let s = String.from("é/日本");
  let copied = Path.from(s.view());
  expectStr(copied.view(), "é/日本", "Path.from copies the text");
  let owned = Path.fromString(String.from("kept"));
  expectStr(owned.view(), "kept", "Path.fromString keeps the String");
  expectBool(Path.from("").isEmpty(), true, "an empty path is empty");
  expectBool(declared.isEmpty(), false, "a path with text is not");
  let dup = declared.copy();
  expectStr(dup.view(), "C:\\work\\a.txt", "a copy holds the same text");

  // isAbsolute and volume (POSIX: a root only, and no volume)
  expectBool(Path.from("C:\\x").isAbsolute(), isWindows(), "C:\\x is absolute on Windows only");
  expectBool(Path.from("C:").isAbsolute(), false, "C: alone is not");
  expectBool(Path.from("\\x").isAbsolute(), false, "\\x is not (no drive)");
  expectBool(Path.from("x/y").isAbsolute(), false, "x/y is not");
  expectBool(Path.from("\\\\server\\share").isAbsolute(), isWindows(), "a share is, on Windows");
  expectStr(Path.from("C:\\x").volume(), os("C:", ""), "the volume of C:\\x");
  expectStr(Path.from("//server/share/x").volume(), os("//server/share", ""), "the volume of a share, as written");
  expectStr(Path.from("x/y").volume(), "", "no volume");

  // parent: C:\a\b.txt is in C:\a; a root is its own parent; a bare name is
  // in the current folder, ""
  parentIs("C:\\a\\b.txt", os("C:\\a", ""));
  parentIs("a/b/c.txt", "a/b");
  parentIs("a/b/", "a");
  parentIs("C:\\x", os("C:\\", ""));
  parentIs("C:\\", os("C:\\", ""));
  parentIs("c.txt", "");
  let grand = Path.from("a/b/c.txt").parent().parent();
  expectStr(grand.view(), "a", "parent chains: a/b/c.txt, a/b, a");

  // name, stem and extension: the last dot splits the name
  nameIs("C:\\a\\b.txt", os("b.txt", "C:\\a\\b.txt"), os("b", "C:\\a\\b"), ".txt");
  nameIs("a/b.tar.gz", "b.tar.gz", "b.tar", ".gz");
  nameIs(".profile", ".profile", ".profile", "");
  nameIs("a/b/", "b", "b", "");
  nameIs("C:\\", os("", "C:\\"), os("", "C:\\"), "");
  nameIs("é/日本.txt", "日本.txt", "日本", ".txt");

  // join: a '/' between, unless the left ends in a separator; a right side
  // with a drive or a share wins outright; one with only a root keeps the
  // left's volume; nothing is normalized
  joinIs("a", "b", "a/b");
  joinIs("a/", "b", "a/b");
  joinIs("C:\\work", "src/main.cone", "C:\\work/src/main.cone");
  joinIs("C:\\a", "D:\\b", os("D:\\b", "C:\\a/D:\\b"));
  joinIs("C:\\a", "\\b", os("C:\\b", "C:\\a/\\b"));
  joinIs("a/b", "/c", "/c");
  joinIs("a", "../b", "a/../b");
  joinIs("", "b", "b");
  joinIs("a", "", "a");
  let dir Path = "C:\\proj";
  let file = dir.join("src").join("m.cone");
  expectStr(file.view(), "C:\\proj/src/m.cone", "join chains, a literal on the right");

  // parts: the volume and root as one piece, then each name
  partsAre("a/b/c", "a|b|c");
  partsAre("C:\\a\\b", os("C:\\|a|b", "C:\\a\\b"));
  partsAre("/a//b/", "/|a|b");
  partsAre("a/./../b", "a|.|..|b");
  partsAre("", "");

  // normalize: one separator, no '.', a '..' drops the name before it
  normalIs("a/./b/.", "a/b");
  normalIs("a\\b", os("a/b", "a\\b"));
  normalIs("a/b/../../..", "..");
  normalIs("C:\\a\\..\\..\\b", os("C:/b", "C:\\a\\..\\..\\b"));
  normalIs("C:\\", os("C:/", "C:\\"));
  normalIs("a/..", ".");
  normalIs("../a", "../a");

  // Equal text is equal and hashes alike; a different spelling is not equal
  let one Path = "a/b";
  let same = Path.from("a/b");
  let other = Path.from("a\\b");
  expectBool(one == &same, true, "the same text is equal");
  expectBool(one == "a/b", true, "equal to a literal");
  expectBool(one == &other, false, "another spelling is not equal");
  expectUInt(hashOf(&one), hashOf(&same), "equal paths hash alike");
  expectBool(hashOf(&one) != hashOf(&other), true, "another spelling hashes apart");
  let back = other.normalize();
  expectBool(back == &one, isWindows(), "normalized, the two spellings meet only where '\\' separates");
  var seen = Dict[Path, i64].empty();
  seen.insert(Path.from("a/b"), 7);
  expectBool(seen.contains(&one), true, "a Path is a Dict key");

  done()
}
