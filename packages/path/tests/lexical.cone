// The Path methods over paths written out by hand, each
// expected value worked out on paper from the rules in the package's header:
// relative and absolute paths, '.' and '..', separators doubled and
// trailing, both separators mixed, drive letters ('C:\', 'C:' alone, 'C:x')
// and UNC shares ('\\server\share'), and names in UTF-8 (é, 日本).
//
// A path is read by the rules of the system the program is built for, so
// where those rules differ each case gives both answers, 'os(windows, posix)':
// Windows' reading of a drive, a share and '\', and POSIX's, which has none of
// them (only '/' separates, a leading '/' is the root, and 'C:\x' is one
// name). The same cases, the same number of checks, on both.

mod lexical;

import testing use *;
import collections use *;
import path use Path;

// The answer for this system: Windows' or POSIX's
fn os(windows &str, posix &str) &str { if isWindows() {windows;} else {posix;}; }

fn joinIs(a &str, b &str, want &str) {
  imm base = Path.from(a);
  imm got = base.join(b);
  mut label = String.from("join ");
  label.append(a);
  label.append(" + ");
  label.append(b);
  expectStr(got.view(), want, label.view());
}

fn parentIs(p &str, want &str) {
  imm given = Path.from(p);
  imm got = given.parent();
  mut label = String.from("parent ");
  label.append(p);
  expectStr(got.view(), want, label.view());
}

fn nameIs(p &str, name &str, stem &str, ext &str) {
  imm given = Path.from(p);
  mut label = String.from("name ");
  label.append(p);
  expectStr(given.name(), name, label.view());
  label = String.from("stem ");
  label.append(p);
  expectStr(given.stem(), stem, label.view());
  label = String.from("extension ");
  label.append(p);
  expectStr(given.extension(), ext, label.view());
}

fn normalIs(p &str, want &str) {
  imm given = Path.from(p);
  imm got = given.normalize();
  mut label = String.from("normalize ");
  label.append(p);
  expectStr(got.view(), want, label.view());
}

// A path's parts, shown joined by '|'
fn partsAre(p &str, want &str) {
  imm given = Path.from(p);
  imm ps = given.parts();
  imm got = String.join(ps.view(), "|");
  mut label = String.from("parts ");
  label.append(p);
  expectStr(got.view(), want, label.view());
}

// Whether it is absolute, and its volume; POSIX has no volume, so only
// whether it is absolute differs there
fn absoluteIs(p &str, windows bool, posix bool, vol &str) {
  imm given = Path.from(p);
  mut label = String.from("isAbsolute ");
  label.append(p);
  expectBool(given.isAbsolute(), if isWindows() {windows;} else {posix;}, label.view());
  label = String.from("volume ");
  label.append(p);
  expectStr(given.volume(), os(vol, ""), label.view());
}

fn main() i32 {
  // isAbsolute and volume
  absoluteIs("C:\\x", true, false, "C:");
  absoluteIs("c:/x", true, false, "c:");
  absoluteIs("C:\\", true, false, "C:");
  absoluteIs("C:", false, false, "C:");
  absoluteIs("C:x", false, false, "C:");
  absoluteIs("\\x", false, false, "");
  absoluteIs("/x", false, true, "");
  absoluteIs("x/y", false, false, "");
  absoluteIs("", false, false, "");
  absoluteIs("\\\\server\\share", true, false, "\\\\server\\share");
  absoluteIs("//server/share/x", true, true, "//server/share");
  absoluteIs("\\\\server", false, false, "");
  absoluteIs("\\\\server\\", false, false, "");
  absoluteIs("1:/x", false, false, "");

  // join
  joinIs("a", "b", "a/b");
  joinIs("a/", "b", "a/b");
  joinIs("a\\", "b", os("a\\b", "a\\/b"));
  joinIs("C:\\work", "src/main.cone", "C:\\work/src/main.cone");
  joinIs("a", "", "a");
  joinIs("", "b", "b");
  joinIs("", "", "");
  joinIs("a", "../b", "a/../b");
  joinIs("C:", "x", os("C:x", "C:/x"));
  joinIs("C:\\a", "D:\\b", os("D:\\b", "C:\\a/D:\\b"));
  joinIs("C:\\a", "D:b", os("D:b", "C:\\a/D:b"));
  joinIs("C:\\a", "\\b", os("C:\\b", "C:\\a/\\b"));
  joinIs("a/b", "/c", "/c");
  joinIs("\\\\server\\share\\a", "/b", os("\\\\server\\share/b", "/b"));
  joinIs("C:\\a", "\\\\server\\share", os("\\\\server\\share", "C:\\a/\\\\server\\share"));
  joinIs("\\\\server\\share", "x", "\\\\server\\share/x");
  joinIs("é", "日本.txt", "é/日本.txt");

  // parent
  parentIs("a/b/c.txt", "a/b");
  parentIs("a\\b\\c.txt", os("a\\b", ""));
  parentIs("a/b/", "a");
  parentIs("a//b", "a");
  parentIs("c.txt", "");
  parentIs("", "");
  parentIs("/", "/");
  parentIs("/x", "/");
  parentIs("C:\\", os("C:\\", ""));
  parentIs("C:\\x", os("C:\\", ""));
  parentIs("C:\\x\\", os("C:\\", ""));
  parentIs("C:x", os("C:", ""));
  parentIs("C:", os("C:", ""));
  parentIs("a/..", "a");
  parentIs("..", "");
  parentIs("\\\\server\\share\\x", os("\\\\server\\share\\", ""));
  parentIs("\\\\server\\share", os("\\\\server\\share", ""));
  parentIs("é/日本", "é");

  // name, stem and extension: on POSIX a path with no '/' is one name
  nameIs("a/b/c.txt", "c.txt", "c", ".txt");
  nameIs("a/b.tar.gz", "b.tar.gz", "b.tar", ".gz");
  nameIs("a/b/", "b", "b", "");
  nameIs("a\\b\\\\", os("b", "a\\b\\\\"), os("b", "a\\b\\\\"), "");
  nameIs(".profile", ".profile", ".profile", "");
  nameIs("a/.profile.bak", ".profile.bak", ".profile", ".bak");
  nameIs("b.", "b.", "b", ".");
  nameIs(".", ".", ".", "");
  nameIs("..", "..", "..", "");
  nameIs("a/..", "..", "..", "");
  nameIs("", "", "", "");
  nameIs("/", "", "", "");
  nameIs("C:\\", os("", "C:\\"), os("", "C:\\"), "");
  nameIs("C:", os("", "C:"), os("", "C:"), "");
  nameIs("C:x.cone", os("x.cone", "C:x.cone"), os("x", "C:x"), ".cone");
  nameIs("\\\\server\\share", os("", "\\\\server\\share"), os("", "\\\\server\\share"), "");
  nameIs("\\\\server\\share\\x.y", os("x.y", "\\\\server\\share\\x.y"), os("x", "\\\\server\\share\\x"), ".y");
  nameIs("d.ir/file", "file", "file", "");
  nameIs("é/日本.txt", "日本.txt", "日本", ".txt");

  // parts
  partsAre("a/b/c", "a|b|c");
  partsAre("C:\\a\\b", os("C:\\|a|b", "C:\\a\\b"));
  partsAre("/a//b/", "/|a|b");
  partsAre("C:a", os("C:|a", "C:a"));
  partsAre("a/./../b", "a|.|..|b");
  partsAre("\\\\server\\share\\x", os("\\\\server\\share\\|x", "\\\\server\\share\\x"));
  partsAre("", "");
  partsAre("é\\日本", os("é|日本", "é\\日本"));

  // normalize
  normalIs("", ".");
  normalIs(".", ".");
  normalIs("./", ".");
  normalIs("a", "a");
  normalIs("a/", "a");
  normalIs("a//b", "a/b");
  normalIs("a\\b", os("a/b", "a\\b"));
  normalIs("a/./b/.", "a/b");
  normalIs("a/b/../c", "a/c");
  normalIs("a/..", ".");
  normalIs("a/../..", "..");
  normalIs("../a", "../a");
  normalIs("../../a/..", "../..");
  normalIs("/", "/");
  normalIs("\\", os("/", "\\"));
  normalIs("/..", "/");
  normalIs("/../a", "/a");
  normalIs("C:\\", os("C:/", "C:\\"));
  normalIs("C:\\..\\x", os("C:/x", "C:\\..\\x"));
  normalIs("C:\\a\\.\\b\\..\\c\\", os("C:/a/c", "C:\\a\\.\\b\\..\\c\\"));
  normalIs("c:/A/B", "c:/A/B");
  normalIs("C:", "C:");
  normalIs("C:.", os("C:", "C:."));
  normalIs("C:a\\..\\..", os("C:..", "C:a\\..\\.."));
  normalIs("\\\\server\\share", os("//server/share/", "\\\\server\\share"));
  normalIs("\\\\server\\share\\..\\x", os("//server/share/x", "\\\\server\\share\\..\\x"));
  normalIs("//server//share", "/server/share");
  normalIs("\\\\server", os("/server", "\\\\server"));
  normalIs("é/./日本/../x", "é/x");

  // isSeparator
  expectBool(path.isSeparator('/'), true, "slash separates");
  expectBool(path.isSeparator('\\'), isWindows(), "backslash separates only on Windows");
  expectBool(path.isSeparator(':'), false, "colon does not separate");
  done();
}
