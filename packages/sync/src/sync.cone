// The sync package: what threads share safely. It holds the atomic value
// Atomic[T], an integer, a Bool or a raw pointer that several threads may
// read and change at once without a lock, each change indivisible; 'arc',
// the region whose owners of one value several threads may hold; the futex,
// the one way a thread sleeps until another wakes it; the locks built on
// the futex: Mutex, RwLock, Condvar and Once; and the channel, a pipe of
// values from any number of threads to one, unbounded or bounded. Windows
// only for now: the futex's three functions, a yield and a clock are the
// package's only calls to the OS.
//
//   Atomic[T]      a value changed only indivisibly             (below)
//   arc            rc whose count is atomic: '+arc-imm T[...]'  (SHARED OWNERS)
//   futexWait, futexWake, futexWakeAll                           (THE FUTEX)
//   Mutex          one thread at a time                          (THE LOCKS)
//   RwLock         many readers, or one writer
//   Condvar        sleep until another thread says something changed
//   Once           a function run exactly once, however many threads ask
//   Channel[T]     values sent by many threads, taken by one     (CHANNELS)
//
// ATOMIC VALUES.
//
//   mod hits;
//   import sync use *;
//
//   struct Stats {
//     pub name u32;
//     pub hits Atomic[u64];        // atomic because of its type
//   }
//
//   fn count(stats &Stats) {
//     stats.hits.add(1u64);        // one indivisible add
//     imm n = stats.hits.load();   // the number itself
//   }
//
// An Atomic is changed only by its own operations, and those work through any
// reference to it, even an 'imm' one: 'imm' means that nothing changes except
// inside the atomic values it holds [Jon 26 Sep]. So a value holding one --
// in a field, an array, a tuple or an enum's variant, however deep -- is never
// placed in read-only memory, even as an 'imm' global, and may not be a
// 'const'. The compiler knows this through the marker Atomic declares,
// 'AtomicValue'; it knows nothing else of this package.
//
// T is an integer type of 8 to 64 bits ('usize' and 'isize' among them), a
// Bool, or a raw pointer, '*T': what the type's 'where' clause says, and just
// what the AtomicValue marker admits. Any other T is refused where the Atomic
// is named. Which operations an Atomic has depends on its T, each method's
// own 'where' clause saying when it exists:
//
//   Atomic[T].of(v)          a new atomic value holding v
//   a.load()                 the value
//   a.store(v)               put v there
//   a.swap(v)                put v there, answering the value before
//   a.compareSwap(e, d)      put d there if the value is e, answering the
//                            value seen and whether d was stored
//   a.inner()                the value, taken out of an Atomic the caller
//                            holds by value: nobody else can be reaching it
//                            -- these for every T; and
//   a.bitAnd(v), a.bitOr(v), a.bitXor(v)
//                            the bitwise operation with v, answering the
//                            value before ('and' and 'or' are keywords):
//                            for an integer or a Bool, as flags
//   a.add(v), a.sub(v)       add or subtract v, answering the value before;
//                            both wrap: for an integer only
//
// So 'Atomic[Bool]' is a flag, set with store or bitOr and tested with load,
// and 'Atomic[*Node]' is the head of a lock-free list, moved on with
// compareSwap. 'flag.add(true)' is refused where it is written, saying that
// add exists only where T is Integer.
//
// Each operation above is sequentially consistent (MemOrder.SeqCst), the
// strongest ordering: every thread sees all such operations in one order,
// and nothing before or after one moves across it. That is right for nearly
// every use. An expert who needs a weaker ordering names it with the same
// operation's 'Ordered' form, which takes a MemOrder after the other
// arguments: a.loadOrdered(MemOrder.Acquire[]), a.addOrdered(1u64,
// MemOrder.Relaxed[]), a.compareSwapOrdered(e, d, success, failure). An
// ordering the operation cannot have -- a load's Release or AcqRel, a store's
// Acquire or AcqRel, a compareSwap failure ordering of Release, AcqRel or one
// stronger than its success ordering -- ends the program with a message on
// stderr, through the C library's 'abort', since the ordering is only known
// as the program runs (core's mem operations refuse it where it is written,
// which these forms cannot, taking it as a parameter). Each form chooses its
// instruction by a 'match' on the ordering as it runs. Inlining a call whose
// ordering is a constant can fold that branch away, and the optimizer conec
// runs today does so only sometimes, so where one branch less matters, core's
// mem.atomicAdd and the rest take the ordering at the call and are always the
// one instruction.
//
// THE HOLES, until the compiler's rules around atomics are built:
// - The operations take their receiver as '&opaq', which any reference
//   becomes, so nothing yet refuses a plain read or write of an atomic's
//   whole value where another thread may reach it: '*r = s' through a
//   '&mut Stats' replaces 'hits' plainly. The 'atomic' permission, and
//   plain writes only through a unique path, are the rules to come.
// - Nothing checks yet that what is handed to another thread is safe to
//   share (the thread package says so too).
//
// How it is laid out. An Atomic[T] is its T, nothing more: the same size and
// alignment. Each operation reaches the value through a raw pointer to it and
// calls core's mem intrinsic for the operation, one atomic instruction.
//
// THE FUTEX. The foundation every lock here is built on, and what the thread
// package's parking is built on: a 32-bit atomic word that threads sleep on
// while it holds a value, and are woken from.
//
// - 'sync.futexWait(&word, expected, timeoutNs)': if the word still holds
//   'expected' -- checked by the OS atomically with going to sleep, so a
//   change and wake made between the caller's own check and this call is not
//   missed -- sleep until woken or until the timeout. It returns false only
//   when the timeout passed; true when it was woken, when the word already
//   differed, or spuriously, which the OS permits. So a caller loops:
//
//     while word.load() == 0u32 {
//       sync.futexWait(&word, 0u32);
//     }
//
// - 'timeoutNs' is nanoseconds, 'sync.forever' by default. It is rounded up
//   to whole milliseconds, and its resolution is the system's timer tick, up
//   to 15.6 ms: a 30 ms timeout may take 45. A timeout of 2^32 - 1 ms (49.7
//   days) or more is that long, not forever. 0 checks the word and returns
//   false at once if it still holds 'expected'.
// - 'sync.futexWake(&word)' wakes one thread waiting on the word, and
//   'futexWakeAll(&word)' every one. A wake is not remembered: with no thread
//   waiting it does nothing, so store the new value first, then wake.
// - The word is an Atomic[u32], taken by any reference, as its own operations
//   are. Nothing checks that it stays alive while any thread may wait on it or
//   wake it: the caller keeps that true. It is 32 bits because Linux's futex
//   is. Waiting and waking reach only the threads of this process.
//
// THE LOCKS: Mutex, RwLock, Condvar and Once. Each is built on the futex
// alone, not on the OS's own locks, as Rust's standard library has built its
// own since 2022: each is one Atomic[u32] (RwLock, two), holds no OS handle,
// needs no finalizer, and may be moved while nobody holds or waits on it.
// Their state machines are Rust's, cited at each below. Each is made unlocked
// by 'make()', and every operation takes it by any reference, even 'imm', as
// Atomic's do: a lock is shared by all the threads that use it.
//
//   imm lock Mutex;             // both set by the module's init:
//   mut names List[u64];        //   Mutex.make(), List[u64].empty()
//
//   fn add(n u64) {             // called from any number of threads
//     lock.lock();
//     names.push(n);            // touched only while 'lock' is held
//     lock.unlock();
//   }
//
// THESE LOCKS ARE UNCHECKED. A lock here is a plain lock, with explicit
// 'lock()' and 'unlock()', guarding nothing the compiler can see: WHAT IT
// PROTECTS IS THE PROGRAM'S TO KEEP. Nothing stops a thread reaching the
// data without taking the lock, or keeping a reference to it past the unlock,
// or forgetting to unlock, or unlocking a lock another thread holds. The
// compiler's lock permissions -- a lock in the permission slot, '+arc-mutex
// T', where borrowing through it takes the lock and the borrow's end releases
// it (the reference manual's lock-permission page) -- are to come, and will
// sit on these types. Until then:
//
// - Every 'lock' is paired with one 'unlock' on the same thread, and the data
//   is reached only between them.
// - A lock is not reentrant: a thread that locks a Mutex it already holds
//   sleeps forever.
// - Unlocking a lock that is not locked is detected where it is cheap to --
//   the unlock sees that nothing held it -- and ends the program with a
//   message on stderr. Unlocking one another thread holds is not detected.
// - A thread that ends while holding a lock leaves it locked forever: there is
//   no poisoning, since Cone has no panics that unwind; a trap ends the whole
//   process.
// - Moving or dropping a lock while any thread holds it or waits on it is the
//   program's error, and is not detected.
//
// Mutex: one thread at a time.
//
//   Mutex.make()        an unlocked Mutex
//   m.lock()            take it, sleeping while another thread holds it
//   m.unlock()          give it up, waking a thread waiting for it
//   m.tryLock()         take it if nobody holds it: whether it was taken
//
// RwLock: any number of readers at once, or one writer alone. A reader and a
// writer are only what the program calls them: a read lock is shared, and
// the program keeps to reading while it holds one. A waiting writer is
// preferred: while one waits, new readers wait too, so a stream of readers
// cannot starve it. At most 2^30 - 2 readers may hold it at once; one more
// ends the program.
//
//   RwLock.make()       an unlocked RwLock
//   l.readLock()  l.readUnlock()  l.tryReadLock()
//   l.writeLock()  l.writeUnlock()  l.tryWriteLock()
//
// Condvar: a thread sleeps, holding no lock, until another says that what it
// waits for may have changed. It is always used with a Mutex that guards what
// is waited for, and a waiter always loops, rechecking under the lock, since
// a wait may return spuriously and another thread may get there first:
//
//     m.lock();
//     while buffer.isEmpty() {
//       ready.condWait(&m);   // unlocks m, sleeps, locks m again
//     }
//     ... take from the buffer ...
//     m.unlock();
//
//   Condvar.make()               a Condvar
//   c.condWait(&m)               unlock m, sleep until notified, lock m
//                                again. m must be locked by this thread.
//   c.condWaitTimeout(&m, ns)    the same, sleeping at most ns nanoseconds
//                                (as futexWait rounds them): false only if
//                                the timeout passed
//   c.notifyOne()                wake one waiting thread
//   c.notifyAll()                wake every waiting thread
//
// ('wait' is a reserved word, so the wait is 'condWait', as the futex's is
// 'futexWait'.)
//
// A notification with nobody waiting is not remembered, which is why a waiter
// checks what it waits for before it waits. Notifying with the Mutex held or
// not are both correct.
//
// Once: a function run exactly once, however many threads ask at once. The
// first caller runs it; every other caller sleeps until it has returned, and
// then sees all it did. A closure cannot capture yet, so what is run is a
// plain function, given nothing or one value:
//
//   Once.make()               a Once whose function has not run
//   o.callOnce(&f)            run f() if no call on this Once has run one
//   o.callOnceWith(arg, &f)   run f(arg) likewise. 'arg' is moved in, and
//                             dropped unused when another call ran first.
//   o.isCompleted()           whether a call has run its function to the end
//
// A function run by a Once that calls the same Once sleeps forever.
//
// Hand-rolled with Atomic[u32] and the futex, a lock takes its orderings from
// core's mem operations directly (acquire on lock, release on unlock, as
// Rust's), since each must be one instruction and Atomic's 'Ordered' forms
// choose theirs as the program runs.
//
// CHANNELS. A channel is a pipe between threads with two ends: whoever holds
// a sending end puts values in, and whoever holds the receiving end takes
// them out, oldest first. A Channel[T] has any number of senders and one
// receiver (MPSC), and comes in two kinds, whose ends are the same types:
// unbounded, whose sends never wait, and bounded, holding at most so many
// values, whose sends wait while it is full -- backpressure: a sender
// faster than its receiver is held to its pace, and the memory the channel
// uses has a ceiling. The receiver waits only while the channel is empty.
//
//   mut tx Sender[u64];
//   mut rx Receiver[u64];
//   tx, rx = Channel[u64].make();      // the two ends; or .bounded(1024)
//   imm tx2 = tx.clone();              // a second sender, said out loud
//   thread.start(tx2, &producer);      // an end moves to another thread
//   tx <- 7u64;                        // send; or tx.send(7u64)
//   mut more = true;
//   while more {
//     match rx.recv() {                // waits; None once closed and empty
//       case imm v Some {total = total + v.value;}
//       case is None[u64] {more = false;}
//     }
//   }
//
//   Channel[T].make()        a new unbounded channel: its Sender[T] and its
//                            Receiver[T], a tuple assigned to two variables
//                            declared first (a declaration cannot yet take a
//                            tuple apart)
//   Channel[T].bounded(n)    a new bounded channel, holding at most n values:
//                            n rounded up to a power of two, and 0 taken as 1
//   tx.send(v)               put v in, waiting while a bounded channel is
//                            full. None once it is in, or Some[v], the value
//                            handed back, when the receiver has gone or
//                            closed the channel -- which wakes a send
//                            waiting for room, to hand its value back too
//   tx <- v                  the same: '<-', Cone's append, is send. It
//                            borrows tx as 'mut', as '+=' does, so tx is a
//                            'mut' variable or a reference to a Sender;
//                            'tx <- (a, b)' sends each in turn
//   tx.trySend(v)            send, but never waiting: Some[v] back when a
//                            bounded channel is full, too
//   tx.sendTimeout(v, ns)    send, waiting at most ns nanoseconds for room
//                            (the futex's resolution: it may run over by a
//                            tick): Some[v] back when none came
//   tx.clone()               another Sender on the same channel
//   rx.recv()                the next value, waiting while there is none;
//                            None once the channel is closed and every value
//                            sent has been taken
//   rx.tryRecv()             the next value if one is there; never waits
//   rx.recvTimeout(ns)       recv, waiting at most ns nanoseconds (the
//                            futex's resolution: it may run over by a tick)
//   rx.close()               refuse every later send, handing its value
//                            back; what was sent before still comes out
//   rx.isClosed()            whether it is closed: nothing more will arrive
//
// - The ends are move types. A Sender's 'clone' is the only way to another
//   (a clone method does not make a type copyable); a Receiver has no clone,
//   so there is exactly one, and one thread takes from it: the methods that
//   take values, and close, take it as '&mut'.
// - The channel ends with its ends, and nothing panics. The last Sender's
//   death closes it: the receiver takes what is left, then recv answers
//   None. The Receiver's death closes it too: each send waiting for room
//   wakes, each send then and later gets its value back, and each value
//   still in the channel is finalized there, once. The memory goes when both
//   sides have.
// - A bounded channel's send waits for as long as the channel stays full:
//   a receiver that stops taking without going leaves its senders waiting
//   for good. Where that may happen -- two threads each sending to the
//   other, say -- send with trySend or sendTimeout, or unbounded.
// - The two kinds share their ends' types, so what takes a Sender[T] or a
//   Receiver[T] takes either: the kind is the constructor's choice alone. An
//   unbounded channel is never full, so its trySend and sendTimeout are its
//   send.
// - A value moves in and moves out: a number, a struct, a '+so' or 'uni'
//   owner. A large value is best sent as an owner, since a slot holds the
//   whole T, and a bounded channel has its n slots from the start. A value
//   never taken is finalized exactly once.
// - T must be Sendable, as the thread package's 'start' asks of what it is
//   handed: a channel of a borrow, a 'mut' owner or an '+rc-imm' owner is
//   refused where it is named. The ends declare Sendable, so they cross.
// - Not here yet: a single-sender channel, whose sender has no clone; a
//   channel of no capacity, whose send waits for the receiver to take its
//   value (Go's unbuffered, Rust's sync_channel(0)); taking every value
//   waiting at once ('drain'); and 'each v in rx', which needs the
//   iteration protocol. 'select' over several channels is left out for now.
//
// How it is built is at the channel's own section, below. Unbounded: linked
// blocks of 32 slots. Bounded: a ring of n cells. Both: one compare-and-swap
// for a send, no read-modify-write for the receiver, and the futex only when
// the receiver sleeps, or, bounded, a sender waits for room.

mod sync;

import libc;

pub struct Atomic[T] is AtomicValue, Move where T is Integer or T is Bool or T is Pointer {
  value T;

  // A new atomic value holding v
  pub fn of(v T) Atomic[T] {Atomic[T][v];}

  // The value, taken out of an Atomic held by value, which nobody else can be
  // reaching: an ordinary read
  pub fn inner(self) T {value;}

  pub fn load(self &opaq) T {
    mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);
  }
  pub fn store(self &opaq, v T) {
    mem.atomicStore[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn swap(self &opaq, v T) T {
    mem.atomicSwap[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn add(self &opaq, v T) T where T is Integer {
    mem.atomicAdd[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn sub(self &opaq, v T) T where T is Integer {
    mem.atomicSub[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitAnd(self &opaq, v T) T where T is Integer or T is Bool {
    mem.atomicAnd[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitOr(self &opaq, v T) T where T is Integer or T is Bool {
    mem.atomicOr[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitXor(self &opaq, v T) T where T is Integer or T is Bool {
    mem.atomicXor[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn compareSwap(self &opaq, expected T, desired T) T, Bool {
    mem.atomicCompareSwap[T](self as *T, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
  }

  // The same operations with the ordering named. Each arm passes its ordering
  // as a constant, as core's operations require.
  pub fn loadOrdered(self &opaq, order MemOrder) T {
    match order {
      case is MemOrder.Relaxed {mem.atomicLoad[T](self as *T, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicLoad[T](self as *T, MemOrder.Acquire[]);}
      case is MemOrder.SeqCst {mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);}
      else {
        die("sync: loadOrdered given Release or AcqRel, which a load cannot have\n");
        mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);
      }
    }
  }
  pub fn storeOrdered(self &opaq, v T, order MemOrder) {
    match order {
      case is MemOrder.Relaxed {mem.atomicStore[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Release {mem.atomicStore[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.SeqCst {mem.atomicStore[T](self as *T, v, MemOrder.SeqCst[]);}
      else {die("sync: storeOrdered given Acquire or AcqRel, which a store cannot have\n");}
    }
  }
  pub fn swapOrdered(self &opaq, v T, order MemOrder) T {
    match order {
      case is MemOrder.Relaxed {mem.atomicSwap[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicSwap[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicSwap[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicSwap[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicSwap[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn addOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicAdd[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicAdd[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicAdd[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicAdd[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicAdd[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn subOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicSub[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicSub[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicSub[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicSub[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicSub[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitAndOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is Bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicAnd[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicAnd[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicAnd[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicAnd[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicAnd[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitOrOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is Bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicOr[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicOr[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicOr[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicOr[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicOr[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitXorOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is Bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicXor[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicXor[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicXor[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicXor[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicXor[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }

  // 'failure' is the ordering when d is not stored, which is a load: it may
  // be Relaxed, Acquire or SeqCst, and no stronger than 'success'
  pub fn compareSwapOrdered(self &opaq, expected T, desired T,
      success MemOrder, failure MemOrder) T, Bool {
    imm p = self as *T;
    match failure {
      case is MemOrder.Relaxed {
        match success {
          case is MemOrder.Relaxed {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Relaxed[], MemOrder.Relaxed[]);}
          case is MemOrder.Acquire {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Acquire[], MemOrder.Relaxed[]);}
          case is MemOrder.Release {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Release[], MemOrder.Relaxed[]);}
          case is MemOrder.AcqRel {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.AcqRel[], MemOrder.Relaxed[]);}
          else {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.Relaxed[]);}
        }
      }
      case is MemOrder.Acquire {
        match success {
          case is MemOrder.Acquire {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Acquire[], MemOrder.Acquire[]);}
          case is MemOrder.AcqRel {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.AcqRel[], MemOrder.Acquire[]);}
          case is MemOrder.SeqCst {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.Acquire[]);}
          else {
            die("sync: compareSwapOrdered given an Acquire failure ordering with a success ordering weaker than it\n");
            mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
          }
        }
      }
      case is MemOrder.SeqCst {
        match success {
          case is MemOrder.SeqCst {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);}
          else {
            die("sync: compareSwapOrdered given a SeqCst failure ordering with a success ordering weaker than it\n");
            mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
          }
        }
      }
      else {
        die("sync: compareSwapOrdered given a Release or AcqRel failure ordering, which a compareSwap that stores nothing cannot have\n");
        mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
      }
    }
  }
}

// An ordering the operation cannot have, a lock misused, a channel's memory
// exhausted: a panic, reported at the line calling 'die'. Each message ends in
// a line end, which the panic's own line leaves off
fn die(msg &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) Never {
  panic(&msg[0usize .. msg.len - 1usize], file, line);
}

// SHARED OWNERS: 'arc', the region whose owners several threads may hold.
//
//   import sync use arc;              // or 'use *'
//
//   imm m = +arc-imm Message["read by two threads"];
//   imm a = thread.start(m, &reader); // start copies m: one owner more
//
// 'arc' is core's 'rc' whose count several threads may change at once: each
// change is one atomic instruction, so owners of one value may be copied and
// dropped on different threads and the value still dies exactly once, after
// the last. It is spelled as 'rc' is -- '+arc-imm T[...]', '+arc T[...]',
// '+arc-mut T[...]' -- once the name 'arc' is folded into the module: a
// region is named bare in an allocation or a reference type, so a plain
// 'import sync' does not reach it ('+sync.arc' is not a spelling). It lives
// here rather than beside 'rc' in core, whose names are in every module, as
// Rust keeps its Arc in 'sync' and out of the prelude [Jon 27 Sep]: a module
// that does not fold it in keeps 'arc' for its own use, and one that folds
// everything else in writes 'import sync use * but arc'.
//
// It declares the built-in marker 'ThreadSafe', which 'rc' does not: its
// owners may be held by several threads at once. What threads may share
// through it is an 'imm' or 'opaq' owner; a 'mut' or 'ro' one would let two
// threads reach the value itself unsynchronized. Nothing checks either yet.
//
// The orderings are the standard ones for an atomic count (Rust's Arc,
// Boost's intrusive_ptr):
// - 'init' needs none: the count is set before any other thread can see it,
//   and whatever hands an owner to another thread (a thread's start, a
//   channel) orders that for itself.
// - 'alias' adds Relaxed: a copy is made from an owner the thread already
//   holds, so the count is at least one and cannot reach zero meanwhile, and
//   nothing is read or written on the strength of the new count.
// - 'dealias' subtracts Release: everything this owner did with the value
//   (its reads, and any change inside an atomic value it holds) happens
//   before the count goes down, so none of it can be moved after a decrement
//   another thread may follow with the value's death.
// - The owner that takes the count to zero then loads it with Acquire before
//   answering true, and so before the value is finalized and freed: the load
//   reads the end of the chain of every other owner's Release decrement, so
//   all they did happens before the death. It stands in for an Acquire fence,
//   which core has no intrinsic for, as Rust's Arc does under the thread
//   sanitizer; only the last owner pays for it.
//
// Its methods call core's mem intrinsics directly rather than Atomic[T]'s: the
// count is the allocation's header, which a region method reaches only as
// the region itself.
pub struct arc is RegionRef, ThreadSafe {
  cnt usize;
  fn alloc(size usize) *u8 inline {libc.malloc(size);}
  fn init() arc inline {arc[1usize];}
  fn alias(self &uni arc) inline {
    mem.atomicAdd[usize](self as *usize, 1usize, MemOrder.Relaxed[]);
  }
  fn dealias(self &uni arc) Bool inline {
    imm last = mem.atomicSub[usize](self as *usize, 1usize, MemOrder.Release[]) == 1usize;
    if last {mem.atomicLoad[usize](self as *usize, MemOrder.Acquire[]);}
    last;
  }
  fn free(self &uni arc) inline {libc.free(self as *u8);}
}

// ---------------------------------------------------------------------------
// Windows: WaitOnAddress and its two wakes, the api set
// api-ms-win-core-synch-l1-2-0, linked through Synchronization.lib, which
// this package's congo.toml names; and, for the channels, kernel32's yield
// and its high resolution clock, on every link line already. They are the
// package's only calls to the OS; a posix side (Linux's futex, sched_yield,
// clock_gettime) is to come beside them.
// ---------------------------------------------------------------------------

extern {
  fn @c(system) WaitOnAddress(address *u32, compare *u32, size usize, ms u32) i32;
  fn @c(system) WakeByAddressSingle(address *u32);
  fn @c(system) WakeByAddressAll(address *u32);
  fn @c(system) GetLastError() u32;
  fn @c(system) SwitchToThread() i32;
  fn @c(system) QueryPerformanceCounter(count *i64) i32;
  fn @c(system) QueryPerformanceFrequency(freq *i64) i32;
}

const infinite = 0xFFFFFFFFu32;                // INFINITE
const errorTimeout = 1460u32;                  // ERROR_TIMEOUT

// ---------------------------------------------------------------------------
// The futex
// ---------------------------------------------------------------------------

// A timeout that never passes
pub const forever = 0xFFFFFFFFFFFFFFFFu64;

// Nanoseconds as whole milliseconds, rounded up, and short of INFINITE
fn msCeil(ns u64) u32 {
  imm ms = ns / 1000000u64 + (if ns % 1000000u64 != 0u64 {1u64;} else {0u64;});
  if ms >= u64[infinite] {infinite - 1u32;} else {u32[ms];};
}

// Sleep while the word holds expected, until woken or timeoutNs passes:
// false only if the timeout passed
pub fn futexWait(word &opaq Atomic[u32], expected u32, timeoutNs u64 = forever) Bool {
  rawWait(word as *u32, expected, timeoutNs);
}

// Wake one thread waiting on the word
pub fn futexWake(word &opaq Atomic[u32]) {
  WakeByAddressSingle(word as *u32);
}

// Wake every thread waiting on the word
pub fn futexWakeAll(word &opaq Atomic[u32]) {
  WakeByAddressAll(word as *u32);
}

// The same three on the word's address, as the locks reach their own words
fn rawWait(word *u32, expected u32, timeoutNs u64) Bool {
  imm ms = if timeoutNs == forever {infinite;} else {msCeil(timeoutNs);};
  mut compare = expected;
  if WaitOnAddress(word, &mut compare as *u32, 4usize, ms) != 0i32 {
    return true;
  }
  GetLastError() != errorTimeout;
}

fn rawWake(word *u32) {
  WakeByAddressSingle(word);
}

fn rawWakeAll(word *u32) {
  WakeByAddressAll(word);
}

// ---------------------------------------------------------------------------
// The locks' shared pieces
// ---------------------------------------------------------------------------

// How many times a lock rereads its word before it sleeps, when it finds the
// lock held: Rust's 100 ("chosen by fair dice roll"). A lock held only
// briefly is often free again within that, and a sleep and a wake cost far
// more than the reads. Rust's spin also tells the processor it is spinning
// (x86's 'pause'); Cone has no way to say that yet, so these spins are plain
// relaxed loads.
const spinLimit = 100u32;

// Put desired in *p if it holds expected, acquiring when it does: whether it
// did, and the value seen
fn casAcquire(p *u32, expected u32, desired u32) u32, Bool {
  mem.atomicCompareSwap[u32](p, expected, desired, MemOrder.Acquire[], MemOrder.Relaxed[]);
}

fn casRelaxed(p *u32, expected u32, desired u32) u32, Bool {
  mem.atomicCompareSwap[u32](p, expected, desired, MemOrder.Relaxed[], MemOrder.Relaxed[]);
}

fn loadRelaxed(p *u32) u32 {
  mem.atomicLoad[u32](p, MemOrder.Relaxed[]);
}

// ---------------------------------------------------------------------------
// Mutex: Rust's futex mutex (library/std/src/sys/sync/mutex/futex.rs).
// ---------------------------------------------------------------------------

// Its states. 'contended' means locked, and that some thread may be asleep
// waiting for it, so the unlock must wake one.
const mutexUnlocked = 0u32;
const mutexLocked = 1u32;
const mutexContended = 2u32;

// One thread at a time: a plain, unchecked lock (see the package's header)
pub struct Mutex is Move {
  state Atomic[u32];

  // An unlocked Mutex
  pub fn make() Mutex {Mutex[Atomic[u32].of(mutexUnlocked)];}

  // The state word, as core's mem operations reach it
  fn word(self &opaq) *u32 {&(*(self as *Mutex)).state as *u32;}

  // Take the lock if nobody holds it: whether it was taken
  pub fn tryLock(self &opaq) Bool {
    mut seen = 0u32;
    mut taken = false;
    seen, taken = casAcquire(self.word(), mutexUnlocked, mutexLocked);
    taken;
  }

  // Take the lock, sleeping while another thread holds it
  pub fn lock(self &opaq) {
    if !self.tryLock() {
      self.lockContended();
    }
  }

  fn lockContended(self &opaq) {
    imm p = self.word();
    // Spin first, in case the lock is released quickly
    mut state = self.spin();
    mut taken = false;
    // Unlocked now: take it without marking it contended
    if state == mutexUnlocked {
      state, taken = casAcquire(p, mutexUnlocked, mutexLocked);
      if taken {
        return;
      }
    }
    while true {
      // Mark it contended. Swapping from unlocked took it: this thread was
      // not the only one wanting it, so it stays marked, and its unlock
      // wakes the next. (No write when it is contended already.)
      if state != mutexContended {
        if mem.atomicSwap[u32](p, mutexContended, MemOrder.Acquire[]) == mutexUnlocked {
          return;
        }
      }
      // Sleep while it is still contended
      rawWait(p, mutexContended, forever);
      state = self.spin();
    }
  }

  // Reread the word while another thread holds the lock uncontended, up to
  // the spin limit: the state it stopped at
  fn spin(self &opaq) u32 {
    imm p = self.word();
    mut n = spinLimit;
    while true {
      imm state = loadRelaxed(p);
      if state != mutexLocked or n == 0u32 {
        return state;
      }
      n = n - 1u32;
    }
    mutexLocked;
  }

  // Give up the lock, waking one waiting thread if any may be asleep. The one
  // woken marks it contended again when it takes it, so every other sleeper
  // is woken in its turn.
  pub fn unlock(self &opaq) {
    imm p = self.word();
    imm was = mem.atomicSwap[u32](p, mutexUnlocked, MemOrder.Release[]);
    if was == mutexContended {
      rawWake(p);
    } elif was == mutexUnlocked {
      die("sync: Mutex.unlock of a Mutex that is not locked\n");
    }
  }
}

// ---------------------------------------------------------------------------
// RwLock: Rust's futex read-write lock (library/std/src/sys/sync/rwlock/
// futex.rs), without its 'downgrade', which this has not taken.
// ---------------------------------------------------------------------------

// The state word: a count of readers in its low 30 bits, where all ones is
// write-locked; bit 30, readers may be asleep on the state word; bit 31,
// writers may be asleep on the 'writerNotify' word.
const rwReadLocked = 1u32;
const rwMask = 0x3FFFFFFFu32;
const rwWriteLocked = 0x3FFFFFFFu32;
const rwMaxReaders = 0x3FFFFFFEu32;
const rwReadersWaiting = 0x40000000u32;
const rwWritersWaiting = 0x80000000u32;

fn rwIsUnlocked(s u32) Bool {(s & rwMask) == 0u32;}
fn rwIsWriteLocked(s u32) Bool {(s & rwMask) == rwWriteLocked;}
fn rwHasReadersWaiting(s u32) Bool {(s & rwReadersWaiting) != 0u32;}
fn rwHasWritersWaiting(s u32) Bool {(s & rwWritersWaiting) != 0u32;}

// A reader may take it: not write-locked, room for another reader, and
// nobody waiting (a waiting writer is preferred, and waiting readers mean
// the unlocking thread is still deciding whom to wake)
fn rwIsReadLockable(s u32) Bool {
  (s & rwMask) < rwMaxReaders and !rwHasReadersWaiting(s) and !rwHasWritersWaiting(s);
}

// Many readers at once, or one writer alone: a plain, unchecked lock (see the
// package's header). Two words: the state, which readers sleep on, and a
// counter bumped for each wake of a writer, which writers sleep on.
pub struct RwLock is Move {
  state Atomic[u32];
  writerNotify Atomic[u32];

  // An unlocked RwLock
  pub fn make() RwLock {RwLock[Atomic[u32].of(0u32), Atomic[u32].of(0u32)];}

  fn word(self &opaq) *u32 {&(*(self as *RwLock)).state as *u32;}
  fn notifyWord(self &opaq) *u32 {&(*(self as *RwLock)).writerNotify as *u32;}

  // Take a read lock if a reader may now: whether it was taken
  pub fn tryReadLock(self &opaq) Bool {
    imm p = self.word();
    mut s = loadRelaxed(p);
    mut taken = false;
    while rwIsReadLockable(s) {
      s, taken = casAcquire(p, s, s + rwReadLocked);
      if taken {
        return true;
      }
    }
    false;
  }

  // Take a read lock, sleeping while a writer holds it or waits for it
  pub fn readLock(self &opaq) {
    imm p = self.word();
    imm s = loadRelaxed(p);
    mut seen = 0u32;
    mut taken = false;
    if rwIsReadLockable(s) {
      seen, taken = casAcquire(p, s, s + rwReadLocked);
    }
    if !taken {
      self.readContended();
    }
  }

  fn readContended(self &opaq) {
    imm p = self.word();
    mut s = self.spinRead();
    mut done = false;
    while true {
      if rwIsReadLockable(s) {
        s, done = casAcquire(p, s, s + rwReadLocked);
        if done {
          return;
        }
        continue;
      }
      if (s & rwMask) == rwMaxReaders {
        die("sync: RwLock.readLock with too many readers holding it\n");
      }
      // Say that a reader sleeps before sleeping
      if !rwHasReadersWaiting(s) {
        s, done = casRelaxed(p, s, s | rwReadersWaiting);
        if !done {
          continue;
        }
      }
      rawWait(p, s | rwReadersWaiting, forever);
      s = self.spinRead();
    }
  }

  // Give up a read lock; the last reader out wakes a waiting writer
  pub fn readUnlock(self &opaq) {
    imm was = mem.atomicSub[u32](self.word(), rwReadLocked, MemOrder.Release[]);
    if rwIsUnlocked(was) or rwIsWriteLocked(was) {
      die("sync: RwLock.readUnlock of a RwLock no reader holds\n");
    }
    imm s = was - rwReadLocked;
    if rwIsUnlocked(s) and rwHasWritersWaiting(s) {
      self.wakeWriterOrReaders(s);
    }
  }

  // Take the write lock if nobody holds the lock: whether it was taken
  pub fn tryWriteLock(self &opaq) Bool {
    imm p = self.word();
    mut s = loadRelaxed(p);
    mut taken = false;
    while rwIsUnlocked(s) {
      s, taken = casAcquire(p, s, s + rwWriteLocked);
      if taken {
        return true;
      }
    }
    false;
  }

  // Take the write lock, sleeping while any reader or writer holds it
  pub fn writeLock(self &opaq) {
    mut seen = 0u32;
    mut taken = false;
    seen, taken = casAcquire(self.word(), 0u32, rwWriteLocked);
    if !taken {
      self.writeContended();
    }
  }

  fn writeContended(self &opaq) {
    imm p = self.word();
    mut s = self.spinWrite();
    mut otherWritersWaiting = 0u32;
    mut done = false;
    while true {
      if rwIsUnlocked(s) {
        s, done = casAcquire(p, s, s | rwWriteLocked | otherWritersWaiting);
        if done {
          return;
        }
        continue;
      }
      // Say that a writer sleeps before sleeping
      if !rwHasWritersWaiting(s) {
        s, done = casRelaxed(p, s, s | rwWritersWaiting);
        if !done {
          continue;
        }
      }
      // Other writers may be waiting too now, so keep the bit set when this
      // one takes the lock
      otherWritersWaiting = rwWritersWaiting;
      // Read the wake counter before rechecking the state, so a wake between
      // the two is not missed
      imm seq = mem.atomicLoad[u32](self.notifyWord(), MemOrder.Acquire[]);
      s = loadRelaxed(p);
      if rwIsUnlocked(s) or !rwHasWritersWaiting(s) {
        continue;
      }
      rawWait(self.notifyWord(), seq, forever);
      s = self.spinWrite();
    }
  }

  // Give up the write lock, waking a writer, or the readers, if any wait
  pub fn writeUnlock(self &opaq) {
    imm was = mem.atomicSub[u32](self.word(), rwWriteLocked, MemOrder.Release[]);
    if !rwIsWriteLocked(was) {
      die("sync: RwLock.writeUnlock of a RwLock no writer holds\n");
    }
    imm s = was - rwWriteLocked;
    if rwHasWritersWaiting(s) or rwHasReadersWaiting(s) {
      self.wakeWriterOrReaders(s);
    }
  }

  // After an unlock left it unlocked with someone waiting: wake one writer if
  // only writers wait; if readers wait too, wake one writer and then the
  // readers as well (Windows' wake does not say whether it woke anyone, so
  // this cannot tell that it reached a writer; a reader woken while the
  // writer holds the lock sleeps again); if only readers wait, wake them all.
  // If the lock is taken meanwhile, whoever took it wakes the rest at its
  // unlock.
  fn wakeWriterOrReaders(self &opaq, state u32) {
    imm p = self.word();
    mut s = state;
    mut done = false;
    if s == rwWritersWaiting {
      s, done = casRelaxed(p, s, 0u32);
      if done {
        self.wakeWriter();
        return;
      }
    }
    if s == rwReadersWaiting | rwWritersWaiting {
      s, done = casRelaxed(p, s, rwReadersWaiting);
      if !done {
        return;
      }
      self.wakeWriter();
      s = rwReadersWaiting;
    }
    if s == rwReadersWaiting {
      s, done = casRelaxed(p, s, 0u32);
      if done {
        rawWakeAll(p);
      }
    }
  }

  fn wakeWriter(self &opaq) {
    imm n = self.notifyWord();
    mem.atomicAdd[u32](n, 1u32, MemOrder.Release[]);
    rawWake(n);
  }

  // Spin while write-locked with nobody waiting
  fn spinRead(self &opaq) u32 {
    imm p = self.word();
    mut n = spinLimit;
    while true {
      imm s = loadRelaxed(p);
      if !rwIsWriteLocked(s) or rwHasReadersWaiting(s) or rwHasWritersWaiting(s) or n == 0u32 {
        return s;
      }
      n = n - 1u32;
    }
    0u32;
  }

  // Spin while locked with no writer waiting: a waiting writer stops the
  // spin, to keep writers somewhat in order
  fn spinWrite(self &opaq) u32 {
    imm p = self.word();
    mut n = spinLimit;
    while true {
      imm s = loadRelaxed(p);
      if rwIsUnlocked(s) or rwHasWritersWaiting(s) or n == 0u32 {
        return s;
      }
      n = n - 1u32;
    }
    0u32;
  }
}

// ---------------------------------------------------------------------------
// Condvar: Rust's futex condition variable (library/std/src/sys/sync/
// condvar/futex.rs). The word counts notifications; a waiter reads it before
// unlocking the Mutex and sleeps only while it is unchanged, so a
// notification between the unlock and the sleep is not lost. Every ordering
// is relaxed: the Mutex's lock and unlock order what it guards. (A waiter
// that sleeps through exactly 2^32 notifications, and sees the count back
// where it was, sleeps on; Rust accepts the same.)
// ---------------------------------------------------------------------------

pub struct Condvar is Move {
  seq Atomic[u32];

  pub fn make() Condvar {Condvar[Atomic[u32].of(0u32)];}

  fn word(self &opaq) *u32 {&(*(self as *Condvar)).seq as *u32;}

  // Wake one thread waiting
  pub fn notifyOne(self &opaq) {
    imm p = self.word();
    mem.atomicAdd[u32](p, 1u32, MemOrder.Relaxed[]);
    rawWake(p);
  }

  // Wake every thread waiting
  pub fn notifyAll(self &opaq) {
    imm p = self.word();
    mem.atomicAdd[u32](p, 1u32, MemOrder.Relaxed[]);
    rawWakeAll(p);
  }

  // Unlock the Mutex, which this thread holds, sleep until notified, and lock
  // it again. It may return spuriously, so the caller loops.
  pub fn condWait(self &opaq, mutex &opaq Mutex) {
    self.condWaitTimeout(mutex, forever);
  }

  // The same, sleeping at most timeoutNs: false only if the timeout passed.
  // The Mutex is locked again either way.
  pub fn condWaitTimeout(self &opaq, mutex &opaq Mutex, timeoutNs u64) Bool {
    imm p = self.word();
    imm seen = loadRelaxed(p);
    mutex.unlock();
    imm woken = rawWait(p, seen, timeoutNs);
    mutex.lock();
    woken;
  }
}

// ---------------------------------------------------------------------------
// Once: Rust's futex Once (library/std/src/sys/sync/once/futex.rs), without
// its poisoning, since Cone has no panic that unwinds out of the function.
// Rust makes 'complete' the zero state; here 'incomplete' is, so that a Once
// is all zeros when made, as each of the locks is.
// ---------------------------------------------------------------------------

const onceIncomplete = 0u32;
const onceRunning = 1u32;
const onceComplete = 2u32;
const onceStateMask = 3u32;
// Set beside 'running' when some thread may be asleep waiting for it
const onceQueued = 4u32;

pub struct Once is Move {
  state Atomic[u32];

  // A Once whose function has not run
  pub fn make() Once {Once[Atomic[u32].of(onceIncomplete)];}

  fn word(self &opaq) *u32 {&(*(self as *Once)).state as *u32;}

  // Whether a call has run its function to the end; if so, all it did is
  // seen by this thread
  pub fn isCompleted(self &opaq) Bool {
    mem.atomicLoad[u32](self.word(), MemOrder.Acquire[]) == onceComplete;
  }

  // Run f() if no call on this Once has run its function. Every call returns
  // only once the function has run, by whichever thread ran it.
  pub fn callOnce(self &opaq, f &fn()) {
    if self.begin() {
      f();
      self.finish();
    }
  }

  // Run f(arg) likewise; arg is moved in, and dropped when another call ran
  // the function
  pub fn callOnceWith[A](self &opaq, arg A, f &fn(a A)) {
    if self.begin() {
      f(arg);
      self.finish();
    }
  }

  // Whether this caller is to run the function: true once it has marked the
  // Once running; false once the function has completed, waiting while
  // another thread runs it
  fn begin(self &opaq) Bool {
    imm p = self.word();
    mut s = mem.atomicLoad[u32](p, MemOrder.Acquire[]);
    mut done = false;
    while true {
      imm state = s & onceStateMask;
      if state == onceComplete {
        return false;
      }
      if state == onceIncomplete {
        s, done = mem.atomicCompareSwap[u32](p, s, onceRunning | (s & onceQueued),
          MemOrder.Acquire[], MemOrder.Acquire[]);
        if done {
          return true;
        }
        continue;
      }
      // Running on another thread: say that this one sleeps, then sleep
      if (s & onceQueued) == 0u32 {
        imm queued = s | onceQueued;
        // (Rust's success ordering here is Relaxed, with an Acquire failure;
        // core's compareSwap refuses a failure ordering stronger than its
        // success, so both are Acquire)
        s, done = mem.atomicCompareSwap[u32](p, s, queued, MemOrder.Acquire[], MemOrder.Acquire[]);
        if !done {
          continue;
        }
        s = queued;
      }
      rawWait(p, s, forever);
      s = mem.atomicLoad[u32](p, MemOrder.Acquire[]);
    }
    false;
  }

  // The function has returned: complete, and wake whoever waits
  fn finish(self &opaq) {
    imm p = self.word();
    imm was = mem.atomicSwap[u32](p, onceComplete, MemOrder.Release[]);
    if (was & onceQueued) != 0u32 {
      rawWakeAll(p);
    }
  }
}

// ---------------------------------------------------------------------------
// Channel: unbounded, many senders, one receiver (MPSC). The algorithm is
// crossbeam-channel's "list" flavour (crossbeam-channel/src/flavors/list.rs,
// which Rust's std::sync::mpsc has run on since 1.67), cut down to its one
// receiver: values sit in linked blocks of 32 slots, so a block is allocated
// once per 32 sends; a sender claims a slot with one compare-and-swap on the
// senders' index, moves its value in and marks the slot written; the receiver
// reads the slot at its own index, which no other thread touches, with no
// read-modify-write at all. Vyukov's non-intrusive MPSC queue (1024cores) is
// the same shape a value at a time, and the orderings below are its: a value
// is published by a release store its reader acquires.
//
// Positions. The senders' index ('tail') counts positions, shifted left one
// bit so that bit 0 can say the channel is closed (crossbeam's MARK_BIT): a
// send's claim and a close are changes to one word, so that word's own order
// puts every send either before the close, and delivered, or after it, and
// refused. A block's 32 slots are offsets 0 to 31 of a lap of 64 positions.
// Offset 32 means the block is full and the sender that claimed its last slot
// is installing the next block; the other senders wait the moment that takes.
// Offsets 33 to 63 are never used: the installer moves the index on to the
// next lap, where the next block's offset 0 is. The receiver's index ('head')
// counts the same way, never carrying the closed bit. The index wraps after
// 2^62 values (a block spends 64 positions on 32 values): 146 years at a
// thousand million sends a second. Nothing checks.
// ---------------------------------------------------------------------------

const chanShift = 1u64;
const chanClosed = 1u64;
const chanOne = 2u64;                  // one position: 1 << chanShift
const blockCap = 32u64;                // slots in a block
const chanLap = 64u64;                 // positions a block spans
const chanOffsetMask = 63u64;          // chanLap - 1

// Where a position falls in its block, and the position itself without the
// closed bit
fn chanOffset(index u64) u64 {(index >> chanShift) & chanOffsetMask;}
fn chanPos(index u64) u64 {index >> chanShift;}

// One value's place: 'state' is 0 until the value is written, then 1
struct Slot[T] {
  pub state u32;
  pub value T;
}

// 32 slots and the block after them, which stays 0 until it is installed.
// Allocated zeroed, so every slot starts unwritten.
struct Block[T] {
  pub next *Block[T];
  pub slots [32; Slot[T]];
}

// What every end of one channel shares, one allocation, in three groups,
// each on 64-byte cache lines of its own. Cone has no alignment attribute
// yet, so padding fields keep every group 64 bytes or more from the next:
// an address that far past another's last byte is on a later line.
//
// - The senders' group, written by every send: their index; the unbounded
//   kind's block it falls in; the bounded kind's 'seen', the receiver's
//   count as a sender last read it.
// - The shared group, read by every send or take and written seldom:
//   'sleeping', written when the receiver goes to sleep; the two counts,
//   when a sender is cloned or dropped; the bounded kind's ring and mask, set
//   once, and 'waiting' and 'space', written only by a sender about to sleep
//   for want of room and by the receiver waking it.
// - The receiver's group, the bounded kind's 'taken', written by every take
//   and read by a sender only when 'seen' says the ring may be full. The
//   unbounded kind's receiver publishes nothing: its index lives in the
//   Receiver, which no other thread reads.
//
// The whole is 384 bytes, a multiple of 64, so a bounded channel's ring,
// which follows it in the same allocation, begins as aligned as that.
struct Chan[T] {
  pub before [64; u8];
  pub tail u64;                // the senders' index; bit 0, closed
  pub tailBlock *Block[T];     // unbounded: the block the senders' index falls in
  pub seen u64;                // bounded: 'taken', as a sender last read it
  pub between [64; u8];
  pub sleeping u32;            // the futex word: 1 while the receiver sleeps
  pub sides u32;               // 2, less 1 as the receiver and as the last sender go
  pub senders u64;             // how many Senders there are
  pub ring *Cell[T];           // bounded: its cells; unbounded: 0, which says which kind
  pub mask u64;                // bounded: its cells less 1
  pub waiting u32;             // bounded: 1 while a sender sleeps, or is about to, for room
  pub space u32;               // bounded: the futex word they sleep on; changed to wake them
  pub gap [64; u8];
  pub taken u64;               // bounded: how many positions the receiver has taken
  pub after [120; u8];
}

// A new block, every slot unwritten and no next block
fn blockNew[T]() *Block[T] {
  imm b = libc.calloc(1usize, mem.sizeof[Block[T]]()) as *Block[T];
  if b as usize == 0usize {
    die("sync: out of memory for a channel's block\n");
  }
  b;
}

fn slotAt[T](b *Block[T], offset u64) *Slot[T] {
  (&(*b).slots as *Slot[T]) + usize[offset];
}

// The receiver's index after taking the slot at offset: the next position,
// or, past a block's last slot, the next lap's offset 0
fn chanStep(head u64, offset u64) u64 {
  if offset + 1u64 < blockCap {
    return head + chanOne;
  }
  (chanPos(head) - offset + chanLap) << chanShift;
}

// The receiver has taken the last slot of block b: follow its link, and free
// it. Every sender that claimed a slot in it has marked its slot written,
// which is the last it does to the block; a sender that still holds it as
// the senders' block from before it was replaced finds the index moved on,
// and never touches it.
fn chanPassBlock[T](b *Block[T]) *Block[T] {
  // Acquire, for the installer's release, which came before the last slot
  // was marked written: so the link is there already, and the wait is a guard
  imm nextp = &(*b).next as **Block[T];
  mut next = mem.atomicLoad[*Block[T]](nextp, MemOrder.Acquire[]);
  mut step = 0u32;
  while next as usize == 0usize {
    step = chanBackoff(step);
    next = mem.atomicLoad[*Block[T]](nextp, MemOrder.Acquire[]);
  }
  libc.free(b as *u8);
  next;
}

// Wait a moment for another thread to finish a step it has begun (a send
// writing the slot it claimed, a sender installing the next block): spin
// for the first spinLimit rereads, then give the processor up on each. The
// step is short, but the thread taking it may have been preempted in it.
fn chanBackoff(step u32) u32 {
  if step < spinLimit {
    return step + 1u32;
  }
  SwitchToThread();
  step;
}

// Wake the receiver if it sleeps or is about to. The load is sequentially
// consistent, and so are the claim that preceded it and the receiver's
// 'sleeping' store and its reread of the senders' index: that is Dekker's
// pairing, and it means that either this load sees the receiver's 1, or the
// receiver's reread sees the claim and it does not sleep. The swap only
// decides which of several senders makes the call; the OS compares the word
// again as the receiver goes to sleep, so it needs no ordering of its own.
fn chanWake(sleeping *u32) {
  if mem.atomicLoad[u32](sleeping, MemOrder.SeqCst[]) != 0u32 {
    if mem.atomicSwap[u32](sleeping, 0u32, MemOrder.Relaxed[]) != 0u32 {
      rawWake(sleeping);
    }
  }
}

// One side (the receiver, or the senders together, when the last one goes)
// lets go; the second to go frees the channel. AcqRel, so the one that frees
// it has seen everything the other side did to it.
fn chanRelease[T](c *Chan[T]) {
  if mem.atomicSub[u32](&(*c).sides as *u32, 1u32, MemOrder.AcqRel[]) == 1u32 {
    libc.free(c as *u8);
  }
}

// The clock recvTimeout measures by: nanoseconds from some fixed moment
fn nowNs() u64 {
  mut count = 0i64;
  mut freq = 0i64;
  QueryPerformanceCounter(&mut count as *i64);
  QueryPerformanceFrequency(&mut freq as *i64);
  imm c = u64[count];
  imm f = u64[freq];
  // Split, so that count * 10^9 cannot overflow
  (c / f) * 1000000000u64 + (c % f) * 1000000000u64 / f;
}

// ---------------------------------------------------------------------------
// The bounded kind: a ring of cells, a power of two of them, each holding a
// value and a sequence stamp. Positions are counted in the same index as the
// unbounded kind's, shifted left one bit for the closed bit, but with no
// laps: position p's cell is p & mask, and p may be written once the
// receiver has taken p less a ring.
//
// - A sender claims position p with one compare-and-swap on the senders'
//   index, as the unbounded kind's does, when there is room for it: when
//   the receiver's count of positions taken, 'taken', is more than p less a
//   ring. It writes the value and sets the cell's stamp to p + 1, which says
//   "p is written".
// - The receiver's index is its own, as the unbounded kind's: it waits for
//   its cell's stamp to say its position is written, moves the value out,
//   and stores the new count in 'taken' -- a store, no read-modify-write.
//
// That is JCTools' MpscArrayQueue (a compare-and-swap on the producers'
// index, checked against the consumer's index through a cached limit, the
// consumer's index a plain ordered store), with the per-cell sequence stamp
// of Vyukov's bounded queue (1024cores, "Bounded MPMC queue") and
// crossbeam-channel's "array" flavour standing for "written", since a
// Cone T has no null to mark an empty cell. Their stamps also carry the
// room: the receiver sets each cell's stamp free as it takes, which senders
// read before their claim. Measured, that runs 105 and 128 ns a value with
// two and four senders into a ring of 1024, where this runs 78 and 81, since
// the receiver then writes the very lines senders are writing: here it
// writes only 'taken', on its own line, which senders read only when 'seen',
// their copy of it on their own line, says the ring may be full.
//
// A sender that finds the ring full spins briefly, then sleeps on the
// 'space' futex word, having set the 'waiting' flag; the receiver, having
// stored 'taken', wakes them only if the flag is set. The ring follows the
// shared part in its allocation and is freed with it, when both sides have
// gone, since a sender may still be about to read 'taken' after the
// receiver has gone.
// ---------------------------------------------------------------------------

// The most values a bounded channel may hold. The index counts positions to
// 2^63, so this is no limit of its own; it keeps the ring's size from
// overflowing, and asking for more is sure to be a mistake.
const ringMaxCap = 0x100000000u64;

// A bounded channel's place for one value
struct Cell[T] {
  pub stamp u64;
  pub value T;
}

fn cellAt[T](ring *Cell[T], i u64) *Cell[T] {
  ring + usize[i];
}

// Put v in a bounded channel's ring, waiting while it is full if mayWait,
// for at most timeoutNs: None once it is there, or Some[v] back when the
// channel is closed, or full and this may not wait longer
fn ringSend[T](c *Chan[T], v T, mayWait Bool, timeoutNs u64) Option[T] {
  imm tailp = &(*c).tail as *u64;
  imm seenp = &(*c).seen as *u64;
  imm takenp = &(*c).taken as *u64;
  imm ring = (*c).ring;
  imm mask = (*c).mask;
  // Relaxed: the index only says which position to try for; the claim, a
  // compare-and-swap on it, is what orders
  mut tail = mem.atomicLoad[u64](tailp, MemOrder.Relaxed[]);
  mut spins = 0u32;
  mut started = false;
  mut start = 0u64;
  while true {
    if (tail & chanClosed) != 0u64 {
      return Some[T][v];
    }
    imm pos = chanPos(tail);
    // Room for pos: its cell's last value, pos less a ring, is taken. 'seen'
    // answers without reaching the receiver's line; only when it says no is
    // 'taken' itself read, and 'seen' brought up to it. Acquire, both, and
    // the store Release: the receiver's release of 'taken' comes after it
    // moved that value out, which must be before this send writes the cell,
    // however many senders' hands 'seen' has passed through.
    mut room = pos <= mem.atomicLoad[u64](seenp, MemOrder.Acquire[]) + mask;
    if !room {
      imm taken = mem.atomicLoad[u64](takenp, MemOrder.Acquire[]);
      mem.atomicStore[u64](seenp, taken, MemOrder.Release[]);
      room = pos <= taken + mask;
    }
    if room {
      // Claim it. SeqCst, as the unbounded kind's claim: this is what
      // chanWake's Dekker pairing is made with. A failure only says where
      // the index is now, so Relaxed. The room found stays: the count only
      // grows.
      mut now = 0u64;
      mut claimed = false;
      now, claimed = mem.atomicCompareSwap[u64](tailp, tail, tail + chanOne,
        MemOrder.SeqCst[], MemOrder.Relaxed[]);
      if claimed {
        imm cell = cellAt[T](ring, pos & mask);
        mem.writeRaw[T](&(*cell).value as *T, v);
        // Release: the value, written above, is seen by the receiver that
        // acquires this stamp
        mem.atomicStore[u64](&(*cell).stamp as *u64, pos + 1u64, MemOrder.Release[]);
        chanWake(&(*c).sleeping as *u32);
        return None[T][];
      }
      tail = now;
      continue;
    }
    // Full: the position a ring back is not yet taken
    if !mayWait {
      return Some[T][v];
    }
    if spins < spinLimit {
      spins = spins + 1u32;
      tail = mem.atomicLoad[u64](tailp, MemOrder.Relaxed[]);
      continue;
    }
    mut left = forever;
    if timeoutNs != forever {
      if !started {
        start = nowNs();
        started = true;
      }
      imm waited = nowNs() - start;
      if waited >= timeoutNs {
        return Some[T][v];
      }
      left = timeoutNs - waited;
    }
    ringPark[T](c, left);
    spins = 0u32;
    tail = mem.atomicLoad[u64](tailp, MemOrder.Relaxed[]);
  }
  Some[T][v];
}

// A sender that found the ring full sleeps until the receiver takes a value
// or closes the channel, or timeoutNs passes. It reads 'space', then sets
// 'waiting', then rereads the senders' index and 'taken', all SeqCst: its
// half of a Dekker pairing with the receiver's store of 'taken' and its load
// of 'waiting' (ringFreed), and with a close and the same load (ringWake).
// Either the reread sees the room or the close, and it does not sleep, or
// the receiver sees the flag and changes 'space' and wakes, which the OS's
// compare of 'space' does not miss.
//
// 'space' is read first, before the flag is set, so that the flag this
// sender sleeps under is always its own: a receiver that clears it after it
// is set changes 'space' after too, which the sleep then sees. Read after,
// a receiver could clear the flag and change 'space' between the two, the
// sender read the changed 'space', find the ring full again -- another
// sender having taken the room -- and sleep with the flag clear, and no take
// would wake it. That order hung 17 runs in 20 of 3000 rounds of four
// senders of unequal lengths into a ring of 2, the last sender left asleep
// once the others had finished; this one, none in 40.
fn ringPark[T](c *Chan[T], timeoutNs u64) {
  imm spacep = &(*c).space as *u32;
  imm seq = mem.atomicLoad[u32](spacep, MemOrder.SeqCst[]);
  mem.atomicStore[u32](&(*c).waiting as *u32, 1u32, MemOrder.SeqCst[]);
  imm tail = mem.atomicLoad[u64](&(*c).tail as *u64, MemOrder.SeqCst[]);
  imm taken = mem.atomicLoad[u64](&(*c).taken as *u64, MemOrder.SeqCst[]);
  if (tail & chanClosed) == 0u64 and chanPos(tail) > taken + (*c).mask {
    rawWait(spacep, seq, timeoutNs);
  }
}

// The receiver has taken a value ('taken' stored SeqCst): wake the senders
// asleep for room, if the flag says any may be. SeqCst, the receiver's half
// of ringPark's pairing. This load, one a take, is the whole of what the
// senders' sleeping costs the receiver while none sleeps.
fn ringFreed[T](c *Chan[T]) {
  if mem.atomicLoad[u32](&(*c).waiting as *u32, MemOrder.SeqCst[]) != 0u32 {
    ringWake[T](c);
  }
}

// Wake every sender asleep for room, if the flag says one may be, clearing
// it: after a take, and after a close (the closed bit set SeqCst). The change
// to 'space' is SeqCst and after the store of 'taken' or the close, so a
// sender that reads the new 'space' rereads after them too. Clearing the flag
// means the takes that follow, while the woken senders are still waking,
// make no system call; a sender that finds the ring full again sets it again
// before it sleeps. Every sleeper is woken, not one: by the time they run the
// receiver has most often taken a good many more, and a sender woken and not
// needed costs a failed try and a sleep, where one woken too few would be a
// sender asleep with room for it. (A wake of one sender at every take while
// the flag was set measured twenty and more wakes for every sleep, the
// receiver waking again and again while the first woken was still waking.)
fn ringWake[T](c *Chan[T]) {
  if mem.atomicSwap[u32](&(*c).waiting as *u32, 0u32, MemOrder.SeqCst[]) != 0u32 {
    imm spacep = &(*c).space as *u32;
    mem.atomicAdd[u32](spacep, 1u32, MemOrder.SeqCst[]);
    rawWakeAll(spacep);
  }
}

// A bounded channel's receiver goes, its index at head: close the channel,
// waking every sender asleep for room, which finds it closed and takes its
// value back; finalize each value still in the ring, once, waiting out any
// send that claimed its position before the close and has not written it;
// and let go of the shared part, whose allocation holds the ring.
fn ringFinal[T](c *Chan[T], head u64) {
  imm tailp = &(*c).tail as *u64;
  mem.atomicOr[u64](tailp, chanClosed, MemOrder.SeqCst[]);
  ringWake[T](c);
  // No claim follows the close, so the index is final
  imm end = chanPos(mem.atomicLoad[u64](tailp, MemOrder.Acquire[]));
  mut pos = chanPos(head);
  while pos != end {
    imm cell = cellAt[T]((*c).ring, pos & (*c).mask);
    mut step = 0u32;
    while mem.atomicLoad[u64](&(*cell).stamp as *u64, MemOrder.Acquire[]) != pos + 1u64 {
      step = chanBackoff(step);
    }
    mem.finalize[T](&(*cell).value as *T);
    pos = pos + 1u64;
  }
  chanRelease[T](c);
}

// What the receiver finds at its index
const pollReady = 0u32;                // a value, written
const pollEmpty = 1u32;                // nothing yet
const pollClosed = 2u32;               // nothing, and nothing more will come

// The constructors: 'Channel[T].make()' and 'Channel[T].bounded(n)', which
// answer the two ends
pub struct Channel[T Sendable] {
  // A new unbounded channel: its sending end and its receiving end
  pub fn make() Sender[T], Receiver[T] {
    imm c = libc.malloc(mem.sizeof[Chan[T]]()) as *Chan[T];
    if c as usize == 0usize {
      die("sync: out of memory for a channel\n");
    }
    imm b = blockNew[T]();
    chanInit[T](c, b, 0usize as *Cell[T], 0u64);
    Sender[T].made(c), Receiver[T].made(c, b, 0usize as *Cell[T], 0u64);
  }

  // A new bounded channel holding at most n values -- n rounded up to a
  // power of two, and 0 taken as 1 -- whose sends wait while it is full
  pub fn bounded(n u64) Sender[T], Receiver[T] {
    mut cap = 1u64;
    while cap < n {
      if cap >= ringMaxCap {
        die("sync: a bounded channel of more than 2^32 values\n");
      }
      cap = cap << 1u64;
    }
    // Zeroed, so every cell's stamp says unwritten
    imm head = mem.sizeof[Chan[T]]();
    imm c = libc.calloc(1usize, head + usize[cap] * mem.sizeof[Cell[T]]()) as *Chan[T];
    if c as usize == 0usize {
      die("sync: out of memory for a channel\n");
    }
    imm ring = ((c as *u8) + head) as *Cell[T];
    chanInit[T](c, 0usize as *Block[T], ring, cap - 1u64);
    Sender[T].made(c), Receiver[T].made(c, 0usize as *Block[T], ring, cap - 1u64);
  }
}

// The shared part's fields, before any thread can reach it
fn chanInit[T](c *Chan[T], b *Block[T], ring *Cell[T], mask u64) {
  (*c).tail = 0u64;
  (*c).tailBlock = b;
  (*c).sleeping = 0u32;
  (*c).sides = 2u32;
  (*c).senders = 1u64;
  (*c).ring = ring;
  (*c).mask = mask;
  (*c).waiting = 0u32;
  (*c).space = 0u32;
  (*c).seen = 0u64;
  (*c).taken = 0u64;
}

// The sending end of a channel. There may be any number: 'clone' makes
// another, and the last one to die closes the channel.
pub struct Sender[T Sendable] is Sendable {
  chan *Chan[T];

  fn made(c *Chan[T]) Sender[T] {Sender[T][c];}

  // Put v on the channel: None once it is there. A bounded channel's send
  // waits while it is full; an unbounded one's never waits. If the receiver
  // has gone or closed the channel, v is handed back: Some[v].
  pub fn send(self &, v T) Option[T] {
    if (*chan).ring as usize == 0usize {
      return self.listSend(v);
    }
    ringSend[T](chan, v, true, forever);
  }

  // Put v on the channel if there is room now, never waiting: None once it
  // is there; Some[v], handed back, when a bounded channel is full, or the
  // channel is closed
  pub fn trySend(self &, v T) Option[T] {
    if (*chan).ring as usize == 0usize {
      return self.listSend(v);
    }
    ringSend[T](chan, v, false, 0u64);
  }

  // send, waiting at most ns nanoseconds for room: Some[v] back when there
  // was none in that time, or the channel is closed
  pub fn sendTimeout(self &, v T, ns u64) Option[T] {
    if (*chan).ring as usize == 0usize {
      return self.listSend(v);
    }
    ringSend[T](chan, v, true, ns);
  }

  // An unbounded channel's send
  fn listSend(self &, v T) Option[T] {
    imm c = chan;
    imm tailp = &(*c).tail as *u64;
    imm blockp = &(*c).tailBlock as **Block[T];
    // Acquire: the installer of a block stores the block, then moves the
    // index on to its lap, releasing; an index seen in that lap brings the
    // block with it, and the zeroed memory under it
    mut tail = mem.atomicLoad[u64](tailp, MemOrder.Acquire[]);
    mut block = mem.atomicLoad[*Block[T]](blockp, MemOrder.Acquire[]);
    // The next block, made before the claim of a block's last slot so the
    // other senders wait on the installer as briefly as can be
    mut spare = 0usize as *Block[T];
    mut offset = 0u64;
    mut claimed = false;
    mut step = 0u32;
    while !claimed {
      if (tail & chanClosed) != 0u64 {
        if spare as usize != 0usize {
          libc.free(spare as *u8);
        }
        return Some[T][v];
      }
      offset = chanOffset(tail);
      // Another sender is installing the next block: wait for it
      if offset == blockCap {
        step = chanBackoff(step);
        tail = mem.atomicLoad[u64](tailp, MemOrder.Acquire[]);
        block = mem.atomicLoad[*Block[T]](blockp, MemOrder.Acquire[]);
        continue;
      }
      if offset + 1u64 == blockCap and spare as usize == 0usize {
        spare = blockNew[T]();
      }
      // Claim the position. SeqCst: this is the claim chanWake's Dekker
      // pairing is made with (the receiver rereads this word before it
      // sleeps). On failure, Acquire, as the first load.
      mut seen = 0u64;
      seen, claimed = mem.atomicCompareSwap[u64](tailp, tail, tail + chanOne,
        MemOrder.SeqCst[], MemOrder.Acquire[]);
      if !claimed {
        tail = seen;
        block = mem.atomicLoad[*Block[T]](blockp, MemOrder.Acquire[]);
      }
    }
    // The block is the one the claimed position falls in: the index never
    // goes back, so it did not move between that load and the claim, and a
    // block is replaced only while the index stands at offset 32
    if offset + 1u64 == blockCap {
      // This claimed the block's last slot: install the next one. The block
      // first, then the index past offset 32 to the next lap (an add, not a
      // store, so a close made meanwhile is kept), both releasing, for the
      // senders' acquiring loads; then the link the receiver follows,
      // releasing for its acquire. All three come before this slot is marked
      // written, which the receiver waits for before it follows the link.
      mem.atomicStore[*Block[T]](blockp, spare, MemOrder.Release[]);
      mem.atomicAdd[u64](tailp, (chanLap - blockCap) << chanShift, MemOrder.Release[]);
      mem.atomicStore[*Block[T]](&(*block).next as **Block[T], spare, MemOrder.Release[]);
    } elif spare as usize != 0usize {
      // Made for an earlier try that another sender won
      libc.free(spare as *u8);
    }
    imm slot = slotAt[T](block, offset);
    mem.writeRaw[T](&(*slot).value as *T, v);
    // Release: the value, written above, is seen by the receiver that
    // acquires this state
    mem.atomicStore[u32](&(*slot).state as *u32, 1u32, MemOrder.Release[]);
    chanWake(&(*c).sleeping as *u32);
    None[T][];
  }

  // 'tx <- v' is send: what it answers is send's
  pub fn `<-`(self &, v T) Option[T] {
    self.send(v);
  }

  // Another sender on the same channel. Relaxed: this sender is alive, so
  // the count cannot reach 0 meanwhile, and nothing is published by it.
  pub fn clone(self &) Sender[T] {
    mem.atomicAdd[u64](&(*chan).senders as *u64, 1u64, MemOrder.Relaxed[]);
    Sender[T][chan];
  }

  // The last sender to go closes the channel, and wakes the receiver, which
  // takes what is left and then sees it closed
  fn final(self &uni) {
    imm c = chan;
    // AcqRel: each sender's release, and the last one's acquire, bring every
    // sender's doings before the close, and so before the receiver's
    // acquiring load that sees it
    if mem.atomicSub[u64](&(*c).senders as *u64, 1u64, MemOrder.AcqRel[]) == 1u64 {
      // SeqCst: the close is a change the receiver must not sleep through,
      // paired with chanWake's load as a claim is
      mem.atomicOr[u64](&(*c).tail as *u64, chanClosed, MemOrder.SeqCst[]);
      chanWake(&(*c).sleeping as *u32);
      chanRelease[T](c);
    }
  }
}

// The receiving end of a channel: there is one, a move type with no clone,
// so only one thread takes values from it. Its index and block are its own,
// read and written by nobody else.
pub struct Receiver[T Sendable] is Sendable {
  chan *Chan[T];
  head u64;                    // the next position to take
  block *Block[T];             // unbounded: the block it falls in
  ring *Cell[T];               // bounded: the ring; unbounded: 0
  mask u64;                    // bounded: the ring's cells less 1

  fn made(c *Chan[T], b *Block[T], ring *Cell[T], mask u64) Receiver[T] {
    Receiver[T][c, 0u64, b, ring, mask];
  }

  // Each way of receiving asks which kind the channel is once, at the top,
  // and runs that kind's loop: asking in poll and take instead, at every
  // value, measured some 15 ns a value slower for the unbounded kind with
  // one sender, where the receiver is what sets the pace (with two senders
  // or four, the difference was lost in the noise).

  // The next value, waiting while there is none; None once the channel is
  // closed (every sender gone, or 'close') and everything sent is taken
  pub fn recv(self &mut) Option[T] {
    if ring as usize != 0usize {
      return self.ringRecv(forever);
    }
    while true {
      imm found = self.poll();
      if found == pollReady {
        return Some[T][self.take()];
      }
      if found == pollClosed {
        return None[T][];
      }
      self.park(forever);
    }
    None[T][];
  }

  // The next value if one is there now, never waiting; None when there is
  // none, whether or not more may come ('isClosed' says which)
  pub fn tryRecv(self &mut) Option[T] {
    if ring as usize != 0usize {
      if self.ringPoll() == pollReady {
        return Some[T][self.ringTake()];
      }
      return None[T][];
    }
    if self.poll() == pollReady {
      return Some[T][self.take()];
    }
    None[T][];
  }

  // A bounded channel's recv and recvTimeout: timeoutNs is forever for recv
  fn ringRecv(self &mut, timeoutNs u64) Option[T] {
    imm start = if timeoutNs == forever {0u64;} else {nowNs();};
    while true {
      imm found = self.ringPoll();
      if found == pollReady {
        return Some[T][self.ringTake()];
      }
      if found == pollClosed {
        return None[T][];
      }
      if timeoutNs == forever {
        self.park(forever);
      } else {
        imm waited = nowNs() - start;
        if waited >= timeoutNs {
          return None[T][];
        }
        self.park(timeoutNs - waited);
      }
    }
    None[T][];
  }

  // The next value, waiting at most ns nanoseconds for one; None when none
  // came in that time, or the channel is closed and empty. The sleep is the
  // futex's, so it may run over by up to the system's timer tick.
  pub fn recvTimeout(self &mut, ns u64) Option[T] {
    if ring as usize != 0usize {
      return self.ringRecv(ns);
    }
    imm start = nowNs();
    while true {
      imm found = self.poll();
      if found == pollReady {
        return Some[T][self.take()];
      }
      if found == pollClosed {
        return None[T][];
      }
      imm waited = nowNs() - start;
      if waited >= ns {
        return None[T][];
      }
      self.park(ns - waited);
    }
    None[T][];
  }

  // Refuse any further send: each is handed its value back. What was sent
  // before stays, to be taken. Unbounded, Relaxed: the close and every claim
  // change one word, whose own order is all that decides which sends it
  // refuses. Bounded, SeqCst, and the senders asleep while it is full are
  // woken, to find it closed: ringPark's pairing.
  pub fn close(self &mut) {
    if ring as usize == 0usize {
      mem.atomicOr[u64](&(*chan).tail as *u64, chanClosed, MemOrder.Relaxed[]);
    } else {
      mem.atomicOr[u64](&(*chan).tail as *u64, chanClosed, MemOrder.SeqCst[]);
      ringWake[T](chan);
    }
  }

  // Whether the channel is closed, by the receiver or by its last sender
  // going: nothing more will arrive, though what came before may still be
  // waiting to be taken. Acquire, as poll's load of the same word.
  pub fn isClosed(self &) Bool {
    (mem.atomicLoad[u64](&(*chan).tail as *u64, MemOrder.Acquire[]) & chanClosed) != 0u64;
  }

  // What is at the receiver's index, waiting out a send that has claimed
  // it and not yet written it
  fn poll(self &mut) u32 {
    imm slot = slotAt[T](block, chanOffset(head));
    imm statep = &(*slot).state as *u32;
    // Acquire: the sender's release store of the state brings its value
    if mem.atomicLoad[u32](statep, MemOrder.Acquire[]) != 0u32 {
      return pollReady;
    }
    // Acquire: when this sees the channel closed, everything the senders
    // did before it closed is seen too
    imm tail = mem.atomicLoad[u64](&(*chan).tail as *u64, MemOrder.Acquire[]);
    if chanPos(tail) == chanPos(head) {
      return if (tail & chanClosed) != 0u64 {pollClosed;} else {pollEmpty;};
    }
    // Claimed, and being written
    mut step = 0u32;
    while mem.atomicLoad[u32](statep, MemOrder.Acquire[]) == 0u32 {
      step = chanBackoff(step);
    }
    pollReady;
  }

  // A bounded channel's poll: the same three answers, from its cell's stamp
  fn ringPoll(self &mut) u32 {
    imm pos = chanPos(head);
    imm stampp = &(*cellAt[T](ring, pos & mask)).stamp as *u64;
    // Acquire: the sender's release store of the stamp brings its value
    if mem.atomicLoad[u64](stampp, MemOrder.Acquire[]) == pos + 1u64 {
      return pollReady;
    }
    // Acquire, as the unbounded kind's poll
    imm tail = mem.atomicLoad[u64](&(*chan).tail as *u64, MemOrder.Acquire[]);
    if chanPos(tail) == pos {
      return if (tail & chanClosed) != 0u64 {pollClosed;} else {pollEmpty;};
    }
    // Claimed, and being written
    mut step = 0u32;
    while mem.atomicLoad[u64](stampp, MemOrder.Acquire[]) != pos + 1u64 {
      step = chanBackoff(step);
    }
    pollReady;
  }

  // A bounded channel's take: move the written value out, step past it,
  // and say so in 'taken', which frees its cell for the position a ring
  // later. SeqCst: a release, for the acquiring load of a sender that then
  // writes the cell; and the receiver's half of ringPark's pairing, with
  // ringFreed's load. (x86 makes a SeqCst store an xchg, which waits for
  // the store to leave the processor: the price of letting senders sleep,
  // since without it the load after could be answered before the store is
  // seen, and a sender go to sleep that nobody wakes. It is to the
  // receiver's own line, which senders seldom read.)
  fn ringTake(self &mut) T {
    imm pos = chanPos(head);
    imm v = mem.readRaw[T](&(*cellAt[T](ring, pos & mask)).value as *T);
    head = head + chanOne;
    mem.atomicStore[u64](&(*chan).taken as *u64, pos + 1u64, MemOrder.SeqCst[]);
    ringFreed[T](chan);
    v;
  }

  // Move the written value at the index out, and step past it
  fn take(self &mut) T {
    imm offset = chanOffset(head);
    imm v = mem.readRaw[T](&(*slotAt[T](block, offset)).value as *T);
    self.advance(offset);
    v;
  }

  // Step past the slot at offset, which is taken. Past a block's last slot,
  // follow its link and free it: every sender that claimed a slot in it has
  // marked its slot written, which is the last it does to the block, and a
  // sender holding it as the senders' block from before it was replaced
  // finds the index moved on and never touches it.
  fn advance(self &mut, offset u64) {
    if offset + 1u64 == blockCap {
      block = chanPassBlock[T](block);
    }
    head = chanStep(head, offset);
  }

  // Sleep until a send or a close may have changed what poll finds, or until
  // timeoutNs passes. Spin first, since a send often comes within it.
  fn park(self &mut, timeoutNs u64) {
    mut n = 0u32;
    if ring as usize != 0usize {
      while n < spinLimit {
        if self.ringPoll() != pollEmpty {
          return;
        }
        n = n + 1u32;
      }
    } else {
      while n < spinLimit {
        if self.poll() != pollEmpty {
          return;
        }
        n = n + 1u32;
      }
    }
    imm c = chan;
    imm sleeping = &(*c).sleeping as *u32;
    // Say that the receiver sleeps, then reread the senders' index: both
    // SeqCst, the receiver's half of the Dekker pairing chanWake describes.
    // A claim or a close this reread does not see comes after it, and its
    // sender's load then sees the 1 and wakes this thread.
    mem.atomicStore[u32](sleeping, 1u32, MemOrder.SeqCst[]);
    imm tail = mem.atomicLoad[u64](&(*c).tail as *u64, MemOrder.SeqCst[]);
    if chanPos(tail) == chanPos(head) and (tail & chanClosed) == 0u64 {
      rawWait(sleeping, 1u32, timeoutNs);
    }
    // Relaxed: only this thread sets it to 1, and its next sleep sets it
    // again, SeqCst, before it rereads
    mem.atomicStore[u32](sleeping, 0u32, MemOrder.Relaxed[]);
  }

  // The receiver's going closes the channel, so each later send gets its
  // value back; finalizes each value still in it, each once, waiting out any
  // send that claimed a slot before the close and has not written it; and
  // frees the blocks, the senders touching none once they see it closed.
  // (It keeps its own copies of the index and the block, and steps them with
  // the free functions advance uses: calling a '&mut' method through 'self
  // &uni' moves the unique reference into the call rather than lending it.)
  fn final(self &uni) {
    imm c = chan;
    if ring as usize != 0usize {
      ringFinal[T](c, head);
      return;
    }
    imm tailp = &(*c).tail as *u64;
    mem.atomicOr[u64](tailp, chanClosed, MemOrder.Relaxed[]);
    // No claim follows the close; one that came before it may still be
    // installing the next block (offset 32), after which the index is final
    mut tail = mem.atomicLoad[u64](tailp, MemOrder.Acquire[]);
    mut step = 0u32;
    while chanOffset(tail) == blockCap {
      step = chanBackoff(step);
      tail = mem.atomicLoad[u64](tailp, MemOrder.Acquire[]);
    }
    mut h = head;
    mut b = block;
    while chanPos(h) != chanPos(tail) {
      imm offset = chanOffset(h);
      imm slot = slotAt[T](b, offset);
      step = 0u32;
      while mem.atomicLoad[u32](&(*slot).state as *u32, MemOrder.Acquire[]) == 0u32 {
        step = chanBackoff(step);
      }
      mem.finalize[T](&(*slot).value as *T);
      if offset + 1u64 == blockCap {
        b = chanPassBlock[T](b);
      }
      h = chanStep(h, offset);
    }
    libc.free(b as *u8);
    chanRelease[T](c);
  }
}
