// Channel[T] under contention. Four producer threads each send 100000
// items as fast as they can, producer p's k-th item being p * 2^32 + k, while
// main takes them: every item arrives, once, and each producer's in the order
// it sent them.
//
//   items  400000
//   sum    2577000377800000 = 2^32 * 100000 * (0 + 1 + 2 + 3)
//                             + 4 * (100000 * 100001 / 2)
//
// Then the receiver goes while three producers are still sending values
// whose deaths are counted: main takes 1000 and drops the receiver; each
// producer sends 20000 regardless, counting the sends refused and handed
// back. Every one of the 60000 values dies exactly once -- taken and dropped
// by main, finalized by the receiver's death, or handed back to its producer
// and dropped there -- and the refused ones are exactly those not taken or
// finalized. Run 5 times, as the moment the receiver goes lands differently
// each time.

mod channelstress;

import testing use *;
import thread;
import sync use *;

const perProducer = 100000u64;

struct Work {
  pub tx Sender[u64];
  pub id u64;
}

fn produce(w Work) u64 {
  var k = 1u64;
  while k <= perProducer {
    w.tx.send((w.id << 32u64) + k);
    k = k + 1u64;
  }
  perProducer;
}

// A value whose deaths are counted, from any thread
let deaths Atomic[u64];

fn @initpure init() {
  deaths = Atomic[u64].of(0u64);
}

struct Counted {
  pub n u64;
  fn final(self &uni) {
    deaths.add(1u64);
  }
}

struct CountedWork {
  pub tx Sender[Counted];
  pub id u64;
}

// Send 20000 counted values: how many were refused
fn produceCounted(w CountedWork) u64 {
  var refused = 0u64;
  var k = 1u64;
  while k <= 20000u64 {
    match w.tx.send(new Counted(w.id * 100000u64 + k)) {
      case is Some[Counted] {refused = refused + 1u64;}
      case is None[Counted] {}
    }
    k = k + 1u64;
  }
  refused;
}

fn dropReceiver(rx Receiver[Counted]) {}

fn contended() {
  var tx Sender[u64];
  var rx Receiver[u64];
  tx, rx = Channel[u64].make();
  let a = thread.start(new Work(tx.clone(), 1u64), &produce);
  let b = thread.start(new Work(tx.clone(), 2u64), &produce);
  let c = thread.start(new Work(tx.clone(), 3u64), &produce);
  let d = thread.start(new Work(tx, 0u64), &produce);
  var last = new Array[u64, 4] <- fill 0u64;
  var items = 0u64;
  var sum = 0u64;
  var disorder = 0u64;
  var more = true;
  while more {
    match rx.recv() {
      case let s Some {
        let p = s >> 32u64;
        let k = s & 0xFFFFFFFFu64;
        if p > 3u64 or k != last[p] + 1u64 {
          disorder = disorder + 1u64;
        }
        if p <= 3u64 {
          last[p] = k;
        }
        items = items + 1u64;
        sum = sum + s;
      }
      case is None[u64] {more = false;}
    }
  }
  let sent = a.join() + b.join() + c.join() + d.join();
  expectUInt(sent, 400000u64, "the items four producers sent");
  expectUInt(items, 400000u64, "the items taken");
  expectUInt(sum, 2577000377800000u64, "their sum");
  expectUInt(disorder, 0u64, "each producer's in its own order");
}

// The receiver goes mid-stream: every value dies once
fn receiverGoes() bool {
  deaths.store(0u64);
  var tx Sender[Counted];
  var rx Receiver[Counted];
  tx, rx = Channel[Counted].make();
  let a = thread.start(new CountedWork(tx.clone(), 1u64), &produceCounted);
  let b = thread.start(new CountedWork(tx.clone(), 2u64), &produceCounted);
  let c = thread.start(new CountedWork(tx, 3u64), &produceCounted);
  var taken = 0u64;
  while taken < 1000u64 {
    match rx.recv() {
      case is Some[Counted] {taken = taken + 1u64;}
      case is None[Counted] {}
    }
  }
  dropReceiver(rx);
  let refused = a.join() + b.join() + c.join();
  // Every value is dead now: taken (1000), finalized in the queue when the
  // receiver went, or refused
  let ok = deaths.load() == 60000u64 and refused <= 59000u64;
  ok;
}

fn main() i32 {
  contended();
  var run = 0u32;
  var good = 0u32;
  while run < 5u32 {
    if receiverGoes() {
      good = good + 1u32;
    }
    run = run + 1u32;
  }
  expectUInt(u64.from(good), 5u64, "every value died exactly once, in each of 5 runs");
  done();
}
