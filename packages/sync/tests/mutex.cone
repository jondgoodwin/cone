// Mutex. Four threads each push 2000 numbers into one collections.List,
// taking a Mutex around every push, and main joins them and checks the List:
// exactly 8000 long, every number there once, and each thread's numbers in
// the order it pushed them. A List's push is a read-then-write of its length
// (and, as it grows, a move to a bigger block), so without the lock pushes
// are lost or the List is torn. The whole race is run 25 times, to give a
// broken lock many chances to show itself. Then tryLock, on one thread:
// it fails while the Mutex is held, by anyone, and succeeds once it is not.
//
// The List lives in an 'Arc[Mutex, Items]' that main hands to each thread, so
// every push is made through a borrow that takes the Mutex and gives it back,
// and nothing reaches the List unlocked.

mod mutex;

import testing use *;
import thread;
import collections use *;
import sync use *;

const perThread = 2000u64;
const threads = 4u64;

struct Items {pub list: List[u64];}
alias Shared = Arc[Mutex, Items];

// What a pushing thread is given: its number and the shared List
struct Pusher {
  pub k: u64;
  pub items: Shared;
}

// The starting gate: each thread counts itself ready, then waits for 'go',
// so the four push at once rather than one after another as they start
let ready: Atomic[u32];
let go: Atomic[u32];

fn @initpure init() {
  ready = Atomic[u32].of(0u32);
  go = Atomic[u32].of(0u32);
}

fn atGate() {
  ready.add(1u32);
  while go.load() == 0u32 {
    sync.futexWait(&go, 0u32);
  }
}

fn openGate(n: u32) {
  while ready.load() < n {
    thread.yieldNow();
  }
  go.store(1u32);
  sync.futexWakeAll(&go);
}

// Push perThread numbers, thread k's being k * 1000000 + i
fn pushMany(p: Pusher) u64 {
  atGate();
  var i = 0u64;
  while i < perThread {
    (&mut *p.items).list.push(p.k * 1000000u64 + i);
    i = i + 1u64;
  }
  i
}

// One race: whether the List came out whole
fn race(items: Shared) bool {
  (&mut *items).list.clear();
  ready.store(0u32);
  go.store(0u32);
  let a = thread.start(Pusher(0u64, items), &pushMany);
  let b = thread.start(Pusher(1u64, items), &pushMany);
  let c = thread.start(Pusher(2u64, items), &pushMany);
  let d = thread.start(Pusher(3u64, items), &pushMany);
  openGate(4u32);
  let made = a.join() + b.join() + c.join() + d.join();
  let all = &*items;
  if made != threads * perThread || all.list.len() != usize.from(threads * perThread) {
    return false;
  }
  // Each thread's numbers appear in order, and all of them do
  var next = Array[u64, 4]() <- fill 0u64;
  var i = 0usize;
  while i < all.list.len() {
    let v = *all.list[i];
    let k = v / 1000000u64;
    if k >= threads || v % 1000000u64 != next[k] {
      return false;
    }
    next[k] = next[k] + 1u64;
    i = i + 1usize;
  }
  next[0] == perThread && next[1] == perThread && next[2] == perThread && next[3] == perThread
}

fn main() i32 {
  initAll();
  let items = Shared(Items(List[u64]()));
  var whole = 0u64;
  var run = 0;
  while run < 25 {
    if race(items) { whole = whole + 1u64; }
    run = run + 1;
  }
  expectUInt(whole, 25u64, "races whose List came out exactly 8000 long, every push there");
  expectUInt(u64.from((&*items).list.len()), 8000u64, "the last race's List");

  // tryLock
  let m = Mutex.make();
  expect(m.tryLock(), "tryLock takes an unlocked Mutex");
  expect(!m.tryLock(), "tryLock fails while it is held");
  m.unlock();
  expect(m.tryLock(), "tryLock takes it again once unlocked");
  m.unlock();
  m.lock();
  expect(!m.tryLock(), "tryLock fails while lock() holds it");
  m.unlock();
  done()
}
