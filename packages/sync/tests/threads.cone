// Four threads each add 1 to one shared counter 250000 times, the counter an
// Atomic[u64] field of an 'imm' global, and main joins them and reads the
// total: exactly 1000000, every time. The global is 'imm' and changes: only
// inside its atomic part, which is what lets it (it is never placed in
// read-only memory). A plain read-then-write in place of 'add' would lose
// counts (packages/thread/examples/race.cone shows how many).

mod threads;

import testing use *;
import thread;
import sync use *;

struct Stats {
  pub name u32;
  pub hits Atomic[u64];
}

imm stats Stats;

fn @initpure init() {
  stats = Stats[7u32, Atomic[u64].of(0u64)];
}

fn work(n u64) u64 {
  mut i = 0u64;
  while i < n {
    stats.hits.add(1u64);
    i = i + 1u64;
  }
  i;
}

fn main() i32 {
  initAll();
  imm a = thread.start(250000u64, &work);
  imm b = thread.start(250000u64, &work);
  imm c = thread.start(250000u64, &work);
  imm d = thread.start(250000u64, &work);
  imm made = a.join() + b.join() + c.join() + d.join();
  expectUInt(made, 1000000u64, "the adds the four threads made");
  expectUInt(stats.hits.load(), 1000000u64, "the shared counter");
  expectUInt(u64[stats.name], 7u64, "the plain field beside it");
  done();
}
