// Condvar. A bounded buffer of 4 slots, guarded by a Mutex, with two
// Condvars: 'notEmpty', which consumers wait on, and 'notFull', which
// producers wait on. Two producers each put 2000 numbered items, two
// consumers each take 2000, and the buffer being so small, every thread
// waits often. A lost wakeup would leave a thread asleep for good and the
// test would hang (and fail, at Congo's 60 seconds); a broken handoff would
// lose, repeat or tear items, which the sums catch. Run 25 times. Then a
// timed wait with nobody to notify returns false, having slept, with the
// Mutex held again; and notifyAll wakes three waiters at once.

mod condvar;

import testing use *;
import thread;
import sync use *;
import time use Duration, Instant;

const perProducer = 2000u64;
const slots = 4u64;

let m: Mutex;
let notEmpty: Condvar;
let notFull: Condvar;

// The buffer, guarded by m: a ring of slots, where the oldest is, and how many.
// They are atomics, read and written relaxed with no ordering of their own: what
// orders them is m
let ring: Array[Atomic[u64], 4];
let head: Atomic[u64];
let count: Atomic[u64];

// For notifyAll: a flag guarded by m, and how many are waiting on it
let flag: Atomic[bool];
let waiting: Atomic[u32];

fn rd(a: &Atomic[u64]) u64 {
  a.loadOrdered(MemOrder.Relaxed)
}

fn wr(a: &Atomic[u64], v: u64) {
  a.storeOrdered(v, MemOrder.Relaxed);
}

fn @initpure init() {
  ring = [Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64)];
  head = Atomic[u64].of(0u64);
  count = Atomic[u64].of(0u64);
  flag = Atomic[bool].of(false);
  m = Mutex.make();
  notEmpty = Condvar.make();
  notFull = Condvar.make();
  waiting = Atomic[u32].of(0u32);
}

fn put(v: u64) {
  m.lock();
  while rd(&count) == slots {
    notFull.condWait(&m);
  }
  wr(&ring[(rd(&head) + rd(&count)) % slots], v);
  wr(&count, rd(&count) + 1u64);
  notEmpty.notifyOne();
  m.unlock();
}

fn take() u64 {
  m.lock();
  while rd(&count) == 0u64 {
    notEmpty.condWait(&m);
  }
  let v = rd(&ring[rd(&head)]);
  wr(&head, (rd(&head) + 1u64) % slots);
  wr(&count, rd(&count) - 1u64);
  notFull.notifyOne();
  m.unlock();
  v
}

// Producer k puts k * 1000000 + 1 .. k * 1000000 + perProducer
fn produce(k: u64) u64 {
  var i = 1u64;
  while i <= perProducer {
    put(k * 1000000u64 + i);
    i = i + 1u64;
  }
  i - 1u64
}

// A consumer takes perProducer items: their sum
fn consume(k: u64) u64 {
  var sum = 0u64;
  var i = 0u64;
  while i < perProducer {
    sum = sum + take();
    i = i + 1u64;
  }
  sum
}

// One handoff: whether every item arrived once
fn handoff() bool {
  wr(&head, 0u64);
  wr(&count, 0u64);
  let c1 = thread.start(0u64, &consume);
  let c2 = thread.start(1u64, &consume);
  let p1 = thread.start(1u64, &produce);
  let p2 = thread.start(2u64, &produce);
  let made = p1.join() + p2.join();
  let sum = c1.join() + c2.join();
  // Producer k's items sum to k * 1000000 * n + n(n+1)/2
  let n = perProducer;
  let want = 3000000u64 * n + n * (n + 1u64);
  made == 2u64 * n && sum == want && rd(&count) == 0u64
}

// Wait under m until the flag is set
fn awaitFlag(n: u32) u32 {
  m.lock();
  waiting.add(1u32);
  while !flag.loadOrdered(MemOrder.Relaxed) {
    notEmpty.condWait(&m);
  }
  m.unlock();
  1u32
}

fn main() i32 {
  initAll();
  var good = 0u64;
  var run = 0;
  while run < 25 {
    if handoff() { good = good + 1u64; }
    run = run + 1;
  }
  expectUInt(good, 25u64, "handoffs through a 4-slot buffer with every item there once");

  // A timed wait with nobody to notify
  m.lock();
  let before = Instant.now();
  let woken = notFull.condWaitTimeout(&m, Duration.fromMillis(20));
  let took = before.elapsed();
  expect(!woken, "a timed wait nobody notified returns false");
  expect(took >= Duration.fromMillis(19), "having slept its 20 ms (to the timer's rounding)");
  expect(!m.tryLock(), "with the Mutex held again");
  m.unlock();

  // A notification with nobody waiting is harmless
  notFull.notifyOne();
  notFull.notifyAll();

  // notifyAll wakes all three
  let w1 = thread.start(0u32, &awaitFlag);
  let w2 = thread.start(0u32, &awaitFlag);
  let w3 = thread.start(0u32, &awaitFlag);
  while waiting.load() < 3u32 { thread.sleep(Duration.fromMillis(1)); }
  m.lock();
  flag.storeOrdered(true, MemOrder.Relaxed);
  notEmpty.notifyAll();
  m.unlock();
  expectUInt(u64.from(w1.join() + w2.join() + w3.join()), 3u64, "notifyAll woke all three waiters");
  done()
}
