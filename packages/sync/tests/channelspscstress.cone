// A single-sender channel under stress. A producer thread sends 1 to 1000000
// as fast as it can into a channel of 64 while main takes them: every item
// arrives, once, in order.
//
//   items  1000000
//   sum    500000500000 = 1000000 * 1000001 / 2
//
// Then 200000 through a channel of 1, so nearly every send finds it full and
// every take finds it empty, and each side waits on the other:
//
//   items  200000
//   sum    20000100000 = 200000 * 200001 / 2
//
// Then 3000 rounds through a channel of 2 of unequal timing, where a lost
// wake-up hangs the test (and fails it, at Congo's 60 seconds). In round r
// the producer sends 1 to n, n = 300 + 100 * (r % 4), and every 16th value
// (counting from r) it works a while first, 400 * (r % 7) steps of
// arithmetic; main, taking, works 500 * (r % 5) steps after every 16th
// value (counting from 3r). So in some rounds the sender stalls and the
// receiver sleeps on the empty ring, in others the reverse, in others both;
// and at each round's end the sender's going must wake a receiver asleep.
// Each round is checked against its sum, n * (n + 1) / 2, and its order.
// (With the flush that the sleeps' pairings rely on taken out, this hung in
// 20 runs of 20.)
//
// Then 2000 rounds of a close racing a send: the producer sends 1000 values
// of 4 KB each by send into a channel of 4, counting the values handed back
// (the size makes the moment between a send's check for a close and its
// value's arrival long enough to be hit); main takes r % 40 of them, closes
// the channel, and takes what is left until recv answers None; then, once
// the producer has finished, tries once more. A close that let a send
// already under way land after recv's None would show here as a value
// taken late, or as a value neither taken nor handed back: with the close's
// wait for such a send taken out, 8 runs of 20 failed so.
//
//   each round   taken + taken after the close + handed back = 1000
//   in all       none taken late
//
// Then the receiver goes while the producer is still sending values whose
// deaths are counted into a channel of 16, by send: main takes 1000 and
// drops the receiver, which wakes the sender if it sleeps for room. Every one
// of the 20000 dies exactly once -- taken and dropped by main, finalized by
// the receiver's death, or handed back to the producer and dropped there --
// and between 1000 and 1016 are let in: the 1000 taken and at most the 16 a
// full ring holds. Run 5 times, as the moment the receiver goes lands
// differently each time.

mod channelspscstress;

import testing use *;
import thread;
import sync use *;

struct Work {
  pub tx SoloSender[u64];
  pub n u64;
  pub round u64;
}

// Arithmetic the optimizer cannot drop, since its result is used
fn busy(steps u64, seed u64) u64 {
  mut x = seed;
  mut i = 0u64;
  while i < steps {
    x = x * 6364136223846793005u64 + 1442695040888963407u64;
    i = i + 1u64;
  }
  x;
}

// Send 1 to n, working a while before every 16th in rounds that say so:
// n, plus 0 times the work's result, so the work is kept
fn produce(work Work) u64 {
  mut w = work;
  imm steps = 400u64 * (w.round % 7u64);
  mut junk = 0u64;
  mut k = 1u64;
  while k <= w.n {
    if (k + w.round) % 16u64 == 0u64 {
      junk = junk + busy(steps, k);
    }
    w.tx.send(k);
    k = k + 1u64;
  }
  w.n + (junk & 0u64);
}

// Take everything until the channel closes, working after every 16th in
// rounds that say so: how many, their sum, how many out of order
fn takeAll(rx &mut Receiver[u64], round u64) u64, u64, u64 {
  imm steps = 500u64 * (round % 5u64);
  mut items = 0u64;
  mut sum = 0u64;
  mut disorder = 0u64;
  mut junk = 0u64;
  mut more = true;
  while more {
    match rx.recv() {
      case imm s Some {
        if s.value != items + 1u64 {
          disorder = disorder + 1u64;
        }
        items = items + 1u64;
        sum = sum + s.value;
        if steps != 0u64 and (s.value + 3u64 * round) % 16u64 == 0u64 {
          junk = junk + busy(steps, s.value);
        }
      }
      case is None[u64] {more = false;}
    }
  }
  items, sum + (junk & 0u64), disorder;
}

// A value large enough that writing it into its slot takes a while: the
// moment between a send's check for a close and its value's arrival, which
// the close must wait out
struct Big {
  pub n u64;
  pub pad Array[u64, 512];
}

// Send 1 to 1000 by send: how many were handed back
fn produceRefused(tx SoloSender[Big]) u64 {
  mut t = tx;
  mut back = 0u64;
  mut k = 1u64;
  while k <= 1000u64 {
    match t.send(new Big(k, [512; 0u64])) {
      case is Some[Big] {back = back + 1u64;}
      case is None[Big] {}
    }
    k = k + 1u64;
  }
  back;
}

// A value whose deaths are counted, from any thread
imm deaths Atomic[u64];

fn @initpure init() {
  deaths = Atomic[u64].of(0u64);
}

struct Counted {
  pub n u64;
  fn final(self &uni) {
    deaths.add(1u64);
  }
}

// Send 20000 counted values: how many were refused
fn produceCounted(tx SoloSender[Counted]) u64 {
  mut t = tx;
  mut refused = 0u64;
  mut k = 1u64;
  while k <= 20000u64 {
    match t.send(new Counted(k)) {
      case is Some[Counted] {refused = refused + 1u64;}
      case is None[Counted] {}
    }
    k = k + 1u64;
  }
  refused;
}

fn dropReceiver(rx Receiver[Counted]) {}

fn main() i32 {
  mut items = 0u64;
  mut sum = 0u64;
  mut disorder = 0u64;

  mut tx SoloSender[u64];
  mut rx Receiver[u64];
  tx, rx = Channel[u64].spsc(64u64);
  imm p = thread.start(new Work(tx, 1000000u64, 0u64), &produce);
  items, sum, disorder = takeAll(&mut rx, 0u64);
  expectUInt(p.join(), 1000000u64, "the producer sent its million");
  expectUInt(items, 1000000u64, "all arrived");
  expectUInt(sum, 500000500000u64, "their sum");
  expectUInt(disorder, 0u64, "in order");

  mut tx1 SoloSender[u64];
  mut rx1 Receiver[u64];
  tx1, rx1 = Channel[u64].spsc(1u64);
  imm p1 = thread.start(new Work(tx1, 200000u64, 0u64), &produce);
  items, sum, disorder = takeAll(&mut rx1, 0u64);
  p1.join();
  expectUInt(items, 200000u64, "through a channel of 1, all arrived");
  expectUInt(sum, 20000100000u64, "their sum");
  expectUInt(disorder, 0u64, "in order");

  mut badRounds = 0u64;
  mut round = 0u64;
  while round < 3000u64 {
    mut txr SoloSender[u64];
    mut rxr Receiver[u64];
    txr, rxr = Channel[u64].spsc(2u64);
    imm n = 300u64 + 100u64 * (round % 4u64);
    imm pr = thread.start(new Work(txr, n, round), &produce);
    items, sum, disorder = takeAll(&mut rxr, round);
    pr.join();
    if items != n or sum != n * (n + 1u64) / 2u64 or disorder != 0u64 {
      badRounds = badRounds + 1u64;
    }
    round = round + 1u64;
  }
  expectUInt(badRounds, 0u64, "3000 rounds of unequal timing, each whole and in order");

  mut late = 0u64;
  mut unaccounted = 0u64;
  mut refusedAll = 0u64;
  round = 0u64;
  while round < 2000u64 {
    mut txc SoloSender[Big];
    mut rxc Receiver[Big];
    txc, rxc = Channel[Big].spsc(4u64);
    imm pc = thread.start(txc, &produceRefused);
    mut taken = 0u64;
    while taken < round % 40u64 {
      match rxc.recv() {
        case is Some[Big] {taken = taken + 1u64;}
        case is None[Big] {}
      }
    }
    rxc.close();
    mut more = true;
    while more {
      match rxc.recv() {
        case is Some[Big] {taken = taken + 1u64;}
        case is None[Big] {more = false;}
      }
    }
    imm back = pc.join();
    match rxc.tryRecv() {
      case is Some[Big] {late = late + 1u64;}
      case is None[Big] {}
    }
    if taken + back != 1000u64 {
      unaccounted = unaccounted + 1u64;
    }
    refusedAll = refusedAll + back;
    round = round + 1u64;
  }
  expectUInt(late, 0u64, "2000 closes racing a send: nothing arrived after recv's None");
  expectUInt(unaccounted, 0u64, "every value taken or handed back");
  expect(refusedAll > 0u64, "and the closes did refuse sends");

  mut run = 0u32;
  mut wrongDeaths = 0u32;
  mut wrongLetIn = 0u32;
  while run < 5u32 {
    deaths.store(0u64);
    mut txd SoloSender[Counted];
    mut rxd Receiver[Counted];
    txd, rxd = Channel[Counted].spsc(16u64);
    imm pd = thread.start(txd, &produceCounted);
    mut taken = 0u64;
    while taken < 1000u64 {
      match rxd.recv() {
        case is Some[Counted] {taken = taken + 1u64;}
        case is None[Counted] {}
      }
    }
    dropReceiver(rxd);
    imm letIn = 20000u64 - pd.join();
    if deaths.load() != 20000u64 {
      wrongDeaths = wrongDeaths + 1u32;
    }
    if letIn < 1000u64 or letIn > 1016u64 {
      wrongLetIn = wrongLetIn + 1u32;
    }
    run = run + 1u32;
  }
  expectUInt(u64.from(wrongDeaths), 0u64, "5 receivers gone mid-stream: every value died exactly once");
  expectUInt(u64.from(wrongLetIn), 0u64, "and the values let in were those taken and at most a ring more");
  done();
}
