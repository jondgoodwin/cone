// An ordering an operation cannot have, given to its 'Ordered' form, is known
// only as the program runs, so it ends the program: a message on stderr, then
// the C library's 'abort'. Its .exit is the status the Microsoft C library's
// 'abort' ends a program with, 0xC0000409 (stderr, unchecked here, says:
// sync: loadOrdered given Release or AcqRel, which a load cannot have). What
// the program printed before is kept: the message flushes stdout first.

mod badorder;

import stdio use *;
import sync use *;

fn main() {
  imm a = Atomic[u32].of(1u32);
  mut order MemOrder = MemOrder.Acquire[];
  printStr("an Acquire load is allowed\n");
  a.loadOrdered(order);
  order = MemOrder.Release[];
  printStr("a Release load is not\n");
  a.loadOrdered(order);
  printStr("never printed\n");
}
