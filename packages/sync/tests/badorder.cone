// An ordering an operation cannot have, given to its 'Ordered' form, is known
// only as the program runs, so it is a panic. Its .exit is a panic's, the
// status the Microsoft C library's 'abort' ends a program with, 0xC0000409.
// Its stderr, unchecked here since it names a line of sync.cone, which moves
// as sync.cone changes, says: panic at sync.cone:<line>: sync: loadOrdered
// given Release or AcqRel, which a load cannot have. What the program printed
// before is kept: a panic flushes stdout first.

mod badorder;

import stdio use *;
import sync use *;

fn main() {
  imm a = Atomic[u32].of(1u32);
  mut order MemOrder = MemOrder.Acquire[];
  printStr("an Acquire load is allowed\n");
  a.loadOrdered(order);
  order = MemOrder.Release[];
  printStr("a Release load is not\n");
  a.loadOrdered(order);
  printStr("never printed\n");
}
