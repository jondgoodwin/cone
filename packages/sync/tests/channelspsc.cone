// A single-sender channel, Channel[T].spsc(n), on one thread: what each
// operation answers, and where each value goes. The capacity is rounded as a
// bounded channel's is (5 holds 8, 1000 holds 1024, 0 holds 1); 'trySend' on
// a full channel hands its value back, and succeeds again once a value is
// taken; 'sendTimeout' on a full channel waits its time and then hands its
// value back; values come out in the order they went in, across the ring's
// end many times over; a close refuses every kind of send without waiting,
// while what was sent before still comes out; the sender's going closes it;
// and values whose deaths are counted, by value and as 'So' owners, die
// exactly once: with the Option 'recv' answered, with the Option a refused
// send answered, or, never received, when the receiver dies -- with the
// channel full, too. A Receiver[T] from spsc is the same type as one from
// make or bounded.

mod channelspsc;

import testing use *;
import sync use *;
import time use Duration, Instant;

// A value whose deaths are counted
mut deaths u64 = 0u64;

struct Counted {
  pub n u64;
  fn final(self &uni) {
    deaths = deaths + 1u64;
  }
}

// The value an Option holds, or 0 for None: what recv answered, or what a
// send handed back (0 when it was sent)
fn got(o Option[u64]) u64 {
  match o {
    case imm s Some {s;}
    case is None[u64] {0u64;}
  }
}

fn gotCounted(o Option[Counted]) u64 {
  match o {
    case imm s Some {s.n;}
    case is None[Counted] {0u64;}
  }
}

fn gotOwned(o Option[So[Counted]]) u64 {
  match o {
    case imm s Some {s.n;}
    case is None[So[Counted]] {0u64;}
  }
}

fn dropSender(tx SoloSender[u64]) {}
fn dropReceiver(rx Receiver[Counted]) {}

// How many of 1, 2, 3, ... trySend puts in before one is handed back
fn fill(tx &mut SoloSender[u64]) u64 {
  mut n = 0u64;
  while got(tx.trySend(n + 1u64)) == 0u64 {
    n = n + 1u64;
  }
  n;
}

// Takes any Receiver[u64], whichever kind made it: how many it holds now
fn count(rx &mut Receiver[u64]) u64 {
  mut n = 0u64;
  while got(rx.tryRecv()) != 0u64 {
    n = n + 1u64;
  }
  n;
}

fn capacity() {
  mut tx SoloSender[u64];
  mut rx Receiver[u64];
  tx, rx = Channel[u64].spsc(5u64);
  expectUInt(fill(&mut tx), 8u64, "5 is rounded up to 8");
  expectUInt(got(tx.trySend(9u64)), 9u64, "trySend on a full channel hands its value back");
  expectUInt(got(rx.recv()), 1u64, "the first in comes out first");
  expectUInt(got(tx.trySend(10u64)), 0u64, "a value taken makes room for one more");
  expectUInt(got(tx.trySend(11u64)), 11u64, "and just one");
  mut sum = 0u64;
  mut i = 0u64;
  while i < 8u64 {
    sum = sum + got(rx.recv());
    i = i + 1u64;
  }
  // 2 + 3 + ... + 8, then 10
  expectUInt(sum, 45u64, "the rest, 2 to 8 and 10");
  expectUInt(got(rx.tryRecv()), 0u64, "and then it is empty");

  mut tx0 SoloSender[u64];
  mut rx0 Receiver[u64];
  tx0, rx0 = Channel[u64].spsc(0u64);
  expectUInt(fill(&mut tx0), 1u64, "0 is taken as 1");
  mut tx1 SoloSender[u64];
  mut rx1 Receiver[u64];
  tx1, rx1 = Channel[u64].spsc(1u64);
  expectUInt(fill(&mut tx1), 1u64, "1 holds 1");
  mut tx8 SoloSender[u64];
  mut rx8 Receiver[u64];
  tx8, rx8 = Channel[u64].spsc(8u64);
  expectUInt(fill(&mut tx8), 8u64, "8, a power of two, holds 8");
  mut txk SoloSender[u64];
  mut rxk Receiver[u64];
  txk, rxk = Channel[u64].spsc(1000u64);
  expectUInt(fill(&mut txk), 1024u64, "1000 is rounded up to 1024");
  expectUInt(count(&mut rxk), 1024u64, "a function taking any Receiver[u64] takes this one");
}

// Rounds of 2, 3, 4 and 1 values through a ring of 4, 100 rounds, each
// received before the next: 250 values, the ring's end passed 62 times, at
// each point of it. Each value is checked against the next number expected.
fn order() {
  mut tx SoloSender[u64];
  mut rx Receiver[u64];
  tx, rx = Channel[u64].spsc(4u64);
  mut next = 1u64;
  mut want = 1u64;
  mut wrong = 0u64;
  mut sum = 0u64;
  mut round = 1u64;
  while round <= 100u64 {
    imm n = round % 4u64 + 1u64;
    mut i = 0u64;
    while i < n {
      if i % 2u64 == 0u64 {
        tx.send(next);
      } else {
        tx <- next;
      }
      next = next + 1u64;
      i = i + 1u64;
    }
    i = 0u64;
    while i < n {
      imm v = got(rx.recv());
      if v != want {
        wrong = wrong + 1u64;
      }
      sum = sum + v;
      want = want + 1u64;
      i = i + 1u64;
    }
    round = round + 1u64;
  }
  expectUInt(want - 1u64, 250u64, "values through in rounds");
  expectUInt(wrong, 0u64, "each in its place");
  // 1 + 2 + ... + 250
  expectUInt(sum, 31375u64, "their sum");
  expectUInt(got(rx.tryRecv()), 0u64, "and none left");
}

fn timeouts() {
  mut tx SoloSender[u64];
  mut rx Receiver[u64];
  tx, rx = Channel[u64].spsc(2u64);
  tx <- (1u64, 2u64);
  imm start = Instant.now();
  expectUInt(got(tx.sendTimeout(3u64, Duration.fromMillis(30))), 3u64, "sendTimeout on a full channel hands its value back");
  expect(start.elapsed() >= Duration.fromMillis(30), "after waiting at least the 30 ms");
  expectUInt(got(rx.recv()), 1u64, "the values before are still there");
  expectUInt(got(tx.sendTimeout(4u64, Duration.fromMillis(30))), 0u64, "with room, sendTimeout sends at once");
  expectUInt(got(rx.recv()), 2u64, "in order");
  expectUInt(got(rx.recv()), 4u64, "the timed send's value after them");
  imm start2 = Instant.now();
  expectUInt(got(rx.recvTimeout(Duration.fromMillis(30))), 0u64, "recvTimeout on an empty channel is None");
  expect(start2.elapsed() >= Duration.fromMillis(30), "after waiting at least the 30 ms");
  expectBool(rx.isClosed(), false, "and it is still open");
  dropSender(tx);
  expectBool(rx.isClosed(), true, "the sender's going closes it");
  // An hour: a closed channel answers at once, and a wait would time the test out
  expectUInt(got(rx.recvTimeout(Duration.fromHours(1))), 0u64, "a closed, empty channel answers None");
}

fn closing() {
  mut tx SoloSender[u64];
  mut rx Receiver[u64];
  tx, rx = Channel[u64].spsc(2u64);
  tx <- (7u64, 8u64);
  rx.close();
  expectBool(rx.isClosed(), true, "close closes it");
  expectUInt(got(tx.trySend(9u64)), 9u64, "trySend after close gets its value back");
  expectUInt(got(tx.send(10u64)), 10u64, "and send, without waiting, full as it is");
  expectUInt(got(tx.sendTimeout(11u64, Duration.fromHours(1))), 11u64, "and sendTimeout");
  expectUInt(got((tx <- 12u64)), 12u64, "and '<-'");
  expectUInt(got(rx.recv()), 7u64, "what came before the close still comes out");
  expectUInt(got(rx.recv()), 8u64, "all of it");
  expectUInt(got(rx.recv()), 0u64, "then recv answers None, without waiting");
  expectUInt(got(tx.send(13u64)), 13u64, "and a send with room is refused too");
  expectUInt(got(rx.tryRecv()), 0u64, "so nothing more comes");

  // The sender's going closes it; what it sent before still comes out
  mut tx1 SoloSender[u64];
  mut rx1 Receiver[u64];
  tx1, rx1 = Channel[u64].spsc(4u64);
  tx1 <- 13u64;
  tx1.send(14u64);
  expectBool(rx1.isClosed(), false, "open while the sender lives");
  dropSender(tx1);
  expectBool(rx1.isClosed(), true, "closed when it goes");
  expectUInt(got(rx1.recv()), 13u64, "then drained");
  expectUInt(got(rx1.recv()), 14u64, "in order");
  expectUInt(got(rx1.tryRecv()), 0u64, "and then None");
  expectUInt(got(rx1.recv()), 0u64, "recv too, without waiting");
}

// Values that count their deaths, by value and owned
fn finalizing() {
  deaths = 0u64;
  {
    mut tx SoloSender[Counted];
    mut rx Receiver[Counted];
    tx, rx = Channel[Counted].spsc(64u64);
    mut i = 1u64;
    while i <= 50u64 {
      tx <- new Counted(i);
      i = i + 1u64;
    }
    expectUInt(deaths, 0u64, "a value sent is not finalized");
    mut sum = 0u64;
    i = 0u64;
    while i < 20u64 {
      sum = sum + gotCounted(rx.recv());
      i = i + 1u64;
    }
    expectUInt(sum, 210u64, "20 received, 1 to 20");
    expectUInt(deaths, 20u64, "each dies with the Option it came in");
    dropReceiver(rx);
    expectUInt(deaths, 50u64, "the receiver's death finalizes the 30 never received, once each");
    expectUInt(gotCounted(tx.send(new Counted(51u64))), 51u64, "a send after the receiver went gets its value back");
    expectUInt(deaths, 51u64, "which died with the Option handing it back");
  }
  expectUInt(deaths, 51u64, "the sender's death finalizes nothing more");

  // Full when the receiver goes: a trySend refused as full, then 4 finalized
  deaths = 0u64;
  {
    mut tx SoloSender[Counted];
    mut rx Receiver[Counted];
    tx, rx = Channel[Counted].spsc(4u64);
    mut i = 1u64;
    while i <= 4u64 {
      tx.send(new Counted(i));
      i = i + 1u64;
    }
    expectUInt(gotCounted(tx.trySend(new Counted(5u64))), 5u64, "full: the fifth is handed back");
    expectUInt(deaths, 1u64, "and dies with its Option");
    dropReceiver(rx);
    expectUInt(deaths, 5u64, "the four in the full ring are finalized when the receiver goes");
    expectUInt(gotCounted(tx.send(new Counted(6u64))), 6u64, "a send to the full ring after it went is handed back, not left waiting");
    expectUInt(deaths, 6u64, "and dies with its Option");
  }

  // Around the ring's end: 3 taken of 6 sent through a ring of 4, so the 3
  // left sit in slots 3, 0 and 1
  deaths = 0u64;
  {
    mut tx SoloSender[Counted];
    mut rx Receiver[Counted];
    tx, rx = Channel[Counted].spsc(4u64);
    tx <- (new Counted(1u64), new Counted(2u64), new Counted(3u64));
    mut sum = gotCounted(rx.recv()) + gotCounted(rx.recv());
    tx <- (new Counted(4u64), new Counted(5u64), new Counted(6u64));
    sum = sum + gotCounted(rx.recv());
    expectUInt(sum, 6u64, "1, 2 and 3 taken");
    expectUInt(deaths, 3u64, "and finalized with their Options");
  }
  expectUInt(deaths, 6u64, "the 3 left across the ring's end are finalized once each");

  deaths = 0u64;
  {
    mut tx SoloSender[So[Counted]];
    mut rx Receiver[So[Counted]];
    tx, rx = Channel[So[Counted]].spsc(16u64);
    mut i = 1u64;
    while i <= 12u64 {
      tx.send(new So[Counted](i));
      i = i + 1u64;
    }
    expectUInt(gotOwned(rx.recv()), 1u64, "an owned value moves through");
    expectUInt(gotOwned(rx.tryRecv()), 2u64, "and another");
    expectUInt(deaths, 2u64, "each freed with its Option");
  }
  // Both ends died at the block's end, the receiver with 10 still in it
  expectUInt(deaths, 12u64, "the 10 never received are finalized when the receiver goes");
}

fn main() i32 {
  capacity();
  order();
  timeouts();
  closing();
  finalizing();
  done();
}
