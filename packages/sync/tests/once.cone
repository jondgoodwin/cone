// Once. Four threads, let through a starting gate together, each call
// callOnce on one Once whose function counts its runs, sleeps 10 ms (so the
// others arrive while it runs, and must wait) and then sets a global (an atomic used relaxed,
// so only the Once orders it).
// Each thread then reads the global: all four see what the function set, and
// it ran exactly once. Run 25 times, each with a fresh Once. Then
// callOnceWith hands its function a value, and a second call on the same
// Once runs nothing; isCompleted says whether the function has run. An owned
// value handed to a call that runs nothing is dropped there.

mod once;

import testing use *;
import thread;
import sync use *;
import time use Duration;

// Reset for each run: nothing else touches it then
imm value Atomic[u64];

imm runs Atomic[u32];
imm ready Atomic[u32];
imm go Atomic[u32];

fn @initpure init() {
  value = Atomic[u64].of(0u64);
  runs = Atomic[u32].of(0u32);
  ready = Atomic[u32].of(0u32);
  go = Atomic[u32].of(0u32);
}

// value is read and written relaxed, with no ordering of its own: what makes the
// function's write visible to the callers is the Once
fn getValue() u64 {
  value.loadOrdered(MemOrder.Relaxed);
}

fn setValue(v u64) {
  value.storeOrdered(v, MemOrder.Relaxed);
}

fn setUp() {
  runs.add(1u32);
  thread.sleep(Duration.fromMillis(10));
  setValue(42u64);
}

// Call once, then answer what the function set
fn racer(setUpOnce Arc[imm, Once]) u64 {
  ready.add(1u32);
  while go.load() == 0u32 {
    sync.futexWait(&go, 0u32);
  }
  setUpOnce.callOnce(&setUp);
  getValue();
}

// One race: whether the function ran once and all four saw what it did
fn race() bool {
  // A fresh Once for each run, held by an Arc that each thread is handed a copy of
  imm setUpOnce = new Arc[imm, Once](Once.make());
  setValue(0u64);
  runs.store(0u32);
  ready.store(0u32);
  go.store(0u32);
  imm a = thread.start(setUpOnce, &racer);
  imm b = thread.start(setUpOnce, &racer);
  imm c = thread.start(setUpOnce, &racer);
  imm d = thread.start(setUpOnce, &racer);
  while ready.load() < 4u32 { thread.yieldNow(); }
  go.store(1u32);
  sync.futexWakeAll(&go);
  imm seen = a.join() + b.join() + c.join() + d.join();
  seen == 4u64 * 42u64 and runs.load() == 1u32 and setUpOnce.isCompleted();
}

fn addTo(n u64) {
  setValue(getValue() + n);
}

// An owned value whose death is counted
mut @threadlocal deaths u32 = 0u32;

struct CountedValue {
  pub n u64;
  fn final(self &uni) {
    deaths = deaths + 1u32;
  }
}
alias Counted = So[CountedValue];

fn addCounted(c Counted) {
  setValue(getValue() + c.n);
}

fn main() i32 {
  initAll();
  mut good = 0u64;
  mut run = 0;
  while run < 25 {
    if race() { good = good + 1u64; }
    run = run + 1;
  }
  expectUInt(good, 25u64, "races where the function ran once and every caller saw it");

  // callOnceWith, and the calls after the first
  imm o = Once.make();
  setValue(0u64);
  expect(!o.isCompleted(), "a new Once has not run");
  o.callOnceWith(5u64, &addTo);
  expectUInt(getValue(), 5u64, "callOnceWith handed its function the value");
  expect(o.isCompleted(), "and has run");
  o.callOnceWith(7u64, &addTo);
  o.callOnce(&setUp);
  expectUInt(getValue(), 5u64, "later calls on the same Once run nothing");

  // An owned value is moved in: used and dropped by the call that runs the
  // function, dropped unused by a call that does not
  imm p = Once.make();
  p.callOnceWith(new Counted(3u64), &addCounted);
  expectUInt(getValue(), 8u64, "the owned value reached the function");
  expectUInt(u64.from(deaths), 1u64, "and died there");
  p.callOnceWith(new Counted(4u64), &addCounted);
  expectUInt(getValue(), 8u64, "the second call ran nothing");
  expectUInt(u64.from(deaths), 2u64, "and dropped its value unused");

  // A closure is run the same way: it changes a variable it borrows, and a
  // second call on the same Once runs nothing
  imm q = Once.make();
  mut hits = 0u64;
  imm step = 7u64;
  q.callOnce(fn() { hits = hits + step; });
  q.callOnce(fn() { hits = hits + step; });
  expectUInt(hits, 7u64, "a closure changed what it borrowed, once");

  // callOnceWith hands a closure its value; the closure keeps its own state
  imm r = Once.make();
  mut seen = 0u64;
  r.callOnceWith(9u64, fn(a u64) [bonus = 100u64] { seen = a + bonus; });
  r.callOnceWith(1u64, fn(a u64) [bonus = 100u64] { seen = a + bonus; });
  expectUInt(seen, 109u64, "callOnceWith handed a closure the value and its own state");

  // A closure held in a variable is lent as a reference
  imm s = Once.make();
  mut count = 0u64;
  mut bump = fn() { count = count + 1u64; };
  s.callOnce(&mut bump);
  s.callOnce(&mut bump);
  expectUInt(count, 1u64, "a closure held in a variable, lent as a reference");
  done();
}
