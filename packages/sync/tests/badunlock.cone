// Unlocking a Mutex that nothing holds is caught where it is cheap to catch:
// the unlock swaps in 'unlocked' and sees that it already was, so it ends the
// program, as sync's other program errors do: a message on stderr, then the
// C library's 'abort'. Its .exit is the status the Microsoft C library's
// 'abort' ends a program with, 0xC0000409 (stderr, unchecked here, says:
// sync: Mutex.unlock of a Mutex that is not locked). What the program printed
// before is kept: the message flushes stdout first.

mod badunlock;

import stdio use *;
import sync use *;

fn main() {
  imm m = Mutex.make();
  m.lock();
  m.unlock();
  printStr("a lock and its unlock are fine\n");
  m.unlock();
  printStr("never printed\n");
}
