// The four locks together. Main puts 1000 jobs on a queue and closes it; four
// worker threads take jobs off it until it is closed and empty, sleeping on a
// Condvar while it is empty. Each job looks up a table of squares, which the
// first worker to need it builds, through a Once, and a scale, which the
// workers read under an Rwlock's read lock while main may change it under
// the write lock; each result goes on a List under a Mutex. Main prints the
// totals, which are the same on every run:
//
//   congo run packages/sync/examples/workqueue.cone
//
//   jobs     1000
//   results  1000
//   sum      231060
//   table built 1 time
//
// (Job j's result is (j % 16)^2 times the scale, 3: the squares of 0 to 15
// sum to 1240, and 1000 jobs are 62 rounds of 16 and the first 8 again, so
// 3 * (62 * 1240 + 140) = 231060.)
//
// The table, the scale and the results each live in an Arc whose Mutex or
// Rwlock the compiler takes for every borrow, so nothing reaches them
// unlocked; main hands them to each worker. The queue's three globals stay
// plain, touched only under queueLock: a Condvar waits on a plain Mutex
// only, and the queue is slept on, so it cannot be an Arc[Mutex, T] (a
// lock permission's lock is in the allocation's header, which a Condvar
// cannot be given).

mod workqueue;

import stdio use *;
import collections use *;
import thread;
import sync use *;

// The queue: jobs, the next one to take, and whether more will come, all
// guarded by queueLock; 'queueReady' is notified when a job arrives or the
// queue closes
let queueLock: Mutex;
let queueReady: Condvar;
var jobs: List[u64];
var nextJob: usize = 0usize;
var closed: bool = false;

// The table of squares, built once, under the Once; read under a read lock
struct Table {pub sq: Array[u64, 16];}
alias Squares = Arc[Rwlock, Table];
let tableOnce: Once;
let builds: Atomic[u32];

// The scale, read by the workers under a read lock while main may change it
// under the write lock
struct Scale {pub v: u64;}
alias Scaling = Arc[Rwlock, Scale];

// The results
struct Results {pub list: List[u64];}
alias Collected = Arc[Mutex, Results];

// What a worker is given
struct Work {
  pub table: Squares;
  pub scale: Scaling;
  pub results: Collected;
}

fn @initpure init() {
  queueLock = Mutex.make();
  queueReady = Condvar.make();
  jobs = List[u64]();
  tableOnce = Once.make();
  builds = Atomic[u32].of(0u32);
}

fn buildTable(table: Squares) {
  builds.add(1u32);
  let t = &mut *table;
  var i = 0u64;
  while i < 16u64 {
    t.sq[i] = i * i;
    i = i + 1u64;
  }
}

// The next job, or false once the queue is closed and empty
fn takeJob() u64, bool {
  queueLock.lock();
  while nextJob == jobs.len() && !closed {
    queueReady.condWait(&queueLock);
  }
  if nextJob == jobs.len() {
    queueLock.unlock();
    return 0u64, false;
  }
  let j = *jobs[nextJob];
  nextJob = nextJob + 1usize;
  queueLock.unlock();
  j, true
}

// Take jobs until there are none: how many this worker did
fn worker(w: Work) u32 {
  var done = 0u32;
  var j = 0u64;
  var more = true;
  j, more = takeJob();
  while more {
    tableOnce.callOnceWith(w.table, &buildTable);
    let r = (&*w.table).sq[j % 16u64] * (&*w.scale).v;
    (&mut *w.results).list.push(r);
    done = done + 1u32;
    j, more = takeJob();
  }
  done
}

fn main() {
  initAll();
  let table = Squares(Table(Array[u64, 16]() <- fill 0u64));
  let scale = Scaling(Scale(1u64));
  let results = Collected(Results(List[u64]()));
  (&mut *scale).v = 3u64;

  let a = thread.start(Work(table, scale, results), &worker);
  let b = thread.start(Work(table, scale, results), &worker);
  let c = thread.start(Work(table, scale, results), &worker);
  let d = thread.start(Work(table, scale, results), &worker);

  var j = 0u64;
  while j < 1000u64 {
    queueLock.lock();
    jobs.push(j);
    queueReady.notifyOne();
    queueLock.unlock();
    j = j + 1u64;
  }
  queueLock.lock();
  closed = true;
  queueReady.notifyAll();
  queueLock.unlock();

  let did = a.join() + b.join() + c.join() + d.join();
  var sum = 0u64;
  var i = 0usize;
  let all = &*results;
  while i < all.list.len() {
    sum = sum + *all.list[i];
    i = i + 1usize;
  }
  printStr("jobs     ");
  printInt(i64.from(did));
  printStr("\nresults  ");
  printInt(i64.from(all.list.len()));
  printStr("\nsum      ");
  printInt(i64.from(sum));
  printStr("\ntable built ");
  printInt(i64.from(builds.load()));
  printStr(" time\n");
}
