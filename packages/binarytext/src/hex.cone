// ======== Hex (RFC 4648 section 8, "base16") ========
//
// Two digits to a byte, '0'-'9' and 'a'-'f' (or 'A'-'F'). Encoding writes
// lower case or upper; decoding takes both, mixed if need be. See the
// package's header for the choices.

// The digit of a 4-bit value
fn nibbleChar(n u32, upper bool) u8 {
  if n < 10u32 { return '0' + u8.from(n); }
  if upper { return 'A' + u8.from(n - 10u32); }
  'a' + u8.from(n - 10u32);
}

// The value of a hex digit in either case, or -1
fn nibbleValue(c u8) i32 {
  if c >= '0' and c <= '9' { return i32.from(c - '0'); }
  if c >= 'a' and c <= 'f' { return i32.from(c - 'a') + 10i32; }
  if c >= 'A' and c <= 'F' { return i32.from(c - 'A') + 10i32; }
  -1i32;
}

// -------- encoding --------

// Appends the hex text of data to out, lower case or upper
pub fn appendHex(out &mut String, data &Array[u8], upper bool) {
  mut i = 0usize;
  while i < data.len {
    imm b = u32.from(data[i]);
    out.appendByte(nibbleChar(b >> 4u32, upper));
    out.appendByte(nibbleChar(b & 15u32, upper));
    i = i + 1usize;
  }
}

// The lower-case hex text of data
pub fn encodeHex(data &Array[u8]) String {
  mut out = String.withCapacity(data.len * 2usize);
  appendHex(&mut out, data, false);
  out;
}

// The upper-case hex text of data
pub fn encodeHexUpper(data &Array[u8]) String {
  mut out = String.withCapacity(data.len * 2usize);
  appendHex(&mut out, data, true);
  out;
}

// A streaming hex encoder. Hex keeps nothing between chunks (a byte is two
// digits, written together), so any split is the same text; the type is here so
// that code written against an encoder and a decoder of each format reads the
// same.
pub struct HexEncoder {
  upper bool;

  // Lower case
  pub fn lower() HexEncoder { new HexEncoder(false); }

  // Upper case
  pub fn upperCase() HexEncoder { new HexEncoder(true); }

  // Appends the digits of chunk
  pub fn update(self &mut, chunk &Array[u8], out &mut String) {
    appendHex(out, chunk, self.upper);
  }

  // Nothing is held back: appends nothing
  pub fn finish(self &mut, out &mut String) { }
}

// -------- decoding --------

// A streaming hex decoder: feed it chunks of text split anywhere, and it
// appends a byte for each pair of digits, holding the first digit of a pair
// that a chunk ends in the middle of. 'finish' refuses a last lone digit and
// readies the decoder for the next text. Once a call has failed, every later
// one answers the same error until 'reset()'.
pub struct HexDecoder {
  skipWhitespace bool;
  // The first digit of a pair, when only it has been read
  high u32;
  hasHigh bool;
  offset usize;
  failed bool;
  failKind DecodeErrorKind;
  failOffset usize;
  failByte u8;
  failReason String;

  // Strict: only digits
  pub fn strict() HexDecoder {
    new HexDecoder(false, 0u32, false, 0usize, false, DecodeErrorKind.BadCharacter, 0usize, 0u8, String.empty());
  }

  // A space, tab, carriage return or line feed is passed over, anywhere
  pub fn skippingWhitespace() HexDecoder {
    new HexDecoder(true, 0u32, false, 0usize, false, DecodeErrorKind.BadCharacter, 0usize, 0u8, String.empty());
  }

  // Forget the text so far and any failure, to read a new text
  pub fn reset(self &mut) {
    self.high = 0u32;
    self.hasHigh = false;
    self.offset = 0usize;
    self.failed = false;
    self.failKind = DecodeErrorKind.BadCharacter;
    self.failOffset = 0usize;
    self.failByte = 0u8;
    self.failReason = String.empty();
  }

  // Bytes of text read since the start of this text
  pub fn consumed(self &) usize { offset; }

  fn fail(self &mut, kind DecodeErrorKind, at usize, byte u8, why &str) DecodeError {
    mut reason = String.empty();
    if byte != 0u8 {
      describeByte(&mut reason, byte);
      reason.append(" ");
    }
    reason.append(why);
    self.failed = true;
    self.failKind = kind.copy();
    self.failOffset = at;
    self.failByte = byte;
    self.failReason = reason.copy();
    new DecodeError(kind, at, byte, reason);
  }

  fn failure(self &) DecodeError {
    new DecodeError(self.failKind.copy(), failOffset, failByte, failReason.copy());
  }

  // Reads a chunk of text, appending a byte for each pair of digits it
  // completes. Answers how many bytes it appended, or the first fault (bytes
  // appended before it stay)
  pub fn update(self &mut, chunk &Array[u8], out &mut List[u8]) Result[usize, DecodeError] {
    if self.failed { return Error[usize, DecodeError](self.failure()); }
    imm start = out.len();
    mut i = 0usize;
    while i < chunk.len {
      imm c = chunk[i];
      imm at = self.offset;
      self.offset = self.offset + 1usize;
      i = i + 1usize;
      if self.skipWhitespace and isSpace(c) { continue; }
      imm v = nibbleValue(c);
      if v < 0i32 {
        return Error[usize, DecodeError](self.fail(DecodeErrorKind.BadCharacter, at, c, "is not a hex digit"));
      }
      if self.hasHigh {
        out.push(u8.from(self.high * 16u32 + u32.from(v)));
        self.hasHigh = false;
      } else {
        self.high = u32.from(v);
        self.hasHigh = true;
      }
    }
    Ok[usize, DecodeError](out.len() - start);
  }

  // The end of the text: a digit left without its pair is refused. Readies
  // the decoder for the next text (a failure stays until 'reset()'). Answers
  // how many bytes it appended, always 0 on success
  pub fn finish(self &mut, out &mut List[u8]) Result[usize, DecodeError] {
    if self.failed { return Error[usize, DecodeError](self.failure()); }
    if self.hasHigh {
      return Error[usize, DecodeError](self.fail(DecodeErrorKind.BadLength, self.offset, 0u8,
        "the text ends after half a byte: hex needs an even number of digits"));
    }
    self.reset();
    Ok[usize, DecodeError](0usize);
  }
}

// -------- one-shot decoding --------

fn decodeHexAs(text &Array[u8], dec &mut HexDecoder, out &mut List[u8]) Result[usize, DecodeError] {
  imm start = out.len();
  match dec.update(text, out) {
    case imm e Error {
      out.truncate(start);
      return Error[usize, DecodeError](e.copy());
    }
    case is Ok { }
  }
  match dec.finish(out) {
    case imm e Error {
      out.truncate(start);
      return Error[usize, DecodeError](e.copy());
    }
    case is Ok { }
  }
  Ok[usize, DecodeError](out.len() - start);
}

// Decodes strict hex text, appending the bytes to out. Answers how many; on a
// fault, out is left as it was
pub fn decodeHexInto(text &Array[u8], out &mut List[u8]) Result[usize, DecodeError] {
  mut d = HexDecoder.strict();
  decodeHexAs(text, &mut d, out);
}

// The bytes strict hex text names: digits in either case, an even number of
// them, nothing else
pub fn decodeHex(text &Array[u8]) Result[List[u8], DecodeError] {
  mut out = List[u8].withCapacity(text.len / 2usize + 1usize);
  mut d = HexDecoder.strict();
  match decodeHexAs(text, &mut d, &mut out) {
    case imm e Error { return Error[List[u8], DecodeError](e.copy()); }
    case is Ok { }
  }
  Ok[List[u8], DecodeError](out);
}

// 'decodeHex', passing over a space, tab, carriage return and line feed
pub fn decodeHexSkippingWhitespace(text &Array[u8]) Result[List[u8], DecodeError] {
  mut out = List[u8].withCapacity(text.len / 2usize + 1usize);
  mut d = HexDecoder.skippingWhitespace();
  match decodeHexAs(text, &mut d, &mut out) {
    case imm e Error { return Error[List[u8], DecodeError](e.copy()); }
    case is Ok { }
  }
  Ok[List[u8], DecodeError](out);
}
