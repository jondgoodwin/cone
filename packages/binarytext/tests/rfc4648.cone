// RFC 4648's own test vectors: section 10 (BASE64 and BASE16 of "", "f", "fo",
// "foo", "foob", "fooba", "foobar"), which also stand for base64url because none
// of them reaches a character where the two alphabets differ, and section 9's
// worked example (the bytes 14 fb 9c 03 d9 7e, which do reach '+', and, cut to
// 5 and 4 bytes, show the padding). The base64url vectors with '-' and '_' were
// made by Python's 'base64.urlsafe_b64encode', which this package does not use.
// Each vector is encoded, decoded, and fed through the streaming codecs.

mod rfc4648;

import testing use *;
import collections use *;
import binarytext;

fn show(e &binarytext.DecodeError) String { e.message() }

fn expectBytes(got &List[u8], want &Array[u8], label &str) {
  expectStr(got.view(), want, label);
}

// text decodes (standard, padded, strict) to want, and every other spelling too
fn decodesTo(text &str, want &Array[u8], label &str) {
  match binarytext.decodeBase64(text) {
    case let bytes Ok { expectBytes(&bytes, want, label); }
    case let e Error {
      let m = show(&e);
      expectStr(m.view(), "<decoded>", label);
    }
  }
}

fn b64(plain &str, want &str) {
  let got = binarytext.encodeBase64(plain);
  expectStr(got.view(), want, "base64 encode");
  decodesTo(want, plain, "base64 decode");
  // The URL-safe alphabet agrees where the alphabets agree
  let url = binarytext.encodeBase64Url(plain);
  expectStr(url.view(), want, "base64url encode");
  match binarytext.decodeBase64Url(want) {
    case let bytes Ok { expectBytes(&bytes, plain, "base64url decode"); }
    case let e Error {
      let m = show(&e);
      expectStr(m.view(), "<decoded>", want);
    }
  }
}

fn b16(plain &str, want &str) {
  let upper = binarytext.encodeHexUpper(plain);
  expectStr(upper.view(), want, "base16 encode");
  let lower = binarytext.encodeHex(plain);
  let wantLower = String.from(want);
  var wl = wantLower.copy();
  wl.lowerAscii();
  expectStr(lower.view(), wl.view(), "hex lower encode");
  match binarytext.decodeHex(want) {
    case let bytes Ok { expectBytes(&bytes, plain, "base16 decode"); }
    case let e Error {
      let m = show(&e);
      expectStr(m.view(), "<decoded>", want);
    }
  }
  match binarytext.decodeHex(wl.view()) {
    case let bytes Ok { expectBytes(&bytes, plain, "hex lower decode"); }
    case let e Error {
      let m = show(&e);
      expectStr(m.view(), "<decoded>", want);
    }
  }
}

fn main() i32 {
  // -------- section 10: BASE64 --------
  b64("", "");
  b64("f", "Zg==");
  b64("fo", "Zm8=");
  b64("foo", "Zm9v");
  b64("foob", "Zm9vYg==");
  b64("fooba", "Zm9vYmE=");
  b64("foobar", "Zm9vYmFy");

  // -------- section 10: BASE16 --------
  b16("", "");
  b16("f", "66");
  b16("fo", "666F");
  b16("foo", "666F6F");
  b16("foob", "666F6F62");
  b16("fooba", "666F6F6261");
  b16("foobar", "666F6F626172");

  // -------- section 9: 24 bits are four 6-bit digits --------
  var ex = List[u8].empty();
  ex.push(0x14u8); ex.push(0xfbu8); ex.push(0x9cu8); ex.push(0x03u8); ex.push(0xd9u8); ex.push(0x7eu8);
  let full = binarytext.encodeBase64(ex.view());
  expectStr(full.view(), "FPucA9l+", "section 9, 6 bytes");
  decodesTo("FPucA9l+", ex.view(), "section 9, 6 bytes decode");
  ex.pop();
  let five = binarytext.encodeBase64(ex.view());
  expectStr(five.view(), "FPucA9k=", "section 9, 5 bytes");
  decodesTo("FPucA9k=", ex.view(), "section 9, 5 bytes decode");
  ex.pop();
  let four = binarytext.encodeBase64(ex.view());
  expectStr(four.view(), "FPucAw==", "section 9, 4 bytes");
  decodesTo("FPucAw==", ex.view(), "section 9, 4 bytes decode");

  // -------- the alphabets differ in two characters --------
  var sym = List[u8].empty();
  sym.push(0xfbu8); sym.push(0xffu8); sym.push(0xfeu8); sym.push(0x3eu8); sym.push(0x3fu8);
  let std = binarytext.encodeBase64(sym.view());
  expectStr(std.view(), "+//+Pj8=", "standard alphabet");
  let url = binarytext.encodeBase64Url(sym.view());
  expectStr(url.view(), "-__-Pj8=", "url-safe alphabet");
  let unpadded = binarytext.encodeBase64With(sym.view(), &binarytext.Base64Format.urlSafeUnpadded());
  expectStr(unpadded.view(), "-__-Pj8", "url-safe, no padding");
  let stdUnpadded = binarytext.encodeBase64With(sym.view(), &binarytext.Base64Format.standardUnpadded());
  expectStr(stdUnpadded.view(), "+//+Pj8", "standard, no padding");
  decodesTo("+//+Pj8=", sym.view(), "standard decode");
  match binarytext.decodeBase64Url("-__-Pj8=") {
    case let bytes Ok { expectBytes(&bytes, sym.view(), "url decode"); }
    case let e Error { let m = show(&e); expectStr(m.view(), "<decoded>", "url decode"); }
  }

  done()
}
