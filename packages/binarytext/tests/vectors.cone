// Longer vectors from an independent source: Python's 'base64.b64encode',
// 'base64.urlsafe_b64encode' and 'bytes.hex', not this package. The bytes are
// every value 0 to 255 in order (which reaches every digit of both alphabets,
// '+' '/' and '-' '_' included), and the first n of 40 bytes of a linear
// congruential sequence (x = x * 1664525 + 1013904223 mod 2^32 from 12345, the
// high byte of each x) for n = 1 to 12 and 40, which show every padding length
// in the middle of other data. Each is encoded and decoded in each form.

mod vectors;

import testing use *;
import collections use *;
import binarytext;

fn lcgBytes(n usize) List[u8] {
  var out = List[u8].empty();
  var x = 12345u32;
  var i = 0usize;
  while i < n {
    x = x * 1664525u32 + 1013904223u32;
    out.push(u8.from(x >> 24u32));
    i = i + 1usize;
  }
  out
}

fn lower(s &str) String {
  var t = String.from(s);
  t.lowerAscii();
  t
}

fn sameBytes(res Result[List[u8], binarytext.DecodeError], want &Array[u8], label &str) {
  match res {
    case let bytes Ok { expect(bytes.view() == want, label); }
    case let e Error {
      let m = e.message();
      expectStr(m.view(), "<decoded>", label);
    }
  }
}

// data in each form: standard padded, URL-safe without padding, upper-case hex
fn check(data &Array[u8], std &str, urlUnpadded &str, hexUpper &str) {
  let fmtUrl = binarytext.Base64Format.urlSafeUnpadded();
  let fmtUrlPadded = binarytext.Base64Format.urlSafe();
  let hexLower = lower(hexUpper);

  let e1 = binarytext.encodeBase64(data);
  expectStr(e1.view(), std, "standard padded encode");
  let e2 = binarytext.encodeBase64With(data, &fmtUrl);
  expectStr(e2.view(), urlUnpadded, "url-safe unpadded encode");
  let e3 = binarytext.encodeHexUpper(data);
  expectStr(e3.view(), hexUpper, "upper hex encode");
  let e4 = binarytext.encodeHex(data);
  expectStr(e4.view(), hexLower.view(), "lower hex encode");

  sameBytes(binarytext.decodeBase64(std), data, "standard padded decode");
  sameBytes(binarytext.decodeBase64With(urlUnpadded, &fmtUrl), data, "url-safe unpadded decode");
  sameBytes(binarytext.decodeHex(hexUpper), data, "upper hex decode");
  sameBytes(binarytext.decodeHex(hexLower.view()), data, "lower hex decode");

  // The padded URL-safe text is the unpadded one with the '=' put back
  var padded = String.from(urlUnpadded);
  while padded.len() % 4usize != 0usize { padded.appendByte('='); }
  let e5 = binarytext.encodeBase64With(data, &fmtUrlPadded);
  expectStr(e5.view(), padded.view(), "url-safe padded encode");
  sameBytes(binarytext.decodeBase64Url(padded.view()), data, "url-safe padded decode");
}

fn main() i32 {
  var all = List[u8].empty();
  var i = 0u32;
  while i < 256u32 { all.push(u8.from(i)); i = i + 1u32; }
  check(all.view(),
    "",
    "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0-P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn-AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6ChoqOkpaanqKmqq6ytrq-wsbKztLW2t7i5uru8vb6_wMHCw8TFxsfIycrLzM3Oz9DR0tPU1dbX2Nna29zd3t_g4eLj5OXm5-jp6uvs7e7v8PHy8_T19vf4-fr7_P3-_w",
    "");

  check(lcgBytes(1usize).view(), "BQ==", "BQ", "05");
  check(lcgBytes(2usize).view(), "BQQ=", "BQQ", "0504");
  check(lcgBytes(3usize).view(), "BQSL", "BQSL", "05048B");
  check(lcgBytes(4usize).view(), "BQSLog==", "BQSLog", "05048BA2");
  check(lcgBytes(5usize).view(), "BQSLoug=", "BQSLoug", "05048BA2E8");
  check(lcgBytes(6usize).view(), "BQSLougc", "BQSLougc", "05048BA2E81C");
  check(lcgBytes(7usize).view(), "BQSLougcfg==", "BQSLougcfg", "05048BA2E81C7E");
  check(lcgBytes(8usize).view(), "BQSLougcfow=", "BQSLougcfow", "05048BA2E81C7E8C");
  check(lcgBytes(9usize).view(), "BQSLougcfoyY", "BQSLougcfoyY", "05048BA2E81C7E8C98");
  check(lcgBytes(10usize).view(), "BQSLougcfoyYyA==", "BQSLougcfoyYyA", "05048BA2E81C7E8C98C8");
  check(lcgBytes(11usize).view(), "BQSLougcfoyYyAo=", "BQSLougcfoyYyAo", "05048BA2E81C7E8C98C80A");
  check(lcgBytes(12usize).view(), "BQSLougcfoyYyAq+", "BQSLougcfoyYyAq-", "05048BA2E81C7E8C98C80ABE");
  check(lcgBytes(40usize).view(),
    "BQSLougcfoyYyAq+9xKzdWX1Z/P+qWx/SWysJxbaTwF2SpL2A8dNUg==",
    "BQSLougcfoyYyAq-9xKzdWX1Z_P-qWx_SWysJxbaTwF2SpL2A8dNUg",
    "05048BA2E81C7E8C98C80ABEF712B37565F567F3FEA96C7F496CAC2716DA4F01764A92F603C74D52");

  done()
}
