// Malformed text is refused, with the kind of fault, its offset in bytes from the
// start of the text (of the whole stream, for a streaming decoder) and the byte
// at fault: a byte outside the alphabet, the other alphabet's characters,
// whitespace, '=' misplaced, doubled, missing or where the format has none, data
// after the padding, a lone last digit, non-zero trailing bits, an odd count of
// hex digits, '0x', a NUL byte, and bytes past 0x7F. Then the opt-ins that
// relax it, and a decoder that has failed.

mod refused;

import testing use *;
import collections use *;
import binarytext;

fn kindName(k &binarytext.DecodeErrorKind) &str {
  match k {
    case is BadCharacter { "BadCharacter"; }
    case is BadPadding { "BadPadding"; }
    case is BadLength { "BadLength"; }
    case is NonCanonical { "NonCanonical"; }
  }
}

// The result is the named fault, at that offset, at that byte (0: at the end)
fn isRefusal(res Result[List[u8], binarytext.DecodeError], kind &str, offset usize, byte u8, label &str) {
  match res {
    case is Ok { expectStr("<decoded>", kind, label); }
    case imm e Error {
      expectStr(kindName(&e.kind), kind, label);
      expectUInt(u64.from(e.offset), u64.from(offset), label);
      expectUInt(u64.from(e.byte), u64.from(byte), label);
      imm m = e.message();
      expect(m.view().startsWith("binarytext: "), label);
      mut at = String.from(" at offset ");
      at.appendUInt(u64.from(offset));
      expect(m.view().endsWith(at.view()), label);
    }
  }
}

fn isBytes(res Result[List[u8], binarytext.DecodeError], want &str, label &str) {
  match res {
    case imm bytes Ok { expectStr(bytes.view(), want, label); }
    case imm e Error {
      imm m = e.message();
      expectStr(m.view(), "<decoded>", label);
    }
  }
}

// The bytes, shown as lower-case hex (for bytes past 0x7F)
fn isHex(res Result[List[u8], binarytext.DecodeError], wantHex &str, label &str) {
  match res {
    case imm bytes Ok {
      imm h = binarytext.encodeHex(bytes.view());
      expectStr(h.view(), wantHex, label);
    }
    case imm e Error {
      imm m = e.message();
      expectStr(m.view(), "<decoded>", label);
    }
  }
}

fn std(text &str) Result[List[u8], binarytext.DecodeError] { binarytext.decodeBase64(text); }

fn fmtd(fmt &binarytext.Base64Format, text &str) Result[List[u8], binarytext.DecodeError] {
  binarytext.decodeBase64With(text, fmt);
}

fn main() i32 {
  // -------- characters --------
  isRefusal(std("Zm9v!"), "BadCharacter", 4usize, '!', "'!' after a group");
  isRefusal(std("!m9v"), "BadCharacter", 0usize, '!', "'!' first");
  isRefusal(std("Zm9v\n"), "BadCharacter", 4usize, '\n', "a line feed is not skipped by default");
  isRefusal(std("Zm 9v"), "BadCharacter", 2usize, ' ', "a space is not skipped by default");
  isRefusal(std(" Zm9v"), "BadCharacter", 0usize, ' ', "a leading space");
  isRefusal(std("Zm9v\r\nYmFy"), "BadCharacter", 4usize, '\r', "MIME-style wrapping is refused by default");
  isRefusal(std("Zm9v\t"), "BadCharacter", 4usize, '\t', "a tab");
  isRefusal(std("Zm9vYmFyé"), "BadCharacter", 8usize, 0xC3u8, "a UTF-8 character");
  isRefusal(std("-_8="), "BadCharacter", 0usize, '-', "the URL-safe '-' is not standard");
  isRefusal(std("A_8="), "BadCharacter", 1usize, '_', "the URL-safe '_' is not standard");
  isRefusal(binarytext.decodeBase64Url("+/8="), "BadCharacter", 0usize, '+', "the standard '+' is not URL-safe");
  isRefusal(binarytext.decodeBase64Url("A/8="), "BadCharacter", 1usize, '/', "the standard '/' is not URL-safe");
  isRefusal(std("Zm9v@m9v"), "BadCharacter", 4usize, '@', "'@' is just below 'A'");
  isRefusal(std("Zm9v[m9v"), "BadCharacter", 4usize, '[', "'[' is just above 'Z'");
  isRefusal(std("Zm9v`m9v"), "BadCharacter", 4usize, '`', "'`' is just below 'a'");
  isRefusal(std("Zm9v{m9v"), "BadCharacter", 4usize, '{', "'{' is just above 'z'");
  mut nul = List[u8].empty();
  nul.push('Z'); nul.push(0u8); nul.push('9'); nul.push('v');
  isRefusal(binarytext.decodeBase64(nul.view()), "BadCharacter", 1usize, 0u8, "a NUL byte inside the text");

  // -------- padding --------
  isRefusal(std("Zg="), "BadPadding", 3usize, 0u8, "one '=' too few");
  isRefusal(std("Zg"), "BadPadding", 2usize, 0u8, "padding missing, 2 digits");
  isRefusal(std("Zm8"), "BadPadding", 3usize, 0u8, "padding missing, 3 digits");
  isRefusal(std("Zg==="), "BadPadding", 4usize, '=', "one '=' too many");
  isRefusal(std("Zm8=="), "BadPadding", 4usize, '=', "two '=' after 3 digits");
  isRefusal(std("Z==="), "BadPadding", 1usize, '=', "'=' after a single digit");
  isRefusal(std("===="), "BadPadding", 0usize, '=', "only '='");
  isRefusal(std("="), "BadPadding", 0usize, '=', "a lone '='");
  isRefusal(std("Zm9v="), "BadPadding", 4usize, '=', "'=' after a whole group");
  isRefusal(std("Zm9v===="), "BadPadding", 4usize, '=', "a group of '=' after a whole group");
  isRefusal(std("Zg==Zg=="), "BadPadding", 4usize, 'Z', "two padded texts joined");
  isRefusal(std("Zg=A"), "BadPadding", 3usize, 'A', "a digit where the second '=' is owed");
  isRefusal(std("Zm8=A"), "BadPadding", 4usize, 'A', "a digit after the padding");
  isRefusal(std("Zg=\n="), "BadPadding", 3usize, '\n', "a line break inside the padding");
  imm unp = binarytext.Base64Format.standardUnpadded();
  isRefusal(fmtd(&unp, "Zg=="), "BadPadding", 2usize, '=', "padding in an unpadded format");
  isRefusal(fmtd(&unp, "Zg="), "BadPadding", 2usize, '=', "one '=' in an unpadded format");
  isRefusal(fmtd(&unp, "Zm9v="), "BadPadding", 4usize, '=', "'=' after a whole group, unpadded format");
  imm urlUnp =binarytext.Base64Format.urlSafeUnpadded();
  isRefusal(fmtd(&urlUnp, "-_8="), "BadPadding", 3usize, '=', "padding in an unpadded URL-safe format");

  // -------- length --------
  isRefusal(std("Z"), "BadLength", 1usize, 0u8, "one digit");
  isRefusal(std("Zm9vY"), "BadLength", 5usize, 0u8, "one digit after a group");
  isRefusal(fmtd(&unp, "Z"), "BadLength", 1usize, 0u8, "one digit, unpadded format");
  isRefusal(fmtd(&unp, "Zm9vY"), "BadLength", 5usize, 0u8, "one digit after a group, unpadded format");

  // -------- trailing bits --------
  isRefusal(std("Zh=="), "NonCanonical", 1usize, 'h', "unused 4 bits not zero ('h' is 33)");
  isRefusal(std("QR=="), "NonCanonical", 1usize, 'R', "'QR==' would decode like 'QQ=='");
  isRefusal(std("Zm9="), "NonCanonical", 2usize, '9', "unused 2 bits not zero ('9' is 61)");
  isRefusal(std("Zm/="), "NonCanonical", 2usize, '/', "unused 2 bits not zero ('/' is 63)");
  isRefusal(fmtd(&unp, "Zh"), "NonCanonical", 1usize, 'h', "unused 4 bits, unpadded format");
  isRefusal(fmtd(&unp, "Zm9"), "NonCanonical", 2usize, '9', "unused 2 bits, unpadded format");
  isRefusal(std("Zm9vZh=="), "NonCanonical", 5usize, 'h', "unused bits, after a whole group");
  isBytes(std("QQ=="), "A", "the canonical spelling is accepted");
  isBytes(std("Zm8="), "fo", "unused 2 bits zero");
  isBytes(std("Zg=="), "f", "unused 4 bits zero");

  // -------- the opt-ins --------
  imm ws = binarytext.Base64Format.standard().acceptingWhitespace();
  isBytes(fmtd(&ws, "Zm9v\r\nYmFy\r\n"), "foobar", "whitespace skipped at line ends");
  isBytes(fmtd(&ws, " Z m\t9 v "), "foo", "whitespace skipped anywhere");
  isBytes(fmtd(&ws, "Zg = ="), "f", "whitespace skipped inside the padding");
  isBytes(fmtd(&ws, ""), "", "empty");
  isBytes(fmtd(&ws, " \r\n\t"), "", "only whitespace");
  isRefusal(fmtd(&ws, "Zm9v\r\nYmF!"), "BadCharacter", 9usize, '!', "an offset counts the whitespace");
  isRefusal(fmtd(&ws, "Zm 9v\x0b"), "BadCharacter", 5usize, 0x0Bu8, "a vertical tab is not whitespace here");
  isRefusal(fmtd(&ws, "Zg =\n"), "BadPadding", 5usize, 0u8, "whitespace does not make up the padding");
  isRefusal(fmtd(&ws, "Zg= =\n=Zg=="), "BadPadding", 6usize, '=', "unchanged padding rules");
  imm any = binarytext.Base64Format.standard().acceptingAnyPadding();
  isBytes(fmtd(&any, "Zg"), "f", "padding optional: absent");
  isBytes(fmtd(&any, "Zg=="), "f", "padding optional: present");
  isBytes(fmtd(&any, "Zm8"), "fo", "padding optional, 3 digits: absent");
  isBytes(fmtd(&any, "Zm8="), "fo", "padding optional, 3 digits: present");
  isBytes(fmtd(&any, "Zm9v"), "foo", "padding optional, nothing to pad");
  isRefusal(fmtd(&any, "Zg="), "BadPadding", 3usize, 0u8, "padding optional, a partly padded text");
  isRefusal(fmtd(&any, "Zm8=="), "BadPadding", 4usize, '=', "padding optional, too much");
  isRefusal(fmtd(&any, "Z"), "BadLength", 1usize, 0u8, "padding optional, one digit");
  isRefusal(fmtd(&any, "Zh"), "NonCanonical", 1usize, 'h', "padding optional keeps the trailing-bits check");
  imm anyUrl = binarytext.Base64Format.urlSafeUnpadded().acceptingAnyPadding();
  isHex(fmtd(&anyUrl, "-_8"), "fbff", "URL-safe, any padding: absent");
  isHex(fmtd(&anyUrl, "-_8="), "fbff", "URL-safe, any padding: present");
  imm bits = binarytext.Base64Format.standard().acceptingTrailingBits();
  isBytes(fmtd(&bits, "QR=="), "A", "trailing bits accepted: 'QR==' is 'A'");
  isBytes(fmtd(&bits, "QQ=="), "A", "trailing bits accepted: 'QQ=='");
  isBytes(fmtd(&bits, "Zm9="), "fo", "trailing bits accepted: 2 bits");
  isRefusal(fmtd(&bits, "Zg="), "BadPadding", 3usize, 0u8, "trailing bits accepted keeps the padding rules");
  imm everything = binarytext.Base64Format.urlSafeUnpadded().acceptingWhitespace().acceptingAnyPadding().acceptingTrailingBits();
  isBytes(fmtd(&everything, "QR\n=="), "A", "all three opt-ins");

  // -------- hex --------
  isRefusal(binarytext.decodeHex("abc"), "BadLength", 3usize, 0u8, "odd count");
  isRefusal(binarytext.decodeHex("a"), "BadLength", 1usize, 0u8, "one digit");
  isRefusal(binarytext.decodeHex("zz"), "BadCharacter", 0usize, 'z', "not hex");
  isRefusal(binarytext.decodeHex("12g4"), "BadCharacter", 2usize, 'g', "'g' is past 'f'");
  isRefusal(binarytext.decodeHex("12G4"), "BadCharacter", 2usize, 'G', "'G' is past 'F'");
  isRefusal(binarytext.decodeHex("0x12"), "BadCharacter", 1usize, 'x', "a 0x prefix");
  isRefusal(binarytext.decodeHex("12 34"), "BadCharacter", 2usize, ' ', "a space");
  isRefusal(binarytext.decodeHex("12\n"), "BadCharacter", 2usize, '\n', "a line feed");
  isRefusal(binarytext.decodeHex("1/"), "BadCharacter", 1usize, '/', "'/' is just below '0'");
  isRefusal(binarytext.decodeHex(":1"), "BadCharacter", 0usize, ':', "':' is just above '9'");
  isRefusal(binarytext.decodeHex("1`"), "BadCharacter", 1usize, '`', "'`' is just below 'a'");
  isRefusal(binarytext.decodeHex("1@"), "BadCharacter", 1usize, '@', "'@' is just below 'A'");
  isRefusal(binarytext.decodeHex("12é"), "BadCharacter", 2usize, 0xC3u8, "a UTF-8 character");
  isRefusal(binarytext.decodeHex("-1"), "BadCharacter", 0usize, '-', "a sign");
  isHex(binarytext.decodeHex("00ffFFaAbB"), "00ffffaabb", "mixed case");
  isHex(binarytext.decodeHexSkippingWhitespace("de ad\nbe\tef\r\n"), "deadbeef", "whitespace skipped");
  isHex(binarytext.decodeHexSkippingWhitespace("d e"), "de", "whitespace skipped inside a pair");
  isRefusal(binarytext.decodeHexSkippingWhitespace("de ad b"), "BadLength", 7usize, 0u8, "odd count, whitespace skipped");
  isRefusal(binarytext.decodeHexSkippingWhitespace("de ad\x0bbe"), "BadCharacter", 5usize, 0x0Bu8, "vertical tab");
  isBytes(binarytext.decodeHex(""), "", "empty hex");

  // -------- a streaming decoder reports the offset in the whole stream --------
  imm fmt = binarytext.Base64Format.standard();
  mut dec = binarytext.Base64Decoder.forFormat(&fmt);
  mut out = List[u8].empty();
  match dec.update("Zm9vYm", &mut out) { case is Ok { expect(true, "first chunk"); } case is Error { expect(false, "first chunk"); } }
  match dec.update("F!", &mut out) {
    case is Ok { expect(false, "a bad byte in the second chunk was accepted"); }
    case imm e Error {
      expectStr(kindName(&e.kind), "BadCharacter", "second chunk");
      expectUInt(u64.from(e.offset), 7u64, "offset 7 of the stream, 1 of the chunk");
      expectUInt(u64.from(e.byte), 33u64, "the byte");
    }
  }
  expectStr(out.view(), "foo", "the bytes before the fault are kept");
  // Once failed, it stays failed
  match dec.update("Zm9v", &mut out) {
    case is Ok { expect(false, "a failed decoder went on"); }
    case imm e Error {
      expectStr(kindName(&e.kind), "BadCharacter", "same fault again");
      expectUInt(u64.from(e.offset), 7u64, "same offset again");
    }
  }
  match dec.finish(&mut out) {
    case is Ok { expect(false, "a failed decoder finished"); }
    case imm e Error { expectUInt(u64.from(e.offset), 7u64, "finish repeats the fault"); }
  }
  expectStr(out.view(), "foo", "nothing more was written");
  // reset forgets it
  dec.reset();
  out.clear();
  match dec.update("Zm9v", &mut out) { case is Ok { expect(true, "after reset"); } case is Error { expect(false, "after reset"); } }
  match dec.finish(&mut out) { case is Ok { expect(true, "after reset, finish"); } case is Error { expect(false, "after reset, finish"); } }
  expectStr(out.view(), "foo", "decoded after reset");

  // Padding split across chunks, and a fault in it
  dec.reset();
  out.clear();
  match dec.update("Zg=", &mut out) { case is Ok { expect(true, "padding begins"); } case is Error { expect(false, "padding begins"); } }
  match dec.update("=Z", &mut out) {
    case is Ok { expect(false, "a digit after the padding was accepted"); }
    case imm e Error {
      expectStr(kindName(&e.kind), "BadPadding", "after the padding, across chunks");
      expectUInt(u64.from(e.offset), 4u64, "offset 4");
    }
  }
  // A hex decoder, the same
  mut hd = binarytext.HexDecoder.strict();
  out.clear();
  match hd.update("ab", &mut out) { case is Ok { expect(true, "hex first chunk"); } case is Error { expect(false, "hex first chunk"); } }
  match hd.update("c", &mut out) { case is Ok { expect(true, "hex half pair"); } case is Error { expect(false, "hex half pair"); } }
  match hd.finish(&mut out) {
    case is Ok { expect(false, "a half pair at the end was accepted"); }
    case imm e Error {
      expectStr(kindName(&e.kind), "BadLength", "hex end");
      expectUInt(u64.from(e.offset), 3u64, "hex end offset");
    }
  }
  hd.reset();
  out.clear();
  match hd.update("ab", &mut out) { case is Ok { } case is Error { expect(false, "hex after reset"); } }
  match hd.update("c-", &mut out) {
    case is Ok { expect(false, "hex bad byte accepted"); }
    case imm e Error {
      expectUInt(u64.from(e.offset), 3u64, "hex offset across chunks");
      expectUInt(u64.from(e.byte), 45u64, "hex byte");
    }
  }

  // -------- one-shot decoding into a List leaves it as it was on a fault --------
  mut acc = List[u8].empty();
  acc.push(1u8); acc.push(2u8); acc.push(3u8);
  match binarytext.decodeBase64Into("Zm9vYmFy", &fmt, &mut acc) {
    case imm k Ok { expectUInt(u64.from(k), 6u64, "appended 6 bytes"); }
    case is Error { expect(false, "decode into"); }
  }
  expectUInt(u64.from(acc.len()), 9u64, "after the append");
  match binarytext.decodeBase64Into("Zm9vYmF!", &fmt, &mut acc) {
    case is Ok { expect(false, "decode into a bad text"); }
    case imm e Error { expectUInt(u64.from(e.offset), 7u64, "fault offset"); }
  }
  expectUInt(u64.from(acc.len()), 9u64, "a fault leaves the list as it was");
  match binarytext.decodeBase64Into("Zm9vYg", &fmt, &mut acc) {
    case is Ok { expect(false, "decode into a text missing padding"); }
    case is Error { expect(true, "refused at finish"); }
  }
  expectUInt(u64.from(acc.len()), 9u64, "a fault at the end leaves the list as it was");
  match binarytext.decodeHexInto("6162zz", &mut acc) {
    case is Ok { expect(false, "hex into a bad text"); }
    case is Error { expect(true, "hex refused"); }
  }
  expectUInt(u64.from(acc.len()), 9u64, "a hex fault leaves the list as it was");
  match binarytext.decodeHexInto("6162", &mut acc) {
    case imm k Ok { expectUInt(u64.from(k), 2u64, "hex appended 2 bytes"); }
    case is Error { expect(false, "hex into"); }
  }
  expectUInt(u64.from(acc.len()), 11u64, "after the hex append");

  done();
}
