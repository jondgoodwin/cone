// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import audiodevice use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- DeviceError(1i32), "SDL's audio would not start", "sdl");
  says(String() <- DeviceError(2i32), "the audio stream would not open", "stream");
  says(String() <- DeviceError(3i32), "the feeder thread died", "feeder");
  says(String() <- DeviceError(9i32), "the audio device did not start", "any other");
  done()
}
