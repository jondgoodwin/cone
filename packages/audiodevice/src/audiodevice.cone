// The audiodevice package: audiomixer's output to the
// speakers, over SDL3's audio streams. A program reaches it with 'import
// audiodevice' and gets `Device.start`, which opens the system's default
// playback device (or whichever SDL_AUDIODRIVER names; "dummy" plays
// nothing) and starts a feeder thread that runs audiomixer's `Engine`.
//
// The model, and why: SDL3 offers a callback or a push stream. A callback is
// a C function pointer that SDL calls from its own audio thread; Cone has
// no way to hand one over yet, and would put Cone code on a thread the
// runtime does not know. The push stream needs none: the feeder thread, a
// Cone thread, asks `GetAudioStreamQueued` how many bytes wait in the
// stream, and while fewer than 'ahead' milliseconds' worth do, drains the
// command queue, renders a block of the mixer and `PutAudioStreamData`s it.
// SDL's own audio thread copies from the stream to the device. The price is
// latency: 'ahead' (40 ms is fair, one block is 10 ms) plus the device's
// buffer. The mixer's render never allocates; this loop allocates its block
// buffer once. It sleeps (2 ms) when the stream is full enough, which is
// also what lets a build run it as a test with the dummy driver.
//
// Which device: `Device.start` opens the default one. `Device.startOn` takes a
// list of substrings and opens the first playback device (in SDL's order)
// whose name contains any of them, ignoring case, and falls back to the
// default when none does, or when the one that did would not open; `Started.deviceName` says which opened (empty for
// the default, which is not looked up). `playbackNames` lists the names, and
// `nameMatches` is the matching on its own. The choice is made on the
// calling thread and the feeder is handed the device id.
//
// The Control that talks to the mixer is returned by `start` and belongs to
// the game thread. Stop the device with `Device.stop` before dropping the
// Control, since the mixer reads the sounds the Control owns.
//
// COUNTERS. The feeder writes three counts as it goes, and any thread reads them through the Device
// (`blocksPut`, `underruns`, `worstWakeLateUs`). An underrun is the stream found empty when the feeder woke to
// refill it, after the first block has been put (the start-up fill is not one): SDL's thread had nothing left to
// play. The worst wake lateness is how much longer than its 2 ms a sleep of the feeder took, the largest so far, in
// microseconds. None of this runs on SDL's thread: the feeder only reads `GetAudioStreamQueued`, as it already did.

mod audiodevice;

import libc;
import sdl;
import thread;
import collections use *;
import sync use Receiver, Oneshot, OneshotSender, OneshotReceiver, Arc;
import time use Duration, Instant;
import audiomixer use *;

// Frames the feeder renders at a time: 10 ms at 48 kHz
const BLOCK_FRAMES = 480usize;

// Why a device did not start
pub struct DeviceError is Error {
  pub reason: i32;      // 1: SDL's audio would not start, 2: the stream would not open, 3: the feeder died

  pub fn toText(self: &, out: &uni TextOut) {
    if reason == 1i32 { out <- "SDL's audio would not start"; return; }
    if reason == 2i32 { out <- "the audio stream would not open"; return; }
    if reason == 3i32 { out <- "the feeder thread died"; return; }
    out <- "the audio device did not start";
  }
}

// What the feeder counts, shared with the Device that reads it
struct Counts is Sendable {
  blocksPut: Atomic[u64];
  underruns: Atomic[u64];
  worstWakeLateUs: Atomic[u64];
}

struct Feed is Sendable {
  devid: u32;
  rate: u32;
  voices: u32;
  aheadMs: u32;
  engine: Engine;
  status: OneshotSender[i32];
  counts: Arc[imm, Counts];
}

// The feeder thread: opens the stream, reports 0 (or a reason) through
// 'status', renders and pushes until a quit command, and closes
fn feeder(init: Feed) i32 {
  var f = init;
  if !sdl.InitSubSystem(sdl.INIT_AUDIO) {
    f.status.send(1i32);
    return 1i32;
  }
  let spec = sdl.AudioSpec(sdl.AUDIO_F32, 2i32, i32.from(f.rate));
  let stream = sdl.OpenAudioDeviceStream(f.devid, &spec, null, null);
  if stream as usize == 0usize {
    sdl.QuitSubSystem(sdl.INIT_AUDIO);
    f.status.send(2i32);
    return 2i32;
  }
  sdl.ResumeAudioStreamDevice(stream);
  f.status.send(0i32);
  var buf = List[f32].withCapacity(BLOCK_FRAMES * 2usize);
  var i = 0usize;
  while i < BLOCK_FRAMES * 2usize { buf.push(0.); i = i + 1usize; }
  let blockBytes = i32.from(BLOCK_FRAMES * 8usize);
  let wantBytes = i32.from(f.rate / 1000u32 * f.aheadMs) * 8i32;
  let sleepNs = 2000000i64;
  while !f.engine.quit {
    let queued = sdl.GetAudioStreamQueued(stream);
    if queued < wantBytes {
      // empty when it wakes, once the first block is in: SDL's thread ran dry
      if queued <= 0i32 && f.counts.blocksPut.load() > 0u64 { f.counts.underruns.add(1u64); }
      f.engine.render(buf.viewMut(), BLOCK_FRAMES);
      let v = buf.view();
      sdl.PutAudioStreamData(stream, (&v[0usize] as *u8), blockBytes);
      f.counts.blocksPut.add(1u64);
    } else {
      let t0 = Instant.now().nanos();
      thread.sleep(Duration.fromMillis(2));
      let late = Instant.now().nanos() - t0 - sleepNs;
      if late > 0i64 { f.counts.worstWakeLateUs.max(u64.from(late / 1000i64)); }
    }
  }
  sdl.DestroyAudioStream(stream);
  sdl.QuitSubSystem(sdl.INIT_AUDIO);
  0i32
}

// A running device and the game thread's way to drive it
pub struct Started {
  pub device: Device;
  pub control: Control;
  pub deviceName: String;   // the playback device's name when 'startOn' matched one, else empty (the default)
}

// A byte's lower case (ASCII only)
fn lowerByte(b: u8) u8 {
  if b >= 65u8 && b <= 90u8 { return b + 32u8; }
  b
}

// Whether 'name' contains 'part', ignoring ASCII case (an empty 'part' matches nothing)
fn containsFold(name: &String, part: &String) bool {
  let n: &Array[u8] = name.view();
  let p: &Array[u8] = part.view();
  if p.len == 0usize { return false; }
  var i = 0usize;
  while i + p.len <= n.len {
    var j = 0usize;
    while j < p.len && lowerByte(n[i + j]) == lowerByte(p[j]) { j = j + 1usize; }
    if j == p.len { return true; }
    i = i + 1usize;
  }
  false
}

// Whether 'name' contains any of 'wants' (case-insensitive)
pub fn nameMatches(name: &String, wants: &List[String]) bool {
  var k = 0usize;
  while k < wants.len() {
    if containsFold(name, &wants[k]) { return true; }
    k = k + 1usize;
  }
  false
}

// The index of the first of 'names' that 'nameMatches' wants, or names.len() when none
pub fn firstMatch(names: &List[String], wants: &List[String]) usize {
  var k = 0usize;
  while k < names.len() {
    if nameMatches(&names[k], wants) { return k; }
    k = k + 1usize;
  }
  names.len()
}

// The playback devices' ids and names, in SDL's order; empty when audio would not start
fn playbackDevices(ids: &mut List[u32], names: &mut List[String]) {
  if !sdl.InitSubSystem(sdl.INIT_AUDIO) { return; }
  var count = 0i32;
  let arr = sdl.GetAudioPlaybackDevices(&mut count);
  if arr as usize != 0usize {
    var k = 0i32;
    while k < count {
      let id = *(arr + usize.from(k));
      let raw = sdl.GetAudioDeviceName(id);
      ids.push(id);
      if raw as usize == 0usize { names.push(String()); }
      else { names.push(String.fromCStr(cstr.fromPtr(raw))); }
      k = k + 1i32;
    }
    sdl.free(arr as *u8);
  }
  sdl.QuitSubSystem(sdl.INIT_AUDIO);
}

// The names of the system's playback devices (what SDL3 hears of; silent)
pub fn playbackNames() List[String] {
  var ids = List[u32]();
  var names = List[String]();
  playbackDevices(&mut ids, &mut names);
  names
}

pub struct Device {
  worker: Option[thread.Thread[i32]];
  pub rate: u32;
  counts: Arc[imm, Counts];

  // Blocks (10 ms each) the feeder has put in the stream
  pub fn blocksPut(self: &) u64 { counts.blocksPut.load() }
  // Times the feeder found the stream empty when it woke, after the first block: the device ran dry
  pub fn underruns(self: &) u64 { counts.underruns.load() }
  // The longest a 2 ms sleep of the feeder has overrun, in microseconds
  pub fn worstWakeLateUs(self: &) u64 { counts.worstWakeLateUs.load() }

  // Open the default playback device at 'rate' Hz stereo and start feeding
  // it from a mixer of 'voices' voices, keeping 'aheadMs' of sound queued.
  // Answers the device and the game thread's Control, or why not.
  pub fn start(rate: u32, voices: u32, aheadMs: u32) Result[Started, DeviceError] {
    Device.open(sdl.AUDIO_DEVICE_DEFAULT_PLAYBACK, String(), rate, voices, aheadMs)
  }

  // As 'start', but on the first playback device whose name contains any of
  // 'wants' (case-insensitive); with none matching (or none listed) it opens the
  // default, and the Started's 'deviceName' is empty.
  pub fn startOn(wants: &List[String], rate: u32, voices: u32, aheadMs: u32) Result[Started, DeviceError] {
    // Device ids belong to the audio subsystem's run: SDL numbers them afresh each time it starts, so an
    // id listed under one run is "Invalid audio device instance ID" under the next. This call holds its
    // own reference across the listing and the open (the feeder takes its own inside 'open'), so the
    // subsystem does not stop between them; the hold is let go once 'open' has returned.
    let held = sdl.InitSubSystem(sdl.INIT_AUDIO);
    var ids = List[u32]();
    var names = List[String]();
    playbackDevices(&mut ids, &mut names);
    let k = firstMatch(&names, wants);
    var answer: Result[Started, DeviceError] = Err[Started, DeviceError](DeviceError(2i32));
    var needDefault = true;
    if k < names.len() {
      answer = Device.open(ids[k], names[k].clone(), rate, voices, aheadMs);
      match answer {
        case is Ok { needDefault = false; }
        case is Err {}
      }
    }
    // no match, or the matched device would not open: the default, unnamed
    if needDefault {
      answer = Device.open(sdl.AUDIO_DEVICE_DEFAULT_PLAYBACK, String(), rate, voices, aheadMs);
    }
    if held { sdl.QuitSubSystem(sdl.INIT_AUDIO); }
    answer
  }

  fn open(devid: u32, name: String, rate: u32, voices: u32, aheadMs: u32) Result[Started, DeviceError] {
    var c: Control;
    var rx: Receiver[Cmd];
    c, rx = commandQueue(DEFAULT_QUEUE);
    var st: OneshotSender[i32];
    var sr: OneshotReceiver[i32];
    st, sr = Oneshot[i32].make();
    let engine = Engine.make(f32.from(rate), usize.from(voices), rx);
    let counts = Arc[imm, Counts](Counts(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64)));
    let worker = thread.start(Feed(devid, rate, voices, aheadMs, engine, st, counts), &feeder);
    let got = sr.recv();
    var code = 3i32;
    match got {
      case let Some(v) { code = v; }
      case is None[i32] {}
    }
    if code != 0i32 {
      worker.join();
      return Err[Started, DeviceError](DeviceError(code));
    }
    Ok[Started, DeviceError](Started(Device(Some(worker), rate, counts), c, name))
  }

  // Stop feeding, close the device and wait for the feeder to end. 'control'
  // must be the one `start` gave; its sounds may be dropped afterwards. The device is given up.
  pub fn stop(self, control: &mut Control) i32 {
    var sent = false;
    while !sent {
      sent = control.quit();
      if !sent { thread.yieldNow(); }
    }
    let w = self.(worker);
    var status = 0i32;
    match w {
      case var Some(t) { status = t.join(); }
      case is None[thread.Thread[i32]] {}
    }
    status
  }
}
