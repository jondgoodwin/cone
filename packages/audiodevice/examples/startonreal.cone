// On the real audio driver: Device.startOn the named device, say which opened, hold a second with
// nothing queued (no voices: silence) and stop. Usage: startonreal [part-of-name]  (default "Oculus")
mod startonreal;

import collections use *;
import stdio use *;
import thread;
import time use Duration;
import env;
import audiodevice use *;

fn main() i32 {
  var wants = List[String]();
  wants.push(String.from("Oculus"));
  match Device.startOn(&wants, 48000u32, 8u32, 40u32) {
    case var Ok(s) {
      print <- "startOn: Ok, deviceName \""; printStr(s.deviceName.view()); print <- "\"\n";
      let device, var control = s.(device, control);
      thread.sleep(Duration.fromMillis(1000));
      print <- "stop status "; print <- i64.from(device.stop(&mut control)); print <- "\n";
    }
    case var Err(e) {
      print <- "startOn: Err, code "; print <- i64.from(e.reason); print <- "\n";
    }
  }
  0i32
}
