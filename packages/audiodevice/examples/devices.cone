// Lists the system's playback devices by name, one to a line (silent: no
// device is opened). The names are what `Device.startOn` matches against.
mod devices;

import collections use *;
import stdio use *;
import audiodevice use *;

fn main() i32 {
  let names = playbackNames();
  var k = 0usize;
  while k < names.len() {
    print <- "device: \""; printStr(names[k].view()); print <- "\"\n";
    k = k + 1usize;
  }
  print <- names.len(); print <- " playback devices\n";
  0i32
}
