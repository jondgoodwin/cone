// SHA3-256 and SHA3-512 (FIPS 202) against NIST's example messages and independently computed digests.
//
// Sources of the vectors:
// - NIST "Example Values" for SHA3-256 and SHA3-512 (csrc.nist.gov): the empty
//   message, "abc", the 448-bit and 896-bit messages, and one million 'a'.
// - 'a' x n on either side of each hasher's block (the rate: 136 bytes for
//   SHA3-256, 72 for SHA3-512), and 200 bytes.
// All digests were computed with Python's hashlib (OpenSSL), not this package.
// Then a 200-byte message of a pattern (byte i is (7 i + 3) mod 256) is fed in
// two pieces split at every offset from 0 to 200: each must equal the one-shot.

mod sha3;

import testing use *;
import collections use *;
import cryptohash;

fn hexOf(s: &Array[u8]) String {
  var h = String();
  var i = 0usize;
  while i < s.len {
    h.appendHex(u64.from(s[i]), 2usize);
    i = i + 1usize;
  }
  h
}

fn repeated(b: u8, n: usize) List[u8] {
  var out = List[u8]();
  var i = 0usize;
  while i < n {
    out.push(b);
    i = i + 1usize;
  }
  out
}

fn check256(label: &str, msg: &Array[u8], want: &str) {
  let d = cryptohash.sha3_256(msg);
  let got = hexOf(&d);
  expectStr(got.view(), want, label);
}

fn check512(label: &str, msg: &Array[u8], want: &str) {
  let d = cryptohash.sha3_512(msg);
  let got = hexOf(&d);
  expectStr(got.view(), want, label);
}

fn a256(n: usize, want: &str) {
  let msg = repeated(97u8, n);
  var label = String.from("sha3-256 of 'a' x ");
  label.appendInt(i64.from(n));
  check256(label.view(), msg.view(), want);
}

fn a512(n: usize, want: &str) {
  let msg = repeated(97u8, n);
  var label = String.from("sha3-512 of 'a' x ");
  label.appendInt(i64.from(n));
  check512(label.view(), msg.view(), want);
}

fn two256(msg: &Array[u8], at: usize) String {
  let parts = msg.split(at);
  var s = cryptohash.Sha3_256.make();
  s.update(parts.0);
  s.update(parts.1);
  let d = s.finish();
  hexOf(&d)
}

fn two512(msg: &Array[u8], at: usize) String {
  let parts = msg.split(at);
  var s = cryptohash.Sha3_512.make();
  s.update(parts.0);
  s.update(parts.1);
  let d = s.finish();
  hexOf(&d)
}

fn main() i32 {
  let m448 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
  let m896 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
  let million = repeated(97u8, 1000000usize);

  check256("sha3-256 empty", "", "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a");
  check256("sha3-256 abc", "abc", "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532");
  check256("sha3-256 448 bits", m448, "41c0dba2a9d6240849100376a8235e2c82e1b9998a999e21db32dd97496d3376");
  check256("sha3-256 896 bits", m896, "916f6061fe879741ca6469b43971dfdb28b1a32dc36cb3254e812be27aad1d18");
  check256("sha3-256 one million a", million.view(), "5c8875ae474a3634ba4fd55ec85bffd661f32aca75c6d699d0cdcb6c115891c1");
  a256(1usize, "80084bf2fba02475726feb2cab2d8215eab14bc6bdd8bfb2c8151257032ecd8b");
  a256(135usize, "8094bb53c44cfb1e67b7c30447f9a1c33696d2463ecc1d9c92538913392843c9");
  a256(136usize, "3fc5559f14db8e453a0a3091edbd2bc25e11528d81c66fa570a4efdcc2695ee1");
  a256(137usize, "f8d6846cedd2ccfadf15c5879ef95af724d799eed7391fb1c91f95344e738614");
  a256(271usize, "e79e5c6fef1bb5fdea2717ca27e88399e9b64699d1b3eb8e30f314fa055214e8");
  a256(272usize, "a490357b9b3fb39d0a89a117734e5b020b1f33c7bf3fa3575c396425432003d3");
  a256(273usize, "7930a0e2cde6f949ea52204a2fde51856de566d96d2ebe896656450a2b10b445");
  a256(200usize, "cce34485baf2bf2aca99b94833892a4f52896d3d153f7b840cc4f9fe695f1387");

  check512("sha3-512 empty", "", "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26");
  check512("sha3-512 abc", "abc", "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0");
  check512("sha3-512 448 bits", m448, "04a371e84ecfb5b8b77cb48610fca8182dd457ce6f326a0fd3d7ec2f1e91636dee691fbe0c985302ba1b0d8dc78c086346b533b49c030d99a27daf1139d6e75e");
  check512("sha3-512 896 bits", m896, "afebb2ef542e6579c50cad06d2e578f9f8dd6881d7dc824d26360feebf18a4fa73e3261122948efcfd492e74e82e2189ed0fb440d187f382270cb455f21dd185");
  check512("sha3-512 one million a", million.view(), "3c3a876da14034ab60627c077bb98f7e120a2a5370212dffb3385a18d4f38859ed311d0a9d5141ce9cc5c66ee689b266a8aa18ace8282a0e0db596c90b0a7b87");
  a512(1usize, "697f2d856172cb8309d6b8b97dac4de344b549d4dee61edfb4962d8698b7fa803f4f93ff24393586e28b5b957ac3d1d369420ce53332712f997bd336d09ab02a");
  a512(71usize, "070faf98d2a8fddf8ed886408744dc06456096c2e045f26f3c7b010530e6bbb3db535a54d636856f4e0e1e982461cb9a7e8e57ff8895cff1619af9f0e486e28c");
  a512(72usize, "a8ae722a78e10cbbc413886c02eb5b369a03f6560084aff566bd597bb7ad8c1ccd86e81296852359bf2faddb5153c0a7445722987875e74287adac21adebe952");
  a512(73usize, "23e6a8815f8201dbbf6a5463be8dcadb1acea9df5f8998954e59ac9565cf6d29b17aa27a5e8b0fc06343db6122d6e544d27583ddc78504d08203217e7e65b6bd");
  a512(143usize, "1dfc536c0ef79e004ec6f18e3b24fd6c4c3076556424ef369e8734312d6594ff9b92a8f02d2980ab51c191a9cc3cf47d06265e81d306d4098cdf2b6bada1db27");
  a512(144usize, "446cd4d7ba19510dcc776b21045bc68d424b5b840e14685e149bb238b5f473c0356b69e04f0f5785eefce20ff09e678b080d8aac64568c5edf001cd32b2ed7a8");
  a512(145usize, "84a7b171615f4f0024b772defd5ea21a536bb1e52306fa7ad412c532ac919f6b645e412aa7f5d979808c8ae03ca7d159363dcdb179c9b03f908e3b3526cbf4de");
  a512(200usize, "eae6c85c6904f11075de9f9d5e1064371d000510fa3d2d79d40cf9be34892fb01859d0a0234e138bcb0ad5c84f6c0dca226a414b0c9a2897cb695f5185fe36ec");

  // Split at every offset
  var all = List[u8]();
  var i = 0usize;
  while i < 200usize {
    all.push(u8.from((i * 7usize + 3usize) & 0xffusize));
    i = i + 1usize;
  }
  let want256 = "9da37ea2fb33acd563a014f50d6f7cc225f25577a81d900452b72b5de98f239d";
  let want512 = "14fb36d333d34fccb38c8801d7692c9350a324cbc44448b63aca9d3cfdb12fb52a08934fefda157796735871f1541d1e5bcb70cb03ca13186c94c5c45e1f1cad";
  check256("pattern 200 one-shot", all.view(), want256);
  check512("pattern 200 one-shot", all.view(), want512);
  var bad256 = 0u64;
  var bad512 = 0u64;
  var at = 0usize;
  while at <= 200usize {
    let a = two256(all.view(), at);
    if a.view() != want256 { bad256 = bad256 + 1u64; }
    let b = two512(all.view(), at);
    if b.view() != want512 { bad512 = bad512 + 1u64; }
    at = at + 1usize;
  }
  expectUInt(bad256, 0u64, "sha3-256 split in two at each of 201 offsets: failures");
  expectUInt(bad512, 0u64, "sha3-512 split in two at each of 201 offsets: failures");

  // The hasher as a value: finish leaves it as it was, copyOf forks it, reset empties it
  var h = cryptohash.Sha3_256.make();
  h.update("a");
  let part = h.copyOf();
  h.update("bc");
  let d1 = h.finish();
  let d2 = h.finish();
  expectStr(hexOf(&d1).view(), "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", "finish then more");
  expectStr(hexOf(&d2).view(), "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", "finish twice");
  expectUInt(h.length(), 3u64, "length");
  expectUInt(part.length(), 1u64, "copy's length");
  h.reset();
  let d3 = h.finish();
  expectStr(hexOf(&d3).view(), "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", "reset");

  done()
}
