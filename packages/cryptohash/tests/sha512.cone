// SHA-512 against published and independently computed digests.
//
// Sources of the vectors:
// - NIST, "Example Values" for SHA-512 (csrc.nist.gov, the SHA-512 example
//   page, from FIPS 180-4's appendix C): the one-block message "abc" (C.1),
//   the two-block 896-bit message (C.2) and the million-'a' message (C.3).
//   The 448-bit message's digest is from NIST's SHA2_Additional example page.
// - NIST CAVP, SHA-512 byte-oriented test vectors, SHAVS 'SHA512ShortMsg':
//   the entries Len = 0 (the empty message) and 8 (21). Only these samples are
//   here; the long-message files are not.
// - Lengths on either side of the 111/112/113 and 127/128/129-byte block and
//   padding edges, and 200 to 256 bytes: the message is that many 'a' bytes,
//   and the expected digest comes from Python's hashlib (OpenSSL), not from
//   this package.
// Each digest was also checked against hashlib when written into this file.

mod sha512;

import testing use *;
import collections use *;
import cryptohash;

fn hexOf(s &Array[u8]) String {
  var h = String.empty();
  var i = 0usize;
  while i < s.len {
    h.appendHex(u64.from(s[i]), 2usize);
    i = i + 1usize;
  }
  h
}

fn hexVal(c u8) u8 {
  if c >= 97u8 { return c - 87u8; }
  c - 48u8
}

// The bytes the hex text names
fn fromHex(hex &str) List[u8] {
  var out = new List[u8];
  var i = 0usize;
  while i < hex.len {
    out.push(hexVal(hex[i]) * 16u8 + hexVal(hex[i + 1usize]));
    i = i + 2usize;
  }
  out
}

// n copies of the byte
fn repeated(b u8, n usize) List[u8] {
  var out = new List[u8];
  var i = 0usize;
  while i < n {
    out.push(b);
    i = i + 1usize;
  }
  out
}

fn check(label &str, msg &Array[u8], want &str) {
  let d = cryptohash.sha512(msg);
  let got = hexOf(&d);
  expectStr(got.view(), want, label);
}

fn checkA(n usize, want &str) {
  let msg = repeated(97u8, n);
  var label = String.from("sha512 of 'a' x ");
  label.appendInt(i64.from(n));
  check(label.view(), msg.view(), want);
}

fn main() i32 {
  // FIPS 180-4 / NIST examples
  check("empty (CAVP Len 0)", "",
        "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
  check("abc (FIPS 180-4 C.1)", "abc",
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
  check("448 bits (NIST additional example)", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
        "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445");
  check("896 bits (FIPS 180-4 C.2)",
        "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");

  // CAVP SHA512ShortMsg
  let m1 = fromHex("21");
  check("CAVP Len 8", m1.view(),
        "3831a6a6155e509dee59a7f451eb35324d8f8f2df6e3708894740f98fdee23889f4de5adb0c5010dfb555cda77c8ab5dc902094c52de3278f35a75ebc25f093a");

  // One million 'a', in one piece (FIPS 180-4 C.3)
  let million = repeated(97u8, 1000000usize);
  check("one million a (FIPS 180-4 C.3)", million.view(),
        "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b");

  // Block and padding edges
  checkA(1usize, "1f40fc92da241694750979ee6cf582f2d5d7d28e18335de05abc54d0560e0f5302860c652bf08d560252aa5e74210546f369fbbbce8c12cfc7957b2652fe9a75");
  checkA(2usize, "f6c5600ed1dbdcfdf829081f5417dccbbd2b9288e0b427e65c8cf67e274b69009cd142475e15304f599f429f260a661b5df4de26746459a3cef7f32006e5d1c1");
  checkA(3usize, "d6f644b19812e97b5d871658d6d3400ecd4787faeb9b8990c1e7608288664be77257104a58d033bcf1a0e0945ff06468ebe53e2dff36e248424c7273117dac09");
  checkA(55usize, "b0220c772cbf6c1822e2cb38a437d0e1d58772417a4bbb21c961364f8b6143e05aa6316dca8d1d7b19e16448419076395f6086cb55101fbd6d5497b148e1745f");
  checkA(56usize, "962b64aae357d2a4fee3ded8b539bdc9d325081822b0bfc55583133aab44f18bafe11d72a7ae16c79ce2ba620ae2242d5144809161945f1367f41b3972e26e04");
  checkA(57usize, "d3115798e872fc1ca6b276368e8ea0926daec6ab1f8f08297e4348ff5f5fe4c6e5205413271babafd4929b070754bc5800e5db44790666ec4e2f6ac52a17e163");
  checkA(63usize, "c1b0f5c6d3b03dfe4a2602e67242f54e344090b66e01100a469b129f583f016c7e27dddeaa438393dcc7ec54b0b57c9ba7af007f9b56db5f6fb677d972a31362");
  checkA(64usize, "01d35c10c6c38c2dcf48f7eebb3235fb5ad74a65ec4cd016e2354c637a8fb49b695ef3c1d6f7ae4cd74d78cc9c9bcac9d4f23a73019998a7f73038a5c9b2dbde");
  checkA(65usize, "b83086cd8494e55708ad7ecd82dfb4bca1bda61ecbb7caf0c68967902e709345e5d8305eb7ac0d588afc6cbb75161aa9c8c7e0ea986bd833dafe5e1ccd37345a");
  checkA(111usize, "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2");
  checkA(112usize, "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca");
  checkA(113usize, "55ddd8ac210a6e18ba1ee055af84c966e0dbff091c43580ae1be703bdb85da31acf6948cf5bd90c55a20e5450f22fb89bd8d0085e39f85a86cc46abbca75e24d");
  checkA(119usize, "130396a75cb483f2eee8c56d8a668bb3d2641f5243212c0bee2bd33da096ad9eb8179fe18f9eaacf76e09fae9de4c3f14ba13341e345be05bf76c182cc3468cb");
  checkA(120usize, "f241de612b01aa2fa3cf01531d2a8e5e17fc761dfd48a704a834a47f57d6eade7804ecc39be42fdef16ec6adeaf7c01c2fd0c4cc97d3860907cfa4a3b36d0c05");
  checkA(127usize, "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502");
  checkA(128usize, "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321");
  checkA(129usize, "4f681e0bd53cda4b5a2041cc8a06f2eabde44fb16c951fbd5b87702f07aeab611565b19c47fde30587177ebb852e3971bbd8d3fd30da18d71037dfbd98420429");
  checkA(200usize, "4b11459c33f52a22ee8236782714c150a3b2c60994e9acee17fe68947a3e6789f31e7668394592da7bef827cddca88c4e6f86e4df7ed1ae6cba71f3e98faee9f");
  checkA(255usize, "d8b5a659e365f704ab114ae7079a8da24fb9997b3052a4a63b37d654652bad6fbdd2b52d737e20a9d5ac3c5831d6afdd32ff737a3dd95269d2793bc2aa850aab");
  checkA(256usize, "6a9169eb662f136d87374070e8828b3e615a7eca32a89446e9225b02832709be095e635c824a2bb70213ba2ea0ababac0809827843992c851903b7ac0c136699");

  done()
}
