// SHA-256 against published and independently computed digests.
//
// Sources of the vectors:
// - NIST, "Example Values" for SHA-256 (csrc.nist.gov, the SHA-256 example
//   page, from FIPS 180-4's appendix B): the one-block message "abc"
//   (B.1), the two-block 448-bit message (B.2) and the million-'a' message
//   (B.3). The 896-bit message is from NIST's SHA2_Additional example page.
// - NIST CAVP, SHA-256 byte-oriented test vectors, SHAVS 'SHA256ShortMsg':
//   the entries Len = 0 (the empty message), 8 (d3), 16 (11af), 24 (b4190e).
//   Only these samples are here; the long-message files are not.
// - Lengths on either side of the 55/56/57, 63/64/65, 119/120/121-byte
//   block and padding edges, and 200 to 256 bytes: the message is that many
//   'a' bytes, and the expected digest comes from Python's hashlib (OpenSSL),
//   not from this package.
// Each digest was also checked against hashlib when written into this file.

mod sha256;

import testing use *;
import collections use *;
import cryptohash;

fn hexOf(s &Array[u8]) String {
  var h = String.empty();
  var i = 0usize;
  while i < s.len {
    h.appendHex(u64.from(s[i]), 2usize);
    i = i + 1usize;
  }
  h;
}

fn hexVal(c u8) u8 {
  if c >= 97u8 { return c - 87u8; }
  c - 48u8;
}

// The bytes the hex text names
fn fromHex(hex &str) List[u8] {
  var out = new List[u8];
  var i = 0usize;
  while i < hex.len {
    out.push(hexVal(hex[i]) * 16u8 + hexVal(hex[i + 1usize]));
    i = i + 2usize;
  }
  out;
}

// n copies of the byte
fn repeated(b u8, n usize) List[u8] {
  var out = new List[u8];
  var i = 0usize;
  while i < n {
    out.push(b);
    i = i + 1usize;
  }
  out;
}

fn check(label &str, msg &Array[u8], want &str) {
  let d = cryptohash.sha256(msg);
  let got = hexOf(&d);
  expectStr(got.view(), want, label);
}

fn checkA(n usize, want &str) {
  let msg = repeated(97u8, n);
  var label = String.from("sha256 of 'a' x ");
  label.appendInt(i64.from(n));
  check(label.view(), msg.view(), want);
}

fn main() i32 {
  // FIPS 180-4 / NIST examples
  check("empty (CAVP Len 0)", "", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
  check("abc (FIPS 180-4 B.1)", "abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
  check("448 bits (FIPS 180-4 B.2)", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
  check("896 bits (NIST additional example)",
        "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1");

  // CAVP SHA256ShortMsg
  let m1 = fromHex("d3");
  check("CAVP Len 8", m1.view(), "28969cdfa74a12c82f3bad960b0b000aca2ac329deea5c2328ebc6f2ba9802c1");
  let m2 = fromHex("11af");
  check("CAVP Len 16", m2.view(), "5ca7133fa735326081558ac312c620eeca9970d1e70a4b95533d956f072d1f98");
  let m3 = fromHex("b4190e");
  check("CAVP Len 24", m3.view(), "dff2e73091f6c05e528896c4c831b9448653dc2ff043528f6769437bc7b975c2");

  // One million 'a', in one piece (FIPS 180-4 B.3)
  let million = repeated(97u8, 1000000usize);
  check("one million a (FIPS 180-4 B.3)", million.view(),
        "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");

  // Block and padding edges
  checkA(1usize, "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb");
  checkA(2usize, "961b6dd3ede3cb8ecbaacbd68de040cd78eb2ed5889130cceb4c49268ea4d506");
  checkA(3usize, "9834876dcfb05cb167a5c24953eba58c4ac89b1adf57f28f2f9d09af107ee8f0");
  checkA(55usize, "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318");
  checkA(56usize, "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a");
  checkA(57usize, "f13b2d724659eb3bf47f2dd6af1accc87b81f09f59f2b75e5c0bed6589dfe8c6");
  checkA(63usize, "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34");
  checkA(64usize, "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb");
  checkA(65usize, "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0");
  checkA(111usize, "6374f73208854473827f6f6a3f43b1f53eaa3b82c21c1a6d69a2110b2a79baad");
  checkA(112usize, "f54353008a2553262ecdc4a34749563ba0950e8b0fc8652780b0a614b99683c1");
  checkA(113usize, "ba02731ae695aae5cd49b49d84330b63995733eb22102aca755f0179b1e0e20f");
  checkA(119usize, "31eba51c313a5c08226adf18d4a359cfdfd8d2e816b13f4af952f7ea6584dcfb");
  checkA(120usize, "2f3d335432c70b580af0e8e1b3674a7c020d683aa5f73aaaedfdc55af904c21c");
  checkA(127usize, "c57e9278af78fa3cab38667bef4ce29d783787a2f731d4e12200270f0c32320a");
  checkA(128usize, "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e");
  checkA(129usize, "c12cb024a2e5551cca0e08fce8f1c5e314555cc3fef6329ee994a3db752166ae");
  checkA(200usize, "c2a908d98f5df987ade41b5fce213067efbcc21ef2240212a41e54b5e7c28ae5");
  checkA(255usize, "b0f3323e7a3cad8ae6778340cc2a17ae0cb31c818df3767cda7c3dd423725e90");
  checkA(256usize, "02d7160d77e18c6447be80c2e355c7ed4388545271702c50253b0914c65ce5fe");

  done();
}
