// -------- SHA-1 (FIPS 180-4, section 6.1) --------

// LEGACY. SHA-1 is broken for collisions (a collision was made in 2017, and a
// chosen-prefix one in 2019 and 2020). Do not use it for a new security
// purpose: not for signatures, certificates, or telling files apart against
// an attacker. It is here for formats that still name it (git object names,
// the WebSocket handshake of RFC 6455, old protocols); for anything new use
// Sha256 or Sha512.
//
// A SHA-1 hasher. Its fields are its whole state (five chaining words, the
// block being filled, how much of it is filled, and the bytes taken so far),
// so copying the value ('copyOf') copies the hash in progress.
pub struct Sha1 {
  h: Array[u32, 5];
  buf: Array[u8, 64];
  used: usize;
  total: u64;

  // A hasher that has taken nothing
  pub fn make() Sha1 {
    Sha1([0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32, 0xc3d2e1f0u32],
             Array[u8, 64]() <- fill 0u8, 0usize, 0u64)
  }

  // A hasher in exactly this one's state, which goes on to give what this one
  // will
  pub fn copyOf(self: &) Sha1 { Sha1(h, buf, used, total) }

  // Back to a hasher that has taken nothing
  pub fn reset(self: &mut) {
    h = [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32, 0xc3d2e1f0u32];
    used = 0usize;
    total = 0u64;
  }

  // How many bytes the hasher has taken
  pub fn length(self: &) u64 { total }

  // Takes more of the message
  pub fn update(self: &mut, data: &Array[u8]) {
    let n = data.len;
    var at = 0usize;
    total = total + u64.from(n);
    // Finish a block begun by an earlier call
    if used > 0usize {
      while at < n && used < 64usize {
        buf[used] = data[at];
        used = used + 1usize;
        at = at + 1usize;
      }
      if used == 64usize {
        let block = buf;
        sha1Blocks(&mut h, &block, 0usize, 1usize);
        used = 0usize;
      }
    }
    // Whole blocks straight from the message
    let whole = (n - at) / 64usize;
    if whole > 0usize {
      sha1Blocks(&mut h, data, at, whole);
      at = at + whole * 64usize;
    }
    // What is left waits for the next call
    while at < n {
      buf[used] = data[at];
      used = used + 1usize;
      at = at + 1usize;
    }
  }

  // The hash of everything taken. The hasher itself is left as it was, so it
  // can take more and be asked again
  pub fn finish(self: &) Array[u8, 20] {
    var t = self.copyOf();
    t.pad();
    var out = Array[u8, 20]() <- fill 0u8;
    var i = 0usize;
    while i < 5usize {
      out[i * 4usize] = u8.from(t.h[i] >> 24u32);
      out[i * 4usize + 1usize] = u8.from((t.h[i] >> 16u32) & 0xffu32);
      out[i * 4usize + 2usize] = u8.from((t.h[i] >> 8u32) & 0xffu32);
      out[i * 4usize + 3usize] = u8.from(t.h[i] & 0xffu32);
      i = i + 1usize;
    }
    out
  }

  // The padding: a 1 bit, zeros, and the message's length in bits as 64 bits
  fn pad(self: &mut) {
    let bits = total << 3u64;
    buf[used] = 0x80u8;
    used = used + 1usize;
    if used > 56usize {
      while used < 64usize { buf[used] = 0u8; used = used + 1usize; }
      let block = buf;
      sha1Blocks(&mut h, &block, 0usize, 1usize);
      used = 0usize;
    }
    while used < 56usize { buf[used] = 0u8; used = used + 1usize; }
    var i = 0usize;
    while i < 8usize {
      buf[56usize + i] = u8.from((bits >> (56u64 - 8u64 * u64.from(i))) & 0xffu64);
      i = i + 1usize;
    }
    let block = buf;
    sha1Blocks(&mut h, &block, 0usize, 1usize);
    used = 0usize;
  }
}

// Takes the SHA-1 of a whole message. LEGACY: see Sha1
pub fn sha1(data: &Array[u8]) Array[u8, 20] {
  var s = Sha1.make();
  s.update(data);
  s.finish()
}

// The compression function over 'count' blocks of 64 bytes that start at
// 'start' in 'data', folded into the chaining words 'h'. The four round
// constants are written where they are used
fn sha1Blocks(h: &mut Array[u32, 5], data: &Array[u8], start: usize, count: usize) {
  var w = Array[u32, 80]() <- fill 0u32;
  var at = start;
  var blk = 0usize;
  while blk < count {
    var i = 0usize;
    while i < 16usize {
      let p = at + i * 4usize;
      w[i] = (u32.from(data[p]) << 24u32) | (u32.from(data[p + 1usize]) << 16u32)
           | (u32.from(data[p + 2usize]) << 8u32) | u32.from(data[p + 3usize]);
      i = i + 1usize;
    }
    while i < 80usize {
      w[i] = (w[i - 3usize] ^ w[i - 8usize] ^ w[i - 14usize] ^ w[i - 16usize]).rotateLeft(1u32);
      i = i + 1usize;
    }
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    i = 0usize;
    while i < 80usize {
      var f = 0u32;
      var kk = 0u32;
      if i < 20usize {
        f = (b & c) | ((b ^ 0xffffffffu32) & d);
        kk = 0x5a827999u32;
      }
      else if i < 40usize {
        f = b ^ c ^ d;
        kk = 0x6ed9eba1u32;
      }
      else if i < 60usize {
        f = (b & c) | (b & d) | (c & d);
        kk = 0x8f1bbcdcu32;
      }
      else {
        f = b ^ c ^ d;
        kk = 0xca62c1d6u32;
      }
      let t = a.rotateLeft(5u32) + f + e + kk + w[i];
      e = d;
      d = c;
      c = b.rotateLeft(30u32);
      b = a;
      a = t;
      i = i + 1usize;
    }
    h[0] = h[0] + a;
    h[1] = h[1] + b;
    h[2] = h[2] + c;
    h[3] = h[3] + d;
    h[4] = h[4] + e;
    at = at + 64usize;
    blk = blk + 1usize;
  }
}
