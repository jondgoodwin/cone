// Hashing a message in one call and in pieces, a MAC, and checking a tag. Every
// line printed is the same on every machine.
//
//   congo run examples/tour.cone

mod tour;

import stdio use *;
import collections use *;
import cryptohash;

fn hexOf(s &Array[u8]) String {
  mut h = String.empty();
  mut i = 0usize;
  while i < s.len {
    h.appendHex(u64.from(s[i]), 2usize);
    i = i + 1usize;
  }
  h;
}

fn show(name &str, bytes &Array[u8]) {
  imm hex = hexOf(bytes);
  printStr(name);
  printStr(" ");
  printStr(hex.view());
  printStr("\n");
}

fn main() i32 {
  // A whole message in one call
  imm d256 = cryptohash.sha256("abc");
  show("sha256 abc", &d256);
  imm d512 = cryptohash.sha512("abc");
  show("sha512 abc", &d512);

  // The same message in pieces: the hasher is a value, fed with 'update'
  mut h = cryptohash.Sha256.make();
  h.update("a");
  h.update("bc");
  imm streamed = h.finish();
  show("sha256 a+bc", &streamed);

  // SHA-1 is legacy: here for formats that still name it
  imm d1 = cryptohash.sha1("abc");
  show("sha1   abc", &d1);

  // A message authentication code (RFC 4231 test case 2), and checking a tag
  imm tag = cryptohash.hmacSha256("Jefe", "what do ya want for nothing?");
  show("hmac-sha256", &tag);
  mut mac = cryptohash.HmacSha256.make("Jefe");
  mac.update("what do ya want ");
  mac.update("for nothing?");
  printStr(if mac.verify(&tag) { "tag accepted\n"; } else { "tag refused\n"; });
  mut forged = tag;
  forged[0] = forged[0] ^ 1u8;
  printStr(if mac.verify(&forged) { "forged tag accepted\n"; } else { "forged tag refused\n"; });
  0i32;
}
