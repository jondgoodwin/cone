// The actors package: the runtime Cone's actors run on. An actor is state
// that lives on, reached by nothing but messages: each message is a call of
// one of its behaviours (its methods declared 'async fn'), queued in its
// mailbox and run later, one at a time, on whichever worker thread takes the
// actor up. A behaviour runs to completion on that worker's own stack, or to
// an 'await', where the compiler cut it in two (AWAITING, below): nothing is
// suspended on a stack. The package has
// the mailbox, the work-stealing scheduler that runs mailboxes on a pool of
// OS threads, the counting that decides when an actor dies, and the
// quiescence the program ends at. It starts and stops by itself: the workers
// start with the first actor, and the module's finalizer waits until all is
// quiet and stops them.
//
//   import actors;
//
//   actor Counter {
//     count u64;
//     fn init(self: &new, start u64) {*self = Self(count: start);}
//     pub async fn add(self, n u64) {count = count + n;}
//   }
//
//   fn main() {
//     imm c = Counter(0u64);         // the first actor starts the workers
//     c.add(5u64);                       // a message: queued, run later
//     c.add(7u64);                       // run after the first
//   }                                    // then the program's final waits until all is quiet
//
// An actor is declared with 'actor' (the reference manual, "Actors"), and a
// module declaring one imports this package. What it has:
//
//   actors.configure(opts)          before the first actor: how many workers,
//                                   and the batch limit (actors.Options)
//   actors.stats()                  what the workers have done so far: Stats
//   actors.workerIndex()            the worker running the caller, or
//                                   actors.noWorker
//   actors.Mailbox[M]               what an actor's handle owns: the runtime's
//                                   part of an actor taking messages M
//   actors.makeActor[S, M](&dispatch)
//                                   a new actor's block: where its state goes
//   actors.startActor[S, M](st)     the actor, its state made: its
//                                   'Arc[opaq, Mailbox[M]]'
//   actors.send[M](mb, msg)         queue msg in the actor's mailbox
//   actors.sendable(v)              v, if it may cross threads (the check)
//   actors.Awaitable[R]             an operation a behaviour may 'await', whose
//                                   answer is an R (AWAITING, below)
//   actors.Future[T]                a behaviour's value kept, to 'await' later
//                                   (FUTURES, below)
//   actors.liveFutures()            how many futures are not yet freed
//   actors.parkBlocks()             the record blocks and per-thread keeps the runtime has
//                                   taken from the allocator and given back (RECORD BLOCKS KEPT)
//   actors.liveSegments()           how many mailbox segments are not yet freed
//   actors.messageAllocs()          how many allocations the runtime has made
//                                   for messages (THE MAILBOX, below)
//   actors.liveSegmentBytes()       the bytes of those segments
//   actors.mailboxDepth(mb), mailboxHighWater(mb), mailboxBytes(mb),
//   setMailboxLimit(mb, n), mailboxTooFull(mb)
//                                   what a mailbox holds and when it is too
//                                   full (MAILBOX LIMIT, below)
//   actors.waitQuiet()            wait until no actor is queued or running
//   actors.waitUntilIdle()          INTERIM: wait until no actor is queued or
//                                   running and no awaited operation is
//                                   outstanding (WAITING FOR IDLE, below)
//   actors.parallelRange(lo, hi, grain, body)
//                                   run body, a callable taking (lo, hi), over
//                                   [lo, hi) in pieces spread over the workers,
//                                   and wait for all
//                                   (PARALLEL LOOPS, below, and parallel.cone)
//   actors.parallelRangeThen(lo, hi, grain, body, onDone)
//                                   the same, not waiting: the last piece
//                                   calls onDone
//   actors.parallelEach(lo, hi, piece, data)
//                                   what a 'parallel each' runs through: the
//                                   same with a grain chosen for the workers (at least 128),
//                                   the pieces' sends sent after the loop in
//                                   iteration order. The compiler's code calls it
//                                   with a function reference and a record
//   actors.parSum(view), parFold(view, init, step, combine), parFindFirst(view, pred)
//                                   what 'xs.parallel().sum()', 'fold' and
//                                   'findFirst' become: a reduction over a view
//                                   of a source that can split itself, the same
//                                   result with any number of workers
//                                   (reduce.cone has the account)
//
// The five before Awaitable are what an actor's own code calls, and the compiler
// generates that code from the 'actor' declaration
// (compiler/c/parser/parseactor.c). The package is 'actors' because 'actor'
// (the declaration's keyword) is a keyword, as are 'async' and 'do', and
// 'spawn', 'wait' and 'yield' are reserved; and it is a package of its own, not a module of sync, because
// it starts threads, and the thread package imports sync, so sync cannot
// import thread. It is all Cone, over the thread package's threads and sync's
// futex, Mutex, Once and 'Arc': nothing it does needed C.
//
// THE SHAPE OF AN ACTOR. For the Counter above the compiler generates four
// declarations, named as no source can spell, so that nothing but the actor
// reaches them:
//
//   (a) The state, 'Counter.State': a struct of the actor's fields and its
//       methods, behaviours and synchronous ones alike, as written, a bare
//       'self' taken as 'self: &mut'. It declares nothing about Sendable: it
//       never crosses threads as a value, since only the runtime reaches it
//       (INSIDE AN ACTOR, below).
//   (b) The message enum, 'Counter.Msg', declaring Sendable on the strength
//       of the compiler's check of every behaviour's parameters: one variant
//       per behaviour, named for it, whose fields are its parameters.
//
//         enum Counter.Msg is Sendable {struct add {n u64;}}
//
//       A behaviour that returns a value has a second variant, sent awaited,
//       carrying a Reply too. (A reply to an await is no variant of the
//       enum: it is a slot of its own kind in the mailbox, REPLIES, below.)
//
//   (c) The handle, 'Counter': one field, the 'Arc[opaq, T]' owner of the
//       actor's Mailbox that startActor answers; an initializer for each of
//       the state's, which makes the actor's block, runs the state's init in
//       it, and starts the actor (A NEW ACTOR, below); and a send function per
//       behaviour, as public as it, which builds the variant and sends it.
//
//         struct Counter {
//           mailbox Arc[opaq, actors.Mailbox[Counter.Msg]];
//           fn init(self: &new, start u64) {
//             imm st = actors.makeActor[Counter.State, Counter.Msg](&Counter.dispatch);
//             mem.writeRaw[Counter.State](st, Counter.State(start));
//             *self = Self(mailbox: actors.startActor[Counter.State, Counter.Msg](st));
//           }
//           pub fn add(self: &, n u64) {
//             actors.send[Counter.Msg](mailbox, Counter.Msg.add[n]);
//           }
//         }
//
//   (d) The dispatch function, 'Counter.dispatch', handed each message where
//       it lies in its slot: it tests which variant the message is, moves
//       each argument out of it, and calls the behaviour. The slot is then
//       done with, nothing in it finalized, so each argument is moved exactly
//       once.
//
//         fn Counter.dispatch(self: &uni Counter.State, msg *Counter.Msg) {
//           if &*msg is &Counter.Msg.add {
//             imm p = msg as *Counter.Msg.add;
//             self.add(take(&(*p).n));     // take: mem.readRaw of the field
//           }
//         }
//
// The order of the four does not matter, and the compiler writes the state,
// the handle, the message enum and the dispatch function in that order. A
// message enum holds handles by value (a Player's 'meet' holds a Player), and
// a handle reaches the enum again only through its owning reference to the
// Mailbox, which does not lay out what it points at, so the enum may come
// before or after the handle and the state, and so may any declaration that
// lays the handle out (the test suite's concurrency_actor_order and
// concurrency_actors_declared_last).
//
// THE HANDLE is an actor's name to the rest of the program: a struct over
// one 'Arc[opaq, T]' owner of the actor's Mailbox, the runtime's part of it, so
// the sync package's 'Arc' counts handles. Copying a handle (passing it,
// storing it, putting it in a message) makes another owner; each going drops
// one. A handle reaches nothing of the actor's state, whose type is not in
// it: its only use is to send, and 'opaq' lets nothing read or write even
// the Mailbox through it. What the Mailbox holds is the runtime's alone: its
// one field is private, and of a type private to this package, so nothing
// outside the package can name, read or write it.
//
// A handle is Sendable because Mailbox declares Sendable, once, here, as a
// channel's ends do: the runtime orders every hand-off of what it holds.
// Its type argument is the message enum, which must be Sendable, and which
// ties a handle to its actor's messages: 'send' takes only an M for a
// Mailbox[M]. Nothing about the state is asked, so a state may hold what may
// not cross threads ('Rc', a 'mut' owner of either kind) and its handle
// still crosses: in a message, to a thread, into another actor's state.
//
// ONE ALLOCATION PER ACTOR. The 'Arc' allocation holds the Mailbox and then
// the state, so that a send touches one block. 'Arc' sees only the Mailbox,
// so the Mailbox finalizes the state: its Header carries a function,
// 'finalize', made for the state's type when the actor started, which the
// Mailbox's finalizer calls before the block is freed. The mailbox's slots
// are not in the block: they are in segments of their own (THE MAILBOX,
// below), the first allocated with the block.
//
// A NEW ACTOR is real before its state's 'init' runs, and that init runs on
// the state where it will stay: the handle's initializer makes the block, the
// state unmade (makeActor), runs the init in it (a construction written raw
// fills the place it is written to), then starts the actor (startActor). So
// 'selfactor', and a send to the actor itself, are good inside the init and
// anything it calls. The actor runs no message until the init returns: its
// mailbox starts BUSY, not idle, as though a worker were running it, so a
// send made meanwhile -- by the init, or by another actor handed the handle
// -- queues its message and schedules nothing. startActor then does what a
// worker does at the end of a turn: it marks the mailbox idle or, finding
// messages there, takes the scheduler's owner and queues the actor, which
// runs them in the order sent. A panic in the init is the panic: the program
// ends, and the block is never freed.
//
// AN ACTOR'S LIFE. An actor lives while anything holds a handle to it or it
// has a message to handle. While it is queued to run, or running, the
// scheduler holds one owner of it too, taken by the send that found it idle
// and dropped when the worker running it finds its mailbox empty and marks
// it idle. So its death, the last owner's going, comes only when its last
// handle has gone AND its mailbox is empty: a handle dropped with messages
// queued leaves the scheduler's owner to keep it alive until they are
// handled. Its death runs its state's finalizer ('final', then its fields',
// its handles to other actors among them), exactly once, on whichever thread
// let go last: the thread dropping the last handle to an idle actor, or the
// worker that ran its last message; then the block is freed. A cycle of
// actors holding handles to each other never dies by counting, as a cycle
// of 'Arc' owners never does; actors break such a cycle by letting go
// (concurrency_actors_pingpong). An actor still alive when the program ends
// is never finalized.
//
// MESSAGES. A send is one-way: it queues the message and returns; nothing
// waits for the behaviour to run, and what it returns is dropped, unless
// the message was awaited (AWAITING, below). Each sender's
// messages to one actor are handled in the order sent, and a message is
// never overtaken by one it caused: the mailbox is one FIFO queue in the
// order the sends took their places, and a send has taken its place before
// it returns. What a message carries must be Sendable, which the compiler
// asks of every message's parameters, and of every initializer's, where they
// are declared, and 'send', 'makeActor' and Mailbox ask of the message enum:
// numbers, 'uni' and 'Uni' owners (which move), 'Arc[imm, T]' and lock-managed
// 'Arc' owners, handles; never a borrow, a 'mut' owner, an 'Rc' owner or a
// 'Gc' reference. actors.sendable is the same check, for code written by hand.
//
// INSIDE AN ACTOR. A method has its state 'mut' and runs alone: no other
// method of the same actor runs until it returns. It may use anything a
// single thread may, borrows and 'Uni' and 'Rc' owners included, however the
// actor moves between workers. The state is made on the thread that starts
// the actor, from Sendable arguments, and from then on is reached by the
// runtime alone -- by the worker running the actor, from the Mailbox, and
// by the finalizer at its death -- never by a handle. That is why it needs
// to be nothing: the state is not Sendable, and is refused wherever it
// would cross threads as a value (a channel, a thread's start), while the
// runtime's own hand-offs move the whole actor, in order:
//
// - 'Rc' needs no atomic count inside an actor, since one worker at a time
//   runs it, and every hand-off of an actor from one worker to the next
//   orders all the first did before anything the next does. The hand-offs,
//   and where each is ordered: an actor queued again after its turn is
//   pushed to a run queue with a Release store and taken with an Acquire
//   compare-and-swap (or stolen with one); an actor marked idle is marked by
//   an AcqRel compare-and-swap on its mailbox's tail, which the next send's
//   claim, an add on the same word, reads, or (when it stopped to wait for a
//   slot) by an AcqRel compare-and-swap on that slot's word, which the
//   publication's exchange of it reads; and the sender that finds the mark
//   queues the actor (Release) for a worker to take (Acquire); and its death follows 'Arc's
//   Release decrement and Acquire load. Each chain is release to acquire, so
//   what one method did happens before the next method runs, wherever.
// - The collector package's 'Gc' is NOT supported inside an actor. That
//   collector is single-threaded and an actor runs on every worker in turn: a
//   traced reference made, held, reached or dropped by an actor corrupts it.
//   The compiler refuses one made or held in an actor, in its state, its
//   methods' parameters or its methods' bodies (ErrorGcStopgap), and the thread
//   check refuses 'Gc' in a message. Every actor has a collector of its own, a
//   part of this package (gc.cone): 'ActorGc', a region whose values 'new
//   self[T](...)' makes and a copying collector frees between the actor's
//   messages. The region's record is kept by the actor's Header, made when the actor first asks for it;
//   after each message a worker asks it to collect, if the actor has used it,
//   with the actor's state and its type record, whose trace hands the collector
//   every reference the state holds, the pending table's records among them
//   (Pending is GcTraceElements, a record an Erased value naming it and its
//   own type record); the actor's death finishes the region, after its state's
//   death. Nothing is collected while a 'parallel each' the behaviour began is
//   still to run its passes.
// - A thread-local global ('mut @threadlocal x T') seen from an actor's
//   method is the current WORKER's copy, not the actor's: its next message
//   may run on another worker, with another copy. An actor keeps its own
//   state in its fields.
// - A method that blocks (a lock held long, a sleep, a channel's recv) holds
//   its worker for as long, and the others take up its queue by stealing; a
//   method that never returns keeps its actor, and one worker, forever.
//   Actors wait by being sent a message, or by 'await'.
//
// AWAITING. In an actor's behaviour, 'imm b = await fetcher.fetch(u)' sends
// fetch to the actor 'fetcher' awaited, and waits for what it returns. The
// compiler cuts the behaviour there (compiler/c/genllvm/genlawait.c): its first
// half returns to the dispatcher at the 'await', and what it still needs --
// its record -- waits in its actor's PENDING TABLE, a hidden field of the
// state, keyed by a plain id; its second half runs the rest when the reply
// comes. The generated code calls what follows 'releaseHold', below:
//
// - The request carries an envelope, a Reply, in the message, beside the
//   arguments; the method's signature is as written. The awaiting actor
//   makes it (replyFor): one count of the awaiting actor, so it cannot die
//   while the reply is owed, the seam's resume function (which second half)
//   and, where the record is not empty, its id (parkReserve) -- an empty
//   record has no slot and no id -- and the size of the value awaited. Nothing
//   is allocated: the actor answering claims the slot then (REPLIES, below).
// - The actor answering claims a slot in the awaiting actor's ring, writes
//   the resume function, the id and the value into it, and publishes it
//   (answerNow, answerAt, answered), knowing nothing of the awaiting actor's
//   type; the count becomes the scheduler's owner, or is let go.
// - The awaiting actor's worker finds the slot in its mailbox, in its place
//   among the messages, and calls the resume function (resume, resumeId), which
//   takes the record out of the table (unpark) and calls the second half with
//   it and the value.
// - A behaviour that returns a value and itself awaits keeps the envelope it
//   answers in its state's Answer slot while it runs (ask, askNone); each
//   seam carries it in the record, so whichever half returns the value
//   answers (answerTo).
//
// What is awaited may instead be an OPERATION, an Awaitable[R]: something its
// maker starts at the seam, whose one answer is an R -- the aio package's I/O
// operations are Awaitables. The seam makes the same envelope and hands it to
// the operation's start function (startAwait), which arranges for whatever
// finishes the operation, on whatever thread, to write the R into it as
// answerNow does; the reply then resumes the behaviour as any reply does. The
// 'await''s value is the R as the operation declared it. An operation is made
// from a closure (Awaitable.make: the closure is a block of its own) or from a
// context word and two plain functions (Awaitable.of: nothing is allocated);
// and an answer too large for a slot need not be boxed if the operation keeps
// a place of its own for it: answerLent (LENT ANSWERS, below), which is how the
// aio package answers a socket's read with no allocation at all. An operation
// that keeps the envelope itself, in a record of its own, answers it there
// (answerNowIn, answerLentIn: ANSWERED IN PLACE, below), which leaves it spent.
//
// FUTURES. A call of a behaviour returning a T whose value is kept, 'imm fut =
// peer.count()', sends the request awaited at once and gives a Future[T]: the
// handle's method the compiler generates for it makes a future, Pending
// (futureFor), and the request's envelope is the future's producer's
// reference, a Reply whose 'cell' is the future (futureReply), so the actor
// answering writes the value into the future as answerNow writes it into a
// reply, knowing nothing of who will await it. An 'await' on the future goes
// on at once if it has its ending (futureReady), and otherwise parks as an
// awaited request does, its envelope parked on the future (futureRegister: a
// Waiter is allocated, the one allocation an await makes, and only for a
// future that has not arrived) until the future publishes its resume to the
// awaiting actor's ring; either way the value is opened
// out of the future (futureOpen, futureTaken). futures.cone is the future
// itself: the futures region, Future[T], and the protocol.
//
// One request has one reply, exactly once: a slot is freed only by its
// reply. A continuation waiting holds its actor alive through the envelope's
// count. Its request is a message in another actor's mailbox, that actor's
// own continuation, or an operation in flight: quiescence is found with
// continuations parked only on operations, which the aio package ends at the
// program's end. A continuation whose envelope is dropped unanswered is
// ABANDONED: when its actor dies -- the envelope's count gone, nothing else
// holding it -- the pending table drops its record, through the drop function
// the compiler made for the seam, so each value the paused behaviour held is
// finalized in the order its one scope gives, and the rest of the behaviour
// never runs.
//
// THE RUNTIME starts and stops by itself. Its workers start with the first
// actor, on whichever thread starts it (sync's Once makes two first starts
// at once start them once); a program that starts no actor starts no thread.
// They start lazily, not in the module's initializer, because a program
// chooses their number with 'actors.configure' in its 'main', which runs after
// every initializer, and a program with no actor must start no thread (the
// initializer only sets the module's own globals). 'actors.configure(
// actors.Options(workers: n, batch: b))', called before the first actor
// starts, sets n workers (0, the default, is one per logical processor,
// thread.parallelism()) and a batch limit b (actors.defaultBatch, 100, by
// default; 0 is taken as 1); called once they have started, it is a panic.
// It is not synchronized with a first start on another thread: configure
// first.
//
// The module's finalizer, run by the program's final, stops them. It waits
// until the runtime is QUIESCENT -- no actor is queued or running, so no
// message is in any mailbox -- then stops the workers and joins them. The
// final finalizes the program's own module first, so the handles its globals
// hold are let go before the wait; handles in main's locals are let go when
// main returns, before the final begins. (A program that calls finalAll()
// itself, as programs did before the entry was built, waits at that call and
// puts the actors it starts in a block that ends before it.) The runtime is
// not started again: starting an actor or sending a message after the
// finalizer has stopped the workers is a panic, since nothing would ever run
// the message. So is finalAll() on one of the workers, which would wait for
// itself.
//
// The final is run by the entry the compiler builds round main (the
// reference manual, "Running every module's initializer and finalizer"),
// when main returns. A program that panics or calls C's exit ends whatever
// the actors are doing: messages still in flight are dropped silently, and no
// actor still alive is finalized.
//
// WAITING FOR IDLE (INTERIM). A program whose actors await I/O or a timer
// ends as soon as 'main' returns if no actor is queued or running: an actor
// paused on an operation is neither, so the finalizer above finds quiet, the
// aio package ends the I/O, and the paused behaviour is abandoned. A program
// that wants that work done calls 'actors.waitUntilIdle()' as the last thing
// 'main' does. It returns when no actor is queued or running AND no awaited
// operation is outstanding: every operation an 'await' started (an
// Awaitable's, which the aio package's I/O all is) has been answered, and
// what its answer started has run. A program that never goes idle, a
// listening server above all, never returns from the call; it has no timeout.
// A call made when nothing is going on returns at once, and one before any
// actor starts starts no worker. The call is a stopgap: how a program ends
// with I/O in flight is to be designed (the concurrency skein), and this
// call may then change or go. A program that does not call it ends as it did.
// An operation is counted from the seam that starts it (startAwait) until its
// reply is spent, answered or dropped (Reply's finalizer), so any
// Awaitable's maker is counted without doing anything.
//
// Quiescence is judged on the assumption that, once the finalizer has begun,
// every message is sent by an actor: a thread other than main that goes on
// sending must be joined first, or its message may be the one that arrives
// after the workers have stopped. Main sends nothing while it waits. The aio
// package's I/O thread sends replies too; its own finalizer, which finalAll()
// runs before this one, waits for quiet (waitQuiet), ends the I/O, and joins
// the thread.
//
// 'actors.stats()' answers what the workers have done so far (Stats:
// workers; messages handled; turns, an actor taken from a queue and run;
// steals; loop pieces stolen; the idle workers' spins, begun, ended by work
// and ended by their bound, and their parks: IDLE WORKERS, below), counts
// read without stopping them, safe on any
// thread at any time, even while the stop frees the runtime (STATS, below);
// before the first actor, all 0; once stopped, the run's totals.
// 'actors.workerIndex()' is the index of the worker running the caller, 0 up
// to the number of workers less 1, or actors.noWorker on any other thread: for
// tests, and for per-worker tallies.
//
// TRACING HOOKS. Three events -- a message sent (and a reply, which is a
// message too), a message's run beginning, a message's run ending -- are
// handed to a sink function if their layer is switched on in a mask: one
// relaxed load and a bit test when it is not. The sink is the tracing
// package's (actortrace), which this package knows nothing of: it calls
// whatever 'traceSetSink' was given. Each message carries the id of the send
// that made it in its slot's cause word, so a send's record and its run start
// give the message's time in the mailbox, and the sends a behaviour makes name
// it as their cause. The section TRACING HOOKS, below, is the account.
//
// THE MAILBOX is a ring of fixed-size slots, grown in linked segments (the
// code is under "The mailbox", below). A slot is a 16-byte header, then a
// payload. The header's first word, 'seq', is the slot's publication; its
// second, 'cause', is the id of the send that made the message (TRACING HOOKS,
// below), 0 when the hooks are off. The payload is the message M itself,
// in the size of M rounded to 16 bytes and not under 32: the size of a slot
// follows from M, so it is as big as the actor's largest message needs. A send
// allocates nothing:
//
// - It CLAIMS a position with one atomic add on the mailbox's 'tail' word
//   (bits 0 to 62 count the positions claimed, one per send, from 0; bit 63
//   is the idle mark, below). The consumer takes positions in order, so each
//   sender's messages are handled in the order sent, and a send has taken its
//   place before it returns.
// - It finds the position's slot. A segment covers the positions from its
//   'base' for its 'count' slots. The sender starts at the 'hint', the last
//   segment a sender used, and follows 'next' links while the position lies
//   beyond. Past the last segment it links one: a spare if there is one,
//   else a new segment, put on with a compare-and-swap of the last one's
//   'next'; if another sender's got there first, that one is used and this
//   sender's is kept as a spare. A sender past the middle of a segment of 8
//   slots or more links the next one ahead (the first to take the segment's
//   'ahead' flag does it), so that later senders find it there. No sender
//   ever waits for another's progress: each only does the work itself.
// - It writes the message into the slot, in place: dispatch is handed a pointer
//   to the payload and moves each argument out of it.
// - It PUBLISHES with one exchange of 'seq', to the position times 8 plus a
//   kind. A slot is the consumer's to take when its 'seq' is that, for the
//   position the consumer is at; any other value (zero in fresh memory, or the
//   publication of a position gone by) is not.
//
// The worker running the actor, the consumer, takes the slot at its 'head'
// position when it is published, and goes on to the next. It reads the
// published payload with an Acquire load of 'seq', the sender's exchange being
// the Release. It never waits for a sender: a slot that is not published, or
// a segment not yet linked, is simply not ready.
//
// An actor has no segment until it is sent a message: the first send makes
// the first, of 2 slots (so an actor never messaged costs its block and
// nothing else; firstSeg says how senders arriving together at a new actor
// make it, with one compare-and-swap and no waiting). Later segments grow by
// a factor of 4 up to 256 slots (or the most that fit in 16 KB), but not past
// what the queue asks (twice its depth, rounded up to a power of two, and not
// under a "small" segment of about 2 KB of slots). With the 16-byte header and
// 32-byte minimum payload, an actor sent a message holds a segment of at least
// 32 + 2 * 48 bytes. Nothing limits a mailbox yet: it grows as the senders
// outrun the consumer (MAILBOX LIMIT, below).
//
// THE IDLE MARK. A mailbox whose actor is not queued or running is idle, and
// the next send schedules the actor. Exactly one sender does, and the actor is
// never left idle with a message in its mailbox. There are two ways the
// consumer comes to rest, because a position may be claimed and not yet
// published:
//
// - Nothing is claimed beyond what it has taken ('tail' counts exactly the
//   positions taken): it marks the mailbox idle with one compare-and-swap of
//   'tail', from the count to the count with bit 63. A send claims by adding to
//   the same word, so either its claim comes first, the compare-and-swap fails,
//   and the consumer goes on to the second way below (or, finding the message
//   published, goes on running), or the compare-and-swap comes first and the
//   claim finds the bit. A sender whose claim found the bit set, having
//   published, clears it with an atomic and: the sender that clears it is the
//   one to schedule the actor (the others find it clear). It takes the
//   scheduler's owner of the actor and queues it.
// - A position is claimed and its slot is not yet published (see the next
//   section): it parks on that slot.
//
// A SLOT CLAIMED AND NOT YET PUBLISHED. A sender can stop between its claim and
// its publication (preempted, or stalled by the test hook, stallNextPublish).
// The consumer, reaching that position, finds a slot it cannot take, and it
// must neither wait for the sender nor go idle in a way that loses the actor
// when the publication lands after it has stopped. It parks on the slot: it
// changes the slot's 'seq' with one compare-and-swap, from what it held to
// position * 8 + 7, kindWaiting, and returns to the scheduler, which lets go
// of the actor (it is idle, and the worker did not spin). The sender's
// publication is the exchange of the same word, and it answers what the word
// held. The two operations are on one word, so one comes after the other:
//
// - If the consumer's compare-and-swap comes second, it fails, because the
//   word is the publication, and the consumer finds the message there and goes
//   on to take it. Nothing is parked and nothing needs scheduling.
// - If the sender's exchange comes second, it answers the waiting mark, and
//   this sender schedules the actor: it takes the scheduler's owner and queues
//   it, as for the idle mark. The message published, and every message behind
//   it that was published meanwhile, are taken in order when the actor runs.
//
// So the sender whose publication lands after the consumer has stopped is the
// one that schedules it, whichever way it stopped: the one that finds the
// waiting mark in the slot, or the one that clears the idle mark. Messages
// published behind the parked slot schedule nothing (they find neither mark:
// the idle mark is set only when nothing is claimed beyond what is taken), so
// a stalled sender costs the workers nothing while it is stalled. If the
// segment holding the position has not been linked yet (the sender that
// claimed it is still looking for one), the consumer links it, as a sender
// would, to have a word to mark. A position claimed before the actor's init
// returned, and unpublished, is handled the same way by startActor.
// (packages/actors/tests/ringstall.cone holds a sender between claim and
// publication, with 3,000 messages published behind it, with the consumer
// idle and with it busy when the sender claims.)
//
// SEGMENTS ARE REUSED, a drained segment as soon as no sender can reach it,
// not when the mailbox falls quiet, so that a mailbox with a continuous stream
// into it (never idle) allocates nothing once its segments have filled to the
// most the stream queues (packages/actors/tests/ringstream.cone: a stream of
// 1,500,000 messages through some 24 segments). A sender reaches a segment
// only between its claim and its publication: it claims first, then reads the
// hint and walks, and touches no segment after it publishes. When the
// consumer moves on from a segment it (1) moves its own segment, which senders
// read, and the hint, off it, and (2) notes how many positions had been claimed
// then, the segment's 'mark'. A sender that claimed after the note read the
// hint and the consumer's segment after they had moved (the claim, the moves
// and the note are all sequentially consistent), so it holds a segment ahead
// of this one. A sender that claimed before it holds a position below the
// mark; the segment is reusable once every position below the mark is
// published (the consumer looks ahead through the slots, once each, to see:
// publishedUpTo), since a sender that has published touches no segment. Then
// it goes to the pool, up to a budget in BYTES of twice the mailbox's recent
// high-water mark (not under a small segment, the floor, nor over 256 KB), and
// the pool fills the spare places, 16 of them, from which senders take the
// segment they link. A kept segment too small for the growth of the ring is
// freed. Segment memory is returned to the allocator by this freeing, by the
// giving back at rest (below) and at the actor's death.
//
// COMING TO REST. A mailbox that grew and then fell quiet must not keep what
// it grew for as long as its actor lives: with a great many actors that is
// most of the memory. When the consumer finds nothing claimed beyond what it
// has taken, just before it marks the mailbox idle (atRest): the high-water
// mark halves (so the budget follows recent use, not the all-time peak). An
// actor with nothing above the floor to give back returns at once. A rest
// that follows GROWTH since the previous one trims what is kept to the budget
// (keepBudget: twice the high-water mark in slots, between the floor and
// 256 KB) and no further; a CALM rest (no growth since the previous one)
// reclaims the drained segments that can be reused, trims what is kept to the
// floor, two small segments less those a sender has linked beyond the ring's
// own already (restFloor, trimKept; the linked ones are the ring's and stay),
// and, if the segment the ring is in is
// larger than a small one, gives up its remaining slots and goes on in a
// small one (shrinkChain: one compare-and-swap of the
// tail claims the slots, the segment is retired as a drained one, and the next
// is the one linked ahead or a small one linked now; never more than two rounds
// and the position moves before anything is linked, or the segment linked would
// be sized for the slots just claimed, as if they were queued). Nothing in it
// waits for a sender: a send claiming a position meanwhile finds the swap fail
// (and nothing is done) or lands past the segment's end, where it links as it
// would anyway. The result is that an actor sent one burst and then nothing
// holds three small segments (the one the ring is in and two more, linked or
// kept: about 7.7 KB with 64-byte slots) after two rests, however it came to
// them; under load, where a send can come into a rest, a rest may be left
// holding one or two more for a rest or two (the tests' bound: at most six
// segments, 20 KB, and the 8 KB bound broken in at most 8 of 400 rests: the
// rests that still hold four are the case of a segment a sender linked ahead
// while the rest was being made, which is never trimmed, being the ring's),
// and after one at most what the burst's budget allows (about 32 KB at 64-byte
// slots), not the ring the burst made. A mailbox that is never quiet never
// gets there. One that falls quiet for a moment in a stream keeps most of what
// it kept (the budget) after a growth rest, and gives the rest back at a calm
// one, allocating again when the stream goes on: the cost of the fix, paid in
// allocations, not in latency (packages/actors/tests/ringstream.cone keeps
// ballast in its consumer's ring so that it is quiet for no moment; without,
// a busy machine drained it some dozens of times in 1.5 million messages and
// the allocations did not stop).
//
// REPLIES. An await is a seam: its continuation is the receipt of another
// message in the same ring. The reply's slot is claimed at reply time, in the
// awaiting actor's ring, by whoever answers (an actor, an I/O thread, a future
// that has arrived), who writes the resume record into the payload and the
// value after it, and publishes it with a kind of its own (2 to 5, a message
// being 1). The record is the seam's resume function and the id of its record
// in the pending table (replyHead, 16 bytes); the value follows if it fits
// the rest of the payload, else it is in a box allocated at reply time (a value
// larger than the payload less 16 bytes, or aligned over 16), freed by the
// awaiting actor's worker after the second half has taken it. The
// Reply envelope carries what that needs: the awaiter's Header, the resume
// function, the id, and the size of the value, which tells whether it is boxed
// (replyFor). When the consumer reaches the slot, runBatch calls the resume
// function through resume or resumeId (resumeSlot). A kept future that has not
// arrived when it is awaited allocates a Waiter (futures.cone), which
// publishes the same kind of slot, carrying the consumer's reference to the
// future as its value, when the future ends.
//
// MAILBOX LIMIT. The ring counts what it holds: bytes of segments (mailboxBytes),
// the most queued at once, seen at the start of each of the worker's turns
// (mailboxHighWater), the depth now (mailboxDepth), and a limit that the
// holder of the Header can set (setMailboxLimit) and ask against (mailboxTooFull:
// depth at or over the limit). Nothing mutes a sender yet; with no limit set,
// a mailbox grows without one.
//
// The scheduler has one worker thread per 'workers', each with its own run
// queue, a ring of 1024 actors, plus one shared inject queue, a list under a
// Mutex. An actor made runnable by a send from a worker goes on that
// worker's own queue (so a reply is handled where its sender's data is
// warm); one made runnable by any other thread goes on the inject queue. A
// worker takes from the front of its own queue, and every 61st turn from
// the inject queue first, so that the inject queue is not starved; with
// nothing in its own, it takes a share of the inject queue's (as many as
// the queue holds per worker, at most 32 more), then tries to steal HALF of
// another worker's queue, starting at one chosen at random. A full queue
// moves half of itself to the inject queue. The owner pushes with a Release
// store of its tail; the owner and stealers alike take with a
// compare-and-swap on the head (tokio's local queue, without its
// separate steal index). The ring holds pointers to Headers, the Header's
// 'link' field chains the inject queue, and an actor is on at most one queue
// at a time.
//
// A turn runs at most 'batch' messages of one actor (Pony's 100): then the
// actor, if it has more, goes to the back of its worker's queue, so an actor
// with a flood of messages cannot keep a worker from the others.
//
// PARALLEL LOOPS share these workers (parallel.cone has the whole account).
// 'parallelRange(lo, hi, grain, body)' runs a callable over an index
// range, split on demand: the range starts as one task, whoever runs a task
// splits it in half while it is longer than grain and puts one half on top of
// its worker's deque of tasks, which sits beside the ring of actors and is
// taken before it, and an idle worker steals the oldest, largest half, tasks
// before actors. Called from a behaviour, the worker runs tasks until the
// loop is done, and its actor is not run again before that. It is the
// low-level form: beyond the check that the body is Shareable, it trusts its
// caller that the body writes only its own items and never waits. The language's 'parallel each' written directly in a
// behaviour does not wait: the behaviour is cut at the loop's end like an
// 'await' (parSeam, parBlock: called by the compiler's code), the loop begins
// when the behaviour has returned, the actor is neither queued nor marked idle
// meanwhile (its Header's par and ready), and the last piece makes it runnable
// with the rest of the behaviour ahead of its mailbox (parallel.cone, A
// PARALLEL EACH IN A BEHAVIOUR).
//
// IDLE WORKERS spin a little, then park, each on a futex word of its own
// (THE PARK WORD, below). A worker that finds no work first tries to become
// a spinner (THE SPIN, below), looking again and again until a few
// microseconds have passed; then, or at once if it could not become one, it
// publishes itself a sleeper (its park word PARKED, the sleepers' count one
// more), looks once more, and sleeps on its park word. A push to the inject
// queue, and a push to a worker's own queue that already held another, wakes
// one sleeper, chosen and marked (NOTIFIED) before it is woken, unless a
// worker is looking already: one spinning (THE SPIN, below), or one woken
// earlier and still looking (the 'searching' flag). The one woken takes a
// share and, if more waits, wakes the next, so that a burst of work spreads
// across the workers a worker at a time rather than waking them all. A push
// to an empty queue of one's own wakes nobody, so two actors passing
// messages back and forth stay on one worker. That a queue's work is never
// left while every worker sleeps is kept by two Dekker pairings on
// sequentially consistent operations: a sleeper publishes itself and clears
// 'searching', then looks; an inject push adds to the queue's length, then
// reads the sleepers and swaps 'searching'. A worker's own queue needs no
// such pairing: only its owner pushes to it, and the owner is awake.
//
// THE PARK WORD. Each worker sleeps on a word of its own ('park', on a cache
// line of its own in the Worker), not on one word all of them share, so that
// a worker knows when it comes back whether it was the one woken. The word is
// RUNNING, PARKED or NOTIFIED:
// - The worker, going to park, stores PARKED, then sets its bit in the
//   sleepers' bitmap ('parked': 64 workers a word), then adds itself to the
//   sleepers' count, then clears 'searching', then looks once more (anyWork),
//   all sequentially consistent. Work seen: it clears its bit, takes itself
//   out (a compare-and-swap PARKED to RUNNING; if a notify marked it
//   meanwhile, the mark is its own to spend: it stores RUNNING), counts itself
//   out of the sleepers, and goes back to the loop. No work: it sleeps,
//   futexWait(park, PARKED).
// - notify, after its checks (sleepers, 'spinning', 'searching'), chooses a
//   sleeper from the bitmap: the lowest set bit (trailingZeros), from the
//   first word up. It claims the bit (an atomic and that clears it, reading
//   what it was: a bit another cleared first is passed over), then turns
//   that worker's word from PARKED to NOTIFIED with a compare-and-swap, and
//   only then wakes the word. A claimed worker whose word is not PARKED (on
//   its way out of the park, its bit's clearing not yet seen) is passed over,
//   and notify tries the next bit. One load finds a sleeper among 64 workers,
//   where a scan of the park words would touch a cache line a worker (24 of
//   them here, for each of the I/O thread's four answer pushes a round trip).
//   The lowest bit first keeps the work on the fewest workers.
// - The bitmap's one invariant, which no lost wake needs: a worker whose word
//   is PARKED has its bit set. Bits are cleared only by the worker leaving
//   the park and by a notify's claim, and a claim is followed at once by the
//   compare-and-swap: if that turns the word to NOTIFIED the worker is no
//   longer PARKED; if it fails the word was not PARKED then, and a worker that
//   parks again later stores PARKED and only then sets its bit, after the
//   claim. A stale set bit (a worker woken, its bit set again by its next
//   park before an older claim's clearing) costs a notify one failed
//   compare-and-swap, nothing else.
// - WHO UNCOUNTS: the sleepers' count goes down exactly once a park, always
//   by the worker itself as it leaves (uncount: on the look-saw-work way out,
//   and on the chosen way out, never by a notify's claim). So the count is
//   the workers between their count and their leaving: those with a set bit,
//   and those whose bit a claim (or their own leaving) has cleared and that
//   have not yet left (a stale bit belongs to one of those). A debug build
//   asserts what can be checked of it at the two points that move it: the
//   count never goes below 0, nor above the number of workers. (The sum
//   itself is not asserted: it moves under the reader's feet.)
// - THE CLAIMED-BUT-LEAVING CASE: a notify may claim the bit of a worker
//   whose look has seen work and that is leaving, and turn its word to
//   NOTIFIED before the worker's own compare-and-swap. The worker's then
//   fails; the mark is its to spend: it stores RUNNING and runs (stats'
//   marksSpent). The notify's wake lands on a word nobody waits on: it woke
//   nobody new, and its push is served by a worker that was leaving anyway,
//   or, if that worker takes other work, by the next notify: taking work away
//   (foundAway) wakes another if the inject queue still holds some, which
//   chooses a second sleeper (tests/parkleave.cone shows it). If the worker's
//   compare-and-swap comes first, the notify's fails and it chooses the next
//   set bit.
// - Back from its futexWait, the worker reads its word. NOTIFIED: it was
//   chosen; it stores RUNNING, counts itself out of the sleepers and goes back
//   to the loop, where it looks, and finding nothing it goes to idle as any
//   worker does (it may spin). PARKED: nobody chose it (the OS's wait returned
//   for another reason: on Windows, WaitOnAddress may return with no wake of
//   the word; measured at up to 16 such returns a round trip in one program).
//   It sleeps again at once, with no spin and no look: it is still published,
//   so every push made since is covered as before (below), and a look would
//   only cost the time a futile spin did. The stop marks every worker
//   NOTIFIED and wakes each one's word.
// NO WAKE IS LOST under the park word, every case:
// - A push before the worker publishes itself: the worker's look after
//   publishing sees it (the look follows the publication, the push precedes
//   notify's read of the sleepers; whichever of the two comes first in the
//   sequentially consistent order, either notify sees the worker counted or the
//   look sees the push).
// - A push after the worker has published itself and looked: notify sees the
//   count, and the bit set before it, so it goes on to choose. If this
//   worker is chosen, its word is
//   NOTIFIED before the wake, so a worker that has not yet called futexWait
//   finds the word is not PARKED and the wait returns at once, and one asleep
//   is woken by the wake that follows: the mark comes first, so neither
//   order of the mark and the wait loses it (tests/parkwake.cone forces a
//   mark between the look and the wait).
// - Two notifies racing for one sleeper: the claim of its bit lets one have
//   it; the other passes it over and chooses another, or finds none, which
//   leaves 'searching' set (a wake that woke nobody): every worker counted
//   among the sleepers is then
//   chosen already (it wakes and looks), or on its way out of the park (it is
//   awake and runs work, and parks again only after publishing and looking),
//   and each of them clears 'searching' when it next parks or takes work away
//   (foundAway), so a later push is not left unwoken.
// - A chosen worker that finds no work: it was woken to look and looked;
//   what it was woken for was taken by another (a spinner, or the pushing
//   worker itself). It goes to idle and parks again as any worker does.
// - A chosen worker mid-spin cannot happen: a spinner's word is RUNNING, and
//   notify does not wake while one spins at all (THE SPIN).
// - A worker that marks nothing: a return with the word still PARKED was no
//   wake of ours, and sleeping again loses nothing, since the worker is still
//   published and any push since has been, or will be, covered by a notify
//   that marks a published worker.
// - The stop: 'stopping' is stored before the marks, and a worker checks it
//   after publishing (before its wait) and after every chosen return.
//
// THE SPIN. Parking costs a wake: the waker's futexWake, and the sleeper's
// time to run again, measured on the 24-thread laptop (Windows) at 4 to 10 us
// (the median, with 23 threads parked on one word and one woken every 15 to
// 200 us; 13 us at one a millisecond). Work that comes back within a few
// microseconds (an answer from the I/O thread, the next message of a
// conversation) is cheaper caught by looking.
// - Where: in idle, after the worker has found no work anywhere (its own
//   queues, the inject queue, every loop piece, every other worker's queue)
//   and before it counts itself a sleeper.
// - The bound is in time, not looks: 'spinMicros', 8 us, about what the
//   park and its wake cost when the core is awake, so that spinning the bound
//   and then parking costs at most about twice the better of the two (the
//   rule for spinning before blocking: spin for as long as blocking costs).
//   The clock is QueryPerformanceCounter on Windows (100 ns ticks) and
//   clock_gettime's CLOCK_MONOTONIC elsewhere, read once a look; 'spinTicks'
//   is the bound in its ticks, set when the workers start.
// - The cap: at most 'spinCap' workers spin at once, an atomic count in the
//   Sched (a compare-and-swap below the cap joins it); a worker that cannot
//   join parks at once. spinCap is half the workers (tokio's rule for its
//   searching workers) and never more than 'spinMost', 4: past a few
//   spinners, more of them catch nothing a spinner already would, and an idle
//   program on 24 workers must not burn 24 cores. One with a single worker.
// - A look is anyWork, the same look the park makes after counting itself a
//   sleeper. There is no pause instruction between looks: Cone has none
//   (neither an intrinsic nor anything in the C library), so a look is the
//   loads and the clock's read.
// - A push while a worker spins wakes nobody (notify): the spinner will see
//   it, and the pusher (often the I/O thread) is spared the futexWake, and no
//   sleeper is woken to find the work gone and take a spinner's place.
//   tokio's rule, no wake while a worker is searching, with spinners
//   counted as searching.
// - NO WAKE IS LOST. A spinner counts itself in 'spinning' and in neither
//   'sleepers' nor 'searching'. A push adds to the queue (sequentially
//   consistent), then notify reads the sleepers and 'spinning' and swaps
//   'searching' (all sequentially consistent). A spinner leaves the spin in
//   one of two ways, and either way the push is taken:
//   - By its bound, not having seen the push: it takes itself out of
//     'spinning', then goes on to the park exactly as a worker that never
//     spun: it counts itself a sleeper and clears 'searching', then looks
//     (all sequentially consistent). If notify read 'spinning' before the
//     spinner left it, the push came before the spinner's look after it,
//     which sees it. Otherwise notify's reads pair with the park's as they
//     always have (THE PARK WORD, NO WAKE IS LOST).
//   - By seeing work, the push or another: it goes back to the worker's loop
//     and takes work in the loop's order, the inject queue before any steal,
//     exactly as a worker woken to look ('searching') does, and is covered
//     the same way: taking work away from its own queue (the inject queue's
//     every-61st-turn take included), foundAway wakes another if the inject
//     queue, its own queue or a loop piece still holds work; a push to a
//     worker's own queue is run by that worker in any case, being awake. A
//     worker that saw work and then found none goes to idle again and looks
//     again.
//   A notify that found a sleeper and no spinner woke that sleeper, not a
//   spinner: one more worker looking, never one fewer. And a spin ends: by
//   its bound when no work comes, or by seeing work; a worker sees work only
//   while some is queued, so a program with nothing left to run has every
//   worker parked within the bound (tests/spinrest.cone; tests/wakestress.cone
//   and wakestressone.cone stress the wake). The narrowest window, a push
//   between the spin's last look and the worker's count of itself as a
//   sleeper, which finds nobody to wake and is taken only by the park's look,
//   is forced by a test hook (holdNextPark, below; tests/parklook.cone).
//
// 'stats()' counts the spins begun, those that saw work and those that ran to
// their bound, the parks (a worker published and asleep), and the reparks (a
// return from the wait with the word still PARKED, slept again at once).
//
// QUIESCENCE is found by counting activations: an actor's time from the send
// that made it runnable to the worker's marking it idle. Each worker counts,
// on its own cache line, the activations it began (its sends that found an
// actor idle) and those it ended; activations begun off the workers are
// counted in one shared count. The finalizer reads every worker's 'ended',
// then every 'begun' and the shared count, all sequentially consistent:
// since the counts only grow, sums that agree agreed at the moment between
// the two passes, when no actor was active and so no mailbox held a message
// -- Mattern's four-counter method. A worker ends an activation only after
// letting go of the scheduler's owner, so an actor's finalizer, which may
// send, runs inside the activation that ends it. Workers going to sleep wake
// the finalizer when the last of them does, and it reads the counts again.
// Pony finds quiescence with rounds of messages between its schedulers; the
// counts here cost each activation two sequentially consistent stores (an
// exchange each, on x86) to a line of the worker's own, and nothing shared.
//
// ROOM LEFT. Four things the runtime will want are designed around, and
// none built:
//
// - Run classes (frame and background work at a fixed ratio): a second ring
//   per worker, and a class in the Header that says which ring an actor is
//   pushed to; the turn counter that already interleaves the inject queue
//   chooses between the rings.
// - A control lane: a second ring (tail, head, segments) in the Header,
//   drained first by runBatch; the idle mark stays on the first ring's tail,
//   and a send to either ring takes the actor out of idle through it.
// - tokio's LIFO slot: one pointer per worker, holding the actor the running
//   actor made runnable most recently, taken before the worker's own queue;
//   'schedule' is the one place it would be filled, and the ring is where
//   the slot's previous occupant would go.
// - Muting a sender to an overloaded actor: a mark in the Header that runActor
//   checks before queueing the sender again, with a list of muted actors
//   per receiver to queue when it catches up. The ring counts what it holds
//   and answers mailboxTooFull for it (MAILBOX LIMIT); the mute is not built.
//
// The package's own calls to the OS are a yield and THE SPIN's clock, chosen
// by the target's OS; the rest is the thread package's and sync's, on Windows
// and on Linux.

mod actors use ActorGc;

import libc;
import sync use Arc;
import thread;

// ---------------------------------------------------------------------------
// A yield, for the waits that spin (a stalled sender's, a loop's caller's),
// and a clock, for the idle spin: the calls the package makes to the OS
// directly, kernel32's on Windows, POSIX's elsewhere. isWindows() is a
// constant of the compile (TEMPORARY, a provisional mechanism; its final
// design is open), so only the target's calls are generated, and the other's
// symbols are never referenced. Everything else is the thread package's and
// sync's.
// ---------------------------------------------------------------------------

extern {
  fn @c(system) SwitchToThread() i32;
}
extern fn @c sched_yield() i32;

fn yieldProcessor() {
  if isWindows() {SwitchToThread();} else {sched_yield();}
}

// The clock THE SPIN is bounded by (the header, IDLE WORKERS): a steady count
// of clockFrequency() ticks a second. QueryPerformanceCounter on Windows
// (100 ns ticks, about 14 ns a read measured); clock_gettime's CLOCK_MONOTONIC
// elsewhere, in nanoseconds (the vDSO's, no system call)
extern {
  fn @c(system) QueryPerformanceCounter(count: *i64) i32;
  fn @c(system) QueryPerformanceFrequency(freq: *i64) i32;
}
struct PosixClock {
  sec: i64;
  nsec: i64;
}
extern fn @c clock_gettime(clock: i32, ts: *PosixClock) i32;
const clockMonotonic = 1i32;

fn clockTicks() u64 {
  if isWindows() {clockTicksWindows()} else {clockTicksPosix()}
}

fn clockTicksWindows() u64 {
  var count = 0i64;
  QueryPerformanceCounter(&mut count as *i64);
  u64.from(count)
}

fn clockTicksPosix() u64 {
  var ts = PosixClock(0i64, 0i64);
  clock_gettime(clockMonotonic, &mut ts as *PosixClock);
  u64.from(ts.sec) * 1000000000u64 + u64.from(ts.nsec)
}

fn clockFrequency() u64 {
  if isWindows() {clockFrequencyWindows()} else {1000000000u64}
}

fn clockFrequencyWindows() u64 {
  var freq = 0i64;
  QueryPerformanceFrequency(&mut freq as *i64);
  u64.from(freq)
}

// A panic, reported at the line calling 'die'
fn die(msg: &str, file: &str = srcFile(), line: u32 = srcLine()) Never {
  panic(msg, file, line)
}

// ---------------------------------------------------------------------------
// The mailbox: a ring of fixed-size slots, grown in linked segments (THE MAILBOX, above)
// ---------------------------------------------------------------------------

// A slot is a 16-byte header, then its payload. The header: 'seq', which
// says the slot has been written (position * 8 + a kind) and so is the
// publication, and 'cause', one word for the id of the send that made the
// message (the tracing hooks fill it; zero when they are off). The payload is the
// message M itself for a message, and for a reply a record of its own
// (REPLIES, above).
const slotHead = 16usize;

// A segment: this header, then 'count' slots. 'base' is the position of its
// first slot and 'count' its size, both fixed once it is linked; 'next' is
// set once, from null, by whichever sender finds the position it needs past
// the last segment and links one (or by a sender linking ahead). A segment
// the consumer has drained keeps two words of its own in its first slot's
// payload, which nothing reads any more: the next drained segment, and the
// number of positions that had been claimed when it was drained (retNext,
// retMark).
struct Seg {
  pub base: u64;
  pub next: *Seg;
  pub count: u32;
  pub pad: u32;
  pub pad2: u64;
}

const segHead = 32usize;

// The consumer's record of the drained segments, made when the first is
// drained: they wait, oldest first, to be reused (reclaim); those kept wait
// in the pool; and a few wait in the spare places, ready for the senders,
// which take them from here (linkAfter). Senders reach it through the
// header's 'extra', set once and never freed before the actor dies.
struct Extra {
  pub retHead: *Seg;
  pub retTail: *Seg;
  pub pool: *Seg;
  pub poolBytes: u32;      // the bytes of the segments in the pool
  pub spareBytes: u32;     // the bytes of the segments in the spare places (atomic: the consumer adds what it puts, a sender takes its away)
  pub small: u32;          // the slots of a small segment, and the floor in bytes, for this mailbox's slot size: worked out once, for atRest
  pub floor: u32;
  pub prevHigh: u32;       // the high-water mark the previous rest left (atRest)
  pub scanSeg: *Seg;
  pub scanPos: u64;
  pub spares: Array[*Seg, 16];
}

// How many spare places the senders have: a sender that reaches past the last
// segment takes one of the segments waiting in them, and the consumer, at the
// start and end of each of its turns, fills the empty ones from the kept
const spareCount = 16usize;

fn retNext(x: *Seg) **Seg {((x as *u8) + segHead + slotHead) as **Seg}
fn retMark(x: *Seg) *u64 {((x as *u8) + segHead + slotHead + 8usize) as *u64}

fn strideOf(h: *Header) usize {usize.from((*h).stride)}

// The mailbox's 'tail' word: bits 0 to 62 count the positions claimed, one
// per send, and bit 63 is the idle mark. A slot's 'seq' is its position times
// 8 plus its kind; any other value, which an unwritten or older slot holds, is
// not the publication.
const idleBit = 0x8000000000000000u64;
const posMask = 0x7FFFFFFFFFFFFFFFu64;

// The kinds a published slot has
const kindMsg = 1u64;        // a message: M is in the payload
const kindReply = 2u64;      // a reply (REPLIES): 2 + 1 if its record has an id, + 2 if its value is boxed

// The sizes, named. The first segment, made by the first send, holds
// firstSlots. Each later one is growBy times the one before, up to the most
// slots that fit maxSegBytes (and at most maxSegSlots), and no larger than the
// queue asks: not past twice the depth at the time, and at least a "small"
// segment, which holds about smallBytes of slots (smallSlots), so that an
// actor that is only ever sent a few at a time keeps small segments. A
// drained segment that is not reused at once is kept, up to a budget of bytes
// that follows the mailbox's recent peak (keepBudget): twice its high-water
// mark in bytes, not less than the floor, two small segments, and not more than
// keepMostBytes. When the mailbox comes to rest the kept segments are trimmed
// to the floor and a large segment it is in is given up (atRest).
const firstSlots = 2usize;
const growBy = 4usize;
const maxSegBytes = 16384usize;
const maxSegSlots = 256usize;
const smallBytes = 2048usize;
const smallMostSlots = 64usize;
const keepMostBytes = 262144usize;

// What a reply's payload holds first: the awaiting actor's resume function and
// the record's id, then the value, or a pointer to the box holding it
const replyHead = 16usize;
const minPayload = 32usize;

fn nullSeg() *Seg {null}
fn nullHeader() *Header {null}

// A mailbox with no limit has a limit no depth reaches
const noLimit = 0xFFFFFFFFu32;

fn nullExtra() *Extra {null}

// The size of a slot's payload for messages M: M rounded to 16 bytes, and not
// less than minPayload, so that a reply's resume record and a small value fit
fn payloadBytes[M: Sendable]() usize {
  let n = roundUp(mem.sizeof[M](), 16usize);
  if n < minPayload {minPayload} else {n}
}

// What the runtime allocated for messages, counted: segments, the boxes of
// replies too large for a slot, and the waiters of awaits parked on a future
// not yet arrived. Atomics held by 'let' globals, set in 'init' (below).
let segAllocs: Atomic[u64];
let boxAllocs: Atomic[u64];
let waiterAllocs: Atomic[u64];
let segsLive: Atomic[usize];
let segBytesLive: Atomic[usize];

// How many allocations the runtime has made for messages so far (segments,
// reply boxes, future waiters): a send and a reply allocate none of their own
pub fn messageAllocs() u64 {
  segAllocs.loadOrdered(MemOrder.Relaxed) + boxAllocs.loadOrdered(MemOrder.Relaxed)
    + waiterAllocs.loadOrdered(MemOrder.Relaxed)
}

// How many mailbox segments are allocated and not yet freed, for tests and
// for finding leaks, as liveFutures is for futures
pub fn liveSegments() usize {
  segsLive.loadOrdered(MemOrder.Acquire)
}

// How many bytes those segments are (their headers and slots), over every
// mailbox: what the mailboxes hold
pub fn liveSegmentBytes() usize {
  segBytesLive.loadOrdered(MemOrder.Acquire)
}

// ---- MAILBOX LIMIT (the hook for muting; nothing mutes yet) ----

// How many messages the actor whose Mailbox mb is has queued now (claimed and
// not yet taken; one claimed and not yet published counts), approximately: the
// two counts are read at different moments
pub fn mailboxDepth[M: Sendable](mb: &opaq Mailbox[M]) u64 {
  let h = mb as *Header;
  let t = mem.atomicLoad[u64](&(*h).tail as *u64, MemOrder.Relaxed) & posMask;
  let hd = mem.atomicLoad[u64](&(*h).head as *u64, MemOrder.Relaxed);
  if t > hd {t - hd} else {0u64}
}

// The most messages the mailbox has had queued at once, as the worker
// running the actor saw it at the start of a turn
pub fn mailboxHighWater[M: Sendable](mb: &opaq Mailbox[M]) u64 {
  u64.from(mem.atomicLoad[u32](&(*(mb as *Header)).high as *u32, MemOrder.Relaxed))
}

// How many bytes of segments the mailbox holds now: the queue's and the ones
// it keeps (0 before the first send)
pub fn mailboxBytes[M: Sendable](mb: &opaq Mailbox[M]) u32 {
  mem.atomicLoad[u32](&(*(mb as *Header)).bytes as *u32, MemOrder.Relaxed)
}

// Set how many queued messages are too many for this mailbox (noLimit: never,
// as it starts)
pub fn setMailboxLimit[M: Sendable](mb: &opaq Mailbox[M], limit: u32) {
  mem.atomicStore[u32](&(*(mb as *Header)).limit as *u32, limit, MemOrder.Relaxed);
}

// Whether the mailbox is too full: a sender muting itself would ask this
// before it sends. With no muting yet, nothing does, and a mailbox with no
// limit grows without one
pub fn mailboxTooFull[M: Sendable](mb: &opaq Mailbox[M]) bool {
  mailboxDepth[M](mb) >= u64.from(mem.atomicLoad[u32](&(*(mb as *Header)).limit as *u32, MemOrder.Relaxed))
}

// ---- A TEST HOOK: a sender held between its claim and its publication ----

// The state of the hook: 0 off; 1 armed, the next send to stop here; 2 a
// sender stopped, its slot claimed and not published; 3 released. For tests of
// the protocol for a slot claimed and not yet published (THE MAILBOX): it
// costs a send one relaxed load.
let stallState: Atomic[u32];

pub fn stallNextPublish() {
  stallState.storeOrdered(1u32, MemOrder.SeqCst);
}

// Whether a sender is stopped, between its claim and its publication
pub fn publishStalled() bool {
  stallState.loadOrdered(MemOrder.SeqCst) == 2u32
}

// Let the stopped sender publish
pub fn releaseStalled() {
  stallState.storeOrdered(3u32, MemOrder.SeqCst);
}

fn stallHere() {
  var seen = 0u32;
  var armed = false;
  seen, armed = stallState.compareSwap(1u32, 2u32);
  if !armed {
    return;
  }
  while stallState.loadOrdered(MemOrder.SeqCst) != 3u32 {
    yieldProcessor();
  }
  stallState.storeOrdered(0u32, MemOrder.SeqCst);
}

// The slots of a "small" segment: about smallBytes of them, not fewer than
// firstSlots nor more than smallMostSlots
fn smallSlots(h: *Header) usize {
  var n = smallBytes / strideOf(h);
  if n > smallMostSlots {n = smallMostSlots;}
  if n < firstSlots {n = firstSlots;}
  n
}

// The bytes of a segment of 'count' slots
fn segBytesOf(h: *Header, count: u32) usize {
  segHead + usize.from(count) * strideOf(h)
}

// The floor of what a mailbox keeps: two small segments, the one a send past
// the end of the segment it is in will link and the one after it
fn keepFloor(h: *Header) usize {
  2usize * segBytesOf(h, u32.from(smallSlots(h)))
}

// How many messages the mailbox holds now, claimed and not yet taken
fn depthOf(h: *Header) u64 {
  let t = mem.atomicLoad[u64](&(*h).tail as *u64, MemOrder.Relaxed) & posMask;
  let hd = mem.atomicLoad[u64](&(*h).head as *u64, MemOrder.Relaxed);
  if t > hd {t - hd} else {0u64}
}

// How many slots the segment after one of 'prev' slots has: growBy times as
// many, up to the most that fit maxSegBytes (and maxSegSlots), but not more
// than the queue asks, which is twice the depth now rounded up to a power of
// two, and not fewer than a small segment. So a deep queue's ring grows to
// the largest segments, and a mailbox that only ever holds a few messages at
// a time keeps small ones.
fn nextSlots(h: *Header, prev: u32) u32 {
  var most = maxSegBytes / strideOf(h);
  if most > maxSegSlots {most = maxSegSlots;}
  if most < 2usize {most = 2usize;}
  var n = usize.from(prev) * growBy;
  if n > most {n = most;}
  var ask = smallSlots(h);
  let want = depthOf(h) * 2u64;
  while u64.from(ask) < want && ask < most {
    ask = ask * 2usize;
  }
  if n > ask {n = ask;}
  if n < 2usize {n = 2usize;}
  u32.from(n)
}

// A new segment of 'count' slots, not linked anywhere
fn segAlloc(h: *Header, count: u32) *Seg {
  // Zeroed, so that no slot's 'seq' says it is published before it is: a
  // recycled segment holds the sequences of earlier positions, which no later
  // position equals, but fresh memory may hold anything
  let bytes = segBytesOf(h, count);
  let s = libc.calloc(1usize, bytes) as *Seg;
  if s as usize == 0usize {
    die("actors: out of memory for a mailbox segment");
  }
  (*s).count = count;
  segAllocs.addOrdered(1u64, MemOrder.Relaxed);
  segsLive.addOrdered(1usize, MemOrder.Relaxed);
  segBytesLive.addOrdered(bytes, MemOrder.Relaxed);
  mem.atomicAdd[u32](&(*h).bytes as *u32, u32.from(bytes), MemOrder.Relaxed);
  s
}

fn segFree(h: *Header, s: *Seg) {
  let bytes = segBytesOf(h, (*s).count);
  libc.free(s as *u8);
  segsLive.subOrdered(1usize, MemOrder.Relaxed);
  segBytesLive.subOrdered(bytes, MemOrder.Relaxed);
  mem.atomicSub[u32](&(*h).bytes as *u32, u32.from(bytes), MemOrder.Relaxed);
}

// Where position pos lies in segment s
fn slotAt(h: *Header, s: *Seg, pos: u64) *u8 {
  (s as *u8) + segHead + usize.from(pos - (*s).base) * strideOf(h)
}

fn seqOf(slot: *u8) *u64 {slot as *u64}
fn payloadOf(slot: *u8) *u8 {slot + slotHead}

fn ldSeg(p: **Seg) *Seg {mem.atomicLoad[*Seg](p, MemOrder.SeqCst)}

// The consumer's record, which senders reach too: null until the first
// segment is drained
fn ldExtra(h: *Header) *Extra {
  mem.atomicLoad[*Extra](&(*h).extra as **Extra, MemOrder.Acquire)
}

fn spareAt(e: *Extra, i: usize) **Seg {(&(*e).spares as **Seg) + i}

// A segment beyond s, linked after it: a spare if there is one, else a new
// one, taking position base + count on. If another sender linked one first,
// that one is the answer and ours is kept as a spare (or freed, if there is
// no place). Used by a sender whose position lies past the last segment,
// and by one linking ahead.
fn linkAfter(h: *Header, s: *Seg) *Seg {
  var fresh = nullSeg();
  let e = ldExtra(h);
  if e as usize != 0usize {
    var i = 0usize;
    while i < spareCount && fresh as usize == 0usize {
      if mem.atomicLoad[*Seg](spareAt(e, i), MemOrder.Relaxed) as usize != 0usize {
        fresh = mem.atomicSwap[*Seg](spareAt(e, i), nullSeg(), MemOrder.AcqRel);
      }
      i = i + 1usize;
    }
    if fresh as usize != 0usize {
      mem.atomicSub[u32](&(*e).spareBytes as *u32, u32.from(segBytesOf(h, (*fresh).count)), MemOrder.Relaxed);
    }
  }
  if fresh as usize == 0usize {
    fresh = segAlloc(h, nextSlots(h, (*s).count));
  }
  (*fresh).base = (*s).base + u64.from((*s).count);
  (*fresh).pad = 0u32;
  mem.atomicStore[*Seg](&(*fresh).next as **Seg, nullSeg(), MemOrder.Relaxed);
  var seen = nullSeg();
  var linked = false;
  seen, linked = mem.atomicCompareSwap[*Seg](&(*s).next as **Seg, nullSeg(), fresh,
    MemOrder.SeqCst, MemOrder.SeqCst);
  if linked {
    return fresh;
  }
  keepSpare(h, fresh);
  seen
}

// Put a segment nobody refers to into an empty spare place, or free it
fn keepSpare(h: *Header, x: *Seg) {
  let e = ldExtra(h);
  if e as usize != 0usize {
    // counted before it is put, so that a sender taking it at once takes the
    // count away from a count that has it
    let bytes = u32.from(segBytesOf(h, (*x).count));
    mem.atomicAdd[u32](&(*e).spareBytes as *u32, bytes, MemOrder.Relaxed);
    var i = 0usize;
    while i < spareCount {
      if mem.atomicLoad[*Seg](spareAt(e, i), MemOrder.Relaxed) as usize == 0usize {
        var seen = nullSeg();
        var put = false;
        seen, put = mem.atomicCompareSwap[*Seg](spareAt(e, i), nullSeg(), x,
          MemOrder.AcqRel, MemOrder.Relaxed);
        if put {
          return;
        }
      }
      i = i + 1usize;
    }
    mem.atomicSub[u32](&(*e).spareBytes as *u32, bytes, MemOrder.Relaxed);
  }
  segFree(h, x);
}

// The mailbox's first segment, made by the first send (an actor that is never
// sent a message has none). Any number of senders may be the first at once:
// each makes a segment and tries to set the consumer's segment from null with
// one compare-and-swap; the one that wins is the first segment, and the others
// free theirs and use it. Nobody waits. The consumer, finding itself with a
// claimed position and no segment (mailMarkIdle), makes it the same way.
fn firstSeg(h: *Header) *Seg {
  let c = ldSeg(&(*h).cur as **Seg);
  if c as usize != 0usize {
    return c;
  }
  let fresh = segAlloc(h, u32.from(firstSlots));
  var seen = nullSeg();
  var won = false;
  seen, won = mem.atomicCompareSwap[*Seg](&(*h).cur as **Seg, nullSeg(), fresh,
    MemOrder.SeqCst, MemOrder.SeqCst);
  if won {
    return fresh;
  }
  segFree(h, fresh);
  seen
}

// The place of position pos, which the caller has claimed: found from the
// hint (the last segment a sender used) or, if the hint is already past pos,
// from the consumer's own segment, walking on while pos lies beyond; linking
// a segment where there is none. A sender that reaches past the middle of
// the segment it writes in links the next one ahead, so a later sender
// finds it there. Nothing of a segment is touched after the slot is
// published (SEGMENTS ARE REUSED, above).
fn slotFor(h: *Header, pos: u64) *u8 {
  let hv = ldSeg(&(*h).hint as **Seg);
  var s = hv;
  if hv as usize == 0usize {
    s = firstSeg(h);
  } else if pos < (*s).base {
    s = ldSeg(&(*h).cur as **Seg);
  }
  while pos >= (*s).base + u64.from((*s).count) {
    var nx = ldSeg(&(*s).next as **Seg);
    if nx as usize == 0usize {
      nx = linkAfter(h, s);
    }
    s = nx;
  }
  if s as usize != hv as usize && (hv as usize == 0usize || (*s).base > (*hv).base) {
    var seen = nullSeg();
    var moved = false;
    seen, moved = mem.atomicCompareSwap[*Seg](&(*h).hint as **Seg, hv, s,
      MemOrder.SeqCst, MemOrder.SeqCst);
  }
  // Linking ahead is for one sender to do, the first to take the segment's
  // 'ahead' flag: the others, whose positions are in the same half, go on
  // (they are not waiting for it, and one that reaches the end first links
  // for itself)
  if (*s).count >= 8u32 && pos - (*s).base >= u64.from((*s).count / 2u32)
      && ldSeg(&(*s).next as **Seg) as usize == 0usize
      && mem.atomicLoad[u32](&(*s).pad as *u32, MemOrder.Relaxed) == 0u32 {
    var was = 0u32;
    var mine = false;
    was, mine = mem.atomicCompareSwap[u32](&(*s).pad as *u32, 0u32, 1u32, MemOrder.Relaxed, MemOrder.Relaxed);
    if mine {
      linkAfter(h, s);
    }
  }
  slotAt(h, s, pos)
}

// Claim the next position of h's mailbox and find its slot. One atomic
// add. The caller writes the slot's payload and publishes it. The word the
// add found carries the idle mark: 'idle' says it was set, in which case this
// sender, once it has published, is one of those that may schedule the actor
// (wakeAfter)
struct Claim {
  pub slot: *u8;
  pub pos: u64;
  pub idle: bool;
}

fn claim(h: *Header) Claim {
  // sequentially consistent: the claim comes before the sender reads the hint
  // and the consumer's segment, and a segment's retiring (retire) moves them
  // before it notes the claims
  let prev = mem.atomicAdd[u64](&(*h).tail as *u64, 1u64, MemOrder.SeqCst);
  let pos = prev & posMask;
  Claim(slotFor(h, pos), pos, (prev & idleBit) != 0u64)
}

// The kind a slot's 'seq' holds while the consumer waits for the slot to be
// published (mailMarkIdle): the position times 8 plus this
const kindWaiting = 7u64;

// Whether a 'seq' word, read from the slot of position pos, is a publication
fn isPublished(q: u64, pos: u64) bool {
  q / 8u64 == pos && q % 8u64 != 0u64 && q % 8u64 != kindWaiting
}

// Publish a claimed slot of the given kind: its payload is written. One
// atomic exchange of the slot's 'seq', which answers what it held: if the
// consumer was waiting for this slot (kindWaiting), it had stopped and this
// sender is to schedule it. Answers whether that is so.
fn publish(c: Claim, kind: u64) bool {
  let old = mem.atomicSwap[u64](seqOf(c.slot), c.pos * 8u64 + kind, MemOrder.AcqRel);
  old == c.pos * 8u64 + kindWaiting
}

// After a publication: whether this sender is the one to schedule the actor.
// If the consumer was waiting for this very slot, it is. Otherwise, if the
// mailbox was marked idle when the position was claimed, the senders that
// found the mark race to clear it and the one that does is
fn wakeAfter(h: *Header, c: Claim, waited: bool) bool {
  if waited {
    return true;
  }
  if !c.idle {
    return false;
  }
  (mem.atomicAnd[u64](&(*h).tail as *u64, posMask, MemOrder.AcqRel) & idleBit) != 0u64
}

// ---- the consumer's side: only the worker running the actor ----

// The slot holding h's next message, published, or 0 when there is none
// ready. Never waits for a sender: a position claimed and not yet published
// is not ready, and neither is the segment a sender has still to link. Moving
// on from a drained segment retires it. Only the worker running the actor
// calls this.
fn ringPeek(h: *Header) *u8 {
  var s = ldSeg(&(*h).cur as **Seg);
  if s as usize == 0usize {
    return null;
  }
  let pos = (*h).head;
  if pos >= (*s).base + u64.from((*s).count) {
    let nx = ldSeg(&(*s).next as **Seg);
    if nx as usize == 0usize {
      return null;
    }
    retire(h, s, nx);
    s = nx;
  }
  let slot = slotAt(h, s, pos);
  let q = mem.atomicLoad[u64](seqOf(slot), MemOrder.Acquire);
  if isPublished(q, pos) {
    return slot;
  }
  null
}

// The message at the consumer's position is done
fn ringDone(h: *Header) {
  mem.atomicStore[u64](&(*h).head as *u64, (*h).head + 1u64, MemOrder.Relaxed);
}

// Segment x is drained and the consumer moves to nx. Before anything else
// can reuse x, no sender may still be able to reach it: the consumer's
// segment and the hint are moved off it first, and then the number of
// positions claimed so far is noted (its 'mark'). A sender that claimed
// after that note began from the hint or the consumer's segment, which are
// past x; one that claimed before it holds a position below the mark, and
// x is not reused until every position below the mark is taken (reclaim).
fn retire(h: *Header, x: *Seg, nx: *Seg) {
  mem.atomicStore[*Seg](&(*h).cur as **Seg, nx, MemOrder.SeqCst);
  while ldSeg(&(*h).hint as **Seg) as usize == x as usize {
    var seen = nullSeg();
    var moved = false;
    seen, moved = mem.atomicCompareSwap[*Seg](&(*h).hint as **Seg, x, nx,
      MemOrder.SeqCst, MemOrder.SeqCst);
  }
  *retMark(x) = mem.atomicLoad[u64](&(*h).tail as *u64, MemOrder.SeqCst) & posMask;
  *retNext(x) = nullSeg();
  var e = (*h).extra;
  if e as usize == 0usize {
    e = libc.calloc(1usize, mem.sizeof[Extra]()) as *Extra;
    if e as usize == 0usize {
      die("actors: out of memory for a mailbox");
    }
    (*e).small = u32.from(smallSlots(h));
    (*e).floor = u32.from(keepFloor(h));
    mem.atomicStore[*Extra](&(*h).extra as **Extra, e, MemOrder.Release);
  }
  if (*e).retHead as usize == 0usize {
    (*e).retHead = x;
  } else {
    *retNext((*e).retTail) = x;
  }
  (*e).retTail = x;
}

// How many bytes of drained segments a mailbox keeps while it works: what its
// own recent peak needed, twice the most it has had queued (as noteDepth saw,
// and as atRest lets it fall) in slots' bytes, and not less than the floor nor
// more than keepMostBytes
fn keepBudget(h: *Header) usize {
  var n = 2usize * usize.from((*h).high) * strideOf(h);
  let floor = keepFloor(h);
  if n < floor {n = floor;}
  if n > keepMostBytes {n = keepMostBytes;}
  n
}

// Free one of the kept segments that has fewer than 'count' slots: whether
// there was one
fn evictSmaller(h: *Header, e: *Extra, count: u32) bool {
  var prev = nullSeg();
  var x = (*e).pool;
  while x as usize != 0usize && (*x).count >= count {
    prev = x;
    x = *retNext(x);
  }
  if x as usize == 0usize {
    return false;
  }
  if prev as usize == 0usize {
    (*e).pool = *retNext(x);
  } else {
    *retNext(prev) = *retNext(x);
  }
  (*e).poolBytes = (*e).poolBytes - u32.from(segBytesOf(h, (*x).count));
  segFree(h, x);
  true
}

// The kept segment to be the next spare when the next growth will want
// 'want' slots: the smallest with at least that many, taken out of the pool;
// 0 if there is none. The kept ones with fewer than 'want' are freed here: a
// ring's segments grow with its queue, so one smaller than the next wants is
// of no use to a queue that holds as much as it did (and a queue that holds
// less is given small ones when it rests: atRest).
fn takeKept(h: *Header, e: *Extra, want: u32) *Seg {
  var prev = nullSeg();
  var x = (*e).pool;
  var best = nullSeg();
  var bestPrev = nullSeg();
  while x as usize != 0usize {
    let nx = *retNext(x);
    if (*x).count < want {
      if prev as usize == 0usize {
        (*e).pool = nx;
      } else {
        *retNext(prev) = nx;
      }
      (*e).poolBytes = (*e).poolBytes - u32.from(segBytesOf(h, (*x).count));
      segFree(h, x);
    } else {
      if best as usize == 0usize || (*x).count < (*best).count {
        best = x;
        bestPrev = prev;
      }
      prev = x;
    }
    x = nx;
  }
  if best as usize != 0usize {
    if bestPrev as usize == 0usize {
      (*e).pool = *retNext(best);
    } else {
      *retNext(bestPrev) = *retNext(best);
    }
    (*e).poolBytes = (*e).poolBytes - u32.from(segBytesOf(h, (*best).count));
  }
  best
}

// The position below which every slot has been published: the consumer's,
// and on from there while slots are published, remembered in the record so
// that each slot is looked at once. A sender touches no segment after it has
// published, so a position claimed when a segment was drained is no longer
// a reason to keep it once it is published (it need not be taken).
fn publishedUpTo(h: *Header, e: *Extra) u64 {
  var pos = (*e).scanPos;
  var s = (*e).scanSeg;
  // (from the consumer's own segment unless the record's is surely ahead of
  // it: a segment the consumer has left may be reused)
  if pos <= (*h).head || s as usize == 0usize {
    pos = (*h).head;
    s = (*h).cur;
  }
  while true {
    if pos >= (*s).base + u64.from((*s).count) {
      let nx = ldSeg(&(*s).next as **Seg);
      if nx as usize == 0usize {
        break;
      }
      s = nx;
    }
    let q = mem.atomicLoad[u64](seqOf(slotAt(h, s, pos)), MemOrder.Acquire);
    if !isPublished(q, pos) {
      break;
    }
    pos = pos + 1u64;
  }
  (*e).scanPos = pos;
  (*e).scanSeg = s;
  pos
}

// Reuse the drained segments whose marks have been passed: every position
// that was claimed when one was drained is now published (or taken), so no
// sender can still reach it. Each is kept in the pool (up to keepBudget bytes),
// the spare places filled from it, else freed. Only the
// worker running the actor calls this, at the start and the end of its turn.
fn reclaim(h: *Header) {
  let e = ldExtra(h);
  if e as usize == 0usize {
    return;
  }
  var safe = (*h).head;
  if (*e).retHead as usize != 0usize && safe < *retMark((*e).retHead) {
    safe = publishedUpTo(h, e);
  }
  while (*e).retHead as usize != 0usize && safe >= *retMark((*e).retHead) {
    let x = (*e).retHead;
    (*e).retHead = *retNext(x);
    (*x).next = nullSeg();
    // Kept if it fits the budget, smaller ones kept already giving way: a
    // ring that has grown to its largest segments has no use for the small
    // ones it grew through
    let budget = keepBudget(h);
    let bytes = segBytesOf(h, (*x).count);
    while usize.from((*e).poolBytes) + bytes > budget && evictSmaller(h, e, (*x).count) {
    }
    if usize.from((*e).poolBytes) + bytes <= budget {
      *retNext(x) = (*e).pool;
      (*e).pool = x;
      (*e).poolBytes = (*e).poolBytes + u32.from(bytes);
    } else {
      segFree(h, x);
    }
  }
  // The spare places are kept full with segments of the size the next
  // growth will want: the one after the segment the senders are writing in
  let hint = ldSeg(&(*h).hint as **Seg);
  if (*e).pool as usize != 0usize && hint as usize != 0usize {
    let want = nextSlots(h, (*hint).count);
    var i = 0usize;
    while i < spareCount && (*e).pool as usize != 0usize {
      if mem.atomicLoad[*Seg](spareAt(e, i), MemOrder.Relaxed) as usize == 0usize {
        let x = takeKept(h, e, want);
        if x as usize == 0usize {
          break;
        }
        keepSpare(h, x);
      }
      i = i + 1usize;
    }
  }
}

// ---- coming to rest ----

// The worker running h's actor has taken everything and nothing is claimed
// beyond it: before the mailbox is marked idle, what it holds is given back,
// by stages, so that a mailbox that falls quiet for a moment in a stream does
// not lose what the stream needs, and one that falls quiet for good loses it
// in two rests.
//
// - The high-water mark halves at every rest, so that the keep budget
//   (keepBudget) follows recent use and not the all-time peak.
// - An actor that never drained a segment, or whose ring is in a small segment
//   with nothing kept above the floor (two small segments), has nothing to
//   give back: the usual case of an actor passing messages back and forth. It
//   returns at once, with no reclaim and no trim.
// - A rest with GROWTH since the last one (the high-water mark before halving
//   is higher than the previous rest left it: a turn of this mailbox saw a
//   deeper queue) trims what is kept down to the budget (keepBudget) only, and
//   goes no further: a stream that drains for a moment keeps most of what it
//   will want again.
// - A CALM rest (the mark before halving no higher than the previous rest left
//   it: nothing deeper happened since) trims what is kept to the floor less
//   the segments already linked beyond the ring's own (restFloor), and, if
//   the segment the consumer is in is larger than a small one, gives up its
//   remaining slots and goes on in a small segment (shrinkChain). So a burst
//   leaves its ring for the first rest and loses it at the second, which is
//   one more rest than the actor's next message.
//
// All of it is the consumer's, and nothing in it makes a sender wait: a send
// that claims a position meanwhile is dealt with where the mailbox is marked
// idle (mailMarkIdle), and a trim only frees segments no sender can reach. A
// mailbox that is never quiet never gets here.
fn atRest(h: *Header) {
  let pre = (*h).high;
  if pre != 0u32 {
    (*h).high = pre / 2u32;
  }
  let e = ldExtra(h);
  if e as usize == 0usize {
    return;
  }
  let x = ldSeg(&(*h).cur as **Seg);
  let low = (*x).count <= (*e).small;
  let kept = keptBytes(e);
  var floor = restFloor(h, e, x);
  let calm = pre <= (*e).prevHigh;
  (*e).prevHigh = (*h).high;
  if low && kept <= floor {
    return;
  }
  // (the turn that ended has reclaimed what can be reused: runBatch)
  if !calm {
    let budget = keepBudget(h);
    if kept > budget {
      trimKept(h, e, budget, false);
    }
    return;
  }
  if kept > floor {
    trimKept(h, e, floor, true);
  }
  if !low {
    shrinkChain(h);
    reclaim(h);
    floor = restFloor(h, e, ldSeg(&(*h).cur as **Seg));
    if keptBytes(e) > floor {
      trimKept(h, e, floor, true);
    }
  }
}

// What a mailbox at a calm rest keeps: the floor, two small segments, less the
// bytes of the segments a sender has already linked beyond the one the ring
// is in (cur): those stand in for the kept ones, so that the mailbox at rest
// holds the same however it came to rest. The linked ones are the ring's and
// are never touched here; only the kept ones (trimKept) are given back
fn restFloor(h: *Header, e: *Extra, cur: *Seg) usize {
  let floor = usize.from((*e).floor);
  var ahead = 0usize;
  var s = ldSeg(&(*cur).next as **Seg);
  while s as usize != 0usize && ahead < floor {
    ahead = ahead + segBytesOf(h, (*s).count);
    s = ldSeg(&(*s).next as **Seg);
  }
  if ahead >= floor {0usize} else {floor - ahead}
}

// What a mailbox keeps: the pool's and the spare places' bytes
fn keptBytes(e: *Extra) usize {
  usize.from((*e).poolBytes) + usize.from(mem.atomicLoad[u32](&(*e).spareBytes as *u32, MemOrder.Relaxed))
}

// Free what is kept (the spare places and the pool) beyond 'limit' bytes; with
// 'smallOnly' keep only small segments, those with more slots than a small one
// going at once. A spare is taken out of its place with an exchange, as a
// sender takes one, so a sender and this never take the same.
fn trimKept(h: *Header, e: *Extra, limit: usize, smallOnly: bool) {
  let small = (*e).small;
  var kept = 0usize;
  var i = 0usize;
  while i < spareCount {
    if mem.atomicLoad[*Seg](spareAt(e, i), MemOrder.Relaxed) as usize != 0usize {
      let y = mem.atomicSwap[*Seg](spareAt(e, i), nullSeg(), MemOrder.AcqRel);
      if y as usize != 0usize {
        let bytes = segBytesOf(h, (*y).count);
        mem.atomicSub[u32](&(*e).spareBytes as *u32, u32.from(bytes), MemOrder.Relaxed);
        if (!smallOnly || (*y).count <= small) && kept + bytes <= limit {
          kept = kept + bytes;
          keepSpare(h, y);
        } else {
          segFree(h, y);
        }
      }
    }
    i = i + 1usize;
  }
  var x = (*e).pool;
  (*e).pool = nullSeg();
  (*e).poolBytes = 0u32;
  while x as usize != 0usize {
    let nx = *retNext(x);
    let bytes = segBytesOf(h, (*x).count);
    if (!smallOnly || (*x).count <= small) && kept + bytes <= limit {
      kept = kept + bytes;
      *retNext(x) = (*e).pool;
      (*e).pool = x;
      (*e).poolBytes = (*e).poolBytes + u32.from(bytes);
    } else {
      segFree(h, x);
    }
    x = nx;
  }
}

// The segment the consumer is in is larger than a small one and the mailbox
// is empty: its slots from the consumer's position on are claimed, all at
// once, by this worker (one compare-and-swap of the tail, which fails if a
// send claimed a position meanwhile, and then nothing is done), taken as
// consumed, and the segment is retired as a drained one (retire), the ring
// going on in the segment after it: the one linked already, or a small one
// linked now (linkSmall). A send that claims a position after the swap is at
// the end of the segment, and links the next as it would anyway. Done once
// more for a large segment linked ahead, and never more than that: twice in
// all.
//
// The consumer's position moves to the segment's end BEFORE anything is
// linked. Linked the other way round (23 Oct 2026), the claimed slots still
// counted as queued, so the segment linked was sized for a queue of up to a
// whole segment, a large one; the next round shrank that one too, and linked
// another, without end: a runaway that took the machine's memory.
fn shrinkChain(h: *Header) {
  let small = smallSlots(h);
  var round = 0usize;
  while round < 2usize {
    round = round + 1usize;
    let x = ldSeg(&(*h).cur as **Seg);
    if x as usize == 0usize || usize.from((*x).count) <= small {
      return;
    }
    let head = (*h).head;
    let end = (*x).base + u64.from((*x).count);
    var seen = 0u64;
    var claimed = false;
    seen, claimed = mem.atomicCompareSwap[u64](&(*h).tail as *u64, head, end,
      MemOrder.SeqCst, MemOrder.Relaxed);
    if !claimed {
      return;
    }
    mem.atomicStore[u64](&(*h).head as *u64, end, MemOrder.Relaxed);
    var nx = ldSeg(&(*x).next as **Seg);
    if nx as usize == 0usize {
      nx = linkSmall(h, x);
    }
    retire(h, x, nx);
  }
}

// A small segment linked after s, for shrinkChain: made new (never a spare,
// which may be large), taking position base + count on. If a sender linked
// one first, that one is the answer and ours is kept as a spare or freed.
fn linkSmall(h: *Header, s: *Seg) *Seg {
  let fresh = segAlloc(h, u32.from(smallSlots(h)));
  (*fresh).base = (*s).base + u64.from((*s).count);
  (*fresh).pad = 0u32;
  mem.atomicStore[*Seg](&(*fresh).next as **Seg, nullSeg(), MemOrder.Relaxed);
  var seen = nullSeg();
  var linked = false;
  seen, linked = mem.atomicCompareSwap[*Seg](&(*s).next as **Seg, nullSeg(), fresh,
    MemOrder.SeqCst, MemOrder.SeqCst);
  if linked {
    return fresh;
  }
  keepSpare(h, fresh);
  seen
}

// Stop running h's actor, if no message is ready: whether it stopped, so that
// the worker lets go of it. A later send schedules it again (THE MAILBOX, in
// the package's header, has the protocol), in one of two ways:
//
// - nothing is claimed beyond what has been taken: the tail is marked idle
//   with one compare-and-swap, which fails if a send claimed a position that
//   moment. A send that claims a position afterwards finds the mark in the
//   word its claim added to, and, once it has published, the senders that
//   found it race to clear it, and the one that does schedules the actor.
// - a position is claimed and its slot is not yet published (a sender is
//   between its claim and its publication): the slot's 'seq' is changed, by
//   one compare-and-swap, to say the consumer waits for it. The sender's
//   publication is an exchange of that word, and finding the waiting mark
//   it schedules the actor. Whichever of the two operations comes second
//   sees the other, so either the slot is found published here, and the
//   actor goes on, or the sender schedules it.
//
// The worker never waits for the sender. A slot in a segment not yet linked
// has no word to mark, so the segment is linked here, as a sender would.
fn mailMarkIdle(h: *Header) bool {
  if mem.atomicLoad[u64](&(*h).tail as *u64, MemOrder.Relaxed) == (*h).head {
    atRest(h);
  }
  let head = (*h).head;
  var seen = 0u64;
  var marked = false;
  seen, marked = mem.atomicCompareSwap[u64](&(*h).tail as *u64, head, head | idleBit,
    MemOrder.AcqRel, MemOrder.Relaxed);
  if marked {
    return true;
  }
  var s = ldSeg(&(*h).cur as **Seg);
  if s as usize == 0usize {
    s = firstSeg(h);
  }
  if head >= (*s).base + u64.from((*s).count) {
    var nx = ldSeg(&(*s).next as **Seg);
    if nx as usize == 0usize {
      nx = linkAfter(h, s);
    }
    s = nx;
  }
  let seqp = seqOf(slotAt(h, s, head));
  let waiting = head * 8u64 + kindWaiting;
  while true {
    let q = mem.atomicLoad[u64](seqp, MemOrder.Acquire);
    if isPublished(q, head) {
      return false;
    }
    if q == waiting {
      return true;
    }
    var now = 0u64;
    var parked = false;
    now, parked = mem.atomicCompareSwap[u64](seqp, q, waiting, MemOrder.AcqRel, MemOrder.Acquire);
    if parked {
      return true;
    }
  }
  false
}

// ---------------------------------------------------------------------------
// An actor, as the runtime has it: one 'Arc' allocation holding a Mailbox,
// whose one field is the Header, and then the state
// ---------------------------------------------------------------------------

// The runtime's record of an actor: its mailbox, its place on the inject
// queue, and the functions made for its state and message types when it
// started. The type is private to this package, so nothing outside it can
// name it, read it or write it; the scheduler reaches an actor only through
// it. It holds raw pointers, which the thread check refuses; Mailbox, which
// holds it, declares Sendable, since the runtime orders every hand-off.
struct Header {
  pub tail: u64;                          // senders': the positions claimed, one per send; bit 63, idle (the mailbox's ring, above)
  pub head: u64;                          // the running worker's: the position of the next message to take
  pub cur: *Seg;                          // ... the segment holding it (senders read it)
  pub hint: *Seg;                         // senders': the last segment one used (atomic)
  pub extra: *Extra;                      // the running worker's: the drained segments and the spares, once there are any (atomic)
  pub stride: u32;                        // the size of a slot, in bytes
  pub bytes: u32;                         // bytes of segments this mailbox holds now (atomic)
  pub high: u32;                          // most messages queued at once, as the worker running the actor saw it at the start of a turn
  pub limit: u32;                         // how many queued is too many (noLimit: never)
  pub link: *Header;                      // the next actor on the inject queue
  pub run: &fn(h: *Header, limit: u32) u32; // runBatch[S, M]
  pub release: &fn(h: *Header);            // releaseHold[M]
  pub finalize: &fn(h: *Header);           // finalizeState[S, M]
  pub dispatch: *u8;                      // the actor's dispatch function
  pub par: *ParPending = null;            // a behaviour's 'parallel each' to begin once it has returned (parallel.cone, A PARALLEL EACH IN A BEHAVIOUR)
  pub ready: *ParPending = null;          // ... finished: the rest of the behaviour, to run ahead of the mailbox
  pub gc: *ActorRegion = null;            // the actor's own region: null until the actor first asks for it (INSIDE AN ACTOR, above; gc.cone), a record of its own that never moves
  pub tid: u32 = 0u32;                    // the actor's number for the TRACING HOOKS (below): 1 up, in the order the actors were made
  pub untraced: u32 = 0u32;               // 1: the hooks record nothing for this actor (a trace's own logger; untrace, below)
}

// What an actor's handle owns, 'Arc[opaq, T]': the runtime's part of an actor
// taking messages M. Its one field is private, and of a type private to the
// package: a handle can copy it, drop it, and send an M to it, and nothing
// else. It declares Sendable, taken on trust: the runtime orders every
// hand-off of what it holds. It says nothing of the state, which is not in
// its type, so the state's type is never asked.
pub struct Mailbox[M: Sendable] is Sendable {
  hdr: Header;

  fn made(h: Header) Mailbox[M] {Mailbox[M](h)}

  // The actor's death: its state finalized, then its mailbox's segments
  // freed; Arc frees the block, state and all, after this
  fn final(self: &uni) {
    actorDied(self as *Header);
  }
}

// The one allocation: the Mailbox first, so that the owner's address is the
// Header's, then the state
struct Block[S, M: Sendable] {
  pub mb: Mailbox[M];
  pub state: S;
}

// The state of actor h, whose state is an S
fn stateOf[S, M: Sendable](h: *Header) *S {
  &(*(h as *Block[S, M])).state as *S
}

fn actorDied(h: *Header) {
  let finalize = (*h).finalize;
  finalize(h);
  // The actor's region goes after its state, whose finals may read what they
  // reach in it: every object with a final is finalized, then the region freed
  if (*h).gc as usize != 0usize {
    ((*h).gc as &mut ActorRegion).die();
    libc.free((*h).gc as *u8);
  }
  // The mailbox is empty (an actor dies only when it is), so every segment
  // is free to go: the chain from the consumer's, the drained ones waiting
  // for reuse, those kept, and the spare
  var s = (*h).cur;
  while s as usize != 0usize {
    let nx = (*s).next;
    segFree(h, s);
    s = nx;
  }
  let e = (*h).extra;
  if e as usize != 0usize {
    s = (*e).retHead;
    while s as usize != 0usize {
      let nx = *retNext(s);
      segFree(h, s);
      s = nx;
    }
    s = (*e).pool;
    while s as usize != 0usize {
      let nx = *retNext(s);
      segFree(h, s);
      s = nx;
    }
    var i = 0usize;
    while i < spareCount {
      s = *spareAt(e, i);
      if s as usize != 0usize {
        segFree(h, s);
      }
      i = i + 1usize;
    }
    libc.free(e as *u8);
  }
}

// Finalize actor h's state: moved out of the block and dropped, so its own
// 'final' runs, then its fields'
fn finalizeState[S, M: Sendable](h: *Header) {
  let st = mem.readRaw[S](stateOf[S, M](h));
}

// ---------------------------------------------------------------------------
// What an actor's code calls: startActor, send, and the thread check. Each
// generic function is compiled into the module that uses it, for its state
// S and message enum M; the rest of the runtime is compiled here once, and
// reaches an actor only through its Header.
// ---------------------------------------------------------------------------

// A new actor is made in two steps (A NEW ACTOR, above), which the handle's
// initializer generated for each of the state's calls:
//
//   imm st = actors.makeActor[S, M](&dispatch);   the block, the state unmade
//   mem.writeRaw[S](st, S(...));               the init, filling it in place
//   actors.startActor[S, M](st)                    the handle's owner

// A new actor's block, its state not yet made: where the state goes, for its
// init to fill. The workers start first, if this is the first actor. An
// 'Arc' allocation holds the Mailbox and then the state, its mailbox with no
// segment of slots yet (the first send makes it: firstSeg), busy; its count is
// one, the owner startActor answers. The state's
// bytes are a placeholder until its init fills them, never read or finalized.
// Nothing outside the init can reach the actor until startActor returns, so
// the header is written plainly; whatever hands the handle on orders it. The
// dispatch function is handed each message where it lies in its slot, and
// takes it: it moves every field out, and the slot is then done with, nothing
// in it finalized.
pub fn makeActor[S, M: Sendable](dispatch: &fn(s: &uni S, m: *M)) *S {
  ensureRunning();
  let room = libc.malloc(mem.sizeof[S]() + 1usize);
  if room as usize == 0usize {
    die("actors: out of memory for an actor");
  }
  if mem.alignof[M]() > 16usize {
    die("actors: a message type aligned beyond 16 bytes");
  }
  let payload = payloadBytes[M]();
  var f = dispatch;
  var h = Header(tail: 0u64, head: 0u64, cur: nullSeg(), hint: nullSeg(),
    extra: nullExtra(), stride: u32.from(slotHead + payload), bytes: 0u32, high: 0u32, limit: noLimit,
    link: nullHeader(), run: &runBatch[S, M], release: &releaseHold[M],
    finalize: &finalizeState[S, M], dispatch: *(&mut f as **u8));
  // No segment: an actor that is never sent a message costs no more than its
  // block, and the first send makes the first (firstSeg)
  // the actor's number for the tracing hooks
  h.tid = mem.atomicAdd[u32](&traceActors as *u32, 1u32, MemOrder.Relaxed) + 1u32;
  let b = Arc[opaq, Block[S, M]](Mailbox[M].made(h), mem.readRaw[S](room as *S));
  libc.free(room);
  // The owner of the block, put away uncounted as its address, which is the
  // Header's: startActor remakes it
  var slot: *u8 = null;
  mem.writeRaw[Arc[opaq, Block[S, M]]](&mut slot as *(Arc[opaq, Block[S, M]]), b);
  // The collector's knobs read once (gc.cone)
  readEnv();
  stateOf[S, M](slot as *Header)
}

// The actor whose state at st its init has made: the 'Arc[opaq, T]' owner of
// its Mailbox, which its handle holds -- the owner makeActor put away, remade
// from the address, moved, not copied. Its mailbox is marked idle, unless a
// message was sent while the init ran: then the actor is queued, as a send
// finding it idle queues it, to run them in the order sent.
pub fn startActor[S, M: Sendable](st: *S) Arc[opaq, Mailbox[M]] {
  let h = headerOf[S, M](&*st);
  if !mailMarkIdle(h) {
    holdArc[M](h);
    schedule(h);
  }
  var slot = h;
  mem.readRaw[Arc[opaq, Mailbox[M]]](&mut slot as *(Arc[opaq, Mailbox[M]]))
}

// Send msg to the actor whose Mailbox mb is: push it, and, if the push found
// the actor idle, take the scheduler's owner of it and queue it. The caller
// holds a handle, so the actor cannot die meanwhile. From a piece of a
// 'parallel each' (a thread running one has curPiece set) the message is kept
// instead, to be sent after the loop in iteration order (parallel.cone, SENDS
// GATHERED).
pub fn send[M: Sendable](mb: &opaq Mailbox[M], msg: M) {
  sendTo[M](mb as *Header, msg);
}

// send, to the mailbox's header
fn sendTo[M: Sendable](h: *Header, msg: M) {
  if curPiece != 0usize {
    gatherSend[M](h, msg);
    return;
  }
  sendNow[M](h, msg);
}

// The message pushed on the mailbox now
fn sendNow[M: Sendable](h: *Header, msg: M) {
  if running.load() == 0usize {
    die("actors: a message sent after the runtime stopped");
  }
  // One atomic add claims the slot's position; the message is written in
  // place, then one store publishes it (THE MAILBOX, above)
  let c = claim(h);
  // the send's id is the message's cause word (TRACING HOOKS, below), 0 when untraced
  var cause = 0u64;
  if traceLayerOn(traceLayerActors) {
    cause = traceSend(h, traceKindSend);
  }
  mem.atomicStore[u64](ccause(c.slot), cause, MemOrder.Relaxed);
  mem.writeRaw[M](payloadOf(c.slot) as *M, msg);
  if stallState.loadOrdered(MemOrder.Relaxed) != 0u32 {
    stallHere();
  }
  let waited = publish(c, kindMsg);
  if wakeAfter(h, c, waited) {
    holdArc[M](h);
    schedule(h);
  }
}

// The slot's cause word (the header's second word)
fn ccause(slot: *u8) *u64 {(slot + 8usize) as *u64}

// The thread check, asked of an argument of an actor's 'start': v,
// unchanged, if its type may cross threads; refused where it is written if not
pub fn sendable[T: Sendable](v: T) T {v}

// Run up to limit of the actor's messages, each handed to the dispatch
// function where it lies in its slot, which takes it: how many ran. A reply's
// slot is not a message of the enum, and goes to its resume function. The
// slot is then done with (ringDone), its message never finalized. Only the
// worker that took the actor from a queue calls this.
fn runBatch[S, M: Sendable](h: *Header, limit: u32) u32 {
  var slot = (*h).dispatch;
  let f = mem.readRaw[&fn(s: &uni S, m: *M)](&mut slot as *(&fn(s: &uni S, m: *M)));
  let st = stateOf[S, M](h);
  let rec = mem.typeRecord[S]();
  curActor = h as usize;
  var n = 0u32;
  // A 'parallel each' this actor's behaviour left has finished: the rest of the
  // behaviour runs first, ahead of whatever the mailbox holds
  let ready = (*h).ready;
  if ready as usize != 0usize {
    (*h).ready = nullPar();
    runReady[S](st, ready);
    afterMessage(h, st as *u8, rec);
  }
  // A behaviour that begins a 'parallel each' returns, and the actor then runs
  // nothing more until the loop has finished: runActor begins it
  noteDepth(h);
  reclaim(h);
  while n < limit && (*h).par as usize == 0usize {
    let slot = ringPeek(h);
    if slot as usize == 0usize {
      curActor = 0usize;
      reclaim(h);
      return n;
    }
    let kind = mem.atomicLoad[u64](seqOf(slot), MemOrder.Relaxed) % 8u64;
    // the tracing hooks: the message's cause id is in its slot's header
    let tracing = traceLayerOn(traceLayerActors) && (*h).untraced == 0u32;
    var cause = 0u64;
    var bhv = 0u64;
    if tracing {
      cause = mem.atomicLoad[u64](ccause(slot), MemOrder.Relaxed);
      bhv = behaviourOf(rec, kind, payloadOf(slot));
      traceRunStart(h, cause, bhv);
    }
    if kind == kindMsg {
      f(stateOf[S, M](h) as &uni S, payloadOf(slot) as *M);
    } else {
      resumeSlot[S](st, payloadOf(slot), kind);
    }
    if tracing {
      traceRunEnd(h, cause, bhv);
    }
    ringDone(h);
    n = n + 1u32;
    afterMessage(h, st as *u8, rec);
  }
  curActor = 0usize;
  reclaim(h);
  n
}

// The mailbox's depth, as the worker starting a turn sees it: the high-water
// mark (MAILBOX LIMIT, above)
fn noteDepth(h: *Header) {
  let depth = (mem.atomicLoad[u64](&(*h).tail as *u64, MemOrder.Relaxed) & posMask) - (*h).head;
  if depth > u64.from((*h).high) {
    if depth > u64.from(noLimit) {
      (*h).high = noLimit;
    } else {
      (*h).high = u32.from(depth);
    }
  }
}

// A message has finished, between it and the next: the actor's own collector,
// if it has one, may collect (INSIDE AN ACTOR). Not while a 'parallel each' the
// behaviour began is still to run its passes, which hold the references they
// read where no collection finds them.
fn afterMessage(h: *Header, st: *u8, rec: *TypeRecord) {
  if (*h).gc as usize == 0usize || (*h).par as usize != 0usize {
    return;
  }
  collectIfDue((*h).gc as &mut ActorRegion, st, rec);
}

// The rest of a behaviour cut at its 'parallel each', run as a reply's dispatch
// runs a second half (resume, resumeId): the seam's resume function, with the
// record's id where the record is not empty, and no value
fn runReady[S](st: *S, p: *ParPending) {
  let run = (*p).resume;
  let id = (*p).id;
  let hasId = (*p).hasId;
  libc.free(p as *u8);
  if hasId {
    resumeId[S](&mut *st, run, id, null);
  } else {
    resume[S](&mut *st, run, null);
  }
}

// The scheduler takes its owner: an owner remade from the address, uncounted,
// then copied, which counts one more, and both put away uncounted, so that
// the count is one more and nothing will drop either. It is Arc's own copy,
// so the count is Arc's (a Relaxed add), whatever Arc's layout.
fn holdArc[M: Sendable](h: *Header) {
  var slot = h;
  let o = mem.readRaw[Arc[opaq, Mailbox[M]]](&mut slot as *(Arc[opaq, Mailbox[M]]));
  let held = o;
  var gone1 = h;
  var gone2 = h;
  mem.writeRaw[Arc[opaq, Mailbox[M]]](&mut gone1 as *(Arc[opaq, Mailbox[M]]), o);
  mem.writeRaw[Arc[opaq, Mailbox[M]]](&mut gone2 as *(Arc[opaq, Mailbox[M]]), held);
}

// The scheduler lets go of its owner: remade from the address and dropped,
// Arc's own drop (a Release subtract; an Acquire load and the actor's
// death, Mailbox's finalizer and the free, if it was the last).
fn releaseHold[M: Sendable](h: *Header) {
  var slot = h;
  let o = mem.readRaw[Arc[opaq, Mailbox[M]]](&mut slot as *(Arc[opaq, Mailbox[M]]));
}

// ---------------------------------------------------------------------------
// Tracing hooks: three events, behind one word. Nothing here knows of the
// package that records them (actortrace): the hooks call a SINK, a function
// the recording package hands to traceSetSink, so this package imports no
// tracing and stays under it. THE HOOKS: a send (traceSend, in sendNow
// between the slot's claim and its publication), a reply (the same hook, in
// replyPrep and pushFuture: a reply is a message too), the start of a
// message's run and its end (traceRunStart and traceRunEnd, in runBatch around
// the dispatch). Each is behind a layer's bit in traceMask: a disabled hook
// costs one relaxed load and a bit test. THE CAUSE: a send makes a fresh id,
// writes it into its slot's 'cause' word (the header's second word, ccause)
// and passes it to the sink as the record's id, with the id of the message the
// sender is running (0 off the workers or between messages) as the record's
// argument; the run records of that message carry the same id (read back from
// the slot), so a send's record and its run start give the message's time in
// the mailbox, and the sends a message's behaviour made name it as their
// cause. The id of the message a worker is running is its Worker's 'cause',
// set at the run's start and cleared at its end; a reply's slot carries the
// reply's own send id, so a continuation resumed after an 'await' runs under
// the reply's id, whose send record names the answering message as its cause
// (a deviation from keeping the awaiting message's own id). A record is (kind,
// worker, actor, id, argument); the sink adds the time. THE ACTOR'S NUMBER:
// 'tid' in the Header, 1 up, in the order the actors were made. A run's
// argument is the behaviour: the low 8 bits the message enum's tag (a variant
// of the actor's Msg; a reply's slot has 240 plus its kind), the upper 32 an
// address of the actor's state type record, shifted, which tells the actor
// types apart (the compiler makes no type name available here). untrace marks
// an actor whose hooks record nothing: the trace's own logger.
//
// The mask, the sink, the id counter and the actor counter are 'let' globals
// of Atomic, set in 'init' like 'running': no thread-local, no other form.
// ---------------------------------------------------------------------------

pub const traceLayerActors = 0u32;      // the layer the three hooks belong to
pub const traceKindSend = 1u32;         // a message sent
pub const traceKindReply = 2u32;        // a reply sent (an awaited answer)
pub const traceKindRun = 3u32;          // a message's run begins
pub const traceKindEnd = 4u32;          // a message's run ends

// Bit L set: layer L is recorded. Set only after the sink is set
let traceMask: Atomic[u32];
let traceSink: Atomic[usize];     // the sink, a function address, or 0
let traceIds: Atomic[u64];        // send ids made off the workers
let traceActors: Atomic[u32];     // actors made so far (their tid)

// Whether layer L's records are wanted: one relaxed load and a bit test
pub fn traceLayerOn(layer: u32) bool {
  (mem.atomicLoad[u32](&traceMask as *u32, MemOrder.Relaxed) & (1u32 << layer)) != 0u32
}

// Which layers are recorded: bit L for layer L, up to 32. The sink first
pub fn traceSetMask(mask: u32) {
  mem.atomicStore[u32](&traceMask as *u32, mask, MemOrder.SeqCst);
}

pub fn traceMaskNow() u32 {
  mem.atomicLoad[u32](&traceMask as *u32, MemOrder.SeqCst)
}

// The function every record goes to, called on the thread that made the event
// with the record's kind, worker (noWorker off the workers), actor, id and
// argument
pub fn traceSetSink(sink: &fn(kind: u32, worker: u32, tid: u32, id: u64, arg: u64)) {
  var f = sink;
  traceSink.store(mem.readRaw[usize](&mut f as *usize));
}

// A record to the sink, if there is one: also the way a program's own record
// kinds reach it
pub fn traceEmit(kind: u32, tid: u32, id: u64, arg: u64) {
  var p = traceSink.load();
  if p == 0usize {
    return;
  }
  let f = mem.readRaw[&fn(kind: u32, worker: u32, tid: u32, id: u64, arg: u64)](
    &mut p as *(&fn(kind: u32, worker: u32, tid: u32, id: u64, arg: u64)));
  f(kind, workerIndex(), tid, id, arg);
}

// A fresh id: a worker's own counter below its index + 1, else one shared
// counter below 0xFFFF
fn traceNewId() u64 {
  let w = me as *Worker;
  if w as usize != 0usize {
    (*w).seq = (*w).seq + 1u64;
    return (u64.from((*w).index + 1u32) << 48u64) | (*w).seq;
  }
  (0xFFFFu64 << 48u64) | (mem.atomicAdd[u64](&traceIds as *u64, 1u64, MemOrder.Relaxed) + 1u64)
}

// The id of the message the calling worker is running, or 0
pub fn traceCause() u64 {
  let w = me as *Worker;
  if w as usize == 0usize {
    return 0u64;
  }
  (*w).cause
}

// The number of the actor whose message the caller is running, or 0
pub fn traceActorNow() u32 {
  let h = curActor as *Header;
  if h as usize == 0usize {
    return 0u32;
  }
  (*h).tid
}

// The number the next actor made will have, less one: the actors made so far
pub fn actorsMade() u32 {
  mem.atomicLoad[u32](&traceActors as *u32, MemOrder.Relaxed)
}

// Mark the actor whose Mailbox mb is untraced: no hook records a send to it,
// a reply to it or a message of its running. Called by the maker, before
// the actor is sent anything
pub fn untrace[M: Sendable](mb: &opaq Mailbox[M]) {
  (*(mb as *Header)).untraced = 1u32;
}

// A send (or a reply) to actor h: its id made and the record passed on; the
// id, which the caller puts in the slot's cause word. 0 for an untraced actor
fn traceSend(h: *Header, kind: u32) u64 {
  if (*h).untraced != 0u32 {
    return 0u64;
  }
  let id = traceNewId();
  traceEmit(kind, (*h).tid, id, traceCause());
  id
}

// The behaviour a slot's message is: the tag of its enum (the payload's first
// byte; 240 plus the kind for a reply's slot), with the actor's state type
fn behaviourOf(rec: *TypeRecord, kind: u64, payload: *u8) u64 {
  var tag = 240u64 + kind;
  if kind == kindMsg {
    tag = u64.from(*payload);
  }
  (u64.from((rec as usize) >> 4usize) << 32u64) | tag
}

fn traceRunStart(h: *Header, id: u64, behaviour: u64) {
  let w = me as *Worker;
  if w as usize != 0usize {
    (*w).cause = id;
  }
  traceEmit(traceKindRun, (*h).tid, id, behaviour);
}

fn traceRunEnd(h: *Header, id: u64, behaviour: u64) {
  traceEmit(traceKindEnd, (*h).tid, id, behaviour);
  let w = me as *Worker;
  if w as usize != 0usize {
    (*w).cause = 0u64;
  }
}

// ---------------------------------------------------------------------------
// Awaiting: a request's reply, and the continuations an actor parks. The
// compiler generates every call of these, from an actor's 'await's and its
// messages that return a value; nothing else has a use for them. AWAITING,
// above, is how they fit together.
// ---------------------------------------------------------------------------

// The envelope of a request that is awaited: where its one reply goes. It is
// in the message, never in the method's parameters. 'to' is the actor that
// awaits, of which the envelope holds one count, so that it cannot die while
// the reply is owed; 'at' is the awaiting actor's resume function (the
// seam's: which second half), 'id' the record's id where it has one, and
// 'meta' says what the reply needs to be written (below). Nothing is
// allocated to make one: the actor answering claims a slot in the awaiting
// actor's own ring at the time it answers, and writes the resume record and
// the value into it (REPLIES, above). So the actor answering knows nothing of
// the other's type: it needs only the size of the value, which 'meta' has.
// Or the request's value is stored, not awaited at once ('imm fut =
// f.g(x)'): then the Reply is the producer's reference to a future (FUTURES,
// futures.cone), 'cell', and 'at' is where in the future the value goes; it
// names no actor. A Reply with no 'to' and no 'cell' wants no answer.
// Sendable on trust, as Mailbox is: the runtime orders every hand-off of it.
//
// 'meta' is the value's size in bytes, times 16, plus four flags: replyHasId
// (the record has an id), replyBoxed (the value is too large for a slot's
// payload, or too finely aligned, so the answer allocates a box for it),
// replyOp (the reply of an awaited operation, counted in opsStarted until it
// is spent) and replySpent (the reply has been answered in place, ANSWERED IN
// PLACE below: nothing else in 'meta' means anything then, except replyOp).
pub struct Reply is Sendable {
  to: *Header = null;
  at: *u8 = null;
  id: u64 = 0u64;
  cell: *u8 = null;
  meta: u64 = 0u64;

  // A reply never sent: its count let go (it holds no memory of its own). A
  // future's is abandoned: nothing will ever arrive in it, and whoever awaits
  // it is told so. An operation's, sent or never sent, is spent here: it is no
  // longer outstanding (waitUntilIdle)
  fn final(self: &uni) {
    if to as usize != 0usize {
      let release = (*to).release;
      release(to);
    }
    else if cell as usize != 0usize {
      futureEnd(cell, futAbandoned);
    }
    if (meta & replyOp) != 0u64 {
      opSpent();
    }
  }
}

const replyHasId = 1u64;
const replyBoxed = 2u64;
const replyOp = 4u64;
const replySpent = 8u64;

// A reply's meta, from the value's size and its flags
fn metaOf(size: usize, flags: u64) u64 {
  u64.from(size) * 16u64 + flags
}

// Whether the reply goes anywhere: to an actor that awaits it, or into a
// future
fn wanted(r: &Reply) bool {
  r.to as usize != 0usize || r.cell as usize != 0usize
}

// The round-up of n to a multiple of a, a power of two
fn roundUp(n: usize, a: usize) usize {
  (n + a - 1usize) & ~(a - 1usize)
}

// The Header of the actor whose state is at st: where stateOf finds st,
// taken back
fn headerOf[S, M: Sendable](st: &S) *Header {
  let base = 4096usize as *Header;
  let off = (stateOf[S, M](base) as usize) - 4096usize;
  ((st as *S as usize) - off) as *Header
}

// The handle of the actor whose state is at st, its 'selfactor': another
// owner of its Mailbox, counted, as copying a handle is
pub fn selfOf[S, M: Sendable](st: &S) Arc[opaq, Mailbox[M]] {
  var slot = headerOf[S, M](st);
  let o = mem.readRaw[Arc[opaq, Mailbox[M]]](&mut slot as *(Arc[opaq, Mailbox[M]]));
  let held = o;
  var gone = slot;
  mem.writeRaw[Arc[opaq, Mailbox[M]]](&mut gone as *(Arc[opaq, Mailbox[M]]), o);
  held
}

// A request's envelope, made by the actor whose state is at st as it awaits:
// a count of its actor taken, and nothing allocated. 'run' is the seam's
// resume function, 'id' the record's id where 'hasId', and 'size' and 'align'
// those of the value awaited, which says whether the answer fits a slot's
// payload (after the resume record) or is boxed. The actor's generated code
// calls this (reply', replyid').
pub fn replyFor[S, M: Sendable](st: &S, run: *u8, id: u64, hasId: bool, size: usize, align: usize) Reply {
  let h = headerOf[S, M](st);
  holdArc[M](h);
  var flags = 0u64;
  if hasId {flags = replyHasId;}
  if size > strideOf(h) - slotHead - replyHead || align > 16usize {
    flags = flags | replyBoxed;
  }
  Reply(to: h, at: run, id: id, meta: metaOf(size, flags))
}

// A reply's slot, claimed in the awaiting actor's ring and its resume record
// written: the resume function and the id, then where the value goes, in the
// payload or in a box of its own (allocated here, freed by the awaiting
// actor's worker once the second half has taken the value)
struct Put {
  pub c: Claim;
  pub kind: u64;
  pub at: *u8;       // where the value goes
}

fn replyPrep(r: &Reply) Put {
  replyPrepLent(r, null, null)
}

// The same, for a value that is already written elsewhere and stays there
// (LENT ANSWERS, below): where the value goes in the slot is then the pair
// 'lent' + 1 and the function that lets go of it, in place of a box
fn replyPrepLent(r: &Reply, lent: *u8, release: *u8) Put {
  let h = r.to;
  let c = claim(h);
  var cause = 0u64;
  if traceLayerOn(traceLayerActors) {
    cause = traceSend(h, traceKindReply);
  }
  mem.atomicStore[u64](ccause(c.slot), cause, MemOrder.Relaxed);
  let p = payloadOf(c.slot);
  *(p as **u8) = r.at;
  *((p + 8usize) as *u64) = r.id;
  var kind = kindReply;
  if (r.meta & replyHasId) != 0u64 {kind = kind + 1u64;}
  var at = p + replyHead;
  if (r.meta & replyBoxed) != 0u64 {
    if lent as usize != 0usize {
      *(at as **u8) = ((lent as usize) + 1usize) as *u8;
      *((at + 8usize) as **u8) = release;
      at = lent;
    } else {
      var size = usize.from(r.meta / 16u64);
      if size == 0usize {size = 1usize;}
      let box = libc.malloc(size);
      if box as usize == 0usize {
        die("actors: out of memory for a reply");
      }
      boxAllocs.addOrdered(1u64, MemOrder.Relaxed);
      *(at as **u8) = box;
      at = box;
    }
    kind = kind + 2u64;
  }
  Put(c, kind, at)
}

// The value is written: publish the slot. The count the envelope held becomes
// the scheduler's owner when the publication takes the idle mark, as a
// send's own would; otherwise it is let go
fn replyFinish(h: *Header, p: Put) {
  if running.load() == 0usize {
    die("actors: a reply sent after the runtime stopped");
  }
  let waited = publish(p.c, p.kind);
  if wakeAfter(h, p.c, waited) {
    schedule(h);
  } else {
    let release = (*h).release;
    release(h);
  }
}

// Send the reply, its value written elsewhere: a future's. The value has been
// written into the future, which arrives.
fn post(r: &mut Reply) {
  let c = r.cell;
  if c as usize != 0usize {
    r.cell = null;
    futureEnd(c, futArrived);
  }
}

// A message that returns a value, and holds no 'await', answering its
// request: the value goes back in the reply
pub fn answerNow[R](rp: Reply, v: R) {
  var r = rp;
  answerNowIn[R](&mut r, v);
}

// ANSWERED IN PLACE. An answerer that keeps the reply where it lives, in a
// record of its own (the aio package's record of an operation), answers it
// there with answerNowIn or answerLentIn, which answer as answerNow and
// answerLent do and then leave the Reply SPENT: the same Reply, no longer
// owing anything (no actor to answer, no future to fill), whose 'final' does no
// more than count the operation spent, if it is an operation's. It is the real
// value after use, not a blank put in its place. A spent reply answered again
// is a program error, a panic; one never answered is let go as before (the
// awaiting behaviour is abandoned, a future's is told). The answerer lets the
// Reply go whenever its record does.
pub fn answerNowIn[R](rp: &mut Reply, v: R) {
  notSpent(rp);
  if !wanted(rp) {
    spend(rp);
    return;
  }
  if rp.cell as usize != 0usize {
    mem.writeRaw[R](rp.at as *R, v);
    post(rp);
    spend(rp);
    return;
  }
  let h = rp.to;
  let p = replyPrep(rp);
  mem.writeRaw[R](p.at as *R, v);
  spend(rp);
  replyFinish(h, p);
}

// A reply answered twice is a program error
fn notSpent(r: &Reply) {
  if (r.meta & replySpent) != 0u64 {
    die("actors: a reply answered twice");
  }
}

// The reply is answered: it owes nothing now, and says so (the operation flag
// stays, for 'final' to count the operation spent)
fn spend(r: &mut Reply) {
  r.to = null;
  r.cell = null;
  r.meta = (r.meta & replyOp) | replySpent;
}

// LENT ANSWERS. A value too large for a slot is boxed: the answering side
// allocates a box for it, writes it there, and the awaiting actor's worker
// frees the box after the second half has taken the value. An answerer that
// keeps a place of its own for the answer (the aio package's record of a
// socket) lends it instead: 'answerLent(rp, p, take)' answers with a value
// ALREADY WRITTEN at p, and nothing is allocated. 'take(p, to)' is the
// answerer's function that MOVES the value from p to 'to' and lets go of the
// place (the answerer's word that it is free for the next operation). The
// awaiting actor's worker calls it as it reaches the reply, with a place of
// its own on its stack for the value (so that the place is free again BEFORE
// the behaviour goes on, which may start the next operation on the same
// record), and then runs the second half on the value there. Where the value
// would have fitted the slot, or is larger than lentMax bytes, 'take' is called
// at once on the slot or on a box of the ordinary kind, so the answerer need
// not know which. The slot holds p + 1 (the low bit says "lent": a box's
// address has it clear) and the function. 'p' stays valid, and nobody else
// touches the value, until take(p, to) has been called. A reply that wants
// no answer, or is a future's, is handled the way answerNow handles it, the
// value dropped or moved into the future by take.
pub fn answerLent[R](rp: Reply, p: *R, take: &fn(p: *u8, to: *u8)) {
  var r = rp;
  answerLentIn[R](&mut r, p, take);
}

// answerLent for a Reply that stays where it is, left spent (ANSWERED IN
// PLACE, above). 'take' is called as answerLent's is, but always AFTER the
// Reply is spent, and nothing here touches the Reply after 'take' has been
// called: so 'take' may let go of the record that holds the Reply (the aio
// package's take dissolves its record, the spent Reply with it, and makes the
// value it writes at 'to' from the record's pieces; 'p' is then the record,
// not a value already written). Where 'take' is called here, before the answer
// is pushed, the operation is held counted (opHold) until the push, since the
// Reply's drop in 'take' counts it spent
pub fn answerLentIn[R](rp: &mut Reply, p: *R, take: &fn(p: *u8, to: *u8)) {
  notSpent(rp);
  let op = (rp.meta & replyOp) != 0u64;
  if !wanted(rp) {
    let tmp = libc.malloc(mem.sizeof[R]() + 16usize);
    if tmp as usize == 0usize {
      die("actors: out of memory for a reply");
    }
    spend(rp);
    opHold(op);
    take(p as *u8, tmp);
    mem.finalize[R](tmp as *R);
    libc.free(tmp);
    opRelease(op);
    return;
  }
  if rp.cell as usize != 0usize {
    let c = rp.cell;
    let at = rp.at;
    spend(rp);
    opHold(op);
    take(p as *u8, at);
    futureEnd(c, futArrived);
    opRelease(op);
    return;
  }
  let h = rp.to;
  if (rp.meta & replyBoxed) != 0u64 && mem.sizeof[R]() <= lentMax && mem.alignof[R]() <= 8usize {
    var tk = take;
    let takep = mem.readRaw[*u8](&mut tk as *(*u8));
    let put = replyPrepLent(rp, p as *u8, takep);
    spend(rp);
    replyFinish(h, put);
    return;
  }
  let put = replyPrep(rp);
  spend(rp);
  opHold(op);
  take(p as *u8, put.at);
  replyFinish(h, put);
  opRelease(op);
}

// An operation held counted over a 'take' its answerer runs before the push
// (answerLentIn): one more started now, one more spent after the push, so the
// counts are never equal while the Reply's drop has counted it and the answer
// is not yet pushed
fn opHold(op: bool) {
  if op {opsStarted.addOrdered(1u64, MemOrder.SeqCst);}
}

fn opRelease(op: bool) {
  if op {opSpent();}
}

// The largest value a lent answer is taken into on the worker's stack
const lentMax = 128usize;

// While a message that returns a value and holds an 'await' runs, the
// envelope it answers waits in its actor's state, in an Answer: each seam
// takes it into its record, and each second half puts it back, so that it
// travels with the continuation; 'held' says it is there. Whichever half
// returns the value answers it (answerAt, and the compiler's resume
// functions).
pub struct Answer {
  reply: Reply = Reply();
  held: u8 = 0u8;
  claimed: u8 = 0u8;        // 1 between answerTo and answered when answerTo claimed the awaiting actor's slot
  put: Put = Put(Claim(null, 0u64, false), 0u64, null);
}

// The dispatcher's hand-off, before such a message runs: the request's
// envelope into the slot; or, for a send with no 'await', no envelope, so
// that the value is dropped as the message returns it
pub fn ask(slot: &mut Answer, rp: Reply) {
  slot.reply = rp;
  slot.held = 1u8;
}
pub fn askNone(slot: &mut Answer) {
  slot.reply = Reply();
  slot.held = 1u8;
}

// The address a method's value is kept at, so that the dispatcher takes it
// only when the method returned one: a temporary that a raw pointer
// outlives is never finalized where it stands
pub fn keep[R](r: &R) *R {r as *R}

// Where a message's returned value goes, now that it has returned: 0 where
// a seam took the envelope (the method is parked, and returned no value); 1
// where nobody waits for the value, which is dropped; else where the reply
// holds it
pub fn answerTo(slot: &mut Answer) *u8 {
  if slot.held == 0u8 {
    return null;
  }
  if !wanted(&slot.reply) {
    return 1usize as *u8;
  }
  if slot.reply.cell as usize != 0usize {
    return slot.reply.at;
  }
  // An actor awaits it: its slot is claimed now, and the caller writes the
  // value in, a moment later (answered publishes it)
  slot.put = replyPrep(&slot.reply);
  slot.claimed = 1u8;
  slot.put.at
}

// The value is where answerTo said: the reply is sent, and the slot emptied
pub fn answered(slot: &mut Answer) {
  slot.held = 0u8;
  if slot.claimed != 0u8 {
    slot.claimed = 0u8;
    let h = slot.reply.to;
    slot.reply.to = null;
    replyFinish(h, slot.put);
    return;
  }
  post(&mut slot.reply);
}

// The dispatcher, after a message that returns a value and holds an 'await'
// returned: its value is at r, unless a seam parked the message
pub fn answerAt[R](slot: &mut Answer, r: *R) {
  let d = answerTo(slot);
  if d as usize == 0usize {
    return;
  }
  let v = mem.readRaw[R](r);
  if d as usize == 1usize {
    answered(slot);
    return;
  }
  mem.writeRaw[R](d as *R, v);
  answered(slot);
}

// A reply arrived: call its resume function -- the one the compiler made for
// the seam, which calls its second half -- with the actor's state, the
// record's id where the record is not empty, and where the returned value
// is, in the reply's slot or its box
pub fn resume[S](st: &mut S, run: *u8, data: *u8) {
  var f = run;
  let fp = mem.readRaw[&fn(s: &mut S, data: *u8)](&mut f as *(&fn(s: &mut S, data: *u8)));
  fp(st, data);
}
pub fn resumeId[S](st: &mut S, run: *u8, id: u64, data: *u8) {
  var f = run;
  let fp = mem.readRaw[&fn(s: &mut S, id: u64, data: *u8)](&mut f as *(&fn(s: &mut S, id: u64, data: *u8)));
  fp(st, id, data);
}

// A reply's slot reached the front of the mailbox: its payload holds the
// resume function and the id, then the value (or a pointer to the box that
// holds it). The resume function takes the value out; a box is freed after
// it has (REPLIES, above)
fn resumeSlot[S](st: *S, p: *u8, kind: u64) {
  let run = *(p as **u8);
  let id = *((p + 8usize) as *u64);
  var data = p + replyHead;
  let boxed = kind >= kindReply + 2u64;
  if boxed {
    let w = *(data as *usize);
    if (w & 1usize) != 0usize {
      resumeLent[S](st, p, kind, run, id);
      return;
    }
    data = w as *u8;
  }
  if kind == kindReply + 1u64 || kind == kindReply + 3u64 {
    resumeId[S](&mut *st, run, id, data);
  } else {
    resume[S](&mut *st, run, data);
  }
  if boxed {
    libc.free(data);
  }
}

// A reply whose value is lent (LENT ANSWERS): the value is moved into a place
// of this stack's own and the lender's place given back, before the behaviour
// goes on
fn resumeLent[S](st: *S, p: *u8, kind: u64, run: *u8, id: u64) {
  var mine = Array[u64, 16]() <- fill 0u64;
  let w = *((p + replyHead) as *usize);
  var f = *((p + replyHead + 8usize) as **u8);
  let fp = mem.readRaw[&fn(p: *u8, to: *u8)](&mut f as *(&fn(p: *u8, to: *u8)));
  fp((w - 1usize) as *u8, &mine[0usize] as *u8);
  if kind == kindReply + 1u64 || kind == kindReply + 3u64 {
    resumeId[S](&mut *st, run, id, &mine[0usize] as *u8);
  } else {
    resume[S](&mut *st, run, &mine[0usize] as *u8);
  }
}

// An actor's pending table: its parked continuations' records, each in a
// block of its own, keyed by a plain id, the slot's index. A slot holds a
// record's block, or, free, the next free slot's index + 1, times 2, plus 1.
// A block begins with the record's type record (core's TypeRecord, made in the
// block at parking from the drop and the trace functions the compiler made for
// the seam) and an Erased value naming the record and that type record, which
// is how a collector reaches what a parked record holds; the record follows,
// recordHead bytes in. Only the actor's own methods touch it, one at a time.
pub struct Pending is GcTraceElements {
  slots: *usize = null;
  cap: usize = 0usize;
  free: usize = 0usize;     // The first free slot's index + 1, or 0
  count: usize = 0usize;    // How many records are parked

  // How a collector reaches the values the parked records hold, whatever the
  // seams' types: each record, as an Erased value, is traced by its own type
  // record's trace (a parked record is a root between messages)
  pub fn gcTraceElements(self: &mut) PendingWalk {
    PendingWalk(slots, cap, 0usize)
  }

  // An actor that dies with records parked abandons them: each record is
  // dropped, its values' finalizers run in the order its seam's would have
  // run them, and its second half never runs. Every record parked is owed a
  // reply whose envelope counts this actor, so it dies with one parked only
  // when that envelope was dropped unanswered: the I/O it awaited was ended
  // at the program's end (the aio package), or the actor that was to answer
  // abandoned its own continuation holding the envelope, or the future it
  // was parked on was abandoned so (futures.cone)
  fn final(self: &uni) {
    if slots as usize == 0usize {
      return;
    }
    var i = 0usize;
    while count != 0usize && i < cap {
      let v = *(slots + i);
      if v & 1usize == 0usize {
        let block = v as *u8;
        let drop = (*recordType(block)).finalize;
        drop(block + recordHead);
        libc.free(block);
        blocksGiven.addOrdered(1u64, MemOrder.Relaxed);
        count = count - 1usize;
      }
      i = i + 1usize;
    }
    libc.free(slots as *u8);
  }
}

// A cursor over the parked records, each as an Erased value: the first thing
// in its block
pub struct PendingWalk is Iterator[&mut Erased] {
  slots: *usize;
  cap: usize;
  at: usize;

  pub fn next(self: &mut) Option[&mut Erased] {
    while at < cap {
      let v = *(slots + at);
      at = at + 1usize;
      if v & 1usize == 0usize {
        return Some[&mut Erased](v as &mut Erased);
      }
    }
    None
  }
}

// Where a record begins in its block, after its Erased value and its type
// record: room enough that a record aligned as malloc aligns stays so
const recordHead = 64usize;

// The type record of the record in a block: after the Erased value
fn recordType(block: *u8) *TypeRecord {
  (block + 16usize) as *TypeRecord
}

// A function that traces nothing, for a record holding no traced reference
fn noTrace(record: *u8, mode: u32) {}

// A slot for a record of 'size' bytes, its block allocated: the id, which the
// request's resume message carries. 'drop' is the record's drop function,
// '&fn(record: *u8)', which the table calls if the actor dies with the record
// parked, and 'trace' the function '&fn(record: *u8, mode: u32)' handing each
// traced reference the record holds to its region (null where it holds none).
// A PLAIN ID, with no generation: a slot is freed only by the one
// reply its record is owed, which comes exactly once, and that reply's
// envelope holds this actor's count, so no reply can be stale, doubled, or
// sent to an actor that has died. A generation becomes necessary exactly
// when a timeout or a cancel can free a slot while its reply is still in
// flight, and nothing has a timeout path yet: an I/O operation's answer
// comes exactly once too, and its envelope counts the actor the same way.
pub fn parkReserve(p: &mut Pending, size: usize, drop: *u8, trace: *u8) u64 {
  if p.free == 0usize {
    var newcap = 8usize;
    if p.cap != 0usize {newcap = p.cap * 2usize;}
    let grown = libc.malloc(mem.sizeof[usize]() * newcap) as *usize;
    if grown as usize == 0usize {
      die("actors: out of memory for the pending table");
    }
    var i = 0usize;
    while i < p.cap {
      *(grown + i) = *(p.slots + i);
      i = i + 1usize;
    }
    while i < newcap {
      var next = 0usize;
      if i + 1usize < newcap {next = i + 2usize;}
      *(grown + i) = next * 2usize + 1usize;
      i = i + 1usize;
    }
    if p.slots as usize != 0usize {
      libc.free(p.slots as *u8);
    }
    p.free = p.cap + 1usize;
    p.slots = grown;
    p.cap = newcap;
  }
  let id = p.free - 1usize;
  let slot = p.slots + id;
  p.free = *slot / 2usize;
  let block = takeBlock(recordHead + size);
  if block as usize == 0usize {
    die("actors: out of memory for a continuation");
  }
  var d = drop;
  let dropfn = mem.readRaw[&fn(record: *u8)](&mut d as *(&fn(record: *u8)));
  var tracefn = &noTrace;
  var flags = 1u32;
  if trace as usize != 0usize {
    var t = trace;
    tracefn = mem.readRaw[&fn(record: *u8, mode: u32)](&mut t as *(&fn(record: *u8, mode: u32)));
    flags = 3u32;
  }
  mem.writeRaw[TypeRecord](recordType(block), TypeRecord(size, 16usize, dropfn, tracefn, flags));
  mem.writeRaw[Erased](block as *Erased, Erased(block + recordHead, recordType(block)));
  *slot = block as usize;
  p.count = p.count + 1usize;
  u64.from(id)
}

// Where the record parked at id goes in its block, to write it there
pub fn parked(p: &mut Pending, id: u64) *u8 {
  (*(p.slots + usize.from(id)) as *u8) + recordHead
}

// The reply for id arrived: where its record is, the slot freed
pub fn unpark(p: &mut Pending, id: u64) *u8 {
  let slot = p.slots + usize.from(id);
  let block = *slot as *u8;
  *slot = p.free * 2usize + 1usize;
  p.free = usize.from(id) + 1usize;
  p.count = p.count - 1usize;
  block + recordHead
}

// A record's block, once its values are moved out: 'record' is where unpark
// said it was
pub fn recordFree(record: *u8) {
  giveBlock(((record as usize) - recordHead) as *u8);
}

// RECORD BLOCKS KEPT. Parking a continuation takes a block for its record, and
// the reply that resumes it gives the block back: a loop of awaits would
// allocate and free one block of the same size each time round. Each thread
// keeps the last few blocks given back (at most blockKeep of at most
// blockKeepBytes each, matched by exact size) and the next park of that size takes
// one of them instead of asking the allocator. A block is the C library's, so
// one given back on a thread other than the one that took it is kept by the
// thread that gives it, and a block the pending table drops with its actor is
// freed as before. A keep is the thread's own, in a thread-local, so it goes
// when the thread does: a worker frees its kept blocks and its keep as it
// ends (keepRelease), and so does the thread that stops the runtime
// (stopWorkers). Any other thread that parks a continuation and ends with
// blocks in its keep leaves them: there is no hook at a thread's end to free
// them. parkBlocks() counts the blocks and keeps taken and given back.
const blockKeep = 8usize;
const blockKeepBytes = 1024usize;

let blocksTaken: Atomic[u64];     // record blocks taken from the allocator
let blocksGiven: Atomic[u64];     // record blocks given back to the allocator
let keepsMade: Atomic[u64];       // per-thread keeps made
let keepsFreed: Atomic[u64];      // per-thread keeps freed

struct BlockKeep {
  pub n: usize;
  pub blocks: Array[*u8, 8];
  pub sizes: Array[usize, 8];
}

var @threadlocal blockKept: usize = 0usize;

fn keepOf() *BlockKeep {
  var k = blockKept as *BlockKeep;
  if k as usize == 0usize {
    k = libc.calloc(1usize, mem.sizeof[BlockKeep]()) as *BlockKeep;
    if k as usize == 0usize {
      die("actors: out of memory for a continuation");
    }
    blockKept = k as usize;
    keepsMade.addOrdered(1u64, MemOrder.Relaxed);
  }
  k
}

// This thread's keep given back: the blocks it holds, then the keep itself.
// The next park on this thread makes a new one
fn keepRelease() {
  let k = blockKept as *BlockKeep;
  if k as usize == 0usize {
    return;
  }
  var i = 0usize;
  while i < (*k).n {
    libc.free((*k).blocks[i]);
    blocksGiven.addOrdered(1u64, MemOrder.Relaxed);
    i = i + 1usize;
  }
  libc.free(k as *u8);
  blockKept = 0usize;
  keepsFreed.addOrdered(1u64, MemOrder.Relaxed);
}

// A block of 'total' bytes: a kept one of that size, else the allocator's
fn takeBlock(total: usize) *u8 {
  if total <= blockKeepBytes {
    let k = keepOf();
    var i = (*k).n;
    while i > 0usize {
      i = i - 1usize;
      if (*k).sizes[i] == total {
        let b = (*k).blocks[i];
        let last = (*k).n - 1usize;
        (*k).blocks[i] = (*k).blocks[last];
        (*k).sizes[i] = (*k).sizes[last];
        (*k).n = last;
        return b;
      }
    }
  }
  blocksTaken.addOrdered(1u64, MemOrder.Relaxed);
  libc.malloc(total)
}

// A record's block given back (its values moved out): kept if there is room
fn giveBlock(block: *u8) {
  let total = recordHead + (*recordType(block)).size;
  if total <= blockKeepBytes {
    let k = keepOf();
    if (*k).n < blockKeep {
      (*k).blocks[(*k).n] = block;
      (*k).sizes[(*k).n] = total;
      (*k).n = (*k).n + 1usize;
      return;
    }
  }
  blocksGiven.addOrdered(1u64, MemOrder.Relaxed);
  libc.free(block);
}

// What the record blocks have cost the allocator: blocks it was asked for, and
// blocks it was given back (by an actor's death, or a full keep), and the
// per-thread keeps made and freed. For tests and for finding leaks, as
// liveFutures is for futures. After finalAll() each pair is equal: every
// block and every keep has been given back (a block still in a keep when it
// is freed is given back then)
pub struct ParkBlocks {
  pub taken: u64;
  pub given: u64;
  pub keepsMade: u64;
  pub keepsFreed: u64;
}

pub fn parkBlocks() ParkBlocks {
  ParkBlocks(blocksTaken.loadOrdered(MemOrder.Acquire), blocksGiven.loadOrdered(MemOrder.Acquire),
    keepsMade.loadOrdered(MemOrder.Acquire), keepsFreed.loadOrdered(MemOrder.Acquire))
}

// What an 'await' in a behaviour may wait for besides another actor's reply:
// an operation started at the seam, an I/O operation above all (the aio
// package), whose one answer is an R. Its maker erases its type: the operation
// is a closure the maker wrote, an owner of a 'fn(rp: Reply)' holding what the
// operation needs. The seam calls it, once, with the envelope of the reply the
// answer goes back in, written as answerNow writes a behaviour's value; and an
// Awaitable that dies unawaited finalizes the closure and what it holds, which
// is how the maker learns that nothing will start it. A closure that has handed
// what it holds on when it is called leaves nothing for that finalizing to do.
// The compiler generates the seam's call (startAwait). R is in no field: it is
// the type the 'await' gives, which the closure promises to write
pub struct Awaitable[R] is Move {
  start: Option[Uni[fn(rp: Reply)]];
  ctx: *u8;
  run: &fn(ctx: *u8, rp: Reply);
  drop: &fn(ctx: *u8);

  // An operation from the closure that starts it (a closure literal, or any
  // callable of that signature). The closure is a block of its own
  pub fn make[F: fn(rp: Reply)](start: F) Awaitable[R] {
    Awaitable[R](Some[Uni[fn(rp: Reply)]](Uni[fn(rp: Reply)](start)), null, &noRun, &noDrop)
  }

  // An operation that allocates nothing to be an Awaitable: a context word and
  // two plain functions. 'run(ctx, rp)' starts it, once, as the closure of
  // 'make' would be called; 'drop(ctx)' is called instead if the Awaitable dies
  // unawaited, so that whatever the context names is let go. A null 'ctx' is
  // not accepted (it would say the operation had been started)
  pub fn of(ctx: *u8, run: &fn(ctx: *u8, rp: Reply), drop: &fn(ctx: *u8)) Awaitable[R] {
    if ctx as usize == 0usize {
      die("actors: Awaitable.of given a null context");
    }
    Awaitable[R](None, ctx, run, drop)
  }

  // Dying unawaited: the context's owner is told (the closure form lets go of
  // its closure by its own finalizer, the field above)
  fn final(self: &uni) {
    if ctx as usize != 0usize {
      let f = drop;
      f(ctx);
    }
  }
}

fn noRun(ctx: *u8, rp: Reply) {}
fn noDrop(ctx: *u8) {}

// The seam starts what it awaits: 'a' is where the Awaitable lies, moved there
// by the generated code, which finalizes nothing of it, so the operation is moved
// out here, called, and finalized when the call has returned. Every
// Awaitable[R] is laid out alike, whatever its R
pub fn startAwait(a: *u8, rp: Reply) {
  var aw = mem.readRaw[Awaitable[u8]](a as *Awaitable[u8]);
  var r = rp;
  r.meta = r.meta | replyOp;
  opsStarted.addOrdered(1u64, MemOrder.SeqCst);
  if aw.ctx as usize != 0usize {
    // The context-word form: handed on to 'run', so that dying does not drop it
    let c = aw.ctx;
    let f = aw.run;
    aw.ctx = null;
    f(c, r);
    return;
  }
  match &mut aw.start {
    case var &mut Some(f) {(*f)(r);}
    else {}
  }
}

// ---------------------------------------------------------------------------
// The scheduler
// ---------------------------------------------------------------------------

// Each worker's run queue: a ring of this many actors
const queueCap = 1024u64;
const queueMask = 1023u64;

// How often a worker looks in the inject queue before its own: every 61st
// turn, tokio's number, so actors there are not starved by a busy local queue
const injectEvery = 61u32;

// THE SPIN's bound, in microseconds (the header, IDLE WORKERS): about what a
// park and its wake cost when the sleeper's core is still awake, so that
// spinning it and then parking costs at most about twice the better choice
const spinMicros = 8u64;

// THE SPIN's cap: at most this many workers spin at once, and never more than
// half of them; one, with a single worker
const spinMost = 4u32;

// A worker index for a thread that is not a worker
pub const noWorker = 0xFFFFFFFFu32;

pub const defaultBatch = 100u32;

// One worker: an OS thread with its run queue
struct Worker {
  pub before: Array[u8, 64];
  pub head: u64;                // stealers' and owner's: the next position to take
  pub gap: Array[u8, 56];
  pub tail: u64;                // owner's: the next position to fill
  pub started: u64;             // activations this worker began (SeqCst stores)
  pub ended: u64;               // activations this worker ended (SeqCst stores)
  pub gap2: Array[u8, 40];
  pub sched: *Sched;
  pub index: u32;
  pub tick: u32;
  pub rng: u32;
  pub cause: u64;               // the cause id of the message this worker is running, 0 between messages (tracing hooks)
  pub seq: u64;                 // the send ids this worker has made (tracing hooks)
  pub stat: *StatSlot;          // this worker's counts for stats(), in the block that outlives the stop (STATS, below), not in this struct, which the stop frees
  pub gap3: Array[u8, 64];
  pub ring: Array[*Header, 1024];
  pub gap4: Array[u8, 64];
  pub tasks: TaskDeque;         // the loop pieces this worker has split off (parallel.cone)
  pub gap5: Array[u8, 64];
  pub park: Atomic[u32];        // THE PARK WORD: parkRunning, parkParked or parkNotified, on a line of its own
  pub gap6: Array[u8, 60];
}

// A worker's park word (THE PARK WORD, in the header)
const parkRunning = 0u32;
const parkParked = 1u32;
const parkNotified = 2u32;

// The runtime: its workers, the inject queue, and how workers sleep
struct Sched {
  pub before: Array[u8, 64];
  pub sleepers: Atomic[u32];    // workers in the idle path, asleep or about to be
  pub searching: Atomic[u32];   // 1 while a woken worker looks for work
  pub quiet: Atomic[u32];       // the futex word the stop sleeps on
  pub done: Atomic[u32];        // 1 once the stop has begun
  pub stopping: Atomic[u32];    // 1 once the workers are to stop
  pub spinning: Atomic[u32];    // workers in THE SPIN now, at most spinCap
  pub gap: Array[u8, 40];
  pub lock: sync.Mutex;         // guards the inject queue's list
  pub injectHead: *Header;
  pub injectTail: *Header;
  pub injectLen: u64;           // how many are in it (atomic)
  pub extStarted: u64;          // activations begun off the workers (atomic)
  pub gap2: Array[u8, 32];
  pub nworkers: u32;
  pub batch: u32;
  pub spinCap: u32;             // how many workers may spin at once (spinMost)
  pub parkHold: u32;            // the test hook holdNextPark's state (atomic): 0 off; beside spinCap, which spin reads, so the park's look at it finds the line already read
  pub spinTicks: u64;           // THE SPIN's bound in the clock's ticks (spinMicros)
  pub parkHoldAt: u32;          // where the test hook holds: 1 before the worker publishes itself, 4 before its look, 2 before its wait, 3 before it leaves having seen work
  pub parkHeldIdx: u32;         // the index of the worker the test hook holds
  pub parkedWords: u32;         // how many words the sleepers' bitmap has, 64 workers each
  pub parked: usize;            // the sleepers' bitmap (THE PARK WORD): word i at parked + 64 i, a cache line each (atomic)
  pub workers: *Worker;
  pub threads: *thread.Thread[u32];
  pub extTasks: TaskDeque;      // the pieces of a loop begun off the workers (parallel.cone)
  pub stealRot: u32;            // where the next steal of a piece starts looking (atomic)
  pub liveScheduled: u64;       // loops begun with parallelRangeThen not yet finished (atomic)
}

// The running runtime, or 0: before the first actor, and once stopped. Every
// send and reply reads it on whichever thread it runs, while the first actor
// writes it (startWorkers) and the stop does (stopWorkers): an atomic held by an
// 'let' global, set to 0 in the module's 'init' (below)
let running: Atomic[usize];

// The worker this thread is, or 0
var @threadlocal me: usize = 0usize;

fn workerAt(s: *Sched, i: u32) *Worker {
  (*s).workers + usize.from(i)
}

fn ringAt(w: *Worker, pos: u64) **Header {
  (&(*w).ring as **Header) + usize.from(pos & queueMask)
}

fn ld32(p: *u32) u32 {mem.atomicLoad[u32](p, MemOrder.SeqCst)}
fn ld64(p: *u64) u64 {mem.atomicLoad[u64](p, MemOrder.SeqCst)}

// Add one to a count only its worker writes, which stats() reads meanwhile
fn tally(p: *u64, n: u64) {
  mem.atomicStore[u64](p, mem.atomicLoad[u64](p, MemOrder.Relaxed) + n, MemOrder.Relaxed);
}

// An actor has become runnable, its mailbox having left idle: count the
// activation begun, and queue it: on this worker's own queue when a worker
// sends, else on the inject queue
fn schedule(h: *Header) {
  let s = running.load() as *Sched;
  // Every caller has checked that the runtime runs (a send, a reply) or
  // started it (a new actor), so s is 0 here only if the stop finished
  // meanwhile on another thread: a thread that kept sending or making actors
  // while the program ended, which the finalizer's notes say must be joined
  // first. The same panic as the send's own check, not a null Sched.
  if s as usize == 0usize {
    die("actors: an actor made runnable after the runtime stopped");
  }
  let w = me as *Worker;
  if w as usize != 0usize && (*w).sched as usize == s as usize {
    let startedp = &(*w).started as *u64;
    mem.atomicStore[u64](startedp, mem.atomicLoad[u64](startedp, MemOrder.Relaxed) + 1u64, MemOrder.SeqCst);
    localPush(w, h);
  } else {
    mem.atomicAdd[u64](&(*s).extStarted as *u64, 1u64, MemOrder.SeqCst);
    (*h).link = nullHeader();
    injectPush(s, h, h, 1u64);
  }
}

// Put h on w's own queue; half of it goes to the inject queue when it is
// full. Wake a sleeping worker to steal when the queue held another already.
fn localPush(w: *Worker, h: *Header) {
  let headp = &(*w).head as *u64;
  let tailp = &(*w).tail as *u64;
  while true {
    let t = mem.atomicLoad[u64](tailp, MemOrder.Relaxed);
    let hd = mem.atomicLoad[u64](headp, MemOrder.Acquire);
    if t - hd < queueCap {
      mem.atomicStore[*Header](ringAt(w, t), h, MemOrder.Relaxed);
      mem.atomicStore[u64](tailp, t + 1u64, MemOrder.Release);
      if t != hd {
        notify((*w).sched);
      }
      return;
    }
    if overflow(w, h, hd, t) {
      return;
    }
  }
}

// w's queue is full: move half of it, and h, to the inject queue. False when
// a stealer took from it meanwhile, and there is room again.
fn overflow(w: *Worker, h: *Header, hd: u64, t: u64) bool {
  let n = (t - hd) / 2u64;
  // Claim them first, as a stealer would; then they are this thread's alone,
  // and only this thread, their queue's owner, writes their slots
  var seen = 0u64;
  var taken = false;
  seen, taken = mem.atomicCompareSwap[u64](&(*w).head as *u64, hd, hd + n,
    MemOrder.AcqRel, MemOrder.Relaxed);
  if !taken {
    return false;
  }
  let first = mem.atomicLoad[*Header](ringAt(w, hd), MemOrder.Relaxed);
  var last = first;
  var i = 1u64;
  while i < n {
    let next = mem.atomicLoad[*Header](ringAt(w, hd + i), MemOrder.Relaxed);
    (*last).link = next;
    last = next;
    i = i + 1u64;
  }
  (*last).link = h;
  (*h).link = nullHeader();
  injectPush((*w).sched, first, h, n + 1u64);
  true
}

// Take the actor at the front of w's queue, by its owner or a stealer, or 0
fn queuePop(w: *Worker) *Header {
  let headp = &(*w).head as *u64;
  let tailp = &(*w).tail as *u64;
  while true {
    let hd = mem.atomicLoad[u64](headp, MemOrder.Acquire);
    let t = mem.atomicLoad[u64](tailp, MemOrder.Acquire);
    if hd >= t {
      return nullHeader();
    }
    let h = mem.atomicLoad[*Header](ringAt(w, hd), MemOrder.Relaxed);
    var seen = 0u64;
    var taken = false;
    seen, taken = mem.atomicCompareSwap[u64](headp, hd, hd + 1u64,
      MemOrder.AcqRel, MemOrder.Relaxed);
    if taken {
      return h;
    }
  }
  nullHeader()
}

// Steal half of v's queue into w's own, which is empty: one of them to run,
// or 0
fn stealFrom(w: *Worker, v: *Worker) *Header {
  let headp = &(*v).head as *u64;
  let tailp = &(*v).tail as *u64;
  let ot = mem.atomicLoad[u64](&(*w).tail as *u64, MemOrder.Relaxed);
  while true {
    let hd = mem.atomicLoad[u64](headp, MemOrder.Acquire);
    let t = mem.atomicLoad[u64](tailp, MemOrder.Acquire);
    if hd >= t {
      return nullHeader();
    }
    let n = t - hd;
    let k = n - n / 2u64;
    var i = 0u64;
    while i < k {
      let h = mem.atomicLoad[*Header](ringAt(v, hd + i), MemOrder.Relaxed);
      mem.atomicStore[*Header](ringAt(w, ot + i), h, MemOrder.Relaxed);
      i = i + 1u64;
    }
    var seen = 0u64;
    var taken = false;
    seen, taken = mem.atomicCompareSwap[u64](headp, hd, hd + k,
      MemOrder.AcqRel, MemOrder.Relaxed);
    if taken {
      let run = mem.atomicLoad[*Header](ringAt(w, ot + k - 1u64), MemOrder.Relaxed);
      if k > 1u64 {
        mem.atomicStore[u64](&(*w).tail as *u64, ot + k - 1u64, MemOrder.Release);
      }
      tally(&(*(*w).stat).steals as *u64, 1u64);
      return run;
    }
  }
  nullHeader()
}

// Put the list first..last, count actors linked through their headers, on
// the inject queue, and wake a sleeping worker
fn injectPush(s: *Sched, first: *Header, last: *Header, count: u64) {
  (*s).lock.lock();
  if (*s).injectTail as usize == 0usize {
    (*s).injectHead = first;
  } else {
    (*(*s).injectTail).link = first;
  }
  (*s).injectTail = last;
  (*s).lock.unlock();
  mem.atomicAdd[u64](&(*s).injectLen as *u64, count, MemOrder.SeqCst);
  notify(s);
}

// Take an actor from the inject queue, and move a few more onto w's own
// queue: the one to run, or 0
fn injectPop(s: *Sched, w: *Worker) *Header {
  let lenp = &(*s).injectLen as *u64;
  if mem.atomicLoad[u64](lenp, MemOrder.SeqCst) == 0u64 {
    return nullHeader();
  }
  (*s).lock.lock();
  let first = (*s).injectHead;
  if first as usize == 0usize {
    (*s).lock.unlock();
    return nullHeader();
  }
  // Take the first, and up to a share of the rest for this worker's queue
  let len = mem.atomicLoad[u64](lenp, MemOrder.Relaxed);
  var extra = len / u64.from((*s).nworkers);
  if extra > 32u64 {
    extra = 32u64;
  }
  var last = first;
  var k = 1u64;
  while k <= extra && (*last).link as usize != 0usize {
    last = (*last).link;
    k = k + 1u64;
  }
  (*s).injectHead = (*last).link;
  if (*s).injectHead as usize == 0usize {
    (*s).injectTail = nullHeader();
  }
  (*last).link = nullHeader();
  mem.atomicSub[u64](lenp, k, MemOrder.SeqCst);
  (*s).lock.unlock();
  // The rest to this worker's own queue
  var next = (*first).link;
  while next as usize != 0usize {
    let after = (*next).link;
    (*next).link = nullHeader();
    localPush(w, next);
    next = after;
  }
  (*first).link = nullHeader();
  first
}

// Wake one sleeping worker to look for work, unless one is looking already:
// a worker spinning (THE SPIN), or one woken earlier and not yet done looking
fn notify(s: *Sched) {
  if ld32(&(*s).sleepers as *u32) == 0u32 {
    return;
  }
  if ld32(&(*s).spinning as *u32) != 0u32 {
    return;
  }
  if mem.atomicSwap[u32](&(*s).searching as *u32, 1u32, MemOrder.SeqCst) != 0u32 {
    return;
  }
  // Choose a sleeper, mark it, then wake it (THE PARK WORD). None to be
  // had leaves 'searching' set: every worker counted a sleeper is then chosen
  // already or on its way out, and looks
  var k = 0u32;
  while k < (*s).parkedWords {
    let wp = parkedWord(s, k);
    var v = mem.atomicLoad[u64](wp, MemOrder.SeqCst);
    while v != 0u64 {
      let b = mem.trailingZeros[u64](v);
      let bit = 1u64 << u64.from(b);
      v = v & ~bit;
      // Claim the bit; one another notify cleared first is passed over
      if (mem.atomicAnd[u64](wp, ~bit, MemOrder.SeqCst) & bit) != 0u64 {
        let i = k * 64u32 + b;
        let w = workerAt(s, i);
        var seen = 0u32;
        var marked = false;
        seen, marked = mem.atomicCompareSwap[u32](&(*w).park as *u32, parkParked, parkNotified,
          MemOrder.SeqCst, MemOrder.SeqCst);
        if marked {
          sync.futexWake(&(*w).park);
          return;
        }
      }
    }
    k = k + 1u32;
  }
}

// Word k of the sleepers' bitmap
fn parkedWord(s: *Sched, k: u32) *u64 {
  ((*s).parked + usize.from(k) * 64usize) as *u64
}

// Worker w's bit in its word of the bitmap
fn parkedBit(w: *Worker) u64 {
  1u64 << u64.from((*w).index % 64u32)
}

// A worker found work away from its own queue: it is no longer the one
// looking, and if more work is waiting, another is woken to look
fn foundAway(w: *Worker) {
  let s = (*w).sched;
  mem.atomicStore[u32](&(*s).searching as *u32, 0u32, MemOrder.SeqCst);
  if ld64(&(*s).injectLen as *u64) != 0u64 || ld64(&(*w).tail as *u64) != ld64(&(*w).head as *u64)
      || taskWork(s) {
    notify(s);
  }
}

// The next actor for w to run from its own queue or the inject queue, or 0
fn findWork(w: *Worker) *Header {
  let s = (*w).sched;
  (*w).tick = (*w).tick + 1u32;
  if (*w).tick % injectEvery == 0u32 {
    let a = injectPop(s, w);
    if a as usize != 0usize {
      // Taken away from its own queue, as any inject take: more waiting
      // there wakes another (the header, NO WAKE IS LOST)
      foundAway(w);
      return a;
    }
  }
  let mine = queuePop(w);
  if mine as usize != 0usize {
    return mine;
  }
  let fromInject = injectPop(s, w);
  if fromInject as usize != 0usize {
    foundAway(w);
    return fromInject;
  }
  nullHeader()
}

// Steal an actor, once the worker's own queue, the inject queue and every
// loop piece (stealTask) have come up empty: half of another worker's queue,
// starting at one chosen at random. The actor to run, or 0.
fn stealActor(w: *Worker) *Header {
  let s = (*w).sched;
  let n = (*s).nworkers;
  var r = (*w).rng;
  r = r ^ (r << 13u32);
  r = r ^ (r >> 17u32);
  r = r ^ (r << 5u32);
  (*w).rng = r;
  var i = 0u32;
  while i < n {
    let v = workerAt(s, (r % n + i) % n);
    if v as usize != w as usize {
      let got = stealFrom(w, v);
      if got as usize != 0usize {
        foundAway(w);
        return got;
      }
    }
    i = i + 1u32;
  }
  nullHeader()
}

// Whether any queue holds an actor or a loop piece, looked at without taking one
fn anyWork(s: *Sched) bool {
  if ld64(&(*s).injectLen as *u64) != 0u64 || taskWork(s) {
    return true;
  }
  var i = 0u32;
  while i < (*s).nworkers {
    let v = workerAt(s, i);
    if ld64(&(*v).tail as *u64) != ld64(&(*v).head as *u64) {
      return true;
    }
    i = i + 1u32;
  }
  false
}

// Run actor h's batch, then queue it again, or mark it idle and let go of
// the hold taken when it became runnable
fn runActor(w: *Worker, h: *Header) {
  let s = (*w).sched;
  let run = (*h).run;
  let n = run(h, (*s).batch);
  let stat = (*w).stat;
  tally(&(*stat).messages as *u64, u64.from(n));
  tally(&(*stat).activations as *u64, 1u64);
  // The last behaviour began a 'parallel each' and has returned: the actor is
  // neither queued again nor marked idle, but waits for its loop, its mailbox
  // taking messages meanwhile; the loop begins now, on this worker
  if (*h).par as usize != 0usize {
    startHeld(w, h);
    return;
  }
  if n < (*s).batch && mailMarkIdle(h) {
    let release = (*h).release;
    release(h);
    let endedp = &(*w).ended as *u64;
    mem.atomicStore[u64](endedp, mem.atomicLoad[u64](endedp, MemOrder.Relaxed) + 1u64, MemOrder.SeqCst);
    return;
  }
  localPush(w, h);
}

// THE SPIN (the header, IDLE WORKERS): become one of at most spinCap spinners
// and look for work until spinTicks of the clock have passed. True as soon as
// work is seen; false when the bound passes, or at once when spinCap workers
// are spinning already. It only reads the queues: whatever it misses, the
// park that follows sees (idle).
fn spin(w: *Worker) bool {
  let s = (*w).sched;
  let np = &(*s).spinning as *u32;
  var n = mem.atomicLoad[u32](np, MemOrder.Relaxed);
  var joined = false;
  while !joined {
    if n >= (*s).spinCap {
      return false;
    }
    n, joined = mem.atomicCompareSwap[u32](np, n, n + 1u32, MemOrder.AcqRel, MemOrder.Relaxed);
  }
  let stat = (*w).stat;
  tally(&(*stat).spins as *u64, 1u64);
  let start = clockTicks();
  var found = false;
  while !found {
    if anyWork(s) {
      found = true;
    } else if clockTicks() - start >= (*s).spinTicks {
      break;
    }
  }
  // Sequentially consistent: the pairing with notify's read of 'spinning'
  // (the header, NO WAKE IS LOST) needs this before idle's next look
  mem.atomicSub[u32](np, 1u32, MemOrder.SeqCst);
  if found {
    tally(&(*stat).spinsFound as *u64, 1u64);
  } else {
    tally(&(*stat).spinsOut as *u64, 1u64);
  }
  found
}

// ---- A TEST HOOK: a worker held on its way to park ----
//
// The next worker to leave THE SPIN for the park stops at one of three places
// ('at'). 1, holdNextPark: after the spin's last look and before it publishes
// itself a sleeper, the one place where a push finds no sleeper and no
// spinner to wake, so that only the park's own look after publishing takes it
// (tests/parklook.cone). 2: after it has published itself and looked and
// seen nothing, before its wait, where a notify that chooses it marks it
// before it sleeps, so that only the mark, read by the wait, takes it. 3:
// after it has published itself and its look has seen work, before it leaves
// (leavePark), where a notify can claim it and mark it while it is leaving.
// 4: after it has published itself, before its look, where a notify that
// claims it marks a worker whose look then sees work, so that it leaves
// marked (2: tests/parkwake.cone; 4: tests/parkleave.cone). The Sched's
// 'parkHold': 0 off; 1 armed; 2 a
// worker held (its index in 'parkHeldIdx'); 3 released; 'parkHoldAt' says
// where. releaseParkTo releases the held worker and arms the hook again in one
// step, so that the same worker stops at the next place. Off, it costs a park
// up to three relaxed loads of a line spin has just read; it is not on any
// send's path.

// Arm the hook: the next worker going to park stops at 'at' (1 to 4,
// above). A panic if the workers are not running
pub fn holdNextPark(at: u32 = 1u32) {
  let s = running.load() as *Sched;
  if s as usize == 0usize {
    die("actors: holdNextPark called with no runtime running");
  }
  mem.atomicStore[u32](&(*s).parkHoldAt as *u32, at, MemOrder.SeqCst);
  mem.atomicStore[u32](&(*s).parkHold as *u32, 1u32, MemOrder.SeqCst);
}

// Whether a worker is held on its way to park
pub fn parkHeld() bool {
  let s = running.load() as *Sched;
  s as usize != 0usize && mem.atomicLoad[u32](&(*s).parkHold as *u32, MemOrder.SeqCst) == 2u32
}

// The index of the worker held
pub fn parkHeldWorker() u32 {
  let s = running.load() as *Sched;
  if s as usize == 0usize {noWorker} else {mem.atomicLoad[u32](&(*s).parkHeldIdx as *u32, MemOrder.SeqCst)}
}

// Let the held worker go on, the hook armed again for 'at': the same worker
// stops there next, if its way passes it
pub fn releaseParkTo(at: u32) {
  let s = running.load() as *Sched;
  if s as usize == 0usize {
    return;
  }
  mem.atomicStore[u32](&(*s).parkHoldAt as *u32, at, MemOrder.SeqCst);
  mem.atomicStore[u32](&(*s).parkHold as *u32, 1u32, MemOrder.SeqCst);
}

// Let the held worker go on to park, and wait until it has gone on (the hook
// is off again, ready to be armed)
pub fn releasePark() {
  let s = running.load() as *Sched;
  if s as usize == 0usize {
    return;
  }
  let hp = &(*s).parkHold as *u32;
  mem.atomicStore[u32](hp, 3u32, MemOrder.SeqCst);
  while mem.atomicLoad[u32](hp, MemOrder.SeqCst) != 0u32 {
    yieldProcessor();
  }
}

// A TEST HOOK too: wake every worker's park word without marking it, as a
// return from the wait that nobody chose is (THE PARK WORD): an asleep
// worker finds its word still PARKED and sleeps again at once
// (tests/parkwake.cone)
pub fn pokeParked() {
  let s = running.load() as *Sched;
  if s as usize == 0usize {
    return;
  }
  var i = 0u32;
  while i < (*s).nworkers {
    sync.futexWake(&(*workerAt(s, i)).park);
    i = i + 1u32;
  }
}

fn parkHoldHere(s: *Sched, w: *Worker, at: u32) {
  if mem.atomicLoad[u32](&(*s).parkHoldAt as *u32, MemOrder.SeqCst) != at {
    return;
  }
  let hp = &(*s).parkHold as *u32;
  mem.atomicStore[u32](&(*s).parkHeldIdx as *u32, (*w).index, MemOrder.SeqCst);
  var seen = 0u32;
  var armed = false;
  seen, armed = mem.atomicCompareSwap[u32](hp, 1u32, 2u32, MemOrder.SeqCst, MemOrder.Relaxed);
  if !armed {
    return;
  }
  var st = 2u32;
  while st == 2u32 {
    yieldProcessor();
    st = mem.atomicLoad[u32](hp, MemOrder.SeqCst);
  }
  // Released (3): off again. Re-armed (1, releaseParkTo): left armed
  if st == 3u32 {
    mem.atomicStore[u32](hp, 0u32, MemOrder.SeqCst);
  }
}

// No work was found: spin a little (spin), then sleep until woken. False once
// the runtime is stopping.
fn idle(w: *Worker) bool {
  let s = (*w).sched;
  if spin(w) {
    return true;
  }
  if mem.atomicLoad[u32](&(*s).parkHold as *u32, MemOrder.Relaxed) != 0u32 {
    parkHoldHere(s, w, 1u32);
  }
  // Publish: the park word, the bit, the count (THE PARK WORD)
  let pk = &(*w).park as *u32;
  let wp = parkedWord(s, (*w).index / 64u32);
  let bit = parkedBit(w);
  mem.atomicStore[u32](pk, parkParked, MemOrder.SeqCst);
  mem.atomicOr[u64](wp, bit, MemOrder.SeqCst);
  let asleep = mem.atomicAdd[u32](&(*s).sleepers as *u32, 1u32, MemOrder.SeqCst) + 1u32;
  assertDebugMsg(asleep <= (*s).nworkers, "actors: more sleepers counted than workers");
  mem.atomicStore[u32](&(*s).searching as *u32, 0u32, MemOrder.SeqCst);
  if mem.atomicLoad[u32](&(*s).parkHold as *u32, MemOrder.Relaxed) != 0u32 {
    parkHoldHere(s, w, 4u32);
  }
  if anyWork(s) {
    if mem.atomicLoad[u32](&(*s).parkHold as *u32, MemOrder.Relaxed) != 0u32 {
      parkHoldHere(s, w, 3u32);
    }
    leavePark(s, w);
    return true;
  }
  if ld32(&(*s).stopping as *u32) != 0u32 {
    leavePark(s, w);
    return false;
  }
  if asleep == (*s).nworkers && ld32(&(*s).done as *u32) != 0u32 {
    mem.atomicAdd[u32](&(*s).quiet as *u32, 1u32, MemOrder.SeqCst);
    sync.futexWake(&(*s).quiet);
  }
  if mem.atomicLoad[u32](&(*s).parkHold as *u32, MemOrder.Relaxed) != 0u32 {
    parkHoldHere(s, w, 2u32);
  }
  tally(&(*(*w).stat).parks as *u64, 1u64);
  while true {
    sync.futexWait(&(*w).park, parkParked);
    if mem.atomicLoad[u32](pk, MemOrder.SeqCst) != parkParked {
      break;
    }
    // Back with the word still PARKED: nobody chose this worker. Sleep
    // again at once, still published (THE PARK WORD)
    tally(&(*(*w).stat).reparks as *u64, 1u64);
  }
  // Chosen (NOTIFIED): the notify cleared the bit
  mem.atomicStore[u32](pk, parkRunning, MemOrder.SeqCst);
  uncount(s);
  ld32(&(*s).stopping as *u32) == 0u32
}

// A published worker leaves the park without sleeping: its bit cleared, its
// word RUNNING, its count gone. A notify that claimed it meanwhile and marked
// it NOTIFIED (THE PARK WORD, the claimed-but-leaving case) woke nobody new:
// the mark is this worker's to spend, and it is awake already
fn leavePark(s: *Sched, w: *Worker) {
  let pk = &(*w).park as *u32;
  mem.atomicAnd[u64](parkedWord(s, (*w).index / 64u32), ~parkedBit(w), MemOrder.SeqCst);
  var seen = 0u32;
  var out = false;
  seen, out = mem.atomicCompareSwap[u32](pk, parkParked, parkRunning, MemOrder.SeqCst, MemOrder.SeqCst);
  if !out {
    tally(&(*(*w).stat).marksSpent as *u64, 1u64);
    mem.atomicStore[u32](pk, parkRunning, MemOrder.SeqCst);
  }
  uncount(s);
}

// The one decrement of the sleepers' count in a park, made by the worker
// itself as it leaves (never by a notify): the count never goes below 0
fn uncount(s: *Sched) {
  let before = mem.atomicSub[u32](&(*s).sleepers as *u32, 1u32, MemOrder.SeqCst);
  assertDebugMsg(before != 0u32, "actors: the sleepers' count went below 0");
}

// What a worker thread is handed
struct WorkerArg is Sendable {
  pub w: *Worker;
}

fn workerMain(arg: WorkerArg) u32 {
  let w = arg.w;
  me = w as usize;
  let s = (*w).sched;
  while true {
    // The order (parallel.cone, WHERE TASKS WAIT): the loop pieces on top of this
    // worker's queue, then the pieces of a loop begun off the workers, then
    // its actors and the inject queue's, and only with all of those empty
    // another worker's pieces, and then another's actors
    var t = emptyTask();
    if dequePopNewest(tasksOf(w), &mut t as *Task) {
      runTask(s, t);
      continue;
    }
    if dequeTakeOldest(extDeque(s), &mut t as *Task) {
      foundAway(w);
      runTask(s, t);
      continue;
    }
    let h = findWork(w);
    if h as usize != 0usize {
      runActor(w, h);
      continue;
    }
    if stealTask(s, w, &mut t as *Task) {
      foundAway(w);
      runTask(s, t);
      continue;
    }
    let a = stealActor(w);
    if a as usize != 0usize {
      runActor(w, a);
      continue;
    }
    if !idle(w) {
      break;
    }
  }
  keepRelease();
  me = 0usize;
  0u32
}

// Whether no actor is active: every activation begun has ended. The ended
// counts are read first, then the begun: each count only grows, so if the
// sums agree they agreed at the moment between the two reads.
fn quiescent(s: *Sched) bool {
  var ended = 0u64;
  var i = 0u32;
  while i < (*s).nworkers {
    ended = ended + ld64(&(*workerAt(s, i)).ended as *u64);
    i = i + 1u32;
  }
  var started = ld64(&(*s).extStarted as *u64);
  i = 0u32;
  while i < (*s).nworkers {
    started = started + ld64(&(*workerAt(s, i)).started as *u64);
    i = i + 1u32;
  }
  started == ended && ld64(&(*s).liveScheduled as *u64) == 0u64
}

// ---------------------------------------------------------------------------
// Starting and stopping: the first actor starts the workers; the module's
// finalizer stops them
// ---------------------------------------------------------------------------

// How the workers are to run: how many (0, one per logical processor) and
// how many messages an actor may handle at a turn
pub struct Options {
  pub workers: u32 = 0u32;
  pub batch: u32 = defaultBatch;
}

// What the workers have done, counted by them: answered by 'stats'
pub struct Stats {
  pub workers: u32;
  pub messages: u64;            // messages handled
  pub activations: u64;         // turns: an actor taken from a queue and run
  pub steals: u64;              // times a worker took actors from another's queue
  pub taskSteals: u64;          // loop pieces taken by stealing: from another worker's deque, or from the shared deque (loops begun off the workers) when a worker with no actors to run, or a thread waiting on a loop, takes the oldest piece there (the caller's own loop's, if it began it off the workers); the shared deque's pieces a worker takes ahead of its actors are not counted
  pub spins: u64 = 0u64;        // times an idle worker began THE SPIN (the header, IDLE WORKERS)
  pub spinsFound: u64 = 0u64;   // spins that ended by seeing work
  pub spinsOut: u64 = 0u64;     // spins that ended at their bound, the worker going on to park; spins less these two are the workers spinning now
  pub parks: u64 = 0u64;        // times a worker slept on its park word (THE PARK WORD)
  pub reparks: u64 = 0u64;      // returns from that sleep with nobody having chosen the worker, which slept again at once
  pub marksSpent: u64 = 0u64;   // times a notify chose a worker already leaving the park with work seen: it woke nobody new
}

// What configure set, read when the workers start: atomics, since 'configure'
// may be called on any thread, held by 'let' globals and set in 'init' (below)
let chosenWorkers: Atomic[u32];
let chosenBatch: Atomic[u32];

// Starts the workers once, however many threads start a first actor at once
let startOnce: sync.Once;

// STATS. 'stats' may be called on any thread at any time, including while the
// stop frees the Sched and the Workers, so it reads nothing in them. What it
// answers lives in memory that outlives the runtime: one StatSlot a worker,
// in a single block the first start allocates and nothing frees (a few dozen
// bytes a worker, in a program that starts the workers once and ends), and
// the loop pieces stolen, which threads that are no worker count too, in one
// atomic. A worker counts into its own slot with Relaxed stores, as it did in
// its Worker, one tally a turn rather than a contended add a message;
// 'stats' sums the slots. After the stop the slots are the run's totals.
// Published slots first, then their number, both before the workers run; a
// 'stats' that finds no number answers all 0.
struct StatSlot {
  pub messages: u64;            // messages handled
  pub activations: u64;         // turns
  pub steals: u64;              // times a steal took actors from another worker's queue
  pub spins: u64;               // spins begun (THE SPIN)
  pub spinsFound: u64;          // spins ended by seeing work
  pub spinsOut: u64;            // spins ended by their bound
  pub parks: u64;               // sleeps on the park word
  pub reparks: u64;             // returns from the wait unchosen, slept again at once
  pub marksSpent: u64;          // parks left with work seen after a notify had marked the worker
  pub gap: Array[u8, 48];       // a slot is two cache lines, so that no two workers' slots share one
}

let statSlots: Atomic[usize];   // the address of the first slot, or 0 before the workers have started
let statWorkers: Atomic[u32];   // how many slots; 0 before the workers have started
let taskStealsTotal: Atomic[u64];   // pieces stealTask took (Relaxed): the oldest of another worker's deque, or of the shared one when a worker idle of actors or a thread waiting on a loop looks there; not what a worker takes from the shared deque ahead of its actors

fn @initpure init() {
  segAllocs = Atomic[u64].of(0u64);
  boxAllocs = Atomic[u64].of(0u64);
  waiterAllocs = Atomic[u64].of(0u64);
  segsLive = Atomic[usize].of(0usize);
  segBytesLive = Atomic[usize].of(0usize);
  stallState = Atomic[u32].of(0u32);
  opsStarted = Atomic[u64].of(0u64);
  opsEnded = Atomic[u64].of(0u64);
  startOnce = sync.Once.make();
  envOnce = sync.Once.make();
  floorBytes = Atomic[usize].of(defaultFloor);
  stressOn = Atomic[bool].of(false);
  running = Atomic[usize].of(0usize);
  chosenWorkers = Atomic[u32].of(0u32);
  chosenBatch = Atomic[u32].of(defaultBatch);
  statSlots = Atomic[usize].of(0usize);
  statWorkers = Atomic[u32].of(0u32);
  taskStealsTotal = Atomic[u64].of(0u64);
  traceMask = Atomic[u32].of(0u32);
  traceSink = Atomic[usize].of(0usize);
  traceIds = Atomic[u64].of(0u64);
  blocksTaken = Atomic[u64].of(0u64);
  blocksGiven = Atomic[u64].of(0u64);
  keepsMade = Atomic[u64].of(0u64);
  keepsFreed = Atomic[u64].of(0u64);
  traceActors = Atomic[u32].of(0u32);
  futuresLive = Atomic[usize].of(0usize);
  futuresMade = Atomic[u64].of(0u64);
}

// The program is ending: wait until all is quiet, then stop the workers, if
// any actor started them
fn final() {
  if running.load() != 0usize {
    stopWorkers();
  }
}

// How the workers are to run, set before the first actor starts them
pub fn configure(opts: Options) {
  if startOnce.isCompleted() {
    die("actors: configure called after the workers started");
  }
  chosenWorkers.store(opts.workers);
  chosenBatch.store(opts.batch);
}

// The workers are running, having been started now if they were not: a
// panic if they have stopped
fn ensureRunning() {
  startOnce.callOnce(&startWorkers);
  if running.load() == 0usize {
    die("actors: an actor started after the runtime stopped");
  }
}

// Start the workers as configure said, once
fn startWorkers() {
  let chosenN = chosenWorkers.load();
  let n = if chosenN == 0u32 {thread.parallelism()} else {chosenN};
  let s = libc.calloc(1usize, mem.sizeof[Sched]()) as *Sched;
  let ws = libc.calloc(usize.from(n), mem.sizeof[Worker]()) as *Worker;
  let ts = libc.malloc(usize.from(n) * mem.sizeof[thread.Thread[u32]]()) as *thread.Thread[u32];
  // The stats slots, zeroed, a cache line each (the block is 16-aligned, so
  // one more line is allocated and the first slot is rounded up to a line).
  // Never freed: stats() reads them after the stop has freed the rest.
  let slotBytes = mem.sizeof[StatSlot]();
  let block = libc.calloc(usize.from(n) + 1usize, slotBytes) as usize;
  if s as usize == 0usize || ws as usize == 0usize || ts as usize == 0usize || block == 0usize {
    die("actors: out of memory for the runtime");
  }
  let slots = (block + slotBytes - 1usize) / slotBytes * slotBytes;
  (*s).nworkers = n;
  let chosenB = chosenBatch.load();
  (*s).batch = if chosenB == 0u32 {1u32} else {chosenB};
  let half = n / 2u32;
  (*s).spinCap = if half == 0u32 {1u32} else if half > spinMost {spinMost} else {half};
  (*s).spinTicks = clockFrequency() * spinMicros / 1000000u64;
  // The sleepers' bitmap: a word for every 64 workers, a cache line each
  (*s).parkedWords = (n + 63u32) / 64u32;
  (*s).parked = libc.calloc(usize.from((*s).parkedWords), 64usize) as usize;
  if (*s).parked == 0usize {
    die("actors: out of memory for the runtime");
  }
  (*s).workers = ws;
  (*s).threads = ts;
  statSlots.store(slots);
  statWorkers.store(n);
  running.store(s as usize);
  var i = 0u32;
  while i < n {
    let w = workerAt(s, i);
    (*w).stat = (slots + usize.from(i) * slotBytes) as *StatSlot;
    (*w).sched = s;
    (*w).index = i;
    (*w).rng = (2463534242u32 ^ ((i + 1u32) * 7919u32)) | 1u32;
    mem.writeRaw[thread.Thread[u32]](ts + usize.from(i),
      thread.startWith(thread.Options(name: "actors worker"), WorkerArg(w), &workerMain));
    i = i + 1u32;
  }
}

// Wait until s is quiescent. 'done' says the stop has begun, so that the
// last worker to go to sleep wakes this thread to look again
fn quiesce(s: *Sched) {
  mem.atomicStore[u32](&(*s).done as *u32, 1u32, MemOrder.SeqCst);
  while true {
    let q = ld32(&(*s).quiet as *u32);
    if quiescent(s) {
      break;
    }
    sync.futexWait(&(*s).quiet, q);
  }
}

// Wait until no actor is queued or running, as the module's finalizer does
// before it stops the workers: for a package whose own finalizer runs before
// this one's and acts once all is quiet -- aio's, which then ends the I/O
// still awaited. Nothing if no actor started the workers; a panic on one of
// them, which would wait for itself
pub fn waitQuiet() {
  if running.load() == 0usize {
    return;
  }
  if me != 0usize {
    die("actors: waitQuiet called on one of the runtime's own workers, which would wait for itself");
  }
  quiesce(running.load() as *Sched);
}

// Awaited operations: how many have been started (by startAwait), and how
// many are spent (answered, or dropped without an answer). Each only grows;
// they are equal when none is outstanding. Not in the Sched, which the stop
// frees: a reply may be spent while it is freed
let opsStarted: Atomic[u64];
let opsEnded: Atomic[u64];

// An awaited operation's reply is spent, by its answer (after the answer's
// push, so that the actor it woke is already counted as scheduled) or by its
// drop: count it, and wake a thread waiting for idle to look again
fn opSpent() {
  opsEnded.addOrdered(1u64, MemOrder.SeqCst);
  let s = running.load() as *Sched;
  if s as usize != 0usize {
    mem.atomicAdd[u32](&(*s).quiet as *u32, 1u32, MemOrder.SeqCst);
    sync.futexWake(&(*s).quiet);
  }
}

// Whether nothing is going on: no operation outstanding and no actor active.
// The spent count is read before the started one, as quiescent reads its
// counts, so equal sums were equal at the moment between; and the started
// count is read again after quiescent, for an operation an active actor
// started and an answer then woke and ended, between the two looks
fn idleNow(s: *Sched) bool {
  let spent = opsEnded.loadOrdered(MemOrder.SeqCst);
  let started = opsStarted.loadOrdered(MemOrder.SeqCst);
  started == spent && quiescent(s) && opsStarted.loadOrdered(MemOrder.SeqCst) == started
}

// INTERIM (the package's header, WAITING FOR IDLE): wait until no actor is
// queued or running and no awaited operation is outstanding, then return,
// leaving the runtime running. It does not return while an actor awaits a
// timer or a socket, nor while an operation it started is unanswered, so a
// program that never goes idle (a listening server) never returns from it,
// and it has no timeout. Nothing if no actor ever started the workers; a
// panic on one of them, which would wait for itself. Messages sent from
// threads other than main while it waits may arrive after it returns
pub fn waitUntilIdle() {
  if running.load() == 0usize {
    return;
  }
  if me != 0usize {
    die("actors: waitUntilIdle called on one of the runtime's own workers, which would wait for itself");
  }
  let s = running.load() as *Sched;
  mem.atomicStore[u32](&(*s).done as *u32, 1u32, MemOrder.SeqCst);
  while true {
    let q = ld32(&(*s).quiet as *u32);
    if idleNow(s) {
      break;
    }
    sync.futexWait(&(*s).quiet, q);
  }
  mem.atomicStore[u32](&(*s).done as *u32, 0u32, MemOrder.SeqCst);
}

// Wait until quiescent, then stop and join the workers, keeping their totals
fn stopWorkers() {
  if me != 0usize {
    die("actors: the runtime stopped from one of its own workers, which would wait for itself");
  }
  let s = running.load() as *Sched;
  quiesce(s);
  mem.atomicStore[u32](&(*s).stopping as *u32, 1u32, MemOrder.SeqCst);
  // Mark every worker and wake its word (THE PARK WORD): a worker asleep
  // wakes chosen and sees 'stopping'; one not yet asleep finds its word not
  // PARKED, or reads 'stopping' before it sleeps
  var j = 0u32;
  while j < (*s).nworkers {
    let w = workerAt(s, j);
    mem.atomicStore[u32](&(*w).park as *u32, parkNotified, MemOrder.SeqCst);
    sync.futexWake(&(*w).park);
    j = j + 1u32;
  }
  var i = 0u32;
  while i < (*s).nworkers {
    let t = mem.readRaw[thread.Thread[u32]]((*s).threads + usize.from(i));
    t.join();
    i = i + 1u32;
  }
  keepRelease();
  running.store(0usize);
  libc.free((*s).parked as *u8);
  libc.free((*s).threads as *u8);
  libc.free((*s).workers as *u8);
  libc.free(s as *u8);
}

// What the workers have done so far, read without stopping them: all 0
// before the first actor, the run's totals once they have stopped. Only the
// stats slots are read, never the Sched or a Worker (STATS, above), so a call
// on any thread is safe while the stop frees them.
pub fn stats() Stats {
  let n = statWorkers.load();
  if n == 0u32 {
    return Stats(0u32, 0u64, 0u64, 0u64, 0u64);
  }
  let slots = statSlots.load();
  var st = Stats(n, 0u64, 0u64, 0u64, taskStealsTotal.loadOrdered(MemOrder.Relaxed));
  var i = 0u32;
  while i < n {
    let slot = (slots + usize.from(i) * mem.sizeof[StatSlot]()) as *StatSlot;
    st.messages = st.messages + mem.atomicLoad[u64](&(*slot).messages as *u64, MemOrder.Relaxed);
    st.activations = st.activations + mem.atomicLoad[u64](&(*slot).activations as *u64, MemOrder.Relaxed);
    st.steals = st.steals + mem.atomicLoad[u64](&(*slot).steals as *u64, MemOrder.Relaxed);
    st.spins = st.spins + mem.atomicLoad[u64](&(*slot).spins as *u64, MemOrder.Relaxed);
    st.spinsFound = st.spinsFound + mem.atomicLoad[u64](&(*slot).spinsFound as *u64, MemOrder.Relaxed);
    st.spinsOut = st.spinsOut + mem.atomicLoad[u64](&(*slot).spinsOut as *u64, MemOrder.Relaxed);
    st.parks = st.parks + mem.atomicLoad[u64](&(*slot).parks as *u64, MemOrder.Relaxed);
    st.reparks = st.reparks + mem.atomicLoad[u64](&(*slot).reparks as *u64, MemOrder.Relaxed);
    st.marksSpent = st.marksSpent + mem.atomicLoad[u64](&(*slot).marksSpent as *u64, MemOrder.Relaxed);
    i = i + 1u32;
  }
  st
}

// The index of the worker running the caller, 0 up to the number of workers
// less 1; noWorker on any other thread
pub fn workerIndex() u32 {
  let w = me as *Worker;
  if w as usize == 0usize {
    return noWorker;
  }
  (*w).index
}
