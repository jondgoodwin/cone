// The start floor of `parallel each`, by worker count and loop size, with a body
// that does next to nothing (one store per item). Bug 7. For each size it prints
// nanoseconds for: the plain `each` loop (the serial cost), the FIRST parallel loop
// of the process (it starts the workers), a loop run back to back (workers still
// spinning), and a loop run after a 3 ms sleep (workers parked: what a program that
// loops now and then sees). Median and minimum of the repeats. Run on a quiet machine:
//
//   foreach ($w in 1,2,4,8,16,0) { congo run --release packages/actors/examples/parfloor.cone -- $w }
//
// (0 or no argument: one worker per logical processor.) The worker count is fixed for
// a process, hence one process each.

mod parfloor;

import stdio use *;
import libc;
import actors;
import thread;
import time use Instant, Duration;

const reps = 41usize;

fn digits(p: *u8) u32 {
  var n = 0u32;
  var q = p;
  while *q >= 48u8 && *q <= 57u8 {
    n = n * 10u32 + u32.from(*q - 48u8);
    q = q + 1usize;
  }
  n
}

fn nanos(t0: Instant) u64 {
  u64.from(t0.elapsed().nanos())
}

// Median and minimum of the first k samples (sorted in place)
fn report(label: &str, xs: *u64, k: usize) {
  var i = 1usize;
  while i < k {
    let v = *(xs + i);
    var j = i;
    while j > 0usize && *(xs + j - 1usize) > v {
      *(xs + j) = *(xs + j - 1usize);
      j = j - 1usize;
    }
    *(xs + j) = v;
    i = i + 1usize;
  }
  printStr("  "); printStr(label);
  printStr(" median "); printUInt(*(xs + k / 2usize));
  printStr(" min "); printUInt(*xs); printStr(" ns\n");
}

fn loopOnce(out: *u64, n: usize) {
  parallel each i in 0usize ..< n {
    *(out + i) = u64.from(i);
  }
}

fn size(out: *u64, n: usize, xs: *u64, first: bool) {
  printStr("items "); printUInt(u64.from(n)); printStr("\n");
  var k = 0usize;
  while k < reps {
    let t0 = Instant.now();
    each i in 0usize ..< n {
      *(out + i) = u64.from(i);
    }
    *(xs + k) = nanos(t0);
    k = k + 1usize;
  }
  report("serial each        ", xs, reps);
  if first {
    let t0 = Instant.now();
    loopOnce(out, n);
    printStr("  first parallel loop (starts the workers) "); printUInt(nanos(t0)); printStr(" ns\n");
  }
  k = 0usize;
  while k < reps {
    let t0 = Instant.now();
    loopOnce(out, n);
    *(xs + k) = nanos(t0);
    k = k + 1usize;
  }
  report("parallel back2back ", xs, reps);
  k = 0usize;
  while k < reps {
    thread.sleep(Duration.fromMillis(3i64));
    let t0 = Instant.now();
    loopOnce(out, n);
    *(xs + k) = nanos(t0);
    k = k + 1usize;
  }
  report("parallel after nap ", xs, reps);
}

fn main(argc: i32, argv: **u8) {
  initAll();
  var workers = 0u32;
  if argc > 1i32 {
    workers = digits(*(argv + 1usize));
  }
  actors.configure(actors.Options(workers: workers));
  let out = libc.calloc(1048576usize, 8usize) as *u64;
  let xs = libc.calloc(reps, 8usize) as *u64;
  printStr("workers requested "); printUInt(u64.from(workers)); printStr("\n");
  size(out, 256usize, xs, true);
  size(out, 4096usize, xs, false);
  size(out, 65536usize, xs, false);
  size(out, 1048576usize, xs, false);
  finalAll();
  printStr("workers started "); printUInt(u64.from(actors.stats().workers)); printStr("\n");
}
