// scratch (not committed): start the workers, do a little work, then sit idle
// for 40 s so that a process sampler can read the CPU time the idle workers use.
mod idlecpu;

import stdio use *;
import actors;
import thread;
import time;

actor Echo {
  n: u64 = 0u64;
  pub async fn hit(self) {
    n = n + 1u64;
  }
}

fn main() {
  initAll();
  {
    var i = 0u32;
    while i < 100u32 {
      let e = Echo();
      e.hit();
      e.hit();
      i = i + 1u32;
    }
  }
  actors.waitUntilIdle();
  printStr("idle\n");
  thread.sleep(time.Duration.fromMillis(40000i64));
  finalAll();
}
