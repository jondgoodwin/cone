// The held timer, actors.Timer (THE HELD TIMER, timers.cone; row 500): its
// plain fires, later and earlier moves, a deadline already past, clear, stop
// with a next() parked, a group's cancel (its own and an ancestor's), a Timer
// replaced by its own actor while its loop waits, and an actor dropped with its
// timer armed and no waiter. At the end no cell is held, no entry is left in a
// wheel, and the runtime goes idle (every operation spent).

mod heldtimer;

import testing use *;
import thread;
import time use Duration, Instant;
import sync use Channel, Sender, Receiver;
import cancelgroups use CancelGroup, Cause;
import actors use Timer;

fn at(ms: i64) Instant {Instant.fromNanos(Instant.now().nanos() + ms * 1000000i64)}

actor Ticker {
  timer: Timer;
  out: Sender[u64];

  // The checks of one actor's turns, each a bit of 'bad' when it fails
  pub async fn checks(self) {
    var bad = 0u64;
    // plain fires, never early
    var n = 0u64;
    while n < 3u64 {
      let d = at(2i64);
      timer.set(d);
      if !(await timer.next()) {bad = bad | 1u64;}
      if Instant.now().nanos() < d.nanos() {bad = bad | 2u64;}
      match timer.deadline() {
        case let Some(x) {bad = bad | 4u64;}
        else {}
      }
      n = n + 1u64;
    }
    // a million later moves, then the one fire, at or after the last, and
    // soon after it (within 100 ms: a tick, under a loaded machine's slack).
    // Each move is 100 ms past the moment it is made (never earlier than the
    // one before), so the deadline is still ahead of the wheel's first look
    // however long the loop takes: the earlier form (the deadlines 100 ns
    // apart, the last 100 ms on) ran out under load, when the million moves took
    // over 100 ms: the entry then came up already due, with nothing to refile
    // (24 Nov: 4 of 20 runs under 24 burners failed 'the later moves refiled')
    timer.set(at(1i64));
    var last = at(100i64);
    var k = 0u64;
    while k < 1000000u64 {
      last = at(100i64);
      timer.set(last);
      k = k + 1u64;
    }
    if !(await timer.next()) {bad = bad | 8u64;}
    let woke = Instant.now().nanos();
    if woke < last.nanos() || woke - last.nanos() > 100000000i64 {bad = bad | 16u64;}
    // an earlier move: 300 ms, then 2 ms
    let t0 = Instant.now().nanos();
    timer.set(at(300i64));
    timer.set(at(2i64));
    if !(await timer.next()) {bad = bad | 32u64;}
    if Instant.now().nanos() - t0 > 250000000i64 {bad = bad | 64u64;}
    // clear, then set again
    timer.set(at(1i64));
    timer.clear();
    match timer.deadline() {
      case let Some(x) {bad = bad | 128u64;}
      else {}
    }
    timer.set(at(1i64));
    if !(await timer.next()) {bad = bad | 256u64;}
    // a deadline already past answers at once
    timer.set(at(-1i64));
    if !(await timer.next()) {bad = bad | 512u64;}
    out.send(bad);
  }

  // Parked with a far deadline until stopIt: false, and false again after
  pub async fn park(self) {
    timer.set(at(5000i64));
    let a = await timer.next();
    let b = await timer.next();
    var r = 0u64;
    if a {r = r | 1u64;}
    if b {r = r | 2u64;}
    match timer.cause() {
      case let Some(c) {r = r | 4u64;}
      else {}
    }
    out.send(100u64 + r);
  }

  pub async fn stopIt(self) {
    timer.stop();
  }

  // Parked with no deadline until replaceIt drops the timer: false
  pub async fn parkBare(self) {
    let a = await timer.next();
    out.send(if a {201u64} else {200u64});
  }

  pub async fn replaceIt(self) {
    timer = Timer.make();
  }

  // Armed, no waiter: the actor is dropped with it so
  pub async fn arm(self) {
    timer.set(at(50i64));
    out.send(300u64);
  }
}

actor Grouped {
  timer: Timer;
  out: Sender[u64];

  // Parked until the group (or its parent) is cancelled: false, cause Cancelled
  pub async fn park(self) {
    timer.set(at(5000i64));
    let a = await timer.next();
    var r = 0u64;
    if a {r = r | 1u64;}
    match timer.cause() {
      case let Some(c) {
        match c {
          case Cause.Cancelled {}
          else {r = r | 2u64;}
        }
      }
      else {r = r | 4u64;}
    }
    out.send(400u64 + r);
  }
}

fn recv(rx: &mut Receiver[u64]) u64 {rx.recv() || 999u64}

fn runAll() {
  var tx: Sender[u64];
  var rx: Receiver[u64];
  tx, rx = Channel[u64].make();
  {
    let t = Ticker(Timer.make(), tx.clone());
    t.checks();
    expectUInt(recv(&mut rx), 0u64, "fires on time, later and earlier moves, clear, a past deadline (bits of the failed checks)");
    t.park();
    thread.sleep(Duration.fromMillis(20i64));
    t.stopIt();
    expect(recv(&mut rx) == 100u64, "stop with next() parked: false, false again, no cause");
  }
  {
    let t = Ticker(Timer.make(), tx.clone());
    t.parkBare();
    thread.sleep(Duration.fromMillis(20i64));
    t.replaceIt();
    expect(recv(&mut rx) == 200u64, "a Timer replaced while its loop waits: false");
  }
  {
    let t = Ticker(Timer.make(), tx.clone());
    t.arm();
    expect(recv(&mut rx) == 300u64, "armed, then dropped with no waiter");
  }
  let g = CancelGroup.make();
  {
    let a = Grouped(Timer.within(&g), tx.clone());
    a.park();
    thread.sleep(Duration.fromMillis(20i64));
    g.cancel();
    expect(recv(&mut rx) == 400u64, "the group's cancel: false, cause Cancelled");
  }
  let parent = CancelGroup.make();
  let child = parent.child();
  {
    let a = Grouped(Timer.within(&child), tx.clone());
    a.park();
    thread.sleep(Duration.fromMillis(20i64));
    parent.cancel();
    expect(recv(&mut rx) == 400u64, "an ancestor's cancel: false, cause Cancelled");
  }
}

fn main() i32 {
  initAll();
  actors.configure(actors.Options(workers: 3u32));
  runAll();
  expect(actors.waitUntilIdleFor(Duration.fromSeconds(10i64)), "idle: every operation spent");
  // the dead entries come up within the far deadlines' 5 s at most; the cells go as their actors do
  var waited = 0u64;
  while (actors.timerStats().held != 0u64 || actors.timerStats().heldEntries != 0u64) && waited < 700u64 {
    thread.sleep(Duration.fromMillis(10i64));
    waited = waited + 1u64;
  }
  let st = actors.timerStats();
  expect(st.held == 0u64, "no cell held once the actors have gone");
  expect(st.heldEntries == 0u64, "no entry left in a wheel");
  expect(st.refiles > 0u64, "the later moves refiled");
  done()
}
