// A runnable actor left in the queue of a worker whose turn does not end
// (Bug 2, #989: the scheduler's lost wake). X's turn sends to idle Y, which
// is pushed on X's own worker's empty queue (a local push), and X
// then waits inside the turn, without returning, for a flag only Y sets. Every
// other worker is idle (parked). Y must run on another worker while X waits:
// the invariant (the header, THE SEARCH INVARIANT) says a worker searches while
// any queue holds a runnable actor and one sleeps. X gives up after 300 ms
// of waiting, so a stranded Y shows as a count of rounds, not as a hang.
//
// Before the wake rule (duty 3: a push to one's own empty queue wakes a
// sleeper when none is looking) 19 of 20 rounds stranded (round 1 passes: the
// workers still spin from the start), on master 79d75ad82 and on #989's head
// with duties 1 and 2. The rule is off by default; the checked run (no
// argument) relies on the scheduler's monitor (THE MONITOR, Options.monitorMicros)
// to wake a worker for Y within a tick or two. With the argument 'off' the
// monitor is off too (monitorMicros: 0) and the program prints how many rounds
// stranded instead of checking it (it strands again: 19 of 20). With 'rule'
// the wake rule is on instead (wakeOnPush: true, monitor off), checked. A run with
// an argument prints the longest wait for Y, in microseconds.

mod lostwake;

import testing use *;
import stdio use *;
import process;
import actors;
import thread;
import time;

let flag: Atomic[u64];
let seen: Atomic[u64];
let stranded: Atomic[u64];
let longest: Atomic[u64];   // the longest wait for Y, in microseconds (one writer at a time: X's turns do not overlap)

fn @initpure init() {
  flag = Atomic[u64].of(0u64);
  seen = Atomic[u64].of(0u64);
  stranded = Atomic[u64].of(0u64);
  longest = Atomic[u64].of(0u64);
}

actor Y {
  pub async fn set(self) {
    flag.add(1u64);
  }
}

actor X {
  pub async fn go(self, y: Y, round: u64) {
    y.set();
    let t0 = time.Instant.now();
    while flag.load() < round && t0.elapsed().micros() < 300000i64 {
      thread.sleep(time.Duration.fromMicros(50i64));
    }
    let waited = u64.from(t0.elapsed().micros());
    if waited > longest.load() {
      longest.store(waited);
    }
    if flag.load() < round {
      stranded.add(1u64);
    }
    seen.add(1u64);
  }
}

fn main() i32 {
  initAll();
  let args = process.args();
  let off = args.len() >= 2usize && args[1usize].equals("off");
  let rule = args.len() >= 2usize && args[1usize].equals("rule");
  actors.configure(actors.Options(workers: 8u32, wakeOnPush: rule,
    monitorMicros: if off || rule {0u32} else {500u32}));
  var round = 1u64;
  while round <= 20u64 {
    thread.sleep(time.Duration.fromMillis(30i64));
    let x = X();
    let y = Y();
    x.go(y, round);
    actors.waitUntilIdle();
    round = round + 1u64;
  }
  expectUInt(seen.load(), 20u64, "every round's turn ended");
  if args.len() >= 2usize {
    printStr("longest wait for Y "); printUInt(longest.load()); printStr(" us\n");
  }
  if off {
    printStr("stranded "); printUInt(stranded.load()); printStr(" of 20\n");
  } else {
    expectUInt(stranded.load(), 0u64, "Y ran while X's turn was held, in every round");
  }
  finalAll();
  done()
}
