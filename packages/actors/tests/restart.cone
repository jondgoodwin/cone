// The runtime's life, with no actors at all: started, finished at once (it
// is quiescent from the first), and started again, three times, with 1, 3
// and the default number of workers. Each 'finish' answers the run's counts:
// as many workers as asked for, and no messages. Main is not a worker, so
// workerIndex answers noWorker on it, runtime or none. A Runtime handle that
// dies unfinished finishes as it dies.

mod restart;

import testing use *;
import thread;
import actors;

fn main() i32 {
  expectUInt(u64[actors.workerIndex()], u64[actors.noWorker], "main is no worker, before any runtime");

  imm one = actors.startWith(actors.Options[workers: 1u32]);
  expectUInt(u64[actors.workerIndex()], u64[actors.noWorker], "main is no worker, with a runtime");
  imm a = one.finish();
  expectUInt(u64[a.workers], 1u64, "one worker");
  expectUInt(a.messages, 0u64, "no messages with one worker");

  imm three = actors.startWith(actors.Options[workers: 3u32, batch: 10u32]);
  imm b = three.finish();
  expectUInt(u64[b.workers], 3u64, "three workers");
  expectUInt(b.messages, 0u64, "no messages with three");

  imm all = actors.start();
  imm c = all.finish();
  expectUInt(u64[c.workers], u64[thread.parallelism()], "one worker per logical processor by default");

  {
    imm dropped = actors.startWith(actors.Options[workers: 2u32]);
  }
  imm again = actors.startWith(actors.Options[workers: 2u32]);
  imm d = again.finish();
  expectUInt(u64[d.workers], 2u64, "started again after a runtime finished by its death");
  done();
}
