// Bug 108's other hook case (row 723): an actor a worker's hook MAKES whose init sent, started after the stop's
// last quiesce, whose first behaviour parks while the stop takes the pending tables.
//
// startActor is not a send: it marks the new actor's mailbox idle or, finding the message its init sent, takes the
// scheduler's owner and queues the actor ('schedule', the activation counted there). From a worker's hook that
// happens outside every counted activation, so it can fall after the quiesce has read the counts, and the
// activation then runs beside abandonParked's take.
//
// The producer is this test's own after-turn hook, after Talker parks a record (as latesend). The hook makes a
// Starter: its init sends 'first' to itself (the gate is still open: accepted, the actor busy so nothing queued) and
// then waits until the stop is held between its last quiesce and its take (actors.testHoldTake), and returns:
// startActor then queues the Starter. 'first' parks (parkReserve, then its operation stays 300 ms before the
// record is written), so the take, 100 ms after the hold begins, lands inside the park. Without a guard the take
// empties the table and drops the reserved block, and the park then writes into the emptied table: a null read in
// 'parked' (access violation).
//
// The guard is the stop's gate, which startActor from a hook now passes as a send does: the stop has closed it by the
// time the init returns, so the Starter is not queued, 'first' never runs, and the refusal is counted (the
// init's own two sends passed while the gate was open; the start is refused once, not once per message). The output is Note 2 and Note 1 dropped by the stop,
// 'started 1 refused 1', and the end.

mod hookstart;

import stdio use *;
import libc;
import actors;
import thread;
import time;

// The operation's record: the Reply the seam gave, kept for the hook
struct Rec {
  pub reply: actors.Reply;
}

let ready: Atomic[u64];       // 1 once Talker has parked
let pending: Atomic[usize];   // the record the hook is to hand on, 0 when none
let startedAt: Atomic[u64];   // 1 once the hook has made and started the Starter

fn @initpure init() {
  ready = Atomic[u64].of(0u64);
  pending = Atomic[usize].of(0usize);
  startedAt = Atomic[u64].of(0u64);
}

struct Note {
  pub n: u64;
  fn final(self: &uni) {
    printStr("  drop "); printUInt(n); printStr("\n");
  }
}

// The first operation: keeps the Reply in its record (never answered) and has the worker run the hook once this
// turn ends
fn runKeep(ctx: *u8, rp: actors.Reply) {
  let r = ctx as *Rec;
  mem.writeRaw[Rec](r, Rec(rp));
  pending.store(ctx as usize);
  actors.askAfterTurn();
  ready.store(1u64);
}

fn dropIt(ctx: *u8) {}

fn keepOp(r: *Rec) actors.Awaitable[u64] {actors.Awaitable[u64].of(r as *u8, &runKeep, &dropIt)}

// The second operation, started by 'first' after its slot is reserved and before its record is written: it stays
// inside the park for 300 ms, and answers (the answer, if it comes after the take, is a late one: dropped)
fn runLate(ctx: *u8, rp: actors.Reply) {
  thread.sleep(time.Duration.fromMillis(300i64));
  var r = rp;
  actors.answerNowIn[u64](&mut r, 9u64);
}

fn lateOp(ctx: *u8) actors.Awaitable[u64] {actors.Awaitable[u64].of(ctx, &runLate, &dropIt)}

// The producer: a worker's after-turn hook, outside every activation. It makes a Starter, whose init waits for the
// hold (bounded) before startActor queues it
fn afterTurn() {
  let at = pending.swap(0usize);
  if at == 0usize {
    return;
  }
  let st = Starter(at);
  startedAt.store(1u64);
}

fn idleHook() bool {false}

actor Talker {
  pub async fn talk(self, rec: usize) {
    let first = Note(1u64);
    let second = Note(2u64);
    let got = await keepOp(rec as *Rec);
    printStr("resumed\n");
  }
}

actor Starter {
  fn init(self: &new, ctx: usize) {
    *self = Self();
    selfactor.first(ctx);
    selfactor.first(ctx);
    let t0 = time.Instant.now();
    while !actors.testTakeHeld() && t0.elapsed() < time.Duration.fromMillis(500i64) {
      thread.sleep(time.Duration.fromMillis(1i64));
    }
  }

  pub async fn first(self, ctx: usize) {
    let held = 5u64;
    let got = await lateOp(ctx as *u8);
    if held != 5u64 {
      printStr("held changed\n");
    }
  }
}

fn main() {
  initAll();
  actors.configure(actors.Options(workers: 4u32));
  actors.workerHooks(&afterTurn, &idleHook);
  let rec = libc.malloc(mem.sizeof[Rec]());
  let t = Talker();
  t.talk(rec as usize);
  while ready.load() == 0u64 {
    thread.yieldNow();
  }
  thread.sleep(time.Duration.fromMillis(50i64));
  actors.testHoldTake(100i64);
  finalAll();
  printStr("started "); printUInt(startedAt.load()); printStr(" refused "); printUInt(actors.stats().refused); printStr("\n");
  printStr("end\n");
}
