// Parallel reductions ('xs.parallel().sum()', 'fold', 'findFirst') with the actors
// package built as a library of its own, as a program uses it, on a SINGLE worker
// (main and the worker share every block). The compiler's suite runs the same
// reductions on four workers; a float sum's bits are pinned in both places
// (4622995765255421869 for the harmonic sum of 100,000 items), so the result is
// shown to be the same whatever the number of workers: the blocks are cut by the
// item count alone and joined by a tree fixed by the block count.

mod parallelreduce;

import testing use *;
import collections use *;
import actors;

fn counting(n: usize) List[i64] {
  var l = new List[i64]();
  var i = 0i64;
  while i < i64.from(n) {
    l.push(i);
    i = i + 1i64;
  }
  l
}

fn bitsOf(x: f64) u64 {
  var c = x;
  mem.readRaw[u64](&mut c as *f64 as *u64)
}

fn main() i32 {
  actors.configure(new actors.Options(workers: 1u32));

  // An integer sum, the sizes around the block boundaries
  expectInt(counting(0usize).parallel().sum(), 0i64, "sum of none");
  expectInt(counting(127usize).parallel().sum(), 8001i64, "sum of 127, one block");
  expectInt(counting(129usize).parallel().sum(), 8256i64, "sum of 129, two blocks");
  expectInt(counting(100000usize).parallel().sum(), 4999950000i64, "sum of 100000");

  // The harmonic sum's bits, the same as on four workers
  var h = new List[f64]();
  var k = 0usize;
  while k < 100000usize {
    h.push(1.0 / (f64.from(k) + 1.0));
    k = k + 1usize;
  }
  expectUInt(bitsOf(h.parallel().sum()), 4622995765255421869u64, "harmonic sum bits");

  // A float fold's bits, as on four workers (and 2, 3, 8, 16): squares of the harmonic items
  expectUInt(bitsOf(h.parallel().fold(0.0, (acc, x) => acc + *x * *x, (a, b) => a + b)), 4610086898587382524u64, "f64 fold bits");
  var g = new List[f32]();
  k = 0usize;
  while k < 70001usize {
    g.push(1.0 / (f32.from(k) + 1.0));
    k = k + 1usize;
  }
  let gsum = g.parallel().fold(0.0f, (acc, x) => acc + *x, (a, b) => a + b);
  var gc = gsum;
  expectUInt(u64.from(mem.readRaw[u32](&mut gc as *f32 as *u32)), 1094433886u64, "f32 fold bits");

  // A mixed-sign sum, whose result depends on the order of addition, as on four workers
  var m = new List[f64]();
  k = 0usize;
  while k < 50000usize {
    let v = 1.0 / (f64.from(k) + 1.0);
    m.push(if k % 2usize == 0usize { v * 1.0e8 } else { -v * 1.0e8 + 1.0 / 3.0 });
    k = k + 1usize;
  }
  expectUInt(bitsOf(m.parallel().sum()), 4724424533603838307u64, "mixed-sign sum bits");

  // The nearest with a payload as a fold: ties to the lowest position, across blocks.
  // 5000 distances 100 + (k * 37) % 997, positions 700, 2100 and 4999 set to 3.5
  var d = new List[f32]();
  k = 0usize;
  while k < 5000usize {
    d.push(100.0 + f32.from((k * 37usize) % 997usize));
    k = k + 1usize;
  }
  d[2100usize] = 3.5;
  d[700usize] = 3.5;
  d[4999usize] = 3.5;
  let near = d.indexed().parallel().fold((1.0e30f, 0usize),
    (acc, p) => if *p.1 < acc.0 { (*p.1, p.0) } else { acc },
    (a, b) => if b.0 < a.0 { b } else { a });
  expectInt(i64.from(near.1), 700i64, "nearest with ties: the lowest position");
  expect(near.0 == 3.5, "nearest distance");

  // A fold with a combine that is not commutative: the sequence's polynomial hash
  // as (h, p), joined (h1 * p2 + h2, p1 * p2) and so by position (5000 items: 858949)
  let l = counting(5000usize);
  let hash = l.parallel().fold((0u64, 1u64),
    (acc, x) => ((acc.0 * 31u64 + u64.from(*x) + 1u64) % 1000003u64, (acc.1 * 31u64) % 1000003u64),
    (p, q) => ((p.0 * q.1 + q.0) % 1000003u64, (p.1 * q.1) % 1000003u64));
  expectUInt(hash.0, 858949u64, "in-order hash of 5000 items");

  // findFirst: the earliest by position, none, and over indexed()
  match l.parallel().findFirst(x => **x % 1000i64 == 123i64) {
    case let s Some { expectInt(*s, 123i64, "earliest of many"); }
    case is None { expect(false, "earliest of many found"); }
  }
  match l.parallel().findFirst(x => **x < 0i64) {
    case let s Some { expect(false, "none found"); }
    case is None { expect(true, "none found"); }
  }
  match l.indexed().parallel().findFirst(p => *(*p).1 == 977i64) {
    case let s Some { expectInt(i64.from(s.0), 977i64, "indexed position"); }
    case is None { expect(false, "indexed found"); }
  }
  done()
}
