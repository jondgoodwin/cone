// A program that imports actors and starts none pays nothing for it: no
// worker thread is started, and finalAll(), which runs the actors module's
// finalizer, returns at once, with nothing to wait for or stop. stats()
// answers no workers and no work before and after.

mod noactors;

import testing use *;
import actors;

fn main() i32 {
  initAll();
  expectUInt(u64[actors.stats().workers], 0u64, "no workers before finalAll");
  expectUInt(u64[actors.workerIndex()], u64[actors.noWorker], "main is no worker");
  finalAll();
  imm st = actors.stats();
  expectUInt(u64[st.workers], 0u64, "no workers after finalAll");
  expectUInt(st.messages, 0u64, "no messages");
  done();
}
