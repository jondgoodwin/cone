// A parallel loop in a program that declares no actor. A range no longer than
// the grain is run at once on the caller's thread and starts nothing: stats()
// still answers no workers. A longer one starts the workers (as many as the
// processor has) for itself, spreads over them, and returns with every item
// written; finalAll() then stops them, quiet at once because no actor ever
// ran.

mod parallelalone;

import testing use *;
import libc;
import actors;

// The loop's body is a closure that lists the pointer it writes through: its
// own copy of the address, so it borrows nothing and is Shareable
fn bodySquares(out *u64, lo usize, hi usize) {
  mut i = lo;
  while i < hi {
    *(out + i) = u64.from(i) * u64.from(i);
    i = i + 1usize;
  }
}

fn allSquares(out *u64, n usize) bool {
  mut i = 0usize;
  while i < n {
    if *(out + i) != u64.from(i) * u64.from(i) {
      return false;
    }
    i = i + 1usize;
  }
  true;
}

fn main() i32 {
  initAll();
  imm n = 100000usize;
  imm out = libc.calloc(n, 8usize) as *u64;

  actors.parallelRange(0usize, 50usize, 64usize, fn(lo usize, hi usize) [out] { bodySquares(out, lo, hi); });
  expectUInt(u64.from(actors.stats().workers), 0u64, "a range within the grain starts no workers");
  expect(allSquares(out, 50usize), "its items are written");

  actors.parallelRange(0usize, n, 64usize, fn(lo usize, hi usize) [out] { bodySquares(out, lo, hi); });
  expect(actors.stats().workers > 0u32, "a longer range started the workers");
  expect(allSquares(out, n), "every item of the longer range is written");
  expectUInt(u64.from(actors.workerIndex()), u64.from(actors.noWorker), "main is still no worker");

  finalAll();
  expect(actors.stats().workers > 0u32, "the totals remember the workers");
  libc.free(out as *u8);
  done();
}
