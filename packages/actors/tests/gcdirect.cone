// A value in an actor's region is made through the actor, 'new self[T](...)'. A
// bare 'ActorGc[mut, T](...)', which names no actor, has no region to be in:
// it panics, saying so, and nothing is allocated.

mod gcdirect;

import stdio use *;
import libc;
import actors;

struct Node { pub n: i64; }

fn main() i32 {
  printStr("asking\n");
  libc.fflush(libc.stdout());
  let g = ActorGc[mut, Node](Node(1));
  printStr("went on\n");
  0
}
