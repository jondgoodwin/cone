// The pieces of a 'parallel each' run in the cancel group of the code that began
// the loop (actors.cone, THE GROUP TRAVELS; parallel.cone), whatever worker runs
// them, and so does the rest of a behaviour after the loop.
//
// 1. From main inside actors.withGroup(g, ...): every piece of a 4,000-piece loop
//    sees currentGroup() == g; with no group the pieces see the process's own
//    group, as before.
// 2. A cancel from outside is seen by running pieces: main cancels g while the
//    pieces of a loop in a behaviour spin on isCancelled(); every piece sees it.
// 3. A cancel from inside a piece is seen by later pieces: a behaviour's first
//    loop cancels its group from piece 0; its second loop's pieces all see the
//    group cancelled, and so does the rest of the behaviour.
// 4. The loop's sends are gathered and sent in the loop's group: each piece's
//    message to a sink is handled in g.

mod parallelgroup;

import testing use *;
import collections use *;
import thread;
import actors;
import cancelgroups use *;
import time use Instant, Duration;

struct Seen {
  pub bad: Atomic[u64];          // pieces in the wrong group
  pub pieces: Atomic[u64];
  pub started: Atomic[u64];
  pub sawCancel: Atomic[u64];
  pub afterId: Atomic[u64];      // the rest of the behaviour's group
  pub afterCancelled: Atomic[u64];
  pub loop2Saw: Atomic[u64];
  pub sinkBad: Atomic[u64];
  pub sinkGot: Atomic[u64];
}

let seen: Seen;

fn @initpure init() {
  seen = Seen(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64));
}

fn bounded(limitMs: i64) Instant {Instant.now() + Duration.fromMillis(limitMs)}

actor Sink {
  pub async fn note(self, want: u64) {
    seen.sinkGot.add(1u64);
    if actors.currentGroup().id() != want {seen.sinkBad.add(1u64);}
  }
}

actor Worker {
  // a loop whose pieces check their group, then the rest of the behaviour
  pub async fn scan(self, want: u64) {
    parallel each i in 0usize ..< 3000usize {
      seen.pieces.add(1u64);
      if actors.currentGroup().id() != want {seen.bad.add(1u64);}
    }
    seen.afterId.store(actors.currentGroup().id());
  }

  // pieces that run until their group is cancelled (or, so that a failure ends, two seconds)
  pub async fn spin(self) {
    parallel each i in 0usize ..< 64usize {
      seen.started.add(1u64);
      let limit = bounded(2000i64);
      while !actors.isCancelled() && Instant.now() < limit {thread.yieldNow();}
      if actors.isCancelled() {seen.sawCancel.add(1u64);}
    }
    seen.afterCancelled.store(if actors.isCancelled() {1u64} else {0u64});
  }

  // cancel from inside a piece, then a second loop
  pub async fn cancelInside(self) {
    parallel each i in 0usize ..< 200usize {
      if i == 0usize {actors.currentGroup().cancel();}
    }
    parallel each j in 0usize ..< 500usize {
      if actors.isCancelled() {seen.loop2Saw.add(1u64);}
    }
    seen.afterCancelled.store(if actors.isCancelled() {1u64} else {0u64});
  }

  // each piece sends the sink a message, to be handled in the same group
  pub async fn sends(self, sink: Sink, want: u64) {
    parallel each i in 0usize ..< 400usize {
      sink.note(want + (u64.from(i) & 0u64));
    }
  }
}

fn reset() {
  seen.bad.store(0u64);
  seen.pieces.store(0u64);
  seen.started.store(0u64);
  seen.sawCancel.store(0u64);
  seen.afterId.store(0u64);
  seen.afterCancelled.store(0u64);
  seen.loop2Saw.store(0u64);
  seen.sinkBad.store(0u64);
  seen.sinkGot.store(0u64);
}

fn main() i32 {
  initAll();
  actors.configure(actors.Options(workers: 4u32));
  let rootId = actors.currentGroup().id();
  let w = Worker();

  // 1. a loop begun by main in a group, and in none
  let g = CancelGroup.make();
  let gid = g.id();
  reset();
  actors.withGroup(&g, fn() [gid] {
    parallel each i in 0usize ..< 4000usize {
      seen.pieces.add(1u64);
      if actors.currentGroup().id() != gid {seen.bad.add(1u64);}
    }
  });
  expectUInt(seen.pieces.load(), 4000u64, "1: main's loop ran its 4,000 pieces");
  expectUInt(seen.bad.load(), 0u64, "1: every piece saw main's group");
  reset();
  parallel each i in 0usize ..< 4000usize {
    seen.pieces.add(1u64);
    if actors.currentGroup().id() != rootId {seen.bad.add(1u64);}
  }
  expectUInt(seen.bad.load(), 0u64, "1: with no group, every piece saw the process's own");

  // a behaviour's loop, in a group and in none
  reset();
  actors.withGroup(&g, fn() [w, gid] { w.scan(gid); });
  actors.waitQuiet();
  expectUInt(seen.pieces.load(), 3000u64, "1: a behaviour's loop ran its pieces");
  expectUInt(seen.bad.load(), 0u64, "1: ... each in the group the behaviour's message was sent in");
  expectUInt(seen.afterId.load(), gid, "1: ... and the rest of the behaviour is in it too");
  reset();
  w.scan(rootId);
  actors.waitQuiet();
  expectUInt(seen.bad.load(), 0u64, "1: a behaviour sent in no group: pieces in the process's own group");
  expectUInt(seen.afterId.load(), rootId, "1: ... and its rest");

  // 2. cancel from outside, seen by running pieces
  reset();
  let g2 = CancelGroup.make();
  actors.withGroup(&g2, fn() [w] { w.spin(); });
  let limit = bounded(5000i64);
  while seen.started.load() == 0u64 && Instant.now() < limit {thread.yieldNow();}
  expect(seen.started.load() > 0u64, "2: the pieces are running");
  expectUInt(seen.sawCancel.load(), 0u64, "2: ... and have seen no cancel");
  g2.cancel();
  actors.waitQuiet();
  expectUInt(seen.started.load(), 64u64, "2: all 64 pieces ran");
  expectUInt(seen.sawCancel.load(), 64u64, "2: every piece saw the cancel made outside");
  expectUInt(seen.afterCancelled.load(), 1u64, "2: and the rest of the behaviour is in the cancelled group");

  // 3. cancel from inside a piece
  reset();
  let g3 = CancelGroup.make();
  actors.withGroup(&g3, fn() [w] { w.cancelInside(); });
  actors.waitQuiet();
  expect(g3.isCancelled(), "3: a piece cancelled the behaviour's group");
  expectUInt(seen.loop2Saw.load(), 500u64, "3: every piece of the next loop saw it");
  expectUInt(seen.afterCancelled.load(), 1u64, "3: and the rest of the behaviour");

  // 4. the loop's gathered sends carry the group
  reset();
  let sink = Sink();
  actors.withGroup(&g, fn() [w, sink, gid] { w.sends(sink, gid); });
  actors.waitQuiet();
  expectUInt(seen.sinkGot.load(), 400u64, "4: all 400 gathered messages were handled");
  expectUInt(seen.sinkBad.load(), 0u64, "4: each in the loop's group");
  done()
}
