// Replies of every size round a slot's boundary come back whole. Ten pairs of
// actors: the server's behaviours take 0 to 72 bytes of padding argument (so the
// slots of the asking actor's mailbox, which a reply lands in, have payloads
// from the 32-byte minimum up to 96), and each answers with a struct of 1, 8,
// 15, 16, 17, 24, 31, 32, 33, 40, 47, 48, 56, 63 or 64 bytes (some inline in a
// slot, some boxed, by the slot's size). Each reply is checked byte by byte
// against the pattern its server wrote, so a reply read from the wrong place, cut
// short or written past its room shows. The 15 behaviours are generated, one
// reply struct each (R<n>, mk<n>, ok<n>); the file is regular, read one.

mod replysizes;
import testing use *;
import actors;
let bad: Atomic[u64];
let gotn: Atomic[u64];
fn @initpure init() { bad = Atomic[u64].of(0u64); gotn = Atomic[u64].of(0u64); }
struct R1 is Sendable { pub b: Array[u8, 1]; }
fn mk1(seed: u8) R1 { var a = Array[u8, 1]() <- fill 0u8; var i = 0usize; while i < 1 { a[i] = seed + u8.from(i); i = i + 1usize; } R1(a) }
fn ok1(r: &R1, seed: u8) bool { var i = 0usize; while i < 1 { if r.b[i] != seed + u8.from(i) { return false; } i = i + 1usize; } true }
