// Unconfigured, the first actor starts one worker per logical processor.
// Two threads start their first actors at once, both racing for the start:
// the workers start once (sync's Once), and each thread's actor runs.

mod defaults;

import testing use *;
import thread;
import actors;

struct Results {
  pub heard Atomic[u64];
}

imm results Results;

fn @initpure init() {
  results = new Results(Atomic[u64].of(0u64));
}

actor Echo {
  heard u64 = 0u64;

  pub fn hear(self, n u64) {
    heard = heard + n;
  }

  fn final(self &uni) {
    results.heard.add(heard);
  }
}

// A thread's first actor, sent n
fn startOne(n u64) u32 {
  imm e = new Echo();
  e.hear(n);
  actors.stats().workers;
}

fn main() i32 {
  initAll();
  imm a = thread.start(1u64, &startOne);
  imm b = thread.start(2u64, &startOne);
  imm wa = a.join();
  imm wb = b.join();
  expectUInt(u64.from(wa), u64.from(thread.parallelism()), "one worker per logical processor, seen from one thread");
  expectUInt(u64.from(wb), u64.from(thread.parallelism()), "the same workers, seen from the other");
  finalAll();
  expectUInt(u64.from(actors.stats().workers), u64.from(thread.parallelism()), "one worker per logical processor by default");
  expectUInt(results.heard.load(), 3u64, "both actors ran");
  done();
}
