// A reply answered twice in place is a program error: the first answerNowIn
// leaves the Reply spent, and answering a spent reply panics ("actors: a reply
// answered twice"), before anything is written or sent. The Reply is the one an
// awaiting actor's seam gave, kept in a record of the operation's own. Its
// .exit is a panic's, as nosend's. Its stderr, unchecked here since it names a
// line of actors.cone, says: panic at actors.cone:<line>: actors: a reply
// answered twice. What the program printed before is kept: a panic flushes
// stdout first.

mod inplacetwice;

import stdio use *;
import libc;
import actors;

struct Rec {
  pub reply: actors.Reply;
}

fn run(ctx: *u8, rp: actors.Reply) {
  let r = ctx as *Rec;
  mem.writeRaw[Rec](r, Rec(rp));
  actors.answerNowIn[u64](&mut (*r).reply, 1u64);
  printStr("answered once\n");
  actors.answerNowIn[u64](&mut (*r).reply, 2u64);
  printStr("not reached\n");
}

fn dropIt(ctx: *u8) {}

actor Asker {
  pub async fn go(self, place: usize) {
    let v = await actors.Awaitable[u64].of(place as *u8, &run, &dropIt);
    printStr("not reached either\n");
  }
}

fn main() {
  initAll();
  actors.configure(actors.Options(workers: 2u32));
  let place = libc.malloc(mem.sizeof[Rec]());
  let a = Asker();
  a.go(place as usize);
  actors.waitUntilIdle();
  printStr("not reached: main\n");
}
