// The scheduler study's probe (THE MONITOR, the header): every other worker
// is busy on its own queue, and one actor waits behind a long turn. Four
// workers. Three Churn actors send themselves a message at the end of every
// turn, so three workers run short turns for ever; the fourth worker sleeps.
// Main sends Hold, which wakes the fourth worker and holds it for 800 ms with
// its first act the making of Late runnable, onto that worker's own queue
// (a push to an empty queue wakes nobody: nothing sleeps now in any case).
// Notifying cannot help here, since no worker sleeps; the monitor moves Late
// to the inject queue, where a busy worker finds it at its next look there
// (every injectEvery turns). Late must run within 400 ms of being made
// runnable, with Hold still in its turn (the bound is the monitor's two ticks
// at their longest, 4 ms, and a look: 400 ms is 100 times that, for a loaded
// machine; without the monitor Late waits the whole 800 ms of Hold). Five
// rounds. Hold was 400 ms with a bound of 100 ms, which a loaded machine
// sometimes overran. What this gives up: a monitor that finds the stranded
// queue up to 400 ms late (instead of 100) is not caught; one that never does
// is. Under load a busy worker whose own queue is empty for a moment steals
// Late from Hold's queue before the monitor looks, which is the scheduler
// working, so the monitor's find is required only in the rounds with no steal
// anywhere (the steals count did not move), and at least one such round is
// required: when all five had a steal, up to five more run, and with none
// still the test FAILS ("no round tested the monitor"). What this gives up:
// in a round with a steal the monitor's own work is not checked (Late's
// timing and its running during Hold still are, in every round).

mod monitorstarve;

import testing use *;
import actors;
import thread;
import time;

const rounds = 5u32;

struct Flags {
  pub stop: Atomic[u32];
  pub madeAt: Atomic[u64];     // when Hold made Late runnable
  pub lateAt: Atomic[u64];     // when Late ran, 0 before
  pub holdDone: Atomic[u32];
  pub lateDuring: Atomic[u32]; // Late ran before Hold had finished
}

let flags: Flags;

fn @initpure init() {
  flags = Flags(Atomic[u32].of(0u32), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u32].of(0u32), Atomic[u32].of(0u32));
}

fn nowNs() u64 {u64.from(time.Instant.now().nanos())}

actor Churn {
  pub async fn go(self) {
    if flags.stop.load() == 0u32 {
      selfactor.go();
    }
  }
}

actor Late {
  pub async fn run(self) {
    flags.lateDuring.store(1u32 - flags.holdDone.load());
    flags.lateAt.store(nowNs());
  }
}

actor Hold {
  pub async fn hold(self, late: Late) {
    flags.madeAt.store(nowNs());
    late.run();
    let until = nowNs() + 800000000u64;
    while nowNs() < until {}
    flags.holdDone.store(1u32);
  }
}

fn main() i32 {
  initAll();
  actors.configure(actors.Options(workers: 4u32, monitorMicros: 500u32));
  {
    let c1 = Churn();
    let c2 = Churn();
    let c3 = Churn();
    c1.go();
    c2.go();
    c3.go();
    let hold = Hold();
    let late = Late();
    var prompt = 0u32;
    var during = 0u32;
    var free = 0u32;       // rounds with no steal anywhere: only the monitor could move Late
    var freeFound = 0u32;  // of those, the rounds the monitor moved a queue in
    var r = 0u32;
    while r < rounds || (free == 0u32 && r < 2u32 * rounds) {
      thread.sleep(time.Duration.fromMillis(30i64));
      flags.lateAt.store(0u64);
      flags.holdDone.store(0u32);
      let f0 = actors.stats().monitorFinds;
      let s0 = actors.stats().steals;
      hold.hold(late);
      let deadline = nowNs() + 2000000000u64;
      while flags.holdDone.load() == 0u32 && nowNs() < deadline {
        thread.yieldNow();
      }
      require(flags.holdDone.load() == 1u32, "Hold ended within 2 s");
      require(flags.lateAt.load() != 0u64, "Late ran by the end of Hold's turn");
      if flags.lateAt.load() - flags.madeAt.load() < 400000000u64 {prompt = prompt + 1u32;}
      if flags.lateDuring.load() == 1u32 {during = during + 1u32;}
      if actors.stats().steals == s0 {
        free = free + 1u32;
        if actors.stats().monitorFinds > f0 {freeFound = freeFound + 1u32;}
      }
      r = r + 1u32;
    }
    flags.stop.store(1u32);
    actors.waitUntilIdle();
    expectUInt(u64.from(during), u64.from(r), "every round, Late ran while Hold was still in its turn");
    expectUInt(u64.from(prompt), u64.from(r), "every round, Late ran within 400 ms of being made runnable");
    expect(free >= 1u32, "no round tested the monitor");
    expectUInt(u64.from(freeFound), u64.from(free), "the monitor found the stranded queue in each round with no steal");
  }
  finalAll();
  done()
}
