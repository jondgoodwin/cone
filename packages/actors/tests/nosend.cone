// A message sent once the runtime has stopped is refused and dropped (THE STOP'S GATE, actors.cone): nothing
// would ever run it, and it must not sit in a mailbox or panic. Here finalAll() has run the actors module's
// finalizer, which stopped the workers, and main still holds a handle and sends through it. The send returns
// quietly, the message is dropped here, and the refusal is counted in stats().refused.

mod nosend;

import stdio use *;
import actors;

actor Echo {
  heard: u64 = 0u64;

  pub async fn hear(self, n: u64) {
    heard = heard + n;
  }
}

fn main() {
  initAll();
  actors.configure(actors.Options(workers: 2u32));
  let e = Echo();
  e.hear(1u64);
  finalAll();
  printStr("sent while running, and stopped\n");
  let before = actors.stats().refused;
  e.hear(2u64);
  print <- "refused and counted: ", actors.stats().refused - before, "\n";
}
