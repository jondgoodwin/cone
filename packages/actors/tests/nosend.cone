// A message sent once the runtime has stopped is a program error: nothing
// would ever run it, so the send panics rather than let it sit. Here
// finalAll() has run the actors module's finalizer, which stopped the
// workers, and main still holds a handle and sends through it. Its .exit is
// a panic's, the status the Microsoft C library's 'abort' ends a program
// with, 0xC0000409. Its stderr, unchecked here since it names a line of
// actors.cone, says: panic at actors.cone:<line>: actors: a message sent
// after the runtime stopped. What the program printed before is kept: a
// panic flushes stdout first.

mod nosend;

import stdio use *;
import actors;

actor Echo {
  heard u64 = 0u64;

  pub fn hear(self, n u64) {
    heard = heard + n;
  }
}

fn main() {
  initAll();
  actors.configure(new actors.Options(workers: 2u32));
  imm e = new Echo();
  e.hear(1u64);
  finalAll();
  printStr("sent while running, and stopped\n");
  e.hear(2u64);
  printStr("not reached\n");
}
