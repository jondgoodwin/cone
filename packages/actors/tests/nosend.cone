// A message sent with no runtime running is a program error: nothing would
// ever run it, so the send panics rather than let it sit. Here the runtime
// has finished, and main still holds a handle and sends through it. Its
// .exit is a panic's, the status the Microsoft C library's 'abort' ends a
// program with, 0xC0000409. Its stderr, unchecked here since it names a line
// of actors.cone, says: panic at actors.cone:<line>: actors: a message sent
// with no runtime running. What the program printed before is kept: a panic
// flushes stdout first.

mod nosend;

import stdio use *;
import sync use arc;
import actors;

struct Echo_state is Sendable {
  hdr actors.Header;
  heard u64;

  pub fn made() Echo_state {
    Echo_state[actors.Header.make(), 0u64];
  }

  fn hear(self &mut, n u64) {
    heard = heard + n;
  }
}

enum Echo_msg {
  struct Hear {pub n u64;}
}

fn Echo_dispatch(self &mut Echo_state, msg Echo_msg) {
  match msg {
    case imm m Echo_msg.Hear {self.hear(m.n);}
  }
}

struct Echo {
  st +arc-opaq Echo_state;

  pub fn start() Echo {
    Echo[actors.startActor[Echo_state, Echo_msg](Echo_state.made(), &Echo_dispatch)];
  }
  pub fn hear(self &, n u64) {
    actors.send[Echo_state, Echo_msg](st, Echo_msg.Hear[n]);
  }
}

fn main() {
  imm e = Echo.start();
  imm rt = actors.startWith(actors.Options[workers: 2u32]);
  e.hear(1u64);
  rt.finish();
  printStr("sent while running, and finished\n");
  e.hear(2u64);
  printStr("not reached\n");
}
