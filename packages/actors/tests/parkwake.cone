// The park word's mark (THE PARK WORD, NO WAKE IS LOST, in the package's
// header), forced rather than raced. One worker. Twenty times:
//
// - the test hook is armed at its second place (holdNextPark(2u32)) and a
//   message from main wakes the worker; it runs the message, spins, finds
//   nothing, publishes itself a sleeper, looks, finds nothing, and is held
//   before its wait (or, when it was on its way to park already as the hook
//   was armed, it is held there before it runs the first message);
// - main sends a second message: notify chooses the held worker, the only
//   one published, and marks it NOTIFIED before waking a word nobody waits on
//   yet; nothing more is handled while the worker is held (checked);
// - the worker is released: its wait finds the word not PARKED and returns
//   at once, and the message is handled within 2 s.
//
// Without the mark read by the wait (the word stored PARKED again just before
// it, say) the worker would sleep with the message queued: the check that it
// is handled within 2 s stops the test there.
//
// Then, with the worker asleep, its park word is woken fifty times with no
// mark (pokeParked, a test hook): each such return finds the word still
// PARKED and sleeps again at once (stats' reparks), with no spin and no park
// of its own, and nothing runs.

mod parkwake;

import testing use *;
import actors;
import thread;
import time;

const rounds = 20u64;

let handled: Atomic[u64];

fn @initpure init() {
  handled = Atomic[u64].of(0u64);
}

actor Counter {
  pub async fn bump(self) {
    handled.add(1u64);
  }
}

fn nowNs() u64 {u64.from(time.Instant.now().nanos())}

// Wait until 'handled' reaches n, for at most 2 s: whether it did
fn handledBy(n: u64) bool {
  let deadline = nowNs() + 2000000000u64;
  while handled.load() < n && nowNs() < deadline {
    thread.yieldNow();
  }
  handled.load() >= n
}

fn main() i32 {
  initAll();
  actors.configure(actors.Options(workers: 1u32));
  {
    let c = Counter();
    actors.waitUntilIdle();
    var held = 0u64;
    var waited = 0u64;
    var taken = 0u64;
    var k = 0u64;
    while k < rounds {
      let before = handled.load();
      actors.holdNextPark(2u32);
      c.bump();
      let deadline = nowNs() + 2000000000u64;
      while !actors.parkHeld() && nowNs() < deadline {
        thread.yieldNow();
      }
      require(actors.parkHeld(), "the worker is held between its look and its wait, within 2 s");
      held = held + 1u64;
      let atHold = handled.load();
      c.bump();
      thread.sleep(time.Duration.fromMillis(2i64));
      if handled.load() == atHold {
        waited = waited + 1u64;
      }
      actors.releasePark();
      require(handledBy(before + 2u64), "the message whose notify marked the held worker is handled within 2 s of its release: the wait read the mark");
      taken = taken + 1u64;
      k = k + 1u64;
    }
    expectUInt(held, rounds, "every round held the worker between its look and its wait");
    expectUInt(waited, rounds, "every round's second message waited while the worker was held");
    expectUInt(taken, rounds, "every round's second message handled after the release");

    // Unmarked returns: the worker asleep, its word woken with no mark
    thread.sleep(time.Duration.fromMillis(20i64));
    let a = actors.stats();
    let h0 = handled.load();
    var p = 0u32;
    while p < 50u32 {
      actors.pokeParked();
      thread.sleep(time.Duration.fromMillis(1i64));
      p = p + 1u32;
    }
    thread.sleep(time.Duration.fromMillis(20i64));
    let b = actors.stats();
    expect(b.reparks - a.reparks >= 40u64, "unmarked wakes of the park word: the worker slept again (40 or more reparks of 50 pokes)");
    expectUInt(b.spins, a.spins, "...with no spin");
    expectUInt(b.parks, a.parks, "...and no new park: it never left the one it was in");
    expectUInt(handled.load(), h0, "...and nothing ran");
  }
  finalAll();
  expectUInt(handled.load(), 2u64 * rounds, "every message handled");
  done()
}
