// An actor's 'final' that sends a message, run once the runtime has stopped,
// is refused (THE STOP'S GATE, actors.cone): nothing would ever run the
// message, and the send drops it quietly, with no panic and nothing queued.
// Main holds the handles past finalAll(), which stopped the workers, so the
// Leaver's final, run when main returns and lets the last handle go, sends to
// the Sink on a stopped runtime. The program ends normally.

mod finalsend;

import stdio use *;
import actors;

actor Sink {
  n: u64 = 0u64;

  pub async fn hear(self, x: u64) {
    n = n + x;
  }
}

actor Leaver {
  peer: Option[Sink];

  fn init(self: &new) {
    *self = Self(None[Sink]);
  }

  pub async fn meet(self, p: Sink) {
    peer = Some[Sink](p);
  }

  fn final(self: &uni) {
    match peer {
      case let Some(p) {p.hear(1u64);}
      case is None[Sink] {}
    }
  }
}

fn main() {
  initAll();
  actors.configure(actors.Options(workers: 2u32));
  let s = Sink();
  let l = Leaver();
  l.meet(s);
  finalAll();
  printStr("stopped; main returns, dropping the handles\n");
}
