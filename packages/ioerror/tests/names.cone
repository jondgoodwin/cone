// The words of an I/O error kind, every variant: what a person is told. Pinned so
// the text cannot drift when the way it is asked for changes.

mod names;

import testing use *;
import collections use String;
import ioerror use *;

fn kind(k: IoErrorKind, want: &str, label: &str) {
  expectStr((String() <- toText(&k)).view(), want, label);
}

fn main() i32 {
  kind(IoErrorKind.NotFound, "not found", "NotFound");
  kind(IoErrorKind.PermissionDenied, "permission denied", "PermissionDenied");
  kind(IoErrorKind.AlreadyExists, "already exists", "AlreadyExists");
  kind(IoErrorKind.NotADirectory, "not a directory", "NotADirectory");
  kind(IoErrorKind.IsADirectory, "is a directory", "IsADirectory");
  kind(IoErrorKind.DirectoryNotEmpty, "directory not empty", "DirectoryNotEmpty");
  kind(IoErrorKind.ReadOnlyFilesystem, "read-only filesystem", "ReadOnlyFilesystem");
  kind(IoErrorKind.StorageFull, "storage full", "StorageFull");
  kind(IoErrorKind.FileTooLarge, "file too large", "FileTooLarge");
  kind(IoErrorKind.InvalidFilename, "invalid filename", "InvalidFilename");
  kind(IoErrorKind.CrossesDevices, "crosses devices", "CrossesDevices");
  kind(IoErrorKind.ResourceBusy, "resource busy", "ResourceBusy");
  kind(IoErrorKind.ConnectionRefused, "connection refused", "ConnectionRefused");
  kind(IoErrorKind.ConnectionReset, "connection reset", "ConnectionReset");
  kind(IoErrorKind.ConnectionAborted, "connection aborted", "ConnectionAborted");
  kind(IoErrorKind.NotConnected, "not connected", "NotConnected");
  kind(IoErrorKind.AddressInUse, "address in use", "AddressInUse");
  kind(IoErrorKind.AddressNotAvailable, "address not available", "AddressNotAvailable");
  kind(IoErrorKind.HostUnreachable, "host unreachable", "HostUnreachable");
  kind(IoErrorKind.NetworkUnreachable, "network unreachable", "NetworkUnreachable");
  kind(IoErrorKind.NetworkDown, "network down", "NetworkDown");
  kind(IoErrorKind.BrokenPipe, "broken pipe", "BrokenPipe");
  kind(IoErrorKind.TimedOut, "timed out", "TimedOut");
  kind(IoErrorKind.Cancelled, "cancelled", "Cancelled");
  kind(IoErrorKind.Truncated, "truncated", "Truncated");
  kind(IoErrorKind.InvalidInput, "invalid input", "InvalidInput");
  kind(IoErrorKind.OutOfMemory, "out of memory", "OutOfMemory");
  kind(IoErrorKind.Unsupported, "unsupported", "Unsupported");
  kind(IoErrorKind.Other, "other", "Other");
  done()
}
