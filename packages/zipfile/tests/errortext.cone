// The one line each error of this package gives a person is pinned here, with
// the number fields at their widest, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import zipfile use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- ZipError.make(ErrorKind.NotZip, 7u64, "these bytes are not a zip file"), "these bytes are not a zip file", "reason only");
  done()
}
