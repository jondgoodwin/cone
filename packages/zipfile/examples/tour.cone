// Writing a small archive in memory, listing it, reading one entry by name, streaming another a few
// bytes at a time, and extracting everything under a folder.
//
//   congo run examples/tour.cone

mod tour;

import stdio use *;
import collections use *;
import zipfile;
import path use Path;

fn main() i32 {
  // Write: two entries, one deflated (the default) and one stored, and a folder
  var w = zipfile.ZipWriter.make();
  w.add("notes/hello.txt", "Hello from a zip file. Hello from a zip file. Hello from a zip file.\n", &zipfile.EntryOptions.plain());
  w.add("notes/raw.bin", "stored as it is", &zipfile.EntryOptions.stored());
  w.addDir("notes/empty", &zipfile.EntryOptions.plain());
  var bytes = List[u8].empty();
  match w.bytes() {
    case let Ok(ok) { bytes = ok; }
    case let Err(e) { printStr(e.reason.view()); return 1i32; }
  }
  printInt(i64.from(bytes.len()));
  printStr(" bytes of archive\n");

  // Read: the directory first, then one entry by name
  match zipfile.Archive.open(bytes.view()) {
    case let Err(e) { printStr(e.reason.view()); return 1i32; }
    case let Ok(ar) {
      var i = 0usize;
      while i < ar.count() {
        let e = ar.entry(i);
        printStr(e.name.view());
        printStr("  ");
        printStr(e.methodName().view());
        printStr("  ");
        printInt(i64.from(e.size));
        printStr(" -> ");
        printInt(i64.from(e.compressedSize));
        printStr("\n");
        i += 1usize;
      }
      match ar.readNamed(bytes.view(), "notes/hello.txt") {
        case let Ok(text) { printStr(String.fromBytes(text.view()).view()); }
        case let Err(e) { printStr(e.reason.view()); return 1i32; }
      }

      // Stream: five bytes a pull, however big the entry is
      match ar.reader(bytes.view(), 1usize) {
        case var Ok(r) {
          var piece = List[u8].empty();
          var s = zipfile.Status.MoreOutput;
          while s == zipfile.Status.MoreOutput {
            piece.clear();
            s = r.pull(bytes.view(), &mut piece, 5usize);
            printStr("[");
            printStr(String.fromBytes(piece.view()).view());
            printStr("]");
          }
          printStr("\n");
        }
        case let Err(e) { printStr(e.reason.view()); return 1i32; }
      }

      // Extract: every name is checked first, and one that would leave the folder refuses the lot
      match ar.extractAll(bytes.view(), &Path.from("tour-out"), &zipfile.ExtractOptions.safe()) {
        case let Ok(got) {
          printInt(i64.from(got.files));
          printStr(" files extracted under tour-out\n");
        }
        case let Err(e) { printStr(e.reason.view()); return 1i32; }
      }
    }
  }
  0i32
}
