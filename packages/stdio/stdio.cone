// stdio's include file, written by hand: what a program importing stdio is
// compiled against in place of stdio's source (src/stdio.cone). Congo names it
// in the program's build description. Everything stdio's object defines -- the
// global 'print' and IOStream's methods -- is declared 'extern', without a body
// or a value, and spelled with stdio's Cone name, the one that object exports.
// The C functions are conestd's, spelled as C spells them.
//
// Keep it in step with src/stdio.cone: a declaration here that the source no
// longer defines is a link error in every program that uses it.

mod stdio;

pub extern {
  fn @c printStr(str &[]u8);
  fn @c printCStr(str *u8);
  fn @c printFloat(a f64);
  fn @c printInt(a i64);
  fn @c printUInt(a u64);
  fn @c printChar(code u64);
}

pub struct IOStream {
  pub fd i32;
  pub extern fn appendStr overload `<-`(self &mut, str &[]u8);
  pub extern fn appendCStr overload `<-`(self &mut, str *u8);
  pub extern fn appendInt overload `<-`(self &mut, i i64);
  pub extern fn appendFloat overload `<-`(self &mut, n f64);
  pub extern fn appendUInt overload `<-`(self &mut, i u64);
}

pub extern mut print IOStream;
