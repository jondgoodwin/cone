// Every kind of value, at the edges of how each is spelled, to each stream:
// here standard output, and in values.err standard error, the same text.
// Integers at their extremes; floats as C's '%g' spells them, an infinity as
// "inf" and every NaN as "nan" (its sign is not written); each code point at the
// edges of UTF-8's one to four bytes, and the two that write nothing (NUL,
// and one past U+10FFFF); a C string, and a null one.

mod values;

import stdio use *;

fn ints(err: bool) {
  let vals = Array[i64, 9]() <- 0i64, 1i64, -1i64, 9i64, 10i64, -10i64,
    9223372036854775807i64, -9223372036854775807i64 - 1i64, 1234567890123i64;
  var i = 0usize;
  while i < 9usize {
    if err {eprintInt(vals[i]); eprintStr(" ");} else {printInt(vals[i]); printStr(" ");}
    i = i + 1usize;
  }
  let uvals = Array[u64, 5]() <- 0u64, 1u64, 18446744073709551615u64,
    9223372036854775808u64, 1000000u64;
  i = 0usize;
  while i < 5usize {
    if err {eprintUInt(uvals[i]); eprintStr(" ");} else {printUInt(uvals[i]); printStr(" ");}
    i = i + 1usize;
  }
}

fn floats(err: bool) {
  let zero = 0.0;
  let vals = Array[f64, 22]() <- 0.0, -0.0, 1.0, -1.5, 0.1, 1e300, -1e-300,
    123456.0, 1234567.0, 0.0001, 0.00001, 3.14159265358979, 2.5e-310,
    1.0 / zero, -1.0 / zero, zero / zero, -(zero / zero), 999999.5, 9999995.0,
    100000.0, 1e100, 5e-324;
  var i = 0usize;
  while i < 22usize {
    if err {eprintFloat(vals[i]); eprintStr(" ");} else {printFloat(vals[i]); printStr(" ");}
    i = i + 1usize;
  }
}

fn chars(err: bool) {
  let vals = Array[u64, 14]() <- 65u64, 0u64, 0x7Fu64, 0x80u64, 0x7FFu64, 0x800u64,
    0xFFFFu64, 0x10000u64, 0x10FFFFu64, 0x110000u64, 0xFFFFFFFFFFFFFFFFu64, 0xE9u64,
    0x20ACu64, 0x1F600u64;
  var i = 0usize;
  while i < 14usize {
    if err {eprintChar(vals[i]); eprintStr("|");} else {printChar(vals[i]); printStr("|");}
    i = i + 1usize;
  }
}

fn main() {
  printStr("ints: "); ints(false); printStr("\n");
  printStr("floats: "); floats(false); printStr("\n");
  printStr("chars: "); chars(false); printStr("\n");
  printCStr(&"a C string, then a null one: " as *u8);
  printCStr(0usize as *u8);
  printStr("\n");
  eprintStr("ints: "); ints(true); eprintStr("\n");
  eprintStr("floats: "); floats(true); eprintStr("\n");
  eprintStr("chars: "); chars(true); eprintStr("\n");
  eprintCStr(&"a C string, then a null one: " as *u8);
  eprintCStr(0usize as *u8);
  eprintStr("\n");
}
