// The stdio package: printing to standard output and standard error. A
// program reaches it with 'import stdio'. Built by Congo, the package is
// compiled on its own into an object, and that compile generates its include
// file from this source, which a program is compiled against; the object is
// where 'print' and IOStream's methods are defined. Found by a compile on the
// package search path instead, this source is compiled into the program's own
// object.
//
// The printing itself is conestd's, the runtime every program links
// (packages/conestd/stdio.cone), declared here with 'extern' (defined
// elsewhere) and '@c' (spelled as conestd, a C-named module, spells it: stdio
// is a Cone-named module, so without '@c' each would take stdio's Cone name).
//
// Two streams, each a variable and a set of functions: 'print <- x' and the
// 'print' functions write to standard output, 'eprint <- x' and the 'eprint'
// functions to standard error, the same text either way.
//
// A send statement is one record. 'print <- "x=", x, "\n"' writes its pieces
// into a writer (core's TextOut) that the statement owns, and hands the
// finished record to the console as one piece, so output from several threads
// never tears a record: another thread's record comes before or after, whole.
// A value that can be sent has a 'toText(self: &, out: &uni TextOut)' method
// that writes its text with 'out <- ...'; numbers, bool, char and text have one
// of their own, so 'print <- x' works for any type that has it, and the
// compiler refuses a type that has none.
//
// Both streams are two outputs of one console: the stream is a tag on the
// record, so what is printed and what is eprinted stay in the order sent.
// Standard output is written at once if it is a terminal, and held in the
// console's own buffer if it is a file or a pipe, until the buffer fills, or
// standard error writes, or the program flushes ('print.flush()') or ends.
// Standard error is written at once. The buffer is the console's, not the C
// library's: a C function that prints with printf has its text in C's buffer,
// which C writes at its own times.
//
// In a program that runs actors the console's writing passes to an owner, a
// thread of the actors package's, installed in the console's engine slot when
// the runtime starts (this package imports nothing of actors): a finished
// record moves to it and the sender goes on, and print.flush() waits until all
// that was sent has been written.
//
// Standard input is read by three methods of the value 'stdin', for a program with no actors (a
// tool, a filter, a script):
//
//   stdin.readLine(&mut line)   the next line into a String, without its '\n' or '\r\n';
//                               Ok(false) at the end of the input, nothing read
//   stdin.readAll()             everything that is left, as a String
//   stdin.readBytes(&mut buf)   up to buf.len bytes into an array: how many, 0 at the end
//
// 'readLine' and 'readAll' put the bytes they read into a String as they came: input that is not
// UTF-8 makes a String that is not, so a program that cannot trust its input reads with 'readBytes'.
// A failure is the IoErrorKind of the system's error (ioerror's kinds, the same on every system). It is
// an IoErrorKind and not iocore's IoError because iocore imports diag, and diag imports stdio: stdio
// importing iocore would be a cycle.
// A last line with no '\n' is a line. A read is of standard input's own handle: nothing in the C
// runtime's text mode touches it (no '\r' dropped, no 0x1A that ends the input), and on a Windows
// console the text arrives as UTF-8 whatever the console's code page.
//
// THESE CALLS BLOCK THE THREAD until input arrives or ends. An actor's behaviour must not call them: it
// would hold a worker while it waits (a read that reaches an actor program is another job, which
// is not built yet). They take no console lock, so a read that waits stops no printing. One buffer, in
// conestd, sits over the read, so what follows a line waits for the next call; do not mix these
// with C's own 'stdin' (libc.fread) in one program. Two threads that read take turns, and which line
// each gets is the order they came.

mod stdio;

import collections use String;
import ioerror use IoErrorKind, osKind;

// Standard input: up to n bytes into p, or an error number made negative; 'line' not 0 stops at the
// first '\n' (conestd's stdio.cone)
extern fn @c cone_stdinChunk(p: *u8, n: usize, line: i32) i64;

// The next line of standard input into 'line', replacing what it held, without its line end ('\n' or
// '\r\n'). False, with 'line' empty, at the end of the input. A last line with no '\n' is a line.
fn lineIn(line: &mut String) Result[bool, IoErrorKind] {
  line.clear();
  var tmp = Array[u8, 4096]() <- fill 0u8;
  let tp: *u8 = &[]tmp as *u8;
  var any = false;
  var ended = false;
  var going = true;
  while going {
    let got = cone_stdinChunk(tp, 4096usize, 1i32);
    if got < 0i64 { return Err[bool, IoErrorKind](osKind(u32.from(0i64 - got))); }
    if got == 0i64 { going = false; }
    else {
      any = true;
      let n = usize.from(got);
      line.appendBytes(mem.sliceFromParts(tp, n));
      if *(tp + (n - 1usize)) == 10u8 { ended = true; going = false; }
    }
  }
  if !any { return Ok[bool, IoErrorKind](false); }
  if ended {
    var keep = line.len() - 1usize;
    if keep > 0usize && line[keep - 1usize] == 13u8 { keep = keep - 1usize; }
    line.truncate(keep);
  }
  Ok[bool, IoErrorKind](true)
}

// All that is left of standard input, as a String (empty at the end of the input)
fn allIn() Result[String, IoErrorKind] {
  var out = String();
  var tmp = Array[u8, 65536]() <- fill 0u8;
  let tp: *u8 = &[]tmp as *u8;
  var going = true;
  while going {
    let got = cone_stdinChunk(tp, 65536usize, 0i32);
    if got < 0i64 { return Err[String, IoErrorKind](osKind(u32.from(0i64 - got))); }
    if got == 0i64 { going = false; }
    else { out.appendBytes(mem.sliceFromParts(tp, usize.from(got))); }
  }
  Ok[String, IoErrorKind](out)
}

// Up to buf.len bytes of standard input into 'buf', waiting for at least one: how many, 0 at the end of
// the input (and for an empty 'buf')
fn bytesIn(buf: &mut Array[u8]) Result[usize, IoErrorKind] {
  let got = cone_stdinChunk(buf as *u8, buf.len, 0i32);
  if got < 0i64 { return Err[usize, IoErrorKind](osKind(u32.from(0i64 - got))); }
  Ok[usize, IoErrorKind](usize.from(got))
}

// Standard input, as 'stdin.readLine(&mut line)', 'stdin.readAll()' and 'stdin.readBytes(&mut buf)'. It
// keeps nothing itself (conestd holds the buffer), so its methods take 'self: &' and 'stdin' is 'imm'.
pub struct Stdin {
  pub fd: i32;
  // The next line into 'line', replacing what it held, without its line end ('\n' or '\r\n'). Ok(false),
  // with 'line' empty, at the end of the input. A last line with no '\n' is a line.
  pub fn readLine(self: &, line: &mut String) Result[bool, IoErrorKind] { lineIn(line) }
  // All that is left, as a String (empty at the end of the input)
  pub fn readAll(self: &) Result[String, IoErrorKind] { allIn() }
  // Up to buf.len bytes into 'buf', waiting for at least one: how many, 0 at the end of the input (and
  // for an empty 'buf')
  pub fn readBytes(self: &, buf: &mut Array[u8]) Result[usize, IoErrorKind] { bytesIn(buf) }
}

pub let stdin = Stdin(0i32);

// Standard output
pub extern {
  fn @c printStr(str: &str);
  fn @c printCStr(str: *u8);
  fn @c printFloat(a: f64);
  fn @c printInt(a: i64);
  fn @c printUInt(a: u64);
  fn @c printChar(code: u64);
  // Write out what the console holds, and what the C library holds for standard output
  fn @c printFlush();
}

// Standard error
pub extern {
  fn @c eprintStr(str: &str);
  fn @c eprintCStr(str: *u8);
  fn @c eprintFloat(a: f64);
  fn @c eprintInt(a: i64);
  fn @c eprintUInt(a: u64);
  fn @c eprintChar(code: u64);
  fn @c eprintFlush();
}

// The console takes a finished record away
extern fn @c consoleDeliver(record: &uni TextOut);

// A stream to print to: 'fd' is its POSIX number, 1 for standard output and
// 2 for standard error. It keeps nothing it writes, since the console holds
// that, so its methods take 'self: &' and 'print' and 'eprint' are 'imm':
// every thread appends to them.
pub struct IOStream {
  pub fd: i32;
  // One text sent alone is one record, written without a writer. (A send of
  // several pieces, or of anything but a text, is the compiler's bracket:
  // 'record' below.)
  pub fn appendStr overload `<-`(self: &, str: &str) {if fd == 2i32 {eprintStr(str);} else {printStr(str);}}
  // A C string, by name and not through '<-': a cstr promises the zero that ends
  // it, which a raw pointer or a borrow of one byte does not. ('<-' cannot take
  // it, since a literal is both a &str and a cstr and no ranking picks one.) For
  // the text of a cstr through '<-', 'print <- c.view()'.
  pub fn appendCStr(self: &, str: cstr) {if fd == 2i32 {eprintCStr(str.ptr());} else {printCStr(str.ptr());}}
  // The writer a send statement writes its pieces into: a record of this
  // stream, which is handed to the console as one piece when the writer dies
  // (a statement's end). The compiler calls this for 'print <- a, b, c'; a
  // record held across statements is 'var rec = print.record()', sent to with
  // '<-' like any writer, and delivered at its scope's end.
  pub fn record(self: &) TextOut {
    TextOut.record(&consoleDeliver as usize, null, u32.from(fd))
  }
  // Write out what the console holds, and what the C library holds
  pub fn flush(self: &) {if fd == 2i32 {eprintFlush();} else {printFlush();}}
}

pub let print = IOStream(1i32);
pub let eprint = IOStream(2i32);
