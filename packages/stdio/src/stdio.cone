// The stdio package: printing to standard output. A program reaches it with
// 'import stdio'. Built by Congo, the package is compiled on its own into an
// object, and a program is compiled against its hand-written include file,
// stdio.cone at the package root; that object is where 'print' and IOStream's
// methods are defined. Found by a compile on the package search path instead,
// this source is compiled into the program's own object.
//
// The printing itself is C, in packages/conestd/stdio.c, declared here with
// 'extern' (defined elsewhere) and '@c' (spelled as C spells it: stdio is a
// Cone-named module, so without '@c' each would take stdio's Cone name).

mod stdio;

pub extern {
  fn @c printStr(str &[]u8);
  fn @c printCStr(str *u8);
  fn @c printFloat(a f64);
  fn @c printInt(a i64);
  fn @c printUInt(a u64);
  fn @c printChar(code u64);
}

pub struct IOStream {
  pub fd i32;
  pub fn appendStr overload `<-`(self &mut, str &[]u8) {printStr(str);}
  pub fn appendCStr overload `<-`(self &mut, str *u8) {printCStr(str);}
  pub fn appendInt overload `<-`(self &mut, i i64) {printInt(i);}
  pub fn appendFloat overload `<-`(self &mut, n f64) {printFloat(n);}
  pub fn appendUInt overload `<-`(self &mut, i u64) {printUInt(i);}
}

pub mut print = IOStream[0];
