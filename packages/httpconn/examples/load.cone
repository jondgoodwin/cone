// A loopback load test of the driver, timed. Run it with
//
//   congo run --release packages/httpconn/examples/load.cone
//
// On Linux, raise the descriptor limit first (ulimit -n 65536): part 2's few
// thousand connections, both ends in this process, are more than the default
// 1,024. "Private bytes" there are the process's data size (VmData),
// Windows' PrivateUsage here.
//
// 1. Many concurrent kept-alive connections, each making GETs one after
//    another (no pipelining, as HTTP/1.1 clients do), each answered with a
//    64-byte body: the requests a second, and each request's latency from
//    being asked for to its Done, p50, p99 and the maximum. Run twice: the
//    server and the clients on one thread, one Loop and one Driver; then
//    the server on a thread of its own, its own Loop and Driver.
// 2. Memory per idle connection: a few thousand kept-alive connections
//    left idle, and what the process's private bytes and the pool's buffers
//    grew by, per connection (both its ends: a client's and a server's, in
//    this one process); once as the driver is by default, each idle
//    connection waiting with a zero-byte receive, and once with
//    idleRecvReady off, each holding a receive buffer instead.
//
// Every connection is on 127.0.0.1 (never 0.0.0.0, so the firewall is never
// asked). Connections are opened a batch at a time, within the listener's
// backlog.

mod load;

import stdio use *;
import libc;
import thread;
import sync use *;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, SocketAddr, forever;
import diag use Histogram;
import http use *;
import httpconn use *;

extern {
  fn @c(system) GetCurrentProcess() usize;
  fn @c(system) K32GetProcessMemoryInfo(process: usize, counters: *u8, cb: u32) i32;
}

const tokServer = 0x10000000u64;      // the server's sink
const tokConn = 0x20000000u64;        // a client connection's: + its number
const tokReq = 0x30000000u64;         // a request's: + its connection's number

// The bytes the process has committed for itself: Windows' PrivateUsage
// (PROCESS_MEMORY_COUNTERS_EX), Linux's data size (VmData)
fn privateBytes() u64 {
  if isWindows() {
    var c = Array[usize, 10]() <- fill 0usize;
    let p = &mut c as *u8;
    *(p as *u32) = 80u32;
    K32GetProcessMemoryInfo(GetCurrentProcess(), p, 80u32);
    u64.from(c[9usize])
  } else {
    dataBytes()
  }
}

// Linux: the sixth number of /proc/self/statm (size resident shared text lib
// data dt), in 4096-byte pages: the process's writable private memory
fn dataBytes() u64 {
  let f = libc.fopen("/proc/self/statm", "rb");
  if f == null {return 0u64;}
  var buf = Array[u8, 256]() <- fill 0u8;
  let bp: *u8 = &[]buf as *u8;
  let n = libc.fread(bp, 1usize, 255usize, f);
  libc.fclose(f);
  var field = 0u32;
  var value = 0u64;
  var k = 0usize;
  while k < n {
    let c = buf[k];
    if c >= '0' && c <= '9' {
      if field == 5u32 {value = value * 10u64 + u64.from(c - '0');}
    } else {
      field = field + 1u32;
    }
    k = k + 1usize;
  }
  value * 4096u64
}

// Answer a server's request: 200 and 64 bytes
fn answer(drv: &mut Driver, e: &mut Event, pool: &Pool) {
  drv.respond(e.req, ResponseHead.make(200u16), BodyLength.sized(64u64));
  var b = pool.mustTake(64usize);
  b.setLen(64usize);
  drv.sendData(e.req, b);
  drv.finish(e.req);
}

// The listening driver's port
fn listenOn(drv: &mut Driver, lp: &mut Loop) u16 {
  var port = 0u16;
  match drv.listen(lp, SocketAddr.localhost(0u16), Sink.Here(tokServer)) {
    case let Ok(r) {
      match drv.localAddr(lp, r) {
        case let Ok(a) {port = a.port();}
        case let Error(e) {}
      }
    }
    case let Error(e) {}
  }
  port
}

// ---------------------------------------------------------------------------
// The clients: open conns connections, a batch at a time; make perConn GETs
// on each, one after another; time each
// ---------------------------------------------------------------------------

struct Run {
  pub conns: u64;
  pub perConn: u64;
  pub lat: Histogram;
  pub done: u64;
  pub bad: u64;
  pub took: Duration;
}

fn clients(drv: &mut Driver, lp: &mut Loop, pool: &Pool, port: u16, conns: u64, perConn: u64, serveHere: bool) Run {
  var run = Run(conns, perConn, Histogram.make(), 0u64, 0u64, Duration.zero());
  var cs = List[ConnId].empty();
  var made = List[u64].empty();
  var busy = List[bool].empty();
  var connected = 0u64;
  var events = List[Event].empty();
  let batch = 64u64;
  var t0 = Instant.now();
  var started = false;
  var finished = 0u64;
  while finished < conns {
    // More connections, a batch at a time
    if u64.from(cs.len()) < conns && u64.from(cs.len()) < connected + batch {
      let k = u64.from(cs.len());
      cs.push(drv.connect(lp, "127.0.0.1", port, Sink.Here(tokConn + k)));
      made.push(0u64);
      busy.push(false);
      continue;
    }
    if !started && connected == conns {
      started = true;
      t0 = Instant.now();
    }
    // Each free connection's next request, once all are connected
    if started {
      var k = 0usize;
      while k < cs.len() {
        if !*busy[k] && *made[k] < perConn {
          drv.request(lp, *cs[k], RequestHead.get("/x", "127.0.0.1"), BodyLength.empty(),
            Sink.Here(tokReq + u64.from(k)));
          busy.set(k, true);
          made.set(k, *made[k] + 1u64);
        }
        k = k + 1usize;
      }
    }
    drv.poll(lp, forever(), &mut events);
    var j = 0usize;
    while j < events.len() {
      let e = &mut events[j];
      j = j + 1usize;
      if e.token == tokServer {
        if serveHere && e.kind == EventKind.Request {answer(drv, e, pool);}
      } else if e.token >= tokReq {
        let k = usize.from(e.token - tokReq);
        if e.kind == EventKind.Data {
          drv.release(e.req, e.buf.len());
        } else if e.kind == EventKind.Done {
          run.lat.record((e.timing.ended - e.timing.submitted).nanos());
          run.done = run.done + 1u64;
          busy.set(k, false);
          if *made[k] == perConn {finished = finished + 1u64;}
        } else if e.isTerminal() {
          run.bad = run.bad + 1u64;
          busy.set(k, false);
          if *made[k] == perConn {finished = finished + 1u64;}
        }
      } else if e.token >= tokConn {
        if e.kind == EventKind.Connected {connected = connected + 1u64;}
        else if e.kind == EventKind.Closed && !started {
          run.bad = run.bad + 1u64;
          connected = connected + 1u64;
        }
      }
    }
    events.clear();
  }
  run.took = Instant.now() - t0;
  // Close them all, and let the closes finish
  var k = 0usize;
  while k < cs.len() {
    drv.close(lp, *cs[k]);
    k = k + 1usize;
  }
  let until = Instant.now() + Duration.fromSeconds(5i64);
  while drv.live() > 0u32 && Instant.now() < until {
    drv.poll(lp, until, &mut events);
    events.clear();
  }
  run
}

fn report(label: &str, r: &Run) {
  printStr(label);
  printStr(": ");
  printUInt(r.conns);
  printStr(" connections x ");
  printUInt(r.perConn);
  printStr(" GETs: ");
  printUInt(r.done);
  printStr(" done in ");
  printUInt(u64.from(r.took.millis()));
  printStr(" ms, ");
  if r.took.nanos() > 0i64 {printUInt(u64.from(i64.from(r.done) * 1000000000i64 / r.took.nanos()));}
  printStr(" requests/s");
  if r.bad > 0u64 {
    printStr(", ");
    printUInt(r.bad);
    printStr(" NOT DONE");
  }
  printStr("\n  ");
  r.lat.printLine("latency, asked to Done");
}

// ---------------------------------------------------------------------------
// A server on a thread of its own
// ---------------------------------------------------------------------------

struct ServerArgs {
  pub portTx: Sender[u16];
  pub stop: Arc[imm, Atomic[bool]];
}

fn serve(a: ServerArgs) u64 {
  let pool = Pool.make();
  var lp = Loop.mustMake();
  var drv = Driver.make(Config.make(), pool);
  a.portTx.send(listenOn(&mut drv, &mut lp));
  var events = List[Event].empty();
  var served = 0u64;
  while !a.stop.load() {
    drv.poll(&mut lp, Instant.now() + Duration.fromMillis(50i64), &mut events);
    var j = 0usize;
    while j < events.len() {
      let e = &mut events[j];
      if e.kind == EventKind.Request {
        answer(&mut drv, e, &pool);
        served = served + 1u64;
      }
      j = j + 1usize;
    }
    events.clear();
  }
  drv.abortAll(&mut lp);
  served
}

// ---------------------------------------------------------------------------
// Memory per idle connection
// ---------------------------------------------------------------------------

fn idleMemory(n: u64, readyIdle: bool) {
  let pool = Pool.make(268435456usize, 268435456usize);
  var lp = Loop.mustMake();
  var cfg = Config.make();
  cfg.idleRecvReady = readyIdle;
  cfg.acceptDepth = 64u32;
  var drv = Driver.make(cfg, pool);
  let port = listenOn(&mut drv, &mut lp);
  // Warm: the tables and the pool's first blocks
  {
    var w = clients(&mut drv, &mut lp, &pool, port, 64u64, 1u64, true);
  }
  pool.trim();
  let before = privateBytes();
  let heldBefore = pool.stats().heldBytes - pool.stats().idleBytes;
  // n connections, one GET each, then left idle
  var cs = List[ConnId].empty();
  var connected = 0u64;
  var dones = 0u64;
  var failed = 0u64;
  var events = List[Event].empty();
  while dones + failed < n {
    if u64.from(cs.len()) < n && u64.from(cs.len()) < connected + 64u64 {
      let k = u64.from(cs.len());
      let c = drv.connect(&mut lp, "127.0.0.1", port, Sink.Here(tokConn + k));
      drv.request(&mut lp, c, RequestHead.get("/x", "127.0.0.1"), BodyLength.empty(), Sink.Here(tokReq + k));
      cs.push(c);
      continue;
    }
    drv.poll(&mut lp, forever(), &mut events);
    var j = 0usize;
    while j < events.len() {
      let e = &mut events[j];
      j = j + 1usize;
      if e.token == tokServer && e.kind == EventKind.Request {answer(&mut drv, e, &pool);}
      else if e.kind == EventKind.Data {drv.release(e.req, e.buf.len());}
      else if e.kind == EventKind.Connected {connected = connected + 1u64;}
      else if e.token >= tokReq && e.kind == EventKind.Done {dones = dones + 1u64;}
      else if e.token >= tokReq && e.isTerminal() {failed = failed + 1u64;}
    }
    events.clear();
  }
  // Settle: every connection idle at both ends
  let settle = Instant.now() + Duration.fromMillis(200i64);
  while Instant.now() < settle {
    drv.poll(&mut lp, settle, &mut events);
    events.clear();
  }
  pool.trim();
  let after = privateBytes();
  let heldAfter = pool.stats().heldBytes - pool.stats().idleBytes;
  printStr("idle connections, ");
  printStr(if readyIdle {"waiting by zero-byte receives (the default)"} else {"each holding a receive buffer"});
  printStr(": ");
  printUInt(n);
  printStr(" open (");
  printUInt(u64.from(drv.live()));
  printStr(" driver connections, both ends; ");
  printUInt(failed);
  printStr(" requests not Done)\n  private bytes +");
  printUInt((after - before) / 1024u64);
  printStr(" KiB: ");
  printUInt((after - before) / n);
  printStr(" bytes a connection (both ends); pool buffers lent +");
  printUInt(u64.from(heldAfter - heldBefore) / 1024u64);
  printStr(" KiB: ");
  printUInt(u64.from(heldAfter - heldBefore) / n);
  printStr(" bytes a connection\n");
  drv.abortAll(&mut lp);
  drv.pump(&mut lp, &mut events);
}

fn main() {
  // 1a. One thread: server and clients on one Loop and one Driver
  {
    let pool = Pool.make();
    var lp = Loop.mustMake();
    var cfg = Config.make();
    cfg.acceptDepth = 64u32;
    var drv = Driver.make(cfg, pool);
    let port = listenOn(&mut drv, &mut lp);
    let r1 = clients(&mut drv, &mut lp, &pool, port, 1u64, 10000u64, true);
    report("one thread", &r1);
    let r2 = clients(&mut drv, &mut lp, &pool, port, 256u64, 200u64, true);
    report("one thread", &r2);
    let r3 = clients(&mut drv, &mut lp, &pool, port, 1000u64, 50u64, true);
    report("one thread", &r3);
  }
  // 1b. Two threads: the server's own
  {
    var portTx: Sender[u16];
    var portRx: Receiver[u16];
    portTx, portRx = Channel[u16].make();
    let stop = Arc[imm, Atomic[bool]](Atomic[bool].of(false));
    let server = thread.start(ServerArgs(portTx, stop), &serve);
    var port = 0u16;
    match portRx.recv() {
      case let Some(p) {port = p;}
      case is None[u16] {}
    }
    let pool = Pool.make();
    var lp = Loop.mustMake();
    var drv = Driver.make(Config.make(), pool);
    let r1 = clients(&mut drv, &mut lp, &pool, port, 1u64, 10000u64, false);
    report("two threads", &r1);
    let r2 = clients(&mut drv, &mut lp, &pool, port, 256u64, 200u64, false);
    report("two threads", &r2);
    let r3 = clients(&mut drv, &mut lp, &pool, port, 1000u64, 50u64, false);
    report("two threads", &r3);
    stop.store(true);
    server.join();
  }
  // 2. Memory per idle connection
  idleMemory(2000u64, true);
  idleMemory(2000u64, false);
}
