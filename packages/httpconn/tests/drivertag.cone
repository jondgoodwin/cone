// Drivers on one Loop never claim each other's completions, however many
// were made between them. A program with two drivers on a loop offers every
// completion to one and then the other ('if not a.complete(c) {b.complete(c)}'),
// so 'complete' must say true of a driver's own operations alone.
//
// Part 1: a server driver made first and kept alive; 127 more made and
// dropped; then a client driver, the 128th after the server's. A GET goes
// from the client to the server over 127.0.0.1, every completion offered to
// the server's driver first. Checked: that the server's driver claimed no
// Connect (only the client submits them), that the request got its one Done
// with the server's body, and that no completion went unclaimed.
//
// Part 2: 1000 drivers alive at once, twice over: every one's tokens are its
// own and no other's.

mod drivertag;

import testing use *;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, Completion, SocketAddr, forever;
import http use *;
import httpconn use *;
import diag;

const tokServer = 100u64;
const tokConn = 1u64;
const tokReq = 2u64;

fn helloBody() &Array[u8] {"hello from the old driver"}

fn main() i32 {
  var lp = Loop.mustMake();

  // The old driver, alive from here to the end
  var srv = Driver.make(Config.make());
  {
    var i = 0u32;
    while i < 127u32 {
      let other = Driver.make(Config.make());
      i = i + 1u32;
    }
  }
  var cli = Driver.make(Config.make());

  var port = 0u16;
  match srv.listen(&mut lp, SocketAddr.localhost(0u16), Sink.Here(tokServer)) {
    case let Ok(r) {
      match srv.localAddr(&lp, r) {
        case let Ok(a) {port = a.port();}
        case let Err(e) {}
      }
    }
    case let Err(e) {}
  }
  require(port != 0u16, "the server listens on a port");
  let conn = cli.connect(&mut lp, "127.0.0.1", port, Sink.Here(tokConn));
  let req = cli.request(&mut lp, conn, RequestHead.get("/hello", "127.0.0.1"), BodyLength.empty(), Sink.Here(tokReq));

  var status = 0u16;
  var body = String.empty();
  var finals = 0u64;
  var finalDone = false;
  var served = 0u64;
  var svReq = ReqId.none();
  var misrouted = 0u64;
  var unclaimed = 0u64;
  var events = List[Event].empty();
  var comps = List[Completion].empty();
  let giveUp = Instant.now() + Duration.fromSeconds(3i64);
  while finals == 0u64 && Instant.now() < giveUp {
    srv.pump(&mut lp, &uni events);
    cli.pump(&mut lp, &uni events);
    var w = srv.wakeAt();
    if cli.wakeAt() < w {w = cli.wakeAt();}
    if events.len() > 0usize {w = Instant();}
    lp.poll(if w < giveUp {w} else {giveUp}, &mut comps);
    var k = 0usize;
    while k < comps.len() {
      let c = &mut comps[k];
      k = k + 1usize;
      // Only the client's driver submits Connects: the server's driver
      // claiming one has taken another driver's operation
      let isConnect = c.kind == diag.kindConnect;
      if srv.complete(&mut lp, c) {
        if isConnect {misrouted = misrouted + 1u64;}
      } else if !cli.complete(&mut lp, c) {
        unclaimed = unclaimed + 1u64;
      }
    }
    comps.clear();
    srv.pump(&mut lp, &uni events);
    cli.pump(&mut lp, &uni events);
    k = 0usize;
    while k < events.len() {
      let e = &mut events[k];
      k = k + 1usize;
      if e.token == tokServer {
        if e.kind == EventKind.Request {
          svReq = e.req;
        } else if e.kind == EventKind.End {
          srv.respond(svReq, ResponseHead.make(200u16), BodyLength.sized(u64.from(helloBody().len)));
          var b = IoBuf(64usize);
          b.append(helloBody());
          srv.sendData(svReq, b);
          srv.finish(svReq);
          served = served + 1u64;
        }
      } else if e.token == tokReq {
        if e.kind == EventKind.Response {
          status = e.response.status;
        } else if e.kind == EventKind.Data {
          body.appendBytes(e.buf.view());
          cli.release(e.req, e.buf.len());
        } else if e.isTerminal() {
          finals = finals + 1u64;
          finalDone = e.kind == EventKind.Done;
        }
      }
    }
    events.clear();
  }
  expectUInt(misrouted, 0u64, "the old driver claimed none of the new one's Connects");
  expectUInt(unclaimed, 0u64, "every completion was claimed by one driver");
  requireUInt(finals, 1u64, "the request got its final answer in time");
  expect(finalDone, "...Done");
  expectInt(i64.from(status), 200i64, "...status 200");
  expectStr(body.view(), helloBody(), "...with the old driver's body");
  expectUInt(served, 1u64, "the old driver read one request");
  cli.abortAll(&mut lp);
  srv.abortAll(&mut lp);
  events.clear();
  expectUInt(stats().lent, 0u64, "every buffer back in the pool");

  // 1000 live drivers, twice (the second time they take the numbers the
  // first gave back): each owns its own tokens, and no other's
  expectUInt(ownership(&mut lp, 1000u32), 0u64, "round 1: 1000 live drivers, each owns its own tokens alone");
  expectUInt(ownership(&mut lp, 1000u32), 0u64, "round 2: the numbers given back are taken again");
  done()
}

// n drivers alive at once: how many (driver, token) pairs went wrong, a
// token not owned by the driver that made it, or owned by another
fn ownership(lp: &mut Loop, n: u32) u64 {
  var ds = List[Driver].empty();
  var i = 0u32;
  while i < n {
    ds.push(Driver.make(Config.make()));
    i = i + 1u32;
  }
  var wrong = 0u64;
  var a = 0usize;
  while a < ds.len() {
    let da = &mut ds[a];
    let t = da.upperToken(lp, 3u8, u64.from(a));
    var b = 0usize;
    while b < ds.len() {
      let db = &mut ds[b];
      let owns = db.owns(t);
      if owns != (a == b) {wrong = wrong + 1u64;}
      b = b + 1usize;
    }
    a = a + 1usize;
  }
  wrong
}
