// A server and a client on one Loop and one Driver, over 127.0.0.1: one
// kept-alive connection carries, in turn, a GET with a sized body, a GET
// answered chunked with trailer fields, a HEAD, a 204, and a POST whose body
// is sent after Writable and echoed back. Checked: every status, body byte
// and trailer; that all five went over the one connection (one connect,
// one accept, five exchanges); that each request had exactly one final
// answer, Done, after its End; that closing the client's connection gives
// it one clean Closed, and the server's sees the end of the stream and
// closes cleanly too; and that every buffer is back in the pool.

mod fetch;

import testing use *;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, SocketAddr, forever;
import http use *;
import httpconn use *;

const tokServer = 100u64;
const tokConn = 1u64;
const tokReq = 2u64;

fn helloBody() &Array[u8] {"hello, world";}
fn postBody() &Array[u8] {"the body of a POST, sent after Writable";}

struct Client {
  pub status u16;
  pub body String;
  pub trailers Headers;
  pub ends u64;
  pub finals u64;
  pub dones u64;
  pub writable u64;
  pub closed u64;
  pub clean bool;
  pub other u64;
}

struct Server {
  pub requests u64;
  pub echo String;
  pub accepted u64;
  pub closed u64;
  pub clean u64;
  pub dones u64;
  pub failures u64;
}

// The server's answer to a request, once read whole
fn answer(drv &mut Driver, req ReqId, target &Array[u8], method Method, echo &Array[u8], pool &Pool) {
  if target == "/hello" {
    drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(u64.from(helloBody().len)));
    if method != Method.Head[] {
      mut b = pool.mustTake(64usize);
      b.append(helloBody());
      drv.sendData(req, b);
      drv.finish(req);
    }
  } elif target == "/chunked" {
    drv.respond(req, ResponseHead.make(200u16), BodyLength.unsized());
    mut a = pool.mustTake(64usize);
    a.append("one,");
    drv.sendData(req, a);
    mut b = pool.mustTake(64usize);
    b.append("two,");
    drv.sendData(req, b);
    mut c = pool.mustTake(64usize);
    c.append("three");
    drv.sendData(req, c);
    mut t = Headers.empty();
    t.add("X-Checksum", "abc123");
    drv.finishWith(req, t);
  } elif target == "/nocontent" {
    drv.respond(req, ResponseHead.make(204u16), BodyLength.empty());
  } else {
    // /echo
    drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(u64.from(echo.len)));
    mut b = pool.mustTake(echo.len);
    b.append(echo);
    drv.sendData(req, b);
    drv.finish(req);
  }
}

fn main() i32 {
  imm pool = Pool.make();
  mut lp = Loop.mustMake();
  mut drv = Driver.make(Config.make(), pool);
  mut port = 0u16;
  mut listener = ListenerId.none();
  match drv.listen(&mut lp, SocketAddr.localhost(0u16), Sink.Here[tokServer]) {
    case imm r Ok {listener = r.value;}
    case imm e Error {}
  }
  match drv.localAddr(&lp, listener) {
    case imm a Ok {port = a.value.port();}
    case imm e Error {}
  }
  require(port != 0u16, "the server listens");
  imm conn = drv.connect(&mut lp, "127.0.0.1", port, Sink.Here[tokConn]);

  mut cl = new Client(0u16, String.empty(), Headers.empty(), 0u64, 0u64, 0u64, 0u64, 0u64, false, 0u64);
  mut sv = new Server(0u64, String.empty(), 0u64, 0u64, 0u64, 0u64, 0u64);
  // What the server is reading, to answer on its End
  mut svTarget = String.empty();
  mut svMethod Method = Method.Get[];
  mut svReq = ReqId.none();

  // The client's requests, one after another
  mut step = 0u32;
  mut req = ReqId.none();
  mut events = List[Event].empty();
  imm giveUp = Instant.now() + Duration.fromSeconds(10i64);
  mut connected = false;
  while step < 6u32 and Instant.now() < giveUp {
    // The next request, once the one before has ended
    if req.isNone() and step < 5u32 {
      cl.body = String.empty();
      cl.trailers = Headers.empty();
      cl.status = 0u16;
      if step == 0u32 {
        req = drv.request(&mut lp, conn, RequestHead.get("/hello", "127.0.0.1"), BodyLength.empty(), Sink.Here[tokReq]);
      } elif step == 1u32 {
        req = drv.request(&mut lp, conn, RequestHead.get("/chunked", "127.0.0.1"), BodyLength.empty(), Sink.Here[tokReq]);
      } elif step == 2u32 {
        req = drv.request(&mut lp, conn, RequestHead.make("HEAD", "/hello", "127.0.0.1"), BodyLength.empty(), Sink.Here[tokReq]);
      } elif step == 3u32 {
        req = drv.request(&mut lp, conn, RequestHead.get("/nocontent", "127.0.0.1"), BodyLength.empty(), Sink.Here[tokReq]);
      } else {
        req = drv.request(&mut lp, conn, RequestHead.make("POST", "/echo", "127.0.0.1"),
          BodyLength.sized(u64.from(postBody().len)), Sink.Here[tokReq]);
      }
    }
    drv.poll(&mut lp, forever(), &mut events);
    mut k = 0usize;
    while k < events.len() {
      imm e = &mut events[k];
      k = k + 1usize;
      if e.token == tokServer {
        if e.kind == EventKind.Accepted[] {sv.accepted = sv.accepted + 1u64;}
        elif e.kind == EventKind.Request[] {
          sv.requests = sv.requests + 1u64;
          svTarget = String.from(e.request.target.view());
          svMethod = e.request.method;
          svReq = e.req;
          sv.echo = String.empty();
        } elif e.kind == EventKind.Data[] {
          sv.echo.appendBytes(e.buf.view());
          drv.release(e.req, e.buf.len());
        } elif e.kind == EventKind.End[] {
          answer(&mut drv, svReq, svTarget.view(), svMethod, sv.echo.view(), &pool);
        } elif e.kind == EventKind.Done[] {
          sv.dones = sv.dones + 1u64;
        } elif e.kind == EventKind.Failed[] {
          sv.failures = sv.failures + 1u64;
        } elif e.kind == EventKind.Closed[] {
          sv.closed = sv.closed + 1u64;
          if e.clean {sv.clean = sv.clean + 1u64;}
        }
      } elif e.token == tokConn {
        if e.kind == EventKind.Connected[] {connected = true;}
        elif e.kind == EventKind.Closed[] {
          cl.closed = cl.closed + 1u64;
          cl.clean = e.clean;
        } else {cl.other = cl.other + 1u64;}
      } elif e.token == tokReq {
        if e.req != req {cl.other = cl.other + 1u64;}
        if e.kind == EventKind.Response[] {
          cl.status = e.response.status;
        } elif e.kind == EventKind.Data[] {
          cl.body.appendBytes(e.buf.view());
          drv.release(e.req, e.buf.len());
        } elif e.kind == EventKind.End[] {
          cl.ends = cl.ends + 1u64;
          cl.trailers = e.trailers.copy();
        } elif e.kind == EventKind.Writable[] {
          cl.writable = cl.writable + 1u64;
          mut b = pool.mustTake(postBody().len);
          b.append(postBody());
          match drv.sendData(req, b) {
            case is None[IoBuf] {}
            else {expect(false, "the POST's body is taken");}
          }
          drv.finish(req);
        } elif e.isTerminal() {
          cl.finals = cl.finals + 1u64;
          expectBool(e.kind == EventKind.Done[], true, "each request ends Done");
          expectUInt(cl.ends, cl.finals, "End comes before Done");
          if e.kind == EventKind.Done[] {cl.dones = cl.dones + 1u64;}
          // What this step's request should have got
          if step == 0u32 {
            expectInt(i64.from(cl.status), 200i64, "GET /hello: 200");
            expectStr(cl.body.view(), helloBody(), "GET /hello: its body");
          } elif step == 1u32 {
            expectInt(i64.from(cl.status), 200i64, "GET /chunked: 200");
            expectStr(cl.body.view(), "one,two,three", "GET /chunked: its body");
            match cl.trailers.get("x-checksum") {
              case imm v Some {expectStr(v.value, "abc123", "GET /chunked: its trailer");}
              case is None[&Array[u8]] {expect(false, "GET /chunked: its trailer arrived");}
            }
          } elif step == 2u32 {
            expectInt(i64.from(cl.status), 200i64, "HEAD /hello: 200");
            expectUInt(u64.from(cl.body.len()), 0u64, "HEAD /hello: no body");
          } elif step == 3u32 {
            expectInt(i64.from(cl.status), 204i64, "GET /nocontent: 204");
            expectUInt(u64.from(cl.body.len()), 0u64, "GET /nocontent: no body");
          } else {
            expectInt(i64.from(cl.status), 200i64, "POST /echo: 200");
            expectStr(cl.body.view(), postBody(), "POST /echo: its body echoed");
            expectUInt(cl.writable, 1u64, "POST /echo: one Writable");
          }
          expect(drv.isIdle(conn), "the connection is free again");
          req = ReqId.none();
          step = step + 1u32;
          if step == 5u32 {drv.close(&mut lp, conn);}
        }
      }
    }
    events.clear();
    if step == 5u32 and cl.closed == 1u64 and sv.closed == 1u64 {step = 6u32;}
  }
  requireUInt(u64.from(step), 6u64, "every step done in time");
  expect(connected, "the client connected");
  expectUInt(cl.dones, 5u64, "five requests Done");
  expectUInt(cl.finals, 5u64, "five final answers, one each");
  expectUInt(cl.other, 0u64, "no other connection events, and none of another request");
  expectUInt(cl.closed, 1u64, "the client's connection: one Closed");
  expect(cl.clean, "...clean");
  expectUInt(sv.accepted, 1u64, "the server accepted one connection");
  expectUInt(sv.requests, 5u64, "...and read five requests on it");
  expectUInt(sv.dones, 5u64, "...each answered Done");
  expectUInt(sv.failures, 0u64, "...none failed");
  expectUInt(sv.closed, 1u64, "the server's connection: one Closed");
  expectUInt(sv.clean, 1u64, "...clean");
  imm s = drv.stats();
  expectUInt(s.connects, 1u64, "stats: one connect");
  expectUInt(s.connected, 1u64, "stats: connected once");
  expectUInt(s.accepted, 1u64, "stats: one accepted");
  expectUInt(s.closed, 2u64, "stats: two closed");
  expectUInt(s.cleanCloses, 2u64, "stats: both clean");
  expectUInt(s.requests, 10u64, "stats: five asked, five read");
  expectUInt(s.done, 10u64, "stats: ten Done");
  expectUInt(s.bytesIn, s.bytesOut, "stats: every byte sent was received");
  expectUInt(u64.from(drv.live()), 0u64, "no connection left");
  drv.abortAll(&mut lp);
  events.clear();
  expectUInt(pool.stats().lent, 0u64, "every buffer back in the pool");
  done();
}
