// The text of httpconn's enums, every variant: a stage's lower-case name, and an event
// kind's variant name (which its debug form is too). Pinned so the text cannot drift
// when the way it is asked for changes.

mod names;

import testing use *;
import collections use String;
import httpconn use *;

fn stage(s: Stage) String { String() <- toText(&s) }
fn event(k: EventKind) String { String() <- toDebug(&k) }

fn main() i32 {
  expectStr(stage(Stage.Resolve).view(), "resolve", "stage Resolve");
  expectStr(stage(Stage.Connect).view(), "connect", "stage Connect");
  expectStr(stage(Stage.Read).view(), "read", "stage Read");
  expectStr(stage(Stage.Write).view(), "write", "stage Write");
  expectStr(stage(Stage.Http).view(), "http", "stage Http");
  expectStr(stage(Stage.Tls).view(), "tls", "stage Tls");
  expectStr(stage(Stage.Closed).view(), "closed", "stage Closed");
  expectStr(stage(Stage.Limit).view(), "limit", "stage Limit");
  expectStr(event(EventKind.Connected).view(), "Connected", "event Connected");
  expectStr(event(EventKind.Accepted).view(), "Accepted", "event Accepted");
  expectStr(event(EventKind.Closed).view(), "Closed", "event Closed");
  expectStr(event(EventKind.Request).view(), "Request", "event Request");
  expectStr(event(EventKind.Response).view(), "Response", "event Response");
  expectStr(event(EventKind.Interim).view(), "Interim", "event Interim");
  expectStr(event(EventKind.Data).view(), "Data", "event Data");
  expectStr(event(EventKind.End).view(), "End", "event End");
  expectStr(event(EventKind.Writable).view(), "Writable", "event Writable");
  expectStr(event(EventKind.Done).view(), "Done", "event Done");
  expectStr(event(EventKind.Failed).view(), "Failed", "event Failed");
  expectStr(event(EventKind.Cancelled).view(), "Cancelled", "event Cancelled");
  expectStr(event(EventKind.TimedOut).view(), "TimedOut", "event TimedOut");
  done()
}
