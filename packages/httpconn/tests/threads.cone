// Across threads: a server on one thread, with its own Loop and Driver; a
// client on the main thread, with its own, fetching from it over three
// kept-alive connections, 40 requests on each, every body checked; and one
// more request whose events go by a channel (Sink.Chan) to a third thread,
// which reads a 1 MiB body through a channel of room for one event while
// sleeping now and then, so the channel fills: its events are held, its
// connection stops reading, and every byte still arrives once, in order,
// with exactly one final answer after them.

mod threads;

import testing use *;
import thread;
import sync use *;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, SocketAddr, forever;
import http use *;
import httpconn use *;

const conns = 3u64;
const perConn = 40u64;
const bigSize = 1048576u64;

// The byte at offset k of the body of /n/<i>
fn bodyByte(i u64, k u64) u8 {u8.from((i * 7u64 + k * 13u64) % 251u64)}
fn bodyLen(i u64) u64 {if i == 0u64 {bigSize} else {1u64 + (i * 37u64) % 3000u64}}

// The number at the end of a target, '/n/<i>'
fn targetNumber(t &Array[u8]) u64 {
  var i = 0u64;
  var k = 3usize;
  while k < t.len {
    i = i * 10u64 + u64.from(t[k] - '0');
    k = k + 1usize;
  }
  i
}

// ---------------------------------------------------------------------------
// The server's thread
// ---------------------------------------------------------------------------

struct ServerArgs {
  pub portTx Sender[u16];
  pub closes u64;           // stop once this many connections have closed
}

struct ServerReport {
  pub requests u64;
  pub done u64;
  pub notDone u64;
  pub closed u64;
}

fn serve(a ServerArgs) ServerReport {
  let pool = Pool.make();
  var lp = Loop.mustMake();
  var drv = Driver.make(Config.make(), pool);
  var listener = ListenerId.none();
  match drv.listen(&mut lp, SocketAddr.localhost(0u16), Sink.Here(1u64)) {
    case let r Ok {listener = r;}
    case let e Error {}
  }
  var port = 0u16;
  match drv.localAddr(&lp, listener) {
    case let r Ok {port = r.port();}
    case let e Error {}
  }
  a.portTx.send(port);
  var rep = new ServerReport(0u64, 0u64, 0u64, 0u64);
  var events = List[Event].empty();
  // Bodies being sent: a request and how far it has got
  var sending = List[ReqId].empty();
  var sentTo = List[u64].empty();
  var which = List[u64].empty();
  while rep.closed < a.closes {
    drv.poll(&mut lp, forever(), &mut events);
    var k = 0usize;
    while k < events.len() {
      let e = &mut events[k];
      k = k + 1usize;
      if e.kind == EventKind.Request {
        rep.requests = rep.requests + 1u64;
        let i = targetNumber(e.request.target.view());
        drv.respond(e.req, ResponseHead.make(200u16), BodyLength.sized(bodyLen(i)));
        sending.push(e.req);
        sentTo.push(0u64);
        which.push(i);
      } elif e.kind == EventKind.Done {
        rep.done = rep.done + 1u64;
      } elif e.isTerminal() {
        rep.notDone = rep.notDone + 1u64;
      } elif e.kind == EventKind.Closed {
        rep.closed = rep.closed + 1u64;
      }
    }
    events.clear();
    // Bodies out, as the connections take them
    var j = 0usize;
    while j < sending.len() {
      let req = *sending[j];
      let i = *which[j];
      let len = bodyLen(i);
      var off = *sentTo[j];
      var refused = false;
      while off < len and not refused {
        let n = if len - off < 16384u64 {len - off} else {16384u64};
        var b = pool.mustTake(usize.from(n));
        let room = b.whole();
        var q = 0u64;
        while q < n {
          room[usize.from(q)] = bodyByte(i, off + q);
          q = q + 1u64;
        }
        b.setLen(usize.from(n));
        match drv.sendData(req, b) {
          case is None[IoBuf] {off = off + n;}
          else {refused = true;}
        }
      }
      if off == len {
        drv.finish(req);
        let last = sending.len() - 1usize;
        sending.swap(j, last);
        sentTo.swap(j, last);
        which.swap(j, last);
        sending.pop();
        sentTo.pop();
        which.pop();
      } else {
        sentTo.set(j, off);
        j = j + 1usize;
      }
    }
  }
  rep
}

// ---------------------------------------------------------------------------
// The channel's thread
// ---------------------------------------------------------------------------

struct ChanReport {
  pub bytes u64;
  pub wrong u64;
  pub responses u64;
  pub ends u64;
  pub finals u64;
  pub done u64;
  pub afterFinal u64;
}

fn consume(rx Receiver[Event]) ChanReport {
  var r = rx;
  var rep = new ChanReport(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
  var seen = 0u64;
  while true {
    var got = false;
    match r.recv() {
      case var s Some {
        got = true;
        let e = &mut s;
        if rep.finals > 0u64 {rep.afterFinal = rep.afterFinal + 1u64;}
        if e.kind == EventKind.Response {rep.responses = rep.responses + 1u64;}
        elif e.kind == EventKind.Data {
          let v = e.buf.view();
          var k = 0usize;
          while k < v.len {
            if v[k] != bodyByte(0u64, rep.bytes + u64.from(k)) {rep.wrong = rep.wrong + 1u64;}
            k = k + 1usize;
          }
          rep.bytes = rep.bytes + u64.from(v.len);
          seen = seen + 1u64;
          // Slow, now and then: the channel fills behind it
          if seen % 4u64 == 0u64 {thread.sleep(Duration.fromMillis(2i64));}
        } elif e.kind == EventKind.End {rep.ends = rep.ends + 1u64;}
        elif e.isTerminal() {
          rep.finals = rep.finals + 1u64;
          if e.kind == EventKind.Done {rep.done = rep.done + 1u64;}
          return rep;
        }
      }
      case is None[Event] {}
    }
    if not got {break;}
  }
  rep
}

// ---------------------------------------------------------------------------
// The client: the main thread
// ---------------------------------------------------------------------------

fn main() i32 {
  var portTx Sender[u16];
  var portRx Receiver[u16];
  portTx, portRx = Channel[u16].make();
  let server = thread.start(new ServerArgs(portTx, conns + 1u64), &serve);
  var port = 0u16;
  match portRx.recv() {
    case let p Some {port = p;}
    case is None[u16] {}
  }
  require(port != 0u16, "the server's port");

  // The channel's reader
  var evTx Sender[Event];
  var evRx Receiver[Event];
  evTx, evRx = Channel[Event].bounded(1u64);
  let reader = thread.start(evRx, &consume);

  let pool = Pool.make();
  var lp = Loop.mustMake();
  var drv = Driver.make(Config.make(), pool);
  var cs = List[ConnId].empty();
  var next = List[u64].empty();       // each connection's requests made
  var have = List[u64].empty();       // body bytes of its request in flight
  var k = 0u64;
  while k < conns {
    cs.push(drv.connect(&mut lp, "127.0.0.1", port, Sink.Here(k)));
    next.push(0u64);
    have.push(0u64);
    k = k + 1u64;
  }
  // The big one, on a fourth connection, to the channel
  let bigConn = drv.connect(&mut lp, "127.0.0.1", port, Sink.Here(99u64));
  drv.request(&mut lp, bigConn, RequestHead.get("/n/0", "127.0.0.1"), BodyLength.empty(), Sink.Chan(500u64, evTx));

  var wrong = 0u64;
  var dones = 0u64;
  var notDone = 0u64;
  var closed = 0u64;
  var events = List[Event].empty();
  let giveUp = Instant.now() + Duration.fromSeconds(30i64);
  var bigDone = false;
  while (closed < conns + 1u64 or drv.held() > 0usize) and Instant.now() < giveUp {
    // Each free connection's next request
    k = 0u64;
    while k < conns {
      let c = *cs[usize.from(k)];
      let made = *next[usize.from(k)];
      if drv.isIdle(c) and made < perConn {
        let i = 1u64 + k * perConn + made;
        var t = String.from("/n/");
        t.appendUInt(i);
        drv.request(&mut lp, c, RequestHead.get(t.view(), "127.0.0.1"), BodyLength.empty(), Sink.Here(1000u64 + i));
        next.set(usize.from(k), made + 1u64);
        have.set(usize.from(k), 0u64);
      } elif made == perConn and drv.isIdle(c) {
        drv.close(&mut lp, c);
        next.set(usize.from(k), made + 1u64);
      }
      k = k + 1u64;
    }
    if not bigDone and drv.isIdle(bigConn) {
      drv.close(&mut lp, bigConn);
      bigDone = true;
    }
    drv.poll(&mut lp, forever(), &mut events);
    var j = 0usize;
    while j < events.len() {
      let e = &mut events[j];
      j = j + 1usize;
      if e.kind == EventKind.Closed {
        closed = closed + 1u64;
        if not e.clean {wrong = wrong + 1u64;}
      } elif e.token >= 1000u64 {
        let i = e.token - 1000u64;
        let c = (i - 1u64) / perConn;
        if e.kind == EventKind.Data {
          let v = e.buf.view();
          let off = *have[usize.from(c)];
          var q = 0usize;
          while q < v.len {
            if v[q] != bodyByte(i, off + u64.from(q)) {wrong = wrong + 1u64;}
            q = q + 1usize;
          }
          have.set(usize.from(c), off + u64.from(v.len));
          drv.release(e.req, v.len);
        } elif e.kind == EventKind.Done {
          dones = dones + 1u64;
          if *have[usize.from(c)] != bodyLen(i) {wrong = wrong + 1u64;}
        } elif e.isTerminal() {
          notDone = notDone + 1u64;
        }
      }
    }
    events.clear();
  }
  let big = reader.join();
  let rep = server.join();
  expectUInt(closed, conns + 1u64, "every connection closed, each once");
  expectUInt(wrong, 0u64, "every body byte right, every close clean");
  expectUInt(dones, conns * perConn, "every request Done");
  expectUInt(notDone, 0u64, "none ended otherwise");
  expectUInt(rep.requests, conns * perConn + 1u64, "the server read them all");
  expectUInt(rep.done, conns * perConn + 1u64, "...and answered each, Done");
  expectUInt(rep.notDone, 0u64, "...none otherwise");
  expectUInt(rep.closed, conns + 1u64, "...and saw every connection close");
  expectUInt(big.responses, 1u64, "the channel: one Response");
  expectUInt(big.bytes, bigSize, "...every byte of the body");
  expectUInt(big.wrong, 0u64, "...in order");
  expectUInt(big.ends, 1u64, "...one End");
  expectUInt(big.finals, 1u64, "...one final answer");
  expectUInt(big.done, 1u64, "...Done");
  expectUInt(big.afterFinal, 0u64, "...and nothing after it");
  let s = drv.stats();
  expect(s.held > 0u64, "the channel filled: events were held");
  expectUInt(s.dropped, 0u64, "none dropped");
  expectUInt(u64.from(drv.live()), 0u64, "no connection left");
  done()
}
