// A server connection as one value, sans-I/O (see the package's header,
// THE SERVER CONNECTION). It is every part of a server connection that is
// not a socket or a clock: the optional layer (TLS), the protocol chosen
// once the layer is open (HTTP/1.1, or HTTP/2 by ALPN or prior knowledge),
// the one request head and one response head it keeps and refills, the wire
// Chain it keeps, the back-pressure of its output on its reading, and its
// deadlines. Whoever owns the socket calls it with the bytes that arrived
// and the time, and takes the bytes it has to send; it keeps no table, makes
// no pool of records and knows no Loop.

// What happened on a server connection (ServerConn.next). A request's head
// is read at once by 'request' (HTTP/1.1: kept in the connection and given back
// when the exchange ends; HTTP/2: 'takeRequest' moves it out), the bytes of its
// body come as Data and the end of them as End. HTTP/1.1's events name stream 0
pub enum ServerEvent {
  pub struct Nothing {}          // none now: bytes are wanted (or reading is paused)
  pub struct Request {pub stream: u32; pub body: BodyLength;}
  pub struct Data {pub stream: u32; pub buf: IoBuf;}
  pub struct End {pub stream: u32; pub trailers: Headers;}
  pub struct Reset {pub stream: u32; pub error: HttpError;}      // HTTP/2: the peer reset the stream
  pub struct Closed {pub failure: Option[Failure];}              // the protocol is over (once); output may still be going
}

// One server connection's whole state (see above)
pub struct ServerConn is Move {
  cfg: Config;
  layer: Option[Uni[Layer]];   // None: the socket's bytes are the protocol's
  core: http1.Connection;
  h2: Option[Uni[http2.Connection]];
  isH2: bool;
  decided: bool;               // the protocol is chosen: the layer has opened
  cleartext: bool;             // no handshake: no ALPN, prior knowledge decides
  wire: Chain;                 // bytes ready for the socket, kept
  tx: Chain;                   // the protocol's bytes on their way into the layer, kept
  inflight: usize;             // bytes taken by takeWire, not yet confirmed by wireSent
  paused: bool;                // reading paused: the output is over the write watermark
  eofSeen: bool;               // the socket's receiving side ended
  eofFed: bool;                // ...and the protocol has been told
  feedHeld: bool;              // the feed stopped for the protocol's credit: the layer may hold bytes
  closeSent: bool;             // the layer's closeSend has been called
  closeAsked: bool;            // shutdown: end once what is under way is done
  h2Shut: bool;                // HTTP/2: our GOAWAY has been asked for
  closedGiven: bool;           // Closed has been returned
  failure: Option[Failure];
  openBy: Instant;             // the layer's handshake ends by then
  lastActive: Instant;         // HTTP/2: a stream last began or ended
  head: RequestHead;           // the request in hand
  headOut: bool;               // HTTP/1.1: head holds a request the core was lent a spare for
  resp: ResponseHead;          // the response being written, kept and refilled
  inFlight: bool;              // HTTP/1.1: a request's exchange is not over
  readDone: bool;              // ...its request is read whole
  respDone: bool;              // ...its response is whole

  // A connection accepted at 'now', over 'layer' (None: plain), taking cfg's bounds
  pub fn make(cfg: Config, layer: Option[Uni[Layer]], now: Instant) ServerConn {
    let cleartext = match &layer {
      case let &Some(l) {l.isOpen()}
      else {true}
    };
    var c = ServerConn(cfg: cfg, layer: layer, core: http1.Connection.server(cfg.protocol, now),
      h2: None, isH2: false, decided: false, cleartext: cleartext,
      wire: Chain.make(noBound), tx: Chain.make(noBound), inflight: 0usize, paused: false,
      eofSeen: false, eofFed: false, feedHeld: false, closeSent: false, closeAsked: false, h2Shut: false,
      closedGiven: false, failure: None, openBy: now + cfg.handshakeTimeout, lastActive: now,
      head: RequestHead(), headOut: false, resp: ResponseHead(), inFlight: false, readDone: false,
      respDone: false);
    c.decide(now);
    c
  }

  // ---------------------------------------------------------------------------
  // Reading
  // ---------------------------------------------------------------------------

  // How many wire bytes 'wireIn' takes now: 0 while reading is paused (the
  // output is over the write watermark, and resumes below half of it), while the
  // protocol has no credit, and once the socket's end has come
  pub fn readRoom(self: &) usize {
    if paused || eofSeen || self.pClosed() {return 0usize;}
    let credit = self.pCredit();
    match &layer {
      case let &Some(l) {
        if credit < self.feedNeed() {return 0usize;}
        l.wireRoom()
      }
      else {credit}
    }
  }

  // Bytes that came off the socket, at 'now' (an empty buffer: the peer's end).
  // More than readRoom() is a program error
  pub fn wireIn(self: &mut, buf: IoBuf, now: Instant) {
    if buf.len() == 0usize {eofSeen = true;}
    if layer is Some {
      self.lWireIn(buf, now);
    } else if buf.len() > 0usize {
      if !self.pClosed() {self.pInput(buf, now);}
    }
    self.feed(now);
    self.updatePause();
  }

  // The bytes the layer has for the protocol, and the end of the stream. A
  // buffer is taken from the layer only while the protocol's credit holds the
  // largest one a layer gives (a TLS record's plaintext): what is left stays in the layer
  fn feed(self: &mut, now: Instant) {
    self.decide(now);
    var hasLayer = false;
    match &layer {
      case let &Some(l) {hasLayer = true;}
      else {}
    }
    if !hasLayer {
      if eofSeen && !eofFed {
        eofFed = true;
        self.pInput(IoBuf(), now);
      }
      return;
    }
    feedHeld = false;
    let need = self.feedNeed();
    while decided {
      if self.pCredit() < need && !self.pClosed() {
        feedHeld = true;
        break;
      }
      let b = self.lPlainOut();
      if b.len() == 0usize {break;}
      self.pInput(b, now);
    }
    var ended = false;
    var failed = false;
    match &layer {
      case let &Some(l) {
        ended = l.peerEnded();
        failed = l.failed();
      }
      else {}
    }
    if ended && !eofFed {
      eofFed = true;
      self.pInput(IoBuf(), now);
    }
    if failed {self.layerFailed();}
  }

  fn feedNeed(self: &) usize {
    var gives = false;
    match &layer {
      case let &Some(l) {gives = l.givesRecords();}
      else {}
    }
    if cfg.recvSize > feedRecord || !gives {cfg.recvSize} else {feedRecord}
  }

  fn layerFailed(self: &mut) {
    if failure is Some {return;}
    var text = String();
    var code = 0u32;
    var overloaded = false;
    match &layer {
      case let &Some(l) {
        text = l.failureText();
        code = l.failureCode();
        overloaded = l.overloaded();
      }
      else {}
    }
    let kind = if overloaded {ErrorKind.Overloaded} else {ErrorKind.Closed};
    failure = Some[Failure](Failure.make(Stage.Tls, code, kind, text.view()));
    self.pAbort();
  }

  // The protocol, chosen once the layer is open: what its handshake chose by
  // ALPN ("h2" is HTTP/2; "http/1.1", or none, HTTP/1.1), or, for a layer with
  // no handshake, HTTP/2 by prior knowledge when the config says so
  fn decide(self: &mut, now: Instant) {
    if decided || !self.layerOpen() {return;}
    decided = true;
    var p = String();
    match &layer {
      case let &Some(l) {p = l.alpn();}
      else {}
    }
    var h2 = p.view() == "h2";
    if p.len() == 0usize && cleartext {h2 = cfg.h2PriorKnowledge;}
    if !h2 && p.len() > 0usize && p.view() != "http/1.1" {
      var why = String.from("ALPN chose a protocol the server does not speak: ");
      why.append(p.view());
      failure = Some[Failure](Failure.make(Stage.Tls, 0u32, ErrorKind.Unsupported, why.view()));
      self.pAbort();
      return;
    }
    if h2 {
      let made = http2.Connection.server(cfg.h2, now);
      h2 = true;
      self.h2 = Some[Uni[http2.Connection]](Uni[http2.Connection](made));
      isH2 = true;
      lastActive = now;
    }
  }

  fn layerOpen(self: &) bool {
    match &layer {
      case let &Some(l) {l.isOpen()}
      else {true}
    }
  }

  // ---------------------------------------------------------------------------
  // The protocol, whichever it is
  // ---------------------------------------------------------------------------

  fn pInput(self: &mut, buf: IoBuf, now: Instant) {
    if isH2 {
      match &mut h2 {
        case var &mut Some(h) {h.handleInput(buf, now);}
        else {}
      }
    } else {
      core.handleInput(buf, now);
    }
  }

  fn pCredit(self: &) usize {
    if isH2 {
      match &h2 {
        case let &Some(h) {return h.readCredit();}
        else {}
      }
    }
    core.readCredit()
  }

  fn pClosed(self: &) bool {
    if isH2 {
      match &h2 {
        case let &Some(h) {return h.isClosed();}
        else {}
      }
    }
    core.isClosed()
  }

  fn pShouldClose(self: &) bool {
    if isH2 {
      match &h2 {
        case let &Some(h) {return h.shouldClose();}
        else {}
      }
    }
    core.shouldClose()
  }

  fn pAbort(self: &mut) {
    if isH2 {
      match &mut h2 {
        case var &mut Some(h) {h.abort();}
        else {}
      }
    }
    core.abort();
  }

  // ---------------------------------------------------------------------------
  // Events
  // ---------------------------------------------------------------------------

  // The next thing that happened, at 'now' (Nothing when none). HTTP/1.1
  // holds back the next request while reading is paused: the output queued
  // for the request answered before it has to go first
  pub fn next(self: &mut, now: Instant) ServerEvent {
    self.feed(now);
    let ev = if isH2 {self.next2(now)} else {self.next1(now)};
    self.updatePause();
    ev
  }

  fn closedEvent(self: &mut) ServerEvent {
    if closedGiven {return ServerEvent.Nothing;}
    closedGiven = true;
    ServerEvent.Closed(failure.take())
  }

  fn next1(self: &mut, now: Instant) ServerEvent {
    if headOut && !inFlight {
      // The exchange is over: the head goes back to the core to be read into again
      var h = RequestHead();
      h <-> head;
      core.recycleRequest(h);
      headOut = false;
    }
    while true {
      if paused && !inFlight && !core.isClosed() {return ServerEvent.Nothing;}
      match core.pollEvent() {
        case is NeedData {return ServerEvent.Nothing;}
        case is Paused {return ServerEvent.Nothing;}
        case is Closed {return self.closedEvent();}
        case let Request(q) {
          let got, body = q.(head, body);
          var h = got;
          head <-> h;
          headOut = true;
          inFlight = true;
          readDone = false;
          respDone = false;
          return ServerEvent.Request(0u32, body);
        }
        case let Data(d) {return ServerEvent.Data(0u32, d.(buf));}
        case let End(e) {
          readDone = true;
          if respDone {inFlight = false;}
          return ServerEvent.End(0u32, e.(trailers));
        }
        case let Failed(f) {
          failure = Some[Failure](Failure(Stage.Http, 0u32, f.(error), false));
        }
        case let Response(p) {}
        case let Interim(p) {}
      }
    }
    ServerEvent.Nothing
  }

  fn next2(self: &mut, now: Instant) ServerEvent {
    while true {
      let ev = match &mut h2 {
        case var &mut Some(h) {h.pollEvent()}
        else {return ServerEvent.Nothing;}
      };
      match ev {
        case is NeedData {return ServerEvent.Nothing;}
        case is Closed {return self.closedEvent();}
        case let Request(q) {
          let stream, got, body = q.(stream, head, body);
          var h = got;
          head <-> h;
          lastActive = now;
          return ServerEvent.Request(stream, body);
        }
        case let Data(d) {
          let stream, buf = d.(stream, buf);
          return ServerEvent.Data(stream, buf);
        }
        case let End(e) {
          let stream, trailers = e.(stream, trailers);
          return ServerEvent.End(stream, trailers);
        }
        case let Reset(x) {
          lastActive = now;
          let stream, error = x.(stream, error);
          return ServerEvent.Reset(stream, error);
        }
        case let Failed(f) {
          failure = Some[Failure](Failure(Stage.Http, 0u32, f.(error), false));
        }
        case let GoAway(g) {}
        case let Pong(p) {}
        case let Response(p) {}
        case let Interim(p) {}
      }
    }
    ServerEvent.Nothing
  }

  // The head of the request the last Request event named (HTTP/1.1: kept, and
  // read until the exchange ends)
  pub fn request(self: &) &RequestHead {&head}

  // The same, moved out (an HTTP/2 stream's handler is given it whole); the
  // connection keeps an empty one
  pub fn takeRequest(self: &mut) RequestHead {
    var out = RequestHead();
    out <-> head;
    out
  }

  // ---------------------------------------------------------------------------
  // Answering
  // ---------------------------------------------------------------------------

  // The response head the program fills before 'respond': kept, and emptied by it
  pub fn response(self: &mut) &mut ResponseHead {&mut resp}

  // The response whose head was written into 'response()', its body (if any)
  // by sendData and finish. The head is emptied for the next
  pub fn respond(self: &mut, stream: u32, body: BodyLength, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    let status = resp.status;
    if isH2 {
      stripForH2(&mut resp.headers);
      match &mut h2 {
        case var &mut Some(h) {h.respondWith(stream, &resp, body, file, line);}
        else {}
      }
    } else {
      core.respondWith(&resp, body, file, line);
      if head.method == Method.Head || status == 204u16 || status == 304u16 || body.isEmpty() ||
          (body.isSized() && body.length == 0u64) {
        self.responseWhole();
      }
    }
    resp.headers.clear();
    resp.status = 0u16;
    self.updatePause();
  }

  // HTTP/1.1: the response is whole (the exchange is over once the request is read too)
  fn responseWhole(self: &mut) {
    respDone = true;
    if readDone {inFlight = false;}
  }

  // An interim 1xx (not 101), before the final response
  pub fn sendInterim(self: &mut, stream: u32, head: ResponseHead, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if isH2 {
      match &mut h2 {
        case var &mut Some(h) {h.sendInterim(stream, head, file, line);}
        else {}
      }
    } else {
      core.sendInterim(head, file, line);
    }
    self.updatePause();
  }

  // '100 Continue': the server wants the request's body
  pub fn sendContinue(self: &mut, stream: u32, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    self.sendInterim(stream, ResponseHead.make(100u16), file, line);
  }

  // Body bytes: None once queued; Some(buf) back, refused, at the write watermark
  pub fn sendData(self: &mut, stream: u32, buf: IoBuf, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Option[IoBuf] {
    var back: Option[IoBuf] = None;
    if isH2 {
      match &mut h2 {
        case var &mut Some(h) {back = h.sendData(stream, buf, file, line);}
        else {}
      }
    } else {
      back = core.sendData(buf, file, line);
    }
    self.updatePause();
    back
  }

  // How many more bytes sendData takes before it refuses
  pub fn writeRoom(self: &, stream: u32) usize {
    if isH2 {
      match &h2 {
        case let &Some(h) {return h.writeRoom(stream);}
        else {}
      }
    }
    core.writeRoom()
  }

  // The body is whole
  pub fn finish(self: &mut, stream: u32, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if isH2 {
      match &mut h2 {
        case var &mut Some(h) {h.finish(stream, file, line);}
        else {}
      }
    } else {
      core.finish(file, line);
      self.responseWhole();
    }
    self.updatePause();
  }

  // The program is done with n bytes of body that Data events handed it
  pub fn release(self: &mut, stream: u32, n: usize) {
    if isH2 {
      match &mut h2 {
        case var &mut Some(h) {h.release(stream, n);}
        else {}
      }
    } else {
      core.release(n);
    }
  }

  // A request whose answer is whole and whose body is no longer wanted: an
  // HTTP/2 stream is reset with NO_ERROR; HTTP/1.1 reads the rest out (up to
  // 256 KiB) to keep the connection. False when it does nothing
  pub fn stopBody(self: &mut, stream: u32) bool {
    if isH2 {
      match &mut h2 {
        case var &mut Some(h) {h.reset(stream, http2.ErrorCode.NoError);}
        else {return false;}
      }
      return true;
    }
    core.dropBody()
  }

  // ---------------------------------------------------------------------------
  // Writing
  // ---------------------------------------------------------------------------

  // Move everything ready to send into the connection's wire Chain (the
  // layer's own bytes, a handshake's, first; then the protocol's through the
  // layer): how many bytes it holds now
  pub fn fill(self: &mut, now: Instant) usize {
    var hasLayer = false;
    match &layer {
      case let &Some(l) {hasLayer = true;}
      else {}
    }
    while true {
      if hasLayer {
        let b = self.lWireOut(now);
        if b.len() > 0usize {
          wire.push(b);
          continue;
        }
      }
      if !decided {break;}
      let target = if hasLayer {1u32} else {0u32};
      var moved = 0usize;
      if target == 0u32 {
        moved = self.pTransmit(now, true);
      } else {
        moved = self.pTransmit(now, false);
        while true {
          match tx.popFront() {
            case var Some(p) {self.lPlainIn(p);}
            else {break;}
          }
        }
      }
      if moved == 0usize {break;}
      if !hasLayer {break;}
    }
    self.updatePause();
    wire.len()
  }

  // The protocol's output, into the wire (when there is no layer) or the layer's feed Chain
  fn pTransmit(self: &mut, now: Instant, direct: bool) usize {
    if isH2 {
      var chain = Chain.make(noBound);
      match &mut h2 {
        case var &mut Some(h) {chain = h.pollTransmit(now);}
        else {}
      }
      var n = 0usize;
      while true {
        match chain.popFront() {
          case var Some(p) {
            n = n + p.len();
            if direct {wire.push(p);} else {tx.push(p);}
          }
          else {break;}
        }
      }
      return n;
    }
    if direct {core.pollTransmitInto(now, &mut wire)} else {core.pollTransmitInto(now, &mut tx)}
  }

  // The bytes in the wire Chain, moved to 'dest' to be written to the socket:
  // how many. They count against the watermark until 'wireSent' says they went
  pub fn takeWire(self: &mut, dest: &mut Chain) usize {
    let n = wire.len();
    while true {
      match wire.popFront() {
        case var Some(b) {dest.push(b);}
        else {break;}
      }
    }
    inflight = inflight + n;
    n
  }

  // n of the bytes 'takeWire' gave have been written
  pub fn wireSent(self: &mut, n: usize) {
    inflight = if n >= inflight {0usize} else {inflight - n};
    self.updatePause();
  }

  // Bytes waiting to go to the socket: in the protocol, the layer, the wire
  // Chain and written but not confirmed
  pub fn queued(self: &) usize {
    var q = wire.len() + tx.len() + inflight;
    if !isH2 {q = q + core.queued();}
    match &layer {
      case let &Some(l) {q = q + l.pending();}
      else {}
    }
    q
  }

  // Reading pauses when the output is at the write watermark and resumes below
  // half of it
  fn updatePause(self: &mut) {
    let wm = if isH2 {cfg.h2.writeWatermark} else {cfg.protocol.writeWatermark};
    let q = self.queued();
    if !paused && q >= wm {paused = true;}
    else if paused && q < wm / 2usize {paused = false;}
  }

  // ---------------------------------------------------------------------------
  // Deadlines and the end
  // ---------------------------------------------------------------------------

  // The one Instant to wake at and call handleTimeout, or None
  pub fn pollTimeout(self: &) Option[Instant] {
    var best: Option[Instant] = None;
    if isH2 {
      match &h2 {
        case let &Some(h) {
          best = h.pollTimeout();
          if h.liveStreams() == 0usize && !h2Shut {
            let at = lastActive + cfg.h2IdleTimeout;
            best = soonest(best, at);
          }
        }
        else {}
      }
    } else {
      best = core.pollTimeout();
    }
    if !self.layerOpen() && !self.pClosed() {best = soonest(best, openBy);}
    best
  }

  // Act on every deadline due at 'now'
  pub fn handleTimeout(self: &mut, now: Instant) {
    if !self.layerOpen() && now >= openBy && failure is None {
      failure = Some[Failure](Failure.make(Stage.Tls, 0u32, ErrorKind.TimedOut, "the TLS handshake did not finish within handshakeTimeout"));
      self.pAbort();
      return;
    }
    if isH2 {
      match &mut h2 {
        case var &mut Some(h) {
          h.handleTimeout(now);
          if h.liveStreams() == 0usize && !h2Shut && now >= lastActive + cfg.h2IdleTimeout {
            h2Shut = true;
            h.shutdown();
          }
        }
        else {}
      }
    } else {
      core.handleTimeout(now);
    }
  }

  // Close once what is under way is done: HTTP/1.1 finishes the request in
  // hand and ends; HTTP/2 sends GOAWAY and lets its open streams finish
  pub fn shutdown(self: &mut) {closeAsked = true;}

  // End the connection now, dropping what was not yet sent
  pub fn abort(self: &mut) {
    if failure is None {failure = Some[Failure](Failure.make(Stage.Closed, 0u32, ErrorKind.Closed, "the connection was aborted"));}
    self.pAbort();
  }

  // Whether the connection is over and all it had to send has gone: the owner
  // then half-closes the socket, reads out what the peer still sends, and
  // drops it. It also acts on 'shutdown', and sends the layer's own goodbye (a
  // TLS close_notify) into the wire first: the owner takes and writes it, and asks again
  pub fn done(self: &mut, now: Instant) bool {
    if closeAsked {
      if isH2 {
        if !h2Shut {
          h2Shut = true;
          match &mut h2 {
            case var &mut Some(h) {h.shutdown();}
            else {}
          }
        }
      } else if !inFlight && !core.isClosed() {
        core.abort();
      }
    }
    if !self.pShouldClose() {return false;}
    self.fill(now);
    if wire.len() > 0usize || inflight > 0usize {return false;}
    var pending = 0usize;
    match &layer {
      case let &Some(l) {pending = l.pending();}
      else {}
    }
    if pending > 0usize {return false;}
    if !closeSent {
      closeSent = true;
      self.lCloseSend();
      self.fill(now);
      return wire.len() == 0usize;
    }
    true
  }

  // Why the connection failed, once it has
  pub fn failureOf(self: &) &Option[Failure] {&failure}

  // Whether the protocol chosen is HTTP/2
  pub fn isHttp2(self: &) bool {isH2}

  // Whether the layer's handshake is done and the protocol chosen
  pub fn isOpen(self: &) bool {decided}

  // The layer's work for the blocking pool (a TLS session's certificate check
  // by the OS), as the Layer says it: whether there is some, the work, its answer
  pub fn wantsCall(self: &) bool {
    match &layer {
      case let &Some(l) {l.wantsCall()}
      else {false}
    }
  }

  pub fn takeCall(self: &mut) Op {
    match layer.take() {
      case var Some(l) {
        let op = l.takeCall();
        layer = Some[Uni[Layer]](l);
        op
      }
      else {Op.Call(Lane.general(), &noCall, 0u64, IoBuf())}
    }
  }

  pub fn callDone(self: &mut, c: &mut Completion, now: Instant) {
    match layer.take() {
      case var Some(l) {
        l.callDone(c, now);
        layer = Some[Uni[Layer]](l);
      }
      else {}
    }
    self.feed(now);
  }

  // A Layer's own calls that change it are made on it taken out of its Option and put
  // back (as the driver's takeLayer and putLayer do): a virtual call may change the
  // Option it came from, so no borrow of the Option is held across one
  fn lWireIn(self: &mut, buf: IoBuf, now: Instant) {
    match layer.take() {
      case var Some(l) {
        l.wireIn(buf, now);
        layer = Some[Uni[Layer]](l);
      }
      else {}
    }
  }

  fn lWireOut(self: &mut, now: Instant) IoBuf {
    var b = IoBuf();
    match layer.take() {
      case var Some(l) {
        b = l.wireOut(now);
        layer = Some[Uni[Layer]](l);
      }
      else {}
    }
    b
  }

  fn lPlainIn(self: &mut, buf: IoBuf) {
    match layer.take() {
      case var Some(l) {
        l.plainIn(buf);
        layer = Some[Uni[Layer]](l);
      }
      else {}
    }
  }

  fn lPlainOut(self: &mut) IoBuf {
    var b = IoBuf();
    match layer.take() {
      case var Some(l) {
        b = l.plainOut();
        layer = Some[Uni[Layer]](l);
      }
      else {}
    }
    b
  }

  fn lCloseSend(self: &mut) {
    match layer.take() {
      case var Some(l) {
        l.closeSend();
        layer = Some[Uni[Layer]](l);
      }
      else {}
    }
  }
}

// The earlier of an optional Instant and one more
fn soonest(a: Option[Instant], b: Instant) Option[Instant] {
  match a {
    case let Some(x) {if x < b {Some[Instant](x)} else {Some[Instant](b)}}
    else {Some[Instant](b)}
  }
}
