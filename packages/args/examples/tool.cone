// The sample in the args package's header: a program with a number option, a flag, a choice and files,
// declared once; the usage and the help come from the declaration.
//
//   congo run packages/args/examples/tool.cone -- -f 4 --speed fast a.txt b.txt
//   congo run packages/args/examples/tool.cone -- --help

mod tool;

import stdio use *;
import collections use *;
import args use *;

fn spec() Spec {
  var s = Spec.from("tool", "Counts frames and files.");
  s.add(Opt(name: "frames", short: 'f', kind: Kind.Int, default: "60", help: "frames to render"));
  s.add(Opt(name: "headless", kind: Kind.Flag, help: "no window"));
  s.add(Opt(name: "speed", kind: Kind.Choice("slow|fast"), default: "slow", help: "how hard to push"));
  s.positionals("FILE", "files to count", 0usize);
  s
}

fn run(s: &Spec) Result[u64, ArgError] {
  var r = ArgReader.fromEnv();                    // skips the program's name
  let m = s.parse(&mut r)?;
  let frames = m.int("frames");
  let files = m.rest();
  let speed = u64.from(m.choice("speed").index) + 1u64;
  Ok[u64, ArgError](u64.from(frames) * speed + u64.from(files.len()))
}

fn main() i32 {
  let s = spec();
  match run(&s) {
    case let Ok(n) { print <- n; print <- "\n"; 0i32 }
    case let Err(e) {
      match e {
        case let Help(text) { print <- text.view(); 0i32 }       // the library returns the help; the program prints it
        else { print <- toText(&e); print <- "\n"; 2i32 }
      }
    }
  }
}
