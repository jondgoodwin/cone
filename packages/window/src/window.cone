// The window package: a window to render into, opened and driven through SDL,
// and the glue of a render loop around it: the time each frame takes, and the
// events every window handles the same way.
//
//   mut win = Window.openVulkan("Horse World");
//   ... a gpu surface of win.sdlHandle(), a device, a swapchain ...
//   while win.running {
//     imm dt = win.nextFrame();        // seconds since the last frame
//     win.pollEvents();                // quit, Escape, F11, resizing
//     if win.resized { ... swapchain.resize(...); win.resized = false; }
//     ... draw with the render package, and present ...
//   }
//
// The window is made for Vulkan (SDL_WINDOW_VULKAN), which loads the Vulkan
// loader and makes no context. The gpu package draws into it: it makes a
// surface from 'sdlHandle', and presents each frame itself. 'size' is the
// drawable's size in pixels, which is what a swapchain is sized by, and
// 'resized' says when it changed. (Its OpenGL mode retired with the OpenGL
// renderer: the render package draws through gpu.)
//
// It is ported from the Pegasus3D browser: its window (window.cpp), the main
// loop's frame timing (pegasus3d.cpp), and the part of its world's input
// handling that belongs to the window rather than to a world (world.cpp): a
// quit or Escape stops the loop, F11 toggles fullscreen, and a resize is
// noted. Keys a world reacts to are the caller's: 'pollEvent' hands each
// event on after that handling, and 'keyDown' says which key an event
// pressed.
//
// It needs SDL2 (the sdl package): SDL2.lib on LIB to link, SDL2.dll on PATH
// to run, and a display.

mod window;

import libc;
import sdl;
import geomath use IRect;
import collections use String;

pub struct Window {
  sdlWindow *sdl.Window;
  pub fullscreen Bool;      // filling the screen (F11 toggles it)
  pub running Bool;         // false once asked to quit
  pub resized Bool;         // set when the window's size changes; the caller clears it
  lastTicks u32;            // SDL's clock at the last frame

  // Open a window for Vulkan to draw into: centered, three quarters of the
  // display each way, resizable, 'title' in its title bar. Making it loads
  // the Vulkan loader. Check 'isOpen': without a display, or without a
  // Vulkan loader, it is not, and SDL's reason has gone to stderr.
  pub fn openVulkan(title &[]u8) Window {
    // (Built from locals and made at the end: a function of the type that is
    // not a method may not set a private field of a value it holds.)
    if sdl.Init(sdl.INIT_VIDEO) < 0 {
      logSDLError("Failed to initialize SDL2's Video subsystem");
      return Window.unopened();
    }
    imm window = createWindow(title, sdl.WINDOW_VULKAN);
    if !window { return Window.unopened(); }
    Window[window, false, true, false, sdl.GetTicks()];
  }

  // A window that did not open: 'isOpen' is false, and everything else does
  // nothing
  fn unopened() Window {
    Window[0usize as *sdl.Window, false, false, false, 0u32];
  }

  // Whether the window opened
  pub fn isOpen(self &) Bool {
    if !sdlWindow { return false; }
    true;
  }

  // SDL's window, for making a Vulkan surface of it (gpu's 'createSurface')
  pub fn sdlHandle(self &) *sdl.Window { sdlWindow; }

  // Its drawable's size in pixels, as a rectangle at (0, 0): what a
  // swapchain is sized by (it differs from the window's on a high-DPI
  // display)
  pub fn size(self &) IRect {
    mut w = 0;
    mut h = 0;
    if self.isOpen() { sdl.Vulkan_GetDrawableSize(sdlWindow, &mut w, &mut h); }
    IRect[0, 0, w, h];
  }

  // Put 'title' in its title bar
  pub fn setTitle(self &mut, title &[]u8) {
    mut ctitle = String.from(title);
    if self.isOpen() { sdl.SetWindowTitle(sdlWindow, ctitle.cstr()); }
  }

  // Make the window 'w' by 'h' (in the window's units); a resize event
  // follows
  pub fn setSize(self &mut, w i32, h i32) {
    if self.isOpen() { sdl.SetWindowSize(sdlWindow, w, h); }
  }

  // Shrink the window to the taskbar, or bring it back
  pub fn minimize(self &mut) {
    if self.isOpen() { sdl.MinimizeWindow(sdlWindow); }
  }
  pub fn restore(self &mut) {
    if self.isOpen() { sdl.RestoreWindow(sdlWindow); }
  }

  // Fill the screen, or go back to a window
  pub fn setFullscreen(self &mut, on Bool) {
    fullscreen = on;
    if self.isOpen() {
      sdl.SetWindowFullscreen(sdlWindow, if on {sdl.WINDOW_FULLSCREEN_DESKTOP;} else {0u;});
    }
  }

  // The seconds since the last call (or since 'openVulkan'), for moving
  // things at a steady speed however fast frames come
  pub fn nextFrame(self &mut) f32 {
    imm now = sdl.GetTicks();
    imm dt = f32[now - lastTicks] / 1000.;
    lastTicks = now;
    dt;
  }

  // Take the next waiting event into 'event', handling it as every window
  // does: a quit, or Escape, clears 'running'; F11 toggles fullscreen; a
  // resize sets 'resized'. Answers false when no event was waiting. The
  // caller sees every event, handled or not.
  pub fn pollEvent(self &mut, event &mut sdl.Event) Bool {
    if sdl.PollEvent(event) == 0 { return false; }
    if event.type == sdl.QUIT {
      running = false;
    } elif event.type == sdl.WINDOWEVENT {
      imm we = event as &sdl.WindowEvent;
      if we.event == sdl.WINDOWEVENT_RESIZED or we.event == sdl.WINDOWEVENT_SIZE_CHANGED {
        resized = true;
      }
    } elif event.type == sdl.KEYDOWN {
      imm ke = event as &sdl.KeyboardEvent;
      if ke.keysym.sym == sdl.K_ESCAPE {
        running = false;
      } elif ke.keysym.sym == sdl.K_F11 {
        self.setFullscreen(!fullscreen);
      }
    }
    true;
  }

  // Handle every waiting event as 'pollEvent' does, and drop them
  pub fn pollEvents(self &mut) {
    mut event = sdl.Event.empty();
    while self.pollEvent(&mut event) {}
  }

  // Its end: the window, and SDL
  fn final(self &uni) {
    if sdlWindow { sdl.DestroyWindow(sdlWindow); }
    sdl.Quit();
  }
}

// The key (SDL's key code: sdl.K_...) an event pressed, or 0 if it is not
// a key pressed (a key held down and repeating counts once)
pub fn keyDown(event &sdl.Event) u32 {
  if event.type != sdl.KEYDOWN { return 0u; }
  imm ke = event as &sdl.KeyboardEvent;
  if ke.repeat != 0u8 { return 0u; }
  ke.keysym.sym;
}

// Make SDL's window: centered, three quarters of the display each way,
// resizable, with 'flags' for how it is drawn. Null, with SDL's reason on
// stderr, if it could not be made.
fn createWindow(title &[]u8, flags u32) *sdl.Window {
  mut bounds = sdl.Rect[0, 0, 1024, 768];
  sdl.GetDisplayBounds(0, &mut bounds);
  mut ctitle = String.from(title);
  imm window = sdl.CreateWindow(ctitle.cstr(), sdl.WINDOWPOS_CENTERED, sdl.WINDOWPOS_CENTERED,
    bounds.w * 3 / 4, bounds.h * 3 / 4, flags | sdl.WINDOW_RESIZABLE);
  if !window { logSDLError("Unable to open window"); }
  window;
}

// Report SDL's reason for a failure to stderr, after a message (Pegasus's
// logSDLError, which compared the error to "" by address, so always printed)
fn logSDLError(msg &[]u8) {
  mut m = String.from(msg);
  imm err = sdl.GetError();
  if *err != 0u8 {
    m <- ". SDL error message: ";
    mut i = 0usize;
    while *(err + i) != 0u8 {
      m.appendByte(*(err + i));
      i = i + 1usize;
    }
    sdl.ClearError();
  }
  logLine(m.view());
}

fn logLine(msg &[]u8) {
  mut m = String.from(msg);
  m.appendByte('\n');
  imm v = m.view();
  libc.fflush(libc.stdout());
  libc.fwrite(v, 1usize, v.len, libc.stderr());
}
