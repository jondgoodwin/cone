// Gaits as data: footfall patterns, stance counts, rules for any number of legs, choosing a gait by speed.
//
// Worked by hand. Quadruped offsets from the left hind's touchdown: walk LH 0, LF 1/4, RH 1/2, RF 3/4 (duty .68):
// four stances of .68 give 2.72 feet down on average, so 2 or 3 at any moment. Trot (duty .46): the pairs at 0 and
// 1/2 are down for .46 each, so 2 feet down for .92 of the cycle and none for .08. Canter: stances [0,.35), [.30,.65)
// twice, [.55,.90): one foot at [0,.30), three at [.30,.35), two at [.35,.55), three at [.55,.65), one at [.65,.90), and
// none for [.90,1): 0 to 3. Gallop (duty .28): [0,.28), [.13,.41), [.5,.78), [.63,.91): never more than 2, and none at
// [.41,.5) and [.91,1). Six legs by the alternating rule: two sets of three at 0 and 1/2, duty .6: 3 down at least.
// Eight: sets of four, duty .6: 4 at least. Ripple at six: rank offsets 0, 1/6, 1/3 plus 1/2 for the right side.

mod gait;

import testing use *;
import collections use *;
import geomath use *;
import bonepose use *;
import creaturerig use *;
import leggedgait use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

fn legsOf(spec RigSpec) LegSet {
  mut b = buildRig(&spec);
  imm rig = b.take();
  findLegs(&rig);
}

fn main() i32 {
  imm quad = legsOf(plainBody(&BodyParams.quadruped()));
  expectUInt(u64.from(quad.count()), 4u64, "four legs found");
  expectUInt(u64.from(quad.rankCount), 2u64, "in two ranks");
  imm set = standardGaits(&quad);
  expectUInt(u64.from(set.count()), 6u64, "six quadruped gaits");
  imm roles = quadRoles(&quad);
  expectBool(roles.ok, true, "the roles are found");
  imm walk = set.gaits[0usize];
  expectBool(walk.name.view() == "walk", true, "the first is the walk");
  near(*walk.offsets[roles.lh], 0., 0.0001, "walk: left hind at 0");
  near(*walk.offsets[roles.lf], 0.25, 0.0001, "left fore at 1/4");
  near(*walk.offsets[roles.rh], 0.5, 0.0001, "right hind at 1/2");
  near(*walk.offsets[roles.rf], 0.75, 0.0001, "right fore at 3/4");
  imm trot = set.gaits[usize.from(set.find("trot"))];
  near(*trot.offsets[roles.lf], *trot.offsets[roles.rh], 0.0001, "trot: the diagonal pair left fore and right hind together");
  near(*trot.offsets[roles.rf], *trot.offsets[roles.lh], 0.0001, "and the other pair");
  near(*trot.offsets[roles.lf] - *trot.offsets[roles.rf], -0.5, 0.0001, "half a cycle apart");
  imm pace = set.gaits[usize.from(set.find("pace"))];
  near(*pace.offsets[roles.lf], *pace.offsets[roles.lh], 0.0001, "pace: the left legs together");
  near(*pace.offsets[roles.rf], *pace.offsets[roles.rh], 0.0001, "the right legs together");
  imm canter = set.gaits[usize.from(set.find("canter"))];
  near(*canter.offsets[roles.rh], *canter.offsets[roles.lf], 0.0001, "canter: right hind and left fore land together");
  expectBool(*canter.offsets[roles.rf] > *canter.offsets[roles.lf] and *canter.offsets[roles.lf] > *canter.offsets[roles.lh], true, "after the trailing hind, before the leading fore");
  imm gallop = set.gaits[usize.from(set.find("gallop"))];
  expectBool(*gallop.offsets[roles.lh] < *gallop.offsets[roles.rh] and *gallop.offsets[roles.rh] < *gallop.offsets[roles.lf]
    and *gallop.offsets[roles.lf] < *gallop.offsets[roles.rf], true, "gallop: four beats, hind, hind, fore, fore");
  imm bound = set.gaits[usize.from(set.find("bound"))];
  near(*bound.offsets[roles.lf], *bound.offsets[roles.rf], 0.0001, "bound: the fore pair together");
  near(*bound.offsets[roles.lh], *bound.offsets[roles.rh], 0.0001, "and the hind pair");

  // Feet down over the cycle
  imm wr = stanceRange(walk);
  imm tr = stanceRange(trot);
  imm cr = stanceRange(canter);
  imm gr = stanceRange(gallop);
  near(wr.x, 2., 0.01, "walk: at least 2 feet down");
  near(wr.y, 3., 0.01, "at most 3");
  near(tr.x, 0., 0.01, "trot: a moment with none down");
  near(tr.y, 2., 0.01, "never more than 2");
  near(cr.x, 0., 0.01, "canter: a suspension");
  near(cr.y, 3., 0.01, "up to 3 down");
  near(gr.x, 0., 0.01, "gallop: a suspension");
  near(gr.y, 2., 0.01, "never more than 2 down");

  // Other numbers of legs
  imm six = legsOf(plainBody(&BodyParams.manyLegged(3u32, 0.2, 0.5)));
  imm sixSet = standardGaits(&six);
  expectBool(sixSet.gaits[0usize].name.view() == "ripple", true, "six legs: the ripple first");
  imm tripod = sixSet.gaits[1usize];
  near(stanceRange(tripod).x, 3., 0.01, "alternating tripods: 3 feet down at least");
  mut zeros = 0usize;
  mut halves = 0usize;
  mut i = 0usize;
  while i < 6usize {
    if absf(*tripod.offsets[i]) < 0.001 { zeros = zeros + 1usize; }
    if absf(*tripod.offsets[i] - 0.5) < 0.001 { halves = halves + 1usize; }
    i = i + 1usize;
  }
  expectUInt(u64.from(zeros), 3u64, "three legs in one tripod");
  expectUInt(u64.from(halves), 3u64, "three in the other");
  // No two legs of one side next to each other share a tripod
  mut clash = false;
  i = 0usize;
  while i < 6usize {
    mut j = 0usize;
    while j < 6usize {
      imm a = six.legs[i];
      imm b = six.legs[j];
      if i != j and a.side == b.side and (a.rank + 1usize == b.rank) and absf(*tripod.offsets[i] - *tripod.offsets[j]) < 0.001 { clash = true; }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  expectBool(clash, false, "neighbours on a side are in opposite tripods");
  imm ripple = sixSet.gaits[0usize];
  mut rear = 0usize;
  mut front = 0usize;
  i = 0usize;
  while i < 6usize {
    if six.legs[i].side < 0i32 and six.legs[i].rank == 2usize { rear = i; }
    if six.legs[i].side < 0i32 and six.legs[i].rank == 0usize { front = i; }
    i = i + 1usize;
  }
  near(*ripple.offsets[rear], 0., 0.0001, "ripple: the rear left leg first");
  near(*ripple.offsets[front], 1. / 3., 0.0001, "the front left leg 1/3 of the cycle later");
  imm eight = legsOf(plainBody(&BodyParams.manyLegged(4u32, 0.3, 0.8)));
  imm eightSet = standardGaits(&eight);
  near(stanceRange(eightSet.gaits[1usize]).x, 4., 0.01, "eight legs, alternating tetrapods: 4 feet down at least");
  imm two = legsOf(plainBody(&BodyParams.biped()));
  imm twoSet = standardGaits(&two);
  expectBool(twoSet.gaits[0usize].name.view() == "walk" and twoSet.gaits[1usize].name.view() == "run", true, "two legs: walk and run");
  near(stanceRange(twoSet.gaits[0usize]).x, 1., 0.01, "the biped's walk always has a foot down");
  near(stanceRange(twoSet.gaits[1usize]).x, 0., 0.01, "its run has a flight phase");

  // Choosing by speed (Froude number), with a hysteresis of 0.8 of the entry number
  expectUInt(u64.from(set.pick(0usize, 0.30)), 0u64, "0.30 from the walk stays a walk");
  expectUInt(u64.from(set.pick(0usize, 0.36)), 1u64, "0.36 goes to the trot");
  expectUInt(u64.from(set.pick(1usize, 0.30)), 1u64, "from the trot, 0.30 stays (above 0.28)");
  expectUInt(u64.from(set.pick(1usize, 0.27)), 0u64, "0.27 falls to the walk");
  expectUInt(u64.from(set.pick(0usize, 5.0)), 3u64, "from the walk at 5.0, straight to the gallop");
  expectUInt(u64.from(set.pick(3usize, 3.7)), 3u64, "the gallop is kept down to 3.6");
  expectUInt(u64.from(set.pick(3usize, 3.5)), 2u64, "and left under it, for the canter");
  expectUInt(u64.from(set.pick(2usize, 100.)), 3u64, "pace and bound are never chosen: the fastest automatic is the gallop");
  done();
}
