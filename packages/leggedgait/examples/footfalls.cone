// footfalls: the standard gaits of four, two, six and eight legs drawn as footfall charts, no GPU.
//
//   congo run packages/leggedgait/examples/footfalls.cone
//
// One line a leg, 40 columns across one stride cycle: '#' the foot is down, '.' it is in the air. Legs are named by
// side (L, R), rank (0 the front) and the gait's offset.

mod footfalls;

import stdio use *;
import collections use *;
import geomath use *;
import bonepose use *;
import creaturerig use *;
import leggedgait use *;

fn chart(legs &LegSet, g &Gait) {
  print <- "  "; printStr(g.name.view()); print <- " (duty "; print <- g.duty; print <- ", enters at Froude "; print <- g.enterFroude; print <- ")\n";
  var i = 0usize;
  while i < legs.count() {
    let l = legs.legs[i];
    print <- "    "; print <- if l.side < 0i32 { "L" } elif l.side > 0i32 { "R" } else { "C" }; print <- i64.from(l.rank); print <- " ";
    var c = 0usize;
    while c < 40usize {
      let p = frac(f32.from(c) / 40. - *g.offsets[i]);
      print <- if p < g.duty { "#" } else { "." };
      c = c + 1usize;
    }
    print <- "\n";
    i = i + 1usize;
  }
}

fn show(name &str, spec RigSpec) {
  var b = buildRig(&spec);
  let rig = b.take();
  let legs = findLegs(&rig);
  let set = standardGaits(&legs);
  print <- name; print <- ": "; print <- i64.from(legs.count()); print <- " legs\n";
  var g = 0usize;
  while g < set.count() { chart(&legs, set.gaits[g]); g = g + 1usize; }
}

fn main() i32 {
  show("quadruped", plainBody(&BodyParams.quadruped()));
  show("biped", plainBody(&BodyParams.biped()));
  show("six legs", plainBody(&BodyParams.manyLegged(3u32, 0.2, 0.5)));
  show("eight legs", plainBody(&BodyParams.manyLegged(4u32, 0.3, 0.8)));
  0i32
}
