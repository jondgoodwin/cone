// Gaits as data: a footfall pattern, and what goes with it.
//
// A GAIT is, for N legs, a phase OFFSET per leg (the fraction of the stride
// cycle at which the leg touches down, counted from the reference leg's
// touchdown) and a DUTY FACTOR (the share of the cycle a foot is on the
// ground), after Hildebrand's description of the gaits of quadrupeds (1965,
// 1976, "Analysis of symmetrical gaits of tetrapods"), which is how the
// field writes them down: a leg is in stance from its offset for `duty` of
// the cycle, and in swing for the rest. Walk, trot, pace, canter, gallop and
// bound for four legs are rows of offsets and a duty (below); other numbers of
// legs get their patterns from two rules (below) that reproduce the quadruped
// walk and trot at four, the biped walk at two, and the insects' tripod gait
// at six and the spiders' alternating tetrapod at eight.
//
// The numbers in the tables are the textbook ones, rounded: they were
// written from memory of Hildebrand's and of Alexander's figures (Alexander,
// "Principles of animal locomotion", 2003), NOT fetched and checked, and are
// marked (T) where they were tuned for how the result looks.
//
// A gait carries more than the pattern: how high the foot lifts (STEP), the
// bounce of the body, and how hard each chain of the body (spine, neck, head,
// tail) moves, as an amplitude for each of the set's chain motions. A gait
// chosen from speed (GaitSet.pick) carries a Froude number (v^2 / g h, h the hip
// height) at which it begins, Alexander's dimensionless speed, which makes the
// transitions come at speeds in proportion to the creature (a small animal
// trots at a lower speed than a large one).

// A chain that moves with the stride, and how (see Locomotion)
pub struct ChainMotion {
  pub kind u32;        // chains of this kind move (never legs: they are placed by IK)
  pub axis u32;        // the rotation's axis: AXIS_PITCH (x), AXIS_YAW (y) or AXIS_ROLL (z)
  pub harmonic f32;    // cycles per stride
  pub phase f32;       // cycles, from the reference leg's phase
  pub lag f32;         // cycles of lag a bone further along the chain
  pub taper f32;       // the share of the motion grows this much a bone along the chain (0: even)
}

// The axes a motion may turn about, in the creature's own frame. A positive
// pitch raises something that points forward (the nose); a positive yaw turns it
// to the left; a positive roll raises the right side.
pub const AXIS_PITCH = 0u32;
pub const AXIS_YAW = 1u32;
pub const AXIS_ROLL = 2u32;

pub struct Gait {
  pub name String;
  pub offsets List[f32];     // one a leg, in the LegSet's order
  pub duty f32;
  pub enterFroude f32;       // the Froude number from which it is chosen going faster
  pub automatic bool;        // false: only by name
  pub stepHeight f32;        // swing clearance, a fraction of the leg's reach
  pub strideScale f32;       // 1 for the stride the speed alone gives
  pub bounce1 f32;           // the body's vertical bounce once a stride, a fraction of reach (positive: low at BOUNCE1_PHASE)
  pub bounce2 f32;           // and twice a stride
  pub amps List[f32];        // the amplitude of each of the set's chain motions, radians over the chain
}

pub struct GaitSet {
  pub gaits List[Gait];
  pub motions List[ChainMotion];
  pub transition f32;        // seconds the pattern takes to change from one gait to the next
  pub gravity f32;           // m/s^2, for the Froude number
  pub startSpeed f32;        // m/s, below which a creature stands (hysteresis: it must pass startSpeed to move,
  pub stopSpeed f32;         // and fall under stopSpeed to stop)
  pub hysteresis f32;        // a gait is left going slower at this fraction of its entry Froude number
  pub swingTime f32;         // seconds a foot takes to finish a step when the creature has stopped
  pub bounce1Phase f32;      // where the bounces are, in cycles of the reference leg's phase
  pub bounce2Phase f32;

  pub fn count(self &) usize { gaits.len() }

  // The gait called 'name': its number, or -1
  pub fn find(self &, name &str) i32 {
    var i = 0usize;
    while i < gaits.len() {
      if gaits[i].name.view() == name { return i32.from(i); }
      i = i + 1usize;
    }
    -1i32
  }

  // The gait speed chooses, from where the creature is. 'froude' is v^2 / (g h). Going
  // faster, the highest automatic gait whose entry number the speed has passed; going
  // slower, the current gait is kept until the speed falls under `hysteresis` times its
  // entry number, then the next lower automatic one.
  pub fn pick(self &, current usize, froude f32) usize {
    var best = current;
    // Up
    var i = current + 1usize;
    while i < gaits.len() {
      if gaits[i].automatic && froude >= gaits[i].enterFroude { best = i; }
      i = i + 1usize;
    }
    if best != current { return best; }
    // Down: while below the current gait's own exit threshold, fall to the next lower automatic gait
    if !gaits[current].automatic { return current; }
    var cur = current;
    while cur > 0usize && froude < gaits[cur].enterFroude * hysteresis {
      var lower = cur;
      var k = cur;
      while k > 0usize {
        k = k - 1usize;
        if gaits[k].automatic { lower = k; k = 0usize; }
      }
      if lower == cur { return cur; }
      cur = lower;
    }
    cur
  }
}

// ------------------------------------------------------------------------- feet in stance

// How many of the legs have a foot on the ground at 'phase' (0 to 1 through the cycle): leg i is in
// stance from offsets[i] for 'duty' of the cycle
pub fn stanceCount(g &Gait, phase f32) usize {
  var n = 0usize;
  var i = 0usize;
  while i < g.offsets.len() {
    var p = phase - *g.offsets[i];
    p = p - libc.floorf(p);
    if p < g.duty { n = n + 1usize; }
    i = i + 1usize;
  }
  n
}

// The least and most legs on the ground over the cycle (sampled 400 times, plus the instants just before and after each touchdown and lift)
pub fn stanceRange(g &Gait) Vec2 {
  var lo = 1000.f;
  var hi = 0.f;
  var k = 0usize;
  while k < 400usize {
    let c = f32.from(stanceCount(g, (f32.from(k) + 0.5) / 400.));
    if c < lo { lo = c; }
    if c > hi { hi = c; }
    k = k + 1usize;
  }
  new Vec2(lo, hi)
}

// ------------------------------------------------------------------------- the patterns

fn sideIndex(l &LegInfo) usize {
  if l.side < 0i32 { return 0usize; }
  if l.side > 0i32 { return 1usize; }
  l.rank % 2usize
}

// ALTERNATING. Legs in two sets, each set on the ground while the other swings: a leg is in the
// first set if (its rank + its side index) is even, counting the left as 0 and the right as 1. At
// two legs this is a biped's walk or run; at four, the diagonal pairs of the trot; at six, the
// insects' alternating tripods (a front and a rear leg on one side with the middle leg of the other,
// Wilson 1966); at eight, the spiders' alternating tetrapods.
pub fn alternatingOffsets(legs &LegSet) List[f32] {
  var out = List[f32].empty();
  var i = 0usize;
  while i < legs.count() {
    let l = legs.legs[i];
    let even = (l.rank + sideIndex(l)) % 2usize == 0usize;
    out.push(if even { 0. } else { 0.5 });
    i = i + 1usize;
  }
  out
}

// RIPPLE (a metachronal wave). A wave of touchdowns runs from the rear rank to the front along each side, the
// other side half a cycle behind: leg offset = (ranks from the rear) / (2 x rank count), plus a half for the right
// side. At four legs this is the walk (rear left, front left, rear right, front right: 0, 1/4, 1/2, 3/4, the lateral
// sequence); at six, the ripple gait of insects at slow speed; at eight, the spiders' wave.
pub fn rippleOffsets(legs &LegSet) List[f32] {
  var out = List[f32].empty();
  var i = 0usize;
  while i < legs.count() {
    let l = legs.legs[i];
    let fromRear = f32.from(legs.rankCount - 1usize - l.rank);
    var o = fromRear / (2. * f32.from(legs.rankCount));
    if l.side > 0i32 { o = o + 0.5; }
    out.push(o);
    i = i + 1usize;
  }
  out
}

// LATERAL PAIRS (the pace): both legs of a side together, the sides half a cycle apart
pub fn lateralOffsets(legs &LegSet) List[f32] {
  var out = List[f32].empty();
  var i = 0usize;
  while i < legs.count() {
    out.push(if legs.legs[i].side > 0i32 { 0.5 } else { 0. });
    i = i + 1usize;
  }
  out
}

// Which leg is which on a four-legged body: the numbers of the left fore, right fore, left hind and right hind legs, or
// -1 for each if the body is not two ranks of a left and a right leg
pub struct QuadRoles {
  pub ok bool;
  pub lf usize;
  pub rf usize;
  pub lh usize;
  pub rh usize;
}

pub fn quadRoles(legs &LegSet) QuadRoles {
  if legs.count() != 4usize || legs.rankCount != 2usize { return new QuadRoles(false, 0usize, 0usize, 0usize, 0usize); }
  var lf = 100usize;
  var rf = 100usize;
  var lh = 100usize;
  var rh = 100usize;
  var i = 0usize;
  while i < 4usize {
    let l = legs.legs[i];
    if l.rank == 0usize && l.side < 0i32 { lf = i; }
    if l.rank == 0usize && l.side > 0i32 { rf = i; }
    if l.rank == 1usize && l.side < 0i32 { lh = i; }
    if l.rank == 1usize && l.side > 0i32 { rh = i; }
    i = i + 1usize;
  }
  new QuadRoles(lf < 4usize && rf < 4usize && lh < 4usize && rh < 4usize, lf, rf, lh, rh)
}

// The standard chain motions (indices used by the gaits below)
pub const MOTION_SPINE_PITCH = 0usize;
pub const MOTION_SPINE_YAW = 1usize;
pub const MOTION_NECK_PITCH = 2usize;
pub const MOTION_HEAD_PITCH = 3usize;
pub const MOTION_TAIL_YAW = 4usize;
pub const MOTION_TAIL_PITCH = 5usize;
pub const MOTION_COUNT = 6usize;

pub fn standardMotions() List[ChainMotion] {
  var m = List[ChainMotion].empty();
  // The spine arches (flexes) in the gathered suspension, just before the reference (hind) leg lands, and
  // extends in the extended suspension half a stride earlier: cos(2 pi (p - 0.95)) = sin(2 pi (p - 0.7))
  m.push(new ChainMotion(KIND_SPINE, AXIS_PITCH, 1., 0.30, 0., 0.));
  // A side-to-side undulation of the spine, once a stride (the lateral bending of a walking quadruped)
  m.push(new ChainMotion(KIND_SPINE, AXIS_YAW, 1., 0.0, 0.04, 0.));
  // The neck nods once a stride, the head following a little late
  m.push(new ChainMotion(KIND_NECK, AXIS_PITCH, 1., 0.05, 0.04, 0.));
  m.push(new ChainMotion(KIND_HEAD, AXIS_PITCH, 1., 0.15, 0.05, 0.));
  // The tail sways against the hips, each bone later than the one before, and rises and falls with the bounce
  m.push(new ChainMotion(KIND_TAIL, AXIS_YAW, 1., 0.25, 0.10, 0.4));
  m.push(new ChainMotion(KIND_TAIL, AXIS_PITCH, 1., 0.0, 0.10, 0.4));
  m
}

fn amps(spinePitch f32, spineYaw f32, neck f32, head f32, tailYaw f32, tailPitch f32) List[f32] {
  var a = List[f32].empty();
  a.push(spinePitch); a.push(spineYaw); a.push(neck); a.push(head); a.push(tailYaw); a.push(tailPitch);
  a
}

fn offsetsFor(roles &QuadRoles, lf f32, rf f32, lh f32, rh f32) List[f32] {
  var o = List[f32].empty();
  var i = 0usize;
  while i < 4usize { o.push(0.); i = i + 1usize; }
  o.set(roles.lf, lf);
  o.set(roles.rf, rf);
  o.set(roles.lh, lh);
  o.set(roles.rh, rh);
  o
}

fn newGait(name &str, offsets List[f32], duty f32, enter f32, automatic bool, step f32, stride f32, b1 f32, b2 f32,
    a List[f32]) Gait {
  new Gait(String.from(name), offsets, duty, enter, automatic, step, stride, b1, b2, a)
}

fn newSet(gaits List[Gait]) GaitSet {
  new GaitSet(gaits, standardMotions(), 0.35, 9.81, 0.10, 0.05, 0.8, 0.30, 0.04, -0.07)
}

// The standard gaits of a body with these legs.
//
// FOUR LEGS (two ranks of a left and right), after Hildebrand, offsets from the left hind's touchdown:
//   walk    lateral sequence: left hind 0, left fore 1/4, right hind 1/2, right fore 3/4; duty 0.68
//   trot    diagonal pairs together: left hind and right fore at 1/2, right hind and left fore at 0; duty 0.46
//   pace    lateral pairs together: both left legs at 0, both right at 1/2; duty 0.50 (not chosen by speed)
//   canter  three beats, right lead: left hind 0, then right hind with left fore at 0.30, then right fore at
//           0.55 (the beats are not evenly spaced: a stretch of 0.10 of the cycle with no foot down follows the
//           leading fore); duty 0.35
//   gallop  four beats, transverse, right lead: left hind 0, right hind 0.13, left fore 0.50, right fore 0.63;
//           duty 0.28
//   bound   the pairs together, hind pair 0, fore pair 1/2 (small mammals); duty 0.30 (not chosen by speed)
// entered at Froude numbers 0, 0.35, 2.0 and 4.5 (T, from where a horse's gaits fall in Froude terms).
//
// OTHER NUMBERS OF LEGS: the alternating rule for the faster gaits and the ripple rule for the slow one.
//   two legs   walk (alternating, duty 0.62) from 0, run (alternating, duty 0.38) from Froude 0.5 (Alexander's
//              walk-run transition), hop (both legs together, duty 0.40; not chosen by speed)
//   other      ripple (duty 0.75) from 0, then alternating (duty 0.60) from Froude 0.25, then alternating at
//              duty 0.50 from Froude 1.5 (T)
pub fn standardGaits(legs &LegSet) GaitSet {
  var gaits = List[Gait].empty();
  let roles = quadRoles(legs);
  if roles.ok {
    gaits.push(newGait("walk", offsetsFor(&roles, 0.25, 0.75, 0., 0.5), 0.68, 0., true, 0.14, 1., 0.010, 0.012, amps(0., 0.10, 0.12, 0.06, 0.25, 0.04)));
    gaits.push(newGait("trot", offsetsFor(&roles, 0., 0.5, 0.5, 0.), 0.46, 0.35, true, 0.20, 1., 0.0, 0.030, amps(0.04, 0.04, 0.05, 0.02, 0.15, 0.08)));
    gaits.push(newGait("canter", offsetsFor(&roles, 0.30, 0.55, 0., 0.30), 0.35, 2.0, true, 0.25, 1., 0.045, 0.0, amps(0.12, 0.02, 0.14, 0.05, 0.05, 0.12)));
    gaits.push(newGait("gallop", offsetsFor(&roles, 0.5, 0.63, 0., 0.13), 0.28, 4.5, true, 0.28, 1., 0.065, 0.0, amps(0.30, 0., 0.10, 0.04, 0.02, 0.15)));
    gaits.push(newGait("pace", offsetsFor(&roles, 0., 0.5, 0., 0.5), 0.50, 0., false, 0.18, 1., 0.0, 0.020, amps(0.02, 0.12, 0.06, 0.03, 0.20, 0.06)));
    gaits.push(newGait("bound", offsetsFor(&roles, 0.5, 0.5, 0., 0.), 0.30, 0., false, 0.26, 1., 0.060, 0.0, amps(0.34, 0., 0.08, 0.03, 0.02, 0.12)));
  } elif legs.count() == 2usize {
    gaits.push(newGait("walk", alternatingOffsets(legs), 0.62, 0., true, 0.10, 1., 0.0, 0.020, amps(0., 0.05, 0.08, 0.04, 0.12, 0.03)));
    gaits.push(newGait("run", alternatingOffsets(legs), 0.38, 0.5, true, 0.22, 1., 0.0, 0.050, amps(0.03, 0.04, 0.05, 0.02, 0.08, 0.06)));
    var together = List[f32].empty();
    together.push(0.); together.push(0.);
    gaits.push(newGait("hop", together, 0.40, 0., false, 0.28, 1., 0.060, 0., amps(0.06, 0., 0.06, 0.03, 0., 0.08)));
  } else {
    gaits.push(newGait("ripple", rippleOffsets(legs), 0.75, 0., true, 0.18, 1., 0.0, 0.010, amps(0., 0.06, 0., 0., 0.05, 0.)));
    gaits.push(newGait("alternating", alternatingOffsets(legs), 0.60, 0.25, true, 0.22, 1., 0.0, 0.015, amps(0., 0.05, 0., 0., 0.05, 0.)));
    gaits.push(newGait("fast alternating", alternatingOffsets(legs), 0.50, 1.5, true, 0.26, 1., 0.0, 0.025, amps(0., 0.04, 0., 0., 0.04, 0.)));
  }
  newSet(gaits)
}
