// ======== Hulls: closed triangle meshes a body floats by ========
//
// A Hull is what a floating body's buoyancy is worked out from: a CLOSED triangle mesh, outward
// normals (counter-clockwise from outside), in the body's own coordinates (the origin of the rigid
// body's shape). Any closed mesh floats: a box, a barrel, a boat, an imported model. Three ways to make
// one, all data:
//
//   Hull.box(half)            a box of half sizes 'half'
//   Hull.loft(stations)       a hull lofted through cross-section outlines along x (a boat, a log, a
//                             barrel, a buoy): each Station is an x and a closed outline in the (z, y)
//                             plane, counter-clockwise with z to the right and y up, every outline of the
//                             same number of points; the ends are capped
//   Hull.fromMesh(mesh)       the triangles of a mesh (render's or sculpt's), taken as they are
//
// It also knows its volume, the point its volume balances about, its size and its length (what the
// skin friction's Reynolds number needs), by the divergence theorem over its triangles.

pub struct Station {
  pub x: f32;                 // along the hull (bow at the larger x)
  pub outline: List[Vec2];    // the section in the (z, y) plane: x = z across, y = height, counter-clockwise
}

pub struct Hull {
  pub points: List[Vec3];
  pub tris: List[u32];        // three indices a triangle, counter-clockwise from outside
  pub volume: f32;            // m^3
  pub centroid: Vec3;         // the centre of the volume
  pub length: f32;            // the longest extent of its box, m
  pub lowest: f32;            // the box's lowest and highest y
  pub highest: f32;

  // The hull of a closed triangle mesh: positions 'p', triangles 'idx' (three each, outward). The
  // volume is the sum over triangles of the signed volume of the tetrahedron it makes with the origin
  // (a . (b x c) / 6): positive for outward windings. A mesh that comes out negative is wound
  // inward, and is flipped.
  pub fn make(p: List[Vec3], idx: List[u32]) Hull {
    var v = 0.0;
    var cx = 0.0;
    var cy = 0.0;
    var cz = 0.0;
    var t = 0usize;
    while t + 2usize < idx.len() {
      let a = *p[usize.from(*idx[t])];
      let b = *p[usize.from(*idx[t + 1usize])];
      let c = *p[usize.from(*idx[t + 2usize])];
      let vol = f64.from(a.dot(b.cross(c))) / 6.0;
      v = v + vol;
      // the tetrahedron's centroid is (a + b + c) / 4 (the origin is its fourth vertex)
      cx = cx + vol * f64.from(a.x + b.x + c.x) * 0.25;
      cy = cy + vol * f64.from(a.y + b.y + c.y) * 0.25;
      cz = cz + vol * f64.from(a.z + b.z + c.z) * 0.25;
      t = t + 3usize;
    }
    var tris = idx;
    if v < 0.0 {
      var k = 0usize;
      while k + 2usize < tris.len() { tris.swap(k + 1usize, k + 2usize); k = k + 3usize; }
      v = 0.0 - v;
      cx = 0.0 - cx; cy = 0.0 - cy; cz = 0.0 - cz;
    }
    let vf = if v > 0.000000001 { v } else { 1.0 };
    var lo = Vec3(1.0e9, 1.0e9, 1.0e9);
    var hi = Vec3(-1.0e9, -1.0e9, -1.0e9);
    var i = 0usize;
    while i < p.len() {
      lo = lo.min(*p[i]);
      hi = hi.max(*p[i]);
      i = i + 1usize;
    }
    let ext = hi - lo;
    let longest = if ext.x > ext.y && ext.x > ext.z { ext.x } elif ext.y > ext.z { ext.y } else { ext.z };
    Hull(p, tris, f32.from(v), Vec3(f32.from(cx / vf), f32.from(cy / vf), f32.from(cz / vf)), longest, lo.y, hi.y)
  }

  pub fn fromMesh(m: &Mesh) Hull {
    var p = List[Vec3].withCapacity(m.positions.len());
    var i = 0usize;
    while i < m.positions.len() { p.push(*m.positions[i]); i = i + 1usize; }
    var t = List[u32].withCapacity(m.indices.len());
    i = 0usize;
    while i < m.indices.len() { t.push(*m.indices[i]); i = i + 1usize; }
    Hull.make(p, t)
  }

  pub fn box(half: Vec3) Hull {
    var p = List[Vec3].empty();
    var z = -1.f;
    while z <= 1. {
      var y = -1.f;
      while y <= 1. {
        var x = -1.f;
        while x <= 1. { p.push(Vec3(x * half.x, y * half.y, z * half.z)); x = x + 2.; }
        y = y + 2.;
      }
      z = z + 2.;
    }
    // vertices numbered x + 2 y + 4 z (as bits): 12 triangles, outward
    var t = List[u32].empty();
    let quads = [[1u32, 0u32, 2u32, 3u32], [4u32, 5u32, 7u32, 6u32], [0u32, 1u32, 5u32, 4u32], [3u32, 2u32, 6u32, 7u32],
      [2u32, 0u32, 4u32, 6u32], [1u32, 3u32, 7u32, 5u32]];
    var q = 0usize;
    while q < 6usize {
      t.push(quads[q][0usize]); t.push(quads[q][1usize]); t.push(quads[q][2usize]);
      t.push(quads[q][0usize]); t.push(quads[q][2usize]); t.push(quads[q][3usize]);
      q = q + 1usize;
    }
    Hull.make(p, t)
  }

  // Loft the stations (in order of increasing x) into a closed hull: the sides between consecutive
  // outlines, and a fan of triangles closing each end from the outline's centre
  pub fn loft(stations: &List[Station]) Hull {
    var p = List[Vec3].empty();
    var t = List[u32].empty();
    let ns = stations.len();
    let m = stations[0usize].outline.len();
    var s = 0usize;
    while s < ns {
      var i = 0usize;
      while i < m {
        let o = *stations[s].outline[i];
        p.push(Vec3(stations[s].x, o.y, o.x));
        i = i + 1usize;
      }
      s = s + 1usize;
    }
    s = 0usize;
    while s + 1usize < ns {
      var i = 0usize;
      while i < m {
        let j = (i + 1usize) % m;
        let a = u32.from(s * m + i);
        let a2 = u32.from(s * m + j);
        let b = u32.from((s + 1usize) * m + i);
        let b2 = u32.from((s + 1usize) * m + j);
        // counter-clockwise outlines (z right, y up) wind these sides outward. A lofted quad is not flat,
        // so which diagonal splits it matters: it is chosen by the side of the hull the quad is on, so
        // that a symmetrical hull is symmetrical in its triangles too (the mirror of one diagonal is the other)
        if stations[s].outline[i].x + stations[s].outline[j].x >= 0. {
          t.push(a); t.push(b); t.push(a2);
          t.push(a2); t.push(b); t.push(b2);
        } else {
          t.push(a); t.push(b); t.push(b2);
          t.push(a); t.push(b2); t.push(a2);
        }
        i = i + 1usize;
      }
      s = s + 1usize;
    }
    // the caps: a centre point of each end's outline and a fan
    var e = 0;
    while e < 2 {
      let station = if e == 0 { 0usize } else { ns - 1usize };
      var cy = 0.f;
      var cz = 0.f;
      var i = 0usize;
      while i < m { cy = cy + stations[station].outline[i].y; cz = cz + stations[station].outline[i].x; i = i + 1usize; }
      let centre = u32.from(p.len());
      p.push(Vec3(stations[station].x, cy / f32.from(m), cz / f32.from(m)));
      i = 0usize;
      while i < m {
        let j = (i + 1usize) % m;
        let a = u32.from(station * m + i);
        let a2 = u32.from(station * m + j);
        // seen from +x the outline runs clockwise, from -x counter-clockwise
        if e == 0 { t.push(centre); t.push(a); t.push(a2); } else { t.push(centre); t.push(a2); t.push(a); }
        i = i + 1usize;
      }
      e = e + 1;
    }
    Hull.make(p, t)
  }

  // The points as a slice (for a collision hull)
  pub fn pointArray(self: &) &Array[Vec3] { points.view() }
}
