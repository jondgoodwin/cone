// A texture of fibres for cards, painted from rules (no file).
//
// An atlas of 'columns' variants across, each 'colWidth' pixels wide and 'height' tall, rows from the bottom up (render's
// Image holds them so; v = 0 is the root's end). In each variant a handful of fibre curves run the card's length: each a
// soft-edged line with its own place across, its own slow wander, its own brightness, and its own end (fibres end at
// different lengths and thin to a point, which is what makes a lock's tip look like hair and not like a cut ribbon). The
// alpha is the fibres' coverage (render cuts the card out below a cut-off of it and keeps the covered share in its mip
// chain); the colour is a streaky near-white, darkest at the root (where hair is dense and shadowed), for the material's
// base colour to multiply.

pub struct FiberPixels {
  pub width i32;
  pub height i32;
  pub rgba List[u8];

  pub fn make(width i32, height i32) FiberPixels {
    mut p = new FiberPixels(width, height, List[u8].empty());
    p.rgba.resize(usize.from(width * height * 4), 255u8);
    p;
  }
}

fn smooth(a f32, b f32, x f32) f32 {
  imm t = if (x - a) / (b - a) < 0. { 0.; } elif (x - a) / (b - a) > 1. { 1.; } else { (x - a) / (b - a); };
  t * t * (3. - 2. * t);
}

// One fibre
struct Fiber {
  base f32;
  wander f32;
  freq f32;
  phase f32;
  half f32;
  bright f32;
  end f32;
}

fn byteOf(x f32) u8 {
  imm v = if x < 0. { 0.; } elif x > 1. { 1.; } else { x; };
  u8.from(i32.from(v * 255. + 0.5));
}

// The atlas
pub fn paintFibers(columns i32, colWidth i32, height i32, fibres i32, seed u32) FiberPixels {
  mut p = FiberPixels.make(columns * colWidth, height);
  mut c = 0;
  while c < columns {
    mut rnd = Rand.make(seed + u32.from(c) * 7919u32);
    mut fs = List[Fiber].empty();
    mut k = 0;
    while k < fibres {
      imm slot = (f32.from(k) + 0.5) / f32.from(fibres);
      fs.push(new Fiber(0.04 + 0.92 * slot + rnd.signed() * 0.25 / f32.from(fibres), 0.012 + 0.02 * rnd.unit(), 1. + 2. * rnd.unit(),
        rnd.unit() * 2. * pi, 0.016 + 0.03 * rnd.unit(), 0.72 + 0.4 * rnd.unit(), 0.78 + 0.3 * rnd.unit()));
      k = k + 1;
    }
    mut y = 0;
    while y < height {
      imm v = (f32.from(y) + 0.5) / f32.from(height);
      imm ao = 0.52 + 0.48 * smooth(0., 0.22, v);
      mut x = 0;
      while x < colWidth {
        imm u = (f32.from(x) + 0.5) / f32.from(colWidth);
        mut cover = 0.;
        mut tone = 0.;
        mut weight = 0.;
        mut q = 0usize;
        while q < fs.len() {
          imm f = fs[q];
          imm centre = f.base + f.wander * sin(2. * pi * f.freq * v + f.phase);
          imm taper = 1. - smooth(f.end - 0.3, f.end, v);
          imm hw = f.half * (0.35 + 0.65 * taper);
          imm d = (u - centre) / hw;
          imm a = if v > f.end { 0.; } else { 1. - smooth(0.55, 1., if d < 0. { -d; } else { d; }); };
          if a > cover { cover = a; }
          tone = tone + a * f.bright;
          weight = weight + a;
          q = q + 1usize;
        }
        imm shade = if weight > 0.0001 { tone / weight; } else { 0.85; };
        imm i = usize.from((((y * columns * colWidth) + c * colWidth + x)) * 4);
        imm lum = shade * ao;
        p.rgba.set(i, byteOf(lum));
        p.rgba.set(i + 1usize, byteOf(lum));
        p.rgba.set(i + 2usize, byteOf(lum));
        p.rgba.set(i + 3usize, byteOf(cover));
        x = x + 1;
      }
      y = y + 1;
    }
    c = c + 1;
  }
  p;
}
