// Bench: what one 10 ms block (480 frames at 48 kHz) costs the audio thread
// with 32 voices, on the real clock, for three loads:
//
// - plain: 32 looping sample voices, panned, through the buses;
// - spatial: 32 looping sample voices as 3-D sources, each with distance
//   attenuation, head shadow, Doppler (resampling at a moving pitch) and
//   occlusion filtering;
// - synth: 32 procedural voices, a mix of wind, brook, fire, steps and birds.
//
// It prints the mean and the worst block in microseconds and as a fraction
// of the 10 ms the block must be ready in. The render is allocation-free;
// it is timed after a warm-up. Build it optimised to measure:
//
//   congo run --release examples/bench.cone

mod bench;

import stdio use *;
import collections use *;
import geomath use *;
import time use Duration, Instant;
import audiomixer use *;

const R = 48000.;
const FRAMES = 480usize;
const BLOCKS = 2000;

fn tone(freq f32, seconds f32) Sound {
  mut s = List[f32].empty();
  mut o = Osc.make(WAVE_SAW);
  imm n = usize.from(seconds * R);
  mut i = 0usize;
  while i < n { s.push(o.next(freq, R) * 0.2); i = i + 1usize; }
  new Sound(48000u32, 1u32, s);
}

fn measure(name &str, m &mut Mixer) {
  mut out = List[f32].empty();
  mut i = 0usize;
  while i < FRAMES * 2usize { out.push(0.); i = i + 1usize; }
  mut k = 0;
  while k < 200 { m.render(out.viewMut(), FRAMES); k = k + 1; }
  mut worst = 0i64;
  mut total = 0i64;
  k = 0;
  while k < BLOCKS {
    imm t0 = Instant.now();
    m.render(out.viewMut(), FRAMES);
    imm dt = t0.elapsed().nanos();
    total = total + dt;
    if dt > worst { worst = dt; }
    k = k + 1;
  }
  imm mean = f64.from(total) / f64.from(BLOCKS) / 1000.0d;
  printStr(name);
  printStr(": mean ");
  printFloat(mean);
  printStr(" us per 10 ms block (");
  printFloat(mean / 100.0d);
  printStr(" % of real time), worst ");
  printFloat(f64.from(worst) / 1000.0d);
  printStr(" us\n");
}

fn main() i32 {
  imm saw = tone(220., 3.);
  {
    mut m = Mixer.make(R, 32usize);
    m.apply(&Cmd.addSound(0u32, &saw));
    mut v = 1u32;
    while v <= 32u32 {
      m.apply(&Cmd.play(v, 0u32, 1u32 + v % 3u32, 0.2, 1. + f32.from(v) * 0.01, f32.from(v % 7u32) / 3.5 - 1., true, 0i32, 0.));
      v = v + 1u32;
    }
    printStr("voices active: "); printUInt(u64.from(m.activeVoices())); printStr("\n");
    measure("plain 32 samples", &mut m);
  }
  {
    mut m = Mixer.make(R, 32usize);
    m.apply(&Cmd.addSound(0u32, &saw));
    mut v = 1u32;
    while v <= 32u32 {
      m.apply(&Cmd.play(v, 0u32, 2u32, 0.2, 1., 0., true, 0i32, 0.));
      m.apply(&Cmd.spatial(v, new Vec3(f32.from(v) * 2. - 30., 0., -10. - f32.from(v)), new Vec3(5., 0., 3.)));
      m.apply(&Cmd.occlusion(v, f32.from(v % 3u32) * 0.4));
      v = v + 1u32;
    }
    measure("spatial 32 samples (attenuation, head shadow, Doppler, occlusion)", &mut m);
  }
  {
    mut m = Mixer.make(R, 32usize);
    mut v = 1u32;
    while v <= 32u32 {
      imm kind = v % 5u32;
      if kind == 0u32 { m.apply(&Cmd.playSynth(v, SYNTH_WIND, v, BUS_AMBIENCE, 0.3, 0.6, 0., 0i32)); }
      elif kind == 1u32 { m.apply(&Cmd.playSynth(v, SYNTH_WATER, v, BUS_AMBIENCE, 0.3, 0.6, 0., 0i32)); }
      elif kind == 2u32 { m.apply(&Cmd.playSynth(v, SYNTH_FIRE, v, BUS_EFFECTS, 0.3, 0.6, 0.5, 0i32)); }
      else { m.apply(&Cmd.playSynth(v, SYNTH_WIND, v, BUS_AMBIENCE, 0.3, 0.9, 0., 0i32)); }
      v = v + 1u32;
    }
    measure("synth 32 voices (wind, brook, fire)", &mut m);
  }
  0i32;
}
