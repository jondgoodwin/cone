// ======== Measuring a rendered buffer: levels, frequency, spectrum ========
//
// Tests and the recipe example judge sound by numbers, because nobody listens
// to a build. These allocate and are not for the audio callback.

// Root mean square of the samples
pub fn rms(x &Array[f32]) f32 {
  if x.len == 0usize { return 0.; }
  mut s = 0.;
  mut i = 0usize;
  while i < x.len { s = s + x[i] * x[i]; i = i + 1usize; }
  (s / f32.from(x.len)).sqrt();
}

// Largest absolute sample
pub fn peak(x &Array[f32]) f32 {
  mut m = 0.;
  mut i = 0usize;
  while i < x.len {
    imm a = libc.fabsf(x[i]);
    if a > m { m = a; }
    i = i + 1usize;
  }
  m;
}

// Frequency of a periodic signal from its rising zero crossings: the count of
// whole periods between the first and the last, each crossing placed by linear
// interpolation between its two samples
pub fn zeroCrossingFreq(x &Array[f32], rate f32) f32 {
  mut first = -1.;
  mut last = 0.;
  mut count = 0;
  mut i = 1usize;
  while i < x.len {
    if x[i - 1usize] < 0. and x[i] >= 0. {
      imm t = f32.from(i - 1usize) + (-x[i - 1usize]) / (x[i] - x[i - 1usize]);
      if first < 0. { first = t; } else { count = count + 1; last = t; }
    }
    i = i + 1usize;
  }
  if count == 0 { return 0.; }
  rate * f32.from(count) / (last - first);
}

// In-place radix-2 Cooley-Tukey FFT of 're' and 'im' (length a power of two)
pub fn fft(re &mut Array[f32], im &mut Array[f32]) {
  imm n = re.len;
  // bit reversal
  mut j = 0usize;
  mut i = 1usize;
  while i < n {
    mut bit = n >> 1usize;
    while (j & bit) != 0usize { j = j ^ bit; bit = bit >> 1usize; }
    j = j ^ bit;
    if i < j {
      imm tr = re[i]; re[i] = re[j]; re[j] = tr;
      imm ti = im[i]; im[i] = im[j]; im[j] = ti;
    }
    i = i + 1usize;
  }
  mut len = 2usize;
  while len <= n {
    imm ang = -TAU / f32.from(len);
    imm half = len >> 1usize;
    mut s = 0usize;
    while s < n {
      mut k = 0usize;
      while k < half {
        imm wr = (ang * f32.from(k)).cos();
        imm wi = (ang * f32.from(k)).sin();
        imm a = s + k;
        imm b = a + half;
        imm xr = re[b] * wr - im[b] * wi;
        imm xi = re[b] * wi + im[b] * wr;
        re[b] = re[a] - xr; im[b] = im[a] - xi;
        re[a] = re[a] + xr; im[a] = im[a] + xi;
        k = k + 1usize;
      }
      s = s + len;
    }
    len = len << 1usize;
  }
}

// The magnitude spectrum of the first 'n' samples (n a power of two) under a
// Hann window, bins 0 to n/2, scaled so a sine of amplitude A reads about A
// at its bin
pub fn spectrum(x &Array[f32], n usize) List[f32] {
  mut re = List[f32].withCapacity(n);
  mut im = List[f32].withCapacity(n);
  mut i = 0usize;
  while i < n {
    mut v = 0.;
    if i < x.len { v = x[i]; }
    imm w = 0.5 - 0.5 * (TAU * f32.from(i) / f32.from(n)).cos();
    re.push(v * w);
    im.push(0.);
    i = i + 1usize;
  }
  fft(re.viewMut(), im.viewMut());
  mut out = List[f32].withCapacity(n / 2usize + 1usize);
  i = 0usize;
  while i <= n / 2usize {
    out.push(2. * ((*re[i]) * (*re[i]) + (*im[i]) * (*im[i])).sqrt() / (f32.from(n) * 0.5));
    i = i + 1usize;
  }
  out;
}

// The frequency of the strongest bin of a spectrum made with 'n' samples at
// sample rate 'rate'
pub fn dominantFreq(spec &List[f32], n usize, rate f32) f32 {
  mut best = 1usize;
  mut i = 1usize;
  while i < spec.len() {
    if (*spec[i]) > (*spec[best]) { best = i; }
    i = i + 1usize;
  }
  f32.from(best) * rate / f32.from(n);
}

// The power between two frequencies as a fraction of the whole (bin 0 left out)
pub fn bandFraction(spec &List[f32], n usize, rate f32, lo f32, hi f32) f32 {
  mut inBand = 0.;
  mut all = 0.;
  mut i = 1usize;
  while i < spec.len() {
    imm f = f32.from(i) * rate / f32.from(n);
    imm p = (*spec[i]) * (*spec[i]);
    all = all + p;
    if f >= lo and f < hi { inBand = inBand + p; }
    i = i + 1usize;
  }
  if all <= 0. { return 0.; }
  inBand / all;
}

// The spectral centroid: the power-weighted mean frequency, a measure of
// brightness
pub fn centroid(spec &List[f32], n usize, rate f32) f32 {
  mut num = 0.;
  mut den = 0.;
  mut i = 1usize;
  while i < spec.len() {
    imm p = (*spec[i]) * (*spec[i]);
    num = num + p * f32.from(i) * rate / f32.from(n);
    den = den + p;
    i = i + 1usize;
  }
  if den <= 0. { return 0.; }
  num / den;
}
