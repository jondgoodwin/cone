// The mixer rendered offline into buffers and checked numerically: pitch,
// pan law, gain, buses, fades, looping, voice limiting by priority, the 3-D
// rules through the whole path (attenuation against the formula, head
// shadow, Doppler, occlusion). Nothing is played.
mod mixer;

import testing use *;
import collections use *;
import geomath use *;
import audiomixer use *;

const R = 48000.f;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn sine(freq: f32, seconds: f32) Sound {
  var s = List[f32].empty();
  var o = Osc.make(WAVE_SINE);
  let n = usize.from(seconds * R);
  var i = 0usize;
  while i < n { s.push(o.next(freq, R)); i = i + 1usize; }
  Sound(48000u32, 1u32, s)
}

fn noise(seconds: f32) Sound {
  var s = List[f32].empty();
  var r = Rng.seeded(5u32);
  let n = usize.from(seconds * R);
  var i = 0usize;
  while i < n { s.push(r.signed() * 0.5); i = i + 1usize; }
  Sound(48000u32, 1u32, s)
}

// Render 'frames' more frames, appending each ear to 'left' and 'right'
fn run(m: &mut Mixer, frames: usize, left: &mut List[f32], right: &mut List[f32]) {
  var buf = List[f32].empty();
  var i = 0usize;
  while i < frames * 2usize { buf.push(0.); i = i + 1usize; }
  m.render(buf.viewMut(), frames);
  i = 0usize;
  while i < frames {
    left.push(*buf[i * 2usize]);
    right.push(*buf[i * 2usize + 1usize]);
    i = i + 1usize;
  }
}

// The RMS of the last 'n' samples of a list
fn tailRms(x: &List[f32], n: usize) f32 {
  var s = 0.f;
  var i = x.len() - n;
  while i < x.len() { s = s + (*x[i]) * (*x[i]); i = i + 1usize; }
  (s / f32.from(n)).sqrt()
}

fn headRms(x: &List[f32], n: usize) f32 {
  var s = 0.f;
  var i = 0usize;
  while i < n { s = s + (*x[i]) * (*x[i]); i = i + 1usize; }
  (s / f32.from(n)).sqrt()
}

// A mixer with sounds in its table, the way the game thread would set it up
fn withSounds(voices: usize, a: &Sound, b: &Sound) Mixer {
  var m = Mixer.make(R, voices);
  m.apply(&Cmd.addSound(0u32, a));
  m.apply(&Cmd.addSound(1u32, b));
  m
}

fn main() i32 {
  let tone = sine(440., 2.);
  let hiss = noise(2.);

  // -------- pitch, pan, gain --------
  {
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., false, 0i32, 0.));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 24000usize, &mut l, &mut r);
    near(zeroCrossingFreq(l.view(), R), 440., 0.1, "a 440 Hz sound plays at 440 Hz");
    near(peak(l.view()), 0.70710678, 0.002, "centre pan: -3 dB each side");
    near(rms(l.view()), 0.5, 0.005, "centre pan rms is 0.5");
    near(rms(r.view()), rms(l.view()), 0.0001, "both ears alike");
  }
  {
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 2., 0., false, 0i32, 0.));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 12000usize, &mut l, &mut r);
    near(zeroCrossingFreq(l.view(), R), 880., 0.3, "pitch 2 doubles the frequency");
  }
  {
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., semitones(-12.), 0., false, 0i32, 0.));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 24000usize, &mut l, &mut r);
    near(zeroCrossingFreq(l.view(), R), 220., 0.2, "an octave down is 220 Hz");
  }
  {
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., -1., false, 0i32, 0.));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 4800usize, &mut l, &mut r);
    near(peak(l.view()), 1., 0.002, "hard left: full left");
    near(peak(r.view()), 0., 0.0001, "hard left: no right");
    m.apply(&Cmd.pan(1u32, 1.));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut m, 4800usize, &mut l2, &mut r2);
    near(tailRms(&l2, 2400usize), 0., 0.0001, "hard right: no left, once the pan has settled");
    expect(headRms(&l2, 100usize) > 0.3, "and the pan change was a ramp across the block, not a jump");
    near(tailRms(&r2, 2400usize), 0.70710678, 0.003, "hard right: full right");
  }
  {
    // gain 0.5 is half the rms; a gain ramp over 0.1 s ends at the target
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 0.5, 1., 0., false, 0i32, 0.));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 9600usize, &mut l, &mut r);
    near(rms(l.view()), 0.25, 0.005, "gain 0.5 halves the rms");
    m.apply(&Cmd.gain(1u32, 0.1, 0.1));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut m, 9600usize, &mut l2, &mut r2);
    near(tailRms(&l2, 2400usize), 0.05, 0.003, "gain ramped to 0.1");
    expect(headRms(&l2, 240usize) > 0.2, "the ramp starts near the old gain");
  }

  // -------- buses --------
  {
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_MUSIC, 1., 1., 0., false, 0i32, 0.));
    m.apply(&Cmd.busGain(BUS_MUSIC, 0.25, 0.));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 9600usize, &mut l, &mut r);
    near(rms(l.view()), 0.125, 0.003, "music bus at 0.25");
    m.apply(&Cmd.busGain(BUS_MASTER, 0.5, 0.));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut m, 9600usize, &mut l2, &mut r2);
    near(rms(l2.view()), 0.0625, 0.003, "master at 0.5 over it");
  }
  {
    // two voices on different buses; silencing one bus leaves the other
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_MUSIC, 1., 1., 0., false, 0i32, 0.));
    m.apply(&Cmd.play(2u32, 0u32, BUS_AMBIENCE, 1., 1., 0., false, 0i32, 0.));
    m.apply(&Cmd.busGain(BUS_MUSIC, 0., 0.));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 9600usize, &mut l, &mut r);
    near(rms(l.view()), 0.5, 0.005, "only the ambience bus is heard");
  }

  // -------- fades, stopping, looping --------
  {
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.5));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 48000usize, &mut l, &mut r);
    expect(headRms(&l, 2400usize) < 0.1, "a fade in starts quiet");
    near(tailRms(&l, 2400usize), 0.5, 0.01, "and ends at full level");
    m.apply(&Cmd.stop(1u32, 0.2));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut m, 4800usize, &mut l2, &mut r2);
    expect(m.activeVoices() == 1usize, "still sounding half way through a fade out");
    run(&mut m, 9600usize, &mut l2, &mut r2);
    expect(m.activeVoices() == 0usize, "gone after the fade out");
    near(tailRms(&l2, 2400usize), 0., 0.00001, "silent after");
  }
  {
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., false, 0i32, 0.));
    m.apply(&Cmd.stop(1u32, 0.));
    expect(m.activeVoices() == 0usize, "an immediate stop frees the voice");
    // a sound that ends by itself frees its voice
    var short = sine(480., 0.1);
    m.apply(&Cmd.addSound(2u32, &short));
    m.apply(&Cmd.play(2u32, 2u32, BUS_EFFECTS, 1., 1., 0., false, 0i32, 0.));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 4000usize, &mut l, &mut r);
    expect(m.activeVoices() == 1usize, "still playing before its end");
    run(&mut m, 4000usize, &mut l, &mut r);
    expect(m.activeVoices() == 0usize, "ended by itself");
    // looping: 480 Hz fits exactly 10 periods in 4800 frames, so the join is seamless
    m.apply(&Cmd.play(3u32, 2u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut m, 48000usize, &mut l2, &mut r2);
    expect(m.activeVoices() == 1usize, "a looping sound keeps playing");
    near(zeroCrossingFreq(l2.view(), R), 480., 0.05, "and stays in tune across 10 loop joins");
    var worst = 0.f;
    var i = 1usize;
    while i < l2.len() {
      let d = (*l2[i]) - (*l2[i - 1usize]);
      let a = if d < 0. { -d } else { d };
      if a > worst { worst = a; }
      i = i + 1usize;
    }
    expect(worst < 0.05, "no click at the loop join: the largest step between samples is a sine's own");
  }

  // -------- voice limiting by priority --------
  {
    var m = withSounds(4usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 1i32, 0.));
    m.apply(&Cmd.play(2u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 5i32, 0.));
    m.apply(&Cmd.play(3u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 3i32, 0.));
    m.apply(&Cmd.play(4u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 4i32, 0.));
    expect(m.activeVoices() == 4usize, "four voices fill the mixer");
    m.apply(&Cmd.play(5u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 2i32, 0.));
    expect(m.find(1u32) == m.voices.len(), "the priority 1 voice was stolen");
    expect(m.find(5u32) != m.voices.len(), "by the priority 2 newcomer");
    expect(m.stolen == 1u32, "one voice stolen");
    m.apply(&Cmd.play(6u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    expect(m.find(6u32) == m.voices.len(), "a priority 0 newcomer is refused");
    expect(m.dropped == 1u32, "one play dropped");
    expect(m.find(2u32) != m.voices.len() && m.find(3u32) != m.voices.len() && m.find(4u32) != m.voices.len(), "the stronger voices stay");
    // equal priorities: the quieter goes first
    var m2 = withSounds(2usize, &tone, &hiss);
    m2.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 0.8, 1., 0., true, 1i32, 0.));
    m2.apply(&Cmd.play(2u32, 0u32, BUS_EFFECTS, 0.2, 1., 0., true, 1i32, 0.));
    m2.apply(&Cmd.play(3u32, 0u32, BUS_EFFECTS, 0.5, 1., 0., true, 1i32, 0.));
    expect(m2.find(2u32) == m2.voices.len() && m2.find(1u32) != m2.voices.len(), "equal priority: the quietest is stolen");
    // equal priority and gain: the oldest
    var m3 = withSounds(2usize, &tone, &hiss);
    m3.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 0.5, 1., 0., true, 1i32, 0.));
    m3.apply(&Cmd.play(2u32, 0u32, BUS_EFFECTS, 0.5, 1., 0., true, 1i32, 0.));
    m3.apply(&Cmd.play(3u32, 0u32, BUS_EFFECTS, 0.5, 1., 0., true, 1i32, 0.));
    expect(m3.find(1u32) == m3.voices.len() && m3.find(2u32) != m3.voices.len(), "equal everything: the oldest is stolen");
    // a command for a gone voice does nothing
    m3.apply(&Cmd.stop(99u32, 0.));
    expect(m3.activeVoices() == 2usize, "a stop for an unknown id is ignored");
  }

  // -------- clipping --------
  {
    var m = withSounds(32usize, &tone, &hiss);
    var k = 1u32;
    while k <= 20u32 {
      m.apply(&Cmd.play(k, 0u32, BUS_EFFECTS, 1., 1., -1., true, 0i32, 0.));
      k = k + 1u32;
    }
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 4800usize, &mut l, &mut r);
    near(peak(l.view()), 1., 0.00001, "twenty loud voices are limited to exactly 1");
  }

  // -------- 3-D: attenuation through the whole path --------
  {
    // Listener at the origin facing -z; the source ahead at 1, 2, 4, 8 m,
    // inverse model ref 1: gain 1/d, rms ratios 1, 1/2, 1/4, 1/8 of the 1 m rms
    var want = 0.;
    var d = 1.f;
    var base = 0.f;
    while d <= 8. {
      var m = withSounds(8usize, &tone, &hiss);
      m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
      m.apply(&Cmd.spatial(1u32, Vec3(0., 0., -d), Vec3(0., 0., 0.)));
      m.apply(&Cmd.attenuation(1u32, &Attenuation.inverse(1., 100., 1.)));
      var l = List[f32].empty();
      var r = List[f32].empty();
      run(&mut m, 9600usize, &mut l, &mut r);
      let lv = tailRms(&l, 4800usize);
      if d == 1. { base = lv; }
      near(lv / base, 1. / d, 0.002, "spatial gain follows the inverse law at this distance");
      d = d * 2.;
    }
    near(base, 0.5, 0.003, "at 1 m, centred: the tone's rms 0.7071 times the pan law's 0.7071");
  }
  {
    // linear model through the mixer: 6 m with ref 1, max 11 is half
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    m.apply(&Cmd.spatial(1u32, Vec3(0., 0., -6.), Vec3(0., 0., 0.)));
    m.apply(&Cmd.attenuation(1u32, &Attenuation.linear(1., 11., 1.)));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 9600usize, &mut l, &mut r);
    near(tailRms(&l, 4800usize), 0.5 * 0.5, 0.003, "linear model: half gain at 6 m");
  }

  // -------- 3-D: panning with the head --------
  {
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    m.apply(&Cmd.spatial(1u32, Vec3(5., 0., 0.), Vec3(0., 0., 0.)));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 9600usize, &mut l, &mut r);
    near(tailRms(&l, 4800usize), 0., 0.0001, "a source on the right is silent on the left");
    expect(tailRms(&r, 4800usize) > 0.05, "and heard on the right");
  }
  {
    // white noise from the right at 45 degrees: the far (left) ear is darker
    var m = withSounds(8usize, &tone, &hiss);
    m.apply(&Cmd.play(1u32, 1u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    m.apply(&Cmd.spatial(1u32, Vec3(1., 0., -1.), Vec3(0., 0., 0.)));
    m.apply(&Cmd.attenuation(1u32, &Attenuation.none()));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 32768usize, &mut l, &mut r);
    let sl = spectrum(l.view(), 16384usize);
    let sr = spectrum(r.view(), 16384usize);
    expect(centroid(&sl, 16384usize, R) < 0.6 * centroid(&sr, 16384usize, R), "head shadow: the far ear's centroid is under 60% of the near ear's");
    expect(rms(r.view()) > rms(l.view()), "and the near ear is louder");
    // switch the head shadow off: the two ears' spectra agree
    m.apply(&Cmd.environment(false, 1.));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut m, 32768usize, &mut l2, &mut r2);
    let sl2 = spectrum(l2.view(), 16384usize);
    let sr2 = spectrum(r2.view(), 16384usize);
    near(centroid(&sl2, 16384usize, R) / centroid(&sr2, 16384usize, R), 1., 0.1, "without head shadow the ears have the same colour");
  }

  // -------- 3-D: Doppler --------
  {
    let hi = sine(1000., 2.);
    var m = withSounds(8usize, &hi, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    m.apply(&Cmd.spatial(1u32, Vec3(0., 0., -50.), Vec3(0., 0., 34.33)));
    m.apply(&Cmd.attenuation(1u32, &Attenuation.none()));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 24000usize, &mut l, &mut r);
    near(zeroCrossingFreq(l.view(), R), 1000. * 343.3 / (343.3 - 34.33), 1.5, "approaching source: 1000 Hz becomes 1111 Hz");
    m.apply(&Cmd.spatial(1u32, Vec3(0., 0., -50.), Vec3(0., 0., -34.33)));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut m, 24000usize, &mut l2, &mut r2);
    near(zeroCrossingFreq(l2.view(), R), 1000. * 343.3 / (343.3 + 34.33), 1.5, "receding source: 909 Hz");
    m.apply(&Cmd.environment(true, 0.));
    var l3 = List[f32].empty();
    var r3 = List[f32].empty();
    run(&mut m, 24000usize, &mut l3, &mut r3);
    near(zeroCrossingFreq(l3.view(), R), 1000., 0.5, "Doppler factor 0 leaves 1000 Hz");
    // the listener moving towards a still source raises the pitch the same way
    var m2 = withSounds(8usize, &hi, &hiss);
    m2.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    m2.apply(&Cmd.spatial(1u32, Vec3(0., 0., -50.), Vec3(0., 0., 0.)));
    m2.apply(&Cmd.attenuation(1u32, &Attenuation.none()));
    var lis = Listener.make();
    lis.velocity = Vec3(0., 0., -34.33);
    m2.apply(&Cmd.listener(&lis));
    var l4 = List[f32].empty();
    var r4 = List[f32].empty();
    run(&mut m2, 24000usize, &mut l4, &mut r4);
    near(zeroCrossingFreq(l4.view(), R), 1000. * (343.3 + 34.33) / 343.3, 1.5, "listener approaching: 1100 Hz");
  }

  // -------- 3-D: occlusion --------
  {
    let hi = sine(5000., 2.);
    var m = withSounds(8usize, &hi, &hiss);
    m.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    m.apply(&Cmd.spatial(1u32, Vec3(0., 0., -1.), Vec3(0., 0., 0.)));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 9600usize, &mut l, &mut r);
    let clear = tailRms(&l, 4800usize);
    m.apply(&Cmd.occlusion(1u32, 1.));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut m, 9600usize, &mut l2, &mut r2);
    let blocked = tailRms(&l2, 4800usize);
    // -12 dB of gain and a 400 Hz one-pole low pass at 5 kHz (-21.8 dB, worked out from the pole)
    near(gainToDb(blocked / clear), -12. - 21.8, 1.0, "fully occluded 5 kHz is down about 34 dB");
    var m2 = withSounds(8usize, &tone, &hiss);
    m2.apply(&Cmd.play(1u32, 0u32, BUS_EFFECTS, 1., 1., 0., true, 0i32, 0.));
    m2.apply(&Cmd.spatial(1u32, Vec3(0., 0., -1.), Vec3(0., 0., 0.)));
    m2.apply(&Cmd.occlusion(1u32, 1.));
    var l3 = List[f32].empty();
    var r3 = List[f32].empty();
    run(&mut m2, 9600usize, &mut l3, &mut r3);
    // 440 Hz through the 400 Hz one-pole (k = 0.0510, w = 0.0576 rad): |H| =
    // k / sqrt(1 - 2 (1-k) cos w + (1-k)^2) = 0.0510 / 0.0758 = 0.673 = -3.4 dB,
    // on top of the -12 dB of gain: -15.4 dB in all
    near(gainToDb(tailRms(&l3, 4800usize) / 0.5), -15.4, 0.3, "occluded 440 Hz: -12 dB and -3.4 dB of low pass");
  }

  // -------- synths through the mixer --------
  {
    var m = Mixer.make(R, 8usize);
    m.apply(&Cmd.playSynth(1u32, SYNTH_WIND, 1u32, BUS_AMBIENCE, 1., 0.8, 0., 0i32));
    m.apply(&Cmd.playSynth(2u32, SYNTH_STEP, 2u32, BUS_EFFECTS, 1., f32.from(MATERIAL_STONE), 0.8, 0i32));
    var l = List[f32].empty();
    var r = List[f32].empty();
    run(&mut m, 24000usize, &mut l, &mut r);
    expect(rms(l.view()) > 0.005, "synth voices make sound");
    expect(m.activeVoices() == 1usize, "the step ended by itself, the wind goes on");
    expect(peak(l.view()) <= 1., "within range");
    // the same commands give the same samples
    var n = Mixer.make(R, 8usize);
    n.apply(&Cmd.playSynth(1u32, SYNTH_WIND, 1u32, BUS_AMBIENCE, 1., 0.8, 0., 0i32));
    n.apply(&Cmd.playSynth(2u32, SYNTH_STEP, 2u32, BUS_EFFECTS, 1., f32.from(MATERIAL_STONE), 0.8, 0i32));
    var l2 = List[f32].empty();
    var r2 = List[f32].empty();
    run(&mut n, 24000usize, &mut l2, &mut r2);
    var same = true;
    var i = 0usize;
    while i < l.len() { if (*l[i]) != (*l2[i]) { same = false; } i = i + 1usize; }
    expect(same, "rendering is deterministic");
  }
  done()
}
