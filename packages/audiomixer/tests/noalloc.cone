// The audio callback allocates nothing. The heap region every collection
// draws on (core's `cone_heapRegion`) has its allocate and resize functions
// replaced by counting wrappers that call the originals; the count is read
// before and after a long run of rendering, with the game side's commands
// arriving through the queue the whole time, 32 voices playing sound files,
// 3-D sources and procedural recipes, and voices being started, stolen and
// stopped. It must not move by one. (The queue and the mixer are built before
// the count starts; building is allowed to allocate.)
mod noalloc;

import testing use *;
import collections use *;
import geomath use *;
import sync use Receiver;
import audiomixer use *;

let allocs Atomic[u64];
let realAlloc &fn(r *MemRegion, bytes usize, align usize) *u8;
let realResize &fn(r *MemRegion, block *u8, oldBytes usize, newBytes usize, align usize) *u8;

fn @initpure init() {
  allocs = Atomic[u64].of(0u64);
  realAlloc = heapRegion().allocFn;
  realResize = heapRegion().resizeFn;
}

fn countingAlloc(r *MemRegion, bytes usize, align usize) *u8 {
  allocs.add(1u64);
  let f = realAlloc;
  f(r, bytes, align)
}

fn countingResize(r *MemRegion, block *u8, oldBytes usize, newBytes usize, align usize) *u8 {
  allocs.add(1u64);
  let f = realResize;
  f(r, block, oldBytes, newBytes, align)
}

fn sine(freq f32, seconds f32) Sound {
  var s = List[f32].empty();
  var o = Osc.make(WAVE_SINE);
  let n = usize.from(seconds * 48000.);
  var i = 0usize;
  while i < n { s.push(o.next(freq, 48000.)); i = i + 1usize; }
  new Sound(48000u32, 1u32, s)
}

fn main() i32 {
  initAll();
  var c Control;
  var rx Receiver[Cmd];
  c, rx = commandQueue(256u64);
  var e = Engine.make(48000., 32usize, rx);
  let tone = c.addSound(sine(330., 1.));
  let blip = c.addSound(sine(1000., 0.05));
  var out = List[f32].empty();
  var i = 0usize;
  while i < 960usize { out.push(0.); i = i + 1usize; }
  e.render(out.viewMut(), 480usize);

  // count from here
  let heap = heapRegion();
  heap.allocFn = &countingAlloc;
  heap.resizeFn = &countingResize;
  let before = allocs.load();

  var block = 0;
  var lis = Listener.make();
  while block < 600 {
    // the game thread, every few blocks: new voices (more than 32, so voices are stolen),
    // moves, occlusion, stops, listener, bus gains
    if block % 3 == 0 {
      let id = c.play(blip, BUS_EFFECTS, 0.1, 1.1, 0.3, false, i32.from(block % 5));
      c.setPosition(id, new Vec3(f32.from(block % 20), 0., -5.), new Vec3(2., 0., 0.));
      c.setOcclusion(id, 0.3);
    }
    if block % 7 == 0 {
      let id = c.playSynth(SYNTH_STEP, u32.from(block), BUS_EFFECTS, 0.3, f32.from(block % 3), 0.7, 1i32);
      c.stop(id, 0.05);
    }
    if block % 50 == 0 {
      c.playSynth(SYNTH_FIRE, u32.from(block), BUS_AMBIENCE, 0.2, 0.5, 0.5, 0i32);
      c.playSynth(SYNTH_WIND, u32.from(block), BUS_AMBIENCE, 0.2, 0.5, 0., 0i32);
      c.playSynth(SYNTH_WATER, u32.from(block), BUS_AMBIENCE, 0.2, 0.5, 0., 0i32);
      c.playSynth(SYNTH_BIRD, u32.from(block), BUS_EFFECTS, 0.2, 4000., 0., 0i32);
      c.play(tone, BUS_MUSIC, 0.1, 1., 0., true, 2i32);
    }
    if block % 11 == 0 {
      lis.position = new Vec3(f32.from(block) * 0.01, 0., 0.);
      lis.velocity = new Vec3(1., 0., 0.);
      c.setListener(&lis);
      c.setBusGain(BUS_MUSIC, 0.5, 0.1);
    }
    e.render(out.viewMut(), 480usize);
    block = block + 1;
  }
  let after = allocs.load();
  heap.allocFn = realAlloc;
  heap.resizeFn = realResize;
  expect(e.mixer.stolen > 0u32, "voices were stolen during the run");
  expect(e.mixer.activeVoices() > 10usize, "many voices were playing");
  expectUInt(after - before, 0u64, "600 blocks of rendering with commands arriving allocated nothing");
  // the counter works: a list push allocates
  heap.allocFn = &countingAlloc;
  heap.resizeFn = &countingResize;
  var probe = List[f32].empty();
  probe.push(1.);
  probe.push(2.);
  heap.allocFn = realAlloc;
  heap.resizeFn = realResize;
  expect(allocs.load() > after, "and the counter does see an allocation");
  done()
}
