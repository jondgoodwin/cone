// The game-thread handle and the audio-thread engine: commands through the
// lock-free queue, first on one thread (the queue drained at each block),
// then across two real threads with a flood of plays: every command must
// arrive, in order, exactly once. No audio device is opened.
mod engine;

import testing use *;
import collections use *;
import geomath use *;
import thread;
import sync use Receiver;
import time use Duration;
import audiomixer use *;

const R = 48000.f;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn sine(freq f32, seconds f32) Sound {
  var s = List[f32].empty();
  var o = Osc.make(WAVE_SINE);
  let n = usize.from(seconds * R);
  var i = 0usize;
  while i < n { s.push(o.next(freq, R)); i = i + 1usize; }
  new Sound(48000u32, 1u32, s)
}

// The audio thread: render 480-frame blocks (10 ms) until the listener the
// game parks at x = 123 appears, and answer how many plays began and were refused
fn audioThread(rx Receiver[Cmd]) u64 {
  var e = Engine.make(R, 8usize, rx);
  var buf = List[f32].empty();
  var i = 0usize;
  while i < 960usize { buf.push(0.); i = i + 1usize; }
  var spins = 0u32;
  while e.mixer.listener.position.x != 123. && spins < 2000000u32 {
    e.render(buf.viewMut(), 480usize);
    spins = spins + 1u32;
    thread.yieldNow();
  }
  // one more block to apply anything queued behind the marker
  e.render(buf.viewMut(), 480usize);
  u64.from(e.mixer.counter) * 1000000u64 + u64.from(e.mixer.dropped) * 1000u64 + u64.from(e.mixer.activeVoices())
}

fn main() i32 {
  // -------- one thread --------
  {
    var c Control;
    var rx Receiver[Cmd];
    c, rx = commandQueue(64u64);
    var e = Engine.make(R, 8usize, rx);
    let tone = c.addSound(sine(440., 2.));
    let id = c.play(tone, BUS_EFFECTS, 1., 1., 0., false, 0i32);
    expectUInt(u64.from(id), 1u64, "the first voice id is 1");
    var buf = List[f32].empty();
    var i = 0usize;
    while i < 24000usize { buf.push(0.); i = i + 1usize; }
    e.render(buf.viewMut(), 12000usize);
    var left = List[f32].empty();
    i = 0usize;
    while i < 12000usize { left.push(*buf[i * 2usize]); i = i + 1usize; }
    near(zeroCrossingFreq(left.view(), R), 440., 0.1, "a sound added and played through the queue");
    c.setPitch(id, 2.);
    c.setBusGain(BUS_MASTER, 0.5, 0.);
    e.render(buf.viewMut(), 12000usize);
    i = 0usize;
    var left2 = List[f32].empty();
    while i < 12000usize { left2.push(*buf[i * 2usize]); i = i + 1usize; }
    near(zeroCrossingFreq(left2.view(), R), 880., 0.4, "pitch set through the queue");
    near(rms(left2.view()), 0.25, 0.005, "master gain through the queue");
    c.stop(id, 0.);
    e.render(buf.viewMut(), 480usize);
    expect(e.mixer.activeVoices() == 0usize, "a stop through the queue");
    expectUInt(u64.from(c.refused), 0u64, "nothing refused");
    // ids count up; a synth id too
    let w = c.playSynth(SYNTH_WIND, 5u32, BUS_AMBIENCE, 1., 0.5, 0., 0i32);
    expectUInt(u64.from(w), 2u64, "ids go on from 2");
    e.render(buf.viewMut(), 4800usize);
    expect(e.mixer.activeVoices() == 1usize, "the synth plays");
    c.stopAll(0.);
    e.render(buf.viewMut(), 480usize);
    expect(e.mixer.activeVoices() == 0usize, "stop all");
  }

  // -------- a full ring refuses and counts, never waits --------
  {
    var c Control;
    var rx Receiver[Cmd];
    c, rx = commandQueue(4u64);
    var k = 0;
    while k < 20 { c.setPan(1u32, 0.); k = k + 1; }
    expectUInt(u64.from(c.refused), 16u64, "a ring of 4 takes 4 of 20 commands and refuses 16");
    var e = Engine.make(R, 4usize, rx);
    var buf = List[f32].empty();
    var i = 0usize;
    while i < 960usize { buf.push(0.); i = i + 1usize; }
    e.render(buf.viewMut(), 480usize);
    c.setPan(1u32, 0.);
    expectUInt(u64.from(c.refused), 16u64, "after a drain it takes commands again");
  }

  // -------- two threads --------
  {
    var c Control;
    var rx Receiver[Cmd];
    c, rx = commandQueue(64u64);
    // a short sound so voices end on their own: 5 ms
    let blip = c.addSound(sine(1000., 0.005));
    let audio = thread.start(rx, &audioThread);
    var sent = 0u32;
    var lis = Listener.make();
    while sent < 600u32 {
      // retry until the ring has room: the test, unlike a game, wants every one
      var ok = false;
      while !ok {
        ok = c.send(Cmd.play(sent + 100u32, blip, BUS_EFFECTS, 0.1, 1., 0., false, i32.from(sent % 4u32), 0.));
        if !ok { thread.yieldNow(); }
      }
      sent = sent + 1u32;
    }
    lis.position = new Vec3(123., 0., 0.);
    var ok = false;
    while !ok {
      ok = c.send(Cmd.listener(&lis));
      if !ok { thread.yieldNow(); }
    }
    let answer = audio.join();
    let began = answer / 1000000u64;
    let dropped = (answer / 1000u64) % 1000u64;
    expectUInt(began + dropped, 600u64, "every one of 600 plays arrived once: began plus dropped");
    expectUInt(answer % 1000u64, 0u64, "and all the blips have ended");
  }
  done()
}
