// WAV decoding against files assembled byte by byte, and a round trip.
mod wav;

import testing use *;
import collections use *;
import audiomixer use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

fn le16(b &mut List[u8], v u32) { b.push(u8.from(v & 255u32)); b.push(u8.from((v >> 8u32) & 255u32)); }
fn le32(b &mut List[u8], v u32) { le16(b, v & 65535u32); le16(b, v >> 16u32); }
fn tag(b &mut List[u8], a u8, c u8, d u8, e u8) { b.push(a); b.push(c); b.push(d); b.push(e); }

// A header for 'fmtTag', 'ch' channels, 'bits' wide, and 'dataBytes' of data
fn header(b &mut List[u8], fmtTag u32, ch u32, rate u32, bits u32, dataBytes u32) {
  tag(b, 82u8, 73u8, 70u8, 70u8);
  le32(b, 36u32 + dataBytes);
  tag(b, 87u8, 65u8, 86u8, 69u8);
  tag(b, 102u8, 109u8, 116u8, 32u8);
  le32(b, 16u32);
  le16(b, fmtTag); le16(b, ch); le32(b, rate);
  le32(b, rate * ch * bits / 8u32); le16(b, ch * bits / 8u32); le16(b, bits);
  tag(b, 100u8, 97u8, 116u8, 97u8);
  le32(b, dataBytes);
}

fn main() i32 {
  // 16-bit mono: 0, 16384 (0.5), -32768 (-1), 32767
  var a = List[u8].empty();
  header(&mut a, 1u32, 1u32, 22050u32, 16u32, 8u32);
  le16(&mut a, 0u32); le16(&mut a, 16384u32); le16(&mut a, 32768u32); le16(&mut a, 32767u32);
  match decodeWav(a.view()) {
    case let s Ok {
      expectUInt(u64.from(s.rate), 22050u64, "rate");
      expectUInt(u64.from(s.channels), 1u64, "channels");
      expectUInt(u64.from(s.frames()), 4u64, "frames");
      near(s.at(0usize, 0u32), 0., 0.00001, "16-bit zero");
      near(s.at(1usize, 0u32), 0.5, 0.00001, "16-bit half");
      near(s.at(2usize, 0u32), -1., 0.00001, "16-bit minimum");
      near(s.at(3usize, 0u32), 0.99997, 0.00001, "16-bit maximum");
    }
    case is Error { expect(false, "16-bit decodes"); }
  }

  // 8-bit stereo: unsigned, 128 is silence; (255, 0) then (128, 192)
  var b = List[u8].empty();
  header(&mut b, 1u32, 2u32, 8000u32, 8u32, 4u32);
  b.push(255u8); b.push(0u8); b.push(128u8); b.push(192u8);
  match decodeWav(b.view()) {
    case let s Ok {
      expectUInt(u64.from(s.frames()), 2u64, "8-bit stereo frames");
      near(s.at(0usize, 0u32), 0.9921875, 0.00001, "8-bit 255");
      near(s.at(0usize, 1u32), -1., 0.00001, "8-bit 0");
      near(s.at(1usize, 1u32), 0.5, 0.00001, "8-bit 192");
      near(s.toMono().at(1usize, 0u32), 0.25, 0.00001, "mono mix");
    }
    case is Error { expect(false, "8-bit decodes"); }
  }

  // 24-bit: 0x400000 = 0.5, 0x800000 = -1
  var c = List[u8].empty();
  header(&mut c, 1u32, 1u32, 8000u32, 24u32, 6u32);
  c.push(0u8); c.push(0u8); c.push(64u8);
  c.push(0u8); c.push(0u8); c.push(128u8);
  match decodeWav(c.view()) {
    case let s Ok {
      near(s.at(0usize, 0u32), 0.5, 0.00001, "24-bit half");
      near(s.at(1usize, 0u32), -1., 0.00001, "24-bit minimum");
    }
    case is Error { expect(false, "24-bit decodes"); }
  }

  // 32-bit float: 0.25 is 0x3E800000, -2.0 is 0xC0000000
  var d = List[u8].empty();
  header(&mut d, 3u32, 1u32, 8000u32, 32u32, 8u32);
  le32(&mut d, 1048576000u32); le32(&mut d, 3221225472u32);
  match decodeWav(d.view()) {
    case let s Ok {
      near(s.at(0usize, 0u32), 0.25, 0.0000001, "float 0.25");
      near(s.at(1usize, 0u32), -2., 0.0000001, "float -2");
    }
    case is Error { expect(false, "float decodes"); }
  }

  // Round trip through the encoder, both forms
  var src = Sound.silent(44100u32, 2u32, 100usize);
  src.samples.set(0usize, 0.5);
  src.samples.set(1usize, -0.25);
  src.samples.set(199usize, 0.125);
  let asPcm = encodeWav(&src, false);
  expectUInt(u64.from(asPcm.len()), 44u64 + 400u64, "16-bit file size");
  match decodeWav(asPcm.view()) {
    case let s Ok {
      expectUInt(u64.from(s.frames()), 100u64, "round trip frames");
      near(s.at(0usize, 0u32), 0.5, 0.0001, "round trip 0.5");
      near(s.at(0usize, 1u32), -0.25, 0.0001, "round trip -0.25");
      near(s.at(99usize, 1u32), 0.125, 0.0001, "round trip 0.125");
    }
    case is Error { expect(false, "round trip decodes"); }
  }
  let asFloat = encodeWav(&src, true);
  match decodeWav(asFloat.view()) {
    case let s Ok {
      near(s.at(0usize, 0u32), 0.5, 0.0, "float round trip exact 0.5");
      near(s.at(0usize, 1u32), -0.25, 0.0, "float round trip exact -0.25");
    }
    case is Error { expect(false, "float round trip decodes"); }
  }

  // Refusals
  var junk = List[u8].empty();
  junk.push(1u8);
  match decodeWav(junk.view()) {
    case is Ok { expect(false, "junk refused"); }
    case is Error { expect(true, "junk refused"); }
  }
  done();
}
