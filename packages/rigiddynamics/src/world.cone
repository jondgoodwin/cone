// The World: bodies, shapes, joints, the broad phase, the contact cache, and
// the step that moves them all.
//
// A step (World.step), in Jolt's and Box2D v3's order:
//   1. refresh each body's step state (world inertia, the pose it starts from)
//   2. broad phase: the awake bodies' boxes updated, overlapping pairs found
//   3. narrow phase and the contact cache: each pair that can move collided
//      (rigidcollide), its manifolds matched to last step's for warm starting,
//      sleeping bodies woken that an awake one touches, events emitted
//   4. the constraint list: contacts of awake bodies, coloured (greedy graph
//      colouring, so a later parallel solve is a swap and the order is fixed)
//   5. Soft Step: for each sub-step, integrate velocities (gravity, forces,
//      damping, the gyroscopic term), warm start, solve joints and contacts
//      with their bias, integrate positions, relax; then restitution
//   6. continuous collision for fast bodies, sleep timers, islands asleep.

pub struct World {
  pub gravity: Vec3;
  pub settings: Settings;
  pub shapes: List[Shape];
  pub bodies: Bodies;         // a body is named outside by its BodyId; the solver, contacts and joints name its cell (the u32 index)
  pub joints: List[Joint];
  pub jointsOf: List[List[u32]];     // per body cell (grows with 'bodies'): the joints that name it, so destroyBody visits only its own
  pub bp: SweepAndPrune;
  pub cache: List[Contact];
  pub next: List[Contact];
  pub pairs: List[BodyPair];
  pub active: List[u32];             // indices into 'cache' the solver uses this step, in solve order
  pub activeJoints: List[u32];
  pub events: List[Event];
  pub stepCount: u32;
  pub nextGroup: u32;
  pub fixedDt: f32;
  pub accumulator: f32;
  pub lastContacts: usize;           // statistics of the last step
  pub lastPairs: usize;
  pub lastColors: i32;
  pub noCollideJoints: bool;         // some joint stops its bodies colliding
  pub substepSeconds: f32;           // the time of the last sub-step (joint loads are impulses over it)

  pub fn make() World {
    World(Vec3(0., -9.81, 0.), Settings.standard(), List[Shape](), Bodies.make(),
      List[Joint](), List[List[u32]](), SweepAndPrune(), List[Contact](), List[Contact](), List[BodyPair](),
      List[u32](), List[u32](), List[Event](), 0u32, 1u32, 1. / 60., 0., 0usize, 0usize, 0, false, 0.)
  }

  // ------------------------------------------------------------------ shapes

  // Register a shape (built once, shared by every body that uses it); its number
  pub fn addShape(self: &mut, s: Shape) u32 {
    shapes.push(s);
    u32.from(shapes.len()) - 1u32
  }

  // ------------------------------------------------------------------ bodies

  // The body in cell i (the solver's index, from a contact, a joint or the broad phase: always a live cell)
  pub fn bd(self: &, i: usize) &mut Body { bodies.at(u32.from(i)) as &mut Body }

  // The body an id names, or null if it is stale or none (the getters below answer a neutral value for it,
  // the setters do nothing)
  fn bodyOf(self: &, id: BodyId) *Body { bodies.get(id) }

  // The cell of the body an id names, or NoBody if it is stale or none: validated once, here, when a
  // contact or a joint is made
  pub fn cellOf(self: &, id: BodyId) u32 {
    if bodies.get(id) as usize == 0usize { NoBody } else { id.index }
  }

  // The id of the live body in cell i (the id a contact's cell is named by outside)
  pub fn idOf(self: &, i: u32) BodyId { bodies.slotAt(i) }

  // The shape's origin and orientation (what a renderer places the mesh by)
  pub fn transformOf(self: &, id: BodyId) Rigid {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return Rigid.identity(); }
    let b = p as &Body;
    Rigid(b.pos - b.rot * b.comLocal, b.rot)
  }

  pub fn positionOf(self: &, id: BodyId) Vec3 { self.transformOf(id).pos }
  pub fn rotationOf(self: &, id: BodyId) Quat {
    let p = self.bodyOf(id);
    if p as usize == 0usize { Quat.identity() } else { (p as &Body).rot }
  }
  pub fn centerOfMass(self: &, id: BodyId) Vec3 {
    let p = self.bodyOf(id);
    if p as usize == 0usize { zero3() } else { (p as &Body).pos }
  }
  pub fn linearVelocity(self: &, id: BodyId) Vec3 {
    let p = self.bodyOf(id);
    if p as usize == 0usize { zero3() } else { (p as &Body).linVel }
  }
  pub fn angularVelocity(self: &, id: BodyId) Vec3 {
    let p = self.bodyOf(id);
    if p as usize == 0usize { zero3() } else { (p as &Body).angVel }
  }
  pub fn isAsleep(self: &, id: BodyId) bool {
    let p = self.bodyOf(id);
    p as usize != 0usize && (p as &Body).asleep
  }
  pub fn isAlive(self: &, id: BodyId) bool { self.bodyOf(id) as usize != 0usize }
  pub fn massOf(self: &, id: BodyId) f32 {
    let p = self.bodyOf(id);
    if p as usize == 0usize { 0. } else { (p as &Body).mass }
  }
  pub fn userDataOf(self: &, id: BodyId) u32 {
    let p = self.bodyOf(id);
    if p as usize == 0usize { 0u32 } else { (p as &Body).userData }
  }
  pub fn materialOf(self: &, id: BodyId) PhysMaterial {
    let p = self.bodyOf(id);
    if p as usize == 0usize { PhysMaterial.standard() } else { (p as &Body).material }
  }
  pub fn bodyCount(self: &) usize { bodies.len() }

  // The velocity of the body's material at a world point (a platform's, under a rider)
  pub fn pointVelocity(self: &, id: BodyId, p: Vec3) Vec3 {
    let q = self.bodyOf(id);
    if q as usize == 0usize { return zero3(); }
    let b = q as &Body;
    b.linVel + b.angVel.cross(p - b.pos)
  }

  fn velMargin(self: &, i: usize, dt: f32) f32 {
    let b = self.bd(i);
    minf(settings.maxSpeculative, (b.linVel.length() + b.angVel.length() * b.radius) * dt)
  }

  fn bodyBox(self: &, i: usize, dt: f32) Aabb3 {
    let b = self.bd(i);
    let xf = Rigid(b.pos - b.rot * b.comLocal, b.rot);
    shapes[usize.from(b.shape)].bounds(xf).expand(settings.speculativeDistance * 0.5 + self.velMargin(i, dt))
  }

  pub fn setMaterial(self: &mut, id: BodyId, m: PhysMaterial) {
    let p = self.bodyOf(id);
    if p as usize != 0usize { (p as &mut Body).material = m; }
  }
  pub fn setLayers(self: &mut, id: BodyId, layer: u32, mask: u32) {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return; }
    let b = p as &mut Body;
    b.layer = layer;
    b.mask = mask;
    bp.remove(id.index);
    bp.add(id.index, self.bodyBox(usize.from(id.index), 0.), layer, mask, b.motion == MotionStatic);
  }
  pub fn setSensor(self: &mut, id: BodyId, sensor: bool) {
    let p = self.bodyOf(id);
    if p as usize != 0usize { (p as &mut Body).sensor = sensor; }
  }

  // Make a body. A body of a shape with no volume (a triangle mesh, a
  // heightfield) can only be static or kinematic.
  pub fn createBody(self: &mut, def: BodyDef) BodyId {
    let sh = &shapes[usize.from(def.shape)];
    let mp = sh.massProps();
    var motion = def.motion;
    if motion == MotionDynamic && mp.volume <= 0.000001 { motion = MotionKinematic; }
    let dynamic = motion == MotionDynamic;
    let com = if dynamic { mp.com } else { zero3() };
    var mass = 0.f;
    var inertia = mat3Diag(0., 0., 0.);
    var invI = mat3Diag(0., 0., 0.);
    if dynamic {
      mass = if def.mass > 0. { def.mass } else { def.density * mp.volume };
      inertia = mat3Scale(mp.inertia, mass / mp.volume);
      invI = inertia.inverse();
    }
    // the box round the shape in its own space, for the radius from the centre of mass
    let lb = sh.bounds(Rigid.identity());
    let ext = lb.halfExtents();
    let mid = lb.center();
    let toFar = Vec3((mid.x - com.x).abs() + ext.x, (mid.y - com.y).abs() + ext.y, (mid.z - com.z).abs() + ext.z);
    let radius = toFar.length();
    let minExtent = minf(ext.x, minf(ext.y, ext.z));
    let pos = def.pos + def.rot * com;
    let body = Body(motion, def.shape, def.layer, def.mask, def.sensor, def.allowSleep, def.bullet, def.userData,
      pos, def.rot, com, def.linVel, def.angVel, mass, if dynamic { 1. / mass } else { 0. }, inertia, invI,
      if dynamic { rotateInertia(def.rot, invI) } else { mat3Diag(0., 0., 0.) }, dynamic && !isIsotropic(inertia),
      def.linearDamping, def.angularDamping, def.gravityFactor, def.material, zero3(), zero3(), radius, minExtent,
      false, 0., 0u32, zero3(), Quat.identity(), def.pos, def.rot, 0u32, 0u64);
    let h = bodies.add(body);
    while jointsOf.len() <= usize.from(h.index) { jointsOf.push(List[u32]()); }
    bp.add(h.index, self.bodyBox(usize.from(h.index), 0.), def.layer, def.mask, motion == MotionStatic);
    h
  }

  // Remove a body, its joints and its contacts
  pub fn destroyBody(self: &mut, hid: BodyId) {
    if !self.isAlive(hid) { return; }
    let id = hid.index;
    let i = usize.from(id);
    bp.remove(id);
    var k = 0usize;
    while k < jointsOf[i].len() {
      let ji = usize.from(*jointsOf[i][k]);
      if joints[ji].alive {
        joints[ji].alive = false;
        let other = if joints[ji].a == id { joints[ji].b } else { joints[ji].a };
        if other != id { self.unindexJoint(other, u32.from(ji)); }
      }
      k = k + 1usize;
    }
    jointsOf[i].clear();
    next.clear();
    k = 0usize;
    while k < cache.len() {
      let c = &cache[k];
      if c.a == id || c.b == id {
        if c.touching { self.emit(if c.sensor { EvSensorExit } else { EvContactRemoved }, c.a, c.b, zero3(), c.normal, 0.); }
      } else {
        next.push(*c);
      }
      k = k + 1usize;
    }
    cache.clear();
    k = 0usize;
    while k < next.len() { cache.push(*next[k]); k = k + 1usize; }
    next.clear();
    bodies.remove(hid);       // after the events above, which name the body's id
  }

  // ------------------------------------------------------------------ driving bodies

  fn touchBox(self: &mut, id: u32) {
    let i = usize.from(id);
    bp.update(id, self.bodyBox(i, 0.));
  }

  // Put the body's shape origin and orientation somewhere else (a teleport; the velocity is kept)
  pub fn setTransform(self: &mut, id: BodyId, pos: Vec3, rot: Quat) {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return; }
    let b = p as &mut Body;
    b.rot = rot;
    b.pos = pos + rot * b.comLocal;
    self.touchBox(id.index);
    self.wakeAt(id.index);
  }

  pub fn setLinearVelocity(self: &mut, id: BodyId, v: Vec3) {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return; }
    let b = p as &mut Body;
    b.linVel = v;
    if b.motion == MotionDynamic { self.wakeAt(id.index); }
  }
  pub fn setAngularVelocity(self: &mut, id: BodyId, v: Vec3) {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return; }
    let b = p as &mut Body;
    b.angVel = v;
    if b.motion == MotionDynamic { self.wakeAt(id.index); }
  }

  // Drive a kinematic body to a pose over 'dt' seconds: sets the velocities that get it there
  // (it carries what stands on it and shoves what it meets); call each step
  pub fn moveKinematic(self: &mut, id: BodyId, pos: Vec3, rot: Quat, dt: f32) {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return; }
    let b = p as &mut Body;
    let target = pos + rot * b.comLocal;
    b.linVel = (target - b.pos) * (1. / dt);
    var dq = rot * b.rot.conjugate();
    if dq.w < 0. { dq = Quat(-dq.x, -dq.y, -dq.z, -dq.w); }
    let s = (dq.x * dq.x + dq.y * dq.y + dq.z * dq.z).sqrt();
    let ang = 2. * atan2(s, dq.w);
    b.angVel = if s > 0.000001 { Vec3(dq.x, dq.y, dq.z) * (ang / s / dt) } else { zero3() };
  }

  pub fn applyForce(self: &mut, id: BodyId, f: Vec3) {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return; }
    let b = p as &mut Body;
    if b.motion != MotionDynamic { return; }
    b.force = b.force + f;
    self.wakeAt(id.index);
  }
  pub fn applyForceAt(self: &mut, id: BodyId, f: Vec3, p: Vec3) {
    let q = self.bodyOf(id);
    if q as usize == 0usize { return; }
    let b = q as &mut Body;
    if b.motion != MotionDynamic { return; }
    b.force = b.force + f;
    b.torque = b.torque + (p - b.pos).cross(f);
    self.wakeAt(id.index);
  }
  pub fn applyTorque(self: &mut, id: BodyId, t: Vec3) {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return; }
    let b = p as &mut Body;
    if b.motion != MotionDynamic { return; }
    b.torque = b.torque + t;
    self.wakeAt(id.index);
  }
  // An instant change of velocity: impulse p (kg m/s)
  pub fn applyImpulse(self: &mut, id: BodyId, p: Vec3) {
    let q = self.bodyOf(id);
    if q as usize == 0usize { return; }
    let b = q as &mut Body;
    if b.motion != MotionDynamic { return; }
    b.linVel = b.linVel + p * b.invMass;
    self.wakeAt(id.index);
  }
  pub fn applyImpulseAt(self: &mut, id: BodyId, p: Vec3, at: Vec3) {
    let q = self.bodyOf(id);
    if q as usize == 0usize { return; }
    let b = q as &mut Body;
    if b.motion != MotionDynamic { return; }
    b.linVel = b.linVel + p * b.invMass;
    b.angVel = b.angVel + rotateInertia(b.rot, b.invInertiaLocal) * (at - b.pos).cross(p);
    self.wakeAt(id.index);
  }

  // ------------------------------------------------------------------ sleeping

  pub fn wake(self: &mut, id: BodyId) {
    if self.isAlive(id) { self.wakeAt(id.index); }
  }

  // Wake the sleeping island the body in cell 'id' belongs to (every body of its sleep group)
  fn wakeAt(self: &mut, id: u32) {
    let p0 = bodies.at(id);
    if p0 as usize == 0usize { return; }     // an empty cell: a dead joint's body was destroyed
    let b0 = p0 as &Body;
    if !b0.asleep { return; }
    let g = b0.sleepGroup;
    var k = bodies.nextLive(0u32);
    while k != NoBody {
      let b = self.bd(usize.from(k));
      if b.asleep && b.sleepGroup == g {
        b.asleep = false;
        b.sleepTime = 0.;
        b.sleepGroup = 0u32;
        b.invInertia = rotateInertia(b.rot, b.invInertiaLocal);
        self.emit(EvWake, k, NoBody, zero3(), zero3(), 0.);
      }
      k = bodies.nextLive(k + 1u32);
    }
  }

  // Put a body (and everything resting on or joined to it) to sleep now
  pub fn sleep(self: &mut, id: BodyId) {
    let p = self.bodyOf(id);
    if p as usize == 0usize { return; }
    let b = p as &mut Body;
    if b.motion != MotionDynamic || b.asleep { return; }
    b.asleep = true;
    b.linVel = zero3();
    b.angVel = zero3();
    b.sleepGroup = nextGroup;
    nextGroup = nextGroup + 1u32;
  }

  // ------------------------------------------------------------------ events

  // An event naming the bodies in cells a and b (NoBody for none), as ids
  fn emit(self: &mut, kind: u32, a: u32, b: u32, point: Vec3, normal: Vec3, depth: f32) {
    if events.len() < 100000usize { events.push(Event(kind, bodies.slotAt(a), bodies.slotAt(b), point, normal, depth)); }
  }

  // The events since the last call, oldest first
  pub fn takeEvents(self: &mut) List[Event] {
    var out = List[Event]();
    var i = 0usize;
    while i < events.len() { out.push(*events[i]); i = i + 1usize; }
    events.clear();
    out
  }

  // ------------------------------------------------------------------ joints

  // A frame whose x axis is 'axis'
  fn frameOf(axis: Vec3) Quat { Quat.fromVectors(Vec3(1., 0., 0.), axis.normalize()) }

  // The two ids are checked here, once: a joint names its bodies by cell. A stale or none id makes no joint (NoBody)
  fn addJoint(self: &mut, kind: i32, ida: BodyId, idb: BodyId, anchor: Vec3, axis: Vec3) u32 {
    let a = self.cellOf(ida);
    let b = self.cellOf(idb);
    if a == NoBody || b == NoBody { return NoBody; }
    let bA = self.bd(usize.from(a));
    let bB = self.bd(usize.from(b));
    var j = blankJoint(kind, a, b);
    j.la = bA.rot.conjugate() * (anchor - bA.pos);
    j.lb = bB.rot.conjugate() * (anchor - bB.pos);
    let f = World.frameOf(axis);
    j.fa = bA.rot.conjugate() * f;
    j.fb = bB.rot.conjugate() * f;
    joints.push(j);
    let ji = u32.from(joints.len()) - 1u32;
    jointsOf[usize.from(a)].push(ji);
    if b != a { jointsOf[usize.from(b)].push(ji); }
    noCollideJoints = true;
    self.wakeAt(a);
    self.wakeAt(b);
    u32.from(joints.len()) - 1u32
  }

  // A ball and socket: the two bodies share the world point
  pub fn addPointJoint(self: &mut, a: BodyId, b: BodyId, anchor: Vec3) u32 {
    self.addJoint(JointPoint, a, b, anchor, Vec3(1., 0., 0.))
  }
  // The two bodies held in the pose they have now
  pub fn addFixedJoint(self: &mut, a: BodyId, b: BodyId, anchor: Vec3) u32 {
    self.addJoint(JointFixed, a, b, anchor, Vec3(1., 0., 0.))
  }
  // A door hinge: turns about 'axis' through 'anchor'; angle 0 is the pose it was made in
  pub fn addHinge(self: &mut, a: BodyId, b: BodyId, anchor: Vec3, axis: Vec3) u32 {
    self.addJoint(JointHinge, a, b, anchor, axis)
  }
  pub fn setHingeLimits(self: &mut, j: u32, lower: f32, upper: f32) {
    joints[usize.from(j)].limitOn = true;
    joints[usize.from(j)].lower = lower;
    joints[usize.from(j)].upper = upper;
  }
  // Drive a hinge or slider to a speed (rad/s or m/s) with at most this torque or force
  pub fn setMotor(self: &mut, j: u32, speed: f32, maxTorque: f32) {
    joints[usize.from(j)].motorOn = true;
    joints[usize.from(j)].motorSpeed = speed;
    joints[usize.from(j)].motorMax = maxTorque;
    let jj = joints[usize.from(j)];
    self.wakeAt(jj.a);
    self.wakeAt(jj.b);
  }
  pub fn clearMotor(self: &mut, j: u32) { joints[usize.from(j)].motorOn = false; joints[usize.from(j)].impMotor = 0.; }
  // A drawer slide along 'axis'; offset 0 is where it was made
  pub fn addSlider(self: &mut, a: BodyId, b: BodyId, anchor: Vec3, axis: Vec3) u32 {
    self.addJoint(JointSlider, a, b, anchor, axis)
  }
  pub fn setSliderLimits(self: &mut, j: u32, lower: f32, upper: f32) { self.setHingeLimits(j, lower, upper); }
  // A rod of fixed length between two world points (one on each body)
  pub fn addDistance(self: &mut, a: BodyId, b: BodyId, anchorA: Vec3, anchorB: Vec3) u32 {
    let j = self.addJoint(JointDistance, a, b, anchorA, Vec3(1., 0., 0.));
    if j == NoBody { return NoBody; }
    let bB = self.bd(usize.from(b.index));
    joints[usize.from(j)].lb = bB.rot.conjugate() * (anchorB - bB.pos);
    let len = (anchorB - anchorA).length();
    joints[usize.from(j)].length = len;
    joints[usize.from(j)].lower = len;
    joints[usize.from(j)].upper = len;
    j
  }
  // A rope or telescoping rod: any length in [lower, upper] is free
  pub fn setDistanceRange(self: &mut, j: u32, lower: f32, upper: f32) {
    joints[usize.from(j)].limitOn = true;
    joints[usize.from(j)].lower = lower;
    joints[usize.from(j)].upper = upper;
  }
  // A spring to rest length 'length' (hertz 0: rigid)
  pub fn setDistanceSpring(self: &mut, j: u32, length: f32, hertz: f32, damping: f32) {
    joints[usize.from(j)].length = length;
    joints[usize.from(j)].hertz = hertz;
    joints[usize.from(j)].damping = damping;
  }
  // The ragdoll shoulder: a ball joint whose B may swing 'coneAngle' from A's x axis and twist in [lo, hi]
  pub fn addConeTwist(self: &mut, a: BodyId, b: BodyId, anchor: Vec3, twistAxis: Vec3, coneAngle: f32) u32 {
    let j = self.addJoint(JointConeTwist, a, b, anchor, twistAxis);
    if j == NoBody { return NoBody; }
    joints[usize.from(j)].coneAngle = coneAngle;
    j
  }
  // Make a cone-twist joint's swing range an ellipse instead of the round cone (Jolt's SwingTwistConstraint has a
  // normal and a plane half cone angle, here four quarter-axes): B's twist axis may deflect from A's by 'flex'
  // radians towards 'uDir', 'ext' the other way, 'abd' towards 'vDir' and 'add' the other way, the range being the
  // ellipse through the four in between. 'uDir' and 'vDir' are directions in A's body frame, perpendicular to the
  // twist axis (and to each other). The cone angle given to addConeTwist is then not used.
  pub fn setSwingEllipse(self: &mut, j: u32, uDir: Vec3, vDir: Vec3, flex: f32, ext: f32, abd: f32, add: f32) {
    let jj = &mut joints[usize.from(j)];
    jj.ellOn = true;
    jj.ellU = uDir.normalize();
    jj.ellV = vDir.normalize();
    jj.ellFlex = maxf(flex, 0.001);
    jj.ellExt = maxf(ext, 0.001);
    jj.ellAbd = maxf(abd, 0.001);
    jj.ellAdd = maxf(add, 0.001);
    jj.impEll = 0.;
  }
  pub fn setTwistLimits(self: &mut, j: u32, lo: f32, hi: f32) {
    joints[usize.from(j)].twistLo = lo;
    joints[usize.from(j)].twistHi = hi;
  }
  // May the two bodies a joint joins collide with each other? No by default (Box2D's collideConnected
  // and Godot's exclude-from-collision: a hinge's door and its frame overlap by design)
  pub fn setJointCollide(self: &mut, j: u32, collide: bool) {
    joints[usize.from(j)].collide = collide;
    noCollideJoints = false;
    var k = 0usize;
    while k < joints.len() { if joints[k].alive && !joints[k].collide { noCollideJoints = true; } k = k + 1usize; }
  }
  // Drive a point, hinge or cone-twist joint's relative rotation to a target as a spring (stiffness N m per radian,
  // damping N m s per radian) whose torque is at most maxTorque N m (see solveDrive). The target starts as the pose
  // the joint was made in; set it with setDriveTarget.
  pub fn setJointDrive(self: &mut, j: u32, stiffness: f32, damping: f32, maxTorque: f32) {
    joints[usize.from(j)].driveOn = true;
    joints[usize.from(j)].driveHertz = stiffness;
    joints[usize.from(j)].driveDamping = damping;
    joints[usize.from(j)].driveMax = maxTorque;
    self.wakeAt(joints[usize.from(j)].a);
    self.wakeAt(joints[usize.from(j)].b);
  }
  pub fn clearJointDrive(self: &mut, j: u32) {
    joints[usize.from(j)].driveOn = false;
    joints[usize.from(j)].impDrive = zero3();
  }
  // The target as the rotation of B's body relative to A's body (A's rotation inverse times B's) that the drive
  // should hold, converted into the joint's own frames
  pub fn setDriveTarget(self: &mut, j: u32, bodyRelative: Quat) {
    let jj = joints[usize.from(j)];
    joints[usize.from(j)].driveTarget = (jj.fa.conjugate() * bodyRelative * jj.fb).normalize();
  }
  pub fn removeJoint(self: &mut, j: u32) {
    if joints[usize.from(j)].alive {
      joints[usize.from(j)].alive = false;
      let a = joints[usize.from(j)].a;
      let b = joints[usize.from(j)].b;
      self.unindexJoint(a, j);
      if b != a { self.unindexJoint(b, j); }
    }
  }

  // Joint j is dead: drop it from body 'body's list of joints
  fn unindexJoint(self: &mut, body: u32, j: u32) {
    let bi = usize.from(body);
    var k = 0usize;
    while k < jointsOf[bi].len() {
      if *jointsOf[bi][k] == j {
        jointsOf[bi].swap(k, jointsOf[bi].len() - 1usize);
        jointsOf[bi].truncate(jointsOf[bi].len() - 1usize);
        return;
      }
      k = k + 1usize;
    }
  }
  // Make a joint breakable: it is removed, with an EvJointBroken event, in the first sub-step in which the force it
  // carries passes 'force' newtons or the torque it carries passes 'torque' N m (jointLoadOf says which rows count).
  // The load is the sub-step's row impulses over the sub-step's time, which is what PhysX's breakForce reads and what
  // Jolt's constraint-force queries give. Negative: that kind of load never breaks it.
  pub fn setJointBreak(self: &mut, j: u32, force: f32, torque: f32) {
    joints[usize.from(j)].breakForce = force;
    joints[usize.from(j)].breakTorque = torque;
  }
  // The force and torque joint j carried in the last sub-step, N and N m
  pub fn jointLoad(self: &, j: u32) (f32, f32) { jointLoadOf(&joints[usize.from(j)], substepSeconds) }

  // Remove the breakable joints loaded past their limits in the sub-step just solved
  fn breakJoints(self: &mut, h: f32) {
    var a = 0usize;
    while a < activeJoints.len() {
      let ji = usize.from(*activeJoints[a]);
      let jt = &joints[ji];
      if jt.breakForce < 0. && jt.breakTorque < 0. { a = a + 1usize; continue; }
      let load = jointLoadOf(jt, h);
      let byForce = jt.breakForce >= 0. && load.0 > jt.breakForce;
      let byTorque = jt.breakTorque >= 0. && load.1 > jt.breakTorque;
      if !(byForce || byTorque) { a = a + 1usize; continue; }
      {
        joints[ji].alive = false;
        activeJoints.swap(a, activeJoints.len() - 1usize);
        activeJoints.truncate(activeJoints.len() - 1usize);
        let bA = self.bd(usize.from(jt.a));
        self.emit(EvJointBroken, jt.a, jt.b, bA.pos + bA.rot * jt.la, zero3(), if byForce { load.0 } else { load.1 });
        events[events.len() - 1usize].id = u32.from(ji);
        self.wakeAt(jt.a);
        self.wakeAt(jt.b);
      }
    }
  }
  pub fn hingeAngleOf(self: &, j: u32) f32 { hingeAngle(self, &joints[usize.from(j)]) }
  // How far apart the joint's two anchors are now (zero when it is satisfied), metres
  pub fn jointError(self: &, j: u32) f32 { jointState(self, &joints[usize.from(j)]).d.length() }
  pub fn sliderOffsetOf(self: &, j: u32) f32 { sliderOffset(self, &joints[usize.from(j)]) }

  fn jointBlocks(self: &, a: u32, b: u32) bool {
    var k = 0usize;
    while k < joints.len() {
      let j = joints[k];
      if j.alive && !j.collide && ((j.a == a && j.b == b) || (j.a == b && j.b == a)) { return true; }
      k = k + 1usize;
    }
    false
  }

  // ------------------------------------------------------------------ queries

  // The nearest body a ray hits (see query.cone)
  pub fn castRay(self: &mut, origin: Vec3, dir: Vec3, maxT: f32, f: QueryFilter) WorldRayHit {
    worldRayCast(self, origin, dir, maxT, f)
  }
  // Sweep a shape along disp; the first body it meets
  pub fn castShape(self: &mut, shape: &Shape, xf: Rigid, disp: Vec3, f: QueryFilter) WorldCastHit {
    worldShapeCast(self, shape, xf, disp, f)
  }
  // The bodies a shape overlaps
  pub fn overlapShape(self: &mut, shape: &Shape, xf: Rigid, f: QueryFilter, out: &mut List[BodyId]) {
    worldOverlap(self, shape, xf, f, out);
  }
  // The bodies containing a point
  pub fn overlapPoint(self: &mut, p: Vec3, f: QueryFilter, out: &mut List[BodyId]) {
    let probe = Shape.single(Prim.sphere(0.));
    worldOverlap(self, &probe, Rigid.at(p), f, out);
  }

  // ------------------------------------------------------------------ the step

  // Advance by a frame's time in fixed steps (Fiedler, "Fix Your Timestep"); returns
  // the steps taken. The leftover is 'accumulator', over fixedDt the blend for drawing.
  pub fn advance(self: &mut, frameDt: f32) i32 {
    accumulator = accumulator + minf(frameDt, 0.25);
    var n = 0;
    while accumulator >= fixedDt {
      self.step(fixedDt);
      accumulator = accumulator - fixedDt;
      n = n + 1;
    }
    n
  }

  pub fn step(self: &mut, dt: f32) {
    stepCount = stepCount + 1u32;
    self.refreshBodies();
    self.updateBroadPhase(dt);
    self.updateContacts(dt);
    self.buildConstraints();
    self.solve(dt);
    self.finalize(dt);
  }

  // The phases of a step, public so a program can time them one by one (World.step calls them in this order)
  pub fn refreshBodies(self: &mut) {
    // (the loops over the bodies walk the cells 0 to bound() in index order, as the old table was, and skip the empty ones)
    let n = usize.from(bodies.bound());
    var i = 0usize;
    while i < n {
      let p = bodies.at(u32.from(i));
      if p as usize != 0usize {
        let b = p as &mut Body;
        b.dpos = zero3();
        b.dq = Quat.identity();
        b.color = 0u64;
        b.startPos = b.pos - b.rot * b.comLocal;
        b.startRot = b.rot;
        if b.motion == MotionDynamic {
          b.invInertia = rotateInertia(b.rot, b.invInertiaLocal);
        }
      }
      i = i + 1usize;
    }
  }

  pub fn updateBroadPhase(self: &mut, dt: f32) {
    let n = usize.from(bodies.bound());
    var i = 0usize;
    while i < n {
      let p = bodies.at(u32.from(i));
      if p as usize != 0usize {
        let b = p as &Body;
        if isAwakeDynamic(b) || isMovingKinematic(b) { bp.update(u32.from(i), self.bodyBox(i, dt)); }
      }
      i = i + 1usize;
    }
  }

  fn isMover(self: &, i: usize) bool {
    let b = self.bd(i);
    isAwakeDynamic(b) || isMovingKinematic(b)
  }

  // Narrow phase over the broad phase's pairs, refreshing the cache
  pub fn updateContacts(self: &mut, dt: f32) {
    bp.pairs(&mut pairs);
    lastPairs = pairs.len();
    next.clear();
    var oldIdx = 0usize;
    var out = List[Manifold]();
    var p = 0usize;
    while p < pairs.len() {
      let a = pairs[p].a;
      let b = pairs[p].b;
      // old groups that sort before this pair belong to pairs that no longer overlap
      while oldIdx < cache.len() && (cache[oldIdx].a < a || (cache[oldIdx].a == a && cache[oldIdx].b < b)) {
        let g = cache[oldIdx].a;
        let h = cache[oldIdx].b;
        self.retire(oldIdx, g, h);
        while oldIdx < cache.len() && cache[oldIdx].a == g && cache[oldIdx].b == h { oldIdx = oldIdx + 1usize; }
      }
      var groupEnd = oldIdx;
      while groupEnd < cache.len() && cache[groupEnd].a == a && cache[groupEnd].b == b { groupEnd = groupEnd + 1usize; }
      let ia = usize.from(a);
      let ib = usize.from(b);
      let moving = self.isMover(ia) || self.isMover(ib);
      if !moving {
        // nothing here is moving: the old manifolds stand
        var g = oldIdx;
        while g < groupEnd { next.push(*cache[g]); g = g + 1usize; }
        oldIdx = groupEnd;
      } else if noCollideJoints && self.jointBlocks(a, b) {
        self.retire(oldIdx, a, b);
        oldIdx = groupEnd;
      } else {
        let bA = bodies.at(u32.from(ia)) as &Body;       // the body pointers, once for the pair
        let bB = bodies.at(u32.from(ib)) as &Body;
        let asleepA = bA.asleep;
        let asleepB = bB.asleep;
        let margin = settings.speculativeDistance + self.velMargin(ia, dt) + self.velMargin(ib, dt);
        let xfA = Rigid(bA.pos - bA.rot * bA.comLocal, bA.rot);
        let xfB = Rigid(bB.pos - bB.rot * bB.comLocal, bB.rot);
        out.clear();
        collide(&shapes[usize.from(bA.shape)], xfA, &shapes[usize.from(bB.shape)], xfB, margin, &mut out);
        let sensor = bA.sensor || bB.sensor;
        var anyOldTouching = false;
        var g = oldIdx;
        while g < groupEnd { if cache[g].touching { anyOldTouching = true; } g = g + 1usize; }
        var usedMask = List[u32]();
        g = oldIdx;
        while g < groupEnd { usedMask.push(0u32); g = g + 1usize; }
        var anyNew = false;
        var anyNewTouching = false;
        var bestDepth = -bigNumber;
        var bestPoint = zero3();
        var bestNormal = zero3();
        var m = 0usize;
        // The manifolds are used as the narrow phase gives them: a body on a mesh or heightfield
        // gets one manifold per flat patch with the face's own normal (rigidcollide merges them),
        // and a depth is never beyond what the two shapes' widths allow
        let prep = &out;
        while m < prep.len() {
          let mf = prep[m];
          if mf.count > 0usize {
            var c = blankContact(a, b);
            c.partA = mf.partA; c.partB = mf.partB; c.subA = mf.subA; c.subB = mf.subB;
            c.normal = mf.normal;
            c.count = mf.count;
            c.sensor = sensor;
            c.friction = combineFriction(bA.material.friction, bB.material.friction);
            c.staticFriction = combineFriction(bA.material.staticFriction, bB.material.staticFriction);
            c.restitution = combineRestitution(bA.material.restitution, bB.material.restitution);
            c.rolling = combineFriction(bA.material.rolling, bB.material.rolling);
            c.stamp = stepCount;
            // Warm starting: each point inherits the normal impulse of the nearest unused old point of the
            // pair, found by position in A's frame, whichever old manifold it was in. (Matching only within
            // the manifold of the same triangle or part loses the impulses when a body on a mesh or a
            // heightfield moves from one triangle to another, and the lost support is felt as a jolt.)
            // The manifold's friction impulses come from the old manifold that gave it the most points,
            // or else the one of the same pieces.
            var inherit = groupEnd;
            var k = 0usize;
            if settings.warmStart && groupEnd > oldIdx {
              var votes = List[i32]();
              var v = oldIdx;
              while v < groupEnd { votes.push(0); v = v + 1usize; }
              while k < mf.count {
                let mp = mf.points[k];
                let pnt = (mp.onA + mp.onB) * 0.5;
                c.pts[k].depth = mp.depth;
                c.pts[k].rA = pnt - bA.pos;
                c.pts[k].rB = pnt - bB.pos;
                c.pts[k].spot = xfA.unapply(mp.onA);
                var best = settings.matchDistance * settings.matchDistance;
                var bg = groupEnd;
                var bq = 4usize;
                var g3 = oldIdx;
                while g3 < groupEnd {
                  var q = 0usize;
                  while q < cache[g3].count {
                    if (*usedMask[g3 - oldIdx] & (1u32 << u32.from(q))) == 0u32 {
                      let dd = (cache[g3].pts[q].spot - c.pts[k].spot);
                      let d2 = dd.dot(dd);
                      if d2 < best { best = d2; bg = g3; bq = q; }
                    }
                    q = q + 1usize;
                  }
                  g3 = g3 + 1usize;
                }
                if bg < groupEnd {
                  usedMask.set(bg - oldIdx, *usedMask[bg - oldIdx] | (1u32 << u32.from(bq)));
                  c.pts[k].nImp = cache[bg].pts[bq].nImp;
                  votes.set(bg - oldIdx, *votes[bg - oldIdx] + 1);
                }
                k = k + 1usize;
              }
              var topVotes = 0;
              v = oldIdx;
              while v < groupEnd {
                if *votes[v - oldIdx] > topVotes { topVotes = *votes[v - oldIdx]; inherit = v; }
                v = v + 1usize;
              }
              if inherit == groupEnd {
                v = oldIdx;
                while v < groupEnd {
                  if sameKey(&cache[v], a, b, mf.partA, mf.partB, mf.subA, mf.subB) { inherit = v; break; }
                  v = v + 1usize;
                }
              }
            } else {
              while k < mf.count {
                let mp = mf.points[k];
                let pnt = (mp.onA + mp.onB) * 0.5;
                c.pts[k].depth = mp.depth;
                c.pts[k].rA = pnt - bA.pos;
                c.pts[k].rB = pnt - bB.pos;
                c.pts[k].spot = xfA.unapply(mp.onA);
                k = k + 1usize;
              }
            }
            if inherit < groupEnd {
              c.f1 = cache[inherit].f1;
              c.f2 = cache[inherit].f2;
              c.ft = cache[inherit].ft;
              c.r1 = cache[inherit].r1;
              c.r2 = cache[inherit].r2;
            }
            let deepest = mf.deepest();
            if sensor {
              c.touching = deepest >= 0.;
            } else if anyOldTouching {
              c.touching = deepest > -3. * settings.linearSlop;
            } else {
              c.touching = deepest >= -settings.linearSlop;
            }
            anyNew = true;
            if c.touching { anyNewTouching = true; }
            if deepest > bestDepth { bestDepth = deepest; bestPoint = (mf.points[0usize].onA + mf.points[0usize].onB) * 0.5; bestNormal = mf.normal; }
            next.push(c);
          }
          m = m + 1usize;
        }
        // waking: an awake body touching a sleeping one wakes it
        if anyNew && !sensor {
          if asleepA && self.isMover(ib) { self.wakeAt(a); }
          if asleepB && self.isMover(ia) { self.wakeAt(b); }
        }
        // events
        if sensor {
          if anyNewTouching && !anyOldTouching {
            if bA.sensor { self.emit(EvSensorEnter, a, b, bestPoint, bestNormal, bestDepth); }
            else { self.emit(EvSensorEnter, b, a, bestPoint, bestNormal, bestDepth); }
          } else if anyOldTouching && !anyNewTouching {
            if bA.sensor { self.emit(EvSensorExit, a, b, bestPoint, bestNormal, bestDepth); }
            else { self.emit(EvSensorExit, b, a, bestPoint, bestNormal, bestDepth); }
          }
        } else {
          if anyNewTouching && !anyOldTouching {
            self.emit(EvContactAdded, a, b, bestPoint, bestNormal, bestDepth);
          } else if anyOldTouching && !anyNewTouching {
            self.emit(EvContactRemoved, a, b, bestPoint, bestNormal, bestDepth);
          } else if anyNewTouching && settings.persistedEvents {
            self.emit(EvContactPersisted, a, b, bestPoint, bestNormal, bestDepth);
          }
        }
        oldIdx = groupEnd;
      }
      p = p + 1usize;
    }
    // the rest of the old cache is for pairs that are gone
    while oldIdx < cache.len() {
      let g = cache[oldIdx].a;
      let h = cache[oldIdx].b;
      self.retire(oldIdx, g, h);
      while oldIdx < cache.len() && cache[oldIdx].a == g && cache[oldIdx].b == h { oldIdx = oldIdx + 1usize; }
    }
    // swap
    cache.clear();
    var k = 0usize;
    while k < next.len() { cache.push(*next[k]); k = k + 1usize; }
    next.clear();
  }

  // The manifolds of a pair that no longer exists: say so if they were touching
  fn retire(self: &mut, from: usize, a: u32, b: u32) {
    var touching = false;
    var sensor = false;
    var g = from;
    while g < cache.len() && cache[g].a == a && cache[g].b == b {
      if cache[g].touching { touching = true; }
      if cache[g].sensor { sensor = true; }
      g = g + 1usize;
    }
    if touching {
      if sensor {
        if self.bd(usize.from(a)).sensor { self.emit(EvSensorExit, a, b, zero3(), zero3(), 0.); }
        else { self.emit(EvSensorExit, b, a, zero3(), zero3(), 0.); }
      } else {
        self.emit(EvContactRemoved, a, b, zero3(), zero3(), 0.);
      }
    }
  }

  // The contacts and joints the solver will work on, contacts in colour order
  pub fn buildConstraints(self: &mut) {
    active.clear();
    activeJoints.clear();
    var colorOf = List[u8]();
    var maxColor = -1;
    var ci = 0usize;
    while ci < cache.len() { colorOf.push(0u8); ci = ci + 1usize; }
    // Greedy graph colouring: each contact takes the lowest colour neither of its
    // dynamic bodies has yet. Contacts between two dynamic bodies are coloured first
    // and those against a static or kinematic body after them, so the solver meets
    // the ground last (Box2D v3 does this: what the last pass satisfies, holds best).
    var pass = 0;
    var base = 0;
    while pass < 2 {
      ci = 0usize;
      while ci < cache.len() {
        let c = cache[ci];
        if !c.sensor && c.count > 0usize {
          let ia = usize.from(c.a);
          let ib = usize.from(c.b);
          let pa = self.bd(ia);
          let pb = self.bd(ib);
          let aw = isAwakeDynamic(pa);
          let bw = isAwakeDynamic(pb);
          if (aw || bw) && !pa.asleep && !pb.asleep && ((aw && bw) == (pass == 0)) {
            var used = 0u64;
            if aw { used = used | pa.color; }
            if bw { used = used | pb.color; }
            var col = base;
            while col < 63 && (used & (1u64 << u64.from(col))) != 0u64 { col = col + 1; }
            let bit = 1u64 << u64.from(col);
            if aw { pa.color = pa.color | bit; }
            if bw { pb.color = pb.color | bit; }
            colorOf.set(ci, u8.from(col));
            if col > maxColor { maxColor = col; }
            active.push(u32.from(ci));
          }
        }
        ci = ci + 1usize;
      }
      base = maxColor + 1;
      pass = pass + 1;
    }
    // stable by colour
    var ordered = List[u32]();
    var col = 0;
    while col <= maxColor {
      var k = 0usize;
      while k < active.len() {
        if i32.from(*colorOf[usize.from(*active[k])]) == col { ordered.push(*active[k]); }
        k = k + 1usize;
      }
      col = col + 1;
    }
    active.clear();
    var k = 0usize;
    while k < ordered.len() { active.push(*ordered[k]); k = k + 1usize; }
    lastColors = maxColor + 1;
    lastContacts = active.len();
    // joints: wake what an awake body is joined to
    var ji = 0usize;
    while ji < joints.len() {
      if joints[ji].alive {
        let ja = joints[ji].a;
        let jb = joints[ji].b;
        let aw = isAwakeDynamic(self.bd(usize.from(ja)));
        let bw = isAwakeDynamic(self.bd(usize.from(jb)));
        if aw && self.bd(usize.from(jb)).asleep { self.wakeAt(jb); }
        if bw && self.bd(usize.from(ja)).asleep { self.wakeAt(ja); }
        if aw || bw { activeJoints.push(u32.from(ji)); }
      }
      ji = ji + 1usize;
    }
  }

  fn integrateVelocities(self: &mut, h: f32) {
    let g = gravity;
    let maxV = settings.maxLinearSpeed;
    let maxW = settings.maxAngularSpeed;
    let n = usize.from(bodies.bound());
    var i = 0usize;
    while i < n {
      let p = bodies.at(u32.from(i));
      if p as usize != 0usize && isAwakeDynamic(p as &Body) {
        let b = p as &mut Body;
        var v = b.linVel + (g * b.gravityFactor + b.force * b.invMass) * h;
        var w = b.angVel + b.invInertia * b.torque * h;
        if b.gyro {
          // implicit gyroscopic torque, one Newton step in the body frame (Catto, "Numerical Methods", GDC 2015):
          // solve I (w' - w) + h w' x (I w') = 0
          let wl = b.rot.conjugate() * w;
          let iw = b.inertiaLocal * wl;
          let f = wl.cross(iw) * h;
          let jm = mat3Add(b.inertiaLocal, mat3Scale(mat3Add(skew(wl) * b.inertiaLocal, mat3Scale(skew(iw), -1.)), h));
          let dw = jm.inverse() * f;
          w = b.rot * (wl - dw);
        }
        v = v * (1. / (1. + h * b.linearDamping));
        w = w * (1. / (1. + h * b.angularDamping));
        b.linVel = clampVec(v, maxV);
        b.angVel = clampVec(w, maxW);
      }
      i = i + 1usize;
    }
  }

  fn integratePositions(self: &mut, h: f32) {
    let n = usize.from(bodies.bound());
    var i = 0usize;
    while i < n {
      let p = bodies.at(u32.from(i));
      if p as usize != 0usize && !(p as &Body).asleep && (p as &Body).motion != MotionStatic {
        let b = p as &mut Body;
        if b.motion == MotionDynamic || isMovingKinematic(b) {
          let dp = b.linVel * h;
          b.pos = b.pos + dp;
          b.dpos = b.dpos + dp;
          b.rot = integrateRotation(b.rot, b.angVel, h);
          b.dq = integrateRotation(b.dq, b.angVel, h);
          if b.motion == MotionDynamic { b.invInertia = rotateInertia(b.rot, b.invInertiaLocal); }
        }
      }
      i = i + 1usize;
    }
  }

  // One Gauss-Seidel sweep over the joints. A joint's softness is Catto's spring (a frequency and a damping
  // ratio) taken on the mass of its two bodies, which makes a light body on a heavy one far too soft: the
  // spring that holds a 1 kg foot to its shin has to hold up the whole body when it lands. So the row's mass
  // is measured against the heavier body instead (as PhysX's joint inverse-mass scales do): with
  // rho = reduced mass / heavier mass, the mass scale is a2 / (a2 + rho) and the impulse scale rho / (a2 + rho),
  // where a2 = hw (2 zeta + hw) is the spring's own number; rho = 1 (a static anchor) is the plain form.
  fn sweepJoints(self: &mut, useBias: bool, invH: f32, h: f32, jsoft: Softness) {
    var a = 0usize;
    while a < activeJoints.len() {
      let ji = usize.from(*activeJoints[a]);
      let mA = self.bd(usize.from(joints[ji].a)).mass;
      let mB = self.bd(usize.from(joints[ji].b)).mass;
      let reduced = if mA <= 0. { mB } else if mB <= 0. { mA } else { mA * mB / (mA + mB) };
      let rho = if jsoft.massScale >= 1. || jsoft.massScale <= 0. || reduced <= 0. { 1. } else { reduced / maxf(mA, mB) };
      let a2 = jsoft.massScale / (1. - jsoft.massScale);
      let js = if rho >= 1. { jsoft } else { Softness(jsoft.biasRate, a2 / (a2 + rho), rho / (a2 + rho)) };
      solveJoint(self, ji, useBias, invH, h, js);
      a = a + 1usize;
    }
  }

  // One sweep over the contacts of 'list' (indices into 'cache'), forwards or backwards
  fn sweepContacts(self: &mut, list: &List[u32], useBias: bool, rev: bool, invH: f32, soft: Softness, softStatic: Softness) {
    var a = 0usize;
    while a < list.len() {
      let ai = if rev { list.len() - 1usize - a } else { a };
      solveContact(self, usize.from(*list[ai]), useBias, rev, invH, soft, softStatic);
      a = a + 1usize;
    }
  }

  pub fn solve(self: &mut, dt: f32) {
    let substeps = if settings.substeps < 1 { 1 } else { settings.substeps };
    let h = dt / f32.from(substeps);
    let invH = 1. / h;
    let hz = minf(settings.contactHertz, 0.25 * invH);
    let soft = makeSoft(hz, settings.contactDamping, h);
    let softStatic = makeSoft(2. * hz, settings.contactDamping, h);
    let jsoft = makeSoft(settings.jointHertz, settings.jointDamping, h);
    let sweeps = if settings.jointIterations < 1 { 1 } else { settings.jointIterations };
    var a = 0usize;
    while a < active.len() { prepareContact(self, usize.from(*active[a])); a = a + 1usize; }
    // The contacts of bodies on joints: a joint passes a contact's push along the chain one link a sweep, so
    // these and the joints are swept 'jointIterations' times a sub-step, the other contacts once
    var artic = List[u32]();
    if sweeps > 1 && activeJoints.len() > 0usize {
      var jointed = List[bool]();
      var bi = 0usize;
      while bi < usize.from(bodies.bound()) { jointed.push(false); bi = bi + 1usize; }
      a = 0usize;
      while a < activeJoints.len() {
        jointed.set(usize.from(joints[usize.from(*activeJoints[a])].a), true);
        jointed.set(usize.from(joints[usize.from(*activeJoints[a])].b), true);
        a = a + 1usize;
      }
      a = 0usize;
      while a < active.len() {
        let c = cache[usize.from(*active[a])];
        if *jointed[usize.from(c.a)] || *jointed[usize.from(c.b)] { artic.push(*active[a]); }
        a = a + 1usize;
      }
    }
    let warm = settings.warmStart;
    var s = 0;
    while s < substeps {
      self.integrateVelocities(h);
      a = 0usize;
      while a < activeJoints.len() { warmStartJoint(self, usize.from(*activeJoints[a])); a = a + 1usize; }
      if warm {
        a = 0usize;
        while a < active.len() { warmStartContact(self, usize.from(*active[a])); a = a + 1usize; }
      } else {
        a = 0usize;
        while a < active.len() { self.zeroImpulses(usize.from(*active[a])); a = a + 1usize; }
      }
      let odd = (s % 2) == 1;
      self.sweepJoints(true, invH, h, jsoft);
      self.sweepContacts(&active, true, odd, invH, soft, softStatic);
      var rep = 1;
      while rep < sweeps {
        self.sweepJoints(true, invH, h, jsoft);
        self.sweepContacts(&artic, true, odd != ((rep % 2) == 1), invH, soft, softStatic);
        rep = rep + 1;
      }
      self.integratePositions(h);
      var r = 0;
      while r < settings.relaxIterations {
        self.sweepJoints(false, invH, h, jsoft);
        self.sweepContacts(&active, false, !odd, invH, soft, softStatic);
        r = r + 1;
      }
      rep = 1;
      while rep < sweeps {
        self.sweepJoints(false, invH, h, jsoft);
        self.sweepContacts(&artic, false, odd == ((rep % 2) == 1), invH, soft, softStatic);
        rep = rep + 1;
      }
      substepSeconds = h;
      self.breakJoints(h);
      s = s + 1;
    }
    a = 0usize;
    while a < active.len() { applyRestitution(self, usize.from(*active[a]), settings.restitutionThreshold); a = a + 1usize; }
  }

  fn zeroImpulses(self: &mut, ci: usize) {
    let c = &mut cache[ci];
    var k = 0usize;
    while k < c.count {
      c.pts[k].nImp = 0.;
      k = k + 1usize;
    }
    c.f1 = 0.;
    c.f2 = 0.;
    c.ft = 0.;
    c.r1 = 0.;
    c.r2 = 0.;
  }

  // After the sub-steps: continuous collision, sleep timers, islands
  pub fn finalize(self: &mut, dt: f32) {
    if settings.ccd { self.continuous(dt); }
    let n = usize.from(bodies.bound());
    var i = 0usize;
    while i < n {
      let p = bodies.at(u32.from(i));
      if p as usize != 0usize && isAwakeDynamic(p as &Body) {
        let b = p as &mut Body;
        b.force = zero3();
        b.torque = zero3();
      }
      i = i + 1usize;
    }
    if settings.sleepEnabled { self.updateSleep(dt); }
  }

  // Continuous collision (Box2D v3 style): a body that moved far in one step is
  // swept from where it began; if the sweep hits something, the body is put back
  // at the hit (a little short of it), keeping its velocity, and next step's
  // contact does the rest. Static bodies are swept against always; other
  // bodies only by a 'bullet'. The sweep is rigidcollide's shapeCast (translation only).
  fn continuous(self: &mut, dt: f32) {
    var i = 0usize;
    var cands = List[u32]();
    // A body on a joint is not put back: the bodies it is joined to would not follow, and the joint would be
    // torn open by the distance the body was moved (the first landing of a ragdoll's foot opened its ankle by up
    // to 15 cm). Its speculative contacts, made a velocity's reach ahead (maxSpeculative), already stop it at a
    // surface; only a move longer than that reach is swept.
    var jointed = List[bool]();
    let n = usize.from(bodies.bound());
    while i < n { jointed.push(false); i = i + 1usize; }
    var ji = 0usize;
    while ji < joints.len() {
      if joints[ji].alive {
        jointed.set(usize.from(joints[ji].a), true);
        jointed.set(usize.from(joints[ji].b), true);
      }
      ji = ji + 1usize;
    }
    i = 0usize;
    while i < n {
      let pb = bodies.at(u32.from(i));
      if pb as usize == 0usize { i = i + 1usize; continue; }
      let b = pb as &mut Body;
      if isAwakeDynamic(b) && !b.sensor {
        let now = Rigid(b.pos - b.rot * b.comLocal, b.rot);
        let disp = now.pos - b.startPos;
        let dist = disp.length();
        let reach = if *jointed[i] { settings.maxSpeculative } else { 0. };
        if dist > settings.ccdThreshold * 2. * b.minExtent && dist > 0.0001 && dist > reach {
          let sh = &shapes[usize.from(b.shape)];
          let startXf = Rigid(b.startPos, b.startRot);
          let swept = sh.bounds(startXf).union(sh.bounds(now)).expand(0.01);
          bp.queryBox(swept, b.mask, &mut cands);
          var bestT = 2.f;
          var k = 0usize;
          while k < cands.len() {
            let oj = usize.from(*cands[k]);
            let o = self.bd(oj);
            let eligible = oj != i && !o.sensor && (o.layer & b.mask) != 0u32 && (b.layer & o.mask) != 0u32
              && (o.motion == MotionStatic || b.bullet);
            if eligible {
              let oxf = Rigid(o.pos - o.rot * o.comLocal, o.rot);
              let hit = shapeCast(sh, startXf, disp, &shapes[usize.from(o.shape)], oxf);
              // a hit counts if the sweep goes into the surface at more than about 6 degrees: one that
              // grazes it is a body sliding along a surface it rests on, which the contacts handle
              if hit.hit && hit.fraction > 0.0001 && hit.fraction < bestT && hit.normal.dot(disp) > 0.1 * dist { bestT = hit.fraction; }
            }
            k = k + 1usize;
          }
          if bestT <= 1. {
            let t = maxf(0., bestT - settings.linearSlop / dist);
            let origin = b.startPos + disp * t;
            let rot = b.startRot.slerp(b.rot, t);
            let newPos = origin + rot * b.comLocal;
            b.rot = rot;
            b.pos = newPos;
          }
        }
      }
      i = i + 1usize;
    }
  }

  // Islands (union-find over contacts and joints between awake dynamic bodies) go to
  // sleep when every body in them has been slow for timeToSleep
  fn updateSleep(self: &mut, dt: f32) {
    let n = usize.from(bodies.bound());
    var parent = List[u32]();
    var minSleep = List[f32]();
    var i = 0usize;
    while i < n { parent.push(u32.from(i)); minSleep.push(bigNumber); i = i + 1usize; }
    var a = 0usize;
    while a < active.len() {
      let c = cache[usize.from(*active[a])];
      let ia = usize.from(c.a);
      let ib = usize.from(c.b);
      if self.bd(ia).motion == MotionDynamic && self.bd(ib).motion == MotionDynamic { unionSets(&mut parent, c.a, c.b); }
      a = a + 1usize;
    }
    a = 0usize;
    while a < activeJoints.len() {
      let j = joints[usize.from(*activeJoints[a])];
      if self.bd(usize.from(j.a)).motion == MotionDynamic && self.bd(usize.from(j.b)).motion == MotionDynamic { unionSets(&mut parent, j.a, j.b); }
      a = a + 1usize;
    }
    i = 0usize;
    while i < n {
      let p = bodies.at(u32.from(i));
      if p as usize != 0usize && isAwakeDynamic(p as &Body) {
        let b = p as &mut Body;
        // Box2D's measure: the faster of its speed and its farthest point's speed from spin
        let slow = maxf(b.linVel.length(), b.angVel.length() * b.radius) < settings.sleepSpeed;
        if slow && b.allowSleep { b.sleepTime = b.sleepTime + dt; } else { b.sleepTime = 0.; }
        let r = usize.from(findSet(&mut parent, u32.from(i)));
        minSleep.set(r, minf(*minSleep[r], if b.allowSleep { b.sleepTime } else { 0. }));
      }
      i = i + 1usize;
    }
    // a moving kinematic body touching an island keeps it awake
    a = 0usize;
    while a < active.len() {
      let c = cache[usize.from(*active[a])];
      let bA = self.bd(usize.from(c.a));
      let bB = self.bd(usize.from(c.b));
      if bA.motion == MotionDynamic && isMovingKinematic(bB) {
        let r = usize.from(findSet(&mut parent, c.a));
        minSleep.set(r, 0.);
        bA.sleepTime = 0.;
      }
      if bB.motion == MotionDynamic && isMovingKinematic(bA) {
        let r = usize.from(findSet(&mut parent, c.b));
        minSleep.set(r, 0.);
        bB.sleepTime = 0.;
      }
      a = a + 1usize;
    }
    var groups = List[u32]();
    i = 0usize;
    while i < n { groups.push(0u32); i = i + 1usize; }
    i = 0usize;
    while i < n {
      let p = bodies.at(u32.from(i));
      if p as usize != 0usize && isAwakeDynamic(p as &Body) {
        let b = p as &mut Body;
        let r = usize.from(findSet(&mut parent, u32.from(i)));
        if *minSleep[r] >= settings.timeToSleep {
          if *groups[r] == 0u32 { groups.set(r, nextGroup); nextGroup = nextGroup + 1u32; }
          b.asleep = true;
          b.linVel = zero3();
          b.angVel = zero3();
          b.sleepGroup = *groups[r];
          self.emit(EvSleep, u32.from(i), NoBody, zero3(), zero3(), 0.);
        }
      }
      i = i + 1usize;
    }
  }
}

fn findSet(parent: &mut List[u32], x: u32) u32 {
  var r = x;
  while *parent[usize.from(r)] != r { r = *parent[usize.from(r)]; }
  var c = x;
  while *parent[usize.from(c)] != r {
    let nx = *parent[usize.from(c)];
    parent.set(usize.from(c), r);
    c = nx;
  }
  r
}

fn unionSets(parent: &mut List[u32], a: u32, b: u32) {
  let ra = findSet(parent, a);
  let rb = findSet(parent, b);
  if ra != rb { if ra < rb { parent.set(usize.from(rb), ra); } else { parent.set(usize.from(ra), rb); } }
}
