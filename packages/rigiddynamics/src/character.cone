// The character controller: a kinematic capsule that walks the world.
//
// It is not a rigid body (Jolt, Bullet and Godot agree that a walking character
// is not rigid-body physics). Nothing pushes it but its own velocity: it
// casts its capsule through the world's shapes and slides along what it hits.
// It is Jolt's CharacterVirtual in what it does, built from rigidcollide's
// shape cast and manifolds:
//
//   - collide and slide (Kasper Fauerby, "Improved Collision detection and
//     Response", 2003; Jolt's CharacterVirtual::MoveShape): sweep the capsule
//     along the wanted move; at a hit stop a skin's width short and slide the
//     rest of the move along the surface, keeping every surface already met
//     honoured, a crease slid along;
//   - a walkable slope has a normal within the maximum slope angle of up. A
//     steeper one is a wall: a move along it that would climb is turned into
//     one along the vertical wall, and gravity slides the character down it;
//   - stairs (Jolt's WalkStairs): when a move on the ground is blocked, lift
//     the capsule by the step height, make the move over the top, drop back to
//     the floor, and keep the result if the new floor is walkable and the
//     character got further. The floor is tested a radius ahead of the move, as
//     Jolt's forward test does, because at the very edge of a step the capsule's
//     contact is with the edge and its normal leans;
//   - stick to floor: after a move on the ground with no jump, drop up to
//     stickDistance, so walking down slopes and off steps stays on the ground;
//   - the ground is found by a short cast down; its body, normal, contact point
//     and the velocity of the body's material there are reported;
//   - a ground body that moves (a platform) carries the character by the
//     velocity at the contact point times the step, and turns it by the
//     platform's spin about up;
//   - a dynamic body hit is pushed by an impulse of the character's mass times
//     the speed into it, and one stood on is loaded with the character's weight.
//
// The capsule stands upright (+y is up). 'pos' is the point under the feet.

pub struct CharacterSettings {
  pub radius: f32;
  pub halfHeight: f32;       // half the length of the capsule's straight part
  pub maxSlope: f32;         // radians from up: steeper ground is a wall
  pub stepHeight: f32;       // the highest step it climbs
  pub skin: f32;             // the gap it keeps from surfaces
  pub stickDistance: f32;    // how far it follows the ground down
  pub mask: u32;             // the layers it collides with
  pub mass: f32;             // for pushing bodies and standing on them
  pub gravity: f32;          // m/s^2
  pub maxFallSpeed: f32;
  pub pushStrength: f32;     // 0 to not push bodies, 1 to push with its mass

  // A person-sized capsule: 'height' tall in all, 'radius' round, climbing steps of 0.4 m and slopes to 45 degrees
  pub fn person(radius: f32, height: f32) CharacterSettings {
    CharacterSettings(radius, maxf(0.01, height * 0.5 - radius), 0.7853982, 0.4, 0.02, 0.35, 0xffffffffu32, 70., 9.81, 55., 1.)
  }
}

pub struct Character {
  pub s: CharacterSettings;
  pub shape: Shape;
  pub pos: Vec3;                 // under the feet
  pub vel: Vec3;                 // its velocity as it moved last update (relative to the ground when on it: zero)
  pub grounded: bool;
  pub groundBody: u32;
  pub groundNormal: Vec3;
  pub groundPoint: Vec3;
  pub groundVelocity: Vec3;      // the ground's velocity under the feet
  pub onSteep: bool;             // touching ground too steep to stand on
  pub steepNormal: Vec3;
  pub platformYaw: f32;          // the turn the ground gave it this update, about up
  pub moved: Vec3;               // how far it went this update
  pub landSpeed: f32;            // the speed it hit the ground at, in the update it landed (else 0): a hard landing's measure

  pub fn make(s: CharacterSettings, pos: Vec3) Character {
    Character(s, Shape.single(Prim.capsule(s.radius, s.halfHeight)), pos, zero3(), false, NoBody, Vec3(0., 1., 0.), pos,
      zero3(), false, Vec3(0., 1., 0.), 0., zero3(), 0.)
  }

  // The capsule's placement with its feet at 'at'
  pub fn placement(self: &, at: Vec3) Rigid { Rigid.at(at + Vec3(0., s.halfHeight + s.radius, 0.)) }
  // The point at the middle of the capsule
  pub fn center(self: &) Vec3 { pos + Vec3(0., s.halfHeight + s.radius, 0.) }
  pub fn teleport(self: &mut, p: Vec3) { pos = p; vel = zero3(); grounded = false; groundBody = NoBody; }
}

// ---------------------------------------------------------------------------

fn upV() Vec3 { Vec3(0., 1., 0.) }
fn downV() Vec3 { Vec3(0., -1., 0.) }

// The nearest hit of the capsule moved from 'from' by 'disp'
fn sweepCapsule(w: &mut World, ch: &Character, from: Vec3, disp: Vec3) WorldCastHit {
  let f = QueryFilter(ch.s.mask, NoBody, false);
  worldShapeCast(w, &ch.shape, ch.placement(from), disp, f)
}

// Push the capsule out of whatever it overlaps (a platform moving into it, a spawn in a wall)
fn depenetrate(w: &mut World, ch: &mut Character) {
  let f = QueryFilter(ch.s.mask, NoBody, false);
  var it = 0;
  var cs = List[BodyManifold].empty();
  // surfaces nearer than a quarter of the skin are pushed back to half of it
  let near = -ch.s.skin * 0.25;
  let gap = ch.s.skin * 0.5;
  while it < 4 {
    worldContacts(w, &ch.shape, ch.placement(ch.pos), ch.s.skin, f, &mut cs);
    var deepest = near;
    var push = zero3();
    var k = 0usize;
    while k < cs.len() {
      let bm = cs[k];
      let d = bm.m.deepest();
      if d > deepest { deepest = d; push = bm.m.normal * (-(d + gap)); }
      k = k + 1usize;
    }
    if deepest <= near { break; }
    ch.pos = ch.pos + push;
    it = it + 1;
  }
}

// Move from 'start' by 'disp', sliding along what is in the way; where it ends up.
// 'push' lets it shove dynamic bodies.
fn slideMove(w: &mut World, ch: &Character, start: Vec3, disp: Vec3, push: bool, dt: f32) Vec3 {
  let cosSlope = cos(ch.s.maxSlope);
  let skin = ch.s.skin;
  var pos = start;
  var remaining = disp;
  var planes = List[Vec3].empty();
  var it = 0;
  while it < 6 {
    let len = remaining.length();
    if len < 0.00001 { break; }
    let dir = remaining * (1. / len);
    let hit = sweepCapsule(w, ch, pos, remaining);
    if !hit.hit {
      pos = pos + remaining;
      break;
    }
    let nS = hit.normal * -1.;
    let toward = maxf(-dir.dot(nS), 0.05);
    let adv = maxf(0., hit.fraction * len - skin / toward);
    pos = pos + dir * adv;
    remaining = dir * (len - adv);
    // shove a dynamic body: the character's momentum into it
    if push && ch.s.pushStrength > 0. && dt > 0. {
      let b = w.bodies[usize.from(hit.body)];
      if b.motion == MotionDynamic {
        let speedInto = maxf(0., -remaining.dot(nS) / dt);
        w.applyImpulseAt(hit.body, nS * (-ch.s.mass * ch.s.pushStrength * speedInto), hit.pointB);
      }
    }
    // slide along the surface; a steep one is a wall for any move that would climb it
    var slid = remaining - nS * remaining.dot(nS);
    if nS.y < cosSlope && nS.y > 0.0001 && slid.y > 0. {
      let hn = Vec3(nS.x, 0., nS.z);
      let hl = hn.length();
      if hl > 0.0001 {
        let hnn = hn * (1. / hl);
        slid = remaining - hnn * minf(remaining.dot(hnn), 0.);
      }
    }
    remaining = slid;
    // keep the surfaces met before honoured; in a crease slide along it
    var p = 0usize;
    while p < planes.len() {
      let pn = *planes[p];
      if remaining.dot(pn) < -0.0001 {
        let along = nS.cross(pn);
        let al = along.length();
        if al > 0.0001 {
          let ad = along * (1. / al);
          remaining = ad * remaining.dot(ad);
        } else if nS.dot(pn) < -0.99 {
          remaining = zero3();
        } else {
          remaining = remaining - pn * remaining.dot(pn);
        }
      }
      p = p + 1usize;
    }
    planes.push(nS);
    it = it + 1;
  }
  pos
}

// Try to climb a step: up, over, down. On success, where the feet end up and the floor's body.
fn tryStep(w: &mut World, ch: &Character, start: Vec3, dispH: Vec3, dt: f32, out: &mut Vec3, floorBody: &mut u32) bool {
  let cosSlope = cos(ch.s.maxSlope);
  let skin = ch.s.skin;
  let stepH = ch.s.stepHeight;
  // up
  let upHit = sweepCapsule(w, ch, start, upV() * stepH);
  let raise = if upHit.hit { maxf(0., upHit.fraction * stepH - skin) } else { stepH };
  if raise < 0.01 { return false; }
  let raised = start + upV() * raise;
  // over: the move asked for, and a test a radius ahead of it, where the floor is found
  let hl = dispH.length();
  let dirH = dispH * (1. / hl);
  let testLen = maxf(hl, ch.s.radius);
  let over = slideMove(w, ch, raised, dispH, false, dt);
  if (over - raised).length() < hl - 0.002 { return false; }
  let ahead = slideMove(w, ch, raised, dirH * testLen, false, dt);
  if (ahead - raised).length() < testLen - 0.002 { return false; }
  // down onto the floor
  let dropMax = raise + skin * 2.;
  let downHit = sweepCapsule(w, ch, ahead, downV() * dropMax);
  if !downHit.hit { return false; }
  let nS = downHit.normal * -1.;
  if nS.y < cosSlope { return false; }
  let drop = maxf(0., downHit.fraction * dropMax - skin);
  *out = Vec3(over.x, ahead.y - drop, over.z);
  *floorBody = downHit.body;
  true
}

// Move the character for one step of 'dt'. 'wish' is the horizontal velocity it
// wants (its y is ignored), relative to the ground it stands on; 'jump' is an
// upward speed to jump with if it is on the ground (0 for none).
pub fn updateCharacter(w: &mut World, ch: &mut Character, wish: Vec3, jump: f32, dt: f32) {
  let cosSlope = cos(ch.s.maxSlope);
  let up = upV();
  let start = ch.pos;
  let wasGrounded = ch.grounded;
  let wasSteep = ch.onSteep;
  ch.platformYaw = 0.;

  // carried by the ground it stood on
  if ch.grounded && w.isAlive(ch.groundBody) {
    let gv = w.pointVelocity(ch.groundBody, ch.groundPoint);
    ch.groundVelocity = gv;
    ch.platformYaw = w.angularVelocity(ch.groundBody).y * dt;
    ch.pos = slideMove(w, ch, ch.pos, gv * dt, false, dt);
  } else {
    ch.groundVelocity = zero3();
  }
  depenetrate(w, ch);

  // what it wants to do
  let wishH = Vec3(wish.x, 0., wish.z);
  var jumped = false;
  var v = zero3();
  if wasGrounded {
    if jump > 0. {
      v = wishH + up * jump;
      jumped = true;
    } else if ch.groundNormal.y > 0.2 {
      // along the ground it stands on, at the same horizontal speed
      v = wishH + up * (-wishH.dot(ch.groundNormal) / ch.groundNormal.y);
    } else {
      v = wishH;
    }
  } else if wasSteep {
    // sliding down a wall of a slope: keep the speed it has and let gravity add to it
    v = ch.vel + up * (-ch.s.gravity * dt);
  } else {
    v = Vec3(wishH.x, maxf(ch.vel.y - ch.s.gravity * dt, -ch.s.maxFallSpeed), wishH.z);
  }
  let rising = jumped || (!wasGrounded && !wasSteep && v.y > 0.0001);
  let stepStart = ch.pos;
  var end = slideMove(w, ch, stepStart, v * dt, true, dt);
  var vel = (end - stepStart) * (1. / dt);
  var floorBody = NoBody;

  // stairs: on the ground, asked to walk, got less far than asked
  let dispH = wishH * dt;
  var stepped = false;
  if wasGrounded && !jumped && dispH.length() > 0.0001 {
    let gotH = Vec3(end.x - stepStart.x, 0., end.z - stepStart.z).length();
    if gotH < dispH.length() - 0.002 {
      var at = zero3();
      if tryStep(w, ch, stepStart, dispH, dt, &mut at, &mut floorBody) {
        let gotStep = Vec3(at.x - stepStart.x, 0., at.z - stepStart.z).length();
        if gotStep > gotH + 0.002 { end = at; stepped = true; vel = Vec3(wishH.x, 0., wishH.z); }
      }
    }
  }
  ch.pos = end;

  // stick to the floor it was on
  if wasGrounded && !jumped && !stepped {
    var snapped = false;
    let hit = sweepCapsule(w, ch, ch.pos, downV() * ch.s.stickDistance);
    if hit.hit {
      let nS = hit.normal * -1.;
      if nS.y >= cosSlope {
        ch.pos = ch.pos - up * maxf(0., hit.fraction * ch.s.stickDistance - ch.s.skin);
        vel = Vec3(vel.x, 0., vel.z);
        snapped = true;
      }
    }
    // Past the edge of a ledge or a step down the capsule's round foot rests on the edge, whose normal leans too
    // far to stand on. If that edge is behind the foot (its normal leans the way it is walking: it is leaving the
    // edge) a ray straight down from the middle of the foot finds the floor below; follow it down, sliding off.
    // (An edge ahead of the foot, on the climb to a step, must not do this: its normal leans back.)
    let leaving = !hit.hit || (hit.normal * -1.).dot(wishH) > 0.;
    if !snapped && leaving {
      let rayHit = worldRayCast(w, ch.pos + up * 0.05, downV(), ch.s.stickDistance + 0.05, QueryFilter(ch.s.mask, NoBody, false));
      if rayHit.hit && rayHit.normal.y >= cosSlope {
        let drop = rayHit.t - 0.05 - ch.s.skin;
        if drop > 0.001 {
          ch.pos = slideMove(w, ch, ch.pos, downV() * drop, false, dt);
          vel = Vec3(vel.x, 0., vel.z);
          // the slide off the edge may leave it short of the floor: finish the drop
          let again = sweepCapsule(w, ch, ch.pos, downV() * ch.s.stickDistance);
          if again.hit && again.normal.y <= -cosSlope {
            ch.pos = ch.pos - up * maxf(0., again.fraction * ch.s.stickDistance - ch.s.skin);
          }
        }
      }
    }
  }

  // look for ground
  ch.grounded = false;
  ch.onSteep = false;
  ch.groundBody = NoBody;
  ch.groundNormal = up;
  let probe = ch.s.skin * 2. + 0.01;
  let gh = sweepCapsule(w, ch, ch.pos, downV() * probe);
  if stepped {
    // standing at the edge of a step it just climbed (its contact there leans): the floor found ahead stands
    ch.grounded = true;
    ch.groundBody = floorBody;
    ch.groundNormal = up;
    ch.groundPoint = ch.pos;
    ch.groundVelocity = w.pointVelocity(floorBody, ch.pos);
  } else if gh.hit {
    let nS = gh.normal * -1.;
    if nS.y >= cosSlope && !rising {
      ch.grounded = true;
      ch.groundBody = gh.body;
      ch.groundNormal = nS;
      ch.groundPoint = gh.pointB;
      ch.groundVelocity = w.pointVelocity(gh.body, gh.pointB);
    } else if nS.y < cosSlope && nS.y > 0.0001 && !rising {
      ch.onSteep = true;
      ch.steepNormal = nS;
    }
  }
  ch.landSpeed = if ch.grounded && !wasGrounded { maxf(0., -v.y) } else { 0. };
  if ch.grounded {
    vel = zero3();
    // loads a dynamic body it stands on with its weight
    if w.bodies[usize.from(ch.groundBody)].motion == MotionDynamic {
      w.applyForceAt(ch.groundBody, up * (-ch.s.mass * ch.s.gravity), ch.groundPoint);
    }
  }
  ch.vel = vel;
  ch.moved = ch.pos - start;
}
