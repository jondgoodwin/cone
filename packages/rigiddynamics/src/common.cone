// Constants, materials, settings, events and the small maths the solver shares.

// ---------------------------------------------------------------------------
// Motion types (Jolt's EMotionType)

pub const MotionStatic = 0;       // never moves; infinite mass
pub const MotionKinematic = 1;    // moved by the program (a velocity or a target); infinite mass
pub const MotionDynamic = 2;      // moved by forces and contacts

pub const NoBody = 0xffffffffu32;

// ---------------------------------------------------------------------------
// Materials

// What a surface is made of, as physics sees it (named so as not to meet render's Material in a
// program that imports both). Two touching bodies combine their materials:
// friction as the geometric mean sqrt(a * b) (Jolt's and Box2D's default, so
// ice against anything is slippery and rubber on rubber grips), restitution
// as the larger of the two (also theirs), rolling resistance like friction. 'rolling' is a length: a
// rolling body is slowed by a torque of rolling times the normal force (Box2D v3's rolling resistance), so a
// ball on a floor comes to rest instead of rolling for ever. 'friction' is the sliding
// coefficient; 'staticFriction' is the larger coefficient that holds a body
// still until the push overcomes it (Coulomb's two coefficients). The solver
// uses the static one while a contact's tangential speed is below
// Settings.staticSpeed, the sliding one above it.
pub struct PhysMaterial {
  pub friction f32;
  pub staticFriction f32;
  pub restitution f32;
  pub rolling f32;          // rolling resistance: metres, the lever arm of the torque that slows a rolling body

  pub fn make(friction f32, staticFriction f32, restitution f32) PhysMaterial {
    new PhysMaterial(friction, maxf(staticFriction, friction), restitution, 0.01);
  }
  // Friction 0.5 held to 0.6, no bounce: the default of a body
  pub fn standard() PhysMaterial { new PhysMaterial(0.5, 0.6, 0., 0.01); }
  // A slab of ice: a box on it slides down a slope almost as if on nothing
  pub fn ice() PhysMaterial { new PhysMaterial(0.02, 0.03, 0., 0.002); }
  pub fn rubber() PhysMaterial { new PhysMaterial(1.0, 1.2, 0.7, 0.02); }
  pub fn wood() PhysMaterial { new PhysMaterial(0.45, 0.55, 0.1, 0.01); }
  pub fn steel() PhysMaterial { new PhysMaterial(0.3, 0.4, 0.15, 0.005); }
  pub fn bouncy() PhysMaterial { new PhysMaterial(0.5, 0.6, 0.9, 0.01); }
  pub fn withRolling(self &, r f32) PhysMaterial { new PhysMaterial(friction, staticFriction, restitution, r); }
}

// How two materials combine (see Material)
pub fn combineFriction(a f32, b f32) f32 { sqrtf(a * b); }
pub fn combineRestitution(a f32, b f32) f32 { maxf(a, b); }

// ---------------------------------------------------------------------------
// Settings

// Everything the step can be tuned by. The defaults are Box2D v3's (Catto),
// which suit metre-sized things falling under 9.81 m/s^2 at 60 steps a second.
pub struct Settings {
  pub substeps i32;               // sub-steps per step (Soft Step); 4 is Catto's default
  pub relaxIterations i32;        // relax passes per sub-step
  pub contactHertz f32;           // stiffness of a contact's soft constraint, capped at a quarter of the sub-step rate
  pub contactDamping f32;         // its damping ratio (Box2D: 10)
  pub jointHertz f32;             // a joint's stiffness
  pub jointDamping f32;           // and damping ratio
  pub maxPush f32;                // the fastest a contact pushes bodies apart to cure penetration, m/s
  pub linearSlop f32;             // penetration tolerated and left alone, metres
  pub speculativeDistance f32;    // contacts are made this far before surfaces touch
  pub maxSpeculative f32;         // the most a body's speed adds to that, metres
  pub restitutionThreshold f32;   // closing speed under which a collision does not bounce, m/s
  pub staticSpeed f32;            // tangential speed under which a contact grips with its static friction, m/s
  pub sleepEnabled bool;
  pub timeToSleep f32;            // seconds below the threshold before an island sleeps
  pub sleepSpeed f32;             // m/s: a body is still when its speed, or its spin times its radius, is under this
  pub warmStart bool;             // reuse last step's impulses
  pub ccd bool;                   // continuous collision for fast bodies
  pub ccdThreshold f32;           // a body is fast when it moves more than this fraction of its smallest extent in a step
  pub maxLinearSpeed f32;         // m/s
  pub maxAngularSpeed f32;        // rad/s
  pub persistedEvents bool;       // one 'contact persisted' event a step for each pair in contact
  pub matchDistance f32;          // contact points closer than this to last step's are the same point (warm start)
  pub patchRadius f32;            // the smallest contact patch twist friction acts over: what stops a spinning ball, metres
  pub jointIterations i32;       // sweeps of the joints and the contacts of jointed bodies a sub-step (1: as the other contacts)

  pub fn standard() Settings {
    new Settings(4, 1, 30., 10., 60., 2., 3., 0., 0.02, 0.3, 1., 0.02, true, 0.5, 0.05, true, true, 0.5,
      400., 100., false, 0.02, 0.01, 8);
  }
}

// ---------------------------------------------------------------------------
// Events: the step appends records, the program reads them afterwards with
// World.takeEvents (events are data, not callbacks)

pub const EvContactAdded = 1u32;       // a and b began touching; point, normal and depth of the deepest point
pub const EvContactPersisted = 2u32;   // still touching (only if Settings.persistedEvents)
pub const EvContactRemoved = 3u32;     // stopped touching
pub const EvSensorEnter = 4u32;        // a is the sensor, b the body that entered it
pub const EvSensorExit = 5u32;
pub const EvSleep = 6u32;              // a fell asleep
pub const EvWake = 7u32;               // a woke
pub const EvJointBroken = 8u32;        // joint 'id' between bodies a and b gave way; point its anchor on a; depth the force (N) or torque (N m) that broke it

pub struct Event {
  pub kind u32;
  pub a u32;
  pub b u32;
  pub point Vec3;
  pub normal Vec3;     // from a to b
  pub depth f32;
  pub id u32 = 0u32;   // the joint, for EvJointBroken
}

// ---------------------------------------------------------------------------
// Soft constraints (Catto, "Soft Step" in Solver2D, 2024; Box2D v3 b2MakeSoft)

// A constraint as a spring-damper integrated implicitly: the bias velocity for
// an error C is biasRate * C, the effective mass is scaled by massScale and
// the accumulated impulse leaks by impulseScale. Zero hertz is rigid.
pub struct Softness {
  pub biasRate f32;
  pub massScale f32;
  pub impulseScale f32;
}

pub fn makeSoft(hertz f32, zeta f32, h f32) Softness {
  if hertz == 0. { return new Softness(0., 1., 0.); }
  imm omega = 2. * pi * hertz;
  imm a1 = 2. * zeta + h * omega;
  imm a2 = h * omega * a1;
  imm a3 = 1. / (1. + a2);
  new Softness(omega / a1, a2 * a3, a3);
}

// ---------------------------------------------------------------------------
// Maths

pub fn skew(r Vec3) Mat3 {
  mat3FromCols(new Vec3(0., r.z, -r.y), new Vec3(-r.z, 0., r.x), new Vec3(r.y, -r.x, 0.));
}

pub fn zero3() Vec3 inline { new Vec3(0., 0., 0.); }

// R * invLocal * R^T: the inverse inertia tensor in the world
pub fn rotateInertia(rot Quat, invLocal Mat3) Mat3 {
  imm r = Mat3.fromQuat(rot);
  r * invLocal * r.transpose();
}

// The rotation q turned by angular velocity w over time h (the exact turn
// about w, then normalised: semi-implicit Euler's position half)
pub fn integrateRotation(q Quat, w Vec3, h f32) Quat {
  imm l2 = w.dot(w);
  if l2 < 1.0e-14 { return new Quat(q.x + 0.5 * h * (w.x * q.w + w.y * q.z - w.z * q.y),
                                    q.y + 0.5 * h * (w.y * q.w + w.z * q.x - w.x * q.z),
                                    q.z + 0.5 * h * (w.z * q.w + w.x * q.y - w.y * q.x),
                                    q.w + 0.5 * h * (-w.x * q.x - w.y * q.y - w.z * q.z)).normalize(); }
  imm l = l2.sqrt();
  imm dq = Quat.angleAxis(l * h, w * (1. / l));
  (dq * q).normalize();
}

pub fn wrapAngle(a f32) f32 {
  mut x = a;
  while x > pi { x = x - 2. * pi; }
  while x < -pi { x = x + 2. * pi; }
  x;
}

pub fn clampVec(v Vec3, maxLen f32) Vec3 {
  imm l2 = v.dot(v);
  if l2 > maxLen * maxLen { v * (maxLen / l2.sqrt()); } else { v; };
}
