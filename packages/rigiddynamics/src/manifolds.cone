// Tidying the narrow phase's manifolds before they become contacts.
//
// For an ordinary pair of convex shapes the manifolds are used as they come. A
// triangle mesh or a heightfield is another matter: the narrow phase gives one
// manifold for each triangle the convex shape touches, from separate GJK/EPA
// runs, and for a body resting on a flat patch of ground those are three to
// seven manifolds of one to four points each, whose normals and depths differ by
// the noise of each run. The solver treats each manifold as its own unit (its own
// friction, its own order in the sweep), and a box on a flat heightfield jitters.
// So, for a body against a mesh or heightfield:
//
//   1. a contact within 8 degrees of its triangle's own normal is a face contact
//      and takes that normal, each point's depth measured along it;
//   2. points deeper than the dynamic body is wide are dropped (the narrow phase
//      can return an absurd depth when EPA fails on a flat piece);
//   3. the manifolds that now share a normal (within 2 degrees) and the same
//      compound parts are merged into one, its points pruned to the four that
//      span the patch: the deepest, the farthest from it, the one making the
//      largest triangle, and the one making the largest quad on the other side
//      (Jolt's PruneContactPoints), as for a face against a face.

// The four points of 'pts' that best span them (when there are more than four)
fn prunePoints(pts &List[ContactPoint], n Vec3) List[ContactPoint] {
  mut out = List[ContactPoint].empty();
  if pts.len() <= 4usize {
    mut i = 0usize;
    while i < pts.len() { out.push(*pts[i]); i = i + 1usize; }
    return out;
  }
  // the deepest
  mut i1 = 0usize;
  mut i = 1usize;
  while i < pts.len() { if pts[i].depth > pts[i1].depth { i1 = i; } i = i + 1usize; }
  imm p1 = pts[i1].onA;
  // the farthest from it
  mut i2 = if i1 == 0usize { 1usize; } else { 0usize; };
  mut best = -1.;
  i = 0usize;
  while i < pts.len() {
    imm d = (pts[i].onA - p1).dot(pts[i].onA - p1);
    if i != i1 and d > best { best = d; i2 = i; }
    i = i + 1usize;
  }
  imm p2 = pts[i2].onA;
  // the largest triangle with them
  mut i3 = i2;
  best = -1.;
  i = 0usize;
  while i < pts.len() {
    imm a = absf((p2 - p1).cross(pts[i].onA - p1).dot(n));
    if i != i1 and i != i2 and a > best { best = a; i3 = i; }
    i = i + 1usize;
  }
  // the largest quad: the point farthest to the other side of that triangle
  imm side = (p2 - p1).cross(pts[i3].onA - p1).dot(n);
  mut i4 = i3;
  best = 0.;
  i = 0usize;
  while i < pts.len() {
    imm s = (p2 - p1).cross(pts[i].onA - p1).dot(n);
    imm score = if side >= 0. { -s; } else { s; };
    if i != i1 and i != i2 and i != i3 and score > best { best = score; i4 = i; }
    i = i + 1usize;
  }
  out.push(*pts[i1]);
  out.push(*pts[i2]);
  if i3 != i2 { out.push(*pts[i3]); }
  if i4 != i3 { out.push(*pts[i4]); }
  out;
}

struct PatchGroup {
  normal Vec3;
  partA u32;
  partB u32;
  pts List[ContactPoint];
  members i32;
  first usize;
}

// The manifolds of a pair, tidied (see the top of this file). 'meshA' and 'meshB' say which body is a mesh or a heightfield.
pub fn tidyManifolds(raw &List[Manifold], shA &Shape, xfA Rigid, meshA bool, shB &Shape, xfB Rigid, meshB bool, maxDepth f32,
    sensor bool) List[Manifold] {
  mut prepared = List[Manifold].empty();
  mut m = 0usize;
  while m < raw.len() {
    mut mf = *raw[m];
    if not sensor {
      if (meshA or meshB) and mf.count > 0usize {
        imm sub = if meshA { mf.subA; } else { mf.subB; };
        if sub != NoSub {
          imm msh = if meshA { shA; } else { shB; };
          imm mxf = if meshA { xfA; } else { xfB; };
          imm tri = concaveTriangle(&msh.prim, sub);
          imm fnorm = mxf.rotate((tri.b - tri.a).cross(tri.c - tri.a).normalize());
          imm aligned = if fnorm.dot(mf.normal) >= 0. { fnorm; } else { fnorm * -1.; };
          if aligned.dot(mf.normal) >= 0.99 {
            mf.normal = aligned;
            mut kd = 0usize;
            while kd < mf.count {
              mf.points[kd].depth = (mf.points[kd].onA - mf.points[kd].onB).dot(aligned);
              kd = kd + 1usize;
            }
          }
        }
      }
      mut kept = 0usize;
      mut kk = 0usize;
      while kk < mf.count {
        if mf.points[kk].depth <= maxDepth {
          mf.points[kept] = mf.points[kk];
          kept = kept + 1usize;
        }
        kk = kk + 1usize;
      }
      mf.count = kept;
    }
    if mf.count > 0usize { prepared.push(mf); }
    m = m + 1usize;
  }
  if sensor or not (meshA or meshB) or prepared.len() < 2usize { return prepared; }

  // merge the manifolds of one flat patch
  mut groups = List[PatchGroup].empty();
  m = 0usize;
  while m < prepared.len() {
    imm mf = prepared[m];
    mut found = groups.len();
    mut g = 0usize;
    while g < groups.len() {
      if groups[g].partA == mf.partA and groups[g].partB == mf.partB and groups[g].normal.dot(mf.normal) > 0.9994 { found = g; break; }
      g = g + 1usize;
    }
    if found == groups.len() {
      groups.push(new PatchGroup(mf.normal, mf.partA, mf.partB, List[ContactPoint].empty(), 0, m));
    }
    imm gr = &mut groups[found];
    mut k = 0usize;
    while k < mf.count {
      // the same point seen from two triangles is kept once
      mut dup = false;
      mut q = 0usize;
      while q < gr.pts.len() {
        if gr.pts[q].onA.distance(mf.points[k].onA) < 0.002 { dup = true; }
        q = q + 1usize;
      }
      if not dup { gr.pts.push(mf.points[k]); }
      k = k + 1usize;
    }
    gr.members = gr.members + 1;
    m = m + 1usize;
  }
  mut out = List[Manifold].empty();
  mut g = 0usize;
  while g < groups.len() {
    if groups[g].members == 1 {
      out.push(*prepared[groups[g].first]);
    } else {
      imm pruned = prunePoints(&groups[g].pts, groups[g].normal);
      mut mf = emptyManifold();
      mf.normal = groups[g].normal;
      mf.partA = groups[g].partA;
      mf.partB = groups[g].partB;
      mf.count = pruned.len();
      mut k = 0usize;
      while k < pruned.len() { mf.points[k] = *pruned[k]; k = k + 1usize; }
      if mf.count > 0usize { out.push(mf); }
    }
    g = g + 1usize;
  }
  out;
}
