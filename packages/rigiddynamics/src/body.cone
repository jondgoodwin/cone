// Bodies: a shape, a pose, a velocity, a mass and a material.
//
// Poses follow Jolt: the body's 'pos' is its CENTRE OF MASS in the world and
// 'rot' its orientation; 'comLocal' is where the centre of mass sits in the
// shape's own frame (non-zero for a compound or an off-centre hull), so the
// shape's origin is at pos - rot * comLocal (World.transformOf). The solver
// moves the centre of mass; the shape is placed from it.

// What a body is made of when it is created. Build one with dynamicAt,
// staticAt or kinematicAt and change the fields wanted.
pub struct BodyDef {
  pub motion: i32;
  pub shape: u32;                // from World.addShape
  pub pos: Vec3;                 // where the shape's origin is
  pub rot: Quat;
  pub linVel: Vec3;
  pub angVel: Vec3;
  pub density: f32;              // kg per cubic metre (mass = density * volume), unless 'mass' is set
  pub mass: f32;                 // kg; 0 to use the density
  pub material: PhysMaterial;
  pub layer: u32;                // the layers it is on (bits)
  pub mask: u32;                 // the layers it collides with (bits)
  pub linearDamping: f32;
  pub angularDamping: f32;
  pub gravityFactor: f32;
  pub sensor: bool;              // detects overlap (events) but does not collide
  pub allowSleep: bool;
  pub bullet: bool;              // continuous collision against dynamic bodies too, not only static ones
  pub userData: u32;             // the program's id for it (a part id)

  pub fn make(motion: i32, shape: u32, pos: Vec3) BodyDef {
    BodyDef(motion, shape, pos, Quat.identity(), zero3(), zero3(), 1000., 0., PhysMaterial.standard(), 1u32, 0xffffffffu32,
      0.05, 0.05, 1., false, true, false, 0u32)
  }
  pub fn dynamicAt(shape: u32, pos: Vec3) BodyDef { BodyDef.make(MotionDynamic, shape, pos) }
  pub fn staticAt(shape: u32, pos: Vec3) BodyDef { BodyDef.make(MotionStatic, shape, pos) }
  pub fn kinematicAt(shape: u32, pos: Vec3) BodyDef { BodyDef.make(MotionKinematic, shape, pos) }
}

// One body, in the world's table. A plain value (no lists), so the solver
// reads and writes its fields in place.
pub struct Body {
  pub alive: bool;
  pub motion: i32;
  pub shape: u32;
  pub layer: u32;
  pub mask: u32;
  pub sensor: bool;
  pub allowSleep: bool;
  pub bullet: bool;
  pub userData: u32;
  // pose and velocity
  pub pos: Vec3;                // centre of mass, world
  pub rot: Quat;
  pub comLocal: Vec3;           // centre of mass in the shape's frame
  pub linVel: Vec3;
  pub angVel: Vec3;
  // mass
  pub mass: f32;
  pub invMass: f32;             // 0 for static and kinematic
  pub inertiaLocal: Mat3;       // about the centre of mass, in the shape's frame
  pub invInertiaLocal: Mat3;    // and its inverse
  pub invInertia: Mat3;         // in the world, refreshed each sub-step
  pub gyro: bool;               // the inertia is not a sphere's, so spin needs the gyroscopic term
  pub linearDamping: f32;
  pub angularDamping: f32;
  pub gravityFactor: f32;
  pub material: PhysMaterial;
  pub force: Vec3;              // applied since the last step, cleared by it
  pub torque: Vec3;
  pub radius: f32;              // from the centre of mass to the farthest point of the shape
  pub minExtent: f32;           // half the smallest side of the shape's box
  // sleeping
  pub asleep: bool;
  pub sleepTime: f32;
  pub sleepGroup: u32;
  // the step's own state
  pub dpos: Vec3;               // centre of mass moved since the step began
  pub dq: Quat;                 // turned since the step began
  pub startPos: Vec3;           // the shape origin and orientation when the step began (for continuous collision)
  pub startRot: Quat;
  pub island: u32;
  pub color: u64;               // the constraint colours used on this body in this step
}

// Is the body one the solver moves this step?
pub fn isAwakeDynamic(b: &Body) bool { b.alive && b.motion == MotionDynamic && !b.asleep }
pub fn isMovingKinematic(b: &Body) bool {
  b.alive && b.motion == MotionKinematic && (b.linVel.dot(b.linVel) > 0.0000000001 || b.angVel.dot(b.angVel) > 0.0000000001)
}

// A flat tagged inertia is a sphere's if its three diagonal entries match and nothing is off the diagonal
pub fn isIsotropic(i: Mat3) bool {
  let a = i.cell(0usize, 0usize);
  let b = i.cell(1usize, 1usize);
  let c = i.cell(2usize, 2usize);
  let m = maxf(a, maxf(b, c));
  let off = absf(i.cell(0usize, 1usize)) + absf(i.cell(0usize, 2usize)) + absf(i.cell(1usize, 2usize));
  absf(a - b) <= 0.001 * m && absf(a - c) <= 0.001 * m && off <= 0.001 * m
}
