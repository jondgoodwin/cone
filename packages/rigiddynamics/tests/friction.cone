// Friction: Coulomb's law on slopes and flat ground, from materials, against
// closed forms.
//
// A box on a plane tilted by theta stays if mu >= tan(theta) (tan 30 = 0.577)
// and otherwise slides with a = g (sin(theta) - mu cos(theta)), which for ice
// (mu near 0) is g sin(theta) = 4.905 m/s^2 at 30 degrees. A box sliding on
// flat ground with friction mu slows at mu g: from 5 m/s on ice (0.02) to
// 4.608 in two seconds, and on rubber (mu 1.0) in v^2 / (2 mu g) = 1.274 m.
// The two bodies' coefficients combine as the geometric mean.

mod friction;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

// A box placed on a 30 degree slope descending towards +x; the slope is of
// material 'slope', the box 'boxMat', the box given speed 'v0' down the slope.
// Returns the box's acceleration over the second after the first second, and its
// displacement along the slope over the whole 2 s
struct Slide {
  accel f32;
  moved f32;
  speed f32;
}

fn slide(slope PhysMaterial, boxMat PhysMaterial, v0 f32) Slide {
  var w = World.make();
  w.settings.sleepEnabled = false;
  let ang = pi / 6.;
  let slopeS = w.addShape(Shape.single(Prim.box(new Vec3(30., 0.5, 10.))));
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  let q = Quat.angleAxis(-ang, new Vec3(0., 0., 1.));
  var sd = BodyDef.staticAt(slopeS, new Vec3(0., 0., 0.));
  sd.rot = q;
  sd.material = slope;
  w.createBody(sd);
  let n = q * new Vec3(0., 1., 0.);
  let t = q * new Vec3(1., 0., 0.);
  var bd = BodyDef.dynamicAt(boxS, n * 1.0);
  bd.rot = q;
  bd.material = boxMat;
  bd.linVel = t * v0;
  bd.linearDamping = 0.; bd.angularDamping = 0.;
  let b = w.createBody(bd);
  let start = w.positionOf(b);
  var v1 = 0.f;
  var i = 0;
  while i < 120 {
    w.step(1. / 60.);
    if i == 59 { v1 = w.linearVelocity(b).dot(t); }
    i = i + 1;
  }
  let v2 = w.linearVelocity(b).dot(t);
  new Slide(v2 - v1, (w.positionOf(b) - start).dot(t), v2)
}

fn flat(floorMat PhysMaterial, boxMat PhysMaterial, v0 f32, secs i32) Slide {
  var w = World.make();
  w.settings.sleepEnabled = false;
  let floorS = w.addShape(Shape.single(Prim.box(new Vec3(100., 1., 20.))));
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  var fd = BodyDef.staticAt(floorS, new Vec3(0., -1., 0.));
  fd.material = floorMat;
  w.createBody(fd);
  var bd = BodyDef.dynamicAt(boxS, new Vec3(0., 0.5, 0.));
  bd.material = boxMat;
  bd.linVel = new Vec3(v0, 0., 0.);
  bd.linearDamping = 0.; bd.angularDamping = 0.;
  let b = w.createBody(bd);
  var i = 0;
  while i < secs * 60 { w.step(1. / 60.); i = i + 1; }
  new Slide(0., w.positionOf(b).x, w.linearVelocity(b).x)
}

fn main() i32 {
  let g = 9.81f;
  let s30 = 0.5f;
  let c30 = 0.8660254f;

  let holds = slide(PhysMaterial.make(0.6, 0.6, 0.), PhysMaterial.make(0.6, 0.6, 0.), 0.);
  expectBool(absf(holds.moved) < 0.001, true, "friction 0.6 holds a box on a 30 degree slope (tan 30 = 0.577)");

  let slides = slide(PhysMaterial.make(0.1, 0.1, 0.), PhysMaterial.make(0.1, 0.1, 0.), 0.);
  near(slides.accel, g * (s30 - 0.1 * c30), 0.04, "friction 0.1 slides at g (sin - mu cos)");

  let ice = slide(PhysMaterial.make(0.02, 0.02, 0.), PhysMaterial.make(0.02, 0.02, 0.), 0.);
  near(ice.accel, g * (s30 - 0.02 * c30), 0.03, "ice (0.02) slides at nearly g sin 30");

  let presetIce = slide(PhysMaterial.ice(), PhysMaterial.ice(), 0.);
  near(presetIce.accel, g * (s30 - 0.02 * c30), 0.03, "the ice preset does the same");

  let none = slide(PhysMaterial.make(0., 0., 0.), PhysMaterial.make(0., 0., 0.), 0.);
  near(none.accel, g * s30, 0.01, "no friction at all slides at g sin 30 = 4.905");
  near(none.moved, 0.5 * g * s30 * 4., 0.1, "and covers 1/2 a t^2 in two seconds");

  // static against dynamic: a static coefficient of 0.7 holds the box at rest; a sliding coefficient of 0.3 keeps it sliding
  let gripped = slide(PhysMaterial.make(0.3, 0.7, 0.), PhysMaterial.make(0.3, 0.7, 0.), 0.);
  expectBool(absf(gripped.moved) < 0.001, true, "static 0.7 holds it though sliding friction is 0.3");
  let kept = slide(PhysMaterial.make(0.3, 0.7, 0.), PhysMaterial.make(0.3, 0.7, 0.), 1.);
  expectBool(kept.moved > 3., true, "but once it slides the box keeps sliding");
  near(kept.accel, g * (s30 - 0.3 * c30), 0.05, "at the sliding coefficient's acceleration");

  // flat ground
  let onIce = flat(PhysMaterial.ice(), PhysMaterial.ice(), 5., 2);
  near(onIce.speed, 5. - 0.02 * g * 2., 0.02, "a box on ice slows by mu g");
  let onRubber = flat(PhysMaterial.make(1., 1., 0.), PhysMaterial.make(1., 1., 0.), 5., 3);
  near(onRubber.speed, 0., 0.01, "on rubber it stops");
  near(onRubber.moved, 25. / (2. * g), 0.05, "after v^2 / (2 mu g)");
  // the combination: ice box on a wood floor slides with sqrt(0.02 * 0.45)
  let mixed = flat(PhysMaterial.make(0.45, 0.45, 0.), PhysMaterial.make(0.02, 0.02, 0.), 5., 2);
  near(mixed.speed, 5. - 0.0948683 * g * 2., 0.03, "an ice box on wood slows by the geometric mean coefficient");
  done()
}
