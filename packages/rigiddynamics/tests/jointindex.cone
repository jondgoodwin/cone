// The per-body joint index: destroyBody visits only the destroyed body's own joints.
//
// Bodies a, b, c; joints ab and bc. Each body's list holds the joints that name it:
// a [ab], b [ab, bc], c [bc] (b's in creation order).
//
//   destroy b   both joints die; a and c hold no joints; b's list is empty
//   reuse       a new body takes b's slot; it holds no joints; a new joint to it is listed on both bodies
//   remove      removeJoint kills the joint and drops it from both lists; removing it again does nothing
//   self        destroying a body with a joint to a second body leaves the second body's other joints alone

mod jointindex;

import testing use *;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;

fn main() i32 {
  var w = World.make();
  let s = w.addShape(Shape.single(Prim.box(Vec3(0.25, 0.25, 0.25))));
  let a = w.createBody(BodyDef.dynamicAt(s, Vec3(0., 5., 0.)));
  let b = w.createBody(BodyDef.dynamicAt(s, Vec3(2., 5., 0.)));
  let c = w.createBody(BodyDef.dynamicAt(s, Vec3(4., 5., 0.)));
  let ab = w.addPointJoint(a, b, Vec3(1., 5., 0.));
  let bc = w.addPointJoint(b, c, Vec3(3., 5., 0.));
  expectUInt(u64.from(w.jointsOf[usize.from(a.index)].len()), 1u64, "a holds one joint");
  expectUInt(u64.from(w.jointsOf[usize.from(b.index)].len()), 2u64, "b holds two");
  expectUInt(u64.from(w.jointsOf[usize.from(c.index)].len()), 1u64, "c holds one");
  expectUInt(u64.from(*w.jointsOf[usize.from(b.index)][0usize]), u64.from(ab.index), "b's first is ab");
  expectUInt(u64.from(*w.jointsOf[usize.from(b.index)][1usize]), u64.from(bc.index), "b's second is bc");

  w.destroyBody(b);
  expect(!w.jointLive(ab), "ab died with b");
  expect(!w.jointLive(bc), "bc died with b");
  expectUInt(u64.from(w.jointsOf[usize.from(a.index)].len()), 0u64, "a holds none");
  expectUInt(u64.from(w.jointsOf[usize.from(c.index)].len()), 0u64, "c holds none");
  expectUInt(u64.from(w.jointsOf[usize.from(b.index)].len()), 0u64, "b's list is empty");

  let b2 = w.createBody(BodyDef.dynamicAt(s, Vec3(2., 5., 0.)));
  expectUInt(u64.from(b2.index), u64.from(b.index), "the slot is reused");
  expectUInt(u64.from(w.jointsOf[usize.from(b2.index)].len()), 0u64, "the new body holds no joints");
  let j = w.addPointJoint(a, b2, Vec3(1., 5., 0.));
  expectUInt(u64.from(w.jointsOf[usize.from(a.index)].len()), 1u64, "a lists the new joint");
  expectUInt(u64.from(w.jointsOf[usize.from(b2.index)].len()), 1u64, "b2 lists it");
  w.removeJoint(j);
  expect(!w.jointLive(j), "removed");
  expectUInt(u64.from(w.jointsOf[usize.from(a.index)].len()), 0u64, "a no longer lists it");
  expectUInt(u64.from(w.jointsOf[usize.from(b2.index)].len()), 0u64, "nor b2");
  w.removeJoint(j);
  expectUInt(u64.from(w.jointsOf[usize.from(a.index)].len()), 0u64, "removing again changes nothing");

  // destroying one end leaves the other end's remaining joints alone
  let j1 = w.addPointJoint(a, b2, Vec3(1., 5., 0.));
  let j2 = w.addPointJoint(a, c, Vec3(2., 5., 0.));
  w.destroyBody(b2);
  expect(!w.jointLive(j1), "j1 died");
  expect(w.jointLive(j2), "j2 lives");
  expectUInt(u64.from(w.jointsOf[usize.from(a.index)].len()), 1u64, "a keeps j2 only");
  expectUInt(u64.from(*w.jointsOf[usize.from(a.index)][0usize]), u64.from(j2.index), "and it is j2");
  done()
}
