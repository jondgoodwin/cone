// Sleeping: islands (bodies joined by contacts with each other or by joints) fall
// asleep together once every body in them has been slow for half a second, and
// wake together when something touches them, pushes them or joins them.
//
// Two towers of three boxes stand far apart: each is its own island. They both
// sleep. An impulse on the top box of one wakes all three of its boxes and leaves
// the other tower asleep. A ball dropped on the sleeping tower wakes it. A moving
// kinematic body touching a sleeping box wakes it, and a box on a moving
// platform never sleeps. A body that must stay awake (allowSleep off) keeps its
// island awake.

mod sleeping;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn run(w &mut World, steps i32) {
  var i = 0;
  while i < steps { w.step(1. / 60.); i = i + 1; }
}

struct Towers {
  w World;
  a List[u32];
  b List[u32];
}

fn towers() Towers {
  var w = World.make();
  let floorS = w.addShape(Shape.single(Prim.box(new Vec3(40., 1., 20.))));
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  w.createBody(BodyDef.staticAt(floorS, new Vec3(0., -1., 0.)));
  var a = List[u32].empty();
  var b = List[u32].empty();
  var k = 0;
  while k < 3 {
    a.push(w.createBody(BodyDef.dynamicAt(boxS, new Vec3(-10., 0.5 + f32.from(k), 0.))));
    b.push(w.createBody(BodyDef.dynamicAt(boxS, new Vec3(10., 0.5 + f32.from(k), 0.))));
    k = k + 1;
  }
  new Towers(w, a, b)
}

fn countAsleep(w &World, ids &List[u32]) i32 {
  var n = 0;
  var i = 0usize;
  while i < ids.len() { if w.isAsleep(*ids[i]) { n = n + 1; } i = i + 1usize; }
  n
}

fn testIslands() {
  var t = towers();
  run(&mut t.w, 180);
  expectInt(i64.from(countAsleep(&t.w, &t.a)), 3i64, "the first tower, an island of three, is asleep");
  expectInt(i64.from(countAsleep(&t.w, &t.b)), 3i64, "so is the second");

  // an impulse on the top of one wakes that island and only that one
  t.w.applyImpulse(*t.a[2usize], new Vec3(10., 0., 0.));
  expectInt(i64.from(countAsleep(&t.w, &t.a)), 0i64, "an impulse wakes the whole of its tower");
  expectInt(i64.from(countAsleep(&t.w, &t.b)), 3i64, "and not the other");
  run(&mut t.w, 1);
  expectInt(i64.from(countAsleep(&t.w, &t.b)), 3i64, "which stays asleep through the step");

  // the woken tower, left alone, sleeps again
  run(&mut t.w, 600);
  expectInt(i64.from(countAsleep(&t.w, &t.a)), 3i64, "and the pushed one goes back to sleep when it settles");

  // a falling ball wakes the second tower on contact
  let ballS = t.w.addShape(Shape.single(Prim.sphere(0.4)));
  var bd = BodyDef.dynamicAt(ballS, new Vec3(10.3, 6., 0.));
  let ball = t.w.createBody(bd);
  var woke = -1;
  var i = 0;
  while i < 120 {
    t.w.step(1. / 60.);
    if woke < 0 and countAsleep(&t.w, &t.b) == 0 { woke = i; }
    i = i + 1;
  }
  expectBool(woke >= 0, true, "a ball landing on a sleeping tower wakes it");
  expectBool(woke > 10, true, "when it arrives, not before");
}

fn testNoSleep() {
  var w = World.make();
  let floorS = w.addShape(Shape.single(Prim.box(new Vec3(40., 1., 20.))));
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  w.createBody(BodyDef.staticAt(floorS, new Vec3(0., -1., 0.)));
  var d1 = BodyDef.dynamicAt(boxS, new Vec3(0., 0.5, 0.));
  d1.allowSleep = false;
  let a = w.createBody(d1);
  let b = w.createBody(BodyDef.dynamicAt(boxS, new Vec3(0., 1.5, 0.)));
  run(&mut w, 300);
  expectBool(w.isAsleep(a), false, "a body that must not sleep stays awake");
  expectBool(w.isAsleep(b), false, "and keeps the body resting on it awake");
}

fn testKinematic() {
  var w = World.make();
  let floorS = w.addShape(Shape.single(Prim.box(new Vec3(40., 1., 20.))));
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  let platS = w.addShape(Shape.single(Prim.box(new Vec3(3., 0.2, 3.))));
  w.createBody(BodyDef.staticAt(floorS, new Vec3(0., -1., 0.)));
  // a box asleep on the ground; a kinematic wall slides into it
  let b = w.createBody(BodyDef.dynamicAt(boxS, new Vec3(5., 0.5, 0.)));
  run(&mut w, 120);
  expectBool(w.isAsleep(b), true, "the box has gone to sleep");
  var wall = BodyDef.kinematicAt(w.addShape(Shape.single(Prim.box(new Vec3(0.2, 1., 3.)))), new Vec3(2., 1., 0.));
  let k = w.createBody(wall);
  w.setLinearVelocity(k, new Vec3(1., 0., 0.));
  run(&mut w, 150);
  expectBool(w.isAsleep(b), false, "a moving kinematic body that reaches it wakes it");
  expectBool(w.positionOf(b).x > 5.05, true, "and pushes it along");

  // a box riding a moving platform does not fall asleep, though it is still on the platform
  var z = World.make();
  let zb = z.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  let zp = z.addShape(Shape.single(Prim.box(new Vec3(30., 0.2, 3.))));
  let plat = z.createBody(BodyDef.kinematicAt(zp, new Vec3(0., 0., 0.)));
  z.setLinearVelocity(plat, new Vec3(1., 0., 0.));
  var rd = BodyDef.dynamicAt(zb, new Vec3(0., 0.7, 0.));
  rd.material = PhysMaterial.make(2., 2., 0.);
  let rider = z.createBody(rd);
  run(&mut z, 300);
  expectBool(z.isAsleep(rider), false, "a box on a moving platform stays awake");
  near(z.positionOf(rider).x, 5., 0.2, "and rides along with it (friction carries it)");
}

fn testJointIsland() {
  // two boxes joined by a rope on the ground sleep and wake together
  var w = World.make();
  let floorS = w.addShape(Shape.single(Prim.box(new Vec3(40., 1., 20.))));
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  w.createBody(BodyDef.staticAt(floorS, new Vec3(0., -1., 0.)));
  let a = w.createBody(BodyDef.dynamicAt(boxS, new Vec3(0., 0.5, 0.)));
  let b = w.createBody(BodyDef.dynamicAt(boxS, new Vec3(3., 0.5, 0.)));
  let j = w.addDistance(a, b, new Vec3(0., 0.5, 0.), new Vec3(3., 0.5, 0.));
  w.setDistanceRange(j, 0., 3.5);
  run(&mut w, 180);
  expectBool(w.isAsleep(a) and w.isAsleep(b), true, "boxes joined by a rope sleep");
  w.applyImpulse(a, new Vec3(0., 100., 0.));
  expectBool(w.isAsleep(b), false, "waking one wakes the one it is joined to");
}

fn testEvents() {
  var t = towers();
  run(&mut t.w, 180);
  let events = t.w.takeEvents();
  var sleeps = 0;
  var i = 0usize;
  while i < events.len() { if events[i].kind == EvSleep { sleeps = sleeps + 1; } i = i + 1usize; }
  expectInt(i64.from(sleeps), 6i64, "six sleep events for the six boxes");
  t.w.applyImpulse(*t.a[0usize], new Vec3(0., 1., 0.));
  let woken = t.w.takeEvents();
  var wakes = 0;
  i = 0usize;
  while i < woken.len() { if woken[i].kind == EvWake { wakes = wakes + 1; } i = i + 1usize; }
  expectInt(i64.from(wakes), 3i64, "three wake events for the island that woke");
  expectInt(i64.from(t.w.takeEvents().len()), 0i64, "events are taken once");
}

fn main() i32 {
  testIslands();
  testNoSleep();
  testKinematic();
  testJointIsland();
  testEvents();
  done()
}
