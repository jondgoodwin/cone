// Things at rest: a box dropped on the ground settles and its contact depth
// stays steady for 1,000 steps with no jitter; every shape kind comes to rest
// at the height its geometry says; and the box, dropped with sleeping on, falls
// asleep at once it is still.
//
// A box of half-extent 0.5 on a floor with its top at y = 0 rests with its
// centre at 0.5, less the penetration the soft contact leaves (under 1 mm for
// a single box); a sphere of radius r at r; a capsule (radius r, half height h)
// upright at h + r; a cylinder of half height h at h; a hull of known base at
// its base's height over its centre of mass.

mod resting;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn testBoxSteady() {
  var w = World.make();
  w.settings.sleepEnabled = false;
  let floorS = w.addShape(Shape.single(Prim.box(Vec3(20., 1., 20.))));
  let boxS = w.addShape(Shape.single(Prim.box(Vec3(0.5, 0.5, 0.5))));
  w.createBody(BodyDef.staticAt(floorS, Vec3(0., -1., 0.)));
  let b = w.createBody(BodyDef.dynamicAt(boxS, Vec3(0., 1.5, 0.)));
  var lo = 100.f;
  var hi = -100.f;
  var maxSpeed = 0.f;
  var maxDrift = 0.f;
  var at200 = Vec3(0., 0., 0.);
  var i = 0;
  while i < 1000 {
    w.step(1. / 60.);
    if i == 200 { at200 = w.positionOf(b); }
    if i >= 200 {
      let p = w.positionOf(b);
      lo = minf(lo, p.y);
      hi = maxf(hi, p.y);
      maxSpeed = maxf(maxSpeed, w.linearVelocity(b).length() + w.angularVelocity(b).length());
      maxDrift = maxf(maxDrift, (p.x - at200.x).abs() + (p.z - at200.z).abs());
    }
    i = i + 1;
  }
  near(w.positionOf(b).y, 0.5, 0.001, "the box rests on the ground");
  expectBool(hi - lo < 0.00001, true, "its height does not change over 800 steps (depth is steady)");
  expectBool(maxSpeed < 0.0001, true, "it does not jitter: speed stays under 0.1 mm/s");
  expectBool(maxDrift < 0.0001, true, "it does not creep sideways: under 0.1 mm in 16 s");
  expectBool(0.5 - lo > -0.00001 && 0.5 - lo < 0.001, true, "the contact depth is positive and under a millimetre");
  expectBool(w.isAsleep(b), false, "sleeping was off");
}

fn testShapes() {
  var w = World.make();
  w.settings.sleepEnabled = false;
  let floorS = w.addShape(Shape.single(Prim.box(Vec3(20., 1., 20.))));
  w.createBody(BodyDef.staticAt(floorS, Vec3(0., -1., 0.)));
  let ball = w.createBody(BodyDef.dynamicAt(w.addShape(Shape.single(Prim.sphere(0.4))), Vec3(-6., 1., 0.)));
  // a capsule lying on its side (upright on its round end it would topple, as a real one does)
  var cd = BodyDef.dynamicAt(w.addShape(Shape.single(Prim.capsule(0.3, 0.5))), Vec3(-3., 1.5, 0.));
  cd.rot = Quat.angleAxis(pi / 2., Vec3(0., 0., 1.));
  let cap = w.createBody(cd);
  let cyl = w.createBody(BodyDef.dynamicAt(w.addShape(Shape.single(Prim.cylinder(0.4, 0.3))), Vec3(0., 1., 0.)));
  // a hull: a square pyramid on its base, base at y = -0.2 from the shape origin, apex at 0.4
  var pts = List[Vec3].empty();
  pts.push(Vec3(-0.4, -0.2, -0.4)); pts.push(Vec3(0.4, -0.2, -0.4)); pts.push(Vec3(0.4, -0.2, 0.4));
  pts.push(Vec3(-0.4, -0.2, 0.4)); pts.push(Vec3(0., 0.4, 0.));
  let hullShape = w.addShape(Shape.single(convexHull(pts.view())));
  var hd = BodyDef.dynamicAt(hullShape, Vec3(3., 1., 0.));
  hd.rot = Quat.angleAxis(0.2, Vec3(0., 1., 0.));
  let hull = w.createBody(hd);
  // a compound: a box with a ball fused on its top; lands on the box
  var comp = Shape.compound();
  comp.add(Prim.box(Vec3(0.4, 0.2, 0.4)), Rigid.identity());
  comp.add(Prim.sphere(0.2), Rigid.at(Vec3(0., 0.4, 0.)));
  let compound = w.createBody(BodyDef.dynamicAt(w.addShape(comp), Vec3(6., 1., 0.)));
  var i = 0;
  while i < 600 { w.step(1. / 60.); i = i + 1; }
  near(w.positionOf(ball).y, 0.4, 0.002, "a sphere rests at its radius");
  near(w.positionOf(cap).y, 0.3, 0.002, "a capsule on its side rests at its radius");
  near(w.positionOf(cyl).y, 0.3, 0.002, "a cylinder rests on its end");
  near(w.positionOf(hull).y, 0.2, 0.002, "a pyramid rests on its base");
  near(w.positionOf(compound).y, 0.2, 0.002, "a compound rests on its box");
  var calm = true;
  let ids = [ball, cap, cyl, hull, compound];
  var k = 0usize;
  while k < 5usize {
    if w.linearVelocity(ids[k]).length() > 0.001 { calm = false; }
    k = k + 1usize;
  }
  expectBool(calm, true, "all of them are at rest");
}

fn testSleep() {
  var w = World.make();
  let floorS = w.addShape(Shape.single(Prim.box(Vec3(20., 1., 20.))));
  let boxS = w.addShape(Shape.single(Prim.box(Vec3(0.5, 0.5, 0.5))));
  w.createBody(BodyDef.staticAt(floorS, Vec3(0., -1., 0.)));
  let b = w.createBody(BodyDef.dynamicAt(boxS, Vec3(0., 1.5, 0.)));
  var i = 0;
  var sleptAt = -1;
  while i < 300 {
    w.step(1. / 60.);
    if w.isAsleep(b) && sleptAt < 0 { sleptAt = i; }
    i = i + 1;
  }
  expectBool(w.isAsleep(b), true, "a box at rest falls asleep");
  expectBool(sleptAt > 40 && sleptAt < 150, true, "after landing and half a second of stillness");
  let y = w.positionOf(b).y;
  w.step(1. / 60.);
  near(w.positionOf(b).y, y, 0.0000001, "a sleeping body does not move");
  near(w.linearVelocity(b).length(), 0., 0.0000001, "and has no velocity");
}

fn main() i32 {
  testBoxSteady();
  testShapes();
  testSleep();
  done()
}
