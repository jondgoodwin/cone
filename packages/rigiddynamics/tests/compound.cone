// Compound bodies rest as still as a single box does.
//
// A compound (a forearm capsule with a hand box, a capsule with a ball, two boxes, a nesting compound) is dropped at
// eight turns on a floor, and after five seconds of rest its speed (linear plus angular) stays under 0.1 mm/s, the
// bound the single box's resting test holds. Before the face-contact fix in rigidcollide the same bodies kept
// moving at 2-900 mm/s: the depth of a clipped contact was measured from the floor face's plane through a corner
// 20 m away along a normal that EPA gives only to about 1e-5 radians, so every pose had its own half-millimetre
// error, and a capsule or compound on a big floor bobbed by it. The last test lays a capsule on a 400 m floor and
// checks that it does not bob by more than 10 micrometres, and that a single box and a compound box rest at the same
// height to the same precision.

mod compound;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;
import noise;

struct Rng { state u32; }
fn nextf(r &mut Rng) f32 {
  r.state = noise.pcg(r.state + 1u32);
  noise.toUnit(r.state);
}
fn rand(r &mut Rng, lo f32, hi f32) f32 { lo + (hi - lo) * nextf(r); }

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

// The forearm: a capsule and, past its end, the hand box
fn forearm() Shape {
  var c = Shape.compound();
  c.add(Prim.capsule(0.05, 0.12), Rigid.identity());
  c.add(Prim.box(new Vec3(0.04, 0.05, 0.08)), Rigid.at(new Vec3(0., 0.25, 0.)));
  c;
}

fn kind(k i32) Shape {
  if k == 0 { return forearm(); }
  if k == 1 {
    var c = Shape.compound();
    c.add(Prim.capsule(0.05, 0.12), Rigid.identity());
    c.add(Prim.sphere(0.05), Rigid.at(new Vec3(0., 0.2, 0.)));
    return c;
  }
  if k == 2 {
    var c = Shape.compound();
    c.add(Prim.box(new Vec3(0.04, 0.05, 0.08)), Rigid.identity());
    c.add(Prim.box(new Vec3(0.04, 0.05, 0.08)), Rigid.at(new Vec3(0., 0.2, 0.)));
    return c;
  }
  // a compound holding the forearm and a second capsule, turned
  var outer = Shape.compound();
  outer.addShape(forearm(), Rigid.identity());
  outer.addShape(Shape.single(Prim.capsule(0.05, 0.12)), new Rigid(new Vec3(0.15, 0.1, 0.), Quat.angleAxis(0.5, new Vec3(0., 0., 1.))));
  outer;
}

// Drop it, let it lie 5 s, and return the largest speed seen in the next 4 s
fn restSpeed(comp Shape, rot Quat, half f32) f32 {
  var w = World.make();
  w.settings.sleepEnabled = false;
  let floorS = w.addShape(Shape.single(Prim.box(new Vec3(half, 1., half))));
  w.createBody(BodyDef.staticAt(floorS, new Vec3(0., -1., 0.)));
  var bd = BodyDef.dynamicAt(w.addShape(comp), new Vec3(0., 0.6, 0.));
  bd.rot = rot;
  let b = w.createBody(bd);
  var worst = 0.;
  var i = 0;
  while i < 540 {
    w.step(1. / 60.);
    if i >= 300 { worst = maxf(worst, w.linearVelocity(b).length() + w.angularVelocity(b).length()); }
    i = i + 1;
  }
  worst;
}

fn testSettle() {
  var k = 0;
  while k < 4 {
    var rng = new Rng(7u32);
    var worst = 0.;
    var n = 0;
    while n < 8 {
      let rot = Quat.angleAxis(rand(&mut rng, 0., 3.), new Vec3(rand(&mut rng, -1., 1.), 1., rand(&mut rng, -1., 1.)).normalize());
      worst = maxf(worst, restSpeed(kind(k), rot, 20.));
      n = n + 1;
    }
    if k == 0 { expectBool(worst < 0.0001, true, "a forearm compound at eight turns rests: speed under 0.1 mm/s"); }
    if k == 1 { expectBool(worst < 0.0001, true, "a capsule and a ball at eight turns rests"); }
    if k == 2 { expectBool(worst < 0.0001, true, "two boxes at eight turns rests"); }
    if k == 3 { expectBool(worst < 0.0001, true, "a nesting compound at eight turns rests"); }
    k = k + 1;
  }
}

fn bobOf(s Shape, rot Quat, half f32) f32 {
  var w = World.make();
  w.settings.sleepEnabled = false;
  let floorS = w.addShape(Shape.single(Prim.box(new Vec3(half, 1., half))));
  w.createBody(BodyDef.staticAt(floorS, new Vec3(0., -1., 0.)));
  var bd = BodyDef.dynamicAt(w.addShape(s), new Vec3(0., 0.2, 0.));
  bd.rot = rot;
  let b = w.createBody(bd);
  var lo = 100.;
  var hi = -100.;
  var i = 0;
  while i < 600 {
    w.step(1. / 60.);
    if i >= 300 { lo = minf(lo, w.positionOf(b).y); hi = maxf(hi, w.positionOf(b).y); }
    i = i + 1;
  }
  hi - lo;
}

fn testBigFloor() {
  let lie = Quat.angleAxis(pi / 2., new Vec3(0., 0., 1.));
  expectBool(bobOf(Shape.single(Prim.capsule(0.05, 0.12)), lie, 400.) < 0.00001, true, "a capsule lying on a 400 m floor does not bob (10 um)");
  expectBool(bobOf(forearm(), lie, 400.) < 0.00001, true, "nor does a forearm compound");
  expectBool(bobOf(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))), Quat.identity(), 400.) < 0.00001, true, "nor a box");
  var cb = Shape.compound();
  cb.add(Prim.box(new Vec3(0.5, 0.5, 0.5)), Rigid.at(new Vec3(-0.5, 0., 0.)));
  cb.add(Prim.box(new Vec3(0.5, 0.5, 0.5)), Rigid.at(new Vec3(0.5, 0., 0.)));
  expectBool(bobOf(cb, Quat.identity(), 400.) < 0.00001, true, "nor a compound of two boxes");
}

fn main() i32 {
  testSettle();
  testBigFloor();
  done();
}
