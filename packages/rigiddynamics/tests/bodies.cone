// Bodies: mass and inertia from shape and density, the three motion types,
// gravity and its factor, damping, forces and impulses, layers and masks,
// materials, and the body table.
//
// Closed forms used: box 1 m on a side at density 1000 is 1000 kg; a sphere of
// radius 0.5 at density 500 is 500 * 4/3 pi 0.125 = 261.799 kg; free fall under
// semi-implicit Euler with n sub-steps of h is g h^2 n(n+1)/2 (4.925 m in a
// second at 4 sub-steps of 1/240, against the continuous 4.905); damped
// motion with no force decays as 1 / (1 + h d) per sub-step, near e^(-d t).

mod bodies;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn nearV(got: Vec3, want: Vec3, within: f32, label: &Array[u8]) {
  near(got.x, want.x, within, label);
  near(got.y, want.y, within, label);
  near(got.z, want.z, within, label);
}

fn runSeconds(w: &mut World, secs: f32) {
  var i = 0;
  while i < i32.from(secs * 60. + 0.5) { w.step(1. / 60.); i = i + 1; }
}

fn testMass() {
  var w = World.make();
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  let ballS = w.addShape(Shape.single(Prim.sphere(0.5)));
  let b = w.createBody(BodyDef.dynamicAt(boxS, new Vec3(0., 0., 0.)));
  near(w.massOf(b), 1000., 0.01, "box 1 m at density 1000 is 1000 kg");
  var bd = BodyDef.dynamicAt(ballS, new Vec3(3., 0., 0.));
  bd.density = 500.;
  let s = w.createBody(bd);
  near(w.massOf(s), 261.799, 0.01, "sphere r 0.5 at density 500");
  var md = BodyDef.dynamicAt(boxS, new Vec3(6., 0., 0.));
  md.mass = 10.;
  let m = w.createBody(md);
  near(w.massOf(m), 10., 0.0001, "a mass given overrides the density");

  // inertia: a box of mass 6 and sides 1, 2, 3 turns about x with I = m (4 + 9) / 12; a torque of 1 N m gives 1 / I rad/s^2
  let longS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 1., 1.5))));
  var ld = BodyDef.dynamicAt(longS, new Vec3(0., 50., 0.));
  ld.mass = 6.;
  ld.angularDamping = 0.;
  let l = w.createBody(ld);
  w.gravity = new Vec3(0., 0., 0.);
  w.applyTorque(l, new Vec3(10., 0., 0.));
  w.step(1. / 60.);
  // I_xx = 6 / 12 * (2^2 + 3^2) = 6.5; w = tau dt / I
  near(w.angularVelocity(l).x, 10. / 60. / 6.5, 0.0005, "box angular acceleration from its inertia");
  w.applyTorque(l, new Vec3(0., 10., 0.));
  w.step(1. / 60.);
  // I_yy = 6 / 12 * (1 + 9) = 5
  near(w.angularVelocity(l).y, 10. / 60. / 5., 0.0005, "about the long axis the inertia is less");
}

fn testCompound() {
  // a compound of a box at the origin and a sphere 2 m along x: the centre of mass is nearer the heavier part
  var w = World.make();
  var c = Shape.compound();
  c.add(Prim.box(new Vec3(0.5, 0.5, 0.5)), Rigid.identity());
  c.add(Prim.box(new Vec3(0.5, 0.5, 0.5)), Rigid.at(new Vec3(2., 0., 0.)));
  let shape = w.addShape(c);
  w.gravity = new Vec3(0., 0., 0.);
  var bd = BodyDef.dynamicAt(shape, new Vec3(10., 0., 0.));
  bd.linearDamping = 0.; bd.angularDamping = 0.;
  let b = w.createBody(bd);
  nearV(w.centerOfMass(b), new Vec3(11., 0., 0.), 0.0001, "centre of mass of two equal boxes is midway");
  nearV(w.positionOf(b), new Vec3(10., 0., 0.), 0.0001, "the body's position is its shape origin, not its centre of mass");
  // a force through the centre of mass gives no spin
  w.applyForce(b, new Vec3(0., 100., 0.));
  w.step(1. / 60.);
  near(w.angularVelocity(b).length(), 0., 0.0001, "no spin from a force through the centre of mass");
  // a force at the shape origin does, about the offset centre of mass
  w.applyForceAt(b, new Vec3(0., 100., 0.), new Vec3(10., 0., 0.));
  w.step(1. / 60.);
  // torque = (-1, 0, 0) x (0, 100, 0) = (0, 0, -100); I_zz = 2 (1000 / 6 + 1000 * 1) = 2333.33
  near(w.angularVelocity(b).z, -100. / 60. / 2333.33, 0.00002, "a force off the centre of mass spins the body by torque / inertia");
}

fn testMotion() {
  var w = World.make();
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  var dd = BodyDef.dynamicAt(boxS, new Vec3(0., 100., 0.));
  dd.linearDamping = 0.;
  let dyn = w.createBody(dd);
  let sta = w.createBody(BodyDef.staticAt(boxS, new Vec3(5., 100., 0.)));
  let kin = w.createBody(BodyDef.kinematicAt(boxS, new Vec3(-5., 100., 0.)));
  w.setLinearVelocity(kin, new Vec3(2., 0., 0.));
  runSeconds(&mut w, 1.);
  near(w.positionOf(dyn).y, 100. - 4.925, 0.01, "a dynamic body falls g h^2 n(n+1)/2 in a second");
  nearV(w.positionOf(sta), new Vec3(5., 100., 0.), 0.00001, "a static body stays");
  nearV(w.positionOf(kin), new Vec3(-3., 100., 0.), 0.001, "a kinematic body moves at its velocity and is not pulled by gravity");
  // moveKinematic drives it to a pose in one step
  w.moveKinematic(kin, new Vec3(0., 101., 2.), Quat.angleAxis(0.5, new Vec3(0., 1., 0.)), 1. / 60.);
  w.step(1. / 60.);
  nearV(w.positionOf(kin), new Vec3(0., 101., 2.), 0.001, "moveKinematic reaches the pose in the step");
  near(w.rotationOf(kin).y, sin(0.25), 0.001, "and the orientation");

  // gravity factor
  var z = World.make();
  let bs = z.addShape(Shape.single(Prim.sphere(0.5)));
  var d0 = BodyDef.dynamicAt(bs, new Vec3(0., 100., 0.));
  d0.gravityFactor = 0.; d0.linearDamping = 0.;
  var d2 = BodyDef.dynamicAt(bs, new Vec3(10., 100., 0.));
  d2.gravityFactor = 2.; d2.linearDamping = 0.;
  let f0 = z.createBody(d0);
  let f2 = z.createBody(d2);
  runSeconds(&mut z, 1.);
  near(z.positionOf(f0).y, 100., 0.0001, "gravity factor 0 floats");
  near(z.positionOf(f2).y, 100. - 2. * 4.925, 0.02, "gravity factor 2 falls twice as far");
}

fn testForcesAndDamping() {
  var w = World.make();
  w.gravity = new Vec3(0., 0., 0.);
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  var bd = BodyDef.dynamicAt(boxS, new Vec3(0., 0., 0.));
  bd.linearDamping = 0.; bd.angularDamping = 0.;
  let b = w.createBody(bd);
  w.applyImpulse(b, new Vec3(500., 0., 0.));
  nearV(w.linearVelocity(b), new Vec3(0.5, 0., 0.), 0.00001, "an impulse of 500 N s on 1000 kg is 0.5 m/s");
  var i = 0;
  while i < 60 { w.applyForce(b, new Vec3(0., 2000., 0.)); w.step(1. / 60.); i = i + 1; }
  near(w.linearVelocity(b).y, 2., 0.001, "2000 N on 1000 kg for a second is 2 m/s");
  // an impulse at a point off the centre spins the body: L = r x p
  w.setLinearVelocity(b, new Vec3(0., 0., 0.));
  w.applyImpulseAt(b, new Vec3(0., 0., 100.), w.centerOfMass(b) + new Vec3(0.5, 0., 0.));
  // r x p = (0.5, 0, 0) x (0, 0, 100) = (0, -50, 0); I = 1000 / 6 = 166.667
  near(w.angularVelocity(b).y, -50. / 166.667, 0.0005, "an impulse at an offset spins it");

  var z = World.make();
  z.gravity = new Vec3(0., 0., 0.);
  let bs = z.addShape(Shape.single(Prim.sphere(0.5)));
  var dd = BodyDef.dynamicAt(bs, new Vec3(0., 0., 0.));
  dd.linVel = new Vec3(10., 0., 0.);
  dd.linearDamping = 1.;
  let d = z.createBody(dd);
  runSeconds(&mut z, 1.);
  near(z.linearVelocity(d).x, 10. / 2.7183, 0.02, "linear damping 1 per second leaves 1/e of the speed");
}

fn testLayers() {
  // the floor is on layer 2; a box that collides with layer 1 only falls through it, one that collides with 2 rests on it
  var w = World.make();
  let floorS = w.addShape(Shape.single(Prim.box(new Vec3(10., 0.5, 10.))));
  let boxS = w.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  var fd = BodyDef.staticAt(floorS, new Vec3(0., -0.5, 0.));
  fd.layer = 2u32; fd.mask = 0xffffffffu32;
  w.createBody(fd);
  var a = BodyDef.dynamicAt(boxS, new Vec3(-3., 2., 0.));
  a.layer = 1u32; a.mask = 1u32;
  var b = BodyDef.dynamicAt(boxS, new Vec3(3., 2., 0.));
  b.layer = 1u32; b.mask = 3u32;
  let ia = w.createBody(a);
  let ib = w.createBody(b);
  runSeconds(&mut w, 3.);
  expectBool(w.positionOf(ia).y < -3., true, "a body that does not collide with the floor's layer falls through it");
  near(w.positionOf(ib).y, 0.5, 0.01, "a body that does collide rests on it");
  // the floor's own mask matters as much: a floor that ignores layer 1 is passed through by a body that would collide with it
  var z = World.make();
  let zf = z.addShape(Shape.single(Prim.box(new Vec3(10., 0.5, 10.))));
  let zb = z.addShape(Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5))));
  var f2 = BodyDef.staticAt(zf, new Vec3(0., -0.5, 0.));
  f2.layer = 2u32; f2.mask = 4u32;
  z.createBody(f2);
  var c = BodyDef.dynamicAt(zb, new Vec3(0., 2., 0.));
  c.layer = 1u32; c.mask = 2u32;
  let ic = z.createBody(c);
  runSeconds(&mut z, 3.);
  expectBool(z.positionOf(ic).y < -3., true, "both masks must accept: a floor that ignores the body's layer is passed through");
}

fn testMaterials() {
  near(combineFriction(0.5, 0.5), 0.5, 0.00001, "equal frictions combine to themselves");
  near(combineFriction(0.8, 0.2), 0.4, 0.00001, "friction combines as the geometric mean");
  near(combineFriction(0.02, 1.), 0.1414214, 0.00001, "ice on rubber");
  near(combineRestitution(0.2, 0.9), 0.9, 0.00001, "restitution is the larger");
  let m = PhysMaterial.make(0.5, 0.2, 0.1);
  near(m.staticFriction, 0.5, 0.00001, "a static coefficient below the sliding one is raised to it");
  near(PhysMaterial.ice().friction, 0.02, 0.00001, "ice");
}

fn testTable() {
  var w = World.make();
  let ballS = w.addShape(Shape.single(Prim.sphere(0.5)));
  let a = w.createBody(BodyDef.dynamicAt(ballS, new Vec3(0., 0., 0.)));
  let b = w.createBody(BodyDef.dynamicAt(ballS, new Vec3(5., 0., 0.)));
  expectInt(i64.from(w.bodyCount()), 2i64, "two bodies");
  w.destroyBody(a);
  expectInt(i64.from(w.bodyCount()), 1i64, "one after a destroy");
  expectBool(w.isAlive(a), false, "the destroyed one is gone");
  let c = w.createBody(BodyDef.dynamicAt(ballS, new Vec3(9., 0., 0.)));
  expectUInt(u64.from(c), u64.from(a), "its slot is reused");
  expectBool(w.isAlive(b), true, "the other is untouched");
  nearV(w.positionOf(c), new Vec3(9., 0., 0.), 0.0001, "the new body is where it was put");
  var d = BodyDef.dynamicAt(ballS, new Vec3(1., 2., 3.));
  d.userData = 77u32;
  expectUInt(u64.from(w.userDataOf(w.createBody(d))), 77u64, "user data comes back");
}

fn main() i32 {
  testMass();
  testCompound();
  testMotion();
  testForcesAndDamping();
  testLayers();
  testMaterials();
  testTable();
  done()
}
