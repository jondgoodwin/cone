// Robustness: many mixed shapes, ground that is not a box, and determinism.
//
//   a pile      eighty boxes, spheres, capsules, cylinders and hulls dropped into a
//               walled pit settle: none falls through the floor or out of the pit,
//               none is left moving, all eighty go to sleep (four different drops),
//               and no two overlap deeper than a centimetre
//   terrain     a box rests on a heightfield and on a triangle mesh, a ball rolls
//               down a heightfield slope at the rate g sin(theta) / (1 + 2/5) of a
//               rolling sphere (the solver's friction keeps it from sliding)
//   determinism two worlds built the same way and stepped the same way hold
//               bit-for-bit the same state

mod piles;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;
import noise;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

struct Rng { state: u32; }

fn nextf(r: &mut Rng) f32 {
  r.state = noise.pcg(r.state + 1u32);
  noise.toUnit(r.state)
}

fn rand(r: &mut Rng, lo: f32, hi: f32) f32 { lo + (hi - lo) * nextf(r) }

fn pit(w: &mut World) {
  let floorS = w.addShape(Shape.single(Prim.box(Vec3(4., 0.5, 4.))));
  let wallX = w.addShape(Shape.single(Prim.box(Vec3(0.5, 3., 4.))));
  let wallZ = w.addShape(Shape.single(Prim.box(Vec3(4., 3., 0.5))));
  w.createBody(BodyDef.staticAt(floorS, Vec3(0., -0.5, 0.)));
  w.createBody(BodyDef.staticAt(wallX, Vec3(-4.5, 2.5, 0.)));
  w.createBody(BodyDef.staticAt(wallX, Vec3(4.5, 2.5, 0.)));
  w.createBody(BodyDef.staticAt(wallZ, Vec3(0., 2.5, -4.5)));
  w.createBody(BodyDef.staticAt(wallZ, Vec3(0., 2.5, 4.5)));
}

// Eighty bodies in a loose grid above the pit, the same every time
fn fill(w: &mut World, count: i32, seed: u32) {
  var rng = Rng(seed);
  let boxS = w.addShape(Shape.single(Prim.box(Vec3(0.3, 0.2, 0.25))));
  let sphereS = w.addShape(Shape.single(Prim.sphere(0.25)));
  let capsuleS = w.addShape(Shape.single(Prim.capsule(0.15, 0.25)));
  let cylinderS = w.addShape(Shape.single(Prim.cylinder(0.2, 0.2)));
  var pts = List[Vec3].empty();
  pts.push(Vec3(-0.25, -0.2, -0.25)); pts.push(Vec3(0.25, -0.2, -0.25)); pts.push(Vec3(0.25, -0.2, 0.25));
  pts.push(Vec3(-0.25, -0.2, 0.25)); pts.push(Vec3(0., 0.3, 0.));
  let hullS = w.addShape(Shape.single(convexHull(pts.view())));
  var kinds = List[u32].empty();
  kinds.push(boxS); kinds.push(sphereS); kinds.push(capsuleS); kinds.push(cylinderS); kinds.push(hullS);
  var n = 0;
  while n < count {
    let shape = *kinds[usize.from(n % 5)];
    var bd = BodyDef.dynamicAt(shape, Vec3(-3. + f32.from(n % 5) * 1.4 + rand(&mut rng, -0.1, 0.1), 1. + f32.from(n / 25) * 1.2,
      -3. + f32.from((n / 5) % 5) * 1.4 + rand(&mut rng, -0.1, 0.1)));
    bd.rot = Quat.angleAxis(rand(&mut rng, 0., 3.), Vec3(rand(&mut rng, -1., 1.), 1., rand(&mut rng, -1., 1.)).normalize());
    w.createBody(bd);
    n = n + 1;
  }
}

fn testPile(seed: u32) {
  var w = World.make();
  pit(&mut w);
  fill(&mut w, 80, seed);
  var i = 0;
  while i < 60 * 25 { w.step(1. / 60.); i = i + 1; }
  var inside = true;
  var asleep = 0;
  var moving = 0;
  var b = 5usize;
  while b < w.bodies.len() {
    let p = w.bodies[b].pos;
    if p.y < 0. || absf(p.x) > 4. || absf(p.z) > 4. || p.y > 4. { inside = false; }
    if w.bodies[b].asleep { asleep = asleep + 1; }
    if w.bodies[b].linVel.length() > 0.05 { moving = moving + 1; }
    b = b + 1usize;
  }
  expectBool(inside, true, "every body is still in the pit, on the floor");
  expectInt(i64.from(moving), 0i64, "none is moving after 25 s");
  // (A hull pyramid propped on one base edge by its neighbours was given a single contact: whichever of the edge's
  // two corners rounding made lower, a different one every step. It rocked at 3 cm/s and kept its island awake.
  // Seeds 777, 783, 784 and 787 left 74, 78, 77 and 71 of the eighty asleep before an edge gave both corners.)
  expectInt(i64.from(asleep), 80i64, "all eighty are asleep: rolling resistance and twist friction stop the balls, edges hold");
  // penetration: the deepest contact in the cache
  var deepest = -100.f;
  var c = 0usize;
  while c < w.cache.len() {
    let ct = w.cache[c];
    var k = 0usize;
    while k < ct.count { deepest = maxf(deepest, ct.pts[k].depth); k = k + 1usize; }
    c = c + 1usize;
  }
  expectBool(deepest < 0.01, true, "no contact is deeper than a centimetre");
}

fn testTerrain() {
  // a heightfield tilted by 0.2 per metre along x (11.3 degrees); a box rests on it, a ball rolls down it
  var w = World.make();
  w.settings.sleepEnabled = false;
  var hs = List[f32].empty();
  var r = 0u32;
  while r < 11u32 {
    var c = 0u32;
    while c < 41u32 { hs.push(8. - 0.2 * f32.from(c)); c = c + 1u32; }
    r = r + 1u32;
  }
  let field = w.addShape(Shape.single(Prim.heightfield(hs, 41u32, 11u32, 1., 1., Vec3(-20., 0., -5.))));
  w.createBody(BodyDef.staticAt(field, Vec3(0., 0., 0.)));
  let boxS = w.addShape(Shape.single(Prim.box(Vec3(0.5, 0.5, 0.5))));
  let ballS = w.addShape(Shape.single(Prim.sphere(0.5)));
  // friction 0.5 > tan(11.3 degrees) = 0.2: the box stays where it lands
  var bd = BodyDef.dynamicAt(boxS, Vec3(-10., 8. - 0.2 * 10. + 1., 0.));
  let boxId = w.createBody(bd);
  var sd = BodyDef.dynamicAt(ballS, Vec3(-5., 8. - 0.2 * 15. + 1., 2.));
  sd.material = PhysMaterial.make(0.5, 0.5, 0.);
  sd.linearDamping = 0.; sd.angularDamping = 0.;
  let ballId = w.createBody(sd);
  var i = 0;
  while i < 150 { w.step(1. / 60.); i = i + 1; }
  let x0 = w.positionOf(boxId).x;
  let bx0 = w.positionOf(ballId).x;
  let bt0 = w.linearVelocity(ballId).length();
  while i < 270 { w.step(1. / 60.); i = i + 1; }
  near(w.positionOf(boxId).x, x0, 0.01, "a box stays on a heightfield slope of 11 degrees");
  // the slope under the box: y = 8 - 0.2 (x + 20), the box's centre half a metre up along the normal
  let bp = w.positionOf(boxId);
  near(bp.y, 8. - 0.2 * (bp.x + 20.) + 0.5 * 1.0198, 0.03, "resting on the surface");
  // the ball: rolls with a = g (sin(theta) - rolling cos(theta) / r) / (1 + I/(m r^2)) = ... / 1.4 along the slope
  // (rolling resistance 0.01 m, radius 0.5 m: the torque that slows it is 0.01 m times the normal force)
  let theta = atan2(0.2, 1.);
  let a = 9.81 * (sin(theta) - 0.01 * cos(theta) / 0.5) / 1.4;
  let v1 = w.linearVelocity(ballId).length();
  near((v1 - bt0) / 2., a, 0.05, "a ball rolls down a heightfield at g (sin - rolling cos / r) / 1.4");
  expectBool(w.positionOf(ballId).x > bx0 + 1., true, "and travels down it");
}

fn testMesh() {
  // a box on a tilted triangle-mesh plane (two triangles), friction holds it
  var w = World.make();
  let tilt = 0.2f;
  var verts = List[Vec3].empty();
  verts.push(Vec3(-20., 0., -20.)); verts.push(Vec3(20., 0., -20.)); verts.push(Vec3(20., 0., 20.)); verts.push(Vec3(-20., 0., 20.));
  var tris = List[u32].empty();
  tris.push(0u32); tris.push(2u32); tris.push(1u32); tris.push(0u32); tris.push(3u32); tris.push(2u32);
  let meshS = w.addShape(Shape.single(meshPrim(verts, tris)));
  var md = BodyDef.staticAt(meshS, Vec3(0., 0., 0.));
  md.rot = Quat.angleAxis(tilt, Vec3(0., 0., 1.));
  w.createBody(md);
  let boxS = w.addShape(Shape.single(Prim.box(Vec3(0.5, 0.5, 0.5))));
  let n = Quat.angleAxis(tilt, Vec3(0., 0., 1.)) * Vec3(0., 1., 0.);
  var bd = BodyDef.dynamicAt(boxS, n * 0.505);
  bd.rot = Quat.angleAxis(tilt, Vec3(0., 0., 1.));
  let b = w.createBody(bd);
  var i = 0;
  while i < 240 { w.step(1. / 60.); i = i + 1; }
  near(w.positionOf(b).x, 0.505 * (-sin(tilt)), 0.01, "a box set on a tilted triangle mesh stays where it is put");
  near(w.linearVelocity(b).length(), 0., 0.001, "at rest");
  near((w.positionOf(b)).dot(n) - 0.5, 0., 0.002, "its bottom on the mesh's plane");
}

fn testDeterminism() {
  var a = World.make();
  var b = World.make();
  pit(&mut a); pit(&mut b);
  fill(&mut a, 60, 777u32); fill(&mut b, 60, 777u32);
  var i = 0;
  while i < 400 { a.step(1. / 60.); b.step(1. / 60.); i = i + 1; }
  var same = true;
  var k = 0usize;
  while k < a.bodies.len() {
    let p = a.bodies[k].pos;
    let q = b.bodies[k].pos;
    let ra = a.bodies[k].rot;
    let rb = b.bodies[k].rot;
    if p.x != q.x || p.y != q.y || p.z != q.z || ra.x != rb.x || ra.w != rb.w { same = false; }
    k = k + 1usize;
  }
  expectBool(same, true, "two identical worlds stepped identically are bit-for-bit the same");
  expectInt(i64.from(a.lastContacts), i64.from(b.lastContacts), "with the same contacts");
}

fn main() i32 {
  testPile(777u32);
  testPile(783u32);
  testPile(784u32);
  testPile(787u32);
  testTerrain();
  testMesh();
  testDeterminism();
  done()
}
