// ---- Closures through a generic, run on the GPU ----
//
// A closure literal written in GPU code and given to a generic whose parameter
// is bound by a signature, '[F fn(p Vec3) f32]', is the static form: the
// generic gets its own instance for the closure's struct, and every call is
// inlined into the kernel, so the closure's state and borrows are locals of
// the invocation. What it captures is what a GPU holds: numbers, structs of
// them, and borrows of memory the GPU has (a local, a buffer's slice). Five
// kernels of that shape (a local, a buffer's slice, listed state, a changed
// variable of the kernel, a closure inside a closure), and a hand-written
// struct with '()' through the same generic. tests/closures.cone runs each on the GPU and on the CPU, where the
// same generic is instanced the same way, and compares every word bit for bit,
// so each closure body keeps to additions, subtractions and multiplications,
// which both sides compute alike.

// A shape is a function of a point; this asks it twice over
pub fn shadeWith[F fn(p Vec3) f32](f &F, p Vec3) f32 { f(p) * 2. + 1.; }

// The same, for a closure whose state changes between calls: it is lent '&mut'
pub fn shadeTwice[F fn(p Vec3) f32](f &mut F, p Vec3) f32 {
  imm first = f(p);
  first + f(p);
}

// The point of invocation i in 'pts', three words each
fn pointAt(pts &Array[f32], i usize) Vec3 { new Vec3(pts[3usize * i], pts[3usize * i + 1usize], pts[3usize * i + 2usize]); }

// A ball: its distance function is the struct's '()'
pub struct Ball {
  pub radius f32;
  pub fn `()`(self &, p Vec3) f32 { p.dot(p) - radius * radius; }
}

// A closure over a local, a value taken from a buffer: it borrows 'radius'
pub fn @compute(64) closureLocal(inv Invocation, pts &Array[f32], radii &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0usize]);
  if i < out.len and 3usize * i + 2usize < pts.len and i < radii.len {
    imm radius = radii[i];
    out[i] = shadeWith(p => p.dot(p) - radius * radius, pointAt(pts, i));
  }
}

// A closure over a buffer's slice and an index: it borrows memory the GPU has
pub fn @compute(64) closureBuffer(inv Invocation, pts &Array[f32], radii &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0usize]);
  if i < out.len and 3usize * i + 2usize < pts.len and i < radii.len {
    out[i] = shadeWith(fn(p Vec3) f32 { p.dot(p) - radii[i] * radii[i]; }, pointAt(pts, i));
  }
}

// A closure with state of its own, listed: a field copied in, and one that
// changes with each call (so the second call sees the first's)
pub fn @compute(64) closureState(inv Invocation, pts &Array[f32], radii &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0usize]);
  if i < out.len and 3usize * i + 2usize < pts.len and i < radii.len {
    out[i] = shadeTwice(fn(p Vec3) [r = radii[i], mut calls = 0.] f32 {
      calls = calls + 1.;
      p.dot(p) * calls - r * r;
    }, pointAt(pts, i));
  }
}

// A closure changing a variable of the kernel: '&mut' borrow of a local
pub fn @compute(64) closureMutLocal(inv Invocation, pts &Array[f32], radii &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0usize]);
  if i < out.len and 3usize * i + 2usize < pts.len and i < radii.len {
    mut seen = 0.;
    imm both = shadeTwice(p => { seen = seen + p.x; p.dot(p) - radii[i]; }, pointAt(pts, i));
    out[i] = both + seen;
  }
}

// A closure inside a closure, each through a generic: the inner borrows what the
// outer holds, a local and a buffer's slice
pub fn pairWith[F fn(x f32) f32](f &F, x f32) f32 { f(x) + f(x + 1.); }

pub fn @compute(64) closureNested(inv Invocation, pts &Array[f32], radii &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0usize]);
  if i < out.len and 3usize * i + 2usize < pts.len and i < radii.len {
    imm k = radii[i];
    out[i] = shadeWith(fn(p Vec3) f32 {
      pairWith(x => x * radii[i] + k + p.x, p.y);
    }, new Vec3(pts[3usize * i], pts[3usize * i + 1usize], 2.));
  }
}

// A hand-written struct with '()' through the very same generic
pub fn @compute(64) structCall(inv Invocation, pts &Array[f32], radii &Array[f32], out &mut Array[f32]) {
  imm i = usize.from(inv.globalId[0usize]);
  if i < out.len and 3usize * i + 2usize < pts.len and i < radii.len {
    imm ball = new Ball(radii[i]);
    out[i] = shadeWith(&ball, pointAt(pts, i));
  }
}
