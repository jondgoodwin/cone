// gpusample's kernel run end to end: gpusample.spv, which Congo built from
// the package and copied beside this program, loaded through gpuwork's
// readSpirv and Kernel.make, run on the GPU over 1,000 normals, and the same
// 'shade' run on the CPU as its twin, invocation by invocation, over the same
// buffers; every value compared. The GPU's square root and division are
// within a few ulps of the CPU's, not bit for bit, so each value must agree
// within 1e-5 (the values lie between 0.1 and 1). No invocation may fail a
// check: the job's Completion has no KernelFailure (gpuwork binds and reads
// the kernel's error buffer itself).
//
// Only a failure prints. With GPUWORK_REPORT set, it also prints the adapter
// and the largest difference. It needs a GPU driver with Vulkan 1.3 and
// SDL3.dll; with the Vulkan SDK, the validation layers are on, and must say
// nothing.

mod dispatch;

import testing use *;
import stdio use *;
import libc;
import collections use List;
import geomath use *;
import gpu use *;
import gpuwork use *;
import gpusample use *;

const COUNT = 1000u32;

// The 32 bits of an f32, and back ('as' reinterprets)
fn bits(f f32) u32 { f as u32; }
fn value(w u32) f32 { w as f32; }

// The normals, as words: none of them zero, in every direction
fn normalWords() List[u32] {
  mut words = List[u32].withCapacity(3usize * usize.from(COUNT));
  mut i = 0u32;
  while i < COUNT {
    words.push(bits(f32.from(i % 17u32) - 7.5));
    words.push(bits(f32.from(i % 13u32) - 5.5));
    words.push(bits(f32.from(i % 7u32) - 2.5));
    i = i + 1u32;
  }
  words;
}

// 'count' zero words
fn zeros(count usize) List[u32] {
  mut l = List[u32].withCapacity(count);
  mut i = 0usize;
  while i < count {
    l.push(0u32);
    i = i + 1usize;
  }
  l;
}

// The kernel's twin, as gpuwork calls it: the bindings as words, handed to
// gpusample's 'shade', the very function the GPU's kernel is made from
fn shadeTwin(inv Invocation, buffers &[]Words) {
  imm n = buffers[1usize].f32s();
  imm normals = mem.sliceFromParts[Vec3](&n[0usize] as *f32 as *Vec3, n.len / 3usize);
  shade(inv, buffers[0usize].value[Light](), normals, buffers[2usize].f32sMut());
}

fn main() i32 {
  mut instance = Instance.create("gpusample dispatch");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  imm report = (libc.getenv("GPUWORK_REPORT") as usize) != 0usize;
  if report {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr("\n");
  }

  // The kernel, from the module Congo copied beside this program. Its
  // bindings: the light, the normals and what it writes; its error buffer,
  // bound after them, is gpuwork's own
  imm spirv = readSpirv("gpusample.spv");
  require(spirv.len() > 5usize, "gpusample.spv beside the program");
  mut kernel = Kernel.make(&device, spirv.view(), "shade", &[READ, READ, READ_WRITE]);
  require(kernel.isValid(), "the shade kernel");
  expectUInt(u64.from(kernel.workgroup[0usize]), 64u64, "its workgroup, 64, read from the SPIR-V");
  kernel.setTwin(&shadeTwin);

  imm light = new Light(Quat.angleAxis(0.7, new Vec3(0., 0., 1.)), new Vec3(0.3, 0.5, 0.8).normalize(), 0.9, 0.1);
  imm groups = (COUNT + 63u32) / 64u32;

  // On the GPU
  mut works = Works.make();
  mut job = Job.make(&mut device);
  imm lightSlot = job.give(uploadValue(&mut device, &light));
  imm normals = normalWords();
  imm normalSlot = job.give(upload(&mut device, normals.view()));
  imm outSlot = job.give(zeroed(&mut device, usize.from(COUNT)));
  require(job.dispatch(&mut device, &kernel, &[lightSlot, normalSlot, outSlot], groups), "the dispatch");
  imm outBack = job.readback(&mut device, outSlot);
  imm ticket = works.submit(&mut device, job, Target.Here[0u64]);
  mut answers = List[Completion].empty();
  works.waitFor(&mut device, ticket, &mut answers);
  require(answers.len() == 1usize and answers[0usize].ok, "the GPU ran the job");
  imm gpuOut = answers[0usize].words(outBack);
  expectUInt(u64.from(gpuOut.len()), u64.from(COUNT), "a value for each normal from the GPU");
  expectUInt(u64.from(answers[0usize].failures.len()), 0u64, "no invocation failed a check");

  // On the CPU: the twin over the same buffers
  mut cpu = List[List[u32]].empty();
  mut lightWords = List[u32].empty();
  lightWords.push(bits(light.turn.x));
  lightWords.push(bits(light.turn.y));
  lightWords.push(bits(light.turn.z));
  lightWords.push(bits(light.turn.w));
  lightWords.push(bits(light.dir.x));
  lightWords.push(bits(light.dir.y));
  lightWords.push(bits(light.dir.z));
  lightWords.push(bits(light.gain));
  lightWords.push(bits(light.ambient));
  cpu.push(lightWords);
  cpu.push(normalWords());
  cpu.push(zeros(usize.from(COUNT)));
  require(runTwin(&kernel, &mut cpu, groups), "the twin ran");

  // Every value, within 1e-5
  mut far = 0u64;
  mut unwritten = 0u64;
  mut largest = 0.f32;
  mut i = 0usize;
  while i < usize.from(COUNT) and i < gpuOut.len() {
    imm g = value(*gpuOut[i]);
    imm c = value(*cpu[2usize][i]);
    if c < 0.09 { unwritten = unwritten + 1u64; }
    mut d = g - c;
    if d < 0. { d = -d; }
    if d > largest { largest = d; }
    if not (d <= 0.00001) { far = far + 1u64; }
    i = i + 1usize;
  }
  expectUInt(unwritten, 0u64, "the twin wrote every value");
  expectUInt(far, 0u64, "the GPU's values within 1e-5 of the CPU's");
  if report {
    printStr("largest difference: ");
    print <- f64.from(largest);
    printStr("\n");
  }
  expectUInt(u64.from(refusals()), 0u64, "nothing refused");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}
