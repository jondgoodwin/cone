// meshedpart: the sample of a part sampled and meshed on the GPU, end to
// end, the two halves of trial 1's pipeline. Its gpu/ folder
// (gpu/part.cone) holds the part's shape and 'sample', the kernel that
// samples it on an sdf.SampleGrid, one invocation a sample; sdfmesh's
// GridMesher meshes those samples on the GPU, the samples never leaving it.
//
// main (src/main.cone), for a coarse grid and then one of about 3.6 million
// samples (the starship's size at 3 cm cells): samples the part on the GPU
// and on the CPU and counts the samples that are the same bits; meshes the
// GPU's samples on the GPU and compares the mesh with sdfmesh's surfaceNet
// on the CPU (dense, unrelaxed); meshes the CPU's samples on the GPU, which
// must be surfaceNet's mesh bit for bit; and, on the large grid, times each
// step (five runs, the least and the median). It needs a GPU driver with
// Vulkan 1.3 and SDL3.dll; GPUWORK_REPORT set prints the adapter. Run it
// with 'congo run --release' for the timings. Nothing runs it automatically.

mod meshedpart;

import libc;
import stdio use *;
import geomath use *;
import collections use List;
import time use Instant;
import sdf use SampleGrid;
import sdfmesh use SurfaceNet, surfaceNet, GridMesher, GridNet;
import gpu use *;
import gpuwork use *;

use part Part, partBox;
