// An allocation that names an arena, 'new a[Node](1)': the arena VALUE in the
// head, then the type in brackets (a permission before it may be written, but
// it can only be 'mut', which is what an arena lends). It means 'a.alloc(new
// Node(1))' and answers what that arena's 'alloc' answers: a scoped '&mut Node'
// from an Arena, a key '&'=a mut Node' from a DynArena. Every expected value is
// worked out by hand from that meaning:
// - a Pt made with 'new a[Pt](...)' is a Pt in the arena that can be changed
//   through the reference, with the permission written or not, and takes no
//   finalizer header; a Fin (a value with a 'final') takes one, and dies when
//   the arena does, newest first;
// - a List made in an arena with a counting region passed as the last argument,
//   'new a[List[i64]](50, r)', is the list's four words in the arena and its
//   block from the region ("allocs 1, 400 bytes live": 50 slots of 8); the
//   arena's death runs the list's 'final', which gives the block back (live 0);
// - a Mesh holds two lists and declares CarriesRegion, and its init passes its
//   own 'region' on to both: made with a counting region in it, in an arena or
//   not, two blocks of 50 slots of 4 bytes come from that region (allocs 2, 400
//   bytes live), and both are given back when the Mesh dies, in the arena at its
//   death. Made without a region it is handed the heap's, outside an arena; in
//   one it is handed the arena's (an arena is a region: tests/inarena.cone).
// - in a DynArena the answer is a key: read and written through the arena,
//   and a chain of nodes holding each other's keys is built with it;
// - the value is built where it stays in the arena, not built elsewhere and copied
//   in: the arguments of its construction are evaluated first, then its room is
//   taken, then it is built there, so what the construction allocates in the arena
//   lies after the value, and the value goes on the arena's list of finalizers
//   last of what was made for it.

mod newin;

import testing use *;
import arena use *;
import collections use *;
import libc;

var @threadlocal log = 0i64;
fn note(d i64) { log = log * 10i64 + d; }

struct Fin {
  pub n i64;
  fn final(self &uni) { note(n); }
}

struct Pt {
  pub x i64;
  pub y i64;
  pub fn sum(self &) i64 { x + y }
}

// A counting region: its header first, then the tallies
struct Counting {
  header MemRegion;
  allocs usize;
  releases usize;
  live isize;
}

fn countAlloc(r *MemRegion, bytes usize, align usize) *u8 {
  let c = r as *Counting;
  (*c).allocs = (*c).allocs + 1usize;
  (*c).live = (*c).live + isize.from(bytes);
  libc.malloc(bytes)
}

fn countResize(r *MemRegion, block *u8, oldBytes usize, newBytes usize, align usize) *u8 {
  let c = r as *Counting;
  (*c).live = (*c).live + isize.from(newBytes) - isize.from(oldBytes);
  libc.realloc(block, newBytes)
}

fn countRelease(r *MemRegion, block *u8, bytes usize) {
  if block as usize == 0usize { return; }
  let c = r as *Counting;
  (*c).releases = (*c).releases + 1usize;
  (*c).live = (*c).live - isize.from(bytes);
  libc.free(block);
}

fn newCounting() Counting {
  new Counting(new MemRegion(&countAlloc, &countResize, &countRelease), 0usize, 0usize, 0isize)
}

fn regionOf(c &mut Counting) *MemRegion { (c as *Counting) as *MemRegion }

fn tally(c &Counting, allocs u64, releases u64, live i64, label &Array[u8]) {
  let ok = u64.from(c.allocs) == allocs and u64.from(c.releases) == releases and i64.from(c.live) == live;
  expect(ok, label);
}

// A value that holds two lists and hands its region on to both
struct Mesh is CarriesRegion {
  pub pts List[f32];
  pub ids List[u32];
  pub region *MemRegion;

  pub fn init(self &new, n usize, region *MemRegion) {
    *self = new Mesh(pts: new List[f32](n, region), ids: new List[u32](n, region), region: region);
  }
}

// A value in an arena
fn plain() {
  var a = Arena.empty();
  let p = new a[Pt](1, 2);
  expectInt(p.sum(), 3, "new a[Pt](1, 2) is a Pt in the arena");
  p.x = 10;
  expectInt(p.sum(), 12, "and is changed through the reference it answers");
  let q = new a[mut, Pt](3, 4);
  expectInt(q.sum(), 7, "the permission may be written, 'mut'");
  let r = a.alloc(new Pt(5, 6));
  expectInt(r.sum(), 11, "and it is what a.alloc(new Pt(5, 6)) gives");
  expectUInt(u64.from(a.finalizers()), 0, "a Pt needs no finalizer header");
  expectUInt(u64.from(a.blockCount()), 1, "and the three share a block");
}

// A value built where it stays: a Mesh's init allocates the blocks of its two
// lists in the arena, and they lie after the Mesh, in the order they were asked
// for (built first and copied in, the Mesh would lie after both). The arena has
// room for all three in its one block, so the order of the addresses is the order
// of the bumps
fn fill(m &mut Mesh) {
  m.pts.push(1.5f32);
  m.ids.push(7u32);
}

fn inplace() {
  var a = Arena.withRoom(4000usize);
  let m = new a[Mesh](8usize);
  fill(m);
  let mat = (m as *Mesh) as usize;
  let pat = (m.pts[0usize] as *f32) as usize;
  let iat = (m.ids[0usize] as *u32) as usize;
  expect(mat < pat and pat < iat, "a Mesh made in an arena lies before the blocks its init allocated there");
  expectUInt(u64.from(a.blockCount()), 1, "in the one block");
  var d = DynArena.withRoom(4000usize);
  let k = new d[Mesh](8usize);
  fill(&mut d[k]);
  let dmat = (d[k] as *Mesh) as usize;
  let dpat = (d[k].pts[0usize] as *f32) as usize;
  let diat = (d[k].ids[0usize] as *u32) as usize;
  expect(dmat < dpat and dpat < diat, "and so does one made in a dynamic arena");
  expectUInt(u64.from(d.blockCount()), 1, "in its one block");
}

// A value with a 'final' that another construction is built from: that one is
// made first and is finalized last
struct Wrap {
  pub v i64;
  fn final(self &uni) { note(v); }
}

fn argsFirst() {
  log = 0;
  {
    var a = Arena.empty();
    let w = new a[Wrap]((new a[Fin](1)).n + 1);
    expectInt(w.v, 2, "the construction made for an argument is made before the value, and is read");
    expectUInt(u64.from(a.finalizers()), 2, "both have a header");
  }
  expectInt(log, 21, "the Wrap, made last, died first");
}

// A value with a 'final' dies with the arena, newest first
fn dies() {
  var a = Arena.empty();
  new a[Fin](1);
  new a[Fin](2);
  let k = new a[Fin](3);
  expectUInt(u64.from(a.finalizers()), 3, "each Fin gets a header");
  expectInt(k.n, 3, "and is read through the reference");
}

// A list in an arena, its block from the region it is handed
fn listInArena() {
  var c = newCounting();
  {
    var a = Arena.empty();
    let l = new a[List[i64]](50usize, regionOf(&mut c));
    tally(&c, 1, 0, 400, "the list's block, 50 slots, comes from the region");
    expectUInt(u64.from(a.finalizers()), 1, "the list in the arena has a finalizer header");
    var i = 0i64;
    while i < 50i64 { l.push(i); i = i + 1i64; }
    expectInt(*l[49usize], 49, "fifty values fit and are read back");
    tally(&c, 1, 0, 400, "without a second block");
  }
  tally(&c, 1, 1, 0, "the arena's death gave the block back");
}

// A struct that holds lists passes the region on to them
fn composition() {
  var c = newCounting();
  {
    let m = new Mesh(50usize, regionOf(&mut c));
    tally(&c, 2, 0, 400, "a Mesh's two lists come from the region it was handed");
    expect(m.region as usize == regionOf(&mut c) as usize, "and it keeps the region");
  }
  tally(&c, 2, 2, 0, "both were given back when it died");
  {
    var a = Arena.empty();
    let m = new a[Mesh](50usize, regionOf(&mut c));
    tally(&c, 4, 2, 400, "a Mesh in an arena draws its lists from the region it was handed");
    m.pts.push(1.5f32);
    m.ids.push(7u32);
    expectUInt(u64.from(m.pts.len()), 1, "and is changed through the reference");
  }
  tally(&c, 4, 4, 0, "the arena's death gave both lists' blocks back");
  var b = Arena.empty();
  let n = new b[Mesh](5usize);
  expect(n.region as usize == b.region as usize, "a Mesh made in an arena with no region is handed the arena's");
  let o = new Mesh(5usize);
  expect(o.region as usize == heapRegion() as usize, "and out of one");
}

// Nodes of a dynamic arena holding each other's keys
struct Node['=a] {
  pub val i64;
  pub next Option[&'=a mut Node['=a]];
}

// n nodes allocated into the arena it is lent, each holding the key of the one
// before it; the last made comes back
fn chain(ar &mut DynArena['=a], n i64) Option[&'=a mut Node['=a]] {
  var head Option[&'=a mut Node['=a]] = None[&'=a mut Node['=a]];
  var i = 0i64;
  while i < n {
    head = Some(new ar[Node](i, head));
    i = i + 1;
  }
  head
}

fn total(ar &DynArena['=a], first Option[&'=a mut Node['=a]]) i64 {
  var sum = 0i64;
  var at = first;
  while {
    match at {
      case let s Some[&'=a mut Node['=a]] {
        sum = sum + ar[s].val;
        at = ar[s].next;
      }
      else { break; }
    }
  }
  sum
}

fn keys() {
  var d = DynArena.empty();
  let k = new d[Pt](3, 4);
  expectInt(d[k].sum(), 7, "new d[Pt](3, 4) answers a key, read through the arena");
  d[k].x = 30;
  expectInt(d[k].x, 30, "and written through it");
  let j = new d[mut, Pt](5, 6);
  expectInt(d[j].y, 6, "the permission may be written here too");
  let first = chain(&mut d, 4);
  expectInt(total(&d, first), 6, "a chain of four nodes built with new ar[Node](i, head) sums 3 + 2 + 1 + 0");
}

fn main() {
  plain();
  log = 0;
  dies();
  expectInt(log, 321, "the values with a 'final' died newest first");
  inplace();
  argsFirst();
  listInArena();
  composition();
  keys();
  done();
}
