// An arena is a region: a growable collection made in one, 'new a[List[i32]](16)',
// has its four words in the arena AND its block there, and the arena is what
// grows the block. Every expected value is worked out by hand from the arena's
// rules:
// - allocate bumps; resize grows a block IN PLACE when it is the last thing the
//   arena allocated and the room is there; otherwise it bumps a new block (twice
//   the size asked, when the arena's current block has no room for it), copies the
//   values and abandons the old one (arenas leak by design); release does nothing;
// - a value made with 'new a[T](...)' is built where it stays, so what its
//   construction allocates in the arena (a list's block) lies after it;
// - a List[i32] has its block of 4 values first, then doubles (4, 8, ... 256), so
//   pushing 200 values grows the block six times after the first allocation. The
//   list's four words (and a finalizer header, since a list has a 'final') come
//   first in the arena, so after them the list's block is the last thing
//   allocated and grows in place, while nothing else is allocated, as long as
//   the 4096-byte block the arena bumps through has the room: the biggest block
//   here, 256 values of 4 bytes, is 1024;
// - two lists pushed in turn each have the other's block last when they grow,
//   so every growth after the first block copies: six growths each, twelve
//   copies, and the abandoned blocks stay until the arena dies (1008 bytes of
//   blocks left behind by each list: 16 + 32 + 64 + 128 + 256 + 512), so the
//   two lists' blocks and words, 2 * 2032 + 2 * 48 = 4160 bytes, need a
//   second 4096-byte block;
// - a List[String] in an arena holds strings from another region (here a counting
//   one standing for the heap); the arena's death runs the list's 'final', which
//   gives every string back to where it came from, while the arena frees the list's
//   own block with the rest.

mod inarena;

import testing use *;
import arena use *;
import collections use *;
import libc;

// A counting region: its header first, then the tallies
struct Counting {
  header: MemRegion;
  allocs: usize;
  releases: usize;
  live: isize;
}

fn countAlloc(r: *MemRegion, bytes: usize, align: usize) *u8 {
  let c = r as *Counting;
  (*c).allocs = (*c).allocs + 1usize;
  (*c).live = (*c).live + isize.from(bytes);
  libc.malloc(bytes)
}

fn countResize(r: *MemRegion, block: *u8, oldBytes: usize, newBytes: usize, align: usize) *u8 {
  let c = r as *Counting;
  (*c).live = (*c).live + isize.from(newBytes) - isize.from(oldBytes);
  libc.realloc(block, newBytes)
}

fn countRelease(r: *MemRegion, block: *u8, bytes: usize) {
  if block as usize == 0usize { return; }
  let c = r as *Counting;
  (*c).releases = (*c).releases + 1usize;
  (*c).live = (*c).live - isize.from(bytes);
  libc.free(block);
}

fn countSize(r: *MemRegion, bytes: usize, align: usize) usize { bytes }

fn newCounting() Counting {
  Counting(MemRegion(&countAlloc, &countResize, &countRelease, &countSize), 0usize, 0usize, 0isize)
}

fn regionOf(c: &mut Counting) *MemRegion { (c as *Counting) as *MemRegion }

fn tally(c: &Counting, allocs: u64, releases: u64, live: i64, label: &Array[u8]) {
  let ok = u64.from(c.allocs) == allocs && u64.from(c.releases) == releases && i64.from(c.live) == live;
  expect(ok, label);
}

// A struct holding two lists, made in a region it hands to both
struct Mesh is CarriesRegion {
  pub pts: List[f32];
  pub ids: List[u32];
  pub region: *MemRegion;

  pub fn init(self: &new, n: usize, region: *MemRegion) {
    *self = Mesh(pts: List[f32](n, region), ids: List[u32](n, region), region: region);
  }
}

// Where the list's block is
fn at(l: &List[i32]) usize { (l[0usize] as *i32) as usize }

// A list alone in its arena, made empty: its block is asked for when the first
// value arrives, after the list's own words, so it is the last thing allocated
// and every growth is in place
fn lone() {
  var a = Arena.empty();
  let l = new a[List[i32]]();
  expectUInt(u64.from(a.finalizers()), 1, "the list in the arena has a finalizer header");
  expectUInt(u64.from(l.capacity()), 0, "an empty list has no block");
  l.push(0);
  var moves = 0u64;
  var last = at(l);
  var i = 1;
  while i < 200 {
    l.push(i);
    if at(l) != last { moves = moves + 1u64; last = at(l); }
    i = i + 1;
  }
  expectUInt(moves, 0, "a list alone in its arena grew in place at every one of its six doublings");
  expectUInt(u64.from(l.len()), 200, "all two hundred are there");
  expectInt(*l[0usize], 0, "the first is as pushed");
  expectInt(*l[199usize], 199, "and the last");
  expectUInt(u64.from(a.blockCount()), 1, "and the arena still has its one block");
}

// With a starting size, 'new a[List[i32]](16)': the list is built where it
// stays, so its words are placed first and its block of 16 is allocated after
// them. The block is the last thing allocated, and every growth is in place
fn sized() {
  var a = Arena.empty();
  let l = new a[List[i32]](16usize);
  expectUInt(u64.from(l.capacity()), 16, "the starting size is a block of 16");
  var i = 0;
  while i < 16 { l.push(i); i = i + 1; }
  let start = at(l);
  while i < 200 { l.push(i); i = i + 1; }
  expect(at(l) == start, "the block grew in place at each of its four doublings, the list's words coming before it");
  expectInt(*l[0usize], 0, "the first value is as pushed");
  expectInt(*l[199usize], 199, "and the last");
  expectUInt(u64.from(a.blockCount()), 1, "and the arena still has its one block");
}

// A lone list pushed far past the arena's first block of 4096 bytes. A block
// taken because a resize outgrew the current one is twice the size asked, so a
// list that doubles finds the room for its next doubling where it is, and is
// copied once for every block it fills, not at every doubling. By hand: a
// List[i64] places 48 bytes (its four words and a finalizer header) and then its
// block, 32 bytes for 4 values, doubling. The block grows in place through 2048
// bytes (the first arena block has 4096 bytes after its own 8-byte header, 48 of
// them the list's, leaving 4048). At 4096 it no longer fits: a new block of 2 * (4096 + 8)
// = 8208 is taken and the list copied to it (move 1), and 8192 fits there. 16384
// takes a block of 32784 (move 2), and 32768 fits; 65536 takes 131088 (move 3),
// 131072 fits; 262144 takes 524304 (move 4), 524288 fits; 1048576 takes 2097168
// (move 5), which holds the list's last size, 131072 values, the capacity 100000
// need. So the arena has 6 blocks and the list moved 5 times (it moved 9 times,
// through 10 blocks, when a block was sized to the request)
fn grows() {
  var a = Arena.empty();
  let l = new a[List[i64]]();
  l.push(0i64);
  var last = (l[0usize] as *i64) as usize;
  var moves = 0u64;
  var i = 1i64;
  while i < 100000i64 {
    l.push(i);
    let now = (l[0usize] as *i64) as usize;
    if now != last { moves = moves + 1u64; last = now; }
    i = i + 1i64;
  }
  expectUInt(moves, 5, "the list moved once for each block it filled: five times");
  expectUInt(u64.from(a.blockCount()), 6, "through six blocks: the first, and one for each move");
  expectUInt(u64.from(l.capacity()), 131072, "its capacity doubled to 131072 values");
  expectInt(*l[0usize], 0, "the first value survived the moves");
  expectInt(*l[99999usize], 99999, "and the last is as pushed");
}

// Two lists pushed in turn: each growth finds the other's block last
fn interleaved() {
  var a = Arena.empty();
  let x = new a[List[i32]]();
  let y = new a[List[i32]]();
  var xmoves = 0u64;
  var ymoves = 0u64;
  var xat = 0usize;
  var yat = 0usize;
  var i = 0;
  while i < 200 {
    x.push(i);
    y.push(1000 + i);
    if i == 0 {
      xat = at(x);
      yat = at(y);
    }
    else {
      if at(x) != xat { xmoves = xmoves + 1u64; xat = at(x); }
      if at(y) != yat { ymoves = ymoves + 1u64; yat = at(y); }
    }
    i = i + 1;
  }
  expectUInt(xmoves, 6, "the first list moved at each of its six growths");
  expectUInt(ymoves, 6, "and so did the second");
  expectInt(*x[199usize], 199, "the first list's values were carried over");
  expectInt(*y[0usize], 1000, "and the second's");
  expectInt(*y[199usize], 1199, "all of them");
  expectUInt(u64.from(a.blockCount()), 2, "the abandoned blocks stay: the arena needed a second block of 4096");
}

// A list of strings from another region: the arena's death gives them back
fn strings() {
  var c = newCounting();
  {
    var a = Arena.empty();
    let l = new a[List[String]]();
    var i = 0;
    while i < 10 {
      var s = String(8usize, regionOf(&mut c));
      s.append("ab");
      l.push(s);
      i = i + 1;
    }
    tally(&c, 10, 0, 90, "ten strings came from the region (8 bytes and the NUL: 9 each)");
    expectUInt(u64.from(l.len()), 10, "the list holds all ten");
  }
  tally(&c, 10, 10, 0, "the arena's death finalized the list, which gave all ten strings back");
}

// A struct declaring CarriesRegion made in an arena, naming no region, draws
// its lists from the arena; one that names a region keeps that one
fn composition() {
  var a = Arena.empty();
  let m = new a[Mesh](8usize);
  expect(m.region as usize == a.region as usize, "a Mesh made in an arena is handed the arena's region");
  m.pts.push(1.5f32);
  m.ids.push(7u32);
  expectUInt(u64.from(m.pts.len()), 1, "and its lists work");
  var c = newCounting();
  let n = new a[Mesh](8usize, regionOf(&mut c));
  expect(n.region as usize == regionOf(&mut c) as usize, "one that names a region keeps it");
  let o = Mesh(8usize);
  expect(o.region as usize == heapRegion() as usize, "and one made outside an arena is the heap's");
}

// The region is the arena's own object: the Arena is moved with its lists in it
// and they still grow
struct Holder['=a] {
  pub ar: DynArena['=a];
  pub list: &'=a mut List[i32];
}

fn make() Holder['=a] {
  var d = DynArena.empty();
  let l = new d[List[i32]]();
  d[l].push(1);
  Holder(d, l)
}

fn moved() {
  var h = make();
  let k = h.list;
  let region = h.ar.region;
  var i = 2;
  while i < 300 { h.ar[k].push(i); i = i + 1; }
  expectUInt(u64.from(h.ar[k].len()), 299, "a list in an arena that was returned grew after the move");
  expectInt(*h.ar[k][298usize], 299, "with its values");
  expect(region as usize == h.ar.region as usize, "and the arena's region did not move");
}

// A DynArena is a region too
fn dynamic() {
  var d = DynArena.empty();
  let k = new d[List[i32]](4usize);
  var i = 0;
  while i < 50 { d[k].push(i); i = i + 1; }
  expectUInt(u64.from(d[k].len()), 50, "a list in a dynamic arena, reached by its key");
  expectInt(*d[k][49usize], 49, "grows");
}

fn main() {
  lone();
  sized();
  grows();
  interleaved();
  strings();
  composition();
  moved();
  dynamic();
  done();
}
