// A value asked of an arena that has a block, whose size added to the place
// it would start at wraps round a usize, panics. 'at + size <= limit' alone
// passes for a size near 2^64: 'bump' would hand back 'at' and set 'top' to a
// small number, and the caller, told it had that many bytes, would write far
// past the block. Here the size comes from a list in the arena that is asked
// to reserve nearly 2^64 bytes. The first line is written out before the
// call; the second would be written only if the program went on, and is not.
// The exit status is abort's on Windows, 0xC0000409.

mod bumpoverflow;

import stdio use *;
import arena use *;
import collections use *;
import libc;

fn main() i32 {
  var a = Arena();
  let l = new a[List[u8]]();
  printStr("asking\n");
  libc.fflush(libc.stdout());
  l.reserve(0usize - 100usize);
  printStr("went on\n");
  libc.fflush(libc.stdout());
  0
}
