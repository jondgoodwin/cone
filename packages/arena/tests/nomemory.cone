// An arena whose block the C library cannot allocate ends the program, at the
// allocation, through the C library's 'abort': the arena's panic. The block
// asked for here is 2^60 bytes, more than any machine this runs on can give,
// so 'malloc' returns null. The first line is written out before the arena is
// asked; the second would be written only if the program went on, and is not.
// The exit status is abort's on Windows, 0xC0000409 (a fail-fast exit).

mod nomemory;

import stdio use *;
import arena use *;
import libc;

fn main() i32 {
  printStr("asking\n");
  libc.fflush(libc.stdout());
  imm a = Arena.withRoom(1152921504606846976usize);
  printStr("went on\n");
  libc.fflush(libc.stdout());
  0;
}
