// The compiler's finalizing gaps, as an arena meets them. An arena finalizes a
// value with 'mem.finalize', the death the compiler builds for its type, so
// what the compiler does not finalize, the arena does not either -- nor does
// the same value die any better on the stack. Every check here pins what
// happens TODAY, which is wrong, and says so in its label: when the compiler
// closes a gap, the check fails, and the right value is the one in the comment
// above it.

mod gaps;

import testing use *;
import arena use *;

mut log = 0i64;
fn note(d i64) { log = log * 10i64 + d; }

struct Fin {
  pub n i64;
  fn final(self &uni) { note(n); }
}

// Right: 12, the value assigned over finalized when it is replaced
fn overwrite() {
  mut a = Arena.empty();
  imm r = a.alloc(Fin[1]);
  *r = Fin[2];
}

fn main() i32 {
  overwrite();
  expectInt(log, 2, "compiler gap: assigning through a reference does not finalize what it replaces");
  done();
}
