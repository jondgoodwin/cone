// A block that is the last thing an arena allocated, asked to grow to a size
// that added to its place wraps round a usize, panics. 'at + newBytes <=
// limit' alone passes for a size near 2^64, so 'resize' would "grow" the block
// in place and set 'top' backwards, and the caller would write far past the
// block. The first line is written out before the call; the second would be
// written only if the program went on, and is not. The exit status is abort's
// on Windows, 0xC0000409.

mod resizeoverflow;

import stdio use *;
import arena use *;
import collections use *;
import libc;

fn main() i32 {
  var a = Arena();
  let l = new a[List[u8]]();
  l.push(1u8);
  printStr("asking\n");
  libc.fflush(libc.stdout());
  l.reserve(0usize - 100usize);
  printStr("went on\n");
  libc.fflush(libc.stdout());
  0
}
