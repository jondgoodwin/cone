// An arena asked for a block whose size, with its header, does not fit in a
// usize ends the program before asking the C library for it. Asking would
// wrap the size round to a few bytes, which 'malloc' would give, and the arena
// would then write far past them. The exit status is abort's on Windows,
// 0xC0000409, as tests/nomemory.cone's.

mod overflow;

import stdio use *;
import arena use *;
import libc;

fn main() i32 {
  printStr("asking\n");
  libc.fflush(libc.stdout());
  imm a = Arena.withRoom(0usize - 1usize);
  printStr("went on\n");
  libc.fflush(libc.stdout());
  0;
}
