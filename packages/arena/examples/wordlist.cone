// A linked list of words built in an arena: every node and every word's
// String lives until the arena dies, which frees each String's own block (its
// 'final') and then the arena's blocks, all at once. Run it with
//   congo run packages/arena/examples/wordlist.cone

mod wordlist;

import stdio use *;
import arena use *;
import collections use *;

struct Word {
  pub text String;
  pub next *Word;
}

fn main() {
  mut a = Arena.empty();
  mut head = 0usize as *Word;
  imm text = String.from("the arena frees them all at once");
  imm parts = text.split(' ');
  mut i = parts.len();
  while i > 0usize {
    i = i - 1usize;
    imm w = a.alloc(Word[parts[i].copy(), head]);
    head = w as *Word;
  }
  mut at = head;
  while at as usize != 0usize {
    imm w = at as &Word;
    printStr(w.text.view());
    printStr("\n");
    at = w.next;
  }
  printStr("headers: ");
  printUInt(u64[a.finalizers()]);
  printStr(", blocks: ");
  printUInt(u64[a.blockCount()]);
  printStr("\n");
}
