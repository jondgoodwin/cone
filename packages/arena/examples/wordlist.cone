// A linked list of words built in an arena: every node and every word's
// String lives until the arena dies, which frees each String's own block (its
// 'final') and then the arena's blocks, all at once. Run it with
//   congo run packages/arena/examples/wordlist.cone

mod wordlist;

import stdio use *;
import arena use *;
import collections use *;

struct Word {
  pub text: String;
  pub next: *Word;
}

fn main() {
  var a = Arena.empty();
  var head: *Word = null;
  let text = String.from("the arena frees them all at once");
  let parts = text.split(' ');
  var i = parts.len();
  while i > 0usize {
    i = i - 1usize;
    let w = a.alloc(Word(parts[i].copy(), head));
    head = w as *Word;
  }
  var at = head;
  while at as usize != 0usize {
    let w = at as &Word;
    printStr(w.text.view());
    printStr("\n");
    at = w.next;
  }
  printStr("headers: ");
  printUInt(u64.from(a.finalizers()));
  printStr(", blocks: ");
  printUInt(u64.from(a.blockCount()));
  printStr("\n");
}
