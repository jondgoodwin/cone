// ======== Sample patterns, as text ========
//
// The garments of the demo, each a few hundred bytes. They are written for bonepose's 19-bone figure of 1.75 m (lengths
// in metres); another height or another body wants other numbers, not other code. Panel `x` runs to the viewer's right
// and `y` down; a panel's top is at its `shift` down the axis from the first bone's joint. Each is a multi-line string
// literal: its lines are the text, each ending in a new-line.

// A peasant's tunic: a body that is a tube, snug at the chest, bagging a little over a belt at the waist, then a skirt
// that flares to the knee; sewn up its side. The arms are not in it: it has armholes.
pub fn tunicBody() &str {
  "
  garment tunic layer 0
  fabric density 0.30 stretch 2e-6 shear 2e-5 bend 150 thick 0.006 damping 0.8 air 1.2
  sees ignore clavicle_l clavicle_r
  panel body grid 22 18 axis neck pelvis shift 0.10 face front arc 360 gap 0.012 flare 0.15 minr 0.05 reach 0.20
  top line 0 0 1.36 0 28
  bottom line -0.26 0.80 1.62 0.80 28
  left poly 0 0  0.04 0.40  -0.26 0.80
  right poly 1.36 0  1.32 0.40  1.62 0.80
  loose 0 0  0.22 0  0.36 0.9  0.5 1  1 1
  seam body.left body.right
  ";
}

// Its sleeves: full tubes from the shoulder to the wrist, tight at the shoulder, loose in the middle, gathered to a
// cuff at the wrist
pub fn tunicSleeves() &str {
  "
  garment tunic_sleeves layer 0
  fabric density 0.28 stretch 2e-6 shear 2e-5 bend 150 thick 0.006 damping 0.8 air 1.2
  sees only upper_arm_l upper_arm_r
  panel sleeve_l grid 16 12 axis upper_arm_l hand_l shift -0.02 face left arc 360 gap 0.012 flare 0 minr 0.03 reach 0.14
  top line 0 0 0.68 0 20
  bottom line 0.04 0.62 0.60 0.62 20
  left line 0 0 0.04 0.62 16
  right line 0.68 0 0.60 0.62 16
  loose 0 0  0.12 0  0.30 0.9  0.75 1  0.92 0.35  1 0
  seam sleeve_l.left sleeve_l.right
  panel sleeve_r grid 16 12 axis upper_arm_r hand_r shift -0.02 face right arc 360 gap 0.012 flare 0 minr 0.03 reach 0.14
  top line 0 0 0.68 0 20
  bottom line 0.04 0.62 0.60 0.62 20
  left line 0 0 0.04 0.62 16
  right line 0.68 0 0.60 0.62 16
  loose 0 0  0.12 0  0.30 0.9  0.75 1  0.92 0.35  1 0
  seam sleeve_r.left sleeve_r.right
  ";
}

// An apron: a half-wrap of cloth over the front, held at the chest by a neck loop, tied at the waist, free below
pub fn apron() &str {
  "
  garment apron layer 1
  fabric density 0.35 stretch 2e-6 shear 2e-5 bend 120 thick 0.007 damping 3 air 1.2
  sees ignore clavicle_l clavicle_r
  panel apron grid 14 16 axis neck pelvis shift 0.17 face front arc 112 gap 0.016 flare 0.05 minr 0.05 reach 0.22
  top line 0.20 0 0.54 0 16
  bottom line 0.04 0.80 0.70 0.80 16
  left poly 0.20 0  0.18 0.34  0.04 0.80
  right poly 0.54 0  0.56 0.34  0.70 0.80
  loose 0 0  0.08 0  0.2 0.85  1 1
  ";
}

// A long coat: a body that wraps nearly round and is open at the front, fitted at the shoulders and chest, a long skirt
// from the waist
pub fn longCoat() &str {
  "
  garment coat layer 2
  fabric density 0.55 stretch 2e-6 shear 2e-5 bend 100 thick 0.009 damping 1.0 air 1.2
  sees ignore clavicle_l clavicle_r
  panel coat grid 26 22 axis neck pelvis shift 0.08 face back arc 335 gap 0.020 flare 0.20 minr 0.06 reach 0.30
  top line 0 0 1.25 0 32
  bottom line -0.30 1.10 1.90 1.10 32
  left line 0 0 -0.30 1.10 30
  right line 1.25 0 1.90 1.10 30
  loose 0 0  0.22 0  0.36 0.5  0.46 0.9  0.7 1  1 1
  ";
}

// Its sleeves
pub fn coatSleeves() &str {
  "
  garment coat_sleeves layer 2
  fabric density 0.50 stretch 2e-6 shear 2e-5 bend 100 thick 0.009 damping 1.0 air 1.2
  sees only upper_arm_l upper_arm_r
  panel sleeve_l grid 16 12 axis upper_arm_l hand_l shift -0.03 face left arc 360 gap 0.022 flare 0 minr 0.03 reach 0.12
  top line 0 0 0.76 0 20
  bottom line 0.06 0.64 0.66 0.64 20
  left line 0 0 0.06 0.64 16
  right line 0.76 0 0.66 0.64 16
  loose 0 0  0.12 0  0.30 0.8  0.8 1  0.95 0.5  1 0.2
  seam sleeve_l.left sleeve_l.right
  panel sleeve_r grid 16 12 axis upper_arm_r hand_r shift -0.03 face right arc 360 gap 0.022 flare 0 minr 0.03 reach 0.12
  top line 0 0 0.76 0 20
  bottom line 0.06 0.64 0.66 0.64 20
  left line 0 0 0.06 0.64 16
  right line 0.76 0 0.66 0.64 16
  loose 0 0  0.12 0  0.30 0.8  0.8 1  0.95 0.5  1 0.2
  seam sleeve_r.left sleeve_r.right
  ";
}

// A cape: a half circle of cloth hung from a neckline, fitted at the throat and free below
pub fn cape() &str {
  "
  garment cape layer 3
  fabric density 0.45 stretch 2e-6 shear 2e-5 bend 60 thick 0.008 damping 0.7 air 1.2
  panel cape grid 24 20 axis neck pelvis shift -0.02 face back arc 250 gap 0.030 flare 0.35 minr 0.08 reach 0.60
  top arc 0 0 0.27 215 -35 30
  bottom arc 0 0 1.10 215 -35 30
  left line -0.22117 -0.15486 -0.90107 -0.63093 26
  right line 0.22117 -0.15486 0.90107 -0.63093 26
  loose 0 0  0.06 0  0.22 0.8  0.5 1  1 1
  ";
}
