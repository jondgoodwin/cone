// ======== Shell garments: a worn surface generated from the body's own shape ========
//
// The second way to define a garment (the first is a sewing pattern, pattern.cone): no cloth is cut, a SHELL is made
// from the body. The method is production cloth's "shrinkwrap offset" (Blender's Solidify/Displace-along-normals,
// Marvelous' "fit to avatar"): pick the region of the body's mesh the garment covers, push its vertices out along the
// body's normals by the ease and the thickness of whatever is beneath, smooth the displacement over the surface so the
// offset does not fold in concave places (an armpit), and give each vertex the skin weights of the body vertex it came
// from. The result is a skinned mesh in the body's own bind pose: it moves exactly as the body does, with no simulation
// at all, which is right for what is tight (a shirt, a waistcoat, breeches, gloves).
//
// The region is data: the bones whose weights pick the vertices (a vertex whose weight on the listed bones is over
// `minWeight` is in), and cuts, planes in the bind pose that keep the side their normal points to (a hem, a cuff).
// Because the shell takes the body's vertices and weights, it works for any skin: nothing in it is a humanoid.
//
// A shell is drawn by GPU skinning (render's `addSkinnedMesh` and `DrawList.addSkinned`, with the rig's skinning
// matrices), or CPU-posed (`Shell.pose`, the same sums as skinning.slang) when it must be a surface other layers collide
// with or be drawn by a pipeline that does not skin.

// A plane that keeps the side its normal points to
pub struct Cut {
  pub point Vec3;
  pub normal Vec3;
}

pub struct ShellSpec {
  pub name String;
  pub layer u32 = 0u32;
  pub bones List[usize];         // the bones whose weight picks the region
  pub minWeight f32 = 0.5;       // a vertex with at least this much weight on them is in
  pub cuts List[Cut];
  pub ease f32 = 0.004;          // how far it stands off the body, or off the layer beneath (metres)
  pub thickness f32 = 0.004;     // the cloth's thickness: what the layers over it must clear
  pub smooth u32 = 3u32;         // passes of smoothing the offset over the surface

  pub fn make(name &str) ShellSpec {
    new ShellSpec(String.from(name), 0u32, List[usize].empty(), 0.5, List[Cut].empty(), 0.004, 0.004, 3u32)
  }
}

pub struct Shell {
  pub name String;
  pub layer u32;
  pub thickness f32;
  pub mesh Mesh;                 // the bind pose: the body's surface offset
  pub skin Skin;                 // render's skin: four joints and weights a vertex
  pub source List[u32];          // the body vertex each shell vertex came from
  pub posed List[Vec3];          // the vertices as the last `pose` left them

  pub fn empty() Shell {
    new Shell(String.empty(), 0u32, 0.004, Mesh.empty(), Skin.empty(), List[u32].empty(), List[Vec3].empty())
  }

  pub fn vertexCount(self &) usize { mesh.positions.len() }

  // The vertices posed under the skinning matrices into `posed` (CPU linear blend skinning, skinning.slang's sums)
  pub fn pose(self &mut, matrices &List[Mat4]) {
    posed.clear();
    var v = 0usize;
    while v < mesh.positions.len() {
      posed.push(skin.skinPoint(v, matrices.view(), *mesh.positions[v]));
      v = v + 1usize;
    }
  }
}

// The shell `spec` describes, worn on `rig` over `beneath` metres of whatever is already on the body
pub fn buildShell(spec &ShellSpec, rig &BodyRig, beneath f32) Shell {
  let body = &rig.mesh;
  let nv = body.positions.len();
  // 1. the region
  var remap = List[u32].empty();
  var picked = List[u32].empty();
  var v = 0usize;
  while v < nv {
    var w = 0.;
    var k = 0usize;
    while k < 4usize {
      let j = rig.skin.joint(v, k);
      var c = 0usize;
      while c < spec.bones.len() { if *spec.bones[c] == j { w = w + rig.skin.weight(v, k); } c = c + 1usize; }
      k = k + 1usize;
    }
    var keep = w >= spec.minWeight;
    var c = 0usize;
    while keep and c < spec.cuts.len() {
      if (*body.positions[v] - spec.cuts[c].point).dot(spec.cuts[c].normal) < 0. { keep = false; }
      c = c + 1usize;
    }
    if keep {
      remap.push(u32.from(picked.len()));
      picked.push(u32.from(v));
    } else {
      remap.push(0xFFFFFFFFu32);
    }
    v = v + 1usize;
  }
  var out = Shell.empty();
  out.name = spec.name.copy();
  out.layer = spec.layer;
  out.thickness = spec.thickness;
  // 2. triangles whose three corners are in
  var t = 0usize;
  while t + 2usize < body.indices.len() {
    let a = *remap[usize.from(*body.indices[t])];
    let b = *remap[usize.from(*body.indices[t + 1usize])];
    let c = *remap[usize.from(*body.indices[t + 2usize])];
    if a != 0xFFFFFFFFu32 and b != 0xFFFFFFFFu32 and c != 0xFFFFFFFFu32 {
      out.mesh.indices.push(a); out.mesh.indices.push(b); out.mesh.indices.push(c);
    }
    t = t + 3usize;
  }
  // 3. the offset: along the body's normals, smoothed over the surface's edges
  let n = picked.len();
  var disp = List[Vec3].empty();
  let dist = beneath + spec.ease;
  var i = 0usize;
  while i < n {
    let src = usize.from(*picked[i]);
    disp.push(*body.normals[src] * dist);
    i = i + 1usize;
  }
  // adjacency by triangle edges: a CSR list of neighbours
  var degree = List[u32].empty();
  i = 0usize;
  while i <= n { degree.push(0u32); i = i + 1usize; }
  t = 0usize;
  while t + 2usize < out.mesh.indices.len() {
    var e = 0usize;
    while e < 3usize {
      let a = usize.from(*out.mesh.indices[t + e]);
      degree.set(a + 1usize, *degree[a + 1usize] + 2u32);
      e = e + 1usize;
    }
    t = t + 3usize;
  }
  i = 0usize;
  while i < n { degree.set(i + 1usize, *degree[i + 1usize] + *degree[i]); i = i + 1usize; }
  var fill = List[u32].empty();
  i = 0usize;
  while i < n { fill.push(*degree[i]); i = i + 1usize; }
  var nbr = List[u32].empty();
  i = 0usize;
  while i < usize.from(*degree[n]) { nbr.push(0u32); i = i + 1usize; }
  t = 0usize;
  while t + 2usize < out.mesh.indices.len() {
    var e = 0usize;
    while e < 3usize {
      let a = usize.from(*out.mesh.indices[t + e]);
      let b = *out.mesh.indices[t + (e + 1usize) % 3usize];
      let c = *out.mesh.indices[t + (e + 2usize) % 3usize];
      nbr.set(usize.from(*fill[a]), b);
      nbr.set(usize.from(*fill[a]) + 1usize, c);
      fill.set(a, *fill[a] + 2u32);
      e = e + 1usize;
    }
    t = t + 3usize;
  }
  var pass = 0u32;
  while pass < spec.smooth {
    var next = List[Vec3].empty();
    i = 0usize;
    while i < n {
      let lo = usize.from(*degree[i]);
      let hi = usize.from(*degree[i + 1usize]);
      if hi > lo {
        var sum = new Vec3(0., 0., 0.);
        var k = lo;
        while k < hi { sum = sum + *disp[usize.from(*nbr[k])]; k = k + 1usize; }
        next.push((*disp[i] + sum * (1. / f32.from(hi - lo))) * 0.5);
      } else {
        next.push(*disp[i]);
      }
      i = i + 1usize;
    }
    disp = next;
    pass = pass + 1u32;
  }
  // 4. the vertices, uvs and skin
  i = 0usize;
  while i < n {
    let src = usize.from(*picked[i]);
    out.mesh.positions.push(*body.positions[src] + *disp[i]);
    out.mesh.uvs.push(*body.uvs[src]);
    out.source.push(*picked[i]);
    var j = [0u32, 0u32, 0u32, 0u32];
    var w = [0.f, 0., 0., 0.];
    var k = 0usize;
    while k < 4usize {
      j[k] = u32.from(rig.skin.joint(src, k));
      w[k] = rig.skin.weight(src, k);
      k = k + 1usize;
    }
    out.skin.push(j[0], j[1], j[2], j[3], w[0], w[1], w[2], w[3]);
    i = i + 1usize;
  }
  out.mesh.computeSmoothNormals();
  out
}
