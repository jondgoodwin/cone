// ======== A garment as a sewing pattern: flat panels, the seams that join them, and where each sits on a body ========
//
// THE METHOD, in tailor's terms and the cloth literature's:
//
// - A PANEL is a piece of cut cloth: a flat 2-D shape (x to the viewer's right, y down, metres) bounded by four edges,
//   each a polyline. The surface inside is the BILINEARLY BLENDED COONS PATCH of the edges (Coons 1967): the point at
//   (u, v) is the blend of the top and bottom edges along v, of the left and right along u, less the bilinear patch of
//   the four corners. Any shape four curves bound is meshed: a rectangle, a trapezoid, a sleeve with a curved cap, the
//   annular sector of a circle cape. The grid is nu x nv cells of two triangles.
// - A SEAM stitches an edge of one panel to an edge of another (or of itself: the seam of a tube). Stitched vertices
//   become one particle, so the garment is one connected cloth, and the cloth's rest lengths are the FLAT lengths
//   of the pattern. That is what makes a pattern a fit: a panel wider than the body's girth hangs in folds (ease), a
//   narrower one is held at the body and strains.
// - A PLACEMENT says where the flat panel starts on the body: along an AXIS (from one bone's joint to another's), a
//   distance down it, facing a direction, reaching so far round it. The panel is wrapped on the body's collision proxy
//   by marching out from the axis to the proxy's surface (plus a gap); where the panel hangs below the body it flares
//   at a given rate. The wrap is only the starting shape: the DRAPE (drape.cone) lets the cloth settle.
// - LOOSENESS is data on a panel: how far down it (v, 0 to 1) the cloth is tight to the body (0) or free (1). A tight
//   place is skinned to the bones; a free one is simulated; between the two is a spring-and-limit blend (hybrid.cone).
//
// A pattern is the same thing as text (parse.cone), so a garment is a few hundred bytes of description.

// The four edges of a panel, as 'Edge' numbers. Top and bottom run left to right, left and right run top to bottom.
pub const EDGE_TOP = 0u32;
pub const EDGE_BOTTOM = 1u32;
pub const EDGE_LEFT = 2u32;
pub const EDGE_RIGHT = 3u32;

// Where a panel starts on a body
pub struct Placement {
  pub axisFrom usize = 0usize;   // the axis starts at this bone's joint
  pub axisTo usize = 0usize;     // and runs to this one's; the panel's y runs down it
  pub shift f32 = 0.;            // the panel's top edge starts this far down the axis from its start (metres)
  pub face Vec3 = new Vec3(0., 0., -1.);   // the way the panel's middle faces (bind pose model space)
  pub arc f32 = 3.14159;         // how far round the axis the panel reaches (radians); 2 pi: a tube
  pub gap f32 = 0.01;            // clearance over the body's proxy at the tight places
  pub flare f32 = 0.3;           // metres of radius gained a metre down, where the panel hangs clear of the body
  pub minRadius f32 = 0.03;      // never nearer the axis than this
}

pub struct Panel {
  pub name String;
  pub top List[Vec2];
  pub bottom List[Vec2];
  pub left List[Vec2];
  pub right List[Vec2];
  pub nu u32 = 12u32;            // cells across and down
  pub nv u32 = 12u32;
  pub place Placement;
  pub loose List[Vec2];          // looseness against v: (v, looseness) pairs, piecewise linear; none: tight
  pub looseU List[Vec2];         // and against u (across): the looseness is the larger of the two (a blanket tight along the spine)
  pub reach f32 = 0.25;          // how far a fully loose place may stray from where the skin would put it (metres)
}

// An edge of one panel stitched to an edge of another
pub struct Seam {
  pub panelA usize;
  pub edgeA u32;
  pub panelB usize;
  pub edgeB u32;
  pub reverse bool;              // the second edge is read from its far end
}

pub struct Pattern {
  pub name String;
  pub layer u32 = 0u32;          // 0: next to the body; each layer is worn over the one below
  pub density f32 = 0.25;        // kg per square metre
  pub stretch f32 = 2e-6;        // XPBD compliances (xpbdsoftbody's Fabric)
  pub shear f32 = 2e-5;
  pub bend f32 = 200.;
  pub thickness f32 = 0.006;     // the cloth's thickness: collisions, and how much it lifts what is worn over it
  pub damping f32 = 0.6;
  pub airDensity f32 = 1.2;      // 0: the wind does not move it
  pub panels List[Panel];
  pub seams List[Seam];
  // The bones the garment sees, for wrapping and for collisions: the subtrees of `only` (all, if none), less the subtrees
  // of `ignore`. A tunic's body ignores the arms (it has armholes); a sleeve sees only the arm.
  pub only List[usize];
  pub ignore List[usize];

  pub fn make(name &str) Pattern {
    new Pattern(String.from(name), 0u32, 0.25, 2e-6, 2e-5, 200., 0.006, 0.6, 1.2, List[Panel].empty(), List[Seam].empty(),
      List[usize].empty(), List[usize].empty());
  }

  // A panel added; its number
  pub fn addPanel(self &mut, p Panel) usize {
    panels.push(p);
    panels.len() - 1usize;
  }

  pub fn stitch(self &mut, a usize, ea u32, b usize, eb u32, reverse bool) {
    seams.push(new Seam(a, ea, b, eb, reverse));
  }

  pub fn panelCount(self &) usize { panels.len(); }

  // The panel called 'name', or -1
  pub fn find(self &, name &str) i32 {
    mut i = 0usize;
    while i < panels.len() {
      if panels[i].name.view() == name { return i32.from(i); }
      i = i + 1usize;
    }
    -1i32;
  }
}

pub fn newPanel(name &str, nu u32, nv u32) Panel {
  new Panel(String.from(name), List[Vec2].empty(), List[Vec2].empty(), List[Vec2].empty(), List[Vec2].empty(), nu, nv,
    new Placement(0usize, 0usize, 0., new Vec3(0., 0., -1.), 3.14159, 0.01, 0.3, 0.03), List[Vec2].empty(), List[Vec2].empty(), 0.25);
}

// ---- edges ----

// The length of a polyline
pub fn edgeLength(pts &List[Vec2]) f32 {
  mut l = 0.;
  mut i = 1usize;
  while i < pts.len() { l = l + (*pts[i]).distance(*pts[i - 1usize]); i = i + 1usize; }
  l;
}

// The point a fraction 't' of the way along a polyline by length
pub fn edgeAt(pts &List[Vec2], total f32, t f32) Vec2 {
  if pts.len() == 0usize { return new Vec2(0., 0.); }
  if pts.len() == 1usize or total <= 1e-9 { return *pts[0usize]; }
  imm target = fclampf(t, 0., 1.) * total;
  mut run = 0.;
  mut i = 1usize;
  while i < pts.len() {
    imm seg = (*pts[i]).distance(*pts[i - 1usize]);
    if run + seg >= target or i + 1usize == pts.len() {
      imm k = if seg > 1e-12 { fclampf((target - run) / seg, 0., 1.); } else { 0.; };
      return (*pts[i - 1usize]).lerp(*pts[i], k);
    }
    run = run + seg;
    i = i + 1usize;
  }
  *pts[pts.len() - 1usize];
}

// An edge's points appended: a straight line from (x0, y0) to (x1, y1) of 'n' segments
pub fn addLine(edge &mut List[Vec2], x0 f32, y0 f32, x1 f32, y1 f32, n u32) {
  mut k = if edge.len() == 0usize { 0u32; } else { 1u32; };
  while k <= n {
    imm t = f32.from(k) / f32.from(n);
    edge.push(new Vec2(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t));
    k = k + 1u32;
  }
}

// An arc about (cx, cy) of radius r from angle a0 to a1 (degrees; 0 along +x, 90 down +y), n segments
pub fn addArc(edge &mut List[Vec2], cx f32, cy f32, r f32, a0 f32, a1 f32, n u32) {
  mut k = if edge.len() == 0usize { 0u32; } else { 1u32; };
  while k <= n {
    imm a = radians(a0 + (a1 - a0) * f32.from(k) / f32.from(n));
    edge.push(new Vec2(cx + r * cos(a), cy + r * sin(a)));
    k = k + 1u32;
  }
}

// A quadratic Bezier from (x0, y0) by the control point (cx, cy) to (x1, y1), n segments
pub fn addQuad(edge &mut List[Vec2], x0 f32, y0 f32, cx f32, cy f32, x1 f32, y1 f32, n u32) {
  mut k = if edge.len() == 0usize { 0u32; } else { 1u32; };
  while k <= n {
    imm t = f32.from(k) / f32.from(n);
    imm a = (1. - t) * (1. - t);
    imm b = 2. * (1. - t) * t;
    imm c = t * t;
    edge.push(new Vec2(a * x0 + b * cx + c * x1, a * y0 + b * cy + c * y1));
    k = k + 1u32;
  }
}

// A cubic Bezier from (x0, y0) by controls (ax, ay) and (bx, by) to (x1, y1), n segments
pub fn addCubic(edge &mut List[Vec2], x0 f32, y0 f32, c1x f32, c1y f32, c2x f32, c2y f32, x1 f32, y1 f32, n u32) {
  mut k = if edge.len() == 0usize { 0u32; } else { 1u32; };
  while k <= n {
    imm t = f32.from(k) / f32.from(n);
    imm s = 1. - t;
    imm c0 = s * s * s;
    imm c1 = 3. * s * s * t;
    imm c2 = 3. * s * t * t;
    imm c3 = t * t * t;
    edge.push(new Vec2(c0 * x0 + c1 * c1x + c2 * c2x + c3 * x1, c0 * y0 + c1 * c1y + c2 * c2y + c3 * y1));
    k = k + 1u32;
  }
}

// ---- the panel's surface ----

// A panel's flat grid: the (nu + 1) x (nv + 1) points of its Coons patch, row by row from the top
pub struct FlatGrid {
  pub pts List[Vec2];
  pub ok bool;
  pub why String;
}

// The edge resampled to 'n' + 1 points evenly by length
fn resample(pts &List[Vec2], n u32) List[Vec2] {
  imm total = edgeLength(pts);
  mut out = List[Vec2].empty();
  mut k = 0u32;
  while k <= n {
    out.push(edgeAt(pts, total, f32.from(k) / f32.from(n)));
    k = k + 1u32;
  }
  out;
}

pub fn flatGrid(p &Panel) FlatGrid {
  if p.top.len() < 2usize or p.bottom.len() < 2usize or p.left.len() < 2usize or p.right.len() < 2usize {
    return new FlatGrid(List[Vec2].empty(), false, String.from("a panel needs all four edges"));
  }
  imm t = resample(&p.top, p.nu);
  imm b = resample(&p.bottom, p.nu);
  imm l = resample(&p.left, p.nv);
  imm r = resample(&p.right, p.nv);
  imm p00 = *t[0usize];
  imm p10 = *t[usize.from(p.nu)];
  imm p01 = *b[0usize];
  imm p11 = *b[usize.from(p.nu)];
  // the corners must agree
  imm tol = 0.002;
  if p00.distance(*l[0usize]) > tol or p10.distance(*r[0usize]) > tol or p01.distance(*l[usize.from(p.nv)]) > tol
      or p11.distance(*r[usize.from(p.nv)]) > tol {
    return new FlatGrid(List[Vec2].empty(), false, String.from("a panel's edges do not meet at its corners"));
  }
  mut out = List[Vec2].empty();
  mut j = 0u32;
  while j <= p.nv {
    imm v = f32.from(j) / f32.from(p.nv);
    mut i = 0u32;
    while i <= p.nu {
      imm u = f32.from(i) / f32.from(p.nu);
      imm blend = *t[usize.from(i)] * (1. - v) + *b[usize.from(i)] * v + *l[usize.from(j)] * (1. - u) + *r[usize.from(j)] * u;
      imm corners = p00 * ((1. - u) * (1. - v)) + p10 * (u * (1. - v)) + p01 * ((1. - u) * v) + p11 * (u * v);
      out.push(blend - corners);
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  new FlatGrid(out, true, String.empty());
}

// The panel's looseness at 'v' (0 top, 1 bottom): its (v, value) pairs read piecewise linearly; flat beyond the ends;
// 0 if the panel gives none
pub fn looseAt(loose &List[Vec2], v f32) f32 {
  imm n = loose.len();
  if n == 0usize { return 0.; }
  if v <= (*loose[0usize]).x { return (*loose[0usize]).y; }
  mut i = 1usize;
  while i < n {
    imm a = *loose[i - 1usize];
    imm b = *loose[i];
    if v <= b.x {
      imm k = if b.x - a.x > 1e-9 { (v - a.x) / (b.x - a.x); } else { 1.; };
      return a.y + (b.y - a.y) * k;
    }
    i = i + 1usize;
  }
  (*loose[n - 1usize]).y;
}
