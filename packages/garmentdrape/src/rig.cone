// ======== The body a garment is worn on: a skeleton, a skinned mesh, and the proxies that cloth collides with ========
//
// ANY body: a bonepose Skeleton, a Mesh in its bind pose (positions, normals, uvs), and a render Skin (four joints and
// weights a vertex). Nothing here knows a humanoid from a quadruped; the 19-bone mannequin of bonepose is one
// skeleton, a creature rig's skeleton (creaturerig, not built on) another. What the rig derives from them:
//
// - the bind pose's model transforms and their inverses, so that a pose's models give the SKINNING MATRICES
//   (posed bone * inverse bind), the matrices render's skinning.slang and 'Skin.skinPoint' use;
// - the COLLISION PROXY: for each bone, a capsule or an oriented box fitted to the vertices that bone owns.
//   This is the physics-asset method (Unreal's PhAT "generate bodies" does it): gather the vertices skinned mostly to
//   the bone, find their principal axes (the eigenvectors of their covariance, Jacobi's method, Golub and Van Loan,
//   "Matrix Computations", 8.5), measure the extents along them, and take a capsule where the cross-section is round
//   (the second and third extents within 40%) and a box where it is not (a chest, a hip). Cloth collides with these
//   shapes as the body moves: they follow the bones, 15 to 25 shapes, cheap, and fitted to whatever mesh is given.

// The two shapes a proxy takes
pub const PROXY_CAPSULE = 1u32;
pub const PROXY_BOX = 2u32;

// One collision shape on a bone, in the bone's frame in the bind pose
pub struct Proxy {
  pub bone usize;
  pub kind u32;          // PROXY_CAPSULE or PROXY_BOX
  pub a Vec3;            // a capsule's start; a box's centre
  pub b Vec3;            // a capsule's end; a box's half extents
  pub radius f32;        // a capsule's radius
  pub rotation Quat;     // a box's orientation
}

// The signed distance from 'p' to a proxy posed by 'model' (the bone's model transform), negative inside; for a box
// outside, the distance to the box (exact); inside, the depth to the nearest face
pub fn proxyDistance(pr &Proxy, model &Transform3, p Vec3) f32 {
  if pr.kind == PROXY_CAPSULE {
    let a = model.transformPoint(pr.a);
    let b = model.transformPoint(pr.b);
    let ab = b - a;
    let l2 = ab.lengthSquared();
    var t = 0.f;
    if l2 > 1e-12 { t = fclampf((p - a).dot(ab) / l2, 0., 1.); }
    return (p - (a + ab * t)).length() - pr.radius;
  }
  let c = model.transformPoint(pr.a);
  let q = model.rotation * pr.rotation;
  let loc = q.conjugate() * (p - c);
  let dx = fabsf(loc.x) - pr.b.x;
  let dy = fabsf(loc.y) - pr.b.y;
  let dz = fabsf(loc.z) - pr.b.z;
  let ox = fmaxf(dx, 0.);
  let oy = fmaxf(dy, 0.);
  let oz = fmaxf(dz, 0.);
  let outside = (ox * ox + oy * oy + oz * oz).sqrt();
  outside + fminf(fmaxf(dx, fmaxf(dy, dz)), 0.)
}

// The three eigenvectors of a symmetric 3 x 3 matrix, longest first
struct Eigen3 {
  e1 Vec3;
  e2 Vec3;
  e3 Vec3;
}

// Jacobi's method on [c00 c01 c02; c01 c11 c12; c02 c12 c22]: rotate away the largest off-diagonal element until none is
// left; the columns of the product of the rotations are the eigenvectors
fn eigen3(c00 f32, c01 f32, c02 f32, c11 f32, c12 f32, c22 f32) Eigen3 {
  var a = [c00, c01, c02, c01, c11, c12, c02, c12, c22];
  var v = [1.f, 0., 0., 0., 1., 0., 0., 0., 1.];
  var sweep = 0;
  while sweep < 40 {
    sweep = sweep + 1;
    var p = 0usize;
    var q = 1usize;
    var big = fabsf(a[1]);
    if fabsf(a[2]) > big { p = 0usize; q = 2usize; big = fabsf(a[2]); }
    if fabsf(a[5]) > big { p = 1usize; q = 2usize; big = fabsf(a[5]); }
    if big < 1e-14 { sweep = 1000; continue; }
    let app = a[p * 3usize + p];
    let aqq = a[q * 3usize + q];
    let apq = a[p * 3usize + q];
    let theta = (aqq - app) / (2. * apq);
    let t = (if theta < 0. { -1. } else { 1. }) / (fabsf(theta) + (theta * theta + 1.).sqrt());
    let c = 1. / (t * t + 1.).sqrt();
    let s = t * c;
    // A' = J^T A J with J the rotation in the (p, q) plane
    var k = 0usize;
    while k < 3usize {
      let akp = a[k * 3usize + p];
      let akq = a[k * 3usize + q];
      a[k * 3usize + p] = c * akp - s * akq;
      a[k * 3usize + q] = s * akp + c * akq;
      k = k + 1usize;
    }
    k = 0usize;
    while k < 3usize {
      let apk = a[p * 3usize + k];
      let aqk = a[q * 3usize + k];
      a[p * 3usize + k] = c * apk - s * aqk;
      a[q * 3usize + k] = s * apk + c * aqk;
      k = k + 1usize;
    }
    k = 0usize;
    while k < 3usize {
      let vkp = v[k * 3usize + p];
      let vkq = v[k * 3usize + q];
      v[k * 3usize + p] = c * vkp - s * vkq;
      v[k * 3usize + q] = s * vkp + c * vkq;
      k = k + 1usize;
    }
  }
  // sort the columns by eigenvalue, largest first
  var order = [0usize, 1usize, 2usize];
  let d0 = a[0];
  let d1 = a[4];
  let d2 = a[8];
  if d1 > d0 and d1 >= d2 { order = [1usize, 0usize, 2usize]; }
  if d2 > d0 and d2 > d1 { order = [2usize, 0usize, 1usize]; }
  // the other two by eigenvalue
  let da = a[order[1] * 4usize];
  let db = a[order[2] * 4usize];
  if db > da { let t = order[1]; order[1] = order[2]; order[2] = t; }
  new Eigen3(
    new Vec3(v[order[0]], v[3usize + order[0]], v[6usize + order[0]]),
    new Vec3(v[order[1]], v[3usize + order[1]], v[6usize + order[1]]),
    new Vec3(v[order[2]], v[3usize + order[2]], v[6usize + order[2]]))
}

pub fn fabsf(a f32) f32 inline { libc.fabsf(a) }
pub fn fminf(a f32, b f32) f32 inline { if a < b { a } else { b } }
pub fn fmaxf(a f32, b f32) f32 inline { if a > b { a } else { b } }
pub fn fclampf(v f32, lo f32, hi f32) f32 inline { if v < lo { lo } elif v > hi { hi } else { v } }
pub fn smooth01(x f32) f32 { let t = fclampf(x, 0., 1.); t * t * (3. - 2. * t) }

// A body: skeleton, bind pose, skinned mesh and the proxies fitted to it
pub struct BodyRig {
  pub skeleton Skeleton;
  pub restModels List[Transform3];     // each bone's model transform in the bind pose
  pub bindInverse List[Mat4];          // and its inverse
  pub mesh Mesh;                       // the body as modelled (the bind pose)
  pub skin Skin;                       // four joints and weights a vertex of 'mesh'
  pub proxies List[Proxy];

  // A rig from a skeleton and a skinned mesh: the bind pose is the skeleton's rest pose
  pub fn make(skeleton Skeleton, mesh Mesh, skin Skin) BodyRig {
    var models = List[Transform3].empty();
    let rp = skeleton.restPose();
    skeleton.modelTransforms(&rp, &mut models);
    var inv = List[Mat4].empty();
    var i = 0usize;
    while i < models.len() {
      inv.push((*models[i]).toMat4().inverse());
      i = i + 1usize;
    }
    let proxies = fitProxies(&skeleton, &models, &mesh, &skin);
    new BodyRig(skeleton, models, inv, mesh, skin, proxies)
  }

  pub fn boneCount(self &) usize { skeleton.boneCount() }

  // The skinning matrices for a pose: bone models times the bind pose's inverses, one a bone
  pub fn skinMatrices(self &, models &List[Transform3], out &mut List[Mat4]) {
    out.clear();
    var i = 0usize;
    while i < models.len() {
      out.push((*models[i]).toMat4() * *bindInverse[i]);
      i = i + 1usize;
    }
  }

  // The colliders the proxies make in the world with the bones at 'models', each grown by 'inflate' metres
  // (a layer under it: the thickness of what is worn beneath)
  pub fn colliders(self &, models &List[Transform3], inflate f32, out &mut List[Collider]) {
    out.clear();
    var i = 0usize;
    while i < proxies.len() {
      let pr = *proxies[i];
      let m = *models[pr.bone];
      if pr.kind == PROXY_CAPSULE {
        out.push(Collider.capsule(m.transformPoint(pr.a), m.transformPoint(pr.b), pr.radius + inflate));
      } else {
        out.push(Collider.box(m.transformPoint(pr.a), pr.b + new Vec3(inflate, inflate, inflate), m.rotation * pr.rotation));
      }
      i = i + 1usize;
    }
  }

  // The signed distance from 'p' to the nearest proxy, the bones at 'models', grown by 'inflate'; negative inside
  pub fn distance(self &, models &List[Transform3], inflate f32, p Vec3) f32 {
    var best = 1e30f;
    var i = 0usize;
    while i < proxies.len() {
      let d = proxyDistance(&*proxies[i], &*models[(*proxies[i]).bone], p) - inflate;
      if d < best { best = d; }
      i = i + 1usize;
    }
    best
  }

  // The same, over the proxies of the bones that are `seen` only
  pub fn distanceSeen(self &, models &List[Transform3], inflate f32, seen &List[bool], p Vec3) f32 {
    var best = 1e30f;
    var i = 0usize;
    while i < proxies.len() {
      if *seen[(*proxies[i]).bone] {
        let d = proxyDistance(&*proxies[i], &*models[(*proxies[i]).bone], p) - inflate;
        if d < best { best = d; }
      }
      i = i + 1usize;
    }
    best
  }

  // The bones a garment sees: a bone and everything below it in the skeleton count together (a subtree). With `only`
  // given, just those subtrees; then `ignore`'s subtrees taken out. A bush jacket ignores the arms; a sleeve sees only
  // the arm.
  pub fn seenBones(self &, only &List[usize], ignore &List[usize]) List[bool] {
    var seen = List[bool].empty();
    let n = skeleton.boneCount();
    var b = 0usize;
    while b < n {
      seen.push(only.len() == 0usize or self.inSubtree(b, only));
      b = b + 1usize;
    }
    b = 0usize;
    while b < n {
      if ignore.len() > 0usize and self.inSubtree(b, ignore) { seen.set(b, false); }
      b = b + 1usize;
    }
    seen
  }

  // Whether bone `b` is one of `roots` or below one
  pub fn inSubtree(self &, b usize, roots &List[usize]) bool {
    var at = i32.from(b);
    while at >= 0i32 {
      var r = 0usize;
      while r < roots.len() { if usize.from(at) == *roots[r] { return true; } r = r + 1usize; }
      at = skeleton.parentOf(usize.from(at));
    }
    false
  }

  // The colliders of the bones that are seen only
  pub fn collidersSeen(self &, models &List[Transform3], inflate f32, seen &List[bool], out &mut List[Collider]) {
    out.clear();
    var i = 0usize;
    while i < proxies.len() {
      let pr = *proxies[i];
      if *seen[pr.bone] {
        let m = *models[pr.bone];
        if pr.kind == PROXY_CAPSULE {
          out.push(Collider.capsule(m.transformPoint(pr.a), m.transformPoint(pr.b), pr.radius + inflate));
        } else {
          out.push(Collider.box(m.transformPoint(pr.a), pr.b + new Vec3(inflate, inflate, inflate), m.rotation * pr.rotation));
        }
      }
      i = i + 1usize;
    }
  }

  // The colliders of the proxies numbered in `which` only (a garment's nearby ones)
  pub fn collidersFor(self &, models &List[Transform3], inflate f32, which &List[u32], out &mut List[Collider]) {
    out.clear();
    var k = 0usize;
    while k < which.len() {
      let pr = *proxies[usize.from(*which[k])];
      let m = *models[pr.bone];
      if pr.kind == PROXY_CAPSULE {
        out.push(Collider.capsule(m.transformPoint(pr.a), m.transformPoint(pr.b), pr.radius + inflate));
      } else {
        out.push(Collider.box(m.transformPoint(pr.a), pr.b + new Vec3(inflate, inflate, inflate), m.rotation * pr.rotation));
      }
      k = k + 1usize;
    }
  }

  // The proxies of the seen bones that come within `reach` metres of any of `points` (in the bind pose): the ones a
  // garment's particles can meet
  pub fn nearbyProxies(self &, seen &List[bool], points &List[Vec3], reach f32) List[u32] {
    var out = List[u32].empty();
    var i = 0usize;
    while i < proxies.len() {
      if *seen[(*proxies[i]).bone] {
        var near = false;
        var k = 0usize;
        while k < points.len() and !near {
          if proxyDistance(&*proxies[i], &*restModels[(*proxies[i]).bone], *points[k]) < reach { near = true; }
          k = k + 1usize;
        }
        if near { out.push(u32.from(i)); }
      }
      i = i + 1usize;
    }
    out
  }

  // A rough guide to the nearest bone at the bind pose, by distance to its segment (when a vertex has no
  // weights worth reading)
  pub fn skinnedPoint(self &, matrices &List[Mat4], v usize, p Vec3) Vec3 {
    skinPointBy(&skin, v, matrices, p)
  }
}

// Vertex 'v''s point 'p' under the skinning matrices: render's Skin does the sums
fn skinPointBy(skin &Skin, v usize, matrices &List[Mat4], p Vec3) Vec3 {
  skin.skinPoint(v, matrices.view(), p)
}

// ---- fitting the proxies ----

// A bone's cluster: the vertices it owns (a weight above 0.4 on the bone), in the bone's bind frame
fn fitProxies(skeleton &Skeleton, models &List[Transform3], mesh &Mesh, skin &Skin) List[Proxy] {
  var out = List[Proxy].empty();
  let nb = skeleton.boneCount();
  var b = 0usize;
  while b < nb {
    let inv = (*models[b]).inverse();
    var pts = List[Vec3].empty();
    var v = 0usize;
    while v < skin.len() {
      var w = 0.;
      var k = 0usize;
      while k < 4usize {
        if skin.joint(v, k) == b { w = w + skin.weight(v, k); }
        k = k + 1usize;
      }
      if w > 0.4 { pts.push(inv.transformPoint(*mesh.positions[v])); }
      v = v + 1usize;
    }
    if pts.len() >= 8usize {
      var mean = new Vec3(0., 0., 0.);
      var i = 0usize;
      while i < pts.len() { mean = mean + *pts[i]; i = i + 1usize; }
      mean = mean * (1. / f32.from(pts.len()));
      var c00 = 0.f; var c01 = 0.f; var c02 = 0.f; var c11 = 0.f; var c12 = 0.f; var c22 = 0.f;
      i = 0usize;
      while i < pts.len() {
        let d = *pts[i] - mean;
        c00 = c00 + d.x * d.x; c01 = c01 + d.x * d.y; c02 = c02 + d.x * d.z;
        c11 = c11 + d.y * d.y; c12 = c12 + d.y * d.z; c22 = c22 + d.z * d.z;
        i = i + 1usize;
      }
      let e = eigen3(c00, c01, c02, c11, c12, c22);
      // the extents along each axis
      var lo = [1e30f, 1e30, 1e30];
      var hi = [-1e30f, -1e30, -1e30];
      i = 0usize;
      while i < pts.len() {
        let d = *pts[i] - mean;
        let s1 = d.dot(e.e1);
        let s2 = d.dot(e.e2);
        let s3 = d.dot(e.e3);
        if s1 < lo[0] { lo[0] = s1; } if s1 > hi[0] { hi[0] = s1; }
        if s2 < lo[1] { lo[1] = s2; } if s2 > hi[1] { hi[1] = s2; }
        if s3 < lo[2] { lo[2] = s3; } if s3 > hi[2] { hi[2] = s3; }
        i = i + 1usize;
      }
      let axes = [e.e1, e.e2, e.e3];
      let mids = [(lo[0] + hi[0]) * 0.5, (lo[1] + hi[1]) * 0.5, (lo[2] + hi[2]) * 0.5];
      let halves = [(hi[0] - lo[0]) * 0.5, (hi[1] - lo[1]) * 0.5, (hi[2] - lo[2]) * 0.5];
      let centre = mean + axes[0] * mids[0] + axes[1] * mids[1] + axes[2] * mids[2];
      // the best capsule: along each principal axis in turn, the smallest radius that holds every point (the largest
      // distance from the axis line), the cylinder the rest of the extent; the smallest volume wins
      var bestVol = 1e30f;
      var bestAxis = 0usize;
      var bestR = 0.f;
      var bestHalf = 0.f;
      var ax = 0usize;
      while ax < 3usize {
        let dir = axes[ax];
        var r = 0.f;
        i = 0usize;
        while i < pts.len() {
          let d = *pts[i] - centre;
          let perp = d - dir * d.dot(dir);
          r = fmaxf(r, perp.length());
          i = i + 1usize;
        }
        let half = fmaxf(halves[ax] - r, 0.);
        // points past the cylinder must still be within r of the end point
        var rr = r;
        i = 0usize;
        while i < pts.len() {
          let d = *pts[i] - centre;
          let s = d.dot(dir);
          let over = fabsf(s) - half;
          if over > 0. {
            let perp = d - dir * s;
            rr = fmaxf(rr, (perp.lengthSquared() + over * over).sqrt());
          }
          i = i + 1usize;
        }
        let vol = 3.14159 * rr * rr * 2. * half + 4.18879 * rr * rr * rr;
        if vol < bestVol { bestVol = vol; bestAxis = ax; bestR = rr; bestHalf = half; }
        ax = ax + 1usize;
      }
      let boxVol = 8. * halves[0] * halves[1] * halves[2];
      if boxVol < 0.5 * bestVol {
        // the box: the three principal axes made a right-handed frame
        let q = frameToQuat(axes[0], axes[1], axes[0].cross(axes[1]));
        out.push(new Proxy(b, PROXY_BOX, centre, new Vec3(halves[0], halves[1], halves[2]), 0., q));
      } else {
        let dir = axes[bestAxis];
        out.push(new Proxy(b, PROXY_CAPSULE, centre - dir * bestHalf, centre + dir * bestHalf, bestR, Quat.identity()));
      }
    }
    b = b + 1usize;
  }
  out
}

// The rotation whose columns are the orthonormal vectors x, y, z (a right-handed frame)
fn frameToQuat(x Vec3, y Vec3, z Vec3) Quat {
  // Shepperd's method
  let m00 = x.x; let m10 = x.y; let m20 = x.z;
  let m01 = y.x; let m11 = y.y; let m21 = y.z;
  let m02 = z.x; let m12 = z.y; let m22 = z.z;
  let tr = m00 + m11 + m22;
  if tr > 0. {
    let s = (tr + 1.).sqrt() * 2.;
    return new Quat((m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s, 0.25 * s).normalize();
  }
  if m00 > m11 and m00 > m22 {
    let s = (1. + m00 - m11 - m22).sqrt() * 2.;
    return new Quat(0.25 * s, (m01 + m10) / s, (m02 + m20) / s, (m21 - m12) / s).normalize();
  }
  if m11 > m22 {
    let s = (1. + m11 - m00 - m22).sqrt() * 2.;
    return new Quat((m01 + m10) / s, 0.25 * s, (m12 + m21) / s, (m02 - m20) / s).normalize();
  }
  let s = (1. + m22 - m00 - m11).sqrt() * 2.;
  new Quat((m02 + m20) / s, (m12 + m21) / s, 0.25 * s, (m10 - m01) / s).normalize()
}
