// ======== Cloth materials: weave, sheen, wear and dirt ========
//
// A garment is drawn by render's custom pipeline (render's custom.cone) from cloth.slang. This file makes the pipeline,
// and the material of a garment: a LOOK (the colours, the weave, the sheen, how worn and how dirty), and the PATTERN
// SHEET, a small texture painted from the garment's own panels by rules, which carries what is not the same everywhere:
//
//   red    dirt:  the hem, where it has dragged, and a general grime by a noise
//   green  wear:  the free edges (cuffs, hems and the opening of a coat fray first), a noise's patches, and bands across
//                 a panel where it is rubbed (elbows and knees: `wear bands`)
//   blue   seam:  the nearness of a seam
//
// The rules read the panels' own measures (the metres to the hem and to a free edge, and where down the panel a
// place is), which drape.cone keeps for each vertex of the mesh; the sheet is the flat layout of the panels at 4 mm a
// texel, which is also the uvs, so it is painted by drawing the mesh's triangles into it with their uvs (barycentric
// interpolation of the measures: a software triangle rasteriser, a few hundred microseconds for a garment).

// How a cloth looks
pub struct ClothLook {
  pub warp: Color;                // the thread colours (linear)
  pub weft: Color;
  pub sheen: Color;               // the sheen's colour
  pub sheenStrength: f32;         // 0 none .. 1 velvet
  pub sheenRoughness: f32;        // 0.2 tight and bright .. 1 broad and dull
  pub soil: Color;                // what dirt multiplies the cloth by
  pub threadsPerMetre: f32;       // 400 coarse .. 1500 fine
  pub bump: f32;                  // how deep the weave looks (0 .. 1)
  pub weave: u32;                 // 0 plain, 1 twill, 2 satin
  pub variety: f32;               // thread to thread variety (0 .. 1)
  pub wear: f32;                  // 0 new .. 1 threadbare
  pub dirt: f32;                  // 0 clean .. 1 filthy
  pub hemDirt: f32;               // how far up from the hem the dirt reaches (metres)
  pub seed: u32;

  // Rough wool: a coat or a cloak
  pub fn wool(color: Color) ClothLook {
    new ClothLook(color, new Color(color.red * 0.92, color.green * 0.92, color.blue * 0.95, 1.), new Color(0.55, 0.55, 0.58, 1.), 0.35, 0.8,
      new Color(0.42, 0.34, 0.26, 1.), 520., 0.7, 1u32, 0.28, 0.15, 0.20, 0.30, 11u32)
  }

  // Plain linen or cotton: a tunic, an apron
  pub fn linen(color: Color) ClothLook {
    new ClothLook(color, new Color(color.red * 0.96, color.green * 0.95, color.blue * 0.9, 1.), new Color(0.7, 0.68, 0.62, 1.), 0.18, 0.9,
      new Color(0.45, 0.38, 0.30, 1.), 480., 0.9, 0u32, 0.35, 0.18, 0.30, 0.35, 23u32)
  }

  // Velvet or heavy silk: a cape
  pub fn velvet(color: Color) ClothLook {
    new ClothLook(color, new Color(color.red * 1.04, color.green * 1.04, color.blue * 1.04, 1.), new Color(color.red * 0.9 + 0.4, color.green * 0.7 + 0.3, color.blue * 0.7 + 0.3, 1.),
      0.95, 0.35, new Color(0.35, 0.3, 0.28, 1.), 900., 0.25, 2u32, 0.12, 0.1, 0.15, 0.2, 37u32)
  }
}

pub const CLOTH_PARAM_BYTES = 112u64;

// The cloth pipeline in a renderer; make it once
pub fn addClothPipeline(renderer: &mut Renderer, device: &mut Device) PipelineHandle {
  let textures = [TEXTURE_SAMPLE_TYPE_FLOAT];
  let desc = new CustomPipeline(spirv: &CLOTH_SPIRV, textures: &textures, streams: 3u32, paramBytes: CLOTH_PARAM_BYTES,
    cullMode: CULL_MODE_BACK);
  renderer.addPipeline(device, &desc)
}

pub fn clothParams(look: &ClothLook, sheetW: f32, sheetH: f32, wearGain: f32, dirtGain: f32) List[f32] {
  var p = List[f32].empty();
  p.push(look.warp.red); p.push(look.warp.green); p.push(look.warp.blue); p.push(1.);
  p.push(look.weft.red); p.push(look.weft.green); p.push(look.weft.blue); p.push(1.);
  p.push(look.sheen.red); p.push(look.sheen.green); p.push(look.sheen.blue); p.push(look.sheenStrength);
  p.push(look.soil.red); p.push(look.soil.green); p.push(look.soil.blue); p.push(1.);
  p.push(look.threadsPerMetre); p.push(look.bump); p.push(f32.from(look.weave)); p.push(look.variety);
  p.push(look.sheenRoughness); p.push(0.85); p.push(sheetW); p.push(sheetH);
  p.push(wearGain); p.push(dirtGain); p.push(f32.from(look.seed)); p.push(0.);
  p
}

// ---- the pattern sheet ----

fn hashf(x: i32, y: i32, seed: u32) f32 {
  var h = u32.from(x) * 374761393u32 + u32.from(y) * 668265263u32 + seed * 2246822519u32;
  h = (h ^ (h >> 13u32)) * 1274126177u32;
  h = h ^ (h >> 16u32);
  f32.from(h & 0xFFFFFFu32) / 16777215.
}

// Value noise on a lattice of `cell` metres, smooth between lattice points
fn valueNoise(x: f32, y: f32, cell: f32, seed: u32) f32 {
  let gx = x / cell;
  let gy = y / cell;
  let ix = i32.from(libc.floorf(gx));
  let iy = i32.from(libc.floorf(gy));
  let fx = gx - f32.from(ix);
  let fy = gy - f32.from(iy);
  let sx = fx * fx * (3. - 2. * fx);
  let sy = fy * fy * (3. - 2. * fy);
  let a = hashf(ix, iy, seed);
  let b = hashf(ix + 1i32, iy, seed);
  let c = hashf(ix, iy + 1i32, seed);
  let d = hashf(ix + 1i32, iy + 1i32, seed);
  (a + (b - a) * sx) + ((c + (d - c) * sx) - (a + (b - a) * sx)) * sy
}

fn fbm2(x: f32, y: f32, seed: u32) f32 {
  valueNoise(x, y, 0.16, seed) * 0.5 + valueNoise(x, y, 0.07, seed + 1u32) * 0.3 + valueNoise(x, y, 0.03, seed + 2u32) * 0.2
}

// A band where cloth is rubbed: wear bands are (v, half width in v, amount) triples on each panel
pub struct WearBand {
  pub v: f32;
  pub width: f32;
  pub amount: f32;
}

// The pattern sheet of a garment: its flat layout at 'texelsPerMetre', painted with dirt (red), wear (green) and the
// nearness of a seam (blue). `bands` are the places the cloth is rubbed (v down a panel, a half width, an amount)
pub fn paintSheet(g: &Garment, look: &ClothLook, bands: &List[WearBand], texelsPerMetre: f32) Image {
  let w = i32.from(g.atlasWidth * texelsPerMetre) + 1i32;
  let h = i32.from(g.atlasHeight * texelsPerMetre) + 1i32;
  var img = new Image(w, h, 4, List[u8].withCapacity(usize.from(w) * usize.from(h) * 4usize));
  img.pixels.resize(usize.from(w) * usize.from(h) * 4usize, 0u8);
  // the texels no triangle reaches stay clear (alpha 0), then are filled from their neighbours
  var painted = List[bool].empty();
  var z = 0usize;
  while z < usize.from(w) * usize.from(h) { painted.push(false); z = z + 1usize; }
  let tris = &g.soft.vertexTris;
  let uvs = &g.soft.vertexUvs;
  let attr = &g.vertexAttr;
  if attr.len() == 0usize { return img; }
  var t = 0usize;
  while t + 2usize < tris.len() {
    let ia = usize.from(*tris[t]);
    let ib = usize.from(*tris[t + 1usize]);
    let ic = usize.from(*tris[t + 2usize]);
    t = t + 3usize;
    let pa = new Vec2((*uvs[ia]).x * f32.from(w), (*uvs[ia]).y * f32.from(h));
    let pb = new Vec2((*uvs[ib]).x * f32.from(w), (*uvs[ib]).y * f32.from(h));
    let pc = new Vec2((*uvs[ic]).x * f32.from(w), (*uvs[ic]).y * f32.from(h));
    let lo = pa.min(pb).min(pc);
    let hi = pa.max(pb).max(pc);
    let x0 = imax(i32.from(libc.floorf(lo.x)) - 1i32, 0i32);
    let x1 = imin(i32.from(libc.ceilf(hi.x)) + 1i32, w - 1i32);
    let y0 = imax(i32.from(libc.floorf(lo.y)) - 1i32, 0i32);
    let y1 = imin(i32.from(libc.ceilf(hi.y)) + 1i32, h - 1i32);
    let den = (pb.y - pc.y) * (pa.x - pc.x) + (pc.x - pb.x) * (pa.y - pc.y);
    if den > -1e-9 && den < 1e-9 { continue; }
    var y = y0;
    while y <= y1 {
      var x = x0;
      while x <= x1 {
        let px = f32.from(x) + 0.5;
        let py = f32.from(y) + 0.5;
        let l0 = ((pb.y - pc.y) * (px - pc.x) + (pc.x - pb.x) * (py - pc.y)) / den;
        let l1 = ((pc.y - pa.y) * (px - pc.x) + (pa.x - pc.x) * (py - pc.y)) / den;
        let l2 = 1. - l0 - l1;
        if l0 >= -0.02 && l1 >= -0.02 && l2 >= -0.02 {
          let at = (*attr[ia]) * l0 + (*attr[ib]) * l1 + (*attr[ic]) * l2;
          // at.x metres to the hem, at.y to the nearest free edge, at.z to a seam, at.w v down the panel
          let mx = px / texelsPerMetre;
          let my = py / texelsPerMetre;
          // dirt: the hem's, reaching hemDirt up, broken up by a noise; and a general grime
          let hemK = 1. - smoothstep(0., look.hemDirt, at.x);
          let grime = fbm2(mx, my, look.seed + 100u32);
          var dirt = look.dirt * (hemK * (0.35 + 0.9 * grime) + 0.25 * grime * grime);
          // wear: the free edges, noise patches, and the rubbed bands
          let edgeK = 1. - smoothstep(0., 0.045, at.y);
          var wear = look.wear * (edgeK * (0.5 + 0.8 * fbm2(mx * 1.7, my * 1.7, look.seed + 200u32)) + 0.45 * fbm2(mx, my, look.seed + 300u32));
          var b = 0usize;
          while b < bands.len() {
            let band = *bands[b];
            let d = fabsf(at.w - band.v);
            wear = wear + band.amount * look.wear * (1. - smoothstep(0., band.width, d)) * (0.6 + 0.6 * fbm2(mx * 2., my * 2., look.seed + 400u32));
            b = b + 1usize;
          }
          let seam = 1. - smoothstep(0., 0.012, at.z);
          dirt = fclampf(dirt, 0., 1.);
          wear = fclampf(wear, 0., 1.);
          let o = (usize.from(y) * usize.from(w) + usize.from(x)) * 4usize;
          img.pixels.set(o, u8.from(i32.from(dirt * 255.)));
          img.pixels.set(o + 1usize, u8.from(i32.from(wear * 255.)));
          img.pixels.set(o + 2usize, u8.from(i32.from(seam * 255.)));
          img.pixels.set(o + 3usize, 255u8);
          painted.set(usize.from(y) * usize.from(w) + usize.from(x), true);
        }
        x = x + 1i32;
      }
      y = y + 1i32;
    }
  }
  // dilate: a texel nobody painted takes its painted neighbour's, three times over, so filtering at a panel's
  // edge never reads black
  var pass = 0;
  while pass < 3 {
    var yy = 0i32;
    while yy < h {
      var xx = 0i32;
      while xx < w {
        let idx = usize.from(yy) * usize.from(w) + usize.from(xx);
        if !*painted[idx] {
          var found = false;
          var dy = -1i32;
          while dy <= 1i32 && !found {
            var dx = -1i32;
            while dx <= 1i32 && !found {
              let nx = xx + dx;
              let ny = yy + dy;
              if nx >= 0i32 && ny >= 0i32 && nx < w && ny < h {
                let ni = usize.from(ny) * usize.from(w) + usize.from(nx);
                if *painted[ni] {
                  var c = 0usize;
                  while c < 4usize { img.pixels.set(idx * 4usize + c, *img.pixels[ni * 4usize + c]); c = c + 1usize; }
                  found = true;
                }
              }
              dx = dx + 1i32;
            }
            dy = dy + 1i32;
          }
          if found { painted.set(idx, true); }
        }
        xx = xx + 1i32;
      }
      yy = yy + 1i32;
    }
    pass = pass + 1;
  }
  img
}

fn imax(a: i32, b: i32) i32 { if a > b { a } else { b } }
fn imin(a: i32, b: i32) i32 { if a < b { a } else { b } }

// The material of a garment: its sheet painted and uploaded, its look and the sheet's size as the shader's parameters
pub fn addClothMaterial(renderer: &mut Renderer, device: &mut Device, pipeline: PipelineHandle, g: &Garment, look: &ClothLook,
    bands: &List[WearBand]) MaterialHandle {
  let sheetImage = paintSheet(g, look, bands, 250.);
  let sheet = renderer.addLinearTexture(device, &sheetImage);
  let params = clothParams(look, g.atlasWidth, g.atlasHeight, 1., 1.);
  let maps = [sheet];
  renderer.addCustomMaterial(device, pipeline, params.view(), &maps)
}

// A garment's mesh in a renderer, the same size as its soft body's output, rewritten each frame
pub struct GarmentView {
  pub mesh: MeshHandle;
  pub material: MaterialHandle;
  scratch: Mesh;
  normals: List[Vec3];

  pub fn make(renderer: &mut Renderer, device: &mut Device, g: &Garment, material: MaterialHandle) GarmentView {
    let mesh = renderer.addDynamicMesh(device, u32.from(outputVertexCount(&g.soft, true)), u32.from(outputIndexCount(&g.soft, true)));
    new GarmentView(mesh, material, Mesh.empty(), List[Vec3].empty())
  }

  // Write the garment's present shape to the GPU and add it to the draw list
  pub fn draw(self: &mut, renderer: &mut Renderer, device: &mut Device, g: &Garment, list: &mut DrawList) {
    writeMesh(&g.soft, &mut scratch, true, &mut normals);
    renderer.writeDynamicMesh(device, mesh, &scratch);
    list.add(mesh, material, Mat4.identity());
  }
}

