// A pattern as text: the same data as the builder's.
//
// 1. A pattern written as text has the panels, edges, looseness, seams, fabric and bone lists the same pattern built with
//    calls has.
// 2. Every kind of edge (line, arc, quad, cubic, poly) gives its points: a quarter circle's end lies on the circle, a
//    Bezier's middle where the formula puts it.
// 3. A line that is wrong is refused with its line number.
// 4. The sample garments all parse, and each panel's edges meet at its corners.

mod parse;

import testing use *;
import stdio use *;
import collections use *;
import geomath use *;
import bonepose use *;
import garmentdrape use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn main() i32 {
  let names = humanoidNames();
  let text = "# a shirt\ngarment shirt layer 2\nfabric density 0.3 stretch 1e-6 thick 0.007\nsees ignore clavicle_l 6\npanel body grid 8 6 axis neck pelvis shift 0.1 face back arc 360 gap 0.02 reach 0.3\n  top line 0 0 1 0 8\n  bottom line -0.2 0.5 1.2 0.5 8   # flared\n  left line 0 0 -0.2 0.5 6\n  right poly 1 0 1.2 0.5\n  loose 0 0  0.5 0  0.6 1\nseam body.left body.right\n";
  var parsed = parsePattern(text, &names);
  expectBool(parsed.ok, true, "the text parses");
  let pat = parsed.take();
  expectBool(pat.name.view() == "shirt", true, "the garment's name");
  expectUInt(u64.from(pat.layer), 2u64, "its layer");
  near(pat.density, 0.3, 1e-6, "density");
  near(pat.stretch, 1e-6, 1e-9, "stretch");
  near(pat.thickness, 0.007, 1e-6, "thickness");
  expectUInt(u64.from(pat.ignore.len()), 2u64, "two bones ignored (one by name, one by number)");
  expectUInt(u64.from(*pat.ignore[0usize]), u64.from(CLAVICLE_L), "the first by name");
  expectUInt(u64.from(*pat.ignore[1usize]), 6u64, "the second by number");
  expectUInt(u64.from(pat.panels.len()), 1u64, "one panel");
  expectUInt(u64.from(pat.panels[0usize].nu), 8u64, "its grid across");
  expectUInt(u64.from(pat.panels[0usize].nv), 6u64, "and down");
  expectUInt(u64.from(pat.panels[0usize].place.axisFrom), u64.from(NECK), "the axis starts at the neck");
  expectUInt(u64.from(pat.panels[0usize].place.axisTo), u64.from(PELVIS), "and ends at the pelvis");
  near(pat.panels[0usize].place.shift, 0.1, 1e-6, "its shift");
  near(pat.panels[0usize].place.face.z, 1., 1e-6, "it faces back (+z)");
  near(pat.panels[0usize].place.arc, 2. * pi, 1e-4, "round the whole axis");
  near(pat.panels[0usize].place.gap, 0.02, 1e-6, "its gap");
  near(pat.panels[0usize].reach, 0.3, 1e-6, "its reach");
  expectUInt(u64.from(pat.panels[0usize].top.len()), 9u64, "a line of 8 segments has 9 points");
  expectUInt(u64.from(pat.panels[0usize].right.len()), 2u64, "a poly of two points has two");
  near((*pat.panels[0usize].bottom[0usize]).x, -0.2, 1e-6, "the bottom edge starts at x = -0.2");
  expectUInt(u64.from(pat.panels[0usize].loose.len()), 3u64, "three looseness points");
  near(looseAt(&pat.panels[0usize].loose, 0.25), 0., 1e-6, "tight a quarter of the way down");
  near(looseAt(&pat.panels[0usize].loose, 0.55), 0.5, 1e-5, "half loose at 0.55");
  near(looseAt(&pat.panels[0usize].loose, 0.9), 1., 1e-6, "free at the bottom");
  expectUInt(u64.from(pat.seams.len()), 1u64, "one seam");
  expectUInt(u64.from(pat.seams[0usize].edgeA), u64.from(EDGE_LEFT), "from the left edge");
  expectUInt(u64.from(pat.seams[0usize].edgeB), u64.from(EDGE_RIGHT), "to the right");
  expectBool(pat.seams[0usize].reverse, false, "not reversed");

  // the other edges
  var e = List[Vec2].empty();
  addArc(&mut e, 0., 0., 2., 0., 90., 4u32);
  expectUInt(u64.from(e.len()), 5u64, "an arc of 4 segments has 5 points");
  near((*e[4usize]).x, 0., 1e-5, "a quarter circle ends at x = 0");
  near((*e[4usize]).y, 2., 1e-5, "and y = r (90 degrees is down)");
  near((*e[2usize]).length(), 2., 1e-5, "its middle is on the circle");
  var q = List[Vec2].empty();
  addQuad(&mut q, 0., 0., 1., 2., 2., 0., 2u32);
  near((*q[1usize]).y, 1., 1e-6, "a quadratic Bezier's middle is a quarter of the way to the control point and back: y = 1");
  var cb = List[Vec2].empty();
  addCubic(&mut cb, 0., 0., 0., 1., 1., 1., 1., 0., 2u32);
  near((*cb[1usize]).x, 0.5, 1e-6, "a cubic Bezier's middle: x = 0.5");
  near((*cb[1usize]).y, 0.75, 1e-6, "and y = 0.75");
  var ch = List[Vec2].empty();
  addLine(&mut ch, 0., 0., 1., 0., 2u32);
  addLine(&mut ch, 1., 0., 1., 1., 2u32);
  expectUInt(u64.from(ch.len()), 5u64, "two lines chain without repeating the point where they meet");
  near(edgeLength(&ch), 2., 1e-6, "of length 2");
  near((edgeAt(&ch, 2., 0.75)).y, 0.5, 1e-6, "three quarters of the way along it is half way up the second");

  let zero = parsePattern("garment g layer 0\n", &names);
  expectBool(zero.ok, true, "a layer of 0 parses");
  let n0 = parseNumber("0");
  expectBool(n0.ok, true, "0 is a number");
  let n7 = parseNumber("7");
  expectBool(n7.ok, true, "7 is a number");

  // refusals
  let bad1 = parsePattern("garment x\nwiggle\n", &names);
  expectBool(bad1.ok, false, "an unknown line is refused");
  expectUInt(u64.from(bad1.line), 2u64, "on line 2");
  let bad2 = parsePattern("garment x\ntop line 0 0 1 0 4\n", &names);
  expectBool(bad2.ok, false, "an edge before any panel is refused");
  let bad3 = parsePattern("panel p grid 4 4 axis neck nowhere\n", &names);
  expectBool(bad3.ok, false, "a bone that is not there is refused");
  let bad4 = parsePattern("panel p grid 4 four\n", &names);
  expectBool(bad4.ok, false, "a number that is not a number is refused");
  let bad5 = parsePattern("panel p\nseam p.top q.left\n", &names);
  expectBool(bad5.ok, false, "a seam to a panel that is not there is refused");
  let bad6 = parsePattern("panel p\ntop line 0 0 1 0\n", &names);
  expectBool(bad6.ok, false, "a line with too few numbers is refused");

  // the samples
  var all = List[String].empty();
  all.push(String.from(tunicBody())); all.push(String.from(tunicSleeves())); all.push(String.from(apron()));
  all.push(String.from(longCoat())); all.push(String.from(coatSleeves())); all.push(String.from(cape()));
  var s = 0usize;
  while s < all.len() {
    var r = parsePattern(all[s].view(), &names);
    expectBool(r.ok, true, "a sample garment parses");
    if r.ok {
      let p = r.take();
      var fine = p.panels.len() > 0usize;
      var k = 0usize;
      while k < p.panels.len() {
        fine = fine && flatGrid(&p.panels[k]).ok;
        k = k + 1usize;
      }
      expectBool(fine, true, "and every panel's four edges meet at its corners");
    }
    s = s + 1usize;
  }
  done()
}
