// Any body: a blanket on a four-legged test animal, the pattern given as text.
//
// The body is a skeleton of two spine bones and four legs and a table of tubes (mannequin.cone's tubeBody): not a
// humanoid, and nothing in the garment code names one. The blanket is a pattern in the text form: one panel hung over the
// back (its axis from the first spine bone to the second, facing up, reaching 220 degrees round), tight along the
// backbone (`looseu`: looseness across the panel) and free over the flanks.
//
// 1. The text parses against the animal's own bone names, and the panel's edges meet.
// 2. It drapes: no particle is inside the animal's proxies, the cloth is at rest, the backbone line is pinned and the
//    flanks are free.
// 3. It lies over the back and hangs down both flanks: some of it is above the backbone's top and a good part of it below
//    the back's height, on both sides, evenly (the mean of its sideways places is within 3 cm of the middle).
// 4. It is carried by the animal: with the animal's spine bone raised, the pinned line goes up with it.
// 5. An outfit dresses it (shell and pattern), and steps.

mod anybody;

import testing use *;
import stdio use *;
import collections use *;
import geomath use *;
import bonepose use *;
import xpbdsoftbody use Workers;
import garmentdrape use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn animal() BodyRig {
  var sk = Skeleton.empty();
  let root = sk.addBone(-1i32, Transform3(Vec3(0., 0.9, 0.), Quat.identity(), Vec3(1., 1., 1.)));
  let front = sk.addBone(i32.from(root), Transform3(Vec3(0., 0., -0.6), Quat.identity(), Vec3(1., 1., 1.)));
  var tubes = List[Tube].empty();
  tubes.push(Tube(root, i32.from(front), Vec3(0., 0., 0.), 0., 0.2, 0.22, 0.9, true, false));
  tubes.push(Tube(front, -1i32, Vec3(0., 0., -1.), 0.35, 0.22, 0.12, 0.9, false, true));
  var li = 0;
  while li < 4 {
    let side = if li % 2 == 0 { -1.f } else { 1. };
    let parent = if li < 2 { root } else { front };
    let leg = sk.addBone(i32.from(parent), Transform3(Vec3(side * 0.14, 0., 0.), Quat.identity(), Vec3(1., 1., 1.)));
    let foot = sk.addBone(i32.from(leg), Transform3(Vec3(0., -0.45, 0.), Quat.identity(), Vec3(1., 1., 1.)));
    tubes.push(Tube(leg, i32.from(foot), Vec3(0., 0., 0.), 0., 0.07, 0.045, 1.0, false, false));
    var leaf = Tube(foot, -1i32, Vec3(0., -1., 0.), 0.42, 0.045, 0.03, 1.0, false, true);
    leaf.length = 0.42;
    tubes.push(leaf);
    li = li + 1;
  }
  tubeBody(sk, &tubes)
}

fn animalNames() List[String] {
  var n = List[String].empty();
  n.push(String.from("spine_back")); n.push(String.from("spine_front"));
  n.push(String.from("leg_a")); n.push(String.from("foot_a"));
  n.push(String.from("leg_b")); n.push(String.from("foot_b"));
  n.push(String.from("leg_c")); n.push(String.from("foot_c"));
  n.push(String.from("leg_d")); n.push(String.from("foot_d"));
  n
}

fn main() i32 {
  let rig = animal();
  let names = animalNames();
  let text = "garment blanket layer 0\nfabric density 0.4 stretch 2e-6 shear 2e-5 bend 100 thick 0.008 damping 2\npanel blanket grid 14 12 axis spine_back spine_front shift -0.1 face up arc 220 gap 0.012 flare 0.2 minr 0.1 reach 0.3\n  top line 0 0 1.0 0 14\n  bottom line 0 0.85 1.0 0.85 14\n  left line 0 0 0 0.85 12\n  right line 1.0 0 1.0 0.85 12\n  looseu 0 1  0.38 1  0.46 0  0.54 0  0.62 1  1 1\n  loose 0 0  1 0\n";
  var parsed = parsePattern(text, &names);
  expectBool(parsed.ok, true, "the blanket parses against the animal's own bone names");
  let pat = parsed.take();
  expectUInt(u64.from(pat.panels[0usize].place.axisFrom), 0u64, "its axis starts at the first spine bone");
  expectUInt(u64.from(pat.panels[0usize].looseU.len()), 6u64, "with a looseness across the panel");
  expectBool(flatGrid(&pat.panels[0usize]).ok, true, "its edges meet");

  let none = LayerSurface.empty();
  let d = drape(&pat, &rig, 0., &none, 1u32);
  expectBool(d.ok, true, "it drapes on the animal");
  let g = &d.garment;
  expectUInt(u64.from(d.inside), 0u64, "no particle is left inside the animal's proxies");
  expectBool(d.settledSpeed < 0.1, true, "and it is at rest");
  expectBool(g.tightCount() > 10usize && g.tightCount() < g.particleCount() / 2usize, true, "the backbone line is pinned and the flanks are free");

  // 3. over the back and down the flanks
  var hi = -1e9f; var lo = 1e9f; var sumX = 0.f; var minX = 1e9f; var maxX = -1e9f;
  var i = 0usize;
  while i < g.particleCount() {
    let p = *g.soft.pos[i];
    hi = fmaxf(hi, p.y);
    lo = fminf(lo, p.y);
    sumX = sumX + p.x;
    minX = fminf(minX, p.x);
    maxX = fmaxf(maxX, p.x);
    i = i + 1usize;
  }
  expectBool(hi > 1.1, true, "it lies over the back (some of it above 1.1 m: the back's top is at 0.9 + 0.22)");
  expectBool(lo < 0.9, true, "and hangs down the flanks (some of it below the spine's own height)");
  expectBool(minX < -0.2 && maxX > 0.2, true, "on both sides");
  near(sumX / f32.from(g.particleCount()), 0., 0.03, "evenly: the mean of its sideways places is within 3 cm of the middle");

  // 4. carried by the animal: the back bone raised 20 cm, the pinned line rises with it
  var outfit = Outfit.make();
  var dd = drape(&pat, &rig, 0., &none, 1u32);
  var moved = Garment.empty();
  moved <-> dd.garment;
  outfit.addGarment(moved);
  var pose = rig.skeleton.restPose();
  var models = List[Transform3].empty();
  rig.skeleton.modelTransforms(&pose, &mut models);
  outfit.snap(&rig, &models);
  var workers = Workers.none();
  let before = *outfit.garments[0usize].soft.pos[firstPinned(&outfit)];
  pose.setTranslation(0usize, (*pose.locals[0usize]).translation + Vec3(0., 0.2, 0.));
  rig.skeleton.modelTransforms(&pose, &mut models);
  var f = 0;
  while f < 30 { outfit.step(&rig, &models, 1. / 60., Vec3(0., 0., 0.), &mut workers); f = f + 1; }
  let after = *outfit.garments[0usize].soft.pos[firstPinned(&outfit)];
  near(after.y - before.y, 0.2, 0.01, "a pinned particle goes up with the animal's back, 20 cm");
  var nan = false;
  i = 0usize;
  while i < outfit.garments[0usize].particleCount() {
    let p = *outfit.garments[0usize].soft.pos[i];
    if p.x != p.x || p.y != p.y || p.z != p.z { nan = true; }
    i = i + 1usize;
  }
  expectBool(nan, false, "and the loose cloth stays well behaved");

  // 5. an outfit dresses it
  var shells = List[ShellSpec].empty();
  var chest = ShellSpec.make("jacket");
  chest.bones.push(0usize);
  shells.push(chest);
  var pats = List[Pattern].empty();
  var p2 = parsePattern(text, &names);
  var blanket = p2.take();
  blanket.layer = 1u32;
  pats.push(blanket);
  var dressing = dress(&rig, &shells, &pats, 1u32);
  expectBool(dressing.ok, true, "a shell and a pattern dress the animal together");
  expectUInt(u64.from(dressing.outfit.shells.len()), 1u64, "one shell");
  expectUInt(u64.from(dressing.outfit.garments.len()), 1u64, "and one garment over it");

  done()
}

// The first pinned particle of the outfit's first garment
fn firstPinned(o: &Outfit) usize {
  var i = 0usize;
  while i < o.garments[0usize].loose.len() { if *o.garments[0usize].loose[i] <= TIGHT { return i; } i = i + 1usize; }
  0usize
}
