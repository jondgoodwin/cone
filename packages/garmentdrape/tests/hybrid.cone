// An outfit in motion: skinned where the cloth is tight, simulated where it is loose.
//
// A mannequin is dressed (`dress`) in breeches (a shell, layer 0), a tunic and its sleeves (patterns, layer 0) and an apron
// (a pattern, layer 1), made to stand, and then to walk with walkgait's walk for three seconds.
//
// 1. The dressing builds what it should: a shell, three garments, the layers in order, tight and free particles both.
// 2. Standing still, the cloth is still: after 1.5 s no free particle moves faster than 20 cm/s (the hanging apron settles
//    last; the body is not still, it shifts its weight).
// 3. Walking, every tight particle is exactly where the skin puts it (it is the skinned mesh), every free one is within
//    its reach of the skin (the max distance: `0.004 + looseness * reach`, and the layer push's centimetre), and nothing
//    is not a number or far from the body.
// 4. The cloth moves: some free particle strays at least 2 cm from the skin during the walk (it is simulated, not skinned).
// 5. The collision proxies follow the moving body: at the end no more than 1% of the cloth is inside a proxy its garment
//    sees by more than 2 cm.
// 6. The layers hold, measured: with them kept, the apron (layer 1) has no more than a fifth of its particles near the tunic
//    on the tunic's inner side, and fewer than the same walk with the layers not kept.
// 7. It is deterministic: dressing and walking twice gives the same bits.
// 8. A teleport is repaired by `snap`: the cloth follows the body to a new place at once.

mod hybrid;

import testing use *;
import stdio use *;
import collections use *;
import geomath use *;
import bonepose use *;
import walkgait use Walker;
import xpbdsoftbody use *;
import garmentdrape use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn flat(x f32, z f32) f32 { 0. }

struct Run {
  rig BodyRig;
  outfit Outfit;
  walker Walker;
  pose Pose;
  models List[Transform3];
  world List[Transform3];
  worstTight f32;
  worstReach f32;
  maxStray f32;
  badNumbers usize;
}

fn dressed(keepLayers bool) Run {
  let rig = humanoidMannequin(1.75);
  let names = humanoidNames();
  var shells = List[ShellSpec].empty();
  var b = ShellSpec.make("breeches");
  b.bones.push(PELVIS); b.bones.push(THIGH_L); b.bones.push(THIGH_R); b.bones.push(SHIN_L); b.bones.push(SHIN_R);
  shells.push(b);
  var patterns = List[Pattern].empty();
  var p1 = parsePattern(tunicBody(), &names);
  var p2 = parsePattern(tunicSleeves(), &names);
  var p3 = parsePattern(apron(), &names);
  patterns.push(p1.take()); patterns.push(p2.take()); patterns.push(p3.take());
  var d = dress(&rig, &shells, &patterns, 1u32);
  var outfit = Outfit.make();
  outfit <=> d.outfit;
  outfit.keepLayers = keepLayers;
  let restPose = rig.skeleton.restPose();
  new Run(rig, outfit, Walker.make(1.75, 3u32), restPose, List[Transform3].empty(), List[Transform3].empty(), 0., 0., 0., 0usize)
}

fn toWorld(r &mut Run, at Vec3) {
  let root = new Transform3(at, Quat.identity(), new Vec3(1., 1., 1.));
  r.world.clear();
  var i = 0usize;
  while i < r.models.len() { r.world.push(root * *r.models[i]); i = i + 1usize; }
}

fn restAt(r &mut Run, at Vec3) {
  let rp = r.rig.skeleton.restPose();
  r.rig.skeleton.modelTransforms(&rp, &mut r.models);
  toWorld(r, at);
  r.outfit.snap(&r.rig, &r.world);
}

// One frame of the walk at `speed`, bookkeeping the worst deviations
fn frame(r &mut Run, workers &mut Workers, z f32, speed f32, wind Vec3) {
  let at = new Vec3(0., 0., z);
  r.walker.update(&r.rig.skeleton, &mut r.pose, &mut r.models, at, 0., speed, 0., true, &flat, 1. / 60.);
  toWorld(r, at);
  r.outfit.step(&r.rig, &r.world, 1. / 60., wind, workers);
  var g = 0usize;
  while g < r.outfit.garments.len() {
    let n = r.outfit.garments[g].particleCount();
    var i = 0usize;
    while i < n {
      let p = *r.outfit.garments[g].soft.pos[i];
      let t = *r.outfit.garments[g].target[i];
      if p.x != p.x || p.y != p.y || p.z != p.z { r.badNumbers = r.badNumbers + 1usize; }
      else {
        let lo = *r.outfit.garments[g].loose[i];
        let dev = (p - t).length();
        if lo <= TIGHT { r.worstTight = fmaxf(r.worstTight, dev); }
        else {
          r.worstReach = fmaxf(r.worstReach, dev - (0.004 + lo * *r.outfit.garments[g].reach[i]));
          r.maxStray = fmaxf(r.maxStray, dev);
        }
      }
      i = i + 1usize;
    }
    g = g + 1usize;
  }
}

// Stand for 1.5 s, then walk for 4 s (half a second to set off, a second to reach 1.4 m/s)
fn walk(r &mut Run, workers &mut Workers) {
  restAt(r, new Vec3(0., 0., 0.));
  var f = 0;
  while f < 90 { frame(r, workers, 0., 0., new Vec3(0., 0., 0.)); f = f + 1; }
  r.worstTight = 0.;
  r.worstReach = -1.;
  r.maxStray = 0.;
  var z = 0.f;
  f = 0;
  while f < 240 {
    let t = f32.from(f) / 60.;
    let speed = if t < 0.5 { 0. } elif t < 1.5 { 1.4 * (t - 0.5) } else { 1.4 };
    z = z - speed / 60.;
    frame(r, workers, z, speed, new Vec3(0.8, 0., 0.3));
    f = f + 1;
  }
}

fn main() i32 {
  var a = dressed(true);
  expectUInt(u64.from(a.outfit.shells.len()), 1u64, "one shell");
  expectUInt(u64.from(a.outfit.garments.len()), 3u64, "three garments");
  expectUInt(u64.from(a.outfit.garments[0usize].layer), 0u64, "the tunic is in layer 0");
  expectUInt(u64.from(a.outfit.garments[2usize].layer), 1u64, "the apron in layer 1");
  var tight = 0usize;
  var free = 0usize;
  var g = 0usize;
  while g < a.outfit.garments.len() {
    tight = tight + a.outfit.garments[g].tightCount();
    free = free + a.outfit.garments[g].particleCount() - a.outfit.garments[g].tightCount();
    g = g + 1usize;
  }
  expectBool(tight > 150usize && free > 600usize, true, "both skinned and simulated particles: over a hundred and fifty tight, over six hundred free");
  expectUInt(u64.from(a.outfit.freeParticles()), u64.from(free), "freeParticles counts the loose ones");
  expectBool(a.outfit.garments[2usize].proxyIdx.len() >= 1usize && a.outfit.garments[2usize].proxyIdx.len() < a.rig.proxies.len(), true, "a garment collides with some of the proxies, not all (the nearby ones)");

  // 2. standing still (the first 90 frames of the walk), then 3, 4 and 5: the walk
  var workers = Workers.none();
  restAt(&mut a, new Vec3(0., 0., 0.));
  var f = 0;
  while f < 89 { frame(&mut a, &mut workers, 0., 0., new Vec3(0., 0., 0.)); f = f + 1; }
  // what moves is measured by how far a particle goes in a frame (its stored velocity can hold a push that is undone each
  // substep: the position does not move)
  var was = List[Vec3].empty();
  g = 0usize;
  while g < a.outfit.garments.len() {
    var i = 0usize;
    while i < a.outfit.garments[g].particleCount() { was.push(*a.outfit.garments[g].soft.pos[i]); i = i + 1usize; }
    g = g + 1usize;
  }
  frame(&mut a, &mut workers, 0., 0., new Vec3(0., 0., 0.));
  var fastest = 0.f;
  var at = 0usize;
  g = 0usize;
  while g < a.outfit.garments.len() {
    var i = 0usize;
    while i < a.outfit.garments[g].particleCount() {
      if *a.outfit.garments[g].loose[i] > TIGHT { fastest = fmaxf(fastest, (*a.outfit.garments[g].soft.pos[i] - *was[at]).length() * 60.); }
      at = at + 1usize;
      i = i + 1usize;
    }
    g = g + 1usize;
  }
  expectBool(fastest < 0.1, true, "standing still, the cloth is still after 1.5 s (no free particle moves at more than 10 cm/s)");
  near(a.worstTight, 0., 1e-4, "and the tight particles are on the skin");
  walk(&mut a, &mut workers);
  near(a.worstTight, 0., 1e-4, "walking, every tight particle is exactly where the skin puts it");
  expectBool(a.worstReach < 0.02, true, "and every free one is within its reach of the skin (the max distance, and the layer push's margin)");
  expectUInt(u64.from(a.badNumbers), 0u64, "no particle is not a number");
  expectBool(a.maxStray > 0.02, true, "some free cloth strays at least 2 cm from the skin: it is simulated");
  var inside = 0usize;
  var all = 0usize;
  g = 0usize;
  while g < a.outfit.garments.len() {
    var i = 0usize;
    while i < a.outfit.garments[g].particleCount() {
      if a.rig.distanceSeen(&a.world, 0., &a.outfit.garments[g].seen, *a.outfit.garments[g].soft.pos[i]) < -0.02 { inside = inside + 1usize; }
      all = all + 1usize;
      i = i + 1usize;
    }
    g = g + 1usize;
  }
  expectBool(inside * 100usize < all, true, "at the end under 1% of the cloth is inside the body by more than 2 cm");

  // 6. the layers hold: the apron's free particles near the tunic, behind a face of it or not, with and without the push
  let kept = layerCheckOf(&a.outfit, 2usize);
  var c = dressed(false);
  walk(&mut c, &mut workers);
  let lost = layerCheckOf(&c.outfit, 2usize);
  expectBool(kept.within > 50usize, true, "the apron lies on the tunic: over fifty of its free particles are within 5 cm of it");
  expectBool(kept.behind * 100usize <= kept.within * 20usize, true, "with the layers kept at most a fifth of those are behind a face of the tunic");
  expectBool(kept.behind * lost.within < lost.behind * kept.within, true, "and that share is smaller than the same walk's without the layers kept");

  // 7. determinism: the same again
  var b = dressed(true);
  walk(&mut b, &mut workers);
  var d = dressed(true);
  walk(&mut d, &mut workers);
  var same = true;
  g = 0usize;
  while g < d.outfit.garments.len() {
    var i = 0usize;
    while i < d.outfit.garments[g].particleCount() {
      let pa = *d.outfit.garments[g].soft.pos[i];
      let pb = *b.outfit.garments[g].soft.pos[i];
      if pa.x != pb.x || pa.y != pb.y || pa.z != pb.z { same = false; }
      i = i + 1usize;
    }
    g = g + 1usize;
  }
  expectBool(same, true, "dressed and walked twice, every particle is in the same place to the bit");

  // 8. a teleport: the body is put 10 m away; snap carries the cloth with it
  let there = new Vec3(10., 0., -5.);
  restAt(&mut a, there);
  var worstAway = 0.f;
  g = 0usize;
  while g < a.outfit.garments.len() {
    var i = 0usize;
    while i < a.outfit.garments[g].particleCount() {
      worstAway = fmaxf(worstAway, (*a.outfit.garments[g].soft.pos[i] - there).length());
      i = i + 1usize;
    }
    g = g + 1usize;
  }
  expectBool(worstAway < 2.0, true, "after a teleport and a snap every particle is within 2 m of the body's new place");
  frame(&mut a, &mut workers, -5., 0., new Vec3(0., 0., 0.));
  expectUInt(u64.from(a.badNumbers), 0u64, "and the next frame is fine");

  workers.stop();
  done()
}
