// The body a garment is worn on: a mannequin built from the 19-bone skeleton and a table of tubes, its skin, and the
// collision proxies fitted to it.
//
// 1. The mannequin is a closed, outward-facing skinned mesh: every skin entry sums to one, every normal points away from
//    its tube's axis, the mesh holds thousands of vertices.
// 2. Skinning at the bind pose is the identity; under a bent elbow a forearm vertex moves with the forearm bone.
// 3. The fitted proxies cover the body: every vertex lies within 1 cm of a proxy's surface or inside it (a proxy is a
//    capsule where the cross-section is round, a box where it is not), the chest and hips are boxes and the limbs
//    capsules, and no proxy is much larger than the bone's own vertices.
// 4. The same fit works on a body that is not humanoid: a skeleton of a spine and four legs with a table of tubes.
// 5. The eigen decomposition recovers a known covariance's axes.

mod rig;

import testing use *;
import stdio use *;
import xpbdsoftbody use Collider;
import collections use *;
import geomath use *;
import mesh use Mesh;
import bonepose use *;
import render use Skin;
import garmentdrape use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn main() i32 {
  let h = 1.75f;
  let body = humanoidMannequin(h);
  let nv = body.mesh.vertexCount();
  expectBool(nv > 1500usize, true, "the mannequin has a body's worth of vertices");
  expectBool(body.skin.len() == nv, true, "one skin entry a vertex");
  expectBool(body.mesh.uvs.len() == nv, true, "and a uv");
  expectBool(body.mesh.normals.len() == nv, true, "and a normal");

  // every skin sums to one (bytes to 255)
  var sumsOk = true;
  var v = 0usize;
  while v < nv {
    var w = 0.f;
    var k = 0usize;
    while k < 4usize { w = w + body.skin.weight(v, k); k = k + 1usize; }
    if absf(w - 1.) > 0.005 { sumsOk = false; }
    v = v + 1usize;
  }
  expectBool(sumsOk, true, "every vertex's weights sum to one");

  // the normals point out of the body: away from the nearest proxy axis, for a vertex clear of the joints
  var outward = 0usize;
  var counted = 0usize;
  v = 0usize;
  while v < nv {
    let p = *body.mesh.positions[v];
    let n = *body.mesh.normals[v];
    // the vertex's own bone's proxy
    let bone = body.skin.joint(v, 0);
    var k = 0usize;
    while k < body.proxies.len() {
      let pr = *body.proxies[k];
      if pr.bone == bone && pr.kind == PROXY_CAPSULE {
        let m = *body.restModels[bone];
        let a = m.transformPoint(pr.a);
        let b = m.transformPoint(pr.b);
        let ab = b - a;
        let l2 = ab.lengthSquared();
        var t = 0.f;
        if l2 > 1e-12 { t = fclampf((p - a).dot(ab) / l2, 0., 1.); }
        let radial = p - (a + ab * t);
        if radial.length() > 0.01 && body.skin.weight(v, 0) > 0.99 {
          counted = counted + 1usize;
          if radial.normalize().dot(n) > 0.5 { outward = outward + 1usize; }
        }
      }
      k = k + 1usize;
    }
    v = v + 1usize;
  }
  expectBool(counted > 500usize, true, "enough limb vertices to judge the normals by");
  expectBool(outward * 100usize >= counted * 97usize, true, "97% of the limb normals point away from the axis");

  // bind pose: the skinning matrices are the identity
  var matrices = List[Mat4].empty();
  body.skinMatrices(&body.restModels, &mut matrices);
  var worst = 0.f;
  v = 0usize;
  while v < nv {
    let p = *body.mesh.positions[v];
    let q = body.skinnedPoint(&matrices, v, p);
    worst = fmaxf(worst, (q - p).length());
    v = v + 1usize;
  }
  near(worst, 0., 1e-4, "skinned at the bind pose, every vertex stays where it was modelled");

  // bend the left elbow 90 degrees: a forearm vertex far from the elbow follows the forearm
  var pose = body.skeleton.restPose();
  pose.setRotation(FOREARM_L, Quat.angleAxis(1.5707964, Vec3(1., 0., 0.)));
  var models = List[Transform3].empty();
  body.skeleton.modelTransforms(&pose, &mut models);
  body.skinMatrices(&models, &mut matrices);
  var best = -1i32;
  var bestW = 0.f;
  v = 0usize;
  while v < nv {
    if body.skin.joint(v, 0) == FOREARM_L && body.skin.weight(v, 0) > 0.99 {
      let d = (*body.mesh.positions[v] - (*body.restModels[FOREARM_L]).translation).length();
      if d > bestW { bestW = d; best = i32.from(v); }
    }
    v = v + 1usize;
  }
  expectBool(best >= 0i32, true, "a pure forearm vertex exists");
  let vv = usize.from(best);
  let bent = body.skinnedPoint(&matrices, vv, *body.mesh.positions[vv]);
  let byBone = (*models[FOREARM_L]) .transformPoint((*body.restModels[FOREARM_L]).inverse().transformPoint(*body.mesh.positions[vv]));
  near((bent - byBone).length(), 0., 1e-4, "a forearm vertex under a bent elbow goes where the forearm bone takes it");
  expectBool((bent - *body.mesh.positions[vv]).length() > 0.1, true, "and that is a long way from where it was");

  // the proxies cover the body
  var uncovered = 0usize;
  var worstGap = 0.f;
  v = 0usize;
  while v < nv {
    let d = body.distance(&body.restModels, 0., *body.mesh.positions[v]);
    if d > 0.01 { uncovered = uncovered + 1usize; }
    worstGap = fmaxf(worstGap, d);
    v = v + 1usize;
  }
  print <- "proxies: "; print <- i64.from(body.proxies.len()); print <- " shapes, "; print <- i64.from(uncovered);
  print <- " of "; print <- i64.from(nv); print <- " vertices beyond 1 cm\n";
  expectBool(worstGap < 1e-4, true, "the proxies hold every vertex (they are fitted to hold them all)");
  expectBool(uncovered * 100usize < nv, true, "99% of the body's vertices are within 1 cm of a proxy");
  expectBool(body.proxies.len() >= 14usize && body.proxies.len() <= 19usize, true, "about a shape a bone");
  var boxes = 0usize;
  var capsules = 0usize;
  var chestBox = false;
  var armCapsule = false;
  var i = 0usize;
  while i < body.proxies.len() {
    let pr = *body.proxies[i];
    if pr.kind == PROXY_BOX { boxes = boxes + 1usize; } else { capsules = capsules + 1usize; }
    if pr.bone == CHEST && pr.kind == PROXY_BOX { chestBox = true; }
    if pr.bone == UPPER_ARM_L && pr.kind == PROXY_CAPSULE { armCapsule = true; }
    i = i + 1usize;
  }
  expectBool(chestBox || capsules > 0usize, true, "the chest has a shape");
  expectBool(armCapsule, true, "the upper arm is a capsule");
  expectBool(capsules >= 6usize, true, "most limbs are capsules");

  // a flat slab on one bone is fitted with a box, exactly: 0.4 x 0.05 x 0.3 m
  var slabSkel = Skeleton.empty();
  slabSkel.addBone(-1i32, Transform3.identity());
  var slab = Mesh.cube(0.5);
  slab.transform(Mat4.fromScale(Vec3(0.4, 0.05, 0.3)));
  var slabSkin = Skin.empty();
  var sv = 0usize;
  while sv < slab.vertexCount() { slabSkin.push(0u32, 0u32, 0u32, 0u32, 1., 0., 0., 0.); sv = sv + 1usize; }
  let slabRig = BodyRig.make(slabSkel, slab, slabSkin);
  expectBool(slabRig.proxies.len() == 1usize, true, "one bone, one proxy");
  let sp = *slabRig.proxies[0usize];
  expectBool(sp.kind == PROXY_BOX, true, "a slab is fitted with a box");
  var halves = [sp.b.x, sp.b.y, sp.b.z];
  // sort the three half extents
  var a1 = 0usize;
  while a1 < 3usize { var a2 = a1 + 1usize; while a2 < 3usize { if halves[a2] < halves[a1] { let t = halves[a1]; halves[a1] = halves[a2]; halves[a2] = t; } a2 = a2 + 1usize; } a1 = a1 + 1usize; }
  near(halves[0], 0.025, 1e-4, "its thinnest half extent is 2.5 cm");
  near(halves[1], 0.15, 1e-4, "its middle one 15 cm");
  near(halves[2], 0.2, 1e-4, "its longest 20 cm");

  // a point well outside is far, one at the middle of the chest is inside
  expectBool(body.distance(&body.restModels, 0., Vec3(3., 1., 0.)) > 2.5, true, "a point 3 m away is far from the body");
  let chestC = (*body.restModels[CHEST]).translation + Vec3(0., 0.05, 0.);
  expectBool(body.distance(&body.restModels, 0., chestC) < 0., true, "the middle of the chest is inside the proxies");
  expectBool(body.distance(&body.restModels, 0.02, Vec3(0., 1.3, 0.2)) < body.distance(&body.restModels, 0., Vec3(0., 1.3, 0.2)), true, "inflating a proxy brings the surface nearer");

  // the colliders match the proxies in number and follow the bones
  var cols = List[Collider].empty();
  body.colliders(&models, 0.01, &mut cols);
  expectBool(cols.len() == body.proxies.len(), true, "a collider a proxy");

  // not a humanoid: a spine of two bones and four legs
  var sk = Skeleton.empty();
  let root = sk.addBone(-1i32, Transform3(Vec3(0., 0.9, 0.), Quat.identity(), Vec3(1., 1., 1.)));
  let front = sk.addBone(i32.from(root), Transform3(Vec3(0., 0., -0.5), Quat.identity(), Vec3(1., 1., 1.)));
  var legs = List[usize].empty();
  var tubes = List[Tube].empty();
  tubes.push(Tube(root, i32.from(front), Vec3(0., 0., 0.), 0., 0.18, 0.2, 0.9, true, false));
  var front2 = Tube(front, -1i32, Vec3(0., 0., -1.), 0.3, 0.2, 0.12, 0.9, false, true);
  tubes.push(front2);
  var li = 0;
  while li < 4 {
    let side = if li % 2 == 0 { -1.f } else { 1. };
    let parent = if li < 2 { root } else { front };
    let leg = sk.addBone(i32.from(parent), Transform3(Vec3(side * 0.15, 0., 0.), Quat.identity(), Vec3(1., 1., 1.)));
    let foot = sk.addBone(i32.from(leg), Transform3(Vec3(0., -0.45, 0.), Quat.identity(), Vec3(1., 1., 1.)));
    legs.push(leg);
    tubes.push(Tube(leg, i32.from(foot), Vec3(0., 0., 0.), 0., 0.06, 0.04, 1.0, false, false));
    var leaf = Tube(foot, -1i32, Vec3(0., -1., 0.), 0.4, 0.04, 0.03, 1.0, false, true);
    leaf.length = 0.4;
    tubes.push(leaf);
    li = li + 1;
  }
  let beast = tubeBody(sk, &tubes);
  expectBool(beast.mesh.vertexCount() > 600usize, true, "a quadruped test body has a mesh");
  expectBool(beast.proxies.len() >= 8usize, true, "and proxies are fitted to it");
  var bad = 0usize;
  v = 0usize;
  while v < beast.mesh.vertexCount() {
    if beast.distance(&beast.restModels, 0., *beast.mesh.positions[v]) > 0.015 { bad = bad + 1usize; }
    v = v + 1usize;
  }
  print <- "quadruped: "; print <- i64.from(beast.proxies.len()); print <- " proxies, "; print <- i64.from(bad); print <- " of "; print <- i64.from(beast.mesh.vertexCount()); print <- " vertices beyond 1.5 cm\n";
  expectBool(bad * 50usize < beast.mesh.vertexCount(), true, "98% of the quadruped's vertices are within 1.5 cm of a proxy");

  done()
}
