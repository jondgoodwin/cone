// Layers: an outer garment never passes through an inner one.
//
// 1. closestOnTriangle gives the right point in every region of a triangle (a face, each edge, each corner).
// 2. A LayerSurface pushes a point that is inside its clearance of a triangle out along the triangle's front, puts a point
//    that is behind a triangle in front of it, and leaves a point beyond the clearance, or beside the triangle, alone.
// 3. A shirt is draped on the mannequin, then a larger one over it with the first as the layer beneath: nowhere does an
//    outer particle come nearer than the clearance to an inner triangle, and the outer hangs outside the inner (the mean
//    distance of the outer's loose rows from the axis exceeds the inner's).
// 4. The same outer shirt draped without the layer beneath goes through the inner one (the layering is doing the work).

mod layers;

import testing use *;
import stdio use *;
import collections use *;
import geomath use *;
import bonepose use *;
import xpbdsoftbody use *;
import garmentdrape use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn nearV(got: Vec3, want: Vec3, within: f32, label: &Array[u8]) bool {
  near((got - want).length(), 0., within, label)
}

fn shirt(name: &str, girth: f32, length: f32, layer: u32, thick: f32, gap: f32) Pattern {
  var pat = Pattern.make(name);
  pat.layer = layer;
  pat.thickness = thick;
  var p = newPanel("body", 24u32, 16u32);
  addLine(&mut p.top, 0., 0., girth, 0., 24u32);
  addLine(&mut p.bottom, -0.2 * girth, length, 1.2 * girth, length, 24u32);
  addLine(&mut p.left, 0., 0., -0.2 * girth, length, 16u32);
  addLine(&mut p.right, girth, 0., 1.2 * girth, length, 16u32);
  p.place.axisFrom = NECK;
  p.place.axisTo = PELVIS;
  p.place.shift = 0.12;
  p.place.face = new Vec3(0., 0., -1.);
  p.place.arc = 2. * pi;
  p.place.gap = gap;
  p.place.flare = 0.1;
  p.loose.push(new Vec2(0., 0.));
  p.loose.push(new Vec2(0.3, 0.));
  p.loose.push(new Vec2(0.45, 1.));
  p.loose.push(new Vec2(1., 1.));
  p.reach = 0.2;
  let id = pat.addPanel(p);
  pat.stitch(id, EDGE_LEFT, id, EDGE_RIGHT, false);
  pat.ignore.push(CLAVICLE_L);
  pat.ignore.push(CLAVICLE_R);
  pat
}

// Each particle of `outer` against its nearest triangle of `inner`: how many are behind it (inside the inner layer: the
// signed distance along that triangle's outward normal is negative), and the least signed distance over those within 5 cm
fn nearest(outer: &SoftBody, inner: &LayerSurface) LayerCheck {
  measureLayering(&outer.pos, &List[f32].empty(), inner)
}

fn main() i32 {
  // 1. closest point on a triangle (0,0,0) (2,0,0) (0,2,0)
  let a = new Vec3(0., 0., 0.);
  let b = new Vec3(2., 0., 0.);
  let c = new Vec3(0., 2., 0.);
  nearV(closestOnTriangle(new Vec3(0.5, 0.5, 1.), a, b, c), new Vec3(0.5, 0.5, 0.), 1e-6, "above the face: straight down");
  nearV(closestOnTriangle(new Vec3(-1., -1., 0.), a, b, c), a, 1e-6, "beyond corner a: a");
  nearV(closestOnTriangle(new Vec3(3., -1., 0.), a, b, c), b, 1e-6, "beyond corner b: b");
  nearV(closestOnTriangle(new Vec3(-1., 3., 0.), a, b, c), c, 1e-6, "beyond corner c: c");
  nearV(closestOnTriangle(new Vec3(1., -1., 0.5), a, b, c), new Vec3(1., 0., 0.), 1e-6, "below edge ab: its foot on the edge");
  nearV(closestOnTriangle(new Vec3(-1., 1., 0.), a, b, c), new Vec3(0., 1., 0.), 1e-6, "left of edge ac: its foot");
  nearV(closestOnTriangle(new Vec3(2., 2., 0.), a, b, c), new Vec3(1., 1., 0.), 1e-6, "beyond the hypotenuse: its middle");

  // 2. the surface pushes
  var s = LayerSurface.empty();
  var ps = List[Vec3].empty();
  ps.push(a); ps.push(b); ps.push(c);
  var ts = List[u32].empty();
  ts.push(0u32); ts.push(1u32); ts.push(2u32);
  s.append(&ps, &ts);
  s.clearance = 0.1;
  s.rebuild();
  // the triangle's front is +z (a x b x c counter-clockwise from +z)
  nearV(s.pushOut(new Vec3(0.5, 0.5, 0.03)), new Vec3(0.5, 0.5, 0.1), 1e-5, "3 cm in front of the face: pushed to the clearance (10 cm)");
  nearV(s.pushOut(new Vec3(0.5, 0.5, 0.3)), new Vec3(0.5, 0.5, 0.3), 1e-6, "30 cm in front: left alone");
  nearV(s.pushOut(new Vec3(0.5, 0.5, -0.02)), new Vec3(0.5, 0.5, 0.1), 1e-5, "2 cm behind it: put in front of it");
  nearV(s.pushOut(new Vec3(1.5, 1.5, 0.5)), new Vec3(1.5, 1.5, 0.5), 1e-6, "off to the side: left alone");
  nearV(s.pushOut(new Vec3(-0.05, 0.5, 0.0)), new Vec3(0., 0.5, 0.1), 1e-5, "beside the edge, in its plane: pushed out along the normal (to 10 cm in front)");

  // 3. two shirts
  let rig = humanoidMannequin(1.75);
  let none = LayerSurface.empty();
  let innerPat = shirt("inner", 1.35, 0.5, 0u32, 0.006, 0.012);
  let di = drape(&innerPat, &rig, 0., &none, 1u32);
  expectBool(di.ok, true, "the inner shirt drapes");
  var below = LayerSurface.empty();
  below.append(&di.garment.bind, &di.garment.soft.tris);
  below.clearance = 0.014;
  below.rebuild();
  let outerPat = shirt("outer", 1.75, 0.55, 1u32, 0.008, 0.014);
  let withIt = drape(&outerPat, &rig, 0.006, &below, 1u32);
  expectBool(withIt.ok, true, "the outer shirt drapes over it");
  let kept = nearest(&withIt.garment.soft, &below);
  expectBool(kept.within > 60usize, true, "a good share of the outer shirt lies within 5 cm of the inner (over sixty particles)");
  expectUInt(u64.from(kept.behind), 0u64, "none of the outer shirt's particles is inside the inner");
  expectBool(kept.least > 0.002, true, "and none is within 2 mm of it (the clearance is 14 mm; where the cloth is squeezed between the pins and the flare, a few mm)");
  var innerOnly = LayerSurface.empty();
  innerOnly.clearance = 0.014;
  let without = drape(&outerPat, &rig, 0.006, &innerOnly, 1u32);
  let lost = nearest(&without.garment.soft, &below);
  // draped without the layer beneath, the outer goes through the inner shirt where the inner flares out past it
  expectBool(lost.behind > 0usize, true, "without the layer beneath some of the outer is inside the inner (the layering is doing the work)");

  done()
}
