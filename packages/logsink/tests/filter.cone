// The sink's level filter: 'enabled' wants a kind no more detailed than the level the sink was given, so a sink
// at Warn writes the Error and Warn kinds only, while the facade's own level (here Trace for every target) lets
// all through to be asked. A kind the sink refuses is off in the facade: its arguments are never evaluated.

mod filter;

import testing use *;
import stdio use *;
import trace use Level, Kind0, Kind1;
import time use Timestamp;
import logsink;

let errorKind: Kind0;
let warnKind: Kind0;
let infoKind: Kind1[u64];
let debugKind: Kind0;
let traceKind: Kind0;

fn @initpure init() {
  errorKind = Kind0.make("e", "app", Level.Error);
  warnKind = Kind0.make("w", "app", Level.Warn);
  infoKind = Kind1[u64].make("i", "app", Level.Info, "n");
  debugKind = Kind0.make("d", "app", Level.Debug);
  traceKind = Kind0.make("t", "app", Level.Trace);
}

var written = 0u32;
var evaluated = 0u32;

fn clock() Timestamp {Timestamp.fromUnixSeconds(1762853415i64)}

fn line(s: &str) {
  written = written + 1u32;
  print <- s;
}

fn bump() u64 {
  evaluated = evaluated + 1u32;
  1u64
}

fn main() i32 {
  trace.setDefaultLevel(Level.Trace);
  expect(logsink.installWith(Level.Warn, &clock, &line), "the sink is installed");
  errorKind.emit();
  warnKind.emit();
  infoKind.emit(bump());
  debugKind.emit();
  traceKind.emit();
  expect(written == 2u32, "only the Error and the Warn kind were written");
  expect(evaluated == 0u32, "an Info argument was not evaluated: the kind is off");
  done()
}
