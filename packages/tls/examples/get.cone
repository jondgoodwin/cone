// A GET over HTTPS from a real server, through httpconn's driver with a TLS
// session in its Layer seam, the server's certificate checked by Windows'
// own verifier on the blocking pool. Run it with
//
//   congo run packages/tls/examples/get.cone -- https://example.com/
//   congo run packages/tls/examples/get.cone -- https://expired.badssl.com/
//
// It needs the network, so it is an example and never a test: 'congo test'
// builds it and does not run it. It fetches the URL twice, each time on a
// new connection, the second resuming the first's TLS session, and prints
// for each: what TLS negotiated (version, cipher, ALPN, the handshake's
// time and the verifier's), the status, the body's length, and the times
// to the first byte and to the end; or, when it fails, the stage and why.
// 'http://' URLs go through the plain layer, for comparison.

mod get;

import stdio use *;
import process;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, forever;
import http use *;
import httpconn use *;
import tls;

struct Url {
  pub secure bool;
  pub host String;
  pub port u16;
  pub path String;
}

// 'https://host[:port]/path', 'http://...', or a bare host
fn parseUrl(s &Array[u8]) Url {
  mut u = new Url(true, String.empty(), 443u16, String.from("/"));
  mut rest = s;
  if s.len >= 8usize and &s[0usize .. 8usize] == "https://" {
    rest = &s[8usize ..];
  } elif s.len >= 7usize and &s[0usize .. 7usize] == "http://" {
    rest = &s[7usize ..];
    u.secure = false;
    u.port = 80u16;
  }
  mut end = 0usize;
  while end < rest.len and rest[end] != '/' {end = end + 1usize;}
  imm hostPort = &rest[0usize .. end];
  if end < rest.len {u.path = String.fromBytes(&rest[end ..]);}
  mut colon = hostPort.len;
  mut k = 0usize;
  while k < hostPort.len {
    if hostPort[k] == ':' {colon = k;}
    k = k + 1usize;
  }
  u.host = String.fromBytes(&hostPort[0usize .. colon]);
  if colon < hostPort.len {
    match collections.parseUInt(&hostPort[colon + 1usize ..] as &str) {
      case imm p Some {u.port = u16.from(p.value);}
      case is None[u64] {}
    }
  }
  u;
}

fn millis(d Duration) {
  imm tenths = d.nanos() / 100000i64;
  printInt(tenths / 10i64);
  printStr(".");
  printInt(tenths % 10i64);
  printStr(" ms");
}

// One GET on a new connection: true when it ended Done
fn fetch(drv &mut Driver, lp &mut Loop, client &tls.Client, pool Pool, u &Url) bool {
  imm host = u.host.view();
  imm started = Instant.now();
  mut conn = ConnId.none();
  if u.secure {
    conn = drv.connectWith(lp, host, u.port, new So[tls.Stream](client.stream(host, pool)), Sink.Here[1u64]);
  } else {
    conn = drv.connect(lp, host, u.port, Sink.Here[1u64]);
  }
  mut req = RequestHead.get(u.path.view(), host);
  req.headers.add("User-Agent", "cone-tls-example");
  req.headers.add("Accept", "*/*");
  drv.requestBy(lp, conn, req, BodyLength.empty(), Sink.Here[2u64], Instant.now() + Duration.fromSeconds(20i64));
  mut events = List[Event].empty();
  mut total = 0u64;
  mut going = true;
  mut ok = false;
  while going {
    drv.poll(lp, forever(), &mut events);
    mut k = 0usize;
    while k < events.len() {
      imm e = &mut events[k];
      k = k + 1usize;
      if e.kind == EventKind.Connected[] {
        printStr("  connected to ");
        printStr(e.peer.text().view());
        printStr(" after ");
        millis(Instant.now() - started);
        printStr("\n");
      } elif e.kind == EventKind.Response[] {
        printStr("  ");
        printStr(drv.layerInfo(conn).view());
        printStr("\n  HTTP/1.1 ");
        printUInt(u64.from(e.response.status));
        printStr(" ");
        printStr(reasonPhrase(e.response.status));
        printStr("\n");
      } elif e.kind == EventKind.Data[] {
        total = total + u64.from(e.buf.len());
        drv.release(e.req, e.buf.len());
      } elif e.kind == EventKind.Done[] {
        printStr("  ");
        printUInt(total);
        printStr(" bytes of body; first byte after ");
        millis(e.timing.firstByte - e.timing.submitted);
        printStr(", done after ");
        millis(e.timing.ended - e.timing.submitted);
        printStr("\n");
        ok = true;
        going = false;
      } elif e.isTerminal() {
        printStr("  ");
        printStr(eventName(e.kind));
        printStr(": ");
        printStr(e.failure.message().view());
        printStr("\n");
        going = false;
      }
    }
    events.clear();
  }
  drv.abort(lp, conn);
  ok;
}

fn main() i32 {
  imm args = process.args();
  if args.len() < 2usize {
    printStr("usage: get <https://host[:port]/path> [--once]\n");
    return 2i32;
  }
  imm u = parseUrl(args[1usize].view());
  imm twice = not (args.len() > 2usize and args[2usize].view() == "--once");
  imm pool = Pool.make();
  mut lp = Loop.mustMake();
  mut drv = Driver.make(Config.make(), pool);
  mut client = tls.Client.make(tls.ClientConfig.make());
  mut status = 1i32;
  match client {
    case imm c Ok {
      printStr(tls.backendVersion());
      printStr(", the OS's verifier\n");
      if fetch(&mut drv, &mut lp, &c.value, pool, &u) {status = 0i32;}
      if twice and status == 0i32 {
        printStr("again, on a new connection:\n");
        if not fetch(&mut drv, &mut lp, &c.value, pool, &u) {status = 1i32;}
      }
    }
    case imm e Error {
      printStr(e.value.message().view());
      printStr("\n");
    }
  }
  drv.abortAll(&mut lp);
  status;
}
