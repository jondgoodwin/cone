// TLS timed over 127.0.0.1 and in memory, with the test certificates
// (ECDSA P-256, packages/tls/tests/certs). Run it from the repository's root,
// in a release build:
//
//   congo run --release packages/tls/examples/bench.cone [-- concurrent]
//
// On Linux, raise the descriptor limit first (ulimit -n 65536): the 2,000
// connection ends of part 4 are more than the default 1,024. "Private bytes"
// there are the process's data size (VmData), Windows' PrivateUsage here.
//
// 1. Handshakes in memory, sans-IO: a client session and a server session
//    on one thread, their bytes moved by hand; the CPU a handshake costs both
//    sides together, full (a new client context each time, nothing to
//    resume) and resumed (TLS 1.3 tickets), p50 and p99.
// 2. Connections over loopback through httpconn's driver: connect, the
//    handshake, one GET of 64 bytes, the connection reset; each cycle timed
//    from asking for the connection to the GET's Done. Plain HTTP, TLS full
//    and TLS resumed.
// 3. Bulk: one connection, one GET of 256 MiB, the body streamed as fast as
//    the connection takes it; plain and TLS.
// 4. Memory: 1,000 session pairs in memory, open and idle after a small
//    exchange; and 1,000 kept-alive TLS connections through the driver after
//    one GET each, both ends in this process: what the process's private
//    bytes and the pool's lent buffers grew by, per pair or connection.
//
// With 'concurrent' after '--', it times only a second connection opened
// while the first to the same server is still open, a new client context
// each time: in memory, and over loopback through the driver (connect,
// handshake, one GET). It resumes from a ticket the first was sent.
//
// The client verifies by the test root (Verifier.roots), so nothing here
// asks the OS's verifier or the network.

mod bench;

import stdio use *;
import libc;
import fs;
import path use Path;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, SocketAddr, forever;
import diag use Histogram;
import http use *;
import httpconn use *;
import tls;
import process;

extern {
  fn @c(system) GetCurrentProcess() usize;
  fn @c(system) K32GetProcessMemoryInfo(process: usize, counters: *u8, cb: u32) i32;
}

// The bytes the process has committed for itself: Windows' PrivateUsage
// (PROCESS_MEMORY_COUNTERS_EX), Linux's data size (VmData)
fn privateBytes() u64 {
  if isWindows() {
    var c = Array[usize, 10]() <- fill 0usize;
    let p = &mut c as *u8;
    *(p as *u32) = 80u32;
    K32GetProcessMemoryInfo(GetCurrentProcess(), p, 80u32);
    u64.from(c[9usize])
  } else {
    dataBytes()
  }
}

// Linux: the sixth number of /proc/self/statm (size resident shared text lib
// data dt), in 4096-byte pages: the process's writable private memory
fn dataBytes() u64 {
  let f = libc.fopen("/proc/self/statm", "rb");
  if f == null {return 0u64;}
  var buf = Array[u8, 256]() <- fill 0u8;
  let bp: *u8 = &[]buf as *u8;
  let n = libc.fread(bp, 1usize, 255usize, f);
  libc.fclose(f);
  var field = 0u32;
  var value = 0u64;
  var k = 0usize;
  while k < n {
    let c = buf[k];
    if c >= '0' && c <= '9' {
      if field == 5u32 {value = value * 10u64 + u64.from(c - '0');}
    } else {
      field = field + 1u32;
    }
    k = k + 1usize;
  }
  value * 4096u64
}

const tokServer = 0x10000000u64;
const tokConn = 0x20000000u64;
const tokReq = 0x30000000u64;
const bigPiece = 262144usize;

fn certs(name: &str) Path {
  var p = String.from("packages/tls/tests/certs/");
  p.append(name);
  Path.fromString(p)
}

fn readText(name: &str) String {
  var out = String.empty();
  let file = certs(name);
  match fs.readFile(&file) {
    case var Ok(r) {out <-> r;}
    case let Error(e) {}
  }
  out
}

fn makeServer() tls.Server {
  let serverPem = certs("server.pem");
  let serverKey = certs("server.key");
  match tls.Server.make(tls.ServerConfig.make(&serverPem, &serverKey)) {
    case let Ok(r) {
      let s = r;
      return s;
    }
    case let Error(e) {printStr(e.message().view());}
  }
  panic("no server: run from the repository's root")
}

fn makeClient(resume: bool) tls.Client {
  var cfg = tls.ClientConfig.make();
  cfg.verify = tls.Verifier.roots(readText("ca.pem").view());
  cfg.resume = resume;
  match tls.Client.make(cfg) {
    case let Ok(r) {
      let c = r;
      return c;
    }
    case let Error(e) {printStr(e.message().view());}
  }
  panic("no client")
}

struct TlsMaker {
  server: tls.Server;
  pool: Pool;

  pub fn make(self: &mut) Uni[Layer] {Uni[tls.Stream](server.stream(pool))}
}

fn micros(ns: u64) {
  printUInt(ns / 1000u64);
  printStr(".");
  printUInt((ns / 100u64) % 10u64);
  printStr(" us");
}

fn report(label: &str, h: &Histogram) {
  printStr(label);
  printStr(": p50 ");
  micros(h.percentile(0.5));
  printStr(", p99 ");
  micros(h.percentile(0.99));
  printStr(", max ");
  micros(h.max());
  printStr(" (");
  printUInt(h.count());
  printStr(")\n");
}

// ---------------------------------------------------------------------------
// 1. In memory
// ---------------------------------------------------------------------------

fn pump(c: &mut tls.Session, s: &mut tls.Session) {
  var buf = Array[u8, 20000]() <- fill 0u8;
  var moved = true;
  while moved {
    moved = false;
    while c.pending() > 0usize {
      let n = c.transmit(&mut buf[0usize ..< 20000usize]);
      s.feed(&buf[0usize ..< n]);
      moved = true;
    }
    while s.pending() > 0usize {
      let n = s.transmit(&mut buf[0usize ..< 20000usize]);
      c.feed(&buf[0usize ..< n]);
      moved = true;
    }
    // The client reads, which takes TLS 1.3's tickets
    while c.canRead() {
      if c.read(&mut buf[0usize ..< 20000usize]) == 0usize {break;}
    }
  }
}

fn inMemory(n: u32) {
  let srv = makeServer();
  var full = Histogram.make();
  var k = 0u32;
  while k < n {
    let cl = makeClient(false);
    let t0 = Instant.now();
    var c = cl.session("localhost");
    var s = srv.session();
    pump(&mut c, &mut s);
    full.record((Instant.now() - t0).nanos());
    if !c.isOpen() {printStr("a handshake failed\n");}
    k = k + 1u32;
  }
  report("in memory, full handshake (both sides)", &full);
  let cl = makeClient(true);
  var resumed = Histogram.make();
  var fresh = 0u32;
  k = 0u32;
  while k <= n {
    let t0 = Instant.now();
    var c = cl.session("localhost");
    var s = srv.session();
    pump(&mut c, &mut s);
    let took = (Instant.now() - t0).nanos();
    if c.info().resumed {resumed.record(took);} else {fresh = fresh + 1u32;}
    k = k + 1u32;
  }
  report("in memory, resumed handshake (both sides)", &resumed);
}

// A second connection while the first is open: each time a new client
// context, its first connection's handshake done and the connection kept,
// then a second to the same server, timed. It resumes from one of the
// first's tickets, which came after its handshake
fn concurrentInMemory(n: u32) {
  let srv = makeServer();
  var second = Histogram.make();
  var resumed = 0u32;
  var k = 0u32;
  while k < n {
    let cl = makeClient(true);
    var a = cl.session("localhost");
    var sa = srv.session();
    pump(&mut a, &mut sa);
    let t0 = Instant.now();
    var b = cl.session("localhost");
    var sb = srv.session();
    pump(&mut b, &mut sb);
    second.record((Instant.now() - t0).nanos());
    if b.info().resumed {resumed = resumed + 1u32;}
    if !a.isOpen() || !b.isOpen() {printStr("a handshake failed\n");}
    k = k + 1u32;
  }
  report("in memory, a second handshake while the first is open (both sides)", &second);
  printStr("  (");
  printUInt(u64.from(resumed));
  printStr(" of ");
  printUInt(u64.from(n));
  printStr(" resumed)\n");
}

// ---------------------------------------------------------------------------
// The server's side, on the driver
// ---------------------------------------------------------------------------

struct Serving {
  pub pool: Pool;
  pub big: ReqId;
  pub left: u64;
}

fn sendBig(drv: &mut Driver, sv: &mut Serving) {
  while sv.left > 0u64 {
    let n = if sv.left < u64.from(bigPiece) {usize.from(sv.left)} else {bigPiece};
    var b = sv.pool.mustTake(n);
    b.setLen(n);
    match drv.sendData(sv.big, b) {
      case is None[IoBuf] {sv.left = sv.left - u64.from(n);}
      else {return;}
    }
  }
  drv.finish(sv.big);
}

// A server's event: /big streams 'size' bytes; anything else is 64 bytes
// (The event's kind, request and whether it asks for /big are lent, not the event: it is
// in a list the driver might change, and its target a view of a String in it.)
fn serve(drv: &mut Driver, sv: &mut Serving, kind: EventKind, req: ReqId, big: bool, size: u64) {
  if kind == EventKind.Request {
    if big {
      drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(size));
      sv.big = req;
      sv.left = size;
      sendBig(drv, sv);
    } else {
      drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(64u64));
      var b = sv.pool.mustTake(64usize);
      b.setLen(64usize);
      drv.sendData(req, b);
      drv.finish(req);
    }
  } elif kind == EventKind.Writable && sv.left > 0u64 {
    sendBig(drv, sv);
  }
}

fn listenOn(drv: &mut Driver, lp: &mut Loop, secure: bool, srv: &tls.Server, pool: Pool) u16 {
  var port = 0u16;
  var res = if secure {
    drv.listenWith(lp, SocketAddr.localhost(0u16), Uni[TlsMaker](TlsMaker(*srv, pool)), Sink.Here(tokServer))
  } else {
    drv.listen(lp, SocketAddr.localhost(0u16), Sink.Here(tokServer))
  };
  match res {
    case let Ok(r) {
      match drv.localAddr(lp, r) {
        case let Ok(a) {port = a.port();}
        case let Error(e) {}
      }
    }
    case let Error(e) {}
  }
  port
}

fn connect(drv: &mut Driver, lp: &mut Loop, secure: bool, cl: &tls.Client, pool: Pool, port: u16, k: u64) ConnId {
  if secure {
    return drv.connectWith(lp, "127.0.0.1", port, Uni[tls.Stream](cl.stream("localhost", pool)),
      Sink.Here(tokConn + k));
  }
  drv.connect(lp, "127.0.0.1", port, Sink.Here(tokConn + k))
}

// ---------------------------------------------------------------------------
// 2. Connections
// ---------------------------------------------------------------------------

fn cycles(label: &str, secure: bool, resume: bool, n: u32) {
  let pool = Pool.make();
  var lp = Loop.mustMake();
  var drv = Driver.make(Config.make(), pool);
  let srv = makeServer();
  let cl = makeClient(resume);
  let port = listenOn(&mut drv, &mut lp, secure, &srv, pool);
  var sv = Serving(pool, ReqId.none(), 0u64);
  var h = Histogram.make();
  var events = List[Event].empty();
  let r0 = tls.stats().resumed;
  var k = 0u32;
  while k < n + 1u32 {
    let t0 = Instant.now();
    let c = connect(&mut drv, &mut lp, secure, &cl, pool, port, 0u64);
    drv.request(&mut lp, c, RequestHead.get("/x", "localhost"), BodyLength.empty(), Sink.Here(tokReq));
    var going = true;
    while going {
      drv.poll(&mut lp, forever(), &mut events);
      var j = 0usize;
      while j < events.len() {
        let e = &mut events[j];
        j = j + 1usize;
        if e.token == tokServer {serve(&mut drv, &mut sv, e.kind, e.req, e.request.target.view() == "/big", 0u64);}
        elif e.kind == EventKind.Data {drv.release(e.req, e.buf.len());}
        elif e.token == tokReq && e.isTerminal() {going = false;}
      }
      events.clear();
    }
    // The first, which warms the tables and the cache, is not counted
    if k > 0u32 {h.record((Instant.now() - t0).nanos());}
    drv.abort(&mut lp, c);
    k = k + 1u32;
  }
  report(label, &h);
  if secure && resume {
    printStr("  (");
    printUInt(tls.stats().resumed - r0);
    printStr(" sessions resumed, both sides counted)\n");
  }
  drv.abortAll(&mut lp);
}

// A GET on a connection, driven to its final answer
fn getOn(drv: &mut Driver, lp: &mut Loop, sv: &mut Serving, events: &mut List[Event], c: ConnId) {
  drv.request(lp, c, RequestHead.get("/x", "localhost"), BodyLength.empty(), Sink.Here(tokReq));
  var going = true;
  while going {
    drv.poll(lp, forever(), events);
    var j = 0usize;
    while j < events.len() {
      let e = &mut events[j];
      j = j + 1usize;
      if e.token == tokServer {serve(drv, sv, e.kind, e.req, e.request.target.view() == "/big", 0u64);}
      elif e.kind == EventKind.Data {drv.release(e.req, e.buf.len());}
      elif e.token == tokReq && e.isTerminal() {going = false;}
    }
    events.clear();
  }
}

// A second connection while the first is open, over loopback: each time a
// new client context, its first connection's GET done and the connection
// kept; then a second connection and its GET, timed from asking for it to
// the GET's Done; both reset
fn concurrentCycles(n: u32) {
  let pool = Pool.make();
  var lp = Loop.mustMake();
  var drv = Driver.make(Config.make(), pool);
  let srv = makeServer();
  let port = listenOn(&mut drv, &mut lp, true, &srv, pool);
  var sv = Serving(pool, ReqId.none(), 0u64);
  var h = Histogram.make();
  var events = List[Event].empty();
  let r0 = tls.stats().resumed;
  var k = 0u32;
  while k < n + 1u32 {
    let cl = makeClient(true);
    let first = connect(&mut drv, &mut lp, true, &cl, pool, port, 0u64);
    getOn(&mut drv, &mut lp, &mut sv, &mut events, first);
    let t0 = Instant.now();
    let c = connect(&mut drv, &mut lp, true, &cl, pool, port, 1u64);
    getOn(&mut drv, &mut lp, &mut sv, &mut events, c);
    if k > 0u32 {h.record((Instant.now() - t0).nanos());}
    drv.abort(&mut lp, c);
    drv.abort(&mut lp, first);
    k = k + 1u32;
  }
  report("connect + GET + reset, TLS, a second connection while the first is open", &h);
  printStr("  (");
  printUInt(tls.stats().resumed - r0);
  printStr(" sessions resumed, both sides counted)\n");
  drv.abortAll(&mut lp);
}

// ---------------------------------------------------------------------------
// 3. Bulk
// ---------------------------------------------------------------------------

fn bulk(label: &str, secure: bool, size: u64) {
  let pool = Pool.make(268435456usize, 67108864usize);
  var lp = Loop.mustMake();
  var drv = Driver.make(Config.make(), pool);
  let srv = makeServer();
  let cl = makeClient(false);
  let port = listenOn(&mut drv, &mut lp, secure, &srv, pool);
  var sv = Serving(pool, ReqId.none(), 0u64);
  var events = List[Event].empty();
  let c = connect(&mut drv, &mut lp, secure, &cl, pool, port, 0u64);
  // A first GET, so the handshake is not timed
  var round = 0u32;
  var got = 0u64;
  var t0 = Instant.now();
  while round < 2u32 {
    if round == 0u32 {
      drv.request(&mut lp, c, RequestHead.get("/x", "localhost"), BodyLength.empty(), Sink.Here(tokReq));
    } else {
      t0 = Instant.now();
      drv.request(&mut lp, c, RequestHead.get("/big", "localhost"), BodyLength.empty(), Sink.Here(tokReq));
    }
    var going = true;
    while going {
      drv.poll(&mut lp, forever(), &mut events);
      var j = 0usize;
      while j < events.len() {
        let e = &mut events[j];
        j = j + 1usize;
        if e.token == tokServer {serve(&mut drv, &mut sv, e.kind, e.req, e.request.target.view() == "/big", size);}
        elif e.kind == EventKind.Data {
          if round == 1u32 {got = got + u64.from(e.buf.len());}
          drv.release(e.req, e.buf.len());
        } elif e.token == tokReq && e.isTerminal() {going = false;}
      }
      events.clear();
    }
    round = round + 1u32;
  }
  let ns = (Instant.now() - t0).nanos();
  printStr(label);
  printStr(": ");
  printUInt(got / 1048576u64);
  printStr(" MiB in ");
  printUInt(u64.from(ns / 1000000i64));
  printStr(" ms, ");
  printUInt(got * 1000u64 / u64.from(ns + 1i64));
  printStr(" MB/s\n");
  drv.abortAll(&mut lp);
}

// ---------------------------------------------------------------------------
// 4. Memory per idle connection
// ---------------------------------------------------------------------------

fn idleMemory(n: u64) {
  let pool = Pool.make(268435456usize, 268435456usize);
  var lp = Loop.mustMake();
  var cfg = Config.make();
  cfg.acceptDepth = 64u32;
  var drv = Driver.make(cfg, pool);
  let srv = makeServer();
  let cl = makeClient(true);
  let port = listenOn(&mut drv, &mut lp, true, &srv, pool);
  var sv = Serving(pool, ReqId.none(), 0u64);
  var events = List[Event].empty();
  var round = 0u32;
  var before = 0u64;
  var heldBefore = 0usize;
  while round < 2u32 {
    // Round 0 warms the tables and the pool with 64; round 1 is measured
    let want = if round == 0u32 {64u64} else {n};
    if round == 1u32 {
      pool.trim();
      before = privateBytes();
      heldBefore = pool.stats().heldBytes - pool.stats().idleBytes;
    }
    var cs = List[ConnId].empty();
    var connected = 0u64;
    var ended = 0u64;
    while ended < want {
      if u64.from(cs.len()) < want && u64.from(cs.len()) < connected + 64u64 {
        let k = u64.from(cs.len());
        let c = connect(&mut drv, &mut lp, true, &cl, pool, port, k);
        drv.request(&mut lp, c, RequestHead.get("/x", "localhost"), BodyLength.empty(), Sink.Here(tokReq + k));
        cs.push(c);
        continue;
      }
      drv.poll(&mut lp, forever(), &mut events);
      var j = 0usize;
      while j < events.len() {
        let e = &mut events[j];
        j = j + 1usize;
        if e.token == tokServer {serve(&mut drv, &mut sv, e.kind, e.req, e.request.target.view() == "/big", 0u64);}
        elif e.kind == EventKind.Data {drv.release(e.req, e.buf.len());}
        elif e.kind == EventKind.Connected {connected = connected + 1u64;}
        elif e.token >= tokReq && e.isTerminal() {ended = ended + 1u64;}
      }
      events.clear();
    }
    let settle = Instant.now() + Duration.fromMillis(200i64);
    while Instant.now() < settle {
      drv.poll(&mut lp, settle, &mut events);
      events.clear();
    }
    if round == 0u32 {
      var k = 0usize;
      while k < cs.len() {
        drv.abort(&mut lp, *cs[k]);
        k = k + 1usize;
      }
      let settle2 = Instant.now() + Duration.fromMillis(200i64);
      while Instant.now() < settle2 {
        drv.poll(&mut lp, settle2, &mut events);
        events.clear();
      }
    }
    round = round + 1u32;
  }
  pool.trim();
  let after = privateBytes();
  let heldAfter = pool.stats().heldBytes - pool.stats().idleBytes;
  printStr("idle TLS connections: ");
  printUInt(n);
  printStr(" open (");
  printUInt(u64.from(drv.live()));
  printStr(" driver connections, both ends)\n  private bytes +");
  printUInt((after - before) / 1024u64);
  printStr(" KiB: ");
  printUInt((after - before) / n);
  printStr(" bytes a connection (both ends); pool buffers lent +");
  printUInt(u64.from(heldAfter - heldBefore) / 1024u64);
  printStr(" KiB\n");
  drv.abortAll(&mut lp);
}

// Memory per session pair in memory, idle after a handshake and a small exchange
fn sessionMemory(n: u32) {
  let srv = makeServer();
  let cl = makeClient(false);
  var cs = List[tls.Session].empty();
  var ss = List[tls.Session].empty();
  {
    var c = cl.session("localhost");
    var s = srv.session();
    pump(&mut c, &mut s);
  }
  let before = privateBytes();
  var k = 0u32;
  while k < n {
    var c = cl.session("localhost");
    var s = srv.session();
    pump(&mut c, &mut s);
    c.write("GET / HTTP/1.1\r\n\r\n");
    pump(&mut c, &mut s);
    cs.push(c);
    ss.push(s);
    k = k + 1u32;
  }
  let after = privateBytes();
  printStr("sessions in memory, a client and a server, open and idle: ");
  printUInt((after - before) / u64.from(n));
  printStr(" bytes a pair\n");
}

fn main() i32 {
  printStr(tls.backendVersion());
  printStr("\n");
  let args = process.args();
  if args.len() > 1usize && args[1usize].view() == "concurrent" {
    concurrentInMemory(500u32);
    concurrentCycles(500u32);
    return 0i32;
  }
  sessionMemory(1000u32);
  inMemory(500u32);
  cycles("connect + GET + reset, plain", false, false, 500u32);
  cycles("connect + GET + reset, TLS full handshake", true, false, 500u32);
  cycles("connect + GET + reset, TLS resumed", true, true, 500u32);
  bulk("bulk, plain", false, 268435456u64);
  bulk("bulk, TLS", true, 268435456u64);
  idleMemory(1000u64);
  0i32
}
