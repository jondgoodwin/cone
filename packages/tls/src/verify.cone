// The verifiers' halves that are not the session's: the callback OpenSSL
// makes when the server's chain has come, and the operating system's
// verifier, which runs on the blocking pool (see the package's header,
// VERIFIERS).
//
// The OS's verifier is a plain function of a buffer, so it can run on any
// thread and touches nothing of the session's: the buffer holds the name
// asked for and the chain the server sent, and comes back holding the
// verdict. The job's layout, each number four bytes, little-endian:
//
//   name length, name bytes, certificate count, then for each certificate
//   its length and its DER bytes, the server's own first
//
// and the answer, Done(4): the four bytes of Windows' error (0: trusted).
//
// Windows' verifier is crypt32's chain engine. Linux has no such engine, so
// there OpenSSL's own check (X509_verify_cert) judges the chain against the
// system's roots, and its verify result is mapped to the Windows error the
// package reports for that failure (certError): the same codes, kinds and
// words on every OS, whichever verifier answered.

// OpenSSL calls this when the server's chain has come, in place of its own
// check (SSL_CTX_set_cert_verify_callback). It reads the session's verdict
// from the SSL object's slot 0; while there is none, it stops the handshake
// (SSL_set_retry_verify) for the session to find one
fn @c("coneTlsVerifyChain") verifyChain(store: *u8, arg: *u8) i32 {
  let ssl = X509_STORE_CTX_get_ex_data(store, SSL_get_ex_data_X509_STORE_CTX_idx());
  if ssl as usize == 0usize {return 0i32;}
  let v = SSL_get_ex_data(ssl, 0i32) as usize;
  if v == verdictTrusted {return 1i32;}
  if v == verdictRefused {
    X509_STORE_CTX_set_error(store, x509ApplicationVerification);
    return 0i32;
  }
  if SSL_ctrl(ssl, ctrlSetRetryVerify, 0i64, null) > 0i32 {1i32} else {0i32}
}

// The OS's verifier as pool work: the job in buf, its verdict back in it.
// arg 1: offline, fetching nothing
pub fn verifyWork(arg: u64, buf: &mut IoBuf) Outcome {
  let code = osVerify(buf.view(), arg == 1u64);
  buf.clear();
  var c = code;
  buf.append(mem.sliceFromParts(&mut c as *u8, 4usize));
  Outcome.Done(4usize)
}

// ---------------------------------------------------------------------------
// crypt32: the chain engine and the SSL policy
// ---------------------------------------------------------------------------

// CERT_ENHKEY_USAGE
struct EnhKeyUsage {
  count: u32;
  ids: **u8;
}

// CERT_USAGE_MATCH
struct UsageMatch {
  kind: u32;
  usage: EnhKeyUsage;
}

// CERT_CHAIN_PARA with its extra fields (96 bytes, as cl.exe lays it out)
struct ChainPara {
  size: u32;
  usage: UsageMatch;
  issuancePolicy: UsageMatch;
  urlTimeout: u32;              // dwUrlRetrievalTimeout, milliseconds
  checkFreshness: i32;
  freshness: u32;
  cacheResync: *u8;
  strongSign: *u8;
  strongSignFlags: u32;
}

// CERT_CHAIN_POLICY_PARA
struct PolicyPara {
  size: u32;
  flags: u32;
  extra: *u8;
}

// SSL_EXTRA_CERT_CHAIN_POLICY_PARA. Its first member is a union of two
// DWORDs (cbStruct, cbSize), so one u32 stands for it
struct SslPolicyPara {
  size: u32;
  authType: u32;
  checks: u32;
  serverName: *u16;
}

// CERT_CHAIN_POLICY_STATUS
struct PolicyStatus {
  size: u32;
  error: u32;
  chainIndex: i32;
  elementIndex: i32;
  extra: *u8;
}

extern {
  fn @c(system) CertOpenStore(provider: usize, encoding: u32, prov: usize, flags: u32, para: *u8) *u8;
  fn @c(system) CertCloseStore(store: *u8, flags: u32) i32;
  fn @c(system) CertAddEncodedCertificateToStore(store: *u8, encoding: u32, der: *u8, len: u32,
      disposition: u32, out: **u8) i32;
  fn @c(system) CertGetCertificateChain(engine: *u8, cert: *u8, time: *u8, extra: *u8, para: &ChainPara,
      flags: u32, reserved: *u8, chain: &mut *u8) i32;
  fn @c(system) CertVerifyCertificateChainPolicy(oid: usize, chain: *u8, para: &PolicyPara,
      status: &mut PolicyStatus) i32;
  fn @c(system) CertFreeCertificateChain(chain: *u8);
  fn @c(system) CertFreeCertificateContext(cert: *u8) i32;
  fn @c(system) GetLastError() u32;
}

const storeProvMemory = 2usize;               // CERT_STORE_PROV_MEMORY
const encodingX509 = 0x10001u32;              // X509_ASN_ENCODING | PKCS_7_ASN_ENCODING
const storeAddAlways = 4u32;                  // CERT_STORE_ADD_ALWAYS
const policySsl = 4usize;                     // CERT_CHAIN_POLICY_SSL
const authTypeServer = 2u32;                  // AUTHTYPE_SERVER
const chainRevocationEndCert = 0x10000000u32; // CERT_CHAIN_REVOCATION_CHECK_END_CERT
const chainAccumulativeTimeout = 0x08000000u32;  // CERT_CHAIN_REVOCATION_ACCUMULATIVE_TIMEOUT
const chainCacheOnly = 0x4u32;                // CERT_CHAIN_CACHE_ONLY_URL_RETRIEVAL
const chainNoAutoRoots = 0x100u32;            // CERT_CHAIN_DISABLE_AUTH_ROOT_AUTO_UPDATE
const policyIgnoreRevUnknown = 0xF00u32;      // CERT_CHAIN_POLICY_IGNORE_ALL_REV_UNKNOWN_FLAGS
const urlTimeoutMs = 10000u32;                // every fetch of one check, together

// Windows' errors for a certificate this package tells apart
const certExpired = 0x800B0101u32;            // CERT_E_EXPIRED
const certUntrustedRoot = 0x800B0109u32;      // CERT_E_UNTRUSTEDROOT
const certChaining = 0x800B010Au32;           // CERT_E_CHAINING
const certCnNoMatch = 0x800B010Fu32;          // CERT_E_CN_NO_MATCH
const cryptRevoked = 0x80092010u32;           // CRYPT_E_REVOKED
const trustNoSigner = 0x800B0100u32;          // TRUST_E_NOSIGNATURE
const genericFailure = 0x80004005u32;         // E_FAIL

// The OS's verdict on a job: 0 trusted, else Windows' error. On Windows it
// blocks while the chain engine fetches, unless offline; on Linux it fetches
// nothing and reads the system's roots once
fn osVerify(job: &Array[u8], offline: bool) u32 {
  if isWindows() {
    crypt32Verify(job, offline)
  } else {
    opensslVerify(job)
  }
}

// ---------------------------------------------------------------------------
// OpenSSL's own check against the system's roots (Linux)
// ---------------------------------------------------------------------------

let storeOnce: Once;
let storeMade: Atomic[usize];

// The system's roots, once for the process: the file or folder SSL_CERT_FILE
// and SSL_CERT_DIR name when they are set, else OpenSSL's default places
// (Ubuntu's /etc/ssl/certs). Made on the first verification, not in 'init':
// they are read from the environment then, which a program may set in 'main'
// first, and a program that never verifies a chain this way (Windows never
// does) reads no certificates. The Once makes it and an atomic holds its
// address. An X509_STORE is safe to share between threads
fn makeStore() {
  let s = X509_STORE_new();
  if s as usize != 0usize {X509_STORE_set_default_paths(s);}
  storeMade.store(s as usize);
}

fn systemStore() *u8 {
  storeOnce.callOnce(&makeStore);
  storeMade.load() as *u8
}

// The job's chain judged by OpenSSL for the name asked for, as a server's
// chain: 0 trusted, else the Windows error that stands for OpenSSL's verify
// result. The certificates the server sent are untrusted intermediates; only
// the system's roots anchor a chain. No revocation data is read
fn opensslVerify(job: &Array[u8]) u32 {
  if job.len < 8usize {return genericFailure;}
  let base = &job[0usize] as *u8;
  let hostLen = usize.from(readU32(base));
  if 4usize + hostLen + 4usize > job.len {return genericFailure;}
  if hostLen == 0usize {return certCnNoMatch;}
  var at = 4usize + hostLen;
  let count = readU32(base + at);
  at = at + 4usize;
  if count == 0u32 {return trustNoSigner;}
  var leaf = null as *u8;
  let others = OPENSSL_sk_new_null();
  var i = 0u32;
  var bad = false;
  while i < count && !bad {
    if at + 4usize > job.len {
      bad = true;
      break;
    }
    let len = usize.from(readU32(base + at));
    at = at + 4usize;
    if at + len > job.len || len == 0usize {
      bad = true;
      break;
    }
    var p = base + at;
    let x = d2i_X509(null, &mut p, i64.from(len));
    if x as usize == 0usize {
      bad = true;
      break;
    }
    if i == 0u32 {leaf = x;} else {OPENSSL_sk_push(others, x);}
    at = at + len;
    i = i + 1u32;
  }
  var code = genericFailure;
  let store = systemStore();
  let ctx = X509_STORE_CTX_new();
  if !bad && leaf as usize != 0usize && store as usize != 0usize && ctx as usize != 0usize {
    if X509_STORE_CTX_init(ctx, store, leaf, others) == 1i32 {
      // A server's chain: its certificate must allow server authentication
      X509_STORE_CTX_set_default(ctx, &"ssl_server" as *u8);
      let param = X509_STORE_CTX_get0_param(ctx);
      var name = String.empty();
      name.appendBytes(mem.sliceFromParts(base + 4usize, hostLen));
      let cname = name.cstr();
      if isAddress(name.view()) {
        X509_VERIFY_PARAM_set1_ip_asc(param, cname.ptr());
      } else {
        X509_VERIFY_PARAM_set1_host(param, base + 4usize, hostLen);
      }
      if X509_verify_cert(ctx) == 1i32 {
        code = 0u32;
      } else {
        code = windowsCodeOfVerifyResult(X509_STORE_CTX_get_error(ctx));
      }
    }
  }
  if ctx as usize != 0usize {X509_STORE_CTX_free(ctx);}
  if leaf as usize != 0usize {X509_free(leaf);}
  let n = OPENSSL_sk_num(others);
  var k = 0i32;
  while k < n {
    X509_free(OPENSSL_sk_value(others, k));
    k = k + 1i32;
  }
  OPENSSL_sk_free(others);
  ERR_clear_error();
  code
}

// The Windows error this package reports for an OpenSSL verify result
// (X509_V_ERR_...). A chain that stops short of a root the system holds is
// untrusted, as crypt32 says for the test chains whose root it does not know
fn windowsCodeOfVerifyResult(vr: i32) u32 {
  if vr == x509Expired || vr == x509NotYetValid {return certExpired;}
  if vr == x509HostnameMismatch || vr == x509IpMismatch {return certCnNoMatch;}
  if vr == x509UnableToGetIssuer || vr == x509UnableToGetIssuerLocally ||
      vr == x509UnableToVerifyLeafSignature || vr == x509DepthZeroSelfSigned ||
      vr == x509SelfSignedInChain {return certUntrustedRoot;}
  if vr == x509Revoked {return cryptRevoked;}
  genericFailure
}

// Windows' verdict on a job: the chain engine and the SSL policy above
fn crypt32Verify(job: &Array[u8], offline: bool) u32 {
  if job.len < 8usize {return genericFailure;}
  let base = &job[0usize] as *u8;
  let hostLen = usize.from(readU32(base));
  if 4usize + hostLen + 4usize > job.len {return genericFailure;}
  // The name, in UTF-16 (a DNS name is ASCII), with its NUL
  var wide = List[u16].empty();
  var k = 0usize;
  while k < hostLen {
    wide.push(u16.from(job[4usize + k]));
    k = k + 1usize;
  }
  wide.push(0u16);
  var at = 4usize + hostLen;
  let count = readU32(base + at);
  at = at + 4usize;
  if count == 0u32 {return trustNoSigner;}
  let store = CertOpenStore(storeProvMemory, 0u32, 0usize, 0u32, null);
  if store as usize == 0usize {return GetLastError();}
  var leaf = null as *u8;
  var i = 0u32;
  var bad = false;
  while i < count && !bad {
    if at + 4usize > job.len {
      bad = true;
      break;
    }
    let len = usize.from(readU32(base + at));
    at = at + 4usize;
    if at + len > job.len || len == 0usize {
      bad = true;
      break;
    }
    if i == 0u32 {
      if CertAddEncodedCertificateToStore(store, encodingX509, base + at, u32.from(len), storeAddAlways,
          &mut leaf as **u8) == 0i32 {bad = true;}
    } else {
      CertAddEncodedCertificateToStore(store, encodingX509, base + at, u32.from(len), storeAddAlways, null);
    }
    at = at + len;
    i = i + 1u32;
  }
  if bad || leaf as usize == 0usize {
    if leaf as usize != 0usize {CertFreeCertificateContext(leaf);}
    CertCloseStore(store, 0u32);
    return genericFailure;
  }
  // For a server: its certificate must allow server authentication
  var oid = &"1.3.6.1.5.5.7.3.1" as *u8;
  let none = EnhKeyUsage(0u32, null);
  let para = ChainPara(size: u32.from(mem.sizeof[ChainPara]()),
    usage: UsageMatch(0u32, EnhKeyUsage(1u32, &mut oid as **u8)),
    issuancePolicy: UsageMatch(0u32, none), urlTimeout: urlTimeoutMs, checkFreshness: 0i32,
    freshness: 0u32, cacheResync: null, strongSign: null, strongSignFlags: 0u32);
  var flags = chainRevocationEndCert | chainAccumulativeTimeout;
  if offline {flags = flags | chainCacheOnly | chainNoAutoRoots;}
  var chain = null as *u8;
  if CertGetCertificateChain(null, leaf, null, store, &para, flags, null, &mut chain) == 0i32 {
    let e = GetLastError();
    CertFreeCertificateContext(leaf);
    CertCloseStore(store, 0u32);
    return if e == 0u32 {genericFailure} else {e};
  }
  var ssl = SslPolicyPara(u32.from(mem.sizeof[SslPolicyPara]()), authTypeServer, 0u32,
    &mut (wide.viewMut())[0usize] as *u16);
  let pp = PolicyPara(u32.from(mem.sizeof[PolicyPara]()), policyIgnoreRevUnknown, &mut ssl as *u8);
  var ps = PolicyStatus(u32.from(mem.sizeof[PolicyStatus]()), 0u32, 0i32, 0i32, null);
  var code = 0u32;
  if CertVerifyCertificateChainPolicy(policySsl, chain, &pp, &mut ps) == 0i32 {
    code = GetLastError();
    if code == 0u32 {code = genericFailure;}
  } else {
    code = ps.error;
  }
  CertFreeCertificateChain(chain);
  CertFreeCertificateContext(leaf);
  CertCloseStore(store, 0u32);
  code
}

fn readU32(p: *u8) u32 {
  u32.from(*p) | (u32.from(*(p + 1usize)) << 8u32) | (u32.from(*(p + 2usize)) << 16u32) |
    (u32.from(*(p + 3usize)) << 24u32)
}

// A certificate the OS refused: its kind, and its words
fn certError(code: u32) TlsError {
  var k: TlsErrorKind = TlsErrorKind.CertOther;
  if code == certExpired {k = TlsErrorKind.CertExpired;}
  else if code == certCnNoMatch {k = TlsErrorKind.CertNameMismatch;}
  else if code == certUntrustedRoot || code == certChaining {k = TlsErrorKind.CertUntrusted;}
  else if code == cryptRevoked {k = TlsErrorKind.CertRevoked;}
  var e = osError(code, "");
  e.kind = k;
  e
}

// The OS's verifier's job that did not run, as a TlsError: iocore's words
// for its IoError, and its number, the system's own (Windows' error number,
// or the errno on Linux; 0 for a cancel or a deadline)
fn jobError(e: &IoError) TlsError {
  var d = String.from("the OS's verifier could not be run: ");
  let text = e.message();
  d.append(text.view());
  TlsError(TlsErrorKind.CertOther, e.code, e.code, d)
}

// Windows' error code as a TlsError: its text and its number. On Linux the
// code is the Windows number the verifier mapped OpenSSL's result to, and
// iocore's IoError has Windows' words for it
fn osError(code: u32, what: &str) TlsError {
  var d = String.from(what);
  if d.len() > 0usize {d.append(": ");}
  let text = IoError(code).message();
  d.append(text.view());
  d.append(" (Windows 0x");
  d.appendHex(u64.from(code), 8usize);
  d.append(")");
  TlsError(TlsErrorKind.CertOther, code, code, d)
}
