// Contexts: a Client or a Server, an OpenSSL SSL_CTX and what its sessions
// share. How it is built. The SSL_CTX and what goes with it (the verifier's
// kind and pins, the ALPN list a server chooses from, the client's cache of
// sessions to resume) are a CtxState behind an 'Arc[Mutex, ...]': copying a
// Client or a Server shares it, between threads too, and every Session made
// from it holds one owner, so a context outlives its sessions (OpenSSL's
// callbacks read the ALPN list a server's state holds). Each session's
// SSL object also holds its own reference on the SSL_CTX, OpenSSL's way.
//
// The client's cache. OpenSSL hands over each session to resume as it comes
// (SSL_CTX_sess_set_new_cb): a TLS 1.3 ticket when it arrives after the
// handshake, a TLS 1.2 session as the handshake ends. Its callback,
// newSession, touches nothing of Cone's but the session's own list of
// arrivals, a block of memory in the SSL object's ticket slot; the session
// moves them into the cache once OpenSSL's call has returned
// (Session.harvest), so this lock is never taken inside OpenSSL, whichever
// thread drives the session, and under it OpenSSL is asked only about and
// to count a session's references (SSL_SESSION_is_resumable, _up_ref,
// _free, _get_protocol_version), none of which calls back. So a connection opened while another to the
// same server is still open resumes from the tickets that one was sent.
// A TLS 1.3 ticket is used once: it is taken out of the cache to resume,
// and a server sends several (OpenSSL's, two after a full handshake), kept
// up to maxPerServer so that connections opened at once each resume. A TLS
// 1.2 session may be resumed again and again: it stays in the cache, one
// for each server, shared by every connection resuming it.

const maxCached = 256usize;      // sessions a client keeps to resume, at most
const maxPerServer = 8usize;     // TLS 1.3 tickets kept for one server, at most

// A cached session: which server it is for, and OpenSSL's SSL_SESSION
struct Cached {
  key String;
  sess *u8;
}

// A context's state. It declares Sendable, a promise taken on trust, for
// OpenSSL's pointers: an SSL_CTX is safe to use from any thread (OpenSSL's
// own locks), and the cache's sessions are reached only under the Arc's lock
struct CtxState is Sendable {
  ctx *u8;
  server bool;
  kind VerifyKind;
  pins List[u8];
  resume bool;
  lane Lane;
  offline bool;
  alpn *u8;               // a server's: the length (u32), then ALPN's wire format
  cache List[Cached];     // oldest first

  // A session for 'key' to resume, or null: the newest the cache holds for
  // it. A TLS 1.3 ticket is taken out (it is used once); a TLS 1.2 session
  // stays, and the caller is given a reference of its own. One OpenSSL has
  // marked not resumable (its connection failed) is dropped on the way
  fn takeCached(self &mut, key &Array[u8]) *u8 {
    mut k = cache.len();
    while k > 0usize {
      k = k - 1usize;
      if cache[k].key.view() != key {continue;}
      imm s = cache[k].sess;
      if SSL_SESSION_is_resumable(s) != 1i32 {
        self.dropAt(k);
      } elif SSL_SESSION_get_protocol_version(s) == tls13Version {
        self.removeAt(k);
        return s;
      } else {
        SSL_SESSION_up_ref(s);
        return s;
      }
    }
    null;
  }

  // Keep a session to resume 'key' with; the cache takes the reference. A
  // TLS 1.3 ticket joins the server's others, its oldest going past
  // maxPerServer; a TLS 1.2 session replaces what the server had; past
  // maxCached in all, the oldest goes
  fn putCached(self &mut, key &Array[u8], sess *u8) {
    imm tls13 = SSL_SESSION_get_protocol_version(sess) == tls13Version;
    mut held = 0usize;
    mut k = cache.len();
    while k > 0usize {
      k = k - 1usize;
      if cache[k].key.view() != key {continue;}
      if cache[k].sess as usize == sess as usize {
        // Already here: a TLS 1.2 session handed back by its connection
        SSL_SESSION_free(sess);
        return;
      }
      if not tls13 {
        self.dropAt(k);
      } elif held + 1usize >= maxPerServer {
        self.dropAt(k);
      } else {
        held = held + 1usize;
      }
    }
    if cache.len() >= maxCached {self.dropAt(0usize);}
    cache.push(new Cached(String.from(key as &str), sess));
  }

  // The entry at k out of the cache, its session freed, the order kept
  fn dropAt(self &mut, k usize) {
    SSL_SESSION_free(cache[k].sess);
    self.removeAt(k);
  }

  // The entry at k out of the cache, its session the caller's, the order kept
  fn removeAt(self &mut, k usize) {
    mut j = k;
    while j + 1usize < cache.len() {
      cache.swap(j, j + 1usize);
      j = j + 1usize;
    }
    cache.pop();
  }

  fn cachedCount(self &) usize {cache.len();}

  fn final(self &uni) {
    mut k = 0usize;
    while k < cache.len() {
      SSL_SESSION_free(cache[k].sess);
      k = k + 1usize;
    }
    if alpn as usize != 0usize {libc.free(alpn);}
    SSL_CTX_free(ctx);
  }
}

alias Shared = Arc[Mutex, CtxState];

// ALPN's wire format: each name after its length in one byte
fn alpnWire(names &List[String]) List[u8] {
  mut out = List[u8].empty();
  mut k = 0usize;
  while k < names.len() {
    imm n = names[k].view();
    if n.len > 0usize and n.len < 256usize {
      out.push(u8.from(n.len));
      mut j = 0usize;
      while j < n.len {
        out.push(n[j]);
        j = j + 1usize;
      }
    }
    k = k + 1usize;
  }
  out;
}

// What OpenSSL's error queue says, as one line, the queue emptied; and the
// first error's code
fn sslErrors(out &mut String) u32 {
  mut first = 0u32;
  mut buf = new Array[u8, 256] <- fill 0u8;
  while true {
    imm e = ERR_get_error();
    if e == 0u32 {break;}
    if first == 0u32 {
      first = e;
      ERR_error_string_n(e, &mut buf as *u8, 256usize);
      if out.len() > 0usize {out.append(": ");}
      out.append(cText(&mut buf as *u8) as &str);
    }
  }
  first;
}

// A context's configuration failed: why
fn configError(what &Array[u8]) TlsError {
  mut d = String.from(what as &str);
  imm code = sslErrors(&mut d);
  new TlsError(TlsErrorKind.Config[], code, 0u32, d);
}

// A new SSL_CTX with the versions, options and buffers every one takes
fn newCtx(method *u8, minV TlsVersion, maxV TlsVersion) *u8 {
  ERR_clear_error();
  imm ctx = SSL_CTX_new(method);
  if ctx as usize == 0usize {return null;}
  SSL_CTX_ctrl(ctx, ctrlSetMinProtoVersion, versionNumber(minV), null);
  SSL_CTX_ctrl(ctx, ctrlSetMaxProtoVersion, versionNumber(maxV), null);
  SSL_CTX_set_options(ctx, opNoRenegotiation);
  // An idle connection keeps no read or write buffer: 55 KB less a client
  // and server pair (measured, examples/bench.cone)
  SSL_CTX_ctrl(ctx, ctrlMode, modeReleaseBuffers, null);
  ctx;
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

// A client's context: what its sessions share (see the package's header,
// CONFIGURATION). Copied to share it
pub struct Client {
  state Shared;

  // A client context, or why it could not be made (Config: a root bundle
  // holding no certificate)
  pub fn make(cfg ClientConfig) Result[Client, TlsError] {
    imm ctx = newCtx(TLS_client_method(), cfg.minVersion, cfg.maxVersion);
    if ctx as usize == 0usize {return Error[Client, TlsError][configError("SSL_CTX_new failed")];}
    // Sessions are cached here, not in OpenSSL's own cache: OpenSSL hands
    // each over as it comes (see the header)
    imm resume = cfg.resume and ticketSlot() >= 0i32;
    if resume {
      SSL_CTX_ctrl(ctx, ctrlSessCacheMode, sessCacheClient | sessCacheNoInternalStore, null);
      SSL_CTX_sess_set_new_cb(ctx, &newSession);
    } else {
      SSL_CTX_ctrl(ctx, ctrlSessCacheMode, sessCacheOff, null);
    }
    imm wire = alpnWire(&cfg.alpn);
    if wire.len() > 0usize {
      imm w = wire.view();
      SSL_CTX_set_alpn_protos(ctx, &w[0usize] as *u8, u32.from(w.len));
    }
    imm kind = cfg.verify.kind;
    if kind == VerifyKind.Insecure[] {
      SSL_CTX_set_verify(ctx, verifyNone, null);
    } elif kind == VerifyKind.Roots[] {
      SSL_CTX_set_verify(ctx, verifyPeer, null);
      imm n = loadRoots(ctx, cfg.verify.bundle.view());
      if n == 0u32 {
        SSL_CTX_free(ctx);
        return Error[Client, TlsError][configError("the root bundle holds no certificate")];
      }
    } else {
      // The OS's verifier and pinning: OpenSSL hands the chain to
      // verifyChain, which stops the handshake until the session's verdict
      SSL_CTX_set_verify(ctx, verifyPeer, null);
      SSL_CTX_set_cert_verify_callback(ctx, &verifyChain, null);
    }
    mut pins = List[u8].empty();
    mut k = 0usize;
    while k < cfg.verify.pins.len() {
      pins.push(*cfg.verify.pins[k]);
      k = k + 1usize;
    }
    imm st = new Shared(new CtxState(ctx: ctx, server: false, kind: kind, pins: pins,
      resume: resume, lane: cfg.verifyLane, offline: cfg.offline, alpn: null,
      cache: List[Cached].empty()));
    Ok[Client, TlsError][new Client(st)];
  }

  // A session with the server named serverName (a DNS name, sent by SNI and
  // checked against its certificate; or an IP address, checked only)
  pub fn session(self &, serverName &Array[u8]) Session {Session.client(state, serverName);}

  // The same, as a Layer for httpconn's driver, its buffers from pool
  pub fn stream(self &, serverName &Array[u8], pool Pool) Stream {
    Stream.make(Session.client(state, serverName), pool);
  }

  // Sessions kept to resume
  pub fn cachedSessions(self &) usize {(&*state).cachedCount();}
}

// The certificates of a PEM bundle into a context's store: how many
fn loadRoots(ctx *u8, pem &Array[u8]) u32 {
  if pem.len == 0usize {return 0u32;}
  imm bio = BIO_new_mem_buf(&pem[0usize] as *u8, i32.from(pem.len));
  imm store = SSL_CTX_get_cert_store(ctx);
  mut n = 0u32;
  while true {
    imm x = PEM_read_bio_X509(bio, null, null, null);
    if x as usize == 0usize {break;}
    if X509_STORE_add_cert(store, x) == 1i32 {n = n + 1u32;}
    X509_free(x);
  }
  BIO_free(bio);
  // The read past the last certificate leaves "no start line" queued
  ERR_clear_error();
  n;
}

// ---------------------------------------------------------------------------
// Server
// ---------------------------------------------------------------------------

// A server's context (see the package's header, CONFIGURATION). Copied to
// share it
pub struct Server {
  state Shared;

  // A server context, or why it could not be made (Config: a file that
  // could not be read, a key that is not the certificate's)
  pub fn make(cfg ServerConfig) Result[Server, TlsError] {
    imm ctx = newCtx(TLS_server_method(), cfg.minVersion, cfg.maxVersion);
    if ctx as usize == 0usize {return Error[Server, TlsError][configError("SSL_CTX_new failed")];}
    mut cert = cfg.certFile.copy();
    if SSL_CTX_use_certificate_chain_file(ctx, cert.cstr()) != 1i32 {
      SSL_CTX_free(ctx);
      mut what = String.from("the certificate chain could not be loaded from ");
      what.append(cfg.certFile.view());
      return Error[Server, TlsError][configError(what.view())];
    }
    mut key = cfg.keyFile.copy();
    if SSL_CTX_use_PrivateKey_file(ctx, key.cstr(), filetypePem) != 1i32 {
      SSL_CTX_free(ctx);
      mut what = String.from("the private key could not be loaded from ");
      what.append(cfg.keyFile.view());
      return Error[Server, TlsError][configError(what.view())];
    }
    if SSL_CTX_check_private_key(ctx) != 1i32 {
      SSL_CTX_free(ctx);
      return Error[Server, TlsError][configError("the private key is not the certificate's")];
    }
    // The ALPN list the select callback chooses from: its length, then the
    // wire format, in memory the state frees
    imm wire = alpnWire(&cfg.alpn);
    imm block = libc.malloc(4usize + wire.len());
    *(block as *u32) = u32.from(wire.len());
    if wire.len() > 0usize {
      imm w = wire.view();
      libc.memcpy(block + 4usize, &w[0usize] as *u8, w.len);
    }
    SSL_CTX_set_alpn_select_cb(ctx, &alpnSelect, block);
    imm st = new Shared(new CtxState(ctx: ctx, server: true, kind: VerifyKind.Insecure[],
      pins: List[u8].empty(), resume: false, lane: defaultVerifyLane(), offline: false, alpn: block,
      cache: List[Cached].empty()));
    Ok[Server, TlsError][new Server(st)];
  }

  // A session with one client
  pub fn session(self &) Session {Session.server(state);}

  // The same, as a Layer for httpconn's driver, its buffers from pool
  pub fn stream(self &, pool Pool) Stream {Stream.make(Session.server(state), pool);}
}

// OpenSSL asks a server which of the protocols a client offers it speaks:
// its own first choice among them, or a fatal no_application_protocol
fn @c("coneTlsAlpnSelect") alpnSelect(ssl *u8, out &mut *u8, outLen &mut u8, offered *u8,
    offeredLen u32, arg *u8) i32 {
  imm len = *(arg as *u32);
  mut chosen = null as *u8;
  mut chosenLen = 0u8;
  if SSL_select_next_proto(&mut chosen, &mut chosenLen, arg + 4usize, len, offered, offeredLen) != npnNegotiated {
    return tlsextErrAlertFatal;
  }
  *out = chosen;
  *outLen = chosenLen;
  tlsextErrOk;
}

// ---------------------------------------------------------------------------
// Sessions to resume, as they come
// ---------------------------------------------------------------------------

// A client session's arrivals: a block of memory its SSL object's ticket
// slot points to, a count and then up to maxArrivals SSL_SESSIONs, each a
// pointer's size. The session empties it after each of OpenSSL's calls
const maxArrivals = 8usize;

fn arrivalsMake() *u8 {
  imm b = libc.malloc(mem.sizeof[usize]() * (1usize + maxArrivals));
  *(b as *usize) = 0usize;
  b;
}

// The n-th arrival's place in a block
fn arrivalAt(b *u8, n usize) *usize {(b + mem.sizeof[usize]() * (1usize + n)) as *usize;}

// OpenSSL hands a client session over to be kept, to resume its server
// with (SSL_CTX_sess_set_new_cb): a TLS 1.3 ticket after the handshake, a
// TLS 1.2 session as it ends. It goes on the session's arrivals, nothing of
// Cone's touched but them and no lock taken; 1 keeps OpenSSL's reference,
// 0 gives it back (no arrivals block, or the block is full)
fn @c("coneTlsNewSession") newSession(ssl *u8, sess *u8) i32 {
  imm b = SSL_get_ex_data(ssl, ticketSlot());
  if b as usize == 0usize {return 0i32;}
  imm n = *(b as *usize);
  if n >= maxArrivals {return 0i32;}
  *arrivalAt(b, n) = sess as usize;
  *(b as *usize) = n + 1usize;
  1i32;
}
