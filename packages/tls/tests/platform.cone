// The platform verifier against the machine's own roots, in memory. On Linux
// that is OpenSSL's check against the system's store, which SSL_CERT_FILE
// can name; here it names the test root (tests/certs/ca.pem), so the
// verifier can say yes, which it cannot to any test chain otherwise. Checked:
// a chain the root signed is accepted for its name and for its address; a
// wrong name, an expired certificate and a chain from another root are each
// refused with the Windows error the package reports for that failure
// (CERT_E_CN_NO_MATCH, CERT_E_EXPIRED, CERT_E_UNTRUSTEDROOT).
//
// On Windows the platform verifier is crypt32's, which has the machine's
// roots and ignores SSL_CERT_FILE: this test then says so and checks
// nothing (tests/loopback.cone and memory.cone show it refusing the test
// root there).

mod platform;

import stdio use *;
import testing use *;
import env;
import path use Path;
import collections use String;
import tls;

// A file of the certificates' folder, tests/certs: congo test runs a test
// in build/<mode>/tests/<name>/, four folders below the package's
fn certs(name &str) Path {
  mut p = String.from("../../../../tests/certs/");
  p.append(name);
  Path.fromString(p);
}

fn client() tls.Client {
  mut cfg = tls.ClientConfig.make();
  cfg.verify = tls.Verifier.platform();
  cfg.offline = true;
  match tls.Client.make(cfg) {
    case mut r Ok {return r;}
    case imm e Error {
      printStr(e.message().view());
      printStr("\n");
    }
  }
  panic("the client context could not be made");
}

fn server(cert &str, key &str) tls.Server {
  imm certFile = certs(cert);
  imm keyFile = certs(key);
  imm cfg = tls.ServerConfig.make(&certFile, &keyFile);
  match tls.Server.make(cfg) {
    case mut r Ok {return r;}
    case imm e Error {
      printStr(e.message().view());
      printStr("\n");
    }
  }
  panic("the server context could not be made");
}

// Move what each side has to send to the other until neither has any; the
// platform verifier, when asked for, is run here
fn pump(c &mut tls.Session, s &mut tls.Session) {
  mut buf = new Array[u8, 20000] <- fill 0u8;
  mut moved = true;
  while moved {
    moved = false;
    if c.wantsVerify() {c.verifyNow();}
    while c.pending() > 0usize {
      imm n = c.transmit(&mut buf[0usize ..< 20000usize]);
      s.feed(&buf[0usize ..< n]);
      moved = true;
    }
    while s.pending() > 0usize {
      imm n = s.transmit(&mut buf[0usize ..< 20000usize]);
      c.feed(&buf[0usize ..< n]);
      moved = true;
    }
  }
}

fn kindName(s &tls.Session) &str {
  if s.isFailed() {tls.errorName(s.error().kind);} else {"none";}
}

// A handshake that must succeed
fn accepted(label &str, c &mut tls.Session, s &mut tls.Session) {
  pump(c, s);
  printStr(label);
  printStr(": ");
  printStr(if c.isOpen() {"open";} else {"not open";});
  printStr(", verified by ");
  printStr(tls.verifyKindName(c.info().verifiedBy));
  printStr("\n");
  expect(c.isOpen() and s.isOpen(), label);
  expect(c.info().verifiedBy == tls.VerifyKind.Platform, "...and the platform verifier decided");
}

// A handshake that must fail: the client's error kind, its words and the
// Windows error number
fn refused(label &str, c &mut tls.Session, s &mut tls.Session, want tls.TlsErrorKind, code u64) {
  pump(c, s);
  printStr(label);
  printStr(": client ");
  printStr(kindName(c));
  printStr("\n");
  if c.isFailed() {
    printStr("  ");
    printStr(c.error().message().view());
    printStr("\n");
  }
  expect(c.isFailed() and c.error().kind == want, label);
  expectUInt(u64.from(c.error().osError), code, "...with Windows' error number");
  expect(not c.isOpen() and not s.isOpen(), "neither side is open");
}

fn main() i32 {
  if isWindows() {
    printStr("the platform verifier is crypt32's on Windows: see loopback and memory\n");
    return done();
  }
  // The system's roots are the test root, for this process: set before the
  // verifier first reads them
  imm ca = certs("ca.pem");
  env.set("SSL_CERT_FILE", ca.view());

  imm good = server("server.pem", "server.key");
  imm cl = client();
  mut c = cl.session("localhost");
  mut s = good.session();
  accepted("localhost", &mut c, &mut s);
  c = cl.session("127.0.0.1");
  s = good.session();
  accepted("127.0.0.1", &mut c, &mut s);

  c = cl.session("wrong.example");
  s = good.session();
  refused("wrong name", &mut c, &mut s, tls.TlsErrorKind.CertNameMismatch, 0x800B010Fu64);
  c = cl.session("10.1.2.3");
  s = good.session();
  refused("wrong address", &mut c, &mut s, tls.TlsErrorKind.CertNameMismatch, 0x800B010Fu64);

  imm expired = server("expired.pem", "expired.key");
  c = cl.session("localhost");
  s = expired.session();
  refused("expired", &mut c, &mut s, tls.TlsErrorKind.CertExpired, 0x800B0101u64);

  imm other = server("untrusted.pem", "untrusted.key");
  c = cl.session("localhost");
  s = other.session();
  refused("another root", &mut c, &mut s, tls.TlsErrorKind.CertUntrusted, 0x800B0109u64);
  done();
}
