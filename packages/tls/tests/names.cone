// The text of tls's enums, every variant: a verifier kind's lower-case name, an error
// kind's words. Pinned so the text cannot drift when the way it is asked for changes.

mod names;

import testing use *;
import tls use *;

fn main() i32 {
  expectStr(verifyKindName(VerifyKind.Platform), "platform", "Platform");
  expectStr(verifyKindName(VerifyKind.Roots), "roots", "Roots");
  expectStr(verifyKindName(VerifyKind.Pinned), "pinned", "Pinned");
  expectStr(verifyKindName(VerifyKind.Insecure), "insecure", "Insecure");
  expectStr(TlsErrorKind.CertExpired.name(), "certificate expired", "CertExpired");
  expectStr(TlsErrorKind.CertNameMismatch.name(), "certificate name mismatch", "CertNameMismatch");
  expectStr(TlsErrorKind.CertUntrusted.name(), "certificate untrusted", "CertUntrusted");
  expectStr(TlsErrorKind.CertRevoked.name(), "certificate revoked", "CertRevoked");
  expectStr(TlsErrorKind.CertOther.name(), "certificate refused", "CertOther");
  expectStr(TlsErrorKind.ProtocolVersion.name(), "protocol version", "ProtocolVersion");
  expectStr(TlsErrorKind.NoAlpnMatch.name(), "no application protocol", "NoAlpnMatch");
  expectStr(TlsErrorKind.Alert.name(), "alert", "Alert");
  expectStr(TlsErrorKind.Protocol.name(), "protocol error", "Protocol");
  expectStr(TlsErrorKind.Config.name(), "configuration", "Config");
  expectStr(TlsErrorKind.Backend.name(), "back end", "Backend");
  done()
}
