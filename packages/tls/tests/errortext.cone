// The one line each error of this package gives a person is pinned here, with the
// number fields in play, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use String;
import tls use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- TlsError.make(TlsErrorKind.CertUntrusted, 20u32, "unable to get local issuer certificate"), "tls: certificate untrusted: unable to get local issuer certificate", "kind and detail");
  done()
}
