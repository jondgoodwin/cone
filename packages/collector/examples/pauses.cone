// Short pauses: the collector works a step at a time while the program runs,
// and the write barrier keeps it right while the program rewires what it has
// already marked.
//
//   congo run packages/collector/examples/pauses.cone
//
// The program keeps a tree of 4,095 nodes for the whole run, and churns: it
// makes 61,440 short-lived nodes, and 20,480 times it grafts a new node under
// one of the tree's 2,048 bottom nodes, replacing the one grafted there before
// -- a store into an object the collector may already have marked black,
// while a collection is marking. Collections start whenever the heap passes
// its trigger, and each runs as a series of steps inside allocations, each
// step a bounded piece of work: at most about 16 KiB of objects marked, swept
// or finalized, however large the heap. A stop-the-world collection would
// instead mark the whole kept tree and sweep the whole heap in one pause.
//
// At the end the tree must still be whole: its 4,095 nodes and the 2,048
// grafted ones, none lost. A graft the barrier missed would have been freed
// while the tree held it. Run it with CONE_GC_STRESS=1 in the environment to
// step at every allocation instead.

mod pauses;

import stdio use *;
import collector;

struct Node {
  pub n i64;
  pub left Option[+gc-mut Node];
  pub right Option[+gc-mut Node];
}

fn none() Option[+gc-mut Node] {
  None[+gc-mut Node][];
}

// A tree of the given depth, each node numbered by its depth: the bottom
// nodes are 1
fn grow(depth i64) Option[+gc-mut Node] {
  if depth == 0 {
    return none();
  }
  Some[+gc-mut Node][+gc-mut Node[depth, grow(depth - 1), grow(depth - 1)]];
}

// Graft a new node, numbered 100, under the bottom node the bits of 'path'
// lead to, in place of whatever was grafted there. Matched by value, like
// count and sum: through the 'mut' nodes an Option hangs from, a reference
// into it could see another reference empty it while in use. The graft is
// still stored into the tree's own node, which the copy points to.
fn graft(t Option[+gc-mut Node], path i64) {
  match t {
    case imm s Some[+gc-mut Node] {
      if s.value.n == 1 {
        s.value.left = Some[+gc-mut Node][+gc-mut Node[100, none(), none()]];
      }
      else if path % 2 == 0 {
        graft(s.value.left, path / 2);
      }
      else {
        graft(s.value.right, path / 2);
      }
    }
    else { }
  }
}

fn count(t Option[+gc-mut Node]) i64 {
  match t {
    case imm s Some[+gc-mut Node] { count(s.value.left) + count(s.value.right) + 1; }
    else { 0; }
  }
}

fn sum(t Option[+gc-mut Node]) i64 {
  match t {
    case imm s Some[+gc-mut Node] { s.value.n + sum(s.value.left) + sum(s.value.right); }
    else { 0; }
  }
}

// Short-lived: made and dropped
fn junk(k i64) i64 {
  imm a = +gc-mut Node[k, none(), none()];
  imm b = +gc-mut Node[k, none(), none()];
  imm c = +gc-mut Node[k, Some[+gc-mut Node][a], Some[+gc-mut Node][b]];
  c.n;
}

fn line(label &[]u8, n i64) {
  printStr(label); printInt(n); printStr("\n");
}

fn main() {
  imm tree = grow(12);
  line("kept tree, nodes: ", count(tree));
  line("  bytes live: ", i64[gc.liveBytes()]);

  mut i = 0i64;
  while i < 20480 {
    graft(tree, i % 2048);
    junk(i);
    i = i + 1;
  }

  line("collections: ", i64[gc.collections()]);
  line("steps: ", i64[gc.steps()]);
  line("the longest step, bytes of work: ", i64[gc.largestStep()]);
  line("objects freed: ", i64[gc.freed()]);

  // 4,095 nodes and 2,048 grafts; the tree's numbers sum to 1*2048 + 2*1024
  // + ... + 12*1 = 8,178, and the grafts to 204,800
  line("tree now, nodes (6143 expected): ", count(tree));
  line("  sum (212978 expected): ", sum(tree));
}
