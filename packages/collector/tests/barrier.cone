// The write barrier, where it matters: a reference stored into an object the
// collector has already marked black, while it is still marking. Without the
// barrier the stored object is never marked -- the black object is not traced
// again, and the only other path to it is gone -- so the collector would
// finalize it, and then free it, while the black object still holds it.
//
// Each case builds the same heap, with the automatic work stopped so that
// nothing but the case's own Gc.step() calls advances the collection:
//   h: a Box, empty, a local of the case
//   c: a Hop2 -> a Hop -> a Box w, whose 'leaf' holds a Leaf; c a local
// The case starts a collection with Gc.step(0), which traces the roots: c,
// then h, so h is on top of the gray list; one more Gc.step(0) marks h black
// (it holds nothing yet). c, the Hop, w and the leaf are still unmarked, and
// the case checks so. Then a function of the case moves the leaf from w into
// h -- through a '+Gc' reference, a borrow, an array element, a slice, a
// swap, ':=', a whole Box stored over h -- or stores a new Leaf into h, and
// returns, so no stack slot holds the leaf any more. The collection is then
// finished one step at a time. The leaf is still reached, through h, so it
// must not be finalized, and must still read its number. A Leaf's 'final'
// counts, so a lost leaf shows as a finalizer run.
//
// With the barrier the leaf is shaded as it is stored, and every check
// passes. With 'writeBarrier' doing nothing, every case fails: its leaf is
// finalized by the collection that should have kept it.

mod barrier;

import testing use *;
import collector;

mut finals = 0i64;
struct LeafValue {
  pub n i64;
  fn final(self &uni) { finals = finals + 1; }
}
alias Leaf = Gc[mut, LeafValue];
struct BoxValue {
  pub leaf Option[Leaf];
  pub cells [2; Option[Leaf]];
}
alias Box = Gc[mut, BoxValue];
struct HopValue { pub to Box; }
alias Hop = Gc[mut, HopValue];
struct Hop2Value { pub to Hop; }
alias Hop2 = Gc[mut, Hop2Value];

fn settle() {
  Gc.collect();
  Gc.collect();
}

fn none() Option[Leaf] {
  None[Leaf][];
}
fn emptyBox() Box {
  +Gc-mut BoxValue[none(), [none(), none()]];
}
// c -> Hop -> w, w holding Leaf n: made here, so no frame of the case holds
// the leaf, the Hop or w
fn chain(n i64) Hop2 {
  imm w = emptyBox();
  w.leaf = Some[Leaf][+Gc-mut LeafValue[n]];
  +Gc-mut Hop2Value[+Gc-mut HopValue[w]];
}

// Matched by value: through the 'mut' Box an Option hangs from, a reference
// into it could see another reference empty it while in use
fn leafOf(o Option[Leaf]) i64 {
  match o {
    case imm s Some[Leaf] { s.value.n; }
    else { -1; }
  }
}

// The colour bits of the object whose value is at p: it sits right after its
// 32-byte header (every type here is aligned to 8)
fn isBlack(p *u8) Bool {
  ((p as usize - mem.sizeof[Gc]()) as &Gc).marked & 4u32 != 0u32;
}

// A collection marking, h black, and c and w not yet marked
fn markedH(h Box, c Hop2) Bool {
  imm w = c.to.to;
  Gc.phase() == 1u32 and isBlack(&*h as *u8) and !isBlack(&*c as *u8) and !isBlack(&*w as *u8);
}

// Finish the collection a step at a time; whether no leaf was finalized
fn finish(f0 i64) Bool {
  while !Gc.step(0usize) { }
  finals == f0;
}

// -- The moves, each in a function of its own, so its stack slots are gone
// before the collection ends
fn viaRef(h Box, c Hop2) {
  imm w = c.to.to;
  h.leaf = w.leaf;
  w.leaf = none();
}
fn setThrough(dst &mut BoxValue, src &mut BoxValue) {
  dst.leaf = src.leaf;
  src.leaf = none();
}
fn viaBorrow(h Box, c Hop2) {
  imm w = c.to.to;
  setThrough(&mut *h, &mut *w);
}
fn viaElement(h Box, c Hop2) {
  imm w = c.to.to;
  h.cells[1] = w.leaf;
  w.leaf = none();
}
fn putFirst(s &[]mut Option[Leaf], v Option[Leaf]) {
  s[0] = v;
}
fn viaSlice(h Box, c Hop2) {
  imm w = c.to.to;
  putFirst(&mut h.cells, w.leaf);
  w.leaf = none();
}
fn viaSwap(h Box, c Hop2) {
  imm w = c.to.to;
  h.leaf <=> w.leaf;
}
fn viaLeftAssign(h Box, c Hop2) {
  imm w = c.to.to;
  w.leaf = h.leaf := w.leaf;
}
fn viaWhole(h Box, c Hop2) {
  imm w = c.to.to;
  *h = BoxValue[w.leaf, [none(), none()]];
  w.leaf = none();
}
fn viaNew(h Box, c Hop2) {
  h.leaf = Some[Leaf][+Gc-mut LeafValue[7]];
}

// -- Each case: the heap built, h black, the move, the collection finished
fn caseRef() {
  imm c = chain(42);
  imm h = emptyBox();
  Gc.step(0usize);
  Gc.step(0usize);
  expect(markedH(h, c), "via a +Gc reference: h black, the leaf's holders not yet marked");
  imm f0 = finals;
  viaRef(h, c);
  expect(finish(f0), "the leaf stored into black h is not finalized");
  expectInt(leafOf(h.leaf), 42, "and h holds it");
}
fn caseBorrow() {
  imm c = chain(43);
  imm h = emptyBox();
  Gc.step(0usize);
  Gc.step(0usize);
  expect(markedH(h, c), "via a borrow: h black, the leaf's holders not yet marked");
  imm f0 = finals;
  viaBorrow(h, c);
  expect(finish(f0), "the leaf stored through a borrow is not finalized");
  expectInt(leafOf(h.leaf), 43, "and h holds it");
}
fn caseElement() {
  imm c = chain(44);
  imm h = emptyBox();
  Gc.step(0usize);
  Gc.step(0usize);
  expect(markedH(h, c), "into an array: h black, the leaf's holders not yet marked");
  imm f0 = finals;
  viaElement(h, c);
  expect(finish(f0), "the leaf stored into an element of black h is not finalized");
  expectInt(leafOf(h.cells[1]), 44, "and h's cell holds it");
}
fn caseSlice() {
  imm c = chain(45);
  imm h = emptyBox();
  Gc.step(0usize);
  Gc.step(0usize);
  expect(markedH(h, c), "into a slice: h black, the leaf's holders not yet marked");
  imm f0 = finals;
  viaSlice(h, c);
  expect(finish(f0), "the leaf stored through a slice of black h's array is not finalized");
  expectInt(leafOf(h.cells[0]), 45, "and h's cell holds it");
}
fn caseSwap() {
  imm c = chain(46);
  imm h = emptyBox();
  Gc.step(0usize);
  Gc.step(0usize);
  expect(markedH(h, c), "by swap: h black, the leaf's holders not yet marked");
  imm f0 = finals;
  viaSwap(h, c);
  expect(finish(f0), "the leaf swapped into black h is not finalized");
  expectInt(leafOf(h.leaf), 46, "and h holds it");
}
fn caseLeftAssign() {
  imm c = chain(47);
  imm h = emptyBox();
  Gc.step(0usize);
  Gc.step(0usize);
  expect(markedH(h, c), "by := : h black, the leaf's holders not yet marked");
  imm f0 = finals;
  viaLeftAssign(h, c);
  expect(finish(f0), "the leaf stored into black h by := is not finalized");
  expectInt(leafOf(h.leaf), 47, "and h holds it");
}
fn caseWhole() {
  imm c = chain(48);
  imm h = emptyBox();
  Gc.step(0usize);
  Gc.step(0usize);
  expect(markedH(h, c), "a whole value: h black, the leaf's holders not yet marked");
  imm f0 = finals;
  viaWhole(h, c);
  expect(finish(f0), "the leaf in a Box stored over black h is not finalized");
  expectInt(leafOf(h.leaf), 48, "and h holds it");
}
fn caseNew() {
  imm c = chain(49);
  imm h = emptyBox();
  Gc.step(0usize);
  Gc.step(0usize);
  expect(markedH(h, c), "a new object: h black");
  imm f0 = finals;
  viaNew(h, c);
  expect(finish(f0), "a leaf made while marking and stored only into black h is not finalized");
  expectInt(leafOf(h.leaf), 7, "and h holds it");
}

fn main() i32 {
  // Before each case, the last one's heap -- garbage once it returned -- is
  // collected, so a case's collection finalizes nothing but a leaf it lost
  Gc.stop();
  settle();
  caseRef();
  settle();
  caseBorrow();
  settle();
  caseElement();
  settle();
  caseSlice();
  settle();
  caseSwap();
  settle();
  caseLeftAssign();
  settle();
  caseWhole();
  settle();
  caseNew();
  settle();
  Gc.start();
  // Every leaf was finalized once, by the collection that found it
  // unreachable after its case returned: the eight kept, and leaf 49, which
  // caseNew left in w
  expectInt(finals, 9, "the eight cases' leaves, and caseNew's leaf 49, each finalized once");
  expectUInt(u64[Gc.liveObjects()], 0, "and everything freed");
  done();
}
