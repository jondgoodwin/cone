// An Erased value on the stack is a root, and its record's trace finds a Gc
// reference it names. The value here sits in malloc'd memory no collector scans,
// so the Erased value, a local of 'keep' and a parameter of 'probe', is the only
// thing that keeps the leaf alive: a function holding nothing but an Erased
// value has a frame while a collected region is declared (here, Gc), however
// the frame decides what needs one. Stress mode scribbles over a freed object,
// so a leaf the roots missed reads back wrong; Gc.collect() runs a whole
// collection with the Erased value on the stack. Every value is worked out by
// hand from the source: the leaves are made 7 and 8, and read back as such.

mod erased;

import testing use *;
import collector;

struct LeafValue { pub n: i64; }
alias Leaf = Gc[mut, LeafValue];

// Stores a leaf in the cell and returns: no frame of this function holds it
// after, only the cell does, which nothing scans
fn plant(cell: *u8, n: i64) {
  let leaf = Leaf(n);
  mem.writeRaw[usize](cell as *usize, leaf as usize);
}

fn churn() {
  var i = 0i64;
  while i < 200 {
    let junk = Leaf(i);
    i = i + 1;
  }
}

// The Erased value as a parameter: held across a collection and allocations
fn probe(held: Erased, n: i64) i64 {
  Gc.collect();
  churn();
  Gc.collect();
  let got = mem.readRaw[usize](held.p as *usize) as Leaf;
  got.n
}

// The Erased value as a local
fn keep(cell: *u8) i64 {
  let held = Erased(cell, mem.typeRecord[Leaf]());
  Gc.collect();
  churn();
  Gc.collect();
  let got = mem.readRaw[usize](held.p as *usize) as Leaf;
  got.n
}

fn main() i32 {
  Gc.setStress(true);
  let cell = malloc(mem.sizeof[Leaf]());
  plant(cell, 7);
  expectInt(keep(cell), 7, "a leaf named only by an Erased local, across collections");
  let cell2 = malloc(mem.sizeof[Leaf]());
  plant(cell2, 8);
  expectInt(probe(Erased(cell2, mem.typeRecord[Leaf]()), 0), 8, "a leaf named only by an Erased parameter, across collections");
  done()
}
