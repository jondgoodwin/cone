// The collector package: 'Gc', a garbage-collected region, and its collector.
// A value allocated in 'Gc' lives until nothing reaches it, and then the
// collector finalizes it and gives its memory back. Its references copy for
// free and drop for free: no count, no free at scope end.
//
//   mod scene;
//   import collector;          // binds 'Gc', the region, as well as 'collector'
//
//   struct LeafValue {
//     pub n i64;
//     fn final(self &uni) { ... }
//   }
//   alias Leaf = Gc[mut, LeafValue];
//   struct Pair { pub left Leaf; pub right Leaf; }
//
//   fn build() {
//     mut p = new Gc[mut, Pair](new Leaf(1), new Leaf(2));
//     p.left = new Leaf(3);            // Leaf 1 is garbage now
//     Gc.collect();                    // Leaf 1's 'final' runs here
//   }
//
// ONE THREAD. The collector is single threaded: its roots are one chain (a
// global in conestd's roots.cone), and nothing here is synchronized. A 'Gc'
// reference made, held, reached or dropped on a thread the 'thread' package
// started corrupts it. Nothing checks or guards this; a concurrent collector
// is a later design.
//
// THE NAME. The package is 'collector' and its region ref is 'Gc'. The 'mod'
// line below makes 'Gc' the package's default fold, so a bare
// 'import collector;' binds both names, and a program writes 'new Gc[mut,
// LeafValue](1)' and 'Gc.collect()'. 'import collector use *;' binds them too.
//
// WHAT A PROGRAM CALLS:
//   Gc.collect()          a full collection, now: one in progress is finished
//                         (or, while it is still marking, given up), and a
//                         whole one run, finalizers and all
//   Gc.step(work)         some collection work now, as an allocation does:
//                         at least 'work' bytes of objects marked, swept or
//                         finalized (0: the least there is, one object),
//                         starting a collection if none is running. True if
//                         the step finished one. Gc.phase() says where one is
//   Gc.stop(), start()    turn the automatic work off and on again, the
//                         stress mode's included. An allocation that fails
//                         still collects (below), and Gc.collect() and
//                         Gc.step() still work
//   Gc.setStress(on)      a step at every allocation, a collection started as
//                         soon as one ends, and every object freed scribbled
//                         over: a temporary the roots missed, or a store the
//                         barrier missed, shows soon. Setting the environment
//                         variable CONE_GC_STRESS does the same for a whole
//                         run, from its first allocation; CONE_GC_STRESS=full
//                         runs a whole collection at every allocation
//                         instead, which finds a missed root at once.
//                         Gc.stressed() says if either is on
//   Gc.setGenerational(on) generational running, or incremental, the default
//                         (THE GENERATIONS, below); Gc.generational() says
//                         which. Setting the environment variable
//                         CONE_GC_MODE to 'generational' or 'incremental'
//                         chooses for a whole run
//   Gc.setLimit(bytes)    no more than this many bytes of 'Gc' values (with
//                         their headers) at once; 0, the default, is no limit.
//                         What exhaustion looks like, on demand
//   Gc.liveObjects(), Gc.liveBytes(), Gc.collections(), Gc.finalized(),
//   Gc.freed(), Gc.steps(), Gc.largestStep(), Gc.minorCollections(),
//   Gc.markedObjects(), Gc.sweptObjects(), Gc.work(), Gc.minorWork(),
//   Gc.promotedBytes(), Gc.oldBytes()
//                         the collector's counts, for tests and tuning
//
// HOW IT COLLECTS: Acorn's collector (acornvm, avm_gc.cpp), incremental, with
// Lua's separation of finalizers. Every object carries a header, the region
// ref: the next object in its list, its link in the gray list, the type
// record the compiler handed 'alloc', and its colour. A collection runs a
// step at a time, in phases:
// - MARK: every root is handed to 'mark' (mem.traceRoots), which turns a
//   white object gray and puts it on the gray list; then, a step at a time,
//   gray objects are taken off, made black, and their record's trace hands
//   each 'Gc' reference they hold to 'mark' in turn. While it marks, the
//   program runs between steps and stores references: the WRITE BARRIER
//   (below) keeps it from hiding a white object in a black one;
// - ATOMIC, the end of marking, in one step: the gray list emptied, the
//   roots traced again -- the stacks get no barrier, so they are re-read
//   here, uninterrupted -- and emptied again; then every object that needs
//   finalizing and is still white is SEPARATED onto the to-be-finalized list,
//   and it and everything it reaches marked, so all of it lives through this
//   collection; then the current white is FLIPPED, so every object still
//   carrying the old one is garbage;
// - SWEEP, a step at a time: each garbage object freed, each survivor made
//   the new white. An object allocated from here on is born the new white,
//   and so survives the sweep;
// - FINALIZE, a step at a time: each separated object is marked finalized
//   and put back among the ordinary objects, then its record's finalizer runs
//   -- its 'final', then its fields', then the owners its fields hold are
//   released ('Rc' counted down, 'So' finalized and freed). Newest first.
// An object is finalized once, and freed by the first collection that finds
// it unreachable after that: a CYCLE LATE, so a 'final' may read its 'Gc'
// children, which are still there, possibly finalized, never freed. A 'final'
// may allocate; nothing it does starts collection work.
//
// Objects whose type needs no finalizing are never separated, and are freed
// by the collection that finds them unreachable.
//
// THE WRITE BARRIER. The compiler calls 'writeBarrier' after every store of a
// 'Gc' reference into memory that is not a local -- a field, an element, a
// dereference, through a 'Gc' reference or a borrow alike -- handing it the
// header of what was stored. While marking, a white object so stored is made
// gray: no black object ever points at a white one it could hide (Dijkstra's
// insertion barrier, Acorn's mem_markChk). It asks nothing of where the
// reference went, which a store through a borrow could not tell it. Stores
// into locals get none: the atomic step traces the stacks again. Outside
// marking it does nothing, unless the collector runs generationally (below).
// It is 'inline', so the compiler expands it at each store, in the program's
// object: a test of a flag in line, and a call only while it is on.
//
// THE GENERATIONS (Acorn's generational mode, which is Lua 5.2's). Most
// objects die young. Run generationally, the collector keeps what survives a
// collection black and marks it OLD, and the next collection is MINOR: it
// does not trace the old generation, and its sweep stops at the first old
// object it meets -- new objects are pushed at a list's head, so everything
// after the first old one is older still, and old. A minor collection's work
// is the young objects: those it marks, and those it sweeps, freed or
// promoted. The old generation costs it nothing but the roots that point
// into it.
// - The barrier stays on between collections, since the old objects are
//   black. It shades a young object stored into the heap, and that is how an
//   old object's new young child is found: the shaded object is already
//   gray when the next collection begins, which keeps the gray list (it
//   would empty it before a full marking). The barrier cannot tell an old
//   container from a young one -- it asks only about what was stored, which
//   is all a store through a borrow can tell it -- so every young object
//   stored into the heap survives the next minor collection, and is
//   promoted. Objects born holding their values ('new Gc[T](a, b)') are stored
//   by no barrier, and die young if they are dropped. (Acorn's barrier asks
//   whether the container is black, so there a young object stored into a
//   young one is not kept.)
// - Once minor collections would have promoted as many bytes as were live
//   after the last full marking (at least the least trigger, 256 KiB), that
//   collection's sweep makes every survivor white and young again, and a
//   full marking starts at once, frees old garbage, and promotes what is live
//   (Acorn's GCOLDTRIGGER, counted in bytes, and only the minor collections'
//   promotions). Gc.collect() is always a full collection.
// - A minor collection that finds more than half the young generation live
//   is UNPRODUCTIVE -- a program building a structure, or storing all it
//   makes -- and its sweep is full too. The collections after it are full
//   ones, run incrementally, one of them after the first such collection,
//   twice as many after the next in a row, up to 64; then generational
//   running is tried again (Lua 5.4's backing off after a 'bad collection').
//   Without it, a program storing everything it makes would promote it all,
//   and the heap would grow without bound between full markings.
// - Pacing: a minor collection starts when the young generation has grown by
//   what the last full marking allowed the whole heap to grow, not by what
//   its own estimate, which counts old garbage it cannot see, would allow.
// - Finalizing: a minor collection separates the young unreachable objects
//   that need finalizing; an old one is found only by a full marking. What
//   is kept only for a finalizer, and the finalized objects themselves, are
//   not promoted: made white and young again, they are freed by the next
//   minor collection that finds them unreachable, a cycle late as ever.
// Incremental running is the default. examples/generations.cone measures
// both. Where the short-lived objects are born holding their values and die
// at once, generational running does half the work, a minor collection a
// quarter of a full one, in a heap no larger. Where some live long enough to
// be promoted and die old (pauses.cone's grafts), it does a twentieth less,
// in a heap two fifths larger. Where everything is built by storing it
// (forest.cone), it does the same work in a heap two and a half times larger,
// what its tries at generational running cost.
//
// WHEN IT WORKS, AND HOW MUCH (pacing in bytes, Lua's). Collection work runs
// inside allocations (and Gc.collect(), Gc.step()): 'new Gc[T](...)' evaluates
// its value first, then calls 'alloc', so at that moment every 'Gc'
// reference the program holds is in a stack slot the compiler registered
// (its roots), and none is only in a register. Between collections, one
// starts when an allocation would take the heap past the TRIGGER: twice the
// bytes found live by the last collection, never less than 256 KiB (Lua's
// pause of 200%). While one runs, every 8 KiB allocated buys a step, which
// does twice those bytes' worth of work (Lua's step multiplier of 200%): a
// step marks, sweeps or finalizes objects, each costing its bytes, until the
// budget is spent. So a collection finishes while the heap grows by about
// half of what it had to sweep, and a pause is one step, not a collection.
// An allocation that would pass the limit, where one is set, runs a full
// collection instead.
//
// SAFE POINTS, LATER. 'workWanted' is the whole decision, and the step it
// asks for is the only work 'alloc' does; the rest is making the object. To
// move the work to safe points (a frame's push, a loop's back edge), 'alloc'
// sets a flag where it now steps, and the safe point runs the step when the
// flag is set -- every root is in its slot there too. 'alloc' then keeps only
// the full collection for the limit and the emergency one, and the headroom
// between the trigger and memory's end is what the steps owed may use until
// the next safe point.
//
// OUT OF MEMORY. An allocation the C library cannot satisfy, or that would
// pass the limit, runs an emergency collection -- no finalizers run in it, as
// in Acorn and Lua -- and tries once more. If that fails too, 'alloc' returns
// null: a 'trynew Gc' allocation is then None, and a plain 'new' one panics, as
// every region's failed allocation does, naming the size asked for.

mod collector use Gc;

import libc;

// The colour bits: two whites, whose meanings swap at each flip, black, and
// finalized. Gray is neither white nor black. Two more: kept, black only
// because finalizable garbage reaches it (the atomic step's last marking), and
// old, a survivor promoted by a generational sweep.
const whites = 3u32;
const black = 4u32;
const finalizedBit = 8u32;
const keptBit = 16u32;
const oldBit = 32u32;

// The phases, Gc.phase()'s answers
const pausePhase = 0u32;      // no collection running
const markPhase = 1u32;       // marking; the barrier is on
const sweepPhase = 2u32;      // sweeping
const finalizePhase = 3u32;   // running finalizers

// The least the trigger is, in bytes
const minTrigger = 262144usize;
// Bytes allocated between steps, while a collection runs
const stepSize = 8192usize;
// Bytes of work a step does for each byte allocated since the last one
const stepMul = 2usize;

// Every header is linked into exactly one of these lists (each a header's
// address, 0 for empty, newest first):
mut allgc = 0usize;        // objects with nothing to finalize, or finalized
mut finobj = 0usize;       // objects to finalize when unreachable
mut tobefnz = 0usize;      // unreachable, awaiting their finalizer
mut grays = 0usize;        // during marking: gray objects, through 'gray'

mut curWhite = 1u32;       // what a new object is born, and a survivor made
mut gcPhase = 0u32;        // where the collection is: pausePhase, ...
mut sweepList = 0u32;      // sweeping allgc (0), finobj (1), tobefnz (2)
mut sweepAt = 0usize;      // the object last kept there: the next is its next; 0, the list's head
mut stepping = false;      // collection work (or a finalizer) is running
mut debt = 0usize;         // bytes allocated, and not yet paid for by a step
mut estimate = 0usize;     // bytes live at the flip, less what the sweep frees
mut autoOn = true;         // Gc.stop() / Gc.start()
mut stressOn = false;
mut stressFull = false;    // CONE_GC_STRESS=full: a whole collection at every allocation
mut envRead = false;
mut maxBytes = 0usize;     // Gc.setLimit; 0 is none

// Generational running (see THE GENERATIONS)
mut genOn = false;         // Gc.setGenerational, or CONE_GC_MODE
mut barrierOn = false;     // the barrier shades: while marking, and between generational collections
mut oldGen = false;        // the last sweep left its survivors black and old: the next marking is minor
mut minorMark = false;     // this collection's marking is minor: the old generation is not traced
mut sweepGen = false;      // this collection's sweep promotes its survivors, and stops at the first old one
mut keeping = false;       // the atomic step is marking what finalizable garbage reaches
mut sinceFull = 0usize;    // bytes promoted by minor collections since the last full marking
mut oldLimit = 262144usize; // when sinceFull reaches it, the next marking is full
mut fullEstimate = 0usize; // the estimate after the last full marking: what was live
mut markedBytes = 0usize;  // bytes this collection's marking made black (not those it keeps for finalizers)
mut oldGenBytes = 0usize;  // bytes of old objects
mut backoff = 0usize;      // full collections to run before the next generational sweep
mut backoffNext = 1usize;  // the backoff an unproductive minor collection sets: doubled each time, to 64

mut totalBytes = 0usize;   // bytes held by 'Gc' objects, headers included
mut trigger = 262144usize; // start a collection when an allocation would pass this
mut nobjects = 0usize;
mut ncollections = 0usize;
mut nfinalized = 0usize;
mut nfreed = 0usize;
mut nsteps = 0usize;
mut maxStep = 0usize;      // the most work one automatic step did
mut nminor = 0usize;       // minor collections: a minor marking, and a generational sweep
mut nmarked = 0usize;      // objects made black
mut nswept = 0usize;       // objects the sweep freed or kept
mut npromoted = 0usize;    // bytes promoted by minor collections
mut nwork = 0usize;        // bytes of work done, by every step and whole collection
mut nminorWork = 0usize;   // of that, the work of minor collections

// The header before every 'Gc' value: the region ref. Its fields are public
// because a private field is reached only through 'self', and the collector
// walks lists of headers; a program never holds a header to read them from.
pub struct Gc is RegionRef, Traced {
  pub next usize;      // the next object in its list
  pub gray usize;      // its link in the gray list
  pub ty *TypeRecord;  // the value's type record: size, alignment, finalizer, trace
  pub marked u32;      // its colour

  // 'new Gc[T](...)': the byte count of {header, value}, and T's type record.
  // The value has been evaluated already, so every root is in its slot.
  fn alloc(size usize, ty *TypeRecord) *u8 {
    readEnv();
    imm bytes = objBytes(ty);
    if !stepping and autoOn {
      // The limit caps the heap, so a heap held under one is collected (and
      // finalized) in the ordinary way, not only in emergencies
      if stressFull or (maxBytes != 0usize and totalBytes + bytes > maxBytes) {
        fullCollect(false);
      }
      else if workWanted(bytes) {
        stepOwed();
      }
    }
    mut p = tryMalloc(size, bytes);
    if p as usize == 0usize and !stepping {
      fullCollect(true);
      p = tryMalloc(size, bytes);
    }
    if p as usize == 0usize {
      return p;
    }
    // Born the current white: during marking, reached only through the
    // roots, traced again at the atomic step, or through a store, which the
    // barrier shades; during the sweep, the new white, which survives it
    imm fin = ((ty as &TypeRecord).flags & 1u32) != 0u32;
    mem.writeRaw(p as *Gc, new Gc(if fin {finobj;} else {allgc;}, 0usize, ty, curWhite));
    if fin { finobj = p as usize; } else { allgc = p as usize; }
    totalBytes = totalBytes + bytes;
    nobjects = nobjects + 1usize;
    p;
  }

  // A 'Gc' reference was found, by a root or in a value being traced
  fn mark(self &uni Gc) {
    shade(self as *Gc as usize);
  }

  // A 'Gc' reference was stored into memory that is not a local. While
  // marking, and between generational collections, what it refers to is
  // shaded, so no black object -- one marked this collection, or an old one
  // -- can come to hide a white one; otherwise nothing.
  fn writeBarrier(self &uni Gc) inline {
    if barrierOn {
      shade(self as *Gc as usize);
    }
  }

  // The environment, read once. CONE_GC_STRESS: stress mode for the whole
  // run, 'full' for a whole collection at every allocation, anything else
  // for a step. CONE_GC_MODE: 'generational' or 'incremental', the mode the
  // run starts in
  fn readEnv() {
    if !envRead {
      envRead = true;
      imm val = libc.getenv("CONE_GC_STRESS");
      if val as usize != 0usize {
        stressOn = true;
        stressFull = libc.strcmp(cstr.fromPtr(val), "full") == 0i32;
      }
      imm mode = libc.getenv("CONE_GC_MODE");
      if mode as usize != 0usize {
        if libc.strcmp(cstr.fromPtr(mode), "generational") == 0i32 { genOn = true; }
        else if libc.strcmp(cstr.fromPtr(mode), "incremental") == 0i32 { genOn = false; }
      }
    }
  }

  // Does allocating 'bytes' more want collection work done first? Between
  // collections, when it would pass the trigger (one starts, with a full
  // step's budget); during one, when a step's worth has been allocated since
  // the last. Under stress, always, with the allocation's own budget. This
  // is the decision a safe point would make instead (see SAFE POINTS).
  fn workWanted(bytes usize) bool {
    if gcPhase == pausePhase {
      if !stressOn and totalBytes + bytes <= trigger {
        return false;
      }
      debt = if stressOn {bytes;} else {stepSize;};
      return true;
    }
    debt = debt + bytes;
    stressOn or debt >= stepSize;
  }

  // The step the bytes allocated have paid for
  fn stepOwed() {
    imm work = runStep(debt * stepMul);
    debt = 0usize;
    if work > maxStep { maxStep = work; }
  }

  // Memory for an object, unless it would pass the limit
  fn tryMalloc(size usize, bytes usize) *u8 {
    if maxBytes != 0usize and totalBytes + bytes > maxBytes {
      return null;
    }
    libc.malloc(size);
  }

  // n rounded up to a multiple of align, a power of two
  fn roundUp(n usize, align usize) usize {
    (n + align - 1usize) & (0usize - align);
  }

  // Where the value sits after its header: the {region, permission, value}
  // layout, whose permission takes no room (the compiler refuses a traced
  // region with one that does)
  fn valueOffset(ty *TypeRecord) usize {
    roundUp(mem.sizeof[Gc](), (ty as &TypeRecord).align);
  }

  // The bytes an object takes, as the compiler sized it for 'alloc'
  fn objBytes(ty *TypeRecord) usize {
    imm rec = ty as &TypeRecord;
    mut al = rec.align;
    if al < mem.alignof[Gc]() { al = mem.alignof[Gc](); }
    roundUp(valueOffset(ty) + rec.size, al);
  }

  fn header(at usize) &mut Gc {
    at as &mut Gc;
  }

  // The value of the object whose header is at 'at'
  fn valueOf(at usize) *u8 {
    (at + valueOffset(header(at).ty)) as *u8;
  }

  // Mark the object at 'at': a white one turns gray, onto the gray list
  fn shade(at usize) {
    imm h = header(at);
    if h.marked & whites != 0u32 {
      h.marked = h.marked & finalizedBit;
      h.gray = grays;
      grays = at;
    }
  }

  // Take one gray object off the list, make it black, and mark what it
  // holds; kept too, if only finalizable garbage reaches it. Its bytes are
  // the work done.
  fn propagateOne() usize {
    imm at = grays;
    imm h = header(at);
    grays = h.gray;
    imm bytes = objBytes(h.ty);
    if keeping {
      h.marked = h.marked | black | keptBit;
    }
    else {
      h.marked = h.marked | black;
      markedBytes = markedBytes + bytes;
    }
    nmarked = nmarked + 1usize;
    imm rec = h.ty as &TypeRecord;
    if rec.flags & 2u32 != 0u32 {
      imm tracefn = rec.trace;
      tracefn(valueOf(at), 0u32);
    }
    bytes;
  }

  // Until nothing is gray
  fn propagateAll() usize {
    mut work = 0usize;
    while grays != 0usize {
      work = work + propagateOne();
    }
    work;
  }

  // A collection starts: every root is marked, and marking begins. After a
  // generational sweep the marking is minor: the old generation is black and
  // stays so, and what the barrier shaded since is already gray, this
  // collection's extra roots (Acorn's GCSbegin, which in generational mode
  // neither empties the gray list nor marks the root)
  fn begin() {
    minorMark = oldGen;
    if !minorMark { grays = 0usize; }
    markedBytes = 0usize;
    barrierOn = true;
    mem.traceRoots(0u32);
    gcPhase = markPhase;
  }

  // Move every object on finobj that marking did not reach to the end of
  // tobefnz, keeping their order: newest first. The first old object ends
  // the search: everything after it is old, and so black
  fn separate() {
    mut tail = tobefnz;
    if tail != 0usize {
      while header(tail).next != 0usize { tail = header(tail).next; }
    }
    mut prev = 0usize;
    mut at = finobj;
    while at != 0usize and header(at).marked & oldBit == 0u32 {
      imm h = header(at);
      imm nxt = h.next;
      if h.marked & whites != 0u32 {
        if prev == 0usize { finobj = nxt; } else { header(prev).next = nxt; }
        h.next = 0usize;
        if tail == 0usize { tobefnz = at; } else { header(tail).next = at; }
        tail = at;
      }
      else {
        prev = at;
      }
      at = nxt;
    }
  }

  // The end of marking, uninterrupted: nothing gray; the roots again, since
  // the stacks have no barrier; the unreachable objects that need
  // finalizing separated and kept, with all they reach, through this
  // collection; the white flipped, so whatever carries the old one is
  // garbage; and the sweep begins
  fn atomic() usize {
    mut work = propagateAll();
    mem.traceRoots(0u32);
    work = work + propagateAll();
    separate();
    mut at = tobefnz;
    while at != 0usize {
      shade(at);
      at = header(at).next;
    }
    keeping = true;
    work = work + propagateAll();
    keeping = false;
    // The sweep's kind, Acorn's gcnextmode: generational, unless it must be
    // full, making every survivor white again for a full marking, which then
    // starts at once. After a minor marking it is full if minor collections,
    // this one's sweep included, would have promoted the old limit's worth
    // since the last full marking (what a minor marking made black is what
    // its sweep would promote); or if this one was UNPRODUCTIVE, finding more
    // than half the young generation live: then the next collections are
    // full ones, incremental, for a while (see THE GENERATIONS). Only a
    // generational sweep leaves black objects the barrier must guard between
    // collections
    mut full = false;
    if minorMark {
      full = sinceFull + markedBytes >= oldLimit;
      if markedBytes * 2usize > totalBytes - oldGenBytes {
        full = true;
        backoff = backoffNext;
        if backoffNext < 64usize { backoffNext = backoffNext * 2usize; }
      }
      else {
        backoffNext = 1usize;
      }
    }
    else if backoff > 0usize {
      backoff = backoff - 1usize;
      full = true;
    }
    sweepGen = genOn and !full;
    barrierOn = sweepGen;
    if minorMark and sweepGen { nminor = nminor + 1usize; }
    if !minorMark { sinceFull = 0usize; }
    curWhite = whites ^ curWhite;
    ncollections = ncollections + 1usize;
    estimate = totalBytes;
    gcPhase = sweepPhase;
    sweepList = 0u32;
    sweepAt = 0usize;
    work + 1usize;
  }

  fn listHead(which u32) usize {
    if which == 0u32 { allgc; } else if which == 1u32 { finobj; } else { tobefnz; }
  }
  fn setListHead(which u32, at usize) {
    if which == 0u32 { allgc = at; } else if which == 1u32 { finobj = at; } else { tobefnz = at; }
  }

  // Does the object at 'at' end a generational sweep of its list? The first
  // old one does: new objects are pushed at a list's head, so everything
  // after it is older, and old (Acorn's mem_sweeplist, 'tostop')
  fn endsSweep(at usize) bool {
    at == 0usize or (sweepGen and header(at).marked & oldBit != 0u32);
  }

  // Sweep the next object: freed if it carries the dead white. A survivor is
  // made the current white -- or, in a generational sweep, promoted: left
  // black and made old. Its bytes are the work done. Past the last list, the
  // sweep ends: the trigger is set from what the collection found live, and
  // finalizing begins, if anything was separated.
  fn sweepOne() usize {
    mut at = if sweepAt == 0usize {listHead(sweepList);} else {header(sweepAt).next;};
    while sweepList < 2u32 and endsSweep(at) {
      sweepList = sweepList + 1u32;
      sweepAt = 0usize;
      at = listHead(sweepList);
    }
    if at == 0usize {
      // After a full marking, the heap may grow by what it found live (at
      // least to the least trigger), and the old generation by as much again
      // before the next full marking. After a minor one, whose estimate
      // counts old garbage it cannot see, the young generation may grow by
      // what the last full marking allowed: pacing from it would double the
      // trigger at each minor collection, however little is live
      if !minorMark {
        fullEstimate = estimate;
        oldLimit = if estimate < minTrigger {minTrigger;} else {estimate;};
      }
      mut allowed = fullEstimate * 2usize;
      if allowed < minTrigger { allowed = minTrigger; }
      trigger = estimate + allowed - fullEstimate;
      // A sweep that made the old generation white again did so for a full
      // marking: it starts with the next allocation, before what the old
      // generation holds of garbage grows further
      if minorMark and !sweepGen { trigger = 0usize; }
      oldGen = sweepGen;
      gcPhase = if tobefnz != 0usize {finalizePhase;} else {pausePhase;};
      return 1usize;
    }
    imm h = header(at);
    imm bytes = objBytes(h.ty);
    nswept = nswept + 1usize;
    if h.marked & (whites ^ curWhite) != 0u32 {
      if sweepAt == 0usize { setListHead(sweepList, h.next); } else { header(sweepAt).next = h.next; }
      totalBytes = totalBytes - bytes;
      estimate = estimate - bytes;
      nobjects = nobjects - 1usize;
      nfreed = nfreed + 1usize;
      // Under stress, a freed object is scribbled over first, so a
      // reference the roots or the barrier missed reads 0xDD bytes, not
      // its old value
      if stressOn { libc.memset(at as *u8, 221i32, bytes); }
      libc.free(at as *u8);
    }
    else {
      if !sweepGen or h.marked & keptBit != 0u32 {
        // A full sweep's survivor, or one only finalizable garbage reaches
        // (and the separated objects themselves): the new white, young. No
        // live object can reach it, so no black one holds it
        if h.marked & oldBit != 0u32 { oldGenBytes = oldGenBytes - bytes; }
        h.marked = (h.marked & finalizedBit) | curWhite;
      }
      else if h.marked & black != 0u32 {
        // Promoted: black, and old from now on
        h.marked = h.marked | oldBit;
        oldGenBytes = oldGenBytes + bytes;
        if minorMark {
          sinceFull = sinceFull + bytes;
          npromoted = npromoted + bytes;
        }
      }
      // Anything else was born after the flip, white, or gray from the
      // barrier since: young, and left as it is
      sweepAt = at;
    }
    bytes;
  }

  // Run the finalizer of the newest object separated. It is marked
  // finalized and put among the ordinary objects before its finalizer runs,
  // so it is never finalized again, and is freed once it is found
  // unreachable. Its bytes are the work done.
  fn finalizeOne() usize {
    imm at = tobefnz;
    imm h = header(at);
    tobefnz = h.next;
    h.marked = h.marked | finalizedBit;
    h.next = allgc;
    allgc = at;
    nfinalized = nfinalized + 1usize;
    if tobefnz == 0usize { gcPhase = pausePhase; }
    imm fin = (h.ty as &TypeRecord).finalize;
    fin(valueOf(at));
    objBytes(h.ty);
  }

  // One piece of the collection, whichever phase it is in; its work
  fn stepOne() usize {
    if gcPhase == pausePhase {
      begin();
      return 1usize;
    }
    if gcPhase == markPhase {
      return if grays != 0usize {propagateOne();} else {atomic();};
    }
    if gcPhase == sweepPhase {
      return sweepOne();
    }
    finalizeOne();
  }

  // Work until 'budget' bytes' worth is done, at least one piece, or until
  // the collection ends. The work done.
  fn runStep(budget usize) usize {
    stepping = true;
    nsteps = nsteps + 1usize;
    mut work = 0usize;
    mut going = true;
    while going {
      imm piece = stepOne();
      account(piece, minorMark and (gcPhase == markPhase or sweepGen));
      work = work + piece;
      going = work < budget and gcPhase != pausePhase;
    }
    stepping = false;
    work;
  }

  // Work done, by a minor collection or a full one
  fn account(work usize, minor bool) {
    nwork = nwork + work;
    if minor { nminorWork = nminorWork + work; }
  }

  // Each object of a list the current white again, not old: its bytes
  fn unmark(list usize) usize {
    mut work = 0usize;
    mut at = list;
    while at != 0usize {
      imm h = header(at);
      h.marked = (h.marked & finalizedBit) | curWhite;
      work = work + objBytes(h.ty);
      at = h.next;
    }
    work;
  }

  // Every object white and young, and nothing gray: the marks of a
  // collection given up while marking dropped, and the old generation's too,
  // so that a whole marking can follow
  fn unmarkAll() usize {
    grays = 0usize;
    oldGen = false;
    oldGenBytes = 0usize;
    unmark(allgc) + unmark(finobj) + unmark(tobefnz);
  }

  // The sweep and finalizing of the collection in progress, to their end;
  // an emergency runs no finalizer
  fn finishCollection(emergency bool) usize {
    mut work = 0usize;
    while gcPhase == sweepPhase { work = work + sweepOne(); }
    if gcPhase == finalizePhase {
      if emergency { gcPhase = pausePhase; }
      else { while gcPhase == finalizePhase { work = work + finalizeOne(); } }
    }
    work;
  }

  // A whole collection, stop-the-world. One in progress is finished first --
  // or, if it is still marking, given up, since what it has marked black may
  // have died since -- and then a whole one runs, its marking full: after a
  // generational sweep the old generation is made white first. An emergency
  // one, run because memory ran out, runs no finalizer: those wait for the
  // next ordinary collection, their objects and what they reach kept alive
  // until then.
  fn fullCollect(emergency bool) {
    if stepping {
      return;
    }
    stepping = true;
    mut work = 0usize;
    if gcPhase == markPhase {
      work = unmarkAll();
      gcPhase = pausePhase;
    }
    account(finishCollection(emergency), minorMark and sweepGen);
    if oldGen {
      work = work + unmarkAll();
    }
    begin();
    work = work + atomic();
    work = work + finishCollection(emergency);
    account(work, false);
    debt = 0usize;
    stepping = false;
  }

  // A full collection, now. Nothing happens if collection work is running
  // already (a 'final' asking for one).
  pub fn collect() {
    fullCollect(false);
  }
  // At least 'work' bytes of collection work, now: objects marked, swept or
  // finalized, each costing its bytes (0: one piece, the least there is).
  // A collection starts if none is running. True if this step finished one.
  // Nothing happens, and false, if collection work is running already.
  pub fn step(work usize) bool {
    if stepping {
      return false;
    }
    runStep(work);
    gcPhase == pausePhase;
  }
  // Where the collection is: 0 none running, 1 marking, 2 sweeping,
  // 3 finalizing
  pub fn phase() u32 { gcPhase; }
  // Turn the automatic work off, and on again
  pub fn stop() { autoOn = false; }
  pub fn start() { autoOn = true; }
  // A step at every allocation, or not; and whether it does (either stress)
  pub fn setStress(on bool) { readEnv(); stressOn = on; stressFull = false; }
  pub fn stressed() bool { readEnv(); stressOn; }
  // Generational running, or incremental: from the next sweep on (see THE
  // GENERATIONS); and which is chosen
  pub fn setGenerational(on bool) { readEnv(); genOn = on; }
  pub fn generational() bool { readEnv(); genOn; }
  // No more than 'bytes' of objects at once, headers included; 0 is no limit
  pub fn setLimit(bytes usize) { maxBytes = bytes; }

  // Objects not yet freed: live ones, and finalized ones awaiting the
  // collection that frees them
  pub fn liveObjects() usize { nobjects; }
  // Their bytes, headers included
  pub fn liveBytes() usize { totalBytes; }
  // Collections that finished marking, finalizers run, objects freed, and
  // steps taken (by allocations, and Gc.step()), since the program began
  pub fn collections() usize { ncollections; }
  pub fn finalized() usize { nfinalized; }
  pub fn freed() usize { nfreed; }
  pub fn steps() usize { nsteps; }
  // The most work an allocation's step has done, in bytes: the longest pause
  pub fn largestStep() usize { maxStep; }
  // Of the collections, the minor ones: a minor marking, and a sweep that
  // stopped at the old generation
  pub fn minorCollections() usize { nminor; }
  // Objects made black, and objects the sweep freed or kept: the work,
  // counted in objects
  pub fn markedObjects() usize { nmarked; }
  pub fn sweptObjects() usize { nswept; }
  // Bytes of work done, by every step and whole collection: objects marked,
  // swept or finalized, each costing its bytes
  pub fn work() usize { nwork; }
  // Of that, the work of minor collections (and the marking of one whose
  // sweep turned out full, for a full marking after it)
  pub fn minorWork() usize { nminorWork; }
  // Bytes promoted to the old generation by minor collections
  pub fn promotedBytes() usize { npromoted; }
  // Bytes of the old generation now
  pub fn oldBytes() usize { oldGenBytes; }
}
