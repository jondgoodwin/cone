// conifers: a mixed stand of spruce, fir and white pine on a slope with a stand-in cabin at its edge, tall trees
// behind it and young ones in front, and a Norfolk-style pine on its own, headless: no window, 1920 x 1080.
//
//   congo run --release packages/weberpenn/examples/conifers.cone -- --shots <folder>
//   congo run --release packages/weberpenn/examples/conifers.cone -- --soak 120
//   congo run --release packages/weberpenn/examples/conifers.cone -- --tree <folder>    (single trees, close)
//
// GPU_POWER_PREFERENCE=low-power runs it on the integrated GPU. --shots writes BMPs: the lodge from close under
// the trees, from the forest's edge, from far across the slope, at day and at dusk and at night, the Norfolk pine at
// day and at night. --soak N times N frames of the three views (GPU time of the frame, p50, and the CPU's).
//
// Every tree is a subject of 'autoLod': its mesh levels and an octahedral impostor, so the far trees keep the
// silhouette and the light and dark masses of the crown and the near ones are the cards.

mod conifers;

import stdio use *;
import libc;
import sdl;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import autolod use *;
import weberpenn use *;
import pbrmaterial use TexelMap;
import surfacepatterns use *;
import path as filepath;

const W = 1920u32;
const H = 1080u32;

fn cstrEquals(a *u8, b &str) bool {
  mut i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8;
}

fn clampf(v f32, lo f32, hi f32) f32 { if v < lo { lo; } elif v > hi { hi; } else { v; }; }

fn seconds(from u64, to u64) f64 { f64.from(to - from) / f64.from(sdl.GetPerformanceFrequency()); }

fn scatter(n u32) f32 {
  mut x = n * 747796405u32 + 2891336453u32;
  x = ((x >> ((x >> 28u32) + 4u32)) ^ x) * 277803737u32;
  x = (x >> 22u32) ^ x;
  f32.from(x & 0xFFFFu32) / 65535.;
}

// The ground: a slope rising away from the cabin, with swells
fn heightAt(x f32, z f32) f32 {
  0. - 0.2 * z + 0.9 * libc.sinf(x * 0.07 + 1.) * libc.cosf(z * 0.05) + 0.4 * libc.sinf(x * 0.19 + z * 0.13);
}

fn groundMesh(x0 f32, x1 f32, z0 f32, z1 f32, n i32) Mesh {
  mut m = Mesh.empty();
  mut j = 0;
  while j <= n {
    mut i = 0;
    while i <= n {
      imm x = x0 + (x1 - x0) * f32.from(i) / f32.from(n);
      imm z = z0 + (z1 - z0) * f32.from(j) / f32.from(n);
      m.positions.push(new Vec3(x, heightAt(x, z), z));
      m.uvs.push(new Vec2(x * 0.2, z * 0.2));
      i = i + 1;
    }
    j = j + 1;
  }
  j = 0;
  while j < n {
    mut i = 0;
    while i < n {
      imm a = u32.from(j * (n + 1) + i);
      imm b = a + 1u32;
      imm c = a + u32.from(n + 1);
      imm d = c + 1u32;
      m.indices.push(a); m.indices.push(c); m.indices.push(b);
      m.indices.push(b); m.indices.push(c); m.indices.push(d);
      i = i + 1;
    }
    j = j + 1;
  }
  m.computeSmoothNormals();
  m;
}

fn boxAt(center Vec3, half Vec3, yaw f32, roll f32) Mesh {
  mut m = Mesh.cube(1.);
  m.transform(Mat4.fromTrs(center, Quat.angleAxis(yaw, new Vec3(0., 1., 0.)) * Quat.angleAxis(roll, new Vec3(0., 0., 1.)), half));
  m;
}

fn imageCopy(t &Image) Image {
  mut img = new Image(t.width, t.height, t.channels, List[u8].withCapacity(t.pixels.len()));
  mut i = 0usize;
  while i < t.pixels.len() {
    img.pixels.push(*t.pixels[i]);
    i = i + 1usize;
  }
  img;
}

fn imageOf(t &TexelMap) Image {
  mut img = new Image(t.width, t.height, 4, List[u8].withCapacity(t.pixels.len()));
  mut i = 0usize;
  while i < t.pixels.len() {
    img.pixels.push(*t.pixels[i]);
    i = i + 1usize;
  }
  img;
}

// ---- Subjects: a tree is a trunk and a crown of cards, turned into levels and an impostor ----

struct Species {
  name String;
  image Image;
  texture TextureHandle;
  foliage MaterialHandle;
}

fn foliageMaterial(renderer &mut Renderer, device &mut Device, image &Image) Species {
  imm tex = renderer.addCutoutTexture(device, image, 0.5);
  mut pbr = PbrMaterial.standard(new Color(1., 1., 1., 1.), 0., 0.75);
  pbr.texture = tex;
  pbr.alphaMode = ALPHA_MASK;
  pbr.alphaCutoff = 0.5;
  // foliage is a crowd of small rough surfaces facing every way: a flat card's specular lobe would mirror
  // the sun or the moon at a grazing angle (the pale mint of 7 Oct); and light comes through a needle mass
  pbr.specularScale = 0.12;
  pbr.transmission = 0.9;
  pbr.transmissionPower = 4.;
  new Species(String.from(""), imageCopy(image), tex, renderer.addPbrMaterial(device, &pbr));
}

struct Subject {
  name String;
  lod AutoLod;
  materials List[MaterialHandle];   // the renderer's, one a part: trunk, crown
  center Vec3;
  radius f32;
  height f32;
  triangles u32;
  ms f64;
}

const KIND_SPRUCE = 0;
const KIND_FIR = 1;
const KIND_PINE = 2;
const KIND_NORFOLK = 3;

fn makeSubject(device &mut Device, renderer &mut Renderer, pipe &ImpostorPipeline, baker &mut ImpostorBaker,
    settings &AutoLodSettings, sp &Species, trunkMat MaterialHandle, kind i32, seed u32, height f32, bare f32) Subject {
  imm t0 = sdl.GetPerformanceCounter();
  // the cards are finer on a young tree: their size follows its height to a third power
  imm cardScale = clampf(libc.powf(height / 20., 0.45), 0.35, 1.);
  mut params = spruceTree(seed, height, bare);
  mut fp = spruceFoliage(seed + 7u32, cardScale);
  if kind == KIND_FIR { params = firTree(seed, height, bare); fp = firFoliage(seed + 7u32, cardScale); }
  if kind == KIND_PINE { params = whitePineMature(seed, height, bare); fp = whitePineFoliage(seed + 7u32, cardScale); }
  if kind == KIND_NORFOLK { params = norfolkPine(seed, height); fp = norfolkFoliage(seed + 7u32, cardScale); }
  imm tree = grow(&params);
  imm tube = new TubeParams();
  imm trunk = branchMesh(&tree, &tube);
  imm crown = foliageMesh(&tree, &fp);
  imm tris = u32.from(trunk.triangleCount()) + u32.from(crown.triangleCount());
  mut parts = List[BakePart].empty();
  parts.push(new BakePart(trunk, Material.plain(new Color(0.12, 0.08, 0.05, 1.)), Image.empty()));
  parts.push(new BakePart(crown, Material.plain(new Color(1., 1., 1., 1.)).cutOut(0.5), imageCopy(&sp.image), true));
  imm lod = autoLod(device, renderer, pipe, baker, &parts, settings);
  mut mats = List[MaterialHandle].empty();
  mats.push(trunkMat);
  mats.push(sp.foliage);
  imm t1 = sdl.GetPerformanceCounter();
  imm c = lod.center;
  imm rad = lod.radius;
  new Subject(String.from(""), lod, mats, c, rad, height, tris, seconds(t0, t1) * 1000d);
}

fn plant(renderer &mut Renderer, s &Subject, model Mat4, tint Color, range f32) {
  mut p = 0usize;
  while p < s.lod.chains.len() {
    imm full = s.lod.chains[p];
    // the trunk takes a plain dark tint; the crown's is the age colour
    imm t = if p == 0usize { new Color(1., 1., 1., 1.); } else { tint; };
    imm item = renderer.addSceneItem(*full.levels[0usize], *s.materials[p], model, t);
    renderer.setSceneLod(item, full);
    if range > 0. { renderer.setSceneRange(item, 0., range, range * 0.08); }
    p = p + 1usize;
  }
}

// ---- The rig ----

struct Rig {
  out Texture;
  pixels Buffer;
  queries QuerySet;
  resolved Buffer;
  stamps Buffer;
  post Post;
  fx ImageFx;
}

fn save(folder &str, name &str, img &Image) {
  mut path = String.from(folder);
  path <- "/";
  path <- name;
  path <- ".bmp";
  img.save(&filepath.Path.from(path.view()));
}

// Day, or night: the sky, the sun or the moon, the haze
const LOOK_DAY = 0;
const LOOK_DUSK = 1;
const LOOK_NIGHT = 2;

fn lookSky(look i32) Sky {
  mut sky = Sky.dusk(radians(40.), radians(30.));
  if look == LOOK_DAY {
    sky.sunDirection = new Vec3(0.45, 0.62, -0.64).normalize();
    sky.sunColor = new Color(60., 55., 45., 1.);
    sky.zenith = new Color(0.10, 0.22, 0.52, 1.);
    sky.horizon = new Color(0.55, 0.66, 0.80, 1.);
    sky.horizonSharpness = 2.5;
    sky.glow = new Color(0.22, 0.20, 0.14, 1.);
    sky.glowSharpness = 12.;
    sky.ground = new Color(0.12, 0.14, 0.10, 1.);
  } elif look == LOOK_DUSK {
    sky = Sky.dusk(radians(9.), radians(200.));
    sky.sunDirection = new Vec3(0.2, 0.16, -0.97).normalize();
    sky.zenith = new Color(0.12, 0.17, 0.32, 1.);
    sky.horizon = new Color(0.95, 0.62, 0.42, 1.);
    sky.glow = new Color(1.2, 0.5, 0.2, 1.);
    sky.sunColor = new Color(60., 28., 10., 1.);
  } else {
    sky.sunDirection = new Vec3(-0.3, 0.45, -0.84).normalize();
    sky.sunColor = new Color(0., 0., 0., 1.);
    sky.zenith = new Color(0.004, 0.008, 0.03, 1.);
    sky.horizon = new Color(0.03, 0.05, 0.10, 1.);
    sky.horizonSharpness = 2.5;
    sky.glow = new Color(0., 0., 0., 1.);
    sky.glowSharpness = 8.;
    sky.ground = new Color(0.004, 0.005, 0.008, 1.);
  }
  sky;
}

fn lookLight(look i32) Light {
  if look == LOOK_DAY {
    return Light.directional(new Vec3(-0.45, -0.62, 0.64), new Color(3.3, 3.0, 2.6, 1.), new Color(0.30, 0.38, 0.50, 1.));
  }
  if look == LOOK_DUSK {
    return Light.directional(new Vec3(-0.2, -0.16, 0.97), new Color(3.6, 1.9, 0.9, 1.), new Color(0.22, 0.20, 0.30, 1.));
  }
  Light.directional(new Vec3(0.3, -0.45, 0.84), new Color(0.05, 0.07, 0.14, 1.), new Color(0.01, 0.014, 0.03, 1.));
}

fn lookFog(look i32) FogSettings {
  mut f = FogSettings.high();
  f.maxDistance = 900.;
  f.slices = 64u32;
  if look == LOOK_DAY {
    f.density = 0.0007;
    f.albedo = new Color(0.7, 0.78, 0.92, 1.);
  } elif look == LOOK_DUSK {
    f.density = 0.0016;
    f.albedo = new Color(1., 0.68, 0.45, 1.);
    f.anisotropy = 0.7;
  } else {
    f.density = 0.0018;
    f.albedo = new Color(0.08, 0.12, 0.22, 1.);
  }
  f;
}

fn drawFrame(device &mut Device, renderer &mut Renderer, rig &mut Rig, camera &Camera, light &Light, timed bool) {
  imm empty = DrawList.empty();
  mut encoder = device.createCommandEncoder();
  if timed { encoder.writeTimestamp(&rig.queries, 0u32); }
  rig.fx.render(device, &mut encoder, renderer, &mut rig.post, camera, light, &empty, &rig.out);
  if timed {
    encoder.writeTimestamp(&rig.queries, 1u32);
    encoder.resolveQuerySet(&rig.queries, 0u32, 2u32, &rig.resolved, 0u64);
    encoder.copyBufferToBuffer(&rig.resolved, 0u64, &rig.stamps, 0u64, 16u64);
  } else {
    encoder.copyTextureToBuffer(&rig.out, &rig.pixels);
  }
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn shoot(device &mut Device, renderer &mut Renderer, rig &mut Rig, camera &Camera, light &Light, folder &str, name &str) {
  renderer.time = 1.;
  // two frames: the fog's and the exposure's histories settle
  drawFrame(device, renderer, rig, camera, light, false);
  drawFrame(device, renderer, rig, camera, light, false);
  drawFrame(device, renderer, rig, camera, light, false);
  imm img = Image.fromTexels(rig.pixels.mappedRange(), i32.from(W), i32.from(H), false);
  save(folder, name, &img);
  print <- "Shot: "; printStr(name); print <- "\n";
}

fn sorted(v &mut List[f64]) {
  mut i = 1usize;
  while i < v.len() {
    imm x = *v[i];
    mut j = i;
    while j > 0usize and *v[j - 1usize] > x {
      v.set(j, *v[j - 1usize]);
      j = j - 1usize;
    }
    v.set(j, x);
    i = i + 1usize;
  }
}

fn soak(device &mut Device, renderer &mut Renderer, rig &mut Rig, camera &Camera, light &Light, name &str, frames u32) {
  mut gpus = List[f64].empty();
  mut cpus = List[f64].empty();
  mut f = 0u32;
  while f < frames + 20u32 {
    renderer.time = f32.from(f) / 60.;
    imm t0 = sdl.GetPerformanceCounter();
    drawFrame(device, renderer, rig, camera, light, true);
    imm t1 = sdl.GetPerformanceCounter();
    if f >= 20u32 {
      imm ticks = rig.stamps.mappedRange() as *u64;
      gpus.push(f64.from(*(ticks + 1usize) - *ticks) * f64.from(device.timestampPeriod) * 1.0e-6d);
      cpus.push(seconds(t0, t1) * 1000d);
    }
    f = f + 1u32;
  }
  sorted(&mut gpus);
  sorted(&mut cpus);
  printStr(name); print <- ": GPU frame p50 "; print <- *gpus[gpus.len() / 2usize]; print <- " ms, whole frame wall clock p50 ";
  print <- *cpus[cpus.len() / 2usize]; print <- " ms; "; print <- renderer.triangles; print <- " triangles, ";
  print <- u64.from(renderer.drawCalls); print <- " draws\n";
}

fn eyeCamera(eye Vec3, target Vec3, fov f32) Camera {
  mut c = Camera.make();
  c.fov = radians(fov);
  c.near = 0.2;
  c.far = 2500.;
  c.lookAt(eye, target, new Vec3(0., 1., 0.));
  c.background = new Color(0.4, 0.55, 0.8, 1.);
  c;
}

fn main(argc i32, argv **u8) i32 {
  mut folder = String.from("");
  mut soakFrames = 0u32;
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--shots") and a + 1 < argc {
      imm s = *(argv + usize.from(a + 1));
      mut i = 0usize;
      while *(s + i) != 0u8 { folder.appendByte(*(s + i)); i = i + 1usize; }
      a = a + 1;
    } elif cstrEquals(arg, "--soak") and a + 1 < argc {
      imm s = *(argv + usize.from(a + 1));
      mut n = 0u32;
      mut i = 0usize;
      while *(s + i) != 0u8 { n = n * 10u32 + u32.from(*(s + i) - 48u8); i = i + 1usize; }
      soakFrames = n;
      a = a + 1;
    } else {
      print <- "Usage: --shots FOLDER | --soak N\n";
      return 2;
    }
    a = a + 1;
  }
  mut instance = Instance.create("conifers example");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() { print <- "No GPU\n"; return 1i32; }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  mut device = adapter.requestDevice();
  imm outDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut out = device.createTexture(&outDesc);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, W, H);
  mut fx = ImageFx.create(&mut device, &renderer, &mut post);
  mut queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32);
  mut resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);
  mut stamps = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut pixels = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  if !renderer.isValid() or !post.isValid() or !fx.isValid() or !queries.isValid() { print <- "The renderer could not be made\n"; return 1i32; }
  mut rig = new Rig(out, pixels, queries, resolved, stamps, post, fx);
  renderer.setShadows(&mut device, &ShadowSettings.medium());

  // the paint
  imm t0 = sdl.GetPerformanceCounter();
  imm spruceTex = bakeNeedleTuft(&NeedleTuftParams.spruce(512, 11u32));
  imm firTex = bakeNeedleTuft(&NeedleTuftParams.denseFir(512, 12u32));
  imm pineTex = bakeNeedleTuft(&NeedleTuftParams.whitePineCrown(256, 13u32));
  imm norfolkTex = bakeNeedleTuft(&NeedleTuftParams.norfolk(512, 14u32));
  imm t1 = sdl.GetPerformanceCounter();
  print <- "Paint baked in "; print <- seconds(t0, t1); print <- " s: mean alpha spruce "; print <- meanAlpha(&spruceTex, 0, 1) * 4.;
  print <- ", fir "; print <- meanAlpha(&firTex, 0, 1) * 4.; print <- ", norfolk "; print <- meanAlpha(&norfolkTex, 0, 1) * 4.; print <- "\n";
  imm spruceImg = imageOf(&spruceTex);
  imm firImg = imageOf(&firTex);
  imm pineImg = imageOf(&pineTex);
  imm norfolkImg = imageOf(&norfolkTex);
  if folder.len() > 0usize {
    save(folder.view(), "paint-spruce", &spruceImg);
    save(folder.view(), "paint-fir", &firImg);
    save(folder.view(), "paint-pine", &pineImg);
    save(folder.view(), "paint-norfolk", &norfolkImg);
  }
  imm spruceSp = foliageMaterial(&mut renderer, &mut device, &spruceImg);
  imm firSp = foliageMaterial(&mut renderer, &mut device, &firImg);
  imm pineSp = foliageMaterial(&mut renderer, &mut device, &pineImg);
  imm norfolkSp = foliageMaterial(&mut renderer, &mut device, &norfolkImg);
  imm trunkMat = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(new Color(0.07, 0.045, 0.03, 1.), 0., 1.));

  mut settings = new AutoLodSettings();
  mut baker = ImpostorBaker.create(&mut device, settings.impostor.frameSize);
  imm pipe = makeImpostorPipeline(&mut renderer, &mut device);
  if !baker.isValid() or !pipe.isValid(&renderer) { print <- "The baker could not be made\n"; return 1i32; }

  // the subjects: tall old trees (limbs shed low), middling ones, saplings
  mut subjects = List[Subject].empty();
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &spruceSp, trunkMat, KIND_SPRUCE, 21u32, 26., 0.32));   // 0
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &spruceSp, trunkMat, KIND_SPRUCE, 22u32, 22., 0.28));   // 1
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &firSp, trunkMat, KIND_FIR, 23u32, 28., 0.34));        // 2
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &firSp, trunkMat, KIND_FIR, 24u32, 20., 0.22));        // 3
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &pineSp, trunkMat, KIND_PINE, 25u32, 21., 0.4));      // 4
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &spruceSp, trunkMat, KIND_SPRUCE, 26u32, 11., 0.08));  // 5 middling
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &firSp, trunkMat, KIND_FIR, 27u32, 9., 0.06));        // 6
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &spruceSp, trunkMat, KIND_SPRUCE, 28u32, 3.2, 0.03)); // 7 young
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &firSp, trunkMat, KIND_FIR, 29u32, 2.6, 0.03));       // 8
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &spruceSp, trunkMat, KIND_SPRUCE, 30u32, 4.2, 0.04)); // 9
  subjects.push(makeSubject(&mut device, &mut renderer, &pipe, &mut baker, &settings, &norfolkSp, trunkMat, KIND_NORFOLK, 31u32, 18., 0.12)); // 10
  mut s = 0usize;
  while s < subjects.len() {
    print <- "Subject "; print <- u64.from(s); print <- ": "; print <- subjects[s].height; print <- " m, "; print <- u64.from(subjects[s].triangles);
    print <- " triangles at level 0, levels and impostor made in "; print <- subjects[s].ms; print <- " ms\n";
    s = s + 1usize;
  }

  // the world
  imm groundMat = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(new Color(0.09, 0.13, 0.035, 1.), 0., 1.));
  imm groundMeshHandle = renderer.addMesh(&mut device, &groundMesh(-500., 500., -400., 500., 220));
  imm woodMat = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(new Color(0.30, 0.16, 0.07, 1.), 0., 0.7));
  imm roofMat = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(new Color(0.06, 0.06, 0.07, 1.), 0., 0.8));
  imm stoneMat = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(new Color(0.22, 0.21, 0.19, 1.), 0., 0.9));
  mut glow = PbrMaterial.standard(new Color(0.2, 0.12, 0.05, 1.), 0., 0.5);
  glow.emissive = new Color(1., 0.6, 0.25, 1.);
  glow.emissiveStrength = 1.4;
  imm glowMat = renderer.addPbrMaterial(&mut device, &glow);
  imm dark = new Color(1., 1., 1., 1.);

  renderer.clearScene();
  renderer.addSceneItem(groundMeshHandle, groundMat, Mat4.identity(), dark);
  // the cabin: 10 x 7 body, a gable roof of two slabs, a stone chimney and pillars, lit windows
  imm gy = heightAt(0., 0.);
  imm body = boxAt(new Vec3(0., gy + 2.2, 0.), new Vec3(5., 2.4, 3.5), 0., 0.);
  imm bodyH = renderer.addMesh(&mut device, &body);
  renderer.addSceneItem(bodyH, woodMat, Mat4.identity(), dark);
  // roof slabs: tilted about the x axis for a gable along x
  mut slabs = Mesh.empty();
  mut sl = Mesh.cube(1.);
  sl.transform(Mat4.fromTrs(new Vec3(0., gy + 5.4, 1.6), Quat.angleAxis(0.55, new Vec3(1., 0., 0.)), new Vec3(5.8, 0.12, 2.6)));
  slabs.append(&sl);
  mut sr = Mesh.cube(1.);
  sr.transform(Mat4.fromTrs(new Vec3(0., gy + 5.4, -1.6), Quat.angleAxis(-0.55, new Vec3(1., 0., 0.)), new Vec3(5.8, 0.12, 2.6)));
  slabs.append(&sr);
  renderer.addSceneItem(renderer.addMesh(&mut device, &slabs), roofMat, Mat4.identity(), dark);
  mut stone = Mesh.empty();
  stone.append(&boxAt(new Vec3(-3.2, gy + 4.5, -1.5), new Vec3(0.6, 3.2, 0.6), 0., 0.));
  mut k = 0;
  while k < 4 {
    stone.append(&boxAt(new Vec3(-3.9 + f32.from(k) * 2.6, gy + 0.9, 3.9), new Vec3(0.42, 1.0, 0.42), 0., 0.));
    k = k + 1;
  }
  renderer.addSceneItem(renderer.addMesh(&mut device, &stone), stoneMat, Mat4.identity(), dark);
  mut win = Mesh.empty();
  k = 0;
  while k < 4 {
    win.append(&boxAt(new Vec3(-3.6 + f32.from(k) * 2.4, gy + 2.4, 3.52), new Vec3(0.55, 0.8, 0.04), 0., 0.));
    k = k + 1;
  }
  renderer.addSceneItem(renderer.addMesh(&mut device, &win), glowMat, Mat4.identity(), dark);

  // the stand: tall trees behind and to the sides, middling ones among them, saplings in front
  mut placed = 0u32;
  mut n = 0u32;
  while placed < 170u32 {
    imm r0 = scatter(n * 7u32);
    imm r1 = scatter(n * 7u32 + 1u32);
    imm r2 = scatter(n * 7u32 + 2u32);
    imm r3 = scatter(n * 7u32 + 3u32);
    imm r4 = scatter(n * 7u32 + 4u32);
    n = n + 1u32;
    // which: 0 tall behind (z -8 to -110), 1 middling at the sides, 2 saplings in front (z 2 to 22)
    mut x f32 = 0.;
    mut z f32 = 0.;
    mut group = 0;
    if placed % 5u32 == 4u32 {
      group = 2;
      x = (r0 - 0.5) * 44.;
      z = 5. + r1 * 18.;
    } elif placed % 5u32 == 3u32 {
      group = 1;
      x = (r0 - 0.5) * 120.;
      z = -6. + r1 * 40.;
    } else {
      group = 0;
      x = (r0 - 0.5) * 150.;
      z = -9. - r1 * 100.;
    }
    // keep the cabin's footprint, its apron and the pillars' bed clear
    if x > -8.5 and x < 8.5 and z > -7. and z < 7. { continue; }
    mut which = 0usize;
    mut tint = new Color(1., 1., 1., 1.);
    mut scale = 1.;
    if group == 0 {
      which = if r2 < 0.3 { 0usize; } elif r2 < 0.5 { 1usize; } elif r2 < 0.8 { 2usize; } elif r2 < 0.92 { 3usize; } else { 4usize; };
      scale = 0.85 + 0.35 * r3;
      tint = ageTint(0.85, 1., n);
    } elif group == 1 {
      which = if r2 < 0.5 { 5usize; } else { 6usize; };
      scale = 0.8 + 0.5 * r3;
      tint = ageTint(0.45, 1., n);
    } else {
      which = if r2 < 0.4 { 7usize; } elif r2 < 0.7 { 8usize; } else { 9usize; };
      scale = 0.8 + 0.4 * r3;
      tint = ageTint(0.05 + 0.1 * r4, 1., n);
    }
    imm model = Mat4.fromTrs(new Vec3(x, heightAt(x, z), z), Quat.angleAxis(r4 * 6.2831853, new Vec3(0., 1., 0.)), new Vec3(scale, scale, scale));
    plant(&mut renderer, subjects[which], model, tint, 1800.);
    placed = placed + 1u32;
  }
  print <- "Stand: "; print <- u64.from(placed); print <- " trees\n";

  // the Norfolk pine on its own, on a flat apron far to the side
  imm nx = 400.;
  imm nz = 100.;
  renderer.addSceneItem(renderer.addMesh(&mut device, &groundMesh(nx - 40., nx + 40., nz - 40., nz + 40., 8)), groundMat, Mat4.fromTrs(new Vec3(0., 0.2, 0.), Quat.identity(), new Vec3(1., 1., 1.)), dark);
  plant(&mut renderer, subjects[10usize], Mat4.fromTrs(new Vec3(nx, heightAt(nx, nz), nz), Quat.identity(), new Vec3(1., 1., 1.)), ageTint(0.55, 0.3, 5u32), 1800.);

  // the views
  imm eyeClose = new Vec3(-7., heightAt(-7., -16.) + 1.7, -16.);
  imm eyeEdge = new Vec3(16., heightAt(16., 30.) + 2., 30.);
  imm eyeFar = new Vec3(60., heightAt(60., 230.) + 18., 230.);
  imm camClose = eyeCamera(eyeClose, new Vec3(0., heightAt(0., -34.) + 9., -34.), 62.);
  imm camEdge = eyeCamera(eyeEdge, new Vec3(-2., heightAt(0., 0.) + 6., -8.), 55.);
  imm camFar = eyeCamera(eyeFar, new Vec3(0., heightAt(0., -20.) + 10., -20.), 34.);
  imm camNorfolk = eyeCamera(new Vec3(nx + 3., heightAt(nx, nz) + 7., nz + 46.), new Vec3(nx, heightAt(nx, nz) + 9., nz), 36.);

  mut look = 0;
  while look < 3 {
    imm sky = lookSky(look);
    renderer.setSky(&mut device, &sky);
    imm light = lookLight(look);
    mut fxs = FxSettings.high();
    fxs.fog = lookFog(look);
    rig.fx.configure(&fxs);
    rig.fx.cut = true;
    rig.post.exposure = if look == LOOK_NIGHT { 2.5; } else { 1.; };
    imm tag = if look == LOOK_DAY { "day"; } elif look == LOOK_DUSK { "dusk"; } else { "night"; };
    if folder.len() > 0usize {
      mut name = String.from("lodge-close-"); name <- tag;
      shoot(&mut device, &mut renderer, &mut rig, &camClose, &light, folder.view(), name.view());
      mut name2 = String.from("lodge-edge-"); name2 <- tag;
      shoot(&mut device, &mut renderer, &mut rig, &camEdge, &light, folder.view(), name2.view());
      mut name3 = String.from("lodge-far-"); name3 <- tag;
      shoot(&mut device, &mut renderer, &mut rig, &camFar, &light, folder.view(), name3.view());
      if look != LOOK_DUSK {
        mut name4 = String.from("norfolk-"); name4 <- tag;
        shoot(&mut device, &mut renderer, &mut rig, &camNorfolk, &light, folder.view(), name4.view());
      }
    }
    if soakFrames > 0u32 and look == LOOK_DAY {
      soak(&mut device, &mut renderer, &mut rig, &camClose, &light, "close under the trees", soakFrames);
      soak(&mut device, &mut renderer, &mut rig, &camEdge, &light, "forest edge", soakFrames);
      soak(&mut device, &mut renderer, &mut rig, &camFar, &light, "far across the slope", soakFrames);
    }
    look = look + 1;
  }
  device.waitIdle();
  print <- "Validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  0i32;
}
