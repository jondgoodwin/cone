// ======== Foliage: leaves and needles at the leaf sites, as plain geometry ========
//
// No alpha cut-out is assumed: each leaf is its own blade of triangles, in
// the shape of the leaf, drawn from both sides (every triangle twice, wound
// the other way, with the other normal). Its uvs index a palette strip the
// caller paints: u is the leaf's tone (0 the deep shade-green end, 1 the
// sunlit end), v the place on the blade (0.08 to 0.68 up it: a darker edge
// and a paler midrib) and 0.9 for a petiole. Its normals lean outward from the
// crown's middle, so a crown shades as a ball instead of a heap of plates.
//
// Two kinds are for a cut-out material instead (alpha-tested cards, painted
// by surfacepatterns' needle tufts), and are cards, not blades:
//
// - TUFTS (an eastern white pine's): along each limb from 'tuftStart' to its
//   tip, a tuft every 'tuftSpacing' metres, each a few crossed square cards
//   standing on the limb and pointing forward and to a side, alternately left
//   and right, a little drooped, a larger one at the tip pointing on and up.
//   The tufts of a tier's limbs lie in one flat, horizontal pad. The paint is
//   one cell, or an atlas of several side by side ('cells'): the last, a
//   tawny one, goes on some tufts near the trunk ('tawnyShare').
// - SPRAYS (an eastern hemlock's or a balsam fir's): flat cards laid along
//   each limb, overlapping, as wide as 'sprayWidth' tapering to the tip, the
//   edges drooping; the card's u is across and v along the limb.
//
// Their normals are the pad's, not the card's: up and out from the trunk's
// axis, so a tier is lit from above and dark beneath as a real one is, and
// each card turns a quarter of the way to its own plane.

pub const FOLIAGE_MAPLE = 0;
pub const FOLIAGE_NEEDLES = 1;
pub const FOLIAGE_PLUMES = 2;   // a pine's: along each branch, two crossed ribbons of needles, widest a third of the way out
pub const FOLIAGE_TUFTS = 3;    // tufts of crossed cards at a limb's shoot ends
pub const FOLIAGE_SPRAYS = 4;   // flat cards along each limb
pub const FOLIAGE_BRANCHLETS = 5; // overlapping whole-sprig cards along every limb and twig, lit as a crown volume

pub struct FoliageParams {
  pub kind i32 = 0;
  pub plumeFromLevel i32 = 1;   // plumes: the stems of this level and above carry them
  pub plumeStart f32 = 0.3;     // from this fraction along the stem
  pub plumeWidth f32 = 0.28;    // half the widest, over the stem's length
  pub plumeMax f32 = 0.8;       // the most half-width, metres
  pub plumeDroop f32 = 0.35;    // the ribbon's edges fall by this much of its half-width
  pub seed u32 = 7u32;
  pub leafSize f32 = 0.09;      // a blade's length, metres
  pub leafSizeV f32 = 0.2;      // the fraction it varies by
  pub petiole f32 = 0.06;       // metres
  pub detail i32 = 9;           // outline points of a maple blade (25 and up are toothed)
  pub droop f32 = 0.35;         // the tip's fall, in blade lengths squared
  pub fold f32 = 0.25;          // each half lifted from the midrib
  pub lift f32 = 0.35;          // how far the petiole rises from the horizontal, radians
  pub lean f32 = 0.85;          // the outward share in the normals
  pub needleLength f32 = 0.16;
  pub needleWidth f32 = 0.03;
  pub tufts i32 = 3;            // needle sprays at a site
  pub needleDroop f32 = 0.3;
  // Per-leaf data for render's flutter (the mesh's colors, one a vertex): the
  // vertex's offset from its leaf's pivot, the stem node the leaf grows from
  // (xyz, in the tree's own metres), and the leaf's phase in turns (w), the same
  // for every vertex of the leaf, a different number for each. Plumes carry
  // none.
  pub sway bool = false;
  // Tufts and sprays (cards)
  pub cells i32 = 1;            // the paint's cells side by side; the last is the tawny one when there are two or more
  pub tawnyShare f32 = 0.;      // the chance a tuft by the trunk is tawny, falling to none at the crown's edge
  pub tuftFromLevel i32 = 1;    // stems of this level carry tufts all along, those of a higher level one at the tip
  pub tuftStart f32 = 0.4;      // from this fraction along the stem
  pub tuftSpacing f32 = 0.45;   // metres between tufts
  pub tuftSize f32 = 0.5;       // a card's side, metres
  pub tuftSizeV f32 = 0.2;      // the fraction it varies by
  pub tuftMax i32 = 320;        // the most tufts a tree has: past it they are thinned at random (tips stay)
  pub tuftSplay f32 = 38.;      // degrees a tuft's axis leaves the stem's, alternately left and right
  pub tuftDroop f32 = 12.;      // degrees it falls
  pub tuftCards i32 = 3;        // crossed cards in a tuft (1 to 4)
  // With four cells (surfacepatterns' pine atlas: tuft, tuft in October, pad, pad in October) each
  // limb also carries pads from 'padStart' to its tip: flat cards 'padLength' long and 'padWidth'
  // wide (narrowing to the tip), laid along the limb, each with a second tilted 'padTilt' degrees
  // about the limb's axis, so a tier is a flat cloud of foliage a little thick
  pub padWidth f32 = 1.2;
  pub padLength f32 = 0.95;
  pub padStart f32 = 0.3;
  pub padTilt f32 = 24.;
  pub sprayFromLevel i32 = 1;   // stems of this level and above carry sprays
  pub sprayStart f32 = 0.15;    // from this fraction along the stem
  pub sprayLength f32 = 0.6;    // a card's length along the stem, metres (neighbours overlap by a third)
  pub sprayWidth f32 = 0.45;    // its width, metres, narrowing to 0.55 of that at the tip
  pub sprayDroop f32 = 0.25;    // its edges fall by this much of its half-width
  pub shadeUp f32 = 0.6;        // the normals' share of up
  pub shadeOut f32 = 0.6;       // and of out from the trunk's axis
  // BRANCHLETS (FOLIAGE_BRANCHLETS): whole sprigs as cards, laid along every limb and twig of the levels
  // 'tuftFromLevel' and above, each card following the stem's own bend (three rows of points, so a limb's
  // sag and its upturned tip carry through), 'brCards' of them at a station fanned about the limb, the
  // stations 'brStep' of a card's length apart (a third to a half overlap: the crown is solid, with sky
  // between the tiers only)
  pub brStart f32 = 0.12;       // from this fraction along a stem
  pub brLength f32 = 1.0;       // a card's length along the stem, metres (a twig's: 0.65 of it)
  pub brWidth f32 = 1.0;        // its widest, metres
  pub brStep f32 = 0.55;        // stations apart, in card lengths
  pub brCards i32 = 2;          // cards at a station
  pub brRoll f32 = 30.;         // degrees between the cards of a station, about the stem
  pub brHang f32 = 0.;          // degrees the whole fan turns down about the stem (a spruce's hanging curtain); negative, up
  pub brTipLift f32 = 0.;       // degrees a card's far end rises (an upswept fir tier, an upturned Norfolk limb)
  pub brDroop f32 = 0.2;        // a card's edges fall by this much of its half-width
  pub brCell i32 = 0;           // which paint cell the cards use
  pub brAlt i32 = -1;           // a second cell (a spruce's, with cones on it) for 'brAltShare' of the cards above
  pub brAltFrom f32 = 0.55;     // this fraction of the tree's height; -1: none
  pub brAltShare f32 = 0.35;
  // CROWN LIGHTING. The normals are BENT NORMALS: each vertex's normal is the share 'brBend' of the crown hull's
  // outward normal at that point (a hull measured from the grown tree itself: its radius at each height) and the rest the
  // card's own plane's, so a crown is lit as the one volume it is and not as a heap of plates. DEPTH SHADE: how far
  // inside the hull a card lies, and how far down the crown, pick a row of the paint ('brShadeRows' rows, each darker),
  // so the inside is dark (the paint's rows are ambient occlusion baked per card)
  pub brBend f32 = 0.75;
  pub brShadeRows i32 = 1;
  pub brShadeDepth f32 = 1.1;   // the weight of depth inside the hull in the row choice
  pub brShadeLow f32 = 0.25;    // and of height: the crown's lower tiers sit under the upper ones
}

// The golden ratio's fractional part: the phases of successive leaves
// stay far apart however many there are, with no draw from the generator
// (whose sequence the leaves' shapes depend on)
const GOLDEN = 0.6180339887f;

// Give the vertices of one leaf, from 'first' to the mesh's end, their
// sway colors: each one's offset from 'pivot', and the leaf's phase
fn addSway(m &mut mesh.Mesh, first usize, pivot Vec3, phase f32) {
  var i = first;
  while i < m.positions.len() {
    let d = *m.positions[i] - pivot;
    m.colors.push(new Color(d.x, d.y, d.z, phase));
    i = i + 1usize;
  }
}

// The lobed outline of a red maple's blade: S at the angle 'th' (degrees
// from the tip, round the blade's centre), 0 to 1. A tip lobe and two side
// lobes, shallow V notches between them.
fn mapleRadius(th f32) f32 {
  var best f32 = 0.;
  var k = 0;
  while k < 3 {
    let phi = if k == 0 { 0.f } elif k == 1 { 55. } else { -55. };
    let a = if k == 0 { 1.f } else { 0.8 };
    let w = if k == 0 { 42.f } else { 36. };
    let x = absf(th - phi) / w;
    if x < 1. {
      let b = a * libc.powf(libc.cosf(1.5707963 * x), 1.5);
      if b > best { best = b; }
    }
    k = k + 1;
  }
  0.5 + 0.5 * best
}

// Add one maple blade: base 'at', the blade running along 'fy', its face towards 'fz',
// 'size' long. 'tone' is its palette u.
fn addMapleBlade(m &mut mesh.Mesh, fp &FoliageParams, at Vec3, fy Vec3, fz Vec3, size f32, tone f32, centre Vec3, crown f32) {
  let fx = unitv(fy.cross(fz));
  let n = if fp.detail < 5 { 5 } else { fp.detail };
  let cy f32 = 0.35;
  let rr f32 = 0.65;
  // the points: index 0 the base, 1 the centre, then the outline
  let first = u32.from(m.positions.len());
  var pu List[Vec2] = List[Vec2].empty();
  pu.push(new Vec2(0., 0.));
  pu.push(new Vec2(0., cy));
  var k = 0;
  while k < n {
    let th = -165. + 330. * f32.from(k) / f32.from(n - 1);
    var s = mapleRadius(th);
    if n >= 25 { s = s * (1. + (if k % 2 == 0 { 0.045f } else { -0.045 })); }
    let a = radians(th);
    pu.push(new Vec2(rr * s * libc.sinf(a), cy + rr * s * libc.cosf(a)));
    k = k + 1;
  }
  // front-face vertices then back-face vertices
  var side = 0;
  while side < 2 {
    var i = 0usize;
    while i < pu.len() {
      let q = *pu[i];
      let zz = fp.fold * absf(q.x) * 0.5 - fp.droop * q.y * q.y * 0.5 * (if i == 0usize { 0. } else { 1. });
      let p = at + fx * (q.x * size) + fy * (q.y * size) + fz * (zz * size);
      let radial = unitv(p - centre);
      let nf = if side == 0 { fz } else { fz * -1. };
      m.positions.push(p);
      m.normals.push(unitv(nf * (1. - fp.lean * 0.5) + radial * fp.lean));
      m.uvs.push(new Vec2(tone, 0.08 + 0.6 * q.y));
      i = i + 1usize;
    }
    side = side + 1;
  }
  let np = u32.from(pu.len());
  // the fan: centre (1) to each outline pair, and the base closing it
  var j = 0u32;
  while j + 1u32 < u32.from(n) {
    let a = 2u32 + j;
    // front: counterclockwise seen from fz, which is decreasing angle round the centre
    m.indices.push(first + 1u32); m.indices.push(first + a + 1u32); m.indices.push(first + a);
    m.indices.push(first + np + 1u32); m.indices.push(first + np + a); m.indices.push(first + np + a + 1u32);
    j = j + 1u32;
  }
  // base to the first and last outline points
  m.indices.push(first + 1u32); m.indices.push(first + 2u32); m.indices.push(first);
  m.indices.push(first + np + 1u32); m.indices.push(first + np); m.indices.push(first + np + 2u32);
  m.indices.push(first + 1u32); m.indices.push(first); m.indices.push(first + 1u32 + u32.from(n));
  m.indices.push(first + np + 1u32); m.indices.push(first + np + 1u32 + u32.from(n)); m.indices.push(first + np);
}

// A thin triangle from 'a' to 'b', 'w' wide at the base, drawn both sides
fn addSpike(m &mut mesh.Mesh, a Vec3, b Vec3, w f32, wide Vec3, nrm Vec3, tone f32, v f32) {
  let first = u32.from(m.positions.len());
  let l = a + wide * (w * 0.5);
  let r = a - wide * (w * 0.5);
  var side = 0;
  while side < 2 {
    let nn = if side == 0 { nrm } else { nrm * -1. };
    m.positions.push(l); m.normals.push(nn); m.uvs.push(new Vec2(tone, v));
    m.positions.push(r); m.normals.push(nn); m.uvs.push(new Vec2(tone, v));
    m.positions.push(b); m.normals.push(nn); m.uvs.push(new Vec2(tone, v + 0.1));
    side = side + 1;
  }
  m.indices.push(first); m.indices.push(first + 2u32); m.indices.push(first + 1u32);
  m.indices.push(first + 3u32); m.indices.push(first + 4u32); m.indices.push(first + 5u32);
}

// Plumes: along every stem of the plume levels, from 'plumeStart' to its tip,
// two ribbons of needles crossing at right angles about it, one flat and one
// on edge, each as wide as sin(pi sqrt(t)) times 'plumeWidth' of the stem's
// length (at most 'plumeMax'), its edges drooping, and drawn from both sides.
fn addPlumes(m &mut mesh.Mesh, tree &Tree, fp &FoliageParams, rng &mut Rng, centre Vec3) {
  var s = 0usize;
  while s < tree.stems.len() {
    let st = tree.stems[s];
    if st.level >= fp.plumeFromLevel and st.points.len() >= 2usize {
      let n = st.points.len();
      let half = minf(fp.plumeMax, fp.plumeWidth * st.length) * (0.85 + 0.3 * rng.unit());
      let tone = clampf(0.25 + 0.45 * clampf(st.points[n - 1usize].y / maxf(0.5, tree.height), 0., 1.) + 0.3 * rng.unit(), 0., 1.);
      var rib = 0;
      while rib < 2 {
        let firstV = u32.from(m.positions.len());
        var j = 0usize;
        var count = 0u32;
        while j < n {
          let t = f32.from(j) / f32.from(n - 1);
          if t >= fp.plumeStart - 0.0001 {
            let p = *st.points[j];
            let prev = *st.points[if j == 0usize { 0usize } else { j - 1usize }];
            let next = *st.points[if j + 1usize < n { j + 1usize } else { n - 1usize }];
            let tan = unitv(next - prev);
            let flat = unitv(tan.cross(v3(0., 1., 0.)));
            let edge = unitv(flat.cross(tan));
            let across = if rib == 0 { flat } else { unitv(edge + v3(0., 0.4, 0.)) };
            let u01 = (t - fp.plumeStart) / maxf(0.01, 1. - fp.plumeStart);
            let w = half * libc.sinf(pi * libc.sqrtf(clampf(u01 * 0.85 + 0.15, 0., 1.))) * (0.35 + 0.65 * (1. - 0.4 * u01));
            let drop = v3(0., 0. - fp.plumeDroop * w, 0.);
            let radial = unitv(p - centre);
            let nn = unitv(unitv(across.cross(tan)) * (1. - fp.lean) + radial * fp.lean + v3(0., 0.25, 0.));
            // left and right edge, front copy then back copy (same normals: the lighting is the crown's)
            m.positions.push(p + across * w + drop);
            m.positions.push(p - across * w + drop);
            m.normals.push(nn); m.normals.push(nn);
            m.uvs.push(new Vec2(tone, 0.12)); m.uvs.push(new Vec2(tone, 0.64));
            count = count + 1u32;
          }
          j = j + 1usize;
        }
        // the quads between rows, both windings
        var q = 0u32;
        while q + 1u32 < count {
          let a = firstV + q * 2u32;
          let b = a + 1u32;
          let c = a + 2u32;
          let d = a + 3u32;
          m.indices.push(a); m.indices.push(b); m.indices.push(c);
          m.indices.push(b); m.indices.push(d); m.indices.push(c);
          m.indices.push(a); m.indices.push(c); m.indices.push(b);
          m.indices.push(b); m.indices.push(c); m.indices.push(d);
          q = q + 1u32;
        }
        rib = rib + 1;
      }
    }
    s = s + 1usize;
  }
}

// ---- Cards: tufts and sprays ----

// 'v' turned 'deg' degrees about the unit vector 'axis' (Rodrigues)
fn turnAbout(v Vec3, axis Vec3, deg f32) Vec3 {
  let c = libc.cosf(radians(deg));
  let s = libc.sinf(radians(deg));
  v * c + axis.cross(v) * s + axis * (axis.dot(v) * (1. - c))
}

// The horizontal direction across 'tan' (so a card on a level stem lies flat); a steep stem's,
// across it on the x axis's side
fn flatAcross(tan Vec3) Vec3 {
  let f = tan.cross(v3(0., 1., 0.));
  if f.length() < 0.2 { return unitv(tan.cross(v3(1., 0., 0.))); }
  unitv(f)
}

// A card's normal for the shading of a pad: up, and out from the trunk's axis at 'p', and
// 'tilt' of 'plane' (the card's own, one way or the other)
fn padNormal(fp &FoliageParams, p Vec3, plane Vec3, tilt f32) Vec3 {
  let hr = unitv(v3(p.x, 0., p.z));
  unitv(v3(0., fp.shadeUp, 0.) + hr * fp.shadeOut + plane * tilt)
}

// One card, a quad 'a' 'b' (the bottom edge's ends) 'c' 'd' (the top's, above 'b' and 'a'), from both
// sides: the front's normal 'nf', the back copy's 'nb', uvs from (u0, v0) at 'a' to (u1, v1) at 'c'
fn addCard(m &mut mesh.Mesh, a Vec3, b Vec3, c Vec3, d Vec3, u0 f32, u1 f32, v0 f32, v1 f32, nf Vec3, nb Vec3) {
  let first = u32.from(m.positions.len());
  var side = 0;
  while side < 2 {
    let n = if side == 0 { nf } else { nb };
    m.positions.push(a); m.normals.push(n); m.uvs.push(new Vec2(u0, v0));
    m.positions.push(b); m.normals.push(n); m.uvs.push(new Vec2(u1, v0));
    m.positions.push(c); m.normals.push(n); m.uvs.push(new Vec2(u1, v1));
    m.positions.push(d); m.normals.push(n); m.uvs.push(new Vec2(u0, v1));
    side = side + 1;
  }
  m.indices.push(first); m.indices.push(first + 1u32); m.indices.push(first + 2u32);
  m.indices.push(first); m.indices.push(first + 2u32); m.indices.push(first + 3u32);
  m.indices.push(first + 4u32); m.indices.push(first + 6u32); m.indices.push(first + 5u32);
  m.indices.push(first + 4u32); m.indices.push(first + 7u32); m.indices.push(first + 6u32);
}

// The u range of paint cell 'cell' of 'cells', held a hair in from its neighbours'
fn cellU0(fp &FoliageParams, cell i32) f32 { (f32.from(cell) + 0.012) / f32.from(maxi(1, fp.cells)) }
fn cellU1(fp &FoliageParams, cell i32) f32 { (f32.from(cell) + 0.988) / f32.from(maxi(1, fp.cells)) }

// A tuft still to be made
struct Tuft {
  at Vec3;
  axis Vec3;
  size f32;
  cell i32;
  tip bool;
}

// The point on stem 'st' the fraction t along it, and the way it runs there
fn stemAt(st &Stem, t f32, dir &mut Vec3) Vec3 {
  var q = Quat.identity();
  let p = pointAt(&st.points, &st.frames, t, &mut q);
  *dir = axisOf(q);
  p
}

// Pads along every limb (see FoliageParams.padWidth)
fn addPads(m &mut mesh.Mesh, tree &Tree, fp &FoliageParams, rng &mut Rng) {
  let reach = maxf(0.5, tree.reach);
  var s = 0usize;
  while s < tree.stems.len() {
    let st = tree.stems[s];
    if !st.dead and st.level >= fp.tuftFromLevel and st.points.len() >= 2usize and st.length > 0.3 {
      let L = st.length;
      // a twig's pads are narrower and single
      let limb = st.level == fp.tuftFromLevel;
      let narrow = if limb { 1.f } else { 0.7 };
      let count = maxi(1, i32.from(libc.ceilf((1. - fp.padStart) * L / (fp.padLength * 0.7))));
      var k = 0;
      while k < count {
        let ta = fp.padStart + (1. - fp.padStart) * f32.from(k) / f32.from(count);
        let tb = minf(1., ta + fp.padLength / L);
        var dA = v3(0., 1., 0.);
        var dB = v3(0., 1., 0.);
        let pa = stemAt(st, ta, &mut dA);
        let pb = stemAt(st, tb, &mut dB);
        if (pb - pa).length() > 0.1 {
          let tan = unitv(pb - pa);
          let w0 = flatAcross(tan);
          let mid = (pa + pb) * 0.5;
          let inner = 1. - clampf(libc.sqrtf(mid.x * mid.x + mid.z * mid.z) / reach, 0., 1.);
          let cell = if fp.cells >= 4 and rng.unit() < fp.tawnyShare * inner { 3 } else { 2 };
          let wa = narrow * fp.padWidth * (1. - 0.4 * ta) * 0.5 * (0.85 + 0.3 * rng.unit());
          let wb = narrow * fp.padWidth * (1. - 0.4 * tb) * 0.5 * (0.85 + 0.3 * rng.unit());
          // (a limb's pad has a second, tilted card about half the time: thickness without the cost everywhere)
          let cardsHere = if limb and rng.unit() < 0.55 { 2 } else { 1 };
          var c = 0;
          while c < cardsHere {
            // the first lies flat, the second tilted one way or the other and a little above
            let tiltSign = if rng.unit() < 0.5 { 1.f } else { -1. };
            let roll = if c == 0 { 0. } else { tiltSign * fp.padTilt * (0.7 + 0.6 * rng.unit()) };
            let w = turnAbout(w0, tan, roll);
            let lift = v3(0., 0.04 * f32.from(c), 0.);
            let plane = unitv(w.cross(tan));
            addCard(m, pa - w * wa + lift, pa + w * wa + lift, pb + w * wb + lift, pb - w * wb + lift,
              cellU0(fp, cell), cellU1(fp, cell), 0., 1., padNormal(fp, mid, plane, 0.2), padNormal(fp, mid, plane, -0.2));
            c = c + 1;
          }
        }
        k = k + 1;
      }
    }
    s = s + 1usize;
  }
}

fn addTufts(m &mut mesh.Mesh, tree &Tree, fp &FoliageParams, rng &mut Rng) {
  if fp.cells >= 4 { addPads(m, tree, fp, rng); }
  var tufts = List[Tuft].empty();
  let up = v3(0., 1., 0.);
  let reach = maxf(0.5, tree.reach);
  var s = 0usize;
  while s < tree.stems.len() {
    let st = tree.stems[s];
    if !st.dead and st.level >= fp.tuftFromLevel and st.points.len() >= 2usize {
      let alongOnly = st.level > fp.tuftFromLevel;
      let span = st.length * (1. - fp.tuftStart);
      let n = if alongOnly { 0 } else { i32.from(libc.floorf(span / maxf(0.05, fp.tuftSpacing))) };
      var sgn = if rng.unit() < 0.5 { 1.f } else { -1. };
      var k = 0;
      while k <= n {
        let tip = k == n;
        let t = if tip { 1. } else { fp.tuftStart + (1. - fp.tuftStart) * (f32.from(k) + 0.25 + 0.5 * rng.unit()) / f32.from(n + 1) };
        var tan = v3(0., 1., 0.);
        let at = stemAt(st, t, &mut tan);
        let flat = flatAcross(tan);
        // a tip tuft points on and a little up; the others splay to one side, then the other
        var axis = v3(0., 1., 0.);
        if tip {
          axis = unitv(tan + up * 0.15);
        } else {
          if rng.unit() < 0.2 { sgn = 0. - sgn; }
          let splay = radians(fp.tuftSplay * (0.7 + 0.6 * rng.unit()));
          axis = unitv(tan * libc.cosf(splay) + flat * (sgn * libc.sinf(splay)));
          axis = unitv(axis - up * libc.sinf(radians(fp.tuftDroop)));
          sgn = 0. - sgn;
        }
        let size = fp.tuftSize * (1. + fp.tuftSizeV * rng.signed()) * (if tip { 1.25 } else { 0.8 + 0.3 * t });
        var cell = 0;
        if fp.cells > 1 and fp.tawnyShare > 0. {
          let inner = 1. - clampf(libc.sqrtf(at.x * at.x + at.z * at.z) / reach, 0., 1.);
          if rng.unit() < fp.tawnyShare * inner { cell = 1; }
        }
        tufts.push(new Tuft(at, axis, size, cell, tip));
        k = k + 1;
      }
    }
    s = s + 1usize;
  }
  // too many: thinned at random, the tips kept
  let keep = if tufts.len() > usize.from(fp.tuftMax) { f32.from(fp.tuftMax) / f32.from(tufts.len()) } else { 1. };
  let cards = if fp.tuftCards < 1 { 1 } elif fp.tuftCards > 4 { 4 } else { fp.tuftCards };
  var i = 0usize;
  while i < tufts.len() {
    let tf = *tufts[i];
    if tf.tip or keep >= 1. or rng.unit() < keep {
      let base = tf.at - tf.axis * (0.08 * tf.size);
      let w0 = flatAcross(tf.axis);
      let turn0 = 12. * rng.signed();
      var c = 0;
      while c < cards {
        let w = turnAbout(w0, tf.axis, turn0 + 180. / f32.from(cards) * f32.from(c));
        let hw = w * (tf.size * 0.5);
        let plane = unitv(w.cross(tf.axis));
        let ctr = tf.at + tf.axis * (tf.size * 0.5);
        let nf = padNormal(fp, ctr, plane, 0.2);
        let nb = padNormal(fp, ctr, plane, -0.2);
        addCard(m, base - hw, base + hw, base + hw + tf.axis * tf.size, base - hw + tf.axis * tf.size,
          cellU0(fp, tf.cell), cellU1(fp, tf.cell), 0., 1., nf, nb);
        c = c + 1;
      }
    }
    i = i + 1usize;
  }
}

fn addSprays(m &mut mesh.Mesh, tree &Tree, fp &FoliageParams, rng &mut Rng) {
  var s = 0usize;
  while s < tree.stems.len() {
    let st = tree.stems[s];
    if !st.dead and st.level >= fp.sprayFromLevel and st.points.len() >= 2usize and st.length > 0.15 {
      let L = st.length;
      let step = fp.sprayLength * 0.67;
      let count = maxi(1, i32.from(libc.ceilf((1. - fp.sprayStart) * L / step)));
      var k = 0;
      while k < count {
        let ta = fp.sprayStart + (1. - fp.sprayStart) * f32.from(k) / f32.from(count);
        let tb = minf(1., ta + fp.sprayLength / L);
        var dirA = v3(0., 1., 0.);
        var dirB = v3(0., 1., 0.);
        let pa = stemAt(st, ta, &mut dirA);
        let pb = stemAt(st, tb, &mut dirB);
        if (pb - pa).length() > 0.05 {
          let tan = unitv(pb - pa);
          let w0 = turnAbout(flatAcross(tan), tan, 14. * rng.signed());
          let wa = fp.sprayWidth * (1. - 0.45 * ta) * (0.85 + 0.3 * rng.unit()) * 0.5;
          let wb = fp.sprayWidth * (1. - 0.45 * tb) * (0.85 + 0.3 * rng.unit()) * 0.5;
          let dropA = v3(0., 0. - fp.sprayDroop * wa, 0.);
          let dropB = v3(0., 0. - fp.sprayDroop * wb, 0.);
          let plane = unitv(w0.cross(tan));
          let mid = (pa + pb) * 0.5;
          let nf = padNormal(fp, mid, plane, 0.25);
          let nb = padNormal(fp, mid, plane, -0.25);
          addCard(m, pa - w0 * wa + dropA, pa + w0 * wa + dropA, pb + w0 * wb + dropB, pb - w0 * wb + dropB,
            cellU0(fp, 0), cellU1(fp, 0), 0., 1., nf, nb);
        }
        k = k + 1;
      }
    }
    s = s + 1usize;
  }
}

// ---- Branchlets: the crown as a volume ----

const HULL_BINS = 32usize;

// The crown's hull, measured from the grown tree: its radius about the trunk's axis in each of 32 height bins
// (the farthest any live stem reaches), smoothed twice, and the trunk's axis at each height
struct Hull {
  radius List[f32];
  axisX List[f32];
  axisZ List[f32];
  top f32;
}

fn buildHull(tree &Tree) Hull {
  let top = maxf(1., tree.height);
  var radius = List[f32].empty();
  var ax = List[f32].empty();
  var az = List[f32].empty();
  let trunk = tree.stems[0usize];
  var b = 0usize;
  while b < HULL_BINS {
    radius.push(0.);
    // the trunk's point nearest the bin's centre height
    let yc = top * (f32.from(b) + 0.5) / f32.from(HULL_BINS);
    var best = 1.0e9f;
    var bx = 0.f;
    var bz = 0.f;
    var i = 0usize;
    while i < trunk.points.len() {
      let q = *trunk.points[i];
      let d = absf(q.y - yc);
      if d < best { best = d; bx = q.x; bz = q.z; }
      i = i + 1usize;
    }
    ax.push(bx);
    az.push(bz);
    b = b + 1usize;
  }
  var s = 1usize;
  while s < tree.stems.len() {
    let st = tree.stems[s];
    if !st.dead {
      var i = 0usize;
      while i < st.points.len() {
        let q = *st.points[i];
        var bin = i32.from(libc.floorf(q.y / top * f32.from(HULL_BINS)));
        if bin < 0 { bin = 0; }
        if bin >= i32.from(HULL_BINS) { bin = i32.from(HULL_BINS) - 1; }
        let bu = usize.from(bin);
        let dx = q.x - *ax[bu];
        let dz = q.z - *az[bu];
        let d = libc.sqrtf(dx * dx + dz * dz);
        if d > *radius[bu] { radius.set(bu, d); }
        i = i + 1usize;
      }
    }
    s = s + 1usize;
  }
  var pass = 0;
  while pass < 2 {
    var nr = List[f32].empty();
    var j = 0usize;
    while j < HULL_BINS {
      let l = *radius[if j == 0usize { 0usize } else { j - 1usize }];
      let r = *radius[if j + 1usize < HULL_BINS { j + 1usize } else { HULL_BINS - 1usize }];
      nr.push(0.25 * l + 0.5 * *radius[j] + 0.25 * r);
      j = j + 1usize;
    }
    radius = nr;
    pass = pass + 1;
  }
  new Hull(radius, ax, az, top)
}

// The hull's radius at height y
fn hullRadius(h &Hull, y f32) f32 {
  let f = clampf(y / h.top * f32.from(HULL_BINS) - 0.5, 0., f32.from(HULL_BINS) - 1.001);
  let i = usize.from(i32.from(libc.floorf(f)));
  let k = f - libc.floorf(f);
  *h.radius[i] * (1. - k) + *h.radius[i + 1usize] * k
}

// The hull's outward normal at p (the gradient of r - R(y): out, and up where the crown narrows upward) and
// how deep p is inside it, 0 on the hull to 1 on the axis
fn hullNormal(h &Hull, p Vec3, depth &mut f32) Vec3 {
  let bin = usize.from(i32.from(clampf(p.y / h.top * f32.from(HULL_BINS), 0., f32.from(HULL_BINS) - 1.)));
  let dx = p.x - *h.axisX[bin];
  let dz = p.z - *h.axisZ[bin];
  let len = libc.sqrtf(dx * dx + dz * dz);
  let rh = if len < 0.001 { v3(1., 0., 0.) } else { v3(dx / len, 0., dz / len) };
  let dy = h.top / f32.from(HULL_BINS);
  let slope = clampf((hullRadius(h, p.y + dy) - hullRadius(h, p.y - dy)) / (2. * dy), -3., 3.);
  *depth = clampf(1. - len / maxf(hullRadius(h, p.y), 0.3), 0., 1.);
  unitv(v3(rh.x, 0. - slope, rh.z))
}

// One card of three rows of points ('rows': the points along it, 'lefts' and 'rights' the edges), both sides, each
// vertex's normal bent to the hull; 'row' picks the paint's shade row
fn addBentCard(m &mut mesh.Mesh, hull &Hull, fp &FoliageParams, pl Array[Vec3, 3], pr Array[Vec3, 3], plane Vec3,
    u0 f32, u1 f32, row i32) {
  let rows = maxi(1, fp.brShadeRows);
  let first = u32.from(m.positions.len());
  var side = 0;
  while side < 2 {
    var r = 0usize;
    while r < 3usize {
      let v = (f32.from(row) + f32.from(r) * 0.5) / f32.from(rows);
      var k = 0;
      while k < 2 {
        let p = if k == 0 { pl[r] } else { pr[r] };
        var dep = 0.f;
        let hn = hullNormal(hull, p, &mut dep);
        let sg = if side == 0 { 1.f } else { -1. };
        m.positions.push(p);
        m.normals.push(unitv(hn * fp.brBend + plane * (sg * (1. - fp.brBend))));
        m.uvs.push(new Vec2(if k == 0 { u0 } else { u1 }, v));
        k = k + 1;
      }
      r = r + 1usize;
    }
    side = side + 1;
  }
  var q = 0u32;
  while q < 2u32 {
    let a = first + q * 2u32;
    let b = a + 1u32;
    let d = a + 2u32;
    let c = a + 3u32;
    m.indices.push(a); m.indices.push(b); m.indices.push(c);
    m.indices.push(a); m.indices.push(c); m.indices.push(d);
    let a2 = a + 6u32;
    let b2 = a2 + 1u32;
    let d2 = a2 + 2u32;
    let c2 = a2 + 3u32;
    m.indices.push(a2); m.indices.push(c2); m.indices.push(b2);
    m.indices.push(a2); m.indices.push(d2); m.indices.push(c2);
    q = q + 1u32;
  }
}

fn addBranchlets(m &mut mesh.Mesh, tree &Tree, fp &FoliageParams, rng &mut Rng) {
  let hull = buildHull(tree);
  let rows = maxi(1, fp.brShadeRows);
  let top = maxf(1., tree.height);
  let up = v3(0., 1., 0.);
  var s = 1usize;
  while s < tree.stems.len() {
    let st = tree.stems[s];
    if !st.dead and st.level >= fp.tuftFromLevel and st.points.len() >= 2usize and st.length > 0.2 {
      let L = st.length;
      let limb = st.level == fp.tuftFromLevel;
      let scale = if limb { 1.f } else { 0.65 };
      let cardLen = fp.brLength * scale;
      let step = maxf(0.05, fp.brStep) * cardLen;
      let count = maxi(1, i32.from(libc.ceilf((1. - fp.brStart) * L / step)));
      var k = 0;
      while k < count {
        let ta = fp.brStart + (1. - fp.brStart) * (f32.from(k) + 0.4 * rng.unit()) / f32.from(count);
        let tb = minf(1., ta + cardLen * (0.85 + 0.3 * rng.unit()) / L);
        var d0 = v3(0., 1., 0.);
        var d1 = v3(0., 1., 0.);
        var d2 = v3(0., 1., 0.);
        let p0 = stemAt(st, ta, &mut d0);
        let p1 = stemAt(st, (ta + tb) * 0.5, &mut d1);
        let p2raw = stemAt(st, tb, &mut d2);
        if (p2raw - p0).length() > 0.05 {
          let lift = up * (libc.sinf(radians(fp.brTipLift)) * cardLen * 0.5);
          let p2 = p2raw + lift;
          let tan = unitv(p2 - p0);
          let w0 = flatAcross(unitv(p2raw - p0));
          let width = fp.brWidth * scale * (0.85 + 0.3 * rng.unit()) * 0.5;
          // depth in the crown at the card's middle: the row of paint
          var dep = 0.f;
          let mid = (p0 + p2) * 0.5;
          hullNormal(&hull, mid, &mut dep);
          let shade = clampf(dep * fp.brShadeDepth + fp.brShadeLow * (1. - clampf(mid.y / top, 0., 1.)) + 0.12 * rng.signed(), 0., 0.999);
          let row = i32.from(libc.floorf(shade * f32.from(rows)));
          let flip = rng.unit() < 0.5;
          let alt = fp.brAlt >= 0 and mid.y / top > fp.brAltFrom and rng.unit() < fp.brAltShare;
          let cell = if alt { fp.brAlt } else { fp.brCell };
          let u0 = if flip { cellU1(fp, cell) } else { cellU0(fp, cell) };
          let u1 = if flip { cellU0(fp, cell) } else { cellU1(fp, cell) };
          let cards = maxi(1, fp.brCards);
          var c = 0;
          while c < cards {
            let roll = fp.brHang + (f32.from(c) - 0.5 * f32.from(cards - 1)) * fp.brRoll + 9. * rng.signed();
            let w = turnAbout(w0, tan, roll);
            let plane = unitv(w.cross(tan));
            // the card's three rows follow the stem; widest a third along, narrower at both ends
            var pl Array[Vec3, 3] = [p0, p1, p2];
            var pr Array[Vec3, 3] = [p0, p1, p2];
            var r = 0usize;
            while r < 3usize {
              let ww = width * (if r == 0usize { 0.7 } elif r == 1usize { 1. } else { 0.5 });
              let centre = if r == 0usize { p0 } elif r == 1usize { p1 } else { p2 };
              // edges fall: the more horizontal the cross-direction, the more
              let fall = up * (0. - fp.brDroop * ww * (1. - absf(w.y)));
              pl[r] = centre - w * ww + fall;
              pr[r] = centre + w * ww + fall;
              r = r + 1usize;
            }
            addBentCard(m, &hull, fp, pl, pr, plane, u0, u1, row);
            c = c + 1;
          }
        }
        k = k + 1;
      }
    }
    s = s + 1usize;
  }
}

// Leaves (or needles) at every site of 'tree', in one mesh
pub fn foliageMesh(tree &Tree, fp &FoliageParams) mesh.Mesh {
  var m = mesh.Mesh.empty();
  var rng = Rng.make(fp.seed);
  if fp.kind == FOLIAGE_BRANCHLETS {
    addBranchlets(&mut m, tree, fp, &mut rng);
    return m;
  }
  if fp.kind == FOLIAGE_TUFTS {
    addTufts(&mut m, tree, fp, &mut rng);
    return m;
  }
  if fp.kind == FOLIAGE_SPRAYS {
    addSprays(&mut m, tree, fp, &mut rng);
    return m;
  }
  let crown = maxf(0.5, tree.reach);
  let centre = v3(0., tree.height * 0.55, 0.);
  if fp.kind == FOLIAGE_PLUMES {
    addPlumes(&mut m, tree, fp, &mut rng, centre);
    return m;
  }
  var i = 0usize;
  while i < tree.sites.len() {
    let s = *tree.sites[i];
    let h = clampf(s.pos.y / maxf(0.5, tree.height), 0., 1.);
    let o = clampf(libc.sqrtf(s.pos.x * s.pos.x + s.pos.z * s.pos.z) / crown, 0., 1.);
    let tone = clampf(0.3 * h + 0.4 * o + 0.3 * rng.unit(), 0., 1.);
    let leafFirst = m.positions.len();
    if fp.kind == FOLIAGE_MAPLE {
      let size = fp.leafSize * (1. + fp.leafSizeV * rng.signed());
      // the petiole leaves the node across the stem, rising, and the blade runs on flat
      let side = unitv(s.side - s.axis * s.axis.dot(s.side));
      let pd = unitv(side * libc.cosf(fp.lift) + s.axis * 0.35 + v3(0., libc.sinf(fp.lift), 0.));
      let base = s.pos + pd * fp.petiole;
      var fy = unitv(v3(pd.x, pd.y * 0.25, pd.z));
      let fz0 = unitv(v3(0., 1., 0.) - fy * fy.y);
      let fz = unitv(fz0 + side * 0.15 * rng.signed());
      fy = unitv(fy - fz * fy.dot(fz));
      addSpike(&mut m, s.pos, base, 0.006, unitv(pd.cross(fz)), fz, tone, 0.9);
      addMapleBlade(&mut m, fp, base, fy, fz, size, tone, centre, crown);
    } else {
      let tf = if fp.tufts < 1 { 1 } else { fp.tufts };
      var t = 0;
      while t < tf {
        let ang = 6.2831853 * (f32.from(t) + 0.5 * rng.unit()) / f32.from(tf);
        let sideA = unitv(s.side - s.axis * s.axis.dot(s.side));
        let sideB = s.axis.cross(sideA);
        let out = unitv(sideA * libc.cosf(ang) + sideB * libc.sinf(ang));
        let dir = unitv(out * 0.9 + s.axis * 0.5 - v3(0., fp.needleDroop, 0.));
        let len = fp.needleLength * (1. + fp.leafSizeV * rng.signed());
        let tip = s.pos + dir * len;
        let wide = unitv(dir.cross(v3(0., 1., 0.)));
        let nrm = unitv(unitv(wide.cross(dir)) * (1. - fp.lean * 0.5) + unitv(s.pos - centre) * fp.lean);
        addSpike(&mut m, s.pos, tip, fp.needleWidth, wide, nrm, tone, 0.3 + 0.3 * rng.unit());
        t = t + 1;
      }
    }
    if fp.sway {
      let turns = GOLDEN * f32.from(i + 1usize) + 0.137 * f32.from(fp.seed % 97u32);
      addSway(&mut m, leafFirst, s.pos, turns - libc.floorf(turns));
    }
    i = i + 1usize;
  }
  m
}
