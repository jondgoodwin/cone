// ======== The skeleton: stems grown level by level ========

// A stem still to be built: where it starts, its frame, its length and the
// radius at its base, and which stem bore it. 'share' is how much of a full
// stem's children it bears (a clone bears the share of its remaining
// length), 'pend' a bend (pitch, yaw) it still has to take up, 'gen' how
// many clones deep it is.
struct Job {
  level: i32;
  parent: i32;
  pos: Vec3;
  q: Quat;
  length: f32;
  radius: f32;
  share: f32;
  pend: Vec2;
  gen: i32;
}

// A level's nominal stem length: the trunk's, times each level's ratio
fn nominalLength(p: &TreeParams, trunk: f32, lv: i32) f32 {
  var l = trunk;
  var i = 1;
  while i <= lv {
    l = l * p.levelParams[usize.from(i)].length;
    i = i + 1;
  }
  l
}

// The radius of a stem at its fraction z along it: linear taper, and the
// trunk's flare at its foot (the paper's: Flare (100^y - 1) / 100 + 1)
fn radiusAt(p: &TreeParams, lv: i32, r0: f32, z: f32, flared: bool) f32 {
  let taper = p.levelParams[usize.from(lv)].taper;
  var r = r0 * (1. - taper * z * 0.97);
  if lv == 0 && flared {
    let y = maxf(0., 1. - 8. * z);
    r = r * (1. + p.flare * (libc.powf(100., y) - 1.) / 100. * 1.);
  }
  maxf(r, p.minRadius)
}

// Build one stem from 'job': its points, radii and frames, the clones it
// splits off and the children and leaf sites along it
fn buildStem(p: &TreeParams, rng: &mut Rng, job: Job, trunk: f32, tree: &mut Tree, jobs: &mut List[Job]) {
  let lv = job.level;
  let lp = p.levelParams[usize.from(lv)];
  let n = if lp.curveRes < 1 { 1 } else { lp.curveRes };
  let segLen = job.length / f32.from(n);
  var pts = List[Vec3].withCapacity(usize.from(n) + 1usize);
  var rad = List[f32].withCapacity(usize.from(n) + 1usize);
  var frames = List[Quat].withCapacity(usize.from(n) + 1usize);
  var pos = job.pos;
  var q = job.q;
  var pend = job.pend;
  var radScale: f32 = 1.;
  pts.push(pos);
  rad.push(radiusAt(p, lv, job.radius, 0., job.gen == 0));
  frames.push(q);
  var splitErr = rng.unit();
  var kinkErr = rng.unit();
  var i = 0;
  while i < n {
    // The bend of this segment: curve over the first half, curveBack over the second
    var pitch: f32 = 0.;
    if lp.curveBack != 0. {
      let half = (n + 1) / 2;
      if i < half { pitch = lp.curve / f32.from(half); }
      else { pitch = lp.curveBack / f32.from(maxf(1., f32.from(n - half)) ); }
    } else { pitch = lp.curve / f32.from(n); }
    pitch = pitch + lp.curveV / f32.from(n) * rng.signed();
    let yaw = lp.curveV / f32.from(n) * rng.signed();
    // The bend still owed (a split's, a kink's), half of it each segment
    pitch = pitch + pend.x * 0.5;
    let yaw2 = yaw + pend.y * 0.5;
    pend = Vec2(pend.x * 0.5, pend.y * 0.5);
    q = yawQ(pitchQ(q, pitch), yaw2);
    // Attraction up: the axis turned towards the vertical, more the more it leans
    if p.attractionUp != 0. && lv >= 1 {
      let a = axisOf(q);
      let decl = degrees(libc.acosf(clampf(a.y, -1., 1.)));
      let turn = p.attractionUp * decl / f32.from(n);
      if a.y > -0.99 && a.y < 0.99 {
        // rotate about the axis perpendicular to a in the vertical plane through a
        let side = unitv(a.cross(v3(0., 1., 0.)));
        q = (Quat.angleAxis(radians(turn), side) * q).normalize();
      }
    }
    pos = pos + axisOf(q) * segLen;
    let z = f32.from(i + 1) / f32.from(n);
    pts.push(pos);
    rad.push(radiusAt(p, lv, job.radius, z, job.gen == 0) * radScale);
    frames.push(q);
    // A dog-leg: the stem veers and recovers only in part
    if lp.kink > 0. && i < n - 1 {
      kinkErr = kinkErr + lp.kink;
      if kinkErr >= 1. {
        kinkErr = kinkErr - 1.;
        let az = rng.unit() * 6.2831853;
        let kx = lp.kinkAngle * libc.cosf(az);
        let ky = lp.kinkAngle * libc.sinf(az);
        q = yawQ(pitchQ(q, kx), ky);
        frames.set(frames.len() - 1usize, q);
        pend = Vec2(pend.x - kx * p.kinkRecover, pend.y - ky * p.kinkRecover);
      }
    }
    // Splits: whole clones by error carry; each clone leaves at the split angle
    // and the stem itself turns the other way, then both bend back
    if lp.segSplits > 0. && i < n - 1 && job.gen < 3 {
      splitErr = splitErr + lp.segSplits;
      var ns = i32.from(splitErr.floor());
      splitErr = splitErr - f32.from(ns);
      while ns > 0 {
        ns = ns - 1;
        let a = axisOf(q);
        let steep = libc.sqrtf(maxf(0., 1. - a.y * a.y));
        let sa = maxf(0., lp.splitAngle + lp.splitAngleV * rng.signed()) * (0.7 + 0.3 * steep);
        let az = rng.unit() * 6.2831853;
        let ax = v3(libc.cosf(az), 0., libc.sinf(az));
        // the clone: turned by sa about a horizontal-in-frame axis at the azimuth
        let qc = (Quat.angleAxis(radians(sa), (q * ax)) * q).normalize();
        let rem = job.length * (1. - z);
        let rz = radiusAt(p, lv, job.radius, z, job.gen == 0) * radScale;
        jobs.push(Job(lv, job.parent, pos, qc, rem, rz * 0.7,
          job.share * rem / maxf(0.001, job.length), Vec2(0. - sa * 0.5, 0.), job.gen + 1));
        q = (Quat.angleAxis(radians(0. - sa * 0.35), (q * ax)) * q).normalize();
        radScale = radScale * 0.8;
      }
    }
    i = i + 1;
  }
  // The tip is thin
  rad.set(rad.len() - 1usize, maxf(p.minRadius, rad[rad.len() - 1usize] * 0.5));
  let si = i32.from(tree.stems.len());
  // Highest point and farthest reach
  var k = 0usize;
  while k < pts.len() {
    let pk = *pts[k];
    if pk.y > tree.height { tree.height = pk.y; }
    let rr = libc.sqrtf(pk.x * pk.x + pk.z * pk.z);
    if rr > tree.reach { tree.reach = rr; }
    k = k + 1usize;
  }
  // Children
  if lv < p.levels - 1 {
    placeChildren(p, rng, job, trunk, &pts, &rad, &frames, si, jobs);
  }
  // Leaf sites on the stems that carry leaves
  if lv >= p.leafFromLevel {
    placeSites(p, rng, &pts, &frames, si, lv, &mut tree.sites);
  }
  // Dead stubs up the trunk's lower part (made while its polyline is still ours)
  var stubs = List[Stub].empty();
  if lv == 0 && job.gen == 0 && p.stubs > 0 {
    stubs = makeStubs(p, rng, &pts, &rad, &frames);
  }
  tree.stems.push(Stem(lv, job.parent, pts, rad, frames, job.length));
  // each a stem of its own (level 1, 'dead'), two points, bark and nothing more
  var sk = 0usize;
  while sk < stubs.len() {
    let sb = *stubs[sk];
    var sp = List[Vec3].withCapacity(2usize);
    sp.push(sb.at);
    sp.push(sb.at + axisOf(sb.q) * sb.len + v3(0., 0. - 0.12 * sb.len, 0.));
    var sr = List[f32].withCapacity(2usize);
    sr.push(sb.radius);
    sr.push(sb.radius * 0.3);
    var sf = List[Quat].withCapacity(2usize);
    sf.push(sb.q);
    sf.push(sb.q);
    tree.stems.push(Stem(1, si, sp, sr, sf, sb.len, true));
    sk = sk + 1usize;
  }
}

// A dead stub, before it is a stem: where it leaves the trunk, its direction, length, radius at its base
struct Stub {
  at: Vec3;
  q: Quat;
  len: f32;
  radius: f32;
}

// The dead stubs of a trunk: 'stubs' short tapered spikes at random heights between 'stubFrom' and
// 'stubTo' of the trunk, leaving it out and a little down, round it, the lowest the longest
fn makeStubs(p: &TreeParams, rng: &mut Rng, pts: &List[Vec3], rad: &List[f32], frames: &List[Quat]) List[Stub] {
  var out = List[Stub].empty();
  var k = 0;
  while k < p.stubs {
    let t = p.stubFrom + (p.stubTo - p.stubFrom) * rng.unit();
    var qa = Quat.identity();
    let at = pointAt(pts, frames, t, &mut qa);
    let qc = pitchQ(rollQ(qa, rng.unit() * 360.), 82. + 22. * rng.unit());
    let along = (t - p.stubFrom) / maxf(0.001, p.stubTo - p.stubFrom);
    let len = p.stubLength * (1. - 0.65 * along) * (0.5 + 0.9 * rng.unit());
    let r = clampf(radiusAtT(rad, t) * 0.1, 0.012, 0.045);
    out.push(Stub(at, qc, len, r));
    k = k + 1;
  }
  out
}

// The point and frame at the fraction t along a stem's polyline (equal segments)
fn pointAt(pts: &List[Vec3], frames: &List[Quat], t: f32, outQ: &mut Quat) Vec3 {
  let n = pts.len() - 1usize;
  let f = clampf(t, 0., 1.) * f32.from(n);
  var i = usize.from(i32.from(f.floor()));
  if i >= n { i = n - 1usize; }
  let k = f - f32.from(i32.from(i));
  *outQ = (*frames[i]).slerp(*frames[i + 1usize], k);
  (*pts[i]).lerp(*pts[i + 1usize], k)
}

fn radiusAtT(rad: &List[f32], t: f32) f32 {
  let n = rad.len() - 1usize;
  let f = clampf(t, 0., 1.) * f32.from(n);
  var i = usize.from(i32.from(f.floor()));
  if i >= n { i = n - 1usize; }
  let k = f - f32.from(i32.from(i));
  *rad[i] * (1. - k) + *rad[i + 1usize] * k
}

// The children of the stem just built, in nodes along it
fn placeChildren(p: &TreeParams, rng: &mut Rng, job: Job, trunk: f32, pts: &List[Vec3], rad: &List[f32],
    frames: &List[Quat], si: i32, jobs: &mut List[Job]) {
  let lv = job.level;
  let c = lv + 1;
  let cp = p.levelParams[usize.from(c)];
  let lp = p.levelParams[usize.from(lv)];
  if lp.branches <= 0. { return; }
  let L = job.length;
  // how many: the level's count scaled by this stem's share of a full one
  var want: f32 = 0.;
  if lv == 0 { want = lp.branches * job.share; }
  else {
    let full = nominalLength(p, trunk, lv);
    want = lp.branches * (0.2 + 0.8 * clampf(L / maxf(0.001, full), 0., 1.)) * job.share;
  }
  var count = i32.from(want.floor());
  if rng.unit() < want - want.floor() { count = count + 1; }
  if count < 1 { return; }
  let zone0 = if lv == 0 && job.gen == 0 { p.baseSize } else { 0.12 };
  let per = if cp.perNode < 1 { 1 } else { cp.perNode };
  let groups = (count + per - 1) / per;
  var roll = rng.unit() * 360.;
  var g = 0;
  var made = 0;
  while g < groups {
    // (a whorl's node strays from even spacing by 'nodeJitter' of the spacing: tiers a year apart are not equal)
    let jit = if cp.nodeJitter > 0. { cp.nodeJitter * rng.signed() } else { 0. };
    let t = zone0 + (1. - zone0) * (f32.from(g) + 0.5 + jit + 0.25 * rng.signed() * (if per == 1 { 1. } else { 0. })) / f32.from(groups);
    let tr = clampf((t - zone0) / (1. - zone0), 0., 1.);
    var qa = Quat.identity();
    let at = pointAt(pts, frames, t, &mut qa);
    let offLen = t * L;
    // this node's turn
    if per > 1 {
      roll = roll + cp.nodeTwist;
      // (a whorl's turn from the last varies by 'rotateV' too, so a conifer's limbs do not line up in columns)
      if cp.rotateV > 0. { roll = roll + cp.rotateV * rng.signed(); }
    }
    var j = 0;
    while j < per && made < count {
      if per == 1 { roll = roll + cp.rotate + cp.rotateV * rng.signed(); }
      let nodeRoll = if per == 1 { roll } else { roll + 360. / f32.from(per) * f32.from(j) };
      var down: f32 = 0.;
      if cp.downAngleV >= 0. { down = cp.downAngle + cp.downAngleV * rng.signed(); }
      else { down = cp.downAngle + (0. - cp.downAngleV) * (1. - 2. * tr) + 0.1 * (0. - cp.downAngleV) * rng.signed(); }
      // a flat level: the roll that puts the child in the horizontal plane through the parent, to its left
      // (j even) or right, mixed with the random one by 'flat'
      var rollUsed = nodeRoll;
      if cp.flat > 0. {
        let pa = axisOf(qa);
        let across = pa.cross(v3(0., 1., 0.));
        if across.length() > 0.2 {
          let f = unitv(across);
          let x0 = qa * v3(1., 0., 0.);
          let ang = degrees(libc.atan2f(pa.dot(x0.cross(f)), x0.dot(f)));
          rollUsed = ang + 360. / f32.from(per) * f32.from(j) + (1. - cp.flat) * roll;
        }
      }
      let qr = rollQ(qa, rollUsed);
      let qc = pitchQ(qr, down);
      // the child's length
      var cl: f32 = 0.;
      if lv == 0 {
        cl = L * (cp.length + cp.lengthV * rng.signed()) * shapeRatio(p, 1. - tr);
      } else {
        cl = (cp.length + cp.lengthV * rng.signed()) * maxf(0., L - 0.6 * offLen);
      }
      // a conifer's incomplete whorl: a limb missing by chance, the likelier and the shorter on
      // the side the wind comes from (a shore tree is one-sided)
      var skipChance = cp.skip;
      if lv == 0 && p.windBias > 0. {
        let a = axisOf(qc);
        let w = libc.cosf(libc.atan2f(a.z, a.x) - radians(p.windAzimuth));
        cl = cl * (1. + 0.55 * p.windBias * w);
        skipChance = skipChance + 0.3 * p.windBias * (1. - w);
      }
      let dropped = skipChance > 0. && rng.unit() < skipChance;
      let rp = radiusAtT(rad, t);
      let ratio = clampf(cl / maxf(0.001, L), 0.01, 1.);
      let rc = if cp.radiusShare > 0. { rp * cp.radiusShare * (1. + 0.15 * rng.signed()) }
        else { minf(rp, rp * libc.powf(ratio, p.ratioPower)) };
      if cl > 0.02 && rc > 0. && !dropped {
        // the radius at the base: radiusAt tapers from 'radius', so start at rc
        jobs.push(Job(c, si, at, qc, cl, rc, 1., Vec2(0., 0.), 0));
      }
      made = made + 1;
      j = j + 1;
    }
    g = g + 1;
  }
}

// Leaf sites along a stem: nodes from its middle to its tip, each with the
// level's perNode leaves leaving at its twist
fn placeSites(p: &TreeParams, rng: &mut Rng, pts: &List[Vec3], frames: &List[Quat], si: i32, lv: i32, sites: &mut List[LeafSite]) {
  let lp = p.levelParams[usize.from(lv)];
  let per = if lp.perNode < 1 { 1 } else { lp.perNode };
  let nodes = if p.leafSites < 1 { 1 } else { p.leafSites };
  var roll = rng.unit() * 360.;
  var k = 0;
  while k < nodes {
    let t = 0.4 + 0.6 * f32.from(k + 1) / f32.from(nodes);
    var qa = Quat.identity();
    let at = pointAt(pts, frames, t, &mut qa);
    roll = roll + (if per == 1 { lp.rotate } else { lp.nodeTwist });
    var j = 0;
    while j < per {
      let r = roll + 360. / f32.from(per) * f32.from(j);
      let qr = rollQ(qa, r);
      // the side a leaf leaves in: the frame's x
      sites.push(LeafSite(at, axisOf(qa), qr * v3(1., 0., 0.), si, t, k));
      j = j + 1;
    }
    k = k + 1;
  }
}

// Grow the tree 'p' describes: the same params give the same tree
pub fn grow(p: &TreeParams) Tree {
  var rng = Rng.make(p.seed);
  var tree = Tree(List[Stem].empty(), List[LeafSite].empty(), 0., 0.);
  var jobs = List[Job].empty();
  let l0 = p.levelParams[0usize];
  let trunk = (p.scale + p.scaleV * rng.signed()) * (l0.length + l0.lengthV * rng.signed());
  jobs.push(Job(0, -1, v3(0., 0., 0.), Quat.identity(), trunk, trunk * p.ratio, 1., Vec2(0., 0.), 0));
  var next = 0usize;
  while next < jobs.len() {
    let job = *jobs[next];
    buildStem(p, &mut rng, job, trunk, &mut tree, &mut jobs);
    next = next + 1usize;
  }
  tree
}
