// ======== Starting params for two species ========
//
// A red maple, fitted to a photograph of a lone street tree in winter (see
// the browser's vegetation notes), and an eastern white pine from the
// paper's conifer shape: whorled branches, a conical envelope. Both are
// starting points: 'height' is the tree's nominal height in metres.

// A red maple: a short bare trunk that parts into steep, near-equal limbs
// (opposite pairs, the lowest spread wide), each curving back towards the
// vertical, with opposite branches of their own and dog-leg veers; a crown
// about 0.8 as wide as tall, widest at half its height.
pub fn redMaple(seed u32, height f32) TreeParams {
  mut p = new TreeParams();
  p.seed = seed;
  p.levels = 4;
  p.shape = SHAPE_CUSTOM;
  // the limbs' length by where on the trunk they leave: a straight ramp from
  // 0.41 (the highest) to 1.44 (the lowest), fitted with the other numbers
  // below to the crown's measured width profile and the limbs' exit angles
  // (a random search against winter-3's silhouette; the browser's vegetation notes)
  p.envelope = [0.412, 0.515, 0.618, 0.721, 0.824, 0.927, 1.030, 1.133, 1.236, 1.338, 1.440];
  p.scale = height * 0.394;
  p.baseSize = 0.551;
  p.ratio = 0.040;
  p.flare = 0.6;
  p.attractionUp = 0.12;
  p.kinkRecover = 0.4;
  p.leafFromLevel = 3;
  p.leafSites = 4;
  mut l0 = new LevelParams();
  l0.length = 1.;
  l0.taper = 0.25;
  l0.curveRes = 5;
  l0.curveV = 8.;
  l0.branches = 7.;
  p.levelParams[0usize] = l0;
  mut l1 = new LevelParams();
  l1.length = 1.362;
  l1.lengthV = 0.1;
  l1.taper = 0.85;
  l1.curveRes = 8;
  l1.curve = -38.2;
  l1.curveV = 14.;
  l1.kink = 0.10;
  l1.kinkAngle = 22.;
  l1.segSplits = 0.05;
  l1.splitAngle = 22.;
  l1.downAngle = 19.2;
  l1.downAngleV = -12.8;
  l1.radiusShare = 0.52;
  l1.perNode = 2;
  l1.nodeTwist = 90.;
  l1.branches = 16.;
  p.levelParams[1usize] = l1;
  mut l2 = new LevelParams();
  l2.length = 0.738;
  l2.lengthV = 0.12;
  l2.taper = 1.;
  l2.curveRes = 5;
  l2.curve = -4.;
  l2.curveV = 20.;
  l2.kink = 0.10;
  l2.kinkAngle = 20.;
  l2.downAngle = 71.1;
  l2.downAngleV = -10.;
  l2.radiusShare = 0.45;
  l2.perNode = 2;
  l2.nodeTwist = 90.;
  l2.branches = 9.;
  p.levelParams[2usize] = l2;
  mut l3 = new LevelParams();
  l3.length = 0.4;
  l3.lengthV = 0.15;
  l3.taper = 1.;
  l3.curveRes = 3;
  l3.curve = -15.;
  l3.curveV = 15.;
  l3.downAngle = 48.;
  l3.downAngleV = 8.;
  l3.radiusShare = 0.6;
  l3.perNode = 2;
  l3.nodeTwist = 90.;
  p.levelParams[3usize] = l3;
  p;
}

// An eastern white pine: a straight trunk to a point, bare to a fifth, with
// whorls of five branches, the lowest longest, drooping then turning up at
// their ends, each bearing needle sprays.
pub fn whitePine(seed u32, height f32) TreeParams {
  mut p = new TreeParams();
  p.seed = seed;
  p.levels = 3;
  p.shape = SHAPE_CONICAL;
  p.scale = height;
  p.baseSize = 0.2;
  p.ratio = 0.016;
  p.flare = 0.5;
  p.leafFromLevel = 2;
  p.leafSites = 6;
  mut l0 = new LevelParams();
  l0.length = 1.;
  l0.taper = 1.;
  l0.curveRes = 8;
  l0.curveV = 6.;
  l0.branches = 70.;
  p.levelParams[0usize] = l0;
  mut l1 = new LevelParams();
  l1.length = 0.36;
  l1.lengthV = 0.06;
  l1.taper = 0.9;
  l1.curveRes = 5;
  l1.curve = 14.;
  l1.curveBack = -30.;
  l1.curveV = 14.;
  l1.downAngle = 80.;
  l1.downAngleV = 8.;
  l1.radiusShare = 0.28;
  l1.perNode = 5;
  l1.nodeTwist = 144.;
  l1.branches = 14.;
  p.levelParams[1usize] = l1;
  mut l2 = new LevelParams();
  l2.length = 0.3;
  l2.lengthV = 0.1;
  l2.taper = 1.;
  l2.curveRes = 3;
  l2.curve = 8.;
  l2.downAngle = 55.;
  l2.downAngleV = 10.;
  l2.radiusShare = 0.5;
  l2.perNode = 2;
  l2.nodeTwist = 90.;
  p.levelParams[2usize] = l2;
  p;
}

// The foliage that goes with each
pub fn mapleFoliage(seed u32) FoliageParams {
  mut f = new FoliageParams();
  f.seed = seed;
  f.kind = FOLIAGE_MAPLE;
  f;
}

pub fn pineFoliage(seed u32) FoliageParams {
  mut f = new FoliageParams();
  f.seed = seed;
  f.kind = FOLIAGE_NEEDLES;
  f;
}
