// ======== Starting params for the species ========
//
// A red maple, fitted to a photograph of a lone street tree in winter (see
// the browser's vegetation notes), and an eastern white pine from the
// paper's conifer shape: whorled branches, a conical envelope (the first
// pine, 'whitePine', is that, with the ribbons of 'pineFoliage'). Then the
// conifers of a cottage on an island at 45 degrees north, built for cards
// (FOLIAGE_TUFTS, FOLIAGE_SPRAYS) and drawn from a research note's numbers
// (a white pine's whorls a year apart, 0.45 to 0.9 m, near horizontal with
// the outer third of each limb turned up; a forest pine's lower trunk bare
// but for its dead stubs; the shore tree one-sided; a hemlock's drooping
// sprays; a fir's close, upswept tiers): 'whitePineYoung', 'whitePineForest',
// 'whitePineShore', 'easternHemlock', 'balsamFir'. All are starting points:
// 'height' is the tree's nominal height in metres.

// A red maple: a short bare trunk that parts into steep, near-equal limbs
// (opposite pairs, the lowest spread wide), each curving back towards the
// vertical, with opposite branches of their own and dog-leg veers; a crown
// about 0.8 as wide as tall, widest at half its height.
pub fn redMaple(seed u32, height f32) TreeParams {
  var p = new TreeParams();
  p.seed = seed;
  p.levels = 4;
  p.shape = SHAPE_CUSTOM;
  // the limbs' length by where on the trunk they leave: a straight ramp from
  // 0.41 (the highest) to 1.44 (the lowest), fitted with the other numbers
  // below to the crown's measured width profile and the limbs' exit angles
  // (a random search against winter-3's silhouette; the browser's vegetation notes)
  p.envelope = [0.412, 0.515, 0.618, 0.721, 0.824, 0.927, 1.030, 1.133, 1.236, 1.338, 1.440];
  p.scale = height * 0.394;
  p.baseSize = 0.551;
  p.ratio = 0.040;
  p.flare = 0.6;
  p.attractionUp = 0.12;
  p.kinkRecover = 0.4;
  p.leafFromLevel = 3;
  p.leafSites = 4;
  var l0 = new LevelParams();
  l0.length = 1.;
  l0.taper = 0.25;
  l0.curveRes = 5;
  l0.curveV = 8.;
  l0.branches = 7.;
  p.levelParams[0usize] = l0;
  var l1 = new LevelParams();
  l1.length = 1.362;
  l1.lengthV = 0.1;
  l1.taper = 0.85;
  l1.curveRes = 8;
  l1.curve = -38.2;
  l1.curveV = 14.;
  l1.kink = 0.10;
  l1.kinkAngle = 22.;
  l1.segSplits = 0.05;
  l1.splitAngle = 22.;
  l1.downAngle = 19.2;
  l1.downAngleV = -12.8;
  l1.radiusShare = 0.52;
  l1.perNode = 2;
  l1.nodeTwist = 90.;
  l1.branches = 16.;
  p.levelParams[1usize] = l1;
  var l2 = new LevelParams();
  l2.length = 0.738;
  l2.lengthV = 0.12;
  l2.taper = 1.;
  l2.curveRes = 5;
  l2.curve = -4.;
  l2.curveV = 20.;
  l2.kink = 0.10;
  l2.kinkAngle = 20.;
  l2.downAngle = 71.1;
  l2.downAngleV = -10.;
  l2.radiusShare = 0.45;
  l2.perNode = 2;
  l2.nodeTwist = 90.;
  l2.branches = 9.;
  p.levelParams[2usize] = l2;
  var l3 = new LevelParams();
  l3.length = 0.4;
  l3.lengthV = 0.15;
  l3.taper = 1.;
  l3.curveRes = 3;
  l3.curve = -15.;
  l3.curveV = 15.;
  l3.downAngle = 48.;
  l3.downAngleV = 8.;
  l3.radiusShare = 0.6;
  l3.perNode = 2;
  l3.nodeTwist = 90.;
  p.levelParams[3usize] = l3;
  p;
}

// An eastern white pine: a straight trunk to a point, bare to a fifth, with
// whorls of five branches, the lowest longest, drooping then turning up at
// their ends, each bearing needle sprays.
pub fn whitePine(seed u32, height f32) TreeParams {
  var p = new TreeParams();
  p.seed = seed;
  p.levels = 3;
  p.shape = SHAPE_CONICAL;
  p.scale = height;
  p.baseSize = 0.2;
  p.ratio = 0.016;
  p.flare = 0.5;
  p.leafFromLevel = 2;
  p.leafSites = 6;
  var l0 = new LevelParams();
  l0.length = 1.;
  l0.taper = 1.;
  l0.curveRes = 8;
  l0.curveV = 6.;
  l0.branches = 70.;
  p.levelParams[0usize] = l0;
  var l1 = new LevelParams();
  l1.length = 0.36;
  l1.lengthV = 0.06;
  l1.taper = 0.9;
  l1.curveRes = 5;
  l1.curve = 14.;
  l1.curveBack = -30.;
  l1.curveV = 14.;
  l1.downAngle = 80.;
  l1.downAngleV = 8.;
  l1.radiusShare = 0.28;
  l1.perNode = 5;
  l1.nodeTwist = 144.;
  l1.branches = 14.;
  p.levelParams[1usize] = l1;
  var l2 = new LevelParams();
  l2.length = 0.3;
  l2.lengthV = 0.1;
  l2.taper = 1.;
  l2.curveRes = 3;
  l2.curve = 8.;
  l2.downAngle = 55.;
  l2.downAngleV = 10.;
  l2.radiusShare = 0.5;
  l2.perNode = 2;
  l2.nodeTwist = 90.;
  p.levelParams[2usize] = l2;
  p;
}

// The foliage that goes with each
pub fn mapleFoliage(seed u32) FoliageParams {
  var f = new FoliageParams();
  f.seed = seed;
  f.kind = FOLIAGE_MAPLE;
  f;
}

pub fn pineFoliage(seed u32) FoliageParams {
  var f = new FoliageParams();
  f.seed = seed;
  f.kind = FOLIAGE_PLUMES;
  f;
}

// The trunk and limbs every cone-card conifer starts from: two levels (the trunk, and limbs with no
// twigs, which a tuft or a spray stands in for), the limbs 'tiers' whorls of 'per', leaving the
// trunk near horizontal ('down' degrees from the vertical at mid height, steeper in the top tiers
// by 'steeper' and wider in the bottom ones) and running out 'reach' of the tree's height at the
// lowest tier, 'sag' degrees of bend down over the first half of each limb and 'upturn' back up over
// the second (the outer third rising, as a white pine's do)
fn conifer(seed u32, height f32, tiers i32, per i32, reach f32, down f32, steeper f32, sag f32, upturn f32) TreeParams {
  var p = new TreeParams();
  p.seed = seed;
  p.levels = 2;
  p.shape = SHAPE_CONICAL;
  p.scale = height;
  p.leafFromLevel = 9;
  var l0 = new LevelParams();
  l0.length = 1.;
  l0.taper = 0.95;
  l0.curveRes = 8;
  l0.curveV = 5.;
  l0.branches = f32.from(tiers * per);
  p.levelParams[0usize] = l0;
  var l1 = new LevelParams();
  l1.length = reach;
  l1.lengthV = 0.1;
  l1.taper = 0.85;
  l1.curveRes = 4;
  l1.curve = sag;
  l1.curveBack = 0. - upturn;
  l1.curveV = 12.;
  l1.downAngle = down;
  l1.downAngleV = 0. - steeper;
  l1.radiusShare = 0.2;
  l1.perNode = per;
  // each whorl turns from the last by a third of the way between two limbs' places, and a little
  // at random, so the limbs do not stand in columns
  l1.nodeTwist = 360. / f32.from(per) * 0.43;
  l1.rotateV = 360. / f32.from(per) * 0.25;
  // a few twigs on each limb, in pairs to its left and right in the horizontal plane (the tier's pad
  // is limb and twigs together), leaving it at about 60 degrees
  l1.branches = 3.;
  p.levelParams[1usize] = l1;
  var l2 = new LevelParams();
  l2.length = 0.5;
  l2.lengthV = 0.15;
  l2.taper = 0.9;
  l2.curveRes = 3;
  l2.curve = 4.;
  l2.curveV = 10.;
  l2.downAngle = 62.;
  l2.downAngleV = 8.;
  l2.radiusShare = 0.5;
  l2.perNode = 2;
  l2.nodeTwist = 0.;
  l2.flat = 0.9;
  l2.skip = 0.15;
  p.levelParams[2usize] = l2;
  p.levels = 3;
  p;
}

// A young open-grown white pine (8 to 13 m): dense, a cone of whorls of five 0.5 to 0.65 m apart
// from a hand's height up, limbs 0.25 of the height at the lowest, a crown half as wide as tall
pub fn whitePineYoung(seed u32, height f32) TreeParams {
  var p = conifer(seed, height, 14, 5, 0.25, 78., 18., 8., 34.);
  p.baseSize = 0.14;
  p.ratio = 0.017;
  p.flare = 0.5;
  var l1 = p.levelParams[1usize];
  l1.skip = 0.12;
  l1.nodeJitter = 0.3;
  p.levelParams[1usize] = l1;
  p;
}

// A mature forest-grown white pine (20 to 28 m): a straight grey trunk, bare but for dead stubs
// to half its height, a live crown of ten or so whorls of four above it, limbs short (0.15 of the
// height at the lowest of them), the crown irregular and the top a little off the vertical
pub fn whitePineForest(seed u32, height f32) TreeParams {
  var p = conifer(seed, height, 13, 4, 0.15, 82., 22., 6., 30.);
  p.shape = SHAPE_CUSTOM;
  p.envelope = [0.35, 0.6, 0.85, 1.0, 1.0, 0.95, 0.85, 0.75, 0.65, 0.55, 0.45];
  p.baseSize = 0.55;
  p.ratio = 0.0135;
  p.flare = 0.55;
  p.stubs = 34;
  p.stubFrom = 0.06;
  p.stubTo = 0.5;
  p.stubLength = 0.34;
  var l0 = p.levelParams[0usize];
  l0.taper = 0.9;
  l0.kink = 0.07;
  l0.kinkAngle = 9.;
  l0.curveV = 7.;
  p.levelParams[0usize] = l0;
  var l1 = p.levelParams[1usize];
  l1.skip = 0.2;
  l1.nodeJitter = 0.35;
  p.levelParams[1usize] = l1;
  p;
}

// A mature wind-shaped white pine (14 to 20 m), a shore tree: a trunk leaning a few degrees,
// the limbs long on the downwind side and short or missing on the other, flat-topped, the crown
// out to 0.3 of the height one way, whorls of four, the lower limbs few
pub fn whitePineShore(seed u32, height f32) TreeParams {
  var p = conifer(seed, height, 9, 4, 0.3, 84., 14., 5., 26.);
  p.shape = SHAPE_CUSTOM;
  p.envelope = [0.8, 0.95, 1.0, 1.0, 0.95, 0.85, 0.75, 0.65, 0.55, 0.45, 0.35];
  p.baseSize = 0.2;
  p.ratio = 0.016;
  p.flare = 0.55;
  p.windBias = 0.75;
  p.windAzimuth = 90.;
  p.stubs = 12;
  p.stubFrom = 0.05;
  p.stubTo = 0.3;
  p.stubLength = 0.3;
  var l0 = p.levelParams[0usize];
  l0.curve = 9.;
  l0.curveV = 6.;
  l0.kink = 0.08;
  l0.kinkAngle = 10.;
  p.levelParams[0usize] = l0;
  var l1 = p.levelParams[1usize];
  l1.lengthV = 0.2;
  l1.skip = 0.25;
  l1.nodeJitter = 0.4;
  p.levelParams[1usize] = l1;
  p;
}

// An eastern hemlock (7 to 15 m): limbs all the way down, six to eight to a loose tier, short and
// drooping, a narrow diamond outline widest in the lower third
pub fn easternHemlock(seed u32, height f32) TreeParams {
  var p = conifer(seed, height, 9, 7, 0.17, 88., 14., 24., 4.);
  p.shape = SHAPE_CUSTOM;
  p.envelope = [0.10, 0.25, 0.45, 0.65, 0.82, 0.95, 1.0, 0.95, 0.80, 0.62, 0.45];
  p.baseSize = 0.04;
  p.ratio = 0.018;
  p.flare = 0.45;
  var l1 = p.levelParams[1usize];
  l1.skip = 0.15;
  l1.nodeJitter = 0.45;
  l1.curveV = 16.;
  p.levelParams[1usize] = l1;
  p;
}

// A balsam fir (8 to 14 m): a tight spire of twelve to sixteen close tiers of six from the ground
// up, limbs short and the tips swept up
pub fn balsamFir(seed u32, height f32) TreeParams {
  var p = conifer(seed, height, 14, 6, 0.19, 78., 20., 0., 24.);
  p.baseSize = 0.03;
  p.ratio = 0.014;
  p.flare = 0.4;
  var l1 = p.levelParams[1usize];
  l1.skip = 0.05;
  l1.nodeJitter = 0.15;
  p.levelParams[1usize] = l1;
  p;
}

// The cards that go with the conifers: tufts for the white pines (a paint of two cells, fresh and
// October's tawny), sprays for hemlock and fir
pub fn pineTufts(seed u32) FoliageParams {
  var f = new FoliageParams();
  f.seed = seed;
  f.kind = FOLIAGE_TUFTS;
  f.cells = 4;
  f.tawnyShare = 0.45;
  f.tuftSpacing = 1.0;
  f.padWidth = 1.4;
  f.padLength = 1.1;
  f.padStart = 0.15;
  f.tuftSize = 0.5;
  f.tuftMax = 70;
  f;
}

pub fn hemlockSprays(seed u32) FoliageParams {
  var f = new FoliageParams();
  f.seed = seed;
  f.kind = FOLIAGE_SPRAYS;
  f.sprayStart = 0.12;
  f.sprayLength = 0.95;
  f.sprayWidth = 1.1;
  f.sprayDroop = 0.3;
  f;
}

pub fn firSprays(seed u32) FoliageParams {
  var f = new FoliageParams();
  f.seed = seed;
  f.kind = FOLIAGE_SPRAYS;
  f.sprayStart = 0.1;
  f.sprayLength = 0.8;
  f.sprayWidth = 0.8;
  f.sprayDroop = 0.12;
  f;
}

// ---- Dense conifers, for the whole-sprig cards of FOLIAGE_BRANCHLETS ----
//
// Each is the shared 'conifer' skeleton (a trunk and its whorled limbs, a few flat twigs on each limb) with
// species as data: how many whorls of how many limbs, how long, how they hang, and the paint that goes with
// them.

// A spruce (Norway, white, Sitka): a narrow cone of close whorls, limbs sagging then lifting a little at the
// tip, the leader straight. 'bare' is the share of the trunk below the limbs: a young tree in the open, 0.03;
// a forest tree that has shed its lower limbs, 0.3.
pub fn spruceTree(seed u32, height f32, bare f32) TreeParams {
  var p = conifer(seed, height, 28, 5, 0.17, 82., 20., 16., 6.);
  p.shape = SHAPE_CUSTOM;
  p.envelope = [0.12, 0.25, 0.38, 0.5, 0.62, 0.72, 0.82, 0.9, 0.96, 1.0, 0.98];
  p.baseSize = bare;
  p.ratio = 0.014;
  p.flare = 0.5;
  var l1 = p.levelParams[1usize];
  l1.skip = 0.08;
  l1.nodeJitter = 0.3;
  l1.branches = 5.;
  p.levelParams[1usize] = l1;
  p;
}

// A fir (Douglas, grand, balsam): a tighter spire of closer tiers, limbs level and their tips swept up
pub fn firTree(seed u32, height f32, bare f32) TreeParams {
  var p = conifer(seed, height, 26, 6, 0.15, 76., 24., 2., 24.);
  p.baseSize = bare;
  p.ratio = 0.014;
  p.flare = 0.45;
  var l1 = p.levelParams[1usize];
  l1.skip = 0.04;
  l1.nodeJitter = 0.2;
  l1.branches = 5.;
  p.levelParams[1usize] = l1;
  p;
}

// A mature eastern white pine as a stand grows it, near enough to Jon's photograph of trees in a meadow: horizontal
// whorls a metre or so apart, each limb long and level, its needles in a dense dark cloud toward the end, the
// whole an irregular, wind-leaning cone. 'lean' is how far the trunk's top is off the vertical, degrees.
pub fn whitePineMature(seed u32, height f32, bare f32) TreeParams {
  var p = conifer(seed, height, 13, 4, 0.2, 86., 14., 4., 22.);
  p.shape = SHAPE_CUSTOM;
  p.envelope = [0.35, 0.55, 0.75, 0.9, 1.0, 1.0, 0.95, 0.85, 0.75, 0.65, 0.55];
  p.baseSize = bare;
  p.ratio = 0.015;
  p.flare = 0.55;
  p.stubs = 10;
  p.stubFrom = 0.04;
  p.stubTo = bare;
  var l0 = p.levelParams[0usize];
  l0.kink = 0.08;
  l0.kinkAngle = 8.;
  l0.curveV = 7.;
  l0.curve = 4.;
  p.levelParams[0usize] = l0;
  var l1 = p.levelParams[1usize];
  l1.skip = 0.22;
  l1.nodeJitter = 0.4;
  l1.lengthV = 0.2;
  l1.branches = 4.;
  p.levelParams[1usize] = l1;
  p;
}

// A Norfolk Island pine (Araucaria): a ruler-straight trunk, regular whorls of five near-level limbs spaced
// evenly, a perfect cone, each limb's end turned up
pub fn norfolkPine(seed u32, height f32) TreeParams {
  var p = conifer(seed, height, 19, 5, 0.3, 90., 6., 0., 14.);
  p.baseSize = 0.12;
  p.ratio = 0.012;
  p.flare = 0.5;
  var l0 = p.levelParams[0usize];
  l0.curveV = 1.;
  l0.taper = 0.9;
  p.levelParams[0usize] = l0;
  var l1 = p.levelParams[1usize];
  l1.lengthV = 0.04;
  l1.skip = 0.;
  l1.nodeJitter = 0.;
  l1.curveV = 4.;
  l1.rotateV = 8.;
  l1.branches = 4.;
  p.levelParams[1usize] = l1;
  var l2 = p.levelParams[2usize];
  l2.curve = -20.;
  l2.skip = 0.05;
  p.levelParams[2usize] = l2;
  p;
}

// The cards that go with each ('cardScale' 1 for a mature tree, smaller for a young one's finer sprigs)
fn branchlets(seed u32, cardScale f32) FoliageParams {
  var f = new FoliageParams();
  f.seed = seed;
  f.kind = FOLIAGE_BRANCHLETS;
  f.tuftFromLevel = 1;
  f.brLength = 1.0 * cardScale;
  f.brWidth = 1.0 * cardScale;
  f;
}

pub fn spruceFoliage(seed u32, cardScale f32) FoliageParams {
  var f = branchlets(seed, cardScale);
  f.brStart = 0.08;
  f.brLength = 1.15 * cardScale;
  f.brWidth = 1.05 * cardScale;
  f.brStep = 0.5;
  f.brCards = 3;
  f.brRoll = 62.;
  f.brHang = 0.;
  f.brTipLift = 4.;
  f.brDroop = 0.3;
  f.brShadeRows = 4;
  // the paint's second cell has cones on it: some of the cards on the upper boughs take it
  f.cells = 2;
  f.brAlt = 1;
  f.brAltFrom = 0.5;
  f.brAltShare = 0.4;
  f;
}

pub fn firFoliage(seed u32, cardScale f32) FoliageParams {
  var f = branchlets(seed, cardScale);
  f.brStart = 0.08;
  f.brLength = 1.0 * cardScale;
  f.brWidth = 0.85 * cardScale;
  f.brStep = 0.5;
  f.brCards = 2;
  f.brRoll = 36.;
  f.brTipLift = 20.;
  f.brDroop = 0.12;
  f.brShadeRows = 4;
  f;
}

// A white pine's: big pads at a limb's end (paint cell 2, the pad), none on its bare inner part
pub fn whitePineFoliage(seed u32, cardScale f32) FoliageParams {
  var f = branchlets(seed, cardScale);
  f.brStart = 0.38;
  f.brLength = 1.5 * cardScale;
  f.brWidth = 1.7 * cardScale;
  f.brStep = 0.55;
  f.brCards = 2;
  f.brRoll = 40.;
  f.brTipLift = 14.;
  f.brDroop = 0.25;
  f.brCell = 2;
  f.cells = 4;
  f.brShadeRows = 4;
  f;
}

pub fn norfolkFoliage(seed u32, cardScale f32) FoliageParams {
  var f = branchlets(seed, cardScale);
  f.brStart = 0.14;
  f.brLength = 1.15 * cardScale;
  f.brWidth = 1.2 * cardScale;
  f.brStep = 0.5;
  f.brCards = 3;
  f.brRoll = 55.;
  f.brHang = 0.;
  f.brTipLift = 38.;
  f.brDroop = 0.05;
  f.brShadeRows = 4;
  f;
}

// A conifer's colour by age, a multiplier on its paint (the draw's tint): 0 a sapling's bright yellow-green
// to 1 a mature tree's near black-green, 'vary' (0 to 1) the share of per-tree variation, drawn from 'seed'
pub fn ageTint(age f32, vary f32, seed u32) Color {
  var rng = Rng.make(seed);
  let a = clampf(age + 0.12 * vary * rng.signed(), 0., 1.);
  let j = 1. + 0.18 * vary * rng.signed();
  let k = 1. + 0.12 * vary * rng.signed();
  new Color((2.7 + (0.78 - 2.7) * a) * j, (3.0 + (0.86 - 3.0) * a) * j, (1.0 + (0.92 - 1.0) * a) * k, 1.);
}
