// The one line each error of this package gives a person is pinned here, with the
// number fields in play, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use String;
import http3 use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- FrameError(1037u64, "the frame is cut off"), "the frame is cut off (HTTP/3 error code 1037)", "a frame error");
  says(String() <- QpackError.make(QpackErrorKind.Decompression, "a bad index"), "decompression failed: a bad index", "qpack decompression");
  says(String() <- QpackError.make(QpackErrorKind.EncoderStream, "too big"), "encoder stream: too big", "qpack encoder stream");
  says(String() <- QpackError.make(QpackErrorKind.DecoderStream, "x"), "decoder stream: x", "qpack decoder stream");
  says(String() <- QpackError.make(QpackErrorKind.StreamClosed, "x"), "critical stream closed: x", "qpack stream closed");
  says(String() <- QpackError.make(QpackErrorKind.TooLarge, "x"), "too large: x", "qpack too large");
  done()
}
