// rawGet of a stale handle is a program error, and a panic at the caller's line, after writing out what was
// printed before it: this test's .out is the line printed before the call, its .exit a panic's, and
// its .err the panic's line.

mod genpoolrawget;

import stdio use *;
import pools use *;

fn main() i32 {
  var p = GenPool[u32]();
  let h = p.add(7u32);
  p.remove(h);
  printStr("calling\n");
  let x = p.rawGet(h);
  printStr("not reached\n");
  0i32
}
