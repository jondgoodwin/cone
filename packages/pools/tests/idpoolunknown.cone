// Freeing an id that was never handed out is a program error, and a panic, after
// writing out what was printed before it: this test's .out is the line printed
// before the free, its .exit a panic's, and its .err the panic's line, naming the
// line of that call.

mod idpoolunknown;

import stdio use *;
import pools use *;

fn main() i32 {
  var p = IdPool.make();
  p.alloc();
  printStr("freeing 5 of 1 issued\n");
  p.free(5u32);
  printStr("not reached\n");
  0i32
}
