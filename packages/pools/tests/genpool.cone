// What a GenPool does, case by case. Each expected value is worked out by hand.
// Cells are handed out in index order from a fresh block, and a freed cell is
// the next one used (last in, first out). Pools here start with room for 4
// entries unless said, and the block doubles when it is full.

mod genpool;

import testing use *;
import pools use *;
import collections use List;

struct Pt {
  pub x: i64;
  pub y: i64;
}

let deaths: Atomic[u64];

fn @initpure init() {
  deaths = Atomic[u64].of(0u64);
}

struct Mortal is Move {
  pub id: i64;

  fn final(self: &uni) {
    deaths.add(1u64);
  }
}

// Whether the handle reaches nothing / the cell holds nothing live
fn gone(t: &GenPool[Pt], h: Handle) bool {
  match t.borrow(h) {
    case is None {true}
    case is Some {false}
  }
}

fn goneAt(t: &GenPool[Pt], i: u32) bool {
  match t.borrowAt(i) {
    case is None {true}
    case is Some {false}
  }
}

// What the handle reaches, x
fn xOf(t: &GenPool[Pt], h: Handle) i64 {
  t.borrow(h).unwrap().x
}

// remove, retire and reuse make a handle stale
fn stale() {
  var t = GenPool[Pt](4usize);
  let a = t.add(Pt(1i64, 2i64));
  expectUInt(u64.from(a.index), 0u64, "first entry in cell 0");
  expectUInt(u64.from(a.gen), 1u64, "as its first occupant");
  expectInt(t.borrow(a).unwrap().y, 2i64, "borrow reads it");
  expect(t.remove(a), "remove answers true");
  expect(gone(&t, a), "a removed entry's handle reaches nothing");
  expect(!t.remove(a), "removing it again answers false");
  let b = t.add(Pt(5i64, 6i64));
  expectUInt(u64.from(b.index), 0u64, "the freed cell is the next used");
  expectUInt(u64.from(b.gen), 2u64, "as its second occupant");
  expect(gone(&t, a), "the old handle still reaches nothing after reuse");
  expectInt(xOf(&t, b), 5i64, "the new one reaches the new entry");

  // retire: dead to every handle and to borrowAt(), not reusable until freed
  expect(t.retire(b), "retire answers true");
  expect(gone(&t, b), "a retired entry's handle reaches nothing");
  expect(goneAt(&t, 0u32), "borrowAt does not reach it");
  expect(!t.isLive(0u32), "it is not live");
  expectUInt(u64.from(t.len()), 0u64, "len counts live entries");
  expect(!t.retire(b), "retiring twice answers false");
  expect(!t.remove(b), "remove does not take a retired entry");
  let c = t.add(Pt(7i64, 8i64));
  expectUInt(u64.from(c.index), 1u64, "a retired cell is not reused");
  expect(!t.free(c), "free of a live entry answers false");
  expect(t.free(b), "free of the retired entry answers true");
  expect(!t.free(b), "free twice answers false");
  let d = t.add(Pt(9i64, 9i64));
  expectUInt(u64.from(d.index), 0u64, "the freed cell is used next");
  expectUInt(u64.from(d.gen), 3u64, "as its third occupant");
  expect(gone(&t, b), "the retired entry's handle stays stale");
  expect(Handle.none().isNone(), "none is none");
  expect(gone(&t, Handle.none()), "none reaches nothing");
  expect(goneAt(&t, 1000u32), "borrowAt past the pool: None");
}

// The block grows by doubling and moves its entries: every handle still reaches
// its own entry, and the handles of removed ones stay stale
fn growth() {
  var t = GenPool[Pt](4usize);
  var hs = List[Handle]();
  var i = 0i64;
  while i < 300i64 {
    hs.push(t.add(Pt(i, 0i64)));
    i = i + 1i64;
  }
  expectUInt(u64.from(t.len()), 300u64, "300 live");
  expectUInt(u64.from(t.bound()), 300u64, "300 cells used, in index order");
  var ok = true;
  i = 0i64;
  while i < 300i64 {
    let h = *hs[usize.from(i as u64)];
    if h.index != u32.from(i as u64) || xOf(&t, h) != i {ok = false;}
    i = i + 1i64;
  }
  expect(ok, "every handle reaches its own entry after the block grew");
  var k = 0usize;
  while k < 300usize {t.remove(*hs[k]); k = k + 1usize;}
  expectUInt(u64.from(t.len()), 0u64, "all gone");
  expectUInt(u64.from(t.bound()), 300u64, "the cells stay, nothing is given back");
  let n = t.add(Pt(200i64, 0i64));
  expectUInt(u64.from(n.index), 299u64, "the cell freed last is used first");
  expectUInt(u64.from(n.gen), 2u64, "its generation moved on");
  expect(gone(&t, *hs[299usize]), "the old handle to that cell reaches nothing");
  expectInt(xOf(&t, n), 200i64, "the new entry is reached");
}

// A pool made empty has no block; made with room has it
fn made() {
  var e = GenPool[Pt]();
  expectUInt(u64.from(e.bound()), 0u64, "an empty pool uses no cells");
  expect(gone(&e, Handle(0u32, 1u32)), "and reaches nothing");
  expect(!e.remove(Handle(0u32, 1u32)), "removing a made-up handle answers false");
  expect(!e.retire(Handle(0u32, 1u32)), "so does retire");
  expect(!e.free(Handle(0u32, 1u32)), "and free");
  let a = e.add(Pt(1i64, 0i64));
  expectUInt(u64.from(a.index), 0u64, "the first add makes the block");
  var r = GenPool[Pt](100usize);
  expectUInt(u64.from(r.bound()), 0u64, "room for 100 uses no cells yet");
  var i = 0i64;
  while i < 100i64 {r.add(Pt(i, 0i64)); i = i + 1i64;}
  expectUInt(u64.from(r.len()), 100u64, "and holds them");
}

// A generation that would wrap retires its cell for good
fn wrap() {
  var t = GenPool[Pt](4usize);
  let a = t.add(Pt(1i64, 0i64));
  t.remove(a);
  t.setGenForTests(0u32, 0xFFFFFFFFu32);
  let b = t.add(Pt(2i64, 0i64));
  expectUInt(u64.from(b.index), 0u64, "the cell is used");
  expectUInt(u64.from(b.gen), 0xFFFFFFFFu64, "at the top generation");
  expect(t.remove(b), "removed");
  expect(gone(&t, b), "stale");
  var seen0 = false;
  var i = 0;
  while i < 12 {
    let h = t.add(Pt(0i64, 0i64));
    if h.index == 0u32 {seen0 = true;}
    i = i + 1;
  }
  expect(!seen0, "the cell is never handed out again");
  expectUInt(u64.from(t.len()), 12u64, "twelve live");
  expectUInt(u64.from(t.bound()), 13u64, "the dead cell counts among the cells used");
  var c = 1u32;
  while c < 13u32 {t.removeAt(c); c = c + 1u32;}
  expectUInt(u64.from(t.len()), 0u64, "all gone");
}

// Add and remove at the end of the used cells reuse the one cell
fn thrash() {
  var t = GenPool[Pt](4usize);
  var i = 0i64;
  while i < 4i64 {t.add(Pt(i, 0i64)); i = i + 1i64;}
  var h = t.add(Pt(9i64, 0i64));
  var n = 0;
  while n < 1000 {
    t.remove(h);
    h = t.add(Pt(9i64, 0i64));
    n = n + 1;
  }
  expectUInt(u64.from(t.bound()), 5u64, "a thousand pairs: still five cells");
  expectUInt(u64.from(h.gen), 1001u64, "same cell each time: generation 1 + 1000");
  expectUInt(u64.from(h.index), 4u64, "in cell 4");
}

// The walk visits exactly the live cells, in index order
fn walkAt(keepEvery: i64, want: i64, label: &Array[u8]) {
  var t = GenPool[Pt](16usize);
  var hs = List[Handle]();
  var i = 0i64;
  while i < 1000i64 {hs.push(t.add(Pt(i, 0i64))); i = i + 1i64;}
  i = 0i64;
  while i < 1000i64 {
    if i % keepEvery != 0i64 {t.remove(*hs[usize.from(i as u64)]);}
    i = i + 1i64;
  }
  var it = t.entries();
  var n = 0i64;
  var last = -1i64;
  var ordered = true;
  var matches = true;
  while true {
    match it.next() {
      case let Some(e) {
        let idx = i64.from(e.0);
        if idx <= last {ordered = false;}
        if e.1.x != idx || idx % keepEvery != 0i64 {matches = false;}
        last = idx;
        n = n + 1i64;
      }
      case is None {break;}
    }
  }
  expectInt(n, want, label);
  expect(ordered, "in index order");
  expect(matches, "each live cell and only those");
  var it2 = t.iter();
  var m = 0i64;
  while true {
    match it2.next() {
      case let Some(p) {m = m + 1i64;}
      case is None {break;}
    }
  }
  expectInt(m, want, "iter agrees");
}

fn walk() {
  walkAt(100i64, 10i64, "1% occupancy: 10 live");
  walkAt(2i64, 500i64, "50% occupancy: 500 live");
  walkAt(1i64, 1000i64, "100% occupancy: 1000 live");
  var e = GenPool[Pt](4usize);
  expectUInt(u64.from(e.nextLive(0u32)), 0xFFFFFFFFu64, "an empty pool has nothing to walk");
}

// remove and take finalize once; the pool's death finalizes the rest, retired included
fn finalizers() {
  let before = deaths.load();
  {
    var t = GenPool[Mortal](4usize);
    let a = t.add(Mortal(1i64));
    let b = t.add(Mortal(2i64));
    let c = t.add(Mortal(3i64));
    let d = t.add(Mortal(4i64));
    t.remove(a);
    expectUInt(deaths.load() - before, 1u64, "remove finalizes once");
    t.remove(a);
    expectUInt(deaths.load() - before, 1u64, "a stale remove does not");
    match t.take(b) {
      case let Some(m) {
        expectUInt(deaths.load() - before, 1u64, "take does not finalize");
      }
      case is None[Mortal] {expect(false, "take gives Some");}
    }
    expectUInt(deaths.load() - before, 2u64, "the value taken dies with its new owner");
    t.retire(c);
    expectUInt(deaths.load() - before, 2u64, "retire does not finalize");
    t.free(c);
    expectUInt(deaths.load() - before, 3u64, "free does");
    let e = t.add(Mortal(5i64));
    let f = t.add(Mortal(6i64));
    t.retire(f);
    // growth moves the entries without finalizing them
    var i = 0i64;
    while i < 20i64 {t.add(Mortal(100i64 + i)); i = i + 1i64;}
    expectUInt(deaths.load() - before, 3u64, "the block growing finalizes nothing");
  }
  // d, e, 20 more live and f retired when the pool died: 23 more
  expectUInt(deaths.load() - before, 26u64, "the pool's death finalizes the live and the retired");
}

fn misc() {
  var t = GenPool[Pt]();
  let a = t.add(Pt(1i64, 2i64));
  expectUInt(u64.from(t.bound()), 1u64, "one cell used");
  expect(t.handleAt(0u32) == a, "handleAt gives the handle");
  expect(t.handleAt(1u32).isNone(), "handleAt: none past the cells used");
  expect(t.slotAt(0u32) == a, "slotAt gives the handle");
  expect(t.slotAt(1u32).isNone(), "none past the cells used");
  match t.borrowMut(a) {
    case let Some(p) {p.x = 10i64;}
    else {expect(false, "borrowMut");}
  }
  match t.borrowAt(0u32) {
    case let Some(p) {expectInt(p.x, 10i64, "borrowAt sees the write");}
    else {expect(false, "borrowAt");}
  }
  expect(t.remove(a), "removed");
  expect(t.handleAt(0u32).isNone(), "handleAt: none for a free cell");
}

fn main() i32 {
  stale();
  growth();
  made();
  wrap();
  thrash();
  walk();
  finalizers();
  misc();
  done()
}
