// A Handle is a Dict key: both the cell and the generation count.
mod handlekey;

import stdio use *;
import collections use Dict;
import pools use *;

fn main() {
  var p = GenPool[u64]();
  let a = p.add(10u64);
  let b = p.add(20u64);
  var d = Dict[Handle, u64]();
  d.insert(a, 1u64);
  d.insert(b, 2u64);
  match d.get(&a) { case let Some(v) { print <- "a ", *v, "\n"; } else { print <- "a miss\n"; } }
  match d.get(&b) { case let Some(v) { print <- "b ", *v, "\n"; } else { print <- "b miss\n"; } }
  // a's cell is reused: same index, newer generation
  p.remove(a);
  let c = p.add(30u64);
  print <- "same cell ", c.index == a.index, " newer ", c.gen != a.gen, "\n";
  match d.get(&c) { case let Some(v) { print <- "c ", *v, "\n"; } else { print <- "c miss\n"; } }
  match d.get(&a) { case let Some(v) { print <- "stale ", *v, "\n"; } else { print <- "stale miss\n"; } }
  d.remove(&a);
  match d.get(&a) { case let Some(v) { print <- "a ", *v, "\n"; } else { print <- "a gone\n"; } }
  match d.get(&b) { case let Some(v) { print <- "b ", *v, "\n"; } else { print <- "b miss\n"; } }
}
