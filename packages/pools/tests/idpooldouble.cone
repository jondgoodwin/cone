// Freeing an id twice is a program error, and a panic, after writing out what was
// printed before it: this test's .out is the line printed before the second free,
// its .exit a panic's, and its .err the panic's line, naming the line of that call.

mod idpooldouble;

import stdio use *;
import pools use *;

fn main() i32 {
  var p = IdPool.make();
  p.alloc();
  p.alloc();
  p.free(0u32);
  printStr("freeing 0 again\n");
  p.free(0u32);
  printStr("not reached\n");
  0i32
}
