// The render package's Image, checked with the testing package. Only a
// failure prints, so images.out holds the summary alone. Nothing here needs a
// GPU (tests/offscreen.cone hands an image to one).
//
// The BMP files are built byte by byte: a 14-byte file header ('BM', the
// file's size, where the pixels start), a 40-byte information header (its
// size, width, height, 1 plane, bits a pixel, compression, ...), and rows of
// pixels, blue before green before red, each row padded to four bytes, the
// bottom row first unless the height is negative.
//
// - 2 by 2 at 24 bits: rows of 6 bytes padded to 8. Bottom row blue then
//   green, top row red then white; decoded as RGB from the bottom up, so the
//   pixel (0, 0) is blue (0, 0, 255), (1, 0) green, (0, 1) red (255, 0, 0),
//   (1, 1) white. The same stored top-down (height -2, top row first) decodes
//   the same. Written to a file and loaded, the same again.
// - 3 by 1 at 24 bits: 9 bytes padded to 12, pixels stored (1, 2, 3),
//   (4, 5, 6), (7, 8, 9) as blue, green, red, so decoded (3, 2, 1), ...
// - 1 by 1 at 32 bits, stored 10, 20, 30, 40: with no masks the fourth byte is
//   unused and the pixel is (30, 20, 10, 255); with the usual masks (red
//   0x00FF0000, green, blue, alpha 0xFF000000) in a 56-byte header it is
//   (30, 20, 10, 40).
// - Not a BMP, too short, 8 bits a pixel, run-length compressed, rows cut
//   short, no width: each an empty image.
// - A checkerboard 4 by 2 of 2 by 1 squares is squares 2 pixels on a side:
//   (0, 0) and (1, 1) the first color, red (255, 0, 0); (2, 0) and (3, 1) the
//   second, (0, 0.5, 1) as (0, 128, 255), 0.5 rounding up from 127.5.
// - Written ('toBmp'): the 2 by 2 is 54 bytes of headers and two rows of 8,
//   70 bytes, 'BM', its size, the pixels at 54, 2 by 2 with a positive
//   height (bottom row first), 24 bits; its first pixel, blue, stored blue
//   byte first; and it reads back as it was, from bytes and from a file. A 3
//   by 1 checker of three squares (red, blue, red) is 54 + 12 bytes, its
//   middle pixel blue.

mod images;

import testing use *;
import libc;
import geomath use *;
import collections use *;
import render use *;

fn push16(b &mut List[u8], v i32) {
  b.push(u8.from(v & 255));
  b.push(u8.from((v >> 8) & 255));
}

fn push32(b &mut List[u8], v i32) {
  push16(b, v & 65535);
  push16(b, (v >> 16) & 65535);
}

// The two headers of a BMP whose pixels are 'size' bytes, the information
// header 'infoSize' bytes (40, or 56 with masks), and then its masks
fn header(b &mut List[u8], width i32, height i32, bpp i32, compression i32, infoSize i32, size i32) {
  b.push('B');
  b.push('M');
  push32(b, 14 + infoSize + size);
  push32(b, 0);
  push32(b, 14 + infoSize);
  push32(b, infoSize);
  push32(b, width);
  push32(b, height);
  push16(b, 1);
  push16(b, bpp);
  push32(b, compression);
  push32(b, size);
  push32(b, 0);
  push32(b, 0);
  push32(b, 0);
  push32(b, 0);
  if infoSize == 56 {
    push32(b, 0x00FF0000);
    push32(b, 0x0000FF00);
    push32(b, 0x000000FF);
    push32(b, 0xFF000000u32 as i32);
  }
}

fn pixel(b &mut List[u8], blue i32, green i32, red i32) {
  b.push(u8.from(blue));
  b.push(u8.from(green));
  b.push(u8.from(red));
}

// A row's two bytes of padding
fn pad2(b &mut List[u8]) {
  b.push(0u8);
  b.push(0u8);
}

fn twoByTwo(topDown bool) List[u8] {
  mut b = List[u8].empty();
  header(&mut b, 2, if topDown {-2;} else {2;}, 24, 0, 40, 16);
  if topDown {
    pixel(&mut b, 0, 0, 255);
    pixel(&mut b, 255, 255, 255);
    pad2(&mut b);
  }
  pixel(&mut b, 255, 0, 0);
  pixel(&mut b, 0, 255, 0);
  pad2(&mut b);
  if !topDown {
    pixel(&mut b, 0, 0, 255);
    pixel(&mut b, 255, 255, 255);
    pad2(&mut b);
  }
  b;
}

fn rgb(img &Image, x i32, y i32, r i64, g i64, bl i64, label &Array[u8]) {
  expectInt(i64.from(img.at(x, y, 0)), r, label);
  expectInt(i64.from(img.at(x, y, 1)), g, label);
  expectInt(i64.from(img.at(x, y, 2)), bl, label);
}

fn checkTwoByTwo(img &Image, how &Array[u8]) {
  expectInt(i64.from(img.width), 2, how);
  expectInt(i64.from(img.height), 2, how);
  expectInt(i64.from(img.channels), 3, how);
  expectInt(i64.from(img.pixels.len()), 12, how);
  rgb(img, 0, 0, 0, 0, 255, how);
  rgb(img, 1, 0, 0, 255, 0, how);
  rgb(img, 0, 1, 255, 0, 0, how);
  rgb(img, 1, 1, 255, 255, 255, how);
}

fn decoding() {
  imm up = twoByTwo(false);
  imm a = Image.fromBmp(up.view());
  checkTwoByTwo(&a, "2x2 bottom-up");
  imm down = twoByTwo(true);
  imm b = Image.fromBmp(down.view());
  checkTwoByTwo(&b, "2x2 top-down");

  mut odd = List[u8].empty();
  header(&mut odd, 3, 1, 24, 0, 40, 12);
  pixel(&mut odd, 1, 2, 3);
  pixel(&mut odd, 4, 5, 6);
  pixel(&mut odd, 7, 8, 9);
  odd.push(0u8);
  odd.push(0u8);
  odd.push(0u8);
  imm c = Image.fromBmp(odd.view());
  expectInt(i64.from(c.width), 3, "3x1 width");
  rgb(&c, 0, 0, 3, 2, 1, "3x1 first pixel");
  rgb(&c, 2, 0, 9, 8, 7, "3x1 last pixel");

  mut plain = List[u8].empty();
  header(&mut plain, 1, 1, 32, 0, 40, 4);
  plain.push(10u8);
  plain.push(20u8);
  plain.push(30u8);
  plain.push(40u8);
  imm d = Image.fromBmp(plain.view());
  expectInt(i64.from(d.channels), 4, "32-bit channels");
  rgb(&d, 0, 0, 30, 20, 10, "32-bit color");
  expectInt(i64.from(d.at(0, 0, 3)), 255, "32-bit without masks is opaque");

  mut masked = List[u8].empty();
  header(&mut masked, 1, 1, 32, 3, 56, 4);
  masked.push(10u8);
  masked.push(20u8);
  masked.push(30u8);
  masked.push(40u8);
  imm e = Image.fromBmp(masked.view());
  rgb(&e, 0, 0, 30, 20, 10, "masked color");
  expectInt(i64.from(e.at(0, 0, 3)), 40, "masked alpha");
}

fn refusals() {
  mut notBmp = twoByTwo(false);
  notBmp.set(1usize, 'X');
  imm a = Image.fromBmp(notBmp.view());
  expect(a.isEmpty(), "not a BMP");
  imm short = twoByTwo(false);
  imm sv = short.view();
  imm b = Image.fromBmp(&sv[..40]);
  expect(b.isEmpty(), "too short for its headers");
  imm cut = twoByTwo(false);
  imm cv = cut.view();
  imm c = Image.fromBmp(&cv[..62]);
  expect(c.isEmpty(), "rows cut short");

  mut eight = List[u8].empty();
  header(&mut eight, 2, 2, 8, 0, 40, 8);
  mut i = 0;
  while i < 8 { eight.push(0u8); i = i + 1; }
  imm d = Image.fromBmp(eight.view());
  expect(d.isEmpty(), "8 bits a pixel");

  mut rle = twoByTwo(false);
  rle.set(30usize, 1u8);
  imm e = Image.fromBmp(rle.view());
  expect(e.isEmpty(), "compressed");

  mut narrow = twoByTwo(false);
  narrow.set(18usize, 0u8);
  imm f = Image.fromBmp(narrow.view());
  expect(f.isEmpty(), "no width");

  imm g = Image.empty();
  expect(g.isEmpty(), "the empty image");
}

fn files() {
  imm bytes = twoByTwo(false);
  imm v = bytes.view();
  imm f = libc.fopen("two.bmp", "wb");
  requireBool(!f, false, "a file to write");
  libc.fwrite(v as *u8, 1usize, v.len, f);
  libc.fclose(f);
  imm img = Image.load("two.bmp");
  checkTwoByTwo(&img, "2x2 from a file");
  libc.remove("two.bmp");
  imm missing = Image.load("missing.bmp");
  expect(missing.isEmpty(), "a file that is not there");
}

fn checker() {
  imm img = Image.checker(4, 2, 2, 1, new Color(1., 0., 0., 1.), new Color(0., 0.5, 1., 1.));
  expectInt(i64.from(img.pixels.len()), 24, "checker bytes");
  rgb(&img, 0, 0, 255, 0, 0, "checker (0, 0)");
  rgb(&img, 1, 1, 255, 0, 0, "checker (1, 1)");
  rgb(&img, 2, 0, 0, 128, 255, "checker (2, 0)");
  rgb(&img, 3, 1, 0, 128, 255, "checker (3, 1)");
}

fn le32(b &List[u8], at usize) i64 {
  i64.from(*b[at]) + i64.from(*b[at + 1usize]) * 256 + i64.from(*b[at + 2usize]) * 65536 + i64.from(*b[at + 3usize]) * 16777216;
}

fn writing() {
  imm up = twoByTwo(false);
  imm a = Image.fromBmp(up.view());
  imm bytes = a.toBmp();
  expectInt(i64.from(bytes.len()), 70, "2x2 written: 54 bytes of headers, 2 rows of 8");
  expectInt(i64.from(*bytes[0usize]), 66, "'B'");
  expectInt(i64.from(*bytes[1usize]), 77, "'M'");
  expectInt(le32(&bytes, 2usize), 70, "the file's size");
  expectInt(le32(&bytes, 10usize), 54, "where the pixels start");
  expectInt(le32(&bytes, 18usize), 2, "the width");
  expectInt(le32(&bytes, 22usize), 2, "the height, positive: bottom row first");
  expectInt(i64.from(*bytes[28usize]), 24, "24 bits a pixel");
  expectInt(i64.from(*bytes[54usize]), 255, "the first pixel stored, blue: its blue byte first");
  expectInt(i64.from(*bytes[56usize]), 0, "and its red byte last");
  imm back = Image.fromBmp(bytes.view());
  checkTwoByTwo(&back, "2x2 written and read back");

  imm odd = Image.checker(3, 1, 3, 1, new Color(1., 0., 0., 1.), new Color(0., 0., 1., 1.));
  imm oddBytes = odd.toBmp();
  expectInt(i64.from(oddBytes.len()), 66, "3x1 written: a row of 9 bytes padded to 12");
  imm oddBack = Image.fromBmp(oddBytes.view());
  rgb(&oddBack, 1, 0, 0, 0, 255, "3x1 read back: the middle pixel, blue");

  expectBool(a.save("written.bmp"), true, "saved to a file");
  imm loaded = Image.load("written.bmp");
  checkTwoByTwo(&loaded, "2x2 saved and loaded");
  libc.remove("written.bmp");
}

// Pixels read back from a GPU: 2 by 2, 4 bytes each, rows from the top:
// (1, 2, 3, 4) (5, 6, 7, 8) above (9, 10, 11, 12) (13, 14, 15, 16). An Image
// is bottom row first, so its (0, 0) is the texels' bottom left, (9, 10, 11),
// and its (1, 1) their top right, (5, 6, 7); read as BGRA, (11, 10, 9).
imm TEXELS Array[u8, 16] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8];

fn texels() {
  imm img = Image.fromTexels(&TEXELS as *u8, 2, 2, false);
  expectInt(i64.from(img.channels), 3, "texels: RGB, the fourth byte dropped");
  rgb(&img, 0, 0, 9, 10, 11, "texels: the bottom left");
  rgb(&img, 1, 1, 5, 6, 7, "texels: the top right");
  rgb(&img, 0, 1, 1, 2, 3, "texels: the top left");
  imm swapped = Image.fromTexels(&TEXELS as *u8, 2, 2, true);
  rgb(&swapped, 0, 0, 11, 10, 9, "texels as BGRA: the bottom left");
}

fn main() i32 {
  decoding();
  refusals();
  files();
  checker();
  writing();
  texels();
  done();
}
