// The render package's scene (visibility.cone) drawn on a real GPU with no
// window: pictures of 256 x 256 into an rgba8unorm target, read back and
// compared with the pictures a DrawList draws. It needs a GPU driver with
// Vulkan 1.3 and SDL3.dll; with the Vulkan SDK, validation and synchronization
// validation are on, and must say nothing. GPU_POWER_PREFERENCE=low-power runs
// it on the integrated GPU. Only a failure prints (and measurements, marked
// "measured").
//
//  1. Everything off: a scene of 160 things (three meshes, three materials,
//     a third of them out of view) with VisibilitySettings.off() draws the
//     same bytes as a DrawList of the same things in the same order, lit and
//     physically based.
//  2. Culling on: the same picture, byte for byte, from fewer instances.
//  3. Instancing: 100 cubes of one mesh and material are one draw; the same
//     100 with a material each (100 batches) draw the same bytes, lit and
//     physically based.
//  4. A thing moved: the scene after 'moveSceneItem' equals a DrawList with
//     the thing at its new place; moved out of view, nothing of it is drawn.
//  5. Layers: a scene item on layer 2 is not in a view whose mask is 1.
//  6. Shadows: a tall box beside the view, out of it, casts into it. The
//     scene (culling on, casters gathered by each cascade's volume) draws the
//     bytes the DrawList draws; with the casters taken from the view's own
//     (VisibilitySettings.shadowCulling off) the shadow is missing: the
//     picture differs. Four cascades and the low tier; a local light's
//     shadow the same.
//  7. Levels: two quads of one footprint, shaded differently, as levels 0
//     and 1; far enough away it is the second; a switch is a cross-fade
//     over five frames in which the share of the footprint the old one holds
//     falls 1 - t and the new one's rises t (t = 0.2, 0.4 ... within 0.03) and
//     none of it is left undrawn.
//  8. A range: the same quad with a range to 100 and a margin of 40 seen
//     from 80 draws half of its footprint, from 50 all of it, from 101 none.
//  9. Casters have a level: a shadow pass uses the coarser level (the bias).

mod visibilitygpu;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;

const SIDE = 256u32;
const SIDEZ = 256usize;
const BYTES = 262144usize;

struct Rng {
  s u64;
  fn next(self &mut) u64 {
    s = s ^ (s >> 12u64);
    s = s ^ (s << 25u64);
    s = s ^ (s >> 27u64);
    s * 2685821657736338717u64
  }
  fn unit(self &mut) f32 { f32.from(next() >> 40u64) / 16777216. }
  fn range(self &mut, lo f32, hi f32) f32 { lo + (hi - lo) * unit() }
}

fn absf(x f32) f32 { if x < 0. { 0. - x } else { x } }

fn near(a f32, b f32, within f32) bool { absf(a - b) <= within }

fn px(p *u8, x usize, y usize) f32 { f32.from(*(p + (y * SIDEZ + x) * 4usize)) }

fn drawFrame(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    camera &Camera, light &Light, list &DrawList) {
  var encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, color, depth, camera, light, list);
  encoder.copyTextureToBuffer(color, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn snapshot(p *u8) List[u8] {
  var out = List[u8].withCapacity(BYTES);
  var i = 0usize;
  while i < BYTES {
    out.push(*(p + i));
    i = i + 1usize;
  }
  out
}

// How many bytes of two pictures differ, and by how much at most
fn differing(a &List[u8], b &List[u8], worst &mut f32) u32 {
  var n = 0u32;
  *worst = 0.;
  var i = 0usize;
  while i < BYTES {
    let d = absf(f32.from(*a[i]) - f32.from(*b[i]));
    if d > 0. { n = n + 1u32; }
    if d > *worst { *worst = d; }
    i = i + 1usize;
  }
  n
}

// A picture of a draw list: drawn, read back, copied
fn pictureOf(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    camera &Camera, light &Light, list &DrawList) List[u8] {
  drawFrame(renderer, device, color, depth, readback, camera, light, list);
  snapshot(readback.mappedRange())
}

fn sun(elevation f32, azimuth f32, intensity f32, ambient f32) Light {
  let c = cos(elevation);
  let toSun = new Vec3(c * cos(azimuth), sin(elevation), c * sin(azimuth));
  Light.directional(new Vec3(0., 0., 0.) - toSun, Color.gray(intensity), Color.gray(ambient))
}

// ---- 1 to 5: a field of things ----

struct Field {
  cube MeshHandle;
  ball MeshHandle;
  slab MeshHandle;
  lit List[MaterialHandle];
  pbr List[MaterialHandle];
}

fn makeField(renderer &mut Renderer, device &mut Device) Field {
  let cube = renderer.addMesh(device, &Mesh.cube(1.));
  let ball = renderer.addMesh(device, &Mesh.sphere(1., 24));
  let slab = renderer.addMesh(device, &Mesh.plane(1, 1.));
  var lit = List[MaterialHandle].empty();
  var pbr = List[MaterialHandle].empty();
  var k = 0;
  while k < 3 {
    let c = new Color(0.9 - 0.3 * f32.from(k), 0.3 + 0.25 * f32.from(k), 0.4, 1.);
    let m = Material.plain(c);
    lit.push(renderer.addMaterial(device, &m));
    let pm = PbrMaterial.standard(c, 0.2 * f32.from(k), 0.6);
    pbr.push(renderer.addPbrMaterial(device, &pm));
    k = k + 1;
  }
  new Field(cube, ball, slab, lit, pbr)
}

struct Thing {
  mesh MeshHandle;
  material u32;
  model Mat4;
}

fn makeThings(field &Field, count i32) List[Thing] {
  var rng = new Rng(88172645463325252u64);
  var things = List[Thing].empty();
  var i = 0;
  while i < count {
    let kind = i % 3;
    let mesh = if kind == 0 { field.cube } elif kind == 1 { field.ball } else { field.cube };
    let p = new Vec3(rng.range(-30., 30.), rng.range(0.5, 3.), rng.range(-30., 8.));
    let s = rng.range(0.4, 1.6);
    let q = Quat.angleAxis(rng.range(0., 6.28), new Vec3(0., 1., 0.));
    things.push(new Thing(mesh, u32.from(i % 3), Mat4.fromTrs(p, q, new Vec3(s, s * rng.range(0.6, 1.8), s))));
    i = i + 1;
  }
  things
}

fn viewCamera() Camera {
  var camera = Camera.make();
  camera.fov = radians(50.);
  camera.near = 0.3;
  camera.far = 120.;
  camera.lookAt(new Vec3(0., 6., 22.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.05, 0.05, 0.1, 1.);
  camera
}

fn listOf(things &List[Thing], field &Field, pbr bool) DrawList {
  var list = DrawList.empty();
  list.add(field.slab, if pbr { *field.pbr[0usize] } else { *field.lit[0usize] },
    Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(100., 1., 100.)));
  var i = 0usize;
  while i < things.len() {
    let t = things[i];
    list.add(t.mesh, if pbr { *field.pbr[usize.from(t.material)] } else { *field.lit[usize.from(t.material)] }, t.model);
    i = i + 1usize;
  }
  list
}

fn fillScene(renderer &mut Renderer, things &List[Thing], field &Field, pbr bool) List[SceneHandle] {
  var handles = List[SceneHandle].empty();
  handles.push(renderer.addSceneItem(field.slab, if pbr { *field.pbr[0usize] } else { *field.lit[0usize] },
    Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(100., 1., 100.)), new Color(1., 1., 1., 1.)));
  var i = 0usize;
  while i < things.len() {
    let t = things[i];
    handles.push(renderer.addSceneItem(t.mesh, if pbr { *field.pbr[usize.from(t.material)] } else { *field.lit[usize.from(t.material)] },
      t.model, new Color(1., 1., 1., 1.)));
    i = i + 1usize;
  }
  handles
}

fn fieldChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer, pbr bool,
    name &Array[u8]) {
  let field = makeField(renderer, device);
  let things = makeThings(&field, 160);
  let camera = viewCamera();
  let light = sun(radians(50.), radians(30.), 3., 0.2);
  let list = listOf(&things, &field, pbr);
  let empty = DrawList.empty();
  let want = pictureOf(renderer, device, color, depth, readback, &camera, &light, &list);
  let wantInstances = renderer.instancesDrawn;
  var worst = 0.f;

  // 1. Everything off
  renderer.vis.settings = VisibilitySettings.off();
  let handles = fillScene(renderer, &things, &field, pbr);
  let off = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expectUInt(u64.from(differing(&want, &off, &mut worst)), 0u64, name);
  expectUInt(u64.from(renderer.instancesDrawn), u64.from(wantInstances), "everything off draws all the instances");

  // 2. Culling on, nothing else (levels and ranges have nothing to do)
  renderer.vis.settings = new VisibilitySettings();
  let culled = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  let n = differing(&want, &culled, &mut worst);
  eprint <- "measured "; eprintStr(name as &str); eprint <- ": culling draws "; eprint <- u64.from(renderer.instancesDrawn);
  eprint <- " of "; eprint <- u64.from(wantInstances); eprint <- " instances, "; eprint <- u64.from(n); eprint <- " bytes differ\n";
  expectUInt(u64.from(n), 0u64, name);
  expect(renderer.instancesDrawn < wantInstances && renderer.instancesDrawn > 20u32, name);
  expectUInt(u64.from(renderer.vis.stats.items), 161u64, "the scene's items");

  // The scene beside a list: both draw
  let half = DrawList.empty();
  var mixed = DrawList.empty();
  mixed.add(field.cube, *field.lit[2usize], Mat4.fromTranslation(new Vec3(0., 1., 15.)));
  let withBoth = pictureOf(renderer, device, color, depth, readback, &camera, &light, &mixed);
  expect(differing(&culled, &withBoth, &mut worst) > 100u32, "a list's item draws beside the scene's");

  // 4. A thing moved
  let k = 7usize;
  var moved = things;
  let old = *moved[k];
  let placed = Mat4.fromTrs(new Vec3(1., 1., 12.), Quat.identity(), new Vec3(1.5, 1.5, 1.5));
  renderer.moveSceneItem(*handles[k + 1usize], placed);
  moved.set(k, new Thing(old.mesh, old.material, placed));
  let movedList = listOf(&moved, &field, pbr);
  let wantMoved = pictureOf(renderer, device, color, depth, readback, &camera, &light, &movedList);
  // (the scene still holds the old place until the next draw: first the list's, then the scene's)
  let sceneMoved = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expectUInt(u64.from(differing(&wantMoved, &sceneMoved, &mut worst)), 0u64, "a moved item draws where it was moved");
  expect(differing(&culled, &sceneMoved, &mut worst) > 50u32, "and the picture did change");
  renderer.moveSceneItem(*handles[k + 1usize], Mat4.fromTranslation(new Vec3(0., 1., 500.)));
  let gone = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  moved.set(k, new Thing(old.mesh, old.material, Mat4.fromTranslation(new Vec3(0., 1., 500.))));
  let wantGone = pictureOf(renderer, device, color, depth, readback, &camera, &light, &listOf(&moved, &field, pbr));
  expectUInt(u64.from(differing(&wantGone, &gone, &mut worst)), 0u64, "moved out of view: as if drawn there");

  // 5. Layers: put item 5 on layer 2, and draw with a mask of 1
  renderer.clearScene();
  expectUInt(u64.from(renderer.vis.count()), 0u64, "cleared");
}

// ---- 3. Instancing ----

fn instancingChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    pbr bool, name &Array[u8]) {
  let cube = renderer.addMesh(device, &Mesh.cube(1.));
  let c = new Color(0.8, 0.5, 0.2, 1.);
  var materials = List[MaterialHandle].empty();
  var i = 0;
  while i < 100 {
    if pbr {
      let pm = PbrMaterial.standard(c, 0.3, 0.5);
      materials.push(renderer.addPbrMaterial(device, &pm));
    } else {
      let m = Material.plain(c);
      materials.push(renderer.addMaterial(device, &m));
    }
    i = i + 1;
  }
  var together = DrawList.empty();
  var apart = DrawList.empty();
  i = 0;
  while i < 100 {
    let p = new Vec3(f32.from(i % 10) * 1.6 - 7.2, f32.from(i / 10) * 1.2 - 5.4, f32.from((i * 7) % 5) * -0.8);
    let m = Mat4.fromTrs(p, Quat.angleAxis(f32.from(i) * 0.37, new Vec3(0.3, 1., 0.2).normalize()), new Vec3(0.55, 0.45, 0.5));
    together.add(cube, *materials[0usize], m);
    apart.add(cube, *materials[usize.from(u32.from(i))], m);
    i = i + 1;
  }
  var camera = Camera.make();
  camera.fov = radians(45.);
  camera.lookAt(new Vec3(0., 0., 16.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.05, 0.05, 0.1, 1.);
  let light = sun(radians(50.), radians(30.), 3., 0.2);
  let one = pictureOf(renderer, device, color, depth, readback, &camera, &light, &together);
  expectUInt(u64.from(renderer.drawCalls), 1u64, name);
  expectUInt(u64.from(renderer.instancesDrawn), 100u64, "one batch of 100 instances");
  let many = pictureOf(renderer, device, color, depth, readback, &camera, &light, &apart);
  expectUInt(u64.from(renderer.drawCalls), 100u64, "100 materials: 100 batches");
  var worst = 0.f;
  let n = differing(&one, &many, &mut worst);
  expectUInt(u64.from(n), 0u64, name);
  // And as a scene: the same one batch, the same bytes
  var h = List[SceneHandle].empty();
  i = 0;
  while i < 100 {
    h.push(renderer.addSceneItem(cube, *materials[0usize], together.items[usize.from(u32.from(i))].model, new Color(1., 1., 1., 1.)));
    i = i + 1;
  }
  let empty = DrawList.empty();
  let viaScene = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expectUInt(u64.from(renderer.drawCalls), 1u64, "a scene's 100 are one draw too");
  expectUInt(u64.from(differing(&one, &viaScene, &mut worst)), 0u64, "and the same bytes");
  renderer.clearScene();
}

// ---- 6. Shadows from beside the view ----

fn topDown() Camera {
  var camera = Camera.make();
  camera.fov = radians(40.);
  camera.near = 0.1;
  camera.far = 100.;
  camera.lookAt(new Vec3(0., 12., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., -1.));
  camera.background = new Color(0., 0., 0., 1.);
  camera
}

fn dark() Light {
  Light.directional(new Vec3(0., -1., 0.), Color.gray(0.), Color.gray(0.))
}

fn shadowChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  let ground = renderer.addMesh(device, &Mesh.plane(1, 1.));
  let cube = renderer.addMesh(device, &Mesh.cube(1.));
  let m = Material.plain(new Color(0.5, 0.5, 0.5, 1.));
  let lit = renderer.addMaterial(device, &m);
  let pm = PbrMaterial.standard(new Color(0.5, 0.5, 0.5, 1.), 0., 1.);
  let pbr = renderer.addPbrMaterial(device, &pm);
  let camera = topDown();
  let empty = DrawList.empty();
  var worst = 0.f;
  var pass = 0;
  while pass < 2 {
    let material = if pass == 0 { lit } else { pbr };
    let sunLight = sun(radians(45.), 0., 2.5132741, 0.1);
    // The ground and, beside the view at x = 7, a box 8 high: its top edge's shadow lands at x = 6 - 8 = -2
    var list = DrawList.empty();
    list.add(ground, material, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(40., 1., 40.)));
    list.add(cube, material, Mat4.fromTrs(new Vec3(7., 4., 0.), Quat.identity(), new Vec3(1., 4., 1.)));
    // and some small things in view and out of it, to be batched
    var extra = 0;
    while extra < 12 {
      list.add(cube, material, Mat4.fromTrs(new Vec3(f32.from(extra) * 3. - 18., 0.5, f32.from(extra % 4) * 3. - 6.), Quat.identity(), new Vec3(0.4, 0.5, 0.4)));
      extra = extra + 1;
    }
    let tiers = [ShadowSettings.high(), ShadowSettings.low()];
    var tier = 0usize;
    while tier < 2usize {
      var s = tiers[tier];
      s.distance = 40.;
      renderer.setShadows(device, &s);
      renderer.clearScene();
      let wantReal = pictureOf(renderer, device, color, depth, readback, &camera, &sunLight, &list);
      var i = 0usize;
      while i < list.items.len() {
        let it = list.items[i];
        renderer.addSceneItem(it.mesh, it.material, it.model, new Color(1., 1., 1., 1.));
        i = i + 1usize;
      }
      renderer.vis.settings = new VisibilitySettings();
      let got = pictureOf(renderer, device, color, depth, readback, &camera, &sunLight, &empty);
      expectUInt(u64.from(differing(&wantReal, &got, &mut worst)), 0u64, "a scene's shadows equal a list's, casters from beside the view");
      expectUInt(u64.from(renderer.vis.stats.casterSets), u64.from(renderer.shadow.cascades.count), "each cascade gathered its own casters");
      expect(renderer.vis.stats.casters > 0u32, "and found some");
      renderer.vis.settings.shadowCulling = false;
      let lost = pictureOf(renderer, device, color, depth, readback, &camera, &sunLight, &empty);
      let n = differing(&wantReal, &lost, &mut worst);
      eprint <- "measured shadows from beside the view, casters from the view's own set: "; eprint <- u64.from(n); eprint <- " bytes differ\n";
      expect(n > 500u32, "casters taken from what the view sees lose a shadow from beside it");
      tier = tier + 1usize;
    }
    renderer.clearScene();
    pass = pass + 1;
  }
  renderer.disableShadows(device);
}

fn localShadowChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer, pointLight bool) {
  let ground = renderer.addMesh(device, &Mesh.plane(1, 1.));
  let cube = renderer.addMesh(device, &Mesh.cube(1.));
  let m = Material.plain(new Color(0.5, 0.5, 0.5, 1.));
  let lit = renderer.addMaterial(device, &m);
  let camera = topDown();
  let empty = DrawList.empty();
  renderer.environmentStrength = 0.;
  renderer.lights.clear();
  let at = new Vec3(12., 12., 0.);
  let lamp = if pointLight {
    renderer.lights.addPoint(at, Color.gray(1.), 3000., 40.)
  } else {
    renderer.lights.addSpot(at, new Vec3(-12., -12., 0.), Color.gray(1.), 3000., 40., radians(40.), radians(50.))
  };
  renderer.lights.setCastsShadow(lamp, true);
  let settings = LightShadowSettings.medium();
  renderer.setLightShadows(device, &settings);
  var list = DrawList.empty();
  list.add(ground, lit, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(40., 1., 40.)));
  list.add(cube, lit, Mat4.fromTrs(new Vec3(7., 4., 0.), Quat.identity(), new Vec3(1., 4., 1.)));
  var i = 0usize;
  while i < list.items.len() {
    let it = list.items[i];
    renderer.addSceneItem(it.mesh, it.material, it.model, new Color(1., 1., 1., 1.));
    i = i + 1usize;
  }
  renderer.vis.settings = VisibilitySettings.off();
  let light = dark();
  let want = pictureOf(renderer, device, color, depth, readback, &camera, &light, &list);
  let viaOff = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  var worst = 0.f;
  expectUInt(u64.from(differing(&want, &viaOff, &mut worst)), 0u64, "a light's shadows, the scene with everything off");
  expect(renderer.lights.isShadowed(lamp), "the light has a shadow view");
  renderer.vis.settings = new VisibilitySettings();
  let got = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expectUInt(u64.from(differing(&want, &got, &mut worst)), 0u64, "a light's shadows from a box beside the view, casters gathered by the face's volume");
  expect(renderer.vis.stats.casterSets >= 1u32, "the light's faces gathered their own casters");
  renderer.vis.settings.shadowCulling = false;
  let lost = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expect(differing(&want, &lost, &mut worst) > 300u32, "from the view's own set the shadow is lost");
  renderer.clearScene();
  renderer.lights.clear();
  let off = LightShadowSettings.off();
  renderer.setLightShadows(device, &off);
  renderer.environmentStrength = 1.;
}

// ---- 7 and 8. Levels and ranges, by what share of a footprint each draws ----

// A square 4 across in the plane z = 0 facing 'normal'
fn quad(normal Vec3) Mesh {
  var m = Mesh.empty();
  m.positions.push(new Vec3(-2., -2., 0.));
  m.positions.push(new Vec3(2., -2., 0.));
  m.positions.push(new Vec3(2., 2., 0.));
  m.positions.push(new Vec3(-2., 2., 0.));
  var k = 0;
  while k < 4 {
    m.normals.push(normal);
    m.uvs.push(new Vec2(0., 0.));
    k = k + 1;
  }
  m.indices.push(0u32); m.indices.push(1u32); m.indices.push(2u32);
  m.indices.push(0u32); m.indices.push(2u32); m.indices.push(3u32);
  m
}

fn faceCamera(distance f32) Camera {
  var camera = Camera.make();
  camera.fov = radians(40.);
  camera.near = 0.1;
  camera.far = 400.;
  camera.lookAt(new Vec3(0., 0., distance), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0., 0., 0., 1.);
  camera
}

fn frontLight() Light {
  Light.directional(new Vec3(0., 0., -1.), Color.gray(1.5), Color.gray(0.1))
}

// Of the pixels that 'a' and 'b' draw differently: how many 'p' draws as 'a',
// as 'b', and as neither
fn classify(a &List[u8], b &List[u8], p &List[u8], ofA &mut u32, ofB &mut u32, neither &mut u32) u32 {
  var total = 0u32;
  *ofA = 0u32;
  *ofB = 0u32;
  *neither = 0u32;
  var i = 0usize;
  while i < BYTES {
    var differs = false;
    var matchA = true;
    var matchB = true;
    var c = 0usize;
    while c < 3usize {
      if *a[i + c] != *b[i + c] { differs = true; }
      if *p[i + c] != *a[i + c] { matchA = false; }
      if *p[i + c] != *b[i + c] { matchB = false; }
      c = c + 1usize;
    }
    if differs {
      total = total + 1u32;
      if matchA { *ofA = *ofA + 1u32; } elif matchB { *ofB = *ofB + 1u32; } else { *neither = *neither + 1u32; }
    }
    i = i + 4usize;
  }
  total
}

fn levelChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  let meshA = renderer.addMesh(device, &quad(new Vec3(0., 0., 1.)));
  let meshB = renderer.addMesh(device, &quad(new Vec3(0.6, 0., 0.8)));
  let m = Material.plain(new Color(0.9, 0.9, 0.9, 1.));
  let lit = renderer.addMaterial(device, &m);
  let light = frontLight();
  let empty = DrawList.empty();
  let model = Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(1., 1., 1.));
  // The two levels alone, at the far distance
  var la = DrawList.empty();
  la.add(meshA, lit, model);
  var lb = DrawList.empty();
  lb.add(meshB, lit, model);
  let far = faceCamera(20.);
  let pictureA = pictureOf(renderer, device, color, depth, readback, &far, &light, &la);
  let pictureB = pictureOf(renderer, device, color, depth, readback, &far, &light, &lb);

  // The chain: A while at least 120 pixels, B under
  var chain = LodChain.empty(0.1);
  chain.add(meshA, 120.);
  chain.add(meshB, 0.);
  let h = renderer.addSceneItem(meshA, lit, model, new Color(1., 1., 1., 1.));
  renderer.setSceneLod(h, &chain);
  renderer.vis.settings = new VisibilitySettings();
  renderer.vis.settings.fadeSeconds = 0.5;
  renderer.vis.settings.timeStep = 0.1;
  // Near: level 0 alone, first sight (the quad is 4 across: radius 2.83, at 10 away about 199 pixels)
  let near10 = faceCamera(10.);
  drawFrame(renderer, device, color, depth, readback, &near10, &light, &empty);
  expectUInt(u64.from(renderer.instancesDrawn), 1u64, "near: one draw");
  // Far: a cross-fade
  var ofA = 0u32;
  var ofB = 0u32;
  var neither = 0u32;
  var worstShare = 0.;
  var k = 1;
  while k <= 5 {
    let picture = pictureOf(renderer, device, color, depth, readback, &far, &light, &empty);
    let total = classify(&pictureA, &pictureB, &picture, &mut ofA, &mut ofB, &mut neither);
    let t = f32.from(k) * 0.2;
    let shareA = f32.from(ofA) / f32.from(total);
    let shareB = f32.from(ofB) / f32.from(total);
    eprint <- "measured cross-fade frame "; eprint <- u64.from(u32.from(k)); eprint <- ": of "; eprint <- u64.from(total);
    eprint <- " pixels the old level draws "; eprint <- shareA; eprint <- " (want "; eprint <- (1. - t);
    eprint <- "), the new "; eprint <- shareB; eprint <- " (want "; eprint <- t; eprint <- "), "; eprint <- u64.from(neither); eprint <- " neither\n";
    expect(total > 3000u32, "the footprint is big enough to count");
    expectUInt(u64.from(neither), 0u64, "every pixel is drawn by one level or the other, as one of them draws it");
    expect(absf(shareA - (1. - t)) <= 0.03 && absf(shareB - t) <= 0.03, "the cross-fade's shares fall and rise by 0.2 a frame");
    if k == 5 { expectUInt(u64.from(ofB), u64.from(total), "after five frames the new level alone"); }
    expectUInt(u64.from(renderer.instancesDrawn), if k < 5 { 2u64 } else { 1u64 }, "two draws while fading, then one");
    k = k + 1;
  }
  // With cross-fade off, a switch is a pop
  renderer.vis.settings.crossFade = false;
  drawFrame(renderer, device, color, depth, readback, &near10, &light, &empty);
  let popped = pictureOf(renderer, device, color, depth, readback, &far, &light, &empty);
  let popTotal = classify(&pictureA, &pictureB, &popped, &mut ofA, &mut ofB, &mut neither);
  expectUInt(u64.from(ofB), u64.from(popTotal), "cross-fade off: the new level alone at once");
  renderer.clearScene();
}

fn rangeChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  let meshA = renderer.addMesh(device, &quad(new Vec3(0., 0., 1.)));
  let m = Material.plain(new Color(0.9, 0.9, 0.9, 1.));
  let lit = renderer.addMaterial(device, &m);
  let light = frontLight();
  let empty = DrawList.empty();
  let model = Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(5., 5., 5.));
  let h = renderer.addSceneItem(meshA, lit, model, new Color(1., 1., 1., 1.));
  renderer.setSceneRange(h, 0., 100., 40.);
  renderer.vis.settings = new VisibilitySettings();
  let bg = DrawList.empty();
  var ofFull = 0u32;
  var ofBg = 0u32;
  var neither = 0u32;
  var worst = 0.;
  var dists = [50.f, 80., 90., 101.];
  var wants = [1.f, 0.5, 0.25, 0.];
  var k = 0usize;
  while k < 4usize {
    let camera = faceCamera(dists[k]);
    renderer.vis.settings.ranges = false;
    let full = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
    renderer.vis.settings.ranges = true;
    let got = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
    // Against the picture with the quad and the picture of nothing (a blank)
    var blank = List[u8].empty();
    var i = 0usize;
    while i < BYTES {
      blank.push(if i % 4usize == 3usize { 255u8 } else { 0u8 });
      i = i + 1usize;
    }
    let total = classify(&full, &blank, &got, &mut ofFull, &mut ofBg, &mut neither);
    let share = f32.from(ofFull) / f32.from(total);
    eprint <- "measured a range's fade at "; eprint <- dists[k]; eprint <- " away: "; eprint <- share; eprint <- " of "; eprint <- u64.from(total);
    eprint <- " pixels drawn (want "; eprint <- wants[k]; eprint <- "), "; eprint <- u64.from(neither); eprint <- " neither\n";
    expectUInt(u64.from(neither), 0u64, "a faded pixel is the quad's or the background's");
    expect(absf(share - wants[k]) <= 0.04, "the share of the quad a range's fade draws");
    k = k + 1usize;
  }
  expectUInt(u64.from(renderer.vis.stats.rangeCulled), 1u64, "past the end: culled");
  renderer.clearScene();
}

// ---- 5. Layers ----

fn layerChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  let cube = renderer.addMesh(device, &Mesh.cube(1.));
  let m = Material.plain(new Color(0.9, 0.5, 0.2, 1.));
  let lit = renderer.addMaterial(device, &m);
  let a = renderer.addSceneItem(cube, lit, Mat4.fromTranslation(new Vec3(-3., 0., 0.)), new Color(1., 1., 1., 1.));
  let b = renderer.addSceneItem(cube, lit, Mat4.fromTranslation(new Vec3(3., 0., 0.)), new Color(1., 1., 1., 1.));
  renderer.setSceneLayers(a, 2u32);
  renderer.vis.settings = new VisibilitySettings();
  var view = RenderView.create(renderer, device, 64u32, 64u32);
  let camera = faceCamera(14.);
  let light = frontLight();
  view.layerMask = 1u32;
  view.render(renderer, device, &camera, &light, &DrawList.empty(), 1u32);
  expectUInt(u64.from(renderer.vis.stats.drawn), 1u64, "a view on layer 1 draws the one item on layer 1");
  expectUInt(u64.from(renderer.vis.stats.layerCulled), 1u64, "and not the one on layer 2");
  view.layerMask = 3u32;
  view.render(renderer, device, &camera, &light, &DrawList.empty(), 1u32);
  expectUInt(u64.from(renderer.vis.stats.drawn), 2u64, "on layers 1 and 2: both");
  expectUInt(u64.from(renderer.vis.layerMask), u64.from(LAYERS_ALL), "the layer mask is the view's only for its picture");
  device.endFrame();
  device.waitIdle();
  renderer.clearScene();
}

// ---- 10. Occlusion by the depth pyramid ----

fn boxesCamera(x f32, y f32) Camera {
  var camera = Camera.make();
  camera.fov = radians(50.);
  camera.near = 0.5;
  camera.far = 200.;
  camera.lookAt(new Vec3(x, y, 20.), new Vec3(0., 0., -5.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.05, 0.05, 0.1, 1.);
  camera
}

fn occlusionChecks(renderer &mut Renderer, device &mut Device, color &Texture, readback &Buffer, pbr bool) {
  // A depth buffer the pyramid may sample
  let depthDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_DEPTH32_FLOAT,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
  var depth = device.createTexture(&depthDesc);
  let cube = renderer.addMesh(device, &Mesh.cube(1.));
  let gray = new Color(0.7, 0.4, 0.2, 1.);
  let wallColor = new Color(0.3, 0.5, 0.7, 1.);
  var boxMaterial = MaterialHandle.none();
  var wallMaterial = MaterialHandle.none();
  if pbr {
    let a = PbrMaterial.standard(gray, 0., 0.6);
    let b = PbrMaterial.standard(wallColor, 0., 0.6);
    boxMaterial = renderer.addPbrMaterial(device, &a);
    wallMaterial = renderer.addPbrMaterial(device, &b);
  } else {
    let a = Material.plain(gray);
    let b = Material.plain(wallColor);
    boxMaterial = renderer.addMaterial(device, &a);
    wallMaterial = renderer.addMaterial(device, &b);
  }
  let light = sun(radians(50.), radians(30.), 3., 0.2);
  let empty = DrawList.empty();
  // The wall, 12 across and 12 high, at z = 0; behind it, 10 back, a box hidden by it (x = 0),
  // one that peeks round its edge (x from 8 to 10: the wall's edge is at 0.3 of the way
  // to the side and the box spans 0.267 to 0.333), one wholly beside it, and
  // a row of hidden ones; in front, one visible box
  let wall = renderer.addSceneItem(cube, wallMaterial, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(6., 6., 0.25)),
    new Color(1., 1., 1., 1.));
  renderer.setSceneOccludable(wall, false);
  let hidden = renderer.addSceneItem(cube, boxMaterial, Mat4.fromTranslation(new Vec3(0., 0., -10.)), new Color(1., 1., 1., 1.));
  let peeking = renderer.addSceneItem(cube, boxMaterial, Mat4.fromTranslation(new Vec3(9., 0., -10.)), new Color(1., 1., 1., 1.));
  let beside = renderer.addSceneItem(cube, boxMaterial, Mat4.fromTranslation(new Vec3(-14., 0., -10.)), new Color(1., 1., 1., 1.));
  let front = renderer.addSceneItem(cube, boxMaterial, Mat4.fromTranslation(new Vec3(0., -2., 10.)), new Color(1., 1., 1., 1.));
  var row = 0;
  while row < 5 {
    renderer.addSceneItem(cube, boxMaterial, Mat4.fromTranslation(new Vec3(f32.from(row) * 2. - 4., f32.from(row % 2) * 2. - 1., -20.)),
      new Color(1., 1., 1., 1.));
    row = row + 1;
  }
  expectUInt(u64.from(renderer.vis.count()), 10u64, "ten items");
  if renderer.hiz.len() > 0usize { renderer.hiz[0usize].valid = false; }
  var worst = 0.f;
  let cameraA = boxesCamera(0., 0.);
  let cameraB = boxesCamera(0., 30.);
  renderer.vis.settings = new VisibilitySettings();
  let offA = pictureOf(renderer, device, color, &depth, readback, &cameraA, &light, &empty);
  let offB = pictureOf(renderer, device, color, &depth, readback, &cameraB, &light, &empty);
  expect(differing(&offA, &offB, &mut worst) > 1000u32, "(the two cameras see different pictures)");
  renderer.vis.settings.occlusion = true;
  renderer.vis.settings.occlusionStats = true;

  // Frame 1: no pyramid yet: everything passes the first test
  let on1 = pictureOf(renderer, device, color, &depth, readback, &cameraA, &light, &empty);
  renderer.hiz[0usize].readStats();
  expectUInt(u64.from(renderer.hiz[0usize].candidateCount), 9u64, "nine candidates: every box but the wall");
  expectUInt(u64.from(renderer.hiz[0usize].passed0), 9u64, "the first frame has no pyramid: all nine pass the first test");
  expectUInt(u64.from(differing(&offA, &on1, &mut worst)), 0u64, "and draw the picture occlusion off draws");
  // Frame 2: the pyramid of frame 1 hides the box behind the wall and the row
  let on2 = pictureOf(renderer, device, color, &depth, readback, &cameraA, &light, &empty);
  renderer.hiz[0usize].readStats();
  eprint <- "measured occlusion, second frame: "; eprint <- u64.from(renderer.hiz[0usize].passed0); eprint <- " pass the first test, ";
  eprint <- u64.from(renderer.hiz[0usize].passed1); eprint <- " the retest, of 9\n";
  expectUInt(u64.from(differing(&offA, &on2, &mut worst)), 0u64, "the picture is the one occlusion off draws, the hidden ones culled");
  expect(renderer.hiz[0usize].passed0 + renderer.hiz[0usize].passed1 <= 5u32, "at most the front, the peeking and the beside box (and not the hidden box or the row) are drawn");
  expect(renderer.hiz[0usize].passed0 >= 3u32, "the front, the peeking and the beside box pass the first test");
  expect(renderer.hiz[0usize].passed0 + renderer.hiz[0usize].passed1 >= 3u32, "none of the visible ones is lost");
  // A third frame, the same
  let on3 = pictureOf(renderer, device, color, &depth, readback, &cameraA, &light, &empty);
  expectUInt(u64.from(differing(&offA, &on3, &mut worst)), 0u64, "a third frame draws the same");

  // The camera moves up over the wall: the box it hid is in view. The old
  // pyramid hides it in the first test; the retest after the new depth finds it
  let moved = pictureOf(renderer, device, color, &depth, readback, &cameraB, &light, &empty);
  renderer.hiz[0usize].readStats();
  eprint <- "measured occlusion, camera moved: "; eprint <- u64.from(renderer.hiz[0usize].passed0); eprint <- " pass the first test, ";
  eprint <- u64.from(renderer.hiz[0usize].passed1); eprint <- " the retest\n";
  expectUInt(u64.from(differing(&offB, &moved, &mut worst)), 0u64, "false negatives are retested: the camera moved and the picture is the one occlusion off draws");
  expect(renderer.hiz[0usize].passed1 >= 1u32, "the box the old pyramid hid is drawn by the second draw");
  // And the next frame has the new pyramid
  let moved2 = pictureOf(renderer, device, color, &depth, readback, &cameraB, &light, &empty);
  expectUInt(u64.from(differing(&offB, &moved2, &mut worst)), 0u64, "and the one after");

  // A box moved behind the wall is culled; moved out again, it is back
  renderer.moveSceneItem(front, Mat4.fromTranslation(new Vec3(0., 0., -3.)));
  pictureOf(renderer, device, color, &depth, readback, &cameraA, &light, &empty);
  let hiddenFront = pictureOf(renderer, device, color, &depth, readback, &cameraA, &light, &empty);
  renderer.hiz[0usize].readStats();
  expect(renderer.hiz[0usize].passed0 + renderer.hiz[0usize].passed1 <= 4u32, "a box moved behind the wall is culled too");
  renderer.vis.settings.occlusion = false;
  let hiddenOff = pictureOf(renderer, device, color, &depth, readback, &cameraA, &light, &empty);
  expectUInt(u64.from(differing(&hiddenOff, &hiddenFront, &mut worst)), 0u64, "and the picture is unchanged");
  renderer.clearScene();
}

// ---- 11. Grouping by hash equals sorting ----

fn groupingChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  let cube = renderer.addMesh(device, &Mesh.cube(1.));
  let ball = renderer.addMesh(device, &Mesh.sphere(1., 8));
  var materials = List[MaterialHandle].empty();
  var k = 0;
  while k < 3 {
    let m = Material.plain(new Color(0.9 - 0.3 * f32.from(k), 0.3 + 0.25 * f32.from(k), 0.4, 1.));
    materials.push(renderer.addMaterial(device, &m));
    k = k + 1;
  }
  // 3,000 separate small things on a grid, 3 materials and 2 meshes
  var list = DrawList.empty();
  var i = 0;
  while i < 3000 {
    let p = new Vec3(f32.from(i % 60) * 0.5 - 14.75, f32.from(i / 60) * 0.5 - 12.25, 0.);
    list.add(if i % 7 == 0 { ball } else { cube }, *materials[usize.from(u32.from(i % 3))],
      Mat4.fromTrs(p, Quat.identity(), new Vec3(0.18, 0.18, 0.18)));
    i = i + 1;
  }
  var camera = Camera.make();
  camera.fov = radians(50.);
  camera.lookAt(new Vec3(0., 0., 30.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.05, 0.05, 0.1, 1.);
  let light = sun(radians(50.), radians(30.), 3., 0.2);
  renderer.bucketMin = 1000000usize;
  let sorted = pictureOf(renderer, device, color, depth, readback, &camera, &light, &list);
  let sortedDraws = renderer.drawCalls;
  renderer.bucketMin = 2048usize;
  let grouped = pictureOf(renderer, device, color, depth, readback, &camera, &light, &list);
  var worst = 0.f;
  expectUInt(u64.from(differing(&sorted, &grouped, &mut worst)), 0u64, "3,000 items grouped by hash draw the picture sorting draws");
  expectUInt(u64.from(renderer.drawCalls), u64.from(sortedDraws), "in the same draws");
  expect(renderer.instancesDrawn == 3000u32 && sortedDraws == 6u32, "six batches of 3,000 instances");
}

fn main() i32 {
  var instance = Instance.create("render visibility");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  var device = adapter.requestDevice();
  require(device.isValid(), "a device");
  eprint <- "measured adapter: "; eprintStr(adapter.name.view()); eprint <- "\n";
  let targetDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var color = device.createTexture(&targetDesc);
  let depthDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var readback = device.createBuffer(262144u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  require(renderer.isValid(), "a renderer");

  fieldChecks(&mut renderer, &mut device, &color, &depth, &readback, false, "the scene with everything off equals the list (lit)");
  fieldChecks(&mut renderer, &mut device, &color, &depth, &readback, true, "the scene with everything off equals the list (physically based)");
  instancingChecks(&mut renderer, &mut device, &color, &depth, &readback, false, "instanced equals individual draws (lit)");
  instancingChecks(&mut renderer, &mut device, &color, &depth, &readback, true, "instanced equals individual draws (physically based)");

  occlusionChecks(&mut renderer, &mut device, &color, &readback, false);
  occlusionChecks(&mut renderer, &mut device, &color, &readback, true);
  groupingChecks(&mut renderer, &mut device, &color, &depth, &readback);
  levelChecks(&mut renderer, &mut device, &color, &depth, &readback);
  rangeChecks(&mut renderer, &mut device, &color, &depth, &readback);
  layerChecks(&mut renderer, &mut device, &color, &depth, &readback);
  shadowChecks(&mut renderer, &mut device, &color, &depth, &readback);
  localShadowChecks(&mut renderer, &mut device, &color, &depth, &readback, true);
  localShadowChecks(&mut renderer, &mut device, &color, &depth, &readback, false);

  device.waitIdle();
  eprint <- "measured validation messages: ";eprint <- u64.from(validationMessages()); eprint <- "\n";
  expectUInt(u64.from(validationMessages()), 0u64, "no validation messages");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan failures");
  done()
}
