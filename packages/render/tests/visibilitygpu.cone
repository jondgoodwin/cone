// The render package's scene (visibility.cone) drawn on a real GPU with no
// window: pictures of 256 x 256 into an rgba8unorm target, read back and
// compared with the pictures a DrawList draws. It needs a GPU driver with
// Vulkan 1.3 and SDL3.dll; with the Vulkan SDK, validation and synchronization
// validation are on, and must say nothing. GPU_POWER_PREFERENCE=low-power runs
// it on the integrated GPU. Only a failure prints (and measurements, marked
// "measured").
//
//  1. Everything off: a scene of 160 things (three meshes, three materials,
//     a third of them out of view) with VisibilitySettings.off() draws the
//     same bytes as a DrawList of the same things in the same order, lit and
//     physically based.
//  2. Culling on: the same picture, byte for byte, from fewer instances.
//  3. Instancing: 100 cubes of one mesh and material are one draw; the same
//     100 with a material each (100 batches) draw the same bytes, lit and
//     physically based.
//  4. A thing moved: the scene after 'moveSceneItem' equals a DrawList with
//     the thing at its new place; moved out of view, nothing of it is drawn.
//  5. Layers: a scene item on layer 2 is not in a view whose mask is 1.
//  6. Shadows: a tall box beside the view, out of it, casts into it. The
//     scene (culling on, casters gathered by each cascade's volume) draws the
//     bytes the DrawList draws; with the casters taken from the view's own
//     (VisibilitySettings.shadowCulling off) the shadow is missing: the
//     picture differs. Four cascades and the low tier; a local light's
//     shadow the same.
//  7. Levels: two quads of one footprint, shaded differently, as levels 0
//     and 1; far enough away it is the second; a switch is a cross-fade
//     over five frames in which the share of the footprint the old one holds
//     falls 1 - t and the new one's rises t (t = 0.2, 0.4 ... within 0.03) and
//     none of it is left undrawn.
//  8. A range: the same quad with a range to 100 and a margin of 40 seen
//     from 80 draws half of its footprint, from 50 all of it, from 101 none.
//  9. Casters have a level: a shadow pass uses the coarser level (the bias).

mod visibilitygpu;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;

const SIDE = 256u32;
const SIDEZ = 256usize;
const BYTES = 262144usize;

struct Rng {
  s u64;
  fn next(self &mut) u64 {
    s = s ^ (s >> 12u64);
    s = s ^ (s << 25u64);
    s = s ^ (s >> 27u64);
    s * 2685821657736338717u64;
  }
  fn unit(self &mut) f32 { f32.from(next() >> 40u64) / 16777216.; }
  fn range(self &mut, lo f32, hi f32) f32 { lo + (hi - lo) * unit(); }
}

fn absf(x f32) f32 { if x < 0. { 0. - x; } else { x; }; }

fn near(a f32, b f32, within f32) bool { absf(a - b) <= within; }

fn px(p *u8, x usize, y usize) f32 { f32.from(*(p + (y * SIDEZ + x) * 4usize)); }

fn drawFrame(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    camera &Camera, light &Light, list &DrawList) {
  mut encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, color, depth, camera, light, list);
  encoder.copyTextureToBuffer(color, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn snapshot(p *u8) List[u8] {
  mut out = List[u8].withCapacity(BYTES);
  mut i = 0usize;
  while i < BYTES {
    out.push(*(p + i));
    i = i + 1usize;
  }
  out;
}

// How many bytes of two pictures differ, and by how much at most
fn differing(a &List[u8], b &List[u8], worst &mut f32) u32 {
  mut n = 0u32;
  *worst = 0.;
  mut i = 0usize;
  while i < BYTES {
    imm d = absf(f32.from(*a[i]) - f32.from(*b[i]));
    if d > 0. { n = n + 1u32; }
    if d > *worst { *worst = d; }
    i = i + 1usize;
  }
  n;
}

// A picture of a draw list: drawn, read back, copied
fn pictureOf(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    camera &Camera, light &Light, list &DrawList) List[u8] {
  drawFrame(renderer, device, color, depth, readback, camera, light, list);
  snapshot(readback.mappedRange());
}

fn sun(elevation f32, azimuth f32, intensity f32, ambient f32) Light {
  imm c = cos(elevation);
  imm toSun = new Vec3(c * cos(azimuth), sin(elevation), c * sin(azimuth));
  Light.directional(new Vec3(0., 0., 0.) - toSun, Color.gray(intensity), Color.gray(ambient));
}

// ---- 1 to 5: a field of things ----

struct Field {
  cube MeshHandle;
  ball MeshHandle;
  slab MeshHandle;
  lit List[MaterialHandle];
  pbr List[MaterialHandle];
}

fn makeField(renderer &mut Renderer, device &mut Device) Field {
  imm cube = renderer.addMesh(device, &Mesh.cube(1.));
  imm ball = renderer.addMesh(device, &Mesh.sphere(1., 24));
  imm slab = renderer.addMesh(device, &Mesh.plane(1, 1.));
  mut lit = List[MaterialHandle].empty();
  mut pbr = List[MaterialHandle].empty();
  mut k = 0;
  while k < 3 {
    imm c = new Color(0.9 - 0.3 * f32.from(k), 0.3 + 0.25 * f32.from(k), 0.4, 1.);
    imm m = Material.plain(c);
    lit.push(renderer.addMaterial(device, &m));
    imm pm = PbrMaterial.standard(c, 0.2 * f32.from(k), 0.6);
    pbr.push(renderer.addPbrMaterial(device, &pm));
    k = k + 1;
  }
  new Field(cube, ball, slab, lit, pbr);
}

struct Thing {
  mesh MeshHandle;
  material u32;
  model Mat4;
}

fn makeThings(field &Field, count i32) List[Thing] {
  mut rng = new Rng(88172645463325252u64);
  mut things = List[Thing].empty();
  mut i = 0;
  while i < count {
    imm kind = i % 3;
    imm mesh = if kind == 0 { field.cube; } elif kind == 1 { field.ball; } else { field.cube; };
    imm p = new Vec3(rng.range(-30., 30.), rng.range(0.5, 3.), rng.range(-30., 8.));
    imm s = rng.range(0.4, 1.6);
    imm q = Quat.angleAxis(rng.range(0., 6.28), new Vec3(0., 1., 0.));
    things.push(new Thing(mesh, u32.from(i % 3), Mat4.fromTrs(p, q, new Vec3(s, s * rng.range(0.6, 1.8), s))));
    i = i + 1;
  }
  things;
}

fn viewCamera() Camera {
  mut camera = Camera.make();
  camera.fov = radians(50.);
  camera.near = 0.3;
  camera.far = 120.;
  camera.lookAt(new Vec3(0., 6., 22.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.05, 0.05, 0.1, 1.);
  camera;
}

fn listOf(things &List[Thing], field &Field, pbr bool) DrawList {
  mut list = DrawList.empty();
  list.add(field.slab, if pbr { *field.pbr[0usize]; } else { *field.lit[0usize]; },
    Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(100., 1., 100.)));
  mut i = 0usize;
  while i < things.len() {
    imm t = things[i];
    list.add(t.mesh, if pbr { *field.pbr[usize.from(t.material)]; } else { *field.lit[usize.from(t.material)]; }, t.model);
    i = i + 1usize;
  }
  list;
}

fn fillScene(renderer &mut Renderer, things &List[Thing], field &Field, pbr bool) List[SceneHandle] {
  mut handles = List[SceneHandle].empty();
  handles.push(renderer.addSceneItem(field.slab, if pbr { *field.pbr[0usize]; } else { *field.lit[0usize]; },
    Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(100., 1., 100.)), new Color(1., 1., 1., 1.)));
  mut i = 0usize;
  while i < things.len() {
    imm t = things[i];
    handles.push(renderer.addSceneItem(t.mesh, if pbr { *field.pbr[usize.from(t.material)]; } else { *field.lit[usize.from(t.material)]; },
      t.model, new Color(1., 1., 1., 1.)));
    i = i + 1usize;
  }
  handles;
}

fn fieldChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer, pbr bool,
    name &Array[u8]) {
  imm field = makeField(renderer, device);
  imm things = makeThings(&field, 160);
  imm camera = viewCamera();
  imm light = sun(radians(50.), radians(30.), 3., 0.2);
  imm list = listOf(&things, &field, pbr);
  imm empty = DrawList.empty();
  imm want = pictureOf(renderer, device, color, depth, readback, &camera, &light, &list);
  imm wantInstances = renderer.instancesDrawn;
  mut worst = 0.;

  // 1. Everything off
  renderer.vis.settings = VisibilitySettings.off();
  imm handles = fillScene(renderer, &things, &field, pbr);
  imm off = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expectUInt(u64.from(differing(&want, &off, &mut worst)), 0u64, name);
  expectUInt(u64.from(renderer.instancesDrawn), u64.from(wantInstances), "everything off draws all the instances");

  // 2. Culling on, nothing else (levels and ranges have nothing to do)
  renderer.vis.settings = new VisibilitySettings();
  imm culled = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  imm n = differing(&want, &culled, &mut worst);
  eprint <- "measured "; eprintStr(name as &str); eprint <- ": culling draws "; eprint <- u64.from(renderer.instancesDrawn);
  eprint <- " of "; eprint <- u64.from(wantInstances); eprint <- " instances, "; eprint <- u64.from(n); eprint <- " bytes differ\n";
  expectUInt(u64.from(n), 0u64, name);
  expect(renderer.instancesDrawn < wantInstances and renderer.instancesDrawn > 20u32, name);
  expectUInt(u64.from(renderer.vis.stats.items), 161u64, "the scene's items");

  // The scene beside a list: both draw
  imm half = DrawList.empty();
  mut mixed = DrawList.empty();
  mixed.add(field.cube, *field.lit[2usize], Mat4.fromTranslation(new Vec3(0., 1., 15.)));
  imm withBoth = pictureOf(renderer, device, color, depth, readback, &camera, &light, &mixed);
  expect(differing(&culled, &withBoth, &mut worst) > 100u32, "a list's item draws beside the scene's");

  // 4. A thing moved
  imm k = 7usize;
  mut moved = things;
  imm old = *moved[k];
  imm placed = Mat4.fromTrs(new Vec3(1., 1., 12.), Quat.identity(), new Vec3(1.5, 1.5, 1.5));
  renderer.moveSceneItem(*handles[k + 1usize], placed);
  moved.set(k, new Thing(old.mesh, old.material, placed));
  imm movedList = listOf(&moved, &field, pbr);
  imm wantMoved = pictureOf(renderer, device, color, depth, readback, &camera, &light, &movedList);
  // (the scene still holds the old place until the next draw: first the list's, then the scene's)
  imm sceneMoved = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expectUInt(u64.from(differing(&wantMoved, &sceneMoved, &mut worst)), 0u64, "a moved item draws where it was moved");
  expect(differing(&culled, &sceneMoved, &mut worst) > 50u32, "and the picture did change");
  renderer.moveSceneItem(*handles[k + 1usize], Mat4.fromTranslation(new Vec3(0., 1., 500.)));
  imm gone = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  moved.set(k, new Thing(old.mesh, old.material, Mat4.fromTranslation(new Vec3(0., 1., 500.))));
  imm wantGone = pictureOf(renderer, device, color, depth, readback, &camera, &light, &listOf(&moved, &field, pbr));
  expectUInt(u64.from(differing(&wantGone, &gone, &mut worst)), 0u64, "moved out of view: as if drawn there");

  // 5. Layers: put item 5 on layer 2, and draw with a mask of 1
  renderer.clearScene();
  expectUInt(u64.from(renderer.vis.count()), 0u64, "cleared");
}

// ---- 3. Instancing ----

fn instancingChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    pbr bool, name &Array[u8]) {
  imm cube = renderer.addMesh(device, &Mesh.cube(1.));
  imm c = new Color(0.8, 0.5, 0.2, 1.);
  mut materials = List[MaterialHandle].empty();
  mut i = 0;
  while i < 100 {
    if pbr {
      imm pm = PbrMaterial.standard(c, 0.3, 0.5);
      materials.push(renderer.addPbrMaterial(device, &pm));
    } else {
      imm m = Material.plain(c);
      materials.push(renderer.addMaterial(device, &m));
    }
    i = i + 1;
  }
  mut together = DrawList.empty();
  mut apart = DrawList.empty();
  i = 0;
  while i < 100 {
    imm p = new Vec3(f32.from(i % 10) * 1.6 - 7.2, f32.from(i / 10) * 1.2 - 5.4, f32.from((i * 7) % 5) * -0.8);
    imm m = Mat4.fromTrs(p, Quat.angleAxis(f32.from(i) * 0.37, new Vec3(0.3, 1., 0.2).normalize()), new Vec3(0.55, 0.45, 0.5));
    together.add(cube, *materials[0usize], m);
    apart.add(cube, *materials[usize.from(u32.from(i))], m);
    i = i + 1;
  }
  mut camera = Camera.make();
  camera.fov = radians(45.);
  camera.lookAt(new Vec3(0., 0., 16.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.05, 0.05, 0.1, 1.);
  imm light = sun(radians(50.), radians(30.), 3., 0.2);
  imm one = pictureOf(renderer, device, color, depth, readback, &camera, &light, &together);
  expectUInt(u64.from(renderer.drawCalls), 1u64, name);
  expectUInt(u64.from(renderer.instancesDrawn), 100u64, "one batch of 100 instances");
  imm many = pictureOf(renderer, device, color, depth, readback, &camera, &light, &apart);
  expectUInt(u64.from(renderer.drawCalls), 100u64, "100 materials: 100 batches");
  mut worst = 0.;
  imm n = differing(&one, &many, &mut worst);
  expectUInt(u64.from(n), 0u64, name);
  // And as a scene: the same one batch, the same bytes
  mut h = List[SceneHandle].empty();
  i = 0;
  while i < 100 {
    h.push(renderer.addSceneItem(cube, *materials[0usize], together.items[usize.from(u32.from(i))].model, new Color(1., 1., 1., 1.)));
    i = i + 1;
  }
  imm empty = DrawList.empty();
  imm viaScene = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expectUInt(u64.from(renderer.drawCalls), 1u64, "a scene's 100 are one draw too");
  expectUInt(u64.from(differing(&one, &viaScene, &mut worst)), 0u64, "and the same bytes");
  renderer.clearScene();
}

// ---- 6. Shadows from beside the view ----

fn topDown() Camera {
  mut camera = Camera.make();
  camera.fov = radians(40.);
  camera.near = 0.1;
  camera.far = 100.;
  camera.lookAt(new Vec3(0., 12., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., -1.));
  camera.background = new Color(0., 0., 0., 1.);
  camera;
}

fn dark() Light {
  Light.directional(new Vec3(0., -1., 0.), Color.gray(0.), Color.gray(0.));
}

fn shadowChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  imm ground = renderer.addMesh(device, &Mesh.plane(1, 1.));
  imm cube = renderer.addMesh(device, &Mesh.cube(1.));
  imm m = Material.plain(new Color(0.5, 0.5, 0.5, 1.));
  imm lit = renderer.addMaterial(device, &m);
  imm pm = PbrMaterial.standard(new Color(0.5, 0.5, 0.5, 1.), 0., 1.);
  imm pbr = renderer.addPbrMaterial(device, &pm);
  imm camera = topDown();
  imm empty = DrawList.empty();
  mut worst = 0.;
  mut pass = 0;
  while pass < 2 {
    imm material = if pass == 0 { lit; } else { pbr; };
    imm sunLight = sun(radians(45.), 0., 2.5132741, 0.1);
    // The ground and, beside the view at x = 7, a box 8 high: its top edge's shadow lands at x = 6 - 8 = -2
    mut list = DrawList.empty();
    list.add(ground, material, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(40., 1., 40.)));
    list.add(cube, material, Mat4.fromTrs(new Vec3(7., 4., 0.), Quat.identity(), new Vec3(1., 4., 1.)));
    // and some small things in view and out of it, to be batched
    mut extra = 0;
    while extra < 12 {
      list.add(cube, material, Mat4.fromTrs(new Vec3(f32.from(extra) * 3. - 18., 0.5, f32.from(extra % 4) * 3. - 6.), Quat.identity(), new Vec3(0.4, 0.5, 0.4)));
      extra = extra + 1;
    }
    imm tiers = [ShadowSettings.high(), ShadowSettings.low()];
    mut tier = 0usize;
    while tier < 2usize {
      mut s = tiers[tier];
      s.distance = 40.;
      renderer.setShadows(device, &s);
      renderer.clearScene();
      imm wantReal = pictureOf(renderer, device, color, depth, readback, &camera, &sunLight, &list);
      mut i = 0usize;
      while i < list.items.len() {
        imm it = list.items[i];
        renderer.addSceneItem(it.mesh, it.material, it.model, new Color(1., 1., 1., 1.));
        i = i + 1usize;
      }
      renderer.vis.settings = new VisibilitySettings();
      imm got = pictureOf(renderer, device, color, depth, readback, &camera, &sunLight, &empty);
      expectUInt(u64.from(differing(&wantReal, &got, &mut worst)), 0u64, "a scene's shadows equal a list's, casters from beside the view");
      expectUInt(u64.from(renderer.vis.stats.casterSets), u64.from(renderer.shadow.cascades.count), "each cascade gathered its own casters");
      expect(renderer.vis.stats.casters > 0u32, "and found some");
      renderer.vis.settings.shadowCulling = false;
      imm lost = pictureOf(renderer, device, color, depth, readback, &camera, &sunLight, &empty);
      imm n = differing(&wantReal, &lost, &mut worst);
      eprint <- "measured shadows from beside the view, casters from the view's own set: "; eprint <- u64.from(n); eprint <- " bytes differ\n";
      expect(n > 500u32, "casters taken from what the view sees lose a shadow from beside it");
      tier = tier + 1usize;
    }
    renderer.clearScene();
    pass = pass + 1;
  }
  renderer.disableShadows(device);
}

fn localShadowChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer, pointLight bool) {
  imm ground = renderer.addMesh(device, &Mesh.plane(1, 1.));
  imm cube = renderer.addMesh(device, &Mesh.cube(1.));
  imm m = Material.plain(new Color(0.5, 0.5, 0.5, 1.));
  imm lit = renderer.addMaterial(device, &m);
  imm camera = topDown();
  imm empty = DrawList.empty();
  renderer.environmentStrength = 0.;
  renderer.lights.clear();
  imm at = new Vec3(12., 12., 0.);
  imm lamp = if pointLight {
    renderer.lights.addPoint(at, Color.gray(1.), 3000., 40.);
  } else {
    renderer.lights.addSpot(at, new Vec3(-12., -12., 0.), Color.gray(1.), 3000., 40., radians(40.), radians(50.));
  };
  renderer.lights.setCastsShadow(lamp, true);
  imm settings = LightShadowSettings.medium();
  renderer.setLightShadows(device, &settings);
  mut list = DrawList.empty();
  list.add(ground, lit, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(40., 1., 40.)));
  list.add(cube, lit, Mat4.fromTrs(new Vec3(7., 4., 0.), Quat.identity(), new Vec3(1., 4., 1.)));
  mut i = 0usize;
  while i < list.items.len() {
    imm it = list.items[i];
    renderer.addSceneItem(it.mesh, it.material, it.model, new Color(1., 1., 1., 1.));
    i = i + 1usize;
  }
  renderer.vis.settings = VisibilitySettings.off();
  imm light = dark();
  imm want = pictureOf(renderer, device, color, depth, readback, &camera, &light, &list);
  imm viaOff = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  mut worst = 0.;
  expectUInt(u64.from(differing(&want, &viaOff, &mut worst)), 0u64, "a light's shadows, the scene with everything off");
  expect(renderer.lights.isShadowed(lamp), "the light has a shadow view");
  renderer.vis.settings = new VisibilitySettings();
  imm got = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expectUInt(u64.from(differing(&want, &got, &mut worst)), 0u64, "a light's shadows from a box beside the view, casters gathered by the face's volume");
  expect(renderer.vis.stats.casterSets >= 1u32, "the light's faces gathered their own casters");
  renderer.vis.settings.shadowCulling = false;
  imm lost = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
  expect(differing(&want, &lost, &mut worst) > 300u32, "from the view's own set the shadow is lost");
  renderer.clearScene();
  renderer.lights.clear();
  imm off = LightShadowSettings.off();
  renderer.setLightShadows(device, &off);
  renderer.environmentStrength = 1.;
}

// ---- 7 and 8. Levels and ranges, by what share of a footprint each draws ----

// A square 4 across in the plane z = 0 facing 'normal'
fn quad(normal Vec3) Mesh {
  mut m = Mesh.empty();
  m.positions.push(new Vec3(-2., -2., 0.));
  m.positions.push(new Vec3(2., -2., 0.));
  m.positions.push(new Vec3(2., 2., 0.));
  m.positions.push(new Vec3(-2., 2., 0.));
  mut k = 0;
  while k < 4 {
    m.normals.push(normal);
    m.uvs.push(new Vec2(0., 0.));
    k = k + 1;
  }
  m.indices.push(0u32); m.indices.push(1u32); m.indices.push(2u32);
  m.indices.push(0u32); m.indices.push(2u32); m.indices.push(3u32);
  m;
}

fn faceCamera(distance f32) Camera {
  mut camera = Camera.make();
  camera.fov = radians(40.);
  camera.near = 0.1;
  camera.far = 400.;
  camera.lookAt(new Vec3(0., 0., distance), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0., 0., 0., 1.);
  camera;
}

fn frontLight() Light {
  Light.directional(new Vec3(0., 0., -1.), Color.gray(1.5), Color.gray(0.1));
}

// Of the pixels that 'a' and 'b' draw differently: how many 'p' draws as 'a',
// as 'b', and as neither
fn classify(a &List[u8], b &List[u8], p &List[u8], ofA &mut u32, ofB &mut u32, neither &mut u32) u32 {
  mut total = 0u32;
  *ofA = 0u32;
  *ofB = 0u32;
  *neither = 0u32;
  mut i = 0usize;
  while i < BYTES {
    mut differs = false;
    mut matchA = true;
    mut matchB = true;
    mut c = 0usize;
    while c < 3usize {
      if *a[i + c] != *b[i + c] { differs = true; }
      if *p[i + c] != *a[i + c] { matchA = false; }
      if *p[i + c] != *b[i + c] { matchB = false; }
      c = c + 1usize;
    }
    if differs {
      total = total + 1u32;
      if matchA { *ofA = *ofA + 1u32; } elif matchB { *ofB = *ofB + 1u32; } else { *neither = *neither + 1u32; }
    }
    i = i + 4usize;
  }
  total;
}

fn levelChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  imm meshA = renderer.addMesh(device, &quad(new Vec3(0., 0., 1.)));
  imm meshB = renderer.addMesh(device, &quad(new Vec3(0.6, 0., 0.8)));
  imm m = Material.plain(new Color(0.9, 0.9, 0.9, 1.));
  imm lit = renderer.addMaterial(device, &m);
  imm light = frontLight();
  imm empty = DrawList.empty();
  imm model = Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(1., 1., 1.));
  // The two levels alone, at the far distance
  mut la = DrawList.empty();
  la.add(meshA, lit, model);
  mut lb = DrawList.empty();
  lb.add(meshB, lit, model);
  imm far = faceCamera(20.);
  imm pictureA = pictureOf(renderer, device, color, depth, readback, &far, &light, &la);
  imm pictureB = pictureOf(renderer, device, color, depth, readback, &far, &light, &lb);

  // The chain: A while at least 120 pixels, B under
  mut chain = LodChain.empty(0.1);
  chain.add(meshA, 120.);
  chain.add(meshB, 0.);
  imm h = renderer.addSceneItem(meshA, lit, model, new Color(1., 1., 1., 1.));
  renderer.setSceneLod(h, &chain);
  renderer.vis.settings = new VisibilitySettings();
  renderer.vis.settings.fadeSeconds = 0.5;
  renderer.vis.settings.timeStep = 0.1;
  // Near: level 0 alone, first sight (the quad is 4 across: radius 2.83, at 10 away about 199 pixels)
  imm near10 = faceCamera(10.);
  drawFrame(renderer, device, color, depth, readback, &near10, &light, &empty);
  expectUInt(u64.from(renderer.instancesDrawn), 1u64, "near: one draw");
  // Far: a cross-fade
  mut ofA = 0u32;
  mut ofB = 0u32;
  mut neither = 0u32;
  mut worstShare = 0.;
  mut k = 1;
  while k <= 5 {
    imm picture = pictureOf(renderer, device, color, depth, readback, &far, &light, &empty);
    imm total = classify(&pictureA, &pictureB, &picture, &mut ofA, &mut ofB, &mut neither);
    imm t = f32.from(k) * 0.2;
    imm shareA = f32.from(ofA) / f32.from(total);
    imm shareB = f32.from(ofB) / f32.from(total);
    eprint <- "measured cross-fade frame "; eprint <- u64.from(u32.from(k)); eprint <- ": of "; eprint <- u64.from(total);
    eprint <- " pixels the old level draws "; eprint <- shareA; eprint <- " (want "; eprint <- (1. - t);
    eprint <- "), the new "; eprint <- shareB; eprint <- " (want "; eprint <- t; eprint <- "), "; eprint <- u64.from(neither); eprint <- " neither\n";
    expect(total > 3000u32, "the footprint is big enough to count");
    expectUInt(u64.from(neither), 0u64, "every pixel is drawn by one level or the other, as one of them draws it");
    expect(absf(shareA - (1. - t)) <= 0.03 and absf(shareB - t) <= 0.03, "the cross-fade's shares fall and rise by 0.2 a frame");
    if k == 5 { expectUInt(u64.from(ofB), u64.from(total), "after five frames the new level alone"); }
    expectUInt(u64.from(renderer.instancesDrawn), if k < 5 { 2u64; } else { 1u64; }, "two draws while fading, then one");
    k = k + 1;
  }
  // With cross-fade off, a switch is a pop
  renderer.vis.settings.crossFade = false;
  drawFrame(renderer, device, color, depth, readback, &near10, &light, &empty);
  imm popped = pictureOf(renderer, device, color, depth, readback, &far, &light, &empty);
  imm popTotal = classify(&pictureA, &pictureB, &popped, &mut ofA, &mut ofB, &mut neither);
  expectUInt(u64.from(ofB), u64.from(popTotal), "cross-fade off: the new level alone at once");
  renderer.clearScene();
}

fn rangeChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  imm meshA = renderer.addMesh(device, &quad(new Vec3(0., 0., 1.)));
  imm m = Material.plain(new Color(0.9, 0.9, 0.9, 1.));
  imm lit = renderer.addMaterial(device, &m);
  imm light = frontLight();
  imm empty = DrawList.empty();
  imm model = Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(5., 5., 5.));
  imm h = renderer.addSceneItem(meshA, lit, model, new Color(1., 1., 1., 1.));
  renderer.setSceneRange(h, 0., 100., 40.);
  renderer.vis.settings = new VisibilitySettings();
  imm bg = DrawList.empty();
  mut ofFull = 0u32;
  mut ofBg = 0u32;
  mut neither = 0u32;
  mut worst = 0.;
  mut dists = [50., 80., 90., 101.];
  mut wants = [1., 0.5, 0.25, 0.];
  mut k = 0usize;
  while k < 4usize {
    imm camera = faceCamera(dists[k]);
    renderer.vis.settings.ranges = false;
    imm full = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
    renderer.vis.settings.ranges = true;
    imm got = pictureOf(renderer, device, color, depth, readback, &camera, &light, &empty);
    // Against the picture with the quad and the picture of nothing (a blank)
    mut blank = List[u8].empty();
    mut i = 0usize;
    while i < BYTES {
      blank.push(if i % 4usize == 3usize { 255u8; } else { 0u8; });
      i = i + 1usize;
    }
    imm total = classify(&full, &blank, &got, &mut ofFull, &mut ofBg, &mut neither);
    imm share = f32.from(ofFull) / f32.from(total);
    eprint <- "measured a range's fade at "; eprint <- dists[k]; eprint <- " away: "; eprint <- share; eprint <- " of "; eprint <- u64.from(total);
    eprint <- " pixels drawn (want "; eprint <- wants[k]; eprint <- "), "; eprint <- u64.from(neither); eprint <- " neither\n";
    expectUInt(u64.from(neither), 0u64, "a faded pixel is the quad's or the background's");
    expect(absf(share - wants[k]) <= 0.04, "the share of the quad a range's fade draws");
    k = k + 1usize;
  }
  expectUInt(u64.from(renderer.vis.stats.rangeCulled), 1u64, "past the end: culled");
  renderer.clearScene();
}

// ---- 5. Layers ----

fn layerChecks(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer) {
  imm cube = renderer.addMesh(device, &Mesh.cube(1.));
  imm m = Material.plain(new Color(0.9, 0.5, 0.2, 1.));
  imm lit = renderer.addMaterial(device, &m);
  imm a = renderer.addSceneItem(cube, lit, Mat4.fromTranslation(new Vec3(-3., 0., 0.)), new Color(1., 1., 1., 1.));
  imm b = renderer.addSceneItem(cube, lit, Mat4.fromTranslation(new Vec3(3., 0., 0.)), new Color(1., 1., 1., 1.));
  renderer.setSceneLayers(a, 2u32);
  renderer.vis.settings = new VisibilitySettings();
  mut view = RenderView.create(renderer, device, 64u32, 64u32);
  imm camera = faceCamera(14.);
  imm light = frontLight();
  view.layerMask = 1u32;
  view.render(renderer, device, &camera, &light, &DrawList.empty(), 1u32);
  expectUInt(u64.from(renderer.vis.stats.drawn), 1u64, "a view on layer 1 draws the one item on layer 1");
  expectUInt(u64.from(renderer.vis.stats.layerCulled), 1u64, "and not the one on layer 2");
  view.layerMask = 3u32;
  view.render(renderer, device, &camera, &light, &DrawList.empty(), 1u32);
  expectUInt(u64.from(renderer.vis.stats.drawn), 2u64, "on layers 1 and 2: both");
  expectUInt(u64.from(renderer.vis.layerMask), u64.from(LAYERS_ALL), "the layer mask is the view's only for its picture");
  device.endFrame();
  device.waitIdle();
  renderer.clearScene();
}

fn main() i32 {
  mut instance = Instance.create("render visibility");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  eprint <- "measured adapter: "; eprintStr(adapter.name.view()); eprint <- "\n";
  imm targetDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut color = device.createTexture(&targetDesc);
  imm depthDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  mut depth = device.createTexture(&depthDesc);
  mut readback = device.createBuffer(262144u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  require(renderer.isValid(), "a renderer");

  fieldChecks(&mut renderer, &mut device, &color, &depth, &readback, false, "the scene with everything off equals the list (lit)");
  fieldChecks(&mut renderer, &mut device, &color, &depth, &readback, true, "the scene with everything off equals the list (physically based)");
  instancingChecks(&mut renderer, &mut device, &color, &depth, &readback, false, "instanced equals individual draws (lit)");
  instancingChecks(&mut renderer, &mut device, &color, &depth, &readback, true, "instanced equals individual draws (physically based)");

  levelChecks(&mut renderer, &mut device, &color, &depth, &readback);
  rangeChecks(&mut renderer, &mut device, &color, &depth, &readback);
  layerChecks(&mut renderer, &mut device, &color, &depth, &readback);
  shadowChecks(&mut renderer, &mut device, &color, &depth, &readback);
  localShadowChecks(&mut renderer, &mut device, &color, &depth, &readback, true);
  localShadowChecks(&mut renderer, &mut device, &color, &depth, &readback, false);

  device.waitIdle();
  eprint <- "measured validation messages: ";eprint <- u64.from(validationMessages()); eprint <- "\n";
  expectUInt(u64.from(validationMessages()), 0u64, "no validation messages");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan failures");
  done();
}
