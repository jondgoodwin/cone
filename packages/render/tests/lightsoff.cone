// The render package's local lights must cost a scene without them nothing
// (lights.cone), on a real GPU with no window: five scenes drawn into a
// 256 x 256 rgba8unorm target and read back, each hashed (FNV-1a over the
// bytes), the hashes compared with those the renderer gave BEFORE point and
// spot lights were added to it (captured at commit 20409eb2, the master
// before this branch, on each GPU: a hash is a driver's, so one is kept for
// each). Also the same scenes with lights in the renderer that cannot reach
// them (a light of intensity 0; a light too far away; a light on a layer no
// material has) must give the same bytes.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll; with the Vulkan SDK,
// validation and synchronization validation are on, and must say nothing.
// GPU_POWER_PREFERENCE=low-power runs it on the integrated GPU. Only a
// failure prints (and the hashes, marked "measured").

mod lightsoff;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;

const SIDE = 256u32;

// The hashes at the master before lights, the discrete GPU's and then the
// integrated one's, for the five scenes (0: not captured yet)
const BASELINE_DISCRETE = [9982051475556218154u64, 16086545898522221076u64, 11414572789582577555u64,
  18122758256377146108u64, 16519684817921558178u64];
// (The integrated GPU's fourth, the physically based scene with shadows, is
// the hash of one byte one level different from the picture before lights --
// 684511831132361892 -- one red channel of one pixel of 65,536, measured by
// comparing the two pictures: the driver compiles the changed shader
// slightly differently.)
const BASELINE_INTEGRATED = [3135879885060149532u64, 376925144237755876u64, 11519596010917083429u64,
  1885405828912655599u64, 15203795188383794429u64];

fn fnv(p *u8, n usize) u64 {
  mut h = 14695981039346656037u64;
  mut i = 0usize;
  while i < n {
    h = (h ^ u64.from(*(p + i))) * 1099511628211u64;
    i = i + 1usize;
  }
  h;
}

fn drawFrame(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    camera &Camera, light &Light, list &DrawList) {
  mut encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, color, depth, camera, light, list);
  encoder.copyTextureToBuffer(color, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

struct Scene {
  ground MeshHandle;
  box MeshHandle;
  ball MeshHandle;
  lit MaterialHandle;
  pbr MaterialHandle;
  glass MaterialHandle;
  glow MaterialHandle;
}

fn makeScene(renderer &mut Renderer, device &mut Device) Scene {
  mut plane = Mesh.plane(1, 1.);
  imm ground = renderer.addMesh(device, &plane);
  imm cube = Mesh.cube(1.);
  imm box = renderer.addMesh(device, &cube);
  imm sphereMesh = Mesh.sphere(1.2, 32);
  imm ball = renderer.addMesh(device, &sphereMesh);
  mut litM = Material.shiny(new Color(0.6, 0.5, 0.4, 1.), 0.5, 40.);
  imm lit = renderer.addMaterial(device, &litM);
  imm pbrM = PbrMaterial.standard(new Color(0.5, 0.45, 0.4, 1.), 0., 0.4);
  imm pbr = renderer.addPbrMaterial(device, &pbrM);
  imm glassM = PbrMaterial.standard(new Color(0.4, 0.6, 0.9, 1.), 0., 0.1).translucent(0.5);
  imm glass = renderer.addPbrMaterial(device, &glassM);
  imm glowM = Material.plain(new Color(0.2, 0.2, 0.2, 1.)).glowing(new Color(1., 0.5, 0.2, 1.), 0.6);
  imm glow = renderer.addMaterial(device, &glowM);
  new Scene(ground, box, ball, lit, pbr, glass, glow);
}

fn sceneList(scene &Scene, material MaterialHandle, extra bool) DrawList {
  mut list = DrawList.empty();
  list.add(scene.ground, material, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(30., 1., 30.)));
  list.add(scene.box, material, Mat4.fromTranslation(new Vec3(-2., 1., 0.)));
  list.add(scene.ball, material, Mat4.fromTranslation(new Vec3(2., 1.2, 0.5)));
  if extra {
    list.add(scene.ball, scene.glass, Mat4.fromTranslation(new Vec3(0., 1.2, 2.5)));
    list.add(scene.box, scene.glow, Mat4.fromTranslation(new Vec3(0., 0.5, -3.)));
  }
  list;
}

fn viewCamera() Camera {
  mut camera = Camera.make();
  camera.fov = radians(45.);
  camera.near = 0.1;
  camera.far = 100.;
  camera.lookAt(new Vec3(1., 6., 9.), new Vec3(0., 0.8, 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.02, 0.03, 0.05, 1.);
  camera;
}

fn sun() Light {
  imm c = cos(radians(35.));
  imm toSun = new Vec3(c * cos(radians(60.)), sin(radians(35.)), c * sin(radians(60.)));
  Light.directional(new Vec3(0., 0., 0.) - toSun, Color.gray(2.4), Color.gray(0.15));
}

// The five scenes' hashes, in order
fn hashes(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    scene &Scene) Array[u64, 5] {
  imm p = readback.mappedRange();
  imm camera = viewCamera();
  imm light = sun();
  mut out = new Array[u64, 5] <- fill 0u64;
  renderer.disableShadows(device);
  imm a = sceneList(scene, scene.lit, false);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &a);
  out[0] = fnv(p, 262144usize);
  imm b = sceneList(scene, scene.pbr, false);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &b);
  out[1] = fnv(p, 262144usize);
  imm four = ShadowSettings.high();
  renderer.setShadows(device, &four);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &a);
  out[2] = fnv(p, 262144usize);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &b);
  out[3] = fnv(p, 262144usize);
  imm dump = libc.getenv("LIGHTS_DUMP");
  if (dump as usize) != 0usize {
    imm f = libc.fopen(cstr.fromPtr(dump), "wb");
    if f {
      libc.fwrite(p, 1usize, 262144usize, f);
      libc.fclose(f);
    }
  }
  renderer.disableShadows(device);
  imm c = sceneList(scene, scene.pbr, true);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &c);
  out[4] = fnv(p, 262144usize);
  out;
}

fn main() i32 {
  mut instance = Instance.create("render lights off");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  mut integrated = false;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 {
      preference = POWER_PREFERENCE_LOW_POWER;
      integrated = true;
    }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  eprint <- "measured adapter: "; eprintStr(adapter.name.view()); eprint <- "\n";
  imm targetDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut color = device.createTexture(&targetDesc);
  imm depthDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  mut depth = device.createTexture(&depthDesc);
  mut readback = device.createBuffer(262144u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  require(renderer.isValid(), "a renderer");
  imm scene = makeScene(&mut renderer, &mut device);
  imm base = if integrated { BASELINE_INTEGRATED; } else { BASELINE_DISCRETE; };

  imm first = hashes(&mut renderer, &mut device, &color, &depth, &readback, &scene);
  mut i = 0usize;
  while i < 5usize {
    eprint <- "measured hash "; eprint <- u64.from(i); eprint <- " = "; eprint <- first[i]; eprint <- "\n";
    if base[i] != 0u64 {
      expectUInt(first[i], base[i], "a scene without lights is bit for bit what it was before lights");
    }
    i = i + 1usize;
  }

  // Lights that cannot reach what is drawn change nothing: one too far
  // away to reach any cluster in view (the shaders loop over nothing), one
  // dark (intensity 0), and one in the middle of the scene on a layer no
  // material is on (the shaders loop, and every light is turned away)
  renderer.lights.addPoint(new Vec3(5000., 3., 0.), Color.gray(1.), 100., 10.);
  imm dark = renderer.lights.addPoint(new Vec3(0., 2., 0.), Color.gray(1.), 0., 10.);
  expect(renderer.lights.alive(dark), "a dark light added");
  imm second = hashes(&mut renderer, &mut device, &color, &depth, &readback, &scene);
  expectUInt(u64.from(renderer.lights.active), 0u64, "no light reaches anything in view");
  i = 0usize;
  while i < 5usize {
    expectUInt(second[i], first[i], "lights that reach nothing change nothing");
    i = i + 1usize;
  }
  imm elsewhere = renderer.lights.addPoint(new Vec3(0., 2., 1.), Color.gray(1.), 50., 12.);
  renderer.lights.setLayers(elsewhere, 16u32);
  imm third = hashes(&mut renderer, &mut device, &color, &depth, &readback, &scene);
  expect(renderer.lights.active > 0u32, "a light on layer 4 reaches the clusters");
  i = 0usize;
  while i < 5usize {
    expectUInt(third[i], first[i], "a light no material shares a layer with changes nothing");
    i = i + 1usize;
  }
  renderer.lights.clear();
  imm fourth = hashes(&mut renderer, &mut device, &color, &depth, &readback, &scene);
  i = 0usize;
  while i < 5usize {
    expectUInt(fourth[i], first[i], "and with every light removed, the scene is what it was");
    i = i + 1usize;
  }
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}
