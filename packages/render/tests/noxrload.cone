// A program that links the render package and draws to no headset never asks
// the OS for the OpenXR loader (openxr_loader.dll): render imports the openxr
// package for its Headset, and the package opens the loader when something
// first uses it, not when the program starts. Only a failure prints, and
// nothing printed depends on whether the machine has an OpenXR loader.
//
// - At the start of main, in a program that imports render, the openxr
//   package has tried nothing ('loadAttempted' is false), and on Windows the OS
//   reports no openxr_loader.dll in the process.
// - After a renderer has been made on a real GPU with no window and has drawn a
//   frame into an off-screen texture (the path every program that is not a
//   headset's takes), still nothing has been tried, and the dll is still not
//   in the process.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll; no window, no display of
// its own, and no Vulkan SDK.

mod noxrload;

import testing use *;
import gpu use *;
import geomath use *;
import render use *;
import openxr;

extern {
  fn @c(system) GetModuleHandleA(name: *u8) usize;
}

// The loader's library, if this process has it open (Windows; nowhere else says)
fn loaderInProcess() bool {
  if isWindows() { return GetModuleHandleA(&"openxr_loader.dll" as *u8) != 0usize; }
  false
}

fn main() i32 {
  expectBool(openxr.loadAttempted(), false, "at the start of main, nothing has tried the OpenXR loader");
  expectBool(loaderInProcess(), false, "and the OS has no openxr_loader.dll in the process");

  var instance = Instance.create("render noxrload");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  require(adapter.isValid(), "an adapter");
  var device = adapter.requestDevice();
  require(device.isValid(), "a device");
  let colorDesc = TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var color = device.createTexture(&colorDesc);
  let depthDesc = TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  require(renderer.isValid(), "a renderer");
  var encoder = device.createCommandEncoder();
  let camera = Camera.make();
  let light = Light.directional(Vec3(0., 0., -1.), Color.gray(1.), Color.gray(0.1));
  let list = DrawList.empty();
  renderer.render(&mut device, &mut encoder, &mut color, &mut depth, &camera, &light, &list);
  expectBool(device.queue.submit(encoder.finish()), true, "a frame of nothing drawn");
  device.endFrame();
  device.waitIdle();

  expectBool(openxr.loadAttempted(), false, "after a renderer has drawn a frame, still nothing has tried the OpenXR loader");
  expectBool(loaderInProcess(), false, "and the OS still has no openxr_loader.dll in the process");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  done()
}
