// render's morph targets (morph.cone, morph.slang), on a real GPU with no
// window: a tube of 16 sides and 21 rings (336 vertices; radius 0.08, 1 long
// up +y from the origin, normals pointing out), with the skin of the
// skinning test (two bones, bone 1 at (0, 0.5, 0), the upper half on it),
// and 64 targets over it:
//   target 0   "swell": every vertex out along its normal by 0.05 (dense)
//   target 1   "stretch": rings 12 to 20 (y from 0.6 up) up by 0.3, their
//              normals tilted by (0, 0.4, 0) (sparse)
//   targets 2 to 63   a pseudo-random sparse scatter of small moves, a seventh
//              of the vertices each (positions, normals and tangents)
//
// On the CPU:
//  1. The set: a dense target keeps only the vertices it moves; a sparse
//     target given by indices gives the same entries; entries ascend by
//     vertex; 'find' finds an entry or answers -1; each target's largest move.
//  2. The reference sum, by hand: swell at 0.5 takes vertex 0 from (0.08, 0, 0)
//     to (0.105, 0, 0); a normal is made unit length after the sum; a vertex
//     no weight reaches is left as modelled; weights past the list are zero.
//  3. The MorphMixer's channels and correctives, from rules worked out by hand.
//
// On the GPU (validation and synchronization validation on, and must say
// nothing; GPU_POWER_PREFERENCE=low-power runs it on the integrated GPU):
//  4. A vertex displaced exactly by weight x delta, read back: swell at 0.5
//     puts vertex 0 at (0.105, 0, 0) and vertex 4 at (0, 0, 0.105), and
//     every vertex of the 64-target set with eight active (some negative,
//     some above 1) lies within 1e-6 of the CPU's sum, normals too.
//  5. Zero weights give output byte for byte the unmorphed mesh's, at the
//     start and after weights were set and set back; unchanged weights record
//     no work; a changed one does.
//  6. Morphing first, then skinning: the pre-pass's output carried by the
//     bones on the GPU (skinning.slang's own functions, morphskin.slang) is
//     where the CPU puts it (morph, then Skin.skinPoint), and differs by
//     centimetres from skinning, then morphing.
//  7. Drawn, in the lit and physically based materials, the stretched and bent
//     tube: its arm reaches where morph-then-skin puts it, and not where
//     skin-then-morph would. A copy with all weights zero draws the very
//     pixels the base mesh does.
//  8. A morphed mesh's shadow moves with it: a cube whose target moves it
//     4 along z casts its shadow there and no longer where it was modelled.
//  9. Bounds, the previous frame's positions for a velocity pass, removing a
//     copy (the base still draws).

mod morph;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;

const SIDES = 16usize;
const RINGS = 21usize;
const RADIUS f32 = 0.08;
const TARGETS = 64usize;

// ---- The tube, its skin and its targets ----

fn tube(skin &mut Skin) Mesh {
  var m = Mesh.empty();
  var r = 0usize;
  while r < RINGS {
    let y = f32.from(r) * 0.05;
    let u0 = (y - 0.4) / 0.2;
    let u = if u0 < 0. { 0. } elif u0 > 1. { 1. } else { u0 };
    let w1 = u * u * (3. - 2. * u);
    var k = 0usize;
    while k < SIDES {
      let a = 2. * pi * f32.from(k) / f32.from(SIDES);
      m.positions.push(new Vec3(RADIUS * cos(a), y, RADIUS * sin(a)));
      m.normals.push(new Vec3(cos(a), 0., sin(a)));
      skin.push(0u32, 1u32, 0u32, 0u32, 1. - w1, w1, 0., 0.);
      k = k + 1usize;
    }
    r = r + 1usize;
  }
  r = 0usize;
  while r + 1usize < RINGS {
    var k = 0usize;
    while k < SIDES {
      let k1 = (k + 1usize) % SIDES;
      let v0 = u32.from(r * SIDES + k);
      let v1 = u32.from(r * SIDES + k1);
      let v2 = u32.from((r + 1usize) * SIDES + k1);
      let v3 = u32.from((r + 1usize) * SIDES + k);
      m.indices.push(v0);
      m.indices.push(v2);
      m.indices.push(v1);
      m.indices.push(v0);
      m.indices.push(v3);
      m.indices.push(v2);
      k = k + 1usize;
    }
    r = r + 1usize;
  }
  m
}

// A small pseudo-random number generator (a linear congruence that stays in
// 32 bits): the next of 'state', 0 to 1
fn nextRandom(state &mut u32) f32 {
  *state = (*state * 1103u32 + 12345u32) % 65521u32;
  f32.from(*state) / 65521.
}

fn makeTargets(m &Mesh) MorphTargets {
  let n = m.positions.len();
  var targets = MorphTargets.empty(n);
  let zero = new Vec3(0., 0., 0.);
  // 0: swell, dense, positions only
  var swell = List[Vec3].empty();
  var v = 0usize;
  while v < n {
    swell.push(*m.normals[v] * 0.05);
    v = v + 1usize;
  }
  let noList = List[Vec3].empty();
  targets.addDense(&swell, &noList, &noList);
  // 1: stretch, sparse by indices
  var idx = List[u32].empty();
  var dp = List[Vec3].empty();
  var dn = List[Vec3].empty();
  v = 12usize * SIDES;
  while v < n {
    idx.push(u32.from(v));
    dp.push(new Vec3(0., 0.3, 0.));
    dn.push(new Vec3(0., 0.4, 0.));
    v = v + 1usize;
  }
  targets.addSparse(&idx, &dp, &dn, &noList);
  // 2 to 63: a scatter
  var state = 7u32;
  var t = 2usize;
  while t < TARGETS {
    var p = List[Vec3].empty();
    var nm = List[Vec3].empty();
    var tg = List[Vec3].empty();
    v = 0usize;
    while v < n {
      if (v + t) % 7usize == 0usize {
        p.push(new Vec3(nextRandom(&mut state) - 0.5, nextRandom(&mut state) - 0.5, nextRandom(&mut state) - 0.5) * 0.04);
        nm.push(new Vec3(nextRandom(&mut state) - 0.5, nextRandom(&mut state) - 0.5, nextRandom(&mut state) - 0.5) * 0.4);
        tg.push(new Vec3(nextRandom(&mut state) - 0.5, 0., 0.));
      } else {
        p.push(zero);
        nm.push(zero);
        tg.push(zero);
      }
      v = v + 1usize;
    }
    targets.addDense(&p, &nm, &tg);
    t = t + 1usize;
  }
  targets
}

fn zeros() List[f32] {
  var w = List[f32].empty();
  var t = 0usize;
  while t < TARGETS {
    w.push(0.);
    t = t + 1usize;
  }
  w
}

fn absf(x f32) f32 { if x < 0. { 0. - x } else { x } }

// ---- CPU checks ----

fn cpuChecks(m &Mesh) {
  let targets = makeTargets(m);
  let n = m.positions.len();
  expectUInt(u64.from(targets.count()), 64u64, "64 targets");
  expectUInt(u64.from(targets.targetEntries(0usize)), u64.from(n), "swell, dense, moves every vertex");
  expectUInt(u64.from(targets.targetEntries(1usize)), u64.from(n - 12usize * SIDES), "stretch moves the nine top rings");
  // A dense list with zeros in it keeps only the vertices that move
  var p = List[Vec3].empty();
  var v = 0usize;
  while v < n {
    p.push(if v == 5usize or v == 100usize { new Vec3(0., 1., 0.) } else { new Vec3(0., 0., 0.) });
    v = v + 1usize;
  }
  var small = MorphTargets.empty(n);
  let noList = List[Vec3].empty();
  let t0 = small.addDense(&p, &noList, &noList);
  expectUInt(u64.from(t0), 0u64, "the first target is number 0");
  expectUInt(u64.from(small.entryCount()), 2u64, "two vertices moved: two entries");
  expectUInt(u64.from(*small.vertex[0]), 5u64, "ascending: vertex 5 first");
  expectUInt(u64.from(*small.vertex[1]), 100u64, "then vertex 100");
  expectFloat(f64.from(*small.maxMove[0]), 1d, 1e-7d, "the largest move of the target");
  expectUInt(u64.from(small.find(0usize, 100usize) as u64), 1u64, "'find' finds vertex 100 at entry 1");
  expect(small.find(0usize, 6usize) < 0i64, "and no entry for vertex 6");
  // The same by indices, given out of order with one repeated, and one past the mesh
  var idx = List[u32].empty();
  idx.push(100u32);
  idx.push(5u32);
  idx.push(100u32);
  idx.push(99999u32);
  var dp = List[Vec3].empty();
  dp.push(new Vec3(0., 3., 0.));
  dp.push(new Vec3(0., 1., 0.));
  dp.push(new Vec3(0., 1., 0.));
  dp.push(new Vec3(9., 9., 9.));
  let t1 = small.addSparse(&idx, &dp, &noList, &noList);
  expectUInt(u64.from(t1), 1u64, "the second target is number 1");
  expectUInt(u64.from(small.targetEntries(1usize)), 2u64, "sparse by indices: the same two entries");
  expectFloat(f64.from(small.dPos[usize.from(small.find(1usize, 100usize))].y), 1d, 1e-7d, "an index given twice keeps the last");

  // 2. The sum
  var w = zeros();
  w.set(0usize, 0.5);
  let base0 = *m.positions[0];
  let got0 = targets.position(0usize, base0, &w);
  expectFloat(f64.from(got0.x), 0.105d, 1e-6d, "swell at 0.5: vertex 0 at x = 0.105");
  expectFloat(f64.from(got0.y), 0d, 1e-7d, "y unchanged");
  // a vertex stretch does not reach
  let got1 = targets.position(0usize, base0, &zeros());
  expectFloat(f64.from(got1.x), 0.08d, 1e-7d, "weights zero: as modelled");
  var ws = zeros();
  ws.set(1usize, 2.);
  let top = 20usize * SIDES;
  let gotTop = targets.position(top, *m.positions[top], &ws);
  expectFloat(f64.from(gotTop.y), f64.from(m.positions[top].y) + 0.6d, 1e-6d, "stretch at weight 2: 0.6 up (weights are not limited to 0 to 1)");
  let gotLow = targets.position(0usize, base0, &ws);
  expectFloat(f64.from(gotLow.y), 0d, 1e-7d, "a vertex stretch does not reach stays");
  // a normal: (1, 0, 0) + 0.5 x stretch's (0, 0.4, 0), unit length
  var wn = zeros();
  wn.set(1usize, 0.5);
  let nn = targets.normal(top, *m.normals[top], &wn);
  let want = new Vec3(m.normals[top].x, 0.2, m.normals[top].z).normalize();
  expectFloat(f64.from(nn.distance(want)), 0d, 1e-6d, "a morphed normal is made unit length");
  let nl = targets.normal(0usize, *m.normals[0], &wn);
  expectFloat(f64.from(nl.distance(*m.normals[0])), 0d, 1e-9d, "a normal no weight reaches is exactly as modelled");
  var short = List[f32].empty();
  short.push(0.5);
  expectFloat(f64.from(targets.position(0usize, base0, &short).x), 0.105d, 1e-6d, "a list shorter than the targets: the rest are zero");

  // 3. The mixer
  var mixer = MorphMixer.make(8usize);
  let jaw = mixer.addChannel();
  let smile = mixer.addChannel();
  let blink = mixer.addChannel();
  mixer.drive(jaw, 0usize, 1.);
  mixer.drive(smile, 1usize, 1.);
  mixer.drive(smile, 2usize, 0.5);       // a smile also tugs the cheek target at half
  mixer.drive(blink, 3usize, 1.);
  mixer.drive(jaw, 3usize, -0.25);       // and an open jaw eases the blink target back a quarter
  mixer.corrective(jaw, smile, 4usize);  // target 4 fixes the smile with the jaw wide open
  mixer.set(jaw, 0.8);
  mixer.set(smile, 0.5);
  mixer.set(blink, 1.);
  var out = List[f32].empty();
  mixer.resolve(&mut out);
  expectUInt(u64.from(out.len()), 8u64, "the mixer fills a weight for each target");
  expectFloat(f64.from(*out[0]), 0.8d, 1e-6d, "jaw drives target 0");
  expectFloat(f64.from(*out[1]), 0.5d, 1e-6d, "smile drives target 1");
  expectFloat(f64.from(*out[2]), 0.25d, 1e-6d, "and half of target 2");
  expectFloat(f64.from(*out[3]), 0.8d, 1e-6d, "blink 1 less a quarter of the jaw: 1 - 0.2 (additive, from two channels)");
  expectFloat(f64.from(*out[4]), 0.4d, 1e-6d, "the corrective is jaw x smile: 0.8 x 0.5");
  expectFloat(f64.from(*out[5]), 0d, 1e-9d, "others stay zero");
  mixer.set(jaw, 0.);
  mixer.resolve(&mut out);
  expectFloat(f64.from(*out[4]), 0d, 1e-9d, "the corrective is off when the jaw is shut");
  mixer.set(blink, 5.);
  mixer.resolve(&mut out);
  expectFloat(f64.from(*out[3]), 5d, 1e-6d, "no clamp by default: a weight may exceed 1");
  mixer.clampTo(0., 1.);
  mixer.resolve(&mut out);
  expectFloat(f64.from(*out[3]), 1d, 1e-6d, "clamped when asked");
}

// ---- The GPU ----

// Copy the first 'count' floats of 'buffer' back
fn readFloats(device &mut Device, buffer &Buffer, count usize) List[f32] {
  var back = device.createBuffer(u64.from(count) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var encoder = device.createCommandEncoder();
  encoder.copyBufferToBuffer(buffer, 0u64, &back, 0u64, u64.from(count) * 4u64);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  let p = back.mappedRange() as *f32;
  var out = List[f32].withCapacity(count);
  var i = 0usize;
  while i < count {
    out.push(*(p + i));
    i = i + 1usize;
  }
  out
}

// A morphed copy made, its copying of the base's streams submitted and done
fn makeCopy(device &mut Device, morpher &mut Morpher, renderer &mut Renderer, base MeshHandle, set MorphSetHandle,
    keepPrevious bool) MorphHandle {
  var encoder = device.createCommandEncoder();
  let copy = morpher.addCopy(device, &mut encoder, renderer, base, set, keepPrevious);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  copy
}

// A frame's pre-pass: the copies' work recorded and run
fn runUpdate(device &mut Device, morpher &mut Morpher, renderer &Renderer) u32 {
  var encoder = device.createCommandEncoder();
  let n = morpher.update(device, &mut encoder, renderer);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  n
}

// The positions buffer of the mesh 'h' the renderer holds
fn positionsOf(renderer &Renderer, h MeshHandle) &Buffer { &renderer.meshes[h.slot].current().positions }
fn normalsOf(renderer &Renderer, h MeshHandle) &Buffer { &renderer.meshes[h.slot].current().normals }

// The largest difference between two lists of floats
fn worstDifference(a &List[f32], b &List[f32]) f32 {
  var worst f32 = 0.;
  var i = 0usize;
  while i < a.len() and i < b.len() {
    let d = absf(*a[i] - *b[i]);
    if d > worst { worst = d; }
    i = i + 1usize;
  }
  worst
}

// Whether two lists hold the same bits
fn sameBits(a &List[f32], b &List[f32]) bool {
  if a.len() != b.len() { return false; }
  var i = 0usize;
  while i < a.len() {
    if (*a[i] as u32) != (*b[i] as u32) { return false; }
    i = i + 1usize;
  }
  true
}

fn flat3(points &List[Vec3]) List[f32] {
  var out = List[f32].empty();
  var i = 0usize;
  while i < points.len() {
    out.push(points[i].x);
    out.push(points[i].y);
    out.push(points[i].z);
    i = i + 1usize;
  }
  out
}

// The two bones' skinning matrices with bone 1 turned 'angle' about +z at the joint
fn bent(angle f32) Array[Mat4, 2] {
  let bind1 = Mat4.fromTranslation(new Vec3(0., 0.5, 0.));
  let posed1 = Mat4.fromTrs(new Vec3(0., 0.5, 0.), Quat.angleAxis(angle, new Vec3(0., 0., 1.)), new Vec3(1., 1., 1.));
  [Mat4.identity(), skinningMatrix(posed1, bind1)]
}

// Channel 'c' of pixel ('x', 'y') of a 64 x 64 rgba8 image at 'p'
fn px(p *u8, x usize, y usize, c usize) i64 { i64.from(*(p + (y * 64usize + x) * 4usize + c)) }

fn covered(p *u8, viewProjection Mat4, w Vec3) bool {
  let ndc = viewProjection.projectPoint(w);
  let fx = (ndc.x + 1.) * 0.5 * 64.;
  let fy = (1. - ndc.y) * 0.5 * 64.;
  if fx < 0. or fy < 0. or fx >= 64. or fy >= 64. { return false; }
  let x = usize.from(fx);
  let y = usize.from(fy);
  px(p, x, y, 0usize) > px(p, x, y, 2usize)
}

fn drawFrame(renderer &mut Renderer, device &mut Device, morpher &mut Morpher, color &Texture, depth &Texture,
    readback &Buffer, camera &Camera, light &Light, list &DrawList) {
  var encoder = device.createCommandEncoder();
  morpher.update(device, &mut encoder, renderer);
  renderer.render(device, &mut encoder, color, depth, camera, light, list);
  encoder.copyTextureToBuffer(color, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn bytesOfList[T](list &List[T]) *u8 {
  let v = list.view();
  &v[0] as *u8
}

// 6. The compute twin carrying the pre-pass's output by the bones
fn skinTwin(device &mut Device, morphed &Buffer, skin &Skin, pose &Array[Mat4, 2], count usize) List[f32] {
  let n = u32.from(count);
  let storage = BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST;
  var joints = device.createBuffer(u64.from(n) * 4u64, storage);
  var weights = device.createBuffer(u64.from(n) * 4u64, storage);
  var bones = device.createBuffer(2u64 * BONE_BYTES, storage);
  var out = device.createBuffer(u64.from(n) * 12u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_SRC);
  device.queue.writeBuffer(&joints, 0u64, bytesOfList[u32](&skin.joints), u64.from(n) * 4u64);
  device.queue.writeBuffer(&weights, 0u64, bytesOfList[u32](&skin.weights), u64.from(n) * 4u64);
  var rows = List[f32].empty();
  var b = 0usize;
  while b < 2usize {
    let r = boneRows(pose[b]);
    var e = 0usize;
    while e < BONE_FLOATS {
      rows.push(r[e]);
      e = e + 1usize;
    }
    b = b + 1usize;
  }
  device.queue.writeBuffer(&bones, 0u64, bytesOfList[f32](&rows), 2u64 * BONE_BYTES);
  let entries = [
    new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
    new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
    new BindGroupLayoutEntry(binding: 6u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
    new BindGroupLayoutEntry(binding: 7u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
    new BindGroupLayoutEntry(binding: 8u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE)];
  var groupLayout = device.createBindGroupLayout(&entries);
  let groupLayouts = [&groupLayout];
  var layout = device.createPipelineLayout(&groupLayouts, 4u32);
  var shader = device.createShaderModule(&MORPHSKIN_SPIRV);
  let desc = new ComputePipelineDescriptor(layout: &layout, module: &shader, entryPoint: "skinMorphed");
  var pipeline = device.createComputePipeline(&desc);
  require(pipeline.isValid(), "the compute twin's pipeline");
  let groupEntries = [BindGroupEntry.buffer(4u32, morphed), BindGroupEntry.buffer(5u32, &joints),
    BindGroupEntry.buffer(6u32, &weights), BindGroupEntry.buffer(7u32, &bones), BindGroupEntry.buffer(8u32, &out)];
  var group = device.createBindGroup(&groupLayout, &groupEntries);
  var encoder = device.createCommandEncoder();
  {
    var pass = encoder.beginComputePass();
    pass.setPipeline(&pipeline);
    pass.setBindGroup(0u32, &group);
    let immediates Array[u32, 1] = [n];
    pass.setImmediates(0u32, &immediates as *u8, 4u32);
    pass.dispatchWorkgroups((n + 63u32) / 64u32);
    pass.end();
  }
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  readFloats(device, &out, count * 3usize)
}

// 8. The shadow of a morphed cube
struct Shadowing {
  ground MeshHandle;
  lit MaterialHandle;
  pbr MaterialHandle;
}

const SIDE = 256u32;
const SIDEZ = 256usize;
const HEIGHT = 12.;
const HALF_VIEW = 4.3676;

fn sunFrom(elevation f32, azimuth f32, intensity f32, ambient f32) Light {
  let c = cos(elevation);
  let toSun = new Vec3(c * cos(azimuth), sin(elevation), c * sin(azimuth));
  Light.directional(new Vec3(0., 0., 0.) - toSun, Color.gray(intensity), Color.gray(ambient))
}

fn topDown() Camera {
  var camera = Camera.make();
  camera.fov = radians(40.);
  camera.near = 0.1;
  camera.far = 100.;
  camera.lookAt(new Vec3(0., HEIGHT, 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., -1.));
  camera.background = new Color(0., 0., 0., 1.);
  camera
}

fn px256(p *u8, x usize, y usize) f32 { f32.from(*(p + (y * SIDEZ + x) * 4usize)) }
fn columnOf(x f32) usize { usize.from(128. + x / HALF_VIEW * 128.) }
fn rowOf(z f32) usize { usize.from(128. + z / HALF_VIEW * 128.) }

fn shadowTest(device &mut Device, renderer &mut Renderer, morpher &mut Morpher, material MaterialHandle, label &Array[u8]) {
  let targetDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var color = device.createTexture(&targetDesc);
  let depthDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var readback = device.createBuffer(262144u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var plane = Mesh.plane(1, 1.);
  let ground = renderer.addMesh(device, &plane);
  var cube = Mesh.cube(1.);
  let cubeHandle = renderer.addMesh(device, &cube);
  // One target: every vertex 4 along +z
  let n = cube.positions.len();
  var shift = List[Vec3].empty();
  var v = 0usize;
  while v < n {
    shift.push(new Vec3(0., 0., 4.));
    v = v + 1usize;
  }
  var targets = MorphTargets.empty(n);
  let noList = List[Vec3].empty();
  targets.addDense(&shift, &noList, &noList);
  let set = morpher.addSet(device, &targets, &cube);
  require(!set.isNone(), "a set for the cube");
  let copy = makeCopy(device, morpher, renderer, cubeHandle, set, false);
  require(!copy.isNone(), "a morphed copy of the cube");
  var settings = ShadowSettings.high();
  settings.cascades = 1u32;
  settings.mapSize = 1024u32;
  settings.distance = 30.;
  renderer.setShadows(device, &settings);
  let camera = topDown();
  // The sun along (-1, -1, 0)/sqrt 2: the cube's shadow beyond its foot, x from -3 to -1
  let sun = sunFrom(radians(45.), 0., 2.5132741, 0.1);
  let p = readback.mappedRange();
  var list = DrawList.empty();
  list.add(ground, material, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(40., 1., 40.)));
  list.add(morpher.mesh(copy), material, Mat4.fromTranslation(new Vec3(0., 1., 0.)));
  // Weight 0: the shadow where the cube is modelled (z in -1 to 1), none 4 along
  drawFrame(renderer, device, morpher, &color, &depth, &readback, &camera, &sun, &list);
  let litA = px256(p, columnOf(-3.9), rowOf(-1.5));
  let shadowAtHome = px256(p, columnOf(-2.), rowOf(0.));
  let shadowAway = px256(p, columnOf(-2.), rowOf(4.));
  expect(shadowAtHome < litA * 0.5, label);
  expect(shadowAway > litA * 0.9, label);
  // Weight 1: the cube, and its shadow, 4 along
  var w = List[f32].empty();
  w.push(1.);
  morpher.setWeights(renderer, copy, &w);
  drawFrame(renderer, device, morpher, &color, &depth, &readback, &camera, &sun, &list);
  let shadowHomeAfter = px256(p, columnOf(-2.), rowOf(0.));
  let shadowAwayAfter = px256(p, columnOf(-2.), rowOf(4.));
  expect(shadowAwayAfter < litA * 0.5, label);
  expect(shadowHomeAfter > litA * 0.9, label);
  eprint <- "measured "; eprintStr(label as &str); eprint <- ": lit "; eprint <- litA; eprint <- ", shadow at home "; eprint <- shadowAtHome;
  eprint <- " then "; eprint <- shadowHomeAfter; eprint <- "; shadow 4 along "; eprint <- shadowAway; eprint <- " then "; eprint <- shadowAwayAfter; eprint <- "\n";
  morpher.removeCopy(device, renderer, copy);
  morpher.removeSet(device, set);
  renderer.removeMesh(device, cubeHandle);
  renderer.removeMesh(device, ground);
  renderer.disableShadows(device);
}

// The same under a spot or a point light at (2.2, 4, 0) with shadows, no sun and
// no ambient light: the box's shadow runs from its foot out to x = -4.2, across
// z in -2 to 2 (the lights' shadow test works it out), and at x = -3 it covers
// |z| up to 1.625. A point light does not shine in parallel, so a box moved
// 1.5 along z casts its shadow, at x = -3, over z from about 0.8 to 5 (its
// far side's top face, at 2 up, lands at twice its z; its side at x = -1, at
// 1.54 up, at 1.625 times): worked out by hand. So the ground at (-3, -1.2) is in
// shadow before the move and lit after, and (-3, 3) the other way about (the
// camera, 14 up, sees 5.0956 each way)
fn localShadowTest(device &mut Device, renderer &mut Renderer, morpher &mut Morpher, point bool, label &Array[u8]) {
  let half = 5.0956;
  let targetDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var color = device.createTexture(&targetDesc);
  let depthDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var readback = device.createBuffer(262144u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var plane = Mesh.plane(1, 1.);
  let ground = renderer.addMesh(device, &plane);
  var cube = Mesh.cube(1.);
  let cubeHandle = renderer.addMesh(device, &cube);
  let n = cube.positions.len();
  var shift = List[Vec3].empty();
  var v = 0usize;
  while v < n {
    shift.push(new Vec3(0., 0., 1.5));
    v = v + 1usize;
  }
  var targets = MorphTargets.empty(n);
  let noList = List[Vec3].empty();
  targets.addDense(&shift, &noList, &noList);
  let set = morpher.addSet(device, &targets, &cube);
  let copy = makeCopy(device, morpher, renderer, cubeHandle, set, false);
  require(!copy.isNone(), "a morphed copy of the cube");
  renderer.environmentStrength = 0.;
  renderer.lights.clear();
  let at = new Vec3(2.2, 4., 0.);
  let h = if point {
    renderer.lights.addPoint(at, Color.gray(1.), 120., 20.)
  } else {
    renderer.lights.addSpot(at, new Vec3(-4.2, -4., 0.), Color.gray(1.), 120., 20., radians(40.), radians(50.))
  };
  renderer.lights.setCastsShadow(h, true);
  let settings = LightShadowSettings.medium();
  renderer.setLightShadows(device, &settings);
  var camera = Camera.make();
  camera.fov = radians(40.);
  camera.near = 0.1;
  camera.far = 100.;
  camera.lookAt(new Vec3(0., 14., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., -1.));
  camera.background = new Color(0., 0., 0., 1.);
  let none = Light.directional(new Vec3(0., -1., 0.), Color.gray(0.), Color.gray(0.));
  let p = readback.mappedRange();
  var list = DrawList.empty();
  let litM = renderer.addMaterial(device, &Material.plain(new Color(0.8, 0.8, 0.8, 1.)));
  list.add(ground, litM, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(40., 1., 40.)));
  list.add(morpher.mesh(copy), litM, Mat4.fromTranslation(new Vec3(0., 1., 0.)));
  drawFrame(renderer, device, morpher, &color, &depth, &readback, &camera, &none, &list);
  let col = usize.from(128. + -3.0 / half * 128.);
  let homeBefore = px256(p, col, rowOf2(-1.2, half));
  let awayBefore = px256(p, col, rowOf2(3., half));
  expect(homeBefore < 8., label);
  expect(awayBefore > 25., label);
  var w = List[f32].empty();
  w.push(1.);
  morpher.setWeights(renderer, copy, &w);
  drawFrame(renderer, device, morpher, &color, &depth, &readback, &camera, &none, &list);
  let homeAfter = px256(p, col, rowOf2(-1.2, half));
  let awayAfter = px256(p, col, rowOf2(3., half));
  expect(awayAfter < 8., label);
  expect(homeAfter > 25., label);
  eprint <- "measured "; eprintStr(label as &str); eprint <- ": at (-3, -1.2) "; eprint <- homeBefore; eprint <- " then "; eprint <- homeAfter;
  eprint <- "; at (-3, 3) "; eprint <- awayBefore; eprint <- " then "; eprint <- awayAfter; eprint <- "\n";
  renderer.lights.clear();
  renderer.setLightShadows(device, &LightShadowSettings.off());
  morpher.removeCopy(device, renderer, copy);
  morpher.removeSet(device, set);
  renderer.removeMesh(device, cubeHandle);
  renderer.removeMesh(device, ground);
  renderer.environmentStrength = 1.;
}

fn rowOf2(z f32, half f32) usize { usize.from(128. + z / half * 128.) }

fn main() i32 {
  var skin = Skin.empty();
  let m = tube(&mut skin);
  let n = m.positions.len();
  cpuChecks(&m);

  var instance = Instance.create("render morph");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  var device = adapter.requestDevice();
  require(device.isValid(), "a device");
  eprint <- "measured adapter: "; eprintStr(adapter.name.view()); eprint <- "\n";
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  require(renderer.isValid(), "a renderer");
  var morpher = Morpher.create(&mut device);
  require(morpher.isValid(), "a morpher");

  let targets = makeTargets(&m);
  let set = morpher.addSet(&mut device, &targets, &m);
  require(!set.isNone(), "the targets uploaded");
  let base = renderer.addSkinnedMesh(&mut device, &m, &skin);
  let copy = makeCopy(&mut device, &mut morpher, &mut renderer, base, set, true);
  require(!copy.isNone(), "a morphed copy");
  let cm = morpher.mesh(copy);
  expect(renderer.hasMesh(cm), "the copy is a mesh of the renderer's");
  expect(renderer.isSkinned(cm), "of a skinned mesh, skinned too");
  expectUInt(u64.from(morpher.targetCount(copy)), 64u64, "with weights for 64 targets");

  // ---- 5. Zero weights ----
  let baseP = readFloats(&mut device, positionsOf(&renderer, base), n * 3usize);
  let baseN = readFloats(&mut device, normalsOf(&renderer, base), n * 3usize);
  expect(sameBits(&baseP, &readFloats(&mut device, positionsOf(&renderer, cm), n * 3usize)),
    "a new copy's positions are the base's, byte for byte");
  expect(sameBits(&baseN, &readFloats(&mut device, normalsOf(&renderer, cm), n * 3usize)), "and its normals");
  expectUInt(u64.from(runUpdate(&mut device, &mut morpher, &renderer)), 0u64, "nothing to record for a copy no weight was set on");

  // ---- 4. Exactly weight x delta ----
  var w = zeros();
  w.set(0usize, 0.5);
  morpher.setWeights(&mut renderer, copy, &w);
  expectUInt(u64.from(morpher.activeCount(copy)), 1u64, "one active target");
  expectUInt(u64.from(runUpdate(&mut device, &mut morpher, &renderer)), 1u64, "a changed weight: one copy recomputed");
  let swelled = readFloats(&mut device, positionsOf(&renderer, cm), n * 3usize);
  expectFloat(f64.from(*swelled[0]), 0.105d, 1e-6d, "vertex 0 displaced by 0.5 x 0.05: x = 0.105");
  expectFloat(f64.from(*swelled[1]), 0d, 1e-7d, "y");
  expectFloat(f64.from(*swelled[2]), 0d, 1e-7d, "z");
  expectFloat(f64.from(*swelled[4usize * 3usize + 2usize]), 0.105d, 1e-6d, "vertex 4 (a quarter round): z = 0.105");
  expectUInt(u64.from(runUpdate(&mut device, &mut morpher, &renderer)), 0u64, "the same weights again: nothing recorded");
  morpher.setWeights(&mut renderer, copy, &w);
  expectUInt(u64.from(runUpdate(&mut device, &mut morpher, &renderer)), 0u64, "set to the same values: nothing recorded");

  // Eight active of 64, some negative and some above 1
  var w8 = zeros();
  w8.set(0usize, 0.5);
  w8.set(1usize, -0.3);
  w8.set(5usize, 1.7);
  w8.set(9usize, 0.25);
  w8.set(17usize, 0.9);
  w8.set(33usize, -1.2);
  w8.set(48usize, 0.6);
  w8.set(63usize, 0.4);
  morpher.setWeights(&mut renderer, copy, &w8);
  expectUInt(u64.from(morpher.activeCount(copy)), 8u64, "eight active targets");
  runUpdate(&mut device, &mut morpher, &renderer);
  let gotP = readFloats(&mut device, positionsOf(&renderer, cm), n * 3usize);
  let gotN = readFloats(&mut device, normalsOf(&renderer, cm), n * 3usize);
  var wantPoints = List[Vec3].empty();
  var wantNormals = List[Vec3].empty();
  var v = 0usize;
  while v < n {
    wantPoints.push(targets.position(v, *m.positions[v], &w8));
    wantNormals.push(targets.normal(v, *m.normals[v], &w8));
    v = v + 1usize;
  }
  let wantP = flat3(&wantPoints);
  let wantN = flat3(&wantNormals);
  expectFloat(f64.from(worstDifference(&gotP, &wantP)), 0d, 1e-6d, "every position of 64 targets, 8 active: the CPU's sum within 1e-6");
  expectFloat(f64.from(worstDifference(&gotN, &wantN)), 0d, 1e-6d, "every normal likewise");
  expect(worstDifference(&gotP, &baseP) > 0.05, "and the shape did move (by more than 5 cm somewhere)");
  var touchedUnit = true;
  v = 0usize;
  while v < n {
    let len = new Vec3(*gotN[v * 3usize], *gotN[v * 3usize + 1usize], *gotN[v * 3usize + 2usize]).length();
    if absf(len - 1.) > 1e-5 { touchedUnit = false; }
    v = v + 1usize;
  }
  expect(touchedUnit, "the normals are unit length");

  // The previous frame's positions, for a velocity pass: after this update, last frame's were the swelled ones
  let previous = readFloats(&mut device, morpher.previousPositions(copy), n * 3usize);
  expect(sameBits(&previous, &swelled), "the previous positions are the frame before's (the swelled shape)");
  runUpdate(&mut device, &mut morpher, &renderer);
  let previous2 = readFloats(&mut device, morpher.previousPositions(copy), n * 3usize);
  expect(sameBits(&previous2, &gotP), "and once nothing changes they catch up: no motion");

  // Back to zero: byte for byte the base
  morpher.setWeights(&mut renderer, copy, &zeros());
  expectUInt(u64.from(morpher.activeCount(copy)), 0u64, "no active targets");
  runUpdate(&mut device, &mut morpher, &renderer);
  expect(sameBits(&baseP, &readFloats(&mut device, positionsOf(&renderer, cm), n * 3usize)),
    "all weights set back to zero: positions byte for byte the unmorphed mesh's");
  expect(sameBits(&baseN, &readFloats(&mut device, normalsOf(&renderer, cm), n * 3usize)), "and normals");

  // ---- 9. Bounds ----
  var c0 = new Vec3(0., 0., 0.);
  var r0 f32 = 0.;
  renderer.meshBounds(cm, &mut c0, &mut r0);
  var cb = new Vec3(0., 0., 0.);
  var rb f32 = 0.;
  renderer.meshBounds(base, &mut cb, &mut rb);
  expectFloat(f64.from(r0), f64.from(rb), 1e-7d, "weights zero: the copy's sphere is the base's");
  var ws = zeros();
  ws.set(1usize, -2.);
  ws.set(0usize, 1.);
  morpher.setWeights(&mut renderer, copy, &ws);
  renderer.meshBounds(cm, &mut c0, &mut r0);
  expectFloat(f64.from(r0), f64.from(rb) + 2d * 0.3d + 0.05d, 1e-5d, "the sphere grows by the sum of |weight| x the target's largest move");
  morpher.setWeights(&mut renderer, copy, &zeros());
  runUpdate(&mut device, &mut morpher, &renderer);

  // ---- 6. Morph first, then skin ----
  var wm = zeros();
  wm.set(1usize, 1.);
  morpher.setWeights(&mut renderer, copy, &wm);
  runUpdate(&mut device, &mut morpher, &renderer);
  let bend = bent(radians(90.));
  let twin = skinTwin(&mut device, positionsOf(&renderer, cm), &skin, &bend, n);
  var worstOrder f32 = 0.;
  var worstWrong f32 = 0.;
  v = 0usize;
  while v < n {
    let morphedCpu = targets.position(v, *m.positions[v], &wm);
    let wantSkinned = skin.skinPoint(v, &bend, morphedCpu);
    let gotSkinned = new Vec3(*twin[v * 3usize], *twin[v * 3usize + 1usize], *twin[v * 3usize + 2usize]);
    let d = gotSkinned.distance(wantSkinned);
    if d > worstOrder { worstOrder = d; }
    // the other order: skinned as modelled, then displaced by the target's delta
    let wrong = skin.skinPoint(v, &bend, *m.positions[v]) + (morphedCpu - *m.positions[v]);
    let dw = wrong.distance(wantSkinned);
    if dw > worstWrong { worstWrong = dw; }
    v = v + 1usize;
  }
  expectFloat(f64.from(worstOrder), 0d, 1e-5d, "morph on the GPU, then the bones on the GPU: where the CPU's morph then skin puts every vertex");
  expect(worstWrong > 0.3, "and skin-then-morph would put the top 0.3 or more elsewhere");

  // ---- 7. Drawn ----
  let target = new TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var color = device.createTexture(&target);
  let depthDesc = new TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var readback = device.createBuffer(16384u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  let p = readback.mappedRange();
  var camera = Camera.make();
  camera.projection = Orthogonal;
  camera.viewHeight = 1.;
  camera.lookAt(new Vec3(0., 0.5, 3.), new Vec3(0., 0.5, 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.2, 0.4, 0.6, 1.);
  let viewProjection = camera.projectionMatrix(1.) * camera.viewMatrix();
  let headOn = Light.directional(new Vec3(0., 0., -1.), Color.gray(1.8849556), Color.gray(0.2));
  let redMaterial = Material.plain(new Color(1., 0., 0., 1.));
  let red = renderer.addMaterial(&mut device, &redMaterial);
  let shiny = PbrMaterial.standard(new Color(1., 0., 0., 1.), 0., 0.5);
  let pbr = renderer.addPbrMaterial(&mut device, &shiny);
  renderer.environmentStrength = 0.;
  var list = DrawList.empty();
  var pass = 0u32;
  while pass < 2u32 {
    let material = if pass == 0u32 { red } else { pbr };
    list.clear();
    list.addSkinned(cm, material, Mat4.identity(), &bend);
    drawFrame(&mut renderer, &mut device, &mut morpher, &color, &depth, &readback, &camera, &headOn, &list);
    expectUInt(u64.from(renderer.drawCalls), 1u64, "the morphed, skinned copy: one draw");
    // The ring centres, morphed then skinned, are on the tube
    var misses = 0u32;
    var r = 1usize;
    while r + 1usize < RINGS {
      let centre = new Vec3(0., f32.from(r) * 0.05, 0.);
      let morphed = targets.position(r * SIDES, centre, &wm);
      if !covered(p, viewProjection, skin.skinPoint(r * SIDES, &bend, morphed)) { misses = misses + 1u32; }
      r = r + 1usize;
    }
    expectUInt(u64.from(misses), 0u64, "every ring's centre, morphed and then skinned on the CPU, is drawn on the tube");
    // Ring 19 (y = 0.95) stretched to y = 1.25 reaches x = -0.75 along the arm; skin-then-morph would put it at (-0.45, 0.8)
    expect(covered(p, viewProjection, new Vec3(-0.75, 0.5, 0.)), "the arm reaches 0.75 along -x: morph, then skin");
    expect(!covered(p, viewProjection, new Vec3(-0.45, 0.8, 0.)), "and not up at (-0.45, 0.8), where skin-then-morph would have it");
    pass = pass + 1u32;
  }
  // All weights zero: the pixels of the base mesh
  list.clear();
  list.addSkinned(base, red, Mat4.identity(), &bend);
  drawFrame(&mut renderer, &mut device, &mut morpher, &color, &depth, &readback, &camera, &headOn, &list);
  var baseShot = List[u8].empty();
  var i = 0usize;
  while i < 16384usize {
    baseShot.push(*(p + i));
    i = i + 1usize;
  }
  morpher.setWeights(&mut renderer, copy, &zeros());
  list.clear();
  list.addSkinned(cm, red, Mat4.identity(), &bend);
  drawFrame(&mut renderer, &mut device, &mut morpher, &color, &depth, &readback, &camera, &headOn, &list);
  var same = true;
  i = 0usize;
  while i < 16384usize {
    if *(p + i) != *baseShot[i] { same = false; }
    i = i + 1usize;
  }
  expect(same, "a copy with every weight zero draws the very pixels the base mesh does");

  // ---- 8. Shadows ----
  shadowTest(&mut device, &mut renderer, &mut morpher, renderer.addMaterial(&mut device, &Material.plain(new Color(0.5, 0.5, 0.5, 1.))),
    "a morphed cube's shadow moves with it (lit)");
  let greyPbr = PbrMaterial.standard(new Color(0.5, 0.5, 0.5, 1.), 0., 1.);
  shadowTest(&mut device, &mut renderer, &mut morpher, renderer.addPbrMaterial(&mut device, &greyPbr),
    "a morphed cube's shadow moves with it (physically based)");

  localShadowTest(&mut device, &mut renderer, &mut morpher, false, "a morphed cube's shadow moves with it (spot light)");
  localShadowTest(&mut device, &mut renderer, &mut morpher, true, "a morphed cube's shadow moves with it (point light)");

  // ---- Removing a copy ----
  expect(morpher.removeCopy(&mut device, &mut renderer, copy), "the copy removed");
  expect(!renderer.hasMesh(cm), "its mesh leaves the renderer");
  expect(renderer.hasMesh(base), "the base stays");
  expect(!morpher.removeCopy(&mut device, &mut renderer, copy), "removing it again does nothing");
  list.clear();
  list.addSkinned(base, red, Mat4.identity(), &bend);
  drawFrame(&mut renderer, &mut device, &mut morpher, &color, &depth, &readback, &camera, &headOn, &list);
  expectUInt(u64.from(renderer.drawCalls), 1u64, "and the base still draws");
  expect(covered(p, viewProjection, new Vec3(-0.35, 0.5, 0.)), "its arm bent as before");

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done()
}

