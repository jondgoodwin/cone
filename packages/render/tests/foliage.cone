// The render package's foliage shading on a real GPU with no window: a leaf
// (a square of mesh, facing the camera at (0, 0, 3), a red base colour) drawn
// into a Post's half-float frame (64 x 64), tone-mapped into an rgba8unorm
// texture, read back and checked. Only a failure prints.
//
// 1. Backlit translucency: with the sun behind the leaf, a material with
//    transmission is much brighter than one without, and redder (its own
//    colour); with the sun in front of it, transmission adds only the
//    sky's light through the leaf, far less than the sun's.
// 2. Flutter: a leaf whose mesh has colors (the offset of each vertex from
//    its pivot, the leaf's phase) and a material with flutter draws a
//    different picture a quarter second later; the same mesh with flutter 0
//    draws the same picture; a mesh with no colors, with flutter on, is not
//    moved (it has no stream to read).
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll; with the Vulkan SDK,
// validation and synchronization validation are on, and must say nothing.

mod foliage;

import testing use *;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;

fn px(p *u8, x usize, y usize, c usize) i64 { i64.from(*(p + (y * 64usize + x) * 4usize + c)); }

fn luma(p *u8) i64 {
  px(p, 32usize, 32usize, 0usize) + px(p, 32usize, 32usize, 1usize) + px(p, 32usize, 32usize, 2usize);
}

// A copy of the 64 x 64 rgba8 image at 'p'
fn snapshot(p *u8) List[u8] {
  mut out = List[u8].withCapacity(16384usize);
  mut i = 0usize;
  while i < 16384usize {
    out.push(*(p + i));
    i = i + 1usize;
  }
  out;
}

// How many bytes differ between the image at 'p' and 'before'
fn differing(p *u8, before &List[u8]) usize {
  mut n = 0usize;
  mut i = 0usize;
  while i < 16384usize {
    if *(p + i) != *before[i] { n = n + 1usize; }
    i = i + 1usize;
  }
  n;
}

fn drawFrame(renderer &mut Renderer, post &mut Post, device &mut Device, color &Texture, depth &Texture,
    readback &Buffer, camera &Camera, light &Light, list &DrawList) {
  mut encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, &post.hdr, depth, camera, light, list);
  post.apply(&mut encoder, color);
  encoder.copyTextureToBuffer(color, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

// A leaf: a square one metre across facing +z, pivoting on its bottom edge's
// middle. With 'sway', its colors hold each vertex's offset from the pivot
// and a phase of 0.3.
fn leaf(sway bool) Mesh {
  mut m = Mesh.empty();
  imm corners = [new Vec3(-0.5, -0.5, 0.), new Vec3(0.5, -0.5, 0.), new Vec3(0.5, 0.5, 0.), new Vec3(-0.5, 0.5, 0.)];
  mut i = 0usize;
  while i < 4usize {
    imm c = corners[i];
    m.positions.push(c);
    m.normals.push(new Vec3(0., 0., 1.));
    m.uvs.push(new Vec2(0., 0.));
    if sway { m.colors.push(new Color(c.x, c.y + 0.5, 0., 0.3)); }
    i = i + 1usize;
  }
  m.indices.push(0u32); m.indices.push(1u32); m.indices.push(2u32);
  m.indices.push(0u32); m.indices.push(2u32); m.indices.push(3u32);
  m;
}

fn main() i32 {
  mut instance = Instance.create("foliage");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");

  imm target = new TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut color = device.createTexture(&target);
  imm depthDesc = new TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  mut depth = device.createTexture(&depthDesc);
  mut readback = device.createBuffer(16384u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm p = readback.mappedRange();
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, 64u32, 64u32);
  require(renderer.isValid() and post.isValid(), "a renderer and its post-processing");
  post.bloom = 0.;
  post.toneMapper = TONE_MAP_NONE;

  mut camera = Camera.make();
  camera.fov = radians(40.);
  camera.lookAt(new Vec3(0., 0., 3.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0., 0., 0., 1.);
  // The light's direction is the way it travels: towards the camera, the sun
  // behind the leaf; and away from it, the sun in front
  imm behind = Light.directional(new Vec3(0., -0.2, 0.9797959), Color.gray(1.), Color.gray(0.));
  imm front = Light.directional(new Vec3(0., -0.2, -0.9797959), Color.gray(1.), Color.gray(0.));
  mut list = DrawList.empty();

  // ---- 1. Backlit translucency ----
  imm red = new Color(0.8, 0.1, 0.05, 1.);
  imm plainLeaf = PbrMaterial.standard(red, 0., 0.7);
  mut glowLeaf = PbrMaterial.standard(red, 0., 0.7);
  glowLeaf.transmission = 1.5;
  imm plainM = renderer.addPbrMaterial(&mut device, &plainLeaf);
  imm glowM = renderer.addPbrMaterial(&mut device, &glowLeaf);
  imm flat = leaf(false);
  imm flatMesh = renderer.addMesh(&mut device, &flat);

  list.add(flatMesh, plainM, Mat4.identity());
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &behind, &list);
  imm backPlain = luma(p);
  list.clear();
  list.add(flatMesh, glowM, Mat4.identity());
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &behind, &list);
  imm backGlow = luma(p);
  expectBool(backGlow > backPlain + 60, true, "the sun behind the leaf: transmission lights it");
  expectBool(px(p, 32usize, 32usize, 0usize) > 2i64 * px(p, 32usize, 32usize, 1usize), true, "in the leaf's own colour, red");
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &front, &list);
  imm frontGlow = luma(p);
  list.clear();
  list.add(flatMesh, plainM, Mat4.identity());
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &front, &list);
  imm frontPlain = luma(p);
  expectBool(frontGlow - frontPlain < (backGlow - backPlain) / 3, true, "the sun in front: transmission adds little");

  // ---- 2. Flutter ----
  mut flutterLeaf = PbrMaterial.standard(red, 0., 0.7);
  flutterLeaf.flutter = 0.4;
  imm flutterM = renderer.addPbrMaterial(&mut device, &flutterLeaf);
  imm swaying = leaf(true);
  imm swayMesh = renderer.addMesh(&mut device, &swaying);
  list.clear();
  list.add(swayMesh, flutterM, Mat4.identity());
  renderer.time = 0.;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &front, &list);
  imm before = snapshot(p);
  renderer.time = 0.25;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &front, &list);
  expectBool(differing(p, &before) > 40usize, true, "a fluttering leaf, drawn differently a quarter second on");

  list.clear();
  list.add(swayMesh, plainM, Mat4.identity());
  renderer.time = 0.;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &front, &list);
  imm still = snapshot(p);
  renderer.time = 0.25;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &front, &list);
  expectUInt(u64.from(differing(p, &still)), 0u64, "flutter 0: the same picture");

  list.clear();
  list.add(flatMesh, flutterM, Mat4.identity());
  renderer.time = 0.;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &front, &list);
  imm bare = snapshot(p);
  renderer.time = 0.25;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &front, &list);
  expectUInt(u64.from(differing(p, &bare)), 0u64, "a mesh with no leaf data is not moved");

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}
