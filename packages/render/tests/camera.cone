// The render package's Camera and Light, checked with the testing package
// against values worked out by hand. Only a failure prints, so camera.out
// holds the summary alone. Nothing here needs a GPU.
//
// - A new camera is Pegasus's: perspective, 50 degrees (held in radians),
//   0.1 to 1000, at (0, 0, 5) facing -z.
// - Its perspective into 800 by 600 (aspect 4/3), depth from 0 to 1: with
//   t = tan 25deg = 0.4663077, m[0] = 1 / (t 4/3) = 1.6083856, m[5] = 1 / t
//   = 2.1445069, m[10] = far / (near - far) = 1000 / -999.9 = -1.0001000,
//   m[11] = -1, m[14] = near far / (near - far) = 100 / -999.9 = -0.1000100.
//   A point on the near plane, (0, 0, -0.1), goes to depth m[10] (-0.1) +
//   m[14] = 0 (w = 0.1); one on the far plane to 1.
// - Its orthogonal projection of aspect 1, 10 high: m[0] = m[5] = 2 / 20 =
//   0.1, m[10] = 1 / (near - far) = -0.0010001, m[14] = near / (near - far) =
//   -0.00010001, m[15] = 1.
// - Its view at (0, 0, 5) facing -z moves the world by (0, 0, -5).
// - Turned a quarter about y, a camera faces -x (its -z turned: z' = -x sin +
//   z cos gives (-1, 0, 0)), so the world point (-3, 0, 5), 3 ahead of it, is
//   (0, 0, -3) to it.
// - Following something placed at (10, 0, 0), from its eye (0, 1, 0), the
//   camera at (0, 0, 5) is at (10, 1, 5), and its view moves the world by
//   (-10, -1, -5). If that thing is also turned a quarter about y, the eye is
//   still at (10, 1, 0), the camera's (0, 0, 5) turns to (5, 0, 0), so it is
//   at (15, 1, 0), facing -x: (15, 1, 0) is its origin and (13, 1, 0) is 2
//   ahead, (0, 0, -2).
// - lookAt from (5, 0, 0) at the origin, y up: forward is -x, right is
//   forward x up = (0, 0, -1). So the origin is (0, 0, -5) to it, (0, 1, 0)
//   is (0, 1, -5), and (0, 0, -1), to its right, (1, 0, -5); its position is
//   (5, 0, 0). From (0, 0, -5), looking along +z: right is (-1, 0, 0), a
//   half turn about y (the quaternion (0, 1, 0, 0), whose matrix has a
//   negative trace, the other branch of the conversion), so (1, 0, 0) is
//   (-1, 0, -5) to it.
// - projectedSize: a sphere of radius 1 at the origin, from (0, 0, 5), into
//   600 pixels: 1 / (5 t) x 600 = 257.34130. One around the camera: 600.
//   Orthogonal, 10 high: 1 / 10 x 600 = 60.
// - Light.directional((0, -2, 0)) travels (0, -1, 0). Light.from(-3.5, 5.5,
//   10), 11.937336 from the origin, travels (0.2931975, -0.4607390,
//   -0.8377073).

mod camera;

import testing use *;
import geomath use *;
import render use *;

imm near = 0.00001d;
imm close = 0.0001d;

fn point(got Vec3, x f32, y f32, z f32, label &Array[u8]) {
  expectFloat(got.x, x, close, label);
  expectFloat(got.y, y, close, label);
  expectFloat(got.z, z, close, label);
}

fn defaults() {
  imm c = Camera.make();
  expectInt(i64.from(c.projection), i64.from(Perspective), "perspective");
  // 50 degrees is 50 pi / 180 = 0.8726646 radians
  expectFloat(c.fov, 0.8726646, near, "field of view");
  expectFloat(c.viewHeight, 10., near, "orthogonal height");
  expectFloat(c.near, 0.1, near, "near");
  expectFloat(c.far, 1000., near, "far");
  point(c.origin, 0., 0., 5., "origin");
  expectFloat(c.orientation.w, 1., near, "no turn");
  expectFloat(c.background.alpha, 1., near, "opaque black");
  expectBool(c.following, false, "following nothing");
}

fn projections() {
  mut c = Camera.make();
  imm p = c.perspective(800. / 600.);
  expectFloat(p.m[0], 1.6083856, close, "perspective m[0]");
  expectFloat(p.m[5], 2.1445069, close, "perspective m[5]");
  expectFloat(p.m[10], -1.0001000, close, "perspective m[10]");
  expectFloat(p.m[11], -1., near, "perspective m[11]");
  expectFloat(p.m[14], -0.1000100, close, "perspective m[14]");
  expectFloat(p.m[15], 0., near, "perspective m[15]");
  imm onNear = p * new Vec4(0., 0., -0.1, 1.);
  expectFloat(onNear.z / onNear.w, 0., near, "the near plane at depth 0");
  imm onFar = p * new Vec4(0., 0., -1000., 1.);
  expectFloat(onFar.z / onFar.w, 1., near, "the far plane at depth 1");
  // (A local: indexing a field of a returned struct is refused)
  imm pp = c.projectionMatrix(800. / 600.);
  expectFloat(pp.m[5], 2.1445069, close, "projection, perspective");

  imm o = c.orthogonal(1.);
  expectFloat(o.m[0], 0.1, near, "orthogonal m[0]");
  expectFloat(o.m[5], 0.1, near, "orthogonal m[5]");
  expectFloat(o.m[10], -0.0010001, near, "orthogonal m[10]");
  expectFloat(o.m[14], -0.00010001, near, "orthogonal m[14]");
  expectFloat(o.m[15], 1., near, "orthogonal m[15]");
  c.projection = Orthogonal;
  imm po = c.projectionMatrix(1.);
  expectFloat(po.m[0], 0.1, near, "projection, orthogonal");
}

fn views() {
  mut c = Camera.make();
  imm v = c.viewMatrix();
  expectFloat(v.m[0], 1., near, "view m[0]");
  expectFloat(v.m[10], 1., near, "view m[10]");
  point(new Vec3(v.m[12], v.m[13], v.m[14]), 0., 0., -5., "view's move");
  point(c.position(), 0., 0., 5., "its position");

  c.orientation = Quat.angleAxis(pi / 2., new Vec3(0., 1., 0.));
  point(c.cameraPoint(new Vec3(-3., 0., 5.), Mat4.identity()), 0., 0., -3., "3 ahead of a turned camera");
  point(c.cameraPoint(new Vec3(0., 0., 5.), Mat4.identity()), 0., 0., 0., "a turned camera's origin");
  // A point in something placed at (-3, 0, 0): its origin is the point above
  point(c.cameraPoint(new Vec3(0., 0., 5.), Mat4.identity().withTranslation(new Vec3(-3., 0., 0.))), 0., 0., -3.,
    "through a placement");

  mut f = Camera.make();
  f.following = true;
  f.followMatrix = Mat4.identity().withTranslation(new Vec3(10., 0., 0.));
  f.eye = new Vec3(0., 1., 0.);
  imm fv = f.viewMatrix();
  point(new Vec3(fv.m[12], fv.m[13], fv.m[14]), -10., -1., -5., "following's move");

  f.followMatrix = Mat4.fromTrs(new Vec3(10., 0., 0.), Quat.angleAxis(pi / 2., new Vec3(0., 1., 0.)), new Vec3(1., 1., 1.));
  point(f.cameraPoint(new Vec3(15., 1., 0.), Mat4.identity()), 0., 0., 0., "following a turned thing: origin");
  point(f.cameraPoint(new Vec3(13., 1., 0.), Mat4.identity()), 0., 0., -2., "following a turned thing: ahead");
  point(f.position(), 15., 1., 0., "following a turned thing: its position");
}

fn lookAts() {
  mut c = Camera.make();
  c.lookAt(new Vec3(5., 0., 0.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  point(c.cameraPoint(new Vec3(0., 0., 0.), Mat4.identity()), 0., 0., -5., "lookAt: the target ahead");
  point(c.cameraPoint(new Vec3(0., 1., 0.), Mat4.identity()), 0., 1., -5., "lookAt: up is up");
  point(c.cameraPoint(new Vec3(0., 0., -1.), Mat4.identity()), 1., 0., -5., "lookAt: right is right");
  point(c.position(), 5., 0., 0., "lookAt: where it is");

  c.lookAt(new Vec3(0., 0., -5.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  expectFloat(c.orientation.y, 1., close, "a half turn about y");
  expectFloat(c.orientation.w, 0., close, "a half turn about y: w");
  point(c.cameraPoint(new Vec3(0., 0., 0.), Mat4.identity()), 0., 0., -5., "turned round: the target ahead");
  point(c.cameraPoint(new Vec3(1., 0., 0.), Mat4.identity()), -1., 0., -5., "turned round: +x on its left");
}

fn sizes() {
  mut c = Camera.make();
  expectFloat(c.projectedSize(new Vec3(0., 0., 0.), 1., 600.), 257.34130, 0.001d, "a sphere 5 away");
  expectFloat(c.projectedSize(new Vec3(0., 0., 4.5), 1., 600.), 600., near, "a sphere around the camera");
  c.projection = Orthogonal;
  expectFloat(c.projectedSize(new Vec3(0., 0., 0.), 1., 600.), 60., near, "orthogonal");
}

fn lights() {
  imm d = Light.directional(new Vec3(0., -2., 0.), new Color(1., 1., 1., 1.), Color.gray(0.1));
  point(d.direction, 0., -1., 0., "a directional light's direction, made unit");
  expectFloat(d.ambient.red, 0.1, near, "its ambient");
  imm l = Light.from(new Vec3(-3.5, 5.5, 10.), new Color(0.78, 0.70, 0.55, 1.), new Color(0.52, 0.55, 0.60, 1.));
  point(l.direction, 0.2931975, -0.4607390, -0.8377073, "a light from a place, towards the origin");
  expectFloat(l.color.red, 0.78, near, "its color");
  expectFloat(l.ambient.green, 0.55, near, "its ambient");
}

fn main() i32 {
  defaults();
  projections();
  views();
  lookAts();
  sizes();
  lights();
  done();
}
