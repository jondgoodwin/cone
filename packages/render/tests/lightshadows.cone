// The render package's point and spot light shadows (lightshadow.cone,
// locallights.slang), on a real GPU with no window: scenes drawn into a 256 x
// 256 rgba8unorm target (a channel v stored as v x 255) and read back, against
// geometry worked out by hand. It needs a GPU driver with Vulkan 1.3 and
// SDL3.dll; with the Vulkan SDK, validation and synchronization validation
// are on, and must say nothing. GPU_POWER_PREFERENCE=low-power runs it on the
// integrated GPU. Only a failure prints (and a few measurements).
//
// The scene: a ground plane in y = 0 and a box (Mesh.cube 1: reaching 1 each
// way, centred 1 up, so y from 0 to 2 and x and z from -1 to 1), a light at
// (2.2, 4, 0) lit at 30 candela, no sun, no ambient light; the camera 14 above
// the ground looking straight down, up being -z (it sees 5.0956 each way of
// the middle, a pixel column u at x = (u - 128) / 128 x 5.0956). From the light
// the box's top face (y = 2) lands on the ground twice as far from the light's
// foot (4 / (4 - 2)): its corners (x, z) = (-1, +-1) and (1, +-1) at (-4.2, +-2)
// and (-0.2, +-2). So the shadow runs from the box's foot to a far edge at
// x = -4.2 across z in -2 to 2, and its sides are the lines from the foot
// corners (-1, +-1) to those: |z| = 1 + (-1 - x) / 3.2.
//  1. The spot light (aimed at (-2, 0, 0), 40 to 50 degrees): the far edge at
//     x = -4.2 along the middle row, and the sides at x = -2, -3 and -3.8
//     (|z| = 1.3125, 1.625, 1.9), each to 0.12 (a texel of the view is 0.025).
//  2. The point light, the same: its six views, the shadow crossing from the
//     -y face to the -x face where |x - 2.2| = 4 (x = -1.8): the sides at
//     x = -1.5 (-y face, |z| = 1.156), -2, -3 and -3.8 (-x face), and the far
//     edge, each to 0.12; and the picture shows no seam across x = -1.8.
//  3. No acne, no seams: a lit ground, nothing on it, drawn with the lights'
//     shadows on equals the same with them off, to 2 levels of 255, for the
//     spot, for the point light, and for a point light low and to the side (a
//     grazing angle) whose six views the ground crosses.
//  4. A light not marked to cast casts none; an item marked 'dontCastShadow'
//     casts none; shadows switched off again draw as before.
//  5. The budget: of three point lights and a spot light (their ranks worked
//     out by hand), 12 layers shadow the two best point lights and 24 all four.

mod lightshadows;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;

const SIDE = 256u32;
const SIDEZ = 256usize;
const HEIGHT = 14.f;
const HALF_VIEW = 5.0956f;

fn absf(x f32) f32 { if x < 0. { 0. - x } else { x } }
fn maxf(a f32, b f32) f32 { if a > b { a } else { b } }

fn px(p *u8, x usize, y usize) f32 { f32.from(*(p + (y * SIDEZ + x) * 4usize)) }

fn crossRow(p *u8, y usize, from usize, to usize, mid f32, falling bool) f32 {
  var x = from;
  while x < to {
    let a = px(p, x, y);
    let b = px(p, x + 1usize, y);
    if (falling && a > mid && b <= mid) || (!falling && a < mid && b >= mid) {
      return f32.from(x) + 0.5 + (a - mid) / (a - b);
    }
    x = x + 1usize;
  }
  -1.
}

fn crossColumn(p *u8, x usize, from usize, to usize, mid f32, falling bool) f32 {
  var y = from;
  while y < to {
    let a = px(p, x, y);
    let b = px(p, x, y + 1usize);
    if (falling && a > mid && b <= mid) || (!falling && a < mid && b >= mid) {
      return f32.from(y) + 0.5 + (a - mid) / (a - b);
    }
    y = y + 1usize;
  }
  -1.
}

fn columnOf(x f32) f32 { 128. + x / HALF_VIEW * 128. }
fn worldX(u f32) f32 { (u - 128.) / 128. * HALF_VIEW }
fn worldZ(v f32) f32 { (v - 128.) / 128. * HALF_VIEW }

fn drawFrame(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    camera &Camera, light &Light, list &DrawList) {
  var encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, color, depth, camera, light, list);
  encoder.copyTextureToBuffer(color, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn topDown() Camera {
  var camera = Camera.make();
  camera.fov = radians(40.);
  camera.near = 0.1;
  camera.far = 100.;
  camera.lookAt(new Vec3(0., HEIGHT, 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., -1.));
  camera.background = new Color(0., 0., 0., 1.);
  camera
}

fn dark() Light { Light.directional(new Vec3(0., -1., 0.), Color.gray(0.), Color.gray(0.)) }

fn expectNear(got f32, want f32, within f32, label &Array[u8]) {
  if !expect(absf(got - want) <= within, label) {
    eprint <- "  got "; eprint <- got; eprint <- ", want "; eprint <- want; eprint <- " (within "; eprint <- within; eprint <- ")\n";
  }
}

struct Scene {
  ground MeshHandle;
  box MeshHandle;
  lit MaterialHandle;
  pbr MaterialHandle;
}

fn makeScene(renderer &mut Renderer, device &mut Device) Scene {
  var plane = Mesh.plane(1, 1.);
  let ground = renderer.addMesh(device, &plane);
  let cube = Mesh.cube(1.);
  let box = renderer.addMesh(device, &cube);
  let litM = Material.plain(new Color(0.8, 0.8, 0.8, 1.));
  let lit = renderer.addMaterial(device, &litM);
  let pbrM = PbrMaterial.standard(new Color(0.8, 0.8, 0.8, 1.), 0., 1.);
  let pbr = renderer.addPbrMaterial(device, &pbrM);
  new Scene(ground, box, lit, pbr)
}

fn boxList(scene &Scene, material MaterialHandle, withBox bool) DrawList {
  var list = DrawList.empty();
  list.add(scene.ground, material, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(40., 1., 40.)));
  if withBox { list.add(scene.box, material, Mat4.fromTranslation(new Vec3(0., 1., 0.))); }
  list
}

// 1 and 2. The shadow's far edge and sides under one light
fn edges(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    scene &Scene, material MaterialHandle, point bool, label &Array[u8]) {
  let p = readback.mappedRange();
  renderer.environmentStrength = 0.;
  renderer.lights.clear();
  let at = new Vec3(2.2, 4., 0.);
  let h = if point {
    renderer.lights.addPoint(at, Color.gray(1.), 120., 20.)
  } else {
    renderer.lights.addSpot(at, new Vec3(-4.2, -4., 0.), Color.gray(1.), 120., 20., radians(40.), radians(50.))
  };
  renderer.lights.setCastsShadow(h, true);
  let settings = LightShadowSettings.medium();
  renderer.setLightShadows(device, &settings);
  let camera = topDown();
  let light = dark();
  let list = boxList(scene, material, true);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  expect(renderer.lights.isShadowed(h), label);
  // Lit beyond the far edge and dark in the shadow: the middle level between
  let lit = px(p, usize.from(u32.from(columnOf(-4.9))), 128usize);
  let shadowed = px(p, usize.from(u32.from(columnOf(-3.0))), 128usize);
  expect(lit > shadowed + 40., label);
  let mid = (lit + shadowed) * 0.5;
  let far = crossRow(p, 128usize, usize.from(u32.from(columnOf(-4.9))), usize.from(u32.from(columnOf(-3.0))), mid, true);
  expect(far > 0., label);
  eprint <- "measured "; eprintStr(label as &str); eprint <- ": the far edge at x = "; eprint <- worldX(far); eprint <- " (want -4.2)\n";
  expectNear(worldX(far), -4.2, 0.08, label);
  // The sides, at the columns for x = -1.5, -2, -3 and -3.8: where the lit level returns going out from z = 0
  var xs = [-1.5f, -2., -3., -3.8];
  var k = 0usize;
  while k < 4usize {
    let x = xs[k];
    let col = usize.from(u32.from(columnOf(x)));
    let edge = 2.f;
    let side = crossColumn(p, col, 128usize, 250usize, mid, false);
    let other = crossColumn(p, col, 128usize, 6usize, mid, false);
    expect(side > 0., label);
    let sideZ = worldZ(side);
    eprint <- "measured "; eprintStr(label as &str); eprint <- ": at x = "; eprint <- x; eprint <- " the side at z = "; eprint <- sideZ;
    eprint <- " (want "; eprint <- edge; eprint <- ")\n";
    expectNear(sideZ, edge, 0.08, label);
    k = k + 1usize;
  }
}

// 3. A lit ground with the shadows on equals the same with them off
fn noAcne(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    scene &Scene, material MaterialHandle, at Vec3, point bool, label &Array[u8]) {
  let p = readback.mappedRange();
  renderer.environmentStrength = 0.;
  renderer.lights.clear();
  let h = if point {
    renderer.lights.addPoint(at, Color.gray(1.), 30., 30.)
  } else {
    renderer.lights.addSpot(at, new Vec3(0., 0., 0.) - at, Color.gray(1.), 30., 30., radians(55.), radians(70.))
  };
  renderer.lights.setCastsShadow(h, true);
  let camera = topDown();
  let light = dark();
  let list = boxList(scene, material, false);
  let off = LightShadowSettings.off();
  renderer.setLightShadows(device, &off);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  var unshadowed = List[u8].empty();
  var i = 0usize;
  while i < 262144usize {
    unshadowed.push(*(p + i));
    i = i + 1usize;
  }
  let on = LightShadowSettings.medium();
  renderer.setLightShadows(device, &on);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  expect(renderer.lights.isShadowed(h), label);
  var worst = 0.f;
  i = 0usize;
  while i < 262144usize {
    let d = absf(f32.from(*unshadowed[i]) - f32.from(*(p + i)));
    if d > worst { worst = d; }
    i = i + 1usize;
  }
  eprint <- "measured "; eprintStr(label as &str); eprint <- ": the largest difference "; eprint <- worst; eprint <- " of 255\n";
  expect(worst <= 2., label);
}

// 4. What casts nothing
fn castsNothing(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    scene &Scene) {
  let p = readback.mappedRange();
  renderer.environmentStrength = 0.;
  renderer.lights.clear();
  let at = new Vec3(2.2, 4., 0.);
  let h = renderer.lights.addPoint(at, Color.gray(1.), 30., 20.);
  let settings = LightShadowSettings.medium();
  renderer.setLightShadows(device, &settings);
  let camera = topDown();
  let light = dark();
  let list = boxList(scene, scene.lit, true);
  // Not marked: no shadow, the picture is the one without the box's shadow
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  expect(!renderer.lights.isShadowed(h), "a light not marked has no views");
  let inShadow = px(p, usize.from(u32.from(columnOf(-3.0))), 128usize);
  let beyond = px(p, usize.from(u32.from(columnOf(-4.9))), 128usize);
  expect(absf(inShadow - beyond) < 20., "and casts no shadow of the box");
  // Marked, but the box is marked 'dontCastShadow': a view is made, nothing is in it
  renderer.lights.setCastsShadow(h, true);
  var quiet = DrawList.empty();
  quiet.add(scene.ground, scene.lit, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(40., 1., 40.)));
  quiet.dontCastShadow();
  quiet.add(scene.box, scene.lit, Mat4.fromTranslation(new Vec3(0., 1., 0.)));
  quiet.dontCastShadow();
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &quiet);
  expect(renderer.lights.isShadowed(h), "a marked light is given views");
  let inShadow2 = px(p, usize.from(u32.from(columnOf(-3.0))), 128usize);
  let beyond2 = px(p, usize.from(u32.from(columnOf(-4.9))), 128usize);
  expect(absf(inShadow2 - beyond2) < 20., "but a box that does not cast casts none");
  // Marked and casting: the shadow is there; switched off again it is gone
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  eprint <- "measured a casting box: in the shadow "; eprint <- px(p, usize.from(u32.from(columnOf(-3.0))), 128usize);
  eprint <- ", beyond it "; eprint <- px(p, usize.from(u32.from(columnOf(-4.9))), 128usize); eprint <- "\n";
  expect(px(p, usize.from(u32.from(columnOf(-3.0))), 128usize) < px(p, usize.from(u32.from(columnOf(-4.9))), 128usize) - 10., "a casting box shades");
  let off = LightShadowSettings.off();
  renderer.setLightShadows(device, &off);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  expect(!renderer.lights.isShadowed(h), "shadows off: no views");
  expect(absf(px(p, usize.from(u32.from(columnOf(-3.0))), 128usize) - px(p, usize.from(u32.from(columnOf(-4.9))), 128usize)) < 20., "and no shadow");
  renderer.lights.clear();
}

// 5. The budget
fn budget(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer, scene &Scene) {
  renderer.lights.clear();
  // Ranks (range^2 / (1 + the squared distance from the camera at (0, 12, 0))):
  // C 400 / 170 = 2.35 (at (-5, 3, 0): 25 + 81 + 1 = 107: 3.74),
  // A 64 / 82 = 0.78, B 64 / 182 = 0.35, the spot S 25 / 101 = 0.25
  let a = renderer.lights.addPoint(new Vec3(0., 3., 0.), Color.gray(1.), 5., 8.);
  let b = renderer.lights.addPoint(new Vec3(10., 3., 0.), Color.gray(1.), 5., 8.);
  let c = renderer.lights.addPoint(new Vec3(-5., 3., 0.), Color.gray(1.), 5., 20.);
  let s = renderer.lights.addSpot(new Vec3(0., 2., 1.), new Vec3(0., -1., 0.), Color.gray(1.), 5., 5., radians(30.), radians(40.));
  renderer.lights.setCastsShadow(a, true);
  renderer.lights.setCastsShadow(b, true);
  renderer.lights.setCastsShadow(c, true);
  renderer.lights.setCastsShadow(s, true);
  let camera = topDown();
  var low = LightShadowSettings.medium();
  low.maxViews = 12u32;
  renderer.setLightShadows(device, &low);
  renderer.lights.prepare(device, &camera, 1., 256u32, 256u32);
  expect(renderer.lights.isShadowed(c) && renderer.lights.isShadowed(a), "12 layers: the two best point lights");
  expect(!renderer.lights.isShadowed(b) && !renderer.lights.isShadowed(s), "and no more");
  expectUInt(u64.from(renderer.lights.shadows.viewsUsed), 12u64, "twelve layers used");
  var all = LightShadowSettings.medium();
  all.maxViews = 24u32;
  renderer.setLightShadows(device, &all);
  renderer.lights.prepare(device, &camera, 1., 256u32, 256u32);
  expect(renderer.lights.isShadowed(a) && renderer.lights.isShadowed(b) && renderer.lights.isShadowed(c)
    && renderer.lights.isShadowed(s), "24 layers: all four");
  expectUInt(u64.from(renderer.lights.shadows.viewsUsed), 19u64, "three point lights and a spot: 19 layers");
  // A scene drawn with all four casting draws without a validation message
  var list = boxList(scene, scene.lit, true);
  var encoderFrame = 0u32;
  let light = dark();
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  expectUInt(u64.from(renderer.lights.shadows.passes), 19u64, "19 passes");
  // The fade: with 12 layers C and A are shadowed, the best left without views is B (the camera is 14 up:
  // A 64 / 122 = 0.525, B 64 / 222 = 0.288); a shadow shows in full at 1 + fade times that, and not at all
  // level with it: with a fade of 2, C in full and A by (0.525 / 0.288 - 1) / 2 = 0.41
  var faded = LightShadowSettings.medium();
  faded.maxViews = 12u32;
  faded.fade = 2.;
  renderer.setLightShadows(device, &faded);
  renderer.lights.prepare(device, &camera, 1., 256u32, 256u32);
  expect(renderer.lights.isShadowed(c) && renderer.lights.isShadowed(a) && !renderer.lights.isShadowed(b), "with a fade: the same two lights");
  expectNear(renderer.lights.shadowShare(c), 1., 0.001, "the best light's shadow shows in full");
  expectNear(renderer.lights.shadowShare(a), 0.41, 0.01, "the next one's shows by its rank against the best left out");
  renderer.setLightShadows(device, &low);
  renderer.lights.prepare(device, &camera, 1., 256u32, 256u32);
  expectNear(renderer.lights.shadowShare(a), 1., 0.001, "and with no fade, in full");
  renderer.lights.clear();
}

// 6. The fade on the picture: a box's shadow under a light that has a rival close behind it in rank shows by the
// share the fade gives, not in full
fn fadeShows(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer, scene &Scene) {
  let p = readback.mappedRange();
  renderer.environmentStrength = 0.;
  renderer.lights.clear();
  let h = renderer.lights.addPoint(new Vec3(2.2, 4., 0.), Color.gray(1.), 100., 20.);
  // the rival: next in rank (400 / 137 against 400 / 106 here), unshadowed for want of layers, giving no light
  let g = renderer.lights.addPoint(new Vec3(-6., 4., 0.), Color.gray(1.), 0.0001, 20.);
  renderer.lights.setCastsShadow(h, true);
  renderer.lights.setCastsShadow(g, true);
  var settings = LightShadowSettings.medium();
  settings.maxViews = 6u32;
  let camera = topDown();
  let light = dark();
  let list = boxList(scene, scene.lit, true);
  // The picture with no shadows, with them in full, and with them faded
  let off = LightShadowSettings.off();
  renderer.setLightShadows(device, &off);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  let lit = px(p, usize.from(u32.from(columnOf(-3.0))), 128usize);
  renderer.setLightShadows(device, &settings);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  let shaded = px(p, usize.from(u32.from(columnOf(-3.0))), 128usize);
  expect(renderer.lights.isShadowed(h) && !renderer.lights.isShadowed(g), "the rival has no views");
  settings.fade = 2.;
  renderer.setLightShadows(device, &settings);
  drawFrame(renderer, device, color, depth, readback, &camera, &light, &list);
  let share = renderer.lights.shadowShare(h);
  let shaded2 = px(p, usize.from(u32.from(columnOf(-3.0))), 128usize);
  eprint <- "measured the fade: share "; eprint <- share; eprint <- ", the pixel in the box's shadow "; eprint <- lit;
  eprint <- " unshadowed, "; eprint <- shaded; eprint <- " in full, "; eprint <- shaded2; eprint <- " faded\n";
  expect(share > 0.05 && share < 0.5, "the light's shadow is partly faded");
  expect(lit - shaded > 60., "the shadow is there in full without a fade");
  expectNear((lit - shaded2) / (lit - shaded), share, 0.1, "and the faded shadow is that share of it");
  renderer.lights.clear();
}

fn main() i32 {
  var instance = Instance.create("render light shadows");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  var device = adapter.requestDevice();
  require(device.isValid(), "a device");
  eprint <- "measured adapter: "; eprintStr(adapter.name.view()); eprint <- "\n";
  let targetDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var color = device.createTexture(&targetDesc);
  let depthDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var readback = device.createBuffer(262144u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  require(renderer.isValid(), "a renderer");
  let scene = makeScene(&mut renderer, &mut device);

  edges(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.lit, false, "spot light shadow, lit");
  edges(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.pbr, false, "spot light shadow, physically based");
  edges(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.lit, true, "point light shadow, lit");
  edges(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.pbr, true, "point light shadow, physically based");
  noAcne(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.lit, new Vec3(1., 3., 0.), false, "no acne, spot, lit");
  noAcne(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.pbr, new Vec3(1., 3., 0.), false, "no acne, spot, physically based");
  noAcne(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.lit, new Vec3(1., 3., 0.), true, "no acne, point, lit");
  noAcne(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.pbr, new Vec3(1., 3., 0.), true, "no acne, point, physically based");
  noAcne(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.lit, new Vec3(3., 1.2, 0.5), true, "no acne, a point light at a grazing angle, lit");
  noAcne(&mut renderer, &mut device, &color, &depth, &readback, &scene, scene.pbr, new Vec3(3., 1.2, 0.5), true, "no acne, a point light at a grazing angle, physically based");
  castsNothing(&mut renderer, &mut device, &color, &depth, &readback, &scene);
  budget(&mut renderer, &mut device, &color, &depth, &readback, &scene);
  fadeShows(&mut renderer, &mut device, &color, &depth, &readback, &scene);

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done()
}
