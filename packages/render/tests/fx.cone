// The render package's image-quality passes (fx.cone and its files) on a real
// GPU with no window: scenes of flat colours drawn into 128 x 128 targets, read
// back and measured. It needs a GPU driver with Vulkan 1.3 and SDL3.dll; with
// the Vulkan SDK, validation and synchronization validation are on, and must
// say nothing. GPU_POWER_PREFERENCE=low-power runs it on the integrated GPU.
// Only a failure prints (and some measurements, marked "measured").
//
// 1. Everything off: ImageFx draws the same bytes as the renderer and Post
//    drew before (a hash of a scene with a physically based sphere, ground and
//    a cut-out leaf, the value recorded on each GPU before the work began).
// 2. Temporal AA converges: a disc and a cut-out leaf on black, lit by an
//    ambient light alone (so a pixel is its colour times its coverage), drawn
//    with the tone map off and no bloom. The reference is 64 frames of the
//    same scene, jittered by the Halton sequence, averaged in linear light on
//    the CPU (a 64-sample supersample). The TAA picture after 40 static frames
//    is within a small error of it, and much nearer than the unjittered
//    picture is.
// 3. FXAA brings the edges nearer the same reference.
// 4. Auto-exposure: a frame of one known luminance L settles to 0.18 / L
//    (the formula), within the histogram's bin, and obeys the clamps and the
//    compensation.

mod fx;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import path as filepath;

const SIDE = 128u32;
const SIDEZ = 128usize;

// If FX_SHOTS names a folder, the 128 x 128 image at 'p' is written there as
// 'name'.bmp, to be looked at
fn shot(p *u8, name &str) {
  imm folder = libc.getenv("FX_SHOTS");
  if (folder as usize) == 0usize { return; }
  mut path = String.empty();
  mut i = 0usize;
  while *(folder + i) != 0u8 {
    path.appendByte(*(folder + i));
    i = i + 1usize;
  }
  path <- "/";
  path <- name;
  path <- ".bmp";
  imm image = Image.fromTexels(p, i32.from(SIDE), i32.from(SIDE), false);
  image.save(&filepath.Path.from(path.view()));
}

fn absf(x f32) f32 { if x < 0. { 0. - x; } else { x; }; }

fn scatter(n u32) f32 {
  mut x = n * 747796405u32 + 2891336453u32;
  x = ((x >> ((x >> 28u32) + 4u32)) ^ x) * 277803737u32;
  x = (x >> 22u32) ^ x;
  f32.from(x & 0xFFFFu32) / 65535.;
}

// A leaf: a green disc, clear outside it
fn leafImage() Image {
  mut img = new Image(64, 64, 4, List[u8].empty());
  mut y = 0;
  while y < 64 {
    mut x = 0;
    while x < 64 {
      imm dx = (f32.from(x) - 31.5) / 32.;
      imm dy = (f32.from(y) - 31.5) / 32.;
      imm inside = dx * dx + dy * dy < 0.9;
      imm shade = 0.75 + 0.25 * scatter(u32.from(x * 64 + y));
      img.pixels.push(u8.from(40. * shade));
      img.pixels.push(u8.from(150. * shade));
      img.pixels.push(u8.from(30. * shade));
      img.pixels.push(if inside { 255u8; } else { 0u8; });
      x = x + 1;
    }
    y = y + 1;
  }
  img;
}

fn preference() u32 {
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize and libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

// sRGB's decoding of a byte, to linear light
fn linearOf(byte u8) f32 {
  imm v = f32.from(byte) / 255.;
  if v <= 0.04045 { return v / 12.92; }
  libc.powf((v + 0.055) / 1.055, 2.4);
}

// The pixel (x, y), channel c, of the target at 'p', in linear light
fn px(p *u8, x usize, y usize, c usize) f32 { linearOf(*(p + (y * SIDEZ + x) * 4usize + c)); }

// A renderer, its post and image-quality objects, a target and a readback
struct Rig {
  renderer Renderer;
  post Post;
  fx ImageFx;
  color Texture;
  readback Buffer;
}

fn makeRig(device &mut Device) Rig {
  imm targetDesc = new TextureDescriptor(SIDE, SIDE, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut color = device.createTexture(&targetDesc);
  mut readback = device.createBuffer(u64.from(SIDE) * u64.from(SIDE) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut renderer = Renderer.create(device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, SIDE, SIDE);
  require(renderer.isValid() and post.isValid(), "a renderer and a post");
  mut fx = ImageFx.create(device, &renderer, &mut post);
  require(fx.isValid(), "an image-quality object");
  new Rig(renderer, post, fx, color, readback);
}

fn drawScene(device &mut Device, rig &mut Rig, camera &Camera, light &Light, list &DrawList) {
  mut encoder = device.createCommandEncoder();
  rig.fx.render(device, &mut encoder, &mut rig.renderer, &mut rig.post, camera, light, list, &rig.color);
  encoder.copyTextureToBuffer(&rig.color, &rig.readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

// The same scene drawn by the plain path: the renderer and Post, the camera
// jittered by (jx, jy) pixels
fn drawPlain(device &mut Device, rig &mut Rig, camera &Camera, light &Light, list &DrawList, jx f32, jy f32) {
  mut jittered = *camera;
  jittered.jitterX = 2. * jx / f32.from(SIDE);
  jittered.jitterY = -2. * jy / f32.from(SIDE);
  mut encoder = device.createCommandEncoder();
  rig.renderer.render(device, &mut encoder, &rig.post.hdr, &rig.fx.depth, &jittered, light, list);
  rig.post.apply(&mut encoder, &rig.color);
  encoder.copyTextureToBuffer(&rig.color, &rig.readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn hashOf(p *u8) u64 {
  mut h = 14695981039346656037u64;
  mut i = 0usize;
  while i < usize.from(SIDE * SIDE * 4u32) {
    h = (h ^ u64.from(*(p + i))) * 1099511628211u64;
    i = i + 1usize;
  }
  h;
}

// The root mean square difference of two images of linear light
fn rms(a &List[f32], b &List[f32]) f32 {
  mut sum = 0.;
  mut i = 0usize;
  while i < a.len() {
    imm d = *a[i] - *b[i];
    sum = sum + d * d;
    i = i + 1usize;
  }
  (sum / f32.from(a.len())).sqrt();
}

// The 128 x 128 image at 'p' as linear light, three channels a pixel
fn grab(p *u8) List[f32] {
  mut out = List[f32].withCapacity(SIDEZ * SIDEZ * 3usize);
  mut y = 0usize;
  while y < SIDEZ {
    mut x = 0usize;
    while x < SIDEZ {
      out.push(px(p, x, y, 0usize));
      out.push(px(p, x, y, 1usize));
      out.push(px(p, x, y, 2usize));
      x = x + 1usize;
    }
    y = y + 1usize;
  }
  out;
}

// ---- 1. Everything off ----

fn identity(device &mut Device, name &String) {
  mut rig = makeRig(device);
  imm p = rig.readback.mappedRange();
  mut planeMesh = Mesh.plane(1, 1.);
  imm plane = rig.renderer.addMesh(device, &planeMesh);
  imm sphereMesh = Mesh.sphere(1., 20);
  imm sphere = rig.renderer.addMesh(device, &sphereMesh);
  imm groundM = rig.renderer.addPbrMaterial(device, &PbrMaterial.standard(new Color(0.3, 0.3, 0.3, 1.), 0., 0.9));
  imm brassM = rig.renderer.addPbrMaterial(device, &PbrMaterial.standard(new Color(0.8, 0.55, 0.2, 1.), 1., 0.35));
  imm leafImg = leafImage();
  imm leafTex = rig.renderer.addCutoutTexture(device, &leafImg, 0.5);
  mut leafPbr = PbrMaterial.standard(new Color(1., 1., 1., 1.), 0., 0.8).cutOut(0.5);
  leafPbr.texture = leafTex;
  imm leafM = rig.renderer.addPbrMaterial(device, &leafPbr);
  mut list = DrawList.empty();
  list.add(plane, groundM, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(30., 1., 30.)));
  list.add(sphere, brassM, Mat4.fromTrs(new Vec3(0., 1., 0.), Quat.identity(), new Vec3(1., 1., 1.)));
  list.add(plane, leafM, Mat4.fromTrs(new Vec3(1.5, 1.2, 0.5), Quat.angleAxis(1.2, new Vec3(1., 0., 0.)), new Vec3(1., 1., 1.)));
  imm sky = Sky.dusk(radians(28.), radians(235.));
  rig.renderer.setSky(device, &sky);
  imm light = sky.sunLight(new Color(3.2, 2.9, 2.4, 1.), new Color(0.05, 0.06, 0.08, 1.));
  mut camera = Camera.make();
  camera.fov = radians(50.);
  camera.lookAt(new Vec3(0., 3., 6.), new Vec3(0., 1., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.4, 0.5, 0.7, 1.);
  drawScene(device, &mut rig, &camera, &light, &list);
  imm hash = hashOf(p);
  eprint <- "measured hash: "; eprint <- hash; eprint <- "\n";
  mut golden = 0u64;
  if name.view() == "NVIDIA GeForce RTX 4060 Laptop GPU" { golden = 15363336798863314105u64; }
  if name.view() == "Intel(R) UHD Graphics 770" { golden = 8445244809760690128u64; }
  if golden != 0u64 { expectUInt(hash, golden, "everything off: the bytes the plain path drew before"); }
  drawPlain(device, &mut rig, &camera, &light, &list, 0., 0.);
  expectUInt(hashOf(p), hash, "everything off equals the plain path now");
}

// ---- 2 and 3. Anti-aliasing against a supersample ----

struct Flat {
  list DrawList;
  light Light;
  camera Camera;
}

// A disc and a leaf on black, lit by ambient light alone
fn flatScene(device &mut Device, rig &mut Rig) Flat {
  rig.post.toneMapper = TONE_MAP_NONE;
  rig.post.bloom = 0.;
  mut sphereMesh = Mesh.sphere(1., 24);
  imm sphere = rig.renderer.addMesh(device, &sphereMesh);
  mut planeMesh = Mesh.plane(1, 1.);
  imm plane = rig.renderer.addMesh(device, &planeMesh);
  imm discM = rig.renderer.addMaterial(device, &Material.plain(new Color(0.9, 0.5, 0.1, 1.)));
  imm leafImg = leafImage();
  imm leafTex = rig.renderer.addCutoutTexture(device, &leafImg, 0.5);
  mut leafLit = Material.plain(new Color(1., 1., 1., 1.));
  leafLit.texture = leafTex;
  leafLit.alphaMode = ALPHA_MASK;
  leafLit.alphaCutoff = 0.5;
  imm leafM = rig.renderer.addMaterial(device, &leafLit);
  mut list = DrawList.empty();
  list.add(sphere, discM, Mat4.fromTrs(new Vec3(-0.9, 0.3, 0.), Quat.identity(), new Vec3(1.3, 1.3, 1.3)));
  list.add(plane, leafM, Mat4.fromTrs(new Vec3(1.4, -0.2, 0.), Quat.angleAxis(1.5707964, new Vec3(1., 0., 0.)) * Quat.angleAxis(0.5, new Vec3(0., 1., 0.)),
    new Vec3(1.1, 1., 1.1)));
  imm light = Light.directional(new Vec3(0., -1., 0.), new Color(0., 0., 0., 1.), new Color(1., 1., 1., 1.));
  mut camera = Camera.make();
  camera.fov = radians(40.);
  camera.lookAt(new Vec3(0., 0., 6.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0., 0., 0.05, 1.);
  new Flat(list, light, camera);
}

fn antialiasing(device &mut Device) {
  mut rig = makeRig(device);
  imm p = rig.readback.mappedRange();
  imm scene = flatScene(device, &mut rig);
  // The unjittered picture, and the supersampled reference
  drawPlain(device, &mut rig, &scene.camera, &scene.light, &scene.list, 0., 0.);
  imm aliased = grab(p);
  mut sum = List[f32].empty();
  mut i = 0u32;
  while i < 64u32 {
    mut jx = 0.;
    mut jy = 0.;
    jitterOf(i, 64u32, 1., &mut jx, &mut jy);
    drawPlain(device, &mut rig, &scene.camera, &scene.light, &scene.list, jx, jy);
    imm g = grab(p);
    if i == 0u32 {
      sum = g;
    } else {
      mut k = 0usize;
      while k < sum.len() {
        sum.set(k, *sum[k] + *g[k]);
        k = k + 1usize;
      }
    }
    i = i + 1u32;
  }
  mut reference = sum;
  mut k = 0usize;
  while k < reference.len() {
    reference.set(k, *reference[k] / 64.);
    k = k + 1usize;
  }
  imm aliasedError = rms(&aliased, &reference);
  eprint <- "measured: no anti-aliasing, error against 64 samples "; eprint <- aliasedError; eprint <- "\n";
  expect(aliasedError > 0.005, "the unjittered picture is aliased (it differs from the supersample)");

  // FXAA
  mut s = FxSettings.off();
  s.aa = AA_FXAA;
  rig.fx.configure(&s);
  drawScene(device, &mut rig, &scene.camera, &scene.light, &scene.list);
  imm fxaaError = rms(&grab(p), &reference);
  eprint <- "measured: FXAA error "; eprint <- fxaaError; eprint <- "\n";
  expect(fxaaError < aliasedError * 0.8, "FXAA brings the edges nearer the supersample");

  // Temporal AA, still camera, 40 frames
  mut t = FxSettings.off();
  t.aa = AA_TAA;
  t.taa.sharpness = 0.;
  rig.fx.configure(&t);
  mut f = 0u32;
  while f < 40u32 {
    drawScene(device, &mut rig, &scene.camera, &scene.light, &scene.list);
    f = f + 1u32;
  }
  imm taaError = rms(&grab(p), &reference);
  eprint <- "measured: TAA error after 40 frames "; eprint <- taaError; eprint <- "\n";
  expect(taaError < aliasedError * 0.3, "temporal AA converges to within 0.3 of the aliased error of the supersample");
  expect(taaError < 0.006, "and to a small error");
  // Averaging the light as it is (no weighting by brightness) is nearer
  // still to a supersample of light
  mut u = t;
  u.taa.hdrWeight = 0.;
  rig.fx.configure(&u);
  rig.fx.cutHistory();
  f = 0u32;
  while f < 40u32 {
    drawScene(device, &mut rig, &scene.camera, &scene.light, &scene.list);
    f = f + 1u32;
  }
  imm linearError = rms(&grab(p), &reference);
  eprint <- "measured: TAA, unweighted, error "; eprint <- linearError; eprint <- "\n";
  expect(linearError < aliasedError * 0.25, "unweighted, temporal AA is within a quarter of the aliased error");
}

// ---- 4. Auto-exposure ----

// The four floats of the exposure buffer after a frame
fn readExposure(device &mut Device, rig &mut Rig, back &Buffer) Array[f32, 4] {
  mut encoder = device.createCommandEncoder();
  encoder.copyBufferToBuffer(&rig.post.exposureBuffer, 0u64, back, 0u64, 16u64);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  imm q = back.mappedRange() as *f32;
  [*q, *(q + 1usize), *(q + 2usize), *(q + 3usize)];
}

// Frames of the one luminance 'level' (the camera's background, nothing
// drawn), settled for 'frames' frames of 'seconds' each; the exposure buffer
fn settle(device &mut Device, rig &mut Rig, back &Buffer, level f32, s &ExposureSettings, frames u32, seconds f32) Array[f32, 4] {
  mut camera = Camera.make();
  camera.background = new Color(level, level, level, 1.);
  imm light = Light.directional(new Vec3(0., -1., 0.), new Color(0., 0., 0., 1.), new Color(0., 0., 0., 1.));
  imm list = DrawList.empty();
  mut settings = FxSettings.off();
  settings.exposure = *s;
  rig.fx.configure(&settings);
  rig.fx.frameTime = seconds;
  mut f = 0u32;
  while f < frames {
    drawScene(device, rig, &camera, &light, &list);
    f = f + 1u32;
  }
  readExposure(device, rig, back);
}

// The pixel (as x and y) a world point lands on, seen by 'camera'
fn pixelOf(camera &Camera, world Vec3, x &mut usize, y &mut usize) {
  imm clip = (camera.projectionMatrix(1.) * camera.viewMatrix()) * new Vec4(world.x, world.y, world.z, 1.);
  imm nx = clip.x / clip.w;
  imm ny = clip.y / clip.w;
  *x = usize.from(u32.from((nx * 0.5 + 0.5) * f32.from(SIDE)));
  *y = usize.from(u32.from((0.5 - ny * 0.5) * f32.from(SIDE)));
}

// ---- 6. Ambient occlusion ----

fn ambientOcclusion(device &mut Device) {
  mut rig = makeRig(device);
  imm p = rig.readback.mappedRange();
  rig.post.toneMapper = TONE_MAP_NONE;
  rig.post.bloom = 0.;
  mut planeMesh = Mesh.plane(1, 1.);
  imm plane = rig.renderer.addMesh(device, &planeMesh);
  imm gray = rig.renderer.addMaterial(device, &Material.plain(new Color(0.5, 0.5, 0.5, 1.)));
  imm light = Light.directional(new Vec3(0., -1., 0.), new Color(0., 0., 0., 1.), new Color(1., 1., 1., 1.));
  mut camera = Camera.make();
  camera.fov = radians(50.);
  camera.near = 0.3;
  camera.far = 60.;
  camera.lookAt(new Vec3(0., 3., 5.), new Vec3(0., 0., -2.), new Vec3(0., 1., 0.));
  camera.background = new Color(0., 0., 0., 1.);
  // A floor, and a wall across it at z = -3: a corner
  mut corner = DrawList.empty();
  corner.add(plane, gray, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(20., 1., 20.)));
  corner.add(plane, gray, Mat4.fromTrs(new Vec3(0., 0., -3.), Quat.angleAxis(1.5707964, new Vec3(1., 0., 0.)), new Vec3(20., 1., 20.)));
  // The floor alone
  mut flat = DrawList.empty();
  flat.add(plane, gray, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(20., 1., 20.)));

  drawScene(device, &mut rig, &camera, &light, &corner);
  imm cornerOff = grab(p);
  shot(p, "ssao-corner-off");
  drawScene(device, &mut rig, &camera, &light, &flat);
  imm flatOff = grab(p);
  mut s = FxSettings.off();
  s.ssao = SsaoSettings.high();
  rig.fx.configure(&s);
  drawScene(device, &mut rig, &camera, &light, &corner);
  imm cornerOn = grab(p);
  shot(p, "ssao-corner-on");
  drawScene(device, &mut rig, &camera, &light, &flat);
  imm flatOn = grab(p);
  shot(p, "ssao-flat-on");

  // The crease: just in front of the wall's foot on the floor
  mut cx = 0usize;
  mut cy = 0usize;
  pixelOf(&camera, new Vec3(0., 0., -2.88), &mut cx, &mut cy);
  imm creaseOff = *cornerOff[(cy * SIDEZ + cx) * 3usize + 1usize];
  imm creaseOn = *cornerOn[(cy * SIDEZ + cx) * 3usize + 1usize];
  eprint <- "measured: SSAO at the crease "; eprint <- creaseOn / creaseOff; eprint <- " of the unoccluded\n";
  // (a crease a few pixels wide in a 128-pixel picture, in a half-resolution
  // pass: the dip is 8 pixels wide and goes to 0.83)
  expect(creaseOn < creaseOff * 0.88, "ambient occlusion darkens the crease where floor and wall meet");
  // The floor far from the wall, and the same floor with no wall at all
  mut fx0 = 0usize;
  mut fy0 = 0usize;
  pixelOf(&camera, new Vec3(0., 0., 2.), &mut fx0, &mut fy0);
  imm farOff = *cornerOff[(fy0 * SIDEZ + fx0) * 3usize + 1usize];
  imm farOn = *cornerOn[(fy0 * SIDEZ + fx0) * 3usize + 1usize];
  expect(farOn > farOff * 0.97, "and leaves the floor far from the wall alone");
  // A flat plane is not darkened anywhere
  mut worst = 1.;
  mut worstAt = 0usize;
  mut count = 0usize;
  mut y = 0usize;
  while y < SIDEZ {
    mut x = 0usize;
    while x < SIDEZ {
      imm at = (y * SIDEZ + x) * 3usize + 1usize;
      if *flatOff[at] > 0.01 {
        imm ratio = *flatOn[at] / *flatOff[at];
        if ratio < worst {
          worst = ratio;
          worstAt = y * SIDEZ + x;
        }
        count = count + 1usize;
      }
      x = x + 1usize;
    }
    y = y + 1usize;
  }
  eprint <- "measured: the darkest flat-plane pixel is "; eprint <- worst; eprint <- " of the unoccluded, over "; eprint <- u64.from(count); eprint <- " pixels, at x "; eprint <- u64.from(worstAt % SIDEZ); eprint <- " y "; eprint <- u64.from(worstAt / SIDEZ); eprint <- "\n";
  expect(count > 4000usize, "the flat plane covers the picture");
  expect(worst > 0.94, "ambient occlusion leaves a flat plane alone (the darkest pixel within 6%)");
  mut v = 0u32;
  while v < 4u32 {
    mut t = s;
    if v == 1u32 { t.ssao.slices = 6u32; t.ssao.steps = 16u32; }
    if v == 2u32 { t.ssao.power = 1.; }
    if v == 3u32 { t.ssao.radius = 1.5; }
    rig.fx.configure(&t);
    drawScene(device, &mut rig, &camera, &light, &flat);
    imm g = grab(p);
    mut sum = 0.;
    mut mn = 1.;
    mut n = 0usize;
    mut q = 0usize;
    while q < g.len() {
      if *flatOff[q] > 0.01 {
        imm r = *g[q] / *flatOff[q];
        sum = sum + r;
        if r < mn { mn = r; }
        n = n + 1usize;
      }
      q = q + 3usize;
    }
    eprint <- "measured: flat-plane variant "; eprint <- u64.from(v); eprint <- " mean "; eprint <- sum / f32.from(n); eprint <- " min "; eprint <- mn; eprint <- "\n";
    v = v + 1u32;
  }
  // The off picture is untouched by the AO's machinery
  expect(rms(&cornerOff, &cornerOn) > 0.001, "the corner picture changed");
}

// ---- 5. Grading, vignette and grain ----

// A uniform frame of 'color' drawn with Post's finish as it is
fn drawFlat(device &mut Device, rig &mut Rig, color Color) {
  mut camera = Camera.make();
  camera.background = color;
  imm light = Light.directional(new Vec3(0., -1., 0.), new Color(0., 0., 0., 1.), new Color(0., 0., 0., 1.));
  imm list = DrawList.empty();
  drawScene(device, rig, &camera, &light, &list);
}

fn finish(device &mut Device) {
  mut rig = makeRig(device);
  imm p = rig.readback.mappedRange();
  rig.post.toneMapper = TONE_MAP_NONE;
  rig.post.bloom = 0.;
  // The expected linear value of a display-encoded v
  imm base = new Color(0.3, 0.3, 0.3, 1.);
  drawFlat(device, &mut rig, base);
  imm plain = px(p, 64usize, 64usize, 0usize);
  expect(absf(plain - 0.3) < 0.003, "no finish: the frame is shown as it is");
  imm srgb = 1.055 * libc.powf(0.3, 1. / 2.4) - 0.055;
  // Gain 1.2 on red: in display-encoded values
  rig.post.finish.grade = true;
  rig.post.finish.gain = new Vec3(1.2, 1., 1.);
  drawFlat(device, &mut rig, base);
  expect(absf(px(p, 64usize, 64usize, 0usize) - decode(srgb * 1.2)) < 0.004, "gain scales the whites (red, in display-encoded values)");
  expect(absf(px(p, 64usize, 64usize, 1usize) - 0.3) < 0.003, "and the other channels are left");
  rig.post.finish.gain = new Vec3(1., 1., 1.);
  rig.post.finish.lift = new Vec3(0.1, 0.1, 0.1);
  drawFlat(device, &mut rig, base);
  expect(absf(px(p, 64usize, 64usize, 1usize) - decode(srgb + 0.1 * (1. - srgb))) < 0.004, "lift raises the blacks: v + lift (1 - v)");
  rig.post.finish.lift = new Vec3(0., 0., 0.);
  rig.post.finish.gamma = new Vec3(2., 2., 2.);
  drawFlat(device, &mut rig, base);
  expect(absf(px(p, 64usize, 64usize, 1usize) - decode(libc.sqrtf(srgb))) < 0.004, "gamma 2 brightens the middle: v^(1/2)");
  rig.post.finish.gamma = new Vec3(1., 1., 1.);
  rig.post.finish.saturation = 0.;
  drawFlat(device, &mut rig, new Color(0.6, 0.2, 0.1, 1.));
  expect(absf(px(p, 64usize, 64usize, 0usize) - px(p, 64usize, 64usize, 2usize)) < 0.004, "saturation 0: red and blue come out the same (grey)");
  rig.post.finish.saturation = 1.;
  // The table: a size-2 table that inverts display-encoded values
  mut table = List[u8].empty();
  mut b = 0u32;
  while b < 2u32 {
    mut g = 0u32;
    while g < 2u32 {
      mut r = 0u32;
      while r < 2u32 {
        table.push(if r == 0u32 { 255u8; } else { 0u8; });
        table.push(if g == 0u32 { 255u8; } else { 0u8; });
        table.push(if b == 0u32 { 255u8; } else { 0u8; });
        table.push(255u8);
        r = r + 1u32;
      }
      g = g + 1u32;
    }
    b = b + 1u32;
  }
  imm tv = table.view();
  rig.post.setTable(device, 2u32, tv);
  rig.post.finish.tableStrength = 1.;
  drawFlat(device, &mut rig, base);
  expect(absf(px(p, 64usize, 64usize, 1usize) - decode(1. - srgb)) < 0.004, "a table that inverts, read at the display-encoded colour");
  rig.post.finish.tableStrength = 0.;
  rig.post.finish.grade = false;
  // Vignette: the corners darker, the middle not
  rig.post.finish.vignette = 0.5;
  drawFlat(device, &mut rig, base);
  imm middle = px(p, 64usize, 64usize, 0usize);
  imm corner = px(p, 0usize, 0usize, 0usize);
  expect(absf(middle - 0.3) < 0.003, "the vignette leaves the middle");
  expect(corner < middle * 0.72 and corner > middle * 0.6, "and darkens the corner by about a third");
  rig.post.finish.vignette = 0.;
  // Grain: a spread about the same mean
  rig.post.finish.grain = 0.05;
  drawFlat(device, &mut rig, base);
  mut sum = 0.;
  mut sumSquares = 0.;
  mut n = 0.;
  mut y = 20usize;
  while y < 100usize {
    mut x = 20usize;
    while x < 100usize {
      imm v = px(p, x, y, 1usize);
      sum = sum + v;
      sumSquares = sumSquares + v * v;
      n = n + 1.;
      x = x + 1usize;
    }
    y = y + 1usize;
  }
  imm mean = sum / n;
  imm spread = (sumSquares / n - mean * mean).sqrt();
  eprint <- "measured: grain 0.05: mean "; eprint <- mean; eprint <- " spread "; eprint <- spread; eprint <- "\n";
  expect(absf(mean - 0.3) < 0.006 and spread > 0.01, "film grain spreads the values and keeps the mean");
  rig.post.finish.grain = 0.;
  drawFlat(device, &mut rig, base);
  expect(absf(px(p, 10usize, 10usize, 1usize) - px(p, 90usize, 70usize, 1usize)) < 0.0001, "and with the grain off the frame is uniform again");
}

// The linear light of a display-encoded value
fn decode(v f32) f32 {
  if v <= 0.04045 { return v / 12.92; }
  libc.powf((v + 0.055) / 1.055, 2.4);
}

fn log2of(x f32) f32 { libc.logf(x) / 0.6931472; }

fn exposure(device &mut Device) {
  mut rig = makeRig(device);
  imm p = rig.readback.mappedRange();
  rig.post.toneMapper = TONE_MAP_NONE;
  rig.post.bloom = 0.;
  mut back = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  // Quick adaptation, wide clamps: the settled exposure is 0.18 / L, to the
  // histogram's bin (18 stops in 255 bins: half a bin is 0.035 stops, 2.5%)
  mut s = new ExposureSettings(enabled: true, speedUp: 1000., speedDown: 1000., lowPercent: 0., highPercent: 1.,
    minEv: -10., maxEv: 10.);
  mut worst = 0.;
  mut k = 0usize;
  imm levels = [0.05, 0.4, 2.0, 11.0];
  while k < 4usize {
    imm level = levels[k];
    imm e = settle(device, &mut rig, &back, level, &s, 3u32, 1.);
    imm want = exposureFor(level, 0.18, 0.);
    imm error = absf(e[0] / want - 1.);
    if error > worst { worst = error; }
    expect(error < 0.03, "the settled exposure is 0.18 / L, within the histogram's bin");
    // And the tone map used it: the picture is the middle grey 0.18 (the
    // tone map is off, the frame L times the exposure)
    imm shown = px(p, 64usize, 64usize, 1usize);
    expect(absf(shown / 0.18 - 1.) < 0.04, "and the picture shows it: the frame's average is a middle grey");
    k = k + 1usize;
  }
  eprint <- "measured: worst exposure error against 0.18 / L "; eprint <- worst; eprint <- "\n";
  // The compensation, in stops
  mut c = s;
  c.compensationEv = 1.;
  imm plus = settle(device, &mut rig, &back, 0.4, &c, 3u32, 1.);
  expect(absf(plus[0] / exposureFor(0.4, 0.18, 1.) - 1.) < 0.03, "a compensation of +1 stop doubles the exposure");
  // The clamps
  mut clamped = s;
  clamped.maxEv = 1.;
  imm high = settle(device, &mut rig, &back, 0.05, &clamped, 3u32, 1.);
  expect(absf(high[0] / 2. - 1.) < 0.001, "the exposure is held at the greatest, +1 stop");
  expect(absf(high[2] / 2. - 1.) < 0.001, "and its target with it");
  clamped.maxEv = 10.;
  clamped.minEv = -1.;
  imm low = settle(device, &mut rig, &back, 11., &clamped, 3u32, 1.);
  expect(absf(low[0] / 0.5 - 1.) < 0.001, "and at the least, -1 stop");
  // Adaptation: from the exposure for L = 0.4 to the one for 2.0 over a
  // tenth of a second at a speed of 3 a second, in log space
  mut slow = s;
  slow.speedUp = 3.;
  slow.speedDown = 3.;
  imm before = settle(device, &mut rig, &back, 0.4, &slow, 3u32, 1.);
  imm after = settle(device, &mut rig, &back, 2.0, &slow, 1u32, 0.1);
  imm evBefore = log2of(before[0]);
  imm evTarget = log2of(exposureFor(2.0, 0.18, 0.));
  imm evWant = evBefore + (evTarget - evBefore) * (1. - libc.expf(-0.1 * 3.));
  imm evGot = log2of(after[0]);
  eprint <- "measured: adaptation, want "; eprint <- evWant; eprint <- " stops, got "; eprint <- evGot; eprint <- "\n";
  expect(absf(evGot - evWant) < 0.05, "the exposure moves towards the target as the exponential in log space says");
}

fn main() i32 {
  mut instance = Instance.create("render fx");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  eprint <- "measured adapter: "; eprintStr(adapter.name.view()); eprint <- "\n";
  identity(&mut device, &adapter.name);
  antialiasing(&mut device);
  exposure(&mut device);
  ambientOcclusion(&mut device);
  finish(&mut device);
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}
