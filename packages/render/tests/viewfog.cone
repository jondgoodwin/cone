// Volumetric fog on a RenderView, on a real GPU with no window, into a 128 x 128 rgba16float
// picture read back as half floats. A mirror's camera is a reflected one (camera.cone): the
// world reflected about the mirror plane before the camera sees it, its near plane replaced by
// the mirror plane itself (Lengyel's oblique clip), which puts x and y terms in the projection's
// depth row. A fog that took a pixel's distance from that row (the froxel volume's depth, which
// the fog applied the main view's way) recovered 4.6 for a point 6 away at a screen x of 0.4,
// 8.6 at -0.4, 13.4 for one 40 away at 0.4 and -40 at -0.4; the fog now takes the planar
// distance from the inverse view-projection (fog.slang).
//
// The reflected camera is the seer at S = (1.5, 0, 2.598), looking at (-1.5, 0, -2.598), the
// mirror the plane through the origin whose unit normal is n = (0.866, 0, 0.5). What it
// draws is exactly what a plain camera at the reflected eye E = (-3, 0, 0), looking at
// (3, 0, 0) along +x, sees of the world itself (the world on the seer's side of the plane).
//
// 1. Recovered distance: a wall across the plain camera's way, 6 away and then 40 away (a
//    thin cube, so every point of it is that planar distance in front of the camera), is seen
//    through absorbing fog (albedo 0, extinction 0.1, no light scattered in), so a pixel is
//    its unfogged value times exp(-0.1 d): the distance each of the five screen points of
//    the table above shows (pixel x 64 and 38 and 90 of 128: screen x 0, -0.4, 0.4) is
//    measured through the reflected camera and the plain one, and is within 12% of the
//    truth, and the two cameras' pictures within 3% of each other.
// 2. The picture: a ground and three cubes lit by a sun, in a fog that scatters (the sun's
//    light through the phase function, the ambient, a height fog), seen by the reflected
//    camera and by the plain camera at its reflected eye: no pixel differs by more than 0.01
//    of the brightest, and the fog has changed the picture a lot (the test would pass on two
//    pictures of no fog).
// 3. A view with fog enabled but its settings 'enabled: false' draws exactly the picture
//    of a view with no fog.
// 4. The history: a second picture of the same camera with 'temporal' under 1, which blends in the
//    first picture's volume, differs from the first by no more than the volume's noise.
// 5. A change of the fog's grid (the low tier's cells and slices) remakes the volume, and the fog
//    is still right.
// 6. No Vulkan call failed, and the validation layer said nothing.

mod viewfog;

import testing use *;
import libc;
import stdio use *;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;

const SIDE = 128usize;

// A half float, from its two bytes at 'p'
fn halfAt(p: *u8) f32 {
  let h = u32.from(*p) | (u32.from(*(p + 1usize)) << 8u32);
  let sign = if (h & 0x8000u32) != 0u32 { -1.f } else { 1. };
  let e = i32.from((h >> 10u32) & 0x1fu32);
  let m = f32.from(h & 0x3ffu32);
  if e == 0i32 { return sign * m * 0.000000059604645; }
  sign * (1. + m / 1024.) * libc.powf(2., f32.from(e - 15i32))
}

// Channel 'c' of pixel ('x', 'y') of the 128 x 128 rgba16float picture at 'p'
fn px(p: *u8, x: usize, y: usize, c: usize) f32 { halfAt(p + (y * SIDE + x) * 8usize + c * 2usize) }

fn absf(x: f32) f32 { if x < 0. { 0. - x } else { x } }

// The mean of the green channel over the 3 x 3 pixels about ('x', 'y')
fn around(p: *u8, x: usize, y: usize) f32 {
  var sum = 0.f;
  var dy = 0usize;
  while dy < 3usize {
    var dx = 0usize;
    while dx < 3usize {
      sum = sum + px(p, x + dx - 1usize, y + dy - 1usize, 1usize);
      dx = dx + 1usize;
    }
    dy = dy + 1usize;
  }
  sum / 9.
}

// Draw 'list' into the view's picture seen by 'cam' and copy the picture into 'readback'
fn picture(view: &mut RenderView, renderer: &mut Renderer, device: &mut Device, cam: &Camera, light: &Light, list: &DrawList,
    readback: &Buffer) {
  require(view.render(renderer, device, cam, light, list, 1u32), "the view drawn");
  var encoder = device.createCommandEncoder();
  encoder.copyTextureToBuffer(view.texture(renderer), readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

// The whole picture at 'p' as numbers, three to a pixel
fn grab(p: *u8) List[f32] {
  var out = List[f32].withCapacity(SIDE * SIDE * 3usize);
  var i = 0usize;
  while i < SIDE * SIDE {
    out.push(px(p, i % SIDE, i / SIDE, 0usize));
    out.push(px(p, i % SIDE, i / SIDE, 1usize));
    out.push(px(p, i % SIDE, i / SIDE, 2usize));
    i = i + 1usize;
  }
  out
}

// The greatest difference between two pictures, and the greatest value in the first
fn compare(a: &List[f32], b: &List[f32], peak: &mut f32) f32 {
  var worst = 0.f;
  *peak = 0.;
  var i = 0usize;
  while i < a.len() {
    let d = absf(*a[i] - *b[i]);
    if d > worst { worst = d; }
    if *a[i] > *peak { *peak = *a[i]; }
    i = i + 1usize;
  }
  worst
}

// The wall of the first test: a cube thin across the plain camera's way (+x), 'distance' from its
// eye at (-3, 0, 0), 'width' across
fn wall(cube: MeshHandle, material: MaterialHandle, distance: f32, width: f32) DrawList {
  var list = DrawList.empty();
  let turned = Quat.angleAxis(radians(90.), new Vec3(0., 1., 0.));
  list.add(cube, material, Mat4.fromTrs(new Vec3(-3. + distance, 0., 0.), turned, new Vec3(width, width, 0.1)));
  list
}

// The distance a pixel of the fogged picture shows, from the unfogged one and the extinction
fn recovered(fogged: f32, bare: f32, extinction: f32) f32 {
  if fogged <= 0. { return -1.; }
  0. - libc.logf(fogged / bare) / extinction
}

fn main() i32 {
  var instance = Instance.create("render view fog");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  var device = adapter.requestDevice();
  require(device.isValid(), "a device");

  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  require(renderer.isValid(), "the renderer");
  var view = RenderView.create(&mut renderer, &mut device, 128u32, 128u32);
  require(view.isValid(), "a view");
  var readback = device.createBuffer(131072u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  let p = readback.mappedRange();
  let cube = renderer.addMesh(&mut device, &Mesh.cube(0.5));
  let gray = renderer.addMaterial(&mut device, &Material.plain(new Color(0.5, 0.5, 0.5, 1.)));
  let pale = renderer.addMaterial(&mut device, &Material.plain(new Color(0.8, 0.7, 0.5, 1.)));

  // The plain camera at the reflected eye, and the reflected one that sees what it sees
  var plain = Camera.make();
  plain.lookAt(new Vec3(-3., 0., 0.), new Vec3(3., 0., 0.), new Vec3(0., 1., 0.));
  var seer = Camera.make();
  seer.lookAt(new Vec3(1.5, 0., 2.598), new Vec3(-1.5, 0., -2.598), new Vec3(0., 1., 0.));
  let plane = mirrorPlane(new Vec3(0., 0., 0.), new Vec3(0.866, 0., 0.5), new Vec3(1.5, 0., 2.598));
  let reflected = seer.reflectedAbout(plane);
  // The eye of the reflected camera is the plain camera's
  expectFloat(f64.from(reflected.position().x), -3.0, 0.01, "the reflected camera's eye is the plain camera's (x)");
  expectFloat(f64.from(reflected.position().z), 0.0, 0.01, "the reflected camera's eye is the plain camera's (z)");

  // ---- 1. The distance the fog recovers ----
  let ambientOnly = Light.directional(new Vec3(0., -1., 0.), new Color(0., 0., 0., 1.), new Color(1., 1., 1., 1.));
  require(view.enableFog(&mut renderer, &mut device), "the view's fog made");
  let extinction = 0.1f;
  let columns = [64usize, 38usize, 90usize];
  let depths = [6.f, 40.];
  var worstOfFive = 0.f;
  var worstApart = 0.f;
  var w = 0usize;
  while w < 2usize {
    let distance = depths[w];
    let wallList = wall(cube, gray, distance, if distance < 10. { 20. } else { 60. });
    // The unfogged pictures
    view.fog = new FogSettings(enabled: false);
    picture(&mut view, &mut renderer, &mut device, &reflected, &ambientOnly, &wallList, &readback);
    var bareReflected = new Array[f32, 3] <- fill 0f;
    var c = 0usize;
    while c < 3usize { bareReflected[c] = around(p, columns[c], 64usize); c = c + 1usize; }
    picture(&mut view, &mut renderer, &mut device, &plain, &ambientOnly, &wallList, &readback);
    var barePlain = new Array[f32, 3] <- fill 0f;
    c = 0usize;
    while c < 3usize { barePlain[c] = around(p, columns[c], 64usize); c = c + 1usize; }
    // The fogged ones
    view.fog = new FogSettings(enabled: true, density: extinction, albedo: new Color(0., 0., 0., 1.), temporal: 1.,
      maxDistance: 120.);
    view.cutFog();
    picture(&mut view, &mut renderer, &mut device, &reflected, &ambientOnly, &wallList, &readback);
    var seenReflected = new Array[f32, 3] <- fill 0f;
    c = 0usize;
    while c < 3usize { seenReflected[c] = recovered(around(p, columns[c], 64usize), bareReflected[c], extinction); c = c + 1usize; }
    view.cutFog();
    picture(&mut view, &mut renderer, &mut device, &plain, &ambientOnly, &wallList, &readback);
    c = 0usize;
    while c < 3usize {
      // (the table has the centre at 6 away only)
      if !(w == 1usize && c == 0usize) {
        let seenPlain = recovered(around(p, columns[c], 64usize), barePlain[c], extinction);
        let off = absf(seenReflected[c] / distance - 1.);
        let apart = absf(seenReflected[c] / seenPlain - 1.);
        if off > worstOfFive { worstOfFive = off; }
        if apart > worstApart { worstApart = apart; }
        eprint <- "measured: wall "; eprint <- distance; eprint <- " away, pixel x "; eprint <- columns[c];
        eprint <- ": the reflected camera's fog shows "; eprint <- seenReflected[c]; eprint <- ", the plain camera's "; eprint <- seenPlain; eprint <- "\n";
      }
      c = c + 1usize;
    }
    w = w + 1usize;
  }
  expect(worstOfFive < 0.12, "the fog shows each of the five points of a reflected camera at its true distance, within 12%");
  expect(worstApart < 0.03, "and the reflected camera's fog is the plain camera's, within 3%");

  // ---- 2. The picture of a scene with scattering ----
  var scene = DrawList.empty();
  scene.add(cube, pale, Mat4.fromTrs(new Vec3(55., -1.6, 0.), Quat.identity(), new Vec3(100., 0.1, 100.)));
  scene.add(cube, gray, Mat4.fromTrs(new Vec3(7., -0.5, 1.), Quat.angleAxis(0.4, new Vec3(0., 1., 0.)), new Vec3(2., 2., 2.)));
  scene.add(cube, pale, Mat4.fromTrs(new Vec3(12., 0., -2.5), Quat.identity(), new Vec3(2.5, 3., 2.5)));
  scene.add(cube, gray, Mat4.fromTrs(new Vec3(22., 0.5, 3.), Quat.identity(), new Vec3(4., 4., 4.)));
  let sun = Light.directional(new Vec3(-0.5, -0.7, 0.5).normalize(), new Color(3., 3., 3., 1.), new Color(0.3, 0.35, 0.4, 1.));
  view.fog = new FogSettings(enabled: false);
  picture(&mut view, &mut renderer, &mut device, &plain, &sun, &scene, &readback);
  let bare = grab(p);
  view.fog = new FogSettings(enabled: true, density: 0.03, heightDensity: 0.05, heightFalloff: 0.3, baseHeight: -1.5,
    anisotropy: 0.6, temporal: 1., maxDistance: 80.);
  view.cutFog();
  picture(&mut view, &mut renderer, &mut device, &plain, &sun, &scene, &readback);
  let fogPlain = grab(p);
  view.cutFog();
  picture(&mut view, &mut renderer, &mut device, &reflected, &sun, &scene, &readback);
  let fogReflected = grab(p);
  var peak = 0.f;
  let fogChange = compare(&bare, &fogPlain, &mut peak);
  let worst = compare(&fogPlain, &fogReflected, &mut peak);
  eprint <- "measured: scene: the fog changes the picture by up to "; eprint <- fogChange; eprint <- " of a peak of "; eprint <- peak;
  eprint <- "; the reflected camera's fogged picture differs from the plain camera's by up to "; eprint <- worst; eprint <- "\n";
  expect(fogChange > 0.2 * peak, "the fog changes the picture a lot");
  expect(worst < 0.01 * peak, "the reflected camera's fogged picture is the plain camera's");

  // ---- 3. Fog enabled but off ----
  view.fog = new FogSettings(enabled: false);
  picture(&mut view, &mut renderer, &mut device, &reflected, &sun, &scene, &readback);
  let off = grab(p);
  var unfogged = RenderView.create(&mut renderer, &mut device, 128u32, 128u32);
  picture(&mut unfogged, &mut renderer, &mut device, &reflected, &sun, &scene, &readback);
  let without = grab(p);
  expectFloat(f64.from(compare(&off, &without, &mut peak)), 0.0, 0.0, "a view with its fog off draws the picture of a view with none");
  unfogged.release(&mut renderer, &mut device);

  // ---- 4. The history ----
  view.fog = new FogSettings(enabled: true, density: 0.03, heightDensity: 0.05, heightFalloff: 0.3, baseHeight: -1.5,
    anisotropy: 0.6, maxDistance: 80.);
  view.cutFog();
  picture(&mut view, &mut renderer, &mut device, &plain, &sun, &scene, &readback);
  let first = grab(p);
  picture(&mut view, &mut renderer, &mut device, &plain, &sun, &scene, &readback);
  let second = grab(p);
  let drift = compare(&first, &second, &mut peak);
  eprint <- "measured: history: the second picture differs from the first by up to "; eprint <- drift; eprint <- " of a peak of "; eprint <- peak; eprint <- "\n";
  expect(drift < 0.1 * peak, "a second picture blending in the first's volume stays near it");

  // ---- 5. Another grid ----
  // The low tier's cells and slices remake the volume (a stall, before the picture is recorded)
  // and the fog is still right, within 15% of the distance
  let nearWall = wall(cube, gray, 6., 20.);
  view.fog = new FogSettings(enabled: false);
  picture(&mut view, &mut renderer, &mut device, &reflected, &ambientOnly, &nearWall, &readback);
  let bareNear = around(p, 90usize, 64usize);
  view.fog = FogSettings.low();
  view.fog.density = extinction;
  view.fog.albedo = new Color(0., 0., 0., 1.);
  view.fog.temporal = 1.;
  picture(&mut view, &mut renderer, &mut device, &reflected, &ambientOnly, &nearWall, &readback);
  let lowSeen = recovered(around(p, 90usize, 64usize), bareNear, extinction);
  eprint <- "measured: low tier: the wall 6 away shows "; eprint <- lowSeen; eprint <- "\n";
  expect(absf(lowSeen / 6. - 1.) < 0.15, "after the grid changes, the fog shows the wall at its true distance, within 15%");

  view.release(&mut renderer, &mut device);
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done()
}
