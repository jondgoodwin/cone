// The render package's lighting floor on a real GPU with no window: the
// renderer drawing into a Post's half-float frame (64 x 64), which bloom and
// tone mapping carry into an rgba8unorm texture (a channel v stored as
// v x 255, rounded, no sRGB curve), read back and checked. Only a failure
// prints.
//
// 1. Tone mapping, on a frame of one colour (the camera's background, an
//    empty draw list, no sky), bloom off unless said:
//    - none: (0.5, 0.25, 0.125) passes as it is, (127.5, 63.75, 31.9);
//      with bloom on (0.04) too, since the mean of every level's blur of an
//      even field is the field: bloom takes no light away and adds none;
//    - 2 in every channel: none clamps it to 255; Reinhard, 2 / 3, 170;
//      ACES (Narkowicz's fit), 0.91486, 233.3;
//    - AgX takes middle grey, 0.18, to 0.2145 (worked out from the shader's
//      constants in double precision), 54.7.
//    Each to within 1.
// 2. The environment: made at the first render that needs it, once; made
//    again only after the sky is set again.
// 3. The sky behind the scene (AgX): the top middle pixel, looking 20
//    degrees up, is the dusk's zenith, bluer than red; the pixel 7 rows up
//    from the bottom, looking down, the ground, darker than the zenith.
// 4. The physically based material on mesh's sphere (radius 0.5, at the
//    origin; the camera at (0, 0, 3), the sun behind it and 30 degrees up):
//    a white rough dielectric's middle is brighter than black chitin's (a
//    dark base under a clear coat and a film), and both differ from the
//    ground behind them.
//
// It needs a GPU driver with Vulkan 1.3 and SDL2.dll; with the Vulkan SDK,
// validation and synchronization validation are on, and must say nothing.

mod lighting;

import testing use *;
import geomath use *;
import mesh use Mesh;
import gpu use *;
import render use *;

// Channel 'c' of pixel ('x', 'y') of a 64 x 64 rgba8 image at 'p'
fn px(p *u8, x usize, y usize, c usize) i64 { i64[*(p + (y * 64usize + x) * 4usize + c)]; }

fn luma(p *u8, x usize, y usize) i64 { px(p, x, y, 0usize) + px(p, x, y, 1usize) + px(p, x, y, 2usize); }

fn expectPixel(p *u8, x usize, y usize, r f64, g f64, b f64, label &[]u8) {
  expectFloat(f64[px(p, x, y, 0usize)], r, 1d, label);
  expectFloat(f64[px(p, x, y, 1usize)], g, 1d, label);
  expectFloat(f64[px(p, x, y, 2usize)], b, 1d, label);
}

// One frame: 'list' drawn into the post's frame, bloomed and tone-mapped
// into 'color', read back into 'readback'
fn drawFrame(renderer &mut Renderer, post &mut Post, device &mut Device, color &Texture, depth &Texture,
    readback &Buffer, camera &Camera, light &Light, list &DrawList) {
  mut encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, &post.hdr, depth, camera, light, list);
  post.apply(&mut encoder, color);
  encoder.copyTextureToBuffer(color, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn main() i32 {
  mut instance = Instance.create("lighting");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");

  imm target = TextureDescriptor[64u32, 64u32, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC];
  mut color = device.createTexture(&target);
  imm depthDesc = TextureDescriptor[64u32, 64u32, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT];
  mut depth = device.createTexture(&depthDesc);
  mut readback = device.createBuffer(16384u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm p = readback.mappedRange();
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, 64u32, 64u32);
  require(renderer.isValid() and post.isValid(), "a renderer and its post-processing");
  expectUInt(u64[post.levels], 4u64, "a bloom chain of 32, 16, 8 and 4 pixels");

  mut camera = Camera.make();
  camera.fov = radians(40.);
  camera.lookAt(Vec3[0., 0., 3.], Vec3[0., 0., 0.], Vec3[0., 1., 0.]);
  imm light = Light.directional(Vec3[0., -0.5, -0.8660254], Color.gray(2.), Color.gray(0.1));
  mut list = DrawList.empty();

  // ---- 1. Tone mapping ----
  post.bloom = 0.;
  post.toneMapper = TONE_MAP_NONE;
  camera.background = Color[0.5, 0.25, 0.125, 1.];
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectPixel(p, 32usize, 32usize, 127.5, 63.75, 31.875, "no tone mapping: the colour as it is");
  post.bloom = 0.04;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectPixel(p, 32usize, 32usize, 127.5, 63.75, 31.875, "bloom on an even field: the field");
  expectPixel(p, 1usize, 62usize, 127.5, 63.75, 31.875, "and at a corner");
  post.bloom = 0.;
  camera.background = Color[2., 2., 2., 1.];
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectPixel(p, 32usize, 32usize, 255., 255., 255., "2, not tone mapped: clamped");
  post.toneMapper = TONE_MAP_REINHARD;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectPixel(p, 32usize, 32usize, 170., 170., 170., "2 by Reinhard: 2 / 3");
  post.toneMapper = TONE_MAP_ACES;
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectPixel(p, 32usize, 32usize, 233.29, 233.29, 233.29, "2 by ACES's fit");
  post.toneMapper = TONE_MAP_AGX;
  camera.background = Color[0.18, 0.18, 0.18, 1.];
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectPixel(p, 32usize, 32usize, 54.69, 54.71, 54.71, "middle grey by AgX");
  expectUInt(u64[renderer.environment.bakes], 0u64, "no environment made while nothing needs it");

  // ---- 2 and 3. The sky ----
  post.bloom = 0.04;
  imm sky = Sky.dusk(radians(30.), 0.);
  renderer.setSky(&mut device, &sky);
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectUInt(u64[renderer.environment.bakes], 1u64, "the environment made at the first render with a sky");
  expectBool(px(p, 32usize, 1usize, 2usize) > px(p, 32usize, 1usize, 0usize), true, "the zenith, bluer than red");
  expectBool(luma(p, 32usize, 57usize) < luma(p, 32usize, 1usize), true, "the ground, darker than the zenith");
  imm groundLuma = luma(p, 32usize, 32usize);
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectUInt(u64[renderer.environment.bakes], 1u64, "and not made again while the sky is the same");

  // ---- 4. The physically based material ----
  imm sphere = Mesh.sphere(0.5, 32);
  imm ball = renderer.addMesh(&mut device, &sphere);
  imm white = PbrMaterial.standard(Color[0.8, 0.8, 0.8, 1.], 0., 0.6);
  imm whiteM = renderer.addPbrMaterial(&mut device, &white);
  imm chitin = PbrMaterial.chitin(180., 520., 7u32);
  imm chitinM = renderer.addPbrMaterial(&mut device, &chitin);
  list.add(ball, whiteM, Mat4.identity());
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  imm whiteLuma = luma(p, 32usize, 32usize);
  list.clear();
  list.add(ball, chitinM, Mat4.identity());
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  imm chitinLuma = luma(p, 32usize, 32usize);
  expectBool(whiteLuma > chitinLuma + 60, true, "a white rough ball, brighter than black chitin");
  expectBool(whiteLuma - groundLuma > 30 or groundLuma - whiteLuma > 30, true, "the white ball, unlike the ground");
  expectBool(chitinLuma - groundLuma > 6 or groundLuma - chitinLuma > 6, true, "the chitin ball, unlike the ground");
  expectUInt(u64[renderer.drawCalls], 2u64, "two draws: the ball and the sky");

  // The sky set again: the environment made again
  renderer.setSky(&mut device, &sky);
  drawFrame(&mut renderer, &mut post, &mut device, &color, &depth, &readback, &camera, &light, &list);
  expectUInt(u64[renderer.environment.bakes], 2u64, "the sky set again: the environment made again");

  expectUInt(u64[failures()], 0u64, "no Vulkan call failed");
  expectUInt(u64[validationMessages()], 0u64, "no validation message");
  done();
}
