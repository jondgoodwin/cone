// render's custom pipelines, field textures and dynamic meshes, drawn on a
// real GPU with no window into a 64 x 64 rgba8unorm texture (a channel v
// stored as v x 255, rounded) and read back. The camera is offscreen.cone's:
// at (0, 0, 3) looking at the origin, a 50 degree field of view, so the
// cube of half-size 0.5 at the origin fills the middle of the target, and
// the background is (0.2, 0.4, 0.6), stored (51, 102, 153). Only a failure
// prints.
//
// 1. A custom pipeline (custom.slang), reading the position stream alone:
//    its vertex stage reads texel (1, 0)
//    of an r32float field of two texels, (0.2, 0.6), and writes (that,
//    the material's two parameters) times the copy's tint, times the
//    exposure. Parameters (0.4, 0.8): the cube's middle (32, 32) is (0.6,
//    0.4, 0.8), stored (153, 102, 204). One draw.
// 2. Instanced: the cube scaled by 0.4 at x = -0.6 and, tinted grey 0.5, at
//    x = +0.6 (offscreen.cone's case 10): one draw of two instances; the
//    left copy's middle (17, 32) is (153, 102, 204), the right's (47, 32)
//    (76.5, 51, 102).
// 3. Changed: the parameters set to (0.1, 0) and the field written again,
//    (0.2, 1): the middle is (1, 0.1, 0), stored (255, 25.5, 0).
// 4. A dynamic mesh, room for 24 vertices and 36 indices: not drawn until
//    written (no draws, the background); the cube written into it, drawn in
//    the plain lit material of offscreen.cone's case 2 (a light of 0.6 pi
//    head on, ambient 0.2): (102, 51, 204); then a cube of half-size 0.1 at
//    (0.8, 0.8, 0) written over it, drawn in the same frame's render: the
//    middle is the background and (50, 13) is lit. A mesh too big for its
//    room is refused.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll; with the Vulkan SDK,
// validation is on and must say nothing.

mod custom;

import testing use *;
import libc;
import geomath use *;
import collections use * but Queue;
import mesh use Mesh;
import gpu use *;
import render use *;

// Channel 'c' of pixel ('x', 'y') of a 64 x 64 rgba8 image at 'p'
fn px(p *u8, x usize, y usize, c usize) i64 { i64.from(*(p + (y * 64usize + x) * 4usize + c)); }

fn expectPixel(p *u8, x usize, y usize, r i64, g i64, b i64, d f64, label &[]u8) {
  expectFloat(f64.from(px(p, x, y, 0usize)), f64.from(r), d, label);
  expectFloat(f64.from(px(p, x, y, 1usize)), f64.from(g), d, label);
  expectFloat(f64.from(px(p, x, y, 2usize)), f64.from(b), d, label);
}

fn drawFrame(renderer &mut Renderer, device &mut Device, color &Texture, depth &Texture, readback &Buffer,
    camera &Camera, light &Light, list &DrawList) {
  mut encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, color, depth, camera, light, list);
  encoder.copyTextureToBuffer(color, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn main() i32 {
  mut instance = Instance.create("render custom");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize {
    if libc.strcmp(env, &"low-power" as *u8) == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  imm target = new TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut color = device.createTexture(&target);
  imm depthDesc = new TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  mut depth = device.createTexture(&depthDesc);
  mut readback = device.createBuffer(16384u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm p = readback.mappedRange();
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  require(renderer.isValid(), "a renderer");
  mut camera = Camera.make();
  camera.lookAt(new Vec3(0., 0., 3.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.2, 0.4, 0.6, 1.);
  imm headOn = Light.directional(new Vec3(0., 0., -1.), Color.gray(1.8849556), Color.gray(0.2));
  imm cube = Mesh.cube(0.5);
  imm h = renderer.addMesh(&mut device, &cube);
  mut list = DrawList.empty();

  // ---- 1. A custom pipeline ----
  imm sampleTypes = [TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT];
  imm desc = new CustomPipeline(spirv: &CUSTOM_SPIRV, textures: &sampleTypes, streams: 1u32);
  imm pipeline = renderer.addPipeline(&mut device, &desc);
  require(renderer.hasPipeline(pipeline), "the custom pipeline made");
  imm values = [0.2, 0.6];
  imm field = renderer.addFieldTexture(&mut device, 2u32, 1u32, &values);
  imm params = [0.4, 0.8];
  imm maps = [field];
  imm custom = renderer.addCustomMaterial(&mut device, pipeline, &params, &maps);
  expect(!custom.isNone(), "the custom material made");
  list.add(h, custom, Mat4.identity());
  drawFrame(&mut renderer, &mut device, &color, &depth, &readback, &camera, &headOn, &list);
  expectPixel(p, 32usize, 32usize, 153, 102, 204, 1d, "the field's texel and the parameters");
  expectPixel(p, 32usize, 4usize, 51, 102, 153, 0d, "above the cube: the background");
  expectUInt(u64.from(renderer.drawCalls), 1u64, "one draw");

  // ---- 2. Instanced ----
  imm left = Mat4.fromTrs(new Vec3(-0.6, 0., 0.), Quat.identity(), new Vec3(0.4, 0.4, 0.4));
  imm right = Mat4.fromTrs(new Vec3(0.6, 0., 0.), Quat.identity(), new Vec3(0.4, 0.4, 0.4));
  list.clear();
  list.add(h, custom, left);
  list.addTinted(h, custom, right, new Color(0.5, 0.5, 0.5, 1.));
  drawFrame(&mut renderer, &mut device, &color, &depth, &readback, &camera, &headOn, &list);
  expectUInt(u64.from(renderer.drawCalls), 1u64, "two copies: one draw");
  expectUInt(u64.from(renderer.instancesDrawn), 2u64, "of two instances");
  expectPixel(p, 17usize, 32usize, 153, 102, 204, 1d, "the left copy");
  expectPixel(p, 47usize, 32usize, 77, 51, 102, 1d, "the right copy, tinted grey");

  // ---- 3. Changed ----
  imm params2 = [0.1, 0.];
  expect(renderer.setCustomParams(&mut device, custom, &params2), "the parameters set");
  imm values2 = [0.2, 1.];
  expect(renderer.writeFieldTexture(&mut device, field, &values2), "the field written");
  list.clear();
  list.add(h, custom, Mat4.identity());
  drawFrame(&mut renderer, &mut device, &color, &depth, &readback, &camera, &headOn, &list);
  expectPixel(p, 32usize, 32usize, 255, 26, 0, 1d, "the new field and parameters");

  // ---- 4. A dynamic mesh ----
  imm dynamic = renderer.addDynamicMesh(&mut device, 24u32, 36u32);
  imm plainMaterial = Material.plain(new Color(0.5, 0.25, 1., 1.));
  imm plain = renderer.addMaterial(&mut device, &plainMaterial);
  list.clear();
  list.add(dynamic, plain, Mat4.identity());
  drawFrame(&mut renderer, &mut device, &color, &depth, &readback, &camera, &headOn, &list);
  expectUInt(u64.from(renderer.drawCalls), 0u64, "not drawn until written");
  expectPixel(p, 32usize, 32usize, 51, 102, 153, 0d, "the background");
  expect(renderer.writeDynamicMesh(&mut device, dynamic, &cube), "the cube written");
  drawFrame(&mut renderer, &mut device, &color, &depth, &readback, &camera, &headOn, &list);
  expectPixel(p, 32usize, 32usize, 102, 51, 204, 1d, "the cube written, lit head on");
  mut small = Mesh.cube(0.1);
  small.transform(Mat4.fromTranslation(new Vec3(0.8, 0.8, 0.)));
  expect(renderer.writeDynamicMesh(&mut device, dynamic, &small), "a small cube written over it");
  drawFrame(&mut renderer, &mut device, &color, &depth, &readback, &camera, &headOn, &list);
  expectPixel(p, 32usize, 32usize, 51, 102, 153, 0d, "in the same frame: the cube gone");
  expectPixel(p, 50usize, 13usize, 102, 51, 204, 1d, "and the small one drawn");
  imm big = Mesh.sphere(1., 16);
  expectBool(renderer.writeDynamicMesh(&mut device, dynamic, &big), false, "a mesh too big for its room refused");

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}

