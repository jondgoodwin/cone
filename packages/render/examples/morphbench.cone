// morphbench: what the morph pre-pass (morph.cone) costs on this GPU.
//
//   congo run packages/render/examples/morphbench.cone
//   GPU_POWER_PREFERENCE=low-power congo run packages/render/examples/morphbench.cone
//
// A sphere of 10,201 vertices (100 segments) with 64 targets, 8 of them not
// zero, the weights changing every frame so that the pre-pass runs every
// frame; the mean GPU time of 'Morpher.update' alone, in milliseconds, from
// timestamps, over 200 frames after 20 of warm-up. Three sets of targets:
//   sparse   each target moves about a seventh of the vertices
//   dense    each target moves every vertex
//   few      sparse, with only 8 targets in all (all 8 active)
// for one copy, and for 64 copies of the same set (a crowd's faces), each
// with weights of its own. It also times the whole frame of a plain draw of
// the same mesh as modelled, for scale.
//
// Exit status 0 once it has run with no Vulkan failure and no validation
// message.

mod morphbench;

import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;

const FRAMES = 200u32;
const WARM = 20u32;

fn nextRandom(state &mut u32) f32 {
  *state = (*state * 1103u32 + 12345u32) % 65521u32;
  f32.from(*state) / 65521.
}

// 'count' targets over the mesh: each moves the vertices where 'every' divides
// (v + t) (every = 1: all of them), by small random amounts
fn makeTargets(m &Mesh, count usize, every usize) MorphTargets {
  let n = m.positions.len();
  var targets = MorphTargets.empty(n);
  let zero = new Vec3(0., 0., 0.);
  var state = 11u32;
  var t = 0usize;
  while t < count {
    var p = List[Vec3].empty();
    var nm = List[Vec3].empty();
    var v = 0usize;
    while v < n {
      if (v + t) % every == 0usize {
        p.push(new Vec3(nextRandom(&mut state) - 0.5, nextRandom(&mut state) - 0.5, nextRandom(&mut state) - 0.5) * 0.05);
        nm.push(new Vec3(nextRandom(&mut state) - 0.5, nextRandom(&mut state) - 0.5, nextRandom(&mut state) - 0.5) * 0.3);
      } else {
        p.push(zero);
        nm.push(zero);
      }
      v = v + 1usize;
    }
    targets.addDense(&p, &nm, &List[Vec3].empty());
    t = t + 1usize;
  }
  targets
}

// Weights for frame 'f': eight of the targets not zero, moving
fn weightsFor(count usize, f u32, copy usize) List[f32] {
  var w = List[f32].empty();
  var t = 0usize;
  while t < count {
    w.push(0.);
    t = t + 1usize;
  }
  var k = 0usize;
  while k < 8usize {
    let target = (k * 8usize + 3usize + copy) % count;
    w.set(target, 0.5 + 0.5 * sin(f32.from(f) * 0.07 * f32.from(k + 1usize) + f32.from(copy)));
    k = k + 1usize;
  }
  w
}

fn timeCopies(device &mut Device, renderer &mut Renderer, morpher &mut Morpher, copies &List[MorphHandle],
    targetCount usize, queries &QuerySet, resolved &Buffer, readback &Buffer) f64 {
  var gpuTime = 0d;
  var counted = 0u32;
  var f = 0u32;
  while f < FRAMES + WARM {
    var c = 0usize;
    while c < copies.len() {
      morpher.setWeights(renderer, *copies[c], &weightsFor(targetCount, f, c));
      c = c + 1usize;
    }
    var encoder = device.createCommandEncoder();
    encoder.writeTimestamp(queries, 0u32);
    morpher.update(device, &mut encoder, renderer);
    encoder.writeTimestamp(queries, 1u32);
    encoder.resolveQuerySet(queries, 0u32, 2u32, resolved, 0u64);
    encoder.copyBufferToBuffer(resolved, 0u64, readback, 0u64, 16u64);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    if f >= WARM {
      let ticks = readback.mappedRange() as *u64;
      gpuTime = gpuTime + f64.from(*(ticks + 1usize) - *ticks) * f64.from(device.timestampPeriod) * 1.0e-6d;
      counted = counted + 1u32;
    }
    f = f + 1u32;
  }
  gpuTime / f64.from(counted)
}

fn runCase(device &mut Device, renderer &mut Renderer, morpher &mut Morpher, m &Mesh, base MeshHandle, label &str,
    targetCount usize, every usize, copyCount usize, queries &QuerySet, resolved &Buffer, readback &Buffer) {
  let targets = makeTargets(m, targetCount, every);
  let set = morpher.addSet(device, &targets, m);
  var copies = List[MorphHandle].empty();
  var c = 0usize;
  var setup = device.createCommandEncoder();
  while c < copyCount {
    copies.push(morpher.addCopy(device, &mut setup, renderer, base, set, false));
    c = c + 1usize;
  }
  device.queue.submit(setup.finish());
  device.endFrame();
  device.waitIdle();
  let ms = timeCopies(device, renderer, morpher, &copies, targetCount, queries, resolved, readback);
  printStr("  "); printStr(label); printStr(": "); print <- targets.entryCount(); printStr(" entries, ");
  print <- copyCount; printStr(" cop"); printStr(if copyCount == 1usize { "y" } else { "ies" }); printStr(": ");
  printFloat(ms); printStr(" ms");
  if copyCount > 1usize { printStr(" ("); printFloat(ms / f64.from(copyCount) * 1000d); printStr(" us a copy)"); }
  printStr("\n");
  c = 0usize;
  while c < copyCount {
    morpher.removeCopy(device, renderer, *copies[c]);
    c = c + 1usize;
  }
  morpher.removeSet(device, set);
}

fn main() i32 {
  var instance = Instance.create("morph bench");
  if !instance.isValid() { printStr("No Vulkan 1.3 instance\n"); return 1i32; }
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() { printStr("No GPU\n"); return 1i32; }
  printStr("Adapter: "); printStr(adapter.name.view()); printStr("\n");
  var device = adapter.requestDevice();
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var morpher = Morpher.create(&mut device);
  var queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32);
  var resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);
  var readback = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  if !renderer.isValid() or !morpher.isValid() or !queries.isValid() {
    printStr("The renderer, the morpher or the timestamps could not be made\n");
    return 1i32;
  }
  let m = Mesh.sphere(1., 100);
  printStr("Mesh: "); print <- m.positions.len(); printStr(" vertices, "); print <- m.indices.len() / 3usize; printStr(" triangles; ");
  printStr("8 targets active, the weights changing every frame; 'Morpher.update' alone, GPU time\n");
  let base = renderer.addMesh(&mut device, &m);
  runCase(&mut device, &mut renderer, &mut morpher, &m, base, "64 targets, sparse (1 in 7)", 64usize, 7usize, 1usize, &queries, &resolved, &readback);
  runCase(&mut device, &mut renderer, &mut morpher, &m, base, "64 targets, dense", 64usize, 1usize, 1usize, &queries, &resolved, &readback);
  runCase(&mut device, &mut renderer, &mut morpher, &m, base, " 8 targets, sparse (1 in 7)", 8usize, 7usize, 1usize, &queries, &resolved, &readback);
  runCase(&mut device, &mut renderer, &mut morpher, &m, base, "64 targets, sparse (1 in 7)", 64usize, 7usize, 64usize, &queries, &resolved, &readback);
  runCase(&mut device, &mut renderer, &mut morpher, &m, base, "64 targets, dense", 64usize, 1usize, 64usize, &queries, &resolved, &readback);
  printStr("Vulkan failures: "); print <- u64.from(failures()); printStr("; validation messages: "); print <- u64.from(validationMessages()); printStr("\n");
  if failures() != 0u32 or validationMessages() != 0u32 { return 1i32; }
  0i32
}
