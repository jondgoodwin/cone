// xrstereo: the renderer drawing into a headset, one eye after the other, in
// the runtime's frame loop. No window of its own (the runtime shows the
// headset, or Meta's PC simulator shows its), and no audio device. Each eye is
// cleared to a different colour (the left a dull red, the right a dull blue)
// and sees the same little world, a floor with four things at different
// distances ahead, from its own place: the colours say which eye is which, and
// the shift of the near things against the far ones is the stereo.
//
//   congo run packages/render/examples/xrstereo.cone -- [--frames N] [--shot PREFIX] [--validation]
//
// - --frames N: draw N frames and leave (default 300).
// - --shot PREFIX: near the end, copy each eye's image out and write
//   PREFIX-left.bmp and PREFIX-right.bmp.
// - --validation: the Khronos validation layer on the Vulkan instance. Leave
//   it off under Meta's PC simulator, which leaks memory under it.
//
// It needs an OpenXR runtime and a headset (or the simulator): with none it
// says so and exits 1. To use Meta's PC simulator without installing it,
// from a console used only for this run (nothing is set in the registry):
//
//   set XR_RUNTIME_JSON=<simulator folder>\meta_openxr_simulator.json
//   set PATH=<OpenXR loader package>\x64\bin;<SDL3>\lib\x64;%PATH%
//
// It prints the runtime, the system, the size of an eye, and, after a warm-up,
// the mean time of an eye on the CPU (recording and submitting it) and on the
// GPU (between two timestamps round the pass).

mod xrstereo;

import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import path as filepath;
import openxr;

fn cstrEquals(a: *u8, b: &str) bool {
  var i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8
}

// A model matrix of a thing at 'x', 'y', 'z', turned 'angle' about y, 'size' across
fn placed(x: f32, y: f32, z: f32, angle: f32, size: f32) Mat4 {
  Mat4.fromTrs(Vec3(x, y, z), Quat.angleAxis(angle, Vec3(0., 1., 0.)), Vec3(size, size, size))
}

// Write the eye image 'headset' copied out as 'path'
fn writeShot(headset: &Headset, path: &String, label: &str) {
  let bgra = headset.colorFormat == TEXTURE_FORMAT_BGRA8_UNORM_SRGB;
  let image = Image.fromTexels(headset.capturedBytes(), i32.from(headset.eyeWidth), i32.from(headset.eyeHeight), bgra);
  let written = image.save(&filepath.Path.from(path.view()));
  print <- "Screenshot of the "; printStr(label); print <- " eye: "; printStr(path.view());
  if written { print <- "\n"; } else { print <- " could NOT be written\n"; }
}

fn named(prefix: &String, suffix: &str) String {
  var name = prefix.copy();
  name <- suffix;
  name
}

fn main(argc: i32, argv: **u8) i32 {
  var frames = 300u32;
  var prefix = String.empty();
  var validation = false;
  var a = 1;
  while a < argc {
    let arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--frames") && a + 1 < argc {
      let s = *(argv + usize.from(a + 1));
      frames = 0u32;
      var i = 0usize;
      while *(s + i) >= '0' && *(s + i) <= '9' {
        frames = frames * 10u32 + u32.from(*(s + i) - '0');
        i = i + 1usize;
      }
      a = a + 1;
    } else if cstrEquals(arg, "--shot") && a + 1 < argc {
      let s = *(argv + usize.from(a + 1));
      var i = 0usize;
      while *(s + i) != 0u8 {
        prefix.appendByte(*(s + i));
        i = i + 1usize;
      }
      a = a + 1;
    } else if cstrEquals(arg, "--validation") {
      validation = true;
    } else {
      print <- "Unknown argument; use --frames N, --shot PREFIX, --validation\n";
      return 2;
    }
    a = a + 1;
  }
  let shots = prefix.len() > 0usize;

  var options = HeadsetOptions();
  options.validation = validation;
  options.copySource = shots;
  var headset = Headset.open("render xrstereo", &options);
  if !headset.isValid() {
    print <- "No headset could be opened (see above)\n";
    return 1i32;
  }
  print <- "Runtime: "; printStr(headset.runtimeName.view()); print <- "\n";
  print <- "System: "; printStr(headset.systemName.view()); print <- ", each eye ";
  print <- u64.from(headset.eyeWidth); print <- " x "; print <- u64.from(headset.eyeHeight);
  print <- ", reference space "; print <- i64.from(headset.referenceSpace);
  print <- ", format "; print <- u64.from(headset.colorFormat); print <- "\n";

  var renderer = Renderer.create(&mut headset.device, headset.colorFormat, headset.depthFormat);
  if !renderer.isValid() {
    print <- "The renderer could not be made\n";
    return 1i32;
  }
  let cube = Mesh.cube(0.5);
  let sphere = Mesh.sphere(0.5, 24);
  let floor = Mesh.plane(8, 4.);
  let cubeMesh = renderer.addMesh(&mut headset.device, &cube);
  let sphereMesh = renderer.addMesh(&mut headset.device, &sphere);
  let floorMesh = renderer.addMesh(&mut headset.device, &floor);
  let red = renderer.addMaterial(&mut headset.device, &Material.shiny(Color(0.85, 0.15, 0.1, 1.), 0.3, 24.));
  let green = renderer.addMaterial(&mut headset.device, &Material.shiny(Color(0.15, 0.7, 0.2, 1.), 0.3, 24.));
  let yellow = renderer.addMaterial(&mut headset.device, &Material.shiny(Color(0.9, 0.8, 0.1, 1.), 0.5, 48.));
  let white = renderer.addMaterial(&mut headset.device, &Material.shiny(Color(0.85, 0.85, 0.85, 1.), 0.2, 16.));
  let gray = renderer.addMaterial(&mut headset.device, &Material.plain(Color(0.35, 0.35, 0.38, 1.)));
  let light = Light.directional(Vec3(-0.3, -1., -0.4), Color.gray(2.5), Color.gray(0.3));

  var frame = 0u32;
  var after = 0u32;               // frames since the exit was asked for
  var shotsDone = 0u32;
  var cpuFrames = 0u32;
  var eyesPrinted = false;
  while headset.pollEvents() {
    let state = headset.beginFrame();
    if state.active {
      let t = f32.from(frame) * 0.011;
      var list = DrawList.empty();
      list.add(floorMesh, gray, Mat4.fromTrs(Vec3(0., 0., -4.), Quat.identity(), Vec3(4., 1., 4.)));
      list.add(sphereMesh, yellow, placed(0.15, 1.3, -0.9, 0., 0.12));         // 0.9 m ahead: a big shift between the eyes
      list.add(cubeMesh, red, placed(-0.5, 1.2, -1.8, t, 0.4));
      list.add(cubeMesh, green, placed(0.4, 1.0, -2.8, 0. - t, 0.5));
      list.add(cubeMesh, white, placed(-0.1, 1.5, -5., t * 0.5, 1.2));          // 5 m ahead: hardly any
      // Near the end, copy out the left eye on one frame and the right on the next
      let wantShot = shots && state.shouldRender && after == 0u32 && frame + 4u32 >= frames && shotsDone < 2u32;
      if wantShot { headset.captureEye(usize.from(shotsDone)); }
      if state.shouldRender {
        var eye = 0usize;
        while eye < 2usize {
          if !eyesPrinted && state.located {
            // Where the runtime put the eye, and its four angles in degrees
            let v = state.views[eye];
            if eye == 0usize {
              print <- "Frame period "; print <- f64.from(state.displayPeriod) * 1.0e-6; print <- " ms, reference space "; print <- i64.from(headset.referenceSpace); print <- "\n";
            }
            printStr(if eye == 0usize { "Left eye" } else { "Right eye" });
            print <- " at ("; print <- f64.from(v.pose.position.x); print <- ", "; print <- f64.from(v.pose.position.y);
            print <- ", "; print <- f64.from(v.pose.position.z); print <- "), angles left "; print <- f64.from(v.fov.angleLeft) * 57.29578;
            print <- " right "; print <- f64.from(v.fov.angleRight) * 57.29578; print <- " up "; print <- f64.from(v.fov.angleUp) * 57.29578;
            print <- " down "; print <- f64.from(v.fov.angleDown) * 57.29578; print <- "\n";
            if eye == 1usize { eyesPrinted = true; }
          }
          var camera = headset.eyeCamera(&state, eye);
          camera.background = if eye == 0usize { Color(0.45, 0.1, 0.1, 1.) } else { Color(0.1, 0.1, 0.45, 1.) };
          headset.drawEye(&state, eye, &mut renderer, &camera, &light, &list);
          eye = eye + 1usize;
        }
      }
      headset.endFrame(&state);
      if wantShot {
        headset.device.waitIdle();
        if shotsDone == 0u32 { writeShot(&headset, &named(&prefix, "-left.bmp"), "left"); }
        else { writeShot(&headset, &named(&prefix, "-right.bmp"), "right"); }
        shotsDone = shotsDone + 1u32;
      }
      if state.shouldRender {
        cpuFrames = cpuFrames + 1u32;
        if cpuFrames == 30u32 { headset.resetTimes(); }
      }
      frame = frame + 1u32;
    }
    if frame >= frames && after == 0u32 {
      headset.requestExit();
      after = 1u32;
    } else if after > 0u32 {
      after = after + 1u32;
      if after > 600u32 {
        print <- "The session did not end; leaving anyway\n";
        break;
      }
    }
  }
  headset.device.waitIdle();
  print <- "Frames: "; print <- u64.from(frame); print <- ", session state "; printStr(openxr.sessionStateName(headset.sessionState)); print <- "\n";
  var eye = 0usize;
  while eye < 2usize {
    printStr(if eye == 0usize { "Left eye" } else { "Right eye" });
    print <- ": CPU "; print <- headset.cpuMeanMs(eye); print <- " ms ("; print <- u64.from(headset.cpuSamples(eye));
    print <- " frames), GPU "; print <- headset.gpuMeanMs(eye); print <- " ms ("; print <- u64.from(headset.gpuSamples(eye));
    print <- " frames)\n";
    eye = eye + 1usize;
  }
  print <- "Vulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  0i32
}
