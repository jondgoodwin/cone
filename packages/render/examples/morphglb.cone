// morphglb: a glTF with morph targets, loaded, its weights animated by
// keyframetracks, and drawn through render's morph pre-pass (morph.cone).
//
//   congo run --release packages/render/examples/morphglb.cone
//   congo run --release packages/render/examples/morphglb.cone -- --out shot.png
//   GPU_POWER_PREFERENCE=low-power congo run --release packages/render/examples/morphglb.cone
//
// A model is built by hand, as the gltfimport tests build theirs, and written
// as .glb bytes in memory; no file is read. It has two meshes, each with
// morph targets and a weights animation:
//
//   head   a sphere of 64 segments with five targets: 0 "jawOpen" (a dent at
//          the mouth), 1 "smile" (the cheeks lifted), 2 "blink" (lids raised
//          over the eyes), 3 "puff" (the cheeks swollen) and 4 "tall" (the
//          whole sphere stretched along y: a dense target, where the others
//          move a patch). The first four move the surface along its radius,
//          with the normals' displacements worked out from the shape's
//          gradient; "tall" is a stretch, its normals those of an ellipsoid.
//          The animation: neutral at 0 s, then each target to 1 in turn at 1,
//          2, 3 and 4 s, a mixture at 5 s (jaw 0.6, smile 0.8, tall 0.5), and
//          neutral at 6 s.
//   flag   a plane of 24 x 24 squares with two targets, the cloth's height
//          as a wave sin(6x) and as a wave cos(6x), growing from the pole at
//          the left to the free edge at the right. The animation drives
//          their weights (cos p, -sin p), p the phase, and the sum of the two
//          is the wave sin(6x - p) travelling along it: a flag's flutter
//          from two targets and a weight clock, no cloth simulation.
//
// The program loads the .glb with gltfimport, takes each primitive's mesh
// and morph target data into render's MorphTargets, turns each animation's
// weights sampler into a keyframetracks Track and a Clip (PROP_WEIGHTS), and
// draws twelve copies, each of its own weights: the head at 0, 1, 2, 3, 4 and
// 5 s on the top row, the flag at 0, 0.5, 1 ... 2.5 s below. One mesh uploaded
// once, six morphed copies of it, each with a weights list of its own, which
// is what a crowd of animated faces is. It writes the picture as a PNG.
// Exit status 0 if each pose is where the geometry says it should be (the
// jaw open head's mouth is darker than the neutral head's; the stretched head
// is taller; the flag's waves differ in phase) and the GPU said nothing.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.lib on LIB to link;
// GPU_POWER_PREFERENCE=low-power picks an integrated GPU where there are two.

mod morphglb;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import imagedecode use *;
import gltfimport use *;
import keyframetracks as kf;
import gpu use *;
import render use *;
import fs;
import path use Path;

// ---- a glb writer (the gltfimport example's, shortened) ----

struct Bin {
  pub b: List[u8];

  pub fn putU8(self: &mut, v: u8) { b.push(v); }
  pub fn putU16(self: &mut, v: u32) { b.push(u8.from(v & 255u32)); b.push(u8.from((v >> 8u32) & 255u32)); }
  pub fn putU32(self: &mut, v: u32) { self.putU16(v & 0xFFFFu32); self.putU16(v >> 16u32); }
  pub fn putF32(self: &mut, v: f32) { self.putU32(v as u32); }
  pub fn align4(self: &mut) { while b.len() % 4usize != 0usize { b.push(0u8); } }
}

struct Glb {
  pub bin: Bin;
  pub views: String;
  pub nviews: usize;
  pub accessors: String;
  pub naccessors: usize;
}

fn endView(g: &mut Glb, start: usize) usize {
  if g.nviews > 0usize { g.views.append(","); }
  g.views.append("{\"buffer\":0,\"byteOffset\":");
  g.views.appendInt(i64.from(start));
  g.views.append(",\"byteLength\":");
  g.views.appendInt(i64.from(g.bin.b.len() - start));
  g.views.append("}");
  g.bin.align4();
  g.nviews += 1usize;
  g.nviews - 1usize
}

fn addAccessor(g: &mut Glb, view: usize, ctype: i32, count: usize, tname: &str) usize {
  if g.naccessors > 0usize { g.accessors.append(","); }
  g.accessors.append("{\"bufferView\":");
  g.accessors.appendInt(i64.from(view));
  g.accessors.append(",\"componentType\":");
  g.accessors.appendInt(i64.from(ctype));
  g.accessors.append(",\"count\":");
  g.accessors.appendInt(i64.from(count));
  g.accessors.append(",\"type\":\"");
  g.accessors.append(tname);
  g.accessors.append("\"}");
  g.naccessors += 1usize;
  g.naccessors - 1usize
}

// 'points' as a VEC3 float accessor: its number
fn addVec3s(g: &mut Glb, points: &List[Vec3]) usize {
  let s = g.bin.b.len();
  var i = 0usize;
  while i < points.len() {
    g.bin.putF32(points[i].x);
    g.bin.putF32(points[i].y);
    g.bin.putF32(points[i].z);
    i += 1usize;
  }
  addAccessor(g, endView(g, s), 5126, points.len(), "VEC3")
}

// 'values' as a SCALAR float accessor: its number
fn addFloats(g: &mut Glb, values: &List[f32]) usize {
  let s = g.bin.b.len();
  var i = 0usize;
  while i < values.len() {
    g.bin.putF32(*values[i]);
    i += 1usize;
  }
  addAccessor(g, endView(g, s), 5126, values.len(), "SCALAR")
}

fn addIndices(g: &mut Glb, indices: &List[u32]) usize {
  let s = g.bin.b.len();
  var i = 0usize;
  while i < indices.len() {
    g.bin.putU16(*indices[i]);
    i += 1usize;
  }
  addAccessor(g, endView(g, s), 5123, indices.len(), "SCALAR")
}

fn num(s: &mut String, v: usize) { s.appendInt(i64.from(v)); }

// One mesh's JSON: its attributes, indices and the targets 'dp' and 'dn' (one
// list of displacements of the positions and of the normals a target)
fn addMorphMesh(g: &mut Glb, name: &str, m: &Mesh, dp: &List[List[Vec3]], dn: &List[List[Vec3]]) String {
  let pa = addVec3s(g, &m.positions);
  let na = addVec3s(g, &m.normals);
  let ia = addIndices(g, &m.indices);
  var j = String.from("{\"name\":\"");
  j.append(name);
  j.append("\",\"primitives\":[{\"attributes\":{\"POSITION\":");
  num(&mut j, pa);
  j.append(",\"NORMAL\":");
  num(&mut j, na);
  j.append("},\"indices\":");
  num(&mut j, ia);
  j.append(",\"targets\":[");
  var t = 0usize;
  while t < dp.len() {
    let tp = addVec3s(g, dp[t]);
    let tn = addVec3s(g, dn[t]);
    if t > 0usize { j.append(","); }
    j.append("{\"POSITION\":");
    num(&mut j, tp);
    j.append(",\"NORMAL\":");
    num(&mut j, tn);
    j.append("}");
    t += 1usize;
  }
  j.append("]}],\"weights\":[");
  t = 0usize;
  while t < dp.len() {
    if t > 0usize { j.append(","); }
    j.append("0");
    t += 1usize;
  }
  j.append("]}");
  j
}

// ---- the shapes ----

fn smooth(t: f32) f32 {
  let c = if t < 0. { 0. } elif t > 1. { 1. } else { t };
  c * c * (3. - 2. * c)
}

// A bump of height 1 at the unit direction 'c', fading to 0 at 'r' away
fn bump(d: Vec3, c: Vec3, r: f32) f32 { smooth(1. - d.distance(c) / r) }

// The head's radial offset h(d) of target 'target' at the unit direction d
fn headShape(target: usize, d: Vec3) f32 {
  if target == 0usize { return -0.32 * bump(d, Vec3(0., -0.42, 0.9).normalize(), 0.42); }
  if target == 1usize {
    return 0.14 * (bump(d, Vec3(0.55, -0.38, 0.75).normalize(), 0.4) + bump(d, Vec3(-0.55, -0.38, 0.75).normalize(), 0.4));
  }
  if target == 2usize {
    return 0.16 * (bump(d, Vec3(0.38, 0.3, 0.87).normalize(), 0.24) + bump(d, Vec3(-0.38, 0.3, 0.87).normalize(), 0.24));
  }
  if target == 3usize { return 0.22 * (bump(d, Vec3(0.6, -0.2, 0.77).normalize(), 0.7) + bump(d, Vec3(-0.6, -0.2, 0.77).normalize(), 0.7)); }
  0.
}

// The surface normal of the radial shape 1 + h(d) at the unit direction d:
// (1 + h) d minus the gradient of h along the sphere, found by central
// differences in two tangent directions
fn headNormal(target: usize, d: Vec3) Vec3 {
  let eps = 0.002f;
  let alt = if absf(d.y) < 0.9 { Vec3(0., 1., 0.) } else { Vec3(1., 0., 0.) };
  let e1 = d.cross(alt).normalize();
  let e2 = d.cross(e1);
  let g1 = (headShape(target, (d + e1 * eps).normalize()) - headShape(target, (d - e1 * eps).normalize())) / (2. * eps);
  let g2 = (headShape(target, (d + e2 * eps).normalize()) - headShape(target, (d - e2 * eps).normalize())) / (2. * eps);
  (d * (1. + headShape(target, d)) - e1 * g1 - e2 * g2).normalize()
}

fn absf(x: f32) f32 { if x < 0. { 0. - x } else { x } }

const HEAD_TARGETS = 5usize;
const TALL = 0.45f;

// The head's sphere and the displacements of its targets
fn makeHead(dp: &mut List[List[Vec3]], dn: &mut List[List[Vec3]]) Mesh {
  let m = Mesh.sphere(1., 64);
  let n = m.positions.len();
  var t = 0usize;
  while t < HEAD_TARGETS {
    var p = List[Vec3].withCapacity(n);
    var nm = List[Vec3].withCapacity(n);
    var v = 0usize;
    while v < n {
      let d = *m.positions[v];
      if t < 4usize {
        let h = headShape(t, d);
        p.push(d * h);
        nm.push(headNormal(t, d) - d);
      } else {
        // Stretched along y: an ellipsoid's normal is (x, y / (1 + s), z)
        p.push(Vec3(0., TALL * d.y, 0.));
        nm.push(Vec3(d.x, d.y / (1. + TALL), d.z).normalize() - d);
      }
      v += 1usize;
    }
    dp.push(p);
    dn.push(nm);
    t += 1usize;
  }
  m
}

// The flag's height wave at x: grows from the pole (x = -1) to the free edge
fn flagAmplitude(x: f32) f32 { 0.3 * (x + 1.) * 0.5 }

fn flagHeight(target: usize, x: f32) f32 {
  if target == 0usize { return flagAmplitude(x) * sin(6. * x); }
  flagAmplitude(x) * cos(6. * x)
}

fn makeFlag(dp: &mut List[List[Vec3]], dn: &mut List[List[Vec3]]) Mesh {
  let m = Mesh.plane(24, 1.);
  let n = m.positions.len();
  var t = 0usize;
  while t < 2usize {
    var p = List[Vec3].withCapacity(n);
    var nm = List[Vec3].withCapacity(n);
    var v = 0usize;
    while v < n {
      let x = m.positions[v].x;
      let slope = (flagHeight(t, x + 0.002) - flagHeight(t, x - 0.002)) / 0.004;
      p.push(Vec3(0., flagHeight(t, x), 0.));
      nm.push(Vec3(0. - slope, 1., 0.).normalize() - Vec3(0., 1., 0.));
      v += 1usize;
    }
    dp.push(p);
    dn.push(nm);
    t += 1usize;
  }
  m
}

// The .glb's bytes
fn buildGlb() List[u8] {
  var g = Glb(Bin(List[u8].empty()), String.empty(), 0usize, String.empty(), 0usize);
  var hp = List[List[Vec3]].empty();
  var hn = List[List[Vec3]].empty();
  let head = makeHead(&mut hp, &mut hn);
  var fp = List[List[Vec3]].empty();
  var fn2 = List[List[Vec3]].empty();
  let flag = makeFlag(&mut fp, &mut fn2);
  let headJson = addMorphMesh(&mut g, "head", &head, &hp, &hn);
  let flagJson = addMorphMesh(&mut g, "flag", &flag, &fp, &fn2);
  // The head's weights, a key a second: neutral, each target in turn, a mix, neutral
  var headTimes = List[f32].empty();
  var headWeights = List[f32].empty();
  let keys = [[0.f, 0., 0., 0., 0.], [1.f, 0., 0., 0., 0.], [0.f, 1., 0., 0., 0.], [0.f, 0., 1., 0., 0.], [0.f, 0., 0., 1., 0.],
    [0.6f, 0.8, 0., 0., 0.5], [0.f, 0., 0., 0., 0.]];
  var k = 0usize;
  while k < 7usize {
    headTimes.push(f32.from(k));
    var c = 0usize;
    while c < 5usize {
      headWeights.push(keys[k][c]);
      c += 1usize;
    }
    k += 1usize;
  }
  // The flag's weights: (cos p, -sin p), p = 2 pi t / 6, a key every 0.375 s
  var flagTimes = List[f32].empty();
  var flagWeights = List[f32].empty();
  k = 0usize;
  while k <= 16usize {
    let t = f32.from(k) * 0.375;
    let phase = 2. * pi * t / 6.;
    flagTimes.push(t);
    flagWeights.push(cos(phase));
    flagWeights.push(0. - sin(phase));
    k += 1usize;
  }
  let ht = addFloats(&mut g, &headTimes);
  let hw = addFloats(&mut g, &headWeights);
  let ft = addFloats(&mut g, &flagTimes);
  let fw = addFloats(&mut g, &flagWeights);
  var j = String.from("{\"asset\":{\"version\":\"2.0\",\"generator\":\"render morphglb example\"},");
  j.append("\"scene\":0,\"scenes\":[{\"nodes\":[0,1]}],");
  j.append("\"nodes\":[{\"name\":\"head\",\"mesh\":0},{\"name\":\"flag\",\"mesh\":1}],");
  j.append("\"meshes\":[");
  j.append(headJson.view());
  j.append(",");
  j.append(flagJson.view());
  j.append("],\"animations\":[{\"name\":\"idle\",\"samplers\":[{\"input\":");
  num(&mut j, ht);
  j.append(",\"output\":");
  num(&mut j, hw);
  j.append(",\"interpolation\":\"LINEAR\"},{\"input\":");
  num(&mut j, ft);
  j.append(",\"output\":");
  num(&mut j, fw);
  j.append(",\"interpolation\":\"LINEAR\"}],\"channels\":[{\"sampler\":0,\"target\":{\"node\":0,\"path\":\"weights\"}},");
  j.append("{\"sampler\":1,\"target\":{\"node\":1,\"path\":\"weights\"}}]}],");
  j.append("\"buffers\":[{\"byteLength\":");
  j.appendInt(i64.from(g.bin.b.len()));
  j.append("}],\"bufferViews\":[");
  j.append(g.views.view());
  j.append("],\"accessors\":[");
  j.append(g.accessors.view());
  j.append("]}");
  while j.len() % 4usize != 0usize { j.appendByte(' '); }
  var out = Bin(List[u8].empty());
  out.putU32(0x46546C67u32);
  out.putU32(2u32);
  out.putU32(u32.from(12usize + 8usize + j.len() + 8usize + g.bin.b.len()));
  out.putU32(u32.from(j.len()));
  out.putU32(0x4E4F534Au32);
  var i = 0usize;
  while i < j.len() { out.putU8(j[i]); i += 1usize; }
  out.putU32(u32.from(g.bin.b.len()));
  out.putU32(0x004E4942u32);
  i = 0usize;
  while i < g.bin.b.len() { out.putU8(*g.bin.b[i]); i += 1usize; }
  var res = List[u8].empty();
  res <-> out.b;
  res
}

// ---- from a Gltf to morph targets and a clip ----

// A primitive's morph target data as render's MorphTargets
fn targetsOf(p: &GltfPrimitive) MorphTargets {
  var targets = MorphTargets.empty(p.mesh.positions.len());
  var t = 0usize;
  while t < p.targets.len() {
    targets.addDense(&p.targets[t].positions, &p.targets[t].normals, &p.targets[t].tangents);
    t += 1usize;
  }
  targets
}

// The keyframetracks interpolation of a gltfimport sampler's (gltfimport's
// numbers are linear 0, step 1, cubic 2; keyframetracks' are step 0, linear 1,
// cubic 2)
fn interpOf(s: &AnimSampler) u32 {
  if s.interpolation == InterpStep { return kf.GLTF_STEP; }
  if s.interpolation == InterpCubic { return kf.GLTF_CUBICSPLINE; }
  kf.GLTF_LINEAR
}

// A clip with a weights track of each animated node, addressed by node number
fn clipOf(gl: &Gltf, anim: &GltfAnimation) kf.Clip {
  var clip = kf.Clip.make("idle", kf.LOOP_LOOP);
  var c = 0usize;
  while c < anim.channels.len() {
    let ch = anim.channels[c];
    if ch.path == PathWeights {
      let s = anim.samplers[usize.from(ch.sampler)];
      let track = kf.trackFromGltf(kf.TK_VECN, usize.from(s.stride), interpOf(s), &s.times, &s.values);
      clip.addTrack(u32.from(ch.node), kf.PROP_WEIGHTS, track);
    }
    c += 1usize;
  }
  clip.fitLength();
  clip
}

fn cstrEquals(a: *u8, b: &str) bool {
  var i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8
}

fn argString(p: *u8) String {
  var s = String.empty();
  var i = 0usize;
  while *(p + i) != 0u8 { s.appendByte(*(p + i)); i = i + 1usize; }
  s
}

const EYE_DISTANCE = 14.f;

// Head 'i''s place: in a row, each turned to face the camera
fn headModel(i: usize) Mat4 {
  let x = (f32.from(i) - 2.5) * 2.5;
  Mat4.fromTrs(Vec3(x, 1.5, 0.), Quat.angleAxis(atan2(0. - x, EYE_DISTANCE), Vec3(0., 1., 0.)), Vec3(1., 1., 1.))
}

const W = 1500u32;
const H = 760u32;

// The mean of the red channel over the square of pixels about ('cx', 'cy'), half-width 'r'
fn meanRed(px: *u8, cx: i32, cy: i32, r: i32) f32 {
  var sum: f32 = 0.;
  var count: f32 = 0.;
  var y = cy - r;
  while y <= cy + r {
    var x = cx - r;
    while x <= cx + r {
      if x >= 0 && y >= 0 && x < i32.from(W) && y < i32.from(H) {
        sum = sum + f32.from(*(px + (usize.from(y) * usize.from(W) + usize.from(x)) * 4usize));
        count = count + 1.;
      }
      x += 1;
    }
    y += 1;
  }
  sum / count
}

fn main(argc: i32, argv: **u8) i32 {
  var outPath = String.from("morphglb.png");
  var a = 1;
  while a < argc {
    let arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--out") && a + 1 < argc { outPath = argString(*(argv + usize.from(a + 1))); a += 1; }
    a += 1;
  }

  // The model, written to memory and loaded as any file would be
  let bytes = buildGlb();
  var gltf = Gltf.empty();
  match loadGltfBytes(bytes.view(), false) {
    case var Ok(ok) { gltf <-> ok; }
    case let Error(e) { printStr("Could not load: "); printStr(e.reason.view()); printStr("\n"); return 1; }
  }
  printStr("Loaded a .glb of "); print <- bytes.len(); printStr(" bytes: "); print <- gltf.meshes.len(); printStr(" meshes, ");
  print <- gltf.meshes[0].primitives[0].targets.len(); printStr(" morph targets on the head, ");
  print <- gltf.meshes[1].primitives[0].targets.len(); printStr(" on the flag, ");
  print <- gltf.animations.len(); printStr(" animation\n");
  let headPrim = gltf.meshes[0].primitives[0];
  let flagPrim = gltf.meshes[1].primitives[0];
  let headTargets = targetsOf(headPrim);
  let flagTargets = targetsOf(flagPrim);
  let clip = clipOf(&gltf, gltf.animations[0]);
  printStr("The clip is "); printFloat(f64.from(clip.length)); printStr(" s long, with "); print <- clip.bindings.len(); printStr(" weights tracks\n");

  // The GPU, with no window
  var instance = Instance.create("morph glb");
  if !instance.isValid() { printStr("No Vulkan 1.3 instance\n"); return 1; }
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let powerEnv = libc.getenv("GPU_POWER_PREFERENCE");
  if (powerEnv as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(powerEnv), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() { printStr("No GPU\n"); return 1; }
  printStr("Adapter: "); printStr(adapter.name.view()); printStr("\n");
  var device = adapter.requestDevice();
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, W, H);
  var morpher = Morpher.create(&mut device);
  if !renderer.isValid() || !post.isValid() || !morpher.isValid() { printStr("The renderer could not be made\n"); return 1; }
  let targetDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var target = device.createTexture(&targetDesc);
  let depthDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);

  // The meshes, the sets of targets and the copies
  let headMesh = renderer.addMesh(&mut device, &headPrim.mesh);
  let flagMesh = renderer.addMesh(&mut device, &flagPrim.mesh);
  let headSet = morpher.addSet(&mut device, &headTargets, &headPrim.mesh);
  let flagSet = morpher.addSet(&mut device, &flagTargets, &flagPrim.mesh);
  printStr("Sets: head "); print <- headTargets.entryCount(); printStr(" entries, flag "); print <- flagTargets.entryCount(); printStr(" entries\n");
  var heads = List[MorphHandle].empty();
  var flags = List[MorphHandle].empty();
  {
    var setup = device.createCommandEncoder();
    var i = 0usize;
    while i < 6usize {
      heads.push(morpher.addCopy(&mut device, &mut setup, &mut renderer, headMesh, headSet, false));
      flags.push(morpher.addCopy(&mut device, &mut setup, &mut renderer, flagMesh, flagSet, false));
      i += 1usize;
    }
    device.queue.submit(setup.finish());
    device.endFrame();
    device.waitIdle();
  }

  // The weights: each copy sampled from the clip at a time of its own
  var weights = List[f32].empty();
  var i = 0usize;
  while i < 6usize {
    let headSample = clip.sample(f32.from(i));
    headSample.raw(0u32, kf.PROP_WEIGHTS, &mut weights);
    morpher.setWeights(&mut renderer, *heads[i], &weights);
    let flagSample = clip.sample(f32.from(i) * 0.5);
    flagSample.raw(1u32, kf.PROP_WEIGHTS, &mut weights);
    morpher.setWeights(&mut renderer, *flags[i], &weights);
    i += 1usize;
  }
  printStr("Active targets: head at 0..5 s:");
  i = 0usize;
  while i < 6usize { printStr(" "); print <- u64.from(morpher.activeCount(*heads[i])); i += 1usize; }
  printStr("\n");

  // The scene
  let skin = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(Color(0.86, 0.62, 0.5, 1.), 0., 0.55));
  let eyeMaterial = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(Color(0.02, 0.02, 0.03, 1.), 0., 0.12));
  let flagMaterial = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(Color(0.8, 0.12, 0.1, 1.), 0., 0.6));
  let poleMaterial = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(Color(0.35, 0.3, 0.25, 1.), 0., 0.7));
  let eyeBall = Mesh.sphere(1., 20);
  let eyeHandle = renderer.addMesh(&mut device, &eyeBall);
  let poleBox = Mesh.cube(1.);
  let poleHandle = renderer.addMesh(&mut device, &poleBox);
  var list = DrawList.empty();
  i = 0usize;
  while i < 6usize {
    let x = (f32.from(i) - 2.5) * 2.5;
    // Each head turned towards the camera, its eyes in its own coordinates
    let model = headModel(i);
    list.add(morpher.mesh(*heads[i]), skin, model);
    list.add(eyeHandle, eyeMaterial, model * Mat4.fromTrs(Vec3(0.37, 0.29, 0.86), Quat.identity(), Vec3(0.1, 0.1, 0.1)));
    list.add(eyeHandle, eyeMaterial, model * Mat4.fromTrs(Vec3(-0.37, 0.29, 0.86), Quat.identity(), Vec3(0.1, 0.1, 0.1)));
    // The flag, stood up (the plane turned a quarter about x so its +y is +z), the pole at its left edge,
    // all turned a third of a quarter about y so the waves are seen from the side
    let group = Mat4.fromTrs(Vec3(x, -1.5, 0.), Quat.angleAxis(radians(-25.), Vec3(0., 1., 0.)), Vec3(1., 1., 1.));
    let faceUp = Quat.angleAxis(radians(90.), Vec3(1., 0., 0.));
    list.add(morpher.mesh(*flags[i]), flagMaterial,
      group * Mat4.fromTrs(Vec3(0.1, 0., 0.), faceUp, Vec3(1., 1., 0.62)));
    list.add(poleHandle, poleMaterial, group * Mat4.fromTrs(Vec3(-0.92, -0.2, 0.), Quat.identity(), Vec3(0.035, 1.05, 0.035)));
    i += 1usize;
  }
  let sky = Sky.dusk(radians(30.), radians(35.));
  renderer.setSky(&mut device, &sky);
  let light = sky.sunLight(Color(3.0, 2.6, 2.2, 1.), Color(0.1, 0.11, 0.14, 1.));
  var camera = Camera.make();
  camera.fov = radians(30.);
  camera.near = 0.2;
  camera.far = 100.;
  camera.background = Color(0.05, 0.06, 0.08, 1.);
  camera.lookAt(Vec3(0., 0., EYE_DISTANCE), Vec3(0., 0., 0.), Vec3(0., 1., 0.));
  post.bloom = 0.03;

  // Two frames (the first makes the environment), the second read back
  var readback = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var f = 0;
  while f < 2 {
    renderer.time = 0.;
    var encoder = device.createCommandEncoder();
    morpher.update(&mut device, &mut encoder, &renderer);
    renderer.render(&mut device, &mut encoder, &post.hdr, &depth, &camera, &light, &list);
    post.apply(&mut encoder, &target);
    if f == 1 { encoder.copyTextureToBuffer(&target, &readback); }
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    if f == 0 { printStr("The first frame recomputed "); print <- u64.from(morpher.dispatches); printStr(" copies\n"); }
    f += 1;
  }
  let px = readback.mappedRange();
  printStr("Frame: "); print <- u64.from(renderer.drawCalls); printStr(" draws, "); print <- renderer.triangles; printStr(" triangles\n");

  // The picture, written as a PNG
  var shot = Raster.empty();
  shot.width = i32.from(W);
  shot.height = i32.from(H);
  shot.depth = 8;
  shot.colorSpace = ColorSpace.Srgb;
  shot.pixels8.resize(usize.from(W) * usize.from(H) * 4usize, 255u8);
  var y = 0usize;
  while y < usize.from(H) {
    var x = 0usize;
    while x < usize.from(W) {
      let s = (y * usize.from(W) + x) * 4usize;
      shot.pixels8.set(s, *(px + s));
      shot.pixels8.set(s + 1usize, *(px + s + 1usize));
      shot.pixels8.set(s + 2usize, *(px + s + 2usize));
      x += 1usize;
    }
    y += 1usize;
  }
  let png = encodePng(&shot, 2);
  let op = Path.from(outPath.view());
  fs.writeFile(&op, png.view());
  printStr("Wrote "); printStr(outPath.view()); printStr(" ("); print <- png.len(); printStr(" bytes)\n");

  // The check: the middle of the jaw-open head's mouth (the second head), where the surface
  // is dented by 0.32 of the radius, is darker than the same place on the neutral head (the
  // first), whose surface is where it was modelled
  let projection = camera.projectionMatrix(f32.from(W) / f32.from(H)) * camera.viewMatrix();
  let mouthDirection = Vec3(0., -0.42, 0.9).normalize();
  let mouthNeutral = projection.projectPoint(headModel(0usize).transformPoint(mouthDirection));
  let mouthOpen = projection.projectPoint(headModel(1usize).transformPoint(mouthDirection * 0.68));
  let mx0 = i32.from((mouthNeutral.x + 1.) * 0.5 * f32.from(W));
  let my0 = i32.from((1. - mouthNeutral.y) * 0.5 * f32.from(H));
  let mx1 = i32.from((mouthOpen.x + 1.) * 0.5 * f32.from(W));
  let my1 = i32.from((1. - mouthOpen.y) * 0.5 * f32.from(H));
  let neutralRed = meanRed(px, mx0, my0, 3);
  let openRed = meanRed(px, mx1, my1, 3);
  printStr("Mouth, mean red: neutral "); printFloat(f64.from(neutralRed)); printStr(", jaw open "); printFloat(f64.from(openRed)); printStr("\n");
  printStr("Vulkan failures: "); print <- u64.from(failures()); printStr("; validation messages: "); print <- u64.from(validationMessages()); printStr("\n");
  if openRed > neutralRed * 0.9 { printStr("FAILED: the open mouth is not darker than the shut one\n"); return 1; }
  if failures() != 0u32 || validationMessages() != 0u32 { return 1; }
  printStr("OK\n");
  0
}
