// visibility: a forest of 50,000 trees and rocks behind a wall, drawn by the
// scene (visibility.cone) with its switches turned on one at a time, and the
// time each costs. No window: it draws into a 1920 x 1080 sRGB texture and
// times the GPU's pass with timestamps (many frames over) and the CPU's
// part of the frame (gathering the scene, writing the buffers, recording and
// submitting) with the performance counter.
//
//   congo run --release packages/render/examples/visibility.cone
//   congo run --release packages/render/examples/visibility.cone -- --shot visibility
//
// The forest is 35,000 trees (a trunk and a crown, three levels of detail)
// and 15,000 rocks (two) scattered over 700 m by 700 m. Two views: "wall", a
// camera behind a wall 120 m wide and 14 m high 40 m in front of it, which
// hides most of the forest the camera is turned to; and "open", the same
// camera turned along the forest, where nothing is hidden and the occlusion
// pass is cost alone. For each view: everything off (every instance drawn,
// every level 0), frustum culling, culling with levels of detail, and all of
// that with the depth pyramid. '--shot PREFIX' writes the wall view with the
// switches off and with all on, to PREFIX-wall-off.bmp and PREFIX-wall-on.bmp.
//
// GPU_POWER_PREFERENCE=low-power runs it on the integrated GPU where there are
// two. With the Vulkan SDK, validation is on, and must say nothing.

mod visibilitydemo;

import stdio use *;
import libc;
import sdl;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import path as filepath;

const W = 1920u32;
const H = 1080u32;
const FRAMES = 40u32;
const TREES = 35000;
const ROCKS = 15000;

fn cstrEquals(a *u8, b &str) bool {
  mut i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8;
}

fn scatter(n u32) f32 {
  mut x = n * 747796405u32 + 2891336453u32;
  x = ((x >> ((x >> 28u32) + 4u32)) ^ x) * 277803737u32;
  x = (x >> 22u32) ^ x;
  f32.from(x & 0xFFFFu32) / 65535.;
}

// A tree: a trunk and a crown, the crown a sphere of 'segments'
fn treeMesh(segments i32) Mesh {
  mut m = Mesh.cube(1.);
  m.transform(Mat4.fromTrs(new Vec3(0., 1.5, 0.), Quat.identity(), new Vec3(0.25, 1.5, 0.25)));
  mut crown = Mesh.sphere(2., segments);
  crown.transform(Mat4.fromTranslation(new Vec3(0., 4.5, 0.)));
  m.append(&crown);
  m;
}

fn rockMesh(segments i32) Mesh {
  mut m = Mesh.sphere(1., segments);
  m.transform(Mat4.fromTrs(new Vec3(0., 0.4, 0.), Quat.identity(), new Vec3(1., 0.6, 0.8)));
  m;
}

struct Forest {
  trees LodChain;
  rocks LodChain;
  treeMaterial MaterialHandle;
  rockMaterial MaterialHandle;
  wallMaterial MaterialHandle;
  groundMaterial MaterialHandle;
  wall MeshHandle;
  ground MeshHandle;
}

fn buildForest(renderer &mut Renderer, device &mut Device) Forest {
  mut trees = LodChain.empty(0.15);
  trees.add(renderer.addMesh(device, &treeMesh(20)), 120.);
  trees.add(renderer.addMesh(device, &treeMesh(10)), 35.);
  trees.add(renderer.addMesh(device, &treeMesh(5)), 0.);
  mut rocks = LodChain.empty(0.15);
  rocks.add(renderer.addMesh(device, &rockMesh(14)), 40.);
  rocks.add(renderer.addMesh(device, &rockMesh(6)), 0.);
  imm tm = PbrMaterial.standard(new Color(0.18, 0.30, 0.10, 1.), 0., 0.8);
  imm rm = PbrMaterial.standard(new Color(0.35, 0.34, 0.32, 1.), 0., 0.9);
  imm wm = PbrMaterial.standard(new Color(0.55, 0.45, 0.35, 1.), 0., 0.7);
  imm gm = PbrMaterial.standard(new Color(0.22, 0.30, 0.12, 1.), 0., 1.);
  imm cube = renderer.addMesh(device, &Mesh.cube(1.));
  imm plane = renderer.addMesh(device, &Mesh.plane(1, 1.));
  new Forest(trees, rocks, renderer.addPbrMaterial(device, &tm), renderer.addPbrMaterial(device, &rm),
    renderer.addPbrMaterial(device, &wm), renderer.addPbrMaterial(device, &gm), cube, plane);
}

// Put the forest in the scene: the trees and rocks (with their chains), the wall, the ground
fn plant(renderer &mut Renderer, f &Forest) {
  renderer.addSceneItem(f.ground, f.groundMaterial, Mat4.fromTrs(new Vec3(0., 0., 0.), Quat.identity(), new Vec3(400., 1., 400.)),
    new Color(1., 1., 1., 1.));
  imm wall = renderer.addSceneItem(f.wall, f.wallMaterial, Mat4.fromTrs(new Vec3(0., 7., 100.), Quat.identity(), new Vec3(60., 7., 1.5)),
    new Color(1., 1., 1., 1.));
  renderer.setSceneOccludable(wall, false);
  mut i = 0;
  mut placed = 0;
  while placed < TREES + ROCKS {
    imm n = u32.from(i);
    imm x = (scatter(n * 3u32) - 0.5) * 700.;
    imm z = (scatter(n * 3u32 + 1u32) - 0.5) * 700.;
    imm s = 0.7 + scatter(n * 3u32 + 2u32) * 0.9;
    imm turn = scatter(n * 7u32 + 5u32) * 6.28;
    // A clearing in front of the wall, where the cameras stand
    if z > 105. {
      i = i + 1;
      continue;
    }
    imm model = Mat4.fromTrs(new Vec3(x, 0., z), Quat.angleAxis(turn, new Vec3(0., 1., 0.)), new Vec3(s, s, s));
    mut item = SceneHandle.none();
    if placed < TREES {
      item = renderer.addSceneItem(*f.trees.levels[0usize], f.treeMaterial, model, new Color(1., 1., 1., 1.));
      renderer.setSceneLod(item, &f.trees);
    } else {
      item = renderer.addSceneItem(*f.rocks.levels[0usize], f.rockMaterial, model, new Color(1., 1., 1., 1.));
      renderer.setSceneLod(item, &f.rocks);
    }
    renderer.setSceneRange(item, 0., 330., 30.);
    placed = placed + 1;
    i = i + 1;
  }
}

fn seconds(from u64, to u64) f64 { f64.from(to - from) / f64.from(sdl.GetPerformanceFrequency()); }

// What a configuration cost: the mean GPU and CPU milliseconds of a frame
struct Cost {
  gpu f64;
  cpu f64;
}

fn timeFrames(device &mut Device, renderer &mut Renderer, out &Texture, depth &Texture, queries &QuerySet,
    resolved &Buffer, readback &Buffer, camera &Camera, light &Light) Cost {
  imm empty = DrawList.empty();
  mut gpuTime = 0d;
  mut cpuTime = 0d;
  mut counted = 0u32;
  mut f = 0u32;
  while f < FRAMES {
    imm t0 = sdl.GetPerformanceCounter();
    mut encoder = device.createCommandEncoder();
    encoder.writeTimestamp(queries, 0u32);
    renderer.render(device, &mut encoder, out, depth, camera, light, &empty);
    encoder.writeTimestamp(queries, 1u32);
    encoder.resolveQuerySet(queries, 0u32, 2u32, resolved, 0u64);
    encoder.copyBufferToBuffer(resolved, 0u64, readback, 0u64, 16u64);
    device.queue.submit(encoder.finish());
    imm t1 = sdl.GetPerformanceCounter();
    device.endFrame();
    device.waitIdle();
    if f >= 8u32 {
      imm ticks = readback.mappedRange() as *u64;
      gpuTime = gpuTime + f64.from(*(ticks + 1usize) - *ticks) * f64.from(device.timestampPeriod) * 1.0e-6d;
      cpuTime = cpuTime + seconds(t0, t1) * 1000d;
      counted = counted + 1u32;
    }
    f = f + 1u32;
  }
  new Cost(gpuTime / f64.from(counted), cpuTime / f64.from(counted));
}

fn report(name &str, c &Cost, renderer &Renderer) {
  printStr(name); print <- ": GPU "; print <- c.gpu; print <- " ms, CPU "; print <- c.cpu; print <- " ms; ";
  print <- u64.from(renderer.vis.stats.candidates); print <- " items past the frustum, ";
  print <- u64.from(renderer.instancesDrawn); print <- " instances, "; print <- u64.from(renderer.drawCalls);
  print <- " draws, "; print <- renderer.triangles; print <- " triangles\n";
}

fn shoot(device &mut Device, renderer &mut Renderer, out &Texture, depth &Texture, camera &Camera, light &Light, name &String) {
  imm empty = DrawList.empty();
  mut shot = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, out, depth, camera, light, &empty);
  encoder.copyTextureToBuffer(out, &shot);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  imm image = Image.fromTexels(shot.mappedRange(), i32.from(W), i32.from(H), false);
  imm written = image.save(&filepath.Path.from(name.view()));
  print <- "Screenshot: "; printStr(name.view());
  if written { print <- "\n"; } else { print <- " could NOT be written\n"; }
}

fn main(argc i32, argv **u8) i32 {
  mut prefix = String.empty();
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--shot") and a + 1 < argc {
      imm s = *(argv + usize.from(a + 1));
      mut i = 0usize;
      while *(s + i) != 0u8 {
        prefix.appendByte(*(s + i));
        i = i + 1usize;
      }
      a = a + 1;
    } else {
      print <- "Unknown argument; use --shot PREFIX\n";
      return 2;
    }
    a = a + 1;
  }
  mut instance = Instance.create("render visibility");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() {
    print <- "No GPU\n";
    return 1i32;
  }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  mut device = adapter.requestDevice();
  imm outDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut out = device.createTexture(&outDesc);
  imm depthDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
  mut depth = device.createTexture(&depthDesc);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32);
  mut resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);
  mut readback = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  if !renderer.isValid() or !queries.isValid() {
    print <- "The renderer or the timestamps could not be made\n";
    return 1i32;
  }
  imm sky = Sky.dusk(radians(35.), radians(235.));
  renderer.setSky(&mut device, &sky);
  imm light = sky.sunLight(new Color(3.2, 2.9, 2.4, 1.), new Color(0.05, 0.06, 0.08, 1.));
  imm forest = buildForest(&mut renderer, &mut device);
  plant(&mut renderer, &forest);
  print <- "Scene: "; print <- u64.from(renderer.vis.count()); print <- " items\n";

  mut wall = Camera.make();
  wall.fov = radians(60.);
  wall.near = 0.3;
  wall.far = 400.;
  wall.lookAt(new Vec3(0., 3., 140.), new Vec3(0., 6., 0.), new Vec3(0., 1., 0.));
  wall.background = new Color(0.4, 0.5, 0.7, 1.);
  mut open = wall;
  open.lookAt(new Vec3(200., 3., 120.), new Vec3(200., 6., -100.), new Vec3(0., 1., 0.));

  mut views = List[Camera].empty();
  views.push(wall);
  views.push(open);
  mut viewNames = List[String].empty();
  viewNames.push(String.from("wall"));
  viewNames.push(String.from("open"));
  mut v = 0usize;
  while v < 2usize {
    imm camera = views[v];
    printStr(viewNames[v].view()); print <- " view:\n";
    // Everything off
    renderer.vis.settings = VisibilitySettings.off();
    imm offCost = timeFrames(&mut device, &mut renderer, &out, &depth, &queries, &resolved, &readback, camera, &light);
    report("  everything off              ", &offCost, &renderer);
    if v == 0usize and prefix.len() > 0usize {
      mut name = prefix.copy();
      name <- "-wall-off.bmp";
      shoot(&mut device, &mut renderer, &out, &depth, camera, &light, &name);
    }
    // Frustum culling
    renderer.vis.settings = VisibilitySettings.off();
    renderer.vis.settings.frustumCulling = true;
    imm cullCost = timeFrames(&mut device, &mut renderer, &out, &depth, &queries, &resolved, &readback, camera, &light);
    report("  frustum culling             ", &cullCost, &renderer);
    // With levels of detail and ranges
    renderer.vis.settings = new VisibilitySettings();
    imm lodCost = timeFrames(&mut device, &mut renderer, &out, &depth, &queries, &resolved, &readback, camera, &light);
    report("  + levels, ranges, fades     ", &lodCost, &renderer);
    // And the depth pyramid
    renderer.vis.settings.occlusion = true;
    renderer.vis.settings.occlusionStats = true;
    imm occCost = timeFrames(&mut device, &mut renderer, &out, &depth, &queries, &resolved, &readback, camera, &light);
    report("  + occlusion (depth pyramid) ", &occCost, &renderer);
    renderer.hiz[0usize].readStats();
    print <- "      the pyramid passed "; print <- u64.from(renderer.hiz[0usize].passed0); print <- " in the first test and "; print <- u64.from(renderer.hiz[0usize].passed1);
    print <- " in the retest of "; print <- u64.from(renderer.hiz[0usize].candidateCount); print <- " candidates\n";
    if v == 0usize and prefix.len() > 0usize {
      mut name = prefix.copy();
      name <- "-wall-on.bmp";
      shoot(&mut device, &mut renderer, &out, &depth, camera, &light, &name);
    }
    // The same on the finest levels only (levels off): the heavy case occlusion is for
    renderer.vis.settings.lod = false;
    renderer.vis.settings.occlusionStats = false;
    imm heavy = timeFrames(&mut device, &mut renderer, &out, &depth, &queries, &resolved, &readback, camera, &light);
    report("  levels off, occlusion       ", &heavy, &renderer);
    renderer.vis.settings.occlusion = false;
    imm heavyOff = timeFrames(&mut device, &mut renderer, &out, &depth, &queries, &resolved, &readback, camera, &light);
    report("  levels off, no occlusion    ", &heavyOff, &renderer);
    v = v + 1usize;
  }
  device.waitIdle();
  print <- "Validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  0i32;
}
