// lanterns: point lights (lights.cone) on a dusk path, the motivating case: a
// boardwalk of planks through grass, a dozen solar path lanterns along it,
// each a warm bulb in a frame under a roof, lighting the planks and the grass
// round it, the underside of its own roof and its inner frame, in the colours
// of what it lights (modulating them, not painted over them). No window: it
// draws into a 1920 x 1080 half-float frame, bloomed and tone-mapped into an
// sRGB texture, and times the GPU's pass with timestamps.
//
//   congo run packages/render/examples/lanterns.cone
//   congo run packages/render/examples/lanterns.cone -- --shot lanterns
//
// It prints, for 0, 16, 64 and 256 lights in the scene, the GPU time in
// milliseconds of 'render' (the mean of 60 frames after 10), the CPU time of
// the light assignment ('lights.prepare', microseconds), the lights that
// reach the view, the (light, cluster) pairs and the most a cluster holds.
// The first 24 lights are the lanterns' (two each: the pool light, which
// lights everything near, and the interior light, which is "local only":
// layer 1, a range of 0.35 m, lighting the lantern's own frame and roof);
// the rest are lamps scattered along the path and over the grass.
// '--shot PREFIX' also writes PREFIX-on.bmp (the lanterns lit), PREFIX-off.bmp
// (the same scene without light sources: the bulbs glow and nothing else, as
// the browser's painted pools had it), PREFIX-nointerior.bmp (the pool lights
// without the interior ones) and PREFIX-crowd.bmp (256 lights).
//
// GPU_POWER_PREFERENCE=low-power runs it on the integrated GPU where there
// are two. With the Vulkan SDK, validation is on, and must say nothing.

mod lanternsdemo;

import stdio use *;
import libc;
import sdl;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import path as filepath;

const W = 1920u32;
const H = 1080u32;
const FRAMES = 70u32;

fn cstrEquals(a *u8, b &str) bool {
  mut i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8;
}

// A small hash to scatter things: a number from 0 to 1 from 'n'
fn scatter(n u32) f32 {
  mut x = n * 747796405u32 + 2891336453u32;
  x = ((x >> ((x >> 28u32) + 4u32)) ^ x) * 277803737u32;
  x = (x >> 22u32) ^ x;
  f32.from(x & 0xFFFFu32) / 65535.;
}

fn byteOf(v f32) u8 {
  mut c = v;
  if c < 0. { c = 0.; }
  if c > 1. { c = 1.; }
  u8.from(c * 255. + 0.5);
}

// Four planks laid one above the next (each a quarter of the picture's
// height, running across it), a dark gap between them, wood grain along them
fn plankImage() Image {
  mut img = new Image(128, 128, 3, List[u8].empty());
  mut y = 0;
  while y < 128 {
    imm plank = y / 32;
    imm row = y % 32;
    imm tone = 0.8 + 0.4 * scatter(u32.from(plank) * 977u32 + 5u32);
    mut x = 0;
    while x < 128 {
      imm grain = 0.84 + 0.16 * (f32.from(x) * 0.31 + 4. * scatter(u32.from(plank * 32 + row / 5)) + 6. * scatter(u32.from(row * 7 + plank))).sin();
      imm speck = 0.92 + 0.16 * scatter(u32.from(y * 128 + x));
      mut k = tone * grain * speck;
      if row < 2 { k = 0.12; }
      img.pixels.push(byteOf(0.60 * k));
      img.pixels.push(byteOf(0.42 * k));
      img.pixels.push(byteOf(0.26 * k));
      x = x + 1;
    }
    y = y + 1;
  }
  img;
}

// Grass: green speckled with lighter and darker blades
fn grassImage() Image {
  mut img = new Image(128, 128, 3, List[u8].empty());
  mut y = 0;
  while y < 128 {
    mut x = 0;
    while x < 128 {
      imm a = scatter(u32.from(y * 128 + x));
      imm b = scatter(u32.from(y * 128 + x) + 70001u32);
      imm blade = 0.5 + 0.7 * a * a;
      img.pixels.push(byteOf(0.20 * blade + 0.10 * b));
      img.pixels.push(byteOf(0.42 * blade + 0.12 * b));
      img.pixels.push(byteOf(0.08 * blade));
      x = x + 1;
    }
    y = y + 1;
  }
  img;
}

struct Meshes {
  plane MeshHandle;
  cube MeshHandle;
  sphere MeshHandle;
  bulb MeshHandle;
}

struct Materials {
  planks MaterialHandle;
  grass MaterialHandle;
  frame MaterialHandle;
  panel MaterialHandle;
  glass MaterialHandle;
  bulb MaterialHandle;
  bush MaterialHandle;
  stone MaterialHandle;
  beam MaterialHandle;
}

// A light as planned: the scene's first 'n' are put in the renderer
struct Planned {
  position Vec3;
  color Color;
  candela f32;
  range f32;
  radius f32;
  layers u32;
}

struct World {
  list DrawList;
  planned List[Planned];       // the lanterns' lights first, then the scattered ones
  lanternLights u32;           // how many of them the lanterns' are
}

// The lamps' warm colour: about 2700 K, an incandescent bulb's, in linear RGB
fn lampColor() Color { new Color(1., 0.397, 0.0953, 1.); }

// A lantern standing at (x, z), about 0.6 m tall: a stake, a base plate, a
// glass box held by four posts, two tiers of roof and a solar panel on it,
// and a bulb in the middle of the glass (its lights are planned beside)
fn addLantern(list &mut DrawList, m &Meshes, mat &Materials, x f32, z f32, planned &mut List[Planned]) {
  imm c = m.cube;
  list.add(c, mat.frame, Mat4.fromTrs(new Vec3(x, 0.15, z), Quat.identity(), new Vec3(0.012, 0.15, 0.012)));
  list.add(c, mat.frame, Mat4.fromTrs(new Vec3(x, 0.315, z), Quat.identity(), new Vec3(0.095, 0.015, 0.095)));
  // The glass: a box, and the posts at its corners
  list.add(c, mat.glass, Mat4.fromTrs(new Vec3(x, 0.42, z), Quat.identity(), new Vec3(0.075, 0.09, 0.075)));
  mut k = 0u32;
  while k < 4u32 {
    imm px = if k % 2u32 == 0u32 { 0.085; } else { -0.085; };
    imm pz = if k < 2u32 { 0.085; } else { -0.085; };
    list.add(c, mat.frame, Mat4.fromTrs(new Vec3(x + px, 0.42, z + pz), Quat.identity(), new Vec3(0.011, 0.095, 0.011)));
    k = k + 1u32;
  }
  list.add(c, mat.frame, Mat4.fromTrs(new Vec3(x, 0.525, z), Quat.identity(), new Vec3(0.125, 0.012, 0.125)));
  list.add(c, mat.frame, Mat4.fromTrs(new Vec3(x, 0.55, z), Quat.identity(), new Vec3(0.085, 0.014, 0.085)));
  list.add(c, mat.panel, Mat4.fromTrs(new Vec3(x, 0.566, z), Quat.identity(), new Vec3(0.07, 0.003, 0.07)));
  list.add(m.bulb, mat.bulb, Mat4.fromTranslation(new Vec3(x, 0.42, z)));
  // The pool light: everything near, down to the grass; the interior one:
  // layer 1 only, a short range, the lantern's own parts
  planned.push(new Planned(new Vec3(x, 0.42, z), lampColor(), 3.2, 5.5, 0.02, 1u32));
  planned.push(new Planned(new Vec3(x, 0.42, z), lampColor(), 1.6, 0.35, 0.02, 2u32));
}

fn buildWorld(renderer &mut Renderer, device &mut Device) World {
  mut list = DrawList.empty();
  mut planeMesh = Mesh.plane(1, 1.);
  imm plane = renderer.addMesh(device, &planeMesh);
  imm cubeMesh = Mesh.cube(1.);
  imm cube = renderer.addMesh(device, &cubeMesh);
  imm sphereMesh = Mesh.sphere(1., 24);
  imm sphere = renderer.addMesh(device, &sphereMesh);
  imm bulbMesh = Mesh.sphere(0.022, 16);
  imm bulb = renderer.addMesh(device, &bulbMesh);
  imm meshes = new Meshes(plane, cube, sphere, bulb);

  imm plankImg = plankImage();
  imm plankTex = renderer.addTexture(device, &plankImg);
  imm grassImg = grassImage();
  imm grassTex = renderer.addTexture(device, &grassImg);
  mut planksM = PbrMaterial.standard(new Color(1., 1., 1., 1.), 0., 0.72);
  planksM.texture = plankTex;
  // The lantern's frame and roof: bronze-dark, on layers 0 and 1, so the
  // interior lights reach them (the planks and grass are layer 0 alone)
  mut frameM = PbrMaterial.standard(new Color(0.045, 0.032, 0.02, 1.), 0.6, 0.45);
  frameM.lightLayers = 3u32;
  mut panelM = PbrMaterial.standard(new Color(0.02, 0.03, 0.07, 1.), 0.3, 0.25);
  panelM.lightLayers = 3u32;
  // The glass round the bulb, a warm tint, see-through
  mut glassM = PbrMaterial.standard(new Color(1., 0.85, 0.62, 1.), 0., 0.12).translucent(0.22);
  // The glass glows with what scatters in it (its faces away from the bulb get no
  // light from it): a warm emission, an eighth of the bulb's
  glassM.emissive = lampColor();
  glassM.emissiveStrength = 1.3;
  imm bulbM = Material.plain(new Color(0.1, 0.1, 0.1, 1.)).glowing(lampColor(), 30.);
  mut grassM = PbrMaterial.standard(new Color(1., 1., 1., 1.), 0., 0.85);
  grassM.texture = grassTex;
  imm bushM = PbrMaterial.standard(new Color(0.06, 0.16, 0.05, 1.), 0., 0.8);
  imm stoneM = PbrMaterial.standard(new Color(0.22, 0.2, 0.18, 1.), 0., 0.75);
  imm beamM = PbrMaterial.standard(new Color(0.16, 0.1, 0.06, 1.), 0., 0.7);
  imm mat = new Materials(renderer.addPbrMaterial(device, &planksM), renderer.addPbrMaterial(device, &grassM),
    renderer.addPbrMaterial(device, &frameM), renderer.addPbrMaterial(device, &panelM),
    renderer.addPbrMaterial(device, &glassM), renderer.addMaterial(device, &bulbM),
    renderer.addPbrMaterial(device, &bushM), renderer.addPbrMaterial(device, &stoneM),
    renderer.addPbrMaterial(device, &beamM));

  // The grass, a plane 120 across with the texture repeated 80 times; the
  // boardwalk's planks in tiles 2.4 across and 0.6 along, running away down -z,
  // 0.06 above the grass, with a beam along each edge
  mut grassPlane = Mesh.plane(1, 80.);
  imm grassMesh = renderer.addMesh(device, &grassPlane);
  list.add(grassMesh, mat.grass, Mat4.fromTrs(new Vec3(0., 0., -30.), Quat.identity(), new Vec3(60., 1., 60.)));
  mut i = 0u32;
  while i < 80u32 {
    list.add(plane, mat.planks, Mat4.fromTrs(new Vec3(0., 0.06, 3. - 0.6 * f32.from(i) - 0.3), Quat.identity(), new Vec3(1.2, 1., 0.3)));
    i = i + 1u32;
  }
  list.add(cube, mat.beam, Mat4.fromTrs(new Vec3(-1.24, 0.03, -21.), Quat.identity(), new Vec3(0.05, 0.03, 24.)));
  list.add(cube, mat.beam, Mat4.fromTrs(new Vec3(1.24, 0.03, -21.), Quat.identity(), new Vec3(0.05, 0.03, 24.)));

  // Bushes and stones along both sides, in front of and between the lanterns
  i = 0u32;
  while i < 70u32 {
    imm side = if i % 2u32 == 0u32 { -1.; } else { 1.; };
    imm z = 2. - scatter(i * 5u32) * 44.;
    imm x = side * (1.9 + scatter(i * 5u32 + 1u32) * 3.5);
    imm r = 0.2 + scatter(i * 5u32 + 2u32) * 0.4;
    if scatter(i * 5u32 + 3u32) < 0.65 {
      list.add(sphere, mat.bush, Mat4.fromTrs(new Vec3(x, r * 0.7, z), Quat.identity(), new Vec3(r * 1.3, r * 0.8, r * 1.3)));
    } else {
      list.add(sphere, mat.stone, Mat4.fromTrs(new Vec3(x, r * 0.35, z), Quat.identity(), new Vec3(r * 0.9, r * 0.45, r * 0.7)));
    }
    i = i + 1u32;
  }

  // Twelve lanterns, six a side, every 4.5 m
  mut planned = List[Planned].empty();
  i = 0u32;
  while i < 6u32 {
    imm z = -1. - 4.5 * f32.from(i);
    addLantern(&mut list, &meshes, &mat, -1.6, z, &mut planned);
    addLantern(&mut list, &meshes, &mat, 1.6, z - 2.2, &mut planned);
    i = i + 1u32;
  }
  imm lanternLights = u32.from(planned.len());
  // The rest: lamps scattered along the path and over the grass, 0.3 to 1.3
  // up, reaching 2.5 to 5 m, warm to cool
  i = 0u32;
  while planned.len() < 256usize {
    imm x = (scatter(i * 7u32 + 100u32) - 0.5) * 16.;
    imm z = 1. - scatter(i * 7u32 + 101u32) * 32.;
    imm y = 0.3 + scatter(i * 7u32 + 102u32);
    imm t = scatter(i * 7u32 + 103u32);
    imm warm = new Color(1., 0.397 + 0.4 * t, 0.0953 + 0.6 * t * t, 1.);
    planned.push(new Planned(new Vec3(x, y, z), warm, 1.5 + scatter(i * 7u32 + 104u32) * 2., 2.5 + scatter(i * 7u32 + 105u32) * 2.5, 0.02, 1u32));
    i = i + 1u32;
  }
  new World(list, planned, lanternLights);
}

// The first 'n' planned lights, and no others, in the renderer; the interior
// ones (layer 1) left out if 'interior' is false
fn useLights(renderer &mut Renderer, world &World, n usize, interior bool) {
  renderer.lights.clear();
  mut i = 0usize;
  while i < n {
    imm p = world.planned[i];
    if interior or p.layers != 2u32 {
      imm h = renderer.lights.addPoint(p.position, p.color, p.candela, p.range);
      renderer.lights.setSourceRadius(h, p.radius);
      renderer.lights.setLayers(h, p.layers);
    }
    i = i + 1usize;
  }
}

// Draw 'frames' frames; the mean GPU time of 'render' in milliseconds
fn timeFrames(device &mut Device, renderer &mut Renderer, post &mut Post, out &Texture, depth &Texture, queries &QuerySet,
    resolved &Buffer, readback &Buffer, camera &Camera, light &Light, world &World) f64 {
  mut gpuTime = 0d;
  mut counted = 0u32;
  mut f = 0u32;
  while f < FRAMES {
    mut encoder = device.createCommandEncoder();
    encoder.writeTimestamp(queries, 0u32);
    renderer.render(device, &mut encoder, &post.hdr, depth, camera, light, &world.list);
    encoder.writeTimestamp(queries, 1u32);
    post.apply(&mut encoder, out);
    encoder.resolveQuerySet(queries, 0u32, 2u32, resolved, 0u64);
    encoder.copyBufferToBuffer(resolved, 0u64, readback, 0u64, 16u64);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    if f >= 10u32 {
      imm ticks = readback.mappedRange() as *u64;
      gpuTime = gpuTime + f64.from(*(ticks + 1usize) - *ticks) * f64.from(device.timestampPeriod) * 1.0e-6d;
      counted = counted + 1u32;
    }
    f = f + 1u32;
  }
  gpuTime / f64.from(counted);
}

// Write the frame to 'name'
fn shoot(device &mut Device, renderer &mut Renderer, post &mut Post, out &Texture, depth &Texture, camera &Camera,
    light &Light, world &World, name &String) {
  mut shot = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, &post.hdr, depth, camera, light, &world.list);
  post.apply(&mut encoder, out);
  encoder.copyTextureToBuffer(out, &shot);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  imm image = Image.fromTexels(shot.mappedRange(), i32.from(W), i32.from(H), false);
  imm written = image.save(&filepath.Path.from(name.view()));
  print <- "Screenshot: "; printStr(name.view());
  if written { print <- "\n"; } else { print <- " could NOT be written\n"; }
}

fn main(argc i32, argv **u8) i32 {
  mut prefix = String.empty();
  mut diffuseOnly = false;
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--diffuse") {
      diffuseOnly = true;
    } elif cstrEquals(arg, "--shot") and a + 1 < argc {
      imm s = *(argv + usize.from(a + 1));
      mut i = 0usize;
      while *(s + i) != 0u8 {
        prefix.appendByte(*(s + i));
        i = i + 1usize;
      }
      a = a + 1;
    } else {
      print <- "Unknown argument; use --shot PREFIX, --diffuse\n";
      return 2;
    }
    a = a + 1;
  }
  mut instance = Instance.create("render lanterns");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() {
    print <- "No GPU\n";
    return 1i32;
  }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  print <- "Validation layer: "; print <- u64.from(if instance.validation { 1u32; } else { 0u32; });
  print <- "; synchronization validation: "; print <- u64.from(if instance.syncValidation { 1u32; } else { 0u32; }); print <- "\n";
  mut device = adapter.requestDevice();
  imm outDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut out = device.createTexture(&outDesc);
  imm depthDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  mut depth = device.createTexture(&depthDesc);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, W, H);
  mut queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32);
  mut resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);
  mut readback = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  if !renderer.isValid() or !post.isValid() or !queries.isValid() {
    print <- "The renderer, the post or the timestamps could not be made\n";
    return 1i32;
  }
  // The blue hour just after sunset, the glow at the far end of the path; a
  // little cool light from the sky
  mut sky = Sky.dusk(radians(-3.), radians(180.));
  sky.glow = new Color(0.55, 0.22, 0.08, 1.);
  sky.horizon = new Color(0.09, 0.07, 0.11, 1.);
  sky.zenith = new Color(0.008, 0.012, 0.04, 1.);
  renderer.setSky(&mut device, &sky);
  imm light = Light.directional(new Vec3(0., -1., 0.), Color.gray(0.), new Color(0.01, 0.012, 0.02, 1.));
  post.exposure = 1.;
  post.bloom = 0.1;
  mut camera = Camera.make();
  camera.fov = radians(52.);
  camera.near = 0.1;
  camera.far = 200.;
  camera.lookAt(new Vec3(0.1, 0.8, 1.1), new Vec3(-0.15, 0.35, -9.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.02, 0.02, 0.04, 1.);
  renderer.lights.specular = !diffuseOnly;
  imm world = buildWorld(&mut renderer, &mut device);
  print <- "Scene: "; print <- u64.from(world.list.len()); print <- " draw items; "; print <- u64.from(world.lanternLights);
  print <- " lantern lights of "; print <- u64.from(world.planned.len()); print <- " planned\n";

  mut counts = [0usize, 16usize, 24usize, 64usize, 256usize];
  mut ci = 0usize;
  mut baseMs = 0d;
  while ci < 5usize {
    imm n = counts[ci];
    useLights(&mut renderer, &world, n, true);
    imm ms = timeFrames(&mut device, &mut renderer, &mut post, &out, &depth, &queries, &resolved, &readback, &camera, &light, &world);
    if ci == 0usize { baseMs = ms; }
    // The assignment's CPU time: 200 calls, the camera turning a little each
    // time (so the lists are made again every time), and 200 calls of the
    // camera still (the lists stand: the flicker of a lantern's intensity
    // rewrites the table alone)
    imm frequency = f64.from(sdl.GetPerformanceFrequency());
    mut turning = camera;
    imm started = sdl.GetPerformanceCounter();
    mut r = 0u32;
    while r < 200u32 {
      turning.lookAt(new Vec3(0.1, 0.8, 1.1), new Vec3(-0.15 + 0.01 * f32.from(r % 7u32), 0.35, -9.), new Vec3(0., 1., 0.));
      renderer.lights.prepare(&mut device, &turning, f32.from(W) / f32.from(H), W, H);
      r = r + 1u32;
    }
    imm micros = f64.from(sdl.GetPerformanceCounter() - started) / frequency * 1.0e6d / 200d;
    renderer.lights.prepare(&mut device, &camera, f32.from(W) / f32.from(H), W, H);
    imm started2 = sdl.GetPerformanceCounter();
    r = 0u32;
    while r < 200u32 {
      renderer.lights.prepare(&mut device, &camera, f32.from(W) / f32.from(H), W, H);
      r = r + 1u32;
    }
    imm microsStill = f64.from(sdl.GetPerformanceCounter() - started2) / frequency * 1.0e6d / 200d;
    mut maxCount = 0u32;
    mut c = 0u32;
    while c < 3456u32 {
      imm k = renderer.lights.clusterCount(c);
      if k > maxCount { maxCount = k; }
      c = c + 1u32;
    }
    print <- u64.from(n); print <- " lights: GPU "; print <- ms; print <- " ms (";
    print <- ms - baseMs; print <- " over none); CPU: lists made "; print <- micros; print <- " us, lists standing ";
    print <- microsStill; print <- " us; ";
    print <- u64.from(renderer.lights.active); print <- " reach the view, "; print <- u64.from(renderer.lights.pairs);
    print <- " (light, cluster) pairs, at most "; print <- u64.from(maxCount); print <- " in a cluster\n";
    ci = ci + 1usize;
  }

  if prefix.len() > 0usize {
    mut name = prefix.copy();
    name <- "-on.bmp";
    useLights(&mut renderer, &world, usize.from(world.lanternLights), true);
    shoot(&mut device, &mut renderer, &mut post, &out, &depth, &camera, &light, &world, &name);
    name = prefix.copy();
    name <- "-off.bmp";
    renderer.lights.clear();
    shoot(&mut device, &mut renderer, &mut post, &out, &depth, &camera, &light, &world, &name);
    name = prefix.copy();
    name <- "-nointerior.bmp";
    useLights(&mut renderer, &world, usize.from(world.lanternLights), false);
    shoot(&mut device, &mut renderer, &mut post, &out, &depth, &camera, &light, &world, &name);
    name = prefix.copy();
    name <- "-crowd.bmp";
    useLights(&mut renderer, &world, 256usize, true);
    shoot(&mut device, &mut renderer, &mut post, &out, &depth, &camera, &light, &world, &name);
  }
  print <- "Vulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  0i32;
}
