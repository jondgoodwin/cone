// lightbench: the lights' table under the work a render gives it (lights as DensePool rows; run with a GPU
// device, no window, no drawing):
//
//   congo run --release packages/render/examples/lightbench.cone -- 20
//
// The argument is the passes a row runs; each row prints the best pass. Rows: the per-frame prepare of 1,024
// lights (the assignment, the table written to the GPU), a move through each light's handle, and a churn of
// 10% of the lights removed and added again before each prepare. Seeded and deterministic.

mod lightbench;

import stdio use *;
import libc;
import collections use *;
import time use Instant;
import geomath use *;
import gpu use *;
import render use *;

extern {
  fn @c(system) GetCurrentProcess() usize;
  fn @c(system) GetProcessTimes(process: usize, creation: *u64, exit: *u64, kernel: *u64, user: *u64) i32;
}

fn cpuNanos() u64 {
  var c = 0u64;
  var e = 0u64;
  var k = 0u64;
  var u = 0u64;
  GetProcessTimes(GetCurrentProcess(), &mut c as *u64, &mut e as *u64, &mut k as *u64, &mut u as *u64);
  (k + u) * 100u64
}

struct Rng {
  s: u64;
  fn next(self: &mut) u64 {
    s = s ^ (s >> 12u64);
    s = s ^ (s << 25u64);
    s = s ^ (s >> 27u64);
    s * 2685821657736338717u64
  }
  fn unit(self: &mut) f32 { f32.from(next() >> 40u64) / 16777216. }
}

fn digits(p: *u8) u32 {
  var n = 0u32;
  var q = p;
  while *q >= 48u8 && *q <= 57u8 {
    n = n * 10u32 + u32.from(*q - 48u8);
    q = q + 1usize;
  }
  n
}

fn addOne(ls: &mut LightSet, rng: &mut Rng, i: u32) LightHandle {
  let pos = Vec3((rng.unit() - 0.5) * 60., rng.unit() * 6., 10. - rng.unit() * 90.);
  let range = 1.5 + rng.unit() * 8.;
  if i % 4u32 == 0u32 {
    let axis = Vec3(rng.unit() - 0.5, rng.unit() - 0.7, rng.unit() - 0.5).normalize();
    let outer = radians(20. + rng.unit() * 55.);
    ls.addSpot(pos, axis, Color.gray(1.), 5., range, outer * 0.6, outer)
  } else {
    ls.addPoint(pos, Color.gray(1.), 5., range)
  }
}

fn camera() Camera {
  var c = Camera.make();
  c.fov = radians(60.);
  c.near = 0.1;
  c.far = 300.;
  c.lookAt(Vec3(0., 2., 12.), Vec3(0., 2., -40.), Vec3(0., 1., 0.));
  c
}

fn main(argc: i32, argv: **u8) i32 {
  var passes = 20u32;
  if argc > 1i32 { passes = digits(*(argv + 1usize)); }
  var instance = Instance.create("lightbench");
  var none = Surface.none();
  var adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  var device = adapter.requestDevice();
  if !device.isValid() { print <- "no device\n"; return 1i32; }
  var ls = LightSet.create(&mut device);
  var rng = Rng(88172645463325252u64);
  let cam = camera();
  let n = 1024u32;
  var handles = List[LightHandle]();
  var i = 0u32;
  while i < n {
    handles.push(addOne(&mut ls, &mut rng, i));
    i = i + 1u32;
  }
  ls.prepare(&mut device, &cam, 16.f / 9., 1920u32, 1080u32);
  let cpu0 = cpuNanos();
  let wall0 = Instant.now();
  var bestPrepare = 1000000000i64;
  var bestMove = 1000000000i64;
  var bestChurn = 1000000000i64;
  var bestChurnPrepare = 1000000000i64;
  var pass = 0u32;
  while pass < passes {
    // prepare, every assignment redone
    ls.assignDirty = true;
    let t0 = Instant.now();
    ls.prepare(&mut device, &cam, 16.f / 9., 1920u32, 1080u32);
    let tp = Instant.now().nanos() - t0.nanos();
    if tp < bestPrepare { bestPrepare = tp; }
    // a move through each handle
    let t1 = Instant.now();
    var k = 0usize;
    while k < handles.len() {
      ls.move(*handles[k], Vec3(f32.from(k) * 0.01, 1., -20.));
      k = k + 1usize;
    }
    let tm = (Instant.now().nanos() - t1.nanos()) / i64.from(handles.len());
    if tm < bestMove { bestMove = tm; }
    // churn: 10% removed and as many added, then a prepare
    let t2 = Instant.now();
    var c = 0u32;
    while c < n / 10u32 {
      let at = usize.from((rng.next() >> 33u64) % u64.from(n));
      ls.remove(*handles[at]);
      handles.set(at, addOne(&mut ls, &mut rng, c));
      c = c + 1u32;
    }
    let tc = (Instant.now().nanos() - t2.nanos()) / i64.from(n / 10u32);
    if tc < bestChurn { bestChurn = tc; }
    let t3 = Instant.now();
    ls.prepare(&mut device, &cam, 16.f / 9., 1920u32, 1080u32);
    let tq = Instant.now().nanos() - t3.nanos();
    if tq < bestChurnPrepare { bestChurnPrepare = tq; }
    pass = pass + 1u32;
  }
  let wall = u64.from(wall0.elapsed().nanos());
  print <- "lights, ", n, " lights, best of ", passes, " passes: prepare ", bestPrepare / 1000i64, " us, move through handle ", bestMove,
    " ns, churn (remove+add) ", bestChurn, " ns per pair, prepare after churn ", bestChurnPrepare / 1000i64, " us; cpu ",
    (cpuNanos() - cpu0) * 100u64 / wall, "%\n";
  0i32
}
