// From HDR light to the display: the HDR frame the renderer draws into,
// bloom and tone mapping (post.slang), with the SPIR-V of their shader.
//
//   mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
//   mut post = Post.create(&mut device, swapchain.format, width, height);
//   ...
//   post.resize(&mut device, frame.texture.width, frame.texture.height);   // made again only if it changed
//   renderer.render(&mut device, &mut encoder, &post.hdr, &frame.depth, &camera, &light, &list);
//   post.apply(&mut encoder, &frame.texture);
//
// The frame is RGBA16_FLOAT, so light brighter than 1 survives to be tone
// mapped and to bloom. Bloom is Jimenez's chain: the frame filtered down a
// chain of levels at half size and below, then back up, each level adding
// the one below; a small fraction ('bloom', 0.04 by default) of the result
// is mixed into the frame, so bright light glows in proportion and nothing
// is cut at a threshold. Then 'exposure' scales it and 'toneMapper' maps it
// to the display: AgX (the default), ACES (Narkowicz's fit), Reinhard, or
// none (clamped).

// The tone mappers (post.slang's toneMapper)
pub const TONE_MAP_NONE = 0u32;
pub const TONE_MAP_AGX = 1u32;
pub const TONE_MAP_ACES = 2u32;
pub const TONE_MAP_REINHARD = 3u32;

// The most levels of the bloom chain, the first at half the frame's size
const BLOOM_LEVELS = 6u32;

// What a post pass's immediates hold (post.slang's PostImmediates)
struct PostImmediates {
  pub texelX f32;
  pub texelY f32;
  pub mode u32;
  pub strength f32;
  pub exposure f32;
  pub toneMapper u32;
  pub bloomScale f32;
  pub pad f32;
}

pub struct Post {
  pub outputFormat u32;            // what 'apply' draws into (TEXTURE_FORMAT_...)
  pub width u32;
  pub height u32;
  pub hdr Texture;                 // the frame, RGBA16_FLOAT: what the renderer draws into
  pub bloomDown Texture;           // the chain down, from half size
  pub bloomUp Texture;             // and back up
  pub levels u32;                  // the chain's levels
  pub shader ShaderModule;
  pub layout BindGroupLayout;
  pub pipelineLayout PipelineLayout;
  pub downPipeline RenderPipeline;
  pub upPipeline RenderPipeline;
  pub toneMapPipeline RenderPipeline;
  pub sampler Sampler;
  pub groups List[BindGroup];      // each pass's: the chain down, up, the tone map
  pub toneMapper u32 = TONE_MAP_AGX;
  pub exposure f32 = 1.;
  pub bloom f32 = 0.04;

  // Post-processing into targets of 'outputFormat', its frame 'width' by
  // 'height'. Check 'isValid'.
  pub fn create(device &mut Device, outputFormat u32, width u32, height u32) Post {
    mut shader = device.createShaderModule(&POST_SPIRV);
    imm entries = [BindGroupLayoutEntry[binding: 0u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE],
      BindGroupLayoutEntry[binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE],
      BindGroupLayoutEntry[binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER]];
    mut layout = device.createBindGroupLayout(&entries);
    imm layouts = [&layout];
    mut pipelineLayout = device.createPipelineLayout(&layouts, 32u32);
    mut downPipeline = postPipeline(device, &pipelineLayout, &shader, "downsampleMain", TEXTURE_FORMAT_RGBA16_FLOAT);
    mut upPipeline = postPipeline(device, &pipelineLayout, &shader, "upsampleMain", TEXTURE_FORMAT_RGBA16_FLOAT);
    mut toneMapPipeline = postPipeline(device, &pipelineLayout, &shader, "toneMapMain", outputFormat);
    imm samplerDesc = SamplerDescriptor[addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE];
    mut sampler = device.createSampler(&samplerDesc);
    imm w = umax(width, 2u32);
    imm h = umax(height, 2u32);
    imm levels = bloomLevels(w, h);
    mut hdr = frameTexture(device, w, h);
    mut bloomDown = chainTexture(device, w, h, levels);
    mut bloomUp = chainTexture(device, w, h, levels - 1u32);
    mut post = Post[outputFormat, w, h, hdr, bloomDown, bloomUp, levels, shader, layout, pipelineLayout, downPipeline,
      upPipeline, toneMapPipeline, sampler, List[BindGroup].empty()];
    post.makeGroups(device);
    post;
  }

  // Whether everything it draws with was made
  pub fn isValid(self &) Bool {
    hdr.isValid() and bloomDown.isValid() and bloomUp.isValid() and downPipeline.isValid() and upPipeline.isValid()
      and toneMapPipeline.isValid() and groups.len() == usize[levels * 2u32];
  }

  // Make the frame and the chain again at 'width' by 'height', if that is
  // not their size (after the GPU is idle, as their finalizers wait)
  pub fn resize(self &mut, device &mut Device, width u32, height u32) {
    imm w = umax(width, 2u32);
    imm h = umax(height, 2u32);
    if w == self.width and h == self.height { return; }
    groups = List[BindGroup].empty();
    self.width = w;
    self.height = h;
    levels = bloomLevels(w, h);
    hdr = frameTexture(device, w, h);
    bloomDown = chainTexture(device, w, h, levels);
    bloomUp = chainTexture(device, w, h, levels - 1u32);
    self.makeGroups(device);
  }

  // The bind groups of each pass: down the chain (the frame into level 0,
  // then each level into the next), up it (level i made of the chain down's
  // level i and the level below), and the tone map (the frame and the top
  // of the chain up)
  fn makeGroups(self &mut, device &mut Device) {
    imm frame = hdr.createView();
    mut i = 0u32;
    while i < levels {
      if i == 0u32 {
        groups.push(pairGroup(device, &layout, &frame, &frame, &sampler));
      } else {
        imm above = levelView(&bloomDown, i - 1u32);
        groups.push(pairGroup(device, &layout, &above, &above, &sampler));
      }
      i = i + 1u32;
    }
    // Up: from the second lowest level to the top
    mut up = levels - 1u32;
    while up > 0u32 {
      imm level = up - 1u32;
      imm own = levelView(&bloomDown, level);
      if level + 2u32 == levels {
        imm below = levelView(&bloomDown, level + 1u32);
        groups.push(pairGroup(device, &layout, &own, &below, &sampler));
      } else {
        imm below = levelView(&bloomUp, level + 1u32);
        groups.push(pairGroup(device, &layout, &own, &below, &sampler));
      }
      up = up - 1u32;
    }
    imm top = levelView(&bloomUp, 0u32);
    groups.push(pairGroup(device, &layout, &frame, &top, &sampler));
  }

  // Record bloom and tone mapping of the frame into 'target' (of the output
  // format; a swapchain's texture, say), all of it drawn
  pub fn apply(self &mut, encoder &mut CommandEncoder, target &Texture) {
    // Down
    mut i = 0u32;
    while i < levels {
      imm view = levelView(&bloomDown, i);
      mut sw = width;
      mut sh = height;
      mut mode = 1u32;
      if i > 0u32 {
        sw = levelSize(width / 2u32, i - 1u32);
        sh = levelSize(height / 2u32, i - 1u32);
        mode = 0u32;
      }
      imm data = PostImmediates[1. / f32[sw], 1. / f32[sh], mode, bloom, exposure, toneMapper, 0., 0.];
      postPass(encoder, view, &downPipeline, groups[usize[i]], &data);
      i = i + 1u32;
    }
    // Up
    mut k = 0u32;
    while k + 1u32 < levels {
      imm level = levels - 2u32 - k;
      imm view = levelView(&bloomUp, level);
      imm data = PostImmediates[1. / f32[levelSize(width / 2u32, level + 1u32)],
        1. / f32[levelSize(height / 2u32, level + 1u32)], 0u32, bloom, exposure, toneMapper, 0., 0.];
      postPass(encoder, view, &upPipeline, groups[usize[levels + k]], &data);
      k = k + 1u32;
    }
    // The tone map: the top of the chain up is the sum of every level's
    // blur, so the mean is it over the levels; a share of that is mixed in
    imm data = PostImmediates[1. / f32[width], 1. / f32[height], 0u32, bloom, exposure, toneMapper,
      1. / f32[levels], 0.];
    postPass(encoder, target.createView(), &toneMapPipeline, groups[usize[levels * 2u32 - 1u32]], &data);
  }
}

// The levels of a bloom chain from half of 'width' by 'height': down to 4
// pixels on the shorter side, at most BLOOM_LEVELS, at least 2
fn bloomLevels(width u32, height u32) u32 {
  mut side = umin(width, height) / 2u32;
  mut levels = 1u32;
  while levels < BLOOM_LEVELS and side >= 8u32 {
    side = side / 2u32;
    levels = levels + 1u32;
  }
  umax(levels, 2u32);
}

fn umax(a u32, b u32) u32 { if a > b { a; } else { b; } }
fn umin(a u32, b u32) u32 { if a < b { a; } else { b; } }

// A level's size, from 'size' at level 0
fn levelSize(size u32, level u32) u32 { umax(size >> level, 1u32); }

fn frameTexture(device &mut Device, width u32, height u32) Texture {
  imm desc = TextureDescriptor[width, height, TEXTURE_FORMAT_RGBA16_FLOAT,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING];
  device.createTexture(&desc);
}

// A chain of 'levels' levels from half of 'width' by 'height'
fn chainTexture(device &mut Device, width u32, height u32, levels u32) Texture {
  imm desc = TextureDescriptor[umax(width / 2u32, 1u32), umax(height / 2u32, 1u32), TEXTURE_FORMAT_RGBA16_FLOAT,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING, umax(levels, 1u32)];
  device.createTexture(&desc);
}

fn levelView(texture &Texture, level u32) TextureView {
  imm desc = TextureViewDescriptor[baseMipLevel: level, mipLevelCount: 1u32];
  texture.createViewWith(&desc);
}

fn pairGroup(device &mut Device, layout &BindGroupLayout, first &TextureView, second &TextureView, sampler &Sampler)
    BindGroup {
  imm entries = [BindGroupEntry.texture(0u32, first), BindGroupEntry.texture(1u32, second),
    BindGroupEntry.sampler(2u32, sampler)];
  device.createBindGroup(layout, &entries);
}

fn postPass(encoder &mut CommandEncoder, view TextureView, pipeline &RenderPipeline, group &BindGroup,
    data &PostImmediates) {
  imm attachment = RenderPassColorAttachment[view: view, clearValue: Color[0., 0., 0., 1.]];
  mut pass = encoder.beginRenderPass(&attachment);
  pass.setPipeline(pipeline);
  pass.setBindGroup(0u32, group);
  pass.setImmediates(0u32, data as *u8, 32u32);
  pass.draw(3u32, 1u32, 0u32, 0u32);
  pass.end();
}

fn postPipeline(device &mut Device, layout &PipelineLayout, shader &ShaderModule, entry &[]u8, format u32)
    RenderPipeline {
  imm attributes = [VertexAttribute[VERTEX_FORMAT_FLOAT32, 0u64, 0u32]];
  imm buffers = [VertexBufferLayout[arrayStride: 4u64, attributes: &attributes]];
  imm desc = RenderPipelineDescriptor[layout: layout, vertexModule: shader, vertexEntryPoint: "fullscreenMain",
    buffers: &buffers[..0], fragmentModule: shader, fragmentEntryPoint: entry, colorFormat: format];
  device.createRenderPipeline(&desc);
}

