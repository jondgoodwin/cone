// Materials and textures, and the SPIR-V of the Blinn-Phong and lines
// shaders.
//
// The standard material, lit.slang: a base color times the material's
// texture (white if it has none) times the draw's tint; Lambert diffuse from
// the light (the base color / pi times the light's color, its irradiance,
// times the cosine of the angle between the surface's normal and the
// direction to the light, if positive) plus ambient (the base color times
// the ambient light, a radiance), plus Blinn-Phong specular (the specular
// color times the light's color / pi times the cosine of the angle between
// the normal and the half-way vector, between the directions to the light
// and to the camera, to the power 'shininess', where the surface faces the
// light), plus the emissive color (a radiance, unlit). That is the one
// lighting convention every material keeps (renderframe.slang), the
// physically based one's: so a light of pi gives a white surface facing it
// a radiance of 1. All in linear color, times the renderer's exposure: an
// sRGB target encodes it, an sRGB texture decodes when sampled. The
// physically based material beside it (lighting.cone's PbrMaterial,
// pbr.slang) is glTF 2.0's metallic-roughness base with a clear coat and a
// thin film, glTF's metallic-roughness, normal and occlusion maps, and an
// emissive color (KHR_materials_emissive_strength's, its emissive map to
// come).

// What a surface is drawn like
pub struct Material {
  pub baseColor Color;             // linear
  pub specular Color;              // the highlight's color (rgb); black: none
  pub shininess f32;               // the highlight's exponent: higher is smaller and sharper
  pub texture TextureHandle;       // multiplies the base color; none: white
  // What it gives off, unlit: a radiance, linear rgb (nits in a scene in
  // physical units), which bloom makes glow; black: nothing
  pub emissive Color = new Color(0., 0., 0., 1.);

  // The same material, giving off 'color' times 'strength' (a radiance)
  pub fn glowing(self, color Color, strength f32) Material {
    mut m = self;
    m.emissive = new Color(color.red * strength, color.green * strength, color.blue * strength, 1.);
    m;
  }

  // A color alone: no highlight, no texture
  pub fn plain(baseColor Color) Material {
    new Material(baseColor, new Color(0., 0., 0., 1.), 32., TextureHandle.none());
  }

  // A color with a white highlight of 'strength' (0 to 1) and 'shininess'
  pub fn shiny(baseColor Color, strength f32, shininess f32) Material {
    new Material(baseColor, new Color(strength, strength, strength, 1.), shininess, TextureHandle.none());
  }

  // A texture, times 'baseColor'
  pub fn textured(baseColor Color, texture TextureHandle) Material {
    new Material(baseColor, new Color(0., 0., 0., 1.), 32., texture);
  }
}

// A material in the renderer: its parameters, their uniform buffer, and the
// bind group of that, its texture and the sampler; which kind it is, and a
// physically based one's parameters
pub struct MaterialSlot {
  params Material;
  uniforms Buffer;
  group BindGroup;
  kind u32;                    // MATERIAL_BLINN_PHONG, MATERIAL_PBR or MATERIAL_CUSTOM
  pbr PbrMaterial;
  pipeline PipelineHandle;     // a custom material's pipeline (custom.cone)
}

pub struct MaterialHandle {
  pub slot Ref[MaterialSlot];

  pub fn none() MaterialHandle { new MaterialHandle(Ref[MaterialSlot].none()); }
  pub fn isNone(self) bool { slot.isNone(); }
}

// A texture in the renderer
pub struct TextureSlot {
  texture Texture;
}

pub struct TextureHandle {
  pub slot Ref[TextureSlot];

  pub fn none() TextureHandle { new TextureHandle(Ref[TextureSlot].none()); }
  pub fn isNone(self) bool { slot.isNone(); }
}

