// Materials and textures, and the SPIR-V of the Blinn-Phong and lines
// shaders.
//
// The standard material, lit.slang: a base color times the material's
// texture (white if it has none) times the draw's tint; Lambert diffuse from
// the light (the base color times the light's color times the cosine of the
// angle between the surface's normal and the direction to the light, if
// positive) plus ambient (the base color times the ambient light), plus
// Blinn-Phong specular (the specular color times the light's color times the
// cosine of the angle between the normal and the half-way vector, between the
// directions to the light and to the camera, to the power 'shininess', where
// the surface faces the light). All in linear color: an sRGB target encodes
// it, an sRGB texture decodes when sampled. The physically based material
// beside it (lighting.cone's PbrMaterial, pbr.slang) is glTF 2.0's
// metallic-roughness base with a clear coat and a thin film; the rest of
// glTF's (normal, occlusion, emissive maps) is to come.

// What a surface is drawn like
pub struct Material {
  pub baseColor Color;             // linear
  pub specular Color;              // the highlight's color (rgb); black: none
  pub shininess f32;               // the highlight's exponent: higher is smaller and sharper
  pub texture TextureHandle;       // multiplies the base color; none: white

  // A color alone: no highlight, no texture
  pub fn plain(baseColor Color) Material {
    Material[baseColor, Color[0., 0., 0., 1.], 32., TextureHandle.none()];
  }

  // A color with a white highlight of 'strength' (0 to 1) and 'shininess'
  pub fn shiny(baseColor Color, strength f32, shininess f32) Material {
    Material[baseColor, Color[strength, strength, strength, 1.], shininess, TextureHandle.none()];
  }

  // A texture, times 'baseColor'
  pub fn textured(baseColor Color, texture TextureHandle) Material {
    Material[baseColor, Color[0., 0., 0., 1.], 32., texture];
  }
}

// A material in the renderer: its parameters, their uniform buffer, and the
// bind group of that, its texture and the sampler; which kind it is, and a
// physically based one's parameters
pub struct MaterialSlot {
  pub params Material;
  pub uniforms Buffer;
  pub group BindGroup;
  pub kind u32;                    // MATERIAL_BLINN_PHONG or MATERIAL_PBR
  pub pbr PbrMaterial;
}

pub struct MaterialHandle {
  pub slot Ref[MaterialSlot];

  pub fn none() MaterialHandle { MaterialHandle[Ref[MaterialSlot].none()]; }
  pub fn isNone(self) Bool { slot.isNone(); }
}

// A texture in the renderer
pub struct TextureSlot {
  pub texture Texture;
}

pub struct TextureHandle {
  pub slot Ref[TextureSlot];

  pub fn none() TextureHandle { TextureHandle[Ref[TextureSlot].none()]; }
  pub fn isNone(self) Bool { slot.isNone(); }
}

