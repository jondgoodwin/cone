// Auto-exposure: a luminance histogram of the frame in compute, and an exposure
// that adapts to it over time (autoexposure.slang has the method: Hable's
// histogram, as the engines do it). The tone map (post.slang) reads the
// exposure from `post.exposureBuffer`, which this writes; the program's own
// `post.exposure` is used when auto-exposure is off. fx.cone drives it.
//
// WITH PHYSICAL UNITS. A scene lit in lux and nits is pre-exposed by the
// renderer's own exposure (`exposureFromEv100`), so that the frame holds
// numbers near 1; the exposure found here is applied on top of that, by the
// tone map, and moves the picture by what the scene's brightness needs
// (from -6 to +6 stops by default): the renderer's EV100 should be the
// scene's typical, and this finds the rest. A weather system that wants the
// picture darker or brighter (overcast, dusk, a flash) sets
// 'compensationEv'; it is added to the exposure's stops before the adaptation.

// How auto-exposure is done
pub struct ExposureSettings {
  pub enabled bool = false;
  // The luminance the exposure makes of the metered average: 0.18, a middle grey
  // (the frame's average, after the exposure, is the key)
  pub key f32 = 0.18;
  // Stops added to the exposure: positive brightens (a weather's offset, an
  // artist's taste)
  pub compensationEv f32 = 0.;
  // The exposure's least and greatest, in stops about 1
  pub minEv f32 = -6.;
  pub maxEv f32 = 6.;
  // The share of the metered pixels, from the dark end, left out, and the
  // share at which the bright tail is cut: the lamp and the sun do not set
  // the exposure
  pub lowPercent f32 = 0.1;
  pub highPercent f32 = 0.95;
  // How fast the exposure follows (a rate per second: the share of the way
  // to the target covered in 1 / rate seconds, about): up when the scene went
  // dark (slow, as an eye is), down when it went bright
  pub speedUp f32 = 1.;
  pub speedDown f32 = 3.;
  // 0 meters the whole frame evenly, 1 weights the middle most
  pub centerWeight f32 = 0.;
  // The range metered, as log2 of the frame's luminance: 'minLog' to
  // 'minLog + logRange'. Darker counts as black and is not metered
  pub minLog f32 = -10.;
  pub logRange f32 = 18.;
  // Every stride-th pixel, each way, is metered (2: a quarter of them)
  pub stride u32 = 2u32;
}

// What the passes' immediates hold (autoexposure.slang's ExposureImmediates)
struct ExposureImmediates {
  width u32;
  height u32;
  stride u32;
  minLog f32;
  logRange f32;
  centerWeight f32;
  key f32;
  compensationEv f32;
  minEv f32;
  maxEv f32;
  lowPercent f32;
  highPercent f32;
  speedUp f32;
  speedDown f32;
  dt f32;
  snap f32;
}

// The exposure that makes a frame of average luminance 'average' a middle
// grey 'key', 'compensationEv' stops brighter: the formula the pass
// implements, key / average x 2^compensation
pub fn exposureFor(average f32, key f32, compensationEv f32) f32 {
  key / average * libc.powf(2., compensationEv)
}

pub struct ExposurePass {
  pub shader ShaderModule;
  pub layout BindGroupLayout;
  pub pipelineLayout PipelineLayout;
  pub histogramPipeline ComputePipeline;
  pub resolvePipeline ComputePipeline;
  pub histogram Buffer;            // 256 words
  pub groups List[BindGroup];      // one for each frame it may meter (ImageFx's sources)
  pub snap bool;                   // the next frame jumps to the target

  pub fn create(device &mut Device) ExposurePass {
    var shader = device.createShaderModule(&AUTOEXPOSURE_SPIRV);
    let entries = [new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE)];
    var layout = device.createBindGroupLayout(&entries);
    let layouts = [&layout];
    var pipelineLayout = device.createPipelineLayout(&layouts, 64u32);
    let histogramDesc = new ComputePipelineDescriptor(layout: &pipelineLayout, module: &shader, entryPoint: "histogramMain");
    var histogramPipeline = device.createComputePipeline(&histogramDesc);
    let resolveDesc = new ComputePipelineDescriptor(layout: &pipelineLayout, module: &shader, entryPoint: "resolveMain");
    var resolvePipeline = device.createComputePipeline(&resolveDesc);
    var histogram = device.createBuffer(1024u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    new ExposurePass(shader, layout, pipelineLayout, histogramPipeline, resolvePipeline, histogram, List[BindGroup].empty(), true)
  }

  pub fn isValid(self &) bool { histogramPipeline.isValid() && resolvePipeline.isValid() && histogram.isValid() }

  // A group that meters the frame 'view' and writes the exposure to 'out'
  pub fn addSource(self &mut, device &mut Device, view &TextureView, out &Buffer) {
    let groupEntries = [BindGroupEntry.texture(1u32, view), BindGroupEntry.buffer(2u32, &histogram),
      BindGroupEntry.buffer(3u32, out)];
    groups.push(device.createBindGroup(&layout, &groupEntries));
  }

  // Meter the frame group 'source' names (a frame of 'width' by 'height') and
  // adapt the exposure: 'dt' seconds since the last frame
  pub fn record(self &mut, device &mut Device, encoder &mut CommandEncoder, s &ExposureSettings, source u32, width u32,
      height u32, dt f32) {
    device.queue.clearBuffer(&histogram, 0u64, 1024u64);
    let data = new ExposureImmediates(width, height, s.stride, s.minLog, s.logRange, s.centerWeight, s.key,
      s.compensationEv, s.minEv, s.maxEv, s.lowPercent, s.highPercent, s.speedUp, s.speedDown, dt,
      if snap { 1. } else { 0. });
    snap = false;
    let stride = if s.stride < 1u32 { 1u32 } else { s.stride };
    let tilesX = ((width + stride - 1u32) / stride + 15u32) / 16u32;
    let tilesY = ((height + stride - 1u32) / stride + 15u32) / 16u32;
    var pass = encoder.beginComputePass();
    pass.setPipeline(&histogramPipeline);
    pass.setBindGroup(0u32, groups[usize.from(source)]);
    pass.setImmediates(0u32, &data as *u8, 64u32);
    pass.dispatchWorkgroups(tilesX, tilesY, 1u32);
    pass.setPipeline(&resolvePipeline);
    pass.dispatchWorkgroups(1u32, 1u32, 1u32);
    pass.end();
  }
}

