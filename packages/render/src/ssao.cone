// Screen-space ambient occlusion: GTAO at half resolution with a bilateral
// blur, applied to the frame as a multiplier (ssao.slang has the method:
// Jimenez et al. 2016, in XeGTAO's form). fx.cone drives it.
//
// WHERE THE AO IS APPLIED. The renderer lights in one pass and has no
// separate ambient term to darken, so the occlusion multiplies the finished
// HDR frame (what the sun lights is darkened too, by 'strength'). That is
// too dark in full sun and exactly right in shade, which is where occlusion
// is seen; a lit material that read the AO for its ambient light alone (the
// way engines with a depth prepass do it) is the follow-up, needing the
// materials' shaders, which the clustered-lights work is changing.

// How SSAO is done: a quality tier is a settings value
pub struct SsaoSettings {
  pub enabled bool = false;
  // The radius of the occlusion, in the camera's units (metres)
  pub radius f32 = 0.6;
  // The visibility raised to this: more contrast in the creases
  pub power f32 = 1.5;
  // How much of it is applied (0 to 1)
  pub strength f32 = 0.85;
  // The share of the radius over which an occluder fades out
  pub falloff f32 = 0.6;
  // Slices through each point and steps along each side of a slice
  pub slices u32 = 2u32;
  pub steps u32 = 8u32;
  // The radius never spans more than this many pixels
  pub maxPixels f32 = 96.;
  // The relative depth difference that fades the blur's and the upsample's weights
  pub depthSensitivity f32 = 30.;

  // 3 slices of 10 steps: for a discrete GPU
  pub fn high() SsaoSettings { new SsaoSettings(enabled: true, slices: 3u32, steps: 10u32); }
  // 2 slices of 8 steps
  pub fn medium() SsaoSettings { new SsaoSettings(enabled: true, slices: 2u32, steps: 8u32); }
  // 2 slices of 5 steps, a smaller reach: for an integrated GPU
  pub fn low() SsaoSettings { new SsaoSettings(enabled: true, slices: 2u32, steps: 5u32, maxPixels: 48.); }
}

// What the passes' immediates hold (ssao.slang's SsaoImmediates)
struct SsaoImmediates {
  radius f32;
  power f32;
  falloff f32;
  strength f32;
  slices u32;
  steps u32;
  noise f32;
  maxPixels f32;
  directionX f32;
  directionY f32;
  depthSensitivity f32;
  pad f32;
}

pub struct SsaoPass {
  pub shader ShaderModule;
  pub layout BindGroupLayout;
  pub pipelineLayout PipelineLayout;
  pub aoPipeline RenderPipeline;
  pub blurPipeline RenderPipeline;
  pub applyPipeline RenderPipeline;
  pub ao0 Texture;                 // half resolution, rgba8: the AO, then blurred
  pub ao1 Texture;
  pub groupAo BindGroup;           // reads nothing but the depth
  pub groupBlurH BindGroup;        // reads ao0
  pub groupBlurV BindGroup;        // reads ao1
  pub groupApply BindGroup;        // reads ao0

  pub fn create(device &mut Device, frameBuffer &Buffer, dv &TextureView) SsaoPass {
    mut shader = device.createShaderModule(&SSAO_SPIRV);
    imm entries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE)];
    mut layout = device.createBindGroupLayout(&entries);
    imm layouts = [&layout];
    mut pipelineLayout = device.createPipelineLayout(&layouts, 48u32);
    mut aoPipeline = fxPipeline(device, &pipelineLayout, &shader, "aoMain", TEXTURE_FORMAT_RGBA8_UNORM, false);
    mut blurPipeline = fxPipeline(device, &pipelineLayout, &shader, "blurMain", TEXTURE_FORMAT_RGBA8_UNORM, false);
    mut applyPipeline = fxPipeline(device, &pipelineLayout, &shader, "applyMain", TEXTURE_FORMAT_RGBA16_FLOAT, true);
    imm tiny = new TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_RGBA8_UNORM,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    mut ao0 = device.createTexture(&tiny);
    mut ao1 = device.createTexture(&tiny);
    imm v0 = ao0.createView();
    imm v1 = ao1.createView();
    mut groupAo = aoGroup(device, &layout, frameBuffer, dv, &v1);
    mut groupBlurH = aoGroup(device, &layout, frameBuffer, dv, &v0);
    mut groupBlurV = aoGroup(device, &layout, frameBuffer, dv, &v1);
    mut groupApply = aoGroup(device, &layout, frameBuffer, dv, &v0);
    new SsaoPass(shader, layout, pipelineLayout, aoPipeline, blurPipeline, applyPipeline, ao0, ao1, groupAo, groupBlurH,
      groupBlurV, groupApply);
  }

  pub fn isValid(self &) bool {
    aoPipeline.isValid() and blurPipeline.isValid() and applyPipeline.isValid() and ao0.isValid() and ao1.isValid()
      and groupAo.isValid();
  }

  // The half-resolution textures for a frame of 'width' by 'height' (tiny if
  // not 'enabled'), and the groups over them and the scene's depth
  pub fn remake(self &mut, device &mut Device, enabled bool, width u32, height u32, depth &TextureView,
      frameBuffer &Buffer) {
    imm w = if enabled { (width + 1u32) / 2u32; } else { 1u32; };
    imm h = if enabled { (height + 1u32) / 2u32; } else { 1u32; };
    imm desc = new TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA8_UNORM,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    ao0 = device.createTexture(&desc);
    ao1 = device.createTexture(&desc);
    imm v0 = ao0.createView();
    imm v1 = ao1.createView();
    groupAo = aoGroup(device, &layout, frameBuffer, depth, &v1);
    groupBlurH = aoGroup(device, &layout, frameBuffer, depth, &v0);
    groupBlurV = aoGroup(device, &layout, frameBuffer, depth, &v1);
    groupApply = aoGroup(device, &layout, frameBuffer, depth, &v0);
  }

  // Compute the occlusion of the scene's depth, blur it, and darken the
  // frame 'hdr' by it. 'frame' is the frame number (the noise moves with it
  // when 'moving', so that temporal AA averages it away)
  pub fn record(self &mut, encoder &mut CommandEncoder, hdr &Texture, s &SsaoSettings, frame u32, moving bool) {
    imm noise = if moving { (f32.from(frame % 16u32) + 0.5) / 16.; } else { 0.; };
    imm base = new SsaoImmediates(s.radius, s.power, s.falloff, s.strength, s.slices, s.steps, noise, s.maxPixels, 1., 0.,
      s.depthSensitivity, 0.);
    fxPass(encoder, ao0.createView(), false, &aoPipeline, &groupAo, &base as *u8, 48u32);
    mut horizontal = base;
    fxPass(encoder, ao1.createView(), false, &blurPipeline, &groupBlurH, &horizontal as *u8, 48u32);
    mut vertical = base;
    vertical.directionX = 0.;
    vertical.directionY = 1.;
    fxPass(encoder, ao0.createView(), false, &blurPipeline, &groupBlurV, &vertical as *u8, 48u32);
    fxPass(encoder, hdr.createView(), true, &applyPipeline, &groupApply, &base as *u8, 48u32);
  }
}

fn aoGroup(device &mut Device, layout &BindGroupLayout, frameBuffer &Buffer, depth &TextureView, source &TextureView)
    BindGroup {
  imm entries = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.texture(1u32, depth),
    BindGroupEntry.texture(2u32, source)];
  device.createBindGroup(layout, &entries);
}

