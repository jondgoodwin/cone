// Custom pipelines: shaders of the caller's own, which a material may be
// drawn with in the same pass, batched and instanced like the renderer's
// own materials. Terrain sampling a heightfield in its vertex stage, water,
// a sky and flocking birds each want one.
//
// THE CONTRACT. A custom pipeline's Slang imports renderframe.slang, so
// group 0 is the renderer's: the frame's uniforms ('frame') and the
// instances ('instances[SV_VulkanInstanceID]', the copy drawn: its model
// matrix and tint); bindings 2 and 3 of group 0 are the bones and bone
// bases skinned meshes are drawn with (skinning.slang), and a custom
// pipeline draws a skinned mesh as modelled. Its vertex stage takes the three vertex streams the
// renderer uploads for every mesh (location 0 the position, 1 the normal,
// 2 the uv, each float32), the first 'streams' of them, every one it is
// given read (the validation layer warns of an attribute not read). It keeps the lighting
// convention (the light's colour an irradiance, ambient and emissive
// radiance) and multiplies what it writes by 'frame.exposure.x'. Group 1 is
// its material's, laid out by the pipeline:
//   binding 0          a uniform buffer of 'paramBytes' bytes, the
//                      material's parameters ('addCustomMaterial',
//                      'setCustomParams')
//   bindings 1 to n    its textures, n of them (perhaps none), each of the sample type
//                      'textures' gives (TEXTURE_SAMPLE_TYPE_FLOAT for a
//                      colour texture, _UNFILTERABLE_FLOAT for an r32float
//                      field: 'addFieldTexture'), read in either stage
//   binding n + 1      the renderer's sampler (linear, repeating)
// and group 2, if 'environment', is the environment's (pbr.slang's
// bindings: the sky's parameters, the diffuse and specular cubes, the split
// sum's table, their sampler).

// What 'addPipeline' makes a pipeline of
pub struct CustomPipeline {
  pub spirv &Array[u32];                              // the SPIR-V module holding both stages
  pub vertexEntryPoint &Array[u8] = "vertexMain";
  pub fragmentEntryPoint &Array[u8] = "fragmentMain";
  pub textures &Array[u32];                           // each texture binding's TEXTURE_SAMPLE_TYPE_ (none: 'noTextures()')
  pub streams u32 = 3u32;                        // the vertex streams it reads: 1 position, 2 and normal, 3 and uv
  pub paramBytes u64 = 16u64;                    // the parameters' bytes (a multiple of 16)
  pub environment bool = false;                  // bind the environment as group 2
  pub cullMode u32 = CULL_MODE_BACK;
  pub depthWrite bool = true;
  // ALPHA_BLEND: see-through, drawn with the renderer's other see-through
  // materials, after the opaque ones, back to front, blended with
  // premultiplied alpha (src + (1 - src alpha) x dst; an alpha of 0 adds),
  // depth tested but not written (whatever 'depthWrite' says). Otherwise
  // opaque; a shader that cuts out (ALPHA_MASK) discards its own fragments.
  pub alphaMode u32 = ALPHA_OPAQUE;
}

// No textures, for a CustomPipeline that binds none (its material's group
// is then its parameters at binding 0 and the sampler at binding 1). A field
// default cannot hold it: an empty slice has no constant spelling.
imm NO_TEXTURES Array[u32, 1] = [0u32];
pub fn noTextures() &Array[u32] { &NO_TEXTURES[..0]; }

// A custom pipeline in the renderer: its shader, layouts and pipeline
pub struct PipelineSlot {
  shader ShaderModule;
  materialLayout BindGroupLayout;
  layout PipelineLayout;
  pipeline RenderPipeline;
  textureCount u32;
  paramBytes u64;
  environment bool;
  blend bool = false;           // see-through (ALPHA_BLEND)
}

pub struct PipelineHandle {
  pub slot Ref[PipelineSlot];

  pub fn none() PipelineHandle { new PipelineHandle(Ref[PipelineSlot].none()); }
  pub fn isNone(self) bool { slot.isNone(); }
}
