// Shape: a mesh, and the generators for a sphere, a plane and a cube.
//
// A shape holds a buffer for each kind of per-vertex data, as Pegasus's shape
// held its 'positions', 'normals', 'uvs' and 'colors' properties, and the
// indices that join the vertices into primitives, three to a triangle. A
// buffer that is empty is not given to the shader. The same vertex index
// reaches the same place in every buffer.
//
// The geometry itself is the mesh package's: 'fromMesh' copies a mesh.Mesh
// into a shape, and the generators are mesh's, copied. Their triangles wind
// counterclockwise seen from the side the normals point to (OpenGL's front
// faces). Pegasus drew with face culling off, as this package does, so the
// winding does not show. A shape's indices are 16 bits, so a mesh of more
// than 65,536 vertices makes an empty shape.

pub struct Shape {
  pub positions List[Vec3];
  pub normals List[Vec3];
  pub uvs List[Vec2];        // texture coordinates: x across the image, y up it, 0 to 1
  pub colors List[Color];
  pub indices List[u16];     // empty: draw the vertices in order
  pub draw u32;              // the primitive: gl.TRIANGLES unless set ('drawMode')
  pub transparent Bool;      // blend with what is behind, by alpha
  pub mmatrix Mat4;          // where it is: its coordinates into the world's
  pub uniforms Uniforms;     // its own uniform values: 'diffuse', 'tex', ...

  // A shape with no vertices, drawn as triangles, placed at the origin
  pub fn empty() Shape {
    Shape[List[Vec3].empty(), List[Vec3].empty(), List[Vec2].empty(), List[Color].empty(),
      List[u16].empty(), gl.TRIANGLES, false, Mat4.identity(), Uniforms.empty()];
  }

  // A sphere of 'radius' centered at the origin, by longitude and latitude:
  // 'nsegments' slices around and as many from pole to pole: mesh's
  // 'Mesh.sphere'. The normals point outwards. The top pole's uv is (0, 1),
  // and u runs once around each circle of latitude, which ends in a repeat of
  // its first vertex at u = 1, so the texture's edges meet. Fewer than 3
  // segments, or so many that an index would not fit in 16 bits, gives an
  // empty shape. Pegasus's defaults were a radius of 1 and 15 segments.
  pub fn sphere(radius f32, nsegments i32) Shape {
    // A pole, n - 1 circles of n + 1 vertices, a pole
    imm n = nsegments;
    if n > 2 and (n + 1) * (n - 1) + 2 >= 65536 { return Shape.empty(); }
    imm m = Mesh.sphere(radius, nsegments);
    Shape.fromMesh(&m);
  }

  // A flat square in y = 0 from -1 to 1 in x and z, facing up (+y), cut into
  // 'nsegments' by 'nsegments' squares of two triangles: mesh's 'Mesh.plane'.
  // The uv (0, 0) is the corner at (-1, 0, 1), and 'uvrepeat' is how many
  // times the texture repeats across it. Fewer than 1 segment, or too many,
  // gives an empty shape. Pegasus's defaults were 1 segment and a repeat of 1.
  pub fn plane(nsegments i32, uvrepeat f32) Shape {
    imm n = nsegments;
    if n >= 1 and (n + 1) * (n + 1) >= 65536 { return Shape.empty(); }
    imm m = Mesh.plane(nsegments, uvrepeat);
    Shape.fromMesh(&m);
  }

  // A cube centered at the origin, reaching 'size' along each axis each way:
  // mesh's 'Mesh.cube', four vertices for each face with its normal and uvs,
  // two triangles each. (Pegasus's cube had no normals or uvs: its use was a
  // skybox, sampled by direction, which a shader wanting only positions
  // still is.) Pegasus's default size was 1.
  pub fn cube(size f32) Shape {
    imm m = Mesh.cube(size);
    Shape.fromMesh(&m);
  }

  // A shape of a mesh's positions, normals, uvs and colors, and its indices
  // cut to 16 bits; an empty shape if an index does not fit. Its material
  // groups and tangents are not carried: a shape is drawn with one shader
  // and its uniforms.
  pub fn fromMesh(m &Mesh) Shape {
    mut s = Shape.empty();
    mut i = 0usize;
    while i < m.indices.len() {
      if *m.indices[i] > 65535u32 { return s; }
      i = i + 1usize;
    }
    s.positions.reserve(m.positions.len());
    i = 0usize;
    while i < m.positions.len() { s.positions.push(*m.positions[i]); i = i + 1usize; }
    s.normals.reserve(m.normals.len());
    i = 0usize;
    while i < m.normals.len() { s.normals.push(*m.normals[i]); i = i + 1usize; }
    s.uvs.reserve(m.uvs.len());
    i = 0usize;
    while i < m.uvs.len() { s.uvs.push(*m.uvs[i]); i = i + 1usize; }
    s.colors.reserve(m.colors.len());
    i = 0usize;
    while i < m.colors.len() { s.colors.push(*m.colors[i]); i = i + 1usize; }
    s.indices.reserve(m.indices.len());
    i = 0usize;
    while i < m.indices.len() { s.indices.push(u16[*m.indices[i]]); i = i + 1usize; }
    s;
  }

  // How many vertices it has: the fewest of any buffer it has
  pub fn vertexCount(self &) usize {
    mut n = positions.len();
    if normals.len() > 0usize and normals.len() < n { n = normals.len(); }
    if uvs.len() > 0usize and uvs.len() < n { n = uvs.len(); }
    if colors.len() > 0usize and colors.len() < n { n = colors.len(); }
    n;
  }

  // Draw it under the camera with the shader: the shader's program and
  // uniforms, then a buffer for each of the shader's attributes that the
  // shape has, then the primitives, by index when it has indices. The buffers
  // are made, filled and given back at each draw, as Pegasus did.
  // (Pegasus's _Render; which shader draws it was the shape's property, or
  // else the camera's, and is here the caller's choice.)
  pub fn render(self &, camera &Camera, shader &mut Shader) {
    shader.render(camera, self);

    // Blending for a shape with translucent colors
    if transparent {
      gl.Enable(gl.BLEND);
      gl.BlendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
    }

    // A vertex array object, and a buffer for each attribute the shape has
    mut vao = 0u;
    gl.GenVertexArrays(1, &mut vao);
    gl.BindVertexArray(vao);
    mut vbo [16; u32] = [16; 0u];
    imm nattrs = if shader.attributes.len() < 16usize {shader.attributes.len();} else {16usize;};
    mut nverts = 0usize;
    mut any = false;
    mut i = 0usize;
    while i < nattrs {
      imm name = shader.attributes[i];
      imm count = self.bindAttribute(name.view(), u32[i], &mut vbo[i]);
      // Draw no more vertices than the shortest buffer holds
      if count > 0usize {
        if !any or count < nverts { nverts = count; }
        any = true;
      }
      i = i + 1usize;
    }

    // The primitives, by index when there are indices
    if indices.len() > 0usize {
      mut elements = 0u;
      gl.GenBuffers(1, &mut elements);
      gl.BindBuffer(gl.ELEMENT_ARRAY_BUFFER, elements);
      imm iv = indices.view();
      gl.BufferData(gl.ELEMENT_ARRAY_BUFFER, isize[iv.len * 2usize], &iv[0] as *u8, gl.STATIC_DRAW);
      gl.DrawElements(draw, i32[iv.len], gl.UNSIGNED_SHORT, 0usize as *u8);
      gl.DeleteBuffers(1, &mut elements);
    } elif nverts > 0usize {
      // (Pegasus drew 'unsigned -1' vertices when the shape had no buffer the
      // shader wanted; nothing is drawn then)
      gl.DrawArrays(draw, 0, i32[nverts]);
    }

    // Give back the buffers and the vertex array
    i = 0usize;
    while i < nattrs {
      gl.DisableVertexAttribArray(u32[i]);
      if vbo[i] != 0u { gl.DeleteBuffers(1, &mut vbo[i]); }
      i = i + 1usize;
    }
    gl.DeleteVertexArrays(1, &mut vao);

    if transparent { gl.Disable(gl.BLEND); }
  }

  // Fill a buffer with the shape's data for the attribute 'name', bound at
  // 'index', and answer how many vertices it holds: 0 when the shape has none
  fn bindAttribute(self &, name &[]u8, index u32, vbo &mut u32) usize {
    if bytesEqual(name, "positions") { return fillBuffer(&positions, index, 3, vbo); }
    if bytesEqual(name, "normals") { return fillBuffer(&normals, index, 3, vbo); }
    if bytesEqual(name, "uvs") { return fillBuffer(&uvs, index, 2, vbo); }
    if bytesEqual(name, "colors") { return fillBuffer(&colors, index, 4, vbo); }
    0usize;
  }
}

// Copy a list of vertex data, each element 'size' floats, into a new buffer
// bound as the attribute 'index'. An empty list makes no buffer.
fn fillBuffer[T](list &List[T], index u32, size i32, vbo &mut u32) usize {
  imm n = list.len();
  if n == 0usize { return 0usize; }
  gl.GenBuffers(1, vbo);
  gl.BindBuffer(gl.ARRAY_BUFFER, *vbo);
  imm v = list.view();
  gl.BufferData(gl.ARRAY_BUFFER, isize[n * mem.sizeof[T]()], &v[0] as *u8, gl.STATIC_DRAW);
  gl.VertexAttribPointer(index, size, gl.FLOAT, gl.FALSE, 0, 0usize as *u8);
  gl.EnableVertexAttribArray(index);
  n;
}

// The OpenGL primitive a Pegasus 'draw' symbol names: 'Triangles',
// 'TriangleStrip', 'TriangleFan', 'Lines', 'LineStrip', 'LineLoop', 'Points',
// the four adjacency forms, 'Patches' and 'Polygon'. Any other is triangles.
// ('Polygon' was GL_POLYGON in Pegasus, which a core profile context does not
// have; a triangle fan draws the same convex polygon, as Pegasus's comment
// said.)
pub fn drawMode(name &[]u8) u32 {
  if bytesEqual(name, "Triangles") { return gl.TRIANGLES; }
  if bytesEqual(name, "TriangleStrip") { return gl.TRIANGLE_STRIP; }
  if bytesEqual(name, "TriangleFan") { return gl.TRIANGLE_FAN; }
  if bytesEqual(name, "TrianglesAdjacency") { return gl.TRIANGLES_ADJACENCY; }
  if bytesEqual(name, "TriangleStripAdjacency") { return gl.TRIANGLE_STRIP_ADJACENCY; }
  if bytesEqual(name, "Patches") { return gl.PATCHES; }
  if bytesEqual(name, "Lines") { return gl.LINES; }
  if bytesEqual(name, "LineStrip") { return gl.LINE_STRIP; }
  if bytesEqual(name, "LineLoop") { return gl.LINE_LOOP; }
  if bytesEqual(name, "LinesAdjacency") { return gl.LINES_ADJACENCY; }
  if bytesEqual(name, "LineStripAdjacency") { return gl.LINE_STRIP_ADJACENCY; }
  if bytesEqual(name, "Points") { return gl.POINTS; }
  if bytesEqual(name, "Polygon") { return gl.TRIANGLE_FAN; }
  gl.TRIANGLES;
}
