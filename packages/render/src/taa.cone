// Temporal anti-aliasing: a sub-pixel jitter of the camera, a velocity pass
// for the objects that move, the resolve that blends each frame into a
// reprojected history, and a sharpening pass. The shaders are taa.slang and
// taavelocity*.slang; fx.cone drives it (ImageFx.render).
//
// THE METHOD, named (the choices are listed in Design\render.md):
// - Karis, "High Quality Temporal Supersampling", SIGGRAPH 2014 (Unreal 4):
//   the projection jittered by the Halton (2, 3) sequence, the history
//   reprojected, clipped to the current frame's neighbourhood, and blended.
// - Salvi, "An Excursion in Temporal Supersampling", GDC 2016: the
//   neighbourhood clip by mean and variance in YCoCg.
// - Pedersen, "Temporal Reprojection Anti-Aliasing in INSIDE", GDC 2016: the
//   closest-depth velocity of the 3 x 3, the clip towards the box's centre.
// - Jimenez, "Filmic SMAA", SIGGRAPH 2016: the Catmull-Rom history filter in
//   five taps.
// - Lottes, FidelityFX CAS, 2019: the contrast-adaptive sharpening.
//
// WHAT MOVES. The velocity of a pixel is, for a static object, the camera's
// motion alone, which the resolve finds from the depth and last frame's
// camera matrix; nothing is drawn for it. An object that moves by itself, or
// a skinned one that is posed differently, is named to the pass by the
// program in a MotionList (the item's index in the draw list, last frame's
// model matrix, last frame's pose), and drawn again into a velocity texture
// after the scene, depth tested against the scene's depth, with last frame's
// matrices (the pass's batches are the main pass's: a batch with a moving
// copy among its copies is drawn whole, the static ones among them getting
// the camera's motion). A draw the renderer does not know how to draw twice
// (a custom pipeline, a see-through material) is treated as static; a
// flutter leaf's few degrees are left to the clipping.

// The antialiasing the renderer's frames get: none, FXAA on the finished
// picture (the cheap tier, fxaa.cone), or temporal
pub const AA_NONE = 0u32;
pub const AA_FXAA = 1u32;
pub const AA_TAA = 2u32;

// How temporal anti-aliasing is done: a quality tier is a settings value
// ('TaaSettings.high()', '.medium()'), and 'sharpness' and 'clipGamma' are
// tuned to it. Everything here may change between frames.
pub struct TaaSettings {
  // How long the jitter sequence is (Halton 2, 3): 8 or 16 positions
  pub samples u32 = 16u32;
  // The history averages at most this many frames (a new frame has at least
  // 1 / this weight); more is smoother and slower to follow a change
  pub maxSamples f32 = 16.;
  // The box the history is clipped to is this many standard deviations of the
  // current frame's 3 x 3 wide (and never wider than its min and max): smaller
  // removes ghosts harder and shimmers more
  pub clipGamma f32 = 1.5;
  // 1 weights samples by 1 / (1 + luma), so that the average is of the
  // colours as a tone mapper will show them and a bright sample cannot
  // dominate; 0 averages the light as it is (a supersample's average: error
  // 0.004 against 64 samples on the test's scene; 1 gives 0.007 and 0.5
  // 0.005, a bright edge on dark coming out a little darker, as a tone
  // mapper would show it)
  pub hdrWeight f32 = 0.5;
  // The contrast-adaptive sharpening after the resolve, 0 (off, and its pass
  // skipped) to 1
  pub sharpness f32 = 0.25;
  // The least weight a new frame has when the picture moves 8 pixels a frame
  pub motionBlend f32 = 0.2;
  // The size of the jitter in pixels (1: from -0.5 to 0.5)
  pub jitterScale f32 = 1.;

  // 16 samples, sharpened: for a discrete GPU
  pub fn high() TaaSettings { new TaaSettings(samples: 16u32, maxSamples: 16., sharpness: 0.3); }
  // 8 samples, the history shorter: for a middling one
  pub fn medium() TaaSettings { new TaaSettings(samples: 8u32, maxSamples: 12., sharpness: 0.2); }
}

// A jitter sequence's number: the Halton sequence's 'index'th number in
// base 'b' (0 to 1); fxcommon.slang has the GPU's twin
pub fn halton(index u32, b u32) f32 {
  mut result = 0.;
  mut f = 1.;
  mut i = index;
  while i > 0u32 {
    f = f / f32.from(b);
    result = result + f * f32.from(i % b);
    i = i / b;
  }
  result;
}

// The jitter of frame 'frame' in pixels (x right, y down), from -0.5 to 0.5
// times 'scale': the Halton (2, 3) sequence, 'samples' long, from its second
// number (the first, index 0, is 0)
pub fn jitterOf(frame u32, samples u32, scale f32, x &mut f32, y &mut f32) {
  imm index = (frame % samples) + 1u32;
  *x = (halton(index, 2u32) - 0.5) * scale;
  *y = (halton(index, 3u32) - 0.5) * scale;
}

// What the program says is moving (see the head of this file): for the items
// of the draw list named by index, last frame's model matrix and, for a
// skinned item, last frame's pose
pub struct MotionEntry {
  pub item u32;
  pub model Mat4;
  pub bones u32;                // where its previous bones begin in 'MotionList.bones', or NO_BONES
}

pub struct MotionList {
  pub entries List[MotionEntry];
  pub bones List[f32];          // previous poses' skinning matrices, as DrawList.bones has them

  pub fn empty() MotionList { new MotionList(List[MotionEntry].empty(), List[f32].empty()); }

  pub fn clear(self &mut) {
    entries.clear();
    bones.clear();
  }

  pub fn len(self &) usize { entries.len(); }

  // The draw list's item number 'item' (the index it was added at: after
  // 'list.add', that is 'list.len() - 1') was placed by 'previousModel'
  // last frame
  pub fn add(self &mut, item usize, previousModel Mat4) {
    entries.push(new MotionEntry(u32.from(item), previousModel, NO_BONES));
  }

  // The same for a skinned item, posed last frame as 'previousPose' (one
  // skinning matrix a bone, as DrawList.addSkinned takes)
  pub fn addPosed(self &mut, item usize, previousModel Mat4, previousPose &Array[Mat4]) {
    imm first = u32.from(bones.len() / BONE_FLOATS);
    mut b = 0usize;
    while b < previousPose.len {
      imm rows = boneRows(previousPose[b]);
      mut e = 0usize;
      while e < BONE_FLOATS {
        bones.push(rows[e]);
        e = e + 1usize;
      }
      b = b + 1usize;
    }
    entries.push(new MotionEntry(u32.from(item), previousModel, first));
  }
}

// What the resolve's immediates hold (taa.slang's TaaImmediates)
struct TaaImmediates {
  maxSamples f32;
  clipGamma f32;
  hdrWeight f32;
  sharpness f32;
  flags u32;
  motionBlend f32;
  pad0 f32;
  pad1 f32;
}

// The kinds of velocity draw
const VELOCITY_NONE = 0u32;
const VELOCITY_OPAQUE = 1u32;
const VELOCITY_OPAQUE_SKINNED = 2u32;
const VELOCITY_LIT_CUT = 3u32;
const VELOCITY_LIT_CUT_SKINNED = 4u32;
const VELOCITY_PBR_CUT = 5u32;
const VELOCITY_PBR_CUT_SKINNED = 6u32;

// The pass: pipelines, the textures of a size and the bind groups over them
pub struct TaaPass {
  pub shader ShaderModule;
  pub layout BindGroupLayout;
  pub pipelineLayout PipelineLayout;
  pub resolve RenderPipeline;
  pub sharpen RenderPipeline;
  pub sampler Sampler;
  // The velocity pass
  pub shaderVelocity ShaderModule;
  pub shaderLit ShaderModule;
  pub shaderPbr ShaderModule;
  pub velocityLayout BindGroupLayout;      // group 2
  pub layoutOpaque PipelineLayout;
  pub layoutLit PipelineLayout;
  pub layoutPbr PipelineLayout;
  pub opaque RenderPipeline;
  pub opaqueSkinned RenderPipeline;
  pub litCut RenderPipeline;
  pub litCutSkinned RenderPipeline;
  pub pbrCut RenderPipeline;
  pub pbrCutSkinned RenderPipeline;
  // The textures (the size of the frame): the history twice, the velocity,
  // the sharpened picture
  pub history0 Texture;
  pub history1 Texture;
  pub velocity Texture;
  pub sharp Texture;
  pub resolveGroups List[BindGroup];       // [k]: reads history k, writes the other
  pub sharpenGroups List[BindGroup];       // [k]: reads history k
  // Last frame's matrices of the instances, and the previous bones
  pub previousModels Buffer;
  pub previousBones Buffer;
  pub previousBoneBases Buffer;
  pub instanceCapacity u32;
  pub boneCapacity u32;
  pub velocityGroup BindGroup;
  pub modelData List[f32];
  pub baseData List[u32];
  pub itemEntry List[u32];                 // per draw item: its MotionEntry's index + 1, or 0
  pub latest u32;                          // the history the last resolve wrote (0 or 1)
  pub drawn u32;                           // batches the last velocity pass drew
  pub hasVelocity bool;                    // a velocity pass drew this frame

  pub fn create(device &mut Device, frameLayout &BindGroupLayout, materialLayout &BindGroupLayout,
      pbrMaterialLayout &BindGroupLayout, frameBuffer &Buffer) TaaPass {
    mut shader = device.createShaderModule(&TAA_SPIRV);
    imm entries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH),
      new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE)];
    mut layout = device.createBindGroupLayout(&entries);
    imm layouts = [&layout];
    mut pipelineLayout = device.createPipelineLayout(&layouts, 32u32);
    mut resolve = fxPipeline(device, &pipelineLayout, &shader, "resolveMain", TEXTURE_FORMAT_RGBA16_FLOAT, false);
    mut sharpen = fxPipeline(device, &pipelineLayout, &shader, "sharpenMain", TEXTURE_FORMAT_RGBA16_FLOAT, false);
    imm samplerDesc = new SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    mut sampler = device.createSampler(&samplerDesc);

    // The velocity pass: group 2 is its own
    mut shaderVelocity = device.createShaderModule(&TAAVELOCITY_SPIRV);
    mut shaderLit = device.createShaderModule(&TAAVELOCITYLIT_SPIRV);
    mut shaderPbr = device.createShaderModule(&TAAVELOCITYPBR_SPIRV);
    imm velocityEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE)];
    mut velocityLayout = device.createBindGroupLayout(&velocityEntries);
    imm opaqueGroups = [frameLayout, materialLayout, &velocityLayout];
    mut layoutOpaque = device.createPipelineLayout(&opaqueGroups, 0u32);
    imm litGroups = [frameLayout, materialLayout, &velocityLayout];
    mut layoutLit = device.createPipelineLayout(&litGroups, 0u32);
    imm pbrGroups = [frameLayout, pbrMaterialLayout, &velocityLayout];
    mut layoutPbr = device.createPipelineLayout(&pbrGroups, 0u32);

    imm positionAt0 = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X3, 0u64, 0u32)];
    imm uvAt1 = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X2, 0u64, 1u32)];
    imm jointsAt1 = [new VertexAttribute(VERTEX_FORMAT_UINT8X4, 0u64, 1u32)];
    imm weightsAt2 = [new VertexAttribute(VERTEX_FORMAT_UNORM8X4, 0u64, 2u32)];
    imm jointsAt2 = [new VertexAttribute(VERTEX_FORMAT_UINT8X4, 0u64, 2u32)];
    imm weightsAt3 = [new VertexAttribute(VERTEX_FORMAT_UNORM8X4, 0u64, 3u32)];
    imm position = new VertexBufferLayout(arrayStride: 12u64, attributes: &positionAt0);
    imm uv = new VertexBufferLayout(arrayStride: 8u64, attributes: &uvAt1);
    imm opaqueBuffers = [position];
    imm opaqueSkinnedBuffers = [position, new VertexBufferLayout(arrayStride: 4u64, attributes: &jointsAt1),
      new VertexBufferLayout(arrayStride: 4u64, attributes: &weightsAt2)];
    imm cutBuffers = [position, uv];
    imm cutSkinnedBuffers = [position, uv, new VertexBufferLayout(arrayStride: 4u64, attributes: &jointsAt2),
      new VertexBufferLayout(arrayStride: 4u64, attributes: &weightsAt3)];
    mut opaque = velocityPipeline(device, &layoutOpaque, &shaderVelocity, "vertexOpaque", "fragmentOpaque", &opaqueBuffers);
    mut opaqueSkinned = velocityPipeline(device, &layoutOpaque, &shaderVelocity, "vertexOpaqueSkinned", "fragmentOpaque",
      &opaqueSkinnedBuffers);
    mut litCut = velocityPipeline(device, &layoutLit, &shaderLit, "vertexCut", "fragmentCut", &cutBuffers);
    mut litCutSkinned = velocityPipeline(device, &layoutLit, &shaderLit, "vertexCutSkinned", "fragmentCut", &cutSkinnedBuffers);
    mut pbrCut = velocityPipeline(device, &layoutPbr, &shaderPbr, "vertexCut", "fragmentCut", &cutBuffers);
    mut pbrCutSkinned = velocityPipeline(device, &layoutPbr, &shaderPbr, "vertexCutSkinned", "fragmentCut", &cutSkinnedBuffers);

    mut previousModels = device.createBuffer(u64.from(FIRST_INSTANCES) * 64u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    mut previousBones = device.createBuffer(u64.from(FIRST_BONES) * BONE_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    mut previousBoneBases = device.createBuffer(u64.from(FIRST_INSTANCES) * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    imm groupEntries = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.buffer(1u32, &previousModels),
      BindGroupEntry.buffer(2u32, &previousBones), BindGroupEntry.buffer(3u32, &previousBoneBases)];
    mut velocityGroup = device.createBindGroup(&velocityLayout, &groupEntries);
    imm tiny = new TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_RGBA16_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    new TaaPass(shader, layout, pipelineLayout, resolve, sharpen, sampler, shaderVelocity, shaderLit, shaderPbr,
      velocityLayout, layoutOpaque, layoutLit, layoutPbr, opaque, opaqueSkinned, litCut, litCutSkinned, pbrCut,
      pbrCutSkinned, device.createTexture(&tiny), device.createTexture(&tiny), device.createTexture(&tiny),
      device.createTexture(&tiny), List[BindGroup].empty(), List[BindGroup].empty(), previousModels, previousBones,
      previousBoneBases, FIRST_INSTANCES, FIRST_BONES, velocityGroup, List[f32].empty(), List[u32].empty(),
      List[u32].empty(), 0u32, 0u32, false);
  }

  pub fn isValid(self &) bool {
    resolve.isValid() and sharpen.isValid() and opaque.isValid() and opaqueSkinned.isValid() and litCut.isValid()
      and litCutSkinned.isValid() and pbrCut.isValid() and pbrCutSkinned.isValid() and velocityGroup.isValid()
      and sampler.isValid();
  }

  // The textures made at 'width' by 'height' (or tiny, if 'enabled' is not
  // set) and the groups over them. 'current' is the frame to resolve (the
  // renderer's, or the depth of field's); 'depth' the scene's depth. The
  // GPU is waited for. The histories start empty (their counts 0).
  pub fn remake(self &mut, device &mut Device, enabled bool, width u32, height u32, current &TextureView,
      depth &TextureView, frameBuffer &Buffer, sharpness f32) {
    resolveGroups = List[BindGroup].empty();
    sharpenGroups = List[BindGroup].empty();
    imm w = if enabled { width; } else { 1u32; };
    imm h = if enabled { height; } else { 1u32; };
    imm desc = new TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA16_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    history0 = device.createTexture(&desc);
    history1 = device.createTexture(&desc);
    velocity = device.createTexture(&desc);
    sharp = device.createTexture(&desc);
    latest = 0u32;
    if !enabled { return; }
    // The histories begin as nothing (alpha 0, the count)
    clearTexture(device, &history0);
    clearTexture(device, &history1);
    imm h0 = history0.createView();
    imm h1 = history1.createView();
    imm vel = velocity.createView();
    resolveGroups.push(resolveGroup(device, &layout, frameBuffer, &sampler, current, &h0, depth, &vel));
    resolveGroups.push(resolveGroup(device, &layout, frameBuffer, &sampler, current, &h1, depth, &vel));
    sharpenGroups.push(resolveGroup(device, &layout, frameBuffer, &sampler, &h0, &h0, depth, &vel));
    sharpenGroups.push(resolveGroup(device, &layout, frameBuffer, &sampler, &h1, &h1, depth, &vel));
  }

  // Which picture the next stage reads, as an index into the sources 'ImageFx'
  // makes (0: the history 0, 1: the history 1, 2: the sharpened picture): the
  // sharpened picture, or, with no sharpening, the history just written
  pub fn outputSource(self &, sharpness f32) u32 {
    if sharpness > 0. { return 2u32; }
    latest;
  }

  // Make the previous-matrix buffers hold at least the instances and bones
  // wanted, and write them from this frame's batches (the order the main
  // pass wrote its instances in: the renderer's batches and keys). Every
  // instance has a previous matrix, its own where nothing says it moved.
  // Returns whether any batch holds a moving copy.
  pub fn writePrevious(self &mut, device &mut Device, frameBuffer &Buffer, r &Renderer, list &DrawList,
      motion &MotionList) bool {
    itemEntry.clear();
    mut i = 0usize;
    while i < list.items.len() {
      itemEntry.push(0u32);
      i = i + 1usize;
    }
    mut e = 0usize;
    mut any = false;
    while e < motion.entries.len() {
      imm entry = motion.entries[e];
      if usize.from(entry.item) < itemEntry.len() {
        itemEntry.set(usize.from(entry.item), u32.from(e) + 1u32);
        any = true;
      }
      e = e + 1usize;
    }
    if !any { return false; }
    modelData.clear();
    baseData.clear();
    mut b = 0usize;
    while b < r.batches.len() {
      imm batch = *r.batches[b];
      mut j = 0u32;
      while j < batch.count {
        imm itemIndex = usize.from(r.keys[usize.from(batch.first + j)].item);
        imm item = list.items[itemIndex];
        imm slot = *itemEntry[itemIndex];
        if slot != 0u32 {
          imm entry = motion.entries[usize.from(slot - 1u32)];
          mut k = 0usize;
          while k < 16usize {
            modelData.push(entry.model.m[k]);
            k = k + 1usize;
          }
          baseData.push(entry.bones);
        } else {
          mut k = 0usize;
          while k < 16usize {
            modelData.push(item.model.m[k]);
            k = k + 1usize;
          }
          baseData.push(NO_BONES);
        }
        j = j + 1u32;
      }
      b = b + 1usize;
    }
    imm count = u32.from(baseData.len());
    if count == 0u32 { return false; }
    imm boneCount = u32.from(motion.bones.len() / BONE_FLOATS);
    mut grown = false;
    if count > instanceCapacity {
      mut capacity = instanceCapacity;
      while capacity < count { capacity = capacity * 2u32; }
      device.queue.releaseBuffer(&mut previousModels);
      previousModels = device.createBuffer(u64.from(capacity) * 64u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
      device.queue.releaseBuffer(&mut previousBoneBases);
      previousBoneBases = device.createBuffer(u64.from(capacity) * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
      instanceCapacity = capacity;
      grown = true;
    }
    if boneCount > boneCapacity {
      mut capacity = boneCapacity;
      while capacity < boneCount { capacity = capacity * 2u32; }
      device.queue.releaseBuffer(&mut previousBones);
      previousBones = device.createBuffer(u64.from(capacity) * BONE_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
      boneCapacity = capacity;
      grown = true;
    }
    if grown {
      imm groupEntries = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.buffer(1u32, &previousModels),
        BindGroupEntry.buffer(2u32, &previousBones), BindGroupEntry.buffer(3u32, &previousBoneBases)];
      velocityGroup = device.createBindGroup(&velocityLayout, &groupEntries);
    }
    imm mv = modelData.view();
    device.queue.writeBuffer(&previousModels, 0u64, &mv[0] as *u8, u64.from(count) * 64u64);
    imm bv = baseData.view();
    device.queue.writeBuffer(&previousBoneBases, 0u64, &bv[0] as *u8, u64.from(count) * 4u64);
    if boneCount > 0u32 {
      imm pv = motion.bones.view();
      device.queue.writeBuffer(&previousBones, 0u64, &pv[0] as *u8, u64.from(boneCount) * BONE_BYTES);
    }
    true;
  }

  // Draw the batches that hold a moving copy into the velocity texture,
  // after the scene, depth tested against the scene's depth ('depth', kept
  // by the main pass)
  pub fn recordVelocity(self &mut, encoder &mut CommandEncoder, r &Renderer, list &DrawList, depth &Texture) {
    drawn = 0u32;
    imm attachment = new RenderPassColorAttachment(view: velocity.createView(), clearValue: new Color(0., 0., 0., 0.));
    imm depthAttachment = new RenderPassDepthStencilAttachment(view: depth.createView(), depthLoadOp: LOAD_OP_LOAD,
      depthStoreOp: STORE_OP_STORE);
    mut pass = encoder.beginRenderPassWithDepth(&attachment, &depthAttachment);
    mut bound = VELOCITY_NONE;
    mut boundMaterial = Ref[MaterialSlot].none();
    mut b = 0usize;
    while b < r.batches.len() {
      imm batch = *r.batches[b];
      b = b + 1usize;
      if batch.layer != LAYER_OPAQUE { continue; }
      // Only a batch with a moving copy among its copies
      mut moving = false;
      mut j = 0u32;
      while j < batch.count {
        imm itemIndex = usize.from(r.keys[usize.from(batch.first + j)].item);
        if *itemEntry[itemIndex] != 0u32 { moving = true; }
        j = j + 1u32;
      }
      if !moving { continue; }
      imm first = *r.keys[usize.from(batch.first)];
      imm item = list.items[usize.from(first.item)];
      imm m = r.meshes[item.mesh.slot].current();
      imm kind = velocityKindOf(r, item, m);
      if kind == VELOCITY_NONE { continue; }
      if bound != kind {
        if kind == VELOCITY_OPAQUE { pass.setPipeline(&opaque); }
        elif kind == VELOCITY_OPAQUE_SKINNED { pass.setPipeline(&opaqueSkinned); }
        elif kind == VELOCITY_LIT_CUT { pass.setPipeline(&litCut); }
        elif kind == VELOCITY_LIT_CUT_SKINNED { pass.setPipeline(&litCutSkinned); }
        elif kind == VELOCITY_PBR_CUT { pass.setPipeline(&pbrCut); }
        else { pass.setPipeline(&pbrCutSkinned); }
        pass.setBindGroup(0u32, &r.frameGroup);
        pass.setBindGroup(2u32, &velocityGroup);
        bound = kind;
        boundMaterial = Ref[MaterialSlot].none();
      }
      if kind != VELOCITY_OPAQUE and kind != VELOCITY_OPAQUE_SKINNED and !(boundMaterial == item.material.slot) {
        pass.setBindGroup(1u32, &r.materials[item.material.slot].group);
        boundMaterial = item.material.slot;
      }
      pass.setVertexBuffer(0u32, &m.positions, 0u64);
      if kind == VELOCITY_OPAQUE_SKINNED {
        pass.setVertexBuffer(1u32, &m.joints, 0u64);
        pass.setVertexBuffer(2u32, &m.weights, 0u64);
      } elif kind == VELOCITY_LIT_CUT or kind == VELOCITY_PBR_CUT {
        pass.setVertexBuffer(1u32, &m.uvs, 0u64);
      } elif kind == VELOCITY_LIT_CUT_SKINNED or kind == VELOCITY_PBR_CUT_SKINNED {
        pass.setVertexBuffer(1u32, &m.uvs, 0u64);
        pass.setVertexBuffer(2u32, &m.joints, 0u64);
        pass.setVertexBuffer(3u32, &m.weights, 0u64);
      }
      pass.setIndexBuffer(&m.indices, INDEX_FORMAT_UINT32, 0u64);
      mut g = 0usize;
      while g < m.groups.len() {
        imm group = m.groups[g];
        pass.drawIndexed(group.count, batch.count, group.start, 0i32, batch.firstInstance);
        g = g + 1usize;
      }
      drawn = drawn + 1u32;
    }
    pass.end();
  }

  // Resolve 'current' (the frame, jittered) and the history into the other
  // history, then sharpen it into 'sharp' if 'sharpness' says. The new
  // history is 'latestHistory()'.
  pub fn recordResolve(self &mut, encoder &mut CommandEncoder, s &TaaSettings, hasVelocity bool) {
    imm read = latest;
    imm write = 1u32 - latest;
    imm flags = if hasVelocity { 1u32; } else { 0u32; };
    imm data = new TaaImmediates(s.maxSamples, s.clipGamma, s.hdrWeight, s.sharpness, flags, s.motionBlend, 0., 0.);
    imm target = if write == 0u32 { history0.createView(); } else { history1.createView(); };
    fxPass(encoder, target, false, &resolve, resolveGroups[usize.from(read)], &data as *u8, 32u32);
    latest = write;
    if s.sharpness > 0. {
      imm sharpTarget = sharp.createView();
      fxPass(encoder, sharpTarget, false, &sharpen, sharpenGroups[usize.from(write)], &data as *u8, 32u32);
    }
  }
}

// Which velocity pipeline a draw of 'item' (mesh 'm') is drawn with, or
// VELOCITY_NONE if it is not drawn (a custom pipeline's material, a
// see-through one: they are treated as static)
fn velocityKindOf(r &Renderer, item &DrawItem, m &GpuMesh) u32 {
  if !r.materials.alive(item.material.slot) { return VELOCITY_NONE; }
  imm ms = r.materials[item.material.slot];
  imm skinned = m.isSkinned();
  if ms.kind == MATERIAL_CUSTOM { return VELOCITY_NONE; }
  if ms.kind == MATERIAL_PBR {
    if ms.pbr.alphaMode == ALPHA_BLEND { return VELOCITY_NONE; }
    if ms.pbr.alphaMode == ALPHA_MASK { return if skinned { VELOCITY_PBR_CUT_SKINNED; } else { VELOCITY_PBR_CUT; }; }
    return if skinned { VELOCITY_OPAQUE_SKINNED; } else { VELOCITY_OPAQUE; };
  }
  if ms.params.alphaMode == ALPHA_BLEND { return VELOCITY_NONE; }
  if ms.params.alphaMode == ALPHA_MASK { return if skinned { VELOCITY_LIT_CUT_SKINNED; } else { VELOCITY_LIT_CUT; }; }
  if skinned { VELOCITY_OPAQUE_SKINNED; } else { VELOCITY_OPAQUE; };
}

fn resolveGroup(device &mut Device, layout &BindGroupLayout, frameBuffer &Buffer, sampler &Sampler, current &TextureView,
    history &TextureView, depth &TextureView, velocity &TextureView) BindGroup {
  imm entries = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.sampler(1u32, sampler),
    BindGroupEntry.texture(2u32, current), BindGroupEntry.texture(3u32, history), BindGroupEntry.texture(4u32, depth),
    BindGroupEntry.texture(5u32, velocity)];
  device.createBindGroup(layout, &entries);
}

// A velocity pipeline: the scene's depth tested (less or equal, with a
// little bias so that the same surface drawn by another shader passes) and
// not written; the velocity texture (rgba16float) written
fn velocityPipeline(device &mut Device, layout &PipelineLayout, shader &ShaderModule, vertex &str, fragment &str,
    buffers &Array[VertexBufferLayout]) RenderPipeline {
  imm desc = new RenderPipelineDescriptor(layout: layout, vertexModule: shader, vertexEntryPoint: vertex, buffers: buffers,
    fragmentModule: shader, fragmentEntryPoint: fragment, colorFormat: TEXTURE_FORMAT_RGBA16_FLOAT,
    cullMode: CULL_MODE_BACK, depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: false,
    depthCompare: COMPARE_FUNCTION_LESS_EQUAL, depthBiasConstant: 4., depthBiasSlopeScale: 1.);
  device.createRenderPipeline(&desc);
}

