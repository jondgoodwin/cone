// Volumetric fog in the renderer: a froxel volume lit by the sun through the
// cascaded shadow map (god rays), height fog, and a density the program sets
// (fog.slang has the method: Wronski 2014 and Hillaire 2015). Off by default.
// fx.cone drives it: after the scene, the decals and the occlusion, before
// the depth of field. A RenderView (views.cone) drives one of its own over its
// picture, for a mirror or a portal: for a camera with an oblique near plane the
// shader takes the planar distance from the inverse view-projection (a plain
// perspective's from the depth alone, as the main view always has).
//
// SETTING IT FROM OUTSIDE. 'FogSettings' is read every frame: a weather system
// sets 'density' (the uniform extinction, per metre: clear air is 0.0005, haze
// 0.003, mist 0.02, thick fog 0.1), 'heightDensity' and 'heightFalloff' for
// a fog that lies low, 'albedo' for its colour, 'anisotropy' for how much it
// glows towards the sun. The shafts of light need shadows on
// ('Renderer.setShadows'); without them the fog is lit evenly.
//
// WHAT IT DOES NOT DO: the see-through (ALPHA_BLEND) draws are drawn before it
// and are not in the depth, so a pane of glass in thick fog is fogged as the
// surface behind it is; fog does not scatter the clustered point lights (a
// light list is the follow-up).

// How the fog is made and lit
pub struct FogSettings {
  pub enabled: bool = false;
  // The medium: a uniform extinction (per metre), and a fog whose extinction
  // at 'baseHeight' is 'heightDensity' and falls off exponentially above it,
  // by 'heightFalloff' per metre
  pub density: f32 = 0.004;
  pub heightDensity: f32 = 0.;
  pub heightFalloff: f32 = 0.1;
  pub baseHeight: f32 = 0.;
  // The share of the extinction that scatters (the rest absorbs), as a colour
  pub albedo: Color = new Color(1., 1., 1., 1.);
  // Henyey-Greenstein's g: 0 scatters evenly, towards 1 more forward (towards
  // the sun, when it is in front of the camera)
  pub anisotropy: f32 = 0.5;
  // Multipliers on the sun's light and on the ambient's
  pub sunScattering: f32 = 1.;
  pub ambientScattering: f32 = 1.;
  // The volume reaches from 'nearDistance' to 'maxDistance' metres in front of the camera
  pub nearDistance: f32 = 0.5;
  pub maxDistance: f32 = 120.;
  // The froxel grid: a cell is 'tileSize' pixels across, 'slices' deep (exponentially spaced)
  pub tileSize: u32 = 16u32;
  pub slices: u32 = 64u32;
  // Shadow taps a froxel takes (1 to 8)
  pub shadowTaps: u32 = 4u32;
  // The share of this frame's volume in the one shown, the rest being last
  // frame's reprojected (it smooths the froxels' noise and banding); 1 uses no history
  pub temporal: f32 = 0.15;

  // A grid of 16-pixel cells and 64 slices, 4 shadow taps: for a discrete GPU
  pub fn high() FogSettings { new FogSettings(enabled: true) }
  // 16-pixel cells, 48 slices, 3 taps
  pub fn medium() FogSettings { new FogSettings(enabled: true, slices: 48u32, shadowTaps: 3u32) }
  // 32-pixel cells, 32 slices, 2 taps, a nearer limit: for an integrated GPU
  pub fn low() FogSettings {
    new FogSettings(enabled: true, tileSize: 32u32, slices: 32u32, shadowTaps: 2u32, maxDistance: 90.)
  }
}

// What the passes' immediates hold (fog.slang's FogImmediates): 80 bytes
struct FogImmediates {
  density: f32;
  heightDensity: f32;
  heightFalloff: f32;
  baseHeight: f32;
  albedo: Array[f32, 4];
  anisotropy: f32;
  sunScattering: f32;
  ambientScattering: f32;
  temporal: f32;
  nearDistance: f32;
  farDistance: f32;
  slices: u32;
  gridX: u32;
  gridY: u32;
  frame: u32;
  shadowTaps: u32;
  pad: f32;
}

pub struct FogPass {
  pub shader: ShaderModule;
  pub computeLayout: BindGroupLayout;
  pub computePipelineLayout: PipelineLayout;
  pub injectPipeline: ComputePipeline;
  pub integratePipeline: ComputePipeline;
  pub applyLayout: BindGroupLayout;
  pub applyPipelineLayout: PipelineLayout;
  pub applyPipeline: RenderPipeline;
  pub sampler: Sampler;                     // linear, clamped
  pub shadowSampler: Sampler;               // the renderer's comparison sampler is used for the map: this is the volume's
  pub vol0: Texture;                        // the injected light, twice (this frame's and last's)
  pub vol1: Texture;
  pub integrated: Texture;
  pub injectGroups: List[BindGroup];        // [k]: reads vol 1 - k (the history), writes vol k
  pub integrateGroups: List[BindGroup];     // [k]: reads vol k, writes the integrated volume
  pub applyGroup: BindGroup;
  pub current: u32;                         // the volume this frame writes
  pub gridX: u32;
  pub gridY: u32;
  pub slices: u32;
  pub shadowKey: u32;                       // the shadow map the groups were made for (its size and layers)
  pub frames: u32;                          // frames the volume has been made for since it began
  pub drawn: bool;

  pub fn create(device: &mut Device, shadow: &ShadowState, frameBuffer: &Buffer, depth: &TextureView) FogPass {
    var shader = device.createShaderModule(&FOG_SPIRV);
    let computeEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_COMPUTE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_COMPUTE),
      new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_TEXTURE,
        viewDimension: TEXTURE_VIEW_DIMENSION_2D_ARRAY, sampleType: TEXTURE_SAMPLE_TYPE_DEPTH),
      new BindGroupLayoutEntry(binding: 6u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_SAMPLER),
      new BindGroupLayoutEntry(binding: 7u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_TEXTURE,
        viewDimension: TEXTURE_VIEW_DIMENSION_3D),
      new BindGroupLayoutEntry(binding: 8u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_SAMPLER),
      new BindGroupLayoutEntry(binding: 9u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_STORAGE_TEXTURE,
        format: TEXTURE_FORMAT_RGBA16_FLOAT, viewDimension: TEXTURE_VIEW_DIMENSION_3D)];
    var computeLayout = device.createBindGroupLayout(&computeEntries);
    let computeLayouts = [&computeLayout];
    var computePipelineLayout = device.createPipelineLayout(&computeLayouts, 80u32);
    let injectDesc = new ComputePipelineDescriptor(layout: &computePipelineLayout, module: &shader, entryPoint: "injectMain");
    var injectPipeline = device.createComputePipeline(&injectDesc);
    let integrateDesc = new ComputePipelineDescriptor(layout: &computePipelineLayout, module: &shader, entryPoint: "integrateMain");
    var integratePipeline = device.createComputePipeline(&integrateDesc);
    let applyEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH),
      new BindGroupLayoutEntry(binding: 7u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        viewDimension: TEXTURE_VIEW_DIMENSION_3D),
      new BindGroupLayoutEntry(binding: 8u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    var applyLayout = device.createBindGroupLayout(&applyEntries);
    let applyLayouts = [&applyLayout];
    var applyPipelineLayout = device.createPipelineLayout(&applyLayouts, 80u32);
    var applyPipeline = fxPipeline(device, &applyPipelineLayout, &shader, "applyMain", TEXTURE_FORMAT_RGBA16_FLOAT, true);
    let samplerDesc = new SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    var sampler = device.createSampler(&samplerDesc);
    var shadowSampler = device.createSampler(&samplerDesc);
    let tiny = volumeDescriptor(1u32, 1u32, 1u32);
    var vol0 = device.createTexture(&tiny);
    var vol1 = device.createTexture(&tiny);
    var integrated = device.createTexture(&tiny);
    let threeD = new TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_3D);
    let vi = integrated.createViewWith(&threeD);
    let applyEntriesGroup = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.texture(1u32, depth),
      BindGroupEntry.texture(7u32, &vi), BindGroupEntry.sampler(8u32, &sampler)];
    var applyGroup = device.createBindGroup(&applyLayout, &applyEntriesGroup);
    var fog = new FogPass(shader, computeLayout, computePipelineLayout, injectPipeline, integratePipeline, applyLayout,
      applyPipelineLayout, applyPipeline, sampler, shadowSampler, vol0, vol1, integrated, List[BindGroup].empty(),
      List[BindGroup].empty(), applyGroup, 0u32, 1u32, 1u32, 1u32, 0u32, 0u32, false);
    fog.makeGroups(device, shadow, frameBuffer, depth);
    fog
  }

  pub fn isValid(self: &) bool {
    injectPipeline.isValid() && integratePipeline.isValid() && applyPipeline.isValid() && vol0.isValid()
      && applyGroup.isValid()
  }

  // The volumes for a frame of 'width' by 'height' (tiny when not 'enabled'),
  // by the grid 's' says, and the groups over them
  pub fn remake(self: &mut, device: &mut Device, enabled: bool, width: u32, height: u32, s: &FogSettings, shadow: &ShadowState,
      frameBuffer: &Buffer, depth: &TextureView) {
    let tile = if s.tileSize < 4u32 { 4u32 } else { s.tileSize };
    gridX = if enabled { (width + tile - 1u32) / tile } else { 1u32 };
    gridY = if enabled { (height + tile - 1u32) / tile } else { 1u32 };
    slices = if enabled { if s.slices < 2u32 { 2u32 } else { s.slices } } else { 1u32 };
    let desc = volumeDescriptor(gridX, gridY, slices);
    vol0 = device.createTexture(&desc);
    vol1 = device.createTexture(&desc);
    integrated = device.createTexture(&desc);
    frames = 0u32;
    self.makeGroups(device, shadow, frameBuffer, depth);
  }

  fn makeGroups(self: &mut, device: &mut Device, shadow: &ShadowState, frameBuffer: &Buffer, depth: &TextureView) {
    let threeD = new TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_3D);
    let v0 = vol0.createViewWith(&threeD);
    let v1 = vol1.createViewWith(&threeD);
    let vi = integrated.createViewWith(&threeD);
    let map = shadow.arrayView();
    injectGroups = List[BindGroup].empty();
    integrateGroups = List[BindGroup].empty();
    injectGroups.push(self.computeGroup(device, frameBuffer, shadow, &map, &v1, &v0));
    injectGroups.push(self.computeGroup(device, frameBuffer, shadow, &map, &v0, &v1));
    integrateGroups.push(self.computeGroup(device, frameBuffer, shadow, &map, &v0, &vi));
    integrateGroups.push(self.computeGroup(device, frameBuffer, shadow, &map, &v1, &vi));
    let applyEntries = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.texture(1u32, depth),
      BindGroupEntry.texture(7u32, &vi), BindGroupEntry.sampler(8u32, &sampler)];
    applyGroup = device.createBindGroup(&applyLayout, &applyEntries);
    shadowKey = shadow.map.width * 8u32 + shadow.map.depthOrArrayLayers;
  }

  fn computeGroup(self: &, device: &mut Device, frameBuffer: &Buffer, shadow: &ShadowState, map: &TextureView,
      read: &TextureView, write: &TextureView) BindGroup {
    let entries = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.buffer(4u32, &shadow.params),
      BindGroupEntry.texture(5u32, map), BindGroupEntry.sampler(6u32, &shadow.sampler), BindGroupEntry.texture(7u32, read),
      BindGroupEntry.sampler(8u32, &sampler), BindGroupEntry.texture(9u32, write)];
    device.createBindGroup(&computeLayout, &entries)
  }

  // Make the volume of this frame and draw it over 'hdr'. 'history' says the
  // last frame's volume may be blended in.
  pub fn record(self: &mut, device: &mut Device, encoder: &mut CommandEncoder, shadow: &ShadowState, frameBuffer: &Buffer,
      depth: &TextureView, hdr: &Texture, s: &FogSettings, frame: u32, history: bool) {
    // The shadow map may have been made again (the settings, the tier)
    if shadowKey != shadow.map.width * 8u32 + shadow.map.depthOrArrayLayers {
      self.makeGroups(device, shadow, frameBuffer, depth);
    }
    let temporal = if history && frames > 0u32 && s.temporal < 1. { s.temporal } else { 1. };
    let far = if s.maxDistance > s.nearDistance * 2. { s.maxDistance } else { s.nearDistance * 2. };
    let data = new FogImmediates(s.density, s.heightDensity, s.heightFalloff, s.baseHeight,
      [s.albedo.red, s.albedo.green, s.albedo.blue, 1.], s.anisotropy, s.sunScattering, s.ambientScattering, temporal,
      s.nearDistance, far, slices, gridX, gridY, frame, s.shadowTaps, 0.);
    {
      var pass = encoder.beginComputePass();
      pass.setPipeline(&injectPipeline);
      pass.setBindGroup(0u32, injectGroups[usize.from(current)]);
      pass.setImmediates(0u32, &data as *u8, 80u32);
      pass.dispatchWorkgroups((gridX + 7u32) / 8u32, (gridY + 7u32) / 8u32, (slices + 3u32) / 4u32);
      pass.setPipeline(&integratePipeline);
      pass.setBindGroup(0u32, integrateGroups[usize.from(current)]);
      pass.dispatchWorkgroups((gridX + 7u32) / 8u32, (gridY + 7u32) / 8u32, 1u32);
      pass.end();
    }
    current = 1u32 - current;
    frames = frames + 1u32;
    fxPass(encoder, hdr.createView(), true, &applyPipeline, &applyGroup, &data as *u8, 80u32);
  }
}

// A 3-D texture of 'x' by 'y' by 'z' texels, rgba16float, written by compute
// and sampled
fn volumeDescriptor(x: u32, y: u32, z: u32) TextureDescriptor {
  new TextureDescriptor(x, y, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_TEXTURE_BINDING,
    depthOrArrayLayers: z, dimension: TEXTURE_DIMENSION_3D)
}

