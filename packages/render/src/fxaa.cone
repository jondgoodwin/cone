// FXAA: fast approximate anti-aliasing of the finished picture, the cheap tier
// (fxaa.slang has the method: Lottes's FXAA 3.11, quality preset 29). The tone
// map draws into an intermediate texture of the output format, and this
// pass reads it and draws the antialiased picture into the target; fx.cone
// drives it. It costs one full-screen pass and no memory beyond that texture,
// and does nothing for what is smaller than a pixel in motion (the shimmer of
// a leaf) as temporal anti-aliasing does.

// How FXAA is done (the defaults are Lottes's)
pub struct FxaaSettings {
  // How much sub-pixel aliasing (a lone bright pixel in a dark field) is
  // removed, 0 to 1
  pub subpixel f32 = 0.75;
  // The contrast that makes a pixel an edge: the larger of 'edgeThresholdMin'
  // and this share of the brightest neighbour (0.166 is the default, 0.125
  // sharper and slower, 0.25 faster)
  pub edgeThreshold f32 = 0.166;
  pub edgeThresholdMin f32 = 0.0833;
}

// What the pass's immediates hold (fxaa.slang's FxaaImmediates)
struct FxaaImmediates {
  rcpX f32;
  rcpY f32;
  subpixel f32;
  edgeThreshold f32;
  edgeThresholdMin f32;
  pad0 f32;
  pad1 f32;
  pad2 f32;
}

pub struct FxaaPass {
  pub shader ShaderModule;
  pub layout BindGroupLayout;
  pub pipelineLayout PipelineLayout;
  pub pipeline RenderPipeline;
  pub sampler Sampler;
  pub ldr Texture;                 // the tone-mapped picture, of the output format
  pub group BindGroup;

  pub fn create(device &mut Device, outputFormat u32) FxaaPass {
    var shader = device.createShaderModule(&FXAA_SPIRV);
    let entries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    var layout = device.createBindGroupLayout(&entries);
    let layouts = [&layout];
    var pipelineLayout = device.createPipelineLayout(&layouts, 32u32);
    var pipeline = fxPipeline(device, &pipelineLayout, &shader, "fxaaMain", outputFormat, false);
    let samplerDesc = new SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    var sampler = device.createSampler(&samplerDesc);
    let tiny = new TextureDescriptor(1u32, 1u32, outputFormat, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    var ldr = device.createTexture(&tiny);
    let view = ldr.createView();
    let groupEntries = [BindGroupEntry.texture(0u32, &view), BindGroupEntry.sampler(1u32, &sampler)];
    var group = device.createBindGroup(&layout, &groupEntries);
    new FxaaPass(shader, layout, pipelineLayout, pipeline, sampler, ldr, group);
  }

  pub fn isValid(self &) bool { pipeline.isValid() and ldr.isValid() and group.isValid(); }

  // The intermediate texture made at 'width' by 'height' of 'outputFormat'
  // (tiny when not 'enabled'), and its group
  pub fn remake(self &mut, device &mut Device, enabled bool, width u32, height u32, outputFormat u32) {
    let w = if enabled { width; } else { 1u32; };
    let h = if enabled { height; } else { 1u32; };
    let desc = new TextureDescriptor(w, h, outputFormat, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    ldr = device.createTexture(&desc);
    let view = ldr.createView();
    let groupEntries = [BindGroupEntry.texture(0u32, &view), BindGroupEntry.sampler(1u32, &sampler)];
    group = device.createBindGroup(&layout, &groupEntries);
  }

  // Draw the intermediate picture, antialiased, into 'target'
  pub fn record(self &mut, encoder &mut CommandEncoder, target &Texture, s &FxaaSettings) {
    let data = new FxaaImmediates(1. / f32.from(ldr.width), 1. / f32.from(ldr.height), s.subpixel, s.edgeThreshold,
      s.edgeThresholdMin, 0., 0., 0.);
    fxPass(encoder, target.createView(), false, &pipeline, &group, &data as *u8, 32u32);
  }
}

