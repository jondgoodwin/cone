// Mip chains for the textures materials sample, made on the CPU as a texture
// is added and uploaded with it ('Queue.writeTextureLevels').
//
// WHY THE CPU. The GPU could blit each level from the one above
// (vkCmdBlitImage), but the gpu package has no blit, a linear blit needs the
// format to support it (the sRGB one does on every GPU met, but it is the
// driver's say), and a blit averages an sRGB texture's samples by whatever
// route the driver takes; a normal map must be renormalised by a shader
// besides. On the CPU the average is exact and the same on every GPU: a
// colour texture's texels are decoded from sRGB, averaged in linear light
// and encoded again; a normal map's are averaged as vectors and made unit
// length again; any other map's (roughness, metallic, occlusion) are
// averaged as the numbers they are. What it costs is time as a texture is
// added (about a third more texels than the base level, read once each),
// which the caller sees at load, not in a frame.
//
// Each level is made from the one above it kept in floating point, so the
// 8-bit rounding of a level does not pile up down the chain. A level is half
// the one above in each direction (at least 1); where the size above is odd,
// a texel averages the 2 or 3 above it that its footprint touches. The alpha
// channel is averaged as it is (not weighted by itself).
//
// A CUT-OUT card (a conifer's needle tuft, a fence) is the exception, MIP_CUTOUT.
// A plain average of its alpha thins as the levels shrink: a tuft a third
// covered keeps a third as its mean alpha, but a material that cuts out below
// one half then discards every texel of a small level, and the tree seen from
// afar has no foliage left. So each level's alpha is scaled until the same
// share of its texels passes the cut-off as the base level's (the alpha-to-coverage
// practice of foliage, and Castano, "Computing Alpha Mipmaps", 2010), and
// its colour is averaged weighted by alpha, so the clear texels' colour does not
// dilute the needles'.

pub const MIP_COLOUR = 0u32;     // sRGB colour: averaged in linear light
pub const MIP_LINEAR = 1u32;     // numbers (roughness, metallic, occlusion): averaged as they are
pub const MIP_NORMAL = 2u32;     // a tangent-space normal map: averaged as vectors, made unit length
pub const MIP_CUTOUT = 3u32;     // sRGB colour with an alpha that cuts out: colour weighted by alpha, coverage kept

// How many levels a texture of this size has: down to one texel
pub fn mipLevelCount(width: u32, height: u32) u32 {
  var size = if width > height { width } else { height };
  var n = 1u32;
  while size > 1u32 {
    size = size >> 1u32;
    n = n + 1u32;
  }
  n
}

// The linear light of sRGB value 'c' (0 to 1)
fn srgbDecode(c: f32) f32 {
  if c <= 0.04045 { return c / 12.92; }
  libc.powf((c + 0.055) / 1.055, 2.4)
}

// Table: the linear light of each of the 256 sRGB bytes
fn srgbDecodeTable() List[f32] {
  var t = List[f32].withCapacity(256usize);
  var i = 0u32;
  while i < 256u32 {
    t.push(srgbDecode(f32.from(i) / 255.));
    i = i + 1u32;
  }
  t
}

// Table: the 255 linear values half-way between neighbouring sRGB bytes, so
// the byte nearest a linear value is how many of them it passes
fn srgbThresholds(decode: &Array[f32]) List[f32] {
  var t = List[f32].withCapacity(255usize);
  var i = 0usize;
  while i < 255usize {
    t.push((decode[i] + decode[i + 1usize]) * 0.5);
    i = i + 1usize;
  }
  t
}

// The sRGB byte nearest the linear value 'v'
fn srgbEncode(v: f32, thresholds: &Array[f32]) u8 {
  var lo = 0usize;
  var hi = 255usize;
  while lo < hi {
    let mid = (lo + hi) / 2usize;
    if v > thresholds[mid] { lo = mid + 1usize; } else { hi = mid; }
  }
  u8.from(lo)
}

// A byte for a value in 0 to 1
fn unitByte(v: f32) u8 { colorByte(v) }

// Rewrite the alpha bytes of the level just written to 'out' (from 'start', four
// bytes a texel, alpha the fourth) from its averaged alpha 'level', scaled by
// the factor that lets 'coverage' of its texels reach 'cutoff': the alpha that
// the texel 'coverage' of the way down from the brightest has is the one that
// is raised to the cut-off. The scale is read off a 256-bin histogram of the alpha
// (the coverage is met to within a bin), and held to at most 8 times.
fn cutoutCoverage(out: &mut List[u8], start: usize, level: &List[f32], cutoff: f32, coverage: f32) {
  let texels = level.len() / 4usize;
  var bins = List[usize].withCapacity(256usize);
  var z = 0usize;
  while z < 256usize { bins.push(0usize); z = z + 1usize; }
  var t = 0usize;
  while t < texels {
    let a = *level[t * 4usize + 3usize];
    let k = if a >= 1. { 255usize } else if a <= 0. { 0usize } else { usize.from(u32.from(a * 255.)) };
    bins.set(k, *bins[k] + 1usize);
    t = t + 1usize;
  }
  // from the top bin down, until 'coverage' of the texels are counted
  let want = coverage * f32.from(texels);
  var counted: f32 = 0.;
  var before: f32 = 0.;
  var k = 255usize;
  var found = false;
  while !found && k > 0usize {
    before = counted;
    counted = counted + f32.from(*bins[k]);
    if counted >= want { found = true; } else { k = k - 1usize; }
  }
  // the bin where the count passes 'want' goes wholly in or wholly out, whichever lands nearer
  // (alpha is quantised at the small levels, and a bin can hold a good part of the texels): in,
  // the threshold is its lower edge; out, the next bin's
  var edge = k;
  if found && want - before < counted - want && k < 255usize { edge = k + 1usize; }
  let threshold = f32.from(u32.from(edge)) / 255.;
  if threshold <= 0.0001 { return; }
  var scale = cutoff / threshold;
  if scale > 8. { scale = 8.; }
  if scale < 0.5 { scale = 0.5; }
  t = 0usize;
  while t < texels {
    let a = *level[t * 4usize + 3usize] * scale;
    out.set(start + t * 4usize + 3usize, unitByte(a));
    t = t + 1usize;
  }
}

// All the levels of the RGBA image 'rgba' ('width' x 'height', rows from the
// top as uploaded), one after another from the largest, which is 'rgba'
// itself, each tightly packed. 'kind' is MIP_COLOUR, MIP_LINEAR or MIP_NORMAL.
pub fn buildMips(rgba: &List[u8], width: u32, height: u32, kind: u32) List[u8] {
  buildMipsCut(rgba, width, height, kind, 0.5)
}

// The same, and for 'kind' MIP_CUTOUT with the material's cut-off: each level's
// alpha scaled so that as many of its texels are at or above 'cutoff' as the
// base level's are, its colour averaged weighted by alpha
pub fn buildMipsCut(rgba: &List[u8], width: u32, height: u32, kind: u32, cutoff: f32) List[u8] {
  let cutKind = kind == MIP_CUTOUT;
  let colourKind = kind == MIP_COLOUR || cutKind;
  var out = List[u8].withCapacity(usize.from(width) * usize.from(height) * 5usize + 64usize);
  let base = rgba.view();
  var c = 0usize;
  while c < base.len() {
    out.push(base[c]);
    c = c + 1usize;
  }
  let decode = srgbDecodeTable();
  let decodeV = decode.view();
  let thresholds = srgbThresholds(decodeV);
  let thresholdsV = thresholds.view();

  // The base level in the floating-point form its kind averages in
  var prev = List[f32].withCapacity(base.len());
  var i = 0usize;
  while i < base.len() {
    let channel = i % 4usize;
    let b = base[i];
    if channel == 3usize {
      prev.push(f32.from(b) / 255.);
    } else if colourKind {
      prev.push(decodeV[usize.from(b)]);
    } else if kind == MIP_NORMAL {
      prev.push(f32.from(b) / 255. * 2. - 1.);
    } else {
      prev.push(f32.from(b) / 255.);
    }
    i = i + 1usize;
  }
  // A cut-out's coverage: the share of the base level's texels at or above the cut-off
  var coverage: f32 = 0.;
  if cutKind {
    var passing = 0usize;
    var t = 0usize;
    while t < base.len() / 4usize {
      if f32.from(base[t * 4usize + 3usize]) / 255. >= cutoff { passing = passing + 1usize; }
      t = t + 1usize;
    }
    coverage = f32.from(passing) / f32.from(base.len() / 4usize);
  }

  var pw = width;
  var ph = height;
  while pw > 1u32 || ph > 1u32 {
    let nw = if pw > 1u32 { pw >> 1u32 } else { 1u32 };
    let nh = if ph > 1u32 { ph >> 1u32 } else { 1u32 };
    let src = prev.view();
    var next = List[f32].withCapacity(usize.from(nw) * usize.from(nh) * 4usize);
    let levelStart = out.len();
    var y = 0u32;
    while y < nh {
      // The rows above this one's footprint covers
      let y0 = y * ph / nh;
      var y1 = ((y + 1u32) * ph + nh - 1u32) / nh;
      if y1 > ph { y1 = ph; }
      var x = 0u32;
      while x < nw {
        let x0 = x * pw / nw;
        var x1 = ((x + 1u32) * pw + nw - 1u32) / nw;
        if x1 > pw { x1 = pw; }
        var r = 0.f;
        var g = 0.f;
        var b = 0.f;
        var a = 0.f;
        // (a cut-out's colour weighted by alpha)
        var wr = 0.f;
        var wg = 0.f;
        var wb = 0.f;
        var sy = y0;
        while sy < y1 {
          var sx = x0;
          while sx < x1 {
            let at = (usize.from(sy) * usize.from(pw) + usize.from(sx)) * 4usize;
            r = r + src[at];
            g = g + src[at + 1usize];
            b = b + src[at + 2usize];
            a = a + src[at + 3usize];
            wr = wr + src[at] * src[at + 3usize];
            wg = wg + src[at + 1usize] * src[at + 3usize];
            wb = wb + src[at + 2usize] * src[at + 3usize];
            sx = sx + 1u32;
          }
          sy = sy + 1u32;
        }
        let inv = 1. / f32.from((y1 - y0) * (x1 - x0));
        if cutKind && a > 0.0001 {
          r = wr / a;
          g = wg / a;
          b = wb / a;
        } else {
          r = r * inv;
          g = g * inv;
          b = b * inv;
        }
        a = a * inv;
        if kind == MIP_NORMAL {
          // The average of unit vectors is shorter than one; made unit again.
          // A cancelled one (no direction left) is flat.
          let len = libc.sqrtf(r * r + g * g + b * b);
          if len > 0.0001 {
            r = r / len;
            g = g / len;
            b = b / len;
          } else {
            r = 0.;
            g = 0.;
            b = 1.;
          }
        }
        next.push(r);
        next.push(g);
        next.push(b);
        next.push(a);
        if colourKind {
          out.push(srgbEncode(r, thresholdsV));
          out.push(srgbEncode(g, thresholdsV));
          out.push(srgbEncode(b, thresholdsV));
        } else if kind == MIP_NORMAL {
          out.push(unitByte(r * 0.5 + 0.5));
          out.push(unitByte(g * 0.5 + 0.5));
          out.push(unitByte(b * 0.5 + 0.5));
        } else {
          out.push(unitByte(r));
          out.push(unitByte(g));
          out.push(unitByte(b));
        }
        out.push(unitByte(a));
        x = x + 1u32;
      }
      y = y + 1u32;
    }
    if cutKind && coverage > 0. && coverage < 1. {
      cutoutCoverage(&mut out, levelStart, &next, cutoff, coverage);
    }
    prev = next;
    pw = nw;
    ph = nh;
  }
  out
}
