// Camera and Light.
//
// A camera is placed like anything else (origin, orientation, scale) and looks
// down its own -z. Its two matrices are the projection, perspective or
// orthogonal, with the modern APIs' depth from 0 at the near plane to 1 at the
// far (geomath's Mat4.perspective and Mat4.orthographic), and the view, which
// carries world coordinates into the camera's. A camera may follow something:
// it is then placed relative to that thing's placement, looking out from its
// 'eye'. What it draws into is not the camera's: the renderer hands the
// target's aspect to 'projectionMatrix'.

// A camera's projection: Pegasus's 'Perspective' and 'Orthogonal' symbols
pub const Perspective = 0;
pub const Orthogonal = 1;

pub struct Camera {
  pub projection i32;       // Perspective (default) or Orthogonal
  pub fov f32;              // perspective: the vertical field of view, in radians
  pub viewHeight f32;       // orthogonal: the height of what it sees
  pub near f32;             // nothing nearer than this is drawn
  pub far f32;              // nor further than this
  pub origin Vec3;          // where it is
  pub orientation Quat;     // which way it faces
  pub scale Vec3;
  pub background Color;     // what the renderer clears to
  pub following Bool;       // placed relative to 'followMatrix'?
  pub followMatrix Mat4;    // the placement of the thing it follows
  pub eye Vec3;             // where on that thing it looks out from

  // Pegasus's new camera: perspective, a field of view of 50 degrees (an
  // orthogonal view 10 high), drawing from 0.1 to 1000 away, at (0, 0, 5)
  // looking down -z at the origin, clearing to black
  pub fn make() Camera {
    Camera[Perspective, radians(50.), 10., 0.1, 1000., Vec3[0., 0., 5.], Quat.identity(), Vec3[1., 1., 1.],
      Color[0., 0., 0., 1.], false, Mat4.identity(), Vec3[0., 0., 0.]];
  }

  // Place it at 'eye', facing 'target', 'up' saying which way is up (its
  // own -z at the target, its +y as near 'up' as it can be)
  pub fn lookAt(self &mut, eye Vec3, target Vec3, up Vec3) {
    origin = eye;
    orientation = rotationOf(Mat4.targetTo(eye, target, up));
  }

  // Its perspective projection into a target 'aspect' wide for each unit
  // high, depth from 0 to 1
  pub fn perspective(self &, aspect f32) Mat4 { Mat4.perspective(fov, aspect, near, far); }

  // Its orthogonal projection, depth from 0 to 1. It looks down -z and sees
  // 'viewHeight' above and below its middle, and that times the aspect to
  // either side.
  pub fn orthogonal(self &, aspect f32) Mat4 {
    imm w = viewHeight * aspect;
    Mat4.orthographic(-w, w, -viewHeight, viewHeight, near, far);
  }

  // The projection its 'projection' names, into a target 'aspect' wide for
  // each unit high
  pub fn projectionMatrix(self &, aspect f32) Mat4 {
    if projection == Orthogonal { self.orthogonal(aspect); } else { self.perspective(aspect); }
  }

  // Where it is placed: relative to the thing it follows, looking out from
  // that thing's eye
  pub fn placement(self &) Mat4 {
    imm cammat = Mat4.fromTrs(origin, orientation, scale);
    if following {
      mut follow = followMatrix;
      imm e = followMatrix * eye;
      follow.m[12] = e.x;
      follow.m[13] = e.y;
      follow.m[14] = e.z;
      follow * cammat;
    } else {
      cammat;
    }
  }

  // Its view matrix: the inverse of where it is placed
  pub fn viewMatrix(self &) Mat4 { self.placement().inverse(); }

  // Where it is in world coordinates
  pub fn position(self &) Vec3 { self.placement().translation(); }

  // A point in the local coordinates of something placed by 'mmatrix', in
  // the camera's (eye) coordinates (Pegasus's CameraXyz)
  pub fn cameraPoint(self &, p Vec3, mmatrix Mat4) Vec3 { (self.viewMatrix() * mmatrix) * p; }

  // How many pixels high a sphere of 'radius' at 'center' (world coordinates)
  // looks, drawn into a target 'viewportHeight' pixels high: its projected
  // diameter, which a LodChain chooses by. A sphere around the camera fills
  // it: the viewport's height.
  pub fn projectedSize(self &, center Vec3, radius f32, viewportHeight f32) f32 {
    if projection == Orthogonal { return radius / viewHeight * viewportHeight; }
    imm d = center.distance(self.position());
    if d <= radius { return viewportHeight; }
    radius / (d * tan(fov * 0.5)) * viewportHeight;
  }
}

// The rotation of a placement matrix of no scale, as a quaternion (the
// matrix's upper 3 x 3, by Shepperd's method: the largest of the four
// candidates is taken, for accuracy)
fn rotationOf(m Mat4) Quat {
  imm m00 = m.m[0];
  imm m11 = m.m[5];
  imm m22 = m.m[10];
  imm trace = m00 + m11 + m22;
  if trace > 0. {
    imm s = (trace + 1.).sqrt() * 2.;
    return Quat[(m.m[6] - m.m[9]) / s, (m.m[8] - m.m[2]) / s, (m.m[1] - m.m[4]) / s, 0.25 * s];
  }
  if m00 > m11 and m00 > m22 {
    imm s = (1. + m00 - m11 - m22).sqrt() * 2.;
    return Quat[0.25 * s, (m.m[4] + m.m[1]) / s, (m.m[8] + m.m[2]) / s, (m.m[6] - m.m[9]) / s];
  }
  if m11 > m22 {
    imm s = (1. + m11 - m00 - m22).sqrt() * 2.;
    return Quat[(m.m[4] + m.m[1]) / s, 0.25 * s, (m.m[9] + m.m[6]) / s, (m.m[8] - m.m[2]) / s];
  }
  imm s = (1. + m22 - m00 - m11).sqrt() * 2.;
  Quat[(m.m[8] + m.m[2]) / s, (m.m[9] + m.m[6]) / s, 0.25 * s, (m.m[1] - m.m[4]) / s];
}

// The light: one directional light, the sun's kind, and the ambient light
// everything gets from everywhere. It reaches the shaders through the
// renderer's frame uniforms. (More lights, and point and spot lights, would
// come with a light list.)
pub struct Light {
  pub direction Vec3;       // the way the light travels: unit length
  pub color Color;          // what it gives a surface facing it head on
  pub ambient Color;

  // A light travelling along 'direction'
  pub fn directional(direction Vec3, color Color, ambient Color) Light {
    Light[direction.normalize(), color, ambient];
  }

  // A light from far off in the direction of 'position' from the origin,
  // shining towards the origin, as Pegasus's scenes placed their one light
  pub fn from(position Vec3, color Color, ambient Color) Light {
    Light[(Vec3[0., 0., 0.] - position).normalize(), color, ambient];
  }
}
