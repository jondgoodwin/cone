// The scene as a ray tracer sees it: what the extended material's ray-traced glass, soap film and
// reflections cast their rays into (rtglass.slang), kept up to date from the draw list each frame.
//
// On a device with ray tracing (gpu's raytracing.cone) the renderer keeps one RtScene beside its extended
// material when ray tracing is asked for ('Renderer.setRayTracing'). Each render it
// - makes a bottom-level structure for each mesh that is in the draw list, once (again when the mesh is
//   replaced), and copies that mesh's normals and indices into two shared buffers the shaders read the hit's
//   normal from;
// - writes one record for each instance (its material's look: colour, kind, index of refraction,
//   absorption, film, emission) and one instance of the top-level structure (the model matrix, the mask: 1 for
//   an opaque surface, 2 for glass or film, the record's place as the custom index);
// - builds the top-level structure, whose bind group the extended pipelines' group 3 holds.
// The records are the material description as it is, copied: there is no second material format, and the
// raster path (scenecapture.slang's glass over the captured frame) reads the same fields.
//
// What is left out, and counted in 'skipped' or simply not seen by a ray: skinned meshes (their bones move
// them every frame; a refit is not built), lines, a custom pipeline's material, a see-through material that
// is not glass, and textures (a record holds the base colour; the camera's own picture of a surface it sees is
// used for the surface where it can be, rtglass.slang). A mesh with several material groups is one
// instance with one material.

// The most instances a frame's structure holds, and the room for meshes' normals (vertices) and indices
pub const RT_MAX_INSTANCES = 4096u32;
const RT_NORMAL_CAPACITY = 1048576u32;
const RT_INDEX_CAPACITY = 3145728u32;
// A record's bytes (rtglass.slang's RtRecord)
const RT_RECORD_BYTES = 112u64;

const RT_KIND_OPAQUE = 0f;
const RT_KIND_SOLID = 1f;
const RT_KIND_FILM = 2f;

// An instance's look, as rtglass.slang's RtRecord reads it
struct RtRecord {
  a Array[f32, 4];                 // base colour rgb (the copy's tint in), metallic
  b Array[f32, 4];                 // roughness, index of refraction, kind, share that passes
  c Array[f32, 4];                 // the attenuation colour and distance
  d Array[f32, 4];                 // the film: least and greatest thickness, index, 1 if there is one
  e Array[f32, 4];                 // the film's noise: scale, drift, warp, seed
  f Array[f32, 4];                 // emitted radiance rgb, dispersion
  geometry Array[u32, 4];          // first normal (in vertices), first index
}

// A mesh with a bottom-level structure
struct RtMesh {
  mesh Ref[MeshSlot];
  version u32;
  blas AccelerationStructure;
  normalBase u32;
  indexBase u32;
  usable bool;
}

pub struct RtScene {
  pub tlas AccelerationStructure;
  pub records Buffer;              // the records, a storage buffer (group 3, binding 7)
  pub normals Buffer;              // every mesh's normals, tight float3s (binding 8)
  pub indices Buffer;              // every mesh's indices (binding 9)
  meshes List[RtMesh];
  normalUsed u32;
  indexUsed u32;
  instanceList List[AccelerationStructureInstance];
  recordList List[RtRecord];
  resetNext bool;
  pub count u32;                   // instances in the structure just built
  pub skipped u32;                 // items left out of it (too many, or not representable)
  pub built u32;                   // bottom-level structures built so far
  pub frames u32;                  // structures built so far

  // No ray tracing: not valid
  pub fn none() RtScene {
    new RtScene(AccelerationStructure.none(), Buffer.none(), Buffer.none(), Buffer.none(), List[RtMesh].empty(), 0u32, 0u32,
      List[AccelerationStructureInstance].empty(), List[RtRecord].empty(), false, 0u32, 0u32, 0u32, 0u32)
  }

  pub fn isValid(self &) bool { tlas.isValid() and records.isValid() and normals.isValid() and indices.isValid() }

  // The structure and buffers for a device with ray tracing. Check 'isValid'.
  pub fn create(device &mut Device) RtScene {
    var s = RtScene.none();
    if !device.rayTracing { return s; }
    s.tlas = device.createTopLevel(RT_MAX_INSTANCES);
    s.records = device.createBuffer(u64.from(RT_MAX_INSTANCES) * RT_RECORD_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    s.normals = device.createBuffer(u64.from(RT_NORMAL_CAPACITY) * 12u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    s.indices = device.createBuffer(u64.from(RT_INDEX_CAPACITY) * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    s
  }

  // The place of mesh 'h' in 'meshes' if it has a usable structure for 'version', made (and built into 'encoder')
  // if not; -1 if it cannot be made
  fn meshFor(self &mut, device &mut Device, encoder &mut CommandEncoder, h MeshHandle, m &GpuMesh, version u32) i32 {
    var i = 0usize;
    var found = false;
    while i < meshes.len() and !found {
      if meshes[i].mesh == h.slot {
        if meshes[i].version == version {
          if meshes[i].usable { return i32.from(i); }
          return -1i32;
        }
        found = true;
      } else {
        i = i + 1usize;
      }
    }
    var entry = new RtMesh(h.slot, version, AccelerationStructure.none(), 0u32, 0u32, false);
    let tracesIt = (m.positions.usage & BUFFER_USAGE_ACCELERATION_STRUCTURE_INPUT) != 0u32
      and (m.indices.usage & BUFFER_USAGE_ACCELERATION_STRUCTURE_INPUT) != 0u32;
    if tracesIt and normalUsed + m.vertexCount <= RT_NORMAL_CAPACITY and indexUsed + m.indexCount <= RT_INDEX_CAPACITY {
      var blas = device.createBottomLevel(&m.positions, m.vertexCount, &m.indices, m.indexCount);
      if blas.isValid() {
        encoder.buildAccelerationStructure(&blas, 0u32);
        device.queue.releaseBuffer(&mut blas.scratch);
        encoder.copyBufferToBuffer(&m.normals, 0u64, &normals, u64.from(normalUsed) * 12u64, u64.from(m.vertexCount) * 12u64);
        encoder.copyBufferToBuffer(&m.indices, 0u64, &indices, u64.from(indexUsed) * 4u64, u64.from(m.indexCount) * 4u64);
        entry.blas = blas;
        entry.normalBase = normalUsed;
        entry.indexBase = indexUsed;
        entry.usable = true;
        normalUsed = normalUsed + m.vertexCount;
        indexUsed = indexUsed + m.indexCount;
        built = built + 1u32;
      }
    } elif tracesIt {
      // The shared buffers are full: start them again next frame
      resetNext = true;
    }
    if i < meshes.len() {
      meshes.set(i, entry);
    } else {
      meshes.push(entry);
    }
    if meshes[i].usable { i32.from(i) } else { -1i32 }
  }

  // Build this frame's structure from 'items' (the first 'mainEnd' of them): every mesh that is alive and a
  // material that is representable; the bottom-level structures first, into 'encoder', then the top level. The
  // encoder is not in a pass.
  pub fn update(self &mut, device &mut Device, encoder &mut CommandEncoder, meshPool &Pool[MeshSlot],
      materialPool &Pool[MaterialSlot], items &List[DrawItem], mainEnd usize) {
    if resetNext {
      meshes.clear();
      normalUsed = 0u32;
      indexUsed = 0u32;
      resetNext = false;
    }
    instanceList.clear();
    recordList.clear();
    skipped = 0u32;
    var k = 0usize;
    while k < mainEnd {
      let item = items[k];
      k = k + 1usize;
      if !meshPool.alive(item.mesh.slot) or !materialPool.alive(item.material.slot) { continue; }
      let slot = meshPool[item.mesh.slot];
      let m = slot.current();
      let mslot = materialPool[item.material.slot];
      if !m.isValid() or m.isSkinned() or m.topology != PRIMITIVE_TOPOLOGY_TRIANGLE_LIST or item.bones != NO_BONES
          or item.fade != 0. {
        skipped = skipped + 1u32;
        continue;
      }
      let mask = rtMaskOf(mslot);
      if mask == 0u32 {
        skipped = skipped + 1u32;
        continue;
      }
      if instanceList.len() >= usize.from(RT_MAX_INSTANCES) {
        skipped = skipped + 1u32;
        continue;
      }
      let at = self.meshFor(device, encoder, item.mesh, m, slot.version);
      if at < 0i32 {
        skipped = skipped + 1u32;
        continue;
      }
      let entry = meshes[usize.from(u32.from(at))];
      var tr = new Array[f32, 12] <- fill 0f;
      var row = 0usize;
      while row < 3usize {
        var col = 0usize;
        while col < 4usize {
          tr[row * 4usize + col] = item.model.m[col * 4usize + row];
          col = col + 1usize;
        }
        row = row + 1usize;
      }
      let id = u32.from(recordList.len());
      instanceList.push(new AccelerationStructureInstance(tr, id | (mask << 24u32),
        INSTANCE_FLAG_TRIANGLE_FACING_CULL_DISABLE << 24u32, entry.blas.address));
      recordList.push(rtRecordOf(mslot, item.tint, entry.normalBase, entry.indexBase));
    }
    count = u32.from(instanceList.len());
    if count > 0u32 {
      device.queue.writeBuffer(&tlas.instances, 0u64, bytesOf[AccelerationStructureInstance](&instanceList),
        u64.from(count) * ACCELERATION_STRUCTURE_INSTANCE_BYTES);
      device.queue.writeBuffer(&records, 0u64, bytesOf[RtRecord](&recordList), u64.from(count) * RT_RECORD_BYTES);
    }
    encoder.buildAccelerationStructure(&tlas, count);
    frames = frames + 1u32;
  }
}

// The instance mask of an item with this material: 1 for an opaque surface, 2 for glass or film; 0 if a ray
// cannot be given it
fn rtMaskOf(m &MaterialSlot) u32 {
  if m.kind == MATERIAL_PBR {
    let p = m.pbr;
    if p.alphaMode == ALPHA_BLEND {
      if p.glass > 0. { return 2u32; }
      return 0u32;
    }
    return 1u32;
  }
  if m.kind == MATERIAL_BLINN_PHONG and !m.blend { return 1u32; }
  0u32
}

// The record of the material 'm' on a copy tinted 'tint'
fn rtRecordOf(m &MaterialSlot, tint Color, normalBase u32, indexBase u32) RtRecord {
  var r = new RtRecord([0f, 0f, 0f, 0f], [0f, 0f, 0f, 0f], [1f, 1f, 1f, 1f], [0f, 0f, 0f, 0f], [0f, 0f, 0f, 0f],
    [0f, 0f, 0f, 0f], [normalBase, indexBase, 0u32, 0u32]);
  if m.kind == MATERIAL_PBR {
    let p = m.pbr;
    r.a = [p.baseColor.red * tint.red, p.baseColor.green * tint.green, p.baseColor.blue * tint.blue, p.metallic];
    var kind = RT_KIND_OPAQUE;
    var share = 1f;
    if p.alphaMode == ALPHA_BLEND and p.glass > 0. {
      kind = RT_KIND_SOLID;
      // A film on a slab thinner than a millimetre is a soap film: one thin sheet at each face
      if p.film and p.thickness < 0.001 { kind = RT_KIND_FILM; }
      share = p.glass;
    }
    r.b = [p.roughness, p.ior, kind, share];
    r.c = [p.attenuationColor.red, p.attenuationColor.green, p.attenuationColor.blue, p.attenuationDistance];
    r.d = [p.filmMin, p.filmMax, p.filmIor, if p.film { 1f } else { 0f }];
    r.e = [p.filmScale, p.filmDrift, p.filmWarp, f32.from(p.filmSeed)];
    let glow = p.emissiveStrength;
    r.f = [p.emissive.red * glow * tint.red, p.emissive.green * glow * tint.green, p.emissive.blue * glow * tint.blue, p.dispersion];
  } else {
    let p = m.params;
    r.a = [p.baseColor.red * tint.red, p.baseColor.green * tint.green, p.baseColor.blue * tint.blue, 0f];
    r.b = [0.6, 1.5, RT_KIND_OPAQUE, 1f];
    r.f = [p.emissive.red * tint.red, p.emissive.green * tint.green, p.emissive.blue * tint.blue, 0f];
  }
  r
}

