// The extended material's machinery: the capture of the frame drawn so far,
// the pipelines that read it, and the tables the lobes read. Made when the
// first material that needs it is added (Renderer.ensureExtended), so a
// program that never asks for sheen, anisotropy, subsurface, glass or
// reflections pays for none of it.
//
// WHAT IT ADDS TO A FRAME. The renderer draws the opaque meshes in one render pass.
// With extended materials in the frame it draws them in up to three:
//   1. the opaque meshes that do not read the frame, the sky not yet;
//   2. [a capture of 1] the opaque meshes that reflect the frame ('reflections'
//      above 0: screen-space reflections), which see everything the first pass drew;
//   3. [the sky; a capture of 1 and 2 and the sky] the glass, which refracts what
//      the capture shows behind it, and then the rest of the see-through meshes.
// A capture is the colour target copied into level 0 of a pyramid (a texture of
// several levels, each filtered down from the one above, capture.slang), and
// the depth buffer copied into an r32float texture, by full-screen passes;
// it costs a pass a level and is made only when something reads it. This is the
// "scene colour" and "opaque texture" capture other engines make before their
// transparent pass (Unity's _CameraOpaqueTexture, Unreal's SceneColor copy,
// Godot's screen texture), and the reflecting meshes are drawn after it as
// Frostbite's and Unity's forward SSR do. What it cannot do is stated with the
// design: a reflecting mesh does not reflect another reflecting mesh (each
// misses and falls back to the environment); glass does not refract other
// glass; neither sees what is off screen (the environment answers, by the
// probe whose box holds the copy, or by the sky). A render into a target the
// capture cannot read (one that cannot be sampled: a swapchain's image) captures
// nothing and the extended materials fall back the same way.
//
// BINDING. The extended pipelines use the renderer's three bind groups and a
// fourth, group 3, the capture's (scenecapture.slang): the colour pyramid, the
// depth copy, the two tables, a sampler and the capture's parameters. Until
// something is captured in a render the group bound is a stand-in with the
// same tables and one-texel pictures, whose parameters say "no capture".
//
// THE TABLES, baked once (capture.slang): the diffusion table for
// pre-integrated subsurface scattering (128 x 64) and the sheen lobe's
// directional albedo (32 x 32).

// A volume of caustics, the focused light of the sun beneath a rippled surface (a water surface, a
// sheet of rippled glass): the surfaces inside 'boxMin' to 'boxMax' that are caustic receivers
// ('PbrMaterial.causticReceiver') have the sun's light on them brightened where the
// ripples focus it and dimmed where they spread it (scenecapture.slang's causticLight has the
// method). The surface is a flat plane at 'surfaceHeight' (a world y, above the box) with four
// crossing waves of 'rippleHeight' metres, the longest 'wavelength' metres long, drifting at 'speed'
// (1 is a calm pond's), and 'ior' the index of the medium (1.33 water). Nothing is drawn for the
// surface itself (a water surface is the caller's: ViewMaterials.waterMaterial).
pub struct CausticVolume {
  pub boxMin: Vec3;
  pub boxMax: Vec3;
  pub surfaceHeight: f32;
  pub strength: f32 = 1.;           // 0 (off) to 1 (the focusing in full)
  pub rippleHeight: f32 = 0.012;
  pub wavelength: f32 = 0.35;
  pub speed: f32 = 1.;
  pub ior: f32 = 1.33;

  // Nothing
  pub fn none() CausticVolume {
    CausticVolume(Vec3(0., 0., 0.), Vec3(0., 0., 0.), 0., 0.)
  }
}

// How hard screen-space reflections try: the ray marcher's settings, a quality
// tier each ('high' for a discrete GPU, 'low' for an integrated one). A material's own
// 'reflections' is how much of the result it uses.
pub struct ReflectionSettings {
  // The longest a ray goes, in metres
  pub maxDistance: f32 = 40.;
  // The most steps a ray takes, each 'stride' pixels apart
  pub steps: u32 = 64u32;
  pub stride: f32 = 4.;
  // How deep a surface the depth buffer is taken to be, in metres (plus 3% of its distance)
  pub thickness: f32 = 0.3;
  // No ray is cast for a surface rougher than this (perceptual roughness)
  pub roughnessCutoff: f32 = 0.65;
  // The reflection fades to the environment over this share of the frame at its edge
  pub edgeFade: f32 = 0.08;
  // And over this many metres, for a long ray: 0, not at all
  pub fadeDistance: f32 = 0.;

  // 96 steps of 3 pixels: a discrete GPU
  pub fn high() ReflectionSettings {
    ReflectionSettings(maxDistance: 60., steps: 96u32, stride: 3., thickness: 0.25)
  }
  // 64 steps of 4 pixels
  pub fn medium() ReflectionSettings { ReflectionSettings() }
  // 32 steps of 8 pixels: an integrated one
  pub fn low() ReflectionSettings {
    ReflectionSettings(maxDistance: 30., steps: 32u32, stride: 8., thickness: 0.5, roughnessCutoff: 0.5)
  }
}

// The size of the diffusion table and the sheen table
const DIFFUSION_WIDTH = 128u32;
const DIFFUSION_HEIGHT = 64u32;
const SHEEN_TABLE = 32u32;
// The most levels of the colour pyramid, and the bytes of the capture's parameters (scenecapture.slang's SceneParams)
const PYRAMID_LEVELS = 8u32;
const SCENE_PARAM_BYTES = 112u64;
// of which the capture's own, written with each capture, are the first 64; the caustic volume's are the rest
const CAPTURE_PARAM_BYTES = 64u64;

struct CaptureImmediates {
  texelX: f32;
  texelY: f32;
  karis: f32;
  pad: f32;
}

pub struct SceneCapture {
  pub settings: ReflectionSettings;
  pub sceneLayout: BindGroupLayout;       // group 3
  pub pipelineLayout: PipelineLayout;     // frame, material, environment, scene
  pub shader: ShaderModule;               // pbrx.spv
  pub opaquePipeline: RenderPipeline;
  pub skinnedPipeline: RenderPipeline;
  pub blendPipeline: RenderPipeline;
  pub skinnedBlendPipeline: RenderPipeline;
  pub tangentPipeline: RenderPipeline;    // opaque, for a mesh with tangents (a fourth vertex stream)
  pub glassPipeline: RenderPipeline;      // see-through that writes depth: ray-traced glass, which replaces what is behind it
  captureShader: ShaderModule;            // capture.spv
  colorLayout: BindGroupLayout;           // a colour source and a sampler
  colorPipelineLayout: PipelineLayout;
  depthLayout: BindGroupLayout;           // a depth source
  depthPipelineLayout: PipelineLayout;
  bakePipelineLayout: PipelineLayout;
  copyPipeline: RenderPipeline;
  downPipeline: RenderPipeline;
  depthPipeline: RenderPipeline;
  diffusionPipeline: RenderPipeline;
  sheenPipeline: RenderPipeline;
  sampler: Sampler;                       // linear, clamped, linear between levels
  pub pyramid: Texture;                   // rgba16float, several levels
  pub depthCopy: Texture;                 // r32float
  pub diffusion: Texture;                 // the tables, 128 x 64 and 32 x 32 rgba16float (red channel)
  pub sheen: Texture;
  standInColor: Texture;
  standInDepth: Texture;
  params: Buffer;
  standInParams: Buffer;
  downGroups: List[BindGroup];            // level k - 1 as a source, for level k
  pub group: BindGroup;                   // group 3 once a capture was made
  pub standInGroup: BindGroup;            // group 3 before one
  width: u32;
  height: u32;
  pub levels: u32;
  tablesBaked: bool;
  pub captures: u32;                      // how many captures have been made (a test counts them)
  rtEntries: List[BindGroupEntry];        // group 3's bindings 6 to 9 when rayTraced: the structure, records, normals, indices
  pub forceAll: bool = false;             // draw every physically based material with the extended pipelines (a test)
  pub rayTraced: bool = false;            // made over a ray-traced scene: pbrxrt.spv, and group 3 holds the structure (raytrace.cone)

  // The pipelines and tables for a renderer of these formats, over its frame, material
  // and environment layouts. Check 'isValid'. With a valid 'rt' (raytrace.cone) the pipelines are those of the
  // ray-traced extended shader (pbrxrt.spv), and group 3 holds the structure and the buffers its hits are read from.
  pub fn create(device: &mut Device, colorFormat: u32, depthFormat: u32, frameLayout: &BindGroupLayout,
      pbrMaterialLayout: &BindGroupLayout, environmentLayout: &BindGroupLayout, settings: &ReflectionSettings,
      rt: &RtScene) SceneCapture {
    let traced = rt.isValid();
    // Group 3
    let sceneEntries = [BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT),
      BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER),
      BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_FRAGMENT),
      BindGroupLayoutEntry(binding: 6u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_ACCELERATION_STRUCTURE),
      BindGroupLayoutEntry(binding: 7u32, visibility: SHADER_STAGE_FRAGMENT, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 8u32, visibility: SHADER_STAGE_FRAGMENT, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 9u32, visibility: SHADER_STAGE_FRAGMENT, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE)];
    var sceneLayout = if traced { device.createBindGroupLayout(&sceneEntries) }
      else { device.createBindGroupLayout(&sceneEntries[..<6]) };
    let groups = [frameLayout, pbrMaterialLayout, environmentLayout, &sceneLayout];
    var pipelineLayout = device.createPipelineLayout(&groups, IMMEDIATE_BYTES);
    var rtEntries = List[BindGroupEntry].empty();
    if traced {
      rtEntries.push(BindGroupEntry.accelerationStructure(6u32, &rt.tlas));
      rtEntries.push(BindGroupEntry.buffer(7u32, &rt.records));
      rtEntries.push(BindGroupEntry.buffer(8u32, &rt.normals));
      rtEntries.push(BindGroupEntry.buffer(9u32, &rt.indices));
    }

    // The extended pipelines: pbr.slang's stages, the fragment stage fragmentExtended
    var shader = if traced { device.createShaderModule(&PBRXRT_SPIRV) } else { device.createShaderModule(&PBRX_SPIRV) };
    let positionAttr = [VertexAttribute(VERTEX_FORMAT_FLOAT32X3, 0u64, 0u32)];
    let normalAttr = [VertexAttribute(VERTEX_FORMAT_FLOAT32X3, 0u64, 1u32)];
    let uvAttr = [VertexAttribute(VERTEX_FORMAT_FLOAT32X2, 0u64, 2u32)];
    let jointsAttr = [VertexAttribute(VERTEX_FORMAT_UINT8X4, 0u64, 3u32)];
    let weightsAttr = [VertexAttribute(VERTEX_FORMAT_UNORM8X4, 0u64, 4u32)];
    let litBuffers = [VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr),
      VertexBufferLayout(arrayStride: 12u64, attributes: &normalAttr),
      VertexBufferLayout(arrayStride: 8u64, attributes: &uvAttr)];
    let skinnedBuffers = [VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr),
      VertexBufferLayout(arrayStride: 12u64, attributes: &normalAttr),
      VertexBufferLayout(arrayStride: 8u64, attributes: &uvAttr),
      VertexBufferLayout(arrayStride: 4u64, attributes: &jointsAttr),
      VertexBufferLayout(arrayStride: 4u64, attributes: &weightsAttr)];
    let opaqueDesc = RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader, buffers: &litBuffers,
      fragmentModule: &shader, fragmentEntryPoint: "fragmentExtended", colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS);
    var opaquePipeline = device.createRenderPipeline(&opaqueDesc);
    let skinnedDesc = RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader,
      vertexEntryPoint: "vertexSkinned", buffers: &skinnedBuffers, fragmentModule: &shader,
      fragmentEntryPoint: "fragmentExtended", colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS);
    var skinnedPipeline = device.createRenderPipeline(&skinnedDesc);
    let blendDesc = RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader, buffers: &litBuffers,
      fragmentModule: &shader, fragmentEntryPoint: "fragmentExtended", colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var blendPipeline = device.createRenderPipeline(&blendDesc);
    let skinnedBlendDesc = RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader,
      vertexEntryPoint: "vertexSkinned", buffers: &skinnedBuffers, fragmentModule: &shader,
      fragmentEntryPoint: "fragmentExtended", colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var skinnedBlendPipeline = device.createRenderPipeline(&skinnedBlendDesc);
    // Ray-traced glass: found by rays through the whole scene, it replaces what is behind it, so it writes depth
    // (the glass nearest the eye wins whatever the order they are drawn in); the blend is as the see-through one's
    let glassDesc = RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader, buffers: &litBuffers,
      fragmentModule: &shader, fragmentEntryPoint: "fragmentExtended", colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: traced, depthCompare: COMPARE_FUNCTION_LESS,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var glassPipeline = device.createRenderPipeline(&glassDesc);
    // A mesh with tangents: the tangents as a fourth buffer, read at location 3
    let tangentAttr = [VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 0u64, 3u32)];
    let tangentBuffers = [VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr),
      VertexBufferLayout(arrayStride: 12u64, attributes: &normalAttr),
      VertexBufferLayout(arrayStride: 8u64, attributes: &uvAttr),
      VertexBufferLayout(arrayStride: 16u64, attributes: &tangentAttr)];
    let tangentDesc = RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader,
      vertexEntryPoint: "vertexTangent", buffers: &tangentBuffers, fragmentModule: &shader,
      fragmentEntryPoint: "fragmentExtended", colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS);
    var tangentPipeline = device.createRenderPipeline(&tangentDesc);

    // The capture's passes and the bakes
    var captureShader = device.createShaderModule(&CAPTURE_SPIRV);
    let colorEntries = [BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    var colorLayout = device.createBindGroupLayout(&colorEntries);
    let colorGroups = [&colorLayout];
    var colorPipelineLayout = device.createPipelineLayout(&colorGroups, 16u32);
    let depthEntries = [BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
      sampleType: TEXTURE_SAMPLE_TYPE_DEPTH)];
    var depthLayout = device.createBindGroupLayout(&depthEntries);
    let depthGroups = [&depthLayout];
    var depthPipelineLayout = device.createPipelineLayout(&depthGroups, 0u32);
    var bakePipelineLayout = device.createPipelineLayout(&colorGroups[..<0], 0u32);
    var copyPipeline = fxPipeline(device, &colorPipelineLayout, &captureShader, "copyMain", TEXTURE_FORMAT_RGBA16_FLOAT, false);
    var downPipeline = fxPipeline(device, &colorPipelineLayout, &captureShader, "downMain", TEXTURE_FORMAT_RGBA16_FLOAT, false);
    var depthPipeline = fxPipeline(device, &depthPipelineLayout, &captureShader, "depthMain", TEXTURE_FORMAT_R32_FLOAT, false);
    var diffusionPipeline = fxPipeline(device, &bakePipelineLayout, &captureShader, "diffusionBakeMain",
      TEXTURE_FORMAT_RGBA16_FLOAT, false);
    var sheenPipeline = fxPipeline(device, &bakePipelineLayout, &captureShader, "sheenBakeMain",
      TEXTURE_FORMAT_RGBA16_FLOAT, false);

    let samplerDesc = SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE, mipmapFilter: FILTER_MODE_LINEAR);
    var sampler = device.createSampler(&samplerDesc);

    let usage = TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING;
    let one = TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_RGBA16_FLOAT, usage);
    var pyramid = device.createTexture(&one);
    let oneDepth = TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_R32_FLOAT, usage);
    var depthCopy = device.createTexture(&oneDepth);
    var standInColor = device.createTexture(&one);
    var standInDepth = device.createTexture(&oneDepth);
    // The tables can be read back (the tests check them against a CPU integral)
    let diffusionDesc = TextureDescriptor(DIFFUSION_WIDTH, DIFFUSION_HEIGHT, TEXTURE_FORMAT_RGBA16_FLOAT,
      usage | TEXTURE_USAGE_COPY_SRC);
    var diffusion = device.createTexture(&diffusionDesc);
    let sheenDesc = TextureDescriptor(SHEEN_TABLE, SHEEN_TABLE, TEXTURE_FORMAT_RGBA16_FLOAT, usage | TEXTURE_USAGE_COPY_SRC);
    var sheen = device.createTexture(&sheenDesc);
    var params = device.createBuffer(SCENE_PARAM_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    var standInParams = device.createBuffer(SCENE_PARAM_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    // The stand-in group's parameters: no capture, one texel
    let none = Array[f32, 28]() <- fill 0f;
    var standIn = none;
    standIn[0] = 1.;
    standIn[1] = 1.;
    standIn[2] = 1.;
    standIn[3] = 1.;
    device.queue.writeBuffer(&standInParams, 0u64, &standIn as *u8, SCENE_PARAM_BYTES);
    device.queue.writeBuffer(&params, 0u64, &standIn as *u8, SCENE_PARAM_BYTES);

    let standInColorView = standInColor.createView();
    let standInDepthView = standInDepth.createView();
    let diffusionView = diffusion.createView();
    let sheenView = sheen.createView();
    let standInEntries = sceneGroupEntries(&standInColorView, &standInDepthView, &diffusionView, &sheenView, &sampler,
      &standInParams, &rtEntries);
    var standInGroup = device.createBindGroup(&sceneLayout, standInEntries.view());
    let pyramidView = pyramid.createView();
    let depthCopyView = depthCopy.createView();
    let liveEntries = sceneGroupEntries(&pyramidView, &depthCopyView, &diffusionView, &sheenView, &sampler, &params,
      &rtEntries);
    var group = device.createBindGroup(&sceneLayout, liveEntries.view());
    var result = SceneCapture(*settings, sceneLayout, pipelineLayout, shader, opaquePipeline, skinnedPipeline, blendPipeline,
      skinnedBlendPipeline, tangentPipeline, glassPipeline, captureShader, colorLayout, colorPipelineLayout, depthLayout,
      depthPipelineLayout, bakePipelineLayout, copyPipeline, downPipeline, depthPipeline, diffusionPipeline, sheenPipeline,
      sampler, pyramid, depthCopy, diffusion, sheen, standInColor, standInDepth, params, standInParams, List[BindGroup].empty(),
      group, standInGroup, 1u32, 1u32, 1u32, false, 0u32, rtEntries);
    result.rayTraced = traced;
    result
  }

  pub fn isValid(self: &) bool {
    opaquePipeline.isValid() && skinnedPipeline.isValid() && blendPipeline.isValid() && skinnedBlendPipeline.isValid()
      && glassPipeline.isValid() && tangentPipeline.isValid() && copyPipeline.isValid() && downPipeline.isValid() && depthPipeline.isValid() && diffusionPipeline.isValid()
      && sheenPipeline.isValid() && group.isValid() && standInGroup.isValid() && sampler.isValid()
      && diffusion.isValid() && sheen.isValid()
  }

  // The caustic volume: written to both groups' parameters (the stand-in's too: caustics need no capture)
  pub fn setCaustics(self: &mut, device: &mut Device, v: &CausticVolume) {
    var p = Array[f32, 12]() <- fill 0f;
    p[0] = v.boxMin.x;
    p[1] = v.boxMin.y;
    p[2] = v.boxMin.z;
    p[3] = v.strength;
    p[4] = v.boxMax.x;
    p[5] = v.boxMax.y;
    p[6] = v.boxMax.z;
    p[7] = v.surfaceHeight;
    p[8] = v.rippleHeight;
    p[9] = v.wavelength;
    p[10] = v.speed;
    p[11] = v.ior;
    device.queue.writeBuffer(&params, CAPTURE_PARAM_BYTES, &p as *u8, 48u64);
    device.queue.writeBuffer(&standInParams, CAPTURE_PARAM_BYTES, &p as *u8, 48u64);
  }

  // Bake the two tables into 'encoder', the first time
  pub fn bake(self: &mut, encoder: &mut CommandEncoder) {
    if tablesBaked { return; }
    tablesBaked = true;
    tablePass(encoder, diffusion.createView(), &diffusionPipeline);
    tablePass(encoder, sheen.createView(), &sheenPipeline);
  }

  // The pyramid and the depth copy for a frame of 'w' by 'h', made again if they are not of that size
  fn ensureSize(self: &mut, device: &mut Device, w: u32, h: u32) {
    if w == width && h == height { return; }
    device.queue.releaseTexture(&mut pyramid);
    device.queue.releaseTexture(&mut depthCopy);
    device.queue.releaseBindGroup(&mut group);
    var k = 0usize;
    while k < downGroups.len() {
      device.queue.releaseBindGroup(&mut downGroups[k]);
      k = k + 1usize;
    }
    downGroups.clear();
    var small = if w < h { w } else { h };
    var n = 1u32;
    while small >= 16u32 && n < PYRAMID_LEVELS {
      small = small / 2u32;
      n = n + 1u32;
    }
    levels = n;
    width = w;
    height = h;
    let usage = TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_SRC;
    let pyramidDesc = TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA16_FLOAT, usage, n);
    pyramid = device.createTexture(&pyramidDesc);
    let depthDesc = TextureDescriptor(w, h, TEXTURE_FORMAT_R32_FLOAT, usage);
    depthCopy = device.createTexture(&depthDesc);
    var level = 1u32;
    while level < n {
      let sourceDesc = TextureViewDescriptor(baseMipLevel: level - 1u32, mipLevelCount: 1u32);
      let source = pyramid.createViewWith(&sourceDesc);
      let entries = [BindGroupEntry.texture(0u32, &source), BindGroupEntry.sampler(1u32, &sampler)];
      downGroups.push(device.createBindGroup(&colorLayout, &entries));
      level = level + 1u32;
    }
    let diffusionView = diffusion.createView();
    let sheenView = sheen.createView();
    let pyramidView = pyramid.createView();
    let depthCopyView = depthCopy.createView();
    let liveEntries = sceneGroupEntries(&pyramidView, &depthCopyView, &diffusionView, &sheenView, &sampler, &params,
      &rtEntries);
    group = device.createBindGroup(&sceneLayout, liveEntries.view());
  }

  // Capture the frame drawn so far into 'encoder': 'color' (the target, a view of a texture that can
  // be sampled) into the pyramid's top level and the levels below it, and 'depth' into the depth copy.
  // 'width' and 'height' are the target's; 'projectionA' and 'projectionB' the camera's depth projection
  // (a depth z is B / (z + A) in front of the camera); 'frame' numbers the frame (the march's noise).
  pub fn capture(self: &mut, device: &mut Device, encoder: &mut CommandEncoder, color: &TextureView, depth: &TextureView,
      w: u32, h: u32, projectionA: f32, projectionB: f32, frame: u32) {
    self.ensureSize(device, w, h);
    captures = captures + 1u32;
    var p = Array[f32, 16]() <- fill 0f;
    p[0] = f32.from(w);
    p[1] = f32.from(h);
    p[2] = 1. / f32.from(w);
    p[3] = 1. / f32.from(h);
    p[4] = f32.from(levels - 1u32);
    p[5] = 1.;
    p[6] = projectionA;
    p[7] = projectionB;
    p[8] = settings.maxDistance;
    p[9] = f32.from(settings.steps);
    p[10] = settings.stride;
    p[11] = settings.thickness;
    p[12] = settings.roughnessCutoff;
    p[13] = settings.edgeFade;
    p[14] = if settings.fadeDistance > 0. { 1. / settings.fadeDistance } else { 0. };
    p[15] = f32.from(frame);
    device.queue.writeBuffer(&params, 0u64, &p as *u8, CAPTURE_PARAM_BYTES);

    // The target as it is, into level 0
    {
      let entries = [BindGroupEntry.texture(0u32, color), BindGroupEntry.sampler(1u32, &sampler)];
      var g = device.createBindGroup(&colorLayout, &entries);
      let immediates = CaptureImmediates(0., 0., 0., 0.);
      let top = TextureViewDescriptor(baseMipLevel: 0u32, mipLevelCount: 1u32);
      fxPass(encoder, pyramid.createViewWith(&top), false, &copyPipeline, &g, &immediates as *u8, 16u32);
      device.queue.releaseBindGroup(&mut g);
    }
    // Each level from the one above
    var level = 1u32;
    while level < levels {
      let lw = if (w >> (level - 1u32)) > 0u32 { w >> (level - 1u32) } else { 1u32 };
      let lh = if (h >> (level - 1u32)) > 0u32 { h >> (level - 1u32) } else { 1u32 };
      let immediates = CaptureImmediates(1. / f32.from(lw), 1. / f32.from(lh), if level == 1u32 { 1. } else { 0. }, 0.);
      let view = TextureViewDescriptor(baseMipLevel: level, mipLevelCount: 1u32);
      fxPass(encoder, pyramid.createViewWith(&view), false, &downPipeline, &downGroups[usize.from(level - 1u32)],
        &immediates as *u8, 16u32);
      level = level + 1u32;
    }
    // The depth
    {
      let entries = [BindGroupEntry.texture(2u32, depth)];
      var g = device.createBindGroup(&depthLayout, &entries);
      fxPass(encoder, depthCopy.createView(), false, &depthPipeline, &g, null, 0u32);
      device.queue.releaseBindGroup(&mut g);
    }
  }
}

// Group 3's bindings: the picture of the frame, its depth, the two tables, the sampler and the parameters, then (when
// the pipelines are ray-traced) the structure and the buffers its hits are read from
fn sceneGroupEntries(color: &TextureView, depth: &TextureView, diffusion: &TextureView, sheen: &TextureView, sampler: &Sampler,
    params: &Buffer, rtEntries: &List[BindGroupEntry]) List[BindGroupEntry] {
  var entries = List[BindGroupEntry].empty();
  entries.push(BindGroupEntry.texture(0u32, color));
  entries.push(BindGroupEntry.texture(1u32, depth));
  entries.push(BindGroupEntry.texture(2u32, diffusion));
  entries.push(BindGroupEntry.texture(3u32, sheen));
  entries.push(BindGroupEntry.sampler(4u32, sampler));
  entries.push(BindGroupEntry.buffer(5u32, params));
  var i = 0usize;
  while i < rtEntries.len() {
    entries.push(*rtEntries[i]);
    i = i + 1usize;
  }
  entries
}

// One full-screen pass into 'view' with no bind group (the table bakes)
fn tablePass(encoder: &mut CommandEncoder, view: TextureView, pipeline: &RenderPipeline) {
  let attachment = RenderPassColorAttachment(view: view, clearValue: Color(0., 0., 0., 1.));
  var pass = encoder.beginRenderPass(&attachment);
  pass.setPipeline(pipeline);
  pass.draw(3u32, 1u32, 0u32, 0u32);
  pass.end();
}

