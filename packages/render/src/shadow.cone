// Sun shadows: cascaded shadow maps.
//
// THE METHOD, named (the choices are listed in Design\render.md):
// - Cascaded shadow maps (Engel, "Cascaded Shadow Maps", ShaderX5, 2006;
//   Dimitrov, "Cascaded Shadow Maps", NVIDIA, 2007): the camera's view is cut
//   into 1 to 4 slices by depth; each slice gets its own orthographic view
//   from the sun, drawn depth only into one layer of a depth texture array.
// - Splits by the PRACTICAL SPLIT SCHEME (Zhang et al., "Parallel-Split
//   Shadow Maps for Large-scale Virtual Environments", 2006; NVIDIA's GPU Gems
//   3, ch. 10): the mean of the logarithmic split n (f/n)^(i/N), which gives
//   every cascade the same resolution per unit of screen, and the uniform
//   split n + (f - n) i/N, which keeps the first from being tiny. The blend
//   is 'splitLambda' (0.75 here).
// - Each cascade is fitted to a BOUNDING SPHERE of its slice of the frustum,
//   not to the slice's tightest box (Engel; the Unreal and Unity default):
//   the sphere's radius does not change as the camera turns, so a shadow's
//   edge does not swim as the view rotates. The minimal sphere about a frustum
//   slice has its centre on the view axis, found in closed form (below).
// - TEXEL SNAPPING (Engel; Valient, "Stable Rendering of Cascaded Shadow
//   Maps", ShaderX6, 2008): the window's origin is moved to a whole number of
//   texels in the sun's view, so a point moving through the world keeps
//   landing on the same lattice of the map, and an edge does not shimmer as
//   the camera moves.
// - Each cascade begins a little before the previous one ends (the overlap
//   is the blend band), so where the receiver looks up two cascades and
//   blends them, both cover the point.
// - A DEPTH-ONLY PASS per cascade (gpu's 'beginDepthPass': no colour
//   attachment, a depth view of one layer), copies of a mesh in a batch
//   drawn as one instanced draw as in the main pass. A cascade's pass skips
//   a batch none of whose copies' bounding spheres touch the cascade's
//   window. Cut-out materials draw with the alpha test, skinned meshes with
//   their bones, flutter materials with their leaves' turn (shadowcast.slang,
//   shadowcutlit.slang, shadowcutpbr.slang). See-through, custom-pipeline and
//   line draws cast nothing, and a draw item marked 'dontCastShadow' casts
//   nothing either.
// - The receiver's side, shadowing.slang: percentage-closer filtering by a
//   rotated Poisson disk of comparison-sampled taps, receiver-plane depth
//   bias, a normal offset, and cascade blending.
//
// POINT AND SPOT LIGHTS' SHADOWS are lightshadow.cone's: one perspective view
// for a spot light, six for a point light, drawn depth only by these casters
// (the immediate 4 and on selects a light's view, whose matrix is the shadow
// parameters' 'localView'), looked up through the same comparison sampler.

// The most cascades
pub const MAX_CASCADES = 4u32;

// The bytes of shadowparams.slang's ShadowParams: the sun's part, which
// 'render' writes every frame, and the whole, which ends with the point and
// spot lights' views (lightshadow.cone writes those)
const SHADOW_SUN_BYTES = 368u64;
const SHADOW_PARAMS_BYTES = 1936u64;
const SHADOW_PARAMS_FLOATS = 484usize;

// What a shadow caster draws with
const CASTER_NONE = 0u32;
const CASTER_OPAQUE = 1u32;
const CASTER_OPAQUE_SKINNED = 2u32;
const CASTER_LIT_CUT = 3u32;
const CASTER_LIT_CUT_SKINNED = 4u32;
const CASTER_PBR_CUT = 5u32;
const CASTER_PBR_CUT_SKINNED = 6u32;
const CASTER_SWAY = 7u32;
const CASTER_SWAY_CUT = 8u32;

// How the sun's shadows are made: a quality tier is a settings value
// ('high', 'medium', 'low', the last for an integrated GPU), and the cascades
// and the map's size are the cost. 'Renderer.setShadows' takes it.
pub struct ShadowSettings {
  pub enabled: bool = false;
  // How many cascades (1 to 4) and the side of each one's map, in texels
  // (the map is a square texture array of 'cascades' layers of 32-bit depth:
  // 4 x 2048 x 2048 is 64 MB)
  pub cascades: u32 = 4u32;
  pub mapSize: u32 = 2048u32;
  // How far from the camera shadows reach, in the camera's units (cut to the
  // camera's far plane); beyond it, and the last tenth before it, they fade
  pub distance: f32 = 120.;
  // The practical split scheme's blend of the logarithmic split (1) and the
  // uniform one (0)
  pub splitLambda: f32 = 0.75;
  // The share of a cascade's length, at its far end, over which it blends
  // into the next
  pub blend: f32 = 0.15;
  // The filter: taps (1 to 16) over a disk of 'pcfRadius' texels; each tap is
  // the hardware's four-texel comparison, so even 4 taps give a soft edge
  pub pcfTaps: u32 = 12u32;
  pub pcfRadius: f32 = 1.5;
  // The constant depth bias and the normal offset, in texels of the cascade
  // the point is in (so they hold at any map size)
  pub bias: f32 = 1.0;
  pub normalOffset: f32 = 1.5;
  // The casters' rasterizer slope-scaled depth bias
  pub slopeBias: f32 = 1.5;
  // How far towards the sun from a cascade's slice a caster is still drawn
  // (a tall tree outside the slice that shades it): the cascade's near plane
  // lies that far back, and casters in front of it are held at it
  pub casterDistance: f32 = 150.;
  // Snap each cascade's window to whole texels (off only to see why it is on)
  pub stabilize: bool = true;

  // Shadows off: the other fields are left as they are
  pub fn off() ShadowSettings { ShadowSettings() }

  // 4 cascades of 2048, 16 taps: for a discrete GPU
  pub fn high() ShadowSettings {
    ShadowSettings(enabled: true, cascades: 4u32, mapSize: 2048u32, pcfTaps: 16u32, pcfRadius: 1.5)
  }

  // 3 cascades of 1536, 8 taps
  pub fn medium() ShadowSettings {
    ShadowSettings(enabled: true, cascades: 3u32, mapSize: 1536u32, pcfTaps: 8u32, pcfRadius: 1.5)
  }

  // 2 cascades of 1024, 4 taps: for an integrated GPU
  pub fn low() ShadowSettings {
    ShadowSettings(enabled: true, cascades: 2u32, mapSize: 1024u32, pcfTaps: 4u32, pcfRadius: 1.25,
      distance: 60.)
  }
}

// The cascades of one frame: for each, its matrix (world coordinates to the
// sun's clip space: x and y from -1 to 1 across the map, depth 0 at the near
// plane to 1 at the far) and what the receiver and the casters need to know
// about it
pub struct CascadeSet {
  pub count: u32;
  pub matrices: Array[Mat4, 4];
  pub splitFar: Array[f32, 4];     // the view depth at which each ends
  pub splitNear: Array[f32, 4];    // and where it begins (a little before the one before ends)
  pub texelWorld: Array[f32, 4];   // the world length of one of its texels
  pub depthRange: Array[f32, 4];   // the world length of its depth, 0 to 1
  pub bandLen: Array[f32, 4];      // the length of the band at its end where it blends into the next
  pub radius: Array[f32, 4];       // half the width of its window, in world length
  pub centers: Array[Vec3, 4];     // the centre of the sphere its slice is fitted to (before snapping)
}

// The ends of 'count' cascades (1 to 4) between 'near' and 'far' by the
// practical split scheme: the cascade i (1 to count) ends at
// lambda n (f / n)^(i / count) + (1 - lambda) (n + (f - n) i / count); the
// last at 'far' exactly. The unused entries are 'far'.
pub fn cascadeSplits(near: f32, far: f32, count: u32, lambda: f32) Array[f32, 4] {
  var ends = Array[f32, 4]() <- fill far;
  var i = 1u32;
  while i <= count && i <= MAX_CASCADES {
    let t = f32.from(i) / f32.from(count);
    let logSplit = near * libc.powf(far / near, t);
    let linSplit = near + (far - near) * t;
    ends[usize.from(i - 1u32)] = lambda * logSplit + (1. - lambda) * linSplit;
    i = i + 1u32;
  }
  if count >= 1u32 && count <= MAX_CASCADES { ends[usize.from(count - 1u32)] = far; }
  ends
}

// The least sphere about the slice of a perspective frustum between the view
// depths 'a' and 'b' (a < b), the frustum's tan(half the vertical field) 'tanY'
// and its 'aspect': its centre is on the axis at the depth returned in
// 'center', its radius the return value. With k^2 = tanY^2 (1 + aspect^2)
// (the corner of the slice at depth 1, squared, less 1), a centre at depth t
// is as far from a near corner as sqrt(a^2 k^2 + (t - a)^2) and from a far
// one as sqrt(b^2 k^2 + (b - t)^2); equal when t = (a + b)(1 + k^2) / 2, but
// the centre may not pass the far plane (a long thin slice is bounded by its
// far corners, the sphere about them centred on the far plane).
pub fn sliceSphere(a: f32, b: f32, tanY: f32, aspect: f32, center: &mut f32) f32 {
  let k2 = tanY * tanY * (1. + aspect * aspect);
  var t = 0.5 * (a + b) * (1. + k2);
  if t > b { t = b; }
  *center = t;
  (b * b * k2 + (b - t) * (b - t)).sqrt()
}

fn sceilf(x: f32) f32 { libc.ceilf(x) }
fn sfloorf(x: f32) f32 { libc.floorf(x) }

// The cascades for 'camera' drawing into a target 'aspect' wide for each
// unit high, lit by a sun travelling along 'sunDirection' (unit length), as
// 's' says. The sun's view has no roll of its own: its up is the world's y
// (or x, for a sun straight down), so a cascade's window depends on the
// camera's position and the light, and the radius on the field of view and
// the splits alone.
pub fn computeCascades(camera: &Camera, aspect: f32, sunDirection: Vec3, s: &ShadowSettings) CascadeSet {
  var count = s.cascades;
  if count < 1u32 { count = 1u32; }
  if count > MAX_CASCADES { count = MAX_CASCADES; }
  var near = camera.near;
  if near < 0.01 { near = 0.01; }
  var far = s.distance;
  if far > camera.far { far = camera.far; }
  if far <= near { far = near * 2.; }
  let ends = cascadeSplits(near, far, count, s.splitLambda);
  var set = CascadeSet(count, Array[Mat4, 4]() <- fill Mat4.identity(), ends, Array[f32, 4]() <- fill 0f,
    Array[f32, 4]() <- fill 0f, Array[f32, 4]() <- fill 0f, Array[f32, 4]() <- fill 0f,
    Array[f32, 4]() <- fill 0f, Array[Vec3, 4]() <- fill Vec3(0., 0., 0.));

  // The camera's axes in the world: right, up and back (its own +z)
  let place = camera.placement();
  let eye = place.translation();
  let forward = Vec3(-place.m[8], -place.m[9], -place.m[10]).normalize();
  let size = f32.from(s.mapSize);
  // How many texels at the map's edge the filter and the normal offset can
  // reach beyond a point, which the window must leave room for
  let pad = sceilf(s.pcfRadius + s.normalOffset) + 2.;
  let towardsSun = Vec3(0., 0., 0.) - sunDirection;
  var up = Vec3(0., 1., 0.);
  if towardsSun.y > 0.99 || towardsSun.y < -0.99 { up = Vec3(1., 0., 0.); }
  // The sun's view: the sun's direction as -z, the origin of the world as
  // the point it looks at (a translation of the whole scene does not change
  // the cascades' shape, and the snapping lattice is the world's)
  let sunView = Mat4.lookAt(towardsSun, Vec3(0., 0., 0.), up);
  let tanY = tan(camera.fov * 0.5);

  var i = 0usize;
  while i < usize.from(count) {
    // The slice: from where the cascade before it begins to blend, to its end
    var a = near;
    if i > 0usize {
      let prevLen = ends[i - 1usize] - set.splitNear[i - 1usize];
      var start = ends[i - 1usize] - s.blend * prevLen;
      if start < near { start = near; }
      a = start;
    }
    let b = ends[i];
    set.splitNear[i] = a;
    // The band at its end: a share of its own length
    set.bandLen[i] = s.blend * (b - a);

    var t = 0.f;
    var r = 0.f;
    if camera.projection == Orthogonal {
      t = 0.5 * (a + b);
      let hy = camera.viewHeight;
      let hx = camera.viewHeight * aspect;
      r = (hx * hx + hy * hy + (0.5 * (b - a)) * (0.5 * (b - a))).sqrt();
    } else {
      r = sliceSphere(a, b, tanY, aspect, &mut t);
    }
    let center = eye + forward * t;
    set.centers[i] = center;
    // Leave room at the window's edge for the filter
    let radius = r * size / (size - 2. * pad);
    let texel = 2. * radius / size;

    // The centre in the sun's view, snapped to the lattice of texels
    let lc = sunView * center;
    var sx = lc.x;
    var sy = lc.y;
    if s.stabilize {
      sx = sfloorf(lc.x / texel) * texel;
      sy = sfloorf(lc.y / texel) * texel;
    }
    // Depth: along the sun's -z. The sphere's own depth extent, and
    // 'casterDistance' further towards the sun
    let d = 0. - lc.z;
    let nearD = d - radius - s.casterDistance;
    let farD = d + radius;
    let projection = Mat4.orthographic(sx - radius, sx + radius, sy - radius, sy + radius, nearD, farD);
    set.matrices[i] = projection * sunView;
    set.texelWorld[i] = texel;
    set.depthRange[i] = farD - nearD;
    set.radius[i] = radius;
    i = i + 1usize;
  }
  set
}

// shadowparams.slang's ShadowParams for 'set', as the settings 's' and the
// camera's forward direction 'forward' have it
fn shadowParamsFloats(set: &CascadeSet, s: &ShadowSettings, forward: Vec3, enabled: bool) Array[f32, 92] {
  var out = Array[f32, 92]() <- fill 0f;
  var c = 0usize;
  while c < 4usize {
    var k = 0usize;
    while k < 16usize {
      out[c * 16usize + k] = set.matrices[c].m[k];
      k = k + 1usize;
    }
    out[64usize + c] = set.splitFar[c];
    out[68usize + c] = set.texelWorld[c];
    out[72usize + c] = set.depthRange[c];
    out[76usize + c] = set.bandLen[c];
    c = c + 1usize;
  }
  out[80] = if enabled { f32.from(set.count) } else { 0. };
  out[81] = f32.from(s.mapSize);
  out[83] = s.pcfRadius;
  out[84] = s.bias;
  out[85] = s.normalOffset;
  var taps = s.pcfTaps;
  if taps < 1u32 { taps = 1u32; }
  if taps > 16u32 { taps = 16u32; }
  out[86] = f32.from(taps);
  out[88] = forward.x;
  out[89] = forward.y;
  out[90] = forward.z;
  out
}

// What draws into the shadow map: the three shader modules, the three
// pipeline layouts (the caster group, and with it the lit or the physically
// based material's group) and the pipelines, depth only
pub struct ShadowCasters {
  pub shaderCast: ShaderModule;
  pub shaderCutLit: ShaderModule;
  pub shaderCutPbr: ShaderModule;
  pub layoutOpaque: PipelineLayout;     // the caster group; the cascade as the immediate
  pub layoutLit: PipelineLayout;        // and the lit material's group
  pub layoutPbr: PipelineLayout;        // and the physically based material's
  pub opaque: RenderPipeline;
  pub opaqueSkinned: RenderPipeline;
  pub litCut: RenderPipeline;
  pub litCutSkinned: RenderPipeline;
  pub pbrCut: RenderPipeline;
  pub pbrCutSkinned: RenderPipeline;
  pub sway: RenderPipeline;
  pub swayCut: RenderPipeline;

  // The pipelines, their rasterizer adding 'slopeBias' times a triangle's
  // depth slope (D3D's and Vulkan's slope-scaled bias) to its depths
  pub fn create(device: &mut Device, casterLayout: &BindGroupLayout, materialLayout: &BindGroupLayout,
      pbrMaterialLayout: &BindGroupLayout, slopeBias: f32) ShadowCasters {
    var shaderCast = device.createShaderModule(&SHADOWCAST_SPIRV);
    var shaderCutLit = device.createShaderModule(&SHADOWCUTLIT_SPIRV);
    var shaderCutPbr = device.createShaderModule(&SHADOWCUTPBR_SPIRV);
    let opaqueGroups = [casterLayout];
    var layoutOpaque = device.createPipelineLayout(&opaqueGroups, 4u32);
    let litGroups = [casterLayout, materialLayout];
    var layoutLit = device.createPipelineLayout(&litGroups, 4u32);
    let pbrGroups = [casterLayout, pbrMaterialLayout];
    var layoutPbr = device.createPipelineLayout(&pbrGroups, 4u32);

    // The vertex streams each variant reads, each in a buffer of its own
    // (the locations are those Slang gives its inputs, in order)
    let positionAt0 = [VertexAttribute(VERTEX_FORMAT_FLOAT32X3, 0u64, 0u32)];
    let uvAt1 = [VertexAttribute(VERTEX_FORMAT_FLOAT32X2, 0u64, 1u32)];
    let jointsAt1 = [VertexAttribute(VERTEX_FORMAT_UINT8X4, 0u64, 1u32)];
    let weightsAt2 = [VertexAttribute(VERTEX_FORMAT_UNORM8X4, 0u64, 2u32)];
    let jointsAt2 = [VertexAttribute(VERTEX_FORMAT_UINT8X4, 0u64, 2u32)];
    let weightsAt3 = [VertexAttribute(VERTEX_FORMAT_UNORM8X4, 0u64, 3u32)];
    let swayAt1 = [VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 0u64, 1u32)];
    let swayAt2 = [VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 0u64, 2u32)];
    let position = VertexBufferLayout(arrayStride: 12u64, attributes: &positionAt0);
    let uv = VertexBufferLayout(arrayStride: 8u64, attributes: &uvAt1);
    let opaqueBuffers = [position];
    let opaqueSkinnedBuffers = [position, VertexBufferLayout(arrayStride: 4u64, attributes: &jointsAt1),
      VertexBufferLayout(arrayStride: 4u64, attributes: &weightsAt2)];
    let cutBuffers = [position, uv];
    let cutSkinnedBuffers = [position, uv, VertexBufferLayout(arrayStride: 4u64, attributes: &jointsAt2),
      VertexBufferLayout(arrayStride: 4u64, attributes: &weightsAt3)];
    let swayBuffers = [position, VertexBufferLayout(arrayStride: 16u64, attributes: &swayAt1)];
    let swayCutBuffers = [position, uv, VertexBufferLayout(arrayStride: 16u64, attributes: &swayAt2)];

    let opaqueDesc = RenderPipelineDescriptor(layout: &layoutOpaque, vertexModule: &shaderCast,
      vertexEntryPoint: "vertexOpaque", buffers: &opaqueBuffers, fragmentModule: &shaderCast,
      fragmentEntryPoint: "fragmentOpaque", colorFormat: TEXTURE_FORMAT_UNDEFINED, cullMode: CULL_MODE_NONE,
      depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS,
      depthBiasSlopeScale: slopeBias);
    var opaque = device.createRenderPipeline(&opaqueDesc);
    let opaqueSkinnedDesc = RenderPipelineDescriptor(layout: &layoutOpaque, vertexModule: &shaderCast,
      vertexEntryPoint: "vertexOpaqueSkinned", buffers: &opaqueSkinnedBuffers, fragmentModule: &shaderCast,
      fragmentEntryPoint: "fragmentOpaque", colorFormat: TEXTURE_FORMAT_UNDEFINED, cullMode: CULL_MODE_NONE,
      depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS,
      depthBiasSlopeScale: slopeBias);
    var opaqueSkinned = device.createRenderPipeline(&opaqueSkinnedDesc);

    let litCutDesc = RenderPipelineDescriptor(layout: &layoutLit, vertexModule: &shaderCutLit,
      vertexEntryPoint: "vertexCut", buffers: &cutBuffers, fragmentModule: &shaderCutLit,
      fragmentEntryPoint: "fragmentCut", colorFormat: TEXTURE_FORMAT_UNDEFINED, cullMode: CULL_MODE_NONE,
      depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS,
      depthBiasSlopeScale: slopeBias);
    var litCut = device.createRenderPipeline(&litCutDesc);
    let litCutSkinnedDesc = RenderPipelineDescriptor(layout: &layoutLit, vertexModule: &shaderCutLit,
      vertexEntryPoint: "vertexCutSkinned", buffers: &cutSkinnedBuffers, fragmentModule: &shaderCutLit,
      fragmentEntryPoint: "fragmentCut", colorFormat: TEXTURE_FORMAT_UNDEFINED, cullMode: CULL_MODE_NONE,
      depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS,
      depthBiasSlopeScale: slopeBias);
    var litCutSkinned = device.createRenderPipeline(&litCutSkinnedDesc);

    let pbrCutDesc = RenderPipelineDescriptor(layout: &layoutPbr, vertexModule: &shaderCutPbr,
      vertexEntryPoint: "vertexCut", buffers: &cutBuffers, fragmentModule: &shaderCutPbr,
      fragmentEntryPoint: "fragmentCut", colorFormat: TEXTURE_FORMAT_UNDEFINED, cullMode: CULL_MODE_NONE,
      depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS,
      depthBiasSlopeScale: slopeBias);
    var pbrCut = device.createRenderPipeline(&pbrCutDesc);
    let pbrCutSkinnedDesc = RenderPipelineDescriptor(layout: &layoutPbr, vertexModule: &shaderCutPbr,
      vertexEntryPoint: "vertexCutSkinned", buffers: &cutSkinnedBuffers, fragmentModule: &shaderCutPbr,
      fragmentEntryPoint: "fragmentCut", colorFormat: TEXTURE_FORMAT_UNDEFINED, cullMode: CULL_MODE_NONE,
      depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS,
      depthBiasSlopeScale: slopeBias);
    var pbrCutSkinned = device.createRenderPipeline(&pbrCutSkinnedDesc);
    let swayDesc = RenderPipelineDescriptor(layout: &layoutPbr, vertexModule: &shaderCutPbr,
      vertexEntryPoint: "vertexSway", buffers: &swayBuffers, fragmentModule: &shaderCutPbr,
      fragmentEntryPoint: "fragmentOpaque", colorFormat: TEXTURE_FORMAT_UNDEFINED, cullMode: CULL_MODE_NONE,
      depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS,
      depthBiasSlopeScale: slopeBias);
    var sway = device.createRenderPipeline(&swayDesc);
    let swayCutDesc = RenderPipelineDescriptor(layout: &layoutPbr, vertexModule: &shaderCutPbr,
      vertexEntryPoint: "vertexCutSway", buffers: &swayCutBuffers, fragmentModule: &shaderCutPbr,
      fragmentEntryPoint: "fragmentCut", colorFormat: TEXTURE_FORMAT_UNDEFINED, cullMode: CULL_MODE_NONE,
      depthFormat: TEXTURE_FORMAT_DEPTH32_FLOAT, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS,
      depthBiasSlopeScale: slopeBias);
    var swayCut = device.createRenderPipeline(&swayCutDesc);
    ShadowCasters(shaderCast, shaderCutLit, shaderCutPbr, layoutOpaque, layoutLit, layoutPbr, opaque,
      opaqueSkinned, litCut, litCutSkinned, pbrCut, pbrCutSkinned, sway, swayCut)
  }

  pub fn isValid(self: &) bool {
    opaque.isValid() && opaqueSkinned.isValid() && litCut.isValid() && litCutSkinned.isValid()
      && pbrCut.isValid() && pbrCutSkinned.isValid() && sway.isValid() && swayCut.isValid()
  }
}

// The sun's shadow state of a renderer: the settings, the parameters'
// uniform buffer (frame group binding 4), the map (a depth texture array, a
// layer a cascade; one 1 x 1 layer while shadows are off), the comparison
// sampler, the casters' group (the frame's buffers again, without the map)
// and the casters
pub struct ShadowState {
  pub settings: ShadowSettings;
  pub params: Buffer;
  pub sampler: Sampler;
  pub map: Texture;
  pub casterLayout: BindGroupLayout;
  pub casterGroup: BindGroup;
  pub casters: ShadowCasters;
  pub cascades: CascadeSet;         // the last frame's
  pub drawCalls: u32;               // how many draws the last frame's shadow passes made
  pub triangles: u64;               // and how many triangles they drew
  pub passes: u32;                  // and how many passes (one a cascade)

  // The state with shadows off: the stand-in map, the layouts and pipelines
  // (made once; 'frameUniforms', 'instances', 'bones' and 'boneBases' are the
  // renderer's frame group's)
  pub fn create(device: &mut Device, materialLayout: &BindGroupLayout, pbrMaterialLayout: &BindGroupLayout,
      frameUniforms: &Buffer, instances: &Buffer, bones: &Buffer, boneBases: &Buffer) ShadowState {
    let settings = ShadowSettings();
    let casterEntries = [BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX),
      BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_VERTEX,
        bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_VERTEX,
        bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_VERTEX,
        bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_VERTEX)];
    var casterLayout = device.createBindGroupLayout(&casterEntries);
    var params = device.createBuffer(SHADOW_PARAMS_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    let zeros = Array[f32, 484]() <- fill 0f;
    device.queue.writeBuffer(&params, 0u64, &zeros as *u8, SHADOW_PARAMS_BYTES);
    let samplerDesc = SamplerDescriptor(magFilter: FILTER_MODE_LINEAR, minFilter: FILTER_MODE_LINEAR,
      addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE, compare: COMPARE_FUNCTION_LESS_EQUAL);
    var sampler = device.createSampler(&samplerDesc);
    let mapDesc = TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_DEPTH32_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING, 1u32, 1u32);
    var map = device.createTexture(&mapDesc);
    let groupEntries = [BindGroupEntry.buffer(0u32, frameUniforms), BindGroupEntry.buffer(1u32, instances),
      BindGroupEntry.buffer(2u32, bones), BindGroupEntry.buffer(3u32, boneBases), BindGroupEntry.buffer(4u32, &params)];
    var casterGroup = device.createBindGroup(&casterLayout, &groupEntries);
    var casters = ShadowCasters.create(device, &casterLayout, materialLayout, pbrMaterialLayout, settings.slopeBias);
    let camera = Camera.make();
    let cascades = computeCascades(&camera, 1., Vec3(0., -1., 0.), &settings);
    ShadowState(settings, params, sampler, map, casterLayout, casterGroup, casters, cascades, 0u32, 0u64, 0u32)
  }

  pub fn isValid(self: &) bool {
    params.isValid() && sampler.isValid() && map.isValid() && casterGroup.isValid() && casters.isValid()
  }

  // A view of the whole map as an array, what the frame group binds
  pub fn arrayView(self: &) TextureView {
    let desc = TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_2D_ARRAY);
    map.createViewWith(&desc)
  }

  // The casters' group made again, after one of the frame's buffers was
  // replaced
  pub fn remakeCasterGroup(self: &mut, device: &mut Device, frameUniforms: &Buffer, instances: &Buffer, bones: &Buffer,
      boneBases: &Buffer) {
    let entries = [BindGroupEntry.buffer(0u32, frameUniforms), BindGroupEntry.buffer(1u32, instances),
      BindGroupEntry.buffer(2u32, bones), BindGroupEntry.buffer(3u32, boneBases), BindGroupEntry.buffer(4u32, &params)];
    casterGroup = device.createBindGroup(&casterLayout, &entries);
  }

  // The map made again: 'layers' layers of 'size' square, or, for 0 layers,
  // the 1 x 1 stand-in
  pub fn remakeMap(self: &mut, device: &mut Device, size: u32, layers: u32) {
    var side = size;
    var count = layers;
    if count == 0u32 {
      side = 1u32;
      count = 1u32;
    }
    let desc = TextureDescriptor(side, side, TEXTURE_FORMAT_DEPTH32_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING, 1u32, count);
    // The old map's first layout change may still be in the commands the
    // frame has recorded and not submitted, and a texture dropped before
    // that is submitted spoils them (gpu.md, "Lifetimes"): submit them
    // first, with nothing of ours in them
    var flush = device.createCommandEncoder();
    device.queue.submit(flush.finish());
    map = device.createTexture(&desc);
  }
}

// The shadow settings kept within what the shaders and the map support
fn clampShadowSettings(s: &ShadowSettings) ShadowSettings {
  var c = *s;
  if c.cascades < 1u32 { c.cascades = 1u32; }
  if c.cascades > MAX_CASCADES { c.cascades = MAX_CASCADES; }
  if c.mapSize < 64u32 { c.mapSize = 64u32; }
  if c.mapSize > 8192u32 { c.mapSize = 8192u32; }
  // An even size, so that a cascade's window sits on the lattice of texels
  c.mapSize = c.mapSize & 0xFFFFFFFEu32;
  if c.pcfTaps < 1u32 { c.pcfTaps = 1u32; }
  if c.pcfTaps > 16u32 { c.pcfTaps = 16u32; }
  if c.splitLambda < 0. { c.splitLambda = 0.; }
  if c.splitLambda > 1. { c.splitLambda = 1.; }
  if c.blend < 0.02 { c.blend = 0.02; }
  if c.blend > 0.5 { c.blend = 0.5; }
  if c.pcfRadius < 0. { c.pcfRadius = 0.; }
  c
}

// The caster pipeline a draw of 'item' (mesh 'm') is drawn with in a
// shadow pass, or CASTER_NONE if it casts nothing
fn casterKindOf(r: &Renderer, item: &DrawItem, m: &GpuMesh) u32 {
  if !item.castsShadow || !r.materials.alive(item.material.slot) { return CASTER_NONE; }
  let ms = &r.materials[item.material.slot];
  let skinned = m.isSkinned();
  if ms.kind == MATERIAL_CUSTOM { return CASTER_NONE; }
  if ms.kind == MATERIAL_PBR {
    if ms.pbr.alphaMode == ALPHA_BLEND { return CASTER_NONE; }
    let cut = ms.pbr.alphaMode == ALPHA_MASK;
    // A flutter material on a mesh that carries its leaves' data
    if !skinned && ms.pbr.flutter > 0. && m.sway.isValid() {
      return if cut { CASTER_SWAY_CUT } else { CASTER_SWAY };
    }
    if cut { return if skinned { CASTER_PBR_CUT_SKINNED } else { CASTER_PBR_CUT }; }
    return if skinned { CASTER_OPAQUE_SKINNED } else { CASTER_OPAQUE };
  }
  if ms.params.alphaMode == ALPHA_BLEND { return CASTER_NONE; }
  if ms.params.alphaMode == ALPHA_MASK { return if skinned { CASTER_LIT_CUT_SKINNED } else { CASTER_LIT_CUT }; }
  if skinned { CASTER_OPAQUE_SKINNED } else { CASTER_OPAQUE }
}

// Whether any copy in the batch of keys 'first' to 'first + count' has a
// bounding sphere that touches cascade 'c''s window (the sphere's distance
// beyond the window's far plane, or to its side, rules it out; in front of
// the near plane it still casts)
fn batchTouchesCascade(r: &Renderer, list: &DrawList, batch: &DrawBatch, c: usize) bool {
  let matrix = r.shadow.cascades.matrices[c];
  let radius = r.shadow.cascades.radius[c];
  let range = r.shadow.cascades.depthRange[c];
  var j = 0u32;
  while j < batch.count {
    let item = list.items[usize.from(r.keys[usize.from(batch.first + j)].item)];
    let m = r.meshes[item.mesh.slot].current();
    let center = item.model * m.center;
    // The most the copy's matrix stretches the sphere (the length of its
    // longest column)
    let sx = item.model.transformVector(Vec3(1., 0., 0.)).length();
    let sy = item.model.transformVector(Vec3(0., 1., 0.)).length();
    let sz = item.model.transformVector(Vec3(0., 0., 1.)).length();
    var s = sx;
    if sy > s { s = sy; }
    if sz > s { s = sz; }
    let rw = m.radius * s;
    let p = matrix * center;
    let side = 1. + rw / radius;
    if p.x >= -side && p.x <= side && p.y >= -side && p.y <= side && p.z - rw / range <= 1. { return true; }
    j = j + 1u32;
  }
  false
}

// The batches that shadow pass number 'index' draws (the cascades in order,
// then the local lights' faces) as a range of the renderer's batches: the
// pass's own if the scene gathered casters for it (visibility.cone), else the
// main view's
fn passBatches(r: &Renderer, index: usize) SetRange {
  let n = r.vis.sets.len();
  if n > 1usize + index { return *r.vis.sets[1usize + index]; }
  if n > 0usize { return *r.vis.sets[0usize]; }
  SetRange(0usize, r.batches.len())
}

// Record the shadow passes of 'list': one depth-only pass a cascade of
// the last 'computeCascades', into the map, the batches the main pass
// gathered drawn as it draws them (their instances are in the instance
// buffer already). Cut-out, skinned and flutter casters have their own
// pipelines.
fn recordShadowPasses(r: &mut Renderer, device: &mut Device, encoder: &mut CommandEncoder, list: &DrawList) {
  r.shadow.drawCalls = 0u32;
  r.shadow.triangles = 0u64;
  r.shadow.passes = 0u32;
  let count = r.shadow.cascades.count;
  var c = 0u32;
  while c < count {
    let viewDesc = TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_2D, baseArrayLayer: c,
      arrayLayerCount: 1u32);
    let attachment = RenderPassDepthStencilAttachment(view: r.shadow.map.createViewWith(&viewDesc),
      depthLoadOp: LOAD_OP_CLEAR, depthStoreOp: STORE_OP_STORE);
    var pass = encoder.beginDepthPass(&attachment);
    let cascade = c;
    var bound = CASTER_NONE;
    var boundMaterial = Ref[MaterialSlot].none();
    let range = passBatches(r, usize.from(c));
    var b = range.first;
    while b < range.end {
      let batch = *r.batches[b];
      b = b + 1usize;
      if batch.layer != LAYER_OPAQUE || batch.noShadow { continue; }
      let first = *r.keys[usize.from(batch.first)];
      let item = &list.items[usize.from(first.item)];
      let m = r.meshes[item.mesh.slot].current();
      let kind = casterKindOf(r, item, m);
      if kind == CASTER_NONE { continue; }
      if !batchTouchesCascade(r, list, &batch, usize.from(cascade)) { continue; }
      if bound != kind {
        if kind == CASTER_OPAQUE { pass.setPipeline(&r.shadow.casters.opaque); }
        else if kind == CASTER_OPAQUE_SKINNED { pass.setPipeline(&r.shadow.casters.opaqueSkinned); }
        else if kind == CASTER_LIT_CUT { pass.setPipeline(&r.shadow.casters.litCut); }
        else if kind == CASTER_LIT_CUT_SKINNED { pass.setPipeline(&r.shadow.casters.litCutSkinned); }
        else if kind == CASTER_PBR_CUT { pass.setPipeline(&r.shadow.casters.pbrCut); }
        else if kind == CASTER_PBR_CUT_SKINNED { pass.setPipeline(&r.shadow.casters.pbrCutSkinned); }
        else if kind == CASTER_SWAY { pass.setPipeline(&r.shadow.casters.sway); }
        else { pass.setPipeline(&r.shadow.casters.swayCut); }
        pass.setBindGroup(0u32, &r.shadow.casterGroup);
        pass.setImmediates(0u32, &cascade as *u8, 4u32);
        bound = kind;
        boundMaterial = Ref[MaterialSlot].none();
      }
      // A cut-out or flutter caster reads its material (its alpha, its flutter)
      if kind != CASTER_OPAQUE && kind != CASTER_OPAQUE_SKINNED && !(boundMaterial == item.material.slot) {
        pass.setBindGroup(1u32, &r.materials[item.material.slot].group);
        boundMaterial = item.material.slot;
      }
      pass.setVertexBuffer(0u32, &m.positions, 0u64);
      if kind == CASTER_OPAQUE_SKINNED {
        pass.setVertexBuffer(1u32, &m.joints, 0u64);
        pass.setVertexBuffer(2u32, &m.weights, 0u64);
      } else if kind == CASTER_LIT_CUT || kind == CASTER_PBR_CUT {
        pass.setVertexBuffer(1u32, &m.uvs, 0u64);
      } else if kind == CASTER_LIT_CUT_SKINNED || kind == CASTER_PBR_CUT_SKINNED {
        pass.setVertexBuffer(1u32, &m.uvs, 0u64);
        pass.setVertexBuffer(2u32, &m.joints, 0u64);
        pass.setVertexBuffer(3u32, &m.weights, 0u64);
      } else if kind == CASTER_SWAY {
        pass.setVertexBuffer(1u32, &m.sway, 0u64);
      } else if kind == CASTER_SWAY_CUT {
        pass.setVertexBuffer(1u32, &m.uvs, 0u64);
        pass.setVertexBuffer(2u32, &m.sway, 0u64);
      }
      pass.setIndexBuffer(&m.indices, INDEX_FORMAT_UINT32, 0u64);
      var g = 0usize;
      while g < m.groups.len() {
        let group = m.groups[g];
        pass.drawIndexed(group.count, batch.count, group.start, 0i32, batch.firstInstance);
        r.shadow.triangles = r.shadow.triangles + u64.from(group.count / 3u32) * u64.from(batch.count);
        r.shadow.drawCalls = r.shadow.drawCalls + 1u32;
        g = g + 1usize;
      }
    }
    pass.end();
    r.shadow.passes = r.shadow.passes + 1u32;
    c = c + 1u32;
  }
}

