// Depth of field: a bokeh-style gather by each pixel's circle of confusion, from
// a camera with a focus distance and an aperture (dof.slang has the methods:
// the thin lens, a Vogel-disc gather at half resolution with a
// scatter-as-gather test). Off by default. fx.cone drives it; it runs on the
// frame after the decals, the occlusion and the fog, and its picture is what
// temporal anti-aliasing and the tone map then read.

// How depth of field is done: the camera, and the quality
pub struct DofSettings {
  pub enabled bool = false;
  // The distance in focus (metres), and the lens: its f-number (the lower, the
  // shallower the field: 1.4 to 22) and its focal length (metres)
  pub focusDistance f32 = 10.;
  pub aperture f32 = 2.8;
  pub focalLength f32 = 0.05;
  // The sensor's height (metres): 0.024 is full frame
  pub sensorHeight f32 = 0.024;
  // The largest circle of confusion's diameter, in pixels at 1080 lines (scaled
  // for other heights): bounds the gather
  pub maxCoc f32 = 14.;
  // 1 as the lens says; more exaggerates it, 0 turns it off
  pub strength f32 = 1.;
  // Taps of the gather (a Vogel disc): more is smoother
  pub taps u32 = 32u32;

  // 48 taps: for a discrete GPU
  pub fn high() DofSettings { new DofSettings(enabled: true, taps: 48u32) }
  // 32 taps
  pub fn medium() DofSettings { new DofSettings(enabled: true, taps: 32u32) }
  // 16 taps and a smaller reach: for an integrated GPU
  pub fn low() DofSettings { new DofSettings(enabled: true, taps: 16u32, maxCoc: 10.) }
}

// What the passes' immediates hold (dof.slang's DofImmediates)
struct DofImmediates {
  focusDistance f32;
  apertureDiameter f32;
  focalLength f32;
  cocScale f32;
  maxCoc f32;
  strength f32;
  taps u32;
  noise f32;
}

pub struct DofPass {
  pub shader ShaderModule;
  pub layout BindGroupLayout;
  pub pipelineLayout PipelineLayout;
  pub preparePipeline RenderPipeline;
  pub gatherPipeline RenderPipeline;
  pub compositePipeline RenderPipeline;
  pub sampler Sampler;
  pub prepared Texture;            // half resolution: the frame, with each pixel's circle of confusion
  pub blurred Texture;             // half resolution: gathered
  pub output Texture;              // full resolution: the composite
  pub groupPrepare BindGroup;
  pub groupGather BindGroup;
  pub groupComposite BindGroup;

  pub fn create(device &mut Device, frameBuffer &Buffer, scene &TextureView, depth &TextureView) DofPass {
    var shader = device.createShaderModule(&DOF_SPIRV);
    let entries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH),
      new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE)];
    var layout = device.createBindGroupLayout(&entries);
    let layouts = [&layout];
    var pipelineLayout = device.createPipelineLayout(&layouts, 32u32);
    var preparePipeline = fxPipeline(device, &pipelineLayout, &shader, "prepareMain", TEXTURE_FORMAT_RGBA16_FLOAT, false);
    var gatherPipeline = fxPipeline(device, &pipelineLayout, &shader, "gatherMain", TEXTURE_FORMAT_RGBA16_FLOAT, false);
    var compositePipeline = fxPipeline(device, &pipelineLayout, &shader, "compositeMain", TEXTURE_FORMAT_RGBA16_FLOAT, false);
    let samplerDesc = new SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    var sampler = device.createSampler(&samplerDesc);
    let tiny = new TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_RGBA16_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    var prepared = device.createTexture(&tiny);
    var blurred = device.createTexture(&tiny);
    var output = device.createTexture(&tiny);
    let pv = prepared.createView();
    let bv = blurred.createView();
    var groupPrepare = dofGroup(device, &layout, frameBuffer, &sampler, scene, depth, &bv, &bv);
    var groupGather = dofGroup(device, &layout, frameBuffer, &sampler, scene, depth, &pv, &pv);
    var groupComposite = dofGroup(device, &layout, frameBuffer, &sampler, scene, depth, &bv, &bv);
    new DofPass(shader, layout, pipelineLayout, preparePipeline, gatherPipeline, compositePipeline, sampler, prepared,
      blurred, output, groupPrepare, groupGather, groupComposite)
  }

  pub fn isValid(self &) bool {
    preparePipeline.isValid() and gatherPipeline.isValid() and compositePipeline.isValid() and output.isValid()
      and groupPrepare.isValid()
  }

  // The textures for a frame of 'width' by 'height' (tiny when not 'enabled'),
  // reading the frame 'scene' and the depth
  pub fn remake(self &mut, device &mut Device, enabled bool, width u32, height u32, frameBuffer &Buffer,
      scene &TextureView, depth &TextureView) {
    let w = if enabled { width } else { 1u32 };
    let h = if enabled { height } else { 1u32 };
    let hw = if enabled { (width + 1u32) / 2u32 } else { 1u32 };
    let hh = if enabled { (height + 1u32) / 2u32 } else { 1u32 };
    let half = new TextureDescriptor(hw, hh, TEXTURE_FORMAT_RGBA16_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    let full = new TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA16_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    prepared = device.createTexture(&half);
    blurred = device.createTexture(&half);
    output = device.createTexture(&full);
    let pv = prepared.createView();
    let bv = blurred.createView();
    groupPrepare = dofGroup(device, &layout, frameBuffer, &sampler, scene, depth, &bv, &bv);
    groupGather = dofGroup(device, &layout, frameBuffer, &sampler, scene, depth, &pv, &pv);
    groupComposite = dofGroup(device, &layout, frameBuffer, &sampler, scene, depth, &bv, &bv);
  }

  // Blur the frame the groups read into 'output'
  pub fn record(self &mut, encoder &mut CommandEncoder, s &DofSettings, height u32, frame u32, moving bool) {
    let scale = f32.from(height) / 1080.;
    let noise = if moving { (f32.from(frame % 8u32) + 0.5) / 8. } else { 0. };
    let data = new DofImmediates(s.focusDistance, s.focalLength / s.aperture, s.focalLength,
      f32.from(height) / s.sensorHeight, s.maxCoc * scale, s.strength, s.taps, noise);
    fxPass(encoder, prepared.createView(), false, &preparePipeline, &groupPrepare, &data as *u8, 32u32);
    fxPass(encoder, blurred.createView(), false, &gatherPipeline, &groupGather, &data as *u8, 32u32);
    fxPass(encoder, output.createView(), false, &compositePipeline, &groupComposite, &data as *u8, 32u32);
  }
}

fn dofGroup(device &mut Device, layout &BindGroupLayout, frameBuffer &Buffer, sampler &Sampler, scene &TextureView,
    depth &TextureView, a &TextureView, b &TextureView) BindGroup {
  let entries = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.sampler(1u32, sampler),
    BindGroupEntry.texture(2u32, scene), BindGroupEntry.texture(3u32, depth), BindGroupEntry.texture(4u32, a),
    BindGroupEntry.texture(5u32, b)];
  device.createBindGroup(layout, &entries)
}

