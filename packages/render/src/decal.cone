// Decals: box-projected, deferred-style decals on opaque surfaces (decal.slang
// has the method). The program names the textures once ('addDecalMaterial':
// an albedo with alpha, optionally a tangent-space normal map and a
// roughness map, all added to the renderer as usual) and each frame lists the
// decals ('ImageFx.decals'): a material, a box (the matrix that places a
// unit cube of 1 on each side: scale it to the decal's size, put its up, the
// axis it projects along, away from the surface), a fade and a few
// settings. They are drawn after the scene and before the ambient occlusion
// and the fog, sorted by their 'order' (lowest first, so a higher one lies on
// top of it) and then back to front.
//
//   imm moss = fx.addDecalMaterial(&mut device, &renderer, mossAlbedo, mossNormal, TextureHandle.none());
//   ...
//   mut d = Decal.at(moss, Mat4.fromTrs(position, Quat.identity(), new Vec3(1.5, 0.6, 1.5)));
//   d.fade = 0.8;
//   fx.decals.add(d);
//
// The decal's box projects along its local -y: its texture lies on the box's
// x and z (u along x, v along z), and a surface whose normal is within
// 'maxAngle' of the box's up takes it.

// A decal's textures: the renderer's handles, and the group that binds them
pub struct DecalMaterial {
  pub albedo TextureHandle;
  pub normal TextureHandle;        // a tangent-space normal map (addNormalTexture), or none
  pub roughness TextureHandle;     // its green channel (addLinearTexture), or none
  pub hasNormal bool;
  pub hasRoughness bool;
  pub group BindGroup;
}

// One decal in a frame
pub struct Decal {
  pub material u32;                // 'ImageFx.addDecalMaterial''s answer
  pub model Mat4;                  // places the unit cube: its size, its place and which way is up (+y)
  pub tint Color = new Color(1., 1., 1., 1.);   // multiplies the albedo and its alpha
  pub fade f32 = 1.;               // 0 to 1: how much of it shows (to fade a footprint out)
  pub normalStrength f32 = 1.;     // how much its normal map bends the surface's normal (0 to 1)
  // Used when it has no roughness map: 0.9, the roughness of the ground,
  // moss and dirt decals are meant for (a smoother one shows the sun's sheen
  // at a grazing angle, as wet ground does)
  pub roughness f32 = 0.9;
  // A surface takes it when the angle between its normal and the decal's up
  // is under 'maxAngle' (radians; 1.2 is 69 degrees), fading over the next 0.1 of the cosine
  pub maxAngle f32 = 1.2;
  // The share of the box's depth faded out at each face (so its depth, the
  // thickness the surface may lie in, has soft limits)
  pub depthFade f32 = 0.3;
  // Faded out by distance from the camera: full to 'fadeStart', gone at 'fadeEnd'
  pub fadeStart f32 = 100.;
  pub fadeEnd f32 = 120.;
  // Drawn in order, lowest first (a footprint over moss over a stain)
  pub order i32 = 0;

  // A decal of 'material' placed by 'model', the rest as they default
  pub fn at(material u32, model Mat4) Decal { new Decal(material, model); }
}

pub struct DecalList {
  pub decals List[Decal];

  pub fn empty() DecalList { new DecalList(List[Decal].empty()); }
  pub fn clear(self &mut) { decals.clear(); }
  pub fn len(self &) usize { decals.len(); }
  pub fn add(self &mut, d Decal) { decals.push(d); }
}

// What the pass's immediates hold (decal.slang's DecalImmediates): 112 bytes
struct DecalImmediates {
  inverseModel Array[f32, 16];
  tint Array[f32, 4];
  a Array[f32, 4];
  b Array[f32, 4];
}

pub struct DecalPass {
  pub shader ShaderModule;
  pub materialLayout BindGroupLayout;      // group 1
  pub passLayout BindGroupLayout;          // group 3
  pub pipelineLayout PipelineLayout;
  pub pipeline RenderPipeline;
  pub sampler Sampler;
  pub passGroup BindGroup;                 // the frame uniform and the scene's depth
  pub materials List[DecalMaterial];
  pub order List[u32];                     // the decals of a frame, sorted
  pub drawn u32;                           // how many the last frame drew

  pub fn create(device &mut Device, frameLayout &BindGroupLayout, environmentLayout &BindGroupLayout,
      frameBuffer &Buffer, depth &TextureView) DecalPass {
    mut shader = device.createShaderModule(&DECAL_SPIRV);
    imm materialEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    mut materialLayout = device.createBindGroupLayout(&materialEntries);
    imm passEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH)];
    mut passLayout = device.createBindGroupLayout(&passEntries);
    imm groups = [frameLayout, &materialLayout, environmentLayout, &passLayout];
    mut pipelineLayout = device.createPipelineLayout(&groups, 112u32);
    imm attributes = [new VertexAttribute(VERTEX_FORMAT_FLOAT32, 0u64, 0u32)];
    imm buffers = [new VertexBufferLayout(arrayStride: 4u64, attributes: &attributes)];
    imm desc = new RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader, buffers: &buffers[..<0],
      fragmentModule: &shader, colorFormat: TEXTURE_FORMAT_RGBA16_FLOAT, cullMode: CULL_MODE_FRONT,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut pipeline = device.createRenderPipeline(&desc);
    imm samplerDesc = new SamplerDescriptor(mipmapFilter: FILTER_MODE_LINEAR, maxAnisotropy: 8u32,
      addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    mut sampler = device.createSampler(&samplerDesc);
    imm passEntriesGroup = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.texture(1u32, depth)];
    mut passGroup = device.createBindGroup(&passLayout, &passEntriesGroup);
    new DecalPass(shader, materialLayout, passLayout, pipelineLayout, pipeline, sampler, passGroup,
      List[DecalMaterial].empty(), List[u32].empty(), 0u32);
  }

  pub fn isValid(self &) bool { pipeline.isValid() and passGroup.isValid() and sampler.isValid(); }

  // The group over the scene's depth made again (it was replaced)
  pub fn remake(self &mut, device &mut Device, frameBuffer &Buffer, depth &TextureView) {
    imm passEntriesGroup = [BindGroupEntry.buffer(0u32, frameBuffer), BindGroupEntry.texture(1u32, depth)];
    passGroup = device.createBindGroup(&passLayout, &passEntriesGroup);
  }

  // A decal material of these textures, its number. The renderer has them (its
  // 'addTexture', 'addNormalTexture', 'addLinearTexture'); a map that is
  // 'TextureHandle.none()' is left out.
  pub fn addMaterial(self &mut, device &mut Device, r &Renderer, albedo TextureHandle, normal TextureHandle,
      roughness TextureHandle) u32 {
    imm a = if r.textures.alive(albedo.slot) { albedo; } else { r.white; };
    imm hasNormal = r.textures.alive(normal.slot);
    imm hasRoughness = r.textures.alive(roughness.slot);
    imm n = if hasNormal { normal; } else { r.white; };
    imm rough = if hasRoughness { roughness; } else { r.white; };
    imm av = r.textures[a.slot].texture.createView();
    imm nv = r.textures[n.slot].texture.createView();
    imm rv = r.textures[rough.slot].texture.createView();
    imm entries = [BindGroupEntry.texture(0u32, &av), BindGroupEntry.texture(1u32, &nv), BindGroupEntry.texture(2u32, &rv),
      BindGroupEntry.sampler(3u32, &sampler)];
    mut group = device.createBindGroup(&materialLayout, &entries);
    materials.push(new DecalMaterial(a, n, rough, hasNormal, hasRoughness, group));
    u32.from(materials.len() - 1usize);
  }

  // Draw the decals of 'list' over 'hdr' (the frame, after the scene): sorted
  // by order, then back to front from the camera at 'eye'
  pub fn record(self &mut, encoder &mut CommandEncoder, r &Renderer, hdr &Texture, list &DecalList, eye Vec3) {
    drawn = 0u32;
    if list.decals.len() == 0usize { return; }
    order.clear();
    mut i = 0usize;
    while i < list.decals.len() {
      imm d = list.decals[i];
      if usize.from(d.material) < materials.len() and d.fade > 0. {
        // Insertion sort by (order, distance far to near)
        imm dist = d.model.translation().distance(eye);
        mut at = order.len();
        while at > 0usize {
          imm other = list.decals[usize.from(*order[at - 1usize])];
          imm otherDist = other.model.translation().distance(eye);
          if other.order < d.order or (other.order == d.order and otherDist >= dist) { break; }
          at = at - 1usize;
        }
        order.push(0u32);
        mut k = order.len() - 1usize;
        while k > at {
          order.set(k, *order[k - 1usize]);
          k = k - 1usize;
        }
        order.set(at, u32.from(i));
      }
      i = i + 1usize;
    }
    if order.len() == 0usize { return; }
    imm attachment = new RenderPassColorAttachment(view: hdr.createView(), loadOp: LOAD_OP_LOAD, clearValue: new Color(0., 0., 0., 0.));
    mut pass = encoder.beginRenderPass(&attachment);
    pass.setPipeline(&pipeline);
    pass.setBindGroup(0u32, &r.frameGroup);
    pass.setBindGroup(2u32, &r.environment.group);
    pass.setBindGroup(3u32, &passGroup);
    mut bound = 0xFFFFFFFFu32;
    mut j = 0usize;
    while j < order.len() {
      imm d = list.decals[usize.from(*order[j])];
      j = j + 1usize;
      imm m = materials[usize.from(d.material)];
      if bound != d.material {
        pass.setBindGroup(1u32, &m.group);
        bound = d.material;
      }
      imm inverse = d.model.inverse();
      mut flags = 0u32;
      if m.hasNormal { flags = flags | 1u32; }
      if m.hasRoughness { flags = flags | 2u32; }
      mut data = new DecalImmediates(new Array[f32, 16] <- fill 0f, [d.tint.red, d.tint.green, d.tint.blue, d.tint.alpha],
        [d.fade, d.normalStrength, d.roughness, cosOf(d.maxAngle)],
        [d.depthFade, d.fadeStart, d.fadeEnd, f32.from(flags)]);
      mut k = 0usize;
      while k < 16usize {
        data.inverseModel[k] = inverse.m[k];
        k = k + 1usize;
      }
      pass.setImmediates(0u32, &data as *u8, 112u32);
      pass.draw(36u32, 1u32, 0u32, 0u32);
      drawn = drawn + 1u32;
    }
    pass.end();
  }
}

fn cosOf(x f32) f32 { libc.cosf(x); }

