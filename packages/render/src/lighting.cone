// Physically based lighting: the sky, the physically based material, and
// the environment the renderer makes from the sky to light it by, with the
// SPIR-V of their shaders.
//
// THE SKY (sky.slang) is a simple analytic dusk, a function of direction:
// a zenith colour fading into a horizon band, a glow round the sun lying
// along the horizon, the ground below, and the sun's disc. It stands in for
// a physical atmosphere (Hillaire's) until one is built. The renderer draws
// it behind the scene, and makes an environment from it.
//
// THE ENVIRONMENT is image-based lighting prefiltered from the sky (Karis's
// split sum), made by full-screen passes, one a face and level, whenever the
// sky changes (ibl.slang):
// - the sky, without its sun (the directional light is the sun), drawn into
//   a cube of ENVIRONMENT_SIZE texels a side, and filtered down its levels;
// - a specular cube of SPECULAR_SIZE, SPECULAR_LEVELS levels, level i
//   prefiltered for roughness i / (SPECULAR_LEVELS - 1) by importance
//   sampling GGX;
// - a diffuse cube of IRRADIANCE_SIZE, the sky's cosine-weighted mean
//   radiance about each direction (irradiance over pi);
// - the split sum's table of scale and bias over (n.v, roughness), made
//   once.
// A cube of small textures would do for the diffuse term; spherical
// harmonics would need a reduction, which wants compute.
//
// THE PHYSICALLY BASED MATERIAL (pbr.slang), for surfaces Blinn-Phong cannot
// make look wet: a base (glTF's metallic-roughness: GGX specular, Smith's
// visibility, Schlick's Fresnel, Lambert diffuse, the energy of multiple
// scattering given back), a clear coat over it (a second, smoother lobe, as
// Filament's and OpenPBR's), and over the coat a thin film (Belcour and
// Barla's iridescence) whose thickness is domain-warped noise of the
// model's coordinates, drifting with time: oil on black chitin.

// The environment's sizes
const ENVIRONMENT_SIZE = 256u32;           // the sky's cube (ibl.slang's ENVIRONMENT_SIZE)
const ENVIRONMENT_LEVELS = 9u32;           // down to 1 x 1
const SPECULAR_SIZE = 128u32;
const SPECULAR_LEVELS = 6u32;              // pbr.slang's SPECULAR_LEVELS
const IRRADIANCE_SIZE = 32u32;
const TABLE_SIZE = 128u32;
// Samples a texel: the specular levels', the diffuse cube's, the table's
const PREFILTER_SAMPLES = 64u32;
const IRRADIANCE_SAMPLES = 128u32;
const TABLE_SAMPLES = 256u32;
// The level of the sky's cube the diffuse cube reads (8 x 8 a face)
const IRRADIANCE_SOURCE_LEVEL f32 = 5.;

// The bytes of the sky's uniforms (sky.slang's SkyParams) and a physically
// based material's (pbr.slang's PbrParams)
const SKY_BYTES = 96u64;
const PBR_BYTES = 64u64;

// A dusk sky, in linear HDR radiance (an exposure of 1 shows it as it is)
pub struct Sky {
  pub sunDirection Vec3;       // towards the sun, unit length
  pub sunRadius f32;           // the disc's angular radius, in radians
  pub sunColor Color;          // the disc's radiance
  pub zenith Color;            // straight up
  pub horizon Color;           // along the horizon
  pub horizonSharpness f32;    // how tightly the horizon's band hugs it (an exponent)
  pub glow Color;              // round the sun, strongest near the horizon
  pub glowSharpness f32;       // how tightly round the sun (an exponent)
  pub ground Color;            // below the horizon
  pub groundFade f32;          // how fast the horizon's haze gives way to the ground

  // A dusk: the sun 'elevation' radians above the horizon, 'azimuth' radians
  // round from +z towards +x; a deep blue-violet zenith, a violet-pink
  // band along the horizon, an orange glow round the sun, dark ground
  pub fn dusk(elevation f32, azimuth f32) Sky {
    imm c = cos(elevation);
    imm sun = Vec3[c * sin(azimuth), sin(elevation), c * cos(azimuth)];
    Sky[sun.normalize(), radians(0.6), Color[60., 26., 9., 1.], Color[0.018, 0.026, 0.075, 1.],
      Color[0.16, 0.10, 0.17, 1.], 7., Color[1.10, 0.42, 0.12, 1.], 36., Color[0.006, 0.006, 0.008, 1.], 10.];
  }

  // The directional light the sun gives, 'color' its irradiance, and
  // 'ambient' for the Blinn-Phong material (the physically based one is lit
  // by the environment instead)
  pub fn sunLight(self &, color Color, ambient Color) Light {
    Light.directional(Vec3[0., 0., 0.] - sunDirection, color, ambient);
  }
}

// The sky's parameters as sky.slang's SkyParams has them
fn skyParams(sky &Sky) [24; f32] {
  [sky.sunDirection.x, sky.sunDirection.y, sky.sunDirection.z, cos(sky.sunRadius),
    sky.sunColor.red, sky.sunColor.green, sky.sunColor.blue, 1.,
    sky.zenith.red, sky.zenith.green, sky.zenith.blue, 1.,
    sky.horizon.red, sky.horizon.green, sky.horizon.blue, sky.horizonSharpness,
    sky.glow.red, sky.glow.green, sky.glow.blue, sky.glowSharpness,
    sky.ground.red, sky.ground.green, sky.ground.blue, sky.groundFade];
}

// A physically based material (pbr.slang)
pub struct PbrMaterial {
  pub baseColor Color;         // linear
  pub metallic f32;            // 0 a dielectric, 1 a metal
  pub roughness f32;           // perceptual, 0 to 1
  pub clearcoat f32;           // the coat's strength, 0 (none) to 1
  pub clearcoatRoughness f32;
  pub film Bool;               // a thin film over the coat
  pub filmMin f32;             // its thickness, from filmMin to filmMax nanometres
  pub filmMax f32;
  pub filmIor f32;             // its index of refraction (the coat's is 1.5)
  pub filmScale f32;           // the thickness noise's frequency, a unit of model space
  pub filmDrift f32;           // how far the noise drifts a second, in its own units
  pub filmWarp f32;            // how strongly its domain is warped
  pub filmSeed u32;            // the noise's seed
  pub texture TextureHandle;   // multiplies the base colour; none: white

  // A plain dielectric or metal: no coat, no film
  pub fn standard(baseColor Color, metallic f32, roughness f32) PbrMaterial {
    PbrMaterial[baseColor, metallic, roughness, 0., 0.05, false, 250., 650., 1.8, 1., 0., 1., 0u32,
      TextureHandle.none()];
  }

  // Black chitin, wet: a dark, fairly rough base under a smooth clear coat,
  // and an oily film on the coat, from 'filmMin' to 'filmMax' nanometres,
  // swirled by noise of 'seed'
  pub fn chitin(filmMin f32, filmMax f32, seed u32) PbrMaterial {
    PbrMaterial[Color[0.010, 0.009, 0.012, 1.], 0., 0.45, 1., 0.06, true, filmMin, filmMax, 1.8, 1.6, 0.08, 1.5,
      seed, TextureHandle.none()];
  }
}

// A physically based material's parameters as pbr.slang's PbrParams has them
fn pbrParams(m &PbrMaterial) [16; f32] {
  mut film = 0.;
  if m.film { film = 1.; }
  [m.baseColor.red, m.baseColor.green, m.baseColor.blue, m.baseColor.alpha,
    m.metallic, m.roughness, m.clearcoat, m.clearcoatRoughness,
    m.filmMin, m.filmMax, m.filmIor, film,
    m.filmScale, m.filmDrift, m.filmWarp, f32[m.filmSeed]];
}

// What a bake pass's immediates hold (ibl.slang's BakeImmediates)
struct BakeImmediates {
  pub face u32;
  pub roughness f32;
  pub size f32;
  pub samples u32;
}

// The image-based lighting made from the sky, and what makes it
pub struct Environment {
  pub sky Sky;
  pub skyUniforms Buffer;
  pub skyCube Texture;         // the sky, every level
  pub specularCube Texture;    // prefiltered by roughness, a level a step
  pub irradianceCube Texture;  // the diffuse light
  pub table Texture;           // the split sum's scale and bias
  pub sampler Sampler;         // linear, linear between levels, clamped
  pub shader ShaderModule;
  pub bakeLayout BindGroupLayout;
  pub bakePipelineLayout PipelineLayout;
  pub skyPipeline RenderPipeline;
  pub downsamplePipeline RenderPipeline;
  pub prefilterPipeline RenderPipeline;
  pub irradiancePipeline RenderPipeline;
  pub tablePipeline RenderPipeline;
  pub wholeGroup BindGroup;    // the sky's cube, every level: what prefiltering reads
  pub levelGroups List[BindGroup];  // the sky's cube, level i alone: what level i + 1 is made from
  pub group BindGroup;         // what the physically based material and the sky behind the scene read
  pub dirty Bool;              // the sky changed since the cubes were made
  pub tableMade Bool;
  pub bakes u32;               // how many times the cubes have been made

  // The environment of 'sky', to be made (on the GPU) at the next 'bake';
  // 'groupLayout' is the renderer's environment layout. Check 'isValid'.
  pub fn create(device &mut Device, groupLayout &BindGroupLayout, sky &Sky) Environment {
    mut skyUniforms = device.createBuffer(SKY_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    imm usage = TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING;
    imm skyDesc = TextureDescriptor[ENVIRONMENT_SIZE, ENVIRONMENT_SIZE, TEXTURE_FORMAT_RGBA16_FLOAT, usage,
      ENVIRONMENT_LEVELS, 6u32];
    mut skyCube = device.createTexture(&skyDesc);
    imm specularDesc = TextureDescriptor[SPECULAR_SIZE, SPECULAR_SIZE, TEXTURE_FORMAT_RGBA16_FLOAT, usage,
      SPECULAR_LEVELS, 6u32];
    mut specularCube = device.createTexture(&specularDesc);
    imm irradianceDesc = TextureDescriptor[IRRADIANCE_SIZE, IRRADIANCE_SIZE, TEXTURE_FORMAT_RGBA16_FLOAT, usage,
      1u32, 6u32];
    mut irradianceCube = device.createTexture(&irradianceDesc);
    imm tableDesc = TextureDescriptor[TABLE_SIZE, TABLE_SIZE, TEXTURE_FORMAT_RGBA16_FLOAT, usage];
    mut table = device.createTexture(&tableDesc);
    imm samplerDesc = SamplerDescriptor[addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE, mipmapFilter: FILTER_MODE_LINEAR];
    mut sampler = device.createSampler(&samplerDesc);

    // The bake: the sky's parameters, a cube, the sampler; the immediates
    mut shader = device.createShaderModule(&IBL_SPIRV);
    imm bakeEntries = [BindGroupLayoutEntry[binding: 0u32, visibility: SHADER_STAGE_FRAGMENT],
      BindGroupLayoutEntry[binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        viewDimension: TEXTURE_VIEW_DIMENSION_CUBE],
      BindGroupLayoutEntry[binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER]];
    mut bakeLayout = device.createBindGroupLayout(&bakeEntries);
    imm bakeLayouts = [&bakeLayout];
    mut bakePipelineLayout = device.createPipelineLayout(&bakeLayouts, 16u32);
    mut skyPipeline = fullscreenPipeline(device, &bakePipelineLayout, &shader, "skyCubeMain");
    mut downsamplePipeline = fullscreenPipeline(device, &bakePipelineLayout, &shader, "downsampleMain");
    mut prefilterPipeline = fullscreenPipeline(device, &bakePipelineLayout, &shader, "prefilterMain");
    mut irradiancePipeline = fullscreenPipeline(device, &bakePipelineLayout, &shader, "irradianceMain");
    mut tablePipeline = fullscreenPipeline(device, &bakePipelineLayout, &shader, "brdfTableMain");

    imm wholeDesc = TextureViewDescriptor[dimension: TEXTURE_VIEW_DIMENSION_CUBE];
    imm whole = skyCube.createViewWith(&wholeDesc);
    imm wholeEntries = [BindGroupEntry.buffer(0u32, &skyUniforms), BindGroupEntry.texture(1u32, &whole),
      BindGroupEntry.sampler(2u32, &sampler)];
    mut wholeGroup = device.createBindGroup(&bakeLayout, &wholeEntries);
    mut levelGroups = List[BindGroup].empty();
    mut level = 0u32;
    while level + 1u32 < ENVIRONMENT_LEVELS {
      imm levelDesc = TextureViewDescriptor[dimension: TEXTURE_VIEW_DIMENSION_CUBE, baseMipLevel: level, mipLevelCount: 1u32];
      imm levelView = skyCube.createViewWith(&levelDesc);
      imm levelEntries = [BindGroupEntry.buffer(0u32, &skyUniforms), BindGroupEntry.texture(1u32, &levelView),
        BindGroupEntry.sampler(2u32, &sampler)];
      levelGroups.push(device.createBindGroup(&bakeLayout, &levelEntries));
      level = level + 1u32;
    }

    // What the material reads
    imm cubeDesc = TextureViewDescriptor[dimension: TEXTURE_VIEW_DIMENSION_CUBE];
    imm irradianceView = irradianceCube.createViewWith(&cubeDesc);
    imm specularView = specularCube.createViewWith(&cubeDesc);
    imm tableView = table.createView();
    imm entries = [BindGroupEntry.buffer(0u32, &skyUniforms), BindGroupEntry.texture(1u32, &irradianceView),
      BindGroupEntry.texture(2u32, &specularView), BindGroupEntry.texture(3u32, &tableView),
      BindGroupEntry.sampler(4u32, &sampler)];
    mut group = device.createBindGroup(groupLayout, &entries);
    mut env = Environment[*sky, skyUniforms, skyCube, specularCube, irradianceCube, table, sampler, shader, bakeLayout,
      bakePipelineLayout, skyPipeline, downsamplePipeline, prefilterPipeline, irradiancePipeline, tablePipeline,
      wholeGroup, levelGroups, group, true, false, 0u32];
    env.setSky(device, sky);
    env;
  }

  // Whether everything it needs was made
  pub fn isValid(self &) Bool {
    group.isValid() and wholeGroup.isValid() and skyPipeline.isValid() and downsamplePipeline.isValid()
      and prefilterPipeline.isValid() and irradiancePipeline.isValid() and tablePipeline.isValid()
      and levelGroups.len() + 1usize == usize[ENVIRONMENT_LEVELS];
  }

  // Light by 'sky' from now on: its parameters written, the cubes made
  // again at the next 'bake'
  pub fn setSky(self &mut, device &mut Device, s &Sky) {
    sky = *s;
    imm params = skyParams(s);
    device.queue.writeBuffer(&skyUniforms, 0u64, &params as *u8, SKY_BYTES);
    dirty = true;
  }

  // Record the passes that make the cubes (and, the first time, the table)
  // into 'encoder', if the sky changed since they were made
  pub fn bake(self &mut, encoder &mut CommandEncoder) {
    if !tableMade {
      imm tableView = table.createView();
      bakePass(encoder, tableView, &tablePipeline, &wholeGroup, 0u32, 0., f32[TABLE_SIZE], TABLE_SAMPLES);
      tableMade = true;
    }
    if !dirty { return; }
    dirty = false;
    bakes = bakes + 1u32;
    // The sky into level 0 (the pass reads no cube, so any group of the
    // layout will do: the last level's, which it does not draw into)
    mut face = 0u32;
    imm unread = levelGroups[levelGroups.len() - 1usize];
    while face < 6u32 {
      imm view = faceView(&skyCube, face, 0u32);
      bakePass(encoder, view, &skyPipeline, unread, face, 0., f32[ENVIRONMENT_SIZE], 0u32);
      face = face + 1u32;
    }
    // Each level from the one above
    mut level = 1u32;
    while level < ENVIRONMENT_LEVELS {
      face = 0u32;
      while face < 6u32 {
        imm view = faceView(&skyCube, face, level);
        imm source = levelGroups[usize[level - 1u32]];
        bakePass(encoder, view, &downsamplePipeline, source, face, 0., f32[ENVIRONMENT_SIZE >> level], 0u32);
        face = face + 1u32;
      }
      level = level + 1u32;
    }
    // The specular cube, a roughness a level
    level = 0u32;
    while level < SPECULAR_LEVELS {
      imm roughness = f32[level] / f32[SPECULAR_LEVELS - 1u32];
      face = 0u32;
      while face < 6u32 {
        imm view = faceView(&specularCube, face, level);
        bakePass(encoder, view, &prefilterPipeline, &wholeGroup, face, roughness, f32[SPECULAR_SIZE >> level],
          PREFILTER_SAMPLES);
        face = face + 1u32;
      }
      level = level + 1u32;
    }
    // The diffuse cube
    face = 0u32;
    while face < 6u32 {
      imm view = faceView(&irradianceCube, face, 0u32);
      bakePass(encoder, view, &irradiancePipeline, &wholeGroup, face, IRRADIANCE_SOURCE_LEVEL, f32[IRRADIANCE_SIZE],
        IRRADIANCE_SAMPLES);
      face = face + 1u32;
    }
  }
}

// A view of one face at one level of the cube 'texture', to draw into
fn faceView(texture &Texture, face u32, level u32) TextureView {
  imm desc = TextureViewDescriptor[dimension: TEXTURE_VIEW_DIMENSION_2D, baseMipLevel: level, mipLevelCount: 1u32,
    baseArrayLayer: face, arrayLayerCount: 1u32];
  texture.createViewWith(&desc);
}

// One full-screen bake pass into 'view'
fn bakePass(encoder &mut CommandEncoder, view TextureView, pipeline &RenderPipeline, group &BindGroup, face u32,
    roughness f32, size f32, samples u32) {
  imm attachment = RenderPassColorAttachment[view: view, clearValue: Color[0., 0., 0., 1.]];
  mut pass = encoder.beginRenderPass(&attachment);
  pass.setPipeline(pipeline);
  pass.setBindGroup(0u32, group);
  imm data = BakeImmediates[face, roughness, size, samples];
  pass.setImmediates(0u32, &data as *u8, 16u32);
  pass.draw(3u32, 1u32, 0u32, 0u32);
  pass.end();
}

// A pipeline drawing one triangle over an RGBA16_FLOAT target, its vertex
// stage 'fullscreenMain' of 'shader' (no vertex buffers), its fragment
// stage 'entry'
fn fullscreenPipeline(device &mut Device, layout &PipelineLayout, shader &ShaderModule, entry &[]u8) RenderPipeline {
  imm attributes = [VertexAttribute[VERTEX_FORMAT_FLOAT32, 0u64, 0u32]];
  imm buffers = [VertexBufferLayout[arrayStride: 4u64, attributes: &attributes]];
  imm desc = RenderPipelineDescriptor[layout: layout, vertexModule: shader, vertexEntryPoint: "fullscreenMain",
    buffers: &buffers[..0], fragmentModule: shader, fragmentEntryPoint: entry, colorFormat: TEXTURE_FORMAT_RGBA16_FLOAT];
  device.createRenderPipeline(&desc);
}

