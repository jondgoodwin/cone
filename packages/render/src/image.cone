// Image: pixels in memory, and BMP files read and written.
//
// Pegasus decoded its images (JPEG, PNG, GIF) with stb_image, a C library
// held in one header. This package reads uncompressed BMP files itself, in
// Cone, which is enough to texture a shape and needs no C compiled into the
// build; stb_image waits for Congo to compile a package's C sources. An Image
// is what stb_image gave Pegasus with its "flip vertically on load" set: rows
// from the bottom up, each row 'width' pixels of 'channels' bytes (3 is RGB, 4
// is RGBA), with no padding. The renderer's 'addTexture' hands one to the GPU
// row for row, so its bottom row is where a texture coordinate's v is 0, as
// mesh's uvs have it (v up).
//
// It also writes a 24-bit BMP ('toBmp', 'save'), and makes an image of pixels
// read back from the GPU ('fromTexels'), which is how a frame is saved.

pub struct Image {
  pub width i32;
  pub height i32;
  pub channels i32;       // bytes per pixel: 3 red, green, blue; 4 with alpha
  pub pixels List[u8];    // bottom row first

  // No pixels: what a decode that fails gives
  pub fn empty() Image { new Image(0, 0, 3, List[u8].empty()); }

  pub fn isEmpty(self &) bool { width == 0 or height == 0; }

  // Channel c (0 red, 1 green, 2 blue, 3 alpha) of the pixel x from the left
  // and y from the bottom
  pub fn at(self &, x i32, y i32, c i32) u8 {
    *pixels[usize.from((y * width + x) * channels + c)];
  }

  // A checkerboard 'width' by 'height' pixels, of 'across' squares by 'down',
  // the bottom-left one colored a and its neighbours b. (Not Pegasus's: it
  // gives the example a texture without a file.)
  pub fn checker(width i32, height i32, across i32, down i32, a Color, b Color) Image {
    mut img = new Image(width, height, 3, List[u8].withCapacity(usize.from(width * height * 3)));
    imm cw = if width / across > 0 {width / across;} else {1;};
    imm ch = if height / down > 0 {height / down;} else {1;};
    mut y = 0;
    while y < height {
      mut x = 0;
      while x < width {
        imm c = if (x / cw + y / ch) % 2 == 0 {a;} else {b;};
        img.pixels.push(colorByte(c.red));
        img.pixels.push(colorByte(c.green));
        img.pixels.push(colorByte(c.blue));
        x = x + 1;
      }
      y = y + 1;
    }
    img;
  }

  // An RGB image of 'width' by 'height' texels read back from the GPU at
  // 'data': 4 bytes each, rows from the top, with no gap between rows, in
  // red, green, blue order, or blue, green, red if 'bgra' (a swapchain's
  // BGRA formats). The fourth byte is dropped.
  pub fn fromTexels(data *u8, width i32, height i32, bgra bool) Image {
    mut img = new Image(width, height, 3, List[u8].withCapacity(usize.from(width * height * 3)));
    mut y = 0;
    while y < height {
      // The image's row y from the bottom is the texels' row height - 1 - y
      imm row = data + usize.from((height - 1 - y) * width * 4);
      mut x = 0;
      while x < width {
        imm p = row + usize.from(x * 4);
        if bgra {
          img.pixels.push(*(p + 2usize));
          img.pixels.push(*(p + 1usize));
          img.pixels.push(*p);
        } else {
          img.pixels.push(*p);
          img.pixels.push(*(p + 1usize));
          img.pixels.push(*(p + 2usize));
        }
        x = x + 1;
      }
      y = y + 1;
    }
    img;
  }

  // The image in a BMP file, or an empty one when the file cannot be read or
  // is not a BMP this decodes (see 'fromBmp')
  pub fn load(path &Array[u8]) Image {
    mut ok = true;
    imm data = readFile(path, &mut ok);
    if !ok { return Image.empty(); }
    Image.fromBmp(data.view());
  }

  // The image a BMP file's bytes hold: uncompressed, 24 bits a pixel (RGB) or
  // 32 (RGBA, its masks the usual ones), stored bottom-up or top-down. Any
  // other BMP, or bytes that are not one, give an empty image.
  pub fn fromBmp(data &Array[u8]) Image {
    if data.len < 54usize { return Image.empty(); }
    if data[0] != 'B' or data[1] != 'M' { return Image.empty(); }
    imm offset = usize.from(le32(data, 10usize));
    imm headerSize = le32(data, 14usize);
    imm width = i32.from(le32(data, 18usize));
    mut height = i32.from(le32(data, 22usize));
    imm bpp = le16(data, 28usize);
    imm compression = le32(data, 30usize);

    // A negative height means the rows are stored top row first
    imm topDown = height < 0;
    if topDown { height = -height; }
    if width <= 0 or height <= 0 { return Image.empty(); }
    if bpp != 24u16 and bpp != 32u16 { return Image.empty(); }

    // Compression 0 is none. 3 (BI_BITFIELDS) says masks give each channel's
    // bits; only the usual 32-bit masks (blue, green, red, alpha bytes) are read.
    if compression == 3u32 {
      if bpp != 32u16 or data.len < 66usize { return Image.empty(); }
      if le32(data, 54usize) != 0x00FF0000u32 or le32(data, 58usize) != 0x0000FF00u32
        or le32(data, 62usize) != 0x000000FFu32 {
        return Image.empty();
      }
    } elif compression != 0u32 {
      return Image.empty();
    }
    imm channels = i32.from(bpp) / 8;

    // Each stored row is padded to a multiple of four bytes
    imm rowSize = usize.from((width * i32.from(bpp) + 31) / 32 * 4);
    if offset + rowSize * usize.from(height) > data.len { return Image.empty(); }

    // A 32-bit BMP without masks leaves its fourth byte unused: opaque
    imm alphaStored = channels == 4 and compression == 3u32 and headerSize >= 56u32;

    mut img = new Image(width, height, channels, List[u8].withCapacity(usize.from(width * height * channels)));
    mut row = 0;
    while row < height {
      imm stored = if topDown {height - 1 - row;} else {row;};
      imm base = offset + usize.from(stored) * rowSize;
      mut x = 0;
      while x < width {
        imm p = base + usize.from(x * channels);
        // Stored blue, green, red (alpha)
        img.pixels.push(data[p + 2usize]);
        img.pixels.push(data[p + 1usize]);
        img.pixels.push(data[p]);
        if channels == 4 {
          img.pixels.push(if alphaStored {data[p + 3usize];} else {255u8;});
        }
        x = x + 1;
      }
      row = row + 1;
    }
    img;
  }

  // The image as a BMP file's bytes: 24 bits a pixel, bottom row first, the
  // information header the 40-byte one (alpha, if it has any, dropped)
  pub fn toBmp(self &) List[u8] {
    imm rowSize = (width * 3 + 3) / 4 * 4;
    imm pixelBytes = rowSize * height;
    mut out = List[u8].withCapacity(usize.from(54 + pixelBytes));
    // The file header: 'BM', the file's size, 0, where the pixels start
    out.push('B');
    out.push('M');
    put32(&mut out, u32.from(54 + pixelBytes));
    put32(&mut out, 0u32);
    put32(&mut out, 54u32);
    // The information header: its size, width, height, 1 plane, 24 bits a
    // pixel, no compression, the pixels' size, 2835 pixels a meter (72 dpi)
    // each way, no palette
    put32(&mut out, 40u32);
    put32(&mut out, u32.from(width));
    put32(&mut out, u32.from(height));
    out.push(1u8);
    out.push(0u8);
    out.push(24u8);
    out.push(0u8);
    put32(&mut out, 0u32);
    put32(&mut out, u32.from(pixelBytes));
    put32(&mut out, 2835u32);
    put32(&mut out, 2835u32);
    put32(&mut out, 0u32);
    put32(&mut out, 0u32);
    mut y = 0;
    while y < height {
      mut x = 0;
      while x < width {
        // Stored blue, green, red
        imm p = usize.from((y * width + x) * channels);
        out.push(*pixels[p + 2usize]);
        out.push(*pixels[p + 1usize]);
        out.push(*pixels[p]);
        x = x + 1;
      }
      mut pad = width * 3;
      while pad < rowSize {
        out.push(0u8);
        pad = pad + 1;
      }
      y = y + 1;
    }
    out;
  }

  // Write the image to 'path' as a 24-bit BMP; false if it could not be
  // written
  pub fn save(self &, path &Array[u8]) bool {
    imm bytes = self.toBmp();
    imm v = bytes.view();
    mut cpath = String.from(path);
    imm f = libc.fopen(cpath.cstr(), "wb");
    if !f { return false; }
    imm written = libc.fwrite(&v[0] as *u8, 1usize, v.len, f);
    libc.fclose(f);
    written == v.len;
  }
}

// A color component from 0 to 1 as a byte from 0 to 255
fn colorByte(c f32) u8 {
  if c <= 0. { return 0u8; }
  if c >= 1. { return 255u8; }
  u8.from(c * 255. + 0.5);
}

// Little-endian numbers in a byte slice, and appended to a list
fn le16(d &Array[u8], at usize) u16 { u16.from(d[at]) | (u16.from(d[at + 1usize]) << 8u16); }
fn le32(d &Array[u8], at usize) u32 {
  u32.from(d[at]) | (u32.from(d[at + 1usize]) << 8u32) | (u32.from(d[at + 2usize]) << 16u32) | (u32.from(d[at + 3usize]) << 24u32);
}
fn put32(out &mut List[u8], v u32) {
  out.push(u8.from(v & 0xFFu32));
  out.push(u8.from((v >> 8u32) & 0xFFu32));
  out.push(u8.from((v >> 16u32) & 0xFFu32));
  out.push(u8.from((v >> 24u32) & 0xFFu32));
}
