// Image quality: the optional passes around the renderer's frame that make the
// picture steadier and richer, driven by one object, ImageFx. Each is a
// setting; with all of them off a frame is exactly what 'renderer.render' and
// 'post.apply' made before this file existed.
//
//   mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
//   mut post = Post.create(&mut device, swapchain.format, width, height);
//   mut fx = ImageFx.create(&mut device, &renderer, &post);
//   fx.configure(&FxSettings.high());                     // once, or when the settings change
//   ...
//   post.resize(&mut device, frame.texture.width, frame.texture.height);
//   fx.render(&mut device, &mut encoder, &mut renderer, &mut post, &camera, &light, &list, &frame.texture);
//
// 'fx.render' replaces the two calls 'renderer.render(..., &post.hdr, ...)' and
// 'post.apply(..., target)': it draws the scene, runs the passes that are on,
// and finishes with Post. The depth buffer is its own (sampled by the passes
// that need it), so the program passes none.
//
// THE PASSES, in the order a frame runs them (each file has its method):
//   scene                       renderer.render, jittered when temporal AA is on
//   velocity   (taa.cone)       the objects the program names as moving, drawn again
//   temporal AA (taa.cone)      reproject, clip, blend, sharpen
//   auto-exposure (exposure.cone)  histogram of the frame, adapted exposure
//   bloom, tone map, grading, vignette, grain (post.cone, Post.finish)
//   FXAA       (fxaa.cone)      on the finished picture, the cheap tier
//
// QUALITY TIERS. 'FxSettings.high()' is for a discrete GPU, 'medium()' for a
// middling one, 'low()' for an integrated one (the Intel UHD must stay
// usable): temporal AA with 16 samples, then with 8, then FXAA. Every field
// is a setting; the tiers are starting points that the cost table in
// Design\render.md puts numbers to.

// How the passes are set: the antialiasing (AA_NONE, AA_FXAA or AA_TAA, only
// one) and the auto-exposure. The grading, vignette and grain are Post's own
// ('post.finish'), since they need nothing but the tone map.
pub struct FxSettings {
  pub aa u32 = AA_NONE;
  pub taa TaaSettings = new TaaSettings();
  pub fxaa FxaaSettings = new FxaaSettings();
  pub exposure ExposureSettings = new ExposureSettings();

  // Everything off
  pub fn off() FxSettings { new FxSettings(); }

  // For a discrete GPU: temporal AA (16 samples, sharpened) and auto-exposure
  pub fn high() FxSettings {
    new FxSettings(aa: AA_TAA, taa: TaaSettings.high(), exposure: new ExposureSettings(enabled: true));
  }

  // For a middling GPU: temporal AA of 8 samples and auto-exposure
  pub fn medium() FxSettings {
    new FxSettings(aa: AA_TAA, taa: TaaSettings.medium(), exposure: new ExposureSettings(enabled: true, stride: 3u32));
  }

  // For an integrated GPU: FXAA and a cheap auto-exposure
  pub fn low() FxSettings {
    new FxSettings(aa: AA_FXAA, exposure: new ExposureSettings(enabled: true, stride: 4u32));
  }
}

// The bytes of fxcommon.slang's FxFrame, and its floats
const FX_FRAME_BYTES = 336u64;
const FX_FRAME_FLOATS = 84usize;

// The frames ImageFx meters and tone maps: the renderer's own, or what a pass
// made of it
const SOURCE_HDR = 0u32;
const SOURCE_HISTORY0 = 1u32;
const SOURCE_HISTORY1 = 2u32;
const SOURCE_SHARP = 3u32;

pub struct ImageFx {
  pub settings FxSettings;
  pub width u32;
  pub height u32;
  pub outputFormat u32;
  pub depth Texture;               // the scene's depth, kept for the passes (sampled)
  pub frameBuffer Buffer;          // fxcommon.slang's FxFrame
  pub taa TaaPass;
  pub fxaa FxaaPass;
  pub exposure ExposurePass;
  pub sources List[PostSource];    // Post's groups for the frames the passes make (SOURCE_HISTORY0 and on, less one)
  // What is moving this frame (taa.cone): the program fills it after adding
  // the items to the draw list; it is emptied by 'render'
  pub motion MotionList;
  pub frameNumber u32;             // frames drawn: the jitter's index
  pub previousViewProjection Mat4;
  pub havePrevious bool;
  pub postRevision u32;
  pub dirty bool;
  pub cut bool;                    // the next frame starts afresh (a camera cut): no history
  pub lastTime f32;
  // The seconds a frame lasts, when 'renderer.time' is not kept up to date
  pub frameTime f32 = 0.016666668;
  pub jitterPixelsX f32 = 0.;      // the last frame's jitter, in pixels
  pub jitterPixelsY f32 = 0.;
  pub velocityDrawn bool = false;  // the last frame had moving objects drawn

  // The passes for frames of 'post''s size, all off. They are made lazily:
  // textures only for what 'configure' turns on.
  pub fn create(device &mut Device, renderer &Renderer, post &mut Post) ImageFx {
    mut frameBuffer = device.createBuffer(FX_FRAME_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    imm tinyDepth = new TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_DEPTH32_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    mut depth = device.createTexture(&tinyDepth);
    mut taa = TaaPass.create(device, &renderer.frameLayout, &renderer.materialLayout, &renderer.pbrMaterialLayout, &frameBuffer);
    mut fxaa = FxaaPass.create(device, post.outputFormat);
    mut exposure = ExposurePass.create(device);
    mut fx = new ImageFx(new FxSettings(), 0u32, 0u32, post.outputFormat, depth, frameBuffer, taa, fxaa, exposure,
      List[PostSource].empty(), MotionList.empty(), 0u32, Mat4.identity(), false, 0u32, true, true, 0.);
    fx.remake(device, renderer, post);
    fx;
  }

  pub fn isValid(self &) bool { depth.isValid() and frameBuffer.isValid() and taa.isValid() and fxaa.isValid() and exposure.isValid(); }

  // Set the passes. Switching a pass on or off, or the antialiasing, makes
  // its textures (waiting for the GPU) at the next frame; the rest of the
  // settings are read every frame and may change at will.
  pub fn configure(self &mut, s &FxSettings) {
    imm sharpWas = settings.taa.sharpness > 0.;
    imm sharpNow = s.taa.sharpness > 0.;
    if s.aa != settings.aa or s.exposure.enabled != settings.exposure.enabled or sharpWas != sharpNow {
      dirty = true;
    }
    settings = *s;
  }

  // Forget the history: the next frame is a cut (a teleport, a new scene)
  pub fn cutHistory(self &mut) { cut = true; }

  // Make the textures and groups the settings call for, for 'post''s size
  fn remake(self &mut, device &mut Device, renderer &Renderer, post &mut Post) {
    // The textures about to be replaced may be named by commands the frame
    // has recorded and not submitted: submit them first (gpu.md, "Lifetimes")
    mut flush = device.createCommandEncoder();
    device.queue.submit(flush.finish());
    device.waitIdle();
    imm w = post.width;
    imm h = post.height;
    width = w;
    height = h;
    outputFormat = post.outputFormat;
    imm depthDesc = new TextureDescriptor(w, h, TEXTURE_FORMAT_DEPTH32_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    depth = device.createTexture(&depthDesc);
    imm taaOn = settings.aa == AA_TAA;
    imm fxaaOn = settings.aa == AA_FXAA;
    imm hdrView = post.hdr.createView();
    imm depthView = depth.createView();
    taa.remake(device, taaOn, w, h, &hdrView, &depthView, &frameBuffer, settings.taa.sharpness);
    fxaa.remake(device, fxaaOn, w, h, post.outputFormat);
    // Post's groups for what the passes make, and the exposure's
    sources = List[PostSource].empty();
    exposure.groups = List[BindGroup].empty();
    exposure.addSource(device, &hdrView, &post.exposureBuffer);
    imm h0 = taa.history0.createView();
    imm h1 = taa.history1.createView();
    imm sh = taa.sharp.createView();
    sources.push(post.sourceGroups(device, &h0));
    sources.push(post.sourceGroups(device, &h1));
    sources.push(post.sourceGroups(device, &sh));
    exposure.addSource(device, &h0, &post.exposureBuffer);
    exposure.addSource(device, &h1, &post.exposureBuffer);
    exposure.addSource(device, &sh, &post.exposureBuffer);
    exposure.snap = true;
    postRevision = post.revision;
    dirty = false;
    cut = true;
  }

  // Draw the scene and run the passes the settings turn on, then bloom, tone
  // map and finish into 'target' (of 'post''s output format; the program's
  // 'post' is sized to it). See the head of this file.
  pub fn render(self &mut, device &mut Device, encoder &mut CommandEncoder, renderer &mut Renderer, post &mut Post,
      camera &Camera, light &Light, list &DrawList, target &Texture) {
    if dirty or width != post.width or height != post.height or postRevision != post.revision {
      self.remake(device, renderer, post);
    }
    imm s = settings;
    imm taaOn = s.aa == AA_TAA;
    imm fxaaOn = s.aa == AA_FXAA;
    imm aspect = f32.from(width) / f32.from(height);

    // The seconds since the last frame
    mut dt = frameTime;
    if renderer.time > lastTime and lastTime > 0. { dt = renderer.time - lastTime; }
    if dt > 0.5 { dt = 0.5; }
    lastTime = renderer.time;

    // The jitter, and the camera the scene is drawn with: moved by it
    mut base = *camera;
    base.jitterX = 0.;
    base.jitterY = 0.;
    mut jittered = base;
    imm previousJitterX = jitterPixelsX;
    imm previousJitterY = jitterPixelsY;
    if taaOn {
      mut jx = 0.;
      mut jy = 0.;
      jitterOf(frameNumber, if s.taa.samples < 2u32 { 2u32; } else { s.taa.samples; }, s.taa.jitterScale, &mut jx, &mut jy);
      jitterPixelsX = jx;
      jitterPixelsY = jy;
      jittered.jitterX = 2. * jitterPixelsX / f32.from(width);
      jittered.jitterY = -2. * jitterPixelsY / f32.from(height);
    } else {
      jitterPixelsX = 0.;
      jitterPixelsY = 0.;
    }

    // The frame uniform for the passes: the unjittered camera, now and last frame
    imm projection = base.projectionMatrix(aspect);
    imm viewProjection = projection * base.viewMatrix();
    imm inverse = viewProjection.inverse();
    imm previous = if havePrevious and !cut { previousViewProjection; } else { viewProjection; };
    imm place = base.placement();
    imm forward = new Vec3(-place.m[8], -place.m[9], -place.m[10]).normalize();
    imm eye = base.position();
    imm towards = new Vec3(0., 0., 0.) - light.direction;
    mut data = new Array[f32, 84] <- fill 0f;
    mut k = 0usize;
    while k < 16usize {
      data[k] = viewProjection.m[k];
      data[16usize + k] = inverse.m[k];
      data[32usize + k] = previous.m[k];
      k = k + 1usize;
    }
    data[48] = eye.x;
    data[49] = eye.y;
    data[50] = eye.z;
    data[52] = forward.x;
    data[53] = forward.y;
    data[54] = forward.z;
    data[55] = base.near;
    data[56] = f32.from(width);
    data[57] = f32.from(height);
    data[58] = 1. / f32.from(width);
    data[59] = 1. / f32.from(height);
    data[60] = jitterPixelsX;
    data[61] = jitterPixelsY;
    data[62] = previousJitterX;
    data[63] = previousJitterY;
    data[64] = projection.m[10];
    data[65] = projection.m[14];
    data[66] = projection.m[0];
    data[67] = projection.m[5];
    data[68] = towards.x;
    data[69] = towards.y;
    data[70] = towards.z;
    data[71] = renderer.exposure;
    data[72] = light.color.red;
    data[73] = light.color.green;
    data[74] = light.color.blue;
    data[75] = renderer.time;
    data[76] = light.ambient.red;
    data[77] = light.ambient.green;
    data[78] = light.ambient.blue;
    data[79] = dt;
    data[80] = f32.from(frameNumber);
    data[81] = base.far;
    data[82] = if cut { 1.; } else { 0.; };
    device.queue.writeBuffer(&frameBuffer, 0u64, &data as *u8, FX_FRAME_BYTES);

    // The scene, its depth kept for the passes that read it
    if taaOn { renderer.keepDepth = true; }
    renderer.render(device, encoder, &post.hdr, &depth, &jittered, light, list);

    // Temporal AA: the objects that move, then the resolve
    mut source = SOURCE_HDR;
    velocityDrawn = false;
    if taaOn {
      mut moving = false;
      if motion.len() > 0usize { moving = taa.writePrevious(device, &frameBuffer, renderer, list, &motion); }
      if moving {
        taa.recordVelocity(encoder, renderer, list, &depth);
        velocityDrawn = true;
      }
      taa.recordResolve(encoder, &s.taa, moving);
      source = SOURCE_HISTORY0 + taa.outputSource(s.taa.sharpness);
    }

    // The exposure from the frame that will be shown
    post.finish.exposureFromBuffer = s.exposure.enabled;
    if s.exposure.enabled {
      exposure.record(device, encoder, &s.exposure, source, width, height, dt);
    } else {
      exposure.snap = true;
    }

    // Bloom, tone map and finish; FXAA reads the result
    if fxaaOn {
      if source == SOURCE_HDR { post.apply(encoder, &fxaa.ldr); } else { post.applyFrom(encoder, &fxaa.ldr, sources[usize.from(source - 1u32)]); }
      fxaa.record(encoder, target, &s.fxaa);
    } else {
      if source == SOURCE_HDR { post.apply(encoder, target); } else { post.applyFrom(encoder, target, sources[usize.from(source - 1u32)]); }
    }

    previousViewProjection = viewProjection;
    havePrevious = true;
    cut = false;
    frameNumber = frameNumber + 1u32;
    motion.clear();
  }
}

// A full-screen pipeline: the triangle of 'fullscreenMain', the fragment
// entry 'fragment', drawing into a target of 'format', its colour replaced or,
// if 'blend', added over what is there with premultiplied alpha
fn fxPipeline(device &mut Device, layout &PipelineLayout, shader &ShaderModule, fragment &str, format u32, blend bool)
    RenderPipeline {
  imm attributes = [new VertexAttribute(VERTEX_FORMAT_FLOAT32, 0u64, 0u32)];
  imm buffers = [new VertexBufferLayout(arrayStride: 4u64, attributes: &attributes)];
  imm desc = new RenderPipelineDescriptor(layout: layout, vertexModule: shader, vertexEntryPoint: "fullscreenMain",
    buffers: &buffers[..<0], fragmentModule: shader, fragmentEntryPoint: fragment, colorFormat: format,
    blendEnabled: blend, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
    alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
  device.createRenderPipeline(&desc);
}

// One full-screen pass into 'view': cleared first, or, if 'keep', drawn over
// what it holds; 'group' as group 0, 'size' bytes of immediates from 'data'
fn fxPass(encoder &mut CommandEncoder, view TextureView, keep bool, pipeline &RenderPipeline, group &BindGroup, data *u8,
    size u32) {
  imm attachment = new RenderPassColorAttachment(view: view, loadOp: if keep { LOAD_OP_LOAD; } else { LOAD_OP_CLEAR; },
    clearValue: new Color(0., 0., 0., 0.));
  mut pass = encoder.beginRenderPass(&attachment);
  pass.setPipeline(pipeline);
  pass.setBindGroup(0u32, group);
  if size > 0u32 { pass.setImmediates(0u32, data, size); }
  pass.draw(3u32, 1u32, 0u32, 0u32);
  pass.end();
}

// A texture cleared to zero now (in a submission of its own)
fn clearTexture(device &mut Device, texture &Texture) {
  mut encoder = device.createCommandEncoder();
  imm attachment = new RenderPassColorAttachment(view: texture.createView(), clearValue: new Color(0., 0., 0., 0.));
  mut pass = encoder.beginRenderPass(&attachment);
  pass.end();
  device.queue.submit(encoder.finish());
}
