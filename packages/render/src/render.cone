// The render package: drawing lit 3D meshes on the GPU, through the gpu
// package (Vulkan underneath, and nothing of Vulkan's here). A program reaches
// it with 'import render', and gets:
//
// - Renderer, which owns what drawing needs: the pipelines of its materials,
//   the frame's uniforms, and the resources it hands out handles to --
//   meshes, textures, materials -- each kept in a generational pool (the
//   pool package), so a handle to something removed reaches nothing.
// - GpuMesh, a mesh.Mesh's vertex streams (positions, normals, uvs, each its
//   own vertex buffer, as the Mesh keeps them) and its 32-bit indices,
//   uploaded once into GPU buffers and kept; each of the mesh's material
//   groups is one draw. A MeshHandle names one, and its contents can be
//   replaced under the same handle ('replaceMesh'): the new version is
//   uploaded at once and drawn from the next frame on, and the old one's
//   buffers are released to the frame that last drew it, destroyed when the
//   GPU has finished it. That is what meshes that arrive at several levels
//   of detail, sculpted at run time, need. A dynamic mesh
//   ('addDynamicMesh') is room for a mesh rewritten in place frame by frame
//   ('writeDynamicMesh').
// - Custom pipelines (custom.cone): shaders of the caller's own
//   ('addPipeline'), importing renderframe.slang, whose materials
//   ('addCustomMaterial') bind parameters and textures of their own (an
//   r32float field from 'addFieldTexture', read in the vertex stage, for a
//   heightfield), drawn, batched and instanced with the rest.
// - LodChain, the levels of detail of one object, most detailed first
//   (LOD 0, as Unreal, Unity and Godot number them), chosen by index or by
//   the size the object is drawn at, with hysteresis so it does not flicker
//   at a threshold.
// - Camera (perspective or orthogonal, depth from 0 to 1, placed by origin
//   and orientation or 'lookAt') and Light (one directional light and
//   ambient light).
// - Material, the standard lit one: a base color times a texture (the
//   texture optional), Lambert diffuse and Blinn-Phong specular, and an
//   emissive color, in Slang (lit.slang); and lines in one flat color
//   (lines.slang), for wireframes and edges. Every material has an alpha
//   mode, glTF's: opaque, cut out (ALPHA_MASK: a fragment below the
//   cut-off is discarded; leaves, fences) or see-through (ALPHA_BLEND:
//   glass, glowing panes, light painted on with an alpha of 0).
// - One lighting convention for every material (renderframe.slang): the
//   light's color is irradiance (lux in physical units), ambient light,
//   sky and emissive colors are radiance (nits), and everything drawn is
//   multiplied by 'exposure' as it is written ('exposureFromEv100').
// - PbrMaterial, the physically based one (pbr.slang, over the brdf
//   module): glTF 2.0's metallic-roughness base (GGX, Smith, Schlick,
//   Lambert), a clear coat over it, and over the coat a thin film (Belcour
//   and Barla's iridescence) whose thickness is the noise package's warped
//   fBm, drifting with 'renderer.time'; lit by the sun and by the
//   Environment. Its base may come from glTF's maps: base colour,
//   metallic-roughness, occlusion and a tangent-space normal map, whose
//   tangents the shader finds from screen-space derivatives.
// - Sky (sky.slang), an analytic dusk, drawn behind the scene once set
//   ('setSky'); and Environment, the image-based lighting the renderer
//   makes from it by full-screen passes (ibl.slang): the sky's cube and its
//   levels, a specular cube prefiltered by roughness, a diffuse cube, and
//   the split sum's table (lighting.cone).
// - Post, from HDR light to the display (post.slang, post.cone): the
//   half-float frame the renderer draws into, Jimenez's bloom chain, and
//   tone mapping by AgX (or ACES's fit, Reinhard, none).
// - DrawList: what is drawn this frame, each a mesh, a material and a model
//   matrix (and a tint), drawn in one render pass.
// - Skinning (skin.cone, skinning.slang): a mesh bound to a skeleton's bones
//   by a Skin (four joints and weights a vertex), uploaded by
//   'addSkinnedMesh' and drawn by 'DrawList.addSkinned' with one skinning
//   matrix a bone, which the GPU blends (linear blend skinning) in the
//   skinned variants of the lit and physically based pipelines.
// - Image, pixels from BMP (or made: 'Image.checker'), written as BMP too;
//   'addTexture' hands one to the GPU as sRGB colour, 'addLinearTexture' as
//   numbers (an ORM map), 'addNormalTexture' as a normal map; each with its
//   whole mip chain (mips.cone), which the renderer's sampler filters
//   trilinearly and anisotropically (16 where the device can).
//
// A frame, once a window, a device and a swapchain are open (the window and
// gpu packages):
//
//   mut renderer = Renderer.create(&mut device, swapchain.format, TEXTURE_FORMAT_DEPTH32_FLOAT);
//   imm ball = renderer.addMesh(&mut device, &sphere);          // once
//   imm redMaterial = Material.plain(new Color(1., 0., 0., 1.));
//   imm red = renderer.addMaterial(&mut device, &redMaterial);
//   ...
//   imm frame = swapchain.getCurrentTexture(&mut device);
//   list.clear();
//   list.add(ball, red, Mat4.fromTranslation(new Vec3(0., 1., 0.)));
//   mut encoder = device.createCommandEncoder();
//   renderer.render(&mut device, &mut encoder, &frame.texture, &frame.depth, &camera, &light, &list);
//   device.queue.submit(encoder.finish());
//   swapchain.present(&mut device);
//
// Lit physically, in HDR: the renderer draws into a Post's half-float frame,
// and the Post bloom and tone-map it into the swapchain's texture (post.cone
// has the frame's shape).
//
// HOW IT IS BOUND. Group 0 is the frame's (renderframe.slang): one uniform
// buffer holding the camera's view-projection matrix, its inverse and
// position, the light, the target's size, the time, the environment's
// strength and the exposure, and one storage buffer of instances, each
// drawn copy's model matrix and tint (80 bytes), both written once a render
// ('queue.writeBuffer'); then, read by the skinned vertex stages only
// (skinning.slang), the bones (a storage buffer of every skinned copy's
// skinning matrices, 48 bytes a bone, each copy's run side by side) and the
// bone bases (a storage buffer of a u32 an instance: where its copy's bones
// start, or NO_BONES), both written once a render too. Group 1 is the material's: its parameters in a
// uniform buffer of its own, its texture and the renderer's sampler; for
// the physically based material, its metallic-roughness, normal and
// occlusion maps after them (its own layout, 'pbrMaterialLayout'); for a
// custom pipeline's material, its parameters, its textures and the sampler,
// as its pipeline lays them out (custom.cone). Group 2, bound for the
// physically based material, the sky and a custom pipeline that asks, is
// the environment's: the sky's parameters, its cubes and table, their
// sampler. Lines take their model matrix and color from the
// immediates (Vulkan's push constants) instead, one draw each.
//
// INSTANCING. The draw list's items are gathered into batches, one per
// (material, mesh): the copies of one mesh in one material, however many
// items name them, are one instanced draw per material group of the mesh
// ('drawIndexed' with an instance count and a first instance), their
// instances side by side in the instance buffer. A scene of a thousand
// stones in one material is one draw. Copies of one skinned mesh batch the
// same way, each with bones of its own, found through its bone base.
//
// THE DRAW ORDER. Opaque draws are sorted batch by batch, meshes
// (Blinn-Phong or physically based, by their material; cut-out ones among
// them) before lines, front to back by the distance from the camera to the
// nearest model origin of the batch, so nearer surfaces fill the depth
// buffer first and hide what is behind them before it is shaded. The sky
// comes next, where nothing was drawn (depth tested at the far plane). Then
// the see-through draws (a material whose alpha mode is ALPHA_BLEND, or a
// custom pipeline made so): sorted copy by copy, back to front by the
// distance to the centre of each copy's bounding sphere, blended with
// premultiplied alpha, depth tested against the opaque surfaces but not
// written. They are still instanced: a run of copies of one mesh in one
// material that lie next to each other in that order is one draw, its
// instances back to front (Vulkan draws an instanced draw's instances in
// order), so the order is right copy by copy, and copies that do not
// interleave with others (a row of lantern panes) stay one draw. Sorting
// is by object, not by triangle: one mesh's own see-through faces are drawn
// in its index order.
//
// Its files are one module, and only this one, the root, imports:
//
//   render.cone    Renderer and DrawList
//   gpumesh.cone   GpuMesh, mesh slots and handles, LodChain
//   material.cone  Material, material and texture slots and handles; lit.slang's and lines.slang's SPIR-V
//   custom.cone    CustomPipeline, pipeline slots and handles: the contract a custom pipeline keeps
//   skin.cone      Skin, the bones' layout, the CPU's twin of skinning.slang
//   lighting.cone  Sky, PbrMaterial, Environment; pbr.slang's and ibl.slang's SPIR-V
//   post.cone      Post: the HDR frame, bloom, tone mapping; post.slang's SPIR-V
//   camera.cone    Camera, Light
//   image.cone     Image
//
// and its shaders, Slang: lit, lines, pbr, ibl and post, and the modules
// brdf, sky, renderframe and skinning they import (pbr imports the noise
// package's too).
//
// Coordinates are geomath's and gpu's: right-handed, y up, the camera looking
// down its -z, clip space's y up and depth from 0 to 1. Faces wind
// counterclockwise seen from the front, as mesh's generators and sculpt's
// operators make them, and back faces are culled.

mod render;

import libc;
import gpu use *;
import geomath use *;
import collections use *;
import pool use *;
import mesh use Mesh, PolyMesh, Group;

// Report a problem to stderr
fn logLine(msg &[]u8) {
  mut m = String.from(msg);
  m.appendByte('\n');
  imm v &[]u8 = m.view();
  libc.fflush(libc.stdout());
  libc.fwrite(v as *u8, 1usize, v.len, libc.stderr());
}

// The whole of a file, or ok false when it cannot be opened
fn readFile(path &[]u8, ok &mut bool) String {
  mut text = String.empty();
  mut cpath = String.from(path);
  imm f = libc.fopen(cpath.cstr(), "rb");
  if !f {
    *ok = false;
    return text;
  }
  mut buf = new Array[u8, 4096] <- fill 0u8;
  mut going = true;
  while going {
    imm n = libc.fread(&mut buf[0], 1usize, 4096usize, f);
    if n > 0usize { text.append(&buf[..n]); }
    going = n == 4096usize;
  }
  libc.fclose(f);
  *ok = true;
  text;
}

// The bytes of the frame uniforms (renderframe.slang's Frame) and of the
// immediates
const FRAME_BYTES = 224u64;
const IMMEDIATE_BYTES = 80u32;
const MATERIAL_BYTES = 64u64;
// An instance's bytes (renderframe.slang's Instance: a model matrix and a
// tint) and how many the instance buffer holds at first
const INSTANCE_BYTES = 80u64;
const INSTANCE_FLOATS = 20usize;
const FIRST_INSTANCES = 1024u32;

// What a material slot holds: the Blinn-Phong material, or the physically
// based one
const MATERIAL_BLINN_PHONG = 0u32;
const MATERIAL_PBR = 1u32;
const MATERIAL_CUSTOM = 2u32;

// The pipelines a draw may be bound to
const BOUND_NONE = 0u32;
const BOUND_LIT = 1u32;
const BOUND_LINES = 2u32;
const BOUND_PBR = 3u32;
const BOUND_CUSTOM = 4u32;
const BOUND_LIT_SKINNED = 5u32;
const BOUND_PBR_SKINNED = 6u32;
const BOUND_LIT_BLEND = 7u32;
const BOUND_PBR_BLEND = 8u32;
const BOUND_LIT_SKINNED_BLEND = 9u32;
const BOUND_PBR_SKINNED_BLEND = 10u32;
const BOUND_PBR_SWAY = 11u32;

// The draw list's layers, in the order they are drawn: opaque meshes, then
// lines, then (after the sky) what is see-through
const LAYER_OPAQUE = 0u32;
const LAYER_LINES = 1u32;
const LAYER_BLEND = 2u32;

// What each render pass draws with: the renderer's pipelines, bind groups and
// the resources it hands out handles to
pub struct Renderer {
  pub colorFormat u32;             // the targets it draws into (TEXTURE_FORMAT_...)
  pub depthFormat u32;
  pub litShader ShaderModule;
  pub linesShader ShaderModule;
  pub frameLayout BindGroupLayout;
  pub materialLayout BindGroupLayout;
  pub layout PipelineLayout;
  pub litPipeline RenderPipeline;
  pub linesPipeline RenderPipeline;
  pub frameUniforms Buffer;
  pub frameGroup BindGroup;
  pub sampler Sampler;
  pub meshes Pool[MeshSlot];
  pub textures Pool[TextureSlot];
  pub materials Pool[MaterialSlot];
  pub white TextureHandle;         // 1 x 1, white: a material's texture when it has none
  pub pending List[MeshHandle];    // meshes replaced, to be swapped in at a frame's start
  pub drawCalls u32;               // how many draws the last render made
  pub triangles u64;               // and how many triangles (or lines) they drew
  pub pbrShader ShaderModule;
  pub environmentLayout BindGroupLayout;
  pub pbrLayout PipelineLayout;    // the frame, a material, the environment; the immediates
  pub pbrPipeline RenderPipeline;
  pub skyPipeline RenderPipeline;  // the sky behind the scene
  pub environment Environment;     // the image-based lighting made from the sky
  pub drawSky bool;                // draw the sky behind the scene ('setSky')
  pub time f32;                    // seconds: what the physically based material's film drifts by
  pub environmentStrength f32;     // how strongly the environment lights (1: as the sky is)
  pub pbrMaterialLayout BindGroupLayout;   // a physically based material's group: materialLayout's, then its three maps
  pub instances Buffer;            // every copy a render draws: its model matrix and tint (renderframe.slang's Instance)
  pub instanceCapacity u32;        // how many the buffer holds; grown by doubling
  pub instanceData List[f32];      // the copies' bytes, gathered on the CPU before one write
  pub keys List[DrawKey];          // the draw list's items sorted into batches
  pub batches List[DrawBatch];     // and the batches, in the order they are drawn
  pub instancesDrawn u32;          // how many copies the last render drew
  pub pipelines Pool[PipelineSlot];   // custom pipelines (custom.cone)
  pub litSkinnedPipeline RenderPipeline;   // the lit material, for a skinned mesh (lit.slang's vertexSkinned)
  pub pbrSkinnedPipeline RenderPipeline;   // and the physically based one (pbr.slang's)
  pub bones Buffer;                // every skinned copy's skinning matrices (skinning.slang's BoneXform)
  pub boneCapacity u32;            // how many it holds; grown by doubling
  pub boneBases Buffer;            // each instance's first bone, or NO_BONES; as many as the instances
  pub boneBaseData List[u32];      // gathered on the CPU before one write
  pub bonesDrawn u32;              // how many bones the last render wrote
  // The see-through (ALPHA_BLEND) variants of the lit and physically based
  // pipelines and of their skinned ones: blended with premultiplied alpha,
  // the depth tested, not written
  pub litBlendPipeline RenderPipeline;
  pub pbrBlendPipeline RenderPipeline;
  pub litSkinnedBlendPipeline RenderPipeline;
  pub pbrSkinnedBlendPipeline RenderPipeline;
  pub blendedDrawn u32;            // how many see-through copies the last render drew
  // The physically based pipeline for a mesh with a SWAY stream (gpumesh.cone)
  // drawn with a flutter material: a fourth vertex buffer, the colors
  pub pbrSwayPipeline RenderPipeline;
  // Store the depth buffer at the end of 'render' (it is discarded
  // otherwise), so that a later pass into the same target -- glowing
  // particles drawn additively, say -- is depth tested against the scene
  pub keepDepth bool = false;
  // What every material's output, the sky's and the background's are
  // multiplied by before they are written (pre-exposure: the frame then
  // holds numbers near 1 however bright the scene's units). 1 for a scene
  // lit in display units; 'exposureFromEv100' for one in physical units
  // (the light in lux, ambient, sky and emissive in nits).
  pub exposure f32 = 1.;

  // A renderer drawing into targets of 'colorFormat', with a depth texture
  // of 'depthFormat' (TEXTURE_FORMAT_DEPTH32_FLOAT). For physically based
  // lighting, 'colorFormat' is TEXTURE_FORMAT_RGBA16_FLOAT and the target a
  // Post's frame, which tone-maps it to the display. Check 'isValid'.
  pub fn create(device &mut Device, colorFormat u32, depthFormat u32) Renderer {
    mut litShader = device.createShaderModule(&LIT_SPIRV);
    mut linesShader = device.createShaderModule(&LINES_SPIRV);
    // The frame's group: its uniforms, the instances, the bones and the
    // instances' bone bases (read-only storage)
    imm frameEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT,
        bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE)];
    mut frameLayout = device.createBindGroupLayout(&frameEntries);
    imm materialEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    mut materialLayout = device.createBindGroupLayout(&materialEntries);
    imm groupLayouts = [&frameLayout, &materialLayout];
    mut layout = device.createPipelineLayout(&groupLayouts, IMMEDIATE_BYTES);

    // The physically based material and the sky: a third group, the
    // environment's (the sky's parameters, the diffuse and specular cubes,
    // the split sum's table, their sampler)
    mut pbrShader = device.createShaderModule(&PBR_SPIRV);
    imm environmentEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        viewDimension: TEXTURE_VIEW_DIMENSION_CUBE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        viewDimension: TEXTURE_VIEW_DIMENSION_CUBE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    mut environmentLayout = device.createBindGroupLayout(&environmentEntries);
    // A physically based material's own group: the parameters, the base
    // colour's texture and the sampler, as the lit material's, then the
    // metallic-roughness, normal and occlusion maps
    // (the parameters are read by the vertex stage too: flutter)
    imm pbrMaterialEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE)];
    mut pbrMaterialLayout = device.createBindGroupLayout(&pbrMaterialEntries);
    imm pbrGroupLayouts = [&frameLayout, &pbrMaterialLayout, &environmentLayout];
    mut pbrLayout = device.createPipelineLayout(&pbrGroupLayouts, IMMEDIATE_BYTES);

    // Lit: three vertex buffers (position, normal, uv), back faces culled,
    // depth tested and written
    imm positionAttr = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X3, 0u64, 0u32)];
    imm normalAttr = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X3, 0u64, 1u32)];
    imm uvAttr = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X2, 0u64, 2u32)];
    imm litBuffers = [new VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr),
      new VertexBufferLayout(arrayStride: 12u64, attributes: &normalAttr),
      new VertexBufferLayout(arrayStride: 8u64, attributes: &uvAttr)];
    imm litDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &litShader, buffers: &litBuffers,
      fragmentModule: &litShader, colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS);
    mut litPipeline = device.createRenderPipeline(&litDesc);

    // Lines: positions only, depth tested (less or equal) and written
    imm lineBuffers = [new VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr)];
    imm linesDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &linesShader, buffers: &lineBuffers,
      fragmentModule: &linesShader, colorFormat: colorFormat, topology: PRIMITIVE_TOPOLOGY_LINE_LIST,
      depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS_EQUAL);
    mut linesPipeline = device.createRenderPipeline(&linesDesc);

    // Physically based: the lit material's vertex buffers, culling and depth
    imm pbrDesc = new RenderPipelineDescriptor(layout: &pbrLayout, vertexModule: &pbrShader, buffers: &litBuffers,
      fragmentModule: &pbrShader, colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS);
    mut pbrPipeline = device.createRenderPipeline(&pbrDesc);
    // The same for a mesh with a sway stream, drawn with a flutter material:
    // the colors as a fourth buffer, read at location 3
    imm swayAttr = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 0u64, 3u32)];
    imm swayBuffers = [new VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr),
      new VertexBufferLayout(arrayStride: 12u64, attributes: &normalAttr),
      new VertexBufferLayout(arrayStride: 8u64, attributes: &uvAttr),
      new VertexBufferLayout(arrayStride: 16u64, attributes: &swayAttr)];
    imm pbrSwayDesc = new RenderPipelineDescriptor(layout: &pbrLayout, vertexModule: &pbrShader,
      vertexEntryPoint: "vertexSway", buffers: &swayBuffers, fragmentModule: &pbrShader, colorFormat: colorFormat,
      cullMode: CULL_MODE_BACK, depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS);
    mut pbrSwayPipeline = device.createRenderPipeline(&pbrSwayDesc);
    // Their skinned variants: the same three buffers, then the joints (four
    // bytes read as integers) and the weights (four bytes read as 0 to 1)
    imm jointsAttr = [new VertexAttribute(VERTEX_FORMAT_UINT8X4, 0u64, 3u32)];
    imm weightsAttr = [new VertexAttribute(VERTEX_FORMAT_UNORM8X4, 0u64, 4u32)];
    imm skinnedBuffers = [new VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr),
      new VertexBufferLayout(arrayStride: 12u64, attributes: &normalAttr),
      new VertexBufferLayout(arrayStride: 8u64, attributes: &uvAttr),
      new VertexBufferLayout(arrayStride: 4u64, attributes: &jointsAttr),
      new VertexBufferLayout(arrayStride: 4u64, attributes: &weightsAttr)];
    imm litSkinnedDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &litShader,
      vertexEntryPoint: "vertexSkinned", buffers: &skinnedBuffers, fragmentModule: &litShader, colorFormat: colorFormat,
      cullMode: CULL_MODE_BACK, depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS);
    mut litSkinnedPipeline = device.createRenderPipeline(&litSkinnedDesc);
    imm pbrSkinnedDesc = new RenderPipelineDescriptor(layout: &pbrLayout, vertexModule: &pbrShader,
      vertexEntryPoint: "vertexSkinned", buffers: &skinnedBuffers, fragmentModule: &pbrShader, colorFormat: colorFormat,
      cullMode: CULL_MODE_BACK, depthFormat: depthFormat, depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS);
    mut pbrSkinnedPipeline = device.createRenderPipeline(&pbrSkinnedDesc);
    // The see-through variants: the same, but blended with premultiplied
    // alpha (src + (1 - src alpha) x dst, the alpha likewise), the depth
    // tested and not written, so what is behind one pane still shows through
    // the next
    imm litBlendDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &litShader, buffers: &litBuffers,
      fragmentModule: &litShader, colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut litBlendPipeline = device.createRenderPipeline(&litBlendDesc);
    imm pbrBlendDesc = new RenderPipelineDescriptor(layout: &pbrLayout, vertexModule: &pbrShader, buffers: &litBuffers,
      fragmentModule: &pbrShader, colorFormat: colorFormat, cullMode: CULL_MODE_BACK,
      depthFormat: depthFormat, depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut pbrBlendPipeline = device.createRenderPipeline(&pbrBlendDesc);
    imm litSkinnedBlendDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &litShader,
      vertexEntryPoint: "vertexSkinned", buffers: &skinnedBuffers, fragmentModule: &litShader, colorFormat: colorFormat,
      cullMode: CULL_MODE_BACK, depthFormat: depthFormat, depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut litSkinnedBlendPipeline = device.createRenderPipeline(&litSkinnedBlendDesc);
    imm pbrSkinnedBlendDesc = new RenderPipelineDescriptor(layout: &pbrLayout, vertexModule: &pbrShader,
      vertexEntryPoint: "vertexSkinned", buffers: &skinnedBuffers, fragmentModule: &pbrShader, colorFormat: colorFormat,
      cullMode: CULL_MODE_BACK, depthFormat: depthFormat, depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut pbrSkinnedBlendPipeline = device.createRenderPipeline(&pbrSkinnedBlendDesc);
    // The sky: one triangle at the far plane, where nothing nearer was
    // drawn (depth tested less or equal against the cleared 1, not written)
    imm skyBuffers = [new VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr)];
    imm skyDesc = new RenderPipelineDescriptor(layout: &pbrLayout, vertexModule: &pbrShader,
      vertexEntryPoint: "backgroundVertex", buffers: &skyBuffers[..0], fragmentModule: &pbrShader,
      fragmentEntryPoint: "backgroundFragment", colorFormat: colorFormat, depthFormat: depthFormat,
      depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS_EQUAL);
    mut skyPipeline = device.createRenderPipeline(&skyDesc);

    mut frameUniforms = device.createBuffer(FRAME_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    mut instances = device.createBuffer(u64.from(FIRST_INSTANCES) * INSTANCE_BYTES,
      BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    mut bones = device.createBuffer(u64.from(FIRST_BONES) * BONE_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    mut boneBases = device.createBuffer(u64.from(FIRST_INSTANCES) * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    imm frameGroupEntries = [BindGroupEntry.buffer(0u32, &frameUniforms), BindGroupEntry.buffer(1u32, &instances),
      BindGroupEntry.buffer(2u32, &bones), BindGroupEntry.buffer(3u32, &boneBases)];
    mut frameGroup = device.createBindGroup(&frameLayout, &frameGroupEntries);
    // Trilinear, and anisotropic to 16 where the device does it (fewer
    // where it does less; none where it does none)
    imm samplerDesc = new SamplerDescriptor(mipmapFilter: FILTER_MODE_LINEAR, maxAnisotropy: 16u32);
    mut sampler = device.createSampler(&samplerDesc);
    imm dusk = Sky.dusk(radians(4.), radians(180.));
    mut environment = Environment.create(device, &environmentLayout, &dusk);

    mut r = new Renderer(colorFormat, depthFormat, litShader, linesShader, frameLayout, materialLayout, layout,
      litPipeline, linesPipeline, frameUniforms, frameGroup, sampler, Pool[MeshSlot].empty(),
      Pool[TextureSlot].empty(), Pool[MaterialSlot].empty(), TextureHandle.none(), List[MeshHandle].empty(),
      0u32, 0u64, pbrShader, environmentLayout, pbrLayout, pbrPipeline, skyPipeline, environment, false, 0., 1., pbrMaterialLayout,
      instances, FIRST_INSTANCES, List[f32].empty(), List[DrawKey].empty(), List[DrawBatch].empty(), 0u32,
      Pool[PipelineSlot].empty(), litSkinnedPipeline, pbrSkinnedPipeline, bones, FIRST_BONES, boneBases,
      List[u32].empty(), 0u32, litBlendPipeline, pbrBlendPipeline, litSkinnedBlendPipeline, pbrSkinnedBlendPipeline, 0u32,
      pbrSwayPipeline);
    mut w = new Image(1, 1, 3, List[u8].empty());
    w.pixels.push(255u8);
    w.pixels.push(255u8);
    w.pixels.push(255u8);
    r.white = r.addTexture(device, &w);
    r;
  }

  // Whether everything it draws with was made
  pub fn isValid(self &) bool {
    litPipeline.isValid() and linesPipeline.isValid() and frameGroup.isValid() and sampler.isValid()
      and frameUniforms.isValid() and pbrPipeline.isValid() and skyPipeline.isValid() and environment.isValid()
      and instances.isValid() and litSkinnedPipeline.isValid() and pbrSkinnedPipeline.isValid() and bones.isValid()
      and boneBases.isValid() and litBlendPipeline.isValid() and pbrBlendPipeline.isValid()
      and litSkinnedBlendPipeline.isValid() and pbrSkinnedBlendPipeline.isValid() and pbrSwayPipeline.isValid();
  }

  // The frame's group made again, after a buffer in it was replaced
  fn remakeFrameGroup(self &mut, device &mut Device) {
    imm entries = [BindGroupEntry.buffer(0u32, &frameUniforms), BindGroupEntry.buffer(1u32, &instances),
      BindGroupEntry.buffer(2u32, &bones), BindGroupEntry.buffer(3u32, &boneBases)];
    frameGroup = device.createBindGroup(&frameLayout, &entries);
  }

  // Draw 'sky' behind the scene from the next render on, and light the
  // physically based material by it: its environment is made again, on the
  // GPU, at the start of that render
  pub fn setSky(self &mut, device &mut Device, sky &Sky) {
    environment.setSky(device, sky);
    drawSky = true;
  }

  // ---- Meshes ----

  // A mesh of triangles to draw: its vertex streams and indices uploaded
  // now, and kept. Normals it lacks are made smooth; uvs it lacks are 0.
  pub fn addMesh(self &mut, device &mut Device, m &Mesh) MeshHandle {
    imm version = uploadTriangles(device, m);
    new MeshHandle(meshes.add(new MeshSlot(version, GpuMesh.none(), 0u32, false, 0u64, 0u32)));
  }

  // A skinned mesh to draw (skin.cone): 'm' as 'addMesh' takes it, and
  // 'skin', its vertices' joints and weights, one entry a vertex in 'm''s
  // order. Drawn by 'DrawList.addSkinned' with its bones; drawn as modelled
  // by 'add'. A skin of the wrong length leaves it an unskinned mesh.
  pub fn addSkinnedMesh(self &mut, device &mut Device, m &Mesh, skin &Skin) MeshHandle {
    imm version = uploadSkinned(device, m, skin);
    new MeshHandle(meshes.add(new MeshSlot(version, GpuMesh.none(), 0u32, false, 0u64, 0u32)));
  }

  // Whether 'h' names a skinned mesh
  pub fn isSkinned(self &, h MeshHandle) bool {
    meshes.alive(h.slot) and meshes[h.slot].current().isSkinned();
  }

  // The bounding sphere of the mesh 'h' as drawn, in its own coordinates
  // (a skinned mesh's made larger: SKINNED_BOUNDS_SCALE); a radius of 0 if
  // 'h' names none
  pub fn meshBounds(self &, h MeshHandle, center &mut Vec3, radius &mut f32) {
    if !meshes.alive(h.slot) {
      *center = new Vec3(0., 0., 0.);
      *radius = 0.;
      return;
    }
    imm m = meshes[h.slot].current();
    *center = m.center;
    *radius = m.radius;
  }

  // Lines to draw: 'positions', and 'indices' two to a line (a wireframe:
  // 'polyEdges' makes them of a PolyMesh's edges)
  pub fn addLines(self &mut, device &mut Device, positions &[]Vec3, indices &[]u32) MeshHandle {
    imm version = uploadLines(device, positions, indices);
    new MeshHandle(meshes.add(new MeshSlot(version, GpuMesh.none(), 0u32, false, 0u64, 0u32)));
  }

  // Replace what the mesh 'h' holds with 'm', under the same handle: 'm' is
  // uploaded now, and drawn from the next frame on (a frame's draws all see
  // one version); the old version's buffers are released then, and
  // destroyed once the GPU has finished the frames that drew them. Answers
  // false if 'h' names no mesh.
  pub fn replaceMesh(self &mut, device &mut Device, h MeshHandle, m &Mesh) bool {
    if !meshes.alive(h.slot) or meshes[h.slot].dynamicVertices > 0u32 { return false; }
    imm version = uploadTriangles(device, m);
    self.stage(device, h, version);
    true;
  }

  // The same for a skinned mesh, with its skin
  pub fn replaceSkinnedMesh(self &mut, device &mut Device, h MeshHandle, m &Mesh, skin &Skin) bool {
    if !meshes.alive(h.slot) or meshes[h.slot].dynamicVertices > 0u32 { return false; }
    imm version = uploadSkinned(device, m, skin);
    self.stage(device, h, version);
    true;
  }

  // The same for lines
  pub fn replaceLines(self &mut, device &mut Device, h MeshHandle, positions &[]Vec3, indices &[]u32) bool {
    if !meshes.alive(h.slot) { return false; }
    imm version = uploadLines(device, positions, indices);
    self.stage(device, h, version);
    true;
  }

  // Put 'version' into the slot of 'h' not being drawn, to be swapped in
  fn stage(self &mut, device &mut Device, h MeshHandle, version GpuMesh) {
    mut slot = &mut meshes[h.slot];
    // A replacement not yet swapped in is replaced itself: it was never drawn
    if slot.active == 0u32 {
      slot.b.release(&mut device.queue);
      slot.b = version;
    } else {
      slot.a.release(&mut device.queue);
      slot.a = version;
    }
    if !slot.pending { pending.push(h); }
    slot.pending = true;
    slot.pendingFrame = device.frameNumber;
  }

  // Take the mesh 'h' away: its buffers are released (destroyed once the
  // GPU has finished with them), and the handle reaches nothing
  pub fn removeMesh(self &mut, device &mut Device, h MeshHandle) bool {
    if !meshes.alive(h.slot) { return false; }
    {
      mut slot = &mut meshes[h.slot];
      slot.a.release(&mut device.queue);
      slot.b.release(&mut device.queue);
    }
    meshes.remove(h.slot);
  }

  // A dynamic mesh: room for 'maxVertices' vertices and 'maxIndices'
  // indices, filled frame by frame by 'writeDynamicMesh' (a flock's birds,
  // water's waves made on the CPU). Its buffers are written in place by
  // 'queue.writeBuffer', which the GPU runs after everything submitted
  // before it, so a write never lands under a frame still drawing the last
  // contents; it is drawn only once written.
  pub fn addDynamicMesh(self &mut, device &mut Device, maxVertices u32, maxIndices u32) MeshHandle {
    mut g = GpuMesh.none();
    imm usage = BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC;
    g.positions = device.createBuffer(u64.from(maxVertices) * 12u64, usage);
    g.normals = device.createBuffer(u64.from(maxVertices) * 12u64, usage);
    g.uvs = device.createBuffer(u64.from(maxVertices) * 8u64, usage);
    g.indices = device.createBuffer(u64.from(maxIndices) * 4u64,
      BUFFER_USAGE_INDEX | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    new MeshHandle(meshes.add(new MeshSlot(a: g, b: GpuMesh.none(), active: 0u32, pending: false, pendingFrame: 0u64,
      version: 0u32, dynamicVertices: maxVertices, dynamicIndices: maxIndices)));
  }

  // Fill the dynamic mesh 'h' with 'm' (normals made smooth if it has none,
  // uvs 0 if it has none), drawn by every render recorded after: write it
  // before the render that draws it, once a frame. False if 'h' is not a
  // dynamic mesh or 'm' does not fit its room.
  pub fn writeDynamicMesh(self &mut, device &mut Device, h MeshHandle, m &Mesh) bool {
    if !meshes.alive(h.slot) { return false; }
    imm n = m.positions.len();
    {
      imm slot = meshes[h.slot];
      if slot.dynamicVertices == 0u32 or n > usize.from(slot.dynamicVertices)
          or m.indices.len() > usize.from(slot.dynamicIndices) {
        return false;
      }
    }
    mut slot = &mut meshes[h.slot];
    if n == 0usize or m.indices.len() == 0usize {
      slot.a.indexCount = 0u32;
      return true;
    }
    device.queue.writeBuffer(&slot.a.positions, 0u64, bytesOf[Vec3](&m.positions), u64.from(n) * 12u64);
    if m.normals.len() == n {
      device.queue.writeBuffer(&slot.a.normals, 0u64, bytesOf[Vec3](&m.normals), u64.from(n) * 12u64);
    } else {
      mut withNormals = Mesh.empty();
      withNormals.append(m);
      withNormals.computeSmoothNormals();
      device.queue.writeBuffer(&slot.a.normals, 0u64, bytesOf[Vec3](&withNormals.normals), u64.from(n) * 12u64);
    }
    if m.uvs.len() == n {
      device.queue.writeBuffer(&slot.a.uvs, 0u64, bytesOf[Vec2](&m.uvs), u64.from(n) * 8u64);
    } else {
      device.queue.clearBuffer(&slot.a.uvs, 0u64, u64.from(n) * 8u64);
    }
    device.queue.writeBuffer(&slot.a.indices, 0u64, bytesOf[u32](&m.indices), u64.from(m.indices.len()) * 4u64);
    slot.a.vertexCount = u32.from(n);
    slot.a.indexCount = u32.from(m.indices.len());
    slot.a.groups.clear();
    if m.groups.len() == 0usize {
      slot.a.groups.push(new Group(0u32, slot.a.indexCount, 0u32));
    } else {
      mut i = 0usize;
      while i < m.groups.len() {
        slot.a.groups.push(*m.groups[i]);
        i = i + 1usize;
      }
    }
    boundingSphere(m.positions.view(), &mut slot.a.center, &mut slot.a.radius);
    true;
  }

  // Whether 'h' names a mesh
  pub fn hasMesh(self &, h MeshHandle) bool { meshes.alive(h.slot); }

  // How many times the mesh 'h' has had a replacement swapped in
  pub fn meshVersion(self &, h MeshHandle) u32 {
    if !meshes.alive(h.slot) { return 0u32; }
    meshes[h.slot].version;
  }

  // Swap in the replacements made in an earlier frame, releasing what they
  // replace. 'render' does this first; a program drawing no frame need not.
  pub fn update(self &mut, device &mut Device) {
    mut i = 0usize;
    mut kept = List[MeshHandle].empty();
    while i < pending.len() {
      imm h = *pending[i];
      if meshes.alive(h.slot) {
        mut slot = &mut meshes[h.slot];
        if slot.pending and device.frameNumber > slot.pendingFrame {
          if slot.active == 0u32 {
            slot.a.release(&mut device.queue);
            slot.active = 1u32;
          } else {
            slot.b.release(&mut device.queue);
            slot.active = 0u32;
          }
          slot.pending = false;
          slot.version = slot.version + 1u32;
        } elif slot.pending {
          kept.push(h);
        }
      }
      i = i + 1usize;
    }
    pending = kept;
  }

  // ---- Textures and materials ----

  // An image for materials to sample, handed to the GPU now: sRGB, four
  // channels (an RGB image's alpha opaque), its rows as the image has them,
  // bottom first, so a uv's v of 0 is its bottom row (mesh's uvs, v up)
  //
  // Every texture added here has its whole mip chain (mips.cone), made now,
  // so a surface seen small or at a slant is filtered, not aliased: colour
  // averaged in linear light.
  pub fn addTexture(self &mut, device &mut Device, img &Image) TextureHandle {
    self.addTextureAs(device, img, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, MIP_COLOUR, 0.5);
  }

  // The same for a card a material cuts out below 'cutoff' of its alpha (a
  // needle tuft, a leaf, a fence; ALPHA_MASK): the colour of each level is
  // averaged weighted by the alpha, and the alpha of each is raised until the
  // same share of its texels passes 'cutoff' as the base level's do, so the
  // card does not thin to nothing as it is seen from farther off (mips.cone)
  pub fn addCutoutTexture(self &mut, device &mut Device, img &Image, cutoff f32) TextureHandle {
    self.addTextureAs(device, img, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, MIP_CUTOUT, cutoff);
  }

  // The same, its bytes read as they are, not decoded from sRGB: for maps
  // that hold numbers rather than colours (glTF's metallic-roughness and
  // occlusion maps); each level averages the numbers. A normal map is
  // 'addNormalTexture'.
  pub fn addLinearTexture(self &mut, device &mut Device, img &Image) TextureHandle {
    self.addTextureAs(device, img, TEXTURE_FORMAT_RGBA8_UNORM, MIP_LINEAR, 0.5);
  }

  // A tangent-space normal map, read as it is like 'addLinearTexture', but
  // each level's vectors averaged and made unit length again, which
  // averaging the bytes would not do
  pub fn addNormalTexture(self &mut, device &mut Device, img &Image) TextureHandle {
    self.addTextureAs(device, img, TEXTURE_FORMAT_RGBA8_UNORM, MIP_NORMAL, 0.5);
  }

  fn addTextureAs(self &mut, device &mut Device, img &Image, format u32, kind u32, cutoff f32) TextureHandle {
    imm w = u32.from(img.width);
    imm h = u32.from(img.height);
    mut rgba = List[u8].withCapacity(usize.from(w * h * 4u32));
    mut p = 0usize;
    imm n = usize.from(img.width * img.height);
    while p < n {
      imm at = p * usize.from(img.channels);
      rgba.push(*img.pixels[at]);
      rgba.push(*img.pixels[at + 1usize]);
      rgba.push(*img.pixels[at + 2usize]);
      rgba.push(if img.channels == 4 {*img.pixels[at + 3usize];} else {255u8;});
      p = p + 1usize;
    }
    imm levels = if n > 0usize { mipLevelCount(w, h); } else { 1u32; };
    imm desc = new TextureDescriptor(w, h, format, TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST, levels);
    mut texture = device.createTexture(&desc);
    if n > 0usize {
      if levels > 1u32 {
        imm chain = buildMipsCut(&rgba, w, h, kind, cutoff);
        imm cv = chain.view();
        device.queue.writeTextureLevels(&texture, &cv[0] as *u8);
      } else {
        imm v = rgba.view();
        device.queue.writeTexture(&texture, &v[0] as *u8, w * 4u32);
      }
    }
    new TextureHandle(textures.add(new TextureSlot(texture)));
  }

  // A material to draw with: its parameters in a uniform buffer of its own,
  // bound with its texture (the white one if it has none) and the sampler
  pub fn addMaterial(self &mut, device &mut Device, material &Material) MaterialHandle {
    mut uniforms = device.createBuffer(MATERIAL_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    imm params = materialParams(material);
    device.queue.writeBuffer(&uniforms, 0u64, &params as *u8, MATERIAL_BYTES);
    mut th = material.texture;
    if !textures.alive(th.slot) { th = white; }
    imm view = textures[th.slot].texture.createView();
    imm entries = [BindGroupEntry.buffer(0u32, &uniforms), BindGroupEntry.texture(1u32, &view),
      BindGroupEntry.sampler(2u32, &sampler)];
    mut group = device.createBindGroup(&materialLayout, &entries);
    imm pbr = PbrMaterial.standard(material.baseColor, 0., 0.5);
    new MaterialHandle(materials.add(new MaterialSlot(*material, uniforms, group, MATERIAL_BLINN_PHONG, pbr,
      PipelineHandle.none(), material.alphaMode == ALPHA_BLEND)));
  }

  // A physically based material to draw with (pbr.slang), lit by the
  // directional light and the environment made from the sky
  pub fn addPbrMaterial(self &mut, device &mut Device, material &PbrMaterial) MaterialHandle {
    mut uniforms = device.createBuffer(PBR_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    imm params = pbrParams(material, self.mapNormalScale(material, material), self.mapOcclusionStrength(material, material));
    device.queue.writeBuffer(&uniforms, 0u64, &params as *u8, PBR_BYTES);
    imm view = textures[self.orWhite(material.texture).slot].texture.createView();
    imm mrView = textures[self.orWhite(material.metallicRoughnessTexture).slot].texture.createView();
    imm normalView = textures[self.orWhite(material.normalTexture).slot].texture.createView();
    imm occlusionView = textures[self.orWhite(material.occlusionTexture).slot].texture.createView();
    imm entries = [BindGroupEntry.buffer(0u32, &uniforms), BindGroupEntry.texture(1u32, &view),
      BindGroupEntry.sampler(2u32, &sampler), BindGroupEntry.texture(3u32, &mrView),
      BindGroupEntry.texture(4u32, &normalView), BindGroupEntry.texture(5u32, &occlusionView)];
    mut group = device.createBindGroup(&pbrMaterialLayout, &entries);
    imm plain = Material.plain(material.baseColor);
    new MaterialHandle(materials.add(new MaterialSlot(plain, uniforms, group, MATERIAL_PBR, *material,
      PipelineHandle.none(), material.alphaMode == ALPHA_BLEND)));
  }

  // Change a physically based material's parameters (not its textures,
  // which stay those it was added with), from the next submission on
  pub fn setPbrMaterial(self &mut, device &mut Device, h MaterialHandle, material &PbrMaterial) bool {
    if !materials.alive(h.slot) { return false; }
    imm bound = materials[h.slot].pbr;
    imm params = pbrParams(material, self.mapNormalScale(&bound, material), self.mapOcclusionStrength(&bound, material));
    mut slot = &mut materials[h.slot];
    if slot.kind != MATERIAL_PBR { return false; }
    device.queue.writeBuffer(&slot.uniforms, 0u64, &params as *u8, PBR_BYTES);
    slot.pbr = *material;
    slot.pbr.texture = bound.texture;
    slot.pbr.metallicRoughnessTexture = bound.metallicRoughnessTexture;
    slot.pbr.normalTexture = bound.normalTexture;
    slot.pbr.occlusionTexture = bound.occlusionTexture;
    slot.blend = material.alphaMode == ALPHA_BLEND;
    true;
  }

  // The texture 'h', or the white one if it reaches nothing
  fn orWhite(self &, h TextureHandle) TextureHandle {
    if textures.alive(h.slot) { h; } else { white; };
  }

  // The normal map's scale 'm' asks for, or 0 if 'bound' (the textures its
  // group holds) has no normal map; and the occlusion map's strength
  fn mapNormalScale(self &, bound &PbrMaterial, m &PbrMaterial) f32 {
    if textures.alive(bound.normalTexture.slot) { m.normalScale; } else { 0.; };
  }
  fn mapOcclusionStrength(self &, bound &PbrMaterial, m &PbrMaterial) f32 {
    if textures.alive(bound.occlusionTexture.slot) { m.occlusionStrength; } else { 0.; };
  }

  // Change a material's color, shine, glow and alpha mode (not its
  // texture), from the next submission on
  pub fn setMaterial(self &mut, device &mut Device, h MaterialHandle, material &Material) bool {
    if !materials.alive(h.slot) { return false; }
    imm params = materialParams(material);
    mut slot = &mut materials[h.slot];
    if slot.kind != MATERIAL_BLINN_PHONG { return false; }
    device.queue.writeBuffer(&slot.uniforms, 0u64, &params as *u8, MATERIAL_BYTES);
    slot.params.baseColor = material.baseColor;
    slot.params.specular = material.specular;
    slot.params.shininess = material.shininess;
    slot.params.emissive = material.emissive;
    slot.params.alphaMode = material.alphaMode;
    slot.params.alphaCutoff = material.alphaCutoff;
    slot.blend = material.alphaMode == ALPHA_BLEND;
    true;
  }

  // ---- Custom pipelines (custom.cone) ----

  // A pipeline of the caller's own shaders, which materials made by
  // 'addCustomMaterial' are drawn with (custom.cone has the contract its
  // shaders keep). 'hasPipeline' says whether it was made.
  pub fn addPipeline(self &mut, device &mut Device, desc &CustomPipeline) PipelineHandle {
    mut shader = device.createShaderModule(desc.spirv);
    imm stages = SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT;
    mut entries = List[BindGroupLayoutEntry].empty();
    entries.push(new BindGroupLayoutEntry(binding: 0u32, visibility: stages));
    mut t = 0usize;
    while t < desc.textures.len {
      entries.push(new BindGroupLayoutEntry(binding: u32.from(t) + 1u32, visibility: stages, kind: BINDING_KIND_TEXTURE,
        sampleType: desc.textures[t]));
      t = t + 1usize;
    }
    entries.push(new BindGroupLayoutEntry(binding: u32.from(t) + 1u32, visibility: stages, kind: BINDING_KIND_SAMPLER));
    mut materialLayout = device.createBindGroupLayout(entries.view());
    mut layout = if desc.environment {
      imm groups = [&frameLayout, &materialLayout, &environmentLayout];
      device.createPipelineLayout(&groups, IMMEDIATE_BYTES);
    } else {
      imm groups = [&frameLayout, &materialLayout];
      device.createPipelineLayout(&groups, IMMEDIATE_BYTES);
    };
    imm positionAttr = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X3, 0u64, 0u32)];
    imm normalAttr = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X3, 0u64, 1u32)];
    imm uvAttr = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X2, 0u64, 2u32)];
    imm buffers = [new VertexBufferLayout(arrayStride: 12u64, attributes: &positionAttr),
      new VertexBufferLayout(arrayStride: 12u64, attributes: &normalAttr),
      new VertexBufferLayout(arrayStride: 8u64, attributes: &uvAttr)];
    imm streams = if desc.streams < 1u32 { 1usize; } elif desc.streams > 3u32 { 3usize; } else { usize.from(desc.streams); };
    // See-through: premultiplied alpha, the depth tested but not written
    imm blend = desc.alphaMode == ALPHA_BLEND;
    imm dstFactor = if blend { BLEND_FACTOR_ONE_MINUS_SRC_ALPHA; } else { BLEND_FACTOR_ZERO; };
    imm pipelineDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader,
      vertexEntryPoint: desc.vertexEntryPoint, buffers: &buffers[..streams], fragmentModule: &shader,
      fragmentEntryPoint: desc.fragmentEntryPoint, colorFormat: colorFormat, cullMode: desc.cullMode,
      depthFormat: depthFormat, depthWriteEnabled: desc.depthWrite and !blend, depthCompare: COMPARE_FUNCTION_LESS,
      blendEnabled: blend, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: dstFactor,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: dstFactor);
    mut pipeline = device.createRenderPipeline(&pipelineDesc);
    new PipelineHandle(pipelines.add(new PipelineSlot(shader, materialLayout, layout, pipeline, u32.from(desc.textures.len),
      desc.paramBytes, desc.environment, blend)));
  }

  // Whether 'h' names a pipeline that was made
  pub fn hasPipeline(self &, h PipelineHandle) bool {
    pipelines.alive(h.slot) and pipelines[h.slot].pipeline.isValid();
  }

  // A material drawn with the custom pipeline 'pipeline': its parameters
  // 'params' (at most the pipeline's paramBytes; the rest 0) in a uniform
  // buffer of its own, and 'maps', its textures, as many as the pipeline binds (a
  // missing one is the white texture). None if 'pipeline' was not made.
  pub fn addCustomMaterial(self &mut, device &mut Device, pipeline PipelineHandle, params &[]f32,
      maps &[]TextureHandle) MaterialHandle {
    if !self.hasPipeline(pipeline) { return MaterialHandle.none(); }
    imm bytes = pipelines[pipeline.slot].paramBytes;
    imm count = pipelines[pipeline.slot].textureCount;
    mut uniforms = device.createBuffer(bytes, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    self.writeParams(device, &uniforms, bytes, params);
    mut views = List[TextureView].empty();
    mut t = 0u32;
    while t < count {
      mut th = TextureHandle.none();
      if usize.from(t) < maps.len { th = maps[usize.from(t)]; }
      views.push(textures[self.orWhite(th).slot].texture.createView());
      t = t + 1u32;
    }
    mut entries = List[BindGroupEntry].empty();
    entries.push(BindGroupEntry.buffer(0u32, &uniforms));
    t = 0u32;
    while t < count {
      entries.push(BindGroupEntry.texture(t + 1u32, views[usize.from(t)]));
      t = t + 1u32;
    }
    entries.push(BindGroupEntry.sampler(count + 1u32, &sampler));
    mut group = device.createBindGroup(&pipelines[pipeline.slot].materialLayout, entries.view());
    imm plain = Material.plain(new Color(1., 1., 1., 1.));
    imm pbr = PbrMaterial.standard(plain.baseColor, 0., 0.5);
    imm blend = pipelines[pipeline.slot].blend;
    new MaterialHandle(materials.add(new MaterialSlot(plain, uniforms, group, MATERIAL_CUSTOM, pbr, pipeline, blend)));
  }

  // Change a custom material's parameters, from the next submission on
  // (its textures stay those it was made with): a water's time, say
  pub fn setCustomParams(self &mut, device &mut Device, h MaterialHandle, params &[]f32) bool {
    if !materials.alive(h.slot) { return false; }
    imm slot = materials[h.slot];
    if slot.kind != MATERIAL_CUSTOM { return false; }
    self.writeParams(device, &slot.uniforms, slot.uniforms.size, params);
    true;
  }

  // Write 'params' into the first of 'bytes' bytes of 'uniforms', the rest 0
  fn writeParams(self &, device &mut Device, uniforms &Buffer, bytes u64, params &[]f32) {
    mut data = List[f32].empty();
    imm n = usize.from(bytes / 4u64);
    mut i = 0usize;
    while i < n {
      data.push(if i < params.len { params[i]; } else { 0.; });
      i = i + 1usize;
    }
    if n > 0usize {
      imm v = data.view();
      device.queue.writeBuffer(uniforms, 0u64, &v[0] as *u8, bytes);
    }
  }

  // A field for a custom material to read: 'width' by 'height' numbers, one
  // f32 a texel (r32float), row by row from its first, handed to the GPU
  // now. Not every GPU filters r32float, so a shader reads it texel by
  // texel ('Load'), and its pipeline binds it as
  // TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT. A heightfield, say.
  pub fn addFieldTexture(self &mut, device &mut Device, width u32, height u32, values &[]f32) TextureHandle {
    imm desc = new TextureDescriptor(width, height, TEXTURE_FORMAT_R32_FLOAT,
      TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST);
    mut texture = device.createTexture(&desc);
    if values.len >= usize.from(width * height) and values.len > 0usize {
      device.queue.writeTexture(&texture, &values[0] as *u8, width * 4u32);
    }
    new TextureHandle(textures.add(new TextureSlot(texture)));
  }

  // Write all of the field 'h' again from 'values' (as many as it has),
  // ahead of the next submission: a field that changes frame by frame
  pub fn writeFieldTexture(self &mut, device &mut Device, h TextureHandle, values &[]f32) bool {
    if !textures.alive(h.slot) { return false; }
    imm slot = textures[h.slot];
    imm width = slot.texture.width;
    if slot.texture.format != TEXTURE_FORMAT_R32_FLOAT or values.len < usize.from(width * slot.texture.height) {
      return false;
    }
    device.queue.writeTexture(&slot.texture, &values[0] as *u8, width * 4u32);
    true;
  }

  // ---- Drawing ----

  // Record one render pass drawing 'list' into 'target' (a texture of the
  // renderer's color format: a swapchain's, one the device made, or a
  // Post's frame), with 'depth' (the renderer's depth format, of the
  // target's size) cleared first, seen by 'camera' and lit by 'light'. The
  // target is cleared to the camera's background, and the sky drawn behind
  // the scene if one is set ('setSky'). Replacements made in an earlier
  // frame are swapped in first; the environment is made again first if the
  // sky has changed and something needs it. A draw whose mesh has been
  // removed is skipped. The frame's uniforms are one buffer, written by
  // 'queue.writeBuffer' ahead of the frame's next submission, so the passes
  // of one submission share one camera and light (a buffer a view is the
  // step when there are views).
  pub fn render(self &mut, device &mut Device, encoder &mut CommandEncoder, target &Texture, depth &Texture,
      camera &Camera, light &Light, list &DrawList) {
    self.update(device);
    drawCalls = 0u32;
    triangles = 0u64;
    instancesDrawn = 0u32;
    if target.width == 0u32 or target.height == 0u32 { return; }
    if drawSky or self.drawsPbr(list) { environment.bake(encoder); }

    // The frame's uniforms: the camera and the light
    imm aspect = f32.from(target.width) / f32.from(target.height);
    imm viewProjection = camera.projectionMatrix(aspect) * camera.viewMatrix();
    imm inverse = viewProjection.inverse();
    imm eye = camera.position();
    imm towards = new Vec3(0., 0., 0.) - light.direction;
    mut frame = new Array[f32, 56] <- fill 0f;
    mut k = 0usize;
    while k < 16usize {
      frame[k] = viewProjection.m[k];
      k = k + 1usize;
    }
    frame[16] = eye.x;
    frame[17] = eye.y;
    frame[18] = eye.z;
    frame[19] = 1.;
    frame[20] = towards.x;
    frame[21] = towards.y;
    frame[22] = towards.z;
    frame[24] = light.color.red;
    frame[25] = light.color.green;
    frame[26] = light.color.blue;
    frame[27] = 1.;
    frame[28] = light.ambient.red;
    frame[29] = light.ambient.green;
    frame[30] = light.ambient.blue;
    frame[31] = 1.;
    k = 0usize;
    while k < 16usize {
      frame[32usize + k] = inverse.m[k];
      k = k + 1usize;
    }
    frame[48] = f32.from(target.width);
    frame[49] = f32.from(target.height);
    frame[50] = time;
    frame[51] = environmentStrength;
    frame[52] = exposure;
    device.queue.writeBuffer(&frameUniforms, 0u64, &frame as *u8, FRAME_BYTES);

    // The batches, front to back, and their instances and bones written
    self.gatherBatches(list, eye);
    self.writeInstances(device, list);
    self.writeBones(device, list);

    // The background is light too: exposed like the rest
    imm bg = camera.background;
    imm clear = new Color(bg.red * exposure, bg.green * exposure, bg.blue * exposure, bg.alpha);
    imm color = new RenderPassColorAttachment(view: target.createView(), clearValue: clear);
    imm depthStore = if keepDepth { STORE_OP_STORE; } else { STORE_OP_DISCARD; };
    imm depthAttachment = new RenderPassDepthStencilAttachment(view: depth.createView(), depthStoreOp: depthStore);
    mut pass = encoder.beginRenderPassWithDepth(&color, &depthAttachment);
    mut bound = BOUND_NONE;
    mut boundMaterial = Ref[MaterialSlot].none();
    mut boundPipeline = Ref[PipelineSlot].none();
    mut skyDrawn = !drawSky;
    blendedDrawn = 0u32;
    mut b = 0usize;
    while b < batches.len() {
      imm batch = *batches[b];
      // The sky, where nothing opaque was drawn, before anything
      // see-through (which writes no depth for it to be tested against)
      if batch.layer == LAYER_BLEND and !skyDrawn {
        self.recordSky(&mut pass);
        skyDrawn = true;
        bound = BOUND_NONE;
        boundMaterial = Ref[MaterialSlot].none();
      }
      imm first = *keys[usize.from(batch.first)];
      imm item = list.items[usize.from(first.item)];
      // gatherBatches kept only items whose mesh (and material) are alive
      imm slot = meshes[item.mesh.slot];
      imm m = slot.current();
      imm lines = batch.layer == LAYER_LINES;
      imm blend = batch.layer == LAYER_BLEND;
      mut skinned = false;
      mut sway = false;
      if lines {
        if bound != BOUND_LINES {
          pass.setPipeline(&linesPipeline);
          pass.setBindGroup(0u32, &frameGroup);
          bound = BOUND_LINES;
        }
        // A line's model matrix and color in the immediates
        mut immediates = new Array[f32, 20] <- fill 0f;
        k = 0usize;
        while k < 16usize {
          immediates[k] = item.model.m[k];
          k = k + 1usize;
        }
        immediates[16] = item.tint.red;
        immediates[17] = item.tint.green;
        immediates[18] = item.tint.blue;
        immediates[19] = item.tint.alpha;
        pass.setImmediates(0u32, &immediates as *u8, IMMEDIATE_BYTES);
      } else {
        // The material's kind chooses the pipeline
        imm mslot = materials[item.material.slot];
        if mslot.kind == MATERIAL_CUSTOM {
          if bound != BOUND_CUSTOM or !(boundPipeline == mslot.pipeline.slot) {
            imm ps = pipelines[mslot.pipeline.slot];
            pass.setPipeline(&ps.pipeline);
            pass.setBindGroup(0u32, &frameGroup);
            if ps.environment { pass.setBindGroup(2u32, &environment.group); }
            bound = BOUND_CUSTOM;
            boundPipeline = mslot.pipeline.slot;
            boundMaterial = Ref[MaterialSlot].none();
          }
        } elif mslot.kind == MATERIAL_PBR {
          // A skinned mesh is drawn by the pipeline's skinned variant, a
          // see-through one by its blended variant
          skinned = m.isSkinned();
          // A flutter material on a mesh that carries its leaves' data
          sway = !blend and !skinned and mslot.pbr.flutter > 0. and m.sway.isValid();
          imm want = if blend {
            if skinned { BOUND_PBR_SKINNED_BLEND; } else { BOUND_PBR_BLEND; };
          } else {
            if skinned { BOUND_PBR_SKINNED; } elif sway { BOUND_PBR_SWAY; } else { BOUND_PBR; };
          };
          if bound != want {
            if want == BOUND_PBR { pass.setPipeline(&pbrPipeline); }
            elif want == BOUND_PBR_SWAY { pass.setPipeline(&pbrSwayPipeline); }
            elif want == BOUND_PBR_SKINNED { pass.setPipeline(&pbrSkinnedPipeline); }
            elif want == BOUND_PBR_BLEND { pass.setPipeline(&pbrBlendPipeline); }
            else { pass.setPipeline(&pbrSkinnedBlendPipeline); }
            pass.setBindGroup(0u32, &frameGroup);
            pass.setBindGroup(2u32, &environment.group);
            bound = want;
            boundMaterial = Ref[MaterialSlot].none();
          }
        } else {
          skinned = m.isSkinned();
          imm want = if blend {
            if skinned { BOUND_LIT_SKINNED_BLEND; } else { BOUND_LIT_BLEND; };
          } else {
            if skinned { BOUND_LIT_SKINNED; } else { BOUND_LIT; };
          };
          if bound != want {
            if want == BOUND_LIT { pass.setPipeline(&litPipeline); }
            elif want == BOUND_LIT_SKINNED { pass.setPipeline(&litSkinnedPipeline); }
            elif want == BOUND_LIT_BLEND { pass.setPipeline(&litBlendPipeline); }
            else { pass.setPipeline(&litSkinnedBlendPipeline); }
            pass.setBindGroup(0u32, &frameGroup);
            bound = want;
            boundMaterial = Ref[MaterialSlot].none();
          }
        }
        if !(boundMaterial == item.material.slot) {
          pass.setBindGroup(1u32, &mslot.group);
          boundMaterial = item.material.slot;
        }
      }
      pass.setVertexBuffer(0u32, &m.positions, 0u64);
      if !lines {
        pass.setVertexBuffer(1u32, &m.normals, 0u64);
        pass.setVertexBuffer(2u32, &m.uvs, 0u64);
      }
      if sway { pass.setVertexBuffer(3u32, &m.sway, 0u64); }
      if skinned {
        pass.setVertexBuffer(3u32, &m.joints, 0u64);
        pass.setVertexBuffer(4u32, &m.weights, 0u64);
      }
      pass.setIndexBuffer(&m.indices, INDEX_FORMAT_UINT32, 0u64);
      // One draw a material group of the mesh, for every copy in the batch
      mut g = 0usize;
      while g < m.groups.len() {
        imm group = m.groups[g];
        if lines {
          pass.drawIndexed(group.count, 1u32, group.start, 0i32, 0u32);
          triangles = triangles + u64.from(group.count / 2u32);
        } else {
          pass.drawIndexed(group.count, batch.count, group.start, 0i32, batch.firstInstance);
          triangles = triangles + u64.from(group.count / 3u32) * u64.from(batch.count);
        }
        drawCalls = drawCalls + 1u32;
        g = g + 1usize;
      }
      instancesDrawn = instancesDrawn + batch.count;
      if blend { blendedDrawn = blendedDrawn + batch.count; }
      b = b + 1usize;
    }
    // The sky, where nothing was drawn, if nothing see-through came
    if !skyDrawn { self.recordSky(&mut pass); }
    pass.end();
  }

  // Draw the sky into 'pass': one triangle at the far plane, where nothing
  // nearer was drawn
  fn recordSky(self &mut, pass &mut RenderPass) {
    pass.setPipeline(&skyPipeline);
    pass.setBindGroup(0u32, &frameGroup);
    pass.setBindGroup(2u32, &environment.group);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    drawCalls = drawCalls + 1u32;
  }

  // Whether 'list' draws a mesh with a physically based material
  fn drawsPbr(self &, list &DrawList) bool {
    mut i = 0usize;
    while i < list.items.len() {
      imm item = list.items[i];
      if materials.alive(item.material.slot) {
        imm mslot = materials[item.material.slot];
        if mslot.kind == MATERIAL_PBR { return true; }
        if mslot.kind == MATERIAL_CUSTOM and pipelines.alive(mslot.pipeline.slot) {
          if pipelines[mslot.pipeline.slot].environment { return true; }
        }
      }
      i = i + 1usize;
    }
    false;
  }

  // Gather 'list's items into 'batches', in the order they are drawn: an
  // item of a mesh and material that are alive gets a key, in its layer
  // (opaque meshes, lines, see-through); the keys are sorted by layer, then
  // the opaque ones and lines by (material, mesh, distance), so each run of
  // one material and one mesh is a batch (a line is a batch of its own), and
  // the see-through ones by distance alone, farthest from the camera at
  // 'eye' first, each copy by the centre of its bounding sphere where the
  // copy puts it (a large pane is mis-sorted by its origin), so a batch of
  // them is a run of copies of one mesh and material that are next to each
  // other in that order. The batches are then sorted by layer, the opaque
  // ones and lines nearest first (by the nearest of their models' origins),
  // so nearer surfaces fill the depth buffer first; the see-through ones keep
  // their order, back to front.
  fn gatherBatches(self &mut, list &DrawList, eye Vec3) {
    keys.clear();
    batches.clear();
    imm n = list.items.len();
    mut i = 0usize;
    while i < n {
      imm item = list.items[i];
      if meshes.alive(item.mesh.slot) {
        imm m = meshes[item.mesh.slot].current();
        if m.isValid() {
          if m.topology == PRIMITIVE_TOPOLOGY_LINE_LIST {
            imm d = item.model.translation().distanceSquared(eye);
            keys.push(new DrawKey(LAYER_LINES, u32.from(i), item.mesh.slot.slot(), u32.from(i), d));
          } elif materials.alive(item.material.slot) {
            if materials[item.material.slot].blend {
              imm d = (item.model * m.center).distanceSquared(eye);
              keys.push(new DrawKey(LAYER_BLEND, item.material.slot.slot(), item.mesh.slot.slot(), u32.from(i), d));
            } else {
              imm d = item.model.translation().distanceSquared(eye);
              keys.push(new DrawKey(LAYER_OPAQUE, item.material.slot.slot(), item.mesh.slot.slot(), u32.from(i), d));
            }
          }
        }
      }
      i = i + 1usize;
    }
    keys.sortBy(&byBatch);
    // Runs of one material and mesh
    mut k = 0usize;
    while k < keys.len() {
      imm first = *keys[k];
      mut end = k + 1usize;
      while end < keys.len() and keys[end].layer == first.layer and keys[end].material == first.material
          and keys[end].mesh == first.mesh {
        end = end + 1usize;
      }
      // The keys of a run are sorted nearest first (or, see-through,
      // farthest first)
      batches.push(new DrawBatch(u32.from(k), u32.from(end - k), 0u32, first.distance, first.layer, u32.from(k)));
      k = end;
    }
    batches.sortBy(&byDistance);
  }

  // Write every batch's copies (model matrix and tint) into the instance
  // buffer side by side, in the order the batches are drawn, and give each
  // batch its first instance; the buffer is made larger first if it must be
  fn writeInstances(self &mut, device &mut Device, list &DrawList) {
    instanceData.clear();
    boneBaseData.clear();
    mut count = 0u32;
    mut b = 0usize;
    while b < batches.len() {
      mut batch = *batches[b];
      batch.firstInstance = count;
      batches.set(b, batch);
      mut j = 0u32;
      while j < batch.count {
        imm item = list.items[usize.from(keys[usize.from(batch.first + j)].item)];
        mut e = 0usize;
        while e < 16usize {
          instanceData.push(item.model.m[e]);
          e = e + 1usize;
        }
        instanceData.push(item.tint.red);
        instanceData.push(item.tint.green);
        instanceData.push(item.tint.blue);
        instanceData.push(item.tint.alpha);
        boneBaseData.push(item.bones);
        j = j + 1u32;
      }
      count = count + batch.count;
      b = b + 1usize;
    }
    if count == 0u32 { return; }
    if count > instanceCapacity {
      mut capacity = instanceCapacity;
      while capacity < count { capacity = capacity * 2u32; }
      device.queue.releaseBuffer(&mut instances);
      instances = device.createBuffer(u64.from(capacity) * INSTANCE_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
      device.queue.releaseBuffer(&mut boneBases);
      boneBases = device.createBuffer(u64.from(capacity) * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
      instanceCapacity = capacity;
      self.remakeFrameGroup(device);
    }
    imm v = instanceData.view();
    device.queue.writeBuffer(&instances, 0u64, &v[0] as *u8, u64.from(count) * INSTANCE_BYTES);
    imm bv = boneBaseData.view();
    device.queue.writeBuffer(&boneBases, 0u64, &bv[0] as *u8, u64.from(count) * 4u64);
  }

  // Write the draw list's bones (every skinned copy's skinning matrices,
  // side by side) into the bone buffer, made larger first if it must be
  fn writeBones(self &mut, device &mut Device, list &DrawList) {
    imm count = u32.from(list.bones.len() / BONE_FLOATS);
    bonesDrawn = count;
    if count == 0u32 { return; }
    if count > boneCapacity {
      mut capacity = boneCapacity;
      while capacity < count { capacity = capacity * 2u32; }
      device.queue.releaseBuffer(&mut bones);
      bones = device.createBuffer(u64.from(capacity) * BONE_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
      boneCapacity = capacity;
      self.remakeFrameGroup(device);
    }
    imm v = list.bones.view();
    device.queue.writeBuffer(&bones, 0u64, &v[0] as *u8, u64.from(count) * BONE_BYTES);
  }
}

// An item of the draw list, as batching sorts it
pub struct DrawKey {
  layer u32;                   // LAYER_OPAQUE, LAYER_LINES (each alone) or LAYER_BLEND
  material u32;                // its material's slot (a line: its own index, so it batches with nothing)
  mesh u32;                    // its mesh's slot
  item u32;                    // its index in the draw list
  // Its distance from the eye, squared: its model's origin's, or, if it is
  // see-through, its bounding sphere's centre's
  distance f32;
}

// One instanced draw: 'count' keys from 'first', drawn as the instances
// from 'firstInstance' in the instance buffer
pub struct DrawBatch {
  first u32;
  count u32;
  firstInstance u32;
  distance f32;                // its nearest copy's distance from the eye, squared (see-through: its farthest's)
  layer u32;
  order u32;                   // its first key's place among the sorted keys
}

fn byBatch(a &DrawKey, b &DrawKey) i32 {
  if a.layer != b.layer { return if a.layer < b.layer { -1i32; } else { 1i32; }; }
  if a.layer == LAYER_BLEND {
    // Back to front, copy by copy; ties by the item's place in the list
    if a.distance > b.distance { return -1i32; }
    if a.distance < b.distance { return 1i32; }
    return if a.item < b.item { -1i32; } elif a.item > b.item { 1i32; } else { 0i32; };
  }
  if a.material != b.material { return if a.material < b.material { -1i32; } else { 1i32; }; }
  if a.mesh != b.mesh { return if a.mesh < b.mesh { -1i32; } else { 1i32; }; }
  if a.distance < b.distance { return -1i32; }
  if a.distance > b.distance { return 1i32; }
  0i32;
}

fn byDistance(a &DrawBatch, b &DrawBatch) i32 {
  if a.layer != b.layer { return if a.layer < b.layer { -1i32; } else { 1i32; }; }
  if a.layer == LAYER_BLEND {
    // Kept in the keys' order, back to front
    return if a.order < b.order { -1i32; } elif a.order > b.order { 1i32; } else { 0i32; };
  }
  if a.distance < b.distance { return -1i32; }
  if a.distance > b.distance { return 1i32; }
  0i32;
}

// A material's parameters as lit.slang's MaterialParams has them
fn materialParams(material &Material) Array[f32, 16] {
  [material.baseColor.red, material.baseColor.green, material.baseColor.blue, material.baseColor.alpha,
    material.specular.red, material.specular.green, material.specular.blue, material.shininess,
    material.emissive.red, material.emissive.green, material.emissive.blue, 0.,
    f32.from(material.alphaMode), material.alphaCutoff, 0., 0.];
}

// What a draw list holds: a mesh, the material it is drawn with (not used
// by lines), where it is ('model', its coordinates into the world's), and a
// tint its color is multiplied by (the color of lines); and, for a skinned
// copy, its first bone in the list's 'bones' (NO_BONES for none)
pub struct DrawItem {
  pub mesh MeshHandle;
  pub material MaterialHandle;
  pub model Mat4;
  pub tint Color;
  pub bones u32 = NO_BONES;
}

// What a render pass draws: its items, and the skinned ones' bones, each
// bone a skinning matrix as the bone buffer holds it (skin.cone's
// 'boneRows', BONE_FLOATS floats), each item's run side by side
pub struct DrawList {
  pub items List[DrawItem];
  pub bones List[f32];

  pub fn empty() DrawList { new DrawList(List[DrawItem].empty(), List[f32].empty()); }

  pub fn clear(self &mut) {
    items.clear();
    bones.clear();
  }
  pub fn len(self &) usize { items.len(); }

  // How many bones it holds
  pub fn boneCount(self &) usize { bones.len() / BONE_FLOATS; }

  // Draw the skinned mesh 'mesh' ('Renderer.addSkinnedMesh') with
  // 'material', placed by 'model', posed by 'pose': its skinning matrices,
  // one a bone of its skin's skeleton, in the model's coordinates (skin.cone)
  pub fn addSkinned(self &mut, mesh MeshHandle, material MaterialHandle, model Mat4, pose &[]Mat4) {
    self.addSkinnedTinted(mesh, material, model, new Color(1., 1., 1., 1.), pose);
  }

  // The same, its color multiplied by 'tint'
  pub fn addSkinnedTinted(self &mut, mesh MeshHandle, material MaterialHandle, model Mat4, tint Color, pose &[]Mat4) {
    imm first = u32.from(bones.len() / BONE_FLOATS);
    mut b = 0usize;
    while b < pose.len {
      imm rows = boneRows(pose[b]);
      mut e = 0usize;
      while e < BONE_FLOATS {
        bones.push(rows[e]);
        e = e + 1usize;
      }
      b = b + 1usize;
    }
    items.push(new DrawItem(mesh, material, model, tint, first));
  }

  // Draw 'mesh' with 'material', placed by 'model'
  pub fn add(self &mut, mesh MeshHandle, material MaterialHandle, model Mat4) {
    items.push(new DrawItem(mesh, material, model, new Color(1., 1., 1., 1.)));
  }

  // The same, its color multiplied by 'tint'
  pub fn addTinted(self &mut, mesh MeshHandle, material MaterialHandle, model Mat4, tint Color) {
    items.push(new DrawItem(mesh, material, model, tint));
  }

  // Draw the lines 'mesh' in 'color', placed by 'model'
  pub fn addLines(self &mut, mesh MeshHandle, model Mat4, color Color) {
    items.push(new DrawItem(mesh, MaterialHandle.none(), model, color));
  }
}
