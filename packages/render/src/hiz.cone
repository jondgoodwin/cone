// Occlusion culling by a hierarchical depth buffer (hiz.slang says how the
// GPU does it and why). This file is what runs it: the pyramid, the buffers
// the survivors are compacted through, and the passes recorded between the
// two render passes a frame with occlusion makes.
//
//   renderer.vis.settings.occlusion = true;                // and scene items marked occludable (the default)
//   renderer.render(device, encoder, color, depth, ...)    // 'depth' made with TEXTURE_USAGE_TEXTURE_BINDING
//
// A FRAME WITH OCCLUSION, for the scene items the camera sees (the CPU's frustum
// culling and levels of detail come first, visibility.cone):
//   1. cull pass 0 (compute): each candidate is tested against LAST frame's
//      pyramid with last frame's camera; passing ones are copied to their
//      batch's place for the first draw, the others flagged;
//   2. render pass 1: everything not cullable by direct draws, the batches
//      that are by indirect draws of what passed. Depth is stored;
//   3. the pyramid is built from that depth (compute, a dispatch a level);
//   4. cull pass 1 (compute): the flagged candidates are tested against the
//      new pyramid with this frame's camera; passing ones are copied for the
//      second draw;
//   5. render pass 2, keeping what pass 1 drew: the indirect draws of the
//      second set, then lines, the sky and see-through draws as always.
// What a camera cut hid, or a moving thing was culled behind, is in the
// second draw; the cost of a stale pyramid is a few draws, never a missing
// object. The first frame, and the first after a resize, have no pyramid:
// everything passes in pass 0.
//
// WHAT CAN BE CULLED: scene items marked occludable whose batches are opaque
// and lit, physically based or cut out (not a custom pipeline's, not skinned,
// not see-through, not lines); the rest are drawn directly in pass 1 and are
// occluders but never occluded. Shadow passes are not occlusion culled (a
// shadow caster out of the camera's sight still casts).
//
// WHAT IT NEEDS: a depth texture made with TEXTURE_USAGE_TEXTURE_BINDING
// ('Renderer.render' checks; a 'renderTo' into views a program made itself
// is not occlusion culled unless it sets 'vis.depthSampled'), and a device
// with compute. Its cost is a pyramid of 1/4 the depth buffer's texels and a
// few buffers of about 120 bytes a candidate.
//
// Nothing here is created until occlusion is first on, and nothing is made
// again in a frame unless the scene outgrows a buffer or the target is
// resized.

const HIZ_MIN_BYTES = 256u64;
const HIZ_ARG_BYTES = 20u64;
const HIZ_CAND_INSTANCE_BYTES = 80u64;
const HIZ_CAND_INFO_BYTES = 32u64;
const HIZ_BATCH_BYTES = 16u64;
const HIZ_UNIFORM_BYTES = 96u64;

// A float's bits
fn bitsOf(x: f32) u32 {
  var v = x;
  *(&v as *u32)
}

fn floorPow2(n: u32) u32 {
  var p = 1u32;
  while p * 2u32 <= n { p = p * 2u32; }
  p
}

fn log2Floor(n: u32) u32 {
  var l = 0u32;
  var p = 1u32;
  while p * 2u32 <= n {
    p = p * 2u32;
    l = l + 1u32;
  }
  l
}

pub struct HiZ {
  shader: ShaderModule;
  cullLayout: BindGroupLayout;
  cullPipelineLayout: PipelineLayout;
  cullPipeline: ComputePipeline;
  finalizePipeline: ComputePipeline;
  buildLayout: BindGroupLayout;
  buildPipelineLayout: PipelineLayout;
  level0Pipeline: ComputePipeline;
  reducePipeline: ComputePipeline;
  pub pyramid: Texture;             // the farthest depth, level 0 a power of two a side
  pub levelWidth: u32;
  pub levelHeight: u32;
  pub levels: u32;
  buildGroups: List[BindGroup];     // a dispatch a level: the depth, the level written, the level read
  depthKey: TextureView;            // the depth view they were made for
  uniform0: Buffer;
  uniform1: Buffer;
  sourceInstances: Buffer;          // the candidates' instances, as the instance buffer holds them
  candidates: Buffer;               // their boxes, batches and words
  batchTable: Buffer;
  work: Buffer;                     // the counters of each pass, then a flag a candidate
  args: Buffer;                     // the indirect draws of each pass
  readback: Buffer;
  capCandidates: u32;
  capBatches: u32;
  capArgs: u32;
  group0: BindGroup;
  group1: BindGroup;
  groupKey: u64;
  buffersGen: u32;
  pub prevViewProjection: Mat4;     // the camera the pyramid was made with
  pub valid: bool;                  // whether the pyramid holds a frame
  pub sourceData: List[f32];        // this frame's candidates, gathered on the CPU
  pub candidateData: List[u32];
  pub batchData: List[u32];
  pub argData0: List[u32];
  pub argData1: List[u32];
  pub candidateCount: u32;
  pub batchCount: u32;
  pub drawCount: u32;
  pub passed0: u32;                 // what the last frame's two passes passed (read by 'readStats')
  pub passed1: u32;

  pub fn create(device: &mut Device, instances: &Buffer, boneBases: &Buffer, width: u32, height: u32) HiZ {
    var shader = device.createShaderModule(&HIZ_SPIRV);
    let cullEntries = [
      BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_COMPUTE),
      BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 6u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      BindGroupLayoutEntry(binding: 7u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      BindGroupLayoutEntry(binding: 8u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT)];
    var cullLayout = device.createBindGroupLayout(&cullEntries);
    let cullLayouts = [&cullLayout];
    var cullPipelineLayout = device.createPipelineLayout(&cullLayouts, 0u32);
    let cullDesc = ComputePipelineDescriptor(layout: &cullPipelineLayout, module: &shader, entryPoint: "cullInstances");
    var cullPipeline = device.createComputePipeline(&cullDesc);
    let finalizeDesc = ComputePipelineDescriptor(layout: &cullPipelineLayout, module: &shader, entryPoint: "finalizeArgs");
    var finalizePipeline = device.createComputePipeline(&finalizeDesc);
    let buildEntries = [
      BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH),
      BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_STORAGE_TEXTURE,
        format: TEXTURE_FORMAT_R32_FLOAT, storageAccess: STORAGE_TEXTURE_ACCESS_WRITE_ONLY),
      BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT)];
    var buildLayout = device.createBindGroupLayout(&buildEntries);
    let buildLayouts = [&buildLayout];
    var buildPipelineLayout = device.createPipelineLayout(&buildLayouts, 16u32);
    let level0Desc = ComputePipelineDescriptor(layout: &buildPipelineLayout, module: &shader, entryPoint: "buildLevel0");
    var level0Pipeline = device.createComputePipeline(&level0Desc);
    let reduceDesc = ComputePipelineDescriptor(layout: &buildPipelineLayout, module: &shader, entryPoint: "reduceLevel");
    var reducePipeline = device.createComputePipeline(&reduceDesc);

    let pw = floorPow2(if width < 1u32 { 1u32 } else { width });
    let ph = floorPow2(if height < 1u32 { 1u32 } else { height });
    let plevels = log2Floor(if pw > ph { pw } else { ph }) + 1u32;
    let pyramidDesc = TextureDescriptor(pw, ph, TEXTURE_FORMAT_R32_FLOAT,
      TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_SRC, mipLevelCount: plevels);
    var pyramid = device.createTexture(&pyramidDesc);
    var uniform0 = device.createBuffer(HIZ_UNIFORM_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    var uniform1 = device.createBuffer(HIZ_UNIFORM_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    var sourceInstances = device.createBuffer(HIZ_MIN_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    var candidates = device.createBuffer(HIZ_MIN_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    var batchTable = device.createBuffer(HIZ_MIN_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    var work = device.createBuffer(HIZ_MIN_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    var args = device.createBuffer(HIZ_MIN_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_INDIRECT | BUFFER_USAGE_COPY_DST);
    var readback = device.createBuffer(HIZ_MIN_BYTES, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    let view = pyramid.createView();
    let entries0 = [BindGroupEntry.buffer(0u32, &uniform0), BindGroupEntry.buffer(1u32, &sourceInstances),
      BindGroupEntry.buffer(2u32, &candidates), BindGroupEntry.buffer(3u32, instances),
      BindGroupEntry.buffer(4u32, boneBases), BindGroupEntry.buffer(5u32, &batchTable),
      BindGroupEntry.buffer(6u32, &work), BindGroupEntry.buffer(7u32, &args), BindGroupEntry.texture(8u32, &view)];
    var group0 = device.createBindGroup(&cullLayout, &entries0);
    let entries1 = [BindGroupEntry.buffer(0u32, &uniform1), BindGroupEntry.buffer(1u32, &sourceInstances),
      BindGroupEntry.buffer(2u32, &candidates), BindGroupEntry.buffer(3u32, instances),
      BindGroupEntry.buffer(4u32, boneBases), BindGroupEntry.buffer(5u32, &batchTable),
      BindGroupEntry.buffer(6u32, &work), BindGroupEntry.buffer(7u32, &args), BindGroupEntry.texture(8u32, &view)];
    var group1 = device.createBindGroup(&cullLayout, &entries1);
    HiZ(shader, cullLayout, cullPipelineLayout, cullPipeline, finalizePipeline, buildLayout, buildPipelineLayout,
      level0Pipeline, reducePipeline, pyramid, pw, ph, plevels, List[BindGroup].empty(), view, uniform0, uniform1,
      sourceInstances, candidates, batchTable, work, args, readback, 0u32, 0u32, 0u32, group0, group1, 0u64, 0u32,
      Mat4.identity(), false, List[f32].empty(), List[u32].empty(), List[u32].empty(), List[u32].empty(),
      List[u32].empty(), 0u32, 0u32, 0u32, 0u32, 0u32)
  }

  pub fn isValid(self: &) bool {
    cullPipeline.isValid() && finalizePipeline.isValid() && level0Pipeline.isValid() && reducePipeline.isValid()
      && group0.isValid() && group1.isValid() && pyramid.isValid()
  }

  // A frame's gathering begins: nothing is a candidate yet
  pub fn beginFrame(self: &mut) {
    sourceData.clear();
    candidateData.clear();
    batchData.clear();
    argData0.clear();
    argData1.clear();
    candidateCount = 0u32;
    batchCount = 0u32;
    drawCount = 0u32;
  }

  // A batch that can be culled: its survivors go to 'dest0' in the first
  // draw and 'dest1' in the second; one indirect draw a group of 'mesh'.
  // Gives its place in the batch table.
  pub fn addBatch(self: &mut, dest0: u32, dest1: u32, mesh: &GpuMesh) u32 {
    let index = batchCount;
    batchData.push(dest0);
    batchData.push(dest1);
    batchData.push(drawCount);
    batchData.push(u32.from(mesh.groups.len()));
    var g = 0usize;
    while g < mesh.groups.len() {
      let group = mesh.groups[g];
      argData0.push(group.count);
      argData0.push(0u32);
      argData0.push(group.start);
      argData0.push(0u32);
      argData0.push(dest0);
      argData1.push(group.count);
      argData1.push(0u32);
      argData1.push(group.start);
      argData1.push(0u32);
      argData1.push(dest1);
      drawCount = drawCount + 1u32;
      g = g + 1usize;
    }
    batchCount = batchCount + 1u32;
    index
  }

  // A candidate of batch 'batch': its box (centre, half size), its instance
  // (the model matrix and tint as the instance buffer holds them) and its word
  pub fn addCandidate(self: &mut, batch: u32, center: Vec3, half: Vec3, model: &Mat4, tint: Color, word: u32) {
    candidateData.push(bitsOf(center.x));
    candidateData.push(bitsOf(center.y));
    candidateData.push(bitsOf(center.z));
    candidateData.push(batch);
    candidateData.push(bitsOf(half.x));
    candidateData.push(bitsOf(half.y));
    candidateData.push(bitsOf(half.z));
    candidateData.push(word);
    var e = 0usize;
    while e < 16usize {
      sourceData.push(model.m[e]);
      e = e + 1usize;
    }
    sourceData.push(tint.red);
    sourceData.push(tint.green);
    sourceData.push(tint.blue);
    sourceData.push(tint.alpha);
    candidateCount = candidateCount + 1u32;
  }

  // The size a pyramid for a depth buffer of 'width' by 'height' has, made
  // again if the depth buffer's size changed
  pub fn ensurePyramid(self: &mut, device: &mut Device, width: u32, height: u32) {
    let w = floorPow2(width);
    let h = floorPow2(height);
    if w == levelWidth && h == levelHeight && pyramid.isValid() { return; }
    let count = log2Floor(if w > h { w } else { h }) + 1u32;
    let desc = TextureDescriptor(w, h, TEXTURE_FORMAT_R32_FLOAT,
      TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_SRC, mipLevelCount: count);
    buildGroups.clear();
    pyramid = device.createTexture(&desc);
    levelWidth = w;
    levelHeight = h;
    levels = count;
    valid = false;
    buffersGen = buffersGen + 1u32;
    groupKey = 0u64;
  }

  fn growBuffer(self: &mut, device: &mut Device, buffer: &mut Buffer, bytes: u64, usage: u32) bool {
    if bytes <= buffer.size { return false; }
    var size = if buffer.size < HIZ_MIN_BYTES { HIZ_MIN_BYTES } else { buffer.size };
    while size < bytes { size = size * 2u64; }
    device.queue.releaseBuffer(buffer);
    *buffer = device.createBuffer(size, usage);
    true
  }

  // Upload this frame's candidates, batches and draws, clear the counters and
  // write the passes' parameters: 'viewProjection' is this frame's camera,
  // 'instances' and 'boneBases' the renderer's buffers the survivors are
  // copied into ('instanceCapacity' says when they were made again)
  pub fn upload(self: &mut, device: &mut Device, instances: &Buffer, boneBases: &Buffer, instanceCapacity: u32,
      viewProjection: &Mat4) {
    let n = u64.from(candidateCount);
    let b = u64.from(batchCount);
    let d = u64.from(drawCount);
    var changed = false;
    if self.growBuffer(device, &mut sourceInstances, n * HIZ_CAND_INSTANCE_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST) { changed = true; }
    if self.growBuffer(device, &mut candidates, n * HIZ_CAND_INFO_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST) { changed = true; }
    if self.growBuffer(device, &mut batchTable, b * HIZ_BATCH_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST) { changed = true; }
    if self.growBuffer(device, &mut work, (2u64 * b + n) * 4u64,
        BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC) { changed = true; }
    if self.growBuffer(device, &mut args, 2u64 * d * HIZ_ARG_BYTES,
        BUFFER_USAGE_STORAGE | BUFFER_USAGE_INDIRECT | BUFFER_USAGE_COPY_DST) { changed = true; }
    if changed { buffersGen = buffersGen + 1u32; }
    let key = u64.from(buffersGen) * 4294967296u64 + u64.from(instanceCapacity);
    if key != groupKey {
      let view = pyramid.createView();
      let entries0 = [BindGroupEntry.buffer(0u32, &uniform0), BindGroupEntry.buffer(1u32, &sourceInstances),
        BindGroupEntry.buffer(2u32, &candidates), BindGroupEntry.buffer(3u32, instances),
        BindGroupEntry.buffer(4u32, boneBases), BindGroupEntry.buffer(5u32, &batchTable),
        BindGroupEntry.buffer(6u32, &work), BindGroupEntry.buffer(7u32, &args), BindGroupEntry.texture(8u32, &view)];
      group0 = device.createBindGroup(&cullLayout, &entries0);
      let entries1 = [BindGroupEntry.buffer(0u32, &uniform1), BindGroupEntry.buffer(1u32, &sourceInstances),
        BindGroupEntry.buffer(2u32, &candidates), BindGroupEntry.buffer(3u32, instances),
        BindGroupEntry.buffer(4u32, boneBases), BindGroupEntry.buffer(5u32, &batchTable),
        BindGroupEntry.buffer(6u32, &work), BindGroupEntry.buffer(7u32, &args), BindGroupEntry.texture(8u32, &view)];
      group1 = device.createBindGroup(&cullLayout, &entries1);
      groupKey = key;
    }
    if candidateCount == 0u32 { return; }
    let sv = sourceData.view();
    device.queue.writeBuffer(&sourceInstances, 0u64, &sv[0] as *u8, n * HIZ_CAND_INSTANCE_BYTES);
    let cv = candidateData.view();
    device.queue.writeBuffer(&candidates, 0u64, &cv[0] as *u8, n * HIZ_CAND_INFO_BYTES);
    let bv = batchData.view();
    device.queue.writeBuffer(&batchTable, 0u64, &bv[0] as *u8, b * HIZ_BATCH_BYTES);
    // The indirect draws: the first pass's, then the second's, instance counts for the GPU to fill
    let a0 = argData0.view();
    device.queue.writeBuffer(&args, 0u64, &a0[0] as *u8, d * HIZ_ARG_BYTES);
    let a1 = argData1.view();
    device.queue.writeBuffer(&args, d * HIZ_ARG_BYTES, &a1[0] as *u8, d * HIZ_ARG_BYTES);
    device.queue.clearBuffer(&work, 0u64, (2u64 * b + n) * 4u64);
    // The passes' parameters: the first pass tests with last frame's camera
    // if there is a pyramid, the second with this frame's
    self.writeUniform(device, &uniform0, &prevViewProjection, levels, valid, 0u32);
    self.writeUniform(device, &uniform1, viewProjection, levels, true, 1u32);
  }

  fn writeUniform(self: &, device: &mut Device, buffer: &Buffer, m: &Mat4, levelCount: u32, usable: bool, pass: u32) {
    var words = Array[u32, 24]() <- fill 0u32;
    var k = 0usize;
    while k < 16usize {
      words[k] = bitsOf(m.m[k]);
      k = k + 1usize;
    }
    words[16] = bitsOf(f32.from(levelWidth));
    words[17] = bitsOf(f32.from(levelHeight));
    words[18] = bitsOf(f32.from(levelCount));
    words[19] = bitsOf(if usable { 1. } else { 0. });
    words[20] = candidateCount;
    words[21] = pass;
    words[22] = batchCount;
    words[23] = drawCount;
    device.queue.writeBuffer(buffer, 0u64, &words as *u8, HIZ_UNIFORM_BYTES);
  }

  // The first pass: test every candidate against the last frame's pyramid
  // and copy the passing ones to the first draw's places
  pub fn recordFirst(self: &mut, encoder: &mut CommandEncoder) {
    var pass = encoder.beginComputePass();
    pass.setPipeline(&cullPipeline);
    pass.setBindGroup(0u32, &group0);
    pass.dispatchWorkgroups((candidateCount + 63u32) / 64u32, 1u32, 1u32);
    pass.setPipeline(&finalizePipeline);
    pass.dispatchWorkgroups((batchCount + 63u32) / 64u32, 1u32, 1u32);
    pass.end();
  }

  // Make the pyramid of the depth just drawn ('depth', 'width' by 'height'),
  // then the second pass: test the flagged candidates against it
  pub fn recordSecond(self: &mut, device: &mut Device, encoder: &mut CommandEncoder, depth: &TextureView, width: u32, height: u32) {
    // The build's groups, for this depth view
    if buildGroups.len() != usize.from(levels) || !depthKey.sameView(depth) {
      buildGroups.clear();
      var l = 0u32;
      while l < levels {
        let dstDesc = TextureViewDescriptor(baseMipLevel: l, mipLevelCount: 1u32);
        let dst = pyramid.createViewWith(&dstDesc);
        let srcLevel = if l > 0u32 { l - 1u32 } else if levels > 1u32 { 1u32 } else { 0u32 };
        let srcDesc = TextureViewDescriptor(baseMipLevel: srcLevel, mipLevelCount: 1u32);
        let src = pyramid.createViewWith(&srcDesc);
        let entries = [BindGroupEntry.texture(1u32, depth), BindGroupEntry.texture(2u32, &dst), BindGroupEntry.texture(3u32, &src)];
        buildGroups.push(device.createBindGroup(&buildLayout, &entries));
        l = l + 1u32;
      }
      depthKey = *depth;
    }
    var pass = encoder.beginComputePass();
    var l = 0u32;
    while l < levels {
      let dstW = if (levelWidth >> l) > 1u32 { levelWidth >> l } else { 1u32 };
      let dstH = if (levelHeight >> l) > 1u32 { levelHeight >> l } else { 1u32 };
      var srcW = width;
      var srcH = height;
      if l > 0u32 {
        srcW = if (levelWidth >> (l - 1u32)) > 1u32 { levelWidth >> (l - 1u32) } else { 1u32 };
        srcH = if (levelHeight >> (l - 1u32)) > 1u32 { levelHeight >> (l - 1u32) } else { 1u32 };
      }
      let sizes = [srcW, srcH, dstW, dstH];
      pass.setPipeline(if l == 0u32 { &level0Pipeline } else { &reducePipeline });
      pass.setBindGroup(0u32, &buildGroups[usize.from(l)]);
      pass.setImmediates(0u32, &sizes as *u8, 16u32);
      pass.dispatchWorkgroups((dstW + 7u32) / 8u32, (dstH + 7u32) / 8u32, 1u32);
      l = l + 1u32;
    }
    pass.setPipeline(&cullPipeline);
    pass.setBindGroup(0u32, &group1);
    pass.dispatchWorkgroups((candidateCount + 63u32) / 64u32, 1u32, 1u32);
    pass.setPipeline(&finalizePipeline);
    pass.dispatchWorkgroups((batchCount + 63u32) / 64u32, 1u32, 1u32);
    pass.end();
  }

  // The camera this frame's pyramid was made with, for the next frame's first pass
  pub fn finishFrame(self: &mut, viewProjection: &Mat4) {
    prevViewProjection = *viewProjection;
    valid = true;
  }

  // Copy the counters for 'readStats' (after the frame is done)
  pub fn copyStats(self: &mut, device: &mut Device, encoder: &mut CommandEncoder) {
    let bytes = 2u64 * u64.from(batchCount) * 4u64;
    if bytes == 0u64 { return; }
    if readback.size < bytes {
      device.queue.releaseBuffer(&mut readback);
      readback = device.createBuffer(if bytes < HIZ_MIN_BYTES { HIZ_MIN_BYTES } else { bytes * 2u64 },
        BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    }
    encoder.copyBufferToBuffer(&work, 0u64, &readback, 0u64, bytes);
  }

  // What the passes of the last frame that copied its counters passed, once the
  // GPU is done with it (the device idle): instances drawn by the first draw and by the second
  pub fn readStats(self: &mut) {
    let words = readback.mappedRange() as *u32;
    let b = usize.from(batchCount);
    var p0 = 0u32;
    var p1 = 0u32;
    var i = 0usize;
    while i < b {
      p0 = p0 + *(words + i);
      p1 = p1 + *(words + b + i);
      i = i + 1usize;
    }
    passed0 = p0;
    passed1 = p1;
  }
}

// spirv-begin hiz.spv HIZ_SPIRV
// Written by tools/shaders/shaders.py from hiz.slang (sha256 41d9b96ea0deda8d17efd467e10d8521d4d5bde898f40fdfe5ff25b1cda5831a): do not edit.
let HIZ_SPIRV: Array[u32, 4130] = [
  0x07230203u32, 0x00010500u32, 0x00280000u32, 0x00000419u32, 0x00000000u32, 0x00020011u32,
