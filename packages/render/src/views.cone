// A reflection probe: what the program keeps for 'addProbe' (the renderer
// holds a slot for it, 'slot'). It must outlive the frames that draw with
// it; 'remove' stops the renderer using it.
pub struct ReflectionProbe {
  pub slot usize;              // its place in renderer.probes
  pub position Vec3;
  pub boxMin Vec3;
  pub boxMax Vec3;
  pub background Color;        // what a face is cleared to where no sky is set
  pub bakes u32 = 0u32;
  capture Texture;             // the scene, RGBA16_FLOAT, with its whole mip chain
  specular Texture;
  irradiance Texture;
  uniforms Buffer;
  pictureColor Texture;        // a face as a camera drew it, before it is mirrored into the cube
  pictureDepth Texture;
  copyShader ShaderModule;
  copyLayout BindGroupLayout;
  copyPipelineLayout PipelineLayout;
  copyPipeline RenderPipeline;
  copyGroup BindGroup;
  wholeGroup BindGroup;
  levelGroups List[BindGroup];

  pub fn isValid(self &) bool { copyGroup.isValid() && wholeGroup.isValid() && capture.isValid() }

  // Stop the renderer lighting anything with this probe
  pub fn remove(self &, renderer &mut Renderer) {
    if self.slot < renderer.probes.len() {
      var s = &mut renderer.probes[self.slot];
      s.ready = false;
    }
  }

  // Capture the scene 'list' (lit by 'light') again from the probe's
  // position and filter it, in submissions of its own: six faces, then the
  // filtering. Probes are baked, not per frame: call it between frames.
  pub fn capturePass(self &mut, renderer &mut Renderer, device &mut Device, light &Light, list &DrawList) {
    var base = Camera.make();
    base.fov = radians(90.);
    base.near = 0.05;
    base.background = background;
    var face = 0u32;
    while face < 6u32 {
      var camera = base;
      camera.lookAt(position, position + FACE_FORWARD[usize.from(face)], FACE_UP[usize.from(face)]);
      // The face as a right-handed camera draws it
      var encoder = device.createCommandEncoder();
      let colorView = pictureColor.createView();
      let depthView = pictureDepth.createView();
      renderer.renderTo(device, &mut encoder, colorView, depthView, &camera, light, list);
      device.queue.submit(encoder.finish());
      // ... mirrored into the cube's face (probe.slang)
      var copy = device.createCommandEncoder();
      let target = faceView(&capture, face, 0u32);
      let attachment = new RenderPassColorAttachment(view: target, clearValue: new Color(0., 0., 0., 1.));
      var pass = copy.beginRenderPass(&attachment);
      pass.setPipeline(&copyPipeline);
      pass.setBindGroup(0u32, &copyGroup);
      pass.draw(3u32, 1u32, 0u32, 0u32);
      pass.end();
      device.queue.submit(copy.finish());
      // A frame holds 16 command buffers: a face a frame
      device.endFrame();
      face = face + 1u32;
    }
    // The filtering, with the environment's own pipelines: the mip chain
    // of the capture, the specular cube by roughness, the diffuse cube
    var encoder = device.createCommandEncoder();
    renderer.environment.bake(&mut encoder);
    let env = &renderer.environment;
    var level = 1u32;
    while level < ENVIRONMENT_LEVELS {
      face = 0u32;
      while face < 6u32 {
        let view = faceView(&capture, face, level);
        bakePass(&mut encoder, view, &env.downsamplePipeline, levelGroups[usize.from(level - 1u32)], face, 0.,
          f32.from(PROBE_SIZE >> level), 0u32);
        face = face + 1u32;
      }
      level = level + 1u32;
    }
    level = 0u32;
    while level < SPECULAR_LEVELS {
      let roughness = f32.from(level) / f32.from(SPECULAR_LEVELS - 1u32);
      face = 0u32;
      while face < 6u32 {
        let view = faceView(&specular, face, level);
        bakePass(&mut encoder, view, &env.prefilterPipeline, &wholeGroup, face, roughness,
          f32.from(SPECULAR_SIZE >> level), PREFILTER_SAMPLES);
        face = face + 1u32;
      }
      level = level + 1u32;
    }
    face = 0u32;
    while face < 6u32 {
      let view = faceView(&irradiance, face, 0u32);
      bakePass(&mut encoder, view, &env.irradiancePipeline, &wholeGroup, face, IRRADIANCE_SOURCE_LEVEL,
        f32.from(IRRADIANCE_SIZE), IRRADIANCE_SAMPLES);
      face = face + 1u32;
    }
    device.queue.submit(encoder.finish());
    device.endFrame();
    bakes = bakes + 1u32;
  }
}

// A probe at 'position' lighting physically based copies whose model's
// origin lies in the box 'boxMin' to 'boxMax' (a copy in several boxes takes
// the smallest), captured now from the scene 'list' lit by 'light'. Needs a
// renderer drawing into RGBA16_FLOAT; the result is not valid otherwise.
// Call it between frames (it ends the frame it is in).
pub fn addProbe(renderer &mut Renderer, device &mut Device, position Vec3, boxMin Vec3, boxMax Vec3,
    background Color, light &Light, list &DrawList) ReflectionProbe {
  let usage = TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING;
  let captureDesc = new TextureDescriptor(PROBE_SIZE, PROBE_SIZE, TEXTURE_FORMAT_RGBA16_FLOAT, usage, ENVIRONMENT_LEVELS, 6u32);
  var capture = device.createTexture(&captureDesc);
  let specularDesc = new TextureDescriptor(SPECULAR_SIZE, SPECULAR_SIZE, TEXTURE_FORMAT_RGBA16_FLOAT, usage,
    SPECULAR_LEVELS, 6u32);
  var specular = device.createTexture(&specularDesc);
  let irradianceDesc = new TextureDescriptor(IRRADIANCE_SIZE, IRRADIANCE_SIZE, TEXTURE_FORMAT_RGBA16_FLOAT, usage, 1u32, 6u32);
  var irradiance = device.createTexture(&irradianceDesc);
  let pictureDesc = new TextureDescriptor(PROBE_SIZE, PROBE_SIZE, renderer.colorFormat, usage);
  var pictureColor = device.createTexture(&pictureDesc);
  let pictureDepthDesc = new TextureDescriptor(PROBE_SIZE, PROBE_SIZE, renderer.depthFormat, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var pictureDepth = device.createTexture(&pictureDepthDesc);

  // The group 2 physically based copies in the box read: the sky's
  // parameters, then the box and position (pbr.slang's EnvParams)
  var uniforms = device.createBuffer(SKY_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
  var params = skyParams(&renderer.environment.sky);
  params[36] = boxMin.x;
  params[37] = boxMin.y;
  params[38] = boxMin.z;
  params[39] = 1.;
  params[40] = boxMax.x;
  params[41] = boxMax.y;
  params[42] = boxMax.z;
  params[44] = position.x;
  params[45] = position.y;
  params[46] = position.z;
  device.queue.writeBuffer(&uniforms, 0u64, &params as *u8, SKY_BYTES);
  let cubeDesc = new TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_CUBE);
  let irradianceView = irradiance.createViewWith(&cubeDesc);
  let specularView = specular.createViewWith(&cubeDesc);
  let tableView = renderer.environment.table.createView();
  let groupEntries = [BindGroupEntry.buffer(0u32, &uniforms), BindGroupEntry.texture(1u32, &irradianceView),
    BindGroupEntry.texture(2u32, &specularView), BindGroupEntry.texture(3u32, &tableView),
    BindGroupEntry.sampler(4u32, &renderer.environment.sampler)];
  var group = device.createBindGroup(&renderer.environmentLayout, &groupEntries);

  // What the capture needs: the groups the bake passes read, the face copy
  var copyShader = device.createShaderModule(&PROBE_SPIRV);
  let copyEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE)];
  var copyLayout = device.createBindGroupLayout(&copyEntries);
  let copyLayouts = [&copyLayout];
  var copyPipelineLayout = device.createPipelineLayout(&copyLayouts, 0u32);
  var copyPipeline = fullscreenPipeline(device, &copyPipelineLayout, &copyShader, "mirrorCopyMain");
  let pictureView = pictureColor.createView();
  let copyGroupEntries = [BindGroupEntry.texture(0u32, &pictureView)];
  var copyGroup = device.createBindGroup(&copyLayout, &copyGroupEntries);
  let wholeDesc = new TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_CUBE);
  let whole = capture.createViewWith(&wholeDesc);
  let wholeEntries = [BindGroupEntry.buffer(0u32, &renderer.environment.skyUniforms), BindGroupEntry.texture(1u32, &whole),
    BindGroupEntry.sampler(2u32, &renderer.environment.sampler)];
  var wholeGroup = device.createBindGroup(&renderer.environment.bakeLayout, &wholeEntries);
  var levelGroups = List[BindGroup].empty();
  var level = 0u32;
  while level + 1u32 < ENVIRONMENT_LEVELS {
    let levelDesc = new TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_CUBE, baseMipLevel: level, mipLevelCount: 1u32);
    let levelView = capture.createViewWith(&levelDesc);
    let levelEntries = [BindGroupEntry.buffer(0u32, &renderer.environment.skyUniforms), BindGroupEntry.texture(1u32, &levelView),
      BindGroupEntry.sampler(2u32, &renderer.environment.sampler)];
    levelGroups.push(device.createBindGroup(&renderer.environment.bakeLayout, &levelEntries));
    level = level + 1u32;
  }

  let size = boxMax - boxMin;
  let slot = renderer.probes.len();
  renderer.probes.push(new ProbeSlot(false, boxMin, boxMax, size.x * size.y * size.z, group));
  var probe = new ReflectionProbe(slot: slot, position: position, boxMin: boxMin, boxMax: boxMax, background: background,
    capture: capture, specular: specular, irradiance: irradiance, uniforms: uniforms, pictureColor: pictureColor,
    pictureDepth: pictureDepth, copyShader: copyShader, copyLayout: copyLayout, copyPipelineLayout: copyPipelineLayout,
    copyPipeline: copyPipeline, copyGroup: copyGroup, wholeGroup: wholeGroup, levelGroups: levelGroups);
  if renderer.colorFormat == TEXTURE_FORMAT_RGBA16_FLOAT && probe.isValid() {
    probe.capturePass(renderer, device, light, list);
    var s = &mut renderer.probes[slot];
    s.ready = true;
  }
  probe
}
