// Views, planar mirrors and reflective water, and reflection probes.
//
// A VIEW is the scene drawn from another camera into a texture of its own:
// a size, a layer mask (which of the draw list's items it draws), and a
// colour texture, held by the renderer under a TextureHandle, that any
// material can sample (a custom pipeline's, or ViewMaterials' below).
// A security-camera screen, a minimap, a portal's opening and a mirror are
// all that: a view, and a material that shows it. The view is drawn into
// its own texture, in its own submission, before the frame's main render
// (a view drawn at the start of the frame, as the draw lists of its
// camera say). Render the views before creating the encoder the main
// 'render' records into, in the order that a view is drawn after the views
// whose pictures its scene shows.
//
// Why a submission each. The frame's uniforms, the instances and the bones
// are one set of buffers, written by 'queue.writeBuffer', which the GPU
// runs after everything submitted before it: so each camera's pass is
// recorded and submitted before the next camera's writes, and one set of
// buffers serves every view. (The alternative, a set of buffers a view, is
// more to keep and buys nothing a submission does not.)
//
// Layers. A DrawItem is on layers (a bit each; 'DrawList.setLayers'); a
// view draws the items its layer mask meets, so a screen is left out of
// the picture of the camera that feeds it, and a mirror out of its own
// reflection.
//
// NESTING. A view that shows another view's picture (a monitor, in a room a
// camera films, that shows another camera) is drawn after that view; its
// 'nest' is how many views deep it sits (0: it shows none), and 'render'
// draws it only if that is no more than 'maxNest' (default 1: a view within a
// view). A view deeper than that is not drawn that frame, and shows what it
// last held, so the recursion is cut at a depth the program chooses and
// costs what it says. A view never draws its own screen: put the screen on a
// layer the view's mask leaves out, and the picture inside the picture is
// last frame's, one frame behind, not a second pass.
//
// FOG. A view can have the volumetric fog of fog.cone over its picture, so that a
// mirror or a portal shows the air the main view does: 'enableFog' makes the view's
// own passes and volume (the size of its picture), and the view's 'fog' settings, read
// every picture, say what the air is and whether it is drawn ('fog.enabled'). The
// fog is recorded into the picture's own submission, after the scene, over the picture's
// depth (which 'render' keeps for it), and reads the cascades and the shadow parameters
// the picture's own render has just written for its camera. The camera's eye is its
// position (a reflected camera's reflection) and its distances are planar, so the fog of
// a mirror's picture is the plain fog of the camera at the reflected eye.
//
// PLANAR MIRRORS and WATER. The camera that sees in a mirror is
// 'camera.reflectedAbout(plane)' (camera.cone): the world reflected about
// the plane before the camera sees it, the near plane replaced by the mirror
// plane itself (Lengyel's oblique clip) so nothing behind the mirror is
// drawn, and the clip space's x flipped so the triangles keep their winding.
// Its view, the size of the frame, is the reflection; ViewMaterials'
// mirror material reads it at the fragment's own screen position, with a
// Fresnel blend with a body colour and a scrolling normal map's offset for
// water (viewmat.slang).
//
// REFLECTION PROBES. A cube map captured at a point (six right-handed
// 90 degree cameras, 256 texels a face), filtered the way the sky is: the
// environment's own pipelines (ibl.slang), its mip chain by box filtering,
// a specular cube by GGX importance sampling at 6 roughness steps, a
// diffuse cube. A physically based copy whose model's origin lies inside the
// probe's box is lit by the probe's cubes in place of the sky's, and its
// reflection vector is box-projected (pbr.slang, 'probeDirection') so the
// reflection of a room's walls sits where the walls are. The probe's cubes
// belong to the 'ReflectionProbe' value the program keeps; the renderer holds only the
// group the shaders read. Probes need a renderer drawing into RGBA16_FLOAT.

// The mask of every layer
pub const LAYERS_ALL = 0xffffffffu32;

// How many views deep a view may be drawn, by default
pub const DEFAULT_MAX_NEST = 1u32;

// What a view holds
pub struct RenderView {
  pub color TextureHandle;     // its picture: the renderer's colour format, 'width' by 'height'
  pub depth Texture;
  pub width u32;
  pub height u32;
  queries QuerySet;            // GPU timestamps round its picture, once 'enableTiming' made them
  resolved Buffer;
  readback Buffer;
  fogPass List[FogPass];       // volumetric fog for its picture: empty, or the one 'enableFog' made
  fogFrame Buffer;             // fxcommon.slang's FxFrame for the fog, written each picture
  fogPrevious Mat4;            // the last fogged picture's view-projection
  // The fog (fog.cone), drawn over each picture, as the camera sees the scene, when 'enabled' and
  // 'enableFog' made its passes. Read every picture: a weather system may set the density at will.
  // Its 'tileSize' and 'slices' are the grid the volume is made for and a change remakes it (with a
  // stall, as ImageFx.configure does); 'temporal' blends in the view's last picture's volume.
  pub fog FogSettings = new FogSettings();
  fogTile u32 = 0u32;          // the grid 'fog' had when the volume was made
  fogSlices u32 = 0u32;
  fogPictures u32 = 0u32;      // pictures fogged: the volume's jitter index
  fogHavePrevious bool = false;
  pub layerMask u32 = 0xffffffffu32;   // the items it draws: those on one of these layers
  pub nest u32 = 0u32;         // how many views deep it sits
  pub drawn u32 = 0u32;        // how many times it has been drawn
  pub drawCalls u32 = 0u32;    // the draws of its last picture
  pub triangles u64 = 0u64;
  // Which of the scene's cameras it is, for the levels of detail an item keeps
  // a hysteresis for (1 to 3; the main view is 0), and its bias: the
  // multiplier of the projected size a small picture wants (visibility.cone)
  pub lodSlot usize = 1usize;
  pub lodBias f32 = 1.;

  // A view of 'width' by 'height' texels: the picture a texture of 'renderer''s
  // colour format (sampled by materials, copied from with COPY_SRC), and a
  // depth texture of its depth format
  pub fn create(renderer &mut Renderer, device &mut Device, width u32, height u32) RenderView {
    let usage = TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_SRC;
    let desc = new TextureDescriptor(width, height, renderer.colorFormat, usage);
    var texture = device.createTexture(&desc);
    let handle = new TextureHandle(renderer.textures.add(new TextureSlot(texture)));
    // The depth is sampled by the fog, once 'enableFog' made it
    let depthDesc = new TextureDescriptor(width, height, renderer.depthFormat,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    var depth = device.createTexture(&depthDesc);
    new RenderView(handle, depth, width, height, QuerySet.none(), Buffer.none(), Buffer.none(), List[FogPass].empty(),
      Buffer.none(), Mat4.identity())
  }

  pub fn isValid(self &) bool { depth.isValid() && !color.isNone() }

  // The texture holding the view's picture (not valid once the view is released). With
  // 'depth', it is what a later pass of the program's own draws into the picture, such
  // as a particle renderer's, after 'render' has drawn the scene into it. Record that
  // pass in an encoder of its own and submit it after 'render' returns ('render'
  // submits its picture before it returns), and set 'renderer.keepDepth' while the
  // scene is drawn, or the depth test has nothing to read.
  pub fn texture(self &, renderer &Renderer) &Texture {
    &renderer.textures[color.slot].texture
  }

  // Give the view's picture and depth texture back, as 'removeTexture' does
  // (no stall: they are destroyed once the GPU has finished the frames that
  // may have drawn into them or sampled them). A material that shows the
  // picture is removed with 'removeMaterial', which the caller does, as
  // for any texture's materials. The view is not valid afterwards. (A view with
  // fog drops its fog passes, which waits for the device to be idle.)
  pub fn release(self &mut, renderer &mut Renderer, device &mut Device) {
    renderer.removeTexture(device, color);
    device.queue.releaseTexture(&mut depth);
    color = TextureHandle.none();
    device.queue.releaseBuffer(&mut resolved);
    device.queue.releaseBuffer(&mut readback);
    queries = QuerySet.none();
    fogPass = List[FogPass].empty();
    device.queue.releaseBuffer(&mut fogFrame);
  }

  // Time every later picture on the GPU ('gpuNanoseconds'); false if the
  // device keeps no timestamps
  pub fn enableTiming(self &mut, device &mut Device) bool {
    if device.timestampPeriod <= 0. { return false; }
    queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32);
    resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);
    readback = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    queries.isValid()
  }

  // Make the passes of the view's fog ('fog'), whose volume is the size of its picture
  // (about 12 MB for 1080 lines at the high tier). Every later picture is fogged while
  // 'fog.enabled'. False, and no fog, if the renderer's colour format is not RGBA16_FLOAT
  // (the fog pipelines' format).
  pub fn enableFog(self &mut, renderer &mut Renderer, device &mut Device) bool {
    if renderer.colorFormat != TEXTURE_FORMAT_RGBA16_FLOAT { return false; }
    if fogPass.len() > 0usize { return true; }
    fogFrame = device.createBuffer(FX_FRAME_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    let depthView = depth.createView();
    var pass = FogPass.create(device, &renderer.shadow, &fogFrame, &depthView);
    // The tiny volumes it began with, about to be replaced, may be named by commands not yet run
    var flush = device.createCommandEncoder();
    device.queue.submit(flush.finish());
    device.waitIdle();
    pass.remake(device, true, width, height, &fog, &renderer.shadow, &fogFrame, &depthView);
    fogTile = fog.tileSize;
    fogSlices = fog.slices;
    fogPass.push(pass);
    fogHavePrevious = false;
    fogPass[0usize].isValid()
  }

  // The next picture's fog starts afresh, with none of the last picture's volume (the view's
  // camera has cut to somewhere else)
  pub fn cutFog(self &mut) { fogHavePrevious = false; }

  // The GPU time of the last picture drawn, in nanoseconds, once the device
  // is idle ('device.waitIdle()'); 0 if timing is off
  pub fn gpuNanoseconds(self &, device &Device) f64 {
    if !queries.isValid() { return 0.0; }
    let ticks = readback.mappedRange() as *u64;
    f64.from(*(ticks + 1usize) - *ticks) * f64.from(device.timestampPeriod)
  }

  // Draw the items of 'list' on this view's layers, seen by 'camera' and lit
  // by 'light', into its picture, in a submission of its own. False, and
  // nothing drawn, if the view sits deeper than 'maxNest' views.
  pub fn render(self &mut, renderer &mut Renderer, device &mut Device, camera &Camera, light &Light,
      list &DrawList, maxNest u32) bool {
    if nest > maxNest || !renderer.textures.alive(color.slot) { return false; }
    let sub = onLayers(list, layerMask);
    let target = renderer.textures[color.slot].texture.createView();
    let depthView = depth.createView();
    let fogged = fog.enabled && fogPass.len() > 0usize;
    if fogged { self.remakeFog(renderer, device); } else { fogHavePrevious = false; }
    var encoder = device.createCommandEncoder();
    if queries.isValid() { encoder.writeTimestamp(&queries, 0u32); }
    // The scene (visibility.cone) is seen through the same layers, by this view's own camera
    renderer.vis.layerMask = layerMask;
    renderer.vis.lodSlot = lodSlot;
    renderer.vis.cameraBias = lodBias;
    // The fog reads the picture's depth, so it is kept
    let keptBefore = renderer.keepDepth;
    if fogged { renderer.keepDepth = true; }
    renderer.renderTo(device, &mut encoder, target, depthView, camera, light, &sub);
    renderer.keepDepth = keptBefore;
    renderer.vis.layerMask = LAYERS_ALL;
    renderer.vis.lodSlot = 0usize;
    renderer.vis.cameraBias = 1.;
    if fogged { self.recordFog(renderer, device, &mut encoder, camera, light); }
    if queries.isValid() {
      encoder.writeTimestamp(&queries, 1u32);
      encoder.resolveQuerySet(&queries, 0u32, 2u32, &resolved, 0u64);
      encoder.copyBufferToBuffer(&resolved, 0u64, &readback, 0u64, 16u64);
    }
    device.queue.submit(encoder.finish());
    drawn = drawn + 1u32;
    drawCalls = renderer.drawCalls;
    triangles = renderer.triangles;
    true
  }

  // Make the fog's volumes again if 'fog' now asks for another grid (before the picture's
  // commands are recorded: the volumes about to be replaced may be named by commands not yet
  // run, so let them run)
  fn remakeFog(self &mut, renderer &mut Renderer, device &mut Device) {
    if fog.tileSize == fogTile && fog.slices == fogSlices { return; }
    let depthView = depth.createView();
    var flush = device.createCommandEncoder();
    device.queue.submit(flush.finish());
    device.waitIdle();
    fogPass[0usize].remake(device, true, width, height, &fog, &renderer.shadow, &fogFrame, &depthView);
    fogTile = fog.tileSize;
    fogSlices = fog.slices;
    fogHavePrevious = false;
  }

  // The fog over the picture just recorded into 'encoder' (same encoder: the cascades the
  // view's own render drew, and the shadow parameters it wrote for its camera, are what the
  // fog reads). The frame uniform is the camera's own, the eye a reflected camera's reflection.
  fn recordFog(self &mut, renderer &mut Renderer, device &mut Device, encoder &mut CommandEncoder, camera &Camera,
      light &Light) {
    let depthView = depth.createView();
    var base = *camera;
    base.jitterX = 0.;
    base.jitterY = 0.;
    let history = fogHavePrevious;
    let viewProjection = writeFxFrame(device, &fogFrame, &base, f32.from(width) / f32.from(height), width, height,
      fogPrevious, history, 0., 0., 0., 0., light, renderer.exposure, renderer.time, 0.016666668, fogPictures, !history);
    fogPass[0usize].record(device, encoder, &renderer.shadow, &fogFrame, &depthView, &renderer.textures[color.slot].texture,
      &fog, fogPictures, history);
    fogPrevious = viewProjection;
    fogHavePrevious = true;
    fogPictures = fogPictures + 1u32;
  }
}

// The items of 'list' that meet 'mask', with all its bones (the items keep
// their places in them)
pub fn onLayers(list &DrawList, mask u32) DrawList {
  var out = DrawList.empty();
  var i = 0usize;
  while i < list.items.len() {
    let it = list.items[i];
    if (it.layers & mask) != 0u32 {
      out.items.push(new DrawItem(it.mesh, it.material, it.model, it.tint, it.bones, it.layers, it.castsShadow));
    }
    i = i + 1usize;
  }
  let bones = list.bones.view();
  var b = 0usize;
  while b < bones.len {
    out.bones.push(bones[b]);
    b = b + 1usize;
  }
  out
}

// The plane of a mirror through 'point' facing 'normal', turned to face the
// camera at 'eye': (n, d) with n.p + d = 0 on the plane and the eye on the
// positive side
pub fn mirrorPlane(point Vec3, normal Vec3, eye Vec3) Vec4 {
  var n = normal.normalize();
  if n.dot(eye - point) < 0. { n = new Vec3(0., 0., 0.) - n; }
  new Vec4(n.x, n.y, n.z, -n.dot(point))
}

