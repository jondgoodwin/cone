// ---- Structs ----
//
// Every struct is laid out as C lays it out (the 'layout' test checks each
// size and offset against the C compiler). One that begins with a 'type' and a
// 'next' gives its 'type' its own value by default and 'next' null, so a
// create-info names only what it sets. An output struct (one the runtime
// fills) is made the same way, and the runtime fills the rest. A string field
// is a byte array, zero-terminated.

// ---- Geometry ----

pub struct Vector2f { pub x: f32; pub y: f32; }
pub struct Vector3f { pub x: f32; pub y: f32; pub z: f32; }
pub struct Quaternionf { pub x: f32; pub y: f32; pub z: f32; pub w: f32; }
// A rigid placement: a unit quaternion, then a position in metres. OpenXR's
// spaces are right-handed, y up, looking down -z, as render's are.
pub struct Posef { pub orientation: Quaternionf; pub position: Vector3f; }
// A field of view as four angles in radians from the view's axis: left and
// down are negative for a symmetric view, right and up positive
pub struct Fovf { pub angleLeft: f32; pub angleRight: f32; pub angleUp: f32; pub angleDown: f32; }
pub struct Extent2Df { pub width: f32; pub height: f32; }
pub struct Extent2Di { pub width: i32; pub height: i32; }
pub struct Offset2Di { pub x: i32; pub y: i32; }
pub struct Rect2Di { pub offset: Offset2Di; pub extent: Extent2Di; }

// A value of T with every byte zero, for a struct the runtime fills in (an
// ExtensionProperties, a SystemProperties) or one with no sensible default
pub fn zeroed[T]() T {
  let p = libc.calloc(1usize, mem.sizeof[T]()) as *T;
  let v = mem.readRaw[T](p);
  libc.free(p as *u8);
  v
}

// The pose that places nothing: no turn, no move
pub extern fn identityPose() Posef;
