  pub type: i32 = TYPE_VULKAN_INSTANCE_CREATE_INFO_KHR;
  pub next: *u8 = null;
  pub systemId: u64;
  pub createFlags: u64 = 0u64;
  pub pfnGetInstanceProcAddr: vulkan.PFN_GetInstanceProcAddr;
  pub vulkanCreateInfo: *vulkan.InstanceCreateInfo;
  pub vulkanAllocator: *u8;
}

// The same for the Vulkan device, on the physical device the runtime chose
pub struct VulkanDeviceCreateInfoKHR {
  pub type: i32 = TYPE_VULKAN_DEVICE_CREATE_INFO_KHR;
  pub next: *u8 = null;
  pub systemId: u64;
  pub createFlags: u64 = 0u64;
  pub pfnGetInstanceProcAddr: vulkan.PFN_GetInstanceProcAddr;
  pub vulkanPhysicalDevice: vulkan.PhysicalDevice;
  pub vulkanCreateInfo: *vulkan.DeviceCreateInfo;
  pub vulkanAllocator: *u8;
}

// Asks which physical device the runtime wants the application to use
pub struct VulkanGraphicsDeviceGetInfoKHR {
  pub type: i32 = TYPE_VULKAN_GRAPHICS_DEVICE_GET_INFO_KHR;
  pub next: *u8 = null;
  pub systemId: u64;
  pub vulkanInstance: vulkan.Instance;
}

// ---- XR_EXT_hand_tracking and XR_FB_hand_tracking_aim ----

// Extends SystemProperties (put in its 'next'): whether the system tracks hands
pub struct SystemHandTrackingPropertiesEXT {
  pub type: i32 = TYPE_SYSTEM_HAND_TRACKING_PROPERTIES_EXT;
  pub next: *u8 = null;
  pub supportsHandTracking: u32 = 0u32;
}

// A hand tracker for one hand (HAND_LEFT_EXT, HAND_RIGHT_EXT)
pub struct HandTrackerCreateInfoEXT {
  pub type: i32 = TYPE_HAND_TRACKER_CREATE_INFO_EXT;
  pub next: *u8 = null;
  pub hand: i32;
  pub handJointSet: i32 = HAND_JOINT_SET_DEFAULT_EXT;
}

// Where to locate the joints: in 'baseSpace', at 'time'
pub struct HandJointsLocateInfoEXT {
  pub type: i32 = TYPE_HAND_JOINTS_LOCATE_INFO_EXT;
  pub next: *u8 = null;
  pub baseSpace: Space;
  pub time: i64;
}

// One joint: SPACE_LOCATION_ flags, its pose and the radius of the hand there
pub struct HandJointLocationEXT {
  pub locationFlags: u64;
  pub pose: Posef;
  pub radius: f32;
}

// The joints, filled by 'locateHandJointsEXT': 'jointLocations' points at
// 'jointCount' (HAND_JOINT_COUNT_EXT) of them. 'isActive' is TRUE when the hand
// is tracked. A HandTrackingAimStateFB goes in 'next'.
pub struct HandJointLocationsEXT {
  pub type: i32 = TYPE_HAND_JOINT_LOCATIONS_EXT;
  pub next: *u8 = null;
  pub isActive: u32 = 0u32;
  pub jointCount: u32;
  pub jointLocations: *HandJointLocationEXT;
}

// Extends HandJointLocationsEXT (chained from its 'next'): the aim pose and
// the pinch strengths, 0 to 1. 'status' is HAND_TRACKING_AIM_ flags.
pub struct HandTrackingAimStateFB {
  pub type: i32 = TYPE_HAND_TRACKING_AIM_STATE_FB;
  pub next: *u8 = null;
  pub status: u64 = 0u64;
  pub aimPose: Posef;
  pub pinchStrengthIndex: f32 = 0.;
  pub pinchStrengthMiddle: f32 = 0.;
  pub pinchStrengthRing: f32 = 0.;
  pub pinchStrengthLittle: f32 = 0.;
}
