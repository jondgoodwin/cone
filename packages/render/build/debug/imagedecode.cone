// ======== Raster: what a decode gives ========

// How the file says its colours are to be read
pub enum ColorSpace {
  // Nothing said. A viewer treats colour as sRGB, which is what nearly every
  // such file is.
  Unspecified,
  // sRGB (a PNG with an sRGB chunk; a JPEG is sRGB unless it says otherwise,
  // and says so only by an ICC profile this package does not read)
  Srgb,
  // Gamma 1.0: the samples are linear light
  Linear,
  // A PNG gAMA chunk other than sRGB's or 1.0: 'gamma' holds it
  Gamma
}

// A decoded picture: always four channels (red, green, blue, alpha), rows
// from the TOP down (the order every file stores them in; render's Image
// wants the bottom row first, which 'bottomUp' gives), pixels of 'depth' bits
// a channel: 8 in 'pixels8', or 16 in 'pixels16' (a PNG whose samples are 16
// bits). Only the list for its depth holds anything. Colour is NOT
// premultiplied by alpha. Greyscale and palette pictures are expanded to
// colour, and a picture with no alpha has alpha full (255 or 65535).
pub struct Raster is Default {
  pub width: i32;
  pub height: i32;
  pub depth: i32;
  pub pixels8: List[u8];
  pub pixels16: List[u16];
  // Whether the file had an alpha channel or a transparency key/table: when
  // false every alpha is full, and a texture can be uploaded as RGB
  pub hasAlpha: bool;
  pub colorSpace: ColorSpace;
  // A PNG's gAMA value as the specification states it: the encoding's
  // exponent (light raised to it to make the stored value), 0.45455 for the
  // sRGB-like files, 1 for linear; 0 when the file does not say
  pub gamma: f32;
  // EXIF orientation (1 to 8) the file asked for, 1 when none. A JPEG decode
  // applies it by default, so the pixels are upright, and this keeps what it
  // was
  pub orientation: i32;

  pub extern fn init(self: &new);
