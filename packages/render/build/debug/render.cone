// draw's tint's) is used, as glTF 2.0's 'alphaMode' names them:
// - ALPHA_OPAQUE: not at all; the surface hides what is behind it;
// - ALPHA_MASK: cut out: a fragment whose alpha is below the material's
//   'alphaCutoff' is discarded, the rest drawn opaque (a leaf card, a fence);
// - ALPHA_BLEND: see-through: drawn after everything opaque, back to front,
//   depth tested but not written, blended over what is behind it with
//   premultiplied alpha (the target becomes src + (1 - src alpha) x dst).
//   The diffuse light the surface reflects is multiplied by its alpha, the
//   share of what is behind it the surface covers; its highlight (and the
//   physically based material's reflection of the environment) and its glow
//   are added whole, as Filament's "transparent" blending keeps them, so a
//   clear pane still reflects and a glowing pane still glows. An alpha of 0
//   with a glow is pure addition: light painted on.
pub const ALPHA_OPAQUE = 0u32;
pub const ALPHA_MASK = 1u32;
pub const ALPHA_BLEND = 2u32;

// What a surface is drawn like
pub struct Material is ShapeKeeping {
  pub baseColor: Color;             // linear
  pub specular: Color;              // the highlight's color (rgb); black: none
  pub shininess: f32;               // the highlight's exponent: higher is smaller and sharper
  pub texture: TextureHandle;       // multiplies the base color; none: white
  // What it gives off, unlit: a radiance, linear rgb (nits in a scene in
  // physical units), which bloom makes glow; black: nothing
  pub emissive: Color = Color(0., 0., 0., 1.);
  pub alphaMode: u32 = ALPHA_OPAQUE;   // ALPHA_OPAQUE, ALPHA_MASK or ALPHA_BLEND
  pub alphaCutoff: f32 = 0.5;          // ALPHA_MASK's: an alpha below it is cut out
  // The light layers it is on (bits 0 to 23): a point or spot light reaches
  // it only if they share a bit (lights.cone). Layer 0 alone, as every light
  // starts.
  pub lightLayers: u32 = 1u32;

  // The same material, giving off 'color' times 'strength' (a radiance)
  pub extern fn glowing(self, color: Color, strength: f32) Material;
