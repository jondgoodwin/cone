  // is made without, one line says so, and the HeadsetGpu's 'device.rayTracing' is false.
  pub rayTracing: bool = false;
}

// The GPU a headset's runtime chose and the program draws with: made by
// 'Headset.open' into one the caller made first (see above)
pub struct HeadsetGpu {
  pub device: Device;
  pub adapter: Adapter;
  pub instance: Instance;

  // Nothing yet: what 'Headset.open' fills in
