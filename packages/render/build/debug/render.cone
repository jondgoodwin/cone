// ---- Fixed foveated rendering for a headset's eyes ----
//
// A headset's lens sharpens the middle of what the eye sees and blurs the edges, and the eye itself resolves
// the middle only. So each eye's main lit pass can shade its periphery in coarser blocks (a 2 x 2 block of pixels
// shares one run of the fragment shader) at no loss the wearer can find, and the pass, which is bound by shading,
// takes less time. The depth is still tested and written at every pixel, so edges and occlusion stay exact; only
// the shading inside a triangle is shared.
//
// It is fixed, not eye-tracked: bands of angle off the axis of the eye's own lens, which is NOT the middle of its
// image (the four angles of an eye's field of view are not symmetric: the lens is nearer the nose than the image's
// edge). Each eye has an image of one byte a tile (the GPU's 'shadingRateTexelWidth' by 'Height' pixels, 8 x 8 to 16 x 16),
// made once from that eye's four field-of-view tangents, so the bands mean degrees, not pixels. The byte is the size
// of the fragment there, (log2 width) * 4 + (log2 height): 0 full rate, 5 is 2 x 2, 10 is 4 x 4. A tile is
// judged by its point nearest the axis, so a tile that is partly inside a band is shaded as the inner band.
//
// What a program does, with a headset opened with 'HeadsetOptions.foveation' (device.fragmentShadingRate):
//   let fovea = Foveation.make(FoveationLevel.Medium);           // once
//   fovea.prepare(&mut device, &frame, headset.eyeWidth, headset.eyeHeight);   // each located frame (cheap: made once)
//   renderer.setShadingRate(&device, fovea.rate(eye), fovea.texelWidth, fovea.texelHeight);
//   renderer.render(...);                                      // its main lit pass only
//   renderer.clearShadingRate();
// The shadows, the captures, the mirrors' pictures, the post-processing, a program's passes after 'render' and the
// window's mirror are not shaded by it.

// How much of the periphery is shaded coarsely
pub enum FoveationLevel {
  Off, Low, Medium, High;

  // The level a name spells ("off", "low", "medium", "high"), or None for anything else
  pub fn named(name: &str) Option[FoveationLevel] {
    if name == "off" { return Some[FoveationLevel](FoveationLevel.Off); }
    if name == "low" { return Some[FoveationLevel](FoveationLevel.Low); }
    if name == "medium" { return Some[FoveationLevel](FoveationLevel.Medium); }
    if name == "high" { return Some[FoveationLevel](FoveationLevel.High); }
    None
  }

  pub extern fn name(self: FoveationLevel) &str;
//#line 46 "foveation.cone"
}

