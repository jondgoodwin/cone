//#line 1 "shrinkwrap.cone"
// ======== Shrinkwrap and Project All: one surface laid onto another ========
//
// 'shrinkwrap' moves each vertex of a mesh to a place on a target surface
// (a SurfaceIndex, see surface.cone), as Blender's Shrinkwrap modifier does,
// and returns the mesh with its topology and every channel as they were. Its
// modes, the options from Blender's manual (the geometry worked out here):
//
// - ShrinkNearestSurface: the vertex goes to the nearest point of the target.
// - ShrinkProject: a ray from the vertex along a direction, forwards
//   ('positive'), backwards ('negative') or both (the nearer hit wins; with
//   neither the vertex stays). The direction is the one given (any vector:
//   an axis, a diagonal, a view), or each vertex's own unit normal where the
//   given one is (0, 0, 0). 'cull' ignores the target's faces that face the
//   ray (CullFront) or face away (CullBack), as Blender's Cull Faces.
// - ShrinkNearestVertex: the nearest vertex of the target that a face uses.
// - ShrinkTargetNormal: the point of the target whose interpolated normal
//   line passes through the vertex (Blender's Target Normal Project; see
//   'targetNormal' in surface.cone).
// A vertex whose search finds nothing within 'limit' (Blender's Distance; 0
// or less: no limit) stays where it is.
//
// WHERE ON THE LINE (the wrap method, Blender's Snap Mode), with the hit q, p
// the vertex, 'back' the unit vector from q towards p (against the ray for a
// projection), n the target triangle's unit normal and ns its normal
// interpolated from the vertex normals; 'offset' is Blender's:
// - WrapOnSurface: q + offset back: the vertex lands on the side it came from.
// - WrapOutsideSurface: q + offset n, always on the normal's side.
// - WrapInsideSurface: q - offset n, always against the normal.
// - WrapOutside: the vertex stays where it is if it is already more than
//   'offset' outside (on the normal's side of the plane through q); else it
//   goes to q + offset n. Nothing is pulled in, everything is kept out.
// - WrapInside: the mirror: a vertex already more than 'offset' inside stays;
//   else it goes to q - offset n.
// - WrapAboveSurface: q + offset ns, the smooth normal, so a sheet laid on a
//   rounded form follows it without the facets' steps.
// At a point where the two directions agree (back is (0, 0, 0) because p is on
// the surface) n stands for back.
//
// THE WEIGHT: a vertex channel named by the caller ("" for none) scales how
// far each vertex goes (0 stays, 1 lands), as Blender's vertex group does; a
// name with no such vertex channel weighs every vertex 1.
//
// 'projectAll' is ZBrush's Project All: a retopologised mesh (the target) laid
// onto the detailed mesh it was made from (the source). Each vertex casts a
// ray along its own unit normal, both ways, within 'distance' (ZBrush's Dist),
// to the source; the nearer hit is where it goes, and a vertex whose rays both
// miss goes to the source's nearest point within 'distance'; one with no
// source within it stays. The source's channels are carried to the result, as
// ZBrush carries polypaint, by interpolation across the hit triangle
// (projectAllWith, 'keepChannels'). Level by level, as ZBrush does after a
// subdivision, is this called again at each level.
//
// FAST ENOUGH TO HYDRATE: one query is a walk down a tree of boxes that skips
// everything beyond the best answer so far; examples/project.cone times 20,000
// vertices onto 100,000 triangles for each mode.

pub const ShrinkNearestSurface = 0u32;
pub const ShrinkProject = 1u32;
pub const ShrinkNearestVertex = 2u32;
pub const ShrinkTargetNormal = 3u32;

pub const WrapOnSurface = 0u32;
pub const WrapInsideSurface = 1u32;
pub const WrapOutsideSurface = 2u32;
pub const WrapOutside = 3u32;
pub const WrapInside = 4u32;
pub const WrapAboveSurface = 5u32;

pub struct Shrinkwrap {
  pub mode: u32;
  pub wrap: u32;
  pub offset: f32;
  pub limit: f32;
  pub direction: Vec3;
  pub positive: bool;
  pub negative: bool;
  pub cull: u32;

  // Each mode with Blender's defaults: on the surface, no offset or limit
  pub extern fn nearestSurface() Shrinkwrap;
//#line 83 "shrinkwrap.cone"
  // Along 'direction', both ways; (0, 0, 0) for each vertex's own normal
  pub extern fn project(direction: Vec3) Shrinkwrap;
//#line 87 "shrinkwrap.cone"
  pub extern fn nearestVertex() Shrinkwrap;
//#line 90 "shrinkwrap.cone"
  pub extern fn targetNormal() Shrinkwrap;
//#line 93 "shrinkwrap.cone"
}

