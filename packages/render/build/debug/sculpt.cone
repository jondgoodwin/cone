// reported in 'problems', and the levels below it are not made, so the
// result may have fewer levels than asked, none at all if even the first
// failed (then its base is a copy of the dense mesh).
pub extern fn fromDense(dense: &PolyMesh, levels: u32, problems: &mut List[String]) Multires;
