// mirrored about 'symmetry''s plane (DecimateSymmetryNone, X, Y or Z), each
// vertex's quadric scaled by its value in the f32 vertex channel named
// 'weight' ("" for none)
pub extern fn decimateWith(m: &PolyMesh, faces: u32, maxError: f32, symmetry: u32, weight: &str) Decimated;
