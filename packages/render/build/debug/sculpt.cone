// ======== Lattice: free-form deformation ========
//
// A lattice (Sederberg and Parry, "Free-form deformation of solid geometric
// models", SIGGRAPH 1986; Blender's Lattice object and modifier) is a box
// and a grid of control points over it. The box is spanned from 'origin' by
// three axis vectors, sAxis, tAxis and uAxis (any three that are not
// coplanar, so the box may be sheared): a point's local coordinates (s, t,
// u) say where it is in the box, origin + sAxis s + tAxis t + uAxis u, each
// 0 to 1 across it. The grid has l, m and n points along the three axes (2
// or more each), control point (i, j, k) resting at
//     origin + sAxis i / (l - 1) + tAxis j / (m - 1) + uAxis k / (n - 1),
// the regular grid, numbered i + l (j + m k). Moving control points reshapes
// whatever lies in the box: a few numbers ("pull this corner up") reshape a
// dense mesh.
//
// 'latticeDeform' moves each vertex by the weighted sum of the control
// points' moves from their rest positions:
//     p' = p + sum over (i, j, k) of Wi(s) Wj(t) Wk(u) (P(i,j,k) - R(i,j,k)),
// R the regular grid, the weights one of three interpolations:
// - LatticeBernstein: the Bernstein polynomials of degree l - 1 (and m - 1,
//   n - 1), Wi(s) = C(l - 1, i) s^i (1 - s)^(l - 1 - i): the Bezier volume,
//   Sederberg and Parry's FFD, every control point pulling on the whole box;
// - LatticeLinear: trilinear in the grid's cell holding the point, the
//   eight corners of its cell weighted by the point's place in it;
// - LatticeBSpline: the clamped uniform B-spline of degree min(3, l - 1),
//   its knots 0 repeated degree + 1 times, then evenly spaced, then 1
//   repeated as often, so it passes through the box's corner control points
//   and is cubic and smooth inside, each control point pulling on a few
//   cells round it. With 2 points it is the linear one, with 3 (or 4) the
//   Bernstein one.
// Each interpolation's weights sum to 1, and the Bernstein and linear ones
// reproduce linear functions, so for them p' is the classic sum of W P
// itself; the B-spline's control points would have to sit at its Greville
// abscissae to reproduce the box, not the regular grid, so the deformation
// is made from the moves, and for every interpolation a lattice whose points
// have not moved gives the mesh back with its bits unchanged.
//
// A vertex outside the box is moved as the nearest point of the box in
// local coordinates is: s, t and u are each held to 0 to 1 for the weights,
// so it is carried with the box's face, edge or corner nearest it, and the
// deformation is continuous across the box's surface. Blender's manual does
// not say what its lattice does outside; this is the deterministic choice.
//
// The topology is unchanged, so every attribute channel is carried over as
// it was and only the positions move (deform.cone's 'withPositions'). A box
// with no volume gives the mesh back unchanged.

pub const LatticeBernstein = 0u32;
pub const LatticeLinear = 1u32;
pub const LatticeBSpline = 2u32;

// A box from 'origin' spanned by three axis vectors, and its l x m x n
// control points, numbered i + l (j + m k)
pub struct Lattice {
  pub origin: Vec3;
  pub sAxis: Vec3;
  pub tAxis: Vec3;
  pub uAxis: Vec3;
  pub l: u32;
  pub m: u32;
  pub n: u32;
  pub points: List[Vec3];

  // The regular lattice: l x m x n control points (each held to at least 2)
  // at their rest positions, evenly over the box
  pub extern fn regular(origin: Vec3, sAxis: Vec3, tAxis: Vec3, uAxis: Vec3, l: u32, m: u32, n: u32) Lattice;
//#line 86 "lattice.cone"

  // The number of control point (i, j, k)
  pub extern fn index(self: &, i: u32, j: u32, k: u32) usize;

  // Where control point (i, j, k) rests, on the regular grid
  pub extern fn rest(self: &, i: u32, j: u32, k: u32) Vec3;

  // Where control point (i, j, k) is
  pub extern fn point(self: &, i: u32, j: u32, k: u32) Vec3;

  // Control point (i, j, k) put at p
  pub extern fn setPoint(self: &mut, i: u32, j: u32, k: u32, p: Vec3);
//#line 101 "lattice.cone"

  // Control point (i, j, k) moved by delta
  pub extern fn movePoint(self: &mut, i: u32, j: u32, k: u32, delta: Vec3);
//#line 108 "lattice.cone"
}

