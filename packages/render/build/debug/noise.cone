// -------- domain warp --------
//
// Inigo Quilez's two-level warp: f(p + s r), where r = (f(p + s q + c2),
// f(p + s q + c3)) and q = (f(p), f(p + c1)), f an fBm of 'octaves' (lacunarity
// 2, gain 0.5) and s the 'strength' (Quilez uses 4). The offsets c1..c3 only
// decorrelate the channels; they are exact in binary (quarters), so every
// machine reads the same numbers. The value only: no derivative.

pub extern fn warp2(p: Vec2, seed: u32, octaves: i32, strength: f32) f32;
//#line 114 "fractal.cone"

pub extern fn warp3(p: Vec3, seed: u32, octaves: i32, strength: f32) f32;
//#line 127 "fractal.cone"

// -------- multiplicative cascade --------
//
// fBm whose octaves are weighted by a product: octave i's amplitude is
// gain^i times W_0 W_1 ... W_i, each W_j = 1 + intermittency * n_j(p), n_j a
// gradient noise at octave j's frequency on its own lattice (seeded by
// hash1(j, pcg(seed))). The W have mean 1, so on average this is fBm; but
// where a coarse octave's W happened to be large, every finer octave is
// large too, and where it was small they all stay small: calm stretches and
// clusters of detail (intermittency, a multifractal). An intermittency of 0 is
// fbm2 exactly; keep it at most 1 so no W is negative. The value only.
pub extern fn cascade2(p: Vec2, seed: u32, octaves: i32, lacunarity: f32, gain: f32, intermittency: f32) f32;

