//#line 1 "cellular.cone"
// ======== Cellular (Worley) noise: F1, F2 and the nearest cell's id ========
//
// One feature point per lattice cell, at the cell's middle moved by up to
// 'jitter' / 2 each way along each axis (jitter 1: anywhere in the cell;
// 0: a regular grid). F1 is the distance to the nearest feature point, F2
// to the second nearest, and the id is a hash of the nearest point's cell,
// a whole word, for choosing per cell (a color, a height, whether a thorn
// grows there) on integers.
//
// Which point is nearest is a decision, so it is taken on squared distances
// (additions, subtractions and multiplications only), visiting cells in one
// fixed order, a nearer point replacing only when strictly nearer: the same
// cell wins on every machine that computes the squared distances alike.
// Only the returned F1 and F2 take a square root.
//
// The search is exact: the 3 x 3 (or 3 x 3 x 3) cells about the point are
// visited first, then the ring beyond them (5 x 5, 5 x 5 x 5), skipping any
// cell whose jitter box is no nearer than the current F2. A point more than
// two cells away is at least 2 from the point, and F2 is less than that in
// 2-D, and in 3-D save in configurations of vanishing measure (the nearest
// two points each at the far side of its cell), where F2 is then the
// second nearest of those within the 5 x 5 x 5.

// A 2-D cellular noise's distances and nearest cell
pub struct Cell2 {
  pub f1: f32;          // distance to the nearest feature point
  pub f2: f32;          // distance to the second nearest
  pub id: u32;          // a hash of the nearest point's cell
  pub toNearest: Vec2;  // from the point to the nearest feature point
}

// A 3-D cellular noise's distances and nearest cell
pub struct Cell3 {
  pub f1: f32;
  pub f2: f32;
  pub id: u32;
  pub toNearest: Vec3;
}

//#line 46 "cellular.cone"
// 2-D cellular noise at 'p', feature points jittered by 'jitter' (0 to 1)
pub extern fn cellular2(p: Vec2, jitter: f32, seed: u32) Cell2;
//#line 97 "cellular.cone"

// 3-D cellular noise at 'p', feature points jittered by 'jitter' (0 to 1)
pub extern fn cellular3(p: Vec3, jitter: f32, seed: u32) Cell3;

//#line 1 "family.cone"
// ======== Families: dials drawn per individual, keyed by path ========
//
// A family of shapes is a table of dials, each a distribution; an individual
// is a number. Every random number an individual uses is a hash of (family
// seed, individual, dial), never the next draw of a stream, so adding a dial
// or an individual changes no other (the lesson of SpeedTree's per-node
// seeds and of Minecraft's chunk seeds).
//
// Independent jitter on every dial gives incoherent individuals, so each
// individual also has two latent numbers (familyLatents), and a dial moves
// with them by its loadings: "vigour" can lengthen, thicken and add ribs
// together. A dial's value is
//
//   mean + spread (first z0 + second z1 + own u),  held to [lo, hi],
//
// z0, z1 the individual's latents and u its own draw for this dial, each in
// [-1, 1). A latent is the sum of two uniform draws less 1 (triangular, so
// the middle is commoner than the edges); u is uniform. 'chance' reads the
// same dial as a probability, mean + spread (first z0 + second z1) held to
// [0, 1], against a uniform draw (Weber and Penn's paired value and
// variation, with correlated latents added).

pub struct FamilyDial is ShapeKeeping {
  pub mean: f32;
  pub spread: f32;
  pub first: f32;    // the loading on latent 0
  pub second: f32;   // the loading on latent 1
  pub own: f32;      // the loading on the dial's own draw
  pub lo: f32;
  pub hi: f32;

  // The dial's value for 'individual' of the family 'familySeed'
  pub extern fn draw(self: &, familySeed: u32, individual: u32, dial: u32, latents: Vec2) f32;
//#line 38 "family.cone"

  // The dial read as a chance, and whether this individual has it
  pub extern fn chance(self: &, familySeed: u32, individual: u32, dial: u32, latents: Vec2) bool;
//#line 45 "family.cone"
}

// An individual's two latent numbers, each in (-1, 1), triangular
pub extern fn familyLatents(familySeed: u32, individual: u32) Vec2;
