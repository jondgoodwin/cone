// The unit gradient by central differences, h either side ('gradient'),
// (1, 0, 0) where the field is flat. Central differences, not 'normal''s
// tetrahedron: the tetrahedron's error is first order in h (0.006 on the
// unit sphere at h = 0.0125, measured), the central differences' second
// (under 0.0002)
fn unitGradient[S: Shape](shape: &S, p: Vec3, h: f32) Vec3 {
  let g = gradient(shape, p, h);
  let len = len3(g);
  if len > 0. { g * (1. / len) } else { Vec3(1., 0., 0.) }
}

