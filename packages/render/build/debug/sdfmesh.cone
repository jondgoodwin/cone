  var v = 0usize;
  while v < positions.len() {
    var p = *positions[v];
    var r = 0u32;
    while r < relax {
      let d = shape.distance(p);
      let g = unitGradient(shape, p, h);
      evaluations = evaluations + 7u64;
      let lower = *cellOf[v];
      let upper = lower + Vec3(cs, cs, cs);
      p = Vec3(clampf(p.x - g.x * d, lower.x, upper.x), clampf(p.y - g.y * d, lower.y, upper.y),
        clampf(p.z - g.z * d, lower.z, upper.z));
      r = r + 1u32;
    }
    positions.set(v, p);
    normals.push(unitGradient(shape, p, h));
    evaluations = evaluations + 6u64;
    v = v + 1usize;
  }

  // The quads: one across each grid edge the surface crosses, its four
  // cells counterclockwise round the edge seen from the outside end
  var quads = List[u32]();
  z = 0usize;
  while z < pz {
    var y = 0usize;
    while y < py {
      var x = 0usize;
      while x < px {
        let at = x + px * (y + py * z);
        let inside = *values[at] < 0.;
        var a = 0usize;
        while a < 3usize {
          let u = (a + 1usize) % 3usize;
          let w = (a + 2usize) % 3usize;
          let pa = pickAxis(a, x, y, z);
          let pu = pickAxis(u, x, y, z);
          let pv = pickAxis(w, x, y, z);
          let na = pickAxis(a, nx, ny, nz);
          let nu = pickAxis(u, nx, ny, nz);
          let nv = pickAxis(w, nx, ny, nz);
          if pa < na && pu >= 1usize && pu < nu && pv >= 1usize && pv < nv {
            let step = pickAxis(a, 1usize, px, px * py);
            let across = *values[at + step] < 0.;
            if inside != across {
              // The four cells, counterclockwise about +a
              var vs = List[u32].withCapacity(4usize);
              var k = 0usize;
              while k < 4usize {
                let cu = if k == 1usize || k == 2usize { pu } else { pu - 1usize };
                let cv = if k >= 2usize { pv } else { pv - 1usize };
                var cx = 0usize;
                var cy = 0usize;
                var cz = 0usize;
                axisToXyz(a, pa, cu, cv, &mut cx, &mut cy, &mut cz);
                let cell = cx + nx * (cy + ny * cz);
                let config = u32.from(*configs[cell]);
                let e = u32.from(a) * 4u32 + u32.from(pu - cu) + 2u32 * u32.from(pv - cv);
                let piece = *tables.edgePiece[usize.from(config * 12u32 + e)];
                assertDebug(piece != NoPiece && *firstVertex[cell] != mesh.NoIndex);
                vs.push(*firstVertex[cell] + u32.from(piece));
                k = k + 1usize;
              }
              // Outward is +a when the lower end is inside
              if inside {
                quads.push(*vs[0usize]); quads.push(*vs[1usize]); quads.push(*vs[2usize]); quads.push(*vs[3usize]);
              } else {
                quads.push(*vs[0usize]); quads.push(*vs[3usize]); quads.push(*vs[2usize]); quads.push(*vs[1usize]);
              }
            }
          }
          a = a + 1usize;
        }
        x = x + 1usize;
      }
      y = y + 1usize;
    }
    z = z + 1usize;
  }
  SurfaceNet(positions, normals, quads, cs, u32.from(nx), u32.from(ny), u32.from(nz), evaluations, sampled,
    u32.from(blocksX * blocksY * blocksZ), blocksSkipped)
}

// Levels of detail: 'count' surface nets of the shape over 'box', the first
// (level 0, the finest) in cells 'finest' a side, each next in cells twice
// as large, sparse and relaxed 'relax' times. Each level is meshed on its
// own from the field (none is simplified from another), so each is as
// true to the shape as its cells allow; 'toMesh' makes each a mesh for a
// renderer's chain of levels
pub fn netLevels[S: Shape](shape: &S, box: Aabb3, finest: f32, count: u32, relax: u32) List[SurfaceNet] {
  var out = List[SurfaceNet].withCapacity(usize.from(count));
  var cell = finest;
  var i = 0u32;
  while i < count {
    out.push(surfaceNet(shape, box, cell, relax, true));
    cell = cell * 2.;
    i = i + 1u32;
  }
  out
}
