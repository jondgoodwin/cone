// gradient by its distance (towards the surface), kept inside its cell; 0
// leaves the average of the crossings. With 'sparse', blocks far from the
// surface are not sampled (the result is the same)
pub fn surfaceNet[S: Shape](shape: &S, box: Aabb3, cellSize: f32, relax: u32, sparse: bool) SurfaceNet {
  let tables = netTables();
  let cs = cellSize;
  let lo = box.min - Vec3(cs, cs, cs);
  let extent = box.max - box.min;
  let nx = usize.from(libc.ceilf(extent.x / cs)) + 2usize;
  let ny = usize.from(libc.ceilf(extent.y / cs)) + 2usize;
  let nz = usize.from(libc.ceilf(extent.z / cs)) + 2usize;
