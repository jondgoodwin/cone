  var needed = List[u8].withCapacity(points);
  var i = 0usize;
  while i < points {
    values.push(0.);
    needed.push(if sparse { 0u8 } else { 1u8 });
    i = i + 1usize;
  }
  let blocksX = (nx + NetBlock - 1usize) / NetBlock;
  let blocksY = (ny + NetBlock - 1usize) / NetBlock;
  let blocksZ = (nz + NetBlock - 1usize) / NetBlock;
  var blocksSkipped = 0u32;
  if sparse {
    var kz = 0usize;
    while kz < blocksZ {
      let z0 = kz * NetBlock;
      let z1 = if z0 + NetBlock < nz { z0 + NetBlock } else { nz };
      var ky = 0usize;
      while ky < blocksY {
        let y0 = ky * NetBlock;
        let y1 = if y0 + NetBlock < ny { y0 + NetBlock } else { ny };
        var kx = 0usize;
        while kx < blocksX {
          let x0 = kx * NetBlock;
          let x1 = if x0 + NetBlock < nx { x0 + NetBlock } else { nx };
          let centre = Vec3(lo.x + cs * 0.5 * f32.from(x0 + x1), lo.y + cs * 0.5 * f32.from(y0 + y1),
            lo.z + cs * 0.5 * f32.from(z0 + z1));
          let sx = f32.from(x1 - x0);
          let sy = f32.from(y1 - y0);
          let sz = f32.from(z1 - z0);
          let half = 0.5 * cs * sqrtf(sx * sx + sy * sy + sz * sz);
          let d = shape.distance(centre);
          evaluations = evaluations + 1u64;
          let far = d.abs() > half * 1.01;
          if far { blocksSkipped = blocksSkipped + 1u32; }
          var z = z0;
          while z <= z1 {
            var y = y0;
            while y <= y1 {
              var x = x0;
              while x <= x1 {
                let at = x + px * (y + py * z);
                if far {
                  if *needed[at] == 0u8 { values.set(at, d); }
                } else {
                  needed.set(at, 1u8);
                }
                x = x + 1usize;
              }
              y = y + 1usize;
            }
            z = z + 1usize;
          }
          kx = kx + 1usize;
        }
