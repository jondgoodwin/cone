      var x = 0usize;
      while x < nx {
        var config = 0u32;
        var c = 0u32;
        while c < 8u32 {
          let at = (x + usize.from(cornerBit(c, 0u32))) + px * ((y + usize.from(cornerBit(c, 1u32))) + py * (z + usize.from(cornerBit(c, 2u32))));
