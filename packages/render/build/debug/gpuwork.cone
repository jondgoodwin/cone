//#line 1 "job.cone"
// ---- Buffers and jobs: data made on the GPU, and work recorded over it ----

// The usage of every buffer gpuwork makes: bound as storage, written by
// uploads, and copied from (to read it back, or into another buffer)
const WORK_USAGE = BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC;

// A buffer holding 'words', 32-bit numbers (u32, i32 or f32 bits), in the
// GPU's own memory. The words are copied now, and into the buffer by the GPU
// ahead of whatever is submitted next. Check 'isValid'.
pub extern fn upload(device: &mut Device, words: &Array[u32]) Buffer;
//#line 16 "job.cone"

// A buffer holding one 'value', a struct of 32-bit numbers (or fixed arrays
// of them): what a kernel's by-value struct parameter is bound to, a small
// read-only storage buffer. Check 'isValid'.
pub fn uploadValue[T](device: &mut Device, value: &T) Buffer {
  let bytes = u64.from(mem.sizeof[T]());
  let buffer = device.createBuffer(if bytes == 0u64 { 4u64 } else { bytes }, WORK_USAGE);
  if bytes > 0u64 && buffer.isValid() { device.queue.writeBuffer(&buffer, 0u64, value as *u8, bytes); }
  buffer
}

// A buffer of 'count' words, every one zero: for a kernel to write. The
// zeros are written by the GPU ('queue.clearBuffer', a fill command), ahead
// of whatever is submitted next, as an upload is; none cross from the CPU.
// Check 'isValid'.
pub extern fn zeroed(device: &mut Device, count: usize) Buffer;
