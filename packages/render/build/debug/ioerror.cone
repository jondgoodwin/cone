// What went wrong, the same on every system. Three kinds are the I/O
// runtime's own as well as the system's: Cancelled (a cancel ended it),
// TimedOut (its deadline passed, or the system's own timeout) and Truncated
// (a received datagram longer than the room that took it)
pub enum IoErrorKind {
  NotFound,             // no file, folder or host of that name
  PermissionDenied,
  AlreadyExists,
  NotADirectory,
  IsADirectory,
  DirectoryNotEmpty,
  ReadOnlyFilesystem,
  StorageFull,          // the disk is full
  FileTooLarge,
  InvalidFilename,      // a name too long, or not a name the system takes
  CrossesDevices,       // a rename from one device to another
  ResourceBusy,         // in use, or a queue full (a lane's bound)
  ConnectionRefused,
  ConnectionReset,
  ConnectionAborted,
  NotConnected,
  AddressInUse,
  AddressNotAvailable,
  HostUnreachable,
  NetworkUnreachable,
  NetworkDown,
  BrokenPipe,           // a send on a connection the peer has closed
  TimedOut,             // the deadline passed, or the system's own timeout
  Cancelled,            // a cancel ended it, or the system aborted it
  Truncated,            // a datagram cut to the room of the buffer that took it
  InvalidInput,         // a handle that names nothing, a buffer with no room, a bad argument
  OutOfMemory,
  Unsupported,
  Other;

  // A few words for the kind, for a person: 'not found', 'connection refused'
  pub fn toText(self: &, out: &uni TextOut) { out <- IoErrorKind.words(*self); }
  fn words(k: IoErrorKind) &str {
    match k {
      case NotFound {"not found"}
      case PermissionDenied {"permission denied"}
      case AlreadyExists {"already exists"}
      case NotADirectory {"not a directory"}
      case IsADirectory {"is a directory"}
      case DirectoryNotEmpty {"directory not empty"}
      case ReadOnlyFilesystem {"read-only filesystem"}
      case StorageFull {"storage full"}
      case FileTooLarge {"file too large"}
      case InvalidFilename {"invalid filename"}
      case CrossesDevices {"crosses devices"}
      case ResourceBusy {"resource busy"}
      case ConnectionRefused {"connection refused"}
      case ConnectionReset {"connection reset"}
      case ConnectionAborted {"connection aborted"}
      case NotConnected {"not connected"}
      case AddressInUse {"address in use"}
      case AddressNotAvailable {"address not available"}
      case HostUnreachable {"host unreachable"}
      case NetworkUnreachable {"network unreachable"}
      case NetworkDown {"network down"}
      case BrokenPipe {"broken pipe"}
      case TimedOut {"timed out"}
      case Cancelled {"cancelled"}
      case Truncated {"truncated"}
      case InvalidInput {"invalid input"}
      case OutOfMemory {"out of memory"}
      case Unsupported {"unsupported"}
      case Other {"other"}
    }
  }
}

