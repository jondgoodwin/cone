// package that made it (iocore's IoError, fs's FsError, ...). Each system's
// numbers are sorted into kinds here, by a table of its own:
//
//   mod show;
//   import stdio use *;
//   import ioerror use *;
//
//   fn main() {
//     let k = osKind(#if #os == .windows {1225u32} #else {111u32});   // a refused connection
//     if k == IoErrorKind.ConnectionRefused {print <- toText(&k);}
//   }
//
//   IoErrorKind                  NotFound, PermissionDenied, ..., Cancelled, TimedOut, Truncated, Other
//   toText(&k)  String() <- k    a kind's words, for a person
//   osKind(code)                 the kind of the system's own error number: Windows' error number
//                                (GetLastError's, Winsock's, an NTSTATUS turned into one) on
//                                Windows; on Linux the errno, or a getaddrinfo failure's EAI_
//                                number kept as a u32 (gaiNumber)
//   errnoKind(e)                 the kind of a C library errno, on the system the program runs on
//   gaiNumber(rc)  gaiOf(code)  gaiFloor   a getaddrinfo failure (below 0) as a u32 and back
//   noAddress()                  the system's own number for a host name that has no address
//
// It is a leaf: it imports nothing, so a synchronous package (fs) and the
// asynchronous ones (iocore and what is over it) share one set of kinds.
//
// How the numbers are sorted. Rust's sorting, with these of Cone's own, so
// that one failure has one kind on both systems: the numbers a completion
// port gives for what Winsock's own calls name otherwise are sorted as those
// are (ERROR_CONNECTION_REFUSED as WSAECONNREFUSED; ERROR_NETNAME_DELETED, how
// a completion reads a reset, as WSAECONNRESET; ERROR_CONNECTION_ABORTED,
