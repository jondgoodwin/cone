// -------- round shapes --------

// A disc in the plane: the points no further than 'radius' from 'center'
pub struct Circle {
  pub center: Vec2;
  pub radius: f32;

  pub fn contains(self, p: Vec2) bool inline {p.distanceSquared(center) <= radius * radius}

  // The point of the disc nearest p: p itself when it is inside
  pub fn closestPoint(self, p: Vec2) Vec2 inline {
    let d = p - center;
    let len2 = d.lengthSquared();
    if len2 <= radius * radius {p} else {center + d * (radius / len2.sqrt())}
  }

  pub fn overlaps(self, o: Circle) bool inline {
    let r = radius + o.radius;
    center.distanceSquared(o.center) <= r * r
  }
}

// A ball in space: the points no further than 'radius' from 'center'
pub struct Sphere {
  pub center: Vec3;
  pub radius: f32;

  pub fn contains(self, p: Vec3) bool inline {p.distanceSquared(center) <= radius * radius}

  // The point of the ball nearest p: p itself when it is inside
  pub fn closestPoint(self, p: Vec3) Vec3 inline {
    let d = p - center;
    let len2 = d.lengthSquared();
    if len2 <= radius * radius {p} else {center + d * (radius / len2.sqrt())}
  }

  pub fn overlaps(self, o: Sphere) bool inline {
    let r = radius + o.radius;
    center.distanceSquared(o.center) <= r * r
  }

  // Whether the ball and the box share any point
  pub fn overlapsAabb(self, b: Aabb3) bool inline {
    b.closestPoint(center).distanceSquared(center) <= radius * radius
  }
}

