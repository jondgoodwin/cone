// A rectangle in the plane: its corner at (x, y), 'w' wide and 'h' high. It
// holds its left and bottom edges but not its right and top, so rectangles
// laid side by side share no point
pub struct Rect is ShapeKeeping {
  pub x: f32;
  pub y: f32;
  pub w: f32;
  pub h: f32;

