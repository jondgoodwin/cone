}

// A position in 64 bits, for a world too large for f32 (whose step is about a
// metre ten thousand kilometres out). Work near a place is done in f32 relative
// to it: 'relativeTo' gives that, and adding a Vec3 comes back
pub struct DVec3 {
  pub x: f64;
  pub y: f64;
  pub z: f64;

  // The same point, widened
  pub fn from(v: Vec3) DVec3 inline {DVec3(f64.from(v.x), f64.from(v.y), f64.from(v.z))}

  // The same point, narrowed to f32
  pub fn toVec3(self) Vec3 inline {Vec3(f32.from(x), f32.from(y), f32.from(z))}

  // Where self is seen from 'origin', in f32
  pub fn relativeTo(self, origin: DVec3) Vec3 inline {(self - origin).toVec3()}

  pub fn add overload `+`(self, o: DVec3) DVec3 inline {DVec3(x + o.x, y + o.y, z + o.z)}
  pub fn addVec3 overload `+`(self, o: Vec3) DVec3 inline {DVec3(x + f64.from(o.x), y + f64.from(o.y), z + f64.from(o.z))}
  pub fn sub overload `-`(self, o: DVec3) DVec3 inline {DVec3(x - o.x, y - o.y, z - o.z)}
  pub fn neg overload `-`(self) DVec3 inline {DVec3(-x, -y, -z)}
  pub fn scale overload `*`(self, s: f64) DVec3 inline {DVec3(x * s, y * s, z * s)}
  pub fn dot(self, o: DVec3) f64 inline {x * o.x + y * o.y + z * o.z}
  pub fn length(self) f64 inline {(x * x + y * y + z * z).sqrt()}
  pub fn lengthSquared(self) f64 inline {x * x + y * y + z * z}
  pub fn distance(self, o: DVec3) f64 inline {(self - o).length()}
}
