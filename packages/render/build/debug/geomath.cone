  pub fn sub overload `-`(self, o: Vec4) Vec4 inline {Vec4(x - o.x, y - o.y, z - o.z, w - o.w)}
  pub fn neg overload `-`(self) Vec4 inline {Vec4(-x, -y, -z, -w)}
  pub fn scale overload `*`(self, s: f32) Vec4 inline {Vec4(x * s, y * s, z * s, w * s)}
