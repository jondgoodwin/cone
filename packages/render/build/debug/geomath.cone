  pub fn size(self) Vec2 inline {Vec2(w, h)}
  pub fn contains(self, p: Vec2) bool inline {p.x >= x && p.x < x + w && p.y >= y && p.y < y + h}
  pub extern fn toAabb(self) Aabb2;
}

// A rectangle of whole pixels: its corner at (x, y), 'w' wide and 'h' high,
