  pub fn union(self, o: Aabb3) Aabb3 inline {Aabb3(min.min(o.min), max.max(o.max))}

  // The smallest box holding self and the point p
  pub fn enclose(self, p: Vec3) Aabb3 inline {Aabb3(min.min(p), max.max(p))}

