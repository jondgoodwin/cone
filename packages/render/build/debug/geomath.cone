//#line 38 "shape.cone"

  pub fn isEmpty(self) bool inline {min.x > max.x || min.y > max.y || min.z > max.z}
  pub fn center(self) Vec3 inline {(min + max) * 0.5}
  pub fn size(self) Vec3 inline {max - min}
  pub fn halfExtents(self) Vec3 inline {(max - min) * 0.5}

