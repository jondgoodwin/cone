  pub fn lerp(self, to: Vec4, t: f32) Vec4 inline {self * (1. - t) + to * t}

  // x, y and z, dropping w
  pub fn xyz(self) Vec3 inline {Vec3(x, y, z)}

  pub extern fn equals(self, o: Vec4) bool;
