  pub fn dot(self, o: Vec4) f32 inline {x * o.x + y * o.y + z * o.z + w * o.w}
  pub fn length(self) f32 inline {(x * x + y * y + z * z + w * w).sqrt()}
  pub fn lengthSquared(self) f32 inline {x * x + y * y + z * z + w * w}

  // The vector of length 1 in the same direction; zero stays zero
  pub fn normalize(self) Vec4 inline {
    let len = length();
    if len > 0. {self * (1. / len)} else {self}
