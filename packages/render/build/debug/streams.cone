// the connection stays with the caller, whose connection it is (the limit being
// passed is the caller's to cancel for). It saves no copy: the result must be
// contiguous.

// Appends 'piece' to 'body' unless that would make it longer than 'limit'. True
// when it was appended; false when it was not (the body is as it was, and the
// caller ends the transfer, once)
pub extern fn gather(body: &mut String, piece: &Array[u8], limit: usize) bool;

