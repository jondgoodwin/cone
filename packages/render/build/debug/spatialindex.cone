// -------- small numeric helpers (geomath keeps its own private) --------

// The cell an f32 coordinate falls in on a grid of 'size' from 'origin'
// (kept within 21 bits either side of zero, so a key can pack three of them)
fn cellOf(x: f32, origin: f32, invSize: f32) i32 inline {
  let f = libc.floorf((x - origin) * invSize);
  let c = if f < -1048576. {-1048576.} else if f > 1048575. {1048575.} else {f};
  i32.from(c)
}

//#line 90 "common.cone"
// Squared distance from a point to a box (0 inside)
fn distSqPointBox(p: Vec3, b: Aabb3) f32 inline {
  let dx = (b.min.x - p.x).max(p.x - b.max.x).max(0.);
  let dy = (b.min.y - p.y).max(p.y - b.max.y).max(0.);
  let dz = (b.min.z - p.z).max(p.z - b.max.z).max(0.);
  dx * dx + dy * dy + dz * dz
}

fn containsBox(outer: Aabb3, inner: Aabb3) bool inline {
  outer.min.x <= inner.min.x && outer.min.y <= inner.min.y && outer.min.z <= inner.min.z
    && outer.max.x >= inner.max.x && outer.max.y >= inner.max.y && outer.max.z >= inner.max.z
}

// -------- frustum culling with plane masks --------

// All six planes still to be tested
pub const ALL_PLANES = 63u32;

// Tests a box against the planes named in 'mask' (bit i for plane i) and
// answers NONE if it is wholly outside one of them, otherwise the mask of the
// planes the box still straddles. A box inside a plane's half-space has every
// box within it inside it too, so a child is tested only against its parent's
// answer: the plane-coherency optimisation of Assarsson and Moller, "Optimized
// View Frustum Culling Algorithms for Bounding Boxes" (2000). The answers
// agree with Frustum.testAabb: NONE is Outside, 0 is Inside, else Intersecting.
extern fn cullMask(f: &Frustum, b: &Aabb3, mask: u32) u32;
