//#line 1 "grid.cone"
// ======== HashGrid: a uniform hash grid over items ========
//
// Space is cut into cubes of one size ('cellSize'); an item is listed in
// every cube its box touches, and a hash table maps a cube's coordinates to
// the head of its list (spatial hashing: Teschner et al. 2003, "Optimized
// Spatial Hashing for Collision Detection of Deformable Objects"; Ericson,
// Real-Time Collision Detection, ch. 7). The grid is unbounded: cubes exist
// only where items are. It is the right tool for very many small things of
// about one size; it degrades when items are much larger than a cube (each
// is listed in many) or crowd into few cubes (the lists grow long): the
// benchmarks show both.
//
// An item that would touch more than 'maxCells' cubes (default 512) is kept
// in a short list of oversize items instead, tested directly by every query.
// Queries that would cover more cubes than there are items fall back to
// scanning the items.
//
// An item in several cubes is reported once: box queries report it in the one
// cube holding the minimum corner of (its box meets the query's box); ray
// walks note the multi-cube items they have seen.

struct GridEntry {
  slot: u32;
  next: u32;
}

// A block of cubes: [x0..x1] x [y0..y1] x [z0..z1], inclusive
struct CellRange {
  x0: i32;
  y0: i32;
  z0: i32;
  x1: i32;
  y1: i32;
  z1: i32;

  extern fn volume(self) i64;
//#line 40 "grid.cone"
}

fn cellKey(x: i32, y: i32, z: i32) u64 inline {
  ((u64.from(x + 1048576i32) & 2097151u64) << 42u64) | ((u64.from(y + 1048576i32) & 2097151u64) << 21u64)
    | (u64.from(z + 1048576i32) & 2097151u64)
}

pub struct HashGrid[T: Copy] {
  items: Items[T];
  cells: Dict[u64, u32];     // cube -> first entry of its list
  entries: List[GridEntry];
  freeEntry: u32;
  size: f32;
  inv: f32;
  maxCells: i64;
  big: List[u32];            // oversize items' slots
  lo: Vec3;                  // cube range of everything listed in cubes (conservative: only grows)
  hi: Vec3;
  anyCells: bool;
  pairs: PairBook;
  moved: List[u32];
  pendingRemoved: List[Pair[T]];

  // A grid of cubes 'cellSize' on a side
  pub fn create(cellSize: f32) HashGrid[T] {
    HashGrid[T](Items[T].create(), Dict[u64, u32](), List[GridEntry](), NONE, cellSize,
      1. / cellSize, 512i64, List[u32](), Vec3(0., 0., 0.), Vec3(0., 0., 0.), false,
      PairBook.create(), List[u32](), List[Pair[T]]())
  }

  pub fn len(self: &) usize {items.count}
  pub fn contains(self: &, p: Proxy) bool {items.alive(p)}
  pub fn handle(self: &, p: Proxy) T {items.list[usize.from(p.slot)].handle}
  pub fn box(self: &, p: Proxy) Aabb3 {items.list[usize.from(p.slot)].box}
  pub fn pairBox(self: &, p: Proxy) Aabb3 {box(p)}

  // The number of cubes holding items
  pub fn cellCount(self: &) usize {cells.len()}

  fn rangeOf(self: &, b: Aabb3) CellRange {
    CellRange(cellOf(b.min.x, 0., inv), cellOf(b.min.y, 0., inv), cellOf(b.min.z, 0., inv),
      cellOf(b.max.x, 0., inv), cellOf(b.max.y, 0., inv), cellOf(b.max.z, 0., inv))
  }

  fn newEntry(self: &mut, slot: u32, next: u32) u32 {
    if freeEntry != NONE {
      let e = freeEntry;
      freeEntry = entries[usize.from(e)].next;
      entries[usize.from(e)].slot = slot;
      entries[usize.from(e)].next = next;
      return e;
    }
    entries.push(GridEntry(slot, next));
    u32.from(entries.len() - 1usize)
  }

  fn headOf(self: &, key: u64) u32 {
    var r = NONE;
    match cells.getCopy(&key) {
      case let Some(h) { r = h; }
      case is None { }
    }
    r
  }

  fn addToCells(self: &mut, slot: u32, b: Aabb3) {
    let si = usize.from(slot);
    let rg = rangeOf(b);
    if rg.volume() > maxCells {
      items.list[si].x = 0u32;
      items.list[si].y = u32.from(big.len());
      big.push(slot);
      return;
    }
    items.list[si].x = u32.from(rg.volume());
    items.list[si].y = NONE;
    if !anyCells {
      lo = Vec3(f32.from(rg.x0), f32.from(rg.y0), f32.from(rg.z0));
      hi = Vec3(f32.from(rg.x1), f32.from(rg.y1), f32.from(rg.z1));
      anyCells = true;
    }
    else {
      lo = lo.min(Vec3(f32.from(rg.x0), f32.from(rg.y0), f32.from(rg.z0)));
      hi = hi.max(Vec3(f32.from(rg.x1), f32.from(rg.y1), f32.from(rg.z1)));
    }
    var x = rg.x0;
    while x <= rg.x1 {
      var y = rg.y0;
      while y <= rg.y1 {
        var z = rg.z0;
        while z <= rg.z1 {
          let key = cellKey(x, y, z);
          let head = headOf(key);
          let e = newEntry(slot, head);
          cells.insert(key, e);
          z = z + 1i32;
        }
        y = y + 1i32;
      }
      x = x + 1i32;
    }
  }

  fn removeFromCells(self: &mut, slot: u32) {
    let si = usize.from(slot);
    if items.list[si].x == 0u32 {
      // oversize: out of the list, the last one taking its place
      let at = items.list[si].y;
      let last = big.len() - 1usize;
      let moved = *big[last];
      big.set(usize.from(at), moved);
      items.list[usize.from(moved)].y = at;
      big.truncate(last);
      return;
    }
    let rg = rangeOf(items.list[si].box);
    var x = rg.x0;
    while x <= rg.x1 {
      var y = rg.y0;
      while y <= rg.y1 {
        var z = rg.z0;
        while z <= rg.z1 {
          dropEntry(cellKey(x, y, z), slot);
          z = z + 1i32;
        }
        y = y + 1i32;
      }
      x = x + 1i32;
    }
  }

  fn dropEntry(self: &mut, key: u64, slot: u32) {
    var prev = NONE;
    var cur = headOf(key);
    while cur != NONE {
      let ci = usize.from(cur);
      if entries[ci].slot == slot {
        let next = entries[ci].next;
        if prev == NONE {
          if next == NONE {cells.remove(&key);}
          else {cells.insert(key, next);}
        }
        else {entries[usize.from(prev)].next = next;}
        entries[ci].next = freeEntry;
        freeEntry = cur;
        return;
      }
      prev = cur;
      cur = entries[ci].next;
    }
  }

  fn flagMoved(self: &mut, slot: u32) {
    if !items.list[usize.from(slot)].moved {
      items.list[usize.from(slot)].moved = true;
      moved.push(slot);
    }
  }

  pub fn insert(self: &mut, box: Aabb3, handle: T) Proxy {
    let p = items.add(box, handle);
    addToCells(p.slot, box);
    flagMoved(p.slot);
    p
  }

  pub fn remove(self: &mut, p: Proxy) bool {
    if !items.alive(p) {return false;}
    let si = usize.from(p.slot);
    removeFromCells(p.slot);
    var ended = List[u32]();
    pairs.forget(p.slot, &mut ended);
    let h = items.list[si].handle;
    var i = 0usize;
    while i < ended.len() {
      let o = *ended[i];
      pendingRemoved.push(pairOf(p.slot, h, o, items.list[usize.from(o)].handle));
      i = i + 1usize;
    }
    items.list[si].moved = false;
    items.release(p.slot);
    true
  }

  fn pairOf(self: &, sa: u32, ha: T, sb: u32, hb: T) Pair[T] {
    if sa < sb {
      Pair[T](ha, hb, items.proxyOf(sa), items.proxyOf(sb))
    }
    else {
      Pair[T](hb, ha, items.proxyOf(sb), items.proxyOf(sa))
    }
  }

  // The item has a new box; its cube lists change only if the cubes it
  // touches do. 'displacement' is accepted for the same call as the BVH's
  // and not used. Answers whether the lists changed.
  pub fn move(self: &mut, p: Proxy, box: Aabb3, displacement: Vec3) bool {
    if !items.alive(p) {return false;}
    let si = usize.from(p.slot);
    let a = rangeOf(items.list[si].box);
    let b = rangeOf(box);
    flagMoved(p.slot);
    if a.x0 == b.x0 && a.y0 == b.y0 && a.z0 == b.z0 && a.x1 == b.x1 && a.y1 == b.y1 && a.z1 == b.z1 {
      items.list[si].box = box;
      return false;
    }
    removeFromCells(p.slot);
    items.list[si].box = box;
    addToCells(p.slot, box);
    true
  }

  // ---------------- queries ----------------

  // The cubes' range of everything listed (an empty range if nothing is)
  fn populated(self: &) CellRange {
    if !anyCells {return CellRange(0i32, 0i32, 0i32, -1i32, -1i32, -1i32);}
    CellRange(i32.from(lo.x), i32.from(lo.y), i32.from(lo.z), i32.from(hi.x), i32.from(hi.y), i32.from(hi.z))
  }

  // Clips a range to the populated one
  fn clipRange(self: &, r: CellRange) CellRange {
    let p = populated();
    CellRange(if r.x0 > p.x0 {r.x0} else {p.x0}, if r.y0 > p.y0 {r.y0} else {p.y0},
      if r.z0 > p.z0 {r.z0} else {p.z0}, if r.x1 < p.x1 {r.x1} else {p.x1},
      if r.y1 < p.y1 {r.y1} else {p.y1}, if r.z1 < p.z1 {r.z1} else {p.z1})
  }

  // Whether walking the range's cubes costs less than scanning the items
  fn walkable(self: &, r: CellRange) bool {
    r.x0 <= r.x1 && r.y0 <= r.y1 && r.z0 <= r.z1 && r.volume() * 4i64 <= i64.from(items.count) + 16i64
  }

  pub fn overlapAabb[F: fn(h: T, p: Proxy) bool](self: &, box: Aabb3, visit: &mut F) {
    walkBox(box, 0i32, Sphere(Vec3(0., 0., 0.), 0.), visit);
  }

  pub fn overlapSphere[F: fn(h: T, p: Proxy) bool](self: &, s: Sphere, visit: &mut F) {
    let r = Vec3(s.radius, s.radius, s.radius);
    walkBox(Aabb3(s.center - r, s.center + r), 1i32, s, visit);
  }

  // The shared walk of the box and the sphere query: 'mode' 0 tests items
  // against the box, 1 against the ball (whose box is 'box').
  fn walkBox[F: fn(h: T, p: Proxy) bool](self: &, box: Aabb3, mode: i32, ball: Sphere, visit: &mut F) {
    let rg = clipRange(rangeOf(box));
    if walkable(rg) {
      var x = rg.x0;
      while x <= rg.x1 {
        var y = rg.y0;
        while y <= rg.y1 {
          var z = rg.z0;
          while z <= rg.z1 {
            var e = headOf(cellKey(x, y, z));
            while e != NONE {
              let slot = entries[usize.from(e)].slot;
              let it = items.list[usize.from(slot)];
              if hits(it.box, box, mode, ball) {
                // report in the cube of the minimum corner of the meeting of the two boxes
                let rx = cellOf(it.box.min.x.max(box.min.x), 0., inv);
                let ry = cellOf(it.box.min.y.max(box.min.y), 0., inv);
                let rz = cellOf(it.box.min.z.max(box.min.z), 0., inv);
                if rx == x && ry == y && rz == z {
                  if !visit(it.handle, Proxy(slot, it.gen)) {return;}
                }
              }
              e = entries[usize.from(e)].next;
            }
            z = z + 1i32;
          }
          y = y + 1i32;
        }
        x = x + 1i32;
      }
      var i = 0usize;
      while i < big.len() {
        let slot = *big[i];
        let it = items.list[usize.from(slot)];
        if hits(it.box, box, mode, ball) {
          if !visit(it.handle, Proxy(slot, it.gen)) {return;}
        }
        i = i + 1usize;
      }
    }
    else {
      var i = 0usize;
      while i < items.list.len() {
        if items.isLive(i) {
          let it = items.list[i];
          if hits(it.box, box, mode, ball) {
            if !visit(it.handle, Proxy(u32.from(i), it.gen)) {return;}
          }
        }
        i = i + 1usize;
      }
    }
  }

  fn hits(b: Aabb3, box: Aabb3, mode: i32, ball: Sphere) bool inline {
    if mode == 0i32 {b.overlaps(box)} else {ball.overlapsAabb(b)}
  }

  // Not wholly outside the frustum. A grid has no hierarchy to prune with:
  // cubes inside the populated range are tested (when that is fewer than the
  // items), otherwise every item is.
  pub fn frustum[F: fn(h: T, p: Proxy) bool](self: &, f: &Frustum, visit: &mut F) {
    let rg = populated();
    if walkable(rg) {
      var seen = Seen.create();
      var x = rg.x0;
      while x <= rg.x1 {
        var y = rg.y0;
        while y <= rg.y1 {
          var z = rg.z0;
          while z <= rg.z1 {
            let cb = Aabb3(Vec3(f32.from(x) * size, f32.from(y) * size, f32.from(z) * size),
              Vec3(f32.from(x + 1i32) * size, f32.from(y + 1i32) * size, f32.from(z + 1i32) * size));
            if cullMask(f, &cb, ALL_PLANES) != NONE {
              var e = headOf(cellKey(x, y, z));
              while e != NONE {
                let slot = entries[usize.from(e)].slot;
                let it = items.list[usize.from(slot)];
                if (it.x <= 1u32 || seen.mark(slot)) && cullMask(f, &it.box, ALL_PLANES) != NONE {
                  if !visit(it.handle, Proxy(slot, it.gen)) {return;}
                }
                e = entries[usize.from(e)].next;
              }
            }
            z = z + 1i32;
          }
          y = y + 1i32;
        }
        x = x + 1i32;
      }
      var i = 0usize;
      while i < big.len() {
        let slot = *big[i];
        let it = items.list[usize.from(slot)];
        if cullMask(f, &it.box, ALL_PLANES) != NONE {
          if !visit(it.handle, Proxy(slot, it.gen)) {return;}
        }
        i = i + 1usize;
      }
    }
    else {
      var i = 0usize;
      while i < items.list.len() {
        if items.isLive(i) {
          let it = items.list[i];
          if cullMask(f, &it.box, ALL_PLANES) != NONE {
            if !visit(it.handle, Proxy(u32.from(i), it.gen)) {return;}
          }
        }
        i = i + 1usize;
      }
    }
  }

  // As Bvh.rayCast. The ray walks cube by cube (Amanatides and Woo, "A Fast
  // Voxel Traversal Algorithm for Ray Tracing", 1987) through the populated
  // range, and ends when the next cube is beyond the reach in force.
  pub fn rayCast[F: fn(h: T, p: Proxy, t: f32) f32](self: &, ray: Ray3, maxT: f32, visit: &mut F) {
    let r = RayQ.from(ray);
    var limit = maxT;
    // oversize items first
    var i = 0usize;
    while i < big.len() {
      let slot = *big[i];
      let it = items.list[usize.from(slot)];
      let t = rayBox(&r, &it.box, limit);
      if t >= 0. {
        let res = visit(it.handle, Proxy(slot, it.gen), t);
        if res < 0. {return;}
        if res < limit {limit = res;}
      }
      i = i + 1usize;
    }
    if !anyCells {return;}
    let pb = Aabb3(lo * size, (hi + Vec3(1., 1., 1.)) * size);
    let t0 = rayBox(&r, &pb, limit);
    if t0 < 0. {return;}
    let start = ray.origin + ray.direction * t0;
    var ix = clampCell(cellOf(start.x, 0., inv), i32.from(lo.x), i32.from(hi.x));
    var iy = clampCell(cellOf(start.y, 0., inv), i32.from(lo.y), i32.from(hi.y));
    var iz = clampCell(cellOf(start.z, 0., inv), i32.from(lo.z), i32.from(hi.z));
    let dx = ray.direction.x;
    let dy = ray.direction.y;
    let dz = ray.direction.z;
    let sx = if dx > 0. {1i32} else if dx < 0. {-1i32} else {0i32};
    let sy = if dy > 0. {1i32} else if dy < 0. {-1i32} else {0i32};
    let sz = if dz > 0. {1i32} else if dz < 0. {-1i32} else {0i32};
    var tx = if sx == 0i32 {FAR} else {(f32.from(if sx > 0i32 {ix + 1i32} else {ix}) * size - ray.origin.x) / dx};
    var ty = if sy == 0i32 {FAR} else {(f32.from(if sy > 0i32 {iy + 1i32} else {iy}) * size - ray.origin.y) / dy};
    var tz = if sz == 0i32 {FAR} else {(f32.from(if sz > 0i32 {iz + 1i32} else {iz}) * size - ray.origin.z) / dz};
    let ddx = if sx == 0i32 {FAR} else {size / dx.abs()};
    let ddy = if sy == 0i32 {FAR} else {size / dy.abs()};
    let ddz = if sz == 0i32 {FAR} else {size / dz.abs()};
    let x0 = i32.from(lo.x);
    let x1 = i32.from(hi.x);
    let y0 = i32.from(lo.y);
    let y1 = i32.from(hi.y);
    let z0 = i32.from(lo.z);
    let z1 = i32.from(hi.z);
    var seen = Seen.create();
    while true {
      var e = headOf(cellKey(ix, iy, iz));
      while e != NONE {
        let slot = entries[usize.from(e)].slot;
        let it = items.list[usize.from(slot)];
        if it.x <= 1u32 || seen.mark(slot) {
          let t = rayBox(&r, &it.box, limit);
          if t >= 0. {
            let res = visit(it.handle, Proxy(slot, it.gen), t);
            if res < 0. {return;}
            if res < limit {limit = res;}
          }
        }
        e = entries[usize.from(e)].next;
      }
      // on to the next cube along the nearest boundary
      if tx <= ty && tx <= tz {
        if tx > limit {return;}
        ix = ix + sx;
        tx = tx + ddx;
        if ix < x0 || ix > x1 {return;}
      }
      else if ty <= tz {
        if ty > limit {return;}
        iy = iy + sy;
        ty = ty + ddy;
        if iy < y0 || iy > y1 {return;}
      }
      else {
        if tz > limit {return;}
        iz = iz + sz;
        tz = tz + ddz;
        if iz < z0 || iz > z1 {return;}
      }
    }
  }

  pub fn rayNearest(self: &, ray: Ray3, maxT: f32) Option[Hit[T]] {
    var best: Option[Hit[T]] = None;
    var grab = fn(h: T, p: Proxy, t: f32) f32 {
      best = Some(Hit[T](h, p, t));
      t
    };
    rayCast(ray, maxT, &mut grab);
    best
  }

  pub fn rayAll[F: fn(h: T, p: Proxy, t: f32) bool](self: &, ray: Ray3, maxT: f32, visit: &mut F) {
    var wrap = fn(h: T, p: Proxy, t: f32) f32 {
      if visit(h, p, t) {FAR} else {-1.}
    };
    rayCast(ray, maxT, &mut wrap);
  }

  // Keeps the best 'k' (nearest first) in 'out'
  fn offer(out: &mut List[Neighbor[T]], k: usize, n: Neighbor[T]) {
    if out.len() == k && n.distSq >= out[k - 1usize].distSq {return;}
    if out.len() < k {out.push(n);}
    else {out.set(k - 1usize, n);}
    var j = out.len() - 1usize;
    while j > 0usize && out[j - 1usize].distSq > out[j].distSq {
      out.swap(j - 1usize, j);
      j = j - 1usize;
    }
  }

  // The 'k' nearest by distance to the item's box, nearest first. Cubes are
  // searched in growing shells around the point's cube; a point outside the
  // populated range, or a search that would visit more cubes than there are
  // items, falls back to scanning the items.
  pub fn nearest(self: &, point: Vec3, k: usize, out: &mut List[Neighbor[T]]) {
    out.clear();
    if items.count == 0usize || k == 0usize {return;}
    var i = 0usize;
    while i < big.len() {
      let slot = *big[i];
      let it = items.list[usize.from(slot)];
      offer(out, k, Neighbor[T](it.handle, Proxy(slot, it.gen), distSqPointBox(point, it.box)));
      i = i + 1usize;
    }
    let pc = Vec3(f32.from(cellOf(point.x, 0., inv)), f32.from(cellOf(point.y, 0., inv)), f32.from(cellOf(point.z, 0., inv)));
    let inside = anyCells && pc.x >= lo.x && pc.x <= hi.x && pc.y >= lo.y && pc.y <= hi.y
      && pc.z >= lo.z && pc.z <= hi.z;
    var scanned = false;
    if inside {
      let cx = i32.from(pc.x);
      let cy = i32.from(pc.y);
      let cz = i32.from(pc.z);
      var seen = Seen.create();
      var r = 0i32;
      var visited = 0i64;
      // the farthest shell that can matter
      let rmax = (cx - i32.from(lo.x)).max(i32.from(hi.x) - cx).max((cy - i32.from(lo.y)).max(i32.from(hi.y) - cy)).max((cz - i32.from(lo.z)).max(i32.from(hi.z) - cz));
      while r <= rmax {
        visited = visited + (2i64 * i64.from(r) + 1i64) * (2i64 * i64.from(r) + 1i64) * (2i64 * i64.from(r) + 1i64);
        if visited * 4i64 > i64.from(items.count) + 16i64 && r > 0i32 {scanned = true; break;}
        var x = cx - r;
        while x <= cx + r {
          var y = cy - r;
          while y <= cy + r {
            var z = cz - r;
            while z <= cz + r {
              // only the shell: some coordinate at distance r
              let edge = x == cx - r || x == cx + r || y == cy - r || y == cy + r || z == cz - r || z == cz + r;
              if edge {
                var e = headOf(cellKey(x, y, z));
                while e != NONE {
                  let slot = entries[usize.from(e)].slot;
                  let it = items.list[usize.from(slot)];
                  if it.x <= 1u32 || seen.mark(slot) {
                    offer(out, k, Neighbor[T](it.handle, Proxy(slot, it.gen), distSqPointBox(point, it.box)));
                  }
                  e = entries[usize.from(e)].next;
                }
              }
              z = z + 1i32;
            }
            y = y + 1i32;
          }
          x = x + 1i32;
        }
        // nothing outside the shells so far is nearer than the faces of the block
        let gx = (point.x - f32.from(cx - r) * size).min(f32.from(cx + r + 1i32) * size - point.x);
        let gy = (point.y - f32.from(cy - r) * size).min(f32.from(cy + r + 1i32) * size - point.y);
        let gz = (point.z - f32.from(cz - r) * size).min(f32.from(cz + r + 1i32) * size - point.z);
        let bound = gx.min(gy.min(gz));
        if out.len() == k && out[k - 1usize].distSq <= bound * bound {return;}
        r = r + 1i32;
      }
      if !scanned {return;}
    }
    // scan everything (replacing what the shells found)
    out.clear();
    i = 0usize;
    while i < big.len() {
      let slot = *big[i];
      let it = items.list[usize.from(slot)];
      offer(out, k, Neighbor[T](it.handle, Proxy(slot, it.gen), distSqPointBox(point, it.box)));
      i = i + 1usize;
    }
    i = 0usize;
    while i < items.list.len() {
      if items.isLive(i) && items.list[i].x != 0u32 {
        let it = items.list[i];
        offer(out, k, Neighbor[T](it.handle, Proxy(u32.from(i), it.gen), distSqPointBox(point, it.box)));
      }
      i = i + 1usize;
    }
  }

  // ---------------- pairs ----------------

  fn queryBox(self: &, box: Aabb3, found: &mut List[u32]) {
    var collect = fn(h: T, p: Proxy) bool { found.push(p.slot); true };
    overlapAabb(box, &mut collect);
  }

  pub fn allPairs(self: &, out: &mut List[Pair[T]]) {
    var found = List[u32]();
    var i = 0usize;
    while i < items.list.len() {
      if items.isLive(i) {
        found.clear();
        queryBox(items.list[i].box, &mut found);
        var j = 0usize;
        while j < found.len() {
          let o = *found[j];
          if usize.from(o) > i {
            out.push(pairOf(u32.from(i), items.list[i].handle, o, items.list[usize.from(o)].handle));
          }
          j = j + 1usize;
        }
      }
      i = i + 1usize;
    }
  }

  pub fn updatePairs(self: &mut, events: &mut PairEvents[T]) {
    var i = 0usize;
    while i < pendingRemoved.len() {
      events.removed.push(*pendingRemoved[i]);
      i = i + 1usize;
    }
    pendingRemoved.clear();
    var found = List[u32]();
    var added = List[u32]();
    var ended = List[u32]();
    i = 0usize;
    while i < moved.len() {
      let m = *moved[i];
      let mi = usize.from(m);
      i = i + 1usize;
      if !items.isLive(mi) || !items.list[mi].moved {continue;}
      items.list[mi].moved = false;
      found.clear();
      added.clear();
      ended.clear();
      queryBox(items.list[mi].box, &mut found);
      pairs.sync(m, &found, &mut added, &mut ended);
      var j = 0usize;
      while j < added.len() {
        let o = *added[j];
        events.added.push(pairOf(m, items.list[mi].handle, o, items.list[usize.from(o)].handle));
        j = j + 1usize;
      }
      j = 0usize;
      while j < ended.len() {
        let o = *ended[j];
        events.removed.push(pairOf(m, items.list[mi].handle, o, items.list[usize.from(o)].handle));
        j = j + 1usize;
      }
    }
    moved.clear();
  }
}

fn clampCell(c: i32, lo: i32, hi: i32) i32 inline {
  if c < lo {lo} else if c > hi {hi} else {c}
}

//#line 1 "items.cone"
// ======== Items and pair bookkeeping shared by the three indexes ========

// One item: its box and handle, a generation that tells a stale Proxy from
// a live one (odd while the slot holds an item, even while it is free), and
// three words each index uses as it likes (the BVH keeps the leaf node in
// 'x'; the octree keeps node, next and previous in x, y, z; the grid keeps
// its cell count in x and its place in the oversize list in y). 'moved' says
// a pair update is owed.
struct Item[T: Copy] {
  box: Aabb3;
  handle: T;
  gen: u32;
  moved: bool;
  x: u32;
  y: u32;
  z: u32;
}

// A slot array of items with a free list, never shrunk; slots are dense, so
// per-item side tables can be indexed by slot
struct Items[T: Copy] {
  list: List[Item[T]];
  free: u32;     // head of the free list, through the free slots' 'x'
  count: usize;

  fn create() Items[T] {Items[T](List[Item[T]](), NONE, 0usize)}

  fn add(self: &mut, box: Aabb3, handle: T) Proxy {
    count = count + 1usize;
    if free != NONE {
      let slot = free;
      let si = usize.from(slot);
      free = list[si].x;
      list[si].box = box;
      list[si].handle = handle;
      list[si].gen = list[si].gen + 1u32;
      list[si].moved = false;
      list[si].x = NONE;
      list[si].y = NONE;
      list[si].z = NONE;
      return Proxy(slot, list[si].gen);
    }
    let slot = u32.from(list.len());
    list.push(Item[T](box, handle, 1u32, false, NONE, NONE, NONE));
    Proxy(slot, 1u32)
  }

  fn alive(self: &, p: Proxy) bool {
    if p.slot == NONE || usize.from(p.slot) >= list.len() {return false;}
    list[usize.from(p.slot)].gen == p.gen
  }

  // Frees the slot of a live proxy
  fn release(self: &mut, slot: u32) {
    let si = usize.from(slot);
    list[si].gen = list[si].gen + 1u32;
    list[si].x = free;
    free = slot;
    count = count - 1usize;
  }

  fn isLive(self: &, slot: usize) bool {(list[slot].gen & 1u32) == 1u32}

  fn proxyOf(self: &, slot: u32) Proxy {Proxy(slot, list[usize.from(slot)].gen)}
}

// ---- pairs ----
//
// Each item's current overlap partners, kept symmetric, so that after an
// item moves its new partners can be diffed against its old ones in time
// proportional to their number. 'sync' is given the slots that now overlap
// item 'm' and reports which pairs are new and which have ended.
struct PairBook {
  partners: List[List[u32]];
  mark: List[u32];
  oldMark: List[u32];
  stamp: u32;

  extern fn create() PairBook;
//#line 82 "items.cone"

  extern fn ensure(self: &mut, slot: u32);
//#line 90 "items.cone"

  extern fn removeFrom(self: &mut, owner: u32, other: u32);
//#line 104 "items.cone"

  extern fn sync(self: &mut, m: u32, found: &List[u32], added: &mut List[u32], ended: &mut List[u32]);
//#line 155 "items.cone"

  // Item 'm' is leaving: gives its partners (to report the pairs ending) and
  // forgets the pairs
  extern fn forget(self: &mut, m: u32, ended: &mut List[u32]);
//#line 170 "items.cone"
}

//#line 1 "octree.cone"
// ======== LooseOctree: a loose octree over items ========
//
// Ulrich's loose octree ("Loose Octrees", Game Programming Gems 1, 2000).
// A cell of half-size h holds the items whose CENTRE falls in it, and its
// loose bounds are the cell grown to half-size k*h (k = 2 by default). An
// item whose half-extent is at most (k-1)*h therefore fits wholly inside its
// cell's loose bounds wherever its centre lies in the cell, so each item
// lives in exactly one cell, the deepest one it fits, chosen from its size
// and centre alone: insertion, removal and moving are O(depth), with no
// splitting across cell borders and no tree rebuild.
//
// The tree covers a cube given at creation. The root cell takes anything
// that fits nowhere deeper, including items outside the cube, so every item
// is found whatever its place. Children are made when an item needs them and
// given back when their subtree empties. Items sit in a cell on a linked
// list threaded through the item records.

struct OctNode {
  first: u32;    // head of the cell's item list
  child: u32;    // the first of its eight children, in octant order; NONE if none
  parent: u32;
  count: u32;    // items in this cell and below
}

pub struct LooseOctree[T: Copy] {
  items: Items[T];
  nodes: List[OctNode];
  freeBlock: u32;   // a freed block of eight nodes, linked through their first's 'child'
  center: Vec3;
  half: f32;
  maxDepth: i32;
  k: f32;
  pairs: PairBook;
  moved: List[u32];
  pendingRemoved: List[Pair[T]];

  // A tree over the cube of half-size 'half' about 'center', whose cells
  // divide at most 'maxDepth' times, with looseness 'k' (1 < k <= 2; 2 is
  // usual)
  pub fn create(center: Vec3, half: f32, maxDepth: i32, k: f32) LooseOctree[T] {
    var nodes = List[OctNode]();
    nodes.push(OctNode(NONE, NONE, NONE, 0u32));
    LooseOctree[T](Items[T].create(), nodes, NONE, center, half, maxDepth, k, PairBook.create(),
      List[u32](), List[Pair[T]]())
  }

  pub fn len(self: &) usize {items.count}
  pub fn contains(self: &, p: Proxy) bool {items.alive(p)}
  pub fn handle(self: &, p: Proxy) T {items.list[usize.from(p.slot)].handle}
  pub fn box(self: &, p: Proxy) Aabb3 {items.list[usize.from(p.slot)].box}
  pub fn pairBox(self: &, p: Proxy) Aabb3 {box(p)}

  // The number of cells in use (the root included)
  pub fn cellCount(self: &) usize {
    var n = 1usize;
    var i = 1usize;
    while i < nodes.len() {
      if nodes[i].parent != NONE && nodes[i].count > 0u32 {n = n + 1usize;}
      i = i + 1usize;
    }
    n
  }

  fn loose(self: &, c: Vec3, h: f32) Aabb3 inline {
    let r = k * h;
    Aabb3(Vec3(c.x - r, c.y - r, c.z - r), Vec3(c.x + r, c.y + r, c.z + r))
  }

  fn childCenter(c: Vec3, h: f32, octant: u32) Vec3 inline {
    let q = h * 0.5;
    Vec3(if (octant & 1u32) != 0u32 {c.x + q} else {c.x - q},
      if (octant & 2u32) != 0u32 {c.y + q} else {c.y - q},
      if (octant & 4u32) != 0u32 {c.z + q} else {c.z - q})
  }

  fn octantOf(c: Vec3, p: Vec3) u32 inline {
    (if p.x >= c.x {1u32} else {0u32}) | (if p.y >= c.y {2u32} else {0u32})
      | (if p.z >= c.z {4u32} else {0u32})
  }

  fn makeChildren(self: &mut, n: u32) {
    let ni = usize.from(n);
    if nodes[ni].child != NONE {return;}
    var first = NONE;
    if freeBlock != NONE {
      first = freeBlock;
      freeBlock = nodes[usize.from(first)].child;
      var j = 0u32;
      while j < 8u32 {
        let x = usize.from(first + j);
        nodes[x].first = NONE;
        nodes[x].child = NONE;
        nodes[x].parent = n;
        nodes[x].count = 0u32;
        j = j + 1u32;
      }
    }
    else {
      first = u32.from(nodes.len());
      var j = 0u32;
      while j < 8u32 {
        nodes.push(OctNode(NONE, NONE, n, 0u32));
        j = j + 1u32;
      }
    }
    nodes[ni].child = first;
  }

  // The cell at 'level' on the way to the point: its node, centre, half-size
  fn descend(self: &mut, level: i32, p: Vec3, outC: &mut Vec3, outH: &mut f32) u32 {
    var node = 0u32;
    var c = center;
    var h = half;
    var l = 0i32;
    while l < level {
      makeChildren(node);
      let o = octantOf(c, p);
      c = childCenter(c, h, o);
      h = h * 0.5;
      node = nodes[usize.from(node)].child + o;
      l = l + 1i32;
    }
    *outC = c;
    *outH = h;
    node
  }

  // The cell an item with this box belongs in
  fn cellFor(self: &mut, b: Aabb3) u32 {
    let bc = b.center();
    let he = b.halfExtents();
    let e = he.x.max(he.y.max(he.z));
    var level = 0i32;
    var h = half;
    while level < maxDepth && (k - 1.) * (h * 0.5) >= e {
      h = h * 0.5;
      level = level + 1i32;
    }
    // the deepest level at or above that one whose loose bounds hold the box
    // (always, in floating point, at the root)
    while level > 0i32 {
      var c = center;
      var ch = half;
      var l = 0i32;
      while l < level {
        c = childCenter(c, ch, octantOf(c, bc));
        ch = ch * 0.5;
        l = l + 1i32;
      }
      if containsBox(loose(c, ch), b) {break;}
      level = level - 1i32;
    }
    var c0 = center;
    var h0 = half;
    descend(level, bc, &mut c0, &mut h0)
  }

  fn link(self: &mut, slot: u32, node: u32) {
    let si = usize.from(slot);
    let ni = usize.from(node);
    let head = nodes[ni].first;
    items.list[si].x = node;
    items.list[si].y = head;
    items.list[si].z = NONE;
    if head != NONE {items.list[usize.from(head)].z = slot;}
    nodes[ni].first = slot;
    var n = node;
    while n != NONE {
      nodes[usize.from(n)].count = nodes[usize.from(n)].count + 1u32;
      n = nodes[usize.from(n)].parent;
    }
  }

  fn unlink(self: &mut, slot: u32) {
    let si = usize.from(slot);
    let node = items.list[si].x;
    let next = items.list[si].y;
    let prev = items.list[si].z;
    if prev != NONE {items.list[usize.from(prev)].y = next;}
    else {nodes[usize.from(node)].first = next;}
    if next != NONE {items.list[usize.from(next)].z = prev;}
    var n = node;
    while n != NONE {
      let ni = usize.from(n);
      nodes[ni].count = nodes[ni].count - 1u32;
      if nodes[ni].count == 0u32 && nodes[ni].child != NONE {
        // its eight children are all empty: give the block back
        let blk = nodes[ni].child;
        nodes[usize.from(blk)].child = freeBlock;
        freeBlock = blk;
        nodes[ni].child = NONE;
      }
      n = nodes[ni].parent;
    }
  }

  fn flagMoved(self: &mut, slot: u32) {
    if !items.list[usize.from(slot)].moved {
      items.list[usize.from(slot)].moved = true;
      moved.push(slot);
    }
  }

  pub fn insert(self: &mut, box: Aabb3, handle: T) Proxy {
    let p = items.add(box, handle);
    link(p.slot, cellFor(box));
    flagMoved(p.slot);
    p
  }

  pub fn remove(self: &mut, p: Proxy) bool {
    if !items.alive(p) {return false;}
    let si = usize.from(p.slot);
    unlink(p.slot);
    var ended = List[u32]();
    pairs.forget(p.slot, &mut ended);
    let h = items.list[si].handle;
    var i = 0usize;
    while i < ended.len() {
      let o = *ended[i];
      pendingRemoved.push(pairOf(p.slot, h, o, items.list[usize.from(o)].handle));
      i = i + 1usize;
    }
    items.list[si].moved = false;
    items.release(p.slot);
    true
  }

  fn pairOf(self: &, sa: u32, ha: T, sb: u32, hb: T) Pair[T] {
    if sa < sb {
      Pair[T](ha, hb, items.proxyOf(sa), items.proxyOf(sb))
    }
    else {
      Pair[T](hb, ha, items.proxyOf(sb), items.proxyOf(sa))
    }
  }

  // The item has a new box. It stays in its cell if that is still the one it
  // belongs in. 'displacement' is accepted for the same call as the BVH's
  // and not used. Answers whether the item changed cell.
  pub fn move(self: &mut, p: Proxy, box: Aabb3, displacement: Vec3) bool {
    if !items.alive(p) {return false;}
    let si = usize.from(p.slot);
    items.list[si].box = box;
    let was = items.list[si].x;
    flagMoved(p.slot);
    // out first, so that emptied cells are given back before the new cell
    // is looked up (which may make some)
    unlink(p.slot);
    let target = cellFor(box);
    link(p.slot, target);
    target != was
  }

  // ---------------- queries ----------------

  pub fn overlapAabb[F: fn(h: T, p: Proxy) bool](self: &, box: Aabb3, visit: &mut F) {
    walkAabb(0u32, center, half, box, visit);
  }

  fn walkAabb[F: fn(h: T, p: Proxy) bool](self: &, node: u32, c: Vec3, h: f32, box: Aabb3, visit: &mut F) bool {
    let ni = usize.from(node);
    if nodes[ni].count == 0u32 {return true;}
    if node != 0u32 && !loose(c, h).overlaps(box) {return true;}
    var s = nodes[ni].first;
    while s != NONE {
      let it = items.list[usize.from(s)];
      if it.box.overlaps(box) {
        if !visit(it.handle, Proxy(s, it.gen)) {return false;}
      }
      s = it.y;
    }
    let ch = nodes[ni].child;
    if ch != NONE {
      var o = 0u32;
      while o < 8u32 {
        if !walkAabb(ch + o, childCenter(c, h, o), h * 0.5, box, visit) {return false;}
        o = o + 1u32;
      }
    }
    true
  }

  pub fn overlapSphere[F: fn(h: T, p: Proxy) bool](self: &, s: Sphere, visit: &mut F) {
    walkSphere(0u32, center, half, s, visit);
  }

  fn walkSphere[F: fn(h: T, p: Proxy) bool](self: &, node: u32, c: Vec3, h: f32, sp: Sphere, visit: &mut F) bool {
    let ni = usize.from(node);
    if nodes[ni].count == 0u32 {return true;}
    if node != 0u32 && !sp.overlapsAabb(loose(c, h)) {return true;}
    var s = nodes[ni].first;
    while s != NONE {
      let it = items.list[usize.from(s)];
      if sp.overlapsAabb(it.box) {
        if !visit(it.handle, Proxy(s, it.gen)) {return false;}
      }
      s = it.y;
    }
    let ch = nodes[ni].child;
    if ch != NONE {
      var o = 0u32;
      while o < 8u32 {
        if !walkSphere(ch + o, childCenter(c, h, o), h * 0.5, sp, visit) {return false;}
        o = o + 1u32;
      }
    }
    true
  }

  pub fn frustum[F: fn(h: T, p: Proxy) bool](self: &, f: &Frustum, visit: &mut F) {
    walkFrustum(0u32, center, half, ALL_PLANES, f, visit);
  }

  // 'mask' names the planes the parent cell straddled; the root's own bounds
  // are not tested (it holds whatever fits nowhere deeper, wherever it is),
  // so its items are tested against all six
  fn walkFrustum[F: fn(h: T, p: Proxy) bool](self: &, node: u32, c: Vec3, h: f32, mask: u32, f: &Frustum, visit: &mut F) bool {
    let ni = usize.from(node);
    if nodes[ni].count == 0u32 {return true;}
    var m = mask;
    if node != 0u32 && mask != 0u32 {
      m = cullMask(f, &loose(c, h), mask);
      if m == NONE {return true;}
    }
    var s = nodes[ni].first;
    while s != NONE {
      let it = items.list[usize.from(s)];
      if m == 0u32 || cullMask(f, &it.box, m) != NONE {
        if !visit(it.handle, Proxy(s, it.gen)) {return false;}
      }
      s = it.y;
    }
    let ch = nodes[ni].child;
    if ch != NONE {
      var o = 0u32;
      while o < 8u32 {
        if !walkFrustum(ch + o, childCenter(c, h, o), h * 0.5, m, f, visit) {return false;}
        o = o + 1u32;
      }
    }
    true
  }


  // As Bvh.rayCast: 'visit' answers the reach from then on, or a negative
  // number to stop. Cells are visited nearest first by the entry into their
  // loose bounds.
  pub fn rayCast[F: fn(h: T, p: Proxy, t: f32) f32](self: &, ray: Ray3, maxT: f32, visit: &mut F) {
    let r = RayQ.from(ray);
    var limit = maxT;
    walkRay(0u32, center, half, r, limit, visit);
  }

  fn walkRay[F: fn(h: T, p: Proxy, t: f32) f32](self: &, node: u32, c: Vec3, h: f32, r: RayQ, limit0: f32, visit: &mut F) f32 {
    var limit = limit0;
    let ni = usize.from(node);
    if nodes[ni].count == 0u32 {return limit;}
    if node != 0u32 && rayBox(&r, &loose(c, h), limit) < 0. {return limit;}
    var s = nodes[ni].first;
    while s != NONE {
      let it = items.list[usize.from(s)];
      let t = rayBox(&r, &it.box, limit);
      if t >= 0. {
        let res = visit(it.handle, Proxy(s, it.gen), t);
        if res < 0. {return -1.;}
        if res < limit {limit = res;}
      }
      s = it.y;
    }
    let ch = nodes[ni].child;
    if ch != NONE {
      // entry distances of the children's loose bounds, nearest first
      var ts = Array[f32, 8]() <- fill -1.;
      var order = Array[u32, 8]() <- fill 0u32;
      var n = 0usize;
      var o = 0u32;
      while o < 8u32 {
        if nodes[usize.from(ch + o)].count > 0u32 {
          let t = rayBox(&r, &loose(childCenter(c, h, o), h * 0.5), limit);
          if t >= 0. {
            // insertion sort by t
            var j = n;
            while j > 0usize && ts[j - 1usize] > t {
              ts[j] = ts[j - 1usize];
              order[j] = order[j - 1usize];
              j = j - 1usize;
            }
            ts[j] = t;
            order[j] = o;
            n = n + 1usize;
          }
        }
        o = o + 1u32;
      }
      var j = 0usize;
      while j < n {
        if ts[j] <= limit {
          let oc = order[j];
          limit = walkRay(ch + oc, childCenter(c, h, oc), h * 0.5, r, limit, visit);
          if limit < 0. {return -1.;}
        }
        j = j + 1usize;
      }
    }
    limit
  }

  pub fn rayNearest(self: &, ray: Ray3, maxT: f32) Option[Hit[T]] {
    var best: Option[Hit[T]] = None;
    var grab = fn(h: T, p: Proxy, t: f32) f32 {
      best = Some(Hit[T](h, p, t));
      t
    };
    rayCast(ray, maxT, &mut grab);
    best
  }

  pub fn rayAll[F: fn(h: T, p: Proxy, t: f32) bool](self: &, ray: Ray3, maxT: f32, visit: &mut F) {
    var wrap = fn(h: T, p: Proxy, t: f32) f32 {
      if visit(h, p, t) {FAR} else {-1.}
    };
    rayCast(ray, maxT, &mut wrap);
  }

  pub fn nearest(self: &, point: Vec3, k: usize, out: &mut List[Neighbor[T]]) {
    out.clear();
    if items.count == 0usize || k == 0usize {return;}
    var heap = MinHeap.create();
    heap.push(HeapEntry(0., 0u32, false, center, half));
    while heap.len() > 0usize && out.len() < k {
      let e = heap.pop();
      if e.isItem {
        let it = items.list[usize.from(e.id)];
        out.push(Neighbor[T](it.handle, Proxy(e.id, it.gen), e.key));
      }
      else {
        let ni = usize.from(e.id);
        var s = nodes[ni].first;
        while s != NONE {
          let it = items.list[usize.from(s)];
          heap.push(HeapEntry(distSqPointBox(point, it.box), s, true, e.c, 0.));
          s = it.y;
        }
        let ch = nodes[ni].child;
        if ch != NONE {
          var o = 0u32;
          while o < 8u32 {
            if nodes[usize.from(ch + o)].count > 0u32 {
              let cc = childCenter(e.c, e.h, o);
              heap.push(HeapEntry(distSqPointBox(point, loose(cc, e.h * 0.5)), ch + o, false, cc, e.h * 0.5));
            }
            o = o + 1u32;
          }
        }
      }
    }
  }

  // ---------------- pairs ----------------

  fn queryBox(self: &, box: Aabb3, found: &mut List[u32]) {
    var collect = fn(h: T, p: Proxy) bool { found.push(p.slot); true };
    overlapAabb(box, &mut collect);
  }

  pub fn allPairs(self: &, out: &mut List[Pair[T]]) {
    var found = List[u32]();
    var i = 0usize;
    while i < items.list.len() {
      if items.isLive(i) {
        found.clear();
        queryBox(items.list[i].box, &mut found);
        var j = 0usize;
        while j < found.len() {
          let o = *found[j];
          if usize.from(o) > i {
            out.push(pairOf(u32.from(i), items.list[i].handle, o, items.list[usize.from(o)].handle));
          }
          j = j + 1usize;
        }
      }
      i = i + 1usize;
    }
  }

  pub fn updatePairs(self: &mut, events: &mut PairEvents[T]) {
    var i = 0usize;
    while i < pendingRemoved.len() {
      events.removed.push(*pendingRemoved[i]);
      i = i + 1usize;
    }
    pendingRemoved.clear();
    var found = List[u32]();
    var added = List[u32]();
    var ended = List[u32]();
    i = 0usize;
    while i < moved.len() {
      let m = *moved[i];
      let mi = usize.from(m);
      i = i + 1usize;
      if !items.isLive(mi) || !items.list[mi].moved {continue;}
      items.list[mi].moved = false;
      found.clear();
      added.clear();
      ended.clear();
      queryBox(items.list[mi].box, &mut found);
      pairs.sync(m, &found, &mut added, &mut ended);
      var j = 0usize;
      while j < added.len() {
        let o = *added[j];
        events.added.push(pairOf(m, items.list[mi].handle, o, items.list[usize.from(o)].handle));
        j = j + 1usize;
      }
      j = 0usize;
      while j < ended.len() {
        let o = *ended[j];
        events.removed.push(pairOf(m, items.list[mi].handle, o, items.list[usize.from(o)].handle));
        j = j + 1usize;
      }
    }
    moved.clear();
  }
}
