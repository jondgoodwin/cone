// The framing around the DEFLATE data (RFC 1951)
pub enum Format {
  // The bare DEFLATE stream, no header and no checksum
  Raw;
  // RFC 1950: a two-byte header, the stream, the Adler-32 of the data
  Zlib;
  // RFC 1952: a header of 10 bytes or more, the stream, the CRC-32 and the
  // size of the data (modulo 2^32); several members one after another
  Gzip;
}

// What kind of thing was wrong with a compressed stream
pub enum ErrorKind is Sendable {
  // The zlib or gzip header is wrong, or asks for something not supported
  BadHeader;
  // A block header or a Huffman code description is invalid
  BadBlock;
  // A symbol that is not in the code, or a length or distance code that
  // does not exist
  BadCode;
  // A match that reaches back before the start of the output
  BadDistance;
  // The input ended before the stream did
  Truncated;
  // The Adler-32, the CRC-32 or the gzip size does not match
  BadChecksum;
  // More than a limit allows: output past setLimit, unread input past what the buffer pool will hold, or (a Deflater) output the pool had no room for
  TooLarge;
  // Bytes after the last gzip member that are not another member
  TrailingData;
}

