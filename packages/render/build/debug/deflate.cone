//#line 1 "compress.cone"
// ======== Deflating: RFC 1951, with RFC 1950 and RFC 1952 around it ========
//
// A 'Deflater' is a value that holds a stream's whole state. Bytes go in with
// 'feed' in pieces of any size, 'finish' says the input is over, and 'pull'
// answers the compressed bytes a bounded piece at a time. The compressed
// bytes are the same however the input was split: only the data decides them,
// not the pieces it came in (the matcher waits for 262 bytes of look-ahead
// before it decides a position, unless the input is finished).
//
// Levels (the same for every format):
//   0  stored blocks of at most 65535 bytes (no compression)
//   1  LZ77 with a hash chain of three-byte strings (one candidate a
//      position, a match entering only its first position in the chain),
//      coded with the fixed Huffman code of RFC 1951 3.2.6, in one block
//   2 to 9  the same chain with more candidates the higher the level
//      (6, 32, 16, 32, 128, 256, 512, 768: miniz_oxide's counts), lazy
//      matching from level 4 (below), every
//      position a match covers entered in the chain, coded with a dynamic
//      Huffman code per block of 32768 tokens (RFC 1951 3.2.7), the code
//      lengths built by the two-lightest merge of Huffman 1952 and limited
//      to 15 bits (7 for the code-length code) by flattening the frequencies
//      until they fit
// A negative level is the default, 6; a level over 9 acts as 9.
//
// The matcher of levels 1 to 3 is the classic greedy one (zlib's deflate_fast
// without the level tuning): at each position the longest match within a chain
// of candidates, taken if it is 3 bytes or longer. Levels 4 to 9 match lazily,
// as miniz_oxide does: a match of under 128 bytes is held back one position, and
// if the next position has a longer match the byte here is a literal and the
// longer match is taken (held in its turn). The window is the full 32 KiB.
// It is neither as fast as zlib nor as small, but a stream any inflater reads.
//
// What a streaming deflater does not do, and the one-shot helpers do: a
// stream whose compressed form is bigger than the data is not turned into
// stored blocks, because the end is not known when a block is written. The
// helpers 'rawDeflate', 'zlibCompress' and 'gzipCompress' store the whole
// input instead when that would be smaller, as imagedecode's writer always
// has.

// A bit writer: bits go in least-significant first
struct BitWriter {
  pub out: streams.Writer;
  pub acc: u64;
  pub n: u32;

  pub extern fn put(self: &mut, value: u32, bits: u32);
//#line 55 "compress.cone"

  // A Huffman code goes in most-significant bit first: 'code' is as 'makeCode' keeps
  // it, already bit-reversed
  pub extern fn putCode(self: &mut, code: u32, bits: u32);
//#line 61 "compress.cone"

  // Pad to a byte boundary
  pub extern fn align(self: &mut);
//#line 66 "compress.cone"
}

// A Huffman code for the encoder: bit length and canonical code of each symbol
struct Code {
  pub lens: List[u8];
  pub codes: List[u32];
}


