//#line 298 "deflater.cone"
// Everything about a stream being deflated. Make one with 'make', 'feed' it,
// 'finish' it when the input is over, 'pull' the output.
//
//   mut def = deflate.Deflater.make(deflate.Format.Gzip, 2);
//   mut out = IoBuf(65536usize);
//   def.feed(chunk);                         // any size, split anywhere
//   while true {
//     out.clear();
//     imm s = def.pull(&mut out);            // at most the buffer's room at a time
//     ... write out.view() ...
//     if s != deflate.Status.MoreOutput { break; }
//   }
//   // NeedInput: feed the next chunk, or def.finish() and pull until Done
pub struct Deflater {
  format: Format;
  level: i32;
  // The input window: buf holds the bytes from absolute position 'base' on;
  // 'cur' is the next position to deal with
  buf: List[u8];
  base: i64;
  cur: i64;
  head: List[i64];
  prev: List[i64];
  tokens: List[u32];
  // Levels 4 to 9: the lazy matcher's held match, found at position cur - 1
  // (length 0 for none) and not yet written
  savedLen: usize;
  savedDist: usize;
  // The output not yet delivered: bw.out holds it, in pool buffers from a
  // fallible Writer, so a pool that refuses a block fails the stream (TooLarge)
  // and never panics
  bw: BitWriter;
  started: bool;
  failed: bool;
  err: DeflateError;
  // Level 1: the single fixed block's header is written
  fixedOpen: bool;
  finishing: bool;
  done: bool;
  fixLit: Code;
  fixDist: Code;
  haveFixed: bool;
  // The input's checksums and size, for the trailer
  adler: Adler32;
  crc: Crc32;
  crcv: u32;
  inTotal: u64;
  gz: GzipHeader;
  outTotal: u64;

  // A deflater for 'format' at 'level' (0 stored; 1 fixed Huffman and the
  // fewest candidates; 2 to 9 dynamic Huffman and more candidates the higher;
