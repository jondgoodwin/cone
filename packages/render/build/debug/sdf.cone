// 'repeatAlong' on an arc, the same exact union, its cells' frames stepped
// round by rotation instead of by trigonometry
pub fn repeatAlongArc[S: Repeated](arc: &Arc, cells: &ArcCells, shape: &S, p: Vec3) f32 {
  let n = cells.count;
  // The copy whose origin is nearest
  var best: f32 = 3.4028235e38;
  var bestK = 0;
  var bestC = cells.firstCos;
  var bestS = cells.firstSin;
  var c = cells.firstCos;
  var s = cells.firstSin;
  var k = 0;
  while k < n {
    let o = arcCellFrame(arc, cells, k, c, s).origin - p;
    let dd = dot3(o, o);
    if dd < best {
      best = dd;
      bestK = k;
      bestC = c;
      bestS = s;
    }
    let nc = c * cells.turnCos - s * cells.turnSin;
    s = s * cells.turnCos + c * cells.turnSin;
    c = nc;
    k = k + 1;
  }
  let bu = (f32.from(bestK) + 0.5) / f32.from(n);
  var d = shape.repeatedDistance(arcCellFrame(arc, cells, bestK, bestC, bestS).toLocal(p), bestK, bu);
  // Every other copy whose ball is nearer than that
  c = cells.firstCos;
  s = cells.firstSin;
  k = 0;
  while k < n {
    if k != bestK {
      let u = (f32.from(k) + 0.5) / f32.from(n);
      let frame = arcCellFrame(arc, cells, k, c, s);
      let o = frame.origin - p;
      if mayBeNearer(dot3(o, o), shape.bound(k, u), d) {
        d = d.min(shape.repeatedDistance(frame.toLocal(p), k, u));
      }
    }
    let nc = c * cells.turnCos - s * cells.turnSin;
    s = s * cells.turnCos + c * cells.turnSin;
    c = nc;
    k = k + 1;
  }
  d
}

