//#line 1 "shape.cone"
// ======== Shape: anything with a distance, and its gradient ========
//
// A shape here is any value with a 'distance' method (the Shape trait,
// complied with structurally): a Horn, or a program's own struct. The
// functions that must ask a shape several times (the gradient, the normal,
// sdfmesh's mesher) take one generically.

pub trait Shape {
  fn distance(self: &, p: Vec3) f32;
}

// The field's gradient at p by central differences, h either side on each
// axis (six evaluations). A distance's gradient has length 1 wherever it is
// exact and smooth, at most 1 where it is a bound
pub fn gradient[S: Shape](shape: &S, p: Vec3, h: f32) Vec3 {
  let dx = shape.distance(Vec3(p.x + h, p.y, p.z)) - shape.distance(Vec3(p.x - h, p.y, p.z));
  let dy = shape.distance(Vec3(p.x, p.y + h, p.z)) - shape.distance(Vec3(p.x, p.y - h, p.z));
  let dz = shape.distance(Vec3(p.x, p.y, p.z + h)) - shape.distance(Vec3(p.x, p.y, p.z - h));
  let inv = 0.5 / h;
  Vec3(dx * inv, dy * inv, dz * inv)
}

// The surface normal at p: the gradient's direction, from four evaluations
// at the corners of a tetrahedron h across (Quilez,
// iquilezles.org/articles/normalsSDF); (1, 0, 0) where the field is flat
pub fn normal[S: Shape](shape: &S, p: Vec3, h: f32) Vec3 {
  let a = shape.distance(Vec3(p.x + h, p.y - h, p.z - h));
  let b = shape.distance(Vec3(p.x - h, p.y - h, p.z + h));
  let c = shape.distance(Vec3(p.x - h, p.y + h, p.z - h));
  let d = shape.distance(Vec3(p.x + h, p.y + h, p.z + h));
  let g = Vec3(a - b - c + d, 0. - a - b + c + d, 0. - a + b - c + d);
  let len = len3(g);
  if len > 0. { g * (1. / len) } else { Vec3(1., 0., 0.) }
}
