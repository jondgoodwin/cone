// A fence of one submission's ('device.createFence', then
// 'queue.submitSignalling' or 'queue.signal'), signalled once the GPU has
// finished it and everything submitted before it. Unlike a frame's fence it
// is never reset or reused, so a thread other than the device's may wait on
// it ('waitSignalled'): Vulkan's fence wait asks no synchronization of its fences.
// It declares Sendable, a promise taken on trust, for the device's handle
// it holds. Its end waits for it, if it was submitted, and destroys it; it
// must come before its Device's.
pub struct Fence is Move, Sendable {
  device: vulkan.Device;
  fns: DevFns;
  fence: vulkan.Fence;
  submitted: bool;

  pub extern fn isValid(self: &) bool;

  // Whether it was submitted ('submitSignalling', 'signal'), and so will
  // be signalled
  pub extern fn isSubmitted(self: &) bool;

  // Wait at most 'nanos' nanoseconds (0: not at all) for it to be
  // signalled: whether it is. False at once for one never submitted, which
  // nothing will signal.
  pub extern fn waitSignalled(self: &, nanos: u64) bool;
