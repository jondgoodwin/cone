// Two values of any Eq type are equal by '=='. Both are lent, so a type that moves
// (a String, a list) is compared where it is. A failure prints
// 'label: got <got>, want <want>', both sides in their debug form (core's toDebug:
// the type's own, or the one the compiler writes when asked).
pub fn expectEq[T: Eq](got: &T, want: &T, label: &Array[u8]) bool {
  if got == want {
    pass()
  } else {
    fail(label);
    stdio.print <- "got ", toDebug(got), ", want ", toDebug(want), "\n";
    false
  }
}

