pub const ERROR_FORMAT_NOT_SUPPORTED = -11i32;
pub const ERROR_FRAGMENTED_POOL = -12i32;
pub const ERROR_UNKNOWN = -13i32;
pub const ERROR_OUT_OF_POOL_MEMORY = -1000069000i32;
pub const ERROR_INVALID_EXTERNAL_HANDLE = -1000072003i32;
pub const ERROR_FRAGMENTATION = -1000161000i32;
pub const ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS = -1000257000i32;
