// VkClearValue is a C union of a color (four floats, ints or uints) and a
// depth-stencil pair. Cone has no C union, so it is its storage, 16 bytes,
// written through 'clearColor' and 'clearDepthStencil', which is the exact
// size, alignment and layout of C's. VkClearColorValue is the same storage.
pub struct ClearValue { pub raw: Array[u32, 4]; }
pub alias ClearColorValue = ClearValue;

pub extern fn clearColor(r: f32, g: f32, b: f32, a: f32) ClearValue;
//#line 22 "structs.cone"

pub extern fn clearDepthStencil(depth: f32, stencil: u32) ClearValue;
