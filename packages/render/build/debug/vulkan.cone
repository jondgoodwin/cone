// A VkResult's name, without the VK_ prefix; "unknown VkResult" for a value
// this package does not list
pub extern fn resultName(r: i32) &str;

//#line 1 "instancefns.cone"
// ---- The instance-level functions ----

// The functions of one instance, found for it by 'InstanceFns.load': those
