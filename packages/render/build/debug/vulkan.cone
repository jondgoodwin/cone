// ---- Results ----

// VkResult. 'resultName' spells one as the specification does.
pub const SUCCESS = 0i32;
pub const NOT_READY = 1i32;
pub const TIMEOUT = 2i32;
pub const EVENT_SET = 3i32;
pub const EVENT_RESET = 4i32;
pub const INCOMPLETE = 5i32;
pub const ERROR_OUT_OF_HOST_MEMORY = -1i32;
