// hardware, and the largest buffer. An output only, like Vulkan11Properties.
pub struct PhysicalDeviceVulkan13Properties {
  pub sType: u32 = STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_PROPERTIES;
  pub pNext: *u8 = null;
  pub minSubgroupSize: u32;
  pub maxSubgroupSize: u32;
  pub maxComputeWorkgroupSubgroups: u32;
  pub requiredSubgroupSizeStages: u32;
  pub maxInlineUniformBlockSize: u32;
  pub maxPerStageDescriptorInlineUniformBlocks: u32;
  pub maxPerStageDescriptorUpdateAfterBindInlineUniformBlocks: u32;
  pub maxDescriptorSetInlineUniformBlocks: u32;
  pub maxDescriptorSetUpdateAfterBindInlineUniformBlocks: u32;
  pub maxInlineUniformTotalSize: u32;
  pub integerDotProduct8BitUnsignedAccelerated: u32;
  pub integerDotProduct8BitSignedAccelerated: u32;
  pub integerDotProduct8BitMixedSignednessAccelerated: u32;
  pub integerDotProduct4x8BitPackedUnsignedAccelerated: u32;
  pub integerDotProduct4x8BitPackedSignedAccelerated: u32;
  pub integerDotProduct4x8BitPackedMixedSignednessAccelerated: u32;
  pub integerDotProduct16BitUnsignedAccelerated: u32;
  pub integerDotProduct16BitSignedAccelerated: u32;
  pub integerDotProduct16BitMixedSignednessAccelerated: u32;
  pub integerDotProduct32BitUnsignedAccelerated: u32;
  pub integerDotProduct32BitSignedAccelerated: u32;
  pub integerDotProduct32BitMixedSignednessAccelerated: u32;
  pub integerDotProduct64BitUnsignedAccelerated: u32;
  pub integerDotProduct64BitSignedAccelerated: u32;
  pub integerDotProduct64BitMixedSignednessAccelerated: u32;
  pub integerDotProductAccumulatingSaturating8BitUnsignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating8BitSignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating8BitMixedSignednessAccelerated: u32;
  pub integerDotProductAccumulatingSaturating4x8BitPackedUnsignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating4x8BitPackedSignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating4x8BitPackedMixedSignednessAccelerated: u32;
  pub integerDotProductAccumulatingSaturating16BitUnsignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating16BitSignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating16BitMixedSignednessAccelerated: u32;
  pub integerDotProductAccumulatingSaturating32BitUnsignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating32BitSignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating32BitMixedSignednessAccelerated: u32;
  pub integerDotProductAccumulatingSaturating64BitUnsignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating64BitSignedAccelerated: u32;
  pub integerDotProductAccumulatingSaturating64BitMixedSignednessAccelerated: u32;
  pub storageTexelBufferOffsetAlignmentBytes: u64;
  pub storageTexelBufferOffsetSingleTexelAlignment: u32;
  pub uniformTexelBufferOffsetAlignmentBytes: u64;
  pub uniformTexelBufferOffsetSingleTexelAlignment: u32;
  pub maxBufferSize: u64;
}

// vkGetPhysicalDeviceProperties2's structure: the properties, and 'pNext' the chain of the further ones asked for
pub struct PhysicalDeviceProperties2 {
  pub sType: u32 = STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
  pub pNext: *u8 = null;
  pub properties: PhysicalDeviceProperties;
}

pub struct QueueFamilyProperties {
  pub queueFlags: u32;
  pub queueCount: u32;
  pub timestampValidBits: u32;
  pub minImageTransferGranularity: Extent3D;
}

pub struct MemoryType { pub propertyFlags: u32; pub heapIndex: u32; }
pub struct MemoryHeap { pub size: u64; pub flags: u32; }

pub struct PhysicalDeviceMemoryProperties {
  pub memoryTypeCount: u32;
  pub memoryTypes: Array[MemoryType, 32];
  pub memoryHeapCount: u32;
  pub memoryHeaps: Array[MemoryHeap, 16];
}

// ---- Structs: device and queues ----

pub struct DeviceQueueCreateInfo {
  pub sType: u32 = STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
  pub pNext: *u8 = null;
  pub flags: u32 = 0u32;
  pub queueFamilyIndex: u32 = 0u32;
  pub queueCount: u32 = 0u32;
  pub pQueuePriorities: *f32;
}

pub struct DeviceCreateInfo {
  pub sType: u32 = STRUCTURE_TYPE_DEVICE_CREATE_INFO;
  pub pNext: *u8 = null;
  pub flags: u32 = 0u32;
  pub queueCreateInfoCount: u32 = 0u32;
  pub pQueueCreateInfos: *DeviceQueueCreateInfo;
  pub enabledLayerCount: u32 = 0u32;         // ignored since Vulkan 1.0.13
  pub ppEnabledLayerNames: **u8;
  pub enabledExtensionCount: u32 = 0u32;
  pub ppEnabledExtensionNames: **u8;
  pub pEnabledFeatures: *PhysicalDeviceFeatures;
}

// ---- Structs: surfaces and swapchains ----

pub struct SurfaceCapabilitiesKHR {
  pub minImageCount: u32;
  pub maxImageCount: u32;                 // 0: no limit
  pub currentExtent: Extent2D;            // 0xFFFFFFFF each way: the swapchain decides
  pub minImageExtent: Extent2D;
  pub maxImageExtent: Extent2D;
  pub maxImageArrayLayers: u32;
  pub supportedTransforms: u32;
  pub currentTransform: u32;
  pub supportedCompositeAlpha: u32;
  pub supportedUsageFlags: u32;
}

pub struct SurfaceFormatKHR { pub format: u32; pub colorSpace: u32; }

pub struct SwapchainCreateInfoKHR {
  pub sType: u32 = STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR;
  pub pNext: *u8 = null;
  pub flags: u32 = 0u32;
  pub surface: SurfaceKHR;
  pub minImageCount: u32 = 0u32;
  pub imageFormat: u32 = 0u32;
  pub imageColorSpace: u32 = 0u32;
  pub imageExtent: Extent2D;
  pub imageArrayLayers: u32 = 1u32;
  pub imageUsage: u32 = 0u32;
  pub imageSharingMode: u32 = SHARING_MODE_EXCLUSIVE;
  pub queueFamilyIndexCount: u32 = 0u32;
  pub pQueueFamilyIndices: *u32;
  pub preTransform: u32 = SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
  pub compositeAlpha: u32 = COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
  pub presentMode: u32 = PRESENT_MODE_FIFO_KHR;
  pub clipped: u32 = TRUE;
  pub oldSwapchain: SwapchainKHR;
}

pub struct PresentInfoKHR {
  pub sType: u32 = STRUCTURE_TYPE_PRESENT_INFO_KHR;
  pub pNext: *u8 = null;
  pub waitSemaphoreCount: u32 = 0u32;
  pub pWaitSemaphores: *Semaphore;
  pub swapchainCount: u32 = 0u32;
  pub pSwapchains: *SwapchainKHR;
  pub pImageIndices: *u32;
  pub pResults: *i32;
}

// ---- Structs: images ----

pub struct ComponentMapping {
  pub r: u32 = COMPONENT_SWIZZLE_IDENTITY;
  pub g: u32 = COMPONENT_SWIZZLE_IDENTITY;
  pub b: u32 = COMPONENT_SWIZZLE_IDENTITY;
  pub a: u32 = COMPONENT_SWIZZLE_IDENTITY;
}

pub struct ImageSubresourceRange {
  pub aspectMask: u32 = IMAGE_ASPECT_COLOR_BIT;
  pub baseMipLevel: u32 = 0u32;
  pub levelCount: u32 = 1u32;
  pub baseArrayLayer: u32 = 0u32;
  pub layerCount: u32 = 1u32;
}

pub struct ImageSubresourceLayers {
  pub aspectMask: u32 = IMAGE_ASPECT_COLOR_BIT;
  pub mipLevel: u32 = 0u32;
  pub baseArrayLayer: u32 = 0u32;
  pub layerCount: u32 = 1u32;
}

pub struct ImageCreateInfo {
  pub sType: u32 = STRUCTURE_TYPE_IMAGE_CREATE_INFO;
  pub pNext: *u8 = null;
  pub flags: u32 = 0u32;
  pub imageType: u32 = IMAGE_TYPE_2D;
  pub format: u32 = 0u32;
  pub extent: Extent3D;
  pub mipLevels: u32 = 1u32;
  pub arrayLayers: u32 = 1u32;
  pub samples: u32 = SAMPLE_COUNT_1_BIT;
  pub tiling: u32 = IMAGE_TILING_OPTIMAL;
  pub usage: u32 = 0u32;
  pub sharingMode: u32 = SHARING_MODE_EXCLUSIVE;
  pub queueFamilyIndexCount: u32 = 0u32;
  pub pQueueFamilyIndices: *u32;
  pub initialLayout: u32 = IMAGE_LAYOUT_UNDEFINED;
}

pub struct ImageViewCreateInfo {
  pub sType: u32 = STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
  pub pNext: *u8 = null;
  pub flags: u32 = 0u32;
  pub image: Image;
  pub viewType: u32 = IMAGE_VIEW_TYPE_2D;
  pub format: u32 = 0u32;
  pub components: ComponentMapping;
  pub subresourceRange: ImageSubresourceRange;
}

// VK_KHR_fragment_shading_rate: the features (chained to a device's create-info to enable them, or to
// vkGetPhysicalDeviceFeatures2 to ask) and the limits (chained to vkGetPhysicalDeviceProperties2)
pub struct PhysicalDeviceFragmentShadingRateFeaturesKHR {
  pub sType: u32 = STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADING_RATE_FEATURES_KHR;
  pub pNext: *u8 = null;
  pub pipelineFragmentShadingRate: u32 = 0u32;
  pub primitiveFragmentShadingRate: u32 = 0u32;
  pub attachmentFragmentShadingRate: u32 = 0u32;
}

pub struct PhysicalDeviceFragmentShadingRatePropertiesKHR {
  pub sType: u32 = STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADING_RATE_PROPERTIES_KHR;
  pub pNext: *u8 = null;
  pub minFragmentShadingRateAttachmentTexelSize: Extent2D = Extent2D(0u32, 0u32);
  pub maxFragmentShadingRateAttachmentTexelSize: Extent2D = Extent2D(0u32, 0u32);
  pub maxFragmentShadingRateAttachmentTexelSizeAspectRatio: u32 = 0u32;
  pub primitiveFragmentShadingRateWithMultipleViewports: u32 = 0u32;
  pub layeredShadingRateAttachments: u32 = 0u32;
  pub fragmentShadingRateNonTrivialCombinerOps: u32 = 0u32;
  pub maxFragmentSize: Extent2D = Extent2D(0u32, 0u32);
  pub maxFragmentSizeAspectRatio: u32 = 0u32;
  pub maxFragmentShadingRateCoverageSamples: u32 = 0u32;
  pub maxFragmentShadingRateRasterizationSamples: u32 = 0u32;
  pub fragmentShadingRateWithShaderDepthStencilWrites: u32 = 0u32;
  pub fragmentShadingRateWithSampleMask: u32 = 0u32;
  pub fragmentShadingRateWithShaderSampleMask: u32 = 0u32;
  pub fragmentShadingRateWithConservativeRasterization: u32 = 0u32;
  pub fragmentShadingRateWithFragmentShaderInterlock: u32 = 0u32;
  pub fragmentShadingRateWithCustomSampleLocations: u32 = 0u32;
  pub fragmentShadingRateStrictMultiplyCombiner: u32 = 0u32;
}
