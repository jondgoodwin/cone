// ======== Header fields: text, numbers, checksums ========


fn isCont(b: &Array[u8], i: usize) bool {
  i < b.len && (b[i] & 0xC0u8) == 0x80u8
}

// Whether the bytes are well-formed UTF-8 (RFC 3629: no overlong forms, no surrogates, nothing past
// U+10FFFF)
fn validUtf8(b: &Array[u8]) bool {
  var i = 0usize;
  while i < b.len {
    let c = u32.from(b[i]);
    if c < 0x80u32 {
      i += 1usize;
    } else if c >= 0xC2u32 && c <= 0xDFu32 {
      if !isCont(b, i + 1usize) { return false; }
      i += 2usize;
    } else if c >= 0xE0u32 && c <= 0xEFu32 {
      if !isCont(b, i + 1usize) || !isCont(b, i + 2usize) { return false; }
      let c1 = u32.from(b[i + 1usize]);
      if c == 0xE0u32 && c1 < 0xA0u32 { return false; }
      if c == 0xEDu32 && c1 > 0x9Fu32 { return false; }
      i += 3usize;
    } else if c >= 0xF0u32 && c <= 0xF4u32 {
      if !isCont(b, i + 1usize) || !isCont(b, i + 2usize) || !isCont(b, i + 3usize) { return false; }
      let c1 = u32.from(b[i + 1usize]);
      if c == 0xF0u32 && c1 < 0x90u32 { return false; }
      if c == 0xF4u32 && c1 > 0x8Fu32 { return false; }
      i += 4usize;
    } else {
      return false;
    }
  }
  true
}

// The length of the text in a fixed-size field: up to the first NUL, or the whole field
fn fieldLen(b: &Array[u8], at: usize, n: usize) usize {
  var k = 0usize;
  while k < n && b[at + k] != 0u8 { k += 1usize; }
  k
}

// Whether every byte of b[at ..< at + n] is zero
fn allZero(b: &Array[u8], at: usize, n: usize) bool {
  var k = 0usize;
  while k < n {
    if b[at + k] != 0u8 { return false; }
    k += 1usize;
  }
  true
}

// An octal number in a field of n bytes: spaces before it, then digits, then a NUL or space (or the field's
// end). A field of only spaces and NULs is 0. None: a byte that is not part of a number, or a number past
// 64 bits.
fn octal(b: &Array[u8], at: usize, n: usize) Option[u64] {
  var k = 0usize;
  while k < n && b[at + k] == 32u8 { k += 1usize; }
  var v = 0u64;
  while k < n {
    let c = b[at + k];
    if c == 0u8 || c == 32u8 { break; }
    if c < 48u8 || c > 55u8 { return None[u64]; }
    if v > 0x1FFFFFFFFFFFFFFFu64 { return None[u64]; }
    v = (v << 3u64) | u64.from(c - 48u8);
    k += 1usize;
  }
  // only NULs and spaces may follow
  while k < n {
    let c = b[at + k];
    if c != 0u8 && c != 32u8 { return None[u64]; }
    k += 1usize;
  }
  Some[u64](v)
}

// A decimal number b[from ..< to], no sign, no spaces, at least one digit; None past 64 bits
fn decimal(b: &Array[u8], from: usize, to: usize) Option[u64] {
  if from >= to { return None[u64]; }
  var v = 0u64;
  var k = from;
  while k < to {
    let c = b[k];
    if c < 48u8 || c > 57u8 { return None[u64]; }
    let d = u64.from(c - 48u8);
    if v > (0xFFFFFFFFFFFFFFFFu64 - d) / 10u64 { return None[u64]; }
    v = v * 10u64 + d;
    k += 1usize;
  }
  Some[u64](v)
}

// The checksum of a header block: the sum of its 512 bytes with the checksum field (148 to 155) taken as spaces
fn checksum(b: &Array[u8]) u64 {
  var sum = 0u64;
  var k = 0usize;
  while k < 512usize {
    if k >= 148usize && k < 156usize { sum += 32u64; } else { sum += u64.from(b[k]); }
    k += 1usize;
  }
  sum
}

// The bytes of a block that a size leaves unfilled: 0 to 511
fn padFor(size: u64) usize {
  usize.from((512u64 - (size % 512u64)) % 512u64)
}
