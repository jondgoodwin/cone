// A ragdoll built from the humanoid: its bodies and joints against the tables in spec.cone.
//
//   masses   Winter's (after Dempster's) segment fractions of the total, which sum to 1: hand 0.006, forearm 0.016,
//            upper arm 0.028, foot 0.0145, shank 0.0465, thigh 0.100, pelvis 0.142, lumbar 0.139, thorax 0.216,
//            head and neck 0.081 (as head 0.069 and neck 0.012); for 70 kg a thigh is 7.0 kg and a thorax 15.12 kg
//   bodies   14: the clavicles have none, the hands ride the forearms and the head rides the neck's body; a joint to
//            every body but the pelvis (13)
//   joints   cone-twist at the spine, chest, neck, head, shoulders and hips, hinges at elbows, knees and
//            ankles, with the table's ranges; the solver's cone is the largest of a joint's four swing ranges
//   sizes    the capsule of the thigh is as long as the bone below it (0.245 H) and the bodies stand where the
//            rest pose has them: the head's centre 0.935 H up

mod build;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;
import bonepose use * but absf, clampf;
import ragdollrig use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn main() i32 {
  let height = 1.75f;
  let skel = humanoid(height);
  let spec = humanoidSpec(&skel, height, 70.);
  var w = World.make();
  var rig = Ragdoll.make(&mut w, &skel, &spec, Rigid.at(new Vec3(0., 0., 0.)), 3u32);

  // ---- masses
  expectInt(i64.from(rig.bodyCount()), 14, "14 bodies");
  near(spec.massSum(), 70., 0.0005, "the recipe's masses sum to the total");
  var sum = 0.f;
  var k = 0usize;
  while k < rig.links.len() { sum = sum + w.massOf(rig.links[k].body); k = k + 1usize; }
  near(sum, 70., 0.001, "the bodies' masses in the world sum to the total, 70 kg");
  near(w.massOf(rig.bodyOfBone(THIGH_L)), 7.0, 0.001, "a thigh is 0.100 of the total");
  near(w.massOf(rig.bodyOfBone(SHIN_R)), 3.255, 0.001, "a shank is 0.0465");
  near(w.massOf(rig.bodyOfBone(FOOT_L)), 1.015, 0.001, "a foot is 0.0145");
  near(w.massOf(rig.bodyOfBone(UPPER_ARM_R)), 1.96, 0.001, "an upper arm is 0.028");
  near(w.massOf(rig.bodyOfBone(FOREARM_L)), 1.54, 0.001, "a forearm with its hand is 0.016 + 0.006");
  expectInt(i64.from(rig.linkOfBone(HAND_R)), -1, "a hand has no body of its own");
  near(w.massOf(rig.bodyOfBone(PELVIS)), 9.94, 0.001, "the pelvis is 0.142");
  near(w.massOf(rig.bodyOfBone(SPINE)), 9.73, 0.001, "the lumbar part is 0.139");
  near(w.massOf(rig.bodyOfBone(CHEST)), 15.12, 0.001, "the thorax is 0.216");
  near(w.massOf(rig.carrierBody(HEAD)), 5.67, 0.001, "head and neck, one body, are 0.081");
  expectInt(i64.from(rig.linkOfBone(HEAD)), -1, "the head has no body of its own");
  expectInt(i64.from(rig.linkOfBone(CLAVICLE_L)), -1, "a clavicle has no body");

  // a different total scales every mass
  var w2 = World.make();
  let spec90 = humanoidSpec(&skel, height, 90.);
  let rig90 = Ragdoll.make(&mut w2, &skel, &spec90, Rigid.at(new Vec3(0., 0., 0.)), 3u32);
  near(w2.massOf(rig90.bodyOfBone(THIGH_R)), 9.0, 0.001, "90 kg total: a thigh is 9 kg");

  // ---- the joints against the table
  var joints = 0;
  var hinges = 0;
  var cones = 0;
  var limitsMatch = true;
  k = 0usize;
  while k < rig.links.len() {
    let l = rig.links[k];
    let bs = spec.bones[l.bone];
    if l.joint != NoBody {
      joints = joints + 1;
      let j = w.joints[usize.from(l.joint)];
      if bs.joint == JOINT_HINGE {
        hinges = hinges + 1;
        if j.kind != JointHinge || !j.limitOn || absf(j.lower - bs.lo) > 0.00001 || absf(j.upper - bs.hi) > 0.00001 { limitsMatch = false; }
      } else {
        cones = cones + 1;
        let outer = maxf(maxf(bs.flex, bs.ext), maxf(bs.abd, bs.add));
        if j.kind != JointConeTwist || absf(j.coneAngle - outer) > 0.00001 || absf(j.twistLo - bs.lo) > 0.00001 || absf(j.twistHi - bs.hi) > 0.00001 { limitsMatch = false; }
      }
    }
    k = k + 1usize;
  }
  expectInt(i64.from(joints), 13, "a joint to every body but the pelvis");
  expectInt(i64.from(hinges), 6, "hinges: two elbows, knees and ankles");
  expectInt(i64.from(cones), 7, "cone-twist: spine, chest, neck (with the head), two shoulders, two hips");
  expectBool(limitsMatch, true, "every joint's limits are the table's");

  // spot values, from the table in spec.cone's header
  let knee = w.joints[usize.from(rig.links[usize.from(rig.linkOfBone(SHIN_L))].joint)];
  near(knee.lower, -2.45, 0.00001, "the knee flexes 140 degrees (2.45 rad)");
  near(knee.upper, 0.03, 0.00001, "and hyperextends almost not at all");
  let elbow = w.joints[usize.from(rig.links[usize.from(rig.linkOfBone(FOREARM_R))].joint)];
  near(elbow.upper, 2.50, 0.00001, "the elbow flexes 145 degrees");
  let hip = w.joints[usize.from(rig.links[usize.from(rig.linkOfBone(THIGH_R))].joint)];
  near(hip.coneAngle, 2.10, 0.00001, "the hip's cone is its flexion, 120 degrees");
  near(hip.twistHi, 0.75, 0.00001, "and it twists 43 degrees");
  let ankle = w.joints[usize.from(rig.links[usize.from(rig.linkOfBone(FOOT_L))].joint)];
  near(ankle.lower, -0.90, 0.00001, "the ankle plantar-flexes 50 degrees");

  // ---- the bodies stand where the rest pose has them
  near(w.positionOf(rig.carrierBody(HEAD)).y, 0.935 * height, 0.001, "the head's centre is at 0.935 H");
  near(w.positionOf(rig.bodyOfBone(THIGH_L)).y, (0.530 - 0.1225) * height, 0.001, "the thigh's centre is half a thigh below the hip");
  near(w.positionOf(rig.bodyOfBone(THIGH_L)).x, -0.0955 * height, 0.001, "and at the hip's side");
  near(spec.bones[THIGH_L].halfLen * 2. + spec.bones[THIGH_L].radius * 2., 0.245 * height, 0.0001, "a thigh capsule is a thigh long");
  near(rig.lowestPoint(&w, &spec), 0., 0.002, "the soles are on the ground in the rest pose at the origin");
  expectInt(i64.from(rig.linkOfBody(rig.bodyOfBone(FOREARM_L))), 6, "linkOfBody finds a link");
  expectInt(i64.from(rig.linkOfBody(NoBody)), -1, "and not a body that is not the ragdoll's");

  // a generic recipe for any skeleton: bodies for every bone, the mass spread over them
  let gspec = genericSpec(&skel, 50., 0.15, 0.8, 0.5);
  near(gspec.massSum(), 50., 0.001, "a generic recipe's masses sum to the total");
  expectInt(i64.from(gspec.boneCount()), 19, "and has a bone for every bone");
  done()
}
