// Lying, the get-up clips and the pose-matching blend.
//
//   lying      the pelvis turned a quarter turn about x (its front up) is face up, the other way face down, upright
//              is upright, a quarter turn about z is on its side
//   clips      each get-up clip's first key is on the floor (the lowest point of its shapes at 0 to a millimetre), its
//              last is the standing rest pose (the pelvis at 0.53 H, the feet flat, within a millimetre), and no knee,
//              elbow or ankle in it is past its table limit by more than 0.05 rad
//   choosing   a ragdoll put into the face-up clip's first pose, placed in the world turned by 1.0 rad and moved to
//              (2, 0, 3), is face up, gets the face-up clip, and the clip is placed under its pelvis turned so that
//              the head points the way the ragdoll's does; likewise face down with -2.0 rad
//   matching   the pose at t = 0 is the ragdoll's own pose, at matchTime it is the clip's, and between is neither
//   end        the get-up is done after the clip's duration and its last pose is standing
//   settled    a ragdoll dropped and come to rest is classified by the way its pelvis' front leans

mod getup;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;
import bonepose use * but clampf;
import poseik use blendPoses;
import ragdollrig use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn poseDiff(a: &Pose, b: &Pose) f32 {
  var worst = 0.f;
  var i = 0usize;
  while i < a.count() {
    worst = maxf(worst, rotVec(a.rotation(i) * b.rotation(i).conjugate()).length());
    worst = maxf(worst, ((*a.locals[i]).translation - (*b.locals[i]).translation).length());
    i = i + 1usize;
  }
  worst
}

// How far a knee, elbow or ankle of the pose is past its table limit (the hinge angle is its local rotation about x)
fn pastLimits(skel: &Skeleton, spec: &RigSpec, p: &Pose) f32 {
  var worst = 0.f;
  var b = 0usize;
  while b < skel.boneCount() {
    let bs = spec.bones[b];
    if bs.joint == JOINT_HINGE {
      let q = p.rotation(b);
      let a = wrapAngle(2. * atan2(q.x, q.w));
      worst = maxf(worst, maxf(bs.lo - a, a - bs.hi));
    }
    b = b + 1usize;
  }
  worst
}

fn main() i32 {
  let skel = humanoid(1.75);
  let spec = humanoidSpec(&skel, 1.75, 70.);
  let x = Vec3(1., 0., 0.);
  let y = Vec3(0., 1., 0.);
  let z = Vec3(0., 0., 1.);

  // ---- lying
  expectInt(i64.from(lyingFrom(Quat.angleAxis(1.5708, x))), i64.from(LIE_FACE_UP), "a pelvis turned +90 degrees about x is face up");
  expectInt(i64.from(lyingFrom(Quat.angleAxis(-1.5708, x))), i64.from(LIE_FACE_DOWN), "-90 is face down");
  expectInt(i64.from(lyingFrom(Quat.identity())), i64.from(LIE_UPRIGHT), "no turn is upright");
  expectInt(i64.from(lyingFrom(Quat.angleAxis(0.5, x))), i64.from(LIE_UPRIGHT), "a lean of 29 degrees is still upright");
  expectInt(i64.from(lyingFrom(Quat.angleAxis(1.5708, z))), i64.from(LIE_SIDE), "a quarter turn about z is on its side");
  expectInt(i64.from(lyingFrom(Quat.angleAxis(1.2, x))), i64.from(LIE_FACE_UP), "69 degrees back is face up");
  expectInt(i64.from(lyingFrom(Quat.angleAxis(-1.0, x))), i64.from(LIE_FACE_DOWN), "57 degrees forward is face down");
  expectInt(i64.from(lyingFrom(Quat.angleAxis(3.1, x))), i64.from(LIE_SIDE), "upside down, the front level, is on its side");

  // ---- clips
  let clips = getUpClips(&skel, &spec);
  var c = 0;
  while c < 3 {
    let clip = if c == 0 { &clips.faceUp } else if c == 1 { &clips.faceDown } else { &clips.upright };
    let first = clip.sample(0.);
    let last = clip.sample(clip.duration);
    var models = List[Transform3].empty();
    skel.modelTransforms(&first, &mut models);
    near(lowestOfPose(&skel, &spec, &first), 0., 0.001, "the clip's first pose is on the floor");
    skel.modelTransforms(&last, &mut models);
    near((*models[PELVIS]).translation.y, 0.53 * 1.75, 0.001, "its last pose has the pelvis at standing height");
    near(lowestOfPose(&skel, &spec, &last), 0., 0.001, "and the soles on the floor");
    near(((*models[FOOT_L]).rotation * Vec3(0., 0., -1.)).y, 0., 0.001, "and the feet flat");
    var worst = 0.f;
    var t = 0.f;
    while t <= clip.duration {
      let p = clip.sample(t);
      worst = maxf(worst, pastLimits(&skel, &spec, &p));
      // the lowest point never goes under the floor between keys by more than a few centimetres
      worst = maxf(worst, -lowestOfPose(&skel, &spec, &p) - 0.05);
      t = t + 0.1;
    }
    expectBool(worst < 0.05, true, "no hinge in the clip is past its table limit by 0.05 rad, nor the body under the floor by 5 cm");
    c = c + 1;
  }
  near(clips.faceUp.duration, 3.4, 0.0001, "the face-up clip is 3.4 s");
  near(clips.faceDown.duration, 3.3, 0.0001, "the face-down clip is 3.3 s");
  near(clips.upright.duration, 1.2, 0.0001, "the upright clip is 1.2 s");

  // ---- choosing and placing
  var w = World.make();
  w.gravity = Vec3(0., 0., 0.);
  var rig = Ragdoll.make(&mut w, &skel, &spec, Rigid.at(Vec3(0., 0., 0.)), 1u32);
  let rest = skel.restPose();
  var which = 0;
  while which < 2 {
    let up = which == 0;
    let yaw = if up { 1.0f } else { -2.0 };
    let at = Vec3(2., 0., 3.);
    let clip = if up { &clips.faceUp } else { &clips.faceDown };
    let lyingPose = clip.sample(0.);
    let place = Rigid(at, Quat.angleAxis(yaw, y));
    rig.poseToBodies(&mut w, &skel, &lyingPose, place);
    expectInt(i64.from(lying(&rig, &w)), if up { i64.from(LIE_FACE_UP) } else { i64.from(LIE_FACE_DOWN) }, "the ragdoll in the clip's pose lies the way the clip does");
    var gu = beginGetUp(&rig, &w, &skel, &rest, 0., 0.3);
    expectInt(i64.from(gu.clip), if up { 0i64 } else { 1i64 }, "and gets the clip for it");
    // the placement is where the ragdoll was placed
    near(gu.placement.pos.x, 2., 0.01, "the clip is placed under the pelvis, x");
    near(gu.placement.pos.z, 3., 0.01, "and z");
    let faceWas = place.rot * Vec3(0., 0., -1.);
    let faceNow = gu.placement.rot * Vec3(0., 0., -1.);
    near(faceNow.x, faceWas.x, 0.02, "turned to the way the ragdoll faces, x");
    near(faceNow.z, faceWas.z, 0.02, "and z");
    // matching
    let now = rig.bodiesToPose(&w, &skel, &rest, gu.placement);
    gu.t = 0.;
    let p0 = gu.pose(&clips);
    near(poseDiff(&p0, &now), 0., 0.0001, "at t = 0 the pose shown is the ragdoll's own");
    gu.t = 0.3;
    let p1 = gu.pose(&clips);
    let c1 = clip.sample(0.3);
    near(poseDiff(&p1, &c1), 0., 0.0001, "at matchTime it is the clip's");
    gu.t = 0.15;
    let pm = gu.pose(&clips);
    let cm = clip.sample(0.15);
    let half = blendPoses(&now, &cm, 0.5);
    near(poseDiff(&pm, &half), 0., 0.0001, "half way through the match (smoothstep 0.5 at 0.15 s) it is the half blend of the two");
    expectBool(!gu.done(&clips), true, "the get-up is not done at 0.15 s");
    gu.advance(clip.duration);
    expectBool(gu.done(&clips), true, "it is done after the clip's duration");
    let endPose = gu.pose(&clips);
    var models = List[Transform3].empty();
    skel.modelTransforms(&endPose, &mut models);
    near((*models[PELVIS]).translation.y, 0.53 * 1.75, 0.001, "and its pose is standing");
    which = which + 1;
  }

  // ---- a ragdoll that fell
  var w2 = World.make();
  tuneWorld(&mut w2);
  let ground = w2.addShape(Shape.single(Prim.box(Vec3(20., 1., 20.))));
  w2.createBody(BodyDef.staticAt(ground, Vec3(0., -1., 0.)));
  var rig2 = Ragdoll.make(&mut w2, &skel, &spec, Rigid.at(Vec3(0., 1., 0.)), 1u32);
  rig2.blend = 0.;
  var i = 0;
  while i < 300 { stepRagdoll(&mut rig2, &mut w2, 1. / 60.); i = i + 1; }
  expectBool(rig2.settled, true, "the dropped ragdoll is settled");
  let front = (w2.rotationOf(rig2.bodyOfBone(PELVIS)) * rig2.links[0].shapeRot.conjugate()) * Vec3(0., 0., -1.);
  let lie = lying(&rig2, &w2);
  expectBool((front.y > 0.5 && lie == LIE_FACE_UP) || (front.y < -0.5 && lie == LIE_FACE_DOWN) || (front.y.abs() <= 0.5 && lie == LIE_SIDE), true, "it is classified by its pelvis' front");
  let gu2 = beginGetUp(&rig2, &w2, &skel, &rest, 0., 0.3);
  expectBool(gu2.clip == 0 || gu2.clip == 1, true, "and gets a lying get-up clip");
  done()
}
