// A limp ragdoll dropped from 2 m onto the ground (the soles 2 m up, the rest pose): every step the joints are
// checked, and the fall's impact and rest are measured.
//
//   joints   no joint's two anchors are ever 2 cm apart (1.2 cm is the worst measured, at the ankles on landing;
//            it was 6 cm, and up to 19 cm from a metre, before joints were swept eight times a sub-step, were
//            softened against the heavier body and were no longer torn by continuous collision),
//            no hinge is past its limit by more than 0.1 rad (6 degrees), no cone-twist is past its cone by more
//            than 0.1 rad or its twist range by more than 0.1 rad. The solver's limits are soft rows (a stiff
//            spring, rigiddynamics' jointHertz), so a 6 m/s landing goes a little past them for a few steps.
//            The elliptical swing ranges are the solver's own (World.setSwingEllipse): the ellipse measure
//            (u/a)^2 + (v/b)^2 stays under 1.15 (1.05 measured).
//   impact   a fall from 2 m meets the ground at sqrt(2 g h) = 6.26 m/s (less a little to the damping); the
//            ragdoll's centre-of-mass speed before the first contact is measured and the landing the events report is
//            within 20% of it: 'peak', the net change of velocity over the landing, is more than that speed because
//            the body then collapses and lands again on its hips
//   rest     it is settled (every body under 0.15 m/s for 0.4 s) within 4 s of the release, ends lying with the
//            pelvis under 0.3 m high, and no body is ever lower than the ground by more than 2 cm
//   world    all of it twice: on tuneWorld's settings (8 sub-steps, contacts at 120 Hz) and on rigiddynamics' defaults
//            (4 sub-steps, 30 Hz), which hold the joints as well and sink a pinned limb 3 cm instead of 0.4

mod drop;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;
import bonepose use * but clampf;
import ragdollrig use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn twistAbout(q0: Quat) f32 {
  let sg = if q0.w < 0. { -1.f } else { 1. };
  wrapAngle(2. * atan2(q0.x * sg, q0.w * sg))
}

fn dropRun(tuned: bool) {
  let skel = humanoid(1.75);
  let spec = humanoidSpec(&skel, 1.75, 70.);
  var w = World.make();
  if tuned { tuneWorld(&mut w); }
  let ground = w.addShape(Shape.single(Prim.box(Vec3(20., 1., 20.))));
  w.createBody(BodyDef.staticAt(ground, Vec3(0., -1., 0.)));
  var rig = Ragdoll.make(&mut w, &skel, &spec, Rigid.at(Vec3(0., 2., 0.)), 1u32);
  rig.blend = 0.;
  var worstAnchor = 0.f;
  var worstHinge = 0.f;
  var worstCone = 0.f;
  var worstTwist = 0.f;
  var worstEllipse = 0.f;
  var deepest = 0.f;
  var finite = true;
  var fastest = 0.f;
  var firstImpact = -1;
  var settledAt = -1;
  var i = 0;
  while i < 360 {
    let before = comVelocity(&rig, &w);
    if firstImpact < 0 { fastest = maxf(fastest, -before.y); }
    stepRagdoll(&mut rig, &mut w, 1. / 60.);
    if firstImpact < 0 && lastImpactSpeed(&rig) > 0. { firstImpact = i; }
    if settledAt < 0 && rig.settled { settledAt = i; }
    deepest = minf(deepest, rig.lowestPoint(&w, &spec));
    var k = 0usize;
    while k < rig.links.len() {
      let l = rig.links[k];
      let p = w.positionOf(l.body);
      if !(p.x < 1000. && p.x > -1000. && p.y < 1000. && p.y > -1000.) { finite = false; }
      if l.joint != NoBody {
        let j = w.joints[usize.from(l.joint)];
        worstAnchor = maxf(worstAnchor, w.jointError(l.joint));
        if l.kind == JOINT_HINGE {
          let a = w.hingeAngleOf(l.joint);
          worstHinge = maxf(worstHinge, maxf(l.lo - a, a - l.hi));
        } else {
          let pl = rig.links[usize.from(l.parent)];
          let fa = (w.rotationOf(pl.body) * j.fa).normalize();
          let fb = (w.rotationOf(l.body) * j.fb).normalize();
          let swing = acos(clampf((fa * Vec3(1., 0., 0.)).dot(fb * Vec3(1., 0., 0.)), -1., 1.));
          worstCone = maxf(worstCone, swing - l.cone);
          let tw = twistAbout((fa.conjugate() * fb).normalize());
          worstTwist = maxf(worstTwist, maxf(l.lo - tw, tw - l.hi));
          worstEllipse = maxf(worstEllipse, swingMeasure(&rig, &w, k));
        }
      }
      k = k + 1usize;
    }
    i = i + 1;
  }
  expectBool(finite, true, "every body stays finite");
  expectBool(worstAnchor < 0.02, true, "no joint's anchors are ever 2 cm apart, in 360 steps (1.2 cm measured)");
  expectBool(worstHinge < 0.1, true, "no hinge is ever 0.1 rad past its limit");
  expectBool(worstCone < 0.1, true, "no cone-twist is ever 0.1 rad past its cone");
  expectBool(worstTwist < 0.1, true, "no cone-twist is ever 0.1 rad past its twist range");
  expectBool(worstEllipse < 1.15, true, "no swing is ever 15% beyond its elliptical range (measure 1.05)");
  expectBool(deepest > (if tuned { -0.01 } else { -0.045 }), true, "nothing sinks more than 1 cm into the ground tuned, 4.5 cm default (0.4 and 3.2 measured)");
  // the impact
  expectBool(firstImpact > 30 && firstImpact < 50, true, "the first contact is at about 0.65 s (step 39)");
  near(fastest, 6.1, 0.5, "the fall's speed before the first contact is about sqrt(2 g h), less damping");
  expectBool(rig.peak > 0.8 * fastest && rig.peak < 1.35 * fastest, true, "the landing the events report is about the speed it fell at");
  // the rest
  expectBool(settledAt > 0 && settledAt < 240, true, "it is settled within 4 s");
  expectBool(rig.settled, true, "and is still settled at 6 s");
  expectBool(w.positionOf(rig.bodyOfBone(PELVIS)).y < 0.3, true, "it ends lying, the pelvis under 0.3 m");
}

fn main() i32 {
  dropRun(true);
  dropRun(false);
  done()
}
