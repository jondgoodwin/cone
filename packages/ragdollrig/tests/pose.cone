// Pose to bodies and back.
//
//   round trip  a crouching pose (hips 2.0, knees 2.3, a lean) put into the bodies, placed in the world with a turn
//               and a move, and read back through bodiesToPose gives the same local rotation for every bone (the
//               bones with a body, from the body; the others, the clavicles and hands, from the base pose), the root's
//               translation, and the same bone positions through forward kinematics, to a millimetre
//   world space reading back with the identity placement gives the pose in world space: the pelvis at its world place
//   momentum    poseToBodiesMoving with the pose 1/60 s ago, the placement behind by v/60, gives every body v m/s: a
//               placement that moved (3, 0, 1) m/s gives the ragdoll that velocity, a placement that turned 2 rad/s
//               about y gives the pelvis that spin and the head the velocity of a point turning about the pelvis,
//               and in zero gravity the joints (internal) keep the momentum of 70 kg at 3 m/s for a second, less the
//               5% a second that the bodies' linear damping takes

mod pose;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;
import bonepose use * but absf, clampf;
import ragdollrig use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

fn main() i32 {
  let skel = humanoid(1.75);
  let spec = humanoidSpec(&skel, 1.75, 70.);
  var w = World.make();
  w.gravity = new Vec3(0., 0., 0.);
  var rig = Ragdoll.make(&mut w, &skel, &spec, Rigid.at(new Vec3(0., 0., 0.)), 1u32);

  var st = Stance.rest();
  st.pitch = -0.55;
  st.legs(2.0, 2.3);
  st.arms(0.9, 0.1, 0.4);
  st.trunk(0.3, 0.3, 0.1, 0.5);
  st.x = 0.1;
  let pose = stancePose(&skel, &st);
  let placement = new Rigid(new Vec3(1., 0.5, -2.), Quat.angleAxis(0.7, new Vec3(0., 1., 0.)));
  rig.poseToBodies(&mut w, &skel, &pose, placement);
  let back = rig.bodiesToPose(&w, &skel, &pose, placement);
  var worstRot = 0.;
  var i = 0usize;
  while i < skel.boneCount() {
    worstRot = maxf(worstRot, rotVec(back.rotation(i) * pose.rotation(i).conjugate()).length());
    i = i + 1usize;
  }
  expectBool(worstRot < 0.001, true, "every bone's local rotation survives the round trip to 0.001 rad");
  near((*back.locals[PELVIS]).translation.x, (*pose.locals[PELVIS]).translation.x, 0.0005, "the root's x survives");
  near((*back.locals[PELVIS]).translation.y, (*pose.locals[PELVIS]).translation.y, 0.0005, "the root's y survives");
  var m0 = List[Transform3].empty();
  var m1 = List[Transform3].empty();
  skel.modelTransforms(&pose, &mut m0);
  skel.modelTransforms(&back, &mut m1);
  var worstPos = 0.;
  i = 0usize;
  while i < skel.boneCount() {
    worstPos = maxf(worstPos, ((*m0[i]).translation - (*m1[i]).translation).length());
    i = i + 1usize;
  }
  expectBool(worstPos < 0.001, true, "every bone's model-space position survives to a millimetre");
  // the bodies really are where forward kinematics says
  var tp = List[Vec3].empty();
  var tq = List[Quat].empty();
  rig.bodyTargets(&skel, &pose, placement, &mut tp, &mut tq);
  var worstBody = 0.;
  var k = 0usize;
  while k < rig.links.len() {
    worstBody = maxf(worstBody, (w.positionOf(rig.links[k].body) - *tp[k]).length());
    k = k + 1usize;
  }
  expectBool(worstBody < 0.0001, true, "every body is where bodyTargets says");

  // in world space
  let worldPose = rig.bodiesToPose(&w, &skel, &pose, Rigid.identity());
  let pelvisWorld = placement.apply((*m0[PELVIS]).translation);
  near((*worldPose.locals[PELVIS]).translation.x, pelvisWorld.x, 0.001, "read back at the identity placement, the pelvis is at its world x");
  near((*worldPose.locals[PELVIS]).translation.z, pelvisWorld.z, 0.001, "and z");

  // ---- momentum
  let v = new Vec3(3., 0., 1.);
  let dt = 1. / 60.;
  let rest = skel.restPose();
  let there = new Rigid(new Vec3(0., 0., 0.), Quat.identity());
  let before = new Rigid(there.pos - v * dt, there.rot);
  rig.poseToBodiesMoving(&mut w, &skel, &rest, before, &rest, there, dt, new Vec3(0., 0., 0.));
  let cv = comVelocity(&rig, &w);
  near(cv.x, 3., 0.001, "a placement moving at 3 m/s gives the ragdoll 3 m/s in x");
  near(cv.z, 1., 0.001, "and 1 in z");
  near(rig.momentum(&w).x, 210., 0.1, "its momentum is 70 kg times that");
  var s = 0;
  while s < 60 { stepRagdoll(&mut rig, &mut w, dt); s = s + 1; }
  near(rig.momentum(&w).x, 210. * 0.951229, 0.5, "in zero gravity the joints keep it for a second, less the 5% a second of linear damping");
  near(rig.centerOfMass(&w).x, 2.93, 0.03, "and the centre of mass has gone 2.93 m");

  // a turning placement
  var w2 = World.make();
  w2.gravity = new Vec3(0., 0., 0.);
  var rig2 = Ragdoll.make(&mut w2, &skel, &spec, Rigid.at(new Vec3(0., 0., 0.)), 1u32);
  let turned = new Rigid(new Vec3(0., 0., 0.), Quat.angleAxis(0.1, new Vec3(0., 1., 0.)));
  let was = new Rigid(new Vec3(0., 0., 0.), Quat.angleAxis(0.1 - 2. * dt, new Vec3(0., 1., 0.)));
  rig2.poseToBodiesMoving(&mut w2, &skel, &rest, was, &rest, turned, dt, new Vec3(0., 0., 0.));
  near(w2.angularVelocity(rig2.bodyOfBone(PELVIS)).y, 2., 0.01, "a placement turning 2 rad/s gives the pelvis that spin");
  let headPos = w2.positionOf(rig2.carrierBody(HEAD));
  let headV = w2.linearVelocity(rig2.carrierBody(HEAD));
  // v = omega x r, r from the origin: (2 y) x (x, y, z) = 2 (z, 0, -x)
  near(headV.x, 2. * headPos.z, 0.01, "and the head the velocity of a point turning with it, x");
  near(headV.z, -2. * headPos.x, 0.01, "and z");
  // 'extra' is added to every body
  rig2.poseToBodiesMoving(&mut w2, &skel, &rest, there, &rest, there, dt, new Vec3(0., 4., 0.));
  near(comVelocity(&rig2, &w2).y, 4., 0.001, "a push given as 'extra' is the ragdoll's velocity");
  done();
}
