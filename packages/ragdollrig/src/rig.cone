// The Ragdoll: bodies and joints made in a rigiddynamics World from a skeleton and a RigSpec, and the
// mapping between a bonepose Pose and those bodies in both directions.
//
// THE FRAMES. A body's frame is its bone's frame turned by 'shapeRot' (a capsule's long axis is its local y;
// a bone whose segment points down -y therefore has a shapeRot that turns y to -y), and its origin is its
// shape's centre, 'center' along from the bone's origin (in the bone's frame). So
//
//   body rotation = bone rotation * shapeRot       body position = bone position + bone rotation * center
//
// in the world, where a bone's world transform is the placement (where the being's model space sits in the
// world, a position and a rotation) times its model-space transform. Pose to bodies runs that forwards and
// bodies to pose runs it backwards, taking each bone's local rotation from its parent's model rotation.
// A bone without a body (a clavicle) keeps its local transform from a 'base' pose; every bone keeps its
// local translation from the base pose too (bones stay rigid, so the joints' small errors never stretch
// a skinned limb), except the root, whose translation is where its body is.
//
// THE JOINTS are made at the skeleton's rest pose and measured from it (spec.cone's header). The world
// joint is the solver's: a hinge with its limits, or a cone-twist with its elliptical swing range (flexion,
// extension, abduction, adduction: the solver's own four-quarter-axis limit, World.setSwingEllipse) and twist
// range. setSwingLimits(false) falls back to the round cone of the largest range. limits.cone only measures.

pub const LAYER_RAGDOLL = 2u32;

// One body of the ragdoll and its joint to the parent body
pub struct Link {
  pub bone usize;
  pub body u32;
  pub parent i32;          // index in 'links' of the parent body's link, or -1
  pub joint u32;           // the world joint, NoBody if none
  pub kind i32;            // JOINT_*
  pub center Vec3;         // shape centre in the bone's frame
  pub shapeRot Quat;       // body frame = bone frame * shapeRot
  pub axisP Vec3;          // hinge axis, or twist axis, in the parent body's frame
  pub axisC Vec3;          // the same axis in this body's frame
  pub flexP Vec3;          // cone-twist: the direction of flexion perpendicular to the axis, parent body's frame
  pub abdP Vec3;           // and of abduction
  pub lo f32;
  pub hi f32;
  pub cone f32;
  pub flex f32;
  pub ext f32;
  pub abd f32;
  pub add f32;
  pub mass f32;
  pub maxTorque f32;
  pub radius f32;          // the body's reach from its centre (for speeds)
  pub targetRel Quat;      // the target pose's rotation of this bone relative to the parent body's bone
}

// A hit on something that is not the ragdoll
pub struct Impact {
  pub link usize;
  pub bone usize;
  pub speed f32;           // the step's change of the whole ragdoll's velocity by outside contacts, m/s
  pub impulse f32;         // that times the ragdoll's mass, N s
  pub point Vec3;
  pub normal Vec3;         // from the other body to the ragdoll's
}

pub struct Ragdoll {
  pub links List[Link];
  pub boneLink List[i32];       // bone -> its link, or -1 (no body)
  pub carrier List[i32];        // bone -> the link whose body carries it (its own, or the nearest ancestor's)
  pub tag u32;                  // userData of body = tag * 64 + bone number
  pub totalMass f32;
  pub height f32;
  // the powered ragdoll (drive.cone)
  pub blend f32;                // 0 limp .. 1 fully driven to the target pose
  pub fullTorqueError f32;      // radians of error at which a joint driven at blend 1 pushes with its full torque
  pub damping f32;              // its damping ratio
  pub rootHertz f32;            // 0: nothing holds the pelvis' orientation; otherwise a hold towards the target's
  pub rootTarget Quat;          // the target pelvis orientation in the world
  pub passiveDamping f32;       // 1/s: the drag on a joint's relative spin when limp
  pub limitsOn bool;            // the anisotropic swing ranges are the solver's (see setSwingLimits)
  // events (events.cone)
  pub prevLin List[Vec3];       // each link's body velocity before the step
  pub impacts List[Impact];     // the last step's
  pub peak f32;                 // the hardest landing (speed lost to the ground in one episode) since resetPeak
  pub landing f32;              // the last completed landing's speed lost, m/s
  pub episode Vec3;             // the centre-of-mass velocity before the landing under way began
  pub episodeEnd Vec3;          // and after its latest step of impact
  pub episodeOn bool;
  pub quiet i32;                // steps since the last step of impact
  pub stillTime f32;
  pub settleSpeed f32;          // m/s under which a ragdoll counts as still
  pub settleTime f32;           // seconds still before it counts as settled
  pub settled bool;
  pub steps u32;

  // The ragdoll of 'skel' made in 'w' from 'spec', its model space placed in the world by 'placement'.
  // The bodies are made in the rest pose, so the joints' zero is the rest pose. Move them to a pose with
  // poseToBodies.
  pub fn make(w &mut World, skel &Skeleton, spec &RigSpec, placement Rigid, tag u32) Ragdoll {
    let rest = skel.restPose();
    var models = List[Transform3].empty();
    skel.modelTransforms(&rest, &mut models);
    var links = List[Link].empty();
    var boneLink = List[i32].empty();
    var carrier = List[i32].empty();
    let n = skel.boneCount();
    var i = 0usize;
    while i < n {
      let bs = spec.bones[i];
      let p = skel.parentOf(i);
      let parentLink = if p < 0i32 { -1i32 } else { *carrier[usize.from(p)] };
      if not bs.hasBody {
        boneLink.push(-1i32);
        carrier.push(parentLink);
        i = i + 1usize;
        continue;
      }
      let bm = *models[i];
      let rBone = placement.rot * bm.rotation;
      let pBone = placement.pos + placement.rot * bm.translation;
      // the shape and its frame
      var shapeRot = Quat.identity();
      if bs.shape == SHAPE_CAPSULE { shapeRot = Quat.fromVectors(new Vec3(0., 1., 0.), bs.axis.normalize()); }
      let shape = Shape.single(primOf(bs));
      let bound = shape.bounds(Rigid.identity()).halfExtents();
      let shapeId = w.addShape(shape);
      let rBody = (rBone * shapeRot).normalize();
      let pBody = pBone + rBone * bs.center;
      var def = BodyDef.dynamicAt(shapeId, pBody);
      def.rot = rBody;
      def.mass = bs.mass;
      def.material = PhysMaterial.make(spec.friction, spec.friction * 1.2, 0.);
      def.layer = LAYER_RAGDOLL;
      def.mask = if spec.selfCollide { 0xffffffffu32 } else { 0xfffffffdu32 };
      def.linearDamping = spec.linearDamping;
      def.angularDamping = spec.angularDamping;
      def.userData = tag * 64u32 + u32.from(i);
      let body = w.createBody(def);
      var link = new Link(i, body, parentLink, NoBody, JOINT_NONE, bs.center, shapeRot, zero3(), zero3(), zero3(), zero3(),
        bs.lo, bs.hi, bs.cone, bs.flex, bs.ext, bs.abd, bs.add, bs.mass, bs.maxTorque, bound.length(), Quat.identity());
      if parentLink >= 0i32 and bs.joint != JOINT_NONE {
        let pl = *links[usize.from(parentLink)];
        let pBoneModel = *models[pl.bone];
        let axisW = (placement.rot * (bm.rotation * bs.jointAxis.normalize())).normalize();
        let rpBody = (placement.rot * pBoneModel.rotation * pl.shapeRot).normalize();
        link.kind = bs.joint;
        link.axisC = rBody.conjugate() * axisW;
        link.axisP = rpBody.conjugate() * axisW;
        if bs.joint == JOINT_HINGE {
          link.joint = w.addHinge(pl.body, body, pBone, axisW);
          w.setHingeLimits(link.joint, bs.lo, bs.hi);
        } else if bs.joint == JOINT_CONETWIST {
          link.joint = w.addConeTwist(pl.body, body, pBone, axisW, bs.cone);
          w.setTwistLimits(link.joint, bs.lo, bs.hi);
          // flexion is towards the being's front (-z), abduction away from its middle
          var f = placement.rot * new Vec3(0., 0., -1.);
          f = f - axisW * f.dot(axisW);
          if f.length() < 0.2 { f = placement.rot * new Vec3(0., 1., 0.); f = f - axisW * f.dot(axisW); }
          f = f.normalize();
          var a = placement.rot * new Vec3(bs.side, 0., 0.);
          a = a - axisW * a.dot(axisW);
          if a.length() < 0.2 { a = axisW.cross(f); }
          a = a.normalize();
          link.flexP = rpBody.conjugate() * f;
          link.abdP = rpBody.conjugate() * a;
          w.setSwingEllipse(link.joint, link.flexP, link.abdP, bs.flex, bs.ext, bs.abd, bs.add);
        } else {
          link.joint = w.addPointJoint(pl.body, body, pBone);
        }
      }
      boneLink.push(i32.from(links.len()));
      carrier.push(i32.from(links.len()));
      links.push(link);
      i = i + 1usize;
    }
    var prev = List[Vec3].empty();
    i = 0usize;
    while i < links.len() { prev.push(zero3()); i = i + 1usize; }
    new Ragdoll(links, boneLink, carrier, tag, spec.massSum(), spec.height, 1., 0.05, 1.5, 0., Quat.identity(), 6., true,
      prev, List[Impact].empty(), 0., 0., zero3(), zero3(), false, 0, 0., 0.15, 0.4, false, 0u32)
  }

  // Hold the shoulders, hips, spine and neck to their elliptical swing ranges (true, the default), or to the round
  // cone of the widest range
  pub fn setSwingLimits(self &mut, w &mut World, on bool) {
    limitsOn = on;
    var k = 0usize;
    while k < links.len() {
      if links[k].kind == JOINT_CONETWIST and links[k].joint != NoBody { w.joints[usize.from(links[k].joint)].ellOn = on; }
      k = k + 1usize;
    }
  }

  pub fn bodyCount(self &) usize { links.len() }
  pub fn totalMassKg(self &) f32 { totalMass }

  // The link of the body for bone 'b', or -1
  pub fn linkOfBone(self &, b usize) i32 { *boneLink[b] }

  // The link of a world body, or -1 (it is not this ragdoll's)
  pub fn linkOfBody(self &, body u32) i32 {
    var k = 0usize;
    while k < links.len() {
      if links[k].body == body { return i32.from(k); }
      k = k + 1usize;
    }
    -1i32
  }

  // The body that carries bone 'b': its own, or if it has none (a clavicle, a hand, the head) the nearest ancestor's
  pub fn carrierBody(self &, b usize) u32 {
    let l = *carrier[b];
    if l < 0i32 { return NoBody; }
    links[usize.from(l)].body
  }

  pub fn bodyOfBone(self &, b usize) u32 {
    let l = *boneLink[b];
    if l < 0i32 { return NoBody; }
    links[usize.from(l)].body
  }

  // The world bone transform for 'link' given its body's pose (the shape origin and orientation)
  fn boneFromBody(self &, link &Link, bodyPos Vec3, bodyRot Quat) Rigid {
    let r = (bodyRot * link.shapeRot.conjugate()).normalize();
    new Rigid(bodyPos - r * link.center, r)
  }

  // ------------------------------------------------------------------ pose to bodies

  // Where each body would be with the skeleton in 'pose' and its model space at 'placement': positions
  // and rotations of the bodies' shapes, by link
  pub fn bodyTargets(self &, skel &Skeleton, pose &Pose, placement Rigid, pos &mut List[Vec3], rot &mut List[Quat]) {
    var models = List[Transform3].empty();
    skel.modelTransforms(pose, &mut models);
    pos.clear();
    rot.clear();
    var k = 0usize;
    while k < links.len() {
      let l = links[k];
      let bm = *models[l.bone];
      let rBone = placement.rot * bm.rotation;
      let pBone = placement.pos + placement.rot * bm.translation;
      pos.push(pBone + rBone * l.center);
      rot.push((rBone * l.shapeRot).normalize());
      k = k + 1usize;
    }
  }

  // Put the bodies in the pose, at rest (zero velocities)
  pub fn poseToBodies(self &mut, w &mut World, skel &Skeleton, pose &Pose, placement Rigid) {
    var ps = List[Vec3].empty();
    var qs = List[Quat].empty();
    self.bodyTargets(skel, pose, placement, &mut ps, &mut qs);
    var k = 0usize;
    while k < links.len() {
      let id = links[k].body;
      w.setTransform(id, *ps[k], *qs[k]);
      w.setLinearVelocity(id, zero3());
      w.setAngularVelocity(id, zero3());
      k = k + 1usize;
    }
    resetEvents(self, w);
  }

  // Put the bodies in 'pose' with the velocities the animation had: the pose 'dt' seconds ago (and where the model
  // space was then) against the pose now, so a character that was running keeps running when it falls.
  // 'extra' is added to every body's velocity (a blow's push).
  pub fn poseToBodiesMoving(self &mut, w &mut World, skel &Skeleton, prevPose &Pose, prevPlacement Rigid, pose &Pose,
      placement Rigid, dt f32, extra Vec3) {
    var p0 = List[Vec3].empty();
    var q0 = List[Quat].empty();
    var p1 = List[Vec3].empty();
    var q1 = List[Quat].empty();
    self.bodyTargets(skel, prevPose, prevPlacement, &mut p0, &mut q0);
    self.bodyTargets(skel, pose, placement, &mut p1, &mut q1);
    let inv = 1. / maxf(dt, 0.0001);
    var k = 0usize;
    while k < links.len() {
      let id = links[k].body;
      w.setTransform(id, *p1[k], *q1[k]);
      w.setLinearVelocity(id, (*p1[k] - *p0[k]) * inv + extra);
      var dq = (*q1[k]) * (*q0[k]).conjugate();
      if dq.w < 0. { dq = new Quat(-dq.x, -dq.y, -dq.z, -dq.w); }
      let s = (dq.x * dq.x + dq.y * dq.y + dq.z * dq.z).sqrt();
      let ang = 2. * atan2(s, dq.w);
      w.setAngularVelocity(id, if s > 0.000001 { new Vec3(dq.x, dq.y, dq.z) * (ang / s * inv) } else { zero3() });
      k = k + 1usize;
    }
    resetEvents(self, w);
  }

  // ------------------------------------------------------------------ bodies to pose

  // The skeleton's pose read from the bodies, in the model space placed at 'placement' (not necessarily
  // where the character stands: pass the placement the pose should be relative to). 'base' gives the local
  // translations of every bone and the whole local transform of a bone with no body.
  pub fn bodiesToPose(self &, w &World, skel &Skeleton, base &Pose, placement Rigid) Pose {
    var out = base.copy();
    let inv = placement.inverse();
    var mRot = List[Quat].empty();
    var mPos = List[Vec3].empty();
    let one = new Vec3(1., 1., 1.);
    let n = skel.boneCount();
    var i = 0usize;
    while i < n {
      let p = skel.parentOf(i);
      let l = *boneLink[i];
      var rm = Quat.identity();
      var pm = zero3();
      if l >= 0i32 {
        let link = links[usize.from(l)];
        let bt = self.boneFromBody(link,w.transformOf(link.body).pos, w.rotationOf(link.body));
        rm = (inv.rot * bt.rot).normalize();
        pm = inv.rot * bt.pos + inv.pos;
        if p < 0i32 {
          out.locals.set(i, new Transform3(pm, rm, one));
        } else {
          let lt = *base.locals[i];
          out.locals.set(i, new Transform3(lt.translation, ((*mRot[usize.from(p)]).conjugate() * rm).normalize(), one));
        }
      } else {
        let lt = *base.locals[i];
        if p < 0i32 { rm = lt.rotation; pm = lt.translation; }
        else { rm = ((*mRot[usize.from(p)]) * lt.rotation).normalize(); pm = (*mPos[usize.from(p)]) + (*mRot[usize.from(p)]) * lt.translation; }
      }
      mRot.push(rm);
      mPos.push(pm);
      i = i + 1usize;
    }
    out
  }

  // ------------------------------------------------------------------ body queries

  // The whole ragdoll's centre of mass, world
  pub fn centerOfMass(self &, w &World) Vec3 {
    var c = zero3();
    var m = 0.f;
    var k = 0usize;
    while k < links.len() {
      let id = links[k].body;
      c = c + w.centerOfMass(id) * links[k].mass;
      m = m + links[k].mass;
      k = k + 1usize;
    }
    c * (1. / m)
  }

  // The whole ragdoll's momentum, world (kg m/s)
  pub fn momentum(self &, w &World) Vec3 {
    var c = zero3();
    var k = 0usize;
    while k < links.len() {
      c = c + w.linearVelocity(links[k].body) * links[k].mass;
      k = k + 1usize;
    }
    c
  }

  // The lowest world y over every body's shape
  pub fn lowestPoint(self &, w &World, spec &RigSpec) f32 {
    var lowest = 1000000.f;
    var k = 0usize;
    while k < links.len() {
      let l = links[k];
      let bs = spec.bones[l.bone];
      let xf = w.transformOf(l.body);
      lowest = minf(lowest, shapeLowest(bs,xf.pos, xf.rot));
      k = k + 1usize;
    }
    lowest
  }
}

// The world settings that suit a ragdoll: 8 sub-steps a step and contacts at 120 Hz (the stiffest 8 sub-steps allow).
// Measured on limp ragdolls dropped from 1 m and 2 m at three turns and two headings (12 drops): the largest gap
// between a joint's two anchors (the worst drop, and the mean of the 12 worst), how deep a limb sank into the floor:
//
//                              before the solver work           now (joint sweeps, mass-ratio softness, no CCD tear)
//   4 sub-steps, 30 Hz  (defaults) 15.6 cm worst, 8.0 mean, 2.5 cm sank     1.2 cm worst, 0.7 mean, 3.2 cm sank
//   8 sub-steps, 120 Hz (these)    16.2 cm worst, 6.2 mean, 0.8 cm sank     1.5 cm worst, 0.8 mean, 0.4 cm sank
//
// The defaults now hold the joints as well as these do (it was the joints that needed these settings, and the cause was
// the solver, not the rate: see rigiddynamics' joint.cone and World.continuous). What these still buy is contact depth: a
// limb pinned under the body sinks 0.4 cm instead of 3.2. They cost twice the solver time of the default for a world
// with a ragdoll in it; a ragdoll is 14 bodies. Everything else stays at rigiddynamics' defaults. A standing, driven
// ragdoll also holds its pose better on these settings (0.001 rad against 0.02) because the drive is a row of the
// same solver. (4 sub-steps with contacts at 60 Hz, the cap, is unstable with a ragdoll in the world.)
pub fn tuneWorld(w &mut World) {
  w.settings.substeps = 8;
  w.settings.contactHertz = 120.;
}

// The collision primitive of a bone's main shape
fn primOf(bs &BoneSpec) Prim {
  if bs.shape == SHAPE_CAPSULE { return Prim.capsule(bs.radius, bs.halfLen); }
  if bs.shape == SHAPE_BOX { return Prim.box(bs.half); }
  Prim.sphere(bs.radius)
}

// The lowest world y of a bone's shape with its body at 'pos' and 'rot'
pub fn shapeLowest(bs &BoneSpec, pos Vec3, rot Quat) f32 {
  if bs.shape == SHAPE_SPHERE { return pos.y - bs.radius; }
  if bs.shape == SHAPE_CAPSULE {
    let axisW = rot * new Vec3(0., 1., 0.);
    return pos.y - absf(axisW.y) * bs.halfLen - bs.radius;
  }
  let ex = rot * new Vec3(1., 0., 0.);
  let ey = rot * new Vec3(0., 1., 0.);
  let ez = rot * new Vec3(0., 0., 1.);
  pos.y - (absf(ex.y) * bs.half.x + absf(ey.y) * bs.half.y + absf(ez.y) * bs.half.z)
}
