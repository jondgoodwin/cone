// The powered ragdoll (an "active ragdoll"): each joint is driven towards a target pose by a spring and a
// damper, with a strength that runs from nothing (limp) to the joint's full torque (animated).
//
// METHOD. Every joint drives its child body's orientation towards the orientation relative to its PARENT BODY
// that the target pose says (the way Unity's ConfigurableJoint targetRotation and Unreal's physical animation
// drive: in the parent's frame, so a stagger of the whole body does not fight the animation, only the shape
// of it). The drive is a row of the rigid-body solver itself (rigiddynamics, World.setJointDrive): a stiff
// soft constraint (Catto, Solver2D 2024: a spring given as a frequency and a damping ratio) on the joint's relative
// rotation, with its accumulated torque held to the joint's strength, solved in the same sweeps as the joint's
// other rows and the contacts. That matters. A first try applied a proportional-derivative controller of
// Tan, Turk and Liu ("Stable Proportional-Derivative Controllers", 2011) to each joint's two bodies before the
// step; it is stable for one joint alone but a standing body is a chain of joints each carrying the weight of
// everything above, a small body such as a spine segment must hold a large load, and the controller, which cannot
// see the load until the bodies have moved, put the lightest bodies into a growing oscillation. Inside the
// solver the load is part of the same system of equations and the drive holds it up as far as its torque
// limit allows, then yields.
//
// THE BLEND. 'blend' scales the joints' torque limits and (by its square root) their frequency; at 0 the
// drive is off and only a light 'passiveDamping' acts (joint friction, so a limp body does not swing for
// ever). In between is a body that can be knocked about and recovers. The pelvis has no parent, so nothing holds the
// whole body upright unless 'rootHertz' is set; then a controller holds its orientation in the world (as an assist
// with no reaction on anything: a hand on the character's back).
//
// Apply the drive once before each World step (stepRagdoll does).

// The rotation vector (axis times angle) of a unit quaternion, the shorter way round
pub fn rotVec(q0 Quat) Vec3 {
  mut q = q0;
  if q.w < 0. { q = new Quat(-q.x, -q.y, -q.z, -q.w); }
  imm s = (q.x * q.x + q.y * q.y + q.z * q.z).sqrt();
  if s < 0.000001 { return new Vec3(q.x, q.y, q.z) * 2.; }
  new Vec3(q.x, q.y, q.z) * (2. * atan2(s, q.w) / s);
}

// Set the pose the joints are driven towards: 'pose' in the model space placed at 'placement'
pub fn setTarget(rig &mut Ragdoll, skel &Skeleton, pose &Pose, placement Rigid) {
  mut models = List[Transform3].empty();
  skel.modelTransforms(pose, &mut models);
  mut k = 0usize;
  while k < rig.links.len() {
    imm l = rig.links[k];
    imm bm = *models[l.bone];
    if l.parent >= 0i32 {
      imm pb = *models[rig.links[usize.from(l.parent)].bone];
      rig.links[k].targetRel = (pb.rotation.conjugate() * bm.rotation).normalize();
    } else {
      rig.rootTarget = (placement.rot * bm.rotation * l.shapeRot).normalize();
    }
    k = k + 1usize;
  }
}

// The rotation of link k's body relative to its parent's that the target pose says
pub fn targetBodyRelative(rig &Ragdoll, k usize) Quat {
  imm l = rig.links[k];
  imm pl = rig.links[usize.from(l.parent)];
  (pl.shapeRot.conjugate() * l.targetRel * l.shapeRot).normalize();
}

// The target orientation of link k's body in the world, from the parent's actual orientation
pub fn targetRotation(rig &Ragdoll, w &World, k usize) Quat {
  imm l = rig.links[k];
  imm pl = rig.links[usize.from(l.parent)];
  (w.rotationOf(pl.body) * targetBodyRelative(rig, k)).normalize();
}

// How far link k's joint is from the target, radians (0 for the root)
pub fn driveError(rig &Ragdoll, w &World, k usize) f32 {
  if rig.links[k].parent < 0i32 { return 0.; }
  rotVec(targetRotation(rig, w, k) * w.rotationOf(rig.links[k].body).conjugate()).length();
}

// The largest drive error over the joints
pub fn maxDriveError(rig &Ragdoll, w &World) f32 {
  mut m = 0.;
  mut k = 0usize;
  while k < rig.links.len() { m = maxf(m, driveError(rig, w, k)); k = k + 1usize; }
  m;
}

// The inertia (kg m^2, a scalar: a third of the trace plus mass times distance squared) of link k's body and
// every body below it, about link k's joint
pub fn subtreeInertia(rig &Ragdoll, w &World, k usize) f32 {
  imm l = rig.links[k];
  imm anchor = w.transformOf(l.body).pos - w.rotationOf(l.body) * l.center;
  mut total = 0.;
  mut j = k;
  while j < rig.links.len() {
    mut a = i32.from(j);
    mut below = false;
    while a >= 0i32 {
      if usize.from(a) == k { below = true; break; }
      a = rig.links[usize.from(a)].parent;
    }
    if below {
      imm b = w.bodies[usize.from(rig.links[j].body)];
      imm tr = b.inertiaLocal.cell(0usize, 0usize) + b.inertiaLocal.cell(1usize, 1usize) + b.inertiaLocal.cell(2usize, 2usize);
      total = total + tr / 3. + b.mass * (b.pos - anchor).lengthSquared();
    }
    j = j + 1usize;
  }
  total;
}

// Configure the solver's drive rows from the blend and the target, and apply the light passive damping
pub fn driveJoints(rig &mut Ragdoll, w &mut World, dt f32) {
  imm bl = clampf(rig.blend, 0., 1.);
  mut k = 0usize;
  while k < rig.links.len() {
    imm l = rig.links[k];
    if l.parent < 0i32 or l.joint == NoBody { k = k + 1usize; continue; }
    if bl > 0. {
      w.setJointDrive(l.joint, rig.hertz * bl.sqrt(), rig.damping, l.maxTorque * bl);
      w.setDriveTarget(l.joint, targetBodyRelative(rig, k));
    } else {
      w.clearJointDrive(l.joint);
    }
    // passive joint friction: relative spin of the pair decays at 'passiveDamping' times the unpowered share
    imm pd = rig.passiveDamping * (1. - bl);
    if pd > 0. {
      imm pl = rig.links[usize.from(l.parent)];
      imm ip = usize.from(pl.body);
      imm ic = usize.from(l.body);
      imm wr = w.bodies[ic].angVel - w.bodies[ip].angVel;
      if wr.length() > 0.000001 {
        imm iA = rotateInertia(w.bodies[ip].rot, w.bodies[ip].invInertiaLocal);
        imm iB = rotateInertia(w.bodies[ic].rot, w.bodies[ic].invInertiaLocal);
        imm iRef = subtreeInertia(rig, w, k);
        imm kd = pd * iRef;
        imm km = mat3Add(iA, iB);
        imm tr = km.cell(0usize, 0usize) + km.cell(1usize, 1usize) + km.cell(2usize, 2usize);
        if tr > 0.0000001 {
          imm ieff = 3. / tr;
          imm lam = km.inverse() * (wr * (-kd * dt / (ieff + kd * dt)));
          w.bodies[ic].angVel = w.bodies[ic].angVel + iB * lam;
          w.bodies[ip].angVel = w.bodies[ip].angVel - iA * lam;
        }
      }
    }
    k = k + 1usize;
  }
  // the optional hold on the pelvis' orientation
  if rig.rootHertz > 0. and bl > 0. {
    mut r = 0usize;
    while r < rig.links.len() {
      if rig.links[r].parent < 0i32 {
        imm ir = usize.from(rig.links[r].body);
        imm om = 2. * pi * rig.rootHertz;
        imm kpr = bl * om * om;
        imm kdr = 2. * rig.damping * om * bl.sqrt();
        imm er = rotVec(rig.rootTarget * w.bodies[ir].rot.conjugate());
        imm wv = w.bodies[ir].angVel;
        mut acc = (er * kpr - wv * (kpr * dt + kdr)) * (1. / (1. + kdr * dt + kpr * dt * dt));
        imm lim = 60. * bl;
        if acc.length() > lim { acc = acc * (lim / acc.length()); }
        if er.length() > 0.001 { w.wake(rig.links[r].body); }
        w.bodies[ir].angVel = w.bodies[ir].angVel + acc * dt;
      }
      r = r + 1usize;
    }
  }
}
