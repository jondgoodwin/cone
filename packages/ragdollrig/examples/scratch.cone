mod scratch;

import stdio use *;
import collections use List;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;
import bonepose use * but absf, clampf;
import ragdollrig use *;

fn twistAbout(q0 Quat) f32 {
  imm sg = if q0.w < 0. { -1.; } else { 1.; };
  wrapAngle(2. * atan2(q0.x * sg, q0.w * sg));
}

fn main() i32 {
  sim(4, 60., 2.);
  0i32;
}

fn sim(substeps i32, jh f32, jd f32) {
  imm skel = humanoid(1.75);
  imm spec = humanoidSpec(&skel, 1.75, 70.);
  mut w = World.make();
  w.settings.substeps = substeps;
  w.settings.jointHertz = jh;
  w.settings.jointDamping = jd;
  imm ground = w.addShape(Shape.single(Prim.box(new Vec3(20., 1., 20.))));
  w.createBody(BodyDef.staticAt(ground, new Vec3(0., -1., 0.)));
  mut rig = Ragdoll.make(&mut w, &skel, &spec, Rigid.at(new Vec3(0., 2.0, 0.)), 1u32);
  rig.blend = 0.;
  mut worstErr = 0.;
  mut worstHinge = 0.;
  mut worstCone = 0.;
  mut worstTwist = 0.;
  mut worstEll = 0.;
  mut settledAt = -1;
  mut i = 0;
  while i < 600 {
    stepRagdoll(&mut rig, &mut w, 1. / 60.);
    if settledAt < 0 and rig.settled { settledAt = i; }
    mut k = 0usize;
    while k < rig.links.len() {
      imm l = rig.links[k];
      if l.joint != NoBody {
        imm j = w.joints[usize.from(l.joint)];
        worstErr = maxf(worstErr, w.jointError(l.joint));
        if w.jointError(l.joint) > 0.05 { print <- "  anchor step "; print <- i; print <- " bone "; print <- l.bone; print <- " err "; print <- w.jointError(l.joint); print <- "\n"; }
        if l.kind == JOINT_HINGE {
          imm a = w.hingeAngleOf(l.joint);
          if maxf(l.lo - a, a - l.hi) > 0.1 and l.bone != HAND_L and l.bone != HAND_R and i < 200 { print <- "  step "; print <- i; print <- " bone "; print <- l.bone; print <- " angle "; print <- a; print <- " range "; print <- l.lo; print <- ".."; print <- l.hi; print <- "\n"; }
          worstHinge = maxf(worstHinge, maxf(l.lo - a, a - l.hi));
        } else {
          imm pl = rig.links[usize.from(l.parent)];
          imm fa = (w.rotationOf(pl.body) * j.fa).normalize();
          imm fb = (w.rotationOf(l.body) * j.fb).normalize();
          imm rel = (fa.conjugate() * fb).normalize();
          imm xa = fa * new Vec3(1., 0., 0.);
          imm xb = fb * new Vec3(1., 0., 0.);
          imm swing = acos(clampf(xa.dot(xb), -1., 1.));
          worstCone = maxf(worstCone, swing - l.cone);
          imm tw = twistAbout(rel);
          worstTwist = maxf(worstTwist, maxf(l.lo - tw, tw - l.hi));
          worstEll = maxf(worstEll, swingMeasure(&rig, &w, k));
        }
      }
      k = k + 1usize;
    }
    i = i + 1;
  }
  print <- "substeps "; print <- substeps; print <- " jh "; print <- jh; print <- " jd "; print <- jd; print <- ": worst joint anchor error "; print <- worstErr; print <- " hinge past limit "; print <- worstHinge; print <- " cone past "; print <- worstCone; print <- " twist past "; print <- worstTwist; print <- " ellipse "; print <- worstEll; print <- " settled at "; print <- settledAt; print <- " peak "; print <- rig.peak; print <- "\n";
}
