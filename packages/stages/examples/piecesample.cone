// Today's stages against the stream core, in one program so both run on the same build and alternate.
//
//   congo run --release packages/stages/examples/piecesample.cone -- <old|new> <socket|bigin|bigraw|bigin2|bigraw2> [MiB]
//
//   socket   a socket sends the gzip stream; inflate, sha256, file (PR 7's sample; pieces of 64 KiB)
//   bigin    the gzip stream comes from memory in 256 KiB pieces; inflate, sha256, file
//   bigraw   the data itself comes from memory in 256 KiB pieces; sha256, sha256, file
//   bigin2, bigraw2   (new only) the same, the producer's pool holding two pieces: bigin's and bigraw's pool is
//            the window's size, one such piece, and a pool's cap wins over the floor of two, so those send one
//            at a time; these two show the floor
//   old      today's SocketSource (or a chunk source of the same window), TransformStage, HashStage, FileSink
//   new      SocketFrom (or a producer with a PieceWindow), TransformPass, HashPass, FileTo, all at their defaults
//
// It prints the milliseconds from the start to the file written, the rate over the data's bytes, the tail (from
// the source's last piece sent to the file's report, in microseconds), the messages the workers handled, and 'ok'.
// A 'bad' last field means a wrong digest, size or failure.

mod piecesample;

import stdio use *;
import collections use *;
import iobuf use IoBuf;
import fs;
import path use Path;
import iocore use SocketAddr, IoError, Access;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import time use Instant;
import actors;
import aio use Socket, File;
import streams use *;
import stages use *;
import stageio use *;
import deflate;
import cryptohash;

const bigPiece = 262144usize;

fn corpus(n: usize) List[u8] {
  let w: Array[&str, 5] = ["alpha ", "beta ", "gamma ", "delta ", "epsilon "];
  var d = List[u8].withCapacity(n + 16usize);
  var s = 7u64;
  while d.len() < n {
    s = s * 6364136223846793005u64 + 1442695040888963407u64;
    let word = w[usize.from((s >> 40u64) % 5u64)];
    var i = 0usize;
    while i < word.len { d.push(word[i]); i += 1usize; }
  }
  d.truncate(n);
  d
}

fn socketOf(r: Result[Socket, IoError]) Socket {
  var res = r;
  var s = Socket.none();
  match &mut res {
    case var &mut Ok(ok) {s <-> *ok;}
    case let &mut Err(e) { panic("socketOf: the operation failed"); }
  }
  s
}

fn digits(p: *u8) u32 {
  var n = 0u32;
  var q = p;
  while *q >= 48u8 && *q <= 57u8 {
    n = n * 10u32 + u32.from(*q - 48u8);
    q = q + 1usize;
  }
  n
}

struct Result0 {
  pub bytes: Atomic[u64];
  pub digestOk: Atomic[u64];
  pub failed: Atomic[u64];
  pub sentAt: Atomic[u64];       // the steady clock when the source sent its last piece
}

let outcome: Result0;

fn @initpure init() {
  outcome = Result0(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

fn markSent() {
  outcome.sentAt.store(u64.from(Instant.now().nanos()));
}

actor Server {
  gz: List[u8];

  pub fn init(self: &new, gz: List[u8]) { *self = Self(gz: gz); }

  pub async fn serve(self, port: OneshotSender[u16]) {
    let listener = socketOf(await aio.listen(SocketAddr.localhost(0u16)));
    let addr = await listener.localAddr();
    var p = port;
    match addr {
      case let Ok(a) { p.send(a.port()); }
      case is Err { p.send(0u16); return; }
    }
    let conn = socketOf(await listener.accept());
    var at = 0usize;
    var more = true;
    while more && at < gz.len() {
      let n = if gz.len() - at < 65536usize {gz.len() - at} else {65536usize};
      var buf = IoBuf(n);
      buf.append(&gz.view()[at ..< at + n]);
      at = at + n;
      let sent = await conn.write(buf);
      match sent {
        case is Err { more = false; }
        else {}
      }
    }
    markSent();
  }
}

actor Checker is DigestSink[Array[u8, 32]] {
  want: List[u8];

  pub fn init(self: &new, want: List[u8]) { *self = Self(want: want); }

  pub async fn digest(self, r: Result[Array[u8, 32], AnyError]) {
    match r {
      case let Ok(d) {
        var same = true;
        var i = 0usize;
        while i < 32usize {
          if d[i] != want[i] { same = false; }
          i = i + 1usize;
        }
        if same { outcome.digestOk.add(1u64); }
      }
      case is Err { outcome.failed.add(1u64); }
    }
  }
}

// Today's side of the big-piece modes: a source of 256 KiB chunks with the default window
actor OldBig is ChunkSource {
  down: Option[ChunkSink];
  link: ChunkWindow;
  data: List[u8];
  at: usize;

  pub fn init(self: &new, down: ChunkSink, data: List[u8]) {
    *self = Self(down: Some[ChunkSink](down), link: ChunkWindow.own(linkWindow), data: data, at: 0usize);
    down.attach(selfactor);
  }

  pub async fn start(self) { self.pump(); }

  pub async fn giveBack(self, b: IoBuf) {
    link.give(b);
    self.pump();
  }

  pub async fn stop(self, why: Ending) {}

  fn pump(self: &mut) {
    var more = down is Some;
    while more {
      if at >= data.len() {
        var k = None[ChunkSink];
        k <-> down;
        match k {
          case let Some(s) { s.end(Ending.Finished); }
          case is None {}
        }
        more = false;
      } else {
        match link.take(bigPiece) {
          case is None { more = false; }
          case let Some(b) {
            var buf = b;
            let n = if data.len() - at < bigPiece {data.len() - at} else {bigPiece};
            buf.append(&data.view()[at ..< at + n]);
            at = at + n;
            if at >= data.len() { markSent(); }
            match &down {
              case let &Some(k) { k.accept(buf); }
              case is None {}
            }
          }
        }
      }
    }
  }
}

// The core's side: the same, from a PieceWindow at the default, its buffers from a pool of 'poolBytes'
// (PieceWindow is transitional, no part of stages' API: piecewindow.cone)
actor NewBig {
  pub async fn run(self, to: StreamTo[IoBuf], data: List[u8], poolBytes: usize) {
    var dest = to;
    var w = PieceWindow[IoBuf].bytes(dest.budget, ChunkPool.make(poolBytes));
    var at = 0usize;
    var stopped = false;
    while at < data.len() && !stopped {
      match fresh(&mut w, bigPiece) {
        case let Some(b) {
          var buf = b;
          let n = if data.len() - at < bigPiece {data.len() - at} else {bigPiece};
          buf.append(&data.view()[at ..< at + n]);
          at = at + n;
          let cost = buf.capacity();
          w.sent(dest.sink.piece(dest.tag, buf), cost);
          if at >= data.len() { markSent(); }
        }
        case is None {
          match w.oldest() {
            case let Some(reply) {
              let a = await reply;
              if w.answered(a) is Some { stopped = true; }
            }
            case is None {}
          }
        }
      }
    }
    var more = true;
    while more {
      match w.oldest() {
        case let Some(reply) {
          let a = await reply;
          _ = w.answered(a);
        }
        case is None { more = false; }
      }
    }
    dest.end(Ending.Finished);
  }
}

// The core's pipeline: the file is opened first (FileTo takes an open file), then the stages are made from the
// sink end back, and the source is started
actor Wire {
  pub async fn run(self, port: u16, name: String, data: List[u8], want: List[u8], mode: u32, poolBytes: usize,
      fileTx: OneshotSender[Result[u64, AnyError]]) {
    let opened = await aio.openFile(&Path.from(name.view()), Access.Create);
    var file = File.none();
    match opened {
      case let Ok(f) { file = f; }
      case let Err(e) {
        var tx = fileTx;
        tx.send(Err[u64, AnyError](AnyError.from(e)));
        return;
      }
    }
    let sink = FileTo(file, fileTx);
    var wantAgain = List[u8]();
    wantAgain.appendSlice(want.view());
    let hash = HashPass[cryptohash.Sha256](StreamTo[IoBuf].at(sink, 1u64), cryptohash.Sha256.make(), Checker(want));
    if mode == 2u32 {
      let first = HashPass[cryptohash.Sha256](StreamTo[IoBuf].at(hash, 1u64), cryptohash.Sha256.make(),
        Checker(wantAgain));
      NewBig().run(StreamTo[IoBuf].at(first, 1u64), data, poolBytes);
    } else {
      let inf = TransformPass[deflate.Inflater](StreamTo[IoBuf].at(hash, 1u64),
        deflate.Inflater.make(deflate.Format.Gzip));
      if mode == 0u32 {
        SocketFrom().run(SocketAddr.localhost(port), StreamTo[IoBuf].at(inf, 1u64));
      } else {
        NewBig().run(StreamTo[IoBuf].at(inf, 1u64), data, poolBytes);
      }
    }
  }
}

fn main(argc: i32, argv: **u8) i32 {
  initAll();
  var isNew = false;
  var mode = 0u32;                          // 0 socket, 1 bigin, 2 bigraw
  var mib = 64u32;
  var two = false;                          // the new producer's pool holds two pieces
  if argc > 1i32 { isNew = *(*(argv + 1usize)) == 'n'; }
  if argc > 2i32 {
    let m = *(argv + 2usize);
    if *m == 'b' { mode = if *(m + 3usize) == 'i' {1u32} else {2u32}; }
    var end = m;
    while *end != 0u8 { end = end + 1usize; }
    two = *(end - 1usize) == '2';
  }
  let poolBytes = if two {2usize * bigPiece} else {linkWindow};
  if argc > 3i32 { mib = digits(*(argv + 3usize)); }
  let size = usize.from(mib) * 1048576usize;
  let data = corpus(size);
  var feed = List[u8]();
  if mode == 2u32 { feed.appendSlice(data.view()); }
  else { feed = deflate.gzipCompress(data.view(), 6); }
  let digest = cryptohash.sha256(data.view());
  var want = List[u8]();
  want.appendSlice(&digest);
  let name = "piecesample.tmp";

  var fileTx: OneshotSender[Result[u64, AnyError]];
  var fileRx: OneshotReceiver[Result[u64, AnyError]];
  fileTx, fileRx = Oneshot[Result[u64, AnyError]].make();

  var port = 0u16;
  var served = List[u8]();
  if mode == 0u32 {
    served.appendSlice(feed.view());
  }
  let m0 = actors.stats().messages;
  var t0 = Instant.now();
  {
    if mode == 0u32 {
      var portTx: OneshotSender[u16];
      var portRx: OneshotReceiver[u16];
      portTx, portRx = Oneshot[u16].make();
      let server = Server(served);
      server.serve(portTx);
      match portRx.recv() {
        case let Some(p) { port = p; }
        case is None {}
      }
    }
    t0 = Instant.now();
    if isNew {
      Wire().run(port, String.from(name), feed, want, mode, poolBytes, fileTx);
    } else {
      let sink = FileSink(String.from(name), fileTx);
      var wantAgain = List[u8]();
      wantAgain.appendSlice(want.view());
      let hash = HashStage[cryptohash.Sha256](sink, cryptohash.Sha256.make(), Checker(want));
      if mode == 2u32 {
        let first = HashStage[cryptohash.Sha256](hash, cryptohash.Sha256.make(), Checker(wantAgain));
        OldBig(first, feed).start();
      } else {
        let inf = TransformStage[deflate.Inflater](hash, deflate.Inflater.make(deflate.Format.Gzip));
        if mode == 0u32 {
          SocketSource(inf).start(SocketAddr.localhost(port));
        } else {
          OldBig(inf, feed).start();
        }
      }
    }
  }
  match fileRx.recv() {
    case let Some(r) {
      match r {
        case let Ok(n) { outcome.bytes.store(n); }
        case is Err { outcome.failed.add(1u64); }
      }
    }
    case is None { outcome.failed.add(1u64); }
  }
  let doneAt = u64.from(Instant.now().nanos());
  let ns = u64.from(t0.elapsed().nanos());
  finalAll();
  let msgs = actors.stats().messages - m0;
  let digests = if mode == 2u32 {2u64} else {1u64};
  let ok = outcome.digestOk.load() == digests && outcome.failed.load() == 0u64
    && outcome.bytes.load() == u64.from(size);
  _ = fs.removeFile(&Path.from(name));
  let tail = doneAt - outcome.sentAt.load();
  printStr(if isNew {"new"} else {"old"});
  printStr(if mode == 0u32 {" socket"} else if mode == 1u32 {" bigin"} else {" bigraw"});
  printStr(if two {"2 "} else {" "});
  printUInt(u64.from(mib)); printStr(" MiB: ");
  printUInt(ns / 1000000u64); printStr(" ms, ");
  printUInt(u64.from(size) * 1000u64 / ns); printStr(" MB/s, tail ");
  printUInt(tail / 1000u64); printStr(" us, msgs "); printUInt(msgs); printStr(" ");
  printStr(if ok {"ok"} else {"bad"}); printStr("\n");
  if ok {0i32} else {1i32}
}
