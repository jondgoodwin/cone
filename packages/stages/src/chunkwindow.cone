// ======== Layer 3, credit: a ChunkWindow is one stream's window, and takes its buffers from a ChunkPool ========
//
// A link is the SENDING half of the connection between two stages, one per
// stream. CREDIT IS A WINDOW OF BYTES: a stage may send a chunk only while the
// chunks it has sent and not yet had back, with this one, stay within the link's
// window (256 KiB by default, 'linkWindow'). It sends the buffer (moved, to the
// next stage's 'accept'), and the consumer, once it has FINISHED with the chunk,
// gives the same buffer back with the source's 'giveBack': that call is the
// acknowledgement "chunk n is done", and it returns the buffer's bytes to the
// window. So at most a window's worth of a stream is ever in flight, however
// slow its consumer, and a stage with no room in its window waits: it does
// nothing until a 'giveBack' arrives. A stalled stream costs the others
// nothing, because every stream has a link of its own.
//
// The memory is not the credit's business. A buffer is taken from the link's ChunkPool
// (chunkpool.cone), which may be shared by many links (a connection's streams, a
// pipeline's stages), only when there is data to carry, sized to it ('take' says
// how many bytes are wanted, and the buffer is the smallest size class that holds
// them), and the pool bounds all of them together.
//
//   let pool = ChunkPool.make(1048576usize);         // shared; or ChunkWindow.own(window), a pool of its own
//   var link = ChunkWindow.make(262144usize, pool);    // this stream may have 256 KiB in flight
//   match link.take(65536usize) {               // None when the window or the pool is full
//     case let Some(b) { ... fill b ...; sink.accept(b); }
//     case is None { /* wait for giveBack */ }
//   }
//   link.give(b);                               // a buffer came back (its bytes leave the window)
//
//   link.take(want)       a buffer, empty, with room for at least 'want' bytes; None (and a stall counted)
//                         when its capacity would pass the window or the pool's cap. Always a buffer when
//                         nothing is in flight, so that a window smaller than one chunk still works
//   link.give(b)          a buffer back. A panic if it is more than the link has lent
//   link.window()         the bytes this stream may have in flight
//   link.inFlightBytes()  bytes lent and not back     link.inFlight()  the buffers they are in
//   link.peak()           the most buffers in flight at once so far      link.peakBytes()  and the bytes
//   link.stalls()         takes that found no room: how often the consumer held the producer back
//   link.sharedPool()     the pool it draws on
//
// The bytes a buffer counts for are its CAPACITY, which is a whole size class, so
// a window and a pool measure memory, not the length of what was written.
//
// A link lives in the one stage that sends through it (an actor's state), so it
// takes no lock for itself; the pool's counts are atomic, since the stages that
// share a pool run on different threads. When a link is dropped the pool has back
// whatever it still owed, so an abandoned stream does not keep a share of the pool.

// The capacity an IoBuf asked for 'want' bytes has: the smallest size class that holds them,
// or whole pages past the largest class
fn capacityFor(want: usize) usize {
  var c = 0u32;
  while c < iobuf.classCount {
    let size = iobuf.classSize(c);
    if want <= size { return size; }
    c = c + 1u32;
  }
  (want + iobuf.page - 1usize) / iobuf.page * iobuf.page
}

pub struct ChunkWindow is Move {
  pool: ChunkPool;
  size: usize;        // the window, in bytes
  held: usize;        // bytes of buffers out now (their capacities)
  count: usize;       // buffers out now
  top: usize;         // the most buffers out at once
  topBytes: usize;    // the most bytes out at once
  stalled: u64;       // takes that found no room

  // A stream that may have 'window' bytes in flight, its buffers from 'pool'
  pub fn make(window: usize, pool: ChunkPool) ChunkWindow {
    ChunkWindow(pool, window, 0usize, 0usize, 0usize, 0usize, 0u64)
  }

  // A stream with a pool of its own, as big as its window: what a pipeline of one stream wants
  pub fn own(window: usize) ChunkWindow {
    ChunkWindow.make(window, ChunkPool.make(window))
  }

  // An empty buffer with room for at least 'want' bytes, or None when the window or the pool is full
  pub fn take(self: &mut, want: usize) Option[IoBuf] {
    let cap = capacityFor(want);
    let last = held == 0usize;
    if (!last && held + cap > size) || !pool.reserve(cap, last) {
      stalled = stalled + 1u64;
      return None[IoBuf];
    }
    held = held + cap;
    count = count + 1usize;
    if count > top { top = count; }
    if held > topBytes { topBytes = held; }
    Some[IoBuf](IoBuf(want))
  }

  // A buffer back from the consumer (or one a stage took and did not send)
  pub fn give(self: &mut, b: IoBuf, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    let cap = b.capacity();
    if count == 0usize || cap > held { panic("streams: ChunkWindow.give with a buffer this link did not lend", file, line); }
    held = held - cap;
    count = count - 1usize;
    pool.release(cap);
    // b ends here: its block goes home to the buffer pool
  }

  pub fn window(self: &) usize { size }
  pub fn inFlightBytes(self: &) usize { held }
  pub fn inFlight(self: &) usize { count }
  pub fn peak(self: &) usize { top }
  pub fn peakBytes(self: &) usize { topBytes }
  pub fn stalls(self: &) u64 { stalled }
  pub fn sharedPool(self: &) ChunkPool { pool }

  // Whatever is still out is the pool's again: an abandoned stream keeps nothing of it
  fn final(self: &uni) {
    pool.release(held);
  }
}
