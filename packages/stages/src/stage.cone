// ======== Layer 3, stages between actors: chunks that move under credit ========
//
// Between two actors a stream is a run of owned chunks (an IoBuf each), handed
// on by a call and given back by another. Two actor traits say what a stage
// is to its neighbours; neither names the other's actor, so any actor that has
// the behaviours is a stage (the manual's Actor traits).
//
//   ChunkSink    what takes chunks:  accept(c)   a chunk, moved in
//                                    end(how)    the stream is over: Ending
//                                    attach(up)  who to give buffers back to
//   ChunkSource  what gets them back: giveBack(b) an emptied buffer
//
// The end, and an error, travel FORWARD as the call 'end(how)', after the last
// chunk and from the same sender, so they arrive in order. They are never a
// cancel. An 'Ending' is Finished or Failed(AnyError): the AnyError is Sendable,
// so it crosses between actors, and a transform's 'failure()' makes it from the
// codec's own typed error (DeflateError, ZstdError) with nothing lost: its
// message, its chain of causes, and 'holds[E]()' to take the typed error out.
//
// THE CREDIT IS THE BUFFERS (link.cone). A stage owns a Link of N buffers and
// sends only while it holds one; the consumer gives the same buffer back when
// its bytes are used up. A pipeline is wired from the sink end back: each stage
// is made with the stage after it, and tells that stage who it is with
// 'attach(selfactor)' in its 'init', so the consumer can give buffers back.
// The handles that point upstream are dropped at the end of the stream (when
// the stage has seen the upstream 'end' and returned every buffer it holds), so
// the actors do not keep each other alive.
//
//   // sink end first; each stage is made with its downstream
//   let count = Counter();
//   let hash  = HashStage[cryptohash.Sha256](count, cryptohash.Sha256.make(), whoGetsTheDigest);
//   let inf   = Stage[deflate.Inflater](hash, deflate.Inflater.make(deflate.Format.Gzip));
//   source.start(inf);
//
// TWO ACTORS, each generic. 'Stage[T]' holds any Transform with its Link and
// does the work of a stage that makes new chunks (inflate, deflate, zstd): feed
// what arrives, pull what comes out into the link's buffers, and hold the input
// chunk until all its output is out. A pass-through such as a hash stage is
// 'HashStage[D]' over a Digester: the chunk goes on as it is, unmoved and
// uncopied, and comes back through the stage to the source. (Before generic
// actors each codec was an actor of its own over a 'StageCore[T]' or a
// 'HashCore[D]' that did the work; the actor is now the work.)
//
// 'sink <- chunk' is 'sink.accept(chunk)': the behaviour declares '<-' as its overload name.

// How a stream ended
pub enum Ending {
  // Every chunk has been sent
  Finished;
  // The stream could not be completed; the error says why
  Failed(AnyError);
}

// A stage that takes chunks: the chunk is moved in, the end follows the last
// chunk, and 'attach' comes before the first.
pub actor trait ChunkSink {
  // A chunk of the stream. Give it back to the source when its bytes are used.
  pub async fn accept overload `<-`(self, c: IoBuf);
  // The stream is over, one way or the other. Nothing is sent after.
  pub async fn end(self, how: Ending);
  // The stage that sends here, to give buffers back to; sent once, before the
  // first chunk.
  //
  // WHY 'attach' CANNOT BE OVERTAKEN by the first 'accept'. A source sends
  // 'attach' in its 'init', and 'accept' only from a behaviour that runs after
  // the init returned (a 'start' message, or a 'giveBack'), so the 'accept' is
  // caused by a send that came after the 'attach' in the creating thread. The
  // mailbox gives the consumer its messages in the order the sends claimed their
  // positions: a send claims with one sequentially consistent atomic add on the
  // mailbox's tail ('claim', packages/actors/src/actors.cone, THE MAILBOX) before
  // it returns, the consumer takes positions in order, and a message is never
  // overtaken by one it caused (the package header, MESSAGES). That holds across
  // the ring's segments and for senders on different workers
  // (actors/tests/ringfanin.cone checks each sender's order under fan-in). The
  // downstream stage therefore always knows its source before its first chunk.
  pub async fn attach(self, up: ChunkSource);
}

// A stage that lends buffers and takes them back
pub actor trait ChunkSource {
  // An emptied buffer back from its consumer: one more chunk may be sent
  pub async fn giveBack(self, b: IoBuf);
}

// Whoever wants the digest a hash stage worked out, 'Out' being the digest's
// type (Array[u8, 32] for sha256). It gets exactly one answer, when the stream
// ends: Ok with the digest if the stream finished, Err with the failure if it
// did not (the error that ended it, as text: see HashStage.end). So a waiter is
// never left waiting for a digest that will not come.
pub actor trait DigestSink[Out] {
  pub async fn digest(self, r: Result[Out, AnyError]);
}

// Gives a chunk back to its source, if the source is still held
fn handBack(up: &Option[ChunkSource], b: IoBuf) {
  match up {
    case let &Some(u) { u.giveBack(b); }
    case is None {}
  }
}

// ---- a stage that transforms: any Transform ----

// A stage over a transform 't', sending its output to 'down' in a link of
// 'linkBuffers' buffers of 'linkBytes' bytes. The transform comes in whole
// ('make' it first), and is the stage's from then on:
//
//   Stage[deflate.Inflater](down, deflate.Inflater.make(deflate.Format.Gzip))
//   Stage[deflate.Deflater](down, deflate.Deflater.make(deflate.Format.Gzip, 6i32))
//   Stage[zstd.Decompressor](down, zstd.Decompressor.make())
//   Stage[zstd.Compressor](down, zstd.Compressor.make(3i32))
pub actor Stage[T: Transform] is ChunkSink, ChunkSource {
  t: T;
  link: Link;                 // the output's buffers: N, and the credit
  down: ChunkSink;
  up: Option[ChunkSource];
  cur: Option[IoBuf];         // the input chunk being worked on; held until its output is all out
  backlog: Deque[IoBuf];      // chunks that arrived while 'cur' was held (at most the upstream's N)
  waiting: bool;              // a pull wants an output buffer and every one is out
  finishing: bool;            // the transform has been told its input is over
  dry: bool;                  // a pull after that said NeedInput once
  upEnded: bool;              // the upstream's 'end' has arrived
  ended: bool;                // our 'end' has been sent downstream

  pub fn init(self: &new, down: ChunkSink, t: T) {
    *self = Self(t: t, link: Link.make(linkBuffers, linkBytes), down: down, up: None[ChunkSource],
      cur: None[IoBuf], backlog: Deque[IoBuf].empty(), waiting: false, finishing: false, dry: false,
      upEnded: false, ended: false);
    down.attach(selfactor);
  }

  // The stage that sends here (the sink's 'attach')
  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source);
  }

  // A chunk arrives (the sink's 'accept')
  pub async fn accept(self, c: IoBuf) {
    if ended {
      handBack(&up, c);
    } else if cur is Some || upEnded {
      backlog.push(c);
    } else {
      t.feed(c.view());
      cur = Some[IoBuf](c);
      self.drain();
    }
    self.settle();
  }

  // The upstream's end arrives (the sink's 'end')
  pub async fn end(self, how: Ending) {
    upEnded = true;
    match how {
      case is Finished {
        if !waiting && !ended { self.drain(); }
      }
      case let Failed(e) {
        if !ended { self.finish(Ending.Failed(e)); }
      }
    }
    self.settle();
  }

  // An output buffer comes back (the source's 'giveBack')
  pub async fn giveBack(self, b: IoBuf) {
    link.give(b);
    if waiting { self.drain(); }
    self.settle();
  }

  // Pull while there is a buffer to pull into and something to pull
  fn drain(self: &mut) {
    waiting = false;
    var go = !ended;
    while go {
      match link.take() {
        case is None {
          waiting = true;
          go = false;
        }
        case let Some(b) {
          var out = b;
          let st = t.pull(&mut out);
          if out.isEmpty() { link.give(out); } else { down <- out; }
          if st == Status.Done {
            self.finish(Ending.Finished);
            go = false;
          } else if st == Status.Failed {
            self.finish(self.failed());
            go = false;
          } else if st == Status.NeedInput {
            go = self.nextInput();
          }
        }
      }
    }
  }

  // The input is used up: give the chunk back and go on to the next, or to the
  // end. Whether to pull again.
  fn nextInput(self: &mut) bool {
    self.returnCur();
    match backlog.popFront() {
      case let Some(c) {
        t.feed(c.view());
        cur = Some[IoBuf](c);
        return true;
      }
      case is None {}
    }
    if !upEnded { return false; }
    if !finishing {
      t.finish();
      finishing = true;
      return true;
    }
    if dry {
      self.finish(Ending.Failed(AnyError.msg("streams: the transform wants input after the stream's end")));
      return false;
    }
    dry = true;
    true
  }

  // Our end, once
  fn finish(self: &mut, how: Ending) {
    if ended { return; }
    ended = true;
    down.end(how);
  }

  fn failed(self: &) Ending {
    match t.failure() {
      case let Some(e) { Ending.Failed(e) }
      case is None { Ending.Failed(AnyError.msg("streams: the transform failed")) }
    }
  }

  fn returnCur(self: &mut) {
    var taken = None[IoBuf];
    taken <-> cur;
    match taken {
      case let Some(c) { handBack(&up, c); }
      case is None {}
    }
  }

  // Once both ends are over, every chunk held goes home and the upstream handle goes
  fn settle(self: &mut) {
    if ended && upEnded {
      self.returnCur();
      var more = true;
      while more {
        match backlog.popFront() {
          case let Some(c) { handBack(&up, c); }
          case is None { more = false; }
        }
      }
      up = None[ChunkSource];
    }
  }
}

// ---- a stage that passes chunks on and watches them: a digest ----

// A stage over a Digester 'd'. The chunk goes on as it is; the buffer comes
// back through this stage to the source. 'to' gets exactly one answer, when
// the stream ends, its digest type the digester's own ('D.Out'):
//
//   HashStage[cryptohash.Sha256](down, cryptohash.Sha256.make(), to)   // to: DigestSink[Array[u8, 32]]
pub actor HashStage[D: Digester] is ChunkSink, ChunkSource {
  d: D;
  down: ChunkSink;
  up: Option[ChunkSource];
  out: usize;                 // chunks passed on and not yet back
  upEnded: bool;
  to: DigestSink[D.Out];      // gets exactly one answer, when the stream ends

  pub fn init(self: &new, down: ChunkSink, d: D, to: DigestSink[D.Out]) {
    *self = Self(d: d, down: down, up: None[ChunkSource], out: 0usize, upEnded: false, to: to);
    down.attach(selfactor);
  }

  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source);
  }

  pub async fn accept(self, c: IoBuf) {
    d.feed(c.view());
    out = out + 1usize;
    down <- c;
  }

  pub async fn giveBack(self, b: IoBuf) {
    out = out - 1usize;
    handBack(&up, b);
    self.settle();
  }

  // Answers the digest sink, once: the digest if the stream finished, else an
  // error. An AnyError cannot be copied, so the sink gets the failure as text
  // (its report) and the stage after this one gets the original, typed.
  // Then passes the end on.
  pub async fn end(self, how: Ending) {
    upEnded = true;
    match &how {
      case is Finished { to.digest(Ok[D.Out, AnyError](d.finish())); }
      case let &Failed(e) { to.digest(Err[D.Out, AnyError](AnyError.msg(e.report().view()))); }
    }
    down.end(how);
    self.settle();
  }

  fn settle(self: &mut) {
    if upEnded && out == 0usize { up = None[ChunkSource]; }
  }
}
