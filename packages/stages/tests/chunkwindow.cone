// A ChunkWindow is one stream's window of bytes, and lends buffers from a ChunkPool: take
// until the window or the pool is full (a stall is counted), give back, and the
// counters say what happened. This runs one thread and no actor; the credit of a
// whole pipeline, with actors, is tested in credit.cone, and the order of a
// stream's chunks in chunkinbox.cone.
//
//   1. a window of three 4 KiB buffers: three takes, the fourth stalls, a give
//      makes room, the peak does not pass three;
//   2. buffers are sized to what is wanted: 100 bytes takes a 4 KiB block (the
//      smallest class), 5,000 a 16 KiB one, 70,000 a 256 KiB one, and the window
//      counts the blocks' capacities, not the bytes written;
//   3. a window smaller than one chunk still lends one (nothing in flight), and
//      no second;
//   4. two links share one pool with a cap: the cap holds, and a link with
//      nothing in flight is still lent one buffer (counted as floored);
//   5. a link dropped with buffers out hands them back to the pool's count.

mod chunkwindowtest;

import testing use *;
import collections use *;
import iobuf use IoBuf;
import stages use *;

fn take(link: &mut ChunkWindow, want: usize) IoBuf {
  match link.take(want) {
    case let Some(b) { b }
    case is None { expect(false, "a take that should find room does"); IoBuf() }
  }
}

fn main() i32 {
  // 1. a window of three 4 KiB buffers
  var link = ChunkWindow.own(12288usize);
  expectUInt(u64.from(link.window()), 12288u64, "a window of 12 KiB");
  expectUInt(u64.from(link.inFlightBytes()), 0u64, "nothing in flight");

  var held = List[IoBuf]();
  var i = 0usize;
  while i < 3usize {
    match link.take(4096usize) {
      case let Some(b) {
        expect(b.isEmpty(), "a buffer taken is empty");
        expect(b.capacity() >= 4096usize, "and has the room asked for");
        held.push(b);
      }
      case is None { expect(false, "the first three takes find room"); }
    }
    i = i + 1usize;
  }
  expectUInt(u64.from(link.inFlight()), 3u64, "three in flight");
  expectUInt(u64.from(link.inFlightBytes()), 12288u64, "which are 12 KiB");
  expectUInt(u64.from(link.peak()), 3u64, "the peak is three");
  expectUInt(link.stalls(), 0u64, "no stall yet");

  // A fourth take finds the window full: that is a stall, and the producer must wait
  expect(link.take(4096usize) is None, "the fourth take finds none");
  expect(link.take(1usize) is None, "and so does a fifth, however little it wants");
  expectUInt(link.stalls(), 2u64, "two stalls counted");
  expectUInt(u64.from(link.inFlight()), 3u64, "still three in flight");

  // One comes back, and its bytes leave the window
  match held.pop() {
    case let Some(b) {
      var full = b;
      full.append("hello");
      link.give(full);
    }
    case is None {}
  }
  expectUInt(u64.from(link.inFlight()), 2u64, "two in flight");
  expectUInt(u64.from(link.inFlightBytes()), 8192u64, "8 KiB");
  match link.take(4096usize) {
    case let Some(b) { expect(b.isEmpty(), "a buffer taken again is empty"); held.push(b); }
    case is None { expect(false, "there is room for one again"); }
  }
  expectUInt(u64.from(link.peak()), 3u64, "the peak does not pass three");
  expectUInt(u64.from(link.peakBytes()), 12288u64, "nor 12 KiB");

  // All come home
  while held.len() > 0usize {
    match held.pop() {
      case let Some(b) { link.give(b); }
      case is None {}
    }
  }
  expectUInt(u64.from(link.inFlight()), 0u64, "none in flight");
  expectUInt(u64.from(link.inFlightBytes()), 0u64, "no bytes in flight");
  expectUInt(u64.from(link.sharedPool().lent()), 0u64, "and the pool has them all back");

  // 2. sized to the data
  var sized = ChunkWindow.own(1048576usize);
  var small = take(&mut sized, 100usize);
  expectUInt(u64.from(small.capacity()), 4096u64, "100 bytes takes a 4 KiB block");
  expectUInt(u64.from(sized.inFlightBytes()), 4096u64, "and the window counts 4 KiB");
  var mid = take(&mut sized, 5000usize);
  expectUInt(u64.from(mid.capacity()), 16384u64, "5,000 bytes takes a 16 KiB block");
  var big = take(&mut sized, 70000usize);
  expectUInt(u64.from(big.capacity()), 262144u64, "70,000 bytes takes a 256 KiB block");
  expectUInt(u64.from(sized.inFlightBytes()), 4096u64 + 16384u64 + 262144u64, "the window counts the capacities");
  small.append("ab");
  expectUInt(u64.from(sized.inFlightBytes()), 4096u64 + 16384u64 + 262144u64, "not the bytes written");
  sized.give(small);
  sized.give(mid);
  sized.give(big);
  expectUInt(u64.from(sized.inFlightBytes()), 0u64, "all three given back");

  // 3. a window smaller than one chunk
  var narrow = ChunkWindow.own(4096usize);
  var first = take(&mut narrow, 65536usize);
  expectUInt(u64.from(first.capacity()), 65536u64, "a 64 KiB chunk is lent through a 4 KiB window, nothing being in flight");
  expect(narrow.take(100usize) is None, "but not a second");
  narrow.give(first);
  expect(narrow.take(100usize) is Some, "and when it is back, another");

  // 4. two links, one pool with a cap of 8 KiB
  let pool = ChunkPool.make(8192usize);
  var a = ChunkWindow.make(1048576usize, pool);
  var b = ChunkWindow.make(1048576usize, pool);
  var a1 = take(&mut a, 4096usize);
  var a2 = take(&mut a, 4096usize);
  expectUInt(u64.from(pool.lent()), 8192u64, "the pool has lent its cap");
  expect(a.take(4096usize) is None, "a link with buffers out is refused past the cap");
  expectUInt(pool.refused(), 1u64, "and the refusal counted");
  var b1 = take(&mut b, 4096usize);
  expectUInt(pool.floored(), 1u64, "a link with nothing in flight is still lent one, counted as floored");
  expect(b.take(4096usize) is None, "but only one");
  expectUInt(u64.from(pool.lent()), 12288u64, "the pool lent its cap and the one buffer");
  a.give(a1);
  expectUInt(u64.from(pool.lent()), 8192u64, "a give returns its bytes to the pool");
  expect(b.take(4096usize) is None, "and b is still held by the cap (8 KiB are lent) until more come back");
  a.give(a2);
  var b2 = take(&mut b, 4096usize);
  expectUInt(u64.from(pool.peak()), 12288u64, "the peak is the most lent at once");
  b.give(b1);
  b.give(b2);
  expectUInt(u64.from(pool.lent()), 0u64, "every byte is back");

  // 5. a link dropped with buffers out
  let shared = ChunkPool.make(1048576usize);
  {
    var gone = ChunkWindow.make(1048576usize, shared);
    var x = take(&mut gone, 4096usize);
    var y = take(&mut gone, 65536usize);
    expectUInt(u64.from(shared.lent()), 4096u64 + 65536u64, "two buffers out");
  }
  expectUInt(u64.from(shared.lent()), 0u64, "a link dropped with buffers out returns their bytes to the pool");
  done()
}
