// Bug 84: a three-stage pipeline cancelled at the sink with every window full.
//
//   source -> Ident -> Ident -> HashStage[Sha256] -> sink      (Ident passes bytes through)
//
// The sink HOLDS every chunk it is sent, so each stage's window (four buffers) fills in turn and
// each stage holds a cur and a backlog of the chunks behind it. The source never looks at its group
// and never ends. Main waits until the actors runtime is idle (the full state is reached), cancels
// the consumer's group, and the sink gives its chunks back in that group. The cancel has to travel
// the whole way up on the credit given back: every buffer must be back in its pool.

mod cancelthree;

import testing use *;
import collections use *;
import iobuf use IoBuf;
import actors;
import cancelgroups use *;
import streams use *;
import stages use *;
import cryptohash;

fn chunkBytes() usize { 4096usize }

struct Seen {
  pub sent: Atomic[u64];
  pub held: Atomic[u64];
  pub digestErr: Atomic[u64];
}

let seen: Seen;

fn @initpure init() {
  seen = Seen(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

// Passes its input through unchanged
struct Ident {
  pend: List[u8];
  fin: bool;

  pub fn make() Ident { Ident(List[u8](), false) }

  pub fn feed(self: &mut, input: &Array[u8]) {
    var i = 0usize;
    while i < input.len { pend.push(input[i]); i += 1usize; }
  }

  pub fn pull(self: &mut, out: &mut IoBuf) Status {
    let n = out.append(pend.view());
    if n < pend.len() {
      var rest = List[u8]();
      var i = n;
      while i < pend.len() { rest.push(pend[i]); i += 1usize; }
      pend = rest;
      return Status.MoreOutput;
    }
    pend.clear();
    if fin { Status.Done } else { Status.NeedInput }
  }

  pub fn finish(self: &mut) { fin = true; }

  pub fn failure(self: &) Option[AnyError] { None[AnyError] }
}

actor Source is ChunkSource {
  down: ChunkSink;
  link: ChunkWindow;
  data: List[u8];
  left: u64;

  pub fn init(self: &new, down: ChunkSink, data: List[u8], left: u64) {
    *self = Self(down: down, link: ChunkWindow.own(16384usize), data: data, left: left);
    down.attach(selfactor);
  }

  pub async fn start(self) { self.pump(); }

  pub async fn giveBack(self, b: IoBuf) {
    link.give(b);
    self.pump();
  }

  pub async fn stop(self, why: Ending) {}

  fn pump(self) {
    var more = true;
    while more {
      if left == 0u64 {
        more = false;
      } else {
        match link.take(chunkBytes()) {
          case is None { more = false; }
          case let Some(b) {
            var buf = b;
            buf.append(data.view());
            left = left - 1u64;
            seen.sent.add(1u64);
            down <- buf;
          }
        }
      }
    }
  }
}

// Holds every chunk until 'release', which gives them all back
actor Sink is ChunkSink {
  up: Option[ChunkSource];
  held: List[IoBuf];

  pub fn init(self: &new) {
    *self = Self(up: None[ChunkSource], held: List[IoBuf]());
  }

  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source);
  }

  pub async fn accept(self, c: IoBuf) {
    seen.held.add(1u64);
    held.push(c);
  }

  pub async fn end(self, how: Ending) {
    up = None[ChunkSource];
  }

  pub async fn release(self) {
    var more = true;
    while more {
      match held.pop() {
        case let Some(c) {
          match &up {
            case let &Some(u) { u.giveBack(c); }
            case is None {}
          }
        }
        case is None { more = false; }
      }
    }
  }
}

actor Checker is DigestSink[Array[u8, 32]] {
  tag: u64;

  pub fn init(self: &new) { *self = Self(tag: 0u64); }

  pub async fn digest(self, r: Result[Array[u8, 32], AnyError]) {
    match r {
      case is Err { seen.digestErr.add(1u64); }
      case is Ok {}
    }
  }
}

fn main() i32 {
  initAll();
  actors.configure(actors.Options(workers: 4u32));
  let base = iobuf.stats().lent;
  let gc = CancelGroup.make();
  let sink = Sink();
  {
    let gs = gc.child();
    let hash = HashStage[cryptohash.Sha256](sink, cryptohash.Sha256.make(), Checker());
    let stageB = TransformStage[Ident](hash, Ident.make());
    let stageA = TransformStage[Ident](stageB, Ident.make());
    var d = List[u8]();
    var i = 0usize;
    while i < chunkBytes() { d.push(97u8); i += 1usize; }
    let src = Source(stageA, d, 20u64);
    actors.withGroup(&gs, fn() [src] { src.start(); });
  }
  // the pipeline settles: the sink holds 4 chunks, stage B holds 4 more and stage A 4 more (12 in all)
  actors.waitUntilIdle();
  let heldBefore = seen.held.load();
  let sentFull = seen.sent.load();
  let lentFull = iobuf.stats().lent;
  gc.cancel();
  actors.withGroup(&gc, fn() [sink] { sink.release(); });
  actors.waitUntilIdle();
  let lentAfter = iobuf.stats().lent;
  finalAll();

  expectUInt(heldBefore, 4u64, "the sink holds 4 chunks: stage B's window is full");
  expectUInt(sentFull, 12u64, "the source stalled at 12 chunks: stage A's window is full too");
  expect(lentFull > base, "buffers are lent while the pipeline is full");
  expectUInt(seen.digestErr.load(), 1u64, "the hash stage answered its digest sink once, with an error");
  expectUInt(lentAfter, base, "every buffer is back before finalAll: the full Ident stage was told");
  expectUInt(iobuf.stats().lent, base, "and after it");
  done()
}
