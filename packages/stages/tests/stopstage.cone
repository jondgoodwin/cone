// The upstream stop (ChunkSource.stop), rule by rule, with a probe source that follows the rules
// and a sink that stops it:
//
//   0. a sink stops its source while chunks are in flight: the source ends the sink once, Failed with
//      the sink's reason, sends far fewer than all its chunks, and every buffer it lent comes back
//      (the window balances);
//   1. a second stop does nothing (the source ends the sink once);
//   2. a stop after the source's end does nothing, and the sink saw the one end, Finished;
//   3. the stop crosses stages: source -> Deflater -> Inflater -> HashStage -> sink, the sink stopping at
//      its 10th chunk: the source is stopped once and ends the first stage, which ends the rest once; the
//      digest sink gets one error; every buffer of the source comes back;
//   4. a stop and a cancel of the group together: the source is driven to one end, the sink sees one.

mod stopstage;

import testing use *;
import collections use *;
import iobuf use IoBuf;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import thread;
import time use Instant, Duration;
import actors;
import cancelgroups use *;
import streams use *;
import stages use *;
import deflate;
import cryptohash;

fn chunkBytes() usize { 65536usize }

struct Seen {
  pub sent: Atomic[u64];        // chunks the source sent
  pub back: Atomic[u64];        // buffers given back to the source
  pub srcStopped: Atomic[u64];  // stops the source acted on
  pub srcIgnored: Atomic[u64];  // stops it ignored (after its end, or a second)
  pub srcEnds: Atomic[u64];     // ends the source sent
  pub received: Atomic[u64];    // chunks the sink took
  pub failed: Atomic[u64];      // end(Failed) at the sink
  pub finished: Atomic[u64];    // end(Finished) at the sink
  pub reasonOk: Atomic[u64];    // Failed ends whose reason reads "enough"
  pub digestErr: Atomic[u64];
  pub digestOk: Atomic[u64];
}

fn newSeen() Seen {
  Seen(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64))
}

let s0: Seen;
let s1: Seen;
let s2: Seen;
let s3: Seen;
let s4: Seen;

fn @initpure init() {
  s0 = newSeen();
  s1 = newSeen();
  s2 = newSeen();
  s3 = newSeen();
  s4 = newSeen();
}

fn seenOf(slot: usize) &Seen {
  if slot == 0usize {&s0} else if slot == 1usize {&s1} else if slot == 2usize {&s2}
  else if slot == 3usize {&s3} else {&s4}
}

fn block() List[u8] {
  let w: Array[&str, 5] = ["alpha ", "beta ", "gamma ", "delta ", "epsilon "];
  var d = List[u8].withCapacity(chunkBytes() + 16usize);
  var s = 7u64;
  while d.len() < chunkBytes() {
    s = s * 6364136223846793005u64 + 1442695040888963407u64;
    let word = w[usize.from((s >> 40u64) % 5u64)];
    var i = 0usize;
    while i < word.len { d.push(word[i]); i += 1usize; }
  }
  d.truncate(chunkBytes());
  d
}

// Sends the same 64 KiB block 'left' times through a window of four buffers, and follows the stop
// rules: the first terminal event decides (its own end, a stop, or, when 'watches', a cancel of
// its group), it sends its one end carrying the stop's reason, and it credits every buffer given back
actor Source is ChunkSource {
  slot: usize;
  down: ChunkSink;
  link: ChunkWindow;
  data: List[u8];
  left: u64;
  over: bool;
  watches: bool;

  pub fn init(self: &new, slot: usize, down: ChunkSink, data: List[u8], left: u64, watches: bool) {
    *self = Self(slot: slot, down: down, link: ChunkWindow.own(262144usize), data: data, left: left, over: false,
      watches: watches);
    down.attach(selfactor);
  }

  pub async fn start(self) { self.pump(); }

  pub async fn giveBack(self, b: IoBuf) {
    link.give(b);
    seenOf(slot).back.add(1u64);
    self.cancelCheck();
    self.pump();
  }

  pub async fn stop(self, why: Ending) {
    self.cancelCheck();
    if over {
      seenOf(slot).srcIgnored.add(1u64);
      return;
    }
    seenOf(slot).srcStopped.add(1u64);
    self.endWith(why);
  }

  fn cancelCheck(self) {
    if watches && !over && actors.isCancelled() {
      self.endWith(Ending.Failed(AnyError.msg("cancelled")));
    }
  }

  fn endWith(self, how: Ending) {
    over = true;
    seenOf(slot).srcEnds.add(1u64);
    down.end(how);
  }

  fn pump(self) {
    var more = !over;
    while more {
      if left == 0u64 {
        self.endWith(Ending.Finished);
        more = false;
      } else {
        match link.take(chunkBytes()) {
          case is None { more = false; }
          case let Some(b) {
            var buf = b;
            buf.append(data.view());
            left = left - 1u64;
            seenOf(slot).sent.add(1u64);
            down <- buf;
          }
        }
      }
    }
  }
}

// Takes chunks and gives each back at once. At its 'stopAt'th it stops its source (twice if 'twice',
// after cancelling 'gc' if it has one). With 'afterEnd' it stops its source when the end arrives.
// It goes on giving back what still arrives
actor StopSink is ChunkSink {
  slot: usize;
  stopAt: u64;
  twice: bool;
  afterEnd: bool;
  gc: Option[CancelGroup];
  up: Option[ChunkSource];
  done: OneshotSender[u64];

  pub fn init(self: &new, slot: usize, stopAt: u64, twice: bool, afterEnd: bool, gc: Option[CancelGroup],
      done: OneshotSender[u64]) {
    *self = Self(slot: slot, stopAt: stopAt, twice: twice, afterEnd: afterEnd, gc: gc, up: None[ChunkSource],
      done: done);
  }

  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source);
  }

  pub async fn accept(self, c: IoBuf) {
    let s = seenOf(slot);
    let n = s.received.add(1u64) + 1u64;
    match &up {
      case let &Some(u) { u.giveBack(c); }
      case is None {}
    }
    if n == stopAt {
      match &gc {
        case let &Some(g) { g.cancel(); }
        case is None {}
      }
      self.stopUp();
      if twice { self.stopUp(); }
    }
  }

  fn stopUp(self) {
    match &up {
      case let &Some(u) { u.stop(Ending.Failed(AnyError.msg("enough"))); }
      case is None {}
    }
  }

  pub async fn end(self, how: Ending) {
    let s = seenOf(slot);
    match how {
      case is Finished { s.finished.add(1u64); }
      case let Failed(e) {
        s.failed.add(1u64);
        var text = String();
        {
          var w = text.textOut();
          e.report(&uni w);
        }
        if bytesEqual(text.view(), "enough") { s.reasonOk.add(1u64); }
      }
    }
    if afterEnd { self.stopUp(); }
    done.send(1u64);
  }
}

actor Checker is DigestSink[Array[u8, 32]] {
  slot: usize;

  pub fn init(self: &new, slot: usize) {
    *self = Self(slot: slot);
  }

  pub async fn digest(self, r: Result[Array[u8, 32], AnyError]) {
    let s = seenOf(slot);
    match r {
      case is Ok { s.digestOk.add(1u64); }
      case is Err { s.digestErr.add(1u64); }
    }
  }
}

fn waitFor(c: &Atomic[u64], n: u64) {
  let limit = Instant.now() + Duration.fromMillis(10000i64);
  while c.load() < n && Instant.now() < limit {thread.yieldNow();}
}

// Waits until every buffer the source sent has come back
fn waitBalanced(s: &Seen) {
  let limit = Instant.now() + Duration.fromMillis(10000i64);
  while s.back.load() < s.sent.load() && Instant.now() < limit {thread.yieldNow();}
}

fn main() i32 {
  initAll();
  actors.configure(actors.Options(workers: 4u32));
  var tx0: OneshotSender[u64];
  var rx0: OneshotReceiver[u64];
  tx0, rx0 = Oneshot[u64].make();
  var tx1: OneshotSender[u64];
  var rx1: OneshotReceiver[u64];
  tx1, rx1 = Oneshot[u64].make();
  var tx2: OneshotSender[u64];
  var rx2: OneshotReceiver[u64];
  tx2, rx2 = Oneshot[u64].make();
  var tx3: OneshotSender[u64];
  var rx3: OneshotReceiver[u64];
  tx3, rx3 = Oneshot[u64].make();
  var tx4: OneshotSender[u64];
  var rx4: OneshotReceiver[u64];
  tx4, rx4 = Oneshot[u64].make();

  let gc4 = CancelGroup.make();
  {
    // 0. a stop while chunks are in flight
    let sink0 = StopSink(0usize, 3u64, false, false, None[CancelGroup], tx0);
    let src0 = Source(0usize, sink0, block(), 40u64, false);
    // 1. a second stop
    let sink1 = StopSink(1usize, 3u64, true, false, None[CancelGroup], tx1);
    let src1 = Source(1usize, sink1, block(), 40u64, false);
    // 2. a stop after the end
    let sink2 = StopSink(2usize, 0u64, false, true, None[CancelGroup], tx2);
    let src2 = Source(2usize, sink2, block(), 5u64, false);
    // 3. across stages
    let sink3 = StopSink(3usize, 10u64, false, false, None[CancelGroup], tx3);
    let hash3 = HashStage[cryptohash.Sha256](sink3, cryptohash.Sha256.make(), Checker(3usize));
    let inf3 = TransformStage[deflate.Inflater](hash3, deflate.Inflater.make(deflate.Format.Zlib));
    let def3 = TransformStage[deflate.Deflater](inf3, deflate.Deflater.make(deflate.Format.Zlib, 1i32));
    let src3 = Source(3usize, def3, block(), 2000u64, false);
    // 4. a stop and a cancel of the source's group together
    let gs4 = gc4.child();
    let sink4 = StopSink(4usize, 3u64, false, false, Some[CancelGroup](gc4), tx4);
    let src4 = Source(4usize, sink4, block(), 40u64, true);

    src0.start();
    src1.start();
    src2.start();
    src3.start();
    actors.withGroup(&gs4, fn() [src4] { src4.start(); });
  }
  rx0.recv();
  rx1.recv();
  rx2.recv();
  rx3.recv();
  rx4.recv();
  waitFor(&s1.srcIgnored, 1u64);
  waitFor(&s2.srcIgnored, 1u64);
  waitBalanced(&s0);
  waitBalanced(&s1);
  waitBalanced(&s3);
  waitBalanced(&s4);
  finalAll();

  expect(s0.sent.load() < 40u64, "0: the source sent far fewer than all its chunks");
  expectUInt(s0.srcStopped.load(), 1u64, "0: the source acted on the stop once");
  expectUInt(s0.srcEnds.load(), 1u64, "0: and sent one end");
  expectUInt(s0.failed.load(), 1u64, "0: the sink saw one end, Failed");
  expectUInt(s0.finished.load(), 0u64, "0: and not Finished");
  expectUInt(s0.reasonOk.load(), 1u64, "0: carrying the sink's reason");
  expectUInt(s0.back.load(), s0.sent.load(), "0: every buffer lent came back, after the stop too");

  expectUInt(s1.srcStopped.load(), 1u64, "1: the source acted on the first stop");
  expectUInt(s1.srcIgnored.load(), 1u64, "1: and ignored the second");
  expectUInt(s1.srcEnds.load(), 1u64, "1: one end sent");
  expectUInt(s1.failed.load(), 1u64, "1: the sink saw one end, Failed");
  expectUInt(s1.back.load(), s1.sent.load(), "1: the window balances");

  expectUInt(s2.sent.load(), 5u64, "2: the source sent every chunk");
  expectUInt(s2.finished.load(), 1u64, "2: the sink saw one end, Finished");
  expectUInt(s2.failed.load(), 0u64, "2: and no failure");
  expectUInt(s2.srcStopped.load(), 0u64, "2: a stop after the end was not acted on");
  expectUInt(s2.srcIgnored.load(), 1u64, "2: it was ignored");
  expectUInt(s2.srcEnds.load(), 1u64, "2: the source sent its one end");

  expect(s3.received.load() >= 10u64, "3: the sink took its 10 chunks");
  expect(s3.sent.load() < 100u64, "3: the source, stopped through three stages, sent far fewer than 2,000");
  expectUInt(s3.srcStopped.load(), 1u64, "3: the stop reached the source once");
  expectUInt(s3.srcEnds.load(), 1u64, "3: and the source sent one end");
  expectUInt(s3.failed.load(), 1u64, "3: the sink saw one end, Failed");
  expectUInt(s3.finished.load(), 0u64, "3: and not Finished");
  expectUInt(s3.reasonOk.load(), 1u64, "3: with the sink's reason, passed through the stages");
  expectUInt(s3.digestErr.load(), 1u64, "3: the hash stage answered its digest sink once, with an error");
  expectUInt(s3.digestOk.load(), 0u64, "3: and not with a digest");
  expectUInt(s3.back.load(), s3.sent.load(), "3: every buffer the source lent came back through the stages");

  expect(s4.srcEnds.load() == 1u64, "4: a stop and a cancel together gave the source one end");
  expectUInt(s4.failed.load() + s4.finished.load(), 1u64, "4: and the sink one end");
  expectUInt(s4.back.load(), s4.sent.load(), "4: the window balances");

  expectUInt(iobuf.stats().lent, 0u64, "every buffer is back in its pool");
  done()
}
