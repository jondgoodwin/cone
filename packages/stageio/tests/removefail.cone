// FileSink with removeOnFailure (filestages.cone in src): a failure after the sink's open succeeded closes the
// file, removes it, and only then tells 'done'; a failure of the open itself, or before any open, touches
// nothing. Each case is a pipeline of its own, over a file of 300,000 bytes (four whole 64 KiB chunks and
// one of 37,856):
//
//   1. FileSource -> Tap -> FileSink(.., true), the consumer's group cancelled as the 2nd buffer is given
//      back (the sink has finished two chunks, so its open is long done): 'done' says Err, and the file,
//      which held two or three chunks a moment before, is gone;
//   2. the same with the option off (FileSink(.., false)): 'done' says Err and the partial file is left, as
//      it was before the option (two whole chunks, or three if the third was being written);
//   3. a stream that finishes, with the option: Ok(300000), the file is there and is the same bytes;
//   4. a file that is already there and read-only (the read-only attribute on Windows, mode 0444 elsewhere),
//      so that the open for writing is refused: 'done' says Err, and the file still holds its own bytes;
//      where the read-only file can be written all the same (a system's superuser), the case is skipped
//      and its checks pass;
//   5. a source that cannot open its file ends the stream Failed before any chunk, so the sink never
//      opens: a file already there is untouched;
//   6. a file whose folder is not there: 'done' says Err and no file is made.
//
// A write that fails after a good open is the same path as the cancel in case 1 (the sink's failure,
// rx.fail then report); only Linux has a device that fails writes (stageio's fullsink test).

mod removefail;

import testing use *;
import collections use *;
import iobuf use IoBuf;
import fs;
import path use Path;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import actors;
import cancelgroups use *;
import streams use *;
import stages use *;
import stageio use *;

fn corpus(n: usize) List[u8] {
  let w: Array[&str, 5] = ["alpha ", "beta ", "gamma ", "delta ", "epsilon "];
  var d = List[u8].withCapacity(n + 16usize);
  var s = 7u64;
  while d.len() < n {
    s = s * 6364136223846793005u64 + 1442695040888963407u64;
    let word = w[usize.from((s >> 40u64) % 5u64)];
    var i = 0usize;
    while i < word.len { d.push(word[i]); i += 1usize; }
  }
  d.truncate(n);
  d
}

// Passes chunks and credit through; cancels 'gc' as it passes the 'at'th buffer given back
actor Tap is ChunkSink, ChunkSource {
  down: ChunkSink;
  up: Option[ChunkSource];
  gc: CancelGroup;
  at: u64;
  n: u64;

  pub fn init(self: &new, down: ChunkSink, gc: CancelGroup, at: u64) {
    *self = Self(down: down, up: None[ChunkSource], gc: gc, at: at, n: 0u64);
    down.attach(selfactor);
  }

  pub async fn attach(self, source: ChunkSource) { up = Some[ChunkSource](source); }

  pub async fn accept(self, c: IoBuf) {
    down <- c;
  }

  pub async fn end(self, how: Ending) {
    down.end(how);
    up = None[ChunkSource];
  }

  pub async fn giveBack(self, b: IoBuf) {
    n = n + 1u64;
    if n == at { gc.cancel(); }
    match &up {
      case let &Some(u) { u.giveBack(b); }
      case is None { }
    }
  }

  // Nothing stops this source (the trait asks for the behaviour)
  pub async fn stop(self, why: Ending) {}
}

fn isOk(r: &Option[Result[u64, AnyError]]) bool {
  match r {
    case let &Some(x) {
      match x {
        case is Ok { true }
        case is Err { false }
      }
    }
    case is None { false }
  }
}

fn isErr(r: &Option[Result[u64, AnyError]]) bool {
  match r {
    case let &Some(x) {
      match x {
        case is Ok { false }
        case is Err { true }
      }
    }
    case is None { false }
  }
}

fn countOf(r: &Option[Result[u64, AnyError]]) u64 {
  match r {
    case let &Some(x) {
      match x {
        case let &Ok(n) { *n }
        case is Err { 0u64 }
      }
    }
    case is None { 0u64 }
  }
}

fn bytesOf(name: &str) List[u8] {
  var out = List[u8]();
  match fs.readBytes(&Path.from(name)) {
    case let Ok(c) {
      out.resize(c.len(), 0u8);
      _ = c.copyOut(0usize, out.viewMut());
    }
    case is Err {}
  }
  out
}

fn gone(name: &str) { _ = fs.removeFile(&Path.from(name)); }

fn mine(s: &str) List[u8] {
  var d = List[u8]();
  var i = 0usize;
  while i < s.len { d.push(s[i]); i += 1usize; }
  d
}

fn main() i32 {
  initAll();
  let data = corpus(300000usize);
  let keep = mine("keep me");
  match fs.writeFile(&Path.from("removefail_in.tmp"), data.view()) {
    case is Ok {}
    case is Err { return skip("cannot write the temporary file"); }
  }
  gone("removefail_out1.tmp");
  gone("removefail_out2.tmp");
  gone("removefail_out3.tmp");
  gone("removefail_out5.tmp");
  _ = fs.chmod(&Path.from("removefail_ro.tmp"), 0x1A4u32);
  gone("removefail_ro.tmp");

  // case 4's file: there already, and read-only if this system lets a file be
  var lockable = false;
  match fs.writeFile(&Path.from("removefail_ro.tmp"), keep.view()) {
    case is Ok {}
    case is Err { return skip("cannot write the temporary file"); }
  }
  if fs.chmod(&Path.from("removefail_ro.tmp"), 0x124u32) is Ok {
    // does the system refuse a write to it? (not a superuser's)
    lockable = fs.writeFile(&Path.from("removefail_ro.tmp"), mine("x").view()) is Err;
  }
  // case 5's file: there already
  match fs.writeFile(&Path.from("removefail_out5.tmp"), keep.view()) {
    case is Ok {}
    case is Err { return skip("cannot write the temporary file"); }
  }

  var tx1: OneshotSender[Result[u64, AnyError]];
  var rx1: OneshotReceiver[Result[u64, AnyError]];
  tx1, rx1 = Oneshot[Result[u64, AnyError]].make();
  var tx2: OneshotSender[Result[u64, AnyError]];
  var rx2: OneshotReceiver[Result[u64, AnyError]];
  tx2, rx2 = Oneshot[Result[u64, AnyError]].make();
  var tx3: OneshotSender[Result[u64, AnyError]];
  var rx3: OneshotReceiver[Result[u64, AnyError]];
  tx3, rx3 = Oneshot[Result[u64, AnyError]].make();
  var tx4: OneshotSender[Result[u64, AnyError]];
  var rx4: OneshotReceiver[Result[u64, AnyError]];
  tx4, rx4 = Oneshot[Result[u64, AnyError]].make();
  var tx5: OneshotSender[Result[u64, AnyError]];
  var rx5: OneshotReceiver[Result[u64, AnyError]];
  tx5, rx5 = Oneshot[Result[u64, AnyError]].make();
  var tx6: OneshotSender[Result[u64, AnyError]];
  var rx6: OneshotReceiver[Result[u64, AnyError]];
  tx6, rx6 = Oneshot[Result[u64, AnyError]].make();

  let gc1 = CancelGroup.make();
  let gc2 = CancelGroup.make();
  {
    // 1. cancelled after the open, option on
    let gs1 = gc1.child();
    let sink1 = FileSink(String.from("removefail_out1.tmp"), tx1, true);
    let tap1 = Tap(sink1, gc1, 2u64);
    let src1 = FileSource(tap1, String.from("removefail_in.tmp"));
    actors.withGroup(&gs1, fn() [src1] { src1.start(); });

    // 2. the same, option off
    let gs2 = gc2.child();
    let sink2 = FileSink(String.from("removefail_out2.tmp"), tx2, false);
    let tap2 = Tap(sink2, gc2, 2u64);
    let src2 = FileSource(tap2, String.from("removefail_in.tmp"));
    actors.withGroup(&gs2, fn() [src2] { src2.start(); });

    // 3. a stream that finishes, option on
    let sink3 = FileSink(String.from("removefail_out3.tmp"), tx3, true);
    let src3 = FileSource(sink3, String.from("removefail_in.tmp"));
    src3.start();

    // 4. an existing read-only file, option on
    let sink4 = FileSink(String.from("removefail_ro.tmp"), tx4, true);
    let src4 = FileSource(sink4, String.from("removefail_in.tmp"));
    if lockable { src4.start(); }

    // 5. a source that fails before any chunk, onto an existing file, option on
    let sink5 = FileSink(String.from("removefail_out5.tmp"), tx5, true);
    let src5 = FileSource(sink5, String.from("removefail_not_there.tmp"));
    src5.start();

    // 6. a folder that is not there, option on
    let sink6 = FileSink(String.from("removefail_no_such_folder/out.tmp"), tx6, true);
    let src6 = FileSource(sink6, String.from("removefail_in.tmp"));
    src6.start();
  }
  let r1 = rx1.recv();
  let r2 = rx2.recv();
  let r3 = rx3.recv();
  let r4 = if lockable { rx4.recv() } else { None[Result[u64, AnyError]] };
  let r5 = rx5.recv();
  let r6 = rx6.recv();
  finalAll();

  expect(isErr(&r1), "1: cancelled after the open, done says Err");
  expect(gc1.isCancelled(), "1: the group was cancelled");
  expect(!fs.exists(&Path.from("removefail_out1.tmp")), "1: and the partial file is gone");

  expect(isErr(&r2), "2: option off, cancelled after the open: done says Err");
  let part = bytesOf("removefail_out2.tmp");
  expect(part.len() == 131072usize || part.len() == 196608usize, "2: and the partial file is left, two whole chunks or three");
  expect(part.view() == &data.view()[0usize ..< part.len()], "2: the first chunks, in order");

  expect(isOk(&r3), "3: a stream that finishes, done says Ok");
  expectUInt(countOf(&r3), 300000u64, "3: with every byte");
  expect(bytesOf("removefail_out3.tmp").view() == data.view(), "3: and the file is the same bytes");

  if lockable {
    expect(isErr(&r4), "4: an open refused, done says Err");
    expect(bytesOf("removefail_ro.tmp").view() == keep.view(), "4: and the read-only file is untouched");
  } else {
    expect(true, "4: skipped, this system lets a read-only file be written");
    expect(true, "4: skipped");
  }

  expect(isErr(&r5), "5: a source that cannot open its file: done says Err");
  expect(bytesOf("removefail_out5.tmp").view() == keep.view(), "5: and the file that was there is untouched");

  expect(isErr(&r6), "6: a folder that is not there: done says Err");
  expect(!fs.exists(&Path.from("removefail_no_such_folder/out.tmp")), "6: and no file is made");

  expectUInt(iobuf.stats().lent, 0u64, "every buffer is back in its pool");
  _ = fs.chmod(&Path.from("removefail_ro.tmp"), 0x1A4u32);
  gone("removefail_ro.tmp");
  gone("removefail_in.tmp");
  gone("removefail_out2.tmp");
  gone("removefail_out3.tmp");
  gone("removefail_out5.tmp");
  done()
}
