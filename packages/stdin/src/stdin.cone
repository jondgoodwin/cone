// The stdin package: reading standard input, for a program with no actors (a tool, a filter, a script), as
// 'print' serves it for output. A program writes 'import stdin;' and calls 'stdin.readLine(...)', so nothing
// is folded into its namespace.
//
//   mod upper;
//   import stdio use *;
//   import collections use String;
//   import stdin;
//
//   fn main() i32 {
//     var line = String();
//     var going = true;
//     while going {
//       match stdin.readLine(&mut line) {
//         case let Ok(more) { if more { print <- line.view(), "\n"; } else { going = false; } }
//         case is Err { return 1i32; }
//       }
//     }
//     0i32
//   }
//
//   stdin.readLine(&mut line)   the next line into a String, without its '\n' or '\r\n';
//                               Ok(false) at the end of the input, nothing read
//   stdin.readAll()             everything that is left, as a String
//   stdin.readBytes(&mut buf)   up to buf.len bytes into an array: how many, 0 at the end
//
// 'readLine' and 'readAll' put the bytes they read into a String as they came: input that is not UTF-8 makes
// a String that is not, so a program that cannot trust its input reads with 'readBytes'. A last line with no
// '\n' is a line. A failure is the IoErrorKind of the system's error (ioerror's kinds, the same on every
// system), not iocore's IoError: iocore imports diag and diag imports stdio, and this package stays light. A
// read is of standard input's own handle: nothing in the C runtime's text mode touches it (no '\r' dropped, no
// 0x1A that ends the input), and on a Windows console the text arrives as UTF-8 whatever the console's code
// page.
//
// THESE CALLS BLOCK THE THREAD until input arrives or ends. An actor's behaviour must not call them: it would
// hold a worker while it waits (a read that reaches an actor program is another job, which is not built yet).
// They take no console lock, so a read that waits stops no printing. One buffer, in conestd, sits over the
// read, so what follows a line waits for the next call; do not mix these with C's own 'stdin' (libc.fread) in
// one program. Two threads that read take turns, and which line each gets is the order they came.
//
// This package is separate from stdio so that stdio imports nothing: only a program that reads input carries
// collections (String) and ioerror.

mod stdin;

import collections use String;
import ioerror use IoErrorKind, osKind;

// Up to n bytes of standard input into p, or an error number made negative; 'line' not 0 stops at the first
// '\n' (conestd's stdio.cone)
extern fn @c cone_stdinChunk(p: *u8, n: usize, line: i32) i64;

// The next line of standard input into 'line', replacing what it held, without its line end ('\n' or '\r\n').
// False, with 'line' empty, at the end of the input. A last line with no '\n' is a line.
pub fn readLine(line: &mut String) Result[bool, IoErrorKind] {
  line.clear();
  var tmp = Array[u8, 4096]() <- fill 0u8;
  let tp: *u8 = &[]tmp as *u8;
  var any = false;
  var ended = false;
  var going = true;
  while going {
    let got = cone_stdinChunk(tp, 4096usize, 1i32);
    if got < 0i64 { return Err[bool, IoErrorKind](osKind(u32.from(0i64 - got))); }
    if got == 0i64 { going = false; }
    else {
      any = true;
      let n = usize.from(got);
      line.appendBytes(mem.sliceFromParts(tp, n));
      if *(tp + (n - 1usize)) == 10u8 { ended = true; going = false; }
    }
  }
  if !any { return Ok[bool, IoErrorKind](false); }
  if ended {
    var keep = line.len() - 1usize;
    if keep > 0usize && line[keep - 1usize] == 13u8 { keep = keep - 1usize; }
    line.truncate(keep);
  }
  Ok[bool, IoErrorKind](true)
}

// All that is left of standard input, as a String (empty at the end of the input)
pub fn readAll() Result[String, IoErrorKind] {
  var out = String();
  var tmp = Array[u8, 65536]() <- fill 0u8;
  let tp: *u8 = &[]tmp as *u8;
  var going = true;
  while going {
    let got = cone_stdinChunk(tp, 65536usize, 0i32);
    if got < 0i64 { return Err[String, IoErrorKind](osKind(u32.from(0i64 - got))); }
    if got == 0i64 { going = false; }
    else { out.appendBytes(mem.sliceFromParts(tp, usize.from(got))); }
  }
  Ok[String, IoErrorKind](out)
}

// Up to buf.len bytes of standard input into 'buf', waiting for at least one: how many, 0 at the end of the
// input (and for an empty 'buf')
pub fn readBytes(buf: &mut Array[u8]) Result[usize, IoErrorKind] {
  let got = cone_stdinChunk(buf as *u8, buf.len, 0i32);
  if got < 0i64 { return Err[usize, IoErrorKind](osKind(u32.from(0i64 - got))); }
  Ok[usize, IoErrorKind](usize.from(got))
}
