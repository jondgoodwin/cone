// Text in, samples out: the Speaker over the real model (GPU). The same text, voice, speed and seed give the same
// samples; a faster speed is shorter; a blend and a British voice work; a long text is cut into pieces of at most 510
// phonemes; the samples go through audiomixer's WAV encoder and decoder to within 16-bit rounding. Nothing is played.
// Needs the converted model in C:/src/speech-models/kokoro and a GPU with Vulkan 1.3 and SDL3.dll; skipped without.

mod speaker;

import testing use *;
import stdio use *;
import libc;
import collections use List, String;
import fs;
import path use Path;
import gpu use *;
import audiomixer use Sound, encodeWav, decodeWav;
import texttospeech use *;

fn same(a: &List[f32], b: &List[f32]) bool {
  if a.len() != b.len() { return false; }
  var i = 0usize;
  while i < a.len() { if *a[i] != *b[i] { return false; } i = i + 1usize; }
  true
}

fn rms(a: &List[f32]) f64 {
  var s = 0.0;
  var i = 0usize;
  while i < a.len() { let v = f64.from(*a[i]); s = s + v * v; i = i + 1usize; }
  libc.sqrt(s / f64.from(a.len() + 1usize))
}

fn main() i32 {
  let dir = "C:/src/speech-models/kokoro";
  if !fs.exists(&Path.from("C:/src/speech-models/kokoro/kokoro-v1_0.safetensors")) {
    return skip("the converted Kokoro files are not in C:/src/speech-models/kokoro");
  }
  var instance = Instance.createHeadless("texttospeech speaker", false);
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  require(adapter.isValid(), "an adapter");
  var device = adapter.requestComputeDevice(&ComputeRequest(largeBuffers: true));
  require(device.isValid(), "a compute device");
  var speaker = match Speaker.open(&mut device, dir, false) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; require(false, "the speaker opens"); return done(); } };
  let heart = match Voice.load(dir, "af_heart") { case var Ok(v) { v } case let Err(m) { print <- m.message().view(), "\n"; require(false, "the voice loads"); return done(); } };
  let text = "Hello there. The weather today is sunny, with a light breeze from the west.";

  speaker.seed(7u64);
  let a = match speaker.speak(&mut device, text, &heart, 1.0) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; require(false, "speaking works"); return done(); } };
  speaker.seed(7u64);
  let b = match speaker.speak(&mut device, text, &heart, 1.0) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; require(false, "speaking works"); return done(); } };
  expect(a.len() > 24000usize * 3usize, "about five seconds of audio for two sentences");
  expect(a.len() < 24000usize * 9usize, "and not many more");
  expectBool(same(&a, &b), true, "the same text, voice, speed and seed give the same samples");
  expect(rms(&a) > 0.01, "the audio is not silence");
  expectUInt(u64.from(speaker.lastFallbackWords), 0u64, "no word needed the fallback");

  speaker.seed(7u64);
  let fast = match speaker.speak(&mut device, text, &heart, 1.5) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; return 1i32; } };
  expect(fast.len() < a.len() * 3usize / 4usize, "speed 1.5 is much shorter");
  speaker.seed(7u64);
  let slow = match speaker.speak(&mut device, text, &heart, 0.8) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; return 1i32; } };
  expect(slow.len() > a.len() * 23usize / 20usize, "speed 0.8 is longer");

  // a blend is not either voice
  let mixed = match Voice.load(dir, "af_heart:0.5,am_michael:0.5") { case var Ok(v) { v } case let Err(m) { print <- m.message().view(), "\n"; return 1i32; } };
  speaker.seed(7u64);
  let c = match speaker.speak(&mut device, text, &mixed, 1.0) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; return 1i32; } };
  expectBool(same(&a, &c), false, "a blend of two voices sounds unlike one of them");
  expect(rms(&c) > 0.01, "...and is not silence");

  // a long text is several pieces, each of at most 510 phonemes
  var long = String.empty();
  var k = 0usize;
  while k < 14usize { long <- "The old lighthouse stood at the edge of the cliff, and every evening the keeper climbed the long staircase. "; k = k + 1usize; }
  speaker.seed(7u64);
  let big = match speaker.speak(&mut device, long.view(), &heart, 1.0) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; return 1i32; } };
  expect(speaker.lastPhonemes.len() >= 3usize, "a long text is cut into several pieces");
  var longest = 0usize;
  var p = 0usize;
  while p < speaker.lastPhonemes.len() { let n = speaker.lastPhonemes[p].charCount(); if n > longest { longest = n; } p = p + 1usize; }
  expect(longest <= 510usize, "no piece has more than 510 phonemes");
  expect(big.len() > 24000usize * 60usize, "over a minute of audio");

  // the WAV encoder and decoder keep the samples to 16-bit rounding
  var copy = List[f32].withCapacity(a.len());
  var q = 0usize;
  while q < a.len() { copy.push(*a[q]); q = q + 1usize; }
  let sound = Sound(OUTPUT_RATE, 1u32, copy);
  let wav = encodeWav(&sound, false);
  match decodeWav(wav.bytes()) {
    case let Ok(back) {
      expectUInt(u64.from(back.samples.len()), u64.from(a.len()), "the WAV has all the samples");
      var worst = 0.0;
      var i = 0usize;
      while i < a.len() && i < back.samples.len() {
        let d = libc.fabs(f64.from(*a[i]) - f64.from(*back.samples[i]));
        if d > worst { worst = d; }
        i = i + 1usize;
      }
      expect(worst <= 1.0 / 16000.0, "the WAV's 16-bit samples are within rounding");
    }
    case is Err { expect(false, "the WAV decodes"); }
  }

  // a British voice and lexicon
  var british = match Speaker.open(&mut device, dir, true) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; return 1i32; } };
  let emma = match Voice.load(dir, "bf_emma") { case var Ok(v) { v } case let Err(m) { print <- m.message().view(), "\n"; return 1i32; } };
  let d = match british.speak(&mut device, "Hello there. The weather today is sunny.", &emma, 1.0) { case var Ok(s) { s } case let Err(m) { print <- m.message().view(), "\n"; return 1i32; } };
  expect(d.len() > 24000usize * 2usize && rms(&d) > 0.01, "a British voice speaks");
  done()
}
