// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import englishphonemes use *;
import safetensors use *;
import texttospeech use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- TextToSpeechError(String.from("texttospeech: no voice")), "texttospeech: no voice", "plain");
  says(String() <- TextToSpeechError.from(SafetensorsError(String.from("safetensors: not a safetensors file"))), "texttospeech: safetensors: not a safetensors file", "from safetensors");
  says(String() <- TextToSpeechError.from(PhonemesError(String.from("englishphonemes: cannot read x"))), "englishphonemes: cannot read x", "from phonemes");
  done()
}
