// Streams through the Connection, a client and a server in memory (as
// tests/handshake.cone; the client trusts the test root by
// tls.Verifier.roots). Checked:
// - many streams at once: 12 of the client's, 48 KB each, echoed by the
//   server, their data interleaved on the wire (every stream's first bytes
//   reach the server before any stream's end does) and each whole;
// - a stalled reader: the server never releases one stream's bytes, which
//   then holds exactly its stream window and no end, while two others on the
//   same connection go on to their ends, though the connection's window is
//   smaller than the three streams' bodies together (its credit comes back
//   as bytes arrive); released at last, the stalled stream ends too;
// - the credit budget: the server's windows are drawn from one. The client
//   opens the 100 streams the server allows and writes at once; the server
//   releases four and none of the other 96: what it holds unreleased stays
//   within the budget (the peak itself is not printed: it is the schedule's),
//   and a control with a budget as large as the old rule shows that rule's
//   peak over the first run's bound; a
//   stalled stream holds its floor, readers draw the spare to the stream
//   window's maximum, and a stopped reader gives its credit back;
// - a reset: the client resets a stream it has written on, the server hears
//   Reset with the code and resets its own half, after which neither end
//   holds the stream and the client may not write on it;
// - stop sending: the server asks the client to stop a stream mid-body (it
//   has read the stream's window and released none); the client hears
//   WriteStopped and may write no more on it, and the server hears the Reset
//   ngtcp2 sends for it, with the server's code; released, the stream goes
//   from both ends;
// - the stream limit: a server allowing 4 bidirectional streams; the
//   client's fifth is refused until streams close and MoreStreams comes;
// - the idle timeout: 31 s of silence ends both ends' connections, idle;
// - a close with a code: the server closes with an application code, and
//   the client hears it from the peer.

mod streams;

import stdio use *;
import fs;
import path use Path;
import collections use List, String;
import time use Instant, Duration;
import iobuf use IoBuf;
import tls;
import quic;

fn certs(name: &str) Path {
  var p = String.from("../../../../../tls/tests/certs/");
  p.append(name);
  Path.fromString(p)
}

fn readText(name: &str) String {
  let p = certs(name);
  match fs.readFile(&p) {
    case var Ok(r) {return r;}
    case let Err(e) {}
  }
  printStr("cannot read ");
  printStr(p.view());
  printStr("\n");
  String()
}

fn clientCtx() quic.Context {
  var cfg = quic.Config.make();
  cfg.verify = tls.Verifier.roots(readText("ca.pem").view());
  match quic.Context.client(cfg) {
    case var Ok(r) {return r;}
    case let Err(e) {
      print <- e;
      printStr("\n");
    }
  }
  panic("the client's context could not be made")
}

fn serverCtx(cfg: quic.Config) quic.Context {
  let cert = certs("server.pem");
  let key = certs("server.key");
  match quic.Context.server(cfg, &cert, &key) {
    case var Ok(r) {return r;}
    case let Err(e) {
      print <- e;
      printStr("\n");
    }
  }
  panic("the server's context could not be made")
}

fn clientAddr() quic.Addr {quic.Addr.v4(127u8, 0u8, 0u8, 1u8, 50000u16)}
fn serverAddr() quic.Addr {quic.Addr.v4(127u8, 0u8, 0u8, 1u8, 4433u16)}

// What one end read on a stream, and was told of it
struct In {
  id: i64;
  bytes: String;
  fin: bool;
  reset: bool;
  resetCode: u64;
  stopped: bool;            // WriteStopped came
  firstAt: u32;             // the number of Data events before its first
  got: u64;                 // bytes read on it
}

// One end's view: its streams, and its connection's events. 'echo': a
// server writes back what it reads on a bidirectional stream, and ends it
// when the peer's end comes; 'stall': a stream whose bytes are never
// released; 'resetBack': a stream reset by the peer is reset here too
struct Side {
  ins: List[In];
  dataEvents: u32;
  firstFinAt: u32;          // Data events before the first end of a stream, or 0
  handshake: bool;
  more: u32;
  closedSeen: bool;
  closedByPeer: bool;
  closedApp: bool;
  closedIdle: bool;
  closedCode: u64;
  echo: bool;
  stall: i64;
  resetBack: bool;
  sparse: bool;             // slow readers: only every 25th of the peer's bidirectional streams is released, nothing is kept, the most held is tracked
  peak: u64;                // sparse: the most bytes the connection held unreleased
  every: i64;               // sparse: every this-many-th stream is released (0: none is)

  fn make() Side {
    Side(ins: List[In](), dataEvents: 0u32, firstFinAt: 0u32, handshake: false, more: 0u32,
      closedSeen: false, closedByPeer: false, closedApp: false, closedIdle: false, closedCode: 0u64,
      echo: false, stall: -1i64, resetBack: false, sparse: false, peak: 0u64, every: 25i64)
  }

  // The index of a stream's record, made when it has none
  fn at(self: &mut, id: i64) usize {
    var k = 0usize;
    while k < ins.len() {
      if ins[k].id == id {return k;}
      k = k + 1usize;
    }
    ins.push(In(id, String(), false, false, 0u64, false, dataEvents, 0u64));
    ins.len() - 1usize
  }
}

fn drain(c: &mut quic.Connection, side: &mut Side) {
  while true {
    match c.pollEvent() {
      case is Nothing {return;}
      case is HandshakeDone {side.handshake = true;}
      case is VerifyNeeded {c.verifyNow();}
      case let PeerStream(p) {side.at(p.stream);}
      case let Data(d) {
        let k = side.at(d.stream);
        side.dataEvents = side.dataEvents + 1u32;
        let n = d.buf.len();
        let r = &mut side.ins[k];
        r.got = r.got + u64.from(n);
        if side.sparse {
          // What the connection holds unreleased now, this event's bytes in it
          var held = 0u64;
          var j = 0usize;
          while j < side.ins.len() {
            held = held + c.unreleased(side.ins[j].id);
            j = j + 1usize;
          }
          if held > side.peak {side.peak = held;}
        } else {
          r.bytes.appendBytes(d.buf.view());
        }
        if d.fin {
          r.fin = true;
          if side.firstFinAt == 0u32 {side.firstFinAt = side.dataEvents;}
        }
        if side.sparse {
          if side.every > 0i64 && (d.stream / 4i64) % side.every == 0i64 {c.release(d.stream, n);}
        } else if d.stream != side.stall {
          c.release(d.stream, n);
        }
        if side.echo && (d.stream & 2i64) == 0i64 {
          c.writeBytes(d.stream, d.buf.view());
          if d.fin {c.finish(d.stream);}
        }
      }
      case let Reset(x) {
        let k = side.at(x.stream);
        side.ins[k].reset = true;
        side.ins[k].resetCode = x.code;
        if side.resetBack {c.reset(x.stream, x.code);}
      }
      case let WriteStopped(x) {
        let k = side.at(x.stream);
        side.ins[k].stopped = true;
      }
      case let MoreStreams(m) {side.more = side.more + 1u32;}
      case let Closed(x) {
        side.closedSeen = true;
        side.closedByPeer = x.byPeer;
        side.closedApp = x.app;
        side.closedIdle = x.idle;
        side.closedCode = x.code;
      }
    }
  }
}

fn earliest(a: Option[Instant], b: Option[Instant]) Option[Instant] {
  match a {
    case let Some(x) {
      match b {
        case let Some(y) {return Some(if y < x {y} else {x});}
        case is None[Instant] {return Some(x);}
      }
    }
    case is None[Instant] {}
  }
  b
}

// Move every payload each end has for the other until neither has any and
// neither must wake within a second
fn pump(c: &mut quic.Connection, s: &mut quic.Connection, cs: &mut Side, ss: &mut Side, now: &mut Instant) {
  var rounds = 0u32;
  while rounds < 1000000u32 {
    rounds = rounds + 1u32;
    var moved = false;
    while true {
      let p = c.pollTransmit(*now);
      if p.len() == 0usize {break;}
      s.handleInput(p.view(), *now);
      moved = true;
    }
    drain(s, ss);
    while true {
      let p = s.pollTransmit(*now);
      if p.len() == 0usize {break;}
      c.handleInput(p.view(), *now);
      moved = true;
    }
    drain(c, cs);
    if moved {
      *now = *now + Duration.fromMillis(1i64);
      continue;
    }
    var t = *now;
    match earliest(c.wakeAt(), s.wakeAt()) {
      case let Some(w) {t = w;}
      case is None[Instant] {return;}
    }
    if t > *now + Duration.fromSeconds(1i64) {return;}
    *now = if t > *now {t} else {*now + Duration.fromMillis(1i64)};
  }
}

// A client and a server made from these contexts, their handshake done
fn connect(cctx: &quic.Context, sctx: &quic.Context, cs: &mut Side, ss: &mut Side, now: &mut Instant)
    (quic.Connection, quic.Connection) {
  var c = mustClient(cctx, *now);
  let first = c.pollTransmit(*now);
  var s = mustAccept(sctx, first.view(), *now);
  pump(&mut c, &mut s, cs, ss, now);
  if !cs.handshake || !ss.handshake {panic("the handshake did not finish");}
  (c, s)
}

fn mustClient(cctx: &quic.Context, now: Instant) quic.Connection {
  match quic.Connection.client(cctx, "localhost", &clientAddr(), &serverAddr(), now) {
    case var Ok(c) {return c;}
    case let Err(err) {
      print <- err;
      printStr("\n");
    }
  }
  panic("the client could not be made")
}

fn mustAccept(sctx: &quic.Context, first: &Array[u8], now: Instant) quic.Connection {
  match quic.Connection.accept(sctx, first, &serverAddr(), &clientAddr(), now) {
    case var Ok(s) {return s;}
    case let Err(e) {
      print <- e;
      printStr("\n");
    }
  }
  panic("the server could not accept the client's first packet")
}

fn openBidi(c: &mut quic.Connection) i64 {
  match c.openBidi() {
    case let Some(id) {return id;}
    case is None[i64] {}
  }
  -1i64
}

// A stream's body: n bytes of a pattern naming the stream, which shows a
// byte out of place
fn body(id: i64, n: usize) String {
  var s = String();
  var k = 0u32;
  while s.len() < n {
    s.append("s");
    s.appendInt(id);
    s.append(":");
    s.appendUInt(u64.from(k));
    s.append(" ");
    k = k + 1u32;
  }
  var out = String();
  out.appendBytes(&s.view()[0usize ..< n]);
  out
}

fn yesNo(b: bool) &str {if b {"yes"} else {"no"}}

fn line(what: &str, value: &str) {
  printStr(what);
  printStr(": ");
  printStr(value);
  printStr("\n");
}

fn lineU(what: &str, value: u64) {
  printStr(what);
  printStr(": ");
  printUInt(value);
  printStr("\n");
}

fn manyStreams(cctx: &quic.Context) {
  printStr("-- 12 streams at once, echoed\n");
  let sctx = serverCtx(quic.Config.make());
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  ss.echo = true;
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  var ids = List[i64]();
  var k = 0u32;
  while k < 12u32 {
    let id = openBidi(&mut c);
    ids.push(id);
    let b = body(id, 49152usize);
    c.writeBytes(id, b.view());
    c.finish(id);
    k = k + 1u32;
  }
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  var whole = 0u32;
  var echoed = 0u32;
  var early = 0u32;
  k = 0u32;
  while k < 12u32 {
    let id = *ids[usize.from(k)];
    let want = body(id, 49152usize);
    let si = ss.at(id);
    if ss.ins[si].bytes.view() == want.view() && ss.ins[si].fin {whole = whole + 1u32;}
    if ss.ins[si].firstAt < ss.firstFinAt {early = early + 1u32;}
    let ci = cs.at(id);
    if cs.ins[ci].bytes.view() == want.view() && cs.ins[ci].fin {echoed = echoed + 1u32;}
    k = k + 1u32;
  }
  lineU("streams the server read whole, with their ends", u64.from(whole));
  lineU("streams whose first bytes came before any stream's end", u64.from(early));
  lineU("streams the client read back whole", u64.from(echoed));
  lineU("streams either end still holds", u64.from(c.openStreams() + s.openStreams()));
}

fn stalledReader(cctx: &quic.Context) {
  printStr("-- a stalled reader beside two others\n");
  var cfg = quic.Config.make();
  cfg.streamWindow = 16384u64;
  cfg.connectionWindow = 24576u64;
  let sctx = serverCtx(cfg);
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  let a = openBidi(&mut c);
  let b = openBidi(&mut c);
  let d = openBidi(&mut c);
  ss.stall = a;
  let ba = body(a, 102400usize);
  let bb = body(b, 102400usize);
  let bd = body(d, 102400usize);
  c.writeBytes(a, ba.view());
  c.finish(a);
  c.writeBytes(b, bb.view());
  c.finish(b);
  c.writeBytes(d, bd.view());
  c.finish(d);
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  let ai = ss.at(a);
  let bi = ss.at(b);
  let di = ss.at(d);
  lineU("the stalled stream: bytes the server holds unreleased", s.unreleased(a));
  lineU("...bytes it read", u64.from(ss.ins[ai].bytes.len()));
  line("...its end", yesNo(ss.ins[ai].fin));
  lineU("...bytes the client still has queued on it", c.queued(a));
  line("the other two read whole, with their ends", yesNo(ss.ins[bi].bytes.view() == bb.view() &&
    ss.ins[bi].fin && ss.ins[di].bytes.view() == bd.view() && ss.ins[di].fin));
  s.release(a, usize.from(s.unreleased(a)));
  ss.stall = -1i64;
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  line("released, the stalled stream reads whole, with its end", yesNo(ss.ins[ai].bytes.view() == ba.view() &&
    ss.ins[ai].fin));
}

// The slow-reader bound. The client opens the 100 streams the server allows
// and writes 150000 bytes on each, at once (the buffer pool holds them all,
// and a control that sent a window each would fill it); the server releases the bytes of
// four (every 25th) and none of the 96 others. What the server holds
// unreleased, across all its streams, is sampled at every Data event; its
// most is 'peak'. With 'budget' the Config's creditBudget, the bound is the
// budget. The control is a budget of 2 x 116 x 256 KiB, whose floor is the
// whole stream window: every stream may hold its window, as before windows
// were drawn from a budget. Returns the peak
fn slowReaders(cctx: &quic.Context, what: &str, budget: u64) u64 {
  var cfg = quic.Config.make();
  cfg.creditBudget = budget;
  let sctx = serverCtx(cfg);
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  ss.sparse = true;
  let data = body(0i64, 150000usize);
  var opened = 0u32;
  var ids = List[i64]();
  while opened < 100u32 {
    let id = openBidi(&mut c);
    if id < 0i64 {break;}
    ids.push(id);
    c.writeBytes(id, data.view());
    c.finish(id);
    opened = opened + 1u32;
  }
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  printStr("-- ");
  printStr(what);
  printStr("\n");
  lineU("streams the client opened", u64.from(opened));
  lineU("the credit budget, which is the bound on bytes held unreleased", budget);
  line("the most the server held unreleased is within the bound", yesNo(ss.peak <= budget));
  var whole = 0u32;
  var k = 0usize;
  while k < ids.len() {
    let i = ss.at(ids[k]);
    if (ids[k] / 4i64) % 25i64 == 0i64 && ss.ins[i].got == 150000u64 && ss.ins[i].fin {whole = whole + 1u32;}
    k = k + 1usize;
  }
  lineU("slow-reader streams: the four that release read to their ends", u64.from(whole));
  ss.peak
}

// A new stream's first grant: raised from its floor (4519) to 16384 at once
// while the spare lasts; the spare is 524372 and each grant 11865, so the
// first 44 streams get one whole, the 45th the 2312 left, and from the 46th
// on a stream holds its floor. The server releases nothing, so each stream
// holds what its window lets the client send
fn firstGrants(cctx: &quic.Context) {
  printStr("-- a new stream's first grant\n");
  let sctx = serverCtx(quic.Config.make());
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  ss.sparse = true;
  ss.every = 0i64;
  let floor = 1048576u64 / 232u64;
  let data = body(0i64, 100000usize);
  var ids = List[i64]();
  var k = 0u32;
  while k < 50u32 {
    let id = openBidi(&mut c);
    ids.push(id);
    c.writeBytes(id, data.view());
    k = k + 1u32;
    if k == 1u32 {
      pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
      lineU("the first stream, opened with spare: its window", s.window(id));
      lineU("...and what the client could send at once, held unreleased", s.unreleased(id));
    }
  }
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  lineU("the 44th stream's window", s.window(ids[43usize]));
  lineU("the 45th's, the spare's last 2312 over its floor", s.window(ids[44usize]));
  lineU("the 46th's, the spare spent: its floor", s.window(ids[45usize]));
  lineU("...and what the client could send on it, held unreleased", s.unreleased(ids[45usize]));
  lineU("the 50th's", s.window(ids[49usize]));
  var drawn = 0u64;
  k = 0u32;
  while k < 50u32 {
    drawn = drawn + s.window(ids[usize.from(k)]) - floor;
    k = k + 1u32;
  }
  line("the grants together are the whole spare", yesNo(drawn == 1048576u64 - 116u64 * floor));
}

// One bulk stream alone on a connection draws its window to the maximum
fn bulkWindow(cctx: &quic.Context) {
  printStr("-- one bulk stream\n");
  let sctx = serverCtx(quic.Config.make());
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  ss.sparse = true;
  let id = openBidi(&mut c);
  c.writeBytes(id, body(0i64, 1000000usize).view());
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  lineU("the server's window on it, the stream window's maximum", s.window(id));
  line("the most the server held unreleased is within the window", yesNo(ss.peak <= 262144u64));
  line("it read the stream whole, but for the end (still open)", yesNo(ss.ins[ss.at(id)].got == 1000000u64));
}

// What a stream's window does: a stalled stream keeps its floor, one that
// keeps reading grows to the maximum from the budget, and the budget comes
// back when the readers' streams are over
fn windows(cctx: &quic.Context) {
  printStr("-- windows drawn from the budget\n");
  let sctx = serverCtx(quic.Config.make());
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  ss.sparse = true;
  ss.every = 5i64;
  let floor = 1048576u64 / 232u64;       // 4519
  let data = body(0i64, 300000usize);   // more than a window: a reader never has all of it at once
  // Streams 0, 5 and 10 (every 5th) are read; the other eight stall. All 11
  // are opened and written at once: each stalled stream is raised to its
  // first window, 16 KiB, and the readers draw the rest of the spare
  var ids = List[i64]();
  var k = 0u32;
  while k < 11u32 {
    let id = openBidi(&mut c);
    ids.push(id);
    c.writeBytes(id, data.view());
    k = k + 1u32;
  }
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  var stalledAtFirst = true;
  k = 0u32;
  while k < 11u32 {
    if k % 5u32 != 0u32 {
      let id = ids[usize.from(k)];
      if s.window(id) != 16384u64 || s.unreleased(id) != 16384u64 {stalledAtFirst = false;}
    }
    k = k + 1u32;
  }
  line("every stalled stream holds exactly its first window, 16384", yesNo(stalledAtFirst));
  let w0 = s.window(ids[0usize]);
  let w5 = s.window(ids[5usize]);
  let w10 = s.window(ids[10usize]);
  var wmax = w0;
  if w5 > wmax {wmax = w5;}
  if w10 > wmax {wmax = w10;}
  line("a reader's window grew past the first window, within the maximum", yesNo(wmax > 16384u64 && wmax <= 262144u64));
  // The eleven windows less their floors: the spare (the budget less 116 floors)
  var drawn = 0u64;
  k = 0u32;
  while k < 11u32 {
    drawn = drawn + s.window(ids[usize.from(k)]) - floor;
    k = k + 1u32;
  }
  lineU("the streams drew from the spare, in all", drawn);
  line("...which is the whole spare", yesNo(drawn == 1048576u64 - 116u64 * floor));
  // Two readers are stopped by the server: all they hold above the floor
  // goes back to the spare, for a reader that comes later
  s.stopSending(ids[5usize], 0x10Bu64);
  s.stopSending(ids[10usize], 0x10Bu64);
  line("a reader stopped keeps its floor and no more", yesNo(s.window(ids[5usize]) == floor && s.window(ids[10usize]) == floor));
  while k < 16u32 {
    let id = openBidi(&mut c);
    ids.push(id);
    c.writeBytes(id, data.view());
    k = k + 1u32;
  }
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  line("the fourth reader, later, draws what they gave back", yesNo(s.window(ids[15usize]) > 16384u64));
  var held = 0u64;
  k = 0u32;
  while k < 16u32 {
    held = held + s.unreleased(ids[usize.from(k)]);
    k = k + 1u32;
  }
  line("all held unreleased is within the budget", yesNo(held <= 1048576u64));
}

fn resets(cctx: &quic.Context) {
  printStr("-- a reset, and stop sending\n");
  let sctx = serverCtx(quic.Config.make());
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  ss.resetBack = true;
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  // The client resets a stream it wrote on
  let r = openBidi(&mut c);
  c.writeBytes(r, body(r, 10000usize).view());
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  let ri = ss.at(r);
  lineU("the server read before the reset", u64.from(ss.ins[ri].bytes.len()));
  line("the client resets it", yesNo(c.reset(r, 0x10Cu64)));
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  line("the server heard Reset", yesNo(ss.ins[ri].reset));
  lineU("...with the code", ss.ins[ri].resetCode);
  line("...and no end", yesNo(!ss.ins[ri].fin));
  let rc = cs.at(r);
  line("the client heard the server's Reset back", yesNo(cs.ins[rc].reset));
  line("the client may still write on it", yesNo(c.writeBytes(r, "more")));
  lineU("streams either end still holds", u64.from(c.openStreams() + s.openStreams()));

  // The server asks the client to stop, mid-body
  let t = openBidi(&mut c);
  let ti = ss.at(t);
  ss.stall = t;
  c.writeBytes(t, body(t, 400000usize).view());
  c.finish(t);
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  lineU("the server read of a 400000-byte body, unreleased (its first window)", u64.from(ss.ins[ti].bytes.len()));
  line("the server asks the client to stop", yesNo(s.stopSending(t, 0x10Bu64)));
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  let tc = cs.at(t);
  line("the client heard WriteStopped", yesNo(cs.ins[tc].stopped));
  line("...and may not write on it", yesNo(!c.writeBytes(t, "more")));
  line("the server heard the Reset ngtcp2 sent for it", yesNo(ss.ins[ti].reset));
  lineU("...with the code", ss.ins[ti].resetCode);
  line("...and no end", yesNo(!ss.ins[ti].fin));
  lineU("the server releases what it read; streams the server still holds",
    u64.from(releaseAll(&mut s, &ss)));
}

// Release every stream's unreleased bytes: how many streams the connection
// holds after
fn releaseAll(c: &mut quic.Connection, side: &Side) usize {
  var k = 0usize;
  while k < side.ins.len() {
    let id = side.ins[k].id;
    c.release(id, usize.from(c.unreleased(id)));
    k = k + 1usize;
  }
  c.openStreams()
}

fn streamLimit(cctx: &quic.Context) {
  printStr("-- the stream limit\n");
  var cfg = quic.Config.make();
  cfg.maxStreamsBidi = 4u64;
  let sctx = serverCtx(cfg);
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  ss.echo = true;
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  var opened = 0u32;
  var k = 0u32;
  while k < 4u32 {
    let id = openBidi(&mut c);
    if id >= 0i64 {
      opened = opened + 1u32;
      c.writeBytes(id, "x");
      c.finish(id);
    }
    k = k + 1u32;
  }
  lineU("streams opened of the 4 allowed", u64.from(opened));
  line("a fifth is refused", yesNo(openBidi(&mut c) < 0i64));
  let before = cs.more;
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  line("once they closed, MoreStreams came", yesNo(cs.more > before));
  line("...and a fifth opens", yesNo(openBidi(&mut c) >= 0i64));
}

fn idleAndClose(cctx: &quic.Context) {
  printStr("-- the idle timeout\n");
  let sctx = serverCtx(quic.Config.make());
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  now = now + Duration.fromSeconds(31i64);
  let cp = c.pollTransmit(now);
  let sp = s.pollTransmit(now);
  drain(&mut c, &mut cs);
  drain(&mut s, &mut ss);
  line("the client's connection ended, idle", yesNo(c.isClosed() && cs.closedSeen && cs.closedIdle));
  line("the server's connection ended, idle", yesNo(s.isClosed() && ss.closedSeen && ss.closedIdle));
  line("neither sent anything", yesNo(cp.len() == 0usize && sp.len() == 0usize));

  printStr("-- the server closes with a code\n");
  var now2 = Instant.fromNanos(1000000000i64);
  var cs2 = Side.make();
  var ss2 = Side.make();
  var c2, s2 = connect(cctx, &sctx, &mut cs2, &mut ss2, &mut now2);
  s2.close(0x101u64);
  pump(&mut c2, &mut s2, &mut cs2, &mut ss2, &mut now2);
  line("the server's connection ended, by itself", yesNo(s2.isClosed() && ss2.closedSeen && !ss2.closedByPeer));
  line("the client heard it from the peer", yesNo(c2.isClosed() && cs2.closedSeen && cs2.closedByPeer));
  line("...an application's code", yesNo(cs2.closedApp));
  lineU("...which is", cs2.closedCode);
  line("the client may not open a stream after", yesNo(openBidi(&mut c2) < 0i64));
}

fn main() {
  let cctx = clientCtx();
  manyStreams(&cctx);
  stalledReader(&cctx);
  let bound = quic.defaultCreditBudget;
  let peak = slowReaders(&cctx, "slow readers: 100 streams, four released, 96 not", bound);
  let old = slowReaders(&cctx, "the control: a budget so large that every stream's floor is its full window, as before", 60817408u64);
  line("the control exceeds the bound the first run held to", yesNo(old > bound && peak <= bound));
  firstGrants(&cctx);
  bulkWindow(&cctx);
  windows(&cctx);
  resets(&cctx);
  streamLimit(&cctx);
  idleAndClose(&cctx);
  tinyPieces(&cctx);
}

// Tiny pieces on two streams, a packet each (a harvest each), the server not
// polling until all are in: the Data events join across harvests, a few
// events and a few blocks, not one each; the bytes are each stream's, in order
fn tinyPieces(cctx: &quic.Context) {
  printStr("-- tiny pieces across harvests\n");
  let sctx = serverCtx(quic.Config.make());
  var now = Instant.fromNanos(1000000000i64);
  var cs = Side.make();
  var ss = Side.make();
  var c, s = connect(cctx, &sctx, &mut cs, &mut ss, &mut now);
  let a = openBidi(&mut c);
  let b = openBidi(&mut c);
  var wantA = String();
  var wantB = String();
  var k = 0u32;
  while k < 600u32 {
    var t = String();
    t.appendUInt(u64.from(k));
    t.append(".");
    if k % 2u32 == 0u32 || k % 7u32 == 0u32 {
      c.writeBytes(a, t.view());
      wantA.append(t.view());
    } else {
      c.writeBytes(b, t.view());
      wantB.append(t.view());
    }
    while true {
      let p = c.pollTransmit(now);
      if p.len() == 0usize {break;}
      s.handleInput(p.view(), now);
    }
    now = now + Duration.fromMillis(1i64);
    k = k + 1u32;
  }
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  let ai = ss.at(a);
  let bi = ss.at(b);
  line("the server read each stream's bytes, in order", yesNo(ss.ins[ai].bytes.view() == wantA.view() &&
    ss.ins[bi].bytes.view() == wantB.view()));
  line("...in at most eight Data events, not one per piece", yesNo(ss.dataEvents <= 8u32));
}
