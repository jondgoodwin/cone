// A client and a server Connection in one process, in memory: each UDP
// payload one sends is handed to the other by hand, with no socket, no
// network and no clock (the test moves the time, a millisecond a round, and
// to the next wake time when nothing moves). The certificates are tls's test
// certificates (packages/tls/tests/certs, README there): the server's for
// 'localhost', under the test root, which the client is given as its roots
// (tls.Verifier.roots). Checked: the handshake (TLS 1.3, ALPN h3 both ways,
// the roots verifier), a bidirectional stream carrying a request and a 300 KB
// body that the server echoes back (larger than the stream's window, so it
// moves only as each side releases what it read), a unidirectional stream
// from the server, the connection closed by the client with an application
// code that the server receives, and two refusals: a certificate for another
// name, and no ALPN protocol in common.

mod handshake;

import stdio use *;
import fs;
import path use Path;
import collections use List, String;
import time use Instant, Duration;
import iobuf use IoBuf;
import tls;
import quic;

// A file of tls's test certificates: congo test runs a test in
// build/<mode>/tests/<name>/, four folders below this package's, which sits
// beside tls's
fn certs(name: &str) Path {
  var p = String.from("../../../../../tls/tests/certs/");
  p.append(name);
  Path.fromString(p)
}

fn readText(name: &str) String {
  let p = certs(name);
  match fs.readFile(&p) {
    case var Ok(r) {return r;}
    case let Err(e) {}
  }
  printStr("cannot read ");
  printStr(p.view());
  printStr("\n");
  String.empty()
}

fn clientCtx() quic.Context {
  var cfg = quic.Config.make();
  cfg.verify = tls.Verifier.roots(readText("ca.pem").view());
  match quic.Context.client(cfg) {
    case var Ok(r) {return r;}
    case let Err(e) {
      printStr(e.message().view());
      printStr("\n");
    }
  }
  panic("the client's context could not be made")
}

fn serverCtx(alpn: &str) quic.Context {
  var cfg = quic.Config.make();
  cfg.alpn = String.from(alpn);
  let cert = certs("server.pem");
  let key = certs("server.key");
  match quic.Context.server(cfg, &cert, &key) {
    case var Ok(r) {return r;}
    case let Err(e) {
      printStr(e.message().view());
      printStr("\n");
    }
  }
  panic("the server's context could not be made")
}

fn clientAddr() quic.Addr {quic.Addr.v4(127u8, 0u8, 0u8, 1u8, 50000u16)}
fn serverAddr() quic.Addr {quic.Addr.v4(127u8, 0u8, 0u8, 1u8, 4433u16)}

// One side's view of the connection: what it read on each kind of stream,
// and what it was told
struct Side {
  handshake: bool;
  closedSeen: bool;
  closedByPeer: bool;
  closedApp: bool;
  closedCode: u64;
  bidiIn: String;           // bytes read on the bidirectional stream
  bidiFin: bool;
  uniIn: String;            // ... on the peer's unidirectional stream
  uniFin: bool;
  peerStreams: u32;

  fn make() Side {
    Side(false, false, false, false, 0u64, String.empty(), false, String.empty(), false, 0u32)
  }
}

// Take every event a Connection has. A server echoes what it reads on a
// bidirectional stream back on it, as it reads it, and ends it when the
// client's end comes. Every byte read is released at once
fn drain(c: &mut quic.Connection, side: &mut Side) {
  while true {
    match c.pollEvent() {
      case is Nothing {return;}
      case is HandshakeDone {side.handshake = true;}
      case is VerifyNeeded {c.verifyNow();}
      case let PeerStream(p) {side.peerStreams = side.peerStreams + 1u32;}
      case let Data(d) {
        let stream = d.stream;
        let fin = d.fin;
        let n = d.buf.len();
        c.release(stream, n);
        if (stream & 2i64) != 0i64 {
          side.uniIn.appendBytes(d.buf.view());
          if fin {side.uniFin = true;}
        } else {
          side.bidiIn.appendBytes(d.buf.view());
          if fin {side.bidiFin = true;}
          if c.isServer() {
            c.writeBytes(stream, d.buf.view());
            if fin {c.finish(stream);}
          }
        }
      }
      case let Reset(r) {}
      case let WriteStopped(w) {}
      case let MoreStreams(m) {}
      case let Closed(x) {
        side.closedSeen = true;
        side.closedByPeer = x.byPeer;
        side.closedApp = x.app;
        side.closedCode = x.code;
      }
    }
  }
}

// The earlier of two wake times
fn earliest(a: Option[Instant], b: Option[Instant]) Option[Instant] {
  match a {
    case let Some(x) {
      match b {
        case let Some(y) {return Some(if y < x {y} else {x});}
        case is None[Instant] {return Some(x);}
      }
    }
    case is None[Instant] {}
  }
  b
}

// Move every payload each side has for the other until neither has any and
// neither must wake within a second; the events of each side taken as they
// come
fn pump(c: &mut quic.Connection, s: &mut quic.Connection, cs: &mut Side, ss: &mut Side, now: &mut Instant) {
  var rounds = 0u32;
  while rounds < 100000u32 {
    rounds = rounds + 1u32;
    var moved = false;
    while true {
      let p = c.pollTransmit(*now);
      if p.len() == 0usize {break;}
      s.handleInput(p.view(), *now);
      moved = true;
    }
    drain(s, ss);
    while true {
      let p = s.pollTransmit(*now);
      if p.len() == 0usize {break;}
      c.handleInput(p.view(), *now);
      moved = true;
    }
    drain(c, cs);
    if moved {
      *now = *now + Duration.fromMillis(1i64);
      continue;
    }
    var next: Option[Instant] = earliest(c.wakeAt(), s.wakeAt());
    var t = *now;
    match next {
      case let Some(w) {t = w;}
      case is None[Instant] {return;}
    }
    if t > *now + Duration.fromSeconds(1i64) {return;}
    *now = if t > *now {t} else {*now + Duration.fromMillis(1i64)};
  }
}

// A client, its first packet, and the server it makes
fn connect(cctx: &quic.Context, sctx: &quic.Context, host: &str, now: Instant) (quic.Connection, quic.Connection) {
  var c = mustClient(cctx, host, now);
  let first = c.pollTransmit(now);
  printStr("client's first packet: ");
  printStr(if first.len() >= 1200usize {"padded to at least 1200 bytes"} else {"too short"});
  printStr("\n");
  match quic.Connection.accept(sctx, first.view(), &serverAddr(), &clientAddr(), now) {
    case var Ok(s) {return (c, s);}
    case let Err(e) {
      printStr(e.message().view());
      printStr("\n");
    }
  }
  panic("the server could not accept the client's first packet")
}

fn mustClient(cctx: &quic.Context, host: &str, now: Instant) quic.Connection {
  match quic.Connection.client(cctx, host, &clientAddr(), &serverAddr(), now) {
    case var Ok(c) {return c;}
    case let Err(err) {
      printStr(err.message().view());
      printStr("\n");
    }
  }
  panic("the client could not be made")
}

fn yesNo(b: bool) &str {if b {"yes"} else {"no"}}

// A transport close code; a TLS alert's is CRYPTO_ERROR, 0x100 + the alert
fn closeCode(code: u64) {
  lineU("...the transport code", code);
  if code >= 256u64 && code < 512u64 {lineU("...which is TLS alert", code - 256u64);}
}

fn line(what: &str, value: &str) {
  printStr(what);
  printStr(": ");
  printStr(value);
  printStr("\n");
}

fn lineU(what: &str, value: u64) {
  printStr(what);
  printStr(": ");
  printUInt(value);
  printStr("\n");
}

// The body: 300 KB of a pattern that shows a byte out of place
fn body() String {
  var s = String.from("GET /hello over quic\n");
  var k = 0u32;
  while s.len() < 300000usize {
    s.appendUInt(u64.from(k));
    s.append(" ");
    k = k + 1u32;
  }
  s
}

fn exchange() {
  printStr("-- a handshake and a stream each way\n");
  let cctx = clientCtx();
  let sctx = serverCtx("h3");
  var now = Instant.fromNanos(1000000000i64);
  var c, s = connect(&cctx, &sctx, "localhost", now);
  var cs = Side.make();
  var ss = Side.make();
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  line("client handshake done", yesNo(cs.handshake && c.handshakeDone()));
  line("server handshake done", yesNo(ss.handshake && s.handshakeDone()));
  line("client ALPN", c.alpn().view());
  line("server ALPN", s.alpn().view());
  line("TLS", c.tlsVersion());
  line("verified by", tls.verifyKindName(c.verifiedBy()));

  // The client's request and body, on a stream of its own
  let sent = body();
  var stream = -1i64;
  match c.openBidi() {
    case let Some(id) {stream = id;}
    case is None[i64] {}
  }
  lineU("client's stream", u64.from(stream as u64));
  c.writeBytes(stream, sent.view());
  c.finish(stream);
  // The server's unidirectional stream
  match s.openUni() {
    case let Some(id) {
      lineU("server's unidirectional stream", u64.from(id as u64));
      s.writeBytes(id, "pushed by the server");
      s.finish(id);
    }
    case is None[i64] {}
  }
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  lineU("server read", u64.from(ss.bidiIn.len()));
  line("server read it all, and its end", yesNo(ss.bidiIn.view() == sent.view() && ss.bidiFin));
  lineU("client read back", u64.from(cs.bidiIn.len()));
  line("the echo is the body, and ends", yesNo(cs.bidiIn.view() == sent.view() && cs.bidiFin));
  line("client read on the server's stream", cs.uniIn.view());
  line("...and its end", yesNo(cs.uniFin));
  lineU("streams the server saw opened", u64.from(ss.peerStreams));
  lineU("streams the client saw opened", u64.from(cs.peerStreams));
  lineU("streams the client still holds", u64.from(c.openStreams()));
  lineU("streams the server still holds", u64.from(s.openStreams()));

  // The client closes with an application code
  c.close(0x10Cu64);
  let p = c.pollTransmit(now);
  s.handleInput(p.view(), now);
  drain(&mut c, &mut cs);
  drain(&mut s, &mut ss);
  line("client closed", yesNo(c.isClosed() && cs.closedSeen && !cs.closedByPeer));
  line("server saw the peer close", yesNo(s.isClosed() && ss.closedSeen && ss.closedByPeer));
  line("...with an application code", yesNo(ss.closedApp));
  lineU("...which is", ss.closedCode);
  match c.wakeAt() {
    case let Some(t) {line("a wake time after the close", "yes");}
    case is None[Instant] {line("a wake time after the close", "no");}
  }
}

fn refused(what: &str, host: &str, serverAlpn: &str) {
  printStr("-- ");
  printStr(what);
  printStr("\n");
  let cctx = clientCtx();
  let sctx = serverCtx(serverAlpn);
  var now = Instant.fromNanos(1000000000i64);
  var c, s = connect(&cctx, &sctx, host, now);
  var cs = Side.make();
  var ss = Side.make();
  pump(&mut c, &mut s, &mut cs, &mut ss, &mut now);
  line("client handshake done", yesNo(cs.handshake));
  line("client closed", yesNo(c.isClosed()));
  line("server closed", yesNo(s.isClosed()));
  match c.error() {
    case let Some(e) {line("client's error", e.message().view());}
    case is None[quic.QuicError] {line("client's error", "none");}
  }
  match s.error() {
    case let Some(e) {line("server's error", e.message().view());}
    case is None[quic.QuicError] {line("server's error", "none");}
  }
  // Closed's code: the one the end that closed sent
  line("server's Closed came", yesNo(ss.closedSeen));
  line("...closed by the peer", yesNo(ss.closedByPeer));
  line("...with an application code", yesNo(ss.closedApp));
  closeCode(ss.closedCode);
  line("client's Closed came", yesNo(cs.closedSeen));
  line("...closed by the peer", yesNo(cs.closedByPeer));
  closeCode(cs.closedCode);
}

fn main() {
  line("ngtcp2", quic.ngtcp2Version());
  exchange();
  refused("a certificate for another name", "example.com", "h3");
  refused("no ALPN protocol in common", "localhost", "hq-interop");
}
