// The quic package: QUIC version 1 (RFC 9000) over ngtcp2, sans-IO, in the
// shape of the http1, http2 and http3 cores: a connection's state as plain
// data, which does no I/O, reads no clock and starts no thread (invariant
// I13). Its owner hands it the UDP payloads that came off the wire and the
// time, and takes back the payloads to send, what happened on the
// connection, and when to wake it. It presents QUIC as RFC 9114 sees it:
// numbered bidirectional and unidirectional streams of bytes that end or are
// reset, and a connection that closes with a code. TLS 1.3 is OpenSSL 3.5's,
// the library package tls uses, through ngtcp2's OpenSSL crypto helper
// (OpenSSL's own QUIC TLS interface); a server's certificate is checked by
// tls's verifiers.
//
//   mod fetch;
//   import quic;
//   import time use Instant;
//
//   let ctx = quic.Context.client(quic.Config.make())...;     // ALPN h3, the OS's verifier
//   var c = quic.Connection.client(&ctx, "example.com", &here, &there, now)...;
//   while !c.isClosed() {                          // the driver's loop:
//     send(c.pollTransmit(now));                   // payloads to send, until empty
//     c.handleInput(received.view(), now);         // a payload that came
//     match c.pollEvent() {                        // what that means, until Nothing
//       case is VerifyNeeded {... submit c.verifyOp() ... c.verifyDone(&mut completion) ...}
//       case is HandshakeDone { let s = c.openBidi()...; c.writeBytes(s, request); c.finish(s); }
//       case let Data(d) {... d.buf ... d.fin ...; c.release(d.stream, n); }   // credit back
//       case let Closed(x) {... x.code ...}
//       ...
//     }
//     wake at c.wakeAt(), and call c.pollTransmit(now) then, input or none
//   }
//
//   Config.make(): the defaults, each a field to change                 (CONFIG)
//   defaultStreamWindow defaultConnectionWindow defaultMaxStreamsBidi
//   defaultMaxStreamsUni defaultIdleSeconds defaultMaxUdpPayload
//   Context.client(cfg)  Context.server(cfg, certFile, keyFile)            (CONTEXTS)
//   ctx.isServer()  ctx.config()
//   Addr.v4(a, b, c, d, port)
//   Connection.client(ctx, host, localAddr, remoteAddr, now)                (CONNECTIONS)
//   Connection.accept(ctx, firstPacket, localAddr, remoteAddr, now)
//   c.handleInput(packet, now)  c.pollTransmit(now)  c.wakeAt()  c.pollEvent()
//   c.openBidi()  c.openUni()  c.write(stream, buf)  c.writeBytes(stream, bytes)  (STREAMS)
//   c.finish(stream)  c.reset(stream, code)  c.stopSending(stream, code)
//   c.release(stream, n)  c.unreleased(stream)  c.queued(stream)  c.openStreams()  (CREDIT)
//   c.close(code)  c.isClosed()                                              (CLOSING)
//   c.wantsVerify()  c.verifyOp()  c.verifyDone(completion)  c.verifyNow()   (CERTIFICATES)
//   Event: Nothing HandshakeDone VerifyNeeded PeerStream Data Reset          (EVENTS)
//     WriteStopped MoreStreams Closed
//   c.isServer()  c.handshakeDone()  c.error()  c.alpn()  c.tlsVersion()     (DIAGNOSTICS)
//   c.cipher()  c.verifiedBy()  QuicError: e.code e.osError e.detail e.message()
//   ngtcp2Version()  backendVersion()
//
// CONNECTIONS. A Connection is one QUIC connection's state, in either role.
// A client's is made from a client Context, the name its server's
// certificate must be for, and the path's two addresses; its first packet is
// ready at once. A server's is made from the first packet a client sent
// (Connection.accept refuses one that is not a client's Initial). A driver
// keeps four calls going, as for every core of this runtime:
// 'handleInput(packet, now)' takes one UDP payload that came; 'pollTransmit(now)'
// gives the next one to send, an IoBuf of at most maxUdpPayload bytes, empty
// when there is none (ngtcp2 coalesces several frames, and several streams'
// data, into one packet, and its long-header packets into one payload);
// 'wakeAt()' is when to call again with no packet; 'pollEvent()' says what
// happened. There is no handleTimeout: a wake time that has come is acted on
// by the next handleInput or pollTransmit (a lost packet's retransmission
// queued, an acknowledgement sent, the idle timeout's end), so THE OWNER MUST
// CALL pollTransmit WHEN wakeAt IS REACHED, EVEN WITH NO INPUT, and send what
// it gives; a connection left alone past its wake time does nothing. The
// connection knows the time only from these calls. Connection migration is off (MIGRATION below): the path is fixed for
// the connection's life.
//
// EVENTS. 'pollEvent' gives one Event each call, Nothing when there is none
// new, in order: HandshakeDone (streams may carry data both ways); for a
// client, VerifyNeeded (the OS's verifier must run, see CERTIFICATES); a
// stream the peer opened (PeerStream), before its first data; a stream's
// bytes (Data: an IoBuf, in order, 'fin' on the last), consecutive pieces
// of one stream gathered into one buffer where they fit; the peer's reset of
// its sending half (Reset, with its code); WriteStopped when the peer has
// stopped this end's sending half (its STOP_SENDING, which ngtcp2 answers
// itself with a RESET_STREAM carrying the peer's code, calling back for
// neither: so it is known, without the code, when this end next has bytes
// for the stream, and 'write' refuses more); MoreStreams when the peer
// allows this end more streams of a kind; and
// Closed, once, last: by the peer or this end, an application's code or a
// transport's (a TLS alert is CRYPTO_ERROR, 0x100 + the alert), or the idle
// timeout. 'error()' says what failed when this end failed.
//
// STREAMS. A stream is named by its QUIC number (RFC 9000, section 2.1:
// bit 0 the opener, a server's odd; bit 1 unidirectional). This end opens
// one with 'openBidi' or 'openUni', which give None while the peer's
// MAX_STREAMS allows no more (MoreStreams says when it does). 'write' moves
// an IoBuf in, kept until the peer acknowledges its bytes (ngtcp2
// retransmits from it); 'writeBytes' copies. 'finish' ends the stream after
// what was written. 'reset' abandons this end's sending half with a code
// (RESET_STREAM); 'stopSending' asks the peer to abandon its (STOP_SENDING),
// and what arrives after is dropped. A stream's state is one record in one
// table, made when the stream opens and gone when ngtcp2 has closed the
// stream (both halves done) and its owner has released all its bytes; a
// stream of the peer's that goes lets the peer open one more of its kind
// (ngtcp2 raises the peer's limit only when told). Written bytes are not
// bounded here: 'queued(stream)' says how many wait for acknowledgement, for
// the owner to bound.
//
// CREDIT (invariant I9: bounded memory). A stream's Data events are bytes on
// loan: the peer may send 'streamWindow' bytes on a stream past what the
// owner has released, and 'release(stream, n)' gives n back
// (ngtcp2_conn_extend_max_stream_offset, a MAX_STREAM_DATA in time). The
// connection's credit (MAX_DATA) comes back as the bytes arrive
// (ngtcp2_conn_extend_max_offset), not as they are released: so a stream
// whose owner stops reading stops only itself, and the others go on
// (research-http2-multiplexing's choice (A), gRPC-Go's). Unread bytes are
// bounded by the stream windows: at most (maxStreamsBidi + maxStreamsUni) x
// streamWindow for the peer's streams, about 29 MiB at the defaults, plus
// streamWindow for each of this end's bidirectional streams; the connection
// window bounds only what is in flight.
//
// CONFIG (each a field of Config; Config.make() gives the defaults, each a
// named constant). 'alpn' ("h3") is the one application protocol: a client
// offers it, a server accepts it alone (a client offering others is refused
// with no_application_protocol, alert 120), and either end closes with that
// alert when the handshake did not agree on it. 'verify'
// (tls.Verifier.platform()), 'offline' (false) and 'verifyLane'
// (tls.defaultVerifyLane()) are a client's, as in tls's ClientConfig.
// 'streamWindow' (256 KiB, as quic-go's starting window halved and
// Kestrel's below its 768 KiB; the memory a stalled stream may hold) and
// 'connectionWindow' (16 MiB, msquic's: under the CREDIT rule above it bounds
// only bytes in flight, so it is sized for a fast link's bandwidth x delay)
// are what the peer may send. 'maxStreamsBidi' (100, the de facto number:
// quinn, quic-go, curl, RFC 9113's recommendation) and 'maxStreamsUni' (16:
// HTTP/3's three, its control and QPACK streams, with room for the reserved
// stream types a peer may open first) are how many of each the peer may
// have open. 'idleTimeout' (30 s, RFC 9308's suggestion and quinn's,
// quic-go's and msquic's; the smaller of both ends' wins). 'maxUdpPayload'
// (1452: ngtcp2's own default, an Ethernet MTU of 1500 less the IPv6 and UDP
// headers) is the largest payload sent and the largest the peer is told this
// end takes; 1200, QUIC's least, at the smallest. ngtcp2's window
// auto-tuning is off: the windows are the Config's.
//
// CERTIFICATES. A client checks the server's certificate by its Config's
// 'verify', a tls.Verifier, with tls's semantics (tls's header, VERIFIERS):
// - Verifier.platform(), the default: the operating system, through
//   tls.verifyWork. On Windows that is crypt32's chain engine and SSL policy
//   for the name asked for, with the machine's roots, policy and enterprise
//   settings and the end certificate's revocation checked when the data can
//   be had; on Linux, OpenSSL's own check against the system's roots
//   (SSL_CERT_FILE and SSL_CERT_DIR, else the default places of the OpenSSL
//   the program loaded: for a user-prefix OpenSSL 3.5 that is the prefix's
//   own 'ssl' folder, not Ubuntu's /etc/ssl/certs, so a deployment names the
//   system's roots by those variables or builds OpenSSL with
//   --openssldir=/usr/lib/ssl). It may fetch over the network, so it never
//   runs inside handleInput: the handshake stops when the chain comes, the
//   connection says VerifyNeeded, its owner runs 'verifyOp' on the blocking
//   pool (or 'verifyNow' where blocking is fine), and the handshake goes on
//   from 'verifyDone'. A refusal closes the connection with the TLS alert
//   OpenSSL sends, and 'error()' carries Windows' error ('osError') and its
//   words. UNTESTED: an acceptance by Windows' own store. tests/verify.cone
//   shows the OS's store alone accepting on Linux (SSL_CERT_FILE naming the
//   test root, for the test's process) and crypt32 refusing the test root
//   on Windows; a Windows acceptance would need the test root in the
//   machine's store, which no test puts there.
// - Verifier.roots(pem): FOR DEVELOPMENT. OpenSSL checks the chain against
//   these roots alone, and the name.
// - Verifier.pinnedSha256(hex): FOR DEVELOPMENT. The server's key's SHA-256
//   must be one of these, whatever signed it and whatever names it holds.
// - Verifier.insecureDevelopmentOnly(): FOR DEVELOPMENT ONLY. Nothing is
//   checked.
// A server presents a certificate chain and key from PEM files. TLS 1.3
// only, as QUIC requires. 0-RTT is off: a client keeps no tickets and so
// never resumes, and a server sends none and takes no early data.
//
// WORKAROUNDS FOR NGTCP2 1.22.1, pinned to it. Both make the handshake stop
// for the certificate's verdict and go on from it (verify.cone):
// (i) The package's own recv_crypto_data callback, in place of the crypto
//   helper's: it calls ngtcp2_crypto_read_write_crypto_data as the helper
//   does, but takes the stop OpenSSL makes for the verdict
//   (SSL_set_retry_verify, SSL_get_error's WANT_RETRY_VERIFY) as an
//   interruption, where the helper ends the connection (it knows only its
//   client hello and certificate lookup interruptions).
// (ii) The one-byte datagram. TLS finishes a resumed handshake outside
//   ngtcp2's read, and ngtcp2 marks a handshake done only at a read's end.
//   Without the mark the client sends its Finished while ngtcp2 still waits;
//   a HANDSHAKE_DONE that comes before the client's next write then discards
//   its Handshake keys while it waits, and that write crashes (an access
//   violation in ngtcp2_conn_writev_stream). So after the verdict the
//   connection reads one zero byte, which ngtcp2 drops as padding, and that
//   read's end marks the handshake.
// No release after 1.22.1 (1.23.0, 1.24.0, 1.25.0) names a fix for either,
// in its notes or in ngtcp2's GitHub issues (read 26 Oct 2026): none was
// found, and none has been reported. Both are to be checked, and taken out
// if no longer needed, when the package moves to a newer ngtcp2 (which needs
// MSVC 19.44 or later, WINDOWS AND LINUX below). 1.24.0 also adds a
// recv_stop_sending callback, which would give WriteStopped the peer's code.
//
// MIGRATION. Connection migration is off: this end announces
// disable_active_migration, so the peer must not move the connection to
// another address, and this end never does. The path given when the
// connection was made is the only one.
//
// NOT HERE YET: migration (above), Retry and address validation tokens,
// stateless reset (the reset tokens are random), datagrams, key update
// initiated here (ngtcp2 answers the peer's), qlog, ECN, IPv6 addresses
// (Addr.v4 only), a bound on written bytes (queued), priorities (streams
// take turns round robin), and retransmitting a CONNECTION_CLOSE when packets
// keep coming after it.
//
// WINDOWS AND LINUX. On Windows ngtcp2 1.22.1 is built from its signed release
// source by tools/deps/build_ngtcp2.py with MSVC (Release, shared libraries,
// the library and the OpenSSL crypto helper only:
//
//   -DCMAKE_BUILD_TYPE=Release -DENABLE_LIB_ONLY=ON -DENABLE_SHARED_LIB=ON
//   -DENABLE_STATIC_LIB=OFF -DBUILD_TESTING=OFF -DENABLE_OPENSSL=ON
//
// ngtcp2-1.22.1.tar.gz, SHA-256
// 063d80531acac0ddbbc1b9d12829a824edc2abe8dba2e632fd1ce15cfd5632f9), against
// tls's OpenSSL 3.5.9 DLLs and their headers (tools/deps/fetch.py), into
// deps/ngtcp2/; Congo copies its two DLLs beside each program, with OpenSSL's.
// 1.22.1, not the latest: from 1.23.0 ngtcp2 needs MSVC 19.44 (Visual Studio
// 2022 17.14) or later, whose C11 _Generic tells char from signed char, and the
// MSVC this was built with is 19.42. The script's header says how to move.
// Linux needs OpenSSL 3.5 or later, which Ubuntu 24.04 does not ship (its
// OpenSSL is 3.0, with no QUIC TLS interface, and its ngtcp2, 0.12, has no
// OpenSSL 3.5 helper); a build of OpenSSL 3.5 into a user prefix works. The
// same script then builds ngtcp2 with the system's compiler against it
// ('python3 tools/deps/build_ngtcp2.py --openssl <prefix>'), into
// deps/ngtcp2/ ([link.linux]), with that OpenSSL's libraries beside it, and a
// program runs with LD_LIBRARY_PATH naming that folder. The package imports
// tls (its verifiers), so on Linux tls runs on that OpenSSL 3.5 too, in a
// program that imports quic: the two have one soname, libssl.so.3, and tls
// uses nothing newer than 3.0. So built (OpenSSL 3.5.9 from its signed
// source, gcc 13), the package's tests pass on Ubuntu 24.04, debug and
// release.

mod quic;

import libc;
import collections use List, String, Deque, Dict;
import sync use Once;
import time use Instant, Duration;
import path use Path;
import iobuf use IoBuf;
import iocore use Op, Completion, Lane, IoError;
import slots use SlotTable;
import tls;

fn @initpure init() {
  helperOnce = Once.make();
}

// ngtcp2's crypto helper prepares OpenSSL's ciphers once for the process,
// on the first context made (optional, and recommended by ngtcp2: without it
// each connection fetches them anew); and the binding's structs are checked
// against the library loaded, once
let helperOnce: Once;

fn initHelper() {
  checkLayout();
  ngtcp2_crypto_ossl_init();
}

// The binding's structs are the sizes cl.exe and gcc give ngtcp2 1.22.1's
// (x64, Windows and Linux alike: none holds a C 'long'), and ngtcp2's own
// defaults land in the fields where the binding reads them. A library that
// differs would be misread silently, so it is a panic
fn checkLayout() {
  if mem.sizeof[Cid]() != 32usize || mem.sizeof[PktInfo]() != 8usize || mem.sizeof[NgPath]() != 40usize
      || mem.sizeof[PathStorage]() != 96usize || mem.sizeof[PreferredAddr]() != 96usize
      || mem.sizeof[TransportParams]() != 344usize || mem.sizeof[Settings]() != 200usize
      || mem.sizeof[Callbacks]() != 360usize || mem.sizeof[CcErr]() != 40usize
      || mem.sizeof[ConnRef]() != 16usize || mem.sizeof[PktHd]() != 112usize {
    panic("quic: the ngtcp2 binding's structs are not ngtcp2 1.22.1's sizes");
  }
  let s = defaultSettings();
  if s.initialRtt != 333000000u64 || s.maxTxUdpPayloadSize != 1452usize || s.ackThresh != 2usize
      || s.maxWindow != 0u64 || s.maxStreamWindow != 0u64 {
    panic("quic: ngtcp2's default settings are not where the binding reads them");
  }
  let tp = defaultParams();
  if tp.maxUdpPayloadSize != 65527u64 || tp.ackDelayExponent != 3u64 || tp.maxAckDelay != 25000000u64
      || tp.activeConnectionIdLimit != 2u64 {
    panic("quic: ngtcp2's default transport parameters are not where the binding reads them");
  }
}

fn helperReady() {helperOnce.callOnce(&initHelper);}

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

// Why a connection could not be made, or failed
pub struct QuicError {
  pub code: i32;           // ngtcp2's error (negative), or 0 when the failure was not ngtcp2's
  pub osError: u32;        // Windows' error when the OS's verifier refused the certificate, else 0
  pub detail: String;      // what was wrong, one line

  pub fn make(code: i32, detail: &str) QuicError {QuicError(code, 0u32, String.from(detail))}

  pub fn copy(self: &) QuicError {QuicError(code, osError, detail.copy())}

  // 'quic: the server's certificate was refused by the OS's verifier: ...
  // (Windows 0x800B0109) (ERR_CRYPTO)'
  pub fn message(self: &) String {
    var out = String.from("quic: ");
    out.append(detail.view());
    if code != 0i32 {
      out.append(" (");
      out.append(ngError(code));
      out.append(")");
    }
    out
  }
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

// An IPv4 address and a port, as the OS's sockaddr holds them: the ends of a
// connection's path, which ngtcp2 keeps and checks every packet against.
// The package sends nothing to it; the owner's sockets do
pub struct Addr {
  raw: Array[u8, 28];
  size: u32;

  // a.b.c.d:port
  pub fn v4(a: u8, b: u8, c: u8, d: u8, port: u16) Addr {
    var s = Addr(Array[u8, 28]() <- fill 0u8, 16u32);
    s.raw[0usize] = 2u8;                  // AF_INET, little-endian
    s.raw[2usize] = u8.from(port >> 8u16);
    s.raw[3usize] = u8.from(port & 0xFFu16);
    s.raw[4usize] = a;
    s.raw[5usize] = b;
    s.raw[6usize] = c;
    s.raw[7usize] = d;
    s
  }
}

// ---------------------------------------------------------------------------
// Diagnostics
// ---------------------------------------------------------------------------

// The ngtcp2 library loaded: '1.22.1'
pub fn ngtcp2Version() &str {
  let info = ngtcp2_version(0i32);
  if info as usize == 0usize {return "";}
  cText(*((info + 8usize) as **u8))      // ngtcp2_info: age, version_num, version_str
}

// The OpenSSL library loaded: 'OpenSSL 3.5.9 30 Sep 2026'
pub fn backendVersion() &str {cText(OpenSSL_version(0i32))}

// A timestamp as ngtcp2 takes it: nanoseconds, from whatever origin the
// owner's Instants have
fn tsOf(now: Instant) u64 {
  let n = now.nanos();
  if n < 0i64 {0u64} else {u64.from(n as u64)}
}
