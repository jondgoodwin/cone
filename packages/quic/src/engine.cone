// The Engine: one ngtcp2 connection, its TLS session through the crypto
// helper, and the callbacks ngtcp2 makes (see the package's header, ENGINE).
//
// How it is built. ngtcp2 calls back into the package from inside its own
// calls (read, write, expiry). As tls does with OpenSSL's callbacks, those
// callbacks touch nothing of Cone's: each appends a record to the engine's
// callback block, a block of C memory that never moves (ngtcp2's user data,
// and the SSL object's app data), and the Engine turns the records into its
// events and its bookkeeping once ngtcp2's call has returned ('harvest'). The
// block begins with the ngtcp2_crypto_conn_ref the crypto helper looks for in
// the SSL object's app data, through which it reaches the connection. A
// record holds a stream's received bytes by value: ngtcp2's pointer to them
// lasts only for the callback.
//
// Bytes to send are copied into chunks, one a 'send', each the exact size of
// what it holds, so the memory ngtcp2 is handed never moves. ngtcp2 keeps
// pointing at it until the peer acknowledges it (it retransmits from it), and
// says so in order, stream by stream: the acknowledged chunks are dropped then,
// and a stream's every chunk when the stream closes. A stream's sending state
// is an Outgoing, kept for the Engine's life.

// The records a callback leaves
const recData = 1u32;
const recOpen = 2u32;
const recClose = 3u32;
const recReset = 4u32;
const recStopSending = 5u32;
const recAcked = 6u32;
const recHandshake = 7u32;

const callbackFailure = -502i32;    // NGTCP2_ERR_CALLBACK_FAILURE

// A record's head, then its bytes, padded to 8
struct Rec {
  kind: u32;
  flags: u32;
  stream: i64;
  a: u64;
  b: u64;
  len: u64;
}

// The callback block: C memory, at an address that never changes
struct Box {
  ref: ConnRef;            // first: the SSL object's app data points here
  conn: *u8;               // the ngtcp2_conn, once made
  inbox: *u8;              // records not yet harvested
  inLen: usize;
  inCap: usize;
  alpn: *u8;               // a server's: the protocol it accepts, ALPN's wire format
  alpnLen: u32;
  oom: u32;                // a record could not be kept: the connection fails
}

// What happened, once each (see the package's header, ENGINE)
pub enum EngineEvent {
  pub struct Nothing {}
  pub struct HandshakeDone {}                                  // streams may carry data both ways
  pub struct PeerStream {pub stream: i64;}                     // the peer opened it
  pub struct Data {pub stream: i64; pub bytes: List[u8]; pub fin: bool;}   // in order; fin: its end
  pub struct Reset {pub stream: i64; pub code: u64;}           // the peer reset its sending half
  pub struct StopSending {pub stream: i64; pub code: u64;}     // the peer asks this end to stop sending
  pub struct StreamClosed {pub stream: i64; pub code: u64;}    // both halves done; code: the app's, or 0
  pub struct Closed {pub byPeer: bool; pub app: bool; pub code: u64; pub idle: bool;}
}

// A chunk of a stream's bytes to send; 'end' the stream offset after it
struct Chunk {
  data: List[u8];
  end: u64;
}

// A stream's sending state
struct Outgoing {
  stream: i64;
  chunks: Deque[Chunk];     // not yet acknowledged, in order
  offered: u64;             // the stream offset up to which ngtcp2 has the bytes
  queued: u64;              // the stream offset after the last byte queued
  fin: bool;                // the end is queued
  finSent: bool;            // ...and ngtcp2 has it
  closed: bool;             // the stream is closed: nothing more goes out

  fn make(stream: i64) Outgoing {
    Outgoing(stream, Deque[Chunk].empty(), 0u64, 0u64, false, false, false)
  }

  fn hasUnsent(self: &) bool {!closed && (offered < queued || (fin && !finSent))}

  // The unsent bytes of the chunk that holds the stream offset 'offered':
  // where they are and how many (none: only the end is left to send)
  fn nextVec(self: &) NgVec {
    var i = 0usize;
    while i < chunks.len() {
      let end = chunks[i].end;
      let start = end - u64.from(chunks[i].data.len());
      if offered >= start && offered < end {
        let at = usize.from(offered - start);
        let v = chunks[i].data.view();
        return NgVec(&v[at] as *u8, usize.from(end - offered));
      }
      i = i + 1usize;
    }
    NgVec(null, 0usize)
  }

  // The peer has acknowledged the stream's bytes up to 'upTo'
  fn acked(self: &mut, upTo: u64) {
    while true {
      var drop = false;
      match chunks.peekFront() {
        case let Some(c) {drop = c.end <= upTo;}
        case is None[&Chunk] {}
      }
      if !drop {break;}
      chunks.popFront();
    }
  }
}

// One QUIC connection, in either role (see the package's header, ENGINE)
pub struct Engine is Move {
  conn: *u8;
  ossl: *u8;               // the crypto helper's per-connection state
  ssl: *u8;
  box: *u8;                // the callback block
  ps: *u8;                 // the path: ngtcp2_path_storage, C memory
  server: bool;
  sends: List[Outgoing];
  events: Deque[EngineEvent];
  closed: bool;            // closing, draining, or gone: nothing more goes out
  mustClose: Option[i32];  // ngtcp2 failed with this: the next transmit writes the CONNECTION_CLOSE
  err: Option[QuicError];

  // A client's connection to 'host' (its certificate must be for that name),
  // its first packet ready to transmit
  pub fn client(tls: &TlsContext, host: &str, localAddr: &Addr, remoteAddr: &Addr, params: &Params,
      now: Instant) Result[Engine, QuicError] {
    if tls.isServer() {return Error[Engine, QuicError](QuicError.make(0i32, "a client needs a client's TlsContext"));}
    let b = boxMake();
    let ssl = SSL_new(tls.ctx);
    if ssl as usize == 0usize {
      boxFree(b);
      return Error[Engine, QuicError](tlsError("SSL_new failed"));
    }
    var ossl = null as *u8;
    if ngtcp2_crypto_ossl_ctx_new(&mut ossl, ssl) != 0i32 || ngtcp2_crypto_ossl_configure_client_session(ssl) != 0i32 {
      SSL_free(ssl);
      if ossl as usize != 0usize {ngtcp2_crypto_ossl_ctx_del(ossl);}
      boxFree(b);
      return Error[Engine, QuicError](tlsError("the crypto helper could not take the SSL object"));
    }
    SSL_set_ex_data(ssl, appDataSlot, b);
    SSL_set_connect_state(ssl);
    var name = String.from(host);
    let cname = name.cstr();
    // SNI carries a DNS name, never an address (RFC 6066)
    if !isAddressText(host) {SSL_ctrl(ssl, ctrlSetTlsextHostname, 0i64, cname.ptr());}
    SSL_set1_host(ssl, cname);
    let ps = pathMake(localAddr, remoteAddr);
    var dcid = randomCid(18usize);
    var scid = randomCid(17usize);
    let cb = callbacks(false);
    var settings = settingsFor(now);
    var tp = paramsFor(params);
    var conn = null as *u8;
    let rv = ngtcp2_conn_client_new_versioned(&mut conn, &dcid, &scid, &(*(ps as *PathStorage)).path,
      protoVerV1, callbacksV3, &cb, settingsV3, &settings, transportParamsV1, &tp, null, b);
    if rv != 0i32 {
      SSL_set_ex_data(ssl, appDataSlot, null);
      SSL_free(ssl);
      ngtcp2_crypto_ossl_ctx_del(ossl);
      libc.free(ps);
      boxFree(b);
      return Error[Engine, QuicError](QuicError.make(rv, "the client connection could not be made"));
    }
    (*(b as *Box)).conn = conn;
    ngtcp2_conn_set_tls_native_handle(conn, ossl);
    Ok[Engine, QuicError](Engine(conn: conn, ossl: ossl, ssl: ssl, box: b, ps: ps, server: false,
      sends: List[Outgoing].empty(), events: Deque[EngineEvent].empty(), closed: false,
      mustClose: None, err: None))
  }

  // A server's connection from a client's first packet, which it reads:
  // its answer is ready to transmit. A packet that is not a client's Initial
  // is refused
  pub fn accept(tls: &TlsContext, packet: &Array[u8], localAddr: &Addr, remoteAddr: &Addr, params: &Params,
      now: Instant) Result[Engine, QuicError] {
    if !tls.isServer() {return Error[Engine, QuicError](QuicError.make(0i32, "a server needs a server's TlsContext"));}
    if packet.len == 0usize {return Error[Engine, QuicError](QuicError.make(0i32, "an empty packet"));}
    var hd = PktHd(Cid.none(), Cid.none(), 0i64, null, 0usize, 0usize, 0usize, 0u32, 0u8, 0u8);
    let arv = ngtcp2_accept(&mut hd, &packet[0usize] as *u8, packet.len);
    if arv != 0i32 {return Error[Engine, QuicError](QuicError.make(arv, "the packet is not a client's first"));}
    let b = boxMake();
    let wire = tls.alpn.view();
    if wire.len > 0usize {
      let a = libc.malloc(wire.len);
      libc.memcpy(a, &wire[0usize] as *u8, wire.len);
      (*(b as *Box)).alpn = a;
      (*(b as *Box)).alpnLen = u32.from(wire.len);
    }
    let ssl = SSL_new(tls.ctx);
    if ssl as usize == 0usize {
      boxFree(b);
      return Error[Engine, QuicError](tlsError("SSL_new failed"));
    }
    var ossl = null as *u8;
    if ngtcp2_crypto_ossl_ctx_new(&mut ossl, ssl) != 0i32 || ngtcp2_crypto_ossl_configure_server_session(ssl) != 0i32 {
      SSL_free(ssl);
      if ossl as usize != 0usize {ngtcp2_crypto_ossl_ctx_del(ossl);}
      boxFree(b);
      return Error[Engine, QuicError](tlsError("the crypto helper could not take the SSL object"));
    }
    SSL_set_ex_data(ssl, appDataSlot, b);
    SSL_set_accept_state(ssl);
    let ps = pathMake(localAddr, remoteAddr);
    var scid = randomCid(17usize);
    let cb = callbacks(true);
    var settings = settingsFor(now);
    var tp = paramsFor(params);
    tp.originalDcid = hd.dcid;
    tp.originalDcidPresent = 1u8;
    var conn = null as *u8;
    let rv = ngtcp2_conn_server_new_versioned(&mut conn, &hd.scid, &scid, &(*(ps as *PathStorage)).path,
      hd.version, callbacksV3, &cb, settingsV3, &settings, transportParamsV1, &tp, null, b);
    if rv != 0i32 {
      SSL_set_ex_data(ssl, appDataSlot, null);
      SSL_free(ssl);
      ngtcp2_crypto_ossl_ctx_del(ossl);
      libc.free(ps);
      boxFree(b);
      return Error[Engine, QuicError](QuicError.make(rv, "the server connection could not be made"));
    }
    (*(b as *Box)).conn = conn;
    ngtcp2_conn_set_tls_native_handle(conn, ossl);
    var e = Engine(conn: conn, ossl: ossl, ssl: ssl, box: b, ps: ps, server: true,
      sends: List[Outgoing].empty(), events: Deque[EngineEvent].empty(), closed: false,
      mustClose: None, err: None);
    e.read(packet, now);
    Ok[Engine, QuicError](e)
  }

  // ---------------------------------------------------------------------------
  // Packets in and out
  // ---------------------------------------------------------------------------

  // One UDP payload that came from the peer
  pub fn read(self: &mut, packet: &Array[u8], now: Instant) {
    if closed || packet.len == 0usize {return;}
    let pi = PktInfo.none();
    let rv = ngtcp2_conn_read_pkt_versioned(conn, &(*(ps as *PathStorage)).path, pktInfoV1, &pi,
      &packet[0usize] as *u8, packet.len, tsOf(now));
    self.harvest();
    if rv == 0i32 {return;}
    if rv == errDraining {
      // The peer closed the connection: its CONNECTION_CLOSE came
      self.closedBy(true, false);
    } else if rv == errClosing {
      // This end is closing: the packet is dropped
    } else if rv == errDropConn {
      self.fail(rv, "the connection was dropped");
      closed = true;
    } else if rv == errRetry {
      self.fail(rv, "the client must retry with an address validation token, which this package does not send yet");
      closed = true;
    } else {
      self.fail(rv, "a packet could not be processed");
      mustClose = Some(rv);
    }
  }

  // The next UDP payload to send, written into 'out' (at least 1200 bytes):
  // its length, 0 when there is nothing to send now
  pub fn transmit(self: &mut, out: &mut Array[u8], now: Instant) usize {
    if out.len < maxUdpPayloadSize {return 0usize;}
    let ts = tsOf(now);
    var pi = PktInfo.none();
    match mustClose {
      case let Some(liberr) {
        mustClose = None;
        closed = true;
        var cc = CcErr(0i32, 0u64, 0u64, null, 0usize);
        ngtcp2_ccerr_default(&mut cc);
        // TLS's failure goes to the peer as its alert (CRYPTO_ERROR 0x100 +
        // the alert); any other as the transport error ngtcp2 infers
        if liberr == errProtoTls() {
          ngtcp2_ccerr_set_tls_alert(&mut cc, ngtcp2_conn_get_tls_alert(conn), null, 0usize);
        } else {
          ngtcp2_ccerr_set_liberr(&mut cc, liberr, null, 0usize);
        }
        let n = ngtcp2_conn_write_connection_close_versioned(conn, null, pktInfoV1, &mut pi,
          &mut out[0usize] as *u8, out.len, &cc, ts);
        self.harvest();
        self.closedBy(false, false);
        return if n > 0isize {usize.from(n as usize)} else {0usize};
      }
      case is None[i32] {}
    }
    if closed {return 0usize;}
    // Stream data first, a stream at a time
    var k = 0usize;
    var wrote = false;
    var written = 0usize;
    while k < sends.len() && !wrote {
      if !sends[k].hasUnsent() {
        k = k + 1usize;
        continue;
      }
      let v = sends[k].nextVec();
      let stream = sends[k].stream;
      let finNow = sends[k].fin && sends[k].offered + u64.from(v.len) == sends[k].queued;
      let flags = if finNow {writeStreamFlagFin} else {0u32};
      var accepted = -1isize;
      let n = ngtcp2_conn_writev_stream_versioned(conn, null, pktInfoV1, &mut pi,
        &mut out[0usize] as *u8, out.len, &mut accepted, flags, stream, &v,
        if v.len == 0usize {0usize} else {1usize}, ts);
      self.harvest();
      if n < 0isize {
        let e = liberrOf(n);
        if e == errStreamDataBlocked || e == errStreamShutWr || e == errStreamNotFound {
          k = k + 1usize;
          continue;
        }
        self.failWrite(e);
        return 0usize;
      }
      if accepted >= 0isize {
        let w = &mut sends[k];
        w.offered = w.offered + u64.from(accepted as usize);
        if finNow && w.offered == w.queued {w.finSent = true;}
      }
      // A packet; or none, when nothing may go now (congestion, or flow
      // control), ngtcp2's own frames neither
      written = usize.from(n as usize);
      wrote = true;
    }
    if wrote {return written;}
    // Then ngtcp2's own: the handshake, acknowledgements, flow control
    let n = ngtcp2_conn_write_pkt_versioned(conn, null, pktInfoV1, &mut pi, &mut out[0usize] as *u8,
      out.len, ts);
    self.harvest();
    if n < 0isize {
      self.failWrite(liberrOf(n));
      return 0usize;
    }
    usize.from(n as usize)
  }

  // When ngtcp2's next timer fires (a loss, an acknowledgement's delay, the
  // idle timeout), or None
  pub fn expiry(self: &) Option[Instant] {
    if closed {return None;}
    let t = ngtcp2_conn_get_expiry(conn);
    if t == noExpiry {return None;}
    Some(Instant.fromNanos(i64.from(t as i64)))
  }

  // ngtcp2's timer has fired: what it was for is done (a retransmission
  // queued, the idle timeout's close)
  pub fn onExpiry(self: &mut, now: Instant) {
    if closed {return;}
    let rv = ngtcp2_conn_handle_expiry(conn, tsOf(now));
    self.harvest();
    if rv == 0i32 {return;}
    if rv == errIdleClose {
      closed = true;
      events.push(EngineEvent.Closed(false, false, 0u64, true));
    } else {
      self.fail(rv, "the connection's timer failed");
      mustClose = Some(rv);
    }
  }

  // ---------------------------------------------------------------------------
  // Streams
  // ---------------------------------------------------------------------------

  // A new bidirectional stream of this end's, or None when the peer allows
  // no more yet
  pub fn openBidi(self: &mut) Option[i64] {
    var id = 0i64;
    if closed || ngtcp2_conn_open_bidi_stream(conn, &mut id, null) != 0i32 {return None;}
    Some(id)
  }

  // A new unidirectional stream of this end's, or None
  pub fn openUni(self: &mut) Option[i64] {
    var id = 0i64;
    if closed || ngtcp2_conn_open_uni_stream(conn, &mut id, null) != 0i32 {return None;}
    Some(id)
  }

  // Queue bytes on a stream (copied), and its end when 'fin'. They go out
  // from 'transmit', as the peer's flow control allows
  pub fn send(self: &mut, stream: i64, data: &Array[u8], fin: bool) {
    let k = self.outgoing(stream);
    let o = &mut sends[k];
    if o.fin || o.closed {return;}
    if data.len > 0usize {
      var bytes = List[u8].withCapacity(data.len);
      bytes.resize(data.len, 0u8);
      libc.memcpy(&mut bytes.viewMut()[0usize] as *u8, &data[0usize] as *u8, data.len);
      o.queued = o.queued + u64.from(data.len);
      o.chunks.push(Chunk(bytes, o.queued));
    }
    if fin {o.fin = true;}
  }

  // The owner has used n more of a stream's received bytes: the peer may
  // send that many more, on the stream and on the connection
  pub fn consume(self: &mut, stream: i64, n: usize) {
    if closed || n == 0usize {return;}
    ngtcp2_conn_extend_max_stream_offset(conn, stream, u64.from(n));
    ngtcp2_conn_extend_max_offset(conn, u64.from(n));
  }

  // Abandon a stream both ways with an application error code: its sending
  // half reset (RESET_STREAM) and the peer asked to stop (STOP_SENDING)
  pub fn resetStream(self: &mut, stream: i64, code: u64) {
    if closed {return;}
    ngtcp2_conn_shutdown_stream(conn, 0u32, stream, code);
    let k = self.outgoing(stream);
    let o = &mut sends[k];
    o.closed = true;
    o.chunks.clear();
  }

  // ---------------------------------------------------------------------------
  // Closing
  // ---------------------------------------------------------------------------

  // Close the connection with an application error code (0: no error),
  // writing the CONNECTION_CLOSE into 'out': its length
  pub fn close(self: &mut, out: &mut Array[u8], code: u64, now: Instant) usize {
    if closed || out.len < maxUdpPayloadSize {return 0usize;}
    var cc = CcErr(0i32, 0u64, 0u64, null, 0usize);
    ngtcp2_ccerr_default(&mut cc);
    ngtcp2_ccerr_set_application_error(&mut cc, code, null, 0usize);
    var pi = PktInfo.none();
    let n = ngtcp2_conn_write_connection_close_versioned(conn, null, pktInfoV1, &mut pi,
      &mut out[0usize] as *u8, out.len, &cc, tsOf(now));
    self.harvest();
    closed = true;
    events.push(EngineEvent.Closed(false, true, code, false));
    if n > 0isize {usize.from(n as usize)} else {0usize}
  }

  // ---------------------------------------------------------------------------
  // Events and state
  // ---------------------------------------------------------------------------

  // What happened next, once each; Nothing when nothing is new
  pub fn pollEvent(self: &mut) EngineEvent {
    match events.popFront() {
      case let Some(e) {return e;}
      case is None[EngineEvent] {}
    }
    EngineEvent.Nothing
  }

  pub fn isServer(self: &) bool {server}
  pub fn isClosed(self: &) bool {closed}
  pub fn handshakeDone(self: &) bool {ngtcp2_conn_get_handshake_completed(conn) != 0i32}

  // What failed, when something did
  pub fn error(self: &) Option[QuicError] {
    match &err {
      case let Some(e) {return Some(e.copy());}
      case is None[QuicError] {}
    }
    None
  }

  // The protocol ALPN chose, or empty
  pub fn alpn(self: &) String {
    var p = null as *u8;
    var n = 0u32;
    SSL_get0_alpn_selected(ssl, &mut p, &mut n);
    var out = String.empty();
    if n > 0u32 {out.appendBytes(mem.sliceFromParts(p, usize.from(n)));}
    out
  }

  // 'TLSv1.3'
  pub fn tlsVersion(self: &) &str {cText(SSL_get_version(ssl))}

  // 'TLS_AES_128_GCM_SHA256'
  pub fn cipher(self: &) &str {
    let c = SSL_get_current_cipher(ssl);
    if c as usize == 0usize {""} else {cText(SSL_CIPHER_get_name(c))}
  }

  // A client's: OpenSSL's verdict on the server's certificate (0: trusted)
  pub fn verifyResult(self: &) i32 {SSL_get_verify_result(ssl)}

  // ---------------------------------------------------------------------------
  // The callback block's records, after each of ngtcp2's calls
  // ---------------------------------------------------------------------------

  fn harvest(self: &mut) {
    let bx = box as *Box;
    var at = 0usize;
    let len = (*bx).inLen;
    let base = (*bx).inbox;
    while at < len {
      let r = *((base + at) as *Rec);
      let n = usize.from(r.len);
      let data = base + at + mem.sizeof[Rec]();
      if r.kind == recData {
        var bytes = List[u8].withCapacity(n);
        if n > 0usize {
          bytes.resize(n, 0u8);
          libc.memcpy(&mut bytes.viewMut()[0usize] as *u8, data, n);
        }
        events.push(EngineEvent.Data(r.stream, bytes, (r.flags & streamDataFlagFin) != 0u32));
      } else if r.kind == recOpen {
        events.push(EngineEvent.PeerStream(r.stream));
      } else if r.kind == recClose {
        let k = self.outgoing(r.stream);
        let o = &mut sends[k];
        o.closed = true;
        o.chunks.clear();
        events.push(EngineEvent.StreamClosed(r.stream, r.a));
      } else if r.kind == recReset {
        events.push(EngineEvent.Reset(r.stream, r.b));
      } else if r.kind == recStopSending {
        events.push(EngineEvent.StopSending(r.stream, r.a));
      } else if r.kind == recAcked {
        let k = self.outgoing(r.stream);
        (&mut sends[k]).acked(r.a + r.b);
      } else if r.kind == recHandshake {
        events.push(EngineEvent.HandshakeDone);
      }
      at = at + mem.sizeof[Rec]() + padded(n);
    }
    (*bx).inLen = 0usize;
    if (*bx).oom != 0u32 && !closed {
      (*bx).oom = 0u32;
      self.fail(callbackFailure, "out of memory in a callback");
      mustClose = Some(callbackFailure);
    }
  }

  // The index of a stream's Outgoing, made when it has none
  fn outgoing(self: &mut, stream: i64) usize {
    var k = 0usize;
    while k < sends.len() {
      if sends[k].stream == stream {return k;}
      k = k + 1usize;
    }
    sends.push(Outgoing.make(stream));
    sends.len() - 1usize
  }

  // The connection ended: the Closed event, with the peer's error code when
  // it closed it (this end's own failure is 'error')
  fn closedBy(self: &mut, byPeer: bool, idle: bool) {
    closed = true;
    var app = false;
    var code = 0u64;
    if byPeer {
      let cc = ngtcp2_conn_get_ccerr(conn);
      app = (*cc).kind == ccerrApplication;
      code = (*cc).errorCode;
    }
    events.push(EngineEvent.Closed(byPeer, app, code, idle));
  }

  // A write failed inside ngtcp2: closing, draining, or a failure whose
  // CONNECTION_CLOSE goes out next
  fn failWrite(self: &mut, e: i32) {
    if e == errClosing || e == errDraining {
      closed = true;
      return;
    }
    self.fail(e, "a packet could not be written");
    if ngtcp2_err_is_fatal(e) != 0i32 {
      closed = true;
    } else {
      mustClose = Some(e);
    }
  }

  // Remember the first failure
  fn fail(self: &mut, code: i32, what: &str) {
    match &err {
      case let Some(e) {return;}
      case is None[QuicError] {}
    }
    var d = String.from(what);
    if code == errProtoTls() {
      let alert = ngtcp2_conn_get_tls_alert(conn);
      if alert != 0u8 {
        d.append(": TLS alert ");
        d.appendUInt(u64.from(alert));
      }
      sslErrors(&mut d);
    }
    err = Some(QuicError(code, d));
  }

  fn final(self: &uni) {
    ngtcp2_conn_del(conn);
    SSL_set_ex_data(ssl, appDataSlot, null);
    SSL_free(ssl);
    ngtcp2_crypto_ossl_ctx_del(ossl);
    libc.free(ps);
    boxFree(box);
  }
}

// NGTCP2_ERR_CRYPTO: the TLS stack failed (an alert, a certificate refused)
fn errProtoTls() i32 {-213i32}

fn padded(n: usize) usize {(n + 7usize) / 8usize * 8usize}

// ngtcp2's error, from a write's negative result (ngtcp2_ssize)
fn liberrOf(n: isize) i32 {i32.from(n)}

// ---------------------------------------------------------------------------
// The callback block, the path, and what a connection is made with
// ---------------------------------------------------------------------------

fn boxMake() *u8 {
  let b = libc.malloc(mem.sizeof[Box]());
  *(b as *Box) = Box(ConnRef(&getConn, b), null, null, 0usize, 0usize, null, 0u32, 0u32);
  b
}

fn boxFree(b: *u8) {
  let bx = b as *Box;
  if (*bx).inbox as usize != 0usize {libc.free((*bx).inbox);}
  if (*bx).alpn as usize != 0usize {libc.free((*bx).alpn);}
  libc.free(b);
}

// The path, both ends' sockaddrs with it, in C memory: it points into itself
fn pathMake(localAddr: &Addr, remoteAddr: &Addr) *u8 {
  let p = libc.malloc(mem.sizeof[PathStorage]());
  ngtcp2_path_storage_init(&mut *(p as *PathStorage), &localAddr.raw as *u8, localAddr.size,
    &remoteAddr.raw as *u8, remoteAddr.size, null);
  p
}

// A connection ID of n random bytes
fn randomCid(n: usize) Cid {
  var c = Cid.none();
  RAND_bytes(&mut c.data as *u8, i32.from(n));
  c.datalen = n;
  c
}

// ngtcp2's settings: its defaults, its clock started at 'now'
fn settingsFor(now: Instant) Settings {
  var s = Settings(null, 0i32, 0u64, 0u64, null, 0usize, null, 0usize, 0i32, null, 0u64, 0u64,
    0usize, 0u8, 0u64, null, 0usize, null, 0usize, 0u32, 0u8, 0u32, null, 0usize, 0u64, 0u64);
  ngtcp2_settings_default_versioned(settingsV3, &mut s);
  s.initialTs = tsOf(now);
  s
}

// The transport parameters announced: ngtcp2's defaults, and the Params'
fn paramsFor(p: &Params) TransportParams {
  var tp = TransportParams(
    PreferredAddr(Cid.none(), Array[u8, 16]() <- fill 0u8, Array[u8, 28]() <- fill 0u8, 0u8, 0u8,
      Array[u8, 16]() <- fill 0u8),
    Cid.none(), Cid.none(), Cid.none(), 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64,
    0u64, 0u64, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, Array[u8, 16]() <- fill 0u8, 0u8,
    VersionInfo(0u32, null, 0usize), 0u8);
  ngtcp2_transport_params_default_versioned(transportParamsV1, &mut tp);
  tp.initialMaxStreamDataBidiLocal = p.streamWindow;
  tp.initialMaxStreamDataBidiRemote = p.streamWindow;
  tp.initialMaxStreamDataUni = p.streamWindow;
  tp.initialMaxData = p.connectionWindow;
  tp.initialMaxStreamsBidi = p.maxStreamsBidi;
  tp.initialMaxStreamsUni = p.maxStreamsUni;
  let idle = p.idleTimeout.nanos();
  tp.maxIdleTimeout = if idle > 0i64 {u64.from(idle as u64)} else {0u64};
  // Connection migration is not here yet (see the package's header)
  tp.disableActiveMigration = 1u8;
  tp
}

// The callbacks: the crypto helper's for the handshake and packet
// protection, the package's for what happens on the connection
fn callbacks(server: bool) Callbacks {
  Callbacks(
    clientInitial: if server {null} else {&ngtcp2_crypto_client_initial_cb as *u8},
    recvClientInitial: if server {&ngtcp2_crypto_recv_client_initial_cb as *u8} else {null},
    recvCryptoData: &ngtcp2_crypto_recv_crypto_data_cb as *u8,
    handshakeCompleted: &onHandshakeCompleted,
    recvVersionNegotiation: null,
    encrypt: &ngtcp2_crypto_encrypt_cb as *u8,
    decrypt: &ngtcp2_crypto_decrypt_cb as *u8,
    hpMask: &ngtcp2_crypto_hp_mask_cb as *u8,
    recvStreamData: &onRecvStreamData,
    ackedStreamDataOffset: &onAckedStreamDataOffset,
    streamOpen: &onStreamOpen,
    streamClose: &onStreamClose,
    recvStatelessReset: null,
    recvRetry: if server {null} else {&ngtcp2_crypto_recv_retry_cb as *u8},
    extendMaxLocalStreamsBidi: null,
    extendMaxLocalStreamsUni: null,
    rand: &onRand,
    getNewConnectionId: &onGetNewConnectionId,
    removeConnectionId: null,
    updateKey: &ngtcp2_crypto_update_key_cb as *u8,
    pathValidation: null,
    selectPreferredAddr: null,
    streamReset: &onStreamReset,
    extendMaxRemoteStreamsBidi: null,
    extendMaxRemoteStreamsUni: null,
    extendMaxStreamData: null,
    dcidStatus: null,
    handshakeConfirmed: null,
    recvNewToken: null,
    deleteCryptoAeadCtx: &ngtcp2_crypto_delete_crypto_aead_ctx_cb as *u8,
    deleteCryptoCipherCtx: &ngtcp2_crypto_delete_crypto_cipher_ctx_cb as *u8,
    recvDatagram: null,
    ackDatagram: null,
    lostDatagram: null,
    getPathChallengeData: &ngtcp2_crypto_get_path_challenge_data_cb as *u8,
    streamStopSending: &onStreamStopSending,
    versionNegotiation: &ngtcp2_crypto_version_negotiation_cb as *u8,
    recvRxKey: null,
    recvTxKey: null,
    tlsEarlyDataRejected: null,
    beginPathValidation: null,
    recvStatelessReset2: null,
    getNewConnectionId2: null,
    dcidStatus2: null,
    getPathChallengeData2: null)
}

// Is this text an IP address (IPv4 dotted, or IPv6 with a colon)?
fn isAddressText(host: &str) bool {
  if host.len() == 0usize {return false;}
  var allDigitsDots = true;
  var k = 0usize;
  while k < host.len() {
    let c = host[k];
    if c == ':' {return true;}
    if !(c == '.' || (c >= '0' && c <= '9')) {allDigitsDots = false;}
    k = k + 1usize;
  }
  allDigitsDots
}

// ---------------------------------------------------------------------------
// The callbacks: each appends a record to the callback block, and touches
// nothing else of the package's
// ---------------------------------------------------------------------------

// Append a record: 0, or NGTCP2_ERR_CALLBACK_FAILURE when the memory for it
// cannot be had (the block marks it, and the connection fails)
fn post(user: *u8, kind: u32, flags: u32, stream: i64, a: u64, b: u64, data: *u8, len: usize) i32 {
  let bx = user as *Box;
  let need = mem.sizeof[Rec]() + padded(len);
  if (*bx).inLen + need > (*bx).inCap {
    var cap = if (*bx).inCap == 0usize {4096usize} else {(*bx).inCap * 2usize};
    while cap < (*bx).inLen + need {cap = cap * 2usize;}
    let p = libc.realloc((*bx).inbox, cap);
    if p as usize == 0usize {
      (*bx).oom = 1u32;
      return callbackFailure;
    }
    (*bx).inbox = p;
    (*bx).inCap = cap;
  }
  let at = (*bx).inbox + (*bx).inLen;
  *(at as *Rec) = Rec(kind, flags, stream, a, b, u64.from(len));
  if len > 0usize {libc.memcpy(at + mem.sizeof[Rec](), data, len);}
  (*bx).inLen = (*bx).inLen + need;
  0i32
}

// The crypto helper asks for the connection, from the SSL object's app data
fn @c("coneQuicGetConn") getConn(ref: *u8) *u8 {(*(ref as *Box)).conn}

fn @c("coneQuicRecvStreamData") onRecvStreamData(conn: *u8, flags: u32, stream: i64, offset: u64,
    data: *u8, datalen: usize, user: *u8, streamUser: *u8) i32 {
  post(user, recData, flags, stream, offset, 0u64, data, datalen)
}

fn @c("coneQuicStreamOpen") onStreamOpen(conn: *u8, stream: i64, user: *u8) i32 {
  post(user, recOpen, 0u32, stream, 0u64, 0u64, null, 0usize)
}

fn @c("coneQuicStreamClose") onStreamClose(conn: *u8, flags: u32, stream: i64, appErrorCode: u64,
    user: *u8, streamUser: *u8) i32 {
  let code = if (flags & streamCloseFlagAppErrorCodeSet) != 0u32 {appErrorCode} else {0u64};
  post(user, recClose, flags, stream, code, 0u64, null, 0usize)
}

fn @c("coneQuicStreamReset") onStreamReset(conn: *u8, stream: i64, finalSize: u64,
    appErrorCode: u64, user: *u8, streamUser: *u8) i32 {
  post(user, recReset, 0u32, stream, finalSize, appErrorCode, null, 0usize)
}

fn @c("coneQuicStreamStopSending") onStreamStopSending(conn: *u8, stream: i64, appErrorCode: u64,
    user: *u8, streamUser: *u8) i32 {
  post(user, recStopSending, 0u32, stream, appErrorCode, 0u64, null, 0usize)
}

fn @c("coneQuicAckedStreamDataOffset") onAckedStreamDataOffset(conn: *u8, stream: i64, offset: u64,
    datalen: u64, user: *u8, streamUser: *u8) i32 {
  post(user, recAcked, 0u32, stream, offset, datalen, null, 0usize)
}

fn @c("coneQuicHandshakeCompleted") onHandshakeCompleted(conn: *u8, user: *u8) i32 {
  post(user, recHandshake, 0u32, 0i64, 0u64, 0u64, null, 0usize)
}

// ngtcp2's randomness: OpenSSL's
fn @c("coneQuicRand") onRand(dest: *u8, destlen: usize, randCtx: *u8) {
  RAND_bytes(dest, i32.from(destlen));
}

// A new connection ID of this end's, and its stateless reset token: random
// (stateless reset is not here yet)
fn @c("coneQuicGetNewConnectionId") onGetNewConnectionId(conn: *u8, cid: &mut Cid, token: *u8,
    cidlen: usize, user: *u8) i32 {
  if RAND_bytes(&mut cid.data as *u8, i32.from(cidlen)) != 1i32 {return callbackFailure;}
  cid.datalen = cidlen;
  if RAND_bytes(token, i32.from(statelessResetTokenLen)) != 1i32 {return callbackFailure;}
  0i32
}
