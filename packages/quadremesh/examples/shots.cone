// shots: quadremesh's retopology, drawn by a small software renderer (no GPU) to
// PNG sheets in C:/src/quadremesh-shots.
//
//   congo run --release packages/quadremesh/examples/shots.cone
//
// Exit status 0 if every remesh came out closed (where the source was) and near
// the source.

mod shots;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import imagedecode use *;
import fs;
import path use Path as FilePath;
import sculpt use *;
import skinmesh use *;
import time use Instant;
import quadremesh use *;

struct Canvas {
  w: i32;
  h: i32;
  px: List[u8];
  zb: List[f32];
  cx0: i32;
  cy0: i32;
  cx1: i32;
  cy1: i32;

  fn make(w: i32, h: i32) Canvas {
    var c = Canvas(w, h, List[u8].empty(), List[f32].empty(), 0, 0, w, h);
    c.px.resize(usize.from(w) * usize.from(h) * 4usize, 255u8);
    c.zb.resize(usize.from(w) * usize.from(h), -1000000.);
    c
  }

  fn tile(self: &mut, x0: i32, y0: i32, x1: i32, y1: i32, bg: Vec3) {
    cx0 = x0; cy0 = y0; cx1 = x1; cy1 = y1;
    var y = y0;
    while y < y1 {
      var x = x0;
      while x < x1 {
        self.setPixel(x, y, bg);
        zb.set(usize.from(y * w + x), -1000000.);
        x = x + 1;
      }
      y = y + 1;
    }
  }

  fn setPixel(self: &mut, x: i32, y: i32, c: Vec3) {
    let i = usize.from(y * w + x) * 4usize;
    px.set(i, byteOf(c.x));
    px.set(i + 1usize, byteOf(c.y));
    px.set(i + 2usize, byteOf(c.z));
  }

  fn plot(self: &mut, x: i32, y: i32, z: f32, c: Vec3) {
    if x >= cx0 && x < cx1 && y >= cy0 && y < cy1 {
      let i = usize.from(y * w + x);
      if z > *zb[i] {
        zb.set(i, z);
        self.setPixel(x, y, c);
      }
    }
  }

  fn triangle(self: &mut, a: Vec3, b: Vec3, c: Vec3, col: Vec3) {
    let minx = imax(cx0, i32.from(libc.floorf(fmin3(a.x, b.x, c.x))));
    let maxx = imin(cx1 - 1, i32.from(libc.ceilf(fmax3(a.x, b.x, c.x))));
    let miny = imax(cy0, i32.from(libc.floorf(fmin3(a.y, b.y, c.y))));
    let maxy = imin(cy1 - 1, i32.from(libc.ceilf(fmax3(a.y, b.y, c.y))));
    let den = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
    if den > -0.0000001 && den < 0.0000001 { return; }
    var y = miny;
    while y <= maxy {
      var x = minx;
      while x <= maxx {
        let px_ = f32.from(x) + 0.5;
        let py_ = f32.from(y) + 0.5;
        let l0 = ((b.y - c.y) * (px_ - c.x) + (c.x - b.x) * (py_ - c.y)) / den;
        let l1 = ((c.y - a.y) * (px_ - c.x) + (a.x - c.x) * (py_ - c.y)) / den;
        let l2 = 1. - l0 - l1;
        if l0 >= -0.0001 && l1 >= -0.0001 && l2 >= -0.0001 {
          self.plot(x, y, l0 * a.z + l1 * b.z + l2 * c.z, col);
        }
        x = x + 1;
      }
      y = y + 1;
    }
  }

  fn line(self: &mut, a: Vec3, b: Vec3, col: Vec3, bias: f32, thick: i32) {
    let dx = b.x - a.x;
    let dy = b.y - a.y;
    let steps = i32.from(fmax3(absf(dx), absf(dy), 1.)) + 1;
    var i = 0;
    while i <= steps {
      let t = f32.from(i) / f32.from(steps);
      let x = a.x + dx * t;
      let y = a.y + dy * t;
      let z = a.z + (b.z - a.z) * t + bias;
      var ox = 0;
      while ox < thick {
        var oy = 0;
        while oy < thick {
          self.plot(i32.from(x) + ox, i32.from(y) + oy, z, col);
          oy = oy + 1;
        }
        ox = ox + 1;
      }
      i = i + 1;
    }
  }

  fn dot(self: &mut, x: f32, y: f32, z: f32, r: i32, col: Vec3) {
    var ox = -r;
    while ox <= r {
      var oy = -r;
      while oy <= r {
        self.plot(i32.from(x) + ox, i32.from(y) + oy, z, col);
        oy = oy + 1;
      }
      ox = ox + 1;
    }
  }
}

fn absf(a: f32) f32 { if a < 0. {-a} else {a} }
fn imax(a: i32, b: i32) i32 { if a > b {a} else {b} }
fn imin(a: i32, b: i32) i32 { if a < b {a} else {b} }
fn fmin3(a: f32, b: f32, c: f32) f32 { let m = if a < b {a} else {b}; if m < c {m} else {c} }
fn fmax3(a: f32, b: f32, c: f32) f32 { let m = if a > b {a} else {b}; if m > c {m} else {c} }

fn byteOf(v: f32) u8 {
  var x = i32.from(v * 255. + 0.5);
  if x < 0 { x = 0; }
  if x > 255 { x = 255; }
  u8.from(x)
}

struct View {
  yaw: f32;
  pitch: f32;

  fn turn(self, p: Vec3) Vec3 {
    let cy = cos(yaw);
    let sy = sin(yaw);
    let x1 = p.x * cy + p.z * sy;
    let z1 = -p.x * sy + p.z * cy;
    let cp = cos(pitch);
    let sp = sin(pitch);
    Vec3(x1, p.y * cp - z1 * sp, p.y * sp + z1 * cp)
  }
}

// Where a mesh sits in a tile: the middle of the box that bounds the points
// given and the scale that fits it
struct Fit {
  mid: Vec3;
  sc: f32;
  tw: f32;
  th: f32;
  cx: f32;
  cy: f32;

  fn of(cv: &Canvas, pts: &List[Vec3], view: &View) Fit {
    var lo = Vec3(1000000., 1000000., 1000000.);
    var hi = Vec3(-1000000., -1000000., -1000000.);
    var v = 0usize;
    while v < pts.len() {
      let p = view.turn(*pts[v]);
      lo = lo.min(p);
      hi = hi.max(p);
      v = v + 1usize;
    }
    let tw = f32.from(cv.cx1 - cv.cx0);
    let th = f32.from(cv.cy1 - cv.cy0);
    let ext = hi - lo;
    let sc = fmin3(tw * 0.92 / fmax3(ext.x, 0.0001, 0.0001), th * 0.92 / fmax3(ext.y, 0.0001, 0.0001), 1000000.);
    Fit((lo + hi) * 0.5, sc, tw, th, f32.from(cv.cx0) + tw * 0.5, f32.from(cv.cy0) + th * 0.5)
  }

  fn screen(self, view: &View, p: Vec3) Vec3 {
    let q = view.turn(p) - mid;
    Vec3(cx + q.x * sc, cy - q.y * sc, q.z * sc)
  }
}

fn valenceColor(v: usize) Vec3 {
  if v == 3usize { Vec3(0.90, 0.10, 0.10) }
  elif v == 5usize { Vec3(0.10, 0.30, 0.95) }
  elif v == 6usize { Vec3(0.10, 0.65, 0.20) }
  else { Vec3(0.95, 0.55, 0.05) }
}

// A mesh shaded, quads outlined, triangles yellow, larger faces purple;
// with 'mark', the interior vertices that are not of valence 4 are dotted
// (3 red, 5 blue, 6 green, others orange); with 'wireOnly' the faces are pale
fn drawMesh(cv: &mut Canvas, pm: &PolyMesh, view: &View, fit: &Fit, mark: bool, wireOnly: bool, edgeCol: Vec3) {
  var sp = List[Vec3].empty();
  var v = 0usize;
  while v < pm.positions.len() {
    sp.push(fit.screen(view, *pm.positions[v]));
    v = v + 1usize;
  }
  let light = Vec3(-0.35, 0.55, 0.75).normalize();
  var f = 0usize;
  while f < pm.faceCount() {
    let vs = pm.faceVertices(u32.from(f));
    let n = view.turn(pm.faceNormal(u32.from(f)));
    var base = if wireOnly { Vec3(0.93, 0.93, 0.91) } else { Vec3(0.78, 0.80, 0.84) };
    if vs.len() == 3usize { base = base * 0.45 + Vec3(0.55, 0.50, 0.0); }
    elif vs.len() > 4usize { base = base * 0.45 + Vec3(0.55, 0.0, 0.55); }
    let shade = if wireOnly { 1. } else { 0.30 + 0.70 * fmax3(n.dot(light), 0., 0.) };
    var col = base * shade;
    if n.z < 0. { col = Vec3(0.9, 0.1, 0.1); }
    var k = 1usize;
    while k + 1usize < vs.len() {
      cv.triangle(*sp[usize.from(*vs[0usize])], *sp[usize.from(*vs[k])], *sp[usize.from(*vs[k + 1usize])], col);
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  f = 0usize;
  while f < pm.faceCount() {
    let vs = pm.faceVertices(u32.from(f));
    var k = 0usize;
    while k < vs.len() {
      cv.line(*sp[usize.from(*vs[k])], *sp[usize.from(*vs[(k + 1usize) % vs.len()])], edgeCol, 0.0006 * fit.sc, 1);
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  if mark {
    v = 0usize;
    while v < pm.positions.len() {
      if !pm.isIsolated(u32.from(v)) && !pm.isBoundaryVertex(u32.from(v)) {
        let val = pm.valence(u32.from(v));
        if val != 4usize {
          let p = *sp[v];
          cv.dot(p.x, p.y, p.z + 0.004 * fit.sc, 2, valenceColor(val));
        }
      }
      v = v + 1usize;
    }
  }
}

fn save(cv: &Canvas, name: &str) {
  var r = Raster.empty();
  r.width = cv.w;
  r.height = cv.h;
  r.depth = 8;
  r.colorSpace = ColorSpace.Srgb;
  var i = 0usize;
  while i < cv.px.len() { r.pixels8.push(*cv.px[i]); i = i + 1usize; }
  let png = encodePng(&r, 2);
  var full = String.from("C:/src/quadremesh-shots/");
  full.append(name);
  let op = FilePath.from(full.view());
  fs.writeFile(&op, png.view());
  printStr("wrote "); printStr(full.view()); printStr(" ("); print <- png.len(); printStr(" bytes)\n");
}

// ---------------------------------------------------------------- sources

fn sphereSource(level: u32, r: f32) PolyMesh {
  let c = PolyMesh.cube(1.);
  var m = subdivide(&c, level);
  var v = 0usize;
  while v < m.vertexCount() {
    m.positions.set(v, (*m.positions[v]).normalize() * r);
    v = v + 1usize;
  }
  m
}

fn torusSource(nu: usize, nv: usize, big: f32, small: f32) PolyMesh {
  var pos = List[Vec3].empty();
  var i = 0usize;
  while i < nu {
    var j = 0usize;
    while j < nv {
      let a = 2. * pi * f32.from(i) / f32.from(nu);
      let b = 2. * pi * f32.from(j) / f32.from(nv);
      let rr = big + small * cos(b);
      pos.push(Vec3(rr * cos(a), small * sin(b), rr * sin(a)));
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  var counts = List[u32].empty();
  var idx = List[u32].empty();
  i = 0usize;
  while i < nu {
    var j = 0usize;
    while j < nv {
      let i1 = (i + 1usize) % nu;
      let j1 = (j + 1usize) % nv;
      counts.push(4u32);
      idx.push(u32.from(i * nv + j));
      idx.push(u32.from(i * nv + j1));
      idx.push(u32.from(i1 * nv + j1));
      idx.push(u32.from(i1 * nv + j));
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  var problems = List[String].empty();
  let m = PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems);
  // wound outward? flip if the volume is negative
  m
}

// A box of n x n quads a face, centred, sx by sy by sz
fn boxSource(n: usize, sx: f32, sy: f32, sz: f32) PolyMesh {
  var pos = List[Vec3].empty();
  var ids = List[i32].empty();
  let side = n + 1usize;
  ids.resize(side * side * side, -1);
  var a = 0usize;
  while a < side {
    var b = 0usize;
    while b < side {
      var c = 0usize;
      while c < side {
        if a == 0usize || a == n || b == 0usize || b == n || c == 0usize || c == n {
          ids.set((a * side + b) * side + c, i32.from(pos.len()));
          pos.push(Vec3(sx * (f32.from(a) / f32.from(n) - 0.5), sy * (f32.from(b) / f32.from(n) - 0.5),
            sz * (f32.from(c) / f32.from(n) - 0.5)));
        }
        c = c + 1usize;
      }
      b = b + 1usize;
    }
    a = a + 1usize;
  }
  var counts = List[u32].empty();
  var idx = List[u32].empty();
  var face = 0;
  while face < 6 {
    // the face's fixed axis (0 x, 1 y, 2 z), its side, and axes u, v with u x v outward
    let axis = face / 2;
    let hi = face % 2 == 1;
    var u = 0usize;
    while u < n {
      var v = 0usize;
      while v < n {
        var quad = List[u32].empty();
        var k = 0;
        while k < 4 {
          let du = if k == 1 || k == 2 {1usize} else {0usize};
          let dv = if k == 2 || k == 3 {1usize} else {0usize};
          // axes: x-face uses (y, z); y-face (z, x); z-face (x, y)
          var ix = 0usize; var iy = 0usize; var iz = 0usize;
          if axis == 0 { ix = if hi {n} else {0usize}; iy = u + du; iz = v + dv; }
          elif axis == 1 { iy = if hi {n} else {0usize}; iz = u + du; ix = v + dv; }
          else { iz = if hi {n} else {0usize}; ix = u + du; iy = v + dv; }
          quad.push(u32.from(*ids[(ix * side + iy) * side + iz]));
          k = k + 1;
        }
        counts.push(4u32);
        if hi {
          idx.push(*quad[0usize]); idx.push(*quad[1usize]); idx.push(*quad[2usize]); idx.push(*quad[3usize]);
        } else {
          idx.push(*quad[3usize]); idx.push(*quad[2usize]); idx.push(*quad[1usize]); idx.push(*quad[0usize]);
        }
        v = v + 1usize;
      }
      u = u + 1usize;
    }
    face = face + 1;
  }
  var problems = List[String].empty();
  PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems)
}

fn volumeOf(pm: &PolyMesh) f64 {
  var vol = 0.;
  var f = 0usize;
  while f < pm.faceCount() {
    let vs = pm.faceVertices(u32.from(f));
    let p0 = *pm.positions[usize.from(*vs[0usize])];
    var k = 1usize;
    while k + 1usize < vs.len() {
      let p1 = *pm.positions[usize.from(*vs[k])];
      let p2 = *pm.positions[usize.from(*vs[k + 1usize])];
      vol = vol + p0.dot(p1.cross(p2)) / 6.;
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  f64.from(vol)
}

// ---------------------------------------------------------------- reports

fn printStats(label: &str, st: &QuadStats, r: &Remesh) {
  printStr(label);
  printStr(": faces "); print <- i64.from(st.faces);
  printStr(" quads "); print <- i64.from(st.quads);
  printStr(" ("); print <- f64.from(st.quadFraction * 100.); printStr("%) tris "); print <- i64.from(st.triangles);
  printStr(" ngons "); print <- i64.from(st.ngons);
  printStr(" verts "); print <- i64.from(st.vertices);
  printStr(" irregular "); print <- i64.from(st.irregular);
  printStr(" of "); print <- i64.from(st.interior);
  printStr(" boundary edges "); print <- i64.from(st.boundaryEdges);
  printStr("\n   hausdorff "); print <- f64.from(st.hausdorff);
  printStr(" ("); print <- f64.from(st.hausdorff / st.diagonal * 100.); printStr("% of diagonal) mean "); print <- f64.from(st.meanToSource);
  printStr(" minAngle "); print <- f64.from(st.minAngle);
  printStr(" poor "); print <- i64.from(st.poorQuads);
  printStr(" flipped "); print <- i64.from(st.flipped);
  printStr("\n   valence:");
  var i = 0usize;
  while i < st.valence.len() { printStr(" "); print <- i64.from(*st.valence[i]); i = i + 1usize; }
  printStr("\n   work "); print <- i64.from(r.workTriangles); printStr(" tris, levels "); print <- i64.from(r.levels);
  printStr(", field "); print <- r.fieldSeconds; printStr(" s, extract "); print <- r.extractSeconds;
  printStr(" s, finish "); print <- r.finishSeconds; printStr(" s; holes filled "); print <- i64.from(r.holesFilled);
  printStr(", polygons split "); print <- i64.from(r.polygonsSplit);
  printStr(", lattice error "); print <- f64.from(r.latticeError);
  printStr("\n");
  var p = 0usize;
  while p < r.problems.len() { printStr("   problem: "); printStr(r.problems[p].view()); printStr("\n"); p = p + 1usize; }
}

// ---------------------------------------------------------------- sheets

// A column: the source wireframe above, the result below, in one view
fn column(cv: &mut Canvas, x0: i32, w: i32, src: &PolyMesh, out: &PolyMesh, view: &View) {
  cv.tile(x0, 0, x0 + w, 720, Vec3(0.97, 0.97, 0.95));
  let fit = Fit.of(cv, &src.positions, view);
  drawMesh(cv, src, view, &fit, false, true, Vec3(0.35, 0.35, 0.40));
  cv.tile(x0, 720, x0 + w, 1440, Vec3(0.97, 0.97, 0.95));
  let fit2 = Fit.of(cv, &src.positions, view);
  drawMesh(cv, out, view, &fit2, true, false, Vec3(0.10, 0.10, 0.14));
}

fn basicShapes() bool {
  var ok = true;
  var cv = Canvas.make(2560, 1440);
  var sp = sphereSource(5u32, 1.);
  var o = RemeshOptions.withFaces(600u32);
  let r1 = quadRemesh(&sp, &o);
  let s1 = measure(&r1.mesh, &sp);
  printStats("sphere 600", &s1, &r1);
  column(&mut cv, 0, 640, &sp, &r1.mesh, &View(0.5, 0.3));
  let bx = boxSource(24usize, 1.6, 1., 1.);
  var o2 = RemeshOptions.withFaces(400u32);
  o2.creaseAngle = 0.6;
  let r2 = quadRemesh(&bx, &o2);
  let s2 = measure(&r2.mesh, &bx);
  printStats("box 400", &s2, &r2);
  column(&mut cv, 640, 640, &bx, &r2.mesh, &View(0.5, 0.35));
  let tr = torusSource(96usize, 48usize, 1., 0.4);
  var o3 = RemeshOptions.withFaces(800u32);
  let r3 = quadRemesh(&tr, &o3);
  let s3 = measure(&r3.mesh, &tr);
  printStats("torus 800", &s3, &r3);
  column(&mut cv, 1280, 640, &tr, &r3.mesh, &View(0.4, 0.8));
  let cy = sphereSource(5u32, 1.);
  var o4 = RemeshOptions.withFaces(2000u32);
  let r4 = quadRemesh(&cy, &o4);
  let s4 = measure(&r4.mesh, &cy);
  printStats("sphere 2000", &s4, &r4);
  column(&mut cv, 1920, 640, &cy, &r4.mesh, &View(0.5, 0.3));
  save(&cv, "quad-basic.png");
  if s1.boundaryEdges != 0u32 || s3.boundaryEdges != 0u32 { ok = false; }
  ok
}

// Source edges with both ends masked, as guide pairs
fn guidesFromMask(src: &PolyMesh, mask: &List[bool]) List[u32] {
  var g = List[u32].empty();
  var e = 0usize;
  while e < src.edgeCount() {
    let a = src.fromVertex(u32.from(2usize * e));
    let b = src.toVertex(u32.from(2usize * e));
    if *mask[usize.from(a)] && *mask[usize.from(b)] { g.push(a); g.push(b); }
    e = e + 1usize;
  }
  g
}

// How far a vertex's mirror image (in the plane axis = 0) is from the nearest vertex
fn symmetryError(pm: &PolyMesh, axis: u32) f32 {
  let idx = SurfaceIndex.of(pm);
  var worst = 0.f;
  var v = 0usize;
  while v < pm.vertexCount() {
    let p = *pm.positions[v];
    let m = if axis == 0u32 { Vec3(-p.x, p.y, p.z) } elif axis == 1u32 { Vec3(p.x, -p.y, p.z) } else { Vec3(p.x, p.y, -p.z) };
    let hit = idx.nearestVertex(m, 0.);
    if hit.tri != NoIndex && hit.distance > worst { worst = hit.distance; }
    v = v + 1usize;
  }
  worst
}

// Controls: density, guides, symmetry, creases
fn featureSheet() bool {
  var ok = true;
  var cv = Canvas.make(2560, 1440);
  // Density: finer on top
  var sp = sphereSource(5u32, 1.);
  let dch = sp.addFloatChannel(VertexDomain, "density", 1.);
  var v = 0usize;
  while v < sp.vertexCount() {
    sp.setFloat(dch, u32.from(v), 1. + 5. * fmax3((*sp.positions[v]).y, 0., 0.));
    v = v + 1usize;
  }
  var o = RemeshOptions.withFaces(900u32);
  o.density = String.from("density");
  let r1 = quadRemesh(&sp, &o);
  let s1 = measure(&r1.mesh, &sp);
  printStats("density", &s1, &r1);
  column(&mut cv, 0, 640, &sp, &r1.mesh, &View(0.5, 0.5));
  // A loop guide round the equator, tilted
  var sg = sphereSource(5u32, 1.);
  var mask = List[bool].empty();
  v = 0usize;
  while v < sg.vertexCount() {
    mask.push(absf((*sg.positions[v]).y - 0.2) < 0.0000001 || absf((*sg.positions[v]).y - 0.2) < 0.0000001);
    v = v + 1usize;
  }
  // the vertices nearest the circle y = 0.2 form the ring: take the ones within half an edge of it
  mask.clear();
  v = 0usize;
  while v < sg.vertexCount() {
    let p = *sg.positions[v];
    mask.push(absf(p.y - 0.2) < 0.012);
    v = v + 1usize;
  }
  var o2 = RemeshOptions.withFaces(500u32);
  o2.guides = guidesFromMask(&sg, &mask);
  let r2 = quadRemesh(&sg, &o2);
  let s2 = measure(&r2.mesh, &sg);
  printStats("loop guide", &s2, &r2);
  column(&mut cv, 640, 640, &sg, &r2.mesh, &View(0.5, 0.2));
  // Symmetry: a bean, remeshed whole and by its half and mirrored
  var bean = sphereSource(5u32, 1.);
  v = 0usize;
  while v < bean.vertexCount() {
    let p = *bean.positions[v];
    bean.positions.set(v, Vec3(p.x * 1.3, p.y * (1. + 0.25 * p.x * p.x) + 0.15 * p.x * p.x, p.z * 0.8));
    v = v + 1usize;
  }
  var o3 = RemeshOptions.withFaces(600u32);
  let r3 = quadRemesh(&bean, &o3);
  let s3 = measure(&r3.mesh, &bean);
  printStats("bean, no symmetry", &s3, &r3);
  printStr("   mirror error "); print <- f64.from(symmetryError(&r3.mesh, 0u32)); printStr("\n");
  column(&mut cv, 1280, 640, &bean, &r3.mesh, &View(0.5, 0.4));
  var o4 = RemeshOptions.withFaces(600u32);
  o4.symmetryAxis = 0i32;
  let r4 = quadRemesh(&bean, &o4);
  let s4 = measure(&r4.mesh, &bean);
  printStats("bean, symmetric in x", &s4, &r4);
  let se = symmetryError(&r4.mesh, 0u32);
  printStr("   mirror error "); print <- f64.from(se); printStr("\n");
  column(&mut cv, 1920, 640, &bean, &r4.mesh, &View(0.5, 0.4));
  save(&cv, "quad-controls.png");
  if s4.boundaryEdges != 0u32 || se > 0.00001 { ok = false; }
  ok
}

// ---------------------------------------------------------------- the creature

fn v3(x: f32, y: f32, z: f32) Vec3 { Vec3(x, y, z) }

fn partMesh(g: &SkinGraph) PolyMesh {
  let s = skinStandard(g);
  var f = subdivideSkin(&s, 1u32);
  var out = PolyMesh.empty();
  out <=> f.mesh;
  out
}

// Several skinmesh parts, joined and fused by a voxel remesh: a lumpy body
fn creatureSource(voxel: f32) PolyMesh {
  var parts = List[PolyMesh].empty();
  // body and legs
  var g = SkinGraph.empty();
  let hips = g.addNode(v3(0., 0.62, -0.50), 0.09, 0.10);
  g.setRoot(hips);
  let mid = g.grow(hips, v3(0., 0.68, 0.), 0.17, 0.15);
  let shoulders = g.grow(mid, v3(0., 0.68, 0.50), 0.10, 0.11);
  var side = -1.f;
  var s = 0;
  while s < 2 {
    let elbow = g.grow(shoulders, v3(side * 0.28, 0.36, 0.52), 0.06, 0.06);
    let wrist = g.grow(elbow, v3(side * 0.24, 0.13, 0.54), 0.04, 0.04);
    g.grow(wrist, v3(side * 0.24, 0.03, 0.62), 0.045, 0.035);
    let knee = g.grow(hips, v3(side * 0.30, 0.34, -0.40), 0.07, 0.07);
    let hock = g.grow(knee, v3(side * 0.24, 0.18, -0.64), 0.04, 0.04);
    g.grow(hock, v3(side * 0.24, 0.03, -0.54), 0.045, 0.035);
    side = 1.;
    s = s + 1;
  }
  parts.push(partMesh(&g));
  // neck and head
  var h = SkinGraph.empty();
  let n0 = h.addNode(v3(0., 0.74, 0.40), 0.10, 0.10);
  h.setRoot(n0);
  let n1 = h.grow(n0, v3(0., 0.84, 0.80), 0.09, 0.09);
  let hd = h.grow(n1, v3(0., 0.88, 1.00), 0.08, 0.09);
  h.grow(hd, v3(0., 0.80, 1.20), 0.05, 0.05);
  parts.push(partMesh(&h));
  // tail
  var t = SkinGraph.empty();
  let t0 = t.addNode(v3(0., 0.64, -0.40), 0.06, 0.06);
  t.setRoot(t0);
  let t1 = t.grow(t0, v3(0., 0.66, -0.80), 0.045, 0.045);
  let t2 = t.grow(t1, v3(0., 0.62, -1.05), 0.035, 0.035);
  t.grow(t2, v3(0., 0.74, -1.28), 0.02, 0.02);
  parts.push(partMesh(&t));
  // two horns
  side = -1.;
  s = 0;
  while s < 2 {
    var e = SkinGraph.empty();
    let e0 = e.addNode(v3(side * 0.05, 0.92, 0.96), 0.03, 0.03);
    e.setRoot(e0);
    let e1 = e.grow(e0, v3(side * 0.14, 1.08, 0.90), 0.025, 0.025);
    e.grow(e1, v3(side * 0.18, 1.22, 0.82), 0.012, 0.012);
    parts.push(partMesh(&e));
    side = 1.;
    s = s + 1;
  }
  var problems = List[String].empty();
  let joined = join(&parts, &mut problems);
  voxelRemesh(&joined, voxel, &mut problems)
}

fn creatureSheet() bool {
  var ok = true;
  var cv = Canvas.make(2560, 1440);
  let src = creatureSource(0.022);
  printStr("creature source: faces "); print <- i64.from(src.faceCount()); printStr("\n");
  let view = View(0.7, 0.2);
  cv.tile(0, 0, 1280, 720, Vec3(0.97, 0.97, 0.95));
  let fit = Fit.of(&cv, &src.positions, &view);
  drawMesh(&mut cv, &src, &view, &fit, false, false, Vec3(0.55, 0.55, 0.6));
  var o = RemeshOptions.withFaces(2000u32);
  o.creaseAngle = 0.;
  let r1 = quadRemesh(&src, &o);
  let s1 = measure(&r1.mesh, &src);
  printStats("creature 2k", &s1, &r1);
  cv.tile(0, 720, 1280, 1440, Vec3(0.97, 0.97, 0.95));
  drawMesh(&mut cv, &r1.mesh, &view, &Fit.of(&cv, &src.positions, &view), true, false, Vec3(0.10, 0.10, 0.14));
  var o2 = RemeshOptions.withFaces(8000u32);
  let r2 = quadRemesh(&src, &o2);
  let s2 = measure(&r2.mesh, &src);
  printStats("creature 8k", &s2, &r2);
  cv.tile(1280, 0, 2560, 720, Vec3(0.97, 0.97, 0.95));
  drawMesh(&mut cv, &src, &View(-0.9, 0.35), &Fit.of(&cv, &src.positions, &View(-0.9, 0.35)), false, false, Vec3(0.55, 0.55, 0.6));
  cv.tile(1280, 720, 2560, 1440, Vec3(0.97, 0.97, 0.95));
  drawMesh(&mut cv, &r2.mesh, &View(-0.9, 0.35), &Fit.of(&cv, &src.positions, &View(-0.9, 0.35)), false, false, Vec3(0.10, 0.10, 0.14));
  save(&cv, "quad-creature.png");
  if s1.boundaryEdges != 0u32 || s2.boundaryEdges != 0u32 { ok = false; }
  ok
}

// ---------------------------------------------------------------- the head

fn parseF(s: &str) f32 {
  let t: &Array[u8] = s;
  var i = 0usize;
  var neg = false;
  if t.len > 0usize && t[0usize] == '-' { neg = true; i = 1usize; }
  var whole = 0.0;
  while i < t.len && t[i] >= '0' && t[i] <= '9' {
    whole = whole * 10.0 + f64.from(i32.from(t[i]) - 48);
    i = i + 1usize;
  }
  var scale = 0.1;
  if i < t.len && t[i] == '.' {
    i = i + 1usize;
    while i < t.len && t[i] >= '0' && t[i] <= '9' {
      whole = whole + scale * f64.from(i32.from(t[i]) - 48);
      scale = scale * 0.1;
      i = i + 1usize;
    }
  }
  f32.from(if neg { -whole } else { whole })
}

// The faces of base.obj's "body" group whose vertices all lie above y = neck,
// as a PolyMesh (read here, never copied)
fn loadHead(file: &str, neck: f32) PolyMesh {
  var text = String.empty();
  let fp = FilePath.from(file);
  match fs.readFile(&fp) {
    case Ok(var r) { text <=> r; }
    case Error(e) {}
  }
  var pos = List[Vec3].empty();
  var fc = List[u32].empty();
  var fi = List[u32].empty();
  var inBody = false;
  let lines = text.lines();
  var li = 0usize;
  while li < lines.len() {
    let ln = lines[li].view();
    let bytes: &Array[u8] = ln;
    if bytes.len > 2usize && bytes[0usize] == 'v' && bytes[1usize] == ' ' {
      let parts = lines[li].split(' ');
      var vals = List[f32].empty();
      var k = 1usize;
      while k < parts.len() { if parts[k].len() > 0usize { vals.push(parseF(parts[k].view())); } k = k + 1usize; }
      if vals.len() >= 3usize { pos.push(Vec3(*vals[0usize], *vals[1usize], *vals[2usize])); }
    } elif bytes.len > 2usize && bytes[0usize] == 'g' && bytes[1usize] == ' ' {
      inBody = ln == "g body";
    } elif inBody && bytes.len > 2usize && bytes[0usize] == 'f' && bytes[1usize] == ' ' {
      let parts = lines[li].split(' ');
      var vs = List[u32].empty();
      var k = 1usize;
      while k < parts.len() {
        if parts[k].len() > 0usize {
          let sub = parts[k].split('/');
          let n = parseInt(sub[0usize].view());
          match n {
            case Some(some) { vs.push(u32.from(some - 1i64)); }
            case None {}
          }
        }
        k = k + 1usize;
      }
      var allUp = vs.len() >= 3usize;
      k = 0usize;
      while k < vs.len() { if (*pos[usize.from(*vs[k])]).y < neck { allUp = false; } k = k + 1usize; }
      if allUp {
        fc.push(u32.from(vs.len()));
        k = 0usize;
        while k < vs.len() { fi.push(*vs[k]); k = k + 1usize; }
      }
    }
    li = li + 1usize;
  }
  // compact the vertices
  var map = List[u32].empty();
  map.resize(pos.len(), NoIndex);
  var np = List[Vec3].empty();
  var ni = List[u32].empty();
  var i = 0usize;
  while i < fi.len() {
    let v = usize.from(*fi[i]);
    if *map[v] == NoIndex { map.set(v, u32.from(np.len())); np.push(*pos[v]); }
    ni.push(*map[v]);
    i = i + 1usize;
  }
  var problems = List[String].empty();
  PolyMesh.fromPolygons(np.view(), fc.view(), ni.view(), &mut problems)
}

// Vertices that sit near another surface of the mesh but far from it along the
// mesh: the sealed slits of the lids and the lips
fn slitMask(m: &PolyMesh, close: f32, hops: usize) List[bool] {
  var mask = List[bool].empty();
  var v = 0usize;
  while v < m.vertexCount() {
    // vertices within 'hops' edges of v
    var near = List[u32].empty();
    near.push(u32.from(v));
    var frontier = List[u32].empty();
    frontier.push(u32.from(v));
    var h = 0usize;
    while h < hops {
      var next = List[u32].empty();
      var f = 0usize;
      while f < frontier.len() {
        let nb = m.vertexNeighbors(*frontier[f]);
        var k = 0usize;
        while k < nb.len() {
          var seen = false;
          var q = 0usize;
          while q < near.len() { if *near[q] == *nb[k] { seen = true; } q = q + 1usize; }
          if !seen { near.push(*nb[k]); next.push(*nb[k]); }
          k = k + 1usize;
        }
        f = f + 1usize;
      }
      frontier = next;
      h = h + 1usize;
    }
    var hit = false;
    let p = *m.positions[v];
    var w = 0usize;
    while w < m.vertexCount() && !hit {
      if (*m.positions[w] - p).lengthSquared() < close * close {
        var isNear = false;
        var q = 0usize;
        while q < near.len() { if usize.from(*near[q]) == w { isNear = true; } q = q + 1usize; }
        if !isNear { hit = true; }
      }
      w = w + 1usize;
    }
    mask.push(hit);
    v = v + 1usize;
  }
  mask
}

fn headSheet() bool {
  var ok = true;
  let head = loadHead("C:/src/reference-models/makehuman/base.obj", 6.2);
  printStr("head: vertices "); print <- i64.from(head.vertexCount()); printStr(" faces "); print <- i64.from(head.faceCount()); printStr("\n");
  if head.faceCount() == 0usize { printStr("no head read\n"); return true; }
  let mask = slitMask(&head, 0.03, 3usize);
  var slit = 0usize;
  var v = 0usize;
  while v < mask.len() { if *mask[v] { slit = slit + 1usize; } v = v + 1usize; }
  printStr("slit vertices "); print <- i64.from(slit); printStr("\n");
  var o1 = RemeshOptions.withFaces(2500u32);
  let r1 = quadRemesh(&head, &o1);
  let s1 = measure(&r1.mesh, &head);
  printStats("head, no guides", &s1, &r1);
  var o2 = RemeshOptions.withFaces(2500u32);
  o2.guides = guidesFromMask(&head, &mask);
  let r2 = quadRemesh(&head, &o2);
  let s2 = measure(&r2.mesh, &head);
  printStats("head, eye and mouth loop guides", &s2, &r2);
  var cv = Canvas.make(2560, 1440);
  let view = View(0., 0.05);
  var k = 0;
  while k < 3 {
    let x0 = k * 853;
    cv.tile(x0, 0, x0 + 853, 1440, Vec3(0.97, 0.97, 0.95));
    let fit = Fit.of(&cv, &head.positions, &view);
    if k == 0 { drawMesh(&mut cv, &head, &view, &fit, false, true, Vec3(0.30, 0.30, 0.36)); }
    elif k == 1 { drawMesh(&mut cv, &r1.mesh, &view, &fit, true, false, Vec3(0.10, 0.10, 0.14)); }
    else { drawMesh(&mut cv, &r2.mesh, &view, &fit, true, false, Vec3(0.10, 0.10, 0.14)); }
    k = k + 1;
  }
  save(&cv, "quad-head.png");
  ok
}

// Timing on inputs of about 50k and 200k triangles (a sphere's, and a torus's)
fn timing() bool {
  var ok = true;
  var round = 0;
  while round < 4 {
    let src = if round == 0 { sphereSource(6u32, 1.) } elif round == 1 { sphereSource(7u32, 1.) }
      elif round == 2 { torusSource(256usize, 96usize, 1., 0.4) } else { torusSource(512usize, 196usize, 1., 0.4) };
    let faces = if round % 2 == 0 { 5000u32 } else { 20000u32 };
    var o = RemeshOptions.withFaces(faces);
    let t0 = Instant.now();
    let r = quadRemesh(&src, &o);
    let total = t0.elapsed().secondsF64();
    let tris = r.workTriangles;
    printStr("timing: input "); print <- i64.from(src.faceCount() * 2usize); printStr(" tris -> "); print <- i64.from(faces);
    printStr(" faces: total "); print <- total; printStr(" s (fields "); print <- r.fieldSeconds;
    printStr(", extract "); print <- r.extractSeconds; printStr(", finish "); print <- r.finishSeconds;
    printStr("), result faces "); print <- i64.from(r.mesh.faceCount()); printStr("\n");
    let st = measure(&r.mesh, &src);
    printStats("  quality", &st, &r);
    if tris == 0u32 { ok = false; }
    round = round + 1;
  }
  ok
}

fn main() i32 {
  let dir = FilePath.from("C:/src/quadremesh-shots");
  fs.makeDirAll(&dir);
  var ok = true;
  ok = basicShapes() && ok;
  ok = featureSheet() && ok;
  ok = creatureSheet() && ok;
  ok = headSheet() && ok;
  ok = timing() && ok;
  if ok {0} else {1}
}
