// ======== The remesher ========

// What to ask for. Make one with 'RemeshOptions.faces' or '.edge', then set
// what else is wanted.
pub struct RemeshOptions {
  pub faces: u32;                // the face count aimed at (0: use edgeLength)
  pub edgeLength: f32;           // the output's edge length (0: from 'faces')
  pub creaseAngle: f32;          // radians; edges whose faces turn more are creases (0: none)
  pub creaseChannel: bool;       // edges with "crease" above 0 are creases
  pub guides: List[u32];         // pairs of source vertices joined by an edge the field must follow
  pub density: String;           // a vertex channel of relative density ("": even)
  pub symmetryAxis: i32;         // mirror plane normal: 0 x, 1 y, 2 z; -1 none
  pub symmetryOffset: f32;       // where the plane cuts that axis
  pub orientIterations: u32;     // smoothing passes at the finest level
  pub positionIterations: u32;
  pub relax: u32;                // tangent smoothing passes of the result
  pub tolerance: f32;            // how far a lattice may disagree and still settle (in steps)
  pub maxPolygon: u32;           // larger faces than this are dropped as holes
  pub project: bool;             // lay the result on the source
  pub carry: bool;               // carry the source's channels

  pub fn withFaces(n: u32) RemeshOptions {
    RemeshOptions(n, 0., 0., false, List[u32].empty(), String.empty(), -1i32, 0., 5u32, 6u32, 2u32, 0.3, 8u32, true, true)
  }

  pub fn withEdge(len: f32) RemeshOptions {
    RemeshOptions(0u32, len, 0., false, List[u32].empty(), String.empty(), -1i32, 0., 5u32, 6u32, 2u32, 0.3, 8u32, true, true)
  }

  // A guide: an edge of the source, (a, b) vertex numbers
  pub fn addGuide(self: &mut, a: u32, b: u32) { guides.push(a); guides.push(b); }

  // The path of source vertices (each a neighbour of the one before) as guides
  pub fn addGuidePath(self: &mut, path: &List[u32], closed: bool) {
    var i = 0usize;
    while i + 1usize < path.len() { guides.push(*path[i]); guides.push(*path[i + 1usize]); i = i + 1usize; }
    if closed && path.len() > 2usize { guides.push(*path[path.len() - 1usize]); guides.push(*path[0usize]); }
  }
}

// The remesh and what it took
pub struct Remesh {
  pub mesh: PolyMesh;
  pub edgeLength: f32;           // the lattice spacing used
  pub problems: List[String];
  pub workVertices: u32;         // the working mesh (source cut into triangles, long edges split)
  pub workTriangles: u32;
  pub levels: u32;
  pub extracted: u32;            // faces read straight off the graph
  pub polygonsSplit: u32;        // larger faces cut into quads
  pub holesFilled: u32;
  pub clusters: u32;             // output vertices the fields settled on
  pub graphEdges: u32;           // edges between them
  pub merged: u32;               // source edges that joined two input vertices into one output vertex
  pub stepped: u32;              // source edges that stepped one lattice cell
  pub unsettled: u32;            // source edges the fields left undecided
  pub orientError: f32;          // mean angle between neighbouring orientations (radians)
  pub latticeError: f32;         // mean disagreement of neighbouring lattices (in steps)
  pub fieldSeconds: f64;       // hierarchy and the two fields
  pub extractSeconds: f64;
  pub finishSeconds: f64;        // assembling, settling, carrying channels
}

fn constraints(w: &Work, nrm: &List[Vec3], cori: &mut List[Vec3], ckind: &mut List[u32], vfeat: &mut List[u32]) {
  let n = w.pos.len();
  var cnt = List[u32].withCapacity(n);
  var nb = List[u32].withCapacity(n * 4usize);
  var i = 0usize;
  while i < n { cnt.push(0u32); vfeat.push(0u32); cori.push(zero3()); ckind.push(0u32); i = i + 1usize; }
  nb.resize(n * 4usize, NoVertex);
  i = 0usize;
  while i < w.fa.len() {
    let a = usize.from(*w.fa[i]);
    let b = usize.from(*w.fb[i]);
    vfeat.set(a, *vfeat[a] | *w.fk[i]);
    vfeat.set(b, *vfeat[b] | *w.fk[i]);
    if *cnt[a] < 4u32 { nb.set(a * 4usize + usize.from(*cnt[a]), u32.from(b)); }
    if *cnt[b] < 4u32 { nb.set(b * 4usize + usize.from(*cnt[b]), u32.from(a)); }
    cnt.set(a, *cnt[a] + 1u32);
    cnt.set(b, *cnt[b] + 1u32);
    i = i + 1usize;
  }
  i = 0usize;
  while i < n {
    let c = *cnt[i];
    if c > 0u32 {
      let p = *w.pos[i];
      let nn = *nrm[i];
      var kind = 2u32;
      var dir = zero3();
      if c == 1u32 {
        dir = toTangent(nn, *w.pos[usize.from(*nb[i * 4usize])] - p);
        kind = 1u32;
      } elif c == 2u32 {
        let u1 = unit(*w.pos[usize.from(*nb[i * 4usize])] - p);
        let u2 = unit(*w.pos[usize.from(*nb[i * 4usize + 1usize])] - p);
        if u1.dot(-u2) > 0.64 {
          dir = toTangent(nn, u1 - u2);
          kind = 1u32;
        }
      }
      if kind == 1u32 && isZero3(dir) { kind = 2u32; }
      cori.set(i, dir);
      ckind.set(i, kind);
    }
    i = i + 1usize;
  }
}

// The density-weighted area of the triangles
fn weightedArea(w: &Work) f32 {
  var sum = 0.f;
  var t = 0usize;
  while t < w.idx.len() {
    let a = usize.from(*w.idx[t]);
    let b = usize.from(*w.idx[t + 1usize]);
    let c = usize.from(*w.idx[t + 2usize]);
    let ar = 0.5 * (*w.pos[b] - *w.pos[a]).cross(*w.pos[c] - *w.pos[a]).length();
    sum = sum + ar * (*w.dens[a] + *w.dens[b] + *w.dens[c]) / 3.;
    t = t + 3usize;
  }
  sum
}

fn seconds(i: Instant) f64 { i.elapsed().secondsF64() }

// The source remeshed as quads. See the top of the file for the method and the
// options.
pub fn quadRemesh(src: &PolyMesh, opt: &RemeshOptions) Remesh {
  var problems = List[String].empty();
  let t0 = Instant.now();
  var w = workFrom(src, opt.creaseAngle, opt.creaseChannel, &opt.guides, opt.density.view());
  let sym = opt.symmetryAxis >= 0i32;
  let axis = if sym { u32.from(opt.symmetryAxis) } else { 0u32 };
  if sym { w = clipHalf(&w, axis, opt.symmetryOffset, true); }
  // The density relative to its mean, held to a sixteenfold range
  var dsum = 0.f;
  var i = 0usize;
  while i < w.dens.len() { dsum = dsum + *w.dens[i]; i = i + 1usize; }
  let dmean = if w.dens.len() > 0usize { dsum / f32.from(w.dens.len()) } else { 1. };
  var dmax = 0.0625f;
  i = 0usize;
  while i < w.dens.len() {
    w.dens.set(i, clampf(*w.dens[i] / dmean, 0.0625, 16.));
    if *w.dens[i] > dmax { dmax = *w.dens[i]; }
    i = i + 1usize;
  }
  // The lattice spacing: area over faces, with the density
  let wantFaces = if sym { f32.from(opt.faces) * 0.5 } else { f32.from(opt.faces) };
  var rho0 = opt.edgeLength;
  if rho0 <= 0. { rho0 = (weightedArea(&w) / maxf(wantFaces, 4.)).sqrt(); }
  splitLong(&mut w, 0.3 * rho0 / dmax.sqrt());
  markBoundary(&mut w);
  let lines = Lines.of(&w);
  // Level 0
  var nrm = List[Vec3].empty();
  var area = List[f32].empty();
  vertexData(&w, &mut nrm, &mut area);
  var cori = List[Vec3].empty();
  var ckind = List[u32].empty();
  var vfeat = List[u32].empty();
  constraints(&w, &nrm, &mut cori, &mut ckind, &mut vfeat);
  var rho = List[f32].withCapacity(w.pos.len());
  i = 0usize;
  while i < w.pos.len() { rho.push(rho0 / (*w.dens[i]).sqrt()); i = i + 1usize; }
  let first = Level(copyOf[Vec3](&w.pos), nrm, area, rho, meshGraph(&w), cori, ckind);
  // The hierarchy
  var levels = List[Level].empty();
  var ups = List[List[u32]].empty();
  levels.push(first);
  while true {
    let tp = levels.len() - 1usize;
    if levels[tp].count() <= 24usize { break; }
    let cr = coarsen(levels[tp], &mut ups);
    if f32.from(cr.count()) > 0.93 * f32.from(levels[tp].count()) { ups.pop(); break; }
    levels.push(cr);
  }
  let top = levels.len() - 1usize;
  // The orientation field, kept at each level (coarsest first)
  var oriRev = List[List[Vec3]].empty();
  var ori = initOrientation(levels[top]);
  smoothOrientation(levels[top], &mut ori, 10u32);
  oriRev.push(copyOf[Vec3](&ori));
  var k = top;
  while k > 0usize {
    k = k - 1usize;
    ori = upsampleOrientation(levels[k], ups[k], &ori);
    smoothOrientation(levels[k], &mut ori, if k == 0usize { opt.orientIterations } else { 8u32 });
    oriRev.push(copyOf[Vec3](&ori));
  }
  // The position field, from the coarsest
  var q = initPosition(levels[top], oriRev[0usize]);
  smoothPosition(levels[top], oriRev[0usize], &mut q, 10u32);
  k = top;
  while k > 0usize {
    k = k - 1usize;
    let ok = oriRev[top - k];
    q = upsamplePosition(levels[k], ups[k], &q, ok);
    smoothPosition(levels[k], ok, &mut q, if k == 0usize { opt.positionIterations } else { 8u32 });
  }
  var orientError = 0.f;
  var latticeError = 0.f;
  fieldError(levels[0usize], oriRev[top], &q, &mut orientError, &mut latticeError);
  let fieldSeconds = seconds(t0);
  let t1 = Instant.now();
  // The quads
  let qd = extract(levels[0usize], oriRev[top], &q, &vfeat, opt.tolerance, usize.from(opt.maxPolygon));
  let extractSeconds = seconds(t1);
  let t2 = Instant.now();
  var splits = 0usize;
  var qm = assemble(&qd, &mut splits);
  let extracted = qd.faceCount();
  let idx = SurfaceIndex.of(src);
  let off = opt.symmetryOffset;
  var filled = 0usize;
  if sym {
    // the vertices on the cut are held on the plane
    i = 0usize;
    while i < qm.pos.len() {
      let p = *qm.pos[i];
      if (*qm.flag[i] & FeatBoundary) != 0u32 && absf(coord(p, axis) - off) < 0.4 * *qm.rho[i] {
        qm.flag.set(i, *qm.flag[i] | FlagOnPlane);
      }
      i = i + 1usize;
    }
  } else {
    filled = fillHoles(&mut qm, &idx, 10usize, &mut splits);
  }
  if !sym { pairTriangles(&mut qm); }
  var pm = toPoly(&qm, &mut problems);
  settle(&mut pm, &qm.flag, &idx, &lines, opt.relax, opt.symmetryAxis, off, opt.project);
  if sym {
    i = 0usize;
    while i < qm.pos.len() { qm.pos.set(i, *pm.positions[i]); i = i + 1usize; }
    qm = mirrorJoin(&qm, axis, off);
    let kept = qm.pos.len();
    filled = fillHoles(&mut qm, &idx, 10usize, &mut splits);
    pairTriangles(&mut qm);
    pm = toPoly(&qm, &mut problems);
    // the vertices made for filled holes onto the surface; the others stay as
    // mirrored (a triangulated source is not quite symmetric, and would move
    // the two halves differently)
    let before = copyOf[Vec3](&pm.positions);
    settle(&mut pm, &qm.flag, &idx, &lines, 0u32, -1i32, 0., opt.project);
    i = 0usize;
    while i < kept { pm.positions.set(i, *before[i]); i = i + 1usize; }
  }
  if opt.carry {
    let map = TransferMap.all(MapInterpolated);
    pm = dataTransfer(&pm, src, &map, &mut problems);
  }
  if opt.creaseAngle > 0. || opt.creaseChannel {
    markCreases(&mut pm, &qm.flag, &lines, &qm.rho);
  }
  Remesh(pm, rho0, problems, u32.from(levels[0usize].count()), u32.from(w.triCount()), u32.from(levels.len()),
    u32.from(extracted), u32.from(splits), u32.from(filled), u32.from(qd.clusters), u32.from(qd.edges),
    u32.from(qd.merges), u32.from(qd.steps), u32.from(qd.ignored), orientError, latticeError, fieldSeconds, extractSeconds, seconds(t2))
}

// Edges along a crease get 1 in the "crease" edge channel (so that subdivision
// keeps them sharp): both ends on a crease or boundary line, the middle on it
fn markCreases(pm: &mut PolyMesh, flag: &List[u32], lines: &Lines, rho: &List[f32]) {
  var ch = pm.findFloatChannel(EdgeDomain, "crease");
  if ch == NoIndex { ch = pm.addFloatChannel(EdgeDomain, "crease", 0.); }
  var e = 0usize;
  while e < pm.edgeCount() {
    let a = usize.from(pm.fromVertex(u32.from(2usize * e)));
    let b = usize.from(pm.toVertex(u32.from(2usize * e)));
    if a < flag.len() && b < flag.len() && (*flag[a] & FeatCrease) != 0u32 && (*flag[b] & FeatCrease) != 0u32 {
      let mid = (*pm.positions[a] + *pm.positions[b]) * 0.5;
      let c = lines.nearest(mid, FeatCrease);
      if (c - mid).length() < 0.2 * *rho[a] { pm.setFloat(ch, u32.from(e), 1.); }
    }
    e = e + 1usize;
  }
}
