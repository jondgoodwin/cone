// quadremesh's remesher, checked on synthetic shapes with the testing package;
// only a failure prints, so remeshes.out holds the summary alone.
//
// - 'measure' on a cube cage: 6 quads, 8 vertices of valence 3, closed, and the
//   cage near itself.
// - A sphere (a subdivided cube pushed out to radius 1) remeshed to 600 faces:
//   closed and manifold, the face count within a quarter of the aim, nine in ten
//   faces quads, the result within 3% of the radius from the sphere both ways, no
//   face turned inside out, and a vertex channel ("tag", the source x) carried.
//   The same options twice give the same bits.
// - A box with creases (angle 0.6): the result lies on the box (to 1e-4), has a
//   vertex at each of the 8 corners, and its crease edges are marked in "crease".
// - Symmetry in x on a lopsided bean: closed, and every vertex's mirror image
//   has a vertex within 1e-5.
// - A density channel 1 below and 6 above y = 0: the upper half gets at least
//   twice the faces of the lower.
// - A guide round y = 0.2 on a sphere: more of the result's vertices lie on that
//   circle than without the guide.
// - An open grid: the result keeps the boundary (boundary edges exist, every
//   boundary vertex on the grid's edge) and stays in the plane.
// - Aiming by edge length: an edge of 0.2 on the unit sphere gives about
//   4 pi / 0.04 faces.

mod remeshes;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;
import quadremesh use *;

fn sphere(level: u32) PolyMesh {
  let c = PolyMesh.cube(1.);
  var m = subdivide(&c, level);
  var v = 0usize;
  while v < m.vertexCount() {
    m.positions.set(v, (*m.positions[v]).normalize());
    v = v + 1usize;
  }
  m
}

fn grid(n: usize) PolyMesh {
  var pos = List[Vec3].empty();
  var y = 0usize;
  while y <= n {
    var x = 0usize;
    while x <= n {
      pos.push(new Vec3(f32.from(x) / f32.from(n), f32.from(y) / f32.from(n), 0.));
      x = x + 1usize;
    }
    y = y + 1usize;
  }
  var counts = List[u32].empty();
  var idx = List[u32].empty();
  y = 0usize;
  while y < n {
    var x = 0usize;
    while x < n {
      counts.push(4u32);
      idx.push(u32.from(y * (n + 1usize) + x));
      idx.push(u32.from(y * (n + 1usize) + x + 1usize));
      idx.push(u32.from((y + 1usize) * (n + 1usize) + x + 1usize));
      idx.push(u32.from((y + 1usize) * (n + 1usize) + x));
      x = x + 1usize;
    }
    y = y + 1usize;
  }
  var problems = List[String].empty();
  PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems)
}

fn box(n: usize) PolyMesh {
  var pos = List[Vec3].empty();
  var ids = List[i32].empty();
  let side = n + 1usize;
  ids.resize(side * side * side, -1);
  var a = 0usize;
  while a < side {
    var b = 0usize;
    while b < side {
      var c = 0usize;
      while c < side {
        if a == 0usize || a == n || b == 0usize || b == n || c == 0usize || c == n {
          ids.set((a * side + b) * side + c, i32.from(pos.len()));
          pos.push(new Vec3(1.6 * (f32.from(a) / f32.from(n) - 0.5), f32.from(b) / f32.from(n) - 0.5, f32.from(c) / f32.from(n) - 0.5));
        }
        c = c + 1usize;
      }
      b = b + 1usize;
    }
    a = a + 1usize;
  }
  var counts = List[u32].empty();
  var idx = List[u32].empty();
  var face = 0;
  while face < 6 {
    let axis = face / 2;
    let hi = face % 2 == 1;
    var u = 0usize;
    while u < n {
      var v = 0usize;
      while v < n {
        var quad = List[u32].empty();
        var k = 0;
        while k < 4 {
          let du = if k == 1 || k == 2 {1usize} else {0usize};
          let dv = if k == 2 || k == 3 {1usize} else {0usize};
          var ix = 0usize; var iy = 0usize; var iz = 0usize;
          if axis == 0 { ix = if hi {n} else {0usize}; iy = u + du; iz = v + dv; }
          elif axis == 1 { iy = if hi {n} else {0usize}; iz = u + du; ix = v + dv; }
          else { iz = if hi {n} else {0usize}; ix = u + du; iy = v + dv; }
          quad.push(u32.from(*ids[(ix * side + iy) * side + iz]));
          k = k + 1;
        }
        counts.push(4u32);
        if hi { idx.push(*quad[0usize]); idx.push(*quad[1usize]); idx.push(*quad[2usize]); idx.push(*quad[3usize]); }
        else { idx.push(*quad[3usize]); idx.push(*quad[2usize]); idx.push(*quad[1usize]); idx.push(*quad[0usize]); }
        v = v + 1usize;
      }
      u = u + 1usize;
    }
    face = face + 1;
  }
  var problems = List[String].empty();
  PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems)
}

fn absf(a: f32) f32 { if a < 0. {-a} else {a} }

fn sound(m: &PolyMesh, label: &Array[u8]) {
  expectInt(i64.from(m.validate().len()), 0i64, label);
}

fn samePositions(a: &PolyMesh, b: &PolyMesh) bool {
  if a.vertexCount() != b.vertexCount() || a.faceCount() != b.faceCount() { return false; }
  var v = 0usize;
  while v < a.vertexCount() {
    if !(*a.positions[v]).equals(*b.positions[v]) { return false; }
    v = v + 1usize;
  }
  true
}

fn main() i32 {
  // measure on a cube cage
  let cage = PolyMesh.cube(1.);
  let cs = measure(&cage, &cage);
  expectInt(i64.from(cs.faces), 6i64, "cage faces");
  expectInt(i64.from(cs.quads), 6i64, "cage quads");
  expectInt(i64.from(*cs.valence[3usize]), 8i64, "cage vertices of valence 3");
  expectInt(i64.from(cs.boundaryEdges), 0i64, "cage closed");
  expectFloat(f64.from(cs.hausdorff), 0., 0.00001, "cage against itself");

  // a sphere
  var sp = sphere(5u32);
  let tag = sp.addFloatChannel(VertexDomain, "tag", 0.);
  var v = 0usize;
  while v < sp.vertexCount() { sp.setFloat(tag, u32.from(v), (*sp.positions[v]).x); v = v + 1usize; }
  var o = RemeshOptions.withFaces(600u32);
  let r = quadRemesh(&sp, &o);
  sound(&r.mesh, "sphere valid");
  let st = measure(&r.mesh, &sp);
  expectInt(i64.from(st.boundaryEdges), 0i64, "sphere result closed");
  expect(st.faces > 450u32 && st.faces < 750u32, "sphere face count near the aim");
  expect(st.quadFraction > 0.9, "sphere nine in ten quads");
  expect(st.hausdorff < 0.03, "sphere within 3% of the radius");
  expectInt(i64.from(st.flipped), 0i64, "sphere no face inside out");
  expectInt(i64.from(r.problems.len()), 0i64, "sphere no problems");
  let tc = r.mesh.findFloatChannel(VertexDomain, "tag");
  expect(tc != NoIndex, "sphere carries the tag");
  var worst = 0.f;
  v = 0usize;
  if tc != NoIndex {
    while v < r.mesh.vertexCount() {
      let d = absf(r.mesh.float(tc, u32.from(v)) - (*r.mesh.positions[v]).x);
      if d > worst { worst = d; }
      v = v + 1usize;
    }
  }
  expect(worst < 0.03, "the tag follows x");
  let r2 = quadRemesh(&sp, &o);
  expect(samePositions(&r.mesh, &r2.mesh), "the same options give the same bits");

  // a creased box
  let bx = box(24usize);
  var ob = RemeshOptions.withFaces(400u32);
  ob.creaseAngle = 0.6;
  let rb = quadRemesh(&bx, &ob);
  sound(&rb.mesh, "box valid");
  let sb = measure(&rb.mesh, &bx);
  expectFloat(f64.from(sb.hausdorff), 0., 0.0001, "box result on the box");
  expectFloat(f64.from(sb.toSource), 0., 0.0001, "box to source");
  expectFloat(f64.from(sb.fromSource), 0., 0.0001, "box from source");
  var corners = 0;
  var cx = 0;
  while cx < 8 {
    let c = new Vec3(if cx % 2 == 0 {-0.8} else {0.8}, if (cx / 2) % 2 == 0 {-0.5} else {0.5}, if cx / 4 == 0 {-0.5} else {0.5});
    var best = 100.f;
    var w = 0usize;
    while w < rb.mesh.vertexCount() {
      let d = (*rb.mesh.positions[w] - c).length();
      if d < best { best = d; }
      w = w + 1usize;
    }
    if best < 0.0001 { corners = corners + 1; }
    cx = cx + 1;
  }
  expectInt(i64.from(corners), 8i64, "box corners kept");
  let cr = rb.mesh.findFloatChannel(EdgeDomain, "crease");
  var marked = 0;
  if cr != NoIndex {
    var e = 0usize;
    while e < rb.mesh.edgeCount() { if rb.mesh.float(cr, u32.from(e)) > 0. { marked = marked + 1; } e = e + 1usize; }
  }
  expect(marked >= 12, "box crease edges marked");

  // symmetry
  var bean = sphere(5u32);
  v = 0usize;
  while v < bean.vertexCount() {
    let p = *bean.positions[v];
    bean.positions.set(v, new Vec3(p.x * 1.3, p.y * (1. + 0.25 * p.x * p.x) + 0.15 * p.x * p.x, p.z * 0.8));
    v = v + 1usize;
  }
  var os = RemeshOptions.withFaces(500u32);
  os.symmetryAxis = 0i32;
  let rs = quadRemesh(&bean, &os);
  sound(&rs.mesh, "bean valid");
  let ss = measure(&rs.mesh, &bean);
  expectInt(i64.from(ss.boundaryEdges), 0i64, "bean closed");
  let sidx = SurfaceIndex.of(&rs.mesh);
  var asym = 0.f;
  v = 0usize;
  while v < rs.mesh.vertexCount() {
    let p = *rs.mesh.positions[v];
    let hit = sidx.nearestVertex(new Vec3(-p.x, p.y, p.z), 0.);
    if hit.tri != NoIndex && hit.distance > asym { asym = hit.distance; }
    v = v + 1usize;
  }
  expectFloat(f64.from(asym), 0., 0.00001, "every vertex has its mirror image");

  // density
  var sd = sphere(5u32);
  let dch = sd.addFloatChannel(VertexDomain, "density", 1.);
  v = 0usize;
  while v < sd.vertexCount() {
    sd.setFloat(dch, u32.from(v), if (*sd.positions[v]).y > 0. {6.} else {1.});
    v = v + 1usize;
  }
  var od = RemeshOptions.withFaces(800u32);
  od.density = String.from("density");
  let rd = quadRemesh(&sd, &od);
  var up = 0;
  var down = 0;
  var f = 0usize;
  while f < rd.mesh.faceCount() {
    if rd.mesh.faceCentroid(u32.from(f)).y > 0. { up = up + 1; } else { down = down + 1; }
    f = f + 1usize;
  }
  expect(up >= 2 * down, "the dense half gets twice the faces");

  // a guide
  var sg = sphere(5u32);
  var mask = List[bool].empty();
  v = 0usize;
  while v < sg.vertexCount() { mask.push(absf((*sg.positions[v]).y - 0.2) < 0.012); v = v + 1usize; }
  var gl = List[u32].empty();
  var e2 = 0usize;
  while e2 < sg.edgeCount() {
    let a = sg.fromVertex(u32.from(2usize * e2));
    let b = sg.toVertex(u32.from(2usize * e2));
    if *mask[usize.from(a)] && *mask[usize.from(b)] { gl.push(a); gl.push(b); }
    e2 = e2 + 1usize;
  }
  expect(gl.len() > 20usize, "the guide has edges");
  var og = RemeshOptions.withFaces(500u32);
  let rn = quadRemesh(&sg, &og);
  og.guides = gl;
  let rg = quadRemesh(&sg, &og);
  expectInt(i64.from(measure(&rg.mesh, &sg).boundaryEdges), 0i64, "guided result closed");
  var onRing = 0;
  var onRingPlain = 0;
  v = 0usize;
  while v < rg.mesh.vertexCount() { if absf((*rg.mesh.positions[v]).y - 0.2) < 0.004 { onRing = onRing + 1; } v = v + 1usize; }
  v = 0usize;
  while v < rn.mesh.vertexCount() { if absf((*rn.mesh.positions[v]).y - 0.2) < 0.004 { onRingPlain = onRingPlain + 1; } v = v + 1usize; }
  expect(onRing > onRingPlain + 6 && onRing >= 12, "more vertices on the guided circle");

  // an open grid
  let gr = grid(40usize);
  var oo = RemeshOptions.withFaces(100u32);
  let rgrid = quadRemesh(&gr, &oo);
  sound(&rgrid.mesh, "grid valid");
  let so = measure(&rgrid.mesh, &gr);
  expect(so.boundaryEdges > 0u32, "the grid result is open");
  expect(so.hausdorff < 0.0001, "the grid result in the plane");
  var stray = 0;
  v = 0usize;
  while v < rgrid.mesh.vertexCount() {
    if rgrid.mesh.isBoundaryVertex(u32.from(v)) {
      let p = *rgrid.mesh.positions[v];
      if absf(p.x) > 0.0001 && absf(p.x - 1.) > 0.0001 && absf(p.y) > 0.0001 && absf(p.y - 1.) > 0.0001 { stray = stray + 1; }
    }
    v = v + 1usize;
  }
  expectInt(i64.from(stray), 0i64, "boundary vertices on the grid's edge");
  expect(so.quadFraction > 0.8, "the grid mostly quads");

  // aiming by edge length
  let ol = RemeshOptions.withEdge(0.2);
  let rl = quadRemesh(&sp, &ol);
  let fl = f32.from(rl.mesh.faceCount());
  expect(fl > 0.7 * 314. && fl < 1.4 * 314., "an edge length of 0.2 gives about 314 faces");
  done()
}
