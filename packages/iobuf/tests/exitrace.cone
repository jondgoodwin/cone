// Threads ending while the caches are being trimmed: a block is given back
// once, never twice and never lost (bufpool's bufpoolThreadEnded flushes under
// the registry's lock, as trimEverything does).
//
// 50 rounds. In each, 16 threads take and drop buffers of two classes, then
// wait at a gate holding their caches and taking nothing; main opens the gate,
// so all of them end at once, their exit flushes running together, while main
// calls trimAll() over and over (it flushes every record on the registry,
// those of the ending threads included). trimAll's rule is that no other thread
// is taking or returning, and these are not: they are ending. If an exit flush
// and a trim could flush the same lines at once, a block would reach the stock
// twice, its slab's count of blocks out would wrap, and that slab would never
// go back to the OS: at the end every slab must be back, nothing lent, nothing
// cached.
//
// The 50 rounds only sometimes put a trim inside the window between an exit
// flush reading a line and emptying it, so a flush that did not hold the
// registry's lock (a mutant) mostly survives them. So first, in parkPhase, the
// window is held open: bufpool's test-only flush hook parks a dying thread
// right there (it has read a line's count, the line is not yet emptied) while
// another thread runs trimAll(). With the lock the trim waits behind the parked
// thread; without it the trim would flush the same line, and when the thread is
// released the same blocks reach the stock twice. Main holds a buffer of each
// class, so no slab goes back to the OS inside the window and the doubled
// blocks show at the end as a slab that never comes home.

mod exitrace;

import testing use *;
import thread;
import time use Duration;
import iobuf use *;
import bufpool;

const perRound = 16u64;
const rounds = 50u64;
const parkRounds = 3u64;

let gate: Atomic[u64];
let waiting: Atomic[u64];
let armed: Atomic[u64];       // 1: the next flush that reads a line parks
let parked: Atomic[u64];
let release: Atomic[u64];
let trimDone: Atomic[u64];

fn @initpure init() {
  gate = Atomic[u64].of(0u64);
  waiting = Atomic[u64].of(0u64);
  armed = Atomic[u64].of(0u64);
  parked = Atomic[u64].of(0u64);
  release = Atomic[u64].of(0u64);
  trimDone = Atomic[u64].of(0u64);
}

// bufpool's flush hook: the one flush that finds 'armed' set parks until released
fn parkHook() {
  if armed.swap(0u64) == 1u64 {
    parked.store(1u64);
    while release.load() == 0u64 {thread.yieldNow();}
  }
}

// A thread that ends holding blocks of two classes in its cache
fn dying(n: u64) u64 {
  var k = 0u64;
  while k < 6u64 {
    var b = IoBuf(100usize);
    b.append("x");
    var m = IoBuf(10000usize);
    m.append("y");
    k = k + 1u64;
  }
  n
}

fn trimmer(n: u64) u64 {
  trimAll();
  trimDone.store(1u64);
  n
}

// waits up to ms milliseconds for flag to be 1; answers whether it is
fn waitFor(flag: &Atomic[u64], ms: u32) bool {
  var i = 0u32;
  while i < ms {
    if flag.load() == 1u64 {
      return true;
    }
    thread.sleep(Duration.fromMillis(1i64));
    i = i + 1u32;
  }
  false
}

fn parkPhase() {
  var keepA = IoBuf(100usize);
  keepA.append("a");
  var keepB = IoBuf(10000usize);
  keepB.append("b");
  bufpool.setFlushHook(&parkHook);
  var r = 0u64;
  var sawParked = 0u64;
  var trimmedEarly = 0u64;
  while r < parkRounds {
    parked.store(0u64);
    release.store(0u64);
    trimDone.store(0u64);
    armed.store(1u64);
    let d = thread.start(r, &dying);
    if waitFor(&parked, 5000u32) {
      sawParked = sawParked + 1u64;
    }
    let t = thread.start(r, &trimmer);
    // with the lock the trimmer cannot finish while the dying thread is parked;
    // without it, it finishes inside the window
    if waitFor(&trimDone, 300u32) {
      trimmedEarly = trimmedEarly + 1u64;
    }
    release.store(1u64);
    d.join();
    t.join();
    r = r + 1u64;
  }
  expectUInt(sawParked, parkRounds, "the dying thread parked in its exit flush every round");
  expectUInt(trimmedEarly, 0u64, "a trim waits behind a parked exit flush: they do not flush at once");
}

fn work(round: u64) u64 {
  var k = 0u64;
  while k < 6u64 {
    var b = IoBuf(100usize);
    b.append("x");
    var m = IoBuf(10000usize);
    m.append("y");
    k = k + 1u64;
  }
  waiting.add(1u64);
  while gate.load() <= round {thread.yieldNow();}
  k
}

fn main() i32 {
  parkPhase();
  trimAll();
  expectUInt(osBlocks(), 0u64, "after the parked rounds every slab is back with the OS");
  var r = 0u64;
  var ran = 0u64;
  while r < rounds {
    waiting.store(0u64);
    let t0 = thread.start(r, &work);
    let t1 = thread.start(r, &work);
    let t2 = thread.start(r, &work);
    let t3 = thread.start(r, &work);
    let t4 = thread.start(r, &work);
    let t5 = thread.start(r, &work);
    let t6 = thread.start(r, &work);
    let t7 = thread.start(r, &work);
    let t8 = thread.start(r, &work);
    let t9 = thread.start(r, &work);
    let t10 = thread.start(r, &work);
    let t11 = thread.start(r, &work);
    let t12 = thread.start(r, &work);
    let t13 = thread.start(r, &work);
    let t14 = thread.start(r, &work);
    let t15 = thread.start(r, &work);
    while waiting.load() < perRound {thread.yieldNow();}
    gate.store(r + 1u64);
    var k = 0u32;
    while k < 200u32 {
      trimAll();
      k = k + 1u32;
    }
    ran = ran + t0.join() + t1.join() + t2.join() + t3.join() + t4.join() + t5.join() + t6.join() + t7.join()
      + t8.join() + t9.join() + t10.join() + t11.join() + t12.join() + t13.join() + t14.join() + t15.join();
    r = r + 1u64;
  }
  expectUInt(ran, rounds * perRound * 6u64, "every thread ran");
  let s = stats();
  expectUInt(s.lent, 0u64, "nothing lent");
  expectUInt(u64.from(s.cachedBytes), 0u64, "nothing cached");
  trimAll();
  expectUInt(osBlocks(), 0u64, "every slab back with the OS: no block came home twice");
  expectUInt(u64.from(stats().heldBytes), 0u64, "nothing held");
  done()
}
