// 'mustTake' where the bound refuses: a panic reported at the caller's line,
// for a program that treats a full pool as a bug rather than a pause.

mod musttake;

import stdio use *;
import iobuf use *;

fn main() {
  imm pool = Pool.make(4096usize, 4096usize);
  imm a = pool.mustTake(1usize);
  printStr("one block taken\n");
  imm b = pool.mustTake(1usize);
  printStr("not reached\n");
}
