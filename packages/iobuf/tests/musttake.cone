// Out of memory is a panic for now: with the process's bound at one slab
// (2 MiB), the 512 blocks of a 4 KiB slab are taken, and the 513th has no
// slab to be carved from. The panic is reported at the caller's line.

mod musttake;

import stdio use *;
import iobuf use *;

fn main() {
  setLimits(2097152usize, 2097152usize);
  var held = Chain.make(4194304usize);
  var i = 0u32;
  while i < 512u32 {
    var b = IoBuf(1usize);
    b.append("x");
    held.push(b);
    i = i + 1u32;
  }
  printStr("512 blocks taken\n");
  let b = IoBuf(1usize);
  printStr("not reached\n");
}
