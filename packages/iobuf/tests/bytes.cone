// Shared read-only bytes, for a send fanned out to many sockets: a filled
// IoBuf frozen into Bytes, which any number of owners, on any threads, hold
// at once. Nobody can write to them. The block goes back to its pool once,
// after the last owner lets go -- not before, however the owners are spread.
//
// Here three slices of one frozen buffer are held: by main, and by two
// threads that read them and wait at a gate. main drops its own; the block
// is still lent. main opens the gate and joins both; then it is back.

mod bytes;

import testing use *;
import thread;
import iobuf use *;

imm gate Atomic[Bool];

fn @initpure init() {
  gate = Atomic[Bool].of(false);
}

// The bytes' length times 1000 plus their first byte, read before and after
// the gate
fn reader(b Bytes) u64 {
  imm first = u64.from(b.view()[0usize]);
  while !gate.load() {thread.yieldNow();}
  u64.from(b.len()) * 1000u64 + first;
}

fn main() i32 {
  initAll();
  imm pool = Pool.make();
  mut a thread.Thread[u64];
  mut c thread.Thread[u64];
  {
    mut buf = pool.mustTake(100usize);
    buf.append("HTTP/1.1 200 OK\r\n\r\nhello, everyone");
    imm whole = buf.freeze();       // buf is moved: it cannot be written to again
    expectUInt(u64.from(whole.len()), 34u64, "frozen: 34 bytes");
    expectStr(whole.view(), "HTTP/1.1 200 OK\r\n\r\nhello, everyone", "the bytes");
    imm body = whole.slice(19usize, 34usize);
    expectStr(body.view(), "hello, everyone", "a slice shares the block");
    imm word = body.slice(7usize, 15usize);
    expectStr(word.view(), "everyone", "a slice of a slice");
    imm copy = whole;               // another owner, not another block
    expect(copy.view().len == 34usize and &copy.view()[0usize] as *u8 == &whole.view()[0usize] as *u8,
      "a copy is the same bytes, not a copy of them");
    expectUInt(pool.stats().lent, 1u64, "one block lent, however many owners");
    a = thread.start(body, &reader);
    c = thread.start(whole, &reader);
  }
  // main's owners are gone; the threads still hold theirs
  expectUInt(pool.stats().lent, 1u64, "still lent while the threads hold it");
  gate.store(true);
  expectUInt(a.join(), 15000u64 + u64.from('h'), "the body, read on one thread");
  expectUInt(c.join(), 34000u64 + u64.from('H'), "the whole, read on another");
  expectUInt(pool.stats().lent, 0u64, "back once the last owner let go");
  expectUInt(pool.stats().reuses, 0u64, "and only once: never reused while held");
  done();
}
