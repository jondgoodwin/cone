// Buffers cross threads and come home from any of them, as completions will
// arrive on an I/O thread. An IoBuf, a Pool, a Chain and Bytes are each
// Sendable, so each is handed to 'thread.start' or sent over a channel here,
// and every block goes back to the pools from whichever thread drops it.
//
// 1. One buffer moved into a thread, filled there, and handed back as the
//    thread's result: the caller no longer has it while the thread does.
// 2. A chain moved into a thread, which parses it and drops it there: its
//    segments go back to the pools from that thread.
// 3. The race: four producer threads each take 25,000 buffers and send them
//    over one bounded channel to a consumer thread, which drops them, so takes
//    and returns run at once on five threads, every buffer dying on a thread
//    other than the one that took it. The counters come out exact: 100,000
//    lent and given back, nothing lent at the end. Each thread flushes its
//    cache as it ends, as a thread of Cone's own does.
//
// 'testing' counts its checks in globals, so every check is made on the main
// thread, from what the threads return. When everything has died and the
// caches are flushed, nothing is held from the OS.

mod threads;

import testing use *;
import thread;
import sync use *;
import iobuf use *;

const perProducer = 25000u64;

fn fill(b: IoBuf) IoBuf {
  var m = b;
  m.append("filled on another thread");
  flushThread();
  m
}

fn parse(c: Chain) u64 {
  var k = c;
  let at = k.find("\r\n");
  k.advance(k.len());
  flushThread();
  match at {
    case let Some(s) {u64.from(s)}
    case is None[usize] {999u64}
  }
}   // the chain dies here, on this thread

struct Work {
  pub tx: Sender[IoBuf];
  pub id: u64;
}

// Take perProducer buffers and send them on
fn produce(w: Work) u64 {
  var k = 0u64;
  while k < perProducer {
    var b = IoBuf(4096usize);
    b.append("x");
    w.tx.send(b);
    k = k + 1u64;
  }
  flushThread();
  k
}

// Drop every buffer that arrives: how many
fn consume(rx: Receiver[IoBuf]) u64 {
  var r = rx;
  var count = 0u64;
  var more = true;
  while more {
    match r.recv() {
      case let Some(s) {
        count = count + 1u64;
      }
      case is None[IoBuf] {more = false;}
    }
  }
  flushThread();
  count
}   // each buffer died at the end of its match, on this thread

fn main() i32 {
  initAll();
  {
    // 1. Moved in, filled, handed back
    let b = IoBuf(100usize);
    let t = thread.start(b, &fill);
    let back = t.join();
    expectStr(back.view(), "filled on another thread", "the buffer came back filled");
    expectUInt(stats().lent, 1u64, "one lent: the one handed back");

    // 2. A chain parsed and dropped on another thread
    var c = Chain.make(4096usize);
    var p = IoBuf(10usize);
    p.append("GET /\r");
    c.push(p);
    var q = IoBuf(10usize);
    q.append("\nrest");
    c.push(q);
    expectUInt(stats().lent, 3u64, "three lent");
    let pt = thread.start(c, &parse);
    expectUInt(pt.join(), 5u64, "the line end found across the boundary on the other thread");
    expectUInt(stats().lent, 1u64, "the chain's segments came back from that thread");
  }
  expectUInt(stats().lent, 0u64, "all home");
  trim();
  expectUInt(osBlocks(), 0u64, "the first buffers' slabs given back");

  // 3. The race
  {
    let before = stats();
    var tx: Sender[IoBuf];
    var rx: Receiver[IoBuf];
    tx, rx = Channel[IoBuf].bounded(256usize);
    let consumer = thread.start(rx, &consume);
    var p0: thread.Thread[u64];
    var p1: thread.Thread[u64];
    var p2: thread.Thread[u64];
    var p3: thread.Thread[u64];
    {
      p0 = thread.start(Work(tx.clone(), 0u64), &produce);
      p1 = thread.start(Work(tx.clone(), 1u64), &produce);
      p2 = thread.start(Work(tx.clone(), 2u64), &produce);
      p3 = thread.start(Work(tx, 3u64), &produce);
    }
    let sent = p0.join() + p1.join() + p2.join() + p3.join();
    let seen = consumer.join();
    expectUInt(sent, 4u64 * perProducer, "the producers sent 100,000");
    expectUInt(seen, 4u64 * perProducer, "the consumer dropped every buffer");
    let s = stats();
    expectUInt(s.takes - before.takes, 4u64 * perProducer, "100,000 lent");
    expectUInt(s.refused, 0u64, "none refused");
    expectUInt(s.lent, 0u64, "nothing lent at the end");
    expectUInt(u64.from(s.cachedBytes), 0u64, "every thread flushed its cache as it ended");
    expectUInt(s.osAllocs - s.osFrees, u64.from(s.slabs), "the OS counts agree with the slabs");
    expectUInt(osBlocks(), u64.from(s.slabs), "and with the blocks the OS holds");
    expect(s.heldBytes <= 67108864usize, "held within the bound");
  }
  trim();
  expectUInt(osBlocks(), 0u64, "every slab back once the buffers are gone and the pools trimmed");
  expectUInt(osBytes(), 0u64, "no bytes held");
  done()
}
