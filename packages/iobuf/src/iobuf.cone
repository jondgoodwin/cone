// The iobuf package: owned buffers for I/O. The kernel reads into a buffer
// and writes from it after the call that started the operation has returned,
// until the operation completes, and cancelling does not end that. So a
// buffer is LENT to an operation by MOVING it: an IoBuf is a move type with
// one owner, the operation takes it by value, and the completion hands it
// back. Nothing else holds it meanwhile, and a borrow of one cannot be
// submitted, since a '&mut IoBuf' is not an IoBuf and cannot cross to the
// thread completions arrive on (test/cases/concurrency/
// concurrency_iobuf_loan.cone pins both refusals). Data used to fan one send
// out to many sockets is frozen first, into Bytes that any number of owners
// hold at once and nobody writes. A stream's bytes are parsed through a Chain
// of the buffers they arrived in. It is the first package of the async I/O
// runtime; the completion loop that lends these buffers to the OS comes next.
//
//   mod echo;
//   import iobuf use *;
//
//   fn main() {
//     mut buf = IoBuf(1500usize);             // empty, room for 4096 bytes, from the buffer pool
//     imm n = readInto(buf.spare());          // the OS fills the room...
//     buf.setLen(n);                          // ...and says how much
//     use(buf.view());
//   }                                         // buf dies: its block goes back to the buffer pool
//
//   IoBuf(size)           a buffer with room for at least size bytes, empty;
//                         out of memory is a panic at the caller's line (THE BUFFER POOL)
//   stats()               the pool's counters, a Stats
//   trim()                give every idle slab back to the OS
//   setLimits(maxBytes, keepBytes)  the process-wide bounds
//   trimAll()             trim after flushing every thread's cache
//   flushThread()         this thread's cache goes back to the stock
//   classSize(c), page, largestClass, classCount        (SIZE CLASSES)
//   osBlocks(), osBytes() what the pool holds from the OS now
//
//   IoBuf.empty()         a buffer with no block, capacity 0      (BUFFERS)
//   b.len()  b.capacity()  b.room()  b.isEmpty()
//   b.view()              the bytes it holds, '&Array[u8]'
//   b.spare()             the room after them, '&mut Array[u8]', to fill
//   b.whole()             the whole block, '&mut Array[u8]'
//   b.setLen(n)           say how many bytes it holds (a panic past capacity)
//   b.append(bytes)       copy in as many as fit: how many
//   b.clear()             hold none
//   b.base()              the block's address, for the OS
//   b.freeze()            the buffer moved into shared, read-only Bytes
//
//   s.len()  s.view()  s.slice(start, end)              (SHARED BYTES)
//
//   Chain.make(limit)     an empty chain holding at most limit bytes (CHAINS)
//   c.push(buf)           None once its bytes are in; Some(buf) back,
//                         refused, past the limit
//   c.appendLast(bytes)   bytes copied into the last segment's room: how many
//   c.lastRoom()          that room
//   c.len()  c.isEmpty()  c.segments()  c.bound()  c.firstLen()
//   c.find(pat, from)     the offset of pat, across segment boundaries
//   c.findByte(b, from)   the offset of byte b
//   c.matchesAt(i, pat)   whether pat is there at offset i
//   c.byteAt(i)  c.peek(i)                  one byte (a panic, or None, past the end)
//   c.contiguous(from, n) Some slice when the n bytes lie in one segment
//   c.copyOut(from, dest) copy bytes out: how many
//   c.advance(n)          consume n bytes: segments wholly consumed go home
//   c.take(dest)          copyOut from 0 and advance
//   c.popFront()          the first segment moved out whole
//
// BUFFERS. An IoBuf is a block of memory from the buffer pool, 4 KiB-aligned and
// a whole number of 4 KiB pages long, so a later unbuffered file read (whose
// buffer, offset and length must be multiples of the sector size) needs a
// flag and not a different buffer; and how many of its bytes are filled, its
// length, from 0 to its capacity. It holds no reference into anything else,
// so it is Sendable: it may be handed to a thread or sent over a channel, and
// it may die on any thread. Its death gives its block back to the buffer pool,
// from whichever thread it dies on: that is how a completion arriving on an
// I/O thread, or an operation the in-flight table drops after a prompt
// TimedOut, returns the buffer it carried. A buffer's methods take it by any
// reference, as a List's do; one moved into an operation is out of reach
// until the completion gives it back.
//
// Bytes past the length are whatever the block last held: a block is reused
// as it comes back, and nothing clears it. A block never used before is
// zeroed by the OS, but for its first 16 bytes, which the stock has linked.
//
// IoBuf.empty() is a buffer with no block, from no pool, which does nothing
// when it dies: what a buffer slot holds when it holds none (a read of no
// room, the end of a stream), and the start of a buffer that 'popFront' or a
// refused 'push' may or may not fill in:
//
//   var b = IoBuf.empty();
//   match chain.popFront() {
//     case let Some(s) {b = s;}
//     case is None[IoBuf] {...}
//   }
//
// THE BUFFER POOL. An IoBuf's block comes from the buffer pool, the bufpool
// package's static region (core's 'MemRegion', one object for the process, as
// the heap's is; 'bufferPool()' answers it). IoBuf draws on it as a List draws
// on the heap's: 'IoBuf(n)' is a construction, nothing names a region, and the
// type decides where its block comes from. IoBuf asks the region for the room
// ('sizeFor': the capacity is all of what the region gives), allocates, and its
// death releases the block by that capacity; it keeps no class and no token,
// since the region finds the block's slab by its address. The same region is
// there for anything else that takes one: 'List[u8](3000, bufferPool())' has a
// capacity of 4,096. The pool, its slabs, its per-thread caches, its two bounds
// and the OS calls are the bufpool package's header; what it means here:
//
// SIZE CLASSES. 'IoBuf(n)' is served from the smallest class that holds n:
// 4 KiB, 16 KiB, 64 KiB, 256 KiB or 1 MiB, each four times the one before,
// so a buffer is never more than four times the size asked for (a request
// just over a class's size wastes most of the next); its capacity is the
// class's size. 4 KiB is a page, the smallest unit unbuffered I/O moves and
// enough for most small messages; 16 KiB holds a whole TLS record (2^14
// bytes of plaintext) and an HTTP/1.1 request head under the usual limits;
// 64 KiB is a socket read's usual size and the file reads the 3-D streamer
// makes; 256 KiB and 1 MiB are large sequential file reads, where the cost of
// each operation matters more than the memory. A request larger than 1 MiB is
// 'oversize': a block of its own, rounded up to whole pages, counted against
// the bound, never kept idle, and given back to the OS when it dies.
//
// THE BOUNDS. Two, each a number of bytes, belong to the process:
//
// - 'maxBytes' (64 MiB by default) bounds what the pool holds from the OS,
//   lent and idle together, slabs and oversize blocks. A construction that
//   would pass it first gives idle slabs of every class back to the OS and
//   flushes the thread's cache; if that is not enough the region answers a null
//   block and IoBuf's construction PANICS, for now, at the caller's line. A
//   refusal as a value is to come: it cannot be 'trynew IoBuf(n)', which the
//   compiler refuses (error 1217: 'trynew' takes a managed reference type, and
//   an IoBuf is a value owning its block).
// - 'keepBytes' (8 MiB by default) bounds the idle bytes the stock keeps: when
//   blocks come home past it, slabs wholly idle go back to the OS, a whole slab
//   at a time, though never below the bound.
//
// 'setLimits(maxBytes, keepBytes)' sets them for the process, once, at
// start-up; a bound of 0 leaves that one alone.
//
// 'stats()' copies the pool's counters out: the two bounds; the bytes held from
// the OS, and of them the bytes idle (held and not lent: cached, idle in the
// stock, or in a slab's part not yet used) and in threads' caches; buffers
// lent now, ever taken, and served from the taking thread's own cache; slabs
// and oversize blocks got from the OS and given back; and takes refused (0:
// they panic). Each thread counts its own takes and returns in a plain number
// of its own, so they are exact once the threads have stopped, and a sum of
// moments while they run. These count every block of the pool, a List's too, not
// IoBufs alone. 'osBlocks()' and 'osBytes()' count what the pool holds from the
// OS (slabs and oversize blocks), for a leak check: 0 once every block is home
// and 'trimAll()' has run, which the bufpool module's 'final' does.
//
// THE PER-THREAD CACHES. Each thread keeps a few idle blocks of each size
// (up to 32 of 4 KiB, 2 of 16 KiB, 2 of 64 KiB, 1 of 256 KiB, none of 1 MiB:
// about 540 KiB), so most takes and returns touch no lock and no other
// thread's memory. The big classes keep few because a buffer an I/O thread has
// just filled is warm in a core's cache, and a deep cache hands a thread older,
// colder blocks than the one just returned (measured: aio's 16 KiB stream
// lost a fifth of its throughput with 8). A buffer that dies goes to the cache of the thread it dies
// on, whichever took it. A thread of Cone's own that is about to end calls
// 'flushThread()', which gives its cache back to the stock; the I/O blocking
// pool's threads do. NOTHING FINALIZES A '@threadlocal' YET when its thread
// ends (a language gap, mod-globals says so), so the cache is a record found
// through one '@threadlocal' pointer and kept on a registry for good: a thread
// that ends without flushing, one the program started through the OS or a
// worker that ends with the process, leaves its blocks in its record, counted
// in the stats as cached and given back at 'trimAll()' and in the pool's 'final'.
//
// SHARED BYTES. 'buf.freeze()' moves a filled buffer into Bytes: its bytes,
// read-only, shared by any number of owners on any number of threads, as one
// send fanned out to many sockets needs (the kernel only reads a send's
// bytes). Copying Bytes makes another owner, not another copy of the bytes;
// 'slice' is another owner of part of them. Bytes is an 'Arc[imm, IoBuf]'
// with a range, so the block goes back to the buffer pool once, after its last
// owner dies, wherever that is. Nothing can reach the buffer to write to it.
//
// CHAINS. A Chain is a stream's bytes as they arrived, one pooled buffer per
// read, on the model of .NET's System.IO.Pipelines: the reader pushes each
// filled buffer as its read completes, and a parser looks at all the
// unconsumed bytes as one sequence -- finds a delimiter across segment
// boundaries, peeks, copies bytes out -- and then says how many it has
// consumed with 'advance'. Unconsumed bytes stay for the next look; each
// segment wholly consumed dies at once, its block back to the buffer pool. An HTTP/1.1
// parser finds "\r\n\r\n", copies the head out (or reads it in place with
// 'contiguous' when it lies in one segment), advances past it, then takes
// the body's bytes, or moves whole segments on with 'popFront'.
//
// A chain is bounded too: 'make' says how many unconsumed bytes it may hold,
// and a push past that is refused, its buffer handed back whole, so a peer
// that never finishes a request head cannot grow it without limit -- the
// caller answers it (HTTP's 431) or stops reading. It owns its segments and
// is Sendable; its death gives back every segment it still holds.
//
// Not here yet: registration of the pool's blocks with IoRing or io_uring
// (the plan keeps it inside the pool, unseen); a chain's writer side lending
// the room left in its last segment to the next read; a refused take as a
// value (an out of memory panics today); IoBuf declaring CarriesRegion, so that
// one could be made in a region other than the buffer pool (a construction that
// names no region is handed the heap's, and the type cannot yet name another
// default, so IoBuf calls the buffer pool directly).
//
// What depends on the OS: nothing here. The pool's slabs come from VirtualAlloc
// on Windows and anonymous mmap on Linux, in the bufpool package, which says how.
// A chain's segments are a ring of IoBufs in one block from the C allocator,
// moved with core's 'mem' intrinsics, as a List's elements are.

mod iobuf;

import libc;
import sync use Arc, Mutex;
import bufpool;

// ---------------------------------------------------------------------------
// The pool, and its counters: the buffer pool is bufpool's. These wrappers keep
// the names this package has always had
// ---------------------------------------------------------------------------

// A block's alignment, and the unit every capacity is a multiple of
pub const page = 4096usize;

// The size classes, 4 KiB to 1 MiB, each four times the last; a larger
// request is 'oversize', allocated for itself and freed when it returns
pub const classCount = 5u32;

pub fn classSize(c: u32) usize {bufpool.classSize(c)}

// The largest size a class holds
pub const largestClass = 1048576usize;

// What the pool holds from the OS now, for leak checks
pub fn osBlocks() u64 {bufpool.osBlocks()}
pub fn osBytes() u64 {bufpool.osBytes()}

// Every thread's cache back to the stock and every idle slab back to the OS:
// for when no other thread is taking or returning buffers (a leak check, the
// end of a program)
pub fn trimAll() {bufpool.trimEverything();}

// This thread's cache back to the stock
pub fn flushThread() {bufpool.flushThread();}

// The process-wide bounds, in bytes held from the OS and idle bytes kept. A
// zero leaves the bound as it is
pub fn setLimits(maxBytes: usize, keepBytes: usize) {bufpool.setLimits(maxBytes, keepBytes);}

// The pool's counters, as 'stats' copies them out
pub struct Stats {
  pub maxBytes: usize;     // the bound on bytes held from the OS
  pub keepBytes: usize;    // the bound on idle bytes kept
  pub heldBytes: usize;    // bytes held from the OS: lent out and idle
  pub idleBytes: usize;    // bytes held and not lent: cached, idle in the stock, or not yet carved
  pub lent: u64;           // buffers lent out now
  pub takes: u64;          // takes asked for
  pub reuses: u64;         // takes served by the thread's own cache
  pub osAllocs: u64;       // slabs and oversize blocks got from the OS
  pub osFrees: u64;        // and given back
  pub refused: u64;        // takes refused: 0, since a refusal panics
  pub cachedBytes: usize;  // bytes of idle blocks in threads' caches
  pub stockBytes: usize;   // bytes of idle blocks in the central stock
  pub slabs: usize;        // slabs held
  pub lentBytes: usize;    // bytes of the buffers lent now
}

// The counters, as they are now
pub fn stats() Stats {
  let s = bufpool.blockStats();
  Stats(s.maxBytes, s.keepBytes, s.heldBytes, s.idleBytes, s.lent, s.takes, s.reuses,
    s.osAllocs, s.osFrees, 0u64, s.cachedBytes, s.stockBytes, s.slabs, s.lentBytes)
}

// Give every idle slab back to the OS (this thread's cache first)
pub fn trim() {
  bufpool.trimStock();
}

// A buffer of at least size bytes from the buffer pool region: the room is the
// size its size function answers (the class's, or whole pages when oversize)
fn acquire(size: usize, file: &Array[u8], line: u32) IoBuf {
  let pool = bufpool.bufferPool() as &MemRegion;
  let room = pool.sizeFor(size, page);
  let b = pool.allocate(size, page);
  if b as usize == 0usize {outOfMemory(file, line);}
  IoBuf(b, 0usize, room)
}

// Out of memory is a panic for now: the bound on bytes held from the OS is
// reached, or the OS refused
fn outOfMemory(file: &Array[u8], line: u32) {
  panic("iobuf: out of memory: the bound on bytes held from the OS is reached, or the OS refused", file, line);
}

// ---------------------------------------------------------------------------
// IoBuf
// ---------------------------------------------------------------------------

// A block from the buffer pool and how many of its bytes are filled: one owner,
// moved, never copied; its death gives the block back to the pool. It
// declares Sendable, a promise taken on trust, for its block's raw pointer:
// the block is its alone while it lives (see the package's header, BUFFERS)
pub struct IoBuf is Move, Sendable {
  data: *u8;
  used: usize;
  cap: usize;

  // A buffer with room for at least size bytes, empty: 'IoBuf(4096)'. The type
  // decides where the block comes from: the buffer pool region, the class that
  // holds size, or a block of its own from the OS when size is over 1 MiB.
  // Out of memory (the bound on bytes held is reached, or the OS refuses) is
  // a panic at the caller's line
  pub fn init(self: &new, size: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    *self = acquire(size, file, line);
  }

  // A buffer with no block: capacity 0, from no pool
  pub fn empty() IoBuf {IoBuf(null, 0usize, 0usize)}

  pub fn len(self: &) usize {used}
  pub fn capacity(self: &) usize {cap}
  pub fn room(self: &) usize {cap - used}
  pub fn isEmpty(self: &) bool {used == 0usize}

  // The bytes it holds
  pub fn view(self: &) &Array[u8] {mem.sliceFromParts(data, used)}
  // The room after them, to fill
  pub fn spare(self: &mut) &mut Array[u8] {mem.sliceFromPartsMut(data + used, cap - used)}
  // The whole block
  pub fn whole(self: &mut) &mut Array[u8] {mem.sliceFromPartsMut(data, cap)}
  // Its address, for the OS
  pub fn base(self: &) *u8 {data}

  // Say it holds n bytes: a panic, at the caller's line, past its capacity
  pub fn setLen(self: &mut, n: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if n > cap {panic("iobuf: setLen past the buffer's capacity", file, line);}
    used = n;
  }
  // Hold no bytes
  pub fn clear(self: &mut) {used = 0usize;}

    // Move it into Bytes, shared and read-only
  pub fn freeze(self) Bytes {freezeBuf(self)}

  // Copy in as many of bytes as fit: how many
  pub fn append(self: &mut, bytes: &Array[u8]) usize {
    let n = if bytes.len < cap - used {bytes.len} else {cap - used};
    if n > 0usize {libc.memcpy(data + used, &bytes[0usize] as *u8, n);}
    used = used + n;
    n
  }

  fn final(self: &uni) {
    if data as usize != 0usize {
      (bufpool.bufferPool() as &MemRegion).release(data, cap);
    }
  }
}


// ---------------------------------------------------------------------------
// Bytes
// ---------------------------------------------------------------------------

// Read-only bytes shared by any number of owners on any threads: a frozen
// IoBuf and a range of it. Sendable, as an 'Arc[imm, T]' of a Sendable T is
// (see the package's header, SHARED BYTES)
pub struct Bytes {
  buf: Arc[imm, IoBuf];
  from: usize;
  n: usize;

  pub fn len(self: &) usize {n}
  pub fn view(self: &) &Array[u8] {mem.sliceFromParts(buf.data + from, n)}
  // Another owner of bytes start to end of these: a panic, at the caller's
  // line, out of range
  pub fn slice(self: &, start: usize, end: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Bytes {
    if start > end || end > n {panic("iobuf: Bytes.slice out of range", file, line);}
    Bytes(buf, from + start, end - start)
  }
}

fn freezeBuf(b: IoBuf) Bytes {
  let n = b.len();
  Bytes(Arc[imm, IoBuf](b), 0usize, n)
}

// ---------------------------------------------------------------------------
// Chain
// ---------------------------------------------------------------------------

// A stream's unconsumed bytes, in the buffers they arrived in. It declares
// Sendable, a promise taken on trust, for its ring's raw pointer: it owns
// the ring and the buffers in it (see the package's header, CHAINS)
pub struct Chain is Move, Sendable {
  ring: *IoBuf;     // the segments, a ring of 'slots' (a power of two)
  slots: usize;
  head: usize;      // the ring index of the first segment
  count: usize;     // segments held
  skip: usize;      // bytes of the first segment already consumed
  total: usize;     // bytes not yet consumed
  limit: usize;     // the most unconsumed bytes it holds

  // An empty chain holding at most limit unconsumed bytes
  pub fn make(limit: usize) Chain {
    Chain(null, 0usize, 0usize, 0usize, 0usize, 0usize, limit)
  }

  pub fn len(self: &) usize {total}
  pub fn isEmpty(self: &) bool {total == 0usize}
  pub fn segments(self: &) usize {count}
  pub fn bound(self: &) usize {limit}

  // How many unconsumed bytes the first segment holds: what 'popFront'
  // would hand over; 0 when the chain is empty
  pub fn firstLen(self: &) usize {
    if count == 0usize {return 0usize;}
    (self.at(0usize) as &IoBuf).used - skip
  }

  // The k-th segment
  fn at(self: &, k: usize) *IoBuf {ring + ((head + k) & (slots - 1usize))}

  // The unconsumed bytes of the k-th segment
  fn seg(self: &, k: usize) &Array[u8] {
    let b = self.at(k) as &IoBuf;
    let off = if k == 0usize {skip} else {0usize};
    mem.sliceFromParts(b.data + off, b.used - off)
  }

  // Add a filled buffer's bytes after those held: None once it is in (an
  // empty one is dropped, back to its pool), or Some(buf) back, refused,
  // when its bytes would take the chain past its bound
  pub fn push(self: &mut, buf: IoBuf) Option[IoBuf] {
    let n = buf.len();
    if total + n > limit {
      return Some[IoBuf](buf);
    }
    if n == 0usize {
      return None;
    }
    if count == slots {
      self.grow();
    }
    mem.writeRaw[IoBuf](self.at(count), buf);
    count = count + 1usize;
    total = total + n;
    None
  }

  // How many more bytes the last segment has room for after its own (and
  // the chain's bound allows): what 'appendLast' takes; 0 when it is empty
  pub fn lastRoom(self: &) usize {
    if count == 0usize {return 0usize;}
    let room = (self.at(count - 1usize) as &IoBuf).room();
    let left = limit - total;
    if room < left {room} else {left}
  }

  // Copy bytes into the last segment, after its own, as many as its room
  // (and the chain's bound) takes: how many. A writer gathering small writes
  // keeps them in the last buffer queued this way, nothing taken out
  pub fn appendLast(self: &mut, bytes: &Array[u8]) usize {
    let room = self.lastRoom();
    if room == 0usize {return 0usize;}
    let n = if bytes.len < room {bytes.len} else {room};
    let b = self.at(count - 1usize) as &mut IoBuf;
    b.append(&bytes[0usize ..< n]);
    total = total + n;
    n
  }

  // Twice the slots, the segments moved to the front in order
  fn grow(self: &mut) {
    let want = if slots == 0usize {4usize} else {slots * 2usize};
    let fresh = libc.malloc(want * mem.sizeof[IoBuf]()) as *IoBuf;
    if fresh as usize == 0usize {panic("iobuf: out of memory for a chain's ring");}
    var k = 0usize;
    while k < count {
      mem.writeRaw[IoBuf](fresh + k, mem.readRaw[IoBuf](self.at(k)));
      k = k + 1usize;
    }
    libc.free(ring as *u8);
    ring = fresh;
    slots = want;
    head = 0usize;
  }

  // The byte at offset i of the unconsumed bytes; a panic past the end
  pub fn byteAt(self: &, i: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) u8 {
    if i >= total {panic("iobuf: Chain.byteAt past the end", file, line);}
    var at = i;
    var k = 0usize;
    while true {
      let s = self.seg(k);
      if at < s.len {return s[at];}
      at = at - s.len;
      k = k + 1usize;
    }
    0u8
  }

  // The byte at offset i, or None past the end
  pub fn peek(self: &, i: usize) Option[u8] {
    if i >= total {return None;}
    Some[u8](self.byteAt(i))
  }

  // Whether pat is there at segment k, offset j onward
  fn matchFrom(self: &, k0: usize, j0: usize, pat: &Array[u8]) bool {
    var k = k0;
    var j = j0;
    var p = 0usize;
    while p < pat.len {
      if k >= count {return false;}
      let s = self.seg(k);
      while j < s.len && p < pat.len {
        if s[j] != pat[p] {return false;}
        j = j + 1usize;
        p = p + 1usize;
      }
      k = k + 1usize;
      j = 0usize;
    }
    true
  }

  // Whether the unconsumed bytes from offset i begin with pat
  pub fn matchesAt(self: &, i: usize, pat: &Array[u8]) bool {
    if i + pat.len > total {return false;}
    var at = i;
    var k = 0usize;
    while k < count {
      let s = self.seg(k);
      if at < s.len {return self.matchFrom(k, at, pat);}
      at = at - s.len;
      k = k + 1usize;
    }
    pat.len == 0usize
  }

  // The offset of the first pat at or after offset 'from', across segment
  // boundaries, or None
  pub fn find(self: &, pat: &Array[u8], from: usize = 0usize) Option[usize] {
    if from + pat.len > total {return None;}
    if pat.len == 0usize {return Some[usize](from);}
    let first = pat[0usize];
    let last = total - pat.len;    // the last offset pat may start at
    var base = 0usize;             // the offset segment k starts at
    var k = 0usize;
    while k < count {
      let s = self.seg(k);
      var j = if from > base {from - base} else {0usize};
      while j < s.len {
        if base + j > last {return None;}
        if s[j] == first && self.matchFrom(k, j, pat) {
          return Some[usize](base + j);
        }
        j = j + 1usize;
      }
      base = base + s.len;
      k = k + 1usize;
    }
    None
  }

  // The offset of the first byte b at or after offset 'from', or None
  pub fn findByte(self: &, b: u8, from: usize = 0usize) Option[usize] {
    var base = 0usize;
    var k = 0usize;
    while k < count {
      let s = self.seg(k);
      var j = if from > base {from - base} else {0usize};
      while j < s.len {
        if s[j] == b {return Some[usize](base + j);}
        j = j + 1usize;
      }
      base = base + s.len;
      k = k + 1usize;
    }
    None
  }

  // Copy unconsumed bytes from offset 'from' into dest, as many as fit and
  // are there: how many
  pub fn copyOut(self: &, from: usize, dest: &mut Array[u8]) usize {
    var at = from;
    var done = 0usize;
    var k = 0usize;
    while k < count && done < dest.len {
      let s = self.seg(k);
      if at >= s.len {
        at = at - s.len;
      } else {
        let here = s.len - at;
        let want = dest.len - done;
        let n = if here < want {here} else {want};
        libc.memcpy(&mut dest[done] as *u8, &s[at] as *u8, n);
        done = done + n;
        at = 0usize;
      }
      k = k + 1usize;
    }
    done
  }

  // The n unconsumed bytes from offset 'from' as one slice, when they lie in
  // one segment; None when they cross a boundary (copy them out instead) or
  // run past the end
  pub fn contiguous(self: &, from: usize, n: usize) Option[&Array[u8]] {
    if from + n > total {return None;}
    var at = from;
    var k = 0usize;
    while k < count {
      let s = self.seg(k);
      if at < s.len || (n == 0usize && at == s.len) {
        if at + n > s.len {return None;}
        return Some[&Array[u8]](&s[at ..< at + n]);
      }
      at = at - s.len;
      k = k + 1usize;
    }
    None
  }

  // Consume the first n bytes: every segment wholly consumed dies, its block
  // back to its pool. A panic if fewer than n are held
  pub fn advance(self: &mut, n: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if n > total {panic("iobuf: Chain.advance past the end", file, line);}
    total = total - n;
    var left = skip + n;
    while count > 0usize {
      let used = (self.at(0usize) as &IoBuf).used;
      if left < used {
        break;
      }
      // Wholly consumed: it dies here
      mem.finalize[IoBuf](self.at(0usize));
      left = left - used;
      head = (head + 1usize) & (slots - 1usize);
      count = count - 1usize;
    }
    skip = left;
  }

  // Copy the first dest.len unconsumed bytes, or as many as there are, into
  // dest, and consume them: how many
  pub fn take(self: &mut, dest: &mut Array[u8]) usize {
    let n = self.copyOut(0usize, dest);
    self.advance(n);
    n
  }

  // Move the first segment out whole, its unconsumed bytes moved to its
  // start, or None when the chain is empty
  pub fn popFront(self: &mut) Option[IoBuf] {
    if count == 0usize {return None;}
    var b = mem.readRaw[IoBuf](self.at(0usize));
    head = (head + 1usize) & (slots - 1usize);
    count = count - 1usize;
    if skip > 0usize {
      let n = b.used - skip;
      mem.moveRaw[u8](b.data, b.data + skip, n);
      b.used = n;
      skip = 0usize;
    }
    total = total - b.used;
    Some[IoBuf](b)
  }

  // Its death: every segment it still holds, back to its pool
  fn final(self: &uni) {
    while count > 0usize {
      mem.finalize[IoBuf](self.at(0usize));
      head = (head + 1usize) & (slots - 1usize);
      count = count - 1usize;
    }
    libc.free(ring as *u8);
  }
}
