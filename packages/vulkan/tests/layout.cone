// Generated by layout.py from the package's src/: do not edit. The size and
// alignment of every struct the vulkan package declares, and the offset of
// each of its fields, as Cone lays them out. layout.out is what layout.c
// prints for the same structs as C declares them, compiled by cl.exe, so a
// difference is a struct transcribed wrongly on one side or the other.

mod layout;

import stdio use *;
import libc;
import vulkan;

fn size(name &str, n usize, a usize) {
  printStr(name); printStr(" size "); printUInt(u64.from(n)); printStr(" align "); printUInt(u64.from(a)); printStr("\n");
}

fn o(name &str, base usize, p *u8) {
  printStr(name); printStr(" "); printUInt(u64.from((p as usize) - base)); printStr("\n");
}

fn main() i32 {
  size("SurfaceKHR", mem.sizeof[vulkan.SurfaceKHR](), mem.alignof[vulkan.SurfaceKHR]());
  size("SwapchainKHR", mem.sizeof[vulkan.SwapchainKHR](), mem.alignof[vulkan.SwapchainKHR]());
  size("DebugUtilsMessengerEXT", mem.sizeof[vulkan.DebugUtilsMessengerEXT](), mem.alignof[vulkan.DebugUtilsMessengerEXT]());
