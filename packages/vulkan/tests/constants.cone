// The vulkan package's constants, checked without Vulkan. Only a failure
// prints.
//
// An extension's enum values are not arbitrary: the specification gives the
// value of the value 'offset' of extension number 'n' as
// 1000000000 + (n - 1) * 1000 + offset, negated for an error code. So each
// such constant is checked against its extension's number and its offset
// (both from the registry), which is a check independent of the typed-in
// value. Core values are checked against their order in the specification's
// enumerations; the versions against 'makeApiVersion'; the combined flags
// against their bits; the struct defaults against their sType; and the
// ClearValue helpers against the bits C would store.

mod constants;

import testing use *;
import vulkan use *;

fn ext(n u32, offset u32) u32 { 1000000000u32 + (n - 1u32) * 1000u32 + offset; }
fn extError(n u32, offset u32) i32 { 0i32 - i32.from(ext(n, offset)); }

fn main() i32 {
  // Versions
  expectUInt(u64.from(API_VERSION_1_0), u64.from(makeApiVersion(1u32, 0u32, 0u32)), "1.0");
  expectUInt(u64.from(API_VERSION_1_1), u64.from(makeApiVersion(1u32, 1u32, 0u32)), "1.1");
  expectUInt(u64.from(API_VERSION_1_2), u64.from(makeApiVersion(1u32, 2u32, 0u32)), "1.2");
  expectUInt(u64.from(API_VERSION_1_3), u64.from(makeApiVersion(1u32, 3u32, 0u32)), "1.3");
  imm v = makeApiVersion(1u32, 3u32, 290u32);
  expectUInt(u64.from(apiVersionMajor(v)), 1u64, "major");
  expectUInt(u64.from(apiVersionMinor(v)), 3u64, "minor");
  expectUInt(u64.from(apiVersionPatch(v)), 290u64, "patch");

  // Extension values: VK_KHR_surface is extension 1, VK_KHR_swapchain 2,
  // VK_KHR_display_swapchain 4, VK_EXT_debug_report 12, VK_KHR_dynamic_rendering
  // 45, VK_KHR_get_physical_device_properties2 60, VK_KHR_maintenance1 70,
  // VK_KHR_external_memory 73, VK_EXT_debug_utils 129, VK_EXT_descriptor_indexing
  // 162, VK_KHR_separate_depth_stencil_layouts 242, VK_KHR_buffer_device_address
  // 258, VK_EXT_pipeline_creation_cache_control 298, VK_KHR_load_store_op_none
  // 302 (VK_EXT_load_store_op_none 302 too), VK_KHR_synchronization2 315, VK_EXT_layer_settings 497.
  expectInt(i64.from(ERROR_SURFACE_LOST_KHR), i64.from(extError(1u32, 0u32)), "ERROR_SURFACE_LOST_KHR");
  expectInt(i64.from(ERROR_NATIVE_WINDOW_IN_USE_KHR), i64.from(extError(1u32, 1u32)), "ERROR_NATIVE_WINDOW_IN_USE_KHR");
  expectUInt(u64.from(STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR), u64.from(ext(2u32, 0u32)), "SWAPCHAIN_CREATE_INFO_KHR");
  expectUInt(u64.from(STRUCTURE_TYPE_PRESENT_INFO_KHR), u64.from(ext(2u32, 1u32)), "PRESENT_INFO_KHR");
  expectUInt(u64.from(IMAGE_LAYOUT_PRESENT_SRC_KHR), u64.from(ext(2u32, 2u32)), "IMAGE_LAYOUT_PRESENT_SRC_KHR");
  expectInt(i64.from(SUBOPTIMAL_KHR), i64.from(ext(2u32, 3u32)), "SUBOPTIMAL_KHR");
  expectInt(i64.from(ERROR_OUT_OF_DATE_KHR), i64.from(extError(2u32, 4u32)), "ERROR_OUT_OF_DATE_KHR");
  expectInt(i64.from(ERROR_INCOMPATIBLE_DISPLAY_KHR), i64.from(extError(4u32, 1u32)), "ERROR_INCOMPATIBLE_DISPLAY_KHR");
  expectInt(i64.from(ERROR_VALIDATION_FAILED_EXT), i64.from(extError(12u32, 1u32)), "ERROR_VALIDATION_FAILED_EXT");
  expectUInt(u64.from(STRUCTURE_TYPE_RENDERING_INFO), u64.from(ext(45u32, 0u32)), "RENDERING_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO), u64.from(ext(45u32, 1u32)), "RENDERING_ATTACHMENT_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO), u64.from(ext(45u32, 2u32)), "PIPELINE_RENDERING_CREATE_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2), u64.from(ext(60u32, 0u32)), "PHYSICAL_DEVICE_FEATURES_2");
  expectInt(i64.from(ERROR_OUT_OF_POOL_MEMORY), i64.from(extError(70u32, 0u32)), "ERROR_OUT_OF_POOL_MEMORY");
  expectInt(i64.from(ERROR_INVALID_EXTERNAL_HANDLE), i64.from(extError(73u32, 3u32)), "ERROR_INVALID_EXTERNAL_HANDLE");
  expectUInt(u64.from(STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CALLBACK_DATA_EXT), u64.from(ext(129u32, 3u32)), "DEBUG_UTILS_MESSENGER_CALLBACK_DATA_EXT");
  expectUInt(u64.from(STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT), u64.from(ext(129u32, 4u32)), "DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT");
  expectInt(i64.from(ERROR_FRAGMENTATION), i64.from(extError(162u32, 0u32)), "ERROR_FRAGMENTATION");
  expectUInt(u64.from(IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL), u64.from(ext(242u32, 0u32)), "IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL");
  expectInt(i64.from(ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS), i64.from(extError(258u32, 0u32)), "ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS");
  expectInt(i64.from(PIPELINE_COMPILE_REQUIRED), i64.from(ext(298u32, 0u32)), "PIPELINE_COMPILE_REQUIRED");
  expectUInt(u64.from(ATTACHMENT_STORE_OP_NONE), u64.from(ext(302u32, 0u32)), "ATTACHMENT_STORE_OP_NONE");
  expectUInt(u64.from(IMAGE_LAYOUT_READ_ONLY_OPTIMAL), u64.from(ext(315u32, 0u32)), "IMAGE_LAYOUT_READ_ONLY_OPTIMAL");
  expectUInt(u64.from(IMAGE_LAYOUT_ATTACHMENT_OPTIMAL), u64.from(ext(315u32, 1u32)), "IMAGE_LAYOUT_ATTACHMENT_OPTIMAL");
  expectUInt(u64.from(STRUCTURE_TYPE_MEMORY_BARRIER_2), u64.from(ext(315u32, 0u32)), "MEMORY_BARRIER_2");
  expectUInt(u64.from(STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2), u64.from(ext(315u32, 1u32)), "BUFFER_MEMORY_BARRIER_2");
  expectUInt(u64.from(STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2), u64.from(ext(315u32, 2u32)), "IMAGE_MEMORY_BARRIER_2");
  expectUInt(u64.from(STRUCTURE_TYPE_LAYER_SETTINGS_CREATE_INFO_EXT), u64.from(ext(497u32, 0u32)), "LAYER_SETTINGS_CREATE_INFO_EXT");
  expectUInt(u64.from(STRUCTURE_TYPE_DEPENDENCY_INFO), u64.from(ext(315u32, 3u32)), "DEPENDENCY_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_SUBMIT_INFO_2), u64.from(ext(315u32, 4u32)), "SUBMIT_INFO_2");
  expectUInt(u64.from(STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO), u64.from(ext(315u32, 5u32)), "SEMAPHORE_SUBMIT_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO), u64.from(ext(315u32, 6u32)), "COMMAND_BUFFER_SUBMIT_INFO");

  // Core structure types, in the specification's order: APPLICATION_INFO is 0
  // and each after it one more, through LOADER_DEVICE_CREATE_INFO (48); then
  // the Vulkan 1.1 to 1.3 feature and property structs, 49 to 54
  expectUInt(u64.from(STRUCTURE_TYPE_DEVICE_CREATE_INFO), 3u64, "DEVICE_CREATE_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_FENCE_CREATE_INFO), 8u64, "FENCE_CREATE_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO), 15u64, "IMAGE_VIEW_CREATE_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO), 11u64, "QUERY_POOL_CREATE_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO), 28u64, "GRAPHICS_PIPELINE_CREATE_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO), 29u64, "COMPUTE_PIPELINE_CREATE_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET), 35u64, "WRITE_DESCRIPTOR_SET");
  expectUInt(u64.from(STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO), 39u64, "COMMAND_POOL_CREATE_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO), 42u64, "COMMAND_BUFFER_BEGIN_INFO");
  expectUInt(u64.from(STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES), 53u64, "PHYSICAL_DEVICE_VULKAN_1_3_FEATURES");

  // Core results and formats
  expectInt(i64.from(ERROR_DEVICE_LOST), -4, "ERROR_DEVICE_LOST");
  expectInt(i64.from(ERROR_UNKNOWN), -13, "ERROR_UNKNOWN");
  expectUInt(u64.from(FORMAT_B8G8R8A8_SRGB), 50u64, "FORMAT_B8G8R8A8_SRGB");
  expectUInt(u64.from(FORMAT_D32_SFLOAT), 126u64, "FORMAT_D32_SFLOAT");
  // R16G16B16A16_SFLOAT (97) is followed by the R32 formats: UINT, SINT, SFLOAT
  expectUInt(u64.from(FORMAT_R32_UINT), u64.from(FORMAT_R16G16B16A16_SFLOAT + 1u32), "FORMAT_R32_UINT");
  expectUInt(u64.from(FORMAT_R32_SFLOAT), u64.from(FORMAT_R32_UINT + 2u32), "FORMAT_R32_SFLOAT");
  // The synchronization2 access bits past 32: shader sampled read, storage read, storage write
  expectUInt(ACCESS_2_SHADER_SAMPLED_READ_BIT, 1u64 << 32u64, "ACCESS_2_SHADER_SAMPLED_READ_BIT");
  expectUInt(ACCESS_2_SHADER_STORAGE_READ_BIT, 1u64 << 33u64, "ACCESS_2_SHADER_STORAGE_READ_BIT");
  expectUInt(ACCESS_2_SHADER_STORAGE_WRITE_BIT, 1u64 << 34u64, "ACCESS_2_SHADER_STORAGE_WRITE_BIT");

  // Combined flags: COLOR_COMPONENT_ALL is the four bits or'd in its constant,
  // and has the specification's value
  expectUInt(u64.from(COLOR_COMPONENT_ALL), 0xFu64, "COLOR_COMPONENT_ALL");
  expectUInt(u64.from(SHADER_STAGE_ALL_GRAPHICS), 0x1Fu64, "SHADER_STAGE_ALL_GRAPHICS");

  // Names
  expectStr(resultName(SUCCESS), "SUCCESS", "SUCCESS by name");
  expectStr(resultName(ERROR_OUT_OF_DATE_KHR), "ERROR_OUT_OF_DATE_KHR", "OUT_OF_DATE by name");
  expectStr(resultName(ERROR_DEVICE_LOST), "ERROR_DEVICE_LOST", "DEVICE_LOST by name");
  expectStr(resultName(12345i32), "unknown VkResult", "an unlisted value");

  // Each struct's sType and null pNext, by default
  imm fence = new FenceCreateInfo();
  expectUInt(u64.from(fence.sType), u64.from(STRUCTURE_TYPE_FENCE_CREATE_INFO), "FenceCreateInfo's sType");
  expectUInt(u64.from(fence.pNext as usize), 0u64, "FenceCreateInfo's pNext");
  expectUInt(u64.from(fence.flags), 0u64, "FenceCreateInfo's flags");
  imm barrier = new ImageMemoryBarrier2(image: new Image(0u64), subresourceRange: new ImageSubresourceRange());
  expectUInt(u64.from(barrier.sType), u64.from(STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2), "ImageMemoryBarrier2's sType");
  expectUInt(u64.from(barrier.srcQueueFamilyIndex), u64.from(QUEUE_FAMILY_IGNORED), "no queue family transfer");
  expectUInt(u64.from(barrier.subresourceRange.levelCount), 1u64, "one mip level");
  imm queries = new QueryPoolCreateInfo(queryCount: 4u32);
  expectUInt(u64.from(queries.sType), u64.from(STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO), "QueryPoolCreateInfo's sType");
  expectUInt(u64.from(queries.queryType), u64.from(QUERY_TYPE_TIMESTAMP), "timestamps, by default");

  // The ClearValue helpers store what C's union would: 0.25f is 0x3E800000,
  // 1.0f is 0x3F800000
  imm color = clearColor(0.25, 0., 1., 1.);
  expectUInt(u64.from(color.raw[0]), 0x3E800000u64, "red");
  expectUInt(u64.from(color.raw[1]), 0u64, "green");
  expectUInt(u64.from(color.raw[2]), 0x3F800000u64, "blue");
  imm ds = clearDepthStencil(1., 7u32);
  expectUInt(u64.from(ds.raw[0]), 0x3F800000u64, "depth");
  expectUInt(u64.from(ds.raw[1]), 7u64, "stencil");
  done();
}
