// The vulkan package against the real Vulkan loader, with no window: the
// package's own 'init' has opened vulkan-1.dll and found the global
// functions ('available'), SDL (which loads its own copy of the library, the
// OS counting both) names the extensions a surface needs, an instance is
// made with them, 'InstanceFns.load' finds that instance's functions, and the
// physical devices are counted and destroyed with the instance. Only a
// failure prints, and nothing printed depends on which GPU is present.
//
// It needs the Vulkan loader of Vulkan 1.3 or later and one driver
// supporting it (any GPU driver from 2022 on installs both), and SDL3.dll;
// it needs no window, no display of its own, and no Vulkan SDK.

mod runtime;

import testing use *;
import sdl;
import vulkan;

fn main() i32 {
  require(sdl.Init(sdl.INIT_VIDEO), "SDL's video starts");
  require(sdl.Vulkan_LoadLibrary(null), "SDL finds the Vulkan loader");
  require(vulkan.available(), "the package's init found the Vulkan loader and its global functions");

  var version = 0u32;
  expectInt(i64.from(vulkan.enumerateInstanceVersion(&mut version)), i64.from(vulkan.SUCCESS), "the loader's version");
  expect(version >= vulkan.API_VERSION_1_3, "the loader is Vulkan 1.3 or later");

  // The instance extensions a surface needs, asked of SDL with no window
  var next = 0u32;
  let names = sdl.Vulkan_GetInstanceExtensions(&mut next);
  require(names as usize != 0usize, "SDL names the surface extensions");
  expect(next >= 2u32 and next <= 8u32, "a surface needs two or more extensions");

  let app = new vulkan.ApplicationInfo(pApplicationName: &"runtime" as *u8, pEngineName: &"cone" as *u8);
  let ci = new vulkan.InstanceCreateInfo(pApplicationInfo: &app as *vulkan.ApplicationInfo,
    ppEnabledLayerNames: null, enabledExtensionCount: next, ppEnabledExtensionNames: names);
  var instance = 0usize as vulkan.Instance;
  let res = vulkan.createInstance(&ci, null, &mut instance);
  requireStr(vulkan.resultName(res), "SUCCESS", "vkCreateInstance");
  let fns = vulkan.InstanceFns.load(instance);
  expectInt(i64.from(fns.missing), 0, "the instance's functions are found");
  expectBool(fns.hasDebugUtils(), false, "no debug messenger without VK_EXT_debug_utils");

  var ndev = 0u32;
  expectInt(i64.from(fns.enumeratePhysicalDevices(instance, &mut ndev, null)),
    i64.from(vulkan.SUCCESS), "counting the physical devices");
  expect(ndev >= 1u32, "at least one physical device");

  fns.destroyInstance(instance, null);
  sdl.Vulkan_UnloadLibrary();
  sdl.Quit();
  done();
}
