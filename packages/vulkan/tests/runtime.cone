// The vulkan package against the real Vulkan loader, with no window: SDL
// loads vulkan-1.dll and hands out vkGetInstanceProcAddr, 'load' finds the
// global functions through it, an instance is made with the extensions a
// surface needs, 'loadInstance' finds that instance's functions, and the
// physical devices are counted and destroyed with the instance. Only a
// failure prints, and nothing printed depends on which GPU is present.
//
// It needs the Vulkan loader of Vulkan 1.3 or later and one driver
// supporting it (any GPU driver from 2022 on installs both), and SDL2.dll;
// it needs no window, no display of its own, and no Vulkan SDK.

mod runtime;

import testing use *;
import sdl;
import vulkan;

fn main() i32 {
  require(sdl.Init(sdl.INIT_VIDEO) == 0i32, "SDL's video starts");
  require(sdl.Vulkan_LoadLibrary(0usize as *u8) == 0i32, "SDL finds the Vulkan loader");
  imm gipa = sdl.Vulkan_GetVkGetInstanceProcAddr() as vulkan.PFN_GetInstanceProcAddr;
  require(vulkan.load(gipa), "the global functions are found");

  mut version = 0u32;
  expectInt(i64[vulkan.enumerateInstanceVersion(&mut version)], i64[vulkan.SUCCESS], "the loader's version");
  expect(version >= vulkan.API_VERSION_1_3, "the loader is Vulkan 1.3 or later");

  // The instance extensions a surface needs, asked of SDL with no window
  mut next = 0u32;
  expectUInt(u64[sdl.Vulkan_GetInstanceExtensions(0usize as *sdl.Window, &mut next, 0usize as **u8)], 1u64,
    "SDL counts the surface extensions");
  expect(next >= 2u32 and next <= 8u32, "a surface needs two or more extensions");
  mut names [8; *u8] = [8; 0usize as *u8];
  sdl.Vulkan_GetInstanceExtensions(0usize as *sdl.Window, &mut next, &mut names as **u8);

  imm app = vulkan.ApplicationInfo[pNext: 0usize as *u8, pApplicationName: &"runtime" as *u8,
    pEngineName: &"cone" as *u8];
  imm ci = vulkan.InstanceCreateInfo[pNext: 0usize as *u8, pApplicationInfo: &app as *vulkan.ApplicationInfo,
    ppEnabledLayerNames: 0usize as **u8, enabledExtensionCount: next, ppEnabledExtensionNames: &names as **u8];
  mut instance = 0usize as vulkan.Instance;
  imm res = vulkan.createInstance(&ci, 0usize as *u8, &mut instance);
  requireStr(vulkan.resultName(res), "SUCCESS", "vkCreateInstance");
  expectBool(vulkan.loadInstance(instance), true, "the instance's functions are found");
  expectInt(i64[vulkan.missing()], 0, "none missing");
  expectBool(vulkan.hasDebugUtils(), false, "no debug messenger without VK_EXT_debug_utils");

  mut ndev = 0u32;
  expectInt(i64[vulkan.enumeratePhysicalDevices(instance, &mut ndev, 0usize as *vulkan.PhysicalDevice)],
    i64[vulkan.SUCCESS], "counting the physical devices");
  expect(ndev >= 1u32, "at least one physical device");

  vulkan.destroyInstance(instance, 0usize as *u8);
  sdl.Vulkan_UnloadLibrary();
  sdl.Quit();
  done();
}
