// The vulkan package's loader, without Vulkan: the tables are built from a
// stand-in for vkGetInstanceProcAddr, which counts the names it is asked for.
// The stand-in answers "vkGetDeviceProcAddr" with a second stand-in, so that
// a device's table is found through what its instance's table found, as with
// a real driver. No function found is called. Only a failure prints. (The
// OS's own loader is the module's 'init', which 'runtime' tests.)
//
// - A lookup finding nothing: the global table has all 4 functions missing.
// - A null lookup (no loader): nothing found, nothing counted missing.
// - A lookup finding everything: the global table asks for its 4 functions,
//   an instance's table for its 17 (the surface's 5 and the debug messenger's 2
//   optional), a device's for its 79 (the swapchain's 5 optional too), each
//   once, and none is missing.
// - An instance finding nothing misses its 10 required functions; tables are
//   per instance and per device.
// - An instance without debug utils: its table still has no function missing,
//   and 'hasDebugUtils' is false.
// - Every name asked for is a C name, beginning "vk".

mod loader;

import testing use *;
import libc;
import vulkan;

var @threadlocal asked = 0;
var @threadlocal badNames = 0;
var @threadlocal noDebugUtils = false;

fn count(name: *u8) {
  asked = asked + 1;
  if *name != 'v' || *(name + 1usize) != 'k' { badNames = badNames + 1; }
}

fn @c findNothing(instance: vulkan.Instance, name: *u8) *u8 {
  count(name);
  null
}

fn @c fakeDeviceProcAddr(device: vulkan.Device, name: *u8) *u8 {
  count(name);
  name
}

fn @c findEverything(instance: vulkan.Instance, name: *u8) *u8 {
  count(name);
  if libc.strcmp(cstr.fromPtr(name), "vkGetDeviceProcAddr") == 0i32 {
    return &fakeDeviceProcAddr as *u8;
  }
  if noDebugUtils && libc.strcmp(cstr.fromPtr(name), "vkCreateDebugUtilsMessengerEXT") == 0i32 {
    return null;
  }
  name
}

fn main() i32 {
  let nothing = vulkan.GlobalFns.find(&findNothing);
  expectInt(i64.from(nothing.missing), 4, "all four global functions missing");
  expectInt(i64.from(asked), 4, "each global function asked for once");

  asked = 0;
  let everything = vulkan.GlobalFns.find(&findEverything);
  expectInt(i64.from(everything.missing), 0, "no global function missing");
  expectInt(i64.from(asked), 4, "the global functions asked for once again");

  // No loader at all: a null vkGetInstanceProcAddr finds nothing and fails nothing
  asked = 0;
  let absent = vulkan.GlobalFns.find(0usize as *u8 as vulkan.PFN_GetInstanceProcAddr);
  expectInt(i64.from(absent.missing), 0, "no loader: nothing counted missing");
  expectInt(i64.from(asked), 0, "and nothing asked");

  let instance = 0x1000usize as vulkan.Instance;
  asked = 0;
  let instanceFns = vulkan.InstanceFns.loadWith(&findEverything, instance);
  expectInt(i64.from(instanceFns.missing), 0, "every instance function found");
  expectInt(i64.from(asked), 17, "each instance function asked for once");
  expectBool(instanceFns.hasDebugUtils(), true, "the debug messenger's functions found");
  expectBool(instanceFns.hasSurface(), true, "the surface's functions found");

  let device = 0x2000usize as vulkan.Device;
  asked = 0;
  let deviceFns = vulkan.DeviceFns.load(&instanceFns, device);
  expectInt(i64.from(deviceFns.missing), 0, "every device function found");
  expectBool(deviceFns.hasSwapchain(), true, "the swapchain's functions found");
  expectInt(i64.from(asked), 79, "each device function asked for once");

  // Another instance has a table of its own
  let lost = vulkan.InstanceFns.loadWith(&findNothing, instance);
  expectInt(i64.from(lost.missing), 10, "an instance finding nothing: its 10 required functions missing");
  expectBool(lost.hasDebugUtils(), false, "and no debug messenger");
  expectBool(lost.hasSurface(), false, "and no surface");
  expectBool(instanceFns.hasDebugUtils(), true, "the first instance's table is its own");

  noDebugUtils = true;
  let plain = vulkan.InstanceFns.loadWith(&findEverything, instance);
  expectInt(i64.from(plain.missing), 0, "debug utils are optional, and not counted as missing");
  expectBool(plain.hasDebugUtils(), false, "without debug utils");

  expectInt(i64.from(badNames), 0, "every name begins vk");
  done()
}
