// The vulkan package's loader, without Vulkan: 'load' is handed a stand-in for
// vkGetInstanceProcAddr, which counts the names it is asked for. The stand-in
// answers "vkGetDeviceProcAddr" with a second stand-in, so that 'loadDevice'
// looks its functions up through what 'loadInstance' found, as with a real
// driver. No function found is called. Only a failure prints.
//
// - Before any load, nothing is loaded.
// - A lookup finding nothing: 'load' answers false, and all 4 of its
//   functions are missing.
// - A lookup finding everything: 'load' asks for its 4 functions, each once,
//   'loadInstance' for its 16 (2 of them the debug messenger's, optional),
//   'loadDevice' for its 76, each once, and each answers true.
// - An instance without debug utils: 'loadInstance' still answers true, and
//   'hasDebugUtils' false.
// - Every name asked for is a C name, beginning "vk".

mod loader;

import testing use *;
import libc;
import vulkan;

mut asked = 0;
mut badNames = 0;
mut noDebugUtils = false;

fn count(name *u8) {
  asked = asked + 1;
  if *name != 'v' or *(name + 1usize) != 'k' { badNames = badNames + 1; }
}

fn findNothing(instance vulkan.Instance, name *u8) *u8 {
  count(name);
  0usize as *u8;
}

fn fakeDeviceProcAddr(device vulkan.Device, name *u8) *u8 {
  count(name);
  name;
}

fn findEverything(instance vulkan.Instance, name *u8) *u8 {
  count(name);
  if libc.strcmp(name, &"vkGetDeviceProcAddr" as *u8) == 0i32 {
    return &fakeDeviceProcAddr as *u8;
  }
  if noDebugUtils and libc.strcmp(name, &"vkCreateDebugUtilsMessengerEXT" as *u8) == 0i32 {
    return 0usize as *u8;
  }
  name;
}

fn main() i32 {
  expectBool(vulkan.loaded(), false, "nothing loaded at first");

  expectBool(vulkan.load(&findNothing), false, "a lookup that finds nothing");
  expectInt(i64.from(vulkan.missing()), 4, "all four global functions missing");
  expectInt(i64.from(asked), 4, "each global function asked for once");

  asked = 0;
  expectBool(vulkan.load(&findEverything), true, "a lookup that finds everything");
  expectBool(vulkan.loaded(), true, "loaded");
  expectInt(i64.from(vulkan.missing()), 0, "no global function missing");
  expectInt(i64.from(asked), 4, "the global functions asked for once again");

  imm instance = 0x1000usize as vulkan.Instance;
  asked = 0;
  expectBool(vulkan.loadInstance(instance), true, "every instance function found");
  expectInt(i64.from(asked), 16, "each instance function asked for once");
  expectBool(vulkan.hasDebugUtils(), true, "the debug messenger's functions found");

  imm device = 0x2000usize as vulkan.Device;
  asked = 0;
  expectBool(vulkan.loadDevice(device), true, "every device function found");
  expectInt(i64.from(asked), 76, "each device function asked for once");
  expectInt(i64.from(vulkan.missing()), 0, "no device function missing");

  noDebugUtils = true;
  expectBool(vulkan.loadInstance(instance), true, "debug utils are optional");
  expectBool(vulkan.hasDebugUtils(), false, "without debug utils");
  expectInt(i64.from(vulkan.missing()), 0, "and not counted as missing");

  expectInt(i64.from(badNames), 0, "every name begins vk");
  done();
}
