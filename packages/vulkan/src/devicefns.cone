// ---- The device-level functions ----

// The functions of one device, found for it by 'DeviceFns.load' through
// vkGetDeviceProcAddr, so they call the driver directly, not through the
// loader's dispatch: its own, swapchains' (VK_KHR_swapchain, which the device
// must have enabled), and Vulkan 1.3's synchronization2 and dynamic
// rendering. They take a Device, a Queue or a CommandBuffer. It belongs to
// the device it was found for: several devices are legal, each with its own.
pub struct DeviceFns {
  pfnDestroyDevice usize = 0usize;
  pfnGetDeviceQueue usize = 0usize;
  pfnDeviceWaitIdle usize = 0usize;
  pfnQueueWaitIdle usize = 0usize;
  pfnCreateSwapchainKHR usize = 0usize;
  pfnDestroySwapchainKHR usize = 0usize;
  pfnGetSwapchainImagesKHR usize = 0usize;
  pfnAcquireNextImageKHR usize = 0usize;
  pfnQueuePresentKHR usize = 0usize;
  pfnCreateImage usize = 0usize;
  pfnDestroyImage usize = 0usize;
  pfnGetImageMemoryRequirements usize = 0usize;
  pfnBindImageMemory usize = 0usize;
  pfnCreateImageView usize = 0usize;
  pfnDestroyImageView usize = 0usize;
  pfnCreateCommandPool usize = 0usize;
  pfnDestroyCommandPool usize = 0usize;
  pfnResetCommandPool usize = 0usize;
  pfnAllocateCommandBuffers usize = 0usize;
  pfnFreeCommandBuffers usize = 0usize;
  pfnBeginCommandBuffer usize = 0usize;
  pfnEndCommandBuffer usize = 0usize;
  pfnCreateFence usize = 0usize;
  pfnDestroyFence usize = 0usize;
  pfnWaitForFences usize = 0usize;
  pfnResetFences usize = 0usize;
  pfnCreateSemaphore usize = 0usize;
  pfnDestroySemaphore usize = 0usize;
  pfnQueueSubmit2 usize = 0usize;
  pfnCmdPipelineBarrier2 usize = 0usize;
  pfnCmdBeginRendering usize = 0usize;
  pfnCmdEndRendering usize = 0usize;
  pfnCreateBuffer usize = 0usize;
  pfnDestroyBuffer usize = 0usize;
  pfnGetBufferMemoryRequirements usize = 0usize;
  pfnAllocateMemory usize = 0usize;
  pfnFreeMemory usize = 0usize;
  pfnBindBufferMemory usize = 0usize;
  pfnMapMemory usize = 0usize;
  pfnUnmapMemory usize = 0usize;
  pfnInvalidateMappedMemoryRanges usize = 0usize;
  pfnCmdCopyBuffer usize = 0usize;
  pfnCmdFillBuffer usize = 0usize;
  pfnCmdCopyImageToBuffer usize = 0usize;
  pfnCmdCopyBufferToImage usize = 0usize;
  pfnCreateShaderModule usize = 0usize;
  pfnDestroyShaderModule usize = 0usize;
  pfnCreateSampler usize = 0usize;
  pfnDestroySampler usize = 0usize;
  pfnCreatePipelineLayout usize = 0usize;
  pfnDestroyPipelineLayout usize = 0usize;
  pfnCreateGraphicsPipelines usize = 0usize;
  pfnDestroyPipeline usize = 0usize;
  pfnCreateDescriptorSetLayout usize = 0usize;
  pfnDestroyDescriptorSetLayout usize = 0usize;
  pfnCreateDescriptorPool usize = 0usize;
  pfnDestroyDescriptorPool usize = 0usize;
  pfnAllocateDescriptorSets usize = 0usize;
  pfnUpdateDescriptorSets usize = 0usize;
  pfnCmdBindPipeline usize = 0usize;
  pfnCmdBindDescriptorSets usize = 0usize;
  pfnCmdBindVertexBuffers usize = 0usize;
  pfnCmdBindIndexBuffer usize = 0usize;
  pfnCmdSetViewport usize = 0usize;
  pfnCmdSetScissor usize = 0usize;
  pfnCmdPushConstants usize = 0usize;
  pfnCmdDraw usize = 0usize;
  pfnCmdDrawIndexed usize = 0usize;
  pfnCmdDrawIndirect usize = 0usize;
  pfnCmdDrawIndexedIndirect usize = 0usize;
  pfnCreateComputePipelines usize = 0usize;
  pfnCmdDispatch usize = 0usize;
  pfnCmdDispatchIndirect usize = 0usize;
  pfnCreateQueryPool usize = 0usize;
  pfnDestroyQueryPool usize = 0usize;
  pfnCmdResetQueryPool usize = 0usize;
  pfnCmdWriteTimestamp2 usize = 0usize;
  pfnCmdCopyQueryPoolResults usize = 0usize;
  // How many functions were not found
  pub missing u32 = 0u32;

  // Find the functions of 'device', through its instance's
  // vkGetDeviceProcAddr. 'missing' is how many were not found
  pub fn load(instance &InstanceFns, device Device) DeviceFns {
    mut t = new DeviceFns();
    mut missing = 0u32;
    t.pfnDestroyDevice = instance.getDeviceProcAddr(device, &"vkDestroyDevice" as *u8) as usize;
    if t.pfnDestroyDevice == 0usize { missing = missing + 1u32; }
    t.pfnGetDeviceQueue = instance.getDeviceProcAddr(device, &"vkGetDeviceQueue" as *u8) as usize;
    if t.pfnGetDeviceQueue == 0usize { missing = missing + 1u32; }
    t.pfnDeviceWaitIdle = instance.getDeviceProcAddr(device, &"vkDeviceWaitIdle" as *u8) as usize;
    if t.pfnDeviceWaitIdle == 0usize { missing = missing + 1u32; }
    t.pfnQueueWaitIdle = instance.getDeviceProcAddr(device, &"vkQueueWaitIdle" as *u8) as usize;
    if t.pfnQueueWaitIdle == 0usize { missing = missing + 1u32; }
    t.pfnCreateSwapchainKHR = instance.getDeviceProcAddr(device, &"vkCreateSwapchainKHR" as *u8) as usize;
    if t.pfnCreateSwapchainKHR == 0usize { missing = missing + 1u32; }
    t.pfnDestroySwapchainKHR = instance.getDeviceProcAddr(device, &"vkDestroySwapchainKHR" as *u8) as usize;
    if t.pfnDestroySwapchainKHR == 0usize { missing = missing + 1u32; }
    t.pfnGetSwapchainImagesKHR = instance.getDeviceProcAddr(device, &"vkGetSwapchainImagesKHR" as *u8) as usize;
    if t.pfnGetSwapchainImagesKHR == 0usize { missing = missing + 1u32; }
    t.pfnAcquireNextImageKHR = instance.getDeviceProcAddr(device, &"vkAcquireNextImageKHR" as *u8) as usize;
    if t.pfnAcquireNextImageKHR == 0usize { missing = missing + 1u32; }
    t.pfnQueuePresentKHR = instance.getDeviceProcAddr(device, &"vkQueuePresentKHR" as *u8) as usize;
    if t.pfnQueuePresentKHR == 0usize { missing = missing + 1u32; }
    t.pfnCreateImage = instance.getDeviceProcAddr(device, &"vkCreateImage" as *u8) as usize;
    if t.pfnCreateImage == 0usize { missing = missing + 1u32; }
    t.pfnDestroyImage = instance.getDeviceProcAddr(device, &"vkDestroyImage" as *u8) as usize;
    if t.pfnDestroyImage == 0usize { missing = missing + 1u32; }
    t.pfnGetImageMemoryRequirements = instance.getDeviceProcAddr(device, &"vkGetImageMemoryRequirements" as *u8) as usize;
    if t.pfnGetImageMemoryRequirements == 0usize { missing = missing + 1u32; }
    t.pfnBindImageMemory = instance.getDeviceProcAddr(device, &"vkBindImageMemory" as *u8) as usize;
    if t.pfnBindImageMemory == 0usize { missing = missing + 1u32; }
    t.pfnCreateImageView = instance.getDeviceProcAddr(device, &"vkCreateImageView" as *u8) as usize;
    if t.pfnCreateImageView == 0usize { missing = missing + 1u32; }
    t.pfnDestroyImageView = instance.getDeviceProcAddr(device, &"vkDestroyImageView" as *u8) as usize;
    if t.pfnDestroyImageView == 0usize { missing = missing + 1u32; }
    t.pfnCreateCommandPool = instance.getDeviceProcAddr(device, &"vkCreateCommandPool" as *u8) as usize;
    if t.pfnCreateCommandPool == 0usize { missing = missing + 1u32; }
    t.pfnDestroyCommandPool = instance.getDeviceProcAddr(device, &"vkDestroyCommandPool" as *u8) as usize;
    if t.pfnDestroyCommandPool == 0usize { missing = missing + 1u32; }
    t.pfnResetCommandPool = instance.getDeviceProcAddr(device, &"vkResetCommandPool" as *u8) as usize;
    if t.pfnResetCommandPool == 0usize { missing = missing + 1u32; }
    t.pfnAllocateCommandBuffers = instance.getDeviceProcAddr(device, &"vkAllocateCommandBuffers" as *u8) as usize;
    if t.pfnAllocateCommandBuffers == 0usize { missing = missing + 1u32; }
    t.pfnFreeCommandBuffers = instance.getDeviceProcAddr(device, &"vkFreeCommandBuffers" as *u8) as usize;
    if t.pfnFreeCommandBuffers == 0usize { missing = missing + 1u32; }
    t.pfnBeginCommandBuffer = instance.getDeviceProcAddr(device, &"vkBeginCommandBuffer" as *u8) as usize;
    if t.pfnBeginCommandBuffer == 0usize { missing = missing + 1u32; }
    t.pfnEndCommandBuffer = instance.getDeviceProcAddr(device, &"vkEndCommandBuffer" as *u8) as usize;
    if t.pfnEndCommandBuffer == 0usize { missing = missing + 1u32; }
    t.pfnCreateFence = instance.getDeviceProcAddr(device, &"vkCreateFence" as *u8) as usize;
    if t.pfnCreateFence == 0usize { missing = missing + 1u32; }
    t.pfnDestroyFence = instance.getDeviceProcAddr(device, &"vkDestroyFence" as *u8) as usize;
    if t.pfnDestroyFence == 0usize { missing = missing + 1u32; }
    t.pfnWaitForFences = instance.getDeviceProcAddr(device, &"vkWaitForFences" as *u8) as usize;
    if t.pfnWaitForFences == 0usize { missing = missing + 1u32; }
    t.pfnResetFences = instance.getDeviceProcAddr(device, &"vkResetFences" as *u8) as usize;
    if t.pfnResetFences == 0usize { missing = missing + 1u32; }
    t.pfnCreateSemaphore = instance.getDeviceProcAddr(device, &"vkCreateSemaphore" as *u8) as usize;
    if t.pfnCreateSemaphore == 0usize { missing = missing + 1u32; }
    t.pfnDestroySemaphore = instance.getDeviceProcAddr(device, &"vkDestroySemaphore" as *u8) as usize;
    if t.pfnDestroySemaphore == 0usize { missing = missing + 1u32; }
    t.pfnQueueSubmit2 = instance.getDeviceProcAddr(device, &"vkQueueSubmit2" as *u8) as usize;
    if t.pfnQueueSubmit2 == 0usize { missing = missing + 1u32; }
    t.pfnCmdPipelineBarrier2 = instance.getDeviceProcAddr(device, &"vkCmdPipelineBarrier2" as *u8) as usize;
    if t.pfnCmdPipelineBarrier2 == 0usize { missing = missing + 1u32; }
    t.pfnCmdBeginRendering = instance.getDeviceProcAddr(device, &"vkCmdBeginRendering" as *u8) as usize;
    if t.pfnCmdBeginRendering == 0usize { missing = missing + 1u32; }
    t.pfnCmdEndRendering = instance.getDeviceProcAddr(device, &"vkCmdEndRendering" as *u8) as usize;
    if t.pfnCmdEndRendering == 0usize { missing = missing + 1u32; }
    t.pfnCreateBuffer = instance.getDeviceProcAddr(device, &"vkCreateBuffer" as *u8) as usize;
    if t.pfnCreateBuffer == 0usize { missing = missing + 1u32; }
    t.pfnDestroyBuffer = instance.getDeviceProcAddr(device, &"vkDestroyBuffer" as *u8) as usize;
    if t.pfnDestroyBuffer == 0usize { missing = missing + 1u32; }
    t.pfnGetBufferMemoryRequirements = instance.getDeviceProcAddr(device, &"vkGetBufferMemoryRequirements" as *u8) as usize;
    if t.pfnGetBufferMemoryRequirements == 0usize { missing = missing + 1u32; }
    t.pfnAllocateMemory = instance.getDeviceProcAddr(device, &"vkAllocateMemory" as *u8) as usize;
    if t.pfnAllocateMemory == 0usize { missing = missing + 1u32; }
    t.pfnFreeMemory = instance.getDeviceProcAddr(device, &"vkFreeMemory" as *u8) as usize;
    if t.pfnFreeMemory == 0usize { missing = missing + 1u32; }
    t.pfnBindBufferMemory = instance.getDeviceProcAddr(device, &"vkBindBufferMemory" as *u8) as usize;
    if t.pfnBindBufferMemory == 0usize { missing = missing + 1u32; }
    t.pfnMapMemory = instance.getDeviceProcAddr(device, &"vkMapMemory" as *u8) as usize;
    if t.pfnMapMemory == 0usize { missing = missing + 1u32; }
    t.pfnUnmapMemory = instance.getDeviceProcAddr(device, &"vkUnmapMemory" as *u8) as usize;
    if t.pfnUnmapMemory == 0usize { missing = missing + 1u32; }
    t.pfnInvalidateMappedMemoryRanges = instance.getDeviceProcAddr(device, &"vkInvalidateMappedMemoryRanges" as *u8) as usize;
    if t.pfnInvalidateMappedMemoryRanges == 0usize { missing = missing + 1u32; }
    t.pfnCmdCopyBuffer = instance.getDeviceProcAddr(device, &"vkCmdCopyBuffer" as *u8) as usize;
    if t.pfnCmdCopyBuffer == 0usize { missing = missing + 1u32; }
    t.pfnCmdFillBuffer = instance.getDeviceProcAddr(device, &"vkCmdFillBuffer" as *u8) as usize;
    if t.pfnCmdFillBuffer == 0usize { missing = missing + 1u32; }
    t.pfnCmdCopyImageToBuffer = instance.getDeviceProcAddr(device, &"vkCmdCopyImageToBuffer" as *u8) as usize;
    if t.pfnCmdCopyImageToBuffer == 0usize { missing = missing + 1u32; }
    t.pfnCmdCopyBufferToImage = instance.getDeviceProcAddr(device, &"vkCmdCopyBufferToImage" as *u8) as usize;
    if t.pfnCmdCopyBufferToImage == 0usize { missing = missing + 1u32; }
    t.pfnCreateShaderModule = instance.getDeviceProcAddr(device, &"vkCreateShaderModule" as *u8) as usize;
    if t.pfnCreateShaderModule == 0usize { missing = missing + 1u32; }
    t.pfnDestroyShaderModule = instance.getDeviceProcAddr(device, &"vkDestroyShaderModule" as *u8) as usize;
    if t.pfnDestroyShaderModule == 0usize { missing = missing + 1u32; }
    t.pfnCreateSampler = instance.getDeviceProcAddr(device, &"vkCreateSampler" as *u8) as usize;
    if t.pfnCreateSampler == 0usize { missing = missing + 1u32; }
    t.pfnDestroySampler = instance.getDeviceProcAddr(device, &"vkDestroySampler" as *u8) as usize;
    if t.pfnDestroySampler == 0usize { missing = missing + 1u32; }
    t.pfnCreatePipelineLayout = instance.getDeviceProcAddr(device, &"vkCreatePipelineLayout" as *u8) as usize;
    if t.pfnCreatePipelineLayout == 0usize { missing = missing + 1u32; }
    t.pfnDestroyPipelineLayout = instance.getDeviceProcAddr(device, &"vkDestroyPipelineLayout" as *u8) as usize;
    if t.pfnDestroyPipelineLayout == 0usize { missing = missing + 1u32; }
    t.pfnCreateGraphicsPipelines = instance.getDeviceProcAddr(device, &"vkCreateGraphicsPipelines" as *u8) as usize;
    if t.pfnCreateGraphicsPipelines == 0usize { missing = missing + 1u32; }
    t.pfnDestroyPipeline = instance.getDeviceProcAddr(device, &"vkDestroyPipeline" as *u8) as usize;
    if t.pfnDestroyPipeline == 0usize { missing = missing + 1u32; }
    t.pfnCreateDescriptorSetLayout = instance.getDeviceProcAddr(device, &"vkCreateDescriptorSetLayout" as *u8) as usize;
    if t.pfnCreateDescriptorSetLayout == 0usize { missing = missing + 1u32; }
    t.pfnDestroyDescriptorSetLayout = instance.getDeviceProcAddr(device, &"vkDestroyDescriptorSetLayout" as *u8) as usize;
    if t.pfnDestroyDescriptorSetLayout == 0usize { missing = missing + 1u32; }
    t.pfnCreateDescriptorPool = instance.getDeviceProcAddr(device, &"vkCreateDescriptorPool" as *u8) as usize;
    if t.pfnCreateDescriptorPool == 0usize { missing = missing + 1u32; }
    t.pfnDestroyDescriptorPool = instance.getDeviceProcAddr(device, &"vkDestroyDescriptorPool" as *u8) as usize;
    if t.pfnDestroyDescriptorPool == 0usize { missing = missing + 1u32; }
    t.pfnAllocateDescriptorSets = instance.getDeviceProcAddr(device, &"vkAllocateDescriptorSets" as *u8) as usize;
    if t.pfnAllocateDescriptorSets == 0usize { missing = missing + 1u32; }
    t.pfnUpdateDescriptorSets = instance.getDeviceProcAddr(device, &"vkUpdateDescriptorSets" as *u8) as usize;
    if t.pfnUpdateDescriptorSets == 0usize { missing = missing + 1u32; }
    t.pfnCmdBindPipeline = instance.getDeviceProcAddr(device, &"vkCmdBindPipeline" as *u8) as usize;
    if t.pfnCmdBindPipeline == 0usize { missing = missing + 1u32; }
    t.pfnCmdBindDescriptorSets = instance.getDeviceProcAddr(device, &"vkCmdBindDescriptorSets" as *u8) as usize;
    if t.pfnCmdBindDescriptorSets == 0usize { missing = missing + 1u32; }
    t.pfnCmdBindVertexBuffers = instance.getDeviceProcAddr(device, &"vkCmdBindVertexBuffers" as *u8) as usize;
    if t.pfnCmdBindVertexBuffers == 0usize { missing = missing + 1u32; }
    t.pfnCmdBindIndexBuffer = instance.getDeviceProcAddr(device, &"vkCmdBindIndexBuffer" as *u8) as usize;
    if t.pfnCmdBindIndexBuffer == 0usize { missing = missing + 1u32; }
    t.pfnCmdSetViewport = instance.getDeviceProcAddr(device, &"vkCmdSetViewport" as *u8) as usize;
    if t.pfnCmdSetViewport == 0usize { missing = missing + 1u32; }
    t.pfnCmdSetScissor = instance.getDeviceProcAddr(device, &"vkCmdSetScissor" as *u8) as usize;
    if t.pfnCmdSetScissor == 0usize { missing = missing + 1u32; }
    t.pfnCmdPushConstants = instance.getDeviceProcAddr(device, &"vkCmdPushConstants" as *u8) as usize;
    if t.pfnCmdPushConstants == 0usize { missing = missing + 1u32; }
    t.pfnCmdDraw = instance.getDeviceProcAddr(device, &"vkCmdDraw" as *u8) as usize;
    if t.pfnCmdDraw == 0usize { missing = missing + 1u32; }
    t.pfnCmdDrawIndexed = instance.getDeviceProcAddr(device, &"vkCmdDrawIndexed" as *u8) as usize;
    if t.pfnCmdDrawIndexed == 0usize { missing = missing + 1u32; }
    t.pfnCmdDrawIndirect = instance.getDeviceProcAddr(device, &"vkCmdDrawIndirect" as *u8) as usize;
    if t.pfnCmdDrawIndirect == 0usize { missing = missing + 1u32; }
    t.pfnCmdDrawIndexedIndirect = instance.getDeviceProcAddr(device, &"vkCmdDrawIndexedIndirect" as *u8) as usize;
    if t.pfnCmdDrawIndexedIndirect == 0usize { missing = missing + 1u32; }
    t.pfnCreateComputePipelines = instance.getDeviceProcAddr(device, &"vkCreateComputePipelines" as *u8) as usize;
    if t.pfnCreateComputePipelines == 0usize { missing = missing + 1u32; }
    t.pfnCmdDispatch = instance.getDeviceProcAddr(device, &"vkCmdDispatch" as *u8) as usize;
    if t.pfnCmdDispatch == 0usize { missing = missing + 1u32; }
    t.pfnCmdDispatchIndirect = instance.getDeviceProcAddr(device, &"vkCmdDispatchIndirect" as *u8) as usize;
    if t.pfnCmdDispatchIndirect == 0usize { missing = missing + 1u32; }
    t.pfnCreateQueryPool = instance.getDeviceProcAddr(device, &"vkCreateQueryPool" as *u8) as usize;
    if t.pfnCreateQueryPool == 0usize { missing = missing + 1u32; }
    t.pfnDestroyQueryPool = instance.getDeviceProcAddr(device, &"vkDestroyQueryPool" as *u8) as usize;
    if t.pfnDestroyQueryPool == 0usize { missing = missing + 1u32; }
    t.pfnCmdResetQueryPool = instance.getDeviceProcAddr(device, &"vkCmdResetQueryPool" as *u8) as usize;
    if t.pfnCmdResetQueryPool == 0usize { missing = missing + 1u32; }
    t.pfnCmdWriteTimestamp2 = instance.getDeviceProcAddr(device, &"vkCmdWriteTimestamp2" as *u8) as usize;
    if t.pfnCmdWriteTimestamp2 == 0usize { missing = missing + 1u32; }
    t.pfnCmdCopyQueryPoolResults = instance.getDeviceProcAddr(device, &"vkCmdCopyQueryPoolResults" as *u8) as usize;
    if t.pfnCmdCopyQueryPoolResults == 0usize { missing = missing + 1u32; }
    t.missing = missing;
    t;
  }

  pub fn destroyDevice(self &, device Device, pAllocator *u8) {
    (pfnDestroyDevice as *u8 as PFN_DestroyDevice)(device, pAllocator);
  }
  pub fn getDeviceQueue(self &, device Device, queueFamilyIndex u32, queueIndex u32, pQueue &mut Queue) {
    (pfnGetDeviceQueue as *u8 as PFN_GetDeviceQueue)(device, queueFamilyIndex, queueIndex, pQueue);
  }
  pub fn deviceWaitIdle(self &, device Device) i32 {
    (pfnDeviceWaitIdle as *u8 as PFN_DeviceWaitIdle)(device);
  }
  pub fn queueWaitIdle(self &, queue Queue) i32 {
    (pfnQueueWaitIdle as *u8 as PFN_QueueWaitIdle)(queue);
  }
  pub fn createSwapchainKHR(self &, device Device, pCreateInfo &SwapchainCreateInfoKHR, pAllocator *u8,
    pSwapchain &mut SwapchainKHR) i32 {
    (pfnCreateSwapchainKHR as *u8 as PFN_CreateSwapchainKHR)(device, pCreateInfo, pAllocator, pSwapchain);
  }
  pub fn destroySwapchainKHR(self &, device Device, swapchain SwapchainKHR, pAllocator *u8) {
    (pfnDestroySwapchainKHR as *u8 as PFN_DestroySwapchainKHR)(device, swapchain, pAllocator);
  }
  pub fn getSwapchainImagesKHR(self &, device Device, swapchain SwapchainKHR, pSwapchainImageCount &mut u32,
    pSwapchainImages *Image) i32 {
    (pfnGetSwapchainImagesKHR as *u8 as PFN_GetSwapchainImagesKHR)(device, swapchain, pSwapchainImageCount, pSwapchainImages);
  }
  pub fn acquireNextImageKHR(self &, device Device, swapchain SwapchainKHR, timeout u64, semaphore Semaphore, fence Fence,
    pImageIndex &mut u32) i32 {
    (pfnAcquireNextImageKHR as *u8 as PFN_AcquireNextImageKHR)(device, swapchain, timeout, semaphore, fence, pImageIndex);
  }
  pub fn queuePresentKHR(self &, queue Queue, pPresentInfo &PresentInfoKHR) i32 {
    (pfnQueuePresentKHR as *u8 as PFN_QueuePresentKHR)(queue, pPresentInfo);
  }
  pub fn createImage(self &, device Device, pCreateInfo &ImageCreateInfo, pAllocator *u8, pImage &mut Image) i32 {
    (pfnCreateImage as *u8 as PFN_CreateImage)(device, pCreateInfo, pAllocator, pImage);
  }
  pub fn destroyImage(self &, device Device, image Image, pAllocator *u8) {
    (pfnDestroyImage as *u8 as PFN_DestroyImage)(device, image, pAllocator);
  }
  pub fn getImageMemoryRequirements(self &, device Device, image Image, pMemoryRequirements &mut MemoryRequirements) {
    (pfnGetImageMemoryRequirements as *u8 as PFN_GetImageMemoryRequirements)(device, image, pMemoryRequirements);
  }
  pub fn bindImageMemory(self &, device Device, image Image, memory DeviceMemory, memoryOffset u64) i32 {
    (pfnBindImageMemory as *u8 as PFN_BindImageMemory)(device, image, memory, memoryOffset);
  }
  pub fn createImageView(self &, device Device, pCreateInfo &ImageViewCreateInfo, pAllocator *u8, pView &mut ImageView) i32 {
    (pfnCreateImageView as *u8 as PFN_CreateImageView)(device, pCreateInfo, pAllocator, pView);
  }
  pub fn destroyImageView(self &, device Device, imageView ImageView, pAllocator *u8) {
    (pfnDestroyImageView as *u8 as PFN_DestroyImageView)(device, imageView, pAllocator);
  }
  pub fn createCommandPool(self &, device Device, pCreateInfo &CommandPoolCreateInfo, pAllocator *u8,
    pCommandPool &mut CommandPool) i32 {
    (pfnCreateCommandPool as *u8 as PFN_CreateCommandPool)(device, pCreateInfo, pAllocator, pCommandPool);
  }
  pub fn destroyCommandPool(self &, device Device, commandPool CommandPool, pAllocator *u8) {
    (pfnDestroyCommandPool as *u8 as PFN_DestroyCommandPool)(device, commandPool, pAllocator);
  }
  pub fn resetCommandPool(self &, device Device, commandPool CommandPool, flags u32) i32 {
    (pfnResetCommandPool as *u8 as PFN_ResetCommandPool)(device, commandPool, flags);
  }
  pub fn allocateCommandBuffers(self &, device Device, pAllocateInfo &CommandBufferAllocateInfo, pCommandBuffers *CommandBuffer) i32 {
    (pfnAllocateCommandBuffers as *u8 as PFN_AllocateCommandBuffers)(device, pAllocateInfo, pCommandBuffers);
  }
  pub fn freeCommandBuffers(self &, device Device, commandPool CommandPool, commandBufferCount u32, pCommandBuffers *CommandBuffer) {
    (pfnFreeCommandBuffers as *u8 as PFN_FreeCommandBuffers)(device, commandPool, commandBufferCount, pCommandBuffers);
  }
  pub fn beginCommandBuffer(self &, commandBuffer CommandBuffer, pBeginInfo &CommandBufferBeginInfo) i32 {
    (pfnBeginCommandBuffer as *u8 as PFN_BeginCommandBuffer)(commandBuffer, pBeginInfo);
  }
  pub fn endCommandBuffer(self &, commandBuffer CommandBuffer) i32 {
    (pfnEndCommandBuffer as *u8 as PFN_EndCommandBuffer)(commandBuffer);
  }
  pub fn createFence(self &, device Device, pCreateInfo &FenceCreateInfo, pAllocator *u8, pFence &mut Fence) i32 {
    (pfnCreateFence as *u8 as PFN_CreateFence)(device, pCreateInfo, pAllocator, pFence);
  }
  pub fn destroyFence(self &, device Device, fence Fence, pAllocator *u8) {
    (pfnDestroyFence as *u8 as PFN_DestroyFence)(device, fence, pAllocator);
  }
  pub fn waitForFences(self &, device Device, fenceCount u32, pFences *Fence, waitAll u32, timeout u64) i32 {
    (pfnWaitForFences as *u8 as PFN_WaitForFences)(device, fenceCount, pFences, waitAll, timeout);
