// ---- Structs: commands, synchronization, submission ----

pub struct CommandPoolCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
  pub pNext *u8 = null;
  pub flags u32 = 0u32;
  pub queueFamilyIndex u32 = 0u32;
}

pub struct CommandBufferAllocateInfo {
  pub sType u32 = STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
  pub pNext *u8 = null;
  pub commandPool CommandPool;
  pub level u32 = COMMAND_BUFFER_LEVEL_PRIMARY;
  pub commandBufferCount u32 = 0u32;
}

pub struct CommandBufferBeginInfo {
  pub sType u32 = STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
  pub pNext *u8 = null;
  pub flags u32 = 0u32;
  pub pInheritanceInfo *u8;
}

pub struct FenceCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_FENCE_CREATE_INFO;
  pub pNext *u8 = null;
  pub flags u32 = 0u32;
}

pub struct SemaphoreCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
  pub pNext *u8 = null;
  pub flags u32 = 0u32;
}

pub struct MemoryBarrier2 {
  pub sType u32 = STRUCTURE_TYPE_MEMORY_BARRIER_2;
  pub pNext *u8 = null;
  pub srcStageMask u64 = 0u64;
  pub srcAccessMask u64 = 0u64;
  pub dstStageMask u64 = 0u64;
  pub dstAccessMask u64 = 0u64;
}

pub struct BufferMemoryBarrier2 {
  pub sType u32 = STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2;
  pub pNext *u8 = null;
  pub srcStageMask u64 = 0u64;
  pub srcAccessMask u64 = 0u64;
  pub dstStageMask u64 = 0u64;
  pub dstAccessMask u64 = 0u64;
  pub srcQueueFamilyIndex u32 = QUEUE_FAMILY_IGNORED;
  pub dstQueueFamilyIndex u32 = QUEUE_FAMILY_IGNORED;
  pub buffer Buffer;
  pub offset u64 = 0u64;
  pub size u64 = WHOLE_SIZE;
}

pub struct ImageMemoryBarrier2 {
  pub sType u32 = STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
  pub pNext *u8 = null;
  pub srcStageMask u64 = 0u64;
  pub srcAccessMask u64 = 0u64;
  pub dstStageMask u64 = 0u64;
  pub dstAccessMask u64 = 0u64;
  pub oldLayout u32 = IMAGE_LAYOUT_UNDEFINED;
  pub newLayout u32 = IMAGE_LAYOUT_UNDEFINED;
  pub srcQueueFamilyIndex u32 = QUEUE_FAMILY_IGNORED;
  pub dstQueueFamilyIndex u32 = QUEUE_FAMILY_IGNORED;
  pub image Image;
  pub subresourceRange ImageSubresourceRange;
}

pub struct DependencyInfo {
  pub sType u32 = STRUCTURE_TYPE_DEPENDENCY_INFO;
  pub pNext *u8 = null;
  pub dependencyFlags u32 = 0u32;
  pub memoryBarrierCount u32 = 0u32;
  pub pMemoryBarriers *MemoryBarrier2;
  pub bufferMemoryBarrierCount u32 = 0u32;
  pub pBufferMemoryBarriers *BufferMemoryBarrier2;
  pub imageMemoryBarrierCount u32 = 0u32;
  pub pImageMemoryBarriers *ImageMemoryBarrier2;
}

pub struct RenderingAttachmentInfo {
  pub sType u32 = STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
  pub pNext *u8 = null;
  pub imageView ImageView;
  pub imageLayout u32 = IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
  pub resolveMode u32 = RESOLVE_MODE_NONE;
  pub resolveImageView ImageView;
  pub resolveImageLayout u32 = IMAGE_LAYOUT_UNDEFINED;
  pub loadOp u32 = ATTACHMENT_LOAD_OP_LOAD;
  pub storeOp u32 = ATTACHMENT_STORE_OP_STORE;
  pub clearValue ClearValue;
}

pub struct RenderingInfo {
  pub sType u32 = STRUCTURE_TYPE_RENDERING_INFO;
  pub pNext *u8 = null;
  pub flags u32 = 0u32;
  pub renderArea Rect2D;
  pub layerCount u32 = 1u32;
  pub viewMask u32 = 0u32;
  pub colorAttachmentCount u32 = 0u32;
  pub pColorAttachments *RenderingAttachmentInfo;
  pub pDepthAttachment *RenderingAttachmentInfo;
  pub pStencilAttachment *RenderingAttachmentInfo;
}

pub struct SemaphoreSubmitInfo {
  pub sType u32 = STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO;
  pub pNext *u8 = null;
  pub semaphore Semaphore;
  pub value u64 = 0u64;
  pub stageMask u64 = 0u64;
  pub deviceIndex u32 = 0u32;
}

pub struct CommandBufferSubmitInfo {
  pub sType u32 = STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO;
  pub pNext *u8 = null;
  pub commandBuffer CommandBuffer;
  pub deviceMask u32 = 0u32;
}

pub struct SubmitInfo2 {
  pub sType u32 = STRUCTURE_TYPE_SUBMIT_INFO_2;
  pub pNext *u8 = null;
  pub flags u32 = 0u32;
  pub waitSemaphoreInfoCount u32 = 0u32;
  pub pWaitSemaphoreInfos *SemaphoreSubmitInfo;
  pub commandBufferInfoCount u32 = 0u32;
  pub pCommandBufferInfos *CommandBufferSubmitInfo;
  pub signalSemaphoreInfoCount u32 = 0u32;
  pub pSignalSemaphoreInfos *SemaphoreSubmitInfo;
}

// ---- Structs: buffers and memory ----

pub struct BufferCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_BUFFER_CREATE_INFO;
  pub pNext *u8 = null;
  pub flags u32 = 0u32;
  pub size u64 = 0u64;
  pub usage u32 = 0u32;
  pub sharingMode u32 = SHARING_MODE_EXCLUSIVE;
  pub queueFamilyIndexCount u32 = 0u32;
  pub pQueueFamilyIndices *u32;
}

pub struct MemoryRequirements {
  pub size u64;
  pub alignment u64;
  pub memoryTypeBits u32;
}

pub struct MemoryAllocateInfo {
  pub sType u32 = STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
  pub pNext *u8 = null;
  pub allocationSize u64 = 0u64;
  pub memoryTypeIndex u32 = 0u32;
}

// A range of mapped memory, for vkInvalidateMappedMemoryRanges (memory
// that is not HOST_COHERENT)
pub struct MappedMemoryRange {
  pub sType u32 = STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
  pub pNext *u8 = null;
  pub memory DeviceMemory;
  pub offset u64 = 0u64;
  pub size u64 = WHOLE_SIZE;
}

pub struct BufferCopy { pub srcOffset u64; pub dstOffset u64; pub size u64; }

pub struct BufferImageCopy {
  pub bufferOffset u64 = 0u64;
  pub bufferRowLength u32 = 0u32;     // 0: tightly packed
  pub bufferImageHeight u32 = 0u32;
  pub imageSubresource ImageSubresourceLayers;
  pub imageOffset Offset3D;
  pub imageExtent Extent3D;
}
