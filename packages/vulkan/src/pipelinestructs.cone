// ---- Structs: shaders, pipelines, descriptors ----

pub struct ShaderModuleCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub codeSize usize = 0usize;          // in bytes, a multiple of 4
  pub pCode *u32;
}

pub struct PipelineShaderStageCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub stage u32 = 0u32;
  pub module ShaderModule;
  pub pName *u8;
  pub pSpecializationInfo *u8;
}

pub struct VertexInputBindingDescription {
  pub binding u32;
  pub stride u32;
  pub inputRate u32 = VERTEX_INPUT_RATE_VERTEX;
}

pub struct VertexInputAttributeDescription {
  pub location u32;
  pub binding u32;
  pub format u32;
  pub offset u32;
}

pub struct PipelineVertexInputStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub vertexBindingDescriptionCount u32 = 0u32;
  pub pVertexBindingDescriptions *VertexInputBindingDescription;
  pub vertexAttributeDescriptionCount u32 = 0u32;
  pub pVertexAttributeDescriptions *VertexInputAttributeDescription;
}

pub struct PipelineInputAssemblyStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub topology u32 = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
  pub primitiveRestartEnable u32 = FALSE;
}

pub struct Viewport {
  pub x f32;
  pub y f32;
  pub width f32;
  pub height f32;
  pub minDepth f32;
  pub maxDepth f32;
}

pub struct PipelineViewportStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub viewportCount u32 = 0u32;
  pub pViewports *Viewport;
  pub scissorCount u32 = 0u32;
  pub pScissors *Rect2D;
}

pub struct PipelineRasterizationStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub depthClampEnable u32 = FALSE;
  pub rasterizerDiscardEnable u32 = FALSE;
  pub polygonMode u32 = POLYGON_MODE_FILL;
  pub cullMode u32 = CULL_MODE_NONE;
  pub frontFace u32 = FRONT_FACE_COUNTER_CLOCKWISE;
  pub depthBiasEnable u32 = FALSE;
  pub depthBiasConstantFactor f32 = 0.;
  pub depthBiasClamp f32 = 0.;
  pub depthBiasSlopeFactor f32 = 0.;
  pub lineWidth f32 = 1.;
}

pub struct PipelineMultisampleStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub rasterizationSamples u32 = SAMPLE_COUNT_1_BIT;
  pub sampleShadingEnable u32 = FALSE;
  pub minSampleShading f32 = 0.;
  pub pSampleMask *u32;
  pub alphaToCoverageEnable u32 = FALSE;
  pub alphaToOneEnable u32 = FALSE;
}

pub struct StencilOpState {
  pub failOp u32 = 0u32;
  pub passOp u32 = 0u32;
  pub depthFailOp u32 = 0u32;
  pub compareOp u32 = 0u32;
  pub compareMask u32 = 0u32;
  pub writeMask u32 = 0u32;
  pub reference u32 = 0u32;
}

pub struct PipelineDepthStencilStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub depthTestEnable u32 = FALSE;
  pub depthWriteEnable u32 = FALSE;
  pub depthCompareOp u32 = COMPARE_OP_LESS;
  pub depthBoundsTestEnable u32 = FALSE;
  pub stencilTestEnable u32 = FALSE;
  pub front StencilOpState;
  pub back StencilOpState;
  pub minDepthBounds f32 = 0.;
  pub maxDepthBounds f32 = 1.;
}

pub struct PipelineColorBlendAttachmentState {
  pub blendEnable u32 = FALSE;
  pub srcColorBlendFactor u32 = BLEND_FACTOR_ONE;
  pub dstColorBlendFactor u32 = BLEND_FACTOR_ZERO;
  pub colorBlendOp u32 = BLEND_OP_ADD;
  pub srcAlphaBlendFactor u32 = BLEND_FACTOR_ONE;
  pub dstAlphaBlendFactor u32 = BLEND_FACTOR_ZERO;
  pub alphaBlendOp u32 = BLEND_OP_ADD;
  pub colorWriteMask u32 = COLOR_COMPONENT_ALL;
}

pub struct PipelineColorBlendStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub logicOpEnable u32 = FALSE;
  pub logicOp u32 = 0u32;
  pub attachmentCount u32 = 0u32;
  pub pAttachments *PipelineColorBlendAttachmentState;
  pub blendConstants Array[f32, 4];
}

pub struct PipelineDynamicStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub dynamicStateCount u32 = 0u32;
  pub pDynamicStates *u32;
}

// Chained from a GraphicsPipelineCreateInfo: the attachments' formats, for
// dynamic rendering, in place of a render pass
pub struct PipelineRenderingCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub viewMask u32 = 0u32;
  pub colorAttachmentCount u32 = 0u32;
  pub pColorAttachmentFormats *u32;
  pub depthAttachmentFormat u32 = FORMAT_UNDEFINED;
  pub stencilAttachmentFormat u32 = FORMAT_UNDEFINED;
}

pub struct GraphicsPipelineCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub stageCount u32 = 0u32;
  pub pStages *PipelineShaderStageCreateInfo;
  pub pVertexInputState *PipelineVertexInputStateCreateInfo;
  pub pInputAssemblyState *PipelineInputAssemblyStateCreateInfo;
  pub pTessellationState *u8;
  pub pViewportState *PipelineViewportStateCreateInfo;
  pub pRasterizationState *PipelineRasterizationStateCreateInfo;
  pub pMultisampleState *PipelineMultisampleStateCreateInfo;
  pub pDepthStencilState *PipelineDepthStencilStateCreateInfo;
  pub pColorBlendState *PipelineColorBlendStateCreateInfo;
  pub pDynamicState *PipelineDynamicStateCreateInfo;
  pub layout PipelineLayout;
  pub renderPass RenderPass;              // null with dynamic rendering
  pub subpass u32 = 0u32;
  pub basePipelineHandle Pipeline;
  pub basePipelineIndex i32 = -1i32;
}

pub struct ComputePipelineCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub stage PipelineShaderStageCreateInfo;
  pub layout PipelineLayout;
  pub basePipelineHandle Pipeline;
  pub basePipelineIndex i32 = -1i32;
}

// What an indirect dispatch or draw reads from its buffer
pub struct DispatchIndirectCommand { pub x u32; pub y u32; pub z u32; }
pub struct DrawIndirectCommand {
  pub vertexCount u32;
  pub instanceCount u32;
  pub firstVertex u32;
  pub firstInstance u32;
}
pub struct DrawIndexedIndirectCommand {
  pub indexCount u32;
  pub instanceCount u32;
  pub firstIndex u32;
  pub vertexOffset i32;
  pub firstInstance u32;
}

pub struct QueryPoolCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub queryType u32 = QUERY_TYPE_TIMESTAMP;
  pub queryCount u32 = 0u32;
  pub pipelineStatistics u32 = 0u32;
}

pub struct PushConstantRange { pub stageFlags u32; pub offset u32; pub size u32; }

pub struct PipelineLayoutCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub setLayoutCount u32 = 0u32;
  pub pSetLayouts *DescriptorSetLayout;
  pub pushConstantRangeCount u32 = 0u32;
  pub pPushConstantRanges *PushConstantRange;
}

pub struct DescriptorSetLayoutBinding {
  pub binding u32 = 0u32;
  pub descriptorType u32 = 0u32;
  pub descriptorCount u32 = 1u32;
  pub stageFlags u32 = 0u32;
  pub pImmutableSamplers *Sampler;
}

pub struct DescriptorSetLayoutCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub bindingCount u32 = 0u32;
  pub pBindings *DescriptorSetLayoutBinding;
}

pub struct DescriptorPoolSize { pub type u32; pub descriptorCount u32; }

pub struct DescriptorPoolCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub maxSets u32 = 0u32;
  pub poolSizeCount u32 = 0u32;
  pub pPoolSizes *DescriptorPoolSize;
}

pub struct DescriptorSetAllocateInfo {
  pub sType u32 = STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub descriptorPool DescriptorPool;
  pub descriptorSetCount u32 = 0u32;
  pub pSetLayouts *DescriptorSetLayout;
}

// How a sampler reads a texture: its filters, how coordinates outside 0 to 1
// wrap, and the mip levels it may use
pub struct SamplerCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub magFilter u32 = FILTER_NEAREST;
  pub minFilter u32 = FILTER_NEAREST;
  pub mipmapMode u32 = SAMPLER_MIPMAP_MODE_NEAREST;
  pub addressModeU u32 = SAMPLER_ADDRESS_MODE_REPEAT;
  pub addressModeV u32 = SAMPLER_ADDRESS_MODE_REPEAT;
  pub addressModeW u32 = SAMPLER_ADDRESS_MODE_REPEAT;
  pub mipLodBias f32 = 0.;
  pub anisotropyEnable u32 = 0u32;
  pub maxAnisotropy f32 = 1.;
  pub compareEnable u32 = 0u32;
  pub compareOp u32 = 0u32;
  pub minLod f32 = 0.;
  pub maxLod f32 = 0.;
  pub borderColor u32 = 0u32;
  pub unnormalizedCoordinates u32 = 0u32;
}

pub struct DescriptorBufferInfo { pub buffer Buffer; pub offset u64; pub range u64; }
pub struct DescriptorImageInfo { pub sampler Sampler; pub imageView ImageView; pub imageLayout u32; }

pub struct WriteDescriptorSet {
  pub sType u32 = STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
  pub pNext *u8 = 0usize as *u8;
  pub dstSet DescriptorSet;
  pub dstBinding u32 = 0u32;
  pub dstArrayElement u32 = 0u32;
  pub descriptorCount u32 = 0u32;
  pub descriptorType u32 = 0u32;
  pub pImageInfo *DescriptorImageInfo;
  pub pBufferInfo *DescriptorBufferInfo;
  pub pTexelBufferView *u64;
}
