// ---- The instance-level functions ----

// The functions of one instance, found for it by 'InstanceFns.load': those
// taking an Instance or a PhysicalDevice, vkGetDeviceProcAddr (through which a
// device's are found), surfaces' (VK_KHR_surface), and the debug messenger's
// (VK_EXT_debug_utils) if that was enabled on the instance, those two alone
// optional. It belongs to the instance it was found for: another instance
// has a table of its own.
pub struct InstanceFns {
  pfnGetDeviceProcAddr: usize = 0usize;
  pfnDestroyInstance: usize = 0usize;
  pfnEnumeratePhysicalDevices: usize = 0usize;
  pfnGetPhysicalDeviceProperties: usize = 0usize;
  pfnGetPhysicalDeviceFeatures2: usize = 0usize;
  pfnGetPhysicalDeviceProperties2: usize = 0usize;
  pfnGetPhysicalDeviceQueueFamilyProperties: usize = 0usize;
  pfnGetPhysicalDeviceMemoryProperties: usize = 0usize;
  pfnEnumerateDeviceExtensionProperties: usize = 0usize;
  pfnCreateDevice: usize = 0usize;
  pfnDestroySurfaceKHR: usize = 0usize;
  pfnGetPhysicalDeviceSurfaceSupportKHR: usize = 0usize;
  pfnGetPhysicalDeviceSurfaceCapabilitiesKHR: usize = 0usize;
  pfnGetPhysicalDeviceSurfaceFormatsKHR: usize = 0usize;
  pfnGetPhysicalDeviceSurfacePresentModesKHR: usize = 0usize;
  pfnCreateDebugUtilsMessengerEXT: usize = 0usize;
  pfnDestroyDebugUtilsMessengerEXT: usize = 0usize;
  // How many required functions were not found
  pub missing: u32 = 0u32;

  // Find the functions of 'instance' through the OS loader's
  // vkGetInstanceProcAddr, which the module's 'init' found. 'missing' is how
  // many required ones were not found (all of them, when there is no Vulkan)
  pub fn load(instance: Instance) InstanceFns {
    InstanceFns.loadWith(globals.pfnGetInstanceProcAddr as *u8 as PFN_GetInstanceProcAddr, instance)
  }

  // The same through any vkGetInstanceProcAddr (a test's stand-in)
  pub fn loadWith(getInstanceProcAddr: PFN_GetInstanceProcAddr, instance: Instance) InstanceFns {
    var t = new InstanceFns();
    if getInstanceProcAddr as usize == 0usize { t.missing = 15u32; return t; }
    var missing = 0u32;
    t.pfnGetDeviceProcAddr = lookup(getInstanceProcAddr, instance, &"vkGetDeviceProcAddr" as *u8);
    if t.pfnGetDeviceProcAddr == 0usize { missing = missing + 1u32; }
    t.pfnDestroyInstance = lookup(getInstanceProcAddr, instance, &"vkDestroyInstance" as *u8);
    if t.pfnDestroyInstance == 0usize { missing = missing + 1u32; }
    t.pfnEnumeratePhysicalDevices = lookup(getInstanceProcAddr, instance, &"vkEnumeratePhysicalDevices" as *u8);
    if t.pfnEnumeratePhysicalDevices == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceProperties = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceProperties" as *u8);
    if t.pfnGetPhysicalDeviceProperties == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceFeatures2 = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceFeatures2" as *u8);
    if t.pfnGetPhysicalDeviceFeatures2 == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceProperties2 = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceProperties2" as *u8);
    if t.pfnGetPhysicalDeviceProperties2 == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceQueueFamilyProperties = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceQueueFamilyProperties" as *u8);
    if t.pfnGetPhysicalDeviceQueueFamilyProperties == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceMemoryProperties = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceMemoryProperties" as *u8);
    if t.pfnGetPhysicalDeviceMemoryProperties == 0usize { missing = missing + 1u32; }
    t.pfnEnumerateDeviceExtensionProperties = lookup(getInstanceProcAddr, instance, &"vkEnumerateDeviceExtensionProperties" as *u8);
    if t.pfnEnumerateDeviceExtensionProperties == 0usize { missing = missing + 1u32; }
    t.pfnCreateDevice = lookup(getInstanceProcAddr, instance, &"vkCreateDevice" as *u8);
    if t.pfnCreateDevice == 0usize { missing = missing + 1u32; }
    t.pfnDestroySurfaceKHR = lookup(getInstanceProcAddr, instance, &"vkDestroySurfaceKHR" as *u8);
    if t.pfnDestroySurfaceKHR == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceSurfaceSupportKHR = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceSurfaceSupportKHR" as *u8);
    if t.pfnGetPhysicalDeviceSurfaceSupportKHR == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceSurfaceCapabilitiesKHR = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceSurfaceCapabilitiesKHR" as *u8);
    if t.pfnGetPhysicalDeviceSurfaceCapabilitiesKHR == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceSurfaceFormatsKHR = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceSurfaceFormatsKHR" as *u8);
    if t.pfnGetPhysicalDeviceSurfaceFormatsKHR == 0usize { missing = missing + 1u32; }
    t.pfnGetPhysicalDeviceSurfacePresentModesKHR = lookup(getInstanceProcAddr, instance, &"vkGetPhysicalDeviceSurfacePresentModesKHR" as *u8);
    if t.pfnGetPhysicalDeviceSurfacePresentModesKHR == 0usize { missing = missing + 1u32; }
    t.pfnCreateDebugUtilsMessengerEXT = lookup(getInstanceProcAddr, instance, &"vkCreateDebugUtilsMessengerEXT" as *u8);
    t.pfnDestroyDebugUtilsMessengerEXT = lookup(getInstanceProcAddr, instance, &"vkDestroyDebugUtilsMessengerEXT" as *u8);
    t.missing = missing;
    t
  }

  // Whether the debug messenger's functions were found (VK_EXT_debug_utils was
  // enabled on the instance 'load' was given)
  pub fn hasDebugUtils(self: &) bool {
    pfnCreateDebugUtilsMessengerEXT != 0usize && pfnDestroyDebugUtilsMessengerEXT != 0usize
  }

  pub fn getDeviceProcAddr(self: &, device: Device, pName: *u8) *u8 {
    (pfnGetDeviceProcAddr as *u8 as PFN_GetDeviceProcAddr)(device, pName)
  }
  pub fn destroyInstance(self: &, instance: Instance, pAllocator: *u8) {
    (pfnDestroyInstance as *u8 as PFN_DestroyInstance)(instance, pAllocator);
  }
  pub fn enumeratePhysicalDevices(self: &, instance: Instance, pPhysicalDeviceCount: &mut u32, pPhysicalDevices: *PhysicalDevice) i32 {
    (pfnEnumeratePhysicalDevices as *u8 as PFN_EnumeratePhysicalDevices)(instance, pPhysicalDeviceCount, pPhysicalDevices)
  }
  pub fn getPhysicalDeviceProperties(self: &, physicalDevice: PhysicalDevice, pProperties: &mut PhysicalDeviceProperties) {
    (pfnGetPhysicalDeviceProperties as *u8 as PFN_GetPhysicalDeviceProperties)(physicalDevice, pProperties);
  }
  pub fn getPhysicalDeviceFeatures2(self: &, physicalDevice: PhysicalDevice, pFeatures: &mut PhysicalDeviceFeatures2) {
    (pfnGetPhysicalDeviceFeatures2 as *u8 as PFN_GetPhysicalDeviceFeatures2)(physicalDevice, pFeatures);
  }
  pub fn getPhysicalDeviceProperties2(self: &, physicalDevice: PhysicalDevice, pProperties: &mut PhysicalDeviceProperties2) {
    (pfnGetPhysicalDeviceProperties2 as *u8 as PFN_GetPhysicalDeviceProperties2)(physicalDevice, pProperties);
  }
  pub fn getPhysicalDeviceQueueFamilyProperties(self: &, physicalDevice: PhysicalDevice, pQueueFamilyPropertyCount: &mut u32,
    pQueueFamilyProperties: *QueueFamilyProperties) {
    (pfnGetPhysicalDeviceQueueFamilyProperties as *u8 as PFN_GetPhysicalDeviceQueueFamilyProperties)(physicalDevice,
      pQueueFamilyPropertyCount, pQueueFamilyProperties);
  }
  pub fn getPhysicalDeviceMemoryProperties(self: &, physicalDevice: PhysicalDevice, pMemoryProperties: &mut PhysicalDeviceMemoryProperties) {
    (pfnGetPhysicalDeviceMemoryProperties as *u8 as PFN_GetPhysicalDeviceMemoryProperties)(physicalDevice, pMemoryProperties);
  }
  pub fn enumerateDeviceExtensionProperties(self: &, physicalDevice: PhysicalDevice, pLayerName: *u8, pPropertyCount: &mut u32,
    pProperties: *ExtensionProperties) i32 {
    (pfnEnumerateDeviceExtensionProperties as *u8 as PFN_EnumerateDeviceExtensionProperties)(physicalDevice, pLayerName,
      pPropertyCount, pProperties)
  }
  pub fn createDevice(self: &, physicalDevice: PhysicalDevice, pCreateInfo: &DeviceCreateInfo, pAllocator: *u8, pDevice: &mut Device) i32 {
    (pfnCreateDevice as *u8 as PFN_CreateDevice)(physicalDevice, pCreateInfo, pAllocator, pDevice)
  }
  pub fn destroySurfaceKHR(self: &, instance: Instance, surface: SurfaceKHR, pAllocator: *u8) {
    (pfnDestroySurfaceKHR as *u8 as PFN_DestroySurfaceKHR)(instance, surface, pAllocator);
  }
  pub fn getPhysicalDeviceSurfaceSupportKHR(self: &, physicalDevice: PhysicalDevice, queueFamilyIndex: u32, surface: SurfaceKHR,
    pSupported: &mut u32) i32 {
    (pfnGetPhysicalDeviceSurfaceSupportKHR as *u8 as PFN_GetPhysicalDeviceSurfaceSupportKHR)(physicalDevice,
      queueFamilyIndex, surface, pSupported)
  }
  pub fn getPhysicalDeviceSurfaceCapabilitiesKHR(self: &, physicalDevice: PhysicalDevice, surface: SurfaceKHR,
    pSurfaceCapabilities: &mut SurfaceCapabilitiesKHR) i32 {
    (pfnGetPhysicalDeviceSurfaceCapabilitiesKHR as *u8 as PFN_GetPhysicalDeviceSurfaceCapabilitiesKHR)(physicalDevice,
      surface, pSurfaceCapabilities)
  }
  pub fn getPhysicalDeviceSurfaceFormatsKHR(self: &, physicalDevice: PhysicalDevice, surface: SurfaceKHR,
    pSurfaceFormatCount: &mut u32, pSurfaceFormats: *SurfaceFormatKHR) i32 {
    (pfnGetPhysicalDeviceSurfaceFormatsKHR as *u8 as PFN_GetPhysicalDeviceSurfaceFormatsKHR)(physicalDevice, surface,
      pSurfaceFormatCount, pSurfaceFormats)
  }
  pub fn getPhysicalDeviceSurfacePresentModesKHR(self: &, physicalDevice: PhysicalDevice, surface: SurfaceKHR,
    pPresentModeCount: &mut u32, pPresentModes: *u32) i32 {
    (pfnGetPhysicalDeviceSurfacePresentModesKHR as *u8 as PFN_GetPhysicalDeviceSurfacePresentModesKHR)(physicalDevice,
      surface, pPresentModeCount, pPresentModes)
  }
  pub fn createDebugUtilsMessengerEXT(self: &, instance: Instance, pCreateInfo: &DebugUtilsMessengerCreateInfoEXT, pAllocator: *u8,
    pMessenger: &mut DebugUtilsMessengerEXT) i32 {
    (pfnCreateDebugUtilsMessengerEXT as *u8 as PFN_CreateDebugUtilsMessengerEXT)(instance, pCreateInfo, pAllocator, pMessenger)
  }
  pub fn destroyDebugUtilsMessengerEXT(self: &, instance: Instance, messenger: DebugUtilsMessengerEXT, pAllocator: *u8) {
    (pfnDestroyDebugUtilsMessengerEXT as *u8 as PFN_DestroyDebugUtilsMessengerEXT)(instance, messenger, pAllocator);
  }
}
