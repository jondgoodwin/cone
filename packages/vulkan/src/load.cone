// ---- The addresses, 0 until loaded ----

mut pfnGetInstanceProcAddr usize = 0usize;
mut pfnGetDeviceProcAddr usize = 0usize;
mut missingCount = 0u32;

mut pfnEnumerateInstanceVersion usize = 0usize;
mut pfnEnumerateInstanceExtensionProperties usize = 0usize;
mut pfnEnumerateInstanceLayerProperties usize = 0usize;
mut pfnCreateInstance usize = 0usize;

mut pfnDestroyInstance usize = 0usize;
mut pfnEnumeratePhysicalDevices usize = 0usize;
mut pfnGetPhysicalDeviceProperties usize = 0usize;
mut pfnGetPhysicalDeviceFeatures2 usize = 0usize;
mut pfnGetPhysicalDeviceQueueFamilyProperties usize = 0usize;
mut pfnGetPhysicalDeviceMemoryProperties usize = 0usize;
mut pfnEnumerateDeviceExtensionProperties usize = 0usize;
mut pfnCreateDevice usize = 0usize;
mut pfnDestroySurfaceKHR usize = 0usize;
mut pfnGetPhysicalDeviceSurfaceSupportKHR usize = 0usize;
mut pfnGetPhysicalDeviceSurfaceCapabilitiesKHR usize = 0usize;
mut pfnGetPhysicalDeviceSurfaceFormatsKHR usize = 0usize;
mut pfnGetPhysicalDeviceSurfacePresentModesKHR usize = 0usize;
mut pfnCreateDebugUtilsMessengerEXT usize = 0usize;
mut pfnDestroyDebugUtilsMessengerEXT usize = 0usize;

mut pfnDestroyDevice usize = 0usize;
mut pfnGetDeviceQueue usize = 0usize;
mut pfnDeviceWaitIdle usize = 0usize;
mut pfnQueueWaitIdle usize = 0usize;
mut pfnCreateSwapchainKHR usize = 0usize;
mut pfnDestroySwapchainKHR usize = 0usize;
mut pfnGetSwapchainImagesKHR usize = 0usize;
mut pfnAcquireNextImageKHR usize = 0usize;
mut pfnQueuePresentKHR usize = 0usize;
mut pfnCreateImage usize = 0usize;
mut pfnDestroyImage usize = 0usize;
mut pfnGetImageMemoryRequirements usize = 0usize;
mut pfnBindImageMemory usize = 0usize;
mut pfnCreateImageView usize = 0usize;
mut pfnDestroyImageView usize = 0usize;
mut pfnCreateCommandPool usize = 0usize;
mut pfnDestroyCommandPool usize = 0usize;
mut pfnResetCommandPool usize = 0usize;
mut pfnAllocateCommandBuffers usize = 0usize;
mut pfnFreeCommandBuffers usize = 0usize;
mut pfnBeginCommandBuffer usize = 0usize;
mut pfnEndCommandBuffer usize = 0usize;
mut pfnCreateFence usize = 0usize;
mut pfnDestroyFence usize = 0usize;
mut pfnWaitForFences usize = 0usize;
mut pfnResetFences usize = 0usize;
mut pfnCreateSemaphore usize = 0usize;
mut pfnDestroySemaphore usize = 0usize;
mut pfnQueueSubmit2 usize = 0usize;
mut pfnCmdPipelineBarrier2 usize = 0usize;
mut pfnCmdBeginRendering usize = 0usize;
mut pfnCmdEndRendering usize = 0usize;
mut pfnCreateBuffer usize = 0usize;
mut pfnDestroyBuffer usize = 0usize;
mut pfnGetBufferMemoryRequirements usize = 0usize;
mut pfnAllocateMemory usize = 0usize;
mut pfnFreeMemory usize = 0usize;
mut pfnBindBufferMemory usize = 0usize;
mut pfnMapMemory usize = 0usize;
mut pfnUnmapMemory usize = 0usize;
mut pfnCmdCopyBuffer usize = 0usize;
mut pfnCmdCopyImageToBuffer usize = 0usize;
mut pfnCmdCopyBufferToImage usize = 0usize;
mut pfnCreateShaderModule usize = 0usize;
mut pfnDestroyShaderModule usize = 0usize;
mut pfnCreateSampler usize = 0usize;
mut pfnDestroySampler usize = 0usize;
mut pfnCreatePipelineLayout usize = 0usize;
mut pfnDestroyPipelineLayout usize = 0usize;
mut pfnCreateGraphicsPipelines usize = 0usize;
mut pfnDestroyPipeline usize = 0usize;
mut pfnCreateDescriptorSetLayout usize = 0usize;
mut pfnDestroyDescriptorSetLayout usize = 0usize;
mut pfnCreateDescriptorPool usize = 0usize;
mut pfnDestroyDescriptorPool usize = 0usize;
mut pfnAllocateDescriptorSets usize = 0usize;
mut pfnUpdateDescriptorSets usize = 0usize;
mut pfnCmdBindPipeline usize = 0usize;
mut pfnCmdBindDescriptorSets usize = 0usize;
mut pfnCmdBindVertexBuffers usize = 0usize;
mut pfnCmdBindIndexBuffer usize = 0usize;
mut pfnCmdSetViewport usize = 0usize;
mut pfnCmdSetScissor usize = 0usize;
mut pfnCmdPushConstants usize = 0usize;
mut pfnCmdDraw usize = 0usize;
mut pfnCmdDrawIndexed usize = 0usize;
mut pfnCmdDrawIndirect usize = 0usize;
mut pfnCmdDrawIndexedIndirect usize = 0usize;
mut pfnCreateComputePipelines usize = 0usize;
mut pfnCmdDispatch usize = 0usize;
mut pfnCmdDispatchIndirect usize = 0usize;
