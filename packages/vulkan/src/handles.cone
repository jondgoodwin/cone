// ---- Versions ----

// VK_MAKE_API_VERSION(0, major, minor, patch)
pub fn makeApiVersion(major u32, minor u32, patch u32) u32 {
  (major << 22u32) | (minor << 12u32) | patch;
}
pub fn apiVersionMajor(v u32) u32 { (v >> 22u32) & 0x7Fu32; }
pub fn apiVersionMinor(v u32) u32 { (v >> 12u32) & 0x3FFu32; }
pub fn apiVersionPatch(v u32) u32 { v & 0xFFFu32; }

pub const API_VERSION_1_0 = 4194304u32;   // makeApiVersion(1, 0, 0)
pub const API_VERSION_1_1 = 4198400u32;
pub const API_VERSION_1_2 = 4202496u32;
pub const API_VERSION_1_3 = 4206592u32;

// ---- Handles ----

pub struct @opaque Instance_T {}
pub struct @opaque PhysicalDevice_T {}
pub struct @opaque Device_T {}
pub struct @opaque Queue_T {}
pub struct @opaque CommandBuffer_T {}
pub typedef Instance *Instance_T;
pub typedef PhysicalDevice *PhysicalDevice_T;
pub typedef Device *Device_T;
pub typedef Queue *Queue_T;
pub typedef CommandBuffer *CommandBuffer_T;

pub struct SurfaceKHR { pub h u64; }
pub struct SwapchainKHR { pub h u64; }
pub struct DebugUtilsMessengerEXT { pub h u64; }
pub struct Image { pub h u64; }
pub struct ImageView { pub h u64; }
pub struct Buffer { pub h u64; }
pub struct DeviceMemory { pub h u64; }
pub struct CommandPool { pub h u64; }
pub struct Fence { pub h u64; }
pub struct Semaphore { pub h u64; }
pub struct ShaderModule { pub h u64; }
pub struct PipelineLayout { pub h u64; }
pub struct Pipeline { pub h u64; }
pub struct PipelineCache { pub h u64; }
pub struct RenderPass { pub h u64; }
pub struct DescriptorSetLayout { pub h u64; }
pub struct DescriptorPool { pub h u64; }
pub struct DescriptorSet { pub h u64; }
pub struct Sampler { pub h u64; }

// ---- Results ----

// VkResult. 'resultName' spells one as the specification does.
pub const SUCCESS = 0i32;
pub const NOT_READY = 1i32;
pub const TIMEOUT = 2i32;
pub const EVENT_SET = 3i32;
pub const EVENT_RESET = 4i32;
pub const INCOMPLETE = 5i32;
pub const ERROR_OUT_OF_HOST_MEMORY = -1i32;
pub const ERROR_OUT_OF_DEVICE_MEMORY = -2i32;
pub const ERROR_INITIALIZATION_FAILED = -3i32;
pub const ERROR_DEVICE_LOST = -4i32;
pub const ERROR_MEMORY_MAP_FAILED = -5i32;
pub const ERROR_LAYER_NOT_PRESENT = -6i32;
pub const ERROR_EXTENSION_NOT_PRESENT = -7i32;
pub const ERROR_FEATURE_NOT_PRESENT = -8i32;
pub const ERROR_INCOMPATIBLE_DRIVER = -9i32;
pub const ERROR_TOO_MANY_OBJECTS = -10i32;
pub const ERROR_FORMAT_NOT_SUPPORTED = -11i32;
pub const ERROR_FRAGMENTED_POOL = -12i32;
pub const ERROR_UNKNOWN = -13i32;
pub const ERROR_OUT_OF_POOL_MEMORY = -1000069000i32;
pub const ERROR_INVALID_EXTERNAL_HANDLE = -1000072003i32;
pub const ERROR_FRAGMENTATION = -1000161000i32;
pub const ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS = -1000257000i32;
pub const PIPELINE_COMPILE_REQUIRED = 1000297000i32;
pub const ERROR_SURFACE_LOST_KHR = -1000000000i32;
pub const ERROR_NATIVE_WINDOW_IN_USE_KHR = -1000000001i32;
pub const SUBOPTIMAL_KHR = 1000001003i32;
pub const ERROR_OUT_OF_DATE_KHR = -1000001004i32;
pub const ERROR_INCOMPATIBLE_DISPLAY_KHR = -1000003001i32;
pub const ERROR_VALIDATION_FAILED_EXT = -1000011001i32;

// A VkResult's name, without the VK_ prefix; "unknown VkResult" for a value
// this package does not list
pub fn resultName(r i32) &[]u8 {
  if r == SUCCESS { return "SUCCESS"; }
  if r == NOT_READY { return "NOT_READY"; }
  if r == TIMEOUT { return "TIMEOUT"; }
  if r == EVENT_SET { return "EVENT_SET"; }
  if r == EVENT_RESET { return "EVENT_RESET"; }
  if r == INCOMPLETE { return "INCOMPLETE"; }
  if r == ERROR_OUT_OF_HOST_MEMORY { return "ERROR_OUT_OF_HOST_MEMORY"; }
  if r == ERROR_OUT_OF_DEVICE_MEMORY { return "ERROR_OUT_OF_DEVICE_MEMORY"; }
  if r == ERROR_INITIALIZATION_FAILED { return "ERROR_INITIALIZATION_FAILED"; }
  if r == ERROR_DEVICE_LOST { return "ERROR_DEVICE_LOST"; }
  if r == ERROR_MEMORY_MAP_FAILED { return "ERROR_MEMORY_MAP_FAILED"; }
  if r == ERROR_LAYER_NOT_PRESENT { return "ERROR_LAYER_NOT_PRESENT"; }
  if r == ERROR_EXTENSION_NOT_PRESENT { return "ERROR_EXTENSION_NOT_PRESENT"; }
  if r == ERROR_FEATURE_NOT_PRESENT { return "ERROR_FEATURE_NOT_PRESENT"; }
  if r == ERROR_INCOMPATIBLE_DRIVER { return "ERROR_INCOMPATIBLE_DRIVER"; }
  if r == ERROR_TOO_MANY_OBJECTS { return "ERROR_TOO_MANY_OBJECTS"; }
  if r == ERROR_FORMAT_NOT_SUPPORTED { return "ERROR_FORMAT_NOT_SUPPORTED"; }
  if r == ERROR_FRAGMENTED_POOL { return "ERROR_FRAGMENTED_POOL"; }
  if r == ERROR_UNKNOWN { return "ERROR_UNKNOWN"; }
  if r == ERROR_OUT_OF_POOL_MEMORY { return "ERROR_OUT_OF_POOL_MEMORY"; }
  if r == ERROR_INVALID_EXTERNAL_HANDLE { return "ERROR_INVALID_EXTERNAL_HANDLE"; }
  if r == ERROR_FRAGMENTATION { return "ERROR_FRAGMENTATION"; }
  if r == ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS { return "ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS"; }
  if r == PIPELINE_COMPILE_REQUIRED { return "PIPELINE_COMPILE_REQUIRED"; }
  if r == ERROR_SURFACE_LOST_KHR { return "ERROR_SURFACE_LOST_KHR"; }
  if r == ERROR_NATIVE_WINDOW_IN_USE_KHR { return "ERROR_NATIVE_WINDOW_IN_USE_KHR"; }
  if r == SUBOPTIMAL_KHR { return "SUBOPTIMAL_KHR"; }
  if r == ERROR_OUT_OF_DATE_KHR { return "ERROR_OUT_OF_DATE_KHR"; }
  if r == ERROR_INCOMPATIBLE_DISPLAY_KHR { return "ERROR_INCOMPATIBLE_DISPLAY_KHR"; }
  if r == ERROR_VALIDATION_FAILED_EXT { return "ERROR_VALIDATION_FAILED_EXT"; }
  "unknown VkResult";
}
