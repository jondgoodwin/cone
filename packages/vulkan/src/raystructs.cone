// ---- Ray tracing: VK_KHR_acceleration_structure and VK_KHR_ray_query ----
//
// The structs and constants of the two extensions (and of buffer device
// addresses, which they stand on) that a ray query in a shader needs:
// bottom-level acceleration structures over triangle meshes, one top-level
// one over their instances, and the feature structs that turn them on.
//
// A VkDeviceOrHostAddressKHR is a union of a device address (u64) and a host
// pointer; only the device address is used, so each is a u64 here. The
// geometry's union is written as two structs, one for triangles and one for
// instances, each as large as the union (64 bytes), passed through a '*u8';
// an instance's two bit-field words are packed by hand (see
// AccelerationStructureInstanceKHR).

pub struct AccelerationStructureKHR { pub h u64; }

pub const STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO = 1000060000u32;
pub const STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES = 1000257000u32;
pub const STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO = 1000244001u32;
pub const STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_ACCELERATION_STRUCTURE_KHR = 1000150007u32;
pub const STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR = 1000150000u32;
pub const STRUCTURE_TYPE_ACCELERATION_STRUCTURE_DEVICE_ADDRESS_INFO_KHR = 1000150002u32;
pub const STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR = 1000150004u32;
pub const STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR = 1000150005u32;
pub const STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR = 1000150006u32;
pub const STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_KHR = 1000150017u32;
pub const STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR = 1000150020u32;
pub const STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_FEATURES_KHR = 1000150013u32;
pub const STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_QUERY_FEATURES_KHR = 1000348013u32;

pub const MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT = 0x2u32;
pub const BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT = 0x20000u32;
pub const BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR = 0x80000u32;
pub const BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE_BIT_KHR = 0x100000u32;
pub const DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR = 1000150000u32;
pub const PIPELINE_STAGE_2_ACCELERATION_STRUCTURE_BUILD_BIT_KHR = 0x2000000u64;

// VkAccelerationStructureTypeKHR, VkGeometryTypeKHR, VkBuildAccelerationStructureModeKHR,
// VkAccelerationStructureBuildTypeKHR, VkIndexType
pub const ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR = 0u32;
pub const ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR = 1u32;
pub const GEOMETRY_TYPE_TRIANGLES_KHR = 0u32;
pub const GEOMETRY_TYPE_INSTANCES_KHR = 2u32;
pub const BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR = 0u32;
pub const ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR = 1u32;
// VkBuildAccelerationStructureFlagBitsKHR, VkGeometryFlagBitsKHR, VkGeometryInstanceFlagBitsKHR
pub const BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT_KHR = 0x1u32;
pub const BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT_KHR = 0x2u32;
pub const GEOMETRY_OPAQUE_BIT_KHR = 0x1u32;
pub const GEOMETRY_INSTANCE_TRIANGLE_FACING_CULL_DISABLE_BIT_KHR = 0x1u32;
pub const GEOMETRY_INSTANCE_FORCE_OPAQUE_BIT_KHR = 0x4u32;

pub struct PhysicalDeviceBufferDeviceAddressFeatures {
  pub sType u32 = STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES;
  pub pNext *u8 = null;
  pub bufferDeviceAddress u32 = 0u32;
  pub bufferDeviceAddressCaptureReplay u32 = 0u32;
  pub bufferDeviceAddressMultiDevice u32 = 0u32;
}

pub struct PhysicalDeviceAccelerationStructureFeaturesKHR {
  pub sType u32 = STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_FEATURES_KHR;
  pub pNext *u8 = null;
  pub accelerationStructure u32 = 0u32;
  pub accelerationStructureCaptureReplay u32 = 0u32;
  pub accelerationStructureIndirectBuild u32 = 0u32;
  pub accelerationStructureHostCommands u32 = 0u32;
  pub descriptorBindingAccelerationStructureUpdateAfterBind u32 = 0u32;
}

pub struct PhysicalDeviceRayQueryFeaturesKHR {
  pub sType u32 = STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_QUERY_FEATURES_KHR;
  pub pNext *u8 = null;
  pub rayQuery u32 = 0u32;
}

pub struct MemoryAllocateFlagsInfo {
  pub sType u32 = STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO;
  pub pNext *u8 = null;
  pub flags u32 = 0u32;
  pub deviceMask u32 = 0u32;
}

pub struct BufferDeviceAddressInfo {
  pub sType u32 = STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO;
  pub pNext *u8 = null;
  pub buffer Buffer;
}

pub struct AccelerationStructureCreateInfoKHR {
  pub sType u32 = STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_KHR;
  pub pNext *u8 = null;
  pub createFlags u32 = 0u32;
  pub buffer Buffer;
  pub offset u64 = 0u64;
  pub size u64 = 0u64;
  pub type u32 = 0u32;
  pub deviceAddress u64 = 0u64;
}

pub struct AccelerationStructureDeviceAddressInfoKHR {
  pub sType u32 = STRUCTURE_TYPE_ACCELERATION_STRUCTURE_DEVICE_ADDRESS_INFO_KHR;
  pub pNext *u8 = null;
  pub accelerationStructure AccelerationStructureKHR;
}

// VkAccelerationStructureGeometryKHR for triangles: the geometry union's
// triangles member written out (vertexData, indexData and transformData are
// device addresses; transformData 0: none)
pub struct AccelerationStructureGeometryTrianglesKHR {
  pub sType u32 = STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR;
  pub pNext *u8 = null;
  pub geometryType u32 = GEOMETRY_TYPE_TRIANGLES_KHR;
  pub unionPad u32 = 0u32;           // the union starts on an 8-byte boundary
  pub trianglesSType u32 = STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR;
  pub trianglesPNext *u8 = null;
  pub vertexFormat u32 = FORMAT_R32G32B32_SFLOAT;
  pub vertexData u64 = 0u64;
  pub vertexStride u64 = 12u64;
  pub maxVertex u32 = 0u32;
  pub indexType u32 = INDEX_TYPE_UINT32;
  pub indexData u64 = 0u64;
  pub transformData u64 = 0u64;
  pub flags u32 = 0u32;
}

// VkAccelerationStructureGeometryKHR for instances: the union's instances
// member, padded to the union's size
pub struct AccelerationStructureGeometryInstancesKHR {
  pub sType u32 = STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR;
  pub pNext *u8 = null;
  pub geometryType u32 = GEOMETRY_TYPE_INSTANCES_KHR;
  pub unionPad u32 = 0u32;
  pub instancesSType u32 = STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR;
  pub instancesPNext *u8 = null;
  pub arrayOfPointers u32 = 0u32;
  pub data u64 = 0u64;
  pub unused0 u64 = 0u64;
  pub unused1 u64 = 0u64;
  pub unused2 u64 = 0u64;
  pub unused3 u64 = 0u64;
  pub flags u32 = 0u32;
}

pub struct AccelerationStructureBuildGeometryInfoKHR {
  pub sType u32 = STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR;
  pub pNext *u8 = null;
  pub type u32 = 0u32;
  pub flags u32 = 0u32;
  pub mode u32 = BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
  pub srcAccelerationStructure AccelerationStructureKHR;
  pub dstAccelerationStructure AccelerationStructureKHR;
  pub geometryCount u32 = 1u32;
  pub pGeometries *u8 = null;
  pub ppGeometries *u8 = null;
  pub scratchData u64 = 0u64;
}

pub struct AccelerationStructureBuildRangeInfoKHR {
  pub primitiveCount u32 = 0u32;
  pub primitiveOffset u32 = 0u32;
  pub firstVertex u32 = 0u32;
  pub transformOffset u32 = 0u32;
}

pub struct AccelerationStructureBuildSizesInfoKHR {
  pub sType u32 = STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR;
  pub pNext *u8 = null;
  pub accelerationStructureSize u64 = 0u64;
  pub updateScratchSize u64 = 0u64;
  pub buildScratchSize u64 = 0u64;
}

// VkAccelerationStructureInstanceKHR (64 bytes): a 3 x 4 row-major transform
// (object to world), then two words each holding a 24-bit and an 8-bit field
// ('instanceWord': the custom index below, the visibility mask above;
// 'flagsWord': the shader binding table offset below, the instance flags above)
pub struct AccelerationStructureInstanceKHR {
  pub transform Array[f32, 12];
  pub instanceWord u32;
  pub flagsWord u32;
  pub accelerationStructureReference u64;
}

pub struct WriteDescriptorSetAccelerationStructureKHR {
  pub sType u32 = STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_ACCELERATION_STRUCTURE_KHR;
  pub pNext *u8 = null;
  pub accelerationStructureCount u32 = 1u32;
  pub pAccelerationStructures *AccelerationStructureKHR;
}
