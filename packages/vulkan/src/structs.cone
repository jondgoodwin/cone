// ---- Structs: shared small ones ----

pub struct Extent2D { pub width: u32; pub height: u32; }
pub struct Extent3D { pub width: u32; pub height: u32; pub depth: u32; }
pub struct Offset2D { pub x: i32; pub y: i32; }
pub struct Offset3D { pub x: i32; pub y: i32; pub z: i32; }
pub struct Rect2D { pub offset: Offset2D; pub extent: Extent2D; }

// VkClearValue is a C union of a color (four floats, ints or uints) and a
// depth-stencil pair. Cone has no C union, so it is its storage, 16 bytes,
// written through 'clearColor' and 'clearDepthStencil', which is the exact
// size, alignment and layout of C's. VkClearColorValue is the same storage.
pub struct ClearValue { pub raw: Array[u32, 4]; }
pub alias ClearColorValue = ClearValue;

pub fn clearColor(r: f32, g: f32, b: f32, a: f32) ClearValue {
  var v = new ClearValue(new Array[u32, 4] <- fill 0u32);
  let p = &mut v as *f32;
  p[0] = r; p[1] = g; p[2] = b; p[3] = a;
  v
}

pub fn clearDepthStencil(depth: f32, stencil: u32) ClearValue {
  var v = new ClearValue(new Array[u32, 4] <- fill 0u32);
  let pd = &mut v as *f32;
  pd[0] = depth;
  let ps = &mut v as *u32;
  ps[1] = stencil;
  v
}

// ---- Structs: instance ----

pub struct ApplicationInfo {
  pub sType: u32 = STRUCTURE_TYPE_APPLICATION_INFO;
  pub pNext: *u8 = null;
  pub pApplicationName: *u8;
  pub applicationVersion: u32 = 0u32;
  pub pEngineName: *u8;
  pub engineVersion: u32 = 0u32;
  pub apiVersion: u32 = API_VERSION_1_3;
}

pub struct InstanceCreateInfo {
  pub sType: u32 = STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
  pub pNext: *u8 = null;
  pub flags: u32 = 0u32;
  pub pApplicationInfo: *ApplicationInfo;
  pub enabledLayerCount: u32 = 0u32;
  pub ppEnabledLayerNames: **u8;
  pub enabledExtensionCount: u32 = 0u32;
  pub ppEnabledExtensionNames: **u8;
}

pub struct ExtensionProperties {
  pub extensionName: Array[u8, 256];
  pub specVersion: u32;
}

pub struct LayerProperties {
  pub layerName: Array[u8, 256];
  pub specVersion: u32;
  pub implementationVersion: u32;
  pub description: Array[u8, 256];
}

// The debug messenger's callback: return FALSE. Vulkan calls it, so it is a
// C-named function: 'fn @c'
pub alias PFN_DebugUtilsMessengerCallbackEXT = &fn @c (messageSeverity: u32, messageTypes: u32,
  pCallbackData: *DebugUtilsMessengerCallbackDataEXT, pUserData: *u8) u32;

pub struct DebugUtilsMessengerCreateInfoEXT {
  pub sType: u32 = STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT;
  pub pNext: *u8 = null;
  pub flags: u32 = 0u32;
  pub messageSeverity: u32 = 0u32;
  pub messageType: u32 = 0u32;
  pub pfnUserCallback: PFN_DebugUtilsMessengerCallbackEXT;
  pub pUserData: *u8;
}

pub struct DebugUtilsMessengerCallbackDataEXT {
  pub sType: u32 = STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CALLBACK_DATA_EXT;
  pub pNext: *u8 = null;
  pub flags: u32 = 0u32;
  pub pMessageIdName: *u8;
  pub messageIdNumber: i32 = 0i32;
  pub pMessage: *u8;
  pub queueLabelCount: u32 = 0u32;
  pub pQueueLabels: *u8;
  pub cmdBufLabelCount: u32 = 0u32;
  pub pCmdBufLabels: *u8;
  pub objectCount: u32 = 0u32;
  pub pObjects: *u8;
}

// VK_EXT_layer_settings: settings for a layer, chained from an
// InstanceCreateInfo (the validation layer's "validate_sync", say)
pub const LAYER_SETTING_TYPE_BOOL32_EXT = 0u32;

pub struct LayerSettingEXT {
  pub pLayerName: *u8;
  pub pSettingName: *u8;
  pub type: u32 = LAYER_SETTING_TYPE_BOOL32_EXT;
  pub valueCount: u32 = 0u32;
  pub pValues: *u8;
}

pub struct LayerSettingsCreateInfoEXT {
  pub sType: u32 = STRUCTURE_TYPE_LAYER_SETTINGS_CREATE_INFO_EXT;
  pub pNext: *u8 = null;
  pub settingCount: u32 = 0u32;
  pub pSettings: *LayerSettingEXT;
}

