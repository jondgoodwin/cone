// VkPhysicalDeviceFeatures is 55 VkBool32s, kept here as their storage in the
// specification's order; a feature is spelled out when one is first needed.
pub struct PhysicalDeviceFeatures { pub raw Array[u32, 55]; }

pub struct PhysicalDeviceFeatures2 {
  pub sType u32 = STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
  pub pNext *u8 = 0usize as *u8;
