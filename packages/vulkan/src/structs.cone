// ---- Structs: surfaces and swapchains ----

pub struct SurfaceCapabilitiesKHR {
  pub minImageCount u32;
  pub maxImageCount u32;                 // 0: no limit
  pub currentExtent Extent2D;            // 0xFFFFFFFF each way: the swapchain decides
  pub minImageExtent Extent2D;
  pub maxImageExtent Extent2D;
  pub maxImageArrayLayers u32;
  pub supportedTransforms u32;
  pub currentTransform u32;
  pub supportedCompositeAlpha u32;
  pub supportedUsageFlags u32;
}

pub struct SurfaceFormatKHR { pub format u32; pub colorSpace u32; }

pub struct SwapchainCreateInfoKHR {
  pub sType u32 = STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub surface SurfaceKHR;
  pub minImageCount u32 = 0u32;
  pub imageFormat u32 = 0u32;
  pub imageColorSpace u32 = 0u32;
  pub imageExtent Extent2D;
  pub imageArrayLayers u32 = 1u32;
  pub imageUsage u32 = 0u32;
  pub imageSharingMode u32 = SHARING_MODE_EXCLUSIVE;
  pub queueFamilyIndexCount u32 = 0u32;
  pub pQueueFamilyIndices *u32;
  pub preTransform u32 = SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
  pub compositeAlpha u32 = COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
  pub presentMode u32 = PRESENT_MODE_FIFO_KHR;
  pub clipped u32 = TRUE;
  pub oldSwapchain SwapchainKHR;
}

