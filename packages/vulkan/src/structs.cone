// The debug messenger's callback: return FALSE
pub alias PFN_DebugUtilsMessengerCallbackEXT = &fn(messageSeverity u32, messageTypes u32,
  pCallbackData *DebugUtilsMessengerCallbackDataEXT, pUserData *u8) u32;

pub struct DebugUtilsMessengerCreateInfoEXT {
  pub sType u32 = STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub messageSeverity u32 = 0u32;
  pub messageType u32 = 0u32;
  pub pfnUserCallback PFN_DebugUtilsMessengerCallbackEXT;
  pub pUserData *u8;
}

pub struct DebugUtilsMessengerCallbackDataEXT {
  pub sType u32 = STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CALLBACK_DATA_EXT;
  pub pNext *u8 = 0usize as *u8;
  pub flags u32 = 0u32;
  pub pMessageIdName *u8;
  pub messageIdNumber i32 = 0i32;
  pub pMessage *u8;
  pub queueLabelCount u32 = 0u32;
  pub pQueueLabels *u8;
  pub cmdBufLabelCount u32 = 0u32;
  pub pCmdBufLabels *u8;
  pub objectCount u32 = 0u32;
  pub pObjects *u8;
}

// VK_EXT_layer_settings: settings for a layer, chained from an
// InstanceCreateInfo (the validation layer's "validate_sync", say)
pub const LAYER_SETTING_TYPE_BOOL32_EXT = 0u32;

pub struct LayerSettingEXT {
  pub pLayerName *u8;
  pub pSettingName *u8;
  pub type u32 = LAYER_SETTING_TYPE_BOOL32_EXT;
  pub valueCount u32 = 0u32;
  pub pValues *u8;
}

pub struct LayerSettingsCreateInfoEXT {
  pub sType u32 = STRUCTURE_TYPE_LAYER_SETTINGS_CREATE_INFO_EXT;
  pub pNext *u8 = 0usize as *u8;
  pub settingCount u32 = 0u32;
  pub pSettings *LayerSettingEXT;
}

