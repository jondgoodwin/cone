// ---- The ray-tracing functions of one device ----
//
// Found for a device made with VK_KHR_acceleration_structure enabled, apart
// from 'DeviceFns', so a device without it needs nothing here: 'found' says
// whether every one was.

pub alias PFN_GetBufferDeviceAddress = &fn @c (device: Device, pInfo: &BufferDeviceAddressInfo) u64;
pub alias PFN_CreateAccelerationStructureKHR = &fn @c (device: Device, pCreateInfo: &AccelerationStructureCreateInfoKHR,
  pAllocator: *u8, pAccelerationStructure: &mut AccelerationStructureKHR) i32;
pub alias PFN_DestroyAccelerationStructureKHR = &fn @c (device: Device, accelerationStructure: AccelerationStructureKHR,
  pAllocator: *u8);
pub alias PFN_GetAccelerationStructureBuildSizesKHR = &fn @c (device: Device, buildType: u32,
  pBuildInfo: &AccelerationStructureBuildGeometryInfoKHR, pMaxPrimitiveCounts: *u32,
  pSizeInfo: &mut AccelerationStructureBuildSizesInfoKHR);
pub alias PFN_CmdBuildAccelerationStructuresKHR = &fn @c (commandBuffer: CommandBuffer, infoCount: u32,
  pInfos: *AccelerationStructureBuildGeometryInfoKHR, ppBuildRangeInfos: **AccelerationStructureBuildRangeInfoKHR);
pub alias PFN_GetAccelerationStructureDeviceAddressKHR = &fn @c (device: Device,
  pInfo: &AccelerationStructureDeviceAddressInfoKHR) u64;

pub struct RayFns {
  pfnGetBufferDeviceAddress: usize = 0usize;
  pfnCreateAccelerationStructureKHR: usize = 0usize;
  pfnDestroyAccelerationStructureKHR: usize = 0usize;
  pfnGetAccelerationStructureBuildSizesKHR: usize = 0usize;
  pfnCmdBuildAccelerationStructuresKHR: usize = 0usize;
  pfnGetAccelerationStructureDeviceAddressKHR: usize = 0usize;
  // Whether every function was found
  pub found: bool = false;

  pub fn load(instance: &InstanceFns, device: Device) RayFns {
    var t = RayFns();
    t.pfnGetBufferDeviceAddress = instance.getDeviceProcAddr(device, &"vkGetBufferDeviceAddress" as *u8) as usize;
    t.pfnCreateAccelerationStructureKHR = instance.getDeviceProcAddr(device, &"vkCreateAccelerationStructureKHR" as *u8) as usize;
    t.pfnDestroyAccelerationStructureKHR = instance.getDeviceProcAddr(device, &"vkDestroyAccelerationStructureKHR" as *u8) as usize;
    t.pfnGetAccelerationStructureBuildSizesKHR = instance.getDeviceProcAddr(device, &"vkGetAccelerationStructureBuildSizesKHR" as *u8) as usize;
    t.pfnCmdBuildAccelerationStructuresKHR = instance.getDeviceProcAddr(device, &"vkCmdBuildAccelerationStructuresKHR" as *u8) as usize;
    t.pfnGetAccelerationStructureDeviceAddressKHR = instance.getDeviceProcAddr(device, &"vkGetAccelerationStructureDeviceAddressKHR" as *u8) as usize;
    t.found = t.pfnGetBufferDeviceAddress != 0usize && t.pfnCreateAccelerationStructureKHR != 0usize
      && t.pfnDestroyAccelerationStructureKHR != 0usize && t.pfnGetAccelerationStructureBuildSizesKHR != 0usize
      && t.pfnCmdBuildAccelerationStructuresKHR != 0usize && t.pfnGetAccelerationStructureDeviceAddressKHR != 0usize;
    t
  }

  pub fn getBufferDeviceAddress(self: &, device: Device, pInfo: &BufferDeviceAddressInfo) u64 {
    (pfnGetBufferDeviceAddress as *u8 as PFN_GetBufferDeviceAddress)(device, pInfo)
  }
  pub fn createAccelerationStructureKHR(self: &, device: Device, pCreateInfo: &AccelerationStructureCreateInfoKHR,
    pAllocator: *u8, pAccelerationStructure: &mut AccelerationStructureKHR) i32 {
    (pfnCreateAccelerationStructureKHR as *u8 as PFN_CreateAccelerationStructureKHR)(device, pCreateInfo, pAllocator,
      pAccelerationStructure)
  }
  pub fn destroyAccelerationStructureKHR(self: &, device: Device, accelerationStructure: AccelerationStructureKHR, pAllocator: *u8) {
    (pfnDestroyAccelerationStructureKHR as *u8 as PFN_DestroyAccelerationStructureKHR)(device, accelerationStructure, pAllocator);
  }
  pub fn getAccelerationStructureBuildSizesKHR(self: &, device: Device, buildType: u32,
    pBuildInfo: &AccelerationStructureBuildGeometryInfoKHR, pMaxPrimitiveCounts: *u32,
    pSizeInfo: &mut AccelerationStructureBuildSizesInfoKHR) {
    (pfnGetAccelerationStructureBuildSizesKHR as *u8 as PFN_GetAccelerationStructureBuildSizesKHR)(device, buildType,
      pBuildInfo, pMaxPrimitiveCounts, pSizeInfo);
  }
  pub fn cmdBuildAccelerationStructuresKHR(self: &, commandBuffer: CommandBuffer, infoCount: u32,
    pInfos: *AccelerationStructureBuildGeometryInfoKHR, ppBuildRangeInfos: **AccelerationStructureBuildRangeInfoKHR) {
    (pfnCmdBuildAccelerationStructuresKHR as *u8 as PFN_CmdBuildAccelerationStructuresKHR)(commandBuffer, infoCount,
      pInfos, ppBuildRangeInfos);
  }
  pub fn getAccelerationStructureDeviceAddressKHR(self: &, device: Device, pInfo: &AccelerationStructureDeviceAddressInfoKHR) u64 {
    (pfnGetAccelerationStructureDeviceAddressKHR as *u8 as PFN_GetAccelerationStructureDeviceAddressKHR)(device, pInfo)
  }
}
