// ---- The functions, as function-reference types ----
//
// (An alias each: a '&fn' type written as a parameter that is not the last
// fails to parse today, and each is the type 'load' casts an address to.)
// Each is '&fn @c': the address is Vulkan's, a C function, called as C calls it.

pub alias PFN_GetInstanceProcAddr = &fn @c (instance: Instance, pName: *u8) *u8;
pub alias PFN_GetDeviceProcAddr = &fn @c (device: Device, pName: *u8) *u8;

// Global: need no instance
pub alias PFN_EnumerateInstanceVersion = &fn @c (pApiVersion: &mut u32) i32;
pub alias PFN_EnumerateInstanceExtensionProperties = &fn @c (pLayerName: *u8, pPropertyCount: &mut u32,
  pProperties: *ExtensionProperties) i32;
pub alias PFN_EnumerateInstanceLayerProperties = &fn @c (pPropertyCount: &mut u32, pProperties: *LayerProperties) i32;
pub alias PFN_CreateInstance = &fn @c (pCreateInfo: &InstanceCreateInfo, pAllocator: *u8, pInstance: &mut Instance) i32;

// Instance
pub alias PFN_DestroyInstance = &fn @c (instance: Instance, pAllocator: *u8);
pub alias PFN_EnumeratePhysicalDevices = &fn @c (instance: Instance, pPhysicalDeviceCount: &mut u32,
  pPhysicalDevices: *PhysicalDevice) i32;
pub alias PFN_GetPhysicalDeviceProperties = &fn @c (physicalDevice: PhysicalDevice, pProperties: &mut PhysicalDeviceProperties);
pub alias PFN_GetPhysicalDeviceFeatures2 = &fn @c (physicalDevice: PhysicalDevice, pFeatures: &mut PhysicalDeviceFeatures2);
pub alias PFN_GetPhysicalDeviceProperties2 = &fn @c (physicalDevice: PhysicalDevice, pProperties: &mut PhysicalDeviceProperties2);
pub alias PFN_GetPhysicalDeviceQueueFamilyProperties = &fn @c (physicalDevice: PhysicalDevice,
  pQueueFamilyPropertyCount: &mut u32, pQueueFamilyProperties: *QueueFamilyProperties);
pub alias PFN_GetPhysicalDeviceMemoryProperties = &fn @c (physicalDevice: PhysicalDevice,
  pMemoryProperties: &mut PhysicalDeviceMemoryProperties);
pub alias PFN_EnumerateDeviceExtensionProperties = &fn @c (physicalDevice: PhysicalDevice, pLayerName: *u8,
  pPropertyCount: &mut u32, pProperties: *ExtensionProperties) i32;
pub alias PFN_CreateDevice = &fn @c (physicalDevice: PhysicalDevice, pCreateInfo: &DeviceCreateInfo, pAllocator: *u8,
  pDevice: &mut Device) i32;
pub alias PFN_DestroySurfaceKHR = &fn @c (instance: Instance, surface: SurfaceKHR, pAllocator: *u8);
pub alias PFN_GetPhysicalDeviceSurfaceSupportKHR = &fn @c (physicalDevice: PhysicalDevice, queueFamilyIndex: u32,
  surface: SurfaceKHR, pSupported: &mut u32) i32;
pub alias PFN_GetPhysicalDeviceSurfaceCapabilitiesKHR = &fn @c (physicalDevice: PhysicalDevice, surface: SurfaceKHR,
  pSurfaceCapabilities: &mut SurfaceCapabilitiesKHR) i32;
pub alias PFN_GetPhysicalDeviceSurfaceFormatsKHR = &fn @c (physicalDevice: PhysicalDevice, surface: SurfaceKHR,
  pSurfaceFormatCount: &mut u32, pSurfaceFormats: *SurfaceFormatKHR) i32;
pub alias PFN_GetPhysicalDeviceSurfacePresentModesKHR = &fn @c (physicalDevice: PhysicalDevice, surface: SurfaceKHR,
  pPresentModeCount: &mut u32, pPresentModes: *u32) i32;
pub alias PFN_CreateDebugUtilsMessengerEXT = &fn @c (instance: Instance, pCreateInfo: &DebugUtilsMessengerCreateInfoEXT,
  pAllocator: *u8, pMessenger: &mut DebugUtilsMessengerEXT) i32;
pub alias PFN_DestroyDebugUtilsMessengerEXT = &fn @c (instance: Instance, messenger: DebugUtilsMessengerEXT, pAllocator: *u8);

// Device
pub alias PFN_DestroyDevice = &fn @c (device: Device, pAllocator: *u8);
pub alias PFN_GetDeviceQueue = &fn @c (device: Device, queueFamilyIndex: u32, queueIndex: u32, pQueue: &mut Queue);
pub alias PFN_DeviceWaitIdle = &fn @c (device: Device) i32;
pub alias PFN_QueueWaitIdle = &fn @c (queue: Queue) i32;
pub alias PFN_CreateSwapchainKHR = &fn @c (device: Device, pCreateInfo: &SwapchainCreateInfoKHR, pAllocator: *u8,
  pSwapchain: &mut SwapchainKHR) i32;
pub alias PFN_DestroySwapchainKHR = &fn @c (device: Device, swapchain: SwapchainKHR, pAllocator: *u8);
pub alias PFN_GetSwapchainImagesKHR = &fn @c (device: Device, swapchain: SwapchainKHR, pSwapchainImageCount: &mut u32,
  pSwapchainImages: *Image) i32;
pub alias PFN_AcquireNextImageKHR = &fn @c (device: Device, swapchain: SwapchainKHR, timeout: u64, semaphore: Semaphore,
  fence: Fence, pImageIndex: &mut u32) i32;
pub alias PFN_QueuePresentKHR = &fn @c (queue: Queue, pPresentInfo: &PresentInfoKHR) i32;
pub alias PFN_CreateImage = &fn @c (device: Device, pCreateInfo: &ImageCreateInfo, pAllocator: *u8, pImage: &mut Image) i32;
pub alias PFN_DestroyImage = &fn @c (device: Device, image: Image, pAllocator: *u8);
pub alias PFN_GetImageMemoryRequirements = &fn @c (device: Device, image: Image, pMemoryRequirements: &mut MemoryRequirements);
pub alias PFN_BindImageMemory = &fn @c (device: Device, image: Image, memory: DeviceMemory, memoryOffset: u64) i32;
pub alias PFN_CreateImageView = &fn @c (device: Device, pCreateInfo: &ImageViewCreateInfo, pAllocator: *u8,
  pView: &mut ImageView) i32;
pub alias PFN_DestroyImageView = &fn @c (device: Device, imageView: ImageView, pAllocator: *u8);
pub alias PFN_CreateCommandPool = &fn @c (device: Device, pCreateInfo: &CommandPoolCreateInfo, pAllocator: *u8,
  pCommandPool: &mut CommandPool) i32;
pub alias PFN_DestroyCommandPool = &fn @c (device: Device, commandPool: CommandPool, pAllocator: *u8);
pub alias PFN_ResetCommandPool = &fn @c (device: Device, commandPool: CommandPool, flags: u32) i32;
pub alias PFN_AllocateCommandBuffers = &fn @c (device: Device, pAllocateInfo: &CommandBufferAllocateInfo,
  pCommandBuffers: *CommandBuffer) i32;
pub alias PFN_FreeCommandBuffers = &fn @c (device: Device, commandPool: CommandPool, commandBufferCount: u32,
  pCommandBuffers: *CommandBuffer);
pub alias PFN_BeginCommandBuffer = &fn @c (commandBuffer: CommandBuffer, pBeginInfo: &CommandBufferBeginInfo) i32;
pub alias PFN_EndCommandBuffer = &fn @c (commandBuffer: CommandBuffer) i32;
pub alias PFN_CreateFence = &fn @c (device: Device, pCreateInfo: &FenceCreateInfo, pAllocator: *u8, pFence: &mut Fence) i32;
pub alias PFN_DestroyFence = &fn @c (device: Device, fence: Fence, pAllocator: *u8);
pub alias PFN_WaitForFences = &fn @c (device: Device, fenceCount: u32, pFences: *Fence, waitAll: u32, timeout: u64) i32;
pub alias PFN_ResetFences = &fn @c (device: Device, fenceCount: u32, pFences: *Fence) i32;
pub alias PFN_CreateSemaphore = &fn @c (device: Device, pCreateInfo: &SemaphoreCreateInfo, pAllocator: *u8,
  pSemaphore: &mut Semaphore) i32;
pub alias PFN_DestroySemaphore = &fn @c (device: Device, semaphore: Semaphore, pAllocator: *u8);
pub alias PFN_QueueSubmit2 = &fn @c (queue: Queue, submitCount: u32, pSubmits: *SubmitInfo2, fence: Fence) i32;
pub alias PFN_CmdPipelineBarrier2 = &fn @c (commandBuffer: CommandBuffer, pDependencyInfo: &DependencyInfo);
pub alias PFN_CmdBeginRendering = &fn @c (commandBuffer: CommandBuffer, pRenderingInfo: &RenderingInfo);
pub alias PFN_CmdEndRendering = &fn @c (commandBuffer: CommandBuffer);
pub alias PFN_CreateBuffer = &fn @c (device: Device, pCreateInfo: &BufferCreateInfo, pAllocator: *u8, pBuffer: &mut Buffer) i32;
pub alias PFN_DestroyBuffer = &fn @c (device: Device, buffer: Buffer, pAllocator: *u8);
pub alias PFN_GetBufferMemoryRequirements = &fn @c (device: Device, buffer: Buffer,
  pMemoryRequirements: &mut MemoryRequirements);
pub alias PFN_AllocateMemory = &fn @c (device: Device, pAllocateInfo: &MemoryAllocateInfo, pAllocator: *u8,
  pMemory: &mut DeviceMemory) i32;
pub alias PFN_FreeMemory = &fn @c (device: Device, memory: DeviceMemory, pAllocator: *u8);
pub alias PFN_BindBufferMemory = &fn @c (device: Device, buffer: Buffer, memory: DeviceMemory, memoryOffset: u64) i32;
pub alias PFN_MapMemory = &fn @c (device: Device, memory: DeviceMemory, offset: u64, size: u64, flags: u32,
  ppData: &mut *u8) i32;
pub alias PFN_UnmapMemory = &fn @c (device: Device, memory: DeviceMemory);
pub alias PFN_InvalidateMappedMemoryRanges = &fn @c (device: Device, memoryRangeCount: u32,
  pMemoryRanges: *MappedMemoryRange) i32;
pub alias PFN_CmdFillBuffer = &fn @c (commandBuffer: CommandBuffer, dstBuffer: Buffer, dstOffset: u64, size: u64,
  data: u32);
pub alias PFN_CmdCopyBuffer = &fn @c (commandBuffer: CommandBuffer, srcBuffer: Buffer, dstBuffer: Buffer,
  regionCount: u32, pRegions: *BufferCopy);
pub alias PFN_CmdCopyImageToBuffer = &fn @c (commandBuffer: CommandBuffer, srcImage: Image, srcImageLayout: u32,
  dstBuffer: Buffer, regionCount: u32, pRegions: *BufferImageCopy);
pub alias PFN_CmdCopyBufferToImage = &fn @c (commandBuffer: CommandBuffer, srcBuffer: Buffer, dstImage: Image,
  dstImageLayout: u32, regionCount: u32, pRegions: *BufferImageCopy);
pub alias PFN_CreateShaderModule = &fn @c (device: Device, pCreateInfo: &ShaderModuleCreateInfo, pAllocator: *u8,
  pShaderModule: &mut ShaderModule) i32;
pub alias PFN_DestroyShaderModule = &fn @c (device: Device, shaderModule: ShaderModule, pAllocator: *u8);
pub alias PFN_CreateSampler = &fn @c (device: Device, pCreateInfo: &SamplerCreateInfo, pAllocator: *u8,
  pSampler: &mut Sampler) i32;
pub alias PFN_DestroySampler = &fn @c (device: Device, sampler: Sampler, pAllocator: *u8);
pub alias PFN_CreatePipelineLayout = &fn @c (device: Device, pCreateInfo: &PipelineLayoutCreateInfo, pAllocator: *u8,
  pPipelineLayout: &mut PipelineLayout) i32;
pub alias PFN_DestroyPipelineLayout = &fn @c (device: Device, pipelineLayout: PipelineLayout, pAllocator: *u8);
pub alias PFN_CreateGraphicsPipelines = &fn @c (device: Device, pipelineCache: PipelineCache, createInfoCount: u32,
  pCreateInfos: *GraphicsPipelineCreateInfo, pAllocator: *u8, pPipelines: *Pipeline) i32;
pub alias PFN_DestroyPipeline = &fn @c (device: Device, pipeline: Pipeline, pAllocator: *u8);
pub alias PFN_CreateDescriptorSetLayout = &fn @c (device: Device, pCreateInfo: &DescriptorSetLayoutCreateInfo,
  pAllocator: *u8, pSetLayout: &mut DescriptorSetLayout) i32;
pub alias PFN_DestroyDescriptorSetLayout = &fn @c (device: Device, descriptorSetLayout: DescriptorSetLayout, pAllocator: *u8);
pub alias PFN_CreateDescriptorPool = &fn @c (device: Device, pCreateInfo: &DescriptorPoolCreateInfo, pAllocator: *u8,
  pDescriptorPool: &mut DescriptorPool) i32;
pub alias PFN_DestroyDescriptorPool = &fn @c (device: Device, descriptorPool: DescriptorPool, pAllocator: *u8);
pub alias PFN_AllocateDescriptorSets = &fn @c (device: Device, pAllocateInfo: &DescriptorSetAllocateInfo,
  pDescriptorSets: *DescriptorSet) i32;
pub alias PFN_UpdateDescriptorSets = &fn @c (device: Device, descriptorWriteCount: u32,
  pDescriptorWrites: *WriteDescriptorSet, descriptorCopyCount: u32, pDescriptorCopies: *u8);
pub alias PFN_CmdBindPipeline = &fn @c (commandBuffer: CommandBuffer, pipelineBindPoint: u32, pipeline: Pipeline);
pub alias PFN_CmdBindDescriptorSets = &fn @c (commandBuffer: CommandBuffer, pipelineBindPoint: u32,
  layout: PipelineLayout, firstSet: u32, descriptorSetCount: u32, pDescriptorSets: *DescriptorSet,
  dynamicOffsetCount: u32, pDynamicOffsets: *u32);
pub alias PFN_CmdBindVertexBuffers = &fn @c (commandBuffer: CommandBuffer, firstBinding: u32, bindingCount: u32,
  pBuffers: *Buffer, pOffsets: *u64);
pub alias PFN_CmdBindIndexBuffer = &fn @c (commandBuffer: CommandBuffer, buffer: Buffer, offset: u64, indexType: u32);
pub alias PFN_CmdSetViewport = &fn @c (commandBuffer: CommandBuffer, firstViewport: u32, viewportCount: u32,
  pViewports: *Viewport);
pub alias PFN_CmdSetScissor = &fn @c (commandBuffer: CommandBuffer, firstScissor: u32, scissorCount: u32,
  pScissors: *Rect2D);
pub alias PFN_CmdPushConstants = &fn @c (commandBuffer: CommandBuffer, layout: PipelineLayout, stageFlags: u32,
  offset: u32, size: u32, pValues: *u8);
pub alias PFN_CmdDraw = &fn @c (commandBuffer: CommandBuffer, vertexCount: u32, instanceCount: u32,
  firstVertex: u32, firstInstance: u32);
pub alias PFN_CmdDrawIndexed = &fn @c (commandBuffer: CommandBuffer, indexCount: u32, instanceCount: u32,
  firstIndex: u32, vertexOffset: i32, firstInstance: u32);
pub alias PFN_CmdDrawIndirect = &fn @c (commandBuffer: CommandBuffer, buffer: Buffer, offset: u64, drawCount: u32,
  stride: u32);
pub alias PFN_CmdDrawIndexedIndirect = &fn @c (commandBuffer: CommandBuffer, buffer: Buffer, offset: u64, drawCount: u32,
  stride: u32);

// Compute
pub alias PFN_CreateComputePipelines = &fn @c (device: Device, pipelineCache: PipelineCache, createInfoCount: u32,
  pCreateInfos: *ComputePipelineCreateInfo, pAllocator: *u8, pPipelines: *Pipeline) i32;
pub alias PFN_CmdDispatch = &fn @c (commandBuffer: CommandBuffer, groupCountX: u32, groupCountY: u32, groupCountZ: u32);
pub alias PFN_CmdDispatchIndirect = &fn @c (commandBuffer: CommandBuffer, buffer: Buffer, offset: u64);

// Queries
pub alias PFN_CreateQueryPool = &fn @c (device: Device, pCreateInfo: &QueryPoolCreateInfo, pAllocator: *u8,
  pQueryPool: &mut QueryPool) i32;
pub alias PFN_DestroyQueryPool = &fn @c (device: Device, queryPool: QueryPool, pAllocator: *u8);
pub alias PFN_CmdResetQueryPool = &fn @c (commandBuffer: CommandBuffer, queryPool: QueryPool, firstQuery: u32,
  queryCount: u32);
pub alias PFN_CmdWriteTimestamp2 = &fn @c (commandBuffer: CommandBuffer, stage: u64, queryPool: QueryPool, query: u32);
pub alias PFN_CmdCopyQueryPoolResults = &fn @c (commandBuffer: CommandBuffer, queryPool: QueryPool, firstQuery: u32,
  queryCount: u32, dstBuffer: Buffer, dstOffset: u64, stride: u64, flags: u32);
