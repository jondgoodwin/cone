// ---- The functions, as function-reference types ----
//
// (An alias each: a '&fn' type written as a parameter that is not the last
// fails to parse today, and each is the type 'load' casts an address to.)

pub alias PFN_GetInstanceProcAddr = &fn(instance Instance, pName *u8) *u8;
pub alias PFN_GetDeviceProcAddr = &fn(device Device, pName *u8) *u8;

// Global: need no instance
pub alias PFN_EnumerateInstanceVersion = &fn(pApiVersion &mut u32) i32;
pub alias PFN_EnumerateInstanceExtensionProperties = &fn(pLayerName *u8, pPropertyCount &mut u32,
  pProperties *ExtensionProperties) i32;
pub alias PFN_EnumerateInstanceLayerProperties = &fn(pPropertyCount &mut u32, pProperties *LayerProperties) i32;
pub alias PFN_CreateInstance = &fn(pCreateInfo &InstanceCreateInfo, pAllocator *u8, pInstance &mut Instance) i32;

// Instance
pub alias PFN_DestroyInstance = &fn(instance Instance, pAllocator *u8);
pub alias PFN_EnumeratePhysicalDevices = &fn(instance Instance, pPhysicalDeviceCount &mut u32,
  pPhysicalDevices *PhysicalDevice) i32;
pub alias PFN_GetPhysicalDeviceProperties = &fn(physicalDevice PhysicalDevice, pProperties &mut PhysicalDeviceProperties);
pub alias PFN_GetPhysicalDeviceFeatures2 = &fn(physicalDevice PhysicalDevice, pFeatures &mut PhysicalDeviceFeatures2);
pub alias PFN_GetPhysicalDeviceQueueFamilyProperties = &fn(physicalDevice PhysicalDevice,
  pQueueFamilyPropertyCount &mut u32, pQueueFamilyProperties *QueueFamilyProperties);
pub alias PFN_GetPhysicalDeviceMemoryProperties = &fn(physicalDevice PhysicalDevice,
  pMemoryProperties &mut PhysicalDeviceMemoryProperties);
pub alias PFN_EnumerateDeviceExtensionProperties = &fn(physicalDevice PhysicalDevice, pLayerName *u8,
  pPropertyCount &mut u32, pProperties *ExtensionProperties) i32;
pub alias PFN_CreateDevice = &fn(physicalDevice PhysicalDevice, pCreateInfo &DeviceCreateInfo, pAllocator *u8,
  pDevice &mut Device) i32;
pub alias PFN_DestroySurfaceKHR = &fn(instance Instance, surface SurfaceKHR, pAllocator *u8);
pub alias PFN_GetPhysicalDeviceSurfaceSupportKHR = &fn(physicalDevice PhysicalDevice, queueFamilyIndex u32,
  surface SurfaceKHR, pSupported &mut u32) i32;
pub alias PFN_GetPhysicalDeviceSurfaceCapabilitiesKHR = &fn(physicalDevice PhysicalDevice, surface SurfaceKHR,
  pSurfaceCapabilities &mut SurfaceCapabilitiesKHR) i32;
pub alias PFN_GetPhysicalDeviceSurfaceFormatsKHR = &fn(physicalDevice PhysicalDevice, surface SurfaceKHR,
  pSurfaceFormatCount &mut u32, pSurfaceFormats *SurfaceFormatKHR) i32;
pub alias PFN_GetPhysicalDeviceSurfacePresentModesKHR = &fn(physicalDevice PhysicalDevice, surface SurfaceKHR,
  pPresentModeCount &mut u32, pPresentModes *u32) i32;
pub alias PFN_CreateDebugUtilsMessengerEXT = &fn(instance Instance, pCreateInfo &DebugUtilsMessengerCreateInfoEXT,
  pAllocator *u8, pMessenger &mut DebugUtilsMessengerEXT) i32;
pub alias PFN_DestroyDebugUtilsMessengerEXT = &fn(instance Instance, messenger DebugUtilsMessengerEXT, pAllocator *u8);

// Device
pub alias PFN_DestroyDevice = &fn(device Device, pAllocator *u8);
pub alias PFN_GetDeviceQueue = &fn(device Device, queueFamilyIndex u32, queueIndex u32, pQueue &mut Queue);
pub alias PFN_DeviceWaitIdle = &fn(device Device) i32;
pub alias PFN_QueueWaitIdle = &fn(queue Queue) i32;
pub alias PFN_CreateSwapchainKHR = &fn(device Device, pCreateInfo &SwapchainCreateInfoKHR, pAllocator *u8,
  pSwapchain &mut SwapchainKHR) i32;
pub alias PFN_DestroySwapchainKHR = &fn(device Device, swapchain SwapchainKHR, pAllocator *u8);
pub alias PFN_GetSwapchainImagesKHR = &fn(device Device, swapchain SwapchainKHR, pSwapchainImageCount &mut u32,
  pSwapchainImages *Image) i32;
pub alias PFN_AcquireNextImageKHR = &fn(device Device, swapchain SwapchainKHR, timeout u64, semaphore Semaphore,
  fence Fence, pImageIndex &mut u32) i32;
pub alias PFN_QueuePresentKHR = &fn(queue Queue, pPresentInfo &PresentInfoKHR) i32;
pub alias PFN_CreateImage = &fn(device Device, pCreateInfo &ImageCreateInfo, pAllocator *u8, pImage &mut Image) i32;
pub alias PFN_DestroyImage = &fn(device Device, image Image, pAllocator *u8);
pub alias PFN_GetImageMemoryRequirements = &fn(device Device, image Image, pMemoryRequirements &mut MemoryRequirements);
pub alias PFN_BindImageMemory = &fn(device Device, image Image, memory DeviceMemory, memoryOffset u64) i32;
pub alias PFN_CreateImageView = &fn(device Device, pCreateInfo &ImageViewCreateInfo, pAllocator *u8,
  pView &mut ImageView) i32;
pub alias PFN_DestroyImageView = &fn(device Device, imageView ImageView, pAllocator *u8);
pub alias PFN_CreateCommandPool = &fn(device Device, pCreateInfo &CommandPoolCreateInfo, pAllocator *u8,
  pCommandPool &mut CommandPool) i32;
pub alias PFN_DestroyCommandPool = &fn(device Device, commandPool CommandPool, pAllocator *u8);
pub alias PFN_ResetCommandPool = &fn(device Device, commandPool CommandPool, flags u32) i32;
pub alias PFN_AllocateCommandBuffers = &fn(device Device, pAllocateInfo &CommandBufferAllocateInfo,
  pCommandBuffers *CommandBuffer) i32;
pub alias PFN_FreeCommandBuffers = &fn(device Device, commandPool CommandPool, commandBufferCount u32,
  pCommandBuffers *CommandBuffer);
pub alias PFN_BeginCommandBuffer = &fn(commandBuffer CommandBuffer, pBeginInfo &CommandBufferBeginInfo) i32;
pub alias PFN_EndCommandBuffer = &fn(commandBuffer CommandBuffer) i32;
pub alias PFN_CreateFence = &fn(device Device, pCreateInfo &FenceCreateInfo, pAllocator *u8, pFence &mut Fence) i32;
pub alias PFN_DestroyFence = &fn(device Device, fence Fence, pAllocator *u8);
pub alias PFN_WaitForFences = &fn(device Device, fenceCount u32, pFences *Fence, waitAll u32, timeout u64) i32;
pub alias PFN_ResetFences = &fn(device Device, fenceCount u32, pFences *Fence) i32;
pub alias PFN_CreateSemaphore = &fn(device Device, pCreateInfo &SemaphoreCreateInfo, pAllocator *u8,
  pSemaphore &mut Semaphore) i32;
pub alias PFN_DestroySemaphore = &fn(device Device, semaphore Semaphore, pAllocator *u8);
pub alias PFN_QueueSubmit2 = &fn(queue Queue, submitCount u32, pSubmits *SubmitInfo2, fence Fence) i32;
pub alias PFN_CmdPipelineBarrier2 = &fn(commandBuffer CommandBuffer, pDependencyInfo &DependencyInfo);
pub alias PFN_CmdBeginRendering = &fn(commandBuffer CommandBuffer, pRenderingInfo &RenderingInfo);
pub alias PFN_CmdEndRendering = &fn(commandBuffer CommandBuffer);
pub alias PFN_CreateBuffer = &fn(device Device, pCreateInfo &BufferCreateInfo, pAllocator *u8, pBuffer &mut Buffer) i32;
pub alias PFN_DestroyBuffer = &fn(device Device, buffer Buffer, pAllocator *u8);
pub alias PFN_GetBufferMemoryRequirements = &fn(device Device, buffer Buffer,
  pMemoryRequirements &mut MemoryRequirements);
pub alias PFN_AllocateMemory = &fn(device Device, pAllocateInfo &MemoryAllocateInfo, pAllocator *u8,
  pMemory &mut DeviceMemory) i32;
pub alias PFN_FreeMemory = &fn(device Device, memory DeviceMemory, pAllocator *u8);
pub alias PFN_BindBufferMemory = &fn(device Device, buffer Buffer, memory DeviceMemory, memoryOffset u64) i32;
pub alias PFN_MapMemory = &fn(device Device, memory DeviceMemory, offset u64, size u64, flags u32,
  ppData &mut *u8) i32;
pub alias PFN_UnmapMemory = &fn(device Device, memory DeviceMemory);
pub alias PFN_InvalidateMappedMemoryRanges = &fn(device Device, memoryRangeCount u32,
  pMemoryRanges *MappedMemoryRange) i32;
pub alias PFN_CmdFillBuffer = &fn(commandBuffer CommandBuffer, dstBuffer Buffer, dstOffset u64, size u64,
  data u32);
pub alias PFN_CmdCopyBuffer = &fn(commandBuffer CommandBuffer, srcBuffer Buffer, dstBuffer Buffer,
  regionCount u32, pRegions *BufferCopy);
pub alias PFN_CmdCopyImageToBuffer = &fn(commandBuffer CommandBuffer, srcImage Image, srcImageLayout u32,
  dstBuffer Buffer, regionCount u32, pRegions *BufferImageCopy);
pub alias PFN_CmdCopyBufferToImage = &fn(commandBuffer CommandBuffer, srcBuffer Buffer, dstImage Image,
  dstImageLayout u32, regionCount u32, pRegions *BufferImageCopy);
pub alias PFN_CreateShaderModule = &fn(device Device, pCreateInfo &ShaderModuleCreateInfo, pAllocator *u8,
  pShaderModule &mut ShaderModule) i32;
pub alias PFN_DestroyShaderModule = &fn(device Device, shaderModule ShaderModule, pAllocator *u8);
pub alias PFN_CreateSampler = &fn(device Device, pCreateInfo &SamplerCreateInfo, pAllocator *u8,
  pSampler &mut Sampler) i32;
pub alias PFN_DestroySampler = &fn(device Device, sampler Sampler, pAllocator *u8);
pub alias PFN_CreatePipelineLayout = &fn(device Device, pCreateInfo &PipelineLayoutCreateInfo, pAllocator *u8,
  pPipelineLayout &mut PipelineLayout) i32;
pub alias PFN_DestroyPipelineLayout = &fn(device Device, pipelineLayout PipelineLayout, pAllocator *u8);
pub alias PFN_CreateGraphicsPipelines = &fn(device Device, pipelineCache PipelineCache, createInfoCount u32,
  pCreateInfos *GraphicsPipelineCreateInfo, pAllocator *u8, pPipelines *Pipeline) i32;
pub alias PFN_DestroyPipeline = &fn(device Device, pipeline Pipeline, pAllocator *u8);
pub alias PFN_CreateDescriptorSetLayout = &fn(device Device, pCreateInfo &DescriptorSetLayoutCreateInfo,
  pAllocator *u8, pSetLayout &mut DescriptorSetLayout) i32;
pub alias PFN_DestroyDescriptorSetLayout = &fn(device Device, descriptorSetLayout DescriptorSetLayout, pAllocator *u8);
pub alias PFN_CreateDescriptorPool = &fn(device Device, pCreateInfo &DescriptorPoolCreateInfo, pAllocator *u8,
  pDescriptorPool &mut DescriptorPool) i32;
pub alias PFN_DestroyDescriptorPool = &fn(device Device, descriptorPool DescriptorPool, pAllocator *u8);
pub alias PFN_AllocateDescriptorSets = &fn(device Device, pAllocateInfo &DescriptorSetAllocateInfo,
  pDescriptorSets *DescriptorSet) i32;
pub alias PFN_UpdateDescriptorSets = &fn(device Device, descriptorWriteCount u32,
  pDescriptorWrites *WriteDescriptorSet, descriptorCopyCount u32, pDescriptorCopies *u8);
pub alias PFN_CmdBindPipeline = &fn(commandBuffer CommandBuffer, pipelineBindPoint u32, pipeline Pipeline);
pub alias PFN_CmdBindDescriptorSets = &fn(commandBuffer CommandBuffer, pipelineBindPoint u32,
  layout PipelineLayout, firstSet u32, descriptorSetCount u32, pDescriptorSets *DescriptorSet,
  dynamicOffsetCount u32, pDynamicOffsets *u32);
pub alias PFN_CmdBindVertexBuffers = &fn(commandBuffer CommandBuffer, firstBinding u32, bindingCount u32,
  pBuffers *Buffer, pOffsets *u64);
pub alias PFN_CmdBindIndexBuffer = &fn(commandBuffer CommandBuffer, buffer Buffer, offset u64, indexType u32);
pub alias PFN_CmdSetViewport = &fn(commandBuffer CommandBuffer, firstViewport u32, viewportCount u32,
  pViewports *Viewport);
pub alias PFN_CmdSetScissor = &fn(commandBuffer CommandBuffer, firstScissor u32, scissorCount u32,
  pScissors *Rect2D);
pub alias PFN_CmdPushConstants = &fn(commandBuffer CommandBuffer, layout PipelineLayout, stageFlags u32,
  offset u32, size u32, pValues *u8);
pub alias PFN_CmdDraw = &fn(commandBuffer CommandBuffer, vertexCount u32, instanceCount u32,
  firstVertex u32, firstInstance u32);
pub alias PFN_CmdDrawIndexed = &fn(commandBuffer CommandBuffer, indexCount u32, instanceCount u32,
  firstIndex u32, vertexOffset i32, firstInstance u32);
pub alias PFN_CmdDrawIndirect = &fn(commandBuffer CommandBuffer, buffer Buffer, offset u64, drawCount u32,
  stride u32);
pub alias PFN_CmdDrawIndexedIndirect = &fn(commandBuffer CommandBuffer, buffer Buffer, offset u64, drawCount u32,
  stride u32);

// Compute
pub alias PFN_CreateComputePipelines = &fn(device Device, pipelineCache PipelineCache, createInfoCount u32,
  pCreateInfos *ComputePipelineCreateInfo, pAllocator *u8, pPipelines *Pipeline) i32;
pub alias PFN_CmdDispatch = &fn(commandBuffer CommandBuffer, groupCountX u32, groupCountY u32, groupCountZ u32);
pub alias PFN_CmdDispatchIndirect = &fn(commandBuffer CommandBuffer, buffer Buffer, offset u64);

// Queries
pub alias PFN_CreateQueryPool = &fn(device Device, pCreateInfo &QueryPoolCreateInfo, pAllocator *u8,
  pQueryPool &mut QueryPool) i32;
pub alias PFN_DestroyQueryPool = &fn(device Device, queryPool QueryPool, pAllocator *u8);
pub alias PFN_CmdResetQueryPool = &fn(commandBuffer CommandBuffer, queryPool QueryPool, firstQuery u32,
  queryCount u32);
pub alias PFN_CmdWriteTimestamp2 = &fn(commandBuffer CommandBuffer, stage u64, queryPool QueryPool, query u32);
pub alias PFN_CmdCopyQueryPoolResults = &fn(commandBuffer CommandBuffer, queryPool QueryPool, firstQuery u32,
  queryCount u32, dstBuffer Buffer, dstOffset u64, stride u64, flags u32);
