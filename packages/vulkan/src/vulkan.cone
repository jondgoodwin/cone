// ---- Structs: shared small ones ----

pub struct Extent2D { pub width u32; pub height u32; }
pub struct Extent3D { pub width u32; pub height u32; pub depth u32; }
pub struct Offset2D { pub x i32; pub y i32; }
pub struct Offset3D { pub x i32; pub y i32; pub z i32; }
pub struct Rect2D { pub offset Offset2D; pub extent Extent2D; }

// VkClearValue is a C union of a color (four floats, ints or uints) and a
// depth-stencil pair. Cone has no C union, so it is its storage, 16 bytes,
// written through 'clearColor' and 'clearDepthStencil', which is the exact
// size, alignment and layout of C's. VkClearColorValue is the same storage.
pub struct ClearValue { pub raw [4; u32]; }
pub typedef ClearColorValue ClearValue;

pub fn clearColor(r f32, g f32, b f32, a f32) ClearValue {
  mut v = ClearValue[[4; 0u32]];
  imm p = &mut v as *f32;
  p[0] = r; p[1] = g; p[2] = b; p[3] = a;
  v;
}

pub fn clearDepthStencil(depth f32, stencil u32) ClearValue {
  mut v = ClearValue[[4; 0u32]];
  imm pd = &mut v as *f32;
  pd[0] = depth;
  imm ps = &mut v as *u32;
  ps[1] = stencil;
  v;
}

