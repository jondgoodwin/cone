// ---- Loading ----

// How many functions the last 'load', 'loadInstance' or 'loadDevice' looked
// for and did not find
pub fn missing() u32 { missingCount; }

// Whether 'load' has been given a vkGetInstanceProcAddr
pub fn loaded() Bool { pfnGetInstanceProcAddr != 0usize; }

// Look an instance function up; a required one not found is counted
fn instanceProc(instance Instance, name *u8, required Bool) usize {
  imm p = (pfnGetInstanceProcAddr as *u8 as PFN_GetInstanceProcAddr)(instance, name) as usize;
  if p == 0usize and required { missingCount = missingCount + 1u32; }
  p;
}

fn deviceProc(device Device, name *u8) usize {
  imm p = (pfnGetDeviceProcAddr as *u8 as PFN_GetDeviceProcAddr)(device, name) as usize;
  if p == 0usize { missingCount = missingCount + 1u32; }
  p;
}

// Keep vkGetInstanceProcAddr, and find the functions needing no instance
// (the version, the instance's extensions and layers, and vkCreateInstance).
// Answers whether all four were found.
pub fn load(getInstanceProcAddr PFN_GetInstanceProcAddr) Bool {
  missingCount = 0u32;
  pfnGetInstanceProcAddr = getInstanceProcAddr as usize;
  imm none = 0usize as Instance;
  pfnEnumerateInstanceVersion = instanceProc(none, &"vkEnumerateInstanceVersion" as *u8, true);
  pfnEnumerateInstanceExtensionProperties = instanceProc(none, &"vkEnumerateInstanceExtensionProperties" as *u8, true);
  pfnEnumerateInstanceLayerProperties = instanceProc(none, &"vkEnumerateInstanceLayerProperties" as *u8, true);
  pfnCreateInstance = instanceProc(none, &"vkCreateInstance" as *u8, true);
  missingCount == 0u32;
}

// Find the functions of 'instance', surfaces' (VK_KHR_surface) among them,
// and the debug messenger's (VK_EXT_debug_utils) if that was enabled; those
// two alone may be missing. Answers whether every other one was found.
pub fn loadInstance(instance Instance) Bool {
  missingCount = 0u32;
  pfnGetDeviceProcAddr = instanceProc(instance, &"vkGetDeviceProcAddr" as *u8, true);
  pfnDestroyInstance = instanceProc(instance, &"vkDestroyInstance" as *u8, true);
  pfnEnumeratePhysicalDevices = instanceProc(instance, &"vkEnumeratePhysicalDevices" as *u8, true);
  pfnGetPhysicalDeviceProperties = instanceProc(instance, &"vkGetPhysicalDeviceProperties" as *u8, true);
  pfnGetPhysicalDeviceFeatures2 = instanceProc(instance, &"vkGetPhysicalDeviceFeatures2" as *u8, true);
  pfnGetPhysicalDeviceQueueFamilyProperties = instanceProc(instance, &"vkGetPhysicalDeviceQueueFamilyProperties" as *u8, true);
  pfnGetPhysicalDeviceMemoryProperties = instanceProc(instance, &"vkGetPhysicalDeviceMemoryProperties" as *u8, true);
  pfnEnumerateDeviceExtensionProperties = instanceProc(instance, &"vkEnumerateDeviceExtensionProperties" as *u8, true);
  pfnCreateDevice = instanceProc(instance, &"vkCreateDevice" as *u8, true);
  pfnDestroySurfaceKHR = instanceProc(instance, &"vkDestroySurfaceKHR" as *u8, true);
  pfnGetPhysicalDeviceSurfaceSupportKHR = instanceProc(instance, &"vkGetPhysicalDeviceSurfaceSupportKHR" as *u8, true);
  pfnGetPhysicalDeviceSurfaceCapabilitiesKHR = instanceProc(instance, &"vkGetPhysicalDeviceSurfaceCapabilitiesKHR" as *u8, true);
  pfnGetPhysicalDeviceSurfaceFormatsKHR = instanceProc(instance, &"vkGetPhysicalDeviceSurfaceFormatsKHR" as *u8, true);
  pfnGetPhysicalDeviceSurfacePresentModesKHR = instanceProc(instance, &"vkGetPhysicalDeviceSurfacePresentModesKHR" as *u8, true);
  pfnCreateDebugUtilsMessengerEXT = instanceProc(instance, &"vkCreateDebugUtilsMessengerEXT" as *u8, false);
  pfnDestroyDebugUtilsMessengerEXT = instanceProc(instance, &"vkDestroyDebugUtilsMessengerEXT" as *u8, false);
  missingCount == 0u32;
}

// Whether the debug messenger's functions were found (VK_EXT_debug_utils was
// enabled on the instance 'loadInstance' was given)
pub fn hasDebugUtils() Bool {
  pfnCreateDebugUtilsMessengerEXT != 0usize and pfnDestroyDebugUtilsMessengerEXT != 0usize;
}

// Find the functions of 'device', through vkGetDeviceProcAddr: its own,
// swapchains' (VK_KHR_swapchain, which it must have enabled), and Vulkan
// 1.3's synchronization2 and dynamic rendering. Answers whether all were found.
pub fn loadDevice(device Device) Bool {
  missingCount = 0u32;
  pfnDestroyDevice = deviceProc(device, &"vkDestroyDevice" as *u8);
  pfnGetDeviceQueue = deviceProc(device, &"vkGetDeviceQueue" as *u8);
  pfnDeviceWaitIdle = deviceProc(device, &"vkDeviceWaitIdle" as *u8);
  pfnQueueWaitIdle = deviceProc(device, &"vkQueueWaitIdle" as *u8);
  pfnCreateSwapchainKHR = deviceProc(device, &"vkCreateSwapchainKHR" as *u8);
  pfnDestroySwapchainKHR = deviceProc(device, &"vkDestroySwapchainKHR" as *u8);
  pfnGetSwapchainImagesKHR = deviceProc(device, &"vkGetSwapchainImagesKHR" as *u8);
  pfnAcquireNextImageKHR = deviceProc(device, &"vkAcquireNextImageKHR" as *u8);
  pfnQueuePresentKHR = deviceProc(device, &"vkQueuePresentKHR" as *u8);
  pfnCreateImage = deviceProc(device, &"vkCreateImage" as *u8);
  pfnDestroyImage = deviceProc(device, &"vkDestroyImage" as *u8);
  pfnGetImageMemoryRequirements = deviceProc(device, &"vkGetImageMemoryRequirements" as *u8);
  pfnBindImageMemory = deviceProc(device, &"vkBindImageMemory" as *u8);
  pfnCreateImageView = deviceProc(device, &"vkCreateImageView" as *u8);
  pfnDestroyImageView = deviceProc(device, &"vkDestroyImageView" as *u8);
  pfnCreateCommandPool = deviceProc(device, &"vkCreateCommandPool" as *u8);
  pfnDestroyCommandPool = deviceProc(device, &"vkDestroyCommandPool" as *u8);
  pfnResetCommandPool = deviceProc(device, &"vkResetCommandPool" as *u8);
  pfnAllocateCommandBuffers = deviceProc(device, &"vkAllocateCommandBuffers" as *u8);
  pfnFreeCommandBuffers = deviceProc(device, &"vkFreeCommandBuffers" as *u8);
  pfnBeginCommandBuffer = deviceProc(device, &"vkBeginCommandBuffer" as *u8);
  pfnEndCommandBuffer = deviceProc(device, &"vkEndCommandBuffer" as *u8);
  pfnCreateFence = deviceProc(device, &"vkCreateFence" as *u8);
  pfnDestroyFence = deviceProc(device, &"vkDestroyFence" as *u8);
  pfnWaitForFences = deviceProc(device, &"vkWaitForFences" as *u8);
  pfnResetFences = deviceProc(device, &"vkResetFences" as *u8);
  pfnCreateSemaphore = deviceProc(device, &"vkCreateSemaphore" as *u8);
  pfnDestroySemaphore = deviceProc(device, &"vkDestroySemaphore" as *u8);
  pfnQueueSubmit2 = deviceProc(device, &"vkQueueSubmit2" as *u8);
  pfnCmdPipelineBarrier2 = deviceProc(device, &"vkCmdPipelineBarrier2" as *u8);
  pfnCmdBeginRendering = deviceProc(device, &"vkCmdBeginRendering" as *u8);
  pfnCmdEndRendering = deviceProc(device, &"vkCmdEndRendering" as *u8);
  pfnCreateBuffer = deviceProc(device, &"vkCreateBuffer" as *u8);
  pfnDestroyBuffer = deviceProc(device, &"vkDestroyBuffer" as *u8);
  pfnGetBufferMemoryRequirements = deviceProc(device, &"vkGetBufferMemoryRequirements" as *u8);
  pfnAllocateMemory = deviceProc(device, &"vkAllocateMemory" as *u8);
  pfnFreeMemory = deviceProc(device, &"vkFreeMemory" as *u8);
  pfnBindBufferMemory = deviceProc(device, &"vkBindBufferMemory" as *u8);
  pfnMapMemory = deviceProc(device, &"vkMapMemory" as *u8);
  pfnUnmapMemory = deviceProc(device, &"vkUnmapMemory" as *u8);
  pfnCmdCopyBuffer = deviceProc(device, &"vkCmdCopyBuffer" as *u8);
  pfnCmdCopyImageToBuffer = deviceProc(device, &"vkCmdCopyImageToBuffer" as *u8);
  pfnCmdCopyBufferToImage = deviceProc(device, &"vkCmdCopyBufferToImage" as *u8);
  pfnCreateShaderModule = deviceProc(device, &"vkCreateShaderModule" as *u8);
  pfnDestroyShaderModule = deviceProc(device, &"vkDestroyShaderModule" as *u8);
  pfnCreateSampler = deviceProc(device, &"vkCreateSampler" as *u8);
  pfnDestroySampler = deviceProc(device, &"vkDestroySampler" as *u8);
  pfnCreatePipelineLayout = deviceProc(device, &"vkCreatePipelineLayout" as *u8);
  pfnDestroyPipelineLayout = deviceProc(device, &"vkDestroyPipelineLayout" as *u8);
  pfnCreateGraphicsPipelines = deviceProc(device, &"vkCreateGraphicsPipelines" as *u8);
  pfnDestroyPipeline = deviceProc(device, &"vkDestroyPipeline" as *u8);
  pfnCreateDescriptorSetLayout = deviceProc(device, &"vkCreateDescriptorSetLayout" as *u8);
  pfnDestroyDescriptorSetLayout = deviceProc(device, &"vkDestroyDescriptorSetLayout" as *u8);
  pfnCreateDescriptorPool = deviceProc(device, &"vkCreateDescriptorPool" as *u8);
  pfnDestroyDescriptorPool = deviceProc(device, &"vkDestroyDescriptorPool" as *u8);
  pfnAllocateDescriptorSets = deviceProc(device, &"vkAllocateDescriptorSets" as *u8);
  pfnUpdateDescriptorSets = deviceProc(device, &"vkUpdateDescriptorSets" as *u8);
  pfnCmdBindPipeline = deviceProc(device, &"vkCmdBindPipeline" as *u8);
  pfnCmdBindDescriptorSets = deviceProc(device, &"vkCmdBindDescriptorSets" as *u8);
  pfnCmdBindVertexBuffers = deviceProc(device, &"vkCmdBindVertexBuffers" as *u8);
  pfnCmdBindIndexBuffer = deviceProc(device, &"vkCmdBindIndexBuffer" as *u8);
  pfnCmdSetViewport = deviceProc(device, &"vkCmdSetViewport" as *u8);
  pfnCmdSetScissor = deviceProc(device, &"vkCmdSetScissor" as *u8);
  pfnCmdPushConstants = deviceProc(device, &"vkCmdPushConstants" as *u8);
  pfnCmdDraw = deviceProc(device, &"vkCmdDraw" as *u8);
  pfnCmdDrawIndexed = deviceProc(device, &"vkCmdDrawIndexed" as *u8);
  missingCount == 0u32;
}

