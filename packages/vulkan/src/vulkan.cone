  pub bufferRowLength u32 = 0u32;     // 0: tightly packed
  pub bufferImageHeight u32 = 0u32;
  pub imageSubresource ImageSubresourceLayers;
  pub imageOffset Offset3D;
  pub imageExtent Extent3D;
}

// ---- Structs: shaders, pipelines, descriptors ----

pub struct ShaderModuleCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub codeSize usize = 0usize;          // in bytes, a multiple of 4
  pub pCode *u32;
}

pub struct PipelineShaderStageCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub stage u32 = 0u32;
  pub module ShaderModule;
  pub pName *u8;
  pub pSpecializationInfo *u8;
}

pub struct VertexInputBindingDescription {
  pub binding u32;
  pub stride u32;
  pub inputRate u32 = VERTEX_INPUT_RATE_VERTEX;
}

pub struct VertexInputAttributeDescription {
  pub location u32;
  pub binding u32;
  pub format u32;
  pub offset u32;
}

pub struct PipelineVertexInputStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub vertexBindingDescriptionCount u32 = 0u32;
  pub pVertexBindingDescriptions *VertexInputBindingDescription;
  pub vertexAttributeDescriptionCount u32 = 0u32;
  pub pVertexAttributeDescriptions *VertexInputAttributeDescription;
}

pub struct PipelineInputAssemblyStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub topology u32 = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
  pub primitiveRestartEnable u32 = FALSE;
}

pub struct Viewport {
  pub x f32;
  pub y f32;
  pub width f32;
  pub height f32;
  pub minDepth f32;
  pub maxDepth f32;
}

pub struct PipelineViewportStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub viewportCount u32 = 0u32;
  pub pViewports *Viewport;
  pub scissorCount u32 = 0u32;
  pub pScissors *Rect2D;
}

pub struct PipelineRasterizationStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub depthClampEnable u32 = FALSE;
  pub rasterizerDiscardEnable u32 = FALSE;
  pub polygonMode u32 = POLYGON_MODE_FILL;
  pub cullMode u32 = CULL_MODE_NONE;
  pub frontFace u32 = FRONT_FACE_COUNTER_CLOCKWISE;
  pub depthBiasEnable u32 = FALSE;
  pub depthBiasConstantFactor f32 = 0.;
  pub depthBiasClamp f32 = 0.;
  pub depthBiasSlopeFactor f32 = 0.;
  pub lineWidth f32 = 1.;
}

pub struct PipelineMultisampleStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub rasterizationSamples u32 = SAMPLE_COUNT_1_BIT;
  pub sampleShadingEnable u32 = FALSE;
  pub minSampleShading f32 = 0.;
  pub pSampleMask *u32;
  pub alphaToCoverageEnable u32 = FALSE;
  pub alphaToOneEnable u32 = FALSE;
}

pub struct StencilOpState {
  pub failOp u32 = 0u32;
  pub passOp u32 = 0u32;
  pub depthFailOp u32 = 0u32;
  pub compareOp u32 = 0u32;
  pub compareMask u32 = 0u32;
  pub writeMask u32 = 0u32;
  pub reference u32 = 0u32;
}

pub struct PipelineDepthStencilStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub depthTestEnable u32 = FALSE;
  pub depthWriteEnable u32 = FALSE;
  pub depthCompareOp u32 = COMPARE_OP_LESS;
  pub depthBoundsTestEnable u32 = FALSE;
  pub stencilTestEnable u32 = FALSE;
  pub front StencilOpState;
  pub back StencilOpState;
  pub minDepthBounds f32 = 0.;
  pub maxDepthBounds f32 = 1.;
}

pub struct PipelineColorBlendAttachmentState {
  pub blendEnable u32 = FALSE;
  pub srcColorBlendFactor u32 = BLEND_FACTOR_ONE;
  pub dstColorBlendFactor u32 = BLEND_FACTOR_ZERO;
  pub colorBlendOp u32 = BLEND_OP_ADD;
  pub srcAlphaBlendFactor u32 = BLEND_FACTOR_ONE;
  pub dstAlphaBlendFactor u32 = BLEND_FACTOR_ZERO;
  pub alphaBlendOp u32 = BLEND_OP_ADD;
  pub colorWriteMask u32 = COLOR_COMPONENT_ALL;
}

pub struct PipelineColorBlendStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub logicOpEnable u32 = FALSE;
  pub logicOp u32 = 0u32;
  pub attachmentCount u32 = 0u32;
  pub pAttachments *PipelineColorBlendAttachmentState;
  pub blendConstants [4; f32];
}

pub struct PipelineDynamicStateCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub dynamicStateCount u32 = 0u32;
  pub pDynamicStates *u32;
}

// Chained from a GraphicsPipelineCreateInfo: the attachments' formats, for
// dynamic rendering, in place of a render pass
pub struct PipelineRenderingCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO;
  pub pNext *u8;
  pub viewMask u32 = 0u32;
  pub colorAttachmentCount u32 = 0u32;
  pub pColorAttachmentFormats *u32;
  pub depthAttachmentFormat u32 = FORMAT_UNDEFINED;
  pub stencilAttachmentFormat u32 = FORMAT_UNDEFINED;
}

pub struct GraphicsPipelineCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub stageCount u32 = 0u32;
  pub pStages *PipelineShaderStageCreateInfo;
  pub pVertexInputState *PipelineVertexInputStateCreateInfo;
  pub pInputAssemblyState *PipelineInputAssemblyStateCreateInfo;
  pub pTessellationState *u8;
  pub pViewportState *PipelineViewportStateCreateInfo;
  pub pRasterizationState *PipelineRasterizationStateCreateInfo;
  pub pMultisampleState *PipelineMultisampleStateCreateInfo;
  pub pDepthStencilState *PipelineDepthStencilStateCreateInfo;
  pub pColorBlendState *PipelineColorBlendStateCreateInfo;
  pub pDynamicState *PipelineDynamicStateCreateInfo;
  pub layout PipelineLayout;
  pub renderPass RenderPass;              // null with dynamic rendering
  pub subpass u32 = 0u32;
  pub basePipelineHandle Pipeline;
  pub basePipelineIndex i32 = -1i32;
}

pub struct PushConstantRange { pub stageFlags u32; pub offset u32; pub size u32; }

pub struct PipelineLayoutCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub setLayoutCount u32 = 0u32;
  pub pSetLayouts *DescriptorSetLayout;
  pub pushConstantRangeCount u32 = 0u32;
  pub pPushConstantRanges *PushConstantRange;
}

pub struct DescriptorSetLayoutBinding {
  pub binding u32 = 0u32;
  pub descriptorType u32 = 0u32;
  pub descriptorCount u32 = 1u32;
  pub stageFlags u32 = 0u32;
  pub pImmutableSamplers *Sampler;
}

pub struct DescriptorSetLayoutCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub bindingCount u32 = 0u32;
  pub pBindings *DescriptorSetLayoutBinding;
}

pub struct DescriptorPoolSize { pub type u32; pub descriptorCount u32; }

pub struct DescriptorPoolCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub maxSets u32 = 0u32;
  pub poolSizeCount u32 = 0u32;
  pub pPoolSizes *DescriptorPoolSize;
}

pub struct DescriptorSetAllocateInfo {
  pub sType u32 = STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
  pub pNext *u8;
  pub descriptorPool DescriptorPool;
  pub descriptorSetCount u32 = 0u32;
  pub pSetLayouts *DescriptorSetLayout;
}

// How a sampler reads a texture: its filters, how coordinates outside 0 to 1
// wrap, and the mip levels it may use
pub struct SamplerCreateInfo {
  pub sType u32 = STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
  pub pNext *u8;
  pub flags u32 = 0u32;
  pub magFilter u32 = FILTER_NEAREST;
  pub minFilter u32 = FILTER_NEAREST;
  pub mipmapMode u32 = SAMPLER_MIPMAP_MODE_NEAREST;
  pub addressModeU u32 = SAMPLER_ADDRESS_MODE_REPEAT;
  pub addressModeV u32 = SAMPLER_ADDRESS_MODE_REPEAT;
  pub addressModeW u32 = SAMPLER_ADDRESS_MODE_REPEAT;
  pub mipLodBias f32 = 0.;
  pub anisotropyEnable u32 = 0u32;
  pub maxAnisotropy f32 = 1.;
  pub compareEnable u32 = 0u32;
  pub compareOp u32 = 0u32;
  pub minLod f32 = 0.;
  pub maxLod f32 = 0.;
  pub borderColor u32 = 0u32;
  pub unnormalizedCoordinates u32 = 0u32;
}

pub struct DescriptorBufferInfo { pub buffer Buffer; pub offset u64; pub range u64; }
pub struct DescriptorImageInfo { pub sampler Sampler; pub imageView ImageView; pub imageLayout u32; }

pub struct WriteDescriptorSet {
  pub sType u32 = STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
  pub pNext *u8;
  pub dstSet DescriptorSet;
  pub dstBinding u32 = 0u32;
  pub dstArrayElement u32 = 0u32;
  pub descriptorCount u32 = 0u32;
  pub descriptorType u32 = 0u32;
  pub pImageInfo *DescriptorImageInfo;
  pub pBufferInfo *DescriptorBufferInfo;
  pub pTexelBufferView *u64;
}

// ---- The functions, as function-reference types ----
//
// (A typedef each: a '&fn' type written as a parameter that is not the last
// fails to parse today, and each is the type 'load' casts an address to.)

pub typedef PFN_GetInstanceProcAddr &fn(instance Instance, pName *u8) *u8;
pub typedef PFN_GetDeviceProcAddr &fn(device Device, pName *u8) *u8;

// Global: need no instance
pub typedef PFN_EnumerateInstanceVersion &fn(pApiVersion &mut u32) i32;
pub typedef PFN_EnumerateInstanceExtensionProperties &fn(pLayerName *u8, pPropertyCount &mut u32,
  pProperties *ExtensionProperties) i32;
pub typedef PFN_EnumerateInstanceLayerProperties &fn(pPropertyCount &mut u32, pProperties *LayerProperties) i32;
pub typedef PFN_CreateInstance &fn(pCreateInfo &InstanceCreateInfo, pAllocator *u8, pInstance &mut Instance) i32;

// Instance
pub typedef PFN_DestroyInstance &fn(instance Instance, pAllocator *u8);
pub typedef PFN_EnumeratePhysicalDevices &fn(instance Instance, pPhysicalDeviceCount &mut u32,
  pPhysicalDevices *PhysicalDevice) i32;
pub typedef PFN_GetPhysicalDeviceProperties &fn(physicalDevice PhysicalDevice, pProperties &mut PhysicalDeviceProperties);
pub typedef PFN_GetPhysicalDeviceFeatures2 &fn(physicalDevice PhysicalDevice, pFeatures &mut PhysicalDeviceFeatures2);
pub typedef PFN_GetPhysicalDeviceQueueFamilyProperties &fn(physicalDevice PhysicalDevice,
  pQueueFamilyPropertyCount &mut u32, pQueueFamilyProperties *QueueFamilyProperties);
pub typedef PFN_GetPhysicalDeviceMemoryProperties &fn(physicalDevice PhysicalDevice,
  pMemoryProperties &mut PhysicalDeviceMemoryProperties);
pub typedef PFN_EnumerateDeviceExtensionProperties &fn(physicalDevice PhysicalDevice, pLayerName *u8,
  pPropertyCount &mut u32, pProperties *ExtensionProperties) i32;
pub typedef PFN_CreateDevice &fn(physicalDevice PhysicalDevice, pCreateInfo &DeviceCreateInfo, pAllocator *u8,
  pDevice &mut Device) i32;
pub typedef PFN_DestroySurfaceKHR &fn(instance Instance, surface SurfaceKHR, pAllocator *u8);
pub typedef PFN_GetPhysicalDeviceSurfaceSupportKHR &fn(physicalDevice PhysicalDevice, queueFamilyIndex u32,
  surface SurfaceKHR, pSupported &mut u32) i32;
pub typedef PFN_GetPhysicalDeviceSurfaceCapabilitiesKHR &fn(physicalDevice PhysicalDevice, surface SurfaceKHR,
  pSurfaceCapabilities &mut SurfaceCapabilitiesKHR) i32;
pub typedef PFN_GetPhysicalDeviceSurfaceFormatsKHR &fn(physicalDevice PhysicalDevice, surface SurfaceKHR,
  pSurfaceFormatCount &mut u32, pSurfaceFormats *SurfaceFormatKHR) i32;
pub typedef PFN_GetPhysicalDeviceSurfacePresentModesKHR &fn(physicalDevice PhysicalDevice, surface SurfaceKHR,
  pPresentModeCount &mut u32, pPresentModes *u32) i32;
pub typedef PFN_CreateDebugUtilsMessengerEXT &fn(instance Instance, pCreateInfo &DebugUtilsMessengerCreateInfoEXT,
  pAllocator *u8, pMessenger &mut DebugUtilsMessengerEXT) i32;
pub typedef PFN_DestroyDebugUtilsMessengerEXT &fn(instance Instance, messenger DebugUtilsMessengerEXT, pAllocator *u8);

// Device
pub typedef PFN_DestroyDevice &fn(device Device, pAllocator *u8);
pub typedef PFN_GetDeviceQueue &fn(device Device, queueFamilyIndex u32, queueIndex u32, pQueue &mut Queue);
pub typedef PFN_DeviceWaitIdle &fn(device Device) i32;
pub typedef PFN_QueueWaitIdle &fn(queue Queue) i32;
pub typedef PFN_CreateSwapchainKHR &fn(device Device, pCreateInfo &SwapchainCreateInfoKHR, pAllocator *u8,
  pSwapchain &mut SwapchainKHR) i32;
pub typedef PFN_DestroySwapchainKHR &fn(device Device, swapchain SwapchainKHR, pAllocator *u8);
pub typedef PFN_GetSwapchainImagesKHR &fn(device Device, swapchain SwapchainKHR, pSwapchainImageCount &mut u32,
  pSwapchainImages *Image) i32;
pub typedef PFN_AcquireNextImageKHR &fn(device Device, swapchain SwapchainKHR, timeout u64, semaphore Semaphore,
  fence Fence, pImageIndex &mut u32) i32;
pub typedef PFN_QueuePresentKHR &fn(queue Queue, pPresentInfo &PresentInfoKHR) i32;
pub typedef PFN_CreateImage &fn(device Device, pCreateInfo &ImageCreateInfo, pAllocator *u8, pImage &mut Image) i32;
pub typedef PFN_DestroyImage &fn(device Device, image Image, pAllocator *u8);
pub typedef PFN_GetImageMemoryRequirements &fn(device Device, image Image, pMemoryRequirements &mut MemoryRequirements);
pub typedef PFN_BindImageMemory &fn(device Device, image Image, memory DeviceMemory, memoryOffset u64) i32;
pub typedef PFN_CreateImageView &fn(device Device, pCreateInfo &ImageViewCreateInfo, pAllocator *u8,
  pView &mut ImageView) i32;
pub typedef PFN_DestroyImageView &fn(device Device, imageView ImageView, pAllocator *u8);
pub typedef PFN_CreateCommandPool &fn(device Device, pCreateInfo &CommandPoolCreateInfo, pAllocator *u8,
  pCommandPool &mut CommandPool) i32;
pub typedef PFN_DestroyCommandPool &fn(device Device, commandPool CommandPool, pAllocator *u8);
pub typedef PFN_ResetCommandPool &fn(device Device, commandPool CommandPool, flags u32) i32;
pub typedef PFN_AllocateCommandBuffers &fn(device Device, pAllocateInfo &CommandBufferAllocateInfo,
  pCommandBuffers *CommandBuffer) i32;
pub typedef PFN_FreeCommandBuffers &fn(device Device, commandPool CommandPool, commandBufferCount u32,
  pCommandBuffers *CommandBuffer);
pub typedef PFN_BeginCommandBuffer &fn(commandBuffer CommandBuffer, pBeginInfo &CommandBufferBeginInfo) i32;
pub typedef PFN_EndCommandBuffer &fn(commandBuffer CommandBuffer) i32;
pub typedef PFN_CreateFence &fn(device Device, pCreateInfo &FenceCreateInfo, pAllocator *u8, pFence &mut Fence) i32;
pub typedef PFN_DestroyFence &fn(device Device, fence Fence, pAllocator *u8);
pub typedef PFN_WaitForFences &fn(device Device, fenceCount u32, pFences *Fence, waitAll u32, timeout u64) i32;
pub typedef PFN_ResetFences &fn(device Device, fenceCount u32, pFences *Fence) i32;
pub typedef PFN_CreateSemaphore &fn(device Device, pCreateInfo &SemaphoreCreateInfo, pAllocator *u8,
  pSemaphore &mut Semaphore) i32;
pub typedef PFN_DestroySemaphore &fn(device Device, semaphore Semaphore, pAllocator *u8);
pub typedef PFN_QueueSubmit2 &fn(queue Queue, submitCount u32, pSubmits *SubmitInfo2, fence Fence) i32;
pub typedef PFN_CmdPipelineBarrier2 &fn(commandBuffer CommandBuffer, pDependencyInfo &DependencyInfo);
pub typedef PFN_CmdBeginRendering &fn(commandBuffer CommandBuffer, pRenderingInfo &RenderingInfo);
pub typedef PFN_CmdEndRendering &fn(commandBuffer CommandBuffer);
pub typedef PFN_CreateBuffer &fn(device Device, pCreateInfo &BufferCreateInfo, pAllocator *u8, pBuffer &mut Buffer) i32;
pub typedef PFN_DestroyBuffer &fn(device Device, buffer Buffer, pAllocator *u8);
pub typedef PFN_GetBufferMemoryRequirements &fn(device Device, buffer Buffer,
  pMemoryRequirements &mut MemoryRequirements);
pub typedef PFN_AllocateMemory &fn(device Device, pAllocateInfo &MemoryAllocateInfo, pAllocator *u8,
  pMemory &mut DeviceMemory) i32;
pub typedef PFN_FreeMemory &fn(device Device, memory DeviceMemory, pAllocator *u8);
pub typedef PFN_BindBufferMemory &fn(device Device, buffer Buffer, memory DeviceMemory, memoryOffset u64) i32;
pub typedef PFN_MapMemory &fn(device Device, memory DeviceMemory, offset u64, size u64, flags u32,
  ppData &mut *u8) i32;
pub typedef PFN_UnmapMemory &fn(device Device, memory DeviceMemory);
pub typedef PFN_CmdCopyBuffer &fn(commandBuffer CommandBuffer, srcBuffer Buffer, dstBuffer Buffer,
  regionCount u32, pRegions *BufferCopy);
pub typedef PFN_CmdCopyImageToBuffer &fn(commandBuffer CommandBuffer, srcImage Image, srcImageLayout u32,
  dstBuffer Buffer, regionCount u32, pRegions *BufferImageCopy);
pub typedef PFN_CmdCopyBufferToImage &fn(commandBuffer CommandBuffer, srcBuffer Buffer, dstImage Image,
  dstImageLayout u32, regionCount u32, pRegions *BufferImageCopy);
pub typedef PFN_CreateShaderModule &fn(device Device, pCreateInfo &ShaderModuleCreateInfo, pAllocator *u8,
  pShaderModule &mut ShaderModule) i32;
pub typedef PFN_DestroyShaderModule &fn(device Device, shaderModule ShaderModule, pAllocator *u8);
pub typedef PFN_CreateSampler &fn(device Device, pCreateInfo &SamplerCreateInfo, pAllocator *u8,
  pSampler &mut Sampler) i32;
pub typedef PFN_DestroySampler &fn(device Device, sampler Sampler, pAllocator *u8);
pub typedef PFN_CreatePipelineLayout &fn(device Device, pCreateInfo &PipelineLayoutCreateInfo, pAllocator *u8,
  pPipelineLayout &mut PipelineLayout) i32;
pub typedef PFN_DestroyPipelineLayout &fn(device Device, pipelineLayout PipelineLayout, pAllocator *u8);
pub typedef PFN_CreateGraphicsPipelines &fn(device Device, pipelineCache PipelineCache, createInfoCount u32,
  pCreateInfos *GraphicsPipelineCreateInfo, pAllocator *u8, pPipelines *Pipeline) i32;
pub typedef PFN_DestroyPipeline &fn(device Device, pipeline Pipeline, pAllocator *u8);
pub typedef PFN_CreateDescriptorSetLayout &fn(device Device, pCreateInfo &DescriptorSetLayoutCreateInfo,
  pAllocator *u8, pSetLayout &mut DescriptorSetLayout) i32;
pub typedef PFN_DestroyDescriptorSetLayout &fn(device Device, descriptorSetLayout DescriptorSetLayout, pAllocator *u8);
pub typedef PFN_CreateDescriptorPool &fn(device Device, pCreateInfo &DescriptorPoolCreateInfo, pAllocator *u8,
  pDescriptorPool &mut DescriptorPool) i32;
pub typedef PFN_DestroyDescriptorPool &fn(device Device, descriptorPool DescriptorPool, pAllocator *u8);
pub typedef PFN_AllocateDescriptorSets &fn(device Device, pAllocateInfo &DescriptorSetAllocateInfo,
  pDescriptorSets *DescriptorSet) i32;
pub typedef PFN_UpdateDescriptorSets &fn(device Device, descriptorWriteCount u32,
  pDescriptorWrites *WriteDescriptorSet, descriptorCopyCount u32, pDescriptorCopies *u8);
pub typedef PFN_CmdBindPipeline &fn(commandBuffer CommandBuffer, pipelineBindPoint u32, pipeline Pipeline);
pub typedef PFN_CmdBindDescriptorSets &fn(commandBuffer CommandBuffer, pipelineBindPoint u32,
  layout PipelineLayout, firstSet u32, descriptorSetCount u32, pDescriptorSets *DescriptorSet,
  dynamicOffsetCount u32, pDynamicOffsets *u32);
pub typedef PFN_CmdBindVertexBuffers &fn(commandBuffer CommandBuffer, firstBinding u32, bindingCount u32,
  pBuffers *Buffer, pOffsets *u64);
pub typedef PFN_CmdBindIndexBuffer &fn(commandBuffer CommandBuffer, buffer Buffer, offset u64, indexType u32);
pub typedef PFN_CmdSetViewport &fn(commandBuffer CommandBuffer, firstViewport u32, viewportCount u32,
  pViewports *Viewport);
pub typedef PFN_CmdSetScissor &fn(commandBuffer CommandBuffer, firstScissor u32, scissorCount u32,
  pScissors *Rect2D);
pub typedef PFN_CmdPushConstants &fn(commandBuffer CommandBuffer, layout PipelineLayout, stageFlags u32,
  offset u32, size u32, pValues *u8);
pub typedef PFN_CmdDraw &fn(commandBuffer CommandBuffer, vertexCount u32, instanceCount u32,
  firstVertex u32, firstInstance u32);
pub typedef PFN_CmdDrawIndexed &fn(commandBuffer CommandBuffer, indexCount u32, instanceCount u32,
  firstIndex u32, vertexOffset i32, firstInstance u32);

