// textdiff on 2,000 lines, 'line 0' to 'line 1999'. Every expected value is
// worked out by hand:
// - one line changed, index 1000: kept before it and after it, so three
//   spans, and the hunk shows indexes 997 to 1003, lines 998 to 1004, seven
//   on each side;
// - nothing in common (each line 'other <i>'): one span replacing all 2,000
//   with 2,000, one hunk of 4,000 lines, 4,003 with the headers;
// - every tenth line changed (indexes 0, 10, ..., 1990, each made 'x<i>'):
//   200 replaced lines, each followed by 9 kept, so 400 spans alternating
//   from a replace; with 3 lines around, 9 kept lines between two changes
//   are more than 6, so each change has its own hunk, 200 of them.
// The edit costs time in proportion to the lines times the lines changed:
// the whole program, its three edits included, runs in about 0.2 seconds in
// a debug build (measured 1 Oct 2026), within the 60 seconds 'congo test'
// allows a test.

mod large;

import testing use *;
import collections use *;
import textdiff use Span, Kind, spans, unified;

const count = 2000usize;

// 'line <i>' for each i, but where 'changed' says otherwise
fn numbered(prefix &Array[u8], every usize, changedPrefix &Array[u8]) List[String] {
  mut out = List[String].withCapacity(count);
  mut i = 0usize;
  while i < count {
    mut line = String.empty();
    if every > 0usize and i % every == 0usize {
      line.append(changedPrefix);
    }
    else {
      line.append(prefix);
    }
    line.appendUInt(u64.from(i));
    out.push(line);
    i = i + 1usize;
  }
  out;
}

// How many lines of a text begin with 'start'
fn countLines(text &Array[u8], start &Array[u8]) u64 {
  mut n = 0u64;
  mut lineStart = 0usize;
  mut i = 0usize;
  while i < text.len {
    if text[i] == '\n' {
      if i - lineStart >= start.len and &text[lineStart..lineStart + start.len] == start { n = n + 1u64; }
      lineStart = i + 1usize;
    }
    i = i + 1usize;
  }
  n;
}

fn same(s Span, kind Kind, aStart usize, aEnd usize, bStart usize, bEnd usize) bool {
  s.kind == kind and s.aStart == aStart and s.aEnd == aEnd and s.bStart == bStart and s.bEnd == bEnd;
}

fn main() i32 {
  imm base = numbered("line ", 0usize, "");

  // One line changed
  mut one = numbered("line ", 0usize, "");
  one.set(1000usize, String.from("changed"));
  imm s1 = spans(base.view(), one.view());
  expectUInt(u64.from(s1.len()), 3, "one change: three spans");
  expect(same(*s1[0usize], Kind.Equal[], 0usize, 1000usize, 0usize, 1000usize), "kept before it");
  expect(same(*s1[1usize], Kind.Replace[], 1000usize, 1001usize, 1000usize, 1001usize), "the line replaced");
  expect(same(*s1[2usize], Kind.Equal[], 1001usize, 2000usize, 1001usize, 2000usize), "kept after it");
  imm d1 = unified(base.view(), one.view(), "a", "b");
  expectStr(d1.view(),
            "--- a\n+++ b\n@@ -998,7 +998,7 @@\n line 997\n line 998\n line 999\n-line 1000\n+changed\n line 1001\n line 1002\n line 1003\n",
            "one change: the hunk");

  // Nothing in common
  imm other = numbered("other ", 0usize, "");
  imm s2 = spans(base.view(), other.view());
  expectUInt(u64.from(s2.len()), 1, "nothing in common: one span");
  expect(same(*s2[0usize], Kind.Replace[], 0usize, 2000usize, 0usize, 2000usize), "everything replaced");
  imm d2 = unified(base.view(), other.view(), "a", "b");
  expect(d2.startsWith("--- a\n+++ b\n@@ -1,2000 +1,2000 @@\n-line 0\n-line 1\n"), "nothing in common: the start");
  expect(d2.contains("\n-line 1999\n+other 0\n"), "a's lines all come before b's");
  expect(d2.endsWith("\n+other 1998\n+other 1999\n"), "nothing in common: the end");
  expectUInt(countLines(d2.view(), "-line "), 2000, "nothing in common: 2000 deleted");
  expectUInt(countLines(d2.view(), "+other "), 2000, "nothing in common: 2000 inserted");

  // Every tenth line changed
  imm tenth = numbered("line ", 10usize, "x");
  imm s3 = spans(base.view(), tenth.view());
  expectUInt(u64.from(s3.len()), 400, "every tenth: 400 spans");
  mut ok = true;
  mut k = 0usize;
  while k < 200usize {
    imm at = k * 10usize;
    ok = ok and same(*s3[2usize * k], Kind.Replace[], at, at + 1usize, at, at + 1usize);
    ok = ok and same(*s3[2usize * k + 1usize], Kind.Equal[], at + 1usize, at + 10usize, at + 1usize, at + 10usize);
    k = k + 1usize;
  }
  expect(ok, "every tenth: a replace and nine kept, 200 times");
  imm d3 = unified(base.view(), tenth.view(), "a", "b");
  expectUInt(countLines(d3.view(), "@@ "), 200, "every tenth: 200 hunks");
  expectUInt(countLines(d3.view(), "-line "), 200, "every tenth: 200 deleted");
  expectUInt(countLines(d3.view(), "+x"), 200, "every tenth: 200 inserted");
  expect(d3.startsWith("--- a\n+++ b\n@@ -1,4 +1,4 @@\n-line 0\n+x0\n line 1\n line 2\n line 3\n@@ -8,7 +8,7 @@\n line 7\n"),
         "every tenth: the first two hunks");
  done();
}
