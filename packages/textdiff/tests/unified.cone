// textdiff.unified and unifiedText: the unified diff, as 'diff -u' and
// Python's difflib.unified_diff print it. Every expected value is worked out
// by hand from the format's rules:
// - the headers '--- a' and '+++ b', with no dates;
// - a hunk's header '@@ -start,count +start,count @@', each start counted
//   from 1, ',count' left out when the count is 1, and an empty stretch
//   named by the line before it ('0,0' before the first line);
// - 'around' unchanged lines, 3 unless given, before and after each change;
//   two changes with at most twice that many unchanged lines between share a
//   hunk, and more apart start a new one;
// - within a run of changes, a's lines ('-') before b's ('+');
// - a text's last line with no '\n' is followed by '\ No newline at end of
//   file', and differs from the same line with one;
// - lines compare byte for byte: a '\r' is part of its line, and an
//   accented letter differs from its plain one ("é" is the two bytes 0xC3
//   0xA9, "日本" six more).

mod unified;

import testing use *;
import collections use *;
import textdiff;

// The diff from text a to text b, named 'a' and 'b', is 'want'
fn expectDiff(a &[]u8, b &[]u8, want &[]u8, label &[]u8) Bool {
  imm got = textdiff.unifiedText(a, b, "a", "b");
  expectStr(got.view(), want, label);
}

// The same, with 'around' lines around each change
fn expectDiffAround(a &[]u8, b &[]u8, around usize, want &[]u8, label &[]u8) Bool {
  imm got = textdiff.unifiedText(a, b, "a", "b", around);
  expectStr(got.view(), want, label);
}

fn main() i32 {
  // The same texts: no diff at all
  expectDiff("", "", "", "two empty texts");
  expectDiff("one\ntwo\n", "one\ntwo\n", "", "the same texts");
  expectDiff("one\ntwo", "one\ntwo", "", "the same texts, no last newline");

  // One side empty: the empty stretch is '0,0'
  expectDiff("", "x\ny\n", "--- a\n+++ b\n@@ -0,0 +1,2 @@\n+x\n+y\n",
            "empty against two lines");
  expectDiff("x\ny\n", "", "--- a\n+++ b\n@@ -1,2 +0,0 @@\n-x\n-y\n",
            "two lines against empty");

  // An insertion, a deletion, a change: every line within 3 of it shown
  expectDiff("a\nb\nc\nd\n", "a\nb\nnew\nc\nd\n",
            "--- a\n+++ b\n@@ -1,4 +1,5 @@\n a\n b\n+new\n c\n d\n", "a line inserted");
  expectDiff("a\nb\nc\nd\n", "a\nc\nd\n",
            "--- a\n+++ b\n@@ -1,4 +1,3 @@\n a\n-b\n c\n d\n", "a line deleted");
  // l5 changed among nine: lines 2 to 8 shown, 7 of them on each side
  expectDiff("l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\n", "l1\nl2\nl3\nl4\nfive\nl6\nl7\nl8\nl9\n",
            "--- a\n+++ b\n@@ -2,7 +2,7 @@\n l2\n l3\n l4\n-l5\n+five\n l6\n l7\n l8\n",
            "a change in the middle");
  // The same with 1 line around it, and with none: a count of 1 is left out
  expectDiffAround("l1\nl2\nl3\n", "l1\ntwo\nl3\n", 1usize,
            "--- a\n+++ b\n@@ -1,3 +1,3 @@\n l1\n-l2\n+two\n l3\n", "one line around a change");
  expectDiffAround("l1\nl2\nl3\n", "l1\ntwo\nl3\n", 0usize,
            "--- a\n+++ b\n@@ -2 +2 @@\n-l2\n+two\n", "no lines around a change");
  // An insertion with none around it: the empty stretch names the line before
  expectDiffAround("a\nb\n", "a\nnew\nb\n", 0usize,
            "--- a\n+++ b\n@@ -1,0 +2 @@\n+new\n", "an insertion, nothing around it");

  // Changes at both ends. Three lines between them: with 3 around (twice
  // that is 6), one hunk; with 1 around (twice that is 2), two hunks, each
  // with one of the middle lines
  expectDiff("first\nm1\nm2\nm3\nlast\n", "FIRST\nm1\nm2\nm3\nLAST\n",
            "--- a\n+++ b\n@@ -1,5 +1,5 @@\n-first\n+FIRST\n m1\n m2\n m3\n-last\n+LAST\n",
            "changes at both ends, one hunk");
  expectDiffAround("first\nm1\nm2\nm3\nlast\n", "FIRST\nm1\nm2\nm3\nLAST\n", 1usize,
            "--- a\n+++ b\n@@ -1,2 +1,2 @@\n-first\n+FIRST\n m1\n@@ -4,2 +4,2 @@\n m3\n-last\n+LAST\n",
            "changes at both ends, two hunks");
  // Two lines between them with 1 around: exactly twice, still one hunk
  expectDiffAround("x\nm1\nm2\ny\n", "X\nm1\nm2\nY\n", 1usize,
            "--- a\n+++ b\n@@ -1,4 +1,4 @@\n-x\n+X\n m1\n m2\n-y\n+Y\n",
            "two lines between changes, one around: one hunk");

  // Repeated lines: the lines both start with are kept from the start
  expectDiff("x\nx\nx\n", "x\nx\n", "--- a\n+++ b\n@@ -1,3 +1,2 @@\n x\n x\n-x\n",
            "three x's to two");
  expectDiff("\n\n\n", "\n\n\n\n\n", "--- a\n+++ b\n@@ -1,3 +1,5 @@\n \n \n \n+\n+\n",
            "three blank lines to five");

  // The last newline: missing on one side, the other, or both
  expectDiff("a\nb\n", "a\nb",
            "--- a\n+++ b\n@@ -1,2 +1,2 @@\n a\n-b\n+b\n\\ No newline at end of file\n",
            "the newline dropped");
  expectDiff("a\nb", "a\nb\n",
            "--- a\n+++ b\n@@ -1,2 +1,2 @@\n a\n-b\n\\ No newline at end of file\n+b\n",
            "the newline added");
  expectDiff("a\nb", "a\nc",
            "--- a\n+++ b\n@@ -1,2 +1,2 @@\n a\n-b\n\\ No newline at end of file\n+c\n\\ No newline at end of file\n",
            "neither has one");
  expectDiff("a\nb", "a\nb\nc",
            "--- a\n+++ b\n@@ -1,2 +1,3 @@\n a\n-b\n\\ No newline at end of file\n+b\n+c\n\\ No newline at end of file\n",
            "a line added after a last line with none");
  // A '\r' is part of its line
  expectDiff("a\r\nb\r\n", "a\nb\n", "--- a\n+++ b\n@@ -1,2 +1,2 @@\n-a\r\n-b\r\n+a\n+b\n",
            "CRLF against LF");

  // Beyond ASCII
  expectDiff("café\n日本\n", "cafe\n日本\n",
            "--- a\n+++ b\n@@ -1,2 +1,2 @@\n-café\n+cafe\n 日本\n", "an accent dropped");
  expectDiff("日本\n", "日本\n", "", "the same non-ASCII text");

  // Lists of lines, as Congo compares a test's output: its line ends taken
  // off, each line shown with '\n' after it. Its failure diff has 2 lines
  // around and names the expected file and 'actual'
  mut want = List[String].empty();
  want.push(String.from("5"));
  mut got = List[String].empty();
  got.push(String.from("4"));
  imm congo = textdiff.unified(want.view(), got.view(), "tests\\wrong.out", "actual", 2usize);
  expectStr(congo.view(), "--- tests\\wrong.out\n+++ actual\n@@ -1 +1 @@\n-5\n+4\n", "Congo's wrong test");
  imm same = textdiff.unified(want.view(), want.view(), "x", "y");
  expectStr(same.view(), "", "the same list");
  mut none = List[String].empty();
  imm added = textdiff.unified(none.view(), want.view(), "x", "y");
  expectStr(added.view(), "--- x\n+++ y\n@@ -0,0 +1 @@\n+5\n", "a line against none");
  done();
}
