// ======== Generating a heightfield on the CPU ========
//
// The same function the 'generate' kernel (gpu/shape.cone) runs on the GPU, called once a sample.

// A field of w x h samples, 'cell' metres apart, the first at (originX, originZ), from the recipe
pub fn generate(p &ShapeParams, w usize, h usize, cell f32, originX f32, originZ f32) Heightfield {
  mut hf = Heightfield.make(w, h, cell, originX, originZ, 0.);
  imm sp = *p;
  mut iz = 0usize;
  while iz < h {
    mut ix = 0usize;
    while ix < w {
      hf.set(ix, iz, heightAt(sp, originX + f32.from(ix) * cell, originZ + f32.from(iz) * cell));
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  hf;
}
