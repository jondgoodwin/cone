// ======== Landscape: a whole terrain from one description ========
//
// A TerrainSpec is the entire description of a landscape: the shape recipe (gpu/shape.cone), the
// grid it is sampled on, how it is eroded, how rivers are cut, how the masks and biomes are made.
// 'buildLandscape' (CPU) and 'buildLandscapeOn' (erosion on a GPU) run the same pipeline:
//
//   1. generate the heights from the recipe;
//   2. erode them (hydraulic and thermal, erode.cone);
//   3. analyse the drainage of the eroded ground (hydrology.cone), cut rivers, and re-analyse it;
//   4. compute the masks and the biome weights (masks.cone).
//
// The result is a Landscape: the final heights, the drainage, the water, and the masks. It answers
// the questions a renderer and a physics engine ask: the height at any point, the normal, the water's
// depth, and a tile of the heights cut with a border (what a terrain-LOD renderer consumes).
//
// "Here is a picture of a mountain range; do something like it" becomes choosing the fields of a
// TerrainSpec; 'alpine', 'mesa' and 'hills' are three such choices, as data.

pub struct TerrainSpec {
  pub shape ShapeParams;
  pub w usize;
  pub h usize;
  pub cell f32;
  pub originX f32;
  pub originZ f32;
  pub erosion ErosionParams;
  pub plan ErosionPlan;
  pub rivers RiverSpec;
  pub riversOn bool;
  pub masks MaskSpec;
  pub biomes List[Biome];
  pub lakeMin f32;        // a depression shallower than this (metres) is no lake: a puddle the water runs through
  pub lakeMax f32;        // a depression deeper than this (metres) is left dry, not made a lake
  pub seaLevel f32;       // ground below this height is sea; -100000 for none
}

pub struct Landscape {
  pub height Heightfield;
  pub hydrology Hydrology;
  pub water RiverMaps;
  pub masks MaskSet;
  pub eroded bool;
  pub seconds f64;

  pub fn heightAt(self &, x f32, z f32) f32 { height.sample(x, z); }
  pub fn normalAt(self &, x f32, z f32) Vec3 { height.normalAt(x, z); }
  pub fn waterDepthAt(self &, x f32, z f32) f32 {
    let gx = (x - height.originX) / height.cell;
    let gz = (z - height.originZ) / height.cell;
    let ix = i32.from(libc.floorf(gx + 0.5));
    let iz = i32.from(libc.floorf(gz + 0.5));
    var a = ix;
    var b = iz;
    if a < 0 { a = 0; }
    if b < 0 { b = 0; }
    if a > i32.from(height.w) - 1 { a = i32.from(height.w) - 1; }
    if b > i32.from(height.h) - 1 { b = i32.from(height.h) - 1; }
    *water.waterDepth[usize.from(b) * height.w + usize.from(a)];
  }
}

pub fn gridOf(s &TerrainSpec) Grid {
  new Grid(u32.from(s.w), u32.from(s.h), s.cell, s.originX, s.originZ);
}

// Steps 3 and 4 on heights already generated and eroded
fn finish(spec &TerrainSpec, hf Heightfield, eroded bool, t0 time.Instant) Landscape {
  var ground = hf;
  let first = analyze(&ground, 0.0005, spec.lakeMin, spec.lakeMax);
  let noRivers = new RiverSpec(1.0e30, 0., 0., 0., 0.);
  var maps = if spec.riversOn { carveRivers(&mut ground, &first, &spec.rivers); }
    else { carveRivers(&mut ground, &first, &noRivers); };
  // the sea: ground below the sea level is under water, flat at the level
  var i = 0usize;
  while i < ground.data.len() {
    if *ground.data[i] < spec.seaLevel {
      maps.waterDepth.set(i, spec.seaLevel - *ground.data[i]);
      maps.surface.set(i, spec.seaLevel);
    }
    i = i + 1usize;
  }
  // re-analyse the carved ground for the drainage the masks and consumers see
  let hy = analyze(&ground, 0.0005, spec.lakeMin, spec.lakeMax);
  let masks = computeMasks(&ground, &hy, &maps, &spec.masks, &spec.biomes);
  new Landscape(ground, hy, maps, masks, eroded, t0.elapsed().secondsF64());
}

pub fn buildLandscape(spec &TerrainSpec) Landscape {
  let t0 = time.Instant.now();
  var hf = generate(&spec.shape, spec.w, spec.h, spec.cell, spec.originX, spec.originZ);
  var eroded = false;
  if spec.plan.hydraulic > 0u32 or spec.plan.thermal > 0u32 {
    let r = erodeCpu(&mut hf, &spec.erosion, &spec.plan);
    eroded = r.ok;
  }
  finish(spec, hf, eroded, t0);
}

// The same on a GPU: the heights generated by the 'generate' kernel and eroded by the erosion kernels
pub fn buildLandscapeOn(device &mut gpu.Device, spec &TerrainSpec) Landscape {
  let t0 = time.Instant.now();
  var hf = generateGpu(device, spec);
  var eroded = false;
  if spec.plan.hydraulic > 0u32 or spec.plan.thermal > 0u32 {
    let r = erodeGpu(device, &mut hf, &spec.erosion, &spec.plan);
    eroded = r.ok;
  }
  finish(spec, hf, eroded, t0);
}

// The 'generate' kernel over the spec's grid; the CPU's field if the GPU could not run it
pub fn generateGpu(device &mut gpu.Device, spec &TerrainSpec) Heightfield {
  let spirv = gpuwork.readSpirv("terraingen.spv");
  var k = gpuwork.Kernel.make(device, spirv.view(), "generate", &[gpuwork.READ, gpuwork.READ, gpuwork.READ_WRITE]);
  if spirv.len() < 6usize or !k.isValid() {
    return generate(&spec.shape, spec.w, spec.h, spec.cell, spec.originX, spec.originZ);
  }
  let n = spec.w * spec.h;
  let sp = spec.shape;
  let g = gridOf(spec);
  var job = gpuwork.Job.make(device);
  let sP = job.give(gpuwork.uploadValue(device, &sp));
  let sG = job.give(gpuwork.uploadValue(device, &g));
  let sO = job.give(gpuwork.zeroed(device, n));
  job.dispatch(device, &k, &[sP, sG, sO], (g.w + 7u32) / 8u32, (g.h + 7u32) / 8u32);
  let r = job.readback(device, sO);
  var works = gpuwork.Works.make();
  let ticket = works.submit(device, job, gpuwork.Target.Here(0u64));
  var answers = List[gpuwork.Completion].empty();
  works.waitFor(device, ticket, &mut answers);
  if answers.len() != 1usize or !answers[0usize].ok {
    return generate(&spec.shape, spec.w, spec.h, spec.cell, spec.originX, spec.originZ);
  }
  let words = answers[0usize].words(r);
  var hf = Heightfield.make(spec.w, spec.h, spec.cell, spec.originX, spec.originZ, 0.);
  var i = 0usize;
  while i < n {
    hf.data.set(i, *words[i] as f32);
    i = i + 1usize;
  }
  hf;
}

// ---- tiles ----

// How many tiles of 'tileSamples' samples a side (sharing their edge samples) cover a field of
// 'samples' samples: a tile spans tileSamples - 1 cells
pub fn tileCount(samples usize, tileSamples usize) usize {
  (samples - 1usize + (tileSamples - 2usize)) / (tileSamples - 1usize);
}

// Tile (tx, tz) of 'tileSamples' x 'tileSamples' samples, edge samples shared with its neighbours
// exactly, 'border' extra samples all round (for normals at the edge)
pub fn cutTile(hf &Heightfield, tx usize, tz usize, tileSamples usize, border usize) Heightfield {
  let step = i32.from(tileSamples) - 1;
  let x0 = i32.from(tx) * step - i32.from(border);
  let z0 = i32.from(tz) * step - i32.from(border);
  hf.tile(x0, z0, tileSamples + 2usize * border, tileSamples + 2usize * border);
}

// ---- the three presets ----

fn rockAndSnow() List[Biome] {
  var b = List[Biome].empty();
  b.push(Biome.water("water", new Color(0.02, 0.07, 0.1, 1.)));
  b.push(Biome.nearWater("shore", 10., 18., new Color(0.25, 0.2, 0.14, 1.)));
  b.push(Biome.make("snow", 0., 50., 1280., 100000., 0., 1., new Color(0.85, 0.88, 0.92, 1.)));
  b.push(Biome.make("rock", 38., 90., -10000., 100000., 0., 1., new Color(0.2, 0.18, 0.17, 1.)));
  b.push(Biome.make("scree", 26., 42., 700., 100000., 0., 1., new Color(0.32, 0.29, 0.26, 1.)));
  b.push(Biome.make("forest", 0., 30., -10000., 950., 0.3, 1., new Color(0.03, 0.07, 0.025, 1.)));
  b.push(Biome.make("alpine meadow", 0., 32., -10000., 1300., 0., 1., new Color(0.1, 0.17, 0.05, 1.)));
  b;
}

// Alpine: a jagged range: ridged crests on a broad swell, folded by a warp, eroded, with forest in
// the valleys, scree, bare rock and snow above the line
pub fn alpine(w usize, h usize, cell f32, seed u32) TerrainSpec {
  var s = ShapeParams.flat();
  s.seed = seed;
  var swell = Layer.fbm(1. / 6000., 2, 0.45, 11u32);
  s.layers[0usize] = swell;
  var ridges = Layer.ridged(1. / 2400., 7, 1., 12u32);
  ridges.gate = 0;
  ridges.gateLo = -0.35;
  ridges.gateHi = 0.25;
  s.layers[1usize] = ridges;
  var detail = Layer.fbm(1. / 700., 6, 0.22, 13u32);
  detail.damp = 6.;
  s.layers[2usize] = detail;
  s.warpStrength = 450.;
  s.warpFrequency = 1. / 4500.;
  s.warpOctaves = 3;
  s.baseHeight = 0.;
  s.heightScale = 1700.;
  s.power = 1.35;
  s.contrast = 2.6;
  var e = ErosionParams.standard(u32.from(w), u32.from(h), cell);
  e.talus = 0.75;
  new TerrainSpec(s, w, h, cell, 0., 0., e, ErosionPlan.make(120u32, 14u32, 8u32), RiverSpec.standard(), true,
    MaskSpec.standard(), rockAndSnow(), 3., 40., -100000.);
}

fn desertBiomes() List[Biome] {
  var b = List[Biome].empty();
  b.push(Biome.water("water", new Color(0.02, 0.07, 0.1, 1.)));
  b.push(Biome.nearWater("oasis", 14., 15., new Color(0.08, 0.16, 0.04, 1.)));
  b.push(Biome.make("cliff", 38., 90., -10000., 100000., 0., 1., new Color(0.33, 0.13, 0.07, 1.)));
  b.push(Biome.make("mesa top", 0., 14., 330., 100000., 0., 1., new Color(0.45, 0.27, 0.15, 1.)));
  b.push(Biome.make("red rock", 20., 40., 90., 100000., 0., 1., new Color(0.38, 0.16, 0.08, 1.)));
  b.push(Biome.make("scrub", 0., 20., -10000., 330., 0.2, 1., new Color(0.26, 0.22, 0.1, 1.)));
  b.push(Biome.make("sand", 0., 60., -10000., 100000., 0., 1., new Color(0.55, 0.42, 0.25, 1.)));
  b;
}

// Desert mesa: terraced flat-topped buttes with steep cliffs between, a dry basin of sand
pub fn mesa(w usize, h usize, cell f32, seed u32) TerrainSpec {
  var s = ShapeParams.flat();
  s.seed = seed;
  s.layers[0usize] = Layer.fbm(1. / 2400., 4, 1., 21u32);
  var b = Layer.billow(1. / 800., 3, 0.12, 22u32);
  s.layers[1usize] = b;
  s.warpStrength = 300.;
  s.warpFrequency = 1. / 2600.;
  s.warpOctaves = 3;
  s.baseHeight = 0.;
  s.heightScale = 520.;
  s.power = 1.;
  s.contrast = 3.4;
  s.terraces = 4.;
  s.terraceSharp = 16.;
  s.terraceMix = 1.;
  s.detailAmplitude = 4.;
  s.detailFrequency = 1. / 40.;
  var e = ErosionParams.standard(u32.from(w), u32.from(h), cell);
  e.talus = 1.3;
  e.rain = 0.006;
  var m = MaskSpec.standard();
  m.humidity = 0.12;
  var rv = RiverSpec.standard();
  rv.minArea = 90000.;
  new TerrainSpec(s, w, h, cell, 0., 0., e, ErosionPlan.make(45u32, 10u32, 5u32), rv, true, m, desertBiomes(), 2., 12., -100000.);
}

fn hillBiomes() List[Biome] {
  var b = List[Biome].empty();
  b.push(Biome.water("water", new Color(0.02, 0.07, 0.1, 1.)));
  b.push(Biome.nearWater("bank", 7., 16., new Color(0.18, 0.14, 0.08, 1.)));
  b.push(Biome.make("rock", 36., 90., -10000., 100000., 0., 1., new Color(0.22, 0.2, 0.18, 1.)));
  b.push(Biome.make("woodland", 0., 24., -10000., 100000., 0.5, 1., new Color(0.04, 0.09, 0.03, 1.)));
  b.push(Biome.make("hay meadow", 0., 20., -10000., 100000., 0., 0.5, new Color(0.26, 0.25, 0.09, 1.)));
  b.push(Biome.make("pasture", 0., 90., -10000., 100000., 0., 1., new Color(0.1, 0.2, 0.05, 1.)));
  b;
}

// Rolling hills: soft ridges and valleys, a river or two, no bare rock to speak of
pub fn hills(w usize, h usize, cell f32, seed u32) TerrainSpec {
  var s = ShapeParams.flat();
  s.seed = seed;
  var a = Layer.fbm(1. / 1900., 5, 1., 31u32);
  a.damp = 2.;
  s.layers[0usize] = a;
  s.layers[1usize] = Layer.billow(1. / 650., 4, 0.2, 32u32);
  s.warpStrength = 220.;
  s.warpFrequency = 1. / 2500.;
  s.warpOctaves = 3;
  s.baseHeight = 0.;
  s.heightScale = 260.;
  s.power = 1.15;
  s.contrast = 2.2;
  var e = ErosionParams.standard(u32.from(w), u32.from(h), cell);
  e.talus = 0.5;
  e.rain = 0.01;
  var m = MaskSpec.standard();
  m.humidity = 0.7;
  var rv = RiverSpec.standard();
  rv.minArea = 25000.;
  rv.depthScale = 1.0;
  rv.maxDepth = 8.;
  rv.widthScale = 3.5;
  rv.maxWidth = 16.;
  new TerrainSpec(s, w, h, cell, 0., 0., e, ErosionPlan.make(60u32, 20u32, 3u32), rv, true, m, hillBiomes(), 1., 6., -100000.);
}
