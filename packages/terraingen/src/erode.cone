// ======== Running the erosion kernels: on the CPU, and on the GPU through gpuwork ========
//
// An ErosionPlan says how many hydraulic iterations (gpu/erosion.cone's five-kernel virtual pipe
// iteration), how many thermal ones, and how they interleave: a thermal iteration after every
// 'thermalEvery' hydraulic ones (0: none between), and the remaining thermal iterations at the end.
// 'erodeCpu' calls the kernels' own functions in a loop over the invocations (their CPU twins);
// 'erodeGpu' records the same dispatches into one gpuwork Job, so a run of hundreds of iterations is
// one submission and the data never returns to the CPU in between. Every dispatch reads only what it
// does not write, so the two agree to the rounding of the GPU's square root and floor.

pub struct ErosionPlan {
  pub hydraulic u32;
  pub thermal u32;
  pub thermalEvery u32;

  pub fn make(hydraulic u32, thermal u32, thermalEvery u32) ErosionPlan { new ErosionPlan(hydraulic, thermal, thermalEvery); }
}

// What a run leaves besides the new heights: where the sediment ended (a measure of deposition) and
// the cells' water depth (the last iteration's)
pub struct ErosionResult {
  pub ok bool;
  pub sediment List[f32];
  pub water List[f32];
  pub seconds f64;
}

fn zeros(n usize) List[f32] {
  mut l = List[f32].withCapacity(n);
  l.resize(n, 0.);
  l;
}

fn inv(x u32, z u32) Invocation {
  new Invocation([x, z, 0u32], [0u32, 0u32, 0u32], [0u32, 0u32, 0u32], 0u32, [1u32, 1u32, 1u32]);
}

// Erode 'hf' on the CPU; the heights are replaced. The cell size in 'p' is the field's.
pub fn erodeCpu(hf &mut Heightfield, p &ErosionParams, plan &ErosionPlan) ErosionResult {
  imm t0 = time.Instant.now();
  imm sp = *p;
  imm n = hf.data.len();
  mut water = zeros(n);
  mut fl = zeros(n * 4usize);
  mut vel = zeros(n * 2usize);
  mut tl = zeros(n);
  mut sed = zeros(n);
  mut sed2 = zeros(n);
  mut other = zeros(n);
  mut i = 0u32;
  mut thermalDone = 0u32;
  while i < plan.hydraulic {
    // five dispatches
    mut z = 0u32;
    while z < sp.h {
      mut x = 0u32;
      while x < sp.w { flux(inv(x, z), sp, hf.data.view(), water.view(), fl.viewMut()); x = x + 1u32; }
      z = z + 1u32;
    }
    z = 0u32;
    while z < sp.h {
      mut x = 0u32;
      while x < sp.w { waterStep(inv(x, z), sp, fl.view(), water.viewMut(), vel.viewMut()); x = x + 1u32; }
      z = z + 1u32;
    }
    z = 0u32;
    while z < sp.h {
      mut x = 0u32;
      while x < sp.w { tilt(inv(x, z), sp, hf.data.view(), tl.viewMut()); x = x + 1u32; }
      z = z + 1u32;
    }
    z = 0u32;
    while z < sp.h {
      mut x = 0u32;
      while x < sp.w { erode(inv(x, z), sp, hf.data.viewMut(), water.view(), vel.view(), tl.view(), sed.viewMut()); x = x + 1u32; }
      z = z + 1u32;
    }
    z = 0u32;
    while z < sp.h {
      mut x = 0u32;
      while x < sp.w { advect(inv(x, z), sp, vel.view(), sed.view(), sed2.viewMut()); x = x + 1u32; }
      z = z + 1u32;
    }
    sed <=> sed2;
    i = i + 1u32;
    if plan.thermalEvery > 0u32 and i % plan.thermalEvery == 0u32 and thermalDone < plan.thermal {
      thermalCpu(hf, &sp, &mut other);
      thermalDone = thermalDone + 1u32;
    }
  }
  while thermalDone < plan.thermal {
    thermalCpu(hf, &sp, &mut other);
    thermalDone = thermalDone + 1u32;
  }
  new ErosionResult(true, sed, water, t0.elapsed().secondsF64());
}

// One talus iteration on the CPU: heights in 'hf', 'other' as the second buffer
fn thermalCpu(hf &mut Heightfield, sp &ErosionParams, other &mut List[f32]) {
  mut z = 0u32;
  while z < sp.h {
    mut x = 0u32;
    while x < sp.w { thermal(inv(x, z), *sp, hf.data.view(), other.viewMut()); x = x + 1u32; }
    z = z + 1u32;
  }
  hf.data <=> *other;
}

// ---- GPU ----

fn wordsOfFloats(v &Array[f32]) List[u32] {
  mut w = List[u32].withCapacity(v.len);
  mut i = 0usize;
  while i < v.len {
    w.push(v[i] as u32);
    i = i + 1usize;
  }
  w;
}

fn floatsOfWords(w &List[u32], n usize) List[f32] {
  mut l = List[f32].withCapacity(n);
  mut i = 0usize;
  while i < n {
    l.push(*w[i] as f32);
    i = i + 1usize;
  }
  l;
}

// Erode 'hf' on the GPU, the whole plan in one job. False if the GPU or the kernels were not there
// or a dispatch failed; 'hf' is then unchanged.
pub fn erodeGpu(device &mut gpu.Device, hf &mut Heightfield, p &ErosionParams, plan &ErosionPlan) ErosionResult {
  imm t0 = time.Instant.now();
  imm spirv = gpuwork.readSpirv("terraingen.spv");
  imm none = new ErosionResult(false, List[f32].empty(), List[f32].empty(), 0.);
  if spirv.len() < 6usize { return none; }
  imm R = gpuwork.READ;
  imm W = gpuwork.READ_WRITE;
  mut kFlux = gpuwork.Kernel.make(device, spirv.view(), "flux", &[R, R, R, W]);
  mut kWater = gpuwork.Kernel.make(device, spirv.view(), "waterStep", &[R, R, W, W]);
  mut kTilt = gpuwork.Kernel.make(device, spirv.view(), "tilt", &[R, R, W]);
  mut kErode = gpuwork.Kernel.make(device, spirv.view(), "erode", &[R, W, R, R, R, W]);
  mut kAdvect = gpuwork.Kernel.make(device, spirv.view(), "advect", &[R, R, R, W]);
  mut kThermal = gpuwork.Kernel.make(device, spirv.view(), "thermal", &[R, R, W]);
  if !(kFlux.isValid() and kWater.isValid() and kTilt.isValid() and kErode.isValid() and kAdvect.isValid()
      and kThermal.isValid()) { return none; }

  imm sp = *p;
  imm n = hf.data.len();
  mut job = gpuwork.Job.make(device);
  imm sParams = job.give(gpuwork.uploadValue(device, &sp));
  mut terrainA = job.give(gpuwork.upload(device, wordsOfFloats(hf.data.view()).view()));
  mut terrainB = job.give(gpuwork.zeroed(device, n));
  imm sWater = job.give(gpuwork.zeroed(device, n));
  imm sFlux = job.give(gpuwork.zeroed(device, n * 4usize));
  imm sVel = job.give(gpuwork.zeroed(device, n * 2usize));
  imm sTilt = job.give(gpuwork.zeroed(device, n));
  mut sedA = job.give(gpuwork.zeroed(device, n));
  mut sedB = job.give(gpuwork.zeroed(device, n));
  imm gx = (sp.w + 7u32) / 8u32;
  imm gz = (sp.h + 7u32) / 8u32;
  mut okAll = true;
  mut i = 0u32;
  mut thermalDone = 0u32;
  while i < plan.hydraulic {
    okAll = job.dispatch(device, &kFlux, &[sParams, terrainA, sWater, sFlux], gx, gz) and okAll;
    okAll = job.dispatch(device, &kWater, &[sParams, sFlux, sWater, sVel], gx, gz) and okAll;
    okAll = job.dispatch(device, &kTilt, &[sParams, terrainA, sTilt], gx, gz) and okAll;
    okAll = job.dispatch(device, &kErode, &[sParams, terrainA, sWater, sVel, sTilt, sedA], gx, gz) and okAll;
    okAll = job.dispatch(device, &kAdvect, &[sParams, sVel, sedA, sedB], gx, gz) and okAll;
    imm t = sedA; sedA = sedB; sedB = t;
    i = i + 1u32;
    if plan.thermalEvery > 0u32 and i % plan.thermalEvery == 0u32 and thermalDone < plan.thermal {
      okAll = job.dispatch(device, &kThermal, &[sParams, terrainA, terrainB], gx, gz) and okAll;
      imm t2 = terrainA; terrainA = terrainB; terrainB = t2;
      thermalDone = thermalDone + 1u32;
    }
  }
  while thermalDone < plan.thermal {
    okAll = job.dispatch(device, &kThermal, &[sParams, terrainA, terrainB], gx, gz) and okAll;
    imm t2 = terrainA; terrainA = terrainB; terrainB = t2;
    thermalDone = thermalDone + 1u32;
  }
  if !okAll { return none; }
  imm rT = job.readback(device, terrainA);
  imm rS = job.readback(device, sedA);
  imm rW = job.readback(device, sWater);
  mut works = gpuwork.Works.make();
  imm ticket = works.submit(device, job, gpuwork.Target.Here(0u64));
  mut answers = List[gpuwork.Completion].empty();
  works.waitFor(device, ticket, &mut answers);
  if answers.len() != 1usize or !answers[0usize].ok { return none; }
  imm t = answers[0usize].words(rT);
  imm s = answers[0usize].words(rS);
  imm w = answers[0usize].words(rW);
  hf.data = floatsOfWords(&t, n);
  new ErosionResult(true, floatsOfWords(&s, n), floatsOfWords(&w, n), t0.elapsed().secondsF64());
}
