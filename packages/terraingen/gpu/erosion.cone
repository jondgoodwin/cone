// erosion: hydraulic and thermal erosion as GPU kernels, each the CPU's function too.
// A module of terraingen's gpu/ folder.
//
// HYDRAULIC: the virtual pipe model of Mei, Decaudin and Hu, "Fast Hydraulic Erosion Simulation and
// Visualization on GPU" (Pacific Graphics 2007), after O'Brien and Hodgins' pipe water. Each cell holds
// terrain height b, water depth d, suspended sediment s and the flux (m^3/s) through four virtual
// pipes to its neighbours (-x, +x, -z, +z). One iteration is five dispatches, each reading only what
// the dispatch does not write (so the order invocations run in cannot matter, and the CPU twin, a
// loop, gives the GPU's answer):
//   flux     the pipes accelerate with the surface height difference to each neighbour, and are scaled
//            so a cell never gives more water than it has;
//   water    rain falls, the net inflow changes the depth, a fraction evaporates, and the velocity
//            comes from the flux through the cell;
//   tilt     the terrain's slope sin(alpha) from its gradient;
//   erode    the transport capacity C = Kc * sin(alpha) * |v| (limited as the water deepens): where the
//            sediment is under C the ground dissolves at Ks (C - s), where over it deposits at Kd (s - C);
//   advect   the sediment is carried along the velocity (semi-Lagrangian, Stam's "stable fluids").
// What is dissolved leaves the terrain and joins the sediment, exactly, and deposit is the reverse, so
// terrain plus sediment is conserved by 'erode' to rounding; advection loses a little to interpolation.
//
// THERMAL: talus erosion (Musgrave, Kolb and Mace, "The Synthesis and Rendering of Eroded Fractal
// Terrains", SIGGRAPH 1989) in the gathering form of Jako and Toth, "Fast Hydraulic and Thermal Erosion
// on the GPU" (2011): a cell above a neighbour by more than the talus slope sends part of the excess
// to every such neighbour, in proportion to the drop. Each cell computes what it gives and what each
// neighbour would give it, from the old heights, so the dispatch writes only its own cell and the sum
// of heights is conserved.
//
// Cells are row by row (index z * w + x). Every parameter is a 32-bit number.

mod erosion;

import libc;

pub struct ErosionParams {
  pub w: u32;
  pub h: u32;
  pub cell: f32;             // metres between samples
  pub dt: f32;               // seconds an iteration
  pub gravity: f32;          // pipe acceleration (9.81)
  pub rain: f32;             // metres of water depth a second, everywhere
  pub evaporation: f32;      // fraction of the water lost a second
  pub capacity: f32;         // Kc: sediment capacity per unit sin(alpha) |v|, metres
  pub dissolve: f32;         // Ks: fraction of the shortfall dissolved an iteration
  pub deposit: f32;          // Kd: fraction of the excess deposited an iteration
  pub maxDepth: f32;         // water deeper than this carries no erosion (it shields the bed)
  pub minTilt: f32;          // the smallest sin(alpha) used, so a flat bed still erodes a little
  pub edgeDrain: u32;        // 1: water leaves over the grid's edge; 0: it stays in
  pub talus: f32;            // the slope (rise over run) that thermal erosion holds the ground to
  pub thermalRate: f32;      // fraction of the excess moved an iteration (at most 0.5)
  pub hardness: f32;         // scales how easily the bed dissolves (1 normal; more is harder rock)
  pub maxSpeed: f32;         // the water speed used for capacity is capped at this (m/s): a shallow film
                            // on a steep cell would otherwise carry an unbounded speed and dig a pit
  pub maxStep: f32;          // the most a cell dissolves in one iteration (metres)

  // Defaults that move a visible amount of earth in a few hundred iterations on a 10 m grid of mountains
  pub fn standard(w: u32, h: u32, cell: f32) ErosionParams {
    ErosionParams(w, h, cell, 0.05, 9.81, 0.012, 0.03, 0.35, 0.3, 0.2, 2.5, 0.04, 1u32, 0.55, 0.35, 1., 3., 0.08)
  }
}

fn at(x: i32, z: i32, w: u32, h: u32) usize {
  var a = x;
  var b = z;
  if a < 0 { a = 0; }
  if b < 0 { b = 0; }
  if a > i32.from(w) - 1 { a = i32.from(w) - 1; }
  if b > i32.from(h) - 1 { b = i32.from(h) - 1; }
  usize.from(b) * usize.from(w) + usize.from(a)
}

fn fmin(a: f32, b: f32) f32 { if a < b { a } else { b } }
fn fmax(a: f32, b: f32) f32 { if a > b { a } else { b } }

// ---------------- hydraulic ----------------

// Flux through the four pipes of each cell: 4 words a cell (to -x, +x, -z, +z). Bindings: 0 params,
// 1 terrain, 2 water, 3 flux (read and written, the cell's own four words only).
pub fn @compute(8, 8) flux(inv: Invocation, p: ErosionParams, terrain: &Array[f32], water: &Array[f32],
    fl: &mut Array[f32]) {
  let x = i32.from(inv.globalId[0usize]);
  let z = i32.from(inv.globalId[1usize]);
  if x >= i32.from(p.w) || z >= i32.from(p.h) { return; }
  let c = at(x, z, p.w, p.h);
  let here = terrain[c] + water[c];
  var out: Array[f32, 4] = [0., 0., 0., 0.];
  var k = 0usize;
  while k < 4usize {
    var nx = x;
    var nz = z;
    if k == 0usize { nx = x - 1; } else if k == 1usize { nx = x + 1; } else if k == 2usize { nz = z - 1; } else { nz = z + 1; }
    var dh: f32 = 0.;
    let outside = nx < 0 || nz < 0 || nx >= i32.from(p.w) || nz >= i32.from(p.h);
    if outside {
      // the grid's edge: water leaves if the edge drains, as if the cell beyond were a metre lower and dry
      if p.edgeDrain != 0u32 { dh = water[c] + 1.; }
    } else {
      let n = at(nx, nz, p.w, p.h);
      dh = here - (terrain[n] + water[n]);
    }
    // the pipe accelerates with the head difference (cross-section = cell^2, length = cell: g dh cell)
    var f = fl[c * 4usize + k] + p.dt * p.gravity * dh * p.cell;
    if f < 0. { f = 0.; }
    out[k] = f;
    k = k + 1usize;
  }
  let total = out[0usize] + out[1usize] + out[2usize] + out[3usize];
  var scale: f32 = 1.;
  if total > 0. {
    let room = water[c] * p.cell * p.cell / (total * p.dt);
    if room < 1. { scale = room; }
  }
  k = 0usize;
  while k < 4usize {
    fl[c * 4usize + k] = out[k] * scale;
    k = k + 1usize;
  }
}

// Water depth and velocity from the flux. Bindings: 0 params, 1 flux, 2 water (read and written, own
// cell), 3 velocity (2 words a cell, written).
pub fn @compute(8, 8) waterStep(inv: Invocation, p: ErosionParams, fl: &Array[f32], water: &mut Array[f32],
    vel: &mut Array[f32]) {
  let x = i32.from(inv.globalId[0usize]);
  let z = i32.from(inv.globalId[1usize]);
  if x >= i32.from(p.w) || z >= i32.from(p.h) { return; }
  let c = at(x, z, p.w, p.h);
  // what each neighbour sends here: the left one its +x pipe, the right one its -x pipe, ...
  var inL: f32 = 0.;
  var inR: f32 = 0.;
  var inT: f32 = 0.;
  var inB: f32 = 0.;
  if x > 0 { inL = fl[at(x - 1, z, p.w, p.h) * 4usize + 1usize]; }
  if x + 1 < i32.from(p.w) { inR = fl[at(x + 1, z, p.w, p.h) * 4usize + 0usize]; }
  if z > 0 { inT = fl[at(x, z - 1, p.w, p.h) * 4usize + 3usize]; }
  if z + 1 < i32.from(p.h) { inB = fl[at(x, z + 1, p.w, p.h) * 4usize + 2usize]; }
  let outL = fl[c * 4usize + 0usize];
  let outR = fl[c * 4usize + 1usize];
  let outT = fl[c * 4usize + 2usize];
  let outB = fl[c * 4usize + 3usize];
  let net = (inL + inR + inT + inB) - (outL + outR + outT + outB);
  let d1 = water[c];
  var d2 = d1 + p.dt * (net / (p.cell * p.cell) + p.rain);
  if d2 < 0. { d2 = 0.; }
  // the flow through the cell along x and z, then divided by the mean depth and the width
  let wx = (inL - outL + outR - inR) * 0.5;
  let wz = (inT - outT + outB - inB) * 0.5;
  let dm = (d1 + d2) * 0.5;
  var vx: f32 = 0.;
  var vz: f32 = 0.;
  if dm > 0.0005 {
    vx = wx / (dm * p.cell);
    vz = wz / (dm * p.cell);
  }
  vel[c * 2usize] = vx;
  vel[c * 2usize + 1usize] = vz;
  water[c] = d2 * (1. - fmin(p.evaporation * p.dt, 1.));
}

// sin(alpha) of the terrain at each cell, from central differences. Bindings: 0 params, 1 terrain,
// 2 tilt (written).
pub fn @compute(8, 8) tilt(inv: Invocation, p: ErosionParams, terrain: &Array[f32], out: &mut Array[f32]) {
  let x = i32.from(inv.globalId[0usize]);
  let z = i32.from(inv.globalId[1usize]);
  if x >= i32.from(p.w) || z >= i32.from(p.h) { return; }
  let gx = (terrain[at(x + 1, z, p.w, p.h)] - terrain[at(x - 1, z, p.w, p.h)]) / (2. * p.cell);
  let gz = (terrain[at(x, z + 1, p.w, p.h)] - terrain[at(x, z - 1, p.w, p.h)]) / (2. * p.cell);
  let g2 = gx * gx + gz * gz;
  out[at(x, z, p.w, p.h)] = (g2 / (1. + g2)).sqrt();
}

// Erosion and deposition. Bindings: 0 params, 1 terrain (read and written), 2 water, 3 velocity,
// 4 tilt, 5 sediment (read and written); each cell touches only its own.
pub fn @compute(8, 8) erode(inv: Invocation, p: ErosionParams, terrain: &mut Array[f32], water: &Array[f32],
    vel: &Array[f32], tl: &Array[f32], sed: &mut Array[f32]) {
  let x = i32.from(inv.globalId[0usize]);
  let z = i32.from(inv.globalId[1usize]);
  if x >= i32.from(p.w) || z >= i32.from(p.h) { return; }
  let c = at(x, z, p.w, p.h);
  var speed = (vel[c * 2usize] * vel[c * 2usize] + vel[c * 2usize + 1usize] * vel[c * 2usize + 1usize]).sqrt();
  if speed > p.maxSpeed { speed = p.maxSpeed; }
  var depthFactor = 1. - water[c] / p.maxDepth;
  if depthFactor < 0. { depthFactor = 0.; }
  let capacity = p.capacity * fmax(tl[c], p.minTilt) * speed * depthFactor;
  let s = sed[c];
  if capacity > s {
    var amount = p.dissolve / p.hardness * (capacity - s);
    // never cut more than makes a pit in one iteration
    if amount > p.maxStep { amount = p.maxStep; }
    terrain[c] = terrain[c] - amount;
    sed[c] = s + amount;
  } else {
    let amount = p.deposit * (s - capacity);
    terrain[c] = terrain[c] + amount;
    sed[c] = s - amount;
  }
}

// The sediment carried along: each cell takes what was upstream (semi-Lagrangian, bilinear). Bindings:
// 0 params, 1 velocity, 2 sediment in, 3 sediment out.
pub fn @compute(8, 8) advect(inv: Invocation, p: ErosionParams, vel: &Array[f32], sedIn: &Array[f32],
    sedOut: &mut Array[f32]) {
  let x = i32.from(inv.globalId[0usize]);
  let z = i32.from(inv.globalId[1usize]);
  if x >= i32.from(p.w) || z >= i32.from(p.h) { return; }
  let c = at(x, z, p.w, p.h);
  let bx = f32.from(x) - vel[c * 2usize] * p.dt / p.cell;
  let bz = f32.from(z) - vel[c * 2usize + 1usize] * p.dt / p.cell;
  let fx = libc.floorf(bx);
  let fz = libc.floorf(bz);
  let tx = bx - fx;
  let tz = bz - fz;
  let ix = i32.from(fx);
  let iz = i32.from(fz);
  let a = sedIn[at(ix, iz, p.w, p.h)];
  let b = sedIn[at(ix + 1, iz, p.w, p.h)];
  let cc = sedIn[at(ix, iz + 1, p.w, p.h)];
  let d = sedIn[at(ix + 1, iz + 1, p.w, p.h)];
  let top = a + (b - a) * tx;
  let bottom = cc + (d - cc) * tx;
  sedOut[c] = top + (bottom - top) * tz;
}

// ---------------- thermal ----------------

// What cell (x, z) sends to its lower neighbours: half of the largest excess over the talus, scaled
// by the rate (the 0.5 is Jako and Toth's, so a pair never swaps heights past each other).
// Returns the total given and the sum of the drops over the talus that it is shared by.
fn givingOf(terrain: &Array[f32], x: i32, z: i32, p: ErosionParams) Array[f32, 2] {
  let hc = terrain[at(x, z, p.w, p.h)];
  var maxExcess: f32 = 0.;
  var sumExcess: f32 = 0.;
  var dz = -1;
  while dz <= 1 {
    var dx = -1;
    while dx <= 1 {
      if (dx != 0 || dz != 0) && x + dx >= 0 && z + dz >= 0 && x + dx < i32.from(p.w) && z + dz < i32.from(p.h) {
        let run = if dx != 0 && dz != 0 { p.cell * 1.41421356 } else { p.cell };
        let drop = hc - terrain[at(x + dx, z + dz, p.w, p.h)] - p.talus * run;
        if drop > 0. {
          sumExcess = sumExcess + drop;
          if drop > maxExcess { maxExcess = drop; }
        }
      }
      dx = dx + 1;
    }
    dz = dz + 1;
  }
  [maxExcess * 0.5 * p.thermalRate, sumExcess]
}

// Talus erosion: heights in, heights out (written to another buffer, so the dispatch reads old
// heights everywhere). Bindings: 0 params, 1 terrain in, 2 terrain out.
pub fn @compute(8, 8) thermal(inv: Invocation, p: ErosionParams, terrain: &Array[f32], out: &mut Array[f32]) {
  let x = i32.from(inv.globalId[0usize]);
  let z = i32.from(inv.globalId[1usize]);
  if x >= i32.from(p.w) || z >= i32.from(p.h) { return; }
  let c = at(x, z, p.w, p.h);
  let mine = givingOf(terrain, x, z, p);
  var h = terrain[c] - mine[0usize];
  // plus what each higher neighbour sends here: its giving, in the share this cell's drop is of its sum
  var dz = -1;
  while dz <= 1 {
    var dx = -1;
    while dx <= 1 {
      if (dx != 0 || dz != 0) && x + dx >= 0 && z + dz >= 0 && x + dx < i32.from(p.w) && z + dz < i32.from(p.h) {
        let run = if dx != 0 && dz != 0 { p.cell * 1.41421356 } else { p.cell };
        let drop = terrain[at(x + dx, z + dz, p.w, p.h)] - terrain[c] - p.talus * run;
        if drop > 0. {
          let theirs = givingOf(terrain, x + dx, z + dz, p);
          if theirs[1usize] > 0. { h = h + theirs[0usize] * drop / theirs[1usize]; }
        }
      }
      dx = dx + 1;
    }
    dz = dz + 1;
  }
  out[c] = h;
}
