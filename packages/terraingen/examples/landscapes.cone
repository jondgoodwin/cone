// landscapes: three landscapes made from parameters alone (alpine, desert mesa, rolling hills), each
// generated, eroded on the GPU, cut by rivers, classified into biomes, and drawn headless.
//
//   congo run --release packages/terraingen/examples/landscapes.cone -- --out PREFIX [--res 384]
//   GPU_POWER_PREFERENCE=low-power congo run --release ... (the Intel)
//
// It prints, for each landscape: the time to generate the heights on the CPU and on the GPU, the time
// to erode on each, how far the two erosions differ, the largest drainage area, the river and lake
// cells, the biome shares; and the GPU time of drawing it. With --out it writes PREFIX-<name>-view.bmp
// (the 3-D view: the terrain meshed with its baked colour map, the water meshed over it) and
// PREFIX-<name>-map.bmp (a map from above: the biome colours with the sun's shading).
//
// The terrain mesh here is only what the demo needs to be seen: one mesh of the whole grid. A terrain
// renderer (the terrainlod package) consumes 'Landscape.heightAt' and 'cutTile' instead.

mod landscapes;

import stdio use *;
import libc;
import time;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import path as filepath;
import terraingen use *;

fn cstrEquals(a: *u8, b: &str) bool {
  var i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8
}

fn cstrToString(s: *u8) String {
  var r = String.empty();
  var i = 0usize;
  while *(s + i) != 0u8 { r.appendByte(*(s + i)); i = i + 1usize; }
  r
}

fn argNumber(s: *u8) usize {
  var v = 0usize;
  var i = 0usize;
  while *(s + i) != 0u8 { v = v * 10usize + usize.from(*(s + i) - 48u8); i = i + 1usize; }
  v
}

fn srgbByte(linear: f32) u8 {
  var c = linear;
  if c < 0. { c = 0.; }
  if c > 1. { c = 1.; }
  let s = libc.powf(c, 1. / 2.2);
  u8.from(i32.from(s * 255. + 0.5))
}

// The colour map as an Image (rows from the bottom: row iz of the grid)
fn albedoImage(l: &Landscape, biomes: &List[Biome]) Image {
  let rgb = bakeAlbedo(&l.masks, biomes);
  let w = l.height.w;
  let h = l.height.h;
  var img = Image(i32.from(w), i32.from(h), 3, List[u8].withCapacity(w * h * 3usize));
  var i = 0usize;
  while i < w * h {
    img.pixels.push(srgbByte(*rgb[i * 3usize]));
    img.pixels.push(srgbByte(*rgb[i * 3usize + 1usize]));
    img.pixels.push(srgbByte(*rgb[i * 3usize + 2usize]));
    i = i + 1usize;
  }
  img
}

// The whole grid as one mesh: positions, normals, uvs (u east, v south = row), CCW from above
fn terrainMesh(hf: &Heightfield) Mesh {
  var m = Mesh.empty();
  var iz = 0usize;
  while iz < hf.h {
    var ix = 0usize;
    while ix < hf.w {
      let x = hf.originX + f32.from(ix) * hf.cell;
      let z = hf.originZ + f32.from(iz) * hf.cell;
      m.positions.push(Vec3(x, hf.at(ix, iz), z));
      m.normals.push(hf.normalAt(x, z));
      m.uvs.push(Vec2(f32.from(ix) / f32.from(hf.w - 1usize), f32.from(iz) / f32.from(hf.h - 1usize)));
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  iz = 0usize;
  while iz + 1usize < hf.h {
    var ix = 0usize;
    while ix + 1usize < hf.w {
      let a = u32.from(iz * hf.w + ix);
      let b = a + 1u32;
      let c = a + u32.from(hf.w);
      let d = c + 1u32;
      m.indices.push(a); m.indices.push(c); m.indices.push(b);
      m.indices.push(b); m.indices.push(c); m.indices.push(d);
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  m
}

// Water: the quads of the grid with water at three or more corners, flat at the highest surface
// of their corners, so a lake is one level and a river steps down its bed
fn waterMesh(l: &Landscape) Mesh {
  let hf = &l.height;
  var m = Mesh.empty();
  let w = hf.w;
  var iz = 0usize;
  while iz + 1usize < hf.h {
    var ix = 0usize;
    while ix + 1usize < w {
      let i0 = iz * w + ix;
      let ids = [i0, i0 + 1usize, i0 + w, i0 + w + 1usize];
      var wet = 0;
      var sum = 0.f;
      var k = 0usize;
      while k < 4usize {
        if *l.water.waterDepth[ids[k]] > 0.02 {
          wet = wet + 1;
          sum = sum + *l.water.surface[ids[k]];
        }
        k = k + 1usize;
      }
      if wet >= 3 {
        let mean = sum / f32.from(wet);
        let base = u32.from(m.positions.len());
        k = 0usize;
        while k < 4usize {
          let px = hf.originX + f32.from(ix + (k % 2usize)) * hf.cell;
          let pz = hf.originZ + f32.from(iz + (k / 2usize)) * hf.cell;
          // a wet corner at its own surface, a dry one at the mean of the wet
          let py = if *l.water.waterDepth[ids[k]] > 0.02 { *l.water.surface[ids[k]] } else { mean };
          m.positions.push(Vec3(px, py + 0.05, pz));
          m.normals.push(Vec3(0., 1., 0.));
          m.uvs.push(Vec2(0., 0.));
          k = k + 1usize;
        }
        m.indices.push(base); m.indices.push(base + 2u32); m.indices.push(base + 1u32);
        m.indices.push(base + 1u32); m.indices.push(base + 2u32); m.indices.push(base + 3u32);
      }
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  m
}

// A map from above: the colour map shaded by the sun's exposure, water drawn blue
fn mapImage(l: &Landscape, biomes: &List[Biome]) Image {
  let rgb = bakeAlbedo(&l.masks, biomes);
  let w = l.height.w;
  let h = l.height.h;
  var img = Image(i32.from(w), i32.from(h), 3, List[u8].withCapacity(w * h * 3usize));
  var row = h;
  // rows from the bottom of the picture: north (small z) at the top of the picture
  while row > 0usize {
    row = row - 1usize;
    var ix = 0usize;
    while ix < w {
      let i = (h - 1usize - row) * w + ix;
      let lit = 0.35 + 0.85 * *l.masks.exposure[i];
      var r = *rgb[i * 3usize] * lit;
      var g = *rgb[i * 3usize + 1usize] * lit;
      var b = *rgb[i * 3usize + 2usize] * lit;
      if *l.water.waterDepth[i] > 0.02 { r = 0.03; g = 0.1; b = 0.2; }
      img.pixels.push(srgbByte(r * 1.6));
      img.pixels.push(srgbByte(g * 1.6));
      img.pixels.push(srgbByte(b * 1.6));
      ix = ix + 1usize;
    }
  }
  img
}

// How rough the surface is at the grid's own scale: the mean of |h(x-1) + h(x+1) + h(z-1) + h(z+1) - 4 h|
fn roughness(hf: &Heightfield) f32 {
  var s = 0.f;
  var n = 0.f;
  var iz = 1usize;
  while iz + 1usize < hf.h {
    var ix = 1usize;
    while ix + 1usize < hf.w {
      s = s + libc.fabsf(hf.at(ix - 1usize, iz) + hf.at(ix + 1usize, iz) + hf.at(ix, iz - 1usize) + hf.at(ix, iz + 1usize) - 4. * hf.at(ix, iz));
      n = n + 1.;
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  s / n
}

fn countWater(l: &Landscape) Array[usize, 2] {
  var lake = 0usize;
  var river = 0usize;
  var i = 0usize;
  while i < l.height.data.len() {
    if *l.hydrology.lakeDepth[i] > 0. { lake = lake + 1usize; }
    else if *l.water.waterDepth[i] > 0.02 { river = river + 1usize; }
    i = i + 1usize;
  }
  [lake, river]
}

fn main(argc: i32, argv: **u8) i32 {
  var prefix = String.empty();
  var res = 384usize;
  var only = 9usize;          // --only 0|1|2: just alpine, mesa or hills
  var a = 1;
  while a < argc {
    let arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--out") && a + 1 < argc {
      prefix = cstrToString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if cstrEquals(arg, "--res") && a + 1 < argc {
      res = argNumber(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if cstrEquals(arg, "--only") && a + 1 < argc {
      only = argNumber(*(argv + usize.from(a + 1)));
      a = a + 1;
    }
    a = a + 1;
  }
  var instance = Instance.create("terraingen landscapes");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() { print <- "No GPU\n"; return 1i32; }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  var device = adapter.requestDevice();

  let W = 1280u32;
  let H = 720u32;
  let outDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var out = device.createTexture(&outDesc);
  let depthDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, W, H);
  var queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32);
  var resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);
  var timeBuf = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  if !renderer.isValid() || !post.isValid() || !queries.isValid() { print <- "renderer failed\n"; return 1i32; }

  var sky = Sky.dusk(radians(38.), radians(210.));
  sky.sunColor = Color(30., 27., 22., 1.);
  sky.zenith = Color(0.16, 0.32, 0.75, 1.);
  sky.horizon = Color(0.62, 0.74, 0.9, 1.);
  sky.glow = Color(0.5, 0.4, 0.3, 1.);
  sky.ground = Color(0.2, 0.2, 0.2, 1.);
  sky.cloudCover = 0.35;
  renderer.setSky(&mut device, &sky);
  let light = sky.sunLight(Color(3.2, 3.0, 2.6, 1.), Color(0.25, 0.3, 0.4, 1.));
  post.exposure = 0.9;
  post.bloom = 0.02;

  var names = List[String].empty();
  names.push(String.from("alpine"));
  names.push(String.from("mesa"));
  names.push(String.from("hills"));
  var k = 0usize;
  while k < 3usize {
    if only != 9usize && only != k { k = k + 1usize; continue; }
    let cell =if k == 0usize { 4600. / f32.from(res) } else if k == 1usize { 4000. / f32.from(res) } else { 3000. / f32.from(res) };
    let spec = if k == 0usize { alpine(res, res, cell, 7u32) } else if k == 1usize { mesa(res, res, cell, 3u32) } else { hills(res, res, cell, 5u32) };
    print <- "\n== "; printStr(names[k].view()); print <- " "; print <- u64.from(res); print <- " x "; print <- u64.from(res);
    print <- " samples, cell "; print <- cell; print <- " m ==\n";

    // heights: the CPU and the GPU
    let t0 = time.Instant.now();
    let cpuField = generate(&spec.shape, spec.w, spec.h, spec.cell, spec.originX, spec.originZ);
    let cpuGen = t0.elapsed().secondsF64();
    let t1 = time.Instant.now();
    let gpuField = generateGpu(&mut device, &spec);
    let gpuGen = t1.elapsed().secondsF64();
    var maxGen = 0.f;
    var i = 0usize;
    while i < cpuField.data.len() {
      let d = libc.fabsf(*cpuField.data[i] - *gpuField.data[i]);
      if d > maxGen { maxGen = d; }
      i = i + 1usize;
    }
    print <- "heights: CPU "; print <- cpuGen * 1000.0; print <- " ms, GPU (kernel, with upload and readback) ";
    print <- gpuGen * 1000.0; print <- " ms; largest difference "; print <- maxGen; print <- " m\n";

    // erosion: the CPU and the GPU on the same heights
    var a1 = cpuField.tile(0, 0, res, res);
    let r1 = erodeCpu(&mut a1, &spec.erosion, &spec.plan);
    var a2 = cpuField.tile(0, 0, res, res);
    let r2 = erodeGpu(&mut device, &mut a2, &spec.erosion, &spec.plan);
    var meanDiff = 0.;
    var maxDiff = 0.f;
    var moved = 0.;
    i = 0usize;
    while i < a1.data.len() {
      let d = libc.fabsf(*a1.data[i] - *a2.data[i]);
      meanDiff = meanDiff + d;
      if d > maxDiff { maxDiff = d; }
      moved = moved + libc.fabsf(*a1.data[i] - *cpuField.data[i]);
      i = i + 1usize;
    }
    meanDiff = meanDiff / f32.from(a1.data.len());
    print <- "roughness (mean |laplacian| x cell, m): before "; print <- roughness(&cpuField); print <- ", after CPU erosion ";
    print <- roughness(&a1); print <- ", after GPU erosion "; print <- roughness(&a2); print <- "\n";
    print <- "erosion ("; print <- u64.from(spec.plan.hydraulic); print <- " hydraulic + "; print <- u64.from(spec.plan.thermal);
    print <- " thermal): CPU "; print <- r1.seconds * 1000.0; print <- " ms, GPU "; print <- r2.seconds * 1000.0;
    print <- " ms (ok "; print <- i64.from(r2.ok); print <- "); mean height moved by erosion "; print <- moved / f32.from(a1.data.len());
    print <- " m; CPU vs GPU mean difference "; print <- meanDiff; print <- " m, largest "; print <- maxDiff; print <- " m\n";

    // the pipeline's CPU stages, timed one by one on the eroded field
    {
      var g = a2.tile(0, 0, res, res);
      let tA = time.Instant.now();
      let hyA = analyze(&g, 0.0005, spec.lakeMin, spec.lakeMax);
      let msAnalyze = tA.elapsed().secondsF64() * 1000.0;
      let tB = time.Instant.now();
      let rmA = carveRivers(&mut g, &hyA, &spec.rivers);
      let msCarve = tB.elapsed().secondsF64() * 1000.0;
      let tC = time.Instant.now();
      let mkA = computeMasks(&g, &hyA, &rmA, &spec.masks, &spec.biomes);
      let msMasks = tC.elapsed().secondsF64() * 1000.0;
      print <- "stages (CPU): drainage analysis "; print <- msAnalyze; print <- " ms (it runs twice), river carving "; print <- msCarve;
      print <- " ms, masks and biomes "; print <- msMasks; print <- " ms ("; print <- u64.from(mkA.biomeCount); print <- " biomes)\n";
    }

    // the whole landscape through the GPU path
    let l = buildLandscapeOn(&mut device, &spec);
    let wc = countWater(&l);
    print <- "landscape built in "; print <- l.seconds * 1000.0; print <- " ms; heights "; print <- l.height.minHeight();
    print <- " to "; print <- l.height.maxHeight(); print <- " m; largest drainage "; print <- l.hydrology.maxAccum() * cell * cell / 1.0e6;
    print <- " km2; lake cells "; print <- u64.from(wc[0usize]); print <- ", river cells "; print <- u64.from(wc[1usize]); print <- "\n";
    var b = 0usize;
    while b < l.masks.biomeCount {
      var share = 0.;
      i = 0usize;
      while i < l.height.data.len() {
        if usize.from(*l.masks.biome[i]) == b { share = share + 1.; }
        i = i + 1usize;
      }
      print <- "  biome "; printStr(l.masks.biomeNames[b].view()); print <- ": "; print <- 100. * share / f32.from(l.height.data.len()); print <- " %\n";
      b = b + 1usize;
    }

    // drawing
    let albedo = albedoImage(&l, &spec.biomes);
    let tex = renderer.addTexture(&mut device, &albedo);
    var ground = Material.plain(Color(1., 1., 1., 1.));
    ground.texture = tex;
    ground.specular = Color(0., 0., 0., 1.);
    let groundM = renderer.addMaterial(&mut device, &ground);
    var waterMat = Material.plain(Color(0.02, 0.09, 0.14, 1.));
    waterMat.specular = Color(0.8, 0.8, 0.8, 1.);
    waterMat.shininess = 120.;
    let waterM = renderer.addMaterial(&mut device, &waterMat);
    let tm = terrainMesh(&l.height);
    let tHandle = renderer.addMesh(&mut device, &tm);
    let wm = waterMesh(&l);
    var list = DrawList.empty();
    list.add(tHandle, groundM, Mat4.identity());
    if wm.indices.len() > 0usize {
      let wHandle = renderer.addMesh(&mut device, &wm);
      list.add(wHandle, waterM, Mat4.identity());
    }
    let span = f32.from(res - 1usize) * cell;
    let hi = l.height.maxHeight();
    let lo = l.height.minHeight();
    var camera = Camera.make();
    camera.fov = radians(50.);
    camera.near = 5.;
    camera.far = 30000.;
    camera.background = Color(0.4, 0.55, 0.8, 1.);
    camera.lookAt(Vec3(span * 0.5, hi + span * 0.16, span * 1.12), Vec3(span * 0.5, lo + (hi - lo) * 0.3, span * 0.3), Vec3(0., 1., 0.));

    // GPU time of the draw: the mean of 30 frames after 5
    var gpuMs = 0.0;
    var counted = 0u32;
    var f = 0u32;
    while f < 35u32 {
      var encoder = device.createCommandEncoder();
      encoder.writeTimestamp(&queries, 0u32);
      renderer.render(&mut device, &mut encoder, &post.hdr, &depth, &camera, &light, &list);
      encoder.writeTimestamp(&queries, 1u32);
      post.apply(&mut encoder, &out);
      encoder.resolveQuerySet(&queries, 0u32, 2u32, &resolved, 0u64);
      encoder.copyBufferToBuffer(&resolved, 0u64, &timeBuf, 0u64, 16u64);
      device.queue.submit(encoder.finish());
      device.endFrame();
      device.waitIdle();
      if f >= 5u32 {
        let ticks = timeBuf.mappedRange() as *u64;
        gpuMs = gpuMs + f64.from(*(ticks + 1usize) - *ticks) * f64.from(device.timestampPeriod) * 1.0e-6;
        counted = counted + 1u32;
      }
      f = f + 1u32;
    }
    print <- "draw: "; print <- u64.from(tm.triangleCount() + wm.triangleCount()); print <- " triangles, GPU "; print <- gpuMs / f64.from(counted); print <- " ms a frame\n";

    if prefix.len() > 0usize {
      var shot = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
      var encoder = device.createCommandEncoder();
      renderer.render(&mut device, &mut encoder, &post.hdr, &depth, &camera, &light, &list);
      post.apply(&mut encoder, &out);
      encoder.copyTextureToBuffer(&out, &shot);
      device.queue.submit(encoder.finish());
      device.endFrame();
      device.waitIdle();
      let image = Image.fromTexels(shot.mappedRange(), i32.from(W), i32.from(H), false);
      var name = prefix.copy();
      name <- "-"; name <- names[k].view(); name <- "-view.bmp";
      image.save(&filepath.Path.from(name.view()));
      var mapName = prefix.copy();
      mapName <- "-"; mapName <- names[k].view(); mapName <- "-map.bmp";
      let mp = mapImage(&l, &spec.biomes);
      mp.save(&filepath.Path.from(mapName.view()));
      print <- "wrote "; printStr(name.view()); print <- " and "; printStr(mapName.view()); print <- "\n";
    }
    k = k + 1usize;
  }
  print <- "\nVulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  0i32
}
