// The shape recipe (gpu/shape.cone): what its parameters promise, each check against a number worked
// out here or an independent computation.
//
// 1. A one-octave fBm layer is exactly noise's gradient noise: h = base + (0.5 + 0.5 v) scale, v the
//    value of noise.gradient2 at the point times the frequency, seeded as the layer seeds it. (An
//    independent route to the same number.)
// 2. The field is a pure function of the point: the same parameters give the same heights twice, and
//    resolution does not change it: every sample of a coarse grid is a sample of the grid twice as
//    fine.
// 3. Heights stay in [base, base + scale] (and the detail's amplitude beyond).
// 4. The power curve lowers the mean (u^2 below u on [0, 1]) and keeps the extremes.
// 5. Terraces gather heights: with 4 steps and sharp edges most samples lie on a level.
// 6. The island falloff: at and beyond its radius the height is the base; at the centre it is the field's.
// 7. A domain warp moves features: the warped field differs from the unwarped by about the strength.
// 8. A gate hides a layer where the gating layer is low.

mod shapetest;

import testing use *;
import libc;
import geomath use Vec2;
import noise use gradient2, hash1;
import terraingen use *;

fn main() i32 {
  // 1. against gradient2
  var p = ShapeParams.flat();
  p.seed = 5u32;
  p.layers[0usize] = Layer.fbm(0.01, 1, 1., 7u32);
  p.baseHeight = 10.;
  p.heightScale = 200.;
  var worst = 0.f;
  var i = 0;
  while i < 40 {
    let x = f32.from(i) * 13.7 + 3.1;
    let z = f32.from(i) * 7.3 - 20.;
    let v = gradient2(Vec2(x * 0.01, z * 0.01), hash1(0, 5u32 + 7u32 * 2654435761u32)).value;
    let want = 10. + (0.5 + 0.5 * v) * 200.;
    let got = heightAt(p, x, z);
    if libc.fabsf(got - want) > worst { worst = libc.fabsf(got - want); }
    i = i + 1;
  }
  expectFloat(f64.from(worst), 0., 0.0005, "a one-octave fBm layer is noise's gradient noise, to a twentieth of a millimetre");

  // 2. determinism and resolution independence
  var q = ShapeParams.flat();
  q.layers[0usize] = Layer.fbm(0.004, 6, 1., 1u32);
  q.layers[1usize] = Layer.ridged(0.002, 5, 0.8, 2u32);
  q.warpStrength = 120.;
  q.warpFrequency = 0.002;
  q.heightScale = 900.;
  q.contrast = 2.;
  let fine = generate(&q, 65usize, 65usize, 10., 0., 0.);
  let again = generate(&q, 65usize, 65usize, 10., 0., 0.);
  let coarse = generate(&q, 33usize, 33usize, 20., 0., 0.);
  var same = true;
  var shared = true;
  i = 0;
  while i < 65 * 65 {
    if *fine.data[usize.from(i)] != *again.data[usize.from(i)] { same = false; }
    i = i + 1;
  }
  var iz = 0usize;
  while iz < 33usize {
    var ix = 0usize;
    while ix < 33usize {
      if coarse.at(ix, iz) != fine.at(ix * 2usize, iz * 2usize) { shared = false; }
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  expect(same, "the same parameters give the same heights, bit for bit");
  expect(shared, "every sample of the coarse grid is the fine grid's sample at that point");

  // 3. bounds
  expect(fine.minHeight() >= 0. && fine.maxHeight() <= 900., "heights stay within [base, base + scale]");
  expect(fine.maxHeight() - fine.minHeight() > 300., "and the contrast uses a good part of the range");

  // 4. the power curve
  var lin = q;
  lin.warpStrength = 0.;
  var sq = lin;
  sq.power = 2.;
  let a = generate(&lin, 48usize, 48usize, 25., 0., 0.);
  let b = generate(&sq, 48usize, 48usize, 25., 0., 0.);
  var meanA = 0.;
  var meanB = 0.;
  var orderOk = true;
  i = 0;
  while i < 48 * 48 {
    meanA = meanA + *a.data[usize.from(i)];
    meanB = meanB + *b.data[usize.from(i)];
    // u^2 <= u pointwise on [0, 1], with a hair for rounding
    if *b.data[usize.from(i)] > *a.data[usize.from(i)] + 0.01 { orderOk = false; }
    i = i + 1;
  }
  expect(meanB < meanA * 0.85, "the power curve with exponent 2 lowers the mean by at least 15 percent");
  expect(orderOk, "u squared is nowhere above u");

  // 5. terraces
  var t = ShapeParams.flat();
  t.layers[0usize] = Layer.fbm(0.003, 4, 1., 3u32);
  t.heightScale = 400.;
  t.contrast = 3.;
  t.terraces = 4.;
  t.terraceSharp = 16.;
  t.terraceMix = 1.;
  let tf = generate(&t, 80usize, 80usize, 20., 0., 0.);
  var onLevel = 0;
  i = 0;
  while i < 80 * 80 {
    // levels at multiples of 100 m; "on" is within 8 m
    let r = *tf.data[usize.from(i)] / 100.;
    let off = libc.fabsf(r - libc.floorf(r + 0.5)) * 100.;
    if off < 8. { onLevel = onLevel + 1; }
    i = i + 1;
  }
  expect(onLevel > 80 * 80 * 6 / 10, "with sharp terraces over 60 percent of the samples lie on a level");

  // 6. island
  var isl = ShapeParams.flat();
  isl.layers[0usize] = Layer.fbm(0.003, 4, 1., 3u32);
  isl.heightScale = 300.;
  isl.contrast = 2.;
  isl.baseHeight = -20.;
  isl.islandRadius = 600.;
  isl.islandStart = 0.3;
  expectFloat(f64.from(heightAt(isl, 700., 0.)), -20., 0.0001, "beyond the island's radius the height is the base");
  expectFloat(f64.from(heightAt(isl, 0., 610.)), -20., 0.0001, "at its radius too");
  var plain = isl;
  plain.islandRadius = 0.;
  expectFloat(f64.from(heightAt(isl, 0., 0.)), f64.from(heightAt(plain, 0., 0.)), 0.0001, "at the centre it is the field's own");

  // 7. warp
  var w0 = q;
  w0.warpStrength = 0.;
  var w1 = q;
  w1.warpStrength = 300.;
  let f0 = generate(&w0, 40usize, 40usize, 30., 0., 0.);
  let f1 = generate(&w1, 40usize, 40usize, 30., 0., 0.);
  var diff = 0.;
  i = 0;
  while i < 40 * 40 { diff = diff + libc.fabsf(*f0.data[usize.from(i)] - *f1.data[usize.from(i)]); i = i + 1; }
  expect(diff / 1600. > 20., "a warp of 300 m moves the surface by tens of metres on average");

  // 8. gate
  var g = ShapeParams.flat();
  g.layers[0usize] = Layer.fbm(0.002, 3, 1., 1u32);
  var up = Layer.ridged(0.01, 4, 1., 2u32);
  up.gate = 0;
  up.gateLo = -0.15;
  up.gateHi = 0.05;
  g.layers[1usize] = up;
  g.heightScale = 100.;
  var ungated = g;
  ungated.layers[1usize].gate = -1;
  // 'shut': the gate's thresholds set where the gating value never reaches, so the layer adds nothing
  var shut = g;
  shut.layers[1usize].gateLo = 9.;
  shut.layers[1usize].gateHi = 10.;
  var closed = 0;
  var open = 0;
  var between = 0;
  i = 0;
  while i < 300 {
    let x = f32.from(i) * 17.3;
    let z = f32.from(i) * 9.1;
    let hg = heightAt(g, x, z);
    let hu = heightAt(ungated, x, z);
    let hs = heightAt(shut, x, z);
    // where the gate is closed the field is the shut one's exactly; where it is wide open, the ungated one's
    if hg == hs { closed = closed + 1; }
    if hg == hu { open = open + 1; }
    if hg != hs && hg != hu { between = between + 1; }
    i = i + 1;
  }
  expect(closed > 20, "where the gating layer is low the gated layer is closed: the field is the shut one's (more than 20 of 300 points)");
  expect(open > 5, "where the gating layer is high the gate is open: the field is the ungated one's (more than 5 of 300)");
  expect(between > 5, "and between the thresholds the layer is blended in part");
  done()
}
