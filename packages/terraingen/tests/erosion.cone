// The erosion kernels (gpu/erosion.cone), called as their CPU twins, against what physics and
// arithmetic worked out here say.
//
// 1. 'erode' alone: one iteration on a cell with water 0.5 m, speed 2 m/s, sin(alpha) 0.3 and no
//    sediment: the capacity is Kc * 0.3 * 2 * (1 - 0.5 / 2.5) = 0.168 and the bed dissolves by
//    Ks * 0.168 = 0.0504 m exactly, which joins the sediment; a cell holding 0.5 m of sediment (over
//    capacity) deposits Kd * (0.5 - 0.168) = 0.0664 m. Terrain plus sediment is conserved cell by cell.
// 2. 'flux' and 'waterStep' alone (no rain, no evaporation, closed edges): a 3 x 3 block of water
//    2 m deep on flat ground spreads; the total volume is constant to 1e-4, the deepest cell is
//    halved or better after 150 iterations and the surface never goes negative.
// 3. 'thermal' conserves the sum of heights (to 1e-5 of it) and, run long on a spike of slope 3,
//    brings the steepest slope to within 10 percent of the talus 0.5.
// 4. The whole hydraulic plan on a gently tilted plane with a shallow V valley down it: the valley
//    floor is lowered, terrain plus sediment is conserved within 3 percent (advection's loss), and the
//    same run twice is the same bit for bit.
// 5. A field is not roughened by the plan: the mean |laplacian| of a smooth hill is no larger after.

mod erosiontest;

import testing use *;
import collections use *;
import libc;
import terraingen use *;

fn inv(x u32, z u32) Invocation {
  new Invocation([x, z, 0u32], [0u32, 0u32, 0u32], [0u32, 0u32, 0u32], 0u32, [1u32, 1u32, 1u32])
}

fn filled(n usize, v f32) List[f32] {
  var l = List[f32].withCapacity(n);
  l.resize(n, v);
  l
}

fn sum(l &List[f32]) f64 {
  var s = 0.0;
  var i = 0usize;
  while i < l.len() { s = s + f64.from(*l[i]); i = i + 1usize; }
  s
}

fn roughness(hf &Heightfield) f32 {
  var s = 0.f;
  var n = 0.f;
  var iz = 1usize;
  while iz + 1usize < hf.h {
    var ix = 1usize;
    while ix + 1usize < hf.w {
      s = s + libc.fabsf(hf.at(ix - 1usize, iz) + hf.at(ix + 1usize, iz) + hf.at(ix, iz - 1usize) + hf.at(ix, iz + 1usize) - 4. * hf.at(ix, iz));
      n = n + 1.;
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  s / n
}

fn main() i32 {
  // 1. erode, by hand
  var p = ErosionParams.standard(4u32, 4u32, 1.);
  p.capacity = 0.35;
  p.dissolve = 0.3;
  p.deposit = 0.2;
  p.hardness = 1.;
  p.maxDepth = 2.5;
  p.maxSpeed = 10.;
  p.maxStep = 0.08;
  var terrain = filled(16usize, 10.);
  let water = filled(16usize, 0.5);
  var vel = filled(32usize, 0.);
  var k = 0usize;
  while k < 16usize { vel.set(k * 2usize, 2.); k = k + 1usize; }
  let tl = filled(16usize, 0.3);
  var sed = filled(16usize, 0.);
  sed.set(5usize, 0.5);
  let before = sum(&terrain) + sum(&sed);
  var z = 0u32;
  while z < 4u32 {
    var x = 0u32;
    while x < 4u32 { erode(inv(x, z), p, terrain.viewMut(), water.view(), vel.view(), tl.view(), sed.viewMut()); x = x + 1u32; }
    z = z + 1u32;
  }
  expectFloat(f64.from(*terrain[0usize]), 10. - 0.0504, 0.00001, "a clean cell dissolves Ks times the capacity, 0.0504 m");
  expectFloat(f64.from(*sed[0usize]), 0.0504, 0.00001, "which becomes sediment");
  expectFloat(f64.from(*terrain[5usize]), 10. + 0.0664, 0.00001, "a cell over capacity deposits Kd times the excess, 0.0664 m");
  expectFloat(sum(&terrain) + sum(&sed), before, 0.00001, "terrain plus sediment is conserved");

  // 2. water spreads and is conserved
  var pw = ErosionParams.standard(33u32, 33u32, 1.);
  pw.rain = 0.;
  pw.evaporation = 0.;
  pw.edgeDrain = 0u32;
  pw.dt = 0.05;
  let ground = filled(33usize * 33usize, 0.);
  var depth = filled(33usize * 33usize, 0.);
  var dz = 15;
  while dz <= 17 {
    var dx = 15;
    while dx <= 17 { depth.set(usize.from(dz * 33 + dx), 2.); dx = dx + 1; }
    dz = dz + 1;
  }
  var fl = filled(33usize * 33usize * 4usize, 0.);
  var vl = filled(33usize * 33usize * 2usize, 0.);
  let volume0 = sum(&depth);
  var it = 0;
  while it < 150 {
    var zz = 0u32;
    while zz < 33u32 {
      var xx = 0u32;
      while xx < 33u32 { flux(inv(xx, zz), pw, ground.view(), depth.view(), fl.viewMut()); xx = xx + 1u32; }
      zz = zz + 1u32;
    }
    zz = 0u32;
    while zz < 33u32 {
      var xx = 0u32;
      while xx < 33u32 { waterStep(inv(xx, zz), pw, fl.view(), depth.viewMut(), vl.viewMut()); xx = xx + 1u32; }
      zz = zz + 1u32;
    }
    it = it + 1;
  }
  var deepest = 0.f;
  var negative = false;
  k = 0usize;
  while k < depth.len() {
    if *depth[k] > deepest { deepest = *depth[k]; }
    if *depth[k] < 0. { negative = true; }
    k = k + 1usize;
  }
  expectFloat(sum(&depth), volume0, volume0 * 0.0001, "the water's volume is conserved to 1e-4");
  expect(deepest < 1., "the block has spread to under half its depth");
  expect(!negative, "no depth is negative");

  // 3. thermal
  var pt = ErosionParams.standard(41u32, 41u32, 1.);
  pt.talus = 0.5;
  pt.thermalRate = 0.5;
  var hgt = filled(41usize * 41usize, 0.);
  hgt.set(20usize * 41usize + 20usize, 30.);
  hgt.set(20usize * 41usize + 21usize, 12.);
  let total0 = sum(&hgt);
  var spare = filled(41usize * 41usize, 0.);
  it = 0;
  while it < 600 {
    var zz = 0u32;
    while zz < 41u32 {
      var xx = 0u32;
      while xx < 41u32 { thermal(inv(xx, zz), pt, hgt.view(), spare.viewMut()); xx = xx + 1u32; }
      zz = zz + 1u32;
    }
    hgt <=> spare;
    it = it + 1;
  }
  expectFloat(sum(&hgt), total0, total0 * 0.00001, "thermal erosion conserves the sum of heights");
  var steepest = 0.f;
  var iz = 0usize;
  while iz < 41usize {
    var ix = 0usize;
    while ix + 1usize < 41usize {
      let s1 = libc.fabsf(*hgt[iz * 41usize + ix + 1usize] - *hgt[iz * 41usize + ix]);
      if s1 > steepest { steepest = s1; }
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  expect(steepest < 0.5 * 1.1, "after 600 iterations no neighbouring pair is steeper than the talus 0.5 plus 10 percent");

  // 4. the plan on a valley
  var valley = Heightfield.make(48usize, 48usize, 5., 0., 0., 0.);
  iz = 0usize;
  while iz < 48usize {
    var ix = 0usize;
    while ix < 48usize {
      // down toward +z at 0.08, a V across x with its floor at ix = 24, 6 m deep
      let across = libc.fabsf(f32.from(ix) - 24.) * 0.5;
      valley.set(ix, iz, 100. - 0.4 * f32.from(iz) + (if across < 6. { across } else { 6. }));
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  let floor0 = valley.at(24usize, 20usize);
  let start = valley.tile(0, 0, 48usize, 48usize);
  let pv = ErosionParams.standard(48u32, 48u32, 5.);
  let plan = ErosionPlan.make(80u32, 0u32, 0u32);
  var run1 = valley.tile(0, 0, 48usize, 48usize);
  var run2 = valley.tile(0, 0, 48usize, 48usize);
  let r1 = erodeCpu(&mut run1, &pv, &plan);
  let r2 = erodeCpu(&mut run2, &pv, &plan);
  expect(run1.at(24usize, 20usize) < floor0 - 0.02, "the valley floor is cut");
  expectFloat(sum(&run1.data) + sum(&r1.sediment), sum(&start.data), sum(&start.data) * 0.03, "terrain plus sediment is conserved within 3 percent (advection's loss)");
  var identical = true;
  k = 0usize;
  while k < run1.data.len() { if *run1.data[k] != *run2.data[k] { identical = false; } k = k + 1usize; }
  expect(identical, "the same run twice is the same bit for bit");

  // 5. no roughening of a smooth hill
  var hill = Heightfield.make(64usize, 64usize, 8., 0., 0., 0.);
  iz = 0usize;
  while iz < 64usize {
    var ix = 0usize;
    while ix < 64usize {
      let dx = f32.from(ix) - 32.;
      let dz2 = f32.from(iz) - 32.;
      hill.set(ix, iz, 80. * libc.expf(0. - (dx * dx + dz2 * dz2) / 500.));
      ix = ix + 1usize;
    }
    iz = iz + 1usize;
  }
  let rough0 = roughness(&hill);
  let ph = ErosionParams.standard(64u32, 64u32, 8.);
  erodeCpu(&mut hill, &ph, &ErosionPlan.make(60u32, 10u32, 5u32));
  expect(roughness(&hill) <= rough0 * 1.5, "a smooth hill is not roughened more than half again at cell scale");
  done()
}
