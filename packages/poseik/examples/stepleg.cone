// stepleg: a mannequin standing with its left foot on a 0.2 m step, drawn
// offscreen on a real GPU, the pose made by poseik's foot placement.
//
//   congo run packages/poseik/examples/stepleg.cone
//   POSEIK_SHOT=stepleg.bmp congo run packages/poseik/examples/stepleg.cone
//
// The mannequin is the 19-bone humanoid of bonepose, 1.75 m tall, in its
// rest pose (legs straight, arms 15 degrees out). Its left foot (on screen
// right, x < 0) is over a step 0.2 m high, the right on the floor. The
// FootPlacer lifts the left foot onto the step, bending the knee forward to
// do it, and keeps the pelvis (the lowest foot is on the floor, so the
// pelvis does not move). The head then turns to look at a grip target and
// the right hand reaches it, to show the solvers working together.
//
// It is drawn the way render's own tests draw: a Renderer, a DrawList of
// meshes and materials, a camera, one frame read back. A bone is a tube
// from its parent's origin to its own (radius by bone, below), a joint a
// sphere, the head a larger one, a foot a box sized from the Drillis and
// Contini foot (0.152 H long, the heel 0.04 H behind the ankle).
//
// It checks, from the pose and the pixels: both legs reached, the left
// sole on the step (0.2) and the right on the floor (0), the grip socket
// on its target, the look pointing at it, and that the pixel at the left
// ankle is the mannequin's, not the background's. With POSEIK_SHOT set it
// writes the frame as a BMP. It needs a GPU with Vulkan 1.3 and SDL3.dll;
// with the Vulkan SDK, validation is on and must say nothing.
// GPU_POWER_PREFERENCE=low-power picks an integrated GPU.

mod stepleg;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import bonepose use *;
import poseik use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import path use Path;

const W = 640u32;
const H = 480u32;

fn ground(x: f32, z: f32) f32 {
  if x < 0. && x > -0.7 && z > -0.6 && z < 0.6 { return 0.2; }
  0.
}

// A tube of radius 1 and length 1 up +y, open ended
fn tube() Mesh {
  var m = Mesh.empty();
  let sides = 14usize;
  var k = 0usize;
  while k < sides {
    let a = 2. * pi * f32.from(k) / f32.from(sides);
    m.positions.push(Vec3(cos(a), 0., sin(a)));
    m.normals.push(Vec3(cos(a), 0., sin(a)));
    m.positions.push(Vec3(cos(a), 1., sin(a)));
    m.normals.push(Vec3(cos(a), 0., sin(a)));
    k = k + 1usize;
  }
  k = 0usize;
  while k < sides {
    let k1 = (k + 1usize) % sides;
    let v0 = u32.from(2usize * k);
    let v1 = u32.from(2usize * k + 1usize);
    let v2 = u32.from(2usize * k1 + 1usize);
    let v3 = u32.from(2usize * k1);
    m.indices.push(v0);
    m.indices.push(v2);
    m.indices.push(v1);
    m.indices.push(v0);
    m.indices.push(v3);
    m.indices.push(v2);
    k = k + 1usize;
  }
  m
}

fn limb(a: Vec3, b: Vec3, r: f32) Mat4 {
  let d = b - a;
  Mat4.fromTrs(a, Quat.fromVectors(Vec3(0., 1., 0.), d), Vec3(r, d.length(), r))
}

fn ball(p: Vec3, r: f32) Mat4 { Mat4.fromTrs(p, Quat.identity(), Vec3(r, r, r)) }

fn slab(center: Vec3, size: Vec3) Mat4 { Mat4.fromTrs(center, Quat.identity(), size) }

// The radius of the tube that ends at each bone (from its parent's origin)
fn radius(b: usize) f32 {
  if b == SPINE { return 0.090; }
  if b == CHEST { return 0.105; }
  if b == NECK { return 0.040; }
  if b == HEAD { return 0.038; }
  if b == CLAVICLE_L || b == CLAVICLE_R { return 0.035; }
  if b == UPPER_ARM_L || b == UPPER_ARM_R { return 0.045; }
  if b == FOREARM_L || b == FOREARM_R { return 0.040; }
  if b == HAND_L || b == HAND_R { return 0.032; }
  if b == THIGH_L || b == THIGH_R { return 0.060; }
  if b == SHIN_L || b == SHIN_R { return 0.064; }
  0.050
}

fn main() i32 {
  let height = 1.75f;
  let skel = humanoid(height);
  var pose = skel.restPose();
  var models = List[Transform3].empty();
  let world = Transform3.identity();

  // ---- The pose ----
  var placer = FootPlacer.make(height);
  let placed = placer.place(&skel, &mut pose, &mut models, &world, &ground, 1., 0.);
  // The head looks at a point in front of the right hand, then the hand reaches for it
  // (the look turns the spine and chest, which carry the shoulder, so it comes first)
  let grip = Vec3(0.30, 1.30, -0.55);
  let gripRot = Quat.angleAxis(pi / 2., Vec3(1., 0., 0.));
  let look = LookConfig.standard();
  let lookResult = lookAt(&skel, &mut pose, &mut models, grip, 1., &look);
  let reach = reachHand(&skel, &mut pose, &mut models, true, grip, gripRot, elbowPole(true), 1.);

  var ok = true;
  print <- "pelvis shift "; print <- placed.pelvisShift; print <- " m; left sole "; print <- placed.soleL;
  print <- " m, right sole "; print <- placed.soleR; print <- " m\n";
  if !(placed.reachedL && placed.reachedR) { print <- "FAIL: a leg did not reach\n"; ok = false; }
  if absf(placed.soleL - 0.2) > 0.001 || absf(placed.soleR) > 0.001 { print <- "FAIL: soles not on the ground\n"; ok = false; }
  let gripNow = skel.socketModel(&models, SOCKET_HAND_R_GRIP).translation;
  if gripNow.distance(grip) > 0.002 || !reach.reached { print <- "FAIL: the grip is not on its target\n"; ok = false; }
  let eye = skel.socketModel(&models, SOCKET_EYE).translation;
  let gaze = (*models[HEAD]).rotation * Vec3(0., 0., -1.);
  print <- "look yaw "; print <- lookResult.yaw; print <- " rad, clamped "; print <- i64.from(lookResult.clamped); print <- "\n";
  if lookResult.clamped || gaze.dot((grip - eye).normalize()) < 0.99 { print <- "FAIL: the head is not looking at the grip\n"; ok = false; }

  // ---- The GPU ----
  var instance = Instance.create("poseik stepleg");
  if !instance.isValid() { print <- "FAIL: no Vulkan instance\n"; return 1i32; }
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  var device = adapter.requestDevice();
  if !device.isValid() { print <- "FAIL: no device\n"; return 1i32; }

  let target = TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var color = device.createTexture(&target);
  let depthDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var readback = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  if !renderer.isValid() { print <- "FAIL: no renderer\n"; return 1i32; }

  let tubeMesh = renderer.addMesh(&mut device, &tube());
  let ballMesh = renderer.addMesh(&mut device, &Mesh.sphere(1., 14));
  let cubeMesh = renderer.addMesh(&mut device, &Mesh.cube(0.5));
  let skinColor = renderer.addMaterial(&mut device, &Material.plain(Color(0.78, 0.80, 0.86, 1.)));
  let jointColor = renderer.addMaterial(&mut device, &Material.plain(Color(0.35, 0.40, 0.55, 1.)));
  let footColor = renderer.addMaterial(&mut device, &Material.plain(Color(0.20, 0.22, 0.30, 1.)));
  let stepColor = renderer.addMaterial(&mut device, &Material.plain(Color(0.62, 0.45, 0.28, 1.)));
  let floorColor = renderer.addMaterial(&mut device, &Material.plain(Color(0.30, 0.42, 0.30, 1.)));
  let targetColor = renderer.addMaterial(&mut device, &Material.plain(Color(0.95, 0.25, 0.20, 1.)));

  var list = DrawList.empty();
  list.add(cubeMesh, floorColor, slab(Vec3(0., -0.025, 0.), Vec3(4., 0.05, 4.)));
  list.add(cubeMesh, stepColor, slab(Vec3(-0.35, 0.1, 0.), Vec3(0.7, 0.2, 1.2)));
  var b = 1usize;
  while b < skel.boneCount() {
    let p = (*models[usize.from(skel.parentOf(b))]).translation;
    let q = (*models[b]).translation;
    if p.distance(q) > 0.001 { list.add(tubeMesh, skinColor, limb(p, q, radius(b))); }
    list.add(ballMesh, jointColor, ball(q, 0.5 * radius(b) + 0.022));
    b = b + 1usize;
  }
  list.add(ballMesh, skinColor, ball((*models[HEAD]).translation + Vec3(0., 0.066 * height, 0.), 0.095));
  list.add(ballMesh, targetColor, ball(grip, 0.025));
  // The feet: boxes in each foot bone's frame, the heel 0.04 H behind the ankle, the toe 0.112 H ahead
  let footLen = 0.152 * height;
  let sides = [FOOT_L, FOOT_R];
  var s = 0usize;
  while s < 2usize {
    let t = *models[sides[s]];
    let centre = t.translation + t.rotation * Vec3(0., -0.039 * height + 0.02, -0.036 * height);
    list.add(cubeMesh, footColor, Mat4.fromTrs(centre, t.rotation, Vec3(0.09, 0.04, footLen)));
    s = s + 1usize;
  }

  var camera = Camera.make();
  camera.lookAt(Vec3(0.12, 0.6, -3.2), Vec3(0.0, 0.7, 0.), Vec3(0., 1., 0.));
  camera.background = Color(0.55, 0.70, 0.90, 1.);
  let sun = Light.directional(Vec3(0.3, -0.6, 0.8).normalize(), Color.gray(1.8), Color.gray(0.45));
  var encoder = device.createCommandEncoder();
  renderer.render(&mut device, &mut encoder, &color, &depth, &camera, &sun, &list);
  encoder.copyTextureToBuffer(&color, &readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  let p = readback.mappedRange();

  // The pixel at the left ankle is not the background's
  let viewProjection = camera.projectionMatrix(f32.from(W) / f32.from(H)) * camera.viewMatrix();
  let ndc = viewProjection.projectPoint((*models[SHIN_L]).translation);
  let px = usize.from((ndc.x + 1.) * 0.5 * f32.from(W));
  let py = usize.from((1. - ndc.y) * 0.5 * f32.from(H));
  let at = (py * usize.from(W) + px) * 4usize;
  let r = i32.from(*(p + at));
  let bl = i32.from(*(p + at + 2usize));
  print <- "pixel at the left knee: "; print <- r; print <- ", "; print <- i32.from(*(p + at + 1usize)); print <- ", "; print <- bl; print <- "\n";
  if r > 120 && bl > 200 { print <- "FAIL: the knee's pixel is the sky's\n"; ok = false; }

  let shot = libc.getenv("POSEIK_SHOT");
  if (shot as usize) != 0usize {
    let img = Image.fromTexels(p, i32.from(W), i32.from(H), false);
    var name = String.empty();
    var i = 0usize;
    while *(shot + i) != 0u8 { name.appendByte(*(shot + i)); i = i + 1usize; }
    if img.save(&Path.from(name.view())) { print <- "wrote "; printStr(name.view()); print <- "\n"; } else { print <- "FAIL: could not write the screenshot\n"; ok = false; }
  }
  if failures() != 0u32 { print <- "FAIL: a Vulkan call failed\n"; ok = false; }
  if validationMessages() != 0u32 { print <- "FAIL: validation messages\n"; ok = false; }
  if ok { print <- "ok\n"; return 0i32; }
  1i32
}
