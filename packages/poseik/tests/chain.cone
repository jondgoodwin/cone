// FABRIK and CCD on chains: they converge within tolerance, keep the
// segment lengths, respect cone and hinge limits, stretch at an out-of-reach
// target, and drive a skeleton's bones.
//
// The chain: four unit segments standing up the y axis from the origin
// (points (0,0,0) to (0,4,0)). Reachable target (2, 2, 0): distance 2.83 < 4.
// Limits are checked independently of the solver, from the final points: the
// angle between successive segments (acos of the dot of their unit
// directions), and for the hinge the z component of each segment (a hinge about
// +z keeps every segment in the xy plane) and its signed angle about z.

mod chain;

import testing use *;
import collections use List;
import geomath use *;
import bonepose use *;
import poseik use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn pt(l: &List[Vec3], i: usize) Vec3 { *l[i] }

fn column(n: usize, points: &mut List[Vec3], lens: &mut List[f32], limits: &mut List[JointLimit], limit: JointLimit) {
  points.clear();
  lens.clear();
  limits.clear();
  var i = 0usize;
  while i <= n { points.push(new Vec3(0., f32.from(i), 0.)); i = i + 1usize; }
  i = 0usize;
  while i < n { lens.push(1.); limits.push(limit); i = i + 1usize; }
}

// The direction of segment i
fn seg(points: &List[Vec3], i: usize) Vec3 { (pt(points, i + 1usize) - pt(points, i)).normalize() }

// The largest angle between successive segments (the first against 'up'), radians
fn worstBend(points: &List[Vec3], n: usize) f32 {
  var worst: f32 = 0.;
  var ref = new Vec3(0., 1., 0.);
  var i = 0usize;
  while i < n {
    let d = seg(points, i);
    let a = acos(clampf(d.dot(ref), -1., 1.));
    if a > worst { worst = a; }
    ref = d;
    i = i + 1usize;
  }
  worst
}

fn lengthsKept(points: &List[Vec3], n: usize) f32 {
  var worst: f32 = 0.;
  var i = 0usize;
  while i < n {
    let e = absf((pt(points, i + 1usize) - pt(points, i)).length() - 1.);
    if e > worst { worst = e; }
    i = i + 1usize;
  }
  worst
}

fn testFree() {
  var points = List[Vec3].empty();
  var lens = List[f32].empty();
  var limits = List[JointLimit].empty();
  column(4usize, &mut points, &mut lens, &mut limits, JointLimit.free());
  let up = new Vec3(0., 1., 0.);
  let target = new Vec3(2., 2., 0.);
  let r = solveFabrik(&mut points, &lens, &limits, up, target, 0.001, 50u32);
  expectBool(r.error <= 0.001, true, "FABRIK: converged within 1 mm");
  expectBool(r.iterations < 20u32, true, "in fewer than 20 iterations");
  near(pt(&points, 4usize).x, 2., 0.001, "end x on the target");
  near(pt(&points, 4usize).y, 2., 0.001, "end y");
  near(pt(&points, 0usize).length(), 0., 0.00001, "base fixed");
  near(lengthsKept(&points, 4usize), 0., 0.0001, "segment lengths kept");

  column(4usize, &mut points, &mut lens, &mut limits, JointLimit.free());
  let c = solveCcd(&mut points, &lens, &limits, up, target, 0.001, 200u32);
  expectBool(c.error <= 0.001, true, "CCD: converged within 1 mm");
  near(pt(&points, 4usize).x, 2., 0.001, "CCD end x");
  near(pt(&points, 4usize).y, 2., 0.001, "CCD end y");
  near(lengthsKept(&points, 4usize), 0., 0.0001, "CCD keeps the lengths");
  near(pt(&points, 0usize).length(), 0., 0.00001, "CCD base fixed");

  // Out of reach: straight at the target, total length 4
  column(4usize, &mut points, &mut lens, &mut limits, JointLimit.free());
  let far = solveFabrik(&mut points, &lens, &limits, up, new Vec3(30., 40., 0.), 0.001, 50u32);
  near(pt(&points, 4usize).x, 2.4, 0.0001, "out of reach: stretched along (3,4)/5 to length 4: x");
  near(pt(&points, 4usize).y, 3.2, 0.0001, "y");
  near(far.error, 46., 0.001, "and the error is the shortfall (50 - 4)");
}

fn testCone() {
  var points = List[Vec3].empty();
  var lens = List[f32].empty();
  var limits = List[JointLimit].empty();
  let half = radians(30.);
  column(4usize, &mut points, &mut lens, &mut limits, JointLimit.cone(half));
  let up = new Vec3(0., 1., 0.);
  // Reachable under 30-degree bends by construction: the end of segments at
  // 25, 50, 75 and 100 degrees from vertical (each 25 from the one before):
  // x = sin 25 + sin 50 + sin 75 + sin 100 = 3.139, y = cos 25 + cos 50 + cos 75 + cos 100 = 1.634
  let easy = solveFabrik(&mut points, &lens, &limits, up, new Vec3(3.139, 1.634, 0.), 0.002, 100u32);
  expectBool(easy.error <= 0.002, true, "cone limits: a target they allow is reached");
  expectBool(worstBend(&points, 4usize) <= half + 0.0005, true, "and no joint bends past 30 degrees");
  column(4usize, &mut points, &mut lens, &mut limits, JointLimit.cone(half));
  // (-3, 0.5): beyond what the limits allow
  let hard = solveFabrik(&mut points, &lens, &limits, up, new Vec3(-3., 0.5, 0.), 0.002, 100u32);
  expectBool(hard.error > 0.3, true, "a target the limits forbid is missed by a distance");
  expectBool(worstBend(&points, 4usize) <= half + 0.0005, true, "yet no joint bends past 30 degrees");
  near(lengthsKept(&points, 4usize), 0., 0.0001, "and the lengths are kept");
  column(4usize, &mut points, &mut lens, &mut limits, JointLimit.cone(half));
  let cc = solveCcd(&mut points, &lens, &limits, up, new Vec3(-3., 0.5, 0.), 0.002, 100u32);
  expectBool(cc.error > 0.3, true, "CCD: the forbidden target is missed too");
  expectBool(worstBend(&points, 4usize) <= half + 0.0005, true, "CCD: no joint past 30 degrees");
  // A cone of the base direction as well: the first segment against 'up'
  expectBool(acos(clampf(seg(&points, 0usize).dot(up), -1., 1.)) <= half + 0.0005, true, "the first segment against the base direction too");
}

fn testHinge() {
  var points = List[Vec3].empty();
  var lens = List[f32].empty();
  var limits = List[JointLimit].empty();
  // Hinge about +z, angles from -90 to 0 degrees: a positive turn about z takes
  // y towards -x, so negative angles bend towards +x
  let hinge = JointLimit.hinge(new Vec3(0., 0., 1.), radians(-90.), 0.);
  column(4usize, &mut points, &mut lens, &mut limits, hinge);
  let up = new Vec3(0., 1., 0.);
  let r = solveFabrik(&mut points, &lens, &limits, up, new Vec3(2., 2., 0.), 0.002, 100u32);
  expectBool(r.error <= 0.002, true, "hinge: a target on the allowed side is reached");
  var zmax: f32 = 0.;
  var amin: f32 = 0.;
  var amax: f32 = -10.;
  var ref = up;
  var i = 0usize;
  while i < 4usize {
    let d = seg(&points, i);
    if absf(d.z) > zmax { zmax = absf(d.z); }
    let a = atan2(new Vec3(0., 0., 1.).dot(ref.cross(d)), ref.dot(d));
    if a < amin { amin = a; }
    if a > amax { amax = a; }
    ref = d;
    i = i + 1usize;
  }
  near(zmax, 0., 0.0001, "hinge: every segment stays in the xy plane");
  expectBool(amin >= radians(-90.) - 0.001, true, "hinge: no joint past -90 degrees");
  expectBool(amax <= 0.001, true, "hinge: no joint past 0 degrees");
  column(4usize, &mut points, &mut lens, &mut limits, hinge);
  let wrong = solveFabrik(&mut points, &lens, &limits, up, new Vec3(-2., 2., 0.), 0.002, 100u32);
  expectBool(wrong.error > 0.5, true, "hinge: a target on the other side is missed (the joints cannot bend that way)");
  expectBool(pt(&points, 4usize).x >= -0.001, true, "and the chain stays on the allowed side");
}

fn testBones() {
  let h = 1.75f;
  let s = humanoid(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  s.modelTransforms(&pose, &mut models);
  var points = List[Vec3].empty();
  var lens = List[f32].empty();
  var bones = List[usize].empty();
  chainPoints(&s, &models, UPPER_ARM_R, 3usize, &mut points, &mut lens, &mut bones);
  expectInt(i64.from(points.len()), 3, "an arm chain has three points");
  near(*lens[0], 0.188 * h, 0.0001, "upper arm length");
  near(*lens[1], 0.145 * h, 0.0001, "forearm length");
  let shoulder = pt(&points, 0usize);
  // The target: reachable, in front of the chest
  let target = shoulder + new Vec3(-0.05, -0.1, -0.35);
  var limits = List[JointLimit].empty();
  limits.push(JointLimit.free());
  limits.push(JointLimit.free());
  let r = solveFabrik(&mut points, &lens, &limits, new Vec3(0., -1., 0.), target, 0.0005, 100u32);
  applyChain(&s, &mut pose, &mut models, &bones, &points);
  expectBool(r.error <= 0.0005, true, "the arm chain converged");
  let wrist = (*models[HAND_R]).translation;
  near(wrist.x, target.x, 0.001, "FABRIK on bones: the wrist reaches the target x");
  near(wrist.y, target.y, 0.001, "y");
  near(wrist.z, target.z, 0.001, "z");
  var again = List[Transform3].empty();
  s.modelTransforms(&pose, &mut again);
  near((*again[HAND_R]).translation.z, target.z, 0.001, "and a fresh forward pass over the pose agrees");

  // CCD on the same
  var pose2 = s.restPose();
  s.modelTransforms(&pose2, &mut models);
  chainPoints(&s, &models, UPPER_ARM_R, 3usize, &mut points, &mut lens, &mut bones);
  let r2 = solveCcd(&mut points, &lens, &limits, new Vec3(0., -1., 0.), target, 0.0005, 100u32);
  applyChain(&s, &mut pose2, &mut models, &bones, &points);
  let wrist2 = (*models[HAND_R]).translation;
  near(wrist2.x, target.x, 0.001, "CCD on bones: the wrist reaches the target x");
  near(wrist2.y, target.y, 0.001, "y");
  near(wrist2.z, target.z, 0.001, "z");
}

fn main() i32 {
  testFree();
  testCone();
  testHinge();
  testBones();
  done()
}
