// Foot placement on a 1.75 m humanoid at rest (legs exactly straight: the
// hip is 0.530 H up, the ankle 0.039 H, and the leg 0.491 H = 0.85925 m long).
//
// Cases, each worked out here:
// 1. Both feet on a plateau 0.2 m high, the animation's flat level 0: each
//    foot's offset is +0.2, the pelvis rises 0.2 (to 0.9275 + 0.2 = 1.1275),
//    the soles are at 0.2 and the straight legs are still reached.
// 2. A step 0.2 high for x < 0 (the left foot, at x = -0.1670, stands on it),
//    the root on the lower ground (y = 0): offsets +0.2 and 0, the lowest is
//    0, so the pelvis stays; the left sole is at 0.2 and its knee bends
//    forward; the right sole is at 0 and its leg is still straight.
// 3. The same step, the root standing on the upper level (y = 0.2, x = 0, the
//    right foot over the edge on the ground at 0): offsets 0 and -0.2, the
//    pelvis is lowered by exactly 0.2 (the pelvis is at 0.9275 world), the
//    right foot is on the ground (0) with its leg straight (hip to ankle is
//    0.9275 - 0.0683 = 0.8592), the left sole on the step (0.2).
// 4. The body turned 90 degrees (facing -x, its left at world +z) with the
//    step at z > 0: the same as 2.
// 5. A ramp rising towards +z at 0.3 m per metre: the normal is
//    (0, 1, -0.3) / 1.0440, the feet are tilted so their up is that (a 16.7
//    degree tilt, inside the 35 degree limit), the soles on the ramp.
// 6. A step edge under the toes only (ground 0.2 for z < -0.1, the foot's
//    toe is at 0.74 * 0.266 = 0.197 ahead of the sole, its heel 0.069
//    behind): flat normal there is false (the central difference at the
//    sole sees the edge 0.08 either side only if the sole is within it; here
//    it is 0.1 away, so the normal is flat), the sole is raised so the toe is
//    not under the ground: the sole rests at 0.2 on the lip.
// 7. Smoothing: the pelvis eases to its offset 0.2 as 1 - exp(-15 t): after
//    one frame of 1/60 s, 0.2 (1 - e^-0.25) = 0.04424; after two seconds 0.2.
// 8. Weight 0.5: half the correction (soles 0.1, pelvis +0.1); weight 0: none.

mod foot;

import testing use *;
import collections use List;
import geomath use *;
import bonepose use *;
import poseik use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn plateau(x: f32, z: f32) f32 { 0.2 }
fn stepLeft(x: f32, z: f32) f32 { if x < 0. { return 0.2; } 0. }
fn stepForward(x: f32, z: f32) f32 { if z > 0. { return 0.2; } 0. }
fn ramp(x: f32, z: f32) f32 { 0.3 * z }
fn lipAhead(x: f32, z: f32) f32 { if z < -0.1 { return 0.2; } 0. }
fn flat(x: f32, z: f32) f32 { 0. }

fn here(y: f32, yaw: f32) Transform3 {
  new Transform3(new Vec3(0., y, 0.), Quat.angleAxis(yaw, new Vec3(0., 1., 0.)), new Vec3(1., 1., 1.))
}

fn soleOf(s: &Skeleton, models: &List[Transform3], w: &Transform3, socket: usize) Vec3 {
  w.transformPoint(s.socketModel(models, socket).translation)
}

fn testPlateau() {
  let s = humanoid(1.75);
  var fp = FootPlacer.make(1.75);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  let w = here(0., 0.);
  let r = fp.place(&s, &mut pose, &mut models, &w, &plateau, 1., 0.);
  near(r.pelvisShift, 0.2, 0.0001, "plateau: the pelvis rises 0.2");
  near((*models[PELVIS]).translation.y, 1.1275, 0.0001, "to 0.9275 + 0.2");
  near(soleOf(&s, &models, &w, SOCKET_SOLE_L).y, 0.2, 0.0001, "left sole at 0.2");
  near(soleOf(&s, &models, &w, SOCKET_SOLE_R).y, 0.2, 0.0001, "right sole at 0.2");
  expectBool(r.reachedL && r.reachedR, true, "both legs reach");
}

fn testStep() {
  let h = 1.75f;
  let s = humanoid(h);
  var fp = FootPlacer.make(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  let w = here(0., 0.);
  let r = fp.place(&s, &mut pose, &mut models, &w, &stepLeft, 1., 0.);
  near(r.pelvisShift, 0., 0.0001, "step: the lowest offset is 0, so the pelvis stays");
  near((*models[PELVIS]).translation.y, 0.9275, 0.0001, "pelvis at 0.9275");
  let sl = soleOf(&s, &models, &w, SOCKET_SOLE_L);
  let sr = soleOf(&s, &models, &w, SOCKET_SOLE_R);
  near(sl.y, 0.2, 0.0001, "left sole on the step at 0.2");
  near(sr.y, 0., 0.0001, "right sole on the ground");
  near(sl.x, -0.16712, 0.0002, "and where it was, in x");
  let hip = (*models[THIGH_L]).translation;
  let knee = (*models[SHIN_L]).translation;
  let ankle = (*models[FOOT_L]).translation;
  expectBool(knee.z < (hip.z + ankle.z) / 2. - 0.05, true, "the raised leg's knee bends forward");
  near((knee - hip).length(), 0.245 * h, 0.0001, "thigh length kept");
  near((ankle - knee).length(), 0.246 * h, 0.0001, "shin length kept");
  expectBool((ankle - hip).length() < 0.8, true, "the raised leg is shortened");
  near(r.normalL.y, 1., 0.0001, "level normal on the step");
  // The foot is flat: its up is world up
  let up = (*models[FOOT_L]).rotation * new Vec3(0., 1., 0.);
  near(up.y, 1., 0.0001, "left foot level");
  expectBool(r.reachedL && r.reachedR, true, "both reach");
}

fn testUpperLevel() {
  let h = 1.75f;
  let s = humanoid(h);
  var fp = FootPlacer.make(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  let w = here(0.2, 0.);
  let r = fp.place(&s, &mut pose, &mut models, &w, &stepLeft, 1., 0.);
  near(r.pelvisShift, -0.2, 0.0001, "upper level: the pelvis is lowered by exactly 0.2");
  near(w.transformPoint((*models[PELVIS]).translation).y, 0.9275, 0.0001, "to 0.9275 in the world");
  near(soleOf(&s, &models, &w, SOCKET_SOLE_L).y, 0.2, 0.0001, "left sole on the step");
  near(soleOf(&s, &models, &w, SOCKET_SOLE_R).y, 0., 0.0001, "right sole on the lower ground");
  expectBool(r.reachedR, true, "and the right leg, straight, just reaches");
  let hip = w.transformPoint((*models[THIGH_R]).translation);
  let ankle = w.transformPoint((*models[FOOT_R]).translation);
  near((ankle - hip).length(), 0.491 * h, 0.0003, "right leg straight (0.859 m)");
}

fn testYaw() {
  let h = 1.75f;
  let s = humanoid(h);
  var fp = FootPlacer.make(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  let w = here(0., pi / 2.);
  let r = fp.place(&s, &mut pose, &mut models, &w, &stepForward, 1., 0.);
  let sl = soleOf(&s, &models, &w, SOCKET_SOLE_L);
  near(sl.z, 0.16712, 0.0002, "turned: the left foot is at world +z");
  near(sl.y, 0.2, 0.0001, "and on the step there");
  near(soleOf(&s, &models, &w, SOCKET_SOLE_R).y, 0., 0.0001, "the right foot on the ground");
  near(r.pelvisShift, 0., 0.0001, "pelvis stays");
}

fn testRamp() {
  let h = 1.75f;
  let s = humanoid(h);
  var fp = FootPlacer.make(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  let w = here(0., 0.);
  // A slight crouch, as a walk's pelvis has (97 per cent of full reach): the
  // legs at rest are exactly straight, and tilting a foot moves its ankle
  // 3 mm further than a straight leg reaches
  pose.setTranslation(PELVIS, new Vec3(0., 0.9275 - 0.03, 0.));
  let r = fp.place(&s, &mut pose, &mut models, &w, &ramp, 1., 0.);
  near(r.normalL.y, 1. / 1.0440307, 0.0005, "ramp normal y");
  near(r.normalL.z, -0.3 / 1.0440307, 0.0005, "ramp normal z");
  let up = (*models[FOOT_L]).rotation * new Vec3(0., 1., 0.);
  near(up.y, r.normalL.y, 0.001, "the left foot's up is the ramp normal: y");
  near(up.z, r.normalL.z, 0.001, "z");
  near(soleOf(&s, &models, &w, SOCKET_SOLE_L).y, 0., 0.0005, "the sole at the ground height under it (0 at z = 0)");
  near(r.pelvisShift, 0., 0.0001, "no pelvis move on a ramp the feet straddle evenly");
  // The sole point is the ramp's: with the foot's heel (behind the sole) higher
  // by 0.3 * 0.069 = 0.0207 on the ramp, the tilted sole's heel is exactly there
  let heel = (*models[FOOT_L]).rotation * new Vec3(0., 0., 0.26 * 0.152 * h);
  near(heel.y, 0.3 * 0.26 * 0.152 * h, 0.001, "and its heel is on the ramp, 2.07 cm higher");
}

fn testLip() {
  let h = 1.75f;
  let s = humanoid(h);
  var fp = FootPlacer.make(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  let w = here(0., 0.);
  fp.place(&s, &mut pose, &mut models, &w, &lipAhead, 1., 0.);
  // The sole is raised so the toe, 0.197 ahead, is not under the lip's 0.2
  let sl = soleOf(&s, &models, &w, SOCKET_SOLE_L);
  expectBool(sl.y >= 0.2 - 0.001, true, "a lip under the toe: the sole is lifted onto it");
  expectBool(sl.y <= 0.2 + 0.001, true, "and no higher");
}

fn testSmoothing() {
  let h = 1.75f;
  let s = humanoid(h);
  var fp = FootPlacer.make(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  let w = here(0., 0.);
  // First call on flat ground starts it at 0, then the plateau appears
  fp.place(&s, &mut pose, &mut models, &w, &flat, 1., 1. / 60.);
  pose = s.restPose();
  let r1 = fp.place(&s, &mut pose, &mut models, &w, &plateau, 1., 1. / 60.);
  near(r1.pelvisShift, 0.04423985, 0.00005, "after one frame the pelvis has moved 22% of the way");
  var i = 0;
  var r = r1;
  while i < 120 {
    pose = s.restPose();
    r = fp.place(&s, &mut pose, &mut models, &w, &plateau, 1., 1. / 60.);
    i = i + 1;
  }
  near(r.pelvisShift, 0.2, 0.0001, "after two seconds, all of it");
}

fn testWeight() {
  let h = 1.75f;
  let s = humanoid(h);
  var fp = FootPlacer.make(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  let w = here(0., 0.);
  let r = fp.place(&s, &mut pose, &mut models, &w, &plateau, 0.5, 0.);
  near(r.pelvisShift, 0.1, 0.0001, "weight 0.5: the pelvis half way");
  near(soleOf(&s, &models, &w, SOCKET_SOLE_L).y, 0.1, 0.0001, "and the sole");
  var pose0 = s.restPose();
  fp.reset();
  let r0 = fp.place(&s, &mut pose0, &mut models, &w, &plateau, 0., 0.);
  near(r0.pelvisShift, 0., 0.00001, "weight 0: no pelvis move");
  near(soleOf(&s, &models, &w, SOCKET_SOLE_L).y, 0., 0.0001, "no change to the sole");
}

fn main() i32 {
  testPlateau();
  testStep();
  testUpperLevel();
  testYaw();
  testRamp();
  testLip();
  testSmoothing();
  testWeight();
  done()
}
