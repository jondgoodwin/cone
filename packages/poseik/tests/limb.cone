// Two-bone IK: reachable targets are reached exactly; unreachable ones get the
// nearest point the limb can make, held by the interior angle range.
//
// Two unit segments from the origin to (1, 1, 0), pole +z: by the law of
// cosines the middle joint is half way along the line (0.5, 0.5, 0) and
// sqrt(1 - 0.5) = 0.7071 off it towards +z. Full reach is 2 (interior angle
// pi). With the interior angle held to at most 150 degrees the reach is
// sqrt(2 - 2 cos 150) = sqrt(2 + sqrt 3) = 1.93185; held to at least 30
// degrees it is sqrt(2 - 2 cos 30) = sqrt(2 - sqrt 3) = 0.51764.

mod limb;

import testing use *;
import collections use List;
import geomath use *;
import bonepose use *;
import poseik use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

fn testSolve() {
  let o = new Vec3(0., 0., 0.);
  let pole = new Vec3(0., 0., 1.);
  let a = solveLimb(o, new Vec3(1., 1., 0.), 1., 1., pole, 0.1, pi);
  near(a.end.x, 1., 0.00001, "reachable: end x exactly");
  near(a.end.y, 1., 0.00001, "end y");
  near(a.end.z, 0., 0.00001, "end z");
  near(a.mid.x, 0.5, 0.00001, "middle joint x");
  near(a.mid.y, 0.5, 0.00001, "middle joint y");
  near(a.mid.z, 0.70710678, 0.00001, "middle joint z, towards the pole");
  near(a.mid.length(), 1., 0.00001, "first segment 1");
  near((a.end - a.mid).length(), 1., 0.00001, "second segment 1");
  expectBool(a.reached, true, "reached");

  // Out of reach: the nearest point is on the line to the target at full length
  let far = solveLimb(o, new Vec3(3., 4., 0.), 1., 1., pole, 0.1, pi);
  near(far.end.x, 1.2, 0.0001, "unreachable: end at 2 along the line (3,4)/5: x");
  near(far.end.y, 1.6, 0.0001, "y");
  expectBool(far.reached, false, "not reached");

  // The knee that may not open past 150 degrees: reach 1.93185
  let bent = solveLimb(o, new Vec3(0., -5., 0.), 1., 1., new Vec3(0., 0., -1.), 0.5, 2.6179939);
  near(bent.end.y, -1.93185, 0.0001, "interior angle at most 150 degrees: the end stops at 1.93185");
  near(bent.mid.z, -(1. - 0.9659258 * 0.9659258).sqrt(), 0.0001, "and the knee bends towards the pole, 0.2588 off the line");
  near((bent.end - bent.mid).length(), 1., 0.0001, "second segment kept");

  // The fold that may not close past 30 degrees: reach 0.51764
  let folded = solveLimb(o, new Vec3(0., -0.1, 0.), 1., 1., new Vec3(0., 0., -1.), 0.5235988, pi);
  near(folded.end.y, -0.51764, 0.0001, "interior angle at least 30 degrees: the end stops at 0.51764");
  expectBool(folded.reached, false, "a target inside the fold is not reached");

  // Segments of unequal length: a 3-4-5 triangle. Root origin, l1 = 3, l2 = 4, target (5, 0, 0)
  // puts the middle joint at (1.8, 2.4, 0) (3 along, at 53.13 degrees) with the pole +y.
  let tri = solveLimb(o, new Vec3(5., 0., 0.), 3., 4., new Vec3(0., 1., 0.), 0.1, pi);
  near(tri.mid.x, 1.8, 0.0001, "3-4-5: middle joint x");
  near(tri.mid.y, 2.4, 0.0001, "3-4-5: middle joint y");
  near(tri.end.x, 5., 0.0001, "3-4-5: end x");
}

fn testAim() {
  let h = 1.75;
  let s = humanoid(h);
  var pose = s.restPose();
  var models = List[Transform3].empty();
  s.modelTransforms(&pose, &mut models);
  let hip = (*models[THIGH_L]).translation;
  let target = new Vec3(hip.x + 0.1, hip.y - 0.55, hip.z - 0.3);
  let sol = aimLimbRange(&s, &mut pose, &mut models, THIGH_L, target, new Vec3(0., 0., -1.), 0.3, pi);
  let ankle = (*models[FOOT_L]).translation;
  near(ankle.x, target.x, 0.0001, "bones: ankle x on the target");
  near(ankle.y, target.y, 0.0001, "ankle y");
  near(ankle.z, target.z, 0.0001, "ankle z");
  expectBool(sol.reached, true, "reached");
  var again = List[Transform3].empty();
  s.modelTransforms(&pose, &mut again);
  near((*again[FOOT_L]).translation.y, target.y, 0.0001, "a fresh forward pass over the pose agrees");
  let knee = (*models[SHIN_L]).translation;
  expectBool(knee.z < (hip.z + ankle.z) / 2. - 0.05, true, "the knee bends forward (-z)");
  near((knee - hip).length(), 0.245 * h, 0.0001, "thigh length kept");
  near((ankle - knee).length(), 0.246 * h, 0.0001, "shin length kept");
}

fn main() i32 {
  testSolve();
  testAim();
  done();
}
