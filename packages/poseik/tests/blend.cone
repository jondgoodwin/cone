// Pose blends, clips, a 1-D blend space and the state machine, on the
// humanoid skeleton (19 bones), with poses that differ in a few bones.
//
// The poses: REST; B = rest with the pelvis 1 m up (y = 1.9275) and bone 1
// (the spine) turned 90 degrees about x; C = rest with the pelvis 2 m up
// (y = 2.9275) and the spine turned 180 degrees about x.
//
// - Half way between rest and B the spine turns 45 degrees: quaternion
//   (sin 22.5, 0, 0, cos 22.5) = (0.38268, 0, 0, 0.92388), the pelvis at 1.4275.
// - Weights (1, 2, 1) over poses whose pelvis y is 0, 1 and 2 give
//   0 * 0.25 + 1 * 0.5 + 2 * 0.25 = 1; scaled to (10, 20, 10) the same, so
//   weights are normalised.
// - Additive: the difference of B from rest (a 90 degree spine turn and 1 m
//   up) added to a base that has the spine already turned 30 degrees about y
//   and the pelvis at 0.5, at weight 1, gives the spine turned by (90 about
//   x) then... composed on the left: rotation = (90 about x) * (30 about y),
//   the pelvis at 1.5; at weight 0.5, (45 about x) * (30 about y), pelvis 1.0.
// - A clip of duration 2 with keys rest at 0 and B at 1, looped: at 0.5 half
//   way up; at 1 it is B; at 1.5 half way back; at 2.5 the same as 0.5. Not
//   looped, it holds B from 1 on.
// - A blend space at 0, 1.4 and 4 (clips of 2, 1 and 0.7 seconds): at 0.7
//   the weights are (0.5, 0.5, 0) and the cycle lasts 1.5 s; at 2.7 they are
//   (0, 0.5, 0.5) ((2.7 - 1.4) / 2.6) and 0.85 s; outside it holds the ends.
// - The state machine: idle (rest) and walk (B) as one-key clips. Setting
//   'speed' to 1 starts the idle-to-walk transition (condition speed > 0.1,
//   fade 0.2 s) on the next update. At the frame it fires the output is still
//   rest; 0.1 s later it is half way (smoothstep(0.5) = 0.5): pelvis 1.4275;
//   after 0.2 s total, B. Setting speed to 0.05 during the fade starts the
//   walk-to-idle transition from the frozen blend (continuous: no jump).

mod blend;

import testing use *;
import collections use List;
import geomath use *;
import bonepose use *;
import poseik use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn variant(rest: &Pose, lift: f32, spineAngle: f32) Pose {
  var p = rest.copy();
  let t = (*p.locals[0usize]).translation;
  p.setTranslation(0usize, Vec3(t.x, t.y + lift, t.z));
  p.setRotation(1usize, Quat.angleAxis(spineAngle, Vec3(1., 0., 0.)));
  p
}

fn pelvisY(p: &Pose) f32 { (*p.locals[0usize]).translation.y }

fn testBlend() {
  let s = humanoid(1.75);
  let rest = s.restPose();
  let b = variant(&rest, 1., pi / 2.);
  let c = variant(&rest, 2., pi);
  let half = blendPoses(&rest, &b, 0.5);
  near(pelvisY(&half), 1.4275, 0.0001, "half way: pelvis y");
  let q = half.rotation(1usize);
  near(q.x, 0.38268, 0.0001, "half way: spine quaternion x");
  near(q.w, 0.92388, 0.0001, "w");
  let zero = blendPoses(&rest, &b, 0.);
  near(pelvisY(&zero), 0.9275, 0.00001, "weight 0 is the first pose");
  let one = blendPoses(&rest, &b, 1.);
  near(pelvisY(&one), 1.9275, 0.00001, "weight 1 is the second");
  near(one.rotation(1usize).x, b.rotation(1usize).x, 0.00001, "and its rotations");
  // The short way round: a spine turned -270 is the same orientation as +90
  let odd = variant(&rest, 0., -3. * pi / 2.);
  let viaShort = blendPoses(&rest, &odd, 0.5);
  near(viaShort.rotation(1usize).x, 0.38268, 0.0001, "slerp takes the short way: 45 degrees, not 135");

  // Weighted
  var poses = List[Pose].empty();
  poses.push(variant(&rest, -0.9275, 0.));
  poses.push(variant(&rest, 0.0725, pi / 2.));
  poses.push(variant(&rest, 1.0725, pi));
  var weights = List[f32].empty();
  weights.push(1.);
  weights.push(2.);
  weights.push(1.);
  let w1 = blendWeighted(&poses, &weights);
  near(pelvisY(&w1), 1., 0.0001, "weights (1,2,1): pelvis y = 1");
  weights.set(0usize, 10.);
  weights.set(1usize, 20.);
  weights.set(2usize, 10.);
  let w2 = blendWeighted(&poses, &weights);
  near(pelvisY(&w2), 1., 0.0001, "weights scaled by 10: the same");
  near(w2.rotation(1usize).length(), 1., 0.0001, "and the rotation is a unit quaternion");
  // Only one weighs: that pose
  weights.set(0usize, 0.);
  weights.set(2usize, 0.);
  let w3 = blendWeighted(&poses, &weights);
  near(pelvisY(&w3), 1., 0.0001, "one weight alone gives that pose (the middle one, y = 1)");
  // A pose and its antipodal quaternion do not cancel
  var p0 = rest.copy();
  var p1 = rest.copy();
  p0.setRotation(1usize, Quat.angleAxis(0.3, Vec3(1., 0., 0.)));
  let qa = p0.rotation(1usize);
  p1.setRotation(1usize, Quat(-qa.x, -qa.y, -qa.z, -qa.w));
  var two = List[Pose].empty();
  two.push(p0.copy());
  two.push(p1.copy());
  var tw = List[f32].empty();
  tw.push(1.);
  tw.push(1.);
  let same = blendWeighted(&two, &tw);
  near(absf(same.rotation(1usize).dot(qa)), 1., 0.0001, "q and -q blend to the same orientation");

  // Masked
  var mask = List[f32].empty();
  var i = 0usize;
  while i < rest.count() { mask.push(if i == 0usize { 1. } else { 0. }); i = i + 1usize; }
  let m = blendMasked(&rest, &b, 1., &mask);
  near(pelvisY(&m), 1.9275, 0.0001, "mask 1: the pelvis follows");
  near(m.rotation(1usize).x, 0., 0.00001, "mask 0: the spine does not");

  // Additive
  var base = rest.copy();
  base.setTranslation(0usize, Vec3(0., 0.5, 0.));
  base.setRotation(1usize, Quat.angleAxis(pi / 6., Vec3(0., 1., 0.)));
  let add1 = addPose(&base, &rest, &b, 1.);
  near(pelvisY(&add1), 1.5, 0.0001, "additive, weight 1: pelvis 0.5 + 1");
  let want1 = Quat.angleAxis(pi / 2., Vec3(1., 0., 0.)) * Quat.angleAxis(pi / 6., Vec3(0., 1., 0.));
  near(absf(add1.rotation(1usize).dot(want1)), 1., 0.0001, "spine: 90 about x composed on the 30 about y");
  let add2 = addPose(&base, &rest, &b, 0.5);
  near(pelvisY(&add2), 1.0, 0.0001, "additive, weight 0.5: pelvis 1.0");
  let want2 = Quat.angleAxis(pi / 4., Vec3(1., 0., 0.)) * Quat.angleAxis(pi / 6., Vec3(0., 1., 0.));
  near(absf(add2.rotation(1usize).dot(want2)), 1., 0.0001, "spine: 45 about x composed on the 30 about y");
  let add0 = addPose(&base, &rest, &b, 0.);
  near(absf(add0.rotation(1usize).dot(base.rotation(1usize))), 1., 0.0001, "weight 0 leaves the base");
  // A pose added to itself as the reference adds nothing
  let none = addPose(&base, &b, &b, 1.);
  near(pelvisY(&none), 0.5, 0.0001, "an addition equal to its reference adds nothing");
}

fn testClip() {
  let s = humanoid(1.75);
  let rest = s.restPose();
  let b = variant(&rest, 1., pi / 2.);
  var clip = Clip.make(2., true);
  clip.addKey(0., &rest);
  clip.addKey(1., &b);
  near(pelvisY(&clip.sample(0.5)), 1.4275, 0.0001, "clip at 0.5: half way up");
  near(pelvisY(&clip.sample(1.)), 1.9275, 0.0001, "clip at 1: B");
  near(pelvisY(&clip.sample(1.5)), 1.4275, 0.0001, "clip at 1.5: half way back to the first key");
  near(pelvisY(&clip.sample(2.5)), 1.4275, 0.0001, "clip at 2.5: wrapped to 0.5");
  near(pelvisY(&clip.samplePhase(0.25)), 1.4275, 0.0001, "phase 0.25 is 0.5 s");
  var once = Clip.make(2., false);
  once.addKey(0., &rest);
  once.addKey(1., &b);
  near(pelvisY(&once.sample(1.5)), 1.9275, 0.0001, "not looped: holds the last key");
  near(pelvisY(&once.sample(-1.)), 0.9275, 0.0001, "and the first before the start");
}

fn constClip(duration: f32, p: &Pose) Clip {
  var c = Clip.make(duration, true);
  c.addKey(0., p);
  c
}

fn testSpace() {
  let s = humanoid(1.75);
  let rest = s.restPose();
  let b = variant(&rest, 1., pi / 2.);
  let c = variant(&rest, 2., pi);
  var space = BlendSpace1D.empty();
  space.add(0., constClip(2., &rest));
  space.add(1.4, constClip(1., &b));
  space.add(4., constClip(0.7, &c));
  var w = List[f32].empty();
  space.weights(0.7, &mut w);
  near(*w[0usize], 0.5, 0.00001, "speed 0.7: idle weight 0.5");
  near(*w[1usize], 0.5, 0.00001, "walk weight 0.5");
  near(*w[2usize], 0., 0.00001, "run weight 0");
  near(space.duration(0.7), 1.5, 0.0001, "and the cycle lasts 1.5 s");
  near(pelvisY(&space.sample(0.7, 0.3)), 1.4275, 0.0001, "the blended pose: half way from rest to B");
  space.weights(2.7, &mut w);
  near(*w[0usize], 0., 0.00001, "speed 2.7: idle 0");
  near(*w[1usize], 0.5, 0.00001, "walk 0.5");
  near(*w[2usize], 0.5, 0.00001, "run 0.5");
  near(space.duration(2.7), 0.85, 0.0001, "cycle 0.85 s");
  var sum: f32 = 0.;
  var x = -1.f;
  var worst: f32 = 0.;
  while x < 6. {
    space.weights(x, &mut w);
    sum = (*w[0usize]) + (*w[1usize]) + (*w[2usize]);
    if absf(sum - 1.) > worst { worst = absf(sum - 1.); }
    x = x + 0.173;
  }
  near(worst, 0., 0.00001, "the weights sum to 1 everywhere along the axis");
  space.weights(-3., &mut w);
  near(*w[0usize], 1., 0.00001, "below the first position: that clip");
  space.weights(9., &mut w);
  near(*w[2usize], 1., 0.00001, "above the last: that clip");
  near(pelvisY(&space.sample(1.4, 0.)), 1.9275, 0.0001, "exactly at a position: its clip");
}

fn testAnimator() {
  let s = humanoid(1.75);
  let rest = s.restPose();
  let b = variant(&rest, 1., pi / 2.);
  var an = Animator.make(&rest);
  let idleClip = an.addClip(constClip(1., &rest));
  let walkClip = an.addClip(constClip(1., &b));
  let speed = an.addParam(0.);
  let idle = an.addClipState(idleClip, 1.);
  let walk = an.addClipState(walkClip, 1.);
  let up = an.addTransition(i32.from(idle), walk, 0.2, -1.);
  an.addCondition(up, speed, CMP_GREATER, 0.1);
  let down = an.addTransition(i32.from(walk), idle, 0.2, -1.);
  an.addCondition(down, speed, CMP_LESS, 0.1);
  near(pelvisY(&an.update(0.05)), 0.9275, 0.0001, "idle: rest");
  expectBool(an.fading, false, "no fade");
  an.setParam(speed, 1.);
  let p0 = an.update(0.05);
  expectBool(an.fading, true, "speed 1: the transition fired");
  expectInt(i64.from(an.current), 1, "now in the walk state");
  near(pelvisY(&p0), 0.9275, 0.0001, "the frame it fires, still rest");
  let p1 = an.update(0.1);
  near(pelvisY(&p1), 1.4275, 0.0001, "0.1 s into the 0.2 s fade: half way (smoothstep 0.5)");
  // Interrupt: speed drops while fading
  an.setParam(speed, 0.05);
  let before = an.update(0.02);
  expectInt(i64.from(an.current), 0, "walk to idle fired during the fade");
  // fade time was 0.12: smoothstep(0.6) = 0.648
  near(pelvisY(&before), 0.9275 + 0.648, 0.0005, "the new fade starts from the frozen blend: no jump");
  let after = an.update(0.1);
  // 0.1 s into a 0.2 s fade from the frozen 1.5755 to rest 0.9275: half way
  near(pelvisY(&after), (1.5755 + 0.9275) / 2., 0.001, "and fades to rest from there");
  an.update(0.2);
  near(pelvisY(&an.update(0.01)), 0.9275, 0.0001, "settled in idle");
  expectBool(an.fading, false, "fade over");

  // Triggers and exit time: a one-shot clip that returns to idle after half its length
  var an2 = Animator.make(&rest);
  var oneShot = Clip.make(1., false);
  oneShot.addKey(0., &rest);
  oneShot.addKey(1., &b);
  let ci = an2.addClip(constClip(1., &rest));
  let co = an2.addClip(oneShot);
  let jump = an2.addParam(0.);
  let si = an2.addClipState(ci, 1.);
  let so = an2.addClipState(co, 1.);
  let t1 = an2.addTransition(i32.from(si), so, 0., -1.);
  an2.addCondition(t1, jump, CMP_TRIGGER, 0.);
  let t2 = an2.addTransition(i32.from(so), si, 0., 0.5);
  an2.update(0.1);
  an2.setParam(jump, 1.);
  an2.update(0.1);
  expectInt(i64.from(an2.current), 1, "trigger: the one-shot started");
  near(an2.param(jump), 0., 0.00001, "and the trigger was consumed");
  an2.update(0.3);
  expectInt(i64.from(an2.current), 1, "at 0.3 of the clip the exit time (0.5) has not come");
  an2.update(0.25);
  expectInt(i64.from(an2.current), 0, "past 0.5 it returns to idle");
}

fn main() i32 {
  testBlend();
  testClip();
  testSpace();
  testAnimator();
  done()
}
