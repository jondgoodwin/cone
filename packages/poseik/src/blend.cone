// Pose blending: linear, masked, weighted and additive blends of bonepose
// Poses; keyframed Clips; and a one-dimensional blend space.
//
// - LINEAR. Each bone's translation is blended linearly and its rotation by
//   spherical interpolation along the shortest arc (slerp); a weight of 0
//   gives the first pose, 1 the second.
// - MASKED. A per-bone weight scales the blend, so the arms can play one
//   thing and the legs another.
// - WEIGHTED. Several poses with weights, which are normalized to sum to 1
//   (a pose with all-zero weights is the first). Rotations are summed as
//   quaternions flipped into the first one's hemisphere and normalized (the
//   weighted "nlerp" every engine's blend tree uses, whose error is second
//   order for poses that are near each other); translations are summed
//   linearly.
// - ADDITIVE. 'addPose' puts the difference between 'add' and its reference
//   pose 'ref' (a lean, a breath, a flinch, authored as a pose beside the
//   pose it leans from) on top of 'base' at a weight: rotation
//   slerp(identity, add * ref^-1, w) * base, translation base + w (add - ref).
// - CLIP. Poses at times, looped or not, sampled by blending the two
//   neighbours. A looped clip's last key blends back to its first over the
//   remainder of its duration.
// - BLEND SPACE. Clips placed along one parameter (speed: idle at 0, walk at
//   1.4, run at 4). A value between two blends those two with the weights
//   of linear interpolation; beyond the ends it holds the end clip. All the
//   clips are sampled at the same normalised phase (0 to 1 through the
//   cycle), which keeps the legs in step as the weights change: they are
//   authored to start on the same foot. The cycle's duration is the clips'
//   durations blended by the same weights (Unity's blend tree does the
//   same), so a half-way blend takes half way between the two periods.

// The pose 'a' blended towards 'b' by t
pub fn blendPoses(a &Pose, b &Pose, t f32) Pose {
  var out = Pose.empty();
  var i = 0usize;
  while i < a.count() {
    let ta = *a.locals[i];
    let tb = *b.locals[i];
    out.locals.push(new Transform3(ta.translation.lerp(tb.translation, t), ta.rotation.slerp(tb.rotation, t).normalize(),
      ta.scale.lerp(tb.scale, t)));
    i = i + 1usize;
  }
  out;
}

// The same with a weight per bone ('mask', 0 to 1) multiplying t
pub fn blendMasked(a &Pose, b &Pose, t f32, mask &List[f32]) Pose {
  var out = Pose.empty();
  var i = 0usize;
  while i < a.count() {
    let ta = *a.locals[i];
    let tb = *b.locals[i];
    let w = t * (*mask[i]);
    out.locals.push(new Transform3(ta.translation.lerp(tb.translation, w), ta.rotation.slerp(tb.rotation, w).normalize(),
      ta.scale.lerp(tb.scale, w)));
    i = i + 1usize;
  }
  out;
}

// The weighted blend of 'poses' (weights normalised to sum to 1)
pub fn blendWeighted(poses &List[Pose], weights &List[f32]) Pose {
  var total f32 = 0.;
  var k = 0usize;
  while k < poses.len() { total = total + (*weights[k]); k = k + 1usize; }
  if total <= 0.000001 { return poses[0].copy(); }
  let first = poses[0];
  var out = Pose.empty();
  var i = 0usize;
  while i < first.count() {
    var p = new Vec3(0., 0., 0.);
    var q = new Vec4(0., 0., 0., 0.);
    let ref = (*first.locals[i]).rotation;
    k = 0usize;
    while k < poses.len() {
      let w = (*weights[k]) / total;
      let t = *poses[k].locals[i];
      p = p + t.translation * w;
      let s = if t.rotation.dot(ref) < 0. { -w; } else { w; };
      q = q + new Vec4(t.rotation.x, t.rotation.y, t.rotation.z, t.rotation.w) * s;
      k = k + 1usize;
    }
    let n = q.normalize();
    out.locals.push(new Transform3(p, new Quat(n.x, n.y, n.z, n.w), new Vec3(1., 1., 1.)));
    i = i + 1usize;
  }
  out;
}

// 'base' with the difference of 'add' from 'ref' added at 'weight'
pub fn addPose(base &Pose, ref &Pose, add &Pose, weight f32) Pose {
  var out = Pose.empty();
  var i = 0usize;
  while i < base.count() {
    let tb = *base.locals[i];
    let tr = *ref.locals[i];
    let ta = *add.locals[i];
    let delta = ta.rotation * tr.rotation.conjugate();
    let r = Quat.identity().slerp(delta, weight) * tb.rotation;
    out.locals.push(new Transform3(tb.translation + (ta.translation - tr.translation) * weight, r.normalize(), tb.scale));
    i = i + 1usize;
  }
  out;
}

// Keyframes: poses at increasing times, from time 0, over 'duration' seconds
pub struct Clip {
  pub times List[f32];
  pub poses List[Pose];
  pub duration f32;
  pub looped bool;

  pub fn make(duration f32, looped bool) Clip { new Clip(List[f32].empty(), List[Pose].empty(), duration, looped); }

  // A key: 'pose' at 'time' (keys are added in time order, the first at 0)
  pub fn addKey(self &mut, time f32, pose &Pose) {
    times.push(time);
    poses.push(pose.copy());
  }

  // The pose at 'phase' (0 to 1 through the clip; a looped clip wraps, others hold their ends)
  pub fn samplePhase(self &, phase f32) Pose { self.sample(phase * duration); }

  // The pose 't' seconds in
  pub fn sample(self &, t0 f32) Pose {
    var t = t0;
    if looped {
      t = t - libc.floorf(t / duration) * duration;
    } else {
      t = clampf(t, 0., duration);
    }
    let n = times.len();
    if n == 1usize { return poses[0].copy(); }
    // The last key at or before t
    var k = 0usize;
    while k + 1usize < n and (*times[k + 1usize]) <= t { k = k + 1usize; }
    if k + 1usize < n {
      let span = (*times[k + 1usize]) - (*times[k]);
      return blendPoses(poses[k], poses[k + 1usize], (t - (*times[k])) / span);
    }
    if !looped { return poses[k].copy(); }
    // Past the last key: back round to the first
    let span = duration - (*times[k]);
    if span <= 0.000001 { return poses[k].copy(); }
    blendPoses(poses[k], poses[0usize], (t - (*times[k])) / span);
  }
}

// Clips along a parameter
pub struct BlendSpace1D {
  pub positions List[f32];
  pub clips List[Clip];

  pub fn empty() BlendSpace1D { new BlendSpace1D(List[f32].empty(), List[Clip].empty()); }

  // A clip at 'position' (positions are added in increasing order)
  pub fn add(self &mut, position f32, clip Clip) {
    positions.push(position);
    clips.push(clip);
  }

  // The two clips blended at 'x' and the weight of the second (the first
  // gets 1 less); both are the same clip at the ends and beyond
  pub fn bracket(self &, x f32, lo &mut usize, hi &mut usize) f32 {
    let n = positions.len();
    if x <= (*positions[0usize]) { *lo = 0usize; *hi = 0usize; return 0.; }
    if x >= (*positions[n - 1usize]) { *lo = n - 1usize; *hi = n - 1usize; return 0.; }
    var k = 0usize;
    while k + 2usize < n and (*positions[k + 1usize]) <= x { k = k + 1usize; }
    *lo = k;
    *hi = k + 1usize;
    (x - (*positions[k])) / ((*positions[k + 1usize]) - (*positions[k]));
  }

  // The weight of every clip at 'x' into 'out' (they sum to 1)
  pub fn weights(self &, x f32, out &mut List[f32]) {
    out.clear();
    var k = 0usize;
    while k < clips.len() { out.push(0.); k = k + 1usize; }
    var lo = 0usize;
    var hi = 0usize;
    let t = self.bracket(x, &mut lo, &mut hi);
    if lo == hi { out.set(lo, 1.); return; }
    out.set(lo, 1. - t);
    out.set(hi, t);
  }

  // The cycle's duration at 'x': the clips' durations blended by their weights
  pub fn duration(self &, x f32) f32 {
    var lo = 0usize;
    var hi = 0usize;
    let t = self.bracket(x, &mut lo, &mut hi);
    (*clips[lo]).duration * (1. - t) + (*clips[hi]).duration * t;
  }

  // The pose at parameter 'x' and 'phase' through the cycle
  pub fn sample(self &, x f32, phase f32) Pose {
    var lo = 0usize;
    var hi = 0usize;
    let t = self.bracket(x, &mut lo, &mut hi);
    let a = clips[lo].samplePhase(phase);
    if lo == hi { return a; }
    let b = clips[hi].samplePhase(phase);
    blendPoses(&a, &b, t);
  }
}
