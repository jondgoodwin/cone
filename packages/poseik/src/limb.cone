// Two-bone IK with an interior-angle range, and its application to a
// skeleton's bones.
//
// bonepose's solveTwoBone clamps only the smallest interior angle and eases
// a nearly straight limb. This adds the largest (a knee that stops short of
// straight: 'maxInterior' below pi) and applies exactly: a reachable target
// is reached to float precision, an unreachable one gets the nearest point
// on the limb's line of reach. The geometry is the law of cosines: the
// middle joint is 'a' along the root-target line, where
// a = (l1^2 - l2^2 + d^2) / 2.0, and 'h' off it, h^2 = l1^2 - a^2, towards
// the pole (Inigo Quilez, "Simple IK"). The interior angle at the middle
// joint is acos((l1^2 + l2^2 - d^2) / 2 l1 l2), so the end's distance d
// ranges over [reach(minInterior), reach(maxInterior)].

// The reach of a limb of segments l1, l2 whose middle joint is bent to the interior angle 'a'
pub fn reachAt(l1: f32, l2: f32, a: f32) f32 {
  clampf(l1 * l1 + l2 * l2 - 2. * l1 * l2 * cos(a), 0.0000001, 1.0e9).sqrt()
}

// The middle and end of a limb of segments 'l1' and 'l2' hanging from
// 'root', whose end is to reach 'target', the middle joint bending towards
// 'pole'. The distance to the target is held to what the interior angle
// range [minInterior, maxInterior] (radians, 0 to pi) allows, along the
// same line; 'reached' says the target itself was inside it.
pub fn solveLimb(root: Vec3, target: Vec3, l1: f32, l2: f32, pole: Vec3, minInterior: f32, maxInterior: f32) LimbSolution {
  let toTarget = target - root;
  let d0 = toTarget.length();
  var u = new Vec3(0., -1., 0.);
  if d0 > 0.00001 { u = toTarget * (1. / d0); }
  let lo = reachAt(l1, l2, minInterior);
  let hi = reachAt(l1, l2, maxInterior);
  var d = d0;
  if d > hi { d = hi; }
  if d < lo { d = lo; }
  let a = (l1 * l1 - l2 * l2 + d * d) / (2. * d);
  let h = clampf(l1 * l1 - a * a, 0., 1.0e9).sqrt();
  var p = pole - u * pole.dot(u);
  if p.length() < 0.0001 {
    p = if absf(u.z) < 0.9 { new Vec3(0., 0., -1.) - u * (-u.z) } else { new Vec3(1., 0., 0.) - u * u.x };
  }
  p = p.normalize();
  new LimbSolution(root + u * a + p * h, root + u * d, absf(d0 - d) < 0.0002)
}

// Bone 'top' and the two below it (each the first child of the one before:
// thigh, shin, foot; or upper arm, forearm, hand) turned so the third bone's
// origin reaches 'target' (model space), the middle joint towards 'pole'.
// 'models' must be current for 'top' and every bone before it, and is brought
// up to date from 'top' on. Each bone turns by the smallest rotation from
// where it points now, so a twist already in the pose stays.
pub fn aimLimbRange(skel: &Skeleton, pose: &mut Pose, models: &mut List[Transform3], top: usize, target: Vec3, pole: Vec3,
    minInterior: f32, maxInterior: f32) LimbSolution {
  let midBone = usize.from(skel.childOf(top));
  let endBone = usize.from(skel.childOf(midBone));
  let restMid = skel.restOf(midBone).translation;
  let restEnd = skel.restOf(endBone).translation;
  let root = (*models[top]).translation;
  let sol = solveLimb(root, target, restMid.length(), restEnd.length(), pole, minInterior, maxInterior);
  let topRot = (*models[top]).rotation;
  let newTop = Quat.fromVectors(topRot * restMid.normalize(), sol.mid - root) * topRot;
  skel.setModelRotation(pose, models, top, newTop);
  models.set(top, new Transform3(root, newTop, new Vec3(1., 1., 1.)));
  skel.recompose(pose, models, midBone);
  let midRot = (*models[midBone]).rotation;
  let newMid = Quat.fromVectors(midRot * restEnd.normalize(), sol.end - sol.mid) * midRot;
  skel.setModelRotation(pose, models, midBone, newMid);
  skel.recompose(pose, models, midBone);
  sol
}
