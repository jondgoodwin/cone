// A small animation state machine: states that play a clip or a blend
// space, transitions between them with conditions on named parameters, and
// timed cross-fades.
//
// - PARAMETERS are floats the game sets by number ('speed', 'grounded' as 0
//   or 1, a 'jump' trigger).
// - A STATE plays a Clip, or a BlendSpace1D driven by one parameter, at a
//   speed multiplier. Its time is a phase, 0 to 1 through the cycle,
//   advanced by dt * speed / duration (a blend space's duration is its
//   weighted one), so a state's length follows its blend.
// - A TRANSITION leaves one state (or any, from = -1) for another when all
//   its conditions hold and, if it has an exit time, the state has played
//   that far (0 to 1). The first transition in the list that fires wins, so
//   the list is a priority order. It cross-fades over 'duration' seconds with
//   a smoothstep weight: the old state keeps playing during the fade. A
//   trigger condition is consumed (the parameter set back to 0) when its
//   transition fires.
// - A transition that fires during a fade freezes the pose being shown as
//   the new fade's source (the way Unity's interruption does) instead of
//   keeping three motions alive.
// This is the design of Unity's Mecanim and Unreal's state machines cut
// to what a character needs; there is no layering beyond 'blendMasked' and
// 'addPose', which the caller can apply to the output.

pub const MOTION_CLIP = 0u32;
pub const MOTION_SPACE = 1u32;

pub const CMP_GREATER = 0u32;
pub const CMP_LESS = 1u32;
pub const CMP_TRUE = 2u32;      // the parameter is above 0.5
pub const CMP_FALSE = 3u32;     // at or below 0.5
pub const CMP_TRIGGER = 4u32;   // above 0.5, and set back to 0 when the transition fires

pub struct AnimState {
  pub kind u32;        // MOTION_CLIP or MOTION_SPACE
  pub index usize;     // which clip or blend space
  pub param usize;     // a blend space's driving parameter
  pub speed f32;
}

pub struct Condition {
  pub param usize;
  pub cmp u32;
  pub value f32;
}

pub struct Transition {
  pub from i32;               // a state, or -1 for any
  pub to usize;
  pub conditions List[Condition];
  pub duration f32;           // the cross-fade, seconds
  pub exitTime f32;           // the phase the source must have reached, or -1 for none
}

pub struct Animator {
  pub clips List[Clip];
  pub spaces List[BlendSpace1D];
  pub states List[AnimState];
  pub transitions List[Transition];
  pub params List[f32];
  pub current usize;
  pub phase f32;
  pub fading bool;
  pub fadeTime f32;
  pub fadeDuration f32;
  pub fromState i32;          // the state fading out, or -1 for the frozen pose
  pub fromPhase f32;
  pub frozen Pose;
  pub rest Pose;

  // An animator whose frozen/blank pose is 'rest'
  pub fn make(rest &Pose) Animator {
    new Animator(List[Clip].empty(), List[BlendSpace1D].empty(), List[AnimState].empty(), List[Transition].empty(),
      List[f32].empty(), 0usize, 0., false, 0., 0., -1i32, 0., rest.copy(), rest.copy())
  }

  pub fn addClip(self &mut, c Clip) usize { clips.push(c); clips.len() - 1usize }
  pub fn addSpace(self &mut, s BlendSpace1D) usize { spaces.push(s); spaces.len() - 1usize }
  pub fn addParam(self &mut, initial f32) usize { params.push(initial); params.len() - 1usize }
  pub fn setParam(self &mut, p usize, v f32) { params.set(p, v); }
  pub fn param(self &, p usize) f32 { *params[p] }

  // A state playing clip 'index'
  pub fn addClipState(self &mut, index usize, speed f32) usize {
    states.push(new AnimState(MOTION_CLIP, index, 0usize, speed));
    states.len() - 1usize
  }

  // A state playing blend space 'index', driven by parameter 'param'
  pub fn addSpaceState(self &mut, index usize, param usize, speed f32) usize {
    states.push(new AnimState(MOTION_SPACE, index, param, speed));
    states.len() - 1usize
  }

  // A transition; add its conditions with 'addCondition' on the number returned
  pub fn addTransition(self &mut, from i32, to usize, duration f32, exitTime f32) usize {
    transitions.push(new Transition(from, to, List[Condition].empty(), duration, exitTime));
    transitions.len() - 1usize
  }

  pub fn addCondition(self &mut, transition usize, param usize, cmp u32, value f32) {
    let t = &mut transitions[transition];
    t.conditions.push(new Condition(param, cmp, value));
  }

  fn stateDuration(self &, s usize) f32 {
    let st = *states[s];
    if st.kind == MOTION_CLIP { return (*clips[st.index]).duration; }
    spaces[st.index].duration(*params[st.param])
  }

  fn evaluate(self &, s usize, phase f32) Pose {
    let st = *states[s];
    if st.kind == MOTION_CLIP { return clips[st.index].samplePhase(phase); }
    spaces[st.index].sample(*params[st.param], phase)
  }

  fn advance(self &, s usize, phase f32, dt f32) f32 {
    let st = *states[s];
    let d = self.stateDuration(s);
    var p = phase + dt * st.speed / d;
    let looped = if st.kind == MOTION_CLIP { (*clips[st.index]).looped } else { (*spaces[st.index].clips[0usize]).looped };
    if looped { p = p - libc.floorf(p); } else if p > 1. { p = 1.; }
    p
  }

  fn holds(self &, c &Condition) bool {
    let v = *params[c.param];
    if c.cmp == CMP_GREATER { return v > c.value; }
    if c.cmp == CMP_LESS { return v < c.value; }
    if c.cmp == CMP_TRUE || c.cmp == CMP_TRIGGER { return v > 0.5; }
    v <= 0.5
  }

  // The pose being shown now: the state, or the fade from the old one to it
  pub fn output(self &) Pose {
    let now = self.evaluate(current, phase);
    if !fading { return now; }
    let u = smoothstep(0., 1., fadeTime / fadeDuration);
    if fromState < 0i32 { return blendPoses(&frozen, &now, u); }
    let old = self.evaluate(usize.from(fromState), fromPhase);
    blendPoses(&old, &now, u)
  }

  // Advance 'dt' seconds: clocks, then transitions; the pose to show is returned
  pub fn update(self &mut, dt f32) Pose {
    phase = self.advance(current, phase, dt);
    if fading {
      fadeTime = fadeTime + dt;
      if fromState >= 0i32 { fromPhase = self.advance(usize.from(fromState), fromPhase, dt); }
      if fadeTime >= fadeDuration { fading = false; }
    }
    var i = 0usize;
    while i < transitions.len() {
      let t = transitions[i];
      let applies = t.from < 0i32 || usize.from(t.from) == current;
      if applies && !(t.from < 0i32 && t.to == current) && (t.exitTime < 0. || phase >= t.exitTime) {
        var ok = true;
        var k = 0usize;
        while k < t.conditions.len() {
          if !self.holds(t.conditions[k]) { ok = false; }
          k = k + 1usize;
        }
        if ok {
          k = 0usize;
          while k < t.conditions.len() {
            let c = *t.conditions[k];
            if c.cmp == CMP_TRIGGER { params.set(c.param, 0.); }
            k = k + 1usize;
          }
          if fading {
            frozen = self.output();
            fromState = -1i32;
          } else {
            fromState = i32.from(current);
            fromPhase = phase;
          }
          current = t.to;
          phase = 0.;
          fading = t.duration > 0.;
          fadeTime = 0.;
          fadeDuration = t.duration;
          break;
        }
      }
      i = i + 1usize;
    }
    self.output()
  }
}
