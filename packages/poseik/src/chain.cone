// Chains of any length: FABRIK and CCD over joint positions, per-joint
// constraints, and the step from solved positions back to bone rotations.
//
// A chain is the origins of bones b0, b1, ... bn, each the first child of
// the one before (a spine, a tail, an arm with a clavicle, a tentacle). The
// segment i runs from point i to point i+1 and has the fixed length of the
// rest offset of bone b(i+1). The last bone is the end effector: its origin
// is what reaches the target, and its own rotation is left to the caller.
//
// CONSTRAINTS. 'limits[i]' constrains segment i's direction against a
// reference: the direction of segment i-1, or 'baseDir' for segment 0 (the
// direction the parent bone points, which the caller supplies, since it is
// not part of the chain).
// - JOINT_FREE: no constraint.
// - JOINT_CONE: the angle between the segment and the reference is at most
//   'half' (a ball joint's swing limit).
// - JOINT_HINGE: the segment turns about the model-space unit 'axis' only,
//   its angle from the reference, signed right-handed about the axis, held
//   to [lo, hi] (a knee or an elbow). The axis is fixed in model space for
//   the solve; it is taken from the pose the solve starts in.
// Constraints are applied in both passes of each iteration (the backward
// pass sees each limit from the far end), and the forward pass is last, so a
// finished solve always satisfies them exactly (the target may then be
// missed, which 'error' reports). This is the constraint scheme of the
// FABRIK paper's section on joint limits, in its direction-only form
// (no twist limit). Like every local method, FABRIK with limits can settle
// short of a target that only a zigzag configuration reaches; it reports the
// error rather than hiding it.

pub const JOINT_FREE = 0u32;
pub const JOINT_CONE = 1u32;
pub const JOINT_HINGE = 2u32;

pub struct JointLimit {
  pub kind u32;
  pub axis Vec3;     // hinge: its unit axis, in model space
  pub half f32;      // cone: half-angle, radians
  pub lo f32;        // hinge: smallest angle from the reference, radians
  pub hi f32;        // hinge: largest

  pub fn free() JointLimit { new JointLimit(JOINT_FREE, new Vec3(0., 1., 0.), 0., 0., 0.); }
  pub fn cone(half f32) JointLimit { new JointLimit(JOINT_CONE, new Vec3(0., 1., 0.), half, 0., 0.); }
  pub fn hinge(axis Vec3, lo f32, hi f32) JointLimit { new JointLimit(JOINT_HINGE, axis.normalize(), 0., lo, hi); }
}

// What a solve achieved: the iterations used and the distance from the end to the target
pub struct ChainResult {
  pub iterations u32;
  pub error f32;
}

fn pt(l &List[Vec3], i usize) Vec3 { *l[i]; }

fn perpendicular(v Vec3) Vec3 {
  if absf(v.x) < 0.9 { return new Vec3(1., 0., 0.).cross(v).normalize(); }
  new Vec3(0., 1., 0.).cross(v).normalize();
}

// A limit seen from the other end of the chain: a cone is the same; a hinge's
// range is negated (the turn from the far segment back to the near one)
fn reversed(lim &JointLimit) JointLimit {
  new JointLimit(lim.kind, lim.axis, lim.half, -lim.hi, -lim.lo);
}

// The unit direction 'd' brought inside limit 'lim' about the unit reference 'ref'
pub fn constrainDirection(d Vec3, ref Vec3, lim &JointLimit) Vec3 {
  if lim.kind == JOINT_CONE {
    let c = clampf(d.dot(ref), -1., 1.);
    let ang = acos(c);
    if ang <= lim.half { return d; }
    var axis = ref.cross(d);
    if axis.length() < 0.000001 { axis = perpendicular(ref); } else { axis = axis.normalize(); }
    return (Quat.angleAxis(lim.half, axis) * ref).normalize();
  }
  if lim.kind == JOINT_HINGE {
    let a = lim.axis;
    var dp = d - a * d.dot(a);
    let rp0 = ref - a * ref.dot(a);
    var rp = rp0;
    if rp0.length() < 0.00001 { rp = perpendicular(a); } else { rp = rp0.normalize(); }
    if dp.length() < 0.00001 { dp = rp; } else { dp = dp.normalize(); }
    let ang = atan2(a.dot(rp.cross(dp)), rp.dot(dp));
    let clamped = clampf(ang, lim.lo, lim.hi);
    return (Quat.angleAxis(clamped, a) * rp).normalize();
  }
  d;
}

// The segments' directions brought inside their limits from the base out,
// each segment's length and the base point kept (the points beyond move
// with it)
pub fn enforceLimits(points &mut List[Vec3], lens &List[f32], limits &List[JointLimit], baseDir Vec3) {
  let n = lens.len();
  var ref = baseDir;
  var i = 0usize;
  var dirs = List[Vec3].empty();
  while i < n {
    dirs.push((pt(points, i + 1usize) - pt(points, i)).normalize());
    i = i + 1usize;
  }
  i = 0usize;
  while i < n {
    let d = constrainDirection(pt(&dirs, i), ref, limits[i]);
    points.set(i + 1usize, pt(points, i) + d * (*lens[i]));
    ref = d;
    i = i + 1usize;
  }
}

pub fn chainLength(lens &List[f32]) f32 {
  var s f32 = 0.;
  var i = 0usize;
  while i < lens.len() { s = s + (*lens[i]); i = i + 1usize; }
  s;
}

// FABRIK: Forward And Backward Reaching IK. Each iteration pulls the end to
// the target and drags the chain after it (backward), then fixes the base
// and pushes the chain out from it again (forward), where the limits apply.
// 'points' (the joint positions, base first) is solved in place, the base
// point staying put. A target beyond the chain's reach stretches it straight
// at the target (its limits still applied). Stops when the end is within
// 'tolerance' of the target or after 'maxIterations'.
pub fn solveFabrik(points &mut List[Vec3], lens &List[f32], limits &List[JointLimit], baseDir Vec3, target Vec3,
    tolerance f32, maxIterations u32) ChainResult {
  let n = lens.len();
  let base = pt(points, 0usize);
  var it = 0u32;
  if (target - base).length() >= chainLength(lens) {
    // Out of reach: lay the chain along the line to the target
    let dir = (target - base).normalize();
    var i = 0usize;
    while i < n { points.set(i + 1usize, pt(points, i) + dir * (*lens[i])); i = i + 1usize; }
    enforceLimits(points, lens, limits, baseDir);
    return new ChainResult(0u32, (pt(points, n) - target).length());
  }
  var err = (pt(points, n) - target).length();
  while it < maxIterations and err > tolerance {
    // Backward: the end on the target, each point pulled to its segment's length from the next
    points.set(n, target);
    var i = n;
    while i > 0usize {
      i = i - 1usize;
      var d = (pt(points, i) - pt(points, i + 1usize)).normalize();
      // The joint between segments i and i+1 limits this one against the one
      // just placed, seen from the far end (the paper applies its limits in
      // both passes: forward only, the chain can lock into a fixed point)
      if i + 1usize < n {
        let ref = (pt(points, i + 1usize) - pt(points, i + 2usize)).normalize();
        let back = reversed(limits[i + 1usize]);
        d = constrainDirection(d, ref, &back);
      }
      points.set(i, pt(points, i + 1usize) + d * (*lens[i]));
    }
    // Forward: the base back where it was, the chain pushed out, limits applied
    points.set(0usize, base);
    i = 0usize;
    while i < n {
      let d = (pt(points, i + 1usize) - pt(points, i)).normalize();
      points.set(i + 1usize, pt(points, i) + d * (*lens[i]));
      i = i + 1usize;
    }
    enforceLimits(points, lens, limits, baseDir);
    err = (pt(points, n) - target).length();
    it = it + 1u32;
  }
  new ChainResult(it, err);
}

// CCD: Cyclic Coordinate Descent. Each sweep visits the joints from the one
// before the end back to the base, turning everything beyond the joint about
// it by the smallest rotation that takes the end towards the target (Wang
// and Chen 1991), and re-applies the limits after each joint. It converges
// more slowly than FABRIK and tends to bend the joints near the end first,
// but each step is a pure rotation about a joint, which suits a rig whose
// joints are rotations.
pub fn solveCcd(points &mut List[Vec3], lens &List[f32], limits &List[JointLimit], baseDir Vec3, target Vec3,
    tolerance f32, maxIterations u32) ChainResult {
  let n = lens.len();
  var it = 0u32;
  var err = (pt(points, n) - target).length();
  while it < maxIterations and err > tolerance {
    var i = n;
    while i > 0usize {
      i = i - 1usize;
      let pivot = pt(points, i);
      let toEnd = pt(points, n) - pivot;
      let toTarget = target - pivot;
      if toEnd.length() > 0.000001 and toTarget.length() > 0.000001 {
        let q = Quat.fromVectors(toEnd, toTarget);
        var j = i + 1usize;
        while j <= n {
          points.set(j, pivot + q * (pt(points, j) - pivot));
          j = j + 1usize;
        }
        enforceLimits(points, lens, limits, baseDir);
      }
    }
    err = (pt(points, n) - target).length();
    it = it + 1u32;
  }
  new ChainResult(it, err);
}

// The joint positions of bone 'first' and its first children, 'count' of
// them, in model space; 'lens' gets the segment lengths from the rest
// offsets and 'bones' the bone numbers
pub fn chainPoints(skel &Skeleton, models &List[Transform3], first usize, count usize, points &mut List[Vec3],
    lens &mut List[f32], bones &mut List[usize]) {
  points.clear();
  lens.clear();
  bones.clear();
  var b = first;
  var k = 0usize;
  while k < count {
    bones.push(b);
    points.push((*models[b]).translation);
    if k + 1usize < count {
      let c = usize.from(skel.childOf(b));
      lens.push(skel.restOf(c).translation.length());
      b = c;
    }
    k = k + 1usize;
  }
}

// Bones turned so each points at the next of the solved 'points': the
// smallest rotation from where it points now, so twist stays. 'models' is
// current for the first bone and the bones before it, and is brought up to
// date. The last bone keeps its local rotation.
pub fn applyChain(skel &Skeleton, pose &mut Pose, models &mut List[Transform3], bones &List[usize], points &List[Vec3]) {
  let n = bones.len();
  var k = 0usize;
  while k + 1usize < n {
    let b = *bones[k];
    let child = *bones[k + 1usize];
    let rot = (*models[b]).rotation;
    let restDir = skel.restOf(child).translation.normalize();
    let now = rot * restDir;
    let want = pt(points, k + 1usize) - pt(points, k);
    let newRot = Quat.fromVectors(now, want) * rot;
    skel.setModelRotation(pose, models, b, newRot);
    skel.recompose(pose, models, b);
    k = k + 1usize;
  }
}
