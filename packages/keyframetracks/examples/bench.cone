// bench: what evaluation costs, in microseconds, run with --release.
//
//   congo run --release packages/keyframetracks/examples/bench.cone
//
// Each line is the mean over many evaluations at times spread over the
// track, so the binary search sees different keys. A scalar, Vec3 or
// quaternion eval allocates one short List for its result (and two more for a
// spline's tangents); a Clip's sample allocates its Sample; that is the
// number to watch if a scene animates thousands of properties a frame.

mod bench;

import stdio use *;
import collections use *;
import geomath use *;
import time use Instant;
import keyframetracks use *;

fn us(t Instant, n i32) f64 { t.elapsed().secondsF64() * 1000000. / f64.from(n); }

fn main() i32 {
  var lin = Track.make(TK_F32);
  var spl = Track.make(TK_F32);
  var cat = Track.make(TK_VEC3);
  var qt = Track.make(TK_QUAT);
  var k = 0;
  while k < 100 {
    let t = f32.from(k) * 0.1;
    lin.addF32(t, f32.from(k % 7), INTERP_LINEAR);
    let i = spl.addF32(t, f32.from(k % 5), INTERP_HERMITE);
    cat.addVec3(t, new Vec3(f32.from(k % 3), f32.from(k % 4), f32.from(k % 5)), INTERP_CATMULL);
    qt.addQuat(t, Quat.angleAxis(f32.from(k) * 0.3, new Vec3(0., 1., 0.)), INTERP_LINEAR);
    k = k + 1;
  }
  let n = 200000;
  var sum f32 = 0.;
  let t0 = Instant.now();
  var i = 0;
  while i < n { sum = sum + lin.evalF32(f32.from(i % 990) * 0.01); i = i + 1; }
  print <- "f32 linear, 100 keys:      ", us(t0, n), " us per eval\n";
  let t1 = Instant.now();
  i = 0;
  while i < n { sum = sum + spl.evalF32(f32.from(i % 990) * 0.01); i = i + 1; }
  print <- "f32 hermite, 100 keys:     ", us(t1, n), " us per eval\n";
  let t2 = Instant.now();
  i = 0;
  while i < n { sum = sum + cat.evalVec3(f32.from(i % 990) * 0.01).x; i = i + 1; }
  print <- "Vec3 catmull, 100 keys:    ", us(t2, n), " us per eval\n";
  let t3 = Instant.now();
  i = 0;
  while i < n { sum = sum + qt.evalQuat(f32.from(i % 990) * 0.01).w; i = i + 1; }
  print <- "Quat slerp, 100 keys:      ", us(t3, n), " us per eval\n";

  // a clip of 20 tracks, and a player blending two of them
  var c = Clip.make("c", LOOP_LOOP);
  var c2 = Clip.make("c2", LOOP_LOOP);
  k = 0;
  while k < 20 {
    c.addTrack(u32.from(k), 1030u32, lin.copy());
    c2.addTrack(u32.from(k), 1030u32, spl.copy());
    k = k + 1;
  }
  let m = 20000;
  let t4 = Instant.now();
  i = 0;
  while i < m { sum = sum + c.sample(f32.from(i % 990) * 0.01).getF32(3u32, 1030u32, 0.); i = i + 1; }
  print <- "Clip.sample, 20 tracks:    ", us(t4, m), " us per sample\n";
  var p = Player.make();
  let ca = p.addClip(c);
  let cb = p.addClip(c2);
  p.play(ca);
  p.crossFade(cb, 1000., EASE_LINEAR);
  let t5 = Instant.now();
  i = 0;
  while i < m { p.update(0.01); sum = sum + p.evaluate().getF32(3u32, 1030u32, 0.); i = i + 1; }
  print <- "Player.update + evaluate, cross-fading two 20-track clips: ", us(t5, m), " us per frame\n";
  if sum == 12345.678 { print <- "(unlikely)\n"; }
  0;
}
