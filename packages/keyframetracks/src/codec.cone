// Curves as data: tracks and clips as bytes, so a scene file can carry them.
//
// All numbers little-endian, floats as their IEEE bits (a scene format can
// quantise them later; this form is exact, so a round trip is bit for bit).
//
//   track  = kind u8, space u8, comps u16, keys u32, key * keys
//   key    = time f32, interp u8, ease u8, flags u8, value f32 * comps,
//            [flags & 1: shape f32 * 4], [flags & 2: inTan f32 * comps, outTan f32 * comps]
//   clip   = "KFC1", nameLen u16, name bytes, length f32, mode u8,
//            bindings u32, (target u32, prop u32, track) * bindings,
//            markers u32, (time f32, id u32, arg f32) * markers
//
// A key carries its easing as an id (and up to four shape numbers: a back's
// overshoot, a spring's zeta and omega, or a Bezier's four handle numbers)
// and its interpolation as an id; shape and tangent numbers are only written
// when they are not all zero. Writing is onto a streams.Writer; reading is by
// a streams.ByteCursor, which each 'decode...' moves past what it read. Each
// returns None if the bytes run out or a number is out of range.

fn put8(out: &mut streams.Writer, v: u32) { out.putByte(u8.from(v & 0xFFu32)); }

fn put16(out: &mut streams.Writer, v: u32) { out.putLE[u16](u16.from(v & 0xFFFFu32)); }

fn put32(out: &mut streams.Writer, v: u32) { out.putLE[u32](v); }

fn putF(out: &mut streams.Writer, v: f32) { out.putLE[f32](v); }

fn get8(c: &mut streams.ByteCursor) Option[u32] { Some[u32](u32.from(c.getByte()?)) }

fn get16(c: &mut streams.ByteCursor) Option[u32] { Some[u32](u32.from(c.getLE[u16]()?)) }

fn anyNonZero(l: &List[f32], from: usize, n: usize) bool {
  var i = 0usize;
  while i < n { if ld(l, from + i) != 0. { return true; } i = i + 1usize; }
  false
}

// Append a track's bytes to 'out'
pub fn encodeTrack(t: &Track, out: &mut streams.Writer) {
  put8(out, t.kind);
  put8(out, t.space);
  put16(out, u32.from(t.comps));
  put32(out, u32.from(t.len()));
  var k = 0usize;
  while k < t.len() {
    putF(out, ld(&t.times, k));
    put8(out, *t.interps[k]);
    put8(out, *t.eases[k]);
    let hasShape = anyNonZero(&t.shapes, k * 4usize, 4usize);
    let hasTan = anyNonZero(&t.inTan, k * t.comps, t.comps) || anyNonZero(&t.outTan, k * t.comps, t.comps);
    put8(out, (if hasShape { 1u32 } else { 0u32 }) | (if hasTan { 2u32 } else { 0u32 }));
    var c = 0usize;
    while c < t.comps { putF(out, ld(&t.values, k * t.comps + c)); c = c + 1usize; }
    if hasShape {
      c = 0usize;
      while c < 4usize { putF(out, ld(&t.shapes, k * 4usize + c)); c = c + 1usize; }
    }
    if hasTan {
      c = 0usize;
      while c < t.comps { putF(out, ld(&t.inTan, k * t.comps + c)); c = c + 1usize; }
      c = 0usize;
      while c < t.comps { putF(out, ld(&t.outTan, k * t.comps + c)); c = c + 1usize; }
    }
    k = k + 1usize;
  }
}

// Read a track at the cursor, which moves past it
pub fn decodeTrack(cur: &mut streams.ByteCursor) Option[Track] {
  let kind = get8(cur)?;
  let space = get8(cur)?;
  let comps = usize.from(get16(cur)?);
  let n = usize.from(cur.getLE[u32]()?);
  if kind > TK_VECN || comps == 0usize || comps > 4096usize || n > 16777216usize { return None; }
  var t = if kind == TK_VECN { Track.makeVecN(comps) } else { Track.make(kind) };
  if t.comps != comps { return None; }
  t.space = space;
  var k = 0usize;
  while k < n {
    let time = cur.getLE[f32]()?;
    let idx = t.appendBlank(time);
    t.interps.set(idx, get8(cur)?);
    t.eases.set(idx, get8(cur)?);
    let flags = get8(cur)?;
    var c = 0usize;
    while c < comps { t.values.set(idx * comps + c, cur.getLE[f32]()?); c = c + 1usize; }
    if (flags & 1u32) != 0u32 {
      c = 0usize;
      while c < 4usize { t.shapes.set(idx * 4usize + c, cur.getLE[f32]()?); c = c + 1usize; }
    }
    if (flags & 2u32) != 0u32 {
      c = 0usize;
      while c < comps { t.inTan.set(idx * comps + c, cur.getLE[f32]()?); c = c + 1usize; }
      c = 0usize;
      while c < comps { t.outTan.set(idx * comps + c, cur.getLE[f32]()?); c = c + 1usize; }
    }
    k = k + 1usize;
  }
  Some(t)
}

// A clip's bytes
pub fn encodeClip(c: &Clip) Chain {
  var out = streams.Writer.make(4096usize);
  out.put("KFC1");
  put16(&mut out, u32.from(c.name.len()));
  out.put(c.name.view());
  putF(&mut out, c.length);
  put8(&mut out, c.mode);
  put32(&mut out, u32.from(c.bindings.len()));
  var i = 0usize;
  while i < c.bindings.len() {
    put32(&mut out, (*c.bindings[i]).target);
    put32(&mut out, (*c.bindings[i]).prop);
    encodeTrack(&c.bindings[i].track, &mut out);
    i = i + 1usize;
  }
  put32(&mut out, u32.from(c.markers.len()));
  i = 0usize;
  while i < c.markers.len() {
    putF(&mut out, (*c.markers[i]).time);
    put32(&mut out, (*c.markers[i]).id);
    putF(&mut out, (*c.markers[i]).arg);
    i = i + 1usize;
  }
  out.finish()
}

// A clip from bytes (None if they are not a clip or run out)
pub fn decodeClip(d: &Array[u8]) Option[Clip] {
  if d.len < 4usize { return None; }
  if d[0usize] != 'K' || d[1usize] != 'F' || d[2usize] != 'C' || d[3usize] != '1' { return None; }
  var cur = streams.ByteCursor.over(d);
  _ = cur.skip(4usize);
  let nameLen = usize.from(get16(&mut cur)?);
  let name = String.fromBytes(cur.getBytes(nameLen)?);
  var clip = Clip.make(name.view(), LOOP_ONCE);
  clip.length = cur.getLE[f32]()?;
  clip.mode = get8(&mut cur)?;
  let nb = usize.from(cur.getLE[u32]()?);
  if nb > 1048576usize || clip.mode > LOOP_PINGPONG { return None; }
  var i = 0usize;
  while i < nb {
    let target = cur.getLE[u32]()?;
    let prop = cur.getLE[u32]()?;
    let tr = decodeTrack(&mut cur)?;
    clip.bindings.push(Binding(target, prop, tr));
    i = i + 1usize;
  }
  let nm = usize.from(cur.getLE[u32]()?);
  if nm > 16777216usize { return None; }
  i = 0usize;
  while i < nm {
    let time = cur.getLE[f32]()?;
    let id = cur.getLE[u32]()?;
    let arg = cur.getLE[f32]()?;
    clip.markers.push(Marker(time, id, arg));
    i = i + 1usize;
  }
  Some(clip)
}
