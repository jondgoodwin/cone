// Player: plays clips. The clips themselves are pure (a time in, a Sample out);
// a Player is the little bit of state that decides which clip is at what
// time: a clock for each clip being played, the cross-fade between them, a
// queue of what comes next, the additive layers and the markers crossed
// since you last asked. Its output, 'evaluate()', is again a pure function
// of that state.
//
// - PLAY, CROSS-FADE. 'play' replaces whatever was playing. 'crossFade' starts
//   another clip over 'dur' seconds while the old ones carry on. Plays are
//   kept oldest first; the newest has the fade factor f = ease(elapsed / dur),
//   and play i weighs f_i * (1 - f_j) for every later j, so the weights
//   always sum to 1 (a fade begun during a fade nests properly: the fading-in
//   clip is itself fading out). A play whose newer play is fully in is dropped.
// - QUEUE. 'enqueue' lines a clip up behind the current one-shot clip (loop
//   mode ONCE). With a fade of f it begins f seconds before the current one
//   ends so that the cross-fade finishes exactly as it ends; with 0 it begins
//   when it ends, carrying over any leftover time of the frame.
// - SEEK AND SCRUB. 'seek(t)' puts the newest play at clip time t without
//   raising markers; 'scrub(t)' puts it there raising every marker crossed on
//   the way, in either direction (the Clip header has the rule). The
//   result of 'evaluate' after either is exactly the clip sampled at t.
// - ADDITIVE LAYERS. 'addLayer' adds a clip on top of the blended result at
//   a weight: the clip's value minus its value at time 0 (its rest pose),
//   added (Sample.addOnto), looping by its own mode, with its own clock.
// - EVENTS. 'update' collects the markers crossed by every clip it moved, and
//   an EVENT_FINISHED for a ONCE clip that reached its end (its 'arg' is the
//   clip index). 'takeEvents' hands them over; 'dispatch' calls a function
//   with each.
// - RATE. One rate for the player, negative to run backward; a paused
//   player does not move. A cross-fade's elapsed time counts real seconds
//   of play, times the absolute rate.

pub const EVENT_FINISHED = 4294967295u32;

pub struct Playing {
  pub clip: u32;
  pub time: f64;
  pub fade: f32;
  pub fadeT: f32;
  pub fadeEase: u32;
}

pub struct Layer {
  pub clip: u32;
  pub time: f64;
  pub weight: f32;
}

pub struct Queued {
  pub clip: u32;
  pub fade: f32;
  pub fadeEase: u32;
}

pub struct Player {
  pub clips: List[Clip];
  pub plays: List[Playing];
  pub layers: List[Layer];
  pub queue: List[Queued];
  pub rate: f32;
  pub paused: bool;
  pub events: List[Fired];

  pub fn make() Player {
    Player(List[Clip].empty(), List[Playing].empty(), List[Layer].empty(), List[Queued].empty(), 1., false,
      List[Fired].empty())
  }

  // Add a clip; the index it will be played by
  pub fn addClip(self: &mut, clip: Clip) u32 {
    clips.push(clip);
    u32.from(clips.len() - 1usize)
  }

  // Start 'clip' now, replacing everything playing, and empty the queue
  pub fn play(self: &mut, clip: u32) {
    plays.clear();
    queue.clear();
    plays.push(Playing(clip, 0.0f64, 0., 0., EASE_LINEAR));
  }

  // Start 'clip' over 'dur' seconds while the current ones fade out; 'easeId'
  // shapes the fade-in (EASE_LINEAR, EASE_SMOOTHSTEP ...)
  pub fn crossFade(self: &mut, clip: u32, dur: f32, easeId: u32) {
    if plays.len() == 0usize || dur <= 0. { self.play(clip); return; }
    plays.push(Playing(clip, 0.0f64, dur, 0., easeId));
  }

  // Line up 'clip' behind the current one (see the header), fading in over 'fade'
  pub fn enqueue(self: &mut, clip: u32, fade: f32, easeId: u32) {
    queue.push(Queued(clip, fade, easeId));
  }

  pub fn pause(self: &mut) { paused = true; }
  pub fn resume(self: &mut) { paused = false; }
  pub fn setRate(self: &mut, r: f32) { rate = r; }

  // The newest play's unwrapped clock (0 if nothing plays)
  pub fn time(self: &) f64 {
    if plays.len() == 0usize { return 0.0f64; }
    (*plays[plays.len() - 1usize]).time
  }

  // Put the newest play at t without raising markers
  pub fn seek(self: &mut, t: f64) {
    if plays.len() == 0usize { return; }
    let k = plays.len() - 1usize;
    var p = *plays[k];
    p.time = t;
    plays.set(k, p);
  }

  // Put the newest play at t, raising the markers crossed
  pub fn scrub(self: &mut, t: f64) {
    if plays.len() == 0usize { return; }
    let k = plays.len() - 1usize;
    var p = *plays[k];
    clips[usize.from(p.clip)].crossings(p.time, t, p.clip, &mut events);
    p.time = t;
    plays.set(k, p);
  }

  // The fade factor of play i: how far in it is (the oldest is always fully in)
  fn factor(self: &, i: usize) f32 {
    let p = *plays[i];
    if i == 0usize || p.fade <= 0. { return 1.; }
    let x = p.fadeT / p.fade;
    ease(p.fadeEase, x, 0., 0.)
  }

  // The weight of each play, oldest first, into 'out'; they sum to 1
  pub fn weights(self: &, out: &mut List[f32]) {
    out.clear();
    let n = plays.len();
    var i = 0usize;
    while i < n {
      var w = self.factor(i);
      var j = i + 1usize;
      while j < n { w = w * (1. - self.factor(j)); j = j + 1usize; }
      out.push(w);
      i = i + 1usize;
    }
  }

  pub fn addLayer(self: &mut, clip: u32, weight: f32) usize {
    layers.push(Layer(clip, 0.0f64, weight));
    layers.len() - 1usize
  }

  pub fn setLayerWeight(self: &mut, layer: usize, weight: f32) {
    var l = *layers[layer];
    l.weight = weight;
    layers.set(layer, l);
  }

  // Move every clock on by dt seconds of real time (times the player's rate)
  pub fn update(self: &mut, dt: f32) {
    if paused { return; }
    let step = f64.from(dt) * f64.from(rate);
    let absStep = if dt * rate < 0. { -(dt * rate) } else { dt * rate };
    var i = 0usize;
    while i < plays.len() {
      var p = *plays[i];
      let c = clips[usize.from(p.clip)].length;
      let mode = clips[usize.from(p.clip)].mode;
      let oldT = p.time;
      let newT = oldT + step;
      clips[usize.from(p.clip)].crossings(oldT, newT, p.clip, &mut events);
      if mode == LOOP_ONCE {
        let len = f64.from(c);
        if (step > 0.0f64 && oldT < len && newT >= len) || (step < 0.0f64 && oldT > 0.0f64 && newT <= 0.0f64) {
          events.push(Fired(EVENT_FINISHED, f32.from(p.clip), if step > 0.0f64 { c } else { 0. }, newT, step < 0.0f64, p.clip));
        }
      }
      p.time = newT;
      if p.fade > 0. { p.fadeT = p.fadeT + absStep; }
      plays.set(i, p);
      i = i + 1usize;
    }
    // layers
    i = 0usize;
    while i < layers.len() {
      var l = *layers[i];
      clips[usize.from(l.clip)].crossings(l.time, l.time + step, l.clip, &mut events);
      l.time = l.time + step;
      layers.set(i, l);
      i = i + 1usize;
    }
    self.advanceQueue();
    // drop the plays that a newer, fully faded-in play has replaced
    var keep = 0usize;
    i = 1usize;
    while i < plays.len() {
      let p = *plays[i];
      if p.fade <= 0. || p.fadeT >= p.fade { keep = i; }
      i = i + 1usize;
    }
    if keep > 0usize {
      var rest = List[Playing].empty();
      i = keep;
      while i < plays.len() { rest.push(*plays[i]); i = i + 1usize; }
      plays.clear();
      i = 0usize;
      while i < rest.len() { plays.push(*rest[i]); i = i + 1usize; }
    }
  }

  // Start the next queued clip when the current one-shot is within its fade of
  // its end. The new play has been going for the part of the fade already
  // elapsed (more than the fade if the old clip ended before this frame)
  fn advanceQueue(self: &mut) {
    if queue.len() == 0usize || plays.len() == 0usize || rate <= 0. { return; }
    let p = *plays[plays.len() - 1usize];
    let clip = &clips[usize.from(p.clip)];
    if clip.mode != LOOP_ONCE { return; }
    // real seconds of the clip left
    let leftReal = (clip.length - f32.from(p.time)) / rate;
    let q = *queue[0];
    if leftReal > q.fade { return; }
    let elapsed = q.fade - leftReal;
    var rest = List[Queued].empty();
    var i = 1usize;
    while i < queue.len() { rest.push(*queue[i]); i = i + 1usize; }
    queue.clear();
    i = 0usize;
    while i < rest.len() { queue.push(*rest[i]); i = i + 1usize; }
    plays.push(Playing(q.clip, f64.from(elapsed * rate), q.fade, elapsed, q.fadeEase));
  }

  // The properties now: the plays blended by weight, then the additive layers
  pub fn evaluate(self: &) Sample {
    var out = Sample.empty();
    var ws = List[f32].empty();
    self.weights(&mut ws);
    var i = 0usize;
    while i < plays.len() {
      let w = ld(&ws, i);
      if w > 0. {
        let p = *plays[i];
        let c = &clips[usize.from(p.clip)];
        var s = Sample.empty();
        c.sampleInto(p.time, &mut s);
        out.accumulate(&s, w);
      }
      i = i + 1usize;
    }
    i = 0usize;
    while i < layers.len() {
      let l = *layers[i];
      let c = &clips[usize.from(l.clip)];
      var cs = Sample.empty();
      c.sampleInto(l.time, &mut cs);
      var rs = Sample.empty();
      c.sampleLocal(0., &mut rs);
      out.addOnto(&cs, &rs, l.weight);
      i = i + 1usize;
    }
    out
  }

  // The markers crossed (and clips finished) since the last call, in order
  pub fn takeEvents(self: &mut) List[Fired] {
    var out = List[Fired].empty();
    var i = 0usize;
    while i < events.len() { out.push(*events[i]); i = i + 1usize; }
    events.clear();
    out
  }

  // Call 'on' with each pending event, then forget them
  pub fn dispatch(self: &mut, on: &<mut fn(e: Fired)) {
    var i = 0usize;
    while i < events.len() { on(*events[i]); i = i + 1usize; }
    events.clear();
  }
}
