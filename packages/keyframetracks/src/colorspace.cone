// Colour spaces for interpolation. A colour fade is only as good as the space
// it is mixed in: mixing sRGB-encoded values darkens the middle of a blend,
// mixing linear light is physically right for light but not even to the eye
// (red to green passes through a dull olive), and OKLab is built so equal
// steps look about equal (Bjorn Ottosson, "A perceptual color space for image
// processing", 2020; the matrices are his, for linear sRGB primaries).
//
// A Color here is linear sRGB (the 'Color' of geomath, as render takes it).
// A track whose space is SPACE_OKLAB keeps its colour keys as (L, a, b,
// alpha) and converts the result back, so its splines and blends all work in
// OKLab. HDR values above 1 are carried through (the cube root is signed), but
// OKLab is defined for 0..1: use SPACE_LINEAR for a glow that goes past white.

pub const SPACE_LINEAR = 0u32;
pub const SPACE_OKLAB = 1u32;

fn cbrtSigned(x f32) f32 {
  if x < 0. { return -libc.powf(-x, 1. / 3.); }
  if x == 0. { return 0.; }
  libc.powf(x, 1. / 3.)
}

// Linear sRGB to OKLab (L, a, b in x, y, z; alpha passes through in w)
pub fn linearToOklab(c Color) Vec4 {
  let l = 0.4122214708 * c.red + 0.5363325363 * c.green + 0.0514459929 * c.blue;
  let m = 0.2119034982 * c.red + 0.6806995451 * c.green + 0.1073969566 * c.blue;
  let s = 0.0883024619 * c.red + 0.2817188376 * c.green + 0.6299787005 * c.blue;
  let l1 = cbrtSigned(l);
  let m1 = cbrtSigned(m);
  let s1 = cbrtSigned(s);
  new Vec4(0.2104542553 * l1 + 0.7936177850 * m1 - 0.0040720468 * s1,
    1.9779984951 * l1 - 2.4285922050 * m1 + 0.4505937099 * s1,
    0.0259040371 * l1 + 0.7827717662 * m1 - 0.8086757660 * s1, c.alpha)
}

// OKLab (L, a, b, alpha) to linear sRGB
pub fn oklabToLinear(v Vec4) Color {
  let l1 = v.x + 0.3963377774 * v.y + 0.2158037573 * v.z;
  let m1 = v.x - 0.1055613458 * v.y - 0.0638541728 * v.z;
  let s1 = v.x - 0.0894841775 * v.y - 1.2914855480 * v.z;
  let l = l1 * l1 * l1;
  let m = m1 * m1 * m1;
  let s = s1 * s1 * s1;
  new Color(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
    -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s, v.w)
}

// Two colours mixed in the named space
pub fn mixColor(a Color, b Color, t f32, space u32) Color {
  if space == SPACE_OKLAB {
    let x = linearToOklab(a);
    let y = linearToOklab(b);
    return oklabToLinear(new Vec4(x.x + (y.x - x.x) * t, x.y + (y.y - x.y) * t, x.z + (y.z - x.z) * t,
      x.w + (y.w - x.w) * t));
  }
  new Color(a.red + (b.red - a.red) * t, a.green + (b.green - a.green) * t, a.blue + (b.blue - a.blue) * t,
    a.alpha + (b.alpha - a.alpha) * t)
}
