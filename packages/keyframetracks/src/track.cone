// Tracks: one animated value as a pure function of time. A Track holds keys
// (a time, a value, and how to get from this key to the next) and answers
// 'eval(t)' for any t, with no state, so it can be scrubbed, seeked and run
// backwards. Before the first key it holds the first value, after the last it
// holds the last (a Clip decides looping).
//
// - TYPED VALUES. A key's value is a few floats, laid out by the track's kind:
//   f32 (1), Vec2 (2), Vec3 (3), Quat (4, x y z w as glTF has it), Color (4,
//   linear RGBA, mixed in a named space), bool and discrete (1 each, always
//   step), transform (10: translation 3, rotation 4, scale 3), and a vector
//   of any length (for morph-target weights). Quaternions are blended by
//   spherical interpolation along the shortest arc and are always unit length;
//   a spline over quaternions is run on the four numbers and normalised, the
//   way glTF specifies.
// - INTERPOLATION PER KEY, for the segment from that key to the next:
//   step; linear (with an optional easing id: a Penner curve, smoothstep or a
//   spring); bezier (CSS cubic-bezier handles on the segment's progress);
//   catmull (a Catmull-Rom spline through the neighbouring keys, tangents by
//   central difference over the actual key times, one-sided at the ends);
//   hermite (tangents given per key: 'inTan' arrives, 'outTan' leaves, in
//   value per second). glTF's CUBICSPLINE is exactly this Hermite form, so
//   INTERP_CUBICSPLINE is the same id.
// - CATMULL-ROM here is the non-uniform finite-difference form (Kochanek and
//   Bartels with zero tension, bias and continuity), not the centripetal
//   variant: it is C1, it passes through every key, and linear data stays
//   linear.

pub const TK_F32 = 0u32;
pub const TK_VEC2 = 1u32;
pub const TK_VEC3 = 2u32;
pub const TK_QUAT = 3u32;
pub const TK_COLOR = 4u32;
pub const TK_BOOL = 5u32;
pub const TK_DISCRETE = 6u32;
pub const TK_TRANSFORM = 7u32;
pub const TK_VECN = 8u32;

pub const INTERP_STEP = 0u32;
pub const INTERP_LINEAR = 1u32;
pub const INTERP_BEZIER = 2u32;
pub const INTERP_CATMULL = 3u32;
pub const INTERP_HERMITE = 4u32;
pub const INTERP_CUBICSPLINE = 4u32;

// The number of floats in a value of 'kind' (a VECN's is its own)
pub fn kindComps(kind: u32) usize {
  if kind == TK_VEC2 { return 2usize; }
  if kind == TK_VEC3 { return 3usize; }
  if kind == TK_QUAT || kind == TK_COLOR { return 4usize; }
  if kind == TK_TRANSFORM { return 10usize; }
  1usize
}

// Where a kind's quaternion starts among its floats, or 99 if it has none
pub fn quatOffset(kind: u32) usize {
  if kind == TK_QUAT { return 0usize; }
  if kind == TK_TRANSFORM { return 3usize; }
  99usize
}

fn ld(l: &List[f32], i: usize) f32 { *l[i] }

// The unit quaternion the fraction t of the way from a to b along the
// shortest arc (t outside 0..1 extrapolates along the same great circle).
// Exact: sin((1-t) theta) a + sin(t theta) b over sin theta, falling back to
// a normalised straight blend when the two are nearly equal
pub fn slerpQuat(a: Quat, b: Quat, t: f32) Quat {
  var d = a.dot(b);
  var sg: f32 = 1.;
  if d < 0. { sg = -1.; d = -d; }
  var w1 = 1. - t;
  var w2 = t;
  if d < 0.9995 {
    let theta = acos(d);
    let sn = sin(theta);
    w1 = sin((1. - t) * theta) / sn;
    w2 = sin(t * theta) / sn;
  }
  w2 = w2 * sg;
  Quat(a.x * w1 + b.x * w2, a.y * w1 + b.y * w2, a.z * w1 + b.z * w2, a.w * w1 + b.w * w2).normalize()
}

pub struct Track {
  pub kind: u32;
  pub comps: usize;
  pub space: u32;
  pub times: List[f32];
  pub values: List[f32];
  pub interps: List[u32];
  pub eases: List[u32];
  pub shapes: List[f32];
  pub inTan: List[f32];
  pub outTan: List[f32];

  pub fn make(kind: u32) Track {
    Track(kind, kindComps(kind), SPACE_OKLAB, List[f32].empty(), List[f32].empty(), List[u32].empty(),
      List[u32].empty(), List[f32].empty(), List[f32].empty(), List[f32].empty())
  }

  // A vector of 'n' floats (morph weights, a parameter set)
  pub fn makeVecN(n: usize) Track {
    Track(TK_VECN, n, SPACE_OKLAB, List[f32].empty(), List[f32].empty(), List[u32].empty(),
      List[u32].empty(), List[f32].empty(), List[f32].empty(), List[f32].empty())
  }

  // A colour track mixed in 'space' (SPACE_OKLAB by default for 'make')
  pub fn makeColor(space: u32) Track {
    var t = Track.make(TK_COLOR);
    t.space = space;
    t
  }

  pub fn copy(self: &) Track {
    var t = Track.make(kind);
    t.comps = comps;
    t.space = space;
    var i = 0usize;
    while i < times.len() { t.times.push(ld(&times, i)); t.interps.push(*interps[i]); t.eases.push(*eases[i]); i = i + 1usize; }
    i = 0usize;
    while i < values.len() { t.values.push(ld(&values, i)); t.inTan.push(ld(&inTan, i)); t.outTan.push(ld(&outTan, i)); i = i + 1usize; }
    i = 0usize;
    while i < shapes.len() { t.shapes.push(ld(&shapes, i)); i = i + 1usize; }
    t
  }

  pub fn len(self: &) usize { times.len() }

  // The time of the last key (0 for none)
  pub fn endTime(self: &) f32 {
    if times.len() == 0usize { return 0.; }
    ld(&times, times.len() - 1usize)
  }

  // Remove every key
  pub fn clear(self: &mut) {
    times.clear(); values.clear(); interps.clear(); eases.clear(); shapes.clear(); inTan.clear(); outTan.clear();
  }

  // The index of the key at time t (made, with a default linear key of zeros,
  // if there is none): keys stay in time order, and a key at the same time
  // is replaced
  pub fn place(self: &mut, t: f32) usize {
    let n = times.len();
    var j = n;
    var i = 0usize;
    while i < n {
      if ld(&times, i) == t { return i; }
      if ld(&times, i) > t { j = i; i = n; } else { i = i + 1usize; }
    }
    // push a blank key on the end, then move the later keys up
    times.push(t);
    interps.push(INTERP_LINEAR);
    eases.push(0u32);
    i = 0usize;
    while i < 4usize { shapes.push(0.); i = i + 1usize; }
    i = 0usize;
    while i < comps { values.push(0.); inTan.push(0.); outTan.push(0.); i = i + 1usize; }
    if j == n { return n; }
    var k = n;
    while k > j {
      times.set(k, ld(&times, k - 1usize));
      interps.set(k, *interps[k - 1usize]);
      eases.set(k, *eases[k - 1usize]);
      i = 0usize;
      while i < 4usize { shapes.set(k * 4usize + i, ld(&shapes, (k - 1usize) * 4usize + i)); i = i + 1usize; }
      i = 0usize;
      while i < comps {
        values.set(k * comps + i, ld(&values, (k - 1usize) * comps + i));
        inTan.set(k * comps + i, ld(&inTan, (k - 1usize) * comps + i));
        outTan.set(k * comps + i, ld(&outTan, (k - 1usize) * comps + i));
        i = i + 1usize;
      }
      k = k - 1usize;
    }
    times.set(j, t);
    interps.set(j, INTERP_LINEAR);
    eases.set(j, 0u32);
    i = 0usize;
    while i < 4usize { shapes.set(j * 4usize + i, 0.); i = i + 1usize; }
    i = 0usize;
    while i < comps { values.set(j * comps + i, 0.); inTan.set(j * comps + i, 0.); outTan.set(j * comps + i, 0.); i = i + 1usize; }
    j
  }

  // Remove the keys at or after time t (a later tween takes over from t)
  pub fn truncateFrom(self: &mut, t: f32) {
    var n = times.len();
    while n > 0usize && ld(&times, n - 1usize) >= t { n = n - 1usize; }
    times.truncate(n);
    interps.truncate(n);
    eases.truncate(n);
    shapes.truncate(n * 4usize);
    values.truncate(n * comps);
    inTan.truncate(n * comps);
    outTan.truncate(n * comps);
  }

  // ---- adding keys: each returns the key's index, for the setters below ----

  pub fn setRaw(self: &mut, idx: usize, v0: f32, v1: f32, v2: f32, v3: f32) {
    values.set(idx * comps, v0);
    if comps > 1usize { values.set(idx * comps + 1usize, v1); }
    if comps > 2usize { values.set(idx * comps + 2usize, v2); }
    if comps > 3usize { values.set(idx * comps + 3usize, v3); }
  }

  pub fn addF32(self: &mut, t: f32, v: f32, interp: u32) usize {
    let i = place(t);
    setRaw(i, v, 0., 0., 0.);
    interps.set(i, interp);
    i
  }

  pub fn addVec2(self: &mut, t: f32, v: Vec2, interp: u32) usize {
    let i = place(t);
    setRaw(i, v.x, v.y, 0., 0.);
    interps.set(i, interp);
    i
  }

  pub fn addVec3(self: &mut, t: f32, v: Vec3, interp: u32) usize {
    let i = place(t);
    setRaw(i, v.x, v.y, v.z, 0.);
    interps.set(i, interp);
    i
  }

  pub fn addQuat(self: &mut, t: f32, q: Quat, interp: u32) usize {
    let i = place(t);
    setRaw(i, q.x, q.y, q.z, q.w);
    interps.set(i, interp);
    i
  }

  // A colour is linear RGBA; an OKLab track stores it converted
  pub fn addColor(self: &mut, t: f32, c: Color, interp: u32) usize {
    let i = place(t);
    if space == SPACE_OKLAB {
      let o = linearToOklab(c);
      setRaw(i, o.x, o.y, o.z, o.w);
    } else {
      setRaw(i, c.red, c.green, c.blue, c.alpha);
    }
    interps.set(i, interp);
    i
  }

  // A bool or a discrete value (an integer, kept as a float) always steps
  pub fn addBool(self: &mut, t: f32, v: bool) usize {
    let i = place(t);
    setRaw(i, if v { 1. } else { 0. }, 0., 0., 0.);
    interps.set(i, INTERP_STEP);
    i
  }

  pub fn addInt(self: &mut, t: f32, v: i32) usize {
    let i = place(t);
    setRaw(i, f32.from(v), 0., 0., 0.);
    interps.set(i, INTERP_STEP);
    i
  }

  pub fn addTransform(self: &mut, t: f32, x: Transform3, interp: u32) usize {
    let i = place(t);
    let b = i * comps;
    values.set(b, x.translation.x); values.set(b + 1usize, x.translation.y); values.set(b + 2usize, x.translation.z);
    values.set(b + 3usize, x.rotation.x); values.set(b + 4usize, x.rotation.y);
    values.set(b + 5usize, x.rotation.z); values.set(b + 6usize, x.rotation.w);
    values.set(b + 7usize, x.scale.x); values.set(b + 8usize, x.scale.y); values.set(b + 9usize, x.scale.z);
    interps.set(i, interp);
    i
  }

  // A key of a VECN track
  pub fn addVecN(self: &mut, t: f32, v: &List[f32], interp: u32) usize {
    let i = place(t);
    var c = 0usize;
    while c < comps && c < v.len() { values.set(i * comps + c, ld(v, c)); c = c + 1usize; }
    interps.set(i, interp);
    i
  }

  // ---- how a key leaves for the next ----

  pub fn setInterp(self: &mut, idx: usize, interp: u32) { interps.set(idx, interp); }

  // Linear with the easing 'id' (p0, p1: a back's overshoot, a spring's zeta and omega)
  pub fn setEase(self: &mut, idx: usize, id: u32, p0: f32, p1: f32) {
    interps.set(idx, INTERP_LINEAR);
    eases.set(idx, id);
    shapes.set(idx * 4usize, p0);
    shapes.set(idx * 4usize + 1usize, p1);
  }

  // CSS cubic-bezier(x1, y1, x2, y2) on the segment's progress
  pub fn setBezier(self: &mut, idx: usize, x1: f32, y1: f32, x2: f32, y2: f32) {
    interps.set(idx, INTERP_BEZIER);
    shapes.set(idx * 4usize, x1);
    shapes.set(idx * 4usize + 1usize, y1);
    shapes.set(idx * 4usize + 2usize, x2);
    shapes.set(idx * 4usize + 3usize, y2);
  }

  // Hermite tangents in value per second: 'in' arrives at this key, 'out' leaves it
  pub fn setTangents(self: &mut, idx: usize, tin: &List[f32], tout: &List[f32]) {
    interps.set(idx, INTERP_HERMITE);
    var c = 0usize;
    while c < comps {
      if c < tin.len() { inTan.set(idx * comps + c, ld(tin, c)); }
      if c < tout.len() { outTan.set(idx * comps + c, ld(tout, c)); }
      c = c + 1usize;
    }
  }

  // ---- evaluation ----

  // The index k of the last key at or before t (keys 0 to n-2 only)
  fn segment(self: &, t: f32) usize {
    var lo = 0usize;
    var hi = times.len() - 1usize;
    while hi - lo > 1usize {
      let mid = (lo + hi) / 2usize;
      if ld(&times, mid) <= t { lo = mid; } else { hi = mid; }
    }
    lo
  }

  // The tangent (value per second) of key j by finite differences over the
  // key times, one-sided at the ends, into out[0..comps]
  fn catmullTangent(self: &, j: usize, out: &mut List[f32]) {
    let n = times.len();
    var a = j;
    var b = j;
    if j > 0usize { a = j - 1usize; }
    if j + 1usize < n { b = j + 1usize; }
    let dt = ld(&times, b) - ld(&times, a);
    let qo = quatOffset(kind);
    // a quaternion's neighbours are taken in the hemisphere of key j
    var sa: f32 = 1.;
    var sb: f32 = 1.;
    if qo < 99usize {
      var da: f32 = 0.; var db: f32 = 0.;
      var c = 0usize;
      while c < 4usize {
        da = da + ld(&values, a * comps + qo + c) * ld(&values, j * comps + qo + c);
        db = db + ld(&values, b * comps + qo + c) * ld(&values, j * comps + qo + c);
        c = c + 1usize;
      }
      if da < 0. { sa = -1.; }
      if db < 0. { sb = -1.; }
    }
    var c = 0usize;
    while c < comps {
      let inQuat = qo < 99usize && c >= qo && c < qo + 4usize;
      let va = ld(&values, a * comps + c) * (if inQuat { sa } else { 1. });
      let vb = ld(&values, b * comps + c) * (if inQuat { sb } else { 1. });
      out.set(c, if dt > 0. { (vb - va) / dt } else { 0. });
      c = c + 1usize;
    }
  }

  // The value at time t into 'out' (cleared, then 'comps' floats)
  pub fn evalRaw(self: &, t: f32, out: &mut List[f32]) {
    out.clear();
    let n = times.len();
    var c = 0usize;
    if n == 0usize {
      while c < comps { out.push(0.); c = c + 1usize; }
      let q0 = quatOffset(kind);
      if q0 < 99usize { out.set(q0 + 3usize, 1.); }
      if kind == TK_TRANSFORM { out.set(7usize, 1.); out.set(8usize, 1.); out.set(9usize, 1.); }
      return;
    }
    if t < ld(&times, 0usize) || n == 1usize {
      while c < comps { out.push(ld(&values, c)); c = c + 1usize; }
      return;
    }
    if t >= ld(&times, n - 1usize) {
      while c < comps { out.push(ld(&values, (n - 1usize) * comps + c)); c = c + 1usize; }
      return;
    }
    let k = segment(t);
    let interp = *interps[k];
    let t0 = ld(&times, k);
    let dt = ld(&times, k + 1usize) - t0;
    let s = (t - t0) / dt;
    let b0 = k * comps;
    let b1 = (k + 1usize) * comps;
    let qo = quatOffset(kind);
    if interp == INTERP_STEP || kind == TK_BOOL || kind == TK_DISCRETE {
      while c < comps { out.push(ld(&values, b0 + c)); c = c + 1usize; }
      return;
    }
    if interp == INTERP_LINEAR || interp == INTERP_BEZIER {
      var alpha = s;
      if interp == INTERP_BEZIER {
        alpha = bezierEase(ld(&shapes, k * 4usize), ld(&shapes, k * 4usize + 1usize),
          ld(&shapes, k * 4usize + 2usize), ld(&shapes, k * 4usize + 3usize), s);
      } else {
        alpha = ease(*eases[k], s, ld(&shapes, k * 4usize), ld(&shapes, k * 4usize + 1usize));
      }
      while c < comps {
        let a = ld(&values, b0 + c);
        out.push(a + (ld(&values, b1 + c) - a) * alpha);
        c = c + 1usize;
      }
      if qo < 99usize {
        let qa = Quat(ld(&values, b0 + qo), ld(&values, b0 + qo + 1usize), ld(&values, b0 + qo + 2usize), ld(&values, b0 + qo + 3usize));
        let qb = Quat(ld(&values, b1 + qo), ld(&values, b1 + qo + 1usize), ld(&values, b1 + qo + 2usize), ld(&values, b1 + qo + 3usize));
        let q = slerpQuat(qa, qb, alpha);
        out.set(qo, q.x); out.set(qo + 1usize, q.y); out.set(qo + 2usize, q.z); out.set(qo + 3usize, q.w);
      }
      return;
    }
    // Hermite (given tangents) or Catmull-Rom (tangents from the neighbours)
    var m0 = List[f32].empty();
    var m1 = List[f32].empty();
    c = 0usize;
    while c < comps { m0.push(0.); m1.push(0.); c = c + 1usize; }
    if interp == INTERP_CATMULL {
      catmullTangent(k, &mut m0);
      catmullTangent(k + 1usize, &mut m1);
    } else {
      c = 0usize;
      while c < comps { m0.set(c, ld(&outTan, b0 + c)); m1.set(c, ld(&inTan, b1 + c)); c = c + 1usize; }
    }
    // the end key in the first key's hemisphere (its tangent turns with it)
    var flip: f32 = 1.;
    if qo < 99usize {
      var d: f32 = 0.;
      c = 0usize;
      while c < 4usize { d = d + ld(&values, b0 + qo + c) * ld(&values, b1 + qo + c); c = c + 1usize; }
      if d < 0. { flip = -1.; }
    }
    let s2 = s * s;
    let s3 = s2 * s;
    let h00 = 2. * s3 - 3. * s2 + 1.;
    let h10 = s3 - 2. * s2 + s;
    let h01 = -2. * s3 + 3. * s2;
    let h11 = s3 - s2;
    c = 0usize;
    while c < comps {
      let inQuat = qo < 99usize && c >= qo && c < qo + 4usize;
      let f = if inQuat { flip } else { 1. };
      out.push(h00 * ld(&values, b0 + c) + h10 * dt * ld(&m0, c) + h01 * f * ld(&values, b1 + c) + h11 * dt * f * ld(&m1, c));
      c = c + 1usize;
    }
    if qo < 99usize {
      let q = Quat(ld(out, qo), ld(out, qo + 1usize), ld(out, qo + 2usize), ld(out, qo + 3usize)).normalize();
      out.set(qo, q.x); out.set(qo + 1usize, q.y); out.set(qo + 2usize, q.z); out.set(qo + 3usize, q.w);
    }
  }

  // The value at t as a consumer reads it: 'evalRaw', with an OKLab colour
  // converted back to linear RGBA
  pub fn evalLinear(self: &, t: f32, out: &mut List[f32]) {
    self.evalRaw(t, out);
    if kind == TK_COLOR && space == SPACE_OKLAB {
      let c = oklabToLinear(Vec4(ld(out, 0usize), ld(out, 1usize), ld(out, 2usize), ld(out, 3usize)));
      out.set(0usize, c.red); out.set(1usize, c.green); out.set(2usize, c.blue); out.set(3usize, c.alpha);
    }
  }

  // Remove the keys after time t (those at t stay)
  pub fn truncateAfter(self: &mut, t: f32) {
    var n = times.len();
    while n > 0usize && ld(&times, n - 1usize) > t { n = n - 1usize; }
    times.truncate(n);
    interps.truncate(n);
    eases.truncate(n);
    shapes.truncate(n * 4usize);
    values.truncate(n * comps);
    inTan.truncate(n * comps);
    outTan.truncate(n * comps);
  }

  // A blank key on the end at time t (t at or after the last key's), without
  // replacing a key already at t: two keys at one time make a jump (the
  // earlier is the value arriving, the later the value leaving)
  pub fn appendBlank(self: &mut, t: f32) usize {
    times.push(t);
    interps.push(INTERP_LINEAR);
    eases.push(0u32);
    var i = 0usize;
    while i < 4usize { shapes.push(0.); i = i + 1usize; }
    i = 0usize;
    while i < comps { values.push(0.); inTan.push(0.); outTan.push(0.); i = i + 1usize; }
    times.len() - 1usize
  }

  // The colour as this track stores it (converted if the track mixes in OKLab)
  pub fn storeColor(self: &, c: Color, out: &mut List[f32]) {
    out.clear();
    if space == SPACE_OKLAB {
      let o = linearToOklab(c);
      out.push(o.x); out.push(o.y); out.push(o.z); out.push(o.w);
    } else {
      out.push(c.red); out.push(c.green); out.push(c.blue); out.push(c.alpha);
    }
  }

  // ---- typed evaluation ----

  pub fn evalF32(self: &, t: f32) f32 {
    var o = List[f32].empty();
    evalRaw(t, &mut o);
    ld(&o, 0usize)
  }

  pub fn evalVec2(self: &, t: f32) Vec2 {
    var o = List[f32].empty();
    evalRaw(t, &mut o);
    Vec2(ld(&o, 0usize), ld(&o, 1usize))
  }

  pub fn evalVec3(self: &, t: f32) Vec3 {
    var o = List[f32].empty();
    evalRaw(t, &mut o);
    Vec3(ld(&o, 0usize), ld(&o, 1usize), ld(&o, 2usize))
  }

  pub fn evalQuat(self: &, t: f32) Quat {
    var o = List[f32].empty();
    evalRaw(t, &mut o);
    Quat(ld(&o, 0usize), ld(&o, 1usize), ld(&o, 2usize), ld(&o, 3usize))
  }

  pub fn evalColor(self: &, t: f32) Color {
    var o = List[f32].empty();
    evalRaw(t, &mut o);
    if space == SPACE_OKLAB {
      return oklabToLinear(Vec4(ld(&o, 0usize), ld(&o, 1usize), ld(&o, 2usize), ld(&o, 3usize)));
    }
    Color(ld(&o, 0usize), ld(&o, 1usize), ld(&o, 2usize), ld(&o, 3usize))
  }

  pub fn evalBool(self: &, t: f32) bool { evalF32(t) >= 0.5 }

  pub fn evalInt(self: &, t: f32) i32 { i32.from(libc.floorf(evalF32(t) + 0.5)) }

  pub fn evalTransform(self: &, t: f32) Transform3 {
    var o = List[f32].empty();
    evalRaw(t, &mut o);
    Transform3(Vec3(ld(&o, 0usize), ld(&o, 1usize), ld(&o, 2usize)),
      Quat(ld(&o, 3usize), ld(&o, 4usize), ld(&o, 5usize), ld(&o, 6usize)),
      Vec3(ld(&o, 7usize), ld(&o, 8usize), ld(&o, 9usize)))
  }
}

// ---------------------------------------------------------------------------
// glTF

// The same numbers as gltfimport's InterpLinear, InterpStep and InterpCubic,
// so a sampler's interpolation passes straight through
pub const GLTF_LINEAR = 0u32;
pub const GLTF_STEP = 1u32;
pub const GLTF_CUBICSPLINE = 2u32;

// A track from a glTF animation sampler: its input times, its output floats
// (for CUBICSPLINE three values per key: in-tangent, value, out-tangent, each
// 'comps' floats) and its interpolation. 'kind' is TK_VEC3 for translation
// and scale, TK_QUAT for rotation, TK_VECN with 'n' for morph weights. glTF's
// tangents are already value per second scaled by the segment's duration at
// evaluation, which is exactly the Hermite form of 'evalRaw', so they are
// copied as they are.
pub fn trackFromGltf(kind: u32, n: usize, interp: u32, times: &List[f32], output: &List[f32]) Track {
  var tr = if kind == TK_VECN { Track.makeVecN(n) } else { Track.make(kind) };
  let comps = tr.comps;
  var k = 0usize;
  while k < times.len() {
    let idx = tr.place(ld(times, k));
    var c = 0usize;
    if interp == GLTF_CUBICSPLINE {
      while c < comps {
        tr.inTan.set(idx * comps + c, ld(output, (k * 3usize) * comps + c));
        tr.values.set(idx * comps + c, ld(output, (k * 3usize + 1usize) * comps + c));
        tr.outTan.set(idx * comps + c, ld(output, (k * 3usize + 2usize) * comps + c));
        c = c + 1usize;
      }
      tr.interps.set(idx, INTERP_HERMITE);
    } else {
      while c < comps { tr.values.set(idx * comps + c, ld(output, k * comps + c)); c = c + 1usize; }
      tr.interps.set(idx, if interp == GLTF_STEP { INTERP_STEP } else { INTERP_LINEAR });
    }
    k = k + 1usize;
  }
  tr
}
