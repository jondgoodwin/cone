// A scene of mixed shapes, with nothing falling (there is no solver yet): the
// broad phase finds the candidate pairs and the narrow phase prints the
// contacts of each, then a ray, a shape cast and a closest-point query.

mod scene;

import stdio use *;
import collections use List;
import geomath use *;
import rigidcollide use *;

struct Body {
  name: &str;
  shape: Shape;
  xf: Rigid;
  isStatic: bool;
}

fn pv(v: Vec3) { print <- "(", f64.from(v.x), ", ", f64.from(v.y), ", ", f64.from(v.z), ")"; }

fn main() i32 {
  // The ground is a 12 x 12 heightfield with a gentle swell
  var heights = List[f32].empty();
  var j = 0u32;
  while j < 13u32 {
    var i = 0u32;
    while i < 13u32 {
      let x = f32.from(i) - 6.;
      let z = f32.from(j) - 6.;
      heights.push(0.3 * cos(x * 0.4) * cos(z * 0.4));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  var bodies = List[Body].empty();
  bodies.push(Body("ground", Shape.single(Prim.heightfield(heights, 13u32, 13u32, 1., 1., Vec3(-6., 0., -6.))), Rigid.identity(), true));
  bodies.push(Body("crate", Shape.single(Prim.box(Vec3(0.5, 0.5, 0.5))), Rigid.at(Vec3(0., 0.78, 0.)), false));
  bodies.push(Body("ball", Shape.single(Prim.sphere(0.4)), Rigid.at(Vec3(0.9, 1.15, 0.1)), false));
  bodies.push(Body("pill", Shape.single(Prim.capsule(0.25, 0.5)),
    Rigid(Vec3(-1.6, 0.7, 0.2), Quat.angleAxis(pi / 2., Vec3(0., 0., 1.))), false));
  bodies.push(Body("drum", Shape.single(Prim.cylinder(0.4, 0.5)), Rigid.at(Vec3(2.2, 0.75, 0.)), false));
  var pts = List[Vec3].empty();
  pts.push(Vec3(-0.5, 0., -0.5)); pts.push(Vec3(0.5, 0., -0.5)); pts.push(Vec3(0.5, 0., 0.5));
  pts.push(Vec3(-0.5, 0., 0.5)); pts.push(Vec3(0., 0.9, 0.));
  bodies.push(Body("tent", Shape.single(convexHull(pts.view())), Rigid.at(Vec3(0., 0.62, -2.)), false));
  var dumbbell = Shape.compound();
  dumbbell.add(Prim.sphere(0.3), Rigid.at(Vec3(-0.6, 0., 0.)));
  dumbbell.add(Prim.sphere(0.3), Rigid.at(Vec3(0.6, 0., 0.)));
  dumbbell.add(Prim.cylinder(0.08, 0.6), Rigid(Vec3(0., 0., 0.), Quat.angleAxis(pi / 2., Vec3(0., 0., 1.))));
  bodies.push(Body("dumbbell", dumbbell, Rigid.at(Vec3(-3., 0.62, 1.)), false));

  // Broad phase
  var bp = SweepAndPrune.empty();
  var i = 0usize;
  while i < bodies.len() {
    let b = bodies[i];
    bp.add(u32.from(i), b.shape.bounds(b.xf).expand(0.05), 1u32, 0xffffffffu32, b.isStatic);
    i = i + 1usize;
  }
  var pairs = List[BodyPair].empty();
  bp.pairs(&mut pairs);
  print <- pairs.len(), " candidate pairs\n";
  i = 0usize;
  while i < pairs.len() {
    let pa = bodies[usize.from(pairs[i].a)];
    let pb = bodies[usize.from(pairs[i].b)];
    var out = List[Manifold].empty();
    collide(&pa.shape, pa.xf, &pb.shape, pb.xf, 0.05, &mut out);
    print <- pa.name, " - ", pb.name, ": ", out.len(), " manifold(s)\n";
    var m = 0usize;
    while m < out.len() {
      let mf = out[m];
      print <- "  normal "; pv(mf.normal); print <- ", ", mf.count, " point(s), deepest ", f64.from(mf.deepest()), "\n";
      var k = 0usize;
      while k < mf.count {
        print <- "    at "; pv(mf.points[k].onA); print <- " depth ", f64.from(mf.points[k].depth), "\n";
        k = k + 1usize;
      }
      m = m + 1usize;
    }
    i = i + 1usize;
  }

  // A ray down through the scene
  let ground = bodies[0usize];
  let crate = bodies[1usize];
  let h = rayCast(&crate.shape, crate.xf, Vec3(0.2, 5., 0.1), Vec3(0., -1., 0.), 100.);
  print <- "ray onto the crate: t ", f64.from(h.t), " normal "; pv(h.normal); print <- "\n";
  let g = rayCast(&ground.shape, ground.xf, Vec3(-4.3, 5., 2.2), Vec3(0., -1., 0.), 100.);
  print <- "ray onto the ground: t ", f64.from(g.t), " normal "; pv(g.normal); print <- "\n";
  // A sphere swept across the scene
  let probe = Shape.single(Prim.sphere(0.3));
  let c = shapeCast(&probe, Rigid.at(Vec3(-6., 0.8, 0.)), Vec3(12., 0., 0.), &crate.shape, crate.xf);
  print <- "sphere swept along +x hits the crate at fraction ", f64.from(c.fraction), " (", f64.from(c.fraction * 12.), " m)\n";
  let d = closestPoints(&bodies[2usize].shape, bodies[2usize].xf, &bodies[4usize].shape, bodies[4usize].xf, 10.);
  print <- "ball to drum: ", f64.from(d.dist), " m apart\n";
  0i32
}
