// Bench: what the narrow phase costs per pair on the real clock. Each line is
// the same pair of shapes, 20,000 slightly different placements, and the mean
// time to answer. Build it optimised to measure:
//
//   congo run --release packages/rigidcollide/examples/bench.cone

mod bench;

import stdio use *;
import collections use List;
import time use Duration, Instant;
import geomath use *;
import rigidcollide use *;

fn report(what: &str, took: Duration, n: u64, contacts: u64) {
  printStr(what);
  printFloat(f64.from(took.nanos()) / f64.from(n));
  printStr(" ns per pair, ");
  printFloat(f64.from(contacts));
  printStr(" of them touching\n");
}

fn run(what: &str, a: &Shape, b: &Shape, dy: f32) {
  var touching = 0u64;
  let t0 = Instant.now();
  var i = 0u32;
  while i < 20000u32 {
    let s = f32.from(i % 100u32) * 0.001;
    let xa = Rigid(Vec3(0., 0., 0.), Quat.angleAxis(s, Vec3(0., 1., 0.)));
    let xb = Rigid(Vec3(0.1 + s, dy, 0.2), Quat.angleAxis(0.3 + s, Vec3(1., 1., 0.).normalize()));
    var out = List[Manifold].empty();
    collide(a, xa, b, xb, 0.02, &mut out);
    if out.len() > 0usize { touching = touching + 1u64; }
    i = i + 1u32;
  }
  report(what, t0.elapsed(), 20000u64, touching);
}

fn main() i32 {
  let sph = Shape.single(Prim.sphere(0.5));
  let box = Shape.single(Prim.box(Vec3(0.5, 0.5, 0.5)));
  let cap = Shape.single(Prim.capsule(0.3, 0.5));
  let cyl = Shape.single(Prim.cylinder(0.4, 0.5));
  var pts = List[Vec3].empty();
  var k = 0u32;
  while k < 20u32 {
    let a = f32.from(k) * 2.399963;
    let y = 1. - 2. * (f32.from(k) + 0.5) / 20.;
    let r = (1. - y * y).sqrt();
    pts.push(Vec3(0.5 * r * cos(a), 0.5 * y, 0.5 * r * sin(a)));
    k = k + 1u32;
  }
  let hull = Shape.single(convexHull(pts.view()));
  run("sphere-sphere    ", &sph, &sph, 0.9);
  run("capsule-capsule  ", &cap, &cap, 0.5);
  run("box-box (SAT)    ", &box, &box, 0.9);
  run("box-sphere (GJK) ", &box, &sph, 0.9);
  run("box-cylinder     ", &box, &cyl, 0.95);
  run("hull(20)-hull(20)", &hull, &hull, 0.8);
  // a box resting on a 10 m two-triangle mesh and on a 9 x 9 heightfield (box second, pressed 1 cm in)
  var verts = List[Vec3].empty();
  verts.push(Vec3(-5., 0., -5.)); verts.push(Vec3(5., 0., -5.)); verts.push(Vec3(5., 0., 5.)); verts.push(Vec3(-5., 0., 5.));
  var idx = List[u32].empty();
  idx.push(0u32); idx.push(3u32); idx.push(2u32); idx.push(0u32); idx.push(2u32); idx.push(1u32);
  let ground = Shape.single(meshPrim(verts, idx));
  var hs = List[f32].empty();
  var hk = 0u32;
  while hk < 81u32 { hs.push(0.); hk = hk + 1u32; }
  let field = Shape.single(Prim.heightfield(hs, 9u32, 9u32, 1., 1., Vec3(-4., 0., -4.)));
  run("box-mesh (2 tris)  ", &ground, &box, 0.49);
  run("box-heightfield    ", &field, &box, 0.49);
  0i32
}
