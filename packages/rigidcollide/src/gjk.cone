// GJK distance and EPA penetration depth.
//
// GJK (Gilbert, Johnson and Keerthi 1988, in the form of van den Bergen,
// "A Fast and Robust GJK Implementation", and Ericson, Real-Time Collision
// Detection 9.5) walks the Minkowski difference A - B towards the origin. As in
// Jolt, it works on the shapes' cores (a sphere is a point, a capsule a
// segment) and the rounding is added back afterwards, which keeps the
// penetration problem away from smooth surfaces.
//
// EPA (van den Bergen, "Proximity Queries and Penetration Depth", 2001) grows
// the simplex GJK ended with, when the cores overlap, into a polytope whose
// face nearest the origin is the penetration.
//
// Everything is in world space: each shape comes with its Rigid.

// A simplex of the Minkowski difference A - B: each vertex w = pa - pb, with
// the points on the cores it came from
pub struct Simplex {
  pub n: usize;
  pub w: Array[Vec3, 4];
  pub pa: Array[Vec3, 4];
  pub pb: Array[Vec3, 4];
}

pub fn supportWorld(p: &Prim, x: Rigid, dir: Vec3) Vec3 {
  x.apply(p.supportCore(x.unrotate(dir)))
}

// What GJK found. 'intersect': the cores overlap (EPA's job next). Otherwise
// pa and pb are the closest points of the cores and 'dist' their distance;
// 'far': stopped early because the cores are certainly farther apart than the
// limit asked for
pub struct GjkResult {
  pub intersect: bool;
  pub far: bool;
  pub dist: f32;
  pub pa: Vec3;
  pub pb: Vec3;
  pub simplex: Simplex;
  pub borderline: bool;     // 'intersect' only because the nearest point is too close to the origin to tell (see gjk)
}

struct SimplexPoint {
  v: Vec3;
  inside: bool;
  lam: Array[f32, 4];
}

// Barycentric weights of the point of triangle a, b, c nearest the origin
// (Ericson 5.1.5, the origin as the query point)
//
// Done in 64 bits: the products d1 * d4 - d3 * d2 cancel almost completely for a
// long thin triangle of the difference (a 40 m triangle against a box makes a sliver
// tens of metres long whose nearest point to the origin is millimetres away), and in
// 32 bits the weights came out wrong and GJK stopped with the origin outside a
// difference that held it.
fn triWeights(a0: Vec3, b0: Vec3, c0: Vec3) Array[f32, 3] {
  let a = DVec3.from(a0);
  let b = DVec3.from(b0);
  let c = DVec3.from(c0);
  let ab = b - a;
  let ac = c - a;
  let d1 = ab.dot(-a);
  let d2 = ac.dot(-a);
  if d1 <= 0. && d2 <= 0. { return [1., 0., 0.]; }
  let d3 = ab.dot(-b);
  let d4 = ac.dot(-b);
  if d3 >= 0. && d4 <= d3 { return [0., 1., 0.]; }
  let vc = d1 * d4 - d3 * d2;
  if vc <= 0. && d1 >= 0. && d3 <= 0. {
    let v = d1 / (d1 - d3);
    return [f32.from(1.0f64 - v), f32.from(v), 0.];
  }
  let d5 = ab.dot(-c);
  let d6 = ac.dot(-c);
  if d6 >= 0. && d5 <= d6 { return [0., 0., 1.]; }
  let vb = d5 * d2 - d1 * d6;
  if vb <= 0. && d2 >= 0. && d6 <= 0. {
    let w = d2 / (d2 - d6);
    return [f32.from(1.0f64 - w), 0., f32.from(w)];
  }
  let va = d3 * d6 - d5 * d4;
  if va <= 0. && (d4 - d3) >= 0. && (d5 - d6) >= 0. {
    let w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
    return [0., f32.from(1.0f64 - w), f32.from(w)];
  }
  let sum = va + vb + vc;
  if sum < 1.0e-300f64 && sum > -1.0e-300f64 { return [1., 0., 0.]; }
  let denom = 1.0f64 / sum;
  let v = vb * denom;
  let w = vc * denom;
  [f32.from(1.0f64 - v - w), f32.from(v), f32.from(w)]
}

fn segWeights(a0: Vec3, b0: Vec3) Array[f32, 2] {
  let a = DVec3.from(a0);
  let ab = DVec3.from(b0) - a;
  let l2 = ab.dot(ab);
  if l2 < 1.0e-30f64 { return [1., 0.]; }
  let t = f32.from(clampd(-a.dot(ab) / l2, 0.0f64, 1.0f64));
  [1. - t, t]
}

fn clampd(v: f64, lo: f64, hi: f64) f64 { if v < lo { lo } else if v > hi { hi } else { v } }

// The point of the simplex nearest the origin, with the simplex cut down to
// the vertices that support it (weight zero vertices dropped)
fn reduceSimplex(s: &mut Simplex) SimplexPoint {
  var lam = [0.f, 0., 0., 0.];
  var inside = false;
  if s.n == 1usize {
    lam[0usize] = 1.;
  } else if s.n == 2usize {
    let t = segWeights(s.w[0usize], s.w[1usize]);
    lam[0usize] = t[0usize]; lam[1usize] = t[1usize];
  } else if s.n == 3usize {
    let t = triWeights(s.w[0usize], s.w[1usize], s.w[2usize]);
    lam[0usize] = t[0usize]; lam[1usize] = t[1usize]; lam[2usize] = t[2usize];
  } else {
    // Tetrahedron: the origin is inside if on the inner side of every face,
    // else the nearest of the faces it is outside of
    var bestD = bigNumber;
    var f = 0usize;
    while f < 4usize {
      // face (i, j, k) with the opposite vertex l
      let l = f;
      let i = (f + 1usize) % 4usize;
      let j = (f + 2usize) % 4usize;
      let k = (f + 3usize) % 4usize;
      let wi = s.w[i];
      let nrm = (s.w[j] - wi).cross(s.w[k] - wi);
      let so = nrm.dot(-wi);
      let sl = nrm.dot(s.w[l] - wi);
      // A nearly flat tetrahedron cannot hold the origin: every face is a candidate
      let flat = absf(sl) <= 1.0e-5 * nrm.length() * (s.w[l] - wi).length();
      if flat || (so * sl <= 0. && !(so == 0. && sl != 0.)) {
        let t = triWeights(wi, s.w[j], s.w[k]);
        let p = wi * t[0usize] + s.w[j] * t[1usize] + s.w[k] * t[2usize];
        let d = p.lengthSquared();
        if d < bestD {
          bestD = d;
          lam = [0., 0., 0., 0.];
          lam[i] = t[0usize]; lam[j] = t[1usize]; lam[k] = t[2usize];
        }
      }
      f = f + 1usize;
    }
    if bestD == bigNumber {
      inside = true;
      lam = [0.25, 0.25, 0.25, 0.25];
    }
  }
  // Keep the supporting vertices
  var out = Simplex(0usize, s.w, s.pa, s.pb);
  var vd = DVec3(0., 0., 0.);
  var i = 0usize;
  while i < s.n {
    if lam[i] > 0. || inside {
      out.w[out.n] = s.w[i];
      out.pa[out.n] = s.pa[i];
      out.pb[out.n] = s.pb[i];
      lam[out.n] = lam[i];
      out.n = out.n + 1usize;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < out.n { vd = vd + DVec3.from(out.w[i]) * f64.from(lam[i]); i = i + 1usize; }
  *s = out;
  SimplexPoint(vd.toVec3(), inside, lam)
}

// GJK on the cores of a and b. Stops early ('far') when the cores are
// certainly more than 'maxDist' apart.
pub fn gjk(a: &Prim, xa: Rigid, b: &Prim, xb: Rigid, maxDist: f32) GjkResult {
  var s = Simplex(1usize, [Vec3(0., 0., 0.), Vec3(0., 0., 0.), Vec3(0., 0., 0.), Vec3(0., 0., 0.)],
    [Vec3(0., 0., 0.), Vec3(0., 0., 0.), Vec3(0., 0., 0.), Vec3(0., 0., 0.)],
    [Vec3(0., 0., 0.), Vec3(0., 0., 0.), Vec3(0., 0., 0.), Vec3(0., 0., 0.)]);
  var dir0 = xb.pos - xa.pos;
  if dir0.lengthSquared() < 1.0e-12 { dir0 = Vec3(1., 0., 0.); }
  s.pa[0usize] = supportWorld(a, xa, dir0);
  s.pb[0usize] = supportWorld(b, xb, -dir0);
  s.w[0usize] = s.pa[0usize] - s.pb[0usize];
  var v = s.w[0usize];
  var lam = [1.f, 0., 0., 0.];
  var iter = 0u32;
  var hit = false;
  var far = false;
  var wmax2 = s.w[0usize].lengthSquared();
  while iter < 64u32 {
    iter = iter + 1u32;
    let v2 = v.lengthSquared();
    if v2 < 1.0e-12 { hit = true; break; }
    let dir = -v;
    let pa = supportWorld(a, xa, dir);
    let pb = supportWorld(b, xb, -dir);
    let w = pa - pb;
    wmax2 = maxf(wmax2, w.lengthSquared());
    let vw = v.dot(w);
    // The plane through w perpendicular to v separates the origin from the
    // difference: the distance is at least vw / |v|
    if vw > 0. && vw * vw > maxDist * maxDist * v2 { far = true; break; }
    // No progress
    if v2 - vw <= 1.0e-6 * v2 + 1.0e-10 { break; }
    // a vertex already in the simplex means no progress
    var dup = false;
    var i = 0usize;
    while i < s.n {
      if (s.w[i] - w).lengthSquared() < 1.0e-12 { dup = true; }
      i = i + 1usize;
    }
    if dup { break; }
    s.w[s.n] = w;
    s.pa[s.n] = pa;
    s.pb[s.n] = pb;
    s.n = s.n + 1usize;
    let cl = reduceSimplex(&mut s);
    v = cl.v;
    lam = cl.lam;
    if cl.inside { hit = true; break; }
  }
  // Stopped with the nearest point within the rounding of the difference's own size
  // (about 3e-5 of its largest vertex, the f32 floor of a long sliver simplex): it cannot
  // be told from the origin, so the cores overlap or touch and EPA decides
  var borderline = false;
  if !hit && !far && v.lengthSquared() <= 1.0e-9 * wmax2 { hit = true; borderline = true; }
  // The weights belonging to the simplex that reduced to v
  var pa = Vec3(0., 0., 0.);
  var pb = Vec3(0., 0., 0.);
  var i = 0usize;
  while i < s.n {
    pa = pa + s.pa[i] * lam[i];
    pb = pb + s.pb[i] * lam[i];
    i = i + 1usize;
  }
  GjkResult(hit, far, v.length(), pa, pb, s, borderline)
}

// ---------------------------------------------------------------------------
// EPA

struct EFace {
  i: usize;
  j: usize;
  k: usize;
  n: Vec3;
  dist: f32;
  alive: bool;
}

fn makeEFace(w: &List[Vec3], i: usize, j: usize, k: usize) EFace {
  let wi = *w[i];
  let c = (*w[j] - wi).cross(*w[k] - wi);
  let l = c.length();
  if l < 1.0e-12 { return EFace(i, j, k, Vec3(1., 0., 0.), 0., false); }
  let n = c * (1. / l);
  EFace(i, j, k, n, maxf(n.dot(wi), 0.), true)
}

// What EPA found: the direction of least penetration (the face of A - B
// nearest the origin, pointing outward from the difference, so B lies that
// way from A), the depth of the cores' overlap, and the deepest points on
// each core
pub struct EpaResult {
  pub ok: bool;
  pub normal: Vec3;
  pub depth: f32;
  pub pa: Vec3;
  pub pb: Vec3;
}

// Grow a simplex (1 to 4 vertices holding the origin) into a tetrahedron
// around the origin by asking for supports in fixed directions
fn completeSimplex(a: &Prim, xa: Rigid, b: &Prim, xb: Rigid, s: &mut Simplex) bool {
  var tries = 0usize;
  while s.n < 4usize && tries < 14usize {
    var d = Vec3(1., 0., 0.);
    let t = tries % 7usize;
    if t == 1usize { d = Vec3(-1., 0., 0.); }
    if t == 2usize { d = Vec3(0., 1., 0.); }
    if t == 3usize { d = Vec3(0., -1., 0.); }
    if t == 4usize { d = Vec3(0., 0., 1.); }
    if t == 5usize { d = Vec3(0., 0., -1.); }
    if t == 6usize { d = Vec3(0.577, 0.577, 0.577); }
    if tries >= 7usize { d = -d + Vec3(0.1, 0.2, 0.3); }
    tries = tries + 1usize;
    let pa = supportWorld(a, xa, d);
    let pb = supportWorld(b, xb, -d);
    let w = pa - pb;
    var ok = false;
    if s.n == 1usize { ok = (w - s.w[0usize]).lengthSquared() > 1.0e-8; }
    if s.n == 2usize { ok = (s.w[1usize] - s.w[0usize]).cross(w - s.w[0usize]).lengthSquared() > 1.0e-10; }
    if s.n == 3usize {
      let nrm = (s.w[1usize] - s.w[0usize]).cross(s.w[2usize] - s.w[0usize]);
      ok = absf(nrm.dot(w - s.w[0usize])) > 1.0e-8;
    }
    if ok {
      s.w[s.n] = w; s.pa[s.n] = pa; s.pb[s.n] = pb;
      s.n = s.n + 1usize;
    }
  }
  s.n == 4usize
}

// EPA from the simplex GJK ended in. Fails (ok false) if no tetrahedron round
// the origin can be built, as when a core is flat and the shapes only touch.
pub fn epa(a: &Prim, xa: Rigid, b: &Prim, xb: Rigid, start: Simplex) EpaResult {
  var s = start;
  let none = EpaResult(false, Vec3(0., 1., 0.), 0., Vec3(0., 0., 0.), Vec3(0., 0., 0.));
  if !completeSimplex(a, xa, b, xb, &mut s) { return none; }
  var w = List[Vec3].empty();
  var pas = List[Vec3].empty();
  var pbs = List[Vec3].empty();
  var i = 0usize;
  while i < 4usize { w.push(s.w[i]); pas.push(s.pa[i]); pbs.push(s.pb[i]); i = i + 1usize; }
  var faces = List[EFace].empty();
  // The four faces, each wound so its normal points away from the vertex it leaves out
  var f = 0usize;
  while f < 4usize {
    let l = f;
    let p = (f + 1usize) % 4usize;
    let q = (f + 2usize) % 4usize;
    let r = (f + 3usize) % 4usize;
    var fc = makeEFace(&w, p, q, r);
    if fc.n.dot(*w[l] - *w[p]) > 0. { fc = makeEFace(&w, p, r, q); }
    faces.push(fc);
    f = f + 1usize;
  }
  var best = 0usize;
  var lastDist = 0.f;
  var chosen = *faces[0usize];
  var iter = 0u32;
  while iter < 96u32 {
    iter = iter + 1u32;
    // Nearest live face
    var bd = bigNumber;
    i = 0usize;
    while i < faces.len() {
      let fc = faces[i];
      if fc.alive && fc.dist < bd { bd = fc.dist; best = i; }
      i = i + 1usize;
    }
    if bd == bigNumber { return none; }
    let bf = *faces[best];
    // The nearest face can only move away from the origin; if it moves back, rounding has
    // broken a sliver face (a curved core such as a cylinder's rim creeps in ever
    // smaller steps): stop with the last good face
    if bd < lastDist - 2.0e-4 { break; }
    lastDist = bd;
    chosen = bf;
    let pa = supportWorld(a, xa, bf.n);
    let pb = supportWorld(b, xb, -bf.n);
    let nw = pa - pb;
    if nw.dot(bf.n) - bf.dist < 2.0e-4 * (1. + bf.dist) { break; }
    // Remove the faces the new vertex sees; the edges between seen and unseen get new faces
    var visible = List[usize].empty();
    i = 0usize;
    while i < faces.len() {
      let fc = faces[i];
      if fc.alive && fc.n.dot(nw) - fc.dist > 1.0e-7 { visible.push(i); }
      i = i + 1usize;
    }
    if visible.len() == 0usize { break; }
    let vi = w.len();
    w.push(nw); pas.push(pa); pbs.push(pb);
    var ha = List[usize].empty();
    var hb = List[usize].empty();
    var k = 0usize;
    while k < visible.len() {
      let fc = *faces[*visible[k]];
      var e = 0usize;
      while e < 3usize {
        let ea = if e == 0usize { fc.i } else if e == 1usize { fc.j } else { fc.k };
        let eb = if e == 0usize { fc.j } else if e == 1usize { fc.k } else { fc.i };
        var shared = false;
        var m = 0usize;
        while m < visible.len() {
          if m != k {
            let go = faces[*visible[m]];
            if (go.i == eb && go.j == ea) || (go.j == eb && go.k == ea) || (go.k == eb && go.i == ea) { shared = true; }
          }
          m = m + 1usize;
        }
        if !shared { ha.push(ea); hb.push(eb); }
        e = e + 1usize;
      }
      k = k + 1usize;
    }
    k = 0usize;
    while k < visible.len() {
      let idx = *visible[k];
      var fc = *faces[idx];
      fc.alive = false;
      faces.set(idx, fc);
      k = k + 1usize;
    }
    k = 0usize;
    while k < ha.len() {
      faces.push(makeEFace(&w, *ha[k], *hb[k], vi));
      k = k + 1usize;
    }
  }
  let bf = chosen;
  // The origin's projection on the face, as weights of its three corners
  let p = bf.n * bf.dist;
  let a0 = *w[bf.i];
  let e1 = *w[bf.j] - a0;
  let e2 = *w[bf.k] - a0;
  let d00 = e1.dot(e1);
  let d01 = e1.dot(e2);
  let d11 = e2.dot(e2);
  let d20 = (p - a0).dot(e1);
  let d21 = (p - a0).dot(e2);
  let den = d00 * d11 - d01 * d01;
  var lv = 0.f;
  var lw = 0.f;
  if absf(den) > 1.0e-20 {
    lv = (d11 * d20 - d01 * d21) / den;
    lw = (d00 * d21 - d01 * d20) / den;
  }
  let lu = 1. - lv - lw;
  let ca = *pas[bf.i] * lu + *pas[bf.j] * lv + *pas[bf.k] * lw;
  let cb = *pbs[bf.i] * lu + *pbs[bf.j] * lv + *pbs[bf.k] * lw;
  EpaResult(true, bf.n, bf.dist, ca, cb)
}

// ---------------------------------------------------------------------------
// The rounded shapes together

// The closest approach or overlap of two convex prims, rounding included.
// 'depth' is positive when they overlap and negative by the gap when apart
// (never reported beyond 'maxGap'). The normal points from a to b; pointA and
// pointB are on the two surfaces.
pub struct Penetration {
  pub hit: bool;
  pub normal: Vec3;
  pub depth: f32;
  pub pointA: Vec3;
  pub pointB: Vec3;
}

pub fn convexPenetration(a: &Prim, xa: Rigid, b: &Prim, xb: Rigid, maxGap: f32) Penetration {
  let ra = a.coreRadius();
  let rb = b.coreRadius();
  let miss = Penetration(false, Vec3(0., 1., 0.), 0., Vec3(0., 0., 0.), Vec3(0., 0., 0.));
  let g = gjk(a, xa, b, xb, ra + rb + maxGap);
  if g.far { return miss; }
  if !g.intersect {
    if g.dist > ra + rb + maxGap { return miss; }
    // pa - pb is the vector from b's core point to a's; the normal runs the other way
    let nrm = (g.pb - g.pa).normalize();
    return Penetration(true, nrm, ra + rb - g.dist, g.pa + nrm * ra, g.pb - nrm * rb);
  }
  let e = epa(a, xa, b, xb, g.simplex);
  if e.ok {
    // The cores cannot overlap by more than their widths together along the normal; a depth
    // beyond that is EPA having lost its way on a thin or very large core (one box on a flat
    // triangle came out 2.7 m deep when the box is 0.87 m across)
    let wid = coreWidth(a, xa, e.normal) + coreWidth(b, xb, e.normal);
    if e.depth <= wid + 1.0e-3 * wid + 1.0e-4 {
      return Penetration(true, e.normal, e.depth + ra + rb, e.pa + e.normal * ra, e.pb - e.normal * rb);
    }
  }
  if g.borderline {
    // too close to tell touching from overlapping, and EPA has no polytope to grow: a touch
    let nrm = (g.pb - g.pa).normalize();
    return Penetration(true, nrm, ra + rb - g.dist, g.pa + nrm * ra, g.pb - nrm * rb);
  }
  penetrationByAxes(a, xa, b, xb, e, ra, rb)
}

// How far the core of p, placed by x, reaches along unit n, from its farthest point to its nearest
fn coreWidth(p: &Prim, x: Rigid, n: Vec3) f32 {
  supportWorld(p, x, n).dot(n) + supportWorld(p, x, -n).dot(-n)
}

// The fallback when EPA fails: the least overlap of the two cores along a few candidate axes
// (the separating axis idea; every axis gives an upper bound of the true depth, and the
// best of the triangle's normal, EPA's own direction, the line between the shapes and the
// world axes is right for the flat, large and symmetric cases that defeat EPA). No overlap
// along some axis means the shapes are apart.
fn penetrationByAxes(a: &Prim, xa: Rigid, b: &Prim, xb: Rigid, e: EpaResult, ra: f32, rb: f32) Penetration {
  let miss = Penetration(false, Vec3(0., 1., 0.), 0., Vec3(0., 0., 0.), Vec3(0., 0., 0.));
  var axes = Array[Vec3, 8]() <- fill Vec3(0., 1., 0.);
  var na = 0usize;
  if a.kind == KTriangle {
    axes[na] = xa.rotate((a.b - a.a).cross(a.c - a.a)).normalize(); na = na + 1usize;
  }
  if b.kind == KTriangle {
    axes[na] = xb.rotate((b.b - b.a).cross(b.c - b.a)).normalize(); na = na + 1usize;
  }
  if e.ok { axes[na] = e.normal; na = na + 1usize; }
  let between = xb.pos - xa.pos;
  if between.lengthSquared() > 1.0e-10 { axes[na] = between.normalize(); na = na + 1usize; }
  axes[na] = Vec3(0., 1., 0.); na = na + 1usize;
  axes[na] = Vec3(1., 0., 0.); na = na + 1usize;
  axes[na] = Vec3(0., 0., 1.); na = na + 1usize;
  var best = bigNumber;
  var bestN = Vec3(0., 1., 0.);
  var k = 0usize;
  while k < na {
    var s = 0;
    while s < 2 {
      let n = if s == 0 { axes[k] } else { -axes[k] };
      // the overlap pushing B along n: A's far side past B's near side
      let depth = supportWorld(a, xa, n).dot(n) - supportWorld(b, xb, -n).dot(n);
      if depth < best { best = depth; bestN = n; }
      s = s + 1;
    }
    k = k + 1usize;
  }
  if best < -1.0e-4 { return miss; }
  let pa = supportWorld(a, xa, bestN);
  let pb = supportWorld(b, xb, -bestN);
  Penetration(true, bestN, best + ra + rb, pa + bestN * ra, pb - bestN * rb)
}
