// GJK distance and EPA penetration depth.
//
// GJK (Gilbert, Johnson and Keerthi 1988, in the form of van den Bergen,
// "A Fast and Robust GJK Implementation", and Ericson, Real-Time Collision
// Detection 9.5) walks the Minkowski difference A - B towards the origin. As in
// Jolt, it works on the shapes' cores (a sphere is a point, a capsule a
// segment) and the rounding is added back afterwards, which keeps the
// penetration problem away from smooth surfaces.
//
// EPA (van den Bergen, "Proximity Queries and Penetration Depth", 2001) grows
// the simplex GJK ended with, when the cores overlap, into a polytope whose
// face nearest the origin is the penetration.
//
// Everything is in world space: each shape comes with its Rigid.

// A simplex of the Minkowski difference A - B: each vertex w = pa - pb, with
// the points on the cores it came from
pub struct Simplex {
  pub n usize;
  pub w Array[Vec3, 4];
  pub pa Array[Vec3, 4];
  pub pb Array[Vec3, 4];
}

pub fn supportWorld(p &Prim, x Rigid, dir Vec3) Vec3 {
  x.apply(p.supportCore(x.unrotate(dir)));
}

// What GJK found. 'intersect': the cores overlap (EPA's job next). Otherwise
// pa and pb are the closest points of the cores and 'dist' their distance;
// 'far': stopped early because the cores are certainly farther apart than the
// limit asked for
pub struct GjkResult {
  pub intersect bool;
  pub far bool;
  pub dist f32;
  pub pa Vec3;
  pub pb Vec3;
  pub simplex Simplex;
}

struct SimplexPoint {
  v Vec3;
  inside bool;
  lam Array[f32, 4];
}

// Barycentric weights of the point of triangle a, b, c nearest the origin
// (Ericson 5.1.5, the origin as the query point)
fn triWeights(a Vec3, b Vec3, c Vec3) Array[f32, 3] {
  imm ab = b - a;
  imm ac = c - a;
  imm d1 = ab.dot(-a);
  imm d2 = ac.dot(-a);
  if d1 <= 0. and d2 <= 0. { return [1., 0., 0.]; }
  imm d3 = ab.dot(-b);
  imm d4 = ac.dot(-b);
  if d3 >= 0. and d4 <= d3 { return [0., 1., 0.]; }
  imm vc = d1 * d4 - d3 * d2;
  if vc <= 0. and d1 >= 0. and d3 <= 0. {
    imm v = d1 / (d1 - d3);
    return [1. - v, v, 0.];
  }
  imm d5 = ab.dot(-c);
  imm d6 = ac.dot(-c);
  if d6 >= 0. and d5 <= d6 { return [0., 0., 1.]; }
  imm vb = d5 * d2 - d1 * d6;
  if vb <= 0. and d2 >= 0. and d6 <= 0. {
    imm w = d2 / (d2 - d6);
    return [1. - w, 0., w];
  }
  imm va = d3 * d6 - d5 * d4;
  if va <= 0. and (d4 - d3) >= 0. and (d5 - d6) >= 0. {
    imm w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
    return [0., 1. - w, w];
  }
  imm sum = va + vb + vc;
  if absf(sum) < 1.0e-30 { return [1., 0., 0.]; }
  imm denom = 1. / sum;
  imm v = vb * denom;
  imm w = vc * denom;
  [1. - v - w, v, w];
}

fn segWeights(a Vec3, b Vec3) Array[f32, 2] {
  imm ab = b - a;
  imm l2 = ab.dot(ab);
  if l2 < 1.0e-30 { return [1., 0.]; }
  imm t = clampf(-a.dot(ab) / l2, 0., 1.);
  [1. - t, t];
}

// The point of the simplex nearest the origin, with the simplex cut down to
// the vertices that support it (weight zero vertices dropped)
fn reduceSimplex(s &mut Simplex) SimplexPoint {
  mut lam = [0., 0., 0., 0.];
  mut inside = false;
  if s.n == 1usize {
    lam[0usize] = 1.;
  } else if s.n == 2usize {
    imm t = segWeights(s.w[0usize], s.w[1usize]);
    lam[0usize] = t[0usize]; lam[1usize] = t[1usize];
  } else if s.n == 3usize {
    imm t = triWeights(s.w[0usize], s.w[1usize], s.w[2usize]);
    lam[0usize] = t[0usize]; lam[1usize] = t[1usize]; lam[2usize] = t[2usize];
  } else {
    // Tetrahedron: the origin is inside if on the inner side of every face,
    // else the nearest of the faces it is outside of
    mut bestD = bigNumber;
    mut f = 0usize;
    while f < 4usize {
      // face (i, j, k) with the opposite vertex l
      imm l = f;
      imm i = (f + 1usize) % 4usize;
      imm j = (f + 2usize) % 4usize;
      imm k = (f + 3usize) % 4usize;
      imm wi = s.w[i];
      imm nrm = (s.w[j] - wi).cross(s.w[k] - wi);
      imm so = nrm.dot(-wi);
      imm sl = nrm.dot(s.w[l] - wi);
      // A nearly flat tetrahedron cannot hold the origin: every face is a candidate
      imm flat = absf(sl) <= 1.0e-5 * nrm.length() * (s.w[l] - wi).length();
      if flat or (so * sl <= 0. and not (so == 0. and sl != 0.)) {
        imm t = triWeights(wi, s.w[j], s.w[k]);
        imm p = wi * t[0usize] + s.w[j] * t[1usize] + s.w[k] * t[2usize];
        imm d = p.lengthSquared();
        if d < bestD {
          bestD = d;
          lam = [0., 0., 0., 0.];
          lam[i] = t[0usize]; lam[j] = t[1usize]; lam[k] = t[2usize];
        }
      }
      f = f + 1usize;
    }
    if bestD == bigNumber {
      inside = true;
      lam = [0.25, 0.25, 0.25, 0.25];
    }
  }
  // Keep the supporting vertices
  mut out = new Simplex(0usize, s.w, s.pa, s.pb);
  mut v = new Vec3(0., 0., 0.);
  mut i = 0usize;
  while i < s.n {
    if lam[i] > 0. or inside {
      out.w[out.n] = s.w[i];
      out.pa[out.n] = s.pa[i];
      out.pb[out.n] = s.pb[i];
      lam[out.n] = lam[i];
      out.n = out.n + 1usize;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < out.n { v = v + out.w[i] * lam[i]; i = i + 1usize; }
  *s = out;
  new SimplexPoint(v, inside, lam);
}

// GJK on the cores of a and b. Stops early ('far') when the cores are
// certainly more than 'maxDist' apart.
pub fn gjk(a &Prim, xa Rigid, b &Prim, xb Rigid, maxDist f32) GjkResult {
  mut s = new Simplex(1usize, [new Vec3(0., 0., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., 0.)],
    [new Vec3(0., 0., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., 0.)],
    [new Vec3(0., 0., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., 0.)]);
  mut dir0 = xb.pos - xa.pos;
  if dir0.lengthSquared() < 1.0e-12 { dir0 = new Vec3(1., 0., 0.); }
  s.pa[0usize] = supportWorld(a, xa, dir0);
  s.pb[0usize] = supportWorld(b, xb, -dir0);
  s.w[0usize] = s.pa[0usize] - s.pb[0usize];
  mut v = s.w[0usize];
  mut lam = [1., 0., 0., 0.];
  mut iter = 0u32;
  mut hit = false;
  mut far = false;
  while iter < 64u32 {
    iter = iter + 1u32;
    imm v2 = v.lengthSquared();
    if v2 < 1.0e-12 { hit = true; break; }
    imm dir = -v;
    imm pa = supportWorld(a, xa, dir);
    imm pb = supportWorld(b, xb, -dir);
    imm w = pa - pb;
    imm vw = v.dot(w);
    // The plane through w perpendicular to v separates the origin from the
    // difference: the distance is at least vw / |v|
    if vw > 0. and vw * vw > maxDist * maxDist * v2 { far = true; break; }
    if v2 - vw <= 1.0e-6 * v2 + 1.0e-10 { break; }
    // a vertex already in the simplex means no progress
    mut dup = false;
    mut i = 0usize;
    while i < s.n {
      if (s.w[i] - w).lengthSquared() < 1.0e-12 { dup = true; }
      i = i + 1usize;
    }
    if dup { break; }
    s.w[s.n] = w;
    s.pa[s.n] = pa;
    s.pb[s.n] = pb;
    s.n = s.n + 1usize;
    imm cl = reduceSimplex(&mut s);
    v = cl.v;
    lam = cl.lam;
    if cl.inside { hit = true; break; }
  }
  // The weights belonging to the simplex that reduced to v
  mut pa = new Vec3(0., 0., 0.);
  mut pb = new Vec3(0., 0., 0.);
  mut i = 0usize;
  while i < s.n {
    pa = pa + s.pa[i] * lam[i];
    pb = pb + s.pb[i] * lam[i];
    i = i + 1usize;
  }
  new GjkResult(hit, far, v.length(), pa, pb, s);
}

// ---------------------------------------------------------------------------
// EPA

struct EFace {
  i usize;
  j usize;
  k usize;
  n Vec3;
  dist f32;
  alive bool;
}

fn makeEFace(w &List[Vec3], i usize, j usize, k usize) EFace {
  imm wi = *w[i];
  imm c = (*w[j] - wi).cross(*w[k] - wi);
  imm l = c.length();
  if l < 1.0e-12 { return new EFace(i, j, k, new Vec3(1., 0., 0.), 0., false); }
  imm n = c * (1. / l);
  new EFace(i, j, k, n, maxf(n.dot(wi), 0.), true);
}

// What EPA found: the direction of least penetration (the face of A - B
// nearest the origin, pointing outward from the difference, so B lies that
// way from A), the depth of the cores' overlap, and the deepest points on
// each core
pub struct EpaResult {
  pub ok bool;
  pub normal Vec3;
  pub depth f32;
  pub pa Vec3;
  pub pb Vec3;
}

// Grow a simplex (1 to 4 vertices holding the origin) into a tetrahedron
// around the origin by asking for supports in fixed directions
fn completeSimplex(a &Prim, xa Rigid, b &Prim, xb Rigid, s &mut Simplex) bool {
  mut tries = 0usize;
  while s.n < 4usize and tries < 14usize {
    mut d = new Vec3(1., 0., 0.);
    imm t = tries % 7usize;
    if t == 1usize { d = new Vec3(-1., 0., 0.); }
    if t == 2usize { d = new Vec3(0., 1., 0.); }
    if t == 3usize { d = new Vec3(0., -1., 0.); }
    if t == 4usize { d = new Vec3(0., 0., 1.); }
    if t == 5usize { d = new Vec3(0., 0., -1.); }
    if t == 6usize { d = new Vec3(0.577, 0.577, 0.577); }
    if tries >= 7usize { d = -d + new Vec3(0.1, 0.2, 0.3); }
    tries = tries + 1usize;
    imm pa = supportWorld(a, xa, d);
    imm pb = supportWorld(b, xb, -d);
    imm w = pa - pb;
    mut ok = false;
    if s.n == 1usize { ok = (w - s.w[0usize]).lengthSquared() > 1.0e-8; }
    if s.n == 2usize { ok = (s.w[1usize] - s.w[0usize]).cross(w - s.w[0usize]).lengthSquared() > 1.0e-10; }
    if s.n == 3usize {
      imm nrm = (s.w[1usize] - s.w[0usize]).cross(s.w[2usize] - s.w[0usize]);
      ok = absf(nrm.dot(w - s.w[0usize])) > 1.0e-8;
    }
    if ok {
      s.w[s.n] = w; s.pa[s.n] = pa; s.pb[s.n] = pb;
      s.n = s.n + 1usize;
    }
  }
  s.n == 4usize;
}

// EPA from the simplex GJK ended in. Fails (ok false) if no tetrahedron round
// the origin can be built, as when a core is flat and the shapes only touch.
pub fn epa(a &Prim, xa Rigid, b &Prim, xb Rigid, start Simplex) EpaResult {
  mut s = start;
  imm none = new EpaResult(false, new Vec3(0., 1., 0.), 0., new Vec3(0., 0., 0.), new Vec3(0., 0., 0.));
  if not completeSimplex(a, xa, b, xb, &mut s) { return none; }
  mut w = List[Vec3].empty();
  mut pas = List[Vec3].empty();
  mut pbs = List[Vec3].empty();
  mut i = 0usize;
  while i < 4usize { w.push(s.w[i]); pas.push(s.pa[i]); pbs.push(s.pb[i]); i = i + 1usize; }
  mut faces = List[EFace].empty();
  // The four faces, each wound so its normal points away from the vertex it leaves out
  mut f = 0usize;
  while f < 4usize {
    imm l = f;
    imm p = (f + 1usize) % 4usize;
    imm q = (f + 2usize) % 4usize;
    imm r = (f + 3usize) % 4usize;
    mut fc = makeEFace(&w, p, q, r);
    if fc.n.dot(*w[l] - *w[p]) > 0. { fc = makeEFace(&w, p, r, q); }
    faces.push(fc);
    f = f + 1usize;
  }
  mut best = 0usize;
  mut lastDist = 0.;
  mut chosen = *faces[0usize];
  mut iter = 0u32;
  while iter < 96u32 {
    iter = iter + 1u32;
    // Nearest live face
    mut bd = bigNumber;
    i = 0usize;
    while i < faces.len() {
      imm fc = faces[i];
      if fc.alive and fc.dist < bd { bd = fc.dist; best = i; }
      i = i + 1usize;
    }
    if bd == bigNumber { return none; }
    imm bf = *faces[best];
    // The nearest face can only move away from the origin; if it moves back, rounding has
    // broken a sliver face (a curved core such as a cylinder's rim creeps in ever
    // smaller steps): stop with the last good face
    if bd < lastDist - 2.0e-4 { break; }
    lastDist = bd;
    chosen = bf;
    imm pa = supportWorld(a, xa, bf.n);
    imm pb = supportWorld(b, xb, -bf.n);
    imm nw = pa - pb;
    if nw.dot(bf.n) - bf.dist < 2.0e-4 * (1. + bf.dist) { break; }
    // Remove the faces the new vertex sees; the edges between seen and unseen get new faces
    mut visible = List[usize].empty();
    i = 0usize;
    while i < faces.len() {
      imm fc = faces[i];
      if fc.alive and fc.n.dot(nw) - fc.dist > 1.0e-7 { visible.push(i); }
      i = i + 1usize;
    }
    if visible.len() == 0usize { break; }
    imm vi = w.len();
    w.push(nw); pas.push(pa); pbs.push(pb);
    mut ha = List[usize].empty();
    mut hb = List[usize].empty();
    mut k = 0usize;
    while k < visible.len() {
      imm fc = *faces[*visible[k]];
      mut e = 0usize;
      while e < 3usize {
        imm ea = if e == 0usize { fc.i; } else if e == 1usize { fc.j; } else { fc.k; };
        imm eb = if e == 0usize { fc.j; } else if e == 1usize { fc.k; } else { fc.i; };
        mut shared = false;
        mut m = 0usize;
        while m < visible.len() {
          if m != k {
            imm go = faces[*visible[m]];
            if (go.i == eb and go.j == ea) or (go.j == eb and go.k == ea) or (go.k == eb and go.i == ea) { shared = true; }
          }
          m = m + 1usize;
        }
        if not shared { ha.push(ea); hb.push(eb); }
        e = e + 1usize;
      }
      k = k + 1usize;
    }
    k = 0usize;
    while k < visible.len() {
      imm idx = *visible[k];
      mut fc = *faces[idx];
      fc.alive = false;
      faces.set(idx, fc);
      k = k + 1usize;
    }
    k = 0usize;
    while k < ha.len() {
      faces.push(makeEFace(&w, *ha[k], *hb[k], vi));
      k = k + 1usize;
    }
  }
  imm bf = chosen;
  // The origin's projection on the face, as weights of its three corners
  imm p = bf.n * bf.dist;
  imm a0 = *w[bf.i];
  imm e1 = *w[bf.j] - a0;
  imm e2 = *w[bf.k] - a0;
  imm d00 = e1.dot(e1);
  imm d01 = e1.dot(e2);
  imm d11 = e2.dot(e2);
  imm d20 = (p - a0).dot(e1);
  imm d21 = (p - a0).dot(e2);
  imm den = d00 * d11 - d01 * d01;
  mut lv = 0.;
  mut lw = 0.;
  if absf(den) > 1.0e-20 {
    lv = (d11 * d20 - d01 * d21) / den;
    lw = (d00 * d21 - d01 * d20) / den;
  }
  imm lu = 1. - lv - lw;
  imm ca = *pas[bf.i] * lu + *pas[bf.j] * lv + *pas[bf.k] * lw;
  imm cb = *pbs[bf.i] * lu + *pbs[bf.j] * lv + *pbs[bf.k] * lw;
  new EpaResult(true, bf.n, bf.dist, ca, cb);
}

// ---------------------------------------------------------------------------
// The rounded shapes together

// The closest approach or overlap of two convex prims, rounding included.
// 'depth' is positive when they overlap and negative by the gap when apart
// (never reported beyond 'maxGap'). The normal points from a to b; pointA and
// pointB are on the two surfaces.
pub struct Penetration {
  pub hit bool;
  pub normal Vec3;
  pub depth f32;
  pub pointA Vec3;
  pub pointB Vec3;
}

pub fn convexPenetration(a &Prim, xa Rigid, b &Prim, xb Rigid, maxGap f32) Penetration {
  imm ra = a.coreRadius();
  imm rb = b.coreRadius();
  imm miss = new Penetration(false, new Vec3(0., 1., 0.), 0., new Vec3(0., 0., 0.), new Vec3(0., 0., 0.));
  imm g = gjk(a, xa, b, xb, ra + rb + maxGap);
  if g.far { return miss; }
  if not g.intersect {
    if g.dist > ra + rb + maxGap { return miss; }
    // pa - pb is the vector from b's core point to a's; the normal runs the other way
    imm nrm = (g.pb - g.pa).normalize();
    return new Penetration(true, nrm, ra + rb - g.dist, g.pa + nrm * ra, g.pb - nrm * rb);
  }
  imm e = epa(a, xa, b, xb, g.simplex);
  if not e.ok { return miss; }
  new Penetration(true, e.normal, e.depth + ra + rb, e.pa + e.normal * ra, e.pb - e.normal * rb);
}
