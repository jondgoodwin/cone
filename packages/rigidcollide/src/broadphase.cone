// The broad phase: which pairs of boxes overlap.
//
// 'BroadPhase' is the interface a world uses, so the structure behind it can
// be swapped (a dynamic AABB tree from the spatial-index package, say). A body
// is a proxy: the caller's id (a body number), a box, a layer and a mask, and
// whether it never moves. Two proxies make a pair when their boxes overlap,
// each is on a layer the other's mask accepts, and they are not both static
// (Jolt's cascade, cheapest test first, reduced to layer, mask and motion).
//
// Results are deterministic: pairs come out sorted by (low id, high id), and
// the id lists of a query in ascending order.

// A pair of body ids, 'a' the lower
pub struct BodyPair {
  pub a: u32;
  pub b: u32;
}

pub trait BroadPhase {
  // Add a body (its id must not be in use)
  pub fn add(self: &mut, id: u32, box: Aabb3, layer: u32, mask: u32, isStatic: bool);
  // The body moved or changed size: its new box
  pub fn update(self: &mut, id: u32, box: Aabb3);
  pub fn remove(self: &mut, id: u32);
  // Every overlapping pair, sorted
  pub fn pairs(self: &mut, out: &mut List[BodyPair]);
  // Ids of bodies whose boxes overlap 'box' and that accept 'layer' (any layer with mask bit set)
  pub fn queryBox(self: &mut, box: Aabb3, mask: u32, out: &mut List[u32]);
  // Ids of bodies whose boxes a ray (origin, dir, up to maxT) crosses
  pub fn queryRay(self: &mut, origin: Vec3, dir: Vec3, maxT: f32, mask: u32, out: &mut List[u32]);
}

struct Proxy {
  id: u32;
  box: Aabb3;
  layer: u32;
  mask: u32;
  isStatic: bool;
}

// The live proxies, one per body that has been added and not removed
alias Proxies = GenPool[Proxy];

struct SortKey {
  key: f32;
  id: u32;
}

fn byKey(a: &SortKey, b: &SortKey) i32 {
  if a.key < b.key { -1i32 } else if a.key > b.key { 1i32 } else if a.id < b.id { -1i32 } else if a.id > b.id { 1i32 } else { 0i32 }
}

fn byPair(a: &BodyPair, b: &BodyPair) i32 {
  if a.a < b.a { -1i32 } else if a.a > b.a { 1i32 } else if a.b < b.b { -1i32 } else if a.b > b.b { 1i32 } else { 0i32 }
}

// Sweep and prune (Baraff 1992; Bullet's btAxisSweep3, ODE's quickspace):
// sort the boxes along the axis they spread over most, and compare each box
// with the following ones only while their intervals on that axis overlap.
// 'slots' maps a body id to its proxy's handle, so ids should be small and
// dense, as body numbers are; the proxies themselves sit in a pool, and the
// sweeps walk the live ones only (a pool does not hand back the ids in
// order, so the queries sort what they find).
pub struct SweepAndPrune is Default, BroadPhase {
  proxies: Proxies;
  slots: List[Handle];   // a body id's proxy, Handle.none() if it has none

  pub fn init(self: &new) { *self = SweepAndPrune(Proxies(), List[Handle]()); }

  pub fn len(self: &) usize { proxies.len() }

  fn handleOf(self: &, id: u32) Handle {
    let i = usize.from(id);
    if i < slots.len() { *slots[i] } else { Handle.none() }
  }

  pub fn add(self: &mut, id: u32, box: Aabb3, layer: u32, mask: u32, isStatic: bool) {
    let i = usize.from(id);
    while slots.len() <= i {
      slots.push(Handle.none());
    }
    proxies.remove(*slots[i]);
    slots.set(i, proxies.add(Proxy(id, box, layer, mask, isStatic)));
  }

  pub fn update(self: &mut, id: u32, box: Aabb3) {
    match proxies.borrowMut(self.handleOf(id)) {
      case let Some(p) { p.box = box; }
      else {}
    }
  }

  pub fn remove(self: &mut, id: u32) {
    if proxies.remove(self.handleOf(id)) { slots.set(usize.from(id), Handle.none()); }
  }

  fn axisOf(self: &) usize {
    // the axis along which the box centres vary most
    var sum = Vec3(0., 0., 0.);
    var sq = Vec3(0., 0., 0.);
    var n = 0.f;
    var it = proxies.iter();
    while true {
      match it.next() {
        case let Some(p) {
          let c = p.box.center();
          sum = sum + c;
          sq = sq + c * c;
          n = n + 1.;
        }
        case is None { break; }
      }
    }
    if n < 2. { return 0usize; }
    let mean = sum * (1. / n);
    let vr = sq * (1. / n) - mean * mean;
    var ax = 0usize;
    if vr.y > vecGet(vr, ax) { ax = 1usize; }
    if vr.z > vecGet(vr, ax) { ax = 2usize; }
    ax
  }

  pub fn pairs(self: &mut, out: &mut List[BodyPair]) {
    out.clear();
    let ax = axisOf();
    var keys = List[SortKey]();
    var it = proxies.iter();
    while true {
      match it.next() {
        case let Some(p) { keys.push(SortKey(vecGet(p.box.min, ax), p.id)); }
        case is None { break; }
      }
    }
    keys.sortBy(&byKey);
    var i = 0usize;
    while i < keys.len() {
      let pa = *proxies.borrow(self.handleOf(keys[i].id)).unwrap();
      let maxA = vecGet(pa.box.max, ax);
      var j = i + 1usize;
      while j < keys.len() && keys[j].key <= maxA {
        let idB = keys[j].id;
        let pb = *proxies.borrow(self.handleOf(idB)).unwrap();
        if (!(pa.isStatic && pb.isStatic)) && (pa.layer & pb.mask) != 0u32 && (pb.layer & pa.mask) != 0u32
            && pa.box.overlaps(pb.box) {
          let idA = keys[i].id;
          if idA < idB { out.push(BodyPair(idA, idB)); } else { out.push(BodyPair(idB, idA)); }
        }
        j = j + 1usize;
      }
      i = i + 1usize;
    }
    out.sortBy(&byPair);
  }

  pub fn queryBox(self: &mut, box: Aabb3, mask: u32, out: &mut List[u32]) {
    out.clear();
    var it = proxies.iter();
    while true {
      match it.next() {
        case let Some(p) {
          if (p.layer & mask) != 0u32 && p.box.overlaps(box) { out.push(p.id); }
        }
        case is None { break; }
      }
    }
    out.sort();
  }

  pub fn queryRay(self: &mut, origin: Vec3, dir: Vec3, maxT: f32, mask: u32, out: &mut List[u32]) {
    out.clear();
    let inv = Vec3(if dir.x.abs() > 1.0e-20 { 1. / dir.x } else { 1.0e20 }, if dir.y.abs() > 1.0e-20 { 1. / dir.y } else { 1.0e20 },
                       if dir.z.abs() > 1.0e-20 { 1. / dir.z } else { 1.0e20 });
    var it = proxies.iter();
    while true {
      match it.next() {
        case let Some(p) {
          if (p.layer & mask) != 0u32 {
            if rayBoxEnter(origin, inv, p.box.min, p.box.max, maxT) < bigNumber { out.push(p.id); }
          }
        }
        case is None { break; }
      }
    }
    out.sort();
  }
}
