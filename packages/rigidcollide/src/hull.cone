// Quickhull (Barber, Dobkin and Huhdanpaa, "The Quickhull Algorithm for
// Convex Hulls", 1996): the convex hull of a cloud of points, as a Prim of
// polygon faces (coplanar triangles merged back into one face, so a box's
// eight corners give six quads, which face clipping needs).

struct QFace {
  a: usize;
  b: usize;
  c: usize;
  normal: Vec3;
  d: f32;
  alive: bool;
}

fn makeQFace(pts: &Array[Vec3], a: usize, b: usize, c: usize) QFace {
  let pa = pts[a];
  let n = (pts[b] - pa).cross(pts[c] - pa).normalize();
  QFace(a, b, c, n, n.dot(pa), true)
}

// The hull of 'pts'. If the points are flat or fewer than four, the result
// has no faces (check 'faces.len() > 0').
pub fn convexHull(pts: &Array[Vec3]) Prim {
  let n = pts.len;
  var out = Prim.blank(KHull);
  if n < 4usize { return out; }
  // Scale of the cloud, for tolerances
  var ext = 0.f;
  var i = 0usize;
  while i < n {
    ext = maxf(ext, maxf(absf(pts[i].x), maxf(absf(pts[i].y), absf(pts[i].z))));
    i = i + 1usize;
  }
  let eps = 1.0e-5 * maxf(ext, 1.0e-3);

  // Extreme points on each axis; the farthest pair
  var minI = [0usize, 0usize, 0usize];
  var maxI = [0usize, 0usize, 0usize];
  i = 1usize;
  while i < n {
    if pts[i].x < pts[minI[0usize]].x { minI[0usize] = i; }
    if pts[i].x > pts[maxI[0usize]].x { maxI[0usize] = i; }
    if pts[i].y < pts[minI[1usize]].y { minI[1usize] = i; }
    if pts[i].y > pts[maxI[1usize]].y { maxI[1usize] = i; }
    if pts[i].z < pts[minI[2usize]].z { minI[2usize] = i; }
    if pts[i].z > pts[maxI[2usize]].z { maxI[2usize] = i; }
    i = i + 1usize;
  }
  var i0 = 0usize;
  var i1 = 0usize;
  var bestSpan = -1.f;
  var ax = 0usize;
  while ax < 3usize {
    let span = (pts[maxI[ax]] - pts[minI[ax]]).lengthSquared();
    if span > bestSpan { bestSpan = span; i0 = minI[ax]; i1 = maxI[ax]; }
    ax = ax + 1usize;
  }
  if bestSpan <= eps * eps { return out; }
  // Third point: farthest from the line
  let dir = (pts[i1] - pts[i0]).normalize();
  var i2 = i0;
  var bestD = -1.f;
  i = 0usize;
  while i < n {
    let v = pts[i] - pts[i0];
    let dist = (v - dir * v.dot(dir)).lengthSquared();
    if dist > bestD { bestD = dist; i2 = i; }
    i = i + 1usize;
  }
  if bestD <= eps * eps { return out; }
  // Fourth: farthest from the plane
  let pn = (pts[i1] - pts[i0]).cross(pts[i2] - pts[i0]).normalize();
  var i3 = i0;
  bestD = -1.;
  i = 0usize;
  while i < n {
    let dist = absf(pn.dot(pts[i] - pts[i0]));
    if dist > bestD { bestD = dist; i3 = i; }
    i = i + 1usize;
  }
  if bestD <= eps { return out; }

  // The starting tetrahedron, each face turned outward
  let centre = (pts[i0] + pts[i1] + pts[i2] + pts[i3]) * 0.25;
  var faces = List[QFace].empty();
  var t = 0usize;
  while t < 4usize {
    var a = i0;
    var b = i1;
    var c = i2;
    if t == 1usize { a = i0; b = i3; c = i1; }
    if t == 2usize { a = i1; b = i3; c = i2; }
    if t == 3usize { a = i2; b = i3; c = i0; }
    var f = makeQFace(pts, a, b, c);
    if f.normal.dot(centre) - f.d > 0. { f = makeQFace(pts, a, c, b); }
    faces.push(f);
    t = t + 1usize;
  }

  // Each point is assigned to a face it lies outside of, or -1
  var assign = List[i32].empty();
  i = 0usize;
  while i < n {
    var f = -1i32;
    var k = 0usize;
    while k < faces.len() && f < 0i32 {
      let fc = faces[k];
      if fc.normal.dot(pts[i]) - fc.d > eps { f = i32.from(k); }
      k = k + 1usize;
    }
    assign.push(f);
    i = i + 1usize;
  }

  var guard = 0u32;
  while guard < 100000u32 {
    guard = guard + 1u32;
    // The assigned point farthest outside its face
    var p = n;
    var pd = eps;
    i = 0usize;
    while i < n {
      let f = *assign[i];
      if f >= 0i32 {
        let fc = faces[usize.from(f)];
        let dist = fc.normal.dot(pts[i]) - fc.d;
        if dist > pd { pd = dist; p = i; }
      }
      i = i + 1usize;
    }
    if p == n { break; }
    // Faces that see it, and the horizon between seen and unseen
    var visible = List[usize].empty();
    var k = 0usize;
    while k < faces.len() {
      let fc = faces[k];
      if fc.alive && fc.normal.dot(pts[p]) - fc.d > eps { visible.push(k); }
      k = k + 1usize;
    }
    var horizonA = List[usize].empty();
    var horizonB = List[usize].empty();
    k = 0usize;
    while k < visible.len() {
      let fc = faces[*visible[k]];
      var e = 0usize;
      while e < 3usize {
        let ea = if e == 0usize { fc.a } else if e == 1usize { fc.b } else { fc.c };
        let eb = if e == 0usize { fc.b } else if e == 1usize { fc.c } else { fc.a };
        var shared = false;
        var m = 0usize;
        while m < visible.len() {
          if m != k {
            let go = faces[*visible[m]];
            if (go.a == eb && go.b == ea) || (go.b == eb && go.c == ea) || (go.c == eb && go.a == ea) { shared = true; }
          }
          m = m + 1usize;
        }
        if !shared { horizonA.push(ea); horizonB.push(eb); }
        e = e + 1usize;
      }
      k = k + 1usize;
    }
    // Retire the seen faces, add a face from each horizon edge to the point
    k = 0usize;
    while k < visible.len() {
      let vi = *visible[k];
      var fc = *faces[vi];
      fc.alive = false;
      faces.set(vi, fc);
      k = k + 1usize;
    }
    let firstNew = faces.len();
    k = 0usize;
    while k < horizonA.len() {
      faces.push(makeQFace(pts, *horizonA[k], *horizonB[k], p));
      k = k + 1usize;
    }
    // Points whose face died look for a new one
    i = 0usize;
    while i < n {
      let f = *assign[i];
      if i == p { assign.set(i, -1i32); }
      else if f >= 0i32 && !faces[usize.from(f)].alive {
        var g = -1i32;
        var q = firstNew;
        while q < faces.len() && g < 0i32 {
          let fc = faces[q];
          if fc.normal.dot(pts[i]) - fc.d > eps { g = i32.from(q); }
          q = q + 1usize;
        }
        assign.set(i, g);
      }
      i = i + 1usize;
    }
  }

  // Merge coplanar neighbours into polygons
  var alive = List[usize].empty();
  i = 0usize;
  while i < faces.len() {
    if faces[i].alive { alive.push(i); }
    i = i + 1usize;
  }
  let na = alive.len();
  var group = List[i32].empty();
  i = 0usize;
  while i < na { group.push(-1i32); i = i + 1usize; }
  var groups = 0i32;
  i = 0usize;
  while i < na {
    if *group[i] < 0i32 {
      group.set(i, groups);
      var stack = List[usize].empty();
      stack.push(i);
      while stack.len() > 0usize {
        let cur = *stack[stack.len() - 1usize];
        stack.pop();
        let fc = &faces[*alive[cur]];
        var o = 0usize;
        while o < na {
          if *group[o] < 0i32 {
            let go = &faces[*alive[o]];
            // coplanar with the face that started the group: all three corners within 3 eps of its plane
            let seed = faces[*alive[i]];
            if seed.normal.dot(go.normal) > 0.999 && absf(seed.normal.dot(pts[go.a]) - seed.d) < eps * 3.
                && absf(seed.normal.dot(pts[go.b]) - seed.d) < eps * 3. && absf(seed.normal.dot(pts[go.c]) - seed.d) < eps * 3.
                && sharesEdge(fc, go) {
              group.set(o, groups);
              stack.push(o);
            }
          }
          o = o + 1usize;
        }
      }
      groups = groups + 1i32;
    }
    i = i + 1usize;
  }

  // Per group: edges that cancel with their reverse vanish; the rest chain into the outline
  var remap = List[i32].empty();
  i = 0usize;
  while i < n { remap.push(-1i32); i = i + 1usize; }
  var g = 0i32;
  while g < groups {
    var ea = List[usize].empty();
    var eb = List[usize].empty();
    var nsum = Vec3(0., 0., 0.);
    var k = 0usize;
    while k < na {
      if *group[k] == g {
        let fc = faces[*alive[k]];
        nsum = nsum + fc.normal;
        ea.push(fc.a); eb.push(fc.b);
        ea.push(fc.b); eb.push(fc.c);
        ea.push(fc.c); eb.push(fc.a);
      }
      k = k + 1usize;
    }
    var keepA = List[usize].empty();
    var keepB = List[usize].empty();
    k = 0usize;
    while k < ea.len() {
      var cancelled = false;
      var m = 0usize;
      while m < ea.len() {
        if *ea[m] == *eb[k] && *eb[m] == *ea[k] { cancelled = true; }
        m = m + 1usize;
      }
      if !cancelled { keepA.push(*ea[k]); keepB.push(*eb[k]); }
      k = k + 1usize;
    }
    if keepA.len() >= 3usize {
      var loopV = List[usize].empty();
      var cur = *keepA[0usize];
      loopV.push(cur);
      var steps = 0usize;
      while steps < keepA.len() {
        var nxt = cur;
        var m = 0usize;
        while m < keepA.len() {
          if *keepA[m] == cur { nxt = *keepB[m]; }
          m = m + 1usize;
        }
        if nxt == *keepA[0usize] { break; }
        loopV.push(nxt);
        cur = nxt;
        steps = steps + 1usize;
      }
      // Drop vertices in the middle of a straight run
      var clean = List[usize].empty();
      var q = 0usize;
      while q < loopV.len() {
        let prev = pts[*loopV[(q + loopV.len() - 1usize) % loopV.len()]];
        let curp = pts[*loopV[q]];
        let next = pts[*loopV[(q + 1usize) % loopV.len()]];
        let cr = (curp - prev).cross(next - curp);
        if cr.length() > eps * eps * 10. || loopV.len() <= 3usize { clean.push(*loopV[q]); }
        q = q + 1usize;
      }
      if clean.len() >= 3usize {
        let nrm = nsum.normalize();
        var dsum = 0.f;
        let start = out.faceIdx.len();
        q = 0usize;
        while q < clean.len() {
          let vi = *clean[q];
          if *remap[vi] < 0i32 { remap.set(vi, i32.from(out.verts.len())); out.verts.push(pts[vi]); }
          out.faceIdx.push(u32.from(*remap[vi]));
          dsum = dsum + nrm.dot(pts[vi]);
          q = q + 1usize;
        }
        out.faces.push(HullFace(nrm, dsum / f32.from(clean.len()), u32.from(start), u32.from(clean.len())));
      }
    }
    g = g + 1i32;
  }
  out
}

fn sharesEdge(f: &QFace, g: &QFace) bool {
  var count = 0u32;
  if g.a == f.a || g.b == f.a || g.c == f.a { count = count + 1u32; }
  if g.a == f.b || g.b == f.b || g.c == f.b { count = count + 1u32; }
  if g.a == f.c || g.b == f.c || g.c == f.c { count = count + 1u32; }
  count >= 2u32
}
