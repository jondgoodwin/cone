// Triangle meshes with a BVH of their own, and the triangles of a heightfield.
//
// The BVH is built top-down with the binned surface area heuristic (Wald,
// "On fast construction of SAH-based bounding volume hierarchies", 2007; the
// cost model of MacDonald and Booth 1990), leaves of at most 4 triangles, and
// laid out depth-first so a node's left child follows it. Traversal is a
// stack walk over boxes. 'refit' recomputes the boxes bottom-up after the
// vertices move (a deforming mesh), keeping the tree.

pub const BvhLeafSize = 4usize;
const BvhBins = 12usize;

fn triBounds(verts: &List[Vec3], idx: &List[u32], t: usize) Aabb3 {
  Aabb3.empty().enclose(*verts[usize.from(*idx[3usize * t])]).enclose(*verts[usize.from(*idx[3usize * t + 1usize])])
    .enclose(*verts[usize.from(*idx[3usize * t + 2usize])])
}

fn area(b: Aabb3) f32 {
  if b.isEmpty() { return 0.; }
  let d = b.max - b.min;
  2. * (d.x * d.y + d.y * d.z + d.z * d.x)
}

// An edge is flat, so inactive, if the triangle across it faces within about
// 5 degrees of this one (Jolt's active edges): a shape touching it is touching
// the neighbour too, and the contact there is a ghost unless it points along the face
pub fn edgeIsActive(t: Tri, nb: Tri) bool {
  let n1 = (t.b - t.a).cross(t.c - t.a).normalize();
  let n2 = (nb.b - nb.a).cross(nb.c - nb.a).normalize();
  n1.dot(n2) < 0.996
}

// Edge flags per triangle (three bits), by pairing each edge with the one
// that runs the other way in another triangle. An edge with no partner is active.
fn computeEdgeFlags(verts: &List[Vec3], idx: &List[u32]) List[u8] {
  let nt = idx.len() / 3usize;
  var owner = Dict[u64, u32].empty();
  var flags = List[u8].empty();
  var t = 0usize;
  while t < nt { flags.push(7u8); t = t + 1usize; }
  t = 0usize;
  while t < nt {
    var e = 0usize;
    while e < 3usize {
      let va = *idx[3usize * t + e];
      let vb = *idx[3usize * t + (e + 1usize) % 3usize];
      // the key of the directed edge reversed: its partner is stored under the forward key
      let fwd = (u64.from(va) << 32u64) | u64.from(vb);
      let rev = (u64.from(vb) << 32u64) | u64.from(va);
      if owner.containsKey(&rev) {
        let other = usize.from(*owner[&rev]);
        let ot = other / 4usize;
        let oe = other % 4usize;
        let t1 = Tri(*verts[usize.from(*idx[3usize * t])], *verts[usize.from(*idx[3usize * t + 1usize])], *verts[usize.from(*idx[3usize * t + 2usize])]);
        let t2 = Tri(*verts[usize.from(*idx[3usize * ot])], *verts[usize.from(*idx[3usize * ot + 1usize])], *verts[usize.from(*idx[3usize * ot + 2usize])]);
        if !edgeIsActive(t1, t2) {
          flags.set(t, *flags[t] & (7u8 ^ u8.from(1usize << e)));
          flags.set(ot, *flags[ot] & (7u8 ^ u8.from(1usize << oe)));
        }
      } else {
        owner.insert(fwd, u32.from(t * 4usize + e));
      }
      e = e + 1usize;
    }
    t = t + 1usize;
  }
  flags
}

struct Job {
  lo: usize;
  hi: usize;
  parent: i32;
  isRight: bool;
}

// A mesh from vertices and triangle indices (three a triangle, counterclockwise
// seen from outside)
pub fn meshPrim(verts: List[Vec3], indices: List[u32]) Prim {
  var p = Prim.blank(KMesh);
  let nt = indices.len() / 3usize;
  var boxes = List[Aabb3].empty();
  var cents = List[Vec3].empty();
  var t = 0usize;
  while t < nt {
    let b = triBounds(&verts, &indices, t);
    boxes.push(b);
    cents.push(b.center());
    t = t + 1usize;
  }
  var order = List[u32].empty();
  t = 0usize;
  while t < nt { order.push(u32.from(t)); t = t + 1usize; }
  var stack = List[Job].empty();
  if nt > 0usize { stack.push(Job(0usize, nt, -1i32, false)); }
  while stack.len() > 0usize {
    let job = *stack[stack.len() - 1usize];
    stack.pop();
    let me = p.bvh.len();
    if job.parent >= 0i32 && job.isRight {
      var pn = *p.bvh[usize.from(job.parent)];
      pn.first = u32.from(me);
      p.bvh.set(usize.from(job.parent), pn);
    }
    var bb = Aabb3.empty();
    var cb = Aabb3.empty();
    var k = job.lo;
    while k < job.hi {
      bb = bb.union(*boxes[usize.from(*order[k])]);
      cb = cb.enclose(*cents[usize.from(*order[k])]);
      k = k + 1usize;
    }
    let count = job.hi - job.lo;
    var split = job.lo;
    var isLeaf = count <= BvhLeafSize;
    if !isLeaf {
      // Binned SAH along the widest axis of the centroids
      let ext = cb.max - cb.min;
      var axis = 0usize;
      if ext.y > vecGet(ext, axis) { axis = 1usize; }
      if ext.z > vecGet(ext, axis) { axis = 2usize; }
      let lo = vecGet(cb.min, axis);
      let span = vecGet(ext, axis);
      if span < 1.0e-9 {
        isLeaf = count <= 16usize;
        split = job.lo + count / 2usize;
      } else {
        var binBox = List[Aabb3].empty();
        var binCount = List[usize].empty();
        var b = 0usize;
        while b < BvhBins { binBox.push(Aabb3.empty()); binCount.push(0usize); b = b + 1usize; }
        k = job.lo;
        while k < job.hi {
          let ti = usize.from(*order[k]);
          var bi = usize.from(u32.from(((vecGet(*cents[ti], axis) - lo) / span) * f32.from(BvhBins)));
          if bi >= BvhBins { bi = BvhBins - 1usize; }
          binBox.set(bi, (*binBox[bi]).union(*boxes[ti]));
          binCount.set(bi, *binCount[bi] + 1usize);
          k = k + 1usize;
        }
        // cost of splitting after bin s
        var bestCost = bigNumber;
        var bestBin = 0usize;
        var s = 0usize;
        while s + 1usize < BvhBins {
          var lb = Aabb3.empty();
          var rb = Aabb3.empty();
          var ln = 0usize;
          var rn = 0usize;
          b = 0usize;
          while b < BvhBins {
            if b <= s { lb = lb.union(*binBox[b]); ln = ln + *binCount[b]; }
            else { rb = rb.union(*binBox[b]); rn = rn + *binCount[b]; }
            b = b + 1usize;
          }
          if ln > 0usize && rn > 0usize {
            let cost = area(lb) * f32.from(ln) + area(rb) * f32.from(rn);
            if cost < bestCost { bestCost = cost; bestBin = s; }
          }
          s = s + 1usize;
        }
        // partition in place by bin
        var i = job.lo;
        var j = job.hi;
        while i < j {
          let ti = usize.from(*order[i]);
          var bi = usize.from(u32.from(((vecGet(*cents[ti], axis) - lo) / span) * f32.from(BvhBins)));
          if bi >= BvhBins { bi = BvhBins - 1usize; }
          if bi <= bestBin { i = i + 1usize; } else { j = j - 1usize; order.swap(i, j); }
        }
        split = i;
        if bestCost == bigNumber || split == job.lo || split == job.hi { split = job.lo + count / 2usize; }
        // a leaf beats a split when the split is not worth its two boxes
        if count <= 8usize && bestCost < bigNumber && bestCost >= area(bb) * f32.from(count) { isLeaf = true; }
      }
    }
    if isLeaf {
      p.bvh.push(BvhNode(bb.min, bb.max, u32.from(job.lo), u32.from(count)));
    } else {
      p.bvh.push(BvhNode(bb.min, bb.max, 0u32, 0u32));
      stack.push(Job(split, job.hi, i32.from(me), true));
      stack.push(Job(job.lo, split, i32.from(me), false));
    }
  }
  // reordered triangle list
  let flags = computeEdgeFlags(&verts, &indices);
  var k = 0usize;
  while k < order.len() {
    let ti = usize.from(*order[k]);
    p.tris.push(*indices[3usize * ti]);
    p.tris.push(*indices[3usize * ti + 1usize]);
    p.tris.push(*indices[3usize * ti + 2usize]);
    p.triId.push(*order[k]);
    p.edgeActive.push(*flags[ti]);
    k = k + 1usize;
  }
  p.verts = verts;
  p
}

// Triangle number k (in BVH order) of a mesh
pub fn meshTriangle(p: &Prim, k: usize) Tri {
  Tri(*p.verts[usize.from(*p.tris[3usize * k])], *p.verts[usize.from(*p.tris[3usize * k + 1usize])],
    *p.verts[usize.from(*p.tris[3usize * k + 2usize])])
}

fn boxesOverlap(lo: Vec3, hi: Vec3, b: Aabb3) bool {
  lo.x <= b.max.x && hi.x >= b.min.x && lo.y <= b.max.y && hi.y >= b.min.y && lo.z <= b.max.z && hi.z >= b.min.z
}

// The mesh triangles (their original numbers and corners, in the mesh's own
// space) whose boxes meet 'lb'
pub fn meshTrianglesIn(p: &Prim, lb: Aabb3, ids: &mut List[u32], tris: &mut List[Tri], flags: &mut List[u8]) {
  if p.bvh.len() == 0usize { return; }
  var stack = List[usize].empty();
  stack.push(0usize);
  while stack.len() > 0usize {
    let ni = *stack[stack.len() - 1usize];
    stack.pop();
    let nd = *p.bvh[ni];
    if boxesOverlap(nd.lo, nd.hi, lb) {
      if nd.count == 0u32 {
        stack.push(usize.from(nd.first));
        stack.push(ni + 1usize);
      } else {
        var k = usize.from(nd.first);
        while k < usize.from(nd.first + nd.count) {
          let t = meshTriangle(p, k);
          let tb = Aabb3.empty().enclose(t.a).enclose(t.b).enclose(t.c);
          if boxesOverlap(tb.min, tb.max, lb) { ids.push(*p.triId[k]); tris.push(t); flags.push(*p.edgeActive[k]); }
          k = k + 1usize;
        }
      }
    }
  }
}

// Recompute every node's box after the vertices moved
pub fn refitMesh(p: &mut Prim) {
  var i = p.bvh.len();
  while i > 0usize {
    i = i - 1usize;
    var nd = *p.bvh[i];
    var b = Aabb3.empty();
    if nd.count == 0u32 {
      let l = *p.bvh[i + 1usize];
      let r = *p.bvh[usize.from(nd.first)];
      b = Aabb3(l.lo, l.hi).union(Aabb3(r.lo, r.hi));
    } else {
      var k = usize.from(nd.first);
      while k < usize.from(nd.first + nd.count) {
        let t = meshTriangle(p, k);
        b = b.enclose(t.a).enclose(t.b).enclose(t.c);
        k = k + 1usize;
      }
    }
    nd.lo = b.min;
    nd.hi = b.max;
    p.bvh.set(i, nd);
  }
}

// ---------------------------------------------------------------------------
// Heightfield

pub fn heightSample(p: &Prim, i: usize, j: usize) f32 {
  *p.heights[j * usize.from(p.cols) + i] + p.origin.y
}

// The two triangles of cell (i, j), numbered 2 * (j * (cols - 1) + i) and +1
pub fn heightCellTriangle(p: &Prim, i: usize, j: usize, second: bool) Tri {
  let x0 = p.origin.x + f32.from(i) * p.spacing.x;
  let x1 = x0 + p.spacing.x;
  let z0 = p.origin.z + f32.from(j) * p.spacing.y;
  let z1 = z0 + p.spacing.y;
  let v00 = Vec3(x0, heightSample(p, i, j), z0);
  let v10 = Vec3(x1, heightSample(p, i + 1usize, j), z0);
  let v01 = Vec3(x0, heightSample(p, i, j + 1usize), z1);
  let v11 = Vec3(x1, heightSample(p, i + 1usize, j + 1usize), z1);
  if second { Tri(v10, v01, v11) } else { Tri(v00, v01, v10) }
}

// Active edges of a cell triangle, found against the triangle across each edge
fn heightEdgeFlags(p: &Prim, i: usize, j: usize, second: bool) u8 {
  let cw = usize.from(p.cols - 1u32);
  let ch = usize.from(p.rows - 1u32);
  let t = heightCellTriangle(p, i, j, second);
  var f = 7u8;
  if !second {
    // e0 v00-v01: the cell to the west's second triangle; e1: the diagonal; e2 v10-v00: the cell to the north's second
    if i > 0usize && !edgeIsActive(t, heightCellTriangle(p, i - 1usize, j, true)) { f = f & 6u8; }
    if !edgeIsActive(t, heightCellTriangle(p, i, j, true)) { f = f & 5u8; }
    if j > 0usize && !edgeIsActive(t, heightCellTriangle(p, i, j - 1usize, true)) { f = f & 3u8; }
  } else {
    // e0 v10-v01: the diagonal; e1 v01-v11: the cell to the south's first; e2 v11-v10: the cell to the east's first
    if !edgeIsActive(t, heightCellTriangle(p, i, j, false)) { f = f & 6u8; }
    if j + 1usize < ch && !edgeIsActive(t, heightCellTriangle(p, i, j + 1usize, false)) { f = f & 5u8; }
    if i + 1usize < cw && !edgeIsActive(t, heightCellTriangle(p, i + 1usize, j, false)) { f = f & 3u8; }
  }
  f
}

pub fn heightTrianglesIn(p: &Prim, lb: Aabb3, ids: &mut List[u32], tris: &mut List[Tri], flags: &mut List[u8]) {
  if p.cols < 2u32 || p.rows < 2u32 { return; }
  let fx0 = (lb.min.x - p.origin.x) / p.spacing.x;
  let fx1 = (lb.max.x - p.origin.x) / p.spacing.x;
  let fz0 = (lb.min.z - p.origin.z) / p.spacing.y;
  let fz1 = (lb.max.z - p.origin.z) / p.spacing.y;
  let cx = f32.from(p.cols - 1u32);
  let cz = f32.from(p.rows - 1u32);
  if fx1 < 0. || fz1 < 0. || fx0 > cx || fz0 > cz { return; }
  let i0 = usize.from(u32.from(maxf(0., libc.floorf(fx0))));
  let i1 = usize.from(u32.from(minf(cx - 1., libc.floorf(fx1))));
  let j0 = usize.from(u32.from(maxf(0., libc.floorf(fz0))));
  let j1 = usize.from(u32.from(minf(cz - 1., libc.floorf(fz1))));
  var j = j0;
  while j <= j1 {
    var i = i0;
    while i <= i1 {
      let cell = j * usize.from(p.cols - 1u32) + i;
      var s = 0usize;
      while s < 2usize {
        let t = heightCellTriangle(p, i, j, s == 1usize);
        let tb = Aabb3.empty().enclose(t.a).enclose(t.b).enclose(t.c);
        if boxesOverlap(tb.min, tb.max, lb) { ids.push(u32.from(2usize * cell + s)); tris.push(t); flags.push(heightEdgeFlags(p, i, j, s == 1usize)); }
        s = s + 1usize;
      }
      i = i + 1usize;
    }
    j = j + 1usize;
  }
}

// The mesh or heightfield triangles meeting a box (in the shape's own space)
pub fn concaveTriangles(p: &Prim, lb: Aabb3, ids: &mut List[u32], tris: &mut List[Tri], flags: &mut List[u8]) {
  if p.kind == KMesh { meshTrianglesIn(p, lb, ids, tris, flags); } else { heightTrianglesIn(p, lb, ids, tris, flags); }
}

// A triangle of a mesh (by its original number) or heightfield (by cell number), in the shape's space
pub fn concaveTriangle(p: &Prim, id: u32) Tri {
  if p.kind == KHeightfield {
    let cell = usize.from(id / 2u32);
    let cw = usize.from(p.cols - 1u32);
    return heightCellTriangle(p, cell % cw, cell / cw, id % 2u32 == 1u32);
  }
  var k = 0usize;
  while k < p.triId.len() {
    if *p.triId[k] == id { return meshTriangle(p, k); }
    k = k + 1usize;
  }
  Tri(Vec3(0., 0., 0.), Vec3(0., 0., 0.), Vec3(0., 0., 0.))
}
