// Compounds nest: a compound can be a part of a compound, to any depth, and
// the flattened leaves the narrow phase walks carry the composed transforms.

mod nesting;

import testing use *;
import collections use List;
import geomath use *;
import rigidcollide use *;

fn pair() Shape {
  var s = Shape.compound();
  s.add(Prim.box(new Vec3(0.5, 0.5, 0.5)), Rigid.at(new Vec3(-1., 0., 0.)));
  s.add(Prim.sphere(0.5), Rigid.at(new Vec3(1., 0., 0.)));
  s
}

fn main() i32 {
  // an outer compound holding the pair twice, one turned a quarter about y and lifted
  var outer = Shape.compound();
  outer.addShape(pair(), Rigid.identity());
  outer.addShape(pair(), new Rigid(new Vec3(0., 0., 10.), Quat.angleAxis(pi / 2., new Vec3(0., 1., 0.))));
  expectInt(i64.from(outer.leaves.len()), 4, "four leaves in all");
  expectInt(i64.from(outer.parts.len()), 2, "two parts at the top");
  expectInt(i64.from(outer.parts[0usize].kids.len()), 2, "the first part holds its two");
  expectInt(i64.from(outer.parts[1usize].first), 2, "the second part starts at leaf 2");
  expectInt(i64.from(outer.parts[1usize].count), 2, "and covers two");
  // the turned pair's box was at x = -1: after a quarter turn about y it is at z = 10 + 1
  expectFloat(f64.from(outer.leaves[2usize].xf.pos.z), 11., 0.001, "leaf 2 composed: z = 11");
  expectFloat(f64.from(outer.leaves[2usize].xf.pos.x), 0., 0.001, "leaf 2 composed: x = 0");
  // nesting three deep
  var deep = Shape.compound();
  deep.addShape(outer, Rigid.at(new Vec3(100., 0., 0.)));
  expectInt(i64.from(deep.leaves.len()), 4, "three deep, still four leaves");
  expectInt(i64.from(deep.parts[0usize].kids[1usize].kids.len()), 2, "and the nesting is kept");
  expectFloat(f64.from(deep.leaves[0usize].xf.pos.x), 99., 0.001, "leaf 0 at x = 99");
  // a sphere falling onto the sphere of the first pair, which sits at x = 101 in the deep shape
  var out = List[Manifold].empty();
  let s = Shape.single(Prim.sphere(0.5));
  collide(&deep, Rigid.identity(), &s, Rigid.at(new Vec3(101., 0.95, 0.)), 0.02, &mut out);
  expectInt(i64.from(out.len()), 1, "one contact");
  expectInt(i64.from((*out[0usize]).partA), 1, "with leaf 1, the sphere");
  expectFloat(f64.from((*out[0usize]).deepest()), 0.05, 0.001, "5 cm deep");
  // mass is the sum over the leaves
  expectFloat(f64.from(deep.massProps().volume), f64.from(2. * (1. + 4. / 3. * pi * 0.125)), 0.001, "volume of two boxes and two spheres");
  done()
}
