// Ray casts, shape casts, closest points and overlaps against hand-worked
// answers, and the mesh BVH and heightfield walk against a brute-force sweep
// of every triangle.

mod queries;

import testing use *;
import collections use List;
import geomath use *;
import noise;
import rigidcollide use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn nearV(got Vec3, want Vec3, within f32, label &Array[u8]) {
  near(got.x, want.x, within, label);
  near(got.y, want.y, within, label);
  near(got.z, want.z, within, label);
}

struct Rng { state u32; }

fn nextf(r &mut Rng) f32 {
  r.state = noise.pcg(r.state + 1u32);
  noise.toUnit(r.state)
}

fn rand(r &mut Rng, lo f32, hi f32) f32 { lo + (hi - lo) * nextf(r) }

fn cornersOfBox(h Vec3) List[Vec3] {
  var pts = List[Vec3].empty();
  var i = 0u32;
  while i < 8u32 {
    pts.push(new Vec3(if (i & 1u32) == 0u32 { -h.x } else { h.x }, if (i & 2u32) == 0u32 { -h.y } else { h.y },
                      if (i & 4u32) == 0u32 { -h.z } else { h.z }));
    i = i + 1u32;
  }
  pts
}

fn ray(s &Shape, x Rigid, o Vec3, d Vec3) RayHit { rayCast(s, x, o, d, 1000.) }

fn testRays() {
  let id = Rigid.identity();
  let sph = Shape.single(Prim.sphere(1.));
  let h1 = ray(&sph, id, new Vec3(0., 0., -5.), new Vec3(0., 0., 1.));
  near(h1.t, 4., 0.0001, "sphere t");
  nearV(h1.normal, new Vec3(0., 0., -1.), 0.0001, "sphere normal");
  expectBool(ray(&sph, id, new Vec3(0., 1.5, -5.), new Vec3(0., 0., 1.)).hit, false, "sphere miss");
  expectBool(ray(&sph, id, new Vec3(0., 0., -5.), new Vec3(0., 0., -1.)).hit, false, "pointing away");
  near(ray(&sph, id, new Vec3(0., 0., 0.), new Vec3(0., 0., 1.)).t, 0., 0.0001, "from inside hits at 0");
  // a direction that is not a unit vector: t is in its multiples
  near(rayCast(&sph, id, new Vec3(0., 0., -5.), new Vec3(0., 0., 2.), 1000.).t, 2., 0.0001, "t in multiples of the direction");
  expectBool(rayCast(&sph, id, new Vec3(0., 0., -5.), new Vec3(0., 0., 1.), 3.).hit, false, "beyond maxT");

  let bx = Shape.single(Prim.box(new Vec3(1., 2., 3.)));
  let h2 = ray(&bx, id, new Vec3(-5., 1., 1.), new Vec3(1., 0., 0.));
  near(h2.t, 4., 0.0001, "box t");
  nearV(h2.normal, new Vec3(-1., 0., 0.), 0.0001, "box normal");
  // turned a quarter about z, the box is 2 wide along x (its y half-extent)
  let quarter = new Rigid(new Vec3(0., 0., 0.), Quat.angleAxis(pi / 2., new Vec3(0., 0., 1.)));
  near(ray(&bx, quarter, new Vec3(-5., 0.5, 0.5), new Vec3(1., 0., 0.)).t, 3., 0.0001, "turned box t");
  // moved
  near(ray(&bx, Rigid.at(new Vec3(10., 0., 0.)), new Vec3(0., 0., 0.), new Vec3(1., 0., 0.)).t, 9., 0.0001, "moved box t");

  let cap = Shape.single(Prim.capsule(0.5, 1.));
  let h3 = ray(&cap, id, new Vec3(3., 0., 0.), new Vec3(-1., 0., 0.));
  near(h3.t, 2.5, 0.0001, "capsule side t");
  nearV(h3.normal, new Vec3(1., 0., 0.), 0.0001, "capsule side normal");
  let h4 = ray(&cap, id, new Vec3(0., 5., 0.), new Vec3(0., -1., 0.));
  near(h4.t, 3.5, 0.0001, "capsule top t");
  nearV(h4.normal, new Vec3(0., 1., 0.), 0.0001, "capsule top normal");
  // a slanted ray onto the top sphere: from (0.3, 5, 0) straight down hits where y = 1 + sqrt(0.25 - 0.09) = 1.4
  near(ray(&cap, id, new Vec3(0.3, 5., 0.), new Vec3(0., -1., 0.)).t, 5. - 1.4, 0.0001, "capsule cap off-axis");

  let cyl = Shape.single(Prim.cylinder(1., 1.));
  let h5 = ray(&cyl, id, new Vec3(0., 5., 0.3), new Vec3(0., -1., 0.));
  near(h5.t, 4., 0.0001, "cylinder cap t");
  nearV(h5.normal, new Vec3(0., 1., 0.), 0.0001, "cylinder cap normal");
  near(ray(&cyl, id, new Vec3(3., 0.5, 0.), new Vec3(-1., 0., 0.)).t, 2., 0.0001, "cylinder side t");
  expectBool(ray(&cyl, id, new Vec3(3., 1.5, 0.), new Vec3(-1., 0., 0.)).hit, false, "above the cylinder");

  let hull = Shape.single(convexHull(cornersOfBox(new Vec3(1., 2., 3.)).view()));
  let h6 = ray(&hull, id, new Vec3(-5., 1., 1.), new Vec3(1., 0., 0.));
  near(h6.t, 4., 0.0001, "hull t");
  nearV(h6.normal, new Vec3(-1., 0., 0.), 0.0001, "hull normal");
  near(ray(&hull, id, new Vec3(0.5, 0.5, 9.), new Vec3(0., 0., -1.)).t, 6., 0.0001, "hull from +z");

  // compound: two spheres, the ray meets the nearer one and names its part
  var comp = Shape.compound();
  comp.add(Prim.sphere(1.), Rigid.at(new Vec3(-3., 0., 0.)));
  comp.add(Prim.sphere(1.), Rigid.at(new Vec3(3., 0., 0.)));
  let h7 = ray(&comp, id, new Vec3(10., 0., 0.), new Vec3(-1., 0., 0.));
  near(h7.t, 6., 0.0001, "compound t");
  expectInt(i64.from(h7.part), 1, "compound part");
}

fn randomSoup(r &mut Rng, n usize, verts &mut List[Vec3], idx &mut List[u32]) {
  var i = 0usize;
  while i < n {
    let c = new Vec3(rand(r, -8., 8.), rand(r, -8., 8.), rand(r, -8., 8.));
    var k = 0usize;
    while k < 3usize {
      idx.push(u32.from(verts.len()));
      verts.push(c + new Vec3(rand(r, -1.5, 1.5), rand(r, -1.5, 1.5), rand(r, -1.5, 1.5)));
      k = k + 1usize;
    }
    i = i + 1usize;
  }
}

fn testMeshBvh() {
  var r = new Rng(777u32);
  var verts = List[Vec3].empty();
  var idx = List[u32].empty();
  randomSoup(&mut r, 400usize, &mut verts, &mut idx);
  let vcopy = verts.view();
  var tris = List[Prim].empty();
  var i = 0usize;
  while i < 400usize {
    tris.push(Prim.triangle(vcopy[3usize * i], vcopy[3usize * i + 1usize], vcopy[3usize * i + 2usize]));
    i = i + 1usize;
  }
  let mesh = Shape.single(meshPrim(verts, idx));
  expectBool(mesh.prim.bvh.len() > 20usize, true, "the BVH has many nodes");
  var mismatches = 0i64;
  var hits = 0i64;
  var k = 0usize;
  while k < 300usize {
    let o = new Vec3(rand(&mut r, -12., 12.), rand(&mut r, -12., 12.), rand(&mut r, -12., 12.));
    let d = new Vec3(rand(&mut r, -1., 1.), rand(&mut r, -1., 1.), rand(&mut r, -1., 1.)).normalize();
    let fast = rayCast(&mesh, Rigid.identity(), o, d, 100.);
    var best = 1.0e30;
    var bestId = 0usize;
    var j = 0usize;
    while j < tris.len() {
      let h = rayPrim(&*tris[j], o, d, 100.);
      if h.hit and h.t < best { best = h.t; bestId = j; }
      j = j + 1usize;
    }
    if best < 1.0e29 { hits = hits + 1i64; }
    if (best < 1.0e29) != fast.hit { mismatches = mismatches + 1i64; }
    else if fast.hit and (absf(fast.t - best) > 0.0001 or usize.from(fast.sub) != bestId) { mismatches = mismatches + 1i64; }
    k = k + 1usize;
  }
  expectBool(hits > 15i64, true, "enough of the random rays hit something");
  expectInt(mismatches, 0, "BVH ray cast agrees with testing every triangle");

  // The triangles found for a box against testing every one
  var miss2 = 0i64;
  k = 0usize;
  while k < 100usize {
    let c = new Vec3(rand(&mut r, -9., 9.), rand(&mut r, -9., 9.), rand(&mut r, -9., 9.));
    let lb = Aabb3.fromCenter(c, new Vec3(1.5, 1., 2.));
    var ids = List[u32].empty();
    var found = List[Tri].empty();
    var flags = List[u8].empty();
    concaveTriangles(&mesh.prim, lb, &mut ids, &mut found, &mut flags);
    var want = 0usize;
    var j = 0usize;
    while j < tris.len() {
      let t = Aabb3.empty().enclose(tris[j].a).enclose(tris[j].b).enclose(tris[j].c);
      if t.overlaps(lb) { want = want + 1usize; }
      j = j + 1usize;
    }
    if want != ids.len() { miss2 = miss2 + 1i64; }
    k = k + 1usize;
  }
  expectInt(miss2, 0, "box query finds exactly the triangles whose boxes meet it");
}

fn heightsRamp() List[f32] {
  var h = List[f32].empty();
  var j = 0u32;
  while j < 5u32 {
    var i = 0u32;
    while i < 5u32 { h.push(0.5 * f32.from(i)); i = i + 1u32; }
    j = j + 1u32;
  }
  h
}

fn testHeightfield() {
  let field = Shape.single(Prim.heightfield(heightsRamp(), 5u32, 5u32, 1., 1., new Vec3(0., 0., 0.)));
  let id = Rigid.identity();
  near(ray(&field, id, new Vec3(2., 10., 1.), new Vec3(0., -1., 0.)).t, 9., 0.0001, "straight down on the ramp");
  let h = ray(&field, id, new Vec3(0., 5., 1.), new Vec3(1., -1., 0.));
  near(h.t, 10. / 3., 0.0001, "slanted ray: 5 - t = 0.5 t");
  nearV(h.normal, new Vec3(-0.5, 1., 0.).normalize(), 0.0001, "ramp normal");
  expectBool(ray(&field, id, new Vec3(-3., 10., 1.), new Vec3(0., -1., 0.)).hit, false, "beside the field");
  // a random bumpy field against every cell triangle
  var r = new Rng(31u32);
  var hs = List[f32].empty();
  var i = 0usize;
  while i < 144usize { hs.push(rand(&mut r, 0., 3.)); i = i + 1usize; }
  let bumpy = Prim.heightfield(hs, 12u32, 12u32, 0.7, 0.9, new Vec3(-4., 1., -5.));
  var mismatches = 0i64;
  var hits = 0i64;
  var k = 0usize;
  while k < 300usize {
    let o = new Vec3(rand(&mut r, -6., 6.), rand(&mut r, 3., 8.), rand(&mut r, -7., 7.));
    let d = new Vec3(rand(&mut r, -1., 1.), rand(&mut r, -1., -0.1), rand(&mut r, -1., 1.)).normalize();
    let fast = rayPrim(&bumpy, o, d, 100.);
    var best = 1.0e30;
    var c = 0usize;
    while c < 121usize {
      var s = 0usize;
      while s < 2usize {
        let t = heightCellTriangle(&bumpy, c % 11usize, c / 11usize, s == 1usize);
        let hh = rayPrim(&Prim.triangle(t.a, t.b, t.c), o, d, 100.);
        if hh.hit and hh.t < best { best = hh.t; }
        s = s + 1usize;
      }
      c = c + 1usize;
    }
    if best < 1.0e29 { hits = hits + 1i64; }
    if (best < 1.0e29) != fast.hit { mismatches = mismatches + 1i64; }
    else if fast.hit and absf(fast.t - best) > 0.0001 { mismatches = mismatches + 1i64; }
    k = k + 1usize;
  }
  expectBool(hits > 100i64, true, "many rays hit the bumpy field");
  expectInt(mismatches, 0, "grid walk agrees with testing every cell");
}

fn testCasts() {
  let id = Rigid.identity();
  let sph = Shape.single(Prim.sphere(0.5));
  let bx = Shape.single(Prim.box(new Vec3(1., 1., 1.)));
  // The sphere's centre is stopped 1.5 from the box's: 3.5 of the 10
  let c1 = shapeCast(&sph, Rigid.at(new Vec3(-5., 0., 0.)), new Vec3(10., 0., 0.), &bx, id);
  expectBool(c1.hit, true, "sphere cast hits");
  near(c1.fraction, 0.35, 0.0005, "sphere cast fraction");
  nearV(c1.normal, new Vec3(1., 0., 0.), 0.001, "sphere cast normal");
  nearV(c1.pointB, new Vec3(-1., 0., 0.), 0.001, "contact on the box");
  expectBool(shapeCast(&sph, Rigid.at(new Vec3(-5., 2., 0.)), new Vec3(10., 0., 0.), &bx, id).hit, false, "passes above");
  expectBool(shapeCast(&sph, Rigid.at(new Vec3(-5., 0., 0.)), new Vec3(2., 0., 0.), &bx, id).hit, false, "too short");
  // A box dropped onto a box
  let small = Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5)));
  let c2 = shapeCast(&small, Rigid.at(new Vec3(0.2, 5., 0.1)), new Vec3(0., -10., 0.), &bx, id);
  near(c2.fraction, 0.35, 0.0005, "box cast fraction");
  nearV(c2.normal, new Vec3(0., -1., 0.), 0.001, "box cast normal");
  // Already overlapping: fraction 0
  let c3 = shapeCast(&sph, Rigid.at(new Vec3(1.2, 0., 0.)), new Vec3(1., 0., 0.), &bx, id);
  expectBool(c3.hit, true, "starts in contact");
  near(c3.fraction, 0., 0.0001, "fraction 0");
  // A capsule dropped onto a mesh ground
  var verts = List[Vec3].empty();
  verts.push(new Vec3(-5., 0., -5.)); verts.push(new Vec3(5., 0., -5.)); verts.push(new Vec3(5., 0., 5.)); verts.push(new Vec3(-5., 0., 5.));
  var idx = List[u32].empty();
  idx.push(0u32); idx.push(3u32); idx.push(2u32); idx.push(0u32); idx.push(2u32); idx.push(1u32);
  let ground = Shape.single(meshPrim(verts, idx));
  let cap = Shape.single(Prim.capsule(0.25, 0.5));
  let c4 = shapeCast(&cap, Rigid.at(new Vec3(1., 3., 1.)), new Vec3(0., -5., 0.), &ground, id);
  expectBool(c4.hit, true, "capsule hits the mesh");
  near(c4.fraction, 0.45, 0.0005, "capsule fraction: bottom at 0.75 - 0.75");
  expectBool(c4.sub != NoSub, true, "names the triangle");
  // A sphere rolled at a ramp heightfield
  let field = Shape.single(Prim.heightfield(heightsRamp(), 5u32, 5u32, 1., 1., new Vec3(0., 0., 0.)));
  let c5 = shapeCast(&sph, Rigid.at(new Vec3(2., 5., 2.)), new Vec3(0., -5., 0.), &field, id);
  expectBool(c5.hit, true, "sphere hits the field");
  // the centre stops where the distance to the plane y = 0.5x is 0.5: (y - 0.5x) / 1.118 = 0.5, x = 2, y = 1.559
  near(c5.fraction, (5. - 1.5590170) / 5., 0.001, "ramp cast fraction");
}

fn testClosest() {
  let id = Rigid.identity();
  let cube = Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5)));
  let c1 = closestPoints(&cube, id, &cube, Rigid.at(new Vec3(2., 2., 2.)), 10.);
  expectBool(c1.found, true, "found");
  near(c1.dist, 1.7320508, 0.0005, "corner to corner");
  nearV(c1.pointA, new Vec3(0.5, 0.5, 0.5), 0.001, "point on a");
  nearV(c1.pointB, new Vec3(1.5, 1.5, 1.5), 0.001, "point on b");
  expectBool(closestPoints(&cube, id, &cube, Rigid.at(new Vec3(2., 2., 2.)), 1.).found, false, "beyond the search distance");
  // Edge to edge: cube b turned 45 degrees about y and moved so the nearest edges are skew
  let sph = Shape.single(Prim.sphere(1.));
  let c2 = closestPoints(&sph, id, &cube, Rigid.at(new Vec3(3., 0., 0.)), 10.);
  near(c2.dist, 1.5, 0.0005, "sphere to box face");
  let c3 = closestPoints(&sph, id, &cube, Rigid.at(new Vec3(1., 0., 0.)), 10.);
  near(c3.dist, 0., 0.0001, "overlapping: distance 0");
  // A compound: the nearer part wins and is named
  var comp = Shape.compound();
  comp.add(Prim.sphere(1.), Rigid.at(new Vec3(-4., 0., 0.)));
  comp.add(Prim.sphere(1.), Rigid.at(new Vec3(4., 0., 0.)));
  let c4 = closestPoints(&comp, id, &cube, Rigid.at(new Vec3(7., 0., 0.)), 10.);
  near(c4.dist, 1.5, 0.0005, "compound: 7 - 0.5 - 4 - 1");
  expectInt(i64.from(c4.partA), 1, "part 1");
  // Overlaps and point containment
  expectBool(overlaps(&sph, id, &cube, Rigid.at(new Vec3(1.2, 0., 0.))), true, "overlap");
  expectBool(overlaps(&sph, id, &cube, Rigid.at(new Vec3(1.6, 0., 0.))), false, "no overlap");
  expectBool(containsPoint(&cube, Rigid.at(new Vec3(1., 0., 0.)), new Vec3(1.4, 0.4, -0.4)), true, "point inside");
  expectBool(containsPoint(&cube, Rigid.at(new Vec3(1., 0., 0.)), new Vec3(1.6, 0., 0.)), false, "point outside");
}

fn main() i32 {
  testRays();
  testMeshBvh();
  testHeightfield();
  testCasts();
  testClosest();
  done()
}
