// Contact manifolds against hand-worked answers.
//
// Box on box: the lower box A is half (1, 0.5, 1) about the origin, so its top
// is y = 0.5. The upper box B is half (0.5, 0.5, 0.5) at height 0.99, so its
// bottom is y = 0.49 and the overlap is 0.01 everywhere on the footprint.
//  - centred at (0.3, ., 0.2): the footprint x -0.2..0.8, z -0.3..0.7 lies
//    inside A's top: 4 points, its corners;
//  - at (0.8, ., 0.2): x 0.3..1.3 hangs over A's edge at x = 1, so the clip
//    leaves x 0.3..1.0: 4 points;
//  - turned 45 degrees about y at the origin: a square of half-diagonal 0.7071
//    (an octagon after clipping by A's sides? no: A is 2 wide, the diamond
//    reaches 0.7071 < 1, so it stays a diamond): 4 points on the diamond's corners;
//  - turned 45 degrees about z, resting on an edge: only the lowest edge is
//    within the margin, so 2 points at the ends of that edge, z = -0.5 and 0.5.

mod contacts;

import testing use *;
import collections use List;
import geomath use *;
import stdio use *;
import rigidcollide use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

// Does the manifold have a point whose B-side position is at (x, z) in the
// horizontal plane?
fn hasXz(m &Manifold, x f32, z f32) bool {
  var i = 0usize;
  while i < m.count {
    if absf(m.points[i].onB.x - x) < 0.001 and absf(m.points[i].onB.z - z) < 0.001 { return true; }
    i = i + 1usize;
  }
  false
}

fn one(a &Shape, xa Rigid, b &Shape, xb Rigid, margin f32) Manifold {
  var out = List[Manifold].empty();
  collide(a, xa, b, xb, margin, &mut out);
  if out.len() == 0usize { return emptyManifold(); }
  *out[0usize]
}

fn allDepths(m &Manifold, d f32, label &Array[u8]) {
  var i = 0usize;
  while i < m.count {
    near(m.points[i].depth, d, 0.0005, label);
    i = i + 1usize;
  }
}

fn testBoxOnBox() {
  let lower = Shape.single(Prim.box(new Vec3(1., 0.5, 1.)));
  let upper = Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5)));
  let id = Rigid.identity();
  let m1 = one(&lower, id, &upper, Rigid.at(new Vec3(0.3, 0.99, 0.2)), 0.02);
  expectInt(i64.from(m1.count), 4, "box on box: four points");
  near(m1.normal.y, 1., 0.0001, "normal up");
  allDepths(&m1, 0.01, "depth 0.01");
  expectBool(hasXz(&m1, -0.2, -0.3) and hasXz(&m1, 0.8, -0.3) and hasXz(&m1, 0.8, 0.7) and hasXz(&m1, -0.2, 0.7), true,
    "at the footprint's corners");
  near(m1.points[0usize].onA.y, 0.5, 0.0001, "A side on A's top");
  near(m1.points[0usize].onB.y, 0.49, 0.0001, "B side on B's bottom");

  let m2 = one(&lower, id, &upper, Rigid.at(new Vec3(0.8, 0.99, 0.2)), 0.02);
  expectInt(i64.from(m2.count), 4, "overhanging: four points");
  expectBool(hasXz(&m2, 0.3, -0.3) and hasXz(&m2, 1.0, -0.3) and hasXz(&m2, 1.0, 0.7) and hasXz(&m2, 0.3, 0.7), true,
    "clipped at A's edge");
  allDepths(&m2, 0.01, "same depth");

  let turned = new Rigid(new Vec3(0., 0.99, 0.), Quat.angleAxis(pi / 4., new Vec3(0., 1., 0.)));
  let m3 = one(&lower, id, &upper, turned, 0.02);
  expectInt(i64.from(m3.count), 4, "diamond: four points");
  expectBool(hasXz(&m3, 0.7071, 0.) and hasXz(&m3, -0.7071, 0.) and hasXz(&m3, 0., 0.7071) and hasXz(&m3, 0., -0.7071), true,
    "at the diamond's corners");

  let edge = new Rigid(new Vec3(0., 0.5 + 0.7071 - 0.01, 0.), Quat.angleAxis(pi / 4., new Vec3(0., 0., 1.)));
  let m4 = one(&lower, id, &upper, edge, 0.02);
  expectInt(i64.from(m4.count), 2, "resting on an edge: two points");
  expectBool(hasXz(&m4, m4.points[0usize].onB.x, -0.5) or hasXz(&m4, m4.points[0usize].onB.x, 0.5), true, "at the edge's ends");
  allDepths(&m4, 0.01, "edge depth");
  near(m4.normal.y, 1., 0.001, "edge normal up");

  // Apart by 0.015: seen within the margin 0.02, with a negative depth; not within 0.01
  let m5 = one(&lower, id, &upper, Rigid.at(new Vec3(0.3, 1.015, 0.2)), 0.02);
  expectInt(i64.from(m5.count), 4, "speculative contact");
  allDepths(&m5, -0.015, "a gap is a negative depth");
  let m6 = one(&lower, id, &upper, Rigid.at(new Vec3(0.3, 1.015, 0.2)), 0.01);
  expectInt(i64.from(m6.count), 0, "beyond the margin: nothing");
}

// More than four points are cut to four
fn testReduction() {
  // A cylinder (a 12-gon cap, radius 0.4) standing on a big box: 12 points cut to 4
  let floor = Shape.single(Prim.box(new Vec3(5., 0.5, 5.)));
  let cyl = Shape.single(Prim.cylinder(0.4, 0.5));
  let m = one(&floor, Rigid.identity(), &cyl, Rigid.at(new Vec3(0.2, 0.99, 0.1)), 0.02);
  expectInt(i64.from(m.count), 4, "cylinder standing: cut to four points");
  allDepths(&m, 0.01, "cap depth");
  // they spread round the cap: every point is about 0.4 from the axis
  var i = 0usize;
  while i < m.count {
    let dx = m.points[i].onB.x - 0.2;
    let dz = m.points[i].onB.z - 0.1;
    near((dx * dx + dz * dz).sqrt(), 0.4, 0.001, "on the cap's rim");
    i = i + 1usize;
  }
  // the four are well spread: no two are closer than the rim's chord of 90 degrees (0.4 * 1.414)
  // less a 30 degree step of slack
  var closest = 1.0e9f;
  i = 0usize;
  while i < 4usize {
    var k = i + 1usize;
    while k < 4usize {
      closest = minf(closest, m.points[i].onB.distance(m.points[k].onB));
      k = k + 1usize;
    }
    i = i + 1usize;
  }
  expectBool(closest > 0.4 * 1.0, true, "the four are spread round the rim");
}

fn testRound() {
  let floor = Shape.single(Prim.box(new Vec3(5., 0.5, 5.)));
  let id = Rigid.identity();
  // Sphere r 0.5 resting 0.05 into the top of the box
  let s = Shape.single(Prim.sphere(0.5));
  let m1 = one(&floor, id, &s, Rigid.at(new Vec3(1., 0.95, -2.)), 0.02);
  expectInt(i64.from(m1.count), 1, "sphere on box: one point");
  near(m1.points[0usize].depth, 0.05, 0.0005, "sphere depth");
  near(m1.points[0usize].onA.x, 1., 0.001, "contact x");
  near(m1.points[0usize].onA.y, 0.5, 0.001, "on the box's top");
  // Capsule (r 0.25, segment half length 0.5) lying along x on the box: two points
  let cap = Shape.single(Prim.capsule(0.25, 0.5));
  let lying = new Rigid(new Vec3(0., 0.74, 0.), Quat.angleAxis(pi / 2., new Vec3(0., 0., 1.)));
  let m2 = one(&floor, id, &cap, lying, 0.02);
  expectInt(i64.from(m2.count), 2, "capsule lying: two points");
  allDepths(&m2, 0.01, "capsule depth");
  // Capsule standing: one point
  let m3 = one(&floor, id, &cap, Rigid.at(new Vec3(0., 1.24, 0.)), 0.02);
  expectInt(i64.from(m3.count), 1, "capsule standing: one point");
  allDepths(&m3, 0.01, "standing capsule depth");
  // Sphere-sphere fast path, sphere-capsule and capsule-capsule
  let a = Shape.single(Prim.sphere(1.));
  let m4 = one(&a, id, &a, Rigid.at(new Vec3(1.5, 0., 0.)), 0.02);
  near(m4.points[0usize].depth, 0.5, 0.0001, "sphere-sphere");
  let c1 = Shape.single(Prim.capsule(0.5, 1.));
  let m5 = one(&c1, id, &a, Rigid.at(new Vec3(1.2, 0.3, 0.)), 0.02);
  near(m5.points[0usize].depth, 0.3, 0.0001, "capsule-sphere: 1 + 0.5 - 1.2");
  near(m5.normal.x, 1., 0.0001, "normal from the capsule to the sphere");
  let m6 = one(&a, id, &c1, Rigid.at(new Vec3(1.2, 0.3, 0.)), 0.02);
  near(m6.points[0usize].depth, 0.3, 0.0001, "sphere-capsule, the other way round");
  near(m6.normal.x, 1., 0.0001, "normal from the sphere to the capsule");
  // Two crossed capsules: closest points are the segments' crossing, 0.8 apart
  let crossed = new Rigid(new Vec3(0.8, 0., 0.), Quat.angleAxis(pi / 2., new Vec3(1., 0., 0.)));
  let m7 = one(&c1, id, &c1, crossed, 0.02);
  near(m7.points[0usize].depth, 0.2, 0.0001, "crossed capsules: 0.5 + 0.5 - 0.8");
  near(m7.normal.x, 1., 0.0001, "normal along x");
  // Two parallel capsules side by side, 0.9 apart, overlapped over 1.0 of length: two points
  let m8 = one(&c1, id, &c1, Rigid.at(new Vec3(0.9, 1., 0.)), 0.02);
  expectInt(i64.from(m8.count), 2, "parallel capsules: two points");
  allDepths(&m8, 0.1, "parallel capsule depth");
}

fn testCompound() {
  // A compound of two boxes, one at x = -1 and one at x = +1, against a sphere
  // sunk into the right one
  var comp = Shape.compound();
  comp.add(Prim.box(new Vec3(0.5, 0.5, 0.5)), Rigid.at(new Vec3(-1., 0., 0.)));
  comp.add(Prim.box(new Vec3(0.5, 0.5, 0.5)), Rigid.at(new Vec3(1., 0., 0.)));
  let s = Shape.single(Prim.sphere(0.5));
  var out = List[Manifold].empty();
  collide(&comp, Rigid.identity(), &s, Rigid.at(new Vec3(1., 0.95, 0.)), 0.02, &mut out);
  expectInt(i64.from(out.len()), 1, "only the right-hand part is touched");
  expectInt(i64.from((*out[0usize]).partA), 1, "and it is part 1");
  near((*out[0usize]).points[0usize].depth, 0.05, 0.0005, "compound contact depth");
  // Compound placed with a transform: shifted by 10 in x, the contact moves too
  var out2 = List[Manifold].empty();
  collide(&comp, Rigid.at(new Vec3(10., 0., 0.)), &s, Rigid.at(new Vec3(9., 0.95, 0.)), 0.02, &mut out2);
  expectInt(i64.from(out2.len()), 1, "the placed compound");
  expectInt(i64.from((*out2[0usize]).partA), 0, "now part 0 (at x = 9)");
}

fn testMesh() {
  // A ground made of two triangles forming a 10 x 10 square at y = 0, normals up
  var verts = List[Vec3].empty();
  verts.push(new Vec3(-5., 0., -5.));
  verts.push(new Vec3(5., 0., -5.));
  verts.push(new Vec3(5., 0., 5.));
  verts.push(new Vec3(-5., 0., 5.));
  var idx = List[u32].empty();
  idx.push(0u32); idx.push(3u32); idx.push(2u32);
  idx.push(0u32); idx.push(2u32); idx.push(1u32);
  let ground = Shape.single(meshPrim(verts, idx));
  let s = Shape.single(Prim.sphere(0.5));
  var out = List[Manifold].empty();
  collide(&ground, Rigid.identity(), &s, Rigid.at(new Vec3(1., 0.45, 2.)), 0.02, &mut out);
  expectInt(i64.from(out.len()), 1, "sphere touches one triangle");
  near((*out[0usize]).points[0usize].depth, 0.05, 0.0005, "mesh depth");
  near((*out[0usize]).normal.y, 1., 0.001, "mesh normal up");
  expectBool((*out[0usize]).subA != NoSub, true, "the triangle is named");
  // A sphere above the shared diagonal touches both
  var out2 = List[Manifold].empty();
  collide(&ground, Rigid.identity(), &s, Rigid.at(new Vec3(0., 0.45, 0.)), 0.02, &mut out2);
  expectInt(i64.from(out2.len()), 1, "on the diagonal: both triangles see it, one contact is kept");
  // A box on the mesh, the mesh given second: flipped back
  let bx = Shape.single(Prim.box(new Vec3(0.5, 0.5, 0.5)));
  var out3 = List[Manifold].empty();
  collide(&bx, Rigid.at(new Vec3(2., 0.49, -2.)), &ground, Rigid.identity(), 0.02, &mut out3);
  expectInt(i64.from(out3.len()), 1, "box on mesh");
  near((*out3[0usize]).normal.y, -1., 0.001, "normal from the box down to the mesh");
  expectInt(i64.from((*out3[0usize]).count), 4, "four points under the box");
  near((*out3[0usize]).points[0usize].depth, 0.01, 0.0005, "box depth");
  // Far away: nothing, found by the BVH without testing triangles
  var out4 = List[Manifold].empty();
  collide(&ground, Rigid.identity(), &s, Rigid.at(new Vec3(1., 3., 2.)), 0.02, &mut out4);
  expectInt(i64.from(out4.len()), 0, "far above");
}

fn testHeightfield() {
  // 5 x 5 samples, 1 m apart, a ramp rising 0.5 m per metre along x: h = 0.5 x
  var h = List[f32].empty();
  var j = 0u32;
  while j < 5u32 {
    var i = 0u32;
    while i < 5u32 { h.push(0.5 * f32.from(i)); i = i + 1u32; }
    j = j + 1u32;
  }
  let field = Shape.single(Prim.heightfield(h, 5u32, 5u32, 1., 1., new Vec3(0., 0., 0.)));
  // A sphere r 0.5 on the ramp at x = 2: the surface there is y = 1, its normal
  // (-0.5, 1, 0) / 1.118. The sphere centre sits 0.5 - 0.05 above along the normal
  let n = new Vec3(-0.5, 1., 0.).normalize();
  let centre = new Vec3(2., 1., 2.) + n * 0.45;
  let s = Shape.single(Prim.sphere(0.5));
  var out = List[Manifold].empty();
  collide(&field, Rigid.identity(), &s, Rigid.at(centre), 0.02, &mut out);
  expectInt(i64.from(out.len()), 1, "sphere on the ramp");
  near((*out[0usize]).points[0usize].depth, 0.05, 0.001, "ramp depth");
  near((*out[0usize]).normal.x, n.x, 0.001, "ramp normal x");
  near((*out[0usize]).normal.y, n.y, 0.001, "ramp normal y");
}

fn main() i32 {
  testBoxOnBox();
  testReduction();
  testRound();
  testCompound();
  testMesh();
  testHeightfield();
  done()
}
