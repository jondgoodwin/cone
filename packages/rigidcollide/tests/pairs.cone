// Every pair of convex kinds, a table of shape pairs placed so the answer is
// known; box-box against GJK/EPA on random placements; the invariants of a
// manifold on random pairs of every kind; and the broad phase against
// testing every pair.
//
// The table: sphere, box, capsule, cylinder and a hull of a box's corners, each
// reaching 0.6 along x from its centre. Centres 1.0 apart along x overlap by
// 0.2 with the normal along x; 1.5 apart (margin 0.5) they are 0.3 apart,
// a depth of -0.3.

mod pairs;

import testing use *;
import collections use List;
import geomath use *;
import noise;
import stdio use *;
import rigidcollide use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

struct Rng { state: u32; }

fn nextf(r: &mut Rng) f32 {
  r.state = noise.pcg(r.state + 1u32);
  noise.toUnit(r.state)
}

fn rand(r: &mut Rng, lo: f32, hi: f32) f32 { lo + (hi - lo) * nextf(r) }

fn cornersOfBox(h: Vec3) List[Vec3] {
  var pts = List[Vec3].empty();
  var i = 0u32;
  while i < 8u32 {
    pts.push(new Vec3(if (i & 1u32) == 0u32 { -h.x } else { h.x }, if (i & 2u32) == 0u32 { -h.y } else { h.y },
                      if (i & 4u32) == 0u32 { -h.z } else { h.z }));
    i = i + 1u32;
  }
  pts
}

fn kindOf(i: usize) Shape {
  if i == 0usize { return Shape.single(Prim.sphere(0.6)); }
  if i == 1usize { return Shape.single(Prim.box(new Vec3(0.6, 0.6, 0.6))); }
  if i == 2usize { return Shape.single(Prim.capsule(0.6, 0.7)); }
  if i == 3usize { return Shape.single(Prim.cylinder(0.6, 0.6)); }
  Shape.single(convexHull(cornersOfBox(new Vec3(0.6, 0.6, 0.6)).view()))
}

fn nameOf(i: usize) &Array[u8] {
  if i == 0usize { return "sphere"; }
  if i == 1usize { return "box"; }
  if i == 2usize { return "capsule"; }
  if i == 3usize { return "cylinder"; }
  "hull"
}

fn testPairTable() {
  var failures = 0i64;
  var i = 0usize;
  while i < 5usize {
    var j = 0usize;
    while j < 5usize {
      let a = kindOf(i);
      let b = kindOf(j);
      var out = List[Manifold].empty();
      collide(&a, Rigid.identity(), &b, Rigid.at(new Vec3(1., 0., 0.)), 0.5, &mut out);
      if out.len() != 1usize { failures = failures + 1i64; }
      else {
        let m = *out[0usize];
        if m.count < 1usize || absf(m.deepest() - 0.2) > 0.002 || absf(m.normal.x - 1.) > 0.002 { failures = failures + 1i64; }
        var k = 0usize;
        while k < m.count {
          // every point of a flat-on contact is as deep as the deepest, or a speculative gap, never beyond
          if m.points[k].depth > 0.2 + 0.002 { failures = failures + 1i64; }
          k = k + 1usize;
        }
      }
      var far = List[Manifold].empty();
      collide(&a, Rigid.identity(), &b, Rigid.at(new Vec3(1.5, 0., 0.)), 0.5, &mut far);
      if far.len() != 1usize { failures = failures + 1i64; }
      else if absf((*far[0usize]).deepest() + 0.3) > 0.002 { failures = failures + 1i64; }
      var none = List[Manifold].empty();
      collide(&a, Rigid.identity(), &b, Rigid.at(new Vec3(1.8, 0., 0.)), 0.5, &mut none);
      if none.len() != 0usize { failures = failures + 1i64; }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  expectInt(failures, 0, "all 25 kind pairs: 0.2 deep at 1.0, 0.3 apart at 1.5, nothing at 1.8");
}

fn randomRigid(r: &mut Rng, spread: f32) Rigid {
  let axis = new Vec3(rand(r, -1., 1.), rand(r, -1., 1.), rand(r, -1., 1.)).normalize();
  new Rigid(new Vec3(rand(r, -spread, spread), rand(r, -spread, spread), rand(r, -spread, spread)),
    Quat.angleAxis(rand(r, 0., 6.2831853), axis))
}

fn testBoxBoxRandom() {
  var r = new Rng(4242u32);
  var bad = 0i64;
  var contacts = 0i64;
  var edgeish = 0i64;
  var shallowOff = 0i64;
  var mutual = 0i64;
  var t = 0u32;
  while t < 400u32 {
    t = t + 1u32;
    let ha = new Vec3(rand(&mut r, 0.3, 1.), rand(&mut r, 0.3, 1.), rand(&mut r, 0.3, 1.));
    let hb = new Vec3(rand(&mut r, 0.3, 1.), rand(&mut r, 0.3, 1.), rand(&mut r, 0.3, 1.));
    let pa = Prim.box(ha);
    let pb = Prim.box(hb);
    let xa = randomRigid(&mut r, 0.2);
    let xb = randomRigid(&mut r, 1.6);
    let ref = convexPenetration(&pa, xa, &pb, xb, 0.05);
    let m = collideConvex(&pa, xa, &pb, xb, 0.05);
    if ref.hit != (m.count > 0usize) {
      // one sees it and the other does not: only allowed at the margin's very edge
      if absf(ref.depth + 0.05) > 0.003 { bad = bad + 1i64; }
    } else if ref.hit {
      contacts = contacts + 1i64;
      // No point is deeper than the least penetration (SAT prefers a face axis over an
      // edge axis unless the edge is better by 0.002 + 2%, so allow that slack)
      if m.deepest() > ref.depth + 0.003 + 0.03 * ref.depth { bad = bad + 1i64; }
      if m.count == 1usize { edgeish = edgeish + 1i64; }
      // a shallow touch has its deepest point inside the faces: it is the penetration depth
      if ref.depth < 0.05 && ref.depth > 0. && absf(m.deepest() - ref.depth) > 0.01 { shallowOff = shallowOff + 1i64; }
      // the normal is the direction of least penetration, but where several nearly tie either may be reported
      if m.normal.dot(ref.normal) < 0.99 {
        mutual = mutual + 1i64;
        // then the SAT normal must separate nearly as well as the EPA one
        let along = m.normal.dot(ref.normal);
        if along < 0.2 { bad = bad + 1i64; }
      }
    }
  }
  expectBool(contacts > 60i64, true, "enough random box pairs touch");
  print <- "box-box random: ", contacts, " contacts, ", edgeish, " single-point, ", shallowOff, " shallow off, ", mutual, " normals differ\n";
  expectInt(bad, 0, "box-box (SAT and clipping) agrees with GJK/EPA on random pairs");
  expectInt(shallowOff, 0, "shallow box-box contacts have their deepest point at the penetration depth");
}

fn randomShape(r: &mut Rng) Shape {
  let k = usize.from(u32.from(rand(r, 0., 5.)));
  if k == 0usize { return Shape.single(Prim.sphere(rand(r, 0.3, 0.9))); }
  if k == 1usize { return Shape.single(Prim.box(new Vec3(rand(r, 0.3, 0.9), rand(r, 0.3, 0.9), rand(r, 0.3, 0.9)))); }
  if k == 2usize { return Shape.single(Prim.capsule(rand(r, 0.2, 0.5), rand(r, 0.3, 0.8))); }
  if k == 3usize { return Shape.single(Prim.cylinder(rand(r, 0.3, 0.7), rand(r, 0.3, 0.7))); }
  var pts = List[Vec3].empty();
  var i = 0usize;
  while i < 10usize { pts.push(new Vec3(rand(r, -0.8, 0.8), rand(r, -0.8, 0.8), rand(r, -0.8, 0.8))); i = i + 1usize; }
  Shape.single(convexHull(pts.view()))
}

// On random pairs of every kind: every point's two sides differ by depth along the normal, the
// normal is a unit vector, at most 4 points, and a contact exists exactly when GJK/EPA says so
fn testInvariants() {
  var r = new Rng(909u32);
  var bad = 0i64;
  var seen = 0i64;
  var t = 0u32;
  while t < 600u32 {
    t = t + 1u32;
    let a = randomShape(&mut r);
    let b = randomShape(&mut r);
    let xa = randomRigid(&mut r, 0.2);
    let xb = randomRigid(&mut r, 1.4);
    var out = List[Manifold].empty();
    collide(&a, xa, &b, xb, 0.05, &mut out);
    let ref = convexPenetration(&a.prim, xa, &b.prim, xb, 0.05);
    if ref.hit != (out.len() == 1usize) && absf(ref.depth + 0.05) > 0.003 {
      bad = bad + 1i64;
      print <- "  seen-mismatch kinds ", a.prim.kind, " ", b.prim.kind, " ref ", i64.from(ref.hit), " depth ", f64.from(ref.depth), " manifolds ", out.len(), "\n";
    }
    if out.len() == 1usize {
      seen = seen + 1i64;
      let m = *out[0usize];
      if absf(m.normal.length() - 1.) > 0.001 || m.count < 1usize || m.count > 4usize { bad = bad + 1i64; print <- "  shape of manifold\n"; }
      var k = 0usize;
      while k < m.count {
        let gap = m.points[k].onA - m.points[k].onB;
        if absf(gap.dot(m.normal) - m.points[k].depth) > 0.002 {
          bad = bad + 1i64;
          print <- "  depth/gap kinds ", a.prim.kind, " ", b.prim.kind, " gap.n ", f64.from(gap.dot(m.normal)), " depth ", f64.from(m.points[k].depth), " count ", m.count, " refdepth ", f64.from(ref.depth), "\n";
          print <- "   a ", f64.from(a.prim.radius), " ", f64.from(a.prim.half.y), " pos ", f64.from(xa.pos.x), " ", f64.from(xa.pos.y), " ", f64.from(xa.pos.z), " rot ", f64.from(xa.rot.x), " ", f64.from(xa.rot.y), " ", f64.from(xa.rot.z), " ", f64.from(xa.rot.w), "\n";
          print <- "   b ", f64.from(b.prim.half.x), " ", f64.from(b.prim.half.y), " ", f64.from(b.prim.half.z), " pos ", f64.from(xb.pos.x), " ", f64.from(xb.pos.y), " ", f64.from(xb.pos.z), " rot ", f64.from(xb.rot.x), " ", f64.from(xb.rot.y), " ", f64.from(xb.rot.z), " ", f64.from(xb.rot.w), "\n";
          print <- "   n ", f64.from(m.normal.x), " ", f64.from(m.normal.y), " ", f64.from(m.normal.z), " ", f64.from(m.points[k].onA.x), " ", f64.from(m.points[k].onA.y), " ", f64.from(m.points[k].onA.z), "\n";
        }
        if gap.cross(m.normal).length() > 0.01 + 0.01 * gap.length() {
          bad = bad + 1i64;
          print <- "  gap not along normal kinds ", a.prim.kind, " ", b.prim.kind, " cross ", f64.from(gap.cross(m.normal).length()), "\n";
        }
        if m.points[k].depth > ref.depth + 0.003 + 0.03 * ref.depth {
          bad = bad + 1i64;
          print <- "  point deeper than penetration kinds ", a.prim.kind, " ", b.prim.kind, " ", f64.from(m.points[k].depth), " vs ", f64.from(ref.depth), "\n";
        }
        k = k + 1usize;
      }
    }
  }
  expectBool(seen > 80i64, true, "enough random pairs touch");
  expectInt(bad, 0, "manifold invariants hold on random pairs of all kinds");
}

fn testHullValid() {
  var r = new Rng(5u32);
  var bad = 0i64;
  var t = 0u32;
  while t < 60u32 {
    t = t + 1u32;
    var pts = List[Vec3].empty();
    var i = 0usize;
    while i < 40usize { pts.push(new Vec3(rand(&mut r, -1., 1.), rand(&mut r, -1., 1.), rand(&mut r, -1., 1.))); i = i + 1usize; }
    let h = convexHull(pts.view());
    // every input point is behind every face, and each face's vertices lie in its plane
    var f = 0usize;
    while f < h.faces.len() {
      let face = h.faces[f];
      var p = 0usize;
      while p < pts.len() {
        if face.normal.dot(*pts[p]) - face.d > 0.0002 { bad = bad + 1i64; }
        p = p + 1usize;
      }
      var k = 0usize;
      while k < usize.from(face.count) {
        if absf(face.normal.dot(*h.verts[usize.from(*h.faceIdx[usize.from(face.start) + k])]) - face.d) > 0.0002 { bad = bad + 1i64; }
        k = k + 1usize;
      }
      f = f + 1usize;
    }
    // closed: Euler's V - E + F = 2 with E = half the face sides
    var sides = 0usize;
    f = 0usize;
    while f < h.faces.len() { sides = sides + usize.from(h.faces[f].count); f = f + 1usize; }
    if i64.from(h.verts.len()) - i64.from(sides / 2usize) + i64.from(h.faces.len()) != 2i64 {
      bad = bad + 1i64;
      print <- "  euler: V ", h.verts.len(), " sides ", sides, " F ", h.faces.len(), " trial ", t, "\n";
    }
    // its volume is positive and its centre inside
    let mp = h.massProps();
    if mp.volume <= 0. { bad = bad + 1i64; }
  }
  expectInt(bad, 0, "random hulls: all points behind every face, faces planar, Euler's formula, positive volume");
}

fn runBroadPhase[B: BroadPhase](bp: &mut B,boxes: &List[Aabb3], statics: &List[bool], out: &mut List[BodyPair]) {
  var i = 0usize;
  while i < boxes.len() {
    bp.add(u32.from(i), *boxes[i], 1u32, 0xffffffffu32, *statics[i]);
    i = i + 1usize;
  }
  bp.pairs(out);
}

fn testBroadPhase() {
  var r = new Rng(88u32);
  var boxes = List[Aabb3].empty();
  var statics = List[bool].empty();
  var i = 0usize;
  while i < 200usize {
    let c = new Vec3(rand(&mut r, -10., 10.), rand(&mut r, -4., 4.), rand(&mut r, -10., 10.));
    boxes.push(Aabb3.fromCenter(c, new Vec3(rand(&mut r, 0.3, 1.2), rand(&mut r, 0.3, 1.2), rand(&mut r, 0.3, 1.2))));
    statics.push(i % 7usize == 0usize);
    i = i + 1usize;
  }
  var sap = SweepAndPrune.empty();
  var pairs = List[BodyPair].empty();
  runBroadPhase(&mut sap, &boxes, &statics, &mut pairs);
  // brute force, in the same (low, high) order
  var want = List[BodyPair].empty();
  i = 0usize;
  while i < boxes.len() {
    var j = i + 1usize;
    while j < boxes.len() {
      if boxes[i].overlaps(*boxes[j]) && !(*statics[i] && *statics[j]) { want.push(new BodyPair(u32.from(i), u32.from(j))); }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  expectInt(i64.from(pairs.len()), i64.from(want.len()), "sweep and prune finds the pairs brute force finds");
  var same = true;
  i = 0usize;
  while i < pairs.len() && i < want.len() {
    if pairs[i].a != want[i].a || pairs[i].b != want[i].b { same = false; }
    i = i + 1usize;
  }
  expectBool(same, true, "in sorted order");
  expectBool(want.len() > 20usize, true, "enough pairs");
  // moving a body updates its pairs; removing one drops them
  sap.update(5u32, Aabb3.fromCenter(new Vec3(100., 0., 0.), new Vec3(1., 1., 1.)));
  sap.pairs(&mut pairs);
  var with5 = 0usize;
  i = 0usize;
  while i < pairs.len() { if pairs[i].a == 5u32 || pairs[i].b == 5u32 { with5 = with5 + 1usize; } i = i + 1usize; }
  expectInt(i64.from(with5), 0, "a body moved away has no pairs");
  sap.remove(6u32);
  sap.pairs(&mut pairs);
  var with6 = 0usize;
  i = 0usize;
  while i < pairs.len() { if pairs[i].a == 6u32 || pairs[i].b == 6u32 { with6 = with6 + 1usize; } i = i + 1usize; }
  expectInt(i64.from(with6), 0, "a removed body has none");
  // queries
  var ids = List[u32].empty();
  sap.queryBox(Aabb3.fromCenter(new Vec3(0., 0., 0.), new Vec3(3., 3., 3.)), 0xffffffffu32, &mut ids);
  var brute = 0usize;
  i = 0usize;
  while i < boxes.len() {
    if i != 5usize && i != 6usize && boxes[i].overlaps(Aabb3.fromCenter(new Vec3(0., 0., 0.), new Vec3(3., 3., 3.))) { brute = brute + 1usize; }
    i = i + 1usize;
  }
  expectInt(i64.from(ids.len()), i64.from(brute), "box query");
  sap.queryRay(new Vec3(-20., 0., 0.), new Vec3(1., 0., 0.), 40., 0xffffffffu32, &mut ids);
  expectBool(ids.len() > 0usize, true, "ray query finds candidates");
  // layers: a body on a layer the mask refuses makes no pair
  var lay = SweepAndPrune.empty();
  lay.add(0u32, Aabb3.fromCenter(new Vec3(0., 0., 0.), new Vec3(1., 1., 1.)), 1u32, 1u32, false);
  lay.add(1u32, Aabb3.fromCenter(new Vec3(0.5, 0., 0.), new Vec3(1., 1., 1.)), 2u32, 3u32, false);
  var lp = List[BodyPair].empty();
  lay.pairs(&mut lp);
  expectInt(i64.from(lp.len()), 0, "body 0 does not accept layer 2");
  lay.add(0u32, Aabb3.fromCenter(new Vec3(0., 0., 0.), new Vec3(1., 1., 1.)), 1u32, 3u32, false);
  lay.pairs(&mut lp);
  expectInt(i64.from(lp.len()), 1, "now both accept each other");
}

fn main() i32 {
  testPairTable();
  testBoxBoxRandom();
  testInvariants();
  testHullValid();
  testBroadPhase();
  done()
}
