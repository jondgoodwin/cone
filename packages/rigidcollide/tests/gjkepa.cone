// GJK and EPA: hand-worked pairs, then random convex-hull pairs against a
// brute-force answer that shares no code with them.
//
// Brute force for two convex polyhedra, from their triangles:
// - overlapping: the penetration depth is the smallest overlap of the two
//   point sets projected on any face normal of either or any cross product of
//   an edge of each (the separating axis theorem is exact for polyhedra), so
//   depth = - max over those axes of the signed gap;
// - apart: the distance is the least of vertex-to-triangle distances (both
//   ways) and edge-to-edge distances.

mod gjkepa;

import testing use *;
import collections use List;
import geomath use *;
import noise;
import stdio use *;
import rigidcollide use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

struct Rng { state: u32; }

fn nextf(r: &mut Rng) f32 {
  r.state = noise.pcg(r.state + 1u32);
  noise.toUnit(r.state)
}

fn rand(r: &mut Rng, lo: f32, hi: f32) f32 { lo + (hi - lo) * nextf(r) }

fn nearV(got: Vec3, want: Vec3, within: f32, label: &Array[u8]) {
  near(got.x, want.x, within, label);
  near(got.y, want.y, within, label);
  near(got.z, want.z, within, label);
}

fn testHandWorked() {
  let s1 = Prim.sphere(1.);
  let id = Rigid.identity();
  // Two unit spheres 1.5 apart overlap by 0.5
  let p = convexPenetration(&s1, id, &s1, Rigid.at(Vec3(1.5, 0., 0.)), 0.1);
  expectBool(p.hit, true, "spheres overlap");
  near(p.depth, 0.5, 0.0001, "sphere depth");
  nearV(p.normal, Vec3(1., 0., 0.), 0.0001, "sphere normal runs from a to b");
  nearV(p.pointA, Vec3(1., 0., 0.), 0.0001, "point on a");
  nearV(p.pointB, Vec3(0.5, 0., 0.), 0.0001, "point on b");
  // Apart by 1: seen within a margin of 2, not within 0.5
  let q = convexPenetration(&s1, id, &s1, Rigid.at(Vec3(3., 0., 0.)), 2.);
  expectBool(q.hit, true, "within the margin");
  near(q.depth, -1., 0.0001, "a gap is a negative depth");
  let q2 = convexPenetration(&s1, id, &s1, Rigid.at(Vec3(3., 0., 0.)), 0.5);
  expectBool(q2.hit, false, "outside the margin");
  // Boxes: half 1 each, 1.5 apart along x: depth 0.5 (EPA, cores overlap)
  let bx = Prim.box(Vec3(1., 1., 1.));
  let b = convexPenetration(&bx, id, &bx, Rigid.at(Vec3(1.5, 0.2, 0.1)), 0.1);
  expectBool(b.hit, true, "boxes overlap");
  near(b.depth, 0.5, 0.001, "box depth");
  nearV(b.normal, Vec3(1., 0., 0.), 0.001, "box normal");
  // Boxes apart: a gap of 0.25 along x
  let c = convexPenetration(&bx, id, &bx, Rigid.at(Vec3(2.25, 0.2, 0.1)), 1.);
  near(c.depth, -0.25, 0.001, "box gap");
  // A capsule (r 0.5, segment y -1..1) and a sphere (r 0.5) at (0.8, 0.3, 0): the
  // closest approach is the segment point (0, 0.3, 0), 0.8 away, so depth 0.2
  let cap = Prim.capsule(0.5, 1.);
  let sp = Prim.sphere(0.5);
  let d = convexPenetration(&cap, id, &sp, Rigid.at(Vec3(0.8, 0.3, 0.)), 0.1);
  near(d.depth, 0.2, 0.0001, "capsule-sphere depth");
  nearV(d.normal, Vec3(1., 0., 0.), 0.0001, "capsule-sphere normal");
  nearV(d.pointA, Vec3(0.5, 0.3, 0.), 0.0001, "capsule surface point");
  // A small sphere deep in a box, near the +x face: pushed out through it
  let small = Prim.sphere(0.1);
  let e = convexPenetration(&bx, id, &small, Rigid.at(Vec3(0.7, 0.1, -0.2)), 0.1);
  expectBool(e.hit, true, "sphere inside box");
  near(e.depth, 0.4, 0.001, "depth = distance to the face 0.3 + radius 0.1");
  nearV(e.normal, Vec3(1., 0., 0.), 0.001, "out through the nearest face");
  // A cylinder standing on a box: r 0.5, half height 0.5, its base 0.1 into the top
  let cyl = Prim.cylinder(0.5, 0.5);
  let f = convexPenetration(&bx, id, &cyl, Rigid.at(Vec3(0.1, 1.4, 0.2)), 0.1);
  near(f.depth, 0.1, 0.001, "cylinder on box depth");
  nearV(f.normal, Vec3(0., 1., 0.), 0.001, "cylinder on box normal");
}

// ---- brute force ----

struct Pair { a: Vec3; b: Vec3; }

fn clamp01(x: f32) f32 { clampf(x, 0., 1.) }

// Ericson 5.1.9
fn segSeg(p1: Vec3, q1: Vec3, p2: Vec3, q2: Vec3) Pair {
  let d1 = q1 - p1;
  let d2 = q2 - p2;
  let r = p1 - p2;
  let a = d1.dot(d1);
  let e = d2.dot(d2);
  let f = d2.dot(r);
  var s = 0.f;
  var t = 0.f;
  if a <= 1.0e-12 && e <= 1.0e-12 {
    s = 0.;
  } else if a <= 1.0e-12 {
    t = clamp01(f / e);
  } else {
    let c = d1.dot(r);
    if e <= 1.0e-12 {
      s = clamp01(-c / a);
    } else {
      let b = d1.dot(d2);
      let denom = a * e - b * b;
      if denom > 1.0e-12 { s = clamp01((b * f - c * e) / denom); }
      t = (b * s + f) / e;
      if t < 0. { t = 0.; s = clamp01(-c / a); }
      else if t > 1. { t = 1.; s = clamp01((b - c) / a); }
    }
  }
  Pair(p1 + d1 * s, p2 + d2 * t)
}

fn corner(t: &Tri, k: usize) Vec3 {
  if k == 0usize { t.a } else if k == 1usize { t.b } else { t.c }
}

fn worldTris(p: &Prim, x: Rigid) List[Tri] {
  let own = p.surfaceTriangles();
  var out = List[Tri].empty();
  var i = 0usize;
  while i < own.len() {
    let t = own[i];
    out.push(Tri(x.apply(t.a), x.apply(t.b), x.apply(t.c)));
    i = i + 1usize;
  }
  out
}

fn bruteDistance(ta: &List[Tri], tb: &List[Tri]) f32 {
  var best = 1.0e30f;
  var i = 0usize;
  while i < ta.len() {
    let t = &ta[i];
    var j = 0usize;
    while j < tb.len() {
      let u = &tb[j];
      var v = 0usize;
      while v < 3usize {
        let pa = corner(t, v);
        let pb = corner(u, v);
        best = minf(best, pa.distance(closestPointOnTriangle(pa, u.a, u.b, u.c)));
        best = minf(best, pb.distance(closestPointOnTriangle(pb, t.a, t.b, t.c)));
        v = v + 1usize;
      }
      var e = 0usize;
      while e < 3usize {
        var g = 0usize;
        while g < 3usize {
          let pr = segSeg(corner(t, e), corner(t, (e + 1usize) % 3usize), corner(u, g), corner(u, (g + 1usize) % 3usize));
          best = minf(best, pr.a.distance(pr.b));
          g = g + 1usize;
        }
        e = e + 1usize;
      }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  best
}

// The gap along one axis between the two vertex sets (negative: overlap)
fn axisGap(ta: &List[Tri], tb: &List[Tri], axis: Vec3) f32 {
  var minA = 1.0e30f;
  var maxA = -1.0e30f;
  var minB = 1.0e30f;
  var maxB = -1.0e30f;
  var i = 0usize;
  while i < ta.len() {
    var k = 0usize;
    while k < 3usize {
      let d = corner(&ta[i], k).dot(axis);
      minA = minf(minA, d); maxA = maxf(maxA, d);
      k = k + 1usize;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < tb.len() {
    var k = 0usize;
    while k < 3usize {
      let d = corner(&tb[i], k).dot(axis);
      minB = minf(minB, d); maxB = maxf(maxB, d);
      k = k + 1usize;
    }
    i = i + 1usize;
  }
  maxf(minB - maxA, minA - maxB)
}

fn triNormal(t: &Tri) Vec3 { (t.b - t.a).cross(t.c - t.a).normalize() }

// The largest signed gap over every face normal and edge-edge cross product
fn bruteSignedGap(ta: &List[Tri], tb: &List[Tri]) f32 {
  var best = -1.0e30f;
  var i = 0usize;
  while i < ta.len() {
    best = maxf(best, axisGap(ta, tb, triNormal(&ta[i])));
    i = i + 1usize;
  }
  i = 0usize;
  while i < tb.len() {
    best = maxf(best, axisGap(ta, tb, triNormal(&tb[i])));
    i = i + 1usize;
  }
  i = 0usize;
  while i < ta.len() {
    var j = 0usize;
    while j < tb.len() {
      var e = 0usize;
      while e < 3usize {
        let ea = corner(&ta[i], (e + 1usize) % 3usize) - corner(&ta[i], e);
        var g = 0usize;
        while g < 3usize {
          let eb = corner(&tb[j], (g + 1usize) % 3usize) - corner(&tb[j], g);
          let cr = ea.cross(eb);
          if cr.length() > 1.0e-4 { best = maxf(best, axisGap(ta, tb, cr.normalize())); }
          g = g + 1usize;
        }
        e = e + 1usize;
      }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  best
}

fn randomHull(r: &mut Rng, n: usize) Prim {
  var pts = List[Vec3].empty();
  var i = 0usize;
  while i < n {
    pts.push(Vec3(rand(r, -1., 1.), rand(r, -0.8, 0.8), rand(r, -0.6, 0.6)));
    i = i + 1usize;
  }
  convexHull(pts.view())
}

fn randomRigid(r: &mut Rng, spread: f32) Rigid {
  let axis = Vec3(rand(r, -1., 1.), rand(r, -1., 1.), rand(r, -1., 1.)).normalize();
  Rigid(Vec3(rand(r, -spread, spread), rand(r, -spread, spread), rand(r, -spread, spread)),
    Quat.angleAxis(rand(r, 0., 6.2831853), axis))
}

fn testRandomHulls() {
  var r = Rng(12345u32);
  var overlaps = 0i64;
  var apart = 0i64;
  var worstDist = 0.f;
  var worstDepth = 0.f;
  var failures = 0i64;
  var trial = 0u32;
  while trial < 250u32 {
    trial = trial + 1u32;
    let ha = randomHull(&mut r, 9usize + usize.from(trial % 6u32));
    let hb = randomHull(&mut r, 9usize + usize.from(trial % 5u32));
    let xa = randomRigid(&mut r, 0.3);
    let xb = randomRigid(&mut r, 1.2);
    let ta = worldTris(&ha, xa);
    let tb = worldTris(&hb, xb);
    let gap = bruteSignedGap(&ta, &tb);
    let pen = convexPenetration(&ha, xa, &hb, xb, 100.);
    if gap > 0.01 {
      apart = apart + 1i64;
      let want = bruteDistance(&ta, &tb);
      let err = absf(-pen.depth - want);
      worstDist = maxf(worstDist, err);
      if err > 0.002 || !pen.hit { failures = failures + 1i64; }
    } else if gap < -0.01 {
      overlaps = overlaps + 1i64;
      let err = absf(pen.depth + gap);
      worstDepth = maxf(worstDepth, err);
      if err > 0.003 || !pen.hit { failures = failures + 1i64; }
    }
  }
  print <- "overlaps ", overlaps, " apart ", apart, " worst dist ", f64.from(worstDist), " depth ", f64.from(worstDepth), "\n";
  expectBool(overlaps > 25i64 && apart > 25i64, true, "the random pairs include both overlapping and separate ones");
  expectInt(failures, 0, "no random pair disagrees with brute force");
  expectBool(worstDist < 0.002, true, "worst distance error under 0.002");
  expectBool(worstDepth < 0.003, true, "worst depth error under 0.003");
}

fn main() i32 {
  testHandWorked();
  testRandomHulls();
  done()
}
