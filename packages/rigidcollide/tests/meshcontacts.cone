// Regressions found building rigiddynamics on rigidcollide, each the exact case:
//
//  1. A box centred on the shared diagonal of two coplanar triangles (a 40 m
//     two-triangle mesh, half-size 0.5, pressed 16 mm in, centre on x = z)
//     got no manifold at all. GJK worked with the 40 m triangles' long thin
//     simplices in 32 bits, lost the origin and called the box clear of the
//     mesh.
//  2. EPA gave a depth of 2.7 m for a 0.87 m box on a big triangle.
//  3. A box resting on a flat mesh or heightfield got one manifold per
//     triangle, normals leaning a degree or two and depths differing by
//     centimetres, so it jittered: now one manifold of at most four points
//     with the face's own normal.

mod meshcontacts;

import testing use *;
import collections use List;
import geomath use *;
import stdio use *;
import rigidcollide use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

// A 40 m square at y = 0 from two triangles whose shared edge is the diagonal x = z
fn bigTwoTriangles() Shape {
  var verts = List[Vec3].empty();
  verts.push(Vec3(-20., 0., -20.));
  verts.push(Vec3(20., 0., -20.));
  verts.push(Vec3(20., 0., 20.));
  verts.push(Vec3(-20., 0., 20.));
  var idx = List[u32].empty();
  idx.push(0u32); idx.push(3u32); idx.push(2u32);
  idx.push(0u32); idx.push(2u32); idx.push(1u32);
  Shape.single(meshPrim(verts, idx))
}

// An n x n grid of quads of side 'cell' from (-n cell / 2, 0, -n cell / 2), each split
// along alternating diagonals, all flat and facing up
fn flatGrid(n: u32, cell: f32) Shape {
  var verts = List[Vec3].empty();
  var j = 0u32;
  while j <= n {
    var i = 0u32;
    while i <= n {
      verts.push(Vec3((f32.from(i) - f32.from(n) * 0.5) * cell, 0., (f32.from(j) - f32.from(n) * 0.5) * cell));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  var idx = List[u32].empty();
  j = 0u32;
  while j < n {
    var i = 0u32;
    while i < n {
      let v00 = j * (n + 1u32) + i;
      let v10 = v00 + 1u32;
      let v01 = v00 + n + 1u32;
      let v11 = v01 + 1u32;
      if (i + j) % 2u32 == 0u32 {
        idx.push(v00); idx.push(v01); idx.push(v11);
        idx.push(v00); idx.push(v11); idx.push(v10);
      } else {
        idx.push(v00); idx.push(v01); idx.push(v10);
        idx.push(v10); idx.push(v01); idx.push(v11);
      }
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  Shape.single(meshPrim(verts, idx))
}

fn flatHeightfield() Shape {
  var h = List[f32].empty();
  var k = 0u32;
  while k < 81u32 { h.push(0.); k = k + 1u32; }
  Shape.single(Prim.heightfield(h, 9u32, 9u32, 5., 5., Vec3(-20., 0., -20.)))
}

// A 1 m box sitting 'press' into the ground at (x, z), turned by yaw about y and
// leaned by lean about x
fn boxPose(x: f32, z: f32, press: f32, yaw: f32, lean: f32) Rigid {
  Rigid(Vec3(x, 0.5 - press, z), Quat.angleAxis(yaw, Vec3(0., 1., 0.)) * Quat.angleAxis(lean, Vec3(1., 0., 0.)))
}

fn pointsOf(out: &List[Manifold]) usize {
  var n = 0usize;
  var i = 0usize;
  while i < out.len() { n = n + (*out[i]).count; i = i + 1usize; }
  n
}

// 1. The box on the diagonal gets one manifold of four points, up, 16 mm deep
fn testDiagonal() {
  let ground = bigTwoTriangles();
  let box = Shape.single(Prim.box(Vec3(0.5, 0.5, 0.5)));
  // the poses (position along the diagonal, yaw, lean) that returned nothing, and some plain ones
  let xs = [0.05f, -0.95, -0.5, 4.5, 0., 3., -7., 12.5];
  let yaws = [31.557f, 28.417, 29.83, 45.53, 0., 0.7854, 0.3, 1.2];
  let leans = [0.01f, 0.004, 0.012, 0.004, 0., 0., 0.002, 0.];
  var none = 0;
  var wrong = 0;
  var k = 0usize;
  while k < 8usize {
    var out = List[Manifold].empty();
    collide(&ground, Rigid.identity(), &box, boxPose(xs[k], xs[k], 0.016, yaws[k], leans[k]), 0.02, &mut out);
    if out.len() == 0usize { none = none + 1; }
    else if out.len() != 1usize || (*out[0usize]).normal.y < 0.9999 || (*out[0usize]).count < 3usize { wrong = wrong + 1; }
    k = k + 1usize;
  }
  expectInt(i64.from(none), 0, "a box centred on the diagonal always has a manifold");
  expectInt(i64.from(wrong), 0, "and it is one manifold, up, of three or four points");
  // The scan that found it: 400 poses along the diagonal, none empty
  var zero = 0;
  k = 0usize;
  while k < 400usize {
    let fk = f32.from(k);
    let px = (fk - 200.) * 0.05;
    let lean = if k % 3usize == 0usize { 0. } else { (fk % 7.) * 0.002 };
    var out = List[Manifold].empty();
    collide(&ground, Rigid.identity(), &box, boxPose(px, px, 0.016, fk * 0.157, lean), 0.02, &mut out);
    if out.len() == 0usize { zero = zero + 1; }
    k = k + 1usize;
  }
  expectInt(i64.from(zero), 0, "400 poses on the diagonal, none empty");
  // the plain case in numbers
  var out = List[Manifold].empty();
  collide(&ground, Rigid.identity(), &box, boxPose(3., 3., 0.016, 0., 0.), 0.02, &mut out);
  expectInt(i64.from(out.len()), 1, "axis-aligned on the diagonal: one manifold");
  expectInt(i64.from((*out[0usize]).count), 4, "four points");
  near((*out[0usize]).deepest(), 0.016, 0.0005, "16 mm deep");
}

// 2. Depths are the size of the penetration, never metres
fn testDepth() {
  let ground = bigTwoTriangles();
  let box = Shape.single(Prim.box(Vec3(0.435, 0.435, 0.435)));
  var bad = 0;
  var worst = 0.f;
  var i = 0;
  while i < 3000 {
    let fi = f32.from(i);
    let ax = Vec3(sin(fi * 1.7), cos(fi * 0.9) + 0.1, sin(fi * 0.37) + 0.2).normalize();
    let rot = Quat.angleAxis(fi * 0.731, ax);
    let pos = Vec3(sin(fi * 2.3) * 15., 0.25 + 0.2 * (0.5 + 0.5 * sin(fi * 5.1)), cos(fi * 3.1) * 15.);
    var out = List[Manifold].empty();
    collide(&ground, Rigid.identity(), &box, Rigid(pos, rot), 0.02, &mut out);
    var m = 0usize;
    while m < out.len() {
      let d = (*out[m]).deepest();
      worst = maxf(worst, d);
      // the lowest a corner of a 0.87 m box can be with its centre this high is 0.25 - 0.754
      if d > 0.55 { bad = bad + 1; }
      m = m + 1usize;
    }
    i = i + 1;
  }
  expectInt(i64.from(bad), 0, "no depth beyond what the pose allows");
  expectBool(worst < 0.55, true, "the worst depth is under 0.55 m");
  // GJK/EPA straight on the triangles of the case that failed: the box, 16 mm in, centred on the diagonal
  let tri0 = Prim.triangle(Vec3(-20., 0., -20.), Vec3(-20., 0., 20.), Vec3(20., 0., 20.));
  let tri1 = Prim.triangle(Vec3(-20., 0., -20.), Vec3(20., 0., 20.), Vec3(20., 0., -20.));
  let bp = Prim.box(Vec3(0.5, 0.5, 0.5));
  let xb = boxPose(0.05, 0.05, 0.016, 31.557, 0.01);
  let p0 = convexPenetration(&tri0, Rigid.identity(), &bp, xb, 0.02);
  let p1 = convexPenetration(&tri1, Rigid.identity(), &bp, xb, 0.02);
  expectBool(p0.hit && p1.hit, true, "GJK finds the overlap with each 40 m triangle");
  near(p0.depth, 0.02, 0.01, "EPA depth with the first triangle");
  near(p1.depth, 0.02, 0.01, "EPA depth with the second");
  near(p0.normal.y, 1., 0.01, "pushing up");
  // a capsule, a cylinder and a hull on the same ground, also centred on the diagonal
  let cap = Prim.capsule(0.3, 0.5);
  let xc = Rigid(Vec3(1.5, 0.3 - 0.01, 1.5), Quat.angleAxis(1.5707964, Vec3(1., 0., 0.)));
  let pc = convexPenetration(&tri0, Rigid.identity(), &cap, xc, 0.02);
  near(pc.depth, 0.01, 0.005, "a capsule lying across the diagonal, 10 mm in");
  let cyl = Prim.cylinder(0.4, 0.5);
  let xy = Rigid(Vec3(-2., 0.49, -2.), Quat.identity());
  let py = convexPenetration(&tri1, Rigid.identity(), &cyl, xy, 0.02);
  near(py.depth, 0.01, 0.005, "a cylinder standing on the diagonal");
}

// 3. One manifold per box on flat ground, the face's normal, at most four points
fn flatPatch(ground: &Shape, label: &Array[u8]) {
  let box = Shape.single(Prim.box(Vec3(0.435, 0.435, 0.435)));
  var manifolds = 0;
  var multi = 0;
  var leaning = 0;
  var points = 0;
  var empty = 0;
  var i = 0;
  while i < 200 {
    let fi = f32.from(i);
    // over cell centres, vertices (every 5 m), edges and the diagonals, turned and leaned by up to a degree and a half
    let x = (fi % 17.) * 2.5 - 20. + sin(fi) * 0.4;
    let z = (fi % 13.) * 3.1 - 18. + cos(fi * 1.3) * 0.4;
    let lean = (fi % 5.) * 0.005 - 0.01;
    var out = List[Manifold].empty();
    collide(ground, Rigid.identity(), &box, Rigid(Vec3(x, 0.435 - 0.012, z),
      Quat.angleAxis(fi * 0.37, Vec3(0., 1., 0.)) * Quat.angleAxis(lean, Vec3(0., 0., 1.))), 0.02, &mut out);
    if out.len() == 0usize { empty = empty + 1; }
    if out.len() > 1usize { multi = multi + 1; }
    var m = 0usize;
    while m < out.len() {
      let mf = *out[m];
      manifolds = manifolds + 1;
      points = points + i32.from(mf.count);
      if mf.normal.y < 0.99999 { leaning = leaning + 1; }
      if mf.count > 4usize { points = points + 1000; }
      m = m + 1usize;
    }
    i = i + 1;
  }
  expectInt(i64.from(empty), 0, label);
  expectInt(i64.from(multi), 0, "one manifold for each box, however many triangles it covers");
  expectInt(i64.from(leaning), 0, "every normal is exactly the ground's");
  expectBool(points < 1000, true, "at most four points each");
  expectBool(points >= 3 * manifolds, true, "at least three points each");
}

fn testFlatPatches() {
  flatPatch(&flatGrid(8u32, 5.), "box on a flat mesh: never empty");
  flatPatch(&flatHeightfield(), "box on a flat heightfield: never empty");
  // depths of one manifold agree to a millimetre when the box is flat
  let ground = flatGrid(8u32, 5.);
  let box = Shape.single(Prim.box(Vec3(0.435, 0.435, 0.435)));
  var out = List[Manifold].empty();
  collide(&ground, Rigid.identity(), &box, Rigid(Vec3(2.5, 0.435 - 0.012, 2.5), Quat.angleAxis(0.4, Vec3(0., 1., 0.))), 0.02, &mut out);
  expectInt(i64.from(out.len()), 1, "a box over the corner where four quads meet: one manifold");
  let mf = *out[0usize];
  expectInt(i64.from(mf.count), 4, "four points");
  near(mf.normal.y, 1., 0.00001, "normal up");
  var lo = 1000.f;
  var hi = -1000.f;
  var k = 0usize;
  while k < mf.count { lo = minf(lo, mf.points[k].depth); hi = maxf(hi, mf.points[k].depth); k = k + 1usize; }
  near(hi - lo, 0., 0.001, "all four 12 mm deep to a millimetre");
  near(hi, 0.012, 0.001, "12 mm");
  // a box leaned a degree: depths differ along the tilt, but still one manifold on the face's normal
  var out2 = List[Manifold].empty();
  collide(&ground, Rigid.identity(), &box, Rigid(Vec3(2.5, 0.43, 2.5), Quat.angleAxis(0.017, Vec3(1., 0., 0.))), 0.02, &mut out2);
  expectInt(i64.from(out2.len()), 1, "leaned a degree: one manifold");
  near((*out2[0usize]).normal.y, 1., 0.00001, "on the face's normal");
  // a box on a ledge is not merged into the floor beyond its own face: a wall contact keeps its normal
  var out3 = List[Manifold].empty();
  let wallBox = Shape.single(Prim.box(Vec3(0.5, 0.5, 0.5)));
  collide(&ground, Rigid.identity(), &wallBox, Rigid(Vec3(0., 0.5 - 0.01, 0.), Quat.identity()), 0.02, &mut out3);
  expectInt(i64.from(out3.len()), 1, "a plain box at the grid's centre");
}

fn main() i32 {
  testDiagonal();
  testDepth();
  testFlatPatches();
  done()
}
