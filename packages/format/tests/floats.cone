// Float options: fixed, digits and sci against the exact decimal value of the
// float, rounded half to even. The expected texts were made by Python's
// '%.nf', '%.ne' (exact, correctly rounded) from the same literal, and the
// ties and the near-ties (0.125, 2.5, 19.995, 1.005, 2.675, 1e23) checked
// against the exact values: 1.005 is 1.00499999999999989... in an f64, so it
// is "1.00", and 19.995 is 19.99500000000000099... so it is "20.00". Also the
// largest finite, the smallest subnormal, the zeros, n of 0 and of 40, an f32
// against the f64 of the same literal, the wrappers inside a send list, and
// 'toDebug' writing what 'toText' writes.

mod floats;

import testing use *;
import collections use String;
import format use *;

// A type with its own toText sends every wrapper on to a TextOut
struct All {
  pub fn toText(self: &, out: &uni TextOut) {
    out <- fixed(0.125, 2), "|", digits(1234.5, 6), "|", sci(1234.5, 2), "|", hex(255u8), "|", oct(8), "|", bin(5), "|", signed(7);
  }
}

fn chk(w: FloatFormat, want: &Array[u8], label: &Array[u8]) {
  var s = String();
  s <- w;
  expectStr(s.view(), want, label);
}

fn text(w: FloatFormat) String {
  var s = String();
  s <- w;
  s
}

fn main() i32 {
  chk(fixed(0.125, 0), "0", "fixed 0.125 0");
  chk(sci(0.125, 0), "1e-01", "sci 0.125 0");
  chk(digits(0.125, 0), "0.1", "digits 0.125 0");
