  // nan and inf as the default form writes them, whatever the option
  let z = 0.0;
  chk(fixed(z / z, 2), "nan", "nan fixed");
  chk(sci(z / z, 2), "nan", "nan sci");
  chk(digits(z / z, 2), "nan", "nan digits");
  chk(fixed(1.0 / z, 2), "inf", "inf fixed");
  chk(sci(0.0 - 1.0 / z, 2), "-inf", "-inf sci");
  chk(digits(1.0 / z, 3), "inf", "inf digits");

  // An integer type for n, and a negative n is 0
  chk(fixed(2.5, 1u8), "2.5", "u8 n");
  chk(fixed(2.5, 0i64 - 3i64), "2", "negative n");
  chk(digits(2.5, 0), "2", "digits 0 is 1");

  // An f32 is not widened where that changes digits: its exact value is the
  // f64 of the same value, so 20 places of 0.1f32 differ from those of 0.1
  chk(fixed(0.1f32, 20), "0.10000000149011611938", "f32 0.1");
  chk(fixed(0.1, 20), "0.10000000000000000555", "f64 0.1");

  // Inside a send list, with other pieces, and the debug form of the wrapper
  var s = String();
  s <- "total ", fixed(1.005, 2), " ", sci(1234.5, 2), " ", digits(1234.5, 6);
  expectStr(s.view(), "total 1.00 1.23e+03 1234.50", "send list");
  var d = String();
  let w = fixed(0.125, 2);
  d <- toDebug(&w), "|", toText(&w);
  expectStr(d.view(), "0.12|0.12", "debug and display forms");

  // Each wrapper into a TextOut, through a type's own toText
  var o = String();
  o <- "[", All(), "]";
  expectStr(o.view(), "[0.12|1234.50|1.23e+03|ff|10|101|+7]", "TextOut");

  // A huge n writes that many zeros: 1.0 to 1000 places is "1." and 1000 zeros
  let big = text(fixed(1.0, 1000));
  expectUInt(u64.from(big.view().len()), 1002u64, "huge n length");

  // $"..." is on text-pr5-wants, not this branch: test it once that lands
  return done();
}
