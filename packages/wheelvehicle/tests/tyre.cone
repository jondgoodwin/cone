// The tyre model (src/tyre.cone), each check against a number worked out by hand.
//
// 1. The Magic Formula peaks at 1 exactly at x = 1 (B = tan(pi / 2C) puts the peak there) and is zero at 0.
// 2. It falls toward sin(C pi / 2) = 0.809 (C = 1.4) when sliding: at x = 60 within 0.01.
// 3. It is odd: f(-x) = -f(x).
// 4. A tyre at its peak slip ratio, straight, at the nominal load 3000 N gives mu Fz = 1.1 * 3000 = 3300 N.
// 5. The friction circle: for any mix of slips the force's length is mu Fz f(nu), nu the combined slip, in the
//    direction of the slip: checked at five mixes to 1e-3 of mu Fz.
// 6. Load sensitivity: at twice the nominal load the grip is 1.1 (1 - 0.2) = 0.88: the peak force at 6000 N is
//    5280 N (not 6600).
// 7. Surface grip scales the force: 0.3 on wet road gives 0.3 of the dry peak.
// 8. Signs: a wheel faster than the ground pushes the car forward (+fx); a slip to the right gives a force to the
//    left (-fy).
// 9. No load, no force.

mod tyretest;

import testing use *;
import geomath use *;
import libc;
import wheelvehicle use *;

fn main() i32 {
  let t = TyreSpec.road();
  expectFloat(f64.from(magic(1., 1.4)), 1.0, 0.0001, "the magic formula peaks at 1 at x = 1");
  expectFloat(f64.from(magic(0., 1.4)), 0.0, 0.0001, "and is zero at zero slip");
  expectFloat(f64.from(magic(60., 1.4)), 0.809, 0.01, "it falls to sin(C pi / 2) when sliding");
  expectFloat(f64.from(magic(-0.7, 1.4) + magic(0.7, 1.4)), 0.0, 0.00001, "and is odd");
  expect(magic(0.5, 1.4) < 1. and magic(2., 1.4) < 1., "below the peak on both sides");
  let peak = tyreForce(&t, 3000., 0.12, 0., 1.);
  expectFloat(f64.from(peak.fx), 3300.0, 1.0, "peak longitudinal force is mu Fz");
  expectFloat(f64.from(peak.fy), 0.0, 0.001, "with no lateral force at zero slip angle");
  // the friction circle
  var worst = 0.f;
  var k = 0;
  while k < 5 {
    let kappa = 0.03 + 0.05 * f32.from(k);
    let tanA = 0.2 - 0.04 * f32.from(k);
    let f = tyreForce(&t, 3000., kappa, tanA, 1.);
    let nu = ((kappa / 0.12) * (kappa / 0.12) + (tanA / 0.15) * (tanA / 0.15)).sqrt();
    let expectedLen = 3300. * magic(nu, 1.4);
    let len = (f.fx * f.fx + f.fy * f.fy).sqrt();
    let e = libc.fabsf(len - expectedLen) / 3300.;
    if e > worst { worst = e; }
    // direction: fx / fy = -(kappa / kp) / (tanA / ap)
    let dirErr = libc.fabsf(f.fx * (tanA / 0.15) + f.fy * (kappa / 0.12)) / 3300.;
    if dirErr > worst { worst = dirErr; }
    k = k + 1;
  }
  expectFloat(f64.from(worst), 0.0, 0.001, "the friction circle: length mu Fz f(nu) along the slip");
  let loaded = tyreForce(&t, 6000., 0.12, 0., 1.);
  expectFloat(f64.from(loaded.fx), 5280.0, 1.0, "load sensitivity: at 6000 N the grip is 0.88");
  let wet = tyreForce(&t, 3000., 0.12, 0., 0.3);
  expectFloat(f64.from(wet.fx), 990.0, 1.0, "wet road: 0.3 of the dry force");
  let fwd = tyreForce(&t, 3000., 0.05, 0., 1.);
  let side = tyreForce(&t, 3000., 0., 0.1, 1.);
  expect(fwd.fx > 0., "a faster wheel pushes the car forward");
  expect(side.fy < 0., "a slip to the right pushes to the left");
  expectFloat(f64.from(tyreForce(&t, 0., 0.1, 0.1, 1.).fx), 0.0, 0.0001, "no load, no force");
  done()
}
