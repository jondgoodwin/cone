// The wheelvehicle package (a working name; Jon names packages): anything on wheels, from data. A program
// reaches it with 'import wheelvehicle' (and 'import rigiddynamics' for the World it adds to):
//
//   mut world = World.make();
//   // ... static ground: world.addShape(...), world.createBody(BodyDef.staticAt(...)) ...
//   mut car = Vehicle.create(&mut world, VehicleSpec.sedan(), Vec3(0., 0.7, 0.), Quat.identity());
//   // every step (1/120 s or smaller), BEFORE world.step(dt):
//   car.drive(throttle, brake, steering);          // 0..1, 0..1, -1..1 (right positive)
//   car.apply(&mut world, (x, z) => 1., dt);       // the grip of the ground at (x, z): 1 dry, 0.1 ice
//   world.step(dt);
//   // then read: car.kmh(), car.rpm, car.gear, car.wheels[i].load / .slipRatio / .hub / .spin ...
//
// FILES. Only this root imports.
//   tyre.cone        TyreSpec, tyreForce: the Magic Formula with a friction circle
//   drivetrain.cone  EngineSpec, GearboxSpec, DiffSpec
//   vehicle.cone     WheelSpec, VehicleSpec, WheelState, Vehicle: raycast suspension, steering, drive, brakes
//   specs.cone       VehicleSpec.sedan(), .buggy(), .truck(): three data-defined vehicles
//
// WHAT IT DOES NOT DO: trailers and articulation (they are joints in rigiddynamics); tyre temperature and wear;
// camber, toe and suspension geometry (a wheel moves straight along the chassis's up axis); the tyre's own
// compliance (no relaxation length); a static-friction hold at standstill (a stopped car on a slope creeps a
// few mm/s); damage; a manual clutch pedal and stalling.

mod wheelvehicle;

import libc;
import collections use *;
import geomath use *;
import rigidcollide use *;
import rigiddynamics use *;
