// ======== Three vehicles, as data ========
//
// Plain test subjects, not designed vehicles: the numbers are plausible, not a particular car's.
//
//   sedan   1,300 kg, rear-wheel drive, five-speed automatic, open differential, road tyres, 4.2 m long.
//   buggy   900 kg, four-wheel drive, limited-slip differentials, long-travel suspension, off-road tyres.
//   truck   5,000 kg, six wheels (a steered front axle and two driven rear axles), six speeds, stiff
//           suspension: shows that nothing here is a four-wheel car.
//
// The mounts are relative to the centre of mass (the middle of the chassis box); the ground is about
// 'rideHeight' below it at rest (the sedan's 0.53 m, the buggy's 0.75 m, the truck's 0.95 m).

fn wheel(x: f32, y: f32, z: f32, radius: f32, travel: f32, k: f32, bump: f32, rebound: f32, axle: usize, steer: f32, brake: f32,
         handbrake: f32, inertia: f32, tyre: TyreSpec) WheelSpec {
  WheelSpec(Vec3(x, y, z), radius, radius * 0.6, travel, k, bump, rebound, axle, steer, brake, handbrake, inertia, tyre)
}

pub fn sedanSpec() VehicleSpec {
  var w = List[WheelSpec].empty();
    w.push(wheel(1.3, 0.05, -0.8, 0.33, 0.35, 32000., 2800., 3600., 0usize, 1., 1900., 0., 1.2, TyreSpec.road()));
    w.push(wheel(1.3, 0.05, 0.8, 0.33, 0.35, 32000., 2800., 3600., 0usize, 1., 1900., 0., 1.2, TyreSpec.road()));
    w.push(wheel(-1.3, 0.05, -0.8, 0.33, 0.35, 32000., 2800., 3600., 1usize, 0., 1100., 1800., 1.2, TyreSpec.road()));
    w.push(wheel(-1.3, 0.05, 0.8, 0.33, 0.35, 32000., 2800., 3600., 1usize, 0., 1100., 1800., 1.2, TyreSpec.road()));
    var c = List[Vec2].empty();
    c.push(Vec2(1000., 150.)); c.push(Vec2(2000., 200.)); c.push(Vec2(3000., 235.)); c.push(Vec2(4000., 250.));
    c.push(Vec2(5000., 260.)); c.push(Vec2(6000., 245.)); c.push(Vec2(6800., 200.));
    var r = List[f32].empty();
    r.push(3.4); r.push(2.1); r.push(1.45); r.push(1.05); r.push(0.82);
    var share = List[f32].empty();
    share.push(0.); share.push(1.);
    var diffs = List[DiffSpec].empty();
    diffs.push(DiffSpec.open()); diffs.push(DiffSpec.open());
    var roll = List[f32].empty();
    roll.push(9000.); roll.push(6000.);
    VehicleSpec(1300., Vec3(2.1, 0.3, 0.85), w, EngineSpec(c, 900., 6800., 0.25, 60.),
      GearboxSpec(r, 3.2, 3.6, 0.9, 6000., 2300., 0.25, 1800., 330.), share, diffs, roll, 0.7, 0.15, 0.5, 0.07, 40., 2.5)
  }

pub fn buggySpec() VehicleSpec {
  var w = List[WheelSpec].empty();
    w.push(wheel(1.2, 0.1, -0.8, 0.4, 0.55, 22000., 2500., 3200., 0usize, 1., 1200., 0., 1.8, TyreSpec.offroad()));
    w.push(wheel(1.2, 0.1, 0.8, 0.4, 0.55, 22000., 2500., 3200., 0usize, 1., 1200., 0., 1.8, TyreSpec.offroad()));
    w.push(wheel(-1.2, 0.1, -0.8, 0.4, 0.55, 22000., 2500., 3200., 1usize, 0., 800., 1200., 1.8, TyreSpec.offroad()));
    w.push(wheel(-1.2, 0.1, 0.8, 0.4, 0.55, 22000., 2500., 3200., 1usize, 0., 800., 1200., 1.8, TyreSpec.offroad()));
    var c = List[Vec2].empty();
    c.push(Vec2(1000., 130.)); c.push(Vec2(2500., 190.)); c.push(Vec2(4000., 215.)); c.push(Vec2(5500., 200.));
    c.push(Vec2(7000., 150.));
    var r = List[f32].empty();
    r.push(3.2); r.push(2.0); r.push(1.4); r.push(1.0);
    var share = List[f32].empty();
    share.push(0.45); share.push(0.55);
    var diffs = List[DiffSpec].empty();
    diffs.push(DiffSpec.limited(150., 0.4)); diffs.push(DiffSpec.limited(150., 0.4));
    var roll = List[f32].empty();
    roll.push(2500.); roll.push(2500.);
    VehicleSpec(900., Vec3(1.4, 0.25, 0.8), w, EngineSpec(c, 1000., 7000., 0.2, 45.),
      GearboxSpec(r, 3.0, 3.8, 0.88, 6200., 2600., 0.2, 1800., 300.), share, diffs, roll, 0.9, 0.05, 0.5, 0.1, 30., 3.)
  }

pub fn truckSpec() VehicleSpec {
  var w = List[WheelSpec].empty();
    w.push(wheel(2.2, 0.1, -1.0, 0.5, 0.4, 90000., 9000., 12000., 0usize, 1., 6000., 0., 6., TyreSpec.road()));
    w.push(wheel(2.2, 0.1, 1.0, 0.5, 0.4, 90000., 9000., 12000., 0usize, 1., 6000., 0., 6., TyreSpec.road()));
    w.push(wheel(-1.0, 0.1, -1.0, 0.5, 0.4, 90000., 9000., 12000., 1usize, 0., 5000., 4000., 6., TyreSpec.road()));
    w.push(wheel(-1.0, 0.1, 1.0, 0.5, 0.4, 90000., 9000., 12000., 1usize, 0., 5000., 4000., 6., TyreSpec.road()));
    w.push(wheel(-2.4, 0.1, -1.0, 0.5, 0.4, 90000., 9000., 12000., 2usize, 0., 5000., 4000., 6., TyreSpec.road()));
    w.push(wheel(-2.4, 0.1, 1.0, 0.5, 0.4, 90000., 9000., 12000., 2usize, 0., 5000., 4000., 6., TyreSpec.road()));
    var c = List[Vec2].empty();
    c.push(Vec2(800., 700.)); c.push(Vec2(1400., 1100.)); c.push(Vec2(2000., 1250.)); c.push(Vec2(2600., 1100.));
    c.push(Vec2(3000., 800.));
    var r = List[f32].empty();
    r.push(6.5); r.push(4.2); r.push(2.9); r.push(2.0); r.push(1.4); r.push(1.0);
    var share = List[f32].empty();
    share.push(0.); share.push(0.5); share.push(0.5);
    var diffs = List[DiffSpec].empty();
    diffs.push(DiffSpec.open()); diffs.push(DiffSpec.open()); diffs.push(DiffSpec.open());
    var roll = List[f32].empty();
    roll.push(30000.); roll.push(30000.); roll.push(30000.);
    VehicleSpec(5000., Vec3(3.2, 0.4, 1.0), w, EngineSpec(c, 700., 3000., 1.5, 150.),
      GearboxSpec(r, 6.0, 4.1, 0.9, 2600., 1100., 0.4, 1000., 1500.), share, diffs, roll, 4.5, 0., 0.35, 0.1, 20., 1.5)
}
