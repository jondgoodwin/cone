// The test head's textures, painted from the head's own shape.
//
// The skin texture is painted in the lathe's own coordinates (the angle
// round the head and the height), the way the mesh's uvs run. For each
// texel the head's rest position is found by the same function that placed the mesh's
// vertices, so a feature painted at a place on the face is at that place on
// the mesh: the lip's colour is on the lip, the lash line is on the lid's
// rim (found from the displaced point's angles about the eyeball, as the
// eye operation finds them), the brow is on the brow ridge. Colours are
// sRGB bytes.

fn hashUnit(i i32, j i32, seed u32) f32 {
  imm a = pcg(u32.from(i) * 73856093u32 + u32.from(j) * 19349663u32 + seed * 83492791u32);
  f32.from(a >> 8u32) * 0.000000059604644775390625;
}

// Value noise in [0, 1]
fn valueNoise(x f32, y f32, seed u32) f32 {
  imm xi = libc.floorf(x);
  imm yi = libc.floorf(y);
  imm fx = x - xi;
  imm fy = y - yi;
  imm sx = fx * fx * (3. - 2. * fx);
  imm sy = fy * fy * (3. - 2. * fy);
  imm i = i32.from(xi);
  imm j = i32.from(yi);
  imm a = hashUnit(i, j, seed);
  imm b = hashUnit(i + 1, j, seed);
  imm c = hashUnit(i, j + 1, seed);
  imm d = hashUnit(i + 1, j + 1, seed);
  (a + (b - a) * sx) + ((c + (d - c) * sx) - (a + (b - a) * sx)) * sy;
}

fn mixc(a Vec3, b Vec3, t f32) Vec3 { a + (b - a) * clampf(t, 0., 1.); }

fn byteOf(v f32) u8 {
  if v <= 0. { return 0u8; }
  if v >= 255. { return 255u8; }
  u8.from(v + 0.5);
}

fn putPixel(p &mut Pixels, x i32, y i32, c Vec3) {
  imm at = usize.from((y * p.width + x) * 4);
  p.rgba.set(at, byteOf(c.x));
  p.rgba.set(at + 1usize, byteOf(c.y));
  p.rgba.set(at + 2usize, byteOf(c.z));
  p.rgba.set(at + 3usize, 255u8);
}

// Distance from (x, y) to the polyline, and how far along it (0 to 1)
fn polylineDistance(x f32, y f32, xs &Array[f32], ys &Array[f32]) Vec2 {
  mut best = 1000000.;
  mut along = 0.;
  mut total = 0.;
  mut s = 0usize;
  while s + 1usize < xs.len {
    total = total + ((xs[s + 1usize] - xs[s]) * (xs[s + 1usize] - xs[s]) + (ys[s + 1usize] - ys[s]) * (ys[s + 1usize] - ys[s])).sqrt();
    s = s + 1usize;
  }
  mut run = 0.;
  s = 0usize;
  while s + 1usize < xs.len {
    imm dx = xs[s + 1usize] - xs[s];
    imm dy = ys[s + 1usize] - ys[s];
    imm len2 = dx * dx + dy * dy;
    imm t = clampf(((x - xs[s]) * dx + (y - ys[s]) * dy) / len2, 0., 1.);
    imm px = xs[s] + dx * t;
    imm py = ys[s] + dy * t;
    imm d = ((x - px) * (x - px) + (y - py) * (y - py)).sqrt();
    if d < best { best = d; along = (run + t * len2.sqrt()) / total; }
    run = run + len2.sqrt();
    s = s + 1usize;
  }
  new Vec2(best, along);
}

pub fn paintSkin(spec &FaceSpec, yg f32) Pixels {
  imm w = 2048;
  imm h = 1024;
  mut px = Pixels.make(w, h);
  imm skin = new Vec3(226., 177., 154.);
  imm neckSkin = new Vec3(212., 162., 141.);
  imm lipU = new Vec3(188., 100., 100.);
  imm lipL = new Vec3(200., 112., 110.);
  imm browX = [0.009, 0.020, 0.035, 0.049, 0.058];
  imm browY = [0.0480, 0.0525, 0.0532, 0.0495, 0.0440];
  imm yU = yg + 0.0054;
  imm yL = yg - 0.0072;
  mut j = 0;
  while j < h {
    imm v = (f32.from(j) + 0.5) / f32.from(h);
    imm y = Y_BOTTOM + v * (Y_TOP - Y_BOTTOM);
    mut i = 0;
    while i < w {
      imm u = (f32.from(i) + 0.5) / f32.from(w);
      imm theta = -pi + 2. * pi * u;
      mut c = mixc(skin, neckSkin, smoothstep(-0.10, -0.15, y));
      // fine skin: pores and tone
      imm n1 = valueNoise(f32.from(i) * 0.9, f32.from(j) * 0.9, 11u32);
      imm n2 = valueNoise(f32.from(i) * 0.12, f32.from(j) * 0.12, 23u32);
      c = c + new Vec3(1., 0.8, 0.7) * ((n1 - 0.5) * 7. + (n2 - 0.5) * 10.);
      if cos(theta) > -0.3 {
        imm p = headVertex(theta, y, yg);
        imm ax = absf(p.x);
        // blush and the shadow of the socket
        c = c + new Vec3(8., -14., -8.) * gb(ax, p.y, 0.047, -0.030, 0.017, 0.015, 1.);
        c = c + new Vec3(-12., -16., -11.) * gb(ax, p.y, 0.031, 0.020, 0.024, 0.017, 1.);
        c = c + new Vec3(-10., -14., -2.) * gb(ax, p.y, 0.031, 0.002, 0.014, 0.006, 1.);
        c = c + new Vec3(6., -6., -6.) * gb(ax, p.y, 0.0, 0.085, 0.040, 0.02, 1.);
        // the eyes' lids: tint and lash line, from the point's angles about the eyeball
        imm side = if p.x >= 0. { 1.; } else { -1.; };
        imm ec = eyeCentre(side);
        imm dx = side * (p.x - ec.x);
        imm dy = p.y - ec.y;
        if absf(dx) < LID_HW * 1.15 and absf(dy) < 0.02 {
          imm edges = lidEdges(dx);
          imm eu = edges.x - dy;
          imm el = dy - edges.y;
          // lid skin a little pinker and darker near the rim
          imm outside = fmax(-eu, -el);
          if eu < 0. or el < 0. {
            c = c + new Vec3(-9., -17., -12.) * (1. - smoothstep(0., 0.005, outside));
          }
          // the lash line: a dark band just outside the upper rim, a lighter one below
          imm lashU = libc.expf(-((eu + 0.0005) / 0.0008) * ((eu + 0.0005) / 0.0008));
          imm lashL = libc.expf(-((el + 0.0003) / 0.0006) * ((el + 0.0003) / 0.0006));
          imm along = 1. - smoothstep(0.85, 1.05, absf(dx) / LID_HW);
          c = mixc(c, new Vec3(32., 22., 20.), lashU * 0.92 * along);
          c = mixc(c, new Vec3(60., 40., 36.), lashL * 0.45 * along);
        }
        // the lips
        imm qu = ((p.x / 0.0245) * (p.x / 0.0245) + ((p.y - yU) / 0.0062) * ((p.y - yU) / 0.0062)).sqrt();
        imm ql = ((p.x / 0.0235) * (p.x / 0.0235) + ((p.y - yL) / 0.0072) * ((p.y - yL) / 0.0072)).sqrt();
        if p.y > yg - 0.0008 { c = mixc(c, lipU, 1. - smoothstep(0.80, 1.0, qu)); }
        if p.y <= yg + 0.0008 { c = mixc(c, lipL, 1. - smoothstep(0.80, 1.0, ql)); }
        // the mouth line and its corners
        imm line = libc.expf(-0.5 * ((p.y - yg) / 0.0010) * ((p.y - yg) / 0.0010)) * (1. - smoothstep(0.020, 0.028, ax));
        c = mixc(c, new Vec3(70., 26., 30.), line * 0.95);
        // nostrils
        c = mixc(c, new Vec3(48., 20., 20.), gb(ax, p.y, 0.0075, -0.0468, 0.0034, 0.0026, 1.) * 0.95);
        // the eyebrows: hairs along a curve, thickest at the inner third
        imm bd = polylineDistance(ax, p.y, &browX, &browY);
        imm thick = 0.0042 * (1. - 0.55 * bd.y * bd.y) * (0.5 + 0.5 * smoothstep(0., 0.12, bd.y));
        imm hair = valueNoise(p.x * 700., p.y * 260., 5u32);
        imm bm = (1. - smoothstep(thick * 0.55, thick, bd.x)) * (0.62 + 0.38 * hair) * (1. - smoothstep(0.85, 1.0, bd.y));
        c = mixc(c, new Vec3(66., 46., 36.), bm * 0.92);
      }
      putPixel(&mut px, i, j, c);
      i = i + 1;
    }
    j = j + 1;
  }
  px;
}

pub fn paintEye() Pixels {
  imm n = 512;
  mut px = Pixels.make(n, n);
  mut j = 0;
  while j < n {
    mut i = 0;
    while i < n {
      imm x = (f32.from(i) + 0.5) / f32.from(n) * 2. - 1.;
      imm y = (f32.from(j) + 0.5) / f32.from(n) * 2. - 1.;
      imm r = (x * x + y * y).sqrt();
      imm ang = atan2(y, x);
      mut c = new Vec3(238., 232., 226.);
      // faint veins and the darker sclera towards the edges
      imm vein = valueNoise(ang * 6., r * 14., 3u32);
      c = c + new Vec3(0., -10., -10.) * (vein * smoothstep(0.55, 0.95, r));
      c = c * (1. - 0.18 * smoothstep(0.7, 1.0, r));
      // the iris: fibres run out from the pupil
      if r < 0.43 {
        imm fibre = valueNoise(ang * 24., r * 9., 7u32) * 0.6 + valueNoise(ang * 60., r * 3., 9u32) * 0.4;
        imm t = smoothstep(0.17, 0.42, r);
        imm inner = new Vec3(178., 132., 64.);
        imm outer = new Vec3(88., 60., 38.);
        mut iris = mixc(inner, outer, t * 0.9);
        iris = iris * (0.78 + 0.5 * fibre);
        c = mixc(c, iris, 1. - smoothstep(0.405, 0.43, r));
        // the limbal ring
        c = mixc(c, new Vec3(30., 22., 18.), smoothstep(0.385, 0.42, r) * (1. - smoothstep(0.42, 0.44, r)));
        // the pupil
        c = mixc(c, new Vec3(6., 5., 5.), 1. - smoothstep(0.155, 0.175, r));
      }
      putPixel(&mut px, i, j, c);
      i = i + 1;
    }
    j = j + 1;
  }
  px;
}
