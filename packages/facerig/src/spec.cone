// A face described by data: named landmarks, the sizes a rig needs, and the
// tables that say what each action unit does to the surface near a landmark.
//
// NOTHING HERE KNOWS A MESH. A FaceSpec holds landmarks (names and points in
// the head's own frame) and a few numbers (the scale, the eyeball radius, how
// far the lids open). An Influence is one rule in a unit's recipe: "near the
// landmark named M, move the surface by V" or "near M, turn the surface about
// the landmark named P". 'buildTargets' (targets.cone) reads a mesh, a spec
// and a unit table and makes the morph targets; a face of another shape, or a
// mesh with other vertices, needs only its own spec.
//
// Conventions: the head's frame is bonepose's: y up, a being faces -z, its
// right is +x. Distances in an Influence are in FACE SCALES (the spec's
// 'scale', the distance between the eyeball centres), so one table serves a
// small head and a large one. An unnamed landmark is skipped, and a unit all
// of whose rules are skipped makes no target, so a spec may give only the
// landmarks it has.

// What a rule does
pub const INFL_MOVE = 0u32;        // the surface near the landmark moves by 'move' (in face scales)
pub const INFL_TURN = 1u32;        // the surface near the landmark turns about the pivot landmark's point

// How a rule's weight falls from 1 at its landmark to 0 at its radii (these
// are geomath's FalloffSmooth, FalloffGauss and FalloffPlateau, by number)
pub const FALLOFF_SMOOTH = 0u32;   // 1 - smoothstep(0, 1, d)
pub const FALLOFF_GAUSS = 1u32;    // exp(-4.5 d^2), brought to 0 by d = 1
pub const FALLOFF_PLATEAU = 2u32;  // 1 up to d = 0.5, then 1 - smoothstep(0.5, 1, d): a whole region moves as one

// Where a turn's angle comes from
pub const ANGLE_FIXED = 0u32;      // 'angle' radians
pub const ANGLE_UPPER_CLOSE = 1u32;  // 'angle' times the turn that brings the upper lid's edge to the closing line
pub const ANGLE_LOWER_CLOSE = 2u32;  // the same for the lower lid's edge

// What a unit drives
pub const UNIT_MORPH = 0u32;       // a morph target built from its rules
pub const UNIT_JAW = 1u32;         // the jaw bone: pitch, yaw and thrust at full value
pub const UNIT_TONGUE = 2u32;      // the tongue's lift, 0 to 1
pub const UNIT_NONE = 3u32;        // a channel with no direct effect (a placeholder in a recipe)

// Which side of the face a unit is on
pub const SIDE_BOTH = 0u32;
pub const SIDE_LEFT = 1u32;        // the being's left: -x
pub const SIDE_RIGHT = 2u32;       // the being's right: +x

// One rule of a unit's recipe
pub struct Influence {
  pub landmark: String;       // the rule acts near this landmark ...
  pub pivot: String;          // ... and a turn pivots on this one
  pub kind: u32;              // INFL_MOVE or INFL_TURN
  pub move: Vec3;             // a move: the displacement at weight 1, in face scales
  pub axis: Vec3;             // a turn: its axis (head frame)
  pub angle: f32;             // a turn: its angle at weight 1 (radians), or the multiplier for ANGLE_*_CLOSE
  pub angleSource: u32;
  pub radii: Vec3;            // the extent of the rule along x, y, z, in face scales
  pub falloff: u32;
  pub gate: String;           // a landmark on a dividing plane, or "" for none
  pub gateNormal: Vec3;       // the plane's normal; the rule acts on the side it points to
  pub gateSoft: f32;          // the plane's softness (face scales): the rule fades across it

  // A move near 'landmark'
  pub fn moveNear(landmark: &str, move: Vec3, radii: Vec3) Influence {
    new Influence(String.from(landmark), String.empty(), INFL_MOVE, move, new Vec3(0., 0., 0.), 0., ANGLE_FIXED, radii,
      FALLOFF_SMOOTH, String.empty(), new Vec3(0., 1., 0.), 0.05)
  }

  // A turn about 'pivot' of the surface near 'landmark'
  pub fn turnNear(landmark: &str, pivot: &str, axis: Vec3, angle: f32, radii: Vec3) Influence {
    new Influence(String.from(landmark), String.from(pivot), INFL_TURN, new Vec3(0., 0., 0.), axis, angle, ANGLE_FIXED,
      radii, FALLOFF_SMOOTH, String.empty(), new Vec3(0., 1., 0.), 0.05)
  }

  // The same rule, acting only on the side of the plane through 'gate' that 'normal' points to
  pub fn gated(self, gate: &str, normal: Vec3, soft: f32) Influence {
    var r = self;
    r.gate = String.from(gate);
    r.gateNormal = normal;
    r.gateSoft = soft;
    r
  }

  // The same rule with its angle taken from the lids' closure
  pub fn closing(self, source: u32) Influence {
    var r = self;
    r.angleSource = source;
    r
  }

  pub fn gauss(self) Influence {
    var r = self;
    r.falloff = FALLOFF_GAUSS;
    r
  }

  pub fn plateau(self) Influence {
    var r = self;
    r.falloff = FALLOFF_PLATEAU;
    r
  }
}

// One channel of the rig: an action unit (or a rig-only channel) on one side
pub struct UnitDef {
  pub name: String;
  pub au: u32;                // the FACS number, or 100 and up for a channel of the rig's own
  pub side: u32;              // SIDE_*
  pub kind: u32;              // UNIT_*
  pub influences: List[Influence];
  pub sharesWith: i32;            // the unit whose target this one shares (AU45 blinks with AU43's lids), or -1
  pub jaw: Vec3;              // UNIT_JAW: pitch, yaw (radians) and thrust (face scales) at weight 1

  pub fn morph(name: &str, au: u32, side: u32) UnitDef {
    new UnitDef(String.from(name), au, side, UNIT_MORPH, List[Influence].empty(), -1i32, new Vec3(0., 0., 0.))
  }
  // (sharesWith: another unit whose target this one uses)

  pub fn add(self: &mut, i: Influence) { influences.push(i); }
}

// A face as data
pub struct FaceSpec {
  pub names: List[String];    // the landmarks' names ...
  pub points: List[Vec3];     // ... and where they are, in the head's frame at rest
  pub scale: f32;             // the face scale: the distance between the eyeball centres, metres
  pub eyeRadius: f32;         // the eyeballs' radius, metres
  pub upperLidEdge: f32;      // how far above the eyeball's equator the upper lid's edge lies when open, radians
  pub lowerLidEdge: f32;      // how far below it the lower lid's edge lies
  pub closingLine: f32;       // the elevation (radians; negative: below the equator) where the lids meet when shut
  pub jawPivot: Vec3;         // the jaw's hinge, head frame, midway between the two joints
  pub jawOpenMax: f32;        // the jaw's opening at AU26 = 1, radians
  pub eyeLimit: f32;          // how far an eyeball may turn from straight ahead, radians

  pub fn empty() FaceSpec {
    new FaceSpec(List[String].empty(), List[Vec3].empty(), 0.062, 0.012, 0.35, 0.30, -0.08, new Vec3(0., -0.02, 0.),
      0.45, 0.62)
  }

  // Add a landmark: its number
  pub fn add(self: &mut, name: &str, p: Vec3) usize {
    names.push(String.from(name));
    points.push(p);
    names.len() - 1usize
  }

  // The number of the landmark called 'name', or -1
  pub fn index(self: &, name: &str) i32 {
    var i = 0usize;
    while i < names.len() {
      if names[i].equals(name) { return i32.from(i); }
      i = i + 1usize;
    }
    -1i32
  }

  pub fn has(self: &, name: &str) bool { self.index(name) >= 0i32 }

  // A landmark's point; the origin when there is none such
  pub fn point(self: &, name: &str) Vec3 {
    let i = self.index(name);
    if i < 0i32 { return new Vec3(0., 0., 0.); }
    *points[usize.from(i)]
  }

  // The turn (radians) that brings the upper lid's edge to the closing line
  pub fn upperClosing(self: &) f32 { -(upperLidEdge - closingLine) }

  // And the lower lid's edge
  pub fn lowerClosing(self: &) f32 { lowerLidEdge + closingLine }
}
