// Lip sync: letters to phonemes, the timeline, and the Cohen and Massaro blend.
//
// Worked out here:
// 1. Phonemes: "hello" is HH AH L OW (the dictionary); the rules give "make"
//    M EY K (a silent final e lengthens the a), "ship" SH IH P, "cat" K AE T,
//    "thing" TH IH NG, "city" S IH T IY (soft c), "quick" K W IH K.
//    A comma puts "," and a full stop "." into the stream, words are joined by '|'.
// 2. Timeline: the durations of H, AH, L, OW at rate 1 are 0.055, 0.085, 0.070
//    and 0.150 (OW a diphthong in two segments), so "hello" takes 0.36 s; at
//    rate 2 it takes 0.18 s.
// 3. The blend, one segment alone. A bilabial "P" is the viseme PP whose lip
//    pressor AU24 has target 1.0 and dominance 3.2, its dominance falling at
//    11 x 2.2 a second before its centre and 15 x 2.2 after it (sharpness 2.2).
//    With the rest dominance 0.12 at target 0, at its centre the pressor is
//    3.2 / (3.2 + 0.12) = 0.96386; 0.05 s after it, D = 3.2 exp(-33 x 0.05) =
//    0.61440 and the value 0.61440 / (0.61440 + 0.12) = 0.83659; 0.05 s before,
//    D = 3.2 exp(-24.2 x 0.05) = 0.95446 and the value 0.88830.
// 4. "K" (the viseme kk) has no opinion about the lips: the pressor stays 0.
// 5. A vowel opens the jaw: AH (viseme aa) jaw (AU26) 0.8 x 0.6 = 0.48 target,
//    dominance 1.3: 0.48 x 1.3 / (1.3 + 0.12) = 0.43944 at its centre.
// 6. After the line's end the mouth returns to neutral; the speaking flag ends.

mod speech;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import mesh use Mesh;
import facerig use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn testG2p() {
  expectStr(textToPhonemes("hello").view(), "HH AH L OW", "hello");
  expectStr(textToPhonemes("make").view(), "M EY K", "make: the silent e (dictionary)");
  expectStr(textToPhonemes("ship").view(), "SH IH P", "ship: sh");
  expectStr(textToPhonemes("cat").view(), "K AE T", "cat: hard c");
  expectStr(textToPhonemes("thing").view(), "TH IH NG", "thing: th and ng");
  expectStr(textToPhonemes("city").view(), "S IH T IY", "city: soft c, final y");
  expectStr(textToPhonemes("quick").view(), "K W IH K", "quick: qu and ck");
  expectStr(textToPhonemes("ride").view(), "R AY D", "ride: the magic e");
  expectStr(textToPhonemes("Hello, world.").view(), "HH AH L OW , | W ER L D .", "punctuation");
  expectStr(textToPhonemes("").view(), "", "empty");
}

fn testTimeline() {
  let u = utteranceFromPhonemes("HH AH L OW", 1.);
  expectUInt(u64.from(u.phonemes.len()), 4u64, "four phonemes");
  expectUInt(u64.from(u.segments.len()), 5u64, "the diphthong makes two segments");
  near(u.duration, 0.055 + 0.085 + 0.070 + 0.150, 0.0001, "hello takes 0.36 s");
  near(*u.starts[1], 0.055, 0.0001, "AH starts at 0.055");
  near(*u.starts[3], 0.210, 0.0001, "OW starts at 0.21");
  let fast = utteranceFromPhonemes("HH AH L OW", 2.);
  near(fast.duration, 0.18, 0.0001, "twice the rate halves it");
  // Pauses
  let p = utteranceFromPhonemes("HH AH , L OW .", 1.);
  near(p.duration, 0.055 + 0.085 + 0.18 + 0.070 + 0.150 + 0.40, 0.0001, "a comma is 0.18 s and a full stop 0.40 s");
  // Unknown tokens are ignored, the word boundary is silent
  let w = utteranceFromPhonemes("HH XX AH | L", 1.);
  expectUInt(u64.from(w.phonemes.len()), 3u64, "an unknown name is skipped");
}

// The unit table the rig has, for a player
struct Setup {
  units List[UnitDef];
  speech Speech;
  values List[f32];
}

fn setup() Setup {
  let units = standardUnits();
  let speech = Speech.make(&units);
  var values = List[f32].empty();
  values.resize(units.len(), 0.);
  new Setup(units, speech, values)
}

fn clear(s &mut Setup) {
  var i = 0usize;
  while i < s.values.len() { s.values.set(i, 0.); i = i + 1usize; }
}

fn valueAt(s &mut Setup, t f32, au u32, side u32) f32 {
  clear(s);
  s.speech.valuesAt(t, &mut s.values);
  let i = findUnit(&s.units, au, side);
  *s.values[usize.from(i)]
}

fn testBlend() {
  var s = setup();
  let u = utteranceFromPhonemes("P", 1.);
  s.speech.say(&u);
  // P lasts 0.07 s: its centre is 0.035
  near(valueAt(&mut s, 0.035, AU_LIP_PRESSOR, SIDE_RIGHT), 3.2 / 3.32, 0.0005, "P: the lips pressed 0.96386 at its centre");
  near(valueAt(&mut s, 0.085, AU_LIP_PRESSOR, SIDE_RIGHT), 0.61440 / (0.61440 + 0.12), 0.002, "0.05 s later 0.83659");
  let before = 3.2 * libc.expf(-24.2 * 0.05);
  near(valueAt(&mut s, -0.015, AU_LIP_PRESSOR, SIDE_RIGHT), before / (before + 0.12), 0.002, "0.05 s before it 0.8883");
  near(valueAt(&mut s, 0.6, AU_LIP_PRESSOR, SIDE_RIGHT), 0., 0.0001, "long after it, the lips are free");
  let k = utteranceFromPhonemes("K", 1.);
  s.speech.say(&k);
  near(valueAt(&mut s, 0.035, AU_LIP_PRESSOR, SIDE_RIGHT), 0., 0.0001, "K: no opinion about the lips");
  let a = utteranceFromPhonemes("AH", 1.);
  s.speech.say(&a);
  // AH lasts 0.085: its centre is 0.0425
  near(valueAt(&mut s, 0.0425, AU_JAW_DROP, SIDE_BOTH), 0.48 * 1.3 / 1.42, 0.001, "AH: the jaw opens 0.43944 at its centre");
  // Between P and AH: "P AH": at P's centre the jaw is held nearly shut by P's own opinion of it
  let pa = utteranceFromPhonemes("P AH", 1.);
  s.speech.say(&pa);
  let jawAtP = valueAt(&mut s, 0.035, AU_JAW_DROP, SIDE_BOTH);
  let jawAtA = valueAt(&mut s, 0.07 + 0.0425, AU_JAW_DROP, SIDE_BOTH);
  expect(jawAtP < 0.15, "P holds the jaw nearly shut");
  expect(jawAtA > 0.3, "and the vowel after opens it");
  expect(jawAtA > jawAtP * 2., "much wider than at the P");
  // Anticipation: the pucker of OU leaks into the sound before it
  let sou = utteranceFromPhonemes("S UW", 1.);
  s.speech.say(&sou);
  let pucker = valueAt(&mut s, 0.045, AU_LIP_PUCKER, SIDE_RIGHT);
  let puckerAfter = valueAt(&mut s, 0.09 + 0.0575, AU_LIP_PUCKER, SIDE_RIGHT);
  expect(pucker > 0.1, "the lips start to round during the S before an OO");
  expect(puckerAfter > pucker, "and round fully at the vowel");
}

fn testPlaying() {
  var s = setup();
  let u = utteranceFromText("Hello.", 1.);
  s.speech.say(&u);
  expectBool(s.speech.done(), false, "just started");
  var vals = List[f32].empty();
  vals.resize(s.units.len(), 0.);
  var i = 0;
  var sawActivity = false;
  while i < 120 {
    s.speech.update(1. / 60., &mut vals);
    if s.speech.activity > 0.5 { sawActivity = true; }
    i = i + 1;
  }
  expectBool(sawActivity, true, "it shows activity while it speaks");
  expectBool(s.speech.done(), true, "and is over after the line and its tail");
  near(s.speech.activity, 0., 0.0001, "silent after");
}

fn main() i32 {
  testG2p();
  testTimeline();
  testBlend();
  testPlaying();
  done()
}
