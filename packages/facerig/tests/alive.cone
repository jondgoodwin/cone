// A face at rest is alive: idle motion; and the face's bones on a body.
//
// Worked out here:
// 1. Idle: every brow, lid, lip and chin unit is amp x (0.5 + 0.5 noise), noise
//    in [-1, 1], so it stays in [0, amp]: AU1 amp 0.045, AU4 0.05, AU12 0.035.
//    It is not constant (it varies by a large part of its range over a minute)
//    and not the same on the two sides.
// 2. Breath at 0.27 Hz: the nostril unit AU38 is 0.22 (0.5 - 0.5 cos(2 pi 0.27 t))
//    so it has range 0 to 0.22 and a period of 1 / 0.27 = 3.70 s.
// 3. The head sways by at most 0.010 + 0.008 + 0.004 rad in yaw and pitch, and
//    0.006 in roll: under 1.5 degrees in all.
// 4. Seeded: the same seed gives the same face; another seed another.
// 5. Idle off gives a still face (its neutral pose, but for the eyes' tremor).
// 6. The jaw's resting opening is 0.02 + 0.018 breath, of AU26 times 0.45 rad.
// 7. Bones: a humanoid with the face attached has 19 + 3 bones; the jaw bone
//    sits at the head bone's origin plus the face frame's origin plus the
//    hinge; applying a frame with the jaw open 0.3 rad puts the jaw bone's
//    rotation at that angle about x (negative: a positive pitch opens);
//    the eyes' bones turn by the frame's eye rotations; 'withHead' composes
//    the head's turn onto the head bone.

mod alive;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import bonepose use *;
import mesh use Mesh;
import facerig use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

// The angle of a rotation, 0 to pi
fn rotAngle(q Quat) f32 { 2. * acos(clampf(absf(q.w), 0., 1.)); }

struct Rigged {
  head TestHead;
  units List[UnitDef];
  targets FaceTargets;
}

fn rigged() Rigged {
  imm head = makeTestHead(50usize, 64usize);
  imm units = standardUnits();
  imm targets = buildTargets(&head.mesh, &head.spec, &units);
  new Rigged(head, units, targets);
}

fn testIdle(r &Rigged) {
  mut rig = FaceRig.make(&r.head.spec, &r.units, &r.targets, 11u32);
  rig.blinking = false;
  mut f = rig.newFrame();
  imm au1r = usize.from(findUnit(&r.units, AU_INNER_BROW_RAISER, SIDE_RIGHT));
  imm au1l = usize.from(findUnit(&r.units, AU_INNER_BROW_RAISER, SIDE_LEFT));
  imm au12r = usize.from(findUnit(&r.units, AU_LIP_CORNER_PULLER, SIDE_RIGHT));
  imm au38 = usize.from(findUnit(&r.units, AU_NOSTRIL_DILATOR, SIDE_RIGHT));
  mut lo = 1000.;
  mut hi = -1000.;
  mut breathLo = 1000.;
  mut breathHi = -1000.;
  mut lo12 = 1000.;
  mut hi12 = -1000.;
  mut differs = false;
  mut headAngle = 0.;
  mut crossings = 0;
  mut lastSign = 0.;
  mut t = 0.;
  // Skip the first seconds (the eyes settle) and watch two minutes
  while t < 125. {
    rig.update(1. / 30., &mut f);
    if t > 5. {
      imm v = *f.units[au1r];
      if v < lo { lo = v; }
      if v > hi { hi = v; }
      imm b = *f.units[au38];
      if b < breathLo { breathLo = b; }
      if b > breathHi { breathHi = b; }
      imm w = *f.units[au12r];
      if w < lo12 { lo12 = w; }
      if w > hi12 { hi12 = w; }
      if absf(*f.units[au1r] - *f.units[au1l]) > 0.003 { differs = true; }
      imm ang = rotAngle(f.head);
      if ang > headAngle { headAngle = ang; }
      // breath: count the rises through the middle of its range
      imm s = if b > 0.11 { 1.; } else { -1.; };
      if lastSign < 0. and s > 0. { crossings = crossings + 1; }
      lastSign = s;
    }
    t = t + 1. / 30.;
  }
  expect(lo >= 0. and hi <= 0.0451, "AU1 stays within 0 to 0.045");
  expect(hi - lo > 0.025, "and varies by most of that range in two minutes");
  expect(hi12 <= 0.0351 and hi12 - lo12 > 0.015, "AU12 within 0 to 0.035, varying");
  expectBool(differs, true, "the two sides of the brow are not the same");
  near(breathHi, 0.22, 0.01, "the nostril unit breathes up to 0.22");
  near(breathLo, 0., 0.01, "and down to 0");
  // 120 s at 0.27 Hz is 32.4 breaths
  expect(crossings >= 31 and crossings <= 34, "about 32 breaths in two minutes");
  expect(headAngle < radians(1.5), "the head sways less than 1.5 degrees");
  expect(headAngle > radians(0.1), "and does sway");
}

fn faceAt(r &Rigged, seed u32, seconds f32) f32 {
  mut rig = FaceRig.make(&r.head.spec, &r.units, &r.targets, seed);
  rig.blinking = false;
  mut f = rig.newFrame();
  mut t = 0.;
  while t < seconds { rig.update(1. / 30., &mut f); t = t + 1. / 30.; }
  mut sum = 0.;
  mut k = 0usize;
  while k < f.weights.len() { sum = sum + *f.weights[k] * f32.from(k + 1usize); k = k + 1usize; }
  sum;
}

fn testSeeded(r &Rigged) {
  imm a = faceAt(r, 5u32, 20.);
  imm b = faceAt(r, 5u32, 20.);
  imm c = faceAt(r, 6u32, 20.);
  expect(a == b, "the same seed gives the same face");
  expect(a != c, "another seed gives another");
}

fn testIdleOff(r &Rigged) {
  mut rig = FaceRig.make(&r.head.spec, &r.units, &r.targets, 21u32);
  rig.blinking = false;
  rig.idleAmount = 0.;
  mut f = rig.newFrame();
  mut t = 0.;
  mut worst = 0.;
  mut headWorst = 0.;
  while t < 20. {
    rig.update(1. / 30., &mut f);
    mut k = 0usize;
    while k < f.weights.len() { if *f.weights[k] > worst { worst = *f.weights[k]; } k = k + 1usize; }
    imm ang = rotAngle(f.head);
    if ang > headWorst { headWorst = ang; }
    t = t + 1. / 30.;
  }
  expect(worst < 0.01, "idle off: no target above a hundredth (the lids' hair of following)");
  near(headWorst, 0., 0.00001, "and no sway");
}

fn testBones(r &Rigged) {
  imm height = 1.75;
  mut skel = humanoid(height);
  imm origin = new Vec3(0., 0.07, 0.);
  imm bones = attachFace(&mut skel, HEAD, &r.head.spec, origin);
  expectUInt(u64.from(skel.boneCount()), 22u64, "19 bones and 3 more");
  expectUInt(u64.from(bones.jaw), 19u64, "the jaw is bone 19");
  imm rest = skel.restPose();
  mut models = List[Transform3].empty();
  skel.modelTransforms(&rest, &mut models);
  imm headAt = (*models[HEAD]).translation;
  near((*models[bones.jaw]).translation.y - headAt.y, 0.07 + r.head.spec.jawPivot.y, 0.00001, "the jaw hinge's height above the head bone");
  near((*models[bones.eyeR]).translation.x - headAt.x, r.head.spec.point("eyeCenterR").x, 0.00001, "the right eye is on the right");
  near((*models[bones.eyeL]).translation.x - headAt.x, r.head.spec.point("eyeCenterL").x, 0.00001, "the left on the left");
  // A frame with the jaw open
  mut rig = FaceRig.make(&r.head.spec, &r.units, &r.targets, 4u32);
  rig.idleAmount = 0.;
  rig.blinking = false;
  mut f = rig.newFrame();
  rig.setUnit(AU_JAW_DROP, SIDE_BOTH, 0.3 / 0.45);
  rig.lookAt(new Vec3(-0.5, 0.02, -1.));
  mut i = 0;
  while i < 60 { rig.update(1. / 60., &mut f); i = i + 1; }
  near(f.jawPitch, 0.3, 0.0001, "the jaw is open 0.3 rad");
  mut pose = skel.restPose();
  applyFace(&mut pose, &bones, &f, &r.head.spec, false);
  // The jaw bone's rotation is about x by -0.3 (opening is a negative turn about +x)
  imm q = pose.rotation(bones.jaw);
  imm d = q * new Vec3(0., 0., -1.);
  near(d.y, -sin(0.3), 0.0001, "a point in front of the hinge drops by sin 0.3");
  // The eyes turned
  imm eq = pose.rotation(bones.eyeL);
  imm look = eq * new Vec3(0., 0., -1.);
  expect(look.x < -0.1, "the eyes look to the left (-x)");
  near(rotAngle(pose.rotation(HEAD)), 0., 0.00001, "the head bone is not turned without 'withHead'");
  applyFace(&mut pose, &bones, &f, &r.head.spec, true);
  expect(rotAngle(pose.rotation(HEAD)) > 0.1, "with it, it is");
}

fn main() i32 {
  imm r = rigged();
  testIdle(&r);
  testSeeded(&r);
  testIdleOff(&r);
  testBones(&r);
  done();
}
