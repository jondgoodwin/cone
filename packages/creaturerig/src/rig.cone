// Rig: a RigSpec built into a bonepose Skeleton, with the chains kept by name.
//
// Bones are numbered in the order of the spec (chain by chain, each chain's
// first bone after the bone it hangs from, so a parent always comes before
// its child, as bonepose needs). The Rig remembers, for every bone, its full
// name ("chain/bone"), its radius, the chain it belongs to and its place in
// that chain, and for every chain its kind, its side and the bones. Other
// packages find what they animate by kind and name, never by bone number.

// A built chain
pub struct Chain {
  pub name: String;
  pub kind: u32;
  pub bones: List[usize];     // the skeleton's bone numbers, in chain order
  pub side: i32;              // SIDE_LEFT, SIDE_CENTRE or SIDE_RIGHT, by the first bone's rest x
  pub parentBone: i32;        // the skeleton bone the chain hangs from; -1 for the root chain
  pub parentChain: i32;       // and its chain; -1 for the root chain

  pub fn len(self: &) usize { bones.len() }
  pub fn first(self: &) usize { *bones[0usize] }
  pub fn last(self: &) usize { *bones[bones.len() - 1usize] }
}

pub struct Rig {
  pub name: String;
  pub skeleton: Skeleton;
  pub chains: List[Chain];
  pub boneNames: List[String];
  pub radii: List[f32];
  pub boneChain: List[u32];       // each bone's chain
  pub boneInChain: List[u32];     // and its index in it
  pub restModels: List[Transform3]; // each bone's rest transform in model space

  pub fn boneCount(self: &) usize { skeleton.boneCount() }
  pub fn chainCount(self: &) usize { chains.len() }

  // The chain called 'name': its number, or -1
  pub fn chainIndex(self: &, name: &str) i32 {
    var i = 0usize;
    while i < chains.len() {
      if chains[i].name.view() == name { return i32.from(i); }
      i = i + 1usize;
    }
    -1i32
  }

  // The numbers of every chain of this kind, in the order they were listed
  pub fn chainsOfKind(self: &, kind: u32) List[usize] {
    var out = List[usize].empty();
    var i = 0usize;
    while i < chains.len() {
      if chains[i].kind == kind { out.push(i); }
      i = i + 1usize;
    }
    out
  }

  // The skeleton bone number of the 'k'th bone of chain 'c' (negative k counts from the end)
  pub fn boneOf(self: &, c: usize, k: i32) usize {
    let n = i32.from(chains[c].bones.len());
    let kk = if k < 0i32 { n + k } else { k };
    *chains[c].bones[usize.from(kk)]
  }

  // The bone called "chain/bone": its number, or -1
  pub fn boneIndex(self: &, fullName: &str) i32 {
    var i = 0usize;
    while i < boneNames.len() {
      if boneNames[i].view() == fullName { return i32.from(i); }
      i = i + 1usize;
    }
    -1i32
  }

  // Bone 'b''s rest position in model space
  pub fn restPosition(self: &, b: usize) Vec3 { restModels[b].translation }

  // The bones' children's count: a bone with none is a tip
  pub fn childCount(self: &, b: usize) usize {
    var n = 0usize;
    var i = 0usize;
    while i < skeleton.boneCount() {
      if skeleton.parentOf(i) == i32.from(b) { n = n + 1usize; }
      i = i + 1usize;
    }
    n
  }

  // The rest pose
  pub fn restPose(self: &) Pose { skeleton.restPose() }
}

// The result of building a spec: a rig, or the reason it could not be
pub struct RigBuild {
  pub rig: Rig;
  pub ok: bool;
  pub error: String;

  // The rig, moved out (the build keeps an empty one)
  pub fn take(self: &mut) Rig {
    var out = emptyRig("");
    out <-> self.rig;
    out
  }
}

pub fn emptyRig(name: &str) Rig {
  Rig(String.from(name), Skeleton.empty(), List[Chain].empty(), List[String].empty(),
    List[f32].empty(), List[u32].empty(), List[u32].empty(), List[Transform3].empty())
}

fn failed(spec: &RigSpec, why: &str) RigBuild {
  RigBuild(emptyRig(spec.name.view()), false, String.from(why))
}

// Build the rig a spec describes. Refused, with the reason: no chains, a
// chain with no bones, a parent chain that is not listed before it, a parent
// bone out of range, a second root chain, a repeated chain name.
pub fn buildRig(spec: &RigSpec) RigBuild {
  if spec.chains.len() == 0usize { return failed(spec, "the spec has no chains"); }
  var skel = Skeleton.empty();
  var chains = List[Chain].empty();
  var names = List[String].empty();
  var radii = List[f32].empty();
  var boneChain = List[u32].empty();
  var boneIn = List[u32].empty();
  var models = List[Transform3].empty();
  let one = Vec3(1., 1., 1.);
  var roots = 0usize;
  var ci = 0usize;
  while ci < spec.chains.len() {
    let cs = spec.chains[ci];
    if cs.bones.len() == 0usize { return failed(spec, "a chain has no bones"); }
    var k = 0usize;
    while k < ci {
      if chains[k].name.view() == cs.name.view() { return failed(spec, "two chains have the same name"); }
      k = k + 1usize;
    }
    // Where the chain hangs from
    var parentBone = -1i32;
    var parentChain = -1i32;
    var parentPos = Vec3(0., 0., 0.);
    if cs.parent.len() == 0usize {
      roots = roots + 1usize;
      if roots > 1usize { return failed(spec, "a second chain has no parent (only one root)"); }
    } else {
      var found = -1i32;
      k = 0usize;
      while k < ci {
        if chains[k].name.view() == cs.parent.view() { found = i32.from(k); }
        k = k + 1usize;
      }
      if found < 0i32 { return failed(spec, "a chain's parent is not listed before it"); }
      let pc = usize.from(found);
      let n = i32.from(chains[pc].bones.len());
      let idx = if cs.parentBone < 0i32 { n + cs.parentBone } else { cs.parentBone };
      if idx < 0i32 || idx >= n { return failed(spec, "a chain's parent bone is out of range"); }
      parentBone = i32.from(*chains[pc].bones[usize.from(idx)]);
      parentChain = found;
      parentPos = models[usize.from(parentBone)].translation;
    }
    var bones = List[usize].empty();
    var prev = parentBone;
    var prevPos = parentPos;
    var b = 0usize;
    while b < cs.bones.len() {
      let bs = cs.bones[b];
      let rest = Transform3(bs.offset, Quat.identity(), one);
      let number = skel.addBone(prev, rest);
      let pos = prevPos + bs.offset;
      models.push(Transform3(pos, Quat.identity(), one));
      bones.push(number);
      var full = String.from(cs.name.view());
      full <- "/";
      full <- bs.name.view();
      names.push(full);
      radii.push(bs.radius);
      boneChain.push(u32.from(ci));
      boneIn.push(u32.from(b));
      prev = i32.from(number);
      prevPos = pos;
      b = b + 1usize;
    }
    let x = models[*bones[0usize]].translation.x;
    let side = if x > 0.0001 { SIDE_RIGHT } else if x < -0.0001 { SIDE_LEFT } else { SIDE_CENTRE };
    chains.push(Chain(String.from(cs.name.view()), cs.kind, bones, side, parentBone, parentChain));
    ci = ci + 1usize;
  }
  RigBuild(Rig(String.from(spec.name.view()), skel, chains, names, radii, boneChain, boneIn, models), true,
    String.empty())
}
