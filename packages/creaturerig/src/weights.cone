// Skinning weights from the bone layout onto a mesh.
//
// A vertex is carried by up to four joints, each with a weight, the weights
// summing to one: linear blend skinning, the form render's skinning.slang
// reads. Which joints, and how much, is what this file decides, for any mesh
// and any rig.
//
// WHAT CARRIES A VERTEX. A joint carries the surface around the segments
// from itself to its children (the thigh joint the thigh, the knee the
// shin): rotating a joint turns everything beyond it, so the segment below a
// joint is what it moves. A joint with no child (a toe tip, a feather tip)
// carries nothing of its own. A segment is a tapered capsule, the radii of
// its two joints (the rig's), and a vertex's distance to a joint is its
// distance to the capsule's surface, the least over the joint's segments.
//
// BONE HEAT (heatWeights). Baran and Popovic 2007 (Pinocchio; Blender's
// "automatic weights"). For each joint j the weight field w_j over the
// surface solves
//     -Laplacian(w_j) + H (w_j - p_j) = 0
// where p_j is 1 at the vertices whose nearest joint is j and 0 elsewhere,
// and H = c / d^2 at a vertex with d its distance to the nearest joint
// (floored at a quarter of the radius there): strongly pinned near a bone,
// loosely far from it. The Laplacian is the cotangent one of the mesh (Pinkall
// and Polthier 1993; Meyer et al. 2003), with the vertex's third-of-its-
// triangles' area as the mass, so the result does not depend on how the mesh
// is cut up. The solve is a Jacobi-preconditioned conjugate gradient, one per
// joint on the one matrix. Because the weight spreads ALONG THE SURFACE, two
// legs that stand a hand apart do not bleed into each other: the path from
// one to the other runs up the leg and across the belly. The mesh must be
// connected for that to hold (one blobby surface, or limbs welded to a
// body); pieces that are not connected are each weighted from the bones
// nearest them. Weights under 'prune' are dropped and the best four kept,
// as Pinocchio does. Pinocchio's visibility test (a bone that cannot see the
// vertex through the surface does not pin it) is not done.
//
// ENVELOPE (envelopeWeights). The plain method every package starts with and
// DCC tools offer as "envelopes": weight proportional to 1 / distance^4 to
// the capsule, best four, normalised. No mesh connectivity; it leaks between
// near neighbours. Kept for comparison, and for meshes whose size makes a
// solve too slow.

pub struct WeightParams {
  pub heat f32;            // c in H = c / d^2
  pub maxIterations u32;   // conjugate gradient, most steps a joint
  pub tolerance f32;       // and its relative residual
  pub prune f32;           // a weight under this is dropped
  pub power f32;           // the envelope's falloff exponent

  pub fn standard() WeightParams { new WeightParams(1., 400u32, 0.0005, 0.02, 4.) }
}

// Up to four joints and weights a vertex, in the order of the mesh's vertices
pub struct VertexWeights {
  pub joints List[u32];    // four a vertex; an unused slot is joint 0, weight 0
  pub weights List[f32];   // four a vertex, summing to 1
  pub steps u32;           // heat: the most solver steps any joint took

  pub fn vertexCount(self &) usize { joints.len() / 4usize }
  pub fn joint(self &, v usize, k usize) usize { usize.from(*joints[v * 4usize + k]) }
  pub fn weight(self &, v usize, k usize) f32 { *weights[v * 4usize + k] }

  // What joint 'j' carries of vertex 'v' (0 if it is not among the four)
  pub fn weightOf(self &, v usize, j usize) f32 {
    var k = 0usize;
    var sum f32 = 0.;
    while k < 4usize {
      if self.joint(v, k) == j { sum = sum + self.weight(v, k); }
      k = k + 1usize;
    }
    sum
  }
}

// A segment a joint carries: tapered capsule from a to b
struct Seg {
  joint u32;
  a Vec3;
  b Vec3;
  ra f32;
  rb f32;
}

// The distance from p to the capsule's surface (negative inside), and the capsule's radius there
fn capsuleDistance(p Vec3, s &Seg) Vec3 {
  let ab = s.b - s.a;
  let len2 = ab.lengthSquared();
  var t f32 = 0.;
  if len2 > 0.0000000001 { t = clampf((p - s.a).dot(ab) / len2, 0., 1.); }
  let closest = s.a + ab * t;
  let r = s.ra + (s.rb - s.ra) * t;
  new Vec3((p - closest).length() - r, r, t)
}

// The segments of every joint that has a child, and the list of those joints
struct Carriers {
  segs List[Seg];
  joints List[u32];      // the joints that carry something, in bone order
}

// Every joint of the rig may carry the surface
pub fn allJoints(rig &Rig) List[bool] {
  var out = List[bool].empty();
  var i = 0usize;
  while i < rig.boneCount() { out.push(true); i = i + 1usize; }
  out
}

// Every joint but those of chains of the given kinds (feathers, say, which carry their own blades and not the body)
pub fn jointsExcludingKinds(rig &Rig, kinds &List[u32]) List[bool] {
  var out = List[bool].empty();
  var i = 0usize;
  while i < rig.boneCount() {
    let kind = rig.chains[usize.from(*rig.boneChain[i])].kind;
    var keep = true;
    var k = 0usize;
    while k < kinds.len() { if *kinds[k] == kind { keep = false; } k = k + 1usize; }
    out.push(keep);
    i = i + 1usize;
  }
  out
}

fn carriers(rig &Rig, mask &List[bool]) Carriers {
  var segs = List[Seg].empty();
  var joints = List[u32].empty();
  let n = rig.boneCount();
  var hasChild = List[bool].empty();
  var i = 0usize;
  while i < n { hasChild.push(false); i = i + 1usize; }
  i = 0usize;
  while i < n {
    let p = rig.skeleton.parentOf(i);
    if p >= 0i32 {
      let pj = usize.from(p);
      if *mask[pj] and *mask[i] {
        hasChild.set(pj, true);
        segs.push(new Seg(u32.from(pj), rig.restModels[pj].translation, rig.restModels[i].translation, *rig.radii[pj], *rig.radii[i]));
      }
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < n {
    if *hasChild[i] { joints.push(u32.from(i)); }
    i = i + 1usize;
  }
  new Carriers(segs, joints)
}

// The nearest carrying joint of a point, as its index in 'joints', and its distance
// (to the capsule's surface), floored at a quarter of the capsule's radius
struct Nearest {
  slot usize;
  dist f32;
  radius f32;
}

fn slotOf(c &Carriers, joint u32) usize {
  var k = 0usize;
  while k < c.joints.len() {
    if *c.joints[k] == joint { return k; }
    k = k + 1usize;
  }
  0usize
}

fn nearest(c &Carriers, p Vec3) Nearest {
  var best = 3.0e38f;
  var bestSlot = 0usize;
  var bestR f32 = 0.01;
  var k = 0usize;
  while k < c.segs.len() {
    let d = capsuleDistance(p, c.segs[k]);
    if d.x < best {
      best = d.x;
      bestSlot = slotOf(c, c.segs[k].joint);
      bestR = d.y;
    }
    k = k + 1usize;
  }
  new Nearest(bestSlot, fmaxf(best, 0.25 * bestR), bestR)
}

// The distance to each carrying joint (the least over its segments)
fn jointDistances(c &Carriers, p Vec3) List[f32] {
  var out = List[f32].empty();
  var k = 0usize;
  while k < c.joints.len() { out.push(3.0e38); k = k + 1usize; }
  k = 0usize;
  while k < c.segs.len() {
    let d = capsuleDistance(p, c.segs[k]);
    let slot = slotOf(c, c.segs[k].joint);
    let floor = 0.25 * d.y;
    let de = fmaxf(d.x, floor);
    if de < *out[slot] { out.set(slot, de); }
    k = k + 1usize;
  }
  out
}

// The best four of a vertex's per-joint weights, those under 'prune' dropped, normalised
fn pickFour(w &List[f32], joints &List[u32], prune f32, outJ &mut List[u32], outW &mut List[f32]) {
  var bj = [0usize, 0usize, 0usize, 0usize];
  var bw = [0.f, 0., 0., 0.];
  var total f32 = 0.;
  var k = 0usize;
  while k < w.len() { total = total + *w[k]; k = k + 1usize; }
  k = 0usize;
  while k < w.len() {
    let v = if total > 0. { *w[k] / total } else { 0. };
    if v >= prune {
      // Insert among the four by size
      var slot = 4usize;
      var s = 0usize;
      while s < 4usize {
        if v > bw[s] { slot = s; s = 4usize; } else { s = s + 1usize; }
      }
      if slot < 4usize {
        var m = 3usize;
        while m > slot { bw[m] = bw[m - 1usize]; bj[m] = bj[m - 1usize]; m = m - 1usize; }
        bw[slot] = v;
        bj[slot] = k;
      }
    }
    k = k + 1usize;
  }
  var sum f32 = bw[0] + bw[1] + bw[2] + bw[3];
  if sum <= 0. {
    // Nothing survived: the largest alone
    var best = 0usize;
    k = 1usize;
    while k < w.len() { if *w[k] > *w[best] { best = k; } k = k + 1usize; }
    bj[0] = best;
    bw[0] = 1.;
    sum = 1.;
  }
  k = 0usize;
  while k < 4usize {
    outJ.push(if bw[k] > 0. { *joints[bj[k]] } else { 0u32 });
    outW.push(bw[k] / sum);
    k = k + 1usize;
  }
}

// ---------------------------------------------------------------- envelope

pub fn envelopeWeights(rig &Rig, m &Mesh, params &WeightParams) VertexWeights {
  envelopeWeightsFor(rig, m, params, &allJoints(rig))
}

// The same over only the joints marked in `mask` (see jointsExcludingKinds)
pub fn envelopeWeightsFor(rig &Rig, m &Mesh, params &WeightParams, mask &List[bool]) VertexWeights {
  let c = carriers(rig, mask);
  var outJ = List[u32].empty();
  var outW = List[f32].empty();
  var v = 0usize;
  while v < m.positions.len() {
    let ds = jointDistances(&c, *m.positions[v]);
    var w = List[f32].empty();
    var k = 0usize;
    while k < ds.len() {
      let d = *ds[k];
      w.push(1. / libc.powf(d, params.power));
      k = k + 1usize;
    }
    pickFour(&w, &c.joints, params.prune, &mut outJ, &mut outW);
    v = v + 1usize;
  }
  new VertexWeights(outJ, outW, 0u32)
}

// ---------------------------------------------------------------- bone heat

// The mesh's cotangent Laplacian in compressed rows, with each vertex's mass
struct Laplacian {
  rowStart List[u32];
  col List[u32];
  wgt List[f32];
  diag List[f32];
  mass List[f32];
}

fn cotWeight(pc Vec3, pa Vec3, pb Vec3) f32 {
  let e1 = pa - pc;
  let e2 = pb - pc;
  let cr = e1.cross(e2).length();
  if cr < 0.000000000001 { return 0.; }
  fmaxf(e1.dot(e2) / cr, 0.)
}

fn buildLaplacian(m &Mesh) Laplacian {
  let nv = m.positions.len();
  let nt = m.indices.len() / 3usize;
  var count = List[u32].empty();
  var i = 0usize;
  while i < nv + 1usize { count.push(0u32); i = i + 1usize; }
  // Two entries a corner: each corner of a triangle names the other two
  i = 0usize;
  while i < nt * 3usize {
    let v = usize.from(*m.indices[i]);
    count.set(v + 1usize, *count[v + 1usize] + 2u32);
    i = i + 1usize;
  }
  var start = List[u32].empty();
  start.push(0u32);
  i = 0usize;
  while i < nv { start.push(*start[i] + *count[i + 1usize]); i = i + 1usize; }
  let total = usize.from(*start[nv]);
  var col = List[u32].empty();
  var wgt = List[f32].empty();
  i = 0usize;
  while i < total { col.push(0u32); wgt.push(0.); i = i + 1usize; }
  var fill = List[u32].empty();
  i = 0usize;
  while i < nv { fill.push(*start[i]); i = i + 1usize; }
  var mass = List[f32].empty();
  i = 0usize;
  while i < nv { mass.push(0.); i = i + 1usize; }
  var t = 0usize;
  while t < nt {
    let ia = usize.from(*m.indices[t * 3usize]);
    let ib = usize.from(*m.indices[t * 3usize + 1usize]);
    let ic = usize.from(*m.indices[t * 3usize + 2usize]);
    let pa = *m.positions[ia];
    let pb = *m.positions[ib];
    let pc = *m.positions[ic];
    let area = 0.5 * (pb - pa).cross(pc - pa).length();
    mass.set(ia, *mass[ia] + area / 3.);
    mass.set(ib, *mass[ib] + area / 3.);
    mass.set(ic, *mass[ic] + area / 3.);
    // Edge (b, c) is opposite a, and so on; half the cotangent each side. A
    // tiny floor keeps a triangle fan connected where every angle is obtuse.
    var e = 0usize;
    while e < 3usize {
      let u = if e == 0usize { ia } elif e == 1usize { ib } else { ic };
      let v = if e == 0usize { ib } elif e == 1usize { ic } else { ia };
      let w = if e == 0usize { ic } elif e == 1usize { ia } else { ib };
      // The angle at w is opposite the edge (u, v)
      let weight = 0.5 * cotWeight(*m.positions[w], *m.positions[u], *m.positions[v]) + 0.000001;
      var f = usize.from(*fill[u]);
      col.set(f, u32.from(v));
      wgt.set(f, weight);
      fill.set(u, *fill[u] + 1u32);
      f = usize.from(*fill[v]);
      col.set(f, u32.from(u));
      wgt.set(f, weight);
      fill.set(v, *fill[v] + 1u32);
      e = e + 1usize;
    }
    t = t + 1usize;
  }
  var diag = List[f32].empty();
  i = 0usize;
  while i < nv {
    var s f32 = 0.;
    var k = usize.from(*start[i]);
    while k < usize.from(*start[i + 1usize]) { s = s + *wgt[k]; k = k + 1usize; }
    diag.push(s);
    i = i + 1usize;
  }
  new Laplacian(start, col, wgt, diag, mass)
}

// Solve (L + diag(mh)) x = rhs by Jacobi-preconditioned conjugate gradient; the steps taken
fn solve(lap &Laplacian, mh &List[f32], rhs &List[f32], x &mut List[f32], maxIterations u32, tolerance f32) u32 {
  let n = rhs.len();
  var r = List[f32].empty();
  var z = List[f32].empty();
  var p = List[f32].empty();
  var ap = List[f32].empty();
  var i = 0usize;
  var bnorm f64 = 0.;
  while i < n {
    x.set(i, 0.);
    r.push(*rhs[i]);
    let d = *lap.diag[i] + *mh[i];
    let zi = if d > 0. { *rhs[i] / d } else { 0. };
    z.push(zi);
    p.push(zi);
    ap.push(0.);
    bnorm = bnorm + f64.from(*rhs[i]) * f64.from(*rhs[i]);
    i = i + 1usize;
  }
  if bnorm <= 0. { return 0u32; }
  bnorm = bnorm.sqrt();
  var rz f64 = 0.;
  i = 0usize;
  while i < n { rz = rz + f64.from(*r[i]) * f64.from(*z[i]); i = i + 1usize; }
  var it = 0u32;
  while it < maxIterations {
    // ap = A p
    i = 0usize;
    var pap f64 = 0.;
    while i < n {
      let pi = *p[i];
      var s = (*lap.diag[i] + *mh[i]) * pi;
      var k = usize.from(*lap.rowStart[i]);
      let end = usize.from(*lap.rowStart[i + 1usize]);
      while k < end { s = s - *lap.wgt[k] * (*p[usize.from(*lap.col[k])]); k = k + 1usize; }
      ap.set(i, s);
      pap = pap + f64.from(pi) * f64.from(s);
      i = i + 1usize;
    }
    if pap <= 0. { return it; }
    let alpha = rz / pap;
    var rnorm f64 = 0.;
    i = 0usize;
    while i < n {
      x.set(i, *x[i] + f32.from(alpha) * (*p[i]));
      let ri = *r[i] - f32.from(alpha) * (*ap[i]);
      r.set(i, ri);
      rnorm = rnorm + f64.from(ri) * f64.from(ri);
      i = i + 1usize;
    }
    it = it + 1u32;
    if rnorm.sqrt() < f64.from(tolerance) * bnorm { return it; }
    var rzNew f64 = 0.;
    i = 0usize;
    while i < n {
      let d = *lap.diag[i] + *mh[i];
      let zi = if d > 0. { *r[i] / d } else { 0. };
      z.set(i, zi);
      rzNew = rzNew + f64.from(*r[i]) * f64.from(zi);
      i = i + 1usize;
    }
    let beta = f32.from(rzNew / rz);
    rz = rzNew;
    i = 0usize;
    while i < n { p.set(i, *z[i] + beta * (*p[i])); i = i + 1usize; }
  }
  it
}

pub fn heatWeights(rig &Rig, m &Mesh, params &WeightParams) VertexWeights {
  heatWeightsFor(rig, m, params, &allJoints(rig))
}

// The same over only the joints marked in `mask` (see jointsExcludingKinds): the rest carry nothing, and the
// surface near them goes to the joints that are left
pub fn heatWeightsFor(rig &Rig, m &Mesh, params &WeightParams, mask &List[bool]) VertexWeights {
  let c = carriers(rig, mask);
  let nv = m.positions.len();
  let nj = c.joints.len();
  let lap = buildLaplacian(m);
  // Each vertex's nearest joint and its heat
  var near = List[usize].empty();
  var mh = List[f32].empty();
  var v = 0usize;
  while v < nv {
    let nr = nearest(&c, *m.positions[v]);
    near.push(nr.slot);
    mh.push(*lap.mass[v] * params.heat / (nr.dist * nr.dist) + 0.0000000001);
    v = v + 1usize;
  }
  // One solve a joint that is anyone's nearest
  var field = List[List[f32]].empty();
  var steps = 0u32;
  var q = 0usize;
  while q < nj {
    var rhs = List[f32].empty();
    var any = false;
    v = 0usize;
    while v < nv {
      if *near[v] == q { rhs.push(*mh[v]); any = true; } else { rhs.push(0.); }
      v = v + 1usize;
    }
    var x = List[f32].empty();
    v = 0usize;
    while v < nv { x.push(0.); v = v + 1usize; }
    if any {
      let used = solve(&lap, &mh, &rhs, &mut x, params.maxIterations, params.tolerance);
      if used > steps { steps = used; }
    }
    field.push(x);
    q = q + 1usize;
  }
  var outJ = List[u32].empty();
  var outW = List[f32].empty();
  v = 0usize;
  while v < nv {
    var w = List[f32].empty();
    q = 0usize;
    while q < nj { w.push(*field[q][v]); q = q + 1usize; }
    pickFour(&w, &c.joints, params.prune, &mut outJ, &mut outW);
    v = v + 1usize;
  }
  new VertexWeights(outJ, outW, steps)
}

// ---------------------------------------------------------------- skinning on the CPU

// The skinning transform of every bone: its posed model transform times the
// inverse of its rest one (render's skinningMatrix, as a rigid transform)
pub fn skinTransforms(rig &Rig, models &List[Transform3]) List[Transform3] {
  var out = List[Transform3].empty();
  var i = 0usize;
  while i < rig.boneCount() {
    out.push((*models[i]) * rig.restModels[i].inverse());
    i = i + 1usize;
  }
  out
}

// Where linear blend skinning carries the rest positions 'rest' when the
// bones are posed at 'models'
pub fn skinPositions(rig &Rig, w &VertexWeights, rest &List[Vec3], models &List[Transform3]) List[Vec3] {
  let bones = skinTransforms(rig, models);
  var out = List[Vec3].empty();
  var v = 0usize;
  while v < rest.len() {
    var p = new Vec3(0., 0., 0.);
    var k = 0usize;
    while k < 4usize {
      let wk = w.weight(v, k);
      if wk > 0. { p = p + bones[w.joint(v, k)].transformPoint(*rest[v]) * wk; }
      k = k + 1usize;
    }
    out.push(p);
    v = v + 1usize;
  }
  out
}

// Scalar helpers (poseik has the same two; this package does not import it)
fn fmaxf(a f32, b f32) f32 { if a > b { return a; } b }
fn fminf(a f32, b f32) f32 { if a < b { return a; } b }
