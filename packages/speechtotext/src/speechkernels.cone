// ======== The speech kernels on the GPU: made once, recorded into a gpuwork Job ========
//
// What llmkernels does not have and Parakeet needs, each in Slang (the .slang files beside this one, compiled to SPIR-V
// by tools/shaders/shaders.py and embedded in shaders.cone), each with a CPU twin in twins.cone that the tests compare
// it with:
//
//   layernorm   y = (x - mean) / sqrt(var + eps) * w + b, per row (llmkernels has only RMSNorm)
//   biasAdd     y[r][c] += bias[c], in place
//   scaleAdd    y = a + s * b     (the Conformer's half-weight residuals)
//   addRelu     y = max(a[aOff ..] + b, 0)   (the joint network)
//   glu         y[r][i] = x[r][i] * sigmoid(x[r][c + i])
//   dwconv1d    the depthwise convolution of the convolution module, then SiLU
//   conv2d      the subsampling's convolutions (strides, groups, ReLU)
//   relScores   relative-position attention scores (Transformer-XL's, with the two position biases)
//   attnValue   the weighted sum of the values
//   lstmCell    an LSTM cell's gates and state update
//
// The matrices (every linear layer, every 1x1 convolution, the LSTM's and the joint's) go through llmkernels' matmul
// and matvec, in F32 or F16 as the model file has them. Softmax is llmkernels'. Every method records ONE dispatch into
// a Job over buffers already given to it (slot numbers from 'job.give'), as llmkernels' do, and answers whether it
// recorded (false for sizes a kernel cannot run). The tensors these kernels read (norm scales and shifts, the
// small convolutions, biases, the attention's position biases) are all in one F32 buffer, 'small', each at a float
// offset.

const SK_MAX_GROUPS = 65535usize;

fn skFoldX(groups: usize) u32 {
  if groups > SK_MAX_GROUPS { return u32.from(SK_MAX_GROUPS); }
  u32.from(groups)
}

fn skFoldY(groups: usize) u32 {
  let gx = usize.from(skFoldX(groups));
  if gx == 0usize { return 0u32; }
  u32.from((groups + gx - 1usize) / gx)
}

fn skFits(n: usize) bool { n <= 4294967295usize }

struct NormParams {
  n: u32;
  rows: u32;
  eps: f32;
  wOff: u32;
  bOff: u32;
  pad0: u32;
  pad1: u32;
  pad2: u32;
}

struct BiasParams {
  n: u32;
  total: u32;
  groupsX: u32;
  bOff: u32;
}

struct ElemParams {
  n: u32;
  groupsX: u32;
  aOff: u32;
  s: f32;
}

struct GluParams {
  c: u32;
  total: u32;
  groupsX: u32;
  pad: u32;
}

struct DwParams {
  t: u32;
  c: u32;
  k: u32;
  pad: u32;
  wOff: u32;
  bOff: u32;
  total: u32;
  groupsX: u32;
}

struct ConvParams {
  cin: u32;
  cout: u32;
  groups: u32;
  h: u32;
  w: u32;
  oh: u32;
  ow: u32;
  k: u32;
  stride: u32;
  pad: u32;
  wOff: u32;
  bOff: u32;
  relu: u32;
  outMode: u32;
  total: u32;
  groupsX: u32;
}

struct ScoreParams {
  t: u32;
  nHeads: u32;
  dk: u32;
  uOff: u32;
  vOff: u32;
  scale: f32;
  total: u32;
  groupsX: u32;
}

struct ValueParams {
  t: u32;
  nHeads: u32;
  dk: u32;
  total: u32;
  groupsX: u32;
  pad0: u32;
  pad1: u32;
  pad2: u32;
}

struct LstmParams {
  n: u32;
  bOff: u32;
  pad0: u32;
  pad1: u32;
}

// The output length of a convolution over 'len' with a kernel k, stride and padding on both ends
pub fn convOutLen(len: usize, k: usize, stride: usize, pad: usize) usize {
  if len + 2usize * pad < k { return 0usize; }
  (len + 2usize * pad - k) / stride + 1usize
}

fn skParams[T](job: &mut Job, device: &mut Device, p: &T) Binding {
  if job.hasSlab() { return job.pack(p); }
  Binding.whole(job.give(uploadValue(device, p)))
}

fn skDispatch(job: &mut Job, device: &mut Device, kernel: &Kernel, p: Binding, slots: &Array[u32], x: u32, y: u32) bool {
  var bs = List[Binding].withCapacity(slots.len + 1usize);
  bs.push(p);
  var i = 0usize;
  while i < slots.len {
    bs.push(Binding.whole(slots[i]));
    i = i + 1usize;
  }
  job.dispatchBound(device, kernel, bs.view(), x, y)
}

pub struct SpeechKernels {
  normK: Kernel;
  biasK: Kernel;
  scaleAddK: Kernel;
  addReluK: Kernel;
  gluK: Kernel;
  dwK: Kernel;
  convK: Kernel;
  scoresK: Kernel;
  valueK: Kernel;
  lstmK: Kernel;

  // The pipelines, made once on this device; check 'isValid'
  pub fn make(device: &Device) SpeechKernels {
    SpeechKernels(
      Kernel.make(device, &NORM_SPIRV, "layernormMain", &[READ, READ, READ, READ_WRITE]),
      Kernel.make(device, &BIAS_SPIRV, "biasAddMain", &[READ, READ, READ_WRITE]),
      Kernel.make(device, &ELEM_SPIRV, "scaleAddMain", &[READ, READ, READ, READ_WRITE]),
      Kernel.make(device, &ELEM_SPIRV, "addReluMain", &[READ, READ, READ, READ_WRITE]),
      Kernel.make(device, &GLU_SPIRV, "gluMain", &[READ, READ, READ_WRITE]),
      Kernel.make(device, &DW_SPIRV, "dwconv1dMain", &[READ, READ, READ, READ_WRITE]),
      Kernel.make(device, &CONV_SPIRV, "conv2dMain", &[READ, READ, READ, READ_WRITE]),
      Kernel.make(device, &SCORES_SPIRV, "relScoresMain", &[READ, READ, READ, READ, READ, READ_WRITE]),
      Kernel.make(device, &VALUE_SPIRV, "attnValueMain", &[READ, READ, READ, READ_WRITE]),
      Kernel.make(device, &LSTM_SPIRV, "lstmCellMain", &[READ, READ, READ, READ, READ, READ_WRITE, READ_WRITE]))
  }

  pub fn isValid(self: &) bool {
    normK.isValid() && biasK.isValid() && scaleAddK.isValid() && addReluK.isValid() && gluK.isValid() && dwK.isValid()
      && convK.isValid() && scoresK.isValid() && valueK.isValid() && lstmK.isValid()
  }

  // y = (x - mean) / sqrt(var + eps) * small[wOff ..] + small[bOff ..], for each of 'rows' rows of n (at most 65535 rows)
  pub fn layernorm(self: &, job: &mut Job, device: &mut Device, small: u32, x: u32, y: u32, n: usize, rows: usize,
      eps: f32, wOff: usize, bOff: usize) bool {
    if n == 0usize || rows == 0usize || rows > SK_MAX_GROUPS || !skFits(n * rows) || !skFits(wOff + n) || !skFits(bOff + n) {
      return false;
    }
    let p = skParams(job, device, &NormParams(u32.from(n), u32.from(rows), eps, u32.from(wOff), u32.from(bOff), 0u32, 0u32, 0u32));
    skDispatch(job, device, &normK, p, &[small, x, y], u32.from(rows), 1u32)
  }

  // y[r * n + c] += small[bOff + c], in place, over 'rows' rows of n
  pub fn biasAdd(self: &, job: &mut Job, device: &mut Device, small: u32, y: u32, n: usize, rows: usize, bOff: usize) bool {
    let total = n * rows;
    if n == 0usize || rows == 0usize || !skFits(total) || !skFits(bOff + n) { return false; }
    let groups = (total + 255usize) / 256usize;
    let gx = skFoldX(groups);
    let gy = skFoldY(groups);
    if usize.from(gy) > SK_MAX_GROUPS { return false; }
    let p = skParams(job, device, &BiasParams(u32.from(n), u32.from(total), gx, u32.from(bOff)));
    skDispatch(job, device, &biasK, p, &[small, y], gx, gy)
  }

  fn element(self: &, job: &mut Job, device: &mut Device, kernel: &Kernel, a: u32, b: u32, y: u32, n: usize, aOff: usize, s: f32) bool {
    if n == 0usize || !skFits(n) || !skFits(aOff + n) { return false; }
    let groups = (n + 255usize) / 256usize;
    let gx = skFoldX(groups);
    let gy = skFoldY(groups);
    if usize.from(gy) > SK_MAX_GROUPS { return false; }
    let p = skParams(job, device, &ElemParams(u32.from(n), gx, u32.from(aOff), s));
    skDispatch(job, device, kernel, p, &[a, b, y], gx, gy)
  }

  // y[i] = a[i] + s * b[i] for i < n
  pub fn scaleAdd(self: &, job: &mut Job, device: &mut Device, a: u32, b: u32, y: u32, n: usize, s: f32) bool {
    self.element(job, device, &scaleAddK, a, b, y, n, 0usize, s)
  }

  // y[i] = max(a[aOff + i] + b[i], 0) for i < n
  pub fn addRelu(self: &, job: &mut Job, device: &mut Device, a: u32, aOff: usize, b: u32, y: u32, n: usize) bool {
    self.element(job, device, &addReluK, a, b, y, n, aOff, 0.0)
  }

  // y[r][i] = x[r][i] * sigmoid(x[r][c + i]) for 'rows' rows (x rows of 2 c, y rows of c)
  pub fn glu(self: &, job: &mut Job, device: &mut Device, x: u32, y: u32, c: usize, rows: usize) bool {
    let total = c * rows;
    if c == 0usize || rows == 0usize || !skFits(2usize * total) { return false; }
    let groups = (total + 255usize) / 256usize;
    let gx = skFoldX(groups);
    let gy = skFoldY(groups);
    if usize.from(gy) > SK_MAX_GROUPS { return false; }
    let p = skParams(job, device, &GluParams(u32.from(c), u32.from(total), gx, 0u32));
    skDispatch(job, device, &gluK, p, &[x, y], gx, gy)
  }

  // The depthwise 1-D convolution then SiLU over t steps of c channels (time-major): weights c rows of k at
  // small[wOff ..], biases at small[bOff ..], 'pad' zeros either side
  pub fn dwconv(self: &, job: &mut Job, device: &mut Device, small: u32, x: u32, y: u32, t: usize, c: usize, k: usize,
      pad: usize, wOff: usize, bOff: usize) bool {
    let total = t * c;
    if t == 0usize || c == 0usize || k == 0usize || !skFits(total) || !skFits(wOff + c * k) || !skFits(bOff + c) { return false; }
    let groups = (total + 255usize) / 256usize;
    let gx = skFoldX(groups);
    let gy = skFoldY(groups);
    if usize.from(gy) > SK_MAX_GROUPS { return false; }
    let p = skParams(job, device, &DwParams(u32.from(t), u32.from(c), u32.from(k), u32.from(pad), u32.from(wOff),
      u32.from(bOff), u32.from(total), gx));
    skDispatch(job, device, &dwK, p, &[small, x, y], gx, gy)
  }

  // A 2-D convolution of cin channels of h x w (channel-major) to cout channels, kernel k x k, 'groups' groups; weights
  // [cout][cin / groups][k][k] at small[wOff ..], biases at small[bOff ..]; ReLU after if 'relu'. outMode 0 writes
  // [co][oy][ox], outMode 1 writes [oy][co * ow + ox]. The output is convOutLen(h, ..) x convOutLen(w, ..).
  pub fn conv2d(self: &, job: &mut Job, device: &mut Device, small: u32, x: u32, y: u32, cin: usize, cout: usize,
      groups: usize, h: usize, w: usize, k: usize, stride: usize, pad: usize, wOff: usize, bOff: usize, relu: bool,
      outMode: u32) bool {
    if cin == 0usize || cout == 0usize || groups == 0usize || cin % groups != 0usize || cout % groups != 0usize { return false; }
    if h == 0usize || w == 0usize || k == 0usize || stride == 0usize || outMode > 1u32 { return false; }
    let oh = convOutLen(h, k, stride, pad);
    let ow = convOutLen(w, k, stride, pad);
    let total = cout * oh * ow;
    if oh == 0usize || ow == 0usize || !skFits(total) || !skFits(cin * h * w) || !skFits(wOff + cout * (cin / groups) * k * k)
      || !skFits(bOff + cout) { return false; }
    let gs = (total + 255usize) / 256usize;
    let gx = skFoldX(gs);
    let gy = skFoldY(gs);
    if usize.from(gy) > SK_MAX_GROUPS { return false; }
    var r = 0u32;
    if relu { r = 1u32; }
    let p = skParams(job, device, &ConvParams(u32.from(cin), u32.from(cout), u32.from(groups), u32.from(h), u32.from(w),
      u32.from(oh), u32.from(ow), u32.from(k), u32.from(stride), u32.from(pad), u32.from(wOff), u32.from(bOff), r, outMode,
      u32.from(total), gx));
    skDispatch(job, device, &convK, p, &[small, x, y], gx, gy)
  }

  // scores[h][i][j] for t positions: q, k are t rows of nHeads * dk, pos is 2 t - 1 rows of the same width; the position
  // biases u and v at small[uOff ..] and small[vOff ..] (nHeads * dk each); times 'scale'
  pub fn relScores(self: &, job: &mut Job, device: &mut Device, small: u32, q: u32, k: u32, pos: u32, scores: u32, t: usize,
      nHeads: usize, dk: usize, uOff: usize, vOff: usize, scale: f32) bool {
    let total = nHeads * t * t;
    if t == 0usize || nHeads == 0usize || dk == 0usize || !skFits(total) || !skFits((2usize * t) * nHeads * dk)
      || !skFits(uOff + nHeads * dk) || !skFits(vOff + nHeads * dk) { return false; }
    let gs = (total + 255usize) / 256usize;
    let gx = skFoldX(gs);
    let gy = skFoldY(gs);
    if usize.from(gy) > SK_MAX_GROUPS { return false; }
    let p = skParams(job, device, &ScoreParams(u32.from(t), u32.from(nHeads), u32.from(dk), u32.from(uOff), u32.from(vOff),
      scale, u32.from(total), gx));
    skDispatch(job, device, &scoresK, p, &[small, q, k, pos, scores], gx, gy)
  }

  // out[i][h * dk + d] = sum over j of w[h][i][j] * v[j][h * dk + d]
  pub fn attnValue(self: &, job: &mut Job, device: &mut Device, w: u32, v: u32, out: u32, t: usize, nHeads: usize, dk: usize) bool {
    let total = t * nHeads * dk;
    if t == 0usize || nHeads == 0usize || dk == 0usize || !skFits(total) || !skFits(nHeads * t * t) { return false; }
    let gs = (total + 255usize) / 256usize;
    let gx = skFoldX(gs);
    let gy = skFoldY(gs);
    if usize.from(gy) > SK_MAX_GROUPS { return false; }
    let p = skParams(job, device, &ValueParams(u32.from(t), u32.from(nHeads), u32.from(dk), u32.from(total), gx, 0u32, 0u32, 0u32));
    skDispatch(job, device, &valueK, p, &[w, v, out], gx, gy)
  }

  // An LSTM cell's update of n units from gi = W_ih x and gh = W_hh h (4 n floats each), the summed bias at small[bOff ..]
  // (4 n floats), and the previous cell state: the new hidden state and cell state
  pub fn lstmCell(self: &, job: &mut Job, device: &mut Device, small: u32, gi: u32, gh: u32, cPrev: u32, hNew: u32, cNew: u32,
      n: usize, bOff: usize) bool {
    if n == 0usize || (n + 255usize) / 256usize > SK_MAX_GROUPS || !skFits(bOff + 4usize * n) { return false; }
    let p = skParams(job, device, &LstmParams(u32.from(n), u32.from(bOff), 0u32, 0u32));
    skDispatch(job, device, &lstmK, p, &[small, gi, gh, cPrev, hNew, cNew], u32.from((n + 255usize) / 256usize), 1u32)
  }
}
