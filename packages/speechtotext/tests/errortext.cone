// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import fs;
import path use Path;
import safetensors use *;
import speechtotext use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- SpeechToTextError(String.from("speechtotext: no vocabulary")), "speechtotext: no vocabulary", "plain");
  says(String() <- SpeechToTextError.from(SafetensorsError(String.from("safetensors: not a safetensors file"))), "speechtotext: safetensors: not a safetensors file", "from safetensors");
  done()
}
