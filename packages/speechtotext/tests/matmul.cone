// The tiled matrix-matrix product of this package (a 64 x 64 tile of Y to a workgroup, F32 and F16 weights) against its CPU
// twin and against llmkernels' matmul, over rows, columns and batch sizes that are not multiples of the tile or of the 16-column
// step, the encoder's own shapes, and a matrix at a byte offset in a larger weights buffer with X and Y read and written from
// element offsets.
//
// Two checks. The result is within llmreference's sumTolerance of the twin's (f64) value: (cols + 4) * 2^-24 times the sum of
// the absolute values of its products, the bound any order of adding obeys. And it equals llmkernels' matmul's result BIT FOR
// BIT: both add each output in column order, one product at a time, so the speed of this kernel changes no number the
// encoder computes. The worst error against the twin, in units of 2^-24 times that sum, is printed with STT_REPORT set.
//
// Only a failure prints. It needs a GPU with Vulkan 1.3 and SDL3.dll; with the Vulkan SDK, validation is on and must say nothing.

mod matmultest;

import testing use *;
import stdio use *;
import libc;
import collections use List;
import random use Rng;
import gpu use *;
import gpuwork use *;
import llmreference use *;
import llmkernels use Kernels, floatWords, wordFloats;
import speechtotext use SpeechKernels;

fn preference() u32 {
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize && libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE
}

fn zerosF(n: usize) List[f32] {
  var l = List[f32].withCapacity(n);
  var i = 0usize;
  while i < n { l.push(0.0); i = i + 1usize; }
  l
}

fn zerosD(n: usize) List[f64] {
  var l = List[f64].withCapacity(n);
  var i = 0usize;
  while i < n { l.push(0.0); i = i + 1usize; }
  l
}

struct Stats {
  worst: f64;
}

// One matmul on the GPU, by this package's kernel and by llmkernels', against the twin: outputs outside the bound, and
// outputs that differ between the two kernels
fn run(device: &mut Device, sk: &SpeechKernels, lk: &Kernels, works: &mut Works, stats: &mut Stats, rng: &mut Rng, qt: u32,
    rows: usize, cols: usize, batch: usize, wPad: usize, xPad: usize, yPad: usize) u64 {
  match syntheticMatrix(rng, qt, rows, cols) {
    case let Some(m) {
      let x = syntheticFloats(rng, cols * batch, 1.0);
      var want = zerosF(rows * batch);
      var mag = zerosD(rows * batch);
      matmulCpu(&m, x.view(), batch, want.viewMut());
      matmulMagnitudeCpu(&m, x.view(), batch, mag.viewMut());
      var bytes = List[u8].empty();
      var i = 0usize;
      while i < wPad { bytes.push(0xa5u8); i = i + 1usize; }
      i = 0usize;
      while i < m.bytes.len() { bytes.push(*m.bytes[i]); i = i + 1usize; }
      var xs = List[f32].withCapacity(xPad + cols * batch);
      i = 0usize;
      while i < xPad { xs.push(9.0); i = i + 1usize; }
      i = 0usize;
      while i < cols * batch { xs.push(*x[i]); i = i + 1usize; }
      var job = Job.make(device);
      let w = job.give(upload(device, packWords(bytes.view()).view()));
      let xb = job.give(upload(device, floatWords(xs.view()).view()));
      let yb = job.give(zeroed(device, yPad + rows * batch));
      let zb = job.give(zeroed(device, yPad + rows * batch));
      require(sk.matmul(&mut job, device, w, xb, yb, qt, rows, cols, batch, wPad, xPad, yPad), "the matmul recorded");
      require(lk.matmulAt(&mut job, device, w, xb, zb, qt, rows, cols, batch, wPad, xPad, yPad), "llmkernels' matmul recorded");
      let back = job.readback(device, yb);
      let backZ = job.readback(device, zb);
      let ticket = works.submit(device, job, Target.Here(1u64));
      var got = List[Completion].empty();
      works.waitFor(device, ticket, &mut got);
      require(got.len() == 1usize, "the job's completion");
      expectBool(got[0usize].ok, true, "the job ran");
      let y = wordFloats(got[0usize].words(back).view());
      let z = wordFloats(got[0usize].words(backZ).view());
      var bad = 0u64;
      i = 0usize;
      while i < yPad { if *y[i] != 0.0 { bad = bad + 1u64; } i = i + 1usize; }
      i = 0usize;
      while i < rows * batch {
        let err = libc.fabs(f64.from(*y[yPad + i]) - f64.from(*want[i]));
        let bound = sumTolerance(cols, *mag[i]);
        if !(err <= bound) { bad = bad + 1u64; }
        if (*y[yPad + i] as u32) != (*z[yPad + i] as u32) { bad = bad + 1u64; }
        if *mag[i] > 0.0 {
          let units = err / (5.9604644775390625e-8 * *mag[i]);
          if units > stats.worst { stats.worst = units; }
        }
        i = i + 1usize;
      }
      if bad > 0u64 {
        printStr("matmul case failed: type ");
        printUInt(u64.from(qt));
        printStr(" rows ");
        printUInt(u64.from(rows));
        printStr(" cols ");
        printUInt(u64.from(cols));
        printStr(" batch ");
        printUInt(u64.from(batch));
        printStr(" pads ");
        printUInt(u64.from(wPad));
        printStr(" ");
        printUInt(u64.from(xPad));
        printStr(" ");
        printUInt(u64.from(yPad));
        printStr("\n");
      }
      return bad;
    }
    case is None { return 999999u64; }
  }
  999999u64
}

fn main() i32 {
  var instance = Instance.create("speechtotext matmul");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");
  var device = adapter.requestDevice();
  require(device.isValid(), "a device");
  let sk = SpeechKernels.make(&device);
  let lk = Kernels.make(&device);
  require(sk.isValid() && lk.isValid(), "the kernels");
  var works = Works.make();
  var stats = Stats(0.0);
  var rng = Rng.fromSeed(31337u64);
  var q = 0usize;
  while q < 2usize {
    let qt = if q == 0usize { QTYPE_F32 } else { QTYPE_F16 };
    let name = if q == 0usize { "F32" } else { "F16" };
    q = q + 1usize;
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 1usize, 1usize, 1usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 15usize, 17usize, 3usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 16usize, 16usize, 16usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 64usize, 64usize, 64usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 65usize, 33usize, 65usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 100usize, 1000usize, 40usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 130usize, 255usize, 129usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 4096usize, 1024usize, 30usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 1024usize, 4096usize, 190usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 1024usize, 1024usize, 379usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 70usize, 90usize, 20usize, 512usize, 64usize, 128usize), 0u64, name);
    // columns a multiple of 32 (F16: the wide-load form), with edges in rows and batch, aligned and misaligned offsets
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 100usize, 96usize, 70usize, 256usize, 64usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 100usize, 96usize, 70usize, if qt == QTYPE_F16 { 18usize } else { 20usize }, 3usize, 5usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 1usize, 32usize, 1usize, 0usize, 0usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 63usize, 32usize, 65usize, 16usize, 4usize, 0usize), 0u64, name);
    expectUInt(run(&mut device, &sk, &lk, &mut works, &mut stats, &mut rng, qt, 640usize, 1024usize, 59usize, 0usize, 0usize, 0usize), 0u64, name);
  }
  // refusals
  {
    var job = Job.make(&mut device);
    let a = job.give(zeroed(&mut device, 64usize));
    let b = job.give(zeroed(&mut device, 64usize));
    let c = job.give(zeroed(&mut device, 64usize));
    expectBool(sk.matmul(&mut job, &mut device, a, b, c, QTYPE_Q8_0, 4usize, 32usize, 1usize, 0usize, 0usize, 0usize), false, "a quantised type is refused (llmkernels' matmul serves those)");
    expectBool(sk.matmul(&mut job, &mut device, a, b, c, QTYPE_F32, 0usize, 4usize, 1usize, 0usize, 0usize, 0usize), false, "no rows is refused");
    expectBool(sk.matmul(&mut job, &mut device, a, b, c, QTYPE_F32, 4usize, 0usize, 1usize, 0usize, 0usize, 0usize), false, "no columns is refused");
    expectBool(sk.matmul(&mut job, &mut device, a, b, c, QTYPE_F32, 4usize, 4usize, 0usize, 0usize, 0usize, 0usize), false, "no batch is refused");
    expectBool(sk.matmul(&mut job, &mut device, a, b, c, QTYPE_F32, 4usize, 4usize, 1usize, 0usize, 0usize, 0usize), true, "a good matmul is recorded");
    let t = works.submit(&mut device, job, Target.Here(2u64));
    var got = List[Completion].empty();
    works.waitFor(&mut device, t, &mut got);
    expectBool(got[0usize].ok, true, "the job with only the good dispatch ran");
  }
  if (libc.getenv("STT_REPORT") as usize) != 0usize {
    printStr("matmul worst: "); printFloat(stats.worst); printStr(" x 2^-24 of the sum of absolute products (bound cols + 4)\n");
  }
  expectUInt(u64.from(refusals()), 0u64, "gpuwork refused nothing");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  device.endFrame();
  device.waitIdle();
  done()
}
