// ======== The impostor bake: an object photographed from a grid of directions ========
//
// 'ImpostorBaker.bake' draws an object from each frame direction of an octahedral
// grid (octahedral.cone), orthographically, with the camera on that direction's
// axis looking at the middle of the object's bounding sphere and the sphere, a
// little padded, filling the picture. It makes two pictures a frame, with the
// renderer itself, offscreen:
//
//   1. COLOUR AND COVERAGE: the object drawn with render's lit material under
//      ambient light alone (the light 0, the ambient 1), so what is written is the
//      material's base colour times its texture: the albedo, flat. The target
//      is sRGB, so the bytes are sRGB-encoded colour and the alpha is coverage (the
//      target is cleared to alpha 0, and the lit material writes 1 where it draws).
//   2. NORMAL AND DEPTH: the same geometry through impostorbake.slang, a custom
//      pipeline writing the object-space normal (n * 0.5 + 0.5) in rgb and the
//      surface's height above the plane through the sphere's middle (0..1 across
//      the sphere's diameter) in alpha. The target is plain RGBA8.
//
// Frame (i, j) goes into cell (i, j) of two atlases (a square of grid x grid
// cells, each frameSize pixels), rows from the top as the picture comes off the
// GPU, which the renderer uploads as it is.
//
// THE PADDING. The sphere is drawn a sixteenth larger than it is, so the
// outermost leaf or wall has empty texels round it and the atlas's mip levels
// (which average a cell with its neighbours' edges once a cell is only a few
// pixels) cannot bring a neighbour's picture in.
//
// THE DILATION. After the bake, empty texels (coverage 0) within 'dilate' pixels
// of a covered one take its colour, normal and depth (the colour of the edge
// pixel repeated outward). The coverage stays 0. Without it a bilinear sample at
// an edge averages the object with black and rims it in dark; with it the average
// is the object's colour (the practice of every sprite atlas; Brucks' impostors
// and Unity's do it).
//
// WHAT THE COLOUR PASS IS NOT. It is not a g-buffer: the colour is whatever the
// parts' Blinn-Phong materials give under flat white light (their base colour
// times texture, plus any emissive). A physically based material is baked by
// handing the bake a Blinn stand-in with its base colour and texture; the
// impostor's own lighting then supplies the light (Lambert and ambient), without
// the original's specular or coat. That is the cost of an impostor.

// How the impostor's card keeps or drops a pixel by its coverage (the blend of the frames' alpha):
// CUT drops it below 'alphaCutoff' (the mips' alpha raised so as many pass as at level 0): crisp edges,
//   right for a solid object (a rock, a house), but a sparse one (a crown of leaves) loses all that is
//   thinner than half-covered and shrinks to its dense core;
// HASHED keeps it with the probability of its coverage (alpha hashing: Wyman and McGuire, "Hashed Alpha
//   Testing", I3D 2017), so a sparse object keeps its extent and its density, at the price of a stippled
//   edge on a solid one;
// AUTO chooses by the bake's POROSITY: the share of covered texels that touch an uncovered one, averaged
//   over the frames: about 0.07 for a rock or a house at 128 pixels a frame, about 1 for a crown.
pub const IMPOSTOR_ALPHA_CUT = 0u32;
pub const IMPOSTOR_ALPHA_HASHED = 1u32;
pub const IMPOSTOR_ALPHA_AUTO = 2u32;

pub struct ImpostorSettings {
  pub grid u32 = 8u32;               // frames a side (grid x grid frames)
  pub frameSize u32 = 128u32;        // pixels a side of a frame
  pub hemisphere bool = true;        // upper hemisphere only (objects standing on the ground)
  pub padding f32 = 0.0625;          // the sphere is framed this much larger than it is
  pub alphaMode u32 = IMPOSTOR_ALPHA_AUTO;   // how a pixel of the card is kept or dropped (below)
  pub hashPorosity f32 = 0.3;        // AUTO hashes an object whose frames' covered texels are this share or more on an edge
  pub alphaCutoff f32 = 0.5;         // CUT: the card drops pixels whose blended coverage is below it
  pub dilate u32 = 4u32;             // pixels the edge colour is repeated outward
  pub environmentLight bool = false; // light the card by the sky's irradiance cube, not the frame's ambient (a world drawn with physically based materials)
  pub mipBias f32 = 0.;              // added to the atlas level the shader reads (positive: blurrier, steadier)

  // The radius the frames are drawn at, for an object of bounding radius 'radius'
  pub fn framedRadius(self, radius f32) f32 { radius * (1. + padding) }
}

// A part to bake: a mesh, its material as Blinn-Phong, and the image its texture
// was made from (an empty image: no texture)
pub struct BakePart {
  pub mesh Mesh;
  pub material Material;
  pub image Image;
  pub thinPieces bool = false;      // the mesh is a scatter of small pieces (foliage, grass, rubble): its levels draw fewer, larger ones
}

// The baked pictures, on the CPU
pub struct ImpostorAtlas {
  pub albedo Image;                  // grid x frameSize square, 4 channels: sRGB colour, coverage
  pub normals Image;                 // the same: object-space normal * 0.5 + 0.5, depth
  pub grid u32;
  pub frameSize u32;
  pub hemisphere bool;
  pub center Vec3;                   // of the object's bounding sphere
  pub radius f32;                    // the FRAMED radius (padding included)
  pub porosity f32;                  // the share of covered texels on an edge, over all the frames
}

pub struct ImpostorBaker {
  pub frameSize u32;
  albedoRenderer Renderer;
  normalRenderer Renderer;
  normalPipeline PipelineHandle;
  colourTarget Texture;
  normalTarget Texture;
  depthTarget Texture;
  colourRead Buffer;
  normalRead Buffer;

  // A baker for frames of 'frameSize' pixels: its two renderers, targets and
  // read-back buffers. Make one and bake with it as often as wanted. Check 'isValid'.
  pub fn create(device &mut Device, frameSize u32) ImpostorBaker {
    let colourDesc = new TextureDescriptor(frameSize, frameSize, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
    let normalDesc = new TextureDescriptor(frameSize, frameSize, TEXTURE_FORMAT_RGBA8_UNORM,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
    let depthDesc = new TextureDescriptor(frameSize, frameSize, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
    var colourTarget = device.createTexture(&colourDesc);
    var normalTarget = device.createTexture(&normalDesc);
    var depthTarget = device.createTexture(&depthDesc);
    let bytes = u64.from(frameSize) * u64.from(frameSize) * 4u64;
    var colourRead = device.createBuffer(bytes, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    var normalRead = device.createBuffer(bytes, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    var albedoRenderer = Renderer.create(device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_FORMAT_DEPTH32_FLOAT);
    var normalRenderer = Renderer.create(device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
    let sampleTypes = [TEXTURE_SAMPLE_TYPE_FLOAT];
    let desc = new CustomPipeline(spirv: &IMPOSTORBAKE_SPIRV, textures: &sampleTypes, streams: 3u32, paramBytes: 48u64);
    let normalPipeline = normalRenderer.addPipeline(device, &desc);
    new ImpostorBaker(frameSize, albedoRenderer, normalRenderer, normalPipeline, colourTarget, normalTarget, depthTarget,
      colourRead, normalRead)
  }

  pub fn isValid(self &) bool {
    albedoRenderer.isValid() and normalRenderer.isValid() and normalRenderer.hasPipeline(normalPipeline)
  }

  // Bake 'parts', which together fill a sphere of centre 'center' and radius
  // 'radius' (object space, not yet padded), with the settings' grid. The
  // settings' frame size must be this baker's.
  pub fn bake(self &mut, device &mut Device, parts &List[BakePart], center Vec3, radius f32, s &ImpostorSettings) ImpostorAtlas {
    let grid = s.grid;
    let size = usize.from(grid * frameSize);
    let framed = s.framedRadius(radius);
    var albedo = new Image(i32.from(size), i32.from(size), 4, List[u8].withCapacity(size * size * 4usize));
    albedo.pixels.resize(size * size * 4usize, 0u8);
    var normals = new Image(i32.from(size), i32.from(size), 4, List[u8].withCapacity(size * size * 4usize));
    normals.pixels.resize(size * size * 4usize, 0u8);
    if grid < 2u32 or s.frameSize != frameSize or parts.len() == 0usize or !self.isValid() {
      return new ImpostorAtlas(albedo, normals, grid, frameSize, s.hemisphere, center, framed, 0.);
    }

    // The parts in both renderers
    var albedoMeshes = List[MeshHandle].empty();
    var albedoMaterials = List[MaterialHandle].empty();
    var albedoTextures = List[TextureHandle].empty();
    var normalMeshes = List[MeshHandle].empty();
    var normalMaterials = List[MaterialHandle].empty();
    var normalTextures = List[TextureHandle].empty();
    var p = 0usize;
    while p < parts.len() {
      var material = parts[p].material;
      var aTexture = TextureHandle.none();
      var nTexture = TextureHandle.none();
      if !parts[p].image.isEmpty() {
        if material.alphaMode == ALPHA_MASK {
          aTexture = self.albedoRenderer.addCutoutTexture(device, &parts[p].image, material.alphaCutoff);
          nTexture = self.normalRenderer.addCutoutTexture(device, &parts[p].image, material.alphaCutoff);
        } else {
          aTexture = self.albedoRenderer.addTexture(device, &parts[p].image);
          nTexture = self.normalRenderer.addTexture(device, &parts[p].image);
        }
        material.texture = aTexture;
      }
      albedoMeshes.push(self.albedoRenderer.addMesh(device, &parts[p].mesh));
      albedoMaterials.push(self.albedoRenderer.addMaterial(device, &material));
      albedoTextures.push(aTexture);
      normalMeshes.push(self.normalRenderer.addMesh(device, &parts[p].mesh));
      let noParams = [0.];
      let maps = [nTexture];
      normalMaterials.push(self.normalRenderer.addCustomMaterial(device, self.normalPipeline, &noParams, &maps));
      normalTextures.push(nTexture);
      p = p + 1usize;
    }
    var albedoList = DrawList.empty();
    var normalList = DrawList.empty();
    p = 0usize;
    while p < parts.len() {
      albedoList.add(*albedoMeshes[p], *albedoMaterials[p], Mat4.identity());
      normalList.add(*normalMeshes[p], *normalMaterials[p], Mat4.identity());
      p = p + 1usize;
    }
    let flatLight = Light.directional(new Vec3(0., -1., 0.), new Color(0., 0., 0., 1.), new Color(1., 1., 1., 1.));

    var frameNumber = 0u32;
    while frameNumber < grid * grid {
      let i = frameNumber % grid;
      let j = frameNumber / grid;
      let dir = frameDirection(i, j, grid, s.hemisphere);
      let basis = frameBasis(dir);
      var camera = Camera.make();
      camera.projection = Orthogonal;
      camera.viewHeight = framed;
      camera.near = framed * 0.5;
      camera.far = framed * 3.5;
      camera.lookAt(center + dir * (framed * 2.), center, basis.up);

      // 1. colour and coverage
      camera.background = new Color(0., 0., 0., 0.);
      drawPass(device, &mut self.albedoRenderer, &self.colourTarget, &self.depthTarget, &self.colourRead, &camera,
        &flatLight, &albedoList);
      copyFrame(self.colourRead.mappedRange(), &mut albedo, i, j, size, frameSize);

      // 2. normal and depth: each part's parameters for this frame
      p = 0usize;
      while p < parts.len() {
        let cutoff = if parts[p].material.alphaMode == ALPHA_MASK { parts[p].material.alphaCutoff } else { 0. };
        let params = [center.x, center.y, center.z, framed, dir.x, dir.y, dir.z, cutoff, parts[p].material.baseColor.alpha,
          0., 0., 0.];
        self.normalRenderer.setCustomParams(device, *normalMaterials[p], &params);
        p = p + 1usize;
      }
      camera.background = new Color(0.5, 0.5, 1., 0.5);
      drawPass(device, &mut self.normalRenderer, &self.normalTarget, &self.depthTarget, &self.normalRead, &camera,
        &flatLight, &normalList);
      copyFrame(self.normalRead.mappedRange(), &mut normals, i, j, size, frameSize);
      frameNumber = frameNumber + 1u32;
    }

    // Give the parts back
    p = 0usize;
    while p < parts.len() {
      self.albedoRenderer.removeMesh(device, *albedoMeshes[p]);
      self.albedoRenderer.removeMaterial(device, *albedoMaterials[p]);
      if !albedoTextures[p].isNone() { self.albedoRenderer.removeTexture(device, *albedoTextures[p]); }
      self.normalRenderer.removeMesh(device, *normalMeshes[p]);
      self.normalRenderer.removeMaterial(device, *normalMaterials[p]);
      if !normalTextures[p].isNone() { self.normalRenderer.removeTexture(device, *normalTextures[p]); }
      p = p + 1usize;
    }
    let porosity = porosityOf(&albedo, grid, frameSize);
    dilateAtlas(&mut albedo, &mut normals, grid, frameSize, s.dilate);
    new ImpostorAtlas(albedo, normals, grid, frameSize, s.hemisphere, center, framed, porosity)
  }
}

// The share of the atlas's covered texels that have an uncovered four-neighbour (a texel on a frame's own
// border counts as touching the outside), over all the frames
fn porosityOf(albedo &Image, grid u32, frameSize u32) f32 {
  let size = usize.from(grid * frameSize);
  let f = usize.from(frameSize);
  var covered = 0u64;
  var edge = 0u64;
  var cj = 0usize;
  while cj < usize.from(grid) {
    var ci = 0usize;
    while ci < usize.from(grid) {
      var y = 0usize;
      while y < f {
        var x = 0usize;
        while x < f {
          let at = ((cj * f + y) * size + ci * f + x) * 4usize + 3usize;
          if *albedo.pixels[at] > 0u8 {
            covered = covered + 1u64;
            var touches = x == 0usize or y == 0usize or x + 1usize == f or y + 1usize == f;
            if !touches {
              if *albedo.pixels[at - 4usize] == 0u8 or *albedo.pixels[at + 4usize] == 0u8
                or *albedo.pixels[at - size * 4usize] == 0u8 or *albedo.pixels[at + size * 4usize] == 0u8 {
                touches = true;
              }
            }
            if touches { edge = edge + 1u64; }
          }
          x = x + 1usize;
        }
        y = y + 1usize;
      }
      ci = ci + 1usize;
    }
    cj = cj + 1usize;
  }
  if covered == 0u64 { return 0.; }
  f32.from(edge) / f32.from(covered)
}

// Draw one pass into its target, copy the target into its read-back buffer, and wait
fn drawPass(device &mut Device, renderer &mut Renderer, target &Texture, depth &Texture, readback &Buffer, camera &Camera,
    light &Light, list &DrawList) {
  var encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, target, depth, camera, light, list);
  encoder.copyTextureToBuffer(target, readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

// The frame in 'src' (frameSize square, 4 bytes a texel, rows from the top) into cell (i, j) of 'image'
fn copyFrame(src *u8, image &mut Image, i u32, j u32, size usize, frameSize u32) {
  let f = usize.from(frameSize);
  var y = 0usize;
  while y < f {
    let dst = ((usize.from(j) * f + y) * size + usize.from(i) * f) * 4usize;
    let from = y * f * 4usize;
    var k = 0usize;
    while k < f * 4usize {
      image.pixels.set(dst + k, *(src + from + k));
      k = k + 1usize;
    }
    y = y + 1usize;
  }
}

// Repeat the colour, normal and depth of covered texels outward into empty ones,
// 'steps' texels, inside each cell. Coverage (the albedo's alpha) is not changed.
fn dilateAtlas(albedo &mut Image, normals &mut Image, grid u32, frameSize u32, steps u32) {
  if steps == 0u32 { return; }
  let size = usize.from(grid * frameSize);
  let f = usize.from(frameSize);
  var filled = List[u8].withCapacity(f * f);
  var next = List[u8].withCapacity(f * f);
  var cj = 0u32;
  while cj < grid {
    var ci = 0u32;
    while ci < grid {
      let x0 = usize.from(ci) * f;
      let y0 = usize.from(cj) * f;
      filled.clear();
      var y = 0usize;
      while y < f {
        var x = 0usize;
        while x < f {
          let at = ((y0 + y) * size + x0 + x) * 4usize + 3usize;
          filled.push(if *albedo.pixels[at] > 0u8 { 1u8 } else { 0u8 });
          x = x + 1usize;
        }
        y = y + 1usize;
      }
      var step = 0u32;
      while step < steps {
        next.clear();
        var k = 0usize;
        while k < f * f {
          next.push(*filled[k]);
          k = k + 1usize;
        }
        y = 0usize;
        while y < f {
          var x = 0usize;
          while x < f {
            if *filled[y * f + x] == 0u8 {
              // the mean of the filled four-neighbours
              var count = 0u32;
              var sum = new Vec3(0., 0., 0.);
              var sumN = new Vec4(0., 0., 0., 0.);
              var n = 0usize;
              while n < 4usize {
                var sx = x;
                var sy = y;
                if n == 0usize { if x + 1usize < f { sx = x + 1usize; } else { sx = x; } }
                if n == 1usize { if x > 0usize { sx = x - 1usize; } }
                if n == 2usize { if y + 1usize < f { sy = y + 1usize; } }
                if n == 3usize { if y > 0usize { sy = y - 1usize; } }
                if (sx != x or sy != y) and *filled[sy * f + sx] != 0u8 {
                  let at = ((y0 + sy) * size + x0 + sx) * 4usize;
                  sum = sum + new Vec3(f32.from(*albedo.pixels[at]), f32.from(*albedo.pixels[at + 1usize]),
                    f32.from(*albedo.pixels[at + 2usize]));
                  sumN = sumN + new Vec4(f32.from(*normals.pixels[at]), f32.from(*normals.pixels[at + 1usize]),
                    f32.from(*normals.pixels[at + 2usize]), f32.from(*normals.pixels[at + 3usize]));
                  count = count + 1u32;
                }
                n = n + 1usize;
              }
              if count > 0u32 {
                let inv = 1. / f32.from(count);
                let at = ((y0 + y) * size + x0 + x) * 4usize;
                albedo.pixels.set(at, u8.from(sum.x * inv + 0.5));
                albedo.pixels.set(at + 1usize, u8.from(sum.y * inv + 0.5));
                albedo.pixels.set(at + 2usize, u8.from(sum.z * inv + 0.5));
                normals.pixels.set(at, u8.from(sumN.x * inv + 0.5));
                normals.pixels.set(at + 1usize, u8.from(sumN.y * inv + 0.5));
                normals.pixels.set(at + 2usize, u8.from(sumN.z * inv + 0.5));
                normals.pixels.set(at + 3usize, u8.from(sumN.w * inv + 0.5));
                next.set(y * f + x, 1u8);
              }
            }
            x = x + 1usize;
          }
          y = y + 1usize;
        }
        filled.clear();
        k = 0usize;
        while k < f * f {
          filled.push(*next[k]);
          k = k + 1usize;
        }
        step = step + 1u32;
      }
      ci = ci + 1u32;
    }
    cj = cj + 1u32;
  }
}

