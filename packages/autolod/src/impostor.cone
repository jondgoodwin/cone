// ======== The impostor in the renderer: its pipeline, card and material ========
//
// A baked atlas (bake.cone) is made drawable in a Renderer by three things:
//
// - 'makeImpostorPipeline': ONE custom pipeline for a renderer (impostor.slang:
//   the card's vertex stage, the three-frame blend with depth-corrected
//   reprojection, the dithered cross-fade, the sun's shadows and the sky's
//   irradiance) and the CARD, a quad mesh of corners (+-1, +-1) that the vertex
//   stage turns to face the camera. Every impostor of the renderer shares both.
// - 'makeImpostor': the atlases as textures (colour with its coverage kept
//   through the mips, mips.cone's MIP_CUTOUT; normals and depth as numbers) and a
//   custom MATERIAL holding the object's centre, radius, grid and light settings.
//   One per object type; every copy of the object shares it, its model matrix
//   (position, turn about y, scale) carried by the instance.
// - the LodChain: 'LodChain.addWithMaterial(card, material, 0.)' makes it the
//   last level, which the scene's visibility system chooses by projected size,
//   cross-fades into and out of, and batches like any other level.
//
// The material's parameters (impostor.slang's ImpostorParams, 64 bytes): the
// centre and framed radius, then the grid, the frame size, the hemisphere flag and
// the coverage cut-off, then the light flag and the mip bias.

pub struct ImpostorPipeline {
  pub pipeline PipelineHandle;
  pub card MeshHandle;

  pub fn isValid(self &, renderer &Renderer) bool { renderer.hasPipeline(pipeline) }
}

pub fn makeImpostorPipeline(renderer &mut Renderer, device &mut Device) ImpostorPipeline {
  let sampleTypes = [TEXTURE_SAMPLE_TYPE_FLOAT, TEXTURE_SAMPLE_TYPE_FLOAT];
  let desc = new CustomPipeline(spirv: &IMPOSTOR_SPIRV, textures: &sampleTypes, streams: 1u32, paramBytes: 64u64,
    environment: true, cullMode: CULL_MODE_NONE);
  let pipeline = renderer.addPipeline(device, &desc);
  var card = Mesh.empty();
  card.positions.push(new Vec3(-1., -1., 0.));
  card.positions.push(new Vec3(1., -1., 0.));
  card.positions.push(new Vec3(1., 1., 0.));
  card.positions.push(new Vec3(-1., 1., 0.));
  card.normals.push(new Vec3(0., 0., 1.));
  card.normals.push(new Vec3(0., 0., 1.));
  card.normals.push(new Vec3(0., 0., 1.));
  card.normals.push(new Vec3(0., 0., 1.));
  card.uvs.push(new Vec2(0., 0.));
  card.uvs.push(new Vec2(1., 0.));
  card.uvs.push(new Vec2(1., 1.));
  card.uvs.push(new Vec2(0., 1.));
  card.indices.push(0u32); card.indices.push(1u32); card.indices.push(2u32);
  card.indices.push(0u32); card.indices.push(2u32); card.indices.push(3u32);
  new ImpostorPipeline(pipeline, renderer.addMesh(device, &card))
}

// An impostor in a renderer: the material to draw it with (the card is the pipeline's)
pub struct Impostor {
  pub material MaterialHandle;
  pub card MeshHandle;
  pub albedo TextureHandle;
  pub normals TextureHandle;
  pub grid u32;
  pub frameSize u32;
  pub hemisphere bool;
  pub center Vec3;
  pub radius f32;             // the framed radius
  pub textureBytes u64;       // GPU memory the two atlases take, mips included
  pub hashed bool;            // its card keeps a pixel with the probability of its coverage (else cuts at the cut-off)
  pub porosity f32;           // the bake's: the share of covered texels on an edge
}

pub fn makeImpostor(renderer &mut Renderer, device &mut Device, pipe &ImpostorPipeline, atlas &ImpostorAtlas,
    s &ImpostorSettings) Impostor {
  let hashed = s.alphaMode == IMPOSTOR_ALPHA_HASHED or (s.alphaMode == IMPOSTOR_ALPHA_AUTO and atlas.porosity >= s.hashPorosity);
  // Hashed alpha wants the mean alpha of each mip level (the colour texture's plain mips); a cut at the
  // cut-off wants it raised until as many texels pass as passed at level 0 (mips.cone's MIP_CUTOUT)
  let albedo = if hashed { renderer.addTexture(device, &atlas.albedo) }
    else { renderer.addCutoutTexture(device, &atlas.albedo, s.alphaCutoff) };
  let normals = renderer.addLinearTexture(device, &atlas.normals);
  let params = [atlas.center.x, atlas.center.y, atlas.center.z, atlas.radius,
    f32.from(atlas.grid), f32.from(atlas.frameSize), if atlas.hemisphere { 1. } else { 0. }, s.alphaCutoff,
    if s.environmentLight { 1. } else { 0. }, s.mipBias, if hashed { 1. } else { 0. }, 0.,
    0., 0., 0., 0.];
  let maps = [albedo, normals];
  let material = renderer.addCustomMaterial(device, pipe.pipeline, &params, &maps);
  let side = u64.from(atlas.grid) * u64.from(atlas.frameSize);
  new Impostor(material, pipe.card, albedo, normals, atlas.grid, atlas.frameSize, atlas.hemisphere, atlas.center, atlas.radius,
    side * side * 4u64 * 2u64 * 4u64 / 3u64, hashed, atlas.porosity)
}

