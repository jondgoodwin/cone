// The levels of detail's numbers (lodmath.cone), checked against values worked
// out by hand, and the rule the ranges must obey so that borders between
// levels meet.
//
// By hand, with cell 1 m, nodes of 32 cells, a slope bound of 0 (so a node's
// box diagonal is its side times the square root of 2) and k = 1000 (a cell
// of c metres is held to its screen size at 1000 c metres):
//   R_0 = 1000, S_0 = 0.6 R_0 = 600;
//   level 1: s = 64, diag = 90.51, so the ranges' rule asks for S_1 >= 1000 + 90.51
//   = 1090.51 and R_1 >= 1090.51 / 0.9 = 1211.7; but doubling gives 2000, so
//   R_1 = 2000, S_1 = max(1200, 1090.51) = 1200;
//   and so on doubling: R_l = 1000 x 2^l, S_l = 0.6 R_l;
//   the horizon of 40 000 m is reached when R_l >= 40 000: l = 6 (64 000),
//   so 7 levels.
// With a slope bound of 4, cell 1, k = 200:
//   R_0 = 200, S_0 = 120; level 1: s = 64, rise = 4 x 64 x 1.4142135 + 2 x 4 x 2
//   = 378.0 (361.9 + 16), diag = sqrt(2 x 4096 + 378.0^2) = 388.6; need =
//   200 + 388.6 = 588.6; doubling gives 400, and 0.9 x 400 = 360 < 588.6, so
//   R_1 = 588.6 / 0.9 = 654.0 and S_1 = max(0.6 x 654, 588.6) = 588.6.
// The screen factor of a 1080-pixel view of 60 degrees held to 4 pixels:
//   1080 / (2 tan 30 degrees x 4) = 233.8.
// Node keys: distinct for distinct (level, ix, iz), negative ones included.

mod levels;

import testing use *;
import stdio use *;
import libc;
import collections use *;
import geomath use *;
import terrainlod use *;

fn near(got f32, want f64, within f64, label &Array[u8]) { expectFloat(f64.from(got), want, within, label); }

fn main() i32 {
  mut cfg = TerrainConfig.make();
  cfg.cell = 1.;
  cfg.nodeCells = 32u32;
  cfg.horizon = 40000.;
  cfg.maxSlope = 0.;
  cfg.morphFraction = 0.6;
  imm flat = LodLevels.build(&cfg, 1000.);
  expectInt(i64.from(flat.count), 7i64, "flat: 7 levels reach 40 km");
  mut l = 0u32;
  while l < flat.count {
    imm r = 1000d * libc.pow(2d, f64.from(l));
    near(flat.endAt(l), r, 0.01d, "flat: R_l = 1000 x 2^l");
    near(flat.startAt(l), 0.6d * r, 0.01d, "flat: S_l = 0.6 R_l");
    near(flat.cellAt(l), libc.pow(2d, f64.from(l)), 0.000001d, "flat: c_l");
    near(flat.sizeAt(l), 32d * libc.pow(2d, f64.from(l)), 0.000001d, "flat: s_l = 32 c_l");
    l = l + 1u32;
  }
  near(flat.endAt(5u32), 32000d, 0.01d, "flat: R_5 below the horizon");
  expectBool(flat.endAt(6u32) >= 40000., true, "flat: R_6 reaches the horizon");

  // The morph factor: 0 below the band, 1 above, linear across
  near(flat.morphFactor(0u32, 500.), 0d, 0.0000001d, "morph below the band");
  near(flat.morphFactor(0u32, 600.), 0d, 0.0000001d, "morph at the start");
  near(flat.morphFactor(0u32, 800.), 0.5d, 0.000001d, "morph halfway (700 to 1000 is 600 to 1000: 800 is 0.5)");
  near(flat.morphFactor(0u32, 1000.), 1d, 0.0000001d, "morph at the end");
  near(flat.morphFactor(0u32, 5000.), 1d, 0.0000001d, "morph past it");

  mut steep = TerrainConfig.make();
  steep.cell = 1.;
  steep.maxSlope = 4.;
  steep.horizon = 40000.;
  imm s = LodLevels.build(&steep, 200.);
  near(s.endAt(0u32), 200d, 0.001d, "steep: R_0");
  near(s.startAt(0u32), 120d, 0.001d, "steep: S_0");
  near(s.startAt(1u32), 588.6d, 0.5d, "steep: S_1 = R_0 + diag_1");
  near(s.endAt(1u32), 654d, 0.6d, "steep: R_1 = S_1 / 0.9");

  // The rule itself, for every level of both: the next level's morph starts
  // beyond this level's end by a node's diagonal; a band has a width; ranges
  // grow at least by doubling
  mut c = 0;
  while c < 2 {
    imm lv = if c == 0 { &flat; } else { &s; };
    imm slope = if c == 0 { 0.; } else { 4.; };
    mut i = 1u32;
    while i < lv.count {
      imm size = lv.sizeAt(i);
      imm rise = slope * size * 1.4142135 + 2. * slope * lv.cellAt(i);
      imm diag = (2. * size * size + rise * rise).sqrt();
      expectBool(lv.startAt(i) >= lv.endAt(i - 1u32) + diag - 0.01, true, "S_l >= R_(l-1) + diag_l");
      expectBool(lv.startAt(i) < lv.endAt(i), true, "S_l < R_l");
      expectBool(lv.endAt(i) >= 2. * lv.endAt(i - 1u32) - 0.01, true, "R_l >= 2 R_(l-1)");
      i = i + 1u32;
    }
    c = c + 1;
  }

  near(screenFactor(1080., radians(60.), 4.), 233.826d, 0.01d, "screen factor of 1080 px, 60 degrees, 4 px");
  near(screenFactor(540., radians(60.), 4.), 116.913d, 0.01d, "half the pixels, half the factor");

  // Keys
  imm a = nodeKey(0u32, 0i32, 0i32);
  expectBool(a != nodeKey(1u32, 0i32, 0i32), true, "keys: level");
  expectBool(a != nodeKey(0u32, 1i32, 0i32), true, "keys: ix");
  expectBool(a != nodeKey(0u32, 0i32, 1i32), true, "keys: iz");
  expectBool(nodeKey(0u32, -1i32, 0i32) != nodeKey(0u32, 0i32, -1i32), true, "keys: negative ix against negative iz");
  expectBool(nodeKey(0u32, -1i32, 5i32) != nodeKey(0u32, 5i32, -1i32), true, "keys: swapped");
  expectBool(nodeKey(3u32, -7i32, 9i32) == nodeKey(3u32, -7i32, 9i32), true, "keys: equal for equal");

  // Config
  expectInt(i64.from(cfg.patchSide()), 37i64, "a node of 32 cells has a patch 32 + 1 + 2 x 2 = 37 samples a side");
  done();
}
