// The terrain drawn on a real GPU with no window, into a 640 x 360
// rgba16float frame that is read back as the floats the shader wrote, over
// a ground of sines (slope under 1.3, heights within 130 m) seen by six
// cameras (on the ground, in the air, looking down, over a ridge). With
// validation and synchronization validation on where the Vulkan SDK is
// installed; they must say nothing.
//
// 1. Levels: the draws use at least four levels, and the frame is one
//    instanced draw of every node (the atlas is one material).
// 2. No cracks: with the background magenta (1, 0, 1) and the shader's
//    height mode, a ray that passes under the top of the ground in a column
//    must hit it, so no background lies below the topmost ground pixel of a
//    column except through a hole in the surface. None may.
// 3. The picture is the function: the shader's height mode writes each
//    pixel's world height and its distance from the eye. For 2000 pixels in
//    each view, the camera's ray is cast against the function itself
//    (queries.cone's raycast, on the finest surface); where it hits, the
//    drawn height must equal the function's there to within the error a level
//    allows (0.1 m + 0.003 of the distance, a few times the real error of
//    these gentle slopes), and the drawn distance the ray's own to 0.3 %.
//    The median error is reported; the test requires 99 % of the pixels to
//    be inside the tolerance (the rest are on silhouettes, where a pixel
//    straddles two surfaces).
// 4. The look: with one layer (0.2, 0.4, 0.1), no haze, no bump, no shadows
//    and exposure 1, a pixel on the ground close below the eye is
//    albedo x (ambient (0.65 + 0.35 ny) + sun / pi x max(n.l, 0)); the
//    sun's colour 3 and the ambient 0.3 here; 3 % of the value is allowed for the
//    vertex normal's difference from the triangle's. With a second layer
//    above 40 m, the pixels looking at ground above and below the line show
//    its colour and the first's.
// 5. The atlas: the same camera a second time puts no patch on the GPU, a
//    move puts a few.
//
// GPU_POWER_PREFERENCE=low-power tests the integrated GPU where there are
// two.

mod gpudraw;

import testing use *;
import stdio use *;
import libc;
import sdl;
import collections use *;
import geomath use *;
import gpu use *;
import render use *;
import terrainlod use *;

const W = 640u32;
const H = 360u32;

fn near(got f32, want f64, within f64, label &Array[u8]) { expectFloat(f64.from(got), want, within, label); }

fn ground(x f32, z f32) f32 {
  60. * libc.sinf(x * 0.004) * libc.cosf(z * 0.005) + 25. * libc.sinf(x * 0.013 + z * 0.011) + 8. * libc.sinf(x * 0.05) * libc.sinf(z * 0.04)
}

fn halfToFloat(h u32) f32 {
  let sign = if ((h >> 15u32) & 1u32) != 0u32 { -1. } else { 1. };
  let e = i32.from((h >> 10u32) & 31u32);
  let m = f32.from(h & 1023u32);
  if e == 0 { return sign * m * 5.9604645e-8; }
  if e == 31 { return sign * 65504.; }
  sign * (1. + m / 1024.) * libc.powf(2., f32.from(e - 15))
}

fn camera(eye Vec3, target Vec3) Camera {
  var c = Camera.make();
  c.fov = radians(60.);
  c.near = 0.3;
  c.far = 20000.;
  c.lookAt(eye, target, new Vec3(0., 1., 0.));
  c.background = new Color(1., 0., 1., 1.);
  c
}

fn rnd(seed &mut u32) f32 {
  *seed = *seed * 1664525u32 + 1013904223u32;
  f32.from((*seed >> 8u32) & 65535u32) / 65536.
}

// Draw one frame of 'terrain' from 'camera' into 'hdr', read it into 'buffer'
fn shoot(device &mut Device, renderer &mut Renderer, terrain &mut Terrain, hdr &Texture, depth &Texture, camera &Camera,
    light &Light, list &mut DrawList, buffer &Buffer) {
  terrain.update(device, renderer, camera, W, H, &ground);
  list.clear();
  terrain.draw(list);
  var encoder = device.createCommandEncoder();
  renderer.render(device, &mut encoder, hdr, depth, camera, light, list);
  encoder.copyTextureToBuffer(hdr, buffer);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
}

fn pixel(buffer &Buffer, x u32, y u32, channel usize) f32 {
  let px = buffer.mappedRange() as *u16;
  halfToFloat(u32.from(*(px + usize.from((y * W + x) * 4u32) + channel)))
}

fn isBackground(buffer &Buffer, x u32, y u32) bool {
  // Exactly the background (1, 0, 1): the height mode's red is a hundred or more, and its blue a distance
  libc.fabsf(pixel(buffer, x, y, 0usize) - 1.) < 0.001 and pixel(buffer, x, y, 1usize) < 0.001 and libc.fabsf(pixel(buffer, x, y, 2usize) - 1.) < 0.001
}

fn main() i32 {
  var instance = Instance.create("terrainlod render test");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() {
    print <- "No GPU\n";
    return 1i32;
  }
  if libc.getenv("TERRAINLOD_REPORT") as usize != 0usize { print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n"; }
  var device = adapter.requestDevice();
  let hdrDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var hdr = device.createTexture(&hdrDesc);
  let depthDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var buffer = device.createBuffer(u64.from(W) * u64.from(H) * 8u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  if !renderer.isValid() {
    print <- "The renderer could not be made\n";
    return 1i32;
  }
  let light = Light.directional(new Vec3(0., -0.8, -0.6).normalize(), new Color(3., 3., 3., 1.), new Color(0.3, 0.3, 0.3, 1.));

  var cfg = TerrainConfig.make();
  cfg.cell = 1.;
  cfg.horizon = 12000.;
  cfg.maxSlope = 1.3;
  cfg.minHeight = -150.;
  cfg.maxHeight = 150.;
  var terrain = Terrain.create(&mut device, &mut renderer, cfg);
  expectBool(terrain.isValid(&renderer), true, "the terrain's pipeline was made");
  var look = TerrainLook.make();
  look.debug = 1u32;
  terrain.setLook(look);
  var list = DrawList.empty();

  var cams = List[Camera].empty();
  cams.push(camera(new Vec3(100., ground(100., 200.) + 2., 200.), new Vec3(1000., 0., 700.)));
  cams.push(camera(new Vec3(-300., ground(-300., 40.) + 2., 40.), new Vec3(-1000., 50., -400.)));
  cams.push(camera(new Vec3(500., 400., -600.), new Vec3(900., 0., 100.)));
  cams.push(camera(new Vec3(0., 1500., 0.), new Vec3(300., 0., 900.)));
  cams.push(camera(new Vec3(1234., ground(1234., -3000.) + 10., -3000.), new Vec3(4000., 80., -2000.)));
  cams.push(camera(new Vec3(-2048., ground(-2048., 2048.) + 30., 2048.), new Vec3(-1000., 200., 1500.)));

  var seed = 7u32;
  var maxLevelsUsed = 0;
  var cracks = 0;
  var compared = 0;
  var inside = 0;
  var distOutside = 0;
  var errors = List[f32].empty();
  var c = 0usize;
  while c < cams.len() {
    let cam = *cams[c];
    shoot(&mut device, &mut renderer, &mut terrain, &hdr, &depth, &cam, &light, &mut list, &buffer);
    // 1. The levels used, and one draw
    var used = 0;
    var l = 0usize;
    while l < 16usize { if terrain.stats.byLevel[l] > 0u32 { used = used + 1; } l = l + 1usize; }
    if used > maxLevelsUsed { maxLevelsUsed = used; }
    expectInt(i64.from(renderer.drawCalls), 1i64, "one instanced draw for every node");
    expectInt(i64.from(renderer.instancesDrawn), i64.from(terrain.stats.drawn), "of as many instances as nodes");
    // 2. No background under the top of the ground in a column
    var x = 0u32;
    while x < W {
      var seenGround = false;
      var y = H;
      while y > 0u32 {
        y = y - 1u32;
        if !isBackground(&buffer, x, y) { seenGround = true; }
        elif seenGround {
          var above = false;
          var yy = y;
          while yy > 0u32 and !above { yy = yy - 1u32; if !isBackground(&buffer, x, yy) { above = true; } }
          if above { cracks = cracks + 1; }
        }
      }
      x = x + 1u32;
    }
    // 3. The picture is the function
    let eye = cam.position();
    let vpInv = (cam.projectionMatrix(f32.from(W) / f32.from(H)) * cam.viewMatrix()).inverse();
    var s = 0;
    while s < 2000 {
      let px = u32.from(rnd(&mut seed) * f32.from(W - 1u32));
      let py = u32.from(rnd(&mut seed) * f32.from(H - 1u32));
      if !isBackground(&buffer, px, py) {
        let ndcX = (f32.from(px) + 0.5) / f32.from(W) * 2. - 1.;
        let ndcY = 1. - (f32.from(py) + 0.5) / f32.from(H) * 2.;
        let far = vpInv * new Vec4(ndcX, ndcY, 1., 1.);
        let farPoint = new Vec3(far.x / far.w, far.y / far.w, far.z / far.w);
        let dir = (farPoint - eye).normalize();
        let hit = raycast(&ground, 1., 1.3, eye, dir, 14000.);
        if hit.hit {
          compared = compared + 1;
          let drawnH = (pixel(&buffer, px, py, 0usize) + pixel(&buffer, px, py, 1usize)) * 4. - 1000.;
          let drawnD = pixel(&buffer, px, py, 2usize);
          let err = libc.fabsf(drawnH - hit.point.y);
          errors.push(err);
          if err <= 0.1 + 0.003 * hit.distance { inside = inside + 1; }
          // The drawn point itself (the ray at the drawn distance) lies on the function
          let drawnPoint = eye + dir * drawnD;
          if libc.fabsf(drawnPoint.y - ground(drawnPoint.x, drawnPoint.z)) > 0.1 + 0.003 * drawnD { distOutside = distOutside + 1; }
        }
      }
      s = s + 1;
    }
    c = c + 1usize;
  }
  expectBool(maxLevelsUsed >= 4, true, "at least four levels drawn in a view");
  expectInt(i64.from(cracks), 0i64, "no background below the top of the ground in any column, six views");
  expectBool(compared > 5000, true, "thousands of pixels compared with the function");
  expectBool(inside * 100 >= compared * 99, true, "99 % of the pixels' heights are the function's within the tolerance");
  expectBool(distOutside * 100 <= compared, true, "99 % of the pixels' drawn points (the ray at the drawn distance) lie on the function within the tolerance");
  // The median error, printed on request
  var sorted = List[f32].empty();
  var i = 0usize;
  while i < errors.len() { sorted.push(*errors[i]); i = i + 1usize; }
  i = 1usize;
  while i < sorted.len() {
    let v = *sorted[i];
    var j = i;
    while j > 0usize and *sorted[j - 1usize] > v { sorted.set(j, *sorted[j - 1usize]); j = j - 1usize; }
    sorted.set(j, v);
    i = i + 1usize;
  }
  if libc.getenv("TERRAINLOD_REPORT") as usize != 0usize {
    print <- "pixels compared "; print <- compared; print <- ", inside the tolerance "; print <- inside; print <- ", distances outside "; print <- distOutside;
    print <- ", median height error "; print <- *sorted[sorted.len() / 2usize]; print <- " m, 99th "; print <- *sorted[sorted.len() * 99usize / 100usize];
    print <- " m, worst "; print <- *sorted[sorted.len() - 1usize]; print <- " m\n";
  }

  // 5. The atlas: the same view again uploads nothing, a move uploads a few
  let camA = *cams[0];
  shoot(&mut device, &mut renderer, &mut terrain, &hdr, &depth, &camA, &light, &mut list, &buffer);
  shoot(&mut device, &mut renderer, &mut terrain, &hdr, &depth, &camA, &light, &mut list, &buffer);
  expectInt(i64.from(terrain.stats.uploaded), 0i64, "atlas: the same view twice uploads no patch");
  let camB = camera(new Vec3(104., ground(104., 200.) + 2., 203.), new Vec3(1004., 0., 703.));
  shoot(&mut device, &mut renderer, &mut terrain, &hdr, &depth, &camB, &light, &mut list, &buffer);
  expectBool(terrain.stats.uploaded < 40u32, true, "atlas: a move of 5 m uploads a few patches");
  expectBool(!terrain.overflow(), true, "atlas: no overflow");

  // 4. The look
  terrain.setLook(flatLook(false));
  // Looking straight down at the ground 6 m below a point of the plane
  let downEye = new Vec3(300., ground(300., 300.) + 6., 300.);
  let down = camera(downEye, new Vec3(300., ground(300., 300.), 300.01));
  shoot(&mut device, &mut renderer, &mut terrain, &hdr, &depth, &down, &light, &mut list, &buffer);
  let n = groundNormal(&ground, 1., 300., 300.);
  let lightDir = new Vec3(0., -0.8, -0.6).normalize();
  let cosine = fmaxf(n.dot(lightDir * -1.), 0.);
  let expectRed = 0.2 * (0.3 * (0.65 + 0.35 * n.y) + 3. / 3.14159265 * cosine);
  let expectGreen = 0.4 * (0.3 * (0.65 + 0.35 * n.y) + 3. / 3.14159265 * cosine);
  let gotRed = pixel(&buffer, W / 2u32, H / 2u32, 0usize);
  let gotGreen = pixel(&buffer, W / 2u32, H / 2u32, 1usize);
  near(gotRed, f64.from(expectRed), 0.03d * f64.from(expectRed) + 0.002d, "look: red of a lit pixel under the eye");
  near(gotGreen, f64.from(expectGreen), 0.03d * f64.from(expectGreen) + 0.002d, "look: green of it");
  // A second layer on ground above 40 m, hard edged: the hill's ground at the two ends of a line
  terrain.setLook(flatLook(true));
  // Find a spot above 45 m and one below 20 m on the ground, look straight down at each
  var highSpot = new Vec2(0., 0.);
  var lowSpot = new Vec2(0., 0.);
  var foundHigh = false;
  var foundLow = false;
  var gx = -400.;
  while gx < 400. {
    var gz = -400.;
    while gz < 400. {
      let gh = ground(gx, gz);
      if !foundHigh and gh > 50. { highSpot = new Vec2(gx, gz); foundHigh = true; }
      if !foundLow and gh < 15. { lowSpot = new Vec2(gx, gz); foundLow = true; }
      gz = gz + 25.;
    }
    gx = gx + 25.;
  }
  expectBool(foundHigh and foundLow, true, "look: the test ground has high and low spots");
  let hi = camera(new Vec3(highSpot.x, ground(highSpot.x, highSpot.y) + 5., highSpot.y), new Vec3(highSpot.x, ground(highSpot.x, highSpot.y), highSpot.y + 0.01));
  shoot(&mut device, &mut renderer, &mut terrain, &hdr, &depth, &hi, &light, &mut list, &buffer);
  let hiRed = pixel(&buffer, W / 2u32, H / 2u32, 0usize);
  let hiGreen = pixel(&buffer, W / 2u32, H / 2u32, 1usize);
  expectBool(libc.fabsf(hiRed - hiGreen) < 0.05 * (hiRed + hiGreen) and hiRed > 0.2, true, "look: ground above 40 m is the pale layer (red equals green)");
  let lo = camera(new Vec3(lowSpot.x, ground(lowSpot.x, lowSpot.y) + 5., lowSpot.y), new Vec3(lowSpot.x, ground(lowSpot.x, lowSpot.y), lowSpot.y + 0.01));
  shoot(&mut device, &mut renderer, &mut terrain, &hdr, &depth, &lo, &light, &mut list, &buffer);
  let loRed = pixel(&buffer, W / 2u32, H / 2u32, 0usize);
  let loGreen = pixel(&buffer, W / 2u32, H / 2u32, 1usize);
  expectBool(loGreen > 1.8 * loRed and loGreen > 0.05, true, "look: ground below it is the green layer (green twice red)");

  expectInt(i64.from(failures()), 0i64, "no Vulkan failure");
  expectInt(i64.from(validationMessages()), 0i64, "no validation message");
  terrain.release(&mut device, &mut renderer);
  done()
}

fn fmaxf(a f32, b f32) f32 { if a > b { a } else { b }; }

// A plain look: a green base layer, and over it a pale layer on ground above 40 m if 'withPale'; no haze, no bump, no shadows
fn flatLook(withPale bool) TerrainLook {
  var look = TerrainLook.make();
  var layers = List[TerrainLayer].empty();
  var base = TerrainLayer.base(new Color(0.2, 0.4, 0.1, 1.));
  base.noiseAmount = 0.;
  layers.push(base);
  if withPale {
    var pale = TerrainLayer.band(new Color(0.9, 0.9, 0.9, 1.), 40., 100000., 0.5, -1., 2., 0.05);
    pale.noiseAmount = 0.;
    layers.push(pale);
  }
  look.layers = layers;
  look.hazeDensity = 0.;
  look.bump = 0.;
  look.sunShadows = false;
  look
}
