// The quadtree walk on the CPU: which nodes are drawn for a camera, and
// whether what they draw is whole. No GPU: the terrain's own arithmetic
// (displayedHeight, leafVertex and leafSurface are the vertex shader's
// geomorph evaluated on the CPU) is what is examined.
//
// The ground is a sum of sines (slope below 1.3, declared) over a range of
// 150 m; cells of 1 m, nodes of 32 cells, 4 pixels a cell, the view 1080
// pixels high and 60 degrees.
//
// 1. Whole, for twelve cameras (on the ground, in the air, looking down,
//    level, up a slope, at a corner of a node):
//    - the leaves' squares never overlap, and any two that touch along an
//      edge are of the same level or one apart (the rule the ranges are built
//      to give);
//    - along every shared edge, each vertex of one leaf, morphed as drawn,
//      is exactly on the other leaf's drawn surface (within 1 mm): no crack
//      and no step, between equal levels, one level apart, and across a
//      coarser leaf's longer edge;
//    - every point of the ground that lies within the view and the horizon
//      is inside exactly one leaf;
//    - the drawn surface is within the bound 'lodError' of twice the leaf's
//      cell (a vertex morphed to the coarser level) of the height function;
//      and a point of the lattice of a leaf nowhere morphed is exactly the
//      function.
// 2. No pop: a camera moving 0.25 m at a time for 200 m, the drawn height at
//    twenty fixed points, between 150 m and 3 km ahead, never changes by
//    more than 0.01 m from one step to the next (the most a morph can move a
//    vertex in a step is its coarse-fine difference, at most slope x cell,
//    times the step over the band, 0.25 / (0.4 x 234) = 0.003 of that), while
//    the level of the leaf under some point changes at least three times in
//    the run, so that the run crosses real splits.
// 3. Bounded cost: the same camera with the horizon at 4, 40 and 400 km: the
//    leaves grow by a level's worth for each doubling, not with the area.
// 4. The cache: the same camera twice builds no patch the second time; a move
//    of 3 m builds a few; a cache of 900 patches holds no more than that after
//    walks 20 km apart, and does not overflow; returning builds again.
// 5. Tiles: a terrain walking over HeightTiles draws leaves whose patches hold
//    the tiles' samples.

mod selection;

import testing use *;
import stdio use *;
import libc;
import collections use *;
import geomath use *;
import render use Camera;
import terrainlod use *;

fn near(got f32, want f64, within f64, label &Array[u8]) { expectFloat(f64.from(got), want, within, label); }

fn ground(x f32, z f32) f32 {
  60. * libc.sinf(x * 0.004) * libc.cosf(z * 0.005) + 25. * libc.sinf(x * 0.013 + z * 0.011) + 8. * libc.sinf(x * 0.05) * libc.sinf(z * 0.04)
}

fn config(horizon f32) TerrainConfig {
  var cfg = TerrainConfig.make();
  cfg.cell = 1.;
  cfg.nodeCells = 32u32;
  cfg.horizon = horizon;
  cfg.maxSlope = 1.3;
  cfg.minHeight = -150.;
  cfg.maxHeight = 150.;
  cfg.cacheNodes = 6144u32;
  cfg
}

fn camera(eye Vec3, target Vec3) Camera {
  var c = Camera.make();
  c.fov = radians(60.);
  c.near = 0.5;
  c.far = 100000.;
  c.lookAt(eye, target, new Vec3(0., 1., 0.));
  c
}

fn rnd(seed &mut u32) f32 {
  *seed = *seed * 1664525u32 + 1013904223u32;
  f32.from((*seed >> 8u32) & 65535u32) / 65536.
}

fn main() i32 {
  let aspect = 1920.f / 1080.;
  var terrain = Terrain.createCpu(config(8000.));
  var cams = List[Camera].empty();
  cams.push(camera(new Vec3(100., ground(100., 200.) + 2., 200.), new Vec3(1000., 0., 700.)));
  cams.push(camera(new Vec3(-300., ground(-300., 40.) + 2., 40.), new Vec3(-1000., 50., -400.)));
  cams.push(camera(new Vec3(500., 400., -600.), new Vec3(900., 0., 100.)));
  cams.push(camera(new Vec3(0., 3000., 0.), new Vec3(300., 0., 400.)));
  cams.push(camera(new Vec3(1234., ground(1234., -3000.) + 10., -3000.), new Vec3(4000., 80., -2000.)));
  cams.push(camera(new Vec3(32., ground(32., 32.) + 1.5, 32.), new Vec3(2000., 100., 90.)));
  cams.push(camera(new Vec3(-2048., ground(-2048., 2048.) + 30., 2048.), new Vec3(-1000., 200., 1500.)));
  cams.push(camera(new Vec3(7777., 90., -4321.), new Vec3(7000., 0., -3000.)));
  cams.push(camera(new Vec3(15., 500., 15.), new Vec3(16., 0., 16.)));
  cams.push(camera(new Vec3(-5000., 120., 5000.), new Vec3(0., 100., 0.)));
  cams.push(camera(new Vec3(64.5, ground(64.5, 64.5) + 3., 64.5), new Vec3(400., 20., 300.)));
  cams.push(camera(new Vec3(3000., 1200., 3000.), new Vec3(2000., 0., 2000.)));

  var seed = 99u32;
  var totalLeaves = 0;
  var overlaps = 0;
  var levelJumps = 0;
  var touching = 0;
  var sameTouch = 0;
  var oneApart = 0;
  var worstBorder = 0.f;
  var missed = 0;
  var doubled = 0;
  var sampled = 0;
  var worstError = 0.f;
  var errorOver = 0;
  var c = 0usize;
  while c < cams.len() {
    let cam = *cams[c];
    terrain.walk(&cam, 1920u32, 1080u32, &ground);
    let eye = cam.position();
    let n = terrain.leafCount();
    totalLeaves = totalLeaves + i32.from(n);
    // ---- the leaves' squares and their neighbours ----
    var a = 0usize;
    while a < n {
      let la = terrain.leaf(a);
      let sa = terrain.sizeOfLevel(la.level);
      let ax0 = f32.from(la.ix) * sa;
      let az0 = f32.from(la.iz) * sa;
      var b = 0usize;
      while b < n {
        if a != b {
          let lb = terrain.leaf(b);
          let sb = terrain.sizeOfLevel(lb.level);
          let bx0 = f32.from(lb.ix) * sb;
          let bz0 = f32.from(lb.iz) * sb;
          let ox = fmin2(ax0 + sa, bx0 + sb) - fmax2(ax0, bx0);
          let oz = fmin2(az0 + sa, bz0 + sb) - fmax2(az0, bz0);
          if ox > 0.001 and oz > 0.001 { overlaps = overlaps + 1; }
          // Touching along an edge: overlap in one axis, none in the other
          let touchX = libc.fabsf(ax0 + sa - bx0) < 0.001 or libc.fabsf(bx0 + sb - ax0) < 0.001;
          let touchZ = libc.fabsf(az0 + sa - bz0) < 0.001 or libc.fabsf(bz0 + sb - az0) < 0.001;
          if (touchX and oz > 0.001) or (touchZ and ox > 0.001) {
            touching = touching + 1;
            let dl = i32.from(la.level) - i32.from(lb.level);
            if dl > 1i32 or dl < -1i32 { levelJumps = levelJumps + 1; }
            if dl == 0i32 { sameTouch = sameTouch + 1; }
            if dl == 1i32 or dl == -1i32 { oneApart = oneApart + 1; }
            // Each vertex of A on the shared edge, against B's drawn surface
            let cellsA = i32.from(32u32);
            var k = 0i32;
            while k <= cellsA {
              // Vertex position along each of A's four edges, the one that touches B
              var i = 0i32;
              var j = 0i32;
              var onEdge = false;
              if touchX and libc.fabsf(ax0 + sa - bx0) < 0.001 { i = cellsA; j = k; onEdge = true; }
              elif touchX { i = 0i32; j = k; onEdge = true; }
              if !onEdge and touchZ and libc.fabsf(az0 + sa - bz0) < 0.001 { i = k; j = cellsA; onEdge = true; }
              elif !onEdge and touchZ { i = k; j = 0i32; onEdge = true; }
              if onEdge {
                let ca = terrain.cellOfLevel(la.level);
                let x = f32.from(la.ix * cellsA + i) * ca;
                let z = f32.from(la.iz * cellsA + j) * ca;
                // Within B's extent along the edge (both ends included)?
                if x >= bx0 - 0.001 and x <= bx0 + sb + 0.001 and z >= bz0 - 0.001 and z <= bz0 + sb + 0.001 {
                  let mine = terrain.leafVertex(a, eye, i, j);
                  let theirs = terrain.leafSurface(b, eye, x, z);
                  let diff = libc.fabsf(mine - theirs);
                  if diff > worstBorder { worstBorder = diff; }
                }
              }
              k = k + 1i32;
            }
          }
        }
        b = b + 1usize;
      }
      a = a + 1usize;
    }
    // ---- every point in view lies in one leaf ----
    let vp = cam.projectionMatrix(aspect) * cam.viewMatrix();
    let frustum = Frustum.fromMatrix(vp);
    var s = 0;
    while s < 400 {
      let r = terrain.sizeOfLevel(terrain.lod.top()) * 0.0 + 3500. * libc.sqrtf(rnd(&mut seed));
      let ang = rnd(&mut seed) * 6.2831853;
      let x = eye.x + r * libc.cosf(ang);
      let z = eye.z + r * libc.sinf(ang);
      let p = new Vec3(x, ground(x, z), z);
      if frustum.containsPoint(p) {
        var found = false;
        let h = terrain.displayedHeight(eye, x, z, &mut found);
        sampled = sampled + 1;
        if !found { missed = missed + 1; }
        else {
          // Exactly one leaf holds it
          var holding = 0;
          var q = 0usize;
          while q < n {
            let lq = terrain.leaf(q);
            let sq = terrain.sizeOfLevel(lq.level);
            if x > f32.from(lq.ix) * sq and x < f32.from(lq.ix + 1i32) * sq and z > f32.from(lq.iz) * sq and z < f32.from(lq.iz + 1i32) * sq {
              holding = holding + 1;
            }
            q = q + 1usize;
          }
          if holding != 1 { doubled = doubled + 1; }
          // Within the bound of the function: the surface of the leaf is
          // within lodError of twice its cell
          var lvl = 0u32;
          q = 0usize;
          while q < n {
            let lq = terrain.leaf(q);
            let sq = terrain.sizeOfLevel(lq.level);
            if x >= f32.from(lq.ix) * sq and x <= f32.from(lq.ix + 1i32) * sq and z >= f32.from(lq.iz) * sq and z <= f32.from(lq.iz + 1i32) * sq {
              lvl = lq.level;
            }
            q = q + 1usize;
          }
          let bound = lodError(2. * terrain.cellOfLevel(lvl), 1.3);
          let err = libc.fabsf(h - ground(x, z));
          if err > worstError { worstError = err; }
          if err > bound { errorOver = errorOver + 1; }
        }
      }
      s = s + 1;
    }
    c = c + 1usize;
  }
  expectBool(totalLeaves > 1500, true, "twelve cameras: some thousands of leaves examined");
  expectInt(i64.from(overlaps), 0i64, "no two leaves overlap");
  expectInt(i64.from(levelJumps), 0i64, "touching leaves are at most one level apart");
  expectBool(sameTouch > 1000 and oneApart > 100, true, "both kinds of border were examined (same level and one apart)");
  expectBool(worstBorder < 0.001, true, "every border vertex is on the neighbour's drawn surface (largest gap under 1 mm)");
  expectBool(sampled > 1000, true, "points in view were sampled");
  expectInt(i64.from(missed), 0i64, "every point in view and in range is in a leaf");
  expectInt(i64.from(doubled), 0i64, "and in exactly one");
  expectInt(i64.from(errorOver), 0i64, "the drawn surface is within slope x 2 cells x sqrt 2 of the function");

  // ---- 2. No pop ----
  var pts = List[Vec2].empty();
  var pi = 0usize;
  while pi < 20usize {
    pts.push(new Vec2(150. + f32.from(pi) * 150. + rnd(&mut seed) * 50., (rnd(&mut seed) - 0.5) * 400.));
    pi = pi + 1usize;
  }
  var last = List[f32].empty();
  var lastLevel = List[i32].empty();
  pi = 0usize;
  while pi < 20usize { last.push(0.); lastLevel.push(-1i32); pi = pi + 1usize; }
  var maxJump = 0.f;
  var switches = 0;
  var compared = 0;
  var step = 0;
  // A fresh terrain with a cache big enough for the whole run
  var walker = Terrain.createCpu(config(8000.));
  while step <= 800 {
    let ex = 0. + 0.25 * f32.from(step);
    let cam = camera(new Vec3(ex, 40., 0.), new Vec3(ex + 100., 30., 0.));
    walker.walk(&cam, 1920u32, 1080u32, &ground);
    let eye = cam.position();
    pi = 0usize;
    while pi < 20usize {
      let p = *pts[pi];
      var found = false;
      let h = walker.displayedHeight(eye, p.x + ex * 0., p.y, &mut found);
      // Which level holds the point
      var lvl = -1i32;
      var q = 0usize;
      while q < walker.leafCount() {
        let lq = walker.leaf(q);
        let sq = walker.sizeOfLevel(lq.level);
        if p.x >= f32.from(lq.ix) * sq and p.x <= f32.from(lq.ix + 1i32) * sq and p.y >= f32.from(lq.iz) * sq and p.y <= f32.from(lq.iz + 1i32) * sq {
          lvl = i32.from(lq.level);
        }
        q = q + 1usize;
      }
      if found and *lastLevel[pi] >= 0i32 {
        compared = compared + 1;
        let jump = libc.fabsf(h - *last[pi]);
        if jump > maxJump { maxJump = jump; }
        if lvl != *lastLevel[pi] { switches = switches + 1; }
      }
      if found { last.set(pi, h); lastLevel.set(pi, lvl); }
      pi = pi + 1usize;
    }
    step = step + 1;
  }
  expectBool(compared > 10000, true, "no pop: thousands of steps compared");
  expectBool(switches >= 3, true, "no pop: the run crossed at least three level changes under the points");
  expectBool(maxJump < 0.01, true, "no pop: no point's drawn height changed by 1 cm between steps of 0.25 m");

  // ---- 3. Bounded cost ----
  var counts = List[i32].empty();
  var hz = 0;
  while hz < 3 {
    let horizon = if hz == 0 { 4000.f } elif hz == 1 { 40000. } else { 400000. };
    var t = Terrain.createCpu(config(horizon));
    let cam = camera(new Vec3(0., 60., 0.), new Vec3(1000., 30., 600.));
    t.walk(&cam, 1920u32, 1080u32, &ground);
    counts.push(i32.from(t.leafCount()));
    hz = hz + 1;
  }
  print <- "leaves at horizons of 4, 40 and 400 km: "; print <- *counts[0]; print <- " "; print <- *counts[1]; print <- " "; print <- *counts[2]; print <- "\n";
  expectBool(*counts[1] < *counts[0] * 2i32, true, "10 times the horizon: under twice the leaves");
  expectBool(*counts[2] < *counts[0] * 3i32, true, "100 times the horizon: under three times the leaves");

  // ---- 4. The cache ----
  var ct = Terrain.createCpu(config(8000.));
  let camA = camera(new Vec3(100., 60., 100.), new Vec3(900., 30., 500.));
  ct.walk(&camA, 1920u32, 1080u32, &ground);
  print <- "first walk built "; print <- ct.stats.builtPatches; print <- " patches, "; print <- ct.stats.heightSamples; print <- " samples, "; print <- ct.leafCount(); print <- " leaves\n";
  expectBool(ct.stats.builtPatches > 200u32, true, "cache: the first walk builds the patches it needs");
  ct.walk(&camA, 1920u32, 1080u32, &ground);
  expectInt(i64.from(ct.stats.builtPatches), 0i64, "cache: the same camera again builds none");
  let camB = camera(new Vec3(103., 60., 100.), new Vec3(903., 30., 500.));
  ct.walk(&camB, 1920u32, 1080u32, &ground);
  expectBool(ct.stats.builtPatches < 40u32, true, "cache: a move of 3 m builds a few");
  var small = config(8000.);
  small.cacheNodes = 900u32;
  var st = Terrain.createCpu(small);
  var jump = 0;
  while jump < 5 {
    let cam = camera(new Vec3(f32.from(jump) * 20000., 60., 0.), new Vec3(f32.from(jump) * 20000. + 800., 30., 500.));
    st.walk(&cam, 1920u32, 1080u32, &ground);
    expectBool(st.stats.resident <= 900u32, true, "cache: no more than 900 patches held");
    expectBool(!st.overflow(), true, "cache: no overflow");
    jump = jump + 1;
  }
  let back = camera(new Vec3(0., 60., 0.), new Vec3(800., 30., 500.));
  st.walk(&back, 1920u32, 1080u32, &ground);
  expectBool(st.stats.builtPatches > 100u32, true, "cache: returning after the cache turned over builds again");

  // ---- 5. Tiles ----
  var tiles = HeightTiles.make(-512., -512., 2., 64u32, 8u32, 8u32, 0.);
  var ti = 0u32;
  while ti < 64u32 {
    var samples = List[f32].empty();
    var jj = 0u32;
    while jj <= 64u32 {
      var ii = 0u32;
      while ii <= 64u32 {
        let wx = -512. + f32.from((ti % 8u32) * 64u32 + ii) * 2.;
        let wz = -512. + f32.from((ti / 8u32) * 64u32 + jj) * 2.;
        samples.push(ground(wx, wz));
        ii = ii + 1u32;
      }
      jj = jj + 1u32;
    }
    tiles.setTile(ti % 8u32, ti / 8u32, samples);
    ti = ti + 1u32;
  }
  var tcfg = config(2000.);
  tcfg.cell = 2.;
  var tt = Terrain.createCpu(tcfg);
  let tcam = camera(new Vec3(0., 100., 0.), new Vec3(300., 20., 300.));
  let fromTiles = fn(x f32, z f32) f32 { tiles.sample(x, z) };
  tt.walk(&tcam, 1920u32, 1080u32, &fromTiles);
  expectBool(tt.leafCount() > 20usize, true, "tiles: a terrain over tiles draws leaves");
  // The finest leaves' vertices are the tiles' samples: the leaf's own height at its vertex, and the function
  var agree = 0;
  var leaves = 0;
  var q = 0usize;
  while q < tt.leafCount() {
    let lf = tt.leaf(q);
    if lf.level == 0u32 {
      leaves = leaves + 1;
      let x = f32.from(lf.ix * 32i32 + 5i32) * 2.;
      let z = f32.from(lf.iz * 32i32 + 7i32) * 2.;
      // As drawn for an eye right over it (no morph): the stored sample itself
      let got = tt.leafVertex(q, new Vec3(x, 100., z), 5i32, 7i32);
      // Inside the tiles (-512 to 512) the stored sample; outside them, 'outside' (0)
      let inside = x >= -512. and x < 512. and z >= -512. and z < 512.;
      if libc.fabsf(got - (if inside { ground(x, z) } else { 0. })) < 0.02 { agree = agree + 1; }
    }
    q = q + 1usize;
  }
  expectBool(leaves > 3, true, "tiles: some leaves are level 0");
  expectInt(i64.from(agree), i64.from(leaves), "tiles: a vertex of each level-0 leaf is the stored sample (within 2 cm of the function they were taken from)");
  done()
}

fn fmin2(a f32, b f32) f32 { if a < b { a } else { b } }
fn fmax2(a f32, b f32) f32 { if a > b { a } else { b } }
