// cup: a surface given thickness. An open profile (the bottom out from the
// axis, the side up to the lip) is lathed into a bowl of a single surface,
// solidified into a wall 0.08 thick inside it, rounded at the lip by a rim,
// and subdivided twice by Catmull-Clark.
//
//   congo run packages/sculpt/examples/cup.cone
//
// It writes cup-cage.obj and cup-l2.obj in the current folder, triangulated
// with smooth normals, and prints each one's counts.

mod cup;

import stdio use *;
import collections use *;
import geomath use *;
import mesh use *;
import path;
import sculpt use *;

fn write(pm &PolyMesh, name &str) bool {
  imm tri = pm.triangulate(true);
  printStr(name); print <- ": "; print <- pm.vertexCount(); print <- " vertices, "; print <- pm.faceCount();
  print <- " faces, "; print <- tri.triangleCount(); print <- " triangles\n";
  writeObj(&tri, &path.Path.from(name));
}

fn main() i32 {
  imm pts Array[Vec2, 5] = [new Vec2(0., 0.), new Vec2(0.7, 0.), new Vec2(0.9, 0.15), new Vec2(1., 0.8),
    new Vec2(1.1, 1.5)];
  imm profile = Profile.fromPoints(&pts, false);
  imm bowl = lathe(&profile, new Vec3(0., 1., 0.), 2. * pi, 16u32);
  imm cage = solidify(&bowl, 0.08, -1., true, true);
  imm levels = subdivisionLevels(&cage, 2u32);
  mut ok = write(&cage, "cup-cage.obj");
  ok = ok and write(levels[2usize], "cup-l2.obj");
  if ok {0;} else {
    print <- "Could not write a file\n";
    1;
  };
}
