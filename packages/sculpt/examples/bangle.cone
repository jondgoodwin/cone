// bangle: a ring closed by a bridge. An oval section is swept three quarters
// of the way round a circle, leaving a gap; the tube's two open ends are
// joined by bridgeLoops with six cuts at smoothness 1, so the band leaves
// each end along the tube and curves round to meet the other rather than
// cutting straight across. Subdivided twice.
//
//   congo run packages/sculpt/examples/bangle.cone
//
// It writes bangle-cage.obj and bangle-l2.obj in the current folder,
// triangulated with smooth normals, and prints each one's counts.

mod bangle;

import stdio use *;
import collections use *;
import geomath use *;
import mesh use *;
import path;
import sculpt use *;

fn write(pm &PolyMesh, name &str) bool {
  imm tri = pm.triangulate(true);
  printStr(name); print <- ": "; print <- pm.vertexCount(); print <- " vertices, "; print <- pm.faceCount();
  print <- " faces, "; print <- tri.triangleCount(); print <- " triangles\n";
  writeObj(&tri, &path.Path.from(name));
}

fn main() i32 {
  // The oval: 12 points, 0.5 across the ring's plane and 0.3 through it
  mut oval = List[Vec2].empty();
  mut j = 0u32;
  while j < 12u32 {
    imm a = 2. * pi * f32.from(j) / 12.;
    oval.push(new Vec2(0.5 * cos(a), 0.3 * sin(a)));
    j = j + 1u32;
  }
  imm profile = Profile.fromPoints(oval.view(), true);
  // Three quarters of a circle of radius 3 in the plane y = 0, 18 pieces
  mut arc = List[Vec3].empty();
  mut i = 0u32;
  while i <= 18u32 {
    imm a = 1.5 * pi * f32.from(i) / 18.;
    arc.push(new Vec3(3. * cos(a), 0., -3. * sin(a)));
    i = i + 1u32;
  }
  imm path = Path.fromPoints(arc.view(), false);
  imm tube = sweep(&profile, &path, 0., 1., 1., false);
  // The first ring starts at vertex 0, the last at 18 x 12
  imm ends Array[u32, 2] = [0u32, 18u32 * 12u32];
  imm cage = bridgeLoops(&tube, &ends, 6u32, 1.);
  imm levels = subdivisionLevels(&cage, 2u32);
  mut ok = write(&cage, "bangle-cage.obj");
  ok = ok and write(levels[2usize], "bangle-l2.obj");
  if ok {0;} else {
    print <- "Could not write a file\n";
    1;
  };
}
