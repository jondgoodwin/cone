// selection: pictures of the selection tools, each operator before and after.
//
//   congo run packages/sculpt/examples/selection.cone -- --out C:/src/sculptselect-shots
//
// It writes six sheets of PNG pictures to the --out folder (which must
// exist), drawn by a small software rasteriser below (orthographic, flat
// lit, vertices coloured by a weight: grey is 0, amber 0.5, red 1; face sets
// each their own colour), and prints what each tile shows, left to right and
// top to bottom:
//
//   select-falloffs.png  the nine preset curves and a custom one, weight against distance
//   select-brush.png     dabs on a plate: three falloffs, a mask, and on a plate bent
//                        into a U, straight-line against along-the-surface distance
//   select-soft.png      proportional editing: weights and the edit, straight-line
//                        and along the surface, on a plate and on the U
//   select-mask.png      the mask: grow, shrink, smooth, sharpen, invert, by normal,
//                        by cavity (concave, convex), by sphere, box, plane and channel
//   select-facesets.png  face sets: by channel, regions, by angle, grown, shrunk, as a mask
//   select-symmetry.png  a box symmetrized each way, the mirror map, a mask mirrored

mod selection;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import imagedecode use *;
import sculpt use *;
import fs;
import path use Path as FilePath;

fn absf(a f32) f32 {if a < 0. {-a;} else {a;};}
fn clampf(v f32, lo f32, hi f32) f32 {if v < lo {lo;} elif v > hi {hi;} else {v;};}

// ======== a small rasteriser ========

struct Canvas {
  w i32;
  h i32;
  px List[u8];
  zb List[f32];

  fn make(w i32, h i32) Canvas {
    mut c = new Canvas(w, h, List[u8].withCapacity(usize.from(w * h * 4)), List[f32].withCapacity(usize.from(w * h)));
    mut i = 0;
    while i < w * h {
      c.px.push(246u8);
      c.px.push(246u8);
      c.px.push(249u8);
      c.px.push(255u8);
      c.zb.push(-1.0e30);
      i = i + 1;
    }
    c;
  }

  fn put(self &mut, x i32, y i32, z f32, col Vec3) {
    if x < 0 or y < 0 or x >= w or y >= h { return; }
    imm k = usize.from(y * w + x);
    if z <= *zb[k] { return; }
    zb.set(k, z);
    imm o = k * 4usize;
    px.set(o, byteOf(col.x));
    px.set(o + 1usize, byteOf(col.y));
    px.set(o + 2usize, byteOf(col.z));
  }

  fn save(self &, dir &String, name &str) {
    mut r = Raster.empty();
    r.width = w;
    r.height = h;
    r.depth = 8;
    r.colorSpace = ColorSpace.Srgb;
    r.pixels8.resize(usize.from(w) * usize.from(h) * 4usize, 255u8);
    mut i = 0usize;
    while i < px.len() {
      r.pixels8.set(i, *px[i]);
      i = i + 1usize;
    }
    imm png = encodePng(&r, 2);
    mut full = dir.copy();
    full.append("/");
    full.append(name);
    imm op = FilePath.from(full.view());
    fs.writeFile(&op, png.view());
    print <- "wrote "; printStr(full.view()); print <- "\n";
  }
}

fn byteOf(v f32) u8 {
  imm c = clampf(v, 0., 1.);
  u8.from(i32.from(c * 255. + 0.5));
}

struct Tile {
  x0 i32;
  y0 i32;
  w i32;
  h i32;
}

// Tile (col, row) of a sheet of tiles w x h
fn tileAt(col i32, row i32, w i32, h i32) Tile {new Tile(col * w, row * h, w, h);}

struct Cam {
  centre Vec3;
  scale f32;
  yaw f32;
  pitch f32;

  // A point to view space: x right, y up, z towards the viewer
  fn view(self &, p Vec3) Vec3 {
    imm q = p - centre;
    imm cy = libc.cosf(yaw);
    imm sy = libc.sinf(yaw);
    imm cp = libc.cosf(pitch);
    imm sp = libc.sinf(pitch);
    imm x1 = cy * q.x + sy * q.z;
    imm z1 = -sy * q.x + cy * q.z;
    new Vec3(x1, cp * q.y - sp * z1, sp * q.y + cp * z1);
  }

  // A direction to view space
  fn turn(self &, d Vec3) Vec3 {view(d + centre);}

  // View space to the tile's pixels (depth kept)
  fn screen(self &, t &Tile, v Vec3) Vec3 {
    new Vec3(f32.from(t.x0) + f32.from(t.w) * 0.5 + v.x * scale, f32.from(t.y0) + f32.from(t.h) * 0.5 - v.y * scale, v.z);
  }
}

fn mix3(a Vec3, b Vec3, t f32) Vec3 {a + (b - a) * t;}

// Grey for 0, amber for 0.5, red for 1
fn weightColor(w f32) Vec3 {
  imm x = clampf(w, 0., 1.);
  imm grey = new Vec3(0.80, 0.82, 0.86);
  imm amber = new Vec3(0.98, 0.80, 0.25);
  imm red = new Vec3(0.85, 0.12, 0.12);
  if x < 0.5 { mix3(grey, amber, x * 2.); } else { mix3(amber, red, (x - 0.5) * 2.); };
}

fn setColor(id u32) Vec3 {
  imm k = id % 10u32;
  if k == 0u32 { new Vec3(0.80, 0.82, 0.86); }
  elif k == 1u32 { new Vec3(0.90, 0.35, 0.30); }
  elif k == 2u32 { new Vec3(0.30, 0.62, 0.90); }
  elif k == 3u32 { new Vec3(0.40, 0.76, 0.40); }
  elif k == 4u32 { new Vec3(0.95, 0.75, 0.25); }
  elif k == 5u32 { new Vec3(0.68, 0.45, 0.82); }
  elif k == 6u32 { new Vec3(0.30, 0.78, 0.76); }
  elif k == 7u32 { new Vec3(0.95, 0.55, 0.70); }
  elif k == 8u32 { new Vec3(0.60, 0.60, 0.25); }
  else { new Vec3(0.55, 0.55, 0.60); };
}

fn edgeFn(a Vec3, b Vec3, px f32, py f32) f32 {(b.x - a.x) * (py - a.y) - (b.y - a.y) * (px - a.x);}

fn drawTri(c &mut Canvas, t &Tile, a Vec3, b Vec3, d Vec3, ca Vec3, cb Vec3, cd Vec3, shade f32) {
  imm area = edgeFn(a, b, d.x, d.y);
  if absf(area) < 0.000001 { return; }
  imm minx = fmaxi(i32.from(libc.floorf(fminf3(a.x, b.x, d.x))), t.x0);
  imm maxx = fmini(i32.from(libc.ceilf(fmaxf3(a.x, b.x, d.x))), t.x0 + t.w - 1);
  imm miny = fmaxi(i32.from(libc.floorf(fminf3(a.y, b.y, d.y))), t.y0);
  imm maxy = fmini(i32.from(libc.ceilf(fmaxf3(a.y, b.y, d.y))), t.y0 + t.h - 1);
  mut y = miny;
  while y <= maxy {
    mut x = minx;
    while x <= maxx {
      imm px = f32.from(x) + 0.5;
      imm py = f32.from(y) + 0.5;
      imm w0 = edgeFn(b, d, px, py) / area;
      imm w1 = edgeFn(d, a, px, py) / area;
      imm w2 = edgeFn(a, b, px, py) / area;
      if w0 >= -0.0001 and w1 >= -0.0001 and w2 >= -0.0001 {
        imm z = w0 * a.z + w1 * b.z + w2 * d.z;
        imm col = (ca * w0 + cb * w1 + cd * w2) * shade;
        c.put(x, y, z, col);
      }
      x = x + 1;
    }
    y = y + 1;
  }
}

fn fmini(a i32, b i32) i32 {if a < b {a;} else {b;};}
fn fmaxi(a i32, b i32) i32 {if a > b {a;} else {b;};}
fn fminf3(a f32, b f32, c f32) f32 {
  imm m = if a < b {a;} else {b;};
  if m < c {m;} else {c;};
}
fn fmaxf3(a f32, b f32, c f32) f32 {
  imm m = if a > b {a;} else {b;};
  if m > c {m;} else {c;};
}

// A line in pixels, depth z (or flat over everything with a large z)
fn drawLine(c &mut Canvas, t &Tile, a Vec3, b Vec3, col Vec3, bias f32) {
  imm dx = absf(b.x - a.x);
  imm dy = absf(b.y - a.y);
  imm steps = i32.from(if dx > dy {dx;} else {dy;}) + 1;
  mut i = 0;
  while i <= steps {
    imm u = f32.from(i) / f32.from(steps);
    imm x = i32.from(libc.floorf(a.x + (b.x - a.x) * u));
    imm y = i32.from(libc.floorf(a.y + (b.y - a.y) * u));
    if x >= t.x0 and x < t.x0 + t.w and y >= t.y0 and y < t.y0 + t.h {
      c.put(x, y, a.z + (b.z - a.z) * u + bias, col);
    }
    i = i + 1;
  }
}

// A mesh, vertices coloured from 'vcol' (or faces from 'fcol' when it is not empty)
fn drawMesh(c &mut Canvas, t &Tile, m &PolyMesh, cam &Cam, vcol &List[Vec3], fcol &List[Vec3], edges bool) {
  imm nv = m.positions.len();
  mut scr = List[Vec3].withCapacity(nv);
  mut v = 0usize;
  while v < nv {
    scr.push(cam.screen(t, cam.view(*m.positions[v])));
    v = v + 1usize;
  }
  mut f = 0usize;
  while f < m.faceCount() {
    imm vs = m.faceVertices(u32.from(f));
    imm n = cam.turn(m.faceNormal(u32.from(f))) - cam.turn(new Vec3(0., 0., 0.));
    imm shade = 0.35 + 0.65 * absf(n.z);
    mut k = 1usize;
    while k + 1usize < vs.len() {
      imm a = usize.from(*vs[0usize]);
      imm b = usize.from(*vs[k]);
      imm d = usize.from(*vs[k + 1usize]);
      if fcol.len() > 0usize {
        drawTri(c, t, *scr[a], *scr[b], *scr[d], *fcol[f], *fcol[f], *fcol[f], shade);
      } else {
        drawTri(c, t, *scr[a], *scr[b], *scr[d], *vcol[a], *vcol[b], *vcol[d], shade);
      }
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  if edges {
    imm ink = new Vec3(0.22, 0.22, 0.28);
    mut e = 0usize;
    while e < m.edgeCount() {
      imm a = usize.from(*m.hVertex[2usize * e]);
      imm b = usize.from(*m.hVertex[2usize * e + 1usize]);
      drawLine(c, t, *scr[a], *scr[b], ink, 0.01);
      e = e + 1usize;
    }
  }
}

fn weightColors(w &List[f32]) List[Vec3] {
  mut out = List[Vec3].withCapacity(w.len());
  mut i = 0usize;
  while i < w.len() {
    out.push(weightColor(*w[i]));
    i = i + 1usize;
  }
  out;
}

fn noFaces() List[Vec3] {List[Vec3].empty();}

fn show(c &mut Canvas, t &Tile, m &PolyMesh, cam &Cam, w &List[f32], edges bool) {
  imm vc = weightColors(w);
  drawMesh(c, t, m, cam, &vc, &noFaces(), edges);
}

fn showMask(c &mut Canvas, t &Tile, m &PolyMesh, cam &Cam, edges bool) {
  imm w = maskValues(m);
  show(c, t, m, cam, &w, edges);
}

fn showSets(c &mut Canvas, t &Tile, m &PolyMesh, cam &Cam, edges bool) {
  imm ids = faceSetIds(m);
  mut fc = List[Vec3].withCapacity(ids.len());
  mut i = 0usize;
  while i < ids.len() {
    fc.push(setColor(*ids[i]));
    i = i + 1usize;
  }
  imm vc = List[Vec3].empty();
  drawMesh(c, t, m, cam, &vc, &fc, edges);
}

// ======== the models ========

// An nx by nz plate w x d in the plane y = 0 (facing +y), with a vertex
// channel "bump" if kind is 1: a hill at the middle and a pit beside it
fn plate(nx i32, nz i32, w f32, d f32, kind u32) PolyMesh {
  mut pts = List[Vec3].empty();
  mut j = 0;
  while j <= nz {
    mut i = 0;
    while i <= nx {
      imm x = (f32.from(i) / f32.from(nx) - 0.5) * w;
      imm z = (f32.from(j) / f32.from(nz) - 0.5) * d;
      mut y = 0.;
      if kind == 1u32 {
        y = 0.8 * libc.expf(-((x + 1.2) * (x + 1.2) + z * z) / 0.8) - 0.6 * libc.expf(-((x - 1.4) * (x - 1.4) + z * z) / 0.5)
          + 0.15 * libc.sinf(x * 3.) * libc.cosf(z * 3.);
      }
      pts.push(new Vec3(x, y, z));
      i = i + 1;
    }
    j = j + 1;
  }
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  j = 0;
  while j < nz {
    mut i = 0;
    while i < nx {
      imm v00 = u32.from(j * (nx + 1) + i);
      counts.push(4u32);
      idx.push(v00);
      idx.push(v00 + u32.from(nx + 1));
      idx.push(v00 + u32.from(nx + 2));
      idx.push(v00 + 1u32);
      i = i + 1;
    }
    j = j + 1;
  }
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut problems);
}

// A sphere of radius 1, lathed, with "along" from pole to pole
fn sphere(rings i32, around u32) PolyMesh {
  mut pts = List[Vec2].empty();
  mut i = 0;
  while i <= rings {
    imm t = pi * f32.from(i) / f32.from(rings);
    pts.push(new Vec2(if i == 0 or i == rings {0.;} else {libc.sinf(t);}, -libc.cosf(t)));
    i = i + 1;
  }
  imm profile = Profile.fromPoints(pts.view(), false);
  lathe(&profile, new Vec3(0., 1., 0.), 2. * pi, around);
}

// The plate bent into a U (the arms facing each other), a hand's breadth apart
fn ubend() PolyMesh {
  imm flat = plate(36, 8, 8., 2.5, 0u32);
  bend(&flat, 3.0, new Vec3(0., 0., 1.), new Vec3(1., 0., 0.), new Vec3(-4., 0., 0.));
}

fn copyWith(m &PolyMesh, pos &List[Vec3]) PolyMesh {
  mut c = weld(m, -1.);
  mut i = 0usize;
  while i < pos.len() and i < c.positions.len() {
    c.positions.set(i, *pos[i]);
    i = i + 1usize;
  }
  c;
}

// The mesh with each vertex pushed along 'dir' by weight x amount
fn pushed(m &PolyMesh, w &List[f32], dir Vec3, amount f32) PolyMesh {
  mut pos = List[Vec3].withCapacity(m.positions.len());
  mut i = 0usize;
  while i < m.positions.len() {
    pos.push(*m.positions[i] + dir * (*w[i] * amount));
    i = i + 1usize;
  }
  copyWith(m, &pos);
}

fn nearestVertex(m &PolyMesh, p Vec3) u32 {
  mut best = 0u32;
  mut bd = SurfaceFar;
  mut i = 0usize;
  while i < m.positions.len() {
    imm d = (*m.positions[i] - p).length();
    if d < bd {
      bd = d;
      best = u32.from(i);
    }
    i = i + 1usize;
  }
  best;
}

fn one(v u32) List[u32] {
  mut l = List[u32].empty();
  l.push(v);
  l;
}

// ======== the sheets ========

fn curveTile(c &mut Canvas, t &Tile, f &Falloff) {
  imm ink = new Vec3(0.2, 0.2, 0.25);
  imm pad = 30.;
  imm px0 = f32.from(t.x0) + pad;
  imm py0 = f32.from(t.y0 + t.h) - pad;
  imm pw = f32.from(t.w) - 2. * pad;
  imm ph = f32.from(t.h) - 2. * pad;
  drawLine(c, t, new Vec3(px0, py0, 0.), new Vec3(px0 + pw, py0, 0.), ink, 100.);
  drawLine(c, t, new Vec3(px0, py0, 0.), new Vec3(px0, py0 - ph, 0.), ink, 100.);
  drawLine(c, t, new Vec3(px0 + pw * 0.8333, py0, 0.), new Vec3(px0 + pw * 0.8333, py0 - ph, 0.), new Vec3(0.75, 0.75, 0.8), 100.);
  mut prev = new Vec3(px0, py0 - ph * f.weight(0.), 0.);
  mut i = 1;
  while i <= 120 {
    imm d = f32.from(i) / 100.;
    imm cur = new Vec3(px0 + pw * d / 1.2, py0 - ph * f.weight(d), 0.);
    drawLine(c, t, prev, cur, new Vec3(0.85, 0.12, 0.12), 100.);
    prev = cur;
    i = i + 1;
  }
}

fn falloffSheet(dir &String) {
  mut c = Canvas.make(2560, 720);
  mut kinds = List[u32].empty();
  kinds.push(FalloffSmooth);
  kinds.push(FalloffSmoothSharp);
  kinds.push(FalloffRoot);
  kinds.push(FalloffSharp);
  kinds.push(FalloffLinear);
  kinds.push(FalloffSphere);
  kinds.push(FalloffConstant);
  kinds.push(FalloffGauss);
  kinds.push(FalloffPlateau);
  mut i = 0usize;
  while i < kinds.len() {
    imm t = tileAt(i32.from(i % 5usize), i32.from(i / 5usize), 512, 360);
    curveTile(&mut c, &t, &Falloff.preset(*kinds[i]));
    i = i + 1usize;
  }
  imm pts Array[Vec2, 4] = [new Vec2(0., 1.), new Vec2(0.25, 0.9), new Vec2(0.5, 0.15), new Vec2(1., 0.)];
  imm custom = Falloff.custom(&pts);
  imm t = tileAt(4, 1, 512, 360);
  curveTile(&mut c, &t, &custom);
  print <- "select-falloffs: smooth, smooth sharp, root, sharp, linear / sphere, constant, gauss, plateau, custom\n";
  c.save(dir, "select-falloffs.png");
}

fn brushSheet(dir &String) {
  mut c = Canvas.make(1920, 1080);
  imm p = plate(40, 28, 8., 5.6, 0u32);
  imm cam = new Cam(new Vec3(0., 0., 0.), 70., 0., 0.9);
  imm centre = new Vec3(0.5, 0., 0.3);
  imm kinds Array[u32, 3] = [FalloffSmooth, FalloffSharp, FalloffConstant];
  mut i = 0usize;
  while i < 3usize {
    imm t = tileAt(i32.from(i), 0, 640, 540);
    imm f = Falloff.preset(kinds[i]);
    imm w = brushWeights(&p, centre, 2., &f, "");
    show(&mut c, &t, &p, &cam, &w, false);
    i = i + 1usize;
  }
  // The same dab with half the plate masked
  imm half = maskByPlane(&p, new Vec3(0.5, 0., 0.), new Vec3(1., 0., 0.), 0.4, MaskReplace);
  imm fs = Falloff.preset(FalloffSmooth);
  imm wm = brushWeights(&half, centre, 2., &fs, "mask");
  imm t3 = tileAt(0, 1, 640, 540);
  show(&mut c, &t3, &half, &cam, &wm, false);

  // The U: straight-line against along the surface, a dab at the end of one arm
  imm u = ubend();
  imm ucam = new Cam(new Vec3(-2.7, 3.4, 0.), 60., 0.0, 0.45);
  imm at = u.positions[usize.from(nearestVertex(&u, new Vec3(-4., 0., 0.)))];
  imm straight = brushWeights(&u, *at, 6., &fs, "");
  imm t4 = tileAt(1, 1, 640, 540);
  show(&mut c, &t4, &u, &ucam, &straight, false);
  imm along = surfaceBrushWeightsAt(&u, *at, 6., &fs, "");
  imm t5 = tileAt(2, 1, 640, 540);
  show(&mut c, &t5, &u, &ucam, &along, false);
  print <- "select-brush: top: smooth, sharp, constant dabs (radius 2) / bottom: half-masked plate, U with a straight-line dab, U with the surface dab\n";
  c.save(dir, "select-brush.png");
}

fn softSheet(dir &String) {
  mut c = Canvas.make(2560, 1080);
  imm p = plate(48, 30, 9., 5.6, 0u32);
  imm cam = new Cam(new Vec3(0., 0.3, 0.), 62., 0.0, 0.8);
  mut sel = List[u32].empty();
  sel.push(nearestVertex(&p, new Vec3(-1.2, 0., 0.3)));
  sel.push(nearestVertex(&p, new Vec3(-0.6, 0., 0.3)));
  sel.push(nearestVertex(&p, new Vec3(-0.9, 0., -0.3)));
  sel.push(nearestVertex(&p, new Vec3(1.8, 0., -0.5)));
  imm f = Falloff.preset(FalloffSmooth);
  imm e = softSelect(&p, &sel, 1.6, &f, SoftEuclidean);
  imm t0 = tileAt(0, 0, 640, 540);
  show(&mut c, &t0, &p, &cam, &e, false);
  imm after = pushed(&p, &e, new Vec3(0., 1., 0.), 1.2);
  imm t1 = tileAt(1, 0, 640, 540);
  show(&mut c, &t1, &after, &cam, &e, false);
  imm sharp = Falloff.preset(FalloffSharp);
  imm e2 = softSelect(&p, &sel, 1.6, &sharp, SoftEuclidean);
  imm after2 = pushed(&p, &e2, new Vec3(0., 1., 0.), 1.2);
  imm t2 = tileAt(2, 0, 640, 540);
  show(&mut c, &t2, &after2, &cam, &e2, false);
  imm lin = Falloff.preset(FalloffLinear);
  imm e3 = softSelect(&p, &sel, 1.6, &lin, SoftEuclidean);
  imm after3 = pushed(&p, &e3, new Vec3(0., 1., 0.), 1.2);
  imm t3 = tileAt(3, 0, 640, 540);
  show(&mut c, &t3, &after3, &cam, &e3, false);

  // The U: select the end of one arm, radius reaching the other arm in a straight line
  imm u = ubend();
  imm ucam = new Cam(new Vec3(-2.7, 3.4, 0.), 60., 0.0, 0.45);
  imm seed = one(nearestVertex(&u, new Vec3(-4., 0., 0.)));
  imm es = softSelect(&u, &seed, 6., &f, SoftEuclidean);
  imm ss = softSelect(&u, &seed, 6., &f, SoftSurface);
  imm t4 = tileAt(0, 1, 640, 540);
  show(&mut c, &t4, &u, &ucam, &es, false);
  imm t5 = tileAt(1, 1, 640, 540);
  show(&mut c, &t5, &u, &ucam, &ss, false);
  imm ua = pushed(&u, &es, new Vec3(0., 0., 1.), 1.0);
  imm ub = pushed(&u, &ss, new Vec3(0., 0., 1.), 1.0);
  imm t6 = tileAt(2, 1, 640, 540);
  show(&mut c, &t6, &ua, &ucam, &es, false);
  imm t7 = tileAt(3, 1, 640, 540);
  show(&mut c, &t7, &ub, &ucam, &ss, false);
  print <- "select-soft: top: weights (smooth), moved (smooth), moved (sharp), moved (linear) / bottom: U straight-line weights, U surface weights, U moved straight-line, U moved by surface\n";
  c.save(dir, "select-soft.png");
}

fn maskSheet(dir &String) {
  mut c = Canvas.make(2560, 1440);
  imm s = sphere(24, 40u32);
  imm cam = new Cam(new Vec3(0., 0., 0.), 190., -0.85, 0.35);
  imm start = nearestVertex(&s, new Vec3(0.7, 0.3, 0.6));
  imm base = maskByVertices(&s, &one(start), MaskReplace);
  imm grown = maskGrow(&base, 4u32);
  imm t0 = tileAt(0, 0, 640, 480);
  showMask(&mut c, &t0, &grown, &cam, false);
  imm shrunk = maskShrink(&grown, 2u32);
  imm t1 = tileAt(1, 0, 640, 480);
  showMask(&mut c, &t1, &shrunk, &cam, false);
  imm smoothed = maskSmooth(&grown, 1., 4u32);
  imm t2 = tileAt(2, 0, 640, 480);
  showMask(&mut c, &t2, &smoothed, &cam, false);
  imm sharpened = maskSharpen(&smoothed, 2u32);
  imm t3 = tileAt(3, 0, 640, 480);
  showMask(&mut c, &t3, &sharpened, &cam, false);
  imm inverted = maskInvert(&grown);
  imm t4 = tileAt(0, 1, 640, 480);
  showMask(&mut c, &t4, &inverted, &cam, false);
  imm byNormal = maskByNormal(&s, new Vec3(0.6, 0.8, 0.), radians(40.), radians(25.), MaskReplace);
  imm t5 = tileAt(1, 1, 640, 480);
  showMask(&mut c, &t5, &byNormal, &cam, false);
  imm sph = maskBySphere(&s, new Vec3(0.8, 0.2, 0.6), 0.9, &Falloff.preset(FalloffSmooth), MaskReplace);
  imm t6 = tileAt(2, 1, 640, 480);
  showMask(&mut c, &t6, &sph, &cam, false);
  imm along = maskByChannel(&s, "along", 0.3, 0.55, MaskReplace);
  imm t7 = tileAt(3, 1, 640, 480);
  showMask(&mut c, &t7, &along, &cam, false);

  // Cavity on the bumpy plate
  imm p = plate(70, 44, 8., 5., 1u32);
  imm pcam = new Cam(new Vec3(0., 0., 0.), 76., 0.0, 0.9);
  imm t8 = tileAt(0, 2, 640, 480);
  showMask(&mut c, &t8, &p, &pcam, false);
  imm concave = maskByCavity(&p, 3u32, 6., CavityConcave, MaskReplace);
  imm t9 = tileAt(1, 2, 640, 480);
  showMask(&mut c, &t9, &concave, &pcam, false);
  imm convex = maskByCavity(&p, 3u32, 6., CavityConvex, MaskReplace);
  imm t10 = tileAt(2, 2, 640, 480);
  showMask(&mut c, &t10, &convex, &pcam, false);
  imm box = maskByBox(&p, new Vec3(-2., -1., -1.), new Vec3(0., 1., 1.), 0.8, MaskReplace);
  imm t11 = tileAt(3, 2, 640, 480);
  showMask(&mut c, &t11, &box, &pcam, false);
  print <- "select-mask: row 1: one vertex grown 4, then shrunk 2, then smoothed 4, then sharpened 2 / row 2: inverted, by normal, by sphere, by channel along 0.3..0.55 / row 3: plate, concave cavity, convex cavity, by box (feather 0.8)\n";
  c.save(dir, "select-mask.png");
}

fn facesetSheet(dir &String) {
  mut c = Canvas.make(2560, 960);
  imm s = sphere(12, 24u32);
  imm cam = new Cam(new Vec3(0., 0., 0.), 190., -0.7, 0.35);
  mut cuts = List[f32].empty();
  cuts.push(0.25);
  cuts.push(0.5);
  cuts.push(0.75);
  imm bands = faceSetsByChannel(&s, "along", &cuts);
  showSets(&mut c, &tileAt(0, 0, 640, 480), &bands, &cam, false);
  imm box = subdivide(&PolyMesh.cube(0.6), 2u32);
  imm bcam = new Cam(new Vec3(0., 0., 0.), 200., -0.6, 0.5);
  imm byAngle = faceSetsByAngle(&box, radians(40.), "");
  showSets(&mut c, &tileAt(1, 0, 640, 480), &byAngle, &bcam, true);
  mut parts = List[PolyMesh].empty();
  parts.push(plate(6, 4, 3., 2., 0u32));
  mut places = List[Transform3].empty();
  places.push(new Transform3(new Vec3(-1.6, 0., 0.), Quat.identity(), new Vec3(1., 1., 1.)));
  parts.push(plate(5, 4, 3., 2., 0u32));
  places.push(new Transform3(new Vec3(1.6, 0., 0.), Quat.identity(), new Vec3(1., 1., 1.)));
  mut problems = List[String].empty();
  imm two = joinPlaced(&parts, &places, &mut problems);
  imm pcam = new Cam(new Vec3(0., 0., 0.), 70., 0.0, 0.9);
  imm regions = faceSetsFromRegions(&two, "");
  showSets(&mut c, &tileAt(2, 0, 640, 480), &regions, &pcam, true);
  // Grow and shrink on a plate
  imm g = plate(14, 10, 6., 4., 0u32);
  mut some = List[u32].empty();
  mut f = 0u32;
  while f < 140u32 {
    if (f % 14u32 >= 5u32 and f % 14u32 <= 8u32) and (f / 14u32 >= 3u32 and f / 14u32 <= 6u32) { some.push(f); }
    f = f + 1u32;
  }
  imm marked = faceSetAssign(&g, &some, 2u32);
  showSets(&mut c, &tileAt(3, 0, 640, 480), &marked, &pcam, true);
  showSets(&mut c, &tileAt(0, 1, 640, 480), &faceSetGrow(&marked, 2u32, 2u32, AdjEdge), &pcam, true);
  showSets(&mut c, &tileAt(1, 1, 640, 480), &faceSetGrow(&marked, 2u32, 2u32, AdjVertex), &pcam, true);
  showSets(&mut c, &tileAt(2, 1, 640, 480), &faceSetShrink(&marked, 2u32, 1u32, AdjEdge), &pcam, true);
  imm asMask = maskByFaceSet(&marked, 2u32, false, MaskReplace);
  showMask(&mut c, &tileAt(3, 1, 640, 480), &asMask, &pcam, true);
  print <- "select-facesets: row 1: sphere by 'along' bands, rounded cube by angle (40 degrees), two plates by regions, a plate with a marked block / row 2: grown 2 by edge, grown 2 by vertex, shrunk 1 by edge, the set as a mask\n";
  c.save(dir, "select-facesets.png");
}

fn symmetrySheet(dir &String) {
  mut c = Canvas.make(2560, 960);
  mut parts = List[PolyMesh].empty();
  parts.push(PolyMesh.cube(0.5));
  mut places = List[Transform3].empty();
  places.push(new Transform3(new Vec3(0.5, 0., 0.), Quat.identity(), new Vec3(2., 1.4, 1.4)));
  mut problems = List[String].empty();
  imm lop = subdivide(&joinPlaced(&parts, &places, &mut problems), 1u32);
  imm cam = new Cam(new Vec3(0., 0., 0.), 150., -0.6, 0.5);
  imm none = List[Vec3].empty();
  imm o = new Vec3(0., 0., 0.);
  showSets(&mut c, &tileAt(0, 0, 640, 480), &lop, &cam, true);
  showSets(&mut c, &tileAt(1, 0, 640, 480), &symmetrize(&lop, o, new Vec3(1., 0., 0.), 0.001), &cam, true);
  showSets(&mut c, &tileAt(2, 0, 640, 480), &symmetrize(&lop, o, new Vec3(-1., 0., 0.), 0.001), &cam, true);
  // A mask on one side, copied across
  imm s = sphere(16, 32u32);
  imm scam = new Cam(new Vec3(0., 0., 0.), 190., -0.6, 0.3);
  imm sph = maskBySphere(&s, new Vec3(0.8, 0.3, 0.5), 0.7, &Falloff.preset(FalloffSmooth), MaskReplace);
  showMask(&mut c, &tileAt(0, 1, 640, 480), &sph, &scam, false);
  imm map = mirrorMap(&s, o, new Vec3(1., 0., 0.), 0.001);
  showMask(&mut c, &tileAt(1, 1, 640, 480), &maskMirror(&sph, o, new Vec3(1., 0., 0.), &map, MaskReplace, MirrorFromPositive), &scam, false);
  showMask(&mut c, &tileAt(2, 1, 640, 480), &maskMirror(&sph, o, new Vec3(1., 0., 0.), &map, MaskUnion, MirrorBoth), &new Cam(new Vec3(0., 0., 0.), 190., 0.6, 0.3), false);
  print <- "select-symmetry: row 1: a lopsided box (x -0.5 to 1.5) cut by x = 0, kept +x and mirrored, kept -x and mirrored / row 2: a mask on the +x side, copied to -x, made symmetric (seen from the other side)\n";
  c.save(dir, "select-symmetry.png");
}

fn main(argc i32, argv **u8) i32 {
  mut outDir = String.from("C:/src/sculptselect-shots");
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    mut isOut = true;
    mut k = 0usize;
    imm want = "--out";
    while k < want.len() {
      if *(arg + k) != want[k] { isOut = false; }
      k = k + 1usize;
    }
    if isOut and a + 1 < argc {
      outDir = String.empty();
      mut p = *(argv + usize.from(a + 1));
      while *p != 0u8 {
        outDir.appendByte(*p);
        p = p + 1usize;
      }
      a = a + 1;
    }
    a = a + 1;
  }
  falloffSheet(&outDir);
  brushSheet(&outDir);
  softSheet(&outDir);
  maskSheet(&outDir);
  facesetSheet(&outDir);
  symmetrySheet(&outDir);
  0;
}
