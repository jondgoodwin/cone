// nostril: the knight's right nostril cut away and filled, by sculpt's surgery operators, with numbers and
// raking-light pictures (a software renderer, no GPU).
//
//   congo run --release --example nostril          (from packages/sculpt; needs the files below)
//
// Input, made once by C:/src/mesh-tools-shots/prep.py (trimesh) from the Python run that was kept
// (perc/nonos-final.json): knight-noears-r4.obj (the source skin, 258,494 triangles, welded),
// nostril-faces.txt (the faces that run cut for the right nostril, 13,040), and knight-nonos.obj (the Python
// result, to measure against). Output: PNG sheets and the numbers on stdout, in C:/src/mesh-tools-shots.

mod nostril;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import imagedecode use *;
import fs;
import path use Path as FilePath;
import sculpt use *;
import time use Instant;

let dir = "C:/src/mesh-tools-shots/";

// ---------------------------------------------------------------- renderer

struct Canvas {
  w: i32;
  h: i32;
  px: List[u8];
  zb: List[f32];
  x0: i32;
  y0: i32;
  x1: i32;
  y1: i32;

  fn make(w: i32, h: i32) Canvas {
    var c = Canvas(w, h, List[u8](), List[f32](), 0, 0, w, h);
    c.px.resize(usize.from(w) * usize.from(h) * 4usize, 255u8);
    c.zb.resize(usize.from(w) * usize.from(h), -1000000.);
    c
  }

  fn tile(self: &mut, tx0: i32, ty0: i32, tx1: i32, ty1: i32, bg: Vec3) {
    x0 = tx0; y0 = ty0; x1 = tx1; y1 = ty1;
    var y = ty0;
    while y < ty1 {
      var x = tx0;
      while x < tx1 {
        self.setPixel(x, y, bg);
        zb.set(usize.from(y * w + x), -1000000.);
        x = x + 1;
      }
      y = y + 1;
    }
  }

  fn setPixel(self: &mut, x: i32, y: i32, c: Vec3) {
    let i = usize.from(y * w + x) * 4usize;
    px.set(i, byteOf(c.x));
    px.set(i + 1usize, byteOf(c.y));
    px.set(i + 2usize, byteOf(c.z));
  }

  fn plot(self: &mut, x: i32, y: i32, z: f32, c: Vec3) {
    if x >= x0 && x < x1 && y >= y0 && y < y1 {
      let i = usize.from(y * w + x);
      if z > *zb[i] {
        zb.set(i, z);
        self.setPixel(x, y, c);
      }
    }
  }

  // A triangle given in screen space, its corners' light ia, ib, ic interpolated, times 'col'
  fn triangle(self: &mut, a: Vec3, b: Vec3, c: Vec3, ia: f32, ib: f32, ic: f32, col: Vec3) {
    let minx = x0.max(i32.from(libc.floorf(fmin3(a.x, b.x, c.x))));
    let maxx = (x1 - 1).min(i32.from(libc.ceilf(fmax3(a.x, b.x, c.x))));
    let miny = y0.max(i32.from(libc.floorf(fmin3(a.y, b.y, c.y))));
    let maxy = (y1 - 1).min(i32.from(libc.ceilf(fmax3(a.y, b.y, c.y))));
    let den = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
    if den > -0.0000001 && den < 0.0000001 { return; }
    var y = miny;
    while y <= maxy {
      var x = minx;
      while x <= maxx {
        let px_ = f32.from(x) + 0.5;
        let py_ = f32.from(y) + 0.5;
        let l0 = ((b.y - c.y) * (px_ - c.x) + (c.x - b.x) * (py_ - c.y)) / den;
        let l1 = ((c.y - a.y) * (px_ - c.x) + (a.x - c.x) * (py_ - c.y)) / den;
        let l2 = 1. - l0 - l1;
        if l0 >= -0.0001 && l1 >= -0.0001 && l2 >= -0.0001 {
          let li = l0 * ia + l1 * ib + l2 * ic;
          self.plot(x, y, l0 * a.z + l1 * b.z + l2 * c.z, col * li);
        }
        x = x + 1;
      }
      y = y + 1;
    }
  }

  fn line(self: &mut, a: Vec3, b: Vec3, col: Vec3, bias: f32, thick: i32) {
    let dx = b.x - a.x;
    let dy = b.y - a.y;
    let steps = i32.from(fmax3(dx.abs(), dy.abs(), 1.)) + 1;
    var i = 0;
    while i <= steps {
      let t = f32.from(i) / f32.from(steps);
      let x = a.x + dx * t;
      let y = a.y + dy * t;
      let z = a.z + (b.z - a.z) * t + bias;
      var ox = 0;
      while ox < thick {
        var oy = 0;
        while oy < thick {
          self.plot(i32.from(x) + ox, i32.from(y) + oy, z, col);
          oy = oy + 1;
        }
        ox = ox + 1;
      }
      i = i + 1;
    }
  }
}

fn fmin3(a: f32, b: f32, c: f32) f32 { let m = if a < b {a} else {b}; if m < c {m} else {c} }
fn fmax3(a: f32, b: f32, c: f32) f32 { let m = if a > b {a} else {b}; if m > c {m} else {c} }

fn byteOf(v: f32) u8 {
  var x = i32.from(v * 255. + 0.5);
  if x < 0 { x = 0; }
  if x > 255 { x = 255; }
  u8.from(x)
}

// An orthographic camera: u right, v up, w towards the viewer, round 'c', 'sc' pixels per unit, the
// tile's middle at (ox, oy)
struct Cam {
  u: Vec3;
  v: Vec3;
  w: Vec3;
  c: Vec3;
  sc: f32;
  ox: f32;
  oy: f32;

  fn make(w: Vec3, upHint: Vec3, c: Vec3, sc: f32, ox: f32, oy: f32) Cam {
    let ww = w.normalize();
    let u = upHint.cross(ww).normalize();
    let v = ww.cross(u);
    Cam(u, v, ww, c, sc, ox, oy)
  }

  fn scr(self: &, p: Vec3) Vec3 {
    let q = p - c;
    Vec3(ox + q.dot(u) * sc, oy - q.dot(v) * sc, q.dot(w) * sc)
  }
}

// The faces of pm with a vertex inside 'radius' of 'centre', Gouraud-shaded by the light 'lit' (a unit vector
// towards the light), a smooth skin; the faces from 'tintFrom' on are tinted blue by 'tint' and, with 'wire',
// outlined
fn drawMesh(cv: &mut Canvas, pm: &PolyMesh, cam: &Cam, lit: Vec3, centre: Vec3, radius: f32, tintFrom: usize,
    tint: f32, wire: bool, backRed: bool) {
  let nrm = pm.vertexNormals();
  var sp = List[Vec3]();
  var v = 0usize;
  while v < pm.positions.len() {
    sp.push(cam.scr(*pm.positions[v]));
    v = v + 1usize;
  }
  var f = 0usize;
  while f < pm.faceCount() {
    let vs = pm.faceVertices(u32.from(f));
    var near = false;
    var k = 0usize;
    while k < vs.len() {
      if (*pm.positions[usize.from(*vs[k])] - centre).length() < radius { near = true; }
      k = k + 1usize;
    }
    if near {
      let isPatch = f >= tintFrom;
      var base = if isPatch { Vec3(0.80 - 0.5 * tint, 0.80 - 0.3 * tint, 0.82) } else { Vec3(0.82, 0.80, 0.78) };
      // one-sided shading: a face turned away from the viewer is drawn red, never lit
      if backRed && pm.faceNormal(u32.from(f)).dot(cam.w) <= 0. { base = Vec3(0.95, 0.1, 0.1); }
      k = 1usize;
      while k + 1usize < vs.len() {
        let a = usize.from(*vs[0usize]);
        let b = usize.from(*vs[k]);
        let c = usize.from(*vs[k + 1usize]);
        cv.triangle(*sp[a], *sp[b], *sp[c], shade(*nrm[a], lit), shade(*nrm[b], lit), shade(*nrm[c], lit), base);
        k = k + 1usize;
      }
    }
    f = f + 1usize;
  }
  if wire {
    f = tintFrom;
    while f < pm.faceCount() {
      let vs = pm.faceVertices(u32.from(f));
      var k = 0usize;
      while k < vs.len() {
        cv.line(*sp[usize.from(*vs[k])], *sp[usize.from(*vs[(k + 1usize) % vs.len()])], Vec3(0.1, 0.2, 0.7), 0.002 * cam.sc, 1);
        k = k + 1usize;
      }
      f = f + 1usize;
    }
  }
}

fn shade(n: Vec3, lit: Vec3) f32 {
  let d = n.dot(lit);
  0.10 + 0.90 * (if d > 0. {d} else {0.})
}

fn save(cv: &Canvas, name: &str) {
  var r = Raster();
  r.width = cv.w;
  r.height = cv.h;
  r.depth = 8;
  r.colorSpace = ColorSpace.Srgb;
  var i = 0usize;
  while i < cv.px.len() { r.pixels8.push(*cv.px[i]); i = i + 1usize; }
  let png = encodePng(&r, 6);
  var full = String.from(dir);
  full.append(name);
  let op = FilePath.from(full.view());
  if let Err(e) = fs.writeFile(&op, png.view()) { print <- "could not write ", full.view(), ": ", e, "\n"; return; }
  print <- "wrote ", full.view(), " (", png.len(), " bytes)\n";
}

// ---------------------------------------------------------------- input

fn loadObj(name: &str) PolyMesh {
  var full = String.from(dir);
  full.append(name);
  var problems = List[String]();
  let m = readPolyObj(&FilePath.from(full.view()), &mut problems);
  if problems.len() > 0usize { print <- "problems reading ", name, ": ", problems.len(), " first: ", problems[0usize].view(), "\n"; }
  m
}

fn loadFaces(name: &str) List[u32] {
  var full = String.from(dir);
  full.append(name);
  var text = String();
  let fp = FilePath.from(full.view());
  match fs.readFile(&fp) {
    case var Ok(r) { text <-> r; }
    case let Err(e) { print <- "could not read ", full.view(), ": ", e, "\n"; }
  }
  var out = List[u32]();
  let lines = List[&str].from(text.lines());
  var i = 0usize;
  while i < lines.len() {
    if lines[i].len() > 0usize {
      match i64.parse(lines[i]) {
        case let Ok(n) { out.push(u32.from(n)); }
        case is Err {}
      }
    }
    i = i + 1usize;
  }
  out
}

// ---------------------------------------------------------------- measures

struct Dist {
  max: f32;
  rms: f32;
  out: f32;     // the farthest the patch stands outside the Python skin
  inn: f32;     // the farthest inside it
  n: usize;
}

// How far the patch's faces are from the target skin, by points on them (a barycentric grid of 4 divisions)
fn patchDistance(m: &PolyMesh, faces: &List[u32], target: &SurfaceIndex) Dist {
  var mx: f32 = 0.;
  var sum: f64 = 0.0;
  var out: f32 = 0.;
  var inn: f32 = 0.;
  var n = 0usize;
  var i = 0usize;
  while i < faces.len() {
    let pts = m.facePositions(*faces[i]);
    var a = 0;
    while a <= 4 {
      var b = 0;
      while a + b <= 4 {
        let wa = f32.from(a) / 4.;
        let wb = f32.from(b) / 4.;
        let p = *pts[0usize] * (1. - wa - wb) + *pts[1usize] * wa + *pts[2usize] * wb;
        let hit = target.nearest(p, 0.);
        if hit.found() {
          let d = hit.distance;
          if d > mx { mx = d; }
          sum = sum + f64.from(d) * f64.from(d);
          let s = (p - hit.point).dot(hit.normal);
          if s > out { out = s; }
          if -s > inn { inn = -s; }
          n = n + 1usize;
        }
        b = b + 1;
      }
      a = a + 1;
    }
    i = i + 1usize;
  }
  Dist(mx, f32.from(libc.sqrt(sum / f64.from(n))), out, inn, n)
}

fn inwardCount(m: &PolyMesh, faces: &List[u32], outward: Vec3) usize {
  var c = 0usize;
  var i = 0usize;
  while i < faces.len() {
    if m.faceNormal(*faces[i]).dot(outward) <= 0. { c = c + 1usize; }
    i = i + 1usize;
  }
  c
}

// Patch triangles whose normal points against the Python skin's normal at the nearest point to the triangle's
// centroid; 'least' is the least dot product among all
fn localInward(m: &PolyMesh, faces: &List[u32], target: &SurfaceIndex, least: &mut f32) usize {
  var c = 0usize;
  var i = 0usize;
  *least = 2.;
  while i < faces.len() {
    let hit = target.nearest(m.faceCentroid(*faces[i]), 0.);
    let d = m.faceNormal(*faces[i]).dot(hit.normal);
    if d < *least { *least = d; }
    if d <= 0. { c = c + 1usize; }
    i = i + 1usize;
  }
  c
}

fn meanSide(m: &PolyMesh, faces: &List[u32]) f32 {
  var sum: f32 = 0.;
  var n = 0usize;
  var i = 0usize;
  while i < faces.len() {
    let pts = m.facePositions(*faces[i]);
    var k = 0usize;
    while k < 3usize {
      sum = sum + (*pts[(k + 1usize) % 3usize] - *pts[k]).length();
      n = n + 1usize;
      k = k + 1usize;
    }
    i = i + 1usize;
  }
  sum / f32.from(n)
}

fn report(label: &str, h: &HoleFill, outward: Vec3, target: &SurfaceIndex, seconds: f64) {
  let d = patchDistance(&h.mesh, &h.faces, target);
  var least: f32 = 0.;
  let li = localInward(&h.mesh, &h.faces, target, &mut least);
  var leastOut: f32 = 2.;
  var q = 0usize;
  while q < h.faces.len() {
    let dd = h.mesh.faceNormal(*h.faces[q]).dot(outward);
    if dd < leastOut { leastOut = dd; }
    q = q + 1usize;
  }
  print <- label, ": inward by the local test (normal against the Python skin's at the nearest point) ", li, ", least dot ", least,
    "; least dot with the mean outward direction ", leastOut, "\n";
  print <- label, ": patch triangles ", h.faces.len(), ", new vertices ", h.vertices.len(), ", inward ",
    inwardCount(&h.mesh, &h.faces, outward), ", mean side ", meanSide(&h.mesh, &h.faces), " mm\n";
  print <- "    distance to the Python result over ", d.n, " points: largest ", d.max, " mm, RMS ", d.rms,
    " mm; stands out by at most ", d.out, ", in by at most ", d.inn, "; closed: ", h.mesh.validate().len() == 0usize,
    "; time ", seconds, " s\n";
}

fn boundaryNear(m: &PolyMesh, p: Vec3) u32 {
  var best = NoIndex;
  var bd: f32 = 1000000.;
  var v = 0usize;
  while v < m.vertexCount() {
    if m.isBoundaryVertex(u32.from(v)) {
      let d = (*m.positions[v] - p).length();
      if d < bd { bd = d; best = u32.from(v); }
    }
    v = v + 1usize;
  }
  best
}

// ---------------------------------------------------------------- main

fn main() i32 {
  let dirp = FilePath.from("C:/src/mesh-tools-shots");
  if let Err(e) = fs.makeDirAll(&dirp) { print <- "could not make the folder: ", e, "\n"; return 1; }
  var t0 = Instant.now();
  let src = loadObj("knight-noears-r4.obj");
  print <- "read source: ", src.vertexCount(), " vertices, ", src.faceCount(), " faces, ", src.edgeCount(), " edges, in ",
    t0.elapsed().secondsF64(), " s; validate problems ", src.validate().len(), "\n";
  let python = loadObj("knight-nonos.obj");
  print <- "read Python result: ", python.faceCount(), " faces\n";
  let sel = loadFaces("nostril-faces.txt");
  print <- "right nostril faces: ", sel.len(), "\n";

  // The nostril's centre (the selected faces' mean centre) and the skin's outward direction there
  var centre = Vec3(0., 0., 0.);
  var i = 0usize;
  while i < sel.len() {
    centre = centre + src.faceCentroid(*sel[i]);
    i = i + 1usize;
  }
  centre = centre * (1. / f32.from(sel.len()));
  print <- "centre (", centre.x, ", ", centre.y, ", ", centre.z, ")\n";

  t0 = Instant.now();
  let hole = deleteFaces(&src, sel.view());
  let tDelete = t0.elapsed().secondsF64();
  print <- "deleteFaces: ", hole.faceCount(), " faces left, validate problems ", hole.validate().len(), ", ", tDelete, " s\n";
  let v = boundaryNear(&hole, centre);
  let loop = boundaryLoop(&hole, v);
  print <- "hole loop: ", loop.len(), " edges (FillMaxLoop ", FillMaxLoop, ")\n";
  // The outward direction: the mean of the vertex normals round the loop
  let hn = hole.vertexNormals();
  var outward = Vec3(0., 0., 0.);
  i = 0usize;
  while i < loop.len() {
    outward = outward + *hn[usize.from(*loop[i])];
    i = i + 1usize;
  }
  outward = outward.normalize();
  print <- "outward (", outward.x, ", ", outward.y, ", ", outward.z, ")\n";

  let target = SurfaceIndex.of(&python);
  var problems = List[String]();
  t0 = Instant.now();
  let plain = fillHole(&hole, v, false, &mut problems);
  let tPlain = t0.elapsed().secondsF64();
  t0 = Instant.now();
  let refined = fillHole(&hole, v, true, &mut problems);
  let tRefined = t0.elapsed().secondsF64();
  print <- "fillHole problems: ", problems.len(), "\n";
  report("plain fill", &plain, outward, &target, tPlain);
  report("refined fill", &refined, outward, &target, tRefined);
  print <- "closed (no boundary but the neck's): plain boundary vertices ", countBoundary(&plain.mesh), ", hole ", countBoundary(&hole), ", source ", countBoundary(&src), "\n";

  // The same camera for every tile: looking down the outward direction, raking light from one side
  let up = if outward.dot(Vec3(0., 1., 0.)).abs() < 0.9 { Vec3(0., 1., 0.) } else { Vec3(1., 0., 0.) };
  var cv = Canvas.make(1800, 760);
  let tw = 360;
  let radius: f32 = 4.6;
  let names: Array[&str, 5] = ["source", "hole", "plain fill", "refined fill", "Python result"];
  var pass = 0;
  while pass < 2 {
    var t = 0;
    while t < 5 {
      cv.tile(t * tw, pass * 380, (t + 1) * tw, (pass + 1) * 380, Vec3(0.97, 0.97, 0.97));
      let cam = Cam.make(outward, up, centre, 36., f32.from(t * tw) + 180., f32.from(pass * 380) + 190.);
      let lit = (cam.u * 0.92 + cam.w * 0.38).normalize();
      let m: &PolyMesh = if t == 0 { &src } else if t == 1 { &hole } else if t == 2 { &plain.mesh } else if t == 3 { &refined.mesh } else { &python };
      let from = if t == 2 || t == 3 { hole.faceCount() } else { 1000000000usize };
      drawMesh(&mut cv, m, &cam, lit, centre, radius, from, if pass == 1 { 1. } else { 0. }, pass == 1, true);
      t = t + 1;
    }
    pass = pass + 1;
  }
  save(&cv, "nostril-fills.png");
  experiment(&src, &loop, &plain, &refined, &python, outward, centre, up);
  remeshProof(&refined, &loop, &python, &src, outward, centre, up, hole.faceCount());

  // The cut across the muzzle at the nostril
  let origin = centre;
  let normal = Vec3(0., 0., 1.);
  t0 = Instant.now();
  let sec = sectionByPlane(&src, origin, normal);
  let tSec = t0.elapsed().secondsF64();
  print <- "sectionByPlane z = ", origin.z, ": ", sec.closed.len(), " loops, in ", tSec, " s\n";
  var l = 0usize;
  while l < sec.closed.len() {
    let a = usize.from(*sec.starts[l]);
    let b = usize.from(*sec.starts[l + 1usize]);
    var len: f32 = 0.;
    var k = a;
    while k < b {
      let j = if k + 1usize < b {k + 1usize} else {a};
      len = len + (*sec.points[j] - *sec.points[k]).length();
      k = k + 1usize;
    }
    print <- "  loop ", l, ": ", b - a, " points, length ", len, " mm, closed ", *sec.closed[l], "\n";
    l = l + 1usize;
  }
  var bp = List[String]();
  t0 = Instant.now();
  let cutOpen = bisect(&src, origin, normal, false, &mut bp);
  let tBisectOpen = t0.elapsed().secondsF64();
  t0 = Instant.now();
  let cutCap = bisect(&src, origin, normal, true, &mut bp);
  let tBisect = t0.elapsed().secondsF64();
  print <- "bisect open: ", cutOpen.faceCount(), " faces in ", tBisectOpen, " s; capped: ", cutCap.vertexCount(), " vertices, ",
    cutCap.faceCount(), " faces, validate problems ", cutCap.validate().len(), ", problems ", bp.len(), ", ", tBisect, " s\n";
  var b = 0usize;
  while b < bp.len() { print <- "  problem: ", bp[b].view(), "\n"; b = b + 1usize; }
  print <- "boundary vertices: source ", countBoundary(&src), ", open cut ", countBoundary(&cutOpen), ", capped cut ", countBoundary(&cutCap), "\n";

  // Sheet 2: the capped bisect from +z (its cap), and the source from the side and three quarters with the loop
  var c2 = Canvas.make(1800, 640);
  let mid = (src.bounds().min + src.bounds().max) * 0.5;
  var tile = 0;
  while tile < 3 {
    c2.tile(tile * 600, 0, (tile + 1) * 600, 640, Vec3(0.97, 0.97, 0.97));
    let w = if tile == 0 { Vec3(0., 0., 1.) } else if tile == 1 { Vec3(-1., 0., 0.) } else { Vec3(0.7, 0.35, 0.62) };
    let focus = if tile == 0 { Vec3(0., 24., origin.z) } else { Vec3(0., 24., -26.) };
    let cam = Cam.make(w, Vec3(0., 1., 0.), focus, if tile == 0 { 14. } else { 7.4 }, f32.from(tile * 600) + 300., 320.);
    let lit = (cam.u * 0.5 + cam.v * 0.5 + cam.w * 0.7).normalize();
    let m: &PolyMesh = if tile == 0 { &cutCap } else { &src };
    drawMesh(&mut c2, m, &cam, lit, focus, 1000., 1000000000usize, 0., false, false);
    if tile > 0 {
      var l2 = 0usize;
      while l2 < sec.closed.len() {
        let a2 = usize.from(*sec.starts[l2]);
        let b2 = usize.from(*sec.starts[l2 + 1usize]);
        var k = a2;
        while k < b2 {
          let j = if k + 1usize < b2 {k + 1usize} else {a2};
          c2.line(cam.scr(*sec.points[k]), cam.scr(*sec.points[j]), Vec3(0.9, 0.05, 0.05), 0.5 * cam.sc, 2);
          k = k + 1usize;
        }
        l2 = l2 + 1usize;
      }
    }
    tile = tile + 1;
  }
  save(&c2, "nostril-cut.png");
  print <- "timings (s): read ", 0, ", deleteFaces ", tDelete, ", fillHole plain ", tPlain, ", refined ", tRefined,
    ", sectionByPlane ", tSec, ", bisect open ", tBisectOpen, ", capped ", tBisect, "\n";
  0
}

fn countBoundary(m: &PolyMesh) usize {
  var n = 0usize;
  var v = 0usize;
  while v < m.vertexCount() {
    if m.isBoundaryVertex(u32.from(v)) { n = n + 1usize; }
    v = v + 1usize;
  }
  n
}

// ---------------------------------------------------------------- the faired fill experiment (lane 2b)
//
// The same hole through five fills (plain, refined, order 1, order 2, order 2 on a band of rim and one more
// ring), measures for each, and a picture sheet from one camera in two raking lights. The experiment's
// sixth fill, order 2 with tension 0.03 (alone and on the band), was run at the commit before the one that
// removed fairRegionWith: it differed from the same fill without tension by at most 0.0025 mm and looked
// identical, so tension is no longer public (see the PR).

struct Trial {
  label: String;
  mesh: PolyMesh;
  faces: List[u32];
  secs: f64;
}

fn copyFaces(a: &List[u32]) List[u32] {
  var o = List[u32]();
  var i = 0usize;
  while i < a.len() { o.push(*a[i]); i = i + 1usize; }
  o
}

fn flagList(n: usize) List[bool] {
  var f = List[bool].withCapacity(n);
  var i = 0usize;
  while i < n { f.push(false); i = i + 1usize; }
  f
}

// Adds to 'flags' every vertex next to a flagged one, 'layers' times
fn growFlags(m: &PolyMesh, flags: &mut List[bool], layers: i32) {
  var l = 0;
  while l < layers {
    var add = List[u32]();
    var v = 0usize;
    while v < m.vertexCount() {
      if *flags[v] {
        let ns = m.vertexNeighbors(u32.from(v));
        var k = 0usize;
        while k < ns.len() {
          if !*flags[usize.from(*ns[k])] { add.push(*ns[k]); }
          k = k + 1usize;
        }
      }
      v = v + 1usize;
    }
    var a = 0usize;
    while a < add.len() { flags.set(usize.from(*add[a]), true); a = a + 1usize; }
    l = l + 1;
  }
}

fn flaggedList(flags: &List[bool]) List[u32] {
  var o = List[u32]();
  var i = 0usize;
  while i < flags.len() {
    if *flags[i] { o.push(u32.from(i)); }
    i = i + 1usize;
  }
  o
}

struct Rim {
  rimMax: f32;     // the largest angle between neighbouring faces across the patch's rim, degrees
  rimMean: f32;
  outMax: f32;     // the same on the skin just outside: edges between two skin faces that touch a rim vertex
  outMean: f32;
}

fn rimAngles(m: &PolyMesh, patch: &List[bool], rim: &List[bool]) Rim {
  var rMax: f32 = 0.; var rSum: f64 = 0.0; var rN = 0usize;
  var oMax: f32 = 0.; var oSum: f64 = 0.0; var oN = 0usize;
  var e = 0u32;
  while usize.from(e) < m.edgeCount() {
    let h0 = m.edgeHalfedge(e, 0u32);
    let h1 = m.edgeHalfedge(e, 1u32);
    let f0 = m.face(h0);
    let f1 = m.face(h1);
    if f0 != NoIndex && f1 != NoIndex {
      let p0 = *patch[usize.from(f0)];
      let p1 = *patch[usize.from(f1)];
      let a = m.fromVertex(h0);
      let b = m.toVertex(h0);
      var d = m.faceNormal(f0).dot(m.faceNormal(f1));
      if d > 1. { d = 1.; }
      if d < -1. { d = -1.; }
      let ang = f32.from(libc.acos(f64.from(d))) * 57.29578;
      if p0 != p1 {
        if ang > rMax { rMax = ang; }
        rSum = rSum + f64.from(ang); rN = rN + 1usize;
      } else if !p0 && (*rim[usize.from(a)] || *rim[usize.from(b)]) {
        if ang > oMax { oMax = ang; }
        oSum = oSum + f64.from(ang); oN = oN + 1usize;
      }
    }
    e = e + 1u32;
  }
  Rim(rMax, f32.from(rSum / f64.from(rN)), oMax, f32.from(oSum / f64.from(oN)))
}

fn faceFlags(m: &PolyMesh, faces: &List[u32]) List[bool] {
  var f = flagList(m.faceCount());
  var i = 0usize;
  while i < faces.len() { f.set(usize.from(*faces[i]), true); i = i + 1usize; }
  f
}

fn trialReport(t: &Trial, outward: Vec3, python: &SurfaceIndex, ref: &SurfaceIndex, rim: &List[bool]) {
  let d = patchDistance(&t.mesh, &t.faces, python);
  let r = patchDistance(&t.mesh, &t.faces, ref);
  var least: f32 = 0.;
  let li = localInward(&t.mesh, &t.faces, python, &mut least);
  let oi = inwardCount(&t.mesh, &t.faces, outward);
  let pf = faceFlags(&t.mesh, &t.faces);
  let ra = rimAngles(&t.mesh, &pf, rim);
  print <- "TRIAL ", t.label.view(), ": inward ", li, " (by the Python skin; least dot ", least, "), ", oi, " (by mean outward)\n";
  print <- "    to Python: max ", d.max, " RMS ", d.rms, " above ", d.out, " below ", d.inn, "\n";
  print <- "    to the order 2 fill: above ", r.out, " below ", r.inn, " (max ", r.max, ")\n";
  print <- "    rim angle: across the rim max ", ra.rimMax, " mean ", ra.rimMean, " deg; skin just outside max ", ra.outMax,
    " mean ", ra.outMean, " deg; closed ", t.mesh.validate().len() == 0usize, "; time ", t.secs, " s\n";
}

// Signed height of the patch above the Python skin (centroids), binned by distance from the rim: the tent
// shows as a rise in the middle bins, a rim mismatch in the first
fn profile(t: &Trial, python: &SurfaceIndex, rimPts: &List[Vec3]) {
  var sum = List[f64]();
  var mx = List[f32]();
  var mn = List[f32]();
  var cnt = List[u32]();
  var b = 0;
  while b < 10 { sum.push(0.0); mx.push(-1000.); mn.push(1000.); cnt.push(0u32); b = b + 1; }
  var i = 0usize;
  while i < t.faces.len() {
    let c = t.mesh.faceCentroid(*t.faces[i]);
    var dmin: f32 = 1000.;
    var k = 0usize;
    while k < rimPts.len() {
      let d = (*rimPts[k] - c).length();
      if d < dmin { dmin = d; }
      k = k + 1usize;
    }
    let hit = python.nearest(c, 0.);
    let s = (c - hit.point).dot(hit.normal);
    var bin = i32.from(dmin / 0.25);
    if bin > 9 { bin = 9; }
    let bi = usize.from(bin);
    sum.set(bi, *sum[bi] + f64.from(s));
    if s > *mx[bi] { mx.set(bi, s); }
    if s < *mn[bi] { mn.set(bi, s); }
    cnt.set(bi, *cnt[bi] + 1u32);
    i = i + 1usize;
  }
  print <- "PROFILE ", t.label.view(), " (height above the Python skin by distance from the rim, 0.25 mm bins: mean/max/min, n)\n";
  b = 0;
  while b < 10 {
    let bi = usize.from(b);
    if *cnt[bi] > 0u32 {
      print <- "    ", f32.from(b) * 0.25, "+ : ", f32.from(*sum[bi] / f64.from(*cnt[bi])), " / ", *mx[bi], " / ", *mn[bi], ", n ", *cnt[bi], "\n";
    }
    b = b + 1;
  }
}

fn experiment(src: &PolyMesh, loop: &List[u32], plain: &HoleFill, refined: &HoleFill,
    python: &PolyMesh, outward: Vec3, centre: Vec3, up: Vec3) {
  let pyIndex = SurfaceIndex.of(python);
  var rimPts = List[Vec3]();
  var rq = 0usize;
  while rq < loop.len() { rimPts.push(*refined.mesh.positions[usize.from(*loop[rq])]); rq = rq + 1usize; }
  var rim = flagList(refined.mesh.vertexCount());
  var i = 0usize;
  while i < loop.len() { rim.set(usize.from(*loop[i]), true); i = i + 1usize; }
  var problems = List[String]();
  var trials = List[Trial]();
  trials.push(Trial(String.from("1 plain"), plain.mesh.clone(), copyFaces(&plain.faces), 0.));
  trials.push(Trial(String.from("2 refined"), refined.mesh.clone(), copyFaces(&refined.faces), 0.));
  let free = refined.vertices.view();
  var t0 = Instant.now();
  let o1 = fairRegion(&refined.mesh, free, 1u32, &mut problems);
  trials.push(Trial(String.from("3 order 1"), o1, copyFaces(&refined.faces), t0.elapsed().secondsF64()));
  t0 = Instant.now();
  let o2 = fairRegion(&refined.mesh, free, 2u32, &mut problems);
  trials.push(Trial(String.from("4 order 2"), o2, copyFaces(&refined.faces), t0.elapsed().secondsF64()));
  t0 = Instant.now();
  // the band: the patch's new vertices, the rim (ring 1) and the ring beyond it (ring 2)
  var band = flagList(refined.mesh.vertexCount());
  i = 0usize;
  while i < free.len() { band.set(usize.from(free[i]), true); i = i + 1usize; }
  i = 0usize;
  while i < loop.len() { band.set(usize.from(*loop[i]), true); i = i + 1usize; }
  growFlags(&refined.mesh, &mut band, 1);
  let bandList = flaggedList(&band);
  print <- "band: ", bandList.len(), " free vertices (patch ", free.len(), ", rim ", loop.len(), ")\n";
  t0 = Instant.now();
  let b2 = fairRegion(&refined.mesh, bandList.view(), 2u32, &mut problems);
  trials.push(Trial(String.from("5 order 2 band 2"), b2, copyFaces(&refined.faces), t0.elapsed().secondsF64()));
  print <- "fair problems: ", problems.len(), "\n";
  i = 0usize;
  while i < problems.len() { print <- "  ", problems[i].view(), "\n"; i = i + 1usize; }

  let ref = SurfaceIndex.of(&trials[3usize].mesh);
  i = 0usize;
  while i < trials.len() {
    trialReport(&trials[i], outward, &pyIndex, &ref, &rim);
    if i == 0usize || i == 2usize || i == 3usize || i == 4usize { profile(&trials[i], &pyIndex, &rimPts); }
    i = i + 1usize;
  }

  // sheets: tiles source, 7 trials, Python; two raking lights
  let tw = 360;
  var sheet = 0;
  while sheet < 2 {
    var cv = Canvas.make(1800, 760);
    var t = 0;
    while t < 10 {
      let col = t % 5;
      let row = t / 5;
      cv.tile(col * tw, row * 380, (col + 1) * tw, (row + 1) * 380, Vec3(0.97, 0.97, 0.97));
      let cam = Cam.make(outward, up, centre, 36., f32.from(col * tw) + 180., f32.from(row * 380) + 190.);
      let lit = if sheet == 0 { (cam.u * 0.92 + cam.w * 0.38).normalize() } else { (cam.v * -0.85 + cam.u * 0.3 + cam.w * 0.43).normalize() };
      if t == 0 {
        drawMesh(&mut cv, src, &cam, lit, centre, 4.6, 1000000000usize, 0., false, true);
      } else if t <= 5 {
        drawMesh(&mut cv, &trials[usize.from(t - 1)].mesh, &cam, lit, centre, 4.6, 1000000000usize, 0., false, true);
      } else if t == 6 {
        drawMesh(&mut cv, python, &cam, lit, centre, 4.6, 1000000000usize, 0., false, true);
      }
      t = t + 1;
    }
    if sheet == 0 { save(&cv, "fairfill-raking-a.png"); } else { save(&cv, "fairfill-raking-b.png"); }
    sheet = sheet + 1;
  }
}

// ---------------------------------------------------------------- region remesh (brief 3, remeshRegion)
//
// The same hole: the refined fill and one ring of skin outside its rim remeshed at L, the mean edge length
// of that ring of skin, then faired at order 2 on the result's free vertices. Beside lane 2b's order 2 and
// order 2 band fills, measured by its own code (rimAngles, patchDistance, unchanged) and by two measures
// added here: the smallest angle, and the 5th percentile angle, of the triangles of a region.

struct Angles {
  least: f32;     // degrees
  p5: f32;        // the 5th percentile of all the triangles' angles
}

fn angleStats(m: &PolyMesh, faces: &List[u32]) Angles {
  var hist = List[u32]();
  var b = 0;
  while b < 1801 { hist.push(0u32); b = b + 1; }
  var least: f32 = 180.;
  var n = 0usize;
  var i = 0usize;
  while i < faces.len() {
    let p = m.facePositions(*faces[i]);
    var k = 0usize;
    while k < 3usize {
      let a = *p[(k + 1usize) % 3usize] - *p[k];
      let c = *p[(k + 2usize) % 3usize] - *p[k];
      let d = a.length() * c.length();
      var cs: f32 = 1.;
      if d > 0. { cs = a.dot(c) / d; }
      if cs > 1. { cs = 1.; }
      if cs < -1. { cs = -1.; }
      let deg = f32.from(libc.acos(f64.from(cs))) * 57.29578;
      if deg < least { least = deg; }
      var bin = i32.from(deg * 10.);
      if bin > 1800 { bin = 1800; }
      hist.set(usize.from(bin), *hist[usize.from(bin)] + 1u32);
      n = n + 1usize;
      k = k + 1usize;
    }
    i = i + 1usize;
  }
  let want = n / 20usize;
  var acc = 0usize;
  var p5: f32 = 0.;
  var j = 0usize;
  while j < hist.len() {
    acc = acc + usize.from(*hist[j]);
    if acc > want { p5 = f32.from(j) / 10.; j = hist.len(); }
    j = j + 1usize;
  }
  Angles(least, p5)
}

// The vertices on the edge of a set of faces (an edge with a flagged face on one side only)
fn regionEdgeVertices(m: &PolyMesh, flags: &List[bool]) List[bool] {
  var out = flagList(m.vertexCount());
  var e = 0u32;
  while usize.from(e) < m.edgeCount() {
    let h0 = m.edgeHalfedge(e, 0u32);
    let h1 = m.edgeHalfedge(e, 1u32);
    let f0 = m.face(h0);
    let f1 = m.face(h1);
    let in0 = f0 != NoIndex && *flags[usize.from(f0)];
    let in1 = f1 != NoIndex && *flags[usize.from(f1)];
    if in0 != in1 {
      out.set(usize.from(m.toVertex(h0)), true);
      out.set(usize.from(m.fromVertex(h0)), true);
    }
    e = e + 1u32;
  }
  out
}

fn regionRow(label: &str, rounds: u32, m: &PolyMesh, region: &List[u32], python: &SurfaceIndex, patchRim: &List[bool],
    patchFaces: &List[u32], secs: f64) {
  let a = angleStats(m, region);
  let d = patchDistance(m, region, python);
  let flags = faceFlags(m, region);
  let edge = regionEdgeVertices(m, &flags);
  let ra = rimAngles(m, &flags, &edge);
  print <- "REMESH ", label, " ", rounds, ": triangles ", region.len(), "; smallest angle ", a.least, " deg, 5th percentile ", a.p5,
    "; to Python (region) max ", d.max, " RMS ", d.rms, " above ", d.out, " below ", d.inn, "\n";
  print <- "    rim angle across the region's own edge max ", ra.rimMax, " (mean ", ra.rimMean, "), skin just outside max ", ra.outMax,
    " (mean ", ra.outMean, ")";
  if patchFaces.len() > 0usize {
    let pf = faceFlags(m, patchFaces);
    let pr = rimAngles(m, &pf, patchRim);
    print <- "; across the patch's rim (lane 2b's measure) max ", pr.rimMax, " (mean ", pr.rimMean, ")";
  }
  print <- "; closed ", m.validate().len() == 0usize, "; time ", secs, " s\n";
}

fn remeshProof(refined: &HoleFill, loop: &List[u32], python: &PolyMesh, src: &PolyMesh, outward: Vec3, centre: Vec3, up: Vec3,
    holeFaces: usize) {
  let pyIndex = SurfaceIndex.of(python);
  let m0 = &refined.mesh;
  var rimFlags = flagList(m0.vertexCount());
  var i = 0usize;
  while i < loop.len() { rimFlags.set(usize.from(*loop[i]), true); i = i + 1usize; }
  // the region: the patch and one ring of skin round it (every face with a vertex on the rim)
  var inRegion = faceFlags(m0, &refined.faces);
  var ring = List[u32]();
  var f = 0u32;
  while usize.from(f) < m0.faceCount() {
    if !*inRegion[usize.from(f)] {
      let vs = m0.faceVertices(f);
      var touches = false;
      var k = 0usize;
      while k < vs.len() { if *rimFlags[usize.from(*vs[k])] { touches = true; } k = k + 1usize; }
      if touches { ring.push(f); }
    }
    f = f + 1u32;
  }
  i = 0usize;
  while i < ring.len() { inRegion.set(usize.from(*ring[i]), true); i = i + 1usize; }
  var region0 = List[u32]();
  f = 0u32;
  while usize.from(f) < m0.faceCount() {
    if *inRegion[usize.from(f)] { region0.push(f); }
    f = f + 1u32;
  }
  let edgeLen = meanSide(m0, &ring);
  print <- "REMESH region: patch ", refined.faces.len(), " triangles, ring of skin ", ring.len(), ", together ", region0.len(),
    "; L = mean side of the ring ", edgeLen, " mm; patch mean side ", meanSide(m0, &refined.faces), " mm\n";

  var problems = List[String]();
  // lane 2b's two fills, again (its code)
  var t0 = Instant.now();
  let o2 = fairRegion(m0, refined.vertices.view(), 2u32, &mut problems);
  let tO2 = t0.elapsed().secondsF64();
  var band = flagList(m0.vertexCount());
  i = 0usize;
  while i < refined.vertices.len() { band.set(usize.from(*refined.vertices[i]), true); i = i + 1usize; }
  i = 0usize;
  while i < loop.len() { band.set(usize.from(*loop[i]), true); i = i + 1usize; }
  growFlags(m0, &mut band, 1);
  let bandList = flaggedList(&band);
  t0 = Instant.now();
  let b2 = fairRegion(m0, bandList.view(), 2u32, &mut problems);
  let tB2 = t0.elapsed().secondsF64();
  let noFaces = List[u32]();
  regionRow("refined fill, unfaired", 0u32, m0, &region0, &pyIndex, &rimFlags, &refined.faces, 0.);
  regionRow("lane 2b order 2", 0u32, &o2, &region0, &pyIndex, &rimFlags, &refined.faces, tO2);
  regionRow("lane 2b order 2 band", 0u32, &b2, &region0, &pyIndex, &rimFlags, &refined.faces, tB2);

  // the remesh, at several rounds
  var rounds = List[u32]();
  rounds.push(5u32); rounds.push(10u32); rounds.push(20u32);
  var results = List[RegionRemesh]();
  var faired = List[PolyMesh]();
  var secs = List[f64]();
  var secsFair = List[f64]();
  var q = 0usize;
  while q < rounds.len() {
    t0 = Instant.now();
    let r = remeshRegion(m0, region0.view(), edgeLen, *rounds[q], &mut problems);
    let tR = t0.elapsed().secondsF64();
    t0 = Instant.now();
    let fr = fairRegion(&r.mesh, r.vertices.view(), 2u32, &mut problems);
    let tF = t0.elapsed().secondsF64();
    print <- "REMESH rounds ", *rounds[q], ": ", r.faces.len(), " triangles, ", r.vertices.len(), " free vertices, remesh ", tR, " s, fair ", tF, " s\n";
    if q == 0usize {
      let nOut = r.mesh.faceCount() - r.faces.len();
      var ee = 0u32;
      var shown = 0;
      while usize.from(ee) < r.mesh.edgeCount() && shown < 8 {
        let h0 = r.mesh.edgeHalfedge(ee, 0u32);
        let f0 = r.mesh.face(h0);
        let f1 = r.mesh.face(r.mesh.edgeHalfedge(ee, 1u32));
        if f0 != NoIndex && f1 != NoIndex && ((usize.from(f0) >= nOut) != (usize.from(f1) >= nOut)) {
          let d = r.mesh.faceNormal(f0).dot(r.mesh.faceNormal(f1));
          let ang = f32.from(libc.acos(f64.from(d))) * 57.29578;
          if ang > 40. {
            let fi = if usize.from(f0) >= nOut { f0 } else { f1 };
            let fo = if usize.from(f0) >= nOut { f1 } else { f0 };
            var li = List[u32](); li.push(fi);
            var lo = List[u32](); lo.push(fo);
            let si = r.mesh.facePositions(fi);
            let so = r.mesh.facePositions(fo);
            print <- "  FOLD ", ang, " deg, inside tri least angle ", angleStats(&r.mesh, &li).least, " area ", (( *si[1usize] - *si[0usize]).cross(*si[2usize] - *si[0usize])).length() * 0.5,
              "; outside tri least angle ", angleStats(&r.mesh, &lo).least, " area ", ((*so[1usize] - *so[0usize]).cross(*so[2usize] - *so[0usize])).length() * 0.5, "\n";
            shown = shown + 1;
          }
        }
        ee = ee + 1u32;
      }
      var bad = 0;
      var ff = 0usize;
      while ff < r.faces.len() && bad < 12 {
        let one = List[u32]();
        var oneL = List[u32]();
        oneL.push(*r.faces[ff]);
        let st = angleStats(&r.mesh, &oneL);
        if st.least < 3. {
          let vs = r.mesh.faceVertices(*r.faces[ff]);
          let p0 = *r.mesh.positions[usize.from(*vs[0usize])];
          let p1 = *r.mesh.positions[usize.from(*vs[1usize])];
          let p2 = *r.mesh.positions[usize.from(*vs[2usize])];
          print <- "  BAD face ", *r.faces[ff], " least ", st.least, " verts ", *vs[0usize], " ", *vs[1usize], " ", *vs[2usize], " free? ", r.vertices.contains(&*vs[0usize]), " ",  " side lengths ", (p1 - p0).length(), " ", (p2 - p1).length(), " ", (p0 - p2).length(), "\n";
          bad = bad + 1;
        }
        ff = ff + 1usize;
      }
    }
    results.push(r);
    faired.push(fr);
    secs.push(tR);
    secsFair.push(tF);
    q = q + 1usize;
  }
  print <- "remesh problems ", problems.len(), "\n";
  i = 0usize;
  while i < problems.len() { print <- "  ", problems[i].view(), "\n"; i = i + 1usize; }
  q = 0usize;
  while q < rounds.len() {
    regionRow("remeshed, rounds", *rounds[q], &results[q].mesh, &results[q].faces, &pyIndex, &rimFlags, &noFaces, *secs[q]);
    regionRow("remeshed and faired order 2, rounds", *rounds[q], &faired[q], &results[q].faces, &pyIndex, &rimFlags, &noFaces,
      *secs[q] + *secsFair[q]);
    q = q + 1usize;
  }
  let chosen = 1usize;

  // the sheet: source, lane 2b order 2, lane 2b band, remeshed and faired (rounds 10), remeshed raw; two lights and a wire row
  let tw = 360;
  var cv = Canvas.make(1800, 1140);
  var row = 0;
  while row < 3 {
    var col = 0;
    while col < 5 {
      cv.tile(col * tw, row * 380, (col + 1) * tw, (row + 1) * 380, Vec3(0.97, 0.97, 0.97));
      let cam = Cam.make(outward, up, centre, 36., f32.from(col * tw) + 180., f32.from(row * 380) + 190.);
      let lit = if row == 1 { (cam.v * -0.85 + cam.u * 0.3 + cam.w * 0.43).normalize() } else { (cam.u * 0.92 + cam.w * 0.38).normalize() };
      let m: &PolyMesh = if col == 0 { src } else if col == 1 { &o2 } else if col == 2 { &b2 } else if col == 3 { &faired[chosen] } else { &results[chosen].mesh };
      if row < 2 {
        drawMesh(&mut cv, m, &cam, lit, centre, 4.6, 1000000000usize, 0., false, true);
      } else if col >= 1 {
        let from = if col <= 2 { holeFaces } else { results[chosen].mesh.faceCount() - results[chosen].faces.len() };
        drawMesh(&mut cv, m, &cam, lit, centre, 4.6, from, 1., true, false);
      }
      col = col + 1;
    }
    row = row + 1;
  }
  save(&cv, "remesh-sheet.png");
}
