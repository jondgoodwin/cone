// multires: multiresolution (Multires) on skinmesh's figures, drawn by a small software
// renderer (no GPU) to PNG sheets in C:/src/sculptmultires-shots, and timed.
//
//   congo run --release packages/sculpt/examples/multires.cone
//
//   multires-figure.png     the human skin at levels 0 to 3, hand-placed detail at level 3; below, the
//                           level 0 bent (a tenth of a turn round the waist and more), level 3 with its detail
//                           riding the bend, the same detail as a plain world-space offset (wrong), and the
//                           distance between the two
//   multires-operators.png  the creature: level 0; level 3 smooth; scales sculpted at level 3; a lump
//                           pulled at level 1 with the scales still on (edit then propagate); the base fitted
//                           back from the sculpted level 3 (Reconstruct Subdiv); level 1 after deleteLower(2);
//                           level 1 after bakeDown; the height between levels 0 and 3
//   multires-storage.png    the human's head with detail at float32, 16 and 8 bits, and the error maps
//
// It prints: the timing (a torus base of 2,000 quads, four levels: build, evaluate, reshape the base, edit
// level 2, rebuild from the level-3 mesh), the bytes of each level's detail at 32, 16 and 8 bits, and the
// fits. Exit status 0 if the checks it makes held (the rebuilt top is the dense mesh, 16-bit errors small).

mod multires;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import imagedecode use *;
import fs;
import path;
import time use Instant;
import sculpt use *;
import skinmesh use *;

// ---------------------------------------------------------------- a canvas

struct Canvas {
  w i32;
  h i32;
  px List[u8];
  zb List[f32];
  cx0 i32;
  cy0 i32;
  cx1 i32;
  cy1 i32;

  fn make(w i32, h i32) Canvas {
    var c = new Canvas(w, h, List[u8].empty(), List[f32].empty(), 0, 0, w, h);
    c.px.resize(usize.from(w) * usize.from(h) * 4usize, 255u8);
    c.zb.resize(usize.from(w) * usize.from(h), -1000000.);
    c
  }

  fn tile(self &mut, x0 i32, y0 i32, x1 i32, y1 i32, bg Vec3) {
    cx0 = x0; cy0 = y0; cx1 = x1; cy1 = y1;
    var y = y0;
    while y < y1 {
      var x = x0;
      while x < x1 {
        self.setPixel(x, y, bg);
        zb.set(usize.from(y * w + x), -1000000.);
        x = x + 1;
      }
      y = y + 1;
    }
  }

  fn setPixel(self &mut, x i32, y i32, c Vec3) {
    let i = usize.from(y * w + x) * 4usize;
    px.set(i, byteOf(c.x));
    px.set(i + 1usize, byteOf(c.y));
    px.set(i + 2usize, byteOf(c.z));
  }

  fn plot(self &mut, x i32, y i32, z f32, c Vec3) {
    if x >= cx0 && x < cx1 && y >= cy0 && y < cy1 {
      let i = usize.from(y * w + x);
      if z > *zb[i] {
        zb.set(i, z);
        self.setPixel(x, y, c);
      }
    }
  }

  // A triangle in screen space with depths, its normals and colours interpolated and lit per pixel
  fn triangle(self &mut, a Vec3, b Vec3, c Vec3, na Vec3, nb Vec3, nc Vec3, ca Vec3, cb Vec3, cc Vec3) {
    let minx = imax(cx0, i32.from(libc.floorf(fmin3(a.x, b.x, c.x))));
    let maxx = imin(cx1 - 1, i32.from(libc.ceilf(fmax3(a.x, b.x, c.x))));
    let miny = imax(cy0, i32.from(libc.floorf(fmin3(a.y, b.y, c.y))));
    let maxy = imin(cy1 - 1, i32.from(libc.ceilf(fmax3(a.y, b.y, c.y))));
    let den = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
    if den > -0.0000001 && den < 0.0000001 { return; }
    let light = new Vec3(-0.35, 0.55, 0.75).normalize();
    var y = miny;
    while y <= maxy {
      var x = minx;
      while x <= maxx {
        let px_ = f32.from(x) + 0.5;
        let py_ = f32.from(y) + 0.5;
        let l0 = ((b.y - c.y) * (px_ - c.x) + (c.x - b.x) * (py_ - c.y)) / den;
        let l1 = ((c.y - a.y) * (px_ - c.x) + (a.x - c.x) * (py_ - c.y)) / den;
        let l2 = 1. - l0 - l1;
        if l0 >= -0.0001 && l1 >= -0.0001 && l2 >= -0.0001 {
          let z = l0 * a.z + l1 * b.z + l2 * c.z;
          if x >= cx0 && x < cx1 && y >= cy0 && y < cy1 && z > *zb[usize.from(y * w + x)] {
            let n = (na * l0 + nb * l1 + nc * l2).normalize();
            let base = ca * l0 + cb * l1 + cc * l2;
            let shade = 0.30 + 0.70 * fmax3(n.dot(light), 0., 0.);
            self.plot(x, y, z, base * shade);
          }
        }
        x = x + 1;
      }
      y = y + 1;
    }
  }

  fn line(self &mut, a Vec3, b Vec3, col Vec3, bias f32) {
    let dx = b.x - a.x;
    let dy = b.y - a.y;
    let steps = i32.from(fmax3(absf(dx), absf(dy), 1.)) + 1;
    var i = 0;
    while i <= steps {
      let t = f32.from(i) / f32.from(steps);
      self.plot(i32.from(a.x + dx * t), i32.from(a.y + dy * t), a.z + (b.z - a.z) * t + bias, col);
      i = i + 1;
    }
  }
}

fn absf(a f32) f32 { if a < 0. {-a} else {a} }
fn imax(a i32, b i32) i32 { if a > b {a} else {b} }
fn imin(a i32, b i32) i32 { if a < b {a} else {b} }
fn fmin3(a f32, b f32, c f32) f32 { let m = if a < b {a} else {b}; if m < c {m} else {c} }
fn fmax3(a f32, b f32, c f32) f32 { let m = if a > b {a} else {b}; if m > c {m} else {c} }

fn byteOf(v f32) u8 {
  var x = i32.from(v * 255. + 0.5);
  if x < 0 { x = 0; }
  if x > 255 { x = 255; }
  u8.from(x)
}

// A ramp, 0 blue, 0.5 pale, 1 red
fn heat(t f32) Vec3 {
  let u = if t < 0. {0.} elif t > 1. {1.} else {t};
  if u < 0.5 {
    let s = u * 2.;
    new Vec3(0.20 + 0.75 * s, 0.30 + 0.65 * s, 0.85 + 0.10 * s)
  } else {
    let s = (u - 0.5) * 2.;
    new Vec3(0.95, 0.95 - 0.70 * s, 0.95 - 0.75 * s)
  }
}

// A view: yaw about y, then pitch about x
struct View {
  yaw f32;
  pitch f32;

  fn turn(self, p Vec3) Vec3 {
    let cy = cos(yaw);
    let sy = sin(yaw);
    let x1 = p.x * cy + p.z * sy;
    let z1 = -p.x * sy + p.z * cy;
    let cp = cos(pitch);
    let sp = sin(pitch);
    new Vec3(x1, p.y * cp - z1 * sp, p.y * sp + z1 * cp)
  }
}

// A box to fit a tile to
struct Box {
  lo Vec3;
  hi Vec3;
}

fn boxOf(positions &List[Vec3]) Box {
  var lo = new Vec3(1000000., 1000000., 1000000.);
  var hi = new Vec3(-1000000., -1000000., -1000000.);
  var v = 0usize;
  while v < positions.len() {
    lo = lo.min(*positions[v]);
    hi = hi.max(*positions[v]);
    v = v + 1usize;
  }
  new Box(lo, hi)
}

// The box of the vertices above a height
fn boxAbove(positions &List[Vec3], y f32) Box {
  var lo = new Vec3(1000000., 1000000., 1000000.);
  var hi = new Vec3(-1000000., -1000000., -1000000.);
  var v = 0usize;
  while v < positions.len() {
    if positions[v].y > y {
      lo = lo.min(*positions[v]);
      hi = hi.max(*positions[v]);
    }
    v = v + 1usize;
  }
  new Box(lo, hi)
}

// Draw a mesh into the current tile: fitted to 'fit', smooth shaded, 'cols' (a colour a vertex, or none) under the
// light, quads outlined if asked
fn drawMesh(cv &mut Canvas, pm &PolyMesh, view &View, fit &Box, cols &List[Vec3], outline bool) {
  let tw = f32.from(cv.cx1 - cv.cx0);
  let th = f32.from(cv.cy1 - cv.cy0);
  var lo = new Vec3(1000000., 1000000., 1000000.);
  var hi = new Vec3(-1000000., -1000000., -1000000.);
  var c = 0;
  while c < 8 {
    let corner = new Vec3(if (c & 1) != 0 {fit.hi.x} else {fit.lo.x}, if (c & 2) != 0 {fit.hi.y} else {fit.lo.y},
      if (c & 4) != 0 {fit.hi.z} else {fit.lo.z});
    let p = view.turn(corner);
    lo = lo.min(p);
    hi = hi.max(p);
    c = c + 1;
  }
  let ext = hi - lo;
  let sc = fmin3(tw * 0.88 / fmax3(ext.x, 0.0001, 0.0001), th * 0.88 / fmax3(ext.y, 0.0001, 0.0001), 1000000.);
  let mid = (lo + hi) * 0.5;
  let nrm = pm.vertexNormals();
  var sp = List[Vec3].withCapacity(pm.positions.len());
  var sn = List[Vec3].withCapacity(pm.positions.len());
  var v = 0usize;
  while v < pm.positions.len() {
    let p = view.turn(*pm.positions[v]) - mid;
    sp.push(new Vec3(f32.from(cv.cx0) + tw * 0.5 + p.x * sc, f32.from(cv.cy0) + th * 0.5 - p.y * sc, p.z * sc));
    sn.push(view.turn(*nrm[v]));
    v = v + 1usize;
  }
  let grey = new Vec3(0.78, 0.80, 0.84);
  var f = 0usize;
  while f < pm.faceCount() {
    let vs = pm.faceVertices(u32.from(f));
    var k = 1usize;
    while k + 1usize < vs.len() {
      let i0 = usize.from(*vs[0usize]);
      let i1 = usize.from(*vs[k]);
      let i2 = usize.from(*vs[k + 1usize]);
      let c0 = if cols.len() > 0usize {*cols[i0]} else {grey};
      let c1 = if cols.len() > 0usize {*cols[i1]} else {grey};
      let c2 = if cols.len() > 0usize {*cols[i2]} else {grey};
      cv.triangle(*sp[i0], *sp[i1], *sp[i2], *sn[i0], *sn[i1], *sn[i2], c0, c1, c2);
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  if outline {
    f = 0usize;
    while f < pm.faceCount() {
      let vs = pm.faceVertices(u32.from(f));
      var k = 0usize;
      while k < vs.len() {
        cv.line(*sp[usize.from(*vs[k])], *sp[usize.from(*vs[(k + 1usize) % vs.len()])], new Vec3(0.12, 0.12, 0.16), 0.6);
        k = k + 1usize;
      }
      f = f + 1usize;
    }
  }
}

fn save(cv &Canvas, name &str) {
  var r = Raster.empty();
  r.width = cv.w;
  r.height = cv.h;
  r.depth = 8;
  r.colorSpace = ColorSpace.Srgb;
  var i = 0usize;
  while i < cv.px.len() { r.pixels8.push(*cv.px[i]); i = i + 1usize; }
  let png = encodePng(&r, 2);
  var full = String.from("C:/src/sculptmultires-shots/");
  full.append(name);
  let op = path.Path.from(full.view());
  fs.writeFile(&op, png.view());
  printStr("wrote "); printStr(full.view()); printStr(" ("); print <- png.len(); printStr(" bytes)\n");
}

// Scalars per vertex as heat colours, 0 at the middle of the ramp, +-limit at its ends
fn heatColours(values &List[f32], limit f32) List[Vec3] {
  var out = List[Vec3].withCapacity(values.len());
  var v = 0usize;
  while v < values.len() {
    out.push(heat(0.5 + 0.5 * *values[v] / limit));
    v = v + 1usize;
  }
  out
}

// The same, all positive: 0 at the blue end, limit at the red
fn heatPositive(values &List[f32], limit f32) List[Vec3] {
  var out = List[Vec3].withCapacity(values.len());
  var v = 0usize;
  while v < values.len() {
    out.push(heat(*values[v] / limit));
    v = v + 1usize;
  }
  out
}

// ---------------------------------------------------------------- the figures

fn v3(x f32, y f32, z f32) Vec3 { new Vec3(x, y, z) }

// A person standing in an A pose, facing +z (as skinmesh's figures)
fn human() SkinGraph {
  var g = SkinGraph.empty();
  let pelvis = g.addNode(v3(0., 0.93, 0.), 0.07, 0.07);
  g.setRoot(pelvis);
  let waist = g.grow(pelvis, v3(0., 1.12, 0.), 0.15, 0.10);
  let chest = g.grow(waist, v3(0., 1.32, 0.01), 0.10, 0.08);
  let neck = g.grow(chest, v3(0., 1.66, 0.), 0.05, 0.05);
  let head = g.grow(neck, v3(0., 1.78, 0.015), 0.09, 0.10);
  g.grow(head, v3(0., 1.94, 0.015), 0.075, 0.085);
  var side = -1.f;
  var s = 0;
  while s < 2 {
    let shoulder = g.grow(chest, v3(side * 0.42, 1.44, 0.), 0.055, 0.055);
    let elbow = g.grow(shoulder, v3(side * 0.62, 1.18, 0.), 0.05, 0.05);
    let wrist = g.grow(elbow, v3(side * 0.78, 0.95, 0.03), 0.038, 0.032);
    g.grow(wrist, v3(side * 0.85, 0.84, 0.04), 0.04, 0.016);
    let knee = g.grow(pelvis, v3(side * 0.24, 0.50, 0.025), 0.07, 0.07);
    let ankle = g.grow(knee, v3(side * 0.20, 0.09, 0.), 0.05, 0.05);
    g.grow(ankle, v3(side * 0.20, 0.04, 0.16), 0.05, 0.03);
    side = 1.;
    s = s + 1;
  }
  g
}

// A four-legged creature with a tail and a long head
fn creature() SkinGraph {
  var g = SkinGraph.empty();
  let hips = g.addNode(v3(0., 0.62, -0.50), 0.09, 0.10);
  g.setRoot(hips);
  let mid = g.grow(hips, v3(0., 0.68, 0.), 0.17, 0.15);
  let shoulders = g.grow(mid, v3(0., 0.68, 0.50), 0.10, 0.11);
  let neck = g.grow(shoulders, v3(0., 0.82, 0.78), 0.09, 0.09);
  let head = g.grow(neck, v3(0., 0.86, 0.98), 0.075, 0.08);
  g.grow(head, v3(0., 0.80, 1.18), 0.05, 0.05);
  let tail1 = g.grow(hips, v3(0., 0.66, -0.80), 0.045, 0.045);
  let tail2 = g.grow(tail1, v3(0., 0.62, -1.05), 0.035, 0.035);
  g.grow(tail2, v3(0., 0.74, -1.28), 0.02, 0.02);
  var side = -1.f;
  var s = 0;
  while s < 2 {
    let elbow = g.grow(shoulders, v3(side * 0.28, 0.36, 0.52), 0.06, 0.06);
    let wrist = g.grow(elbow, v3(side * 0.24, 0.13, 0.54), 0.04, 0.04);
    g.grow(wrist, v3(side * 0.24, 0.03, 0.62), 0.045, 0.035);
    let knee = g.grow(hips, v3(side * 0.30, 0.34, -0.40), 0.07, 0.07);
    let hock = g.grow(knee, v3(side * 0.24, 0.18, -0.64), 0.04, 0.04);
    g.grow(hock, v3(side * 0.24, 0.03, -0.54), 0.045, 0.035);
    side = 1.;
    s = s + 1;
  }
  g
}

fn torus(major f32, minor f32, around u32, steps u32) PolyMesh {
  var pts = List[Vec2].empty();
  var i = 0u32;
  while i < around {
    let a = 2. * pi * f32.from(i) / f32.from(around);
    pts.push(new Vec2(major + minor * cos(a), minor * sin(a)));
    i = i + 1u32;
  }
  let prof = Profile.fromPoints(pts.view(), true);
  lathe(&prof, v3(0., 1., 0.), 2. * pi, steps)
}

// A hand-placed bump: a Gaussian of radius r and height h (negative for a dent) about the front-most vertex near
// (x, y)
struct Bump {
  x f32;
  y f32;
  r f32;
  h f32;
}

// The vertex of the mesh facing +z nearest the map point (x, y)
fn frontVertex(positions &List[Vec3], x f32, y f32) Vec3 {
  var best = new Vec3(x, y, 0.);
  var bestZ = -1000000.f;
  var v = 0usize;
  while v < positions.len() {
    let p = *positions[v];
    if (p.x - x) * (p.x - x) + (p.y - y) * (p.y - y) < 0.0002 && p.z > bestZ {
      bestZ = p.z;
      best = p;
    }
    v = v + 1usize;
  }
  best
}

// The hand-placed detail of the human: pecs, a navel, a row of buttons, knees, a nose and eye sockets
fn humanBumps() List[Bump] {
  var b = List[Bump].empty();
  b.push(new Bump(-0.075, 1.36, 0.06, 0.016));
  b.push(new Bump(0.075, 1.36, 0.06, 0.016));
  b.push(new Bump(0., 1.06, 0.025, -0.012));
  b.push(new Bump(0., 1.22, 0.02, 0.010));
  b.push(new Bump(0., 1.17, 0.02, 0.010));
  b.push(new Bump(0., 1.12, 0.02, 0.010));
  b.push(new Bump(-0.24, 0.52, 0.06, 0.015));
  b.push(new Bump(0.24, 0.52, 0.06, 0.015));
  b.push(new Bump(0., 1.77, 0.028, 0.022));
  b.push(new Bump(-0.04, 1.83, 0.022, -0.010));
  b.push(new Bump(0.04, 1.83, 0.022, -0.010));
  b.push(new Bump(0., 1.70, 0.03, 0.008));
  b
}

// Level-3 positions with the bumps put on along the level's normals
fn bumped(top &PolyMesh, bumps &List[Bump]) List[Vec3] {
  let nrm = top.vertexNormals();
  var centres = List[Vec3].empty();
  var i = 0usize;
  while i < bumps.len() {
    centres.push(frontVertex(&top.positions, bumps[i].x, bumps[i].y));
    i = i + 1usize;
  }
  var out = List[Vec3].withCapacity(top.positions.len());
  var v = 0usize;
  while v < top.positions.len() {
    let p = *top.positions[v];
    var w = 0.f;
    i = 0usize;
    while i < bumps.len() {
      let d = (p - *centres[i]).length() / bumps[i].r;
      if d < 3. { w = w + 2.5 * bumps[i].h * libc.expf(-2. * d * d); }
      i = i + 1usize;
    }
    out.push(p + *nrm[v] * w);
    v = v + 1usize;
  }
  out
}

// Scales for the creature: a pattern over the skin's own coordinates "along" and "around"
fn scaled(top &PolyMesh) List[Vec3] {
  let nrm = top.vertexNormals();
  let along = top.findFloatChannel(VertexDomain, "along");
  let around = top.findFloatChannel(VertexDomain, "around");
  var out = List[Vec3].withCapacity(top.positions.len());
  var v = 0usize;
  while v < top.positions.len() {
    let a = top.float(along, u32.from(v));
    let r = top.float(around, u32.from(v));
    let h = 0.006 * sin(a * 140.) * sin(r * 100.) * (0.5 + 0.5 * sin(a * 9.));
    out.push(*top.positions[v] + *nrm[v] * h);
    v = v + 1usize;
  }
  out
}

// ---------------------------------------------------------------- measures

fn seconds(started Instant) f64 { started.elapsed().secondsF64() }

fn maxDistance(a &List[Vec3], b &List[Vec3]) f32 {
  var worst = 0.f;
  var i = 0usize;
  while i < a.len() {
    let d = (*a[i] - *b[i]).length();
    if d > worst { worst = d; }
    i = i + 1usize;
  }
  worst
}

fn distances(a &List[Vec3], b &List[Vec3]) List[f32] {
  var out = List[f32].withCapacity(a.len());
  var i = 0usize;
  while i < a.len() {
    out.push((*a[i] - *b[i]).length());
    i = i + 1usize;
  }
  out
}

fn copyPositions(src &List[Vec3]) List[Vec3] {
  var out = List[Vec3].withCapacity(src.len());
  var i = 0usize;
  while i < src.len() {
    out.push(*src[i]);
    i = i + 1usize;
  }
  out
}

fn withPos(m &PolyMesh, p &List[Vec3]) PolyMesh {
  var c = subdivide(m, 0u32);
  var i = 0usize;
  while i < p.len() {
    c.positions.set(i, *p[i]);
    i = i + 1usize;
  }
  c
}

fn bytesLine(name &str, mr &Multires) {
  printStr(name); printStr(": bytes of detail per level (float32 / 16-bit / 8-bit)\n");
  var k = 1u32;
  while k <= mr.levelCount() {
    printStr("  level "); print <- k; printStr(" ("); print <- mr.levels[usize.from(k)].vertexCount(); printStr(" vertices): ");
    print <- detailBytes(mr, k, 32u32); printStr(" / "); print <- detailBytes(mr, k, 16u32); printStr(" / ");
    print <- detailBytes(mr, k, 8u32); printStr("\n");
    k = k + 1u32;
  }
  printStr("  all levels: "); print <- totalDetailBytes(mr, 32u32); printStr(" / "); print <- totalDetailBytes(mr, 16u32);
  printStr(" / "); print <- totalDetailBytes(mr, 8u32); printStr("\n");
}

fn timing() bool {
  printStr("timing: a torus base of 2,000 quads\n");
  let base = torus(1., 0.35, 40u32, 50u32);
  printStr("  base "); print <- base.faceCount(); printStr(" faces\n");
  var t = Instant.now();
  var mr = Multires.fromMesh(&base);
  var k = 0;
  while k < 4 {
    mr.addLevel();
    k = k + 1;
  }
  printStr("  four addLevel (topology and channels, subdivide): "); print <- seconds(t); printStr(" s; level 4 has ");
  print <- mr.levels[4usize].faceCount(); printStr(" faces, "); print <- mr.levels[4usize].vertexCount(); printStr(" vertices\n");
  // Some detail on the top, so evaluation has work to do
  var p = copyPositions(&mr.levels[4usize].positions);
  var i = 0usize;
  while i < p.len() {
    p.set(i, *p[i] + new Vec3(0., 0.004 * sin(f32.from(i) * 0.37), 0.));
    i = i + 1usize;
  }
  mr.editLevel(4u32, &p);
  t = Instant.now();
  mr.reevaluate(0usize);
  let evalS = seconds(t);
  printStr("  evaluate 4 levels (reevaluate from the base: references, frames, detail): "); print <- evalS; printStr(" s\n");
  var moved = copyPositions(&mr.levels[0usize].positions);
  i = 0usize;
  while i < moved.len() {
    moved.set(i, *moved[i] * 1.1);
    i = i + 1usize;
  }
  t = Instant.now();
  mr.setBase(&moved);
  printStr("  setBase (reshape the base, all four levels follow): "); print <- seconds(t); printStr(" s\n");
  var q = copyPositions(&mr.levels[2usize].positions);
  q.set(5usize, *q[5usize] + new Vec3(0., 0.1, 0.));
  t = Instant.now();
  mr.editLevel(2u32, &q);
  printStr("  editLevel 2 (levels 3 and 4 follow): "); print <- seconds(t); printStr(" s\n");
  t = Instant.now();
  let packed = packDetail(&mr, 4u32, 16u32);
  printStr("  packDetail level 4 at 16 bits ("); print <- packed.len(); printStr(" bytes): "); print <- seconds(t); printStr(" s\n");
  let dense3 = mr.evaluate(3u32);
  t = Instant.now();
  var problems = List[String].empty();
  let back = fromDense(&dense3, 3u32, &mut problems);
  printStr("  fromDense, level 3 ("); print <- dense3.faceCount(); printStr(" faces) back to three levels and the base: ");
  print <- seconds(t); printStr(" s; base "); print <- back.levels[0usize].faceCount(); printStr(" faces, problems ");
  print <- problems.len(); printStr("\n");
  bytesLine("torus", &mr);
  back.levelCount() == 3u32 && problems.len() == 0usize
}

// ---------------------------------------------------------------- the sheets

fn figureSheet(cv &mut Canvas) bool {
  let skinned = skinStandard(&human());
  printStr("human base: "); print <- skinned.mesh.vertexCount(); printStr(" vertices, "); print <- skinned.mesh.faceCount(); printStr(" faces\n");
  var mr = Multires.fromMesh(&skinned.mesh);
  mr.addLevel();
  mr.addLevel();
  mr.addLevel();
  let plain3 = copyPositions(&mr.levels[3usize].positions);
  let bumps = humanBumps();
  let sculpted = bumped(mr.levels[3usize], &bumps);
  mr.editLevel(3u32, &sculpted);
  printStr("level 3: "); print <- mr.levels[3usize].faceCount(); printStr(" faces; detail RMS "); print <- detailRms(&mr, 3u32);
  printStr(", greatest "); print <- maxDistance(&sculpted, &plain3); printStr("\n");
  bytesLine("human", &mr);
  let bg = new Vec3(0.96, 0.96, 0.94);
  let none = List[Vec3].empty();
  let view = new View(0.45, 0.1);
  let fit = boxOf(&mr.levels[3usize].positions);
  var i = 0usize;
  while i < 4usize {
    let x0 = i32.from(i) * 640;
    cv.tile(x0, 0, x0 + 640, 720, bg);
    drawMesh(cv, mr.levels[i], &view, &fit, &none, i < 2usize);
    i = i + 1usize;
  }
  // Bent: the base reshaped
  let bentBase = bend(mr.levels[0usize], 1.1, v3(0., 0., 1.), v3(0., 1., 0.), v3(0., 0., 0.));
  let worldDetail = distances(&sculpted, &plain3);
  var offsets = List[Vec3].withCapacity(sculpted.len());
  i = 0usize;
  while i < sculpted.len() {
    offsets.push(*sculpted[i] - *plain3[i]);
    i = i + 1usize;
  }
  var rode = Multires.fromMesh(mr.levels[0usize]);
  rode.addLevel();
  rode.addLevel();
  rode.addLevel();
  rode.detail.set(2usize, copyList3(mr.detail[2usize]));
  rode.setBase(&bentBase.positions);
  var plainBent = Multires.fromMesh(&bentBase);
  plainBent.addLevel();
  plainBent.addLevel();
  plainBent.addLevel();
  var naive = copyPositions(&plainBent.levels[3usize].positions);
  i = 0usize;
  while i < naive.len() {
    naive.set(i, *naive[i] + *offsets[i]);
    i = i + 1usize;
  }
  let naiveMesh = withPos(plainBent.levels[3usize], &naive);
  let gap = distances(&rode.levels[3usize].positions, &naive);
  var gapMax = 0.f;
  i = 0usize;
  while i < gap.len() {
    if *gap[i] > gapMax { gapMax = *gap[i]; }
    i = i + 1usize;
  }
  printStr("bent figure: detail riding vs plain offsets differ by up to "); print <- gapMax; printStr("\n");
  let fit2 = boxOf(&rode.levels[3usize].positions);
  let view2 = new View(0.45, 0.1);
  cv.tile(0, 720, 640, 1440, bg);
  drawMesh(cv, &bentBase, &view2, &fit2, &none, true);
  cv.tile(640, 720, 1280, 1440, bg);
  drawMesh(cv, rode.levels[3usize], &view2, &fit2, &none, false);
  cv.tile(1280, 720, 1920, 1440, bg);
  drawMesh(cv, &naiveMesh, &view2, &fit2, &none, false);
  cv.tile(1920, 720, 2560, 1440, bg);
  drawMesh(cv, rode.levels[3usize], &view2, &fit2, &heatPositive(&gap, gapMax), false);
  worldDetail.len() > 0usize && gapMax > 0.001
}

fn copyList3(src &List[Vec3]) List[Vec3] { copyPositions(src) }

fn operatorSheet(cv &mut Canvas) bool {
  let skinned = skinStandard(&creature());
  printStr("creature base: "); print <- skinned.mesh.vertexCount(); printStr(" vertices, "); print <- skinned.mesh.faceCount(); printStr(" faces\n");
  var mr = Multires.fromMesh(&skinned.mesh);
  mr.addLevel();
  mr.addLevel();
  mr.addLevel();
  let smooth3 = mr.evaluate(3u32);
  let bg = new Vec3(0.96, 0.96, 0.94);
  let none = List[Vec3].empty();
  let view = new View(0.7, 0.2);
  let fit = boxOf(&smooth3.positions);
  cv.tile(0, 0, 640, 720, bg);
  drawMesh(cv, &skinned.mesh, &view, &fit, &none, true);
  cv.tile(640, 0, 1280, 720, bg);
  drawMesh(cv, &smooth3, &view, &fit, &none, false);
  // Scales at level 3
  let sc = scaled(mr.levels[3usize]);
  mr.editLevel(3u32, &sc);
  cv.tile(1280, 0, 1920, 720, bg);
  drawMesh(cv, mr.levels[3usize], &view, &fit, &none, false);
  // A lump pulled at level 1, the scales still on
  var lump = copyPositions(&mr.levels[1usize].positions);
  var v = 0usize;
  while v < lump.len() {
    let p = *lump[v];
    let d = (p - new Vec3(0., 0.72, 0.1)).length();
    if d < 0.35 {
      let w = 1. - d / 0.35;
      lump.set(v, p + new Vec3(0., 0.22 * w * w * (3. - 2. * w), 0.));
    }
    v = v + 1usize;
  }
  var edited = Multires.fromMesh(mr.levels[0usize]);
  edited.addLevel();
  edited.addLevel();
  edited.addLevel();
  edited.detail.set(2usize, copyPositions(mr.detail[2usize]));
  edited.reevaluate(0usize);
  edited.editLevel(1u32, &lump);
  cv.tile(1920, 0, 2560, 720, bg);
  drawMesh(cv, edited.levels[3usize], &view, &fit, &none, false);
  // Rebuilt from the sculpted level 3
  let dense = mr.evaluate(3u32);
  var problems = List[String].empty();
  let back = fromDense(&dense, 3u32, &mut problems);
  let baseGap = maxDistance(&back.levels[0usize].positions, &skinned.mesh.positions);
  printStr("creature: rebuilt from level 3: problems "); print <- problems.len(); printStr(", base differs from the original by up to ");
  print <- baseGap; printStr("; the rebuilt top differs from the dense mesh by up to ");
  print <- maxDistance(&back.levels[3usize].positions, &dense.positions); printStr("; detail RMS by level ");
  print <- detailRms(&back, 1u32); printStr(" ");
  print <- detailRms(&back, 2u32); printStr(" ");
  print <- detailRms(&back, 3u32); printStr("\n");
  cv.tile(0, 720, 640, 1440, bg);
  drawMesh(cv, back.levels[0usize], &view, &fit, &none, true);
  // deleteLower(2): level 2 is the base
  var lower = Multires.fromMesh(mr.levels[0usize]);
  lower.addLevel();
  lower.addLevel();
  lower.addLevel();
  lower.detail.set(2usize, copyPositions(mr.detail[2usize]));
  lower.reevaluate(0usize);
  lower.deleteLower(2u32);
  cv.tile(640, 720, 1280, 1440, bg);
  drawMesh(cv, lower.levels[0usize], &view, &fit, &none, true);
  printStr("deleteLower(2): base now "); print <- lower.levels[0usize].faceCount(); printStr(" faces, levels above "); print <- lower.levelCount(); printStr("\n");
  // bakeDown: level 1 takes the top's own vertices
  var baked = Multires.fromMesh(mr.levels[0usize]);
  baked.addLevel();
  baked.addLevel();
  baked.addLevel();
  baked.detail.set(2usize, copyPositions(mr.detail[2usize]));
  baked.reevaluate(0usize);
  baked.bakeDown();
  cv.tile(1280, 720, 1920, 1440, bg);
  drawMesh(cv, baked.levels[1usize], &view, &fit, &none, true);
  printStr("bakeDown: top moved by "); print <- maxDistance(&baked.levels[3usize].positions, &mr.levels[3usize].positions); printStr("\n");
  // The height between levels 0 and 3
  let disp = mr.displacement(0u32, 3u32);
  let hc = disp.findFloatChannel(VertexDomain, "height");
  var heights = List[f32].empty();
  var lim = 0.001f;
  v = 0usize;
  while v < disp.vertexCount() {
    let h = disp.float(hc, u32.from(v));
    heights.push(h);
    if absf(h) > lim { lim = absf(h); }
    v = v + 1usize;
  }
  printStr("height between levels 0 and 3: greatest "); print <- lim; printStr("\n");
  cv.tile(1920, 720, 2560, 1440, bg);
  drawMesh(cv, &disp, &view, &fit, &heatColours(&heights, lim), false);
  problems.len() == 0usize && maxDistance(&back.levels[3usize].positions, &dense.positions) < 0.0005
}

fn storageSheet(cv &mut Canvas) bool {
  let skinned = skinStandard(&human());
  var mr = Multires.fromMesh(&skinned.mesh);
  mr.addLevel();
  mr.addLevel();
  mr.addLevel();
  let sculpted = bumped(mr.levels[3usize], &humanBumps());
  mr.editLevel(3u32, &sculpted);
  let exact = copyPositions(&mr.levels[3usize].positions);
  let bg = new Vec3(0.96, 0.96, 0.94);
  let none = List[Vec3].empty();
  let view = new View(0.5, 0.05);
  let fit = boxAbove(&exact, 1.64);
  cv.tile(0, 0, 640, 720, bg);
  drawMesh(cv, mr.levels[3usize], &view, &fit, &none, false);
  var ok = true;
  var errs = List[List[f32]].empty();
  var bits = 16u32;
  var col = 1;
  while col < 3 {
    var q = Multires.fromMesh(mr.levels[0usize]);
    q.addLevel();
    q.addLevel();
    q.addLevel();
    q.detail.set(2usize, copyPositions(mr.detail[2usize]));
    q.reevaluate(0usize);
    quantizeDetail(&mut q, bits);
    let worst = maxDistance(&q.levels[3usize].positions, &exact);
    printStr("detail at "); print <- bits; printStr(" bits: "); print <- totalDetailBytes(&q, bits); printStr(" bytes, level 3 off by up to ");
    print <- worst; printStr("\n");
    if bits == 16u32 && worst > 0.0001 { ok = false; }
    let x0 = col * 640;
    cv.tile(x0, 0, x0 + 640, 720, bg);
    drawMesh(cv, q.levels[3usize], &view, &fit, &none, false);
    errs.push(distances(&q.levels[3usize].positions, &exact));
    bits = 8u32;
    col = col + 1;
  }
  // The detail itself, and the errors
  let disp = mr.displacement(2u32, 3u32);
  let hc = disp.findFloatChannel(VertexDomain, "height");
  var heights = List[f32].empty();
  var v = 0usize;
  while v < disp.vertexCount() {
    heights.push(disp.float(hc, u32.from(v)));
    v = v + 1usize;
  }
  cv.tile(1920, 0, 2560, 720, bg);
  drawMesh(cv, &disp, &view, &fit, &heatColours(&heights, 0.02), false);
  var c = 0usize;
  while c < 2usize {
    var lim = 0.0000001f;
    v = 0usize;
    while v < errs[c].len() {
      if *errs[c][v] > lim { lim = *errs[c][v]; }
      v = v + 1usize;
    }
    let x0 = i32.from(c) * 640 + 640;
    cv.tile(x0, 720, x0 + 640, 1440, bg);
    drawMesh(cv, mr.levels[3usize], &view, &fit, &heatPositive(errs[c], lim), false);
    c = c + 1usize;
  }
  cv.tile(0, 720, 640, 1440, bg);
  cv.tile(1920, 720, 2560, 1440, bg);
  ok
}

fn main() i32 {
  let dir = path.Path.from("C:/src/sculptmultires-shots");
  fs.makeDirAll(&dir);
  var ok = timing();
  var cv = Canvas.make(2560, 1440);
  ok = figureSheet(&mut cv) && ok;
  save(&cv, "multires-figure.png");
  ok = operatorSheet(&mut cv) && ok;
  save(&cv, "multires-operators.png");
  ok = storageSheet(&mut cv) && ok;
  save(&cv, "multires-storage.png");
  if ok { 0 } else { 1 }
}
