// The sculpt package's loft and loftAlong, checked with the testing package
// against values worked out by hand; only a failure prints, so lofts.out
// holds the summary alone. Volumes are by the divergence theorem over the
// faces as wound, so a face turned the wrong way would show in the sum.
// Frames F(z) have origin (0, 0, z), normal +x, binormal +y, tangent +z, so
// profile (x, y) goes to (x, y, z) exactly.
//
// - Two equal squares, Profile.rectangle(1, 1) ((-0.5, -0.5) (0.5, -0.5)
//   (0.5, 0.5) (-0.5, 0.5)), in F(0) and F(2), count 0, no rings between,
//   linear, caps: the same points, faces, corner uvs, "along" and "around" as
//   extrude(square, (0, 0, 2), 1, caps), bit for bit: 8 vertices, 12 edges,
//   6 faces, volume 2. The second square given from its third point, or
//   clockwise, is started and turned back to the first's correspondence: the
//   same bits again.
// - loftAlong of the two squares at the ends of Path.line((0,0,0), (0,0,2),
//   1) is sweep(square, path, 0, 1, 1, caps), bit for bit.
// - Counts that differ: the square of side 2 R4 = (-1,-1) (1,-1) (1,1)
//   (-1,1) (fractions 0, 1/4, 1/2, 3/4) in F(0), and in F(2) the same square
//   with its sides' midpoints, 8 points from (0,-1), scaled by 0.5 (side 1).
//   The 8-point one, started at each of its points and sampled 16 times by
//   length, matches R4 exactly (about the centres) from its last point,
//   (-0.5,-0.5), so it is started there: (-0.5,-0.5) (0,-0.5) (0.5,-0.5)
//   (0.5,0) .... The columns are the union of the fractions, j / 8: R4 gains
//   its midpoints, ring 0 column 1 at (0,-1,0) and column 2 its corner
//   (1,-1,0); ring 1 column 1 (0,-0.5,2). 16 vertices, 8 quads and two
//   8-gon caps; the frustum of square ends 4 and 1, height 2: volume
//   (2/3)(4 + 1 + 2) = 14/3.
// - count 8 on R4 alone (two stations F(0), F(1)) samples j / 8 of its
//   length 8: the corners and midpoints, column 1 (0,-1,0); count 6 samples
//   8 j / 6: (-1,-1), (1/3,-1), (1,-1/3), (1,1), (-1/3,1), (-1,1/3), the
//   corner (1,-1) cut.
// - An apex: R4 in F(0) and the one point (0, 0) (closed) in F(1): every
//   column meets at (0, 0, 1); the pyramid of base 4, height 1, volume 4/3.
// - Point to point with fractions that differ: R4 in F(0) and the
//   rectangle 4 x 2 ((-2,-1) (2,-1) (2,1) (-2,1), length 12: fractions 0,
//   1/3, 1/2, 5/6) in F(1), one ring between: shift 0 matches best (cost 4
//   against 28 and 52), so vertex joins vertex. "around" is each ring's own:
//   ring 2's 0, 1/3, 1/2, 5/6, the ring between the blend, 7/24 and 19/24 at
//   columns 1 and 3; corner uvs the same, ring 1's closing corner 1. "along"
//   by the frames' origins: 0, 1/2, 1.
// - Smooth: three squares of half-sides 1, 2, 1 in F(0), F(1), F(2), one
//   ring between. The knots are 0, 1/2, 1, evenly spaced, so the spline is
//   the uniform Catmull-Rom, whose midpoint is (-p0 + 9 p1 + 9 p2 - p3) / 16;
//   the first piece's p0 is the phantom 2 p1 - p2. Column 0's x: p0 = 2(-1)
//   - (-2) = 0, p1 = -1, p2 = -2, p3 = -1: (0 - 9 - 18 + 1) / 16 = -1.625
//   (linear: -1.5); its z: -1, 0, 1, 2 give 0.5. The second piece mirrors
//   it: vertex 12 (-1.625, -1.625, 1.5).
// - loftAlong with fractions 0, 0.25, 1 along the line (0,0,0) to (0,0,4):
//   rings at z = 0, 1, 4, "along" 0, 0.25, 1; with one ring between, rings
//   at z = 0, 0.5, 1, 2.5, 4, along 0, 0.125, 0.25, 0.625, 1.
// - Round a closed path: four squares of side 0.5 spread round
//   Path.circle(2, 8) (k / 4), one ring between: the 8 rings at the path's
//   8 points, 32 vertices, 32 quads, no boundary (a torus, V - E + F = 0),
//   within 0.00001 of sweep(square, circle, 0, 1, 1, false); along r / 8,
//   the closing band's corners at v = 1.

mod lofts;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &[]u8) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn clean(m &PolyMesh, label &[]u8) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &[]u8) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn boundaryEdges(m &PolyMesh) i64 {
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.isBoundaryEdge(e) { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

fn volume(m &PolyMesh) f32 {
  mut sum f32 = 0.;
  mut f = 0usize;
  while f < m.faceCount() {
    imm pts = m.facePositions(u32.from(f));
    mut i = 1usize;
    while i + 1usize < pts.len() {
      sum = sum + pts[0usize].dot(pts[i].cross(*pts[i + 1usize]));
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.;
}

fn frameAt(z f32) Frame {
  new Frame(new Vec3(0., 0., z), new Vec3(0., 0., 1.), new Vec3(1., 0., 0.), new Vec3(0., 1., 0.));
}

fn square(half f32) Profile {Profile.rectangle(2. * half, 2. * half);}

fn floatAt(m &PolyMesh, name &[]u8, v u32) f32 {m.float(m.findFloatChannel(VertexDomain, name), v);}

// Whether two meshes are the same, bit for bit: positions, faces, corner uvs
// and the "along" and "around" channels
fn sameMesh(a &PolyMesh, b &PolyMesh, label &[]u8) {
  mut same = a.vertexCount() == b.vertexCount() and a.faceCount() == b.faceCount()
    and a.halfedgeCount() == b.halfedgeCount();
  mut v = 0usize;
  while same and v < a.vertexCount() {
    imm p = *a.positions[v];
    imm q = *b.positions[v];
    if p.x != q.x or p.y != q.y or p.z != q.z { same = false; }
    if floatAt(a, "along", u32.from(v)) != floatAt(b, "along", u32.from(v)) { same = false; }
    if floatAt(a, "around", u32.from(v)) != floatAt(b, "around", u32.from(v)) { same = false; }
    v = v + 1usize;
  }
  mut f = 0usize;
  imm ua = a.findVec2Channel(CornerDomain, "uv");
  imm ub = b.findVec2Channel(CornerDomain, "uv");
  while same and f < a.faceCount() {
    imm ha = a.faceHalfedges(u32.from(f));
    imm hb = b.faceHalfedges(u32.from(f));
    if ha.len() != hb.len() { same = false; }
    mut k = 0usize;
    while same and k < ha.len() {
      if a.toVertex(*ha[k]) != b.toVertex(*hb[k]) { same = false; }
      imm x = a.vec2(ua, *ha[k]);
      imm y = b.vec2(ub, *hb[k]);
      if x.x != y.x or x.y != y.y { same = false; }
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  expect(same, label);
}

fn uvAt(m &PolyMesh, f u32, v u32) Vec2 {
  imm hs = m.faceHalfedges(f);
  mut i = 0usize;
  while i < hs.len() {
    if m.toVertex(*hs[i]) == v { return m.vec2(m.findVec2Channel(CornerDomain, "uv"), *hs[i]); }
    i = i + 1usize;
  }
  new Vec2(-1., -1.);
}

fn twoFrames(z0 f32, z1 f32) List[Frame] {
  mut fs = List[Frame].empty();
  fs.push(frameAt(z0));
  fs.push(frameAt(z1));
  fs;
}

fn equalSquares() {
  imm sq = square(0.5);
  mut ps = List[Profile].empty();
  ps.push(square(0.5));
  ps.push(square(0.5));
  imm fs = twoFrames(0., 2.);
  imm m = loft(&ps, &fs, 0u32, 0u32, false, true);
  clean(&m, "squares: validates");
  counts(&m, 8, 12, 6, "squares: 8 vertices, 12 edges, 6 faces");
  expectFloat(volume(&m), 2., near, "squares: volume 2");
  imm ex = extrude(&sq, new Vec3(0., 0., 2.), 1u32, true);
  sameMesh(&m, &ex, "squares: the extrusion, bit for bit");

  // The second given from its third point, then clockwise
  imm pts Array[Vec2, 4] = [new Vec2(0.5, 0.5), new Vec2(-0.5, 0.5), new Vec2(-0.5, -0.5), new Vec2(0.5, -0.5)];
  mut ps2 = List[Profile].empty();
  ps2.push(square(0.5));
  ps2.push(Profile.fromPoints(&pts, true));
  imm m2 = loft(&ps2, &fs, 0u32, 0u32, false, true);
  sameMesh(&m2, &ex, "squares: started from the third point, the same bits");
  imm cw Array[Vec2, 4] = [new Vec2(-0.5, -0.5), new Vec2(-0.5, 0.5), new Vec2(0.5, 0.5), new Vec2(0.5, -0.5)];
  mut ps3 = List[Profile].empty();
  ps3.push(square(0.5));
  ps3.push(Profile.fromPoints(&cw, true));
  imm m3 = loft(&ps3, &fs, 0u32, 0u32, false, true);
  sameMesh(&m3, &ex, "squares: clockwise, turned back, the same bits");

  // Along a path: the sweep
  imm path = Path.line(new Vec3(0., 0., 0.), new Vec3(0., 0., 2.), 1u32);
  imm none = List[f32].empty();
  imm la = loftAlong(&ps, &path, none.view(), 0u32, 0u32, false, true);
  imm sw = sweep(&sq, &path, 0., 1., 1., true);
  sameMesh(&la, &sw, "squares along a line: the sweep, bit for bit");
}

fn differentCounts() {
  imm half Array[Vec2, 8] = [new Vec2(0., -0.5), new Vec2(0.5, -0.5), new Vec2(0.5, 0.), new Vec2(0.5, 0.5),
    new Vec2(0., 0.5), new Vec2(-0.5, 0.5), new Vec2(-0.5, 0.), new Vec2(-0.5, -0.5)];
  mut ps = List[Profile].empty();
  ps.push(square(1.));
  ps.push(Profile.fromPoints(&half, true));
  imm fs = twoFrames(0., 2.);
  imm m = loft(&ps, &fs, 0u32, 0u32, false, true);
  clean(&m, "counts differ: validates");
  counts(&m, 16, 24, 10, "counts differ: 16 vertices, 24 edges, 10 faces");
  point(*m.positions[0usize], -1., -1., 0., "counts differ: ring 0 column 0");
  point(*m.positions[1usize], 0., -1., 0., "counts differ: ring 0 gains its midpoint");
  point(*m.positions[2usize], 1., -1., 0., "counts differ: ring 0 keeps its corner");
  point(*m.positions[8usize], -0.5, -0.5, 2., "counts differ: ring 1 started at its last point");
  point(*m.positions[9usize], 0., -0.5, 2., "counts differ: ring 1 column 1");
  expectFloat(volume(&m), 14. / 3., near, "counts differ: the frustum, 14/3");
  expectFloat(floatAt(&m, "around", 1u32), 0.125, near, "counts differ: around of column 1");
  expectInt(i64.from(m.faceDegree(8u32)), 8, "counts differ: an 8-gon cap");

  // Even samples
  mut one = List[Profile].empty();
  one.push(square(1.));
  one.push(square(1.));
  imm fs1 = twoFrames(0., 1.);
  imm e8 = loft(&one, &fs1, 8u32, 0u32, false, false);
  counts(&e8, 16, 24, 8, "count 8: 16 vertices, 8 quads");
  point(*e8.positions[1usize], 0., -1., 0., "count 8: column 1 the midpoint");
  point(*e8.positions[3usize], 1., 0., 0., "count 8: column 3");
  imm e6 = loft(&one, &fs1, 6u32, 0u32, false, false);
  counts(&e6, 12, 18, 6, "count 6: 12 vertices, 6 quads");
  point(*e6.positions[1usize], 1. / 3., -1., 0., "count 6: column 1");
  point(*e6.positions[2usize], 1., -1. / 3., 0., "count 6: column 2, the corner cut");
  point(*e6.positions[3usize], 1., 1., 0., "count 6: column 3");
  point(*e6.positions[4usize], -1. / 3., 1., 0., "count 6: column 4");
  point(*e6.positions[5usize], -1., 1. / 3., 0., "count 6: column 5");

  // An apex
  imm tip Array[Vec2, 1] = [new Vec2(0., 0.)];
  mut pyr = List[Profile].empty();
  pyr.push(square(1.));
  pyr.push(Profile.fromPoints(&tip, true));
  imm p = loft(&pyr, &fs1, 0u32, 0u32, false, true);
  counts(&p, 8, 12, 6, "apex: 8 vertices, 4 quads and 2 caps");
  point(*p.positions[4usize], 0., 0., 1., "apex: ring 1 at the tip");
  point(*p.positions[7usize], 0., 0., 1., "apex: every column at the tip");
  expectFloat(volume(&p), 4. / 3., near, "apex: the pyramid, 4/3");
}

fn ownFractions() {
  mut ps = List[Profile].empty();
  ps.push(square(1.));
  ps.push(Profile.rectangle(4., 2.));
  imm fs = twoFrames(0., 1.);
  imm m = loft(&ps, &fs, 0u32, 1u32, false, false);
  clean(&m, "own fractions: validates");
  counts(&m, 12, 20, 8, "own fractions: 3 rings of 4, 8 quads");
  point(*m.positions[8usize], -2., -1., 1., "own fractions: vertex joins vertex");
  point(*m.positions[5usize], 1.5, -1., 0.5, "own fractions: the ring between");
  expectFloat(floatAt(&m, "around", 9u32), 1. / 3., near, "own fractions: ring 2's around 1/3");
  expectFloat(floatAt(&m, "around", 10u32), 0.5, near, "own fractions: ring 2's around 1/2");
  expectFloat(floatAt(&m, "around", 11u32), 5. / 6., near, "own fractions: ring 2's around 5/6");
  expectFloat(floatAt(&m, "around", 5u32), 7. / 24., near, "own fractions: the ring between, 7/24");
  expectFloat(floatAt(&m, "around", 7u32), 19. / 24., near, "own fractions: the ring between, 19/24");
  expectFloat(floatAt(&m, "along", 0u32), 0., near, "own fractions: along 0");
  expectFloat(floatAt(&m, "along", 4u32), 0.5, near, "own fractions: along 1/2");
  expectFloat(floatAt(&m, "along", 8u32), 1., near, "own fractions: along 1");
  // Face 4 is ring 1 to ring 2 at column 0: (4, 5, 9, 8); face 7 closes ring 1 to 2
  imm uv = uvAt(&m, 4u32, 9u32);
  expectFloat(uv.x, 1. / 3., near, "own fractions: corner uv u at ring 2 column 1");
  expectFloat(uv.y, 1., near, "own fractions: corner uv v at ring 2");
  imm closing = uvAt(&m, 7u32, 4u32);
  expectFloat(closing.x, 1., near, "own fractions: the closing corner's u is 1");
  expectFloat(closing.y, 0.5, near, "own fractions: the closing corner's v");
}

fn smoothStations() {
  mut ps = List[Profile].empty();
  ps.push(square(1.));
  ps.push(square(2.));
  ps.push(square(1.));
  mut fs = List[Frame].empty();
  fs.push(frameAt(0.));
  fs.push(frameAt(1.));
  fs.push(frameAt(2.));
  imm m = loft(&ps, &fs, 0u32, 1u32, true, false);
  clean(&m, "smooth: validates");
  counts(&m, 20, 36, 16, "smooth: 5 rings of 4, 16 quads");
  point(*m.positions[4usize], -1.625, -1.625, 0.5, "smooth: the Catmull-Rom midpoint");
  point(*m.positions[8usize], -2., -2., 1., "smooth: the station kept");
  point(*m.positions[12usize], -1.625, -1.625, 1.5, "smooth: the second piece mirrors it");
  imm lin = loft(&ps, &fs, 0u32, 1u32, false, false);
  point(*lin.positions[4usize], -1.5, -1.5, 0.5, "linear: the midpoint");
}

fn alongPaths() {
  mut ps = List[Profile].empty();
  ps.push(square(1.));
  ps.push(square(1.));
  ps.push(square(1.));
  imm path = Path.line(new Vec3(0., 0., 0.), new Vec3(0., 0., 4.), 4u32);
  imm st Array[f32, 3] = [0., 0.25, 1.];
  imm m = loftAlong(&ps, &path, &st, 0u32, 0u32, false, false);
  counts(&m, 12, 20, 8, "stations: 3 rings, 8 quads");
  point(*m.positions[4usize], -1., -1., 1., "stations: ring 1 at z = 1");
  point(*m.positions[8usize], -1., -1., 4., "stations: ring 2 at z = 4");
  expectFloat(floatAt(&m, "along", 4u32), 0.25, near, "stations: along 0.25");
  imm b = loftAlong(&ps, &path, &st, 0u32, 1u32, false, false);
  counts(&b, 20, 36, 16, "stations, one between: 5 rings");
  point(*b.positions[4usize], -1., -1., 0.5, "stations, one between: ring 1 at z = 0.5");
  point(*b.positions[12usize], -1., -1., 2.5, "stations, one between: ring 3 at z = 2.5");
  expectFloat(floatAt(&b, "along", 4u32), 0.125, near, "stations, one between: along 0.125");
  expectFloat(floatAt(&b, "along", 12u32), 0.625, near, "stations, one between: along 0.625");

  // Round a closed path
  imm circle = Path.circle(2., 8u32);
  mut four = List[Profile].empty();
  mut k = 0usize;
  while k < 4usize {
    four.push(square(0.25));
    k = k + 1usize;
  }
  imm none = List[f32].empty();
  imm t = loftAlong(&four, &circle, none.view(), 0u32, 1u32, false, true);
  clean(&t, "closed path: validates");
  counts(&t, 32, 64, 32, "closed path: 32 vertices, 64 edges, 32 quads");
  expectInt(boundaryEdges(&t), 0, "closed path: no boundary");
  imm sq = square(0.25);
  imm sw = sweep(&sq, &circle, 0., 1., 1., false);
  mut close = sw.vertexCount() == t.vertexCount();
  mut v = 0usize;
  while close and v < t.vertexCount() {
    if t.positions[v].distance(*sw.positions[v]) > 0.00001 { close = false; }
    v = v + 1usize;
  }
  expect(close, "closed path: the sweep round the circle");
  expectFloat(floatAt(&t, "along", 4u32), 0.125, near, "closed path: along of ring 1");
  // Face 28 is the closing band's first quad, (28, 29, 1, 0)
  imm uv = uvAt(&t, 28u32, 0u32);
  expectFloat(uv.y, 1., near, "closed path: the closing corners' v is 1");
}

fn main() i32 {
  equalSquares();
  differentCounts();
  ownFractions();
  smoothStations();
  alongPaths();
  done();
}
