// The sculpt package's blendSeam and booleanUnionBlended, checked with the testing package. Only a failure
// prints, so blendseams.out holds the summary alone. Every mesh must pass validate().
//
// The slab is the box [-2, 2] x [-2, 2] x [-1, 0], the post [-0.5, 0.5] x [-0.5, 0.5] x [0, 2], each a grid of
// quads 0.25 on a side (so a band 0.3 wide is about one edge of the mesh, and the tool says so). Their union has
// volume 18 and a concave square seam of length 4 at z = 0. A fillet in a right-angled corner adds at most
// width^2 / 2 = 0.045 per unit of seam, so at width 0.3 the volume is above 18 and at most 18.18.
//
// - Slab u post, width 0.3: volume in (18, 18.18]; validate empty; every input vertex farther than 0.3 + 0.5 (the
//   band is whole faces, 0.25 across) from the seam is in the result bit for bit; the band's greatest angle
//   between neighbouring faces, and at its outer edge (a band face beside one outside it), the outer one under
//   10 degrees; the fillet's height up the post at the middle of each side agrees across the four sides.
// - A capped 48-gon cylinder of radius 0.5 from z = -0.5 to 2, u the slab, width 0.3: the fillet's foot varies
//   by at most 5% round the cylinder.
// - booleanUnionBlended(slab, post, 0.3) is blendSeam of booleanWith's union (crease marker 2: the inputs carry
//   no crease) and the edges at 2: the same bits.
// - Width 0, and a seam edge out of range: refused, one problem line each; an empty seam is a silent copy.
// - The band at width 0.3 is narrower than two input edges (0.25 and diagonals 0.35): one problem line says so.

mod blendseams;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;
import stdio use *;

let show = true;
let slabWidth = 0.3f32;

// A box lo..hi, a grid of n quads along each axis, outward faces, the points shared
fn gridBox(lo: Vec3, hi: Vec3, nx: u32, ny: u32, nz: u32) PolyMesh {
  let n: Array[u32, 3] = [nx, ny, nz];
  let lov: Array[f32, 3] = [lo.x, lo.y, lo.z];
  let hiv: Array[f32, 3] = [hi.x, hi.y, hi.z];
  var ids = List[u32]();
  let total = usize.from((nx + 1u32) * (ny + 1u32) * (nz + 1u32));
  var i = 0usize;
  while i < total { ids.push(NoIndex); i = i + 1usize; }
  var pts = List[Vec3]();
  var counts = List[u32]();
  var idx = List[u32]();
  var axis = 0u32;
  while axis < 3u32 {
    var s = 0u32;
    while s < 2u32 {
      let b = (axis + 1u32) % 3u32;
      let c = (axis + 2u32) % 3u32;
      var u = 0u32;
      while u < n[usize.from(b)] {
        var v = 0u32;
        while v < n[usize.from(c)] {
          var corner: Array[u32, 4] = [0u32, 0u32, 0u32, 0u32];
          var q = 0usize;
          while q < 4usize {
            let du = if q == 1usize || q == 2usize {1u32} else {0u32};
            let dv = if q >= 2usize {1u32} else {0u32};
            var ijk: Array[u32, 3] = [0u32, 0u32, 0u32];
            ijk[usize.from(axis)] = if s == 0u32 {0u32} else {n[usize.from(axis)]};
            ijk[usize.from(b)] = u + du;
            ijk[usize.from(c)] = v + dv;
            let key = usize.from(ijk[0usize] + (nx + 1u32) * (ijk[1usize] + (ny + 1u32) * ijk[2usize]));
            if *ids[key] == NoIndex {
              ids.set(key, u32.from(pts.len()));
              var xyz: Array[f32, 3] = [0., 0., 0.];
              var a = 0usize;
              while a < 3usize {
                let t = f32.from(ijk[a]) / f32.from(n[a]);
                xyz[a] = lov[a] + (hiv[a] - lov[a]) * t;
                a = a + 1usize;
              }
              pts.push(Vec3(xyz[0usize], xyz[1usize], xyz[2usize]));
            }
            corner[q] = *ids[key];
            q = q + 1usize;
          }
          counts.push(4u32);
          if s == 1u32 {
            idx.push(corner[0usize]); idx.push(corner[1usize]); idx.push(corner[2usize]); idx.push(corner[3usize]);
          } else {
            idx.push(corner[3usize]); idx.push(corner[2usize]); idx.push(corner[1usize]); idx.push(corner[0usize]);
          }
          v = v + 1u32;
        }
        u = u + 1u32;
      }
      s = s + 1u32;
    }
    axis = axis + 1u32;
  }
  var problems = List[String]();
  PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut problems)
}

// A capped cylinder along z, 'sides' round, 'rings' + 1 rings, the caps one polygon each
fn cylinderZ(radius: f32, z0: f32, z1: f32, sides: u32, rings: u32) PolyMesh {
  var pts = List[Vec3]();
  var r = 0u32;
  while r <= rings {
    let z = z0 + (z1 - z0) * f32.from(r) / f32.from(rings);
    var k = 0u32;
    while k < sides {
      let a = 6.2831853 * f32.from(k) / f32.from(sides);
      pts.push(Vec3(radius * a.cos(), radius * a.sin(), z));
      k = k + 1u32;
    }
    r = r + 1u32;
  }
  var counts = List[u32]();
  var idx = List[u32]();
  r = 0u32;
  while r < rings {
    var k = 0u32;
    while k < sides {
      let k1 = (k + 1u32) % sides;
      counts.push(4u32);
      idx.push(r * sides + k); idx.push(r * sides + k1); idx.push((r + 1u32) * sides + k1); idx.push((r + 1u32) * sides + k);
      k = k + 1u32;
    }
    r = r + 1u32;
  }
  counts.push(sides);
  var k = sides;
  while k > 0u32 { k = k - 1u32; idx.push(k); }
  counts.push(sides);
  k = 0u32;
  while k < sides { idx.push(rings * sides + k); k = k + 1u32; }
  var problems = List[String]();
  PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut problems)
}

fn volume(m: &PolyMesh) f64 {
  var sum = 0.0;
  var f = 0usize;
  while f < m.faceCount() {
    let pts = m.facePositions(u32.from(f));
    var i = 1usize;
    while i + 1usize < pts.len() {
      let a = DVec3.from(*pts[0usize]);
      let b = DVec3.from(*pts[i]);
      let c = DVec3.from(*pts[i + 1usize]);
      sum = sum + a.x * (b.y * c.z - b.z * c.y) + a.y * (b.z * c.x - b.x * c.z) + a.z * (b.x * c.y - b.y * c.x);
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.0
}

// The grids: f = 1 is quads of 0.25, f = 5 quads of 0.05
fn slab(f: u32) PolyMesh {gridBox(Vec3(-2., -2., -1.), Vec3(2., 2., 0.), 16u32 * f, 16u32 * f, 4u32 * f)}
fn post(f: u32) PolyMesh {gridBox(Vec3(-0.5, -0.5, 0.), Vec3(0.5, 0.5, 2.), 4u32 * f, 4u32 * f, 8u32 * f)}

fn seamOf(m: &PolyMesh, marker: f32) List[u32] {
  var seam = List[u32]();
  let ch = m.findFloatChannel(EdgeDomain, "crease");
  if ch == NoIndex { return seam; }
  var e = 0usize;
  while e < m.edgeCount() {
    if m.float(ch, u32.from(e)) == marker { seam.push(u32.from(e)); }
    e = e + 1usize;
  }
  seam
}

// Distance from the square loop |x|, |y| = 0.5 at z = 0 (the post's foot)
fn toSquare(p: Vec3) f32 {
  let ax = p.x.abs();
  let ay = p.y.abs();
  if ax <= 0.5 && ay <= 0.5 {
    let d = if 0.5 - ax < 0.5 - ay {0.5 - ax} else {0.5 - ay};
    return (d * d + p.z * p.z).sqrt();
  }
  let ex = if ax > 0.5 {ax - 0.5} else {0.};
  let ey = if ay > 0.5 {ay - 0.5} else {0.};
  (ex * ex + ey * ey + p.z * p.z).sqrt()
}

fn sameBits(a: &PolyMesh, b: &PolyMesh) bool {
  if a.vertexCount() != b.vertexCount() || a.faceCount() != b.faceCount() { return false; }
  var i = 0usize;
  while i < a.vertexCount() {
    let p = *a.positions[i];
    let q = *b.positions[i];
    if p.x != q.x || p.y != q.y || p.z != q.z { return false; }
    i = i + 1usize;
  }
  var f = 0usize;
  while f < a.faceCount() {
    let va = a.faceVertices(u32.from(f));
    let vb = b.faceVertices(u32.from(f));
    if va.len() != vb.len() { return false; }
    var k = 0usize;
    while k < va.len() {
      if *va[k] != *vb[k] { return false; }
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  true
}

// Largest angle (degrees) between the normals of the two faces beside an edge, over the edges where
// 'pick' is 1 (both faces in the band) or 2 (a band face beside one outside it)
fn angles(m: &PolyMesh, bandFaces: &List[u32], pick: u32) f64 {
  var inBand = List[bool]();
  var f = 0usize;
  while f < m.faceCount() { inBand.push(false); f = f + 1usize; }
  var i = 0usize;
  while i < bandFaces.len() { inBand.set(usize.from(*bandFaces[i]), true); i = i + 1usize; }
  var worst = 0.0;
  var count = 0i64;
  var total = 0.0;
  var over5 = 0i64;
  var e = 0usize;
  while e < m.edgeCount() {
    let h0 = m.edgeHalfedge(u32.from(e), 0u32);
    let h1 = m.edgeHalfedge(u32.from(e), 1u32);
    let f0 = *m.hFace[usize.from(h0)];
    let f1 = *m.hFace[usize.from(h1)];
    if f0 != NoIndex && f1 != NoIndex {
      let b0 = *inBand[usize.from(f0)];
      let b1 = *inBand[usize.from(f1)];
      let want = if pick == 1u32 {b0 && b1} else {b0 != b1};
      if want { count = count + 1; }
      if want {
        let n0 = m.faceNormal(f0);
        let n1 = m.faceNormal(f1);
        var c = f64.from(n0.dot(n1));
        if c > 1.0 { c = 1.0; }
        if c < -1.0 { c = -1.0; }
        let a = c.acos() * 57.29577951308232;
        if a > worst { worst = a; }
        total = total + a;
        if a > 5.0 { over5 = over5 + 1; }
      }
    }
    e = e + 1usize;
  }
  if show && count > 0 { print <- "  edges ", count, " mean angle ", total / f64.from(count), " over 5 degrees: ", over5, "\n"; }
  worst
}

// The height up the post of the fillet at the middle of side 's' (0 +x, 1 -x, 2 +y, 3 -y): the mean z of the
// result's vertices lying 0.04 to 0.08 outside that side's wall, within 0.3 of its middle
fn heightAt(m: &PolyMesh, s: u32) f64 {
  var sum = 0.0;
  var n = 0i64;
  var v = 0usize;
  while v < m.vertexCount() {
    let p = *m.positions[v];
    var out = 0.;
    var along = 0.;
    if s == 0u32 { out = p.x - 0.5; along = p.y; }
    else if s == 1u32 { out = -0.5 - p.x; along = p.y; }
    else if s == 2u32 { out = p.y - 0.5; along = p.x; }
    else { out = -0.5 - p.y; along = p.x; }
    if out >= 0.04 && out <= 0.08 && along.abs() <= 0.3 && p.z > 0.0001 {
      sum = sum + f64.from(p.z);
      n = n + 1;
    }
    v = v + 1usize;
  }
  if n == 0 { return -1.0; }
  sum / f64.from(n)
}

fn main() i32 {
  slabAndPost();
  cylinder();
  union();
  refusals();
  done()
}

fn slabAndPost() {
  let a = slab(5u32);
  let b = post(5u32);
  expectFloat(volume(&a), 16.0, 0.0001, "slab volume");
  expectFloat(volume(&b), 2.0, 0.0001, "post volume");
  var problems = List[String]();
  let u = booleanWith(&a, &b, BooleanUnion, 2., &mut problems);
  expectFloat(volume(&u), 18.0, 0.0001, "union volume");
  let seam = seamOf(&u, 2.);
  expect(seam.len() >= 80usize, "the seam has at least its 80 edges of 0.05");
  let r = blendSeam(&u, seam.view(), slabWidth, &mut problems);
  if show { print <- "slab: problems ", problems.len(), "\n"; }
  expectInt(i64.from(problems.len()), 0, "width 0.3 on a 0.05 mesh: no problem line");
  let vol = volume(&r.mesh);
  if show { print <- "slab: volume ", vol, " band faces ", r.faces.len(), " free ", r.vertices.len(), "\n"; }
  expect(vol > 18.0 && vol <= 18.18, "slab and post: volume above 18 and at most 18.18");
  expectInt(i64.from(r.mesh.validate().len()), 0, "slab and post: validate");
  // vertices far from the seam are kept, bit for bit
  var lost = 0i64;
  var checked = 0i64;
  var i = 0usize;
  while i < u.vertexCount() {
    let p = *u.positions[i];
    if toSquare(p) > 0.5 {
      checked = checked + 1;
      var found = false;
      var j = 0usize;
      while j < r.mesh.vertexCount() && !found {
        let q = *r.mesh.positions[j];
        if p.x == q.x && p.y == q.y && p.z == q.z { found = true; }
        j = j + 1usize;
      }
      if !found { lost = lost + 1; }
    }
    i = i + 1usize;
  }
  expectInt(lost, 0, "slab and post: vertices farther than 0.8 are bit for bit");
  expect(checked > 500, "slab and post: many vertices checked");
  let inner = angles(&r.mesh, &r.faces, 1u32);
  let outer = angles(&r.mesh, &r.faces, 2u32);
  if show { print <- "slab: band angle ", inner, " outer edge angle ", outer, "\n"; }
  expect(outer < 10.0, "slab and post: the band's outer edge under 10 degrees");
  var lo = 1000.0;
  var hi = -1000.0;
  var s = 0u32;
  while s < 4u32 {
    let h = heightAt(&r.mesh, s);
    if show { print <- "slab: side ", s, " height ", h, "\n"; }
    if h < lo { lo = h; }
    if h > hi { hi = h; }
    s = s + 1u32;
  }
  expect(lo > 0.0, "slab and post: a fillet at the middle of each side");
  expectFloat(hi - lo, 0.0, 0.001, "slab and post: the four sides' fillet heights agree to 1e-3");
}

fn cylinder() {
  let a = slab(5u32);
  let c = cylinderZ(0.5, -0.5, 2., 48u32, 9u32);
  var problems = List[String]();
  let r = booleanUnionBlended(&a, &c, slabWidth, &mut problems);
  if show {
    print <- "cylinder: result ", r.mesh.vertexCount(), " vertices, band ", r.faces.len(), ", problems ", problems.len(), ", volume ", volume(&r.mesh), "\n";
    var pi = 0usize;
    while pi < problems.len() { print <- "  ", problems[pi].view(), "\n"; pi = pi + 1usize; }
  }
  expectInt(i64.from(r.mesh.validate().len()), 0, "cylinder: validate");
  // the foot per direction: the farthest radius of a vertex above the slab's top, 24 bins
  var foot = List[f64]();
  var bin = 0usize;
  while bin < 24usize { foot.push(0.0); bin = bin + 1usize; }
  var v = 0usize;
  while v < r.mesh.vertexCount() {
    let p = *r.mesh.positions[v];
    let rad = f64.from((p.x * p.x + p.y * p.y).sqrt());
    if p.z > 0.0001 && p.z < 0.3 && rad > 0.5001 && rad < 1.2 {
      var ang = f64.from(atan2(p.y, p.x));
      if ang < 0.0 { ang = ang + 6.283185307179586; }
      var k = usize.from(u32.from(ang / 6.283185307179586 * 24.0));
      if k > 23usize { k = 23usize; }
      if rad > *foot[k] { foot.set(k, rad); }
    }
    v = v + 1usize;
  }
  var lo = 1000.0;
  var hi = 0.0;
  bin = 0usize;
  while bin < 24usize {
    let f = *foot[bin];
    if f < lo { lo = f; }
    if f > hi { hi = f; }
    bin = bin + 1usize;
  }
  if show { print <- "cylinder: foot radius ", lo, " to ", hi, "\n"; }
  expect(lo > 0.5, "cylinder: a fillet in every direction");
  expect(hi / lo <= 1.05, "cylinder: the foot's radius varies by at most 5%");
}

fn union() {
  let a = slab(1u32);
  let b = post(1u32);
  var p1 = List[String]();
  let u = booleanWith(&a, &b, BooleanUnion, 2., &mut p1);
  let seam = seamOf(&u, 2.);
  let viaSeam = blendSeam(&u, seam.view(), slabWidth, &mut p1);
  expectInt(i64.from(p1.len()), 1, "a band under two input edges (0.3 on 0.25): one problem line");
  var p2 = List[String]();
  let direct = booleanUnionBlended(&a, &b, slabWidth, &mut p2);
  expect(sameBits(&viaSeam.mesh, &direct.mesh), "booleanUnionBlended is blendSeam of booleanWith's union and its seam");
  expectInt(i64.from(viaSeam.faces.len()), i64.from(direct.faces.len()), "the same band faces");
  // a crease the inputs already carry is not taken for the seam
  var creased = a.clone();
  let ch = creased.addFloatChannel(EdgeDomain, "crease", 0.);
  creased.setFloat(ch, 0u32, 7.);
  var p3 = List[String]();
  let m = booleanUnionBlended(&creased, &b, slabWidth, &mut p3);
  var kept = false;
  let mc = m.mesh.findFloatChannel(EdgeDomain, "crease");
  var e = 0usize;
  while mc != NoIndex && e < m.mesh.edgeCount() {
    if m.mesh.float(mc, u32.from(e)) == 7. { kept = true; }
    e = e + 1usize;
  }
  expectBool(kept, true, "an input's crease of 7 survives the blend");
}

fn refusals() {
  let a = slab(1u32);
  let b = post(1u32);
  var problems = List[String]();
  let u = booleanWith(&a, &b, BooleanUnion, 2., &mut problems);
  let seam = seamOf(&u, 2.);
  var p = List[String]();
  let z = blendSeam(&u, seam.view(), 0., &mut p);
  expectInt(i64.from(p.len()), 1, "width 0: one problem line");
  expect(sameBits(&z.mesh, &u) && z.faces.len() == 0usize && z.vertices.len() == 0usize, "width 0: an unchanged copy, empty lists");
  var bad = List[u32]();
  bad.push(u32.from(u.edgeCount()));
  var p2 = List[String]();
  let w = blendSeam(&u, bad.view(), 0.3, &mut p2);
  expectInt(i64.from(p2.len()), 1, "a seam edge out of range: one problem line");
  expect(sameBits(&w.mesh, &u) && w.faces.len() == 0usize, "a seam edge out of range: an unchanged copy");
  var p3 = List[String]();
  let none = List[u32]();
  let q = blendSeam(&u, none.view(), 0.3, &mut p3);
  expectInt(i64.from(p3.len()), 0, "an empty seam: silent");
  expect(sameBits(&q.mesh, &u), "an empty seam: a copy");
  var p4 = List[String]();
  let nw = booleanUnionBlended(&a, &b, 0., &mut p4);
  expectInt(i64.from(p4.len()), 1, "booleanUnionBlended width 0: one problem line");
}
