// The sculpt package's face sets (the "face_set" face channel), checked with
// the testing package against values worked out by hand; only a failure
// prints, so facesets.out holds the summary alone.
//
// The grid: 4 x 4 quads of side 1 in y = 0 (5 x 5 vertices, vertex (i, j) at
// (i, 0, j) numbered 5 j + i), face (i, j) numbered 4 j + i, vertex channel
// "h" = x.
// - A mesh with no channel is one set, 1, in every face.
// - Regions: the grid is one set. Two grids joined (not connected) are two
//   sets, 1 for the first, 2 for the second. With the edge channel "seam" at 1
//   on the 4 edges of the line x = 2 (vertices (2, 0) to (2, 4)), the grid is
//   two sets: faces with i < 2 are 1 (face 0 is first), the rest 2.
// - By angle on the cube cage, whose neighbouring faces meet at 90 degrees:
//   within 45 degrees each face is its own set, 6; within 100 degrees one.
//   The cube's face numbering is the cage's: back, front, left, right,
//   bottom, top.
// - By channel: "h" at the faces' mean (the x of the face's centre, i + 0.5)
//   cut at 1 and 3: i = 0 (0.5) is below the first cut, set 1; i = 1 and 2
//   (1.5, 2.5) are between the cuts, set 2; i = 3 (3.5) is above the second,
//   set 3. That is 4, 8 and 4 faces.
// - Assign faces 5 and 6 to set 7; faces of set 7 are then those two. From a
//   mask on the 4 vertices of face 5: strict gives face 5 only; not strict
//   all faces touching them: the 3 x 3 block of faces about vertex (2, 2)'s
//   face... the face (1, 1) has corners (1..2, 1..2); the faces touching any
//   corner are the faces (0..2, 0..2), 9.
// - Grow face 5's set (set 7 over faces 5 and 6): by edge once adds the
//   faces sharing an edge with 5 or 6: face 5 (1, 1) has edge neighbours (0,
//   1), (2, 1), (1, 0), (1, 2) and face 6 (2, 1) has (1, 1), (3, 1), (2, 0),
//   (2, 2): 6 new, 8 in all; by vertex once: the faces touching a vertex of
//   (1, 1) or (2, 1): i from 0 to 3, j from 0 to 2: 12.
// - Shrink: set 7 over (1, 1) and (2, 1) by edge: both touch a face of set 1,
//   so both go to set 1 (the lowest set they touch): none left.
//   A 3 x 1 strip set shrunk once leaves nothing by vertex adjacency, and by
//   edge adjacency too, every face of the strip being next to another set.
// - Renumber: sets 7 and 1 become 2 and 1 in the order of the lowest face.
// - Mask by a face set: the vertices of set 7 (faces (1, 1) and (2, 1)): the 6
//   vertices (1..3, 1..2), strict (on faces of the set only) none, every one of
//   them also on a face of set 1.
// - Every operation keeps the mesh valid.

mod facesets;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

let near = 0.00001d;

fn gridMesh(nx i32, nz i32) PolyMesh {
  var pts = List[Vec3].empty();
  var j = 0;
  while j <= nz {
    var i = 0;
    while i <= nx {
      pts.push(new Vec3(f32.from(i), 0., f32.from(j)));
      i = i + 1;
    }
    j = j + 1;
  }
  var counts = List[u32].empty();
  var idx = List[u32].empty();
  j = 0;
  while j < nz {
    var i = 0;
    while i < nx {
      let v00 = u32.from(j * (nx + 1) + i);
      let v10 = v00 + 1u32;
      let v01 = v00 + u32.from(nx + 1);
      let v11 = v01 + 1u32;
      counts.push(4u32);
      idx.push(v00);
      idx.push(v01);
      idx.push(v11);
      idx.push(v10);
      i = i + 1;
    }
    j = j + 1;
  }
  var problems = List[String].empty();
  var m = PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut problems);
  let h = m.addFloatChannel(VertexDomain, "h", 0.);
  var v = 0usize;
  while v < m.positions.len() {
    m.setFloat(h, u32.from(v), m.positions[v].x);
    v = v + 1usize;
  }
  m
}

fn edgeBetween(m &PolyMesh, a u32, b u32) u32 {
  var e = 0u32;
  while usize.from(e) < m.edgeCount() {
    let p = *m.hVertex[usize.from(2u32 * e)];
    let q = *m.hVertex[usize.from(2u32 * e + 1u32)];
    if (p == a and q == b) or (p == b and q == a) { return e; }
    e = e + 1u32;
  }
  NoIndex
}

fn same(a &List[u32], b &Array[u32], label &Array[u8]) {
  expectInt(i64.from(a.len()), i64.from(b.len), label);
  var i = 0usize;
  while i < a.len() and i < b.len {
    expectInt(i64.from(*a[i]), i64.from(b[i]), label);
    i = i + 1usize;
  }
}

fn countOf(ids &List[u32], id u32) i64 {
  var n = 0i64;
  var i = 0usize;
  while i < ids.len() {
    if *ids[i] == id { n = n + 1i64; }
    i = i + 1usize;
  }
  n
}

fn valid(m &PolyMesh, label &Array[u8]) {
  expectInt(i64.from(m.validate().len()), 0, label);
}

fn making() {
  let g = gridMesh(4, 4);
  let none = faceSetIds(&g);
  expectInt(countOf(&none, 1u32), 16, "no channel: one set, 1");
  let regions = faceSetsFromRegions(&g, "");
  let ids = faceSetIds(&regions);
  expectInt(countOf(&ids, 1u32), 16, "regions: the grid is one set");
  valid(&regions, "regions: valid");

  var parts = List[PolyMesh].empty();
  parts.push(gridMesh(2, 2));
  parts.push(gridMesh(3, 1));
  var problems = List[String].empty();
  let both = join(&parts, &mut problems);
  let bothSets = faceSetIds(&faceSetsFromRegions(&both, ""));
  expectInt(countOf(&bothSets, 1u32), 4, "regions: the first grid is set 1");
  expectInt(countOf(&bothSets, 2u32), 3, "regions: the second is set 2");

  // A seam along x = 2: the edges between vertices (2, j) and (2, j + 1)
  var seamed = withVertexChannel2(&g);
  let seam = seamed.addFloatChannel(EdgeDomain, "seam", 0.);
  var j = 0u32;
  while j < 4u32 {
    seamed.setFloat(seam, edgeBetween(&seamed, 2u32 + 5u32 * j, 2u32 + 5u32 * (j + 1u32)), 1.);
    j = j + 1u32;
  }
  let cut = faceSetIds(&faceSetsFromRegions(&seamed, "seam"));
  expectInt(countOf(&cut, 1u32), 8, "regions with a seam: 8 faces left of it");
  expectInt(countOf(&cut, 2u32), 8, "regions with a seam: 8 right of it");
  expectInt(i64.from(*cut[0usize]), 1, "regions with a seam: face 0 is set 1");
  expectInt(i64.from(*cut[2usize]), 2, "regions with a seam: face (2, 0) is set 2");
  let ignored = faceSetIds(&faceSetsFromRegions(&seamed, "no such channel"));
  expectInt(countOf(&ignored, 1u32), 16, "regions: a barrier channel that is not there cuts nothing");

  let cube = PolyMesh.cube(1.);
  let flat = faceSetIds(&faceSetsByAngle(&cube, radians(45.), ""));
  expectInt(i64.from(flat.len()), 6, "by angle: 6 faces");
  var distinct = 0i64;
  var s = 1u32;
  while s <= 6u32 {
    if countOf(&flat, s) == 1i64 { distinct = distinct + 1i64; }
    s = s + 1u32;
  }
  expectInt(distinct, 6, "by angle: within 45 degrees each cube face is a set");
  let one = faceSetIds(&faceSetsByAngle(&cube, radians(100.), ""));
  expectInt(countOf(&one, 1u32), 6, "by angle: within 100 degrees the cube is one set");

  var cuts = List[f32].empty();
  cuts.push(1.);
  cuts.push(3.);
  let bands = faceSetIds(&faceSetsByChannel(&g, "h", &cuts));
  expectInt(countOf(&bands, 1u32), 4, "by channel: 1 column below 1");
  expectInt(countOf(&bands, 2u32), 8, "by channel: 2 columns between");
  expectInt(countOf(&bands, 3u32), 4, "by channel: 1 column above");
  expectInt(i64.from(*bands[2usize]), 2, "by channel: face (2, 0) is set 2");
  let absent = faceSetsByChannel(&g, "nothing", &cuts);
  valid(&absent, "by channel: a missing channel leaves a valid mesh");

  // Assign
  var two = List[u32].empty();
  two.push(5u32);
  two.push(6u32);
  let assigned = faceSetAssign(&g, &two, 7u32);
  let aids = faceSetIds(&assigned);
  expectInt(countOf(&aids, 7u32), 2, "assign: two faces in set 7");
  expectInt(countOf(&aids, 1u32), 14, "assign: 14 left in set 1");
  let wantFaces Array[u32, 2] = [5u32, 6u32];
  let listed = faceSetFaces(&assigned, 7u32);
  same(&listed, &wantFaces, "assign: faceSetFaces lists them");
  valid(&assigned, "assign: valid");
  expect(assigned.findFloatChannel(VertexDomain, "h") != NoIndex, "assign: keeps the other channels");

  // From a mask: the 4 corners of face 5, vertices (1, 1), (2, 1), (1, 2), (2, 2)
  var corners = List[u32].empty();
  corners.push(6u32);
  corners.push(7u32);
  corners.push(11u32);
  corners.push(12u32);
  let masked = maskByVertices(&g, &corners, MaskReplace);
  let strict = faceSetIds(&faceSetFromMask(&masked, 3u32, 0.5, true));
  expectInt(countOf(&strict, 3u32), 1, "from mask, strict: one face");
  expectInt(i64.from(*strict[5usize]), 3, "from mask, strict: face 5");
  let loose = faceSetIds(&faceSetFromMask(&masked, 3u32, 0.5, false));
  expectInt(countOf(&loose, 3u32), 9, "from mask, any corner: the 9 faces about");
}

// A copy of the mesh (so a test can add channels to it)
fn withVertexChannel2(m &PolyMesh) PolyMesh {
  var copy = maskClear(m);
  copy
}

fn editing() {
  let g = gridMesh(4, 4);
  var two = List[u32].empty();
  two.push(5u32);
  two.push(6u32);
  let sets = faceSetAssign(&g, &two, 7u32);

  let byEdge = faceSetIds(&faceSetGrow(&sets, 7u32, 1u32, AdjEdge));
  expectInt(countOf(&byEdge, 7u32), 8, "grow by edge: 8 faces");
  expectInt(i64.from(*byEdge[4usize]), 7, "grow by edge: (0, 1) joins");
  expectInt(i64.from(*byEdge[0usize]), 1, "grow by edge: (0, 0) does not");
  let byVertex = faceSetIds(&faceSetGrow(&sets, 7u32, 1u32, AdjVertex));
  expectInt(countOf(&byVertex, 7u32), 12, "grow by vertex: 12 faces");
  expectInt(i64.from(*byVertex[0usize]), 7, "grow by vertex: (0, 0) joins");
  let twice = faceSetIds(&faceSetGrow(&sets, 7u32, 2u32, AdjEdge));
  expectInt(countOf(&twice, 7u32), 14, "grow by edge twice: 14 faces (the diamond about both)");
  let none = faceSetIds(&faceSetGrow(&sets, 7u32, 0u32, AdjEdge));
  expectInt(countOf(&none, 7u32), 2, "grow 0 times: unchanged");

  let shrunk = faceSetIds(&faceSetShrink(&sets, 7u32, 1u32, AdjEdge));
  expectInt(countOf(&shrunk, 7u32), 0, "shrink: a 2-face set touches set 1 everywhere");
  expectInt(countOf(&shrunk, 1u32), 16, "shrink: its faces go to set 1");

  // An L of three faces, (0, 0), (1, 0) and (0, 1): by edge only the corner
  // face has all its edge neighbours in the set; by vertex it has (1, 1) out
  var block = List[u32].empty();
  block.push(0u32);
  block.push(1u32);
  block.push(4u32);
  let big = faceSetAssign(&g, &block, 9u32);
  let core = faceSetIds(&faceSetShrink(&big, 9u32, 1u32, AdjEdge));
  expectInt(countOf(&core, 9u32), 1, "shrink by edge: the L leaves its corner face");
  expectInt(i64.from(*core[0usize]), 9, "shrink by edge: it is face 0");
  let core2 = faceSetIds(&faceSetShrink(&big, 9u32, 1u32, AdjVertex));
  expectInt(countOf(&core2, 9u32), 0, "shrink by vertex: the corner face touches (1, 1), outside");

  let renum = faceSetIds(&faceSetRenumber(&sets));
  expectInt(i64.from(*renum[0usize]), 1, "renumber: the first face's set is 1");
  expectInt(i64.from(*renum[5usize]), 2, "renumber: 7 becomes 2");
  expectInt(countOf(&renum, 2u32), 2, "renumber: two faces in it");

  // As a mask
  let vm = maskByFaceSet(&sets, 7u32, false, MaskReplace);
  let vals = maskValues(&vm);
  var n = 0i64;
  var v = 0usize;
  while v < vals.len() {
    if *vals[v] >= 0.5 { n = n + 1i64; }
    v = v + 1usize;
  }
  expectInt(n, 6, "mask by set: the 6 vertices of the two faces");
  let vs = maskByFaceSet(&sets, 7u32, true, MaskReplace);
  let svals = maskValues(&vs);
  var m2 = 0i64;
  v = 0usize;
  while v < svals.len() {
    if *svals[v] >= 0.5 { m2 = m2 + 1i64; }
    v = v + 1usize;
  }
  expectInt(m2, 0, "mask by set, strict: every vertex is also on a face outside");
  valid(&vm, "mask by set: valid");
}

fn main() i32 {
  making();
  editing();
  done()
}
