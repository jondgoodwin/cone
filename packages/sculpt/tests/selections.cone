// The sculpt package's weights by distance (brushWeights, brushDab,
// surfaceDistances, surfaceBrushWeights, softSelect) and the PointGrid under
// them, checked with the testing package against values worked out by hand;
// only a failure prints, so selections.out holds the summary alone.
//
// The flat grid: 9 x 9 quads of side 1 in the plane y = 0, 10 x 10 vertices,
// vertex (i, j) at (i, 0, j), numbered j x 10 + i; the centre is vertex (4, 4),
// number 44.
// - A linear dab at the centre with radius 2: the weight is 1 - distance / 2.
//   A neighbour along an axis (distance 1) weighs 0.5, a diagonal one
//   (sqrt 2) 1 - 0.707107 = 0.292893, a vertex at distance 2 weighs 0, and
//   one at (4 + 2, 4 + 1), distance sqrt 5, is outside.
// - A mask of 1 on vertex 45 (beside the centre) makes its weight 0; of 0.5,
//   half of 0.5. brushDab lists exactly the vertices with weight above 0:
//   the centre, 4 axis neighbours, 4 diagonals, and none at distance 2: 9.
// - The grid's 'within' agrees with a scan: the vertices within 1.5 of the
//   centre are the 9 about it (the diagonals at 1.414 are in; distance 2
//   is not).
// - Distance along a flat surface is the straight line: from vertex 0
//   (0, 0, 0) to vertex (3, 4), number 43, 5, and to (4, 0), number 4, 4. The
//   sweep is within 3 percent of it (first-order fast marching on a square
//   grid), and never shorter.
// - Two grids a tenth apart in y, joined but not connected: the dab at a
//   point on the lower one reaches the upper one in straight-line distance
//   but not along the surface, so the surface dab leaves the upper grid's
//   weights 0 while the straight-line dab gives them weight.
// - A soft selection of vertex 44: it weighs 1 (with any falloff, even a
//   custom one that is 0.5 at the centre); its neighbours as the dab above.
//   By surface, the same on a flat grid (within the sweep's few percent).

mod selections;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

// An nx by nz grid of unit quads in y = 0, facing +y, vertex (i, j) number j (nx + 1) + i
fn grid(nx i32, nz i32, y f32) PolyMesh {
  mut pts = List[Vec3].empty();
  mut j = 0;
  while j <= nz {
    mut i = 0;
    while i <= nx {
      pts.push(new Vec3(f32.from(i), y, f32.from(j)));
      i = i + 1;
    }
    j = j + 1;
  }
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  j = 0;
  while j < nz {
    mut i = 0;
    while i < nx {
      imm v00 = u32.from(j * (nx + 1) + i);
      imm v10 = v00 + 1u32;
      imm v01 = v00 + u32.from(nx + 1);
      imm v11 = v01 + 1u32;
      counts.push(4u32);
      idx.push(v00);
      idx.push(v01);
      idx.push(v11);
      idx.push(v10);
      i = i + 1;
    }
    j = j + 1;
  }
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut problems);
}

fn dabs() {
  imm m = grid(9, 9, 0.);
  imm f = Falloff.preset(FalloffLinear);
  imm centre = new Vec3(4., 0., 4.);
  imm w = brushWeights(&m, centre, 2., &f, "");
  expectInt(i64.from(w.len()), 100, "dab: a weight per vertex");
  expectFloat(f64.from(*w[44usize]), 1., near, "dab: the centre weighs 1");
  expectFloat(f64.from(*w[45usize]), 0.5, near, "dab: an axis neighbour weighs 0.5");
  expectFloat(f64.from(*w[54usize]), 0.5, near, "dab: another axis neighbour weighs 0.5");
  expectFloat(f64.from(*w[55usize]), 0.292893, near, "dab: a diagonal neighbour weighs 0.292893");
  expectFloat(f64.from(*w[46usize]), 0., near, "dab: at the radius weighs 0");
  expectFloat(f64.from(*w[50usize]), 0., near, "dab: outside weighs 0");
  expectFloat(f64.from(*brushWeights(&m, centre, 0., &f, "")[44usize]), 0., near, "dab: a radius of 0 weighs nothing");

  // The mask
  mut one = List[u32].empty();
  one.push(45u32);
  imm masked = maskByVertices(&m, &one, MaskReplace);
  imm wm = brushWeights(&masked, centre, 2., &f, "mask");
  expectFloat(f64.from(*wm[45usize]), 0., near, "mask: a masked vertex weighs 0");
  expectFloat(f64.from(*wm[44usize]), 1., near, "mask: an unmasked vertex is unchanged");
  expectFloat(f64.from(*wm[43usize]), 0.5, near, "mask: the other neighbour is unchanged");
  imm wn = brushWeights(&masked, centre, 2., &f, "no such channel");
  expectFloat(f64.from(*wn[45usize]), 0.5, near, "mask: a name with no channel masks nothing");
  mut vals = maskValues(&masked);
  vals.set(45usize, 0.5);
  imm half = withMaskValues(&masked, &vals);
  expectFloat(f64.from(*brushWeights(&half, centre, 2., &f, "mask")[45usize]), 0.25, near, "mask: 0.5 halves the weight");

  // The sparse dab
  imm grid44 = PointGrid.build(&m.positions, 2.);
  imm dab = brushDab(&m, &grid44, centre, 2., &f, "");
  expectInt(i64.from(dab.vertices.len()), 9, "dab: nine vertices have weight");
  expectInt(i64.from(*dab.vertices[0usize]), 33, "dab: ascending, the first is (3, 3)");
  expectInt(i64.from(*dab.vertices[4usize]), 44, "dab: the middle one is the centre");
  expectFloat(f64.from(*dab.weights[4usize]), 1., near, "dab: and weighs 1");
  imm dabm = brushDab(&masked, &grid44, centre, 2., &f, "mask");
  expectInt(i64.from(dabm.vertices.len()), 8, "dab: a masked vertex is left out");

  // The grid
  imm in15 = grid44.within(centre, 1.5);
  expectInt(i64.from(in15.len()), 9, "grid: nine vertices within 1.5");
  imm in0 = grid44.within(centre, 0.);
  expectInt(i64.from(in0.len()), 1, "grid: radius 0 finds the point itself");
  expectInt(i64.from(grid44.nearestWithin(new Vec3(4.2, 0., 4.1), 1.)), 44, "grid: the nearest to a point");
  expectInt(i64.from(grid44.nearestWithin(new Vec3(40., 0., 4.1), 1.)), i64.from(NoIndex), "grid: none within reach");
  imm big = PointGrid.build(&m.positions, 0.1);
  expectInt(i64.from(big.within(new Vec3(4., 0., 4.), 100.).len()), 100, "grid: a radius much larger than its cells finds all");
}

fn within3(got f32, want f32, label &Array[u8]) {
  expectFloat(f64.from(got), f64.from(want), f64.from(want) * 0.03, label);
  expect(got >= want - 0.00001, label);
}

fn surfaces() {
  imm m = grid(9, 9, 0.);
  mut seeds = List[u32].empty();
  seeds.push(0u32);
  imm none = List[f32].empty();
  imm d = surfaceDistances(&m, &seeds, &none, 100.);
  expectFloat(f64.from(*d[0usize]), 0., near, "surface: a seed is at 0");
  expectFloat(f64.from(*d[4usize]), 4., near, "surface: along an axis is exact");
  within3(*d[43usize], 5., "surface: (3, 4) is 5 away");
  within3(*d[99usize], 12.727922, "surface: the far corner is 12.73 away");
  imm lim = surfaceDistances(&m, &seeds, &none, 3.5);
  expectFloat(f64.from(*lim[3usize]), 3., near, "surface: within the limit is found");
  expect(*lim[4usize] >= SurfaceFar * 0.99, "surface: beyond the limit is SurfaceFar");

  // Seeds with offsets
  mut two = List[u32].empty();
  two.push(0u32);
  two.push(8u32);
  mut off = List[f32].empty();
  off.push(0.);
  off.push(2.);
  imm dd = surfaceDistances(&m, &two, &off, 100.);
  expectFloat(f64.from(*dd[4usize]), 4., near, "surface: the nearer seed wins (4 from vertex 0)");
  expectFloat(f64.from(*dd[8usize]), 2., near, "surface: a seed keeps its offset");
  expectFloat(f64.from(*dd[7usize]), 3., near, "surface: and spreads from it (1 + 2)");

  // Two stacked grids, not connected
  imm lower = grid(9, 9, 0.);
  imm upper = grid(9, 9, 0.1);
  mut parts = List[PolyMesh].empty();
  parts.push(lower);
  parts.push(upper);
  mut problems = List[String].empty();
  imm both = join(&parts, &mut problems);
  expectInt(i64.from(both.vertexCount()), 200, "stack: two grids");
  imm f = Falloff.preset(FalloffLinear);
  imm centre = new Vec3(4., 0., 4.);
  imm euclid = brushWeights(&both, centre, 2., &f, "");
  imm onSurface = surfaceBrushWeightsAt(&both, centre, 2., &f, "");
  expect(*euclid[100usize + 44usize] > 0.9, "stack: straight-line distance reaches the upper grid");
  expectFloat(f64.from(*onSurface[100usize + 44usize]), 0., near, "stack: surface distance does not");
  expectFloat(f64.from(*onSurface[44usize]), 1., near, "stack: the lower grid's centre weighs 1");
  expectFloat(f64.from(*onSurface[45usize]), 0.5, 0.0001d, "stack: and its neighbour 0.5");
  expectFloat(f64.from(*onSurface[55usize]), 0.292893, 0.01d, "stack: and its diagonal about 0.2929");

  // A centre between vertices seeds the ring about it
  imm mid = surfaceBrushWeightsAt(&m, new Vec3(4.5, 0., 4.), 2., &f, "");
  expectFloat(f64.from(*mid[44usize]), 0.75, 0.01d, "surface: a centre at (4.5, 4): vertex 44 is 0.5 away, 0.75");
  expectFloat(f64.from(*mid[45usize]), 0.75, 0.01d, "surface: and vertex 45 as well");
}

fn soft() {
  imm m = grid(9, 9, 0.);
  imm f = Falloff.preset(FalloffLinear);
  mut sel = List[u32].empty();
  sel.push(44u32);
  imm e = softSelect(&m, &sel, 2., &f, SoftEuclidean);
  expectFloat(f64.from(*e[44usize]), 1., near, "soft: the selected vertex weighs 1");
  expectFloat(f64.from(*e[45usize]), 0.5, near, "soft: an axis neighbour 0.5");
  expectFloat(f64.from(*e[55usize]), 0.292893, near, "soft: a diagonal neighbour 0.292893");
  expectFloat(f64.from(*e[46usize]), 0., near, "soft: at the radius 0");
  imm s = softSelect(&m, &sel, 2., &f, SoftSurface);
  expectFloat(f64.from(*s[44usize]), 1., near, "soft surface: the selected vertex weighs 1");
  expectFloat(f64.from(*s[45usize]), 0.5, near, "soft surface: an axis neighbour 0.5");
  expectFloat(f64.from(*s[55usize]), 0.292893, 0.01d, "soft surface: a diagonal neighbour about 0.2929");

  // Two selected vertices: each vertex by its nearest
  sel.push(40u32);
  imm two = softSelect(&m, &sel, 2., &f, SoftEuclidean);
  expectFloat(f64.from(*two[42usize]), 0., near, "soft: vertex 42 is 2 from both selected, at the radius");
  expectFloat(f64.from(*two[41usize]), 0.5, near, "soft: vertex 41 is 1 from 40");
  expectFloat(f64.from(*two[43usize]), 0.5, near, "soft: vertex 43 is 1 from 44");

  // A custom curve that is 0.5 at the centre: the selection itself still weighs 1
  imm pts Array[Vec2, 2] = [new Vec2(0., 0.5), new Vec2(1., 0.)];
  imm cf = Falloff.custom(&pts);
  mut one = List[u32].empty();
  one.push(44u32);
  imm c = softSelect(&m, &one, 2., &cf, SoftEuclidean);
  expectFloat(f64.from(*c[44usize]), 1., near, "soft: a selected vertex weighs 1 whatever the curve");
  expect(*c[45usize] > 0.1 and *c[45usize] < 0.4, "soft: its neighbour follows the custom curve");

  // The mask protects a selected vertex too
  imm masked = maskByVertices(&m, &one, MaskReplace);
  imm wm = softSelectWith(&masked, &one, 2., &f, SoftEuclidean, "mask");
  expectFloat(f64.from(*wm[44usize]), 0., near, "soft: a masked selected vertex weighs 0");
  expectFloat(f64.from(*wm[45usize]), 0.5, near, "soft: and its neighbours are free");

  // As a channel
  imm ch = withSoftSelection(&m, &one, 2., &f, SoftEuclidean, "soft");
  imm cidx = ch.findFloatChannel(VertexDomain, "soft");
  expect(cidx != NoIndex, "soft: the weights are a vertex channel");
  expectFloat(f64.from(ch.float(cidx, 45u32)), 0.5, near, "soft: the channel holds the weights");
  expectInt(i64.from(ch.validate().len()), 0, "soft: the mesh with the channel validates");
}

fn main() i32 {
  dabs();
  surfaces();
  soft();
  done();
}
