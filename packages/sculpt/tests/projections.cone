// The sculpt package's surface queries, shrinkwrap, Project All and data
// transfer, checked with the testing package against values worked out by
// hand; only a failure prints, so projections.out holds the summary alone.
//
// - SurfaceIndex on the cube cage of size 0.5 (a unit cube about the origin):
//   the nearest point to (0.1, 0.2, 2) is (0.1, 0.2, 0.5), 1.5 away, normal
//   +z; with a limit of 1 nothing; the nearest vertex to (0.9, 0.8, 0.7) is
//   (0.5, 0.5, 0.5); a ray from (0.1, 0.2, 3) down -z hits z = 0.5 at 2.5, the
//   same with CullBack, but with CullFront it passes through and hits z = -0.5
//   at 3.5; a ray beside the cube misses; a ray along the quad's diagonal
//   (0, 0, 3) down still hits. Against brute force: 300 points scattered round
//   a subdivided cube, the tree's nearest distance equals the least of
//   'nearestOnTri' over every triangle, and a ray from each point at the
//   centre hits where the brute-force test over every triangle says.
// - Shrinkwrap onto the same cube, from a mesh of three loose vertices: each
//   wrap method with an offset of 0.1 on a point outside (0.1, 0.2, 1.5) and
//   one inside (0.1, 0.2, 0.3): OnSurface z = 0.6 and 0.4, OutsideSurface 0.6
//   and 0.6, InsideSurface 0.4 and 0.4, Outside 1.5 (stays) and 0.6, Inside
//   1.5 -> 0.4 and 0.3 (stays); a point 0.05 outside under Outside goes to
//   0.6; AboveSurface lands 0.1 from the hit, on its smooth normal's side.
//   The weight 0.5 moves half way. Projection along -z, along +z only (the
//   point above misses and stays), along -z only, both ways from the inside
//   (a tie goes forwards), with CullFront (through to the back face); each
//   vertex's own normal onto a sphere keeps the direction. Nearest vertex
//   lands on a cube corner. Target normal from a sphere of radius 2 onto one
//   of radius 1 lands on it, on the radial line. A limit leaves a far vertex
//   where it was. Topology, channels and the vertex count are kept.
// - Project All: a cube cage subdivided once, scaled up to enclose a sphere,
//   laid onto the sphere with a vertex channel "h" = y: every result vertex is
//   on the sphere's surface, "h" is carried (within the facet error of the
//   sphere's y); a distance too short for any hit leaves the cage where it was.
// - Data transfer from the cube with a vertex "h" = y, an edge "e" = its
//   number, a face "id" = its number and a corner "uv" = (x, z) of its vertex,
//   to the same cage scaled by (0.8, 0.9, 0.7): every vertex is nearest the
//   +-y face, so interpolated "h" is +-0.5 and "uv" is each corner's (x, z);
//   nearest vertex gives the corner's h too; "id" at every face is its own
//   number by MapNearest and by MapBestNormal; "e" at every edge is its own
//   number; a reach of 0.01 leaves the channels at their fill; a factor of
//   0.5 into an existing "h" of 1 gives 0.75 where the source is 0.5; a Vec2
//   "h" already in the destination is reported and kept.

mod projections;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

fn absf(a f32) f32 { if a < 0. { -a; } else { a; }; }

fn near(got f32, want f32, tol f32, label &Array[u8]) {
  expect(absf(got - want) <= tol, label);
}

fn pointNear(p Vec3, x f32, y f32, z f32, tol f32, label &Array[u8]) {
  expect(absf(p.x - x) <= tol and absf(p.y - y) <= tol and absf(p.z - z) <= tol, label);
}

fn sphere(r f32, rings u32, steps u32) PolyMesh {
  mut pts = List[Vec2].empty();
  mut i = 0u32;
  while i <= rings {
    imm a = pi * f32.from(i) / f32.from(rings);
    pts.push(new Vec2(r * sin(a), -r * cos(a)));
    i = i + 1u32;
  }
  imm prof = Profile.fromPoints(pts.view(), false);
  lathe(&prof, new Vec3(0., 1., 0.), 2. * pi, steps);
}

// Three loose vertices as one triangle, to be moved
fn tri(a Vec3, b Vec3, c Vec3) PolyMesh {
  mut pts = List[Vec3].empty();
  pts.push(a); pts.push(b); pts.push(c);
  mut counts = List[u32].empty();
  counts.push(3u32);
  mut idx = List[u32].empty();
  idx.push(0u32); idx.push(1u32); idx.push(2u32);
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut problems);
}

fn one(p Vec3) PolyMesh {
  tri(p, p + new Vec3(0.01, 0., 0.), p + new Vec3(0., 0.01, 0.));
}

fn cube() PolyMesh { PolyMesh.cube(0.5); }

fn seed(s &mut u32) f32 {
  *s = *s * 1664525u32 + 1013904223u32;
  f32.from((*s >> 8u32) & 0xFFFFu32) / 65535.;
}

// ---- the queries ----

fn queries() {
  imm c = cube();
  imm idx = SurfaceIndex.of(&c);
  expectInt(i64.from(idx.triangleCount()), 12, "the cube has 12 triangles");
  imm h = idx.nearest(new Vec3(0.1, 0.2, 2.), 0.);
  expect(h.found(), "nearest found");
  pointNear(h.point, 0.1, 0.2, 0.5, 1e-6, "nearest point");
  near(h.distance, 1.5, 1e-5, "nearest distance");
  pointNear(h.normal, 0., 0., 1., 1e-6, "nearest normal is +z");
  expectInt(i64.from(idx.nearest(new Vec3(0.1, 0.2, 2.), 1.).tri), i64.from(NoIndex), "a limit of 1 finds nothing");
  expect(idx.nearest(new Vec3(0.1, 0.2, 2.), 2.).found(), "a limit of 2 finds it");
  imm v = idx.nearestVertex(new Vec3(0.9, 0.8, 0.7), 0.);
  pointNear(v.point, 0.5, 0.5, 0.5, 1e-6, "nearest vertex");
  imm r = idx.ray(new Vec3(0.1, 0.2, 3.), new Vec3(0., 0., -1.), 0., CullNone);
  expect(r.found(), "ray hit");
  pointNear(r.point, 0.1, 0.2, 0.5, 1e-6, "ray point");
  near(r.distance, 2.5, 1e-5, "ray distance");
  imm rb = idx.ray(new Vec3(0.1, 0.2, 3.), new Vec3(0., 0., -1.), 0., CullBack);
  near(rb.distance, 2.5, 1e-5, "CullBack keeps the facing side");
  imm rf = idx.ray(new Vec3(0.1, 0.2, 3.), new Vec3(0., 0., -1.), 0., CullFront);
  near(rf.distance, 3.5, 1e-5, "CullFront passes through to the far side");
  expect(!idx.ray(new Vec3(2., 2., 3.), new Vec3(0., 0., -1.), 0., CullNone).found(), "a ray beside the cube misses");
  expect(idx.ray(new Vec3(0., 0., 3.), new Vec3(0., 0., -1.), 0., CullNone).found(), "a ray through the quad's diagonal hits");
  expect(!idx.ray(new Vec3(0.1, 0.2, 3.), new Vec3(0., 0., -1.), 2., CullNone).found(), "a ray's limit");
  expect(!idx.ray(new Vec3(0.1, 0.2, 3.), new Vec3(0., 0., 0.), 0., CullNone).found(), "a ray of no direction");

  // Brute force over a rounded cube
  imm s = subdivide(&c, 2u32);
  imm sidx = SurfaceIndex.of(&s);
  expectInt(i64.from(sidx.triangleCount()), 192, "96 quads are 192 triangles");
  mut seedv = 12345u32;
  mut badNear = 0i64;
  mut badRay = 0i64;
  mut k = 0;
  while k < 300 {
    imm p = new Vec3(seed(&mut seedv) * 3. - 1.5, seed(&mut seedv) * 3. - 1.5, seed(&mut seedv) * 3. - 1.5);
    imm got = sidx.nearest(p, 0.);
    mut least = 1.0e30;
    mut t = 0usize;
    while t < sidx.triangleCount() {
      imm d = sidx.nearestOnTri(u32.from(t), p).distance;
      if d < least { least = d; }
      t = t + 1usize;
    }
    if absf(got.distance - least) > 1e-6 { badNear = badNear + 1; }
    // Towards the centre: the brute-force first hit
    imm dir = new Vec3(0.02, 0.03, 0.01) - p;
    imm ray = sidx.ray(p, dir, 0., CullNone);
    mut hits = 0i64;
    mut first = 1.0e30;
    t = 0usize;
    while t < sidx.triangleCount() {
      imm rt = sidx.rayOnTri(u32.from(t), p, dir);
      if rt >= 0. { hits = hits + 1; if rt < first { first = rt; } }
      t = t + 1usize;
    }
    if (hits > 0i64) != ray.found() { badRay = badRay + 1; }
    elif ray.found() and absf(ray.distance - first) > 1e-5 { badRay = badRay + 1; }
    k = k + 1;
  }
  expectInt(badNear, 0, "nearest equals brute force");
  expectInt(badRay, 0, "ray equals brute force");
}

// ---- shrinkwrap ----

fn wrapped(p Vec3, s &Shrinkwrap, target &SurfaceIndex) Vec3 {
  imm m = one(p);
  imm r = shrinkwrap(&m, target, s, "");
  *r.positions[0usize];
}

fn wraps() {
  imm c = cube();
  imm idx = SurfaceIndex.of(&c);
  imm out = new Vec3(0.1, 0.2, 1.5);
  imm inside = new Vec3(0.1, 0.2, 0.3);
  mut s = Shrinkwrap.nearestSurface();
  s.offset = 0.1;
  pointNear(wrapped(out, &s, &idx), 0.1, 0.2, 0.6, 1e-5, "OnSurface outside");
  pointNear(wrapped(inside,&s, &idx), 0.1, 0.2, 0.4, 1e-5, "OnSurface inside");
  s.wrap = WrapOutsideSurface;
  pointNear(wrapped(out, &s, &idx), 0.1, 0.2, 0.6, 1e-5, "OutsideSurface outside");
  pointNear(wrapped(inside,&s, &idx), 0.1, 0.2, 0.6, 1e-5, "OutsideSurface inside");
  s.wrap = WrapInsideSurface;
  pointNear(wrapped(out, &s, &idx), 0.1, 0.2, 0.4, 1e-5, "InsideSurface outside");
  pointNear(wrapped(inside,&s, &idx), 0.1, 0.2, 0.4, 1e-5, "InsideSurface inside");
  s.wrap = WrapOutside;
  pointNear(wrapped(out, &s, &idx), 0.1, 0.2, 1.5, 1e-5, "Outside keeps a far point");
  pointNear(wrapped(inside,&s, &idx), 0.1, 0.2, 0.6, 1e-5, "Outside pushes an inside point out");
  pointNear(wrapped(new Vec3(0.1, 0.2, 0.55), &s, &idx), 0.1, 0.2, 0.6, 1e-5, "Outside pushes a near point to the offset");
  s.wrap = WrapInside;
  pointNear(wrapped(out, &s, &idx), 0.1, 0.2, 0.4, 1e-5, "Inside pulls an outside point in");
  pointNear(wrapped(inside,&s, &idx), 0.1, 0.2, 0.3, 1e-5, "Inside keeps a deep point");
  pointNear(wrapped(new Vec3(0.1, 0.2, 0.45), &s, &idx), 0.1, 0.2, 0.4, 1e-5, "Inside pulls a shallow point to the offset");
  s.wrap = WrapAboveSurface;
  imm above = wrapped(out, &s, &idx);
  near((above - new Vec3(0.1, 0.2, 0.5)).length(), 0.1, 1e-5, "AboveSurface is the offset from the hit");
  expect(above.z > 0.55, "AboveSurface is on the outside");

  // The weight
  imm m = tri(out, inside, new Vec3(0.3, 0.1, 1.));
  imm m2 = withChannels(&m);
  imm plain = Shrinkwrap.nearestSurface();
  imm full = shrinkwrap(&m2, &idx, &plain, "");
  imm half = shrinkwrap(&m2, &idx, &plain, "w");
  mut badHalf = 0i64;
  mut v = 0usize;
  while v < 3usize {
    imm want = *m2.positions[v] + (*full.positions[v] - *m2.positions[v]) * 0.5;
    imm got = *half.positions[v];
    if absf(got.x - want.x) > 1e-5 or absf(got.y - want.y) > 1e-5 or absf(got.z - want.z) > 1e-5 { badHalf = badHalf + 1; }
    v = v + 1usize;
  }
  expectInt(badHalf, 0, "the weight moves half way");
  expectInt(i64.from(full.vertexCount()), 3, "shrinkwrap keeps the vertices");
  expectInt(i64.from(full.floats.len()), 2, "shrinkwrap keeps the channels");
  imm cleanup = full.validate();
  expectInt(i64.from(cleanup.len()), 0, "shrinkwrap leaves a valid mesh");

  // A limit
  mut lim = Shrinkwrap.nearestSurface();
  lim.limit = 0.5;
  pointNear(wrapped(out, &lim, &idx), 0.1, 0.2, 1.5, 0., "a far vertex stays beyond the limit");
  pointNear(wrapped(new Vec3(0.1, 0.2, 0.7), &lim, &idx), 0.1, 0.2, 0.5, 1e-5, "a near vertex goes within it");

  // Projection
  imm down = new Vec3(0., 0., -1.);
  mut p = Shrinkwrap.project(down);
  pointNear(wrapped(new Vec3(0.1, 0.2, 3.), &p, &idx), 0.1, 0.2, 0.5, 1e-5, "project down from above");
  pointNear(wrapped(new Vec3(0.1, 0.2, -3.), &p, &idx), 0.1, 0.2, -0.5, 1e-5, "project both ways from below");
  p.negative = false;
  pointNear(wrapped(new Vec3(0.1, 0.2, 3.), &p, &idx), 0.1, 0.2, 0.5, 1e-5, "positive only, towards it");
  pointNear(wrapped(new Vec3(0.1, 0.2, -3.), &p, &idx), 0.1, 0.2, -3., 0., "positive only, away: the vertex stays");
  p.negative = true;
  p.positive = false;
  pointNear(wrapped(new Vec3(0.1, 0.2, 3.), &p, &idx), 0.1, 0.2, 3., 0., "negative only: the vertex above stays");
  pointNear(wrapped(new Vec3(0.1, 0.2, -3.), &p, &idx), 0.1, 0.2, -0.5, 1e-5, "negative only: from below");
  p.positive = true;
  pointNear(wrapped(new Vec3(0.1, 0.2, 0.), &p, &idx), 0.1, 0.2, -0.5, 1e-5, "a tie goes forwards (down)");
  p.cull = CullFront;
  pointNear(wrapped(new Vec3(0.1, 0.2, 3.), &p, &idx), 0.1, 0.2, -0.5, 1e-5, "CullFront passes through to the back");
  p.cull = CullNone;
  p.offset = 0.1;
  pointNear(wrapped(new Vec3(0.1, 0.2, 3.), &p, &idx), 0.1, 0.2, 0.6, 1e-5, "a projection's offset is back towards the vertex");
  imm diag = Shrinkwrap.project(new Vec3(-1., 0., -1.));
  pointNear(wrapped(new Vec3(1.5, 0.2, 1.5), &diag, &idx), 0.5, 0.2, 0.5, 1e-5, "project along a diagonal");

  // Own normals onto a sphere
  imm big = sphere(2., 12u32, 24u32);
  imm small = sphere(1., 24u32, 32u32);
  imm uidx = SurfaceIndex.of(&small);
  imm radial = Shrinkwrap.project(new Vec3(0., 0., 0.));
  imm onto = shrinkwrap(&big, &uidx, &radial, "");
  mut badDir = 0i64;
  mut badOn = 0i64;
  v = 0usize;
  while v < big.vertexCount() {
    imm a = *big.positions[v];
    imm b = *onto.positions[v];
    if b.length() > 1.0001 or b.length() < 0.95 { badOn = badOn + 1; }
    if a.length() > 0.001 and b.length() > 0.001 and a.dot(b) / (a.length() * b.length()) < 0.9999 { badDir = badDir + 1; }
    v = v + 1usize;
  }
  expectInt(badOn, 0, "own normals land on the sphere");
  expectInt(badDir, 0, "own normals keep the direction");

  // Nearest vertex
  imm nv = Shrinkwrap.nearestVertex();
  pointNear(wrapped(new Vec3(0.9, 0.8, 0.7), &nv, &idx), 0.5, 0.5, 0.5, 1e-6, "nearest vertex +++");
  pointNear(wrapped(new Vec3(-0.9, 0.2, -0.7), &nv, &idx), -0.5, 0.5, -0.5, 1e-6, "nearest vertex -+-");

  // Target normal
  imm tnormal = Shrinkwrap.targetNormal();
  imm tn = shrinkwrap(&big, &uidx, &tnormal, "");
  mut badT = 0i64;
  mut badTd = 0i64;
  v = 0usize;
  while v < big.vertexCount() {
    imm a = *big.positions[v];
    imm b = *tn.positions[v];
    if uidx.nearest(b, 0.).distance > 1e-4 { badT = badT + 1; }
    if a.length() > 0.001 and b.length() > 0.001 and a.dot(b) / (a.length() * b.length()) < 0.999 { badTd = badTd + 1; }
    v = v + 1usize;
  }
  expectInt(badT, 0, "target normal lands on the target");
  expectInt(badTd, 0, "target normal on a sphere is radial");
}

// A triangle of three points with a vertex channel "w" of 0.5 and "h" of the vertex's number
fn withChannels(m &PolyMesh) PolyMesh {
  mut r = withPositionsOf(m);
  imm w = r.addFloatChannel(VertexDomain, "w", 1.);
  imm h = r.addFloatChannel(VertexDomain, "h", 0.);
  mut v = 0usize;
  while v < r.vertexCount() {
    r.setFloat(w, u32.from(v), 0.5);
    r.setFloat(h, u32.from(v), f32.from(v));
    v = v + 1usize;
  }
  r;
}

fn withPositionsOf(m &PolyMesh) PolyMesh {
  mut pts = List[Vec3].empty();
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut v = 0usize;
  while v < m.vertexCount() { pts.push(*m.positions[v]); v = v + 1usize; }
  mut f = 0usize;
  while f < m.faceCount() {
    imm vs = m.faceVertices(u32.from(f));
    counts.push(u32.from(vs.len()));
    mut i = 0usize;
    while i < vs.len() { idx.push(*vs[i]); i = i + 1usize; }
    f = f + 1usize;
  }
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut problems);
}

// ---- project all ----

fn projectAllTest() {
  imm target = sphere(1., 24u32, 32u32);
  imm tidx = SurfaceIndex.of(&target);
  // The cage: a cube subdivided once, scaled to enclose the sphere
  imm c0 = cube();
  imm cage0 = subdivide(&c0, 1u32);
  mut cage = withPositionsOf(&cage0);
  mut v = 0usize;
  while v < cage.vertexCount() {
    cage.positions.set(v, *cage.positions[v] * 3.);
    v = v + 1usize;
  }
  // The source's channel: "h" = the vertex's y
  mut src = withPositionsOf(&target);
  imm sh = src.addFloatChannel(VertexDomain, "h", 0.);
  v = 0usize;
  while v < src.vertexCount() {
    src.setFloat(sh, u32.from(v), src.positions[v].y);
    v = v + 1usize;
  }
  imm r = projectAll(&cage, &src, 5.);
  expectInt(i64.from(r.vertexCount()), i64.from(cage.vertexCount()), "project all keeps the vertices");
  expectInt(i64.from(r.faceCount()), i64.from(cage.faceCount()), "project all keeps the faces");
  mut off = 0i64;
  mut badH = 0i64;
  imm rh = r.findFloatChannel(VertexDomain, "h");
  expect(rh != NoIndex, "project all carries the channel");
  v = 0usize;
  while v < r.vertexCount() {
    imm p = *r.positions[v];
    if tidx.nearest(p, 0.).distance > 1e-4 { off = off + 1; }
    if rh != NoIndex and absf(r.float(rh, u32.from(v)) - p.y) > 0.02 { badH = badH + 1; }
    v = v + 1usize;
  }
  expectInt(off, 0, "every vertex is on the source");
  expectInt(badH, 0, "h follows y");
  imm short = projectAll(&cage, &src, 0.01);
  mut stayed = 0i64;
  v = 0usize;
  while v < cage.vertexCount() {
    if (*short.positions[v] - *cage.positions[v]).length() == 0. { stayed = stayed + 1; }
    v = v + 1usize;
  }
  expectInt(stayed, i64.from(cage.vertexCount()), "a short distance leaves the cage");
  imm noch = projectAllWith(&cage, &src, 5., false);
  expectInt(i64.from(noch.floats.len()), 0, "without keepChannels, none");
}

// ---- data transfer ----

fn transfers() {
  mut src = cube();
  imm h = src.addFloatChannel(VertexDomain, "h", 0.);
  imm e = src.addFloatChannel(EdgeDomain, "e", -1.);
  imm id = src.addFloatChannel(FaceDomain, "id", -1.);
  imm uv = src.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  mut v = 0usize;
  while v < src.vertexCount() { src.setFloat(h, u32.from(v), src.positions[v].y); v = v + 1usize; }
  mut k = 0usize;
  while k < src.edgeCount() { src.setFloat(e, u32.from(k), f32.from(k)); k = k + 1usize; }
  k = 0usize;
  while k < src.faceCount() { src.setFloat(id, u32.from(k), f32.from(k)); k = k + 1usize; }
  k = 0usize;
  while k < src.halfedgeCount() {
    if *src.hFace[k] != NoIndex {
      imm p = *src.positions[usize.from(src.toVertex(u32.from(k)))];
      src.setVec2(uv, u32.from(k), new Vec2(p.x, p.z));
    }
    k = k + 1usize;
  }
  mut dst = withPositionsOf(&cube());
  v = 0usize;
  while v < dst.vertexCount() {
    imm p = *dst.positions[v];
    dst.positions.set(v, new Vec3(p.x * 0.8, p.y * 0.9, p.z * 0.7));
    v = v + 1usize;
  }
  mut problems = List[String].empty();
  imm interp = TransferMap.all(MapInterpolated);
  imm r = dataTransfer(&dst, &src, &interp, &mut problems);
  expectInt(i64.from(problems.len()), 0, "no problems");
  imm rh = r.findFloatChannel(VertexDomain, "h");
  imm rid = r.findFloatChannel(FaceDomain, "id");
  imm re = r.findFloatChannel(EdgeDomain, "e");
  imm ruv = r.findVec2Channel(CornerDomain, "uv");
  expect(rh != NoIndex and rid != NoIndex and re != NoIndex and ruv != NoIndex, "all four channels arrive");
  mut badH = 0i64;
  v = 0usize;
  while v < r.vertexCount() {
    imm want = if dst.positions[v].y > 0. { 0.5; } else { -0.5; };
    if absf(r.float(rh, u32.from(v)) - want) > 1e-5 { badH = badH + 1; }
    v = v + 1usize;
  }
  expectInt(badH, 0, "interpolated h is +-0.5");
  mut badUv = 0i64;
  k = 0usize;
  while k < r.halfedgeCount() {
    if *r.hFace[k] != NoIndex {
      imm p = *dst.positions[usize.from(dst.toVertex(u32.from(k)))];
      imm got = r.vec2(ruv, u32.from(k));
      if absf(got.x - p.x) > 1e-5 or absf(got.y - p.z) > 1e-5 { badUv = badUv + 1; }
    }
    k = k + 1usize;
  }
  expectInt(badUv, 0, "interpolated uv is (x, z)");
  mut badId = 0i64;
  k = 0usize;
  while k < r.faceCount() { if r.float(rid, u32.from(k)) != f32.from(k) { badId = badId + 1; } k = k + 1usize; }
  expectInt(badId, 0, "nearest face id is its own number");
  mut badE = 0i64;
  k = 0usize;
  while k < r.edgeCount() { if r.float(re, u32.from(k)) != f32.from(k) { badE = badE + 1; } k = k + 1usize; }
  expectInt(badE, 0, "nearest edge is its own number");

  // Nearest vertex, best normal, projected
  imm nm = new TransferMap(MapNearest, MapNearest, MapBestNormal, MapNearest, 0., 1.);
  imm r2 = dataTransfer(&dst, &src, &nm, &mut problems);
  imm rh2 = r2.findFloatChannel(VertexDomain, "h");
  mut badH2 = 0i64;
  v = 0usize;
  while v < r2.vertexCount() {
    imm want = if dst.positions[v].y > 0. { 0.5; } else { -0.5; };
    if absf(r2.float(rh2, u32.from(v)) - want) > 1e-5 { badH2 = badH2 + 1; }
    v = v + 1usize;
  }
  expectInt(badH2, 0, "nearest vertex h is +-0.5");
  imm rid2 = r2.findFloatChannel(FaceDomain, "id");
  mut badId2 = 0i64;
  k = 0usize;
  while k < r2.faceCount() { if r2.float(rid2, u32.from(k)) != f32.from(k) { badId2 = badId2 + 1; } k = k + 1usize; }
  expectInt(badId2, 0, "best normal face id is its own number");
  imm proj = TransferMap.all(MapProjected);
  imm rpj = dataTransfer(&dst, &src, &proj, &mut problems);
  imm hp = rpj.findFloatChannel(VertexDomain, "h");
  mut badP = 0i64;
  v = 0usize;
  while v < rpj.vertexCount() {
    if absf(rpj.float(hp, u32.from(v))) > 0.5001 { badP = badP + 1; }
    v = v + 1usize;
  }
  expectInt(badP, 0, "projected h stays on the source's range");

  // A reach too short
  imm far = new TransferMap(MapInterpolated, MapInterpolated, MapInterpolated, MapInterpolated, 0.01, 1.);
  imm r3 = dataTransfer(&dst, &src, &far, &mut problems);
  imm rh3 = r3.findFloatChannel(VertexDomain, "h");
  mut atFill = 0i64;
  v = 0usize;
  while v < r3.vertexCount() { if r3.float(rh3, u32.from(v)) == 0. { atFill = atFill + 1; } v = v + 1usize; }
  expectInt(atFill, 8, "beyond the reach, the fill");

  // A factor into an existing channel
  mut dst2 = withPositionsOf(&dst);
  imm dh = dst2.addFloatChannel(VertexDomain, "h", 1.);
  imm mix = new TransferMap(MapInterpolated, MapInterpolated, MapInterpolated, MapInterpolated, 0., 0.5);
  imm r4 = dataTransfer(&dst2, &src, &mix, &mut problems);
  imm rh4 = r4.findFloatChannel(VertexDomain, "h");
  mut badMix = 0i64;
  v = 0usize;
  while v < r4.vertexCount() {
    imm want = if dst2.positions[v].y > 0. { 0.75; } else { 0.25; };
    if absf(r4.float(rh4, u32.from(v)) - want) > 1e-5 { badMix = badMix + 1; }
    v = v + 1usize;
  }
  expectInt(badMix, 0, "a factor mixes with the old value");
  expectInt(i64.from(dst2.floats.len()), 1, "the destination was not changed");

  // Only the named channels; a conflict
  imm names Array[&str, 1] = ["h"];
  imm r5 = dataTransferOnly(&dst, &src, &interp, &names, &mut problems);
  expectInt(i64.from(r5.floats.len()), 1, "only h arrives");
  expectInt(i64.from(r5.vec2s.len()), 0, "no uv arrives");
  mut dst3 = withPositionsOf(&dst);
  dst3.addVec2Channel(VertexDomain, "h", new Vec2(0., 0.));
  mut p3 = List[String].empty();
  imm r6 = dataTransferOnly(&dst3, &src, &interp, &names, &mut p3);
  expectInt(i64.from(p3.len()), 1, "a conflicting type is reported");
  expectInt(i64.from(r6.floats.len()), 0, "and not written");
}

fn main() i32 {
  queries();
  wraps();
  projectAllTest();
  transfers();
  done();
}
