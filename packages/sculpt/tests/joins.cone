// The sculpt package's join, separately made meshes made one, checked with
// the testing package against values worked out by hand; only a failure
// prints, so joins.out holds the summary alone.
//
// Every part here but the last cases is a unit quad from fromPolygons:
// quad(x0) has vertices 0 (x0,0,0), 1 (x0+1,0,0), 2 (x0+1,1,0), 3 (x0,1,0),
// face 0 (0, 1, 2, 3) facing +z; edge e runs from corner e to corner e + 1,
// half-edge 2e along it the face's way (ending at corner e + 1), and the
// face's half-edge is 6, the one ending at corner 0. Joined, part k's vertex v
// is 4k + v, its half-edge h 8k + h (edge e 4k + e), its face k.
//
// - The pair: A = quad(0) with vertex "w" = v + 1, vertex "weight" (fill 1)
//   0.5 on every vertex, edge "crease" 2 on edge 1, corner "uv" (v/4, 0);
//   B = quad(2) with vertex "w" = 10 + v, face "id" 7, corner "uv" (v/4, 1),
//   face Vec3 "color" (fill white) red. Joined: 8 vertices, 8 edges, 2 faces,
//   every edge on the boundary, nothing refused. f32 channels in the order met:
//   A's w, weight, crease, then B's id. w: vertex 2 is 3, vertex 6 B's 12.
//   weight is only A's, so B's vertices take its fill, 1 (a missing weight
//   still means full effect); crease is only A's: B's edge 5 takes 0, A's
//   edge 1 keeps 2; id is only B's: face 0 takes 0, face 1 keeps 7; color is
//   only B's: face 0 takes white (1, 1, 1). Face 1 is (4, 5, 6, 7), its
//   half-edge 8 + 6 = 14; half-edge 8 ends at 4 + 1 = 5. Face 1's corner uv at
//   vertex 6 is B's at 2: (0.5, 1); face 0's at 2 A's, (0.5, 0).
// - Fills that differ: A's weight has fill 1 (values 0.5), B's fill 0.25
//   (its values 0.25), C = quad(4) has none. Joined A, B, C: the first's fill
//   is kept, 1, and C's vertex 9 takes 1, B's vertex 5 keeps 0.25. Joined B, A,
//   C: fill 0.25, and C's vertex 9 takes 0.25.
// - A type clash: A has vertex f32 "w" and corner Vec2 "uv" (fill (0.5,
//   0.5)); B has face Vec2 "w" and corner Vec3 "uv". B's f32 channels come
//   first, then its Vec2s (w: refused as A has it as f32), then its Vec3s
//   (uv: refused as A has it as Vec2): two lines, in that order. The result
//   has A's w and uv only, no Vec3 channel; B's vertices take w's fill 0 and
//   its corners uv's fill (0.5, 0.5).
// - A domain clash: A has vertex "mark" 3, B face "mark" 4: the same name
//   and type in another domain, refused; the result has the vertex mark
//   only, B's vertices 0. And A has edge "crease" 2 on edge 1, B a vertex
//   channel also named "crease" (10 at vertex 0): refused, "part 0 has it
//   per edge"; the result has the edge crease only, B's edges 0 in it.
// - The edge "crease" and the vertex "crease_vert" are two names: A has edge
//   crease (edge 0 is 3) and crease_vert (vertex 0 is 1), B edge crease (edge
//   2 is 4). A, B: nothing refused; B's vertex 4 takes crease_vert's fill 0,
//   B's edge 6 keeps 4. B, A: nothing refused; B's edge crease is met first,
//   A's crease_vert second, B's vertex 0 takes 0 and A's vertex 4 keeps 1.
// - The same bits: a square swept along a bent path ("uv", "along",
//   "around", and an edge crease 2 on edge 3) joined alone, with an empty mesh
//   after it, and with one before it, equals itself exactly: every list,
//   every channel's name, domain, fill and values. Nothing joined is empty, and
//   two empty meshes are.
// - Placed cubes: the cube cage of size 0.5 (volume 1) with corner "uv"
//   (v, f) at vertex v of face f, three times: the first moved by (2, 0, 0),
//   the second by scale (-1, 1, 1) then (-2, 0, 0), a reflection, the third
//   past the end of the places, unplaced. 24 vertices, 36 edges, 18 faces,
//   closed, valid, volume 3 by the divergence theorem (the reflected cube
//   would count -1 if its faces were not turned over). The first's vertex 7
//   (0.5, 0.5, 0.5) is at (2.5, 0.5, 0.5); the reflected cube's vertex 9, the
//   cube's 1 (0.5, -0.5, -0.5), at (-2.5, -0.5, -0.5); the third's vertex 16
//   exactly the cube's 0. The reflected cube's face 6 (the cube's back face,
//   0, 2, 3, 1) is turned over from its first corner, (8, 9, 11, 10), still
//   facing -z, and its corner at vertex 9 keeps uv (1, 0).
// - Join is the array: a unit square extruded 1 along z, joined with itself
//   placed by (0, 0, 2) (the first placed by the identity, so left as it
//   is), gives arrayLinear's two copies 2 apart exactly: the same half-edges,
//   faces and channel values, and the same positions. Bridged between the
//   first's top (from 4) and the second's bottom (from 8), as the bridges
//   test bridges arrayLinear's: 16 vertices, 28 edges, 12 faces, the two
//   outer ends open (8 boundary edges), valid.

mod joins;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn point2(got Vec2, x f32, y f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
}

fn clean(m &PolyMesh, label &Array[u8]) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &Array[u8]) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn boundaryEdges(m &PolyMesh) i64 {
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.isBoundaryEdge(e) { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

// The signed volume, by the divergence theorem over each face's fan
fn volume(m &PolyMesh) f32 {
  mut sum f32 = 0.;
  mut f = 0usize;
  while f < m.faceCount() {
    imm pts = m.facePositions(u32.from(f));
    mut i = 1usize;
    while i + 1usize < pts.len() {
      sum = sum + pts[0usize].dot(pts[i].cross(*pts[i + 1usize]));
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.;
}

// The corner uv of face f at vertex v
fn uvAt(m &PolyMesh, f u32, v u32) Vec2 {
  imm ch = m.findVec2Channel(CornerDomain, "uv");
  imm hs = m.faceHalfedges(f);
  mut i = 0usize;
  while i < hs.len() {
    if m.toVertex(*hs[i]) == v { return m.vec2(ch, *hs[i]); }
    i = i + 1usize;
  }
  new Vec2(-1., -1.);
}

fn floatAt(m &PolyMesh, domain u32, name &Array[u8], e u32) f32 {
  imm ch = m.findFloatChannel(domain, name);
  if ch == NoIndex { return -99.; }
  m.float(ch, e);
}

fn quad(x0 f32) PolyMesh {
  imm pts Array[Vec3, 4] = [new Vec3(x0, 0., 0.), new Vec3(x0 + 1., 0., 0.), new Vec3(x0 + 1., 1., 0.),
    new Vec3(x0, 1., 0.)];
  imm sizes Array[u32, 1] = [4u32];
  imm faces Array[u32, 4] = [0u32, 1u32, 2u32, 3u32];
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(&pts, &sizes, &faces, &mut problems);
}

// Set a corner uv (v / 4, row) at each corner of each face
fn setUvs(m &mut PolyMesh, fill Vec2, row f32) {
  imm uv = m.addVec2Channel(CornerDomain, "uv", fill);
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    imm hs = m.faceHalfedges(f);
    mut i = 0usize;
    while i < hs.len() {
      m.setVec2(uv, *hs[i], new Vec2(f32.from(m.toVertex(*hs[i])) / 4., row));
      i = i + 1usize;
    }
    f = f + 1u32;
  }
}

fn setAll(m &mut PolyMesh, ch u32, n usize, base f32, step f32) {
  mut i = 0usize;
  while i < n {
    m.setFloat(ch, u32.from(i), base + step * f32.from(i));
    i = i + 1usize;
  }
}

fn thePair() {
  mut a = quad(0.);
  imm aw = a.addFloatChannel(VertexDomain, "w", 0.);
  setAll(&mut a, aw, 4usize, 1., 1.);
  imm weight = a.addFloatChannel(VertexDomain, "weight", 1.);
  setAll(&mut a, weight, 4usize, 0.5, 0.);
  imm crease = a.addFloatChannel(EdgeDomain, "crease", 0.);
  a.setFloat(crease, 1u32, 2.);
  setUvs(&mut a, new Vec2(0., 0.), 0.);
  mut b = quad(2.);
  imm bw = b.addFloatChannel(VertexDomain, "w", 0.);
  setAll(&mut b, bw, 4usize, 10., 1.);
  imm id = b.addFloatChannel(FaceDomain, "id", 0.);
  b.setFloat(id, 0u32, 7.);
  setUvs(&mut b, new Vec2(0., 0.), 1.);
  imm color = b.addVec3Channel(FaceDomain, "color", new Vec3(1., 1., 1.));
  b.setVec3(color, 0u32, new Vec3(1., 0., 0.));

  mut parts = List[PolyMesh].empty();
  parts.push(a);
  parts.push(b);
  mut problems = List[String].empty();
  imm m = join(&parts, &mut problems);
  expectInt(i64.from(problems.len()), 0, "pair: nothing refused");
  clean(&m, "pair: validates");
  counts(&m, 8, 8, 2, "pair: 8 vertices, 8 edges, 2 faces");
  expectInt(boundaryEdges(&m), 8, "pair: every edge on the boundary");
  point(*m.positions[4usize], 2., 0., 0., "pair: vertex 4 is B's 0");
  point(*m.positions[6usize], 3., 1., 0., "pair: vertex 6 is B's 2");
  imm vs = m.faceVertices(1u32);
  expectInt(i64.from(vs.len()), 4, "pair: face 1 a quad");
  if vs.len() == 4usize {
    expectInt(i64.from(*vs[0usize]), 4, "pair: face 1 corner 0");
    expectInt(i64.from(*vs[1usize]), 5, "pair: face 1 corner 1");
    expectInt(i64.from(*vs[2usize]), 6, "pair: face 1 corner 2");
    expectInt(i64.from(*vs[3usize]), 7, "pair: face 1 corner 3");
  }
  expectInt(i64.from(m.faceHalfedge(1u32)), 14, "pair: face 1's half-edge 8 + 6");
  expectInt(i64.from(m.toVertex(8u32)), 5, "pair: half-edge 8 ends at 4 + 1");

  expectInt(i64.from(m.floats.len()), 4, "pair: four f32 channels");
  if m.floats.len() == 4usize {
    expectStr(m.floats[0usize].name.view(), "w", "pair: w first");
    expectStr(m.floats[1usize].name.view(), "weight", "pair: weight second");
    expectStr(m.floats[2usize].name.view(), "crease", "pair: crease third");
    expectStr(m.floats[3usize].name.view(), "id", "pair: B's id last");
  }
  expectFloat(floatAt(&m, VertexDomain, "w", 2u32), 3., near, "pair: A's w at 2");
  expectFloat(floatAt(&m, VertexDomain, "w", 6u32), 12., near, "pair: B's w at 6");
  expectFloat(floatAt(&m, VertexDomain, "weight", 1u32), 0.5, near, "pair: A's weight");
  expectFloat(floatAt(&m, VertexDomain, "weight", 5u32), 1., near, "pair: B's vertices take weight's fill 1");
  imm wch = m.findFloatChannel(VertexDomain, "weight");
  expectFloat(m.floats[usize.from(wch)].fill, 1., near, "pair: weight keeps its fill");
  expectFloat(floatAt(&m, EdgeDomain, "crease", 1u32), 2., near, "pair: A's edge 1 keeps its crease");
  expectFloat(floatAt(&m, EdgeDomain, "crease", 5u32), 0., near, "pair: B's edge 5 takes crease's fill 0");
  expectFloat(floatAt(&m, FaceDomain, "id", 0u32), 0., near, "pair: A's face takes id's fill 0");
  expectFloat(floatAt(&m, FaceDomain, "id", 1u32), 7., near, "pair: B's face keeps its id");
  imm cch = m.findVec3Channel(FaceDomain, "color");
  require(cch != NoIndex, "pair: color carried");
  point(m.vec3(cch, 0u32), 1., 1., 1., "pair: A's face takes color's fill, white");
  point(m.vec3(cch, 1u32), 1., 0., 0., "pair: B's face keeps red");
  point(m.vec3s[usize.from(cch)].fill, 1., 1., 1., "pair: color keeps its fill");
  point2(uvAt(&m, 1u32, 6u32), 0.5, 1., "pair: face 1's uv at 6 is B's at 2");
  point2(uvAt(&m, 0u32, 2u32), 0.5, 0., "pair: face 0's uv at 2 is A's");
}

fn weighted(fill f32, value f32) PolyMesh {
  mut m = quad(0.);
  imm ch = m.addFloatChannel(VertexDomain, "weight", fill);
  setAll(&mut m, ch, 4usize, value, 0.);
  m;
}

fn fills() {
  mut parts = List[PolyMesh].empty();
  parts.push(weighted(1., 0.5));
  parts.push(weighted(0.25, 0.25));
  parts.push(quad(4.));
  mut problems = List[String].empty();
  imm m = join(&parts, &mut problems);
  expectInt(i64.from(problems.len()), 0, "fills: nothing refused");
  imm ch = m.findFloatChannel(VertexDomain, "weight");
  require(ch != NoIndex, "fills: weight carried");
  expectFloat(m.floats[usize.from(ch)].fill, 1., near, "fills: the first part's fill kept");
  expectFloat(m.float(ch, 5u32), 0.25, near, "fills: B's vertex keeps 0.25");
  expectFloat(m.float(ch, 9u32), 1., near, "fills: C's vertex takes the first's fill");

  mut back = List[PolyMesh].empty();
  back.push(weighted(0.25, 0.25));
  back.push(weighted(1., 0.5));
  back.push(quad(4.));
  imm n = join(&back, &mut problems);
  imm nch = n.findFloatChannel(VertexDomain, "weight");
  expectFloat(n.floats[usize.from(nch)].fill, 0.25, near, "fills: B first, its fill kept");
  expectFloat(n.float(nch, 9u32), 0.25, near, "fills: C's vertex takes 0.25");
  expectFloat(n.float(nch, 5u32), 0.5, near, "fills: A's vertex keeps 0.5");
}

fn typeClash() {
  mut a = quad(0.);
  imm aw = a.addFloatChannel(VertexDomain, "w", 0.);
  setAll(&mut a, aw, 4usize, 1., 1.);
  setUvs(&mut a, new Vec2(0.5, 0.5), 0.);
  mut b = quad(2.);
  b.addVec2Channel(FaceDomain, "w", new Vec2(3., 3.));
  b.addVec3Channel(CornerDomain, "uv", new Vec3(9., 9., 9.));
  mut parts = List[PolyMesh].empty();
  parts.push(a);
  parts.push(b);
  mut problems = List[String].empty();
  imm m = join(&parts, &mut problems);
  expectInt(i64.from(problems.len()), 2, "type clash: two refused");
  if problems.len() == 2usize {
    expectStr(problems[0usize].view(), "part 1's channel w (Vec2, face) is left out: part 0 has it as f32",
      "type clash: w's line");
    expectStr(problems[1usize].view(), "part 1's channel uv (Vec3, corner) is left out: part 0 has it as Vec2",
      "type clash: uv's line");
  }
  clean(&m, "type clash: validates");
  expectInt(i64.from(m.floats.len()), 1, "type clash: one f32 channel");
  expectInt(i64.from(m.vec2s.len()), 1, "type clash: one Vec2 channel, A's uv");
  expectInt(i64.from(m.vec3s.len()), 0, "type clash: no Vec3 channel");
  expectFloat(floatAt(&m, VertexDomain, "w", 5u32), 0., near, "type clash: B's vertex takes w's fill");
  point2(uvAt(&m, 1u32, 5u32), 0.5, 0.5, "type clash: B's corner takes uv's fill");
  point2(uvAt(&m, 0u32, 1u32), 0.25, 0., "type clash: A's corner keeps its uv");
}

fn domainClash() {
  mut a = quad(0.);
  imm am = a.addFloatChannel(VertexDomain, "mark", 0.);
  setAll(&mut a, am, 4usize, 3., 0.);
  mut b = quad(2.);
  imm bm = b.addFloatChannel(FaceDomain, "mark", 0.);
  b.setFloat(bm, 0u32, 4.);
  mut parts = List[PolyMesh].empty();
  parts.push(a);
  parts.push(b);
  mut problems = List[String].empty();
  imm m = join(&parts, &mut problems);
  expectInt(i64.from(problems.len()), 1, "domain clash: one refused");
  if problems.len() == 1usize {
    expectStr(problems[0usize].view(),
      "part 1's channel mark (f32, face) is left out: part 0 has it per vertex",
      "domain clash: the line");
  }
  expectInt(i64.from(m.floats.len()), 1, "domain clash: one channel");
  expectInt(i64.from(m.findFloatChannel(FaceDomain, "mark")), i64.from(NoIndex), "domain clash: no face mark");
  expectFloat(floatAt(&m, VertexDomain, "mark", 1u32), 3., near, "domain clash: A's vertex keeps 3");
  expectFloat(floatAt(&m, VertexDomain, "mark", 5u32), 0., near, "domain clash: B's vertex takes 0");

  // A vertex channel named "crease" against an edge crease
  mut c = quad(0.);
  imm ce = c.addFloatChannel(EdgeDomain, "crease", 0.);
  c.setFloat(ce, 1u32, 2.);
  mut d = quad(2.);
  imm dv = d.addFloatChannel(VertexDomain, "crease", 0.);
  d.setFloat(dv, 0u32, 10.);
  mut cd = List[PolyMesh].empty();
  cd.push(c);
  cd.push(d);
  mut lines = List[String].empty();
  imm n = join(&cd, &mut lines);
  expectInt(i64.from(lines.len()), 1, "crease per vertex: refused");
  if lines.len() == 1usize {
    expectStr(lines[0usize].view(), "part 1's channel crease (f32, vertex) is left out: part 0 has it per edge",
      "crease per vertex: the line");
  }
  expectInt(i64.from(n.floats.len()), 1, "crease per vertex: the edge crease only");
  expectInt(i64.from(n.findFloatChannel(VertexDomain, "crease")), i64.from(NoIndex),
    "crease per vertex: no vertex crease");
  expectFloat(floatAt(&n, EdgeDomain, "crease", 1u32), 2., near, "crease per vertex: A's edge 1 keeps 2");
  expectFloat(floatAt(&n, EdgeDomain, "crease", 5u32), 0., near, "crease per vertex: B's edge 5 takes 0");
}

fn creasedBoth() PolyMesh {
  mut a = quad(0.);
  imm e = a.addFloatChannel(EdgeDomain, "crease", 0.);
  a.setFloat(e, 0u32, 3.);
  imm v = a.addFloatChannel(VertexDomain, "crease_vert", 0.);
  a.setFloat(v, 0u32, 1.);
  a;
}

fn creasedEdge() PolyMesh {
  mut b = quad(2.);
  imm e = b.addFloatChannel(EdgeDomain, "crease", 0.);
  b.setFloat(e, 2u32, 4.);
  b;
}

fn twoDomains() {
  mut parts = List[PolyMesh].empty();
  parts.push(creasedBoth());
  parts.push(creasedEdge());
  mut problems = List[String].empty();
  imm m = join(&parts, &mut problems);
  expectInt(i64.from(problems.len()), 0, "two crease names: nothing refused");
  expectInt(i64.from(m.floats.len()), 2, "two crease names: two channels");
  expectFloat(floatAt(&m, VertexDomain, "crease_vert", 0u32), 1., near, "two crease names: A's vertex crease");
  expectFloat(floatAt(&m, VertexDomain, "crease_vert", 4u32), 0., near, "two crease names: B's vertex takes 0");
  expectFloat(floatAt(&m, EdgeDomain, "crease", 0u32), 3., near, "two crease names: A's edge 0");
  expectFloat(floatAt(&m, EdgeDomain, "crease", 6u32), 4., near, "two crease names: B's edge 2 is 6");

  mut back = List[PolyMesh].empty();
  back.push(creasedEdge());
  back.push(creasedBoth());
  imm n = join(&back, &mut problems);
  expectInt(i64.from(problems.len()), 0, "crease, edge first: nothing refused");
  expectInt(i64.from(n.floats.len()), 2, "crease, edge first: two channels");
  if n.floats.len() == 2usize {
    expectInt(i64.from(n.floats[0usize].domain), i64.from(EdgeDomain), "crease, edge first: the edge's first");
    expectInt(i64.from(n.floats[1usize].domain), i64.from(VertexDomain), "crease, edge first: the vertex's second");
  }
  expectFloat(floatAt(&n, VertexDomain, "crease_vert", 0u32), 0., near, "crease, edge first: B's vertex takes 0");
  expectFloat(floatAt(&n, VertexDomain, "crease_vert", 4u32), 1., near, "crease, edge first: A's vertex keeps 1");
  expectFloat(floatAt(&n, EdgeDomain, "crease", 2u32), 4., near, "crease, edge first: B's edge 2");
  expectFloat(floatAt(&n, EdgeDomain, "crease", 4u32), 3., near, "crease, edge first: A's edge 0 is 4");
}

// -------- exact comparison --------

fn sameU32s(a &List[u32], b &List[u32]) bool {
  if a.len() != b.len() { return false; }
  mut i = 0usize;
  while i < a.len() {
    if *a[i] != *b[i] { return false; }
    i = i + 1usize;
  }
  true;
}

fn sameVec3s(a &List[Vec3], b &List[Vec3]) bool {
  if a.len() != b.len() { return false; }
  mut i = 0usize;
  while i < a.len() {
    if a[i].x != b[i].x or a[i].y != b[i].y or a[i].z != b[i].z { return false; }
    i = i + 1usize;
  }
  true;
}

// Whether two meshes are the same exactly: every list, and every channel's
// name, domain, fill and values, in order
fn sameMesh(a &PolyMesh, b &PolyMesh) bool {
  if !sameVec3s(&a.positions, &b.positions) { return false; }
  if !sameU32s(&a.vHalfedge, &b.vHalfedge) or !sameU32s(&a.hNext, &b.hNext) or !sameU32s(&a.hPrev, &b.hPrev) {
    return false;
  }
  if !sameU32s(&a.hVertex, &b.hVertex) or !sameU32s(&a.hFace, &b.hFace) or !sameU32s(&a.fHalfedge, &b.fHalfedge) {
    return false;
  }
  if a.floats.len() != b.floats.len() or a.vec2s.len() != b.vec2s.len() or a.vec3s.len() != b.vec3s.len() {
    return false;
  }
  mut c = 0usize;
  while c < a.floats.len() {
    if !a.floats[c].name.equals(b.floats[c].name.view()) or a.floats[c].domain != b.floats[c].domain
      or a.floats[c].fill != b.floats[c].fill or a.floats[c].values.len() != b.floats[c].values.len() {
      return false;
    }
    mut i = 0usize;
    while i < a.floats[c].values.len() {
      if a.float(u32.from(c), u32.from(i)) != b.float(u32.from(c), u32.from(i)) { return false; }
      i = i + 1usize;
    }
    c = c + 1usize;
  }
  c = 0usize;
  while c < a.vec2s.len() {
    if !a.vec2s[c].name.equals(b.vec2s[c].name.view()) or a.vec2s[c].domain != b.vec2s[c].domain
      or a.vec2s[c].fill.x != b.vec2s[c].fill.x or a.vec2s[c].fill.y != b.vec2s[c].fill.y
      or a.vec2s[c].values.len() != b.vec2s[c].values.len() {
      return false;
    }
    mut i = 0usize;
    while i < a.vec2s[c].values.len() {
      imm p = a.vec2(u32.from(c), u32.from(i));
      imm q = b.vec2(u32.from(c), u32.from(i));
      if p.x != q.x or p.y != q.y { return false; }
      i = i + 1usize;
    }
    c = c + 1usize;
  }
  c = 0usize;
  while c < a.vec3s.len() {
    if !a.vec3s[c].name.equals(b.vec3s[c].name.view()) or a.vec3s[c].domain != b.vec3s[c].domain
      or a.vec3s[c].values.len() != b.vec3s[c].values.len() {
      return false;
    }
    mut i = 0usize;
    while i < a.vec3s[c].values.len() {
      imm p = a.vec3(u32.from(c), u32.from(i));
      imm q = b.vec3(u32.from(c), u32.from(i));
      if p.x != q.x or p.y != q.y or p.z != q.z { return false; }
      i = i + 1usize;
    }
    c = c + 1usize;
  }
  true;
}

fn swept() PolyMesh {
  imm sq = Profile.rectangle(1., 1.);
  imm pts Array[Vec3, 3] = [new Vec3(0., 0., 0.), new Vec3(0., 0., 2.), new Vec3(1., 0., 3.)];
  imm path = Path.fromPoints(&pts, false);
  mut m = sweep(&sq, &path, 0., 1., 1., true);
  imm ch = m.addFloatChannel(EdgeDomain, "crease", 0.);
  m.setFloat(ch, 3u32, 2.);
  m;
}

fn sameBits() {
  imm s = swept();
  mut problems = List[String].empty();
  mut alone = List[PolyMesh].empty();
  alone.push(swept());
  imm a = join(&alone, &mut problems);
  expect(sameMesh(&a, &s), "same bits: a mesh joined alone");
  mut after = List[PolyMesh].empty();
  after.push(swept());
  after.push(PolyMesh.empty());
  imm b = join(&after, &mut problems);
  expect(sameMesh(&b, &s), "same bits: with an empty mesh after it");
  mut before = List[PolyMesh].empty();
  before.push(PolyMesh.empty());
  before.push(swept());
  imm c = join(&before, &mut problems);
  expect(sameMesh(&c, &s), "same bits: with an empty mesh before it");
  expectInt(i64.from(problems.len()), 0, "same bits: nothing refused");
  expect(s.floats.len() == 3usize and s.vec2s.len() == 1usize, "same bits: along, around, crease and uv there");

  imm none = List[PolyMesh].empty();
  imm d = join(&none, &mut problems);
  expect(sameMesh(&d, &PolyMesh.empty()), "same bits: nothing joined is empty");
  mut empties = List[PolyMesh].empty();
  empties.push(PolyMesh.empty());
  empties.push(PolyMesh.empty());
  imm e = join(&empties, &mut problems);
  expect(sameMesh(&e, &PolyMesh.empty()), "same bits: two empty meshes are empty");
}

fn uvCube() PolyMesh {
  mut c = PolyMesh.cube(0.5);
  imm uv = c.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  mut f = 0u32;
  while usize.from(f) < c.faceCount() {
    imm hs = c.faceHalfedges(f);
    mut i = 0usize;
    while i < hs.len() {
      c.setVec2(uv, *hs[i], new Vec2(f32.from(c.toVertex(*hs[i])), f32.from(f)));
      i = i + 1usize;
    }
    f = f + 1u32;
  }
  c;
}

fn placedCubes() {
  mut parts = List[PolyMesh].empty();
  parts.push(uvCube());
  parts.push(uvCube());
  parts.push(uvCube());
  mut places = List[Transform3].empty();
  places.push(new Transform3(new Vec3(2., 0., 0.), Quat.identity(), new Vec3(1., 1., 1.)));
  places.push(new Transform3(new Vec3(-2., 0., 0.), Quat.identity(), new Vec3(-1., 1., 1.)));
  mut problems = List[String].empty();
  imm m = joinPlaced(&parts, &places, &mut problems);
  clean(&m, "cubes: validates");
  counts(&m, 24, 36, 18, "cubes: 24 vertices, 36 edges, 18 faces");
  expectInt(boundaryEdges(&m), 0, "cubes: closed");
  expectFloat(volume(&m), 3., near, "cubes: volume 3, every face outward");
  point(*m.positions[7usize], 2.5, 0.5, 0.5, "cubes: the first moved by (2, 0, 0)");
  point(*m.positions[9usize], -2.5, -0.5, -0.5, "cubes: the reflected cube's vertex 9");
  imm cube = PolyMesh.cube(0.5);
  imm p = *m.positions[16usize];
  imm q = *cube.positions[0usize];
  expect(p.x == q.x and p.y == q.y and p.z == q.z, "cubes: the third unplaced, exactly");
  imm vs = m.faceVertices(6u32);
  expectInt(i64.from(vs.len()), 4, "cubes: face 6 a quad");
  if vs.len() == 4usize {
    expectInt(i64.from(*vs[0usize]), 8, "cubes: face 6 keeps its first corner");
    expectInt(i64.from(*vs[1usize]), 9, "cubes: face 6 corner 1");
    expectInt(i64.from(*vs[2usize]), 11, "cubes: face 6 corner 2");
    expectInt(i64.from(*vs[3usize]), 10, "cubes: face 6 corner 3");
  }
  point(m.faceNormal(6u32), 0., 0., -1., "cubes: face 6 still faces -z");
  point2(uvAt(&m, 6u32, 9u32), 1., 0., "cubes: the reflected corner keeps its uv");
  point2(uvAt(&m, 6u32, 8u32), 0., 0., "cubes: and its first corner its own");
}

fn isTheArray() {
  imm sq = Profile.rectangle(1., 1.);
  imm t = extrude(&sq, new Vec3(0., 0., 1.), 1u32, false);
  imm arr = arrayLinear(&t, 2u32, new Vec3(0., 0., 2.), -1.);
  mut parts = List[PolyMesh].empty();
  parts.push(extrude(&sq, new Vec3(0., 0., 1.), 1u32, false));
  parts.push(extrude(&sq, new Vec3(0., 0., 1.), 1u32, false));
  mut places = List[Transform3].empty();
  places.push(Transform3.identity());
  places.push(new Transform3(new Vec3(0., 0., 2.), Quat.identity(), new Vec3(1., 1., 1.)));
  mut problems = List[String].empty();
  imm j = joinPlaced(&parts, &places, &mut problems);
  expect(sameMesh(&j, &arr), "array: join gives arrayLinear's copies exactly");

  imm pair Array[u32, 2] = [4u32, 8u32];
  imm m = bridgeLoops(&j, &pair, 0u32, 0.);
  clean(&m, "array: the bridge validates");
  counts(&m, 16, 28, 12, "array: 16 vertices, 28 edges, 12 faces");
  expectInt(boundaryEdges(&m), 8, "array: the two outer ends open");
}

fn main() i32 {
  thePair();
  fills();
  typeClash();
  domainClash();
  twoDomains();
  sameBits();
  placedCubes();
  isTheArray();
  done();
}
