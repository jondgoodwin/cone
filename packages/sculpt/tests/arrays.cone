// The sculpt package's arrays, linear, radial and along a path, checked with
// the testing package against values worked out by hand; only a failure
// prints, so arrays.out holds the summary alone.
//
// - The tile: vertices 0 (0,0,0), 1 (1,0,0), 2 (1,1,0), 3 (0,1,0), one face
//   (0, 1, 2, 3) facing +z. Its channels: vertex "w" = v; face "id" 7; edge
//   "crease" 2 on edge 1-2; corner "uv" the corner's (x, y).
// - Linear, 3 copies, offset (1, 0, 0), no merging: copy k's vertex v is
//   4k + v, moved by k: 12 vertices, 12 edges, 3 faces; vertex 5 (copy 1's
//   1) at (2, 0, 0), vertex 10 (copy 2's 2) at (3, 1, 0); face 2 is (8, 9,
//   10, 11), facing +z. Every copy keeps the channels: vertex 10's w is 2,
//   face 2's id 7, and three edges have crease 2 (1-2, 5-6, 9-10).
// - The same merged at 0.001: copy 1's 4 and 7 lie on copy 0's 1 and 2, and
//   copy 2's 8 and 11 on copy 1's 5 and 6, so 4 -> 1, 7 -> 2, 8 -> 5, 11 -> 6.
//   The vertices kept, in order, are 0, 1, 2, 3, 5, 6, 9, 10, renumbered 0
//   to 7: vertex 4 (old 5) at (2, 0, 0), 5 (old 6) at (2, 1, 0), 6 (old 9) at
//   (3, 0, 0), 7 (old 10) at (3, 1, 0). Face 1 (old 4, 5, 6, 7) is (1, 4, 5,
//   2) and face 2 (4, 6, 7, 5): 8 vertices, 3 x 4 - 2 = 10 edges, 3 faces, 8
//   on the boundary, all facing +z. Merged edges: copy 1's left side 7-4
//   (crease 0) joins copy 0's 1-2 (crease 2), so 1-2 keeps 2 (the greater);
//   4-5 and 6-7 are copies 1's and 2's own 1-2, crease 2: three of crease 2,
//   seven of 0. A merged vertex keeps its representative's values: vertex 4
//   (old 5, copy 1's vertex 1) has w 1. Corners stay their faces' own: face
//   1's corner at vertex 1 is copy 1's corner at its vertex 0, uv (0, 0),
//   while face 0's corner at 1 is (1, 0).
// - The wall: a quarter of a square tube about the y axis, vertices 0
//   (1,0,0), 1 (0,0,-1), 2 (0,1,-1), 3 (1,1,0), face (0, 1, 2, 3); its
//   normal is (1,0,-1)/sqrt 2: the sides 0->1 = (-1, 0, -1) and 1->2 = (0,
//   1, 0) cross to (1, 0, -1), outward from the axis.
//   A turn about +y by a takes (x, z) to (x cos a + z sin a, -x sin a + z cos
//   a): a quarter turn takes (1, 0, 0) to (0, 0, -1), (0, 0, -1) to (-1, 0,
//   0), and (x, z) to (z, -x).
// - Radial, 4 copies about +y through the origin, a whole turn, merged at
//   0.001: copy k turned by k quarter turns, so each copy's 0 and 3 land on
//   the one before's 1 and 2, and the last's 1 and 2 on copy 0's 0 and 3:
//   4 -> 1, 7 -> 2, 8 -> 5, 11 -> 6, 12 -> 9, 15 -> 10, 13 -> 0, 14 -> 3. Kept
//   0, 1, 2, 3, 5, 6, 9, 10: vertex 4 (old 5, copy 1's 1) at (-1, 0, 0), 5 at
//   (-1, 1, 0), 6 (old 9, copy 2's 1) at (0, 0, 1), 7 at (0, 1, 1). Faces 0
//   (0, 1, 2, 3), 1 (1, 4, 5, 2), 2 (4, 6, 7, 5), 3 (6, 0, 3, 7): the closed
//   square tube, 8 vertices, 12 edges, 4 faces, its top and bottom loops the
//   8 boundary edges. Face 1's normal is the wall's turned a quarter, (-1, 0,
//   -1)/sqrt 2, still outward, and face 2's (-1, 0, 1)/sqrt 2.
// - Radial, 3 copies over a quarter turn (not whole: the last copy at the
//   angle), copy k at k pi/4, merged at 0.001: vertex 4 (copy 1's 0) at
//   (cos 45, 0, -sin 45) = (0.707107, 0, -0.707107), vertex 8 (copy 2's 0) at
//   (0, 0, -1). Vertex 8 lies on copy 0's vertex 1, but copies 0 and 2 are not
//   neighbours, and no neighbours touch, so nothing merges: 12 vertices.
// - Radial, 2 copies over a quarter turn about +y through (1, 0, 0): copy 1's
//   vertex 0, on the axis, stays at (1, 0, 0) (vertex 4); its vertex 1, (-1,
//   0, -1) from the origin, turns to (-1, 0, 1), so vertex 5 is at (0, 0, 1).
// - Along a path: Path.line from (0,0,0) to (4,0,0) in 4 pieces. Its tangent
//   is +x; the default up +y is the binormal, and the normal is binormal x
//   tangent = (0,1,0) x (1,0,0) = (0, 0, -1). A copy at distance s puts the
//   mesh's (x, y, z) at (s, 0, 0) + x (0,0,-1) + y (0,1,0) + z (1,0,0) = (s +
//   z, y, -x). The strip: vertices 0 (-0.5,0,0), 1 (-0.5,0,2), 2 (0.5,0,2), 3
//   (0.5,0,0), face (0, 1, 2, 3), its sides (0,0,2) then (1,0,0) crossing to
//   (0, 2, 0): facing +y, which the frame keeps (+y is the binormal).
//   3 copies on the open path go at 0, 2 and 4, so copy k's vertices are 0
//   (2k, 0, 0.5), 1 (2k + 2, 0, 0.5), 2 (2k + 2, 0, -0.5), 3 (2k, 0, -0.5):
//   each copy's 0 and 3 meet the one before's 1 and 2, and merged at 0.001 it
//   is the linear case's numbering again: 8 vertices, 10 edges, vertex 4
//   (old 5) at (4, 0, 0.5), vertex 7 (old 10) at (6, 0, -0.5), face 1 (1, 4,
//   5, 2), every face facing +y.
// - Along a closed path: Path.circle(2, 4), points (2,0,0), (0,0,-2), (-2,0,0),
//   (0,0,2), tangents (-sin a, 0, -cos a). Its frames (see frames.cone): the
//   binormal stays +y and the normal is the inward radius, binormal x
//   tangent: at point 0, (0,1,0) x (0,0,-1) = (-1, 0, 0); at point 1 (tangent
//   (-1,0,0)) (0, 0, 1); at point 2 (tangent (0,0,1)) (1, 0, 0). 4 copies
//   round a closed path go at L k / 4, on the points. The slice: vertices 0
//   (-0.5,-0.5,0), 1 (0.5,-0.5,0), 2 (0.5,0.5,0), 3 (-0.5,0.5,0), facing +z,
//   so each copy faces along the tangent. Vertex 1 of copy 0 is (2,0,0) +
//   0.5 (-1,0,0) - 0.5 (0,1,0) = (1.5, -0.5, 0); of copy 1 (vertex 5), (0,0,-2)
//   + 0.5 (0,0,1) - 0.5 (0,1,0) = (0, -0.5, -1.5); of copy 2 (vertex 9), (-2,
//   0, 0) + 0.5 (1,0,0) - 0.5 (0,1,0) = (-1.5, -0.5, 0). Faces 0, 1 and 2 face
//   (0,0,-1), (-1,0,0) and (0,0,1).

mod arrays;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;
imm half = 0.70710678;

fn point(got Vec3, x f32, y f32, z f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn point2(got Vec2, x f32, y f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
}

fn clean(m &PolyMesh, label &Array[u8]) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &Array[u8]) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn edgeOf(m &PolyMesh, a u32, b u32) u32 {
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    imm p = *m.hVertex[usize.from(2u32 * e)];
    imm q = *m.hVertex[usize.from(2u32 * e + 1u32)];
    if (p == a and q == b) or (p == b and q == a) { return e; }
    e = e + 1u32;
  }
  NoIndex;
}

fn faceIs(m &PolyMesh, f u32, a u32, b u32, c u32, d u32, label &Array[u8]) {
  imm vs = m.faceVertices(f);
  expectInt(i64.from(vs.len()), 4, label);
  if vs.len() == 4usize {
    expectInt(i64.from(*vs[0usize]), i64.from(a), label);
    expectInt(i64.from(*vs[1usize]), i64.from(b), label);
    expectInt(i64.from(*vs[2usize]), i64.from(c), label);
    expectInt(i64.from(*vs[3usize]), i64.from(d), label);
  }
}

fn boundaryEdges(m &PolyMesh) i64 {
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.isBoundaryEdge(e) { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

fn countEdgesWith(m &PolyMesh, name &str, value f32) i64 {
  imm ch = m.findFloatChannel(EdgeDomain, name);
  if ch == NoIndex { return -1; }
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.float(ch, e) == value { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

// The corner uv of face f at vertex v
fn uvAt(m &PolyMesh, f u32, v u32) Vec2 {
  imm ch = m.findVec2Channel(CornerDomain, "uv");
  imm hs = m.faceHalfedges(f);
  mut i = 0usize;
  while i < hs.len() {
    if m.toVertex(*hs[i]) == v { return m.vec2(ch, *hs[i]); }
    i = i + 1usize;
  }
  new Vec2(-1., -1.);
}

// One quad, the vertices a to d, with no channels
fn quad(a Vec3, b Vec3, c Vec3, d Vec3) PolyMesh {
  imm pts Array[Vec3, 4] = [a, b, c, d];
  imm sizes Array[u32, 1] = [4u32];
  imm faces Array[u32, 4] = [0u32, 1u32, 2u32, 3u32];
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(&pts, &sizes, &faces, &mut problems);
}

// The tile, with its channels
fn tile() PolyMesh {
  mut m = quad(new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), new Vec3(1., 1., 0.), new Vec3(0., 1., 0.));
  imm w = m.addFloatChannel(VertexDomain, "w", 0.);
  mut v = 0u32;
  while v < 4u32 {
    m.setFloat(w, v, f32.from(v));
    v = v + 1u32;
  }
  imm id = m.addFloatChannel(FaceDomain, "id", 0.);
  m.setFloat(id, 0u32, 7.);
  imm crease = m.addFloatChannel(EdgeDomain, "crease", 0.);
  m.setFloat(crease, edgeOf(&m, 1u32, 2u32), 2.);
  imm uv = m.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  imm hs = m.faceHalfedges(0u32);
  mut i = 0usize;
  while i < hs.len() {
    imm p = *m.positions[usize.from(m.toVertex(*hs[i]))];
    m.setVec2(uv, *hs[i], new Vec2(p.x, p.y));
    i = i + 1usize;
  }
  m;
}

fn linear() {
  imm t = tile();
  imm a = arrayLinear(&t, 3u32, new Vec3(1., 0., 0.), -1.);
  clean(&a, "linear: validates");
  counts(&a, 12, 12, 3, "linear: 12 vertices, 12 edges, 3 faces");
  point(*a.positions[5usize], 2., 0., 0., "linear: vertex 5, copy 1's 1");
  point(*a.positions[10usize], 3., 1., 0., "linear: vertex 10, copy 2's 2");
  faceIs(&a, 2u32, 8u32, 9u32, 10u32, 11u32, "linear: face 2");
  point(a.faceNormal(2u32), 0., 0., 1., "linear: face 2 faces +z");
  imm w = a.findFloatChannel(VertexDomain, "w");
  require(w != NoIndex, "linear: w carried");
  expectFloat(a.float(w, 10u32), 2., near, "linear: vertex 10's w is 2's");
  imm id = a.findFloatChannel(FaceDomain, "id");
  require(id != NoIndex, "linear: id carried");
  expectFloat(a.float(id, 2u32), 7., near, "linear: face 2's id");
  expectInt(countEdgesWith(&a, "crease", 2.), 3, "linear: three creased edges");

  imm m = arrayLinear(&t, 3u32, new Vec3(1., 0., 0.), 0.001);
  clean(&m, "linear merged: validates");
  counts(&m, 8, 10, 3, "linear merged: 8 vertices, 10 edges, 3 faces");
  expectInt(boundaryEdges(&m), 8, "linear merged: 8 boundary edges");
  point(*m.positions[4usize], 2., 0., 0., "linear merged: vertex 4");
  point(*m.positions[5usize], 2., 1., 0., "linear merged: vertex 5");
  point(*m.positions[6usize], 3., 0., 0., "linear merged: vertex 6");
  point(*m.positions[7usize], 3., 1., 0., "linear merged: vertex 7");
  faceIs(&m, 1u32, 1u32, 4u32, 5u32, 2u32, "linear merged: face 1");
  faceIs(&m, 2u32, 4u32, 6u32, 7u32, 5u32, "linear merged: face 2");
  point(m.faceNormal(1u32), 0., 0., 1., "linear merged: face 1 faces +z");
  point(m.faceNormal(2u32), 0., 0., 1., "linear merged: face 2 faces +z");
  imm crease = m.findFloatChannel(EdgeDomain, "crease");
  require(crease != NoIndex, "linear merged: crease carried");
  expectFloat(m.float(crease, edgeOf(&m, 1u32, 2u32)), 2., near, "linear merged: 1-2 keeps the greater crease");
  expectFloat(m.float(crease, edgeOf(&m, 4u32, 5u32)), 2., near, "linear merged: 4-5 creased");
  expectFloat(m.float(crease, edgeOf(&m, 6u32, 7u32)), 2., near, "linear merged: 6-7 creased");
  expectInt(countEdgesWith(&m, "crease", 0.), 7, "linear merged: seven uncreased");
  imm mw = m.findFloatChannel(VertexDomain, "w");
  expectFloat(m.float(mw, 4u32), 1., near, "linear merged: vertex 4's w is copy 1's vertex 1's");
  point2(uvAt(&m, 1u32, 1u32), 0., 0., "linear merged: face 1's corner at 1 is its own");
  point2(uvAt(&m, 0u32, 1u32), 1., 0., "linear merged: face 0's corner at 1");
  point2(uvAt(&m, 1u32, 4u32), 1., 0., "linear merged: face 1's corner at 4");
}

fn wall() PolyMesh {
  quad(new Vec3(1., 0., 0.), new Vec3(0., 0., -1.), new Vec3(0., 1., -1.), new Vec3(1., 1., 0.));
}

fn radial() {
  imm w = wall();
  imm up = new Vec3(0., 1., 0.);
  imm origin = new Vec3(0., 0., 0.);
  point(w.faceNormal(0u32), half, 0., -half, "wall: faces out from the axis");

  imm ring = arrayRadial(&w, 4u32, up, 2. * pi, origin, 0.001);
  clean(&ring, "radial ring: validates");
  counts(&ring, 8, 12, 4, "radial ring: 8 vertices, 12 edges, 4 faces");
  expectInt(boundaryEdges(&ring), 8, "radial ring: top and bottom loops open");
  point(*ring.positions[4usize], -1., 0., 0., "radial ring: vertex 4");
  point(*ring.positions[5usize], -1., 1., 0., "radial ring: vertex 5");
  point(*ring.positions[6usize], 0., 0., 1., "radial ring: vertex 6");
  point(*ring.positions[7usize], 0., 1., 1., "radial ring: vertex 7");
  faceIs(&ring, 1u32, 1u32, 4u32, 5u32, 2u32, "radial ring: face 1");
  faceIs(&ring, 2u32, 4u32, 6u32, 7u32, 5u32, "radial ring: face 2");
  faceIs(&ring, 3u32, 6u32, 0u32, 3u32, 7u32, "radial ring: face 3 closes on copy 0");
  point(ring.faceNormal(1u32), -half, 0., -half, "radial ring: face 1 faces out");
  point(ring.faceNormal(2u32), -half, 0., half, "radial ring: face 2 faces out");

  imm arc = arrayRadial(&w, 3u32, up, pi / 2., origin, 0.001);
  clean(&arc, "radial arc: validates");
  counts(&arc, 12, 12, 3, "radial arc: nothing merged");
  point(*arc.positions[4usize], half, 0., -half, "radial arc: vertex 4 at 45 degrees");
  point(*arc.positions[8usize], 0., 0., -1., "radial arc: vertex 8 at 90 degrees, on vertex 1");

  imm off = arrayRadial(&w, 2u32, up, pi / 2., new Vec3(1., 0., 0.), -1.);
  clean(&off, "radial off centre: validates");
  point(*off.positions[4usize], 1., 0., 0., "radial off centre: vertex 4 on the axis");
  point(*off.positions[5usize], 0., 0., 1., "radial off centre: vertex 5");
}

fn alongPath() {
  imm strip = quad(new Vec3(-0.5, 0., 0.), new Vec3(-0.5, 0., 2.), new Vec3(0.5, 0., 2.), new Vec3(0.5, 0., 0.));
  imm line = Path.line(new Vec3(0., 0., 0.), new Vec3(4., 0., 0.), 4u32);
  imm m = arrayAlongPath(&strip, &line, 3u32, 0.001);
  clean(&m, "path line: validates");
  counts(&m, 8, 10, 3, "path line: 8 vertices, 10 edges, 3 faces");
  point(*m.positions[0usize], 0., 0., 0.5, "path line: vertex 0");
  point(*m.positions[1usize], 2., 0., 0.5, "path line: vertex 1");
  point(*m.positions[4usize], 4., 0., 0.5, "path line: vertex 4");
  point(*m.positions[7usize], 6., 0., -0.5, "path line: vertex 7");
  faceIs(&m, 1u32, 1u32, 4u32, 5u32, 2u32, "path line: face 1");
  point(m.faceNormal(0u32), 0., 1., 0., "path line: face 0 faces +y");
  point(m.faceNormal(2u32), 0., 1., 0., "path line: face 2 faces +y");

  imm slice = quad(new Vec3(-0.5, -0.5, 0.), new Vec3(0.5, -0.5, 0.), new Vec3(0.5, 0.5, 0.), new Vec3(-0.5, 0.5, 0.));
  imm circle = Path.circle(2., 4u32);
  imm c = arrayAlongPath(&slice, &circle, 4u32, -1.);
  clean(&c, "path circle: validates");
  counts(&c, 16, 16, 4, "path circle: 16 vertices, 16 edges, 4 faces");
  point(*c.positions[1usize], 1.5, -0.5, 0., "path circle: vertex 1");
  point(*c.positions[5usize], 0., -0.5, -1.5, "path circle: vertex 5");
  point(*c.positions[9usize], -1.5, -0.5, 0., "path circle: vertex 9");
  point(c.faceNormal(0u32), 0., 0., -1., "path circle: face 0 along the tangent");
  point(c.faceNormal(1u32), -1., 0., 0., "path circle: face 1 along the tangent");
  point(c.faceNormal(2u32), 0., 0., 1., "path circle: face 2 along the tangent");
}

fn main() i32 {
  linear();
  radial();
  alongPath();
  done();
}
