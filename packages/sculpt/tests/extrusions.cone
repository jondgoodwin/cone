// The sculpt package's face extrusion, checked with the testing package
// against values worked out by hand; only a failure prints, so
// extrusions.out holds the summary alone.
//
// The cube is PolyMesh.cube(1): vertex x + 2y + 4z, each 0 for -1 and 1 for
// +1; faces back 0 (0, 2, 3, 1), front 1 (4, 5, 7, 6), left 2 (0, 4, 6, 2),
// right 3 (1, 3, 7, 5), bottom 4 (0, 1, 5, 4), top 5 (2, 6, 7, 3). A face's
// corners run from its first vertex. Channels on every mesh here: vertex "w"
// = v; face "id" = 10 + f; edge "crease" 0 but where set; corner "uv"
// (v / 8, f / 8) and corner "c" = 10 f + v at vertex v of face f.
// Volumes are by the divergence theorem over the faces as wound, so a face
// turned inward would show in the sum.
//
// - The cube's top extruded by 1 (crease 3 on edge 2-6). The region is the
//   top alone, its normal +y; its four vertices are on its rim, and are
//   copied in the order of its corners: 8 (2's copy) (-1, 2, -1), 9 (6's)
//   (-1, 2, 1), 10 (7's) (1, 2, 1), 11 (3's) (1, 2, -1). Face 5 becomes
//   (8, 9, 10, 11), still facing +y. The rim loop starts at the top's first
//   corner's half-edge, 3 -> 2, and a wall (a, b, b', a') follows each side
//   a -> b: face 6 (3, 2, 8, 11), facing (2 - 3) x (8 - 2) = (-2, 0, 0) x
//   (0, 1, 0) = (0, 0, -2), -z; face 7 (2, 6, 9, 8), -x; face 8 (6, 7, 10,
//   9), +z; face 9 (7, 3, 11, 10), +x. 12 vertices, 12 + 4 + 4 = 20 edges,
//   10 faces, closed (12 - 20 + 10 = 2); volume 8 + 2 x 2 x 1 = 12.
//   Channels: 8's w is 2's, 2; 11's is 3. Wall 7's id is the top's, 15. Edge
//   2-6 keeps crease 3 and the top's 8-9 copies it; the upright 2-8 has 0:
//   two edges of crease 3, eighteen of 0. The top's corner at 8 keeps its
//   uv, (2/8, 5/8) = (0.25, 0.625). The loop is 8 long, each side 2, so the
//   walls' u runs 0, 0.25, 0.5, 0.75, 1: wall 7's corners at 2, 6, 9, 8 are
//   (0.25, 0), (0.5, 0), (0.5, 1), (0.25, 1); wall 9's at 3 and 11 are
//   (1, 0) and (1, 1), the loop's closing corners; wall 6's at 3 is (0, 0).
//   Wall 7's "c" at 9 is the top's at 6, 56, and at 2 the top's at 2, 52.
// - The top extruded by -0.5: pushed in, the walls inside the cube's sides
//   and facing into the pocket: volume 8 - 2 x 2 x 0.5 = 6.
// - A 3 x 2 grid of unit squares in z = 0: vertex (i, j) is j 4 + i at
//   (i, j, 0), face (i, j) is j 3 + i, (v(i, j), v(i + 1, j), v(i + 1, j +
//   1), v(i, j + 1)), facing +z: 12 vertices, 17 edges, 6 faces, 10 boundary
//   edges. Faces 0 and 1, the 2 x 1 region on the grid's edge, extruded by 1
//   along +z. Its rim is the rectangle 0-1-2-6-5-4, six sides; the edge 1-5
//   between its two faces gets no wall. Copies in order of first meeting:
//   face 0 (0, 1, 5, 4) gives 12 (0, 0, 1), 13 (1, 0, 1), 14 (1, 1, 1), 15
//   (0, 1, 1); face 1 (1, 2, 6, 5) meets 1 and 5 again in the same sectors
//   and gives 16 (2, 0, 1), 17 (2, 1, 1). Face 0 becomes (12, 13, 14, 15)
//   and face 1 (13, 16, 17, 14). Edge 1-5 is on no face now and goes; 13-14
//   joins the two tops. 18 vertices; 17 - 1 + 7 (the tops') + 6 (uprights)
//   = 29 edges; 6 + 6 = 12 faces; 18 - 29 + 12 = 1, still a disc; the
//   boundary is still 10 edges (the walls on 4-0, 0-1 and 1-2 stand on it).
//   The loop starts at face 0's half-edge 4 -> 0: wall 6 (4, 0, 12, 15)
//   faces (0, -1, 0) x (0, 0, 1) = -x; wall 9 (2, 6, 17, 16) faces (0, 1, 0)
//   x (0, 0, 1) = +x. The grid lies in z = 0, through the origin, where its
//   faces add nothing to the volume sum, so the sum is the raised block's,
//   2 x 1 x 1 = 2. The loop is 6 long: wall 9's u runs from 3/6 to 4/6.
// - The cube's front and top (faces 1 and 5) as one region, extruded by
//   sqrt 2: the region's normal is the area-weighted mean of +z and +y,
//   (0, 1, 1) / sqrt 2, so it moves by (0, 1, 1). Copies: face 1 (4, 5, 7, 6)
//   gives 8 (-1, 0, 2), 9 (1, 0, 2), 10 (1, 2, 2), 11 (-1, 2, 2); face 5
//   (2, 6, 7, 3) gives 12 (2's) (-1, 2, 0) and, after 6 and 7 already met,
//   13 (3's) (1, 2, 0). 14 vertices; 12 - 1 (6-7 goes) + 7 + 6 = 24 edges;
//   6 + 6 = 12 faces; closed. Volume 8 plus the region swept by (0, 1, 1):
//   area 4 times (0, 1, 1) . (0, 1, 0), and 4 times (0, 1, 1) . (0, 0, 1),
//   8 + 4 + 4 = 16.
// - Individual: the cube's right and top (given as 5 then 3; the faces'
//   order decides), each extruded by 1 along its own normal. Face 3 (1, 3,
//   7, 5) moves +x: 8 (2, -1, -1), 9 (2, 1, -1), 10 (2, 1, 1), 11 (2, -1,
//   1); face 5 (2, 6, 7, 3) moves +y: 12 (-1, 2, -1), 13 (-1, 2, 1), 14 (1,
//   2, 1), 15 (1, 2, -1). Each has its own four walls, face 3's first: wall
//   6 (5, 1, 8, 11) faces (0, 0, -2) x (1, 0, 0) = (0, -2, 0), -y. The edge
//   3-7 they shared now carries a wall of each. 16 vertices; 12 + 2 x (4 +
//   4) = 28 edges; 6 + 8 = 14 faces; closed; volume 8 + 4 + 4 = 16 (the two
//   new boxes do not meet). Crease 2 on 3-7: it stays on 3-7, and face 3's
//   top 9-10 and face 5's 15-14 copy it: three edges of crease 2.

mod extrusions;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn point2(got Vec2, x f32, y f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
}

fn clean(m &PolyMesh, label &Array[u8]) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &Array[u8]) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn face(m &PolyMesh, f u32, a u32, b u32, c u32, d u32, label &Array[u8]) {
  imm vs = m.faceVertices(f);
  expectInt(i64.from(vs.len()), 4, label);
  if vs.len() == 4usize {
    expectInt(i64.from(*vs[0usize]), i64.from(a), label);
    expectInt(i64.from(*vs[1usize]), i64.from(b), label);
    expectInt(i64.from(*vs[2usize]), i64.from(c), label);
    expectInt(i64.from(*vs[3usize]), i64.from(d), label);
  }
}

fn edgeOf(m &PolyMesh, a u32, b u32) u32 {
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    imm p = *m.hVertex[usize.from(2u32 * e)];
    imm q = *m.hVertex[usize.from(2u32 * e + 1u32)];
    if (p == a and q == b) or (p == b and q == a) { return e; }
    e = e + 1u32;
  }
  NoIndex;
}

fn boundaryEdges(m &PolyMesh) i64 {
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.isBoundaryEdge(e) { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

fn countEdgesWith(m &PolyMesh, name &str, value f32) i64 {
  imm ch = m.findFloatChannel(EdgeDomain, name);
  if ch == NoIndex { return -1; }
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.float(ch, e) == value { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

fn volume(m &PolyMesh) f32 {
  mut sum f32 = 0.;
  mut f = 0usize;
  while f < m.faceCount() {
    imm pts = m.facePositions(u32.from(f));
    mut i = 1usize;
    while i + 1usize < pts.len() {
      sum = sum + pts[0usize].dot(pts[i].cross(*pts[i + 1usize]));
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.;
}

// The corner of face f at vertex v
fn cornerAt(m &PolyMesh, f u32, v u32) u32 {
  imm hs = m.faceHalfedges(f);
  mut i = 0usize;
  while i < hs.len() {
    if m.toVertex(*hs[i]) == v { return *hs[i]; }
    i = i + 1usize;
  }
  NoIndex;
}

fn uvAt(m &PolyMesh, f u32, v u32) Vec2 {
  imm h = cornerAt(m, f, v);
  if h == NoIndex { return new Vec2(-1., -1.); }
  m.vec2(m.findVec2Channel(CornerDomain, "uv"), h);
}

fn cAt(m &PolyMesh, f u32, v u32) f32 {
  imm h = cornerAt(m, f, v);
  if h == NoIndex { return -1.; }
  m.float(m.findFloatChannel(CornerDomain, "c"), h);
}

fn addChannels(m &mut PolyMesh) {
  imm w = m.addFloatChannel(VertexDomain, "w", 0.);
  mut v = 0u32;
  while usize.from(v) < m.vertexCount() {
    m.setFloat(w, v, f32.from(v));
    v = v + 1u32;
  }
  imm id = m.addFloatChannel(FaceDomain, "id", 0.);
  m.addFloatChannel(EdgeDomain, "crease", 0.);
  imm uv = m.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  imm c = m.addFloatChannel(CornerDomain, "c", 0.);
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    m.setFloat(id, f, 10. + f32.from(f));
    imm hs = m.faceHalfedges(f);
    mut i = 0usize;
    while i < hs.len() {
      imm hv = m.toVertex(*hs[i]);
      m.setVec2(uv, *hs[i], new Vec2(f32.from(hv) / 8., f32.from(f) / 8.));
      m.setFloat(c, *hs[i], 10. * f32.from(f) + f32.from(hv));
      i = i + 1usize;
    }
    f = f + 1u32;
  }
}

fn setCrease(m &mut PolyMesh, a u32, b u32, value f32) {
  imm ch = m.findFloatChannel(EdgeDomain, "crease");
  imm e = edgeOf(m, a, b);
  m.setFloat(ch, e, value);
}

fn grid() PolyMesh {
  mut pts = List[Vec3].empty();
  mut j = 0u32;
  while j < 3u32 {
    mut i = 0u32;
    while i < 4u32 {
      pts.push(new Vec3(f32.from(i), f32.from(j), 0.));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  mut sizes = List[u32].empty();
  mut idx = List[u32].empty();
  j = 0u32;
  while j < 2u32 {
    mut i = 0u32;
    while i < 3u32 {
      sizes.push(4u32);
      idx.push(4u32 * j + i);
      idx.push(4u32 * j + i + 1u32);
      idx.push(4u32 * (j + 1u32) + i + 1u32);
      idx.push(4u32 * (j + 1u32) + i);
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  mut problems = List[String].empty();
  mut m = PolyMesh.fromPolygons(pts.view(), sizes.view(), idx.view(), &mut problems);
  addChannels(&mut m);
  m;
}

fn cubeTop() {
  mut c = PolyMesh.cube(1.);
  addChannels(&mut c);
  setCrease(&mut c, 2u32, 6u32, 3.);
  imm top Array[u32, 1] = [5u32];
  imm m = extrudeFaces(&c, &top, 1.);
  clean(&m, "cube top: validates");
  counts(&m, 12, 20, 10, "cube top: 12 vertices, 20 edges, 10 faces");
  expectInt(boundaryEdges(&m), 0, "cube top: closed");
  expectFloat(volume(&m), 12., near, "cube top: volume 12, every face outward");
  point(*m.positions[2usize], -1., 1., -1., "cube top: vertex 2 stays");
  point(*m.positions[8usize], -1., 2., -1., "cube top: 8, 2's copy");
  point(*m.positions[9usize], -1., 2., 1., "cube top: 9, 6's copy");
  point(*m.positions[10usize], 1., 2., 1., "cube top: 10, 7's copy");
  point(*m.positions[11usize], 1., 2., -1., "cube top: 11, 3's copy");
  face(&m, 5u32, 8u32, 9u32, 10u32, 11u32, "cube top: face 5 is the top");
  point(m.faceNormal(5u32), 0., 1., 0., "cube top: the top faces +y");
  face(&m, 6u32, 3u32, 2u32, 8u32, 11u32, "cube top: wall 6");
  face(&m, 7u32, 2u32, 6u32, 9u32, 8u32, "cube top: wall 7");
  face(&m, 8u32, 6u32, 7u32, 10u32, 9u32, "cube top: wall 8");
  face(&m, 9u32, 7u32, 3u32, 11u32, 10u32, "cube top: wall 9");
  point(m.faceNormal(6u32), 0., 0., -1., "cube top: wall 6 faces -z");
  point(m.faceNormal(7u32), -1., 0., 0., "cube top: wall 7 faces -x");
  point(m.faceNormal(8u32), 0., 0., 1., "cube top: wall 8 faces +z");
  point(m.faceNormal(9u32), 1., 0., 0., "cube top: wall 9 faces +x");

  imm w = m.findFloatChannel(VertexDomain, "w");
  expectFloat(m.float(w, 8u32), 2., near, "cube top: 8's w is 2's");
  expectFloat(m.float(w, 11u32), 3., near, "cube top: 11's w is 3's");
  imm id = m.findFloatChannel(FaceDomain, "id");
  expectFloat(m.float(id, 7u32), 15., near, "cube top: wall 7's id is the top's");
  imm crease = m.findFloatChannel(EdgeDomain, "crease");
  expectFloat(m.float(crease, edgeOf(&m, 2u32, 6u32)), 3., near, "cube top: 2-6 keeps its crease");
  expectFloat(m.float(crease, edgeOf(&m, 8u32, 9u32)), 3., near, "cube top: the top's 8-9 copies it");
  expectFloat(m.float(crease, edgeOf(&m, 2u32, 8u32)), 0., near, "cube top: the upright 2-8 has none");
  expectInt(countEdgesWith(&m, "crease", 3.), 2, "cube top: two edges of crease 3");
  expectInt(countEdgesWith(&m, "crease", 0.), 18, "cube top: eighteen of 0");
  point2(uvAt(&m, 5u32, 8u32), 0.25, 0.625, "cube top: the top keeps its uv");
  point2(uvAt(&m, 7u32, 2u32), 0.25, 0., "cube top: wall 7 at 2");
  point2(uvAt(&m, 7u32, 6u32), 0.5, 0., "cube top: wall 7 at 6");
  point2(uvAt(&m, 7u32, 9u32), 0.5, 1., "cube top: wall 7 at 9");
  point2(uvAt(&m, 7u32, 8u32), 0.25, 1., "cube top: wall 7 at 8");
  point2(uvAt(&m, 9u32, 3u32), 1., 0., "cube top: wall 9 at 3, the seam");
  point2(uvAt(&m, 9u32, 11u32), 1., 1., "cube top: wall 9 at 11, the seam");
  point2(uvAt(&m, 6u32, 3u32), 0., 0., "cube top: wall 6 at 3");
  expectFloat(cAt(&m, 7u32, 9u32), 56., near, "cube top: wall 7's c at 9 is the top's at 6");
  expectFloat(cAt(&m, 7u32, 2u32), 52., near, "cube top: wall 7's c at 2 is the top's at 2");

  imm pushed = extrudeFaces(&c, &top, -0.5);
  clean(&pushed, "cube top pushed in: validates");
  expectFloat(volume(&pushed), 6., near, "cube top pushed in: volume 6");
  point(*pushed.positions[8usize], -1., 0.5, -1., "cube top pushed in: 8");
}

fn gridRegion() {
  imm g = grid();
  counts(&g, 12, 17, 6, "grid: 12 vertices, 17 edges, 6 faces");
  expectInt(boundaryEdges(&g), 10, "grid: 10 boundary edges");
  imm sel Array[u32, 2] = [0u32, 1u32];
  imm m = extrudeFaces(&g, &sel, 1.);
  clean(&m, "grid region: validates");
  counts(&m, 18, 29, 12, "grid region: 18 vertices, 29 edges, 12 faces");
  expectInt(boundaryEdges(&m), 10, "grid region: 10 boundary edges");
  expectFloat(volume(&m), 2., near, "grid region: the raised block's volume, 2");
  point(*m.positions[12usize], 0., 0., 1., "grid region: 12");
  point(*m.positions[13usize], 1., 0., 1., "grid region: 13");
  point(*m.positions[14usize], 1., 1., 1., "grid region: 14");
  point(*m.positions[15usize], 0., 1., 1., "grid region: 15");
  point(*m.positions[16usize], 2., 0., 1., "grid region: 16");
  point(*m.positions[17usize], 2., 1., 1., "grid region: 17");
  face(&m, 0u32, 12u32, 13u32, 14u32, 15u32, "grid region: face 0's top");
  face(&m, 1u32, 13u32, 16u32, 17u32, 14u32, "grid region: face 1's top");
  require(edgeOf(&m, 1u32, 5u32) == NoIndex, "grid region: no wall on the inside edge 1-5");
  require(edgeOf(&m, 13u32, 14u32) != NoIndex, "grid region: 13-14 joins the tops");
  face(&m, 6u32, 4u32, 0u32, 12u32, 15u32, "grid region: wall 6");
  face(&m, 9u32, 2u32, 6u32, 17u32, 16u32, "grid region: wall 9");
  point(m.faceNormal(6u32), -1., 0., 0., "grid region: wall 6 faces -x");
  point(m.faceNormal(9u32), 1., 0., 0., "grid region: wall 9 faces +x");
  point(m.faceNormal(1u32), 0., 0., 1., "grid region: the top faces +z");
  point2(uvAt(&m, 9u32, 2u32), 0.5, 0., "grid region: wall 9's u starts at 3/6");
  point2(uvAt(&m, 9u32, 6u32), 0.6666667, 0., "grid region: and ends at 4/6");

  // Two faces over a fold: the region's mean normal
  imm c = PolyMesh.cube(1.);
  imm fold Array[u32, 2] = [5u32, 1u32];
  imm k = extrudeFaces(&c, &fold, 1.4142136);
  clean(&k, "fold: validates");
  counts(&k, 14, 24, 12, "fold: 14 vertices, 24 edges, 12 faces");
  expectInt(boundaryEdges(&k), 0, "fold: closed");
  expectFloat(volume(&k), 16., 0.0001d, "fold: volume 16");
  point(*k.positions[8usize], -1., 0., 2., "fold: 8, 4's copy");
  point(*k.positions[10usize], 1., 2., 2., "fold: 10, 7's copy");
  point(*k.positions[12usize], -1., 2., 0., "fold: 12, 2's copy");
  point(*k.positions[13usize], 1., 2., 0., "fold: 13, 3's copy");
}

fn individual() {
  mut c = PolyMesh.cube(1.);
  addChannels(&mut c);
  setCrease(&mut c, 3u32, 7u32, 2.);
  imm sel Array[u32, 2] = [5u32, 3u32];
  imm m = extrudeIndividual(&c, &sel, 1.);
  clean(&m, "individual: validates");
  counts(&m, 16, 28, 14, "individual: 16 vertices, 28 edges, 14 faces");
  expectInt(boundaryEdges(&m), 0, "individual: closed");
  expectFloat(volume(&m), 16., near, "individual: volume 16");
  point(*m.positions[8usize], 2., -1., -1., "individual: 8");
  point(*m.positions[10usize], 2., 1., 1., "individual: 10");
  point(*m.positions[12usize], -1., 2., -1., "individual: 12");
  point(*m.positions[14usize], 1., 2., 1., "individual: 14");
  face(&m, 3u32, 8u32, 9u32, 10u32, 11u32, "individual: face 3");
  face(&m, 5u32, 12u32, 13u32, 14u32, 15u32, "individual: face 5");
  face(&m, 6u32, 5u32, 1u32, 8u32, 11u32, "individual: wall 6");
  point(m.faceNormal(6u32), 0., -1., 0., "individual: wall 6 faces -y");
  require(!m.isBoundaryEdge(edgeOf(&m, 3u32, 7u32)), "individual: 3-7 carries a wall of each");
  imm crease = m.findFloatChannel(EdgeDomain, "crease");
  expectFloat(m.float(crease, edgeOf(&m, 9u32, 10u32)), 2., near, "individual: face 3's top copies 3-7");
  expectFloat(m.float(crease, edgeOf(&m, 15u32, 14u32)), 2., near, "individual: face 5's top copies 3-7");
  expectInt(countEdgesWith(&m, "crease", 2.), 3, "individual: three edges of crease 2");
}

fn main() i32 {
  cubeTop();
  gridRegion();
  individual();
  done();
}
