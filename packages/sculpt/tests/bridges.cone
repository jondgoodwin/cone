// The sculpt package's bridgeLoops and boundaryLoop, checked with the testing
// package against values worked out by hand; only a failure prints, so
// bridges.out holds the summary alone. Volumes are by the divergence theorem
// over the faces as wound, so a face turned the wrong way would show.
//
// - Two square tubes: T = extrude(rectangle(1, 1), (0, 0, 1), 1, no caps),
//   vertices 0..3 at z = 0 and 4..7 at z = 1 from (-0.5, -0.5)
//   counterclockwise; its quad (0, 1, 5, 4) runs 5 -> 4 along the top, so
//   the top hole runs 4 -> 5 -> 6 -> 7: boundaryLoop(4) = 4, 5, 6, 7. Two
//   copies by arrayLinear, the second 2 up (vertices 8..15, faces 4..7): its
//   bottom hole runs 8 -> 11 -> 10 -> 9, boundaryLoop(8) = 8, 11, 10, 9, and
//   the second loop of a pair runs the other way, 8, 9, 10, 11. The same
//   shape about their centres, so no shift: quads (4, 5, 9, 8), (5, 6, 10,
//   9), (6, 7, 11, 10), (7, 4, 8, 11) from face 8; face 8 faces (5 - 4) x (9
//   - 5) = (1, 0, 0) x (0, 0, 1) = (0, -1, 0), out. 16 vertices, 24 + 4 =
//   28 edges, 12 faces, 8 boundary edges (the two ends), V - E + F = 0.
//   uv: u by the first loop's fractions 0, 1/4, 1/2, 3/4, v 0 at the first
//   loop and 1 at the second: face 8 at 9 (0.25, 1), face 11 at 4 (1, 0),
//   the seam. A crease 2 on the top edge 4-5 stays (the band's side is that
//   edge); the rung 4-8 has 0.
// - One cut: ring 16..19 halfway, 16 (-0.5, -0.5, 1.5); 20 vertices, 16
//   faces, 24 + 4 + 8 = 36 edges. Face 8 (4, 5, 17, 16), face 12 (16, 17,
//   9, 8). "along" of 16 blends 4's 1 and 8's 0: 0.5; "around" of 17: 0.25.
//   uv of face 12 at 16 (0, 0.5).
// - Smoothness: the second tube moved (1, 0, 2) instead, two cuts,
//   smoothness 1. At 4 the surface leaves along 4 - 0 = (0, 0, 1) (its
//   neighbours 5 and 7 are on the loop, 0 is not), at 8 along 8 - 12 = (0, 0,
//   -1). From a = 4 (-0.5, -0.5, 1) to b = 8 (0.5, -0.5, 2), chord (1, 0, 1)
//   of length sqrt 2, both end tangents (0, 0, sqrt 2). At f = 1/3 the
//   Hermite weights are h00 20/27, h10 4/27, h01 7/27, h11 -2/27: x = (20 (-0.5)
//   + 7 (0.5)) / 27 = -0.2407407, z = (20 + 14) / 27 + 2 sqrt 2 / 27 =
//   1.3640159 (straight: -0.1666667, 1.3333333).
// - Counts that differ: a square face 0 (0, 3, 2, 1) at z = 0, side 2 from
//   (-1, -1), facing -z, and an octagon face 1 at z = 1, the same square with
//   its midpoints, 4 (-1, -1), 5 (0, -1), 6 (1, -1), 7 (1, 0) ... 11 (-1, 0),
//   facing +z. The square's hole runs 0, 1, 2, 3 (fractions 0, 1/4, 1/2,
//   3/4), the octagon's, the other way round from 4, 4, 5, ..., 11 (j / 8);
//   it matches from 4 exactly. Going round both: (0, 5, 4) a triangle
//   (1/8 before 1/4), (0, 1, 6, 5) a quad (both at 1/4), (1, 7, 6), (1, 2,
//   8, 7), (2, 9, 8), (2, 3, 10, 9), (3, 11, 10), (3, 0, 4, 11): faces 2..9.
//   A closed box: 12 vertices, 20 edges, 10 faces, volume 4. Channels: w =
//   v, id = 10 + f, c = 10 f + v at each corner, crease 3 on 0-1. Every band
//   face's id is face 0's, 10. Face 3's corners: at 0 face 0's corner there
//   (c 0), at 1 (c 1), at 6 face 1's (c 16), at 5 (c 15). uv of face 2 at 5
//   (1/8, 1), of face 9 at 0 (1, 0) and 11 (7/8, 1). Crease 3 kept on 0-1.
// - With one cut: a ring of 8 at z = 0.5 on the union j / 8, 12 (-1, -1,
//   0.5), 13 (0, -1, 0.5); 20 vertices, 2 + 8 + 8 = 18 faces, closed, so 36
//   edges; volume 4. Vertex 13's w: halfway along the square's side 0-1
//   (0.5 x 0 + 0.5 x 1) and at the octagon's 5, half each: 0.25 + 2.5 =
//   2.75; 12's: (0 + 4) / 2 = 2.
// - Skipped: a pair on one loop, a cube (no boundary), a lone vertex.

mod bridges;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn clean(m &PolyMesh, label &Array[u8]) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &Array[u8]) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn face(m &PolyMesh, f u32, want &Array[u32], label &Array[u8]) {
  imm vs = m.faceVertices(f);
  expectInt(i64.from(vs.len()), i64.from(want.len), label);
  if vs.len() == want.len {
    mut i = 0usize;
    while i < vs.len() {
      expectInt(i64.from(*vs[i]), i64.from(want[i]), label);
      i = i + 1usize;
    }
  }
}

fn loopIs(got &List[u32], want &Array[u32], label &Array[u8]) {
  expectInt(i64.from(got.len()), i64.from(want.len), label);
  if got.len() == want.len {
    mut i = 0usize;
    while i < got.len() {
      expectInt(i64.from(*got[i]), i64.from(want[i]), label);
      i = i + 1usize;
    }
  }
}

fn edgeOf(m &PolyMesh, a u32, b u32) u32 {
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    imm p = *m.hVertex[usize.from(2u32 * e)];
    imm q = *m.hVertex[usize.from(2u32 * e + 1u32)];
    if (p == a and q == b) or (p == b and q == a) { return e; }
    e = e + 1u32;
  }
  NoIndex;
}

fn creaseOf(m &PolyMesh, a u32, b u32) f32 {
  m.float(m.findFloatChannel(EdgeDomain, "crease"), edgeOf(m, a, b));
}

fn boundaryEdges(m &PolyMesh) i64 {
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.isBoundaryEdge(e) { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

fn volume(m &PolyMesh) f32 {
  mut sum f32 = 0.;
  mut f = 0usize;
  while f < m.faceCount() {
    imm pts = m.facePositions(u32.from(f));
    mut i = 1usize;
    while i + 1usize < pts.len() {
      sum = sum + pts[0usize].dot(pts[i].cross(*pts[i + 1usize]));
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.;
}

fn cornerAt(m &PolyMesh, f u32, v u32) u32 {
  imm hs = m.faceHalfedges(f);
  mut i = 0usize;
  while i < hs.len() {
    if m.toVertex(*hs[i]) == v { return *hs[i]; }
    i = i + 1usize;
  }
  NoIndex;
}

fn uvAt(m &PolyMesh, f u32, v u32) Vec2 {
  imm h = cornerAt(m, f, v);
  if h == NoIndex { return new Vec2(-1., -1.); }
  m.vec2(m.findVec2Channel(CornerDomain, "uv"), h);
}

fn uv(m &PolyMesh, f u32, v u32, u f32, w f32, label &Array[u8]) {
  imm got = uvAt(m, f, v);
  expectFloat(got.x, u, near, label);
  expectFloat(got.y, w, near, label);
}

fn floatAt(m &PolyMesh, domain u32, name &str, e u32) f32 {m.float(m.findFloatChannel(domain, name), e);}

fn twoTubes(offset Vec3) PolyMesh {
  imm sq = Profile.rectangle(1., 1.);
  imm t = extrude(&sq, new Vec3(0., 0., 1.), 1u32, false);
  mut two = arrayLinear(&t, 2u32, offset, -1.);
  imm ch = two.addFloatChannel(EdgeDomain, "crease", 0.);
  two.setFloat(ch, edgeOf(&two, 4u32, 5u32), 2.);
  two;
}

fn tubes() {
  imm two = twoTubes(new Vec3(0., 0., 2.));
  imm la Array[u32, 4] = [4u32, 5u32, 6u32, 7u32];
  loopIs(&boundaryLoop(&two, 4u32), &la, "tubes: the top hole from 4");
  imm lb Array[u32, 4] = [8u32, 11u32, 10u32, 9u32];
  loopIs(&boundaryLoop(&two, 8u32), &lb, "tubes: the bottom hole from 8");
  expectInt(i64.from(boundaryLoop(&PolyMesh.cube(1.), 0u32).len()), 0, "a cube's vertex is on no boundary");

  imm pair Array[u32, 2] = [4u32, 8u32];
  imm m = bridgeLoops(&two, &pair, 0u32, 0.);
  clean(&m, "tubes: validates");
  counts(&m, 16, 28, 12, "tubes: 16 vertices, 28 edges, 12 faces");
  expectInt(boundaryEdges(&m), 8, "tubes: the two ends open");
  imm f8 Array[u32, 4] = [4u32, 5u32, 9u32, 8u32];
  face(&m, 8u32, &f8, "tubes: face 8");
  imm f11 Array[u32, 4] = [7u32, 4u32, 8u32, 11u32];
  face(&m, 11u32, &f11, "tubes: face 11 closes the band");
  point(m.faceNormal(8u32), 0., -1., 0., "tubes: face 8 faces out");
  uv(&m, 8u32, 9u32, 0.25, 1., "tubes: face 8's uv at 9");
  uv(&m, 11u32, 4u32, 1., 0., "tubes: face 11's uv at 4, the seam");
  expectFloat(creaseOf(&m, 4u32, 5u32), 2., near, "tubes: the crease on 4-5 stays");
  expectFloat(creaseOf(&m, 4u32, 8u32), 0., near, "tubes: the rung 4-8 has none");

  imm c = bridgeLoops(&two, &pair, 1u32, 0.);
  clean(&c, "one cut: validates");
  counts(&c, 20, 36, 16, "one cut: 20 vertices, 36 edges, 16 faces");
  point(*c.positions[16usize], -0.5, -0.5, 1.5, "one cut: vertex 16");
  point(*c.positions[17usize], 0.5, -0.5, 1.5, "one cut: vertex 17");
  imm g8 Array[u32, 4] = [4u32, 5u32, 17u32, 16u32];
  face(&c, 8u32, &g8, "one cut: face 8");
  imm g12 Array[u32, 4] = [16u32, 17u32, 9u32, 8u32];
  face(&c, 12u32, &g12, "one cut: face 12");
  expectFloat(floatAt(&c, VertexDomain, "along", 16u32), 0.5, near, "one cut: along blended");
  expectFloat(floatAt(&c, VertexDomain, "around", 17u32), 0.25, near, "one cut: around blended");
  uv(&c, 12u32, 16u32, 0., 0.5, "one cut: face 12's uv at 16");

  imm off = twoTubes(new Vec3(1., 0., 2.));
  imm s = bridgeLoops(&off, &pair, 2u32, 1.);
  clean(&s, "smooth: validates");
  counts(&s, 24, 44, 20, "smooth: 24 vertices, two rings of cuts");
  point(*s.positions[16usize], -0.2407407, -0.5, 1.3640159, "smooth: leaves along the tube");
  imm l = bridgeLoops(&off, &pair, 2u32, 0.);
  point(*l.positions[16usize], -0.5 + 1. / 3., -0.5, 1. + 1. / 3., "smoothness 0: on the line");
}

fn boxFaces() PolyMesh {
  imm pts Array[Vec3, 12] = [new Vec3(-1., -1., 0.), new Vec3(1., -1., 0.), new Vec3(1., 1., 0.), new Vec3(-1., 1., 0.),
    new Vec3(-1., -1., 1.), new Vec3(0., -1., 1.), new Vec3(1., -1., 1.), new Vec3(1., 0., 1.), new Vec3(1., 1., 1.),
    new Vec3(0., 1., 1.), new Vec3(-1., 1., 1.), new Vec3(-1., 0., 1.)];
  imm cnt Array[u32, 2] = [4u32, 8u32];
  imm idx Array[u32, 12] = [0u32, 3u32, 2u32, 1u32, 4u32, 5u32, 6u32, 7u32, 8u32, 9u32, 10u32, 11u32];
  mut problems = List[String].empty();
  mut m = PolyMesh.fromPolygons(&pts, &cnt, &idx, &mut problems);
  imm w = m.addFloatChannel(VertexDomain, "w", 0.);
  mut v = 0u32;
  while usize.from(v) < m.vertexCount() {
    m.setFloat(w, v, f32.from(v));
    v = v + 1u32;
  }
  imm id = m.addFloatChannel(FaceDomain, "id", 0.);
  imm cr = m.addFloatChannel(EdgeDomain, "crease", 0.);
  imm uvc = m.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  imm c = m.addFloatChannel(CornerDomain, "c", 0.);
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    m.setFloat(id, f, 10. + f32.from(f));
    imm hs = m.faceHalfedges(f);
    mut k = 0usize;
    while k < hs.len() {
      m.setFloat(c, *hs[k], 10. * f32.from(f) + f32.from(m.toVertex(*hs[k])));
      m.setVec2(uvc, *hs[k], new Vec2(0.5, 0.5));
      k = k + 1usize;
    }
    f = f + 1u32;
  }
  m.setFloat(cr, edgeOf(&m, 0u32, 1u32), 3.);
  m;
}

fn unequal() {
  imm m = boxFaces();
  imm la Array[u32, 4] = [0u32, 1u32, 2u32, 3u32];
  loopIs(&boundaryLoop(&m, 0u32), &la, "unequal: the square's hole");
  imm pair Array[u32, 2] = [0u32, 4u32];
  imm b = bridgeLoops(&m, &pair, 0u32, 0.);
  clean(&b, "unequal: validates");
  counts(&b, 12, 20, 10, "unequal: 12 vertices, 20 edges, 10 faces");
  expectInt(boundaryEdges(&b), 0, "unequal: closed");
  expectFloat(volume(&b), 4., near, "unequal: volume 4");
  imm f2 Array[u32, 3] = [0u32, 5u32, 4u32];
  face(&b, 2u32, &f2, "unequal: face 2, a triangle");
  imm f3 Array[u32, 4] = [0u32, 1u32, 6u32, 5u32];
  face(&b, 3u32, &f3, "unequal: face 3, a quad");
  imm f4 Array[u32, 3] = [1u32, 7u32, 6u32];
  face(&b, 4u32, &f4, "unequal: face 4");
  imm f8 Array[u32, 3] = [3u32, 11u32, 10u32];
  face(&b, 8u32, &f8, "unequal: face 8");
  imm f9 Array[u32, 4] = [3u32, 0u32, 4u32, 11u32];
  face(&b, 9u32, &f9, "unequal: face 9 closes the band");
  expectFloat(floatAt(&b, FaceDomain, "id", 2u32), 10., near, "unequal: face 2's id is face 0's");
  expectFloat(floatAt(&b, FaceDomain, "id", 9u32), 10., near, "unequal: face 9's id is face 0's");
  imm cch = b.findFloatChannel(CornerDomain, "c");
  expectFloat(b.float(cch, cornerAt(&b, 3u32, 0u32)), 0., near, "unequal: face 3's c at 0");
  expectFloat(b.float(cch, cornerAt(&b, 3u32, 1u32)), 1., near, "unequal: face 3's c at 1");
  expectFloat(b.float(cch, cornerAt(&b, 3u32, 6u32)), 16., near, "unequal: face 3's c at 6");
  expectFloat(b.float(cch, cornerAt(&b, 3u32, 5u32)), 15., near, "unequal: face 3's c at 5");
  uv(&b, 2u32, 5u32, 0.125, 1., "unequal: face 2's uv at 5");
  uv(&b, 9u32, 0u32, 1., 0., "unequal: face 9's uv at 0, the seam");
  uv(&b, 9u32, 11u32, 0.875, 1., "unequal: face 9's uv at 11");
  uv(&b, 0u32, 0u32, 0.5, 0.5, "unequal: face 0's own uv kept");
  expectFloat(creaseOf(&b, 0u32, 1u32), 3., near, "unequal: the crease on 0-1 kept");
  expectFloat(creaseOf(&b, 0u32, 5u32), 0., near, "unequal: a rung has none");

  imm c = bridgeLoops(&m, &pair, 1u32, 0.);
  clean(&c, "unequal, one cut: validates");
  counts(&c, 20, 36, 18, "unequal, one cut: 20 vertices, 36 edges, 18 faces");
  expectInt(boundaryEdges(&c), 0, "unequal, one cut: closed");
  expectFloat(volume(&c), 4., near, "unequal, one cut: volume 4");
  point(*c.positions[12usize], -1., -1., 0.5, "unequal, one cut: vertex 12");
  point(*c.positions[13usize], 0., -1., 0.5, "unequal, one cut: vertex 13");
  expectFloat(floatAt(&c, VertexDomain, "w", 13u32), 2.75, near, "unequal, one cut: 13's w");
  expectFloat(floatAt(&c, VertexDomain, "w", 12u32), 2., near, "unequal, one cut: 12's w");
}

fn skipped() {
  imm m = boxFaces();
  imm same Array[u32, 2] = [0u32, 2u32];
  imm a = bridgeLoops(&m, &same, 1u32, 0.);
  counts(&a, 12, 12, 2, "skipped: one loop twice");
  imm cube = PolyMesh.cube(1.);
  imm pair Array[u32, 2] = [0u32, 7u32];
  imm b = bridgeLoops(&cube, &pair, 1u32, 0.);
  counts(&b, 8, 12, 6, "skipped: no boundary");
  imm lone Array[u32, 1] = [0u32];
  imm c = bridgeLoops(&m, &lone, 1u32, 0.);
  counts(&c, 12, 12, 2, "skipped: a lone loop");
}

fn main() i32 {
  tubes();
  unequal();
  skipped();
  done();
}
