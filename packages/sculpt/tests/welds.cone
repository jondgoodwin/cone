// The sculpt package's weld, merging vertices by distance, checked with the
// testing package against values worked out by hand; only a failure prints,
// so welds.out holds the summary alone.
//
// - The pair: quad A, vertices 0 (0,0,0), 1 (1,0,0), 2 (1,1,0), 3 (0,1,0),
//   face 0 (0, 1, 2, 3); quad B, 4 (1.0005,0,0), 5 (2,0,0), 6 (2,1,0), 7
//   (1.0005,1,0), face 1 (4, 5, 6, 7), a gap of 0.0005 between them; both
//   face +z. Channels: vertex "w" = v; face "id" 10 + f; edge "crease" 2 on
//   B's left side 7-4 (A's 1-2 has 0); edge "mark" 1 on A's 1-2 and 5 on B's
//   7-4; corner "uv" (v / 8, f / 8) at vertex v of face f.
//   Welded at 0.001: 4 joins 1 and 7 joins 2 (0.0005 apart), nothing else is
//   within 0.001. Each cluster keeps its lowest vertex, at its own place:
//   vertex 1 stays at (1, 0, 0). Kept 0, 1, 2, 3, 5, 6, renumbered: vertex 4
//   (old 5) at (2, 0, 0), 5 (old 6) at (2, 1, 0); face 1 is (1, 4, 5, 2),
//   still facing +z: 6 vertices, 7 edges, 2 faces, 6 boundary edges. Edge 1-2
//   is A's and B's sides merged: crease the greater, 2; mark the first face's
//   (A's), 1. Vertex 4's w is old 5's, 5; vertex 1's its own, 1. Face 1's
//   corner at 1 is B's corner at old 4: uv (0.5, 0.125); face 0's at 1 is A's,
//   (0.125, 0).
//   Welded at 0.0004, nothing merges: 8 vertices; at -1, nothing.
// - The collapse: quad A again; quad B' (1, 4, 5, 2) with 4 (2,0,0) and 5
//   (1.0003,1,0), 0.0003 from vertex 2; triangle C (4, 6, 5) with 6
//   (2.0002,0.0001,0), 0.000224 from vertex 4. Channels as the pair's, but
//   crease 2 on edge 4-5, 3 on edge 5-2, and none on 1-2.
//   Welded at 0.001: 5 -> 2 and 6 -> 4; kept 0 to 4. B' becomes (1, 4, 2, 2),
//   its side 5-2 gone: the triangle (1, 4, 2), facing +z; its corner at 2 is
//   the run's lowest vertex's, old 2's: uv (0.25, 0.125). C becomes (4, 4, 2),
//   two corners, and goes. 5 vertices, 2 faces, 4 + 3 - 1 = 6 edges, 5 on the
//   boundary (1-2 is inside). Edge 4-2 is old 4-5: crease 2; the side 5-2 and
//   its crease 3 are gone: one edge of crease 2, five of 0, none of 3.
//   Vertex 4's w is 4, vertex 2's 2; face 1's id is B''s, 11.
// - The chain: four loose vertices, 0 (0.0008,0,0), 1 (0,0,0), 2 (0.0016,0,0),
//   3 (5,0,0). At 0.001, 1 joins 0 and 0 joins 2 (0.0008 apart each; 1 and 2
//   are 0.0016 apart, and in neighbouring cells of the hash), so 0, 1 and 2
//   are one cluster, kept as vertex 0, the lowest, at (0.0008, 0, 0); vertex 3
//   becomes 1: 2 vertices.

mod welds;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn point2(got Vec2, x f32, y f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
}

fn clean(m &PolyMesh, label &Array[u8]) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &Array[u8]) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn edgeOf(m &PolyMesh, a u32, b u32) u32 {
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    imm p = *m.hVertex[usize.from(2u32 * e)];
    imm q = *m.hVertex[usize.from(2u32 * e + 1u32)];
    if (p == a and q == b) or (p == b and q == a) { return e; }
    e = e + 1u32;
  }
  NoIndex;
}

fn boundaryEdges(m &PolyMesh) i64 {
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.isBoundaryEdge(e) { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

fn countEdgesWith(m &PolyMesh, name &str, value f32) i64 {
  imm ch = m.findFloatChannel(EdgeDomain, name);
  if ch == NoIndex { return -1; }
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.float(ch, e) == value { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

// The corner uv of face f at vertex v
fn uvAt(m &PolyMesh, f u32, v u32) Vec2 {
  imm ch = m.findVec2Channel(CornerDomain, "uv");
  imm hs = m.faceHalfedges(f);
  mut i = 0usize;
  while i < hs.len() {
    if m.toVertex(*hs[i]) == v { return m.vec2(ch, *hs[i]); }
    i = i + 1usize;
  }
  new Vec2(-1., -1.);
}

// The channels every mesh here gets: vertex w, face id, edge crease and mark
// (0 everywhere until set), and corner uv
fn addChannels(m &mut PolyMesh) {
  imm w = m.addFloatChannel(VertexDomain, "w", 0.);
  mut v = 0u32;
  while usize.from(v) < m.vertexCount() {
    m.setFloat(w, v, f32.from(v));
    v = v + 1u32;
  }
  imm id = m.addFloatChannel(FaceDomain, "id", 0.);
  m.addFloatChannel(EdgeDomain, "crease", 0.);
  m.addFloatChannel(EdgeDomain, "mark", 0.);
  imm uv = m.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    m.setFloat(id, f, 10. + f32.from(f));
    imm hs = m.faceHalfedges(f);
    mut i = 0usize;
    while i < hs.len() {
      m.setVec2(uv, *hs[i], new Vec2(f32.from(m.toVertex(*hs[i])) / 8., f32.from(f) / 8.));
      i = i + 1usize;
    }
    f = f + 1u32;
  }
}

fn setEdge(m &mut PolyMesh, name &str, a u32, b u32, value f32) {
  imm ch = m.findFloatChannel(EdgeDomain, name);
  imm e = edgeOf(m, a, b);
  m.setFloat(ch, e, value);
}

fn pair() PolyMesh {
  imm pts Array[Vec3, 8] = [new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), new Vec3(1., 1., 0.), new Vec3(0., 1., 0.),
    new Vec3(1.0005, 0., 0.), new Vec3(2., 0., 0.), new Vec3(2., 1., 0.), new Vec3(1.0005, 1., 0.)];
  imm sizes Array[u32, 2] = [4u32, 4u32];
  imm faces Array[u32, 8] = [0u32, 1u32, 2u32, 3u32,  4u32, 5u32, 6u32, 7u32];
  mut problems = List[String].empty();
  mut m = PolyMesh.fromPolygons(&pts, &sizes, &faces, &mut problems);
  addChannels(&mut m);
  setEdge(&mut m, "crease", 7u32, 4u32, 2.);
  setEdge(&mut m, "mark", 1u32, 2u32, 1.);
  setEdge(&mut m, "mark", 7u32, 4u32, 5.);
  m;
}

fn welded() {
  imm p = pair();
  imm m = weld(&p, 0.001);
  clean(&m, "pair: validates");
  counts(&m, 6, 7, 2, "pair: 6 vertices, 7 edges, 2 faces");
  expectInt(boundaryEdges(&m), 6, "pair: 6 boundary edges");
  point(*m.positions[1usize], 1., 0., 0., "pair: vertex 1 keeps its place");
  point(*m.positions[4usize], 2., 0., 0., "pair: vertex 4, old 5");
  point(*m.positions[5usize], 2., 1., 0., "pair: vertex 5, old 6");
  imm vs = m.faceVertices(1u32);
  expectInt(i64.from(vs.len()), 4, "pair: face 1 a quad");
  if vs.len() == 4usize {
    expectInt(i64.from(*vs[0usize]), 1, "pair: face 1 corner 0");
    expectInt(i64.from(*vs[1usize]), 4, "pair: face 1 corner 1");
    expectInt(i64.from(*vs[2usize]), 5, "pair: face 1 corner 2");
    expectInt(i64.from(*vs[3usize]), 2, "pair: face 1 corner 3");
  }
  point(m.faceNormal(1u32), 0., 0., 1., "pair: face 1 faces +z");
  imm crease = m.findFloatChannel(EdgeDomain, "crease");
  require(crease != NoIndex, "pair: crease carried");
  expectFloat(m.float(crease, edgeOf(&m, 1u32, 2u32)), 2., near, "pair: 1-2 takes the greater crease");
  imm mark = m.findFloatChannel(EdgeDomain, "mark");
  require(mark != NoIndex, "pair: mark carried");
  expectFloat(m.float(mark, edgeOf(&m, 1u32, 2u32)), 1., near, "pair: 1-2 takes the first face's mark");
  imm w = m.findFloatChannel(VertexDomain, "w");
  expectFloat(m.float(w, 4u32), 5., near, "pair: vertex 4's w is old 5's");
  expectFloat(m.float(w, 1u32), 1., near, "pair: vertex 1 keeps its w");
  imm id = m.findFloatChannel(FaceDomain, "id");
  expectFloat(m.float(id, 1u32), 11., near, "pair: face 1's id");
  point2(uvAt(&m, 1u32, 1u32), 0.5, 0.125, "pair: face 1's corner at 1 is B's at old 4");
  point2(uvAt(&m, 0u32, 1u32), 0.125, 0., "pair: face 0's corner at 1 is A's");

  imm apart = weld(&p, 0.0004);
  clean(&apart, "pair at 0.0004: validates");
  counts(&apart, 8, 8, 2, "pair at 0.0004: nothing merged");
  imm none = weld(&p, -1.);
  counts(&none, 8, 8, 2, "pair at -1: nothing merged");
}

fn collapsed() {
  imm pts Array[Vec3, 7] = [new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), new Vec3(1., 1., 0.), new Vec3(0., 1., 0.),
    new Vec3(2., 0., 0.), new Vec3(1.0003, 1., 0.), new Vec3(2.0002, 0.0001, 0.)];
  imm sizes Array[u32, 3] = [4u32, 4u32, 3u32];
  imm faces Array[u32, 11] = [0u32, 1u32, 2u32, 3u32,  1u32, 4u32, 5u32, 2u32,  4u32, 6u32, 5u32];
  mut problems = List[String].empty();
  mut src = PolyMesh.fromPolygons(&pts, &sizes, &faces, &mut problems);
  expectInt(i64.from(src.faceCount()), 3, "collapse: the source has 3 faces");
  addChannels(&mut src);
  setEdge(&mut src, "crease", 4u32, 5u32, 2.);
  setEdge(&mut src, "crease", 5u32, 2u32, 3.);

  imm m = weld(&src, 0.001);
  clean(&m, "collapse: validates");
  counts(&m, 5, 6, 2, "collapse: 5 vertices, 6 edges, 2 faces");
  expectInt(boundaryEdges(&m), 5, "collapse: 5 boundary edges");
  imm vs = m.faceVertices(1u32);
  expectInt(i64.from(vs.len()), 3, "collapse: face 1 a triangle");
  if vs.len() == 3usize {
    expectInt(i64.from(*vs[0usize]), 1, "collapse: face 1 corner 0");
    expectInt(i64.from(*vs[1usize]), 4, "collapse: face 1 corner 1");
    expectInt(i64.from(*vs[2usize]), 2, "collapse: face 1 corner 2");
  }
  point(m.faceNormal(1u32), 0., 0., 1., "collapse: face 1 faces +z");
  point2(uvAt(&m, 1u32, 2u32), 0.25, 0.125, "collapse: the merged corner is old 2's");
  imm crease = m.findFloatChannel(EdgeDomain, "crease");
  expectFloat(m.float(crease, edgeOf(&m, 4u32, 2u32)), 2., near, "collapse: 4-2 is old 4-5");
  expectInt(countEdgesWith(&m, "crease", 2.), 1, "collapse: one edge of crease 2");
  expectInt(countEdgesWith(&m, "crease", 0.), 5, "collapse: five of 0");
  expectInt(countEdgesWith(&m, "crease", 3.), 0, "collapse: the collapsed side's crease gone");
  imm w = m.findFloatChannel(VertexDomain, "w");
  expectFloat(m.float(w, 4u32), 4., near, "collapse: vertex 4's w");
  expectFloat(m.float(w, 2u32), 2., near, "collapse: vertex 2's w");
  imm id = m.findFloatChannel(FaceDomain, "id");
  expectFloat(m.float(id, 1u32), 11., near, "collapse: face 1's id is B''s");
}

fn chain() {
  imm pts Array[Vec3, 4] = [new Vec3(0.0008, 0., 0.), new Vec3(0., 0., 0.), new Vec3(0.0016, 0., 0.),
    new Vec3(5., 0., 0.)];
  imm sizes = List[u32].empty();
  imm faces = List[u32].empty();
  mut problems = List[String].empty();
  imm src = PolyMesh.fromPolygons(&pts, sizes.view(), faces.view(), &mut problems);
  imm m = weld(&src, 0.001);
  clean(&m, "chain: validates");
  expectInt(i64.from(m.vertexCount()), 2, "chain: one cluster and one alone");
  point(*m.positions[0usize], 0.0008, 0., 0., "chain: kept as its lowest vertex");
  point(*m.positions[1usize], 5., 0., 0., "chain: vertex 3 is now 1");
}

fn main() i32 {
  welded();
  collapsed();
  chain();
  done();
}
