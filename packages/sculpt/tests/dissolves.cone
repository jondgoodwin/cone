// The sculpt package's planar dissolve, checked with the testing package
// against values worked out by hand; only a failure prints, so dissolves.out
// holds the summary alone.
//
// - The flat grid: 4 x 4 unit quads over the unit square (vertex i + 5j at
//   (i/4, j/4, 0)), vertex "w" = x + y, corner "uv" = (x, y), face "id" = its
//   number. Every face faces +z, so at 0.01 radians all 16 are one region
//   (seed face 0), its outline one loop of 16 sides: one face. The 9
//   vertices inside go; each of the 12 boundary vertices between corners is
//   on two straight edges (turn 0), so goes too: 4 vertices, old 0, 4, 20,
//   24, at (0,0), (1,0), (0,1), (1,1); one quad of area 1 facing +z, 4
//   edges, all boundary; its id 0 (its seed's), each corner's uv its
//   vertex's (x, y), each vertex's w its x + y.
// - The flat cube: the cube cage with every edge infinitely creased,
//   subdivided twice (each face a flat 4 x 4 grid), creases then 0. Each
//   side is one region, its 12 outline vertices other than corners on two
//   straight edges: back to the cage, 8 vertices exactly where they were, 6
//   quads, 12 edges, closed, volume 8.
// - The creased grid: "crease" 2 on the four sides along y = 0.5 stops the
//   regions there: two faces, y below and above 0.5. The crease's ends (0,
//   0.5) and (1, 0.5) are on three edges and stay; the 3 vertices between
//   them are on two edges of crease 2 each, in a line, and go: 6 vertices,
//   2 faces, 7 edges, one of them (0, 0.5)-(1, 0.5) with crease 2 (its last
//   edge's).
// - The seam grid: the faces right of x = 0.5 have corner uv (x + 10, y), so
//   the uvs differ across x = 0.5, a seam: two faces, left and right, 6
//   vertices (the corners and (0.5, 0), (0.5, 1)), each face's corners
//   keeping their own uvs.
// - The ring: a flat 3 x 3 grid with "crease" 1 on the centre face's four
//   sides. The centre is a region alone; the other 8 make one region round
//   a hole, two outline loops, so its faces stay as they were; every vertex
//   is on three edges or more or at a corner turn: nothing changes, 16
//   vertices, 9 faces.
// - The cylinder: the line x = 1, y = 0 to 1 in 4 pieces lathed in 16 steps
//   (each column's 4 quads coplanar, neighbouring columns 22.5 degrees
//   apart). At 0.1 radians each column is a region and one face; the
//   vertices between rows are then each on two vertical edges and go: 32
//   vertices, 16 quads, each with two corners at y = 0 and two at y = 1;
//   the seam corners keep u 0 or 1.
// - The vase, a cubic profile lathed, has no two neighbouring faces
//   coplanar and no vertex on only two edges: at 0 radians it is unchanged.

mod dissolves;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

let near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn counts(m &PolyMesh, nv i64, nf i64, label &Array[u8]) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn clean(m &PolyMesh, label &Array[u8]) {
  let problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn absf(a f32) f32 {if a < 0. {-a} else {a}}

fn boundaryEdges(m &PolyMesh) i64 {
  var n = 0i64;
  var e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.isBoundaryEdge(e) { n = n + 1; }
    e = e + 1u32;
  }
  n
}

// The total area of a mesh's faces, each a fan from its first corner
fn totalArea(m &PolyMesh) f64 {
  var a = 0.d;
  var f = 0u32;
  while usize.from(f) < m.faceCount() {
    let p = m.facePositions(f);
    var k = 1usize;
    while k + 1usize < p.len() {
      let n = (*p[k] - *p[0usize]).cross(*p[k + 1usize] - *p[0usize]);
      a = a + f64.from(n.length()) * 0.5d;
      k = k + 1usize;
    }
    f = f + 1u32;
  }
  a
}

// The volume a closed mesh bounds, each face a fan from its first corner
fn volume(m &PolyMesh) f64 {
  var v = 0.d;
  var f = 0u32;
  while usize.from(f) < m.faceCount() {
    let p = m.facePositions(f);
    var k = 1usize;
    while k + 1usize < p.len() {
      v = v + f64.from((*p[0usize]).dot((*p[k]).cross(*p[k + 1usize]))) / 6.d;
      k = k + 1usize;
    }
    f = f + 1u32;
  }
  v
}

fn edgeOf(m &PolyMesh, a u32, b u32) u32 {
  var e = 0u32;
  while usize.from(e) < m.edgeCount() {
    let p = *m.hVertex[usize.from(2u32 * e)];
    let q = *m.hVertex[usize.from(2u32 * e + 1u32)];
    if (p == a and q == b) or (p == b and q == a) { return e; }
    e = e + 1u32;
  }
  NoIndex
}

// An n x n grid over the unit square, as decimates.cone's; faces right of
// x = 'seamAt' get u + 10
fn grid(n u32, seamAt f32) PolyMesh {
  var pts = List[Vec3].empty();
  var j = 0u32;
  while j <= n {
    var i = 0u32;
    while i <= n {
      pts.push(new Vec3(f32.from(i) / f32.from(n), f32.from(j) / f32.from(n), 0.));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  var sizes = List[u32].empty();
  var idx = List[u32].empty();
  j = 0u32;
  while j < n {
    var i = 0u32;
    while i < n {
      let a = i + (n + 1u32) * j;
      sizes.push(4u32);
      idx.push(a);
      idx.push(a + 1u32);
      idx.push(a + n + 2u32);
      idx.push(a + n + 1u32);
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  var problems = List[String].empty();
  var m = PolyMesh.fromPolygons(pts.view(), sizes.view(), idx.view(), &mut problems);
  let w = m.addFloatChannel(VertexDomain, "w", 0.);
  var v = 0u32;
  while usize.from(v) < m.vertexCount() {
    let p = *m.positions[usize.from(v)];
    m.setFloat(w, v, p.x + p.y);
    v = v + 1u32;
  }
  let id = m.addFloatChannel(FaceDomain, "id", 0.);
  let uv = m.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  var f = 0u32;
  while usize.from(f) < m.faceCount() {
    m.setFloat(id, f, f32.from(f));
    let right = m.faceCentroid(f).x > seamAt;
    let hs = m.faceHalfedges(f);
    var k = 0usize;
    while k < hs.len() {
      let p = *m.positions[usize.from(m.toVertex(*hs[k]))];
      let u = if right {p.x + 10.} else {p.x};
      m.setVec2(uv, *hs[k], new Vec2(u, p.y));
      k = k + 1usize;
    }
    f = f + 1u32;
  }
  m
}

fn flatGrid() {
  let g = grid(4u32, 2.);
  let m = dissolvePlanar(&g, 0.01);
  clean(&m, "grid: validates");
  counts(&m, 4, 1, "grid: one quad");
  point(*m.positions[0usize], 0., 0., 0., "grid: vertex 0");
  point(*m.positions[1usize], 1., 0., 0., "grid: vertex 1, old 4");
  point(*m.positions[2usize], 0., 1., 0., "grid: vertex 2, old 20");
  point(*m.positions[3usize], 1., 1., 0., "grid: vertex 3, old 24");
  expectInt(i64.from(m.faceDegree(0u32)), 4, "grid: 4 corners");
  expectFloat(totalArea(&m), 1.d, near, "grid: area 1");
  expectFloat(m.faceNormal(0u32).z, 1., near, "grid: faces +z");
  expectInt(i64.from(m.edgeCount()), 4, "grid: 4 edges");
  expectInt(boundaryEdges(&m), 4, "grid: all on the boundary");
  let id = m.findFloatChannel(FaceDomain, "id");
  expectFloat(m.float(id, 0u32), 0., 0.d, "grid: the seed's id");
  let uv = m.findVec2Channel(CornerDomain, "uv");
  let hs = m.faceHalfedges(0u32);
  var k = 0usize;
  while k < hs.len() {
    let p = *m.positions[usize.from(m.toVertex(*hs[k]))];
    let t = m.vec2(uv, *hs[k]);
    expectFloat(t.x, p.x, near, "grid: a corner's u is its x");
    expectFloat(t.y, p.y, near, "grid: a corner's v is its y");
    k = k + 1usize;
  }
  let w = m.findFloatChannel(VertexDomain, "w");
  var v = 0u32;
  while usize.from(v) < m.vertexCount() {
    let p = *m.positions[usize.from(v)];
    expectFloat(m.float(w, v), p.x + p.y, near, "grid: w is x + y");
    v = v + 1u32;
  }
}

fn flatCube() PolyMesh {
  var cube = PolyMesh.cube(1.);
  let ch = cube.addFloatChannel(EdgeDomain, "crease", 0.);
  var e = 0u32;
  while usize.from(e) < cube.edgeCount() {
    cube.setFloat(ch, e, SharpnessInfinite);
    e = e + 1u32;
  }
  var sub = subdivide(&cube, 2u32);
  let ch2 = sub.findFloatChannel(EdgeDomain, "crease");
  e = 0u32;
  while usize.from(e) < sub.edgeCount() {
    sub.setFloat(ch2, e, 0.);
    e = e + 1u32;
  }
  sub
}

fn cubes() {
  let c = flatCube();
  let m = dissolvePlanar(&c, 0.01);
  clean(&m, "cube: validates");
  counts(&m, 8, 6, "cube: back to the cage");
  var v = 0usize;
  while v < 8usize {
    let p = *m.positions[v];
    let x = if v % 2usize == 1usize {1.} else {-1.};
    let y = if (v / 2usize) % 2usize == 1usize {1.} else {-1.};
    let z = if v / 4usize == 1usize {1.} else {-1.};
    expect(p.x == x and p.y == y and p.z == z, "cube: a corner exactly where it was");
    v = v + 1usize;
  }
  var f = 0u32;
  while f < 6u32 {
    expectInt(i64.from(m.faceDegree(f)), 4, "cube: a quad");
    f = f + 1u32;
  }
  expectInt(i64.from(m.edgeCount()), 12, "cube: 12 edges");
  expectInt(boundaryEdges(&m), 0, "cube: closed");
  expectFloat(volume(&m), 8.d, near, "cube: volume 8, faces outward");
}

fn creases() {
  var g = grid(4u32, 2.);
  let ch = g.addFloatChannel(EdgeDomain, "crease", 0.);
  var i = 10u32;
  while i < 14u32 {
    g.setFloat(ch, edgeOf(&g, i, i + 1u32), 2.);
    i = i + 1u32;
  }
  let m = dissolvePlanar(&g, 0.01);
  clean(&m, "crease: validates");
  counts(&m, 6, 2, "crease: two faces");
  expectInt(i64.from(m.edgeCount()), 7, "crease: 7 edges");
  let c = m.findFloatChannel(EdgeDomain, "crease");
  var sharp = 0i64;
  var e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.float(c, e) == 2. {
      sharp = sharp + 1;
      let a = *m.positions[usize.from(m.toVertex(2u32 * e))];
      let b = *m.positions[usize.from(m.toVertex(2u32 * e + 1u32))];
      expectFloat(a.y, 0.5, near, "crease: along y = 0.5");
      expectFloat(b.y, 0.5, near, "crease: along y = 0.5");
      expectFloat(f64.from(absf(a.x - b.x)), 1.d, near, "crease: from x = 0 to 1");
    }
    e = e + 1u32;
  }
  expectInt(sharp, 1, "crease: one creased edge");
  expectFloat(totalArea(&m), 1.d, near, "crease: area 1");
}

fn seams() {
  let g = grid(4u32, 0.5);
  let m = dissolvePlanar(&g, 0.01);
  clean(&m, "seam: validates");
  counts(&m, 6, 2, "seam: left and right");
  let uv = m.findVec2Channel(CornerDomain, "uv");
  var f = 0u32;
  while usize.from(f) < m.faceCount() {
    let right = m.faceCentroid(f).x > 0.5;
    let hs = m.faceHalfedges(f);
    expectInt(i64.from(hs.len()), 4, "seam: a quad each");
    var k = 0usize;
    while k < hs.len() {
      let p = *m.positions[usize.from(m.toVertex(*hs[k]))];
      let t = m.vec2(uv, *hs[k]);
      let want = if right {p.x + 10.} else {p.x};
      expectFloat(t.x, want, near, "seam: a corner keeps its own u");
      k = k + 1usize;
    }
    f = f + 1u32;
  }
}

fn rings() {
  var g = grid(3u32, 2.);
  let ch = g.addFloatChannel(EdgeDomain, "crease", 0.);
  // The centre face is (5, 6, 10, 9)
  g.setFloat(ch, edgeOf(&g, 5u32, 6u32), 1.);
  g.setFloat(ch, edgeOf(&g, 6u32, 10u32), 1.);
  g.setFloat(ch, edgeOf(&g, 10u32, 9u32), 1.);
  g.setFloat(ch, edgeOf(&g, 9u32, 5u32), 1.);
  let m = dissolvePlanar(&g, 0.01);
  clean(&m, "ring: validates");
  counts(&m, 16, 9, "ring: a region round a hole keeps its faces");
}

fn cylinder() PolyMesh {
  let pts Array[Vec2, 5] = [new Vec2(1., 0.), new Vec2(1., 0.25), new Vec2(1., 0.5), new Vec2(1., 0.75), new Vec2(1., 1.)];
  let prof = Profile.fromPoints(&pts, false);
  lathe(&prof, new Vec3(0., 1., 0.), 6.2831853, 16u32)
}

fn cylinders() {
  let c = cylinder();
  let m = dissolvePlanar(&c, 0.1);
  clean(&m, "cylinder: validates");
  counts(&m, 32, 16, "cylinder: a face per column");
  let uv = m.findVec2Channel(CornerDomain, "uv");
  var f = 0u32;
  while usize.from(f) < m.faceCount() {
    let hs = m.faceHalfedges(f);
    expectInt(i64.from(hs.len()), 4, "cylinder: a quad");
    var low = 0i64;
    var lo f32 = 2.;
    var hi f32 = -1.;
    var k = 0usize;
    while k < hs.len() {
      let p = *m.positions[usize.from(m.toVertex(*hs[k]))];
      if absf(p.y) < 0.00001 { low = low + 1; }
      let t = m.vec2(uv, *hs[k]);
      if t.x < lo { lo = t.x; }
      if t.x > hi { hi = t.x; }
      k = k + 1usize;
    }
    expectInt(low, 2, "cylinder: two corners at the bottom");
    expect(hi - lo < 0.1, "cylinder: no face spans the seam");
    f = f + 1u32;
  }
}

fn vases() {
  let curve = new CubicBezier2(new Vec2(0.6, 0.), new Vec2(1.6, 0.6), new Vec2(0.2, 1.4), new Vec2(0.7, 2.));
  let prof = Profile.fromCubic(curve, 12u32);
  let s = lathe(&prof, new Vec3(0., 1., 0.), 6.2831853, 16u32);
  let m = dissolvePlanar(&s, 0.);
  clean(&m, "vase: validates");
  counts(&m, i64.from(s.vertexCount()), i64.from(s.faceCount()), "vase: unchanged at 0");
}

fn main() i32 {
  flatGrid();
  cubes();
  creases();
  seams();
  rings();
  cylinders();
  vases();
  done()
}
