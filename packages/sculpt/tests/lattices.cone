// The sculpt package's lattice (free-form deformation), checked with the
// testing package against values worked out by hand; only a failure prints,
// so lattices.out holds the summary alone.
//
// - The column: the square (-1,-1) (1,-1) (1,1) (-1,1) extruded along
//   (0,0,2) in 2 segments with caps, vertex 4i + j at z = i (12 vertices, 20
//   edges, 10 faces), its corner "uv" from extrude, and channels added: a
//   vertex "weight" (0.5, but 7 at vertex 6), an edge "crease" (1 on edge
//   0), a face "id" (3 on face 2).
// - The box round it: origin (-1,-1,0), axes (4,0,0), (0,4,0), (0,0,2), so a
//   vertex (x, y, z) is at s = (x + 1) / 4, t = (y + 1) / 4, u = z / 2:
//   vertex 0 (-1,-1,0) at the corner (0,0,0), 2 (1,1,0) at (1/2,1/2,0), 5
//   (1,-1,1) at (1/2,0,1/2), 6 (1,1,1) at the centre (1/2,1/2,1/2), 8
//   (-1,-1,2) at (0,0,1), 10 (1,1,2) at (1/2,1/2,1).
// - The weights. Bernstein, 4 points at s = 1/3: C(3,i) (1/3)^i (2/3)^(3-i)
//   = 8/27, 12/27, 6/27, 1/27. Linear, 3 points at s = 3/4: x = 1.5, cell 1,
//   f = 1/2: 0, 1/2, 1/2; at s = 1, the last cell closed: 0, 0, 1. B-spline,
//   5 points, degree 3, knots 0 0 0 0 1/2 1 1 1 1: at s = 1/4 (span 3, the
//   Cox-de Boor triangle worked by hand, and N0 = (1 - 2s)^3 = 1/8 directly)
//   1/8, 19/32, 1/4, 1/32, 0; at the knot s = 1/2, 0, 1/4, 1/2, 1/4, 0; at
//   0, 1 0 0 0 0, and at 1, 0 0 0 0 1 (clamped: the ends interpolate). Each
//   sums to 1. B-spline with 3 points is degree 2 on knots 0 0 0 1 1 1, the
//   Bernstein basis: at 1/2, 1/4, 1/2, 1/4. Bernstein and linear reproduce
//   the box: sum Wi(s) i / (n - 1) = s (at s = 0.3, n = 4).
// - Identity: every regular (unmoved) lattice, 2 x 2 x 2, 3 x 3 x 3 and
//   5 x 4 x 3, under each interpolation, gives the column back with every
//   position's bits unchanged.
// - One corner of a 2 x 2 x 2 lattice, control point (0,0,0), moved by
//   (0,0,-0.8). At 2 points every interpolation has the weights 1 - s, s
//   (Bernstein of degree 1, linear in one cell, the B-spline of degree 1),
//   so all three agree: control (0,0,0) weighs (1 - s)(1 - t)(1 - u).
//   Vertex 0 (weight 1) to (-1,-1,-0.8), the box corner moving exactly;
//   vertex 6, the centre (1/8), to (1,1,0.9); vertex 2 (1/4) to (1,1,-0.2);
//   vertex 5 (1/2 x 1 x 1/2 = 1/4) to (1,-1,0.8); vertex 10 (u = 1, weight 0)
//   stays at (1,1,2).
// - The middle control point (1,1,1) of a 3 x 3 x 3 lattice, resting at
//   (1,1,1), raised by (0,0,1). Bernstein: B(1,2)(1/2) = 2 (1/2)(1/2) = 1/2
//   per axis, so the centre, vertex 6, moves 1/8: to (1,1,1.125); vertex 5
//   (t = 0, B(1,2)(0) = 0) and vertex 2 (u = 0) stay. The B-spline of 3
//   points is the Bernstein basis, so the same. Linear: vertex 6 sits on the
//   control point (weight 1), to (1,1,2). Control (1,0,1), resting at
//   (1,-1,1), on vertex 5, moved by (0,-1,0): Bernstein weighs vertex 5
//   B(1,2)(1/2) B(0,2)(0) B(1,2)(1/2) = 1/2 x 1 x 1/2 = 1/4, to
//   (1,-1.25,1); linear 1, to (1,-2,1).
// - A 5 x 5 x 5 B-spline lattice: control (1,2,2) moved by (1,0,0). Vertex 6
//   at s = t = u = 1/2 weighs W1(1/2) W2(1/2) W2(1/2) = 1/4 x 1/2 x 1/2 =
//   1/16: to (1.0625,1,1). Vertex 2 (u = 0, W2(0) = 0) stays.
// - Partition of unity: every control point of a lattice moved by
//   (0.3,-0.2,0.5) moves every vertex by it, since each interpolation's
//   weights sum to 1: vertex 0 to (-0.7,-1.2,0.5), vertex 6 to (1.3,0.8,1.5),
//   checked for all three interpolations at 5 x 5 x 5 and for 3 x 4 x 5.
// - Outside the box: a 2 x 2 x 2 lattice over origin (-1,-1,0), axes
//   (4,0,0), (0,4,0), (0,0,1), so the column's top (z = 2, u = 2) is outside,
//   its middle (z = 1) on the box's top. Control (0,0,1), resting at
//   (-1,-1,1), raised by (0,0,1). u is held to 1 for the weights, so a
//   vertex above the box moves as the point of the top face below it does:
//   vertex 4 (-1,-1,1) (weight 1) to (-1,-1,2), and vertex 8 (-1,-1,2),
//   above it, also by 1, to (-1,-1,3); vertex 10 (1,1,2), held to
//   (1/2,1/2,1), weight 1/4, to (1,1,2.25); vertex 0 (u = 0) stays.
// - Orientation: the column's own box (origin (-1,-1,0), axes (2,0,0),
//   (0,2,0), (0,0,2)), 2 x 2 x 2, its four top control points raised by
//   (0,0,1): each vertex rises by u = z / 2, so z goes to 1.5 z, a
//   stretch: vertex 6 to (1,1,1.5), vertex 10 to (1,1,3), and the volume,
//   by the divergence theorem over the faces, from 2 x 2 x 2 = 8 to 12,
//   positive, so every face still faces out. The same for each
//   interpolation.
// - Channels: every float and vec2 channel (uv, weight, crease, id) comes
//   through with its bits unchanged, and the half-edge lists are the same.
// - Determinism: the same deformation twice gives the same bits.
// - The lattice's own methods: a 3 x 4 x 5 lattice numbers (1,2,3) as
//   1 + 3 (2 + 4 x 3) = 43; control (1,2,3) rests at origin + (1/2, 2/3,
//   3/4) of the axes; setPoint and movePoint put and move it; a resolution
//   of 1 is held to 2.

mod lattices;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &[]u8) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn clean(m &PolyMesh, label &[]u8) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn column() PolyMesh {
  imm sq = Profile.rectangle(2., 2.);
  mut m = extrude(&sq, new Vec3(0., 0., 2.), 2u32, true);
  imm w = m.addFloatChannel(VertexDomain, "weight", 1.);
  mut v = 0u32;
  while usize.from(v) < m.vertexCount() {
    m.setFloat(w, v, 0.5);
    v = v + 1u32;
  }
  m.setFloat(w, 6u32, 7.);
  imm cr = m.addFloatChannel(EdgeDomain, "crease", 0.);
  m.setFloat(cr, 0u32, 1.);
  imm id = m.addFloatChannel(FaceDomain, "id", 0.);
  m.setFloat(id, 2u32, 3.);
  m;
}

// The box round the column: s = (x + 1) / 4, t = (y + 1) / 4, u = z / 2
fn around(l u32, m u32, n u32) Lattice {
  Lattice.regular(new Vec3(-1., -1., 0.), new Vec3(4., 0., 0.), new Vec3(0., 4., 0.), new Vec3(0., 0., 2.), l, m, n);
}

fn volume(m &PolyMesh) f32 {
  mut sum f32 = 0.;
  mut f = 0usize;
  while f < m.faceCount() {
    imm pts = m.facePositions(u32.from(f));
    mut i = 1usize;
    while i + 1usize < pts.len() {
      sum = sum + pts[0usize].dot(pts[i].cross(*pts[i + 1usize]));
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.;
}

// How many positions differ in their bits between a and b
fn positionDiffs(a &PolyMesh, b &PolyMesh) i64 {
  mut n = 0i64;
  mut v = 0usize;
  while v < a.positions.len() {
    imm p = *a.positions[v];
    imm q = *b.positions[v];
    if p.x != q.x or p.y != q.y or p.z != q.z { n = n + 1; }
    v = v + 1usize;
  }
  n;
}

// How many channel values differ in their bits between a and b (-1 if the
// channels' shapes differ)
fn channelDiffs(a &PolyMesh, b &PolyMesh) i64 {
  mut n = 0i64;
  if a.floats.len() != b.floats.len() or a.vec2s.len() != b.vec2s.len() { return -1; }
  mut c = 0usize;
  while c < a.floats.len() {
    if !a.floats[c].name.equals(b.floats[c].name.view()) or a.floats[c].domain != b.floats[c].domain { n = n + 1; }
    imm len = a.floats[c].values.len();
    if len != b.floats[c].values.len() { return -1; }
    mut k = 0usize;
    while k < len {
      if *a.floats[c].values[k] != *b.floats[c].values[k] { n = n + 1; }
      k = k + 1usize;
    }
    c = c + 1usize;
  }
  c = 0usize;
  while c < a.vec2s.len() {
    if !a.vec2s[c].name.equals(b.vec2s[c].name.view()) or a.vec2s[c].domain != b.vec2s[c].domain { n = n + 1; }
    imm len = a.vec2s[c].values.len();
    if len != b.vec2s[c].values.len() { return -1; }
    mut k = 0usize;
    while k < len {
      imm p = *a.vec2s[c].values[k];
      imm q = *b.vec2s[c].values[k];
      if p.x != q.x or p.y != q.y { n = n + 1; }
      k = k + 1usize;
    }
    c = c + 1usize;
  }
  n;
}

// How many entries of the half-edge lists differ between a and b
fn topologyDiffs(a &PolyMesh, b &PolyMesh) i64 {
  if a.hNext.len() != b.hNext.len() or a.fHalfedge.len() != b.fHalfedge.len()
    or a.vHalfedge.len() != b.vHalfedge.len() { return -1; }
  mut n = 0i64;
  mut h = 0usize;
  while h < a.hNext.len() {
    if *a.hNext[h] != *b.hNext[h] or *a.hPrev[h] != *b.hPrev[h] or *a.hVertex[h] != *b.hVertex[h]
      or *a.hFace[h] != *b.hFace[h] { n = n + 1; }
    h = h + 1usize;
  }
  mut f = 0usize;
  while f < a.fHalfedge.len() {
    if *a.fHalfedge[f] != *b.fHalfedge[f] { n = n + 1; }
    f = f + 1usize;
  }
  mut v = 0usize;
  while v < a.vHalfedge.len() {
    if *a.vHalfedge[v] != *b.vHalfedge[v] { n = n + 1; }
    v = v + 1usize;
  }
  n;
}

fn weights(got List[f32], want &[]f32, label &[]u8) {
  requireInt(i64.from(got.len()), i64.from(want.len), label);
  mut sum f32 = 0.;
  mut i = 0usize;
  while i < want.len {
    expectFloat(*got[i], want[i], near, label);
    sum = sum + *got[i];
    i = i + 1usize;
  }
  expectFloat(sum, 1., near, label);
}

fn bases() {
  imm b4 Array[f32, 4] = [0.2962963, 0.4444444, 0.2222222, 0.0370370];
  weights(latticeWeights(LatticeBernstein, 4u32, 1. / 3.), &b4, "bernstein: 4 points at 1/3");
  imm l3 Array[f32, 3] = [0., 0.5, 0.5];
  weights(latticeWeights(LatticeLinear, 3u32, 0.75), &l3, "linear: 3 points at 3/4");
  imm l3end Array[f32, 3] = [0., 0., 1.];
  weights(latticeWeights(LatticeLinear, 3u32, 1.), &l3end, "linear: 3 points at 1");
  imm s5q Array[f32, 5] = [0.125, 0.59375, 0.25, 0.03125, 0.];
  weights(latticeWeights(LatticeBSpline, 5u32, 0.25), &s5q, "b-spline: 5 points at 1/4");
  imm s5h Array[f32, 5] = [0., 0.25, 0.5, 0.25, 0.];
  weights(latticeWeights(LatticeBSpline, 5u32, 0.5), &s5h, "b-spline: 5 points at the knot 1/2");
  imm s50 Array[f32, 5] = [1., 0., 0., 0., 0.];
  weights(latticeWeights(LatticeBSpline, 5u32, 0.), &s50, "b-spline: 5 points at 0");
  imm s51 Array[f32, 5] = [0., 0., 0., 0., 1.];
  weights(latticeWeights(LatticeBSpline, 5u32, 1.), &s51, "b-spline: 5 points at 1");
  imm s3 Array[f32, 3] = [0.25, 0.5, 0.25];
  weights(latticeWeights(LatticeBSpline, 3u32, 0.5), &s3, "b-spline: 3 points, the Bernstein basis");
  weights(latticeWeights(LatticeBernstein, 3u32, 0.5), &s3, "bernstein: 3 points at 1/2");
  imm s1 Array[f32, 5] = [0., 0., 0., 0., 1.];
  weights(latticeWeights(LatticeBSpline, 5u32, 1.5), &s1, "b-spline: s held to 1");

  // Linear precision: sum Wi(s) i / 3 = s
  imm wb = latticeWeights(LatticeBernstein, 4u32, 0.3);
  imm wl = latticeWeights(LatticeLinear, 4u32, 0.3);
  mut xb f32 = 0.;
  mut xl f32 = 0.;
  mut i = 0usize;
  while i < 4usize {
    xb = xb + *wb[i] * f32.from(i) / 3.;
    xl = xl + *wl[i] * f32.from(i) / 3.;
    i = i + 1usize;
  }
  expectFloat(xb, 0.3, near, "bernstein: reproduces the box");
  expectFloat(xl, 0.3, near, "linear: reproduces the box");
}

fn methods() {
  mut lat = Lattice.regular(new Vec3(1., 2., 3.), new Vec3(2., 0., 0.), new Vec3(0., 3., 0.), new Vec3(0., 0., 4.),
    3u32, 4u32, 5u32);
  expectInt(i64.from(lat.points.len()), 60, "lattice: 3 x 4 x 5 points");
  expectInt(i64.from(lat.index(1u32, 2u32, 3u32)), 43, "lattice: the number of (1,2,3)");
  point(lat.rest(1u32, 2u32, 3u32), 2., 4., 6., "lattice: (1,2,3) rests at its place");
  point(lat.point(1u32, 2u32, 3u32), 2., 4., 6., "lattice: (1,2,3) starts at rest");
  point(*lat.points[43usize], 2., 4., 6., "lattice: point 43 is (1,2,3)");
  point(lat.point(2u32, 3u32, 4u32), 3., 5., 7., "lattice: the far corner");
  lat.setPoint(1u32, 2u32, 3u32, new Vec3(0., 0., 0.));
  point(lat.point(1u32, 2u32, 3u32), 0., 0., 0., "lattice: setPoint");
  lat.movePoint(1u32, 2u32, 3u32, new Vec3(1., -1., 2.));
  point(lat.point(1u32, 2u32, 3u32), 1., -1., 2., "lattice: movePoint");
  point(lat.rest(1u32, 2u32, 3u32), 2., 4., 6., "lattice: rest is unchanged");
  imm thin = Lattice.regular(new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), new Vec3(0., 1., 0.), new Vec3(0., 0., 1.),
    1u32, 2u32, 0u32);
  expectInt(i64.from(thin.l), 2, "lattice: resolution 1 held to 2");
  expectInt(i64.from(thin.n), 2, "lattice: resolution 0 held to 2");
  expectInt(i64.from(thin.points.len()), 8, "lattice: 2 x 2 x 2 points");
}

fn identities() {
  imm c = column();
  imm kinds Array[u32, 3] = [LatticeBernstein, LatticeLinear, LatticeBSpline];
  mut k = 0usize;
  while k < 3usize {
    imm two = around(2u32, 2u32, 2u32);
    imm three = around(3u32, 3u32, 3u32);
    imm odd = around(5u32, 4u32, 3u32);
    imm a = latticeDeform(&c, &two, kinds[k]);
    expectInt(positionDiffs(&c, &a), 0, "identity: 2 x 2 x 2, the same bits");
    imm b = latticeDeform(&c, &three, kinds[k]);
    expectInt(positionDiffs(&c, &b), 0, "identity: 3 x 3 x 3, the same bits");
    imm d = latticeDeform(&c, &odd, kinds[k]);
    expectInt(positionDiffs(&c, &d), 0, "identity: 5 x 4 x 3, the same bits");
    expectInt(channelDiffs(&c, &d), 0, "identity: channels carried");
    k = k + 1usize;
  }
}

fn corners() {
  imm c = column();
  mut lat = around(2u32, 2u32, 2u32);
  lat.movePoint(0u32, 0u32, 0u32, new Vec3(0., 0., -0.8));
  imm kinds Array[u32, 3] = [LatticeBernstein, LatticeLinear, LatticeBSpline];
  mut k = 0usize;
  while k < 3usize {
    imm d = latticeDeform(&c, &lat, kinds[k]);
    requireInt(i64.from(d.vertexCount()), 12, "corner: vertices");
    expectInt(i64.from(d.edgeCount()), 20, "corner: edges");
    expectInt(i64.from(d.faceCount()), 10, "corner: faces");
    clean(&d, "corner: validates");
    expectInt(topologyDiffs(&c, &d), 0, "corner: the same half-edges");
    expectInt(channelDiffs(&c, &d), 0, "corner: channels carried");
    point(*d.positions[0usize], -1., -1., -0.8, "corner: the box corner moves exactly");
    point(*d.positions[6usize], 1., 1., 0.9, "corner: the centre moves 1/8");
    point(*d.positions[2usize], 1., 1., -0.2, "corner: vertex 2 moves 1/4");
    point(*d.positions[5usize], 1., -1., 0.8, "corner: vertex 5 moves 1/4");
    point(*d.positions[10usize], 1., 1., 2., "corner: vertex 10 stays");
    k = k + 1usize;
  }
}

fn middles() {
  imm c = column();
  mut lat = around(3u32, 3u32, 3u32);
  point(lat.rest(1u32, 1u32, 1u32), 1., 1., 1., "middle: control (1,1,1) rests on vertex 6");
  lat.movePoint(1u32, 1u32, 1u32, new Vec3(0., 0., 1.));
  imm b = latticeDeform(&c, &lat, LatticeBernstein);
  point(*b.positions[6usize], 1., 1., 1.125, "middle, bernstein: the centre moves 1/8");
  point(*b.positions[5usize], 1., -1., 1., "middle, bernstein: vertex 5 stays");
  point(*b.positions[2usize], 1., 1., 0., "middle, bernstein: vertex 2 stays");
  expectFloat(volume(&b), 8., near, "middle, bernstein: vertex 6 slides along its edge, the volume kept");
  clean(&b, "middle, bernstein: validates");
  imm s = latticeDeform(&c, &lat, LatticeBSpline);
  expectInt(positionDiffs(&b, &s), 0, "middle: b-spline of 3 points is bernstein, bit for bit");
  imm l = latticeDeform(&c, &lat, LatticeLinear);
  point(*l.positions[6usize], 1., 1., 2., "middle, linear: the centre on its control point");
  point(*l.positions[5usize], 1., -1., 1., "middle, linear: vertex 5 stays");

  mut side = around(3u32, 3u32, 3u32);
  side.movePoint(1u32, 0u32, 1u32, new Vec3(0., -1., 0.));
  imm sb = latticeDeform(&c, &side, LatticeBernstein);
  point(*sb.positions[5usize], 1., -1.25, 1., "side, bernstein: vertex 5 moves 1/4");
  imm sl = latticeDeform(&c, &side, LatticeLinear);
  point(*sl.positions[5usize], 1., -2., 1., "side, linear: vertex 5 on its control point");

  mut fine = around(5u32, 5u32, 5u32);
  fine.movePoint(1u32, 2u32, 2u32, new Vec3(1., 0., 0.));
  imm fs = latticeDeform(&c, &fine, LatticeBSpline);
  point(*fs.positions[6usize], 1.0625, 1., 1., "b-spline 5 x 5 x 5: the centre moves 1/16");
  point(*fs.positions[2usize], 1., 1., 0., "b-spline 5 x 5 x 5: vertex 2 stays");
}

fn unities() {
  imm c = column();
  imm d = new Vec3(0.3, -0.2, 0.5);
  mut fine = around(5u32, 5u32, 5u32);
  mut odd = around(3u32, 4u32, 5u32);
  mut i = 0usize;
  while i < fine.points.len() {
    imm p = *fine.points[i];
    fine.points.set(i, p + d);
    i = i + 1usize;
  }
  i = 0usize;
  while i < odd.points.len() {
    imm p = *odd.points[i];
    odd.points.set(i, p + d);
    i = i + 1usize;
  }
  imm kinds Array[u32, 3] = [LatticeBernstein, LatticeLinear, LatticeBSpline];
  mut k = 0usize;
  while k < 3usize {
    imm a = latticeDeform(&c, &fine, kinds[k]);
    imm b = latticeDeform(&c, &odd, kinds[k]);
    mut v = 0usize;
    while v < 12usize {
      imm want = *c.positions[v] + d;
      point(*a.positions[v], want.x, want.y, want.z, "unity, 5 x 5 x 5: every vertex moves by the move");
      point(*b.positions[v], want.x, want.y, want.z, "unity, 3 x 4 x 5: every vertex moves by the move");
      v = v + 1usize;
    }
    point(*a.positions[0usize], -0.7, -1.2, 0.5, "unity: vertex 0");
    point(*a.positions[6usize], 1.3, 0.8, 1.5, "unity: vertex 6");
    k = k + 1usize;
  }
}

fn outsides() {
  imm c = column();
  mut lat = Lattice.regular(new Vec3(-1., -1., 0.), new Vec3(4., 0., 0.), new Vec3(0., 4., 0.), new Vec3(0., 0., 1.),
    2u32, 2u32, 2u32);
  lat.movePoint(0u32, 0u32, 1u32, new Vec3(0., 0., 1.));
  imm kinds Array[u32, 3] = [LatticeBernstein, LatticeLinear, LatticeBSpline];
  mut k = 0usize;
  while k < 3usize {
    imm d = latticeDeform(&c, &lat, kinds[k]);
    point(*d.positions[4usize], -1., -1., 2., "outside: vertex 4 on the box's top moves 1");
    point(*d.positions[8usize], -1., -1., 3., "outside: vertex 8 above it moves with it");
    point(*d.positions[10usize], 1., 1., 2.25, "outside: vertex 10 held to the top, 1/4");
    point(*d.positions[0usize], -1., -1., 0., "outside: vertex 0 stays");
    k = k + 1usize;
  }
}

fn orientations() {
  imm c = column();
  expectFloat(volume(&c), 8., near, "stretch: the column's volume");
  mut lat = Lattice.regular(new Vec3(-1., -1., 0.), new Vec3(2., 0., 0.), new Vec3(0., 2., 0.), new Vec3(0., 0., 2.),
    2u32, 2u32, 2u32);
  lat.movePoint(0u32, 0u32, 1u32, new Vec3(0., 0., 1.));
  lat.movePoint(1u32, 0u32, 1u32, new Vec3(0., 0., 1.));
  lat.movePoint(0u32, 1u32, 1u32, new Vec3(0., 0., 1.));
  lat.movePoint(1u32, 1u32, 1u32, new Vec3(0., 0., 1.));
  imm kinds Array[u32, 3] = [LatticeBernstein, LatticeLinear, LatticeBSpline];
  mut k = 0usize;
  while k < 3usize {
    imm d = latticeDeform(&c, &lat, kinds[k]);
    point(*d.positions[6usize], 1., 1., 1.5, "stretch: vertex 6 to 1.5");
    point(*d.positions[10usize], 1., 1., 3., "stretch: vertex 10 to 3");
    expectFloat(volume(&d), 12., near, "stretch: volume 12, every face still out");
    clean(&d, "stretch: validates");
    k = k + 1usize;
  }
}

fn determinism() {
  imm c = column();
  mut fine = around(5u32, 4u32, 3u32);
  fine.movePoint(1u32, 2u32, 1u32, new Vec3(0.37, 0.11, -0.23));
  fine.movePoint(2u32, 1u32, 1u32, new Vec3(-0.19, 0.29, 0.07));
  imm kinds Array[u32, 3] = [LatticeBernstein, LatticeLinear, LatticeBSpline];
  mut k = 0usize;
  while k < 3usize {
    imm a = latticeDeform(&c, &fine, kinds[k]);
    imm b = latticeDeform(&c, &fine, kinds[k]);
    expectInt(positionDiffs(&a, &b), 0, "determinism: the same bits twice");
    require(positionDiffs(&c, &a) > 0, "determinism: the lattice moved something");
    k = k + 1usize;
  }
}

fn main() i32 {
  bases();
  methods();
  identities();
  corners();
  middles();
  unities();
  outsides();
  orientations();
  determinism();
  done();
}
