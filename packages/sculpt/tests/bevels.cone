// The sculpt package's bevel, checked with the testing package; only a
// failure prints, so bevels.out holds the summary alone. Every result is
// checked valid and closed (or open where its input was), its topology by the
// Euler characteristic V - E + F, its volume by the divergence theorem (f64),
// and its bits by meshHash of its flat triangulation, pinned.
//
// - The cube (the unit cube cage), every edge bevelled by 0.1:
//   - 1 segment (a chamfer): 24 vertices, 48 edges, 26 faces (12 strips, 8
//     corner triangles); the volume is the core box's Minkowski sum with an
//     octahedron of radius 0.1, L^3 + 6 L^2 w + 6 L w^2 + 4/3 w^3, L = 1 - 2w:
//     0.945333;
//   - 2 and 3 segments: 56, 108, 54 and 96, 192, 98; every vertex exactly 0.1
//     from the core box [-0.4, 0.4]^3 (the strips on quarter cylinders, the
//     corner patches on eighths of a sphere); the volume between the chamfer's
//     and the rounded cube's (L^3 + 6 L^2 w + 3 pi L w^2 + 4/3 pi w^3);
//   - shape 0.25 at 4 segments is the chamfer's volume (a straight profile);
//     shape 1 keeps the cube's volume, 1 (the profile is the corner).
// - One edge of the cube, 0.1: 1 segment 10, 15, 7, volume 1 - w^2 / 2; 3
//   segments 14, 21, 9 (the profile set into the two end faces), volume
//   1 - w^2 / 4 (three chords of a quarter circle leave w^2 - 3/4 w^2); no
//   corner face; the widths BevelWidth and BevelDepth giving the chord 0.1 and
//   the depth 0.1 from the edge.
// - Non-planar: the cube twisted 0.6 radians about y (its side faces not
//   flat), every edge bevelled in 2 segments: valid, closed, characteristic
//   2, the same bits twice; a 16-sided prism (extruded circle with caps) with
//   its rim edges selected by angle (30 degrees), 3 segments: only the 32 rim
//   edges, every rim vertex an elbow (no corner face), characteristic 2, the
//   volume less than the prism's.
// - Clamp overlap: a 2 x 1 x 0.5 box (shortest edge 0.5), every edge at
//   width 0.4, more than half the shortest edge: the clamp factor 0.625
//   (0.25 / 0.4), no face turned over, valid and closed; without the clamp,
//   factor 1 and faces turned over. Width 0.6, past the shortest edge: the
//   factor 0.25 / 0.6.
// - Vertex bevel: the cube's vertex 0 by 0.2, 1 segment: 10, 15, 7, volume
//   1 - w^3 / 6; 3 segments: characteristic 2; two neighbouring vertices
//   clamped to meet.
// - Refused and reported: a negative or NaN width, 0 segments, a shape of
//   1.5, a selection of the wrong length, a mesh made invalid, an unknown
//   width type (each the mesh unchanged, one line); an edge number past the
//   end (reported, the rest bevelled); a selected boundary edge of an open
//   box (reported, not bevelled); a channel not found (reported, nothing
//   selected).
// - Channels: the cube with a vertex "h" = x + 2y + 3z, a vertex "weight"
//   (fill 1) of 0.5, a face "id" = its number, an edge "crease" 2 on every
//   edge, a corner "uv" = (x, y) of its vertex. Every edge at 0.1, 3
//   segments: h exact (within 1e-5) at every vertex, weight 0.5, an original
//   face's id its own, a strip's the lower of its two faces', a corner
//   face's the lowest round its vertex; an original face's corner uv is (x,
//   y) of its vertex; every crease the fill, 0. One edge: the cube's other
//   edges keep crease 2, the strip's edges 0. A bevel weight of 0.5 in
//   "bevel_weight_edge" on one edge, width 0.2, is the same bits as that
//   edge listed at width 0.1.

mod bevels;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

// The pinned hashes: cube 1, 2 and 3 segments, one edge 1 and 3 segments,
// the twisted cube, the prism, the clamped box, the vertex bevel at 3
imm PINNED Array[u32, 9] = [3454712414u32, 3458765673u32, 3967934785u32, 1738363779u32, 3991481968u32,
  4029164551u32, 1163618067u32, 535610914u32, 3123244892u32];

fn hashOf(m &PolyMesh) u32 {
  imm t = m.triangulate(false);
  meshHash(&t);
}

fn pinned(m &PolyMesh, k usize, label &[]u8) {
  expectUInt(u64.from(hashOf(m)), u64.from(PINNED[k]), label);
}

// Valid, and closed when 'closed'
fn sound(m &PolyMesh, closed bool, label &[]u8) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
  if closed {
    mut open = 0i64;
    mut h = 0usize;
    while h < m.hFace.len() {
      if *m.hFace[h] == NoIndex { open = open + 1; }
      h = h + 1usize;
    }
    expectInt(open, 0, label);
  }
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &[]u8) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn euler(m &PolyMesh) i64 {
  i64.from(m.vertexCount()) - i64.from(m.edgeCount()) + i64.from(m.faceCount());
}

// The signed volume, by the divergence theorem over each face's fan, in f64
fn volume(m &PolyMesh) f64 {
  mut sum = 0.d;
  mut f = 0usize;
  while f < m.faceCount() {
    imm pts = m.facePositions(u32.from(f));
    mut i = 1usize;
    while i + 1usize < pts.len() {
      imm a = DVec3.from(*pts[0usize]);
      imm b = DVec3.from(*pts[i]);
      imm c = DVec3.from(*pts[i + 1usize]);
      sum = sum + a.x * (b.y * c.z - b.z * c.y) + a.y * (b.z * c.x - b.x * c.z) + a.z * (b.x * c.y - b.y * c.x);
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.d;
}

fn absf(a f32) f32 { if a < 0. { -a; } else { a; }; }

// Every edge selected
fn allEdges(m &PolyMesh) List[f32] {
  mut w = List[f32].empty();
  mut e = 0usize;
  while e < m.edgeCount() {
    w.push(1.);
    e = e + 1usize;
  }
  w;
}

// A box from lo to hi: the cube cage placed
fn box(lo Vec3, hi Vec3) PolyMesh {
  mut parts = List[PolyMesh].empty();
  parts.push(PolyMesh.cube(0.5));
  mut places = List[Transform3].empty();
  places.push(new Transform3((lo + hi) * 0.5, Quat.identity(), hi - lo));
  mut problems = List[String].empty();
  joinPlaced(&parts, &places, &mut problems);
}

// The distance from p to the box [-a, a]^3
fn boxDistance(p Vec3, a f32) f32 {
  imm dx = if absf(p.x) > a { absf(p.x) - a; } else { 0.; };
  imm dy = if absf(p.y) > a { absf(p.y) - a; } else { 0.; };
  imm dz = if absf(p.z) > a { absf(p.z) - a; } else { 0.; };
  (dx * dx + dy * dy + dz * dz).sqrt();
}

// How many of the first 'nf' faces of b face against the same faces of a
// (their Newell vectors' dot product below 0, a face of area left out)
fn turnedOver(a &PolyMesh, b &PolyMesh, nf usize) i64 {
  mut count = 0i64;
  mut f = 0usize;
  while f < nf {
    imm na = a.faceNormal(u32.from(f));
    imm pts = b.facePositions(u32.from(f));
    mut nb = new Vec3(0., 0., 0.);
    imm k = pts.len();
    mut i = 0usize;
    while i < k {
      imm p = *pts[i];
      imm q = *pts[(i + 1usize) % k];
      nb = nb + new Vec3((p.y - q.y) * (p.z + q.z), (p.z - q.z) * (p.x + q.x), (p.x - q.x) * (p.y + q.y));
      i = i + 1usize;
    }
    if na.dot(nb) < -0.000001 { count = count + 1; }
    f = f + 1usize;
  }
  count;
}

fn cube() {
  imm c = PolyMesh.cube(0.5);
  imm all = allEdges(&c);
  mut problems = List[String].empty();
  imm w = 0.1d;
  imm l = 1.d - 2.d * w;
  imm chamfer = l * l * l + 6.d * l * l * w + 6.d * l * w * w + 4.d / 3.d * w * w * w;
  imm round = l * l * l + 6.d * l * l * w + 3.d * 3.14159265358979d * l * w * w + 4.d / 3.d * 3.14159265358979d * w * w * w;

  imm b1 = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 1u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&b1.mesh, true, "cube 1: sound");
  counts(&b1.mesh, 24, 48, 26, "cube 1: counts");
  expectInt(i64.from(b1.stripFaces.len()), 12, "cube 1: strips");
  expectInt(i64.from(b1.cornerFaces.len()), 8, "cube 1: corners");
  expectFloat(f64.from(b1.clamp), 1.d, 0.d, "cube 1: no clamp");
  expectFloat(volume(&b1.mesh), chamfer, 0.000002d, "cube 1: volume");
  pinned(&b1.mesh, 0usize, "cube 1: hash");

  imm b2 = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 2u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&b2.mesh, true, "cube 2: sound");
  counts(&b2.mesh, 56, 108, 54, "cube 2: counts");
  pinned(&b2.mesh, 1usize, "cube 2: hash");

  imm b3 = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 3u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&b3.mesh, true, "cube 3: sound");
  counts(&b3.mesh, 96, 192, 98, "cube 3: counts");
  expectInt(euler(&b3.mesh), 2, "cube 3: euler");
  imm v3 = volume(&b3.mesh);
  expect(v3 > chamfer and v3 < round, "cube 3: volume between the chamfer's and the rounded cube's");
  pinned(&b3.mesh, 2usize, "cube 3: hash");
  // Every vertex on the rounded cube: 0.1 from the core box
  mut worst f32 = 0.;
  mut i = 0usize;
  while i < b3.mesh.vertexCount() {
    imm d = absf(boxDistance(*b3.mesh.positions[i], 0.4) - 0.1);
    if d > worst { worst = d; }
    i = i + 1usize;
  }
  expectFloat(f64.from(worst), 0.d, 0.000001d, "cube 3: every vertex 0.1 from the core box");
  i = 0usize;
  worst = 0.;
  while i < b2.mesh.vertexCount() {
    imm d = absf(boxDistance(*b2.mesh.positions[i], 0.4) - 0.1);
    if d > worst { worst = d; }
    i = i + 1usize;
  }
  expectFloat(f64.from(worst), 0.d, 0.000001d, "cube 2: every vertex 0.1 from the core box");

  // The same bits twice
  imm again = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 3u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  expectUInt(u64.from(hashOf(&again.mesh)), u64.from(hashOf(&b3.mesh)), "cube 3: the same bits twice");

  // Shapes: a straight profile is the chamfer; shape 1 is the corner
  imm flat = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 4u32, 0.25, true, BevelVertexMeshGrid, &mut problems);
  sound(&flat.mesh, true, "shape 0.25: sound");
  expectFloat(volume(&flat.mesh), chamfer, 0.000002d, "shape 0.25: the chamfer's volume");
  imm sharp = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 4u32, 1., true, BevelVertexMeshGrid, &mut problems);
  sound(&sharp.mesh, true, "shape 1: sound");
  expectFloat(volume(&sharp.mesh), 1.d, 0.000002d, "shape 1: the cube's volume");
  // The cutoff corner: one polygon
  imm cut = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 3u32, 0.5, true, BevelVertexMeshCutoff, &mut problems);
  sound(&cut.mesh, true, "cutoff: sound");
  expectInt(i64.from(cut.cornerFaces.len()), 8, "cutoff: one face a corner");
  expectInt(euler(&cut.mesh), 2, "cutoff: euler");
  expectInt(i64.from(problems.len()), 0, "cube: nothing reported");
}

fn oneEdge() {
  imm c = PolyMesh.cube(0.5);
  mut problems = List[String].empty();
  imm e Array[u32, 1] = [0u32];
  imm m1 = bevelEdges(&c, &e, 0.1, 1u32, &mut problems);
  sound(&m1, true, "one edge 1: sound");
  counts(&m1, 10, 15, 7, "one edge 1: counts");
  expectFloat(volume(&m1), 1.d - 0.005d, 0.000002d, "one edge 1: volume");
  pinned(&m1, 3usize, "one edge 1: hash");

  imm sel = bevelSelectEdges(&c, &e, &mut problems);
  imm b3 = bevelEdgesWith(&c, sel.view(), 0.1, BevelOffset, 3u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&b3.mesh, true, "one edge 3: sound");
  counts(&b3.mesh, 14, 21, 9, "one edge 3: counts");
  expectInt(i64.from(b3.cornerFaces.len()), 0, "one edge 3: no corner face");
  expectInt(i64.from(b3.stripFaces.len()), 3, "one edge 3: three strips");
  expectFloat(volume(&b3.mesh), 1.d - 0.0025d, 0.000002d, "one edge 3: volume");
  pinned(&b3.mesh, 4usize, "one edge 3: hash");

  // Width: the chord across the strip is 0.1; depth: the chord 0.1 from the edge
  imm bw = bevelEdgesWith(&c, sel.view(), 0.1, BevelWidth, 1u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  imm sf = *bw.stripFaces[0usize];
  imm pts = bw.mesh.facePositions(sf);
  // The strip's rung at one end: its corners 1 and 2 are the start's profile
  imm chord = (*pts[1usize] - *pts[2usize]).length();
  expectFloat(f64.from(chord), 0.1d, 0.000001d, "width: the chord");
  imm bd = bevelEdgesWith(&c, sel.view(), 0.1, BevelDepth, 1u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  imm pd = bd.mesh.facePositions(*bd.stripFaces[0usize]);
  // Edge 0 runs along y at x = z = -0.5; the chord's middle is the depth from it
  imm midp = (*pd[1usize] + *pd[2usize]) * 0.5;
  imm depth = ((midp.x + 0.5) * (midp.x + 0.5) + (midp.z + 0.5) * (midp.z + 0.5)).sqrt();
  expectFloat(f64.from(depth), 0.1d, 0.000001d, "depth: the chord's distance from the edge");
  expectInt(i64.from(problems.len()), 0, "one edge: nothing reported");
}

fn nonPlanar() {
  imm c = PolyMesh.cube(0.5);
  imm tw = twist(&c, 0.6, new Vec3(0., 1., 0.), new Vec3(0., 0., 0.));
  imm all = allEdges(&tw);
  mut problems = List[String].empty();
  imm b = bevelEdgesWith(&tw, all.view(), 0.08, BevelOffset, 2u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&b.mesh, true, "twisted: sound");
  expectInt(euler(&b.mesh), 2, "twisted: euler");
  expect(volume(&b.mesh) > 0.d and volume(&b.mesh) < volume(&tw), "twisted: volume less");
  imm again = bevelEdgesWith(&tw, all.view(), 0.08, BevelOffset, 2u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  expectUInt(u64.from(hashOf(&again.mesh)), u64.from(hashOf(&b.mesh)), "twisted: the same bits twice");
  pinned(&b.mesh, 5usize, "twisted: hash");

  imm prism = extrude(&Profile.circle(16u32, 0.5), new Vec3(0., 0., 1.), 1u32, true);
  imm byAngle = bevelSelectByAngle(&prism, radians(30.));
  mut sel = 0i64;
  mut e = 0usize;
  while e < byAngle.len() {
    if *byAngle[e] > 0. { sel = sel + 1; }
    e = e + 1usize;
  }
  expectInt(sel, 32, "prism: the rim edges selected by angle");
  imm p = bevelEdgesWith(&prism, byAngle.view(), 0.05, BevelOffset, 3u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&p.mesh, true, "prism: sound");
  expectInt(euler(&p.mesh), 2, "prism: euler");
  expectInt(i64.from(p.cornerFaces.len()), 0, "prism: every rim vertex an elbow");
  expectInt(i64.from(p.stripFaces.len()), 96, "prism: 32 strips of 3");
  expect(volume(&p.mesh) < volume(&prism) and volume(&p.mesh) > 0.9d * volume(&prism), "prism: volume a little less");
  pinned(&p.mesh, 6usize, "prism: hash");

  // A lathe's pole (a vertex of 8 edges) with two opposite edges bevelled:
  // the pole stays as the end of the runs of edges between them, and the
  // hole round it is two polygons through it
  imm pts Array[Vec2, 4] = [new Vec2(0., 0.), new Vec2(0.5, 0.), new Vec2(0.5, 0.4), new Vec2(0., 0.6)];
  imm lathed = lathe(&Profile.fromPoints(&pts, false), new Vec3(0., 1., 0.), 2. * pi, 8u32);
  mut pole = 0u32;
  mut q = 0u32;
  while usize.from(q) < lathed.vertexCount() {
    if lathed.valence(q) == 8usize and lathed.positions[usize.from(q)].y == 0. { pole = q; }
    q = q + 1u32;
  }
  imm ring = lathed.vertexOutgoing(pole);
  imm two Array[u32, 2] = [lathed.edge(*ring[0usize]), lathed.edge(*ring[4usize])];
  imm ps = bevelSelectEdges(&lathed, &two, &mut problems);
  imm pb = bevelEdgesWith(&lathed, ps.view(), 0.05, BevelOffset, 2u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&pb.mesh, true, "pole: sound");
  expectInt(euler(&pb.mesh), 2, "pole: euler");
  // Two at the pole, one at each edge's far end (a vertex of four edges)
  expectInt(i64.from(pb.cornerFaces.len()), 4, "pole: four corner faces");
  mut atPole = 0i64;
  mut cf = 0usize;
  while cf < pb.cornerFaces.len() {
    imm cps = pb.mesh.facePositions(*pb.cornerFaces[cf]);
    mut ci = 0usize;
    mut has = false;
    while ci < cps.len() {
      if cps[ci].x == 0. and cps[ci].y == 0. and cps[ci].z == 0. { has = true; }
      ci = ci + 1usize;
    }
    if has { atPole = atPole + 1; }
    cf = cf + 1usize;
  }
  expectInt(atPole, 2, "pole: two polygons through the pole");
  expectInt(i64.from(problems.len()), 0, "non-planar: nothing reported");
}

fn clamped() {
  imm bx = box(new Vec3(-1., -0.5, -0.25), new Vec3(1., 0.5, 0.25));
  imm all = allEdges(&bx);
  mut problems = List[String].empty();
  imm b = bevelEdgesWith(&bx, all.view(), 0.4, BevelOffset, 1u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&b.mesh, true, "clamp: sound");
  expectFloat(f64.from(b.clamp), 0.625d, 0.000001d, "clamp: 0.25 / 0.4");
  expectInt(turnedOver(&bx, &b.mesh, 6usize), 0, "clamp: no face turned over");
  expectInt(euler(&b.mesh), 2, "clamp: euler");
  pinned(&b.mesh, 7usize, "clamp: hash");
  imm u = bevelEdgesWith(&bx, all.view(), 0.4, BevelOffset, 1u32, 0.5, false, BevelVertexMeshGrid, &mut problems);
  sound(&u.mesh, true, "no clamp: sound");
  expectFloat(f64.from(u.clamp), 1.d, 0.d, "no clamp: factor 1");
  expect(turnedOver(&bx, &u.mesh, 6usize) > 0, "no clamp: faces turned over");
  imm wide = bevelEdgesWith(&bx, all.view(), 0.6, BevelOffset, 3u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  sound(&wide.mesh, true, "clamp past the shortest edge: sound");
  expectFloat(f64.from(wide.clamp), 0.25d / 0.6d, 0.000001d, "clamp past the shortest edge: 0.25 / 0.6");
  expectInt(turnedOver(&bx, &wide.mesh, 6usize), 0, "clamp past the shortest edge: no face turned over");
  expectInt(i64.from(problems.len()), 0, "clamp: nothing reported");
}

fn vertices() {
  imm c = PolyMesh.cube(0.5);
  mut problems = List[String].empty();
  imm vs Array[u32, 1] = [0u32];
  imm m1 = bevelVertices(&c, &vs, 0.2, 1u32, &mut problems);
  sound(&m1, true, "vertex 1: sound");
  counts(&m1, 10, 15, 7, "vertex 1: counts");
  expectFloat(volume(&m1), 1.d - 0.008d / 6.d, 0.000002d, "vertex 1: volume");
  imm sel = bevelSelectVertices(&c, &vs, &mut problems);
  imm b3 = bevelVerticesWith(&c, sel.view(), 0.2, 3u32, 0.5, true, &mut problems);
  sound(&b3.mesh, true, "vertex 3: sound");
  expectInt(euler(&b3.mesh), 2, "vertex 3: euler");
  expectInt(i64.from(b3.cornerFaces.len()), 1, "vertex 3: one corner face");
  pinned(&b3.mesh, 8usize, "vertex 3: hash");
  // Vertices 0 and 1 share an edge of length 1: at 0.7 each they meet half way
  imm two Array[u32, 2] = [0u32, 1u32];
  imm s2 = bevelSelectVertices(&c, &two, &mut problems);
  imm b2 = bevelVerticesWith(&c, s2.view(), 0.7, 1u32, 0.5, true, &mut problems);
  sound(&b2.mesh, true, "two vertices: sound");
  expectFloat(f64.from(b2.clamp), 0.5d / 0.7d, 0.000001d, "two vertices: clamped to meet");
  expectInt(i64.from(problems.len()), 0, "vertices: nothing reported");
}

fn refused() {
  imm c = PolyMesh.cube(0.5);
  imm all = allEdges(&c);
  imm h0 = hashOf(&c);
  mut p = List[String].empty();
  imm a = bevelEdgesWith(&c, all.view(), -0.1, BevelOffset, 1u32, 0.5, true, BevelVertexMeshGrid, &mut p);
  expectInt(i64.from(p.len()), 1, "negative width: one line");
  expectUInt(u64.from(hashOf(&a.mesh)), u64.from(h0), "negative width: unchanged");
  p.clear();
  imm nan = 0. / 0.;
  imm b = bevelEdgesWith(&c, all.view(), nan, BevelOffset, 1u32, 0.5, true, BevelVertexMeshGrid, &mut p);
  expectInt(i64.from(p.len()), 1, "NaN width: one line");
  expectUInt(u64.from(hashOf(&b.mesh)), u64.from(h0), "NaN width: unchanged");
  p.clear();
  imm d = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 0u32, 0.5, true, BevelVertexMeshGrid, &mut p);
  expectInt(i64.from(p.len()), 1, "no segments: one line");
  expectUInt(u64.from(hashOf(&d.mesh)), u64.from(h0), "no segments: unchanged");
  p.clear();
  imm s = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 2u32, 1.5, true, BevelVertexMeshGrid, &mut p);
  expectInt(i64.from(p.len()), 1, "shape 1.5: one line");
  expectUInt(u64.from(hashOf(&s.mesh)), u64.from(h0), "shape 1.5: unchanged");
  p.clear();
  imm few Array[f32, 3] = [1., 1., 1.];
  imm f = bevelEdgesWith(&c, &few, 0.1, BevelOffset, 1u32, 0.5, true, BevelVertexMeshGrid, &mut p);
  expectInt(i64.from(p.len()), 1, "short selection: one line");
  expectUInt(u64.from(hashOf(&f.mesh)), u64.from(h0), "short selection: unchanged");
  p.clear();
  imm t = bevelEdgesWith(&c, all.view(), 0.1, 7u32, 1u32, 0.5, true, BevelVertexMeshGrid, &mut p);
  expectInt(i64.from(p.len()), 1, "unknown width type: one line");
  expectUInt(u64.from(hashOf(&t.mesh)), u64.from(h0), "unknown width type: unchanged");
  p.clear();
  mut broken = PolyMesh.cube(0.5);
  broken.hNext.set(0usize, 5u32);
  imm bb = bevelEdgesWith(&broken, all.view(), 0.1, BevelOffset, 1u32, 0.5, true, BevelVertexMeshGrid, &mut p);
  expectInt(i64.from(p.len()), 1, "invalid mesh: one line");
  expectInt(i64.from(bb.mesh.faceCount()), 6, "invalid mesh: unchanged");
  p.clear();
  imm past Array[u32, 2] = [0u32, 99u32];
  imm e = bevelEdges(&c, &past, 0.1, 1u32, &mut p);
  expectInt(i64.from(p.len()), 1, "edge past the end: one line");
  counts(&e, 10, 15, 7, "edge past the end: the rest bevelled");
  p.clear();
  // An open box: the cube without its top; its rim edges are boundary edges
  mut open = List[Vec3].empty();
  mut v = 0usize;
  while v < 8usize {
    open.push(*c.positions[v]);
    v = v + 1usize;
  }
  imm counts5 Array[u32, 5] = [4u32, 4u32, 4u32, 4u32, 4u32];
  imm faces5 Array[u32, 20] = [0u32, 2u32, 3u32, 1u32, 4u32, 5u32, 7u32, 6u32, 0u32, 4u32, 6u32, 2u32,
    1u32, 3u32, 7u32, 5u32, 0u32, 1u32, 5u32, 4u32];
  imm ob = PolyMesh.fromPolygons(open.view(), &counts5, &faces5, &mut p);
  imm oall = allEdges(&ob);
  imm o = bevelEdgesWith(&ob, oall.view(), 0.1, BevelOffset, 2u32, 0.5, true, BevelVertexMeshGrid, &mut p);
  expectInt(i64.from(p.len()), 1, "boundary edges: one line");
  sound(&o.mesh, false, "boundary edges: the rest bevelled, sound");
  expectInt(euler(&o.mesh), 1, "boundary edges: still a disc");
  expectInt(i64.from(o.stripFaces.len()), 16, "boundary edges: the 8 inner edges bevelled");
  p.clear();
  imm none = bevelSelectByChannel(&c, EdgeDomain, "bevel_weight_edge", &mut p);
  expectInt(i64.from(p.len()), 1, "missing channel: one line");
  imm nb = bevelEdgesWith(&c, none.view(), 0.1, BevelOffset, 1u32, 0.5, true, BevelVertexMeshGrid, &mut p);
  expectUInt(u64.from(hashOf(&nb.mesh)), u64.from(h0), "missing channel: unchanged");
  expectInt(i64.from(p.len()), 1, "missing channel: nothing more reported");
}

fn channels() {
  mut c = PolyMesh.cube(0.5);
  imm hc = c.addFloatChannel(VertexDomain, "h", 0.);
  imm wc = c.addFloatChannel(VertexDomain, "weight", 1.);
  imm ic = c.addFloatChannel(FaceDomain, "id", 0.);
  imm cc = c.addFloatChannel(EdgeDomain, "crease", 0.);
  imm uc = c.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  mut v = 0u32;
  while usize.from(v) < c.vertexCount() {
    imm p = *c.positions[usize.from(v)];
    c.setFloat(hc, v, p.x + 2. * p.y + 3. * p.z);
    c.setFloat(wc, v, 0.5);
    v = v + 1u32;
  }
  mut f = 0u32;
  while usize.from(f) < c.faceCount() {
    c.setFloat(ic, f, f32.from(f));
    f = f + 1u32;
  }
  mut e = 0u32;
  while usize.from(e) < c.edgeCount() {
    c.setFloat(cc, e, 2.);
    e = e + 1u32;
  }
  mut h = 0u32;
  while usize.from(h) < c.halfedgeCount() {
    if c.face(h) != NoIndex {
      imm p = *c.positions[usize.from(c.toVertex(h))];
      c.setVec2(uc, h, new Vec2(p.x, p.y));
    }
    h = h + 1u32;
  }
  imm all = allEdges(&c);
  mut problems = List[String].empty();
  imm b = bevelEdgesWith(&c, all.view(), 0.1, BevelOffset, 3u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  imm m = &b.mesh;
  sound(m, true, "channels: sound");
  imm mh = m.findFloatChannel(VertexDomain, "h");
  imm mw = m.findFloatChannel(VertexDomain, "weight");
  imm mi = m.findFloatChannel(FaceDomain, "id");
  imm mc = m.findFloatChannel(EdgeDomain, "crease");
  imm mu = m.findVec2Channel(CornerDomain, "uv");
  expect(mh != NoIndex and mw != NoIndex and mi != NoIndex and mc != NoIndex and mu != NoIndex, "channels: all kept");
  expectFloat(f64.from(m.floats[usize.from(mw)].fill), 1.d, 0.d, "channels: the weight's fill kept");
  mut worstH f32 = 0.;
  mut worstW f32 = 0.;
  v = 0u32;
  while usize.from(v) < m.vertexCount() {
    imm p = *m.positions[usize.from(v)];
    imm dh = absf(m.float(mh, v) - (p.x + 2. * p.y + 3. * p.z));
    if dh > worstH { worstH = dh; }
    imm dw = absf(m.float(mw, v) - 0.5);
    if dw > worstW { worstW = dw; }
    v = v + 1u32;
  }
  expectFloat(f64.from(worstH), 0.d, 0.00001d, "channels: h = x + 2y + 3z at every vertex");
  expectFloat(f64.from(worstW), 0.d, 0.000001d, "channels: weight 0.5 at every vertex");
  // Face ids: originals their own, strips the lower face, corners the lowest
  mut idsOk = true;
  f = 0u32;
  while f < 6u32 {
    if m.float(mi, f) != f32.from(f) { idsOk = false; }
    f = f + 1u32;
  }
  expect(idsOk, "channels: an original face keeps its id");
  mut s = 0usize;
  mut stripsOk = true;
  while s < b.stripFaces.len() {
    imm sf = *b.stripFaces[s];
    imm ce = usize.from(s / 3usize);   // three strips an edge, edge by edge in order
    imm fa = c.face(u32.from(2usize * ce));
    imm fb = c.face(u32.from(2usize * ce + 1usize));
    imm lower = if fa < fb { fa; } else { fb; };
    if m.float(mi, sf) != f32.from(lower) { stripsOk = false; }
    s = s + 1usize;
  }
  expect(stripsOk, "channels: a strip takes its edge's lower face");
  // Corner patches of vertex 7 (+x, +y, +z) take the lowest of front 1, right 3, top 5: 1
  imm last = *b.cornerFaces[b.cornerFaces.len() - 1usize];
  expectFloat(f64.from(m.float(mi, last)), 1.d, 0.d, "channels: a corner face takes its vertex's lowest face");
  // Corner uvs of the original faces: (x, y) of the vertex
  mut worstUv f32 = 0.;
  f = 0u32;
  while f < 6u32 {
    imm hs = m.faceHalfedges(f);
    mut k = 0usize;
    while k < hs.len() {
      imm p = *m.positions[usize.from(m.toVertex(*hs[k]))];
      imm uv = m.vec2(mu, *hs[k]);
      imm d = absf(uv.x - p.x) + absf(uv.y - p.y);
      if d > worstUv { worstUv = d; }
      k = k + 1usize;
    }
    f = f + 1u32;
  }
  expectFloat(f64.from(worstUv), 0.d, 0.00001d, "channels: an original face's uv is (x, y) of its corner");
  mut creases f32 = 0.;
  e = 0u32;
  while usize.from(e) < m.edgeCount() {
    creases = creases + m.float(mc, e);
    e = e + 1u32;
  }
  expectFloat(f64.from(creases), 0.d, 0.d, "channels: every edge the bevel made has the crease's fill");

  // One edge: the others keep their crease
  imm one Array[u32, 1] = [0u32];
  imm b1 = bevelEdges(&c, &one, 0.1, 2u32, &mut problems);
  imm c1 = b1.findFloatChannel(EdgeDomain, "crease");
  mut twos = 0i64;
  mut zeros = 0i64;
  e = 0u32;
  while usize.from(e) < b1.edgeCount() {
    if b1.float(c1, e) == 2. { twos = twos + 1; } elif b1.float(c1, e) == 0. { zeros = zeros + 1; }
    e = e + 1u32;
  }
  expectInt(twos, 11, "one edge: the other 11 edges keep crease 2");
  expectInt(zeros, i64.from(b1.edgeCount()) - 11, "one edge: the bevel's edges crease 0");

  // A bevel weight of 0.5 at width 0.2 is the edge listed at 0.1
  mut wm = PolyMesh.cube(0.5);
  imm bw = wm.addFloatChannel(EdgeDomain, "bevel_weight_edge", 0.);
  wm.setFloat(bw, 0u32, 0.5);
  imm byWeight = bevelSelectByChannel(&wm, EdgeDomain, "bevel_weight_edge", &mut problems);
  imm wb = bevelEdgesWith(&wm, byWeight.view(), 0.2, BevelOffset, 2u32, 0.5, true, BevelVertexMeshGrid, &mut problems);
  imm listed = bevelEdges(&wm, &one, 0.1, 2u32, &mut problems);
  expectUInt(u64.from(hashOf(&wb.mesh)), u64.from(hashOf(&listed)), "bevel weight: the same bits as the edge listed");
  expectInt(i64.from(problems.len()), 0, "channels: nothing reported");
}

fn main() i32 {
  cube();
  oneEdge();
  nonPlanar();
  clamped();
  vertices();
  refused();
  channels();
  done();
}
