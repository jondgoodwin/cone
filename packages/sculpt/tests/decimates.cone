// The sculpt package's decimation by quadric error metrics, checked with the
// testing package against values worked out by hand; only a failure prints,
// so decimates.out holds the summary alone.
//
// - The flat grid: 4 x 4 unit quads over the unit square (25 vertices, 32
//   triangles), vertex "w" = x + y, corner "uv" = (x, y), face "id" = its
//   number. Every triangle's plane is z = 0 and every boundary side's penalty
//   plane is x = 0, x = 1, y = 0 or y = 1, so the quadrics are exact: a
//   collapse onto a point of the plane, along the boundary or inside it,
//   costs exactly 0, and moving a corner off its two boundary lines costs
//   more. Decimated to 0 with a limit of 0, it stops at the corners: 4
//   vertices, old 0, 4, 20 and 24, at (0,0,0), (1,0,0), (0,1,0), (1,1,0) in
//   that order (the vertices left keep their order), 2 triangles of area 1 facing
//   +z, error 0, 25 - 4 = 21 collapses. Every collapse here is onto an end
//   or the middle of an edge, so the linear "w" and "uv" stay linear: each
//   vertex's w is x + y and each corner's uv its vertex's (x, y).
// - The flat cube: the cube cage with every edge infinitely creased,
//   subdivided twice, so each face is a flat 4 x 4 grid (98 vertices, 96
//   quads, 192 triangles), its creases then set to 0 so only the planes
//   count. Each face's plane is x, y or z = +-1, exact again; a vertex on a
//   cube edge has two planes, a corner three, so its quadric is least at the
//   corner alone. With a limit of 0 it stops at the 8 corners, each exactly
//   where it was, and 12 triangles: a closed cube of volume 8 (the
//   divergence theorem: the sum of p0 . (p1 x p2) / 6 over the triangles),
//   no boundary edge. Without a limit it goes on to a tetrahedron, 4
//   vertices and 4 triangles, the smallest closed mesh, where every collapse
//   breaks the link condition. At ratio 0.5 it keeps 96 triangles.
// - The star and the decagon: a centre vertex 0 at the origin and a ring of
//   10, vertex k at angle 36 (k - 1) degrees, radius 1 for odd k and r for
//   even, 10 triangles (0, k, k + 1), all at z = 0. Collapsing the centre
//   onto a ring vertex costs about 0 (the centre has only the z plane, the
//   ring vertex's penalty planes pass through it); moving a ring vertex
//   costs its penalty. At r = 0.3 the ring is a sharp star, and every ring
//   vertex lies outside the star's kernel: collapsing the centre onto it
//   would turn some triangle (0, j, j + 1) over (worked by hand: q, j, j + 1
//   clockwise for some j, every q), so with a limit of 0.000001 nothing
//   collapses: 11 vertices, 10 triangles, 0 collapses. At r = 1 (a convex
//   decagon) the same collapse turns nothing over: the cheapest edge is 0-1
//   (cost about 0, lowest numbers), the centre goes into vertex 1, which
//   keeps its place: 10 vertices, 8 triangles, the first at (1, 0, 0).
// - The creased grid: the flat grid with "crease" 2 on its four sides along
//   y = 0.5. Each adds the penalty plane y = 0.5, so with a limit of 0 the
//   crease's ends (0, 0.5) and (1, 0.5) stay: 6 vertices, 4 triangles, every
//   vertex at x 0 or 1 and y 0, 0.5 or 1; 6 + 4 - 1 = 9 edges, one of them
//   the crease, which keeps crease 2 (the four sides merged, the greatest).
// - The pinned grid: the flat grid with vertex "crease" 1 at its centre
//   (vertex 12, (0.5, 0.5)). It never moves, others may collapse onto it:
//   5 vertices (the corners and the centre, which keeps crease 1), 4
//   triangles.
// - The cylinder: the line x = 1, y = 0 to 1 in 4 pieces, lathed in 16
//   steps about y: 80 vertices, 128 triangles, the corner "uv" with its
//   seam (u = 1 at the closing corners, 0 at the first column's), "around"
//   = y. Each vertex's planes are its two flat quads' planes, both holding
//   the vertical line through it, so collapsing a vertex onto the one above
//   or below costs about 0, and anything else more (the rings are round;
//   the top and bottom rings' penalty planes are square to their faces).
//   With a limit of 0.00001 every column shrinks to its two ends: 32
//   vertices, all at y 0 or 1 exactly, 32 triangles, 64 edges. The seam
//   column's vertices collapse only along the seam, onto each other, so
//   every corner at a seam vertex keeps u = 0 or 1 exactly and no triangle's
//   corners span more than half the u range; every corner's v (uv.y) is its
//   vertex's y and every vertex's around its y.
// - The weight: the cylinder cut to 64 triangles with a vertex channel "w" of
//   4 everywhere scales every quadric by exactly 4 (a power of 2), so every
//   cost is 4 times, the order and the mesh are the same bits, and the error
//   is exactly twice. A missing channel name weighs 1: the same bits as
//   none.
// - Symmetry: a cubic profile lathed in 16 steps about y is its own mirror
//   image in x = 0 (angle a and 180 - a). Decimated to 0.3 about x, every
//   vertex left has a vertex within 0.0001 of its reflection; decimated
//   without symmetry, some vertex has none (the ties fall by vertex number,
//   which the mirror does not keep).
// - The same mesh twice gives the same bits.

mod decimates;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &[]u8) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn counts(m &PolyMesh, nv i64, nf i64, label &[]u8) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn clean(m &PolyMesh, label &[]u8) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn boundaryEdges(m &PolyMesh) i64 {
  mut n = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.isBoundaryEdge(e) { n = n + 1; }
    e = e + 1u32;
  }
  n;
}

// The total area of a mesh's faces, each by its Newell normal's length / 2
fn totalArea(m &PolyMesh) f64 {
  mut a = 0.d;
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    imm p = m.facePositions(f);
    imm n = (*p[1usize] - *p[0usize]).cross(*p[2usize] - *p[0usize]);
    a = a + f64.from(n.length()) * 0.5d;
    f = f + 1u32;
  }
  a;
}

// The volume a closed triangle mesh bounds
fn volume(m &PolyMesh) f64 {
  mut v = 0.d;
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    imm p = m.facePositions(f);
    v = v + f64.from((*p[0usize]).dot((*p[1usize]).cross(*p[2usize]))) / 6.d;
    f = f + 1u32;
  }
  v;
}

// How many faces' normals point along +z
fn facingUp(m &PolyMesh) i64 {
  mut n = 0i64;
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    if m.faceNormal(f).z > 0.99 { n = n + 1; }
    f = f + 1u32;
  }
  n;
}

fn edgeOf(m &PolyMesh, a u32, b u32) u32 {
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    imm p = *m.hVertex[usize.from(2u32 * e)];
    imm q = *m.hVertex[usize.from(2u32 * e + 1u32)];
    if (p == a and q == b) or (p == b and q == a) { return e; }
    e = e + 1u32;
  }
  NoIndex;
}

// An n x n grid of unit-square quads over (0,0)-(1,1), vertex i + (n + 1) j
// at (i / n, j / n, 0), with vertex "w" = x + y, corner "uv" = (x, y), face
// "id" = its number
fn grid(n u32) PolyMesh {
  mut pts = List[Vec3].empty();
  mut j = 0u32;
  while j <= n {
    mut i = 0u32;
    while i <= n {
      pts.push(new Vec3(f32.from(i) / f32.from(n), f32.from(j) / f32.from(n), 0.));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  mut sizes = List[u32].empty();
  mut idx = List[u32].empty();
  j = 0u32;
  while j < n {
    mut i = 0u32;
    while i < n {
      imm a = i + (n + 1u32) * j;
      sizes.push(4u32);
      idx.push(a);
      idx.push(a + 1u32);
      idx.push(a + n + 2u32);
      idx.push(a + n + 1u32);
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  mut problems = List[String].empty();
  mut m = PolyMesh.fromPolygons(pts.view(), sizes.view(), idx.view(), &mut problems);
  imm w = m.addFloatChannel(VertexDomain, "w", 0.);
  mut v = 0u32;
  while usize.from(v) < m.vertexCount() {
    imm p = *m.positions[usize.from(v)];
    m.setFloat(w, v, p.x + p.y);
    v = v + 1u32;
  }
  imm id = m.addFloatChannel(FaceDomain, "id", 0.);
  imm uv = m.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    m.setFloat(id, f, f32.from(f));
    imm hs = m.faceHalfedges(f);
    mut k = 0usize;
    while k < hs.len() {
      imm p = *m.positions[usize.from(m.toVertex(*hs[k]))];
      m.setVec2(uv, *hs[k], new Vec2(p.x, p.y));
      k = k + 1usize;
    }
    f = f + 1u32;
  }
  m;
}

fn flatGrid() {
  imm g = grid(4u32);
  counts(&g, 25, 16, "grid: 25 vertices, 16 quads");
  expectInt(i64.from(triangleCount(&g)), 32, "grid: 32 triangles");
  imm d = decimateWith(&g, 0u32, 0., DecimateSymmetryNone, "");
  imm m = &d.mesh;
  clean(m, "grid: validates");
  counts(m, 4, 2, "grid: the corners, 2 triangles");
  point(*m.positions[0usize], 0., 0., 0., "grid: corner 0");
  point(*m.positions[1usize], 1., 0., 0., "grid: corner 1");
  point(*m.positions[2usize], 0., 1., 0., "grid: corner 2");
  point(*m.positions[3usize], 1., 1., 0., "grid: corner 3");
  expectFloat(totalArea(m), 1.d, near, "grid: area 1");
  expectInt(facingUp(m), 2, "grid: both face +z");
  expectFloat(f64.from(d.error), 0.d, 0.d, "grid: error 0");
  expectInt(i64.from(d.collapses), 21, "grid: 21 collapses");
  imm w = m.findFloatChannel(VertexDomain, "w");
  require(w != NoIndex, "grid: w carried");
  mut v = 0u32;
  while usize.from(v) < m.vertexCount() {
    imm p = *m.positions[usize.from(v)];
    expectFloat(m.float(w, v), p.x + p.y, near, "grid: w is x + y");
    v = v + 1u32;
  }
  imm uv = m.findVec2Channel(CornerDomain, "uv");
  require(uv != NoIndex, "grid: uv carried");
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    imm hs = m.faceHalfedges(f);
    mut k = 0usize;
    while k < hs.len() {
      imm p = *m.positions[usize.from(m.toVertex(*hs[k]))];
      imm t = m.vec2(uv, *hs[k]);
      expectFloat(t.x, p.x, near, "grid: a corner's u is its x");
      expectFloat(t.y, p.y, near, "grid: a corner's v is its y");
      k = k + 1usize;
    }
    f = f + 1u32;
  }
  require(m.findFloatChannel(FaceDomain, "id") != NoIndex, "grid: id carried");
}

// The cube with flat faces, 4 x 4 quads each
fn flatCube() PolyMesh {
  mut cube = PolyMesh.cube(1.);
  imm ch = cube.addFloatChannel(EdgeDomain, "crease", 0.);
  mut e = 0u32;
  while usize.from(e) < cube.edgeCount() {
    cube.setFloat(ch, e, SharpnessInfinite);
    e = e + 1u32;
  }
  mut sub = subdivide(&cube, 2u32);
  imm ch2 = sub.findFloatChannel(EdgeDomain, "crease");
  e = 0u32;
  while usize.from(e) < sub.edgeCount() {
    sub.setFloat(ch2, e, 0.);
    e = e + 1u32;
  }
  sub;
}

fn cubes() {
  imm c = flatCube();
  counts(&c, 98, 96, "cube: 98 vertices, 96 quads");
  imm d = decimateWith(&c, 0u32, 0., DecimateSymmetryNone, "");
  imm m = &d.mesh;
  clean(m, "cube: validates");
  counts(m, 8, 12, "cube: the 8 corners, 12 triangles");
  mut v = 0usize;
  while v < 8usize {
    imm p = *m.positions[v];
    imm x = if v % 2usize == 1usize {1.;} else {-1.;};
    imm y = if (v / 2usize) % 2usize == 1usize {1.;} else {-1.;};
    imm z = if v / 4usize == 1usize {1.;} else {-1.;};
    expect(p.x == x and p.y == y and p.z == z, "cube: a corner exactly where it was");
    v = v + 1usize;
  }
  expectFloat(volume(m), 8.d, near, "cube: volume 8, faces outward");
  expectInt(boundaryEdges(m), 0, "cube: closed");
  expectFloat(f64.from(d.error), 0.d, 0.d, "cube: error 0");

  imm all = decimateWith(&c, 0u32, -1., DecimateSymmetryNone, "");
  clean(&all.mesh, "cube without a limit: validates");
  counts(&all.mesh, 4, 4, "cube without a limit: a tetrahedron");
  expectInt(boundaryEdges(&all.mesh), 0, "cube without a limit: closed");

  imm half = decimate(&c, 0.5);
  expectInt(i64.from(half.faceCount()), 96, "cube at 0.5: 96 triangles");
  expectInt(i64.from(decimateTarget(&c, 0.5)), 96, "cube: the target at 0.5");
}

// A centre vertex and a ring of 10, radius 1 and r alternately, fanned
fn star(r f32) PolyMesh {
  mut pts = List[Vec3].empty();
  pts.push(new Vec3(0., 0., 0.));
  mut k = 0u32;
  while k < 10u32 {
    imm a = 0.62831853 * f32.from(k);
    imm rad = if k % 2u32 == 0u32 {1.;} else {r;};
    pts.push(new Vec3(rad * cos(a), rad * sin(a), 0.));
    k = k + 1u32;
  }
  mut sizes = List[u32].empty();
  mut idx = List[u32].empty();
  k = 1u32;
  while k <= 10u32 {
    sizes.push(3u32);
    idx.push(0u32);
    idx.push(k);
    idx.push(if k == 10u32 {1u32;} else {k + 1u32;});
    k = k + 1u32;
  }
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pts.view(), sizes.view(), idx.view(), &mut problems);
}

fn flips() {
  imm s = star(0.3);
  counts(&s, 11, 10, "star: 11 vertices, 10 triangles");
  imm d = decimateWith(&s, 0u32, 0., DecimateSymmetryNone, "");
  clean(&d.mesh, "star: validates");
  counts(&d.mesh, 11, 10, "star: every collapse of the centre would turn a triangle over");
  expectInt(i64.from(d.collapses), 0, "star: no collapse");
  expectInt(facingUp(&d.mesh), 10, "star: all face +z");

  imm g = star(1.);
  imm e = decimateWith(&g, 0u32, 0., DecimateSymmetryNone, "");
  clean(&e.mesh, "decagon: validates");
  counts(&e.mesh, 10, 8, "decagon: the centre collapses");
  expectInt(i64.from(e.collapses), 1, "decagon: one collapse");
  point(*e.mesh.positions[0usize], 1., 0., 0., "decagon: into vertex 1, in place");
  expectInt(facingUp(&e.mesh), 8, "decagon: all face +z");
}

fn creases() {
  mut g = grid(4u32);
  imm ch = g.addFloatChannel(EdgeDomain, "crease", 0.);
  // y = 0.5 is row 2: vertices 10 to 14
  mut i = 10u32;
  while i < 14u32 {
    g.setFloat(ch, edgeOf(&g, i, i + 1u32), 2.);
    i = i + 1u32;
  }
  imm d = decimateWith(&g, 0u32, 0., DecimateSymmetryNone, "");
  imm m = &d.mesh;
  clean(m, "crease: validates");
  counts(m, 6, 4, "crease: the corners and the crease's ends");
  mut v = 0usize;
  while v < m.vertexCount() {
    imm p = *m.positions[v];
    expect((p.x == 0. or p.x == 1.) and (p.y == 0. or p.y == 0.5 or p.y == 1.), "crease: a vertex on the lines");
    v = v + 1usize;
  }
  expectInt(i64.from(m.edgeCount()), 9, "crease: 9 edges");
  imm c = m.findFloatChannel(EdgeDomain, "crease");
  require(c != NoIndex, "crease: carried");
  mut sharp = 0i64;
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.float(c, e) == 2. { sharp = sharp + 1; }
    e = e + 1u32;
  }
  expectInt(sharp, 1, "crease: one creased edge, crease 2");
  imm a = m.toVertex(2u32 * firstCreased(m, c));
  imm b = m.toVertex(2u32 * firstCreased(m, c) + 1u32);
  expectFloat(m.positions[usize.from(a)].y, 0.5, near, "crease: the creased edge along y = 0.5");
  expectFloat(m.positions[usize.from(b)].y, 0.5, near, "crease: the creased edge along y = 0.5");

  mut p = grid(4u32);
  imm vc = p.addFloatChannel(VertexDomain, "crease", 0.);
  p.setFloat(vc, 12u32, 1.);
  imm q = decimateWith(&p, 0u32, 0., DecimateSymmetryNone, "");
  clean(&q.mesh, "pinned: validates");
  counts(&q.mesh, 5, 4, "pinned: the corners and the centre");
  imm qc = q.mesh.findFloatChannel(VertexDomain, "crease");
  mut found = false;
  v = 0usize;
  while v < q.mesh.vertexCount() {
    imm pv = *q.mesh.positions[v];
    if pv.x == 0.5 and pv.y == 0.5 {
      found = true;
      expectFloat(q.mesh.float(qc, u32.from(v)), 1., near, "pinned: the centre keeps its crease");
    }
    v = v + 1usize;
  }
  expect(found, "pinned: the centre stays where it was");
}

fn firstCreased(m &PolyMesh, c u32) u32 {
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    if m.float(c, e) > 0. { return e; }
    e = e + 1u32;
  }
  0u32;
}

fn cylinder() PolyMesh {
  imm pts Array[Vec2, 5] = [new Vec2(1., 0.), new Vec2(1., 0.25), new Vec2(1., 0.5), new Vec2(1., 0.75), new Vec2(1., 1.)];
  imm prof = Profile.fromPoints(&pts, false);
  lathe(&prof, new Vec3(0., 1., 0.), 6.2831853, 16u32);
}

fn seams() {
  imm c = cylinder();
  counts(&c, 80, 64, "cylinder: 80 vertices, 64 quads");
  imm d = decimateWith(&c, 0u32, 0., DecimateSymmetryNone, "");
  imm m = &d.mesh;
  clean(m, "cylinder: validates");
  counts(m, 32, 32, "cylinder: each column to its ends");
  expectInt(i64.from(m.edgeCount()), 64, "cylinder: 64 edges");
  imm around = m.findFloatChannel(VertexDomain, "around");
  require(around != NoIndex, "cylinder: around carried");
  mut v = 0usize;
  while v < m.vertexCount() {
    imm p = *m.positions[v];
    expect(absf(p.y) < 0.00001 or absf(p.y - 1.) < 0.00001, "cylinder: a vertex at y 0 or 1");
    expectFloat(m.float(around, u32.from(v)), p.y, near, "cylinder: around is y");
    v = v + 1usize;
  }
  imm uv = m.findVec2Channel(CornerDomain, "uv");
  require(uv != NoIndex, "cylinder: uv carried");
  mut seamCorners = 0i64;
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    imm hs = m.faceHalfedges(f);
    mut lo f32 = 2.;
    mut hi f32 = -1.;
    mut k = 0usize;
    while k < hs.len() {
      imm p = *m.positions[usize.from(m.toVertex(*hs[k]))];
      imm t = m.vec2(uv, *hs[k]);
      if t.x < lo { lo = t.x; }
      if t.x > hi { hi = t.x; }
      expectFloat(t.y, p.y, near, "cylinder: a corner's v is its y");
      // On the seam, at angle 0: x = 1, z = 0
      if p.x > 0.9999 and p.z < 0.0001 and p.z > -0.0001 {
        seamCorners = seamCorners + 1;
        expect(t.x == 0. or t.x == 1., "cylinder: a seam corner keeps u 0 or 1");
      }
      k = k + 1usize;
    }
    expect(hi - lo < 0.5, "cylinder: no triangle spans the seam");
    f = f + 1u32;
  }
  expect(seamCorners > 0, "cylinder: the seam's vertices are kept");
}

fn absf(a f32) f32 {if a < 0. {-a;} else {a;};}

// Whether two meshes' positions are the same bits
fn sameBits(a &PolyMesh, b &PolyMesh) Bool {
  if a.vertexCount() != b.vertexCount() or a.faceCount() != b.faceCount() { return false; }
  mut v = 0usize;
  while v < a.vertexCount() {
    imm p = *a.positions[v];
    imm q = *b.positions[v];
    if p.x != q.x or p.y != q.y or p.z != q.z { return false; }
    v = v + 1usize;
  }
  true;
}

fn weights() {
  imm c = cylinder();
  mut w4 = cylinder();
  imm ch = w4.addFloatChannel(VertexDomain, "w", 4.);
  imm plain = decimateWith(&c, 24u32, -1., DecimateSymmetryNone, "");
  imm heavy = decimateWith(&w4, 24u32, -1., DecimateSymmetryNone, "w");
  expectInt(i64.from(plain.mesh.faceCount()), 24, "weight: the plain cut to 24");
  expect(plain.error > 0., "weight: an error above 0");
  expect(sameBits(&plain.mesh, &heavy.mesh), "weight 4: the same mesh, bit for bit");
  expectFloat(f64.from(heavy.error), 2.d * f64.from(plain.error), 0.d, "weight 4: twice the error, exactly");
  imm missing = decimateWith(&c, 24u32, -1., DecimateSymmetryNone, "nope");
  expect(sameBits(&plain.mesh, &missing.mesh), "a missing weight channel weighs 1");
  expectFloat(f64.from(missing.error), f64.from(plain.error), 0.d, "a missing weight channel: the same error");
  imm again = decimateWith(&c, 24u32, -1., DecimateSymmetryNone, "");
  expect(sameBits(&plain.mesh, &again.mesh), "the same mesh twice: the same bits");
}

fn vase() PolyMesh {
  imm curve = new CubicBezier2(new Vec2(0.6, 0.), new Vec2(1.6, 0.6), new Vec2(0.2, 1.4), new Vec2(0.7, 2.));
  imm prof = Profile.fromCubic(curve, 12u32);
  lathe(&prof, new Vec3(0., 1., 0.), 6.2831853, 16u32);
}

// How many of m's vertices have no vertex within 0.0001 of their
// reflection in x = 0
fn unmirrored(m &PolyMesh) i64 {
  mut n = 0i64;
  mut v = 0usize;
  while v < m.vertexCount() {
    imm p = *m.positions[v];
    imm r = new Vec3(-p.x, p.y, p.z);
    mut found = false;
    mut w = 0usize;
    while w < m.vertexCount() and !found {
      if (*m.positions[w] - r).length() <= 0.0001 { found = true; }
      w = w + 1usize;
    }
    if !found { n = n + 1; }
    v = v + 1usize;
  }
  n;
}

fn symmetry() {
  imm s = vase();
  expectInt(unmirrored(&s), 0, "vase: its own mirror image");
  imm d = decimateWith(&s, decimateTarget(&s, 0.3), -1., DecimateSymmetryX, "");
  clean(&d.mesh, "symmetric: validates");
  expect(d.mesh.faceCount() <= usize.from(decimateTarget(&s, 0.3)) + 2usize, "symmetric: cut to the target");
  expectInt(unmirrored(&d.mesh), 0, "symmetric: every vertex mirrored");
  imm plain = decimateWith(&s, decimateTarget(&s, 0.3), -1., DecimateSymmetryNone, "");
  expect(unmirrored(&plain.mesh) > 0, "without symmetry the cut is lopsided");
}

fn main() i32 {
  flatGrid();
  cubes();
  flips();
  creases();
  seams();
  weights();
  symmetry();
  done();
}
