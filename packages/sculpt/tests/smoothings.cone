// The sculpt package's smoothing, Laplacian and Taubin's lambda|mu, checked
// with the testing package against values worked out by hand; only a failure
// prints, so smoothings.out holds the summary alone.
//
// The grid: 5 x 5 vertices, vertex 5j + i at (i, j, 0), 16 quads, face 4j + i
// (5j + i, 5j + i + 1, 5j + i + 6, 5j + i + 5), facing +z; 25 vertices, 40
// edges. Its boundary vertices on one face (0, 4, 20, 24) are its corners.
// Channels on it: vertex "w" = v, face "id" = 10 + f, edge "tag" = e, corner
// "uv" (v / 25, f / 16).
//
// - Laplacian, factor 0.5, the centre 12 raised to (2, 2, 1). One step:
//   12's neighbours 7, 11, 13, 17 are at z = 0, mean (2, 2, 0): 12 goes to
//   (2, 2, 1) + 0.5 ((2, 2, 0) - (2, 2, 1)) = (2, 2, 0.5). 7 (2, 1, 0) has
//   neighbours 2 (2, 0, 0), 6 (1, 1, 0), 8 (3, 1, 0) and 12 (2, 2, 1), mean
//   (2, 1, 0.25), so it goes to (2, 1, 0.125); so do 11, 13 and 17 by
//   symmetry, each from 12's old height (a Jacobi step: had 12 moved first,
//   13 and 17 would get 0.0625). 6 (1, 1, 0) sees only z = 0 and stays. A
//   boundary vertex smooths along the boundary: 1's boundary neighbours 0
//   and 2 have mean (1, 0, 0), itself, so it stays; corner 0 stays. Two
//   steps: 12's neighbours are now all at 0.125, so 12 goes to 0.5 + 0.5
//   (0.125 - 0.5) = 0.3125; 7's neighbours 2, 6, 8 at 0 and 12 at 0.5 have
//   mean 0.125, its own height, so it stays at 0.125; 6's neighbours 1, 5 at
//   0 and 7, 11 at 0.125 have mean 0.0625, so it goes to 0.03125. Topology,
//   face corners and every channel unchanged; every face still faces +z.
// - The cube PolyMesh.cube(1): each corner's three neighbours differ from it
//   in one coordinate each, so their mean is a third of it: (1, 1, 1) sees
//   (-1, 1, 1), (1, -1, 1), (1, 1, -1), mean (1/3, 1/3, 1/3). A step of
//   factor 0.5 takes the corner s to s + 0.5 (s / 3 - s) = (2/3) s: the cube
//   shrinks to half-size 2/3 (volume 8 (2/3)^3 = 2.370370, positive, so
//   every face still faces out), and after two steps to 4/9 (volume
//   0.702332). Taubin's mu for lambda 0.5 and kPB 0.1 is 1 / (0.1 - 2) =
//   -10/19 = -0.5263158; the mu step takes s to s (1 - 2 mu / 3) = (77/57) s,
//   so one lambda|mu pass leaves the corner at (2/3)(77/57) = 154/171 =
//   0.9005848.
// - A ring: the regular octagon of radius 1 (from (1, 0), counterclockwise)
//   extruded along (0, 0, 1), one segment, no caps: vertex j at z = 0 and 8 +
//   j at z = 1, each on two faces, with two boundary edges along its ring
//   and one inner edge up the tube. So each smooths along its ring, towards
//   its two ring neighbours, whose mean is cos(45) times it: a step of
//   factor l scales the radius by 1 - l (1 - cos 45) and leaves z alone.
//   Laplacian 0.5: 1 - 0.5 x 0.2928932 = 0.8535534 per step, 0.4530576
//   after 5. Taubin, lambda 0.5 and mu -10/19: the mu step scales by 1 +
//   (10/19) 0.2928932 = 1.1541543, the pass by 0.8535534 x 1.1541543 =
//   0.9851323, and 5 passes by 0.9278395: it keeps its size where the
//   Laplacian halves it.
// - A crease: the grid with 7 raised to (2, 1, 1) and 12 moved along the
//   middle row to (2.5, 2, 0), and crease 1 on the row's edges 10-11, 11-12,
//   12-13, 13-14. 11, 12 and 13 each have two crease edges, so each smooths
//   along the row: 12 towards (11 + 13) / 2 = (2, 2, 0), to (2.25, 2, 0); 11
//   towards (10 + 12) / 2 = (1.25, 2, 0), to (1.125, 2, 0); 13 towards (12 +
//   14) / 2 = (3.25, 2, 0), to (3.125, 2, 0). 10 and 14 have two boundary
//   edges and the crease, three sharp edges, so they stay. The row stays on
//   y = 2, z = 0: straight. 7 smooths with all four, 2 (2, 0, 0), 6 (1, 1,
//   0), 8 (3, 1, 0), 12 (2.5, 2, 0), mean (2.125, 1, 0): to (2.0625, 1,
//   0.5). Without the crease, 12 would smooth towards 7, 11, 13, 17, mean
//   (2, 2, 0.25), to (2.25, 2, 0.125), off the row; with only 12-13 creased
//   (a dart at 12, one crease edge) it smooths with all four likewise.
// - Corners: the raised grid with a "crease_vert" of 10 at 12: 12 stays at
//   (2, 2, 1), and 7 still goes to 0.125. With crease 2 on 7-12, 11-12 and
//   12-13 instead: three crease edges, so 12 stays; 7 has one (a dart) and
//   smooths with all four, to 0.125.
// - The boundary: the grid with 2 moved out to (2, -0.5, 0). Pinned: every
//   boundary vertex stays; 7 sees 2 (2, -0.5, 0), 6 (1, 1, 0), 8 (3, 1, 0),
//   12 (2, 2, 0), mean (2, 0.875, 0), so goes to (2, 0.9375, 0). Along: 2
//   goes towards (1 + 3) / 2 = (2, 0, 0), to (2, -0.25, 0); 1 towards (0 +
//   2) / 2 = (1, -0.25, 0), to (1, -0.125, 0); 3 likewise to (3, -0.125, 0);
//   corner 0 stays at (0, 0, 0) (unpinned it would go halfway to (0.5, 0.5,
//   0)); 7 to (2, 0.9375, 0) again, from the old positions.
// - Weights: the raised grid with a vertex channel "pin", 1 but 0 at 12 and
//   0.5 at 13: 12 stays at (2, 2, 1); 7 goes to 0.125; 13 to 0.5 x 0.5 x
//   0.25 = 0.0625. A name with no channel weighs 1: 12 to 0.5.
// - Determinism: the cube subdivided twice, smoothed by both, twice over,
//   gives the same bits.

mod smoothings;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

imm near = 0.00001d;

fn point(got Vec3, x f32, y f32, z f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn clean(m &PolyMesh, label &Array[u8]) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &Array[u8]) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn edgeOf(m &PolyMesh, a u32, b u32) u32 {
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    imm p = *m.hVertex[usize.from(2u32 * e)];
    imm q = *m.hVertex[usize.from(2u32 * e + 1u32)];
    if (p == a and q == b) or (p == b and q == a) { return e; }
    e = e + 1u32;
  }
  NoIndex;
}

fn setCrease(m &mut PolyMesh, a u32, b u32, value f32) {
  imm ch = m.addFloatChannel(EdgeDomain, "crease", 0.);
  m.setFloat(ch, edgeOf(m, a, b), value);
}

fn volume(m &PolyMesh) f32 {
  mut sum f32 = 0.;
  mut f = 0usize;
  while f < m.faceCount() {
    imm pts = m.facePositions(u32.from(f));
    mut i = 1usize;
    while i + 1usize < pts.len() {
      sum = sum + pts[0usize].dot(pts[i].cross(*pts[i + 1usize]));
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.;
}

fn grid() PolyMesh {
  mut pts = List[Vec3].empty();
  mut j = 0u32;
  while j < 5u32 {
    mut i = 0u32;
    while i < 5u32 {
      pts.push(new Vec3(f32.from(i), f32.from(j), 0.));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  mut sizes = List[u32].empty();
  mut idx = List[u32].empty();
  j = 0u32;
  while j < 4u32 {
    mut i = 0u32;
    while i < 4u32 {
      imm a = 5u32 * j + i;
      sizes.push(4u32);
      idx.push(a);
      idx.push(a + 1u32);
      idx.push(a + 6u32);
      idx.push(a + 5u32);
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pts.view(), sizes.view(), idx.view(), &mut problems);
}

fn addChannels(m &mut PolyMesh) {
  imm w = m.addFloatChannel(VertexDomain, "w", 0.);
  mut v = 0u32;
  while usize.from(v) < m.vertexCount() {
    m.setFloat(w, v, f32.from(v));
    v = v + 1u32;
  }
  imm tag = m.addFloatChannel(EdgeDomain, "tag", 0.);
  mut e = 0u32;
  while usize.from(e) < m.edgeCount() {
    m.setFloat(tag, e, f32.from(e));
    e = e + 1u32;
  }
  imm id = m.addFloatChannel(FaceDomain, "id", 0.);
  imm uv = m.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  mut f = 0u32;
  while usize.from(f) < m.faceCount() {
    m.setFloat(id, f, 10. + f32.from(f));
    imm hs = m.faceHalfedges(f);
    mut i = 0usize;
    while i < hs.len() {
      imm hv = m.toVertex(*hs[i]);
      m.setVec2(uv, *hs[i], new Vec2(f32.from(hv) / 25., f32.from(f) / 16.));
      i = i + 1usize;
    }
    f = f + 1u32;
  }
}

fn moved(m &mut PolyMesh, v u32, p Vec3) {
  m.positions.set(usize.from(v), p);
}

fn raised() PolyMesh {
  mut g = grid();
  moved(&mut g, 12u32, new Vec3(2., 2., 1.));
  g;
}

// How many values of the channels differ between a and b, every domain
fn channelDiffs(a &PolyMesh, b &PolyMesh) i64 {
  mut n = 0i64;
  if a.floats.len() != b.floats.len() or a.vec2s.len() != b.vec2s.len() { return -1; }
  mut c = 0usize;
  while c < a.floats.len() {
    if !a.floats[c].name.equals(b.floats[c].name.view()) or a.floats[c].domain != b.floats[c].domain { n = n + 1; }
    imm len = a.floats[c].values.len();
    if len != b.floats[c].values.len() { return -1; }
    mut k = 0usize;
    while k < len {
      if *a.floats[c].values[k] != *b.floats[c].values[k] { n = n + 1; }
      k = k + 1usize;
    }
    c = c + 1usize;
  }
  c = 0usize;
  while c < a.vec2s.len() {
    imm len = a.vec2s[c].values.len();
    if len != b.vec2s[c].values.len() { return -1; }
    mut k = 0usize;
    while k < len {
      imm p = *a.vec2s[c].values[k];
      imm q = *b.vec2s[c].values[k];
      if p.x != q.x or p.y != q.y { n = n + 1; }
      k = k + 1usize;
    }
    c = c + 1usize;
  }
  n;
}

// How many faces' corners differ between a and b
fn faceDiffs(a &PolyMesh, b &PolyMesh) i64 {
  mut n = 0i64;
  mut f = 0u32;
  while usize.from(f) < a.faceCount() {
    imm p = a.faceVertices(f);
    imm q = b.faceVertices(f);
    if p.len() != q.len() { n = n + 1; } else {
      mut i = 0usize;
      while i < p.len() {
        if *p[i] != *q[i] { n = n + 1; }
        i = i + 1usize;
      }
    }
    f = f + 1u32;
  }
  n;
}

// How many positions differ in their bits between a and b
fn positionDiffs(a &PolyMesh, b &PolyMesh) i64 {
  mut n = 0i64;
  mut v = 0usize;
  while v < a.positions.len() {
    imm p = *a.positions[v];
    imm q = *b.positions[v];
    if p.x != q.x or p.y != q.y or p.z != q.z { n = n + 1; }
    v = v + 1usize;
  }
  n;
}

fn laplacianSteps() {
  mut g = raised();
  addChannels(&mut g);
  imm s = smooth(&g, 0.5, 1u32);
  counts(&s, 25, 40, 16, "grid: 25 vertices, 40 edges, 16 faces");
  clean(&s, "grid: validates");
  expectInt(faceDiffs(&g, &s), 0, "grid: every face keeps its corners");
  expectInt(channelDiffs(&g, &s), 0, "grid: every channel carried unchanged");
  mut up = 0i64;
  mut f = 0u32;
  while usize.from(f) < s.faceCount() {
    if s.faceNormal(f).z > 0. { up = up + 1; }
    f = f + 1u32;
  }
  expectInt(up, 16, "grid: every face still faces +z");
  point(*s.positions[12usize], 2., 2., 0.5, "grid: the raised centre halfway down");
  point(*s.positions[7usize], 2., 1., 0.125, "grid: 7 a quarter of the way up");
  point(*s.positions[11usize], 1., 2., 0.125, "grid: 11 likewise");
  point(*s.positions[13usize], 3., 2., 0.125, "grid: 13 from 12's old height (Jacobi)");
  point(*s.positions[17usize], 2., 3., 0.125, "grid: 17 from 12's old height (Jacobi)");
  point(*s.positions[6usize], 1., 1., 0., "grid: 6 stays");
  point(*s.positions[1usize], 1., 0., 0., "grid: boundary 1 stays on its straight side");
  point(*s.positions[0usize], 0., 0., 0., "grid: corner 0 stays");

  imm s2 = smooth(&g, 0.5, 2u32);
  point(*s2.positions[12usize], 2., 2., 0.3125, "grid, two steps: 12");
  point(*s2.positions[7usize], 2., 1., 0.125, "grid, two steps: 7 holds");
  point(*s2.positions[6usize], 1., 1., 0.03125, "grid, two steps: 6");

  imm s0 = smooth(&g, 0.5, 0u32);
  point(*s0.positions[12usize], 2., 2., 1., "grid, no steps: unchanged");
  expectInt(channelDiffs(&g, &s0), 0, "grid, no steps: channels unchanged");
}

fn cubeShrinks() {
  imm c = PolyMesh.cube(1.);
  imm s = smooth(&c, 0.5, 1u32);
  counts(&s, 8, 12, 6, "cube: 8 vertices, 12 edges, 6 faces");
  clean(&s, "cube: validates");
  point(*s.positions[0usize], -0.6666667, -0.6666667, -0.6666667, "cube: corner 0 to two thirds");
  point(*s.positions[7usize], 0.6666667, 0.6666667, 0.6666667, "cube: corner 7 to two thirds");
  point(*s.positions[1usize], 0.6666667, -0.6666667, -0.6666667, "cube: corner 1 to two thirds");
  point(*s.positions[6usize], -0.6666667, 0.6666667, 0.6666667, "cube: corner 6 to two thirds");
  expectFloat(volume(&s), 2.370370, near, "cube: volume (4/3)^3, faces outward");
  imm s2 = smooth(&c, 0.5, 2u32);
  point(*s2.positions[7usize], 0.4444444, 0.4444444, 0.4444444, "cube, two steps: 4/9");
  expectFloat(volume(&s2), 0.702332, near, "cube, two steps: volume (8/9)^3");

  imm mu = taubinMu(0.5, TaubinPassBand);
  expectFloat(mu, -0.5263158, near, "taubin: mu for lambda 0.5, kPB 0.1 is -10/19");
  imm t = smoothTaubin(&c, 0.5, mu, 1u32);
  clean(&t, "cube, taubin: validates");
  point(*t.positions[7usize], 0.9005848, 0.9005848, 0.9005848, "cube, taubin: 154/171");
  point(*t.positions[2usize], -0.9005848, 0.9005848, -0.9005848, "cube, taubin: corner 2");
}

fn rings() {
  imm oct = Profile.polygon(8u32, 1.);
  imm tube = extrude(&oct, new Vec3(0., 0., 1.), 1u32, false);
  counts(&tube, 16, 24, 8, "ring: 16 vertices, 24 edges, 8 faces");
  imm l1 = smooth(&tube, 0.5, 1u32);
  point(*l1.positions[0usize], 0.8535534, 0., 0., "ring, one step: radius 1 - 0.5 (1 - cos 45)");
  imm l5 = smooth(&tube, 0.5, 5u32);
  imm mu = taubinMu(0.5, TaubinPassBand);
  imm t1 = smoothTaubin(&tube, 0.5, mu, 1u32);
  point(*t1.positions[0usize], 0.9851323, 0., 0., "ring, taubin one pass: the two factors' product");
  imm t5 = smoothTaubin(&tube, 0.5, mu, 5u32);
  clean(&t5, "ring, taubin: validates");
  expectInt(channelDiffs(&tube, &t5), 0, "ring, taubin: uvs carried unchanged");
  expectInt(faceDiffs(&tube, &t5), 0, "ring, taubin: faces unchanged");
  mut v = 0usize;
  while v < 16usize {
    imm z = if v < 8usize {0.;} else {1.;};
    imm p = *l5.positions[v];
    imm q = *t5.positions[v];
    expectFloat(new Vec2(p.x, p.y).length(), 0.4530576, near, "ring, laplacian five steps: radius");
    expectFloat(p.z, z, near, "ring, laplacian: z unchanged");
    expectFloat(new Vec2(q.x, q.y).length(), 0.9278395, near, "ring, taubin five passes: radius");
    expectFloat(q.z, z, near, "ring, taubin: z unchanged");
    v = v + 1usize;
  }
  require(t5.positions[3usize].length() > l5.positions[3usize].length(), "ring: taubin keeps its size better");
}

fn creasesKept() {
  mut g = grid();
  moved(&mut g, 7u32, new Vec3(2., 1., 1.));
  moved(&mut g, 12u32, new Vec3(2.5, 2., 0.));
  imm plain = smooth(&g, 0.5, 1u32);
  point(*plain.positions[12usize], 2.25, 2., 0.125, "no crease: 12 leaves the row");

  mut dart = grid();
  moved(&mut dart, 7u32, new Vec3(2., 1., 1.));
  moved(&mut dart, 12u32, new Vec3(2.5, 2., 0.));
  setCrease(&mut dart, 12u32, 13u32, 1.);
  imm d = smooth(&dart, 0.5, 1u32);
  point(*d.positions[12usize], 2.25, 2., 0.125, "a dart: 12 smooths with all four");

  setCrease(&mut g, 10u32, 11u32, 1.);
  setCrease(&mut g, 11u32, 12u32, 1.);
  setCrease(&mut g, 12u32, 13u32, 1.);
  setCrease(&mut g, 13u32, 14u32, 1.);
  imm s = smooth(&g, 0.5, 1u32);
  clean(&s, "crease: validates");
  expectInt(channelDiffs(&g, &s), 0, "crease: the crease channel carried");
  point(*s.positions[12usize], 2.25, 2., 0., "crease: 12 slides along the row");
  point(*s.positions[11usize], 1.125, 2., 0., "crease: 11 slides along the row");
  point(*s.positions[13usize], 3.125, 2., 0., "crease: 13 slides along the row");
  point(*s.positions[10usize], 0., 2., 0., "crease: 10, boundary and crease, stays");
  point(*s.positions[14usize], 4., 2., 0., "crease: 14 stays");
  point(*s.positions[7usize], 2.0625, 1., 0.5, "crease: 7 smooths with all four");
}

fn corners() {
  mut g = raised();
  imm vc = g.addFloatChannel(VertexDomain, "crease_vert", 0.);
  g.setFloat(vc, 12u32, SharpnessInfinite);
  imm s = smooth(&g, 0.5, 1u32);
  point(*s.positions[12usize], 2., 2., 1., "vertex crease: 12 pinned");
  point(*s.positions[7usize], 2., 1., 0.125, "vertex crease: 7 still moves");

  mut h = raised();
  setCrease(&mut h, 7u32, 12u32, 2.);
  setCrease(&mut h, 11u32, 12u32, 2.);
  setCrease(&mut h, 12u32, 13u32, 2.);
  imm t = smooth(&h, 0.5, 1u32);
  point(*t.positions[12usize], 2., 2., 1., "three crease edges: 12 pinned");
  point(*t.positions[7usize], 2., 1., 0.125, "three crease edges: 7, a dart, smooths with all four");
}

fn boundaries() {
  mut g = grid();
  moved(&mut g, 2u32, new Vec3(2., -0.5, 0.));
  imm p = smoothWith(&g, 0.5, 1u32, SmoothBoundaryPinned, "");
  mut kept = 0i64;
  mut v = 0u32;
  while v < 25u32 {
    if g.isBoundaryVertex(v) {
      imm a = *g.positions[usize.from(v)];
      imm b = *p.positions[usize.from(v)];
      if a.x == b.x and a.y == b.y and a.z == b.z { kept = kept + 1; }
    }
    v = v + 1u32;
  }
  expectInt(kept, 16, "pinned: all 16 boundary vertices kept");
  point(*p.positions[2usize], 2., -0.5, 0., "pinned: 2 stays out");
  point(*p.positions[7usize], 2., 0.9375, 0., "pinned: 7 from the old positions");

  imm a = smooth(&g, 0.5, 1u32);
  point(*a.positions[2usize], 2., -0.25, 0., "along: 2 halfway back");
  point(*a.positions[1usize], 1., -0.125, 0., "along: 1 along the boundary");
  point(*a.positions[3usize], 3., -0.125, 0., "along: 3 along the boundary");
  point(*a.positions[0usize], 0., 0., 0., "along: corner 0 stays");
  point(*a.positions[4usize], 4., 0., 0., "along: corner 4 stays");
  point(*a.positions[7usize], 2., 0.9375, 0., "along: 7 from the old positions");
}

fn weights() {
  mut g = raised();
  imm ch = g.addFloatChannel(VertexDomain, "pin", 1.);
  g.setFloat(ch, 12u32, 0.);
  g.setFloat(ch, 13u32, 0.5);
  imm s = smoothWith(&g, 0.5, 1u32, SmoothBoundaryAlong, "pin");
  point(*s.positions[12usize], 2., 2., 1., "weight 0: 12 stays");
  point(*s.positions[7usize], 2., 1., 0.125, "weight 1: 7 moves fully");
  point(*s.positions[13usize], 3., 2., 0.0625, "weight 0.5: 13 moves half");
  expectInt(channelDiffs(&g, &s), 0, "weight: the channel carried");
  imm n = smoothWith(&g, 0.5, 1u32, SmoothBoundaryAlong, "nope");
  point(*n.positions[12usize], 2., 2., 0.5, "no such channel: weight 1");
  imm t = smoothTaubinWith(&g, 0.5, taubinMu(0.5, TaubinPassBand), 3u32, SmoothBoundaryAlong, "pin");
  point(*t.positions[12usize], 2., 2., 1., "taubin, weight 0: 12 stays");
}

fn determinism() {
  imm cage = PolyMesh.cube(1.);
  imm c = subdivide(&cage, 2u32);
  imm a = smooth(&c, 0.6, 4u32);
  imm b = smooth(&c, 0.6, 4u32);
  expectInt(positionDiffs(&a, &b), 0, "laplacian: the same bits twice");
  imm mu = taubinMu(0.6, TaubinPassBand);
  imm t = smoothTaubin(&c, 0.6, mu, 4u32);
  imm u = smoothTaubin(&c, 0.6, mu, 4u32);
  expectInt(positionDiffs(&t, &u), 0, "taubin: the same bits twice");
  expectInt(channelDiffs(&c, &t), 0, "taubin: channels carried");
  require(volume(&t) > volume(&a), "taubin: the subdivided cube shrinks less");
}

fn main() i32 {
  laplacianSteps();
  cubeShrinks();
  rings();
  creasesKept();
  corners();
  boundaries();
  weights();
  determinism();
  done();
}
