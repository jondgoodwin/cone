// The sculpt package's un-subdivide, checked with the testing package; only
// a failure prints, so unsubdivides.out holds the summary alone. Every result
// is checked valid, its topology by the Euler characteristic V - E + F, and
// its bits by meshHash of its flat triangulation, pinned.
//
// - Round trips through subdivide (whose numbering puts vertex points first,
//   so the lowest vertex is a vertex point and the reading is the cage's):
//   - the cube cage subdivided once (26, 48, 24) and un-subdivided once is
//     the cage again: 8, 12, 6, every face the cage's face, corner for corner
//     from its first; the positions are level 1's vertex points (vertex 7 at
//     5/9 of the corner, not back at it: the smoothing is not inverted);
//   - subdivided twice: once gives level 1's faces, twice the cage's; a third
//     iteration finds no grid, says so in one line and stops, the cage kept;
//   - the cube with every edge creased infinitely sharp, subdivided twice
//     and un-subdivided twice: its corners never moved, so the positions come
//     back too, bit for bit;
//   - a hexagonal prism (two n-gon caps, face points of valence 6), a lathed
//     sphere (triangles at its poles, face points of valence 3) and a lathed
//     torus (every vertex of valence 4, so both readings would collapse
//     everything and the numbering decides) each back to the cage's faces.
// - Plane grids (made by hand, row by row):
//   - 4 x 4 quads (25 vertices): once, the 2 x 2 grid of its even-even
//     vertices, positions exact (9, 12, 4); twice, one quad of its corners;
//   - the same grid numbered from its second vertex (vertex 0 at (1, 0), an
//     edge point): the cage's reading collapses 16 quads and the reading
//     that would keep vertex 0 only 8, so the cage's wins: again 9 vertices
//     at the even-even places;
//   - 5 x 5 quads (36 vertices), odd: the four face points inside collapse
//     (16 quads), the last row and column of quads stay: 24 vertices, 36
//     edges, 13 faces (a quad, two pentagons and a hexagon where kept edge
//     points stay as corners, and the 9 quads), one line.
// - A non-grid region: the 4 x 4 grid with the four quads round (3, 3) each
//   cut into two triangles: three fans collapse, the 8 triangles and the
//   edge points beside them stay: 14, 24, 11, one line.
// - Choosing the reading: the cube subdivided once with its face point 20
//   kept is read the other way, into the octahedron (6, 12, 8); keeping 20
//   and then vertex 0 reports vertex 0 (the reading removes it), leaves its
//   three quads, and is still valid with characteristic 2.
// - Refused and reported: a mesh made invalid (one line, unchanged); a vertex
//   to keep past the end (one line, the rest done); a tetrahedron (no quads:
//   one line, unchanged); 0 iterations (a copy, nothing reported).
// - Channels: the cube with a vertex "h" = x + 2y + 3z, a vertex "weight"
//   (fill 1) of 0.5, a face "id" = its number, an edge "w" = its number, an
//   edge "crease" 3, a corner "uv" = (x, y) of its vertex; subdivided once
//   and back: h and weight at each kept vertex its level-1 value, bit for
//   bit; id and w back to their own numbers (faces and edges numbered as the
//   cage's); crease 2 (subdivision's one less, not added back); each corner's
//   uv the level-1 child quad's at that vertex; every fill kept.
// - The same bits twice; six hashes pinned.

mod unsubdivides;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

// The pinned hashes: the cube once and back, twice and back once, twice and
// back twice, the odd grid, the non-grid region, the octahedron
imm PINNED Array[u32, 6] = [1115021034u32, 3443810834u32, 2345233139u32, 2686442339u32, 3860874906u32,
  3068073199u32];

fn hashOf(m &PolyMesh) u32 {
  imm t = m.triangulate(false);
  meshHash(&t);
}

fn pinned(m &PolyMesh, k usize, label &[]u8) {
  expectUInt(u64.from(hashOf(m)), u64.from(PINNED[k]), label);
}

fn sound(m &PolyMesh, label &[]u8) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
}

fn counts(m &PolyMesh, nv i64, ne i64, nf i64, label &[]u8) {
  expectInt(i64.from(m.vertexCount()), nv, label);
  expectInt(i64.from(m.edgeCount()), ne, label);
  expectInt(i64.from(m.faceCount()), nf, label);
}

fn euler(m &PolyMesh) i64 {
  i64.from(m.vertexCount()) - i64.from(m.edgeCount()) + i64.from(m.faceCount());
}

// Whether a and b have the same vertex count and the same faces, corner for
// corner from each face's first
fn sameFaces(a &PolyMesh, b &PolyMesh) Bool {
  if a.vertexCount() != b.vertexCount() or a.faceCount() != b.faceCount() { return false; }
  mut f = 0u32;
  while usize.from(f) < a.faceCount() {
    imm va = a.faceVertices(f);
    imm vb = b.faceVertices(f);
    if va.len() != vb.len() { return false; }
    mut i = 0usize;
    while i < va.len() {
      if *va[i] != *vb[i] { return false; }
      i = i + 1usize;
    }
    f = f + 1u32;
  }
  true;
}

// Whether every vertex of a sits exactly where vertex v of b does
fn samePositions(a &PolyMesh, b &PolyMesh) Bool {
  mut v = 0usize;
  while v < a.vertexCount() {
    imm p = *a.positions[v];
    imm q = *b.positions[v];
    if p.x != q.x or p.y != q.y or p.z != q.z { return false; }
    v = v + 1usize;
  }
  true;
}

// A grid of n x n quads, 0..n in x and z, row by row (vertex i + (n + 1) j
// at (i, 0, j)), faces facing +y; with 'shift' vertex numbers moved down by
// one round the list (vertex 0 at (1, 0, 0)); with 'cut' the four quads round
// (3, 3) each cut into two triangles
fn grid(n u32, shift Bool, cut Bool) PolyMesh {
  imm side = n + 1u32;
  imm nv = side * side;
  // number[k] is the vertex at place k
  mut number = List[u32].empty();
  mut k = 0u32;
  while k < nv {
    if shift { number.push((k + nv - 1u32) % nv); } else { number.push(k); }
    k = k + 1u32;
  }
  mut pos = List[Vec3].empty();
  k = 0u32;
  while k < nv {
    pos.push(new Vec3(0., 0., 0.));
    k = k + 1u32;
  }
  k = 0u32;
  while k < nv {
    pos.set(usize.from(*number[usize.from(k)]), new Vec3(f32.from(k % side), 0., f32.from(k / side)));
    k = k + 1u32;
  }
  mut fc = List[u32].empty();
  mut fi = List[u32].empty();
  mut j = 0u32;
  while j < n {
    mut i = 0u32;
    while i < n {
      imm a = *number[usize.from(i + side * j)];
      imm b = *number[usize.from(i + 1u32 + side * j)];
      imm c = *number[usize.from(i + 1u32 + side * (j + 1u32))];
      imm d = *number[usize.from(i + side * (j + 1u32))];
      // Counterclockwise seen from +y: a, d, c, b
      if cut and i >= 2u32 and i < 4u32 and j >= 2u32 and j < 4u32 {
        fc.push(3u32); fi.push(a); fi.push(d); fi.push(c);
        fc.push(3u32); fi.push(a); fi.push(c); fi.push(b);
      } else {
        fc.push(4u32); fi.push(a); fi.push(d); fi.push(c); fi.push(b);
      }
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pos.view(), fc.view(), fi.view(), &mut problems);
}

fn cubeTrips() {
  imm c = PolyMesh.cube(0.5);
  imm s1 = subdivide(&c, 1u32);
  counts(&s1, 26, 48, 24, "cube level 1: counts");
  mut p = List[String].empty();
  imm u1 = unsubdivide(&s1, 1u32, &mut p);
  sound(&u1, "cube 1-1: sound");
  counts(&u1, 8, 12, 6, "cube 1-1: counts");
  expectInt(euler(&u1), 2, "cube 1-1: characteristic 2");
  expect(sameFaces(&u1, &c), "cube 1-1: the cage's faces");
  expect(samePositions(&u1, &s1), "cube 1-1: level 1's vertex points");
  expectFloat(f64.from(u1.positions[7usize].x), 5.d / 18.d, 0.000001d, "cube 1-1: vertex 7 at 5/9 of the corner");
  pinned(&u1, 0usize, "cube 1-1: hash");
  imm again = unsubdivide(&s1, 1u32, &mut p);
  expectUInt(u64.from(hashOf(&again)), u64.from(hashOf(&u1)), "cube 1-1: the same bits twice");

  imm s2 = subdivide(&c, 2u32);
  imm u21 = unsubdivide(&s2, 1u32, &mut p);
  sound(&u21, "cube 2-1: sound");
  expect(sameFaces(&u21, &s1), "cube 2-1: level 1's faces");
  expect(samePositions(&u21, &s2), "cube 2-1: level 2's vertex points");
  pinned(&u21, 1usize, "cube 2-1: hash");
  imm u22 = unsubdivide(&s2, 2u32, &mut p);
  sound(&u22, "cube 2-2: sound");
  expect(sameFaces(&u22, &c), "cube 2-2: the cage's faces");
  expectInt(euler(&u22), 2, "cube 2-2: characteristic 2");
  pinned(&u22, 2usize, "cube 2-2: hash");
  expectInt(i64.from(p.len()), 0, "cube trips: nothing reported");
  imm u23 = unsubdivide(&s2, 3u32, &mut p);
  expectInt(i64.from(p.len()), 1, "cube 2-3: one line");
  expectUInt(u64.from(hashOf(&u23)), u64.from(hashOf(&u22)), "cube 2-3: the cage kept");
  p.clear();

  // Creased infinitely sharp: the corners stay, so the positions come back
  mut cc = PolyMesh.cube(0.5);
  imm ch = cc.addFloatChannel(EdgeDomain, "crease", 0.);
  mut e = 0u32;
  while usize.from(e) < cc.edgeCount() {
    cc.setFloat(ch, e, SharpnessInfinite);
    e = e + 1u32;
  }
  imm cs = subdivide(&cc, 2u32);
  imm cu = unsubdivide(&cs, 2u32, &mut p);
  expect(sameFaces(&cu, &cc), "creased 2-2: the cage's faces");
  expect(samePositions(&cu, &cc), "creased 2-2: the cage's positions, bit for bit");
  imm cuc = cu.findFloatChannel(EdgeDomain, "crease");
  expectFloat(f64.from(cu.float(cuc, 0u32)), 10.d, 0.d, "creased 2-2: an infinite crease stays infinite");

  // n-gon caps, poles and a torus
  imm hexProfile = Profile.polygon(6u32, 0.5);
  imm hex = extrude(&hexProfile, new Vec3(0., 0., 1.), 1u32, true);
  imm hexS = subdivide(&hex, 1u32);
  imm hu = unsubdivide(&hexS, 1u32, &mut p);
  sound(&hu, "prism: sound");
  expect(sameFaces(&hu, &hex), "prism: the cage's faces");
  imm arc Array[Vec2, 5] = [new Vec2(0., -1.), new Vec2(0.7, -0.7), new Vec2(1., 0.), new Vec2(0.7, 0.7),
    new Vec2(0., 1.)];
  imm arcProfile = Profile.fromPoints(&arc, false);
  imm ball = lathe(&arcProfile, new Vec3(0., 1., 0.), 2. * pi, 8u32);
  imm ballS = subdivide(&ball, 2u32);
  imm bu = unsubdivide(&ballS, 2u32, &mut p);
  sound(&bu, "sphere: sound");
  expect(sameFaces(&bu, &ball), "sphere: the cage's faces");
  expectInt(euler(&bu), 2, "sphere: characteristic 2");
  mut ring = List[Vec2].empty();
  mut i = 0u32;
  while i < 6u32 {
    imm a = 2. * pi * f32.from(i) / 6.;
    ring.push(new Vec2(1. + 0.3 * cos(a), 0.3 * sin(a)));
    i = i + 1u32;
  }
  imm ringProfile = Profile.fromPoints(ring.view(), true);
  imm torus = lathe(&ringProfile, new Vec3(0., 1., 0.), 2. * pi, 8u32);
  imm torusS = subdivide(&torus, 1u32);
  imm tu = unsubdivide(&torusS, 1u32, &mut p);
  sound(&tu, "torus: sound");
  expect(sameFaces(&tu, &torus), "torus: the cage's faces");
  expectInt(euler(&tu), 0, "torus: characteristic 0");
  expectInt(i64.from(p.len()), 0, "creased, prism, sphere, torus: nothing reported");
}

fn grids() {
  mut p = List[String].empty();
  imm g = grid(4u32, false, false);
  imm g1 = unsubdivide(&g, 1u32, &mut p);
  sound(&g1, "grid 4-1: sound");
  counts(&g1, 9, 12, 4, "grid 4-1: counts");
  expectInt(euler(&g1), 1, "grid 4-1: a disc");
  mut even = true;
  mut v = 0usize;
  while v < g1.vertexCount() {
    imm q = *g1.positions[v];
    if q.x != 2. * f32.from(v % 3usize) or q.z != 2. * f32.from(v / 3usize) or q.y != 0. { even = false; }
    v = v + 1usize;
  }
  expect(even, "grid 4-1: the even-even vertices, in order, exact");
  imm g2 = unsubdivide(&g, 2u32, &mut p);
  counts(&g2, 4, 4, 1, "grid 4-2: one quad");
  imm c4 = g2.facePositions(0u32);
  expectFloat(f64.from(c4[2usize].x + c4[2usize].z), 8.d, 0.d, "grid 4-2: its far corner (4, 0, 4)");
  expectInt(i64.from(p.len()), 0, "grid 4: nothing reported");

  imm gs = grid(4u32, true, false);
  imm gs1 = unsubdivide(&gs, 1u32, &mut p);
  sound(&gs1, "shifted grid: sound");
  counts(&gs1, 9, 12, 4, "shifted grid: counts");
  mut evenS = true;
  v = 0usize;
  while v < gs1.vertexCount() {
    imm q = *gs1.positions[v];
    imm ix = i32.from(q.x);
    imm iz = i32.from(q.z);
    if f32.from(ix) != q.x or f32.from(iz) != q.z or ix % 2i32 != 0i32 or iz % 2i32 != 0i32 { evenS = false; }
    v = v + 1usize;
  }
  expect(evenS, "shifted grid: every vertex at an even-even place");
  expectInt(i64.from(p.len()), 0, "shifted grid: nothing reported");

  imm odd = grid(5u32, false, false);
  imm o1 = unsubdivide(&odd, 1u32, &mut p);
  sound(&o1, "grid 5-1: sound");
  counts(&o1, 24, 36, 13, "grid 5-1: counts");
  expectInt(i64.from(o1.faceDegree(0u32)), 4, "grid 5-1: the first fan a quad");
  expectInt(i64.from(o1.faceDegree(1u32)), 5, "grid 5-1: the second a pentagon");
  mut hexagons = 0i64;
  mut f = 0u32;
  while usize.from(f) < o1.faceCount() {
    if o1.faceDegree(f) == 6usize { hexagons = hexagons + 1; }
    f = f + 1u32;
  }
  expectInt(hexagons, 1, "grid 5-1: one hexagon");
  expectInt(i64.from(p.len()), 1, "grid 5-1: one line");
  pinned(&o1, 3usize, "grid 5-1: hash");
  p.clear();
  imm o2 = unsubdivide(&odd, 4u32, &mut p);
  sound(&o2, "grid 5-4: sound");
  expectInt(euler(&o2), 1, "grid 5-4: a disc");
  p.clear();

  imm cut = grid(4u32, false, true);
  counts(&cut, 25, 44, 20, "non-grid: the input");
  imm cu = unsubdivide(&cut, 1u32, &mut p);
  sound(&cu, "non-grid: sound");
  counts(&cu, 14, 24, 11, "non-grid: counts");
  mut tris = 0i64;
  f = 0u32;
  while usize.from(f) < cu.faceCount() {
    if cu.faceDegree(f) == 3usize { tris = tris + 1; }
    f = f + 1u32;
  }
  expectInt(tris, 8, "non-grid: the 8 triangles kept");
  expectInt(i64.from(p.len()), 1, "non-grid: one line");
  pinned(&cu, 4usize, "non-grid: hash");
}

fn readings() {
  imm s1 = subdivide(&PolyMesh.cube(0.5), 1u32);
  mut p = List[String].empty();
  imm k20 Array[u32, 1] = [20u32];
  imm oct = unsubdivideWith(&s1, 1u32, &k20, &mut p);
  sound(&oct, "octahedron: sound");
  counts(&oct, 6, 12, 8, "octahedron: counts");
  expectInt(euler(&oct), 2, "octahedron: characteristic 2");
  expectInt(i64.from(p.len()), 0, "octahedron: nothing reported");
  pinned(&oct, 5usize, "octahedron: hash");
  imm k200 Array[u32, 2] = [20u32, 0u32];
  imm both = unsubdivideWith(&s1, 1u32, &k200, &mut p);
  sound(&both, "two to keep: sound");
  expectInt(euler(&both), 2, "two to keep: characteristic 2");
  // Vertex 0's fan of 3 quads stays, and its 3 edge points with it
  counts(&both, 10, 18, 10, "two to keep: counts");
  expectInt(i64.from(p.len()), 2, "two to keep: vertex 0 reported, and the faces left");
}

fn refused() {
  imm s1 = subdivide(&PolyMesh.cube(0.5), 1u32);
  imm h0 = hashOf(&s1);
  mut p = List[String].empty();
  mut broken = subdivide(&PolyMesh.cube(0.5), 1u32);
  broken.hNext.set(0usize, 5u32);
  imm b = unsubdivide(&broken, 1u32, &mut p);
  expectInt(i64.from(p.len()), 1, "invalid mesh: one line");
  expectInt(i64.from(b.faceCount()), 24, "invalid mesh: unchanged");
  p.clear();
  imm past Array[u32, 1] = [99u32];
  imm pu = unsubdivideWith(&s1, 1u32, &past, &mut p);
  expectInt(i64.from(p.len()), 1, "keep past the end: one line");
  counts(&pu, 8, 12, 6, "keep past the end: the rest done");
  p.clear();
  imm tp Array[Vec3, 4] = [new Vec3(1., 1., 1.), new Vec3(1., -1., -1.), new Vec3(-1., 1., -1.), new Vec3(-1., -1., 1.)];
  imm tc Array[u32, 4] = [3u32, 3u32, 3u32, 3u32];
  imm ti Array[u32, 12] = [0u32, 1u32, 2u32, 0u32, 3u32, 1u32, 0u32, 2u32, 3u32, 1u32, 3u32, 2u32];
  imm tet = PolyMesh.fromPolygons(&tp, &tc, &ti, &mut p);
  sound(&tet, "tetrahedron: sound");
  imm tu = unsubdivide(&tet, 1u32, &mut p);
  expectInt(i64.from(p.len()), 1, "tetrahedron: one line");
  expectUInt(u64.from(hashOf(&tu)), u64.from(hashOf(&tet)), "tetrahedron: unchanged");
  p.clear();
  imm z = unsubdivide(&s1, 0u32, &mut p);
  expectInt(i64.from(p.len()), 0, "0 iterations: nothing reported");
  expectUInt(u64.from(hashOf(&z)), u64.from(h0), "0 iterations: a copy");
}

fn channels() {
  mut c = PolyMesh.cube(0.5);
  imm hc = c.addFloatChannel(VertexDomain, "h", 0.);
  imm wc = c.addFloatChannel(VertexDomain, "weight", 1.);
  imm ic = c.addFloatChannel(FaceDomain, "id", 0.);
  imm ec = c.addFloatChannel(EdgeDomain, "w", 0.);
  imm cc = c.addFloatChannel(EdgeDomain, "crease", 0.);
  imm uc = c.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  mut v = 0u32;
  while usize.from(v) < c.vertexCount() {
    imm q = *c.positions[usize.from(v)];
    c.setFloat(hc, v, q.x + 2. * q.y + 3. * q.z);
    c.setFloat(wc, v, 0.5);
    v = v + 1u32;
  }
  mut f = 0u32;
  while usize.from(f) < c.faceCount() {
    c.setFloat(ic, f, f32.from(f));
    f = f + 1u32;
  }
  mut e = 0u32;
  while usize.from(e) < c.edgeCount() {
    c.setFloat(ec, e, f32.from(e));
    c.setFloat(cc, e, 3.);
    e = e + 1u32;
  }
  mut h = 0u32;
  while usize.from(h) < c.halfedgeCount() {
    if c.face(h) != NoIndex {
      imm q = *c.positions[usize.from(c.toVertex(h))];
      c.setVec2(uc, h, new Vec2(q.x, q.y));
    }
    h = h + 1u32;
  }
  imm s1 = subdivide(&c, 1u32);
  mut p = List[String].empty();
  imm u = unsubdivide(&s1, 1u32, &mut p);
  expect(sameFaces(&u, &c), "channels: the cage's faces");
  imm uh = u.findFloatChannel(VertexDomain, "h");
  imm uw = u.findFloatChannel(VertexDomain, "weight");
  imm sh = s1.findFloatChannel(VertexDomain, "h");
  mut hOk = true;
  mut wOk = true;
  v = 0u32;
  while usize.from(v) < u.vertexCount() {
    if u.float(uh, v) != s1.float(sh, v) { hOk = false; }
    if u.float(uw, v) != 0.5 { wOk = false; }
    v = v + 1u32;
  }
  expect(hOk, "channels: h at each vertex its level-1 value");
  expect(wOk, "channels: weight 0.5");
  expectFloat(f64.from(u.floats[usize.from(uw)].fill), 1.d, 0.d, "channels: weight's fill 1 kept");
  imm ui = u.findFloatChannel(FaceDomain, "id");
  mut idOk = true;
  f = 0u32;
  while usize.from(f) < u.faceCount() {
    if u.float(ui, f) != f32.from(f) { idOk = false; }
    f = f + 1u32;
  }
  expect(idOk, "channels: each face's id its own number");
  imm ue = u.findFloatChannel(EdgeDomain, "w");
  imm ucr = u.findFloatChannel(EdgeDomain, "crease");
  mut wEdge = true;
  mut crease = true;
  e = 0u32;
  while usize.from(e) < u.edgeCount() {
    if u.float(ue, e) != f32.from(e) { wEdge = false; }
    if u.float(ucr, e) != 2. { crease = false; }
    e = e + 1u32;
  }
  expect(wEdge, "channels: each edge's w its own number");
  expect(crease, "channels: crease 3 come back as 2");
  // Corner k of face f is the first corner of level 1's child quad 4f + k
  imm uu = u.findVec2Channel(CornerDomain, "uv");
  imm su = s1.findVec2Channel(CornerDomain, "uv");
  mut uvOk = true;
  f = 0u32;
  while usize.from(f) < u.faceCount() {
    imm hs = u.faceHalfedges(f);
    mut k = 0u32;
    while usize.from(k) < hs.len() {
      imm a = u.vec2(uu, *hs[usize.from(k)]);
      imm b = s1.vec2(su, s1.faceHalfedge(4u32 * f + k));
      if a.x != b.x or a.y != b.y { uvOk = false; }
      k = k + 1u32;
    }
    f = f + 1u32;
  }
  expect(uvOk, "channels: each corner's uv the child quad's at its vertex");
  expectInt(i64.from(p.len()), 0, "channels: nothing reported");
}

fn main() i32 {
  cubeTrips();
  grids();
  readings();
  refused();
  channels();
  done();
}
