// The sculpt package's profiles, checked with the testing package against
// values worked out by hand; only a failure prints, so profiles.out holds the
// summary alone.
//
// - polygon(6, 1): corner i at angle 2 pi i / 6 from (1, 0): corner 1 at
//   (cos 60, sin 60) = (0.5, 0.866025), corner 3 at (-1, 0); a regular
//   hexagon's side equals its radius, so its length is 6; counterclockwise.
// - circle(8, 2): corner 2 at 90 degrees, (0, 2); corner 5 at 225 degrees,
//   (-1.414214, -1.414214).
// - rectangle(4, 2): (-2, -1), (2, -1), (2, 1), (-2, 1); length 12.
// - roundedRectangle(4, 2, 0.5, 2): four arcs of 3 points, 12. Lower right
//   centre (1.5, -0.5), angles -90, -45, 0: (1.5, -1), (1.5 + 0.353553,
//   -0.5 - 0.353553) = (1.853553, -0.853553), (2, -0.5). Upper right centre
//   (1.5, 0.5), angles 0, 45, 90: (2, 0.5), (1.853553, 0.853553), (1.5, 1).
//   Upper left centre (-1.5, 0.5) from 90: (-1.5, 1) is point 6. Lower left
//   centre (-1.5, -0.5), angles 180, 225, 270: (-2, -0.5), (-1.853553,
//   -0.853553), (-1.5, -1), points 9 to 11. Length: straight 3 + 1 + 3 + 1 = 8,
//   and 8 chords of 2 r sin(22.5) = 0.382683, 3.061467: 11.061467.
// - roundedRectangle(4, 2, 1, 2): the radius is half the height, so the right
//   arcs meet at (2, 0) and the left at (-2, 0), each kept once: 10 points.
//   Centres (1, 0) and (-1, 0): (1, -1), (1.707107, -0.707107), (2, 0),
//   (1.707107, 0.707107), (1, 1), (-1, 1), (-1.707107, 0.707107), (-2, 0),
//   (-1.707107, -0.707107), (-1, -1). A radius of 5 is held to 1: 10 again.
//   A radius of 0 is the rectangle, 4 points from (-2, -1).
// - hull of (0,0) (2,0) (1,1) (2,2) (0,2) (1,0): (1,1) is inside and (1,0) on
//   an edge, so the corners (0,0) (2,0) (2,2) (0,2), closed.
// - fromCubic of (0,0) (0,1) (1,1) (1,0) in 2 pieces: at t = 0.5 the weights
//   are 1/8, 3/8, 3/8, 1/8: (0.5, 0.75); 3 points, open.
// - fromQuadratic of (0,0) (1,2) (2,0) in 2 pieces: at t = 0.5, weights 1/4,
//   1/2, 1/4: (1, 1).
// - fromPoints (0,0) (3,0) (3,4): open, length 7; closed, 7 + 5 = 12. The
//   square (0,0) (0,1) (1,1) (1,0) runs clockwise.

mod profiles;

import testing use *;
import collections use *;
import geomath use *;
import sculpt use *;

imm near = 0.00001d;

fn pt(got Vec2, x f32, y f32, label &Array[u8]) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
}

fn regular() {
  imm hex = Profile.polygon(6u32, 1.);
  requireInt(i64.from(hex.pointCount()), 6, "hexagon: 6 corners");
  expect(hex.closed, "hexagon: closed");
  pt(*hex.points[1usize], 0.5, 0.866025, "hexagon: corner 1");
  pt(*hex.points[3usize], -1., 0., "hexagon: corner 3");
  expectFloat(hex.length(), 6., near, "hexagon: length");
  expect(hex.isCounterClockwise(), "hexagon: counterclockwise");

  imm c = Profile.circle(8u32, 2.);
  requireInt(i64.from(c.pointCount()), 8, "circle: 8 points");
  pt(*c.points[2usize], 0., 2., "circle: point 2");
  pt(*c.points[5usize], -1.414214, -1.414214, "circle: point 5");
}

fn rectangles() {
  imm r = Profile.rectangle(4., 2.);
  requireInt(i64.from(r.pointCount()), 4, "rectangle: 4 corners");
  pt(*r.points[0usize], -2., -1., "rectangle: corner 0");
  pt(*r.points[1usize], 2., -1., "rectangle: corner 1");
  pt(*r.points[2usize], 2., 1., "rectangle: corner 2");
  pt(*r.points[3usize], -2., 1., "rectangle: corner 3");
  expectFloat(r.length(), 12., near, "rectangle: length");
  expect(r.isCounterClockwise(), "rectangle: counterclockwise");

  imm rr = Profile.roundedRectangle(4., 2., 0.5, 2u32);
  requireInt(i64.from(rr.pointCount()), 12, "rounded: 12 points");
  pt(*rr.points[0usize], 1.5, -1., "rounded: point 0");
  pt(*rr.points[1usize], 1.853553, -0.853553, "rounded: point 1");
  pt(*rr.points[2usize], 2., -0.5, "rounded: point 2");
  pt(*rr.points[3usize], 2., 0.5, "rounded: point 3");
  pt(*rr.points[4usize], 1.853553, 0.853553, "rounded: point 4");
  pt(*rr.points[5usize], 1.5, 1., "rounded: point 5");
  pt(*rr.points[6usize], -1.5, 1., "rounded: point 6");
  pt(*rr.points[9usize], -2., -0.5, "rounded: point 9");
  pt(*rr.points[10usize], -1.853553, -0.853553, "rounded: point 10");
  pt(*rr.points[11usize], -1.5, -1., "rounded: point 11");
  expectFloat(rr.length(), 11.061467, near, "rounded: length");
  expect(rr.isCounterClockwise(), "rounded: counterclockwise");

  imm full = Profile.roundedRectangle(4., 2., 1., 2u32);
  requireInt(i64.from(full.pointCount()), 10, "full radius: the meeting points kept once");
  pt(*full.points[0usize], 1., -1., "full radius: point 0");
  pt(*full.points[1usize], 1.707107, -0.707107, "full radius: point 1");
  pt(*full.points[2usize], 2., 0., "full radius: point 2");
  pt(*full.points[3usize], 1.707107, 0.707107, "full radius: point 3");
  pt(*full.points[4usize], 1., 1., "full radius: point 4");
  pt(*full.points[5usize], -1., 1., "full radius: point 5");
  pt(*full.points[7usize], -2., 0., "full radius: point 7");
  pt(*full.points[8usize], -1.707107, -0.707107, "full radius: point 8");
  pt(*full.points[9usize], -1., -1., "full radius: point 9");

  imm big = Profile.roundedRectangle(4., 2., 5., 2u32);
  expectInt(i64.from(big.pointCount()), 10, "too large a radius is held to half the height");
  imm none = Profile.roundedRectangle(4., 2., 0., 2u32);
  requireInt(i64.from(none.pointCount()), 4, "no radius: the rectangle");
  pt(*none.points[0usize], -2., -1., "no radius: corner 0");
}

fn others() {
  imm pts Array[Vec2, 6] = [new Vec2(0., 0.), new Vec2(2., 0.), new Vec2(1., 1.), new Vec2(2., 2.), new Vec2(0., 2.), new Vec2(1., 0.)];
  imm h = Profile.hull(&pts);
  requireInt(i64.from(h.pointCount()), 4, "hull: 4 corners");
  expect(h.closed, "hull: closed");
  pt(*h.points[0usize], 0., 0., "hull: corner 0");
  pt(*h.points[1usize], 2., 0., "hull: corner 1");
  pt(*h.points[2usize], 2., 2., "hull: corner 2");
  pt(*h.points[3usize], 0., 2., "hull: corner 3");

  imm cb = Profile.fromCubic(new CubicBezier2(new Vec2(0., 0.), new Vec2(0., 1.), new Vec2(1., 1.), new Vec2(1., 0.)), 2u32);
  requireInt(i64.from(cb.pointCount()), 3, "cubic: 3 points");
  expect(!cb.closed, "cubic: open");
  pt(*cb.points[1usize], 0.5, 0.75, "cubic: middle");
  pt(*cb.points[2usize], 1., 0., "cubic: end");

  imm qb = Profile.fromQuadratic(new QuadraticBezier2(new Vec2(0., 0.), new Vec2(1., 2.), new Vec2(2., 0.)), 2u32);
  requireInt(i64.from(qb.pointCount()), 3, "quadratic: 3 points");
  pt(*qb.points[1usize], 1., 1., "quadratic: middle");

  imm tri Array[Vec2, 3] = [new Vec2(0., 0.), new Vec2(3., 0.), new Vec2(3., 4.)];
  imm open = Profile.fromPoints(&tri, false);
  expectFloat(open.length(), 7., near, "open: length");
  imm shut = Profile.fromPoints(&tri, true);
  expectFloat(shut.length(), 12., near, "closed: length with its closing edge");
  imm sq Array[Vec2, 4] = [new Vec2(0., 0.), new Vec2(0., 1.), new Vec2(1., 1.), new Vec2(1., 0.)];
  imm cw = Profile.fromPoints(&sq, true);
  expect(!cw.isCounterClockwise(), "a clockwise square");
}

fn main() i32 {
  regular();
  rectangles();
  others();
  done();
}
