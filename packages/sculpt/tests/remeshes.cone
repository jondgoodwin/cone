// The sculpt package's voxel remesh, checked with the testing package; only a
// failure prints, so remeshes.out holds the summary alone. Every result is
// checked valid, closed (no edge with a face on one side only) and all quads,
// its volume by the divergence theorem (f64), its topology by the Euler
// characteristic V - E + F (2 for each sphere-like piece, 0 for a torus), and
// its bits by meshHash of its flat triangulation, pinned.
//
// - The cube: the cube cage of size 0.5 (a unit cube about the origin) at
//   voxel 0.1: every vertex within a cell of the cube's box, the volume a
//   little under 1 (surface nets rounds the edges and corners: 0.97 to 1), the
//   Euler characteristic 2; with preserveVolume every vertex is on the cube's
//   surface (some coordinate is +-0.5 within 1e-6) and the volume is within
//   2 % of 1 and more than without (the faces across an edge still cut it:
//   0.972 becomes 0.982, measured). Remeshed twice: the same bits.
// - The sphere-ish: the cube subdivided three times by Catmull-Clark (384
//   quads), its volume measured, remeshed at 0.04: volume within 3 % of the
//   input's, every vertex within a cell of the input's surface's radius
//   range, characteristic 2.
// - The torus: a lathed circle (major 1, minor 0.35, 16 x 24), remeshed at
//   0.05: characteristic 0, volume within 3 % of the input's.
// - Overlapping cubes, joined (not a boolean): two unit cubes 0.5 apart along
//   x, one mesh of two closed parts that overlap. Remeshed at 0.1 they fuse:
//   characteristic 2, volume within 3 % of the union's, 1.5.
// - A cavity: a cube of size 2 with an inward-facing unit cube inside it
//   (one mesh, two shells). Remeshed at 0.1: two pieces (characteristic 4),
//   volume within 3 % of 8 - 1.
// - Inside out: the unit cube with every face reversed still remeshes to the
//   same solid, facing outward (positive volume), the same bits as the cube.
// - Refused and reported: an open box (the cube without its top) gives an
//   empty mesh and one line saying it is not closed; a voxel size of 0 and
//   of -1 give an empty mesh and a line each.
// - Channels: the unit cube with a vertex "h" = the vertex's y, a vertex
//   "weight" (fill 1) of 0.5 everywhere, a face "id" = the face's number, an
//   edge "crease" 2 on every edge and a corner "uv" = (x, z) of its vertex.
//   Remeshed with preserveVolume at 0.1: h at every vertex is its y (h is
//   linear, so the blend across the nearest triangle is exact; within 1e-5),
//   weight 0.5 everywhere, id at every face the input face its centroid is
//   on (the face whose plane the centroid is nearest), crease 0 (its fill)
//   on every edge, every corner's uv (x, z) of its vertex within 1e-5; each
//   channel keeps its name, domain and fill. Without keepChannels: no
//   channels.

mod remeshes;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;

// The pinned hashes: cube, cube preserving volume, sphere-ish, torus, the
// joined cubes, the cavity
imm PINNED Array[u32, 6] = [701908982u32, 664419296u32, 1369902403u32, 2117358728u32, 3105719282u32, 1117279319u32];

fn hashOf(m &PolyMesh) u32 {
  imm t = m.triangulate(false);
  meshHash(&t);
}

// Valid, closed and every face a quad
fn quadSolid(m &PolyMesh, label &Array[u8]) {
  imm problems = m.validate();
  expectInt(i64.from(problems.len()), 0, label);
  mut open = 0i64;
  mut h = 0usize;
  while h < m.hFace.len() {
    if *m.hFace[h] == NoIndex { open = open + 1; }
    h = h + 1usize;
  }
  expectInt(open, 0, label);
  mut notQuad = 0i64;
  mut f = 0usize;
  while f < m.faceCount() {
    if m.faceDegree(u32.from(f)) != 4usize { notQuad = notQuad + 1; }
    f = f + 1usize;
  }
  expectInt(notQuad, 0, label);
  expect(m.faceCount() > 0usize, label);
}

fn euler(m &PolyMesh) i64 {
  i64.from(m.vertexCount()) - i64.from(m.edgeCount()) + i64.from(m.faceCount());
}

// The signed volume, by the divergence theorem over each face's fan, in f64
fn volume(m &PolyMesh) f64 {
  mut sum = 0.d;
  mut f = 0usize;
  while f < m.faceCount() {
    imm pts = m.facePositions(u32.from(f));
    mut i = 1usize;
    while i + 1usize < pts.len() {
      imm a = DVec3.from(*pts[0usize]);
      imm b = DVec3.from(*pts[i]);
      imm c = DVec3.from(*pts[i + 1usize]);
      sum = sum + a.x * (b.y * c.z - b.z * c.y) + a.y * (b.z * c.x - b.x * c.z) + a.z * (b.x * c.y - b.y * c.x);
      i = i + 1usize;
    }
    f = f + 1usize;
  }
  sum / 6.d;
}

fn absd(a f64) f64 { if a < 0.d { -a; } else { a; }; }
fn absf(a f32) f32 { if a < 0. { -a; } else { a; }; }

// A box from lo to hi by fromPolygons, its faces outward, or inward
fn boxFaces(lo Vec3, hi Vec3, inward bool) PolyMesh {
  mut pts = List[Vec3].empty();
  mut k = 0u32;
  while k < 8u32 {
    pts.push(new Vec3(if (k & 1u32) != 0u32 { hi.x; } else { lo.x; }, if (k & 2u32) != 0u32 { hi.y; } else { lo.y; },
      if (k & 4u32) != 0u32 { hi.z; } else { lo.z; }));
    k = k + 1u32;
  }
  // Outward quads: -x, +x, -y, +y, -z, +z
  imm quads Array[u32, 24] = [0u32, 4u32, 6u32, 2u32, 1u32, 3u32, 7u32, 5u32, 0u32, 1u32, 5u32, 4u32,
    2u32, 6u32, 7u32, 3u32, 0u32, 2u32, 3u32, 1u32, 4u32, 5u32, 7u32, 6u32];
  mut idx = List[u32].empty();
  mut counts = List[u32].empty();
  mut f = 0usize;
  while f < 6usize {
    counts.push(4u32);
    mut c = 0usize;
    while c < 4usize {
      imm j = if inward { 3usize - c; } else { c; };
      idx.push(quads[f * 4usize + j]);
      c = c + 1usize;
    }
    f = f + 1usize;
  }
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut problems);
}

fn torus(major f32, minor f32, around u32, steps u32) PolyMesh {
  mut pts = List[Vec2].empty();
  mut i = 0u32;
  while i < around {
    imm a = 2. * pi * f32.from(i) / f32.from(around);
    pts.push(new Vec2(major + minor * cos(a), minor * sin(a)));
    i = i + 1u32;
  }
  imm prof = Profile.fromPoints(pts.view(), true);
  lathe(&prof, new Vec3(0., 1., 0.), 2. * pi, steps);
}

fn cube() {
  imm c = PolyMesh.cube(0.5);
  mut problems = List[String].empty();
  imm r = voxelRemesh(&c, 0.1, &mut problems);
  expectInt(i64.from(problems.len()), 0, "cube reports nothing");
  quadSolid(&r, "cube is a closed quad mesh");
  expectInt(euler(&r), 2, "cube's characteristic");
  imm vol = volume(&r);
  expect(vol > 0.97d and vol < 1.d, "cube's volume a little under 1");
  imm b = r.bounds();
  expect(b.min.x > -0.6 and b.max.x < 0.6 and b.min.y > -0.6 and b.max.y < 0.6 and b.min.z > -0.6 and b.max.z < 0.6,
    "cube within a cell of its box");
  expectUInt(u64.from(hashOf(&r)), u64.from(PINNED[0usize]), "cube's hash");
  imm again = voxelRemesh(&c, 0.1, &mut problems);
  expectUInt(u64.from(hashOf(&again)), u64.from(hashOf(&r)), "cube twice, the same bits");

  imm p = voxelRemeshWith(&c, 0.1, true, true, &mut problems);
  expectInt(i64.from(problems.len()), 0, "cube preserving volume reports nothing");
  quadSolid(&p, "cube preserving volume is a closed quad mesh");
  mut off = 0i64;
  mut v = 0usize;
  while v < p.vertexCount() {
    imm q = *p.positions[v];
    imm m = absf(absf(q.x) - 0.5) < 0.000001 or absf(absf(q.y) - 0.5) < 0.000001 or absf(absf(q.z) - 0.5) < 0.000001;
    imm inside = absf(q.x) <= 0.500001 and absf(q.y) <= 0.500001 and absf(q.z) <= 0.500001;
    if !(m and inside) { off = off + 1; }
    v = v + 1usize;
  }
  expectInt(off, 0, "cube preserving volume: every vertex on the cube");
  expectFloat(volume(&p), 1.d, 0.02d, "cube preserving volume within 2 % of 1");
  expect(volume(&p) > vol, "cube preserving volume keeps more than without");
  expectUInt(u64.from(hashOf(&p)), u64.from(PINNED[1usize]), "cube preserving volume's hash");
}

fn sphereish() {
  imm c = PolyMesh.cube(0.5);
  imm s = subdivide(&c, 3u32);
  mut problems = List[String].empty();
  imm r = voxelRemesh(&s, 0.04, &mut problems);
  expectInt(i64.from(problems.len()), 0, "sphere-ish reports nothing");
  quadSolid(&r, "sphere-ish is a closed quad mesh");
  expectInt(euler(&r), 2, "sphere-ish characteristic");
  imm vin = volume(&s);
  expectFloat(volume(&r), vin, 0.03d * vin, "sphere-ish keeps its volume");
  mut rmin f32 = 100.;
  mut rmax f32 = 0.;
  mut v = 0usize;
  while v < s.vertexCount() {
    imm len = s.positions[v].length();
    if len < rmin { rmin = len; }
    if len > rmax { rmax = len; }
    v = v + 1usize;
  }
  mut out = 0i64;
  v = 0usize;
  while v < r.vertexCount() {
    imm len = r.positions[v].length();
    if len < rmin - 0.04 or len > rmax + 0.04 { out = out + 1; }
    v = v + 1usize;
  }
  expectInt(out, 0, "sphere-ish within a cell of the input's radii");
  expectUInt(u64.from(hashOf(&r)), u64.from(PINNED[2usize]), "sphere-ish hash");
}

fn tori() {
  imm t = torus(1., 0.35, 16u32, 24u32);
  mut problems = List[String].empty();
  imm r = voxelRemesh(&t, 0.05, &mut problems);
  expectInt(i64.from(problems.len()), 0, "torus reports nothing");
  quadSolid(&r, "torus is a closed quad mesh");
  expectInt(euler(&r), 0, "torus characteristic");
  imm vin = volume(&t);
  expectFloat(volume(&r), vin, 0.03d * vin, "torus keeps its volume");
  expectUInt(u64.from(hashOf(&r)), u64.from(PINNED[3usize]), "torus hash");
}

fn overlapping() {
  mut parts = List[PolyMesh].empty();
  parts.push(boxFaces(new Vec3(-0.5, -0.5, -0.5), new Vec3(0.5, 0.5, 0.5), false));
  parts.push(boxFaces(new Vec3(0., -0.5, -0.5), new Vec3(1., 0.5, 0.5), false));
  mut problems = List[String].empty();
  imm j = join(&parts, &mut problems);
  imm r = voxelRemesh(&j, 0.1, &mut problems);
  expectInt(i64.from(problems.len()), 0, "joined cubes report nothing");
  quadSolid(&r, "joined cubes fuse to a closed quad mesh");
  expectInt(euler(&r), 2, "joined cubes are one piece");
  expectFloat(volume(&r), 1.5d, 0.045d, "joined cubes' volume is the union's");
  expectUInt(u64.from(hashOf(&r)), u64.from(PINNED[4usize]), "joined cubes' hash");
}

fn cavity() {
  mut parts = List[PolyMesh].empty();
  parts.push(boxFaces(new Vec3(-1., -1., -1.), new Vec3(1., 1., 1.), false));
  parts.push(boxFaces(new Vec3(-0.5, -0.5, -0.5), new Vec3(0.5, 0.5, 0.5), true));
  mut problems = List[String].empty();
  imm j = join(&parts, &mut problems);
  imm r = voxelRemesh(&j, 0.1, &mut problems);
  expectInt(i64.from(problems.len()), 0, "cavity reports nothing");
  quadSolid(&r, "cavity is a closed quad mesh");
  expectInt(euler(&r), 4, "cavity is two shells");
  expectFloat(volume(&r), 7.d, 0.21d, "cavity's volume");
  expectUInt(u64.from(hashOf(&r)), u64.from(PINNED[5usize]), "cavity's hash");
}

fn insideOut() {
  imm out = boxFaces(new Vec3(-0.5, -0.5, -0.5), new Vec3(0.5, 0.5, 0.5), false);
  imm inv = boxFaces(new Vec3(-0.5, -0.5, -0.5), new Vec3(0.5, 0.5, 0.5), true);
  mut problems = List[String].empty();
  imm a = voxelRemesh(&out, 0.1, &mut problems);
  imm b = voxelRemesh(&inv, 0.1, &mut problems);
  expectInt(i64.from(problems.len()), 0, "inside out reports nothing");
  expect(volume(&b) > 0.97d, "inside out remeshes facing outward");
  expectUInt(u64.from(hashOf(&b)), u64.from(hashOf(&a)), "inside out, the same bits");
  expectUInt(u64.from(hashOf(&a)), u64.from(PINNED[0usize]), "the box by fromPolygons is the cube cage's bits");
}

fn refused() {
  // The cube without its top
  mut pts = List[Vec3].empty();
  mut k = 0u32;
  while k < 8u32 {
    pts.push(new Vec3(if (k & 1u32) != 0u32 { 0.5; } else { -0.5; }, if (k & 2u32) != 0u32 { 0.5; } else { -0.5; },
      if (k & 4u32) != 0u32 { 0.5; } else { -0.5; }));
    k = k + 1u32;
  }
  imm quads Array[u32, 20] = [0u32, 4u32, 6u32, 2u32, 1u32, 3u32, 7u32, 5u32, 0u32, 1u32, 5u32, 4u32,
    0u32, 2u32, 3u32, 1u32, 4u32, 5u32, 7u32, 6u32];
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut i = 0usize;
  while i < 20usize {
    if i % 4usize == 0usize { counts.push(4u32); }
    idx.push(quads[i]);
    i = i + 1usize;
  }
  mut pp = List[String].empty();
  imm open = PolyMesh.fromPolygons(pts.view(), counts.view(), idx.view(), &mut pp);
  mut problems = List[String].empty();
  imm r = voxelRemesh(&open, 0.1, &mut problems);
  expectInt(i64.from(r.faceCount()), 0, "an open box gives nothing");
  expectInt(i64.from(problems.len()), 1, "an open box is reported");
  if problems.len() == 1usize {
    expectStr(problems[0usize].view(), "the mesh is not closed: 4 edges have a face on one side only", "why the open box");
  }
  imm c = PolyMesh.cube(0.5);
  mut p2 = List[String].empty();
  imm z = voxelRemesh(&c, 0., &mut p2);
  imm n = voxelRemesh(&c, -1., &mut p2);
  expectInt(i64.from(z.faceCount() + n.faceCount()), 0, "a voxel size not positive gives nothing");
  expectInt(i64.from(p2.len()), 2, "a voxel size not positive is reported");
}

fn channels() {
  mut c = PolyMesh.cube(0.5);
  imm h = c.addFloatChannel(VertexDomain, "h", 0.);
  imm w = c.addFloatChannel(VertexDomain, "weight", 1.);
  imm id = c.addFloatChannel(FaceDomain, "id", 0.);
  imm cr = c.addFloatChannel(EdgeDomain, "crease", 0.);
  imm uv = c.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  mut v = 0usize;
  while v < c.vertexCount() {
    c.setFloat(h, u32.from(v), c.positions[v].y);
    c.setFloat(w, u32.from(v), 0.5);
    v = v + 1usize;
  }
  mut f = 0usize;
  while f < c.faceCount() { c.setFloat(id, u32.from(f), f32.from(f)); f = f + 1usize; }
  mut e = 0usize;
  while e < c.edgeCount() { c.setFloat(cr, u32.from(e), 2.); e = e + 1usize; }
  mut hh = 0usize;
  while hh < c.halfedgeCount() {
    imm p = *c.positions[usize.from(c.toVertex(u32.from(hh)))];
    c.setVec2(uv, u32.from(hh), new Vec2(p.x, p.z));
    hh = hh + 1usize;
  }
  mut problems = List[String].empty();
  imm r = voxelRemeshWith(&c, 0.1, true, true, &mut problems);
  expectInt(i64.from(problems.len()), 0, "channels report nothing");
  imm rh = r.findFloatChannel(VertexDomain, "h");
  imm rw = r.findFloatChannel(VertexDomain, "weight");
  imm rid = r.findFloatChannel(FaceDomain, "id");
  imm rcr = r.findFloatChannel(EdgeDomain, "crease");
  imm ruv = r.findVec2Channel(CornerDomain, "uv");
  require(rh != NoIndex and rw != NoIndex and rid != NoIndex and rcr != NoIndex and ruv != NoIndex, "every channel carried");
  expectInt(i64.from(r.floats.len()), 4, "four f32 channels");
  expectInt(i64.from(r.vec2s.len()), 1, "one Vec2 channel");
  expectFloat(f64.from(r.floats[usize.from(rw)].fill), 1.d, 0.d, "weight keeps its fill");
  mut badH = 0i64;
  mut badW = 0i64;
  v = 0usize;
  while v < r.vertexCount() {
    if absf(r.float(rh, u32.from(v)) - r.positions[v].y) > 0.00001 { badH = badH + 1; }
    if r.float(rw, u32.from(v)) != 0.5 { badW = badW + 1; }
    v = v + 1usize;
  }
  expectInt(badH, 0, "h is each vertex's y");
  expectInt(badW, 0, "weight is 0.5 everywhere");
  // The input face whose plane a centroid is nearest: the cube's faces are
  // -x? The cage's face numbers are found by their normals
  mut badId = 0i64;
  f = 0usize;
  while f < r.faceCount() {
    imm q = r.faceCentroid(u32.from(f));
    // the nearest face of the cube: the axis and side the centroid is nearest
    mut best = 0usize;
    mut bestD f32 = 100.;
    mut g = 0usize;
    while g < c.faceCount() {
      imm n = c.faceNormal(u32.from(g));
      imm cc = c.faceCentroid(u32.from(g));
      imm d = absf((q - cc).dot(n));
      // only faces whose square the centroid lies over count
      imm t = q - n * (q - cc).dot(n);
      imm over = absf(t.x) <= 0.5001 and absf(t.y) <= 0.5001 and absf(t.z) <= 0.5001;
      if over and d < bestD { bestD = d; best = g; }
      g = g + 1usize;
    }
    if r.float(rid, u32.from(f)) != f32.from(best) { badId = badId + 1; }
    f = f + 1usize;
  }
  expectInt(badId, 0, "id is the face each centroid is nearest");
  mut badCr = 0i64;
  e = 0usize;
  while e < r.edgeCount() {
    if r.float(rcr, u32.from(e)) != 0. { badCr = badCr + 1; }
    e = e + 1usize;
  }
  expectInt(badCr, 0, "crease is its fill on every new edge");
  mut badUv = 0i64;
  hh = 0usize;
  while hh < r.halfedgeCount() {
    imm p = *r.positions[usize.from(r.toVertex(u32.from(hh)))];
    imm got = r.vec2(ruv, u32.from(hh));
    if absf(got.x - p.x) > 0.00001 or absf(got.y - p.z) > 0.00001 { badUv = badUv + 1; }
    hh = hh + 1usize;
  }
  expectInt(badUv, 0, "uv is (x, z) at every corner");
  imm bare = voxelRemeshWith(&c, 0.1, false, false, &mut problems);
  expectInt(i64.from(bare.floats.len() + bare.vec2s.len() + bare.vec3s.len()), 0, "without keepChannels, none");
}

fn main() i32 {
  cube();
  sphereish();
  tori();
  overlapping();
  cavity();
  insideOut();
  refused();
  channels();
  done();
}
