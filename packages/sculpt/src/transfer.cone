// ======== Data transfer: channels carried from one surface to another ========
//
// Blender's Data Transfer modifier. The channels of a source mesh ('src') are
// copied to a destination mesh ('dst', which keeps its own shape and every
// channel it has): each destination element looks up where it lands on the
// source, and takes the source's values there. A source channel keeps its name,
// domain and fill; a destination channel of the same name and domain is
// written over (or mixed with by 'factor'), and a name that is another type in
// the destination is reported and left. All four domains: a vertex channel
// goes to the destination's vertices, an edge channel to its edges, a face
// channel to its faces, a corner channel to its corners, each by the mapping
// chosen for that domain:
//
// - MapNearest: the source element of the same kind nearest. A vertex takes
//   the nearest source vertex; an edge the nearest edge of the face the
//   nearest surface point is on; a face that face; a corner the corner of
//   that face whose vertex is nearest (Blender's Only Neighbor, Nearest Edge
//   Best Matching, Nearest Face, Nearest Corner).
// - MapInterpolated: a vertex or corner value blended across the triangle the
//   nearest surface point is on, by the point's barycentric weights (Blender's
//   Nearest Face Interpolated). A face value cannot be blended, and an edge's
//   two ends are not a place the nearest point reaches, so those two take the
//   nearest face and nearest edge as MapNearest does.
// - MapProjected: as MapInterpolated, but the point is where a ray from the
//   destination element along its normal (the vertex normal; a face's normal;
//   an edge's the mean of its ends'; a corner's its vertex's), forwards or
//   backwards, whichever meets the source first, meets it (Blender's
//   Projected Face Interpolated); where the ray misses, the nearest surface
//   point serves.
// - MapBestNormal: among the source triangles near the point (within twice the
//   nearest distance), the one whose normal agrees best with the destination
//   element's, then as MapInterpolated (Blender's Best Matching Face Normal).
// Where the element is: a vertex or corner at its vertex, an edge at its
// middle, a face at its centroid. 'maxDistance' (0 or less: none) leaves an
// element farther from the source than that as it was (or at the channel's
// fill, where the destination had no such channel).
//
// 'factor' mixes: the new value is the destination's old one plus factor times
// the difference, the old one being the channel's fill where there is none; 1,
// the default, replaces.
//
// THE CORE, shared with voxel remesh: a 'Sample' is where a destination
// element lands, up to three source elements and the weights that blend them
// (all of a direct pick's weight on one); 'carryChannels' writes every source
// channel along a list of samples per domain. Voxel remesh, which carries the
// nearest point's values to its new elements, builds its samples from the
// nearest triangle and calls the same function.

pub const MapNearest = 0u32;
pub const MapInterpolated = 1u32;
pub const MapProjected = 2u32;
pub const MapBestNormal = 3u32;

// The mappings per domain, the reach and the mix
pub struct TransferMap {
  pub vertex u32;
  pub edge u32;
  pub face u32;
  pub corner u32;
  pub maxDistance f32;
  pub factor f32;

  // One mapping for every domain, no reach limit, replacing
  pub fn all(method u32) TransferMap { new TransferMap(method, method, method, method, 0., 1.) }
}

// Where a destination element lands: source elements e0, e1, e2 blended by w
// (NoIndex in e0: nowhere)
struct Sample {
  e0 u32;
  e1 u32;
  e2 u32;
  w DVec3;
}

fn sampleNone() Sample { new Sample(NoIndex, NoIndex, NoIndex, new DVec3(0.d, 0.d, 0.d)) }
fn sampleOne(e u32) Sample { new Sample(e, e, e, new DVec3(1.d, 0.d, 0.d)) }

// A hit's triangle's three vertices (or corners) with the hit's weights
fn triSample(idx &SurfaceIndex, h SurfaceHit, domain u32) Sample {
  if h.tri == NoIndex { return sampleNone(); }
  let k = 3usize * usize.from(h.tri);
  let w = h.bary;
  if domain == CornerDomain { new Sample(*idx.tc[k], *idx.tc[k + 1usize], *idx.tc[k + 2usize], w) }
  else { new Sample(*idx.tv[k], *idx.tv[k + 1usize], *idx.tv[k + 2usize], w) }
}

// A sample's blend of three values, in f64 and rounded once, so three equal
// values give that value exactly
fn blendF(vals &List[f32], s &Sample) f32 {
  blend3(*vals[usize.from(s.e0)], *vals[usize.from(s.e1)], *vals[usize.from(s.e2)], s.w)
}
fn blendV2(vals &List[Vec2], s &Sample) Vec2 {
  let a = *vals[usize.from(s.e0)];
  let b = *vals[usize.from(s.e1)];
  let c = *vals[usize.from(s.e2)];
  new Vec2(blend3(a.x, b.x, c.x, s.w), blend3(a.y, b.y, c.y, s.w))
}
fn blendV3(vals &List[Vec3], s &Sample) Vec3 {
  let a = *vals[usize.from(s.e0)];
  let b = *vals[usize.from(s.e1)];
  let c = *vals[usize.from(s.e2)];
  new Vec3(blend3(a.x, b.x, c.x, s.w), blend3(a.y, b.y, c.y, s.w), blend3(a.z, b.z, c.z, s.w))
}

fn mixF(old f32, now f32, factor f32) f32 { if factor >= 1. { now } else { old + (now - old) * factor } }

// Whether a channel is wanted: no filter, or its name among 'names'
fn nameWanted(name &String, filter bool, names &Array[&str]) bool {
  if !filter { return true; }
  var i = 0usize;
  while i < names.len {
    if name.equals(names[i]) { return true; }
    i = i + 1usize;
  }
  false
}

// Source m's channels written to 'dst' along 'samples' (per domain, a Sample
// for each destination element; an empty list for a domain not needed).
// Channels wanted: all, or with 'filter' those named in 'names'. A destination
// channel of that name and domain is mixed into by 'factor'; another type of
// the same name is reported, not touched.
fn carryChannels(m &PolyMesh, dst &mut PolyMesh, samples &List[List[Sample]], filter bool, names &Array[&str],
    factor f32, problems &mut List[String]) {
  var i = 0usize;
  while i < m.floats.len() {
    let domain = m.floats[i].domain;
    if nameWanted(&m.floats[i].name, filter, names) and samples[usize.from(domain)].len() == dst.domainSize(domain) {
      let n = dst.domainSize(domain);
      let fill = m.floats[i].fill;
      let have = dst.findFloatChannel(domain, m.floats[i].name.view());
      if conflicting(dst, domain, &m.floats[i].name, 0u32) {
        reportConflict(&m.floats[i].name, problems);
      } else {
        var vals = List[f32].withCapacity(n);
        var e = 0usize;
        while e < n {
          let s = samples[usize.from(domain)][e];
          let old = if have != NoIndex { dst.float(have, u32.from(e)) } else { fill };
          if s.e0 == NoIndex { vals.push(old); }
          else { vals.push(mixF(old, blendF(&m.floats[i].values, s), factor)); }
          e = e + 1usize;
        }
        if have != NoIndex {
          e = 0usize;
          while e < n { dst.setFloat(have, u32.from(e), *vals[e]); e = e + 1usize; }
        } else {
          dst.floats.push(new Channel[f32](String.from(m.floats[i].name.view()), domain, vals, fill));
        }
      }
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.vec2s.len() {
    let domain = m.vec2s[i].domain;
    if nameWanted(&m.vec2s[i].name, filter, names) and samples[usize.from(domain)].len() == dst.domainSize(domain) {
      let n = dst.domainSize(domain);
      let fill = m.vec2s[i].fill;
      let have = dst.findVec2Channel(domain, m.vec2s[i].name.view());
      if conflicting(dst, domain, &m.vec2s[i].name, 1u32) {
        reportConflict(&m.vec2s[i].name, problems);
      } else {
        var vals = List[Vec2].withCapacity(n);
        var e = 0usize;
        while e < n {
          let s = samples[usize.from(domain)][e];
          let old = if have != NoIndex { dst.vec2(have, u32.from(e)) } else { fill };
          if s.e0 == NoIndex { vals.push(old); }
          else {
            let now = blendV2(&m.vec2s[i].values, s);
            vals.push(new Vec2(mixF(old.x, now.x, factor), mixF(old.y, now.y, factor)));
          }
          e = e + 1usize;
        }
        if have != NoIndex {
          e = 0usize;
          while e < n { dst.setVec2(have, u32.from(e), *vals[e]); e = e + 1usize; }
        } else {
          dst.vec2s.push(new Channel[Vec2](String.from(m.vec2s[i].name.view()), domain, vals, fill));
        }
      }
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.vec3s.len() {
    let domain = m.vec3s[i].domain;
    if nameWanted(&m.vec3s[i].name, filter, names) and samples[usize.from(domain)].len() == dst.domainSize(domain) {
      let n = dst.domainSize(domain);
      let fill = m.vec3s[i].fill;
      let have = dst.findVec3Channel(domain, m.vec3s[i].name.view());
      if conflicting(dst, domain, &m.vec3s[i].name, 2u32) {
        reportConflict(&m.vec3s[i].name, problems);
      } else {
        var vals = List[Vec3].withCapacity(n);
        var e = 0usize;
        while e < n {
          let s = samples[usize.from(domain)][e];
          let old = if have != NoIndex { dst.vec3(have, u32.from(e)) } else { fill };
          if s.e0 == NoIndex { vals.push(old); }
          else {
            let now = blendV3(&m.vec3s[i].values, s);
            vals.push(new Vec3(mixF(old.x, now.x, factor), mixF(old.y, now.y, factor), mixF(old.z, now.z, factor)));
          }
          e = e + 1usize;
        }
        if have != NoIndex {
          e = 0usize;
          while e < n { dst.setVec3(have, u32.from(e), *vals[e]); e = e + 1usize; }
        } else {
          dst.vec3s.push(new Channel[Vec3](String.from(m.vec3s[i].name.view()), domain, vals, fill));
        }
      }
    }
    i = i + 1usize;
  }
}

// Whether dst has a channel of this name and domain of another type than
// kind (0 f32, 1 Vec2, 2 Vec3)
fn conflicting(dst &PolyMesh, domain u32, name &String, kind u32) bool {
  if kind != 0u32 and dst.findFloatChannel(domain, name.view()) != NoIndex { return true; }
  if kind != 1u32 and dst.findVec2Channel(domain, name.view()) != NoIndex { return true; }
  if kind != 2u32 and dst.findVec3Channel(domain, name.view()) != NoIndex { return true; }
  false
}

fn reportConflict(name &String, problems &mut List[String]) {
  var s = String.from("the channel '");
  s.append(name.view());
  s.append("' is another type in the destination; left as it was");
  problems.push(s);
}

// ---- Data Transfer ----

// The destination mesh with every channel of the source carried to it (see
// the top)
pub fn dataTransfer(dst &PolyMesh, src &PolyMesh, map &TransferMap, problems &mut List[String]) PolyMesh {
  let none Array[&str, 1] = [""];
  dataTransferWith(dst, src, map, false, &none, problems)
}

// The same for the named channels only
pub fn dataTransferOnly(dst &PolyMesh, src &PolyMesh, map &TransferMap, names &Array[&str], problems &mut List[String]) PolyMesh {
  dataTransferWith(dst, src, map, true, names, problems)
}

fn dataTransferWith(dst &PolyMesh, src &PolyMesh, map &TransferMap, filter bool, names &Array[&str],
    problems &mut List[String]) PolyMesh {
  let idx = SurfaceIndex.of(src);
  dataTransferIndexed(dst, src, &idx, map, filter, names, problems)
}

// The same with the source's index already made
fn dataTransferIndexed(dst &PolyMesh, src &PolyMesh, idx &SurfaceIndex, map &TransferMap, filter bool,
    names &Array[&str], problems &mut List[String]) PolyMesh {
  var out = withPositions(dst, copyList(&dst.positions));
  if src.faceCount() == 0usize or dst.vertexCount() == 0usize { return out; }
  // Which domains the wanted channels live in
  var need Array[bool, 4] = [false, false, false, false];
  markDomains(src, filter, names, &mut need);
  var samples = List[List[Sample]].empty();
  var d = 0u32;
  while d < 4u32 {
    if need[usize.from(d)] {
      let method = if d == VertexDomain { map.vertex } elif d == EdgeDomain { map.edge }
        elif d == FaceDomain { map.face } else { map.corner };
      samples.push(samplesFor(src, idx, dst, d, method, map.maxDistance));
    } else {
      samples.push(List[Sample].empty());
    }
    d = d + 1u32;
  }
  carryChannels(src, &mut out, &samples, filter, names, map.factor, problems);
  out
}

fn markDomains(m &PolyMesh, filter bool, names &Array[&str], need &mut Array[bool, 4]) {
  var i = 0usize;
  while i < m.floats.len() {
    if nameWanted(&m.floats[i].name, filter, names) { need[usize.from(m.floats[i].domain)] = true; }
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.vec2s.len() {
    if nameWanted(&m.vec2s[i].name, filter, names) { need[usize.from(m.vec2s[i].domain)] = true; }
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.vec3s.len() {
    if nameWanted(&m.vec3s[i].name, filter, names) { need[usize.from(m.vec3s[i].domain)] = true; }
    i = i + 1usize;
  }
}

// Each element of the destination's domain, where it lands on the source
fn samplesFor(src &PolyMesh, idx &SurfaceIndex, dst &PolyMesh, domain u32, method u32, maxDistance f32) List[Sample] {
  let n = dst.domainSize(domain);
  let vnormals = dst.vertexNormals();
  var out = List[Sample].withCapacity(n);
  var stack = List[u32].empty();
  var cache = List[SurfaceHit].empty();
  var have = List[bool].empty();
  if domain == CornerDomain {
    var c = 0usize;
    while c < dst.vertexCount() { cache.push(SurfaceHit.none()); have.push(false); c = c + 1usize; }
  }
  var e = 0usize;
  while e < n {
    let eu = u32.from(e);
    // The element's place and normal; a boundary corner has neither
    var p = new Vec3(0., 0., 0.);
    var nrm = new Vec3(0., 0., 0.);
    var valid = true;
    if domain == VertexDomain {
      p = *dst.positions[e];
      nrm = *vnormals[e];
    } elif domain == EdgeDomain {
      let a = *dst.positions[usize.from(dst.fromVertex(2u32 * eu))];
      let b = *dst.positions[usize.from(dst.toVertex(2u32 * eu))];
      p = (a + b) * 0.5;
      nrm = unit(*vnormals[usize.from(dst.fromVertex(2u32 * eu))] + *vnormals[usize.from(dst.toVertex(2u32 * eu))]);
    } elif domain == FaceDomain {
      p = dst.faceCentroid(eu);
      nrm = dst.faceNormal(eu);
    } else {
      if *dst.hFace[e] == NoIndex { valid = false; }
      else {
        p = *dst.positions[usize.from(*dst.hVertex[e])];
        nrm = *vnormals[usize.from(*dst.hVertex[e])];
      }
    }
    if !valid { out.push(sampleNone()); e = e + 1usize; continue; }

    // Where it lands
    var hit = SurfaceHit.none();
    // A corner is at its vertex with its vertex's normal, so the corners of
    // a vertex share one search
    let cv = if domain == CornerDomain { usize.from(*dst.hVertex[e]) } else { 0usize };
    if domain == CornerDomain and *have[cv] {
      hit = *cache[cv];
    } else {
      if method == MapProjected {
        hit = idx.rayBothWays(p, nrm, maxDistance, CullNone, &mut stack);
        if hit.tri == NoIndex { hit = idx.nearestWith(p, maxDistance, &mut stack); }
      } elif method == MapBestNormal {
        hit = idx.bestNormal(p, nrm, maxDistance);
      } elif method == MapNearest and domain == VertexDomain {
        hit = idx.nearestVertexWith(p, maxDistance, &mut stack);
      } else {
        hit = idx.nearestWith(p, maxDistance, &mut stack);
      }
      if domain == CornerDomain { cache.set(cv, hit); have.set(cv, true); }
    }
    if hit.tri == NoIndex { out.push(sampleNone()); }
    elif domain == FaceDomain { out.push(sampleOne(hit.face)); }
    elif domain == EdgeDomain { out.push(sampleOne(nearestEdge(src, hit.face, hit.point))); }
    elif domain == VertexDomain {
      if method == MapNearest {
        // The hit is the vertex's weight 1 corner
        out.push(oneCorner(idx, &hit, domain));
      } else { out.push(triSample(idx, hit, domain)); }
    } else {
      if method == MapNearest { out.push(sampleOne(nearestCorner(src, hit.face, hit.point))); }
      else { out.push(triSample(idx, hit, domain)); }
    }
    e = e + 1usize;
  }
  out
}

// The vertex (or corner) of a hit whose weight is the greatest
fn oneCorner(idx &SurfaceIndex, h &SurfaceHit, domain u32) Sample {
  let k = 3usize * usize.from(h.tri);
  let w = h.bary;
  var c = 0usize;
  if w.y > w.x and w.y >= w.z { c = 1usize; }
  elif w.z > w.x and w.z > w.y { c = 2usize; }
  if domain == CornerDomain { sampleOne(*idx.tc[k + c]) } else { sampleOne(*idx.tv[k + c]) }
}

// The edge of a face nearest a point
fn nearestEdge(m &PolyMesh, face u32, p Vec3) u32 {
  let hs = m.faceHalfedges(face);
  let pd = DVec3.from(p);
  var best = NoIndex;
  var bestD = 0.d;
  var i = 0usize;
  while i < hs.len() {
    let h = *hs[i];
    let a = DVec3.from(*m.positions[usize.from(m.fromVertex(h))]);
    let b = DVec3.from(*m.positions[usize.from(m.toVertex(h))]);
    let s = segmentParam(pd, a, b);
    let d = (pd - (a + (b - a) * s)).lengthSquared();
    if best == NoIndex or d < bestD { best = m.edge(h); bestD = d; }
    i = i + 1usize;
  }
  best
}

// The corner of a face whose vertex is nearest a point
fn nearestCorner(m &PolyMesh, face u32, p Vec3) u32 {
  let hs = m.faceHalfedges(face);
  let pd = DVec3.from(p);
  var best = NoIndex;
  var bestD = 0.d;
  var i = 0usize;
  while i < hs.len() {
    let h = *hs[i];
    let d = (pd - DVec3.from(*m.positions[usize.from(m.toVertex(h))])).lengthSquared();
    if best == NoIndex or d < bestD { best = h; bestD = d; }
    i = i + 1usize;
  }
  best
}
