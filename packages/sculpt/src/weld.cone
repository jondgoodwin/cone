// ======== Weld: merging vertices by distance ========

// Weld (Blender's Merge by Distance, and its Weld modifier in All mode):
// vertices within 'distance' of each other are merged. Two vertices are
// joined when the distance between them is at most 'distance', and a
// cluster is everything joined to anything in it (so a chain of close
// vertices merges as one, as it would merged pair by pair). Each cluster is
// represented by its lowest-numbered vertex, which keeps its position and
// its vertex values; the others go, and the vertices left keep their order,
// so vertex v's new number is the count of representatives before it. Faces
// and their corners follow (see 'collapse'): a face that loses a side loses
// that corner, one left with fewer than 3 corners or crossing itself goes,
// and of two coincident faces the first is kept. Every channel is carried
// (see 'assemble'): a vertex's values are its representative's, a face's
// and a corner's their own, and an edge's the first face's along it, but
// for "crease", which takes the greatest. A distance of 0 merges
// only vertices at the same point; a negative distance merges none, though
// coincident faces still go.
//
// It is deterministic: the clusters are the connected pieces of the "within
// distance" pairs, which do not depend on the order pairs are found in, and
// each is named by its lowest number. Pairs are found through a spatial
// hash of cells 'distance' wide, so only vertices in neighbouring cells are
// compared.
pub fn weld(m: &PolyMesh, distance: f32) PolyMesh {
  let none = List[u32].empty();
  let rep = clusters(&m.positions, distance, &none, 0u32, false);
  collapse(m, &rep)
}

// Each vertex's cluster representative (its lowest-numbered vertex), the
// clusters joining vertices within 'distance' (none when it is negative).
// With 'copyOf' empty, any two vertices may join; otherwise vertex v belongs
// to copy copyOf[v] of 'copies', and only vertices of neighbouring copies
// join: copy k with copy k + 1, and the last with the first when 'wrap'.
fn clusters(pos: &List[Vec3], distance: f32, copyOf: &List[u32], copies: u32, wrap: bool) List[u32] {
  let n = pos.len();
  var parent = List[u32].withCapacity(n);
  var v = 0usize;
  while v < n {
    parent.push(u32.from(v));
    v = v + 1usize;
  }
  if distance < 0. || n == 0usize { return parent; }

  // The spatial hash: each vertex's cell, and the vertices of each slot
  // chained, a slot holding the cells whose hash falls in it
  let size = if distance > 0. {distance} else {1.};
  var slots = 1usize;
  while slots < 2usize * n { slots = slots * 2usize; }
  let mask = u32.from(slots - 1usize);
  var head = List[u32].withCapacity(slots);
  var i = 0usize;
  while i < slots {
    head.push(NoIndex);
    i = i + 1usize;
  }
  var next = List[u32].withCapacity(n);
  var cx = List[i32].withCapacity(n);
  var cy = List[i32].withCapacity(n);
  var cz = List[i32].withCapacity(n);
  v = 0usize;
  while v < n {
    let p = *pos[v];
    let x = cellOf(p.x, size);
    let y = cellOf(p.y, size);
    let z = cellOf(p.z, size);
    cx.push(x);
    cy.push(y);
    cz.push(z);
    let s = usize.from(cellHash(x, y, z) & mask);
    next.push(*head[s]);
    head.set(s, u32.from(v));
    v = v + 1usize;
  }

  // Each vertex against the higher-numbered ones in the 27 cells about it
  let d2 = distance * distance;
  v = 0usize;
  while v < n {
    let p = *pos[v];
    var dz = -1i32;
    while dz <= 1i32 {
      var dy = -1i32;
      while dy <= 1i32 {
        var dx = -1i32;
        while dx <= 1i32 {
          let s = usize.from(cellHash(*cx[v] + dx, *cy[v] + dy, *cz[v] + dz) & mask);
          var w = *head[s];
          while w != NoIndex {
            let wu = usize.from(w);
            if wu > v && mayJoin(copyOf, copies, wrap, v, wu) && (*pos[wu] - p).lengthSquared() <= d2 {
              joinSets(&mut parent, u32.from(v), w);
            }
            w = *next[wu];
          }
          dx = dx + 1i32;
        }
        dy = dy + 1i32;
      }
      dz = dz + 1i32;
    }
    v = v + 1usize;
  }
  var rep = List[u32].withCapacity(n);
  v = 0usize;
  while v < n {
    rep.push(rootOf(&mut parent, u32.from(v)));
    v = v + 1usize;
  }
  rep
}

// Whether vertices a and b may join (see 'clusters')
fn mayJoin(copyOf: &List[u32], copies: u32, wrap: bool, a: usize, b: usize) bool {
  if copyOf.len() == 0usize { return true; }
  let ka = *copyOf[a];
  let kb = *copyOf[b];
  if ka + 1u32 == kb || kb + 1u32 == ka { return true; }
  let lastK = copies - 1u32;
  wrap && copies > 2u32 && ((ka == 0u32 && kb == lastK) || (kb == 0u32 && ka == lastK))
}

// The cell a coordinate falls in, held to a billion cells either way
fn cellOf(x: f32, size: f32) i32 {
  i32.from(clampf(libc.floorf(x / size), -1000000000., 1000000000.))
}

// A cell's slot hash (Teschner et al., "Optimized spatial hashing for
// collision detection of deformable objects", 2003)
fn cellHash(x: i32, y: i32, z: i32) u32 {
  ((x as u32) * 73856093u32) ^ ((y as u32) * 19349663u32) ^ ((z as u32) * 83492791u32)
}

// Union-find, each set rooted at its lowest member: the root of v's set,
// every vertex on the way pointed straight at it
fn rootOf(parent: &mut List[u32], v: u32) u32 {
  var r = v;
  while *parent[usize.from(r)] != r { r = *parent[usize.from(r)]; }
  var x = v;
  while *parent[usize.from(x)] != r {
    let up = *parent[usize.from(x)];
    parent.set(usize.from(x), r);
    x = up;
  }
  r
}

// Join the sets of a and b, under the lower root
fn joinSets(parent: &mut List[u32], a: u32, b: u32) {
  let ra = rootOf(parent, a);
  let rb = rootOf(parent, b);
  if ra < rb { parent.set(usize.from(rb), ra); }
  elif rb < ra { parent.set(usize.from(ra), rb); }
}
