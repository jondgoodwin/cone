// ======== Profile: a 2-D outline ========
//
// Profile, and below it the two functions behind its generators that make a
// list of points of a length not known in advance: 'sampleCurve' (a Bezier
// curve as a polyline) and 'convexHull'.

// A 2-D outline to be swept, extruded or revolved: its points in order and
// whether the last joins back to the first. A closed profile that runs
// counterclockwise (as every generator here makes one) gives outward-facing
// solids. A closed profile needs 3 points, an open one 2.
pub struct Profile {
  pub points List[Vec2];
  pub closed bool;

  // The points as given
  pub fn fromPoints(points &Array[Vec2], closed bool) Profile {
    var pts = List[Vec2].withCapacity(points.len);
    var i = 0usize;
    while i < points.len {
      pts.push(points[i]);
      i = i + 1usize;
    }
    new Profile(pts, closed)
  }

  // A regular polygon of 'sides' corners on a circle of 'radius' about the
  // origin, closed, counterclockwise from its first corner at (radius, 0)
  pub fn polygon(sides u32, radius f32) Profile {
    var pts = List[Vec2].withCapacity(usize.from(sides));
    var i = 0u32;
    while i < sides {
      let a = 2. * pi * f32.from(i) / f32.from(sides);
      pts.push(new Vec2(radius * cos(a), radius * sin(a)));
      i = i + 1u32;
    }
    new Profile(pts, true)
  }

  // A circle of 'radius' about the origin, as 'segments' straight pieces: the
  // regular polygon of that many sides
  pub fn circle(segments u32, radius f32) Profile {Profile.polygon(segments, radius)}

  // A rectangle 'width' across and 'height' high, centred on the origin,
  // closed, counterclockwise from its lower left corner
  pub fn rectangle(width f32, height f32) Profile {
    let hw = width * 0.5;
    let hh = height * 0.5;
    let pts = new List[Vec2](4) <- new Vec2(-hw, -hh), new Vec2(hw, -hh), new Vec2(hw, hh), new Vec2(-hw, hh);
    new Profile(pts, true)
  }

  // A rectangle centred on the origin whose corners are quarter circles of
  // 'radius', each drawn as 'segments' straight pieces (at least 1): closed,
  // counterclockwise, starting where the lower right corner's arc leaves the
  // bottom edge. Each arc has segments + 1 points, 4 (segments + 1) in all;
  // when the radius is half the shorter side, the arcs meet and the point
  // they share is kept once. The radius is held to half the shorter side, and
  // a radius of 0 or less gives the plain rectangle.
  pub fn roundedRectangle(width f32, height f32, radius f32, segments u32) Profile {
    let hw = width * 0.5;
    let hh = height * 0.5;
    let most = if hw < hh {hw} else {hh};
    let r = if radius > most {most} else {radius};
    if r <= 0. { return Profile.rectangle(width, height); }
    let n = if segments < 1u32 {1u32} else {segments};
    let eps = r * 0.00001;
    var pts = List[Vec2].withCapacity(4usize * (usize.from(n) + 1usize));
    var c = 0u32;
    while c < 4u32 {
      // Corners lower right, upper right, upper left, lower left; each arc
      // turns a quarter from where the one before it ended
      let cx = if c == 0u32 || c == 1u32 {hw - r} else {r - hw};
      let cy = if c == 0u32 || c == 3u32 {r - hh} else {hh - r};
      let a0 = (f32.from(c) - 1.) * (pi * 0.5);
      var k = 0u32;
      while k <= n {
        let a = a0 + (pi * 0.5) * f32.from(k) / f32.from(n);
        let p = new Vec2(cx + r * cos(a), cy + r * sin(a));
        if pts.len() == 0usize || !nearVec2(*pts[pts.len() - 1usize], p, eps) { pts.push(p); }
        k = k + 1u32;
      }
      c = c + 1u32;
    }
    if pts.len() > 1usize && nearVec2(*pts[pts.len() - 1usize], *pts[0usize], eps) { pts.pop(); }
    new Profile(pts, true)
  }

  // The convex hull of the points ('convexHull', below): closed,
  // counterclockwise from the point of least x
  pub fn hull(points &Array[Vec2]) Profile {new Profile(convexHull(points), true)}

  // A cubic Bezier curve as an open polyline of 'segments' pieces, evenly
  // spaced in the curve's parameter ('sampleCurve', below)
  pub fn fromCubic(curve CubicBezier2, segments u32) Profile {new Profile(sampleCurve(curve, segments), false)}

  // A quadratic Bezier curve the same way
  pub fn fromQuadratic(curve QuadraticBezier2, segments u32) Profile {new Profile(sampleCurve(curve, segments), false)}

  pub fn pointCount(self &) usize {points.len()}

  // The length of the outline, the closing edge included when it is closed
  pub fn length(self &) f32 {
    var len = polylineLength(points.view());
    if closed && points.len() > 1usize {
      len = len + points[0usize].distance(*points[points.len() - 1usize]);
    }
    len
  }

  // Whether it runs counterclockwise (by its signed area, closed or not)
  pub fn isCounterClockwise(self &) bool {polygonIsCounterClockwise(points.view())}
}

// -------- Bezier curves sampled --------

// A Bezier curve (geomath's) as a polyline of 'segments' straight pieces,
// evenly spaced in t: segments + 1 points, the first p0 and the last the
// curve's end. In the plane or in space, quadratic or cubic
pub fn sampleQuadratic2 overload sampleCurve(curve QuadraticBezier2, segments u32) List[Vec2] {
  var pts = List[Vec2].withCapacity(usize.from(segments) + 1usize);
  var i = 0u32;
  while i <= segments {
    pts.push(curve.point(f32.from(i) / f32.from(segments)));
    i = i + 1u32;
  }
  pts
}

pub fn sampleCubic2 overload sampleCurve(curve CubicBezier2, segments u32) List[Vec2] {
  var pts = List[Vec2].withCapacity(usize.from(segments) + 1usize);
  var i = 0u32;
  while i <= segments {
    pts.push(curve.point(f32.from(i) / f32.from(segments)));
    i = i + 1u32;
  }
  pts
}

pub fn sampleQuadratic3 overload sampleCurve(curve QuadraticBezier3, segments u32) List[Vec3] {
  var pts = List[Vec3].withCapacity(usize.from(segments) + 1usize);
  var i = 0u32;
  while i <= segments {
    pts.push(curve.point(f32.from(i) / f32.from(segments)));
    i = i + 1u32;
  }
  pts
}

pub fn sampleCubic3 overload sampleCurve(curve CubicBezier3, segments u32) List[Vec3] {
  var pts = List[Vec3].withCapacity(usize.from(segments) + 1usize);
  var i = 0u32;
  while i <= segments {
    pts.push(curve.point(f32.from(i) / f32.from(segments)));
    i = i + 1u32;
  }
  pts
}

// -------- Convex hull --------

// Twice the area of the triangle o, a, b, signed: positive when the three run
// counterclockwise, 0 when they are on one line
fn hullTurn(o Vec2, a Vec2, b Vec2) f32 {(a - o).cross(b - o)}

// Whether a comes before b: by x, then by y
fn hullBefore(a Vec2, b Vec2) bool {a.x < b.x || (a.x == b.x && a.y < b.y)}

// Sort the points by x, then by y (heapsort, in place)
fn sortPoints(pts &mut List[Vec2]) {
  let n = pts.len();
  if n < 2usize {return;}
  var start = n / 2usize;
  while start > 0usize {
    start = start - 1usize;
    siftDown(pts, start, n);
  }
  var end = n - 1usize;
  while end > 0usize {
    pts.swap(0usize, end);
    siftDown(pts, 0usize, end);
    end = end - 1usize;
  }
}

fn siftDown(pts &mut List[Vec2], start usize, end usize) {
  var root = start;
  while 2usize * root + 1usize < end {
    var child = 2usize * root + 1usize;
    if child + 1usize < end && hullBefore(*pts[child], *pts[child + 1usize]) {child = child + 1usize;}
    if !hullBefore(*pts[root], *pts[child]) {return;}
    pts.swap(root, child);
    root = child;
  }
}

// The convex hull: the smallest convex polygon holding every point, its
// corners counterclockwise from the one with the least x (and of those the
// least y). Points on its edges are not corners. Andrew's monotone chain: the
// points sorted by x, the lower hull is swept left to right and the upper
// right to left, each dropping a corner that does not turn left
pub fn convexHull(points &Array[Vec2]) List[Vec2] {
  var sorted = List[Vec2].withCapacity(points.len);
  var i = 0usize;
  while i < points.len {
    sorted.push(points[i]);
    i = i + 1usize;
  }
  sortPoints(&mut sorted);
  let n = sorted.len();
  if n < 3usize {return sorted;}
  var hull = List[Vec2].withCapacity(2usize * n);
  i = 0usize;
  while i < n {
    let p = *sorted[i];
    while hull.len() >= 2usize && hullTurn(*hull[hull.len() - 2usize], *hull[hull.len() - 1usize], p) <= 0. {
      hull.pop();
    }
    hull.push(p);
    i = i + 1usize;
  }
  let lower = hull.len() + 1usize;
  i = n - 1usize;
  while i > 0usize {
    i = i - 1usize;
    let p = *sorted[i];
    while hull.len() >= lower && hullTurn(*hull[hull.len() - 2usize], *hull[hull.len() - 1usize], p) <= 0. {
      hull.pop();
    }
    hull.push(p);
  }
  // The last is the first again
  hull.pop();
  hull
}

// Each profile point's u, its distance along the profile over the profile's
// length, then one more: the u of the point after the last, which is 1 (the
// seam, on a closed profile). A profile of no length gets evenly spaced u.
fn profileUs(profile &Profile) List[f32] {
  let m = profile.points.len();
  var us = List[f32].withCapacity(m + 1usize);
  let total = profile.length();
  let pieces = if profile.closed {m} else {m - 1usize};
  var s f32 = 0.;
  var j = 0usize;
  while j < m {
    if total > 0. { us.push(s / total); }
    elif pieces > 0usize { us.push(f32.from(j) / f32.from(pieces)); }
    else { us.push(0.); }
    if j + 1usize < m { s = s + profile.points[j + 1usize].distance(*profile.points[j]); }
    j = j + 1usize;
  }
  us.push(1.);
  us
}

// Each profile point's uv on a cap: the profile's box scaled, keeping its
// shape, so its longer side runs 0 to 1. The cap at the start of a sweep is
// seen from behind, so its u runs the other way, and the texture reads the
// right way round from outside on both.
fn capUvs(profile &Profile, start bool) List[Vec2] {
  let m = profile.points.len();
  var out = List[Vec2].withCapacity(m);
  if m == 0usize { return out; }
  var lo = *profile.points[0usize];
  var hi = lo;
  var j = 1usize;
  while j < m {
    lo = lo.min(*profile.points[j]);
    hi = hi.max(*profile.points[j]);
    j = j + 1usize;
  }
  let w = hi.x - lo.x;
  let h = hi.y - lo.y;
  let size = if w > h {w} else {h};
  let inv = if size > 0. {1. / size} else {1.};
  j = 0usize;
  while j < m {
    let p = *profile.points[j];
    let u = if start {(hi.x - p.x) * inv} else {(p.x - lo.x) * inv};
    out.push(new Vec2(u, (p.y - lo.y) * inv));
    j = j + 1usize;
  }
  out
}
