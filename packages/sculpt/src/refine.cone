// ======== Subdivision: one level's refinement ========
//
// The rules and the entry points are in subdivide.cone. Here data held per
// vertex and per corner, and each channel, is refined one level, and
// 'subdivideOnce' makes that level's mesh.

// One level's new values of one kind of data, seen corner by corner
struct Refined {
  pub vp List[Vec3];   // per half-edge in a face: the vertex point's value at its end, in its face
  pub ep List[Vec3];   // per half-edge in a face: its edge's edge point's value, in its face
  pub fp List[Vec3];   // per face
}

// Subdivide data held per corner, 'vals' (a value per half-edge, the value at
// the vertex it ends at, in its face). 'cutOnValues': face-varying data, cut
// into fans where values differ; otherwise only the boundary cuts. 'rule':
// how a fan's boundary is held, FvarLinearNone to FvarLinearAll (the boundary
// rules are the first two). 'eSharp' is each edge's sharpness, boundary
// edges infinite; 'vSharp' each vertex's.
fn refineValues(m &PolyMesh, vals &List[Vec3], cutOnValues Bool, rule u32, eSharp &List[f32],
    vSharp &List[f32]) Refined {
  imm nh = m.hVertex.len();
  imm nf = m.fHalfedge.len();
  imm nv = m.positions.len();
  imm zero = new Vec3(0., 0., 0.);

  // Face points
  mut fp = List[Vec3].withCapacity(nf);
  mut f = 0usize;
  while f < nf {
    imm hs = m.faceHalfedges(u32.from(f));
    mut sum = zero;
    mut i = 0usize;
    while i < hs.len() {
      sum = sum + *vals[usize.from(*hs[i])];
      i = i + 1usize;
    }
    fp.push(sum * (1. / f32.from(hs.len())));
    f = f + 1usize;
  }

  // Edge points, seen from each face
  mut ep = List[Vec3].withCapacity(nh);
  mut h = 0usize;
  while h < nh {
    imm hf = *m.hFace[h];
    if hf == NoIndex {
      ep.push(zero);
    } else {
      imm t = usize.from(u32.from(h) ^ 1u32);
      imm a = *vals[usize.from(*m.hPrev[h])];
      imm b = *vals[h];
      imm tf = *m.hFace[t];
      if tf == NoIndex or rule == FvarLinearAll {
        ep.push((a + b) * 0.5);
      } else {
        // Across the edge, the twin ends at a and its prev at b
        imm cont = sameVec3(a, *vals[t]) and sameVec3(b, *vals[usize.from(*m.hPrev[t])]);
        // Summed in one order from both sides (the even half-edge's), so the
        // two faces get the same bits and a continuous edge stays continuous
        imm s = *eSharp[h / 2usize];
        if !cont or h % 2usize == 0usize {
          ep.push(edgeValue(a, b, *fp[usize.from(hf)], *fp[usize.from(tf)], s, !cont));
        } else {
          ep.push(edgeValue(*vals[usize.from(*m.hPrev[t])], *vals[t], *fp[usize.from(tf)], *fp[usize.from(hf)], s, !cont));
        }
      }
    }
    h = h + 1usize;
  }

  // Vertex points, fan by fan
  mut vp = List[Vec3].withCapacity(nh);
  h = 0usize;
  while h < nh {
    vp.push(zero);
    h = h + 1usize;
  }
  mut ends = List[Vec3].empty();
  mut faces = List[Vec3].empty();
  mut sharp = List[f32].empty();
  mut cuts = List[usize].empty();
  mut v = 0usize;
  while v < nv {
    imm ring = m.vertexOutgoing(u32.from(v));
    imm k = ring.len();
    // Edge ring[i] lies between the faces of ring[i - 1] and ring[i]; it
    // cuts when either is missing or, for face-varying data, when the values
    // at the vertex differ across it
    cuts.clear();
    mut fans = 0usize;
    mut i = 0usize;
    while i < k {
      imm hi = usize.from(*ring[i]);
      imm hb = usize.from(*ring[(i + k - 1usize) % k]);
      imm fi = *m.hFace[hi];
      imm fb = *m.hFace[hb];
      mut cut = fi == NoIndex or fb == NoIndex;
      if !cut and cutOnValues {
        cut = !sameVec3(*vals[usize.from(*m.hPrev[hi])], *vals[usize.from(*m.hPrev[hb])]);
      }
      if cut {
        cuts.push(i);
        if fi != NoIndex { fans = fans + 1usize; }
      }
      i = i + 1usize;
    }
    if rule == FvarLinearAll {
      i = 0usize;
      while i < k {
        imm hi = usize.from(*ring[i]);
        if *m.hFace[hi] != NoIndex {
          imm c = usize.from(*m.hPrev[hi]);
          vp.set(c, *vals[c]);
        }
        i = i + 1usize;
      }
    } elif k > 0usize and cuts.len() == 0usize {
      // One fan all the way round
      ends.clear();
      faces.clear();
      sharp.clear();
      imm own = *vals[usize.from(*m.hPrev[usize.from(*ring[0usize])])];
      i = 0usize;
      while i < k {
        imm hi = *ring[i];
        ends.push(*vals[usize.from(hi)]);
        faces.push(*fp[usize.from(*m.hFace[usize.from(hi)])]);
        sharp.push(fanEdgeSharpness(m, vals, eSharp, hi, cutOnValues));
        i = i + 1usize;
      }
      imm p = fanPoint(own, &ends, &faces, &sharp, *vSharp[v], true);
      i = 0usize;
      while i < k {
        vp.set(usize.from(*m.hPrev[usize.from(*ring[i])]), p);
        i = i + 1usize;
      }
    } else {
      imm nc = cuts.len();
      mut ci = 0usize;
      while ci < nc {
        imm c = *cuts[ci];
        if *m.hFace[usize.from(*ring[c])] != NoIndex {
          // The fan from cut edge ring[c] to the next cut edge, unwrapped
          imm cn = if ci + 1usize < nc {*cuts[ci + 1usize];} else {*cuts[0usize] + k;};
          ends.clear();
          faces.clear();
          sharp.clear();
          imm own = *vals[usize.from(*m.hPrev[usize.from(*ring[c])])];
          mut j = c;
          while j < cn {
            imm hj = *ring[j % k];
            ends.push(*vals[usize.from(hj)]);
            faces.push(*fp[usize.from(*m.hFace[usize.from(hj)])]);
            if j == c { sharp.push(SharpnessInfinite); }
            else { sharp.push(fanEdgeSharpness(m, vals, eSharp, hj, cutOnValues)); }
            j = j + 1usize;
          }
          // The last edge's far end, seen from the fan's last face
          imm hl = usize.from(*ring[(cn - 1usize) % k]);
          ends.push(*vals[usize.from(*m.hPrev[usize.from(*m.hPrev[hl])])]);
          sharp.push(SharpnessInfinite);
          mut vs = *vSharp[v];
          imm oneFace = cn - c == 1usize;
          if (rule == FvarLinearCornersOnly or rule == FvarLinearCornersPlus1) and oneFace { vs = SharpnessInfinite; }
          if rule == FvarLinearCornersPlus1 and fans >= 3usize { vs = SharpnessInfinite; }
          if rule == FvarLinearBoundaries { vs = SharpnessInfinite; }
          imm p = fanPoint(own, &ends, &faces, &sharp, vs, false);
          j = c;
          while j < cn {
            vp.set(usize.from(*m.hPrev[usize.from(*ring[j % k])]), p);
            j = j + 1usize;
          }
        }
        ci = ci + 1usize;
      }
    }
    v = v + 1usize;
  }
  new Refined(vp, ep, fp);
}

// The sharpness of the edge of half-edge h (leaving the vertex) inside a fan:
// the edge's own, or infinite when face-varying values differ across its far
// end
fn fanEdgeSharpness(m &PolyMesh, vals &List[Vec3], eSharp &List[f32], h u32, cutOnValues Bool) f32 {
  imm s = *eSharp[usize.from(h / 2u32)];
  if !cutOnValues { return s; }
  imm t = usize.from(h ^ 1u32);
  if !sameVec3(*vals[usize.from(h)], *vals[usize.from(*m.hPrev[t])]) { return SharpnessInfinite; }
  s;
}

// Subdivide per-vertex values: returned per child vertex (vertex points, edge
// points, face points)
fn refineVertexData(m &PolyMesh, vvals &List[Vec3], boundary u32, eSharp &List[f32], vSharp &List[f32]) List[Vec3] {
  imm nh = m.hVertex.len();
  mut cv = List[Vec3].withCapacity(nh);
  mut h = 0usize;
  while h < nh {
    cv.push(*vvals[usize.from(*m.hVertex[h])]);
    h = h + 1usize;
  }
  imm r = refineValues(m, &cv, false, boundary, eSharp, vSharp);
  imm nv = m.positions.len();
  imm ne = nh / 2usize;
  imm nf = m.fHalfedge.len();
  mut out = List[Vec3].withCapacity(nv + ne + nf);
  mut v = 0usize;
  while v < nv {
    imm vh = *m.vHalfedge[v];
    // The half-edge coming in to v along its own is in a face
    if vh == NoIndex { out.push(*vvals[v]); } else { out.push(*r.vp[usize.from(vh ^ 1u32)]); }
    v = v + 1usize;
  }
  mut e = 0usize;
  while e < ne {
    imm he = if *m.hFace[2usize * e] == NoIndex {2usize * e + 1usize;} else {2usize * e;};
    out.push(*r.ep[he]);
    e = e + 1usize;
  }
  mut f = 0usize;
  while f < nf {
    out.push(*r.fp[f]);
    f = f + 1usize;
  }
  out;
}

// Subdivide per-corner (face-varying) values: returned per child half-edge.
// Child face c came from the corner of parent half-edge parentHalf[c] in
// parent face parentFace[c].
fn refineCornerData(m &PolyMesh, cvals &List[Vec3], fvar u32, eSharp &List[f32], vSharp &List[f32],
    child &PolyMesh, parentFace &List[u32], parentHalf &List[u32]) List[Vec3] {
  imm r = refineValues(m, cvals, true, fvar, eSharp, vSharp);
  imm nh = child.hVertex.len();
  mut out = List[Vec3].withCapacity(nh);
  mut h = 0usize;
  while h < nh {
    out.push(new Vec3(0., 0., 0.));
    h = h + 1usize;
  }
  mut c = 0usize;
  while c < child.fHalfedge.len() {
    imm chs = child.faceHalfedges(u32.from(c));
    imm ph = usize.from(*parentHalf[c]);
    imm pn = usize.from(*m.hNext[ph]);
    out.set(usize.from(*chs[0usize]), *r.vp[ph]);
    out.set(usize.from(*chs[1usize]), *r.ep[pn]);
    out.set(usize.from(*chs[2usize]), *r.fp[usize.from(*parentFace[c])]);
    out.set(usize.from(*chs[3usize]), *r.ep[ph]);
    c = c + 1usize;
  }
  out;
}

// A channel's f32, Vec2 or Vec3 values carried as Vec3 (from the mesh, by
// channel number, since '&m.floats[c].values' is refused as a '&List'), and
// back
fn floatChannelVec3s(m &PolyMesh, c usize) List[Vec3] {
  imm n = m.floats[c].values.len();
  mut out = List[Vec3].withCapacity(n);
  mut i = 0usize;
  while i < n {
    out.push(new Vec3(*m.floats[c].values[i], 0., 0.));
    i = i + 1usize;
  }
  out;
}
fn vec2ChannelVec3s(m &PolyMesh, c usize) List[Vec3] {
  imm n = m.vec2s[c].values.len();
  mut out = List[Vec3].withCapacity(n);
  mut i = 0usize;
  while i < n {
    imm p = *m.vec2s[c].values[i];
    out.push(new Vec3(p.x, p.y, 0.));
    i = i + 1usize;
  }
  out;
}
fn vec3ChannelVec3s(m &PolyMesh, c usize) List[Vec3] {
  imm n = m.vec3s[c].values.len();
  mut out = List[Vec3].withCapacity(n);
  mut i = 0usize;
  while i < n {
    out.push(*m.vec3s[c].values[i]);
    i = i + 1usize;
  }
  out;
}
fn vec3ToFloats(src &List[Vec3]) List[f32] {
  mut out = List[f32].withCapacity(src.len());
  mut i = 0usize;
  while i < src.len() {
    out.push(src[i].x);
    i = i + 1usize;
  }
  out;
}
fn vec3ToVec2s(src &List[Vec3]) List[Vec2] {
  mut out = List[Vec2].withCapacity(src.len());
  mut i = 0usize;
  while i < src.len() {
    out.push(new Vec2(src[i].x, src[i].y));
    i = i + 1usize;
  }
  out;
}

// A channel's values carried to the child's elements, by domain, as Vec3.
// 'isCrease': the "crease" sharpness channel, which wears down instead.
fn refineChannel(m &PolyMesh, child &PolyMesh, domain u32, vals &List[Vec3], isCrease Bool, boundary u32,
    fvar u32, eSharp &List[f32], vSharp &List[f32], cEdgeParent &List[u32], parentFace &List[u32],
    parentHalf &List[u32]) List[Vec3] {
  imm zero = new Vec3(0., 0., 0.);
  if domain == VertexDomain {
    if !isCrease { return refineVertexData(m, vals, boundary, eSharp, vSharp); }
    mut out = List[Vec3].withCapacity(child.positions.len());
    mut v = 0usize;
    while v < child.positions.len() {
      if v < m.positions.len() { out.push(new Vec3(childSharpness(vals[v].x), 0., 0.)); } else { out.push(zero); }
      v = v + 1usize;
    }
    return out;
  }
  if domain == EdgeDomain {
    imm ne = child.hVertex.len() / 2usize;
    mut out = List[Vec3].withCapacity(ne);
    mut e = 0usize;
    while e < ne {
      imm pe = *cEdgeParent[e];
      if pe == NoIndex { out.push(zero); }
      elif isCrease { out.push(new Vec3(childSharpness(vals[usize.from(pe)].x), 0., 0.)); }
      else { out.push(*vals[usize.from(pe)]); }
      e = e + 1usize;
    }
    return out;
  }
  if domain == FaceDomain {
    mut out = List[Vec3].withCapacity(child.fHalfedge.len());
    mut c = 0usize;
    while c < child.fHalfedge.len() {
      out.push(*vals[usize.from(*parentFace[c])]);
      c = c + 1usize;
    }
    return out;
  }
  refineCornerData(m, vals, fvar, eSharp, vSharp, child, parentFace, parentHalf);
}

// One level of Catmull-Clark
fn subdivideOnce(m &PolyMesh, boundary u32, fvar u32) PolyMesh {
  imm nv = m.positions.len();
  imm nh = m.hVertex.len();
  imm ne = nh / 2usize;
  imm nf = m.fHalfedge.len();

  // Sharpness: the crease channels, and boundary edges infinitely sharp
  imm creaseE = m.findFloatChannel(EdgeDomain, "crease");
  imm creaseV = m.findFloatChannel(VertexDomain, "crease");
  mut eSharp = List[f32].withCapacity(ne);
  mut e = 0usize;
  while e < ne {
    mut s f32 = 0.;
    if creaseE != NoIndex { s = m.float(creaseE, u32.from(e)); }
    if s < 0. { s = 0.; }
    if m.isBoundaryEdge(u32.from(e)) { s = SharpnessInfinite; }
    eSharp.push(s);
    e = e + 1usize;
  }
  mut vSharp = List[f32].withCapacity(nv);
  mut v = 0usize;
  while v < nv {
    mut s f32 = 0.;
    if creaseV != NoIndex { s = m.float(creaseV, u32.from(v)); }
    if s < 0. { s = 0.; }
    vSharp.push(s);
    v = v + 1usize;
  }

  // The new positions and faces
  imm pos = refineVertexData(m, &m.positions, boundary, &eSharp, &vSharp);
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut pEdgeA = List[u32].empty();
  mut pEdgeB = List[u32].empty();
  mut parentFace = List[u32].empty();
  mut parentHalf = List[u32].empty();
  mut f = 0usize;
  while f < nf {
    imm hs = m.faceHalfedges(u32.from(f));
    imm n = hs.len();
    mut k = 0usize;
    while k < n {
      imm h = *hs[k];
      imm hn = *hs[(k + 1usize) % n];
      counts.push(4u32);
      idx.push(*m.hVertex[usize.from(h)]);
      idx.push(u32.from(nv) + hn / 2u32);
      idx.push(u32.from(nv + ne + f));
      idx.push(u32.from(nv) + h / 2u32);
      pEdgeA.push(h / 2u32);
      pEdgeB.push(hn / 2u32);
      parentFace.push(u32.from(f));
      parentHalf.push(h);
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  mut problems = List[String].empty();
  mut child = PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems);

  // Each child edge's parent edge: a child face's first half-edge runs along
  // its parent corner's incoming edge, its second along the outgoing one
  imm cne = child.hVertex.len() / 2usize;
  mut cEdgeParent = List[u32].withCapacity(cne);
  e = 0usize;
  while e < cne {
    cEdgeParent.push(NoIndex);
    e = e + 1usize;
  }
  mut c = 0usize;
  while c < child.fHalfedge.len() {
    imm chs = child.faceHalfedges(u32.from(c));
    cEdgeParent.set(usize.from(*chs[0usize] / 2u32), *pEdgeA[c]);
    cEdgeParent.set(usize.from(*chs[1usize] / 2u32), *pEdgeB[c]);
    c = c + 1usize;
  }

  // The channels
  mut i = 0usize;
  while i < m.floats.len() {
    imm domain = m.floats[i].domain;
    imm isCrease = m.floats[i].name.equals("crease") and (domain == EdgeDomain or domain == VertexDomain);
    imm vals = floatChannelVec3s(m, i);
    imm out = refineChannel(m, &child, domain, &vals, isCrease, boundary, fvar, &eSharp, &vSharp,
      &cEdgeParent, &parentFace, &parentHalf);
    child.floats.push(new Channel[f32](String.from(m.floats[i].name.view()), domain, vec3ToFloats(&out)));
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.vec2s.len() {
    imm domain = m.vec2s[i].domain;
    imm vals = vec2ChannelVec3s(m, i);
    imm out = refineChannel(m, &child, domain, &vals, false, boundary, fvar, &eSharp, &vSharp,
      &cEdgeParent, &parentFace, &parentHalf);
    child.vec2s.push(new Channel[Vec2](String.from(m.vec2s[i].name.view()), domain, vec3ToVec2s(&out)));
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.vec3s.len() {
    imm domain = m.vec3s[i].domain;
    imm vals = vec3ChannelVec3s(m, i);
    imm out = refineChannel(m, &child, domain, &vals, false, boundary, fvar, &eSharp, &vSharp,
      &cEdgeParent, &parentFace, &parentHalf);
    child.vec3s.push(new Channel[Vec3](String.from(m.vec3s[i].name.view()), domain, out));
    i = i + 1usize;
  }
  child;
}
