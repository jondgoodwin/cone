// ======== Mirror and array: copies under a transform ========

// A mirror (Blender's Mirror modifier, one plane): the mesh kept, and a copy
// reflected in the plane through 'origin' with normal 'normal' (made unit)
// added after it. Reflection turns faces inside out, so each copied face's
// corners are taken in reverse order, from the same first corner, and it
// faces outward again; each corner keeps its own corner values (its uv, the
// texture mirrored with the shape), and each side keeps its edge's values.
// Without merging, vertex v's copy is vertex V + v (V the mesh's vertex
// count) and face f's is face F + f.
//
// With 'merge' at 0 or more, a vertex within 'merge' of its own reflection
// (within merge / 2 of the plane) is merged with it, as Blender's Merge
// option does: the vertex is moved onto the plane and its copy is not made,
// so the two halves are stitched along the seam. Copies of the other
// vertices follow, in order, and faces that merge into their originals go
// (see 'collapse'). A negative 'merge' merges nothing. The mesh should lie on
// one side of the plane with its seam open; a face crossing the plane is
// not cut (Blender's Bisect).
pub fn mirror(m &PolyMesh, origin Vec3, normal Vec3, merge f32) PolyMesh {
  mirrorWith(m, origin, normal, merge, false, false, new Vec2(0., 0.));
}

// The same, with the copy's uvs (the corner channel "uv") changed as
// Blender's Mirror U and V and UV offsets change them: with 'mirrorU', a copied
// corner's u becomes 1 - u, with 'mirrorV' its v 1 - v, and then
// 'uvOffset' is added, so the copy can read the texture the right way round
// or from another part of the image.
pub fn mirrorWith(m &PolyMesh, origin Vec3, normal Vec3, merge f32, mirrorU Bool, mirrorV Bool,
    uvOffset Vec2) PolyMesh {
  imm nrm = unit(normal);
  imm nv = m.positions.len();
  imm nf = m.fHalfedge.len();
  mut pos = List[Vec3].withCapacity(2usize * nv);
  mut vSrc = List[u32].withCapacity(2usize * nv);
  mut v = 0usize;
  while v < nv {
    pos.push(*m.positions[v]);
    vSrc.push(u32.from(v));
    v = v + 1usize;
  }
  v = 0usize;
  while v < nv {
    imm p = *m.positions[v];
    pos.push(p - nrm * (2. * (p - origin).dot(nrm)));
    vSrc.push(u32.from(v));
    v = v + 1usize;
  }
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut cSrc = List[u32].empty();
  mut eSrc = List[u32].empty();
  mut fSrc = List[u32].empty();
  addCopy(m, 0usize, &mut counts, &mut idx, &mut cSrc, &mut eSrc, &mut fSrc);
  // The copy reversed: corner j is the original's corner (n - j) % n, and
  // its incoming side runs along the original's side out of that corner
  mut f = 0usize;
  while f < nf {
    imm hs = m.faceHalfedges(u32.from(f));
    imm n = hs.len();
    counts.push(u32.from(n));
    mut j = 0usize;
    while j < n {
      imm i = (n - j) % n;
      imm h = *hs[i];
      idx.push(u32.from(nv) + *m.hVertex[usize.from(h)]);
      cSrc.push(h);
      eSrc.push(*hs[(i + 1usize) % n] / 2u32);
      j = j + 1usize;
    }
    fSrc.push(u32.from(f));
    f = f + 1usize;
  }
  mut both = assemble(m, &pos, &vSrc, &counts, &idx, &cSrc, &eSrc, &fSrc);

  imm uvCh = both.findVec2Channel(CornerDomain, "uv");
  if uvCh != NoIndex and (mirrorU or mirrorV or uvOffset.x != 0. or uvOffset.y != 0.) {
    f = nf;
    while f < both.fHalfedge.len() {
      imm hs = both.faceHalfedges(u32.from(f));
      mut k = 0usize;
      while k < hs.len() {
        imm uv = both.vec2(uvCh, *hs[k]);
        imm u = if mirrorU {1. - uv.x;} else {uv.x;};
        imm w = if mirrorV {1. - uv.y;} else {uv.y;};
        both.setVec2(uvCh, *hs[k], new Vec2(u + uvOffset.x, w + uvOffset.y));
        k = k + 1usize;
      }
      f = f + 1usize;
    }
  }
  if merge < 0. { return both; }

  // Each vertex near the plane: onto it, its copy merged into it
  mut rep = List[u32].withCapacity(2usize * nv);
  v = 0usize;
  while v < 2usize * nv {
    rep.push(u32.from(v));
    v = v + 1usize;
  }
  v = 0usize;
  while v < nv {
    imm p = *m.positions[v];
    imm d = (p - origin).dot(nrm);
    if 2. * absf(d) <= merge {
      rep.set(nv + v, u32.from(v));
      both.positions.set(v, p - nrm * d);
    }
    v = v + 1usize;
  }
  collapse(&both, &rep);
}

// A linear array (Blender's Array modifier, a constant offset): 'count'
// copies, copy k moved by offset * k. Copy k's vertex v is vertex k V + v
// and its face f face k F + f (V and F the mesh's counts), every channel
// copied with it. With 'merge' at 0 or more, the vertices of neighbouring
// copies within 'merge' of each other are merged, as Blender's Merge option
// does (see 'arrayRadial' for how).
pub fn arrayLinear(m &PolyMesh, count u32, offset Vec3, merge f32) PolyMesh {
  imm n = usize.from(count);
  imm nv = m.positions.len();
  mut pos = List[Vec3].withCapacity(n * nv);
  mut k = 0usize;
  while k < n {
    imm shift = offset * f32.from(k);
    mut v = 0usize;
    while v < nv {
      pos.push(*m.positions[v] + shift);
      v = v + 1usize;
    }
    k = k + 1usize;
  }
  arrayOf(m, &pos, n, merge, false);
}

// A radial array (Blender's Array modifier in a circle or an arc): 'count'
// copies turned about the line through 'origin' along 'axis' (made unit),
// counterclockwise seen from the tip of the axis. As 'lathe' spaces its
// steps, an angle of a whole turn (2 pi, within a ten-thousandth) spreads
// the copies round it, copy k at angle * k / count; any other angle puts
// the first copy at 0 and the last at the angle, copy k at
// angle * k / (count - 1). Copy 0 is the mesh where it is. Numbering is as
// 'arrayLinear''s.
//
// With 'merge' at 0 or more, a vertex is merged with a vertex of the copy
// before it or after it within 'merge' of it (and, round a whole turn, the
// last copy's with the first's), so copies that touch are stitched; each
// cluster of merged vertices keeps its lowest-numbered vertex, the earliest
// copy's (see 'weld'). Vertices of one copy are never merged with each other
// or with a copy further off.
pub fn arrayRadial(m &PolyMesh, count u32, axis Vec3, angle f32, origin Vec3, merge f32) PolyMesh {
  imm n = usize.from(count);
  imm a = unit(axis);
  imm full = absf(angle) >= 2. * pi - 0.0001;
  imm steps = if full {f32.from(n);} elif n > 1usize {f32.from(n - 1usize);} else {1.;};
  imm nv = m.positions.len();
  mut pos = List[Vec3].withCapacity(n * nv);
  mut k = 0usize;
  while k < n {
    imm q = Quat.angleAxis(angle * f32.from(k) / steps, a);
    mut v = 0usize;
    while v < nv {
      imm p = *m.positions[v];
      if k == 0usize { pos.push(p); } else { pos.push(origin + q * (p - origin)); }
      v = v + 1usize;
    }
    k = k + 1usize;
  }
  arrayOf(m, &pos, n, merge, full);
}

// An array along a path (Blender's Array modifier along a curve, aligned to
// it): 'count' copies spaced evenly by arc length, each placed rigidly in
// the path's rotation-minimizing frame there (Path.frames, blended between
// path points), the mesh's x along the frame's normal, its y along the
// binormal and its z along the tangent, as a profile is placed (so a mesh
// built along +z follows the path). On an open path the first copy is at
// its start and the last at its end, copy k at L k / (count - 1); round a
// closed path they are spread, copy k at L k / count, and with 'merge' the
// last is stitched to the first. Numbering and merging are as
// 'arrayRadial''s.
pub fn arrayAlongPath(m &PolyMesh, path &Path, count u32, merge f32) PolyMesh {
  imm n = usize.from(count);
  imm frames = path.frames();
  imm dist = path.distances();
  imm total = path.length();
  imm steps = if path.closed {f32.from(n);} elif n > 1usize {f32.from(n - 1usize);} else {1.;};
  imm nv = m.positions.len();
  mut pos = List[Vec3].withCapacity(n * nv);
  mut k = 0usize;
  while k < n {
    mut v = 0usize;
    if frames.len() == 0usize {
      while v < nv {
        pos.push(*m.positions[v]);
        v = v + 1usize;
      }
    } else {
      imm fr = frameAtDistance(path, &frames, &dist, total, total * f32.from(k) / steps);
      while v < nv {
        imm p = *m.positions[v];
        pos.push(fr.origin + fr.normal * p.x + fr.binormal * p.y + fr.tangent * p.z);
        v = v + 1usize;
      }
    }
    k = k + 1usize;
  }
  arrayOf(m, &pos, n, merge, path.closed);
}

// The copies of m at the positions 'pos' (copy k's vertex v at k V + v),
// concatenated, with neighbouring copies merged when 'merge' is 0 or more
fn arrayOf(m &PolyMesh, pos &List[Vec3], count usize, merge f32, wrap Bool) PolyMesh {
  imm nv = m.positions.len();
  mut vSrc = List[u32].withCapacity(count * nv);
  mut copyOf = List[u32].withCapacity(count * nv);
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut cSrc = List[u32].empty();
  mut eSrc = List[u32].empty();
  mut fSrc = List[u32].empty();
  mut k = 0usize;
  while k < count {
    mut v = 0usize;
    while v < nv {
      vSrc.push(u32.from(v));
      copyOf.push(u32.from(k));
      v = v + 1usize;
    }
    addCopy(m, k * nv, &mut counts, &mut idx, &mut cSrc, &mut eSrc, &mut fSrc);
    k = k + 1usize;
  }
  imm joined = assemble(m, pos, &vSrc, &counts, &idx, &cSrc, &eSrc, &fSrc);
  if merge < 0. or count < 2usize { return joined; }
  imm rep = clusters(&joined.positions, merge, &copyOf, u32.from(count), wrap);
  collapse(&joined, &rep);
}

// m's faces as they are, their vertices numbered from 'base', added to the
// flat face lists 'assemble' takes
fn addCopy(m &PolyMesh, base usize, counts &mut List[u32], idx &mut List[u32], cSrc &mut List[u32],
    eSrc &mut List[u32], fSrc &mut List[u32]) {
  mut f = 0usize;
  while f < m.fHalfedge.len() {
    imm hs = m.faceHalfedges(u32.from(f));
    counts.push(u32.from(hs.len()));
    mut i = 0usize;
    while i < hs.len() {
      imm h = *hs[i];
      idx.push(u32.from(base) + *m.hVertex[usize.from(h)]);
      cSrc.push(h);
      eSrc.push(h / 2u32);
      i = i + 1usize;
    }
    fSrc.push(u32.from(f));
    f = f + 1usize;
  }
}
