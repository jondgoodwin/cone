// ======== Join: separately made meshes as one ========

// Join (Blender's Join, and its Join Geometry node): the meshes 'parts' made
// into one PolyMesh, part after part. Part k's vertex v becomes vertex
// V0 + ... + V(k-1) + v (Vj part j's vertex count), and its half-edges and
// faces are numbered on in the same way, every link offset with them, so
// each part keeps its own half-edges, edges, boundary loops and corners
// exactly; nothing is welded or bridged (that is 'weld' and 'bridgeLoops'
// afterwards). Joining a mesh with an empty one gives the mesh back bit for
// bit.
//
// Channels are matched by name and domain, and the result carries the union
// of every part's channels: each type's channels in the order they are first
// met, part by part. A part with a channel gives its own values; the elements
// of a part without it get the channel's fill (see mesh.Channel: 0 by
// default, 1 for a weight), so the joined mesh behaves as each part did
// alone. Where parts give one channel different fills, the first part's is
// kept.
//
// The same name with a different type (f32, Vec2, Vec3) or a different
// domain in two parts is refused, not converted, since it is almost always a
// mistake: the later part's channel is left out (its elements get the fill
// of the channel kept), and a line saying why is added to 'problems', as
// fromPolygons reports a face it leaves out; the join is still made. Each
// part is checked against the channels of the parts before it, so the first
// part's form of a name is the one kept. (The edge "crease" and the vertex
// "crease_vert" are two names, so they never clash.)
pub fn join(parts &List[PolyMesh], problems &mut List[String]) PolyMesh {
  let none = List[Transform3].empty();
  joinPlaced(parts, &none, problems)
}

// The same, part k first placed by places[k] (scaled, turned, then moved, as
// a Transform3 places a thing); a part past the end of 'places', or placed by
// the identity exactly, stays where it is, bit for bit. Only positions move:
// a Vec3 channel is copied as it is, as mirror and the arrays copy it. A place whose scale turns the part inside
// out (an odd number of negative factors, a reflection) also turns its faces
// over, each from the same first corner, as 'mirror' turns its copy, so it
// still faces outward; its corners keep their values, and its edges theirs.
pub fn joinPlaced(parts &List[PolyMesh], places &List[Transform3], problems &mut List[String]) PolyMesh {
  var out = PolyMesh.empty();
  let np = parts.len();
  var flips = List[bool].withCapacity(np);
  var k = 0usize;
  while k < np {
    let place = if k < places.len() {*places[k]} else {Transform3.identity()};
    let placed = !isIdentity(place);
    let flip = placed and place.scale.x * place.scale.y * place.scale.z < 0.;
    appendPart(&mut out, parts[k], place, placed, flip);
    flips.push(flip);
    k = k + 1usize;
  }

  // The union of the channels: each one by the part and number it is first
  // met at, its type 0 for f32, 1 for Vec2, 2 for Vec3
  var uKind = List[u32].empty();
  var uPart = List[usize].empty();
  var uIdx = List[usize].empty();
  k = 0usize;
  while k < np {
    let before = uKind.len();
    var kind = 0u32;
    while kind < 3u32 {
      var i = 0usize;
      while i < channelCount(parts[k], kind) {
        let name = channelName(parts[k], kind, i);
        let domain = channelDomain(parts[k], kind, i);
        var same = false;          // the parts before have it, this type and domain
        var clash = NoIndex;       // one of theirs of the name, another type
        var other = NoIndex;       // one of theirs of the name, this type, another domain
        var u = 0usize;
        while u < before {
          let uk = *uKind[u];
          let up = *uPart[u];
          let ui = *uIdx[u];
          if channelNameIs(parts[up], uk, ui, name.view()) {
            let ud = channelDomain(parts[up], uk, ui);
            if uk == kind and ud == domain { same = true; }
            elif uk != kind { if clash == NoIndex { clash = u32.from(u); } }
            elif other == NoIndex { other = u32.from(u); }
          }
          u = u + 1usize;
        }
        if same {
          // matched: its values join the channel's
        } elif clash != NoIndex {
          let u = usize.from(clash);
          var s = refusedLine(k, name.view(), kind, domain);
          s.append(": part ");
          s.appendUInt(u64.from(*uPart[u]));
          s.append(" has it as ");
          s.append(kindName(*uKind[u]));
          problems.push(s);
        } elif other != NoIndex {
          let u = usize.from(other);
          var s = refusedLine(k, name.view(), kind, domain);
          s.append(": part ");
          s.appendUInt(u64.from(*uPart[u]));
          s.append(" has it per ");
          s.append(domainName(channelDomain(parts[*uPart[u]], *uKind[u], *uIdx[u])));
          problems.push(s);
        } else {
          uKind.push(kind);
          uPart.push(k);
          uIdx.push(i);
        }
        i = i + 1usize;
      }
      kind = kind + 1u32;
    }
    k = k + 1usize;
  }

  // Each channel's values, part by part: its own, or its fill
  var u = 0usize;
  while u < uKind.len() {
    if *uKind[u] == 0u32 {
      let up = *uPart[u];
      let ui = *uIdx[u];
      let name = channelName(parts[up], 0u32, ui);
      let domain = channelDomain(parts[up], 0u32, ui);
      let fill = floatFill(parts[up], ui);
      var values = List[f32].withCapacity(out.domainSize(domain));
      k = 0usize;
      while k < np {
        appendFloats(&mut values, parts[k], domain, name.view(), fill, *flips[k]);
        k = k + 1usize;
      }
      out.floats.push(new Channel[f32](String.from(name.view()), domain, values, fill));
    }
    u = u + 1usize;
  }
  u = 0usize;
  while u < uKind.len() {
    if *uKind[u] == 1u32 {
      let up = *uPart[u];
      let ui = *uIdx[u];
      let name = channelName(parts[up], 1u32, ui);
      let domain = channelDomain(parts[up], 1u32, ui);
      let fill = vec2Fill(parts[up], ui);
      var values = List[Vec2].withCapacity(out.domainSize(domain));
      k = 0usize;
      while k < np {
        appendVec2s(&mut values, parts[k], domain, name.view(), fill, *flips[k]);
        k = k + 1usize;
      }
      out.vec2s.push(new Channel[Vec2](String.from(name.view()), domain, values, fill));
    }
    u = u + 1usize;
  }
  u = 0usize;
  while u < uKind.len() {
    if *uKind[u] == 2u32 {
      let up = *uPart[u];
      let ui = *uIdx[u];
      let name = channelName(parts[up], 2u32, ui);
      let domain = channelDomain(parts[up], 2u32, ui);
      let fill = vec3Fill(parts[up], ui);
      var values = List[Vec3].withCapacity(out.domainSize(domain));
      k = 0usize;
      while k < np {
        appendVec3s(&mut values, parts[k], domain, name.view(), fill, *flips[k]);
        k = k + 1usize;
      }
      out.vec3s.push(new Channel[Vec3](String.from(name.view()), domain, values, fill));
    }
    u = u + 1usize;
  }
  out
}

// m's vertices, half-edges and faces added after out's, every link offset;
// with 'placed', its positions placed by 'place', and with 'flip' its faces
// turned over: each half-edge runs the other way (its vertex its twin's, its
// next its prev), a face's half-edge is the next one, so the face keeps its
// first corner, and a vertex's the one before it, which leaves it and is a
// boundary one when it was
fn appendPart(out &mut PolyMesh, m &PolyMesh, place Transform3, placed bool, flip bool) {
  let v0 = u32.from(out.positions.len());
  let h0 = u32.from(out.hVertex.len());
  let f0 = u32.from(out.fHalfedge.len());
  var v = 0usize;
  while v < m.positions.len() {
    let p = *m.positions[v];
    if placed { out.positions.push(place.transformPoint(p)); } else { out.positions.push(p); }
    let vh = *m.vHalfedge[v];
    if vh == NoIndex { out.vHalfedge.push(NoIndex); }
    elif flip { out.vHalfedge.push(h0 + *m.hPrev[usize.from(vh)]); }
    else { out.vHalfedge.push(h0 + vh); }
    v = v + 1usize;
  }
  var h = 0usize;
  while h < m.hVertex.len() {
    if flip {
      out.hNext.push(h0 + *m.hPrev[h]);
      out.hPrev.push(h0 + *m.hNext[h]);
      out.hVertex.push(v0 + *m.hVertex[h ^ 1usize]);
    } else {
      out.hNext.push(h0 + *m.hNext[h]);
      out.hPrev.push(h0 + *m.hPrev[h]);
      out.hVertex.push(v0 + *m.hVertex[h]);
    }
    let f = *m.hFace[h];
    if f == NoIndex { out.hFace.push(NoIndex); } else { out.hFace.push(f0 + f); }
    h = h + 1usize;
  }
  var f = 0usize;
  while f < m.fHalfedge.len() {
    let fh = *m.fHalfedge[f];
    if flip { out.fHalfedge.push(h0 + *m.hNext[usize.from(fh)]); } else { out.fHalfedge.push(h0 + fh); }
    f = f + 1usize;
  }
}

// Whether a place leaves everything where it is, exactly
fn isIdentity(t Transform3) bool {
  t.translation.x == 0. and t.translation.y == 0. and t.translation.z == 0.
    and t.rotation.x == 0. and t.rotation.y == 0. and t.rotation.z == 0. and t.rotation.w == 1.
    and t.scale.x == 1. and t.scale.y == 1. and t.scale.z == 1.
}

// One part's values of a channel, added to 'values': the part's own channel
// of that name and domain, or the fill for each of its elements. A turned
// part's corner at half-edge h is the corner its prev ended at before.
fn appendFloats(values &mut List[f32], m &PolyMesh, domain u32, name &str, fill f32, flip bool) {
  let ch = m.findFloatChannel(domain, name);
  let n = m.domainSize(domain);
  var e = 0usize;
  while e < n {
    if ch == NoIndex { values.push(fill); }
    elif flip and domain == CornerDomain { values.push(m.float(ch, *m.hPrev[e])); }
    else { values.push(m.float(ch, u32.from(e))); }
    e = e + 1usize;
  }
}
fn appendVec2s(values &mut List[Vec2], m &PolyMesh, domain u32, name &str, fill Vec2, flip bool) {
  let ch = m.findVec2Channel(domain, name);
  let n = m.domainSize(domain);
  var e = 0usize;
  while e < n {
    if ch == NoIndex { values.push(fill); }
    elif flip and domain == CornerDomain { values.push(m.vec2(ch, *m.hPrev[e])); }
    else { values.push(m.vec2(ch, u32.from(e))); }
    e = e + 1usize;
  }
}
fn appendVec3s(values &mut List[Vec3], m &PolyMesh, domain u32, name &str, fill Vec3, flip bool) {
  let ch = m.findVec3Channel(domain, name);
  let n = m.domainSize(domain);
  var e = 0usize;
  while e < n {
    if ch == NoIndex { values.push(fill); }
    elif flip and domain == CornerDomain { values.push(m.vec3(ch, *m.hPrev[e])); }
    else { values.push(m.vec3(ch, u32.from(e))); }
    e = e + 1usize;
  }
}

// A mesh's channels of one type (0 f32, 1 Vec2, 2 Vec3), read by number
fn channelCount(m &PolyMesh, kind u32) usize {
  if kind == 0u32 { m.floats.len() } elif kind == 1u32 { m.vec2s.len() } else { m.vec3s.len() }
}
fn channelDomain(m &PolyMesh, kind u32, i usize) u32 {
  if kind == 0u32 { m.floats[i].domain } elif kind == 1u32 { m.vec2s[i].domain } else { m.vec3s[i].domain }
}
fn channelName(m &PolyMesh, kind u32, i usize) String {
  if kind == 0u32 { String.from(m.floats[i].name.view()) }
  elif kind == 1u32 { String.from(m.vec2s[i].name.view()) }
  else { String.from(m.vec3s[i].name.view()) }
}
fn channelNameIs(m &PolyMesh, kind u32, i usize, name &str) bool {
  if kind == 0u32 { m.floats[i].name.equals(name) }
  elif kind == 1u32 { m.vec2s[i].name.equals(name) }
  else { m.vec3s[i].name.equals(name) }
}
fn floatFill(m &PolyMesh, i usize) f32 {m.floats[i].fill}
fn vec2Fill(m &PolyMesh, i usize) Vec2 {m.vec2s[i].fill}
fn vec3Fill(m &PolyMesh, i usize) Vec3 {m.vec3s[i].fill}

fn kindName(kind u32) &str {
  if kind == 0u32 { "f32" } elif kind == 1u32 { "Vec2" } else { "Vec3" }
}
fn domainName(domain u32) &str {
  if domain == VertexDomain { "vertex" }
  elif domain == EdgeDomain { "edge" }
  elif domain == FaceDomain { "face" }
  else { "corner" }
}

// The start of a refusal's line: "part k's channel name (type, domain) is
// left out"
fn refusedLine(k usize, name &str, kind u32, domain u32) String {
  var s = String.from("part ");
  s.appendUInt(u64.from(k));
  s.append("'s channel ");
  s.append(name);
  s.append(" (");
  s.append(kindName(kind));
  s.append(", ");
  s.append(domainName(domain));
  s.append(") is left out");
  s
}
