// ======== Profile to solid ========
//
// Every operator here records, on each vertex, where it came from in the
// generator, as two f32 vertex channels (Blender's Spline Parameter kept by
// Capture Attribute), so a later step can still ask how far along the
// original line a point was after the shape has been bent, lathed or
// subdivided:
// - "along": how far the profile had travelled, 0 to 1: an extrusion's
//   ring i / segments, a sweep's arc length s / L, a lathe's angle as a
//   fraction of the whole, k / steps;
// - "around": where on the profile, 0 to 1, by the profile's length.
// They are the vertex form of the corner "uv" (a sweep's or an extrusion's
// (around, along), a lathe's (along, around)), but a vertex is shared by
// the faces about it, so on a closed loop the seam vertex can hold only one
// value: it gets 0 (the first ring, the first column, profile point 0),
// where the corners closing the loop have 1 in "uv". The corner "uv" stays
// the seam-correct form; a channel interpolated across a seam (subdivision's
// vertex rules there) blends 0 with values near 1. A cap makes no vertices of
// its own: its corners are the end rings', with their values (along 0 at the
// start, 1 at the end). A lathe's vertex on the axis, shared by every
// column, has along 0.

// Build a solid from rings of points: 'nr' rings of 'm' points each, ring by
// ring, point k of ring i at pos[i * m + k]. Neighbouring rings are joined
// by quads, and the first ring to the last when 'ringsClosed'; neighbouring
// points of a ring are joined, and the last to the first when
// 'profileClosed'. Quad (i, j) runs (i, j), (i, j + 1), (i + 1, j + 1),
// (i + 1, j), which faces outward when the profile runs counterclockwise
// about the direction the rings advance. With 'caps', and a closed profile
// between open ends, the first ring is closed by an n-gon facing back and
// the last by one facing forward. 'flip' reverses every face. us holds each
// profile point's u and then 1 (m + 1 values), or that for each ring in turn
// (nr (m + 1) values, a loft's rings each with their own); vs each ring's v
// and then 1. Vertex (i, j)'s "along" is vs[i] and its "around" ring i's
// u[j].
fn tube(pos &List[Vec3], m usize, nr usize, profileClosed bool, ringsClosed bool, caps bool, flip bool,
    us &List[f32], vs &List[f32], capStart &List[Vec2], capEnd &List[Vec2]) PolyMesh {
  mut along = List[f32].withCapacity(m * nr);
  mut around = List[f32].withCapacity(m * nr);
  mut r = 0usize;
  while r < nr {
    mut j = 0usize;
    while j < m {
      along.push(*vs[r]);
      around.push(ringU(us, m, r, j));
      j = j + 1usize;
    }
    r = r + 1usize;
  }
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut uvs = List[Vec2].empty();
  mut face = List[u32].empty();
  mut fuv = List[Vec2].empty();
  imm pClosed = profileClosed and m >= 3usize;
  imm rClosed = ringsClosed and nr >= 3usize;
  if m >= 2usize and nr >= 2usize {
    imm nb = if rClosed {nr;} else {nr - 1usize;};
    imm ns = if pClosed {m;} else {m - 1usize;};
    mut i = 0usize;
    while i < nb {
      imm i1 = (i + 1usize) % nr;
      imm v0 = *vs[i];
      imm v1 = *vs[i + 1usize];
      mut j = 0usize;
      while j < ns {
        imm j1 = (j + 1usize) % m;
        face.clear();
        fuv.clear();
        face.push(u32.from(i * m + j));
        fuv.push(new Vec2(ringU(us, m, i, j), v0));
        face.push(u32.from(i * m + j1));
        fuv.push(new Vec2(ringU(us, m, i, j + 1usize), v0));
        face.push(u32.from(i1 * m + j1));
        fuv.push(new Vec2(ringU(us, m, i1, j + 1usize), v1));
        face.push(u32.from(i1 * m + j));
        fuv.push(new Vec2(ringU(us, m, i1, j), v1));
        emitFace(&mut counts, &mut idx, &mut uvs, &face, &fuv, flip);
        j = j + 1usize;
      }
      i = i + 1usize;
    }
  }
  if caps and pClosed and !rClosed and nr >= 1usize {
    // The first ring seen from behind: its points the other way round
    face.clear();
    fuv.clear();
    mut j = m;
    while j > 0usize {
      j = j - 1usize;
      face.push(u32.from(j));
      fuv.push(*capStart[j]);
    }
    emitFace(&mut counts, &mut idx, &mut uvs, &face, &fuv, flip);
    face.clear();
    fuv.clear();
    j = 0usize;
    while j < m {
      face.push(u32.from((nr - 1usize) * m + j));
      fuv.push(*capEnd[j]);
      j = j + 1usize;
    }
    emitFace(&mut counts, &mut idx, &mut uvs, &face, &fuv, flip);
  }
  build(pos, &counts, &idx, uvs.view(), &along, &around);
}

// Ring r's u at profile point j (j = m the closing 1): from one list for
// every ring, or ring r's own
fn ringU(us &List[f32], m usize, r usize, j usize) f32 {
  if us.len() == m + 1usize {*us[j];} else {*us[r * (m + 1usize) + j];};
}

// Add one face, its corners and their uvs, reversed when 'flip'
fn emitFace(counts &mut List[u32], idx &mut List[u32], uvs &mut List[Vec2], face &List[u32], fuv &List[Vec2], flip bool) {
  imm n = face.len();
  counts.push(u32.from(n));
  mut k = 0usize;
  while k < n {
    imm s = if flip {n - 1usize - k;} else {k;};
    idx.push(*face[s]);
    uvs.push(*fuv[s]);
    k = k + 1usize;
  }
}

// The PolyMesh of the faces, with their corner uvs as the "uv" channel and
// each vertex's generator parameters as the "along" and "around" vertex
// channels
// (The uvs are lent as a slice, which the caller, whose list is its own, has taken the
// view of: a view taken here, of a list reached through a reference, would be handed to
// the mesh's methods beside the mesh's own lists, which nothing shows are not that one)
fn build(pos &List[Vec3], counts &List[u32], idx &List[u32], uvs &Array[Vec2], along &List[f32],
    around &List[f32]) PolyMesh {
  mut problems = List[String].empty();
  mut pm = PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems);
  imm ch = pm.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  pm.setCornerVec2s(ch, uvs);
  imm alongCh = pm.addFloatChannel(VertexDomain, "along", 0.);
  imm aroundCh = pm.addFloatChannel(VertexDomain, "around", 0.);
  mut v = 0usize;
  while v < along.len() {
    pm.setFloat(alongCh, u32.from(v), *along[v]);
    pm.setFloat(aroundCh, u32.from(v), *around[v]);
    v = v + 1usize;
  }
  pm;
}

// The profile, lying in the plane z = 0 (its x on x, its y on y), extruded
// along 'direction' in 'segments' equal steps (Blender's Extrude of a curve,
// or its Screw with no turn): segments + 1 rings of the profile's points,
// ring i moved by direction * i / segments, vertex i * m + j for ring i and
// profile point j. Neighbouring rings are joined by quads. With 'caps', a
// closed profile's two ends are closed by an n-gon each. Faces face outward
// when a closed profile runs counterclockwise, whichever side of the plane
// the direction points to. The v of ring i is i / segments.
pub fn extrude(profile &Profile, direction Vec3, segments u32, caps bool) PolyMesh {
  imm n = usize.from(if segments < 1u32 {1u32;} else {segments;});
  imm m = profile.points.len();
  mut pos = List[Vec3].withCapacity(m * (n + 1usize));
  mut vs = List[f32].withCapacity(n + 2usize);
  mut i = 0usize;
  while i <= n {
    imm f = f32.from(i) / f32.from(n);
    imm shift = direction * f;
    mut j = 0usize;
    while j < m {
      imm p = *profile.points[j];
      pos.push(new Vec3(p.x, p.y, 0.) + shift);
      j = j + 1usize;
    }
    vs.push(f);
    i = i + 1usize;
  }
  vs.push(1.);
  imm us = profileUs(profile);
  // Extruded towards -z, the profile is seen from behind: flip every face,
  // and the caps swap which end reads the texture mirrored
  imm flip = direction.z < 0.;
  imm capA = capUvs(profile, !flip);
  imm capB = capUvs(profile, flip);
  tube(&pos, m, n + 1usize, profile.closed, false, caps, flip, &us, &vs, &capA, &capB);
}

// The profile swept along the path (Blender's curve Bevel with a profile
// object, or Geometry Nodes' Curve to Mesh): at each path point the profile
// is placed in that point's rotation-minimizing frame (Path.frames), its x
// along the frame's normal and its y along its binormal, so vertex i * m + j
// is profile point j at path point i. The profile at distance s along a path
// of length L is first turned by twistAngle * s / L about the tangent
// (counterclockwise seen from ahead) and scaled by startScale + (endScale -
// startScale) * s / L, both in proportion to arc length ('sweepScaled',
// below, takes any function of arc length for the scale). The profile is not
// widened at the path's corners (no mitre): a path sampled finely from a
// curve does not need it.
//
// Neighbouring rings are joined by quads; a closed path joins its last ring
// to its first, so its twist should be a whole number of turns (or a
// symmetry of the profile) and its scales equal, or the last band shears.
// With 'caps', an open path's ends are closed by an n-gon each when the
// profile is closed. Faces face outward when a closed profile runs
// counterclockwise. The v of ring i is s / L, and the corners on a closed
// path's closing band that are at its first ring have v = 1.
pub fn sweep(profile &Profile, path &Path, twistAngle f32, startScale f32, endScale f32, caps bool) PolyMesh {
  imm dist = path.distances();
  imm total = path.length();
  mut scales = List[f32].withCapacity(dist.len());
  mut i = 0usize;
  while i < dist.len() {
    imm f = if total > 0. {*dist[i] / total;} else {0.;};
    scales.push(startScale + (endScale - startScale) * f);
    i = i + 1usize;
  }
  sweepRings(profile, path, twistAngle, caps, &scales);
}

// The same sweep with the profile's scale any function of arc length: the
// profile at distance s along a path of length L is scaled by scale(s / L)
// (as Blender's curve Taper object or Houdini's Sweep scale ramp does)
// rather than linearly, and turned by twistAngle * s / L. The function is
// asked once per path point, in order, so a rib or bulge finer than the
// path's spacing is lost: sample the path as finely as the scale varies. A
// closed path's closing band joins its last ring to its first, scale(0), so
// scale(1) should equal scale(0).
pub fn sweepScaled(profile &Profile, path &Path, twistAngle f32, caps bool, scale &fn(u f32) f32) PolyMesh {
  imm dist = path.distances();
  imm total = path.length();
  mut scales = List[f32].withCapacity(dist.len());
  mut i = 0usize;
  while i < dist.len() {
    imm f = if total > 0. {*dist[i] / total;} else {0.;};
    scales.push(scale(f));
    i = i + 1usize;
  }
  sweepRings(profile, path, twistAngle, caps, &scales);
}

// Both sweeps: ring i scaled by scales[i]
fn sweepRings(profile &Profile, path &Path, twistAngle f32, caps bool, scales &List[f32]) PolyMesh {
  imm frames = path.frames();
  imm dist = path.distances();
  imm total = path.length();
  imm m = profile.points.len();
  imm nr = frames.len();
  mut pos = List[Vec3].withCapacity(m * nr);
  mut vs = List[f32].withCapacity(nr + 1usize);
  mut i = 0usize;
  while i < nr {
    imm f = if total > 0. {*dist[i] / total;} else {0.;};
    imm scale = *scales[i];
    imm turn = twistAngle * f;
    imm fr = *frames[i];
    mut j = 0usize;
    while j < m {
      imm p = *profile.points[j];
      imm q = p.rotate(turn);
      pos.push(fr.place(q * scale));
      j = j + 1usize;
    }
    vs.push(f);
    i = i + 1usize;
  }
  vs.push(1.);
  imm us = profileUs(profile);
  imm capA = capUvs(profile, true);
  imm capB = capUvs(profile, false);
  tube(&pos, m, nr, profile.closed, path.closed, caps, false, &us, &vs, &capA, &capB);
}

// The profile revolved about an axis through the origin (Blender's Screw
// modifier with no screw offset; three.js's LatheGeometry): profile point
// (x, y) is x out from the axis and y along it, placed at x e + y a, where a
// is the unit axis and e the unit direction perpendicular to it nearest +x
// (nearest +y when the axis is x); it is turned about the axis by 'angle' in
// 'steps' equal steps. An angle of a whole turn (2 pi, within a
// ten-thousandth) closes the solid, with 'steps' columns; any other leaves it
// open, with steps + 1. A profile point on the axis (x = 0, within a
// millionth of the profile's size) is one vertex, not one per column, and
// the faces touching it are triangles; a profile edge along the axis makes
// no face. Faces face outward when a closed profile runs counterclockwise,
// or an open one runs up the axis on the +x side, and the angle is positive.
//
// Vertices are made profile point by profile point: an axis point's one
// vertex, or each column of the others, in order. u runs around, column k at
// k / steps, the closing corners of a whole turn at u = 1, and a corner on
// the axis at the middle of its face's u; v runs along the profile in
// proportion to its length.
pub fn lathe(profile &Profile, axis Vec3, angle f32, steps u32) PolyMesh {
  imm a = unit(axis);
  mut e = unit(new Vec3(1., 0., 0.) - a * a.x);
  if e.lengthSquared() < 0.5 { e = unit(new Vec3(0., 1., 0.) - a * a.y); }
  imm m = profile.points.len();
  imm nsteps = usize.from(if steps < 1u32 {1u32;} else {steps;});
  imm full = absf(angle) >= 2. * pi - 0.0001;
  imm cols = if full {nsteps;} else {nsteps + 1usize;};
  mut size f32 = 0.;
  mut j = 0usize;
  while j < m {
    imm p = *profile.points[j];
    if absf(p.x) > size { size = absf(p.x); }
    if absf(p.y) > size { size = absf(p.y); }
    j = j + 1usize;
  }
  imm eps = size * 0.000001;

  // The vertices, and where each profile point's begin; a column's "along"
  // is its angle's fraction, k / steps, and an axis vertex's 0
  imm vs = profileUs(profile);
  mut pos = List[Vec3].empty();
  mut along = List[f32].empty();
  mut around = List[f32].empty();
  mut base = List[u32].withCapacity(m);
  mut onAxis = List[bool].withCapacity(m);
  j = 0usize;
  while j < m {
    imm p = *profile.points[j];
    base.push(u32.from(pos.len()));
    if absf(p.x) <= eps {
      onAxis.push(true);
      pos.push(a * p.y);
      along.push(0.);
      around.push(*vs[j]);
    } else {
      onAxis.push(false);
      imm start = e * p.x + a * p.y;
      mut k = 0usize;
      while k < cols {
        imm q = Quat.angleAxis(angle * f32.from(k) / f32.from(nsteps), a);
        pos.push(q * start);
        along.push(f32.from(k) / f32.from(nsteps));
        around.push(*vs[j]);
        k = k + 1usize;
      }
    }
    j = j + 1usize;
  }

  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut uvs = List[Vec2].empty();
  mut face = List[u32].empty();
  mut fuv = List[Vec2].empty();
  imm pClosed = profile.closed and m >= 3usize;
  imm ns = if m < 2usize {0usize;} elif pClosed {m;} else {m - 1usize;};
  imm flip = angle < 0.;
  mut k = 0usize;
  while k < nsteps {
    imm k1 = (k + 1usize) % cols;
    imm u0 = f32.from(k) / f32.from(nsteps);
    imm u1 = f32.from(k + 1usize) / f32.from(nsteps);
    imm um = (f32.from(k) + 0.5) / f32.from(nsteps);
    j = 0usize;
    while j < ns {
      imm j1 = (j + 1usize) % m;
      imm axisA = *onAxis[j];
      imm axisB = *onAxis[j1];
      if !(axisA and axisB) {
        imm v0 = *vs[j];
        imm v1 = *vs[j + 1usize];
        imm ka = if axisA {0usize;} else {k;};
        imm ka1 = if axisA {0usize;} else {k1;};
        imm kb = if axisB {0usize;} else {k;};
        imm kb1 = if axisB {0usize;} else {k1;};
        face.clear();
        fuv.clear();
        // (k, j), (k + 1, j), (k + 1, j + 1), (k, j + 1), dropping the
        // corner that repeats an axis vertex
        face.push(*base[j] + u32.from(ka));
        fuv.push(new Vec2(if axisA {um;} else {u0;}, v0));
        if !axisA {
          face.push(*base[j] + u32.from(ka1));
          fuv.push(new Vec2(u1, v0));
        }
        face.push(*base[j1] + u32.from(kb1));
        fuv.push(new Vec2(if axisB {um;} else {u1;}, v1));
        if !axisB {
          face.push(*base[j1] + u32.from(kb));
          fuv.push(new Vec2(u0, v1));
        }
        emitFace(&mut counts, &mut idx, &mut uvs, &face, &fuv, flip);
      }
      j = j + 1usize;
    }
    k = k + 1usize;
  }
  build(&pos, &counts, &idx, uvs.view(), &along, &around);
}
