// ======== Exact ear clipping ========
//
// A polygon in the plane cut into triangles by clipping ears, every test an
// exact orientation (exact.cone), so the same polygon is cut the same way on
// every machine, and no triangle is flat or turned over when the polygon is
// simple. The booleans cut their input faces this way, and the pieces of a
// face that has holes.

// Cut the polygon whose corners are the points (xs[s], ys[s]) for s = 0 to
// n - 1, in order, counterclockwise, into n - 2 triangles, each three corner
// numbers counterclockwise, pushed to 'tris'. 'node' names each corner's
// point: two corners of one node (a keyhole's bridge, walked both ways) are
// one point, and neither blocks an ear at the other. An ear is a corner that
// turns left, strictly, whose triangle holds no other corner, not even on its
// sides; the search starts after corner 0 and moves on from each ear clipped,
// so a convex polygon is cut as a fan from corner 0. When no ear is left
// (the polygon not simple, or flat somewhere), a corner that does not turn
// right is clipped anyway, else any corner, so there are always n - 2
// triangles; the answer is then false.
fn earClip(xs: &List[f64], ys: &List[f64], node: &List[u32], tris: &mut List[u32]) bool {
  let n = xs.len();
  if n < 3usize { return n == 0usize; }
  var next = List[usize].withCapacity(n);
  var prev = List[usize].withCapacity(n);
  var i = 0usize;
  while i < n {
    next.push((i + 1usize) % n);
    prev.push((i + n - 1usize) % n);
    i = i + 1usize;
  }
  var good = true;
  var left = n;
  var cur = 1usize % n;
  while left > 3usize {
    // One round looking for an ear from cur
    var found = n;
    var c = cur;
    var k = 0usize;
    while k < left && found == n {
      if isExactEar(xs, ys, node, &next, *prev[c], c, *next[c]) { found = c; }
      c = *next[c];
      k = k + 1usize;
    }
    if found == n {
      good = false;
      // A corner that does not turn right, else the corner at cur
      c = cur;
      k = 0usize;
      while k < left && found == n {
        let p = *prev[c];
        let nx = *next[c];
        if *node[p] != *node[nx] && *node[p] != *node[c] && *node[c] != *node[nx]
            && orient2dSign(*xs[p], *ys[p], *xs[c], *ys[c], *xs[nx], *ys[nx]) >= 0i32 {
          found = c;
        }
        c = *next[c];
        k = k + 1usize;
      }
      if found == n { found = cur; }
    }
    let p = *prev[found];
    let nx = *next[found];
    tris.push(u32.from(p));
    tris.push(u32.from(found));
    tris.push(u32.from(nx));
    next.set(p, nx);
    prev.set(nx, p);
    left = left - 1usize;
    cur = nx;
  }
  let p = *prev[cur];
  let nx = *next[cur];
  tris.push(u32.from(p));
  tris.push(u32.from(cur));
  tris.push(u32.from(nx));
  if orient2dSign(*xs[p], *ys[p], *xs[cur], *ys[cur], *xs[nx], *ys[nx]) <= 0i32 { good = false; }
  good
}

// Whether corner c, between p and nx, is an ear
fn isExactEar(xs: &List[f64], ys: &List[f64], node: &List[u32], next: &List[usize], p: usize, c: usize, nx: usize) bool {
  let np = *node[p];
  let nc = *node[c];
  let nn = *node[nx];
  if np == nc || nc == nn || np == nn { return false; }
  let ax = *xs[p];
  let ay = *ys[p];
  let bx = *xs[c];
  let bY = *ys[c];
  let cx = *xs[nx];
  let cy = *ys[nx];
  if orient2dSign(ax, ay, bx, bY, cx, cy) <= 0i32 { return false; }
  // No other corner in the closed triangle
  var v = *next[nx];
  while v != p {
    let nv = *node[v];
    if nv != np && nv != nc && nv != nn {
      let vx = *xs[v];
      let vy = *ys[v];
      if orient2dSign(ax, ay, bx, bY, vx, vy) >= 0i32 && orient2dSign(bx, bY, cx, cy, vx, vy) >= 0i32
          && orient2dSign(cx, cy, ax, ay, vx, vy) >= 0i32 {
        return false;
      }
    }
    v = *next[v];
  }
  true
}

// A face's plane for cutting it: the axis its normal leans along most is
// dropped, and the other two taken in the order that keeps the face
// counterclockwise. 0 drops x, 1 y, 2 z; 'flip' swaps the two kept.
fn dropAxis(n: DVec3, axis: &mut u32, flip: &mut bool) {
  let ax = absd(n.x);
  let ay = absd(n.y);
  let az = absd(n.z);
  if az >= ax && az >= ay {
    *axis = 2u32;
    *flip = n.z < 0.0;
  } elif ay >= ax {
    *axis = 1u32;
    *flip = n.y < 0.0;
  } else {
    *axis = 0u32;
    *flip = n.x < 0.0;
  }
}

// A point in that plane: (y, z) dropping x, (z, x) dropping y, (x, y)
// dropping z, swapped when 'flip'
fn planeX(p: DVec3, axis: u32, flip: bool) f64 {
  let a = if axis == 0u32 {p.y} elif axis == 1u32 {p.z} else {p.x};
  let b = if axis == 0u32 {p.z} elif axis == 1u32 {p.x} else {p.y};
  if flip {b} else {a}
}
fn planeY(p: DVec3, axis: u32, flip: bool) f64 {
  let a = if axis == 0u32 {p.y} elif axis == 1u32 {p.z} else {p.x};
  let b = if axis == 0u32 {p.z} elif axis == 1u32 {p.x} else {p.y};
  if flip {a} else {b}
}

// Whether three points lie on one line, exactly: their triangle has no area
// in any of the three axis planes
fn collinear3(a: DVec3, b: DVec3, c: DVec3) bool {
  orient2dSign(a.x, a.y, b.x, b.y, c.x, c.y) == 0i32 && orient2dSign(a.y, a.z, b.y, b.z, c.y, c.z) == 0i32
    && orient2dSign(a.z, a.x, b.z, b.x, c.z, c.x) == 0i32
}

// Where point (px, py) is against the closed polygon of points (xs[s], ys[s])
// listed by 'cycle': 1 inside, -1 outside, 0 on its boundary; exactly, by
// the winding number
fn pointInPolygon(px: f64, py: f64, xs: &List[f64], ys: &List[f64], cycle: &List[u32]) i32 {
  let n = cycle.len();
  var wn = 0i32;
  var i = 0usize;
  while i < n {
    let a = usize.from(*cycle[i]);
    let b = usize.from(*cycle[(i + 1usize) % n]);
    let ax = *xs[a];
    let ay = *ys[a];
    let bx = *xs[b];
    let bY = *ys[b];
    if ax == px && ay == py { return 0i32; }
    if ay == py && bY == py {
      // A level side through the point's height: on it if between its ends
      if (ax <= px && px <= bx) || (bx <= px && px <= ax) { return 0i32; }
    } elif ay <= py && py < bY {
      let s = orient2dSign(ax, ay, bx, bY, px, py);
      if s == 0i32 { return 0i32; }
      if s > 0i32 { wn = wn + 1i32; }
    } elif bY <= py && py < ay {
      let s = orient2dSign(ax, ay, bx, bY, px, py);
      if s == 0i32 { return 0i32; }
      if s < 0i32 { wn = wn - 1i32; }
    }
    i = i + 1usize;
  }
  if wn != 0i32 {1i32} else {-1i32}
}

// Whether the closed segments a b and c d meet anywhere, exactly
fn segmentsMeet(ax: f64, ay: f64, bx: f64, bY: f64, cx: f64, cy: f64, dx: f64, dy: f64) bool {
  let d1 = orient2dSign(ax, ay, bx, bY, cx, cy);
  let d2 = orient2dSign(ax, ay, bx, bY, dx, dy);
  let d3 = orient2dSign(cx, cy, dx, dy, ax, ay);
  let d4 = orient2dSign(cx, cy, dx, dy, bx, bY);
  if d1 * d2 < 0i32 && d3 * d4 < 0i32 { return true; }
  if d1 == 0i32 && onSegment(ax, ay, bx, bY, cx, cy) { return true; }
  if d2 == 0i32 && onSegment(ax, ay, bx, bY, dx, dy) { return true; }
  if d3 == 0i32 && onSegment(cx, cy, dx, dy, ax, ay) { return true; }
  if d4 == 0i32 && onSegment(cx, cy, dx, dy, bx, bY) { return true; }
  false
}

// Whether p, known to lie on the line a b, lies between a and b inclusive
fn onSegment(ax: f64, ay: f64, bx: f64, bY: f64, px: f64, py: f64) bool {
  let minx = if ax < bx {ax} else {bx};
  let maxx = if ax < bx {bx} else {ax};
  let miny = if ay < bY {ay} else {bY};
  let maxy = if ay < bY {bY} else {ay};
  px >= minx && px <= maxx && py >= miny && py <= maxy
}
