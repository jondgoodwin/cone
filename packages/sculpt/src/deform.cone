// ======== Deformers ========
//
// Each moves the vertices of a PolyMesh and returns the result as a new
// PolyMesh: the same vertices, half-edges and faces in the same order, and
// every attribute channel carried over unchanged. 'displaceAlongNormal'
// moves each vertex along its normal by a channel's value; the others each
// work in a frame set by an origin and a unit direction 'along' (made unit
// here): a vertex's coordinate along it is t = (p - origin) . along, and the
// deformed span is the mesh's extent in t, from its least to its greatest.
// As in Barr (1984),
// the rate of bend, twist or taper is the amount over that span, and it acts
// on t measured from the origin, held to the span (t clamped to it): so the
// part of the mesh at the origin (t = 0) stays where it is, and a mesh whose
// origin is at one end is deformed from that end. A mesh with no extent
// along the direction, or an amount of 0, comes back unchanged.

// The least and greatest t over the mesh's vertices, as (x, y)
fn extentAlong(m: &PolyMesh, origin: Vec3, d: Vec3) Vec2 {
  if m.positions.len() == 0usize { return Vec2(0., 0.); }
  var lo = (*m.positions[0usize] - origin).dot(d);
  var hi = lo;
  var i = 1usize;
  while i < m.positions.len() {
    let t = (*m.positions[i] - origin).dot(d);
    if t < lo { lo = t; }
    if t > hi { hi = t; }
    i = i + 1usize;
  }
  Vec2(lo, hi)
}

// A PolyMesh with m's topology and channels and the given positions
fn withPositions(m: &PolyMesh, positions: List[Vec3]) PolyMesh {
  var floats = List[Channel[f32]].withCapacity(m.floats.len());
  var c = 0usize;
  while c < m.floats.len() {
    let len = m.floats[c].values.len();
    var values = List[f32].withCapacity(len);
    var k = 0usize;
    while k < len {
      values.push(*m.floats[c].values[k]);
      k = k + 1usize;
    }
    floats.push(Channel[f32](String.from(m.floats[c].name.view()), m.floats[c].domain, values, m.floats[c].fill));
    c = c + 1usize;
  }
  var vec2s = List[Channel[Vec2]].withCapacity(m.vec2s.len());
  c = 0usize;
  while c < m.vec2s.len() {
    let len = m.vec2s[c].values.len();
    var values = List[Vec2].withCapacity(len);
    var k = 0usize;
    while k < len {
      values.push(*m.vec2s[c].values[k]);
      k = k + 1usize;
    }
    vec2s.push(Channel[Vec2](String.from(m.vec2s[c].name.view()), m.vec2s[c].domain, values, m.vec2s[c].fill));
    c = c + 1usize;
  }
  var vec3s = List[Channel[Vec3]].withCapacity(m.vec3s.len());
  c = 0usize;
  while c < m.vec3s.len() {
    let len = m.vec3s[c].values.len();
    var values = List[Vec3].withCapacity(len);
    var k = 0usize;
    while k < len {
      values.push(*m.vec3s[c].values[k]);
      k = k + 1usize;
    }
    vec3s.push(Channel[Vec3](String.from(m.vec3s[c].name.view()), m.vec3s[c].domain, values, m.vec3s[c].fill));
    c = c + 1usize;
  }
  PolyMesh(positions, copyList[u32](&m.vHalfedge), copyList[u32](&m.hNext), copyList[u32](&m.hPrev),
    copyList[u32](&m.hVertex), copyList[u32](&m.hFace), copyList[u32](&m.fHalfedge), floats, vec2s, vec3s)
}

// A bend (Blender's Simple Deform, Bend; Barr's bend): the mesh's span along
// 'along' is curled through 'angle' about 'axis' (made perpendicular to
// along), turning along towards c = axis x along, as a right-handed turn
// about the axis does. With the span's length S, the bend's radius is
// R = S / angle, and its centre line runs parallel to the axis through
// origin + c R. A vertex at t along, c' across towards c and w along the
// axis, with T = t clamped to the span and theta = T / R, goes to
//     origin + along ((R - c') sin theta + (t - T) cos theta)
//            + c (R - (R - c') cos theta + (t - T) sin theta) + axis w:
// within the span, onto the arc of radius R - c' about the centre line at
// angle theta from the origin, so a straight line along the span through the
// origin becomes an arc of radius R, turning through 'angle', whose length
// is unchanged; outside the span, carried on straight along the tangent at
// the span's end. A negative angle bends towards -c.
pub fn bend(m: &PolyMesh, angle: f32, axis: Vec3, along: Vec3, origin: Vec3) PolyMesh {
  let d = unit(along);
  let ax = unit(axis - d * axis.dot(d));
  let c = ax.cross(d);
  let ext = extentAlong(m, origin, d);
  let span = ext.y - ext.x;
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    if span <= 0. || angle == 0. {
      out.push(p);
    } else {
      let r = span / angle;
      let q = p - origin;
      let t = q.dot(d);
      let cc = q.dot(c);
      let w = q.dot(ax);
      let tc = clampf(t, ext.x, ext.y);
      let theta = tc / r;
      let rest = t - tc;
      let sn = sin(theta);
      let cs = cos(theta);
      out.push(origin + d * ((r - cc) * sn + rest * cs) + c * (r - (r - cc) * cs + rest * sn) + ax * w);
    }
    i = i + 1usize;
  }
  withPositions(m, out)
}

// A twist (Blender's Simple Deform, Twist; Barr's twist): each vertex is
// turned about the line through origin along 'along' by angle * T / S, T its
// t clamped to the span and S the span's length, counterclockwise seen from
// the tip of 'along'. Over the whole span the turn changes by 'angle'; the
// cross-section at the origin does not turn.
pub fn twistAngle overload twist(m: &PolyMesh, angle: f32, along: Vec3, origin: Vec3) PolyMesh {
  let d = unit(along);
  let ext = extentAlong(m, origin, d);
  let span = ext.y - ext.x;
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    if span <= 0. || angle == 0. {
      out.push(p);
    } else {
      let q = p - origin;
      let t = q.dot(d);
      let theta = angle * clampf(t, ext.x, ext.y) / span;
      let rot = Quat.angleAxis(theta, d);
      out.push(origin + d * t + rot * (q - d * t));
    }
    i = i + 1usize;
  }
  withPositions(m, out)
}

// A taper (Blender's Simple Deform, Taper; Barr's taper): each vertex's
// offset from the line through origin along 'along' is scaled by
// 1 + factor * T / S, T its t clamped to the span and S the span's length;
// its t is unchanged. Over the whole span the scale changes by 'factor': a
// mesh along from its origin with factor 1 ends twice as wide, and with
// factor -1 comes to a point.
pub fn taperFactor overload taper(m: &PolyMesh, factor: f32, along: Vec3, origin: Vec3) PolyMesh {
  let d = unit(along);
  let ext = extentAlong(m, origin, d);
  let span = ext.y - ext.x;
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    if span <= 0. || factor == 0. {
      out.push(p);
    } else {
      let q = p - origin;
      let t = q.dot(d);
      let s = 1. + factor * clampf(t, ext.x, ext.y) / span;
      out.push(origin + d * t + (q - d * t) * s);
    }
    i = i + 1usize;
  }
  withPositions(m, out)
}

// A displacement along the normals by a stored channel (Blender's Displace
// modifier in Normal direction, its strength 'amount' and its texture a
// vertex channel): each vertex moves along its unit normal by amount times
// its value in the f32 vertex channel named, so a channel written earlier
// (a generator's "along" or "around", or one the caller filled) drives the
// shape: ribs, bulges, a flare. The normals are mesh's 'vertexNormals'
// (angle-weighted) of the mesh as given, all found before any vertex moves,
// so the result does not depend on visiting order. An empty name, or a
// channel the mesh does not have, counts 1 for every vertex: every vertex
// moves by 'amount' (Blender's Shrink/Fatten), as smoothing's weight does.
// An isolated vertex has no normal and stays.
pub fn displaceByChannel overload displaceAlongNormal(m: &PolyMesh, channelName: &str, amount: f32) PolyMesh {
  let ch = if channelName.len() > 0usize {m.findFloatChannel(VertexDomain, channelName)} else {NoIndex};
  let normals = m.vertexNormals();
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    let w = if ch != NoIndex {m.float(ch, u32.from(i))} else {1.};
    out.push(*m.positions[i] + *normals[i] * (amount * w));
    i = i + 1usize;
  }
  withPositions(m, out)
}

// A curve deform (Blender's Curve modifier): the mesh laid along the path. A
// vertex at t along 'along' from the origin, x across and y up (up made
// perpendicular to along, and across = up x along, so across, up, along is
// right-handed as a frame's normal, binormal, tangent are) goes to the
// point at distance t along the path, placed in the frame there as a
// profile point (x, y) is: frame origin + normal x + binormal y. The frames
// are the path's rotation-minimizing ones (Path.frames), blended between
// path points. The mesh is not stretched to the path's length: past an open
// path's ends it carries on straight along the end tangents, and along a
// closed path it wraps round. Put the origin at the end of the mesh that
// should sit at the path's start.
pub fn curveDeform(m: &PolyMesh, path: &Path, along: Vec3, up: Vec3, origin: Vec3) PolyMesh {
  let d = unit(along);
  let u = unit(up - d * up.dot(d));
  let s = u.cross(d);
  let frames = path.frames();
  let dist = path.distances();
  let total = path.length();
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    if frames.len() == 0usize {
      out.push(p);
    } else {
      let q = p - origin;
      let f = frameAtDistance(path, &frames, &dist, total, q.dot(d));
      out.push(f.place(Vec2(q.dot(s), q.dot(u))));
    }
    i = i + 1usize;
  }
  withPositions(m, out)
}

// ======== Deformers fed by a function ========
//
// Each takes the rule as a function, written at the call as a closure
// ('p => p * 2.', or the full form when it needs state of its own) or named
// as a plain function ('&ease'). The function is a generic parameter, so each
// distinct one is compiled into its own copy of the loop and the call is
// inlined: the rule is asked once per vertex at no more than the cost of
// writing it by hand. The number-taking deformers above stay beside them.
// A closure borrows what its body names, so a dial is simply a variable in
// scope, and it may read the very mesh it deforms (the mesh is only read
// while the deformer runs, and the result is a new one). The rule is a pure
// function of its argument: it is asked in vertex order, but nothing may
// depend on that. These are CPU-only.
//
// For the three that work along an axis, a vertex's place is u, the fraction
// of the mesh's own extent along the axis: its t = (p - origin) . along as a
// fraction between the least t (u = 0) and the greatest (u = 1) over the mesh,
// so u needs no origin, and a mesh with no extent along the axis has u = 0
// throughout.

// A general deformer (Blender's Set Position): every vertex goes to f(p), p
// its position. A noise displacement, a wave, a cast to a sphere, a domain
// warp are each a choice of f.
pub fn deform[F: fn(p: Vec3) Vec3](m: &PolyMesh, f: &F) PolyMesh {
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    out.push(f(*m.positions[i]));
    i = i + 1usize;
  }
  withPositions(m, out)
}

// A deformer whose rule is a function of the place along an axis: every
// vertex is moved by the offset f(u) (a shear, a sway, a swell off to one
// side; for a scale or a turn about the axis, 'taper' and 'twist' given a
// function). The
// axis 'along' is made unit.
pub fn deformAlong[F: fn(u: f32) Vec3](m: &PolyMesh, along: Vec3, f: &F) PolyMesh {
  let d = unit(along);
  let ext = extentAlong(m, Vec3(0., 0., 0.), d);
  let span = ext.y - ext.x;
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    let u = if span > 0. {(p.dot(d) - ext.x) / span} else {0.};
    out.push(p + f(u));
    i = i + 1usize;
  }
  withPositions(m, out)
}

// A taper whose scale is any function of the place along the axis, given in
// place of the factor: each vertex's offset from the line through origin along
// 'along' is scaled by scaleAt(u), its t unchanged. 'taper' by a factor is
// scaleAt = u => 1 + factor u when the origin is at the mesh's least t.
pub fn taperBy[F: fn(u: f32) f32] overload taper(m: &PolyMesh, scaleAt: &F, along: Vec3, origin: Vec3) PolyMesh {
  let d = unit(along);
  let ext = extentAlong(m, origin, d);
  let span = ext.y - ext.x;
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    let q = p - origin;
    let t = q.dot(d);
    let u = if span > 0. {(t - ext.x) / span} else {0.};
    out.push(origin + d * t + (q - d * t) * scaleAt(u));
    i = i + 1usize;
  }
  withPositions(m, out)
}

// A twist whose turn is any function of the place along the axis, given in
// place of the angle: each vertex is turned about the line through origin along 'along' by
// angleAt(u) radians, counterclockwise seen from the tip of 'along'.
pub fn twistBy[F: fn(u: f32) f32] overload twist(m: &PolyMesh, angleAt: &F, along: Vec3, origin: Vec3) PolyMesh {
  let d = unit(along);
  let ext = extentAlong(m, origin, d);
  let span = ext.y - ext.x;
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    let q = p - origin;
    let t = q.dot(d);
    let u = if span > 0. {(t - ext.x) / span} else {0.};
    let rot = Quat.angleAxis(angleAt(u), d);
    out.push(origin + d * t + rot * (q - d * t));
    i = i + 1usize;
  }
  withPositions(m, out)
}

// A displacement along the normals whose amount is a function of the vertex,
// given in place of a channel the caller filled first and its amount:
// each vertex moves along its unit normal by amountAt(k), k its index. The
// function reads whatever it likes of vertex k, by capturing the mesh: its
// position ('m.positions'), a channel ('m.float(ch, k)'), or a dial in
// scope. The normals are those of the mesh as given, all found before any
// vertex moves. An isolated vertex has no normal and stays.
pub fn displaceAlongNormalBy[F: fn(k: u32) f32] overload displaceAlongNormal(m: &PolyMesh, amountAt: &F) PolyMesh {
  let normals = m.vertexNormals();
  let n = m.positions.len();
  var out = List[Vec3].withCapacity(n);
  var i = 0usize;
  while i < n {
    out.push(*m.positions[i] + *normals[i] * amountAt(u32.from(i)));
    i = i + 1usize;
  }
  withPositions(m, out)
}
