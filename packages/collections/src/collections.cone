// The collections package: a growable list, an owned string, a dictionary of
// any keys that are Hash (and an ordered one, which visits in insertion order),
// a set, and a double-ended queue, each holding its elements in one block of memory
// that it gets, grows and gives back through the C allocator ('libc.malloc',
// 'realloc', 'free'). Built as Congo needs them, and no further.
//
//   mod names;
//   import collections use *;
//
//   fn main() {
//     mut seen = new List[String] <- String.from("core");
//     seen.push(String.from("stdio"));
//     mut counts = new Dict[String, i64] <- String.from("core"): 1;
//     if counts.contains("core") { ... *counts["core"] ... }
//   }
//
// Each collection is a region in the type sense: the value itself is small (a
// pointer to its block, a count, a capacity) and lives wherever it is put --
// on the stack, in a field, in another collection, or behind a 'So' or 'Rc'
// owner -- while its elements live inline in the block it owns. When the
// collection dies, its 'final' finalizes each element still in it, first to
// last, and then frees the block. Nothing here goes through 'So' or 'Rc'.
//
// Moving values in and out of the block is done with core's 'mem' intrinsics:
// 'mem.writeRaw' moves a value into a slot that holds nothing live,
// 'mem.readRaw' moves one out and leaves the slot dead, and 'mem.finalize'
// runs a value's death where it sits. That is why a slot beyond the count
// never has its garbage released or finalized.
//
// Borrowed references, for now: a collection lends out borrows only for brief
// reading. 'list[i]' and 'dict[key]' give a '&' to one element, and 'view()'
// a slice of the whole, to read at once and let go of; '&mut list[i]' and
// 'viewMut()' lend the same for changing in place, and while one is used the
// collection may not be touched any other way. Nothing here stores a
// borrow, and nothing a collection returns should be kept across a change to
// it: a push can move the whole block. The compiler catches that for a
// collection held in a local -- while 'imm e = list[0usize]' is still used,
// 'list' may be read but not pushed onto -- but not for one reached through a
// shared path (a '&mut List' parameter, a field of 'self', a 'Rc[mut, T]'
// owner), where a push through another reference to it leaves 'e' dangling.
// Each type here declares 'ShapeChanging' (a provisional name), which the
// check refusing that will read; nothing reads it yet. Where a borrow would
// have been the natural return
// (a trimmed piece of a string, the lines of a text), the collection returns
// owned copies instead. (A dictionary's 'get' and its cursors 'keys', 'values'
// and 'entries' do lend borrows, and the compiler keeps a dictionary in a
// local loaned while one is used.)
//
// Threads: List, Deque, Dict, OrderedDict and Set declare 'Sendable', so a collection may be moved
// to another thread, or shared as 'Arc[imm, T]', where its elements may. The
// declaration is a promise the compiler takes on trust for the block's raw
// pointer, which it cannot check; an instance is Sendable only where its type
// arguments are, so a List[&mut Point] is not. A String is Sendable by its
// List[u8]. Nothing here is safe to change from two threads at once.
//
// A list or a dictionary is constructed with 'new': 'new List[i64]' has no
// block yet, 'new List[i64](100)' room for exactly 100, and the values it
// starts with follow '<-', each appended in turn: 'new List[i64](100) <- fill
// 0', 'new Dict[String, i64] <- String.from("a"): 1' (a dictionary's '<-'
// takes a key and a value, and inserts them). A function a type offers without
// a receiver makes one too: 'List[i64].empty()', 'List[i64].withCapacity(n)'
// (never less than 4), 'String.from("text")'.
//
// Methods take their receiver as '&' or '&mut'; calling one on a variable
// borrows the variable for the call ('list.push(x)' is '(&mut list).push(x)').
//
// Every method of a generic type is compiled for every instance, whether it is
// called or not, so no method here may assume anything of an element type that
// a move-only type such as String would fail: a list has no 'get' copying an
// element out (a dictionary's 'getCopy' exists only where its value type
// copies). Read one through 'list[i]'; move one out with 'pop' or 'remove'.
// An element left inside an Option one of them returns is finalized with it.
//
// An index out of range, or a key a dictionary does not hold, is a program
// error, and a panic.
//
// What a collection can do is named by a few small traits at the end of this file,
// 'Collection', 'Indexed', 'Stack', 'Queue', 'Map' and 'SetAlgebra', which the
// collections meet by their methods' names alone.

mod collections;

import libc;

// -------- List --------

// A growable list of T, in one block of 'cap' slots of which the first 'used'
// hold live values. Pushing grows it 4, 8, 16, ...; it never shrinks, and
// gives its block back only when it dies.
pub struct List[T] is ShapeChanging, Sendable {
  ptr *T;
  used usize;
  cap usize;

  // An empty list, 'new List[i32]': no block until the first value arrives
  pub fn initEmpty overload init(self &new) { *self = new List(null, 0usize, 0usize); }

  // An empty list whose block has room for exactly n values, 'new List[i32](100)',
  // which is what its contents' 'fill' fills: 'new List[i32](100) <- fill 0'
  pub fn initCapacity overload init(self &new, n usize) {
    *self = new List(null, 0usize, 0usize);
    if n > 0usize {
      self.ptr = libc.realloc(self.ptr as *u8, n * mem.sizeof[T]()) as *T;
      self.cap = n;
    }
  }

  // An empty list: no block until the first value arrives
  pub fn empty() List { new List(null, 0usize, 0usize); }

  // An empty list whose block already has room for n values
  pub fn withCapacity(n usize) List {
    mut l = new List(null, 0usize, 0usize);
    l.reserve(n);
    l;
  }

  // How many values it holds, and how many its block has room for
  pub fn len(self &) usize { used; }
  pub fn capacity(self &) usize { cap; }
  pub fn isEmpty(self &) bool { used == 0usize; }

  // Make room for 'more' values beyond those it holds. A block too small is
  // replaced by one twice its size, or exactly big enough if that is more,
  // and never smaller than 4. The block may move: every borrow into it, and
  // every slice from 'view', is then stale.
  pub fn reserve(self &mut, more usize) {
    if used + more <= cap { return; }
    mut want = cap * 2usize;
    if want < used + more { want = used + more; }
    if want < 4usize { want = 4usize; }
    ptr = libc.realloc(ptr as *u8, want * mem.sizeof[T]()) as *T;
    cap = want;
  }

  // Move a value in at the end
  pub fn push(self &mut, value T) {
    self.reserve(1usize);
    mem.writeRaw(ptr + used, value);
    used = used + 1usize;
  }

  // 'list <- value' is 'list.push(value)'
  pub fn append overload `<-`(self &mut, value T) { self.push(value); }

  // Move the last value out, or None when it is empty
  pub fn pop(self &mut) Option[T] {
    if used == 0usize { return None[T][]; }
    used = used - 1usize;
    Some[T][mem.readRaw(ptr + used)];
  }

  // A borrow of the last value, for reading it now, or None when it is empty:
  // what 'pop' would move out, left where it is (the Stack trait's 'peek')
  pub fn peek(self &) Option[&T] {
    if used == 0usize { return None[&T][]; }
    Some[&T][(ptr + (used - 1usize)) as &T];
  }

  // A borrow of the value at index, or None when index is out of range: the
  // lookup that does not panic (the Indexed trait's 'get')
  pub fn get(self &, index usize) Option[&T] {
    if index >= used { return None[&T][]; }
    Some[&T][(ptr + index) as &T];
  }

  // A borrow of the value at index, for reading it now. Each of these four
  // reports an index out of range at the line of its caller, which its
  // 'file' and 'line' default to
  pub fn `[]`(self &, index usize, file &[]u8 = srcFile(), line u32 = srcLine()) &T {
    if index >= used { outOfRange(index, used, file, line); }
    (ptr + index) as &T;
  }

  // A mutable borrow of the value at index, for changing it in place:
  // '&mut list[i]'
  pub fn `&[]`(self &mut, index usize, file &[]u8 = srcFile(), line u32 = srcLine()) &mut T {
    if index >= used { outOfRange(index, used, file, line); }
    (ptr + index) as &mut T;
  }

  // Put value at index, finalizing the value it replaces
  pub fn set(self &mut, index usize, value T, file &[]u8 = srcFile(), line u32 = srcLine()) {
    if index >= used { outOfRange(index, used, file, line); }
    mem.finalize(ptr + index);
    mem.writeRaw(ptr + index, value);
  }

  // Exchange the values at two indexes
  pub fn swap(self &mut, a usize, b usize, file &[]u8 = srcFile(), line u32 = srcLine()) {
    if a >= used { outOfRange(a, used, file, line); }
    if b >= used { outOfRange(b, used, file, line); }
    if a == b { return; }
    imm held = mem.readRaw(ptr + a);
    mem.moveRaw(ptr + a, ptr + b, 1usize);
    mem.writeRaw(ptr + b, held);
  }

  // Finalize every value, first to last, and keep the block for reuse
  pub fn clear(self &mut) {
    self.finalizeAll();
    used = 0usize;
  }

  // Shorten it to n values, finalizing each one dropped, first to last, and
  // keeping the block. A list of n values or fewer is left as it is.
  pub fn truncate(self &mut, n usize) {
    if n >= used { return; }
    if mem.needsFinal[T]() {
      mut i = n;
      while i < used { mem.finalize(ptr + i); i = i + 1usize; }
    }
    used = n;
  }

  // Make it exactly n values long. A longer list is truncated: the values
  // beyond n are finalized, first to last. A shorter one grows, each new value
  // a copy of 'value', and the block may move, as for 'reserve'. Only a type
  // whose values copy can fill the new places, so a type with a finalizer
  // (a move type) is shortened with 'truncate' instead.
  //
  // This, 'viewMut' and 'truncate' are how a C function fills a list: resize
  // it to the count the function was told it may write, hand it 'viewMut()',
  // and truncate to the count the function says it wrote.
  pub fn resize(self &mut, n usize, value T) where T is Copy {
    if n <= used { self.truncate(n); return; }
    self.reserve(n - used);
    while used < n {
      mem.writeRaw(ptr + used, value);
      used = used + 1usize;
    }
  }

  // A slice of every value it holds, for reading them now
  pub fn view(self &) &[]T { mem.sliceFromParts(ptr, used); }

  // A mutable slice of every value it holds, for changing them in place:
  // what a function that fills a slice writes into, a C function included.
  // The list stays borrowed mutably while the slice is used, so nothing else
  // may read or change it until the slice's last use
  pub fn viewMut(self &mut) &[]mut T { mem.sliceFromPartsMut(ptr, used); }

  // Put its values in order: 'order(a, b)' is negative when a goes before b,
  // positive when after, and 0 when either may go first, as 'compare' and
  // 'bytesCompare' answer. The sort is stable: values that order calls equal
  // keep the order they had. A merge sort, n log n comparisons, through a
  // second block as big as the list's, given back before it returns.
  // 'names.sortBy(&byName)', with 'fn byName(a &String, b &String) i32'.
  pub fn sortBy(self &mut, order &fn(a &T, b &T) i32) {
    if used < 2usize { return; }
    imm spare = libc.malloc(used * mem.sizeof[T]()) as *T;
    // Each pass merges runs of 'width' values from one block into the other
    mut from = ptr;
    mut to = spare;
    mut width = 1usize;
    while width < used {
      mut lo = 0usize;
      while lo < used {
        imm mid = if lo + width < used {lo + width;} else {used;};
        imm hi = if mid + width < used {mid + width;} else {used;};
        mut a = lo;
        mut b = mid;
        mut k = lo;
        // The right run's value goes first only when it is strictly before
        while a < mid and b < hi {
          if order((from + b) as &T, (from + a) as &T) < 0i32 {
            mem.moveRaw(to + k, from + b, 1usize);
            b = b + 1usize;
          }
          else {
            mem.moveRaw(to + k, from + a, 1usize);
            a = a + 1usize;
          }
          k = k + 1usize;
        }
        mem.moveRaw(to + k, from + a, mid - a);
        mem.moveRaw(to + k + (mid - a), from + b, hi - b);
        lo = hi;
      }
      imm was = from;
      from = to;
      to = was;
      width = width * 2usize;
    }
    if from != ptr { mem.moveRaw(ptr, from, used); }
    libc.free(spare as *u8);
  }

  fn finalizeAll(self &mut) {
    if mem.needsFinal[T]() {
      mut i = 0usize;
      while i < used { mem.finalize(ptr + i); i = i + 1usize; }
    }
  }

  // Its death: each value it holds, first to last, then the block
  fn final(self &uni) {
    self.finalizeAll();
    libc.free(ptr as *u8);
  }
}

// -------- Deque --------

// A double-ended queue of T: a growable ring buffer (Rust's VecDeque). Its values
// sit in one block of 'cap' slots, as a circle: the first value is in slot
// 'head', the next after it, and so on round past the block's end to its start,
// 'used' of them in all. That makes a push or a pop at either end O(1), where a
// List can take a value off its front only by moving every other one down; and a
// value is reached by its position from the front, 'deque[i]', one addition and
// a compare more than a List's. Growing makes a block twice the size and moves
// the values into it in order, the front one in slot 0, which is the only time
// they move, and it never shrinks. 'push' and 'pop' work at the back, as a
// List's do; 'pushFront' and 'popFront' at the front. So a Deque is a Stack
// (at its back) and a Queue (in at the back, out at the front).
//
// Its values do not lie in one run of memory when they wrap round the block's
// end, so there is no 'view' of them: walk them with 'items', or by position.
// A borrow from a lookup or a cursor is good only until the deque next changes.
pub struct Deque[T] is ShapeChanging, Sendable {
  ptr *T;
  head usize;    // the slot of the first value
  used usize;
  cap usize;

  // An empty deque, 'new Deque[i32]': no block until the first value arrives
  pub fn initEmpty overload init(self &new) { *self = new Deque(null, 0usize, 0usize, 0usize); }

  // An empty deque whose block has room for exactly n values, 'new Deque[i32](100)'
  pub fn initCapacity overload init(self &new, n usize) {
    *self = new Deque(null, 0usize, 0usize, 0usize);
    if n > 0usize {
      self.ptr = libc.malloc(n * mem.sizeof[T]()) as *T;
      self.cap = n;
    }
  }

  // An empty deque: no block until the first value arrives
  pub fn empty() Deque { new Deque(null, 0usize, 0usize, 0usize); }

  // An empty deque whose block already has room for n values
  pub fn withCapacity(n usize) Deque {
    mut d = new Deque(null, 0usize, 0usize, 0usize);
    d.reserve(n);
    d;
  }

  // How many values it holds, and how many its block has room for
  pub fn len(self &) usize { used; }
  pub fn capacity(self &) usize { cap; }
  pub fn isEmpty(self &) bool { used == 0usize; }

  // Make room for 'more' values beyond those it holds. A block too small is
  // replaced by one twice its size, or exactly big enough if that is more, and
  // never smaller than 4; the values move into it with the first in slot 0.
  // Every borrow into the old block is then stale.
  pub fn reserve(self &mut, more usize) {
    if used + more <= cap { return; }
    mut want = cap * 2usize;
    if want < used + more { want = used + more; }
    if want < 4usize { want = 4usize; }
    self.regrow(want);
  }

  // Move a value in at the back
  pub fn push(self &mut, value T) {
    self.reserve(1usize);
    mem.writeRaw(ptr + self.slot(used), value);
    used = used + 1usize;
  }

  // 'deque <- value' is 'deque.push(value)'
  pub fn append overload `<-`(self &mut, value T) { self.push(value); }

  // Move a value in at the front: it becomes position 0
  pub fn pushFront(self &mut, value T) {
    self.reserve(1usize);
    head = if head == 0usize {cap - 1usize;} else {head - 1usize;};
    mem.writeRaw(ptr + head, value);
    used = used + 1usize;
  }

  // Move the last value out, or None when it is empty
  pub fn pop(self &mut) Option[T] {
    if used == 0usize { return None[T][]; }
    used = used - 1usize;
    Some[T][mem.readRaw(ptr + self.slot(used))];
  }

  // Move the first value out, or None when it is empty
  pub fn popFront(self &mut) Option[T] {
    if used == 0usize { return None[T][]; }
    imm slot = head;
    head = if head + 1usize == cap {0usize;} else {head + 1usize;};
    used = used - 1usize;
    Some[T][mem.readRaw(ptr + slot)];
  }

  // A borrow of the last value, for reading it now, or None when it is empty
  pub fn peek(self &) Option[&T] {
    if used == 0usize { return None[&T][]; }
    Some[&T][(ptr + self.slot(used - 1usize)) as &T];
  }

  // A borrow of the first value, or None when it is empty
  pub fn peekFront(self &) Option[&T] {
    if used == 0usize { return None[&T][]; }
    Some[&T][(ptr + head) as &T];
  }

  // A borrow of the value at position index from the front, or None when index
  // is out of range
  pub fn get(self &, index usize) Option[&T] {
    if index >= used { return None[&T][]; }
    Some[&T][(ptr + self.slot(index)) as &T];
  }

  // A borrow of the value at position index from the front, for reading it
  // now. An index out of range is a panic at the line of the caller
  pub fn `[]`(self &, index usize, file &[]u8 = srcFile(), line u32 = srcLine()) &T {
    if index >= used { outOfRange(index, used, file, line); }
    (ptr + self.slot(index)) as &T;
  }

  // A mutable borrow of the value at position index, for changing it in place:
  // '&mut deque[i]'
  pub fn `&[]`(self &mut, index usize, file &[]u8 = srcFile(), line u32 = srcLine()) &mut T {
    if index >= used { outOfRange(index, used, file, line); }
    (ptr + self.slot(index)) as &mut T;
  }

  // Finalize every value, front to back, and keep the block for reuse
  pub fn clear(self &mut) {
    self.finalizeAll();
    head = 0usize;
    used = 0usize;
  }

  // A cursor over its values, front to back: 'next' gives a borrow of each in
  // turn until it answers None. The deque may not change while it is used.
  pub fn items(self &) DequeItems[T] { new DequeItems[T](self, 0usize); }

  // The slot of the value at position i, which may be the one just past the last
  // when the caller is about to fill it
  fn slot(self &, i usize) usize {
    imm s = head + i;
    if s >= cap {s - cap;} else {s;};
  }

  // A new block of 'want' slots (more than 'used') with every value moved into
  // it in order, the front one in slot 0. The old block holds up to two runs:
  // from 'head' to the block's end, and from its start round to the last value
  fn regrow(self &mut, want usize) {
    imm fresh = libc.malloc(want * mem.sizeof[T]()) as *T;
    if used > 0usize {
      imm firstRun = if head + used <= cap {used;} else {cap - head;};
      mem.moveRaw(fresh, ptr + head, firstRun);
      mem.moveRaw(fresh + firstRun, ptr, used - firstRun);
    }
    libc.free(ptr as *u8);
    ptr = fresh;
    head = 0usize;
    cap = want;
  }

  fn finalizeAll(self &mut) {
    if mem.needsFinal[T]() {
      mut i = 0usize;
      while i < used {
        mem.finalize(ptr + self.slot(i));
        i = i + 1usize;
      }
    }
  }

  // Its death: each value it holds, front to back, then the block
  fn final(self &uni) {
    self.finalizeAll();
    libc.free(ptr as *u8);
  }
}

// A cursor over a deque's values, front to back: 'next' gives a borrow of each
// in turn. It borrows the deque, which may not change while the cursor, or a
// value it gave, is used
pub struct DequeItems['a, T] {
  deque &'a Deque[T];
  pos usize;

  pub fn next(self &mut) Option[&'a T] {
    if pos >= deque.used { return None[&T][]; }
    imm i = pos;
    pos = i + 1usize;
    Some[&T][(deque.ptr + deque.slot(i)) as &T];
  }
}

// -------- String --------

// An owned, growable run of bytes: text, usually UTF-8, though nothing here
// looks at more than bytes. It is a List[u8] and no more, so it lives, moves
// and dies as a list does. A string literal is a '&[]u8', not a String; every
// method that reads text takes a '&[]u8', which a literal is and which 'view()'
// gives of a String, so 's.startsWith("import")' and 'a.equals(b.view())'.
pub struct String is ShapeChanging, Hash {
  bytes List[u8];

  pub fn empty() String { new String(List[u8].empty()); }

  pub fn withCapacity(n usize) String { new String(List[u8].withCapacity(n)); }

  // A String holding a copy of the bytes of s
  pub fn from(s &[]u8) String {
    mut str = String.withCapacity(s.len);
    str.append(s);
    str;
  }

  // A String holding a copy of the bytes of a C string, up to its NUL: what
  // a C function answers, or one of main's 'argv'. A null pointer is a
  // program error, a panic at the line of the caller.
  pub fn fromCStr(p *u8, file &[]u8 = srcFile(), line u32 = srcLine()) String {
    if p == null { panic("collections: a null pointer is not a C string", file, line); }
    String.from(mem.sliceFromParts(p, libc.strlen(p)));
  }

  // The views of 'parts' one after another, with 'sep' between each two:
  // 'String.join(names.view(), ", ")'. No parts make an empty String.
  pub fn join(parts &[]String, sep &[]u8) String {
    mut out = String.empty();
    mut i = 0usize;
    while i < parts.len {
      if i > 0usize { out.append(sep); }
      out.append(parts[i].view());
      i = i + 1usize;
    }
    out;
  }

  // A copy of this one. (Not 'clone': a method of that name is the lifecycle
  // method that makes a type's values copyable, which a String's are not.)
  pub fn copy(self &) String { String.from(self.view()); }

  pub fn len(self &) usize { bytes.len(); }
  pub fn isEmpty(self &) bool { bytes.len() == 0usize; }

  // Its bytes, for reading them now
  pub fn view(self &) &[]u8 { bytes.view(); }

  // Its bytes, for changing them in place (nothing checks they stay UTF-8)
  pub fn viewMut(self &mut) &[]mut u8 { bytes.viewMut(); }

  // The byte at index
  pub fn `[]`(self &, index usize) u8 { *bytes[index]; }

  // -------- adding to the end --------

  pub fn append overload `<-`(self &mut, s &[]u8) {
    bytes.reserve(s.len);
    mut i = 0usize;
    while i < s.len { bytes.push(s[i]); i = i + 1usize; }
  }

  pub fn appendByte(self &mut, b u8) { bytes.push(b); }

  // An integer in decimal, with a '-' before a negative one
  pub fn appendInt overload `<-`(self &mut, n i64) {
    if n < 0i64 {
      bytes.push('-');
      // The magnitude as a u64, which holds even the most negative i64's
      self.appendUInt(0u64 - u64.from(n));
    }
    else {
      self.appendUInt(u64.from(n));
    }
  }

  pub fn appendUInt overload `<-`(self &mut, n u64) {
    mut digits = new Array[u8, 20] <- fill 0u8;
    mut count = 0usize;
    mut rest = n;
    mut going = true;
    while going {
      digits[count] = u8.from(rest % 10u64) + '0';
      count = count + 1usize;
      rest = rest / 10u64;
      going = rest > 0u64;
    }
    while count > 0usize {
      count = count - 1usize;
      bytes.push(digits[count]);
    }
  }

  // The low 'width' hex digits of n, lowercase, leading zeros kept
  pub fn appendHex(self &mut, n u64, width usize) {
    mut d = width;
    while d > 0usize {
      d = d - 1usize;
      imm nibble = u8.from((n >> u64.from(d * 4usize)) & 15u64);
      bytes.push(if nibble < 10u8 {'0' + nibble;} else {'a' + nibble - 10u8;});
    }
  }

  // Every '\' made a '/', or any byte made another
  pub fn replaceByte(self &mut, from u8, to u8) {
    mut i = 0usize;
    while i < bytes.len() {
      if *bytes[i] == from { bytes.set(i, to); }
      i = i + 1usize;
    }
  }

  // Every 'from' made 'to', left to right, the pieces never overlapping:
  // "aaa" with "aa" made "b" is "ba". An empty 'from' is found before each
  // byte and at the end, so "ab" with "" made "-" is "-a-b-".
  pub fn replace(self &mut, from &[]u8, to &[]u8) {
    imm v = self.view();
    mut out = String.withCapacity(v.len);
    mut i = 0usize;
    if from.len == 0usize {
      while i < v.len { out.append(to); out.appendByte(v[i]); i = i + 1usize; }
      out.append(to);
    }
    else {
      while i < v.len {
        if i + from.len <= v.len and &v[i..i + from.len] == from {
          out.append(to);
          i = i + from.len;
        }
        else {
          out.appendByte(v[i]);
          i = i + 1usize;
        }
      }
    }
    *self = out;
  }

  // 'fill' bytes, spaces unless another is given, put before its bytes until
  // it is 'width' bytes long: "7" padded to 3 is "  7", which right-aligns
  // it. One that long already, or longer, is left as it is. Width counts
  // bytes, so a character beyond ASCII counts each of its UTF-8 bytes.
  pub fn padStart(self &mut, width usize, fill u8 = ' ') {
    if bytes.len() >= width { return; }
    mut out = String.withCapacity(width);
    mut n = width - bytes.len();
    while n > 0usize { out.appendByte(fill); n = n - 1usize; }
    out.append(self.view());
    *self = out;
  }

  // The same, put after its bytes: "ab" padded to 4 is "ab  ", which
  // left-aligns it
  pub fn padEnd(self &mut, width usize, fill u8 = ' ') {
    while bytes.len() < width { bytes.push(fill); }
  }

  // Each ASCII capital letter, A to Z, made small; every other byte, those
  // of characters beyond ASCII included, left as it is
  pub fn lowerAscii(self &mut) {
    mut i = 0usize;
    while i < bytes.len() {
      imm b = *bytes[i];
      bytes.set(i, asciiLower(b));
      i = i + 1usize;
    }
  }

  // Each ASCII small letter, a to z, made a capital; every other byte left
  pub fn upperAscii(self &mut) {
    mut i = 0usize;
    while i < bytes.len() {
      imm b = *bytes[i];
      bytes.set(i, asciiUpper(b));
      i = i + 1usize;
    }
  }

  // Empty it, keeping its block
  pub fn clear(self &mut) { bytes.clear(); }

  // -------- reading --------

  pub fn equals(self &, s &[]u8) bool { self.view() == s; }

  // Whether it holds the same bytes as s once ASCII letters are made one
  // case: "Path" equals "PATH" this way. Bytes beyond ASCII must match exactly.
  pub fn equalsIgnoreAsciiCase(self &, s &[]u8) bool {
    imm v = self.view();
    if v.len != s.len { return false; }
    mut i = 0usize;
    while i < v.len {
      if asciiLower(v[i]) != asciiLower(s[i]) { return false; }
      i = i + 1usize;
    }
    true;
  }

  // -1, 0 or 1 as it sorts before, with or after s, byte by byte, a shorter
  // string before a longer one it begins
  pub fn compare(self &, s &[]u8) i32 { bytesCompare(self.view(), s); }

  pub fn startsWith(self &, s &[]u8) bool {
    imm v = self.view();
    s.len <= v.len and &v[..s.len] == s;
  }

  pub fn endsWith(self &, s &[]u8) bool {
    imm v = self.view();
    s.len <= v.len and &v[v.len - s.len..] == s;
  }

  // Where s first starts in it, or None. An empty s is found at 0.
  pub fn find(self &, s &[]u8) Option[usize] { bytesFind(self.view(), s, 0usize); }

  // Where s first starts at or after 'from'
  pub fn findFrom(self &, s &[]u8, from usize) Option[usize] { bytesFind(self.view(), s, from); }

  pub fn contains(self &, s &[]u8) bool {
    match bytesFind(self.view(), s, 0usize) {
      case is Some[usize] {true;}
      case is None[usize] {false;}
    }
  }

  // Whether two hold the same bytes: the '==' that Hash requires of a type
  // beside its 'hash'
  pub fn eq overload `==`(self &, o &String) bool inline { self.view() == o.view(); }

  // What identifies it to a Hasher (core's Hash): its bytes, then the
  // terminator that marks where they end, so that as parts of one key ("ab",
  // "c") and ("a", "bc") differ. The same a byte slice feeds (Hasher.writeStr),
  // so a literal and a String of the same bytes hash alike
  pub fn hash(self &, h &mut Hasher) inline { h.writeStr(self.view()); }

  // -------- copies of parts --------

  // A copy of the bytes from 'start' up to, not including, 'end'
  pub fn sub(self &, start usize, end usize) String {
    imm v = self.view();
    String.from(&v[start..end]);
  }

  // A copy without the spaces, tabs, carriage returns and line feeds at
  // either end
  pub fn trim(self &) String {
    imm v = self.view();
    mut a = 0usize;
    mut b = v.len;
    while a < b and isSpace(v[a]) { a = a + 1usize; }
    while b > a and isSpace(v[b - 1usize]) { b = b - 1usize; }
    String.from(&v[a..b]);
  }

  // Copies of its lines. A line ends at '\n', and a '\r' just before it is
  // dropped; a last line need not end in '\n', and an ending '\n' does not
  // begin another line, so "a\nb\n" and "a\r\nb" are both two lines, and ""
  // is none.
  pub fn lines(self &) List[String] {
    imm v = self.view();
    mut out = List[String].empty();
    mut start = 0usize;
    mut i = 0usize;
    while i < v.len {
      if v[i] == '\n' {
        mut end = i;
        if end > start and v[end - 1usize] == '\r' { end = end - 1usize; }
        out.push(String.from(&v[start..end]));
        start = i + 1usize;
      }
      i = i + 1usize;
    }
    if start < v.len {
      mut end = v.len;
      if v[end - 1usize] == '\r' { end = end - 1usize; }
      out.push(String.from(&v[start..end]));
    }
    out;
  }

  // Copies of the pieces between each 'sep': "a,b,,c" is four pieces, the
  // third empty; "" is one empty piece
  pub fn split(self &, sep u8) List[String] {
    imm v = self.view();
    mut out = List[String].empty();
    mut start = 0usize;
    mut i = 0usize;
    while i < v.len {
      if v[i] == sep {
        out.push(String.from(&v[start..i]));
        start = i + 1usize;
      }
      i = i + 1usize;
    }
    out.push(String.from(&v[start..]));
    out;
  }

  // A pointer to its bytes with a NUL after them, for a C function. It is
  // good until the string next changes or dies; the NUL is not one of its
  // bytes.
  pub fn cstr(self &mut) *u8 {
    bytes.push(0u8);
    bytes.pop();
    bytes.view();
  }
}

// -------- Dict --------

// A dictionary from keys to values: a SwissTable, the open-addressed hash table
// of Google's Abseil, which Rust's HashMap (hashbrown) took. Its buckets are a
// power of two, and beside them is one control byte for each: empty (0xFF),
// removed (0x80, a key was there, so a search must go on past it), or full, the
// low 7 bits of which are the top 7 bits of the key's hash (its tag). A search
// reads the control bytes eight at a time, as one 64-bit word, and tells at once
// which of the eight have the tag it wants, and which are empty, with a few
// bitwise operations (hashbrown's portable form, with no SIMD: a SIMD type
// would test 16 at a time, and is the next step when the language has one).
// Only a bucket whose tag matches has its key compared, so a miss almost never
// touches an entry. The groups are probed in a triangular sequence, so every
// bucket is reached, and the table holds at most 7/8 of its buckets (full ones
// and removed ones together, so an empty bucket always ends a search), growing
// to double when it passes that.
//
// K is any type that is Hash (core's trait, which also requires its '=='), so
// ids, integers, structs and Strings all work: 'Dict[pool.Ref[T], V]',
// 'Dict[u64, V]', 'Dict[String, V]', a struct declared 'is Hash'. A lookup takes
// a '&K'. (A Dict[String, V] also takes the bytes of a key as a '&[]u8', so a
// literal or a view finds a String key without building one.)
//
// Each dictionary keeps a hasher of its own, started from a seed, and hashes a
// key by feeding it to a copy of that hasher. 'empty' takes the process's seed
// (core's 'Hasher.seeded'), random on every run, so the order of 'keys',
// 'values' and 'entries' is different on every run: sort them, or look a key
// up, and never rely on the order. 'deterministic' fixes the seed, and then the
// same keys inserted in the same order are visited in the same order on every
// run and build. Speed is the same either way.
//
// Entries are in one block with their control bytes after them, the block
// starting at 8 buckets (room for 7 entries) when the first entry arrives.
// Nothing here is safe to change from two threads at once, and a borrow from
// a lookup, a 'keys' cursor and the like is good only until the dictionary next
// changes: an insert may move every entry.

// One bucket's key and value: live only where its control byte says full
pub struct DictEntry[K, V] {
  pub key K;
  pub value V;
}

const ctrlEmpty = 0xFFu8;
const ctrlRemoved = 0x80u8;
const lowBytes = 0x0101010101010101u64;
const highBits = 0x8080808080808080u64;
// The fixed seed of 'deterministic': the first digits of pi
const fixedSeed = 0x243F6A8885A308D3u64;
// What a search answers when the key is not there
const noBucket = 0xFFFFFFFFFFFFFFFFusize;

// The 8 control bytes from pos on, as one word (the first byte is the lowest),
// read however pos is aligned. The last 8 control bytes copy the first 8, so a
// group that begins near the end wraps around
fn ctrlGroup(ctrl *u8, pos usize) u64 { mem.readRaw[u64]((ctrl + pos) as *u64); }

// Set bucket i's control byte, and its copy past the end if it is among the first 8
fn ctrlSet(ctrl *u8, mask usize, i usize, v u8) {
  mem.writeRaw[u8](ctrl + i, v);
  mem.writeRaw[u8](ctrl + (((i + mask + 1usize - 8usize) & mask) + 8usize), v);
}

// Make bucket i's control byte empty if no search can have gone past it (a
// full group around it that has an empty bucket on one side), else removed.
// It answers whether it became empty
fn ctrlErase(ctrl *u8, mask usize, i usize) bool {
  imm before = matchEmpty(ctrlGroup(ctrl, (i + mask + 1usize - 8usize) & mask));
  imm after = matchEmpty(ctrlGroup(ctrl, i));
  if (before.leadingZeros() >> 3u32) + (after.trailingZeros() >> 3u32) >= 8u32 {
    ctrlSet(ctrl, mask, i, ctrlRemoved);
    return false;
  }
  ctrlSet(ctrl, mask, i, ctrlEmpty);
  true;
}

// A flag (0x80) in each byte of g that holds t, and perhaps one that doesn't, in
// a byte just after one that does
fn matchTag(g u64, t u8) u64 {
  imm x = g ^ (lowBytes * u64.from(t));
  (x - lowBytes) & ~x & highBits;
}

// A flag in each byte of g that is empty
fn matchEmpty(g u64) u64 { g & (g << 1u64) & highBits; }

// A flag in each byte of g that is empty or removed
fn matchFree(g u64) u64 { g & highBits; }

// Which byte (0 to 7) the lowest flag in m is in
fn flagByte(m u64) usize { usize.from(m.trailingZeros() >> 3u32); }

// The tag of a hash: its top 7 bits
fn hashTag(hash u64) u8 { u8.from(hash >> 57u64); }

// The first empty or removed bucket in the probe sequence of hash. The table
// always has an empty bucket, so the search ends
fn freeBucket(ctrl *u8, mask usize, hash u64) usize {
  mut pos = usize.from(hash) & mask;
  mut stride = 0usize;
  while true {
    imm m = matchFree(ctrlGroup(ctrl, pos));
    if m != 0u64 { return (pos + flagByte(m)) & mask; }
    stride = stride + 8usize;
    pos = (pos + stride) & mask;
  }
  pos;
}

// How many entries a table of this many buckets (a power of two, 8 or more)
// holds, 7 in every 8 buckets
fn bucketsCapacity(buckets usize) usize { buckets / 8usize * 7usize; }

// The fewest buckets (a power of two, 8 or more) that hold n entries
fn capacityBuckets(n usize) usize {
  mut b = 8usize;
  while bucketsCapacity(b) < n { b = b * 2usize; }
  b;
}

pub struct Dict[K Hash, V] is ShapeChanging, Sendable {
  ctrl *u8;
  slots *DictEntry[K, V];
  mask usize;       // the buckets, less one
  items usize;      // how many hold entries
  left usize;       // how many more empty buckets may be filled before it grows
  hasher Hasher;    // starts every key's hash: the seed, mixed

  // An empty dictionary, 'new Dict[String, i64]': no block until the first entry
  // arrives. Its seed is the process's, so its order differs from run to run
  pub fn initEmpty overload init(self &new) {
    *self = new Dict(null, null, 0usize, 0usize, 0usize, Hasher.seeded());
  }

  pub fn empty() Dict { new Dict(null, null, 0usize, 0usize, 0usize, Hasher.seeded()); }

  // An empty dictionary with a fixed seed: the same keys inserted in the same
  // order are visited in the same order on every run
  pub fn deterministic() Dict { Dict.withSeed(fixedSeed); }

  // An empty dictionary with this seed: a key hashes to what 'Hasher.withSeed(seed)'
  // makes of what it feeds, and another seed shuffles the order
  pub fn withSeed(seed u64) Dict { new Dict(null, null, 0usize, 0usize, 0usize, Hasher.withSeed(seed)); }

  // How many entries it holds, and how many it holds before it next grows
  pub fn len(self &) usize { items; }
  pub fn capacity(self &) usize { items + left; }
  pub fn isEmpty(self &) bool { items == 0usize; }

  // Move key and value in. A key it already holds has its entry replaced:
  // the old key and value are finalized, and it answers true.
  pub fn insert(self &mut, key K, value V) bool {
    imm hash = self.hashOf(&key);
    imm found = self.freeOrFound(hash, &key);
    if self.isFull(found) {
      mem.finalize(slots + found);
      mem.writeRaw(slots + found, new DictEntry[K, V](key, value));
      return true;
    }
    self.fill(self.roomFor(hash, found), hash, key, value);
    false;
  }

  // 'dict <- key: value' is 'dict.insert(key, value)': a later value for a key
  // it holds replaces the earlier
  pub fn insertPair overload `<-`(self &mut, key K, value V) { self.insert(key, value); }

  // A borrow of key's value for changing it in place, which is how a count is
  // kept: the value already there, or else the one given, moved in, with
  // one search. A key and a value that were not needed die.
  //
  //   *counts.getOrInsert(word, 0) += 1;
  pub fn getOrInsert(self &mut, key K, value V) &mut V {
    imm hash = self.hashOf(&key);
    imm found = self.freeOrFound(hash, &key);
    if self.isFull(found) { return &mut slots[found].value; }
    imm i = self.roomFor(hash, found);
    self.fill(i, hash, key, value);
    &mut slots[i].value;
  }

  // Whether it holds key
  pub fn containsKey overload contains(self &, key &K) bool { self.find(self.hashOf(key), key) != noBucket; }

  // A borrow of key's value, for reading it now, or None
  pub fn getKey overload get(self &, key &K) Option[&V] {
    imm i = self.find(self.hashOf(key), key);
    if i == noBucket { return None[&V][]; }
    Some[&V][&slots[i].value];
  }

  // A borrow of key's value for changing it in place, or None
  pub fn getMutKey overload getMut(self &mut, key &K) Option[&mut V] {
    imm i = self.find(self.hashOf(key), key);
    if i == noBucket { return None[&mut V][]; }
    Some[&mut V][&mut slots[i].value];
  }

  // A copy of key's value, or None. This is the lookup that answers without a
  // borrow into the table, so it works through a shared owner, and it exists
  // only where V copies: a number, an id, a reference-counted owner
  pub fn getCopyKey overload getCopy(self &, key &K) Option[V] where V is Copy {
    imm i = self.find(self.hashOf(key), key);
    if i == noBucket { return None[V][]; }
    Some[V][slots[i].value];
  }

  // 'dict[&key]': a borrow of key's value. A key it does not hold is a program
  // error, a panic at the line of the caller: ask 'contains' first.
  pub fn indexKey overload `[]`(self &, key &K, file &[]u8 = srcFile(), line u32 = srcLine()) &V {
    imm i = self.find(self.hashOf(key), key);
    if i == noBucket { panic("collections: Dict has no entry for the key", file, line); }
    &slots[i].value;
  }

  // '&mut dict[&key]': a borrow of key's value for changing it, a panic as above
  pub fn indexMutKey overload `&[]`(self &mut, key &K, file &[]u8 = srcFile(), line u32 = srcLine()) &mut V {
    imm i = self.find(self.hashOf(key), key);
    if i == noBucket { panic("collections: Dict has no entry for the key", file, line); }
    &mut slots[i].value;
  }

  // Move key's value out and finalize the key it was held under, or None when it
  // holds no such key
  pub fn removeKey overload remove(self &mut, key &K) Option[V] {
    imm i = self.find(self.hashOf(key), key);
    if i == noBucket { return None[V][]; }
    self.take(i);
  }

  // The same for a Dict[String, V], given a key as bytes: a literal or a view of
  // some text finds the String it equals, with no String built. These stay until
  // a lookup by the body a key lends is built for every key type
  pub fn containsBytes overload contains(self &, key &[]u8) bool where K is String {
    self.findBytes(key) != noBucket;
  }

  pub fn getBytes overload get(self &, key &[]u8) Option[&V] where K is String {
    imm i = self.findBytes(key);
    if i == noBucket { return None[&V][]; }
    Some[&V][&slots[i].value];
  }

  pub fn getMutBytes overload getMut(self &mut, key &[]u8) Option[&mut V] where K is String {
    imm i = self.findBytes(key);
    if i == noBucket { return None[&mut V][]; }
    Some[&mut V][&mut slots[i].value];
  }

  pub fn getCopyBytes overload getCopy(self &, key &[]u8) Option[V] where K is String and V is Copy {
    imm i = self.findBytes(key);
    if i == noBucket { return None[V][]; }
    Some[V][slots[i].value];
  }

  // 'dict["name"]': a borrow of the value; a key it does not hold is a panic
  // that names the key
  pub fn indexBytes overload `[]`(self &, key &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) &V where K is String {
    imm i = self.findBytes(key);
    if i == noBucket { missingKey(key, file, line); }
    &slots[i].value;
  }

  pub fn indexMutBytes overload `&[]`(self &mut, key &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) &mut V where K is String {
    imm i = self.findBytes(key);
    if i == noBucket { missingKey(key, file, line); }
    &mut slots[i].value;
  }

  pub fn removeBytes overload remove(self &mut, key &[]u8) Option[V] where K is String {
    imm i = self.findBytes(key);
    if i == noBucket { return None[V][]; }
    self.take(i);
  }

  // Finalize every key and value, first bucket to last, and keep the block:
  // it holds nothing, with the room it had
  pub fn clear(self &mut) {
    if ctrl == null { return; }
    if mem.needsFinal[DictEntry[K, V]]() {
      mut i = 0usize;
      while i <= mask {
        if self.isFull(i) { mem.finalize(slots + i); }
        i = i + 1usize;
      }
    }
    libc.memset(ctrl, 255i32, mask + 1usize + 8usize);
    items = 0usize;
    left = bucketsCapacity(mask + 1usize);
  }

  // Cursors over what it holds, each giving a borrow into the table for reading
  // now, with 'next' until it answers None, in the table's order: different on
  // every run unless it was made with 'deterministic' or 'withSeed'. The table
  // may not change while one is used.
  pub fn keys(self &) DictKeys[K, V] { new DictKeys[K, V](self, 0usize); }
  pub fn values(self &) DictValues[K, V] { new DictValues[K, V](self, 0usize); }
  pub fn entries(self &) DictEntries[K, V] { new DictEntries[K, V](self, 0usize); }

  // The hash of a key: the key fed to this dictionary's hasher
  fn hashOf(self &, key &K) u64 {
    mut h = hasher;
    key.hash(&mut h);
    h.finish();
  }

  // Whether the bucket holds an entry (its control byte's top bit is clear)
  fn isFull(self &, i usize) bool { mem.readRaw[u8](ctrl + i) < ctrlRemoved; }

  // The bucket holding key, or noBucket
  fn find(self &, hash u64, key &K) usize {
    if items == 0usize { return noBucket; }
    imm t = hashTag(hash);
    mut pos = usize.from(hash) & mask;
    mut stride = 0usize;
    while true {
      imm g = ctrlGroup(ctrl, pos);
      mut m = matchTag(g, t);
      while m != 0u64 {
        imm i = (pos + flagByte(m)) & mask;
        if &slots[i].key == key { return i; }
        m = m & (m - 1u64);
      }
      if matchEmpty(g) != 0u64 { return noBucket; }
      stride = stride + 8usize;
      pos = (pos + stride) & mask;
    }
    noBucket;
  }

  // The bucket holding the String that holds these bytes, or noBucket: key is
  // hashed as a String feeds the hasher (its bytes, then the terminator)
  fn findBytes(self &, key &[]u8) usize where K is String {
    if items == 0usize { return noBucket; }
    mut h = hasher;
    h.writeStr(key);
    imm hash = h.finish();
    imm t = hashTag(hash);
    mut pos = usize.from(hash) & mask;
    mut stride = 0usize;
    while true {
      imm g = ctrlGroup(ctrl, pos);
      mut m = matchTag(g, t);
      while m != 0u64 {
        imm i = (pos + flagByte(m)) & mask;
        if slots[i].key.view() == key { return i; }
        m = m & (m - 1u64);
      }
      if matchEmpty(g) != 0u64 { return noBucket; }
      stride = stride + 8usize;
      pos = (pos + stride) & mask;
    }
    noBucket;
  }

  // One search for an insert: the bucket holding key, if there is one, else the
  // first empty or removed bucket in the probe sequence. The block is made
  // when there is none yet. Whether it found key is 'isFull'
  fn freeOrFound(self &mut, hash u64, key &K) usize {
    if ctrl == null { self.resize(8usize); }
    imm t = hashTag(hash);
    mut pos = usize.from(hash) & mask;
    mut stride = 0usize;
    mut spare = noBucket;
    while true {
      imm g = ctrlGroup(ctrl, pos);
      mut m = matchTag(g, t);
      while m != 0u64 {
        imm i = (pos + flagByte(m)) & mask;
        if &slots[i].key == key { return i; }
        m = m & (m - 1u64);
      }
      if spare == noBucket {
        imm free = matchFree(g);
        if free != 0u64 { spare = (pos + flagByte(free)) & mask; }
      }
      if matchEmpty(g) != 0u64 { return spare; }
      stride = stride + 8usize;
      pos = (pos + stride) & mask;
    }
    spare;
  }

  // The bucket a new entry goes in, given the free one the search found: the
  // table grows first (or is rebuilt at its size, when removed buckets are most
  // of what fills it) if the bucket is an empty one and none are left to fill
  fn roomFor(self &mut, hash u64, spare usize) usize {
    if left > 0usize or mem.readRaw[u8](ctrl + spare) != ctrlEmpty { return spare; }
    imm wanted = items + 1usize;
    imm buckets = mask + 1usize;
    self.resize(if wanted <= bucketsCapacity(buckets) / 2usize {buckets;} else {capacityBuckets(wanted);});
    freeBucket(ctrl, mask, hash);
  }

  // Move an entry into bucket i, which is free
  fn fill(self &mut, i usize, hash u64, key K, value V) {
    if mem.readRaw[u8](ctrl + i) == ctrlEmpty { left = left - 1usize; }
    ctrlSet(ctrl, mask, i, hashTag(hash));
    items = items + 1usize;
    mem.writeRaw(slots + i, new DictEntry[K, V](key, value));
  }

  // Remove the entry in bucket i: its key is finalized, its value moved out.
  // The bucket becomes empty if no search can have gone past it (a full group
  // around it that has an empty bucket on one side), else removed
  fn take(self &mut, i usize) Option[V] {
    if ctrlErase(ctrl, mask, i) { left = left + 1usize; }
    items = items - 1usize;
    // The value is read out of its bucket raw, since nothing moves out of a
    // field, and the key is finalized where it sits
    imm slot = (slots + i) as &mut DictEntry[K, V];
    mem.finalize(&slot.key as *K);
    Some[V][mem.readRaw(&slot.value as *V)];
  }

  // A new block of this many buckets, every entry moved into it by its hash
  fn resize(self &mut, buckets usize) {
    imm entrySize = mem.sizeof[DictEntry[K, V]]();
    imm base = libc.malloc(buckets * entrySize + buckets + 8usize);
    imm fresh = base + buckets * entrySize;
    libc.memset(fresh, 255i32, buckets + 8usize);
    imm freshSlots = base as *DictEntry[K, V];
    imm freshMask = buckets - 1usize;
    if ctrl != null {
      mut i = 0usize;
      while i <= mask {
        if self.isFull(i) {
          imm hash = self.hashOf(&slots[i].key);
          imm j = freeBucket(fresh, freshMask, hash);
          ctrlSet(fresh, freshMask, j, hashTag(hash));
          mem.moveRaw(freshSlots + j, slots + i, 1usize);
        }
        i = i + 1usize;
      }
      libc.free(slots as *u8);
    }
    ctrl = fresh;
    slots = freshSlots;
    mask = freshMask;
    left = bucketsCapacity(buckets) - items;
  }

  // Its death: each entry's key and value, first bucket to last, then the block
  fn final(self &uni) {
    if ctrl != null {
      if mem.needsFinal[DictEntry[K, V]]() {
        mut i = 0usize;
        while i <= mask {
          if mem.readRaw[u8](ctrl + i) < ctrlRemoved { mem.finalize(slots + i); }
          i = i + 1usize;
        }
      }
      libc.free(slots as *u8);
    }
  }
}

// The next full bucket at or after pos, or noBucket
fn nextFull(ctrl *u8, mask usize, pos usize) usize {
  if ctrl == null { return noBucket; }
  mut i = pos;
  while i <= mask {
    if mem.readRaw[u8](ctrl + i) < ctrlRemoved { return i; }
    i = i + 1usize;
  }
  noBucket;
}

// A cursor over a dictionary's keys: 'next' gives a borrow of each in turn.
// It borrows the dictionary, which may not change while the cursor, or a key
// it gave, is used
pub struct DictKeys['a, K Hash, V] {
  dict &'a Dict[K, V];
  pos usize;

  pub fn next(self &mut) Option[&'a K] {
    imm i = nextFull(dict.ctrl, dict.mask, pos);
    if i == noBucket { pos = dict.mask + 1usize; return None[&K][]; }
    pos = i + 1usize;
    Some[&K][&dict.slots[i].key];
  }
}

// A cursor over a dictionary's values
pub struct DictValues['a, K Hash, V] {
  dict &'a Dict[K, V];
  pos usize;

  pub fn next(self &mut) Option[&'a V] {
    imm i = nextFull(dict.ctrl, dict.mask, pos);
    if i == noBucket { pos = dict.mask + 1usize; return None[&V][]; }
    pos = i + 1usize;
    Some[&V][&dict.slots[i].value];
  }
}

// A cursor over a dictionary's entries: a borrow of each key with its value
pub struct DictEntries['a, K Hash, V] {
  dict &'a Dict[K, V];
  pos usize;

  pub fn next(self &mut) Option[&'a DictEntry[K, V]] {
    imm i = nextFull(dict.ctrl, dict.mask, pos);
    if i == noBucket { pos = dict.mask + 1usize; return None[&DictEntry[K, V]][]; }
    pos = i + 1usize;
    Some[&DictEntry[K, V]][(dict.slots + i) as &DictEntry[K, V]];
  }
}

// -------- OrderedDict --------

// A dictionary that visits its entries in the order they were first inserted:
// the layout of Python's compact dict and Rust's IndexMap. Two blocks. The
// entries are dense, one array of (hash, key, value) in insertion order, and
// 'keys', 'values' and 'entries' walk it front to back, with no empty buckets
// to skip. Beside it is an index, a SwissTable's control bytes (the same bytes,
// the same eight-at-a-time probe and the same 7-in-8 fullness as Dict's) and,
// for each bucket, a u32 that is the position of its entry in the array. A
// lookup probes the control bytes, reads the position, and compares the key
// there: one hop more than Dict's, which keeps its entries in the buckets
// themselves.
//
// The order is the point, so it does not change except as the entries do:
// inserting a key it already holds replaces that entry in its place, and
// removing one closes the gap, every later entry moving down one and its index
// fixed (IndexMap's shift_remove). That makes 'remove' cost the entries after
// the removed one; 'swapRemove' is O(1) and moves the last entry into the gap,
// which breaks the order, and is named for it. The index is a u32, so a table
// holds fewer than 2^32 entries.
//
// Everything else is Dict's: K is any Hash type, a key lookup takes a '&K', an
// OrderedDict[String, V] takes the bytes of a key too, each has a seed of its
// own ('empty' the process's, 'deterministic' a fixed one; the order of
// iteration does not depend on it, only which bucket a key is in), the block
// starts at 8 buckets (7 entries), and a borrow from a lookup or a cursor is
// good only until the table next changes.

// One entry: the hash of its key, as the dictionary computed it, kept so that
// growing never hashes again, and the key and the value
pub struct OrderedEntry[K, V] {
  pub hash u64;
  pub key K;
  pub value V;
}

pub struct OrderedDict[K Hash, V] is ShapeChanging, Sendable {
  ctrl *u8;                        // the control bytes, past the index in its block
  index *u32;                      // per bucket, its entry's position; live only where ctrl is full
  dense *OrderedEntry[K, V];       // the entries in order, 'count' live, room for 7/8 of the buckets
  mask usize;                      // the buckets, less one
  count usize;                     // how many entries
  left usize;                      // how many more empty buckets may be filled before it is rebuilt
  hasher Hasher;

  // An empty dictionary, 'new OrderedDict[String, i64]': no block until the
  // first entry arrives
  pub fn initEmpty overload init(self &new) {
    *self = new OrderedDict(null, null, null, 0usize, 0usize, 0usize, Hasher.seeded());
  }

  pub fn empty() OrderedDict { new OrderedDict(null, null, null, 0usize, 0usize, 0usize, Hasher.seeded()); }

  // An empty dictionary with a fixed seed
  pub fn deterministic() OrderedDict { OrderedDict.withSeed(fixedSeed); }

  // An empty dictionary with this seed: a key hashes to what 'Hasher.withSeed(seed)'
  // makes of what it feeds
  pub fn withSeed(seed u64) OrderedDict {
    new OrderedDict(null, null, null, 0usize, 0usize, 0usize, Hasher.withSeed(seed));
  }

  // How many entries it holds, and how many it holds before it next grows
  pub fn len(self &) usize { count; }
  pub fn capacity(self &) usize { if ctrl == null {0usize;} else {bucketsCapacity(mask + 1usize);}; }
  pub fn isEmpty(self &) bool { count == 0usize; }

  // Move key and value in, at the end. A key it already holds has its entry
  // replaced where it stands: the old key and value are finalized, and it
  // answers true.
  pub fn insert(self &mut, key K, value V) bool {
    imm hash = self.hashOf(&key);
    imm found = self.freeOrFound(hash, &key);
    if self.isFull(found) {
      imm slot = dense +self.posOf(found);
      mem.finalize(slot);
      mem.writeRaw(slot, new OrderedEntry[K, V](hash, key, value));
      return true;
    }
    self.fill(self.roomFor(hash, found), hash, key, value);
    false;
  }

  // 'dict <- key: value' is 'dict.insert(key, value)'
  pub fn insertPair overload `<-`(self &mut, key K, value V) { self.insert(key, value); }

  // A borrow of key's value for changing it in place: the value already there,
  // or else the one given, moved in at the end, with one search
  pub fn getOrInsert(self &mut, key K, value V) &mut V {
    imm hash = self.hashOf(&key);
    imm found = self.freeOrFound(hash, &key);
    if self.isFull(found) { return &mut dense[self.posOf(found)].value; }
    imm p = self.fill(self.roomFor(hash, found), hash, key, value);
    &mut dense[p].value;
  }

  // Whether it holds key
  pub fn containsKey overload contains(self &, key &K) bool { self.find(self.hashOf(key), key) != noBucket; }

  // A borrow of key's value, for reading it now, or None
  pub fn getKey overload get(self &, key &K) Option[&V] {
    imm b = self.find(self.hashOf(key), key);
    if b == noBucket { return None[&V][]; }
    Some[&V][&dense[self.posOf(b)].value];
  }

  // A borrow of key's value for changing it in place, or None
  pub fn getMutKey overload getMut(self &mut, key &K) Option[&mut V] {
    imm b = self.find(self.hashOf(key), key);
    if b == noBucket { return None[&mut V][]; }
    Some[&mut V][&mut dense[self.posOf(b)].value];
  }

  // A copy of key's value, or None: the lookup that holds no borrow into the
  // table, so it works through a shared owner, where V copies
  pub fn getCopyKey overload getCopy(self &, key &K) Option[V] where V is Copy {
    imm b = self.find(self.hashOf(key), key);
    if b == noBucket { return None[V][]; }
    Some[V][dense[self.posOf(b)].value];
  }

  // 'dict[&key]': a borrow of key's value; a key it does not hold is a panic
  // at the line of the caller
  pub fn indexKey overload `[]`(self &, key &K, file &[]u8 = srcFile(), line u32 = srcLine()) &V {
    imm b = self.find(self.hashOf(key), key);
    if b == noBucket { panic("collections: OrderedDict has no entry for the key", file, line); }
    &dense[self.posOf(b)].value;
  }

  // '&mut dict[&key]': a borrow of key's value for changing it, a panic as above
  pub fn indexMutKey overload `&[]`(self &mut, key &K, file &[]u8 = srcFile(), line u32 = srcLine()) &mut V {
    imm b = self.find(self.hashOf(key), key);
    if b == noBucket { panic("collections: OrderedDict has no entry for the key", file, line); }
    &mut dense[self.posOf(b)].value;
  }

  // Move key's value out and finalize the key it was held under, or None when
  // it holds no such key. Every entry after it moves down one place, so the
  // others keep their order
  pub fn removeKey overload remove(self &mut, key &K) Option[V] {
    imm b = self.find(self.hashOf(key), key);
    if b == noBucket { return None[V][]; }
    Some[V][self.takeShift(b)];
  }

  // The same, but the last entry takes the removed one's place instead of the
  // later ones all moving down: O(1), and the order is no longer the order of
  // insertion
  pub fn swapRemove(self &mut, key &K) Option[V] {
    imm b = self.find(self.hashOf(key), key);
    if b == noBucket { return None[V][]; }
    Some[V][self.takeSwap(b)];
  }

  // The same for an OrderedDict[String, V], given a key as bytes
  pub fn containsBytes overload contains(self &, key &[]u8) bool where K is String {
    self.findBytes(key) != noBucket;
  }

  pub fn getBytes overload get(self &, key &[]u8) Option[&V] where K is String {
    imm b = self.findBytes(key);
    if b == noBucket { return None[&V][]; }
    Some[&V][&dense[self.posOf(b)].value];
  }

  pub fn getMutBytes overload getMut(self &mut, key &[]u8) Option[&mut V] where K is String {
    imm b = self.findBytes(key);
    if b == noBucket { return None[&mut V][]; }
    Some[&mut V][&mut dense[self.posOf(b)].value];
  }

  pub fn getCopyBytes overload getCopy(self &, key &[]u8) Option[V] where K is String and V is Copy {
    imm b = self.findBytes(key);
    if b == noBucket { return None[V][]; }
    Some[V][dense[self.posOf(b)].value];
  }

  pub fn indexBytes overload `[]`(self &, key &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) &V where K is String {
    imm b = self.findBytes(key);
    if b == noBucket { missingKey(key, file, line); }
    &dense[self.posOf(b)].value;
  }

  pub fn indexMutBytes overload `&[]`(self &mut, key &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) &mut V where K is String {
    imm b = self.findBytes(key);
    if b == noBucket { missingKey(key, file, line); }
    &mut dense[self.posOf(b)].value;
  }

  pub fn removeBytes overload remove(self &mut, key &[]u8) Option[V] where K is String {
    imm b = self.findBytes(key);
    if b == noBucket { return None[V][]; }
    Some[V][self.takeShift(b)];
  }

  // Finalize every key and value, first inserted to last, and keep the blocks:
  // it holds nothing, with the room it had
  pub fn clear(self &mut) {
    if ctrl == null { return; }
    if mem.needsFinal[OrderedEntry[K, V]]() {
      mut i = 0usize;
      while i < count {
        mem.finalize(dense +i);
        i = i + 1usize;
      }
    }
    libc.memset(ctrl, 255i32, mask + 1usize + 8usize);
    count = 0usize;
    left = bucketsCapacity(mask + 1usize);
  }

  // Cursors over what it holds, each giving a borrow into the table for reading
  // now, with 'next' until it answers None, in the order of insertion. The
  // table may not change while one is used.
  pub fn keys(self &) OrderedKeys[K, V] { new OrderedKeys[K, V](self, 0usize); }
  pub fn values(self &) OrderedValues[K, V] { new OrderedValues[K, V](self, 0usize); }
  pub fn entries(self &) OrderedEntries[K, V] { new OrderedEntries[K, V](self, 0usize); }

  // The hash of a key: the key fed to this dictionary's hasher
  fn hashOf(self &, key &K) u64 {
    mut h = hasher;
    key.hash(&mut h);
    h.finish();
  }

  // Whether the bucket holds an entry (its control byte's top bit is clear)
  fn isFull(self &, b usize) bool { mem.readRaw[u8](ctrl + b) < ctrlRemoved; }

  // The position in 'dense' of the entry the full bucket b names
  fn posOf(self &, b usize) usize { usize.from(mem.readRaw[u32](index + b)); }

  // The bucket naming the entry that holds key, or noBucket
  fn find(self &, hash u64, key &K) usize {
    if count == 0usize { return noBucket; }
    imm t = hashTag(hash);
    mut pos = usize.from(hash) & mask;
    mut stride = 0usize;
    while true {
      imm g = ctrlGroup(ctrl, pos);
      mut m = matchTag(g, t);
      while m != 0u64 {
        imm b = (pos + flagByte(m)) & mask;
        if &dense[self.posOf(b)].key == key { return b; }
        m = m & (m - 1u64);
      }
      if matchEmpty(g) != 0u64 { return noBucket; }
      stride = stride + 8usize;
      pos = (pos + stride) & mask;
    }
    noBucket;
  }

  // The bucket naming the String that holds these bytes, or noBucket: key is
  // hashed as a String feeds the hasher (its bytes, then the terminator)
  fn findBytes(self &, key &[]u8) usize where K is String {
    if count == 0usize { return noBucket; }
    mut h = hasher;
    h.writeStr(key);
    imm hash = h.finish();
    imm t = hashTag(hash);
    mut pos = usize.from(hash) & mask;
    mut stride = 0usize;
    while true {
      imm g = ctrlGroup(ctrl, pos);
      mut m = matchTag(g, t);
      while m != 0u64 {
        imm b = (pos + flagByte(m)) & mask;
        if dense[self.posOf(b)].key.view() == key { return b; }
        m = m & (m - 1u64);
      }
      if matchEmpty(g) != 0u64 { return noBucket; }
      stride = stride + 8usize;
      pos = (pos + stride) & mask;
    }
    noBucket;
  }

  // The bucket naming the entry at position p, whose key hashes to hash. The
  // entry is there, so the search finds it
  fn bucketAt(self &, hash u64, p usize) usize {
    imm t = hashTag(hash);
    mut pos = usize.from(hash) & mask;
    mut stride = 0usize;
    while true {
      imm g = ctrlGroup(ctrl, pos);
      mut m = matchTag(g, t);
      while m != 0u64 {
        imm b = (pos + flagByte(m)) & mask;
        if self.posOf(b) == p { return b; }
        m = m & (m - 1u64);
      }
      if matchEmpty(g) != 0u64 { unreachable("collections: OrderedDict index lost an entry"); }
      stride = stride + 8usize;
      pos = (pos + stride) & mask;
    }
    noBucket;
  }

  // One search for an insert: the bucket naming key's entry, if there is one,
  // else the first empty or removed bucket in the probe sequence. The blocks
  // are made when there are none yet. Whether it found key is 'isFull'
  fn freeOrFound(self &mut, hash u64, key &K) usize {
    if ctrl == null { self.resize(8usize); }
    imm t = hashTag(hash);
    mut pos = usize.from(hash) & mask;
    mut stride = 0usize;
    mut spare = noBucket;
    while true {
      imm g = ctrlGroup(ctrl, pos);
      mut m = matchTag(g, t);
      while m != 0u64 {
        imm b = (pos + flagByte(m)) & mask;
        if &dense[self.posOf(b)].key == key { return b; }
        m = m & (m - 1u64);
      }
      if spare == noBucket {
        imm free = matchFree(g);
        if free != 0u64 { spare = (pos + flagByte(free)) & mask; }
      }
      if matchEmpty(g) != 0u64 { return spare; }
      stride = stride + 8usize;
      pos = (pos + stride) & mask;
    }
    spare;
  }

  // The bucket a new entry goes in, given the free one the search found: the
  // index is rebuilt first (grown, or at its size when removed buckets are
  // most of what fills it) if the bucket is an empty one and none are left
  // to fill. The entries array has room whenever the index does
  fn roomFor(self &mut, hash u64, spare usize) usize {
    if left > 0usize or mem.readRaw[u8](ctrl + spare) != ctrlEmpty { return spare; }
    imm wanted = count + 1usize;
    imm buckets = mask + 1usize;
    self.resize(if wanted <= bucketsCapacity(buckets) / 2usize {buckets;} else {capacityBuckets(wanted);});
    freeBucket(ctrl, mask, hash);
  }

  // Append an entry, named by the free bucket b. It answers its position
  fn fill(self &mut, b usize, hash u64, key K, value V) usize {
    if mem.readRaw[u8](ctrl + b) == ctrlEmpty { left = left - 1usize; }
    ctrlSet(ctrl, mask, b, hashTag(hash));
    imm p = count;
    mem.writeRaw[u32](index + b, u32.from(p));
    mem.writeRaw(dense +p, new OrderedEntry[K, V](hash, key, value));
    count = p + 1usize;
    p;
  }

  // Make bucket b, which names a live entry, free
  fn release(self &mut, b usize) {
    if ctrlErase(ctrl, mask, b) { left = left + 1usize; }
  }

  // Remove the entry bucket b names, closing the gap: its key is finalized,
  // its value moved out, the later entries move down one place, and each one's
  // bucket is told. A short tail is found one entry at a time by hash; a long
  // one by reading the whole index
  fn takeShift(self &mut, b usize) V {
    imm p = self.posOf(b);
    self.release(b);
    imm slot = (dense +p) as &mut OrderedEntry[K, V];
    mem.finalize(&slot.key as *K);
    imm value = mem.readRaw(&slot.value as *V);
    count = count - 1usize;
    imm moved = count - p;
    if moved > 0usize {
      mem.moveRaw(dense +p, dense +p + 1usize, moved);
      if moved * 8usize < mask + 1usize {
        mut q = p;
        while q < count {
          mem.writeRaw[u32](index + self.bucketAt(dense[q].hash, q + 1usize), u32.from(q));
          q = q + 1usize;
        }
      }
      else {
        mut i = 0usize;
        while i <= mask {
          if self.isFull(i) and self.posOf(i) > p {
            mem.writeRaw[u32](index + i, u32.from(self.posOf(i) - 1usize));
          }
          i = i + 1usize;
        }
      }
    }
    value;
  }

  // Remove the entry bucket b names, the last entry taking its place
  fn takeSwap(self &mut, b usize) V {
    imm p = self.posOf(b);
    self.release(b);
    imm slot = (dense +p) as &mut OrderedEntry[K, V];
    mem.finalize(&slot.key as *K);
    imm value = mem.readRaw(&slot.value as *V);
    count = count - 1usize;
    if p != count {
      imm lastBucket = self.bucketAt(dense[count].hash, count);
      mem.moveRaw(dense +p, dense +count, 1usize);
      mem.writeRaw[u32](index + lastBucket, u32.from(p));
    }
    value;
  }

  // A new index of this many buckets (a power of two, 8 or more) over the same
  // entries, in the same order; the entries array grows with it
  fn resize(self &mut, buckets usize) {
    if buckets > 4294967296usize { panic("collections: OrderedDict is past 2^32 buckets", srcFile(), srcLine()); }
    imm base = libc.malloc(buckets * 5usize + 8usize);
    imm fresh = base + buckets * 4usize;
    libc.memset(fresh, 255i32, buckets + 8usize);
    imm freshIndex = base as *u32;
    imm freshMask = buckets - 1usize;
    mut i = 0usize;
    while i < count {
      imm hash = dense[i].hash;
      imm j = freeBucket(fresh, freshMask, hash);
      ctrlSet(fresh, freshMask, j, hashTag(hash));
      mem.writeRaw[u32](freshIndex + j, u32.from(i));
      i = i + 1usize;
    }
    imm oldCap = if ctrl == null {0usize;} else {bucketsCapacity(mask + 1usize);};
    imm newCap = bucketsCapacity(buckets);
    if newCap != oldCap {
      dense = libc.realloc(dense as *u8, newCap * mem.sizeof[OrderedEntry[K, V]]()) as *OrderedEntry[K, V];
    }
    if ctrl != null { libc.free(index as *u8); }
    ctrl = fresh;
    index = freshIndex;
    mask = freshMask;
    left = newCap - count;
  }

  // Its death: each entry's key and value, first inserted to last, then the blocks
  fn final(self &uni) {
    if ctrl != null {
      if mem.needsFinal[OrderedEntry[K, V]]() {
        mut i = 0usize;
        while i < count {
          mem.finalize(dense +i);
          i = i + 1usize;
        }
      }
      libc.free(dense as *u8);
      libc.free(index as *u8);
    }
  }
}

// A cursor over an OrderedDict's keys: 'next' gives a borrow of each in turn,
// in the order of insertion. It borrows the dictionary, which may not change
// while the cursor, or a key it gave, is used
pub struct OrderedKeys['a, K Hash, V] {
  dict &'a OrderedDict[K, V];
  pos usize;

  pub fn next(self &mut) Option[&'a K] {
    if pos >= dict.count { return None[&K][]; }
    imm i = pos;
    pos = i + 1usize;
    Some[&K][&dict.dense[i].key];
  }
}

// A cursor over an OrderedDict's values, in the order of insertion
pub struct OrderedValues['a, K Hash, V] {
  dict &'a OrderedDict[K, V];
  pos usize;

  pub fn next(self &mut) Option[&'a V] {
    if pos >= dict.count { return None[&V][]; }
    imm i = pos;
    pos = i + 1usize;
    Some[&V][&dict.dense[i].value];
  }
}

// A cursor over an OrderedDict's entries: a borrow of each key with its value
// (and its hash), in the order of insertion
pub struct OrderedEntries['a, K Hash, V] {
  dict &'a OrderedDict[K, V];
  pos usize;

  pub fn next(self &mut) Option[&'a OrderedEntry[K, V]] {
    if pos >= dict.count { return None[&OrderedEntry[K, V]][]; }
    imm i = pos;
    pos = i + 1usize;
    Some[&OrderedEntry[K, V]][(dict.dense +i) as &OrderedEntry[K, V]];
  }
}

// -------- Set --------

// A set of T, unordered: a Dict of T to nothing, so it has the Dict's table, its
// seed and its rules. T is any Hash type; a Set[String] also takes the bytes of
// an element. Its elements are visited in the table's order, which is the
// seed's: sort them, or ask 'contains', and never rely on it. A borrow from a
// cursor is good only until the set next changes.

// What a Set's dictionary holds beside each element: nothing, in no bytes
struct Member {}

pub struct Set[T Hash] is ShapeChanging, Sendable {
  dict Dict[T, Member];

  // An empty set, 'new Set[String]'. Its seed is the process's
  pub fn initEmpty overload init(self &new) { *self = new Set(Dict[T, Member].empty()); }

  pub fn empty() Set { new Set(Dict[T, Member].empty()); }

  // An empty set with a fixed seed: the same elements inserted in the same
  // order are visited in the same order on every run
  pub fn deterministic() Set { new Set(Dict[T, Member].deterministic()); }

  // An empty set with this seed
  pub fn withSeed(seed u64) Set { new Set(Dict[T, Member].withSeed(seed)); }

  pub fn len(self &) usize { dict.len(); }
  pub fn capacity(self &) usize { dict.capacity(); }
  pub fn isEmpty(self &) bool { dict.isEmpty(); }

  // Move item in. It answers whether it was new: an element the set already
  // holds stays, and the item given dies
  pub fn insert(self &mut, item T) bool {
    imm before = dict.len();
    dict.getOrInsert(item, new Member());
    dict.len() > before;
  }

  // 'set <- item' is 'set.insert(item)'
  pub fn insertItem overload `<-`(self &mut, item T) { self.insert(item); }

  // Whether it holds item
  pub fn containsItem overload contains(self &, item &T) bool { dict.contains(item); }

  // Remove item, finalizing the element held; whether it was there
  pub fn removeItem overload remove(self &mut, item &T) bool {
    match dict.remove(item) {
      case is Some[Member] {true;}
      case is None[Member] {false;}
    }
  }

  // The same for a Set[String], given an element as bytes
  pub fn containsBytes overload contains(self &, item &[]u8) bool where T is String { dict.contains(item); }

  pub fn removeBytes overload remove(self &mut, item &[]u8) bool where T is String {
    match dict.remove(item) {
      case is Some[Member] {true;}
      case is None[Member] {false;}
    }
  }

  // Finalize every element and keep the room
  pub fn clear(self &mut) { dict.clear(); }

  // A cursor over its elements: 'next' gives a borrow of each in turn, in the
  // table's order, until it answers None
  pub fn items(self &) SetItems[T] { new SetItems[T](dict.keys()); }
}

// A cursor over a set's elements
pub struct SetItems['a, T Hash] {
  inner DictKeys['a, T, Member];

  pub fn next(self &mut) Option[&'a T] { inner.next(); }
}

// -------- capability traits --------

// What a collection can do, one small trait for each, so that a function asks
// for exactly the ability it uses. A trait here is met structurally: a type
// fits one by having the methods, whether or not it ever heard of the trait
// (reference, "Traits"), so List, Deque, Dict, OrderedDict and Set declare
// nothing, and a user's own type with the same methods fits too.
//
// The traits that mention an element type are generic ('Stack[T]'), and a
// generic trait's instance is not built as a constraint yet ('[S Stack[T]]' is
// refused), so a function takes one as a virtual reference, 'fn drain(s &<mut
// Stack[i64])', and is called with '&mut list' or '&mut deque' as it is. Only
// 'Collection', which mentions no element type, is also a constraint:
// 'fn count[C Collection](c &C)'.
//
// The names an operation has are the same wherever it exists: 'push' and 'pop'
// at the back, 'pushFront' and 'popFront' at the front, 'len', 'isEmpty'.

// Anything that holds a number of values
pub trait Collection {
  pub fn len(self &) usize;
  pub fn isEmpty(self &) bool;
}

// Values reached by their position, counted from the front (List, Deque). 'get'
// answers None for a position that is out of range; the indexing '[i]' panics.
pub trait Indexed[T] {
  pub fn get(self &, index usize) Option[&T];
}

// Values pushed and popped at one end, the last in the first out (List, Deque,
// at the back). 'peek' borrows the value 'pop' would move out.
pub trait Stack[T] {
  pub fn push(self &mut, value T);
  pub fn pop(self &mut) Option[T];
  pub fn peek(self &) Option[&T];
}

// Values pushed at the back and popped from the front, the first in the first
// out (Deque)
pub trait Queue[T] {
  pub fn push(self &mut, value T);
  pub fn popFront(self &mut) Option[T];
}

// Values found by a key (Dict, OrderedDict). 'insert' answers whether the key
// was already there, its old value replaced; 'remove' moves the value out.
pub trait Map[K, V] {
  pub fn get(self &, key &K) Option[&V];
  pub fn insert(self &mut, key K, value V) bool;
  pub fn remove(self &mut, key &K) Option[V];
  pub fn contains(self &, key &K) bool;
}

// Values that are members or are not (Set). 'insert' answers whether the
// element was new, the opposite sense to Map's.
pub trait SetAlgebra[T] {
  pub fn insert(self &mut, item T) bool;
  pub fn remove(self &mut, item &T) bool;
  pub fn contains(self &, item &T) bool;
}

// -------- byte slices --------

// The functions the types above read text with, public for text that is
// only a '&[]u8'.

// Whether a and b hold the same bytes: 'a == b'
pub fn bytesEqual(a &[]u8, b &[]u8) bool {
  a == b;
}

// -1, 0 or 1 as a sorts before, with or after b
pub fn bytesCompare(a &[]u8, b &[]u8) i32 {
  mut i = 0usize;
  while i < a.len and i < b.len {
    if a[i] < b[i] { return -1i32; }
    if a[i] > b[i] { return 1i32; }
    i = i + 1usize;
  }
  if a.len < b.len { -1i32; } else if a.len > b.len { 1i32; } else { 0i32; }
}

// Where needle first starts in hay at or after 'from', or None
pub fn bytesFind(hay &[]u8, needle &[]u8, from usize) Option[usize] {
  mut i = from;
  while i + needle.len <= hay.len {
    if &hay[i..i + needle.len] == needle { return Some[usize][i]; }
    i = i + 1usize;
  }
  None[usize][];
}

// A space, tab, carriage return or line feed
pub fn isSpace(b u8) bool { b == ' ' or b == '\t' or b == '\r' or b == '\n'; }

// The byte, made small if it is an ASCII capital letter, A to Z
pub fn asciiLower(b u8) u8 { if b >= 'A' and b <= 'Z' {b + 32u8;} else {b;}; }

// The byte, made a capital if it is an ASCII small letter, a to z
pub fn asciiUpper(b u8) u8 { if b >= 'a' and b <= 'z' {b - 32u8;} else {b;}; }

// The integer the text spells in decimal: a '-' or a '+' or neither, then one
// or more digits, 0 to 9, and nothing else, no spaces either ('trim' first).
// None for any other text, and for a number beyond i64's range, which is
// -9223372036854775808 to 9223372036854775807.
pub fn parseInt(text &[]u8) Option[i64] {
  mut start = 0usize;
  mut negative = false;
  if text.len > 0usize and (text[0usize] == '-' or text[0usize] == '+') {
    negative = text[0usize] == '-';
    start = 1usize;
  }
  // A negative number's magnitude reaches one past the largest i64
  imm limit = if negative {9223372036854775808u64;} else {9223372036854775807u64;};
  match digitsValue(&text[start..], limit) {
    case imm m Some {
      if not negative {Some[i64][i64.from(m.value)];}
      else if m.value == 0u64 {Some[i64][0i64];}
      else {Some[i64][-1i64 - i64.from(m.value - 1u64)];}
    }
    case is None {None[i64][];}
  }
}

// The same for a u64, 0 to 18446744073709551615: a '+' or nothing, then the
// digits. A '-' is None, even before 0.
pub fn parseUInt(text &[]u8) Option[u64] {
  mut start = 0usize;
  if text.len > 0usize and text[0usize] == '+' { start = 1usize; }
  digitsValue(&text[start..], 18446744073709551615u64);
}

// The value of one or more decimal digits and nothing else, or None when
// there are none, when anything else is there, or when it is beyond limit
fn digitsValue(digits &[]u8, limit u64) Option[u64] {
  if digits.len == 0usize { return None[u64][]; }
  mut n = 0u64;
  mut i = 0usize;
  while i < digits.len {
    imm c = digits[i];
    if c < '0' or c > '9' { return None[u64][]; }
    imm d = u64.from(c - '0');
    // Whether n * 10 + d would pass limit, asked without overflowing
    if n > (limit - d) / 10u64 { return None[u64][]; }
    n = n * 10u64 + d;
    i = i + 1usize;
  }
  Some[u64][n];
}

// -------- program errors --------

// Each a panic, reported where the method finding it was called

fn outOfRange(index usize, length usize, file &[]u8, line u32) Never {
  mut msg = String.from("collections: index ");
  msg.appendUInt(u64.from(index));
  msg.append(" is out of range for a length of ");
  msg.appendUInt(u64.from(length));
  panic(msg.view(), file, line);
}

fn missingKey(key &[]u8, file &[]u8, line u32) Never {
  mut msg = String.from("collections: no entry for the key \"");
  msg.append(key);
  msg.append("\"");
  panic(msg.view(), file, line);
}
