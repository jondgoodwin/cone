// Core's Iterator and Iterable, met by shape: every cursor the collections have,
// unchanged, is an Iterator without declaring it, and a function generic over
// the trait loops on its 'next()'. Those that lend values (DequeItems,
// DictKeys, DictValues, DictEntries, the ordered and Set cursors) return
// 'Option[&'a T]', the lifetime their struct declares, and fit
// 'Iterator[&T]', whose '&T' names none. A type of this file's own, with the
// methods and no declaration, fits too, and so does an Iterable that hands out
// a cursor. Every expected value is worked out by hand from the entries
// inserted:
// - the deque holds 10, 20, 30: three items, summing to 60;
// - the dictionaries map 1 to 10, 2 to 20 and 3 to 30: three keys summing to 6,
//   values summing to 60, and key times value over the entries 10 + 40 + 90 =
//   140; the ordered ones give their keys in insertion order, 1, 2, 3, read
//   as the digits 123;
// - the set holds 7, 8 and 9: three items summing to 24;
// - a Countdown from 3 gives 3, 2, 1 (read as 321) by value, and the code
//   points of "abc" are 97, 98, 99, summing to 294.

mod iterator;

import testing use *;
import collections use *;

// -------- the generic functions: one bound each, looping on next() --------

// How many values a cursor gives, whatever they are (T is a borrow, or not)
fn countAll[T, S: Iterator[T]](s: &mut S) usize {
  var n = 0usize;
  while true {
    match s.next() {
      case let Some(v) {n = n + 1usize;}
      case is None {break;}
    }
  }
  n
}

// The sum of borrowed numbers
fn sumRefs[S: Iterator[&i64]](s: &mut S) i64 {
  var total = 0i64;
  while true {
    match s.next() {
      case let Some(v) {total = total + *v;}
      case is None {break;}
    }
  }
  total
}

fn sumKeys[S: Iterator[&u64]](s: &mut S) u64 {
  var total = 0u64;
  while true {
    match s.next() {
      case let Some(v) {total = total + *v;}
      case is None {break;}
    }
  }
  total
}

// The element type a parameter of its own, borrowed with the bound's '&T'
fn countBorrowed[T, S: Iterator[&T]](s: &mut S) usize {
  var n = 0usize;
  while true {
    match s.next() {
      case let Some(v) {n = n + 1usize;}
      case is None {break;}
    }
  }
  n
}

// The keys read in the order given, as digits
fn digitsOfKeys[S: Iterator[&u64]](s: &mut S) u64 {
  var n = 0u64;
  while true {
    match s.next() {
      case let Some(v) {n = n * 10u64 + *v;}
      case is None {break;}
    }
  }
  n
}

fn sumProducts[S: Iterator[&DictEntry[u64, i64]]](s: &mut S) i64 {
  var total = 0i64;
  while true {
    match s.next() {
      case let Some(e) {total = total + i64.from(e.key) * e.value;}
      case is None {break;}
    }
  }
  total
}

fn sumOrderedProducts[S: Iterator[&OrderedEntry[u64, i64]]](s: &mut S) i64 {
  var total = 0i64;
  while true {
    match s.next() {
      case let Some(e) {total = total + i64.from(e.key) * e.value;}
      case is None {break;}
    }
  }
  total
}

fn sumChars[S: Iterator[char]](s: &mut S) u64 {
  var total = 0u64;
  while true {
    match s.next() {
      case let Some(c) {total = total + u64.from(c);}
      case is None {break;}
    }
  }
  total
}

fn sumCharOffsets[S: Iterator[StrCharIndex]](s: &mut S) usize {
  var total = 0usize;
  while true {
    match s.next() {
      case let Some(c) {total = total + c.offset;}
      case is None {break;}
    }
  }
  total
}

// The same bound as a virtual reference: one compiled function for every cursor
fn sumRefsDyn(s: &<mut Iterator[&i64]) i64 {
  var total = 0i64;
  while true {
    match s.next() {
      case let Some(v) {total = total + *v;}
      case is None {break;}
    }
  }
  total
}

fn sumKeysDyn(s: &<mut Iterator[&u64]) u64 {
  var total = 0u64;
  while true {
    match s.next() {
      case let Some(v) {total = total + *v;}
      case is None {break;}
    }
  }
  total
}

fn digitsDyn(s: &<mut Iterator[&u64]) u64 {
  var n = 0u64;
  while true {
    match s.next() {
      case let Some(v) {n = n * 10u64 + *v;}
      case is None {break;}
    }
  }
  n
}

fn digitsOfValuesDyn(s: &<mut Iterator[i64]) i64 {
  var n = 0i64;
  while true {
    match s.next() {
      case let Some(v) {n = n * 10i64 + v;}
      case is None {break;}
    }
  }
  n
}

// Two results held while the cursor goes on, as the cursor's own signature
// allows: each borrow is the deque's, not the cursor's
fn firstTwo[S: Iterator[&i64]](s: &mut S) i64 {
  let a = s.next();
  let b = s.next();
  var total = 0i64;
  match a {
    case let Some(v) {total = total + *v;}
    case is None {}
  }
  match b {
    case let Some(v) {total = total + *v;}
    case is None {}
  }
  total
}

// -------- Iterable: something that gives a cursor --------

fn countOf[T, I, C: Iterable[T, I]](c: &C) usize where I is Iterator[T] {
  var it = c.iter();
  var n = 0usize;
  while true {
    match it.next() {
      case let Some(v) {n = n + 1usize;}
      case is None {break;}
    }
  }
  n
}

fn sumOf[I, C: Iterable[&i64, I]](c: &C) i64 where I is Iterator[&i64] {
  var it = c.iter();
  var total = 0i64;
  while true {
    match it.next() {
      case let Some(v) {total = total + *v;}
      case is None {break;}
    }
  }
  total
}

// -------- types of this file's own, with the methods and no declaration --------

// Gives its values, not borrows
struct Countdown {
  left: i64;
  pub fn next(self: &mut) Option[i64] {
    if left <= 0i64 { return None; }
    let now = left;
    left = now - 1i64;
    Some[i64](now)
  }
}

// Lends the numbers of a list, and names its lifetime
struct Walk['a] {
  nums: &'a List[i64];
  pos: usize;
  pub fn next(self: &mut) Option[&'a i64] {
    let i = pos;
    pos = i + 1usize;
    match nums.get(i) {
      case let Some(v) {Some[&i64](v)}
      case is None {None}
    }
  }
}

// A bag of numbers that gives a Walk over them
struct Bag {
  nums: List[i64];
  pub fn iter(self: &) Walk { Walk(&nums, 0usize) }
}

// Its cursor is the deque's own
struct Shelf {
  items: Deque[i64];
  pub fn iter(self: &) DequeItems[i64] { items.items() }
}

fn cursors() {
  var d = Deque[i64].empty();
  d.push(10i64);
  d.push(20i64);
  d.push(30i64);

  var a = d.items();
  expectUInt(u64.from(countAll(&mut a)), 3, "DequeItems is an Iterator, T a borrow");
  var b = d.items();
  expectInt(sumRefs(&mut b), 60, "its values through Iterator[&i64]");
  var b2 = d.items();
  expectUInt(u64.from(countBorrowed(&mut b2)), 3, "and through Iterator[&T] with T a parameter");
  var b3 = d.items();
  expectInt(firstTwo(&mut b3), 30, "two results held while the cursor goes on");
  var b4 = d.items();
  expectInt(sumRefsDyn(&mut b4), 60, "the same cursor through a virtual Iterator[&i64]");

  var m = Dict[u64, i64]();
  m.insert(1u64, 10i64);
  m.insert(2u64, 20i64);
  m.insert(3u64, 30i64);
  var mk = m.keys();
  expectUInt(u64.from(countAll(&mut mk)), 3, "DictKeys is an Iterator");
  var mk2 = m.keys();
  expectUInt(sumKeys(&mut mk2), 6, "its keys");
  var mk3 = m.keys();
  expectUInt(sumKeysDyn(&mut mk3), 6, "a Dict's keys through a virtual one");
  var mv = m.values();
  expectInt(sumRefs(&mut mv), 60, "DictValues is an Iterator[&i64]");
  var me = m.entries();
  expectInt(sumProducts(&mut me), 140, "DictEntries is an Iterator[&DictEntry[u64, i64]]");
  var me2 = m.entries();
  expectUInt(u64.from(countAll(&mut me2)), 3, "and counts three");

  var o = OrderedDict[u64, i64]();
  o.insert(1u64, 10i64);
  o.insert(2u64, 20i64);
  o.insert(3u64, 30i64);
  var ok = o.keys();
  expectUInt(digitsOfKeys(&mut ok), 123, "OrderedKeys gives the keys in insertion order");
  var ok2 = o.keys();
  expectUInt(digitsDyn(&mut ok2), 123, "and through a virtual one");
  var ov = o.values();
  expectInt(sumRefs(&mut ov), 60, "OrderedValues is an Iterator[&i64]");
  var oe = o.entries();
  expectInt(sumOrderedProducts(&mut oe), 140, "OrderedEntries is an Iterator[&OrderedEntry[u64, i64]]");

  var st = Set[u64]();
  st.insert(7u64);
  st.insert(8u64);
  st.insert(9u64);
  var si = st.items();
  expectUInt(sumKeys(&mut si), 24, "SetItems is an Iterator[&u64]");
  var si2 = st.items();
  expectUInt(u64.from(countAll(&mut si2)), 3, "and counts three");

  // Values, not borrows: core's cursors over text, and one of this file's
  let s = String.from("abc");
  var cs = s.chars();
  expectUInt(sumChars(&mut cs), 294, "StrChars, reached through a String's fold, is an Iterator[char]");
  var cis = s.charIndices();
  expectUInt(u64.from(sumCharOffsets(&mut cis)), 3, "StrCharIndices is an Iterator[StrCharIndex]: offsets 0, 1, 2");
  var cd = Countdown(3i64);
  expectInt(digitsOfValuesDyn(&mut cd), 321, "a Countdown declaring nothing is an Iterator[i64], through a virtual one");
  var cd2 = Countdown(4i64);
  expectUInt(u64.from(countAll(&mut cd2)), 4, "and by a bound");

  // A cursor of this file's own that lends, and names its lifetime
  let nums = List[i64]() <- 1, 2, 3, 4;
  var w = Walk(&nums, 0usize);
  expectInt(sumRefs(&mut w), 10, "a Walk['a] is an Iterator[&i64]");
  var w2 = Walk(&nums, 0usize);
  expectInt(sumRefsDyn(&mut w2), 10, "and through a virtual one");
}

fn iterables() {
  let fives = List[i64]() <- 5, 6, 7;
  let bag = Bag(fives);
  expectUInt(u64.from(countOf(&bag)), 3, "a Bag with iter() is an Iterable; T and I are found from its iter");
  expectInt(sumOf(&bag), 18, "and its Walk is an Iterator[&i64]");
  var shelf = Shelf(Deque[i64].empty());
  shelf.items.push(2i64);
  shelf.items.push(4i64);
  expectInt(sumOf(&shelf), 6, "a Shelf whose iter gives the deque's own cursor");
}

fn main() i32 {
  cursors();
  iterables();
  done()
}


