// sort() on numbers. Integers are routed to sortUnstable (equal integers cannot be told
// apart, so the merge buffer is waste); floats and other types keep the stable sort.
//
// What each check means (every printed line was worked out against the source):
// - For every integer width, four patterns (random, sorted, reversed, four distinct values)
//   at sizes 0, 1, 19, 20, 21, 300 and 5,000: sort() gives the same elements as sortBy with a
//   plain '<=>' comparison (the stable path). Equal integers are identical, so "same" is
//   element by element equality.
// - No scratch: a list of 1,000 u32 in a counting region, random or reversed, sorted with sort()
//   asks its region for nothing (still the one block of 4,000 bytes, no release). The stable
//   path would ask for a buffer of 500 values.
// - Not routed, so still stable: structs with equal keys, each carrying its position, sorted by
//   sortByKey keep the positions rising within a key.
// - Floats: f32 made of random bits (NaNs of both signs, both zeros), sort() has the same bits
//   as sortBy with '<=>', and -0.0 comes before 0.0 whichever order they were given.

mod sortnumbers;

import testing use *;
import collections use *;
import libc;

fn nextRand(s: &mut u64) u64 {
  var x = *s;
  x = x ^ (x << 13u64);
  x = x ^ (x >> 7u64);
  x = x ^ (x << 17u64);
  *s = x;
  x
}

fn f32FromBits(bits: u32) f32 {
  var b = bits;
  *((&mut b) as *u32 as *f32)
}

fn bitsOf(f: f32) u32 {
  var b = f;
  *((&mut b) as *f32 as *u32)
}

fn byNatural[T](a: &T, b: &T) i32 { *a <=> *b }

// The raw value of pattern 'kind' at position i of n: 0 random, 1 sorted, 2 reversed, 3 four values
fn raw(kind: i32, i: usize, n: usize, s: &mut u64) u64 {
  if kind == 0i32 { return nextRand(s); }
  if kind == 1i32 { return u64.from(i) * 3u64; }
  if kind == 2i32 { return u64.from(n - i) * 3u64; }
  nextRand(s) % 4u64
}

// One width: the same input sorted both ways must give equal lists. 'conv' makes a T from the raw value.
fn checkWidth[T, F: fn(x: u64) T](conv: &F, label: &Array[u8]) {
  var ok = true;
  let sizes = [0usize, 1usize, 19usize, 20usize, 21usize, 300usize, 5000usize];
  var si = 0usize;
  while si < 7usize {
    let n = sizes[si];
    var kind = 0i32;
    while kind < 4i32 {
      var seed = 88172645463325252u64 + u64.from(n);
      var a = List[T]();
      var b = List[T]();
      var i = 0usize;
      while i < n {
        let v = conv(raw(kind, i, n, &mut seed));
        a.push(v);
        b.push(v);
        i = i + 1usize;
      }
      a.sort();
      b.sortBy(&byNatural[T]);
      var j = 0usize;
      while j < n {
        if a[j] != b[j] { ok = false; }
        j = j + 1usize;
      }
      kind = kind + 1i32;
    }
    si = si + 1usize;
  }
  expect(ok, label);
}

fn toI8(x: u64) i8 { i8.from(x % 251u64) - 125i8 }
fn toU8(x: u64) u8 { u8.from(x % 251u64) }
fn toI16(x: u64) i16 { i16.from(x % 60001u64) - 30000i16 }
fn toU16(x: u64) u16 { u16.from(x % 60001u64) }
fn toI32(x: u64) i32 { i32.from(x % 4000000001u64) - 2000000000i32 }
fn toU32(x: u64) u32 { u32.from(x % 4000000001u64) }
fn toI64(x: u64) i64 { i64.from(x >> 1u64) - 4000000000000000000i64 }
fn toU64(x: u64) u64 { x }
fn toUsize(x: u64) usize { usize.from(x) }
fn toIsize(x: u64) isize { isize.from(x >> 1u64) - 4000000000000000000isize }

// A counting region
struct Counting {
  header: MemRegion;
  allocs: usize;
  releases: usize;
  live: isize;
}

fn countAlloc(r: *MemRegion, bytes: usize, align: usize) *u8 {
  let c = r as *Counting;
  (*c).allocs = (*c).allocs + 1usize;
  (*c).live = (*c).live + isize.from(bytes);
  libc.malloc(bytes)
}

fn countResize(r: *MemRegion, block: *u8, oldBytes: usize, newBytes: usize, align: usize) *u8 {
  let c = r as *Counting;
  (*c).live = (*c).live + isize.from(newBytes) - isize.from(oldBytes);
  libc.realloc(block, newBytes)
}

fn countRelease(r: *MemRegion, block: *u8, bytes: usize) {
  if block as usize == 0usize { return; }
  let c = r as *Counting;
  (*c).releases = (*c).releases + 1usize;
  (*c).live = (*c).live - isize.from(bytes);
  libc.free(block);
}

fn countSize(r: *MemRegion, bytes: usize, align: usize) usize { bytes }

fn regionOf(c: &mut Counting) *MemRegion { (c as *Counting) as *MemRegion }

fn scratch() {
  var c = Counting(MemRegion(&countAlloc, &countResize, &countRelease, &countSize), 0usize, 0usize, 0isize);
  {
    var l = List[u32](1000usize, regionOf(&mut c));
    var seed = 12345u64;
    var i = 0usize;
    while i < 1000usize { l.push(u32.from(nextRand(&mut seed) % 100000u64)); i = i + 1usize; }
    l.sort();
    expect(c.allocs == 1usize && c.releases == 0usize && c.live == 4000isize, "1,000 random u32 sort() asks its region for no buffer");
    var ok = true;
    i = 1usize;
    while i < 1000usize { if l[i - 1usize] > l[i] { ok = false; } i = i + 1usize; }
    expect(ok, "and the list is in order");
  }
  {
    var l = List[u32](1000usize, regionOf(&mut c));
    var i = 0usize;
    while i < 1000usize { l.push(u32.from(1000usize - i)); i = i + 1usize; }
    l.sort();
    expect(c.allocs == 2usize && c.releases == 1usize && c.live == 4000isize, "1,000 reversed u32: no buffer either");
  }
}

// Not a number: stable
struct Rec {
  pub key: u32;
  pub id: u32;
}

fn recKey(r: &Rec) u32 { r.key }

fn structs() {
  var l = List[Rec]();
  var seed = 777u64;
  var i = 0usize;
  while i < 2000usize { l.push(Rec(u32.from(nextRand(&mut seed) % 5u64), u32.from(i))); i = i + 1usize; }
  l.sortByKey(&recKey);
  var ok = true;
  i = 1usize;
  while i < 2000usize {
    if l[i - 1usize].key > l[i].key { ok = false; }
    if l[i - 1usize].key == l[i].key && l[i - 1usize].id > l[i].id { ok = false; }
    i = i + 1usize;
  }
  expect(ok, "structs with equal keys keep their order");
}

fn floats() {
  var seed = 99u64;
  var a = List[f32]();
  var b = List[f32]();
  var i = 0usize;
  while i < 3000usize {
    var bits = u32.from(nextRand(&mut seed) & 4294967295u64);
    if i % 7usize == 0usize { bits = 0u32; }
    if i % 11usize == 0usize { bits = 2147483648u32; }
    let v = f32FromBits(bits);
    a.push(v);
    b.push(v);
    i = i + 1usize;
  }
  a.sort();
  b.sortBy(&byNatural[f32]);
  var ok = true;
  i = 0usize;
  while i < 3000usize { if bitsOf(a[i]) != bitsOf(b[i]) { ok = false; } i = i + 1usize; }
  expect(ok, "f32 sort() has the same bits as the stable '<=>' sort");
  var z = List[f32]();
  z.push(f32FromBits(0u32));
  z.push(f32FromBits(2147483648u32));
  z.push(f32FromBits(0u32));
  z.sort();
  expect(bitsOf(z[0usize]) == 2147483648u32 && bitsOf(z[1usize]) == 0u32 && bitsOf(z[2usize]) == 0u32, "-0.0 sorts before 0.0");
}

fn main() i32 {
  checkWidth(&toI8, "i8 sort() equals the stable sort");
  checkWidth(&toU8, "u8 sort() equals the stable sort");
  checkWidth(&toI16, "i16 sort() equals the stable sort");
  checkWidth(&toU16, "u16 sort() equals the stable sort");
  checkWidth(&toI32, "i32 sort() equals the stable sort");
  checkWidth(&toU32, "u32 sort() equals the stable sort");
  checkWidth(&toI64, "i64 sort() equals the stable sort");
  checkWidth(&toU64, "u64 sort() equals the stable sort");
  checkWidth(&toUsize, "usize sort() equals the stable sort");
  checkWidth(&toIsize, "isize sort() equals the stable sort");
  scratch();
  structs();
  floats();
  done()
}
