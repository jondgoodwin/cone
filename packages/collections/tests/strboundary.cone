// A range of text whose bound is inside a character is a program error, and a
// panic, reported at the line of the slice. "héllo" is h, é (the two bytes C3
// A9), l, l, o: a range may begin or end at byte 0, 1, 3, 4, 5 or 6, and byte 2
// is inside é. The first slice below is whole characters and prints; the second
// ends at byte 2, so this test's .out is the one line printed before it, its
// .exit a panic's and its .err the panic's line.

mod strboundary;

import stdio use *;

fn main() i32 {
  imm text = "héllo";
  imm head = &text[0usize..3usize];
  printStr("whole characters: ");
  printStr(head);
  printStr("\n");
  imm cut = &text[0usize..2usize];
  printStr("not reached: ");
  printStr(cut);
  printStr("\n");
  0i32;
}
