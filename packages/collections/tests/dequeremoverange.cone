// A Deque 'remove' of an index past the end is a program error, and a panic, after
// writing out what was printed before it: this test's .out is only the line printed
// before the bad index, its .exit a panic's, and its .err the panic's line, naming
// the line of the bad index. The deque's block has wrapped.

mod dequeremoverange;

import stdio use *;
import collections use *;

fn main() i32 {
  var d = Deque[i64]();
  d.push(2);
  d.push(3);
  d.pushFront(1);
  printStr("removing index 3 of 3\n");
  printInt(d.remove(3usize));
  printStr("not reached\n");
  0i32
}
