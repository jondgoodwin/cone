// 'reserve' asked for more values than a usize can count beyond those the
// list holds panics. 'used + more' would wrap round to a small number that
// fits the block, no room would be made, and the caller, who was promised
// 'more' values of room, would write past the block. The first line is
// written out before the call; the second would be written only if the
// program went on, and is not. The exit status is abort's on Windows,
// 0xC0000409, as the arena's tests/overflow.cone.

mod reserveoverflow;

import stdio use *;
import collections use *;
import libc;

fn main() i32 {
  var l = List[u8]();
  l.push(1u8);
  printStr("asking\n");
  libc.fflush(libc.stdout());
  l.reserve(0usize - 1usize);
  printStr("went on\n");
  libc.fflush(libc.stdout());
  0
}
