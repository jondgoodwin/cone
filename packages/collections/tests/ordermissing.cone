// Reading a key an OrderedDict does not hold is a program error, and a panic,
// as it is for a Dict: .err pins the panic's line.

mod ordermissing;

import stdio use *;
import collections use *;

fn main() i32 {
  mut d = OrderedDict[String, i64].empty();
  d.insert(String.from("core"), 1);
  printStr("reading a key it does not hold\n");
  printInt(*d["sdl"]);
  printStr("not reached\n");
  0i32;
}
