// OrderedDict visits its entries in the order they were first inserted, and
// that order is checked against a model, a List kept by hand, after every kind
// of change: inserts, an overwrite (which keeps the entry where it stands),
// removals in the front, the middle and the end, a swapping removal (which puts
// the last entry in the hole), growth, and clear. Every expected order is worked
// out by hand from those rules:
// - the block starts at 8 buckets, which hold 7 entries (7 in every 8
//   buckets), and doubles when an eighth arrives, so 100 entries need 128
//   buckets and 'capacity' says 112;
// - a removal moves each later entry down one place: the ones after it are
//   found one at a time by hash when they are fewer than an eighth of the
//   buckets, else the whole index is read, and 'bigRemovals' removes at both
//   ends of 1000 entries (in 2048 buckets, so 256 is the limit) to run both.

mod ordereddict;

import testing use *;
import collections use *;

// Whether an insert replaced an entry: the old value came back. It is dropped here,
// so a value with a finalizer dies here
fn wasHeld[T](old Option[T]) bool {
  match old {
    case is Some {true;}
    case is None {false;}
  }
}

struct Id is Hash {
  pub slot u32;
  pub gen u32;
  pub fn `==`(self, o Id) bool {slot == o.slot and gen == o.gen;}
}

fn main() i32 {
  words();
  growth();
  bigRemovals();
  manyRemovals();
  swapping();
  ids();
  bytesBridge();
  shared();
  seeds();
  rolling();
  done();
}

// The keys of a String-keyed dictionary in order, as "c a b"
fn order(d &OrderedDict[String, i64]) String {
  mut out = String.empty();
  mut c = d.keys();
  mut first = true;
  while true {
    match c.next() {
      case imm k Some {
        if not first { out.append(" "); }
        first = false;
        out.append(k.value.view());
      }
      case is None {break;}
    }
  }
  out;
}

// The values in order, as "1 2 3"
fn valueOrder(d &OrderedDict[String, i64]) String {
  mut out = String.empty();
  mut c = d.values();
  mut first = true;
  while true {
    match c.next() {
      case imm v Some {
        if not first { out.append(" "); }
        first = false;
        out.appendUInt(u64.from(*v.value));
      }
      case is None {break;}
    }
  }
  out;
}

// Keys with their values in order, as "c=1 a=2"
fn pairs(d &OrderedDict[String, i64]) String {
  mut out = String.empty();
  mut c = d.entries();
  mut first = true;
  while true {
    match c.next() {
      case imm e Some {
        if not first { out.append(" "); }
        first = false;
        out.append(e.value.key.view());
        out.append("=");
        out.appendUInt(u64.from(e.value.value));
      }
      case is None {break;}
    }
  }
  out;
}

fn words() {
  mut d = OrderedDict[String, i64].empty();
  expectUInt(u64.from(d.len()), 0, "empty length");
  expectUInt(u64.from(d.capacity()), 0, "empty capacity");
  expectBool(d.isEmpty(), true, "empty is empty");
  expectBool(d.contains("c"), false, "empty contains nothing");
  expect(isNone(d.remove("c")), "removing from empty");
  expect(isNone(d.swapRemove(&String.from("c"))), "swap removing from empty");
  expectStr(order(&d).view(), "", "no keys");

  expectBool(wasHeld(d.insert(String.from("c"), 1)), false, "c is new");
  expectBool(wasHeld(d.insert(String.from("a"), 2)), false, "a is new");
  expectBool(wasHeld(d.insert(String.from("b"), 3)), false, "b is new");
  expectUInt(u64.from(d.capacity()), 7, "the first entry makes 8 buckets, room for 7");
  expectStr(order(&d).view(), "c a b", "insertion order, not sorted");
  expectStr(pairs(&d).view(), "c=1 a=2 b=3", "keys with values");

  // An overwrite keeps the entry's place
  expectBool(wasHeld(d.insert(String.from("a"), 20)), true, "a is held");
  expectStr(order(&d).view(), "c a b", "an overwrite keeps its place");
  expectStr(valueOrder(&d).view(), "1 20 3", "with the new value");
  expectUInt(u64.from(d.len()), 3, "overwriting adds nothing");
  match d.insert(String.from("a"), 21) {
    case imm old Some {expectInt(old.value, 20, "an overwrite answers the old value");}
    case is None {expect(false, "an overwrite answers the old value");}
  }
  d.insert(String.from("a"), 20);

  // Removing from the front: the others close up
  match d.remove("c") {
    case imm v Some {expectInt(v.value, 1, "the removed value");}
    case is None {expect(false, "c was held");}
  }
  expectStr(order(&d).view(), "a b", "front removed");
  expectBool(d.contains("c"), false, "c is gone");
  expectInt(*d["a"], 20, "a after the shift");
  expectInt(*d["b"], 3, "b after the shift");

  // A key put back goes to the end
  d.insert(String.from("d"), 4);
  d.insert(String.from("c"), 5);
  expectStr(order(&d).view(), "a b d c", "appended at the end");

  // From the middle
  expect(not isNone(d.remove("b")), "b was held");
  expectStr(order(&d).view(), "a d c", "middle removed");
  expectStr(pairs(&d).view(), "a=20 d=4 c=5", "with their values");
  expectInt(*d["d"], 4, "d after the shift");
  expectInt(*d["c"], 5, "c after the shift");

  // From the end
  expect(not isNone(d.remove(&String.from("c"))), "c was held");
  expectStr(order(&d).view(), "a d", "end removed");
  expect(isNone(d.remove("c")), "c again");

  // A count kept in place, a new key at the end
  *d.getOrInsert(String.from("e"), 0) += 7;
  *d.getOrInsert(String.from("e"), 0) += 1;
  expectStr(pairs(&d).view(), "a=20 d=4 e=8", "getOrInsert adds at the end, once");
  *d.getOrInsert(String.from("a"), 0) += 1;
  expectStr(pairs(&d).view(), "a=21 d=4 e=8", "and changes a held value where it stands");
  match d.getMut("d") {
    case mut v Some {*v.value = 9;}
    case is None {expect(false, "getMut finds d");}
  }
  *&mut d["e"] += 1;
  expectStr(pairs(&d).view(), "a=21 d=9 e=9", "changed in place");

  // clear keeps the room and the order starts again
  d.clear();
  expectUInt(u64.from(d.len()), 0, "cleared");
  expectUInt(u64.from(d.capacity()), 7, "clear keeps the room");
  expectStr(order(&d).view(), "", "nothing to visit");
  d.insert(String.from("z"), 1);
  d.insert(String.from("y"), 2);
  expectStr(order(&d).view(), "z y", "a fresh order after clear");
  expectInt(*d["y"], 2, "y found");
}

fn isNone(o Option[i64]) bool {
  match o {
    case is Some[i64] {false;}
    case is None[i64] {true;}
  }
}

// The keys of a u64-keyed dictionary compared with the model: the same keys in
// the same order, and each found with its value, 3 times its key. It answers
// how many differ
fn mismatches(d &OrderedDict[u64, u64], model &List[u64]) i64 {
  mut wrong = 0i64;
  if d.len() != model.len() { wrong = wrong + 1i64; }
  mut c = d.keys();
  mut i = 0usize;
  while true {
    match c.next() {
      case imm k Some {
        if i >= model.len() or *k.value != *model[i] { wrong = wrong + 1i64; }
        i = i + 1usize;
      }
      case is None {break;}
    }
  }
  if i != model.len() { wrong = wrong + 1i64; }
  i = 0usize;
  while i < model.len() {
    match d.get(model[i]) {
      case imm v Some {if *v.value != *model[i] * 3u64 { wrong = wrong + 1i64; }}
      case is None {wrong = wrong + 1i64;}
    }
    i = i + 1usize;
  }
  wrong;
}

fn without(model &List[u64], key u64) List[u64] {
  mut out = List[u64].empty();
  mut i = 0usize;
  while i < model.len() {
    if *model[i] != key { out.push(*model[i]); }
    i = i + 1usize;
  }
  out;
}

// 100 keys inserted in a scrambled order, through the doublings, stay in that order
fn growth() {
  mut d = OrderedDict[u64, u64].empty();
  mut model = List[u64].empty();
  mut i = 0u64;
  while i < 100u64 {
    imm k = (i * 37u64) % 101u64;
    d.insert(k, k * 3u64);
    model.push(k);
    i = i + 1u64;
  }
  expectUInt(u64.from(d.len()), 100, "a hundred entries");
  expectUInt(u64.from(d.capacity()), 112, "four doublings from 7 to 112");
  expectInt(mismatches(&d, &model), 0, "the order of insertion, every key found");
  expectUInt(*model[0usize], 0, "the first in is 0");
  expectUInt(*model[1usize], 37, "then 37");
  // An overwrite of every tenth key moves nothing
  mut wrong = 0i64;
  i = 0u64;
  while i < 100u64 {
    imm k = *model[usize.from(i)];
    if not wasHeld(d.insert(k, k * 3u64)) { wrong = wrong + 1i64; }
    i = i + 10u64;
  }
  expectInt(wrong, 0, "each of those was held");
  expectInt(mismatches(&d, &model), 0, "overwrites keep every place");
  // Take out the second in, the first and the last (99 * 37 mod 101 = 27)
  expect(not isNone64(d.remove(&37u64)), "37 removed");
  expect(not isNone64(d.remove(&0u64)), "0 removed");
  expect(not isNone64(d.remove(&27u64)), "27 removed");
  model = without(&model, 37u64);
  model = without(&model, 0u64);
  model = without(&model, 27u64);
  expectInt(mismatches(&d, &model), 0, "the others in order after three removals");
  expectUInt(u64.from(d.len()), 97, "97 left");
}

fn bigRemovals() {
  mut d = OrderedDict[u64, u64].empty();
  mut model = List[u64].empty();
  mut i = 0u64;
  while i < 1000u64 {
    d.insert(i, i * 3u64);
    model.push(i);
    i = i + 1u64;
  }
  expectUInt(u64.from(d.capacity()), 1792, "1000 entries need 2048 buckets");
  expectInt(mismatches(&d, &model), 0, "1000 in order");
  // Near the front: 989 entries move, over the 256 limit, so the whole index is read
  expect(not isNone64(d.remove(&10u64)), "10 removed");
  model = without(&model, 10u64);
  expectInt(mismatches(&d, &model), 0, "after a removal near the front");
  // Near the end: 9 entries move, found one at a time
  expect(not isNone64(d.remove(&990u64)), "990 removed");
  model = without(&model, 990u64);
  expectInt(mismatches(&d, &model), 0, "after a removal near the end");
  // The very first and the very last
  expect(not isNone64(d.remove(&0u64)), "0 removed");
  expect(not isNone64(d.remove(&999u64)), "999 removed");
  model = without(&model, 0u64);
  model = without(&model, 999u64);
  expectInt(mismatches(&d, &model), 0, "after the first and the last");
  expectUInt(u64.from(d.len()), 996, "996 left");
  expectBool(d.contains(&10u64), false, "10 is gone");
  expectBool(d.contains(&990u64), false, "990 is gone");
}

fn isNone64(o Option[u64]) bool {
  match o {
    case is Some[u64] {false;}
    case is None[u64] {true;}
  }
}

// 3000 inserted, then every key but the multiples of 10 removed in ascending
// order, each removal at the front of what is left: lookups after many removals,
// through removed buckets and the shifts, and the 300 left in order
fn manyRemovals() {
  mut d = OrderedDict[u64, u64].empty();
  mut i = 0u64;
  while i < 3000u64 {
    d.insert(i, i * 3u64);
    i = i + 1u64;
  }
  mut wrong = 0i64;
  i = 0u64;
  while i < 3000u64 {
    if i % 10u64 != 0u64 {
      match d.remove(&i) {
        case imm v Some {if v.value != i * 3u64 { wrong = wrong + 1i64; }}
        case is None {wrong = wrong + 1i64;}
      }
    }
    i = i + 1u64;
  }
  expectInt(wrong, 0, "every removal answered the value it held");
  expectUInt(u64.from(d.len()), 300, "300 left");
  mut model = List[u64].empty();
  i = 0u64;
  while i < 3000u64 {
    model.push(i);
    i = i + 10u64;
  }
  expectInt(mismatches(&d, &model), 0, "the multiples of ten, in order, all found");
  i = 0u64;
  while i < 3000u64 {
    if d.contains(&i) != (i % 10u64 == 0u64) { wrong = wrong + 1i64; }
    i = i + 1u64;
  }
  expectInt(wrong, 0, "only the multiples of ten are held");
  // Put the others back: they go to the end, in the order they come
  i = 1u64;
  while i < 3000u64 {
    if i % 10u64 != 0u64 { d.insert(i, i * 3u64); model.push(i); }
    i = i + 1u64;
  }
  expectUInt(u64.from(d.len()), 3000, "all 3000 again");
  expectInt(mismatches(&d, &model), 0, "300 first, then the rest in the order put back");
}

fn orderOf(d &OrderedDict[u64, i64]) String {
  mut out = String.empty();
  mut c = d.keys();
  mut first = true;
  while true {
    match c.next() {
      case imm k Some {
        if not first { out.append(" "); }
        first = false;
        out.appendUInt(*k.value);
      }
      case is None {break;}
    }
  }
  out;
}

// A swapping removal puts the last entry in the hole, which is not the order of
// insertion
fn swapping() {
  mut d = OrderedDict[u64, i64].empty();
  mut k = 1u64;
  while k <= 5u64 {
    d.insert(k, i64.from(k) * 10);
    k = k + 1u64;
  }
  expectStr(orderOf(&d).view(), "1 2 3 4 5", "five in order");
  match d.swapRemove(&2u64) {
    case imm v Some {expectInt(v.value, 20, "2's value");}
    case is None {expect(false, "2 was held");}
  }
  expectStr(orderOf(&d).view(), "1 5 3 4", "5 took 2's place");
  expectInt(*d[&5u64], 50, "5 found after the move");
  expectInt(*d[&4u64], 40, "4 found");
  expect(not isNone(d.swapRemove(&4u64)), "4 was held");
  expectStr(orderOf(&d).view(), "1 5 3", "the last one removed: nothing moves");
  expect(not isNone(d.swapRemove(&1u64)), "1 was held");
  expectStr(orderOf(&d).view(), "3 5", "3, the last, took the front");
  expectInt(*d[&3u64], 30, "3 found");
  expectInt(*d[&5u64], 50, "5 found");
  expect(isNone(d.swapRemove(&7u64)), "7 was never held");
  expect(not isNone(d.swapRemove(&3u64)), "3 removed");
  expect(not isNone(d.swapRemove(&5u64)), "5 removed");
  expectStr(orderOf(&d).view(), "", "empty");
  d.insert(8u64, 80);
  expectStr(orderOf(&d).view(), "8", "and used again");
}

// Ids as keys, whose hash the compiler supplies
fn ids() {
  mut d = OrderedDict[Id, i64].empty();
  mut i = 0u32;
  while i < 200u32 {
    d.insert(new Id(199u32 - i, i % 3u32), i64.from(i));
    i = i + 1u32;
  }
  expectUInt(u64.from(d.len()), 200, "two hundred ids");
  mut wrong = 0i64;
  mut c = d.entries();
  i = 0u32;
  while true {
    match c.next() {
      case imm e Some {
        if e.value.key.slot != 199u32 - i or e.value.value != i64.from(i) { wrong = wrong + 1i64; }
        i = i + 1u32;
      }
      case is None {break;}
    }
  }
  expectInt(wrong, 0, "visited in the order they went in");
  i = 0u32;
  while i < 200u32 {
    if *d[&new Id(199u32 - i, i % 3u32)] != i64.from(i) { wrong = wrong + 1i64; }
    if d.contains(&new Id(199u32 - i, i % 3u32 + 1u32)) { wrong = wrong + 1i64; }
    i = i + 1u32;
  }
  expectInt(wrong, 0, "each id finds its own value, and not another generation's");
  // Remove every second one, in the order they were put in
  i = 0u32;
  while i < 200u32 {
    if isNone(d.remove(&new Id(199u32 - i, i % 3u32))) { wrong = wrong + 1i64; }
    i = i + 2u32;
  }
  expectInt(wrong, 0, "a hundred removed");
  c = d.entries();
  i = 1u32;
  while true {
    match c.next() {
      case imm e Some {
        if e.value.key.slot != 199u32 - i or e.value.value != i64.from(i) { wrong = wrong + 1i64; }
        i = i + 2u32;
      }
      case is None {break;}
    }
  }
  expectInt(wrong, 0, "the odd ones left, in order");
  expectUInt(u64.from(i), 201, "a hundred were visited");
}

// A String key found by bytes, a literal or a view, with no String built
fn bytesBridge() {
  mut d = OrderedDict[String, i64].empty();
  d.insert(String.from("core"), 1);
  d.insert(String.from("stdio"), 2);
  d.insert(String.from("libc"), 3);
  expectBool(d.contains("stdio"), true, "contains, by bytes");
  expectBool(d.contains("std"), false, "not a prefix of a key");
  imm libc = String.from("libc");
  expectBool(d.contains(libc.view()), true, "by a view");
  expectBool(d.contains(&libc), true, "by a String");
  match d.get("libc") {
    case imm v Some {expectInt(*v.value, 3, "get, by bytes");}
    case is None {expect(false, "get, by bytes");}
  }
  match d.getCopy("core") {
    case imm v Some {expectInt(v.value, 1, "a copy of the value");}
    case is None {expect(false, "a copy of the value");}
  }
  match d.getMut("stdio") {
    case mut v Some {*v.value = 20;}
    case is None {expect(false, "getMut finds stdio");}
  }
  expectInt(*d["stdio"], 20, "changed through getMut");
  *&mut d["core"] += 10;
  expectStr(pairs(&d).view(), "core=11 stdio=20 libc=3", "in order, changed in place");
  match d.remove("stdio") {
    case imm v Some {expectInt(v.value, 20, "removed by bytes");}
    case is None {expect(false, "removed by bytes");}
  }
  expectStr(order(&d).view(), "core libc", "the others close up");
  expectInt(*d["libc"], 3, "libc after the shift");
  expect(isNone(d.remove("stdio")), "removed once");
}

// Through a shared owner: insert, contains, len and a copy of a value
fn shared() {
  imm a = new Rc[mut, OrderedDict[u64, i64]](OrderedDict[u64, i64].empty());
  imm one = 1u64;
  imm two = 2u64;
  imm nine = 9u64;
  a.insert(two, 20);
  imm b = a;
  b.insert(one, 10);
  expectUInt(u64.from(a.len()), 2, "both owners see two entries");
  expectBool(a.contains(&two), true, "contains through a shared owner");
  match a.getCopy(&one) {
    case imm v Some {expectInt(v.value, 10, "a copy of a value through a shared owner");}
    case is None {expect(false, "a copy of a value through a shared owner");}
  }
  match b.getCopy(&nine) {
    case is Some[i64] {expect(false, "no copy of a missing key");}
    case is None[i64] {expect(true, "no copy of a missing key");}
  }
}

// The order of iteration is the order of insertion whatever the seed
fn seeds() {
  mut a = OrderedDict[u64, i64].deterministic();
  mut b = OrderedDict[u64, i64].withSeed(7u64);
  mut c = OrderedDict[u64, i64].empty();
  mut k = 0u64;
  while k < 60u64 {
    a.insert(k * 31u64 % 61u64, 0);
    b.insert(k * 31u64 % 61u64, 0);
    c.insert(k * 31u64 % 61u64, 0);
    k = k + 1u64;
  }
  expectStr(orderOf(&a).view(), orderOf(&b).view(), "two seeds, one order");
  expectStr(orderOf(&a).view(), orderOf(&c).view(), "and the process's seed");
  expectStr(&orderOf(&a).view()[0usize..14usize], "0 31 1 32 2 33", "k * 31 mod 61 from 0: 0 31 1 32 2 33 ...");
}

// A dictionary that holds eight and is fed sixty: each key out as the one eight
// later goes in, so removed buckets pile up and the index is rebuilt at its own
// size, and the eight left are the last eight in, in order
fn rolling() {
  mut d = OrderedDict[u64, i64].empty();
  mut k = 1u64;
  while k <= 60u64 {
    d.insert(k, i64.from(k));
    if k > 8u64 {
      imm old = k - 8u64;
      if isNone(d.remove(&old)) { expect(false, "the key eight back was held"); }
    }
    k = k + 1u64;
  }
  expectStr(orderOf(&d).view(), "53 54 55 56 57 58 59 60", "the last eight, in order");
  expect(d.capacity() <= 14usize, "it never grew past 16 buckets");
  expectInt(*d[&60u64], 60, "the newest found");
  expectInt(*d[&53u64], 53, "the oldest found");
}
