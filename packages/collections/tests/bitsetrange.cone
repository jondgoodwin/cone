// An index past a BitSet's length is a panic naming the caller's line: 'get(10)' on 10 flags
// (the bits of the last word past the count are not the set's)

mod bitsetrange;

import stdio use *;
import collections use *;

fn main() i32 {
  let b = BitSet(10usize);
  printStr("reading flag 10 of 10\n");
  if b.get(10usize) { printStr("set\n"); }
  printStr("not reached\n");
  0i32
}
