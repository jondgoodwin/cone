// The stable sort of core's Array[T], reached on a List: sort, sortBy, sortByKey.
//
// What each check means (every printed line was worked out against the source):
// - The differential: for each of eight input patterns (random, already sorted, reversed,
//   four distinct values, an organ pipe, all equal, many ascending runs of 37, nearly sorted)
//   and every size 0 to 300, then a spread up to 100,000, a list of 40-byte structs keyed by a
//   u32 that collides often, each carrying its position as an id, is sorted by sortBy. The
//   expected order is the ids sorted by (key, id): that is exactly what stability means, since
//   the ids rise with the original positions. Up to size 300 that order is made by a plain
//   insertion sort written here; above it by sortUnstable of the (key, id) pairs packed in a
//   u64, which are all different, so the unstable sort has one answer. The filler of each struct
//   travels with its key.
// - u32 and f32 (made from random bits: NaNs of both signs, both zeros) under sort() against the
//   same u64-free comparison: sortUnstable's result, which for those types is the same bits.
// - The comparison counter: at most n * (log2 n + 1) + 6 * n comparisons on each pattern (a merge
//   or run slip that sorts correctly but slowly is caught here; measured at 100,000: 1.0 n log2 n
//   on random input); input already in order, reversed or all equal takes n - 1 or fewer, so at
//   most n.
// - A region counts what the sort asks of it: a list of 1,000 structs made in a counting region
//   sorts with one allocation of 500 structs (20,000 bytes) and one release, nothing when the
//   input is already in order, nothing at 20 values.
// - Strings sort() by '<=>' and sortByKey keeps ties in their order.

mod sortstable;

import testing use *;
import collections use *;
import libc;

var @threadlocal calls = 0usize;

fn nextRand(s: &mut u64) u64 {
  var x = *s;
  x = x ^ (x << 13u64);
  x = x ^ (x >> 7u64);
  x = x ^ (x << 17u64);
  *s = x;
  x
}

fn f32FromBits(bits: u32) f32 {
  var b = bits;
  *((&mut b) as *u32 as *f32)
}

// 40 bytes: a key to sort by, an id that says which one it is, and filler
struct Rec {
  pub key: u32;
  pub id: u32;
  pub a: u64;
  pub b: u64;
  pub c: u64;
  pub d: u64;
}

fn recOrder(a: &Rec, b: &Rec) i32 {
  calls = calls + 1usize;
  a.key <=> b.key
}

fn recKey(r: &Rec) u32 { r.key }

// The value at position i of n for a pattern: 0 random, 1 sorted, 2 reversed, 3 four distinct
// values, 4 an organ pipe, 5 all equal, 6 ascending runs of 37, 7 nearly sorted
fn patternValue(kind: i32, i: usize, n: usize, s: &mut u64) u32 {
  let r = u32.from(nextRand(s) >> 40u64);
  if kind == 0 { r }
  else if kind == 1 { u32.from(i) }
  else if kind == 2 { u32.from(n - i) }
  else if kind == 3 { r % 4u32 }
  else if kind == 4 { if i < n / 2usize { u32.from(i) } else { u32.from(n - i) } }
  else if kind == 5 { 7u32 }
  else if kind == 6 { u32.from(i % 37usize) * 3u32 + r % 3u32 }
  else { if r % 50u32 == 0u32 { r % 1000u32 } else { u32.from(i) / 2u32 } }
}

fn lg(n: usize) usize {
  var l = 1usize;
  var m = n;
  while m > 1usize { m = m / 2usize; l = l + 1usize; }
  l
}

fn bound(n: usize) usize { n * lg(n) + 6usize * n }

// Is the pattern one that is one run (so n - 1 comparisons)?
fn oneRun(kind: i32) bool { kind == 1i32 || kind == 2i32 || kind == 5i32 }

fn makeRecs(kind: i32, n: usize, seed: u64) List[Rec] {
  var s = seed;
  var l = List[Rec]();
  var i = 0usize;
  while i < n {
    let k = patternValue(kind, i, n, &mut s);
    l.push(Rec(k, u32.from(i), 1u64, 2u64, 3u64, u64.from(k)));
    i = i + 1usize;
  }
  l
}

fn pack(r: &Rec) u64 { (u64.from(r.key) << 32u64) | u64.from(r.id) }

// The packed (key, id) pairs in order, by insertion sort when small and sortUnstable above
fn expected(l: &List[Rec]) List[u64] {
  var w = List[u64]();
  var i = 0usize;
  while i < l.len() { w.push(pack(&l[i])); i = i + 1usize; }
  if w.len() <= 300usize {
    i = 1usize;
    while i < w.len() {
      var j = i;
      while j > 0usize && w[j - 1usize] > w[j] {
        let t = w[j];
        w[j] = w[j - 1usize];
        w[j - 1usize] = t;
        j = j - 1usize;
      }
      i = i + 1usize;
    }
  }
  else {
    w.sortUnstable();
  }
  w
}

// Does the list hold exactly the expected sequence, its filler with its key?
fn matches(l: &List[Rec], want: &List[u64]) bool {
  if l.len() != want.len() { return false; }
  var i = 0usize;
  while i < l.len() {
    if pack(&l[i]) != want[i] { return false; }
    if l[i].d != u64.from(l[i].key) || l[i].a != 1u64 || l[i].c != 3u64 { return false; }
    i = i + 1usize;
  }
  true
}

fn checkRec(kind: i32, n: usize, seed: u64) i32 {
  let src = makeRecs(kind, n, seed);
  let want = expected(&src);
  var bad = 0i32;
  var a = makeRecs(kind, n, seed);
  calls = 0usize;
  a.sortBy(&recOrder);
  if !matches(&a, &want) { bad = bad + 1i32; }
  // a debug build checks the result against the order too, n - 1 more comparisons
  let extra = if isDebugBuild() { n } else { 0usize };
  if calls > bound(n) + extra { bad = bad + 100i32; }
  // (up to 20 values it is an insertion sort, which takes n (n - 1) / 2 on reversed input)
  if oneRun(kind) && n > 20usize && calls > n + extra { bad = bad + 1000i32; }
  var b = makeRecs(kind, n, seed);
  b.sortByKey(&recKey);
  if !matches(&b, &want) { bad = bad + 1i32; }
  bad
}

fn checkU32(kind: i32, n: usize, seed: u64) i32 {
  var s = seed;
  var l = List[u32]();
  var i = 0usize;
  while i < n { l.push(patternValue(kind, i, n, &mut s)); i = i + 1usize; }
  var want = List[u32]();
  i = 0usize;
  while i < n { want.push(l[i]); i = i + 1usize; }
  want.sortUnstable();
  l.sort();
  var bad = 0i32;
  i = 0usize;
  while i < n {
    if l[i] != want[i] { bad = bad + 1i32; }
    i = i + 1usize;
  }
  bad
}

fn checkF32(kind: i32, n: usize, seed: u64) i32 {
  var s = seed;
  var l = List[f32]();
  var i = 0usize;
  while i < n {
    let v = patternValue(kind, i, n, &mut s);
    var bits = v * 2654435761u32;
    if kind == 1 || kind == 2 || kind == 4 { bits = v; }
    if i % 7usize == 0usize { bits = 0x80000000u32; }
    if i % 11usize == 0usize { bits = 0u32; }
    if i % 13usize == 0usize { bits = 0x7FC00000u32 + v; }
    if i % 17usize == 0usize { bits = 0xFFC00000u32 + v; }
    l.push(f32FromBits(bits));
    i = i + 1usize;
  }
  var want = List[f32]();
  i = 0usize;
  while i < n { want.push(l[i]); i = i + 1usize; }
  want.sortUnstable();
  l.sort();
  var bad = 0i32;
  i = 0usize;
  while i < n {
    // equal under total order is the same bits: compare by <=>, which is 0 only for those
    if (l[i] <=> want[i]) != 0i32 { bad = bad + 1i32; }
    i = i + 1usize;
  }
  bad
}

fn differential() {
  var bad = 0i32;
  var kind = 0i32;
  var sorts = 0i32;
  while kind < 8i32 {
    var n = 0usize;
    while n <= 300usize {
      bad = bad + checkRec(kind, n, 6364136223846793005u64 + u64.from(n));
      bad = bad + checkU32(kind, n, 88172645463325252u64 + u64.from(n));
      bad = bad + checkF32(kind, n, 1442695040888963407u64 + u64.from(n));
      sorts = sorts + 4i32;
      n = n + 1usize;
    }
    kind = kind + 1i32;
  }
  expectInt(i64.from(bad), 0i64, "sizes 0 to 300, eight patterns, three element types: order, stability, comparison counts");
  expectInt(i64.from(sorts), 9632i64, "the sorts run");
  bad = 0i32;
  kind = 0i32;
  while kind < 8i32 {
    bad = bad + checkRec(kind, 1000usize, 99u64 + u64.from(kind));
    bad = bad + checkRec(kind, 4096usize, 77u64 + u64.from(kind));
    bad = bad + checkRec(kind, 100000usize, 55u64 + u64.from(kind));
    bad = bad + checkU32(kind, 100000usize, 33u64 + u64.from(kind));
    bad = bad + checkF32(kind, 20000usize, 11u64 + u64.from(kind));
    kind = kind + 1i32;
  }
  expectInt(i64.from(bad), 0i64, "1,000 to 100,000 values, eight patterns");
}

// A counting region: its header first, then the tallies
struct Counting {
  header: MemRegion;
  allocs: usize;
  releases: usize;
  live: isize;
}

fn countAlloc(r: *MemRegion, bytes: usize, align: usize) *u8 {
  let c = r as *Counting;
  (*c).allocs = (*c).allocs + 1usize;
  (*c).live = (*c).live + isize.from(bytes);
  libc.malloc(bytes)
}

fn countResize(r: *MemRegion, block: *u8, oldBytes: usize, newBytes: usize, align: usize) *u8 {
  let c = r as *Counting;
  (*c).live = (*c).live + isize.from(newBytes) - isize.from(oldBytes);
  libc.realloc(block, newBytes)
}

fn countRelease(r: *MemRegion, block: *u8, bytes: usize) {
  if block as usize == 0usize { return; }
  let c = r as *Counting;
  (*c).releases = (*c).releases + 1usize;
  (*c).live = (*c).live - isize.from(bytes);
  libc.free(block);
}

fn countSize(r: *MemRegion, bytes: usize, align: usize) usize { bytes }

fn newCounting() Counting {
  Counting(MemRegion(&countAlloc, &countResize, &countRelease, &countSize), 0usize, 0usize, 0isize)
}

fn regionOf(c: &mut Counting) *MemRegion { (c as *Counting) as *MemRegion }

fn tally(c: &Counting, allocs: u64, releases: u64, live: i64, label: &Array[u8]) {
  let ok = u64.from(c.allocs) == allocs && u64.from(c.releases) == releases && i64.from(c.live) == live;
  expect(ok, label);
}

// A list in a counting region, made with room for n at once, filled by a pattern
fn recsIn(c: &mut Counting, kind: i32, n: usize) List[Rec] {
  let src = makeRecs(kind, n, 4242u64);
  var l = List[Rec](n, regionOf(c));
  var i = 0usize;
  while i < n { l.push(Rec(src[i].key, src[i].id, 1u64, 2u64, 3u64, u64.from(src[i].key))); i = i + 1usize; }
  l
}

fn regions() {
  var c = newCounting();
  {
    var l = recsIn(&mut c, 0i32, 1000usize);
    tally(&c, 1, 0, 40000, "a list of 1,000 structs: its one block of 40,000 bytes");
    l.sortBy(&recOrder);
    tally(&c, 2, 1, 40000, "sorting asked its own region for one block of 500 structs (20,000 bytes) and gave it back");
    let want = expected(&l);
    expect(matches(&l, &want) && l.len() == 1000usize, "and the list is in order");
    l.sortBy(&recOrder);
    tally(&c, 2, 1, 40000, "sorting what is in order asks for nothing");
  }
  tally(&c, 2, 2, 0, "the list's death gave its block back");
  {
    var l = recsIn(&mut c, 0i32, 20usize);
    l.sortBy(&recOrder);
    tally(&c, 3, 2, 800, "20 values: no buffer");
    var m = recsIn(&mut c, 2i32, 1000usize);
    m.sortBy(&recOrder);
    tally(&c, 4, 2, 40800, "1,000 reversed: one run, reversed in place, no buffer");
    var k = recsIn(&mut c, 0i32, 1000usize);
    k.sortByKey(&recKey);
    tally(&c, 6, 3, 80800, "sortByKey takes its buffer from the list's region too");
  }
  tally(&c, 6, 6, 0, "all gave their blocks back");
}

fn strings() {
  var l = List[String]();
  l.push(String.from("pear"));
  l.push(String.from("apple"));
  l.push(String.from("fig"));
  l.push(String.from("banana"));
  l.push(String.from("cherry"));
  l.push(String.from("kiwi"));
  l.push(String.from("date"));
  l.sort();
  expectStr(l[0usize].view(), "apple", "String sort: first");
  expectStr(l[6usize].view(), "pear", "String sort: last");
  expectInt(if l.isSorted() { 1i64 } else { 0i64 }, 1i64, "Strings are sorted");
  // by length: ties keep their order from the sorted list (date before kiwi before pear; apple before ...)
  l.sortByKey(fn(s: &String) usize { s.len() });
  expectStr(l[0usize].view(), "fig", "by length: the 3-letter one");
  expectStr(l[1usize].view(), "date", "by length: 4 letters, ties as they were: date");
  expectStr(l[2usize].view(), "kiwi", "by length: then kiwi");
  expectStr(l[3usize].view(), "pear", "by length: then pear");
  expectStr(l[4usize].view(), "apple", "by length: 5 letters: apple");
  expectStr(l[5usize].view(), "banana", "by length: 6 letters, banana before cherry");
  expectStr(l[6usize].view(), "cherry", "by length: cherry");
}

// The same sort on an array that is not a list: a fixed array, and a slice of one
fn arrays() {
  var a = [9u32, 3u32, 7u32, 3u32, 1u32, 8u32];
  a.sort();
  expectInt(i64.from(a[0usize]), 1i64, "a fixed array sorts: first");
  expectInt(i64.from(a[5usize]), 9i64, "a fixed array sorts: last");
  var l = List[i32]() <- 5i32, 4i32, 3i32, 2i32, 1i32, 0i32;
  l.sliceMut(1usize, 5usize).sort();
  expectInt(i64.from(l[0usize]), 5i64, "a slice sorts: the first is left alone");
  expectInt(i64.from(l[1usize]), 1i64, "a slice sorts: 1");
  expectInt(i64.from(l[4usize]), 4i64, "a slice sorts: 4");
  expectInt(i64.from(l[5usize]), 0i64, "a slice sorts: the last is left alone");
}

fn main() i32 {
  differential();
  regions();
  strings();
  arrays();
  done()
}
