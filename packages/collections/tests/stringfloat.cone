// A float appended to a String is core's FloatText, the shortest text that
// reads back as it: '<-' of an f64, and 'appendF32' for an f32's own shortest
// text. Each expected text is Python's repr of the f64 (numpy's of the f32).

mod stringfloat;

import stdio use *;
import collections use *;

fn main() {
  var s = String.from("ratio ");
  s <- 0.1 + 0.2, ", one ", 1.0, ", big ", 1e300, ", tiny ", -5e-324;
  s <- ", f32 ";
  s.appendF32(0.1f32);
  s <- ", f32 widened ";
  s.appendF64(f64.from(0.1f32));
  s <- "\n";
  printStr(s.view());
}
