// An index past a list's end is a program error, and a panic, after writing
// out what was printed before it: this test's .out is only the line printed
// before the bad index, its .exit a panic's, and its .err the panic's line,
// naming the line of the bad index: 'list[i]' reports its caller's location,
// as 'panic' does.

mod outofrange;

import stdio use *;
import collections use *;

fn main() i32 {
  mut l = List[i64].empty();
  l.push(1);
  l.push(2);
  l.push(3);
  printStr("reading index 3 of 3\n");
  printInt(*l[3usize]);
  printStr("not reached\n");
  0i32;
}
