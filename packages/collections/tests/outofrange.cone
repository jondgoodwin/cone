// An index past a list's end is a program error: the list prints what was
// wrong to stderr and ends the program with exit status 1, after writing out
// what was printed before it. 'congo test' compares stdout, so this test's
// output is only the line printed before the bad index, and its .exit is 1.
// (stderr, unchecked here, says: collections: index 3 is out of range for a
// length of 3.)

mod outofrange;

import stdio use *;
import collections use *;

fn main() i32 {
  mut l = List[i64].empty();
  l.push(1);
  l.push(2);
  l.push(3);
  printStr("reading index 3 of 3\n");
  printInt(*l[3usize]);
  printStr("not reached\n");
  0i32;
}
