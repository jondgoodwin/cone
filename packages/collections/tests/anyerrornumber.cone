// A number's error goes through '?' into an AnyError: NumberConvError is an enum, and its
// toText is written 'self: &', so each variant meets Error. The values are the messages
// NumberConvError gives for each case, read back through the AnyError.

mod anyerrornumber;

import testing use *;
import collections use *;

fn plusOne(text: &str) Result[i32, AnyError] {
  let n = i32.parse(text)?;
  Ok[i32, AnyError](n + 1i32)
}

fn narrow(x: i64) Result[u8, AnyError] {
  let n = u8.tryFrom(x)?;
  Ok[u8, AnyError](n)
}

fn main() i32 {
  expectInt(i64.from(plusOne("41").unwrap()), 42, "an Ok passes through ?");
  let empty = plusOne("").error().unwrap();
  expectStr(empty.message().view(), "no number in empty text", "the empty text's message");
  let junk = plusOne("4x").error().unwrap();
  expectStr(junk.message().view(), "invalid character in number text", "the junk's message");
  let big = plusOne("99999999999").error().unwrap();
  expectStr(big.message().view(), "number too large for the type", "past the type's top");
  expectInt(i64.from(narrow(200i64).unwrap()), 200, "tryFrom's Ok passes through ?");
  let wide = narrow(300i64).error().unwrap();
  expectStr(wide.message().view(), "number too large for the type", "tryFrom's error through ?");
  expectBool(wide.source() is None, true, "and it has no source");
  done()
}
