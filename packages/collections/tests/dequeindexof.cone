// Deque 'contains' and 'indexOf' (where T is Eq): the first match counted from the front, None when
// absent. Hand-worked: pushFront 1, 2, 3 into a fresh deque (block of 4, head 0) puts 1 in slot 3,
// 2 in slot 2 and 3 in slot 1, so the order from the front is 3, 2, 1 and the ring wraps.

mod dequeindexof;

import testing use *;
import collections use *;

fn at(d: &Deque[i64], x: i64) i64 {
  match d.indexOf(&x) {
    case let Some(i) {i64.from(i)}
    case is None {-1i64}
  }
}

fn empty() {
  var d = Deque[i64]();
  expect(!d.contains(&5i64), "an empty deque holds nothing");
  expectInt(at(&d, 5i64), -1i64, "and indexOf is None");
}

fn found() {
  var d = Deque[i64]();
  d.push(10i64);
  d.push(20i64);
  d.push(30i64);
  expectInt(at(&d, 10i64), 0i64, "the front is position 0");
  expectInt(at(&d, 30i64), 2i64, "the back is the last position");
  expect(d.contains(&20i64), "contains finds the middle");
  expectInt(at(&d, 99i64), -1i64, "a missing value is None");
  expect(!d.contains(&99i64), "and not contained");
}

fn wrapped() {
  var d = Deque[i64]();
  d.pushFront(1i64);
  d.pushFront(2i64);
  d.pushFront(3i64);
  expectInt(at(&d, 3i64), 0i64, "3 is first from the front");
  expectInt(at(&d, 1i64), 2i64, "1 is last, in the block's last slot");
  d.push(4i64);
  expectInt(at(&d, 4i64), 3i64, "a value pushed at the back wraps round to slot 0");
  d.popFront();
  expectInt(at(&d, 3i64), -1i64, "a value taken from the front is gone");
  expectInt(at(&d, 2i64), 0i64, "and the next is the front");
  expectInt(at(&d, 4i64), 2i64, "positions count from the new front");
  expect(d.contains(&1i64), "contains sees the wrapped values");
}

fn duplicates() {
  var d = Deque[i64]();
  d.push(7i64);
  d.push(8i64);
  d.push(7i64);
  d.push(8i64);
  expectInt(at(&d, 7i64), 0i64, "the first of two sevens");
  expectInt(at(&d, 8i64), 1i64, "the first of two eights");
  d.popFront();
  expectInt(at(&d, 7i64), 1i64, "after the front goes, the later seven is first");
  d.pushFront(8i64);
  d.pushFront(9i64);
  expectInt(at(&d, 8i64), 1i64, "a wrapped duplicate: the front-most eight");
}

fn main() i32 {
  empty();
  found();
  wrapped();
  duplicates();
  done()
}
