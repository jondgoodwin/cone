// PriorityQueue[P, T]: a binary min-heap over two parallel lists, priorities and
// items, that pops the least priority first. Every expected value is worked out
// by hand from the rules:
// - the worked example pushes priorities 5, 3, 8 (items 50, 30, 80): the queue
//   pops 3, 5, 8 in that order, then None; peek borrows the 3 without removing it;
// - the random tests use a fixed generator, x -> (x * 1103515245 + 12345) mod 2^31,
//   whose priorities are the top bits mod 1000; an item is always its priority
//   times 3, so a pop that returns a priority with another's item is caught.
//   10,000 pushes then 10,000 pops come out equal to the same priorities sorted
//   by List.sortBy; then 20,000 operations, two pushes to a pop, are checked
//   against a table of how many of each priority the queue should hold: the pop
//   is the least priority with a count above 0;
// - float priorities without a NaN are ordered by value; equal priorities pop in
//   no promised order, so only their priorities are checked, and the items of ties
//   are checked as a set (items 3 and 7 share 1.0: both come out, the sum is 10);
// - a NaN priority's place is unspecified: with NaNs in, all 12 pairs still come
//   out exactly once (items 1 to 12 sum to 78, and their bits to 8190);
// - a Move item with a 'final' dies exactly once: by pop (at the match arm's
//   end), by clear, or with the queue; nothing is finalized by growing or sifting;
//   the count of finals equals the count of items made, and LSan sees no leak;
// - a queue made in an arena takes its blocks from the arena; priorities that are
//   a struct with '<=>' are ordered by it (ties by the second field).

mod pqueue;

import testing use *;
import arena use *;
import collections use *;

fn step(x: u64) u64 { (x * 1103515245u64 + 12345u64) % 2147483648u64 }

fn prioOf(x: u64) i64 { i64.from((x >> 8u64) % 1000u64) }

fn worked() {
  var q = PriorityQueue[i32, u32]();
  expect(q.isEmpty(), "new queue is empty");
  q.push(5, 50u32);
  q.push(3, 30u32);
  q.push(8, 80u32);
  expectUInt(u64.from(q.len()), 3, "three pushed");
  match q.peek() {
    case let Some(pair) {
      let p, t = pair;
      expectInt(i64.from(*p), 3, "peek priority");
      expectUInt(u64.from(*t), 30, "peek item");
    }
    case is None {expect(false, "peek");}
  }
  expectUInt(u64.from(q.len()), 3, "peek removes nothing");
  match q.pop() {
    case let Some(pair) {
      let p, t = pair;
      expectInt(i64.from(p), 3, "first pop priority");
      expectUInt(u64.from(t), 30, "first pop item");
    }
    case is None {expect(false, "first pop");}
  }
  match q.pop() {
    case let Some(pair) {
      let p, t = pair;
      expectInt(i64.from(p), 5, "second pop priority");
      expectUInt(u64.from(t), 50, "second pop item");
    }
    case is None {expect(false, "second pop");}
  }
  match q.pop() {
    case let Some(pair) {
      let p, t = pair;
      expectInt(i64.from(p), 8, "third pop priority");
      expectUInt(u64.from(t), 80, "third pop item");
    }
    case is None {expect(false, "third pop");}
  }
  expect(q.isEmpty(), "empty again");
  match q.pop() {
    case let Some(pair) {expect(false, "pop of an empty queue");}
    case is None {expect(true, "pop of an empty queue is None");}
  }
  match q.peek() {
    case let Some(pair) {expect(false, "peek of an empty queue");}
    case is None {expect(true, "peek of an empty queue is None");}
  }
}

// Pop everything, checking the order and that each item went with its priority;
// the number popped
fn drainChecked(q: &mut PriorityQueue[i64, i64], sorted: &List[i64]) {
  var i = 0usize;
  var ordered = true;
  var paired = true;
  var more = true;
  while more {
    match q.pop() {
      case let Some(pair) {
        let p, t = pair;
        if p != *sorted[i] { ordered = false; }
        if t != p * 3i64 { paired = false; }
        i = i + 1usize;
      }
      case is None {more = false;}
    }
  }
  expectUInt(u64.from(i), u64.from(sorted.len()), "every pair came out");
  expect(ordered, "popped in the sorted order");
  expect(paired, "each item came out with its own priority");
}

fn randomSorted() {
  var q = PriorityQueue[i64, i64]();
  var sorted = List[i64].empty();
  var x = 12345u64;
  var i = 0;
  while i < 10000 {
    x = step(x);
    let p = prioOf(x);
    q.push(p, p * 3i64);
    sorted.push(p);
    i = i + 1;
  }
  expectUInt(u64.from(q.len()), 10000, "10,000 pushed");
  sorted.sortBy((a, b) => if *a < *b {-1i32} else if *a > *b {1i32} else {0i32});
  drainChecked(&mut q, &sorted);
  expect(q.isEmpty(), "drained");
}

fn randomInterleaved() {
  var q = PriorityQueue[i64, i64]();
  var counts = List[i64](1000usize) <- fill 0i64;
  var held = 0i64;
  var x = 777u64;
  var wrong = 0;
  var i = 0;
  while i < 20000 {
    x = step(x);
    if (x >> 4u64) % 3u64 != 0u64 {
      let p = prioOf(x);
      q.push(p, p * 3i64);
      counts.set(usize.from(p), *counts[usize.from(p)] + 1i64);
      held = held + 1i64;
    } else {
      match q.pop() {
        case let Some(pair) {
          let p, t = pair;
          // the least priority with a count above 0
          var least = 0usize;
          while *counts[least] == 0i64 { least = least + 1usize; }
          if p != i64.from(least) || t != p * 3i64 { wrong = wrong + 1; }
          counts.set(least, *counts[least] - 1i64);
          held = held - 1i64;
        }
        case is None {
          if held != 0i64 { wrong = wrong + 1; }
        }
      }
    }
    i = i + 1;
  }
  expectInt(i64.from(wrong), 0, "20,000 mixed operations all agreed with the table");
  expectUInt(u64.from(q.len()), u64.from(held), "the length is what the table holds");
}

fn floats() {
  var zero = 0.0f32;
  let inf = 1.0f32 / zero;
  var q = PriorityQueue[f32, u32]();
  q.push(2.5f32, 1u32);
  q.push(1.0f32, 3u32);
  q.push(2.5f32, 4u32);
  q.push(-inf, 5u32);
  q.push(inf, 6u32);
  q.push(1.0f32, 7u32);
  q.push(-0.5f32, 9u32);
  // -inf, -0.5, 1.0 and 1.0 (items 3 and 7), 2.5 and 2.5 (items 1 and 4), inf
  var items = List[u32].empty();
  var prios = List[f32].empty();
  var more = true;
  while more {
    match q.pop() {
      case let Some(pair) {
        let p, t = pair;
        prios.push(p);
        items.push(t);
      }
      case is None {more = false;}
    }
  }
  expectUInt(u64.from(prios.len()), 7, "seven came out");
  expect(*prios[0usize] == -inf && *items[0usize] == 5u32, "-inf first, with its item");
  expect(*prios[1usize] == -0.5f32 && *items[1usize] == 9u32, "then -0.5");
  expect(*prios[2usize] == 1.0f32 && *prios[3usize] == 1.0f32, "then the two 1.0s");
  expectUInt(u64.from(*items[2usize] + *items[3usize]), 10, "whose items are 3 and 7 in either order");
  expect(*prios[4usize] == 2.5f32 && *prios[5usize] == 2.5f32, "then the two 2.5s");
  expectUInt(u64.from(*items[4usize] + *items[5usize]), 5, "whose items are 1 and 4 in either order");
  expect(*prios[6usize] == inf && *items[6usize] == 6u32, "then infinity");
}

// A NaN priority's place is unspecified: '<=>' answers 0 for a NaN against
// anything. What is promised is that the queue stays memory-safe and every item
// comes out exactly once: 12 pairs, 4 of them NaN, items 1..12 (sum 78), come out
// as 12 pairs whose items sum to 78 and are all different (their bits, or'd, are 8190)
fn nanPriorities() {
  var zero = 0.0f32;
  let nan = zero / zero;
  var q = PriorityQueue[f32, u32]();
  var i = 1u32;
  while i <= 12u32 {
    if i % 3u32 == 0u32 { q.push(nan, i); } else { q.push(f32.from(i % 5u32), i); }
    i = i + 1u32;
  }
  var count = 0u64;
  var sum = 0u64;
  var bits = 0u64;
  var more = true;
  while more {
    match q.pop() {
      case let Some(pair) {
        let p, t = pair;
        count = count + 1u64;
        sum = sum + u64.from(t);
        bits = bits | (1u64 << u64.from(t));
      }
      case is None {more = false;}
    }
  }
  expectUInt(count, 12, "NaN f32: every pair came out");
  expectUInt(sum, 78, "NaN f32: items 1 to 12 summed");
  expectUInt(bits, 8190, "NaN f32: each item exactly once");
  expect(q.isEmpty(), "NaN f32: empty after");

  var zero64 = 0.0;
  let nan64 = zero64 / zero64;
  var r = PriorityQueue[f64, String]();
  var j = 1;
  while j <= 12 {
    if j % 3 == 0 { r.push(nan64, String.from("x")); } else { r.push(f64.from(j % 5), String.from("y")); }
    j = j + 1;
  }
  var n = 0u64;
  while r.len() > 0usize {
    match r.pop() {
      case let Some(pair) {let p, s = pair; n = n + 1u64;}
      case is None {}
    }
  }
  expectUInt(n, 12, "NaN f64 with String items: every pair came out");
}

// A priority that is a struct: by cost, then by serial
struct Cost {
  pub cost: i32;
  pub serial: i32;

  pub fn `<=>`(self, other: Cost) i32 {
    if cost != other.cost { cost <=> other.cost } else { serial <=> other.serial }
  }
}

fn structPriorities() {
  var q = PriorityQueue[Cost, u32]();
  q.push(Cost(2, 1), 21u32);
  q.push(Cost(1, 9), 19u32);
  q.push(Cost(2, 0), 20u32);
  q.push(Cost(1, 3), 13u32);
  var got = 0u64;
  var more = true;
  while more {
    match q.pop() {
      case let Some(pair) {let p, t = pair; got = got * 100u64 + u64.from(t);}
      case is None {more = false;}
    }
  }
  expectUInt(got, 13192021, "by cost, then serial: 13, 19, 20, 21");
}

// ---- A Move item with a 'final'

var @threadlocal made = 0i64;
var @threadlocal died = 0i64;
var @threadlocal log = 0i64;

struct Fin {
  pub n: i64;
  fn final(self: &uni) { died = died + 1i64; log = log * 10i64 + n; }
}

fn finOf(n: i64) Fin { made = made + 1i64; Fin(n) }

fn finalsPop() {
  made = 0i64; died = 0i64; log = 0i64;
  var q = PriorityQueue[i32, Fin]();
  var i = 0;
  while i < 200 {
    // priorities 0..199 in a scattered order: 7 is coprime to 200
    q.push((i * 7) % 200, finOf(i64.from((i * 7) % 200)));
    i = i + 1;
  }
  expectInt(died, 0, "pushing and sifting finalize nothing");
  var inOrder = true;
  var want = 0i64;
  var j = 0;
  while j < 100 {
    match q.pop() {
      case let Some(pair) {
        let p, f = pair;
        if f.n != want { inOrder = false; }
        want = want + 1i64;
      }
      case is None {expect(false, "pop");}
    }
    j = j + 1;
  }
  expect(inOrder, "the 100 popped came out in order, each with its own item");
  expectInt(died, 100, "each popped item died once, where it ended up");
  expectInt(made - died, 100, "100 still held");
}

fn finalsDie() {
  made = 0i64; died = 0i64; log = 0i64;
  {
    var q = PriorityQueue[i32, Fin]();
    q.push(3, finOf(3i64));
    q.push(1, finOf(1i64));
    q.push(2, finOf(2i64));
    expectInt(died, 0, "pushes");
  }
  expectInt(made, 3, "three made");
  expectInt(died, 3, "the queue's death finalized each item once");
}

fn finalsClear() {
  made = 0i64; died = 0i64; log = 0i64;
  var q = PriorityQueue[i32, Fin]();
  q.push(3, finOf(3i64));
  q.push(1, finOf(1i64));
  q.clear();
  expectInt(died, 2, "clear finalized both");
  expect(q.isEmpty(), "and emptied it");
  q.push(4, finOf(4i64));
  match q.pop() {
    case let Some(pair) {let p, f = pair; expectInt(f.n, 4, "usable after clear");}
    case is None {expect(false, "pop after clear");}
  }
  expectInt(made - died, 0, "none leaked");
}

// ---- In an arena, and with a starting size

fn inArena() {
  var a = Arena.empty();
  let q = new a[PriorityQueue[i32, u32]](16usize);
  expectUInt(u64.from(q.capacity()), 16, "the starting size is a block of 16 priorities");
  var i = 0;
  while i < 100 {
    q.push((i * 37) % 100, u32.from((i * 37) % 100));
    i = i + 1;
  }
  var ok = true;
  var want = 0u32;
  var more = true;
  while more {
    match q.pop() {
      case let Some(pair) {
        let p, t = pair;
        if t != want || i64.from(p) != i64.from(want) { ok = false; }
        want = want + 1u32;
      }
      case is None {more = false;}
    }
  }
  expect(ok, "100 pushed in an arena popped in order");
  expectUInt(u64.from(want), 100, "all of them");
  expect(a.blockCount() >= 1usize, "the arena supplied the blocks");
}

fn reserved() {
  var q = PriorityQueue[i32, u32](100usize);
  expectUInt(u64.from(q.capacity()), 100, "PriorityQueue[i32, u32](100) has room for 100");
  var r = PriorityQueue[i32, u32]();
  r.reserve(10usize);
  expect(r.capacity() >= 10usize, "reserve makes room");
  expect(r.isEmpty(), "and holds nothing");
}

fn main() {
  worked();
  randomSorted();
  randomInterleaved();
  floats();
  nanPriorities();
  structPriorities();
  finalsPop();
  finalsDie();
  finalsClear();
  inArena();
  reserved();
  done();
}
