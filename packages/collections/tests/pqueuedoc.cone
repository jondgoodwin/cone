// The PriorityQueue example of the collections reference page (lib-collections.html,
// "PriorityQueue"), as printed: the peek shows the least priority, 3, without
// removing it, then the pops give 3, 5 and 8 in that order, each with its own job.

mod pqueuedoc;

import stdio use *;
import collections use *;

fn main() i32 {
  var jobs = PriorityQueue[i32, String]();
  jobs.push(5, String.from("write report"));
  jobs.push(3, String.from("answer mail"));
  jobs.push(8, String.from("tidy desk"));
  match jobs.peek() {                 // the least priority, as borrows
    case let Some(pair) {
      let p, job = pair;
      print <- *p; print <- " "; print <- job.view(); print <- "\n";
    }
    case is None {print <- "nothing to do\n";}
  }
  var more = true;
  while more {
    match jobs.pop() {                // the least priority, moved out
      case let Some(pair) {
        let p, job = pair;
        print <- p; print <- " "; print <- job.view(); print <- "\n";
      }
      case is None {more = false;}
    }
  }
  0i32
}
