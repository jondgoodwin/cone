// The capability traits: Collection, Indexed, Stack, Queue and Map.
// A type fits a trait by having its methods; none of these collections
// declares one, and the little Pile below, written here, fits Stack the same
// way. The main way to ask for one is a static bound, '[S Stack[i64]]' or
// 'where S is Stack[T]', decided where the function is called and compiled to
// the type's own methods. The sections below use the bound in its spellings;
// the last section, "the dynamic form", takes the same traits as virtual
// references ('&<mut Stack[i64]'), one function for each, so that both forms
// stay pinned. Every expected value is worked out by hand from the pushes made.

mod traits;

import testing use *;
import collections use *;

// -------- Collection: a bound with no type argument to give --------

fn countOf[C Collection](c &C) usize { c.len(); }
fn emptyOf[C Collection](c &C) bool { c.isEmpty(); }
fn countWhere[C](c &C) usize where C is Collection { c.len(); }

fn collectionTrait() {
  mut l = List[i64].empty();
  l.push(1i64);
  l.push(2i64);
  l.push(3i64);
  mut d = Deque[i64].empty();
  d.push(1i64);
  d.push(2i64);
  imm s = String.from("four");
  mut m = new Dict[u64, i64];
  m.insert(1u64, 10i64);
  mut o = new OrderedDict[u64, i64];
  o.insert(1u64, 10i64);
  o.insert(2u64, 20i64);
  mut st = new Set[u64];
  st.insert(7u64);
  st.insert(8u64);
  st.insert(9u64);
  expectUInt(u64.from(countOf(&l)), 3, "List is a Collection");
  expectUInt(u64.from(countOf(&d)), 2, "Deque is");
  expectUInt(u64.from(countOf(&s)), 4, "String is");
  expectUInt(u64.from(countOf(&m)), 1, "Dict is");
  expectUInt(u64.from(countOf(&o)), 2, "OrderedDict is");
  expectUInt(u64.from(countOf(&st)), 3, "Set is");
  expect(not emptyOf(&l), "a List of three is not empty");
  expect(emptyOf(&Deque[i64].empty()), "an empty Deque is");
  expectUInt(u64.from(countWhere(&st)), 3, "the same bound as a where clause");
}

// -------- Stack: List and Deque, and a type of this file's --------

// The element type given outright
fn sumByPopping[S Stack[i64]](s &mut S) i64 {
  mut total = 0i64;
  while true {
    match s.pop() {
      case imm v Some {total = total * 10i64 + v;}
      case is None {break;}
    }
  }
  total;
}

// The element type a parameter of its own, named before the bound
fn pushThree[T, S Stack[T]](s &mut S, a T, b T, c T) {
  s.push(a);
  s.push(b);
  s.push(c);
}

// The bound written as a where clause
fn topOf[S](s &S) i64 where S is Stack[i64] {
  match s.peek() {
    case imm v Some {*v;}
    case is None {-1i64;}
  }
}

// A bound may name a parameter that comes after it. T is decided by the stack
// ('i64' for a List[i64]) before an unsuffixed literal takes a type of its own
fn pushOne[S Stack[T], T](s &mut S, v T) { s.push(v); }

// T read off the stack's own methods: no argument names it
fn popOne[T, S](s &mut S) Option[T] where S is Stack[T] { s.pop(); }

// Strings do not copy: a Stack[String] moves them in and out
fn pushNames[S Stack[String]](s &mut S) {
  s.push(String.from("a"));
  s.push(String.from("bc"));
}

fn popLength[S Stack[String]](s &mut S) usize {
  match s.pop() {
    case imm v Some {v.len();}
    case is None {0usize;}
  }
}

// A type with the three methods and no declaration
struct Pile {
  pub items List[i64];
  pub fn push(self &mut, value i64) { items.push(value); }
  pub fn pop(self &mut) Option[i64] { items.pop(); }
  pub fn peek(self &) Option[&i64] { items.peek(); }
}

fn stacks() {
  mut l = List[i64].empty();
  mut d = Deque[i64].empty();
  pushThree(&mut l, 1i64, 2i64, 3i64);
  pushThree(&mut d, 1i64, 2i64, 3i64);
  expectInt(topOf(&l), 3, "List peek is the last pushed");
  expectInt(topOf(&d), 3, "Deque peek is too");
  expectInt(sumByPopping(&mut l), 321, "List pops last in, first out");
  expectInt(sumByPopping(&mut d), 321, "Deque does");
  expectInt(topOf(&l), -1, "peek of nothing");
  expectUInt(u64.from(l.len()), 0, "emptied");

  mut p = new Pile(List[i64].empty());
  pushThree(&mut p, 1i64, 2i64, 3i64);
  expectInt(topOf(&p), 3, "a Pile peeks");
  expectInt(sumByPopping(&mut p), 321, "and pops");

  // The bound decides T before the literal takes its default type
  pushOne(&mut l, 7);
  pushOne(&mut d, 7);
  expectInt(topOf(&l), 7, "a literal pushed through [S Stack[T], T] is an i64 for a List[i64]");
  expectInt(sumByPopping(&mut d), 7, "and for a Deque[i64]");
  match popOne(&mut l) {
    case imm v Some {expectInt(v, 7, "popOne finds T from the List's pop");}
    case is None {expect(false, "the List held a 7");}
  }
  match popOne(&mut l) {
    case imm v Some {expect(false, "nothing was left");}
    case is None {expect(true, "and a List with nothing left answers None");}
  }

  mut ls = List[String].empty();
  mut ds = Deque[String].empty();
  pushNames(&mut ls);
  pushNames(&mut ds);
  expectUInt(u64.from(popLength(&mut ls)), 2, "List[String] gives the last back");
  expectUInt(u64.from(popLength(&mut ds)), 2, "Deque[String] does");
}

// -------- Queue: Deque --------

fn enqueue[Q Queue[i64]](q &mut Q, n i64) {
  mut i = 1i64;
  while i <= n { q.push(i); i = i + 1i64; }
}

fn dequeueAll[Q Queue[i64]](q &mut Q) i64 {
  mut order = 0i64;
  while true {
    match q.popFront() {
      case imm v Some {order = order * 10i64 + v;}
      case is None {break;}
    }
  }
  order;
}

fn queues() {
  mut d = Deque[i64].empty();
  enqueue(&mut d, 4i64);
  expectInt(dequeueAll(&mut d), 1234, "first in, first out");
  expect(d.isEmpty(), "then empty");
  // Taken from the front and added at the back round a block of 4, again
  enqueue(&mut d, 3i64);
  expectInt(dequeueAll(&mut d), 123, "again");
  enqueue(&mut d, 6i64);
  expectInt(dequeueAll(&mut d), 123456, "and after growing");
}

// -------- Indexed: List and Deque --------

fn at[X Indexed[i64]](x &X, i usize) i64 {
  match x.get(i) {
    case imm v Some {*v;}
    case is None {-1i64;}
  }
}

fn indexed() {
  imm l = new List[i64] <- 5, 6, 7;
  mut d = new Deque[i64] <- 6, 7;
  d.pushFront(5);
  expectInt(at(&l, 0usize), 5, "List get 0");
  expectInt(at(&l, 2usize), 7, "List get 2");
  expectInt(at(&l, 3usize), -1, "List get past the end");
  expectInt(at(&d, 0usize), 5, "Deque get 0, counted from the front");
  expectInt(at(&d, 2usize), 7, "Deque get 2");
  expectInt(at(&d, 3usize), -1, "Deque get past the end");
}

// -------- Map: Dict and OrderedDict --------

fn fill[M Map[u64, i64]](m &mut M) {
  m.insert(1u64, 10i64);
  m.insert(2u64, 20i64);
}

// The old value comes back, moved out, or -1 for a key that was new
fn replaced[M Map[u64, i64]](m &mut M) i64 {
  match m.insert(2u64, 21i64) {
    case imm v Some {v;}
    case is None {-1i64;}
  }
}

fn lookup[M Map[u64, i64]](m &M, k u64) i64 {
  imm key = k;
  match m.get(&key) {
    case imm v Some {*v;}
    case is None {-1i64;}
  }
}

fn has[M](m &M, k u64) bool where M is Map[u64, i64] {
  imm key = k;
  m.contains(&key);
}

fn take[M Map[u64, i64]](m &mut M, k u64) i64 {
  imm key = k;
  match m.remove(&key) {
    case imm v Some {v;}
    case is None {-1i64;}
  }
}

// The key and value types parameters of their own
fn swapIn[K, V, M Map[K, V]](m &mut M, k K, v V) Option[V] { m.insert(k, v); }

// A map by Strings, which also have the by-bytes forms the trait does not ask for
fn describe[M Map[String, i64]](m &mut M) i64 {
  m.insert(String.from("x"), 5i64);
  imm key = String.from("x");
  match m.get(&key) {
    case imm v Some {*v;}
    case is None {-1i64;}
  }
}

fn maps() {
  mut d = new Dict[u64, i64];
  mut o = new OrderedDict[u64, i64];
  fill(&mut d);
  fill(&mut o);
  expectInt(lookup(&d, 1u64), 10, "Dict get");
  expectInt(lookup(&o, 2u64), 20, "OrderedDict get");
  expectInt(lookup(&d, 3u64), -1, "a key it lacks");
  expect(has(&d, 2u64), "Dict contains");
  expect(not has(&o, 3u64), "OrderedDict does not contain 3");
  expectInt(replaced(&mut d), 20, "insert answers the old value for a key it held");
  expectInt(replaced(&mut o), 20, "the same for OrderedDict");
  expectInt(lookup(&o, 2u64), 21, "and the value is replaced");
  expectInt(replaced(&mut d), 21, "a second replacement answers the first");
  mut fresh = new Dict[u64, i64];
  expectInt(replaced(&mut fresh), -1, "a key that was new answers None");
  expectInt(take(&mut d, 1u64), 10, "remove moves the value out");
  expectInt(take(&mut o, 1u64), 10, "OrderedDict too");
  expectInt(take(&mut d, 1u64), -1, "a second remove finds nothing");
  expectUInt(u64.from(d.len()), 1, "one left in the Dict");

  // d holds key 2 -> 21 now
  match swapIn(&mut d, 2u64, 22i64) {
    case imm v Some {expectInt(v, 21, "swapIn, with K and V parameters, answers the old value");}
    case is None {expect(false, "key 2 was there");}
  }
  expectInt(lookup(&d, 2u64), 22, "and stores the new one");

  mut ds = new Dict[String, i64];
  mut os = new OrderedDict[String, i64];
  expectInt(describe(&mut ds), 5, "Dict[String, i64] is a Map[String, i64]");
  expectInt(describe(&mut os), 5, "OrderedDict[String, i64] is");
}

// A value with a finalizer, put in through a Map and replaced: the old one is
// handed back and dies once, when the caller lets go of it
mut deaths = 0i64;
struct Counted {
  pub n i64;
  fn final(self &uni) { deaths = deaths + 1i64; }
}

fn putCounted[M Map[u64, Counted]](m &mut M, n i64) i64 {
  imm before = deaths;
  match m.insert(1u64, new Counted(n)) {
    case imm old Some {
      expectInt(deaths, before, "the old value is alive in the Option");
      old.n;
    }
    case is None {-1i64;}
  }
}

fn finalizedThroughMap() {
  mut d = new Dict[u64, Counted];
  mut o = new OrderedDict[u64, Counted];
  expectInt(putCounted(&mut d, 1i64), -1, "first put, Dict");
  expectInt(putCounted(&mut d, 2i64), 1, "second put answers the first");
  expectInt(deaths, 1, "the first died once, when the answer was dropped");
  expectInt(putCounted(&mut o, 3i64), -1, "first put, OrderedDict");
  expectInt(putCounted(&mut o, 4i64), 3, "second put answers the first");
  expectInt(deaths, 2, "the first died once");
}

// -------- the dynamic form: the same traits as virtual references --------

// A virtual reference ('&<Stack[i64]', '&<mut Map[u64, i64]') takes any value
// whose type fits the trait, as a bound does, but through one compiled
// function and a table of the type's methods, found when it runs. It is the
// form for a value whose type is not known where the function is compiled. A
// few functions for each trait are enough here; the sections above hold the
// full checks.

fn countDyn(c &<Collection) usize { c.len(); }

fn pushThreeDyn(s &<mut Stack[i64]) {
  s.push(1i64);
  s.push(2i64);
  s.push(3i64);
}

fn sumDyn(s &<mut Stack[i64]) i64 {
  mut total = 0i64;
  while true {
    match s.pop() {
      case imm v Some {total = total * 10i64 + v;}
      case is None {break;}
    }
  }
  total;
}

fn topDyn(s &<Stack[i64]) i64 {
  match s.peek() {
    case imm v Some {*v;}
    case is None {-1i64;}
  }
}

fn pushNamesDyn(s &<mut Stack[String]) {
  s.push(String.from("a"));
  s.push(String.from("bc"));
}

fn popLengthDyn(s &<mut Stack[String]) usize {
  match s.pop() {
    case imm v Some {v.len();}
    case is None {0usize;}
  }
}

fn enqueueDyn(q &<mut Queue[i64], n i64) {
  mut i = 1i64;
  while i <= n { q.push(i); i = i + 1i64; }
}

fn dequeueDyn(q &<mut Queue[i64]) i64 {
  mut order = 0i64;
  while true {
    match q.popFront() {
      case imm v Some {order = order * 10i64 + v;}
      case is None {break;}
    }
  }
  order;
}

fn atDyn(x &<Indexed[i64], i usize) i64 {
  match x.get(i) {
    case imm v Some {*v;}
    case is None {-1i64;}
  }
}

fn fillDyn(m &<mut Map[u64, i64]) {
  m.insert(1u64, 10i64);
  m.insert(2u64, 20i64);
}

fn replacedDyn(m &<mut Map[u64, i64]) i64 {
  match m.insert(2u64, 21i64) {
    case imm v Some {v;}
    case is None {-1i64;}
  }
}

fn lookupDyn(m &<Map[u64, i64], k u64) i64 {
  imm key = k;
  match m.get(&key) {
    case imm v Some {*v;}
    case is None {-1i64;}
  }
}

fn putCountedDyn(m &<mut Map[u64, Counted], n i64) i64 {
  imm before = deaths;
  match m.insert(1u64, new Counted(n)) {
    case imm old Some {
      expectInt(deaths, before, "the old value is alive in the Option, through a virtual reference");
      old.n;
    }
    case is None {-1i64;}
  }
}

fn dynamicForm() {
  mut l = List[i64].empty();
  mut d = Deque[i64].empty();
  mut st = new Set[u64];
  st.insert(7u64);
  st.insert(8u64);
  expectUInt(u64.from(countDyn(&l)), 0, "an empty List through a virtual Collection");
  expectUInt(u64.from(countDyn(&st)), 2, "a Set through one");
  pushThreeDyn(&mut l);
  pushThreeDyn(&mut d);
  expectUInt(u64.from(countDyn(&d)), 3, "a Deque through one after three pushes");
  expectInt(topDyn(&l), 3, "dynamic Stack peek on a List");
  expectInt(topDyn(&d), 3, "and on a Deque");
  mut p = new Pile(List[i64].empty());
  pushThreeDyn(&mut p);
  expectInt(topDyn(&p), 3, "and on a Pile");
  expectInt(sumDyn(&mut l), 321, "dynamic pops last in, first out, List");
  expectInt(sumDyn(&mut d), 321, "Deque");
  expectInt(sumDyn(&mut p), 321, "Pile");
  expectInt(topDyn(&l), -1, "dynamic peek of nothing");

  mut ls = List[String].empty();
  mut ds = Deque[String].empty();
  pushNamesDyn(&mut ls);
  pushNamesDyn(&mut ds);
  expectUInt(u64.from(popLengthDyn(&mut ls)), 2, "List[String] through a virtual Stack");
  expectUInt(u64.from(popLengthDyn(&mut ds)), 2, "Deque[String] through one");

  enqueueDyn(&mut d, 4i64);
  expectInt(dequeueDyn(&mut d), 1234, "dynamic Queue: first in, first out");

  imm il = new List[i64] <- 5, 6, 7;
  expectInt(atDyn(&il, 2usize), 7, "dynamic Indexed get 2");
  expectInt(atDyn(&il, 3usize), -1, "and past the end");
  d.pushFront(5);
  expectInt(atDyn(&d, 0usize), 5, "a Deque through Indexed, counted from the front");

  mut md = new Dict[u64, i64];
  mut mo = new OrderedDict[u64, i64];
  fillDyn(&mut md);
  fillDyn(&mut mo);
  expectInt(lookupDyn(&md, 1u64), 10, "dynamic Map get, Dict");
  expectInt(lookupDyn(&mo, 2u64), 20, "OrderedDict");
  expectInt(replacedDyn(&mut md), 20, "dynamic insert answers the old value");
  expectInt(replacedDyn(&mut mo), 20, "OrderedDict too");
  expectInt(lookupDyn(&mo, 3u64), -1, "a key it lacks");

  mut cd = new Dict[u64, Counted];
  imm base = deaths;
  expectInt(putCountedDyn(&mut cd, 5i64), -1, "first put, through a virtual Map");
  expectInt(putCountedDyn(&mut cd, 6i64), 5, "second put answers the first");
  expectInt(deaths, base + 1, "the first died once, when the answer was dropped");
}

fn main() i32 {
  collectionTrait();
  stacks();
  queues();
  indexed();
  maps();
  finalizedThroughMap();
  expectInt(deaths, 4, "the two held died with their collections");
  dynamicForm();
  // The Counted that dynamicForm left in its Dict died with the Dict
  expectInt(deaths, 6, "and so did the one the virtual Map's Dict held");
  done();
}
