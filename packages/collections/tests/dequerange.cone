// An index past a deque's end is a program error, and a panic, after writing
// out what was printed before it: this test's .out is only the line printed
// before the bad index, its .exit a panic's, and its .err the panic's line,
// naming the line of the bad index. The index counts from the front, so a deque
// whose block has wrapped is checked against its length, not its block.

mod dequerange;

import stdio use *;
import collections use *;

fn main() i32 {
  mut d = Deque[i64].empty();
  d.push(2);
  d.push(3);
  d.pushFront(1);
  printStr("reading index 3 of 3\n");
  printInt(*d[3usize]);
  printStr("not reached\n");
  0i32;
}
