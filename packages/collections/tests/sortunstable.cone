// The unstable sort, the selection and the searches of core's Array[T], reached on a
// List: sortUnstable, sortUnstableBy, sortUnstableByKey, selectNth*, isSorted*,
// partitionPoint, binarySearch*, partitionIndex, slice and sliceMut.
//
// What each check means (every printed line was worked out against the source):
// - The differential: for each of six input patterns (random, already sorted,
//   reversed, four distinct values, an organ pipe, all equal) and every size 0 to 300,
//   then a spread up to 100,000, a list of u32, one of f32 made from random bits (so
//   NaNs of both signs and of many payloads, and both zeros) and one of 40-byte
//   structs is sorted by sortUnstable* and compared with a copy sorted by today's
//   stable List.sortBy under the same order. For u32 and f32 values that compare equal
//   are the same bits, so the two lists must be identical; a struct is checked by its
//   keys being the same sequence and each id being present exactly once.
// - The comparison counter: the sort may make at most 2 * n * (log2 n + 1) + 12 * n
//   comparisons on each pattern (measured at 100,000: 1.09 n log2 n random, 1.0 organ pipe,
//   linear sorted, reversed and equal). A partition or pivot slip sorts correctly but slowly,
//   which only this catches; a quadratic sort would be a hundred times over at 100,000.
// - selectNth puts the k-th value of the sorted order at k, none after it before it and
//   none before it after it, for every k of every size 0 to 40 on random and
//   few-distinct input, and for a spread of k at 3,000 and 100,000.
// - binarySearch against a linear scan on sorted lists with duplicates, at both ends,
//   in the middle, and on an empty list.

mod sortunstable;

import testing use *;
import collections use *;

var @threadlocal calls = 0usize;

fn nextRand(s: &mut u64) u64 {
  var x = *s;
  x = x ^ (x << 13u64);
  x = x ^ (x >> 7u64);
  x = x ^ (x << 17u64);
  *s = x;
  x
}

fn f32FromBits(bits: u32) f32 {
  var b = bits;
  *((&mut b) as *u32 as *f32)
}

// 40 bytes: a key to sort by, an id that says which one it is, and filler
struct Rec {
  pub key: u32;
  pub id: u32;
  pub a: u64;
  pub b: u64;
  pub c: u64;
  pub d: u64;
}

fn recOrder(a: &Rec, b: &Rec) i32 {
  calls = calls + 1usize;
  a.key <=> b.key
}

fn countedU32(a: &u32, b: &u32) i32 {
  calls = calls + 1usize;
  a <=> b
}

fn countedF32(a: &f32, b: &f32) i32 {
  calls = calls + 1usize;
  a <=> b
}

fn recKey(r: &Rec) u32 { r.key }

// The value at position i of n for a pattern: 0 random, 1 sorted, 2 reversed,
// 3 four distinct values, 4 an organ pipe, 5 all equal
fn patternValue(kind: i32, i: usize, n: usize, s: &mut u64) u32 {
  let r = u32.from(nextRand(s) >> 40u64);
  if kind == 0 { r }
  else if kind == 1 { u32.from(i) }
  else if kind == 2 { u32.from(n - i) }
  else if kind == 3 { r % 4u32 }
  else if kind == 4 { if i < n / 2usize { u32.from(i) } else { u32.from(n - i) } }
  else { 7u32 }
}

fn bound(n: usize) usize {
  var lg = 1usize;
  var m = n;
  while m > 1usize { m = m / 2usize; lg = lg + 1usize; }
  2usize * n * lg + 12usize * n
}

fn sameU32(a: &List[u32], b: &List[u32]) bool {
  if a.len() != b.len() { return false; }
  var i = 0usize;
  while i < a.len() {
    if a[i] != b[i] { return false; }
    i = i + 1usize;
  }
  true
}

// u32: sorted by the natural order, by a comparison, and by a key
fn checkU32(kind: i32, n: usize, seed: u64) i32 {
  var s = seed;
  var l = List[u32]();
  var i = 0usize;
  while i < n { l.push(patternValue(kind, i, n, &mut s)); i = i + 1usize; }
  var want = List[u32]();
  i = 0usize;
  while i < n { want.push(l[i]); i = i + 1usize; }
  want.sortBy(&countedU32);
  var bad = 0i32;
  var a = List[u32]();
  i = 0usize;
  while i < n { a.push(l[i]); i = i + 1usize; }
  a.sortUnstable();
  if !sameU32(&a, &want) || !a.isSorted() { bad = bad + 1i32; }
  var b = List[u32]();
  i = 0usize;
  while i < n { b.push(l[i]); i = i + 1usize; }
  calls = 0usize;
  b.sortUnstableBy(&countedU32);
  if !sameU32(&b, &want) { bad = bad + 1i32; }
  if calls > bound(n) { bad = bad + 100i32; }
  var c = List[u32]();
  i = 0usize;
  while i < n { c.push(l[i]); i = i + 1usize; }
  c.sortUnstableByKey(fn(x: &u32) u32 { *x });
  if !sameU32(&c, &want) { bad = bad + 1i32; }
  bad
}

// f32 made from random bits, with both zeros put in
fn checkF32(kind: i32, n: usize, seed: u64) i32 {
  var s = seed;
  var l = List[f32]();
  var i = 0usize;
  while i < n {
    let v = patternValue(kind, i, n, &mut s);
    var bits = v * 2654435761u32;
    if kind == 1 || kind == 2 || kind == 4 { bits = v; }
    if i % 7usize == 0usize { bits = 0x80000000u32; }
    if i % 11usize == 0usize { bits = 0u32; }
    if i % 13usize == 0usize { bits = 0x7FC00000u32 + v; }
    if i % 17usize == 0usize { bits = 0xFFC00000u32 + v; }
    l.push(f32FromBits(bits));
    i = i + 1usize;
  }
  var want = List[f32]();
  i = 0usize;
  while i < n { want.push(l[i]); i = i + 1usize; }
  want.sortBy(&countedF32);
  l.sortUnstable();
  var bad = 0i32;
  i = 0usize;
  while i < n {
    // equal under total order is the same bits: compare by <=>, which is 0 only for those
    if (l[i] <=> want[i]) != 0i32 { bad = bad + 1i32; }
    i = i + 1usize;
  }
  if !l.isSorted() { bad = bad + 1i32; }
  bad
}

// 40-byte structs: the keys come out in the same sequence, and every id once
fn checkRec(kind: i32, n: usize, seed: u64) i32 {
  var s = seed;
  var l = List[Rec]();
  var i = 0usize;
  while i < n {
    let k = patternValue(kind, i, n, &mut s);
    l.push(Rec(k, u32.from(i), 1u64, 2u64, 3u64, u64.from(k)));
    i = i + 1usize;
  }
  var keys = List[u32]();
  i = 0usize;
  while i < n { keys.push(l[i].key); i = i + 1usize; }
  keys.sortBy(&countedU32);
  calls = 0usize;
  l.sortUnstableBy(&recOrder);
  var bad = 0i32;
  if calls > bound(n) { bad = bad + 100i32; }
  var seen = List[bool]();
  i = 0usize;
  while i < n { seen.push(false); i = i + 1usize; }
  i = 0usize;
  while i < n {
    if l[i].key != keys[i] { bad = bad + 1i32; }
    // the filler travelled with its key
    if l[i].d != u64.from(l[i].key) || l[i].a != 1u64 || l[i].c != 3u64 { bad = bad + 1i32; }
    let id = usize.from(l[i].id);
    if id >= n || seen[id] { bad = bad + 1i32; } else { seen[id] = true; }
    i = i + 1usize;
  }
  bad
}

fn differential() {
  var bad = 0i32;
  var kind = 0i32;
  var sorts = 0i32;
  while kind < 6i32 {
    var n = 0usize;
    while n <= 300usize {
      bad = bad + checkU32(kind, n, 88172645463325252u64 + u64.from(n));
      bad = bad + checkF32(kind, n, 1442695040888963407u64 + u64.from(n));
      bad = bad + checkRec(kind, n, 6364136223846793005u64 + u64.from(n));
      sorts = sorts + 3i32;
      n = n + 1usize;
    }
    kind = kind + 1i32;
  }
  expectInt(i64.from(bad), 0i64, "sizes 0 to 300, six patterns, three element types, differential and comparison counts");
  expectInt(i64.from(sorts), 5418i64, "the sorts run");
  bad = 0i32;
  kind = 0i32;
  while kind < 6i32 {
    bad = bad + checkU32(kind, 1000usize, 99u64 + u64.from(kind));
    bad = bad + checkU32(kind, 4096usize, 77u64 + u64.from(kind));
    bad = bad + checkU32(kind, 100000usize, 55u64 + u64.from(kind));
    bad = bad + checkF32(kind, 20000usize, 33u64 + u64.from(kind));
    bad = bad + checkRec(kind, 20000usize, 11u64 + u64.from(kind));
    kind = kind + 1i32;
  }
  expectInt(i64.from(bad), 0i64, "1,000 to 100,000 values, six patterns");
}

fn selectCheck(l: &List[u32], k: usize, want: &List[u32]) bool {
  // the value at k is the k-th, none after it is less, none before it is greater
  if l[k] != want[k] { return false; }
  var i = 0usize;
  while i < l.len() {
    if i < k && l[i] > l[k] { return false; }
    if i > k && l[i] < l[k] { return false; }
    i = i + 1usize;
  }
  true
}

fn selection() {
  var bad = 0i32;
  var count = 0i32;
  var kind = 0i32;
  while kind < 2i32 {
    var n = 1usize;
    while n <= 40usize {
      var k = 0usize;
      while k < n {
        var s = 424242u64 + u64.from(n * 100usize + k);
        var l = List[u32]();
        var i = 0usize;
        while i < n {
          let r = u32.from(nextRand(&mut s) >> 40u64);
          l.push(if kind == 0i32 { r } else { r % 3u32 });
          i = i + 1usize;
        }
        var want = List[u32]();
        i = 0usize;
        while i < n { want.push(l[i]); i = i + 1usize; }
        want.sortBy(&countedU32);
        let got = l.selectNth(k);
        if *got != want[k] { bad = bad + 1i32; }
        if !selectCheck(&l, k, &want) { bad = bad + 1i32; }
        count = count + 1i32;
        k = k + 1usize;
      }
      n = n + 1usize;
    }
    kind = kind + 1i32;
  }
  expectInt(i64.from(bad), 0i64, "selectNth places the k-th value for every k, sizes 1 to 40, random and few distinct");
  expectInt(i64.from(count), 1640i64, "the selections run");
  bad = 0i32;
  var pattern = 0i32;
  while pattern < 6i32 {
    var big = 0i32;
    while big < 2i32 {
      let n = if big == 0i32 { 3000usize } else { 100000usize };
      var s = 31337u64 + u64.from(pattern);
      var l = List[u32]();
      var i = 0usize;
      while i < n { l.push(patternValue(pattern, i, n, &mut s)); i = i + 1usize; }
      var want = List[u32]();
      i = 0usize;
      while i < n { want.push(l[i]); i = i + 1usize; }
      want.sortBy(&countedU32);
      let ks = [0usize, 1usize, n / 7usize, n / 2usize, n - 2usize, n - 1usize];
      var j = 0usize;
      while j < 6usize {
        var copy = List[u32]();
        i = 0usize;
        while i < n { copy.push(l[i]); i = i + 1usize; }
        copy.selectNth(ks[j]);
        if !selectCheck(&copy, ks[j], &want) { bad = bad + 1i32; }
        j = j + 1usize;
      }
      big = big + 1i32;
    }
    pattern = pattern + 1i32;
  }
  expectInt(i64.from(bad), 0i64, "selectNth at 3,000 and 100,000 values, six patterns, six positions");
  // by comparison and by key, on the 40-byte struct
  var recs = List[Rec]();
  var i = 0usize;
  while i < 500usize {
    recs.push(Rec(u32.from((i * 7919usize) % 500usize), u32.from(i), 0u64, 0u64, 0u64, 0u64));
    i = i + 1usize;
  }
  let at = recs.selectNthByKey(250usize, &recKey);
  expectInt(i64.from(at.key), 250i64, "selectNthByKey: the key at 250 of the permutation of 0 to 499");
  let at2 = recs.selectNthBy(10usize, &recOrder);
  expectInt(i64.from(at2.key), 10i64, "selectNthBy: the key at 10");
}

fn searching() {
  var bad = 0i32;
  var n = 0usize;
  while n <= 30usize {
    var l = List[u32]();
    var i = 0usize;
    // sorted with duplicates: 0 0 1 1 2 2 ... doubled and then every third doubled again
    while i < n {
      l.push(u32.from(i / 2usize) * 2u32);
      i = i + 1usize;
    }
    var x = 0u32;
    while x < 20u32 {
      // the linear answer: the first position whose value is not below x
      var first = 0usize;
      while first < n && l[first] < x { first = first + 1usize; }
      let found = first < n && l[first] == x;
      let r = l.binarySearch(x);
      if r.0 != first || r.1 != found { bad = bad + 1i32; }
      let q = l.binarySearchBy(fn(e: &u32) i32 { *e <=> x });
      if q.0 != first || q.1 != found { bad = bad + 1i32; }
      let pp = l.partitionPoint(fn(e: &u32) bool { *e < x });
      if pp != first { bad = bad + 1i32; }
      let pi = partitionIndex(n, fn(j: usize) bool { l[j] < x });
      if pi != first { bad = bad + 1i32; }
      x = x + 1u32;
    }
    n = n + 1usize;
  }
  expectInt(i64.from(bad), 0i64, "binarySearch, binarySearchBy, partitionPoint and partitionIndex against a linear scan, sizes 0 to 30, with duplicates");
  var e = List[u32]();
  let r0 = e.binarySearch(5u32);
  expectInt(i64.from(r0.0), 0i64, "binarySearch of an empty list: position 0");
  expectInt(if r0.1 { 1i64 } else { 0i64 }, 0i64, "binarySearch of an empty list: not found");
  var d = List[u32]() <- 10u32, 20u32, 20u32, 20u32, 30u32;
  let lo = d.binarySearch(1u32);
  expectInt(i64.from(lo.0), 0i64, "below the first: position 0");
  expectInt(if lo.1 { 1i64 } else { 0i64 }, 0i64, "below the first: not found");
  let hi = d.binarySearch(99u32);
  expectInt(i64.from(hi.0), 5i64, "above the last: position 5, the count");
  let dup = d.binarySearch(20u32);
  expectInt(i64.from(dup.0), 1i64, "among duplicates: the earliest, position 1");
  expectInt(if dup.1 { 1i64 } else { 0i64 }, 1i64, "among duplicates: found");
  let between = d.binarySearch(25u32);
  expectInt(i64.from(between.0), 4i64, "between values: the insertion point 4");
  expectInt(if between.1 { 1i64 } else { 0i64 }, 0i64, "between values: not found");
  expectInt(if d.isSorted() { 1i64 } else { 0i64 }, 1i64, "isSorted of a sorted list");
  d.reverse();
  expectInt(if d.isSorted() { 1i64 } else { 0i64 }, 0i64, "isSorted of the reversed list");
  expectInt(if d.isSortedBy(fn(a: &u32, b: &u32) i32 { b <=> a }) { 1i64 } else { 0i64 }, 1i64, "isSortedBy a descending order");
}

// Floats: -0.0 sorts before 0.0, NaNs go to the ends by sign, infinities beside them
fn floatsEdge() {
  var l = List[f32]();
  l.push(f32FromBits(0x7FC00000u32));
  l.push(1.5f32);
  l.push(f32FromBits(0x00000000u32));
  l.push(f32FromBits(0xFFC00000u32));
  l.push(f32FromBits(0x80000000u32));
  l.push(f32FromBits(0x7F800000u32));
  l.push(f32FromBits(0xFF800000u32));
  l.push(-2.5f32);
  l.sortUnstable();
  let order = [0xFFC00000u32, 0xFF800000u32, 0xC0200000u32, 0x80000000u32, 0x00000000u32, 0x3FC00000u32, 0x7F800000u32, 0x7FC00000u32];
  var bad = 0i32;
  var i = 0usize;
  while i < 8usize {
    var b = l[i];
    let got = *((&mut b) as *f32 as *u32);
    if got != order[i] { bad = bad + 1i32; }
    i = i + 1usize;
  }
  expectInt(i64.from(bad), 0i64, "-NaN, -inf, -2.5, -0.0, +0.0, 1.5, +inf, +NaN");
}

// Any element type: reverse and sort a list of Strings, and sort by key
fn strings() {
  var l = List[String]();
  l.push(String.from("pear"));
  l.push(String.from("apple"));
  l.push(String.from("fig"));
  l.push(String.from("banana"));
  l.push(String.from("cherry"));
  l.reverse();
  expectStr(l[0usize].view(), "cherry", "reverse of Strings: first");
  expectStr(l[4usize].view(), "pear", "reverse of Strings: last");
  l.sortUnstable();
  expectStr(l[0usize].view(), "apple", "String sortUnstable: first");
  expectStr(l[4usize].view(), "pear", "String sortUnstable: last");
  expectInt(if l.isSorted() { 1i64 } else { 0i64 }, 1i64, "Strings are sorted");
  l.sortUnstableBy(fn(a: &String, b: &String) i32 { b.len() <=> a.len() });
  expectInt(i64.from(l[0usize].len()), 6i64, "by length descending: the first has 6 letters");
  let at, found = l.binarySearchBy(fn(e: &String) i32 { 0i32 });
  expectInt(i64.from(at), 0i64, "a probe that finds everything equal: position 0");
}

fn slicing() {
  var l = List[i32]() <- 5i32, 4i32, 3i32, 2i32, 1i32, 0i32;
  l.sliceMut(1usize, 5usize).sortUnstable();
  expectInt(i64.from(l[0usize]), 5i64, "sliceMut leaves the first alone");
  expectInt(i64.from(l[1usize]), 1i64, "sliceMut sorts the middle: 1");
  expectInt(i64.from(l[4usize]), 4i64, "sliceMut sorts the middle: 4");
  expectInt(i64.from(l[5usize]), 0i64, "sliceMut leaves the last alone");
  let s = l.slice(2usize, 4usize);
  expectInt(i64.from(s.len), 2i64, "slice has the two elements");
  expectInt(i64.from(s[0usize]), 2i64, "slice: 2");
  l.reverse();
  expectInt(i64.from(l[0usize]), 0i64, "reverse of a List");
}

fn main() i32 {
  differential();
  selection();
  searching();
  floatsEdge();
  strings();
  slicing();
  done()
}
