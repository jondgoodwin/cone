// A null pointer is not a C string: making a String from one is a program
// error, and a panic at the caller's line, which .err pins. A C function's
// null answer (getenv's, for a variable no one sets) is the caller's to ask
// about first.

mod nullcstr;

import stdio use *;
import collections use *;
import libc;

fn main() i32 {
  printStr("making a String from a null pointer\n");
  imm s = String.fromCStr(libc.getenv("CONE_COLLECTIONS_NEVER_SET"));
  printStr("not reached\n");
  0i32;
}
