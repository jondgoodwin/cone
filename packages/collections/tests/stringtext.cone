// Every kind of value core writes as text, at its limits, sent to a String with
// '<-': each integer type's smallest, largest and zero, the floats (zero and
// negative zero, the largest, the smallest that is not zero, an infinity, a
// NaN, and 0.1, which writes as itself), a bool, a char of one to four UTF-8
// bytes and the one that writes nothing, a text, and a String. Each line is
// written into one String with several pieces, and printed whole.
//
// An f32 is written as the shortest text that reads back as that f32 ("0.1"),
// not as the f64 it widens to; an f64 as the shortest text that reads back
// as it, with ".0" after a whole number, so that the text is a float's. A NaN is
// "nan" whatever its sign.

mod stringtext;

import stdio use *;
import collections use *;

fn show(line: &mut String) {
  print <- line.view(), "\n";
  line.clear();
}

fn main() i32 {
  var s = String();

  s <- "i8 ", -128i8, " ", 127i8, " ", 0i8;
  show(&mut s);
  s <- "u8 ", 0u8, " ", 255u8;
  show(&mut s);
  s <- "i16 ", -32768i16, " ", 32767i16, " ", 0i16;
  show(&mut s);
  s <- "u16 ", 0u16, " ", 65535u16;
  show(&mut s);
  s <- "i32 ", -2147483647i32 - 1i32, " ", 2147483647i32, " ", 0i32;
  show(&mut s);
  s <- "u32 ", 0u32, " ", 4294967295u32;
  show(&mut s);
  s <- "i64 ", -9223372036854775807i64 - 1i64, " ", 9223372036854775807i64, " ", 0i64;
  show(&mut s);
  s <- "u64 ", 0u64, " ", 18446744073709551615u64;
  show(&mut s);
  s <- "isize ", 0isize, " ", 7isize, " usize ", 0usize, " ", 7usize;
  show(&mut s);

  let zero = 0.0;
  s <- "f64 ", 0.0, " ", -0.0, " ", 1.7976931348623157e308, " ", 5e-324, " ", 1.0 / zero, " ", -1.0 / zero,
    " ", zero / zero, " ", -(zero / zero);
  show(&mut s);
  s <- "f64 ", 0.1, " ", 1e16, " ", 123456789012345.0, " ", 0.0001, " ", 0.00001, " ", 100.0, " ", -2.5;
  show(&mut s);
  let fzero = 0.0f32;
  s <- "f32 ", 0.0f32, " ", -0.0f32, " ", 3.4028235e38f32, " ", 1e-45f32, " ", 1.0f32 / fzero, " ", fzero / fzero;
  show(&mut s);
  s <- "f32 ", 0.1f32, " ", 16777216.0f32, " ", 1.5f32;
  show(&mut s);

  s <- "bool ", true, " ", false;
  show(&mut s);
  s <- "char ", 'A', "|", 'é', "|", '€', "|", '😀', "|", char.from(0u32), "|", char.from(0x10FFFFu32);
  show(&mut s);

  let owned = String.from("owned");
  s <- "text ", "literal", " ", owned, " ", owned.view(), " [", "", "]";
  show(&mut s);

  // Numbers sent alone, a number typed by its place
  s <- 42;
  s <- " ";
  s <- -7;
  s <- " ";
  s <- 3.5;
  show(&mut s);
  0
}
