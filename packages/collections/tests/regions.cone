// A collection gets its block from the region it points to, grows it there and
// gives it back there. Here the region is a counting one, three functions that
// call the C library and tally what they were asked: allocations, resizes,
// releases of a block (a null one is nothing and is not counted), and the bytes
// handed out and not yet given back. A collection is made in it by passing it
// as the construction's last argument, 'new List[i64](region)'. Every expected
// count is worked out by hand from the growth rules:
// - a List's block is 4 values, then doubles (4, 8, 16, 32, 64, 128 for a hundred),
//   its first block coming from a resize of nothing; 'new List[i64](50, r)'
//   allocates 50 slots at once and doubles to 100 at the 51st value;
// - a Deque's growth allocates a new block and releases the old (6 blocks of a
//   hundred values, 5 released on the way);
// - a Dict, a Set and an OrderedDict grow their tables from 8 buckets by
//   doubling when the 8th, 15th, 29th, 57th and 113th entry arrive, so a
//   hundred entries make 8, 16, 32, 64 and 128 buckets: five blocks, four
//   released on the way. Dict[i64, i64] puts 16 bytes of entry in each bucket
//   and a control byte and 8 more: 128 * 16 + 128 + 8 = 2184 bytes; a Set's
//   entry takes 8: 128 * 8 + 128 + 8 = 1160. An OrderedDict has two blocks, the
//   index (5 bytes a bucket and 8: 648) and the dense entries of 24 bytes, room
//   for 7/8 of the buckets (112 * 24 = 2688), 3336 in all, the dense one resized
//   at each growth and the index allocated;
// - a String is a List[u8] and its NUL: 'new String(100, r)' allocates 101,
//   a 101st byte doubles it to 202;
// - a block the region cannot hand to a Uni, because the owner frees it with the
//   C library, is moved to one of the heap's and the region's given back.
// The sizes of the collections end it: each grew by the word that holds its region.

mod regions;

import testing use *;
import collections use *;
import libc;

// A counting region: its header first, then the tallies
struct Counting {
  header MemRegion;
  allocs usize;
  resizes usize;
  releases usize;
  live isize;
}

fn countAlloc(r *MemRegion, bytes usize, align usize) *u8 {
  let c = r as *Counting;
  (*c).allocs = (*c).allocs + 1usize;
  (*c).live = (*c).live + isize.from(bytes);
  libc.malloc(bytes)
}

fn countResize(r *MemRegion, block *u8, oldBytes usize, newBytes usize, align usize) *u8 {
  let c = r as *Counting;
  (*c).resizes = (*c).resizes + 1usize;
  (*c).live = (*c).live + isize.from(newBytes) - isize.from(oldBytes);
  libc.realloc(block, newBytes)
}

fn countRelease(r *MemRegion, block *u8, bytes usize) {
  if block as usize == 0usize { return; }
  let c = r as *Counting;
  (*c).releases = (*c).releases + 1usize;
  (*c).live = (*c).live - isize.from(bytes);
  libc.free(block);
}

fn newCounting() Counting {
  new Counting(new MemRegion(&countAlloc, &countResize, &countRelease), 0usize, 0usize, 0usize, 0isize)
}

fn regionOf(c &mut Counting) *MemRegion { (c as *Counting) as *MemRegion }

// What the region was asked, against what is wanted
fn tally(c &Counting, allocs u64, resizes u64, releases u64, live i64, label &Array[u8]) {
  let ok = u64.from(c.allocs) == allocs and u64.from(c.resizes) == resizes
    and u64.from(c.releases) == releases and i64.from(c.live) == live;
  expect(ok, label);
}

fn expectRef(got Option[&i64], want i64, label &Array[u8]) {
  match got {
    case let s Some {expectInt(*s, want, label);}
    case is None {expect(false, label);}
  }
}

fn listGrows() {
  var c = newCounting();
  {
    var l = new List[i64](regionOf(&mut c));
    tally(&c, 0, 0, 0, 0, "an empty list in a region asks it for nothing");
    var i = 0i64;
    while i < 100i64 { l.push(i); i = i + 1i64; }
    tally(&c, 0, 6, 0, 1024, "a hundred values: six resizes, the last block 128 values of 8 bytes");
    expectUInt(u64.from(l.len()), 100, "all hundred are there");
    expectInt(*l[0usize], 0, "the first survived the moves");
    expectInt(*l[99usize], 99, "and the last");
  }
  tally(&c, 0, 6, 1, 0, "its death gave the block back");
}

fn listCapacity() {
  var c = newCounting();
  {
    var l = new List[i64](50usize, regionOf(&mut c));
    tally(&c, 1, 0, 0, 400, "a starting size allocates it at once");
    var i = 0i64;
    while i < 50i64 { l.push(i); i = i + 1i64; }
    tally(&c, 1, 0, 0, 400, "fifty values fit");
    l.push(50i64);
    tally(&c, 1, 1, 0, 800, "the fifty-first doubles the block");
  }
  tally(&c, 1, 1, 1, 0, "and the death gives it back");
}

fn dequeGrows() {
  var c = newCounting();
  {
    var d = new Deque[i64](regionOf(&mut c));
    var i = 0i64;
    while i < 100i64 { d.push(i); i = i + 1i64; }
    tally(&c, 6, 0, 5, 1024, "a deque allocates each larger block and releases the one before");
    expectInt(*d[0usize], 0, "the first survived the moves");
    expectInt(*d[99usize], 99, "and the last");
  }
  tally(&c, 6, 0, 6, 0, "its death gave the last back");
  {
    let d = new Deque[i64](20usize, regionOf(&mut c));
    tally(&c, 7, 0, 6, 160, "a deque with a starting size allocates it");
  }
  tally(&c, 7, 0, 7, 0, "and gives it back");
}

fn dictGrows() {
  var c = newCounting();
  {
    var d = new Dict[i64, i64](regionOf(&mut c));
    tally(&c, 0, 0, 0, 0, "an empty dict in a region asks it for nothing");
    var i = 0i64;
    while i < 100i64 { d.insert(i, i * 2i64); i = i + 1i64; }
    tally(&c, 5, 0, 4, 2184, "a hundred entries: tables of 8, 16, 32, 64 and 128 buckets");
    let k = 99i64;
    expectRef(d.get(&k), 198, "the last entry survived the moves");
    expectUInt(u64.from(d.len()), 100, "all hundred are there");
  }
  tally(&c, 5, 0, 5, 0, "its death gave the table back");
}

fn dictCapacity() {
  var c = newCounting();
  {
    var d = new Dict[i64, i64](100usize, regionOf(&mut c));
    tally(&c, 1, 0, 0, 2184, "room for a hundred is one table of 128 buckets");
    expect(d.capacity() >= 100usize, "with room for a hundred entries");
    var i = 0i64;
    while i < 100i64 { d.insert(i, i); i = i + 1i64; }
    tally(&c, 1, 0, 0, 2184, "and a hundred entries need no growing");
  }
  tally(&c, 1, 0, 1, 0, "its death gave the table back");
}

fn orderedGrows() {
  var c = newCounting();
  {
    var d = new OrderedDict[i64, i64](regionOf(&mut c));
    var i = 0i64;
    while i < 100i64 { d.insert(i, i * 2i64); i = i + 1i64; }
    tally(&c, 5, 5, 4, 3336, "five indexes allocated, four released, the dense block resized five times");
    let k = 99i64;
    expectRef(d.get(&k), 198, "the last entry survived the moves");
  }
  tally(&c, 5, 5, 6, 0, "its death gave back both blocks");
}

fn orderedCapacity() {
  var c = newCounting();
  {
    var d = new OrderedDict[i64, i64](100usize, regionOf(&mut c));
    tally(&c, 1, 1, 0, 3336, "room for a hundred is an index of 128 buckets and its dense entries");
    var i = 0i64;
    while i < 100i64 { d.insert(i, i); i = i + 1i64; }
    tally(&c, 1, 1, 0, 3336, "and a hundred entries need no growing");
  }
  tally(&c, 1, 1, 2, 0, "its death gave back both");
}

fn setGrows() {
  var c = newCounting();
  {
    var s = new Set[i64](regionOf(&mut c));
    var i = 0i64;
    while i < 100i64 { s.insert(i); i = i + 1i64; }
    tally(&c, 5, 0, 4, 1160, "a set grows its dictionary's table through the region");
    expect(s.contains(&i) == false and s.len() == 100usize, "a hundred elements, and 100 is not one");
  }
  tally(&c, 5, 0, 5, 0, "its death gave the table back");
  {
    var s = new Set[i64](100usize, regionOf(&mut c));
    tally(&c, 6, 0, 5, 1160, "a set with a starting size allocates its table");
    var i = 0i64;
    while i < 100i64 { s.insert(i); i = i + 1i64; }
    tally(&c, 6, 0, 5, 1160, "and a hundred elements need no growing");
  }
  tally(&c, 6, 0, 6, 0, "and gives it back");
}

fn stringGrows() {
  var c = newCounting();
  {
    var s = new String(100usize, regionOf(&mut c));
    tally(&c, 1, 0, 0, 101, "a string with room for a hundred bytes holds a hundred and the NUL");
    var i = 0usize;
    while i < 100usize { s.appendByte('a'); i = i + 1usize; }
    tally(&c, 1, 0, 0, 101, "a hundred bytes fit");
    s.appendByte('b');
    tally(&c, 1, 1, 0, 202, "a hundred and first doubles the block");
    expectUInt(u64.from(s.len()), 101, "all are there");
  }
  tally(&c, 1, 1, 1, 0, "its death gave the block back");
}

// 'padStart' builds the longer text in the string's own region, and the old
// block goes back to it
fn stringPads() {
  var c = newCounting();
  {
    var s = new String(regionOf(&mut c));
    s.append("7");
    tally(&c, 0, 1, 0, 4, "a first byte makes a block of four");
    s.padStart(10usize, '0');
    tally(&c, 1, 1, 1, 11, "padding allocates eleven in the region and gives the four back");
    expect(s.view() == "0000000007", "the text is padded");
  }
  tally(&c, 1, 1, 2, 0, "its death gave the block back");
}

// A Uni frees its block with the C library, so freezing a list that lives in a
// region moves the values into a heap block and gives the region's back
fn freezes() {
  var c = newCounting();
  {
    var l = new List[i64](regionOf(&mut c));
    l.push(1i64);
    l.push(2i64);
    l.push(3i64);
    tally(&c, 0, 1, 0, 32, "three values: a block of four");
    let owner = l.freeze();
    tally(&c, 0, 1, 1, 0, "freezing gave the region's block back");
    expectUInt(u64.from(owner.len), 3, "the owner holds three");
    expectInt(owner[2usize], 3, "and the last is 3");
  }
  {
    var s = new String(regionOf(&mut c));
    s.append("abc");
    let owner = s.freeze();
    tally(&c, 0, 2, 2, 0, "a frozen string gave its block back too");
    expectUInt(u64.from(owner.len), 3, "three bytes");
    expect(owner.startsWith("abc"), "the text is abc");
  }
}

fn sizes() {
  expectUInt(u64.from(mem.sizeof[List[i64]]()), 32, "a List is three words and its region");
  expectUInt(u64.from(mem.sizeof[Deque[i64]]()), 40, "a Deque, four words and its region");
  expectUInt(u64.from(mem.sizeof[String]()), 32, "a String is a List");
  expectUInt(u64.from(mem.sizeof[Dict[i64, i64]]()), 56, "a Dict, six words and its region");
  expectUInt(u64.from(mem.sizeof[OrderedDict[i64, i64]]()), 64, "an OrderedDict, seven words and its region");
  expectUInt(u64.from(mem.sizeof[Set[i64]]()), 56, "a Set is a Dict");
}

fn main() i32 {
  listGrows();
  listCapacity();
  dequeGrows();
  dictGrows();
  dictCapacity();
  orderedGrows();
  orderedCapacity();
  setGrows();
  stringGrows();
  stringPads();
  freezes();
  sizes();
  done()
}
