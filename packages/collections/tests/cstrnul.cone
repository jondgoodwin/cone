// A NUL inside a String's text would end its C string early, for C reads only
// up to the first NUL, so asking for the C string of such text is a program
// error and a panic, at the caller's line, which .err pins. The text itself is
// fine to hold and to read, and a String without a NUL, or none at all, hands
// out its C string as ever.

mod cstrnul;

import stdio use *;
import collections use *;
import libc;

fn main() i32 {
  mut fine = String.from("ab");
  printStr("a String without a NUL is a C string of 2 bytes: ");
  printUInt(u64.from(libc.strlen(fine.cstr())));
  printStr("\n");
  mut nul = String.from("a");
  nul.appendByte(0u8);
  nul.append("b");
  printStr("a String holding a NUL has 3 bytes: ");
  printUInt(u64.from(nul.len()));
  printStr("\n");
  printStr("asking for its C string\n");
  imm c = nul.cstr();
  printStr("not reached\n");
  0i32;
}
