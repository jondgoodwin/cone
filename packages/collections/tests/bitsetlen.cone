// A set operation against a set of another length is a panic naming both lengths and the
// caller's line

mod bitsetlen;

import stdio use *;
import collections use *;

fn main() i32 {
  var a = BitSet(10usize);
  let b = BitSet(70usize);
  printStr("union of 10 and 70\n");
  a.unionWith(&b);
  printStr("not reached\n");
  0i32
}
