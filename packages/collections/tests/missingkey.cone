// Reading a key a dictionary does not hold is a program error, as an index
// past a list's end is: stderr says 'collections: no entry for the key
// "sdl"', and the program ends with exit status 1.

mod missingkey;

import stdio use *;
import collections use *;

fn main() i32 {
  mut d = Dict[String, i64].empty();
  d.insert(String.from("core"), 1);
  printStr("reading a key it does not hold\n");
  printInt(*d["sdl"]);
  printStr("not reached\n");
  0i32;
}
