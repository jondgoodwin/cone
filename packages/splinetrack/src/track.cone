// ======== A track: a spline with banking, parameterised by arc length ========
//
// A Track is a curve through control points (TrackPoint: a place and a roll angle), closed or open.
//
// THE CURVE. A cubic Hermite spline through the points whose tangents are the chord-length cardinal
// tangents, m_i = (P[i+1] - P[i-1]) / (d[i-1] + d[i]) in each segment's own chord-length scale
// (the non-uniform Catmull-Rom of Hermite form, Catmull and Rom 1974 with Barry and Goldman's chord
// parameterisation): it passes through every point, has a continuous tangent, and does not overshoot
// where the points are unevenly spaced, which the uniform Catmull-Rom does. An open track's end tangents
// are the chords to the neighbour unless the caller gives them ('startTangent', 'endTangent').
//
// ARC LENGTH. The spline is sampled SUB times a segment into a table of nodes (arc length, place,
// tangent, up vector, curvature vector, roll); asking for the place at arc length s is a binary search
// and an interpolation between two nodes, so a car moving at speed v moves v dt along the track
// whatever the spacing of the control points. (Industry method: the arc-length table, as in every
// spline-follow system.)
//
// THE FRAME. Up vectors are carried along by the rotation-minimising frame, the double reflection
// method (Wang, Juttler, Zheng and Liu, "Computation of rotation minimizing frames", ACM Trans.
// Graphics 27(1), 2008). A frame from "world up, projected" fails where a tangent points straight up,
// which a loop does; the minimising frame does not twist. A closed track's frame is brought back to its
// start by spreading the closing twist evenly over the length. The roll angle of each node is then
// applied about the tangent: banking. Positive roll tips the up vector toward the right (the side of a
// right turn's centre).
//
// CONVENTIONS. x of a car's frame is forward (the tangent), y is up, z is right (forward x up).
// Curvature is the vector dT/ds, pointing to the centre of the bend, 1/radius long.

// A control point: a place, and the bank angle (radians) the track has there
pub struct TrackPoint {
  pub pos Vec3;
  pub roll f32;
}

// What the track is at one arc length
pub struct TrackSample {
  pub s f32;                // arc length, after wrapping on a closed track
  pub pos Vec3;
  pub tangent Vec3;         // unit, forward
  pub up Vec3;              // unit, with the banking, perpendicular to the tangent
  pub right Vec3;           // tangent x up
  pub curvature Vec3;       // dT/ds
  pub roll f32;
}

// The Track's samples per segment between control points
pub const TRACK_SUB = 48;

pub struct Track {
  pub points List[TrackPoint];
  pub closed bool;
  pub length f32;
  // the table: one entry per node, nodes 0 .. count-1 (a closed track repeats node 0 as its last)
  pub ts List[f32];
  pub ps List[Vec3];
  pub tans List[Vec3];
  pub ups List[Vec3];
  pub kaps List[Vec3];
  pub rolls List[f32];

  // Build the track through 'points'. 'closed' joins the last to the first. For an open track
  // 'startTan' and 'endTan' are the end tangents (unit vectors) or zero for the chord.
  pub fn build(points List[TrackPoint], closed bool, startTan Vec3, endTan Vec3) Track {
    let n = points.len();
    let nseg = if closed { n } else { n - 1usize };
    // chord lengths
    var chord = List[f32].empty();
    var i = 0usize;
    while i < nseg {
      let j = (i + 1usize) % n;
      chord.push((points[j].pos - points[i].pos).length());
      i = i + 1usize;
    }
    // Hermite tangents (position derivative per unit of the segment's u, so scaled by the chord of the
    // segment it is used in)
    var tg = List[Vec3].empty();
    i = 0usize;
    while i < n {
      var m = new Vec3(0., 0., 0.);
      if closed {
        let prev = (i + n - 1usize) % n;
        let next = (i + 1usize) % n;
        let d0 = *chord[prev];
        let d1 = *chord[i];
        m = (points[next].pos - points[prev].pos) * (1. / (d0 + d1));
      } elif i == 0usize {
        m = if startTan.lengthSquared() > 0.5 { startTan } else { (points[1usize].pos - points[0usize].pos) * (1. / *chord[0usize]) };
      } elif i == n - 1usize {
        m = if endTan.lengthSquared() > 0.5 { endTan } else { (points[i].pos - points[i - 1usize].pos) * (1. / *chord[i - 1usize]) };
      } else {
        m = (points[i + 1usize].pos - points[i - 1usize].pos) * (1. / (*chord[i - 1usize] + *chord[i]));
      }
      tg.push(m);
      i = i + 1usize;
    }
    // roll tangents: central differences in the control index
    var rt = List[f32].empty();
    i = 0usize;
    while i < n {
      var r = 0.;
      if closed {
        r = (points[(i + 1usize) % n].roll - points[(i + n - 1usize) % n].roll) * 0.5;
      } elif i == 0usize {
        r = points[1usize].roll - points[0usize].roll;
      } elif i == n - 1usize {
        r = points[i].roll - points[i - 1usize].roll;
      } else {
        r = (points[i + 1usize].roll - points[i - 1usize].roll) * 0.5;
      }
      rt.push(r);
      i = i + 1usize;
    }
    // sample
    var ps = List[Vec3].empty();
    var ds = List[Vec3].empty();      // derivative directions (not unit)
    var rolls = List[f32].empty();
    var seg = 0usize;
    while seg < nseg {
      let a = seg;
      let b = (seg + 1usize) % n;
      let d = *chord[seg];
      let pa = points[a].pos;
      let pb = points[b].pos;
      let ma = *tg[a] * d;
      let mb = *tg[b] * d;
      let ra = points[a].roll;
      let rb = points[b].roll;
      let rma = *rt[a];
      let rmb = *rt[b];
      var k = 0;
      while k < TRACK_SUB {
        let u = f32.from(k) / f32.from(TRACK_SUB);
        let u2 = u * u;
        let u3 = u2 * u;
        let h00 = 2. * u3 - 3. * u2 + 1.;
        let h10 = u3 - 2. * u2 + u;
        let h01 = -2. * u3 + 3. * u2;
        let h11 = u3 - u2;
        ps.push(pa * h00 + ma * h10 + pb * h01 + mb * h11);
        let g00 = 6. * u2 - 6. * u;
        let g10 = 3. * u2 - 4. * u + 1.;
        let g01 = -6. * u2 + 6. * u;
        let g11 = 3. * u2 - 2. * u;
        ds.push(pa * g00 + ma * g10 + pb * g01 + mb * g11);
        rolls.push(ra * h00 + rma * h10 + rb * h01 + rmb * h11);
        k = k + 1;
      }
      seg = seg + 1usize;
    }
    // the last node
    if closed {
      ps.push(*ps[0usize]);
      ds.push(*ds[0usize]);
      rolls.push(*rolls[0usize]);
    } else {
      let last = points[n - 1usize];
      ps.push(last.pos);
      ds.push(*tg[n - 1usize] * *chord[nseg - 1usize]);
      rolls.push(last.roll);
    }
    let count = ps.len();
    // arc length and unit tangents
    var ts = List[f32].empty();
    var tans = List[Vec3].empty();
    ts.push(0.);
    i = 0usize;
    while i < count {
      tans.push((*ds[i]).normalize());
      if i > 0usize { ts.push(*ts[i - 1usize] + (*ps[i] - *ps[i - 1usize]).length()); }
      i = i + 1usize;
    }
    let total = *ts[count - 1usize];
    // the rotation-minimising frame by double reflection, from a first up
    var frameUp = List[Vec3].empty();
    let t0 = *tans[0usize];
    var up0 = new Vec3(0., 1., 0.);
    if libc.fabsf(t0.y) > 0.95 { up0 = new Vec3(0., 0., 1.); }
    up0 = (up0 - t0 * up0.dot(t0)).normalize();
    frameUp.push(up0);
    i = 0usize;
    while i + 1usize < count {
      // double reflection from node i to node i + 1
      let x0 = *ps[i];
      let x1 = *ps[i + 1usize];
      let r0 = *frameUp[i];
      let tt0 = *tans[i];
      let tt1 = *tans[i + 1usize];
      let v1 = x1 - x0;
      let c1 = v1.dot(v1);
      var up1 = r0;
      if c1 > 0.0000000001 {
        let rL = r0 - v1 * (2. / c1 * v1.dot(r0));
        let tL = tt0 - v1 * (2. / c1 * v1.dot(tt0));
        let v2 = tt1 - tL;
        let c2 = v2.dot(v2);
        up1 = if c2 > 0.0000000001 { rL - v2 * (2. / c2 * v2.dot(rL)) } else { rL };
      }
      up1 = (up1 - tt1 * up1.dot(tt1)).normalize();
      frameUp.push(up1);
      i = i + 1usize;
    }
    // a closed track: spread the twist the frame has picked up by the end over the length
    if closed {
      let uEnd = *frameUp[count - 1usize];
      let uStart = *frameUp[0usize];
      let tStart = *tans[0usize];
      // the angle from the end's up to the start's up, about the tangent
      let sinA = tStart.dot(uEnd.cross(uStart));
      let cosA = uEnd.dot(uStart);
      let twist = libc.atan2f(sinA, cosA);
      i = 0usize;
      while i < count {
        let f = *ts[i] / total;
        frameUp[i] = (Quat.angleAxis(twist * f, *tans[i]) * *frameUp[i]).normalize();
        i = i + 1usize;
      }
    }
    // LEVELLING. A rotation-minimising frame is neutral, not level: a track that climbs, turns and loops
    // arrives with its up vector twisted about the tangent by the path's holonomy (an angle the path itself
    // decides), so "roll 0" would not mean "the rails are level". At every node whose tangent is within
    // about 45 degrees of the horizontal, find the turn about the tangent that makes the up vector
    // vertical, taking the nearer of up and down (so an inverted stretch, the top of a loop, stays
    // inverted, not flipped); between those nodes (the steep parts, where "vertical" has no meaning) the
    // turn is interpolated along the arc length, and beyond the first or last it is held. Roll is then
    // the banking away from level.
    var valid = List[bool].empty();
    var level = List[f32].empty();
    i = 0usize;
    while i < count {
      let tn = *tans[i];
      if libc.fabsf(tn.y) < 0.7 {
        let href = (new Vec3(0., 1., 0.) - tn * tn.y).normalize();
        let a = *frameUp[i];
        var phi = libc.atan2f(tn.dot(a.cross(href)), a.dot(href));
        if phi > 1.5707963 { phi = phi - 3.14159265; }
        if phi < -1.5707963 { phi = phi + 3.14159265; }
        valid.push(true);
        level.push(phi);
      } else {
        valid.push(false);
        level.push(0.);
      }
      i = i + 1usize;
    }
    var anyValid = false;
    i = 0usize;
    while i < count { if *valid[i] { anyValid = true; } i = i + 1usize; }
    if anyValid {
      i = 0usize;
      while i < count {
        if !*valid[i] {
          // the nearest valid nodes either side
          var lo = i;
          while lo > 0usize and !*valid[lo] { lo = lo - 1usize; }
          var hi = i;
          while hi + 1usize < count and !*valid[hi] { hi = hi + 1usize; }
          let hasLo = *valid[lo];
          let hasHi = *valid[hi];
          if hasLo and hasHi {
            let f = (*ts[i] - *ts[lo]) / (*ts[hi] - *ts[lo]);
            level[i] = *level[lo] * (1. - f) + *level[hi] * f;
          } elif hasLo {
            level[i] = *level[lo];
          } elif hasHi {
            level[i] = *level[hi];
          }
        }
        i = i + 1usize;
      }
      i = 0usize;
      while i < count {
        frameUp[i] = (Quat.angleAxis(*level[i], *tans[i]) * *frameUp[i]).normalize();
        i = i + 1usize;
      }
    }
    // the banking: roll each up about its tangent
    var ups = List[Vec3].empty();
    i = 0usize;
    while i < count {
      ups.push(Quat.angleAxis(*rolls[i], *tans[i]) * *frameUp[i]);
      i = i + 1usize;
    }
    // curvature vectors dT/ds: central differences over the neighbouring nodes
    var kaps = List[Vec3].empty();
    i = 0usize;
    while i < count {
      var lo = if i > 0usize { i - 1usize } else { 0usize };
      var hi = if i + 1usize < count { i + 1usize } else { count - 1usize };
      if closed {
        // a closed track's nodes 0 and count-1 are the same place: wrap
        if i == 0usize or i == count - 1usize {
          lo = count - 2usize;
          hi = 1usize;
        }
      }
      var dsn = *ts[hi] - *ts[lo];
      if closed and (i == 0usize or i == count - 1usize) { dsn = *ts[1usize] + (total - *ts[count - 2usize]); }
      kaps.push((*tans[hi] - *tans[lo]) * (1. / dsn));
      i = i + 1usize;
    }
    new Track(points, closed, total, ts, ps, tans, ups, kaps, rolls)
  }

  // A track with no nodes, to be filled by a network's route (network.cone)
  pub fn empty() Track {
    new Track(List[TrackPoint].empty(), false, 0., List[f32].empty(), List[Vec3].empty(), List[Vec3].empty(),
      List[Vec3].empty(), List[Vec3].empty(), List[f32].empty())
  }

  pub fn nodeCount(self &) usize { ts.len() }

  // The index of the node at or before arc length s (0 .. count-2)
  fn find(self &, s f32) usize {
    var lo = 0usize;
    var hi = ts.len() - 1usize;
    while hi - lo > 1usize {
      let mid = (lo + hi) / 2usize;
      if *ts[mid] <= s { lo = mid; } else { hi = mid; }
    }
    lo
  }

  // Arc length folded into the track: wrapped on a closed track, clamped on an open one
  pub fn wrap(self &, s f32) f32 {
    if closed {
      var r = s - length * libc.floorf(s / length);
      if r >= length { r = 0.; }
      r
    } else {
      if s < 0. { 0. } elif s > length { length } else { s }
    }
  }

  // The track at arc length s
  pub fn at(self &, s0 f32) TrackSample {
    let s = wrap(s0);
    let i = find(s);
    let span = *ts[i + 1usize] - *ts[i];
    let f = if span > 0.0000001 { (s - *ts[i]) / span } else { 0. };
    let tangent = (*tans[i]).lerp(*tans[i + 1usize], f).normalize();
    var up = (*ups[i]).lerp(*ups[i + 1usize], f);
    up = (up - tangent * up.dot(tangent)).normalize();
    new TrackSample(s, (*ps[i]).lerp(*ps[i + 1usize], f), tangent, up, tangent.cross(up),
      (*kaps[i]).lerp(*kaps[i + 1usize], f), *rolls[i] * (1. - f) + *rolls[i + 1usize] * f)
  }
}
