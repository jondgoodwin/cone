// The splinetrack package (a working name; Jon names packages): anything that runs on a track. A program
// reaches it with 'import splinetrack':
//
//   mut pts = List[TrackPoint].empty();
//   pts.push(new TrackPoint(new Vec3(0., 0., 0.), 0.));      // a place and a bank angle
//   ...
//   imm track = Track.build(pts, false, zero3(), zero3());    // open; or true to close it
//   mut train = Train.uniform(CarSpec.coaster(), 5usize, 12.);
//   mut zones = List[Zone].empty();
//   zones.push(Zone.chain(0., 60., 3., 8000.));
//   // every frame:
//   train.step(&track, &zones, dt);
//   imm pose = train.carPose(&track, 0usize);                 // position and orientation of car 0
//   imm g = train.gforce(&track, 0usize);                     // what its rider feels, in g
//
// See track.cone, train.cone and railmesh.cone for the methods; Design\splinetrack.md for the design.
//
// FILES. Only this root imports.
//   track.cone     TrackPoint, Track (spline, arc-length table, rotation-minimising frames, banking), TrackSample
//   train.cone     Zone (chain, launch, brake), CarSpec, Train (RK4 along the track), GForce, CarPose
//   railmesh.cone  RailSpec, railMesh: rails, ties and supports as meshes from a Track
//   network.cone   TrackNetwork (tracks, joins, switches, per-track zones), NetTrain (a train on a network: junctions)

mod splinetrack;

import libc;
import collections use *;
import geomath use *;
import mesh use Mesh;
