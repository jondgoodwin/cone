// The track (src/track.cone): arc length, the frame, banking. Each check against a number worked out by hand.
//
// 1. A straight track of three points on a line is exactly as long as the line, its tangent is the line's.
// 2. A closed ring of 32 control points on a circle of radius 20 m is 2 pi R long to 0.3 percent, its places
//    stay within 0.5 percent of R from the centre, and its curvature is 1 / R to 3 percent.
// 3. Arc length is the parameter: places a small step ds apart along the ring (and an S-curve of unevenly
//    spaced points) are ds apart in space to 1 percent, wherever you look.
// 4. The frame is orthonormal at every node (tangent, up, right) and, on the level ring with no banking, up
//    is the world's up.
// 5. Banking: a straight track with roll 30 degrees at both ends has up tilted 30 degrees from vertical
//    toward the right (positive roll), at the middle too.
// 6. A vertical loop's frame does not twist: a loop (a circle in the x-y plane, entered along +x) has up
//    pointing at the loop's centre at the top of the loop... checked on a closed vertical ring, whose up
//    vector at the lowest point is +y and at the top -y.

mod tracktest;

import testing use *;
import collections use *;
import geomath use *;
import libc;
import splinetrack use *;

fn pt(x: f32, y: f32, z: f32, roll: f32) TrackPoint { TrackPoint(Vec3(x, y, z), roll) }

fn ring(n: i32, r: f32, vertical: bool, roll: f32) Track {
  var pts = List[TrackPoint].empty();
  var i = 0;
  while i < n {
    let a = 6.28318530718 * f32.from(i) / f32.from(n);
    if vertical { pts.push(pt(r * libc.sinf(a), r - r * libc.cosf(a), 0., roll)); }
    else { pts.push(pt(r * libc.cosf(a), 0., r * libc.sinf(a), roll)); }
    i = i + 1;
  }
  Track.build(pts, true, Vec3(0., 0., 0.), Vec3(0., 0., 0.))
}

fn main() i32 {
  // 1. straight
  var sp = List[TrackPoint].empty();
  sp.push(pt(0., 0., 0., 0.)); sp.push(pt(10., 5., 0., 0.)); sp.push(pt(30., 15., 0., 0.));
  let straight = Track.build(sp, false, Vec3(0., 0., 0.), Vec3(0., 0., 0.));
  let L = (Vec3(30., 15., 0.)).length();
  expectFloat(f64.from(straight.length), f64.from(L), 0.002, "a straight track is the line's length");
  let st = straight.at(12.).tangent;
  expectFloat(f64.from(st.dot((Vec3(30., 15., 0.)).normalize())), 1.0, 0.0001, "its tangent is the line's direction");
  expectFloat(f64.from(straight.at(L * 0.5).pos.y), f64.from(L * 0.5 * 15. / L), 0.01, "a place half way along it");

  // 2. ring
  let R = 20.f;
  let rg = ring(32, R, false, 0.);
  expectFloat(f64.from(rg.length), 2.0 * 3.14159265 * 20.0, 0.5, "a ring's circumference is 2 pi R");
  var worst = 0.f;
  var worstK = 0.f;
  var s = 0.f;
  while s < rg.length {
    let q = rg.at(s);
    let d = libc.fabsf(q.pos.length() - R) / R;
    if d > worst { worst = d; }
    let kk = libc.fabsf(q.curvature.length() * R - 1.);
    if kk > worstK { worstK = kk; }
    s = s + 0.37;
  }
  expectFloat(f64.from(worst), 0.0, 0.005, "a ring's places stay within 0.5 percent of R");
  expectFloat(f64.from(worstK), 0.0, 0.03, "a ring's curvature is 1 / R");

  // 3. arc length is the parameter
  var worstDs = 0.f;
  s = 0.;
  while s < rg.length - 0.5 {
    let d = (rg.at(s + 0.25).pos - rg.at(s).pos).length();
    let e = libc.fabsf(d - 0.25) / 0.25;
    if e > worstDs { worstDs = e; }
    s = s + 0.9;
  }
  expectFloat(f64.from(worstDs), 0.0, 0.01, "places 0.25 m of arc apart are 0.25 m apart (ring)");
  var uneven = List[TrackPoint].empty();
  uneven.push(pt(0., 0., 0., 0.)); uneven.push(pt(3., 0., 1., 0.)); uneven.push(pt(25., 4., 9., 0.)); uneven.push(pt(31., 4., 14., 0.));
  uneven.push(pt(60., 0., 30., 0.));
  let sc = Track.build(uneven, false, Vec3(0., 0., 0.), Vec3(0., 0., 0.));
  worstDs = 0.;
  s = 0.;
  while s < sc.length - 0.5 {
    let d = (sc.at(s + 0.25).pos - sc.at(s).pos).length();
    let e = libc.fabsf(d - 0.25) / 0.25;
    if e > worstDs { worstDs = e; }
    s = s + 0.7;
  }
  expectFloat(f64.from(worstDs), 0.0, 0.01, "places 0.25 m of arc apart are 0.25 m apart (unevenly spaced points)");

  // 4. orthonormal frame, level ring up
  var worstO = 0.f;
  var worstUp = 0.f;
  s = 0.;
  while s < rg.length {
    let q = rg.at(s);
    let e = libc.fabsf(q.tangent.length() - 1.) + libc.fabsf(q.up.length() - 1.) + libc.fabsf(q.tangent.dot(q.up)) + libc.fabsf(q.right.length() - 1.);
    if e > worstO { worstO = e; }
    let u = (q.up - Vec3(0., 1., 0.)).length();
    if u > worstUp { worstUp = u; }
    s = s + 0.5;
  }
  expectFloat(f64.from(worstO), 0.0, 0.0005, "the frame is orthonormal");
  expectFloat(f64.from(worstUp), 0.0, 0.001, "on a level ring up is the world's up");

  // 5. banking
  var bp = List[TrackPoint].empty();
  bp.push(pt(0., 0., 0., 0.5235988)); bp.push(pt(20., 0., 0., 0.5235988)); bp.push(pt(40., 0., 0., 0.5235988));
  let banked = Track.build(bp, false, Vec3(0., 0., 0.), Vec3(0., 0., 0.));
  let bq = banked.at(17.);
  // along +x, right is +z; a roll to the right tips up toward +z
  expectFloat(f64.from(bq.up.y), f64.from(libc.cosf(0.5235988)), 0.002, "30 degrees of roll tilts up 30 degrees from vertical");
  expectFloat(f64.from(bq.up.z), f64.from(libc.sinf(0.5235988)), 0.002, "and toward the right");

  // 6. the vertical loop does not twist
  let vr = ring(40, 15., true, 0.);
  let lowest = vr.at(0.);
  let top = vr.at(vr.length * 0.5);
  expectFloat(f64.from(lowest.up.y), 1.0, 0.002, "the lowest point of a vertical ring has up = +y");
  expectFloat(f64.from(top.up.y), -1.0, 0.01, "the top of it has up = -y (its inside)");
  expectFloat(f64.from(libc.fabsf(top.up.z)), 0.0, 0.01, "and it has not twisted sideways");
  done()
}
