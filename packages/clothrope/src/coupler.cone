// ======== The coupler: a soft body and a rigid world, stepped together ========
//
// A Coupler ties one SoftBody to the bodies of one World. Each rigid body it
// couples becomes a Coupled in the soft body (its pose, velocity and inverse
// mass and inertia, refreshed from the world before every substep), its sphere,
// box and capsule shapes become Colliders that name that Coupled, and a particle
// can be held to a point of it. What the soft body does to a Coupled in a
// substep is an impulse and an angular impulse about the centre of mass, which
// the coupler gives to the rigid body afterwards. xpbdsoftbody's step.cone says
// how the two masses share a correction.
//
// The step is in lockstep: the soft body's substeps are the rigid world's steps.
//
//   soft.beginSteps(workers, dt, wind)
//   for each of its substeps h:
//       refresh   Coupled <- the world; colliders moved to the bodies' shapes
//       soft substep
//       apply     the impulses -> the rigid bodies (they wake)
//       world.step(h)
//   soft.endSteps()
//
// so with the soft body's 10 substeps the rigid world runs at 600 Hz while a
// coupled body is in play. A world step is itself four sub-steps (Soft Step), so
// a crate resting on a rope bridge is solved 2400 times a second; the cost is
// the rigid world's, and a scene that wants fewer substeps sets 'substeps' on
// the soft body. A shape of a body that is not a sphere, box or capsule (a
// hull, a mesh, a cylinder) is not made a collider: such a body can hold a rope
// but not push cloth.
//
// One Coupler serves one soft body (the links name indices in it). Several soft
// bodies in one world step the pieces themselves: 'refresh', 'apply', and the
// soft body's own 'nextSubstep', with one 'world.step' per substep.

// A prim of a body's shape in the shape's own frame
pub struct ShapePart {
  pub kind: i32;
  pub xf: Rigid;        // the prim's place in the shape (identity for a single prim)
  pub radius: f32;
  pub half: Vec3;
}

// A rigid body of the world, its Coupled in the soft body, and its shapes' colliders
pub struct BodyLink {
  pub rigid: u32;
  pub index: u32;
  pub parts: List[ShapePart];
  pub colliders: List[u32];   // for each part, its collider's index in the soft body (NO_BODY: none)
}

pub struct Coupler {
  pub workers: Workers;
  pub links: List[BodyLink];

  // A coupler whose soft body's loops use 'threads' threads in all (1: this one only)
  pub fn make(threads: u32) Coupler {
    Coupler(Workers.make(threads), List[BodyLink].empty())
  }

  // The link of rigid body 'rigid', or none
  pub fn find(self: &, rigid: u32) Option[usize] {
    var k = 0usize;
    while k < links.len() {
      if links[k].rigid == rigid { return Some[usize](k); }
      k = k + 1usize;
    }
    None
  }

  // Couple rigid body 'rigid' to the soft body: its Coupled's index. 'withShape'
  // makes colliders of its shapes (sphere, box and capsule), so cloth lies on it.
  // Coupling a body twice answers the first.
  pub fn couple(self: &mut, soft: &mut SoftBody, world: &World, rigid: u32, withShape: bool) u32 {
    match find(rigid) {
      case let Some(k) { return links[k].index; }
      case is None { }
    }
    let body = world.bodies[usize.from(rigid)];
    let index = soft.addBody(coupledOf(world, rigid));
    var link = BodyLink(rigid, index, List[ShapePart].empty(), List[u32].empty());
    if withShape {
      let shape = world.shapes[usize.from(body.shape)];
      if shape.leaves.len() == 0usize {
        addShapePart(&mut link, soft, shape.prim.kind, Rigid.identity(), shape.prim.radius, shape.prim.half);
      } else {
        var k = 0usize;
        while k < shape.leaves.len() {
          let leaf = shape.leaves[k];
          addShapePart(&mut link, soft, leaf.prim.kind, leaf.xf, leaf.prim.radius, leaf.prim.half);
          k = k + 1usize;
        }
      }
    }
    moveBodyLinkColliders(&link, soft, world);
    links.push(link);
    index
  }

  // Hold particle 'particle' of the soft body to the point of rigid body 'rigid' that is at world
  // position 'at' now (coupling the body if it is not yet, without colliders). 'breakForce' (newtons,
  // negative: never) is the pull at which the particle lets go: a rope tears from its cleat.
  pub fn anchor(self: &mut, soft: &mut SoftBody, world: &World, particle: u32, rigid: u32, at: Vec3, breakForce: f32) {
    let index = couple(soft, world, rigid, false);
    soft.attachBody(particle, index, at, breakForce);
  }

  // Bring every Coupled and collider up to the world as it is now, and clear the impulses
  pub fn refresh(self: &mut, soft: &mut SoftBody, world: &World) {
    var k = 0usize;
    while k < links.len() {
      let index = usize.from(links[k].index);
      soft.bodies.set(index, coupledOf(world, links[k].rigid));
      moveBodyLinkColliders(links[k], soft, world);
      k = k + 1usize;
    }
  }

  // Give each rigid body the impulses the soft body gave its Coupled in the last substep
  pub fn apply(self: &mut, soft: &mut SoftBody, world: &mut World) {
    var k = 0usize;
    while k < links.len() {
      let index = usize.from(links[k].index);
      let c = *soft.bodies[index];
      let id = links[k].rigid;
      if c.invMass > 0. && (c.impulse.lengthSquared() > 0. || c.angImpulse.lengthSquared() > 0.) {
        let i = usize.from(id);
        world.wake(id);
        world.bodies[i].linVel = world.bodies[i].linVel + c.impulse * world.bodies[i].invMass;
        world.bodies[i].angVel = world.bodies[i].angVel
          + rotateInertia(world.bodies[i].rot, world.bodies[i].invInertiaLocal) * c.angImpulse;
      }
      soft.bodies[index].impulse = Vec3(0., 0., 0.);
      soft.bodies[index].angImpulse = Vec3(0., 0., 0.);
      k = k + 1usize;
    }
  }

  // One step of 'dt' seconds of the soft body and the world together, in lockstep
  pub fn step(self: &mut, soft: &mut SoftBody, world: &mut World, dt: f32, wind: Vec3) {
    soft.beginSteps(&mut workers, dt, wind);
    let h = soft.substepSeconds();
    while soft.substepsLeft() > 0u32 {
      refresh(soft, world);
      soft.nextSubstep(&mut workers);
      apply(soft, world);
      world.step(h);
    }
    soft.endSteps();
  }
}

// The soft body's view of a rigid body now
fn coupledOf(world: &World, rigid: u32) Coupled {
  let b = world.bodies[usize.from(rigid)];
  let dynamic = b.motion == MotionDynamic;
  var c = Coupled.make(b.pos, b.rot, if dynamic {b.invMass} else {0.},
    if dynamic {rotateInertia(b.rot, b.invInertiaLocal)} else {Mat3([0., 0., 0., 0., 0., 0., 0., 0., 0.])});
  c.linVel = b.linVel;
  c.angVel = b.angVel;
  c
}

fn addShapePart(link: &mut BodyLink, soft: &mut SoftBody, kind: i32, xf: Rigid, radius: f32, half: Vec3) {
  link.parts.push(ShapePart(kind, xf, radius, half));
  if kind != KSphere && kind != KBox && kind != KCapsule {
    link.colliders.push(NO_BODY);
    return;
  }
  let none = Vec3(0., 0., 0.);
  var c = if kind == KSphere {Collider.sphere(none, radius)}
    else if kind == KBox {Collider.box(none, half, Quat.identity())}
    else {Collider.capsule(none, none, radius)};
  c.body = link.index;
  link.colliders.push(u32.from(soft.addCollider(c)));
}

// Put the colliders of a link at its body's shapes: each prim's place in the shape, and the shape's in
// the world (World.transformOf: the position of the shape's origin, not of the centre of mass)
fn moveBodyLinkColliders(link: &BodyLink, soft: &mut SoftBody, world: &World) {
  let shapeXf = world.transformOf(link.rigid);
  var k = 0usize;
  while k < link.parts.len() {
    let ci = *link.colliders[k];
    if ci != NO_BODY {
      let part = link.parts[k];
      let xf = shapeXf * part.xf;
      let at = usize.from(ci);
      if part.kind == KSphere {
        soft.colliders[at].a = xf.pos;
      } else if part.kind == KBox {
        soft.colliders[at].a = xf.pos;
        soft.colliders[at].rotation = xf.rot;
      } else {
        soft.colliders[at].a = xf.apply(Vec3(0., -part.half.y, 0.));
        soft.colliders[at].b = xf.apply(Vec3(0., part.half.y, 0.));
      }
    }
    k = k + 1usize;
  }
}
