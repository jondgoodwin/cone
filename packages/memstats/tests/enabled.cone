// A normal build has no memstats markers: enabled() is false unless -D MEMSTATS is given.

mod enabled;

import testing use *;
import memstats;

fn main() i32 {
  #if #defined("MEMSTATS") {
    expect(memstats.enabled(), "a MEMSTATS build says so");
  } #else {
    expect(!memstats.enabled(), "a normal build has no memstats markers");
  }
  done()
}
