// ======== Impact decals ========
//
// A scorch, a bullet mark, a splash of soot: a DecalLayer lays one of render's box-projected
// decals (Persson 2008; render's ImageFx draws them after the scene, shaded by the sun and
// the environment) at an effect's origin, facing along its axis, and fades it in and out
// over time. The decal's texture is made by 'scorchImage' from a few numbers: an irregular
// soot disc with a ragged edge from fBm, darkest at the middle, with streaks thrown outward.

pub struct DecalLayer {
  pub material u32;                 // ImageFx.addDecalMaterial's answer
  pub tint Color;
  pub offset Vec3;                  // from the effect's origin, in its own frame
  pub size f32 = 2.5;               // the box's width and depth, metres
  pub depth f32 = 1.5;              // and how far it reaches along the axis, metres (what it projects over)
  pub delay f32 = 0.;
  pub fadeIn f32 = 0.05;
  pub hold f32 = 20.;
  pub fadeOut f32 = 6.;
  pub order i32 = 0i32;
  pub roll f32 = 0.;                // radians; the player adds a random one from the seed

  pub fn make(material u32) DecalLayer {
    new DecalLayer(material: material, tint: new Color(1., 1., 1., 1.), offset: new Vec3(0., 0., 0.));
  }
}

// A soot mark 'size' pixels square (RGBA, the bottom row first as Image keeps it): a disc whose
// edge is torn by fBm of 'ragged' (0 a clean disc, 1 a very torn one), streaks of 'streaks'
// (0 to 1) thrown outward, its alpha strongest at the middle, its colour 'soot'
pub fn scorchImage(size i32, seed u32, ragged f32, streaks f32, soot Color) Image {
  mut img = new Image(size, size, 4, List[u8].withCapacity(usize.from(size * size * 4)));
  imm half = f32.from(size) * 0.5;
  mut y = 0;
  while y < size {
    mut x = 0;
    while x < size {
      imm dx = (f32.from(x) + 0.5 - half) / half;
      imm dy = (f32.from(y) + 0.5 - half) / half;
      imm r = (dx * dx + dy * dy).sqrt();
      imm angle = libc.atan2f(dy, dx);
      imm n = fbm2(new Vec2(dx * 3.2 + 7., dy * 3.2 - 3.), seed, 4, 2., 0.5).value;
      imm ray = value2(new Vec2(angle * 6.5 + 20., r * 0.8), seed + 9u32).value;
      imm edge = 1. - r + n * ragged * 0.55 + ray * streaks * 0.35 * r;
      imm raw = edge * 2.4;
      imm a = if raw < 0. { 0.; } elif raw > 1. { 1.; } else { raw * raw * (3. - 2. * raw); };
      imm grain = 0.85 + 0.15 * (n + 1.) * 0.5;
      img.pixels.push(u8.from(soot.red * grain * 255.));
      img.pixels.push(u8.from(soot.green * grain * 255.));
      img.pixels.push(u8.from(soot.blue * grain * 255.));
      img.pixels.push(u8.from(a * 255.));
      x = x + 1;
    }
    y = y + 1;
  }
  img;
}
