// ======== Flipbook explosions: baked on the GPU from a description, played as billboards ========
//
// A FlipbookDesc is a volumetric explosion as data: how big the fireball grows, how fast, how
// turbulent and hot, when it turns to soot, the smoke's colour and the direction it is lit from.
// 'addFlipbook' bakes it (flipbook.slang's bakeFragment: a ray-marched fBm volume, one full
// screen pass over a square atlas of grid x grid frames) once, at start-up, and 'play' puts a
// billboard in the world that runs through the frames. The method and why are in the shader's
// head and in Design\effectsfx.md.

const BOARD_BYTES = 48u64;         // three float4s
const MAX_BOARDS = 256usize;
const BAKE_BYTES = 80u64;          // five float4s
const BOARD_FRAME_BYTES = 48u64;

// An explosion's description: everything that makes one look different from another
pub struct FlipbookDesc {
  pub lightDir Vec3;                // the direction to the baked light (a lit side and a dark one)
  pub smokeColor Color;             // the soot's albedo
  pub grid u32 = 8u32;              // frames along a side (grid x grid in all)
  pub cell u32 = 128u32;            // pixels along a frame's side
  pub seed u32 = 1u32;
  pub startRadius f32 = 0.12;       // the fireball's radius at the first frame, in units of the billboard's half width
  pub endRadius f32 = 0.62;         // and the radius it grows towards
  pub growth f32 = 5.;              // how fast (1 - e^(-growth t))
  pub rise f32 = 0.3;               // how far its centre rises over the whole, in the same units
  pub turbulence f32 = 0.45;        // how much noise bends its edge (it grows with time)
  pub cooling f32 = 3.2;            // how fast the heat goes (e^(-cooling t))
  pub brightness f32 = 14.;         // the fire's HDR brightness
  pub sootStart f32 = 0.12;         // when (a fraction of the whole) the gas starts to darken
  pub smokeOpacity f32 = 1.;        // the gas's thickness
  pub ambient f32 = 0.35;           // the smoke's lit floor on its dark side

  pub fn make() FlipbookDesc {
    new FlipbookDesc(lightDir: new Vec3(-0.5, 0.7, 0.5), smokeColor: new Color(0.16, 0.145, 0.13, 1.));
  }
}

struct Atlas {
  desc FlipbookDesc;
  texture Texture;
  params Buffer;
  group BindGroup;
}

// One billboard playing one flipbook
pub struct Billboard {
  pub atlas u32;
  pub center Vec3;
  pub size f32;                     // metres: half the width of the quad
  pub start f32;                    // seconds, the clock 'draw' is given
  pub duration f32;
  pub roll f32;                     // radians
  pub tint Color;                   // multiplies the colour; its alpha is the opacity
}

pub struct FlipbookSystem {
  pub shader ShaderModule;
  pub layout BindGroupLayout;
  pub pipelineLayout PipelineLayout;
  pub bakePipeline RenderPipeline;
  pub drawPipeline RenderPipeline;
  pub sampler Sampler;
  pub frameBuffer Buffer;
  pub boardBuffer Buffer;
  tinyFx Buffer;
  tinyBoards Buffer;
  tinyParams Buffer;
  tinyAtlas Texture;
  tinyDepth Texture;
  atlases List[Atlas];
  pub boards List[Billboard];
  boundW u32;
  boundH u32;
  pub softness f32 = 0.5;           // metres over which an explosion fades into a surface
  pub drawn u32 = 0u32;             // billboards drawn last frame

  pub fn create(device &mut Device, colorFormat u32) FlipbookSystem {
    mut shader = device.createShaderModule(&FLIPBOOK_SPIRV);
    imm both = SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT;
    imm entries = [
      new BindGroupLayoutEntry(binding: 0u32, visibility: both),
      new BindGroupLayoutEntry(binding: 1u32, visibility: both),
      new BindGroupLayoutEntry(binding: 2u32, visibility: both),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER),
      new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 6u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH)];
    mut layout = device.createBindGroupLayout(&entries);
    imm layouts = [&layout];
    mut pipelineLayout = device.createPipelineLayout(&layouts, 0u32);
    imm noBuffers = List[VertexBufferLayout].empty();
    imm bakeDesc = new RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader,
      vertexEntryPoint: "fullscreenVertex", buffers: noBuffers.view(), fragmentModule: &shader,
      fragmentEntryPoint: "bakeFragment", colorFormat: TEXTURE_FORMAT_RGBA16_FLOAT);
    mut bakePipeline = device.createRenderPipeline(&bakeDesc);
    imm drawDesc = new RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader,
      vertexEntryPoint: "drawVertex", buffers: noBuffers.view(), fragmentModule: &shader,
      fragmentEntryPoint: "drawFragment", colorFormat: colorFormat, blendEnabled: true,
      colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut drawPipeline = device.createRenderPipeline(&drawDesc);
    imm samplerDesc = new SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    mut sampler = device.createSampler(&samplerDesc);
    mut frameBuffer = device.createBuffer(BOARD_FRAME_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    mut boardBuffer = device.createBuffer(u64.from(MAX_BOARDS) * BOARD_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    device.queue.clearBuffer(&boardBuffer, 0u64, u64.from(MAX_BOARDS) * BOARD_BYTES);
    mut tinyFx = device.createBuffer(336u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    mut tinyBoards = device.createBuffer(BOARD_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    mut tinyParams = device.createBuffer(BAKE_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    imm atlasDesc = new TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST);
    mut tinyAtlas = device.createTexture(&atlasDesc);
    imm depthDesc = new TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_DEPTH32_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    mut tinyDepth = device.createTexture(&depthDesc);
    new FlipbookSystem(shader, layout, pipelineLayout, bakePipeline, drawPipeline, sampler, frameBuffer, boardBuffer,
      tinyFx, tinyBoards, tinyParams, tinyAtlas, tinyDepth, List[Atlas].empty(), List[Billboard].empty(), 0u32, 0u32);
  }

  pub fn isValid(self &) bool {
    bakePipeline.isValid() and drawPipeline.isValid() and sampler.isValid() and frameBuffer.isValid() and boardBuffer.isValid();
  }

  fn groupFor(self &, device &mut Device, fx &Buffer, depth &TextureView, atlasView &TextureView, params &Buffer,
      boards &Buffer, frame &Buffer) BindGroup {
    imm e = [BindGroupEntry.buffer(0u32, fx), BindGroupEntry.buffer(1u32, frame), BindGroupEntry.buffer(2u32, params),
      BindGroupEntry.texture(3u32, atlasView), BindGroupEntry.sampler(4u32, &sampler), BindGroupEntry.buffer(5u32, boards),
      BindGroupEntry.texture(6u32, depth)];
    device.createBindGroup(&layout, &e);
  }

  // Bake 'desc' into an atlas, now (a submission of its own, waited for: a start-up cost). Its
  // number is what 'play' takes.
  pub fn addFlipbook(self &mut, device &mut Device, desc &FlipbookDesc) u32 {
    imm side = desc.grid * desc.cell;
    imm texDesc = new TextureDescriptor(side, side, TEXTURE_FORMAT_RGBA16_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    mut texture = device.createTexture(&texDesc);
    mut params = device.createBuffer(BAKE_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    mut w = List[u32].withCapacity(20usize);
    pushVec4Bits(&mut w, f32.from(desc.grid), f32.from(desc.cell), 0., desc.seed);
    pushVec4(&mut w, desc.startRadius, desc.endRadius, desc.growth, desc.rise);
    pushVec4(&mut w, desc.turbulence, desc.cooling, desc.brightness, desc.sootStart);
    pushVec4(&mut w, desc.smokeColor.red, desc.smokeColor.green, desc.smokeColor.blue, desc.smokeOpacity);
    imm l = desc.lightDir.normalize();
    pushVec4(&mut w, l.x, l.y, l.z, desc.ambient);
    imm wv = w.view();
    device.queue.writeBuffer(&params, 0u64, &wv[0] as *u8, BAKE_BYTES);
    // The bake: one full-screen pass over the whole atlas, the group made of stand-ins for what it does not read
    mut tinyDepthView = tinyDepth.createView();
    mut tinyAtlasView = tinyAtlas.createView();
    mut bakeGroup = self.groupFor(device, &tinyFx, &tinyDepthView, &tinyAtlasView, &params, &tinyBoards, &frameBuffer);
    mut encoder = device.createCommandEncoder();
    imm color = new RenderPassColorAttachment(view: texture.createView(), loadOp: LOAD_OP_CLEAR,
      clearValue: new Color(0., 0., 0., 0.));
    mut pass = encoder.beginRenderPass(&color);
    pass.setPipeline(&bakePipeline);
    pass.setBindGroup(0u32, &bakeGroup);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    device.queue.releaseBindGroup(&mut bakeGroup);
    mut group = self.groupFor(device, &tinyFx, &tinyDepthView, &tinyAtlasView, &params, &boardBuffer, &frameBuffer);
    atlases.push(new Atlas(*desc, texture, params, group));
    boundW = 0u32;
    u32.from(atlases.len() - 1usize);
  }

  pub fn atlasCount(self &) usize { atlases.len(); }

  // The bytes of the baked atlases, for the memory a flipbook costs
  pub fn atlasBytes(self &) u64 {
    mut total = 0u64;
    mut i = 0usize;
    while i < atlases.len() {
      imm side = u64.from(atlases[i].desc.grid * atlases[i].desc.cell);
      total = total + side * side * 8u64;
      i = i + 1usize;
    }
    total;
  }

  // A billboard of flipbook 'atlas' at 'center', 'size' metres to a half width, starting at
  // 'start' and lasting 'duration' seconds
  pub fn play(self &mut, atlas u32, center Vec3, size f32, start f32, duration f32, roll f32, tint Color) {
    if usize.from(atlas) >= atlases.len() { return; }
    if boards.len() >= MAX_BOARDS { return; }
    boards.push(new Billboard(atlas, center, size, start, duration, roll, tint));
  }

  // Drop the finished billboards
  pub fn retire(self &mut, now f32) {
    mut kept = List[Billboard].withCapacity(boards.len());
    mut i = 0usize;
    while i < boards.len() {
      if now <= boards[i].start + boards[i].duration { kept.push(*boards[i]); }
      i = i + 1usize;
    }
    boards = kept;
  }

  pub fn bindFrame(self &mut, device &mut Device, fx &ImageFx) {
    if boundW == fx.width and boundH == fx.height and boundW != 0u32 { return; }
    mut depthView = fx.depth.createView();
    mut i = 0usize;
    while i < atlases.len() {
      mut a = &mut atlases[i];
      device.queue.releaseBindGroup(&mut a.group);
      mut av = a.texture.createView();
      a.group = self.groupFor(device, &fx.frameBuffer, &depthView, &av, &a.params, &boardBuffer, &frameBuffer);
      i = i + 1usize;
    }
    boundW = fx.width;
    boundH = fx.height;
  }

  // Draw the playing billboards into 'target' (the HDR frame, kept), at clock 'now'
  pub fn render(self &mut, device &mut Device, encoder &mut CommandEncoder, fx &ImageFx, target &Texture,
      camera &Camera, now f32) {
    drawn = 0u32;
    self.retire(now);
    if boards.len() == 0usize { return; }
    self.bindFrame(device, fx);
    imm placement = camera.placement();
    mut f = new Array[u32, 12] <- fill 0u32;
    f[0] = now as u32;
    f[4] = placement.m[0] as u32; f[5] = placement.m[1] as u32; f[6] = placement.m[2] as u32; f[7] = softness as u32;
    f[8] = placement.m[4] as u32; f[9] = placement.m[5] as u32; f[10] = placement.m[6] as u32;
    device.queue.writeBuffer(&frameBuffer, 0u64, &f as *u8, BOARD_FRAME_BYTES);
    // Back to front within each atlas (farthest first), the atlases one after another
    imm eye = camera.position();
    mut words = List[u32].withCapacity(boards.len() * 12usize);
    mut counts = List[u32].empty();
    mut a = 0usize;
    while a < atlases.len() {
      mut order = List[usize].empty();
      mut i = 0usize;
      while i < boards.len() {
        if usize.from(boards[i].atlas) == a {
          imm d = (boards[i].center - eye).lengthSquared();
          mut at = order.len();
          order.push(i);
          while at > 0usize and (boards[*order[at - 1usize]].center - eye).lengthSquared() < d {
            order.set(at, *order[at - 1usize]);
            at = at - 1usize;
          }
          order.set(at, i);
        }
        i = i + 1usize;
      }
      mut k = 0usize;
      while k < order.len() {
        imm b = boards[*order[k]];
        pushVec4(&mut words, b.center.x, b.center.y, b.center.z, b.size);
        pushVec4(&mut words, b.start, b.duration, b.roll, f32.from(a));
        pushVec4(&mut words, b.tint.red, b.tint.green, b.tint.blue, b.tint.alpha);
        k = k + 1usize;
      }
      counts.push(u32.from(order.len()));
      a = a + 1usize;
    }
    imm wv = words.view();
    device.queue.writeBuffer(&boardBuffer, 0u64, &wv[0] as *u8, u64.from(words.len()) * 4u64);
    imm color = new RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_LOAD,
      clearValue: new Color(0., 0., 0., 0.));
    mut pass = encoder.beginRenderPass(&color);
    pass.setPipeline(&drawPipeline);
    mut first = 0u32;
    a = 0usize;
    while a < atlases.len() {
      imm n = *counts[a];
      if n > 0u32 {
        pass.setBindGroup(0u32, &atlases[a].group);
        pass.draw(6u32, n, 0u32, first);
        drawn = drawn + n;
      }
      first = first + n;
      a = a + 1usize;
    }
    pass.end();
  }
}

