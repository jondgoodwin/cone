// ======== GPU particles: the pool, its simulation and its drawing ========
//
// The pool is a ring of 'capacity' particles in one storage buffer (particlecommon.slang
// says what a slot holds). Each frame the program lists what to spawn ('spawn': a class, a
// place, an axis, a count) and 'simulate' records one compute pass: every slot either takes
// a new particle or moves the one it has, colliding it with the depth buffer the scene just
// left in ImageFx. 'render' adds the pool into the HDR frame. A class (ParticleClass) is
// the description of a kind of particle as data; the table of classes is a storage buffer
// the shaders read.

pub const PARTICLE_SPARK = 0u32;   // additive streak, stretched along its motion
pub const PARTICLE_SMOKE = 1u32;   // soft lit puff, drawn over what is behind it

pub const EMIT_POINT = 0u32;
pub const EMIT_DISC = 1u32;        // a disc about the launch axis
pub const EMIT_SPHERE = 2u32;      // within a ball

const POOL_BYTES_EACH = 48u64;     // three float4s
const CLASS_BYTES = 192u64;        // twelve float4s
const MAX_CLASSES = 48usize;
const BATCH_BYTES = 64u64;         // four float4s
const MAX_BATCHES = 96usize;
const SIM_FRAME_BYTES = 96u64;

// What a kind of particle is: how it is born, what pushes it, what it does when it meets the
// scene, and how it looks over its life. Numbers are general; an effect's own are in the effect.
pub struct ParticleClass {
  pub gravity Vec3;                 // m/s^2 (the world's; a negative y falls)
  pub colors Array[Color, 4];       // linear HDR; a spark's alpha is its intensity, a smoke's its opacity
  pub colorAt Array[f32, 4];        // each key's place in life (0 to 1, rising)
  pub style u32 = PARTICLE_SPARK;
  pub shape u32 = EMIT_POINT;
  pub radius f32 = 0.;              // of the disc or ball it is born in
  pub spread f32 = 0.;              // half angle of the launch cone about the axis, radians
  pub speed f32 = 1.;               // launch speed, m/s
  pub speedJitter f32 = 0.;         // each within this fraction
  pub life f32 = 1.;                // seconds
  pub lifeJitter f32 = 0.;
  pub drag f32 = 0.;                // linear, per second
  pub turbulence f32 = 0.;          // curl-noise acceleration, m/s^2
  pub turbulenceScale f32 = 1.;     // 1 / metres: the eddies' size
  pub turbulenceSpeed f32 = 0.5;    // metres a second the field drifts upward
  pub sizeStart f32 = 0.1;          // metres, at birth
  pub sizeEnd f32 = 0.1;            // at death
  pub sizeJitter f32 = 0.;
  pub stretch f32 = 0.;             // a spark spans this many seconds of motion
  pub fadeIn f32 = 0.;              // fractions of life
  pub fadeOut f32 = 0.4;
  pub collide bool = false;         // collides with the depth buffer and the ground plane
  pub restitution f32 = 0.4;        // the share of the normal speed kept at a bounce
  pub friction f32 = 0.2;           // the share of the tangent speed lost at a bounce
  pub bounceLifeLoss f32 = 0.;      // the fraction of life each bounce takes
  pub inherit f32 = 0.;             // the share of the emitter's velocity a particle starts with
  pub wind f32 = 0.;                // how much the wind pushes it

  // A short white spark falling under gravity, not colliding
  pub fn make() ParticleClass {
    imm white = new Color(1., 1., 1., 1.);
    new ParticleClass(gravity: new Vec3(0., -9.81, 0.), colors: [white, white, white, white], colorAt: [0., 0.33, 0.66, 1.]);
  }
}

// One spawn order of the frame
struct Spawn {
  cls u32;
  origin Vec3;
  axis Vec3;
  inherit Vec3;
  count u32;
  seed u32;
}

pub struct ParticleSystem {
  pub simShader ShaderModule;
  pub drawShader ShaderModule;
  pub computeLayout BindGroupLayout;
  pub drawLayout BindGroupLayout;
  pub computePipelineLayout PipelineLayout;
  pub drawPipelineLayout PipelineLayout;
  pub simPipeline ComputePipeline;
  pub sparkPipeline RenderPipeline;
  pub smokePipeline RenderPipeline;
  pub pool Buffer;
  pub classBuffer Buffer;
  pub batchBuffer Buffer;
  pub simFrame Buffer;
  tinyFrame Buffer;                // stand-ins the groups are first made with, until a frame's own exist
  tinyDepth Texture;
  pub computeGroup BindGroup;
  pub drawGroup BindGroup;
  pub capacity u32;
  classes List[ParticleClass];
  pending List[Spawn];
  head u32;                        // the next slot to give out
  boundW u32;
  boundH u32;
  classesDirty bool;
  // The scene's ground, for collisions the depth buffer cannot see: a plane (unit normal, offset)
  pub groundOn bool = false;
  pub groundNormal Vec3;
  pub groundOffset f32 = 0.;
  pub depthCollision bool = true;
  pub wind Vec3;
  pub softness f32 = 0.35;         // metres over which smoke fades into a surface
  pub spawned u32 = 0u32;          // particles spawned last frame
  pub dropped u32 = 0u32;          // spawn orders dropped for want of room in the frame's list
  pub frame u32 = 0u32;
  longestLife f32 = 0.;            // the longest any registered class lives
  quietAfter f32 = -1.;            // after this clock time nothing can be alive until the next order
  pub idle bool = true;            // the last frame did no work: no particle could be alive
  pub used u32 = 0u32;             // slots the ring has reached so far: only these are simulated and drawn

  // A pool of 'capacity' particles drawing into a frame of 'colorFormat'
  pub fn create(device &mut Device, colorFormat u32, capacity u32) ParticleSystem {
    mut simShader = device.createShaderModule(&PARTICLESIM_SPIRV);
    mut drawShader = device.createShaderModule(&PARTICLEDRAW_SPIRV);
    imm computeEntries = [
      new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_COMPUTE),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_COMPUTE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH)];
    mut computeLayout = device.createBindGroupLayout(&computeEntries);
    imm both = SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT;
    imm drawEntries = [
      new BindGroupLayoutEntry(binding: 0u32, visibility: both),
      new BindGroupLayoutEntry(binding: 1u32, visibility: both),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_DEPTH)];
    mut drawLayout = device.createBindGroupLayout(&drawEntries);
    imm computeLayouts = [&computeLayout];
    mut computePipelineLayout = device.createPipelineLayout(&computeLayouts, 0u32);
    imm drawLayouts = [&drawLayout];
    mut drawPipelineLayout = device.createPipelineLayout(&drawLayouts, 16u32);
    imm simDesc = new ComputePipelineDescriptor(layout: &computePipelineLayout, module: &simShader, entryPoint: "simMain");
    mut simPipeline = device.createComputePipeline(&simDesc);
    imm noBuffers = List[VertexBufferLayout].empty();
    imm sparkDesc = new RenderPipelineDescriptor(layout: &drawPipelineLayout, vertexModule: &drawShader,
      vertexEntryPoint: "sparkVertex", buffers: noBuffers.view(), fragmentModule: &drawShader,
      fragmentEntryPoint: "sparkFragment", colorFormat: colorFormat, blendEnabled: true,
      colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE,
      alphaSrcFactor: BLEND_FACTOR_ZERO, alphaDstFactor: BLEND_FACTOR_ONE);
    mut sparkPipeline = device.createRenderPipeline(&sparkDesc);
    imm smokeDesc = new RenderPipelineDescriptor(layout: &drawPipelineLayout, vertexModule: &drawShader,
      vertexEntryPoint: "smokeVertex", buffers: noBuffers.view(), fragmentModule: &drawShader,
      fragmentEntryPoint: "smokeFragment", colorFormat: colorFormat, blendEnabled: true,
      colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut smokePipeline = device.createRenderPipeline(&smokeDesc);
    mut pool = device.createBuffer(u64.from(capacity) * POOL_BYTES_EACH,
      BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    device.queue.clearBuffer(&pool, 0u64, u64.from(capacity) * POOL_BYTES_EACH);
    mut classBuffer = device.createBuffer(u64.from(MAX_CLASSES) * CLASS_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    device.queue.clearBuffer(&classBuffer, 0u64, u64.from(MAX_CLASSES) * CLASS_BYTES);
    mut batchBuffer = device.createBuffer(u64.from(MAX_BATCHES) * BATCH_BYTES, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    device.queue.clearBuffer(&batchBuffer, 0u64, u64.from(MAX_BATCHES) * BATCH_BYTES);
    mut simFrame = device.createBuffer(SIM_FRAME_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    mut tinyFrame = device.createBuffer(336u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    imm tinyDesc = new TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_DEPTH32_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    mut tinyDepth = device.createTexture(&tinyDesc);
    mut depthView = tinyDepth.createView();
    imm ce = [BindGroupEntry.buffer(0u32, &tinyFrame), BindGroupEntry.buffer(1u32, &simFrame),
      BindGroupEntry.buffer(2u32, &classBuffer), BindGroupEntry.buffer(3u32, &batchBuffer),
      BindGroupEntry.buffer(4u32, &pool), BindGroupEntry.texture(5u32, &depthView)];
    mut computeGroup = device.createBindGroup(&computeLayout, &ce);
    imm de = [BindGroupEntry.buffer(0u32, &tinyFrame), BindGroupEntry.buffer(1u32, &simFrame),
      BindGroupEntry.buffer(2u32, &classBuffer), BindGroupEntry.buffer(4u32, &pool), BindGroupEntry.texture(5u32, &depthView)];
    mut drawGroup = device.createBindGroup(&drawLayout, &de);
    new ParticleSystem(simShader, drawShader, computeLayout, drawLayout, computePipelineLayout, drawPipelineLayout,
      simPipeline, sparkPipeline, smokePipeline, pool, classBuffer, batchBuffer, simFrame, tinyFrame, tinyDepth,
      computeGroup, drawGroup, capacity, List[ParticleClass].empty(), List[Spawn].empty(), 0u32, 0u32, 0u32, false,
      groundNormal: new Vec3(0., 1., 0.), wind: new Vec3(0., 0., 0.));
  }

  // Make the bind groups again at the next frame: call it after ImageFx's 'configure' (which may make its depth again)
  pub fn rebind(self &mut) { boundW = 0u32; }

  pub fn isValid(self &) bool {
    simPipeline.isValid() and sparkPipeline.isValid() and smokePipeline.isValid() and pool.isValid()
      and classBuffer.isValid() and batchBuffer.isValid() and simFrame.isValid();
  }

  // Register a class; its number is what 'spawn' takes. At most 48.
  pub fn addClass(self &mut, c &ParticleClass) u32 {
    if classes.len() >= MAX_CLASSES { return 0u32; }
    classes.push(*c);
    imm longest = c.life * (1. + c.lifeJitter);
    if longest > longestLife { longestLife = longest; }
    classesDirty = true;
    u32.from(classes.len() - 1usize);
  }

  pub fn classCount(self &) usize { classes.len(); }

  // Order 'count' particles of class 'cls' born at 'origin', launched about the unit 'axis',
  // carrying 'inherit' (the emitter's velocity, scaled by the class), all drawn from 'seed'.
  // Orders are carried out by the next 'simulate'.
  pub fn emit(self &mut, cls u32, origin Vec3, axis Vec3, inherit Vec3, count u32, seed u32) {
    if count == 0u32 { return; }
    if pending.len() >= MAX_BATCHES {
      dropped = dropped + 1u32;
      return;
    }
    pending.push(new Spawn(cls, origin, axis, inherit, count, seed));
  }

  fn writeClasses(self &mut, device &mut Device) {
    mut w = List[u32].withCapacity(classes.len() * 48usize);
    mut i = 0usize;
    while i < classes.len() {
      imm c = classes[i];
      pushVec4(&mut w, f32.from(c.shape), c.radius, c.spread, c.speed);
      pushVec4(&mut w, c.speedJitter, c.life, c.lifeJitter, c.drag);
      pushVec4(&mut w, c.gravity.x, c.gravity.y, c.gravity.z, c.turbulence);
      pushVec4(&mut w, c.turbulenceScale, c.turbulenceSpeed, c.sizeStart, c.sizeEnd);
      pushVec4(&mut w, c.stretch, c.fadeIn, c.fadeOut, f32.from(c.style));
      pushVec4(&mut w, c.restitution, c.friction, c.bounceLifeLoss, if c.collide { 1.; } else { 0.; });
      mut k = 0usize;
      while k < 4usize {
        pushVec4(&mut w, c.colors[k].red, c.colors[k].green, c.colors[k].blue, c.colors[k].alpha);
        k = k + 1usize;
      }
      pushVec4(&mut w, c.colorAt[0usize], c.colorAt[1usize], c.colorAt[2usize], c.colorAt[3usize]);
      pushVec4(&mut w, c.sizeJitter, 0., c.inherit, c.wind);
      i = i + 1usize;
    }
    if w.len() > 0usize {
      imm v = w.view();
      device.queue.writeBuffer(&classBuffer, 0u64, &v[0] as *u8, u64.from(w.len()) * 4u64);
    }
    classesDirty = false;
  }

  // Make (or remake) the bind groups for ImageFx's frame uniform and depth: when the frame's
  // size changes the depth texture does
  pub fn bindFrame(self &mut, device &mut Device, fx &ImageFx) {
    if boundW == fx.width and boundH == fx.height and boundW != 0u32 { return; }
    device.queue.releaseBindGroup(&mut computeGroup);
    device.queue.releaseBindGroup(&mut drawGroup);
    mut depthView = fx.depth.createView();
    imm ce = [BindGroupEntry.buffer(0u32, &fx.frameBuffer), BindGroupEntry.buffer(1u32, &simFrame),
      BindGroupEntry.buffer(2u32, &classBuffer), BindGroupEntry.buffer(3u32, &batchBuffer),
      BindGroupEntry.buffer(4u32, &pool), BindGroupEntry.texture(5u32, &depthView)];
    computeGroup = device.createBindGroup(&computeLayout, &ce);
    imm de = [BindGroupEntry.buffer(0u32, &fx.frameBuffer), BindGroupEntry.buffer(1u32, &simFrame),
      BindGroupEntry.buffer(2u32, &classBuffer), BindGroupEntry.buffer(4u32, &pool), BindGroupEntry.texture(5u32, &depthView)];
    drawGroup = device.createBindGroup(&drawLayout, &de);
    boundW = fx.width;
    boundH = fx.height;
  }

  // Carry out the frame's spawn orders and move every particle by 'dt' seconds. 'fx' must have
  // drawn the scene this frame ('renderScene'): its depth is what particles collide with.
  pub fn simulate(self &mut, device &mut Device, encoder &mut CommandEncoder, fx &ImageFx, camera &Camera,
      now f32, dt f32) {
    // Nothing ordered and nothing left alive: no pass at all
    if pending.len() > 0usize { quietAfter = now + longestLife + dt; }
    idle = now > quietAfter;
    if idle { return; }
    self.bindFrame(device, fx);
    if classesDirty { self.writeClasses(device); }
    // The batches: each a run of consecutive new slots after the last frame's
    mut bw = List[u32].withCapacity(pending.len() * 16usize);
    mut total = 0u32;
    mut i = 0usize;
    while i < pending.len() {
      imm sp = pending[i];
      mut count = sp.count;
      if total + count > capacity { count = capacity - total; }
      pushVec4Bits(&mut bw, sp.origin.x, sp.origin.y, sp.origin.z, sp.cls);
      pushVec4Bits(&mut bw, sp.axis.x, sp.axis.y, sp.axis.z, sp.seed);
      pushVec4(&mut bw, sp.inherit.x, sp.inherit.y, sp.inherit.z, 0.);
      bw.push(count);
      bw.push(total);
      bw.push(0u32);
      bw.push(0u32);
      total = total + count;
      i = i + 1usize;
    }
    imm batchCount = u32.from(pending.len());
    if bw.len() > 0usize {
      imm v = bw.view();
      device.queue.writeBuffer(&batchBuffer, 0u64, &v[0] as *u8, u64.from(bw.len()) * 4u64);
    }
    pending.clear();
    spawned = total;
    // The frame
    imm placement = camera.placement();
    mut f = new Array[u32, 24] <- fill 0u32;
    f[0] = now as u32;
    f[1] = dt as u32;
    f[2] = head;
    f[3] = total;
    f[4] = capacity;
    f[5] = batchCount;
    f[6] = (if depthCollision { 1u32; } else { 0u32; }) | (if groundOn { 2u32; } else { 0u32; });
    f[7] = frame;
    f[8] = groundNormal.x as u32; f[9] = groundNormal.y as u32; f[10] = groundNormal.z as u32; f[11] = groundOffset as u32;
    f[12] = wind.x as u32; f[13] = wind.y as u32; f[14] = wind.z as u32;
    f[16] = placement.m[0] as u32; f[17] = placement.m[1] as u32; f[18] = placement.m[2] as u32; f[19] = softness as u32;
    f[20] = placement.m[4] as u32; f[21] = placement.m[5] as u32; f[22] = placement.m[6] as u32;
    device.queue.writeBuffer(&simFrame, 0u64, &f as *u8, SIM_FRAME_BYTES);
    imm reach = head + total;
    if reach >= capacity { used = capacity; } elif reach > used { used = reach; }
    head = (head + total) % capacity;
    frame = frame + 1u32;
    mut pass = encoder.beginComputePass();
    pass.setPipeline(&simPipeline);
    pass.setBindGroup(0u32, &computeGroup);
    pass.dispatchWorkgroups((used + 63u32) / 64u32, 1u32, 1u32);
    pass.end();
  }

  // Add the pool into 'target' (the HDR frame the scene is in, its contents kept), over what is
  // there: the particles of one style, PARTICLE_SPARK as light or PARTICLE_SMOKE as soft puffs.
  // Two calls (smoke, then sparks) let other layers (the flipbooks) go between them.
  // 'scale' is how many times the scene's depth is larger than 'target' (1, or 2 for a half-resolution layer).
  pub fn render(self &mut, encoder &mut CommandEncoder, target &Texture, style u32, scale f32) {
    if idle or !drawGroup.isValid() { return; }
    imm color = new RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_LOAD,
      clearValue: new Color(0., 0., 0., 0.));
    mut pass = encoder.beginRenderPass(&color);
    if style == PARTICLE_SMOKE { pass.setPipeline(&smokePipeline); } else { pass.setPipeline(&sparkPipeline); }
    mut sc = new Array[f32, 4] <- fill 0f;
    sc[0] = scale;
    pass.setImmediates(0u32, &sc as *u8, 16u32);
    pass.setBindGroup(0u32, &drawGroup);
    pass.draw(6u32, used, 0u32, 0u32);
    pass.end();
  }
}

// Four floats appended as their bits
fn pushVec4(w &mut List[u32], a f32, b f32, c f32, d f32) {
  w.push(a as u32);
  w.push(b as u32);
  w.push(c as u32);
  w.push(d as u32);
}

// Three floats and a word, as bits
fn pushVec4Bits(w &mut List[u32], a f32, b f32, c f32, d u32) {
  w.push(a as u32);
  w.push(b as u32);
  w.push(c as u32);
  w.push(d);
}

