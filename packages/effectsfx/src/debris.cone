// ======== Mesh debris ========
//
// Chunks of any mesh, thrown by an effect: each piece a rigid body in free flight (gravity, a
// little air drag, a tumble about its own axis), bouncing off the ground plane and coming to
// rest, and drawn as an ordinary item of render's draw list, so it is lit, shadowed and
// reflected like anything else. A DebrisLayer names the mesh and material (handles into the
// renderer) and the numbers of the throw; nothing here is a particular chunk.
//
// The method is the plain one: semi-implicit Euler with a restitution and friction at the
// ground, a piece resting once its bounce speed is under a threshold. It meets only the
// ground plane (and, if given, the camera's depth does not matter: nothing here reads it);
// a piece thrown at a wall passes through it. Real bodies would come from rigiddynamics;
// debris are cosmetic and cheap (a few dozen, no mutual collision).

pub struct DebrisLayer {
  pub mesh MeshHandle;
  pub material MaterialHandle;
  pub offset Vec3;                  // from the effect's origin, in its own frame
  pub delay f32 = 0.;
  pub count u32 = 12u32;
  pub speed f32 = 7.;               // launch speed, m/s
  pub speedJitter f32 = 0.5;
  pub spread f32 = 1.0;             // half angle of the launch cone about the axis, radians
  pub size f32 = 0.12;              // the piece's scale
  pub sizeJitter f32 = 0.5;
  pub spin f32 = 9.;                // tumble rate, radians a second
  pub restitution f32 = 0.35;
  pub friction f32 = 0.4;
  pub drag f32 = 0.15;
  pub life f32 = 9.;                // seconds before it shrinks away
}

struct Piece {
  mesh MeshHandle;
  material MaterialHandle;
  position Vec3;
  velocity Vec3;
  rotation Quat;
  axis Vec3;
  spin f32;
  size f32;
  born f32;
  life f32;
  restitution f32;
  friction f32;
  drag f32;
  resting bool;
}

pub struct DebrisSet {
  pieces List[Piece];
  pub groundY f32 = 0.;
  pub gravity f32 = 9.81;
  pub capacity usize = 256usize;
  pub live u32 = 0u32;

  pub fn create() DebrisSet { new DebrisSet(List[Piece].empty()); }

  // Throw the layer's pieces from 'origin' about 'axis' (unit), the effect's frame being
  // (side, axis, across), all drawn from 'seed'
  pub fn throwFrom(self &mut, layer &DebrisLayer, origin Vec3, axis Vec3, side Vec3, across Vec3, now f32, seed u32) {
    var k = 0u32;
    while k < layer.count and pieces.len() < capacity {
      let h = pcg4d(new UVec4(k, seed, 41u32, 3u32));
      let g = pcg4d(new UVec4(k, seed, 43u32, 5u32));
      let cosT = 1. - toUnit(h.w) * (1. - cos(layer.spread));
      let sinT = (1. - cosT * cosT).sqrt();
      let phi = 2. * pi * toUnit(h.x);
      let dir = axis * cosT + (side * cos(phi) + across * sin(phi)) * sinT;
      let speed = layer.speed * (1. + layer.speedJitter * toSigned(h.y));
      let size = layer.size * (1. + layer.sizeJitter * toSigned(h.z));
      let tumble = new Vec3(toSigned(g.x), toSigned(g.y), toSigned(g.z)).normalize();
      let start = origin + side * 0. + dir * 0.05;
      pieces.push(new Piece(layer.mesh, layer.material, start, dir * speed, Quat.angleAxis(2. * pi * toUnit(g.w), tumble),
        tumble, layer.spin * (0.4 + 0.6 * toUnit(h.z)), size, now, layer.life, layer.restitution, layer.friction, layer.drag, false));
      k = k + 1u32;
    }
  }

  pub fn update(self &mut, now f32, dt f32) {
    var i = 0usize;
    while i < pieces.len() {
      if now - pieces[i].born >= pieces[i].life {
        pieces.swap(i, pieces.len() - 1usize);
        let gone = pieces.pop();
      } else {
        var p = &mut pieces[i];
        if !p.resting {
          p.velocity = new Vec3(p.velocity.x, p.velocity.y - gravity * dt, p.velocity.z) * (1. - p.drag * dt);
          p.position = p.position + p.velocity * dt;
          p.rotation = (Quat.angleAxis(p.spin * dt, p.axis) * p.rotation).normalize();
          let floor = groundY + p.size * 0.5;
          if p.position.y < floor {
            p.position = new Vec3(p.position.x, floor, p.position.z);
            if p.velocity.y < 0. {
              let vy = -p.velocity.y * p.restitution;
              p.velocity = new Vec3(p.velocity.x * (1. - p.friction), vy, p.velocity.z * (1. - p.friction));
              p.spin = p.spin * 0.6;
              if vy < 0.7 {
                p.velocity = new Vec3(p.velocity.x * 0.5, 0., p.velocity.z * 0.5);
                if p.velocity.length() < 0.25 { p.resting = true; }
              }
            }
          }
        }
        i = i + 1usize;
      }
    }
    live = u32.from(pieces.len());
  }

  // The height of the lowest point of the lowest piece's bounding cube above the ground plane (99 if none)
  pub fn lowest(self &) f32 {
    var low = 99.;
    var i = 0usize;
    while i < pieces.len() {
      let h = pieces[i].position.y - pieces[i].size * 0.5 - groundY;
      if h < low { low = h; }
      i = i + 1usize;
    }
    low;
  }

  // Add every piece to the frame's draw list; one in its last half second shrinks away
  pub fn draw(self &, list &mut DrawList, now f32) {
    var i = 0usize;
    while i < pieces.len() {
      let p = pieces[i];
      let left = p.life - (now - p.born);
      let k = if left < 0.5 { left * 2.; } else { 1.; };
      let s = p.size * k;
      list.add(p.mesh, p.material, Mat4.fromTrs(p.position, p.rotation, new Vec3(s, s, s)));
      i = i + 1usize;
    }
  }
}
