// ======== A half-resolution layer: draw what costs fragments at a quarter of them ========
//
// Smoke and flipbook explosions are large soft surfaces blended into a 16-byte-a-pixel target: their
// cost is the bandwidth of the pixels they cover, which on an integrated GPU (shared memory) is the
// frame. A LowResLayer is a texture of half the frame's size that they are drawn into instead (cleared,
// then drawn with the depth test done against the full-size depth: 'scale' 2) and then laid over the
// frame by one full-screen pass, bilinearly filtered and premultiplied: a quarter of the fragments.
// What it gives up is an edge finer than a half-resolution pixel: a thin object in front of a puff shows
// a fringe of it (nearest-depth upsampling would cure that and is not done).

pub struct LowResLayer {
  pub shader: ShaderModule;
  pub layout: BindGroupLayout;
  pub pipelineLayout: PipelineLayout;
  pub pipeline: RenderPipeline;
  pub sampler: Sampler;
  pub texture: Texture;
  group: BindGroup;
  pub width: u32 = 0u32;
  pub height: u32 = 0u32;
  colorFormat: u32 = 0u32;

  pub fn create(device: &mut Device, colorFormat: u32) LowResLayer {
    var shader = device.createShaderModule(&COMPOSITE_SPIRV);
    let entries = [
      new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    var layout = device.createBindGroupLayout(&entries);
    let layouts = [&layout];
    var pipelineLayout = device.createPipelineLayout(&layouts, 0u32);
    let noBuffers = List[VertexBufferLayout].empty();
    let desc = new RenderPipelineDescriptor(layout: &pipelineLayout, vertexModule: &shader,
      vertexEntryPoint: "fullscreenVertex", buffers: noBuffers.view(), fragmentModule: &shader,
      fragmentEntryPoint: "compositeFragment", colorFormat: colorFormat, blendEnabled: true,
      colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var pipeline = device.createRenderPipeline(&desc);
    let samplerDesc = new SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    var sampler = device.createSampler(&samplerDesc);
    let texDesc = new TextureDescriptor(1u32, 1u32, colorFormat, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    var texture = device.createTexture(&texDesc);
    var view = texture.createView();
    let e = [BindGroupEntry.texture(0u32, &view), BindGroupEntry.sampler(1u32, &sampler)];
    var group = device.createBindGroup(&layout, &e);
    new LowResLayer(shader, layout, pipelineLayout, pipeline, sampler, texture, group, colorFormat: colorFormat)
  }

  pub fn isValid(self: &) bool { pipeline.isValid() && sampler.isValid() && texture.isValid() }

  // A layer for a frame of 'frameWidth' x 'frameHeight': half of each (made again when the frame's size changes)
  pub fn ensure(self: &mut, device: &mut Device, frameWidth: u32, frameHeight: u32) {
    let w = (frameWidth + 1u32) / 2u32;
    let h = (frameHeight + 1u32) / 2u32;
    if w == width && h == height { return; }
    device.queue.releaseBindGroup(&mut group);
    device.queue.releaseTexture(&mut texture);
    let texDesc = new TextureDescriptor(w, h, colorFormat, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    texture = device.createTexture(&texDesc);
    var view = texture.createView();
    let e = [BindGroupEntry.texture(0u32, &view), BindGroupEntry.sampler(1u32, &sampler)];
    group = device.createBindGroup(&layout, &e);
    width = w;
    height = h;
  }

  // Clear the layer to nothing (transparent black)
  pub fn clear(self: &mut, encoder: &mut CommandEncoder) {
    let color = new RenderPassColorAttachment(view: texture.createView(), loadOp: LOAD_OP_CLEAR,
      clearValue: new Color(0., 0., 0., 0.));
    var pass = encoder.beginRenderPass(&color);
    pass.end();
  }

  // Lay the layer over 'target' (the frame it is half the size of, its contents kept)
  pub fn composite(self: &mut, encoder: &mut CommandEncoder, target: &Texture) {
    let color = new RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_LOAD,
      clearValue: new Color(0., 0., 0., 0.));
    var pass = encoder.beginRenderPass(&color);
    pass.setPipeline(&pipeline);
    pass.setBindGroup(0u32, &group);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
  }
}

