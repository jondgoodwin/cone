// ======== Small-grid smoke and fire: a stable-fluids solver on the GPU, drawn as a volume ========
//
// A FluidSmoke is a box of nx x ny x nz cells (40 x 64 x 40 by default: 100 thousand) over a fixed
// place in the world, simulated by seven compute kernels (fluid.slang) and drawn by a ray-marched
// volume pass (fluidvolume.slang). It is the one effect here that keeps state on the GPU that the
// scene can push on (a fire source that stays lit and a plume that eddies and drifts); the
// others are stateless (flipbooks) or one particle at a time. 'step' advances it by a frame,
// 'render' adds it into the HDR frame after the scene. The method and why are in the shaders' heads
// and in Design\effectsfx.md.

const FLUID_PARAMS_BYTES = 128u64;

// A fire and its smoke, as numbers
pub struct FluidDesc {
  pub origin Vec3;                  // the world position of the box's lowest corner
  pub source Vec3;                  // the fire's centre, in the world
  pub soot Color;                   // the smoke's albedo
  pub nx u32 = 36u32;               // cells across
  pub ny u32 = 72u32;               // cells up
  pub nz u32 = 36u32;
  pub cell f32 = 0.09;              // a cell's side, metres
  pub sourceRadius f32 = 0.42;      // the soft ball fuel and heat enter by, metres
  pub temperature f32 = 1.9;        // heat injected at its centre (0 is ambient, 1 white-hot)
  pub fuelRate f32 = 15.;           // fuel (gas density) injected a second at its centre
  pub cooling f32 = 1.2;            // the heat's decay a second as it is carried along
  pub dissipation f32 = 0.3;        // the gas's thinning a second
  pub buoyancy f32 = 5.;            // upward acceleration of gas that is hot (per unit of temperature), m/s^2
  pub weight f32 = 0.25;            // the downward pull of the soot (per unit of density)
  pub vorticity f32 = 5.;           // how much of the small eddies confinement puts back
  pub damping f32 = 0.1;            // the velocity's decay a second
  pub upSpeed f32 = 0.9;            // the speed the source gives the gas
  pub jacobi u32 = 24u32;           // pressure iterations a step
  pub brightness f32 = 14.;         // the fire's HDR brightness
  pub absorption f32 = 5.5;         // how dark the gas is, per unit of density and metre
  pub steps u32 = 56u32;            // ray-march steps across the box
  pub shadow f32 = 3.;              // how strongly the gas shades itself from the sun
  pub ambient f32 = 0.32;           // the share of its light the smoke has on its dark side
  pub seed u32 = 3u32;

  pub fn make(origin Vec3, source Vec3) FluidDesc {
    new FluidDesc(origin: origin, source: source, soot: new Color(0.2, 0.19, 0.18, 1.));
  }
}

pub struct FluidSmoke {
  pub solveShader ShaderModule;
  pub drawShader ShaderModule;
  pub solveLayout BindGroupLayout;
  pub drawLayout BindGroupLayout;
  pub solvePipelineLayout PipelineLayout;
  pub drawPipelineLayout PipelineLayout;
  pub forcesPipeline ComputePipeline;
  pub curlPipeline ComputePipeline;
  pub confinePipeline ComputePipeline;
  pub divergencePipeline ComputePipeline;
  pub jacobiPipeline ComputePipeline;
  pub projectPipeline ComputePipeline;
  pub advectPipeline ComputePipeline;
  pub volumePipeline RenderPipeline;
  pub params Buffer;
  pub vel0 Buffer;
  pub vel1 Buffer;
  pub gas0 Buffer;
  pub gas1 Buffer;
  pub press0 Buffer;
  pub press1 Buffer;
  pub aux Buffer;
  tinyFx Buffer;
  tinyDepth Texture;
  pub solveGroup BindGroup;
  pub drawGroup BindGroup;
  pub lowRes LowResLayer;
  pub desc FluidDesc;
  pub halfResolution bool = false;  // draw the volume at half the frame's size (a quarter of the fragments)
  pub parity u32 = 0u32;
  pub frame u32 = 0u32;
  boundW u32 = 0u32;
  boundH u32 = 0u32;
  pub cells u32 = 0u32;
  pub dispatches u32 = 0u32;        // compute dispatches in the last step

  pub fn create(device &mut Device, colorFormat u32, d &FluidDesc) FluidSmoke {
    mut solveShader = device.createShaderModule(&FLUID_SPIRV);
    mut drawShader = device.createShaderModule(&FLUIDVOLUME_SPIRV);
    imm c = SHADER_STAGE_COMPUTE;
    imm solveEntries = [
      new BindGroupLayoutEntry(binding: 0u32, visibility: c),
      new BindGroupLayoutEntry(binding: 1u32, visibility: c, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: c, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      new BindGroupLayoutEntry(binding: 3u32, visibility: c, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: c, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      new BindGroupLayoutEntry(binding: 5u32, visibility: c, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      new BindGroupLayoutEntry(binding: 6u32, visibility: c, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      new BindGroupLayoutEntry(binding: 7u32, visibility: c, bufferType: BUFFER_BINDING_TYPE_STORAGE)];
    mut solveLayout = device.createBindGroupLayout(&solveEntries);
    imm f = SHADER_STAGE_FRAGMENT;
    imm drawEntries = [
      new BindGroupLayoutEntry(binding: 0u32, visibility: f),
      new BindGroupLayoutEntry(binding: 3u32, visibility: f, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 4u32, visibility: f, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      new BindGroupLayoutEntry(binding: 8u32, visibility: f, kind: BINDING_KIND_TEXTURE, sampleType: TEXTURE_SAMPLE_TYPE_DEPTH),
      new BindGroupLayoutEntry(binding: 9u32, visibility: f)];
    mut drawLayout = device.createBindGroupLayout(&drawEntries);
    imm solveLayouts = [&solveLayout];
    mut solvePipelineLayout = device.createPipelineLayout(&solveLayouts, 16u32);
    imm drawLayouts = [&drawLayout];
    mut drawPipelineLayout = device.createPipelineLayout(&drawLayouts, 16u32);
    imm forcesDesc = new ComputePipelineDescriptor(layout: &solvePipelineLayout, module: &solveShader, entryPoint: "forcesMain");
    mut forcesPipeline = device.createComputePipeline(&forcesDesc);
    imm curlDesc = new ComputePipelineDescriptor(layout: &solvePipelineLayout, module: &solveShader, entryPoint: "curlMain");
    mut curlPipeline = device.createComputePipeline(&curlDesc);
    imm confineDesc = new ComputePipelineDescriptor(layout: &solvePipelineLayout, module: &solveShader, entryPoint: "confineMain");
    mut confinePipeline = device.createComputePipeline(&confineDesc);
    imm divergenceDesc = new ComputePipelineDescriptor(layout: &solvePipelineLayout, module: &solveShader, entryPoint: "divergenceMain");
    mut divergencePipeline = device.createComputePipeline(&divergenceDesc);
    imm jacobiDesc = new ComputePipelineDescriptor(layout: &solvePipelineLayout, module: &solveShader, entryPoint: "jacobiMain");
    mut jacobiPipeline = device.createComputePipeline(&jacobiDesc);
    imm projectDesc = new ComputePipelineDescriptor(layout: &solvePipelineLayout, module: &solveShader, entryPoint: "projectMain");
    mut projectPipeline = device.createComputePipeline(&projectDesc);
    imm advectDesc = new ComputePipelineDescriptor(layout: &solvePipelineLayout, module: &solveShader, entryPoint: "advectMain");
    mut advectPipeline = device.createComputePipeline(&advectDesc);
    imm noBuffers = List[VertexBufferLayout].empty();
    imm volumeDesc = new RenderPipelineDescriptor(layout: &drawPipelineLayout, vertexModule: &drawShader,
      vertexEntryPoint: "fullscreenVertex", buffers: noBuffers.view(), fragmentModule: &drawShader,
      fragmentEntryPoint: "volumeFragment", colorFormat: colorFormat, blendEnabled: true,
      colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut volumePipeline = device.createRenderPipeline(&volumeDesc);
    imm n = u64.from(d.nx) * u64.from(d.ny) * u64.from(d.nz);
    mut params = device.createBuffer(FLUID_PARAMS_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    mut vel0 = device.createBuffer(n * 16u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    mut vel1 = device.createBuffer(n * 16u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    mut gas0 = device.createBuffer(n * 8u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    mut gas1 = device.createBuffer(n * 8u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    mut press0 = device.createBuffer(n * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    mut press1 = device.createBuffer(n * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    mut aux = device.createBuffer(n * 16u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    device.queue.clearBuffer(&vel0, 0u64, n * 16u64);
    device.queue.clearBuffer(&vel1, 0u64, n * 16u64);
    device.queue.clearBuffer(&gas0, 0u64, n * 8u64);
    device.queue.clearBuffer(&gas1, 0u64, n * 8u64);
    device.queue.clearBuffer(&press0, 0u64, n * 4u64);
    device.queue.clearBuffer(&press1, 0u64, n * 4u64);
    device.queue.clearBuffer(&aux, 0u64, n * 16u64);
    mut tinyFx = device.createBuffer(336u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    imm depthDesc = new TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_DEPTH32_FLOAT,
      TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING);
    mut tinyDepth = device.createTexture(&depthDesc);
    mut depthView = tinyDepth.createView();
    imm se = [BindGroupEntry.buffer(0u32, &params), BindGroupEntry.buffer(1u32, &vel0), BindGroupEntry.buffer(2u32, &vel1),
      BindGroupEntry.buffer(3u32, &gas0), BindGroupEntry.buffer(4u32, &gas1), BindGroupEntry.buffer(5u32, &press0),
      BindGroupEntry.buffer(6u32, &press1), BindGroupEntry.buffer(7u32, &aux)];
    mut solveGroup = device.createBindGroup(&solveLayout, &se);
    imm de = [BindGroupEntry.buffer(0u32, &params), BindGroupEntry.buffer(3u32, &gas0), BindGroupEntry.buffer(4u32, &gas1),
      BindGroupEntry.texture(8u32, &depthView), BindGroupEntry.buffer(9u32, &tinyFx)];
    mut drawGroup = device.createBindGroup(&drawLayout, &de);
    new FluidSmoke(solveShader, drawShader, solveLayout, drawLayout, solvePipelineLayout, drawPipelineLayout, forcesPipeline,
      curlPipeline, confinePipeline, divergencePipeline, jacobiPipeline, projectPipeline, advectPipeline, volumePipeline, params,
      vel0, vel1, gas0, gas1, press0, press1, aux, tinyFx, tinyDepth, solveGroup, drawGroup, LowResLayer.create(device, colorFormat), *d,
      cells: u32.from(n));
  }

  // Make the draw bind group again at the next frame (after ImageFx's 'configure')
  pub fn rebind(self &mut) { boundW = 0u32; }

  pub fn isValid(self &) bool {
    forcesPipeline.isValid() and curlPipeline.isValid() and confinePipeline.isValid() and divergencePipeline.isValid()
      and jacobiPipeline.isValid() and projectPipeline.isValid() and advectPipeline.isValid() and volumePipeline.isValid()
      and params.isValid() and solveGroup.isValid() and drawGroup.isValid();
  }

  // Move the fire's centre (a source that moves leaves a trail)
  pub fn moveSource(self &mut, source Vec3) { desc.source = source; }

  fn writeParams(self &mut, device &mut Device, dt f32) {
    mut w = List[u32].withCapacity(32usize);
    w.push(desc.nx); w.push(desc.ny); w.push(desc.nz); w.push(frame);
    pushVec4(&mut w, desc.origin.x, desc.origin.y, desc.origin.z, desc.cell);
    pushVec4(&mut w, dt, desc.buoyancy, desc.weight, desc.vorticity);
    pushVec4(&mut w, desc.source.x, desc.source.y, desc.source.z, desc.sourceRadius);
    pushVec4(&mut w, desc.temperature, desc.fuelRate, desc.cooling, desc.dissipation);
    pushVec4Bits(&mut w, 0., desc.damping, desc.upSpeed, desc.seed);
    pushVec4Bits(&mut w, desc.brightness, desc.absorption, 0., 0u32);
    w.set(26usize, desc.steps);
    w.set(27usize, desc.shadow as u32);
    pushVec4(&mut w, desc.soot.red, desc.soot.green, desc.soot.blue, desc.ambient);
    imm wv = w.view();
    device.queue.writeBuffer(&params, 0u64, &wv[0] as *u8, FLUID_PARAMS_BYTES);
  }

  // Advance the simulation by 'dt' seconds (one step: the source, forces, confinement, projection, advection)
  pub fn step(self &mut, device &mut Device, encoder &mut CommandEncoder, dt f32) {
    self.writeParams(device, dt);
    imm groups = (cells + 63u32) / 64u32;
    mut pass = encoder.beginComputePass();
    mut count = 0u32;
    mut imms = new Array[u32, 4] <- fill 0u32;
    imms[0] = parity;
    pass.setPipeline(&forcesPipeline);
    pass.setBindGroup(0u32, &solveGroup);
    pass.setImmediates(0u32, &imms as *u8, 16u32);
    pass.dispatchWorkgroups(groups, 1u32, 1u32);
    pass.setPipeline(&curlPipeline);
    pass.setBindGroup(0u32, &solveGroup);
    pass.setImmediates(0u32, &imms as *u8, 16u32);
    pass.dispatchWorkgroups(groups, 1u32, 1u32);
    pass.setPipeline(&confinePipeline);
    pass.setBindGroup(0u32, &solveGroup);
    pass.setImmediates(0u32, &imms as *u8, 16u32);
    pass.dispatchWorkgroups(groups, 1u32, 1u32);
    pass.setPipeline(&divergencePipeline);
    pass.setBindGroup(0u32, &solveGroup);
    pass.setImmediates(0u32, &imms as *u8, 16u32);
    pass.dispatchWorkgroups(groups, 1u32, 1u32);
    count = 4u32;
    pass.setPipeline(&jacobiPipeline);
    pass.setBindGroup(0u32, &solveGroup);
    mut k = 0u32;
    while k < desc.jacobi {
      imms[1] = k % 2u32;
      pass.setImmediates(0u32, &imms as *u8, 16u32);
      pass.dispatchWorkgroups(groups, 1u32, 1u32);
      k = k + 1u32;
    }
    count = count + desc.jacobi;
    imms[1] = desc.jacobi % 2u32;
    pass.setPipeline(&projectPipeline);
    pass.setBindGroup(0u32, &solveGroup);
    pass.setImmediates(0u32, &imms as *u8, 16u32);
    pass.dispatchWorkgroups(groups, 1u32, 1u32);
    pass.setPipeline(&advectPipeline);
    pass.setBindGroup(0u32, &solveGroup);
    pass.setImmediates(0u32, &imms as *u8, 16u32);
    pass.dispatchWorkgroups(groups, 1u32, 1u32);
    count = count + 2u32;
    pass.end();
    dispatches = count;
    parity = parity ^ 1u32;
    frame = frame + 1u32;
  }

  fn bindFrame(self &mut, device &mut Device, fx &ImageFx) {
    if boundW == fx.width and boundH == fx.height and boundW != 0u32 { return; }
    device.queue.releaseBindGroup(&mut drawGroup);
    mut depthView = fx.depth.createView();
    imm de = [BindGroupEntry.buffer(0u32, &params), BindGroupEntry.buffer(3u32, &gas0), BindGroupEntry.buffer(4u32, &gas1),
      BindGroupEntry.texture(8u32, &depthView), BindGroupEntry.buffer(9u32, &fx.frameBuffer)];
    drawGroup = device.createBindGroup(&drawLayout, &de);
    boundW = fx.width;
    boundH = fx.height;
  }

  // Add the volume into 'target' (the HDR frame, kept), over the scene: ray marched, depth clipped
  pub fn render(self &mut, device &mut Device, encoder &mut CommandEncoder, fx &ImageFx, target &Texture, camera &Camera) {
    self.bindFrame(device, fx);
    // The box's bounds on the screen, for the scissor
    imm aspect = f32.from(target.width) / f32.from(target.height);
    imm viewProjection = camera.projectionMatrix(aspect) * camera.viewMatrix();
    mut x0 = 1.0e9;
    mut y0 = 1.0e9;
    mut x1 = -1.0e9;
    mut y1 = -1.0e9;
    mut clipped = false;
    mut i = 0u32;
    while i < 8u32 {
      imm px = desc.origin.x + (if (i & 1u32) != 0u32 { f32.from(desc.nx) * desc.cell; } else { 0.; });
      imm py = desc.origin.y + (if (i & 2u32) != 0u32 { f32.from(desc.ny) * desc.cell; } else { 0.; });
      imm pz = desc.origin.z + (if (i & 4u32) != 0u32 { f32.from(desc.nz) * desc.cell; } else { 0.; });
      imm clip = viewProjection * new Vec4(px, py, pz, 1.);
      if clip.w <= 0.01 {
        clipped = true;
      } else {
        imm sx = (clip.x / clip.w * 0.5 + 0.5) * f32.from(target.width);
        imm sy = (1. - (clip.y / clip.w * 0.5 + 0.5)) * f32.from(target.height);
        if sx < x0 { x0 = sx; }
        if sx > x1 { x1 = sx; }
        if sy < y0 { y0 = sy; }
        if sy > y1 { y1 = sy; }
      }
      i = i + 1u32;
    }
    if clipped { x0 = 0.; y0 = 0.; x1 = f32.from(target.width); y1 = f32.from(target.height); }
    if x0 < 0. { x0 = 0.; }
    if y0 < 0. { y0 = 0.; }
    if x1 > f32.from(target.width) { x1 = f32.from(target.width); }
    if y1 > f32.from(target.height) { y1 = f32.from(target.height); }
    if x1 <= x0 or y1 <= y0 { return; }
    // At half resolution the volume is drawn into a layer of half the frame's size and laid over the frame
    imm scale = if halfResolution { 2.; } else { 1.; };
    if halfResolution {
      lowRes.ensure(device, target.width, target.height);
      lowRes.clear(encoder);
    }
    mut destination = target.createView();
    mut limitW = target.width;
    mut limitH = target.height;
    if halfResolution {
      destination = lowRes.texture.createView();
      limitW = lowRes.width;
      limitH = lowRes.height;
    }
    imm color = new RenderPassColorAttachment(view: destination, loadOp: LOAD_OP_LOAD,
      clearValue: new Color(0., 0., 0., 0.));
    mut pass = encoder.beginRenderPass(&color);
    pass.setPipeline(&volumePipeline);
    pass.setBindGroup(0u32, &drawGroup);
    mut imms = new Array[u32, 4] <- fill 0u32;
    imms[0] = parity;
    imms[2] = scale as u32;
    pass.setImmediates(0u32, &imms as *u8, 16u32);
    imm sx0 = u32.from(x0 / scale);
    imm sy0 = u32.from(y0 / scale);
    mut sw = u32.from((x1 - x0) / scale) + 2u32;
    mut sh = u32.from((y1 - y0) / scale) + 2u32;
    if sx0 + sw > limitW { sw = limitW - sx0; }
    if sy0 + sh > limitH { sh = limitH - sy0; }
    pass.setScissorRect(sx0, sy0, sw, sh);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
    if halfResolution { lowRes.composite(encoder, target); }
  }
}

