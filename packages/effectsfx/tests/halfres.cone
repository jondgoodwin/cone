// The half-resolution layer, on a real GPU with no window: smoke drawn at a quarter of the fragments
// looks like smoke drawn in full, and still hides behind what stands in front of it.
//
// A grey cube stands 2 m in front of a cloud of smoke puffs (one class, 150 puffs ordered at once, run
// for 1.5 s), seen by a camera 6 m back, 128 x 96 pixels. The same frames are drawn twice, with the
// player's 'halfResolution' off and on, and read back:
// 1. The layer is half the frame's size: 64 x 48.
// 2. The pictures agree on the whole: the mean over the frame's pixels differs by under 2% of the
//    larger, and the mean absolute difference is under 6 levels of 255.
// 3. The cube hides the smoke behind it in both: the pixel at the cube's middle is the same in both, to
//    4 levels, and has no more smoke than the cube alone would show (it is close to the picture
//    with no smoke at all).
// 4. The smoke shows: the pixel at the cloud's middle differs from the picture without smoke by over
//    30 levels, in both.
// 5. No Vulkan call failed and the validation layer said nothing.

mod halfres;

import testing use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import effectsfx use *;

const W = 128u32;
const H = 96u32;
const DT = 0.016666668;

fn luma(p *u8, x u32, y u32) i32 {
  imm at = p + usize.from((y * W + x) * 4u32);
  i32.from(*at) + i32.from(*(at + 1usize)) + i32.from(*(at + 2usize));
}

fn smokeEffect() Effect {
  mut e = Effect.empty();
  mut c = ParticleClass.make();
  c.style = PARTICLE_SMOKE;
  c.shape = EMIT_SPHERE;
  c.radius = 1.2;
  c.speed = 0.1;
  c.gravity = new Vec3(0., 0., 0.);
  c.life = 5.;
  c.sizeStart = 2.2;
  c.sizeEnd = 2.6;
  c.fadeIn = 0.05;
  c.fadeOut = 0.2;
  c.colors = [new Color(0.9, 0.85, 0.8, 0.35), new Color(0.9, 0.85, 0.8, 0.35), new Color(0.9, 0.85, 0.8, 0.35), new Color(0.9, 0.85, 0.8, 0.)];
  mut layer = ParticleLayer.make(&c);
  layer.burst = 150u32;
  e.particles.push(layer);
  e;
}

// Draw the scene for 90 frames (smoke played or not, half resolution or not) and read the last one back
fn picture(device &mut Device, renderer &mut Renderer, post &mut Post, fx &mut ImageFx, out &Texture, camera &Camera,
    light &Light, boxM MeshHandle, matM MaterialHandle, smoke bool, half bool, layerWidth &mut u32, layerHeight &mut u32,
    pixels &mut List[u8]) {
  mut player = EffectPlayer.create(device, TEXTURE_FORMAT_RGBA16_FLOAT, 4096u32);
  require(player.isValid(), "a player");
  player.halfResolution = half;
  imm id = player.register(device, smokeEffect());
  mut readback = device.createBuffer(u64.from(W * H * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut f = 0u32;
  while f < 90u32 {
    imm now = f32.from(f) * DT;
    mut list = DrawList.empty();
    list.add(boxM, matM, Mat4.fromTrs(new Vec3(0., 0., 2.), Quat.identity(), new Vec3(1., 1., 1.)));
    if f == 0u32 and smoke { player.play(id, new Vec3(0., 0., -1.), new Vec3(0., 1., 0.), new Vec3(0., 0., 0.), 5u32, now); }
    player.beginFrame(renderer, fx, &mut list, camera, now, DT);
    mut encoder = device.createCommandEncoder();
    fx.renderScene(device, &mut encoder, renderer, post, camera, light, &list);
    player.drawEffects(device, &mut encoder, fx, &post.hdr, camera, now, DT);
    fx.renderFinish(device, &mut encoder, renderer, post, &list, out);
    if f + 1u32 == 90u32 { encoder.copyTextureToBuffer(out, &readback); }
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    f = f + 1u32;
  }
  *layerWidth = player.lowRes.width;
  *layerHeight = player.lowRes.height;
  imm p = readback.mappedRange();
  pixels.clear();
  mut i = 0usize;
  while i < usize.from(W * H * 4u32) {
    pixels.push(*(p + i));
    i = i + 1usize;
  }
}

fn main() i32 {
  mut instance = Instance.create("effectsfx halfres");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  imm outDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut out = device.createTexture(&outDesc);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, W, H);
  mut fx = ImageFx.create(&mut device, &renderer, &mut post);
  require(renderer.isValid() and post.isValid() and fx.isValid(), "the renderer and its passes");
  imm boxMesh = Mesh.cube(0.5);
  imm box = renderer.addMesh(&mut device, &boxMesh);
  imm grey = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(new Color(0.3, 0.3, 0.32, 1.), 0., 0.8));
  mut camera = Camera.make();
  camera.fov = radians(50.);
  camera.near = 0.2;
  camera.far = 40.;
  camera.lookAt(new Vec3(0., 0., 6.), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
  camera.background = new Color(0.02, 0.02, 0.03, 1.);
  imm light = Light.directional(new Vec3(0.3, -0.6, -1.), Color.gray(1.5), new Color(0.15, 0.15, 0.18, 1.));

  mut lw = 0u32;
  mut lh = 0u32;
  mut full = List[u8].empty();
  mut half = List[u8].empty();
  mut bare = List[u8].empty();
  mut ignored = 0u32;
  picture(&mut device, &mut renderer, &mut post, &mut fx, &out, &camera, &light, box, grey, false, false, &mut ignored, &mut ignored, &mut bare);
  picture(&mut device, &mut renderer, &mut post, &mut fx, &out, &camera, &light, box, grey, true, false, &mut ignored, &mut ignored, &mut full);
  picture(&mut device, &mut renderer, &mut post, &mut fx, &out, &camera, &light, box, grey, true, true, &mut lw, &mut lh, &mut half);
  expectUInt(u64.from(lw), u64.from(W / 2u32), "the layer is half the frame wide");
  expectUInt(u64.from(lh), u64.from(H / 2u32), "and half as high");
  mut sumFull = 0i64;
  mut sumHalf = 0i64;
  mut absDiff = 0i64;
  mut i = 0usize;
  while i < usize.from(W * H * 4u32) {
    if i % 4usize != 3usize {
      imm a = i64.from(*full[i]);
      imm b = i64.from(*half[i]);
      sumFull = sumFull + a;
      sumHalf = sumHalf + b;
      absDiff = absDiff + (if a > b { a - b; } else { b - a; });
    }
    i = i + 1usize;
  }
  imm samples = i64.from(W * H * 3u32);
  expect(absDiff < samples * 6i64, "the mean absolute difference is under 6 levels of 255");
  imm larger = if sumFull > sumHalf { sumFull; } else { sumHalf; };
  imm gap = if sumFull > sumHalf { sumFull - sumHalf; } else { sumHalf - sumFull; };
  expect(gap * 50i64 < larger, "the means of the two pictures agree to 2%");
  // The cube is at the frame's middle; the cloud behind it spreads wider: a pixel off the cube's side
  imm cubeX = W / 2u32;
  imm cubeY = H / 2u32;
  expect(i32.from(luma(&(*bare[0usize]) as *u8, cubeX, cubeY)) - luma(&(*full[0usize]) as *u8, cubeX, cubeY) < 12i32
    and luma(&(*full[0usize]) as *u8, cubeX, cubeY) - luma(&(*bare[0usize]) as *u8, cubeX, cubeY) < 12i32,
    "the cube hides the smoke behind it (full resolution): its middle is as it is with no smoke");
  imm dFull = luma(&(*full[0usize]) as *u8, cubeX, cubeY);
  imm dHalf = luma(&(*half[0usize]) as *u8, cubeX, cubeY);
  expect(dFull - dHalf < 12i32 and dHalf - dFull < 12i32, "and the same at half resolution, to 4 levels a channel");
  imm side = W / 2u32 - 26u32;
  imm smokeFull = luma(&(*full[0usize]) as *u8, side, cubeY) - luma(&(*bare[0usize]) as *u8, side, cubeY);
  imm smokeHalf = luma(&(*half[0usize]) as *u8, side, cubeY) - luma(&(*bare[0usize]) as *u8, side, cubeY);
  expect(smokeFull > 90i32 and smokeHalf > 90i32, "the smoke shows beside the cube, in both");

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}
