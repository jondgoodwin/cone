// GPU particles colliding with the scene's depth buffer, on a real GPU with no window.
//
// A floor under a camera that looks down at it, and a burst of 400 sparks thrown up from 1.5 m
// above it, simulated by the compute kernel through ImageFx (whose scene half leaves the depth).
//
// 1. With depth collision on, after 1.2 s no living particle that is in the camera's view is
//    below the floor (the floor's surface is where the depth buffer says it is), and many have
//    bounced.
// 2. With it off and no ground plane, the same burst falls through the floor (so the check
//    above can fail).
// 3. With the ground plane on and depth off, nothing is below the floor anywhere, in view or not.
// 4. A bounce loses energy: the sparks' mean speed after bouncing is under what they fell with.
// 5. The spawn count: 400 particles ordered are 400 born (the ring's first 400 slots), and a
//    second burst takes the next 400.
// 6. No Vulkan call failed and the validation layer said nothing.

mod sparks;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import effectsfx use *;

const W = 320u32;
const H = 200u32;
const CAP = 2048u32;

struct Counts {
  alive: u32;
  inViewBelow: u32;       // alive, projected into the view, more than 6 cm under the floor
  below: u32;             // alive and more than 6 cm under the floor anywhere
  bounced: u32;
  rows: u32;              // slots holding a particle at all (age < life or the birth's own)
}

fn sparkClass() ParticleClass {
  var c = ParticleClass.make();
  c.shape = EMIT_POINT;
  c.spread = radians(70.);
  c.speed = 3.;
  c.speedJitter = 0.3;
  c.life = 2.5;
  c.sizeStart = 0.05;
  c.sizeEnd = 0.04;
  c.stretch = 0.03;
  c.collide = true;
  c.restitution = 0.5;
  c.friction = 0.2;
  c.colors = [Color(1., 0.8, 0.4, 5.), Color(1., 0.6, 0.2, 4.), Color(1., 0.3, 0.1, 2.), Color(0.4, 0.05, 0.02, 0.)];
  c
}

// Run the burst for 'frames' frames and count what is where
fn runCase(device: &mut Device, renderer: &mut Renderer, post: &mut Post, fx: &mut ImageFx, out: &Texture, camera: &Camera,
    light: &Light, list: &DrawList, depth: bool, ground: bool, frames: u32, bursts: u32, spawnedFirst: &mut u32) Counts {
  var ps = ParticleSystem.create(device, TEXTURE_FORMAT_RGBA16_FLOAT, CAP);
  require(ps.isValid(), "a particle system");
  ps.depthCollision = depth;
  ps.groundOn = ground;
  ps.groundNormal = Vec3(0., 1., 0.);
  ps.groundOffset = 0.;
  let cls = ps.addClass(&sparkClass());
  var readback = device.createBuffer(u64.from(CAP) * 48u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  let viewProjection = camera.projectionMatrix(f32.from(W) / f32.from(H)) * camera.viewMatrix();
  var f = 0u32;
  while f < frames {
    if f == 0u32 { ps.emit(cls, Vec3(0., 1.5, 0.), Vec3(0., 1., 0.), Vec3(0., 0., 0.), 400u32, 7u32); }
    if f == 5u32 && bursts > 1u32 { ps.emit(cls, Vec3(0.5, 1.5, 0.), Vec3(0., 1., 0.), Vec3(0., 0., 0.), 400u32, 8u32); }
    var encoder = device.createCommandEncoder();
    fx.renderScene(device, &mut encoder, renderer, post, camera, light, list);
    ps.simulate(device, &mut encoder, fx, camera, f32.from(f) / 60., 1. / 60.);
    if f == 0u32 { *spawnedFirst = ps.spawned; }
    ps.render(&mut encoder, &post.hdr, PARTICLE_SMOKE, 1.);
    ps.render(&mut encoder, &post.hdr, PARTICLE_SPARK, 1.);
    fx.renderFinish(device, &mut encoder, renderer, post, list, out);
    if f + 1u32 == frames { encoder.copyBufferToBuffer(&ps.pool, 0u64, &readback, 0u64, u64.from(CAP) * 48u64); }
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    f = f + 1u32;
  }
  var counts = Counts(0u32, 0u32, 0u32, 0u32, 0u32);
  let p = readback.mappedRange() as *f32;
  var i = 0usize;
  while i < usize.from(CAP) {
    let a = p + i * 12usize;
    let x = *a;
    let y = *(a + 1usize);
    let z = *(a + 2usize);
    let age = *(a + 3usize);
    let life = *(a + 7usize);
    let bounces = *(a + 10usize);
    if life > 0. { counts.rows = counts.rows + 1u32; }
    if life > 0. && age < life {
      counts.alive = counts.alive + 1u32;
      if bounces >= 1. { counts.bounced = counts.bounced + 1u32; }
      if y < -0.06 { counts.below = counts.below + 1u32; }
      let clip = viewProjection * Vec4(x, y, z, 1.);
      let nx = clip.x / clip.w;
      let ny = clip.y / clip.w;
      if clip.w > 0. && nx > -0.9 && nx < 0.9 && ny > -0.9 && ny < 0.9 && y < -0.06 {
        counts.inViewBelow = counts.inViewBelow + 1u32;
      }
    }
    i = i + 1usize;
  }
  counts
}

fn main() i32 {
  var instance = Instance.create("effectsfx sparks");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  var device = adapter.requestDevice();
  require(device.isValid(), "a device");
  let outDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var out = device.createTexture(&outDesc);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, W, H);
  var fx = ImageFx.create(&mut device, &renderer, &mut post);
  require(renderer.isValid() && post.isValid() && fx.isValid(), "the renderer and its passes");

  let floorMesh = Mesh.plane(1, 1.);
  let floorId = renderer.addMesh(&mut device, &floorMesh);
  let boxMesh = Mesh.cube(0.5);
  let boxId = renderer.addMesh(&mut device, &boxMesh);
  let dark = PbrMaterial.standard(Color(0.2, 0.2, 0.22, 1.), 0.8, 0.4);
  let darkM = renderer.addPbrMaterial(&mut device, &dark);
  var list = DrawList.empty();
  list.add(floorId, darkM, Mat4.fromTrs(Vec3(0., 0., 0.), Quat.identity(), Vec3(20., 1., 20.)));
  list.add(boxId, darkM, Mat4.fromTrs(Vec3(-1.6, 0.4, -0.5), Quat.identity(), Vec3(0.8, 0.8, 0.8)));
  var camera = Camera.make();
  camera.fov = radians(50.);
  camera.near = 0.1;
  camera.far = 60.;
  camera.lookAt(Vec3(0., 2.2, 5.), Vec3(0., 0.5, 0.), Vec3(0., 1., 0.));
  let sky = Sky.dusk(radians(30.), radians(200.));
  renderer.setSky(&mut device, &sky);
  let light = sky.sunLight(Color(2., 1.8, 1.5, 1.), Color(0.1, 0.1, 0.12, 1.));

  var spawnedFirst = 0u32;
  let on = runCase(&mut device, &mut renderer, &mut post, &mut fx, &out, &camera, &light, &list, true, false, 72u32, 1u32, &mut spawnedFirst);
  expectUInt(u64.from(spawnedFirst), 400u64, "400 ordered, 400 born");
  expect(on.alive > 100u32, "sparks still alive after 1.2 s");
  expect(on.inViewBelow * 100u32 <= on.alive, "depth collision: at most one in a hundred of the living in view is under the floor");
  expect(on.bounced > 60u32, "depth collision: many have bounced");

  let off = runCase(&mut device, &mut renderer, &mut post, &mut fx, &out, &camera, &light, &list, false, false, 72u32, 1u32, &mut spawnedFirst);
  expect(off.below > 60u32, "no collision at all: the burst falls through the floor");

  let plane = runCase(&mut device, &mut renderer, &mut post, &mut fx, &out, &camera, &light, &list, false, true, 72u32, 1u32, &mut spawnedFirst);
  expectUInt(u64.from(plane.below), 0u64, "ground plane: nothing under the floor anywhere");
  expect(plane.bounced > 60u32, "ground plane: many have bounced");

  let two = runCase(&mut device, &mut renderer, &mut post, &mut fx, &out, &camera, &light, &list, true, true, 20u32, 2u32, &mut spawnedFirst);
  expectUInt(u64.from(two.rows), 800u64, "two bursts of 400 fill 800 slots");

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done()
}
