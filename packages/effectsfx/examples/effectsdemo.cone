// effectsdemo: four effects built from the effectsfx package's data, offscreen (no window), on either GPU.
//
//   congo run packages/effectsfx/examples/effectsdemo.cone -- --effect blast --shots C:\src\effectsfx-shots\blast
//   congo run packages/effectsfx/examples/effectsdemo.cone -- --effect all --shots C:\src\effectsfx-shots\fx
//   congo run packages/effectsfx/examples/effectsdemo.cone -- --effect blast --cost
//
// '--effect' is one of blast, muzzle, sparks, fire or all. '--shots PREFIX' writes PREFIX-<effect>-<n>.bmp, one
// frame at each of the moments listed below for the effect. '--cost' plays the effect over and over and prints
// the GPU time of each stage of the frame (the scene, the particle simulation, the drawing of the particles and
// flipbooks, the distortion, the finish), the median of 240 frames, next to the same frames with nothing playing.
// GPU_POWER_PREFERENCE=low-power picks the Intel GPU. Nothing here reads a key or the mouse.
//
// THE EFFECTS, each only a value of effectsfx's Effect (lists of layers); none is code in the library:
// - blast: a crate stack goes up. A baked fireball that billows into smoke, a shock ring and heat haze, 220 hot
//   sparks that bounce off the floor and the crates behind, 90 floating embers, a column of lit smoke, a ring of
//   dust, crate debris, a point light that lights the room and cools, a scorch decal on the floor, camera shake.
// - muzzle: a gun fires six times, 0.12 s apart: a short cone of streaks, a side flash, a quick baked flash, a
//   light that flickers the wall, a wisp of smoke.
// - sparks: a ricochet off a steel plate and then a grinding spray, the sparks skittering across the plate and the
//   floor (depth-buffer collision), a flickering orange light, a tiny scorch.
// - fire: a campfire that burns for ten seconds: additive flame sprites, smoke that rises and eddies (curl noise),
//   rising embers, heat haze over the flame, a flickering light.

mod effectsdemo;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import path as filepath;
import effectsfx use *;

const W = 1280u32;
const H = 720u32;
const DT = 0.016666668;

// ---------------------------------------------------------------------------------------------------------
// The effects, as data
// ---------------------------------------------------------------------------------------------------------

fn hotSparks(count u32, speed f32, spread f32, collide bool) ParticleClass {
  mut c = ParticleClass.make();
  c.shape = EMIT_POINT;
  c.spread = spread;
  c.speed = speed;
  c.speedJitter = 0.55;
  c.life = 1.7;
  c.lifeJitter = 0.4;
  c.drag = 0.35;
  c.sizeStart = 0.055;
  c.sizeEnd = 0.03;
  c.sizeJitter = 0.4;
  c.stretch = 0.03;
  c.fadeOut = 0.35;
  c.collide = collide;
  c.restitution = 0.5;
  c.friction = 0.25;
  c.bounceLifeLoss = 0.06;
  c.colors = [new Color(1., 0.9, 0.6, 9.), new Color(1., 0.55, 0.15, 6.), new Color(1., 0.28, 0.05, 3.), new Color(0.5, 0.06, 0.02, 0.)];
  c.colorAt = [0., 0.2, 0.6, 1.];
  c;
}

fn embers() ParticleClass {
  mut c = ParticleClass.make();
  c.shape = EMIT_SPHERE;
  c.radius = 0.5;
  c.spread = radians(70.);
  c.speed = 3.;
  c.speedJitter = 0.6;
  c.life = 3.2;
  c.lifeJitter = 0.4;
  c.drag = 0.8;
  c.gravity = new Vec3(0., 0.7, 0.);
  c.turbulence = 3.5;
  c.turbulenceScale = 0.9;
  c.sizeStart = 0.05;
  c.sizeEnd = 0.02;
  c.stretch = 0.012;
  c.fadeIn = 0.04;
  c.fadeOut = 0.4;
  c.colors = [new Color(1., 0.6, 0.2, 4.), new Color(1., 0.4, 0.08, 3.), new Color(0.9, 0.2, 0.04, 1.5), new Color(0.3, 0.05, 0.01, 0.)];
  c.colorAt = [0., 0.3, 0.7, 1.];
  c;
}

fn columnSmoke() ParticleClass {
  mut c = ParticleClass.make();
  c.style = PARTICLE_SMOKE;
  c.shape = EMIT_SPHERE;
  c.radius = 0.6;
  c.spread = radians(35.);
  c.speed = 3.4;
  c.speedJitter = 0.4;
  c.life = 5.5;
  c.lifeJitter = 0.35;
  c.drag = 1.3;
  c.gravity = new Vec3(0., 0.7, 0.);
  c.turbulence = 2.2;
  c.turbulenceScale = 0.55;
  c.turbulenceSpeed = 0.4;
  c.sizeStart = 1.0;
  c.sizeEnd = 4.2;
  c.sizeJitter = 0.35;
  c.fadeIn = 0.22;
  c.fadeOut = 0.65;
  c.colors = [new Color(0.55, 0.38, 0.24, 0.55), new Color(0.30, 0.27, 0.25, 0.6), new Color(0.2, 0.19, 0.18, 0.45), new Color(0.12, 0.12, 0.12, 0.)];
  c.colorAt = [0., 0.12, 0.5, 1.];
  c;
}

fn dustRing() ParticleClass {
  mut c = ParticleClass.make();
  c.style = PARTICLE_SMOKE;
  c.shape = EMIT_DISC;
  c.radius = 0.5;
  c.spread = radians(88.);
  c.speed = 7.;
  c.speedJitter = 0.3;
  c.life = 2.4;
  c.lifeJitter = 0.3;
  c.drag = 2.6;
  c.gravity = new Vec3(0., 0.15, 0.);
  c.turbulence = 1.5;
  c.sizeStart = 0.8;
  c.sizeEnd = 3.0;
  c.fadeIn = 0.05;
  c.fadeOut = 0.7;
  c.colors = [new Color(0.55, 0.48, 0.38, 0.5), new Color(0.5, 0.44, 0.36, 0.4), new Color(0.4, 0.37, 0.33, 0.25), new Color(0.3, 0.3, 0.3, 0.)];
  c.colorAt = [0., 0.2, 0.6, 1.];
  c;
}

fn blastEffect(boxMesh MeshHandle, woodM MaterialHandle, steelM MaterialHandle, scorch u32) Effect {
  mut e = Effect.empty();
  mut fb = FlipbookDesc.make();
  fb.seed = 21u32;
  fb.startRadius = 0.10;
  fb.endRadius = 0.72;
  fb.growth = 4.5;
  fb.rise = 0.30;
  fb.turbulence = 0.62;
  fb.cooling = 3.0;
  fb.brightness = 24.;
  fb.sootStart = 0.10;
  mut fl = FlipbookLayer.make(&fb);
  fl.size = 3.6;
  fl.duration = 2.2;
  fl.offset = new Vec3(0., 1.5, 0.);
  e.flipbooks.push(fl);
  // The shock ring and the heat over the fire
  mut ring = DistortionLayer.ring(5.5, 0.75, 0.12);
  ring.offset = new Vec3(0., 1., 0.);
  e.distortions.push(ring);
  mut haze = DistortionLayer.haze(1.9, 2.6, 0.07);
  haze.offset = new Vec3(0., 1.8, 0.);
  haze.delay = 0.1;
  e.distortions.push(haze);
  // Sparks and embers
  mut sp = ParticleLayer.make(&hotSparks(220u32, 10., radians(80.), true));
  sp.offset = new Vec3(0., 0.8, 0.);
  sp.delay = 0.02;
  sp.burst = 220u32;
  e.particles.push(sp);
  mut sp2 = ParticleLayer.make(&hotSparks(80u32, 5., radians(85.), true));
  sp2.offset = new Vec3(0., 0.6, 0.);
  sp2.delay = 0.05;
  sp2.burst = 80u32;
  e.particles.push(sp2);
  mut em = ParticleLayer.make(&embers());
  em.offset = new Vec3(0., 1., 0.);
  em.delay = 0.05;
  em.burst = 90u32;
  e.particles.push(em);
  mut smoke = ParticleLayer.make(&columnSmoke());
  smoke.offset = new Vec3(0., 0.9, 0.);
  smoke.delay = 0.25;
  smoke.burst = 30u32;
  smoke.rate = 60.;
  smoke.duration = 0.9;
  e.particles.push(smoke);
  mut dust = ParticleLayer.make(&dustRing());
  dust.offset = new Vec3(0., 0.15, 0.);
  dust.delay = 0.03;
  dust.burst = 60u32;
  e.particles.push(dust);
  // Debris: crate planks and metal shards
  mut planks = new DebrisLayer(boxMesh, woodM, new Vec3(0., 0.9, 0.));
  planks.count = 22u32;
  planks.speed = 8.;
  planks.spread = 1.0;
  planks.size = 0.26;
  planks.delay = 0.02;
  e.debris.push(planks);
  mut shards = new DebrisLayer(boxMesh, steelM, new Vec3(0., 0.9, 0.));
  shards.count = 36u32;
  shards.speed = 13.;
  shards.spread = 1.15;
  shards.size = 0.08;
  shards.spin = 16.;
  shards.delay = 0.02;
  e.debris.push(shards);
  // Light: the flash, then the fire's glow
  mut flash = LightLayer.make();
  flash.peak = 1000.;
  flash.range = 26.;
  flash.attack = 0.012;
  flash.decay = 0.35;
  flash.duration = 2.2;
  flash.offset = new Vec3(0., 1.6, 0.);
  e.lights.push(flash);
  mut glow = LightLayer.make();
  glow.color = new Color(1., 0.5, 0.2, 1.);
  glow.fadeColor = new Color(0.8, 0.15, 0.04, 1.);
  glow.peak = 90.;
  glow.range = 18.;
  glow.attack = 0.15;
  glow.decay = 1.8;
  glow.duration = 5.;
  glow.flicker = 0.25;
  glow.offset = new Vec3(0., 0.9, 0.);
  e.lights.push(glow);
  mut mark = DecalLayer.make(scorch);
  mark.size = 5.;
  mark.depth = 2.;
  mark.tint = new Color(1., 1., 1., 1.);
  mark.delay = 0.05;
  mark.hold = 40.;
  e.decals.push(mark);
  e.shakes.push(new ShakeLayer(0.85, 40., 0.02));
  e;
}

fn muzzleEffect() Effect {
  mut e = Effect.empty();
  mut flash = hotSparks(40u32, 30., radians(7.), false);
  flash.life = 0.075;
  flash.lifeJitter = 0.2;
  flash.drag = 0.;
  flash.gravity = new Vec3(0., 0., 0.);
  flash.sizeStart = 0.2;
  flash.sizeEnd = 0.07;
  flash.stretch = 0.025;
  flash.fadeOut = 0.5;
  flash.colors = [new Color(1., 0.95, 0.75, 4.5), new Color(1., 0.7, 0.3, 2.8), new Color(1., 0.4, 0.1, 1.), new Color(0.6, 0.1, 0.02, 0.)];
  mut fl = ParticleLayer.make(&flash);
  fl.burst = 16u32;
  e.particles.push(fl);
  mut side = hotSparks(20u32, 7., radians(88.), false);
  side.life = 0.05;
  side.lifeJitter = 0.2;
  side.drag = 0.;
  side.gravity = new Vec3(0., 0., 0.);
  side.sizeStart = 0.16;
  side.sizeEnd = 0.05;
  side.stretch = 0.03;
  side.colors = [new Color(1., 0.85, 0.5, 3.), new Color(1., 0.55, 0.2, 2.), new Color(1., 0.3, 0.1, 0.8), new Color(0.5, 0.1, 0.02, 0.)];
  mut sl = ParticleLayer.make(&side);
  sl.burst = 10u32;
  e.particles.push(sl);
  mut sparks = hotSparks(30u32, 12., radians(22.), true);
  sparks.life = 0.5;
  sparks.sizeStart = 0.035;
  mut ss = ParticleLayer.make(&sparks);
  ss.burst = 18u32;
  e.particles.push(ss);
  mut wisp = columnSmoke();
  wisp.radius = 0.04;
  wisp.spread = radians(22.);
  wisp.speed = 2.4;
  wisp.drag = 2.;
  wisp.gravity = new Vec3(0., 0.1, 0.);
  wisp.turbulence = 1.2;
  wisp.life = 1.8;
  wisp.sizeStart = 0.14;
  wisp.sizeEnd = 0.8;
  wisp.colors = [new Color(0.6, 0.55, 0.5, 0.3), new Color(0.5, 0.48, 0.46, 0.22), new Color(0.4, 0.4, 0.4, 0.1), new Color(0.3, 0.3, 0.3, 0.)];
  mut wl = ParticleLayer.make(&wisp);
  wl.delay = 0.03;
  wl.burst = 12u32;
  e.particles.push(wl);
  mut fb = FlipbookDesc.make();
  fb.seed = 5u32;
  fb.startRadius = 0.22;
  fb.endRadius = 0.5;
  fb.growth = 9.;
  fb.rise = 0.02;
  fb.turbulence = 0.25;
  fb.cooling = 7.;
  fb.brightness = 9.;
  fb.sootStart = 0.45;
  fb.smokeOpacity = 0.4;
  mut fbl = FlipbookLayer.make(&fb);
  fbl.size = 0.75;
  fbl.duration = 0.13;
  fbl.offset = new Vec3(0., 0.35, 0.);
  e.flipbooks.push(fbl);
  mut light = LightLayer.make();
  light.peak = 260.;
  light.range = 10.;
  light.attack = 0.002;
  light.decay = 0.035;
  light.duration = 0.2;
  light.flicker = 0.3;
  light.offset = new Vec3(0., 0.5, 0.);
  e.lights.push(light);
  e.shakes.push(new ShakeLayer(0.12, 6., 0.));
  e;
}

fn sparksEffect(scorch u32) Effect {
  mut e = Effect.empty();
  // The ricochet: a burst thrown at a grazing angle off the plate
  mut ric = hotSparks(160u32, 7., radians(32.), true);
  ric.life = 1.6;
  mut rl = ParticleLayer.make(&ric);
  rl.offset = new Vec3(0., 0.12, 0.);
  rl.axis = new Vec3(0.55, 0.7, 0.2).normalize();
  rl.burst = 160u32;
  e.particles.push(rl);
  // The grinding spray, 1.4 s of it
  mut grind = hotSparks(0u32, 4.2, radians(30.), true);
  grind.life = 1.1;
  grind.sizeStart = 0.04;
  grind.stretch = 0.025;
  mut gl = ParticleLayer.make(&grind);
  gl.offset = new Vec3(0., 0.15, 0.);
  gl.axis = new Vec3(0.8, 0.55, 0.).normalize();
  gl.delay = 0.35;
  gl.rate = 260.;
  gl.duration = 1.4;
  e.particles.push(gl);
  mut dust = columnSmoke();
  dust.radius = 0.1;
  dust.speed = 1.2;
  dust.life = 1.8;
  dust.sizeStart = 0.12;
  dust.sizeEnd = 0.7;
  dust.gravity = new Vec3(0., 0.4, 0.);
  dust.colors = [new Color(0.6, 0.55, 0.5, 0.25), new Color(0.5, 0.47, 0.45, 0.2), new Color(0.4, 0.4, 0.4, 0.1), new Color(0.3, 0.3, 0.3, 0.)];
  mut dl = ParticleLayer.make(&dust);
  dl.offset = new Vec3(0., 0.1, 0.);
  dl.burst = 8u32;
  dl.rate = 12.;
  dl.delay = 0.1;
  dl.duration = 1.5;
  e.particles.push(dl);
  mut light = LightLayer.make();
  light.color = new Color(1., 0.62, 0.25, 1.);
  light.fadeColor = new Color(1., 0.5, 0.15, 1.);
  light.peak = 45.;
  light.range = 9.;
  light.attack = 0.01;
  light.decay = 1.4;
  light.duration = 1.9;
  light.flicker = 0.4;
  light.offset = new Vec3(0., 0.5, 0.);
  e.lights.push(light);
  mut mark = DecalLayer.make(scorch);
  mark.size = 0.7;
  mark.depth = 0.5;
  mark.delay = 0.02;
  mark.hold = 30.;
  e.decals.push(mark);
  e;
}

fn fireEffect() Effect {
