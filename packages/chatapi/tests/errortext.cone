// The one line each error of this package gives a person is pinned here, with the
// number fields in play, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use String;
import chatapi use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  var e = ChatError.make(ChatErrorKind.Api, "Incorrect API key provided");
  e.status = 401u16;
  e.code = String.from("invalid_api_key");
  says(String() <- e, "api: 401 invalid_api_key: Incorrect API key provided", "api with status and code");
  e.code = String();
  says(String() <- e, "api: 401: Incorrect API key provided", "api with status only");
  done()
}
