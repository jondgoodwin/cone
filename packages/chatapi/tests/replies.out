basic:
  delta role=assistant
  delta text=[Hel]
  delta text=[lo]
  delta text=[ wor]
  delta text=[ld]
  delta finish=stop
  delta usage=5/4/9
  end of stream
  and nothing after
basic, no usage asked:
  delta role=assistant
  delta text=[Hel]
  delta text=[lo]
  delta text=[ wor]
  delta text=[ld]
  delta finish=stop
  end of stream
  and nothing after
split:
  delta role=assistant
  delta text=[Hel]
  delta text=[lo]
  delta text=[ wor]
  delta text=[ld]
  delta finish=stop
  delta usage=5/4/9
  end of stream
