keepalive:
  delta role=assistant
  delta text=[Hel]
  delta text=[lo]
  delta text=[ wor]
  delta text=[ld]
  delta finish=stop
  end of stream
  and nothing after
bad chunk:
  delta role=assistant
  delta text=[ok]
  error decode: a chunk: json: ... (chunk 3)
  and nothing after
error chunk:
  delta role=assistant
  error stream: The context length was exceeded (chunk 2)
  and nothing after
truncated:
  delta role=assistant
  delta text=[Hel]
  error stream: the stream ended before the reply was complete
  and nothing after
no [DONE]:
  delta role=assistant
  delta text=[Hi]
  delta finish=stop
  end of stream
  and nothing after
plain json:
  open failed:
  error decode: the server answered a streamed request with something that is not an event stream
rate limit:
  open failed:
  error api: 429 rate_limit_exceeded: Rate limit reached
silent, ended by a deadline:
  error timedout: deadline passed
  and nothing after
silent, ended by a cancel:
  error cancelled: cancelled
collect:
  id=chatcmpl-s1 model=mock-served role=assistant finish=stop text=[Hello world] usage=9
wrong key:
  open failed:
  error api: 401 invalid_api_key: Incorrect API key provided.
endless: deltas read before leaving: 2
endless: the server saw its reader leave: yes
end
