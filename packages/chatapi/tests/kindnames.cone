// The name of a chat error's kind, every variant, in lower case. Pinned so the text
// cannot drift when the way it is asked for changes.

mod kindnames;

import testing use *;
import chatapi use *;

fn kind(k: ChatErrorKind, want: &str, label: &str) {
  expectStr(k.name(), want, label);
}

fn main() i32 {
  kind(ChatErrorKind.NoKey, "nokey", "NoKey");
  kind(ChatErrorKind.Request, "request", "Request");
  kind(ChatErrorKind.Transport, "transport", "Transport");
  kind(ChatErrorKind.Cancelled, "cancelled", "Cancelled");
  kind(ChatErrorKind.TimedOut, "timedout", "TimedOut");
  kind(ChatErrorKind.Api, "api", "Api");
  kind(ChatErrorKind.Decode, "decode", "Decode");
  kind(ChatErrorKind.Stream, "stream", "Stream");
  done()
}
