// Whole replies, against a mock chat-completions server that this test runs on
// actorhttp's server, on 127.0.0.1 (no other host is asked anything). A Chat
// actor makes the calls. The mock checks what it is sent: the path, the method,
// the Authorization field (the key is a fake one the test puts in an
// environment variable), and it answers by the request's model: 'echo' sends
// the request body it got back as the reply's text, so the body is checked
// byte for byte; the others are canned answers, the API's errors, bodies that
// are no reply, and a server that never answers (ended by a deadline). Checked,
// in order: the echo and its fields; a wrong key (401); no key variable set and
// a request that cannot be written (nothing reaches the server: the mock counts
// what it saw); null content; a rate limit (429); an HTML 502; a 200 that is not
// JSON; a 200 with no choices; an error object in a 200; the connection
// refused; a deadline; three calls in flight at once through one Chat; and the
// same call made synchronously with httpclient, the request 'httpRequest' made
// and the reply 'replyOfResponse' read. No error message holds the key.

mod calls;

import stdio use *;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import time use Instant, Duration;
import iocore use SocketAddr, Loop;
import iobuf use Pool;
import http use *;
import httpclient;
import json;
import env;
import actors;
import actorhttp use Client, Server, ServerConfig, Exchange;
import aio use IoLimits;
import chatapi use *;

fn theKey() &str {"sk-test-chatapi-0001"}

// ---------------------------------------------------------------------------
// The mock server
// ---------------------------------------------------------------------------

fn errorBody(message &str, kind &str, code &str) String {
  var inner = json.Json.newObject();
  inner.set("message", json.Json.fromText(message));
  inner.set("type", json.Json.fromText(kind));
  inner.set("param", json.Json.Null);
  inner.set("code", json.Json.fromText(code));
  var o = json.Json.newObject();
  o.set("error", inner);
  textOf(&o)
}

fn textOf(j &json.Json) String {
  match j.toText() {
    case var t Ok {
      var s = String.empty();
      s <=> t;
      s
    }
    case let e Error {String.from("(unwritable)")}
  }
}

// A chat completion with one choice
fn completion(content json.Json, finish &str) String {
  var msg = json.Json.newObject();
  msg.set("role", json.Json.fromText("assistant"));
  msg.set("content", content);
  var choice = json.Json.newObject();
  choice.set("index", json.Json.fromI64(0i64));
  choice.set("message", msg);
  choice.set("finish_reason", json.Json.fromText(finish));
  var choices = json.Json.newArray();
  choices.push(choice);
  var usage = json.Json.newObject();
  usage.set("prompt_tokens", json.Json.fromI64(11i64));
  usage.set("completion_tokens", json.Json.fromI64(7i64));
  usage.set("total_tokens", json.Json.fromI64(18i64));
  var o = json.Json.newObject();
  o.set("id", json.Json.fromText("chatcmpl-mock"));
  o.set("object", json.Json.fromText("chat.completion"));
  o.set("created", json.Json.fromI64(1700000000i64));
  o.set("model", json.Json.fromText("mock-served"));
  o.set("choices", choices);
  o.set("usage", usage);
  textOf(&o)
}

// Answers one request
actor Handler {
  ex Exchange;
  hits Sender[u64];

  fn answer(self, status u16, body &str) {
    var head = ResponseHead.make(status);
    head.headers.add("Content-Type", "application/json");
    ex.respond(head, String.from(body));
  }

  pub async do run(self) {
    hits.send(1u64);
    let path = String.from(ex.request.path());
    if path.view() != "/v1/chat/completions" {
      ex.text(404u16, "no such path");
      return;
    }
    if ex.request.methodName() != "POST" {
      ex.text(405u16, "POST only");
      return;
    }
    let auth = String.fromBytes(ex.request.header("authorization"));
    var want = String.from("Bearer ");
    want.append(theKey());
    if auth.view() != want.view() {
      self.answer(401u16, errorBody("Incorrect API key provided.", "invalid_request_error", "invalid_api_key").view());
      return;
    }
    var doc json.Json = json.Json.Null;
    match json.parse(ex.request.body.view()) {
      case var ok Ok {doc <=> ok;}
      case let e Error {
        self.answer(400u16, errorBody("the body is not JSON", "invalid_request_error", "bad_body").view());
        return;
      }
    }
    var model = String.empty();
    match doc.getText("model") {
      case let s Some {model = String.from(s);}
      case is None {}
    }
    let m = model.view();
    if m == "echo" {
      self.answer(200u16, completion(json.Json.fromText(ex.request.body.view()), "stop").view());
    } elif m == "nullcontent" {
      self.answer(200u16, completion(json.Json.Null, "tool_calls").view());
    } elif m == "ratelimit" {
      self.answer(429u16, errorBody("Rate limit reached", "rate_limit_error", "rate_limit_exceeded").view());
    } elif m == "html502" {
      var head = ResponseHead.make(502u16);
      head.headers.add("Content-Type", "text/html");
      ex.respond(head, String.from("<html><body>Bad Gateway</body></html>"));
    } elif m == "garbage" {
      self.answer(200u16, "this is not json");
    } elif m == "nochoices" {
      self.answer(200u16, "{\"id\":\"x\",\"choices\":[]}");
    } elif m == "errorin200" {
      self.answer(200u16, "{\"error\":{\"message\":\"The server is overloaded\",\"type\":\"server_error\"}}");
    } else {
      self.answer(400u16, errorBody("unknown model", "invalid_request_error", "model_not_found").view());
    }
  }
}

// A request that is never answered, and kept so that it is not dropped (a dropped exchange is answered 500)
actor Silent {
  ex Exchange;
}

actor Acceptor {
  server Server;
  hits Sender[u64];
  held List[Silent];

  pub async do open(self, ports Sender[u16]) {
    let r = await actorhttp.listen(SocketAddr.localhost(0u16), ServerConfig.make());
    var res = r;
    match &mut res {
      case var ok &mut Ok {server <=> *ok;}
      case let e &mut Error {printStr("listen failed: "); printStr(e.message().view()); printStr("\n");}
    }
    ports.send(server.port());
  }

  pub async do serve(self) {
    while true {
      let n = await server.next();
      match n {
        case var ok Ok {self.route(ok);}
        case let e Error {break;}
      }
    }
  }

  pub async do stop(self) {
    server.close();
  }

  fn route(self, ex Exchange) {
    if ex.request.body.view().contains("\"model\":\"hang\"") {
      hits.send(1u64);
      held.push(new Silent(ex));
      return;
    }
    let h = new Handler(ex, hits.clone());
    h.run();
  }
}

// ---------------------------------------------------------------------------
// The client's side
// ---------------------------------------------------------------------------

fn baseUrl(port u16) String {
  var u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append("/v1");
  u
}

fn usageText(u &Option[Usage]) String {
  match u {
    case let x &Some {
      var s = String.empty();
      s.appendUInt(x.promptTokens);
      s.append("/");
      s.appendUInt(x.completionTokens);
      s.append("/");
      s.appendUInt(x.totalTokens);
      s
    }
    case is &None {String.from("none")}
  }
}

// What a call gave, on a line. An error message that holds the key is a failure of the package
fn show(label &str, r &Result[ChatReply, ChatError]) {
  printStr(label);
  printStr(": ");
  match r {
    case let ok &Ok {
      printStr("ok id=");
      printStr(ok.id.view());
      printStr(" model=");
      printStr(ok.model.view());
      printStr(" role=");
      printStr(ok.role.view());
      printStr(" finish=");
      printStr(ok.finishReason.view());
      printStr(" usage=");
      printStr(usageText(&ok.usage).view());
      printStr("\n");
    }
    case let e &Error {
      printStr("error ");
      if e.kind == ChatErrorKind.Transport {
        // The words after the stage are the system's own and differ between systems
        printStr("transport, at the connect stage: ");
        printStr(yes(e.message().view().startsWith("transport: connect: ")));
      } else {
        printStr(e.message().view());
      }
      if e.message().view().contains(theKey()) {printStr(" (THE KEY LEAKED)");}
      if e.isRetryable() {printStr(" (retryable)");}
      printStr("\n");
    }
  }
}

fn contentOf(r &Result[ChatReply, ChatError]) String {
  match r {
    case let ok &Ok {ok.content.copy()}
    case let e &Error {String.from("(none)")}
  }
}

fn echoRequest(model &str, text &str) ChatRequest {
  var r = ChatRequest.make(model);
  r.addSystem("You are a mock.");
  r.addUser(text);
  r.temperature = Some[f64](0.5d);
  r.maxTokens = Some[u64](50u64);
  r.addStop("END");
  r
}

fn simple(model &str) ChatRequest {
  var r = ChatRequest.make(model);
  r.addUser("hi");
  r
}

actor Prober {
  pub async do run(self, port u16, done OneshotSender[u64]) {
    env.set("CHATAPI_TEST_KEY", theKey());
    env.set("CHATAPI_TEST_WRONGKEY", "sk-wrong-key-9999");
    let chat = new Chat(Client.standard(), Endpoint.make(baseUrl(port).view(), "CHATAPI_TEST_KEY"));

    // The echo: the body the server saw comes back as the reply's text
    let echo = await chat.complete(echoRequest("echo", "Say \"hi\""));
    show("echo", &echo);
    printStr("  body: ");
    printStr(contentOf(&echo).view());
    printStr("\n");

    // A wrong key: 401 with the API's error object
    let wrong = new Chat(Client.standard(), Endpoint.make(baseUrl(port).view(), "CHATAPI_TEST_WRONGKEY"));
    let rwrongkey = await wrong.complete(simple("echo"));
    show("wrong key", &rwrongkey);

    // No key variable set; a request with no messages: neither is sent
    let nokey = new Chat(Client.standard(), Endpoint.make(baseUrl(port).view(), "CHATAPI_TEST_UNSET"));
    let rnokey = await nokey.complete(simple("echo"));
    show("no key", &rnokey);
    let rnomessages = await chat.complete(ChatRequest.make("echo"));
    show("no messages", &rnomessages);

    // A server that answers with each kind of thing
    let rnullcontent = await chat.complete(simple("nullcontent"));
    show("null content", &rnullcontent);
    let rratelimit = await chat.complete(simple("ratelimit"));
    show("rate limit", &rratelimit);
    let rhtml502 = await chat.complete(simple("html502"));
    show("html 502", &rhtml502);
    let rgarbage = await chat.complete(simple("garbage"));
    show("garbage", &rgarbage);
    let rnochoices = await chat.complete(simple("nochoices"));
    show("no choices", &rnochoices);
    let rerrorin200 = await chat.complete(simple("errorin200"));
    show("error in 200", &rerrorin200);
    let runknownmodel = await chat.complete(simple("nothing"));
    show("unknown model", &runknownmodel);

    // A deadline on a call the server never answers
    let lim = IoLimits.until(Instant.now() + Duration.fromMillis(400i64));
    let rdeadline = await chat.completeIn(simple("hang"), lim);
    show("deadline", &rdeadline);

    // Three calls in flight at once through one Chat
    let f1 = chat.complete(echoRequest("echo", "one"));
    let f2 = chat.complete(echoRequest("echo", "two"));
    let f3 = chat.complete(echoRequest("echo", "three"));
    let r3 = await f3;
    let r1 = await f1;
    let r2 = await f2;
    printStr("in flight: ");
    printStr(yes(contentOf(&r1).view().contains("\"one\"")));
    printStr(" ");
    printStr(yes(contentOf(&r2).view().contains("\"two\"")));
    printStr(" ");
    printStr(yes(contentOf(&r3).view().contains("\"three\"")));
    printStr("\n");

    var d = done;
    d.send(1u64);
  }

  pub async do refused(self, port u16, done OneshotSender[u64]) {
    let chat = new Chat(Client.standard(), Endpoint.make(baseUrl(port).view(), "CHATAPI_TEST_KEY"));
    let rrefused = await chat.complete(simple("echo"));
    show("refused", &rrefused);
    var d = done;
    d.send(1u64);
  }
}

fn yes(b bool) &str {if b {"yes"} else {"NO"}}

fn take[T](rx &mut Receiver[T], dflt T) T {
  match rx.recv() {
    case let v Some {v}
    else {dflt}
  }
}

fn main() i32 {
  initAll();
  var ptx Sender[u16];
  var prx Receiver[u16];
  ptx, prx = Channel[u16].make();
  var htx Sender[u64];
  var hrx Receiver[u64];
  htx, hrx = Channel[u64].make();
  {
    let acceptor = new Acceptor(Server.none(), htx.clone(), List[Silent].empty());
    acceptor.open(ptx.clone());
    let port = take[u16](&mut prx, 0u16);
    acceptor.serve();
    {
      var tx OneshotSender[u64];
      var rx OneshotReceiver[u64];
      tx, rx = Oneshot[u64].make();
      let p = new Prober();
      p.run(port, tx);
      rx.recv();
    }

    // The same call, synchronously: httpclient with the request the package made
    env.set("CHATAPI_TEST_KEY", theKey());
    let ep = Endpoint.make(baseUrl(port).view(), "CHATAPI_TEST_KEY");
    let req = echoRequest("echo", "sync");
    var hreq = httpclient.Request.get("");
    match httpRequest(&ep, &req, false) {
      case var ok Ok {hreq <=> ok;}
      case let e Error {printStr("sync: the request was not built\n");}
    }
    var lp = Loop.mustMake();
    var hc = httpclient.Client.make(httpclient.Config.make(), Pool.make());
    let resp = hc.fetchWhole(&mut lp, hreq, 1048576usize);
    let syncReply = replyOfResponse(&resp);
    show("sync", &syncReply);
    printStr("  body is the request: ");
    printStr(yes(contentOf(&syncReply).view().contains("\"sync\"")));
    printStr("\n");

    // The mock saw every request that was made, and none of the three that were not
    acceptor.stop();
    var seen = 0u64;
    var going = true;
    while going {
      match hrx.recvTimeout(Duration.fromMillis(100i64)) {
        case let n Some {seen = seen + n;}
        case is None[u64] {going = false;}
      }
    }
    printStr("requests the server saw: ");
    printUInt(seen);
    printStr("\n");

    // A server that is gone
    var ptx2 Sender[u16];
    var prx2 Receiver[u16];
    ptx2, prx2 = Channel[u16].make();
    let gone = new Acceptor(Server.none(), htx.clone(), List[Silent].empty());
    gone.open(ptx2.clone());
    let deadPort = take[u16](&mut prx2, 0u16);
    gone.stop();
    var tx OneshotSender[u64];
    var rx OneshotReceiver[u64];
    tx, rx = Oneshot[u64].make();
    let p2 = new Prober();
    p2.refused(deadPort, tx);
    rx.recv();
  }
  finalAll();
  printStr("end\n");
  0i32
}
