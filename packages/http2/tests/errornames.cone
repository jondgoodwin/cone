// The text of an error code, every code: the RFC's spelling, and "unknown" for one it
// does not define. Pinned so the text cannot drift when the way it is asked for changes.

mod errornames;

import testing use *;
import collections use String;
import http2 use *;

fn text(c: ErrorCode) String { String() <- toText(&c) }

fn main() i32 {
  expectStr(text(ErrorCode.NoError).view(), "NO_ERROR", "NoError");
  expectStr(text(ErrorCode.ProtocolError).view(), "PROTOCOL_ERROR", "ProtocolError");
  expectStr(text(ErrorCode.InternalError).view(), "INTERNAL_ERROR", "InternalError");
  expectStr(text(ErrorCode.FlowControlError).view(), "FLOW_CONTROL_ERROR", "FlowControlError");
  expectStr(text(ErrorCode.SettingsTimeout).view(), "SETTINGS_TIMEOUT", "SettingsTimeout");
  expectStr(text(ErrorCode.StreamClosed).view(), "STREAM_CLOSED", "StreamClosed");
  expectStr(text(ErrorCode.FrameSizeError).view(), "FRAME_SIZE_ERROR", "FrameSizeError");
  expectStr(text(ErrorCode.RefusedStream).view(), "REFUSED_STREAM", "RefusedStream");
  expectStr(text(ErrorCode.Cancel).view(), "CANCEL", "Cancel");
  expectStr(text(ErrorCode.CompressionError).view(), "COMPRESSION_ERROR", "CompressionError");
  expectStr(text(ErrorCode.ConnectError).view(), "CONNECT_ERROR", "ConnectError");
  expectStr(text(ErrorCode.EnhanceYourCalm).view(), "ENHANCE_YOUR_CALM", "EnhanceYourCalm");
  expectStr(text(ErrorCode.InadequateSecurity).view(), "INADEQUATE_SECURITY", "InadequateSecurity");
  expectStr(text(ErrorCode.Http11Required).view(), "HTTP_1_1_REQUIRED", "Http11Required");
  expectStr(text(ErrorCode.of(0x77u32)).view(), "unknown", "a code not defined");
  done()
}
