// The text of an error code, every code: the RFC's spelling, and "unknown" for one it
// does not define. Pinned so the text cannot drift when the way it is asked for changes.

mod errornames;

import testing use *;
import http2 use *;

fn main() i32 {
  expectStr(ErrorCode.NoError.name(), "NO_ERROR", "NoError");
  expectStr(ErrorCode.ProtocolError.name(), "PROTOCOL_ERROR", "ProtocolError");
  expectStr(ErrorCode.InternalError.name(), "INTERNAL_ERROR", "InternalError");
  expectStr(ErrorCode.FlowControlError.name(), "FLOW_CONTROL_ERROR", "FlowControlError");
  expectStr(ErrorCode.SettingsTimeout.name(), "SETTINGS_TIMEOUT", "SettingsTimeout");
  expectStr(ErrorCode.StreamClosed.name(), "STREAM_CLOSED", "StreamClosed");
  expectStr(ErrorCode.FrameSizeError.name(), "FRAME_SIZE_ERROR", "FrameSizeError");
  expectStr(ErrorCode.RefusedStream.name(), "REFUSED_STREAM", "RefusedStream");
  expectStr(ErrorCode.Cancel.name(), "CANCEL", "Cancel");
  expectStr(ErrorCode.CompressionError.name(), "COMPRESSION_ERROR", "CompressionError");
  expectStr(ErrorCode.ConnectError.name(), "CONNECT_ERROR", "ConnectError");
  expectStr(ErrorCode.EnhanceYourCalm.name(), "ENHANCE_YOUR_CALM", "EnhanceYourCalm");
  expectStr(ErrorCode.InadequateSecurity.name(), "INADEQUATE_SECURITY", "InadequateSecurity");
  expectStr(ErrorCode.Http11Required.name(), "HTTP_1_1_REQUIRED", "Http11Required");
  expectStr(ErrorCode.of(0x77u32).name(), "unknown", "a code not defined");
  done()
}
