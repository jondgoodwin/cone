// HPACK's primitives (RFC 7541, sections 5 and 6): the integer examples of
// Appendix C.1; integers through a round trip at every prefix width and at
// the edges of each (2^N - 2, 2^N - 1, 2^N, and maxInteger); integers
// refused, cut off and too large, including a run of continuation bytes
// that adds nothing; strings, raw and Huffman, out and back; strings
// refused, cut off and past their limit; the three literal patterns and the
// size update; and the static table's lookups.

mod wire;

import testing use *;
import collections use *;
import http2 use *;

fn hex(b: &Array[u8]) String {
  var s = String.empty();
  var i = 0usize;
  while i < b.len {
    s.appendHex(u64.from(b[i]), 2usize);
    i = i + 1usize;
  }
  s
}

fn nibble(c: u8) u8 {if c >= 'a' {c - 'a' + 10u8} else {c - '0'}}

fn unhex(s: &Array[u8]) List[u8] {
  var out = List[u8].empty();
  var i = 0usize;
  while i + 1usize < s.len {
    out.push((nibble(s[i]) << 4u8) | nibble(s[i + 1usize]));
    i = i + 2usize;
  }
  out
}

fn intHex(flags: u8, prefix: u32, v: u64) String {
  var out = List[u8].empty();
  encodeInteger(&mut out, flags, prefix, v);
  hex(out.view())
}

// What decoding 'coded' with this prefix says: the value and the bytes
// read, or the reason
fn readInt(coded: &str, prefix: u32) String {
  let src = unhex(coded);
  var pos = 0usize;
  var s = String.empty();
  match decodeInteger(src.view(), &mut pos, prefix) {
    case let Ok(v) {
      s.appendUInt(v);
      s.append(" in ");
      s.appendUInt(u64.from(pos));
    }
    case let Err(e) {s.append(e);}
  }
  s
}

fn integers() {
  // C.1.1, C.1.2, C.1.3; the bits above the prefix are the flags'
  expectStr(intHex(0u8, 5u32, 10u64).view(), "0a", "C.1.1: 10, 5-bit prefix");
  expectStr(intHex(0u8, 5u32, 1337u64).view(), "1f9a0a", "C.1.2: 1337, 5-bit prefix");
  expectStr(intHex(0u8, 8u32, 42u64).view(), "2a", "C.1.3: 42 from an octet boundary");
  expectStr(intHex(0xE0u8, 5u32, 10u64).view(), "ea", "10 under flags 111");
  expectStr(readInt("0a", 5u32).view(), "10 in 1", "C.1.1 read");
  expectStr(readInt("1f9a0a", 5u32).view(), "1337 in 3", "C.1.2 read");
  expectStr(readInt("ff9a0a", 5u32).view(), "1337 in 3", "C.1.2 read under flags");
  expectStr(readInt("2a", 8u32).view(), "42 in 1", "C.1.3 read");

  // Round trips at every width
  var wrong = 0u64;
  var prefix = 1u32;
  while prefix <= 8u32 {
    let edge = (1u64 << u64.from(prefix)) - 1u64;
    var vals = List[u64].empty();
    vals.push(0u64);
    vals.push(1u64);
    if edge >= 2u64 {vals.push(edge - 1u64);}
    vals.push(edge);
    vals.push(edge + 1u64);
    vals.push(edge + 127u64);
    vals.push(edge + 128u64);
    vals.push(1337u64);
    vals.push(65535u64);
    vals.push(1048576u64);
    vals.push(maxInteger);
    var k = 0usize;
    while k < vals.len() {
      let v = *vals[k];
      var out = List[u8].empty();
      encodeInteger(&mut out, 0u8, prefix, v);
      var pos = 0usize;
      match decodeInteger(out.view(), &mut pos, prefix) {
        case let Ok(got) {if got != v || pos != out.len() {wrong = wrong + 1u64;}}
        case let Err(e) {wrong = wrong + 1u64;}
      }
      k = k + 1usize;
    }
    prefix = prefix + 1u32;
  }
  expectUInt(wrong, 0u64, "integers through a round trip, prefixes 1 to 8");
  expectStr(intHex(0u8, 5u32, maxInteger).view(), "1fe0ffffff0f", "maxInteger, 5-bit prefix");

  // Refusals
  expectStr(readInt("", 5u32).view(), "an integer is cut off by the block's end", "no bytes");
  expectStr(readInt("1f", 5u32).view(), "an integer is cut off by the block's end", "the prefix full, nothing after");
  expectStr(readInt("1f9a", 5u32).view(), "an integer is cut off by the block's end", "a continuation bit, nothing after");
  expectStr(readInt("1fe1ffffff0f", 5u32).view(), "an integer is too large", "maxInteger + 1");
  expectStr(readInt("1fffffffff7f", 5u32).view(), "an integer is too large", "far past maxInteger");
  expectStr(readInt("1f808080808000", 5u32).view(), "an integer is too large", "six continuation bytes adding nothing");
  expectStr(readInt("1f8080808000", 5u32).view(), "31 in 6", "five continuation bytes adding nothing");
}

// What decoding a string says: its bytes and the bytes read, or the reason
fn readString(coded: &str, limit: usize) String {
  let src = unhex(coded);
  var pos = 0usize;
  var out = List[u8].empty();
  var why = "";
  let st = decodeString(src.view(), &mut pos, limit, &mut out, &mut why);
  var s = String.empty();
  if st == StringStatus.Done {
    s.append("\"");
    s.appendBytes(out.view());
    s.append("\" in ");
    s.appendUInt(u64.from(pos));
  } else if st == StringStatus.TooLong {
    s.append("too long, ");
    s.appendUInt(u64.from(out.len()));
    s.append(" copied");
  } else {
    s.append(why);
  }
  s
}

fn strings() {
  var out = List[u8].empty();
  encodeString(&mut out, "custom-key", false);
  expectStr(hex(out.view()).view(), "0a637573746f6d2d6b6579", "raw");
  out.clear();
  encodeString(&mut out, "custom-key", true);
  expectStr(hex(out.view()).view(), "8825a849e95ba97d7f", "Huffman (C.4.3)");
  out.clear();
  encodeString(&mut out, "", true);
  expectStr(hex(out.view()).view(), "00", "empty: raw even when Huffman is asked");
  out.clear();
  encodeString(&mut out, "{}{}", true);
  expectStr(hex(out.view()).view(), "047b7d7b7d", "raw where Huffman is longer");

  expectStr(readString("0a637573746f6d2d6b6579", 100usize).view(), "\"custom-key\" in 11", "raw read");
  expectStr(readString("8825a849e95ba97d7f", 100usize).view(), "\"custom-key\" in 9", "Huffman read");
  expectStr(readString("00", 100usize).view(), "\"\" in 1", "empty");
  expectStr(readString("", 100usize).view(), "a string is cut off by the block's end", "no bytes");
  expectStr(readString("7f", 100usize).view(), "an integer is cut off by the block's end", "a length cut off");
  expectStr(readString("0a6375", 100usize).view(), "a string's length runs past the block's end", "raw, cut off");
  expectStr(readString("8825a8", 100usize).view(), "a string's length runs past the block's end", "Huffman, cut off");
  expectStr(readString("0a637573746f6d2d6b6579", 9usize).view(), "too long, 0 copied", "raw past the limit: nothing copied");
  expectStr(readString("8825a849e95ba97d7f", 9usize).view(), "too long, 9 copied", "Huffman past the limit: stops at it");
  expectStr(readString("81ff", 100usize).view(), "a Huffman string's padding is longer than 7 bits or not all ones", "Huffman padding");
  expectStr(readString("84ffffffff", 100usize).view(), "a Huffman string holds the EOS symbol", "Huffman EOS");
}

fn representations() {
  var out = List[u8].empty();
  encodeIndexed(&mut out, 2usize);
  expectStr(hex(out.view()).view(), "82", "indexed 2");
  out.clear();
  encodeIndexed(&mut out, 200usize);
  expectStr(hex(out.view()).view(), "ff49", "indexed 200");
  out.clear();
  encodeLiteral(&mut out, Indexing.Incremental, 0usize, "a", "b", false);
  expectStr(hex(out.view()).view(), "4001610162", "incremental, new name");
  out.clear();
  encodeLiteral(&mut out, Indexing.Without, 4usize, ":path", "/", false);
  expectStr(hex(out.view()).view(), "04012f", "without indexing, name 4");
  out.clear();
  encodeLiteral(&mut out, Indexing.Never, 23usize, "authorization", "x", false);
  expectStr(hex(out.view()).view(), "1f080178", "never indexed, name 23");
  out.clear();
  encodeSizeUpdate(&mut out, 0usize);
  encodeSizeUpdate(&mut out, 4096usize);
  expectStr(hex(out.view()).view(), "203fe11f", "size updates to 0 and 4096");

  // The static table
  expectStr(staticName(1usize), ":authority", "static 1");
  expectStr(staticName(61usize), "www-authenticate", "static 61");
  expectStr(staticValue(16usize), "gzip, deflate", "static 16's value");
  let get = staticFind(":method", "GET");
  expectUInt(u64.from(get.index), 2u64, ":method GET");
  expect(get.exact, ":method GET is whole");
  let put = staticFind(":method", "PUT");
  expectUInt(u64.from(put.index), 2u64, ":method PUT names 2");
  expect(!put.exact, ":method PUT is the name only");
  let st = staticFind(":status", "404");
  expectUInt(u64.from(st.index), 13u64, ":status 404");
  expectUInt(u64.from(staticFind("x-custom", "1").index), 0u64, "a name not there");
  expectUInt(u64.from(staticFind("Cookie", "1").index), 0u64, "names are matched exactly");
}

fn main() i32 {
  integers();
  strings();
  representations();
  done()
}
