// The one line each error of this package gives a person is pinned here, with the
// number fields in play, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use String;
import http2 use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- HpackError.make(HpackErrorKind.Malformed, "an index of 0"), "malformed: an index of 0", "hpack malformed");
  says(String() <- HpackError.make(HpackErrorKind.TooLarge, "the list is long"), "too large: the list is long", "hpack too large");
  says(String() <- FrameError(ErrorCode.Unknown(255u32), Scope.Stream, 7u32, 0usize, "a frame"), "unknown 0xff on stream 7: a frame", "unknown code on a stream");
  says(String() <- FrameError(ErrorCode.Unknown(7u32), Scope.Stream, 7u32, 0usize, "a frame"), "unknown 0x7 on stream 7: a frame", "unknown code of one digit");
  says(String() <- FrameError(ErrorCode.Unknown(4294967295u32), Scope.Connection, 0u32, 0usize, "a frame"), "unknown 0xffffffff on the connection: a frame", "largest unknown code");
  says(String() <- FrameError(ErrorCode.ProtocolError, Scope.Connection, 0u32, 0usize, "a DATA frame on stream 0"), "PROTOCOL_ERROR on the connection: a DATA frame on stream 0", "a connection error");
  done()
}
