// ======== The Huffman code of RFC 7541, Appendix B ========
//
// HPACK's static Huffman code, which HTTP/3's QPACK uses too (RFC 9204,
// section 4.1.2): a canonical code of 257 symbols, the 256 byte values and
// EOS, each 5 to 30 bits long. Nothing here knows of HPACK's tables or of a
// header block; the functions take bytes and give bytes, so another
// compressor uses them as they are.
//
// Encoding packs each byte's code most significant bit first and pads the
// last byte with the high bits of EOS, which are all ones (section 5.2).
// Decoding is the canonical code's walk: the next 32 bits of input, read
// as a number, fall below the first code of exactly one length, and that
// length's codes are consecutive numbers, so the symbol is found by
// subtraction. Common bytes have the shortest codes, so most symbols are
// found at the first or second length tried. The decoder refuses what
// section 5.2 refuses: padding longer than 7 bits, padding that is not the
// high bits of EOS, and EOS itself inside a string.

mod huffman;

import collections use List;

// How decoding a string ended
pub enum HuffmanStatus {
  Done,         // every symbol decoded, the padding as it must be
  BadPadding,   // more than 7 bits of padding, or padding not all ones
  HasEos,       // the EOS symbol inside the string
  TooLong       // the output would pass the limit asked for
}

// Why a decoding failed, one line; "" for Done
pub fn huffmanWhy(s: HuffmanStatus) &str {
  if s == HuffmanStatus.BadPadding {"a Huffman string's padding is longer than 7 bits or not all ones"}
  else if s == HuffmanStatus.HasEos {"a Huffman string holds the EOS symbol"}
  else if s == HuffmanStatus.TooLong {"a Huffman string decodes past the limit"}
  else {""}
}

// How many bytes the Huffman coding of s takes
pub fn huffmanEncodedLen(s: &Array[u8]) usize {
  var bits = 0u64;
  var i = 0usize;
  while i < s.len {
    bits = bits + u64.from(huffLen[usize.from(s[i])]);
    i = i + 1usize;
  }
  usize.from((bits + 7u64) >> 3u64)
}

// Append the Huffman coding of s to out
pub fn huffmanEncode(s: &Array[u8], out: &mut List[u8]) {
  var acc = 0u64;           // the bits not yet written, in its low 'n' bits
  var n = 0u64;
  var i = 0usize;
  while i < s.len {
    let c = usize.from(s[i]);
    let len = u64.from(huffLen[c]);
    acc = (acc << len) | u64.from(huffCode[c]);
    n = n + len;
    while n >= 8u64 {
      n = n - 8u64;
      out.push(u8.from(acc >> n));
    }
    i = i + 1usize;
  }
  if n > 0u64 {
    // The padding: EOS's first bits, all ones
    out.push(u8.from(acc << (8u64 - n)) | u8.from(0xFFu64 >> n));
  }
}

// Append the bytes the Huffman string src decodes to onto out, at most
// limit of them: Done, or why not. On a failure, out holds what was decoded
// before it
pub fn huffmanDecode(src: &Array[u8], out: &mut List[u8], limit: usize) HuffmanStatus {
  var acc = 0u64;           // input bits not yet decoded, in its low 'n' bits
  var n = 0u64;
  var i = 0usize;
  var written = 0usize;
  while true {
    while n <= 56u64 && i < src.len {
      acc = (acc << 8u64) | u64.from(src[i]);
      n = n + 8u64;
      i = i + 1usize;
    }
    if n == 0u64 {return HuffmanStatus.Done;}
    // The next 32 bits, left-aligned; zeros past the input's end
    let w = if n >= 32u64 {(acc >> (n - 32u64)) & 0xFFFFFFFFu64} else {(acc << (32u64 - n)) & 0xFFFFFFFFu64};
    var k = 0usize;
    while w >= huffLimit[k] {k = k + 1usize;}
    let len = u64.from(huffLenOf[k]);
    if len > n {
      // The input is spent (the loop above keeps more than 30 bits while
      // there is any), and what is left is no whole code: it must be
      // padding, at most 7 bits, all ones
      if n > 7u64 {return HuffmanStatus.BadPadding;}
      let mask = (1u64 << n) - 1u64;
      if (acc & mask) != mask {return HuffmanStatus.BadPadding;}
      return HuffmanStatus.Done;
    }
    let code = w >> (32u64 - len);
    let sym = huffSorted[usize.from(huffOffset[k]) + usize.from(code - u64.from(huffFirst[k]))];
    if sym == 256u16 {return HuffmanStatus.HasEos;}
    if written >= limit {return HuffmanStatus.TooLong;}
    out.push(u8.from(sym));
    written = written + 1usize;
    n = n - len;
    acc = acc & ((1u64 << n) - 1u64);
  }
  HuffmanStatus.Done
}

// ---------------------------------------------------------------------------
// The tables, from RFC 7541 Appendix B
// ---------------------------------------------------------------------------

