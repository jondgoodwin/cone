// GPT-2's byte to character table. The expected table is made here by the
// algorithm GPT-2's encoder.py gives ('bytes_to_unicode': the printable bytes
// map to themselves and the other 68, in order, to 256 and up), written as that
// source writes it and not as the package computes it; and spot values that are
// well known (a space is 'Ġ', a line feed 'Ċ').

mod bytemap;

import testing use *;
import collections use *;
import bpetokenize;

// A code point below 0x800, in UTF-8
fn utf8Of(cp u32, out &mut List[u8]) {
  if cp < 0x80u32 { out.push(u8.from(cp)); }
  else {
    out.push(0xC0u8 | u8.from(cp >> 6u32));
    out.push(0x80u8 | u8.from(cp & 0x3Fu32));
  }
}

fn main() i32 {
  // GPT-2's algorithm: bs holds the bytes that stay, then the others are appended
  mut bs = List[u32].empty();
  mut cs = List[u32].empty();
  mut c = 33u32;
  while c <= 126u32 { bs.push(c); cs.push(c); c = c + 1u32; }
  c = 161u32;
  while c <= 172u32 { bs.push(c); cs.push(c); c = c + 1u32; }
  c = 174u32;
  while c <= 255u32 { bs.push(c); cs.push(c); c = c + 1u32; }
  mut n = 0u32;
  mut b = 0u32;
  while b < 256u32 {
    mut present = false;
    mut k = 0usize;
    while k < bs.len() { if bs.view()[k] == b { present = true; } k = k + 1usize; }
    if not present {
      bs.push(b);
      cs.push(256u32 + n);
      n = n + 1u32;
    }
    b = b + 1u32;
  }
  expectUInt(u64.from(bs.len()), 256u64, "the table has 256 entries");
  expectUInt(u64.from(n), 68u64, "68 bytes move");

  // every byte's spelling is the table's character, in UTF-8
  mut all = true;
  mut i = 0usize;
  while i < 256usize {
    mut one = List[u8].empty();
    one.push(u8.from(bs.view()[i]));
    imm spelt = bpetokenize.toByteLevel(one.view());
    mut want = List[u8].empty();
    utf8Of(cs.view()[i], &mut want);
    if not (spelt.view() == want.view()) { all = false; }
    i = i + 1usize;
  }
  expect(all, "all 256 bytes are spelt as GPT-2's table has them");

  // well-known values
  imm space = bpetokenize.toByteLevel(" ");
  expectStr(space.view(), "Ġ", "a space is U+0120");
  imm lf = bpetokenize.toByteLevel("\n");
  expectStr(lf.view(), "Ċ", "a line feed is U+010A");
  imm tab = bpetokenize.toByteLevel("\t");
  expectStr(tab.view(), "ĉ", "a tab is U+0109");
  imm word = bpetokenize.toByteLevel("hi there");
  expectStr(word.view(), "hiĠthere", "hi there");
  imm eacute = bpetokenize.toByteLevel("é");
  expectStr(eacute.view(), "Ã©", "é is its two UTF-8 bytes, C3 and A9, spelt as characters");

  // the inverse, for the whole table in one text
  mut every = List[u8].empty();
  b = 0u32;
  while b < 256u32 { every.push(u8.from(b)); b = b + 1u32; }
  imm spelt = bpetokenize.toByteLevel(every.view());
  // 94 bytes (33 to 126) are one UTF-8 byte, the other 162 are two
  expectUInt(u64.from(spelt.len()), 418u64, "length of the spelling");
  imm back = bpetokenize.fromByteLevel(spelt.view());
  expectStr(back.view(), every.view(), "fromByteLevel inverts toByteLevel on every byte");

  // characters the table has no byte for are copied through, and so is a byte
  // that is no UTF-8
  imm emoji = bpetokenize.fromByteLevel("😀");
  expectStr(emoji.view(), "😀", "a character outside the table is copied");
  mut raw = List[u8].empty();
  raw.push(0xFFu8); raw.push('a'); raw.push(0xC3u8);
  imm rawBack = bpetokenize.fromByteLevel(raw.view());
  expectStr(rawBack.view(), raw.view(), "bytes that are no UTF-8 are copied");
  imm none = bpetokenize.fromByteLevel("");
  expectUInt(u64.from(none.len()), 0u64, "fromByteLevel of nothing");
  imm noneBack = bpetokenize.toByteLevel("");
  expectUInt(u64.from(noneBack.len()), 0u64, "toByteLevel of nothing");

  done();
}
