// Merging by rank, with hand-built vocabularies whose ids can be worked out on
// paper. The first vocabulary ('hello world'): the 256 byte tokens are ids 0 to
// 255 in byte order ('a' is 97), and ten merges make ids 256 and up in the
// order of their ranks:
//
//   rank 0 'h e'      -> 256 'he'          rank 5 'o r'      -> 261 'or'
//   rank 1 'l l'      -> 257 'll'          rank 6 'Ġw or'    -> 262 'Ġwor'
//   rank 2 'he ll'    -> 258 'hell'        rank 7 'l d'      -> 263 'ld'
//   rank 3 'hell o'   -> 259 'hello'       rank 8 'Ġwor ld'  -> 264 'Ġworld'
//   rank 4 'Ġ w'      -> 260 'Ġw'          rank 9 'a a'      -> 265 'aa'
//
// ('Ġ' is how a vocabulary spells a space.) Then a rule list in which the
// parts of a rule are made by a later rule (the one case in which this
// algorithm and GPT-2's loop differ), long words, and a comparison against a
// plain, slow merger written here, over vocabularies and words made by a
// pseudo-random sequence.

mod merges;

import testing use *;
import collections use *;
import bpetokenize;

// -------- a vocabulary to build --------

struct Spec {
  tokens List[String];
  merges List[String];
  special List[String];
}

fn byteTokens() List[String] {
  mut tokens = List[String].empty();
  mut b = 0u32;
  while b < 256u32 {
    mut one = List[u8].empty();
    one.push(u8.from(b));
    tokens.push(bpetokenize.toByteLevel(one.view()));
    b = b + 1u32;
  }
  tokens;
}

// The vocabulary text of plain text: a space is 'Ġ'
fn spell(plain &str) String { bpetokenize.toByteLevel(plain); }

// A merge line from two plain texts
fn rule(left &str, right &str) String {
  mut s = spell(left);
  s.append(" ");
  s.append(spell(right).view());
  s;
}

fn helloSpec() Spec {
  mut tokens = byteTokens();
  tokens.push(spell("he"));
  tokens.push(spell("ll"));
  tokens.push(spell("hell"));
  tokens.push(spell("hello"));
  tokens.push(spell(" w"));
  tokens.push(spell("or"));
  tokens.push(spell(" wor"));
  tokens.push(spell("ld"));
  tokens.push(spell(" world"));
  tokens.push(spell("aa"));
  mut merges = List[String].empty();
  merges.push(rule("h", "e"));
  merges.push(rule("l", "l"));
  merges.push(rule("he", "ll"));
  merges.push(rule("hell", "o"));
  merges.push(rule(" ", "w"));
  merges.push(rule("o", "r"));
  merges.push(rule(" w", "or"));
  merges.push(rule("l", "d"));
  merges.push(rule(" wor", "ld"));
  merges.push(rule("a", "a"));
  new Spec(tokens, merges, List[String].empty());
}

// -------- showing ids --------

fn show(ids &List[u32]) String {
  mut out = String.empty();
  mut i = 0usize;
  while i < ids.len() {
    if i > 0usize { out.append(" "); }
    out.appendUInt(u64.from(ids.view()[i]));
    i = i + 1usize;
  }
  out;
}

fn ids(tok &bpetokenize.Tokenizer, text &str, want &str) {
  imm got = tok.encode(text);
  imm shown = show(&got);
  expectStr(shown.view(), want, text);
  // and the ids decode to the text
  match tok.decode(got.view()) {
    case imm bytes Ok { expectStr(bytes.view(), text, "decode back"); }
    case imm e Error { imm m = e.message(); expectStr(m.view(), "<decoded>", text); }
  }
}

// -------- the hand-worked cases --------

fn helloChecks(tok &bpetokenize.Tokenizer) {
  ids(tok, "", "");
  ids(tok, "h", "104");
  ids(tok, "xyz", "120 121 122");
  // h e l l o: 'h e' (rank 0), 'l l' (1), 'he ll' (2), 'hell o' (3)
  ids(tok, "hello", "259");
  ids(tok, "hell", "258");
  // h e l o: only 'h e' applies
  ids(tok, "helo", "256 108 111");
  // 'Ġ w' (4), 'o r' (5), 'Ġw or' (6), 'l d' (7), 'Ġwor ld' (8)
  ids(tok, "hello world", "259 264");
  // without the space: w o r l d -> 'o r' (5), then 'l d' (7)
  ids(tok, "world", "119 261 263");
  ids(tok, " world", "264");
  ids(tok, "hello  world", "259 32 264");
  // 'a a' ties with itself everywhere in a word of a's: the leftmost goes first
  ids(tok, "aa", "265");
  ids(tok, "aaa", "265 97");
  ids(tok, "aaaa", "265 265");
  ids(tok, "aaaaa", "265 265 97");
  ids(tok, "llll", "257 257");
  // a word is cut before it is merged: 'hello' and 'world' do not join
  ids(tok, "helloworld", "259 119 261 263");
  expectUInt(u64.from(tok.vocabSize()), 266u64, "vocabulary size");
  expectUInt(u64.from(tok.mergeCount()), 10u64, "merge rules");
  expectUInt(u64.from(tok.byteToken(97u8)), 97u64, "the token of a byte");
  match tok.tokenId(spell(" world").view()) {
    case imm id Some { expectUInt(u64.from(id), 264u64, "tokenId of ' world'"); }
    case is None { expect(false, "tokenId of ' world'"); }
  }
  match tok.tokenId("nothing here") {
    case is Some { expect(false, "tokenId of a text not in the vocabulary"); }
    case is None { expect(true, "tokenId of a text not in the vocabulary"); }
  }
  match tok.tokenBytes(264u32) {
    case imm bytes Some { expectStr(bytes, " world", "tokenBytes of 264"); }
    case is None { expect(false, "tokenBytes of 264"); }
  }
  match tok.tokenBytes(266u32) {
    case is Some { expect(false, "tokenBytes outside the vocabulary"); }
    case is None { expect(true, "tokenBytes outside the vocabulary"); }
  }
}

// The same vocabulary with no cut: one word for the whole text, so a merge may
// span what GPT-2 would have cut between
fn wholeChecks(tok &bpetokenize.Tokenizer) {
  ids(tok, "hello world", "259 264");
  ids(tok, "hello  world", "259 32 264");
  ids(tok, "x", "120");
}

// -------- parts made by a later rule --------

// Rule 0 joins 'bc' and 'b', but 'bc' is made only by rule 1. In 'bcbc' the
// pair 'b c' (rank 1) is at places 0 and 2; merging the first makes 'bc' next to
// a 'b', which rule 0 takes before the second 'b c'. The result is 'bcb', 'c'.
// GPT-2's own loop merges both 'b c' pairs at once and gets 'bc', 'bc'; trained
// vocabularies never have a rule whose parts a later rule makes, so the two
// agree on them, and this is the documented difference in a synthetic list.
fn laterRuleChecks() {
  mut tokens = byteTokens();
  tokens.push(spell("bc"));
  tokens.push(spell("bcb"));
  mut merges = List[String].empty();
  merges.push(rule("bc", "b"));
  merges.push(rule("b", "c"));
  match bpetokenize.Tokenizer.build(tokens.view(), merges.view(), List[String].empty().view(),
                                    bpetokenize.PreTokenizer.Whole) {
    case imm tok Ok {
      ids(&tok, "bcbc", "257 99");
      ids(&tok, "bc", "256");
      ids(&tok, "bcb", "257");
      ids(&tok, "cbc", "99 256");
    }
    case imm e Error { imm m = e.message(); expectStr(m.view(), "<built>", "later rule vocabulary"); }
  }
}

// -------- long words --------

// 'a' merges to 2, 4, 8, ... 1024 a's: a word of n a's ends as the binary digits of n
fn doublingChecks() {
  mut tokens = byteTokens();
  mut merges = List[String].empty();
  mut width = 1usize;
  mut k = 0usize;
  while k < 10usize {
    mut left = String.empty();
    mut j = 0usize;
    while j < width { left.append("a"); j = j + 1usize; }
    merges.push(rule(left.view(), left.view()));
    mut joined = String.from(left.view());
    joined.append(left.view());
    tokens.push(spell(joined.view()));
    width = width * 2usize;
    k = k + 1usize;
  }
  match bpetokenize.Tokenizer.build(tokens.view(), merges.view(), List[String].empty().view(),
                                    bpetokenize.PreTokenizer.Whole) {
    case imm tok Ok {
      // ids 256 + k is 2^(k+1) a's
      ids(&tok, "aaaa", "257");
      mut text = String.empty();
      mut i = 0usize;
      while i < 4096usize { text.append("a"); i = i + 1usize; }
      imm four = tok.encode(text.view());
      imm shown = show(&four);
      expectStr(shown.view(), "265 265 265 265", "4096 a's are four tokens of 1024");
      // 3000 = 2048 + 512 + 256 + 128 + 32 + 16 + 8, but the largest token is 1024:
      // 1024 + 1024 + 512 + 256 + 128 + 32 + 16 + 8
      mut t3 = String.empty();
      i = 0usize;
      while i < 3000usize { t3.append("a"); i = i + 1usize; }
      imm three = tok.encode(t3.view());
      imm shown3 = show(&three);
      expectStr(shown3.view(), "265 265 264 263 262 260 259 258", "3000 a's");
      // a long word merges in step: 200000 a's
      mut big = String.empty();
      i = 0usize;
      while i < 200000usize { big.append("a"); i = i + 1usize; }
      imm many = tok.encode(big.view());
      // 195 tokens of 1024 (199680 a's) and the 320 left: 256 + 64
      expectUInt(u64.from(many.len()), 197u64, "200000 a's: 195 + 2 tokens");
      match tok.decode(many.view()) {
        case imm bytes Ok { expect(bytes.len() == 200000usize, "200000 a's decode to 200000 bytes"); }
        case imm e Error { imm m = e.message(); expectStr(m.view(), "<decoded>", "big decode"); }
      }
    }
    case imm e Error { imm m = e.message(); expectStr(m.view(), "<built>", "doubling vocabulary"); }
  }
}

// -------- against a plain merger --------

// A pseudo-random sequence (a 64-bit LCG, the high bits)
struct Lcg {
  state u64;

  fn next(self &mut) u32 {
    state = state * 6364136223846793005u64 + 1442695040888963407u64;
    u32.from(state >> 33u64);
  }

  fn below(self &mut, n u32) u32 { self.next() % n; }
}

// Merge a word as the algorithm is stated: while some adjacent pair has a rule,
// join the one with the lowest rank, the leftmost of equals
fn plainMerge(word &Array[u8], ranks &Dict[u64, u64]) List[u32] {
  mut sym = List[u32].empty();
  mut i = 0usize;
  while i < word.len { sym.push(u32.from(word[i])); i = i + 1usize; }
  while true {
    mut best = 0xFFFFFFFFu64;
    mut at = 0usize;
    mut found = false;
    mut k = 0usize;
    while k + 1usize < sym.len() {
      imm key = (u64.from(sym.view()[k]) << 32u64) | u64.from(sym.view()[k + 1usize]);
      match ranks.getCopy(&key) {
        case imm v Some {
          imm rank = v >> 32u64;
          if rank < best { best = rank; at = k; found = true; }
        }
        case is None { }
      }
      k = k + 1usize;
    }
    if not found { break; }
    imm key = (u64.from(sym.view()[at]) << 32u64) | u64.from(sym.view()[at + 1usize]);
    imm made = u32.from(ranks[&key] & 0xFFFFFFFFu64);
    sym.set(at, made);
    // remove at + 1
    mut j = at + 1usize;
    while j + 1usize < sym.len() { sym.set(j, sym.view()[j + 1usize]); j = j + 1usize; }
    sym.truncate(sym.len() - 1usize);
  }
  sym;
}

fn randomChecks(seed u64, wordLetters u32, merges usize) {
  mut rng = new Lcg(seed);
  mut tokens = byteTokens();
  // each token's plain text, to name a new token and to keep texts distinct
  mut texts = List[String].empty();
  mut b = 0u32;
  while b < 256u32 {
    mut one = List[u8].empty();
    one.push(u8.from(b));
    texts.push(String.fromBytes(one.view()));
    b = b + 1u32;
  }
  mut seen = Dict[String, u32].deterministic();
  mut b2 = 0usize;
  while b2 < 256usize { seen.insert(texts.view()[b2].copy(), u32.from(b2)); b2 = b2 + 1usize; }
  mut lines = List[String].empty();
  mut ranks = Dict[u64, u64].deterministic();
  mut tries = 0usize;
  while lines.len() < merges and tries < merges * 40usize {
    tries = tries + 1usize;
    // parts: one of the letters a..(a+wordLetters) or a token made so far
    mut l = 97u32 + rng.below(wordLetters);
    mut r = 97u32 + rng.below(wordLetters);
    if texts.len() > 256usize and rng.below(4u32) != 0u32 {
      l = 256u32 + rng.below(u32.from(texts.len() - 256usize));
    }
    if texts.len() > 256usize and rng.below(4u32) != 0u32 {
      r = 256u32 + rng.below(u32.from(texts.len() - 256usize));
    }
    mut joined = texts.view()[usize.from(l)].copy();
    joined.append(texts.view()[usize.from(r)].view());
    if seen.contains(joined.view()) { continue; }
    imm key = (u64.from(l) << 32u64) | u64.from(r);
    if ranks.contains(&key) { continue; }
    imm id = u32.from(texts.len());
    imm rank = u64.from(lines.len());
    ranks.insert(key, (rank << 32u64) | u64.from(id));
    seen.insert(joined.copy(), id);
    tokens.push(spell(joined.view()));
    mut line = spell(texts.view()[usize.from(l)].view());
    line.append(" ");
    line.append(spell(texts.view()[usize.from(r)].view()).view());
    lines.push(line);
    texts.push(joined);
  }
  expect(lines.len() >= merges / 2usize, "enough random merges were made");
  match bpetokenize.Tokenizer.build(tokens.view(), lines.view(), List[String].empty().view(),
                                    bpetokenize.PreTokenizer.Whole) {
    case imm tok Ok {
      mut agree = 0usize;
      mut n = 0usize;
      while n < 400usize {
        imm len = 1u32 + rng.below(40u32);
        mut word = List[u8].empty();
        mut j = 0u32;
        while j < len { word.push(u8.from(97u32 + rng.below(wordLetters))); j = j + 1u32; }
        imm want = plainMerge(word.view(), &ranks);
        imm got = tok.encode(word.view());
        imm a = show(&want);
        imm c = show(&got);
        if a.view() == c.view() { agree = agree + 1usize; }
        else { expectStr(c.view(), a.view(), String.from(word.view() as &str).view()); }
        n = n + 1usize;
      }
      expectUInt(u64.from(agree), 400u64, "400 random words merge as the plain merger does");
    }
    case imm e Error { imm m = e.message(); expectStr(m.view(), "<built>", "random vocabulary"); }
  }
}

fn main() i32 {
  imm spec = helloSpec();
  match bpetokenize.Tokenizer.build(spec.tokens.view(), spec.merges.view(), spec.special.view(),
                                    bpetokenize.PreTokenizer.Gpt2) {
    case imm tok Ok { helloChecks(&tok); }
    case imm e Error { imm m = e.message(); expectStr(m.view(), "<built>", "hello vocabulary"); }
  }
  match bpetokenize.Tokenizer.build(spec.tokens.view(), spec.merges.view(), spec.special.view(),
                                    bpetokenize.PreTokenizer.Whole) {
    case imm tok Ok { wholeChecks(&tok); }
    case imm e Error { imm m = e.message(); expectStr(m.view(), "<built>", "hello vocabulary, whole"); }
  }
  // the pairs form builds the same tokenizer
  mut pairs = List[bpetokenize.MergePair].empty();
  pairs.push(new bpetokenize.MergePair(spell("h"), spell("e")));
  pairs.push(new bpetokenize.MergePair(spell("l"), spell("l")));
  pairs.push(new bpetokenize.MergePair(spell("he"), spell("ll")));
  pairs.push(new bpetokenize.MergePair(spell("hell"), spell("o")));
  match bpetokenize.Tokenizer.buildPairs(spec.tokens.view(), pairs.view(), spec.special.view(),
                                         bpetokenize.PreTokenizer.Gpt2) {
    case imm tok Ok {
      ids(&tok, "hello", "259");
      expectUInt(u64.from(tok.mergeCount()), 4u64, "merge rules from pairs");
    }
    case imm e Error { imm m = e.message(); expectStr(m.view(), "<built>", "pairs"); }
  }
  laterRuleChecks();
  doublingChecks();
  randomChecks(1u64, 3u32, 90usize);
  randomChecks(2u64, 2u32, 60usize);
  randomChecks(3u64, 4u32, 150usize);
  done();
}
