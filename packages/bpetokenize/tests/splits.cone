// The pre-tokenizer's cuts. The corpus is cut by the three published expressions
// (GPT-2's, Llama 3's and Qwen 2's) and the expected pieces were made by a
// regular-expression engine that is not this package (Python's 're', with the
// expressions' \p{L}, \p{N} and \s written out as the same character classes
// this package lists, for the characters in the corpus: ASCII, Latin-1,
// Cyrillic, Japanese, Chinese, emoji and the white space of U+00A0 and U+3000).
// A piece is shown between '|' marks. Then cases the engine cannot make: bytes
// that are not UTF-8, the empty text, the whole-text mode, and the invariants
// every cut keeps (the pieces are the text, none empty).

mod splits;

import testing use *;
import collections use *;
import bpetokenize;

fn pieces(mode &bpetokenize.PreTokenizer, text &Array[u8]) String {
  imm ends = bpetokenize.pieceEnds(mode, text);
  mut out = String.empty();
  mut start = 0usize;
  mut i = 0usize;
  while i < ends.len() {
    imm end = ends.view()[i];
    if i > 0usize { out.append("|"); }
    out.appendBytes(&text[start..<end]);
    start = end;
    i = i + 1usize;
  }
  out;
}

fn split(mode &bpetokenize.PreTokenizer, text &str, want &str) {
  imm got = pieces(mode, text);
  expectStr(got.view(), want, text);
}

fn main() i32 {
  imm gpt2 = bpetokenize.PreTokenizer.Gpt2;
  imm llama3 = bpetokenize.PreTokenizer.Llama3;
  imm qwen2 = bpetokenize.PreTokenizer.Qwen2;
  imm whole = bpetokenize.PreTokenizer.Whole;

  // -------- from the regular-expression engine --------
  split(&gpt2, "Hello world", "Hello| world");
  split(&gpt2, " Hello  world ", " Hello| | world| ");
  split(&gpt2, "I'm sure it's fine; you'll see we've done it, they're 'quoted' don't", "I|'m| sure| it|'s| fine|;| you|'ll| see| we|'ve| done| it|,| they|'re| '|quoted|'| don|'t");
  split(&gpt2, "DON'T Don'T I'M WE'VE THEY'RE", "DON|'|T| Don|'|T| I|'|M| WE|'|VE| THEY|'|RE");
  split(&gpt2, "x=42+17*(3.14)", "x|=|42|+|17|*(|3|.|14|)");
  split(&gpt2, "1234567 and 89 and 1,000,000", "1234567| and| 89| and| 1|,|000|,|000");
  split(&gpt2, "tab\there", "tab|\t|here");
  split(&gpt2, "line1\nline2\r\n\r\nline3", "line|1|\n|line|2|\r\n\r|\n|line|3");
  split(&gpt2, "  leading", " | leading");
  split(&gpt2, "trailing   ", "trailing|   ");
  split(&gpt2, "a  b   c", "a| | b|  | c");
  split(&gpt2, "\n\n\nfoo", "\n\n|\n|foo");
  split(&gpt2, "foo\n\n", "foo|\n\n");
  split(&gpt2, "foo \n bar", "foo| \n| bar");
  split(&gpt2, "\n \n", "\n \n");
  split(&gpt2, "!!!hello", "!!!|hello");
  split(&gpt2, "hello!!!\nworld", "hello|!!!|\n|world");
  split(&gpt2, "hello!!!\n\n\nworld", "hello|!!!|\n\n|\n|world");
  split(&gpt2, "(hello) [world] {again}", "(|hello|)| [|world|]| {|again|}");
  split(&gpt2, "...", "...");
  split(&gpt2, "café naïve Zoë", "café| naïve| Zoë");
  split(&gpt2, "x²+y³=z ½ cup", "x|²|+|y|³|=|z| ½| cup");
  split(&gpt2, "price: $19.99!", "price|:| $|19|.|99|!");
  split(&gpt2, "U.S.A.", "U|.|S|.|A|.");
  split(&gpt2, "'tis the season, e.g. 'sup", "'t|is| the| season|,| e|.|g|.| '|sup");
  split(&gpt2, "a b", "a| |b");
  split(&gpt2, "ünïcödé", "ünïcödé");
  split(&gpt2, "привет мир", "привет| мир");
  split(&gpt2, "日本語のテキスト", "日本語のテキスト");
  split(&gpt2, "   ", "   ");
  split(&gpt2, " ", " ");
  split(&gpt2, "\t", "\t");
  split(&gpt2, "12 34", "12| 34");
  split(&gpt2, "A1B2", "A|1|B|2");
  split(&gpt2, "snake_case_name", "snake|_|case|_|name");
  split(&gpt2, "#include <stdio.h>", "#|include| <|stdio|.|h|>");
  split(&gpt2, "{\"a\": [1, 2, 3]}", "{\"|a|\":| [|1|,| 2|,| 3|]}");
  split(&gpt2, "emoji 😀 test 😀😀", "emoji| 😀| test| 😀😀");
  split(&gpt2, "a　b", "a|　|b");
  split(&gpt2, "x × y ÷ z", "x| ×| y| ÷| z");
  split(&gpt2, "end.\n", "end|.|\n");
  split(&gpt2, "'", "'");
  split(&gpt2, "'s", "'s");
  split(&gpt2, "a's", "a|'s");
  split(&gpt2, "  's", " | '|s");
  split(&gpt2, "-5 +3 .25", "-|5| +|3| .|25");
  split(&gpt2, "word,\n\tindented", "word|,|\n|\t|indented");
  split(&gpt2, "\r\n", "\r\n");
  split(&gpt2, "a\r\nb", "a|\r|\n|b");
  split(&gpt2, "ab  \n  cd", "ab|  \n | cd");
  split(&gpt2, "1 2 3 4 5 6", "1| 2| 3| 4| 5| 6");
  split(&gpt2, "000123", "000123");
  split(&llama3, "Hello world", "Hello| world");
  split(&llama3, " Hello  world ", " Hello| | world| ");
  split(&llama3, "I'm sure it's fine; you'll see we've done it, they're 'quoted' don't", "I|'m| sure| it|'s| fine|;| you|'ll| see| we|'ve| done| it|,| they|'re| '|quoted|'| don|'t");
  split(&llama3, "DON'T Don'T I'M WE'VE THEY'RE", "DON|'T| Don|'T| I|'M| WE|'VE| THEY|'RE");
  split(&llama3, "x=42+17*(3.14)", "x|=|42|+|17|*(|3|.|14|)");
  split(&llama3, "1234567 and 89 and 1,000,000", "123|456|7| and| |89| and| |1|,|000|,|000");
  split(&llama3, "tab\there", "tab|\there");
  split(&llama3, "line1\nline2\r\n\r\nline3", "line|1|\n|line|2|\r\n\r\n|line|3");
  split(&llama3, "  leading", " | leading");
  split(&llama3, "trailing   ", "trailing|   ");
  split(&llama3, "a  b   c", "a| | b|  | c");
  split(&llama3, "\n\n\nfoo", "\n\n\n|foo");
  split(&llama3, "foo\n\n", "foo|\n\n");
  split(&llama3, "foo \n bar", "foo| \n| bar");
  split(&llama3, "\n \n", "\n \n");
  split(&llama3, "!!!hello", "!!!|hello");
  split(&llama3, "hello!!!\nworld", "hello|!!!\n|world");
  split(&llama3, "hello!!!\n\n\nworld", "hello|!!!\n\n\n|world");
  split(&llama3, "(hello) [world] {again}", "(hello|)| [|world|]| {|again|}");
  split(&llama3, "...", "...");
  split(&llama3, "café naïve Zoë", "café| naïve| Zoë");
  split(&llama3, "x²+y³=z ½ cup", "x|²|+y|³|=z| |½| cup");
  split(&llama3, "price: $19.99!", "price|:| $|19|.|99|!");
  split(&llama3, "U.S.A.", "U|.S|.A|.");
  split(&llama3, "'tis the season, e.g. 'sup", "'t|is| the| season|,| e|.g|.| '|sup");
  split(&llama3, "a b", "a| b");
  split(&llama3, "ünïcödé", "ünïcödé");
  split(&llama3, "привет мир", "привет| мир");
  split(&llama3, "日本語のテキスト", "日本語のテキスト");
  split(&llama3, "   ", "   ");
  split(&llama3, " ", " ");
  split(&llama3, "\t", "\t");
  split(&llama3, "12 34", "12| |34");
  split(&llama3, "A1B2", "A|1|B|2");
  split(&llama3, "snake_case_name", "snake|_case|_name");
  split(&llama3, "#include <stdio.h>", "#include| <|stdio|.h|>");
  split(&llama3, "{\"a\": [1, 2, 3]}", "{\"|a|\":| [|1|,| |2|,| |3|]}");
  split(&llama3, "emoji 😀 test 😀😀", "emoji| 😀| test| 😀😀");
  split(&llama3, "a　b", "a|　b");
  split(&llama3, "x × y ÷ z", "x| ×| y| ÷| z");
  split(&llama3, "end.\n", "end|.\n");
  split(&llama3, "'", "'");
  split(&llama3, "'s", "'s");
  split(&llama3, "a's", "a|'s");
  split(&llama3, "  's", " | '|s");
  split(&llama3, "-5 +3 .25", "-|5| +|3| .|25");
  split(&llama3, "word,\n\tindented", "word|,\n|\tindented");
  split(&llama3, "\r\n", "\r\n");
  split(&llama3, "a\r\nb", "a|\r\n|b");
  split(&llama3, "ab  \n  cd", "ab|  \n| | cd");
  split(&llama3, "1 2 3 4 5 6", "1| |2| |3| |4| |5| |6");
  split(&llama3, "000123", "000|123");
  split(&qwen2, "Hello world", "Hello| world");
  split(&qwen2, " Hello  world ", " Hello| | world| ");
  split(&qwen2, "I'm sure it's fine; you'll see we've done it, they're 'quoted' don't", "I|'m| sure| it|'s| fine|;| you|'ll| see| we|'ve| done| it|,| they|'re| '|quoted|'| don|'t");
  split(&qwen2, "DON'T Don'T I'M WE'VE THEY'RE", "DON|'T| Don|'T| I|'M| WE|'VE| THEY|'RE");
  split(&qwen2, "x=42+17*(3.14)", "x|=|4|2|+|1|7|*(|3|.|1|4|)");
  split(&qwen2, "1234567 and 89 and 1,000,000", "1|2|3|4|5|6|7| and| |8|9| and| |1|,|0|0|0|,|0|0|0");
  split(&qwen2, "tab\there", "tab|\there");
  split(&qwen2, "line1\nline2\r\n\r\nline3", "line|1|\n|line|2|\r\n\r\n|line|3");
  split(&qwen2, "  leading", " | leading");
  split(&qwen2, "trailing   ", "trailing|   ");
  split(&qwen2, "a  b   c", "a| | b|  | c");
  split(&qwen2, "\n\n\nfoo", "\n\n\n|foo");
  split(&qwen2, "foo\n\n", "foo|\n\n");
  split(&qwen2, "foo \n bar", "foo| \n| bar");
  split(&qwen2, "\n \n", "\n \n");
  split(&qwen2, "!!!hello", "!!!|hello");
  split(&qwen2, "hello!!!\nworld", "hello|!!!\n|world");
  split(&qwen2, "hello!!!\n\n\nworld", "hello|!!!\n\n\n|world");
  split(&qwen2, "(hello) [world] {again}", "(hello|)| [|world|]| {|again|}");
  split(&qwen2, "...", "...");
  split(&qwen2, "café naïve Zoë", "café| naïve| Zoë");
  split(&qwen2, "x²+y³=z ½ cup", "x|²|+y|³|=z| |½| cup");
  split(&qwen2, "price: $19.99!", "price|:| $|1|9|.|9|9|!");
  split(&qwen2, "U.S.A.", "U|.S|.A|.");
  split(&qwen2, "'tis the season, e.g. 'sup", "'t|is| the| season|,| e|.g|.| '|sup");
  split(&qwen2, "a b", "a| b");
  split(&qwen2, "ünïcödé", "ünïcödé");
  split(&qwen2, "привет мир", "привет| мир");
  split(&qwen2, "日本語のテキスト", "日本語のテキスト");
  split(&qwen2, "   ", "   ");
  split(&qwen2, " ", " ");
  split(&qwen2, "\t", "\t");
  split(&qwen2, "12 34", "1|2| |3|4");
  split(&qwen2, "A1B2", "A|1|B|2");
  split(&qwen2, "snake_case_name", "snake|_case|_name");
  split(&qwen2, "#include <stdio.h>", "#include| <|stdio|.h|>");
  split(&qwen2, "{\"a\": [1, 2, 3]}", "{\"|a|\":| [|1|,| |2|,| |3|]}");
  split(&qwen2, "emoji 😀 test 😀😀", "emoji| 😀| test| 😀😀");
  split(&qwen2, "a　b", "a|　b");
  split(&qwen2, "x × y ÷ z", "x| ×| y| ÷| z");
  split(&qwen2, "end.\n", "end|.\n");
  split(&qwen2, "'", "'");
  split(&qwen2, "'s", "'s");
  split(&qwen2, "a's", "a|'s");
  split(&qwen2, "  's", " | '|s");
  split(&qwen2, "-5 +3 .25", "-|5| +|3| .|2|5");
  split(&qwen2, "word,\n\tindented", "word|,\n|\tindented");
  split(&qwen2, "\r\n", "\r\n");
  split(&qwen2, "a\r\nb", "a|\r\n|b");
  split(&qwen2, "ab  \n  cd", "ab|  \n| | cd");
  split(&qwen2, "1 2 3 4 5 6", "1| |2| |3| |4| |5| |6");
  split(&qwen2, "000123", "0|0|0|1|2|3");

  // -------- the empty text, and no cut --------
  expectUInt(u64.from(bpetokenize.pieceEnds(&gpt2, "").len()), 0u64, "empty text, GPT-2: no pieces");
  expectUInt(u64.from(bpetokenize.pieceEnds(&llama3, "").len()), 0u64, "empty text, Llama 3: no pieces");
  expectUInt(u64.from(bpetokenize.pieceEnds(&whole, "").len()), 0u64, "empty text, whole: no pieces");
  split(&whole, "Hello world, 123!", "Hello world, 123!");
  split(&whole, "a", "a");

  // -------- bytes that are not UTF-8 --------
  // Each such byte is a character of its own in the class of "other": a symbol, so
  // it takes a space before it and runs with the symbols after it ('a', FF FE, 'b',
  // then a space and C3). Llama 3 would join one such byte to a letter after it
  // (the byte as the one character that may begin a word); none is followed by one
  // here, the same text cut by both expressions.
  mut bad = List[u8].empty();
  bad.push('a'); bad.push(0xFFu8); bad.push(0xFEu8); bad.push('b'); bad.push(' '); bad.push(0xC3u8);
  imm badGpt2 = pieces(&gpt2, bad.view());
  mut want = List[u8].empty();
  want.push('a'); want.push('|'); want.push(0xFFu8); want.push(0xFEu8); want.push('|'); want.push('b'); want.push('|');
  want.push(' '); want.push(0xC3u8);
  expectStr(badGpt2.view(), want.view(), "GPT-2 cut with invalid bytes");
  imm badLlama = pieces(&llama3, bad.view());
  mut want3 = List[u8].empty();
  want3.push('a'); want3.push('|'); want3.push(0xFFu8); want3.push(0xFEu8); want3.push('|'); want3.push('b'); want3.push('|');
  want3.push(' '); want3.push(0xC3u8);
  expectStr(badLlama.view(), want3.view(), "Llama 3 cut with invalid bytes");
  mut lead = List[u8].empty();
  lead.push(0xFFu8); lead.push('a'); lead.push('b');
  imm leadLlama = bpetokenize.pieceEnds(&llama3, lead.view());
  expectUInt(u64.from(leadLlama.len()), 1u64, "Llama 3: an invalid byte may begin a word");
  imm leadGpt2 = bpetokenize.pieceEnds(&gpt2, lead.view());
  expectUInt(u64.from(leadGpt2.len()), 2u64, "GPT-2: an invalid byte is a piece before the word");
  // A cut-off character and an overlong one are not characters either
  mut cut = List[u8].empty();
  cut.push('x'); cut.push(0xE2u8); cut.push(0x82u8);
  imm cutPieces = bpetokenize.pieceEnds(&gpt2, cut.view());
  expectUInt(u64.from(cutPieces.len()), 2u64, "x then a cut-off euro sign: two pieces");
  expectUInt(u64.from(cutPieces.view()[1usize]), 3u64, "the pieces end at the text's end");

  // -------- every cut is the text, in non-empty pieces --------
  mut b = 0u32;
  mut all = List[u8].empty();
  while b < 256u32 { all.push(u8.from(b)); b = b + 1u32; }
  mut modes = List[bpetokenize.PreTokenizer].empty();
  modes.push(bpetokenize.PreTokenizer.Gpt2);
  modes.push(bpetokenize.PreTokenizer.Llama3);
  modes.push(bpetokenize.PreTokenizer.Qwen2);
  modes.push(bpetokenize.PreTokenizer.Whole);
  mut m = 0usize;
  while m < modes.len() {
    imm ends = bpetokenize.pieceEnds(&modes.view()[m], all.view());
    mut prev = 0usize;
    mut ok = ends.len() > 0usize;
    mut k = 0usize;
    while k < ends.len() {
      if ends.view()[k] <= prev { ok = false; }
      prev = ends.view()[k];
      k = k + 1usize;
    }
    expect(ok and prev == 256usize, "the cut of all 256 byte values is increasing and ends at the end");
    m = m + 1usize;
  }

  // -------- names --------
  expectStr(bpetokenize.PreTokenizer.Llama3.name(), "llama3", "name");
  match bpetokenize.PreTokenizer.fromName("llama-bpe") {
    case imm p Some { expectStr(p.name(), "llama3", "fromName llama-bpe"); }
    case is None { expect(false, "fromName llama-bpe"); }
  }
  match bpetokenize.PreTokenizer.fromName("qwen2") {
    case imm p Some { expectStr(p.name(), "qwen2", "fromName qwen2"); }
    case is None { expect(false, "fromName qwen2"); }
  }
  match bpetokenize.PreTokenizer.fromName("gpt-2") {
    case imm p Some { expectStr(p.name(), "gpt2", "fromName gpt-2"); }
    case is None { expect(false, "fromName gpt-2"); }
  }
  match bpetokenize.PreTokenizer.fromName("tekken") {
    case is Some { expect(false, "fromName of a mode this package lacks"); }
    case is None { expect(true, "fromName of a mode this package lacks is None"); }
  }

  done();
}
