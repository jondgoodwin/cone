// The one line each error of this package gives a person is pinned here, with
// the number fields at their widest, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import bpetokenize;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- bpetokenize.BuildError(bpetokenize.BuildErrorKind.BadMerge, 3usize, String.from("merge 3 (\"he llo\") names a token that is not in the vocabulary")), "bpetokenize: merge 3 (\"he llo\") names a token that is not in the vocabulary", "build");
  says(String() <- bpetokenize.DecodeError(2usize, 4294967295u32, 300usize), "bpetokenize: token id 4294967295 at position 2 is not in the vocabulary, which has 300 tokens", "decode");
  done()
}
