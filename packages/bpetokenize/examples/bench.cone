// How fast, on a synthetic vocabulary: no model is downloaded. It makes a
// vocabulary of the 256 byte tokens and a given number of merges built from the
// letters a to h and the space (each merge joins two tokens already made, picked
// by a pseudo-random sequence, so words have the long merge chains real text
// does), makes a text of those letters in words of 1 to 12, and prints the time
// to build the tokenizer, to encode the text and to decode the ids, best of
// three, in megabytes a second of text. Run it in release mode:
//
//   congo run --release examples/bench.cone
//
// It takes the number of merges and the text's size in bytes as its two
// arguments when it is started with them (the defaults are 20000 and
// 1000000; 'congo run' passes none). The numbers in the package header
// (bpetokenize.cone) are from this program.

mod bench;

import collections use *;
import time use *;
import process;
import stdio use *;
import bpetokenize;

struct Lcg {
  state u64;

  fn next(self &mut) u32 {
    state = state * 6364136223846793005u64 + 1442695040888963407u64;
    u32.from(state >> 33u64)
  }
}

fn argOr(args &List[String], at usize, fallback usize) usize {
  if at >= args.len() { return fallback; }
  match parseUInt(args.view()[at].view()) {
    case let n Some { usize.from(n) }
    case is None { fallback }
  }
}

fn main() i32 {
  let args = process.args();
  let merges = argOr(&args, 1usize, 20000usize);
  let size = argOr(&args, 2usize, 1000000usize);
  var rng = new Lcg(7u64);

  var tokens = List[String].empty();
  var texts = List[String].empty();
  var b = 0u32;
  while b < 256u32 {
    var one = List[u8].empty();
    one.push(u8.from(b));
    tokens.push(bpetokenize.toByteLevel(one.view()));
    texts.push(String.fromBytes(one.view()));
    b = b + 1u32;
  }
  var seen = Dict[String, u32].deterministic();
  var k = 0usize;
  while k < 256usize { seen.insert(texts.view()[k].copy(), u32.from(k)); k = k + 1usize; }
  var lines = List[String].empty();
  var tries = 0usize;
  while lines.len() < merges and tries < merges * 20usize {
    tries = tries + 1usize;
    // the letters a to h and the space, or a token made so far (more often later)
    var l = 97u32 + rng.next() % 8u32;
    var r = 97u32 + rng.next() % 8u32;
    if texts.len() > 256usize and rng.next() % 5u32 != 0u32 { l = 256u32 + rng.next() % u32.from(texts.len() - 256usize); }
    if texts.len() > 256usize and rng.next() % 5u32 != 0u32 { r = 256u32 + rng.next() % u32.from(texts.len() - 256usize); }
    var joined = texts.view()[usize.from(l)].copy();
    joined.append(texts.view()[usize.from(r)].view());
    if seen.contains(joined.view()) { continue; }
    if joined.len() > 24usize { continue; }
    seen.insert(joined.copy(), u32.from(texts.len()));
    tokens.push(bpetokenize.toByteLevel(joined.view()));
    var line = bpetokenize.toByteLevel(texts.view()[usize.from(l)].view());
    line.append(" ");
    line.append(bpetokenize.toByteLevel(texts.view()[usize.from(r)].view()).view());
    lines.push(line);
    texts.push(joined);
  }

  var text = List[u8].empty();
  while text.len() < size {
    let len = 1u32 + rng.next() % 12u32;
    var j = 0u32;
    while j < len { text.push(u8.from(97u32 + rng.next() % 8u32)); j = j + 1u32; }
    text.push(' ');
  }

  var bestBuild = 0x7FFFFFFFFFFFFFFFi64;
  var bestEncode = 0x7FFFFFFFFFFFFFFFi64;
  var bestDecode = 0x7FFFFFFFFFFFFFFFi64;
  var idCount = 0usize;
  var run = 0;
  while run < 3 {
    let t0 = Instant.now();
    match bpetokenize.Tokenizer.build(tokens.view(), lines.view(), List[String].empty().view(),
                                      bpetokenize.PreTokenizer.Gpt2) {
      case let tok Ok {
        let built = t0.elapsed().nanos();
        if built < bestBuild { bestBuild = built; }
        let t1 = Instant.now();
        let ids = tok.encode(text.view());
        let encoded = t1.elapsed().nanos();
        if encoded < bestEncode { bestEncode = encoded; }
        idCount = ids.len();
        let t2 = Instant.now();
        match tok.decode(ids.view()) {
          case let back Ok { if back.len() != text.len() { printStr("MISMATCH\n"); } }
          case is Error { printStr("DECODE ERROR\n"); }
        }
        let decoded = t2.elapsed().nanos();
        if decoded < bestDecode { bestDecode = decoded; }
      }
      case let e Error { let m = e.message(); printStr(m.view()); printStr("\n"); return 1i32; }
    }
    run += 1;
  }
  printStr("merges ");
  printInt(i64.from(lines.len()));
  printStr(", text ");
  printInt(i64.from(text.len()));
  printStr(" bytes -> ");
  printInt(i64.from(idCount));
  printStr(" ids\n");
  printStr("build ms: ");
  printInt(bestBuild / 1000000i64);
  printStr("\nencode MB/s: ");
  printInt(i64.from(text.len()) * 1000i64 / bestEncode);
  printStr("\ndecode MB/s: ");
  printInt(i64.from(text.len()) * 1000i64 / bestDecode);
  printStr("\n");
  0i32
}
