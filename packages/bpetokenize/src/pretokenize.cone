// ======== The pre-tokenizer: text cut into words before merging ========
//
// A byte-level BPE never merges across the pieces its pre-tokenizer cuts, so
// the cut decides most of what a vocabulary's tokens can be. The reference
// cuts are regular expressions with Unicode classes and one look-ahead; this
// is the same cut written by hand over the three classes the expressions use,
// with no regular-expression engine. The package header says which families
// each mode reproduces and where it differs.
//
// The classes are \p{L} (letter), \p{N} (number), \s (white space) and
// everything else (symbols, punctuation, marks, the space-less rest). A byte
// that is not part of well-formed UTF-8 is "everything else", one byte to a
// character, so any bytes can be cut.

const kLetter = 0u8;
const kNumber = 1u8;
const kSpace = 2u8;
const kOther = 3u8;

// -------- the classes --------

// Pairs of the first and last code point of each range, in order. This is not
// the Unicode database: it lists the letters of the scripts below (Latin,
// Greek, Cyrillic, Armenian, Hebrew, Arabic, Devanagari, Thai, Georgian,
// Hangul, Hiragana, Katakana, Bopomofo and the CJK ideographs), by block.
// Within a block it takes every code point to be a letter, so a few marks and
// symbols inside one are counted as letters; a script not listed (Bengali,
// Tamil, Ethiopic, Khmer, ...) is counted as "other", which splits its words
// at every character unlike the reference. A text in a listed script splits
// as the reference does except at those few code points.
// \p{L}
let letterRanges: Array[u32, 142] = [
  0x41u32, 0x5Au32, 0x61u32, 0x7Au32, 0xAAu32, 0xAAu32, 0xB5u32, 0xB5u32, 0xBAu32, 0xBAu32, 0xC0u32,
  0xD6u32, 0xD8u32, 0xF6u32, 0xF8u32, 0x2C1u32, 0x2C6u32, 0x2D1u32, 0x2E0u32, 0x2E4u32, 0x2ECu32,
  0x2ECu32, 0x2EEu32, 0x2EEu32, 0x370u32, 0x374u32, 0x376u32, 0x377u32, 0x37Au32, 0x37Du32, 0x37Fu32,
  0x37Fu32, 0x386u32, 0x386u32, 0x388u32, 0x38Au32, 0x38Cu32, 0x38Cu32, 0x38Eu32, 0x3A1u32, 0x3A3u32,
  0x3F5u32, 0x3F7u32, 0x481u32, 0x48Au32, 0x52Fu32, 0x531u32, 0x556u32, 0x559u32, 0x559u32, 0x560u32,
  0x588u32, 0x5D0u32, 0x5EAu32, 0x5EFu32, 0x5F2u32, 0x620u32, 0x64Au32, 0x66Eu32, 0x66Fu32, 0x671u32,
  0x6D3u32, 0x6D5u32, 0x6D5u32, 0x6E5u32, 0x6E6u32, 0x6EEu32, 0x6EFu32, 0x6FAu32, 0x6FCu32, 0x6FFu32,
  0x6FFu32, 0x904u32, 0x939u32, 0x93Du32, 0x93Du32, 0x950u32, 0x950u32, 0x958u32, 0x961u32, 0x971u32,
  0x97Fu32, 0xE01u32, 0xE30u32, 0xE32u32, 0xE33u32, 0xE40u32, 0xE46u32, 0x10A0u32, 0x10C5u32,
  0x10D0u32, 0x10FAu32, 0x10FCu32, 0x10FFu32, 0x1100u32, 0x11FFu32, 0x1E00u32, 0x1FBCu32, 0x1FC2u32,
  0x1FFCu32, 0x2C60u32, 0x2CE4u32, 0x3041u32, 0x3096u32, 0x309Du32, 0x309Fu32, 0x30A1u32, 0x30FAu32,
  0x30FCu32, 0x30FFu32, 0x3105u32, 0x312Fu32, 0x3131u32, 0x318Eu32, 0x3400u32, 0x4DBFu32, 0x4E00u32,
  0x9FFFu32, 0xA640u32, 0xA66Eu32, 0xA680u32, 0xA69Du32, 0xA722u32, 0xA788u32, 0xA78Bu32, 0xA7FFu32,
  0xAC00u32, 0xD7A3u32, 0xF900u32, 0xFAD9u32, 0xFB00u32, 0xFB06u32, 0xFF21u32, 0xFF3Au32, 0xFF41u32,
  0xFF5Au32, 0xFF66u32, 0xFFDCu32, 0x20000u32, 0x2FA1Du32, 0x30000u32, 0x323AFu32
];

// \p{N}: the decimal digits of the common scripts, the superscripts, the number
// forms (fractions, roman numerals) and the circled and dingbat numbers
let numberRanges: Array[u32, 40] = [
  0x30u32, 0x39u32, 0xB2u32, 0xB3u32, 0xB9u32, 0xB9u32, 0xBCu32, 0xBEu32, 0x660u32, 0x669u32, 0x6F0u32,
  0x6F9u32, 0x966u32, 0x96Fu32, 0x9E6u32, 0x9EFu32, 0xE50u32, 0xE59u32, 0x2070u32, 0x2070u32,
  0x2074u32, 0x2079u32, 0x2080u32, 0x2089u32, 0x2150u32, 0x2189u32, 0x2460u32, 0x249Bu32, 0x24EAu32,
  0x24FFu32, 0x2776u32, 0x2793u32, 0x3007u32, 0x3007u32, 0x3021u32, 0x3029u32, 0xFF10u32, 0xFF19u32,
  0x1D7CEu32, 0x1D7FFu32
];

// \s: Unicode's White_Space, which is complete here
let spaceRanges: Array[u32, 20] = [
  0x9u32, 0xDu32, 0x20u32, 0x20u32, 0x85u32, 0x85u32, 0xA0u32, 0xA0u32, 0x1680u32, 0x1680u32,
  0x2000u32, 0x200Au32, 0x2028u32, 0x2029u32, 0x202Fu32, 0x202Fu32, 0x205Fu32, 0x205Fu32, 0x3000u32,
  0x3000u32
];

// Whether cp is in one of the ranges (a sorted list of first, last pairs)
fn inRanges(t: &Array[u32], cp: u32) bool {
  var lo = 0usize;
  var hi = t.len / 2usize;
  while lo < hi {
    let mid = (lo + hi) / 2usize;
    if cp < t[mid * 2usize] { hi = mid; }
    elif cp > t[mid * 2usize + 1usize] { lo = mid + 1usize; }
    else { return true; }
  }
  false
}

// The class of a code point; a byte that is no UTF-8 comes as 0x110000 plus the byte
fn classify(cp: u32) u8 {
  if cp >= 0x110000u32 { return kOther; }
  if cp < 0x80u32 {
    if (cp >= 0x41u32 && cp <= 0x5Au32) || (cp >= 0x61u32 && cp <= 0x7Au32) { return kLetter; }
    if cp >= 0x30u32 && cp <= 0x39u32 { return kNumber; }
    if cp == 0x20u32 || (cp >= 9u32 && cp <= 13u32) { return kSpace; }
    return kOther;
  }
  if inRanges(&spaceRanges, cp) { return kSpace; }
  if inRanges(&letterRanges, cp) { return kLetter; }
  if inRanges(&numberRanges, cp) { return kNumber; }
  kOther
}

// -------- a text as characters --------

// A text cut into characters: the code point of each (an invalid byte as
// 0x110000 plus the byte), its class, and the byte offset it begins at (one
// more offset than characters: the text's length). Reused from text to text.
pub struct Scan {
  cps: List[u32];
  kinds: List[u8];
  offs: List[usize];

  pub fn empty() Scan {
    new Scan(List[u32].empty(), List[u8].empty(), List[usize].empty())
  }

  fn load(self: &mut, text: &Array[u8]) {
    cps.clear();
    kinds.clear();
    offs.clear();
    var i = 0usize;
    while i < text.len {
      offs.push(i);
      let len = utf8Length(text, i);
      var cp = 0u32;
      var width = len;
      if len == 0usize {
        cp = 0x110000u32 + u32.from(text[i]);
        width = 1usize;
      }
      else {
        cp = utf8Decode(text, i, len);
      }
      cps.push(cp);
      kinds.push(classify(cp));
      i = i + width;
    }
    offs.push(text.len);
  }
}

// -------- the cuts --------

// How many characters at i are a contraction ('s 't 're 've 'm 'll 'd), or 0.
// The Llama 3 expression takes them in either case (ignoreCase), GPT-2's only
// in lower case.
fn contractionLength(cps: &Array[u32], n: usize, i: usize, ignoreCase: bool) usize {
  if cps[i] != 0x27u32 || i + 1usize >= n { return 0usize; }
  let c1 = foldCase(cps[i + 1usize], ignoreCase);
  if c1 == 0x73u32 || c1 == 0x74u32 || c1 == 0x6Du32 || c1 == 0x64u32 { return 2usize; }
  if i + 2usize >= n { return 0usize; }
  let c2 = foldCase(cps[i + 2usize], ignoreCase);
  if (c1 == 0x72u32 && c2 == 0x65u32) || (c1 == 0x76u32 && c2 == 0x65u32) || (c1 == 0x6Cu32 && c2 == 0x6Cu32) {
    return 3usize;
  }
  0usize
}

fn foldCase(c: u32, ignoreCase: bool) u32 {
  if ignoreCase && c >= 0x41u32 && c <= 0x5Au32 { c + 32u32 } else { c }
}

// The end of the run of characters of class k that starts at i
fn runEnd(kinds: &Array[u8], n: usize, i: usize, k: u8) usize {
  var j = i;
  while j < n && kinds[j] == k { j = j + 1usize; }
  j
}

// The end of the white space at i, when nothing earlier in the expression has
// matched: \s+(?!\S) then \s+. Of a run of white space the first matches all
// but its last character when a character that is not white space follows
// (so that the last one can go with the word after it), or all of it at the
// end of the text; a run of one that is followed by a word is left to the
// second.
fn spaceEnd(kinds: &Array[u8], n: usize, i: usize) usize {
  let w = runEnd(kinds, n, i, kSpace);
  if w == n { return w; }
  if w - i >= 2usize { return w - 1usize; }
  w
}

// GPT-2's expression, from encoder.py:
//   's|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+(?!\S)|\s+
// The end of the piece that begins at character i.
fn gpt2End(cps: &Array[u32], kinds: &Array[u8], n: usize, i: usize) usize {
  let c = contractionLength(cps, n, i, false);
  if c > 0usize { return i + c; }
  // an optional space (only U+0020), then a run of one class that is not space
  var j = i;
  if cps[i] == 0x20u32 && i + 1usize < n && kinds[i + 1usize] != kSpace { j = i + 1usize; }
  if kinds[j] != kSpace { return runEnd(kinds, n, j, kinds[j]); }
  spaceEnd(kinds, n, i)
}

// The Llama 3 expression (it is GPT-4's cl100k expression), with 'digits' as
// the longest run of numbers it takes in one piece (3 for Llama 3 and GPT-4, 1
// for Qwen 2):
//   (?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?\p{L}+|\p{N}{1,3}
//   | ?[^\s\p{L}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+
// The end of the piece that begins at character i.
fn llama3End(cps: &Array[u32], kinds: &Array[u8], n: usize, i: usize, digits: usize) usize {
  let c = contractionLength(cps, n, i, true);
  if c > 0usize { return i + c; }
  let ci = cps[i];
  let ki = kinds[i];
  // one character that is not a letter, a number or a line break may begin a word
  if ki == kLetter { return runEnd(kinds, n, i, kLetter); }
  if ci != 0x0Au32 && ci != 0x0Du32 && ki != kNumber && i + 1usize < n && kinds[i + 1usize] == kLetter {
    return runEnd(kinds, n, i + 1usize, kLetter);
  }
  // numbers, at most 'digits' of them
  if ki == kNumber {
    var j = i;
    while j < n && kinds[j] == kNumber && j - i < digits { j = j + 1usize; }
    return j;
  }
  // an optional space, a run of other characters, and the line breaks after it
  var o = n;
  if ki == kOther { o = i; }
  elif ci == 0x20u32 && i + 1usize < n && kinds[i + 1usize] == kOther { o = i + 1usize; }
  if o < n {
    var j = runEnd(kinds, n, o, kOther);
    while j < n && (cps[j] == 0x0Au32 || cps[j] == 0x0Du32) { j = j + 1usize; }
    return j;
  }
  // white space that ends in a line break: everything up to the run's last \r or \n
  let w = runEnd(kinds, n, i, kSpace);
  var p = w;
  while p > i {
    p = p - 1usize;
    if cps[p] == 0x0Au32 || cps[p] == 0x0Du32 { return p + 1usize; }
  }
  spaceEnd(kinds, n, i)
}

// -------- the modes --------

// Which cut a tokenizer uses before it merges
pub enum PreTokenizer {
  // GPT-2's expression (GPT-2, GPT-J, and the models that took its expression
  // as it stands); a number is a run of digits, and a word takes the space
  // before it
  Gpt2;
  // Llama 3's expression, cl100k's (GPT-4, GPT-3.5, Llama 3, 3.1 and 3.2, Mistral
  // NeMo's earlier relatives): contractions in either case, a word may take one
  // punctuation or space character before it, numbers in pieces of at most
  // three digits, line breaks kept with the punctuation before them
  Llama3;
  // Qwen 2's expression: Llama 3's, with numbers one digit to a piece
  Qwen2;
  // No cut: the whole text between two special tokens is one piece. A piece is
  // merged as a whole, so this is for a vocabulary whose merges already know
  // their boundaries, and for tests
  Whole;

  // The mode a tokenizer's metadata names (llama.cpp's 'tokenizer.ggml.pre' and
  // Hugging Face's pre-tokenizer names are spelt in many ways; these are the
  // ones this package reproduces), or None
  pub fn fromName(name: &str) Option[PreTokenizer] {
    if name == "gpt2" || name == "gpt-2" || name == "default" { return Some[PreTokenizer](PreTokenizer.Gpt2); }
    if name == "llama3" || name == "llama-3" || name == "llama-bpe" || name == "cl100k" {
      return Some[PreTokenizer](PreTokenizer.Llama3);
    }
    if name == "qwen2" { return Some[PreTokenizer](PreTokenizer.Qwen2); }
    if name == "whole" || name == "none" { return Some[PreTokenizer](PreTokenizer.Whole); }
    None
  }

  pub fn name(self: &PreTokenizer) &str {
    match self {
      case is Gpt2 { "gpt2" }
      case is Llama3 { "llama3" }
      case is Qwen2 { "qwen2" }
      case is Whole { "whole" }
    }
  }

  pub fn copy(self: &PreTokenizer) PreTokenizer {
    match self {
      case is Gpt2 { PreTokenizer.Gpt2 }
      case is Llama3 { PreTokenizer.Llama3 }
      case is Qwen2 { PreTokenizer.Qwen2 }
      case is Whole { PreTokenizer.Whole }
    }
  }
}

// Cuts a text into pieces: appends to 'ends' the byte offset at which each piece
// ends (the last is the text's length; there are none for an empty text). The
// pieces are the text between consecutive offsets, and every byte is in one.
pub fn pieceEndsWith(mode: &PreTokenizer, text: &Array[u8], ends: &mut List[usize], scan: &mut Scan) {
  if text.len == 0usize { return; }
  match mode {
    case is Whole { ends.push(text.len); return; }
    case is Gpt2 { }
    case is Llama3 { }
    case is Qwen2 { }
  }
  scan.load(text);
  let cps = scan.cps.view();
  let kinds = scan.kinds.view();
  let n = cps.len;
  let digits = match mode { case is Qwen2 { 1usize } else { 3usize } };
  let gpt2 = match mode { case is Gpt2 { true } else { false } };
  var i = 0usize;
  while i < n {
    var e = if gpt2 { gpt2End(cps, kinds, n, i) } else { llama3End(cps, kinds, n, i, digits) };
    if e <= i { e = i + 1usize; }
    ends.push(scan.offs.view()[e]);
    i = e;
  }
}

// The same with a scan of its own
pub fn pieceEnds(mode: &PreTokenizer, text: &Array[u8]) List[usize] {
  var ends = List[usize].empty();
  var scan = Scan.empty();
  pieceEndsWith(mode, text, &mut ends, &mut scan);
  ends
}
