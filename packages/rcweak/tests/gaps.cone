// What the compiler does not yet release, pinned as it is today. Each shape
// keeps a count for ever: a strong count keeps its value from dying, and a
// weak count keeps a dead value's block from being freed. None is rcweak's own;
// each is a shape the compiler leaves unreleased for every region. When the
// compiler learns one, its expectation here changes, and the package header's
// "THE HOLES" with it. Every count is worked out by hand from the rules
// counts.cone states, plus the one leak each case names.

mod gaps;

import testing use *;
import rcweak use *;

mut log = 0i64;
fn note(d i64) { log = log * 10i64 + d; }

struct Fin { pub n i64; fn final(self &uni) { note(n); } }

// A strong owner used without being bound is a temporary, never released
fn temporary() {
  imm r = +Rcw-mut Fin[1];
  imm w = Weak[Fin].of(r);
  expectInt(w.strong().n, 1, "read through a temporary owner");
  expectUInt(u64[w.strongCount()], 2, "r and the temporary, never let go");
}

// So is an Option holding one, left unbound: upgrade()'s result discarded
fn discarded() {
  imm r = +Rcw-mut Fin[2];
  imm w = Weak[Fin].of(r);
  w.upgrade();
  expectUInt(u64[w.strongCount()], 2, "r and the discarded Some's owner, never let go");
}

fn main() i32 {
  temporary();
  expectInt(log, 0, "a value a temporary owner named never dies");
  expectUInt(u64[liveBlocks()], 1, "and its block stays");
  discarded();
  expectInt(log, 0, "nor does one a discarded Option's owner named");
  expectUInt(u64[liveBlocks()], 2, "whose block stays");
  done();
}
