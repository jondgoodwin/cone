// Asking a weak reference whose value has died for a strong owner is a
// program error, and a panic, after writing out what was printed before: this
// test's .out is only the line printed before the call. Its .exit is a
// panic's, the status the Microsoft C library's 'abort' ends a program with,
// 0xC0000409, and its .err the panic's line, which names this file and the
// line calling 'strong': the method takes its caller's location, as 'panic'
// does.

mod dead;

import stdio use *;
import rcweak use *;

struct Fin { pub n i64; }

fn gone() Weak[Fin] {
  imm r = +rcw-mut Fin[1];
  Weak[Fin].of(r);
}

fn main() i32 {
  imm w = gone();
  printStr("asking a dead value's weak reference for a strong owner\n");
  imm s = w.strong();
  printStr("not reached\n");
  0i32;
}
