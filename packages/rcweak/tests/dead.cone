// Asking a weak reference whose value has died for a strong owner is a
// program error: rcweak prints what was wrong to stderr and ends the program
// through the C library's 'abort', after writing out what was printed before.
// 'congo test' compares stdout, so this test's output is only the line printed
// before the call. Its .exit is the status the Microsoft C library's 'abort'
// ends a program with, 0xC0000409 (stderr, unchecked here, says: rcweak:
// strong() of a weak reference whose value has died).

mod dead;

import stdio use *;
import rcweak use *;

struct Fin { pub n i64; }

fn gone() Weak[Fin] {
  imm r = +rcw-mut Fin[1];
  Weak[Fin].of(r);
}

fn main() i32 {
  imm w = gone();
  printStr("asking a dead value's weak reference for a strong owner\n");
  imm s = w.strong();
  printStr("not reached\n");
  0i32;
}
