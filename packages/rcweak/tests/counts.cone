// The counts a 'Rcw' value's header keeps, as strong owners and weak
// references come and go. Every expected count is worked out by hand from the
// rules:
// - a new value has one strong owner; each copy of a 'Rcw[mut, T]' owner is one
//   more, and each owner going away one fewer;
// - each Weak[T] made or cloned is one more weak reference, and each one
//   going away one fewer; weakCount counts only these;
// - strong() and upgrade() each make one more strong owner;
// - an Option holding a strong owner -- upgrade()'s Some, or a fallible
//   'trynew' allocation -- is that owner, let go when the Option goes, and
//   a copy of the Option is one more; a match holds the Option it matches,
//   and the variant it binds is that Option's value, no owner more;
// - the value dies when its last strong owner goes, and its block is freed
//   only when its last weak reference has gone as well (liveBlocks).

mod counts;

import testing use *;
import rcweak use *;

struct Fin { pub n: i64; }

fn strongAndWeak() {
  let r = Rcw[mut, Fin](1);
  let w = Weak[Fin].of(&r);
  expectUInt(u64.from(w.strongCount()), 1, "a new value has one strong owner");
  expectUInt(u64.from(w.weakCount()), 1, "and the one weak reference made");
  expectUInt(u64.from(liveBlocks()), 1, "in one block");
  {
    let r2 = r;
    expectUInt(u64.from(w.strongCount()), 2, "a copied owner is counted");
    let w2 = w.clone();
    expectUInt(u64.from(w.weakCount()), 2, "a cloned weak reference is counted");
  }
  expectUInt(u64.from(w.strongCount()), 1, "the copied owner went at its scope's end");
  expectUInt(u64.from(w.weakCount()), 1, "and so did the clone");
  {
    let s = w.strong();
    expectInt(s.n, 1, "strong() reaches the value");
    expectUInt(u64.from(w.strongCount()), 2, "and is a strong owner");
  }
  expectUInt(u64.from(w.strongCount()), 1, "which went at its scope's end");
  expect(w.alive(), "alive while an owner holds it");
  // 'r' is read last, so the copies above are copies: the last read of a counted local is a move
  let again = &r;
}

fn outlived() Weak[Fin] {
  let r = Rcw[mut, Fin](2);
  Weak[Fin].of(&r)
}

fn none() {
  let w = Weak[Fin].none();
  expect(!w.alive(), "none() is never alive");
  expectUInt(u64.from(w.strongCount()), 0, "none() counts no strong owner");
  expectUInt(u64.from(w.weakCount()), 0, "and no weak reference");
  let w2 = w.clone();
  expect(!w2.alive(), "nor is its clone");
}

// A weak reference is made from a shared owner only: a unique 'Rcw' could be
// made a second strong owner by upgrade() while still unique. So a unique owner
// gives up its uniqueness first, moving into an 'Rcw[mut, T]' (the move consumes
// it), and lends that. (A unique owner lent directly is refused:
// region_flow_rcweak_refuse.)
fn uniqueGivenUp() Weak[Fin] {
  let u = Rcw[Fin](3);
  let m: Rcw[mut, Fin] = u;
  let w = Weak[Fin].of(&m);
  expectUInt(u64.from(w.strongCount()), 1, "a unique owner moved into a shared one: still one strong owner");
  expect(w.alive(), "and the weak reference made from it is alive");
  w
}

fn unique() {
  let w = uniqueGivenUp();
  expect(!w.alive(), "the shared owner it became is gone");
  expectUInt(u64.from(liveBlocks()), 1, "its block stays for the weak reference");
}

fn upgraded() {
  let r = Rcw[mut, Fin](4);
  let w = Weak[Fin].of(&r);
  match w.upgrade() {
    case let Some(s) {
      expectInt(s.n, 4, "upgrade() reaches a live value");
      expectUInt(u64.from(w.strongCount()), 3, "r, the Some's owner and the binding's copy of it");
    }
    case is None { expect(false, "upgrade() reaches a live value"); }
  }
  expectUInt(u64.from(w.strongCount()), 1, "the Some's owner went with the match");
  {
    let o = w.upgrade();
    let o2 = o;
    expectUInt(u64.from(w.strongCount()), 3, "an Option copied is one owner more");
    let again = &o;
  }
  expectUInt(u64.from(w.strongCount()), 1, "both went at their scope's end");
}

fn fallible() {
  let o = trynew Rcw[mut, Fin](5);
  expectUInt(u64.from(liveBlocks()), 1, "a fallible allocation's block");
}

fn main() i32 {
  strongAndWeak();
  expectUInt(u64.from(liveBlocks()), 0, "the last owner and weak gone: the block is freed");
  {
    let w = outlived();
    expect(!w.alive(), "a weak reference outlives its value");
    expectUInt(u64.from(w.strongCount()), 0, "which has no strong owner");
    expectUInt(u64.from(w.weakCount()), 1, "only the weak reference");
    expectUInt(u64.from(liveBlocks()), 1, "whose block it still holds");
  }
  expectUInt(u64.from(liveBlocks()), 0, "until it goes too");
  none();
  unique();
  expectUInt(u64.from(liveBlocks()), 0, "every block given back");
  upgraded();
  expectUInt(u64.from(liveBlocks()), 0, "the upgraded value died with r, and its block was freed");
  fallible();
  expectUInt(u64.from(liveBlocks()), 0, "and so did the fallible allocation's");
  done()
}
