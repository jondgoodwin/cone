// Value: one typed property value, and Event: one thing that happened. Both
// are plain data (no lists, no strings), so they copy freely, compare by field
// and can cross an actor boundary by value. A string is an interned name, a
// u32 symbol that 'World.sym' gives, so a Value stays four words.

// A property's value: a number, a bool, a name (symbol) or an id. 'kind' says
// which; 'num' holds a number (a bool as 0 or 1) and 'id' holds a name's
// symbol or an id.
pub struct Value {
  pub kind u32;
  pub num f32;
  pub id u32;

  pub fn none() Value { new Value(VK_NONE, 0., 0u32) }
  pub fn number(n f32) Value { new Value(VK_NUM, n, 0u32) }
  pub fn boolean(b bool) Value { new Value(VK_BOOL, if b { 1. } else { 0. }, 0u32) }
  pub fn name(sym u32) Value { new Value(VK_STR, 0., sym) }
  pub fn entity(e u32) Value { new Value(VK_ID, 0., e) }

  pub fn same(self, o Value) bool { kind == o.kind and num == o.num and id == o.id }
  pub fn isTrue(self) bool { num != 0. }
}

// A thing that happened. 'subject' is what it happened to, 'other' who or what
// else was in it, 'key' a property's, item kind's, timer's or signal's name;
// what each kind of event puts where is beside its EV_ constant.
pub struct Event {
  pub kind u32;
  pub subject u32;
  pub other u32;
  pub key u32;
  pub value Value;
  pub old Value;
  pub time f32;
}
