// Targeting: which thing the viewer is aiming at, locked onto, or may switch
// to. Pure functions over a list of candidates the caller supplies (ids and
// positions), with line of sight through a ray-cast closure the caller owns.
//
// A candidate is valid when it is within 'range' (to its surface: the centre
// distance less its radius), inside the view cone of half-angle 'halfAngle'
// about the forward direction, and not hidden behind something (a ray from the
// eye to it meets nothing nearer, or meets it). Valid candidates are ranked by
//
//   cost = angleWeight * (angle / halfAngle) + distWeight * (distance / range)
//
// lower first, and the current target's cost is multiplied by 'stickiness'
// (below 1) so the lock does not flicker between two near-equal choices:
// hysteresis, as lock-on systems in action games do. Switching left or right
// takes the nearest candidate by bearing (the signed angle about the up axis
// from forward) on the asked side of the current target's bearing.

pub struct Candidate {
  pub id u32;
  pub pos Vec3;
  pub radius f32;
}

// What a ray cast found. The caller's closure fills it.
pub struct RayHit {
  pub hit bool;
  pub dist f32;
  pub id u32;
}

pub struct TargetParams {
  pub range f32;
  pub halfAngle f32;        // radians
  pub angleWeight f32;
  pub distWeight f32;
  pub stickiness f32;       // the current target's cost is multiplied by this
  pub useSight bool;        // require line of sight

  // 20 m, a 45 degree cone, angle counts twice as much as distance, 0.75 stickiness
  pub fn standard() TargetParams { new TargetParams(20., pi / 4., 2., 1., 0.75, true); }
}

// True when nothing blocks the line from 'eye' to the candidate: the cast
// (origin, unit direction, max distance) meets nothing, or the candidate itself
// first, or something no nearer than the candidate's surface.
pub fn clearLine(eye Vec3, c &Candidate, cast &<fn(o Vec3, d Vec3, m f32) RayHit) bool {
  imm v = c.pos - eye;
  imm dist = v.length();
  if dist < 0.0001 { return true; }
  imm h = cast(eye, v * (1. / dist), dist);
  if not h.hit { return true; }
  if h.id == c.id { return true; }
  h.dist >= dist - c.radius - 0.001;
}

// The cost of candidate c from the eye looking along 'forward' (unit), or a
// negative number when it is not valid
pub fn cost(eye Vec3, forward Vec3, c &Candidate, p &TargetParams, current bool, cast &<fn(o Vec3, d Vec3, m f32) RayHit) f32 {
  imm v = c.pos - eye;
  imm dist = v.length();
  if dist - c.radius > p.range { return -1.; }
  mut angle = 0.;
  if dist > 0.0001 {
    mut cs = forward.dot(v) / dist;
    if cs > 1. { cs = 1.; }
    if cs < -1. { cs = -1.; }
    angle = acos(cs);
  }
  if angle > p.halfAngle { return -1.; }
  if p.useSight and not clearLine(eye, c, cast) { return -1.; }
  mut k = p.angleWeight * (angle / p.halfAngle) + p.distWeight * (dist / p.range);
  if current { k = k * p.stickiness; }
  k;
}

// The best valid candidate's id, or 0. 'current' is the id now targeted (0 for none).
pub fn best(eye Vec3, forward Vec3, cands &List[Candidate], p &TargetParams, current u32, cast &<fn(o Vec3, d Vec3, m f32) RayHit) u32 {
  mut bestId = 0u32;
  mut bestCost = 1000000.;
  mut i = 0usize;
  while i < cands.len() {
    imm c = *cands[i];
    imm k = cost(eye, forward, &c, p, c.id == current, cast);
    if k >= 0. and (k < bestCost or (k == bestCost and c.id < bestId)) {
      bestCost = k;
      bestId = c.id;
    }
    i = i + 1usize;
  }
  bestId;
}

// The bearing of a point: the signed angle, about 'up', from 'forward' to the
// direction of v, positive to the viewer's right (forward x up points right)
pub fn bearing(forward Vec3, up Vec3, v Vec3) f32 {
  imm f = (forward - up * forward.dot(up));
  imm r = f.cross(up);
  atan2(v.dot(r), v.dot(f));
}

fn wrapAngle(a f32) f32 {
  mut x = a;
  while x > pi { x = x - 2. * pi; }
  while x <= -pi { x = x + 2. * pi; }
  x;
}

// The candidate to switch to from 'current': the one whose bearing is nearest
// beyond the current one's on the side 'dir' (+1 right, -1 left), valid by
// range and sight but not by the cone (the lock may have turned the view).
// Returns 'current' when nothing lies that way.
pub fn switchTo(eye Vec3, forward Vec3, up Vec3, dir f32, cands &List[Candidate], p &TargetParams, current u32,
    cast &<fn(o Vec3, d Vec3, m f32) RayHit) u32 {
  mut curBearing = 0.;
  mut found = false;
  mut i = 0usize;
  while i < cands.len() {
    imm c = *cands[i];
    if c.id == current { curBearing = bearing(forward, up, c.pos - eye); found = true; }
    i = i + 1usize;
  }
  if not found { return current; }
  mut bestId = current;
  mut bestGap = 1000.;
  mut j = 0usize;
  while j < cands.len() {
    imm c = *cands[j];
    if c.id != current {
      imm v = c.pos - eye;
      imm gap = wrapAngle(bearing(forward, up, v) - curBearing) * dir;
      if gap > 0.0001 and gap < bestGap and v.length() - c.radius <= p.range {
        if not p.useSight or clearLine(eye, &c, cast) {
          bestGap = gap;
          bestId = c.id;
        }
      }
    }
    j = j + 1usize;
  }
  bestId;
}

// A lock-on: the target kept until it is lost for 'grace' seconds
pub struct LockOn {
  pub target u32;
  pub lostFor f32;
  pub grace f32;

  pub fn make(grace f32) LockOn { new LockOn(0u32, 0., grace); }

  pub fn isLocked(self &) bool { target != 0u32; }

  // Lock onto the best candidate in view, if any. Returns the target.
  pub fn acquire(self &mut, eye Vec3, forward Vec3, cands &List[Candidate], p &TargetParams,
      cast &<fn(o Vec3, d Vec3, m f32) RayHit) u32 {
    target = best(eye, forward, cands, p, 0u32, cast);
    lostFor = 0.;
    target;
  }

  pub fn release(self &mut) { target = 0u32; lostFor = 0.; }

  // Keep the lock through dt seconds: a locked target stays while within 1.25 x
  // range and in sight, whatever the view; once lost for 'grace' seconds the
  // lock drops. Returns the target (0 once dropped).
  pub fn update(self &mut, dt f32, eye Vec3, cands &List[Candidate], p &TargetParams,
      cast &<fn(o Vec3, d Vec3, m f32) RayHit) u32 {
    if target == 0u32 { return 0u32; }
    mut ok = false;
    mut i = 0usize;
    while i < cands.len() {
      imm c = *cands[i];
      if c.id == target {
        imm dist = (c.pos - eye).length();
        ok = dist - c.radius <= p.range * 1.25 and (not p.useSight or clearLine(eye, &c, cast));
      }
      i = i + 1usize;
    }
    if ok { lostFor = 0.; } else { lostFor = lostFor + dt; }
    if lostFor > grace { target = 0u32; lostFor = 0.; }
    target;
  }

  // Switch to the neighbour on one side: dir +1 right, -1 left
  pub fn switchSide(self &mut, dir f32, eye Vec3, forward Vec3, up Vec3, cands &List[Candidate], p &TargetParams,
      cast &<fn(o Vec3, d Vec3, m f32) RayHit) u32 {
    if target != 0u32 { target = switchTo(eye, forward, up, dir, cands, p, target, cast); }
    target;
  }
}

// Aim assist (a hook): bend the aim direction toward the best candidate in the
// cone. How much is the caller's closure 'blend' (angle to the target, the
// cone's half angle, strength) -> 0..1, so a game can shape the pull; 'defaultBlend'
// is a linear fall-off from the strength at the centre to nothing at the edge.
// The result is the normalised linear blend of the two unit directions.
pub fn defaultBlend(angle f32, maxAngle f32, strength f32) f32 {
  if angle >= maxAngle { return 0.; }
  strength * (1. - angle / maxAngle);
}

pub fn aimAssist(eye Vec3, aim Vec3, cands &List[Candidate], p &TargetParams, strength f32,
    blend &<fn(angle f32, maxAngle f32, strength f32) f32,
    cast &<fn(o Vec3, d Vec3, m f32) RayHit) Vec3 {
  imm id = best(eye, aim, cands, p, 0u32, cast);
  if id == 0u32 { return aim; }
  mut pos = eye;
  mut i = 0usize;
  while i < cands.len() {
    imm c = *cands[i];
    if c.id == id { pos = c.pos; }
    i = i + 1usize;
  }
  imm to = (pos - eye).normalize();
  mut cs = aim.dot(to);
  if cs > 1. { cs = 1.; }
  if cs < -1. { cs = -1.; }
  imm k = blend(acos(cs), p.halfAngle, strength);
  (aim * (1. - k) + to * k).normalize();
}
