// A scenario as text: Ana walks to a locked door, finds it locked, picks up a
// key, unlocks the door, walks through (a doorway volume and a rule answer),
// and picks up a bag, which she then carries in her hand.
//
// Run it with 'congo run' in the package, or read its output in
// tests/scenario.out. Every line is an Event the world returned or a decision
// the program made; the browser integration would turn the same events into
// requests (see the package overview).

mod scenario;

import collections use *;
import stdio use *;
import geomath use *;
import worldinteract use *;

fn name(k u32) &str {
  if k == EV_PROP_CHANGED { return "prop-changed"; }
  if k == EV_USED { return "used"; }
  if k == EV_USE_DENIED { return "use-denied"; }
  if k == EV_FOCUS { return "focus"; }
  if k == EV_UNFOCUS { return "unfocus"; }
  if k == EV_DOOR_OPENING { return "door-opening"; }
  if k == EV_DOOR_OPENED { return "door-opened"; }
  if k == EV_DOOR_CLOSING { return "door-closing"; }
  if k == EV_DOOR_CLOSED { return "door-closed"; }
  if k == EV_DOOR_LOCKED { return "door-locked"; }
  if k == EV_DOOR_UNLOCKED { return "door-unlocked"; }
  if k == EV_PASSABILITY { return "passability"; }
  if k == EV_PICKED_UP { return "picked-up"; }
  if k == EV_ATTACHED { return "attached"; }
  if k == EV_ENTER { return "enter"; }
  if k == EV_EXIT { return "exit"; }
  if k == EV_SIGNAL { return "signal"; }
  if k == EV_ITEM_ADDED { return "item-added"; }
  if k == EV_ITEM_REMOVED { return "item-removed"; }
  "other"
}

// A few entity ids, for printing
struct Names {
  pub ana u32;
  pub door u32;
  pub key u32;
  pub bag u32;
  pub doorway u32;
  pub room u32;
}

fn who(n &Names, id u32) &str {
  if id == n.ana { return "Ana"; }
  if id == n.door { return "the door"; }
  if id == n.key { return "the key"; }
  if id == n.bag { return "the bag"; }
  if id == n.doorway { return "the doorway"; }
  if id == n.room { return "the room"; }
  "nothing"
}

fn show(w &mut World, n &Names) {
  var ev = w.takeEvents();
  var i = 0usize;
  while i < ev.len() {
    let e = *ev[i];
    if e.kind != EV_STAY {
    print <- "  t="; print <- e.time; print <- "  "; print <- name(e.kind);
    print <- "  "; print <- who(n, e.subject);
    if e.other != 0u32 { print <- " / "; print <- who(n, e.other); }
    if e.kind == EV_USE_DENIED { print <- "  (reason "; print <- e.value.num; print <- ")"; }
    if e.kind == EV_PASSABILITY { print <- "  (passable "; print <- e.value.num; print <- ")"; }
    print <- "\n";
    }
    i = i + 1usize;
  }
}

fn hand(parent u32, bone u32) Transform3 {
  new Transform3(new Vec3(0.3, 1.1, 0.2), Quat.identity(), new Vec3(1., 1., 1.))
}

fn main() i32 {
  var w = World.make();
  let keyKind = w.defineItem("brass key", 9u32, 0.05, false);
  let coinKind = w.defineItem("coin", 99u32, 0.01, false);
  let bagKind = w.defineItem("bag", 1u32, 0.8, true);
  let none = new Vec3(0., 0., 0.);

  // The world: a corridor along +z, a locked door at z = 0, a room beyond.
  let ana = w.create(CLASS_CHARACTER);
  w.setPosition(ana, new Vec3(0., 0., -7.));
  w.setTracked(ana, true);
  w.addInventory(ana, 6u32, 5.);
  let door = w.create(CLASS_DOOR);
  w.addDoor(door, Door.hinged(door, new Vec3(-0.5, 0., 0.), new Vec3(0., 1., 0.), pi / 2., 1.2));
  w.setDoorLocked(door, true);
  w.setDoorKey(door, keyKind, true, true);
  w.setDoorAutoClose(door, 4.);
  w.addInteractable(door, 3., 0.7, false, new Vec3(0., 0., -1.), VERB_USE);
  let key = w.makeItem(keyKind, 1u32, new Vec3(1.5, 0.8, -3.));
  w.addInteractable(key, 2., 0., false, none, VERB_USE);
  let bag = w.makeItem(bagKind, 1u32, new Vec3(0., 0., 4.));
  w.addInventory(bag, 4u32, 0.);
  w.addInteractable(bag, 2., 0., false, none, VERB_USE);
  // a volume in the doorway, and one over the room that pays a coin purse
  let doorway = w.create(CLASS_TRIGGER);
  w.addBoxTrigger(doorway, new Vec3(0.6, 1., 0.5), CLASS_CHARACTER);
  let room = w.create(CLASS_TRIGGER);
  w.setPosition(room, new Vec3(0., 0., 4.));
  w.addBoxTrigger(room, new Vec3(3., 2., 3.), CLASS_CHARACTER);
  let visited = w.sym("visited");
  let welcome = w.sym("welcome");
  let rule = w.addRule(EV_ENTER, room, 0u32, 0u32, CLASS_CHARACTER, true);
  w.ruleDo(rule, ACT_SET_PROP, room, visited, Value.boolean(true), 0., 0.);
  w.ruleDo(rule, ACT_GIVE_ITEM, ENT_OTHER, coinKind, Value.none(), 5., 0.);
  w.ruleDo(rule, ACT_SIGNAL, room, welcome, Value.none(), 0., 0.);
  let names = new Names(ana, door, key, bag, doorway, room);
  let sight = fn(o Vec3, d Vec3, m f32) RayHit { new RayHit(false, 0., 0u32) };
  show(&mut w, &names);

  print <- "Ana walks down the corridor toward the door\n";
  var z = -7.;
  while z < -2.5 {
    z = z + 0.5;
    w.setPosition(ana, new Vec3(0., 0., z));
    w.step(0.25);
  }
  let focus = w.updateFocus(ana, new Vec3(0., 1.6, z), new Vec3(0., 0., 1.), &sight);
  print <- "  she is looking at "; print <- who(&names, focus); print <- "\n";
  show(&mut w, &names);

  print <- "Ana presses E on the door\n";
  w.activate(ana, door);
  show(&mut w, &names);

  print <- "Ana goes to the table and presses E on the key\n";
  w.setPosition(ana, new Vec3(1., 0., -3.));
  w.activate(ana, key);
  show(&mut w, &names);
  print <- "  keys in her pocket: "; print <- w.invCount(ana, keyKind); print <- "\n";

  print <- "Ana returns to the door and presses E\n";
  w.setPosition(ana, new Vec3(0., 0., -2.));
  w.activate(ana, door);
  var t = 0;
  while t < 5 {
    w.step(0.25);
    t = t + 1;
  }
  show(&mut w, &names);
  print <- "  keys in her pocket: "; print <- w.invCount(ana, keyKind); print <- " (used up)\n";
  print <- "  the door is passable: "; print <- i64.from(w.doorPassable(door)); print <- "\n";

  print <- "Ana walks through\n";
  var walk = -2.;
  while walk < 4. {
    walk = walk + 0.5;
    w.setPosition(ana, new Vec3(0., 0., walk));
    w.step(0.25);
  }
  show(&mut w, &names);
  print <- "  coins in her pocket: "; print <- w.invCount(ana, coinKind); print <- "\n";

  print <- "Ana presses E on the bag and carries it in her hand\n";
  w.activate(ana, bag);
  show(&mut w, &names);
  print <- "  she takes it out of her pocket into her hand (bone 3)\n";
  w.hold(ana, bag, 3u32, new Transform3(new Vec3(0., -0.1, 0.), Quat.identity(), new Vec3(1., 1., 1.)));
  var p = w.worldTransform(bag, &hand).translation;
  print <- "  the bag is at x "; print <- p.x; print <- " y "; print <- p.y; print <- " z "; print <- p.z; print <- "\n";
  w.setPosition(ana, new Vec3(0., 0., 6.));
  p = w.worldTransform(bag, &hand).translation;
  print <- "  Ana steps to z 6; the bag is at z "; print <- p.z; print <- "\n";
  show(&mut w, &names);

  print <- "Time passes; the door closes by itself\n";
  var u = 0;
  while u < 24 {
    w.step(0.25);
    u = u + 1;
  }
  show(&mut w, &names);
  print <- "  the door is passable: "; print <- i64.from(w.doorPassable(door)); print <- "\n";
  0
}
