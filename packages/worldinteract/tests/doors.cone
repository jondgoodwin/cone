// Doors. A hinged door (pivot at the origin, hinge axis +y, 90 degrees in 1 s,
// smoothstep ease p*p*(3-2p)). Worked by hand:
//   openness at 0.25 s: p = .25, 0.0625 * 2.5 = 0.15625
//   at 0.5 s: 0.5;  at 1 s and later: 1
//   the angle is openness * 90 degrees; turning (1,0,0) by +a about +y gives
//   (cos a, 0, -sin a), so at 0.5 s (45 degrees) it is (0.70711, 0, -0.70711)
// Reversed at 0.5 s (from = 0.5, target 0, toggledAt = 0.5): at 0.75 s p = .25,
//   openness = 0.5 + (0 - 0.5) * 0.15625 = 0.421875
// A sliding door (2 m in 2 s): at 1 s openness 0.5, the pose moves by (1, 0, 0).
// Passable from openness 0.7: stepping by 0.25 s, openness is 0.15625, 0.5,
//   0.84375 (smoothstep(.75) = 0.5625 * 1.5), 1 at the 4 steps, so the
//   passability event comes with the third step and EV_DOOR_OPENED with the fourth.
// Auto-close 2 s: the swing ends at 1 s, so the door starts closing at the
//   first step at or after 3 s.

mod doors;

import collections use *;
import testing use *;
import geomath use *;
import worldinteract use *;

fn count(evs &List[Event], kind u32) i64 {
  mut n = 0i64;
  mut i = 0usize;
  while i < evs.len() {
    if (*evs[i]).kind == kind { n = n + 1i64; }
    i = i + 1usize;
  }
  n;
}

fn at(evs &List[Event], kind u32) i64 {
  mut i = 0usize;
  while i < evs.len() {
    if (*evs[i]).kind == kind { return i64.from(i); }
    i = i + 1usize;
  }
  -1i64;
}

fn main() i32 {
  mut w = World.make();
  imm player = w.create(CLASS_CHARACTER);
  w.setPosition(player, new Vec3(0., 0., -2.));          // faces +z, toward the door
  imm door = w.create(CLASS_DOOR);
  w.addDoor(door, Door.hinged(door, new Vec3(0., 0., 0.), new Vec3(0., 1., 0.), pi / 2., 1.));
  w.setDoorLocked(door, false);
  w.addInteractable(door, 3., 0.5, false, new Vec3(0., 0., -1.), VERB_USE);

  expectFloat(f64.from(w.doorOpenness(door, 0.)), 0., 0.00001, "closed at the start");
  expect(w.activate(player, door), "the player can use the door");
  expect(w.doorWantsOpen(door), "it is opening");
  expectFloat(f64.from(w.doorOpenness(door, 0.25)), 0.15625, 0.00001, "openness at 0.25 s");
  expectFloat(f64.from(w.doorOpenness(door, 0.5)), 0.5, 0.00001, "openness at 0.5 s");
  expectFloat(f64.from(w.doorOpenness(door, 1.)), 1., 0.00001, "open at 1 s");
  expectFloat(f64.from(w.doorOpenness(door, 5.)), 1., 0.00001, "and stays open");
  imm turned = w.doorPose(door, 0.5).rotation * new Vec3(1., 0., 0.);
  expectFloat(f64.from(turned.x), 0.70711, 0.0001, "at 0.5 s the door has turned 45 degrees: x");
  expectFloat(f64.from(turned.z), -0.70711, 0.0001, "and z");
  imm full = w.doorPose(door, 1.).rotation * new Vec3(1., 0., 0.);
  expectFloat(f64.from(full.z), -1., 0.0001, "fully open is 90 degrees");

  // stepping: the events and their order
  mut evs = w.takeEvents();
  expectInt(count(&evs, EV_USED), 1i64, "one EV_USED");
  expect(at(&evs, EV_USED) < at(&evs, EV_DOOR_OPENING), "used before opening");
  w.step(0.25);
  w.step(0.25);
  expectInt(count(&w.log, EV_PASSABILITY), 0i64, "not passable at 0.5 s");
  w.step(0.25);
  mut e2 = w.takeEvents();
  expectInt(count(&e2, EV_PASSABILITY), 1i64, "passability event with the third step");
  expectFloat(f64.from((*e2[usize.from(at(&e2, EV_PASSABILITY))]).value.num), 1., 0.00001, "it says passable");
  w.step(0.25);
  mut e3 = w.takeEvents();
  expectInt(count(&e3, EV_DOOR_OPENED), 1i64, "opened with the fourth step");
  expect(w.doorPassable(door), "passable");

  // reversing half way: from the pose it had
  expect(w.activate(player, door), "use again closes it");
  w.takeEvents();
  mut w2 = World.make();
  imm p2 = w2.create(CLASS_CHARACTER);
  w2.setPosition(p2, new Vec3(0., 0., -2.));
  imm d2 = w2.create(CLASS_DOOR);
  w2.addDoor(d2, Door.hinged(d2, new Vec3(0., 0., 0.), new Vec3(0., 1., 0.), pi / 2., 1.));
  w2.setDoorLocked(d2, false);
  w2.addInteractable(d2, 3., 0.5, false, new Vec3(0., 0., -1.), VERB_USE);
  w2.activate(p2, d2);
  w2.step(0.5);
  w2.activate(p2, d2);
  expectFloat(f64.from(w2.doorOpenness(d2, 0.5)), 0.5, 0.00001, "reversal starts from where it was");
  expectFloat(f64.from(w2.doorOpenness(d2, 0.75)), 0.421875, 0.00001, "and swings back");
  expectFloat(f64.from(w2.doorOpenness(d2, 1.5)), 0., 0.00001, "closed again");

  // too far, or turned away: refused
  mut w3 = World.make();
  imm p3 = w3.create(CLASS_CHARACTER);
  imm d3 = w3.create(CLASS_DOOR);
  w3.addDoor(d3, Door.hinged(d3, new Vec3(0., 0., 0.), new Vec3(0., 1., 0.), pi / 2., 1.));
  w3.setDoorLocked(d3, false);
  w3.addInteractable(d3, 3., 0.5, false, new Vec3(0., 0., -1.), VERB_USE);
  w3.setPosition(p3, new Vec3(0., 0., -10.));
  expect(not w3.activate(p3, d3), "too far is refused");
  mut ev3 = w3.takeEvents();
  expectFloat(f64.from((*ev3[0]).value.num), f64.from(DENY_RANGE), 0.0001, "the reason is range");
  w3.setPosition(p3, new Vec3(0., 0., -2.));
  w3.setTransform(p3, new Transform3(new Vec3(0., 0., -2.), Quat.angleAxis(pi, new Vec3(0., 1., 0.)), new Vec3(1., 1., 1.)));
  expect(not w3.activate(p3, d3), "facing away is refused");
  mut ev4 = w3.takeEvents();
  expectFloat(f64.from((*ev4[0]).value.num), f64.from(DENY_FACING), 0.0001, "the reason is facing");

  // needFront: on the back side of a door that wants its front
  mut w5 = World.make();
  imm p5 = w5.create(CLASS_CHARACTER);
  imm d5 = w5.create(CLASS_DOOR);
  w5.addDoor(d5, Door.sliding(d5, new Vec3(2., 0., 0.), 2.));
  w5.setDoorLocked(d5, false);
  w5.addInteractable(d5, 3., -1., true, new Vec3(0., 0., -1.), VERB_USE);
  w5.setPosition(p5, new Vec3(0., 0., 2.));                    // behind the door's front (-z)
  expect(not w5.activate(p5, d5), "behind the door is refused when it has a front");
  w5.setPosition(p5, new Vec3(0., 0., -2.));
  expect(w5.activate(p5, d5), "in front is allowed");
  expectFloat(f64.from(w5.doorOpenness(d5, 1.)), 0.5, 0.00001, "sliding door half open at 1 s");
  expectFloat(f64.from(w5.doorPose(d5, 1.).translation.x), 1., 0.00001, "and moved 1 m");

  // auto close
  mut w6 = World.make();
  imm p6 = w6.create(CLASS_CHARACTER);
  w6.setPosition(p6, new Vec3(0., 0., -2.));
  imm d6 = w6.create(CLASS_DOOR);
  w6.addDoor(d6, Door.sliding(d6, new Vec3(2., 0., 0.), 1.));
  w6.setDoorLocked(d6, false);
  w6.setDoorAutoClose(d6, 2.);
  w6.addInteractable(d6, 3., 0.5, false, new Vec3(0., 0., -1.), VERB_USE);
  w6.activate(p6, d6);
  mut t = 0;
  mut closedAt = -1.;
  while t < 24 {
    w6.step(0.25);
    mut ev = w6.takeEvents();
    if count(&ev, EV_DOOR_CLOSING) > 0i64 and closedAt < 0. { closedAt = w6.now; }
    t = t + 1;
  }
  expectFloat(f64.from(closedAt), 3., 0.0001, "auto-close starts at 3 s (1 s swing + 2 s)");
  expect(not w6.doorWantsOpen(d6), "and it is closed by the end");
  done();
}
