// Locked doors and keys, inventories, and things held. By hand:
//
// The locked door: without the key use is refused (DENY_LOCKED) and the door
// stays shut; the key lies on the floor 1 m from the player, is used (picked
// up: it is a stackable item, so it merges into the pocket and the thing on the
// floor is gone), then the door is used: EV_USED, EV_DOOR_UNLOCKED, EV_DOOR_OPENING
// in that order, and the key is used up (consumeKey).
//
// Inventory: coins stack to 10 with 2 slots: adding 15 gives 10 + 5; adding 10
// more fills the second slot to 10 and has no slot left for the rest: 5 go in,
// 20 held. Removing 12 leaves 8; their weight is 8 * 0.1 = 0.8. A pack of 5
// slots and a weight limit of 1.0 takes floor(1.0 / 0.4) = 2 stones of 0.4 kg.
//
// A bag held in a hand: the character at (10, 0, 0) turned 90 degrees about +y
// (a vector (x, y, z) goes to (x cos + z sin, y, -x sin + z cos) = (z, y, -x)).
// The hand bone's pose in the character's frame is a move of (0.5, 1.0, 0); the
// bag's offset from the hand is (0.1, 0, 0.2); so in the character's frame the
// bag is at (0.6, 1.0, 0.2) and in the world at (10 + 0.2, 1.0, -0.6). With
// the character moved to (0, 0, 5): (0.2, 1.0, 4.4).
//
// A bag with 3 slots (weight 1 kg) holding 4 coins: the character who carries
// the bag in a slot weighs 1 + 0.4 = 1.4.

mod holding;

import collections use *;
import testing use *;
import geomath use *;
import worldinteract use *;

fn count(evs &List[Event], kind u32) i64 {
  var n = 0i64;
  var i = 0usize;
  while i < evs.len() {
    if (*evs[i]).kind == kind { n = n + 1i64; }
    i = i + 1usize;
  }
  n;
}

fn at(evs &List[Event], kind u32) i64 {
  var i = 0usize;
  while i < evs.len() {
    if (*evs[i]).kind == kind { return i64.from(i); }
    i = i + 1usize;
  }
  -1i64;
}

fn hand(parent u32, bone u32) Transform3 {
  new Transform3(new Vec3(0.5, 1., 0.), Quat.identity(), new Vec3(1., 1., 1.));
}

fn main() i32 {
  var w = World.make();
  let key = w.defineItem("red key", 9u32, 0.05, false);
  let coin = w.defineItem("coin", 10u32, 0.1, false);
  let stone = w.defineItem("stone", 9u32, 0.4, false);
  let bagKind = w.defineItem("bag", 1u32, 1., true);

  // ---- the locked door ----
  let player = w.create(CLASS_CHARACTER);
  w.setPosition(player, new Vec3(0., 0., -2.));
  w.addInventory(player, 6u32, 0.);
  let door = w.create(CLASS_DOOR);
  w.addDoor(door, Door.hinged(door, new Vec3(0., 0., 0.), new Vec3(0., 1., 0.), pi / 2., 1.));
  w.setDoorLocked(door, true);
  w.setDoorKey(door, key, true, true);
  w.addInteractable(door, 3., 0., false, new Vec3(0., 0., -1.), VERB_USE);
  let keyThing = w.makeItem(key, 1u32, new Vec3(0., 0., -1.));
  w.addInteractable(keyThing, 2., -1., false, new Vec3(0., 0., 0.), VERB_USE);

  expect(not w.activate(player, door), "locked, no key: refused");
  var ev = w.takeEvents();
  expectFloat(f64.from((*ev[0]).value.num), f64.from(DENY_LOCKED), 0.0001, "the reason is the lock");
  expect(not w.doorWantsOpen(door), "still shut");
  w.step(5.);
  expect(not w.doorWantsOpen(door), "and shut after time passes");

  expect(w.activate(player, keyThing), "use the key on the floor");
  expectInt(i64.from(w.invCount(player, key)), 1i64, "the key is in the pocket");
  expect(not w.exists(keyThing), "and gone from the floor");
  w.takeEvents();
  expect(w.activate(player, door), "locked, with the key: allowed");
  var ev2 = w.takeEvents();
  expect(at(&ev2, EV_USED) >= 0i64 and at(&ev2, EV_USED) < at(&ev2, EV_DOOR_UNLOCKED), "used, then unlocked");
  expect(at(&ev2, EV_DOOR_UNLOCKED) < at(&ev2, EV_DOOR_OPENING), "then opening");
  expect(w.doorWantsOpen(door), "the door is opening");
  expect(not w.doorIsLocked(door), "unlocked");
  expectInt(i64.from(w.invCount(player, key)), 0i64, "the key was used up");

  // a door with no key kind cannot be opened by use at all
  let vault = w.create(CLASS_DOOR);
  w.addDoor(vault, Door.sliding(vault, new Vec3(0., 3., 0.), 1.));
  w.setDoorLocked(vault, true);
  w.setPosition(vault, new Vec3(0., 0., -1.));
  w.addInteractable(vault, 5., -1., false, new Vec3(0., 0., 0.), VERB_USE);
  expect(not w.activate(player, vault), "a script-only lock refuses use");

  // ---- inventories ----
  let a = w.create(CLASS_CHARACTER);
  w.addInventory(a, 2u32, 0.);
  expectInt(i64.from(w.invAdd(a, coin, 15u32)), 15i64, "15 coins fit as 10 + 5");
  expectInt(i64.from(w.invAdd(a, coin, 10u32)), 5i64, "5 more: the second slot fills, no third slot");
  expectInt(i64.from(w.invCount(a, coin)), 20i64, "20 held");
  expectInt(i64.from(w.invRemove(a, coin, 12u32)), 12i64, "12 come out");
  expectInt(i64.from(w.invCount(a, coin)), 8i64, "8 left");
  expectFloat(f64.from(w.invWeight(a)), 0.8, 0.0001, "they weigh 0.8");
  let b = w.create(CLASS_CHARACTER);
  w.addInventory(b, 5u32, 1.);
  expectInt(i64.from(w.invAdd(b, stone, 5u32)), 2i64, "a weight limit of 1.0 takes two 0.4 kg stones");
  // 0.2 kg free in b's pack: two 0.1 kg coins of the three offered go over, one stays
  expectInt(i64.from(w.give(a, b, coin, 3u32)), 2i64, "give 3 coins: only 2 fit by weight");
  expectInt(i64.from(w.invCount(a, coin)), 6i64, "the giver keeps 6 of 8");
  expectInt(i64.from(w.invCount(b, coin)), 2i64, "the taker has 2");

  // ---- a bag held in a hand ----
  let walker = w.create(CLASS_CHARACTER);
  w.setTransform(walker, new Transform3(new Vec3(10., 0., 0.), Quat.angleAxis(pi / 2., new Vec3(0., 1., 0.)), new Vec3(1., 1., 1.)));
  w.addInventory(walker, 4u32, 0.);
  let bag = w.makeItem(bagKind, 1u32, new Vec3(10., 0., 0.5));
  w.addInventory(bag, 3u32, 0.);
  w.attach(bag, walker, 7u32, new Transform3(new Vec3(0.1, 0., 0.2), Quat.identity(), new Vec3(1., 1., 1.)));
  let p1 = w.worldTransform(bag, &hand).translation;
  expectFloat(f64.from(p1.x), 10.2, 0.0001, "the bag in the hand: x");
  expectFloat(f64.from(p1.y), 1., 0.0001, "y");
  expectFloat(f64.from(p1.z), -0.6, 0.0001, "z");
  w.setPosition(walker, new Vec3(0., 0., 5.));
  let p2 = w.worldTransform(bag, &hand).translation;
  expectFloat(f64.from(p2.x), 0.2, 0.0001, "the character moved: the bag followed, x");
  expectFloat(f64.from(p2.z), 4.4, 0.0001, "and z");
  expect(w.parentOf(bag) == walker, "held by the walker");
  expect(not w.isHidden(bag), "a bag in the hand is seen");
  w.detach(bag);
  expectFloat(f64.from(w.worldTransform(bag, &hand).translation.z), 0.5, 0.0001, "detached, it is where it was: its own placement");

  // pick the bag up into a slot, put coins into it, weigh the lot
  expect(w.pickUp(walker, bag, 100.), "the bag goes into a slot");
  expect(w.isHidden(bag), "inside the walker, not drawn");
  expectInt(i64.from(w.invCount(walker, bagKind)), 1i64, "the walker holds a bag");
  expect(w.invAdd(bag, coin, 4u32) == 4u32, "four coins go into the bag");
  expectFloat(f64.from(w.invWeight(walker)), 1.4, 0.0001, "the walker carries 1 + 0.4");
  expectInt(i64.from(w.give(a, bag, coin, 1u32)), 1i64, "a coin handed into the bag");
  expect(w.dropEntity(walker, bag, new Vec3(3., 0., 3.)), "the bag is put down");
  expect(not w.isHidden(bag), "and is seen again");
  expectFloat(f64.from(w.positionOf(bag).x), 3., 0.0001, "where it was put");
  expectInt(i64.from(w.invCount(walker, bagKind)), 0i64, "no longer in the slot");
  expectInt(i64.from(w.invCount(bag, coin)), 5i64, "its coins stayed in it");

  // pocket to hand and back
  expect(w.pickUp(walker, bag, 100.), "the bag is picked up again");
  expect(w.hold(walker, bag, 7u32, new Transform3(new Vec3(0.1, 0., 0.2), Quat.identity(), new Vec3(1., 1., 1.))), "taken into the hand");
  expectInt(i64.from(w.invCount(walker, bagKind)), 0i64, "no longer in a slot");
  expectFloat(f64.from(w.worldTransform(bag, &hand).translation.z), 4.4, 0.0001, "in the hand of the walker at (0, 0, 5): z");
  expect(w.stow(walker, bag), "put back in the pocket");
  expectInt(i64.from(w.invCount(walker, bagKind)), 1i64, "in a slot again");
  expect(w.isHidden(bag), "and out of sight");
  done();
}
