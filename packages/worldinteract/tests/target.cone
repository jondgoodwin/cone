// Targeting. Eye at the origin looking along +z, up +y; forward x up = -x, so
// the viewer's right is -x. Candidates:
//   1 at (0, 0, 10)    dead ahead, 10 m
//   2 at (-5, 0, 10)   to the right, angle atan(5/10) = 26.565 deg, 11.18 m
//   3 at (5, 0, 10)    to the left, the same angle and distance
//   4 at (0, 0, 30)    beyond the 20 m range
//   5 at (0, 0, 5)     ahead, 5 m, but a wall (id 99) at 3 m hides it
// With the standard dials: cost = 2 * angle/45deg + 1 * dist/20.
//   1: 0 + 0.5 = 0.5      2: 2 * 26.565/45 + 11.18/20 = 1.1804 + 0.559 = 1.739
// so 1 wins. Locked on 1 and switching right (-x): the nearest bearing beyond
// 1's is 2's (bearing +26.565 deg), left is 3's (-26.565 deg).

mod target;

import collections use *;
import testing use *;
import geomath use *;
import worldinteract use *;

fn wall(o Vec3, d Vec3, m f32) RayHit {
  // a wall across z = 3, id 99: hit by any ray going forward far enough
  if d.z > 0.0001 and m > 3. {
    let t = 3. / d.z;
    return new RayHit(true, t, 99u32);
  }
  new RayHit(false, 0., 0u32);
}

fn main() i32 {
  let eye = new Vec3(0., 0., 0.);
  let fwd = new Vec3(0., 0., 1.);
  let up = new Vec3(0., 1., 0.);
  var cands = List[Candidate].empty();
  cands.push(new Candidate(1u32, new Vec3(0., 0., 10.), 0.));
  cands.push(new Candidate(2u32, new Vec3(-5., 0., 10.), 0.));
  cands.push(new Candidate(3u32, new Vec3(5., 0., 10.), 0.));
  cands.push(new Candidate(4u32, new Vec3(0., 0., 30.), 0.));
  let p = TargetParams.standard();
  let open = fn(o Vec3, d Vec3, m f32) RayHit { new RayHit(false, 0., 0u32); };

  expectFloat(f64.from(cost(eye, fwd, cands[0], &p, false, &open)), 0.5, 0.0001, "cost of the one ahead");
  expectFloat(f64.from(cost(eye, fwd, cands[1], &p, false, &open)), 1.7394, 0.001, "cost of one to the side");
  expectFloat(f64.from(cost(eye, fwd, cands[3], &p, false, &open)), -1., 0.0001, "out of range is invalid");
  expectInt(i64.from(best(eye, fwd, &cands, &p, 0u32, &open)), 1i64, "the one dead ahead is picked");

  // Looking straight at 2: its cost is 0.559 against 1's 2 * 26.565/45 + 0.5 = 1.68
  let aimRight = new Vec3(-0.5, 0., 1.).normalize();
  expectInt(i64.from(best(eye, aimRight, &cands, &p, 0u32, &open)), 2i64, "looking right picks the right-hand one");

  // Stickiness: with 3 current, looking dead ahead, 3's cost 1.739 * 0.75 = 1.304 still loses to 1's 0.5
  expectInt(i64.from(best(eye, fwd, &cands, &p, 3u32, &open)), 1i64, "stickiness does not hold a poor target");
  // but between two equals the current one wins: 2 and 3 only
  var pair = List[Candidate].empty();
  pair.push(new Candidate(2u32, new Vec3(-5., 0., 10.), 0.));
  pair.push(new Candidate(3u32, new Vec3(5., 0., 10.), 0.));
  expectInt(i64.from(best(eye, fwd, &pair, &p, 3u32, &open)), 3i64, "between equals the current one stays");
  expectInt(i64.from(best(eye, fwd, &pair, &p, 0u32, &open)), 2i64, "between equals with none current the lower id");

  // Line of sight: the wall hides a candidate at 5 m
  var hidden = List[Candidate].empty();
  hidden.push(new Candidate(5u32, new Vec3(0., 0., 5.), 0.));
  expectInt(i64.from(best(eye, fwd, &hidden, &p, 0u32, &wall)), 0i64, "a wall hides the candidate");
  expectInt(i64.from(best(eye, fwd, &hidden, &p, 0u32, &open)), 5i64, "no wall, it is seen");

  // Lock on and switch
  var lock = LockOn.make(0.5);
  expectInt(i64.from(lock.acquire(eye, fwd, &cands, &p, &open)), 1i64, "lock acquires the best");
  expectInt(i64.from(lock.switchSide(1., eye, fwd, up, &cands, &p, &open)), 2i64, "switch right goes to -x");
  expectInt(i64.from(lock.switchSide(1., eye, fwd, up, &cands, &p, &open)), 2i64, "nothing further right: stays");
  expectInt(i64.from(lock.switchSide(-1., eye, fwd, up, &cands, &p, &open)), 1i64, "switch left back to the middle");
  expectInt(i64.from(lock.switchSide(-1., eye, fwd, up, &cands, &p, &open)), 3i64, "and on to the left one");
  expect(abs32(bearing(fwd, up, new Vec3(-5., 0., 10.)) - 0.46365) < 0.001, "bearing of a point to the right is +atan(0.5)");

  // Lock holds through a loss shorter than the grace and drops after it
  var gone = List[Candidate].empty();
  gone.push(new Candidate(3u32, new Vec3(5., 0., 200.), 0.));
  expectInt(i64.from(lock.update(0.3, eye, &gone, &p, &open)), 3i64, "lost 0.3 s: kept");
  expectInt(i64.from(lock.update(0.3, eye, &gone, &p, &open)), 0i64, "lost 0.6 s: dropped");

  // Aim assist: aiming 5 degrees off candidate 1 at strength 1 over a 45 degree cone pulls by 1 - 5/45 = 0.889
  let off = new Vec3(0.0871557, 0., 0.9961947);
  var one = List[Candidate].empty();
  one.push(new Candidate(1u32, new Vec3(0., 0., 10.), 0.));
  let out = aimAssist(eye, off, &one, &p, 1., &defaultBlend, &open);
  // blend of (0.08716, 0.99619) and (0, 1) at 0.8889: x = 0.08716 * 0.1111 = 0.009684 before normalising
  expect(out.x > -0.0001 and out.x < 0.0105, "aim assist pulls the aim nearly onto the target");
  let none = aimAssist(eye, new Vec3(1., 0., 0.), &one, &p, 1., &defaultBlend, &open);
  expectFloat(f64.from(none.x), 1., 0.0001, "no target in the cone leaves the aim alone");
  done();
}

fn abs32(v f32) f32 { if v < 0. { 0. - v; } else { v; }; }
