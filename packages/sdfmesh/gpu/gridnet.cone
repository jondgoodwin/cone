// gridnet: sdfmesh's GPU half, surface nets of a sampled grid. Congo
// compiles it twice: into sdfmesh for the CPU, as the submodule 'gridnet',
// whose kernels are their own CPU twins; and for the GPU, without src/, into
// build/<mode>/sdfmesh.spv. src/gridmesher.cone runs the kernels, on the GPU
// through gpuwork or on the CPU as their twins.
//
// THE SAME MESH AS THE CPU'S. Given the samples surfaceNet takes (sdf's
// SampleGrid.covering of the same box and cell size), these kernels make
// surfaceNet's dense, unrelaxed net bit for bit: the same vertices in the
// same order at the same f32 bits, and the same quads, cut into triangles
// along the shorter diagonal as SurfaceNet.toMesh cuts them. What differs:
// the normals, which surfaceNet takes from the shape's gradient and these
// from the grid (below); relaxation, which needs the shape, and is not done;
// and sparse sampling, which is the sampler's business, not the mesher's.
//
// DETERMINISTIC, ON EVERY GPU AND ON THE TWIN. Nothing depends on timing:
// no atomics, no float reduction across invocations. Each vertex's place in
// the output is its cell's place in an exclusive prefix sum of the cells'
// vertex counts, z then y then x as surfaceNet visits them, and each quad's
// its grid edge's in a prefix sum of the samples' quad counts; the sums are
// integer, made by one invocation looping over a block of 256 in index
// order ('scanTotals', 'scanApply'), level upon level. So the vertices and
// quads come out in surfaceNet's own order. The float arithmetic is the
// CPU's: additions, subtractions and multiplications only, each rounded on
// its own (conec forbids fusing on the GPU), and a GPU's division and
// square root, which Vulkan lets be 2.5 and 1 ulp off, are replaced by
// sdf's 'divExact' and 'sqrtExact', IEEE's correctly rounded division and
// square root from integer steps. So the twin and every GPU give the same
// bits, and the CPU mesher's division, d0 / (d0 - d1), is matched exactly.
//
// THE PASSES, one invocation each (64 a workgroup):
//   classify     a cell: its corners' signs (its config) and its vertex count
//   countQuads   a sample: how many of its three grid edges carry a quad
//   scanTotals   a block of 256 counts: their sum
//   scanApply    a block of 256 counts: each made the exclusive sum before it
//   gather       the two totals, vertices and quads, for the CPU to size by
//   place        a cell: its vertices, normals and cell numbers
//   emit         a sample: the quads across its edges, as two triangles each
//
// NORMALS FROM THE GRID. The mesher never sees the shape, so a vertex's
// normal is the field's gradient as the grid gives it: at each corner of its
// cell the central difference of the samples either side on each axis (one
// sided, doubled, at the grid's faces), blended trilinearly at the vertex's
// place in the cell, made a unit vector ((1, 0, 0) where it is zero). This is
// marching cubes' normal (Lorensen and Cline, 1987). It is second order in
// the cell, as surfaceNet's central differences are in their h (a tenth of a
// cell), but over a whole cell, so it is smoother and less exact than the
// shape's gradient where the surface curves within a cell.
//
// Buffers hold 32-bit numbers only, so a cell's config, a count and an index
// are each a u32 word. Buffer sizes: values one f32 a sample; configs one
// word a cell; the cells' counts and offsets one word a cell plus one (the
// last becomes the total); the samples' the same; positions and normals a
// Vec3 a vertex; vertexCells a word a vertex; indices six words a quad.

mod gridnet;

import geomath use *;
import sdf use SampleGrid, divExact, sqrtExact;

// A piece number meaning "the surface does not cross this edge", in the
// packed tables
pub const NoPieceBits = 15u32;

// Counts summed by one invocation, in index order
pub const ScanBlock = 256u32;

// What a scan pass is given: how many counts at this level
pub struct ScanStep {
  pub count u32;
}

// What 'gather' is given: the cells and the samples
pub struct NetTotals {
  pub cells u32;
  pub samples u32;
}

// ---- A cell's corners, edges and pieces ----
//
// As src/mesher.cone numbers them: corner c of a cell is at offset (c & 1,
// c >> 1 & 1, c >> 2 & 1); edge e runs along axis a = e / 4, at offset
// e & 1 along axis (a + 1) % 3 and e >> 1 & 1 along axis (a + 2) % 3.

fn cornerBit(c u32, axis u32) u32 { (c >> axis) & 1u32; }

fn edgeStart(e u32) u32 {
  imm a = e / 4u32;
  ((e & 1u32) << ((a + 1u32) % 3u32)) | (((e >> 1u32) & 1u32) << ((a + 2u32) % 3u32));
}
fn edgeEnd(e u32) u32 { edgeStart(e) | (1u32 << (e / 4u32)); }

// The pieces of a cell, from surfaceNet's tables packed two words a config
// (src/gridmesher.cone packs them): word 0 holds edges 0 to 7's piece
// numbers, four bits each, and word 1 edges 8 to 11's, then the count of
// pieces in bits 16 to 19; NoPieceBits is an edge not crossed
pub fn tablePieces(tables &[]u32, config u32) u32 {
  (tables[usize.from(2u32 * config + 1u32)] >> 16u32) & 15u32;
}
pub fn tableEdge(tables &[]u32, config u32, e u32) u32 {
  if e < 8u32 {
    (tables[usize.from(2u32 * config)] >> (4u32 * e)) & 15u32;
  } else {
    (tables[usize.from(2u32 * config + 1u32)] >> (4u32 * (e - 8u32))) & 15u32;
  };
}

// ---- The grid ----

// The invocation's number, the dispatch flattened: x, then rows of x
// workgroups of 64 (a dispatch is at most 65,535 workgroups a side)
fn flatId(inv Invocation) u32 {
  inv.globalId[0usize] + inv.globalId[1usize] * inv.groupCount[0usize] * 64u32;
}

fn sampleAt(g SampleGrid, x u32, y u32, z u32) usize { usize.from(x + g.samplesX * (y + g.samplesY * z)); }

// The sample at corner c of cell (x, y, z)
fn cornerValue(g SampleGrid, values &[]f32, x u32, y u32, z u32, c u32) f32 {
  values[sampleAt(g, x + cornerBit(c, 0u32), y + cornerBit(c, 1u32), z + cornerBit(c, 2u32))];
}

// Cell (x, y, z)'s config: bit c set when its corner c is inside (below 0)
fn cellConfig(g SampleGrid, values &[]f32, x u32, y u32, z u32) u32 {
  mut config = 0u32;
  mut c = 0u32;
  while c < 8u32 {
    if cornerValue(g, values, x, y, z, c) < 0. { config = config | (1u32 << c); }
    c = c + 1u32;
  }
  config;
}

fn pick(a u32, x u32, y u32, z u32) u32 { if a == 0u32 { x; } elif a == 1u32 { y; } else { z; }; }

// The cell number of the cell at (pa, pu, pv) along (a, a + 1, a + 2)
fn cellAlong(g SampleGrid, a u32, pa u32, pu u32, pv u32) u32 {
  imm nx = g.samplesX - 1u32;
  imm ny = g.samplesY - 1u32;
  if a == 0u32 { pa + nx * (pu + ny * pv); }
  elif a == 1u32 { pv + nx * (pa + ny * pu); }
  else { pu + nx * (pv + ny * pa); };
}

// Whether sample (x, y, z)'s edge along axis a carries a quad: the four
// cells round it are in the grid and its ends' signs differ. Its lower end
// is corner 3 of the edge, a * 4 + 3, of the cell below it on the other two
// axes, whose config says both
fn quadEdge(g SampleGrid, tables &[]u32, configs &[]u32, x u32, y u32, z u32, a u32) Bool {
  imm u = (a + 1u32) % 3u32;
  imm w = (a + 2u32) % 3u32;
  imm pa = pick(a, x, y, z);
  imm pu = pick(u, x, y, z);
  imm pv = pick(w, x, y, z);
  imm na = pick(a, g.samplesX, g.samplesY, g.samplesZ) - 1u32;
  imm nu = pick(u, g.samplesX, g.samplesY, g.samplesZ) - 1u32;
  imm nv = pick(w, g.samplesX, g.samplesY, g.samplesZ) - 1u32;
  if !(pa < na and pu >= 1u32 and pu < nu and pv >= 1u32 and pv < nv) { return false; }
  imm config = configs[usize.from(cellAlong(g, a, pa, pu - 1u32, pv - 1u32))];
  tableEdge(tables, config, a * 4u32 + 3u32) != NoPieceBits;
}

// ---- The passes ----

// Each cell's config, and how many vertices it has (its pieces). 'counts'
// has a word more than there are cells, which invocation 0 makes 0 and the
// scan the total (no buffer need start as zeros)
pub fn @compute(64) classify(inv Invocation, g SampleGrid, tables &[]u32, values &[]f32, configs &[]mut u32,
    counts &[]mut u32) {
  imm i = flatId(inv);
  imm nx = g.samplesX - 1u32;
  imm ny = g.samplesY - 1u32;
  imm cells = nx * ny * (g.samplesZ - 1u32);
  if i == 0u32 { counts[usize.from(cells)] = 0u32; }
  if i < cells {
    imm config = cellConfig(g, values, i % nx, (i / nx) % ny, i / (nx * ny));
    configs[usize.from(i)] = config;
    counts[usize.from(i)] = tablePieces(tables, config);
  }
}

// How many of each sample's three edges carry a quad. 'counts' has a word
// more than there are samples, which invocation 0 makes 0
pub fn @compute(64) countQuads(inv Invocation, g SampleGrid, tables &[]u32, configs &[]u32, counts &[]mut u32) {
  imm i = flatId(inv);
  imm samples = g.samplesX * g.samplesY * g.samplesZ;
  if i == 0u32 { counts[usize.from(samples)] = 0u32; }
  if i < samples {
    imm x = i % g.samplesX;
    imm y = (i / g.samplesX) % g.samplesY;
    imm z = i / (g.samplesX * g.samplesY);
    mut n = 0u32;
    mut a = 0u32;
    while a < 3u32 {
      if quadEdge(g, tables, configs, x, y, z, a) { n = n + 1u32; }
      a = a + 1u32;
    }
    counts[usize.from(i)] = n;
  }
}

// The sum of each block of ScanBlock counts (the last block may be short)
pub fn @compute(64) scanTotals(inv Invocation, s ScanStep, items &[]u32, totals &[]mut u32) {
  imm b = flatId(inv);
  imm start = b * ScanBlock;
  if start < s.count {
    imm end = if s.count - start < ScanBlock { s.count; } else { start + ScanBlock; };
    mut sum = 0u32;
    mut i = start;
    while i < end {
      sum = sum + items[usize.from(i)];
      i = i + 1u32;
    }
    totals[usize.from(b)] = sum;
  }
}

// Each block of ScanBlock counts made exclusive sums, the block's from
// 'bases[b]', in index order
pub fn @compute(64) scanApply(inv Invocation, s ScanStep, items &[]mut u32, bases &[]u32) {
  imm b = flatId(inv);
  imm start = b * ScanBlock;
  if start < s.count {
    imm end = if s.count - start < ScanBlock { s.count; } else { start + ScanBlock; };
    mut run = bases[usize.from(b)];
    mut i = start;
    while i < end {
      imm v = items[usize.from(i)];
      items[usize.from(i)] = run;
      run = run + v;
      i = i + 1u32;
    }
  }
}

// The vertices and quads in all, the last words of the two scans
pub fn @compute(64) gather(inv Invocation, t NetTotals, cellStarts &[]u32, quadStarts &[]u32, out &[]mut u32) {
  if flatId(inv) == 0u32 {
    out[0usize] = cellStarts[usize.from(t.cells)];
    out[1usize] = quadStarts[usize.from(t.samples)];
  }
}

// The gradient's direction at sample (x, y, z), unscaled: the central
// difference on each axis, or twice the one-sided one at the grid's faces
fn cornerGradient(g SampleGrid, values &[]f32, x u32, y u32, z u32) Vec3 {
  new Vec3(axisDifference(g, values, x, y, z, 0u32), axisDifference(g, values, x, y, z, 1u32),
    axisDifference(g, values, x, y, z, 2u32));
}

fn axisDifference(g SampleGrid, values &[]f32, x u32, y u32, z u32, a u32) f32 {
  imm p = pick(a, x, y, z);
  imm n = pick(a, g.samplesX, g.samplesY, g.samplesZ);
  imm dx = if a == 0u32 { 1u32; } else { 0u32; };
  imm dy = if a == 1u32 { 1u32; } else { 0u32; };
  imm dz = if a == 2u32 { 1u32; } else { 0u32; };
  imm here = values[sampleAt(g, x, y, z)];
  if p == 0u32 {
    2. * (values[sampleAt(g, x + dx, y + dy, z + dz)] - here);
  } elif p + 1u32 == n {
    2. * (here - values[sampleAt(g, x - dx, y - dy, z - dz)]);
  } else {
    values[sampleAt(g, x + dx, y + dy, z + dz)] - values[sampleAt(g, x - dx, y - dy, z - dz)];
  };
}

// The gradient at corner c of cell (x, y, z)
fn cellCornerGradient(g SampleGrid, values &[]f32, x u32, y u32, z u32, c u32) Vec3 {
  cornerGradient(g, values, x + cornerBit(c, 0u32), y + cornerBit(c, 1u32), z + cornerBit(c, 2u32));
}

// Corner c's trilinear weight at (u, v, w) = at in the cell: on each axis,
// the coordinate where the corner's bit is 1 and one minus it where 0, the
// product taken x, y, z
fn cornerWeight(at Vec3, c u32) f32 {
  imm wx = if cornerBit(c, 0u32) == 1u32 { at.x; } else { 1. - at.x; };
  imm wy = if cornerBit(c, 1u32) == 1u32 { at.y; } else { 1. - at.y; };
  imm wz = if cornerBit(c, 2u32) == 1u32 { at.z; } else { 1. - at.z; };
  wx * wy * wz;
}

// Each crossed cell's vertices, one per piece, where 'starts' (the scanned
// counts) puts them: at the average of the piece's edge crossings, each
// found by linear interpolation of the two ends' distances, as surfaceNet
// places them, with the grid's normal there and the cell's number
pub fn @compute(64) place(inv Invocation, g SampleGrid, tables &[]u32, values &[]f32, starts &[]u32,
    positions &[]mut Vec3, normals &[]mut Vec3, vertexCells &[]mut u32) {
  imm i = flatId(inv);
  imm nx = g.samplesX - 1u32;
  imm ny = g.samplesY - 1u32;
  if i >= nx * ny * (g.samplesZ - 1u32) { return; }
  imm x = i % nx;
  imm y = (i / nx) % ny;
  imm z = i / (nx * ny);
  imm config = cellConfig(g, values, x, y, z);
  imm n = tablePieces(tables, config);
  if n == 0u32 { return; }
  imm first = starts[usize.from(i)];
  imm cs = g.cellSize;
  imm corner = g.point(x, y, z);
  mut piece = 0u32;
  while piece < n {
    mut sum = new Vec3(0., 0., 0.);
    mut count = 0u32;
    mut e = 0u32;
    while e < 12u32 {
      if tableEdge(tables, config, e) == piece {
        imm c0 = edgeStart(e);
        imm d0 = cornerValue(g, values, x, y, z, c0);
        imm t = divExact(d0, d0 - cornerValue(g, values, x, y, z, edgeEnd(e)));
        imm a = e / 4u32;
        imm within = new Vec3(if a == 0u32 { t; } else { f32.from(cornerBit(c0, 0u32)); },
          if a == 1u32 { t; } else { f32.from(cornerBit(c0, 1u32)); },
          if a == 2u32 { t; } else { f32.from(cornerBit(c0, 2u32)); });
        sum = sum + within;
        count = count + 1u32;
      }
      e = e + 1u32;
    }
    imm avg = sum * divExact(1., f32.from(count));
    imm v = usize.from(first + piece);
    positions[v] = new Vec3(corner.x + cs * avg.x, corner.y + cs * avg.y, corner.z + cs * avg.z);

    // The corners' gradients blended at (u, v, w) = avg in the cell, corner
    // by corner in order, starting from corner 0's (not from zero, which
    // would turn a -0 into +0)
    mut grad = cellCornerGradient(g, values, x, y, z, 0u32) * cornerWeight(avg, 0u32);
    mut c = 1u32;
    while c < 8u32 {
      grad = grad + cellCornerGradient(g, values, x, y, z, c) * cornerWeight(avg, c);
      c = c + 1u32;
    }
    imm len2 = grad.x * grad.x + grad.y * grad.y + grad.z * grad.z;
    normals[v] = if len2 > 0. { grad * divExact(1., sqrtExact(len2)); } else { new Vec3(1., 0., 0.); };
    vertexCells[v] = i;
    piece = piece + 1u32;
  }
}

// The vertex of the cell at (pa, cu, cv) along (a, a + 1, a + 2) on the
// edge of sample (pa, pu, pv) along a
fn edgeVertex(g SampleGrid, tables &[]u32, configs &[]u32, starts &[]u32, a u32, pa u32, pu u32, pv u32,
    cu u32, cv u32) u32 {
  imm cell = cellAlong(g, a, pa, cu, cv);
  imm config = configs[usize.from(cell)];
  imm e = a * 4u32 + (pu - cu) + 2u32 * (pv - cv);
  starts[usize.from(cell)] + tableEdge(tables, config, e);
}

fn dot3(a Vec3, b Vec3) f32 { a.x * b.x + a.y * b.y + a.z * b.z; }

// The quads across each sample's edges, where 'quadStarts' puts them: the
// four cells round the edge counterclockwise seen from its outside end, as
// surfaceNet makes them, each cut into two triangles along its shorter
// diagonal (the first, 0 to 2, when they are equal), as SurfaceNet.toMesh
// cuts them: six indices a quad
pub fn @compute(64) emit(inv Invocation, g SampleGrid, tables &[]u32, configs &[]u32, starts &[]u32,
    quadStarts &[]u32, positions &[]Vec3, indices &[]mut u32) {
  imm i = flatId(inv);
  if i >= g.samplesX * g.samplesY * g.samplesZ { return; }
  imm x = i % g.samplesX;
  imm y = (i / g.samplesX) % g.samplesY;
  imm z = i / (g.samplesX * g.samplesY);
  mut slot = quadStarts[usize.from(i)];
  mut a = 0u32;
  while a < 3u32 {
    if quadEdge(g, tables, configs, x, y, z, a) {
      imm u = (a + 1u32) % 3u32;
      imm w = (a + 2u32) % 3u32;
      imm pa = pick(a, x, y, z);
      imm pu = pick(u, x, y, z);
      imm pv = pick(w, x, y, z);
      // Counterclockwise about +a
      imm v0 = edgeVertex(g, tables, configs, starts, a, pa, pu, pv, pu - 1u32, pv - 1u32);
      imm v1 = edgeVertex(g, tables, configs, starts, a, pa, pu, pv, pu, pv - 1u32);
      imm v2 = edgeVertex(g, tables, configs, starts, a, pa, pu, pv, pu, pv);
      imm v3 = edgeVertex(g, tables, configs, starts, a, pa, pu, pv, pu - 1u32, pv);
      // Outward is +a when the lower end is inside
      imm cell = cellAlong(g, a, pa, pu - 1u32, pv - 1u32);
      imm inside = cornerBit(configs[usize.from(cell)], edgeStart(a * 4u32 + 3u32)) == 1u32;
      imm qa = v0;
      imm qb = if inside { v1; } else { v3; };
      imm qc = v2;
      imm qd = if inside { v3; } else { v1; };
      imm ac = positions[usize.from(qc)] - positions[usize.from(qa)];
      imm bd = positions[usize.from(qd)] - positions[usize.from(qb)];
      imm o = usize.from(6u32 * slot);
      if dot3(ac, ac) <= dot3(bd, bd) {
        indices[o] = qa; indices[o + 1usize] = qb; indices[o + 2usize] = qc;
        indices[o + 3usize] = qa; indices[o + 4usize] = qc; indices[o + 5usize] = qd;
      } else {
        indices[o] = qa; indices[o + 1usize] = qb; indices[o + 2usize] = qd;
        indices[o + 3usize] = qb; indices[o + 4usize] = qc; indices[o + 5usize] = qd;
      }
      slot = slot + 1u32;
    }
    a = a + 1u32;
  }
}
