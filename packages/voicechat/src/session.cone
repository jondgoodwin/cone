// ======== The options, the models, the loop ========
//
// WHAT RUNS WHERE. `run` loads Qwen3 (llmrun), Parakeet (speechtotext) and Kokoro (texttospeech) onto the one Device it is
// given, warms each (the first use of a GPU pipeline costs more than the second), and only then opens the audio, so the
// microphone's clock starts with the models ready. A turn is: listen (the detector ends an utterance), hear (Parakeet writes
// the turn so far; its punctuation says whether the turn is over, or waits for more speech: turns.cone), think (the turn's
// tokens into Qwen's cache) and answer (the loop that writes, speaks and listens for an interruption). A turn that is a
// goodbye ends the session; so does Ctrl-C, which the loop asks voiceaudio's Interrupt for.
//
// Every number printed after a turn is a measurement of that turn: the end of the speech is where the detector says the
// speech ended (the microphone's sample index, which on a real-time device is the clock), and each later stage is a
// stamp on this thread.

// The speaking-aloud instruction. Qwen3 is told this in a system turn once, at the start of the conversation.
pub const SYSTEM_LINE = "You are talking with a person by voice; your reply is read aloud by a speech synthesizer. Answer in short, plain, natural spoken sentences, one to three unless the person asks for more. Never use markdown, lists, bullet points, headings, tables, code, emoji or symbols. Write numbers and abbreviations as you would say them.";

// Everything a spoken conversation is set up with. `defaults` gives each field the value the program uses unasked.
pub struct VoiceOptions {
  pub model: String;          // the Qwen3 GGUF
  pub ctx: usize;             // positions of context
  pub temperature: f64;
  pub topK: usize;
  pub topP: f64;
  pub seed: u64;
  pub maxTokens: usize;       // the longest reply, in tokens (a spoken answer that runs on is cut)
  pub system: String;         // the system turn's text
  pub sttModel: String;       // Parakeet's safetensors and vocabulary
  pub sttVocab: String;
  pub ttsDir: String;         // Kokoro's folder
  pub voice: String;          // a voice name, or a blend: "af_heart:0.7,bf_emma:0.3"
  pub speed: f32;
  pub audio: String;          // "system", "disk" or "dummy"
  pub inFile: String;         // disk: the raw f32 file the microphone reads (44.1 kHz mono)
  pub outFile: String;        // disk: the raw f32 file the speaker writes (44.1 kHz stereo)
  pub timescale: String;      // disk: "1" real time
  pub deviceFrames: u32;      // system: the speaker's buffer in frames, small makes the cut-off quick
  // The detector's thresholds are multiplied by this while the speaker has sound waiting, because the room hears the
  // speaker and the microphone hears the room. The detector's start level is 10 dB over the noise floor and its
  // continue level 6 dB; 3 is a factor of 3 in amplitude, 9.5 dB: a laptop speaker's bleed that raises the floor's
  // reading by up to that is not speech, while a person speaking over it, who is louder than the bleed at the
  // microphone, still is. A guess to be tuned on a real device (with a headset, 1 is enough).
  pub thresholdScale: f32;
  // Where a turn ends (turns.cone has the rule): after this much silence when Parakeet's text for what was said so far ends a
  // sentence (a full stop, question mark or exclamation mark) ...
  pub endSilenceMs: u32;
  // ... and after this much when it does not (the person paused inside a sentence); speech before then is joined to the turn
  pub unfinishedSilenceMs: u32;
  pub runSeconds: u32;        // 0: until the program is stopped
  pub echoTimings: bool;
  pub keepWarm: bool;         // work for the GPU while the person speaks, to keep its clock up for the recognition

  pub fn defaults(model: &str) VoiceOptions {
    VoiceOptions(String.from(model), 4096usize, 0.7, 20usize, 0.8, 1u64, 400usize, String.from(SYSTEM_LINE),
        String.from("C:\\src\\speech-models\\parakeet-tdt-0.6b-v2.f16.safetensors"),
        String.from("C:\\src\\speech-models\\parakeet-tdt-0.6b-v2.vocab.txt"),
        String.from("C:/src/speech-models/kokoro"), String.from("af_heart"), 1.0f, String.from("system"),
        String.empty(), String.empty(), String.from("1"), 480u32, 3.0f, 400u32, 1500u32, 0u32, true, true)
  }
}

fn say(msg: &str) { eprintStr(msg); }

fn seconds(later: Instant, earlier: Instant) f64 { later.since(earlier).secondsF64() }

// Seconds with two decimals: 1.234 is "1.23"
fn fmt2(x: f64) String {
  var s = String.empty();
  var v = x;
  if v < 0.0 { s <- "-"; v = 0.0 - v; }
  let hundredths = u64.from(v * 100.0 + 0.5);
  s <- hundredths / 100u64;
  s <- ".";
  let f = hundredths % 100u64;
  if f < 10u64 { s <- "0"; }
  s <- f;
  s
}

fn containsLetter(s: &str) bool {
  var i = 0usize;
  while i < s.len() {
    let c = s[i];
    if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') { return true; }
    i = i + 1usize;
  }
  false
}

fn bytesOf(s: &str) List[u8] {
  var out = List[u8].empty();
  let b: &Array[u8] = s;
  var i = 0usize;
  while i < b.len { out.push(b[i]); i = i + 1usize; }
  out
}

// The ids that open a user turn: what closes the reply before it (when there was one), <|im_start|> and "user\n". The
// turn's words and its end (`tailTokens`) follow. Together they are what `ModelTokens.userTurn` makes; the text is
// encoded apart from "user\n", which the pre-tokenizer does anyway (a newline never joins the letters after it).
pub fn headTokens(vocab: &llmrun.ModelTokens, closeFirst: bool) List[u32] {
  var out = List[u32].empty();
  if closeFirst {
    let c = vocab.closeTurn();
    var i = 0usize;
    while i < c.len() { out.push(*c[i]); i = i + 1usize; }
  }
  out.push(vocab.imStart);
  let user = bytesOf("user\n");
  vocab.text(user.view(), &mut out);
  out
}

// What follows the user's words: the end of the turn, and the assistant's turn opened with its empty thinking block
pub fn tailTokens(vocab: &llmrun.ModelTokens) List[u32] {
  var out = List[u32].empty();
  out.push(vocab.imEnd);
  let nl = bytesOf("\n");
  let nn = bytesOf("\n\n");
  let assistant = bytesOf("assistant\n");
  vocab.text(nl.view(), &mut out);
  out.push(vocab.imStart);
  vocab.text(assistant.view(), &mut out);
  out.push(vocab.think);
  vocab.text(nn.view(), &mut out);
  out.push(vocab.thinkEnd);
  vocab.text(nn.view(), &mut out);
  out
}

// Start over: the cache empty, the system turn and the opening of a user turn in it
fn newConversation(engine: &mut llmrun.Engine, device: &mut Device, vocab: &llmrun.ModelTokens, sysTurn: &Array[u32]) Result[void, String] {
  engine.reset();
  engine.feed(device, sysTurn, false)?;
  engine.feed(device, headTokens(vocab, false).view(), false)?;
  Ok[void, String](nil)
}

// A sentence said: where in the cache it ends and where in the speaker's stream its sound ends
struct Mark {
  pos: usize;
  endSample: usize;
}

// What a reply's speaking cost, and the instants of its first sentence
struct Stats {
  sentences: usize;
  kokoro: f64;
  samples: usize;
  spoken: bool;            // a first sentence has been said
  sentenceAt: Instant;     // the first sentence was complete (before Kokoro began on it)
  queuedAt: Instant;       // and its sound was queued
  firstKokoro: f64;
}

// One finished sentence: Kokoro, then its samples into the speaker's queue, noted in 'stats' and 'marks'. 'at' is the
// cache position the sentence ends at.
fn speakSentence(tts: &mut texttospeech.Speaker, device: &mut Device, voice: &texttospeech.Voice, speed: f32,
    out: &mut voiceaudio.Speaker, text: &str, at: usize, stats: &mut Stats, marks: &mut List[Mark]) Result[bool, String] {
  let clean = speechText(text.bytes());
  if clean.len() == 0usize { return Ok[bool, String](false); }
  let t0 = Instant.now();
  let raw = tts.speak(device, clean.view(), voice, speed)?;
  let spent = seconds(Instant.now(), t0);
  // the silence Kokoro puts at both ends is cut to 80 ms before and 150 ms after (see trimPads)
  let samples = trimPads(raw.view(), 1920usize, 3600usize, 0.004f);
  out.queue(samples.view());
  out.flush();
  if !stats.spoken {
    stats.spoken = true;
    stats.sentenceAt = t0;
    stats.queuedAt = Instant.now();
    stats.firstKokoro = spent;
  }
  stats.sentences = stats.sentences + 1usize;
  stats.kokoro = stats.kokoro + spent;
  stats.samples = stats.samples + samples.len();
  marks.push(Mark(at, out.samplesQueued()));
  Ok[bool, String](true)
}

// Read what the microphone has into the detector. This loop is blocked for a second or more at a time while Qwen reads
// a prompt and Kokoro speaks a sentence, so one call hands the detector that much audio at once (an earlier voiceaudio
// panicked on a push of more than 1.6 s; it takes any length now and a test pins it).
fn listen(mic: &mut voiceaudio.Microphone, vad: &mut voiceaudio.Vad, heard: &mut List[voiceaudio.Utterance]) {
  mic.pump(vad, heard);
}

// The goodbye: said, then waited for (at most 5 s, and not past a Ctrl-C) until the speaker's queue is empty and its own
// buffer has played
fn sayGoodbye(tts: &mut texttospeech.Speaker, device: &mut Device, voice: &texttospeech.Voice, speed: f32,
    out: &mut voiceaudio.Speaker, intr: &mut voiceaudio.Interrupt) {
  printStr("ai> Goodbye.\n");
  print.flush();
  match tts.speak(device, "Goodbye.", voice, speed) {
    case let Ok(raw) {
      let samples = trimPads(raw.view(), 1920usize, 3600usize, 0.004f);
      out.queue(samples.view());
      out.flush();
      let t0 = Instant.now();
      while out.waitingMs() > 0u32 && seconds(Instant.now(), t0) < 5.0 && !intr.requested() {
        thread.sleep(Duration.fromMillis(5));
      }
      thread.sleep(Duration.fromMillis(300));
    }
    case let Err(m) { say(m.view()); say("\n"); }
  }
}

// Run the conversation. Answers the program's exit status. 'device' is a compute device made with
// `ComputeRequest(largeBuffers: true)`.
pub fn run(device: &mut Device, o: &VoiceOptions) i32 {
  // ---- the models
  let loadStart = Instant.now();
  say("loading Qwen, Parakeet and Kokoro ...\n");
  let modelFile = Path.from(o.model.view());
  var engine: llmrun.Engine = match llmrun.Engine.open(device, &modelFile, &llmrun.LoadOptions(o.ctx, 64usize)) {
    case var Ok(e) { e }
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  };
  var vocab: llmrun.ModelTokens = match llmrun.loadTokens(engine.ggufModel()) {
    case var Ok(v) { v }
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  };
  if !vocab.hasChatMl {
    say("voicechat: this model's vocabulary has no ChatML tokens\n");
    return 1i32;
  }
  let sttModel = Path.from(o.sttModel.view());
  let sttVocab = Path.from(o.sttVocab.view());
  var stt: speechtotext.Parakeet = match speechtotext.Parakeet.open(device, &sttModel, &sttVocab) {
    case var Ok(p) { p }
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  };
  let british = o.voice.view().startsWith("b");
  var tts: texttospeech.Speaker = match texttospeech.Speaker.open(device, o.ttsDir.view(), british) {
    case var Ok(s) { s }
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  };
  let voice: texttospeech.Voice = match texttospeech.Voice.load(o.ttsDir.view(), o.voice.view()) {
    case var Ok(v) { v }
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  };
  tts.seed(o.seed);
  var rng = Rng.fromSeed(o.seed);
  let sampler = llmrun.TokenSampler.make(f32.from(o.temperature), o.topK, f32.from(o.topP));

  // ---- the conversation starts with the system turn; a short exchange warms the kernels, then the cache is wound back
  let systemBytes = bytesOf(o.system.view());
  let sysTurn = vocab.systemTurn(systemBytes.view());
  match engine.feed(device, sysTurn.view(), false) {
    case is Ok {}
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  }
  let afterSystem = engine.pos;
  {
    let hello = bytesOf("Hello.");
    let hi = vocab.userTurn(hello.view(), false);
    var logits = List[f32].empty();
    match engine.feed(device, hi.view(), true) {
      case var Ok(l) { logits = l; }
      case let Err(m) { say(m.view()); say("\n"); return 1i32; }
    }
    var k = 0usize;
    while k < 4usize {
      let id = sampler.sample(logits.view(), &mut rng);
      var one = List[u32].empty();
      one.push(id);
      match engine.feed(device, one.view(), true) {
        case var Ok(l) { logits = l; }
        case let Err(m) { say(m.view()); say("\n"); return 1i32; }
      }
      k = k + 1usize;
    }
    engine.rewind(afterSystem);
  }
  {
    var quiet = List[f32].empty();
    quiet.resize(8000usize, 0.0f);
    match stt.transcribe(device, quiet.view()) {
      case is Ok {}
      case let Err(m) { say(m.view()); say("\n"); return 1i32; }
    }
    match tts.speak(device, "Ready.", &voice, o.speed) {
      case is Ok {}
      case let Err(m) { say(m.view()); say("\n"); return 1i32; }
    }
  }
  say("models ready in ");
  say(fmt2(seconds(Instant.now(), loadStart)).view());
  say(" s\n");

  // ---- the audio
  var driver = voiceaudio.Driver.dummy();
  if o.audio.view() == "system" {
    driver = voiceaudio.Driver.system(o.deviceFrames);
  } else if o.audio.view() == "disk" {
    driver = voiceaudio.Driver.disk(o.inFile.view(), o.outFile.view(), o.timescale.view());
  } else if o.audio.view() != "dummy" {
    say("voicechat: the audio is system, disk or dummy\n");
    return 2i32;
  }
  let micOpened = Instant.now();
  var mic: voiceaudio.Microphone = match voiceaudio.Microphone.open(&driver, 16000u32) {
    case var Ok(m) { m }
    case let Err(e) { say("voicechat: no microphone: "); say(e.message().view()); say("\n"); return 1i32; }
  };
  var out: voiceaudio.Speaker = match voiceaudio.Speaker.open(&driver, 24000u32) {
    case var Ok(s) { s }
    case let Err(e) { say("voicechat: no speaker: "); say(e.message().view()); say("\n"); mic.close(); return 1i32; }
  };
  let speakerOpened = Instant.now();
  var cfg = voiceaudio.VadConfig.standard(16000u32);
  cfg.hangoverMs = o.endSilenceMs;
  // The quiet kept after the last word is the detector's usual 200 ms, and not more: it is what Parakeet's mark depends on.
  // With none, a finished sentence often comes back without its full stop; with 400 ms a fragment ("I often heard her talk") is
  // given one as often as a sentence is (measured on 33 sentences with a pause put inside: 18 split in two turns at 400 ms of
  // trail, 11 at 200, 21 at none; the package's README.md has the table)
  var vad = voiceaudio.Vad.make(cfg);
  var heard = List[voiceaudio.Utterance].empty();

  printStr("ready (audio: ");
  printStr(o.audio.view());
  printStr(", voice ");
  printStr(o.voice.view());
  printStr(", speed ");
  printStr(fmt2(f64.from(o.speed)).view());
  printStr("). Speak; speech over the reply cuts it off. Say \"goodbye\" or \"stop\", or press Ctrl-C, to end.\n");
  if o.echoTimings {
    printStr("timing: speaker opened ");
    printStr(fmt2(seconds(speakerOpened, micOpened)).view());
    printStr(" s after the microphone\n");
  }
  print.flush();

  // ---- the loop. The cache always ends with the opening of a user turn, put there while nobody was waiting.
  match engine.feed(device, headTokens(&vocab, false).view(), false) {
    case is Ok {}
    case let Err(m) { say(m.view()); say("\n"); return 1i32; }
  }
  // Ctrl-C: SDL's audio swallows it (interrupt.cone says why), so the loop asks for it, here and in the reply's loop
  var intr = voiceaudio.Interrupt.start();
  var hearing = HeardTurn.empty();  // the utterances of the turn being heard, joined
  var detectedAt = Instant.now();   // the latest utterance of the turn came out of the detector
  var transcribedAt = detectedAt;   // and its transcript was ready
  var micLag = 0.0;                 // how far the microphone's samples trail the wall clock, measured at each read
  var detectedLag = 0.0;            // ... as it was when the latest utterance came out
  var running = true;
  let started = Instant.now();
  var lastWarm = started;
  var warmth = List[f32].empty();
  warmth.resize(4000usize, 0.0f);
  var warmCalls = 0usize;
  var warmSeconds = 0.0;
  var warmAllCalls = 0usize;
  var warmAllSeconds = 0.0;
  var turnNumber = 0usize;
  while running {
    if o.runSeconds > 0u32 && seconds(Instant.now(), started) > f64.from(o.runSeconds) { break; }

    if intr.requested() { printStr("\n(Ctrl-C: ending)\n"); print.flush(); break; }

    // LISTEN
    vad.setThresholdScale(1.0f);
    listen(&mut mic, &mut vad, &mut heard);
    micLag = seconds(Instant.now(), micOpened) - f64.from(mic.samplesTaken()) / 16000.0;
    if heard.len() == 0usize {
      // KEEP THE GPU WARM, ONLY WHILE SOMEBODY IS SPEAKING. After a second or two of idle the laptop GPU drops its clock, and
      // Parakeet's 0.1 s on an utterance becomes 0.3 s. So while the detector is inside an utterance AND the latest 20 ms
      // frame is 6 dB or more over the noise floor (the detector's own test for a frame of speech; in the silence of the
      // hangover, or with nobody there, this is false), Parakeet runs on 0.25 s of silence at most every 400 ms (the first run after idle takes 0.1 to 0.4 s, being at the low
      // clock itself; the rest about 0.1 s). Nothing runs
      // while the program is idle or the person is quiet; `--no-gpu-warm` turns it off.
      if o.keepWarm && vad.speaking() && vad.level() > 2.0f * vad.noiseFloor() && seconds(Instant.now(), lastWarm) >= 0.4 {
        let w0 = Instant.now();
        match stt.transcribe(device, warmth.view()) {
          case is Ok {}
          case let Err(m) { say(m.view()); say("\n"); break; }
        }
        lastWarm = Instant.now();
        warmCalls = warmCalls + 1usize;
        warmSeconds = warmSeconds + seconds(lastWarm, w0);
        warmAllCalls = warmAllCalls + 1usize;
        warmAllSeconds = warmAllSeconds + seconds(lastWarm, w0);
      } else {
        thread.sleep(Duration.fromMillis(10));
      }
      // an utterance already heard that ended in no full stop waits here for more speech, or for the longer silence
      if hearing.isEmpty() || !hearing.due(vad.analysed(), vad.speaking(), 16000u32, o.endSilenceMs, o.unfinishedSilenceMs) { continue; }
    } else {
      // HEAR. The detector ended an utterance (after the end-silence): it joins the turn so far, and Parakeet's text for the
      // whole turn decides whether the turn is over (turns.cone)
      detectedAt = Instant.now();
      detectedLag = micLag;
      {
        let hv = heard.view();
        var k = 0usize;
        while k < hv.len { hearing.add(&hv[k], 16000u32); k = k + 1usize; }
      }
      heard.clear();
      match hearing.hear(device, &mut stt) {
        case is Ok {}
        case let Err(m) { say(m.view()); say("\n"); break; }
      }
      transcribedAt = Instant.now();
      if !containsLetter(hearing.text.view()) { hearing.clear(); continue; }
      if isFiller(hearing.text.view()) {
        printStr("(ignored, only a hesitation: ");
        printStr(hearing.text.view());
        printStr(")\n");
        print.flush();
        hearing.clear();
        continue;
      }
      if !hearing.due(vad.analysed(), vad.speaking(), 16000u32, o.endSilenceMs, o.unfinishedSilenceMs) {
        printStr("(heard \"");
        printStr(hearing.text.view());
        printStr("\", which does not end a sentence: waiting up to ");
        printStr(fmt2(f64.from(o.unfinishedSilenceMs) / 1000.0).view());
        printStr(" s of silence for more)\n");
        print.flush();
        continue;
      }
    }

    // THE TURN IS OVER
    let spoken = hearing.text.copy();
    let speechEnded = micOpened + Duration.fromMillis(i64.from(hearing.lastSpeech() / 16usize));
    let talked = f64.from(hearing.lastSpeech() - hearing.firstSpeech()) / 16000.0;
    let pieces = hearing.pieces();
    let turnEndedAt = Instant.now();
    hearing.clear();
    turnNumber = turnNumber + 1usize;
    printStr("\nyou> ");
    printStr(spoken.view());
    printStr("\n");
    print.flush();
    if isGoodbye(spoken.view()) {
      sayGoodbye(&mut tts, device, &voice, o.speed, &mut out, &mut intr);
      break;
    }

    // THINK: the user's words and the end of the turn into the cache (its start is already there). Without room for
    // them and a reply, a new conversation.
    let userBytes = bytesOf(spoken.view());
    var turn = List[u32].empty();
    vocab.text(userBytes.view(), &mut turn);
    {
      let tail = tailTokens(&vocab);
      var i = 0usize;
      while i < tail.len() { turn.push(*tail[i]); i = i + 1usize; }
    }
    if engine.pos + turn.len() + o.maxTokens + 1usize > engine.ctx {
      printStr("(the context is full: a new conversation)\n");
      match newConversation(&mut engine, device, &vocab, sysTurn.view()) {
        case is Ok {}
        case let Err(m) { say(m.view()); say("\n"); break; }
      }
    }
    var logits = List[f32].empty();
    match engine.feed(device, turn.view(), true) {
      case var Ok(l) { logits = l; }
      case let Err(m) { say(m.view()); say("\n"); break; }
    }
    let prefilled = Instant.now();
    let promptEnd = engine.pos;

    // ANSWER: write a token, speak what it finishes, listen; until the speaker is empty or somebody speaks
    printStr("ai> ");
    print.flush();
    var stream = llmrun.TextStream.make();
    var sentences = Sentences.make();
    var marks = List[Mark].empty();
    var stats = Stats(0usize, 0.0, 0usize, false, prefilled, prefilled, 0.0);
    var made = 0usize;
    var generating = true;
    var remainderDone = false;
    var interrupted = false;
    var failed = false;
    var quiet = false;           // the speaker's queue is empty and everything is written
    var quietSince = prefilled;
    let answerStart = Instant.now();
    // the speaker's queue is empty now (the last reply played out or was cut), and its count of samples queued runs on from
    // earlier replies; this reply's own are the ones past this
    let queuedBefore = out.samplesQueued();
    var finished = false;
    var stopped = false;         // Ctrl-C
    while !finished {
      if intr.requested() { stopped = true; break; }
      let playing = out.waitingMs() > 0u32;
      // thresholds stay raised for the 300 ms after the queue empties (the device's own buffer is still playing)
      let loud = playing || (quiet && seconds(Instant.now(), quietSince) < 0.3);
      vad.setThresholdScale(if loud { o.thresholdScale } else { 1.0f });
      listen(&mut mic, &mut vad, &mut heard);
      if vad.speaking() || heard.len() > 0usize { interrupted = true; break; }
      if generating {
        let id = sampler.sample(logits.view(), &mut rng);
        if vocab.isStop(id) || made >= o.maxTokens {
          generating = false;
        } else {
          let piece = stream.push(&vocab.tok, id, false);
          llmrun.writeBytes(piece.view());
          sentences.push(piece.view());
          made = made + 1usize;
          // the sentences this token finished are spoken before the next token is written
          var more = true;
          while more {
            match sentences.next() {
              case let Some(s) {
                var at = engine.pos;
                if s.inLatest { at = at + 1usize; }
                match speakSentence(&mut tts, device, &voice, o.speed, &mut out, s.text.view(), at, &mut stats, &mut marks) {
                  case is Ok {}
                  case let Err(m) { say(m.view()); say("\n"); failed = true; more = false; generating = false; }
                }
              }
              case is None { more = false; }
            }
          }
          if generating {
            if engine.pos + 1usize >= engine.ctx {
              generating = false;
            } else {
              var one = List[u32].empty();
              one.push(id);
              match engine.feed(device, one.view(), true) {
                case var Ok(l) { logits = l; }
                case let Err(m) { say(m.view()); say("\n"); failed = true; generating = false; }
              }
            }
          }
        }
      } else if !remainderDone {
        llmrun.writeBytes(stream.finish().view());
        match sentences.finish() {
          case let Some(s) {
            match speakSentence(&mut tts, device, &voice, o.speed, &mut out, s.text.view(), engine.pos, &mut stats, &mut marks) {
              case is Ok {}
              case let Err(m) { say(m.view()); say("\n"); failed = true; }
            }
          }
          case is None {}
        }
        remainderDone = true;
      } else {
        // everything is written: wait for the speaker to empty, then 300 ms more
        if playing {
          quiet = false;
        } else if !quiet {
          quiet = true;
          quietSince = Instant.now();
        } else if seconds(Instant.now(), quietSince) >= 0.3 {
          finished = true;
        }
        thread.sleep(Duration.fromMillis(5));
      }
      if failed { break; }
    }
    let answerEnd = Instant.now();
    printStr("\n");
    if stopped {
      out.cutOff();
      printStr("(Ctrl-C: ending)\n");
      print.flush();
      break;
    }
    if interrupted {
      let queued = out.samplesQueued();
      let waiting = out.waiting();
      var played = 0usize;
      if queued > waiting { played = queued - waiting; }
      let cutAt = seconds(Instant.now(), micOpened);
      var began = f64.from(vad.speechStartSample()) / 16000.0;
      if heard.len() > 0usize { began = f64.from(heard[0usize].start) / 16000.0; }
      out.cutOff();
      // The model keeps every sentence the person had begun to hear (its sound starts where the one before ends)
      var keep = promptEnd;
      var k = 0usize;
      var startSample = 0usize;
      while k < marks.len() {
        if startSample < played { keep = marks[k].pos; }
        startSample = marks[k].endSample;
        k = k + 1usize;
      }
      let written = engine.pos - promptEnd;
      engine.rewind(keep);
      var note = String.empty();
      note <- "(interrupted: speech began at ";
      note <- fmt2(began).view();
      note <- " s and the speaker was cut at ";
      note <- fmt2(cutAt).view();
      note <- " s on the microphone's clock, after ";
      var playedThisReply = 0usize;
      if played > queuedBefore { playedThisReply = played - queuedBefore; }
      note <- fmt2(f64.from(playedThisReply) / 24000.0).view();
      note <- " s of this reply's speech had played; of the ";
      note <- u64.from(written);
      note <- " tokens written the model keeps ";
      note <- u64.from(keep - promptEnd);
      note <- ", the sentences it had begun to hear)\n";
      printStr(note.view());
    }
    if failed { break; }
    // The next turn's opening goes into the cache now, while nobody is waiting
    if engine.pos + o.maxTokens + 64usize > engine.ctx {
      printStr("(the context is full: a new conversation)\n");
      match newConversation(&mut engine, device, &vocab, sysTurn.view()) {
        case is Ok {}
        case let Err(m) { say(m.view()); say("\n"); break; }
      }
    } else {
      match engine.feed(device, headTokens(&vocab, true).view(), false) {
        case is Ok {}
        case let Err(m) { say(m.view()); say("\n"); break; }
      }
    }

    // THE TURN'S TIMINGS
    if o.echoTimings {
      var line = String.empty();
      line <- "timing: turn ";
      line <- u64.from(turnNumber);
      if pieces > 1usize {
        line <- " (";
        line <- u64.from(pieces);
        line <- " stretches of speech joined)";
      }
      if stats.spoken {
        line <- " end of speech to the first sound queued ";
        line <- fmt2(seconds(stats.queuedAt, speechEnded)).view();
        line <- " s = silence until detected ";
        line <- fmt2(seconds(detectedAt, speechEnded)).view();
        line <- " (the end-silence and a frame, and the microphone's samples trailing the clock by ";
        line <- fmt2(detectedLag).view();
        line <- " s) + speech to text ";
        line <- fmt2(seconds(transcribedAt, detectedAt)).view();
        line <- " + waiting for more speech ";
        line <- fmt2(seconds(turnEndedAt, transcribedAt)).view();
        line <- " + the prompt into Qwen ";
        line <- fmt2(seconds(prefilled, turnEndedAt)).view();
        line <- " + Qwen to the first sentence's end ";
        line <- fmt2(seconds(stats.sentenceAt, prefilled)).view();
        line <- " + Kokoro on it ";
        line <- fmt2(stats.firstKokoro).view();
        line <- " + into the speaker ";
        line <- fmt2(seconds(stats.queuedAt, stats.sentenceAt) - stats.firstKokoro).view();
        line <- " (on the microphone's clock the speech ended at ";
        line <- fmt2(seconds(speechEnded, micOpened)).view();
        line <- " s and the sound was queued at ";
        line <- fmt2(seconds(stats.queuedAt, micOpened)).view();
        line <- " s)";
      } else {
        line <- " (nothing was spoken)";
      }
      line <- "\ntiming: reply ";
      line <- u64.from(made);
      line <- " tokens, ";
      line <- u64.from(stats.sentences);
      line <- " sentences, ";
      line <- fmt2(f64.from(stats.samples) / 24000.0).view();
      line <- " s of speech; writing and speaking took ";
      line <- fmt2(seconds(answerEnd, answerStart)).view();
      line <- " s, Kokoro ";
      line <- fmt2(stats.kokoro).view();
      line <- " s of it\n";
      if o.keepWarm {
        line <- "timing: GPU kept warm while you spoke (";
        line <- fmt2(talked).view();
        line <- " s): ";
        line <- u64.from(warmCalls);
        line <- " runs of Parakeet on silence, ";
        line <- fmt2(warmSeconds).view();
        line <- " s of GPU work, ";
        line <- u64.from(u64.from(100.0 * warmSeconds / (if talked > 0.01 { talked } else { 0.01 })));
        line <- " % of the speech\n";
      }
      printStr(line.view());
    }
    warmCalls = 0usize;
    warmSeconds = 0.0;
    print.flush();
  }

  intr.stop();
  out.cutOff();
  out.close();
  mic.close();
  device.waitIdle();
  if o.echoTimings && o.keepWarm {
    var tail = String.empty();
    tail <- "timing: over the whole session the GPU was kept warm ";
    tail <- u64.from(warmAllCalls);
    tail <- " times, ";
    tail <- fmt2(warmAllSeconds).view();
    tail <- " s of GPU work, only while somebody was speaking (";
    tail <- fmt2(seconds(Instant.now(), started)).view();
    tail <- " s in all)\n";
    printStr(tail.view());
  }
  0i32
}
