// ======== Shape: a glyph outline as coloured edges ========
//
// A glyph is a set of closed contours of straight lines and quadratic
// Beziers (TrueType's), in font units, y up. Everything here is f64: the
// distance tests below solve cubics and compare nearly equal distances.
//
// The signed distance has msdfgen's sign (Chlumsky's, MIT licence): positive
// INSIDE, which for a TrueType glyph, whose outer contours run clockwise, is
// the right of an edge's direction. A contour's winding is +1 for the
// clockwise direction (the sign of the shoelace sum of (bx - ax)(ay + by)),
// -1 for counter-clockwise: an outer contour of a TrueType glyph has +1, a
// hole -1.

pub const EDGE_LINE = 0u32;
pub const EDGE_QUAD = 1u32;

// Edge colours are channel masks: red 1, green 2, blue 4
pub const COLOR_BLACK = 0u32;
pub const COLOR_RED = 1u32;
pub const COLOR_GREEN = 2u32;
pub const COLOR_YELLOW = 3u32;
pub const COLOR_BLUE = 4u32;
pub const COLOR_MAGENTA = 5u32;
pub const COLOR_CYAN = 6u32;
pub const COLOR_WHITE = 7u32;

pub struct Pt {
  pub x f64;
  pub y f64;

  pub fn add overload `+`(self, o Pt) Pt inline { new Pt(x + o.x, y + o.y) }
  pub fn sub overload `-`(self, o Pt) Pt inline { new Pt(x - o.x, y - o.y) }
  pub fn scale overload `*`(self, s f64) Pt inline { new Pt(x * s, y * s) }
  pub fn dot(self, o Pt) f64 inline { x * o.x + y * o.y }
  pub fn cross(self, o Pt) f64 inline { x * o.y - y * o.x }
  pub fn length(self) f64 inline { libc.sqrt(x * x + y * y) }
  pub fn lengthSquared(self) f64 inline { x * x + y * y }
  // The unit vector; (0, 1) for a zero vector, as msdfgen
  pub fn normalized(self) Pt {
    let l = libc.sqrt(x * x + y * y);
    if l == 0.0 { return new Pt(0.0, 1.0); }
    new Pt(x / l, y / l)
  }
}

// A distance to an edge and, to break ties between edges at a corner, how
// head-on the nearest point is (0: the point is straight out from the edge)
pub struct SignedDist {
  pub d f64;
  pub dot f64;
}

pub fn nonZeroSign(v f64) f64 {
  if v > 0.0 { return 1.0; }
  -1.0
}

// Whether 'a' is nearer than 'b': smaller magnitude, a tie going to the one with the smaller dot
pub fn nearer(a SignedDist, b SignedDist) bool {
  let fa = libc.fabs(a.d);
  let fb = libc.fabs(b.d);
  fa < fb or (fa == fb and a.dot < b.dot)
}

// msdfgen's equation solvers (Chlumsky; after Numerical Recipes' cubic).
// The roots go in 'x'; the count is returned (-1: every x).
fn solveQuadratic(x &mut Array[f64, 3], a f64, b f64, c f64) i32 {
  if a == 0.0 or libc.fabs(b) > 1.0e12 * libc.fabs(a) {
    if b == 0.0 {
      if c == 0.0 { return -1i32; }
      return 0i32;
    }
    x[0] = -c / b;
    return 1i32;
  }
  var dscr = b * b - 4.0 * a * c;
  if dscr > 0.0 {
    dscr = libc.sqrt(dscr);
    x[0] = (-b + dscr) / (2.0 * a);
    x[1] = (-b - dscr) / (2.0 * a);
    return 2i32;
  }
  if dscr == 0.0 {
    x[0] = -b / (2.0 * a);
    return 1i32;
  }
  0i32
}

fn solveCubicNormed(x &mut Array[f64, 3], a f64, b f64, c f64) i32 {
  let a2 = a * a;
  var q = (a2 - 3.0 * b) / 9.0;
  let r = (a * (2.0 * a2 - 9.0 * b) + 27.0 * c) / 54.0;
  let r2 = r * r;
  let q3 = q * q * q;
  var shift = a;
  if r2 < q3 {
    var t = r / libc.sqrt(q3);
    if t < -1.0 { t = -1.0; }
    if t > 1.0 { t = 1.0; }
    t = libc.acos(t);
    shift = shift / 3.0;
    q = -2.0 * libc.sqrt(q);
    x[0] = q * libc.cos(t / 3.0) - shift;
    x[1] = q * libc.cos((t + 2.0 * PI64) / 3.0) - shift;
    x[2] = q * libc.cos((t - 2.0 * PI64) / 3.0) - shift;
    return 3i32;
  }
  var aa = -libc.pow(libc.fabs(r) + libc.sqrt(r2 - q3), 1.0 / 3.0);
  if r < 0.0 { aa = -aa; }
  let bb = if aa == 0.0 { 0.0 } else { q / aa };
  shift = shift / 3.0;
  x[0] = (aa + bb) - shift;
  x[1] = -0.5 * (aa + bb) - shift;
  x[2] = 0.5 * 1.7320508075688772 * (aa - bb);
  if libc.fabs(x[2]) < 1.0e-14 { return 2i32; }
  1i32
}

fn solveCubic(x &mut Array[f64, 3], a f64, b f64, c f64, d f64) i32 {
  if a != 0.0 {
    let bn = b / a;
    if libc.fabs(bn) < 1.0e6 { return solveCubicNormed(x, bn, c / a, d / a); }
  }
  solveQuadratic(x, b, c, d)
}

pub const PI64 = 3.14159265358979323846;

// One segment of a contour: a line from 'a' to 'c' ('b' unused), or a
// quadratic Bezier from 'a' to 'c' with control point 'b'
pub struct Edge {
  pub kind u32;
  pub a Pt;
  pub b Pt;
  pub c Pt;
  pub color u32;

  pub fn line(a Pt, c Pt) Edge { new Edge(EDGE_LINE, a, (a + c) * 0.5, c, COLOR_WHITE) }
  pub fn quad(a Pt, b Pt, c Pt) Edge { new Edge(EDGE_QUAD, a, b, c, COLOR_WHITE) }

  pub fn point(self &, t f64) Pt {
    if kind == EDGE_LINE { return a + (c - a) * t; }
    let u = 1.0 - t;
    a * (u * u) + b * (2.0 * u * t) + c * (t * t)
  }

  // The derivative at t (not normalised)
  pub fn direction(self &, t f64) Pt {
    if kind == EDGE_LINE { return c - a; }
    (b - a) * (1.0 - t) + (c - b) * t
  }

  // The nearest point of the edge to p: the signed distance (msdfgen's: the
  // true distance, signed by the side of the edge's direction, positive on the right) and the curve parameter, which is
  // outside [0, 1] where the nearest point is an end, then the end's tangent decides
  pub fn signedDistance(self &, p Pt, param &mut f64) SignedDist {
    if kind == EDGE_LINE {
      let aq = p - a;
      let ab = c - a;
      let abab = ab.dot(ab);
      *param = if abab == 0.0 { 0.0 } else { aq.dot(ab) / abab };
      let eq = p - (if *param > 0.5 { c } else { a });
      let endpointDistance = eq.length();
      if *param > 0.0 and *param < 1.0 {
        let ortho = aq.cross(ab) / ab.length();
        if libc.fabs(ortho) < endpointDistance { return new SignedDist(ortho, 0.0); }
      }
      return new SignedDist(nonZeroSign(aq.cross(ab)) * endpointDistance,
        libc.fabs(ab.normalized().dot(eq.normalized())));
    }
    let qa = a - p;
    let ab = b - a;
    let br = a + c - b - b;
    let qa1 = qa;
    var roots = new Array[f64, 3] <- fill 0.0;
    let n = solveCubic(&mut roots, br.dot(br), 3.0 * ab.dot(br), 2.0 * ab.dot(ab) + qa1.dot(br), qa1.dot(ab));
    var minDistance = nonZeroSign(ab.cross(qa)) * qa.length();
    let abab = ab.dot(ab);
    *param = if abab == 0.0 { 0.0 } else { -qa.dot(ab) / abab };
    {
      let cp = c - p;
      let distance = cp.length();
      if distance < libc.fabs(minDistance) {
        let bc = c - b;
        minDistance = nonZeroSign(bc.cross(cp)) * distance;
        let bcbc = bc.dot(bc);
        *param = if bcbc == 0.0 { 1.0 } else { (p - b).dot(bc) / bcbc };
      }
    }
    var i = 0i32;
    while i < n and i < 3i32 {
      let t = roots[usize.from(u32.from(i))];
      if t > 0.0 and t < 1.0 {
        let tangent = ab + br * t;
        let qe = a + ab * (2.0 * t) + br * (t * t) - p;
        let distance = nonZeroSign(tangent.cross(qe)) * qe.length();
        if libc.fabs(distance) <= libc.fabs(minDistance) {
          minDistance = distance;
          *param = t;
        }
      }
      i = i + 1i32;
    }
    if *param >= 0.0 and *param <= 1.0 { return new SignedDist(minDistance, 0.0); }
    if *param < 0.5 {
      return new SignedDist(minDistance, libc.fabs(ab.normalized().dot(qa.normalized())));
    }
    new SignedDist(minDistance, libc.fabs((c - b).normalized().dot((c - p).normalized())))
  }

  // The distance extended past an end along the end's tangent (the pseudo-
  // distance of Chlumsky's multi-channel field), where that is nearer than
  // the end itself and the point lies beyond the end; 'dist' is replaced
  pub fn toPseudoDistance(self &, dist SignedDist, p Pt, param f64) SignedDist {
    if param < 0.0 {
      let dir = self.direction(0.0).normalized();
      let aq = p - a;
      if aq.dot(dir) < 0.0 {
        let pseudo = aq.cross(dir);
        if libc.fabs(pseudo) <= libc.fabs(dist.d) { return new SignedDist(pseudo, 0.0); }
      }
    } elif param > 1.0 {
      let dir = self.direction(1.0).normalized();
      let bq = p - c;
      if bq.dot(dir) > 0.0 {
        let pseudo = bq.cross(dir);
        if libc.fabs(pseudo) <= libc.fabs(dist.d) { return new SignedDist(pseudo, 0.0); }
      }
    }
    dist
  }

  // The part of the edge from parameter t0 to t1, as an edge of the same
  // kind and colour. A quadratic's piece has the curve's own points at its
  // ends and, for its control point, the point t0 plus the tangent there
  // times the length of the piece: the two tangents of a parabola's arc meet
  // halfway along the parameter.
  pub fn sub(self &, t0 f64, t1 f64) Edge {
    let p0 = self.point(t0);
    let p1 = self.point(t1);
    if kind == EDGE_LINE { return new Edge(EDGE_LINE, p0, (p0 + p1) * 0.5, p1, color); }
    new Edge(EDGE_QUAD, p0, p0 + self.direction(t0) * (t1 - t0), p1, color)
  }

  // The edge cut into thirds
  pub fn third(self &, k u32) Edge { self.sub(f64.from(k) / 3.0, f64.from(k + 1u32) / 3.0) }
}

// A closed contour: edges [start, start + count) of its shape
pub struct Contour {
  pub start u32;
  pub count u32;
  pub winding i32;
}

pub struct Shape {
  pub edges List[Edge];
  pub contours List[Contour];

  pub fn empty() Shape { new Shape(List[Edge].empty(), List[Contour].empty()) }

  // The shape of a glyph's outline: each contour's points become lines and
  // quadratics by TrueType's rule (two off-curve points in a row imply an
  // on-curve point halfway; a contour with no on-curve point starts at
  // such a midpoint). Zero-length edges are dropped.
  pub fn fromOutline(o &Outline) Shape {
    var shape = Shape.empty();
    var first = 0usize;
    var ci = 0usize;
    while ci < o.ends.len() {
      let last = usize.from(*o.ends[ci]);
      if last >= first and last < o.xs.len() {
        // Expand: implied on-curve midpoints between off-curve neighbours
        var px = List[f64].empty();
        var py = List[f64].empty();
        var pon = List[bool].empty();
        let n = last - first + 1usize;
        var k = 0usize;
        while k < n {
          let i = first + k;
          let j = first + (k + 1usize) % n;
          px.push(*o.xs[i]);
          py.push(*o.ys[i]);
          pon.push(*o.on[i]);
          if !*o.on[i] and !*o.on[j] {
            px.push((*o.xs[i] + *o.xs[j]) * 0.5);
            py.push((*o.ys[i] + *o.ys[j]) * 0.5);
            pon.push(true);
          }
          k = k + 1usize;
        }
        // Start at an on-curve point
        var s = 0usize;
        while s < pon.len() and !*pon[s] { s = s + 1usize; }
        if s < pon.len() and pon.len() >= 2usize {
          let m = pon.len();
          let begin = shape.edges.len();
          var i = 0usize;
          while i < m {
            let i0 = (s + i) % m;
            let i1 = (s + i + 1usize) % m;
            let p0 = new Pt(*px[i0], *py[i0]);
            let p1 = new Pt(*px[i1], *py[i1]);
            if *pon[i1] {
              if p0.x != p1.x or p0.y != p1.y { shape.edges.push(Edge.line(p0, p1)); }
              i = i + 1usize;
            } else {
              let i2 = (s + i + 2usize) % m;
              let p2 = new Pt(*px[i2], *py[i2]);
              if p0.x != p2.x or p0.y != p2.y or p0.x != p1.x or p0.y != p1.y { shape.edges.push(Edge.quad(p0, p1, p2)); }
              i = i + 2usize;
            }
          }
          let count = shape.edges.len() - begin;
          if count > 0usize {
            shape.contours.push(new Contour(u32.from(begin), u32.from(count), 1i32));
          }
        }
      }
      first = last + 1usize;
      ci = ci + 1usize;
    }
    shape.setWindings();
    shape
  }

  // Each contour's winding: the sign of the shoelace sum over its edges'
  // end points and quadratic control points (+1 clockwise)
  pub fn setWindings(self &mut) {
    var ci = 0usize;
    while ci < contours.len() {
      let c = *contours[ci];
      var total = 0.0;
      var i = 0u32;
      while i < c.count {
        let e = *edges[usize.from(c.start + i)];
        if e.kind == EDGE_QUAD {
          total = total + (e.b.x - e.a.x) * (e.a.y + e.b.y) + (e.c.x - e.b.x) * (e.b.y + e.c.y);
        } else {
          total = total + (e.c.x - e.a.x) * (e.a.y + e.c.y);
        }
        i = i + 1u32;
      }
      let w = if total > 0.0 { 1i32 } elif total < 0.0 { -1i32 } else { 0i32 };
      contours.set(ci, new Contour(c.start, c.count, w));
      ci = ci + 1usize;
    }
  }

  // The bounding box of the edges' end points and control points: min, max
  pub fn bounds(self &, lo &mut Pt, hi &mut Pt) {
    var x0 = 1.0e30;
    var y0 = 1.0e30;
    var x1 = -1.0e30;
    var y1 = -1.0e30;
    var i = 0usize;
    while i < edges.len() {
      let e = *edges[i];
      var pts = new Array[Pt, 3] <- fill e.a;
      pts[1] = e.b;
      pts[2] = e.c;
      var k = 0usize;
      while k < 3usize {
        if pts[k].x < x0 { x0 = pts[k].x; }
        if pts[k].x > x1 { x1 = pts[k].x; }
        if pts[k].y < y0 { y0 = pts[k].y; }
        if pts[k].y > y1 { y1 = pts[k].y; }
        k = k + 1usize;
      }
      i = i + 1usize;
    }
    *lo = new Pt(x0, y0);
    *hi = new Pt(x1, y1);
  }

  // The winding number of the contours round p, by a ray towards +x: not
  // zero inside the filled area (TrueType's rule)
  pub fn windingAt(self &, p Pt) i32 {
    // A ray a hair above p, so that a vertex on it is not counted twice or not at all
    let y = p.y + 1.0e-7;
    var w = 0i32;
    var i = 0usize;
    while i < edges.len() {
      let e = *edges[i];
      if e.kind == EDGE_LINE {
        if (e.a.y <= y) != (e.c.y <= y) {
          let x = e.a.x + (y - e.a.y) / (e.c.y - e.a.y) * (e.c.x - e.a.x);
          if x > p.x {
            if e.c.y > e.a.y { w = w + 1i32; } else { w = w - 1i32; }
          }
        }
      } else {
        let qa = e.a.y - 2.0 * e.b.y + e.c.y;
        let qb = 2.0 * (e.b.y - e.a.y);
        var roots = new Array[f64, 3] <- fill 0.0;
        let n = solveQuadratic(&mut roots, qa, qb, e.a.y - y);
        var k = 0i32;
        while k < n and k < 2i32 {
          let t = roots[usize.from(u32.from(k))];
          if t >= 0.0 and t < 1.0 {
            let dy = 2.0 * qa * t + qb;
            if libc.fabs(dy) > 1.0e-12 and e.point(t).x > p.x {
              if dy > 0.0 { w = w + 1i32; } else { w = w - 1i32; }
            }
          }
          k = k + 1i32;
        }
      }
      i = i + 1usize;
    }
    w
  }

  // Whether the point 'e' has at parameter t is on the boundary of the
  // filled area: the material (the right of the edge's direction) is on one
  // side only
  fn onBoundary(self &, e Edge, t f64) bool {
    let p = e.point(t);
    let d = e.direction(t).normalized();
    let right = new Pt(d.y, -d.x) * 0.25;
    self.windingAt(p + right) != 0i32 and self.windingAt(p - right) == 0i32
  }

  // The parameters at which edge number 'ei' crosses another edge, found by
  // cutting each other edge into short straight segments (a line is one; a
  // quadratic 16) and solving the edge against each segment exactly (a line:
  // linearly; a quadratic: a quadratic equation). Unsorted.
  fn crossings(self &, ei usize, out &mut List[f64]) {
    let e = *edges[ei];
    var fi = 0usize;
    while fi < edges.len() {
      if fi != ei {
        let f = *edges[fi];
        // A line also gets cut where another edge's end lies on it (the
        // other edge may run along it, which a crossing does not show)
        if e.kind == EDGE_LINE {
          let ab = e.c - e.a;
          let abab = ab.dot(ab);
          var end = 0u32;
          while end < 2u32 {
            let p = if end == 0u32 { f.a } else { f.c };
            let t = (p - e.a).dot(ab) / abab;
            if t > 0.0 and t < 1.0 and (e.a + ab * t - p).length() < 0.01 { out.push(t); }
            end = end + 1u32;
          }
        }
        let steps = if f.kind == EDGE_LINE { 1u32 } else { 16u32 };
        var prev = f.a;
        var s = 1u32;
        while s <= steps {
          let cur = f.point(f64.from(s) / f64.from(steps));
          let dir = cur - prev;
          let dd = dir.dot(dir);
          if dd > 0.0 {
            if e.kind == EDGE_LINE {
              let ab = e.c - e.a;
              let denom = ab.cross(dir);
              if libc.fabs(denom) > 1.0e-12 {
                let t = (prev - e.a).cross(dir) / denom;
                let u = (prev - e.a).cross(ab) / denom;
                if t > 0.0 and t < 1.0 and u >= 0.0 and u <= 1.0 { out.push(t); }
              }
            } else {
              // cross(e(t) - prev, dir) = c0 + c1 t + c2 t^2
              let c0 = (e.a - prev).cross(dir);
              let c1 = 2.0 * (e.b - e.a).cross(dir);
              let c2 = (e.a - e.b - e.b + e.c).cross(dir);
              var roots = new Array[f64, 3] <- fill 0.0;
              let n = solveQuadratic(&mut roots, c2, c1, c0);
              var k = 0i32;
              while k < n and k < 2i32 {
                let t = roots[usize.from(u32.from(k))];
                if t > 0.0 and t < 1.0 {
                  let u = (e.point(t) - prev).dot(dir) / dd;
                  if u >= 0.0 and u <= 1.0 { out.push(t); }
                }
                k = k + 1i32;
              }
            }
          }
          prev = cur;
          s = s + 1u32;
        }
      }
      fi = fi + 1usize;
    }
  }

  // When contours overlap, or one crosses itself, some edges run inside the
  // filled area, where a distance field would measure to them as if they
  // were an outline (a hole in a stroke where it crosses another). This
  // replaces the edges by the pieces of them that lie on the boundary of the
  // filled area: each edge is cut where it crosses another ('crossings') and
  // a piece is kept if, at three points along it, the material (the right of
  // its direction) is inside the fill and the other side outside it, by the
  // winding number. The pieces are linked end to start into closed contours
  // again (each contour of the union's boundary), their windings set, ready
  // for 'colorEdges', which then finds the new corners where edges cross.
  // Answers whether it changed anything: a shape with no edge inside is left
  // as it was. Call it before 'colorEdges'.
  pub fn resolveOverlaps(self &mut) bool {
    var kept = List[Edge].empty();
    var parent = List[usize].empty();         // for each kept piece: its edge, and the parameters it spans
    var starts = List[f64].empty();
    var stops = List[f64].empty();
    var changed = false;
    var i = 0usize;
    while i < edges.len() {
      let e = *edges[i];
      var cuts = List[f64].empty();
      cuts.push(0.0);
      self.crossings(i, &mut cuts);
      cuts.push(1.0);
      // Sorted by insertion
      var a = 1usize;
      while a < cuts.len() {
        let v = *cuts[a];
        var b = a;
        while b > 0usize and *cuts[b - 1usize] > v { cuts.set(b, *cuts[b - 1usize]); b = b - 1usize; }
        cuts.set(b, v);
        a = a + 1usize;
      }
      // Pieces between cuts: those on the boundary are kept
      var k = 0usize;
      while k + 1usize < cuts.len() {
        let t0 = *cuts[k];
        let t1 = *cuts[k + 1usize];
        if t1 - t0 > 1.0e-9 {
          var on = 0u32;
          var s = 1u32;
          while s < 4u32 {
            if self.onBoundary(e, t0 + (t1 - t0) * f64.from(s) / 4.0) { on = on + 1u32; }
            s = s + 1u32;
          }
          if on >= 2u32 {
            kept.push(e.sub(t0, t1));
            parent.push(i);
            starts.push(t0);
            stops.push(t1);
          } else {
            changed = true;
          }
        }
        k = k + 1usize;
      }
      i = i + 1usize;
    }
    if !changed { return false; }
    // Two contours along one line (a serif's top and a stem's) leave the same
    // piece twice: keep one
    var unique = List[bool].empty();
    i = 0usize;
    while i < kept.len() {
      let e = *kept[i];
      var seen = false;
      var j = 0usize;
      while j < i {
        if *unique[j] {
          let u = *kept[j];
          if (u.a - e.a).length() < 0.01 and (u.c - e.c).length() < 0.01 and (u.b - e.b).length() < 0.05 { seen = true; }
        }
        j = j + 1usize;
      }
      unique.push(!seen);
      i = i + 1usize;
    }
    // Pieces that follow one another along one edge join up again
    var joined = List[Edge].empty();
    i = 0usize;
    while i < kept.len() {
      if *unique[i] {
        var stop = *stops[i];
        let p = *parent[i];
        var j = i + 1usize;
        var more = true;
        while more and j < kept.len() {
          if !*unique[j] { j = j + 1usize; }
          elif *parent[j] == p and *starts[j] == stop { stop = *stops[j]; j = j + 1usize; }
          else { more = false; }
        }
        joined.push(if *starts[i] == 0.0 and stop == 1.0 { *edges[p] } else { (*edges[p]).sub(*starts[i], stop) });
        i = j;
      } else {
        i = i + 1usize;
      }
    }
    kept = joined;
    // Link the pieces end to start into closed contours again (a piece
    // begins within 'tol' of where its predecessor ends: the cuts were found
    // against short segments, not the curves), snapping each start to the
    // end before it so that the corners are exact
    var lo = new Pt(0.0, 0.0);
    var hi = new Pt(0.0, 0.0);
    self.bounds(&mut lo, &mut hi);
    let tol = fmax64(hi.x - lo.x, hi.y - lo.y) * 0.003;
    var used = List[bool].empty();
    i = 0usize;
    while i < kept.len() { used.push(false); i = i + 1usize; }
    var linked = List[Edge].empty();
    var made = List[Contour].empty();
    i = 0usize;
    while i < kept.len() {
      if !*used[i] {
        used.set(i, true);
        let begin = linked.len();
        let startPoint = (*kept[i]).a;
        linked.push(*kept[i]);
        var cur = (*kept[i]).c;
        var going = true;
        while going {
          if (cur - startPoint).length() < tol and linked.len() - begin >= 2usize {
            // closed: the last end is the first start
            var last = *linked[linked.len() - 1usize];
            last.c = startPoint;
            linked.set(linked.len() - 1usize, last);
            going = false;
          } else {
            var best = kept.len();
            var bestDistance = tol;
            var j = 0usize;
            while j < kept.len() {
              if !*used[j] {
                let d = ((*kept[j]).a - cur).length();
                if d < bestDistance { bestDistance = d; best = j; }
              }
              j = j + 1usize;
            }
            if best >= kept.len() {
              going = false;
            } else {
              used.set(best, true);
              var next = *kept[best];
              next.a = cur;
              linked.push(next);
              cur = next.c;
            }
          }
        }
        made.push(new Contour(u32.from(begin), u32.from(linked.len() - begin), 1i32));
      }
      i = i + 1usize;
    }
    edges = linked;
    contours = made;
    self.setWindings();
    true
  }
}

// ---- Edge colouring: msdfgen's edgeColoringSimple (Chlumsky) ----

// The next colour of a cycle: from white or black, the seed picks cyan,
// magenta or yellow; otherwise the colour's bits rotate, the seed picking
// the direction; 'banned' (a single channel) is avoided
fn switchColor(color u32, seed &mut u64, banned u32) u32 {
  let combined = color & banned;
  if combined == COLOR_RED or combined == COLOR_GREEN or combined == COLOR_BLUE {
    return combined ^ COLOR_WHITE;
  }
  if color == COLOR_BLACK or color == COLOR_WHITE {
    let pick = *seed % 3u64;
    *seed = *seed / 3u64;
    if pick == 0u64 { return COLOR_CYAN; }
    if pick == 1u64 { return COLOR_MAGENTA; }
    return COLOR_YELLOW;
  }
  let shifted = color << (1u32 + u32.from(*seed & 1u64));
  *seed = *seed >> 1u64;
  (shifted | (shifted >> 3u32)) & COLOR_WHITE
}

// Whether the corner between directions a and b (unit vectors) is sharp
fn isCorner(a Pt, b Pt, crossThreshold f64) bool {
  a.dot(b) <= 0.0 or libc.fabs(a.cross(b)) > crossThreshold
}

// Colours a shape's edges so that every sharp corner (turning more than
// 'angleThreshold' radians) is where two edges of different colours meet
// (Chlumsky's method, "Shape Decomposition for Multi-channel Distance
// Fields", 2015): a contour with no corner is all white, with one it is
// three colours in the teardrop pattern (an edge cut in thirds if it has
// fewer than three), else the colour cycles through cyan, magenta and
// yellow at each corner. 'seed' varies the cycle. Edges are split in place
// where the pattern needs it, so contour ranges change.
pub fn colorEdges(shape &mut Shape, angleThreshold f64, seed0 u64) {
  let crossThreshold = libc.sin(angleThreshold);
  var seed = seed0;
  var outEdges = List[Edge].empty();
  var outContours = List[Contour].empty();
  var ci = 0usize;
  while ci < shape.contours.len() {
    let c = *shape.contours[ci];
    let m = usize.from(c.count);
    let begin = usize.from(c.start);
    // Corners: the index of each edge whose start is a sharp corner
    var corners = List[usize].empty();
    var prev = (*shape.edges[begin + m - 1usize]).direction(1.0).normalized();
    var i = 0usize;
    while i < m {
      let e = *shape.edges[begin + i];
      if isCorner(prev, e.direction(0.0).normalized(), crossThreshold) { corners.push(i); }
      prev = e.direction(1.0).normalized();
      i = i + 1usize;
    }
    let outBegin = outEdges.len();
    if corners.len() == 0usize {
      i = 0usize;
      while i < m {
        var e = *shape.edges[begin + i];
        e.color = COLOR_WHITE;
        outEdges.push(e);
        i = i + 1usize;
      }
    } elif corners.len() == 1usize {
      var c0 = switchColor(COLOR_WHITE, &mut seed, COLOR_BLACK);
      let c2 = switchColor(c0, &mut seed, COLOR_BLACK);
      let corner = *corners[0];
      if m >= 3usize {
        // colors + 1 indexes [-1, 0, 1]: first colour, white, second
        i = 0usize;
        while i < m {
          let slot = i32.from(3.0 + 2.875 * f64.from(i) / f64.from(m - 1usize) - 1.4375 + 0.5) - 3i32;
          var e = *shape.edges[begin + (corner + i) % m];
          e.color = if slot < 0i32 { c0 } elif slot == 0i32 { COLOR_WHITE } else { c2 };
          outEdges.push(e);
          i = i + 1usize;
        }
      } else {
        // Fewer than three edges: split in thirds
        var parts = List[Edge].empty();
        let e0 = *shape.edges[begin];
        if m == 1usize {
          var k = 0u32;
          while k < 3u32 { parts.push(e0.third(k)); k = k + 1u32; }
          var p = 0usize;
          while p < 3usize {
            var pe = *parts[p];
            pe.color = if p == 0usize { c0 } elif p == 1usize { COLOR_WHITE } else { c2 };
            outEdges.push(pe);
            p = p + 1usize;
          }
        } else {
          // Two edges: the corner edge's thirds first
          let e1 = *shape.edges[begin + 1usize];
          let first = if corner == 0usize { e0 } else { e1 };
          let second = if corner == 0usize { e1 } else { e0 };
          var k = 0u32;
          while k < 3u32 { parts.push(first.third(k)); k = k + 1u32; }
          k = 0u32;
          while k < 3u32 { parts.push(second.third(k)); k = k + 1u32; }
          var p = 0usize;
          while p < 6usize {
            var pe = *parts[p];
            pe.color = if p < 2usize { c0 } elif p < 4usize { COLOR_WHITE } else { c2 };
            outEdges.push(pe);
            p = p + 1usize;
          }
        }
      }
    } else {
      let cornerCount = corners.len();
      var spline = 0usize;
      let start = *corners[0];
      var color = switchColor(COLOR_WHITE, &mut seed, COLOR_BLACK);
      let initial = color;
      i = 0usize;
      while i < m {
        let index = (start + i) % m;
        if spline + 1usize < cornerCount and *corners[spline + 1usize] == index {
          spline = spline + 1usize;
          let banned = if spline == cornerCount - 1usize { initial } else { COLOR_BLACK };
          color = switchColor(color, &mut seed, banned);
        }
        var e = *shape.edges[begin + index];
        e.color = color;
        outEdges.push(e);
        i = i + 1usize;
      }
    }
    outContours.push(new Contour(u32.from(outBegin), u32.from(outEdges.len() - outBegin), c.winding));
    ci = ci + 1usize;
  }
  shape.edges = outEdges;
  shape.contours = outContours;
}
