// ======== TextRenderer: laid-out text drawn on the GPU ========
//
// The atlas becomes one RGBA8 texture (uploaded whole when its version
// changes). Each text is a slot: an instance buffer (the layout's quads, 32
// bytes a glyph), a uniform buffer (its transform, colours and effects) and a
// bind group; drawing a slot is one instanced draw of 6 vertices a glyph with
// no vertex buffer (msdftext.slang). Two pipelines, sharing the shader:
//
// - overlay text: no depth, drawn after tone mapping into the screen's or a
//   texture's pixels ('renderOverlay'), the text's units pixels, y down;
// - world text: depth tested (not written) against the depth the scene left,
//   drawn into render's HDR frame before bloom and tone mapping, or into any
//   texture ('renderWorld'), the text's units metres.
//
// A slot's transform takes the text's own space (the layout's block space: x
// right, y DOWN, the origin at the block's top left) into clip space. Build it
// with the helpers below: 'overlayTransform', 'worldTransform' (from a
// placement and an anchor), 'billboardPlacement' (facing a camera).

// How a text looks. Distances are in the text's units (pixels for overlay
// text, metres in the world).
pub struct TextStyle {
  pub color: Color;                 // the fill (straight alpha)
  pub outlineColor: Color;
  pub outlineWidth: f32;            // 0: none
  pub shadowColor: Color;           // alpha 0: none
  pub shadowOffset: Vec2;           // where the shadow falls from the glyph (y down)
  pub shadowSoftness: f32;          // the width of its soft edge

  // Plain text in 'color': no outline, no shadow
  pub fn plain(color: Color) TextStyle {
    TextStyle(color, Color(0., 0., 0., 1.), 0., Color(0., 0., 0., 0.), Vec2(0., 0.), 0.)
  }
}

// Which pass draws a text
pub const SPACE_OVERLAY = 0u32;
pub const SPACE_WORLD = 1u32;

// Names one text of a TextRenderer
pub struct TextHandle {
  pub index: u32;
}

const PARAMS_BYTES = 144u64;       // msdftext.slang's TextParams
const QUAD_BYTES = 32u64;

struct TextSlot {
  instances: Buffer;
  capacity: u32;                    // glyphs the instance buffer holds
  uniforms: Buffer;
  group: BindGroup;
  count: u32;                       // glyphs drawn
  space: u32;
}

pub struct TextRenderer {
  shader: ShaderModule;
  groupLayout: BindGroupLayout;
  layout: PipelineLayout;
  pub overlayPipeline: RenderPipeline;
  pub worldPipeline: RenderPipeline;
  sampler: Sampler;
  pub texture: Texture;
  view: TextureView;
  uploaded: u32;                    // the atlas version the texture holds (+1; 0: none)
  pxRange: f32;
  emPx: f32;
  atlasWidth: f32;
  atlasHeight: f32;
  slots: List[TextSlot];
  pub drawCalls: u32;               // draws the last render made
  pub glyphs: u64;                  // and glyphs they drew

  // A renderer for text from 'atlas', drawing into overlay targets of
  // 'overlayFormat' and world targets of 'worldFormat' tested against a depth
  // texture of 'depthFormat'. Check 'isValid'.
  pub fn create(device: &mut Device, atlas: &Atlas, overlayFormat: u32, worldFormat: u32, depthFormat: u32) TextRenderer {
    var shader = device.createShaderModule(&MSDFTEXT_SPIRV);
    let entries = [BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT),
      BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    var groupLayout = device.createBindGroupLayout(&entries);
    let groupLayouts = [&groupLayout];
    var layout = device.createPipelineLayout(&groupLayouts, 0u32);
    let attributes = [VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 0u64, 0u32),
      VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 16u64, 1u32)];
    let buffers = [VertexBufferLayout(arrayStride: QUAD_BYTES, stepMode: VERTEX_STEP_MODE_INSTANCE, attributes: &attributes)];
    // Premultiplied alpha: the shader composes its layers itself
    let overlayDesc = RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, vertexEntryPoint: "vertexMain",
      buffers: &buffers, fragmentModule: &shader, fragmentEntryPoint: "fragmentMain", colorFormat: overlayFormat,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var overlayPipeline = device.createRenderPipeline(&overlayDesc);
    let worldDesc = RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, vertexEntryPoint: "vertexMain",
      buffers: &buffers, fragmentModule: &shader, fragmentEntryPoint: "fragmentMain", colorFormat: worldFormat,
      depthFormat: depthFormat, depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS_EQUAL,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var worldPipeline = device.createRenderPipeline(&worldDesc);
    let samplerDesc = SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    var sampler = device.createSampler(&samplerDesc);
    let textureDesc = TextureDescriptor(atlas.config.width, atlas.config.height, TEXTURE_FORMAT_RGBA8_UNORM,
      TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST);
    var texture = device.createTexture(&textureDesc);
    var view = texture.createView();
    TextRenderer(shader, groupLayout, layout, overlayPipeline, worldPipeline, sampler, texture, view, 0u32,
      f32.from(atlas.config.pxRange), f32.from(atlas.config.emPx), f32.from(atlas.config.width),
      f32.from(atlas.config.height), List[TextSlot].empty(), 0u32, 0u64)
  }

  pub fn isValid(self: &) bool {
    overlayPipeline.isValid() && worldPipeline.isValid() && texture.isValid() && sampler.isValid()
  }

  // Upload the atlas to the texture if it has changed since the last time
  pub fn syncAtlas(self: &mut, device: &mut Device, atlas: &Atlas) {
    if uploaded == atlas.version + 1u32 { return; }
    device.queue.writeTexture(&texture, atlas.pixels.view() as *u8, atlas.config.width * 4u32);
    uploaded = atlas.version + 1u32;
  }

  // A new text slot in 'space' (SPACE_...); it draws nothing until 'set'
  pub fn addText(self: &mut, device: &mut Device, space: u32) TextHandle {
    var instances = device.createBuffer(QUAD_BYTES, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
    var uniforms = device.createBuffer(PARAMS_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    let entries = [BindGroupEntry.buffer(0u32, &uniforms), BindGroupEntry.texture(1u32, &view),
      BindGroupEntry.sampler(2u32, &sampler)];
    var group = device.createBindGroup(&groupLayout, &entries);
    let index = u32.from(slots.len());
    slots.push(TextSlot(instances, 1u32, uniforms, group, 0u32, space));
    TextHandle(index)
  }

  pub fn textCount(self: &) usize { slots.len() }

  // Make slot 'h' draw 'text' in 'style', its space taken to clip space by
  // 'transform', from the next submission on. The atlas must hold the
  // glyphs: call 'syncAtlas' after laying text out.
  pub fn set(self: &mut, device: &mut Device, h: TextHandle, text: &TextLayout, style: &TextStyle, transform: Mat4) {
    if usize.from(h.index) >= slots.len() { return; }
    var slot = &mut slots[usize.from(h.index)];
    let n = u32.from(text.quads.len());
    if n > slot.capacity {
      device.queue.releaseBuffer(&mut slot.instances);
      slot.instances = device.createBuffer(u64.from(n) * QUAD_BYTES, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
      slot.capacity = n;
    }
    if n > 0u32 {
      var data = List[f32].withCapacity(usize.from(n) * 8usize);
      var i = 0usize;
      while i < text.quads.len() {
        let q = *text.quads[i];
        data.push(q.x0);
        data.push(q.y0);
        data.push(q.x1);
        data.push(q.y1);
        data.push(q.u0);
        data.push(q.v0);
        data.push(q.u1);
        data.push(q.v1);
        i = i + 1usize;
      }
      let raw: *f32 = data.view() as *f32;
      device.queue.writeBuffer(&slot.instances, 0u64, raw as *u8, u64.from(n) * QUAD_BYTES);
    }
    slot.count = n;
    // TextParams
    var p = Array[f32, 36]() <- fill 0f;
    var k = 0usize;
    while k < 16usize { p[k] = transform.m[k]; k = k + 1usize; }
    p[16] = style.color.red;
    p[17] = style.color.green;
    p[18] = style.color.blue;
    p[19] = style.color.alpha;
    p[20] = style.outlineColor.red;
    p[21] = style.outlineColor.green;
    p[22] = style.outlineColor.blue;
    p[23] = style.outlineColor.alpha;
    p[24] = style.shadowColor.red;
    p[25] = style.shadowColor.green;
    p[26] = style.shadowColor.blue;
    p[27] = style.shadowColor.alpha;
    // The field's whole range in the text's units: pxRange texels of an
    // em that is emPx texels, the em being 'size' units
    let rangeUnits = pxRange / emPx * text.size;
    p[28] = rangeUnits;
    p[29] = pxRange;
    p[30] = emPx / (text.size * atlasWidth);
    p[31] = emPx / (text.size * atlasHeight);
    p[32] = style.outlineWidth;
    p[33] = style.shadowSoftness;
    p[34] = style.shadowOffset.x;
    p[35] = style.shadowOffset.y;
    device.queue.writeBuffer(&slot.uniforms, 0u64, &p as *u8, PARAMS_BYTES);
  }

  // Stop drawing slot 'h'
  pub fn clearText(self: &mut, h: TextHandle) {
    if usize.from(h.index) < slots.len() { slots[usize.from(h.index)].count = 0u32; }
  }

  fn drawSlots(self: &mut, pass: &mut RenderPass, pipeline: &RenderPipeline, space: u32) {
    pass.setPipeline(pipeline);
    var i = 0usize;
    while i < slots.len() {
      let slot = slots[i];
      if slot.count > 0u32 && slot.space == space {
        pass.setBindGroup(0u32, &slot.group);
        pass.setVertexBuffer(0u32, &slot.instances, 0u64);
        pass.draw(6u32, slot.count, 0u32, 0u32);
        drawCalls = drawCalls + 1u32;
        glyphs = glyphs + u64.from(slot.count);
      }
      i = i + 1usize;
    }
  }

  // Record a pass drawing every overlay text into 'target' (its contents
  // kept), no depth
  pub fn renderOverlay(self: &mut, encoder: &mut CommandEncoder, target: &Texture) {
    drawCalls = 0u32;
    glyphs = 0u64;
    let color = RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_LOAD,
      clearValue: Color(0., 0., 0., 0.));
    var pass = encoder.beginRenderPass(&color);
    self.drawSlots(&mut pass, &overlayPipeline, SPACE_OVERLAY);
    pass.end();
  }

  // Record a pass drawing every world text into 'target' (its contents
  // kept), depth tested against 'depth' (kept by render's 'keepDepth')
  pub fn renderWorld(self: &mut, encoder: &mut CommandEncoder, target: &Texture, depth: &Texture) {
    drawCalls = 0u32;
    glyphs = 0u64;
    let color = RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_LOAD,
      clearValue: Color(0., 0., 0., 0.));
    let depthAttachment = RenderPassDepthStencilAttachment(view: depth.createView(), depthLoadOp: LOAD_OP_LOAD,
      depthStoreOp: STORE_OP_DISCARD);
    var pass = encoder.beginRenderPassWithDepth(&color, &depthAttachment);
    self.drawSlots(&mut pass, &worldPipeline, SPACE_WORLD);
    pass.end();
  }
}

// ---- Placing text ----

// The transform for overlay text with its top left at pixel (x, y) of a
// target 'width' x 'height' pixels: the text's units are pixels, y down
pub fn overlayTransform(width: f32, height: f32, x: f32, y: f32) Mat4 {
  Mat4.orthographic(0., width, height, 0., -1., 1.) * Mat4.fromTranslation(Vec3(x, y, 0.))
}

// The transform for text placed in the world. 'placement' is the text's
// frame: its +x runs along the text, +y up the page, +z towards a reader; the
// text's units are the placement's, metres for a placement of scale 1. The
// block's point (anchorX, anchorY) (0 to 1 across and down; (0.5, 0.5) its
// middle) is at the placement's origin. 'viewProjection' is the camera's.
pub fn worldTransform(viewProjection: Mat4, placement: Mat4, text: &TextLayout, anchorX: f32, anchorY: f32) Mat4 {
  viewProjection * placement * Mat4.fromScale(Vec3(1., -1., 1.))
    * Mat4.fromTranslation(Vec3(-anchorX * text.width, -anchorY * text.height, 0.))
}

// A placement at 'position' facing the camera: spherical (the text square to
// the view, turning with it) or, if 'cylindrical', staying upright about the
// world's y axis and turning only to face the camera's side
pub fn billboardPlacement(camera: &Camera, position: Vec3, cylindrical: bool) Mat4 {
  let c = camera.placement();
  if !cylindrical {
    let right = Vec3(c.m[0], c.m[1], c.m[2]).normalize();
    let up = Vec3(c.m[4], c.m[5], c.m[6]).normalize();
    let back = Vec3(c.m[8], c.m[9], c.m[10]).normalize();
    return basisMatrix(right, up, back, position);
  }
  let eye = c.translation();
  let toCamera = Vec3(eye.x - position.x, 0., eye.z - position.z);
  let back = if toCamera.lengthSquared() < 1.0e-12 { Vec3(0., 0., 1.) } else { toCamera.normalize() };
  let up = Vec3(0., 1., 0.);
  let right = up.cross(back).normalize();
  basisMatrix(right, up, back, position)
}

// The placement whose axes are 'x', 'y' and 'z' (unit vectors) at 'origin'
pub fn basisMatrix(x: Vec3, y: Vec3, z: Vec3, origin: Vec3) Mat4 {
  Mat4([x.x, x.y, x.z, 0f, y.x, y.y, y.z, 0f, z.x, z.y, z.z, 0f, origin.x, origin.y, origin.z, 1f])
}

