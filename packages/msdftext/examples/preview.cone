// Generates one glyph's multi-channel field from a font file and prints its
// median as characters: '#' inside, '.' outside, '+' within a quarter of the
// outline. Usage: congo run examples/preview.cone -- <font.ttf> <character>
mod preview;

import fs;
import path use Path;
import stdio use *;
import collections use *;
import msdftext use *;
import process;

fn main() i32 {
  imm args = process.args();
  if args.len() < 3usize { print <- "usage: preview <font.ttf> <char>\n"; return 1; }
  imm p = Path.fromLiteral(args[1].view());
  mut code = 0x41u32;
  imm ch = args[2];
  code = u32.from(ch[0usize]);
  match fs.readFile(&p) {
    case imm bytes Ok {
      match Font.load(bytes.view()) {
        case imm f Ok {
          imm g = f.glyphOf(code);
          imm o = f.outline(g);
          mut shape = Shape.fromOutline(&o);
          colorEdges(&mut shape, 3.0d, 0u64);
          imm box = f.glyphBox(g);
          imm px = 40.0d / f64.from(f.unitsPerEm);
          imm pad = 4.0d;
          imm w = u32.from((f64.from(box.xMax - box.xMin) * px) + 2.0d * pad + 1.0d);
          imm h = u32.from((f64.from(box.yMax - box.yMin) * px) + 2.0d * pad + 1.0d);
          imm frame = new Frame(w, h, px, pad / px - f64.from(box.xMin), pad / px - f64.from(box.yMin), 6.0d / px);
          mut field = generateMsdf(&shape, &frame);
          imm fixed = correctErrors(&mut field, &shape, &frame);
          print <- "glyph ", u64.from(g), " ", u64.from(w), "x", u64.from(h), " contours ", u64.from(shape.contours.len()),
            " edges ", u64.from(shape.edges.len()), " fixed ", u64.from(fixed), "\n";
          mut y = 0u32;
          while y < h {
            mut x = 0u32;
            while x < w {
              imm m = field.median(x, y);
              if m > 0.75 { print <- "#"; }
              elif m > 0.5 { print <- "+"; }
              elif m > 0.25 { print <- "-"; }
              else { print <- "."; }
              x = x + 1u32;
            }
            print <- "\n";
            y = y + 1u32;
          }
        }
        case imm e Error { print <- e.message(), "\n"; }
      }
    }
    case imm e Error { print <- "no file\n"; }
  }
  0;
}
