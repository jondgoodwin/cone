// Generates one glyph's multi-channel field and prints its median as
// characters: '#' well inside, '+' just inside, '-' just outside, '.' far outside.
// Usage: congo run examples/preview.cone -- <font.ttf | demo> <character> [raw]
// ('demo' is the built-in demo font; 'raw' skips error correction)
mod preview;

import fs;
import path use Path;
import stdio use *;
import collections use *;
import msdftext use *;
import process;

fn show(f: &Font, code: u32, raw: bool, dump: bool) {
  let g = f.glyphOf(code);
  let o = f.outline(g);
  var shape = Shape.fromOutline(&o);
  let resolved = shape.resolveOverlaps();
  print <- "overlaps resolved: ", if resolved { "yes" } else { "no" }, "\n";
  if dump {
    var c = 0usize;
    while c < shape.contours.len() {
      let ct = *shape.contours[c];
      print <- "contour ", u64.from(c), " winding ", i64.from(ct.winding), "\n";
      var k = 0u32;
      while k < ct.count {
        let e = *shape.edges[usize.from(ct.start + k)];
        print <- "  edge ", u64.from(e.kind), " (", e.a.x, ",", e.a.y, ") (", e.b.x, ",", e.b.y, ") (", e.c.x, ",", e.c.y, ")\n";
        k = k + 1u32;
      }
      c = c + 1usize;
    }
  }
  colorEdges(&mut shape, 3.0, 0u64);
  let box = f.glyphBox(g);
  let px = 48.0 / f64.from(f.unitsPerEm);
  let pad = 5.0;
  let w = u32.from((f64.from(box.xMax - box.xMin) * px) + 2.0 * pad + 1.0);
  let h = u32.from((f64.from(box.yMax - box.yMin) * px) + 2.0 * pad + 1.0);
  let frame = Frame(w, h, px, pad / px - f64.from(box.xMin), pad / px - f64.from(box.yMin), 6.0 / px);
  var field = generateMsdf(&shape, &frame);
  var fixed = 0u32;
  if !raw { fixed = correctErrors(&mut field, &shape, &frame); }
  print <- "glyph ", u64.from(g), " ", u64.from(w), "x", u64.from(h), " contours ", u64.from(shape.contours.len()),
    " edges ", u64.from(shape.edges.len()), " fixed ", u64.from(fixed), "\n";
  var y = 0u32;
  while y < h {
    var x = 0u32;
    while x < w {
      let m = field.median(x, y);
      if m > 0.75 { print <- "#"; }
      else if m > 0.5 { print <- "+"; }
      else if m > 0.25 { print <- "-"; }
      else { print <- "."; }
      x = x + 1u32;
    }
    print <- "\n";
    y = y + 1u32;
  }
}

fn main() i32 {
  let args = process.args();
  if args.len() < 3usize { print <- "usage: preview <font.ttf|demo> <char> [raw]\n"; return 1; }
  let code = u32.from((*args[2usize])[0usize]);
  let raw = args.len() > 3usize && (*args[3usize]).view() == "raw";
  let dump = args.len() > 3usize && (*args[3usize]).view() == "dump";
  if (*args[1usize]).view() == "demo" {
    match Font.load(&DEMO_FONT) {
      case let Ok(f) { show(&f, code, raw, dump); }
      case is Err { print <- "demo font failed\n"; }
    }
    return 0;
  }
  let p = Path.fromLiteral((*args[1usize]).view());
  match fs.readFile(&p) {
    case let Ok(bytes) {
      match Font.load(bytes.view()) {
        case let Ok(f) { show(&f, code, raw, dump); }
        case let Err(e) { print <- e.message().view(), "\n"; }
      }
    }
    case let Err(e) { print <- "no file\n"; }
  }
  0
}
