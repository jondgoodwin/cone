// Layout, checked by hand with the demo font at size 100 (a font unit is 0.1):
// advances A 60, I 40, O 70, space 30, i 70; ascent 80, descent -20, line gap
// 10, so the first baseline is at y = 80, the lines are 110 apart, and a
// one-line block is 100 high. Kerning (GPOS): A then I -6, O then I -3, O
// then A -2, and none for the other pairs.
//
// - "AI": A at 0, I at 60 - 6 = 54; without kerning at 60. The quad of I:
//   the standard atlas (48 texels to the em, range 6) gives I the margin
//   ceil(6/2) + 1 = 4 texels = 83.33 units, a cell of 18 x 42 texels: left
//   (100 - 83.33) / 1000 = 0.016667 em, right left + 18/48 = 0.391667,
//   bottom -0.083333, top bottom + 42/48 = 0.791667; so x0 = 54 + 1.6667 =
//   55.667, x1 = 54 + 39.1667 = 93.167, y0 = 80 - 79.167 = 0.8333, y1 =
//   80 + 8.333 = 88.333.
// - "AI AI" in 130: "AI" is 60 + 34 = 94 wide, the space 124, and the next A
//   would end at 184: the line breaks after the space, so the second line
//   begins with A at 0 and I at 54; two lines at baselines 80 and 190; block
//   height 210; the first line's ink width 94 (the space hangs).
// - "AAAAA" in 130: no space to break at, so two A (120) a line: 3 lines.
// - Alignment of "AI" (ink 94) in a block of 200: right, from 106; centre, from 53.
// - '\n' breaks a line; the missing glyph 'z' draws nothing and advances 50.
// - UTF-8: the bytes of e acute, the euro sign and U+1F600 decode to their
//   code points, and malformed bytes to U+FFFD.

mod layout;

import testing use *;
import collections use *;
import msdftext use *;

fn near(got f32, want f64, label &Array[u8]) {
  expectFloat(f64.from(got), want, 0.002d, label);
}

fn run(f &Font) {
  var atlas = Atlas.create(AtlasConfig.standard());
  var opts = LayoutOptions.make(100.0);

  let ai = layoutText(f, &mut atlas, "AI", &opts);
  expectUInt(u64.from(ai.glyphs.len()), 2u64, "AI: two glyphs");
  expectUInt(u64.from(ai.lines.len()), 1u64, "AI: one line");
  near((*ai.glyphs[0usize]).x, 0.0d, "AI: A at 0");
  near((*ai.glyphs[1usize]).x, 54.0d, "AI: I at 54, kerned");
  near((*ai.glyphs[0usize]).baseline, 80.0d, "AI: baseline 80");
  near(ai.height, 100.0d, "AI: height 100");
  near(ai.width, 94.0d, "AI: width 94");
  near(ai.lineAdvance, 110.0d, "AI: line advance 110");
  let qi = *ai.quads[usize.from(u32.from((*ai.glyphs[1usize]).quad))];
  near(qi.x0, 55.6667d, "I quad x0");
  near(qi.x1, 93.1667d, "I quad x1");
  near(qi.y0, 0.8333d, "I quad top");
  near(qi.y1, 88.3333d, "I quad bottom");
  expect(qi.u0 >= 0.0 and qi.u1 <= 1.0 and qi.u1 > qi.u0 and qi.v1 > qi.v0, "I quad: uv inside the atlas");

  var plain = opts;
  plain.kerning = false;
  let unkerned = layoutText(f, &mut atlas, "AI", &plain);
  near((*unkerned.glyphs[1usize]).x, 60.0d, "AI without kerning: I at 60");

  let oi = layoutText(f, &mut atlas, "OIOA", &opts);
  near((*oi.glyphs[1usize]).x, 70.0d - 3.0d, "O I: kerned -3 by class");
  near((*oi.glyphs[2usize]).x, 70.0d - 3.0d + 40.0d, "I O: no kerning");
  near((*oi.glyphs[3usize]).x, 70.0d - 3.0d + 40.0d + 70.0d - 2.0d, "O A: kerned -2 by class");

  var narrow = opts;
  narrow.maxWidth = 130.0;
  let wrapped = layoutText(f, &mut atlas, "AI AI", &narrow);
  expectUInt(u64.from(wrapped.lines.len()), 2u64, "AI AI in 130: two lines");
  near((*wrapped.lines[0usize]).width, 94.0d, "line 1 ink width 94, the space hangs");
  let second = (*wrapped.lines[1usize]).first;
  near((*wrapped.glyphs[usize.from(second)]).x, 0.0d, "line 2: A at 0");
  near((*wrapped.glyphs[usize.from(second) + 1usize]).x, 54.0d, "line 2: I at 54");
  near((*wrapped.lines[1usize]).baseline, 190.0d, "line 2: baseline 190");
  near(wrapped.height, 210.0d, "two lines: height 210");
  near(wrapped.width, 130.0d, "a given maxWidth is the block's width");

  let forced = layoutText(f, &mut atlas, "AAAAA", &narrow);
  expectUInt(u64.from(forced.lines.len()), 3u64, "AAAAA in 130: broken between glyphs, 3 lines");
  expectUInt(u64.from((*forced.lines[0usize]).count), 2u64, "AAAAA: 2 on the first line");

  var right = opts;
  right.maxWidth = 200.0;
  right.align = ALIGN_RIGHT;
  let r = layoutText(f, &mut atlas, "AI", &right);
  near((*r.glyphs[0usize]).x, 106.0d, "right aligned: starts at 106");
  var centre = right;
  centre.align = ALIGN_CENTER;
  let c = layoutText(f, &mut atlas, "AI", &centre);
  near((*c.glyphs[0usize]).x, 53.0d, "centred: starts at 53");

  let lines = layoutText(f, &mut atlas, "A\nI", &opts);
  expectUInt(u64.from(lines.lines.len()), 2u64, "newline: two lines");
  near((*lines.glyphs[1usize]).baseline, 190.0d, "newline: the second baseline");
  near((*lines.glyphs[1usize]).x, 0.0d, "newline: the pen returns");
  var tall = opts;
  tall.lineHeight = 2.0;
  let spaced = layoutText(f, &mut atlas, "A\nI", &tall);
  near(spaced.lineAdvance, 220.0d, "lineHeight 2: lines 220 apart");

  let missing = layoutText(f, &mut atlas, "AzI", &plain);
  expectUInt(u64.from((*missing.glyphs[1usize]).glyph), 0u64, "z is the missing glyph");
  expectInt(i64.from((*missing.glyphs[1usize]).quad), -1i64, "the missing glyph draws nothing");
  near((*missing.glyphs[2usize]).x, 60.0d + 50.0d, "and advances 50");

  let empty = layoutText(f, &mut atlas, "", &opts);
  expectUInt(u64.from(empty.glyphs.len()), 0u64, "empty text: no glyphs");
  expectUInt(u64.from(empty.lines.len()), 1u64, "empty text: one empty line");
}

fn utf8() {
  var bytes = new Array[u8, 12] <- fill 0u8;
  bytes[0] = 0xC3u8;
  bytes[1] = 0xA9u8;
  bytes[2] = 0xE2u8;
  bytes[3] = 0x82u8;
  bytes[4] = 0xACu8;
  bytes[5] = 0xF0u8;
  bytes[6] = 0x9Fu8;
  bytes[7] = 0x98u8;
  bytes[8] = 0x80u8;
  bytes[9] = 0xFFu8;
  bytes[10] = 0xC0u8;
  bytes[11] = 0x41u8;
  let cps = decodeUtf8(&bytes);
  expectUInt(u64.from(cps.len()), 6u64, "utf8: six code points");
  expectUInt(u64.from(*cps[0usize]), 0xE9u64, "utf8: e acute");
  expectUInt(u64.from(*cps[1usize]), 0x20ACu64, "utf8: euro");
  expectUInt(u64.from(*cps[2usize]), 0x1F600u64, "utf8: U+1F600");
  expectUInt(u64.from(*cps[3usize]), 0xFFFDu64, "utf8: 0xFF is malformed");
  expectUInt(u64.from(*cps[4usize]), 0xFFFDu64, "utf8: 0xC0 is malformed");
  expectUInt(u64.from(*cps[5usize]), 0x41u64, "utf8: A after it");
}

fn main() i32 {
  match Font.load(&DEMO_FONT) {
    case let f Ok { run(&f); }
    case is Error { require(false, "the demo font loads"); }
  }
  utf8();
  done();
}
