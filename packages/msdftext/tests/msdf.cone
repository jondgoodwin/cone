// Edge colouring, edge distances and the generated fields, checked against
// numbers worked out by hand and against an independent method: the shape
// flattened into thousands of short segments, the distance to the nearest
// segment, and the winding number for the sign. Only a failure prints.
//
// By hand, for the demo font's 'I' (the bar 100..300 x 0..700, clockwise: up
// its left side, along the top, down its right side, back along the bottom):
// - edges left (CYAN), top (MAGENTA), right (YELLOW), bottom (MAGENTA): the
//   cycle msdfgen's edgeColoringSimple makes with seed 0 (cyan, then the
//   bits rotate: magenta, yellow, and the last avoids the first, cyan's
//   channels: green is banned so it goes to magenta);
// - the triangle (0,0) (250,700) (500,0) is CYAN, MAGENTA, YELLOW;
// - at (200, 350), inside, every channel's nearest edge is 100 away (left or
//   right side), so with a range of 400 the value is 1/2 + 100/400 = 0.75;
// - at (50, -20), outside beyond the bottom left corner (100, 0), red's
//   nearest edge is the bottom (MAGENTA), whose line is 20 away, green's the
//   left (CYAN), whose line is 50 away, and blue ties on the corner, the
//   left winning the tie as more head-on: -20, -50, -50, values 0.45, 0.375,
//   0.375. (The true distance to the corner, 53.85, is what a plain distance
//   field would hold, and why the corner is sharp in the multi-channel one.)

mod msdf;

import testing use *;
import libc;
import collections use *;
import msdftext use *;

const NO_LIMIT = 1.0e30;

// ---- the independent method ----

// A shape flattened to segments (x0 y0 x1 y1) in a list of f64
fn flatten(shape &Shape, out &mut List[f64]) {
  var i = 0usize;
  while i < shape.edges.len() {
    let e = *shape.edges[i];
    let steps = if e.kind == EDGE_LINE { 1u32 } else { 400u32 };
    var prev = e.point(0.0);
    var s = 1u32;
    while s <= steps {
      let p = e.point(f64.from(s) / f64.from(steps));
      out.push(prev.x);
      out.push(prev.y);
      out.push(p.x);
      out.push(p.y);
      prev = p;
      s = s + 1u32;
    }
    i = i + 1usize;
  }
}

// The signed distance (positive inside, by nonzero winding) from p to the flattened shape
fn trueDistance(segs &List[f64], p Pt) f64 {
  var best = NO_LIMIT;
  var winding = 0i32;
  var i = 0usize;
  while i < segs.len() {
    let a = new Pt(*segs[i], *segs[i + 1usize]);
    let b = new Pt(*segs[i + 2usize], *segs[i + 3usize]);
    let ab = b - a;
    let ap = p - a;
    var t = ap.dot(ab) / ab.dot(ab);
    if t < 0.0 { t = 0.0; }
    if t > 1.0 { t = 1.0; }
    let d = (p - (a + ab * t)).length();
    if d < best { best = d; }
    // Winding by a ray towards +x
    if a.y <= p.y {
      if b.y > p.y and ab.cross(ap) > 0.0 { winding = winding + 1i32; }
    } elif b.y <= p.y and ab.cross(ap) < 0.0 {
      winding = winding - 1i32;
    }
    i = i + 4usize;
  }
  // Counter-clockwise contours wind +1 by the ray rule; TrueType's outer ones are clockwise
  if winding != 0i32 { return best; }
  -best
}

fn demoShape(codepoint u32) Shape {
  match Font.load(&DEMO_FONT) {
    case let f Ok {
      let o = f.outline(f.glyphOf(codepoint));
      return Shape.fromOutline(&o);
    }
    case is Error { }
  }
  Shape.empty()
}

// ---- checks ----

fn colours() {
  var tri = new Outline(List[f64].empty(), List[f64].empty(), List[bool].empty(), List[u32].empty());
  tri.xs.push(0.0);
  tri.ys.push(0.0);
  tri.on.push(true);
  tri.xs.push(250.0);
  tri.ys.push(700.0);
  tri.on.push(true);
  tri.xs.push(500.0);
  tri.ys.push(0.0);
  tri.on.push(true);
  tri.ends.push(2u32);
  var t = Shape.fromOutline(&tri);
  expectUInt(u64.from(t.edges.len()), 3u64, "triangle: 3 edges");
  expectInt(i64.from((*t.contours[0usize]).winding), 1i64, "triangle (clockwise): winding +1");
  colorEdges(&mut t, 3.0, 0u64);
  expectUInt(u64.from((*t.edges[0usize]).color), u64.from(COLOR_CYAN), "triangle: first edge cyan");
  expectUInt(u64.from((*t.edges[1usize]).color), u64.from(COLOR_MAGENTA), "triangle: second edge magenta");
  expectUInt(u64.from((*t.edges[2usize]).color), u64.from(COLOR_YELLOW), "triangle: third edge yellow");

  var bar = demoShape(0x49u32);
  expectUInt(u64.from(bar.edges.len()), 4u64, "bar: 4 edges");
  colorEdges(&mut bar, 3.0, 0u64);
  expectUInt(u64.from((*bar.edges[0usize]).color), u64.from(COLOR_CYAN), "bar: left cyan");
  expectUInt(u64.from((*bar.edges[1usize]).color), u64.from(COLOR_MAGENTA), "bar: top magenta");
  expectUInt(u64.from((*bar.edges[2usize]).color), u64.from(COLOR_YELLOW), "bar: right yellow");
  expectUInt(u64.from((*bar.edges[3usize]).color), u64.from(COLOR_MAGENTA), "bar: bottom magenta");

  // A smooth contour has no corner: all white. The O's four rounded corners are smooth.
  var ring = demoShape(0x4Fu32);
  expectUInt(u64.from(ring.contours.len()), 2u64, "O: 2 contours");
  expectInt(i64.from((*ring.contours[0usize]).winding), 1i64, "O: the outer contour winds +1");
  expectInt(i64.from((*ring.contours[1usize]).winding), -1i64, "O: the counter winds -1");
  expectUInt(u64.from(ring.edges.len()), 8u64, "O: 4 quadratics a contour");
  colorEdges(&mut ring, 3.0, 0u64);
  var allWhite = true;
  var i = 0usize;
  while i < ring.edges.len() { if (*ring.edges[i]).color != COLOR_WHITE { allWhite = false; } i = i + 1usize; }
  expect(allWhite, "O: smooth, so every edge is white");
}

fn edgeDistances() {
  // The quadratic (0,0) (50,100) (100,0) peaks at (50, 50). The point (50, 200)
  // is above it: the nearest point by brute force over the curve.
  let q = Edge.quad(new Pt(0.0, 0.0), new Pt(50.0, 100.0), new Pt(100.0, 0.0));
  var cases = new Array[Pt, 5] <- fill new Pt(0.0, 0.0);
  cases[0] = new Pt(50.0, 200.0);
  cases[1] = new Pt(20.0, 10.0);
  cases[2] = new Pt(-30.0, 40.0);
  cases[3] = new Pt(120.0, -10.0);
  cases[4] = new Pt(50.0, 20.0);
  var k = 0usize;
  while k < 5usize {
    let p = cases[k];
    var best = NO_LIMIT;
    var s = 0u32;
    while s <= 100000u32 {
      let d = (q.point(f64.from(s) / 100000.0) - p).length();
      if d < best { best = d; }
      s = s + 1u32;
    }
    var param = 0.0;
    let sd = q.signedDistance(p, &mut param);
    expectFloat(libc.fabs(sd.d), best, 0.001, "quadratic: the cubic solver finds the nearest point");
    k = k + 1usize;
  }
  // Signs: positive on the right of the direction of travel (the curve goes left to right and
  // bulges up, so the point below it is on the right: (50, 20) is inside the bulge, below the curve)
  var param = 0.0;
  expect(q.signedDistance(new Pt(50.0, 20.0), &mut param).d > 0.0, "quadratic: below a rightward curve is positive");
  expect(q.signedDistance(new Pt(50.0, 200.0), &mut param).d < 0.0, "quadratic: above it is negative");
  // A line
  let l = Edge.line(new Pt(100.0, 0.0), new Pt(100.0, 700.0));
  expectFloat(l.signedDistance(new Pt(200.0, 350.0), &mut param).d, 100.0, 1.0e-9, "line: 100 to its right is +100");
  expectFloat(l.signedDistance(new Pt(0.0, 350.0), &mut param).d, -100.0, 1.0e-9, "line: 100 to its left is -100");
  expectFloat(l.signedDistance(new Pt(150.0, 800.0), &mut param).d, 111.80339887, 1.0e-6, "line: beyond its end, the end's distance");
  expect(param > 1.0, "line: parameter beyond 1 past the end");
}

fn fieldValues() {
  var bar = demoShape(0x49u32);
  colorEdges(&mut bar, 3.0, 0u64);
  let frame = new Frame(40u32, 100u32, 0.1, 5.0, 25.0, 400.0);
  let field = generateMsdf(&bar, &frame);
  // Pixel (20, 62) is centred on (200, 350)
  let cp = frame.pointOf(20.0, 62.0);
  expectFloat(cp.x, 200.0, 1.0e-9, "frame: x of pixel 20");
  expectFloat(cp.y, 350.0, 1.0e-9, "frame: y of pixel 62");
  var ch = 0u32;
  while ch < 3u32 {
    expectFloat(f64.from(field.texel(20u32, 62u32, ch)), 0.75, 1.0e-6, "bar centre: every channel 0.75");
    ch = ch + 1u32;
  }
  // Pixel (5, 99) is centred on (50, -20)
  let op = frame.pointOf(5.0, 99.0);
  expectFloat(op.x, 50.0, 1.0e-9, "frame: x of pixel 5");
  expectFloat(op.y, -20.0, 1.0e-9, "frame: y of pixel 99");
  expectFloat(f64.from(field.texel(5u32, 99u32, 0u32)), 0.45, 1.0e-6, "corner: red -20");
  expectFloat(f64.from(field.texel(5u32, 99u32, 1u32)), 0.375, 1.0e-6, "corner: green -50");
  expectFloat(f64.from(field.texel(5u32, 99u32, 2u32)), 0.375, 1.0e-6, "corner: blue -50");
  expectFloat(f64.from(field.median(5u32, 99u32)), 0.375, 1.0e-6, "corner: median -50, not the true -53.85");
  // The plain distance field has the true distance there
  let sdf = generateSdf(&bar, &frame);
  expectFloat(f64.from(sdf.median(5u32, 99u32)), 0.5 - 53.8516480713 / 400.0, 1.0e-5, "sdf: the corner's true distance");
  expectFloat(f64.from(sdf.median(20u32, 62u32)), 0.75, 1.0e-6, "sdf: the centre");
}

// The multi-channel field's median against the flattened shape's true signed distance
fn againstBruteForce(codepoint u32, scale f64, range f64, what &Array[u8], maxBad u32) {
  var shape = demoShape(codepoint);
  colorEdges(&mut shape, 3.0, 0u64);
  var segs = List[f64].empty();
  flatten(&shape, &mut segs);
  var lo = new Pt(0.0, 0.0);
  var hi = new Pt(0.0, 0.0);
  shape.bounds(&mut lo, &mut hi);
  let pad = range * 0.5 + 5.0;
  let w = u32.from((hi.x - lo.x + 2.0 * pad) * scale) + 1u32;
  let h = u32.from((hi.y - lo.y + 2.0 * pad) * scale) + 1u32;
  let frame = new Frame(w, h, scale, pad - lo.x, pad - lo.y, range);
  let sdf = generateSdf(&shape, &frame);
  var worst = 0.0;
  var bad = 0u32;
  var y = 0u32;
  while y < h {
    var x = 0u32;
    while x < w {
      let p = frame.pointOf(f64.from(x), f64.from(y));
      let want = trueDistance(&segs, p);
      if libc.fabs(want) < range * 0.45 {
        let got = (f64.from(sdf.median(x, y)) - 0.5) * range;
        let err = libc.fabs(got - want);
        if err > worst { worst = err; }
        if err > 0.05 { bad = bad + 1u32; }
      }
      x = x + 1u32;
    }
    y = y + 1u32;
  }
  expectUInt(u64.from(bad), 0u64, what);
}

// The corrected field, sampled between texels like a GPU does, against the
// true shape: away from the outline, the interpolated median must be on the
// right side of 1/2.
fn bilinearSign(codepoint u32, scale f64, range f64, what &Array[u8], correct bool) u32 {
  var shape = demoShape(codepoint);
  colorEdges(&mut shape, 3.0, 0u64);
  var segs = List[f64].empty();
  flatten(&shape, &mut segs);
  var lo = new Pt(0.0, 0.0);
  var hi = new Pt(0.0, 0.0);
  shape.bounds(&mut lo, &mut hi);
  let pad = range * 0.5 + 5.0;
  let w = u32.from((hi.x - lo.x + 2.0 * pad) * scale) + 1u32;
  let h = u32.from((hi.y - lo.y + 2.0 * pad) * scale) + 1u32;
  let frame = new Frame(w, h, scale, pad - lo.x, pad - lo.y, range);
  var field = generateMsdf(&shape, &frame);
  if correct { correctErrors(&mut field, &shape, &frame); }
  var wrong = 0u32;
  // Sample a grid of fractional texel positions
  var y = 0u32;
  while y + 1u32 < h {
    var x = 0u32;
    while x + 1u32 < w {
      var fy = 0u32;
      while fy < 4u32 {
        var fx = 0u32;
        while fx < 4u32 {
          let u = f64.from(fx) / 4.0 + 0.125;
          let v = f64.from(fy) / 4.0 + 0.125;
          // Bilinear interpolation of each channel, then the median
          var m = new Array[f64, 3] <- fill 0.0;
          var ch = 0u32;
          while ch < 3u32 {
            let a = f64.from(field.texel(x, y, ch));
            let b = f64.from(field.texel(x + 1u32, y, ch));
            let c = f64.from(field.texel(x, y + 1u32, ch));
            let d = f64.from(field.texel(x + 1u32, y + 1u32, ch));
            m[usize.from(ch)] = (a * (1.0 - u) + b * u) * (1.0 - v) + (c * (1.0 - u) + d * u) * v;
            ch = ch + 1u32;
          }
          let med = new Rgb(m[0], m[1], m[2]).median();
          let p = frame.pointOf(f64.from(x) + u, f64.from(y) + v);
          let want = trueDistance(&segs, p);
          // More than 1.5 texels from the outline, the side must agree
          if libc.fabs(want) > 0.3 / scale and ((med > 0.5) != (want > 0.0)) { wrong = wrong + 1u32; }
          fx = fx + 1u32;
        }
        fy = fy + 1u32;
      }
      x = x + 1u32;
    }
    y = y + 1u32;
  }
  wrong
}

// A field made by hand: every texel (0.9, 0.9, 0.9) but a = (0.55, 0, 0.9) at
// column 2, row 2 and b = (0, 0.95, 0.9) beside it. Both are inside (medians
// 0.55 and 0.9), yet halfway between them the channels are (0.275, 0.475,
// 0.9), a median of 0.475: an edge drawn inside the shape. Both medians are
// on the inside, so the outline does not pass between the texels: nothing is
// protected, the clash is found, and both texels become their medians, a
// (0.55, 0.55, 0.55) and b (0.9, 0.9, 0.9). Halfway between them the median is
// then (0.55 + 0.9) / 2 = 0.725.
fn correctionMechanics() {
  var data = List[f32].empty();
  var i = 0usize;
  while i < 8usize * 6usize {
    data.push(0.9);
    data.push(0.9);
    data.push(0.9);
    i = i + 1usize;
  }
  let at = usize.from((2u32 * 8u32 + 2u32) * 3u32);
  data.set(at, 0.55);
  data.set(at + 1usize, 0.0);
  data.set(at + 3usize, 0.0);
  data.set(at + 4usize, 0.95);
  var field = new Field(8u32, 6u32, data);
  let none = Shape.empty();
  let frame = new Frame(8u32, 6u32, 1.0, 0.0, 0.0, 8.0);
  expectFloat(f64.from(field.median(2u32, 2u32)), 0.55, 1.0e-6, "hand field: a's median");
  let fixed = correctErrors(&mut field, &none, &frame);
  expectUInt(u64.from(fixed), 2u64, "hand field: a and b are replaced, nothing else");
  expectFloat(f64.from(field.texel(2u32, 2u32, 0u32)), 0.55, 1.0e-6, "hand field: a red");
  expectFloat(f64.from(field.texel(2u32, 2u32, 1u32)), 0.55, 1.0e-6, "hand field: a green is its median now");
  expectFloat(f64.from(field.texel(2u32, 2u32, 2u32)), 0.55, 1.0e-6, "hand field: a blue is its median now");
  expectFloat(f64.from(field.texel(3u32, 2u32, 0u32)), 0.9, 1.0e-6, "hand field: b red is its median now");
  expectFloat(f64.from(field.texel(3u32, 2u32, 1u32)), 0.9, 1.0e-6, "hand field: b green is its median now");
  var m = new Array[f64, 3] <- fill 0.0;
  var ch = 0u32;
  while ch < 3u32 {
    m[usize.from(ch)] = (f64.from(field.texel(2u32, 2u32, ch)) + f64.from(field.texel(3u32, 2u32, ch))) * 0.5;
    ch = ch + 1u32;
  }
  expectFloat(new Rgb(m[0], m[1], m[2]).median(), 0.725, 1.0e-6, "hand field: halfway between a and b, inside");
}

fn main() i32 {
  colours();
  edgeDistances();
  fieldValues();
  againstBruteForce(0x4Fu32, 0.05, 120.0, "O: sdf median equals the true distance", 0u32);
  againstBruteForce(0x49u32, 0.05, 120.0, "I: sdf median equals the true distance", 0u32);
  againstBruteForce(0x41u32, 0.05, 120.0, "A: sdf median equals the true distance", 0u32);
  let before = bilinearSign(0x41u32, 0.02, 160.0, "A", false);
  let after = bilinearSign(0x41u32, 0.02, 160.0, "A", true);
  expectUInt(u64.from(after), 0u64, "A, corrected: interpolated medians on the right side of the outline");
  let beforeO = bilinearSign(0x4Fu32, 0.02, 160.0, "O", false);
  let afterO = bilinearSign(0x4Fu32, 0.02, 160.0, "O", true);
  expectUInt(u64.from(afterO), 0u64, "O, corrected: interpolated medians on the right side of the outline");
  expect(after <= before and afterO <= beforeO, "correction does not add wrong samples");
  correctionMechanics();
  done()
}
