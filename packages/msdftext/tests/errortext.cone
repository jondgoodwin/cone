// The one line each error of this package gives a person is pinned here, with
// the number fields at their widest, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import msdftext use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- FontError(FONT_TOO_SHORT), "the file is too short", "too short");
  says(String() <- FontError(FONT_NOT_TRUETYPE), "not a TrueType font", "not truetype");
  says(String() <- FontError(FONT_CFF), "CFF outlines are not read yet", "cff");
  says(String() <- FontError(FONT_MISSING_TABLE), "a required table is missing", "table");
  says(String() <- FontError(FONT_NO_CMAP), "no usable cmap subtable", "cmap");
  says(String() <- FontError(FONT_OK), "no error", "ok");
  done()
}
