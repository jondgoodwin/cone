// Error correction on real glyphs. Some hard glyphs of an installed font (sharp
// apexes, thin joins, many contours) are made into fields at 24 texels to the
// em with a range of 6 texels; each field is sampled between texels,
// bilinearly as a GPU does, on a grid of fractional positions, and each
// sample's median is compared with the side of the outline the position truly
// is on (found by the glyph flattened to short segments, an independent
// method). A sample is wrong when the sides differ and the position is more
// than 'near' texels from the outline (closer, it is the outline's own
// position between texels that is uncertain: a sharp corner is rounded within
// its cell). Checked: no sample is wrong beyond 1.5 texels, corrected or not,
// and correction adds none beyond 1 texel. A font that is not installed is
// skipped. (The same on every printable ASCII glyph of Arial and of Cascadia
// Mono was measured to hold, with texels replaced in none of them: see the
// report; it takes over a minute in a debug build, so only these are run.)

mod correct;

import testing use *;
import fs;
import path use Path;
import libc;
import collections use *;
import msdftext use *;

fn flatten(shape: &Shape, out: &mut List[f64]) {
  var i = 0usize;
  while i < shape.edges.len() {
    let e = *shape.edges[i];
    let steps = if e.kind == EDGE_LINE { 1u32 } else { 16u32 };
    var prev = e.point(0.0);
    var s = 1u32;
    while s <= steps {
      let p = e.point(f64.from(s) / f64.from(steps));
      out.push(prev.x);
      out.push(prev.y);
      out.push(p.x);
      out.push(p.y);
      prev = p;
      s = s + 1u32;
    }
    i = i + 1usize;
  }
}

fn trueDistance(segs: &List[f64], p: Pt) f64 {
  var best = 1.0e30;
  var winding = 0i32;
  var i = 0usize;
  while i < segs.len() {
    let a = Pt(*segs[i], *segs[i + 1usize]);
    let b = Pt(*segs[i + 2usize], *segs[i + 3usize]);
    let ab = b - a;
    let ap = p - a;
    var t = ap.dot(ab) / ab.dot(ab);
    if t < 0.0 { t = 0.0; }
    if t > 1.0 { t = 1.0; }
    let d = (p - (a + ab * t)).length();
    if d < best { best = d; }
    if a.y <= p.y {
      if b.y > p.y && ab.cross(ap) > 0.0 { winding = winding + 1i32; }
    } elif b.y <= p.y && ab.cross(ap) < 0.0 {
      winding = winding - 1i32;
    }
    i = i + 4usize;
  }
  if winding != 0i32 { return best; }
  -best
}

// Wrong-side samples of the glyph's field beyond 1 and 1.5 texels from the outline: uncorrected
// (counts 0, 1) and corrected (2, 3)
fn wrongSamples(font: &Font, glyph: u32, counts: &mut Array[u32, 4]) {
  let o = font.outline(glyph);
  var shape = Shape.fromOutline(&o);
  if shape.edges.len() == 0usize { return; }
  colorEdges(&mut shape, 3.0, 0u64);
  var segs = List[f64].empty();
  flatten(&shape, &mut segs);
  var lo = Pt(0.0, 0.0);
  var hi = Pt(0.0, 0.0);
  shape.bounds(&mut lo, &mut hi);
  let scale = 24.0 / f64.from(font.unitsPerEm);
  let range = 6.0 / scale;
  let margin = 4.0;
  let w = u32.from((hi.x - lo.x) * scale + 2.0 * margin) + 1u32;
  let h = u32.from((hi.y - lo.y) * scale + 2.0 * margin) + 1u32;
  let frame = Frame(w, h, scale, margin / scale - lo.x, margin / scale - lo.y, range);
  let raw = generateMsdf(&shape, &frame);
  var fixed = generateMsdf(&shape, &frame);
  correctErrors(&mut fixed, &shape, &frame);
  var y = 0u32;
  while y + 1u32 < h {
    var x = 0u32;
    while x + 1u32 < w {
      var fy = 0u32;
      while fy < 3u32 {
        var fx = 0u32;
        while fx < 3u32 {
          let u = (f64.from(fx) + 0.5) / 3.0;
          let v = (f64.from(fy) + 0.5) / 3.0;
          let want = trueDistance(&segs, frame.pointOf(f64.from(x) + u, f64.from(y) + v));
          let texels = libc.fabs(want) * scale;
          if texels > 1.0 {
            let rawWrong = (sampleMedian(&raw, x, y, u, v) > 0.5) != (want > 0.0);
            let fixedWrong = (sampleMedian(&fixed, x, y, u, v) > 0.5) != (want > 0.0);
            if rawWrong { counts[0] = counts[0] + 1u32; }
            if fixedWrong { counts[2] = counts[2] + 1u32; }
            if texels > 1.5 {
              if rawWrong { counts[1] = counts[1] + 1u32; }
              if fixedWrong { counts[3] = counts[3] + 1u32; }
            }
          }
          fx = fx + 1u32;
        }
        fy = fy + 1u32;
      }
      x = x + 1u32;
    }
    y = y + 1u32;
  }
}

// The median of the bilinearly interpolated channels at (x + u, y + v)
fn sampleMedian(field: &Field, x: u32, y: u32, u: f64, v: f64) f64 {
  var m = Array[f64, 3]() <- fill 0.0;
  var ch = 0u32;
  while ch < 3u32 {
    let a = f64.from(field.texel(x, y, ch));
    let b = f64.from(field.texel(x + 1u32, y, ch));
    let c = f64.from(field.texel(x, y + 1u32, ch));
    let d = f64.from(field.texel(x + 1u32, y + 1u32, ch));
    m[usize.from(ch)] = (a * (1.0 - u) + b * u) * (1.0 - v) + (c * (1.0 - u) + d * u) * v;
    ch = ch + 1u32;
  }
  Rgb(m[0], m[1], m[2]).median()
}

fn runFont(file: &Path, name: &Array[u8], glyphs: &str) {
  match fs.readFile(file) {
    case Ok(bytes) {
      match Font.load(bytes.view()) {
        case Ok(f) {
          var counts = Array[u32, 4]() <- fill 0u32;
          var i = 0usize;
          while i < glyphs.len {
            wrongSamples(&f, f.glyphOf(u32.from(glyphs[i])), &mut counts);
            i = i + 1usize;
          }
          expectUInt(u64.from(counts[1]), 0u64, name);
          expectUInt(u64.from(counts[3]), 0u64, name);
          expect(counts[2] <= counts[0], "correction adds no wrong sample");
        }
        case is Error { require(false, "an installed font loads"); }
      }
    }
    case is Error { }
  }
}

fn main() i32 {
  runFont(&Path.fromLiteral("C:/Windows/Fonts/arial.ttf"), "Arial: no wrong side beyond 1.5 texels", "AVWgRS@&8%");
  runFont(&Path.fromLiteral("C:/Windows/Fonts/CascadiaMono.ttf"), "Cascadia: no wrong side beyond 1.5 texels", "AVWgRS@&8%");
  done()
}
