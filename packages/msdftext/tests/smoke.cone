mod smoke;

import testing use *;
import fs;
import path use Path;
import stdio use *;
import collections use *;
import msdftext use *;

fn main() i32 {
  imm p = Path.fromLiteral("C:/Windows/Fonts/CascadiaMono.ttf");
  match fs.readFile(&p) {
    case imm bytes Ok {
      match Font.load(bytes.view()) {
        case imm f Ok {
          expectUInt(u64.from(f.unitsPerEm), 2048u64, "upem");
          imm g = f.glyphOf(0x41u32);
          print <- "glyph A = ", u64.from(g), " adv ", u64.from(f.advance(g)), "\n";
          imm o = f.outline(g);
          print <- "pts ", u64.from(o.pointCount()), " contours ", u64.from(o.contourCount()), "\n";
        }
        case imm e Error { print <- e.message(), "\n"; }
      }
    }
    case imm e Error { print <- "no file\n"; }
  }
  done();
}
