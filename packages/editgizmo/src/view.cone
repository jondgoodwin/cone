// ======== GizmoView: where the camera is, in the terms the gizmo needs ========
//
// The eye, the combined view and projection (depth 0 to 1, as geomath's Mat4.perspective and render's
// Camera make them) and the picture's size in pixels. It turns a pixel into a world ray (the inverse of the
// projection at the near and far planes) and a world point into a pixel, and says how long a world distance
// is that looks 'frac' of the picture's height at a given point, which is how a gizmo keeps its on-screen size.

pub struct GizmoView {
  pub viewProj Mat4;
  pub inverse Mat4;
  pub eye Vec3 = new Vec3(0., 0., 5.);
  pub fovY f32 = 0.87;
  pub width f32 = 1280.;
  pub height f32 = 720.;

  // 'view' and 'proj' are the camera's matrices (render's Camera.viewMatrix() and projectionMatrix(aspect))
  pub fn make(eye Vec3, view Mat4, proj Mat4, fovY f32, width f32, height f32) GizmoView {
    let vp = proj * view;
    new GizmoView(vp, vp.inverse(), eye, fovY, width, height);
  }

  // A world point in the picture's pixels (x right, y down); z is the clip w, which is positive in front of
  // the camera and not otherwise (a point behind it has no place on the screen)
  pub fn project(self &, p Vec3) Vec3 {
    let h = viewProj * p.extend(1.);
    if h.w <= 0.0001 {return new Vec3(0., 0., h.w);}
    let nx = h.x / h.w;
    let ny = h.y / h.w;
    new Vec3((nx * 0.5 + 0.5) * width, (0.5 - ny * 0.5) * height, h.w);
  }

  // The ray through pixel (px, py), starting on the near plane
  pub fn rayAt(self &, px f32, py f32) Ray3 {
    let nx = px / width * 2. - 1.;
    let ny = 1. - py / height * 2.;
    let n = inverse * new Vec4(nx, ny, 0., 1.);
    let f = inverse * new Vec4(nx, ny, 1., 1.);
    let near = n.xyz() * (1. / n.w);
    let far = f.xyz() * (1. / f.w);
    new Ray3(near, (far - near).normalize());
  }

  // The world length that spans 'frac' of the picture's height at the distance of 'at'
  pub fn unitAt(self &, at Vec3, frac f32) f32 {
    let d = (at - eye).length();
    d * 2. * tan(fovY * 0.5) * frac;
  }

  // A world segment as a line in the draw list, when both ends are in front of the camera
  pub fn line(self &, a Vec3, b Vec3, color u32, thick f32, out &mut DrawList) {
    let pa = project(a);
    let pb = project(b);
    if pa.z <= 0.0001 or pb.z <= 0.0001 {return;}
    out.line(pa.x, pa.y, pb.x, pb.y, color, thick, 0usize);
  }
}
