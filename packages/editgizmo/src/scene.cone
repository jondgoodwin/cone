// ======== EditScene: the objects being edited, the selection, and every edit undoable ========
//
// An EditObject is a name, a mesh (an index into the scene's PickMesh table, so copies share one), a
// Transform3 and 'props': a list of Vec4 the host gives meaning to (a colour is one, a roughness and a
// metalness another). The scene knows nothing of drawing. The host keeps what it needs to draw an object
// (a GPU mesh handle, a material) under the same id.
//
// UNDO. textedit's History[SceneCmd] holds the commands. The host edits an object live (setTransform, setProp)
// while a pointer is down, and records the whole gesture once with commitTransform or commitProp, giving the
// value the gesture began with and the one it ended on. A command is the same whether it was made by a gizmo
// drag, by a number typed into an inspector or by a colour picker, so one stack undoes all of them in order.

pub const CK_TRANSFORM = 1u32;
pub const CK_PROP = 2u32;
pub const CK_SELECT = 3u32;

// An edit, with what it was and what it became
pub struct SceneCmd {
  pub kind u32;
  pub object u32;                  // the object's id
  pub prop u32;                    // CK_PROP: which property
  pub t0 Transform3;               // CK_TRANSFORM: before and after
  pub t1 Transform3;
  pub v0 Vec4;                     // CK_PROP: before and after
  pub v1 Vec4;
}

pub struct EditObject {
  pub id u32;
  pub name String;
  pub mesh usize;
  pub transform Transform3;
  pub props List[Vec4];
  pub visible bool = true;
}

// What History replays against (kept apart from the History so both can be borrowed at once)
pub struct SceneCore {
  pub meshes List[PickMesh];
  pub objects List[EditObject];
  pub selected u32 = 0u32;         // the selected object's id, 0 for none
  pub nextId u32 = 1u32;
  pub version u32 = 0u32;          // changes whenever anything does (a renderer or an inspector refreshes on it)

  // The index of the object with this id, or objects.len()
  pub fn indexOf(self &, id u32) usize {
    var i = 0usize;
    while i < objects.len() {
      if objects[i].id == id {return i;}
      i = i + 1usize;
    }
    objects.len();
  }
}

fn applySceneCmd(core &mut SceneCore, c &SceneCmd, undoing bool) {
  let i = core.indexOf(c.object);
  if i >= core.objects.len() {return;}
  if c.kind == CK_TRANSFORM {
    core.objects[i].transform = if undoing {c.t0;} else {c.t1;};
  } elif c.kind == CK_PROP {
    let k = usize.from(c.prop);
    if k < core.objects[i].props.len() {
      core.objects[i].props[k] = if undoing {c.v0;} else {c.v1;};
    }
  }
  core.version = core.version + 1u32;
}

pub struct EditScene {
  pub core SceneCore;
  pub hist History[SceneCmd];

  pub fn make() EditScene {
    new EditScene(new SceneCore(List[PickMesh].empty(), List[EditObject].empty()), History[SceneCmd].make());
  }

  // Adds a mesh to the table; answers its index
  pub fn addMesh(self &mut, m PickMesh) usize {
    core.meshes.push(m);
    core.meshes.len() - 1usize;
  }

  // Adds an object; answers its id
  pub fn addObject(self &mut, name &str, mesh usize, t Transform3, props List[Vec4]) u32 {
    let id = core.nextId;
    core.nextId = id + 1u32;
    core.objects.push(new EditObject(id, String.from(name), mesh, t, props));
    core.version = core.version + 1u32;
    id;
  }

  pub fn find(self &, id u32) usize {core.indexOf(id);}
  pub fn has(self &, id u32) bool {core.indexOf(id) < core.objects.len();}

  pub fn objectCount(self &) usize {core.objects.len();}
  pub fn object(self &, id u32) &EditObject {core.objects[core.indexOf(id)];}
  pub fn transformOf(self &, id u32) Transform3 {core.objects[core.indexOf(id)].transform;}
  pub fn propOf(self &, id u32, k usize) Vec4 {*core.objects[core.indexOf(id)].props[k];}

  // ---- selection (not an undo step) ----
  pub fn select(self &mut, id u32) {
    core.selected = id;
    core.version = core.version + 1u32;
  }
  pub fn selected(self &) u32 {core.selected;}

  // ---- picking ----

  // The id of the nearest object under the ray, or 0, with the distance along the ray in 'dist'
  pub fn pick(self &, ray Ray3, dist &mut f32) u32 {
    var best = 0u32;
    var bestT = 1000000000.;
    var i = 0usize;
    while i < core.objects.len() {
      let o = core.objects[i];
      if o.visible {
        // the ray in the object's own space; its direction keeps its length, so t is the same in both
        let inv = o.transform.inverse();
        let lr = new Ray3(inv.transformPoint(ray.origin), inv.transformVector(ray.direction));
        let t = core.meshes[o.mesh].raycast(lr);
        if t >= 0. and t < bestT {
          bestT = t;
          best = o.id;
        }
      }
      i = i + 1usize;
    }
    *dist = if best == 0u32 {-1.;} else {bestT;};
    best;
  }

  // ---- live edits (not recorded) and recorded ones ----
  pub fn setTransform(self &mut, id u32, t Transform3) {
    let i = core.indexOf(id);
    if i < core.objects.len() {
      core.objects[i].transform = t;
      core.version = core.version + 1u32;
    }
  }

  pub fn setProp(self &mut, id u32, k usize, v Vec4) {
    let i = core.indexOf(id);
    if i < core.objects.len() and k < core.objects[i].props.len() {
      core.objects[i].props[k] = v;
      core.version = core.version + 1u32;
    }
  }

  // Records a transform edit that has ALREADY been applied (before and after). Nothing is recorded when
  // they are the same
  pub fn commitTransform(self &mut, id u32, before Transform3, after Transform3) {
    if sameTransform(before, after) {return;}
    hist.push(new SceneCmd(CK_TRANSFORM, id, 0u32, before, after, new Vec4(0., 0., 0., 0.), new Vec4(0., 0., 0., 0.)), CK_TRANSFORM);
  }

  pub fn commitProp(self &mut, id u32, k usize, before Vec4, after Vec4) {
    if before.equals(after) {return;}
    hist.push(new SceneCmd(CK_PROP, id, u32.from(k), Transform3.identity(), Transform3.identity(), before, after), CK_PROP);
  }

  pub fn canUndo(self &) bool {hist.canUndo();}
  pub fn canRedo(self &) bool {hist.canRedo();}
  pub fn undo(self &mut) bool {hist.undo(&mut core, &applySceneCmd);}
  pub fn redo(self &mut) bool {hist.redo(&mut core, &applySceneCmd);}
}

fn sameTransform(a Transform3, b Transform3) bool {
  a.translation.equals(b.translation) and a.scale.equals(b.scale)
    and absf(a.rotation.dot(b.rotation)) > 0.999999;
}

// ---- the outline of the selection ----

// The world-space points (pairs) of an object's silhouette seen from 'eye'
pub fn outlineOf(scene &EditScene, id u32, eye Vec3, out &mut List[Vec3]) {
  let i = scene.core.indexOf(id);
  if i >= scene.core.objects.len() {return;}
  let o = scene.core.objects[i];
  let t = o.transform;
  let inv = t.inverse();
  var pts = List[Vec3].empty();
  scene.core.meshes[o.mesh].silhouette(inv.transformPoint(eye), &mut pts);
  var k = 0usize;
  while k < pts.len() {
    out.push(t.transformPoint(*pts[k]));
    k = k + 1usize;
  }
}

// Draws pairs of world points as lines
pub fn drawSegments(view &GizmoView, pts &List[Vec3], color u32, thick f32, out &mut DrawList) {
  var k = 0usize;
  while k + 1usize < pts.len() {
    view.line(*pts[k], *pts[k + 1usize], color, thick, out);
    k = k + 2usize;
  }
}
