// ======== Gizmo: handles to move, rotate and scale what is selected ========
//
// A gizmo holds ONE transform (the selected object's) and offers three tools:
//   GM_MOVE    arrows along each axis, squares between each pair of axes (move in that plane), and a centre
//              block (move in the plane facing the camera);
//   GM_ROTATE  a ring about each axis;
//   GM_SCALE   a line with a block on its end for each axis, and a centre block for scaling all three.
// in world space (SP_WORLD: the handles are the world's axes) or local space (SP_LOCAL: the object's own).
// Scale always follows the object's own axes, as every editor does, because a scale of a turned object
// along a world axis is a shear that a position, a rotation and a scale cannot hold.
//
// PICKING BY RAY. The handles are solid shapes in the world, tested by the pointer's ray: an arrow is a
// capsule (the ray's distance to a segment, Ericson's closest points of two segments, against a radius), a
// plane square is the ray's hit on the plane tested against the square, a ring is the ray's hit on the
// ring's plane tested against |distance - radius|, and the centre is a ball. The hit nearest the camera
// wins. Handles are kept at a constant size on the screen (a fraction of the picture's height), so
// their world size is the camera's distance times the field of view.
//
// DRAG MATHS (the standard ones):
//   move on an axis    the closest point on the axis line to the pointer's ray (two lines' closest points),
//                      measured from where the drag began;
//   move in a plane    the ray's hit on the plane, minus its hit at the start;
//   rotate             the angle between the start vector and the current vector about the ring's axis, both
//                      taken from the ring's plane hit, atan2(axis . (v0 x v), v0 . v);
//   scale on an axis   the closest-point parameter now over the one at the start;
//   scale all          the distance of the camera-plane hit from the pivot, now over at the start.
//
// SNAPPING. Move: in world space the new position is rounded to the grid (absolute), in local space the
// movement is rounded to the step (incremental). Rotate: the angle is rounded to the step. Scale: the factor
// is rounded to the step and never below 0.01.
//
// The gizmo does not change an object: 'update' answers the transform the drag has reached, and the host
// applies it and, at 'end', records the whole drag as one undoable command.

pub const GM_MOVE = 0u32;
pub const GM_ROTATE = 1u32;
pub const GM_SCALE = 2u32;

pub const SP_WORLD = 0u32;
pub const SP_LOCAL = 1u32;

pub const H_NONE = 0u32;
pub const H_X = 1u32;
pub const H_Y = 2u32;
pub const H_Z = 3u32;
pub const H_XY = 4u32;             // the square in the X-Y plane
pub const H_YZ = 5u32;
pub const H_XZ = 6u32;
pub const H_ALL = 7u32;            // the centre

pub struct Snap {
  pub enabled bool = false;
  pub moveStep f32 = 0.5;
  pub angleStep f32 = 0.2617994;    // 15 degrees
  pub scaleStep f32 = 0.1;
  pub absolute bool = true;         // world-space moves round the position itself, not the movement
}

// How close the ray passes to a segment (distance), and how far along the ray that is (s)
struct SegHit {
  dist f32;
  s f32;
}

// The ray's hit on a plane
struct PlaneHit {
  ok bool;
  p Vec3;
  t f32;
}

// Closest points of the ray (treated as a half line) and the segment a-b (Ericson, Real-Time Collision
// Detection, 5.1.9)
fn rayToSegment(ray Ray3, a Vec3, b Vec3) SegHit {
  imm d1 = ray.direction;
  imm d2 = b - a;
  imm r = ray.origin - a;
  imm e = d2.dot(d2);
  imm f = d2.dot(r);
  imm c = d1.dot(r);
  imm bb = d1.dot(d2);
  imm denom = e - bb * bb;
  mut s = 0.;
  if denom > 0.000001 {s = maxf2((bb * f - c * e) / denom, 0.);}
  mut t = (bb * s + f) / maxf2(e, 0.0000001);
  if t < 0. {
    t = 0.;
    s = maxf2(-c, 0.);
  } elif t > 1. {
    t = 1.;
    s = maxf2(bb - c, 0.);
  }
  imm p1 = ray.origin + d1 * s;
  imm p2 = a + d2 * t;
  new SegHit((p1 - p2).length(), s);
}

fn planeHit(ray Ray3, p Vec3, n Vec3) PlaneHit {
  match ray.intersectPlane(Plane.fromPointNormal(p, n)) {
    case imm t Some { new PlaneHit(true, ray.at(t), t); }
    case is None { new PlaneHit(false, p, 0.); }
  }
}

// Where along the line (p, direction a) the ray passes closest; false when they are nearly parallel
fn lineParam(ray Ray3, p Vec3, a Vec3, ok &mut bool) f32 {
  imm d = ray.direction;
  imm w0 = ray.origin - p;
  imm b = d.dot(a);
  imm dd = d.dot(w0);
  imm e = a.dot(w0);
  imm denom = 1. - b * b;
  if denom < 0.0004 {
    *ok = false;
    return 0.;
  }
  *ok = true;
  (e - b * dd) / denom;
}

fn comp(v Vec3, i u32) f32 {
  if i == 0u32 {v.x;} elif i == 1u32 {v.y;} else {v.z;};
}

fn withComp(v Vec3, i u32, x f32) Vec3 {
  if i == 0u32 {new Vec3(x, v.y, v.z);} elif i == 1u32 {new Vec3(v.x, x, v.z);} else {new Vec3(v.x, v.y, x);};
}

pub struct Gizmo {
  pub target Transform3;                    // the transform held (the selected object's)
  pub readout String;                       // what the drag has reached, in words ("Move +1.50")
  start Transform3;                         // where the drag began
  pub mode u32 = GM_MOVE;
  pub space u32 = SP_WORLD;
  pub snap Snap = new Snap;
  pub sizeFrac f32 = 0.17;          // the handles' length as a fraction of the picture's height
  pub hover u32 = 0u32;
  pub active u32 = 0u32;
  pub dragging bool = false;
  // the drag
  pivot Vec3 = new Vec3(0., 0., 0.);
  axis Vec3 = new Vec3(1., 0., 0.);
  planeN Vec3 = new Vec3(0., 0., 1.);
  hit0 Vec3 = new Vec3(0., 0., 0.);
  v0 Vec3 = new Vec3(1., 0., 0.);
  t0 f32 = 1.;
  r0 f32 = 1.;
  unit f32 = 1.;
  angle f32 = 0.;
  factor f32 = 1.;

  pub fn make() Gizmo {new Gizmo(Transform3.identity(), String.empty(), Transform3.identity());}

  pub fn setTarget(self &mut, t Transform3) {
    if !dragging {target = t;}
  }

  pub fn setMode(self &mut, m u32) {
    if !dragging {mode = m;}
  }

  pub fn setSpace(self &mut, s u32) {
    if !dragging {space = s;}
  }

  // The direction of axis i (0, 1, 2) for the tool in use
  pub fn axisOf(self &, i u32) Vec3 {
    imm base = if i == 0u32 {new Vec3(1., 0., 0.);} elif i == 1u32 {new Vec3(0., 1., 0.);} else {new Vec3(0., 0., 1.);};
    if space == SP_LOCAL or mode == GM_SCALE {target.rotation * base;} else {base;};
  }

  // Which axis handle is this (0, 1, 2), or 3 for none
  fn axisIndex(h u32) u32 {
    if h == H_X {0u32;} elif h == H_Y {1u32;} elif h == H_Z {2u32;} else {3u32;};
  }

  // The two axes (and the one normal to them) a plane handle is made of
  fn planeAxes(h u32, first &mut u32, second &mut u32, normal &mut u32) {
    if h == H_XY {*first = 0u32; *second = 1u32; *normal = 2u32;}
    elif h == H_YZ {*first = 1u32; *second = 2u32; *normal = 0u32;}
    else {*first = 0u32; *second = 2u32; *normal = 1u32;}
  }

  // The handle under the ray, or H_NONE
  pub fn pick(self &, view &GizmoView, ray Ray3) u32 {
    imm s = view.unitAt(target.translation, sizeFrac);
    imm pv = target.translation;
    mut best = H_NONE;
    mut bestS = 1000000000.;
    if mode == GM_ROTATE {
      mut i = 0u32;
      while i < 3u32 {
        imm a = axisOf(i);
        imm h = planeHit(ray, pv, a);
        if h.ok {
          imm rel = h.p - pv;
          imm d = rel.length();
          // (the near half of the ring, with a margin so a ring seen face-on is all there)
          if absf(d - s) < 0.09 * s and rel.dot(view.eye - pv) > -0.15 * s * (view.eye - pv).length() and h.t < bestS {
            bestS = h.t;
            best = H_X + i;
          }
        }
        i = i + 1u32;
      }
      return best;
    }
    // the centre block
    match ray.intersectSphere(new Sphere(pv, 0.12 * s)) {
      case imm t Some { return H_ALL; }
      case is None {}
    }
    mut i = 0u32;
    while i < 3u32 {
      imm a = axisOf(i);
      imm sh = rayToSegment(ray, pv + a * (0.14 * s), pv + a * s);
      if sh.dist < 0.07 * s and sh.s < bestS {
        bestS = sh.s;
        best = H_X + i;
      }
      i = i + 1u32;
    }
    if mode == GM_MOVE {
      mut k = 0u32;
      while k < 3u32 {
        imm h = H_XY + k;
        mut fi = 0u32;
        mut si = 0u32;
        mut ni = 0u32;
        planeAxes(h, &mut fi, &mut si, &mut ni);
        imm ph = planeHit(ray, pv, axisOf(ni));
        if ph.ok {
          imm rel = ph.p - pv;
          imm u = rel.dot(axisOf(fi));
          imm v = rel.dot(axisOf(si));
          if u > 0.28 * s and u < 0.6 * s and v > 0.28 * s and v < 0.6 * s and ph.t < bestS {
            bestS = ph.t;
            best = h;
          }
        }
        k = k + 1u32;
      }
    }
    best;
  }

  // Updates which handle the pointer is over (not while dragging)
  pub fn hoverAt(self &mut, view &GizmoView, ray Ray3) {
    if !dragging {hover = pick(view, ray);}
  }

  // Starts a drag on the handle under the ray. False when there is none
  pub fn begin(self &mut, view &GizmoView, ray Ray3) bool {
    imm h = pick(view, ray);
    if h == H_NONE {return false;}
    start = target;
    pivot = target.translation;
    unit = view.unitAt(pivot, sizeFrac);
    active = h;
    angle = 0.;
    factor = 1.;
    readout = String.empty();
    imm ai = axisIndex(h);
    mut ok = true;
    if mode == GM_ROTATE {
      axis = axisOf(ai);
      imm ph = planeHit(ray, pivot, axis);
      if !ph.ok or (ph.p - pivot).length() < 0.0001 * unit {return false;}
      hit0 = ph.p;
      v0 = (ph.p - pivot).normalize();
    } elif ai < 3u32 {
      axis = axisOf(ai);
      t0 = lineParam(ray, pivot, axis, &mut ok);
      if !ok {return false;}
      if mode == GM_SCALE and absf(t0) < 0.05 * unit {t0 = if t0 < 0. {-0.05 * unit;} else {0.05 * unit;};}
    } elif h == H_ALL {
      planeN = (view.eye - pivot).normalize();
      imm ph = planeHit(ray, pivot, planeN);
      if !ph.ok {return false;}
      hit0 = ph.p;
      r0 = maxf2((ph.p - pivot).length(), 0.02 * unit);
    } else {
      mut fi = 0u32;
      mut si = 0u32;
      mut ni = 0u32;
      planeAxes(h, &mut fi, &mut si, &mut ni);
      planeN = axisOf(ni);
      imm ph = planeHit(ray, pivot, planeN);
      if !ph.ok {return false;}
      hit0 = ph.p;
    }
    dragging = true;
    true;
  }

  fn roundMove(self &, startPos Vec3, d Vec3, mask u32) Vec3 {
    // 'mask' is a bit per world axis the move may touch
    mut p = startPos + d;
    if !snap.enabled or snap.moveStep <= 0. {return p;}
    if snap.absolute and space == SP_WORLD {
      if (mask & 1u32) != 0u32 {p = withComp(p, 0u32, roundTo(p.x, snap.moveStep));}
      if (mask & 2u32) != 0u32 {p = withComp(p, 1u32, roundTo(p.y, snap.moveStep));}
      if (mask & 4u32) != 0u32 {p = withComp(p, 2u32, roundTo(p.z, snap.moveStep));}
      return p;
    }
    // incremental: round the movement along each of the tool's axes
    mut q = startPos;
    mut i = 0u32;
    while i < 3u32 {
      imm a = axisOf(i);
      q = q + a * roundTo(d.dot(a), snap.moveStep);
      i = i + 1u32;
    }
    q;
  }

  // The transform the drag has reached with the pointer along 'ray'. Without a drag, the held one
  pub fn update(self &mut, view &GizmoView, ray Ray3) Transform3 {
    if !dragging {return target;}
    imm ai = axisIndex(active);
    mut t = start;
    mut ok = true;
    if mode == GM_MOVE {
      if ai < 3u32 {
        imm tt = lineParam(ray, pivot, axis, &mut ok);
        if !ok {return target;}
        imm d = axis * (tt - t0);
        t.translation = roundMove(start.translation, d, 1u32 << ai);
        readout = String.from("Move ");
        readout.append(signedString(d.dot(axis), 2u32).view());
      } else {
        imm ph = planeHit(ray, pivot, planeN);
        if !ph.ok {return target;}
        imm d = ph.p - hit0;
        mut mask = 7u32;
        if active != H_ALL {
          mut fi = 0u32;
          mut si = 0u32;
          mut ni = 0u32;
          planeAxes(active, &mut fi, &mut si, &mut ni);
          mask = (1u32 << fi) | (1u32 << si);
        }
        t.translation = roundMove(start.translation, d, mask);
        imm moved = t.translation - start.translation;
        readout = String.from("Move ");
        readout.append(signedString(moved.x, 2u32).view());
        readout.append(" ");
        readout.append(signedString(moved.y, 2u32).view());
        readout.append(" ");
        readout.append(signedString(moved.z, 2u32).view());
      }
    } elif mode == GM_ROTATE {
      imm ph = planeHit(ray, pivot, axis);
      if !ph.ok {return target;}
      imm rel = ph.p - pivot;
      if rel.length() < 0.0001 * unit {return target;}
      imm v = rel.normalize();
      mut ang = atan2(axis.dot(v0.cross(v)), v0.dot(v));
      if snap.enabled and snap.angleStep > 0. {ang = roundTo(ang, snap.angleStep);}
      angle = ang;
      t.rotation = (Quat.angleAxis(ang, axis) * start.rotation).normalize();
      readout = String.from("Rotate ");
      readout.append(signedString(degrees(ang), 1u32).view());
      readout.append(" deg");
    } else {
      mut f = 1.;
      if ai < 3u32 {
        imm tt = lineParam(ray, pivot, axis, &mut ok);
        if !ok {return target;}
        f = tt / t0;
      } else {
        imm ph = planeHit(ray, pivot, planeN);
        if !ph.ok {return target;}
        f = (ph.p - pivot).length() / r0;
      }
      if snap.enabled and snap.scaleStep > 0. {f = roundTo(f, snap.scaleStep);}
      f = maxf2(f, 0.01);
      factor = f;
      if ai < 3u32 {t.scale = withComp(start.scale, ai, comp(start.scale, ai) * f);}
      else {t.scale = start.scale * f;}
      readout = String.from("Scale x");
      readout.append(fixedString(f, 2u32).view());
    }
    target = t;
    t;
  }

  // Ends the drag, answering the transform it reached
  pub fn end(self &mut) Transform3 {
    dragging = false;
    active = H_NONE;
    target;
  }

  // Abandons the drag, answering where the object began
  pub fn cancel(self &mut) Transform3 {
    dragging = false;
    active = H_NONE;
    target = start;
    start;
  }

  // ---- drawing ----

  fn colorOf(self &, h u32, base u32) u32 {
    if dragging {
      if h == active {return rgb(255u32, 214u32, 64u32);}
      return withAlpha(base, 70u32);
    }
    if h == hover {return rgb(255u32, 214u32, 64u32);}
    base;
  }

  fn baseColor(i u32) u32 {
    if i == 0u32 {rgb(232u32, 72u32, 56u32);}
    elif i == 1u32 {rgb(118u32, 200u32, 70u32);}
    else {rgb(64u32, 124u32, 235u32);};
  }

  // The handles as lines over the picture
  pub fn draw(self &, view &GizmoView, out &mut DrawList) {
    imm s = view.unitAt(target.translation, sizeFrac);
    imm pv = target.translation;
    if mode == GM_ROTATE {
      drawRings(view, s, pv, out);
      return;
    }
    mut i = 0u32;
    while i < 3u32 {
      imm a = axisOf(i);
      imm col = colorOf(H_X + i, baseColor(i));
      if mode == GM_MOVE {
        view.line(pv + a * (0.12 * s), pv + a * (0.78 * s), col, 2.5, out);
        view.line(pv + a * (0.78 * s), pv + a * s, col, 9., out);
      } else {
        imm len = if dragging and active == H_X + i {s * factor;} else {s * 0.9;};
        view.line(pv + a * (0.12 * s), pv + a * len, col, 2.5, out);
        imm e = view.project(pv + a * len);
        if e.z > 0.0001 {out.rect(e.x - 6., e.y - 6., 12., 12., col, 1., 0usize);}
      }
      i = i + 1u32;
    }
    if mode == GM_MOVE {
      mut k = 0u32;
      while k < 3u32 {
        imm h = H_XY + k;
        mut fi = 0u32;
        mut si = 0u32;
        mut ni = 0u32;
        planeAxes(h, &mut fi, &mut si, &mut ni);
        imm af = axisOf(fi);
        imm asx = axisOf(si);
        imm col = colorOf(h, baseColor(ni));
        imm lo = 0.3 * s;
        imm hi = 0.58 * s;
        view.line(pv + af * lo + asx * lo, pv + af * hi + asx * lo, col, 1.5, out);
        view.line(pv + af * hi + asx * lo, pv + af * hi + asx * hi, col, 1.5, out);
        view.line(pv + af * hi + asx * hi, pv + af * lo + asx * hi, col, 1.5, out);
        view.line(pv + af * lo + asx * hi, pv + af * lo + asx * lo, col, 1.5, out);
        // a hatching of the square, to read as a surface
        mut n = 1;
        while n < 6 {
          imm m = lo + (hi - lo) * f32.from(n) / 6.;
          view.line(pv + af * m + asx * lo, pv + af * m + asx * hi, withAlpha(col, 90u32), 3.5, out);
          n = n + 1;
        }
        k = k + 1u32;
      }
    }
    imm c = view.project(pv);
    if c.z > 0.0001 {
      imm col = if (dragging and active == H_ALL) or (!dragging and hover == H_ALL) {rgb(255u32, 214u32, 64u32);}
        else {rgba(235u32, 235u32, 235u32, 210u32);};
      out.rect(c.x - 6., c.y - 6., 12., 12., col, 2., 0usize);
    }
  }

  fn drawRings(self &, view &GizmoView, s f32, pv Vec3, out &mut DrawList) {
    mut i = 0u32;
    while i < 3u32 {
      imm a = axisOf(i);
      imm other = if absf(a.y) < 0.9 {new Vec3(0., 1., 0.);} else {new Vec3(1., 0., 0.);};
      imm u = a.cross(other).normalize();
      imm w = a.cross(u);
      imm h = H_X + i;
      imm col = colorOf(h, baseColor(i));
      imm toEye = view.eye - pv;
      imm n = 64;
      mut k = 0;
      while k < n {
        imm a0 = f32.from(k) / f32.from(n) * 2. * pi;
        imm a1 = f32.from(k + 1) / f32.from(n) * 2. * pi;
        imm p0 = pv + (u * cos(a0) + w * sin(a0)) * s;
        imm p1 = pv + (u * cos(a1) + w * sin(a1)) * s;
        imm front = (p0 - pv).dot(toEye) > 0.;
        if front {view.line(p0, p1, col, 2.5, out);}
        else {view.line(p0, p1, withAlpha(col, 60u32), 1.2, out);}
        k = k + 1;
      }
      if dragging and active == h {
        // the swept angle, as a wedge from the start vector
        imm steps = 24;
        mut m = 0;
        while m < steps {
          imm t0a = angle * f32.from(m) / f32.from(steps);
          imm t1a = angle * f32.from(m + 1) / f32.from(steps);
          imm q0 = Quat.angleAxis(t0a, a) * v0;
          imm q1 = Quat.angleAxis(t1a, a) * v0;
          view.line(pv + q0 * (s * 0.98), pv + q1 * (s * 0.98), rgb(255u32, 214u32, 64u32), 5., out);
          view.line(pv, pv + q1 * s, rgba(255u32, 214u32, 64u32, 50u32), 3., out);
          m = m + 1;
        }
        view.line(pv, pv + v0 * s, rgb(255u32, 214u32, 64u32), 2., out);
      }
      i = i + 1u32;
    }
  }
}

// "+1.25" or "-0.50"
fn signedString(v f32, decimals u32) String {
  mut s = String.empty();
  if v >= 0. {s.append("+");}
  s.append(fixedString(v, decimals).view());
  s;
}
