// The gizmo, worked by hand. The camera looks down -z from (0, 0, 10) at the origin, a 60 degree field, 800 x 600.
//
//   A handle is picked by the pointer's ray: the pixel an arrow's middle projects to picks that arrow.
//   Move on X: begin at a point of the X arrow, pull the pointer to where a point 1 unit further along X
//     projects, and the object has moved 1 along X. With a 0.5 grid and a pull of 1.3 it lands on 1.5.
//   Rotate about Z: begin on the ring at (s, 0, 0), pull to the ring at (0, s, 0): 90 degrees, so the
//     object's x axis now points along +y. With a 15 degree step a pull to 40 degrees lands on 45.
//   Scale on X: begin at 0.5 s along the arrow, pull to 1.0 s: the scale on x doubles.
//   Local space: an object turned 90 degrees about Z has its x axis along world +y.
//   Esc (cancel) puts the object back.

mod gizmotest;

import testing use *;
import collections use *;
import geomath use *;
import uilayout use DrawList;
import editgizmo use *;

fn viewFrom(eye Vec3) GizmoView {
  let fov = radians(60.);
  GizmoView.make(eye, Mat4.lookAt(eye, new Vec3(0., 0., 0.), new Vec3(0., 1., 0.)), Mat4.perspective(fov, 800. / 600., 0.1, 100.),
    fov, 800., 600.);
}

fn pixelRay(v &GizmoView, p Vec3) Ray3 {
  let s = v.project(p);
  v.rayAt(s.x, s.y);
}

fn near(a f32, b f32, eps f32) bool {
  (if a > b {a - b;} else {b - a;}) < eps;
}

fn nearV(a Vec3, b Vec3, eps f32) bool {
  near(a.x, b.x, eps) and near(a.y, b.y, eps) and near(a.z, b.z, eps);
}

fn main() i32 {
  let v = viewFrom(new Vec3(0., 0., 10.));
  // the camera's projection: the origin is the middle of the picture, +y is up the screen (y falls)
  let o = v.project(new Vec3(0., 0., 0.));
  expect(near(o.x, 400., 0.01) and near(o.y, 300., 0.01), "the origin is the middle of the picture");
  expect(v.project(new Vec3(0., 1., 0.)).y < 300., "a point above the origin is higher on the screen");
  expect(v.project(new Vec3(1., 0., 0.)).x > 400., "a point to the right is further right");
  // pixel -> ray -> the point back
  let r = v.rayAt(400., 300.);
  expect(nearV(r.direction, new Vec3(0., 0., -1.), 0.0001), "the middle pixel looks down -z");
  let pr = pixelRay(&v, new Vec3(2., 1., 0.));
  let hit = pr.at(((new Vec3(2., 1., 0.) - pr.origin).dot(pr.direction)));
  expect(nearV(hit, new Vec3(2., 1., 0.), 0.001), "a pixel's ray passes through the point that made it");

  // the size on screen: 'frac' of the height at the pivot's distance
  let s = v.unitAt(new Vec3(0., 0., 0.), 0.17);
  expect(near(s, 10. * 2. * tan(radians(30.)) * 0.17, 0.0001), "handle length at distance 10");

  // ---- move ----
  var g = Gizmo.make();
  g.setTarget(Transform3.identity());
  let onX = new Vec3(0.5 * s, 0., 0.);
  expectInt(i64.from(g.pick(&v, pixelRay(&v, onX))), i64.from(H_X), "the X arrow is picked");
  expectInt(i64.from(g.pick(&v, pixelRay(&v, new Vec3(0., 0.5 * s, 0.)))), i64.from(H_Y), "the Y arrow is picked");
  expectInt(i64.from(g.pick(&v, pixelRay(&v, new Vec3(0.4 * s, 0.4 * s, 0.)))), i64.from(H_XY), "the X-Y square is picked");
  expectInt(i64.from(g.pick(&v, pixelRay(&v, new Vec3(0., 0., 0.)))), i64.from(H_ALL), "the centre is picked");
  expectInt(i64.from(g.pick(&v, pixelRay(&v, new Vec3(3. * s, 3. * s, 0.)))), i64.from(H_NONE), "empty space picks nothing");
  expect(g.begin(&v, pixelRay(&v, onX)), "a drag on X begins");
  expect(g.dragging, "dragging");
  let moved = g.update(&v, pixelRay(&v, onX + new Vec3(1., 0., 0.)));
  expect(nearV(moved.translation, new Vec3(1., 0., 0.), 0.01), "pulled 1 along X");
  expectStr(g.readout.view(), "Move +1.00", "the readout says so");
  // moving the pointer off the axis in y does not move it in y
  let moved2 = g.update(&v, pixelRay(&v, onX + new Vec3(1., 2., 0.)));
  expect(near(moved2.translation.y, 0., 0.01), "an X drag keeps y");
  g.end();
  expect(!g.dragging, "ended");

  // snapping to a 0.5 grid
  var g2 = Gizmo.make();
  g2.snap.enabled = true;
  g2.setTarget(Transform3.identity());
  g2.begin(&v, pixelRay(&v, onX));
  let snapped = g2.update(&v, pixelRay(&v, onX + new Vec3(1.3, 0., 0.)));
  expect(near(snapped.translation.x, 1.5, 0.0001), "1.3 on a 0.5 grid lands on 1.5");
  let back = g2.cancel();
  expect(nearV(back.translation, new Vec3(0., 0., 0.), 0.0001), "cancel puts it back");

  // an absolute grid in world space: an object at 0.2 dragged by 1.0 lands on 1.0 (1.2 rounds to 1.0)
  var g3 = Gizmo.make();
  g3.snap.enabled = true;
  var t3 = Transform3.identity();
  t3.translation = new Vec3(0.2, 0., 0.);
  g3.setTarget(t3);
  let s3 = v.unitAt(t3.translation, 0.17);
  let p3 = t3.translation + new Vec3(0.5 * s3, 0., 0.);
  expect(g3.begin(&v, pixelRay(&v, p3)), "begin at 0.2");
  let r3 = g3.update(&v, pixelRay(&v, p3 + new Vec3(1., 0., 0.)));
  expect(near(r3.translation.x, 1.0, 0.0001), "world grid is absolute: 1.2 rounds to 1.0");
  g3.setSpace(SP_LOCAL);
  expectInt(i64.from(g3.space), i64.from(SP_WORLD), "space cannot change in a drag");

  // a plane drag: the X-Y square moves in both
  var g4 = Gizmo.make();
  g4.setTarget(Transform3.identity());
  let sq = new Vec3(0.4 * s, 0.4 * s, 0.);
  expect(g4.begin(&v, pixelRay(&v, sq)), "begin on the square");
  let r4 = g4.update(&v, pixelRay(&v, sq + new Vec3(1., 0.5, 0.)));
  expect(nearV(r4.translation, new Vec3(1., 0.5, 0.), 0.01), "pulled in the plane");

  // ---- rotate ----
  var gr = Gizmo.make();
  gr.setMode(GM_ROTATE);
  gr.setTarget(Transform3.identity());
  let ringX = new Vec3(s, 0., 0.);
  expectInt(i64.from(gr.pick(&v, pixelRay(&v, ringX))), i64.from(H_Z), "the ring about Z seen face-on is picked");
  expect(gr.begin(&v, pixelRay(&v, ringX)), "a rotation begins");
  let rot = gr.update(&v, pixelRay(&v, new Vec3(0., s, 0.)));
  let xAxis = rot.rotation * new Vec3(1., 0., 0.);
  expect(nearV(xAxis, new Vec3(0., 1., 0.), 0.01), "a quarter turn takes x to y");
  expectStr(gr.readout.view(), "Rotate +90.0 deg", "the readout");
  gr.end();

  var gs = Gizmo.make();
  gs.setMode(GM_ROTATE);
  gs.snap.enabled = true;
  gs.setTarget(Transform3.identity());
  gs.begin(&v, pixelRay(&v, ringX));
  let fortyDeg = new Vec3(s * cos(radians(40.)), s * sin(radians(40.)), 0.);
  let rs = gs.update(&v, pixelRay(&v, fortyDeg));
  let q45 = rs.rotation * new Vec3(1., 0., 0.);
  expect(nearV(q45, new Vec3(cos(radians(45.)), sin(radians(45.)), 0.), 0.01), "40 degrees snaps to 45");

  // ---- scale ----
  var gz = Gizmo.make();
  gz.setMode(GM_SCALE);
  gz.setTarget(Transform3.identity());
  expect(gz.begin(&v, pixelRay(&v, new Vec3(0.5 * s, 0., 0.))), "a scale drag begins");
  let sc = gz.update(&v, pixelRay(&v, new Vec3(1.0 * s, 0., 0.)));
  expect(nearV(sc.scale, new Vec3(2., 1., 1.), 0.01), "twice as long on x only");
  gz.end();
  var gu = Gizmo.make();
  gu.setMode(GM_SCALE);
  gu.setTarget(Transform3.identity());
  expect(gu.begin(&v, pixelRay(&v, new Vec3(0.05 * s, 0., 0.))), "uniform scale from the centre block");
  let su = gu.update(&v, pixelRay(&v, new Vec3(0.1 * s, 0., 0.)));
  expect(nearV(su.scale, new Vec3(2., 2., 2.), 0.05), "twice as far from the centre: twice the size on all three");

  // ---- local space ----
  var gl = Gizmo.make();
  gl.setSpace(SP_LOCAL);
  var tl = Transform3.identity();
  tl.rotation = Quat.angleAxis(radians(90.), new Vec3(0., 0., 1.));
  gl.setTarget(tl);
  expect(nearV(gl.axisOf(0u32), new Vec3(0., 1., 0.), 0.0001), "the local x axis of a turned object is world y");
  gl.setSpace(SP_WORLD);
  expect(nearV(gl.axisOf(0u32), new Vec3(1., 0., 0.), 0.0001), "the world x axis stays");

  // ---- drawing ----
  var list = DrawList.make();
  var gd = Gizmo.make();
  gd.setTarget(Transform3.identity());
  gd.draw(&v, &mut list);
  expect(list.count(5u32) > 10usize, "the move gizmo is lines");
  gd.setMode(GM_ROTATE);
  let before = list.len();
  gd.draw(&v, &mut list);
  expect(list.len() - before > 150usize, "three rings of 64 segments");

  // ---- the fixed-point readout ----
  expectStr(fixedString(1.5, 2u32).view(), "1.50", "1.5 to two places");
  expectStr(fixedString(-0.05, 1u32).view(), "-0.1", "-0.05 to one place rounds away from zero");
  expectStr(fixedString(12.0, 0u32).view(), "12", "no places");
  done();
}
