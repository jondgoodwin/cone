// Editing 3-D in place, headless on a real GPU: a scene of sculpted objects, one selected by a ray, moved,
// turned and scaled by its gizmo, recoloured through an inspector made from a description of its fields, and
// every step undone.
//
//   congo run --release examples/sceneedit.cone -- <out folder>
//   GPU_POWER_PREFERENCE=low-power congo run ...      the same on the integrated GPU
//   ... -- <out folder> --bench                       frame costs
//
// Everything the "user" does goes through the Ui's pointer and key functions (pointerMove, pointerDown, keyDown,
// textInput) and the program's own routing of a press that hits no widget to the viewport: the SDL window never
// exists, so no real keystroke or mouse input is involved.
//
// THE PICTURE: render draws the scene, tone-mapped, into an RGBA8 target; then this program's own small
// renderer (as the textedit demo's: uilayout makes a DrawList and leaves drawing to the host) lays the editor over
// it: the selection's outline and the gizmo (editgizmo, as lines), then the toolbar and inspector (uilayout and
// uipickers). A frame is: layout; the inspector pumped and its Changes applied; the gizmo and materials brought
// up to date; the overlay made; the scene drawn; the overlay drawn.

mod sceneeditdemo;

import libc;
import fs;
import stdio use *;
import process;
import sdl;
import collections use *;
import geomath use *;
import mesh use Mesh;
import sculpt as sc;
import gpu use *;
import msdftext use *;
import imagedecode use *;
import uilayout use * but ALIGN_CENTER;
import render as rd;
import path as filepath;
import editgizmo use * but fixedString;
import uipickers use *;

const W = 1280u32;
const H = 720u32;
const PRIM_FLOATS = 20usize;
const PRIM_BYTES = 80u64;

// ---- the renderer ----

struct Rig {
  font: Font;
  atlas: Atlas;
  shader: ShaderModule;
  groupLayout: BindGroupLayout;
  layout: PipelineLayout;
  pipeline: RenderPipeline;
  uniforms: Buffer;
  group: BindGroup;
  instances: Buffer;
  capacity: u32;
  text: TextRenderer;
  slots: List[TextHandle];
  target: Texture;
  readback: Buffer;
  prims: u32 = 0u32;
  glyphs: u32 = 0u32;
  prepNs: i64 = 0i64;

  fn make(device: &mut Device, font: Font) Rig {
    var atlas = Atlas.create(AtlasConfig.standard());
    // the printable ASCII now, not in the middle of a frame (3 ms a glyph)
    var cp = 32u32;
    while cp < 127u32 {
      atlas.ensure(&font, font.glyphOf(cp));
      cp = cp + 1u32;
    }
    var shader = device.createShaderModule(&EDITORLIST_SPIRV);
    let entries = [BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT)];
    var groupLayout = device.createBindGroupLayout(&entries);
    let groupLayouts = [&groupLayout];
    var layout = device.createPipelineLayout(&groupLayouts, 0u32);
    let attributes = [VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 0u64, 0u32),
      VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 16u64, 1u32),
      VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 32u64, 2u32),
      VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 48u64, 3u32),
      VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 64u64, 4u32)];
    let buffers = [VertexBufferLayout(arrayStride: PRIM_BYTES, stepMode: VERTEX_STEP_MODE_INSTANCE, attributes: &attributes)];
    let desc = RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, vertexEntryPoint: "vertexMain",
      buffers: &buffers, fragmentModule: &shader, fragmentEntryPoint: "fragmentMain", colorFormat: TEXTURE_FORMAT_RGBA8_UNORM,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var pipeline = device.createRenderPipeline(&desc);
    var uniforms = device.createBuffer(16u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    let bindings = [BindGroupEntry.buffer(0u32, &uniforms)];
    var group = device.createBindGroup(&groupLayout, &bindings);
    var instances = device.createBuffer(PRIM_BYTES * 256u64, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
    var text = TextRenderer.create(device, &atlas, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
    let targetDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
    var target = device.createTexture(&targetDesc);
    var readback = device.createBuffer(u64.from(W * H * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    Rig(font: font, atlas: atlas, shader: shader, groupLayout: groupLayout, layout: layout, pipeline: pipeline, uniforms: uniforms,
      group: group, instances: instances, capacity: 256u32, text: text, slots: List[TextHandle].empty(), target: target, readback: readback)
  }

  // The list drawn into the target. 'copyOut' also copies the picture to the readback buffer. Nanoseconds
  // spent preparing (prep), recording and submitting (record) and waiting for the GPU (wait) go into 'times'
  fn paint(self: &mut, device: &mut Device, encoder: &mut CommandEncoder, dst: &Texture, list: &DrawList) {
    let t0 = sdl.GetTicksNS();
    var data = List[f32].withCapacity(list.cmds.len() * PRIM_FLOATS);
    var clips = List[f32].empty();
    var c0 = -1000000.f;
    var c1 = -1000000.f;
    var c2 = 1000000.f;
    var c3 = 1000000.f;
    var count = 0u32;
    var texts = List[usize].empty();                  // indices of DC_TEXT commands, with the clip each had
    var textClips = List[f32].empty();
    var i = 0usize;
    while i < list.cmds.len() {
      let d = list.cmds[i];
      let k = d.kind;
      if k == DC_CLIP_PUSH {
        clips.push(c0);
        clips.push(c1);
        clips.push(c2);
        clips.push(c3);
        c0 = maxf(c0, d.x);
        c1 = maxf(c1, d.y);
        c2 = minf(c2, d.x + d.w);
        c3 = minf(c3, d.y + d.h);
      }
      else if k == DC_CLIP_POP {
        if clips.len() >= 4usize {
          let top = clips.len() - 4usize;
          c0 = *clips[top];
          c1 = *clips[top + 1usize];
          c2 = *clips[top + 2usize];
          c3 = *clips[top + 3usize];
          clips.truncate(top);
        }
      }
      else if k == DC_RECT || k == DC_BORDER {
        data.push(d.x - 1.);
        data.push(d.y - 1.);
        data.push(d.x + d.w + 1.);
        data.push(d.y + d.h + 1.);
        data.push(d.x + d.w * 0.5);
        data.push(d.y + d.h * 0.5);
        data.push(d.w * 0.5);
        data.push(d.h * 0.5);
        pushColor(&mut data, d.color);
        data.push(if k == DC_RECT {0.} else {1.});
        data.push(d.radius);
        data.push(d.thick);
        data.push(0.);
        data.push(c0);
        data.push(c1);
        data.push(c2);
        data.push(c3);
        count = count + 1u32;
      }
      else if k == DC_LINE {
        data.push(minf(d.x, d.w) - d.thick - 1.);
        data.push(minf(d.y, d.h) - d.thick - 1.);
        data.push(maxf(d.x, d.w) + d.thick + 1.);
        data.push(maxf(d.y, d.h) + d.thick + 1.);
        data.push(d.x);
        data.push(d.y);
        data.push(d.w);
        data.push(d.h);
        pushColor(&mut data, d.color);
        data.push(2.);
        data.push(0.);
        data.push(d.thick);
        data.push(0.);
        data.push(c0);
        data.push(c1);
        data.push(c2);
        data.push(c3);
        count = count + 1u32;
      }
      else if k == DC_TEXT {
        texts.push(i);
        textClips.push(c0);
        textClips.push(c1);
        textClips.push(c2);
        textClips.push(c3);
      }
      i = i + 1usize;
    }
    prims = count;
    // The texts: laid out, each glyph placed in pixels, grouped by size and colour into one draw each
    var gSize = List[f32].empty();
    var gColor = List[u32].empty();
    var gQuads = List[List[GlyphQuad]].empty();
    var t = 0usize;
    while t < texts.len() {
      let d = list.cmds[*texts[t]];
      let s = list.textOf(*texts[t]);
      let lay = layoutText(&font, &mut atlas, s, &LayoutOptions.make(d.size));
      var px = d.x;
      if d.align == TA_CENTER {px = px + (d.w - lay.width) * 0.5;}
      else if d.align == TA_RIGHT {px = px + d.w - lay.width;}
      px = libc.floorf(px + 0.5);
      let py = libc.floorf(d.y + (d.h - lay.height) * 0.5 + 0.5);
      var g = 0usize;
      var found = false;
      while g < gSize.len() && !found {
        if *gSize[g] == d.size && *gColor[g] == d.color {found = true;} else {g = g + 1usize;}
      }
      if !found {
        gSize.push(d.size);
        gColor.push(d.color);
        gQuads.push(List[GlyphQuad].empty());
      }
      let cl0 = *textClips[t * 4usize];
      let cl1 = *textClips[t * 4usize + 1usize];
      let cl2 = *textClips[t * 4usize + 2usize];
      let cl3 = *textClips[t * 4usize + 3usize];
      var q = 0usize;
      while q < lay.quads.len() {
        let gq = lay.quads[q];
        let x0 = gq.x0 + px;
        let x1 = gq.x1 + px;
        let y0 = gq.y0 + py;
        let y1 = gq.y1 + py;
        if x0 >= cl0 - 2. && x1 <= cl2 + 2. && y0 >= cl1 - 2. && y1 <= cl3 + 2. {
          gQuads[g].push(GlyphQuad(x0, y0, x1, y1, gq.u0, gq.v0, gq.u1, gq.v1));
        }
        q = q + 1usize;
      }
      t = t + 1usize;
    }
    text.syncAtlas(device, &atlas);
    var g = 0usize;
    var nGlyphs = 0usize;
    while g < gSize.len() {
      while slots.len() <= g {slots.push(text.addText(device, SPACE_OVERLAY));}
      var quads = List[GlyphQuad].withCapacity(gQuads[g].len());
      var qi = 0usize;
      while qi < gQuads[g].len() {
        quads.push(*gQuads[g][qi]);
        qi = qi + 1usize;
      }
      let lay = TextLayout(List[PlacedGlyph].empty(), quads, List[LineInfo].empty(), 0., 0., 0., *gSize[g]);
      nGlyphs = nGlyphs + gQuads[g].len();
      let rgba = *gColor[g];
      let style = TextStyle.plain(Color(f32.from((rgba >> 24u32) & 255u32) / 255., f32.from((rgba >> 16u32) & 255u32) / 255.,
        f32.from((rgba >> 8u32) & 255u32) / 255., f32.from(rgba & 255u32) / 255.));
      text.set(device, *slots[g], &lay, &style, overlayTransform(f32.from(W), f32.from(H), 0., 0.));
      g = g + 1usize;
    }
    while g < slots.len() {
      text.clearText(*slots[g]);
      g = g + 1usize;
    }
    glyphs = u32.from(nGlyphs);
    // The shapes' data to the GPU
    var params = Array[f32, 4]() <- f32.from(W), f32.from(H), 0., 0.;
    device.queue.writeBuffer(&uniforms, 0u64, &params as *u8, 16u64);
    if count > capacity {
      device.queue.releaseBuffer(&mut instances);
      capacity = count * 2u32;
      instances = device.createBuffer(u64.from(capacity) * PRIM_BYTES, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
    }
    if count > 0u32 {
      let raw: *f32 = data.view() as *f32;
      device.queue.writeBuffer(&instances, 0u64, raw as *u8, u64.from(count) * PRIM_BYTES);
    }
    let t1 = sdl.GetTicksNS();
    let color = RenderPassColorAttachment(view: dst.createView(), loadOp: LOAD_OP_LOAD, clearValue: Color(0., 0., 0., 1.));
    var pass = encoder.beginRenderPass(&color);
    if count > 0u32 {
      pass.setPipeline(&pipeline);
      pass.setBindGroup(0u32, &group);
      pass.setVertexBuffer(0u32, &instances, 0u64);
      pass.draw(6u32, count, 0u32, 0u32);
    }
    pass.end();
    text.renderOverlay(encoder, dst);
    prepNs = i64.from(t1 - t0);
  }

  // The last picture as a PNG
  fn savePng(self: &, file: &filepath.Path) {
    let px = readback.mappedRange();
    var samples = List[u16].withCapacity(usize.from(W * H * 4u32));
    var i = 0usize;
    while i < usize.from(W * H * 4u32) {
      samples.push(u16.from(*(px + i)));
      i = i + 1usize;
    }
    let opts = PngWrite.make(6u8, 8u8);
    let bytes = encodePngSamples(i32.from(W), i32.from(H), samples.view(), &opts);
    fs.writeFile(file, bytes.view());
  }
}

fn pushColor(data: &mut List[f32], c: u32) {
  data.push(f32.from((c >> 24u32) & 255u32) / 255.);
  data.push(f32.from((c >> 16u32) & 255u32) / 255.);
  data.push(f32.from((c >> 8u32) & 255u32) / 255.);
  data.push(f32.from(c & 255u32) / 255.);
}

// ======== the scene ========

fn vaseMesh() Mesh {
  let pts = [Vec2(0., 0.), Vec2(0.40, 0.), Vec2(0.50, 0.12), Vec2(0.62, 0.50), Vec2(0.52, 0.92),
    Vec2(0.30, 1.10), Vec2(0.33, 1.34), Vec2(0.44, 1.52), Vec2(0.36, 1.52), Vec2(0., 1.44)];
  let profile = sc.Profile.fromPoints(&pts, false);
  let pm = sc.lathe(&profile, Vec3(0., 1., 0.), 2. * pi, 44u32);
  pm.triangulate(true)
}

fn columnMesh() Mesh {
  let profile = sc.Profile.polygon(5u32, 0.36);
  let path = sc.Path.line(Vec3(0., 0., 0.), Vec3(0., 1.8, 0.), 30u32);
  let pm = sc.sweep(&profile, &path, 1.6, 1., 0.65, true);
  pm.triangulate(true)
}

fn ringMesh() Mesh {
  let profile = sc.Profile.polygon(16u32, 0.13);
  let path = sc.Path.circle(0.5, 48u32);
  let pm = sc.sweep(&profile, &path, 0., 1., 1., false);
  pm.triangulate(true)
}

fn props(r: f32, g: f32, b: f32, rough: f32, metal: f32) List[Vec4] {
  var l = List[Vec4].empty();
  l.push(Vec4(r, g, b, 1.));
  l.push(Vec4(rough, metal, 0., 0.));
  l
}

fn placed(x: f32, y: f32, z: f32) Transform3 {
  var t = Transform3.identity();
  t.translation = Vec3(x, y, z);
  t
}

// The inspector's fields, by number
const F_NAME = 0usize;
const F_POS = 2usize;
const F_ROT = 3usize;
const F_SCALE = 4usize;
const F_COLOR = 6usize;
const F_ROUGH = 7usize;
const F_METAL = 8usize;
const F_FINISH = 9usize;

fn describeObject() TypeDesc {
  var d = TypeDesc.make("Object");
  d.textField("Name");
  d.header("Transform");
  d.vec3Field("Position", 0.01, "m");
  d.vec3Field("Rotation", 0.5, "deg");
  d.vec3Field("Scale", 0.01, "");
  d.header("Material");
  d.colorField("Colour");
  d.sliderField("Roughness", 0., 1., 2u32);
  d.sliderField("Metallic", 0., 1., 2u32);
  d.enumField("Finish", "Custom|Plastic|Brushed metal|Glossy paint");
  d
}

// ---- rotation as angles, for the inspector ----

// Turns about x, then y, then z (Quat.fromEulerXyz's order) as angles in radians
fn eulerOf(q: Quat) Vec3 {
  let m = Mat3.fromQuat(q);
  let r02 = m.cell(0usize, 2usize);
  let r00 = m.cell(0usize, 0usize);
  let r01 = m.cell(0usize, 1usize);
  let r12 = m.cell(1usize, 2usize);
  let r22 = m.cell(2usize, 2usize);
  let r11 = m.cell(1usize, 1usize);
  let r21 = m.cell(2usize, 1usize);
  let b = libc.asinf(if r02 > 1. {1.} else if r02 < -1. {-1.} else {r02});
  if r02 > -0.99999 && r02 < 0.99999 {
    Vec3(atan2(-r12, r22), b, atan2(-r01, r00))
  } else {
    Vec3(atan2(r21, r11), b, 0.)
  }
}

// A second kind of thing to inspect, with nothing written for it but this description and the function that
// takes a Change into the camera
fn describeCamera() TypeDesc {
  var d = TypeDesc.make("Camera");
  d.textField("Label");
  d.header("Lens");
  d.sliderField("Field of view", 20., 100., 1u32);
  d.floatField("Near plane", 0.01, 2u32);
  d.floatField("Far plane", 1., 1u32);
  d.enumField("Projection", "Perspective|Orthographic");
  d.header("View");
  d.vec2Field("Lens shift", 0.005);
  d.colorField("Background");
  d.boolField("Depth of field");
  d
}

fn cameraValues() List[Value] {
  var v = List[Value].empty();
  v.push(Value.text("Main camera"));
  v.push(Value(String.empty()));
  v.push(Value.number(45.));
  v.push(Value.number(0.1));
  v.push(Value.number(80.));
  v.push(Value.number(0.));
  v.push(Value(String.empty()));
  v.push(Value.vec3(0., 0., 0.));
  v.push(Value.color(0.02, 0.03, 0.06, 1.));
  v.push(Value.number(0.));
  v
}

// Only the field of view does anything to the picture: it is the camera's, and the gizmo's view is made again
fn applyCameraChange(app: &mut App, c: &Change) {
  app.camChanges = app.camChanges + 1usize;
  if c.field == 2usize {
    app.camera.fov = radians(c.after.x);
    app.view = GizmoView.make(app.camera.position(), app.camera.viewMatrix(), app.camera.projectionMatrix(f32.from(W) / f32.from(H)),
      app.camera.fov, f32.from(W), f32.from(H));
  }
}

fn valuesOf(o: &EditObject) List[Value] {
  var v = List[Value].empty();
  v.push(Value.text(o.name.view()));
  v.push(Value(String.empty()));
  v.push(Value.vec3(o.transform.translation.x, o.transform.translation.y, o.transform.translation.z));
  let e = eulerOf(o.transform.rotation);
  v.push(Value.vec3(degrees(e.x), degrees(e.y), degrees(e.z)));
  v.push(Value.vec3(o.transform.scale.x, o.transform.scale.y, o.transform.scale.z));
  v.push(Value(String.empty()));
  let c = *o.props[0usize];
  v.push(Value.color(c.x, c.y, c.z, c.w));
  let m = *o.props[1usize];
  v.push(Value.number(m.x));
  v.push(Value.number(m.y));
  v.push(Value.number(m.z));
  v
}

fn vec3Of(v: &Value) Vec3 {Vec3(v.x, v.y, v.z)}
fn quatOfDegrees(v: &Value) Quat {Quat.fromEulerXyz(Vec3(radians(v.x), radians(v.y), radians(v.z)))}

// ======== the program's state ========

struct Gfx {
  renderer: rd.Renderer;
  post: rd.Post;
  depth: Texture;
  out: Texture;
  ground: rd.MeshHandle;
  groundMat: rd.MaterialHandle;
}

struct App {
  scene: EditScene;
  meshHandles: List[rd.MeshHandle];
  mats: List[rd.MaterialHandle];
  keys: List[Vec4];                    // the properties each object's material was last made from (two each)
  ui: Ui;
  kit: PickerKit;
  insp: Inspector;
  gizmo: Gizmo;
  camera: rd.Camera;
  light: rd.Light;
  view: GizmoView;
  dragStart: Transform3;
  insp2: Inspector;
  panel2: usize = 0usize;
  btnCamera: usize = 0usize;
  showCamera: bool = false;
  camChanges: usize = 0usize;
  btnMove: usize = 0usize;
  btnRotate: usize = 0usize;
  btnScale: usize = 0usize;
  btnSpace: usize = 0usize;
  btnSnap: usize = 0usize;
  btnUndo: usize = 0usize;
  btnRedo: usize = 0usize;
  status: usize = 0usize;
  panelNode: usize = 0usize;
  synced: u32 = 0u32;
  mx: f32 = 0.;
  my: f32 = 0.;
  vpActive: bool = false;
  gizmoDrag: bool = false;
  dragId: u32 = 0u32;
  passed: usize = 0usize;
  failed: usize = 0usize;
}

fn linear(v: f32) f32 {v * v}          // display values to the material's linear ones (gamma 2, near enough)

fn makeMaterial(gfx: &mut Gfx, device: &mut Device, c: Vec4, p: Vec4) rd.MaterialHandle {
  gfx.renderer.addPbrMaterial(device, &rd.PbrMaterial.standard(Color(linear(c.x), linear(c.y), linear(c.z), 1.), p.y, p.x))
}

fn layoutNow(ui: &mut Ui, font: &Font, atlas: &mut Atlas) {
  var m = fn(t: &str, face: u32, size: f32) Vec2 {
    let lay = layoutText(font, atlas, t, &LayoutOptions.make(size));
    Vec2(lay.width, lay.height)
  };
  layout(ui, &mut m);
}

// ---- the viewport: presses that hit no widget ----

fn viewDown(app: &mut App, x: f32, y: f32) {
  let ray = app.view.rayAt(x, y);
  let id = app.scene.selected();
  if id != 0u32 && app.gizmo.begin(&app.view, ray) {
    app.gizmoDrag = true;
    app.dragId = id;
    app.dragStart = app.scene.transformOf(id);
    return;
  }
  var dist = 0.f;
  let picked = app.scene.pick(ray, &mut dist);
  app.scene.select(picked);
}

fn viewMove(app: &mut App, x: f32, y: f32) {
  let ray = app.view.rayAt(x, y);
  if app.gizmoDrag {
    let t = app.gizmo.update(&app.view, ray);
    app.scene.setTransform(app.dragId, t);
  } else {
    app.gizmo.hoverAt(&app.view, ray);
  }
}

fn viewUp(app: &mut App) {
  if app.gizmoDrag {
    let t = app.gizmo.end();
    app.scene.commitTransform(app.dragId, app.dragStart, t);
    app.gizmoDrag = false;
  }
}

// The pointer, through the Ui; a press no widget took goes to the viewport
fn mMove(app: &mut App, x: f32, y: f32) {
  app.mx = x;
  app.my = y;
  pointerMove(&mut app.ui, x, y);
  if app.vpActive {viewMove(app, x, y);}
  else if hitTest(&app.ui, x, y) == NIL {viewMove(app, x, y);}
}

fn mDown(app: &mut App, mods: u32) {
  app.ui.input.mods = mods;
  if !pointerDown(&mut app.ui, BTN_LEFT) {
    app.vpActive = true;
    viewDown(app, app.mx, app.my);
  }
}

fn mUp(app: &mut App) {
  pointerUp(&mut app.ui, BTN_LEFT);
  app.ui.input.mods = 0u32;
  if app.vpActive {
    viewUp(app);
    app.vpActive = false;
  }
}

fn centreOf(ui: &Ui, node: usize) Vec2 {
  Vec2(ui.nodes[node].gx + ui.nodes[node].w * 0.5, ui.nodes[node].gy + ui.nodes[node].h * 0.5)
}

fn clickAt(app: &mut App, x: f32, y: f32) {
  mMove(app, x, y);
  mDown(app, 0u32);
  mUp(app);
}

fn typeString(ui: &mut Ui, s: &str) {
  var i = 0usize;
  while i < s.len() {
    textInput(ui, u32.from(s[i]));
    i = i + 1usize;
  }
}

// ---- changes from the inspector and the toolbar ----

fn applyChange(app: &mut App, c: &Change) {
  let id = app.scene.selected();
  if id == 0u32 {return;}
  let f = c.field;
  if f == F_NAME {
    let i = app.scene.find(id);
    app.scene.core.objects[i].name = String.from(c.after.s.view());
  } else if f == F_POS || f == F_ROT || f == F_SCALE {
    let cur = app.scene.transformOf(id);
    var after = cur;
    var before = cur;
    if f == F_POS {
      after.translation = vec3Of(&c.after);
      before.translation = vec3Of(&c.before);
    } else if f == F_ROT {
      after.rotation = quatOfDegrees(&c.after);
      before.rotation = quatOfDegrees(&c.before);
    } else {
      after.scale = vec3Of(&c.after);
      before.scale = vec3Of(&c.before);
    }
    app.scene.setTransform(id, after);
    if !c.live {app.scene.commitTransform(id, before, after);}
  } else if f == F_COLOR {
    let after = Vec4(c.after.x, c.after.y, c.after.z, c.after.w);
    let before = Vec4(c.before.x, c.before.y, c.before.z, c.before.w);
    app.scene.setProp(id, 0usize, after);
    if !c.live {app.scene.commitProp(id, 0usize, before, after);}
  } else if f == F_ROUGH || f == F_METAL {
    let cur = app.scene.propOf(id, 1usize);
    var after = cur;
    var before = cur;
    if f == F_ROUGH {after.x = c.after.x; before.x = c.before.x;}
    else {after.y = c.after.x; before.y = c.before.x;}
    app.scene.setProp(id, 1usize, after);
    if !c.live {app.scene.commitProp(id, 1usize, before, after);}
  } else if f == F_FINISH {
    // a finish is a preset of roughness and metalness: one undo step for the pair
    let k = i32.from(libc.floorf(c.after.x + 0.5));
    if k == 0i32 {return;}
    let cur = app.scene.propOf(id, 1usize);
    var after = cur;
    if k == 1i32 {after = Vec4(0.45, 0., 1., 0.);}
    else if k == 2i32 {after = Vec4(0.32, 1., 2., 0.);}
    else {after = Vec4(0.10, 0., 3., 0.);}
    app.scene.setProp(id, 1usize, after);
    app.scene.commitProp(id, 1usize, cur, after);
  }
}

fn toolbarClick(app: &mut App, node: usize) {
  if node == app.btnMove {app.gizmo.setMode(GM_MOVE);}
  else if node == app.btnRotate {app.gizmo.setMode(GM_ROTATE);}
  else if node == app.btnScale {app.gizmo.setMode(GM_SCALE);}
  else if node == app.btnSpace {app.gizmo.setSpace(if app.gizmo.space == SP_WORLD {SP_LOCAL} else {SP_WORLD});}
  else if node == app.btnSnap {app.gizmo.snap.enabled = !app.gizmo.snap.enabled;}
  else if node == app.btnUndo {app.scene.undo();}
  else if node == app.btnRedo {app.scene.redo();}
  else if node == app.btnCamera {app.showCamera = !app.showCamera;}
}

// ---- a frame ----

// Layout, the inspector's Changes applied, the toolbar's clicks, what depends on the scene brought up to date
fn updateEditor(app: &mut App, gfx: &mut Gfx, rig: &mut Rig, device: &mut Device) {
  layoutNow(&mut app.ui, &rig.font, &mut rig.atlas);
  let changes = app.insp.pump(&mut app.kit, &mut app.ui);
  var c = 0usize;
  while c < changes.len() {
    applyChange(app, &changes[c]);
    c = c + 1usize;
  }
  let evs = app.ui.takeEvents();
  var e = 0usize;
  while e < evs.len() {
    if evs[e].kind == UE_CLICK {toolbarClick(app, evs[e].node);}
    e = e + 1usize;
  }
  let id = app.scene.selected();
  if app.scene.core.version != app.synced {
    app.synced = app.scene.core.version;
    if id != 0u32 {
      let vals = valuesOf(app.scene.object(id));
      app.insp.setValues(&mut app.kit, &mut app.ui, &vals);
      app.gizmo.setTarget(app.scene.transformOf(id));
    }
  }
  app.ui.setVisible(app.panelNode, id != 0u32 && !app.showCamera);
  app.ui.setVisible(app.panel2, app.showCamera);
  let camChanges = app.insp2.pump(&mut app.kit, &mut app.ui);
  var cc = 0usize;
  while cc < camChanges.len() {
    applyCameraChange(app, &camChanges[cc]);
    cc = cc + 1usize;
  }
  // each object's material from its properties
  var i = 0usize;
  while i < app.scene.core.objects.len() {
    let p0 = *app.scene.core.objects[i].props[0usize];
    let p1 = *app.scene.core.objects[i].props[1usize];
    if !(*app.keys[2usize * i]).equals(p0) || !(*app.keys[2usize * i + 1usize]).equals(p1) {
      gfx.renderer.removeMaterial(device, *app.mats[i]);
      app.mats[i] = makeMaterial(gfx, device, p0, p1);
      app.keys[2usize * i] = p0;
      app.keys[2usize * i + 1usize] = p1;
    }
    i = i + 1usize;
  }
  // the status line
  var s = String.empty();
  s.append(if app.gizmo.mode == GM_MOVE {"Move"} else if app.gizmo.mode == GM_ROTATE {"Rotate"} else {"Scale"});
  s.append("  |  ");
  s.append(if app.gizmo.space == SP_WORLD {"world space"} else {"local space"});
  s.append("  |  snap ");
  s.append(if app.gizmo.snap.enabled {"on"} else {"off"});
  s.append("  |  ");
  s.appendInt(i64.from(app.scene.hist.undoCount()));
  s.append(" to undo, ");
  s.appendInt(i64.from(app.scene.hist.redoCount()));
  s.append(" to redo  |  ");
  if id == 0u32 {s.append("nothing selected");}
  else {s.append(app.scene.object(id).name.view());}
  app.ui.setText(app.status, s.view());
  app.kit.pump(&mut app.ui);
}

fn addOverlay(app: &App, out: &mut DrawList) {
  let id = app.scene.selected();
  if id == 0u32 {return;}
  var pts = List[Vec3].empty();
  outlineOf(&app.scene, id, app.view.eye, &mut pts);
  drawSegments(&app.view, &pts, 0x0c0c10d0u32, 5., out);
  drawSegments(&app.view, &pts, 0xffa51fffu32, 2.2, out);
  app.gizmo.draw(&app.view, out);
  if app.gizmo.dragging {
    let r = app.gizmo.readout.view();
    out.rect(app.mx + 14., app.my + 10., 190., 26., 0x14161cdcu32, 5., 0usize);
    out.text(app.mx + 14., app.my + 10., 190., 26., r, 0u32, 15., 0xffe08affu32, TA_CENTER, 0usize);
  }
}

// Draws the frame; 'copyOut' leaves the picture in rig.readback. Answers the CPU nanoseconds before the GPU was handed it
fn draw(app: &App, gfx: &mut Gfx, rig: &mut Rig, device: &mut Device, copyOut: bool, withUi: bool) i64 {
  let t0 = sdl.GetTicksNS();
  var ov = DrawList.make();
  addOverlay(app, &mut ov);
  var uil = DrawList.make();
  drawUi(&app.ui, &mut uil);
  ov.append(&uil);
  var dl = rd.DrawList.empty();
  dl.add(gfx.ground, gfx.groundMat, Mat4.fromTrs(Vec3(0., 0., 0.), Quat.identity(), Vec3(16., 1., 16.)));
  var i = 0usize;
  while i < app.scene.core.objects.len() {
    let o = &app.scene.core.objects[i];
    if o.visible {dl.add(*app.meshHandles[o.mesh], *app.mats[i], o.transform.toMat4());}
    i = i + 1usize;
  }
  var encoder = device.createCommandEncoder();
  gfx.renderer.render(device, &mut encoder, &gfx.post.hdr, &gfx.depth, &app.camera, &app.light, &dl);
  gfx.post.apply(&mut encoder, &gfx.out);
  if withUi {rig.paint(device, &mut encoder, &gfx.out, &ov);}
  if copyOut {encoder.copyTextureToBuffer(&gfx.out, &rig.readback);}
  let t1 = sdl.GetTicksNS();
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  i64.from(t1 - t0)
}

fn step(app: &mut App, gfx: &mut Gfx, rig: &mut Rig, device: &mut Device) {
  updateEditor(app, gfx, rig, device);
  draw(app, gfx, rig, device, true, true);
}

fn shot(app: &mut App, gfx: &mut Gfx, rig: &mut Rig, device: &mut Device, outPath: &filepath.Path, name: &str, what: &str) {
  step(app, gfx, rig, device);
  step(app, gfx, rig, device);
  rig.savePng(&outPath.join(name));
  print <- name, ": ", what, "\n";
}

fn p50(v: &List[i64]) i64 {
  var c = List[i64].empty();
  var i = 0usize;
  while i < v.len() {
    c.push(*v[i]);
    i = i + 1usize;
  }
  c.sortBy(fn(a: &i64, b: &i64) i32 { if *a < *b {-1i32} else if *a > *b {1i32} else {0i32} });
  if c.len() == 0usize {0i64} else {*c[c.len() / 2usize]}
}

fn near(a: f32, b: f32, eps: f32) bool {
  (if a > b {a - b} else {b - a}) < eps
}

fn sameT(a: Transform3, b: Transform3) bool {
  near(a.translation.x, b.translation.x, 0.0005) && near(a.translation.y, b.translation.y, 0.0005)
    && near(a.translation.z, b.translation.z, 0.0005) && near(a.scale.x, b.scale.x, 0.0005)
    && near(a.scale.y, b.scale.y, 0.0005) && near(a.scale.z, b.scale.z, 0.0005)
    && (if a.rotation.dot(b.rotation) < 0. {-a.rotation.dot(b.rotation)} else {a.rotation.dot(b.rotation)}) > 0.99999
}

// ======== setting up ========

fn makeScene(gfx: &mut Gfx, device: &mut Device) App {
  var scene = EditScene.make();
  var handles = List[rd.MeshHandle].empty();
  var mats = List[rd.MaterialHandle].empty();
  var keys = List[Vec4].empty();
  var meshes = List[Mesh].empty();
  meshes.push(vaseMesh());
  meshes.push(columnMesh());
  meshes.push(ringMesh());
  meshes.push(Mesh.sphere(0.5, 40));
  var k = 0usize;
  while k < 4usize {
    handles.push(gfx.renderer.addMesh(device, &meshes[k]));
    scene.addMesh(PickMesh.fromMesh(&meshes[k]));
    print <- "mesh ", u64.from(k), ": ", u64.from(meshes[k].triangleCount()), " triangles\n";
    k = k + 1usize;
  }
  scene.addObject("Vase", 0usize, placed(-1.9, 0., 0.3), props(0.78, 0.35, 0.22, 0.45, 0.));
  scene.addObject("Column", 1usize, placed(0.3, 0., -0.9), props(0.78, 0.75, 0.68, 0.7, 0.));
  scene.addObject("Ring", 2usize, placed(1.9, 0.13, 0.4), props(1., 0.76, 0.32, 0.25, 1.));
  scene.addObject("Ball", 3usize, placed(0.2, 0.5, 1.6), props(0.2, 0.36, 0.82, 0.18, 0.));
  var i = 0usize;
  while i < scene.core.objects.len() {
    let p0 = *scene.core.objects[i].props[0usize];
    let p1 = *scene.core.objects[i].props[1usize];
    mats.push(makeMaterial(gfx, device, p0, p1));
    keys.push(p0);
    keys.push(p1);
    i = i + 1usize;
  }
  // the ui: a toolbar, a status line, the inspector
  var ui = Ui.make(f32.from(W), f32.from(H));
  var kit = PickerKit.make();
  let tb = panel(&mut ui, ui.root, "panel");
  ui.setOffsets(tb, 12., 10., 0., 0.);
  ui.setSize(tb, 520., 38.);
  ui.setFlex(tb, LK_ROW, 6.);
  ui.setPad(tb, 5.);
  let bMove = button(&mut ui, tb, "Move");
  let bRotate = button(&mut ui, tb, "Rotate");
  let bScale = button(&mut ui, tb, "Scale");
  let bSpace = button(&mut ui, tb, "World / Local");
  let bSnap = button(&mut ui, tb, "Snap");
  let bUndo = button(&mut ui, tb, "Undo");
  let bRedo = button(&mut ui, tb, "Redo");
  let bCamera = button(&mut ui, tb, "Camera");
  let status = label(&mut ui, ui.root, "");
  ui.setOffsets(status, 18., 54., 0., 0.);
  let panelNode = panel(&mut ui, ui.root, "panel");
  ui.setOffsets(panelNode, 872., 56., 0., 0.);
  ui.setSize(panelNode, 396., AUTO);
  let desc = describeObject();
  var insp = Inspector.build(&mut kit, &mut ui, panelNode, &desc);
  // a second kind of thing, described in the same way: the same code makes its inspector
  let panel2 = panel(&mut ui, ui.root, "panel");
  ui.setOffsets(panel2, 872., 56., 0., 0.);
  ui.setSize(panel2, 396., AUTO);
  let camDesc = describeCamera();
  var insp2 = Inspector.build(&mut kit, &mut ui, panel2, &camDesc);
  insp2.setValues(&mut kit, &mut ui, &cameraValues());
  ui.setVisible(panel2, false);
  var camera = rd.Camera.make();
  camera.fov = radians(45.);
  camera.near = 0.1;
  camera.far = 80.;
  camera.lookAt(Vec3(0.5, 2.7, 7.4), Vec3(0., 0.7, 0.3), Vec3(0., 1., 0.));
  camera.background = Color(0.02, 0.03, 0.06, 1.);
  let view = GizmoView.make(camera.position(), camera.viewMatrix(), camera.projectionMatrix(f32.from(W) / f32.from(H)), camera.fov, f32.from(W), f32.from(H));
  var gizmo = Gizmo.make();
  gizmo.snap.moveStep = 0.25;
  let light = rd.Light.directional(Vec3(-0.4, -0.8, -0.45).normalize(), Color(3., 2.8, 2.4, 1.), Color(0.1, 0.12, 0.16, 1.));
  var app = App(scene, handles, mats, keys, ui, kit, insp, gizmo, camera, light, view, Transform3.identity(), insp2);
  app.panel2 = panel2;
  app.btnCamera = bCamera;
  app.btnMove = bMove;
  app.btnRotate = bRotate;
  app.btnScale = bScale;
  app.btnSpace = bSpace;
  app.btnSnap = bSnap;
  app.btnUndo = bUndo;
  app.btnRedo = bRedo;
  app.status = status;
  app.panelNode = panelNode;
  app
}

fn makeGfx(device: &mut Device) Gfx {
  var renderer = rd.Renderer.create(device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var post = rd.Post.create(device, TEXTURE_FORMAT_RGBA8_UNORM, W, H);
  post.bloom = 0.;
  post.exposure = 1.1;
  let outDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  let depthDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var sky = rd.Sky.dusk(radians(46.), radians(35.));
  sky.zenith = Color(0.12, 0.26, 0.58, 1.);
  sky.horizon = Color(0.42, 0.52, 0.66, 1.);
  sky.horizonSharpness = 3.;
  sky.glow = Color(0.22, 0.18, 0.1, 1.);
  sky.glowSharpness = 24.;
  sky.ground = Color(0.12, 0.12, 0.13, 1.);
  sky.sunColor = Color(80., 70., 55., 1.);
  renderer.setSky(device, &sky);
  let ground = renderer.addMesh(device, &Mesh.plane(1, 1.));
  let groundMat = renderer.addPbrMaterial(device, &rd.PbrMaterial.standard(Color(0.22, 0.23, 0.25, 1.), 0., 0.85));
  Gfx(renderer, post, device.createTexture(&depthDesc), device.createTexture(&outDesc), ground, groundMat)
}

// ======== the session ========

fn session(device: &mut Device, rig: &mut Rig, outPath: &filepath.Path) usize {
  var gfx = makeGfx(device);
  var app = makeScene(&mut gfx, device);
  step(&mut app, &mut gfx, rig, device);
  // 1. nothing selected
  shot(&mut app, &mut gfx, rig, device, outPath, "01-nothing-selected.png", "the scene, nothing selected, the toolbar and the status line");
  // 2. a click on the vase picks it by ray
  let vase = app.view.project(Vec3(-1.9, 0.75, 0.3));
  clickAt(&mut app, vase.x, vase.y);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "a click on the vase selects it", app.scene.selected() == 1u32);
  shot(&mut app, &mut gfx, rig, device, outPath, "02-vase-selected.png", "the vase outlined, its move gizmo, its inspector");
  // a click on empty ground deselects, and one on the column selects that; back to the vase
  let col = app.view.project(Vec3(0.3, 0.9, -0.9));
  clickAt(&mut app, col.x, col.y);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "a click on the column selects the column", app.scene.selected() == 2u32);
  clickAt(&mut app, vase.x, vase.y);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "and back to the vase", app.scene.selected() == 1u32);
  let original = app.scene.transformOf(1u32);
  let originalColour = app.scene.propOf(1u32, 0usize);

  // 3. snap on, drag the X arrow by 1.3 units
  clickAt(&mut app, centreOf(&app.ui, app.btnSnap).x, centreOf(&app.ui, app.btnSnap).y);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "snap is on", app.gizmo.snap.enabled);
  let pivot = original.translation;
  let s0 = app.view.unitAt(pivot, app.gizmo.sizeFrac);
  let armPoint = pivot + Vec3(0.55 * s0, 0., 0.);
  let a0 = app.view.project(armPoint);
  mMove(&mut app, a0.x, a0.y);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "the pointer over the X arrow highlights it", app.gizmo.hover == H_X);
  mDown(&mut app, 0u32);
  mMove(&mut app, app.view.project(armPoint + Vec3(0.5, 0., 0.)).x, app.view.project(armPoint + Vec3(0.5, 0., 0.)).y);
  mMove(&mut app, app.view.project(armPoint + Vec3(0.9, 0., 0.)).x, app.view.project(armPoint + Vec3(0.9, 0., 0.)).y);
  shot(&mut app, &mut gfx, rig, device, outPath, "03-move-mid-drag.png", "the X arrow held, the vase following, the snapped readout by the pointer");
  mMove(&mut app, app.view.project(armPoint + Vec3(1.3, 0., 0.)).x, app.view.project(armPoint + Vec3(1.3, 0., 0.)).y);
  mUp(&mut app);
  step(&mut app, &mut gfx, rig, device);
  let moved = app.scene.transformOf(1u32);
  print <- "  moved to x = ", moved.translation.x, " (from ", pivot.x, "); the pointer went 1.3 along, and the world grid of 0.25 holds the result to a multiple of it\n";
  check(&mut app, "the drag moved it along X only, to the grid", near(moved.translation.x, -0.5, 0.001) && near(moved.translation.y, 0., 0.001));
  check(&mut app, "one undo step", app.scene.hist.undoCount() == 1usize);

  // 4. rotate about Y by about 50 degrees, snapped to 45
  clickAt(&mut app, centreOf(&app.ui, app.btnRotate).x, centreOf(&app.ui, app.btnRotate).y);
  step(&mut app, &mut gfx, rig, device);
  let pv2 = moved.translation;
  let s1 = app.view.unitAt(pv2, app.gizmo.sizeFrac);
  let ringAt = Vec3(cos(radians(-60.)), 0., -sin(radians(-60.)));
  let r0 = app.view.project(pv2 + ringAt * s1);
  mMove(&mut app, r0.x, r0.y);
  mDown(&mut app, 0u32);
  let mid = Quat.angleAxis(radians(25.), Vec3(0., 1., 0.)) * ringAt;
  mMove(&mut app, app.view.project(pv2 + mid * s1).x, app.view.project(pv2 + mid * s1).y);
  let far = Quat.angleAxis(radians(50.), Vec3(0., 1., 0.)) * ringAt;
  mMove(&mut app, app.view.project(pv2 + far * s1).x, app.view.project(pv2 + far * s1).y);
  shot(&mut app, &mut gfx, rig, device, outPath, "04-rotate-mid-drag.png", "the Y ring held, the swept angle drawn, the vase turned");
  mUp(&mut app);
  step(&mut app, &mut gfx, rig, device);
  let turned = eulerOf(app.scene.transformOf(1u32).rotation);
  print <- "  turned about Y by ", degrees(turned.y), " degrees\n";
  check(&mut app, "snapped to 45 degrees about Y", near(degrees(turned.y), 45., 0.5) || near(degrees(turned.y), -45., 0.5));
  check(&mut app, "two undo steps", app.scene.hist.undoCount() == 2usize);

  // 5. scale uniformly from the centre block
  clickAt(&mut app, centreOf(&app.ui, app.btnScale).x, centreOf(&app.ui, app.btnScale).y);
  step(&mut app, &mut gfx, rig, device);
  let s2 = app.view.unitAt(pv2, app.gizmo.sizeFrac);
  let c0 = app.view.project(pv2 + Vec3(0.09 * s2, 0., 0.));
  mMove(&mut app, c0.x, c0.y);
  mDown(&mut app, 0u32);
  let c1 = app.view.project(pv2 + Vec3(0.126 * s2, 0., 0.));
  mMove(&mut app, c1.x, c1.y);
  mUp(&mut app);
  step(&mut app, &mut gfx, rig, device);
  let scaled = app.scene.transformOf(1u32).scale;
  print <- "  scale is now ", scaled.x, ", ", scaled.y, ", ", scaled.z, "\n";
  check(&mut app, "scaled by 1.4 on all three (snapped to 0.1)", near(scaled.x, 1.4, 0.001) && near(scaled.y, 1.4, 0.001) && near(scaled.z, 1.4, 0.001));
  shot(&mut app, &mut gfx, rig, device, outPath, "05-scaled.png", "the vase 1.4 times larger, the scale gizmo");
  // the same vase in local space: the move gizmo follows the vase's own axes, turned 45 degrees
  clickAt(&mut app, centreOf(&app.ui, app.btnMove).x, centreOf(&app.ui, app.btnMove).y);
  clickAt(&mut app, centreOf(&app.ui, app.btnSpace).x, centreOf(&app.ui, app.btnSpace).y);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "local space", app.gizmo.space == SP_LOCAL);
  shot(&mut app, &mut gfx, rig, device, outPath, "05b-local-space.png", "local space: the move arrows follow the vase's own axes (turned 45 degrees about Y)");
  clickAt(&mut app, centreOf(&app.ui, app.btnSpace).x, centreOf(&app.ui, app.btnSpace).y);

  // 6. the colour picker: open it, choose a hue, a saturation and value, then type a hex
  let cp = app.kit.colors[0usize].node;
  let hdr = Vec2(app.ui.nodes[cp].gx + 60., app.ui.nodes[cp].gy + 13.);
  clickAt(&mut app, hdr.x, hdr.y);
  step(&mut app, &mut gfx, rig, device);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "the picker opened in place", app.kit.colors[0usize].open);
  let cx = app.ui.nodes[cp].gx;
  let cy = app.ui.nodes[cp].gy;
  let cw = app.ui.nodes[cp].w;
  // the hue bar and the square, at the geometry the picker reports
  let hueX = cx + 6. + (cw - 12. - 52.) + 8. + 9.;
  let top = cy + 26. + 4. + 6.;
  clickAt(&mut app, hueX, top + 0.58 * 110.);
  clickAt(&mut app, cx + 6. + 0.85 * (cw - 64.), top + 0.12 * 110.);
  step(&mut app, &mut gfx, rig, device);
  let picked = app.scene.propOf(1u32, 0usize);
  print <- "  the picker gave ", picked.x, ", ", picked.y, ", ", picked.z, "\n";
  check(&mut app, "a blue-ish colour", picked.z > picked.x);
  shot(&mut app, &mut gfx, rig, device, outPath, "06-colour-picker.png", "the colour picker open in the inspector, the vase recoloured");
  // the hex field
  clickAt(&mut app, cx + 30., top + 110. + 8. + 12.);
  typeString(&mut app.ui, "#2E8B7A");
  keyDown(&mut app.ui, KEY_ENTER, 0u32);
  step(&mut app, &mut gfx, rig, device);
  let hexed = app.scene.propOf(1u32, 0usize);
  check(&mut app, "the typed hex colour", near(hexed.x, 0.1804, 0.003) && near(hexed.y, 0.5451, 0.003) && near(hexed.z, 0.4784, 0.003));
  // close the picker again (its header)
  clickAt(&mut app, hdr.x, hdr.y);
  step(&mut app, &mut gfx, rig, device);

  // 7. the roughness slider, and the finish dropdown
  let slider = app.kit.numbers[9usize].node;
  step(&mut app, &mut gfx, rig, device);
  let sx = app.ui.nodes[slider].gx;
  let sy = app.ui.nodes[slider].gy;
  let sw = app.ui.nodes[slider].w;
  mMove(&mut app, sx + 0.9 * sw, sy + 12.);
  mDown(&mut app, 0u32);
  mMove(&mut app, sx + 0.3 * sw, sy + 12.);
  mUp(&mut app);
  step(&mut app, &mut gfx, rig, device);
  let rough = app.scene.propOf(1u32, 1usize);
  print <- "  roughness is ", rough.x, "\n";
  check(&mut app, "roughness set by the slider", near(rough.x, 0.3, 0.02));
  let dd = app.kit.drops[0usize].node;
  let dc = centreOf(&app.ui, dd);
  clickAt(&mut app, dc.x, app.ui.nodes[dd].gy + 12.);
  step(&mut app, &mut gfx, rig, device);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "the dropdown opened", app.kit.drops[0usize].open);
  shot(&mut app, &mut gfx, rig, device, outPath, "07-dropdown-open.png", "the Finish dropdown open in place, the roughness slider at 0.30");
  clickAt(&mut app, dc.x, app.ui.nodes[dd].gy + 26. + 26. * 2. + 12.);
  step(&mut app, &mut gfx, rig, device);
  step(&mut app, &mut gfx, rig, device);
  let fin = app.scene.propOf(1u32, 1usize);
  check(&mut app, "brushed metal: metallic 1, roughness 0.32", near(fin.y, 1., 0.001) && near(fin.x, 0.32, 0.001));
  shot(&mut app, &mut gfx, rig, device, outPath, "08-brushed-metal.png", "the vase in the Brushed metal finish");
  print <- "  undo steps recorded: ", u64.from(app.scene.hist.undoCount()), "\n";

  // 8. undo, a few at a time, then all of them
  clickAt(&mut app, centreOf(&app.ui, app.btnUndo).x, centreOf(&app.ui, app.btnUndo).y);
  clickAt(&mut app, centreOf(&app.ui, app.btnUndo).x, centreOf(&app.ui, app.btnUndo).y);
  clickAt(&mut app, centreOf(&app.ui, app.btnUndo).x, centreOf(&app.ui, app.btnUndo).y);
  shot(&mut app, &mut gfx, rig, device, outPath, "09-three-undone.png", "three clicks on Undo: the finish, the roughness and the typed colour are gone");
  var guard = 0;
  while app.scene.canUndo() && guard < 40 {
    clickAt(&mut app, centreOf(&app.ui, app.btnUndo).x, centreOf(&app.ui, app.btnUndo).y);
    step(&mut app, &mut gfx, rig, device);
    guard = guard + 1;
  }
  check(&mut app, "every edit undone: the transform is the original", sameT(app.scene.transformOf(1u32), original));
  let backColour = app.scene.propOf(1u32, 0usize);
  check(&mut app, "every edit undone: the colour is the original", backColour.equals(originalColour));
  shot(&mut app, &mut gfx, rig, device, outPath, "10-all-undone.png", "all of it undone: the vase where and as it began");
  clickAt(&mut app, centreOf(&app.ui, app.btnRedo).x, centreOf(&app.ui, app.btnRedo).y);
  clickAt(&mut app, centreOf(&app.ui, app.btnRedo).x, centreOf(&app.ui, app.btnRedo).y);
  clickAt(&mut app, centreOf(&app.ui, app.btnRedo).x, centreOf(&app.ui, app.btnRedo).y);
  shot(&mut app, &mut gfx, rig, device, outPath, "11-three-redone.png", "three redone: moved, turned and scaled again");
  check(&mut app, "redo brought the move back", near(app.scene.transformOf(1u32).translation.x, -0.5, 0.001));

  // 12. a second kind of thing, inspected by the same code from its own description: the camera
  clickAt(&mut app, centreOf(&app.ui, app.btnCamera).x, centreOf(&app.ui, app.btnCamera).y);
  step(&mut app, &mut gfx, rig, device);
  step(&mut app, &mut gfx, rig, device);
  check(&mut app, "the camera's inspector is showing", app.showCamera);
  let fovNode = app.kit.numbers[11usize].node;
  let fx = app.ui.nodes[fovNode].gx;
  let fy = app.ui.nodes[fovNode].gy;
  let fw = app.ui.nodes[fovNode].w;
  mMove(&mut app, fx + 0.31 * fw, fy + 12.);
  mDown(&mut app, 0u32);
  mMove(&mut app, fx + 0.2 * fw, fy + 12.);
  mUp(&mut app);
  step(&mut app, &mut gfx, rig, device);
  print <- "  the camera's field of view is now ", degrees(app.camera.fov), " degrees (", u64.from(app.camChanges), " changes reached the camera)\n";
  check(&mut app, "the field of view slider changed the camera", near(degrees(app.camera.fov), 36., 0.2));
  shot(&mut app, &mut gfx, rig, device, outPath, "12-camera-inspector.png", "a second description, the same inspector code: a camera's lens, its field of view dragged to 36 degrees (the picture narrows)");
  clickAt(&mut app, centreOf(&app.ui, app.btnCamera).x, centreOf(&app.ui, app.btnCamera).y);

  // the cost of a frame in this state
  var cpu = List[i64].empty();
  var edit = List[i64].empty();
  var prepList = List[i64].empty();
  var total = List[i64].empty();
  var f = 0;
  while f < 120 {
    let a = sdl.GetTicksNS();
    updateEditor(&mut app, &mut gfx, rig, device);
    let b = sdl.GetTicksNS();
    let prep = draw(&app, &mut gfx, rig, device, false, true);
    let c = sdl.GetTicksNS();
    if f >= 20 {
      edit.push(i64.from(b - a));
      prepList.push(rig.prepNs);
      cpu.push(prep);
      total.push(i64.from(c - a));
    }
    f = f + 1;
  }
  print <- "frame cost (p50 of 100): update (layout, inspector, gizmo, materials) ", p50(&edit) / 1000i64, " us; build and record the frame ",
    p50(&cpu) / 1000i64, " us; whole frame with the GPU wait ", p50(&total) / 1000i64, " us\n";
  print <- "  of that, the demo renderer's preparation of the overlay (laying out the glyphs, packing the shapes): ", p50(&prepList) / 1000i64, " us\n";
  print <- "  the overlay: ", u64.from(rig.prims), " shapes, ", u64.from(rig.glyphs), " glyphs; layout nodes measured ", u64.from(app.ui.stats.measured),
    ", arranged ", u64.from(app.ui.stats.arranged), "\n";
  // the same frame without the editor drawn over it, for what the overlay costs
  var bare = List[i64].empty();
  f = 0;
  while f < 120 {
    let a = sdl.GetTicksNS();
    draw(&app, &mut gfx, rig, device, false, false);
    let c = sdl.GetTicksNS();
    if f >= 20 {bare.push(i64.from(c - a));}
    f = f + 1;
  }
  print <- "  the scene alone (no editor overlay): ", p50(&bare) / 1000i64, " us a frame\n";
  // the editing work itself: a pick by ray over the four objects (", triangles in all), an outline, a gizmo drag step
  let tp0 = sdl.GetTicksNS();
  var hits = 0u32;
  var pk = 0;
  while pk < 200 {
    var dist = 0.f;
    let id = app.scene.pick(app.view.rayAt(300. + f32.from(pk), 380.), &mut dist);
    hits = hits + id;
    pk = pk + 1;
  }
  let tp1 = sdl.GetTicksNS();
  let onBall = app.view.project(Vec3(0.2, 0.5, 1.6));
  var worst = 0;
  while worst < 200 {
    var dist = 0.f;
    let id = app.scene.pick(app.view.rayAt(onBall.x, onBall.y), &mut dist);
    hits = hits + id;
    worst = worst + 1;
  }
  let tp1b = sdl.GetTicksNS();
  print <- "  one pick by ray straight through the 3,120-triangle ball: ", i64.from(tp1b - tp1) / 200i64 / 1000i64, " us\n";
  var ol = 0;
  var segs = 0usize;
  while ol < 200 {
    var pts = List[Vec3].empty();
    outlineOf(&app.scene, 1u32, app.view.eye, &mut pts);
    segs = pts.len() / 2usize;
    ol = ol + 1;
  }
  let tp2 = sdl.GetTicksNS();
  print <- "  one pick by ray over the scene, mostly missing: ", i64.from(tp1 - tp0) / 200i64 / 1000i64, " us; one outline (", u64.from(segs), " edges): ",
    i64.from(tp2 - tp1b) / 200i64 / 1000i64, " us (", u64.from(hits), ")\n";
  print <- "checks: ", u64.from(app.passed), " passed, ", u64.from(app.failed), " failed\n";
  app.failed
}

// ---- checks ----
fn check(app: &mut App, what: &str, ok: bool) {
  if ok {app.passed = app.passed + 1usize;} else {
    app.failed = app.failed + 1usize;
    print <- "  CHECK FAILED: ", what, "\n";
  }
}

fn main() i32 {
  let args = process.args();
  var out = String.from("sceneedit-shots");
  if args.len() > 1usize {out = String.from((*args[1usize]).view());}
  var instance = Instance.create("sceneedit demo");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 {preference = POWER_PREFERENCE_LOW_POWER;}
  }
  var adapter = instance.requestAdapter(&none, preference);
  var device = adapter.requestDevice();
  print <- "adapter ", adapter.name.view(), "\n";
  let outPath = filepath.Path.from(out.view());
  fs.makeDirAll(&outPath);
  match fs.readFile(&filepath.Path.from("C:/Windows/Fonts/segoeui.ttf")) {
    case let Ok(bytes) {
      match Font.load(bytes.view()) {
        case let Ok(f) {
          var rig = Rig.make(&mut device, f);
          let bad = session(&mut device, &mut rig, &outPath);
          if bad > 0usize {return 1;}
        }
        case is Err { print <- "the font did not load\n"; return 1; }
      }
    }
    case is Err { print <- "no Segoe UI on this machine\n"; return 1; }
  }
  0
}

