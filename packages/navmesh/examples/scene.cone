// scene: a navigation mesh over a small test scene, a path on it, a door
// that opens, and a picture of each (BMP files in the current folder):
//
//   congo run packages/navmesh/examples/scene.cone
//
// The scene is 24 m by 16 m. A wall across the middle (x = 12) has a doorway
// at z 7 to 9 shut by a door (an obstacle that blocks) and an open gap at z
// 13 to 16; a round pillar stands left of the wall, a mud patch and a pool
// right of it. The agent is 0.4 m in radius and 1.8 m tall. A route from the
// left side to the right goes round through the gap while the door is
// shut; when the door opens, only the tiles it touches are rebuilt and the
// route goes through it.

mod scene;

import stdio use *;
import libc;
import geomath use *;
import collections use *;
import time use Instant;
import navmesh use *;

fn saveBmp(cv &Canvas, name &str) {
  let bytes = cv.toBmp();
  let v = bytes.view();
  var cpath = String.from(name);
  let f = libc.fopen(cpath.cstr(), "wb");
  if !f { printStr("could not write "); printStr(name); printStr("\n"); return; }
  libc.fwrite(&v[0] as *u8, 1usize, v.len, f);
  libc.fclose(f);
  printStr("wrote "); printStr(name); printStr("\n");
}

fn pathLength(pts &List[StraightPoint]) f32 {
  var len = 0.;
  var i = 1usize;
  while i < pts.len() {
    len = len + (*pts[i]).pos.distance((*pts[i - 1usize]).pos);
    i = i + 1usize;
  }
  len;
}

fn report(label &str, r &Route) {
  printStr(label);
  printStr(": ");
  if !r.found { printStr("no route\n"); return; }
  printInt(i64.from(r.points.len())); printStr(" corners, length ");
  printFloat(f64.from(pathLength(&r.points))); printStr(", cost "); printFloat(f64.from(r.cost)); printStr("\n");
}

fn drawAll(nav &NavMesh, r &Route, name &str) {
  var cv = Canvas.make(0., 0., 24., 16., 30.);
  drawNavMesh(&mut cv, nav);
  drawPath(&mut cv, &r.points, 220u8, 30u8, 30u8);
  // the pillar
  cv.ring(6., 8., 1.5, 90u8, 90u8, 90u8);
  saveBmp(&cv, name);
}

fn main() i32 {
  var input = NavInput.empty();
  input.addTriangle(new Vec3(0., 0., 0.), new Vec3(0., 0., 16.), new Vec3(24., 0., 0.), AreaGround);
  input.addTriangle(new Vec3(24., 0., 0.), new Vec3(0., 0., 16.), new Vec3(24., 0., 16.), AreaGround);
  // the wall across the middle, in two pieces round the doorway
  input.addSolidBox(12., 3.5, 0.2, 3.5, 0., 3., AreaNull);
  input.addSolidBox(12., 11., 0.2, 2., 0., 3., AreaNull);
  // the door shutting the doorway
  let door = input.addBoxObstacle(12., 8., 0.2, 1., 0., 0., 2.2, AreaNull);
  // the pillar
  input.addCircleObstacle(6., 8., 1.5, 0., 3., AreaNull);
  // mud and a pool
  input.addBoxObstacle(18., 5., 2., 2., 0., -1., 1., AreaMud);
  input.addBoxObstacle(18., 12., 2., 2., 0., -1., 1., AreaWater);
  let params = NavParams.standard();
  let t0 = Instant.now();
  var nav = buildNavMesh(&mut input, &params);
  printStr("built "); printInt(i64.from(nav.tiles.len())); printStr(" tile, ");
  printInt(i64.from(nav.polyCount())); printStr(" polygons in ");
  printFloat(f64.from(t0.elapsed().secondsF64() * 1000.)); printStr(" ms\n");
  var filter = QueryFilter.standard();
  filter.setCost(AreaMud, 3.);
  filter.setCost(AreaWater, 6.);
  let start = new Vec3(2., 0., 8.);
  let goal = new Vec3(22., 0., 8.);
  let half = new Vec3(2., 4., 2.);
  let closed = findRoute(&nav, start, goal, half, &filter);
  report("door shut", &closed);
  drawAll(&nav, &closed, "navmesh-door-shut.bmp");
  input.setObstacleEnabled(door, false);
  let t1 = Instant.now();
  let rebuilt = rebuildDirty(&mut nav, &mut input);
  printStr("door opened: rebuilt "); printInt(i64.from(rebuilt)); printStr(" tile(s) in ");
  printFloat(f64.from(t1.elapsed().secondsF64() * 1000.)); printStr(" ms\n");
  let open = findRoute(&nav, start, goal, half, &filter);
  report("door open", &open);
  drawAll(&nav, &open, "navmesh-door-open.bmp");
  0i32;
}
