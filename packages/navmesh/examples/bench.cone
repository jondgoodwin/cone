// bench: how long a navigation mesh takes to build for a 200 m by 200 m
// area at 0.3 m cells (the default resolution), and how long queries and a
// tile rebuild take:
//
//   congo run --release packages/navmesh/examples/bench.cone
//
// The ground is a heightfield sampled every 2 m (hills of 3 m, slopes well
// under the agent's 45 degrees, some of it steeper than that) with 120 solid
// pillars and boxes scattered on it from a fixed random sequence, and a
// maze-like set of walls.

mod bench;

import stdio use *;
import libc;
import geomath use *;
import collections use *;
import time use Instant;
import navmesh use *;

fn ms(t: Instant) f64 { t.elapsed().secondsF64() * 1000. }

fn main() i32 {
  let n = 101i32;
  var hs = List[f32].empty();
  var j = 0i32;
  while j < n {
    var i = 0i32;
    while i < n {
      let x = f32.from(i) * 2.;
      let z = f32.from(j) * 2.;
      hs.push(1.5 * sin(x * 0.045) * cos(z * 0.038) + 0.8 * sin((x + z) * 0.11));
      i = i + 1i32;
    }
    j = j + 1i32;
  }
  var input = NavInput.empty();
  input.addHeightfield(0., 0., 2., n, n, hs.view(), AreaGround);
  // obstacles from a linear congruential generator
  var s = 12345u32;
  var k = 0i32;
  while k < 120i32 {
    s = s * 1664525u32 + 1013904223u32;
    let x = 5. + f32.from((s >> 8u32) % 19000u32) / 100.;
    s = s * 1664525u32 + 1013904223u32;
    let z = 5. + f32.from((s >> 8u32) % 19000u32) / 100.;
    s = s * 1664525u32 + 1013904223u32;
    let size = 0.8 + f32.from((s >> 8u32) % 400u32) / 100.;
    if k % 2i32 == 0i32 {
      input.addCircleObstacle(x, z, size, -10., 20., AreaNull);
    } else {
      input.addBoxObstacle(x, z, size, size * 0.6, f32.from(k) * 0.3, -10., 20., AreaNull);
    }
    k = k + 1i32;
  }
  // long walls with gaps
  var w = 0i32;
  while w < 6i32 {
    let z = 25. + f32.from(w) * 28.;
    input.addBoxObstacle(60., z, 55., 0.4, 0., -10., 20., AreaNull);
    input.addBoxObstacle(165., z + 10., 30., 0.4, 0., -10., 20., AreaNull);
    w = w + 1i32;
  }
  printStr("input: "); printInt(i64.from(input.triangleCount())); printStr(" triangles, ");
  printInt(i64.from(input.obstacles.len())); printStr(" obstacles\n");
  let params = NavParams.standard();
  let t0 = Instant.now();
  var nav = buildNavMesh(&mut input, &params);
  let built = ms(t0);
  printStr("built "); printInt(i64.from(nav.tilesW * nav.tilesH)); printStr(" tiles, ");
  printInt(i64.from(nav.polyCount())); printStr(" polygons in "); printFloat(built); printStr(" ms\n");
  let filter = QueryFilter.standard();
  let half = Vec3(3., 10., 3.);
  {
    var cv = Canvas.make(0., 0., 200., 200., 5.);
    drawNavMesh(&mut cv, &nav);
    let route = findRoute(&nav, Vec3(8., 0., 8.), Vec3(190., 0., 190.), half, &filter);
    drawPath(&mut cv, &route.points, 220u8, 30u8, 30u8);
    let bytes = cv.toBmp();
    let v = bytes.view();
    var cpath = String.from("navmesh-bench.bmp");
    let f = libc.fopen(cpath.cstr(), "wb");
    if f { libc.fwrite(&v[0] as *u8, 1usize, v.len, f); libc.fclose(f); }
  }
  // a route corner to corner
  let t1 = Instant.now();
  var found = 0i32;
  var q = 0i32;
  while q < 20i32 {
    let a = Vec3(8. + f32.from(q), 0., 8.);
    let r = findRoute(&nav, a, Vec3(190., 0., 190. - f32.from(q)), half, &filter);
    if r.found && !r.partial { found = found + 1i32; }
    q = q + 1i32;
  }
  printStr("20 routes across the area ("); printInt(i64.from(found)); printStr(" complete) in ");
  printFloat(ms(t1)); printStr(" ms\n");
  // one tile rebuilt
  input.addCircleObstacle(100., 100., 2., -10., 20., AreaNull);
  let t2 = Instant.now();
  let rebuilt = rebuildDirty(&mut nav, &mut input);
  printStr("an obstacle added: "); printInt(i64.from(rebuilt)); printStr(" tile(s) rebuilt in ");
  printFloat(ms(t2)); printStr(" ms\n");
  0i32
}
