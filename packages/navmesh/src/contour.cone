// ======== Contours: the outline of each region, simplified ========
//
// Recast's third stage (RecastContour.cpp). Each region's boundary is
// walked cell edge by cell edge into a closed loop of raw points (x, y, z
// of a cell corner, and the region on the other side of the edge), then
// simplified with Douglas-Peucker to within 'maxError' cells; points are kept
// wherever the neighbouring region changes, so that two regions that share an
// edge keep the same points on it, and a long wall edge is split to at most
// 'maxEdgeLen' cells. A point is four numbers in a flat list: x, y, z, and
// the flag word: the neighbour region (low 16 bits), AreaBorder (a change of
// area at the edge) and BorderVertex.

pub const AreaBorder i32 = 131072i32;       // 0x20000
pub const BorderVertex i32 = 65536i32;      // 0x10000
pub const RegMask i32 = 65535i32;

pub struct Contour {
  pub reg i32;
  pub area u8;
  pub verts List[i32];     // simplified, four numbers a point
}

fn cornerHeight(c &CompactHF, x i32, z i32, i usize, dir i32) CornerResult {
  imm s = i;
  mut ch = *c.y[s];
  imm dirp = (dir + 1i32) & 3i32;
  mut r0 = *c.reg[s] | (i32.from(*c.area[s]) << 16i32);
  mut r1 = 0i32;
  mut r2 = 0i32;
  mut r3 = 0i32;
  imm a = c.neighbour(s, x, z, dir);
  if a >= 0i32 {
    imm ai = usize.from(a);
    ch = imax(ch, *c.y[ai]);
    r1 = *c.reg[ai] | (i32.from(*c.area[ai]) << 16i32);
    imm a2 = c.neighbour(ai, x + dirX(dir), z + dirZ(dir), dirp);
    if a2 >= 0i32 {
      ch = imax(ch, *c.y[usize.from(a2)]);
      r2 = *c.reg[usize.from(a2)] | (i32.from(*c.area[usize.from(a2)]) << 16i32);
    }
  }
  imm b = c.neighbour(s, x, z, dirp);
  if b >= 0i32 {
    imm bi = usize.from(b);
    ch = imax(ch, *c.y[bi]);
    r3 = *c.reg[bi] | (i32.from(*c.area[bi]) << 16i32);
    imm b2 = c.neighbour(bi, x + dirX(dirp), z + dirZ(dirp), dir);
    if b2 >= 0i32 {
      ch = imax(ch, *c.y[usize.from(b2)]);
      r2 = *c.reg[usize.from(b2)] | (i32.from(*c.area[usize.from(b2)]) << 16i32);
    }
  }
  // the vertex is a border vertex if two same exterior cells in a row are
  // followed by two interior cells, none of them out of bounds
  mut border = false;
  mut j = 0i32;
  while j < 4i32 {
    imm ra = regAt(r0, r1, r2, r3, j);
    imm rb = regAt(r0, r1, r2, r3, (j + 1i32) & 3i32);
    imm rc = regAt(r0, r1, r2, r3, (j + 2i32) & 3i32);
    imm rd = regAt(r0, r1, r2, r3, (j + 3i32) & 3i32);
    imm twoSameExts = (ra & rb & BorderReg) != 0i32 and ra == rb;
    imm twoInts = ((rc | rd) & BorderReg) == 0i32;
    imm intsSameArea = (rc >> 16i32) == (rd >> 16i32);
    imm noZeros = ra != 0i32 and rb != 0i32 and rc != 0i32 and rd != 0i32;
    if twoSameExts and twoInts and intsSameArea and noZeros { border = true; break; }
    j = j + 1i32;
  }
  new CornerResult(ch, border);
}

struct CornerResult {
  h i32;
  border bool;
}

fn regAt(r0 i32, r1 i32, r2 i32, r3 i32, j i32) i32 {
  if j == 0i32 { return r0; }
  if j == 1i32 { return r1; }
  if j == 2i32 { return r2; }
  r3;
}

// Walk the boundary of the region starting at span 'i' of column (x, z)
fn walkContour(c &CompactHF, x0 i32, z0 i32, i0 usize, flags &mut List[i32], pts &mut List[i32]) {
  mut x = x0;
  mut z = z0;
  mut i = i0;
  mut dir = 0i32;
  while (*flags[i] & (1i32 << dir)) == 0i32 { dir = dir + 1i32; }
  imm startDir = dir;
  imm starti = i;
  imm area = *c.area[i];
  mut iter = 0i32;
  while iter < 40000i32 {
    iter = iter + 1i32;
    if (*flags[i] & (1i32 << dir)) != 0i32 {
      // an edge of the boundary: its corner
      mut isAreaBorder = false;
      imm cr = cornerHeight(c, x, z, i, dir);
      mut px = x;
      imm py = cr.h;
      mut pz = z;
      if dir == 0i32 { pz = pz + 1i32; }
      if dir == 1i32 { px = px + 1i32; pz = pz + 1i32; }
      if dir == 2i32 { px = px + 1i32; }
      mut r = 0i32;
      imm nb = c.neighbour(i, x, z, dir);
      if nb >= 0i32 {
        r = *c.reg[usize.from(nb)];
        if area != *c.area[usize.from(nb)] { isAreaBorder = true; }
      }
      if cr.border { r = r | BorderVertex; }
      if isAreaBorder { r = r | AreaBorder; }
      pts.push(px); pts.push(py); pts.push(pz); pts.push(r);
      flags.set(i, *flags[i] & ~(1i32 << dir));
      dir = (dir + 1i32) & 3i32;
    } else {
      imm ni = c.neighbour(i, x, z, dir);
      if ni < 0i32 { return; }
      x = x + dirX(dir);
      z = z + dirZ(dir);
      i = usize.from(ni);
      dir = (dir + 3i32) & 3i32;
    }
    if starti == i and startDir == dir { break; }
  }
}

fn distPtSegI(px i32, pz i32, ax i32, az i32, bx i32, bz i32) f32 {
  imm pqx = f32.from(bx - ax);
  imm pqz = f32.from(bz - az);
  imm dx = f32.from(px - ax);
  imm dz = f32.from(pz - az);
  imm d = pqx * pqx + pqz * pqz;
  mut t = pqx * dx + pqz * dz;
  if d > 0. { t = t / d; }
  if t < 0. { t = 0.; } elif t > 1. { t = 1.; }
  imm ex = f32.from(ax) + t * pqx - f32.from(px);
  imm ez = f32.from(az) + t * pqz - f32.from(pz);
  ex * ex + ez * ez;
}

fn insertPoint(simp &mut List[i32], at usize, x i32, y i32, z i32, idx i32) {
  // a point inserted at position 'at' (counting points): grow, shift, set
  simp.push(0i32); simp.push(0i32); simp.push(0i32); simp.push(0i32);
  mut j = simp.len() / 4usize - 1usize;
  while j > at {
    simp.set(j * 4usize, *simp[(j - 1usize) * 4usize]);
    simp.set(j * 4usize + 1usize, *simp[(j - 1usize) * 4usize + 1usize]);
    simp.set(j * 4usize + 2usize, *simp[(j - 1usize) * 4usize + 2usize]);
    simp.set(j * 4usize + 3usize, *simp[(j - 1usize) * 4usize + 3usize]);
    j = j - 1usize;
  }
  simp.set(at * 4usize, x);
  simp.set(at * 4usize + 1usize, y);
  simp.set(at * 4usize + 2usize, z);
  simp.set(at * 4usize + 3usize, idx);
}

fn simplifyContour(pts &List[i32], simp &mut List[i32], maxError f32, maxEdgeLen i32) {
  imm pn = i32.from(pts.len() / 4usize);
  mut hasConnections = false;
  mut i = 0usize;
  while i < pts.len() {
    if (*pts[i + 3usize] & RegMask) != 0i32 { hasConnections = true; break; }
    i = i + 4usize;
  }
  if hasConnections {
    // a point wherever the region changes
    mut a = 0i32;
    while a < pn {
      imm b = (a + 1i32) % pn;
      imm fa = *pts[usize.from(a) * 4usize + 3usize];
      imm fb = *pts[usize.from(b) * 4usize + 3usize];
      imm differentRegs = (fa & RegMask) != (fb & RegMask);
      imm areaBorders = (fa & AreaBorder) != (fb & AreaBorder);
      if differentRegs or areaBorders {
        simp.push(*pts[usize.from(a) * 4usize]);
        simp.push(*pts[usize.from(a) * 4usize + 1usize]);
        simp.push(*pts[usize.from(a) * 4usize + 2usize]);
        simp.push(a);
      }
      a = a + 1i32;
    }
  }
  if simp.len() == 0usize {
    // no connections: begin from the lower-left and upper-right points
    mut llx = *pts[0usize];
    mut lly = *pts[1usize];
    mut llz = *pts[2usize];
    mut lli = 0i32;
    mut urx = llx;
    mut ury = lly;
    mut urz = llz;
    mut uri = 0i32;
    i = 0usize;
    while i < pts.len() {
      imm x = *pts[i];
      imm y = *pts[i + 1usize];
      imm z = *pts[i + 2usize];
      if x < llx or (x == llx and z < llz) { llx = x; lly = y; llz = z; lli = i32.from(i / 4usize); }
      if x > urx or (x == urx and z > urz) { urx = x; ury = y; urz = z; uri = i32.from(i / 4usize); }
      i = i + 4usize;
    }
    simp.push(llx); simp.push(lly); simp.push(llz); simp.push(lli);
    simp.push(urx); simp.push(ury); simp.push(urz); simp.push(uri);
  }
  // add points until every raw point is within the error of the shape
  i = 0usize;
  while i < simp.len() / 4usize {
    imm ii = (i + 1usize) % (simp.len() / 4usize);
    mut ax = *simp[i * 4usize];
    mut az = *simp[i * 4usize + 2usize];
    imm ai = *simp[i * 4usize + 3usize];
    mut bx = *simp[ii * 4usize];
    mut bz = *simp[ii * 4usize + 2usize];
    imm bi = *simp[ii * 4usize + 3usize];
    mut maxd = 0.;
    mut maxi = -1i32;
    mut ci = 0i32;
    mut cinc = 0i32;
    mut endi = 0i32;
    // walk the segment in lexicographic order so opposite segments agree
    if bx > ax or (bx == ax and bz > az) {
      cinc = 1i32;
      ci = (ai + cinc) % pn;
      endi = bi;
    } else {
      cinc = pn - 1i32;
      ci = (bi + cinc) % pn;
      endi = ai;
      imm tx = ax; ax = bx; bx = tx;
      imm tz = az; az = bz; bz = tz;
    }
    // only outer edges or edges between areas are tessellated
    imm cf = *pts[usize.from(ci) * 4usize + 3usize];
    if (cf & RegMask) == 0i32 or (cf & AreaBorder) != 0i32 {
      while ci != endi {
        imm d = distPtSegI(*pts[usize.from(ci) * 4usize], *pts[usize.from(ci) * 4usize + 2usize], ax, az, bx, bz);
        if d > maxd { maxd = d; maxi = ci; }
        ci = (ci + cinc) % pn;
      }
    }
    if maxi != -1i32 and maxd > maxError * maxError {
      insertPoint(simp, i + 1usize, *pts[usize.from(maxi) * 4usize], *pts[usize.from(maxi) * 4usize + 1usize], *pts[usize.from(maxi) * 4usize + 2usize], maxi);
    } else {
      i = i + 1usize;
    }
  }
  // split too long wall edges
  if maxEdgeLen > 0i32 {
    i = 0usize;
    while i < simp.len() / 4usize {
      imm ii = (i + 1usize) % (simp.len() / 4usize);
      imm ai = *simp[i * 4usize + 3usize];
      imm bi = *simp[ii * 4usize + 3usize];
      imm ax = *simp[i * 4usize];
      imm az = *simp[i * 4usize + 2usize];
      imm bx = *simp[ii * 4usize];
      imm bz = *simp[ii * 4usize + 2usize];
      mut maxi = -1i32;
      imm ci = (ai + 1i32) % pn;
      imm cf = *pts[usize.from(ci) * 4usize + 3usize];
      imm tess = (cf & RegMask) == 0i32 or (cf & AreaBorder) != 0i32;
      if tess {
        imm dx = bx - ax;
        imm dz = bz - az;
        if dx * dx + dz * dz > maxEdgeLen * maxEdgeLen {
          imm n = if bi < ai { bi + pn - ai; } else { bi - ai; };
          if n > 1i32 {
            if bx > ax or (bx == ax and bz > az) {
              maxi = (ai + n / 2i32) % pn;
            } else {
              maxi = (ai + (n + 1i32) / 2i32) % pn;
            }
          }
        }
      }
      if maxi != -1i32 {
        insertPoint(simp, i + 1usize, *pts[usize.from(maxi) * 4usize], *pts[usize.from(maxi) * 4usize + 1usize], *pts[usize.from(maxi) * 4usize + 2usize], maxi);
      } else {
        i = i + 1usize;
      }
    }
  }
  // the neighbour of the edge from point i is the flag of the raw point after
  // it, and its border-vertex flag is the raw point's own
  i = 0usize;
  while i < simp.len() / 4usize {
    imm ai = (*simp[i * 4usize + 3usize] + 1i32) % pn;
    imm bi = *simp[i * 4usize + 3usize];
    imm f = (*pts[usize.from(ai) * 4usize + 3usize] & (RegMask | AreaBorder)) | (*pts[usize.from(bi) * 4usize + 3usize] & BorderVertex);
    simp.set(i * 4usize + 3usize, f);
    i = i + 1usize;
  }
}

fn removeDegenerateSegments(simp &mut List[i32]) {
  mut npts = simp.len() / 4usize;
  mut i = 0usize;
  while i < npts {
    imm ni = (i + 1usize) % npts;
    if *simp[i * 4usize] == *simp[ni * 4usize] and *simp[i * 4usize + 2usize] == *simp[ni * 4usize + 2usize] {
      mut j = i;
      while j < simp.len() / 4usize - 1usize {
        simp.set(j * 4usize, *simp[(j + 1usize) * 4usize]);
        simp.set(j * 4usize + 1usize, *simp[(j + 1usize) * 4usize + 1usize]);
        simp.set(j * 4usize + 2usize, *simp[(j + 1usize) * 4usize + 2usize]);
        simp.set(j * 4usize + 3usize, *simp[(j + 1usize) * 4usize + 3usize]);
        j = j + 1usize;
      }
      simp.truncate(simp.len() - 4usize);
      npts = npts - 1usize;
    }
    i = i + 1usize;
  }
}

// Twice the signed area of a closed loop in x and z (negative: a hole)
fn loopArea(simp &List[i32]) i32 {
  imm n = simp.len() / 4usize;
  mut a = 0i32;
  mut i = 0usize;
  mut j = n - 1usize;
  while i < n {
    a = a + (*simp[i * 4usize] * *simp[j * 4usize + 2usize] - *simp[j * 4usize] * *simp[i * 4usize + 2usize]);
    j = i;
    i = i + 1usize;
  }
  (a + 1i32) / 2i32;
}

// The contours of every region of the compact heightfield. Coordinates are
// in cells from the interior corner of the tile (the border taken off)
pub fn buildContours(c &CompactHF, maxError f32, maxEdgeLen i32) List[Contour] {
  imm w = c.w;
  imm h = c.h;
  imm bs = c.borderSize;
  mut out = List[Contour].empty();
  mut flags = List[i32].withCapacity(c.y.len());
  mut i = 0usize;
  while i < c.y.len() { flags.push(0i32); i = i + 1usize; }
  // a side is a boundary if the neighbour across it is in another region
  mut z = 0i32;
  while z < h {
    mut x = 0i32;
    while x < w {
      imm ci = *c.cellIndex[usize.from(z) * usize.from(w) + usize.from(x)];
      imm cn = *c.cellCount[usize.from(z) * usize.from(w) + usize.from(x)];
      mut k = ci;
      while k < ci + cn {
        imm ks = usize.from(k);
        imm r = *c.reg[ks];
        if r != 0i32 and (r & BorderReg) == 0i32 {
          mut res = 0i32;
          mut dir = 0i32;
          while dir < 4i32 {
            imm nb = c.neighbour(ks, x, z, dir);
            if nb >= 0i32 and *c.reg[usize.from(nb)] == r { res = res | (1i32 << dir); }
            dir = dir + 1i32;
          }
          flags.set(ks, res ^ 15i32);
        }
        k = k + 1i32;
      }
      x = x + 1i32;
    }
    z = z + 1i32;
  }
  mut pts = List[i32].empty();
  mut simp = List[i32].empty();
  z = 0i32;
  while z < h {
    mut x = 0i32;
    while x < w {
      imm ci = *c.cellIndex[usize.from(z) * usize.from(w) + usize.from(x)];
      imm cn = *c.cellCount[usize.from(z) * usize.from(w) + usize.from(x)];
      mut k = ci;
      while k < ci + cn {
        imm ks = usize.from(k);
        imm fl = *flags[ks];
        if fl == 0i32 or fl == 15i32 { flags.set(ks, 0i32); k = k + 1i32; continue; }
        imm r = *c.reg[ks];
        if r == 0i32 or (r & BorderReg) != 0i32 { k = k + 1i32; continue; }
        pts.clear();
        simp.clear();
        walkContour(c, x, z, ks, &mut flags, &mut pts);
        if pts.len() >= 12usize {
          simplifyContour(&pts, &mut simp, maxError, maxEdgeLen);
          removeDegenerateSegments(&mut simp);
        }
        if simp.len() >= 12usize and loopArea(&simp) > 0i32 {
          mut v = List[i32].withCapacity(simp.len());
          mut q = 0usize;
          while q < simp.len() {
            v.push(*simp[q] - bs);
            v.push(*simp[q + 1usize]);
            v.push(*simp[q + 2usize] - bs);
            v.push(*simp[q + 3usize]);
            q = q + 4usize;
          }
          out.push(new Contour(r, *c.area[ks], v));
        }
        k = k + 1i32;
      }
      x = x + 1i32;
    }
    z = z + 1i32;
  }
  out;
}
