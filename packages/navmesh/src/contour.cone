// ======== Contours: the outline of each region, simplified ========
//
// Recast's third stage (RecastContour.cpp). Each region's boundary is
// walked cell edge by cell edge into a closed loop of raw points (x, y, z
// of a cell corner, and the region on the other side of the edge), then
// simplified with Douglas-Peucker to within 'maxError' cells; points are kept
// wherever the neighbouring region changes, so that two regions that share an
// edge keep the same points on it, and a long wall edge is split to at most
// 'maxEdgeLen' cells. A point is four numbers in a flat list: x, y, z, and
// the flag word: the neighbour region (low 16 bits), AreaBorder (a change of
// area at the edge) and BorderVertex.

pub const AreaBorder i32 = 131072i32;       // 0x20000
pub const BorderVertex i32 = 65536i32;      // 0x10000
pub const RegMask i32 = 65535i32;

pub struct Contour {
  pub reg i32;
  pub area u8;
  pub verts List[i32];     // simplified, four numbers a point
}

fn cornerHeight(c &CompactHF, x i32, z i32, i usize, dir i32) CornerResult {
  let s = i;
  var ch = *c.y[s];
  let dirp = (dir + 1i32) & 3i32;
  var r0 = *c.reg[s] | (i32.from(*c.area[s]) << 16i32);
  var r1 = 0i32;
  var r2 = 0i32;
  var r3 = 0i32;
  let a = c.neighbour(s, x, z, dir);
  if a >= 0i32 {
    let ai = usize.from(a);
    ch = imax(ch, *c.y[ai]);
    r1 = *c.reg[ai] | (i32.from(*c.area[ai]) << 16i32);
    let a2 = c.neighbour(ai, x + dirX(dir), z + dirZ(dir), dirp);
    if a2 >= 0i32 {
      ch = imax(ch, *c.y[usize.from(a2)]);
      r2 = *c.reg[usize.from(a2)] | (i32.from(*c.area[usize.from(a2)]) << 16i32);
    }
  }
  let b = c.neighbour(s, x, z, dirp);
  if b >= 0i32 {
    let bi = usize.from(b);
    ch = imax(ch, *c.y[bi]);
    r3 = *c.reg[bi] | (i32.from(*c.area[bi]) << 16i32);
    let b2 = c.neighbour(bi, x + dirX(dirp), z + dirZ(dirp), dir);
    if b2 >= 0i32 {
      ch = imax(ch, *c.y[usize.from(b2)]);
      r2 = *c.reg[usize.from(b2)] | (i32.from(*c.area[usize.from(b2)]) << 16i32);
    }
  }
  // the vertex is a border vertex if two same exterior cells in a row are
  // followed by two interior cells, none of them out of bounds
  var border = false;
  var j = 0i32;
  while j < 4i32 {
    let ra = regAt(r0, r1, r2, r3, j);
    let rb = regAt(r0, r1, r2, r3, (j + 1i32) & 3i32);
    let rc = regAt(r0, r1, r2, r3, (j + 2i32) & 3i32);
    let rd = regAt(r0, r1, r2, r3, (j + 3i32) & 3i32);
    let twoSameExts = (ra & rb & BorderReg) != 0i32 && ra == rb;
    let twoInts = ((rc | rd) & BorderReg) == 0i32;
    let intsSameArea = (rc >> 16i32) == (rd >> 16i32);
    let noZeros = ra != 0i32 && rb != 0i32 && rc != 0i32 && rd != 0i32;
    if twoSameExts && twoInts && intsSameArea && noZeros { border = true; break; }
    j = j + 1i32;
  }
  new CornerResult(ch, border)
}

struct CornerResult {
  h i32;
  border bool;
}

fn regAt(r0 i32, r1 i32, r2 i32, r3 i32, j i32) i32 {
  if j == 0i32 { return r0; }
  if j == 1i32 { return r1; }
  if j == 2i32 { return r2; }
  r3
}

// Walk the boundary of the region starting at span 'i' of column (x, z)
fn walkContour(c &CompactHF, x0 i32, z0 i32, i0 usize, flags &mut List[i32], pts &mut List[i32]) {
  var x = x0;
  var z = z0;
  var i = i0;
  var dir = 0i32;
  while (*flags[i] & (1i32 << dir)) == 0i32 { dir = dir + 1i32; }
  let startDir = dir;
  let starti = i;
  let area = *c.area[i];
  var iter = 0i32;
  while iter < 40000i32 {
    iter = iter + 1i32;
    if (*flags[i] & (1i32 << dir)) != 0i32 {
      // an edge of the boundary: its corner
      var isAreaBorder = false;
      let cr = cornerHeight(c, x, z, i, dir);
      var px = x;
      let py = cr.h;
      var pz = z;
      if dir == 0i32 { pz = pz + 1i32; }
      if dir == 1i32 { px = px + 1i32; pz = pz + 1i32; }
      if dir == 2i32 { px = px + 1i32; }
      var r = 0i32;
      let nb = c.neighbour(i, x, z, dir);
      if nb >= 0i32 {
        r = *c.reg[usize.from(nb)];
        if area != *c.area[usize.from(nb)] { isAreaBorder = true; }
      }
      if cr.border { r = r | BorderVertex; }
      if isAreaBorder { r = r | AreaBorder; }
      pts.push(px); pts.push(py); pts.push(pz); pts.push(r);
      flags.set(i, *flags[i] & ~(1i32 << dir));
      dir = (dir + 1i32) & 3i32;
    } else {
      let ni = c.neighbour(i, x, z, dir);
      if ni < 0i32 { return; }
      x = x + dirX(dir);
      z = z + dirZ(dir);
      i = usize.from(ni);
      dir = (dir + 3i32) & 3i32;
    }
    if starti == i && startDir == dir { break; }
  }
}

fn distPtSegI(px i32, pz i32, ax i32, az i32, bx i32, bz i32) f32 {
  let pqx = f32.from(bx - ax);
  let pqz = f32.from(bz - az);
  let dx = f32.from(px - ax);
  let dz = f32.from(pz - az);
  let d = pqx * pqx + pqz * pqz;
  var t = pqx * dx + pqz * dz;
  if d > 0. { t = t / d; }
  if t < 0. { t = 0.; } elif t > 1. { t = 1.; }
  let ex = f32.from(ax) + t * pqx - f32.from(px);
  let ez = f32.from(az) + t * pqz - f32.from(pz);
  ex * ex + ez * ez
}

fn insertPoint(simp &mut List[i32], at usize, x i32, y i32, z i32, idx i32) {
  // a point inserted at position 'at' (counting points): grow, shift, set
  simp.push(0i32); simp.push(0i32); simp.push(0i32); simp.push(0i32);
  var j = simp.len() / 4usize - 1usize;
  while j > at {
    simp.set(j * 4usize, *simp[(j - 1usize) * 4usize]);
    simp.set(j * 4usize + 1usize, *simp[(j - 1usize) * 4usize + 1usize]);
    simp.set(j * 4usize + 2usize, *simp[(j - 1usize) * 4usize + 2usize]);
    simp.set(j * 4usize + 3usize, *simp[(j - 1usize) * 4usize + 3usize]);
    j = j - 1usize;
  }
  simp.set(at * 4usize, x);
  simp.set(at * 4usize + 1usize, y);
  simp.set(at * 4usize + 2usize, z);
  simp.set(at * 4usize + 3usize, idx);
}

fn simplifyContour(pts &List[i32], simp &mut List[i32], maxError f32, maxEdgeLen i32) {
  let pn = i32.from(pts.len() / 4usize);
  var hasConnections = false;
  var i = 0usize;
  while i < pts.len() {
    if (*pts[i + 3usize] & RegMask) != 0i32 { hasConnections = true; break; }
    i = i + 4usize;
  }
  if hasConnections {
    // a point wherever the region changes
    var a = 0i32;
    while a < pn {
      let b = (a + 1i32) % pn;
      let fa = *pts[usize.from(a) * 4usize + 3usize];
      let fb = *pts[usize.from(b) * 4usize + 3usize];
      let differentRegs = (fa & RegMask) != (fb & RegMask);
      let areaBorders = (fa & AreaBorder) != (fb & AreaBorder);
      if differentRegs || areaBorders {
        simp.push(*pts[usize.from(a) * 4usize]);
        simp.push(*pts[usize.from(a) * 4usize + 1usize]);
        simp.push(*pts[usize.from(a) * 4usize + 2usize]);
        simp.push(a);
      }
      a = a + 1i32;
    }
  }
  if simp.len() == 0usize {
    // no connections: begin from the lower-left and upper-right points
    var llx = *pts[0usize];
    var lly = *pts[1usize];
    var llz = *pts[2usize];
    var lli = 0i32;
    var urx = llx;
    var ury = lly;
    var urz = llz;
    var uri = 0i32;
    i = 0usize;
    while i < pts.len() {
      let x = *pts[i];
      let y = *pts[i + 1usize];
      let z = *pts[i + 2usize];
      if x < llx || (x == llx && z < llz) { llx = x; lly = y; llz = z; lli = i32.from(i / 4usize); }
      if x > urx || (x == urx && z > urz) { urx = x; ury = y; urz = z; uri = i32.from(i / 4usize); }
      i = i + 4usize;
    }
    simp.push(llx); simp.push(lly); simp.push(llz); simp.push(lli);
    simp.push(urx); simp.push(ury); simp.push(urz); simp.push(uri);
  }
  // add points until every raw point is within the error of the shape
  i = 0usize;
  while i < simp.len() / 4usize {
    let ii = (i + 1usize) % (simp.len() / 4usize);
    var ax = *simp[i * 4usize];
    var az = *simp[i * 4usize + 2usize];
    let ai = *simp[i * 4usize + 3usize];
    var bx = *simp[ii * 4usize];
    var bz = *simp[ii * 4usize + 2usize];
    let bi = *simp[ii * 4usize + 3usize];
    var maxd = 0.f;
    var maxi = -1i32;
    var ci = 0i32;
    var cinc = 0i32;
    var endi = 0i32;
    // walk the segment in lexicographic order so opposite segments agree
    if bx > ax || (bx == ax && bz > az) {
      cinc = 1i32;
      ci = (ai + cinc) % pn;
      endi = bi;
    } else {
      cinc = pn - 1i32;
      ci = (bi + cinc) % pn;
      endi = ai;
      let tx = ax; ax = bx; bx = tx;
      let tz = az; az = bz; bz = tz;
    }
    // only outer edges or edges between areas are tessellated
    let cf = *pts[usize.from(ci) * 4usize + 3usize];
    if (cf & RegMask) == 0i32 || (cf & AreaBorder) != 0i32 {
      while ci != endi {
        let d = distPtSegI(*pts[usize.from(ci) * 4usize], *pts[usize.from(ci) * 4usize + 2usize], ax, az, bx, bz);
        if d > maxd { maxd = d; maxi = ci; }
        ci = (ci + cinc) % pn;
      }
    }
    if maxi != -1i32 && maxd > maxError * maxError {
      insertPoint(simp, i + 1usize, *pts[usize.from(maxi) * 4usize], *pts[usize.from(maxi) * 4usize + 1usize], *pts[usize.from(maxi) * 4usize + 2usize], maxi);
    } else {
      i = i + 1usize;
    }
  }
  // split too long wall edges
  if maxEdgeLen > 0i32 {
    i = 0usize;
    while i < simp.len() / 4usize {
      let ii = (i + 1usize) % (simp.len() / 4usize);
      let ai = *simp[i * 4usize + 3usize];
      let bi = *simp[ii * 4usize + 3usize];
      let ax = *simp[i * 4usize];
      let az = *simp[i * 4usize + 2usize];
      let bx = *simp[ii * 4usize];
      let bz = *simp[ii * 4usize + 2usize];
      var maxi = -1i32;
      let ci = (ai + 1i32) % pn;
      let cf = *pts[usize.from(ci) * 4usize + 3usize];
      let tess = (cf & RegMask) == 0i32 || (cf & AreaBorder) != 0i32;
      if tess {
        let dx = bx - ax;
        let dz = bz - az;
        if dx * dx + dz * dz > maxEdgeLen * maxEdgeLen {
          let n = if bi < ai { bi + pn - ai } else { bi - ai };
          if n > 1i32 {
            if bx > ax || (bx == ax && bz > az) {
              maxi = (ai + n / 2i32) % pn;
            } else {
              maxi = (ai + (n + 1i32) / 2i32) % pn;
            }
          }
        }
      }
      if maxi != -1i32 {
        insertPoint(simp, i + 1usize, *pts[usize.from(maxi) * 4usize], *pts[usize.from(maxi) * 4usize + 1usize], *pts[usize.from(maxi) * 4usize + 2usize], maxi);
      } else {
        i = i + 1usize;
      }
    }
  }
  // the neighbour of the edge from point i is the flag of the raw point after
  // it, and its border-vertex flag is the raw point's own
  i = 0usize;
  while i < simp.len() / 4usize {
    let ai = (*simp[i * 4usize + 3usize] + 1i32) % pn;
    let bi = *simp[i * 4usize + 3usize];
    let f = (*pts[usize.from(ai) * 4usize + 3usize] & (RegMask | AreaBorder)) | (*pts[usize.from(bi) * 4usize + 3usize] & BorderVertex);
    simp.set(i * 4usize + 3usize, f);
    i = i + 1usize;
  }
}

fn removeDegenerateSegments(simp &mut List[i32]) {
  var npts = simp.len() / 4usize;
  var i = 0usize;
  while i < npts {
    let ni = (i + 1usize) % npts;
    if *simp[i * 4usize] == *simp[ni * 4usize] && *simp[i * 4usize + 2usize] == *simp[ni * 4usize + 2usize] {
      var j = i;
      while j < simp.len() / 4usize - 1usize {
        simp.set(j * 4usize, *simp[(j + 1usize) * 4usize]);
        simp.set(j * 4usize + 1usize, *simp[(j + 1usize) * 4usize + 1usize]);
        simp.set(j * 4usize + 2usize, *simp[(j + 1usize) * 4usize + 2usize]);
        simp.set(j * 4usize + 3usize, *simp[(j + 1usize) * 4usize + 3usize]);
        j = j + 1usize;
      }
      simp.truncate(simp.len() - 4usize);
      npts = npts - 1usize;
    }
    i = i + 1usize;
  }
}

// Twice the signed area of a closed loop in x and z (negative: a hole)
fn loopArea(simp &List[i32]) i32 {
  let n = simp.len() / 4usize;
  var a = 0i32;
  var i = 0usize;
  var j = n - 1usize;
  while i < n {
    a = a + (*simp[i * 4usize] * *simp[j * 4usize + 2usize] - *simp[j * 4usize] * *simp[i * 4usize + 2usize]);
    j = i;
    i = i + 1usize;
  }
  (a + 1i32) / 2i32
}

// The contours of every region of the compact heightfield. Coordinates are
// in cells from the interior corner of the tile (the border taken off)
pub fn buildContours(c &CompactHF, maxError f32, maxEdgeLen i32) List[Contour] {
  let w = c.w;
  let h = c.h;
  let bs = c.borderSize;
  var out = List[Contour].empty();
  var flags = List[i32].withCapacity(c.y.len());
  var i = 0usize;
  while i < c.y.len() { flags.push(0i32); i = i + 1usize; }
  // a side is a boundary if the neighbour across it is in another region
  var z = 0i32;
  while z < h {
    var x = 0i32;
    while x < w {
      let ci = *c.cellIndex[usize.from(z) * usize.from(w) + usize.from(x)];
      let cn = *c.cellCount[usize.from(z) * usize.from(w) + usize.from(x)];
      var k = ci;
      while k < ci + cn {
        let ks = usize.from(k);
        let r = *c.reg[ks];
        if r != 0i32 && (r & BorderReg) == 0i32 {
          var res = 0i32;
          var dir = 0i32;
          while dir < 4i32 {
            let nb = c.neighbour(ks, x, z, dir);
            if nb >= 0i32 && *c.reg[usize.from(nb)] == r { res = res | (1i32 << dir); }
            dir = dir + 1i32;
          }
          flags.set(ks, res ^ 15i32);
        }
        k = k + 1i32;
      }
      x = x + 1i32;
    }
    z = z + 1i32;
  }
  var pts = List[i32].empty();
  var simp = List[i32].empty();
  z = 0i32;
  while z < h {
    var x = 0i32;
    while x < w {
      let ci = *c.cellIndex[usize.from(z) * usize.from(w) + usize.from(x)];
      let cn = *c.cellCount[usize.from(z) * usize.from(w) + usize.from(x)];
      var k = ci;
      while k < ci + cn {
        let ks = usize.from(k);
        let fl = *flags[ks];
        if fl == 0i32 || fl == 15i32 { flags.set(ks, 0i32); k = k + 1i32; continue; }
        let r = *c.reg[ks];
        if r == 0i32 || (r & BorderReg) != 0i32 { k = k + 1i32; continue; }
        pts.clear();
        simp.clear();
        walkContour(c, x, z, ks, &mut flags, &mut pts);
        if pts.len() >= 12usize {
          simplifyContour(&pts, &mut simp, maxError, maxEdgeLen);
          removeDegenerateSegments(&mut simp);
        }
        if simp.len() >= 12usize && loopArea(&simp) > 0i32 {
          var v = List[i32].withCapacity(simp.len());
          var q = 0usize;
          while q < simp.len() {
            v.push(*simp[q] - bs);
            v.push(*simp[q + 1usize]);
            v.push(*simp[q + 2usize] - bs);
            v.push(*simp[q + 3usize]);
            q = q + 4usize;
          }
          out.push(new Contour(r, *c.area[ks], v));
        }
        k = k + 1i32;
      }
      x = x + 1i32;
    }
    z = z + 1i32;
  }
  out
}
