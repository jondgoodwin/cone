// Small scalar helpers the build and the queries share.

fn floorf(x f32) f32 inline { libc.floorf(x) }
fn ceilf(x f32) f32 inline { libc.ceilf(x) }
fn absf(x f32) f32 inline { if x < 0. { return -x; } x }
fn fmin(a f32, b f32) f32 inline { if a < b { return a; } b }
fn fmax(a f32, b f32) f32 inline { if a > b { return a; } b }
fn fclamp(v f32, lo f32, hi f32) f32 inline { if v < lo { return lo; } if v > hi { return hi; } v }
fn imin(a i32, b i32) i32 inline { if a < b { return a; } b }
fn imax(a i32, b i32) i32 inline { if a > b { return a; } b }
fn iabs(a i32) i32 inline { if a < 0i32 { return -a; } a }
fn iclamp(v i32, lo i32, hi i32) i32 inline { if v < lo { return lo; } if v > hi { return hi; } v }
fn sqf(x f32) f32 inline { x * x }

// The squared distance in x and z from point p to the segment a-b, and the
// parameter of the closest point
pub struct SegDist {
  pub d2 f32;
  pub t f32;
}

fn distPtSegXZ(p Vec3, a Vec3, b Vec3) SegDist {
  let dx = b.x - a.x;
  let dz = b.z - a.z;
  let d = dx * dx + dz * dz;
  var t = 0.;
  if d > 0. { t = ((p.x - a.x) * dx + (p.z - a.z) * dz) / d; }
  t = fclamp(t, 0., 1.);
  let ex = a.x + t * dx - p.x;
  let ez = a.z + t * dz - p.z;
  new SegDist(ex * ex + ez * ez, t)
}
