// ======== Tiles and the navigation mesh ========
//
// Detour's data model (dtNavMesh, in a simpler form): the world is cut
// into square tiles of 'tileSize' cells, each built alone from the input
// (with a border of 'borderSize' cells round it, so that what is near its
// edge is eroded and connected as it would be in one piece), so that one tile
// can be rebuilt when something in it changes. A tile holds convex polygons
// (at most six vertices), with, for each edge, the polygon beyond it in the
// tile or the number of a side where it leaves the tile (a portal). A
// polygon is named by a 'PolyRef' (u64): salt, tile and polygon number;
// rebuilding a tile gives it a new salt, so a reference into the old
// tile is seen to be stale ('NavMesh.isValid').
//
// Links join polygons: the polygons beyond each edge in the tile, and across
// a portal the polygons of the neighbouring tile whose portal edges overlap
// it (heights within twice the climb). A tile's links are recomputed from
// scratch whenever it or a neighbour is built. Off-mesh connections (a door,
// a ladder, a jump) are kept beside the tiles, each joining the polygons nearest
// its two ends; they can be switched on and off while the program runs.
//
// Winding: the vertices of a polygon go the way Recast's contours do: seen
// from above (+y towards the viewer, x to the right, so z runs down the
// page), counterclockwise; the outward normal of an edge from a to b is
// (-(b.z - a.z), (b.x - a.x)) in x and z.

pub const NoRef: u64 = 0u64;

pub struct Link {
  pub to: u64;          // the polygon beyond
  pub edge: i32;        // the edge of this polygon it is through
  pub side: i32;        // -1 inside the tile; else the side of the tile it crosses
  pub tmin: f32;        // across a portal: the part of the edge (0 to 1 from its first vertex) that overlaps
  pub tmax: f32;
}

pub struct Tile {
  pub tx: i32;
  pub tz: i32;
  pub salt: u32;
  pub built: bool;
  pub verts: List[Vec3];
  pub pverts: List[i32];      // MaxVerts a polygon, -1 after the last
  pub pnei: List[i32];        // MaxVerts a polygon: neighbour polygon, -1, or PortalFlag | side
  pub pcount: List[i32];
  pub parea: List[u8];
  pub pbmin: List[Vec3];
  pub pbmax: List[Vec3];
  pub linkStart: List[i32];   // polyCount + 1 offsets into 'links'
  pub links: List[Link];

  pub fn empty(tx: i32, tz: i32) Tile {
    Tile(tx, tz, 0u32, false, List[Vec3].empty(), List[i32].empty(), List[i32].empty(), List[i32].empty(),
      List[u8].empty(), List[Vec3].empty(), List[Vec3].empty(), List[i32].empty(), List[Link].empty())
  }

  pub fn polyCount(self: &) usize { pcount.len() }
  pub fn vertOf(self: &, p: usize, k: usize) Vec3 { *verts[usize.from(*pverts[p * 6usize + k])] }
}

pub struct OffMeshConn {
  pub id: u32;
  pub a: Vec3;
  pub b: Vec3;
  pub radius: f32;
  pub bidirectional: bool;
  pub area: u8;
  pub enabled: bool;
  pub refA: u64;        // the polygons nearest its ends, NoRef when there is none
  pub refB: u64;
  pub posA: Vec3;       // the points on the mesh its ends meet
  pub posB: Vec3;
}

pub struct NavMesh {
  pub params: NavParams;
  pub origin: Vec3;       // the corner of tile (0, 0): lowest x, y and z of the input
  pub yRange: f32;
  pub tilesW: i32;
  pub tilesH: i32;
  pub tiles: List[Tile];
  pub off: List[OffMeshConn];
  pub nextOffId: u32;

  pub fn tileWorld(self: &) f32 { f32.from(params.tileSize) * params.cellSize }

  pub fn tileIndex(self: &, tx: i32, tz: i32) i32 {
    if tx < 0i32 || tz < 0i32 || tx >= tilesW || tz >= tilesH { return -1i32; }
    tz * tilesW + tx
  }

  // The reference of polygon p of tile index t
  pub fn makeRef(self: &, t: i32, p: usize) u64 {
    let tile = tiles[usize.from(t)];
    (u64.from(tile.salt) << 32u64) | (u64.from(t) << 16u64) | u64.from(p)
  }

  pub fn refTile(self: &, r: u64) i32 { i32.from((r >> 16u64) & 65535u64) }
  pub fn refPoly(self: &, r: u64) usize { usize.from(r & 65535u64) }

  // Whether 'r' names a polygon that still exists
  pub fn isValid(self: &, r: u64) bool {
    if r == NoRef { return false; }
    let t = self.refTile(r);
    if t < 0i32 || usize.from(t) >= tiles.len() { return false; }
    let tile = tiles[usize.from(t)];
    if !tile.built || u64.from(tile.salt) != (r >> 32u64) { return false; }
    self.refPoly(r) < tile.polyCount()
  }

  pub fn polyArea(self: &, r: u64) u8 {
    (*tiles[usize.from(self.refTile(r))].parea[self.refPoly(r)])
  }

  pub fn polyVertCount(self: &, r: u64) usize {
    usize.from(*tiles[usize.from(self.refTile(r))].pcount[self.refPoly(r)])
  }

  pub fn polyVert(self: &, r: u64, k: usize) Vec3 {
    tiles[usize.from(self.refTile(r))].vertOf(self.refPoly(r), k)
  }

  pub fn polyCount(self: &) usize {
    var n = 0usize;
    var i = 0usize;
    while i < tiles.len() { n = n + tiles[i].polyCount(); i = i + 1usize; }
    n
  }

  pub fn tileCoordOf(self: &, x: f32, z: f32) Vec2 {
    let tw = self.tileWorld();
    Vec2(floorf((x - origin.x) / tw), floorf((z - origin.z) / tw))
  }
}

// ---- building ----

fn triNormalY(a: Vec3, b: Vec3, c: Vec3) f32 {
  let e0 = b - a;
  let e1 = c - a;
  let n = e0.cross(e1);
  let l = n.length();
  if l <= 0. { return 0.; }
  n.y / l
}

// Build, from 'input', the tile (tx, tz) into a Tile (not yet linked)
pub fn buildTile(nav: &NavMesh, input: &NavInput, tx: i32, tz: i32) Tile {
  let p = nav.params;
  let bs = p.borderSize();
  let size = p.tileSize + 2i32 * bs;
  let cs = p.cellSize;
  let ch = p.cellHeight;
  let bmin = Vec3(nav.origin.x + f32.from(tx * p.tileSize - bs) * cs, nav.origin.y, nav.origin.z + f32.from(tz * p.tileSize - bs) * cs);
  let wx1 = bmin.x + f32.from(size) * cs;
  let wz1 = bmin.z + f32.from(size) * cs;
  var hf = Heightfield.make(size, size, bmin, nav.yRange, cs, ch);
  let climb = p.walkableClimb();
  let walkThr = cos(p.agentMaxSlope);
  var sc = RasterScratch.make();
  var t = 0usize;
  let ntri = input.tris.len() / 3usize;
  while t < ntri {
    let a = *input.verts[usize.from(*input.tris[t * 3usize])];
    let b = *input.verts[usize.from(*input.tris[t * 3usize + 1usize])];
    let c = *input.verts[usize.from(*input.tris[t * 3usize + 2usize])];
    let lo = a.min(b).min(c);
    let hi = a.max(b).max(c);
    if hi.x >= bmin.x && lo.x <= wx1 && hi.z >= bmin.z && lo.z <= wz1 {
      var area = *input.triArea[t];
      if area != AreaNull && triNormalY(a, b, c) <= walkThr { area = AreaNull; }
      rasterizeTriangle(&mut hf, a, b, c, area, climb, &mut sc);
    }
    t = t + 1usize;
  }
  var o = 0usize;
  while o < input.obstacles.len() {
    let ob = input.obstacles[o];
    if ob.enabled && ob.area == AreaNull {
      let e = ob.extent();
      if e.z >= bmin.x && e.x <= wx1 && e.w >= bmin.z && e.y <= wz1 {
        rasterizeObstacle(&mut hf, ob, climb);
      }
    }
    o = o + 1usize;
  }
  filterLowHangingObstacles(&mut hf, climb);
  filterLedgeSpans(&mut hf, p.walkableHeight(), climb);
  filterLowHeightSpans(&mut hf, p.walkableHeight());
  var chf = buildCompact(&hf, p.walkableHeight(), climb, bs);
  erodeWalkableArea(&mut chf, p.walkableRadius());
  o = 0usize;
  while o < input.obstacles.len() {
    let ob = input.obstacles[o];
    if ob.enabled && ob.area != AreaNull {
      let e = ob.extent();
      if e.z >= bmin.x && e.x <= wx1 && e.w >= bmin.z && e.y <= wz1 { markObstacleArea(&mut chf, ob); }
    }
    o = o + 1usize;
  }
  buildRegionsMonotone(&mut chf, p.minRegionArea);
  let contours = buildContours(&chf, p.maxSimplifyError, i32.from(p.maxEdgeLen));
  let pm = buildPolyMesh(&contours, p.tileSize, p.tileSize);
  tileFromMesh(nav, &pm, tx, tz)
}

fn tileFromMesh(nav: &NavMesh, pm: &PolyMesh, tx: i32, tz: i32) Tile {
  let p = nav.params;
  var tile = Tile.empty(tx, tz);
  let ox = nav.origin.x + f32.from(tx * p.tileSize) * p.cellSize;
  let oz = nav.origin.z + f32.from(tz * p.tileSize) * p.cellSize;
  var i = 0usize;
  while i < pm.vertCount() {
    tile.verts.push(Vec3(ox + f32.from(*pm.verts[i * 3usize]) * p.cellSize,
      nav.origin.y + f32.from(*pm.verts[i * 3usize + 1usize]) * p.cellHeight,
      oz + f32.from(*pm.verts[i * 3usize + 2usize]) * p.cellSize));
    i = i + 1usize;
  }
  let nvp = usize.from(MaxVerts);
  var q = 0usize;
  while q < pm.polyCount() {
    var n = 0i32;
    var lo = Vec3(3.4e38, 3.4e38, 3.4e38);
    var hi = Vec3(-3.4e38, -3.4e38, -3.4e38);
    var k = 0usize;
    while k < nvp {
      let v = *pm.polys[q * nvp * 2usize + k];
      tile.pverts.push(v);
      tile.pnei.push(*pm.polys[q * nvp * 2usize + nvp + k]);
      if v >= 0i32 {
        n = n + 1i32;
        lo = lo.min(*tile.verts[usize.from(v)]);
        hi = hi.max(*tile.verts[usize.from(v)]);
      }
      k = k + 1usize;
    }
    tile.pcount.push(n);
    tile.parea.push(*pm.areas[q]);
    tile.pbmin.push(lo);
    tile.pbmax.push(hi);
    q = q + 1usize;
  }
  tile.built = true;
  tile
}

// The tile's links, recomputed from the tile and its built neighbours
pub fn connectTile(nav: &mut NavMesh, t: i32) {
  let ti = usize.from(t);
  let np = nav.tiles[ti].polyCount();
  var starts = List[i32].withCapacity(np + 1usize);
  var links = List[Link].empty();
  let tx = nav.tiles[ti].tx;
  let tz = nav.tiles[ti].tz;
  let climb2 = nav.params.agentMaxClimb * 2.;
  var p = 0usize;
  while p < np {
    starts.push(i32.from(links.len()));
    let nv = usize.from(*nav.tiles[ti].pcount[p]);
    var e = 0usize;
    while e < nv {
      let nei = *nav.tiles[ti].pnei[p * 6usize + e];
      if nei >= 0i32 && nei < PortalFlag {
        links.push(Link(nav.makeRef(t, usize.from(nei)), i32.from(e), -1i32, 0., 1.));
      } elif nei >= PortalFlag {
        let side = nei & 7i32;
        let nt = nav.tileIndex(tx + dirX(side), tz + dirZ(side));
        if nt >= 0i32 && nav.tiles[usize.from(nt)].built {
          let va = nav.tiles[ti].vertOf(p, e);
          let vb = nav.tiles[ti].vertOf(p, (e + 1usize) % nv);
          let opp = (side + 2i32) & 3i32;
          let other = usize.from(nt);
          let nq = nav.tiles[other].polyCount();
          var q = 0usize;
          while q < nq {
            let qn = usize.from(*nav.tiles[other].pcount[q]);
            var f = 0usize;
            while f < qn {
              if *nav.tiles[other].pnei[q * 6usize + f] == (PortalFlag | opp) {
                let wa = nav.tiles[other].vertOf(q, f);
                let wb = nav.tiles[other].vertOf(q, (f + 1usize) % qn);
                // the overlap, along z for a side facing x, along x for z
                let alongZ = side == 0i32 || side == 2i32;
                let a0 = if alongZ { va.z } else { va.x };
                let a1 = if alongZ { vb.z } else { vb.x };
                let b0 = if alongZ { wa.z } else { wa.x };
                let b1 = if alongZ { wb.z } else { wb.x };
                let amin = fmin(a0, a1);
                let amax = fmax(a0, a1);
                let bmn = fmin(b0, b1);
                let bmx = fmax(b0, b1);
                let lo = fmax(amin, bmn);
                let hi = fmin(amax, bmx);
                if hi - lo > 0.01 {
                  // heights of both edges at the ends of the overlap
                  let ya0 = edgeHeightAt(va, vb, alongZ, lo);
                  let ya1 = edgeHeightAt(va, vb, alongZ, hi);
                  let yb0 = edgeHeightAt(wa, wb, alongZ, lo);
                  let yb1 = edgeHeightAt(wa, wb, alongZ, hi);
                  let d0 = ya0 - yb0;
                  let d1 = ya1 - yb1;
                  if !(d0 * d0 > climb2 * climb2 && d1 * d1 > climb2 * climb2) {
                    // as fractions along our edge from its first vertex
                    var t0 = 0.f;
                    var t1 = 1.f;
                    if a1 != a0 {
                      t0 = (lo - a0) / (a1 - a0);
                      t1 = (hi - a0) / (a1 - a0);
                    }
                    links.push(Link(nav.makeRef(nt, q), i32.from(e), side, fmin(t0, t1), fmax(t0, t1)));
                  }
                }
              }
              f = f + 1usize;
            }
            q = q + 1usize;
          }
        }
      }
      e = e + 1usize;
    }
    p = p + 1usize;
  }
  starts.push(i32.from(links.len()));
  nav.tiles[ti].linkStart = starts;
  nav.tiles[ti].links = links;
}

fn edgeHeightAt(a: Vec3, b: Vec3, alongZ: bool, at: f32) f32 {
  let a0 = if alongZ { a.z } else { a.x };
  let a1 = if alongZ { b.z } else { b.x };
  if a1 == a0 { return (a.y + b.y) * 0.5; }
  let t = fclamp((at - a0) / (a1 - a0), 0., 1.);
  a.y + (b.y - a.y) * t
}

