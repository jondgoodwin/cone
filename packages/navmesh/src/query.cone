// ======== Queries: nearest point, A*, the funnel, raycast, moving along the surface ========
//
// Detour's dtNavMeshQuery (Mikko Mononen, recastnavigation), written again in
// Cone: 'findPath' is A* over the graph of polygons (a node is a polygon,
// positioned at the midpoint of the edge it was entered by, the first
// start position at the start; the cost of a step is the distance between the
// two positions times the cost of the area of the polygon crossed;
// the heuristic is the straight distance times 0.999), 'findStraightPath' is
// the "simple stupid funnel algorithm" over the portals of that path
// (Mononen 2010, after Lee and Preparata 1984), 'raycast' walks a segment
// through the polygons it crosses, 'moveAlongSurface' slides a point along
// walls.

pub const StraightStart: u8 = 1u8;
pub const StraightEnd: u8 = 2u8;
pub const StraightOffMesh: u8 = 4u8;

// What a query may walk on and what it costs. An area is walkable when its
// bit is in 'allow' and not in 'deny'; the cost of walking a distance
// in an area is the distance times its cost. Toggling a door area here
// needs no rebuild: the next query sees it
pub struct QueryFilter {
  pub allow: u32;
  pub deny: u32;
  pub cost: List[f32];     // sixteen areas

  pub fn standard() QueryFilter {
    var f = QueryFilter(65535u32, 0u32, List[f32].withCapacity(16usize));
    var i = 0usize;
    while i < 16usize { f.cost.push(1.); i = i + 1usize; }
    f
  }

  pub fn passable(self: &, area: u8) bool {
    if area == AreaNull { return false; }
    let bit = 1u32 << u32.from(area);
    (allow & bit) != 0u32 && (deny & bit) == 0u32
  }

  pub fn setCost(self: &mut, area: u8, c: f32) { cost.set(usize.from(area), c); }
  pub fn areaCost(self: &, area: u8) f32 { *cost[usize.from(area)] }

  // Let queries through an area, or not
  pub fn setPassable(self: &mut, area: u8, ok: bool) {
    let bit = 1u32 << u32.from(area);
    if ok { deny = deny & ~bit; } else { deny = deny | bit; }
  }
}

// ---- geometry in x and z ----

fn triArea2D(a: Vec3, b: Vec3, c: Vec3) f32 inline {
  let ax = b.x - a.x;
  let az = b.z - a.z;
  let bx = c.x - a.x;
  let bz = c.z - a.z;
  bx * az - ax * bz
}

fn dist2D(a: Vec3, b: Vec3) f32 inline {
  let dx = b.x - a.x;
  let dz = b.z - a.z;
  (dx * dx + dz * dz).sqrt()
}

fn polyPointInside(tile: &Tile, p: usize, pos: Vec3) bool {
  let nv = usize.from(*tile.pcount[p]);
  var c = false;
  var i = 0usize;
  var j = nv - 1usize;
  while i < nv {
    let vi = tile.vertOf(p, i);
    let vj = tile.vertOf(p, j);
    if (vi.z > pos.z) != (vj.z > pos.z) {
      if pos.x < (vj.x - vi.x) * (pos.z - vi.z) / (vj.z - vi.z) + vi.x { c = !c; }
    }
    j = i;
    i = i + 1usize;
  }
  c
}

// The height of a polygon's surface at (x, z), by the triangle fan from its
// first vertex; false when (x, z) is in none
pub struct HeightHit {
  pub ok: bool;
  pub y: f32;
}

fn polyHeight(tile: &Tile, p: usize, x: f32, z: f32) HeightHit {
  let nv = usize.from(*tile.pcount[p]);
  let v0 = tile.vertOf(p, 0usize);
  var k = 1usize;
  while k + 1usize < nv {
    let v1 = tile.vertOf(p, k);
    let v2 = tile.vertOf(p, k + 1usize);
    // barycentric in x and z
    let d00x = v1.x - v0.x; let d00z = v1.z - v0.z;
    let d01x = v2.x - v0.x; let d01z = v2.z - v0.z;
    let px = x - v0.x; let pz = z - v0.z;
    let den = d00x * d01z - d00z * d01x;
    if absf(den) > 0.0000001 {
      let u = (px * d01z - pz * d01x) / den;
      let v = (d00x * pz - d00z * px) / den;
      let e = 0.0001f;
      if u >= -e && v >= -e && u + v <= 1. + e {
        return HeightHit(true, v0.y + (v1.y - v0.y) * u + (v2.y - v0.y) * v);
      }
    }
    k = k + 1usize;
  }
  HeightHit(false, 0.)
}

pub struct ClosestPoint {
  pub pos: Vec3;
  pub over: bool;       // the point is above or below the polygon (inside it in x and z)
}

// The closest point of the polygon to 'pos': straight above or below when
// pos is over it, else on its boundary
fn closestOnPoly(tile: &Tile, p: usize, pos: Vec3) ClosestPoint {
  if polyPointInside(tile, p, pos) {
    let h = polyHeight(tile, p, pos.x, pos.z);
    if h.ok { return ClosestPoint(Vec3(pos.x, h.y, pos.z), true); }
  }
  let nv = usize.from(*tile.pcount[p]);
  var best = 3.4e38f;
  var bp = pos;
  var i = 0usize;
  var j = nv - 1usize;
  while i < nv {
    let vi = tile.vertOf(p, i);
    let vj = tile.vertOf(p, j);
    let sd = distPtSegXZ(pos, vj, vi);
    if sd.d2 < best {
      best = sd.d2;
      bp = vj.lerp(vi, sd.t);
    }
    j = i;
    i = i + 1usize;
  }
  ClosestPoint(bp, false)
}

pub struct Nearest {
  pub found: bool;
  pub ref: u64;
  pub pos: Vec3;
}

// The polygon nearest 'center' within the box of half extents (hx, hy, hz)
// whatever its area
pub fn nearestPolyRaw(nav: &NavMesh, center: Vec3, hx: f32, hy: f32, hz: f32) Nearest {
  var best = Nearest(false, NoRef, center);
  var bestD = 3.4e38;
  let tw = nav.tileWorld();
  let tx0 = imax(0i32, i32.from(floorf((center.x - hx - nav.origin.x) / tw)));
  let tx1 = imin(nav.tilesW - 1i32, i32.from(floorf((center.x + hx - nav.origin.x) / tw)));
  let tz0 = imax(0i32, i32.from(floorf((center.z - hz - nav.origin.z) / tw)));
  let tz1 = imin(nav.tilesH - 1i32, i32.from(floorf((center.z + hz - nav.origin.z) / tw)));
  var tz = tz0;
  while tz <= tz1 {
    var tx = tx0;
    while tx <= tx1 {
      let ti = tz * nav.tilesW + tx;
      let tile = nav.tiles[usize.from(ti)];
      if tile.built {
        var p = 0usize;
        while p < tile.polyCount() {
          let lo = *tile.pbmin[p];
          let hi = *tile.pbmax[p];
          if hi.x >= center.x - hx && lo.x <= center.x + hx && hi.y >= center.y - hy && lo.y <= center.y + hy
             && hi.z >= center.z - hz && lo.z <= center.z + hz {
            let cp = closestOnPoly(tile, p, center);
            var d = 0.;
            if cp.over {
              // straight above or below: how far beyond the climb
              d = absf(center.y - cp.pos.y) - nav.params.agentMaxClimb;
              d = if d > 0. { d * d } else { 0. };
            } else {
              d = (cp.pos - center).lengthSquared();
            }
            if d < bestD {
              bestD = d;
              best = Nearest(true, nav.makeRef(ti, p), cp.pos);
            }
          }
          p = p + 1usize;
        }
      }
      tx = tx + 1i32;
    }
    tz = tz + 1i32;
  }
  best
}

// As above, but only polygons the filter lets through
pub fn findNearestPoly(nav: &NavMesh, center: Vec3, hx: f32, hy: f32, hz: f32, filter: &QueryFilter) Nearest {
  var best = Nearest(false, NoRef, center);
  var bestD = 3.4e38;
  let tw = nav.tileWorld();
  let tx0 = imax(0i32, i32.from(floorf((center.x - hx - nav.origin.x) / tw)));
  let tx1 = imin(nav.tilesW - 1i32, i32.from(floorf((center.x + hx - nav.origin.x) / tw)));
  let tz0 = imax(0i32, i32.from(floorf((center.z - hz - nav.origin.z) / tw)));
  let tz1 = imin(nav.tilesH - 1i32, i32.from(floorf((center.z + hz - nav.origin.z) / tw)));
  var tz = tz0;
  while tz <= tz1 {
    var tx = tx0;
    while tx <= tx1 {
      let ti = tz * nav.tilesW + tx;
      let tile = nav.tiles[usize.from(ti)];
      if tile.built {
        var p = 0usize;
        while p < tile.polyCount() {
          let lo = *tile.pbmin[p];
          let hi = *tile.pbmax[p];
          if filter.passable(*tile.parea[p]) && hi.x >= center.x - hx && lo.x <= center.x + hx
             && hi.y >= center.y - hy && lo.y <= center.y + hy && hi.z >= center.z - hz && lo.z <= center.z + hz {
            let cp = closestOnPoly(tile, p, center);
            var d = 0.;
            if cp.over {
              d = absf(center.y - cp.pos.y) - nav.params.agentMaxClimb;
              d = if d > 0. { d * d } else { 0. };
            } else {
              d = (cp.pos - center).lengthSquared();
            }
            if d < bestD {
              bestD = d;
              best = Nearest(true, nav.makeRef(ti, p), cp.pos);
            }
          }
          p = p + 1usize;
        }
      }
      tx = tx + 1i32;
    }
    tz = tz + 1i32;
  }
  best
}

// The closest point of polygon 'r' to 'pos'
pub fn closestPointOnPoly(nav: &NavMesh, r: u64, pos: Vec3) ClosestPoint {
  closestOnPoly(nav.tiles[usize.from(nav.refTile(r))], nav.refPoly(r), pos)
}

// The point of polygon 'r' straight above or below 'pos' with its height, if it is inside
pub fn polyHeightAt(nav: &NavMesh, r: u64, pos: Vec3) HeightHit {
  polyHeight(nav.tiles[usize.from(nav.refTile(r))], nav.refPoly(r), pos.x, pos.z)
}

// ---- links ----

pub struct Portal {
  pub left: Vec3;
  pub right: Vec3;
  pub off: bool;     // the move is through an off-mesh connection: a point
  pub to: u64;       // the polygon entered
}

// Where polygon 'from' joins polygon 'to': the edge's two ends, narrowed to
// the overlap across a tile's portal. found false when no link joins them
pub struct PortalFound {
  pub ok: bool;
  pub left: Vec3;
  pub right: Vec3;
  pub off: bool;
  pub conn: i32;      // the off-mesh connection used, -1
}

fn offMeshBetween(nav: &NavMesh, from: u64, to: u64) i32 {
  var i = 0usize;
  while i < nav.off.len() {
    let c = nav.off[i];
    if c.enabled {
      if c.refA == from && c.refB == to { return i32.from(i); }
      if c.bidirectional && c.refB == from && c.refA == to { return i32.from(i); }
    }
    i = i + 1usize;
  }
  -1i32
}

pub fn getPortal(nav: &NavMesh, from: u64, to: u64) PortalFound {
  let tile = nav.tiles[usize.from(nav.refTile(from))];
  let p = nav.refPoly(from);
  let nv = usize.from(*tile.pcount[p]);
  var k = *tile.linkStart[p];
  while k < *tile.linkStart[p + 1usize] {
    let l = tile.links[usize.from(k)];
    if l.to == to {
      let v0 = tile.vertOf(p, usize.from(l.edge));
      let v1 = tile.vertOf(p, (usize.from(l.edge) + 1usize) % nv);
      if l.side >= 0i32 && (l.tmin > 0. || l.tmax < 1.) {
        return PortalFound(true, v0.lerp(v1, l.tmin), v0.lerp(v1, l.tmax), false, -1i32);
      }
      return PortalFound(true, v0, v1, false, -1i32);
    }
    k = k + 1i32;
  }
  let oc = offMeshBetween(nav, from, to);
  if oc >= 0i32 {
    let c = nav.off[usize.from(oc)];
    return PortalFound(true, c.posA, c.posB, true, oc);
  }
  PortalFound(false, Vec3(0., 0., 0.), Vec3(0., 0., 0.), false, -1i32)
}

// ---- A* ----

pub struct PathResult {
  pub found: bool;          // a path to the end polygon
  pub partial: bool;        // only as near to the end as the mesh gets
  pub polys: List[u64];
  pub cost: f32;

  pub fn none() PathResult { PathResult(false, false, List[u64].empty(), 0.) }
}

struct Node {
  pos: Vec3;
  cost: f32;
  total: f32;
  parent: i32;
  ref: u64;
  closed: bool;
}

// The cheapest path of polygons from the one holding 'startPos' to the one
// holding 'endPos' (A*, Hart, Nilsson and Raphael 1968). If the end cannot
// be reached, the path goes as near it as it can, 'partial'
pub fn findPath(nav: &NavMesh, startRef: u64, endRef: u64, startPos: Vec3, endPos: Vec3, filter: &QueryFilter) PathResult {
  var res = PathResult.none();
  if !nav.isValid(startRef) || !nav.isValid(endRef) { return res; }
  if startRef == endRef {
    res.found = true;
    res.polys.push(startRef);
    res.cost = dist2D(startPos, endPos) * filter.areaCost(nav.polyArea(startRef));
    return res;
  }
  var nodes = List[Node].empty();
  var index = Dict[u64, i32].empty();
  var open = MinHeap.empty();
  let hScale = 0.999f;
  nodes.push(Node(startPos, 0., startPos.distance(endPos) * hScale, -1i32, startRef, false));
  index.insert(startRef, 0i32);
  open.push((*nodes[0usize]).total, 0u32);
  var lastBest = 0i32;
  var lastBestH = startPos.distance(endPos) * hScale;
  var endNode = -1i32;
  while !open.isEmpty() {
    let top = open.pop();
    let ci = usize.from(top.id);
    if (*nodes[ci]).closed { continue; }
    nodes.set(ci, Node((*nodes[ci]).pos, (*nodes[ci]).cost, (*nodes[ci]).total, (*nodes[ci]).parent, (*nodes[ci]).ref, true));
    let cur = *nodes[ci];
    if cur.ref == endRef { endNode = i32.from(ci); break; }
    let tile = nav.tiles[usize.from(nav.refTile(cur.ref))];
    let cp = nav.refPoly(cur.ref);
    let curArea = *tile.parea[cp];
    let nv = usize.from(*tile.pcount[cp]);
    // the polygons beyond: tile links, then off-mesh connections
    var k = *tile.linkStart[cp];
    let kend = *tile.linkStart[cp + 1usize];
    let noff = nav.off.len();
    var oi = 0usize;
    while k < kend || oi < noff {
      var nref = NoRef;
      var npos = cur.pos;
      var stepCost = 0.f;
      if k < kend {
        let l = tile.links[usize.from(k)];
        k = k + 1i32;
        nref = l.to;
        if !nav.isValid(nref) { continue; }
        if !filter.passable(nav.polyArea(nref)) { continue; }
        let v0 = tile.vertOf(cp, usize.from(l.edge));
        let v1 = tile.vertOf(cp, (usize.from(l.edge) + 1usize) % nv);
        var a = v0;
        var b = v1;
        if l.side >= 0i32 && (l.tmin > 0. || l.tmax < 1.) { a =v0.lerp(v1, l.tmin); b = v0.lerp(v1, l.tmax); }
        npos = a.lerp(b, 0.5);
        stepCost = cur.pos.distance(npos) * filter.areaCost(curArea);
      } else {
        let c = nav.off[oi];
        oi = oi + 1usize;
        if !c.enabled || !filter.passable(c.area) { continue; }
        var from = c.refA;
        var to = c.refB;
        var pa = c.posA;
        var pb = c.posB;
        if cur.ref != from {
          if c.bidirectional && cur.ref == c.refB { from = c.refB; to = c.refA; pa = c.posB; pb = c.posA; }
          else { continue; }
        }
        if !nav.isValid(to) || !filter.passable(nav.polyArea(to)) { continue; }
        nref = to;
        npos = pb;
        stepCost = cur.pos.distance(pa) * filter.areaCost(curArea) + pa.distance(pb) * filter.areaCost(c.area);
      }
      if nref == NoRef { continue; }
      // the parent's parent is never worth returning to
      if cur.parent >= 0i32 && (*nodes[usize.from(cur.parent)]).ref == nref { continue; }
      var cost = cur.cost + stepCost;
      var heuristic = 0.f;
      if nref == endRef {
        cost = cost + npos.distance(endPos) * filter.areaCost(nav.polyArea(nref));
      } else {
        heuristic = npos.distance(endPos) * hScale;
      }
      let total = cost + heuristic;
      var ni = -1i32;
      match index.get(&nref) {
        case let v Some { ni = *v; }
        else {}
      }
      if ni >= 0i32 {
        let old = *nodes[usize.from(ni)];
        if total >= old.total { continue; }
        nodes.set(usize.from(ni), Node(npos, cost, total, i32.from(ci), nref, false));
      } else {
        ni = i32.from(nodes.len());
        nodes.push(Node(npos, cost, total, i32.from(ci), nref, false));
        index.insert(nref, ni);
      }
      open.push(total, u32.from(ni));
      if heuristic < lastBestH {
        lastBestH = heuristic;
        lastBest = ni;
      }
    }
  }
  var at = endNode;
  if endNode < 0i32 {
    // nowhere to go: as near as it got
    if lastBest == 0i32 { return res; }
    at = lastBest;
    res.partial = true;
  } else {
    res.cost = (*nodes[usize.from(endNode)]).cost;
  }
  res.found = true;
  var rev = List[u64].empty();
  while at >= 0i32 {
    rev.push((*nodes[usize.from(at)]).ref);
    at = (*nodes[usize.from(at)]).parent;
  }
  var q = rev.len();
  while q > 0usize { q = q - 1usize; res.polys.push(*rev[q]); }
  res
}

// ---- the funnel ----

pub struct StraightPoint {
  pub pos: Vec3;
  pub flags: u8;      // StraightStart, StraightEnd, StraightOffMesh
  pub ref: u64;       // the polygon the walk enters at this point (the last, for the end)
}

struct FunnelPortal {
  left: Vec3;
  right: Vec3;
  off: bool;
  ref: u64;
}

// The shortest way through the polygons of 'path' from 'start' to 'end',
// as the corners it bends at (the simple stupid funnel algorithm). The ends
// are pulled onto the first and last polygon. 'maxPoints' caps the result
pub fn findStraightPath(nav: &NavMesh, start: Vec3, end: Vec3, path: &List[u64], maxPoints: usize) List[StraightPoint] {
  var out = List[StraightPoint].empty();
  if path.len() == 0usize { return out; }
  let cs = closestPointOnPoly(nav, *path[0usize], start).pos;
  let ce = closestPointOnPoly(nav, *path[path.len() - 1usize], end).pos;
  out.push(StraightPoint(cs, StraightStart, *path[0usize]));
  if path.len() == 1usize {
    out.push(StraightPoint(ce, StraightEnd, NoRef));
    return out;
  }
  // the portals, an off-mesh move being two points
  var portals = List[FunnelPortal].empty();
  var i = 0usize;
  while i + 1usize < path.len() {
    let pf = getPortal(nav, *path[i], *path[i + 1usize]);
    if !pf.ok { break; }
    if pf.off {
      portals.push(FunnelPortal(pf.left, pf.left, true, *path[i + 1usize]));
      portals.push(FunnelPortal(pf.right, pf.right, true, *path[i + 1usize]));
    } else {
      portals.push(FunnelPortal(pf.left, pf.right, false, *path[i + 1usize]));
    }
    i = i + 1usize;
  }
  portals.push(FunnelPortal(ce, ce, false, NoRef));
  var apex = cs;
  var left = cs;
  var right = cs;
  var apexIndex = 0usize;
  var leftIndex = 0usize;
  var rightIndex = 0usize;
  i = 0usize;
  while i < portals.len() && out.len() < maxPoints - 1usize {
    let pl = (*portals[i]).left;
    let pr = (*portals[i]).right;
    // an off-mesh portal is a point that must be visited
    if (*portals[i]).off {
      addStraight(&mut out, pl, StraightOffMesh, (*portals[i]).ref);
      apex = pl; left = pl; right = pl;
      apexIndex = i; leftIndex = i; rightIndex = i;
      i = i + 1usize;
      continue;
    }
    // starting really close to the portal: move on
    if i == 0usize {
      let sd = distPtSegXZ(apex, pl, pr);
      if sd.d2 < 0.000001 { i = i + 1usize; continue; }
    }
    // right vertex
    if triArea2D(apex, right, pr) <= 0. {
      if apex.distanceSquared(right) < 0.000001 || triArea2D(apex, left, pr) > 0. {
        right = pr;
        rightIndex = i;
      } else {
        // right over left: left is a corner
        addStraight(&mut out, left, 0u8, (*portals[leftIndex]).ref);
        apex = left; apexIndex = leftIndex;
        left = apex; right = apex;
        leftIndex = apexIndex; rightIndex = apexIndex;
        i = apexIndex + 1usize;
        continue;
      }
    }
    // left vertex
    if triArea2D(apex, left, pl) >= 0. {
      if apex.distanceSquared(left) < 0.000001 || triArea2D(apex, right, pl) < 0. {
        left = pl;
        leftIndex = i;
      } else {
        addStraight(&mut out, right, 0u8, (*portals[rightIndex]).ref);
        apex = right; apexIndex = rightIndex;
        left = apex; right = apex;
        leftIndex = apexIndex; rightIndex = apexIndex;
        i = apexIndex + 1usize;
        continue;
      }
    }
    i = i + 1usize;
  }
  addStraight(&mut out, ce, StraightEnd, NoRef);
  out
}

// A corner added, unless it is where the last one is (then its flags and
// polygon are merged into that one)
fn addStraight(out: &mut List[StraightPoint], pos: Vec3, flags: u8, ref: u64) {
  if out.len() > 0usize {
    let last = *out[out.len() - 1usize];
    if last.pos.distanceSquared(pos) < 0.000001 {
      out.set(out.len() - 1usize, StraightPoint(last.pos, last.flags | flags, ref));
      return;
    }
  }
  out.push(StraightPoint(pos, flags, ref));
}

// The whole thing from two points: nearest polygons, A*, the funnel. The
// corners from start to end, or none when there is no route; 'partial' is
// set when the route stops short
pub struct Route {
  pub found: bool;
  pub partial: bool;
  pub points: List[StraightPoint];
  pub polys: List[u64];
  pub cost: f32;
}

pub fn findRoute(nav: &NavMesh, start: Vec3, end: Vec3, halfExtents: Vec3, filter: &QueryFilter) Route {
  var r = Route(false, false, List[StraightPoint].empty(), List[u64].empty(), 0.);
  let s = findNearestPoly(nav, start, halfExtents.x, halfExtents.y, halfExtents.z, filter);
  let e = findNearestPoly(nav, end, halfExtents.x, halfExtents.y, halfExtents.z, filter);
  if !s.found || !e.found { return r; }
  let pr = findPath(nav, s.ref, e.ref, s.pos, e.pos, filter);
  if !pr.found { return r; }
  r.found = true;
  r.partial = pr.partial;
  r.cost = pr.cost;
  r.points = findStraightPath(nav, s.pos, e.pos, &pr.polys, 256usize);
  var q = 0usize;
  while q < pr.polys.len() { r.polys.push(*pr.polys[q]); q = q + 1usize; }
  r
}

// ---- raycast ----

pub struct RayHit {
  pub t: f32;            // the fraction of the segment reached; 3.4e38 when it got to the end unhindered
  pub normal: Vec3;      // of the wall hit
  pub hit: bool;
  pub polys: List[u64];  // the polygons passed through
}

struct SegPoly {
  ok: bool;
  tmin: f32;
  tmax: f32;
  segMin: i32;
  segMax: i32;
}

fn segmentPoly2D(p: Vec3, q: Vec3, tile: &Tile, poly: usize) SegPoly {
  let nv = usize.from(*tile.pcount[poly]);
  var tmin = 0.f;
  var tmax = 1.f;
  var segMin = -1i32;
  var segMax = -1i32;
  let dx = q.x - p.x;
  let dz = q.z - p.z;
  var i = 0usize;
  var j = nv - 1usize;
  while i < nv {
    let vi = tile.vertOf(poly, i);
    let vj = tile.vertOf(poly, j);
    let ex = vi.x - vj.x;
    let ez = vi.z - vj.z;
    let ddx = p.x - vj.x;
    let ddz = p.z - vj.z;
    let n = ez * ddx - ex * ddz;
    let d = dz * ex - dx * ez;
    if absf(d) < 0.000001 {
      if n < 0. { return SegPoly(false, 0., 0., -1i32, -1i32); }
    } else {
      let t = n / d;
      if d < 0. {
        if t > tmin {
          tmin = t;
          segMin = i32.from(j);
          if tmin > tmax { return SegPoly(false, 0., 0., -1i32, -1i32); }
        }
      } else {
        if t < tmax {
          tmax = t;
          segMax = i32.from(j);
          if tmax < tmin { return SegPoly(false, 0., 0., -1i32, -1i32); }
        }
      }
    }
    j = i;
    i = i + 1usize;
  }
  SegPoly(true, tmin, tmax, segMin, segMax)
}

// A segment from 'start' (in polygon 'startRef') to 'end' walked through
// the polygons it crosses until a wall (or an area the filter refuses)
// stops it. Detour's dtNavMeshQuery::raycast without the cost
pub fn raycast(nav: &NavMesh, startRef: u64, start: Vec3, end: Vec3, filter: &QueryFilter) RayHit {
  var hit = RayHit(3.4e38, Vec3(0., 0., 0.), false, List[u64].empty());
  if !nav.isValid(startRef) { return hit; }
  var cur = startRef;
  var guard = 0i32;
  while cur != NoRef && guard < 512i32 {
    guard = guard + 1i32;
    let ti = nav.refTile(cur);
    let tile = nav.tiles[usize.from(ti)];
    let p = nav.refPoly(cur);
    let sp = segmentPoly2D(start, end, tile, p);
    hit.polys.push(cur);
    if !sp.ok {
      // the start is outside the first polygon: no ray
      hit.t = 0.;
      hit.hit = true;
      return hit;
    }
    let tmax = sp.tmax;
    if sp.segMax < 0i32 {
      // the segment ends inside this polygon
      hit.t = 3.4e38;
      return hit;
    }
    // the neighbour through the edge it leaves by
    var next = NoRef;
    let nv = usize.from(*tile.pcount[p]);
    var k = *tile.linkStart[p];
    while k < *tile.linkStart[p + 1usize] {
      let l = tile.links[usize.from(k)];
      k = k + 1i32;
      if l.edge != sp.segMax { continue; }
      if !nav.isValid(l.to) || !filter.passable(nav.polyArea(l.to)) { continue; }
      if l.side >= 0i32 {
        // across a portal the exit must be within the overlap
        let v0 = tile.vertOf(p, usize.from(l.edge));
        let v1 = tile.vertOf(p, (usize.from(l.edge) + 1usize) % nv);
        let hx = start.x + (end.x - start.x) * tmax;
        let hz = start.z + (end.z - start.z) * tmax;
        var s = 0.;
        if absf(v1.x - v0.x) > absf(v1.z - v0.z) {
          s = (hx - v0.x) / (v1.x - v0.x);
        } else {
          s = (hz - v0.z) / (v1.z - v0.z);
        }
        if s < l.tmin - 0.0001 || s > l.tmax + 0.0001 { continue; }
      }
      next = l.to;
      k = *tile.linkStart[p + 1usize];
    }
    if next == NoRef {
      // a wall: its normal points out of the polygon
      let v0 = tile.vertOf(p, usize.from(sp.segMax));
      let v1 = tile.vertOf(p, (usize.from(sp.segMax) + 1usize) % nv);
      let ex = v1.x - v0.x;
      let ez = v1.z - v0.z;
      let len = (ex * ex + ez * ez).sqrt();
      // the polygon winds counterclockwise seen from above, so the outward normal of
      // an edge is its direction turned a quarter the other way
      hit.normal = Vec3(-ez / len, 0., ex / len);
      hit.t = tmax;
      hit.hit = true;
      return hit;
    }
    cur = next;
  }
  hit
}

// Whether the straight segment from a to b stays on walkable mesh
pub fn isVisible(nav: &NavMesh, startRef: u64, a: Vec3, b: Vec3, filter: &QueryFilter) bool {
  let h = raycast(nav, startRef, a, b, filter);
  !h.hit
}

// ---- moving along the surface ----

pub struct MoveResult {
  pub pos: Vec3;
  pub visited: List[u64];     // polygons passed, from the start to the one the point ends in
}

// The point reached by moving from 'startPos' towards 'endPos' along the
// mesh, sliding along walls, and the polygons passed (Detour's moveAlongSurface)
pub fn moveAlongSurface(nav: &NavMesh, startRef: u64, startPos: Vec3, endPos: Vec3, filter: &QueryFilter, maxVisited: usize) MoveResult {
  var res = MoveResult(startPos, List[u64].empty());
  if !nav.isValid(startRef) { return res; }
  let searchPos = startPos.lerp(endPos, 0.5);
  let searchRad = startPos.distance(endPos) * 0.5 + 0.001;
  let searchRad2 = searchRad * searchRad;
  var refs = List[u64].empty();
  var parent = List[i32].empty();
  refs.push(startRef);
  parent.push(-1i32);
  var head = 0usize;
  var bestPos = startPos;
  var bestDist = 3.4e38f;
  var bestNode = 0i32;
  while head < refs.len() {
    let cur = *refs[head];
    let node = head;
    head = head + 1usize;
    let tile = nav.tiles[usize.from(nav.refTile(cur))];
    let p = nav.refPoly(cur);
    let nv = usize.from(*tile.pcount[p]);
    if polyPointInside(tile, p, endPos) {
      bestNode = i32.from(node);
      bestPos = endPos;
      break;
    }
    var j = nv - 1usize;
    var i = 0usize;
    while i < nv {
      let vj = tile.vertOf(p, j);
      let vi = tile.vertOf(p, i);
      // the polygons through edge j (links leave by edge index j)
      var nn = 0i32;
      var k = *tile.linkStart[p];
      while k < *tile.linkStart[p + 1usize] {
        let l = tile.links[usize.from(k)];
        k = k + 1i32;
        if usize.from(l.edge) == j && nav.isValid(l.to) && filter.passable(nav.polyArea(l.to)) {
          nn = nn + 1i32;
          var seen = false;
          var q = 0usize;
          while q < refs.len() { if *refs[q] == l.to { seen = true; } q = q + 1usize; }
          if !seen && refs.len() < maxVisited {
            let sd = distPtSegXZ(searchPos, vj, vi);
            if sd.d2 <= searchRad2 {
              refs.push(l.to);
              parent.push(i32.from(node));
            }
          }
        }
      }
      if nn == 0i32 {
        // a wall edge: how near the target gets along it
        let sd = distPtSegXZ(endPos, vj, vi);
        if sd.d2 < bestDist {
          bestDist = sd.d2;
          bestPos = vj.lerp(vi, sd.t);
          bestNode = i32.from(node);
        }
      }
      j = i;
      i = i + 1usize;
    }
  }
  // the polygons from the start to the one it ended in
  var rev = List[u64].empty();
  var at = bestNode;
  while at >= 0i32 {
    rev.push(*refs[usize.from(at)]);
    at = *parent[usize.from(at)];
  }
  var q = rev.len();
  while q > 0usize { q = q - 1usize; res.visited.push(*rev[q]); }
  // the height of the surface there
  let last = *res.visited[res.visited.len() - 1usize];
  let hh = polyHeightAt(nav, last, bestPos);
  res.pos = if hh.ok { Vec3(bestPos.x, hh.y, bestPos.z) } else { bestPos };
  res
}
