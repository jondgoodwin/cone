// ======== Convex polygons from contours ========
//
// Recast's fourth stage (RecastMesh.cpp). Each contour is cut into triangles
// by ear clipping (Eberly's / O'Rourke's "Computational Geometry in C"
// diagonal tests, shortest ear first), the triangles are merged back into
// convex polygons of at most 'MaxVerts' vertices (the shared edge whose merge
// gives the longest edge first), vertices of all contours are welded, and each
// polygon edge is matched with the polygon on the other side of it. An edge
// on the tile's boundary that no polygon of this tile matches is a portal:
// its neighbour number is 0x8000 plus the side (0 is -x, 1 is +z, 2 is +x,
// 3 is -z, as the directions of the compact heightfield).
//
// No detail mesh (Recast's rcBuildPolyMeshDetail): a polygon's surface is
// the one its vertices make, so the height inside a polygon is interpolated
// between them.

pub const MaxVerts: i32 = 6i32;
pub const PortalFlag: i32 = 32768i32;

pub struct PolyMesh {
  pub verts: List[i32];     // x, y, z in cells; the tile's interior corner is 0, 0
  pub polys: List[i32];     // MaxVerts vertex numbers then MaxVerts neighbours a polygon; -1: none
  pub areas: List[u8];
  pub regs: List[i32];

  pub fn polyCount(self: &) usize { areas.len() }
  pub fn vertCount(self: &) usize { verts.len() / 3usize }
}

// ---- the geometry tests of the ear clipper (x and z of rows of four ints) ----

fn area2(v: &List[i32], a: usize, b: usize, c: usize) i32 inline {
  (*v[b * 4usize] - *v[a * 4usize]) * (*v[c * 4usize + 2usize] - *v[a * 4usize + 2usize])
    - (*v[c * 4usize] - *v[a * 4usize]) * (*v[b * 4usize + 2usize] - *v[a * 4usize + 2usize])
}

fn leftT(v: &List[i32], a: usize, b: usize, c: usize) bool inline { area2(v, a, b, c) < 0i32 }
fn leftOn(v: &List[i32], a: usize, b: usize, c: usize) bool inline { area2(v, a, b, c) <= 0i32 }
fn collinear(v: &List[i32], a: usize, b: usize, c: usize) bool inline { area2(v, a, b, c) == 0i32 }

fn xorb(x: bool, y: bool) bool inline { x != y }

fn intersectProp(v: &List[i32], a: usize, b: usize, c: usize, d: usize) bool {
  if collinear(v, a, b, c) || collinear(v, a, b, d) || collinear(v, c, d, a) || collinear(v, c, d, b) { return false; }
  xorb(leftT(v, a, b, c), leftT(v, a, b, d)) && xorb(leftT(v, c, d, a), leftT(v, c, d, b))
}

fn between(v: &List[i32], a: usize, b: usize, c: usize) bool {
  if !collinear(v, a, b, c) { return false; }
  if *v[a * 4usize] != *v[b * 4usize] {
    return (*v[a * 4usize] <= *v[c * 4usize] && *v[c * 4usize] <= *v[b * 4usize])
      || (*v[a * 4usize] >= *v[c * 4usize] && *v[c * 4usize] >= *v[b * 4usize]);
  }
  (*v[a * 4usize + 2usize] <= *v[c * 4usize + 2usize] && *v[c * 4usize + 2usize] <= *v[b * 4usize + 2usize])
    || (*v[a * 4usize + 2usize] >= *v[c * 4usize + 2usize] && *v[c * 4usize + 2usize] >= *v[b * 4usize + 2usize])
}

fn intersectSeg(v: &List[i32], a: usize, b: usize, c: usize, d: usize) bool {
  if intersectProp(v, a, b, c, d) { return true; }
  between(v, a, b, c) || between(v, a, b, d) || between(v, c, d, a) || between(v, c, d, b)
}

fn vequal(v: &List[i32], a: usize, b: usize) bool inline {
  *v[a * 4usize] == *v[b * 4usize] && *v[a * 4usize + 2usize] == *v[b * 4usize + 2usize]
}

fn nextI(i: usize, n: usize) usize inline { if i + 1usize < n { return i + 1usize; } 0usize }
fn prevI(i: usize, n: usize) usize inline { if i > 0usize { return i - 1usize; } n - 1usize }

fn ix(idx: &List[i32], k: usize) usize inline { usize.from(*idx[k] & 268435455i32) }

// Whether the diagonal from i to j of the polygon is inside it and crosses none of its edges
fn diagonalie(i: usize, j: usize, n: usize, v: &List[i32], idx: &List[i32]) bool {
  let d0 = ix(idx, i);
  let d1 = ix(idx, j);
  var k = 0usize;
  while k < n {
    let k1 = nextI(k, n);
    if !((k == i) || (k1 == i) || (k == j) || (k1 == j)) {
      let p0 = ix(idx, k);
      let p1 = ix(idx, k1);
      if !(vequal(v, d0, p0) || vequal(v, d1, p0) || vequal(v, d0, p1) || vequal(v, d1, p1)) {
        if intersectSeg(v, d0, d1, p0, p1) { return false; }
      }
    }
    k = k + 1usize;
  }
  true
}

fn inCone(i: usize, j: usize, n: usize, v: &List[i32], idx: &List[i32]) bool {
  let pi = ix(idx, i);
  let pj = ix(idx, j);
  let pi1 = ix(idx, nextI(i, n));
  let pin1 = ix(idx, prevI(i, n));
  if leftOn(v, pin1, pi, pi1) {
    return leftT(v, pi, pj, pin1) && leftT(v, pj, pi, pi1);
  }
  !(leftOn(v, pi, pj, pi1) && leftOn(v, pj, pi, pin1))
}

fn diagonal(i: usize, j: usize, n: usize, v: &List[i32], idx: &List[i32]) bool {
  inCone(i, j, n, v, idx) && diagonalie(i, j, n, v, idx)
}

fn inConeLoose(i: usize, j: usize, n: usize, v: &List[i32], idx: &List[i32]) bool {
  let pi = ix(idx, i);
  let pj = ix(idx, j);
  let pi1 = ix(idx, nextI(i, n));
  let pin1 = ix(idx, prevI(i, n));
  if leftOn(v, pin1, pi, pi1) {
    return leftOn(v, pi, pj, pin1) && leftOn(v, pj, pi, pi1);
  }
  !(leftT(v, pi, pj, pi1) && leftT(v, pj, pi, pin1))
}

fn diagonalLoose(i: usize, j: usize, n: usize, v: &List[i32], idx: &List[i32]) bool {
  inConeLoose(i, j, n, v, idx) && diagonalie(i, j, n, v, idx)
}

// Ear clipping: triangles (three vertex numbers each) appended to 'tris';
// the count, negative if the contour was too tangled to finish (the
// triangles so far are kept)
fn triangulate(nverts: usize, v: &List[i32], tris: &mut List[i32]) i32 {
  var idx = List[i32].withCapacity(nverts);
  var q = 0usize;
  while q < nverts { idx.push(i32.from(q)); q = q + 1usize; }
  var n = nverts;
  var ntris = 0i32;
  // the top bit of an index says the vertex's ear is a diagonal
  let flag = 268435456i32;
  var i = 0usize;
  while i < n {
    let i1 = nextI(i, n);
    let i2 = nextI(i1, n);
    if diagonal(i, i2, n, v, &idx) { idx.set(i1, *idx[i1] | flag); }
    i = i + 1usize;
  }
  while n > 3usize {
    var minLen = -1i32;
    var mini = -1i32;
    i = 0usize;
    while i < n {
      let i1 = nextI(i, n);
      if (*idx[i1] & flag) != 0i32 {
        let p0 = ix(&idx, i);
        let p2 = ix(&idx, nextI(i1, n));
        let dx = *v[p2 * 4usize] - *v[p0 * 4usize];
        let dz = *v[p2 * 4usize + 2usize] - *v[p0 * 4usize + 2usize];
        let len = dx * dx + dz * dz;
        if minLen < 0i32 || len < minLen { minLen = len; mini = i32.from(i); }
      }
      i = i + 1usize;
    }
    if mini == -1i32 {
      // overlapping segments may make no strict ear: loosen the test
      minLen = -1i32;
      i = 0usize;
      while i < n {
        let i1 = nextI(i, n);
        let i2 = nextI(i1, n);
        if diagonalLoose(i, i2, n, v, &idx) {
          let p0 = ix(&idx, i);
          let p2 = ix(&idx, nextI(i1, n));
          let dx = *v[p2 * 4usize] - *v[p0 * 4usize];
          let dz = *v[p2 * 4usize + 2usize] - *v[p0 * 4usize + 2usize];
          let len = dx * dx + dz * dz;
          if minLen < 0i32 || len < minLen { minLen = len; mini = i32.from(i); }
        }
        i = i + 1usize;
      }
      if mini == -1i32 { return -ntris; }
    }
    i = usize.from(mini);
    var i1 = nextI(i, n);
    let i2 = nextI(i1, n);
    tris.push(*idx[i] & (flag - 1i32));
    tris.push(*idx[i1] & (flag - 1i32));
    tris.push(*idx[i2] & (flag - 1i32));
    ntris = ntris + 1i32;
    // remove P[i1]
    n = n - 1usize;
    var k = i1;
    while k < n { idx.set(k, *idx[k + 1usize]); k = k + 1usize; }
    if i1 >= n { i1 = 0usize; }
    i = prevI(i1, n);
    if diagonal(prevI(i, n), i1, n, v, &idx) { idx.set(i, *idx[i] | flag); } else { idx.set(i, *idx[i] & (flag - 1i32)); }
    if diagonal(i, nextI(i1, n), n, v, &idx) { idx.set(i1, *idx[i1] | flag); } else { idx.set(i1, *idx[i1] & (flag - 1i32)); }
  }
  tris.push(*idx[0usize] & (flag - 1i32));
  tris.push(*idx[1usize] & (flag - 1i32));
  tris.push(*idx[2usize] & (flag - 1i32));
  ntris + 1i32
}

// ---- merging triangles into convex polygons ----

fn countPolyVerts(p: &List[i32], base: usize) usize {
  var n = 0usize;
  while n < usize.from(MaxVerts) && *p[base + n] >= 0i32 { n = n + 1usize; }
  n
}

fn uleft(v: &List[i32], a: usize, b: usize, c: usize) bool {
  (*v[b * 4usize] - *v[a * 4usize]) * (*v[c * 4usize + 2usize] - *v[a * 4usize + 2usize])
    - (*v[c * 4usize] - *v[a * 4usize]) * (*v[b * 4usize + 2usize] - *v[a * 4usize + 2usize]) < 0i32
}

struct MergeInfo {
  value: i32;
  ea: usize;
  eb: usize;
}

// The squared length of the shared edge if polygons a and b (offsets into
// 'polys') can merge into one convex polygon, else -1
fn polyMergeValue(polys: &List[i32], pa: usize, pb: usize, v: &List[i32]) MergeInfo {
  let na = countPolyVerts(polys, pa);
  let nb = countPolyVerts(polys, pb);
  let none = MergeInfo(-1i32, 0usize, 0usize);
  if na + nb - 2usize > usize.from(MaxVerts) { return none; }
  var ea = 1000usize;
  var eb = 1000usize;
  var i = 0usize;
  while i < na {
    var va0 = *polys[pa + i];
    var va1 = *polys[pa + (i + 1usize) % na];
    if va0 > va1 { let t = va0; va0 = va1; va1 = t; }
    var j = 0usize;
    while j < nb {
      var vb0 = *polys[pb + j];
      var vb1 = *polys[pb + (j + 1usize) % nb];
      if vb0 > vb1 { let t = vb0; vb0 = vb1; vb1 = t; }
      if va0 == vb0 && va1 == vb1 { ea = i; eb = j; break; }
      j = j + 1usize;
    }
    if ea != 1000usize { break; }
    i = i + 1usize;
  }
  if ea == 1000usize || eb == 1000usize { return none; }
  // the merged polygon must be convex at both ends of the shared edge
  var va = usize.from(*polys[pa + (ea + na - 1usize) % na]);
  var vb = usize.from(*polys[pa + ea]);
  var vc = usize.from(*polys[pb + (eb + 2usize) % nb]);
  if !uleft(v, va, vb, vc) { return none; }
  va = usize.from(*polys[pb + (eb + nb - 1usize) % nb]);
  vb = usize.from(*polys[pb + eb]);
  vc = usize.from(*polys[pa + (ea + 2usize) % na]);
  if !uleft(v, va, vb, vc) { return none; }
  va = usize.from(*polys[pa + ea]);
  vb = usize.from(*polys[pa + (ea + 1usize) % na]);
  let dx = *v[va * 4usize] - *v[vb * 4usize];
  let dz = *v[va * 4usize + 2usize] - *v[vb * 4usize + 2usize];
  MergeInfo(dx * dx + dz * dz, ea, eb)
}

// ---- building the mesh ----

struct VertexIndex {
  heads: Dict[u64, i32];
  next: List[i32];
}

fn addVertex(mesh: &mut PolyMesh, vi: &mut VertexIndex, x: i32, y: i32, z: i32) i32 {
  let key = (u64.from(x) << 32u64) | u64.from(z);
  var cur = -1i32;
  match vi.heads.get(&key) {
    case let Some(h) { cur = *h; }
    else {}
  }
  var at = cur;
  while at >= 0i32 {
    let a = usize.from(at);
    if iabs(*mesh.verts[a * 3usize + 1usize] - y) <= 2i32 { return at; }
    at = *vi.next[a];
  }
  let id = i32.from(mesh.verts.len() / 3usize);
  mesh.verts.push(x); mesh.verts.push(y); mesh.verts.push(z);
  vi.next.push(cur);
  vi.heads.insert(key, id);
  id
}

struct EdgeRec {
  p0: i32;
  e0: i32;
  p1: i32;
  e1: i32;
}

// Build the polygons of all the contours. 'w' and 'h' are the tile's
// interior size in cells (for the portals)
pub fn buildPolyMesh(contours: &List[Contour], w: i32, h: i32) PolyMesh {
  var mesh = PolyMesh(List[i32].empty(), List[i32].empty(), List[u8].empty(), List[i32].empty());
  var vi = VertexIndex(Dict[u64, i32].empty(), List[i32].empty());
  let nvp = usize.from(MaxVerts);
  var ci = 0usize;
  while ci < contours.len() {
    let c = contours[ci];
    ci = ci + 1usize;
    let nv = c.verts.len() / 4usize;
    if nv < 3usize { continue; }
    var tris = List[i32].empty();
    let nt = triangulate(nv, &c.verts, &mut tris);
    if nt <= 0i32 && tris.len() == 0usize { continue; }
    // vertex numbers into the mesh
    var map = List[i32].withCapacity(nv);
    var k = 0usize;
    while k < nv {
      map.push(addVertex(&mut mesh, &mut vi, *c.verts[k * 4usize], *c.verts[k * 4usize + 1usize], *c.verts[k * 4usize + 2usize]));
      k = k + 1usize;
    }
    // triangles as polygons of nvp slots, in contour-local numbers
    var polys = List[i32].empty();
    var t = 0usize;
    while t < tris.len() / 3usize {
      // drop zero-area triangles (the same vertex twice)
      let a = *tris[t * 3usize];
      let b = *tris[t * 3usize + 1usize];
      let cc = *tris[t * 3usize + 2usize];
      if *map[usize.from(a)] != *map[usize.from(b)] && *map[usize.from(b)] != *map[usize.from(cc)] && *map[usize.from(a)] != *map[usize.from(cc)] {
        polys.push(a); polys.push(b); polys.push(cc);
        var f = 3usize;
        while f < nvp { polys.push(-1i32); f = f + 1usize; }
      }
      t = t + 1usize;
    }
    // merge until nothing merges
    while true {
      var best = 0i32;
      var bi = 0usize;
      var bj = 0usize;
      var bea = 0usize;
      var beb = 0usize;
      let np = polys.len() / nvp;
      var a = 0usize;
      while a + 1usize < np {
        var b = a + 1usize;
        while b < np {
          let m = polyMergeValue(&polys, a * nvp, b * nvp, &c.verts);
          if m.value > best { best = m.value; bi = a; bj = b; bea = m.ea; beb = m.eb; }
          b = b + 1usize;
        }
        a = a + 1usize;
      }
      if best <= 0i32 { break; }
      // pa merged with pb at the shared edge
      let na = countPolyVerts(&polys, bi * nvp);
      let nb = countPolyVerts(&polys, bj * nvp);
      var tmp = List[i32].empty();
      var q = 0usize;
      while q + 1usize < na { tmp.push(*polys[bi * nvp + (bea + 1usize + q) % na]); q = q + 1usize; }
      q = 0usize;
      while q + 1usize < nb { tmp.push(*polys[bj * nvp + (beb + 1usize + q) % nb]); q = q + 1usize; }
      while tmp.len() < nvp { tmp.push(-1i32); }
      q = 0usize;
      while q < nvp { polys.set(bi * nvp + q, *tmp[q]); q = q + 1usize; }
      // pb replaced by the last polygon
      let last = np - 1usize;
      if bj != last {
        q = 0usize;
        while q < nvp { polys.set(bj * nvp + q, *polys[last * nvp + q]); q = q + 1usize; }
      }
      polys.truncate(last * nvp);
    }
    // into the mesh
    let np = polys.len() / nvp;
    var p = 0usize;
    while p < np {
      var q = 0usize;
      while q < nvp {
        let lv = *polys[p * nvp + q];
        mesh.polys.push(if lv >= 0i32 { *map[usize.from(lv)] } else { -1i32 });
        q = q + 1usize;
      }
      q = 0usize;
      while q < nvp { mesh.polys.push(-1i32); q = q + 1usize; }
      mesh.areas.push(c.area);
      mesh.regs.push(c.reg);
      p = p + 1usize;
    }
  }
  buildAdjacency(&mut mesh, w, h);
  mesh
}

fn buildAdjacency(mesh: &mut PolyMesh, w: i32, h: i32) {
  let nvp = usize.from(MaxVerts);
  let np = mesh.polyCount();
  var edges = List[EdgeRec].empty();
  var lookup = Dict[u64, i32].empty();
  var p = 0usize;
  while p < np {
    let nv = countPolyVerts(&mesh.polys, p * nvp * 2usize);
    var j = 0usize;
    while j < nv {
      let v0 = *mesh.polys[p * nvp * 2usize + j];
      let v1 = *mesh.polys[p * nvp * 2usize + (j + 1usize) % nv];
      let lo = imin(v0, v1);
      let hi = imax(v0, v1);
      let key = (u64.from(lo) << 32u64) | u64.from(hi);
      var found = -1i32;
      match lookup.get(&key) {
        case let Some(e) { found = *e; }
        else {}
      }
      if found < 0i32 {
        lookup.insert(key, i32.from(edges.len()));
        edges.push(EdgeRec(i32.from(p), i32.from(j), -1i32, 0i32));
      } else {
        let e = *edges[usize.from(found)];
        if e.p1 < 0i32 && e.p0 != i32.from(p) {
          edges.set(usize.from(found), EdgeRec(e.p0, e.e0, i32.from(p), i32.from(j)));
        }
      }
      j = j + 1usize;
    }
    p = p + 1usize;
  }
  var e = 0usize;
  while e < edges.len() {
    let r = *edges[e];
    if r.p1 >= 0i32 {
      mesh.polys.set(usize.from(r.p0) * nvp * 2usize + nvp + usize.from(r.e0), r.p1);
      mesh.polys.set(usize.from(r.p1) * nvp * 2usize + nvp + usize.from(r.e1), r.p0);
    }
    e = e + 1usize;
  }
  // an edge with no neighbour that lies along the tile's boundary is a portal
  p = 0usize;
  while p < np {
    let nv = countPolyVerts(&mesh.polys, p * nvp * 2usize);
    var j = 0usize;
    while j < nv {
      if *mesh.polys[p * nvp * 2usize + nvp + j] < 0i32 {
        let a = usize.from(*mesh.polys[p * nvp * 2usize + j]);
        let b = usize.from(*mesh.polys[p * nvp * 2usize + (j + 1usize) % nv]);
        let ax = *mesh.verts[a * 3usize];
        let az = *mesh.verts[a * 3usize + 2usize];
        let bx = *mesh.verts[b * 3usize];
        let bz = *mesh.verts[b * 3usize + 2usize];
        var side = -1i32;
        if ax == 0i32 && bx == 0i32 { side = 0i32; }
        else if az == h && bz == h { side = 1i32; }
        else if ax == w && bx == w { side = 2i32; }
        else if az == 0i32 && bz == 0i32 { side = 3i32; }
        if side >= 0i32 { mesh.polys.set(p * nvp * 2usize + nvp + j, PortalFlag | side); }
      }
      j = j + 1usize;
    }
    p = p + 1usize;
  }
}
