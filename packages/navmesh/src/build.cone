// ======== Building the whole mesh, rebuilding tiles, off-mesh connections ========

// The mesh of everything in 'input', every tile built and linked. What the
// input has recorded as changed up to now is taken as built
pub fn buildNavMesh(input &mut NavInput, params &NavParams) NavMesh {
  input.dirty.clear();
  let b = input.bounds();
  let tw = f32.from(params.tileSize) * params.cellSize;
  let tilesW = imax(1i32, i32.from(ceilf((b.max.x - b.min.x) / tw)));
  let tilesH = imax(1i32, i32.from(ceilf((b.max.z - b.min.z) / tw)));
  var nav = new NavMesh(*params, b.min, b.max.y - b.min.y + 1., tilesW, tilesH, List[Tile].empty(), List[OffMeshConn].empty(), 1u32);
  var tz = 0i32;
  while tz < tilesH {
    var tx = 0i32;
    while tx < tilesW {
      nav.tiles.push(Tile.empty(tx, tz));
      tx = tx + 1i32;
    }
    tz = tz + 1i32;
  }
  var i = 0i32;
  while i < tilesW * tilesH {
    buildOne(&mut nav, input, i);
    i = i + 1i32;
  }
  i = 0i32;
  while i < tilesW * tilesH {
    connectTile(&mut nav, i);
    i = i + 1i32;
  }
  nav
}

// Tile index 't' built (or rebuilt) from the input, not yet linked
fn buildOne(nav &mut NavMesh, input &NavInput, t i32) {
  let oldSalt = nav.tiles[usize.from(t)].salt;
  let oldX = nav.tiles[usize.from(t)].tx;
  let oldZ = nav.tiles[usize.from(t)].tz;
  var nt = buildTile(nav, input, oldX, oldZ);
  nt.salt = oldSalt + 1u32;
  nav.tiles.set(usize.from(t), nt);
}

// Rebuild every tile that something in 'input' changed since the last
// rebuild (a door switched, a solid moved), and relink them and their
// neighbours; the number of tiles rebuilt
pub fn rebuildDirty(nav &mut NavMesh, input &mut NavInput) usize {
  var mark = List[bool].empty();
  var i = 0i32;
  while i < nav.tilesW * nav.tilesH { mark.push(false); i = i + 1i32; }
  let tw = nav.tileWorld();
  let margin = f32.from(nav.params.borderSize()) * nav.params.cellSize;
  var d = 0usize;
  while d < input.dirty.len() {
    let bx = *input.dirty[d];
    let tx0 = imax(0i32, i32.from(floorf((bx.x0 - margin - nav.origin.x) / tw)));
    let tx1 = imin(nav.tilesW - 1i32, i32.from(floorf((bx.x1 + margin - nav.origin.x) / tw)));
    let tz0 = imax(0i32, i32.from(floorf((bx.z0 - margin - nav.origin.z) / tw)));
    let tz1 = imin(nav.tilesH - 1i32, i32.from(floorf((bx.z1 + margin - nav.origin.z) / tw)));
    var tz = tz0;
    while tz <= tz1 {
      var tx = tx0;
      while tx <= tx1 { mark.set(usize.from(tz * nav.tilesW + tx), true); tx = tx + 1i32; }
      tz = tz + 1i32;
    }
    d = d + 1usize;
  }
  input.dirty.clear();
  var n = 0usize;
  i = 0i32;
  while i < nav.tilesW * nav.tilesH {
    if *mark[usize.from(i)] { buildOne(nav, input, i); n = n + 1usize; }
    i = i + 1i32;
  }
  // links of the rebuilt tiles and of their neighbours
  i = 0i32;
  while i < nav.tilesW * nav.tilesH {
    if *mark[usize.from(i)] {
      connectTile(nav, i);
      var dir = 0i32;
      while dir < 4i32 {
        let nt = nav.tileIndex(nav.tiles[usize.from(i)].tx + dirX(dir), nav.tiles[usize.from(i)].tz + dirZ(dir));
        if nt >= 0i32 { connectTile(nav, nt); }
        dir = dir + 1i32;
      }
    }
    i = i + 1i32;
  }
  if n > 0usize { reconnectOffMesh(nav); }
  n
}

// ---- off-mesh connections ----

// A connection from 'a' to 'b' (both within 'radius' of the mesh): the
// door, ladder or jump. 'area' decides its cost and what a filter lets
// through. The number to switch it with
pub fn addOffMesh(nav &mut NavMesh, a Vec3, b Vec3, radius f32, bidirectional bool, area u8) u32 {
  let id = nav.nextOffId;
  nav.nextOffId = nav.nextOffId + 1u32;
  nav.off.push(new OffMeshConn(id, a, b, radius, bidirectional, area, true, NoRef, NoRef, a, b));
  reconnectOffMesh(nav);
  id
}

// Switch a connection on or off: a door opening or closing
pub fn setOffMeshEnabled(nav &mut NavMesh, id u32, enabled bool) {
  var i = 0usize;
  while i < nav.off.len() {
    let c = *nav.off[i];
    if c.id == id {
      nav.off.set(i, new OffMeshConn(c.id, c.a, c.b, c.radius, c.bidirectional, c.area, enabled, c.refA, c.refB, c.posA, c.posB));
    }
    i = i + 1usize;
  }
}

// Each connection's ends found again on the mesh: after tiles change
pub fn reconnectOffMesh(nav &mut NavMesh) {
  var i = 0usize;
  while i < nav.off.len() {
    let c = *nav.off[i];
    let ra = nearestPolyRaw(nav, c.a, c.radius, c.radius * 2., c.radius);
    let rb = nearestPolyRaw(nav, c.b, c.radius, c.radius * 2., c.radius);
    nav.off.set(i, new OffMeshConn(c.id, c.a, c.b, c.radius, c.bidirectional, c.area, c.enabled,
      ra.ref, rb.ref, ra.pos, rb.pos));
    i = i + 1usize;
  }
}
