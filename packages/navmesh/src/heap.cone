// The open list of every search here: a min-heap of (key, id) pairs, the
// library's PriorityQueue ordered by a priority of key then id.
// Duplicates of an id are allowed (a search pushes again when it finds a
// shorter route and skips the stale entry when it pops it: "lazy deletion").
// Ties in key pop in a fixed order (the lower id first) so a search is
// deterministic.

pub struct HeapItem {
  pub key: f32;
  pub id: u32;

  // The key, then the id
  pub fn `<=>`(self, o: HeapItem) i32 {
    if key < o.key { -1i32 } else if key > o.key { 1i32 } else { id <=> o.id }
  }
}

// The queue's item: the priority already says everything
struct Nothing {}

pub struct MinHeap {
  q: PriorityQueue[HeapItem, Nothing];

  pub fn empty() MinHeap { MinHeap(PriorityQueue[HeapItem, Nothing]()) }

  pub fn len(self: &) usize { q.len() }
  pub fn isEmpty(self: &) bool { q.isEmpty() }
  pub fn clear(self: &mut) { q.clear(); }

  pub fn push(self: &mut, key: f32, id: u32) { q.push(HeapItem(key, id), Nothing()); }

  // The smallest, removed; the caller checks isEmpty first
  pub fn pop(self: &mut) HeapItem {
    match q.pop() {
      case let Some(pair) { let top, n = pair; top }
      case is None { HeapItem(0., 0u32) }
    }
  }
}
