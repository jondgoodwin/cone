// The mesh a scene builds: clearance round an obstacle, the world's edge,
// convex polygons that agree with each other, steps, slopes and ceilings.
//
// Resolution here: cells of 0.3 m, 0.2 m high; the agent 0.4 m in radius
// (erosion rounds it up to 2 cells, 0.6 m), 1.8 m tall (9 cells), climbing
// 0.5 m (2 cells), slopes to 45 degrees.

mod mesh;

import testing use *;
import collections use List;
import geomath use *;
import navmesh use *;


fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn addFloor(input: &mut NavInput, x0: f32, z0: f32, x1: f32, z1: f32, y: f32) {
  input.addTriangle(Vec3(x0, y, z0), Vec3(x0, y, z1), Vec3(x1, y, z0), AreaGround);
  input.addTriangle(Vec3(x1, y, z0), Vec3(x0, y, z1), Vec3(x1, y, z1), AreaGround);
}

// Every polygon of the mesh checked for being convex, of six or fewer
// vertices, with its edge-neighbours agreeing
fn checkPolygons(nav: &NavMesh, label: &Array[u8]) {
  var convexBad = 0i32;
  var asymmetric = 0i32;
  var tooMany = 0i32;
  var t = 0usize;
  while t < nav.tiles.len() {
    let tile = &nav.tiles[t];
    var p = 0usize;
    while p < tile.polyCount() {
      let nv = usize.from(*tile.pcount[p]);
      if nv > 6usize || nv < 3usize { tooMany = tooMany + 1i32; }
      // convex: every turn the same way (the winding is counterclockwise seen from above, x right, z down the page)
      var sign = 0i32;
      var e = 0usize;
      while e < nv {
        let a = tile.vertOf(p, e);
        let b = tile.vertOf(p, (e + 1usize) % nv);
        let c = tile.vertOf(p, (e + 2usize) % nv);
        let cross = (b.x - a.x) * (c.z - b.z) - (b.z - a.z) * (c.x - b.x);
        if cross > 0.0001 { if sign < 0i32 { convexBad = convexBad + 1i32; } sign = 1i32; }
        if cross < -0.0001 { if sign > 0i32 { convexBad = convexBad + 1i32; } sign = -1i32; }
        // a neighbour inside the tile points back at this polygon
        let nei = *tile.pnei[p * 6usize + e];
        if nei >= 0i32 && nei < 32768i32 {
          var back = false;
          let nn = usize.from(*tile.pcount[usize.from(nei)]);
          var f = 0usize;
          while f < nn {
            if *tile.pnei[usize.from(nei) * 6usize + f] == i32.from(p) { back = true; }
            f = f + 1usize;
          }
          if !back { asymmetric = asymmetric + 1i32; }
        }
        e = e + 1usize;
      }
      expectBool(sign == -1i32, true, "polygon winds counterclockwise from above");
      p = p + 1usize;
    }
    t = t + 1usize;
  }
  expectInt(i64.from(convexBad), 0, label);
  expectInt(i64.from(asymmetric), 0, "every edge neighbour points back");
  expectInt(i64.from(tooMany), 0, "polygons have 3 to 6 vertices");
}

// Clearance: a 12 x 12 floor with a pillar of radius 1 in the middle
fn testClearance() {
  var input = NavInput.empty();
  addFloor(&mut input, 0., 0., 12., 12., 0.);
  input.addCircleObstacle(6., 6., 1., 0., 3., AreaNull);
  let params = NavParams.standard();
  let nav = buildNavMesh(&mut input, &params);
  expectBool(nav.polyCount() > 4usize, true, "the floor made polygons");
  checkPolygons(&nav, "polygons of the pillar scene are convex");
  var nearest = 3.4e38f;
  var farthestNear = 0.;
  var minX = 3.4e38f;
  var maxX = -3.4e38f;
  var t = 0usize;
  while t < nav.tiles.len() {
    let tile = &nav.tiles[t];
    var p = 0usize;
    while p < tile.polyCount() {
      var e = 0usize;
      while e < usize.from(*tile.pcount[p]) {
        let v = tile.vertOf(p, e);
        let d = (Vec3(v.x - 6., 0., v.z - 6.)).length();
        if d < nearest { nearest = d; }
        if v.x < minX { minX = v.x; }
        if v.x > maxX { maxX = v.x; }
        e = e + 1usize;
      }
      p = p + 1usize;
    }
    t = t + 1usize;
  }
  // no vertex nearer the pillar's centre than its radius plus the agent's
  expectBool(nearest >= 1. + 0.4, true, "no polygon vertex nearer the pillar than radius + agent radius");
  // and the clearance is not wasted: within a cell or two beyond the eroded radius
  expectBool(nearest <= 1. + 0.4 + 0.9, true, "clearance no more than radius + 3 cells");
  // the world's edge: the agent's radius, plus the ledge cell and erosion's rounding
  expectBool(minX >= 0.4 && minX <= 1.3, true, "clear of the floor's west edge");
  expectBool(maxX <= 11.6 && maxX >= 10.7, true, "clear of the floor's east edge");
  // a point in the pillar is moved out to its clearance
  let n = nearestPolyRaw(&nav, Vec3(6., 0., 6.), 3., 3., 3.);
  expectBool(n.found, true, "a polygon near the pillar's centre");
  let dc = (Vec3(n.pos.x - 6., 0., n.pos.z - 6.)).length();
  expectBool(dc >= 1.4 && dc <= 2.4, true, "the closest mesh point to the pillar's centre is clear of it");
  // far from the mesh: none within the box
  expectBool(nearestPolyRaw(&nav, Vec3(50., 0., 50.), 2., 2., 2.).found, false, "nothing near a faraway point");
}

// Slopes, steps and ceilings decide where the mesh is
fn testWalkable() {
  let params = NavParams.standard();
  let filter = QueryFilter.standard();
  let half = Vec3(1., 3., 1.);

  // A step of 0.4 m (under the 0.5 m climb): two floors joined
  {
    var input = NavInput.empty();
    addFloor(&mut input, 0., 0., 8., 8., 0.);
    addFloor(&mut input, 8., 0., 16., 8., 0.4);
    // the riser between them, facing -x (steep, so solid but not walkable)
    input.addTriangle(Vec3(8., 0., 0.), Vec3(8., 0., 8.), Vec3(8., 0.4, 0.), AreaNull);
    input.addTriangle(Vec3(8., 0.4, 0.), Vec3(8., 0., 8.), Vec3(8., 0.4, 8.), AreaNull);
    let nav = buildNavMesh(&mut input, &params);
    let r = findRoute(&nav, Vec3(2., 0., 4.), Vec3(14., 0.4, 4.), half, &filter);
    expectBool(r.found && !r.partial, true, "a 0.4 m step can be climbed");
  }
  // A step of 1.0 m is a wall
  {
    var input = NavInput.empty();
    addFloor(&mut input, 0., 0., 8., 8., 0.);
    addFloor(&mut input, 8., 0., 16., 8., 1.0);
    input.addTriangle(Vec3(8., 0., 0.), Vec3(8., 0., 8.), Vec3(8., 1., 0.), AreaNull);
    input.addTriangle(Vec3(8., 1., 0.), Vec3(8., 0., 8.), Vec3(8., 1., 8.), AreaNull);
    let nav = buildNavMesh(&mut input, &params);
    let r = findRoute(&nav, Vec3(2., 0., 4.), Vec3(14., 1., 4.), half, &filter);
    expectBool(r.found && !r.partial, false, "a 1.0 m step cannot");
  }
  // A ramp of 30 degrees up 2 m over 3.46 m is walkable; one of 60 degrees is not
  {
    var input = NavInput.empty();
    addFloor(&mut input, 0., 0., 6., 8., 0.);
    // the ramp from x = 6 to 9.464 rising 2 m (30 degrees), then a plateau
    input.addTriangle(Vec3(6., 0., 0.), Vec3(6., 0., 8.), Vec3(9.464, 2., 0.), AreaGround);
    input.addTriangle(Vec3(9.464, 2., 0.), Vec3(6., 0., 8.), Vec3(9.464, 2., 8.), AreaGround);
    addFloor(&mut input, 9.464, 0., 16., 8., 2.);
    let nav = buildNavMesh(&mut input, &params);
    let r = findRoute(&nav, Vec3(2., 0., 4.), Vec3(14., 2., 4.), half, &filter);
    expectBool(r.found && !r.partial, true, "a 30 degree ramp can be walked");
    // the route climbs: its end is 2 m up, and the corners on the way are monotonic in height
    let last = (*r.points[r.points.len() - 1usize]).pos;
    near(last.y, 2., 0.45, "the route ends on the plateau");
  }
  {
    var input = NavInput.empty();
    addFloor(&mut input, 0., 0., 6., 8., 0.);
    // 60 degrees: rises 3.464 over 2 m
    input.addTriangle(Vec3(6., 0., 0.), Vec3(6., 0., 8.), Vec3(8., 3.464, 0.), AreaGround);
    input.addTriangle(Vec3(8., 3.464, 0.), Vec3(6., 0., 8.), Vec3(8., 3.464, 8.), AreaGround);
    addFloor(&mut input, 8., 0., 16., 8., 3.464);
    let nav = buildNavMesh(&mut input, &params);
    let r = findRoute(&nav, Vec3(2., 0., 4.), Vec3(14., 3.464, 4.), half, &filter);
    expectBool(r.found && !r.partial, false, "a 60 degree slope cannot");
  }
  // A ceiling of 1.5 m across the way leaves less than the agent's height
  {
    var input = NavInput.empty();
    addFloor(&mut input, 0., 0., 14., 8., 0.);
    // a plate at y = 1.5 across x 5 to 9, all of z, facing down (clockwise from above)
    input.addTriangle(Vec3(5., 1.5, 0.), Vec3(9., 1.5, 0.), Vec3(5., 1.5, 8.), AreaNull);
    input.addTriangle(Vec3(9., 1.5, 0.), Vec3(9., 1.5, 8.), Vec3(5., 1.5, 8.), AreaNull);
    let nav = buildNavMesh(&mut input, &params);
    let r = findRoute(&nav, Vec3(2., 0., 4.), Vec3(12., 0., 4.), half, &filter);
    expectBool(r.found && !r.partial, false, "a 1.5 m ceiling blocks a 1.8 m agent");
  }
  // The same plate at 2.2 m leaves room
  {
    var input = NavInput.empty();
    addFloor(&mut input, 0., 0., 14., 8., 0.);
    input.addTriangle(Vec3(5., 2.2, 0.), Vec3(9., 2.2, 0.), Vec3(5., 2.2, 8.), AreaNull);
    input.addTriangle(Vec3(9., 2.2, 0.), Vec3(9., 2.2, 8.), Vec3(5., 2.2, 8.), AreaNull);
    let nav = buildNavMesh(&mut input, &params);
    let r = findRoute(&nav, Vec3(2., 0., 4.), Vec3(12., 0., 4.), half, &filter);
    expectBool(r.found && !r.partial, true, "a 2.2 m ceiling does not");
  }
}

// A rolling heightfield: the path follows the ground
fn testHeightfield() {
  var input = NavInput.empty();
  let n = 21i32;
  var hs = List[f32].empty();
  var j = 0i32;
  while j < n {
    var i = 0i32;
    while i < n {
      // a gentle ridge across z: height 1 m at most, slopes far under 45 degrees
      hs.push(0.5 * sin(f32.from(i) * 0.3));
      i = i + 1i32;
    }
    j = j + 1i32;
  }
  input.addHeightfield(0., 0., 1., n, n, hs.view(), AreaGround);
  let params = NavParams.standard();
  let nav = buildNavMesh(&mut input, &params);
  checkPolygons(&nav, "heightfield polygons are convex");
  let filter = QueryFilter.standard();
  let r = findRoute(&nav, Vec3(2., 0., 10.), Vec3(18., 0., 10.), Vec3(1., 5., 1.), &filter);
  expectBool(r.found, true, "a route over the heightfield");
  // every corner within a cell height or two of the true surface
  var worst = 0.f;
  var i = 0usize;
  while i < r.points.len() {
    let p = (*r.points[i]).pos;
    let want = 0.5 * sin(p.x * 0.3);
    if (p.y - want).abs() > worst { worst = (p.y - want).abs(); }
    i = i + 1usize;
  }
  expectBool(worst < 0.45, true, "corners follow the ground height to within the voxel quantisation");
}

// The distance from (x, z) to the box centred (cx, cz) of half extents hx, hz
// turned 'yaw' (x towards -z), by rotating the point into the box's frame
fn boxDistance(x: f32, z: f32, cx: f32, cz: f32, hx: f32, hz: f32, yaw: f32) f32 {
  let c = cos(yaw);
  let s = sin(yaw);
  let dx = x - cx;
  let dz = z - cz;
  let lx = c * dx - s * dz;
  let lz = s * dx + c * dz;
  let ex = if lx.abs() > hx { lx.abs() - hx } else { 0. };
  let ez = if lz.abs() > hz { lz.abs() - hz } else { 0. };
  (ex * ex + ez * ez).sqrt()
}

// A box turned 30 degrees: its footprint tests agree with sampling, and the
// mesh keeps the agent's radius from it
fn testRotated() {
  let yaw = 0.5235988f;
  var o = Obstacle(1u32, ObstacleBox, 5., 5., 2., 0.5, yaw, 0., 3., AreaNull, true);
  var missed = 0i32;
  var grazed = 0i32;
  var cellsTouched = 0i32;
  var cx = 0i32;
  while cx < 40i32 {
    var cz = 0i32;
    while cz < 40i32 {
      let x = 1. + f32.from(cx) * 0.2 + 0.1;
      let z = 1. + f32.from(cz) * 0.2 + 0.1;
      // any of 6 x 6 sample points of the 0.2 square inside the box?
      var anyIn = false;
      var sx = 0i32;
      while sx < 6i32 {
        var sz = 0i32;
        while sz < 6i32 {
          if o.containsPoint(x - 0.1 + 0.2 * (f32.from(sx) + 0.5) / 6., z - 0.1 + 0.2 * (f32.from(sz) + 0.5) / 6.) { anyIn = true; }
          sz = sz + 1i32;
        }
        sx = sx + 1i32;
      }
      let touches = o.touchesSquare(x, z, 0.2);
      if anyIn && !touches { missed = missed + 1i32; }
      if touches && !anyIn { grazed = grazed + 1i32; }
      if touches { cellsTouched = cellsTouched + 1i32; }
      cz = cz + 1i32;
    }
    cx = cx + 1i32;
  }
  expectInt(i64.from(missed), 0, "no cell with a point inside the box is missed (conservative)");
  expectBool(grazed < 30i32, true, "few cells are touched with no sample inside (tight)");
  // area: 4 x 1 = 4 m2 = 100 cells of 0.04; the touched cells are those plus a rim
  expectBool(cellsTouched >= 100i32 && cellsTouched < 190i32, true, "touched cells are the area plus a rim");

  // in a mesh
  var input = NavInput.empty();
  input.addTriangle(Vec3(0., 0., 0.), Vec3(0., 0., 10.), Vec3(10., 0., 0.), AreaGround);
  input.addTriangle(Vec3(10., 0., 0.), Vec3(0., 0., 10.), Vec3(10., 0., 10.), AreaGround);
  input.addBoxObstacle(5., 5., 2., 0.5, yaw, 0., 3., AreaNull);
  let params = NavParams.standard();
  let nav = buildNavMesh(&mut input, &params);
  var nearest = 3.4e38f;
  var t = 0usize;
  while t < nav.tiles.len() {
    var i = 0usize;
    while i < nav.tiles[t].verts.len() {
      let v = *nav.tiles[t].verts[i];
      let d = boxDistance(v.x, v.z, 5., 5., 2., 0.5, yaw);
      if d < nearest { nearest = d; }
      i = i + 1usize;
    }
    t = t + 1usize;
  }
  expectBool(nearest >= 0.4, true, "no polygon vertex nearer the turned box than the agent's radius");
  expectBool(nearest <= 1.1, true, "and the clearance is not wasted");

  // a thin wall across a slant leaks nothing
  var input2 = NavInput.empty();
  input2.addTriangle(Vec3(0., 0., 0.), Vec3(0., 0., 10.), Vec3(20., 0., 0.), AreaGround);
  input2.addTriangle(Vec3(20., 0., 0.), Vec3(0., 0., 10.), Vec3(20., 0., 10.), AreaGround);
  input2.addBoxObstacle(10., 5., 14., 0.05, -0.6, 0., 3., AreaNull);
  let nav2 = buildNavMesh(&mut input2, &params);
  let filter = QueryFilter.standard();
  let r = findRoute(&nav2, Vec3(3., 0., 8.), Vec3(17., 0., 2.), Vec3(1., 3., 1.), &filter);
  expectBool(r.found && !r.partial, false, "a thin slanted wall is a closed barrier");
  let same = findRoute(&nav2, Vec3(3., 0., 8.), Vec3(3., 0., 9.5), Vec3(1., 3., 1.), &filter);
  expectBool(same.found && !same.partial, true, "while its own side is connected");
}

fn main() i32 {
  testRotated();
  testClearance();
  testWalkable();
  testHeightfield();
  done()
}
