// The fs package: files and folders, synchronously. A file is read or
// written whole, or mapped into memory for reading; a folder is made, listed, walked and removed; a file's size,
// time and kind are asked; and the current folder is read and changed.
//
//   mod notes;
//   import stdio use *;
//   import collections use *;
//   import fs;
//
//   fn main() i32 {
//     mut text = String.empty();
//     match fs.readFile("notes.txt") {
//       case mut ok Ok { text <=> ok; }             // the String moved out
//       case imm e Error {
//         imm m = e.message();                     // 'readFile notes.txt: No such file or directory'
//         eprintStr(m.view());
//         return 1i32;
//       }
//     }
//     text.append("another line\n");
//     imm wrote = fs.writeFile("notes.txt", text.view());
//     if wrote is Error { return 1i32; }
//     0i32;
//   }
//
// 'examples/sizes.cone' walks a folder and prints each file's size.
//
// **Failure.** Everything that can fail answers a core 'Result': 'Ok' with
// the value ('Result[void, FsError]' where there is none, its 'Ok' holding
// 'nil'), or 'Error' with an 'FsError', which says what was being done
// ('op', the function's name), to which path ('path', and 'other' for the
// second path of 'rename'), and why ('code', the C library's errno, a posix
// 'E...' constant). Its 'message()' is one line to show a person,
// 'readFile notes.txt: No such file or directory', and 'notFound()' asks the
// commonest question about it. A path holding a NUL byte, which C would read
// as its end, fails with EINVAL before anything is asked of the system.
// Cone has no '?' yet, so a caller matches each Result; a value is moved out
// of a matched 'Ok' by swapping an empty one in ('text <=> ok').
// Asking whether something is there is not a failure: 'exists', 'isDir' and
// 'isFile' answer a bool, false for anything they cannot see.
//
// **Paths** are the 'path' package's 'Path': a function that opens or names a
// file takes a '&Path', and nothing else. A string literal written where one
// is wanted is made one ('fs.readFile("notes.txt")'), and a 'Path' in a
// variable is lent, not given away: the call leaves it as it was. Any other
// text is made a Path first, 'Path.from(s)'. '/' separates names, and on Windows
// '\' too (the 'path' package's rules for the system). A path
// the package makes (a listed entry's 'path', and each one 'walk' gives) is the
// folder's path as given joined to the name by 'Path.join', a '/' between them
// unless the folder's path ends in a separator; 'currentDir' and 'absolute'
// answer a normalized 'Path', every separator '/' ('C:/work/notes.txt'),
// which the C runtime and Windows take everywhere. Relative paths are read from
// the current folder.
//
// **UTF-8 names.** The first call that hands a path to the C runtime sets
// the C library's character type (LC_CTYPE) to UTF-8 when the program has
// left it at C's default, "C". On Windows that is what makes the runtime read
// and answer file names as UTF-8 (without it, 'é' names some other file);
// it changes nothing else: numbers, dates and sorting keep C's own forms.
// A program that has chosen a character type of its own keeps it. On POSIX
// a name is its bytes, which the system takes as they are, and nothing is set.
//
// **Links.** 'stat', 'isDir' and 'isFile' follow a symbolic link to what it
// names, as POSIX's 'stat' does. A listing does not: an entry that is a link
// says so ('isLink'), and is then neither a folder nor a file. 'walk' never
// goes down into a linked folder, and 'removeAll' removes a link itself,
// never what it leads to. On Windows a link is any reparse point: a
// symbolic link or a directory junction, and also some cloud-storage
// placeholders, which are then left whole.
//
// **Mapped files.** 'mapFile(path)' maps a whole file for reading and answers a
// 'MappedFile': one owner, moved, whose 'view()' is the file's bytes in place
// (a '&Array[u8]'), 'size()' their count, 'isEmpty()', and 'base()' the address
// of the first byte for handing on (a GPU upload). Its death unmaps the view;
// no file stays open. The OS reads a page when it is first touched, so a file
// far larger than memory (a multi-gigabyte model's weights) is mapped at no
// cost and only what is read is loaded. Sizes and offsets are 64 bits whole:
// a file past 4 GB is mapped as any other (the test mapfile_big.cone maps a
// sparse one with markers either side of 4 GiB and past 5 GiB). It is Sendable,
// and an 'Arc[imm, MappedFile]' shares one among threads.
//
//   match fs.mapFile("model.bin") {
//     case imm m Ok { imm w = m.view(); ... w[0usize] ... }   // read in place, nothing copied
//     case imm e Error { ... }                                // as readFile's
//   }
//
// Method choices (defaults for review, not rulings):
// - The whole file, read-only, private: no writable map, no map of a byte
//   range, no offset. A range is a sub-slice of the view; the OS pages in only
//   what is touched, so mapping all of a file costs only address space.
//   Not here: writable maps (and flushing them), mapping a range, 'madvise'
//   and MAP_POPULATE (Linux), prefetch and large pages (Windows), locking
//   pages in memory.
// - Failures are 'FsError's with the C library's error numbers, as everything
//   here: a file not there ENOENT, a folder EISDIR (also on Linux, where
//   fopen would open one), anything but a regular file EINVAL, a NUL in the
//   path EINVAL, a refused mapping (no address space) ENOMEM or the system's
//   own errno. Windows' error numbers are translated (ERROR_FILE_NOT_FOUND to
//   ENOENT, and so on; one with no counterpart is EIO).
// - The file is opened through the C runtime's 'fopen' (mode "rb"), as
//   'readFile' does, so its path, UTF-8 names and failures are exactly
//   readFile's; the OS handle under the stream (Windows: _get_osfhandle of
//   _fileno; Linux: fileno) is what is mapped, and the stream is closed as soon
//   as the map is made.
// - Windows: GetFileSizeEx, CreateFileMappingW (PAGE_READONLY, the size given
//   as its high and low halves), MapViewOfFile (FILE_MAP_READ, the whole
//   file), then the mapping object's handle is closed at once; the view keeps
//   the file. Linux: the size is lseek's end offset (64 bits), then mmap
//   (PROT_READ, MAP_PRIVATE, offset 0). The Windows externs are kernel32's,
//   on every link line already; the rest is the C library's.
// - An empty file is an empty view with no address, since the OS cannot map no
//   bytes.
// - The size is the file's when mapped. A file made shorter while mapped, by
//   this program or another, faults when the lost part is read (SIGBUS on
//   Linux, an in-page error on Windows), and Windows refuses to remove,
//   rename or truncate a file while it is mapped; a map that must not hold
//   its file keeps the file alone or is dropped first.
//
// **What differs by system.** The package itself is written over ISO C (libc's
// 'fopen', 'fread', 'fwrite', 'rename') and POSIX (posix's 'stat', 'lstat',
// 'unlink', 'mkdir', 'rmdir', 'getcwd', 'chdir', 'realpath', 'opendir',
// 'readdir'), and holds nothing of Windows' own, except 'absolute' on POSIX,
// which reads the path's text (below), and 'mapFile', which asks kernel32 for
// the mapping itself (above). What is Windows' is beneath it: the
// posix package maps those names onto the Windows C runtime, and its
// 'opendir', 'readdir' and 'lstat' are written over the runtime's
// '_findfirst64'. The 'path' rules it relies on are the system's own (drive
// letters, shares and '\' on Windows). Where Windows behaves differently from
// POSIX it is said beside the function: 'rename' replaces an existing file on
// POSIX and is refused on Windows, a name is one name whatever its ASCII case
// on Windows only, and 'modified' (a time.Timestamp) is in whole seconds on
// both.

mod fs;

import libc;
import posix;
import collections use String, List;
import path use Path;
import sync;
import time;

// -------- failure --------

// Why an operation failed: what was being done, to which path, and the C
// library's error number
pub struct FsError {
  // The function that failed: "readFile", "makeDir", ...
  pub op: String;
  // The path it was given
  pub path: Path;
  // The second path, 'rename''s 'to'; empty for the others
  pub other: Path;
  // The C library's errno: posix.ENOENT, posix.EACCES, ...
  pub code: i32;

  // One line for a person: 'readFile notes.txt: No such file or directory',
  // or 'rename a.txt to b.txt: File exists'
  pub fn message(self: &) String {
    var out = String.from(op.view());
    if !path.isEmpty() {
      out.append(" ");
      out.append(path.view());
    }
    if !other.isEmpty() {
      out.append(" to ");
      out.append(other.view());
    }
    out.append(": ");
    out.append(libc.strerror(code).view());
    out
  }

  // Whether it failed because nothing has that name (ENOENT)
  pub fn notFound(self: &) bool { code == posix.ENOENT }

  // Whether it failed because something already has that name (EEXIST)
  pub fn alreadyExists(self: &) bool { code == posix.EEXIST }
}

fn failure(op: &str, p: &Path, code: i32) FsError {
  FsError(String.from(op), p.copy(), Path.from(""), code)
}

fn fail[T](op: &str, p: &Path, code: i32) Result[T, FsError] {
  Error[T, FsError](failure(op, p, code))
}

fn succeeded() Result[void, FsError] { Ok[void, FsError](nil) }

// The error number the last C call left
fn lastErrno() i32 { *libc.errno() }

// Whether a path holds a NUL byte, which a C function would take as its end
fn hasNul(path: &Path) bool {
  let p: &Array[u8] = path.view();
  var i = 0usize;
  while i < p.len {
    if p[i] == 0u8 { return true; }
    i = i + 1usize;
  }
  false
}

// A path's text as a String, which C reads: the NUL-checked copy every call
// into the C runtime is given
fn cText(path: &Path) String { String.from(path.view()) }

// -------- UTF-8 names --------

// Run by the first call that needs it. A thread that arrives meanwhile waits
// until it is done, so none reaches the C runtime before the names are set
let utf8Once: sync.Once;

fn @initpure init() {
  utf8Once = sync.Once.make();
}

// Make the C runtime read names as UTF-8, unless the program has chosen a
// character type of its own. Once is enough.
fn useUtf8() {
  utf8Once.callOnce(&setUtf8);
}

fn setUtf8() {
  // POSIX hands a name's bytes to the system as they are
  if !isWindows() { return; }
  let now = libc.setlocale(libc.LC_CTYPE, null);
  if now != null && libc.strcmp(cstr.fromPtr(now), "C") == 0i32 {
    libc.setlocale(libc.LC_CTYPE, &".UTF-8" as *u8);
  }
}

// -------- status --------

// What 'stat' tells of a file or folder
pub struct FileInfo {
  // Its size in bytes; 0 for a folder
  pub size: i64;
  // When it was last written, a Timestamp of the time package (UTC), in
  // whole seconds: the C runtime's stat counts no finer
  pub modified: time.Timestamp;
  pub isDir: bool;
  // A regular file: not a folder, a device or anything else
  pub isFile: bool;
}

fn emptyStat() posix.Stat {
  posix.Stat(0u64, 0u64, 0u16, 0u32, 0u32, 0u32, 0u64, 0i64, 0i64, 0i64, 0i64)
}

// The size, time and kind of what a path names, following a link
pub fn stat(path: &Path) Result[FileInfo, FsError] {
  if hasNul(path) { return fail[FileInfo]("stat", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  var st = emptyStat();
  if posix.stat(c.cstr(), &mut st) != 0i32 { return fail[FileInfo]("stat", path, lastErrno()); }
  let kind = st.st_mode & posix.S_IFMT;
  Ok[FileInfo, FsError](FileInfo(st.st_size, time.Timestamp.fromUnixSeconds(st.st_mtime),
    kind == posix.S_IFDIR, kind == posix.S_IFREG))
}

// The file-type bits of what a path names, or 0 when it cannot be seen
fn kindOf(path: &Path) u16 {
  if hasNul(path) { return 0u16; }
  useUtf8();
  var c = cText(path);
  var st = emptyStat();
  if posix.stat(c.cstr(), &mut st) != 0i32 { return 0u16; }
  st.st_mode & posix.S_IFMT
}

// The file-type bits of what a path names, not following a link, or 0 when
// it cannot be seen
fn linkKindOf(path: &Path) u16 {
  var c = cText(path);
  var st = emptyStat();
  if posix.lstat(c.cstr(), &mut st) != 0i32 { return 0u16; }
  st.st_mode & posix.S_IFMT
}

// Whether anything has that name
pub fn exists(path: &Path) bool { kindOf(path) != 0u16 }

// Whether a folder has that name
pub fn isDir(path: &Path) bool { kindOf(path) == posix.S_IFDIR }

// Whether a regular file has that name
pub fn isFile(path: &Path) bool { kindOf(path) == posix.S_IFREG }

// -------- whole files --------

// The error number for a file that would not open: Windows answers EACCES
// for a folder, which is EISDIR in POSIX's terms. Called straight after the
// failure, before errno changes.
fn openErrno(path: &Path) i32 {
  let code = lastErrno();
  if code == posix.EACCES && isDir(path) {posix.EISDIR} else {code}
}

// The whole of a file, its bytes as they are: text or not, NULs included
pub fn readFile(path: &Path) Result[String, FsError] {
  if hasNul(path) { return fail[String]("readFile", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  let f = libc.fopen(c.cstr(), "rb");
  if f == null { return fail[String]("readFile", path, openErrno(path)); }
  var out = String.empty();
  var buf = Array[u8, 65536]() <- fill 0u8;
  let bp: *u8 = &[]buf as *u8;
  var going = true;
  while going {
    let n = libc.fread(bp, 1usize, 65536usize, f);
    if n > 0usize { out.appendBytes(mem.sliceFromParts(bp, n)); }
    going = n == 65536usize;
  }
  let broke = libc.ferror(f) != 0i32;
  let code = lastErrno();
  libc.fclose(f);
  if broke { return fail[String]("readFile", path, code); }
  Ok[String, FsError](out)
}

// Open with mode, write data, close; a failure anywhere is op's
fn writeWith(op: &str, path: &Path, data: &Array[u8], mode: cstr) Result[void, FsError] {
  if hasNul(path) { return fail[void](op, path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  let f = libc.fopen(c.cstr(), mode);
  if f == null { return fail[void](op, path, openErrno(path)); }
  let wrote = if data.len > 0usize {libc.fwrite(data as *u8, 1usize, data.len, f)} else {0usize};
  let code = lastErrno();
  let closed = libc.fclose(f);
  if wrote != data.len { return fail[void](op, path, code); }
  if closed != 0i32 { return fail[void](op, path, lastErrno()); }
  succeeded()
}

// Make the file hold exactly data, making it if it is not there and
// replacing what it held if it is
pub fn writeFile(path: &Path, data: &Array[u8]) Result[void, FsError] {
  writeWith("writeFile", path, data, "wb")
}

// Add data to the end of the file, making it if it is not there
pub fn appendFile(path: &Path, data: &Array[u8]) Result[void, FsError] {
  writeWith("appendFile", path, data, "ab")
}

// -------- mapped files --------

// What the OS is asked for. Every extern is declared on every system;
// 'isWindows()', a constant of the compile, chooses, so only the target's calls
// are generated.
extern {
  // Windows: kernel32 (on every link line), and the C runtime's way from a
  // stream to the handle under it
  fn @c(system) GetFileSizeEx(h: usize, size: &mut i64) i32;
  fn @c(system) CreateFileMappingW(h: usize, attrs: *u8, protect: u32, sizeHigh: u32, sizeLow: u32,
    name: *u16) usize;
  fn @c(system) MapViewOfFile(map: usize, access: u32, offHigh: u32, offLow: u32, bytes: usize) *u8;
  fn @c(system) UnmapViewOfFile(base: *u8) i32;
  fn @c(system) CloseHandle(h: usize) i32;
  fn @c(system) GetLastError() u32;
  fn @c _fileno(stream: *libc.FILE) i32;
  fn @c _get_osfhandle(fd: i32) isize;
  // Linux: the C library's
  fn @c fileno(stream: *libc.FILE) i32;
  fn @c lseek(fd: i32, offset: i64, whence: i32) i64;
  fn @c mmap(addr: *u8, size: usize, protect: i32, flags: i32, fd: i32, offset: i64) *u8;
  fn @c munmap(addr: *u8, size: usize) i32;
}

const pageReadonly = 0x02u32;       // PAGE_READONLY
const fileMapRead = 0x04u32;        // FILE_MAP_READ
const seekEnd = 2i32;               // SEEK_END
const protRead = 1i32;              // PROT_READ
const mapPrivate = 2i32;            // MAP_PRIVATE
const mmapFailed = 0xFFFFFFFFFFFFFFFFusize;     // MAP_FAILED, (void*)-1

// The POSIX error number for a Windows error number from the calls above
fn errnoOfWindows(code: u32) i32 {
  if code == 2u32 || code == 3u32 { posix.ENOENT }                  // file / path not found
  elif code == 5u32 || code == 32u32 || code == 33u32 { posix.EACCES }  // denied, sharing, lock
  elif code == 8u32 || code == 14u32 || code == 1450u32 || code == 1455u32 || code == 1453u32 {
    posix.ENOMEM       // not enough memory, address space or system resources
  }
  elif code == 87u32 { posix.EINVAL }
  else { posix.EIO }
}

// A read-only view of a whole file's bytes, held by the OS's memory mapping:
// one owner, moved, never copied. 'view' lends the bytes, in place, as a
// '&Array[u8]'; the OS reads a page from the file when it is first touched, so
// a file larger than memory costs nothing to map and only what is read is
// loaded. Its death unmaps the view; the file itself is not held open. It
// declares Sendable, a promise taken on trust, for its raw pointer: the view is
// the owner's alone and read-only, so it may be handed to another thread, and
// 'Arc[imm, MappedFile]' shares it among threads.
pub struct MappedFile is Move, Sendable {
  ptr: *u8;          // the view's first byte; null for an empty file
  bytes: usize;      // the file's size when it was mapped

  fn empty() MappedFile { MappedFile(null, 0usize) }

  // The file's size in bytes, as it was when mapped
  pub fn size(self: &) usize { bytes }

  // Whether the file held nothing
  pub fn isEmpty(self: &) bool { bytes == 0usize }

  // The file's bytes, in place: a view as long as 'size()', good while this
  // owner lives
  pub fn view(self: &) &Array[u8] { mem.sliceFromParts(ptr, bytes) }

  // The address of the first byte (null for an empty file), for handing the
  // mapping on, to a GPU upload for instance. Good while this owner lives.
  pub fn base(self: &) *u8 { ptr }

  // Unmap the view
  fn final(self: &uni) {
    if ptr as usize != 0usize {
      if isWindows() { UnmapViewOfFile(ptr); } else { munmap(ptr, bytes); }
    }
  }
}

// Map a file for reading, whole. A file that is not there, a folder, anything
// that is not a regular file, or one that cannot be read is refused, as
// 'readFile' refuses it. An empty file is mapped as an empty view (the OS
// cannot map no bytes). The file must stay as long as the mapping does: one
// that is truncated while mapped, by this program or another, makes a read of
// the lost part fault (SIGBUS on Linux, an in-page error on Windows), and
// Windows refuses to remove or rename a mapped file.
pub fn mapFile(path: &Path) Result[MappedFile, FsError] {
  if hasNul(path) { return fail[MappedFile]("mapFile", path, posix.EINVAL); }
  useUtf8();
  let kind = kindOf(path);
  if kind == posix.S_IFDIR { return fail[MappedFile]("mapFile", path, posix.EISDIR); }
  if kind != 0u16 && kind != posix.S_IFREG { return fail[MappedFile]("mapFile", path, posix.EINVAL); }
  var c = cText(path);
  let f = libc.fopen(c.cstr(), "rb");
  if f == null { return fail[MappedFile]("mapFile", path, openErrno(path)); }
  // The mapping holds the file once made, so the stream can go at once
  let mapped = if isWindows() {mapWindows(path, f)} else {mapLinux(path, f)};
  libc.fclose(f);
  mapped
}

// Windows: size the file, make a file-mapping object over it, map a view of
// the whole of it, and let the object go (the view keeps the file)
fn mapWindows(path: &Path, f: *libc.FILE) Result[MappedFile, FsError] {
  let h = _get_osfhandle(_fileno(f)) as usize;
  var size = 0i64;
  if GetFileSizeEx(h, &mut size) == 0i32 {
    return fail[MappedFile]("mapFile", path, errnoOfWindows(GetLastError()));
  }
  if size == 0i64 { return Ok[MappedFile, FsError](MappedFile.empty()); }
  // The size as the two halves Windows takes it in
  let n = u64.from(size);
  let map = CreateFileMappingW(h, null, pageReadonly, u32.from(n >> 32u64),
    u32.from(n & 0xFFFFFFFFu64), null);
  if map == 0usize { return fail[MappedFile]("mapFile", path, errnoOfWindows(GetLastError())); }
  let view = MapViewOfFile(map, fileMapRead, 0u32, 0u32, usize.from(n));
  let code = GetLastError();
  CloseHandle(map);
  if view as usize == 0usize { return fail[MappedFile]("mapFile", path, errnoOfWindows(code)); }
  Ok[MappedFile, FsError](MappedFile(view, usize.from(n)))
}

// Linux: the size is the offset of the end; map it private and read-only
fn mapLinux(path: &Path, f: *libc.FILE) Result[MappedFile, FsError] {
  let fd = fileno(f);
  let end = lseek(fd, 0i64, seekEnd);
  if end < 0i64 { return fail[MappedFile]("mapFile", path, lastErrno()); }
  if end == 0i64 { return Ok[MappedFile, FsError](MappedFile.empty()); }
  let n = usize.from(end);
  let view = mmap(null, n, protRead, mapPrivate, fd, 0i64);
  if view as usize == mmapFailed { return fail[MappedFile]("mapFile", path, lastErrno()); }
  Ok[MappedFile, FsError](MappedFile(view, n))
}

// -------- names --------

// Give a file or folder another name, which may be in another folder on the
// same volume. Where 'to' is already there, POSIX replaces it; Windows
// refuses, EEXIST for a file and EACCES for a folder, and nothing changes.
pub fn rename(from: &Path, to: &Path) Result[void, FsError] {
  if hasNul(from) || hasNul(to) {
    return Error[void, FsError](FsError(String.from("rename"), from.copy(), to.copy(), posix.EINVAL));
  }
  useUtf8();
  var a = cText(from);
  var b = cText(to);
  if libc.rename(a.cstr(), b.cstr()) != 0i32 {
    return Error[void, FsError](FsError(String.from("rename"), from.copy(), to.copy(), lastErrno()));
  }
  succeeded()
}

// Remove a file. A folder is refused (EISDIR): 'removeDir' or 'removeAll'
pub fn removeFile(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("removeFile", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  if posix.unlink(c.cstr()) != 0i32 { return fail[void]("removeFile", path, openErrno(path)); }
  succeeded()
}

// -------- folders --------

// Make a folder, whose parent must be there. One already there is refused
// (EEXIST).
pub fn makeDir(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("makeDir", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  if posix.mkdir(c.cstr(), 0x1FFu32) != 0i32 { return fail[void]("makeDir", path, lastErrno()); }
  succeeded()
}

// Make a folder and every folder above it that is not there yet. A folder
// already there is success; a file in the way is refused (ENOTDIR), and so
// is a parent that cannot be made, whose error names it.
pub fn makeDirAll(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("makeDirAll", path, posix.EINVAL); }
  let kind = kindOf(path);
  if kind == posix.S_IFDIR { return succeeded(); }
  if kind != 0u16 { return fail[void]("makeDirAll", path, posix.ENOTDIR); }
  let up = path.parent();
  if !up.isEmpty() && up.view() != path.view() {
    let made = makeDirAll(&up);
    if made is Error { return made; }
  }
  var c = cText(path);
  if posix.mkdir(c.cstr(), 0x1FFu32) != 0i32 {
    let code = lastErrno();
    // Made meanwhile by someone else, or named with a '..' that mkdir read
    if !isDir(path) { return fail[void]("makeDirAll", path, code); }
  }
  succeeded()
}

// Remove an empty folder. One with anything in it is refused (ENOTEMPTY).
pub fn removeDir(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("removeDir", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  if posix.rmdir(c.cstr()) != 0i32 { return fail[void]("removeDir", path, lastErrno()); }
  succeeded()
}

// One entry of a folder
pub struct DirEntry {
  // Its name in the folder
  pub name: String;
  // The folder's path as given joined to the name: 'src/main.cone'
  pub path: Path;
  pub isDir: bool;
  // A regular file
  pub isFile: bool;
  // A link, which is neither a folder nor a file here: 'stat' its path to
  // learn what it leads to
  pub isLink: bool;
}

fn byName(a: &DirEntry, b: &DirEntry) i32 { a.name.compare(b.name.view()) }

// What a folder holds, '.' and '..' left out, sorted by name, byte by byte
// (so 'B' before 'a', and a UTF-8 name by its bytes). A path that is not a
// folder is refused (ENOTDIR).
pub fn readDir(path: &Path) Result[List[DirEntry], FsError] {
  if hasNul(path) { return fail[List[DirEntry]]("readDir", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  let dir = posix.opendir(c.cstr());
  if dir == null { return fail[List[DirEntry]]("readDir", path, lastErrno()); }
  var out = List[DirEntry].empty();
  *libc.errno() = 0i32;
  var e = posix.readdir(dir);
  while e != null {
    let entry = e as &posix.dirent;
    let np: *u8 = &[]entry.d_name as *u8;
    let name = cstr.fromPtr(np).view();
    if name != "." && name != ".." {
      var t = entry.d_type;
      let full = path.join(name);
      // A file system that does not say what an entry is (POSIX allows it)
      // is asked, by the entry's own status, link or not
      if t == posix.DT_UNKNOWN {
        let kind = linkKindOf(&full);
        t = if kind == posix.S_IFLNK {posix.DT_LNK} elif kind == posix.S_IFDIR {posix.DT_DIR}
          elif kind == posix.S_IFREG {posix.DT_REG} else {posix.DT_UNKNOWN};
      }
      out.push(DirEntry(String.from(name), full,
        t == posix.DT_DIR, t == posix.DT_REG, t == posix.DT_LNK));
    }
    e = posix.readdir(dir);
  }
  let code = lastErrno();
  posix.closedir(dir);
  if code != 0i32 { return fail[List[DirEntry]]("readDir", path, code); }
  out.sortBy(&byName);
  Ok[List[DirEntry], FsError](out)
}

// Every entry below a folder, depth first: each folder's entries in name
// order, each folder's own entries straight after it. The folder itself is
// not among them. Each entry's path is the root as given joined with the
// names down to it. A linked folder is listed but not gone into. The first
// folder that cannot be read ends the walk with its error.
pub fn walk(root: &Path) Result[List[DirEntry], FsError] {
  var out = List[DirEntry].empty();
  let went = walkInto(root, &mut out);
  match went {
    case Error(var e) {
      var err = failure("", "", 0i32);
      err <=> e;
      return Error[List[DirEntry], FsError](err);
    }
    case is Ok {}
  }
  Ok[List[DirEntry], FsError](out)
}

fn walkInto(dir: &Path, out: &mut List[DirEntry]) Result[void, FsError] {
  match readDir(dir) {
    case Error(var e) {
      var err = failure("", "", 0i32);
      err <=> e;
      err.op = String.from("walk");
      return Error[void, FsError](err);
    }
    case Ok(listed) {
      let entries = &listed;
      var i = 0usize;
      while i < entries.len() {
        let entry = entries[i];
        out.push(DirEntry(entry.name.copy(), entry.path.copy(), entry.isDir, entry.isFile, entry.isLink));
        if entry.isDir {
          let below = walkInto(&entry.path, out);
          if below is Error { return below; }
        }
        i = i + 1usize;
      }
    }
  }
  succeeded()
}

// Remove what a path names, and, for a folder, everything in it. A link is
// removed itself, never what it leads to. Nothing there is success. The
// first thing that will not go (a read-only file, a file another program
// has open) ends it with its error, and what was removed before stays
// removed. As a guard against a path made wrongly, a path that is empty, is
// a root or a volume ('C:/', '/', 'C:'), or ends in '.' or '..' is refused
// (EINVAL).
pub fn removeAll(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("removeAll", path, posix.EINVAL); }
  let n = path.normalize();
  let up = n.parent();
  let last = lastName(path);
  if path.isEmpty() || last == "." || last == ".." || n.view() == "."
    || n.view() == ".." || n.view().endsWith("/..") || up.view() == n.view() {
    return fail[void]("removeAll", path, posix.EINVAL);
  }
  useUtf8();
  var c = cText(path);
  var st = emptyStat();
  if posix.lstat(c.cstr(), &mut st) != 0i32 {
    let code = lastErrno();
    if code == posix.ENOENT { return succeeded(); }
    return fail[void]("removeAll", path, code);
  }
  removeTree(path, st.st_mode & posix.S_IFMT)
}

// A path's last name, as written
fn lastName(p: &Path) &str { p.name() }

// Remove what path names, whose kind (from lstat) is given
fn removeTree(path: &Path, kind: u16) Result[void, FsError] {
  if kind == posix.S_IFLNK { return removeLink(path); }
  if kind != posix.S_IFDIR {
    var c = cText(path);
    if posix.unlink(c.cstr()) != 0i32 { return fail[void]("removeAll", path, lastErrno()); }
    return succeeded();
  }
  match readDir(path) {
    case Error(var e) {
      var err = failure("", "", 0i32);
      err <=> e;
      err.op = String.from("removeAll");
      return Error[void, FsError](err);
    }
    case Ok(listed) {
      let entries = &listed;
      var i = 0usize;
      while i < entries.len() {
        let entry = entries[i];
        let childKind = if entry.isLink {posix.S_IFLNK} elif entry.isDir {posix.S_IFDIR} else {posix.S_IFREG};
        let gone = removeTree(&entry.path, childKind);
        if gone is Error { return gone; }
        i = i + 1usize;
      }
    }
  }
  var c = cText(path);
  if posix.rmdir(c.cstr()) != 0i32 { return fail[void]("removeAll", path, lastErrno()); }
  succeeded()
}

// Remove a link itself: a link to a folder goes by rmdir on Windows, and a
// link to a file, or any link on POSIX, by unlink
fn removeLink(path: &Path) Result[void, FsError] {
  var c = cText(path);
  if posix.rmdir(c.cstr()) == 0i32 { return succeeded(); }
  if posix.unlink(c.cstr()) == 0i32 { return succeeded(); }
  fail[void]("removeAll", path, lastErrno())
}

// -------- the current folder --------

// The folder relative paths are read from, normalized ('C:/work')
pub fn currentDir() Result[Path, FsError] {
  useUtf8();
  // A null buffer of size 0: the runtime allocates one as long as it needs
  let got = posix.getcwd(null, 0usize);
  if got == null { return fail[Path]("currentDir", "", lastErrno()); }
  let raw = Path.from(cstr.fromPtr(got).view());
  libc.free(got);
  Ok[Path, FsError](raw.normalize())
}

// Make path the folder relative paths are read from, for the whole program
// (every thread)
pub fn setCurrentDir(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("setCurrentDir", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  if posix.chdir(c.cstr()) != 0i32 { return fail[void]("setCurrentDir", path, lastErrno()); }
  succeeded()
}

// The absolute, normalized path of path, read from the current folder: 'a.txt'
// in 'C:/work' is 'C:/work/a.txt'. Its text is all that is read: whatever is
// or is not there, links are not followed, and '..' drops the name before
// it. "" is the current folder.
pub fn absolute(path: &Path) Result[Path, FsError] {
  if hasNul(path) { return fail[Path]("absolute", path, posix.EINVAL); }
  if path.isEmpty() { return currentDir(); }
  if !isWindows() {
    // POSIX's realpath asks the file system (the path must be there, links
    // are followed); this reads the text alone, as Windows' does: the
    // current folder, then the path, normalized
    match currentDir() {
      case Ok(here) { return Ok[Path, FsError](here.join(path).normalize()); }
      case Error(var e) {
        var err = failure("", "", 0i32);
        err <=> e;
        err.op = String.from("absolute");
        return Error[Path, FsError](err);
      }
    }
  }
  useUtf8();
  var c = cText(path);
  let got = posix.realpath(c.cstr(), null);
  if got == null { return fail[Path]("absolute", path, lastErrno()); }
  let raw = Path.from(cstr.fromPtr(got).view());
  libc.free(got);
  Ok[Path, FsError](raw.normalize())
}
