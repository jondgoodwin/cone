// The fs package: files and folders, synchronously. A file is read or
// written whole, or mapped into memory for reading; a folder is made, listed, walked and removed; a file's size,
// time and kind are asked; and the current folder is read and changed.
//
//   mod notes;
//   import stdio use *;
//   import collections use *;
//   import fs;
//
//   fn main() i32 {
//     var text = String();
//     match fs.readFile("notes.txt") {
//       case let Ok(ok) { text = ok; }              // the String moved out
//       case let Err(e) {
//         let m = String() <- e;                    // 'readFile notes.txt: No such file or directory'
//         eprintStr(m.view());
//         return 1i32;
//       }
//     }
//     text.append("another line\n");
//     imm wrote = fs.writeFile("notes.txt", text.view());
//     if wrote is Err { return 1i32; }
//     0i32;
//   }
//
// 'examples/sizes.cone' walks a folder and prints each file's size.
//
// **Failure.** Everything that can fail answers a core 'Result': 'Ok' with
// the value ('Result[void, FsError]' where there is none, its 'Ok' holding
// 'nil'), or 'Err' with an 'FsError', which says what was being done
// ('op', the function's name), to which path ('path', and 'other' for the
// second path of 'rename'), and why: 'kind()', iocore's IoErrorKind, the
// same on every system (NotFound, PermissionDenied, AlreadyExists, ...; the
// ioerror package's, which iocore's IoError shares), which
// a caller matches on, and 'code', the C library's errno it was read from, a
// posix 'E...' constant, kept for diagnostics. Its text ('String() <- e') is one line to
// show a person, 'readFile notes.txt: No such file or directory', and
// 'notFound()' asks the commonest question about it. A path holding a NUL byte, which C would read
// as its end, fails with EINVAL before anything is asked of the system.
// Cone has no '?' yet, so a caller matches each Result; a value is moved out
// of a matched 'Ok' by binding it ('case let Ok(ok) { text = ok; }').
// 'readBytes' reads a file as a Chain of buffers (iobuf's), with no String between: a caller that needs
// one contiguous block copies it out once ('chain.copyOut'), one that passes the bytes on copies nothing.
// Asking whether something is there is not a failure: 'exists', 'isDir' and
// 'isFile' answer a bool, false for anything they cannot see.
//
// **Paths** are the 'path' package's 'Path': a function that opens or names a
// file takes a '&Path', and nothing else. A string literal written where one
// is wanted is made one ('fs.readFile("notes.txt")'), and a 'Path' in a
// variable is lent, not given away: the call leaves it as it was. Any other
// text is made a Path first, 'Path.from(s)'. '/' separates names, and on Windows
// '\' too (the 'path' package's rules for the system). A path
// the package makes (a listed entry's 'path', and each one 'walk' gives) is the
// folder's path as given joined to the name by 'Path.join', a '/' between them
// unless the folder's path ends in a separator; 'currentDir' and 'absolute'
// answer a normalized 'Path', every separator '/' ('C:/work/notes.txt'),
// which the C runtime and Windows take everywhere. Relative paths are read from
// the current folder.
//
// **UTF-8 names.** The first call that hands a path to the C runtime sets
// the C library's character type (LC_CTYPE) to UTF-8 when the program has
// left it at C's default, "C". On Windows that is what makes the runtime read
// and answer file names as UTF-8 (without it, 'é' names some other file);
// it changes nothing else: numbers, dates and sorting keep C's own forms.
// A program that has chosen a character type of its own keeps it. On POSIX
// a name is its bytes, which the system takes as they are, and nothing is set.
//
// **Links.** 'stat', 'isDir' and 'isFile' follow a symbolic link to what it
// names, as POSIX's 'stat' does. A listing does not: an entry that is a link
// says so ('isLink'), and is then neither a folder nor a file. 'walk' never
// goes down into a linked folder, and 'removeAll' removes a link itself,
// never what it leads to. On Windows a link is any reparse point: a
// symbolic link or a directory junction, and also some cloud-storage
// placeholders, which are then left whole. 'lstat' is 'stat' without
// following, and 'isLink(path)' asks the one question, both through the posix
// package's 'lstat': on Windows the C runtime's '_findfirst64' (over
// FindFirstFile) reading the reparse-point attribute, the very test a
// listing's 'isLink' makes, so 'isLink' and a listing always agree (the
// reparse tag, which would tell a symbolic link from a junction from a
// placeholder, is not read, because this package calls all of them links);
// on Linux the C library's 'lstat'.
//
// **Permissions and times.** 'chmod(path, mode)' sets POSIX permission bits
// (Linux: 'chmod'). Windows has only a read-only attribute, so there 'chmod'
// reads the owner's write bit alone (0o200): set makes the file writable,
// clear makes it read-only (the C runtime's '_chmod'), and the other bits are
// ignored. 'utime(path, accessed, modified)' sets the two times (Linux:
// 'utimensat', nanoseconds kept; Windows: 'SetFileTime' on a handle opened to
// write attributes only, 100 ns kept), as Timestamps of the time package.
// Both follow a link, as POSIX's do.
//
// **Mapped files.** 'mapFile(path)' maps a whole file for reading and answers a
// 'MappedFile': one owner, moved, whose 'view()' is the file's bytes in place
// (a '&Array[u8]'), 'size()' their count, 'isEmpty()', and 'base()' the address
// of the first byte for handing on (a GPU upload). Its death unmaps the view;
// no file stays open. The OS reads a page when it is first touched, so a file
// far larger than memory (a multi-gigabyte model's weights) is mapped at no
// cost and only what is read is loaded. Sizes and offsets are 64 bits whole:
// a file past 4 GB is mapped as any other (the test mapfile_big.cone maps a
// sparse one with markers either side of 4 GiB and past 5 GiB). It is Sendable,
// and an 'Arc[imm, MappedFile]' shares one among threads.
//
//   match fs.mapFile("model.bin") {
//     case imm m Ok { imm w = m.view(); ... w[0usize] ... }   // read in place, nothing copied
//     case imm e Err { ... }                                // as readFile's
//   }
//
// **Open files.** 'open(path)' (read-only) and 'create(path)' (read and write, made or emptied) answer a
// 'File': one owner, moved, closed when it dies, with an unbuffered position: 'read(&mut buf)' (how many,
// 0 at the end), 'write(data)' (all of it), 'seek(pos)', 'seekBy(delta)', 'seekEnd(delta)' (each answers
// the new position), 'flush()' (fsync), and 'close()', which answers the close's own error. Its descriptor
// calls are the C runtime's ('_wopen' with a UTF-16 name and _O_BINARY, '_read' on Windows; 'open', 'read' on Linux), bytes unchanged. A
// 'LineReader.over(file)' reads it by line: 'readLine(&mut line)' as 'stdinput.readLine' does, in 64 KiB
// blocks, '\n' and '\r\n' both ending a line, a last line with no end counting.
//
// Method choices (defaults for review, not rulings):
// - The whole file, read-only, private: no writable map, no map of a byte
//   range, no offset. A range is a sub-slice of the view; the OS pages in only
//   what is touched, so mapping all of a file costs only address space.
//   Not here: writable maps (and flushing them), mapping a range, 'madvise'
//   and MAP_POPULATE (Linux), prefetch and large pages (Windows), locking
//   pages in memory.
// - Failures are 'FsError's with the C library's error numbers, as everything
//   here: a file not there ENOENT, a folder EISDIR (also on Linux, where
//   fopen would open one), anything but a regular file EINVAL, a NUL in the
//   path EINVAL, a refused mapping (no address space) ENOMEM or the system's
//   own errno. Windows' error numbers are translated (ERROR_FILE_NOT_FOUND to
//   ENOENT, and so on; one with no counterpart is EIO).
// - The file is opened through the C runtime's 'fopen' (mode "rb"), as
//   'readFile' does, so its path, UTF-8 names and failures are exactly
//   readFile's; the OS handle under the stream (Windows: _get_osfhandle of
//   _fileno; Linux: fileno) is what is mapped, and the stream is closed as soon
//   as the map is made.
// - Windows: GetFileSizeEx, CreateFileMappingW (PAGE_READONLY, the size given
//   as its high and low halves), MapViewOfFile (FILE_MAP_READ, the whole
//   file), then the mapping object's handle is closed at once; the view keeps
//   the file. Linux: the size is lseek's end offset (64 bits), then mmap
//   (PROT_READ, MAP_PRIVATE, offset 0). The Windows externs are kernel32's,
//   on every link line already; the rest is the C library's.
// - An empty file is an empty view with no address, since the OS cannot map no
//   bytes.
// - The size is the file's when mapped. A file made shorter while mapped, by
//   this program or another, faults when the lost part is read (SIGBUS on
//   Linux, an in-page error on Windows), and Windows refuses to remove,
//   rename or truncate a file while it is mapped; a map that must not hold
//   its file keeps the file alone or is dropped first.
//
// **What differs by system.** The package itself is written over ISO C (libc's
// 'fopen', 'fread', 'fwrite', 'rename') and POSIX (posix's 'stat', 'lstat',
// 'unlink', 'mkdir', 'rmdir', 'getcwd', 'chdir', 'realpath', 'opendir',
// 'readdir'), and holds nothing of Windows' own, except 'absolute' on POSIX,
// which reads the path's text (below), and 'mapFile', which asks kernel32 for
// the mapping itself (above). What is Windows' is beneath it: the
// posix package maps those names onto the Windows C runtime, and its
// 'opendir', 'readdir' and 'lstat' are written over the runtime's
// '_findfirst64'. The 'path' rules it relies on are the system's own (drive
// letters, shares and '\' on Windows). 'chmod' and 'utime' are the exceptions
// beside 'mapFile': they call '_chmod' (the runtime's) and 'utimensat' on Linux,
// and 'utime' kernel32 ('CreateFileW', 'SetFileTime') on Windows, converting
// the name to UTF-16 itself. Where Windows behaves differently from
// POSIX it is said beside the function: 'rename' replaces an existing file on
// POSIX and is refused on Windows, a name is one name whatever its ASCII case
// on Windows only, and 'modified' (a time.Timestamp) is in whole seconds on
// both.

mod fs;

import libc;
import posix;
import collections use String, List;
import iobuf use IoBuf, Chain, largestClass;
import path use Path;
import sync;
import time;
import ioerror use IoErrorKind, errnoKind;

// -------- failure --------

// Why an operation failed: what was being done, to which path, and the C
// library's error number, whose kind is the same on every system
pub struct FsError is Error {
  // The function that failed: "readFile", "makeDir", ...
  pub op: String;
  // The path it was given
  pub path: Path;
  // The second path, 'rename''s 'to'; empty for the others
  pub other: Path;
  // The C library's errno: posix.ENOENT, posix.EACCES, ...
  pub code: i32;

  // What went wrong, the same on every system: ioerror's IoErrorKind for the
  // errno (NotFound for ENOENT, PermissionDenied for EACCES, ...)
  pub fn kind(self: &) IoErrorKind { errnoKind(code) }

  // One line for a person: 'readFile notes.txt: No such file or directory',
  // or 'rename a.txt to b.txt: File exists'
  pub fn toText(self: &, out: &uni TextOut) {
    out <- op.view();
    if !path.isEmpty() { out <- " ", path.view(); }
    if !other.isEmpty() { out <- " to ", other.view(); }
    out <- ": ", libc.strerror(code).view();
  }

  // Whether it failed because nothing has that name (NotFound: ENOENT)
  pub fn notFound(self: &) bool { self.kind() == IoErrorKind.NotFound }

  // Whether it failed because something already has that name (AlreadyExists:
  // EEXIST)
  pub fn alreadyExists(self: &) bool { self.kind() == IoErrorKind.AlreadyExists }
}

fn failure(op: &str, p: &Path, code: i32) FsError {
  FsError(String.from(op), p.clone(), Path.from(""), code)
}

fn fail[T](op: &str, p: &Path, code: i32) Result[T, FsError] {
  Err[T, FsError](failure(op, p, code))
}

fn succeeded() Result[void, FsError] { Ok[void, FsError](nil) }

// The error number the last C call left
fn lastErrno() i32 { *libc.errno() }

// Whether a path holds a NUL byte, which a C function would take as its end
fn hasNul(path: &Path) bool {
  let p: &Array[u8] = path.view();
  var i = 0usize;
  while i < p.len {
    if p[i] == 0u8 { return true; }
    i = i + 1usize;
  }
  false
}

// A path's text as a String, which C reads: the NUL-checked copy every call
// into the C runtime is given
fn cText(path: &Path) String { String.from(path.view()) }

// -------- UTF-8 names --------

// Run by the first call that needs it. A thread that arrives meanwhile waits
// until it is done, so none reaches the C runtime before the names are set
let utf8Once: sync.Once;

fn @initpure init() {
  utf8Once = sync.Once.make();
}

// Make the C runtime read names as UTF-8, unless the program has chosen a
// character type of its own. Once is enough.
fn useUtf8() {
  utf8Once.callOnce(&setUtf8);
}

fn setUtf8() {
  // POSIX hands a name's bytes to the system as they are
  #if #os == .windows {
    let now = libc.setlocale(libc.LC_CTYPE, null);
    if now != null && libc.strcmp(cstr.fromPtr(now), "C") == 0i32 {
      libc.setlocale(libc.LC_CTYPE, &".UTF-8" as *u8);
    }
  }
}

// -------- status --------

// What 'stat' tells of a file or folder
pub struct FileInfo {
  // Its size in bytes; 0 for a folder
  pub size: i64;
  // When it was last written, a Timestamp of the time package (UTC), in
  // whole seconds: the C runtime's stat counts no finer
  pub modified: time.Timestamp;
  pub isDir: bool;
  // A regular file: not a folder, a device or anything else
  pub isFile: bool;
}

fn emptyStat() posix.Stat {
  posix.Stat(0u64, 0u64, 0u16, 0u32, 0u32, 0u32, 0u64, 0i64, 0i64, 0i64, 0i64)
}

// The size, time and kind of what a path names, following a link
pub fn stat(path: &Path) Result[FileInfo, FsError] {
  if hasNul(path) { return fail[FileInfo]("stat", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  var st = emptyStat();
  if posix.stat(c.cstr(), &mut st) != 0i32 { return fail[FileInfo]("stat", path, lastErrno()); }
  let kind = st.st_mode & posix.S_IFMT;
  Ok[FileInfo, FsError](FileInfo(st.st_size, time.Timestamp.fromUnixSeconds(st.st_mtime),
    kind == posix.S_IFDIR, kind == posix.S_IFREG))
}

// The file-type bits of what a path names, or 0 when it cannot be seen
fn kindOf(path: &Path) u16 {
  if hasNul(path) { return 0u16; }
  useUtf8();
  var c = cText(path);
  var st = emptyStat();
  if posix.stat(c.cstr(), &mut st) != 0i32 { return 0u16; }
  st.st_mode & posix.S_IFMT
}

// The file-type bits of what a path names, not following a link, or 0 when
// it cannot be seen
fn linkKindOf(path: &Path) u16 {
  var c = cText(path);
  var st = emptyStat();
  if posix.lstat(c.cstr(), &mut st) != 0i32 { return 0u16; }
  st.st_mode & posix.S_IFMT
}

// Whether anything has that name
pub fn exists(path: &Path) bool { kindOf(path) != 0u16 }

// Whether a folder has that name
pub fn isDir(path: &Path) bool { kindOf(path) == posix.S_IFDIR }

// Whether a regular file has that name
pub fn isFile(path: &Path) bool { kindOf(path) == posix.S_IFREG }

// The size, time and kind of what a path names, NOT following a link: a link
// is described itself. A link is neither a folder nor a file here ('isDir' and
// 'isFile' false), as in a listing; its 'size' is the system's (on Windows 0)
// and its 'modified' its own. Anything that is not a link answers as 'stat'
// does. A path nothing has is refused (ENOENT). This sees a link whose target
// is gone, which 'stat' refuses.
pub fn lstat(path: &Path) Result[FileInfo, FsError] {
  if hasNul(path) { return fail[FileInfo]("lstat", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  var st = emptyStat();
  if posix.lstat(c.cstr(), &mut st) != 0i32 { return fail[FileInfo]("lstat", path, lastErrno()); }
  let kind = st.st_mode & posix.S_IFMT;
  Ok[FileInfo, FsError](FileInfo(st.st_size, time.Timestamp.fromUnixSeconds(st.st_mtime),
    kind == posix.S_IFDIR, kind == posix.S_IFREG))
}

// Whether the name itself is a link, a link whose target is gone as well as one
// that leads somewhere (on POSIX 'exists' and 'isDir' follow the first and say
// false; the Windows runtime's 'stat' answers for a junction whose folder is
// gone as for the junction itself, so they say true). On POSIX a symbolic link;
// on Windows any reparse point (a symbolic link, a directory junction, a
// cloud-storage placeholder), the same test a listing's 'isLink' makes, so the
// two always agree. False for anything it cannot see.
pub fn isLink(path: &Path) bool {
  if hasNul(path) { return false; }
  useUtf8();
  linkKindOf(path) == posix.S_IFLNK
}

// -------- whole files --------

// The error number for a file that would not open: Windows answers EACCES
// for a folder, which is EISDIR in POSIX's terms. Called straight after the
// failure, before errno changes.
fn openErrno(path: &Path) i32 {
  let code = lastErrno();
  if code == posix.EACCES && isDir(path) {posix.EISDIR} else {code}
}

// The whole of a file, its bytes as they are: text or not, NULs included
pub fn readFile(path: &Path) Result[String, FsError] {
  if hasNul(path) { return fail[String]("readFile", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  let f = libc.fopen(c.cstr(), "rb");
  if f == null { return fail[String]("readFile", path, openErrno(path)); }
  var out = String();
  var buf = Array[u8, 65536]() <- fill 0u8;
  let bp: *u8 = &[]buf as *u8;
  var going = true;
  while going {
    let n = libc.fread(bp, 1usize, 65536usize, f);
    if n > 0usize { out.appendBytes(mem.sliceFromParts(bp, n)); }
    going = n == 65536usize;
  }
  let broke = libc.ferror(f) != 0i32;
  let code = lastErrno();
  libc.fclose(f);
  if broke { return fail[String]("readFile", path, code); }
  Ok[String, FsError](out)
}

// The whole of a file as a Chain of buffers, read straight into them: no String built and copied from.
// A Chain, not one IoBuf, because a file is any size and a buffer is a pool block (a file past the
// pool's bound could never be one): the buffers start at 64 KiB and double to the pool's largest block
// (1 MiB), so a file under 64 KiB is one segment and a large one a short chain. A caller that wants one
// contiguous block calls 'copyOut' once, at its edge; one that passes the bytes on copies nothing. Fails
// with ENOMEM (a kind of its own, OutOfMemory) when the pool will not give a buffer without growing past
// its bound (IoBuf.tryMake), where 'readFile' would grow its String without limit.
pub fn readBytes(path: &Path) Result[Chain, FsError] {
  if hasNul(path) { return fail[Chain]("readBytes", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  let f = libc.fopen(c.cstr(), "rb");
  if f == null { return fail[Chain]("readBytes", path, openErrno(path)); }
  var chain = Chain.make(0xFFFFFFFFFFFFFFFFusize);
  var size = 65536usize;
  var going = true;
  var nomem = false;
  while going {
    match IoBuf.tryMake(size) {
      case let Some(got) {
        var buf = got;
        let want = buf.room();
        let n = libc.fread(buf.base() + buf.len(), 1usize, want, f);
        buf.setLen(buf.len() + n);
        going = n == want;
        _ = chain.push(buf);
      }
      case is None[IoBuf] { nomem = true; going = false; }
    }
    if size < largestClass { size = size * 2usize; }
  }
  let broke = libc.ferror(f) != 0i32;
  let code = lastErrno();
  libc.fclose(f);
  if nomem { return fail[Chain]("readBytes", path, posix.ENOMEM); }
  if broke { return fail[Chain]("readBytes", path, code); }
  Ok[Chain, FsError](chain)
}

// Open with mode, write data, close; a failure anywhere is op's
fn writeWith(op: &str, path: &Path, data: &Array[u8], mode: cstr) Result[void, FsError] {
  if hasNul(path) { return fail[void](op, path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  let f = libc.fopen(c.cstr(), mode);
  if f == null { return fail[void](op, path, openErrno(path)); }
  let wrote = if data.len > 0usize {libc.fwrite(data as *u8, 1usize, data.len, f)} else {0usize};
  let code = lastErrno();
  let closed = libc.fclose(f);
  if wrote != data.len { return fail[void](op, path, code); }
  if closed != 0i32 { return fail[void](op, path, lastErrno()); }
  succeeded()
}

// Make the file hold exactly data, making it if it is not there and
// replacing what it held if it is
pub fn writeFile(path: &Path, data: &Array[u8]) Result[void, FsError] {
  writeWith("writeFile", path, data, "wb")
}

// Add data to the end of the file, making it if it is not there
pub fn appendFile(path: &Path, data: &Array[u8]) Result[void, FsError] {
  writeWith("appendFile", path, data, "ab")
}

// -------- modes and times --------

extern {
  // Windows: the C runtime's, and kernel32's (on every link line)
  fn @c _chmod(path: cstr, mode: i32) i32;
  fn @c(system) MultiByteToWideChar(page: u32, flags: u32, from: *u8, fromLen: i32, to: *u16, toLen: i32) i32;
  fn @c(system) CreateFileW(name: *u16, access: u32, share: u32, sa: *u8, disposition: u32,
    flags: u32, template: usize) usize;
  fn @c(system) SetFileTime(h: usize, created: *i64, accessed: &i64, written: &i64) i32;
  // Linux: the C library's
  fn @c("chmod") posixChmod(path: cstr, mode: u32) i32;
  fn @c utimensat(dirfd: i32, path: cstr, times: *i64, flags: i32) i32;
}

const modeBits = 0xFFFu32;          // the permission bits and setuid, setgid, sticky
const ownerWrite = 0x80u32;         // 0o200, S_IWUSR; also Windows' _S_IWRITE
const winReadable = 0x100i32;       // _S_IREAD
const winWritable = 0x180i32;       // _S_IREAD | _S_IWRITE
const atFdCwd = -100i32;            // AT_FDCWD
const utf8CodePage = 65001u32;      // CP_UTF8
const invalidUtf8Fails = 8u32;      // MB_ERR_INVALID_CHARS
const fileWriteAttributes = 0x100u32;
const shareAll = 7u32;              // FILE_SHARE_READ | WRITE | DELETE
const openExisting = 3u32;
const backupSemantics = 0x02000000u32;   // lets a folder be opened
const invalidHandle = 0xFFFFFFFFFFFFFFFFusize;
const ticksPerSecond = 10000000i64;      // FILETIME counts 100 ns
const secondsTo1970 = 11644473600i64;    // from 1601-01-01, FILETIME's origin, to 1970

// Set what a path names' permission bits, following a link to its target.
// 'mode' is POSIX's: the nine permission bits (0o755 is 0x1ED) and, on POSIX,
// setuid, setgid and sticky above them; any bit above those is ignored.
//
// Windows has no permission bits, only a read-only attribute, and this does not
// pretend otherwise: the one bit it reads is the owner's write bit (0o200, 0x80).
// Set, the file is made writable; clear, it is made read-only. Every other bit
// of 'mode' is accepted and ignored there, so 'chmod(p, 0o644)' and
// 'chmod(p, 0o666)' do the same, and a program that wants a file read-only everywhere
// clears the three write bits (0o444). A file made read-only is then refused
// by 'writeFile' (EACCES). There is no reader of the bits in this package
// ('FileInfo' holds none); the posix package's 'stat' gives 'st_mode', which on
// Windows has the write bit clear for a read-only file.
pub fn chmod(path: &Path, mode: u32) Result[void, FsError] {
  if hasNul(path) { return fail[void]("chmod", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  let bits = mode & modeBits;
  let failed = #if #os == .windows {
    _chmod(c.cstr(), if (bits & ownerWrite) != 0u32 {winWritable} else {winReadable}) != 0i32
  } #else {
    posixChmod(c.cstr(), bits) != 0i32
  };
  if failed { return fail[void]("chmod", path, lastErrno()); }
  succeeded()
}

// Set when a file or folder was last read and last written, following a link
// to its target. Both are Timestamps of the time package (as 'FileInfo's
// 'modified' is), UTC; mind the order: the access time first, as POSIX's
// 'utime' takes them. Linux keeps the nanoseconds given (the file system may round
// them: ext4 does not, FAT does to 2 seconds); Windows keeps 100 nanoseconds,
// rounded down. A time before 1970 is set on both, though the Windows C runtime's
// 'stat' (so 'FileInfo.modified') shows none, only -1 second. Setting a
// time needs ownership of the file or write access to it (EACCES or EPERM
// otherwise); a file another program has open without sharing is refused on
// Windows (EACCES). The change time is the system's own and is not set.
pub fn utime(path: &Path, accessed: time.Timestamp, modified: time.Timestamp) Result[void, FsError] {
  if hasNul(path) { return fail[void]("utime", path, posix.EINVAL); }
  useUtf8();
  let code = #if #os == .windows {setTimesWindows(path, accessed, modified)}
    #else {setTimesLinux(path, accessed, modified)};
  if code != 0i32 { return fail[void]("utime", path, code); }
  succeeded()
}

// The nanoseconds of a Timestamp past its whole second, 0 to 999999999, which
// is not the remainder for a moment before 1970
fn nanosPastSecond(t: time.Timestamp) i64 { t.unixNanos() - t.unixSeconds() * 1000000000i64 }

// Linux: utimensat with the two (seconds, nanoseconds) pairs; 0 or the error number
fn setTimesLinux(path: &Path, accessed: time.Timestamp, modified: time.Timestamp) i32 {
  var c = cText(path);
  var pairs = Array[i64, 4]() <- fill 0i64;
  pairs[0usize] = accessed.unixSeconds();
  pairs[1usize] = nanosPastSecond(accessed);
  pairs[2usize] = modified.unixSeconds();
  pairs[3usize] = nanosPastSecond(modified);
  if utimensat(atFdCwd, c.cstr(), &[]pairs as *i64, 0i32) != 0i32 { return lastErrno(); }
  0i32
}

// A Timestamp as a FILETIME, 100 ns since 1601; -1 for a moment before it
fn fileTimeOf(t: time.Timestamp) i64 {
  let seconds = t.unixSeconds() + secondsTo1970;
  if seconds < 0i64 { return -1i64; }
  seconds * ticksPerSecond + nanosPastSecond(t) / 100i64
}

// Windows: open the file for writing its attributes alone (so one that is read-only
// or open elsewhere for reading still takes it), set the two times, close; 0 or
// the error number. The name is converted to UTF-16 here, from UTF-8 as
// the rest of the package reads it.
fn setTimesWindows(path: &Path, accessed: time.Timestamp, modified: time.Timestamp) i32 {
  let atime = fileTimeOf(accessed);
  let mtime = fileTimeOf(modified);
  if atime < 0i64 || mtime < 0i64 { return posix.EINVAL; }
  var c = cText(path);
  let n = MultiByteToWideChar(utf8CodePage, invalidUtf8Fails, c.cstr().ptr(), -1i32, null, 0i32);
  if n <= 0i32 { return posix.EINVAL; }
  let wide = libc.malloc(usize.from(n) * 2usize) as *u16;
  MultiByteToWideChar(utf8CodePage, invalidUtf8Fails, c.cstr().ptr(), -1i32, wide, n);
  let h = CreateFileW(wide, fileWriteAttributes, shareAll, null, openExisting, backupSemantics, 0usize);
  let opened = GetLastError();
  libc.free(wide as *u8);
  if h == invalidHandle { return errnoOfWindows(opened); }
  let done = SetFileTime(h, null, &atime, &mtime);
  let code = GetLastError();
  CloseHandle(h);
  if done == 0i32 { return errnoOfWindows(code); }
  0i32
}

// -------- mapped files --------

// What the OS is asked for. Every extern is declared on every system;
// '#if #os == .windows', resolved as the file is parsed, chooses, so only the
// target's calls are generated.
extern {
  // Windows: kernel32 (on every link line), and the C runtime's way from a
  // stream to the handle under it
  fn @c(system) GetFileSizeEx(h: usize, size: &mut i64) i32;
  fn @c(system) CreateFileMappingW(h: usize, attrs: *u8, protect: u32, sizeHigh: u32, sizeLow: u32,
    name: *u16) usize;
  fn @c(system) MapViewOfFile(map: usize, access: u32, offHigh: u32, offLow: u32, bytes: usize) *u8;
  fn @c(system) UnmapViewOfFile(base: *u8) i32;
  fn @c(system) CloseHandle(h: usize) i32;
  fn @c(system) GetLastError() u32;
  fn @c _fileno(stream: *libc.FILE) i32;
  fn @c _get_osfhandle(fd: i32) isize;
  // Linux: the C library's
  fn @c fileno(stream: *libc.FILE) i32;
  fn @c lseek(fd: i32, offset: i64, whence: i32) i64;
  fn @c mmap(addr: *u8, size: usize, protect: i32, flags: i32, fd: i32, offset: i64) *u8;
  fn @c munmap(addr: *u8, size: usize) i32;
}

const pageReadonly = 0x02u32;       // PAGE_READONLY
const fileMapRead = 0x04u32;        // FILE_MAP_READ
const seekEnd = 2i32;               // SEEK_END
const protRead = 1i32;              // PROT_READ
const mapPrivate = 2i32;            // MAP_PRIVATE
const mmapFailed = 0xFFFFFFFFFFFFFFFFusize;     // MAP_FAILED, (void*)-1

// The POSIX error number for a Windows error number from the calls above
fn errnoOfWindows(code: u32) i32 {
  if code == 2u32 || code == 3u32 { posix.ENOENT }                  // file / path not found
  else if code == 5u32 || code == 32u32 || code == 33u32 { posix.EACCES }  // denied, sharing, lock
  else if code == 8u32 || code == 14u32 || code == 1450u32 || code == 1455u32 || code == 1453u32 {
    posix.ENOMEM       // not enough memory, address space or system resources
  }
  else if code == 87u32 { posix.EINVAL }
  else { posix.EIO }
}

// A read-only view of a whole file's bytes, held by the OS's memory mapping:
// one owner, moved, never copied. 'view' lends the bytes, in place, as a
// '&Array[u8]'; the OS reads a page from the file when it is first touched, so
// a file larger than memory costs nothing to map and only what is read is
// loaded. Its death unmaps the view; the file itself is not held open. It
// declares Sendable, a promise taken on trust, for its raw pointer: the view is
// the owner's alone and read-only, so it may be handed to another thread, and
// 'Arc[imm, MappedFile]' shares it among threads.
pub struct MappedFile is Default, Move, Sendable {
  ptr: *u8;          // the view's first byte; null for an empty file
  bytes: usize;      // the file's size when it was mapped

  fn init(self: &new) { *self = MappedFile(null, 0usize); }

  // The file's size in bytes, as it was when mapped
  pub fn size(self: &) usize { bytes }

  // Whether the file held nothing
  pub fn isEmpty(self: &) bool { bytes == 0usize }

  // The file's bytes, in place: a view as long as 'size()', good while this
  // owner lives
  pub fn view(self: &) &Array[u8] { mem.sliceFromParts(ptr, bytes) }

  // The address of the first byte (null for an empty file), for handing the
  // mapping on, to a GPU upload for instance. Good while this owner lives.
  pub fn base(self: &) *u8 { ptr }

  // Unmap the view
  fn final(self: &uni) {
    if ptr as usize != 0usize {
      #if #os == .windows { UnmapViewOfFile(ptr); } #else { munmap(ptr, bytes); }
    }
  }
}

// Map a file for reading, whole. A file that is not there, a folder, anything
// that is not a regular file, or one that cannot be read is refused, as
// 'readFile' refuses it. An empty file is mapped as an empty view (the OS
// cannot map no bytes). The file must stay as long as the mapping does: one
// that is truncated while mapped, by this program or another, makes a read of
// the lost part fault (SIGBUS on Linux, an in-page error on Windows), and
// Windows refuses to remove or rename a mapped file.
pub fn mapFile(path: &Path) Result[MappedFile, FsError] {
  if hasNul(path) { return fail[MappedFile]("mapFile", path, posix.EINVAL); }
  useUtf8();
  let kind = kindOf(path);
  if kind == posix.S_IFDIR { return fail[MappedFile]("mapFile", path, posix.EISDIR); }
  if kind != 0u16 && kind != posix.S_IFREG { return fail[MappedFile]("mapFile", path, posix.EINVAL); }
  var c = cText(path);
  let f = libc.fopen(c.cstr(), "rb");
  if f == null { return fail[MappedFile]("mapFile", path, openErrno(path)); }
  // The mapping holds the file once made, so the stream can go at once
  let mapped = #if #os == .windows {mapWindows(path, f)} #else {mapLinux(path, f)};
  libc.fclose(f);
  mapped
}

// Windows: size the file, make a file-mapping object over it, map a view of
// the whole of it, and let the object go (the view keeps the file)
fn mapWindows(path: &Path, f: *libc.FILE) Result[MappedFile, FsError] {
  let h = usize.from(_get_osfhandle(_fileno(f)));
  var size = 0i64;
  if GetFileSizeEx(h, &mut size) == 0i32 {
    return fail[MappedFile]("mapFile", path, errnoOfWindows(GetLastError()));
  }
  if size == 0i64 { return Ok[MappedFile, FsError](MappedFile()); }
  // The size as the two halves Windows takes it in
  let n = u64.from(size);
  let map = CreateFileMappingW(h, null, pageReadonly, u32.from(n >> 32u64),
    u32.from(n & 0xFFFFFFFFu64), null);
  if map == 0usize { return fail[MappedFile]("mapFile", path, errnoOfWindows(GetLastError())); }
  let view = MapViewOfFile(map, fileMapRead, 0u32, 0u32, usize.from(n));
  let code = GetLastError();
  CloseHandle(map);
  if view as usize == 0usize { return fail[MappedFile]("mapFile", path, errnoOfWindows(code)); }
  Ok[MappedFile, FsError](MappedFile(view, usize.from(n)))
}

// Linux: the size is the offset of the end; map it private and read-only
fn mapLinux(path: &Path, f: *libc.FILE) Result[MappedFile, FsError] {
  let fd = fileno(f);
  let end = lseek(fd, 0i64, seekEnd);
  if end < 0i64 { return fail[MappedFile]("mapFile", path, lastErrno()); }
  if end == 0i64 { return Ok[MappedFile, FsError](MappedFile()); }
  let n = usize.from(end);
  let view = mmap(null, n, protRead, mapPrivate, fd, 0i64);
  if view as usize == mmapFailed { return fail[MappedFile]("mapFile", path, lastErrno()); }
  Ok[MappedFile, FsError](MappedFile(view, n))
}

// -------- names --------

// Give a file or folder another name, which may be in another folder on the
// same volume. Where 'to' is already there, POSIX replaces it; Windows
// refuses, EEXIST for a file and EACCES for a folder, and nothing changes.
pub fn rename(from: &Path, to: &Path) Result[void, FsError] {
  if hasNul(from) || hasNul(to) {
    return Err[void, FsError](FsError(String.from("rename"), from.clone(), to.clone(), posix.EINVAL));
  }
  useUtf8();
  var a = cText(from);
  var b = cText(to);
  if libc.rename(a.cstr(), b.cstr()) != 0i32 {
    return Err[void, FsError](FsError(String.from("rename"), from.clone(), to.clone(), lastErrno()));
  }
  succeeded()
}

// Remove a file. A folder is refused (EISDIR): 'removeDir' or 'removeAll'
pub fn removeFile(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("removeFile", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  if posix.unlink(c.cstr()) != 0i32 { return fail[void]("removeFile", path, openErrno(path)); }
  succeeded()
}

// -------- folders --------

// Make a folder, whose parent must be there. One already there is refused
// (EEXIST).
pub fn makeDir(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("makeDir", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  if posix.mkdir(c.cstr(), 0x1FFu32) != 0i32 { return fail[void]("makeDir", path, lastErrno()); }
  succeeded()
}

// Make a folder and every folder above it that is not there yet. A folder
// already there is success; a file in the way is refused (ENOTDIR), and so
// is a parent that cannot be made, whose error names it.
pub fn makeDirAll(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("makeDirAll", path, posix.EINVAL); }
  let kind = kindOf(path);
  if kind == posix.S_IFDIR { return succeeded(); }
  if kind != 0u16 { return fail[void]("makeDirAll", path, posix.ENOTDIR); }
  let up = path.parent();
  if !up.isEmpty() && up.view() != path.view() {
    makeDirAll(&up)?;
  }
  var c = cText(path);
  if posix.mkdir(c.cstr(), 0x1FFu32) != 0i32 {
    let code = lastErrno();
    // Made meanwhile by someone else, or named with a '..' that mkdir read
    if !isDir(path) { return fail[void]("makeDirAll", path, code); }
  }
  succeeded()
}

// Remove an empty folder. One with anything in it is refused (ENOTEMPTY).
pub fn removeDir(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("removeDir", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  if posix.rmdir(c.cstr()) != 0i32 { return fail[void]("removeDir", path, lastErrno()); }
  succeeded()
}

// One entry of a folder
pub struct DirEntry {
  // Its name in the folder
  pub name: String;
  // The folder's path as given joined to the name: 'src/main.cone'
  pub path: Path;
  pub isDir: bool;
  // A regular file
  pub isFile: bool;
  // A link, which is neither a folder nor a file here: 'stat' its path to
  // learn what it leads to
  pub isLink: bool;
}

fn byName(a: &DirEntry, b: &DirEntry) i32 { a.name.compare(b.name.view()) }

// What a folder holds, '.' and '..' left out, sorted by name, byte by byte
// (so 'B' before 'a', and a UTF-8 name by its bytes). A path that is not a
// folder is refused (ENOTDIR).
pub fn readDir(path: &Path) Result[List[DirEntry], FsError] {
  if hasNul(path) { return fail[List[DirEntry]]("readDir", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  let dir = posix.opendir(c.cstr());
  if dir == null { return fail[List[DirEntry]]("readDir", path, lastErrno()); }
  var out = List[DirEntry]();
  *libc.errno() = 0i32;
  var e = posix.readdir(dir);
  while e != null {
    let entry = e as &posix.dirent;
    let np: *u8 = &[]entry.d_name as *u8;
    let name = cstr.fromPtr(np).view();
    if name != "." && name != ".." {
      var t = entry.d_type;
      let full = path.join(name);
      // A file system that does not say what an entry is (POSIX allows it)
      // is asked, by the entry's own status, link or not
      if t == posix.DT_UNKNOWN {
        let kind = linkKindOf(&full);
        t = if kind == posix.S_IFLNK {posix.DT_LNK} else if kind == posix.S_IFDIR {posix.DT_DIR}
          else if kind == posix.S_IFREG {posix.DT_REG} else {posix.DT_UNKNOWN};
      }
      out.push(DirEntry(String.from(name), full,
        t == posix.DT_DIR, t == posix.DT_REG, t == posix.DT_LNK));
    }
    e = posix.readdir(dir);
  }
  let code = lastErrno();
  posix.closedir(dir);
  if code != 0i32 { return fail[List[DirEntry]]("readDir", path, code); }
  out.sortBy(&byName);
  Ok[List[DirEntry], FsError](out)
}

// Every entry below a folder, depth first: each folder's entries in name
// order, each folder's own entries straight after it. The folder itself is
// not among them. Each entry's path is the root as given joined with the
// names down to it. A linked folder is listed but not gone into. The first
// folder that cannot be read ends the walk with its error.
pub fn walk(root: &Path) Result[List[DirEntry], FsError] {
  var out = List[DirEntry]();
  walkInto(root, &mut out)?;
  Ok[List[DirEntry], FsError](out)
}

fn walkInto(dir: &Path, out: &mut List[DirEntry]) Result[void, FsError] {
  match readDir(dir) {
    case var Err(e) {
      e.op = String.from("walk");
      return Err[void, FsError](e);
    }
    case let Ok(listed) {
      let entries = &listed;
      var i = 0usize;
      while i < entries.len() {
        let entry = &entries[i];
        out.push(DirEntry(entry.name.clone(), entry.path.clone(), entry.isDir, entry.isFile, entry.isLink));
        if entry.isDir {
          walkInto(&entry.path, out)?;
        }
        i = i + 1usize;
      }
    }
  }
  succeeded()
}

// -------- glob --------

// The ASCII-folded byte where case does not count (Windows), as it is elsewhere
fn foldByte(b: u8) u8 {
  #if #os == .windows { if b >= 'A' && b <= 'Z' {b + 32u8} else {b} } #else { b }
}

fn foldCp(c: u32) u32 {
  #if #os == .windows { if c >= 65u32 && c <= 90u32 {c + 32u32} else {c} } #else { c }
}

// '\' escapes in a pattern on POSIX; on Windows it separates names
fn escapes() bool { #if #os == .windows { false } #else { true } }

fn isSepByte(b: u8) bool { b == '/' || (#if #os == .windows { b == '\\' } #else { false }) }

// Bytes of the UTF-8 character starting at i (1 for a stray byte)
fn charLen(s: &Array[u8], i: usize) usize {
  let b = s[i];
  var n = if b < 0xC0u8 {1usize} else if b < 0xE0u8 {2usize} else if b < 0xF0u8 {3usize} else {4usize};
  if i + n > s.len { n = s.len - i; }
  n
}

fn charAt(s: &Array[u8], i: usize, n: usize) u32 {
  if n == 1usize { return u32.from(s[i]); }
  var cp = u32.from(s[i]) & (if n == 2usize {0x1Fu32} else if n == 3usize {0x0Fu32} else {0x07u32});
  var k = 1usize;
  while k < n {
    cp = (cp << 6u32) | (u32.from(s[i + k]) & 0x3Fu32);
    k = k + 1usize;
  }
  cp
}

// Where a '[...]' class starting at p[pi] ends (the index after its ']'),
// or 0 if it is never closed, and the '[' is then an ordinary character
fn classEnd(p: &Array[u8], pi: usize) usize {
  var j = pi + 1usize;
  if j < p.len && p[j] == '!' { j = j + 1usize; }
  if j < p.len && p[j] == ']' { j = j + 1usize; }
  while j < p.len && p[j] != ']' {
    if p[j] == '\\' && escapes() { j = j + 1usize; }
    j = j + 1usize;
  }
  if j >= p.len { return 0usize; }
  j + 1usize
}

// Is the character c in the class p[pi..<end]?
fn classHas(p: &Array[u8], pi: usize, end: usize, c: u32) bool {
  let close = end - 1usize;
  var j = pi + 1usize;
  var negate = false;
  if p[j] == '!' { negate = true; j = j + 1usize; }
  let want = foldCp(c);
  var found = false;
  while j < close {
    if p[j] == '\\' && escapes() && j + 1usize < close { j = j + 1usize; }
    let ln = charLen(p, j);
    let lo = foldCp(charAt(p, j, ln));
    j = j + ln;
    var hi = lo;
    if j + 1usize < close && p[j] == '-' {
      j = j + 1usize;
      if p[j] == '\\' && escapes() && j + 1usize < close { j = j + 1usize; }
      let hn = charLen(p, j);
      hi = foldCp(charAt(p, j, hn));
      j = j + hn;
    }
    if want >= lo && want <= hi { found = true; }
  }
  found != negate
}

// Does one name match one pattern segment (no separators in either)?
fn segMatch(p: &Array[u8], p0: usize, n: &Array[u8], n0: usize) bool {
  var pi = p0;
  var ni = n0;
  while pi < p.len {
    let c = p[pi];
    if c == '*' {
      while pi < p.len && p[pi] == '*' { pi = pi + 1usize; }
      if pi == p.len { return true; }
      var k = ni;
      while true {
        if segMatch(p, pi, n, k) { return true; }
        if k >= n.len { break; }
        k = k + charLen(n, k);
      }
      return false;
    }
    if ni >= n.len { return false; }
    if c == '?' {
      ni = ni + charLen(n, ni);
      pi = pi + 1usize;
    } else {
      let end = if c == '[' {classEnd(p, pi)} else {0usize};
      if end > 0usize {
        let ln = charLen(n, ni);
        if !classHas(p, pi, end, charAt(n, ni, ln)) { return false; }
        ni = ni + ln;
        pi = end;
      } else {
        var lit = c;
        if c == '\\' && escapes() && pi + 1usize < p.len { pi = pi + 1usize; lit = p[pi]; }
        if foldByte(lit) != foldByte(n[ni]) { return false; }
        pi = pi + 1usize;
        ni = ni + 1usize;
      }
    }
  }
  ni == n.len
}

// A hidden name (a leading '.') is matched only by a segment that starts with '.'
fn nameMatches(seg: &Array[u8], name: &Array[u8]) bool {
  if name.len > 0usize && name[0] == '.' && !(seg.len > 0usize && seg[0] == '.') { return false; }
  segMatch(seg, 0usize, name, 0usize)
}

fn hasWild(seg: &Array[u8]) bool {
  var i = 0usize;
  while i < seg.len {
    let b = seg[i];
    if b == '*' || b == '?' || b == '[' || (b == '\\' && escapes()) { return true; }
    i = i + 1usize;
  }
  false
}

fn isStars(seg: &Array[u8]) bool { seg.len == 2usize && seg[0] == '*' && seg[1] == '*' }

fn childOf(base: &Path, e: &DirEntry) DirEntry {
  DirEntry(e.name.clone(), base.join(e.name.view()), e.isDir, e.isFile, e.isLink)
}

// What a folder holds, for the glob; a folder that is not there (or is a file) holds nothing
fn globList(base: &Path) Result[List[DirEntry], FsError] {
  let dir = if base.isEmpty() {Path.from(".")} else {base.clone()};
  match readDir(&dir) {
    case var Err(e) {
      if e.code == posix.ENOENT || e.code == posix.ENOTDIR { return Ok[List[DirEntry], FsError](List[DirEntry]()); }
      e.op = String.from("glob");
      Err[List[DirEntry], FsError](e)
    }
    case let Ok(l) { Ok[List[DirEntry], FsError](l) }
  }
}

fn globIn(base: &Path, segs: &List[String], si: usize, dirsOnly: bool, out: &mut List[DirEntry]) Result[void, FsError] {
  let seg = segs[si].view();
  let last = si + 1usize == segs.len();
  if isStars(seg) {
    // '**': no folder, or any depth of them, never into a hidden or a linked one
    if !last { globIn(base, segs, si + 1usize, dirsOnly, out)?; }
    let listed = globList(base)?;
    var i = 0usize;
    while i < listed.len() {
      let e = &listed[i];
      if !(e.name.len() > 0usize && e.name.view()[0] == '.') {
        let child = childOf(base, e);
        if last && (!dirsOnly || e.isDir) { out.push(childOf(base, e)); }
        if e.isDir && !e.isLink { globIn(&child.path, segs, si, dirsOnly, out)?; }
      }
      i = i + 1usize;
    }
    return succeeded();
  }
  let listed = globList(base)?;
  var i = 0usize;
  while i < listed.len() {
    let e = &listed[i];
    if nameMatches(seg, e.name.view()) {
      let child = childOf(base, e);
      if last {
        if !dirsOnly || e.isDir { out.push(child); }
      } else if e.isDir && !e.isLink {
        globIn(&child.path, segs, si + 1usize, dirsOnly, out)?;
      }
    }
    i = i + 1usize;
  }
  succeeded()
}

fn byPath(a: &DirEntry, b: &DirEntry) i32 {
  let x = a.path.view();
  let y = b.path.view();
  var i = 0usize;
  while i < x.len && i < y.len {
    if x[i] != y[i] { return if x[i] < y[i] {-1i32} else {1i32}; }
    i = i + 1usize;
  }
  if x.len == y.len { 0i32 } else if x.len < y.len { -1i32 } else { 1i32 }
}

fn samePath(a: &DirEntry, b: &DirEntry) bool { byPath(a, b) == 0i32 }

// Every file and folder a pattern names, sorted by path, as 'walk' lists them:
// a List of 'DirEntry', each one's path the pattern's literal start joined to
// the names down to the match. Nothing matching is an empty list, not an error.
//   '*'      any run of characters within one name ('*' never crosses a '/')
//   '?'      any one character
//   '[abc]'  one of those; '[a-z]' one in the range; '[!a-z]' one not in it
//   '**'     as a whole name: no folder or any depth of them ('a/**/b' is
//            'a/b', 'a/x/b', 'a/x/y/b'); last, everything below
//   '\'      makes the next character ordinary, on POSIX only
// A name beginning with '.' is matched only by a pattern name that begins with
// '.': neither '*', '?', a class nor '**' reaches a hidden one. A pattern ending
// in '/' matches folders only. Like 'walk', 'glob' never goes down into a
// linked folder (a link is a match like any other name, listed as a link), so
// a link back up the tree cannot loop it; the leading names of the pattern
// with no wildcard are joined into the folder it starts in and opened as
// given, so a link there is followed by the system. Only what the pattern can
// match is read: it starts in that folder, and a folder is listed only if the
// pattern can match something in it, not the whole tree.
// By system: on Windows '/' and '\' both separate names, so '\' escapes
// nothing, and ASCII letters match without regard to case; on POSIX only '/'
// separates names, and case counts. A folder that cannot be read ends it with
// its error (op "glob"); one that is not there holds nothing.
pub fn glob(pattern: &str) Result[List[DirEntry], FsError] {
  var out = List[DirEntry]();
  var i = 0usize;
  #if #os == .windows {
    if pattern.len >= 2usize && ((pattern[0] >= 'a' && pattern[0] <= 'z') || (pattern[0] >= 'A' && pattern[0] <= 'Z')) && pattern[1] == ':' { i = 2usize; }
  }
  while i < pattern.len && isSepByte(pattern[i]) { i = i + 1usize; }
  var base = Path.from(&pattern[..<i]);
  var segs = List[String]();
  var start = i;
  var k = i;
  while k <= pattern.len {
    if k == pattern.len || isSepByte(pattern[k]) {
      if k > start {
        let seg = &pattern[start..<k];
        let prevStars = segs.len() > 0usize && isStars(segs[segs.len() - 1usize].view());
        if !(isStars(seg) && prevStars) { segs.push(String.fromBytes(seg)); }
      }
      start = k + 1usize;
    }
    k = k + 1usize;
  }
  if segs.len() == 0usize { return Ok[List[DirEntry], FsError](out); }
  let dirsOnly = pattern.len > i && isSepByte(pattern[pattern.len - 1usize]);
  // The leading names with no wildcard (the last never) are the folder it starts in
  var first = 0usize;
  while first + 1usize < segs.len() && !hasWild(segs[first].view()) {
    base = base.join(segs[first].view());
    first = first + 1usize;
  }
  globIn(&base, &segs, first, dirsOnly, &mut out)?;
  out.sortBy(&byPath);
  out.dedupBy(&samePath);
  Ok[List[DirEntry], FsError](out)
}

// Remove what a path names, and, for a folder, everything in it. A link is
// removed itself, never what it leads to. Nothing there is success. The
// first thing that will not go (a read-only file, a file another program
// has open) ends it with its error, and what was removed before stays
// removed. As a guard against a path made wrongly, a path that is empty, is
// a root or a volume ('C:/', '/', 'C:'), or ends in '.' or '..' is refused
// (EINVAL).
pub fn removeAll(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("removeAll", path, posix.EINVAL); }
  let n = path.normalize();
  let up = n.parent();
  let last = lastName(path);
  if path.isEmpty() || last == "." || last == ".." || n.view() == "."
    || n.view() == ".." || n.view().endsWith("/..") || up.view() == n.view() {
    return fail[void]("removeAll", path, posix.EINVAL);
  }
  useUtf8();
  var c = cText(path);
  var st = emptyStat();
  if posix.lstat(c.cstr(), &mut st) != 0i32 {
    let code = lastErrno();
    if errnoKind(code) == IoErrorKind.NotFound { return succeeded(); }
    return fail[void]("removeAll", path, code);
  }
  removeTree(path, st.st_mode & posix.S_IFMT)
}

// A path's last name, as written
fn lastName(p: &Path) &str { p.name() }

// Remove what path names, whose kind (from lstat) is given
fn removeTree(path: &Path, kind: u16) Result[void, FsError] {
  if kind == posix.S_IFLNK { return removeLink(path); }
  if kind != posix.S_IFDIR {
    var c = cText(path);
    if posix.unlink(c.cstr()) != 0i32 { return fail[void]("removeAll", path, lastErrno()); }
    return succeeded();
  }
  match readDir(path) {
    case var Err(e) {
      e.op = String.from("removeAll");
      return Err[void, FsError](e);
    }
    case let Ok(listed) {
      let entries = &listed;
      var i = 0usize;
      while i < entries.len() {
        let entry = &entries[i];
        let childKind = if entry.isLink {posix.S_IFLNK} else if entry.isDir {posix.S_IFDIR} else {posix.S_IFREG};
        removeTree(&entry.path, childKind)?;
        i = i + 1usize;
      }
    }
  }
  var c = cText(path);
  if posix.rmdir(c.cstr()) != 0i32 { return fail[void]("removeAll", path, lastErrno()); }
  succeeded()
}

// Remove a link itself: a link to a folder goes by rmdir on Windows, and a
// link to a file, or any link on POSIX, by unlink
fn removeLink(path: &Path) Result[void, FsError] {
  var c = cText(path);
  if posix.rmdir(c.cstr()) == 0i32 { return succeeded(); }
  if posix.unlink(c.cstr()) == 0i32 { return succeeded(); }
  fail[void]("removeAll", path, lastErrno())
}

// -------- copying --------

// Copy a file's bytes to another path, making it or replacing what it held,
// and give the copy the original's permission bits (on Windows, its
// read-only attribute). A folder as 'from' is refused (EISDIR), and so is
// the same file as both (EINVAL), which would empty it. A failure names both
// paths, as 'rename' does. The copy is not atomic: a failure part-way leaves
// a partial 'to'.
pub fn copyFile(from: &Path, to: &Path) Result[void, FsError] {
  if hasNul(from) || hasNul(to) { return failedCopy(from, to, posix.EINVAL); }
  useUtf8();
  let kind = kindOf(from);
  if kind == posix.S_IFDIR { return failedCopy(from, to, posix.EISDIR); }
  match absolute(from) {
    case let Ok(a) {
      match absolute(to) {
        case let Ok(b) {
          if a.view() == b.view() { return failedCopy(from, to, posix.EINVAL); }
        }
        case is Err { }
      }
    }
    case is Err { }
  }
  var a = cText(from);
  let src = libc.fopen(a.cstr(), "rb");
  if src == null { return failedCopy(from, to, openErrno(from)); }
  var b = cText(to);
  let dst = libc.fopen(b.cstr(), "wb");
  if dst == null {
    let code = openErrno(to);
    libc.fclose(src);
    return failedCopy(from, to, code);
  }
  var buf = Array[u8, 65536]() <- fill 0u8;
  let bp: *u8 = &[]buf as *u8;
  var code = 0i32;
  var going = true;
  while going {
    let n = libc.fread(bp, 1usize, 65536usize, src);
    if n > 0usize && libc.fwrite(bp, 1usize, n, dst) != n {
      code = lastErrno();
      going = false;
    } else if n < 65536usize {
      if libc.ferror(src) != 0i32 { code = lastErrno(); }
      going = false;
    }
  }
  libc.fclose(src);
  if libc.fclose(dst) != 0i32 && code == 0i32 { code = lastErrno(); }
  if code != 0i32 { return failedCopy(from, to, code); }
  // The original's bits (fopen gave the copy the umask's)
  var st = emptyStat();
  if posix.stat(a.cstr(), &mut st) == 0i32 {
    if copyBits(&b, u32.from(st.st_mode)) != 0i32 { return failedCopy(from, to, lastErrno()); }
  }
  succeeded()
}

fn failedCopy(from: &Path, to: &Path, code: i32) Result[void, FsError] {
  Err[void, FsError](FsError(String.from("copyFile"), from.clone(), to.clone(), code))
}

fn copyBits(c: &String, mode: u32) i32 {
  let bits = mode & modeBits;
  #if #os == .windows {
    _chmod(c.cstr(), if (bits & ownerWrite) != 0u32 {winWritable} else {winReadable})
  } #else {
    posixChmod(c.cstr(), bits)
  }
}

// -------- temporary folders --------

extern {
  fn @c _getpid() i32;
  fn @c getpid() i32;
}

// A folder made new in the system's temporary folder (TMPDIR, or /tmp, on
// POSIX; TEMP on Windows), removed with everything in it when its owner dies.
// One owner, moved, never copied. Readable by its owner alone on POSIX.
// Removal at death is best effort: a failure (a file another program holds
// open on Windows) is not reported, and leaves the folder behind.
pub struct TempDir is Move {
  dir: Path;

  // The folder's absolute path, good while this owner lives
  pub fn path(self: &) &Path { &dir }

  // Remove the folder and everything in it
  fn final(self: &uni) {
    if !dir.isEmpty() { _ = removeAll(&dir); }
  }
}

fn tempBase() Path {
  var variable: cstr = "TMPDIR";
  #if #os == .windows { variable = "TEMP"; }
  let t = libc.getenv(variable);
  if t != null {
    let p = Path.from(cstr.fromPtr(t).view());
    if !p.isEmpty() { return p; }
  }
  #if #os == .windows { Path.from(".") } #else { Path.from("/tmp") }
}

// n in lower-case hex
fn hexText(n: u64) String {
  var out = String();
  var shift = 60u64;
  var started = false;
  while true {
    let d = (n >> shift) & 15u64;
    if d != 0u64 || started || shift == 0u64 {
      started = true;
      let digit = if d < 10u64 {48u8 + u8.from(d)} else {87u8 + u8.from(d)};
      out.appendBytes(mem.sliceFromParts(&digit as *u8, 1usize));
    }
    if shift == 0u64 { break; }
    shift = shift - 4u64;
  }
  out
}

// Make a new folder, named 'cone-' and the process and the time in hex, in
// the system's temporary folder. A name already taken is tried again, so two
// calls never share a folder.
pub fn tempDir() Result[TempDir, FsError] {
  let base = tempBase();
  var tries = 0i32;
  let pid = #if #os == .windows {_getpid()} #else {getpid()};
  while true {
    var name = String.from("cone-");
    name.append(hexText(u64.from(pid)).view());
    name.append("-");
    name.append(hexText(u64.from(time.Instant.now().nanos()) + u64.from(tries)).view());
    let candidate = base.join(name.view());
    useUtf8();
    var c = cText(&candidate);
    if posix.mkdir(c.cstr(), 0x1C0u32) == 0i32 {
      // Absolute, so a later change of the current folder does not move it
      var made = candidate.clone();
      match absolute(&candidate) {
        case let Ok(a) { made = a; }
        case is Err { }
      }
      return Ok[TempDir, FsError](TempDir(made));
    }
    let code = lastErrno();
    tries = tries + 1i32;
    if code != posix.EEXIST || tries >= 100i32 { return fail[TempDir]("tempDir", &candidate, code); }
  }
  fail[TempDir]("tempDir", &base, posix.EINVAL)
}

// -------- the current folder --------

// The folder relative paths are read from, normalized ('C:/work')
pub fn currentDir() Result[Path, FsError] {
  useUtf8();
  // A null buffer of size 0: the runtime allocates one as long as it needs
  let got = posix.getcwd(null, 0usize);
  if got == null { return fail[Path]("currentDir", "", lastErrno()); }
  let raw = Path.from(cstr.fromPtr(got).view());
  libc.free(got);
  Ok[Path, FsError](raw.normalize())
}

// Make path the folder relative paths are read from, for the whole program
// (every thread)
pub fn setCurrentDir(path: &Path) Result[void, FsError] {
  if hasNul(path) { return fail[void]("setCurrentDir", path, posix.EINVAL); }
  useUtf8();
  var c = cText(path);
  if posix.chdir(c.cstr()) != 0i32 { return fail[void]("setCurrentDir", path, lastErrno()); }
  succeeded()
}

// The absolute, normalized path of path, read from the current folder: 'a.txt'
// in 'C:/work' is 'C:/work/a.txt'. Its text is all that is read: whatever is
// or is not there, links are not followed, and '..' drops the name before
// it. "" is the current folder.
pub fn absolute(path: &Path) Result[Path, FsError] {
  if hasNul(path) { return fail[Path]("absolute", path, posix.EINVAL); }
  if path.isEmpty() { return currentDir(); }
  #if #os != .windows {
    // POSIX's realpath asks the file system (the path must be there, links
    // are followed); this reads the text alone, as Windows' does: the
    // current folder, then the path, normalized
    match currentDir() {
      case let Ok(here) { return Ok[Path, FsError](here.join(path).normalize()); }
      case var Err(e) {
        e.op = String.from("absolute");
        return Err[Path, FsError](e);
      }
    }
  }
  useUtf8();
  var c = cText(path);
  let got = posix.realpath(c.cstr(), null);
  if got == null { return fail[Path]("absolute", path, lastErrno()); }
  let raw = Path.from(cstr.fromPtr(got).view());
  libc.free(got);
  Ok[Path, FsError](raw.normalize())
}

// -------- open files --------

extern {
  // Windows: the C runtime's file-descriptor calls (binary mode is asked for in the flags)
  fn @c _wopen(path: *u16, flags: i32, mode: i32) i32;
  fn @c _read(fd: i32, p: *u8, n: u32) i32;
  fn @c _write(fd: i32, p: *u8, n: u32) i32;
  fn @c _close(fd: i32) i32;
  fn @c _commit(fd: i32) i32;
  fn @c _lseeki64(fd: i32, offset: i64, whence: i32) i64;
  // Linux: the C library's
  fn @c("open") posixOpen(path: cstr, flags: i32, mode: u32) i32;
  fn @c("read") posixRead(fd: i32, p: *u8, n: usize) i64;
  fn @c("write") posixWrite(fd: i32, p: *u8, n: usize) i64;
  fn @c("close") posixClose(fd: i32) i32;
  fn @c("fsync") posixFsync(fd: i32) i32;
}

// open(2)'s flags: O_RDONLY, O_RDWR and O_TRUNC are the same on Windows's runtime and Linux; the rest differ
const openRead = 0i32;              // O_RDONLY
const openWriteOnly = 1i32;         // O_WRONLY
const openReadWrite = 2i32;         // O_RDWR
const openTruncate = 0x200i32;      // O_TRUNC
const seekStart = 0i32;             // SEEK_SET
const seekCurrent = 1i32;           // SEEK_CUR
const seekFromEnd = 2i32;           // SEEK_END
const eintr = 4i32;                 // EINTR
const oneChunk = 0x40000000usize;   // the most one call is asked for: _read/_write count in 32 bits, so a larger count goes in 1 GiB pieces (write loops; read answers fewer)

// O_APPEND: every write goes to the end of the file
fn appendFlag() i32 { #if #os == .windows { 0x8i32 } #else { 0x400i32 } }

// O_CREAT
fn createFlag() i32 { #if #os == .windows { 0x100i32 } #else { 0x40i32 } }

// _O_BINARY | _O_NOINHERIT on Windows (no line-end changes, not passed to child programs); O_CLOEXEC on Linux
fn plainFlags() i32 { #if #os == .windows { 0x8080i32 } #else { 0x80000i32 } }

fn openFd(path: &Path, flags: i32) i32 {
  var c = cText(path);
  // A new file's mode: 0o666 (less the umask) on Linux; Windows reads only whether it may be written
  #if #os == .windows {
    // the name goes to '_wopen' as UTF-16 (converted from UTF-8, as setTimesWindows does), never the ANSI page
    let n = MultiByteToWideChar(utf8CodePage, invalidUtf8Fails, c.cstr().ptr(), -1i32, null, 0i32);
    if n <= 0i32 { *libc.errno() = posix.EINVAL; return -1i32; }
    let wide = libc.malloc(usize.from(n) * 2usize) as *u16;
    MultiByteToWideChar(utf8CodePage, invalidUtf8Fails, c.cstr().ptr(), -1i32, wide, n);
    let fd = _wopen(wide, flags | plainFlags(), 0x180i32);
    let saved = lastErrno();
    libc.free(wide as *u8);
    *libc.errno() = saved;
    fd
  }
  #else { posixOpen(c.cstr(), flags | plainFlags(), 0x1B6u32) }
}

fn rawRead(fd: i32, p: *u8, n: usize) i64 {
  let want = if n > oneChunk {oneChunk} else {n};
  #if #os == .windows { i64.from(_read(fd, p, u32.from(want))) } #else { posixRead(fd, p, want) }
}

fn rawWrite(fd: i32, p: *u8, n: usize) i64 {
  let want = if n > oneChunk {oneChunk} else {n};
  #if #os == .windows { i64.from(_write(fd, p, u32.from(want))) } #else { posixWrite(fd, p, want) }
}

fn rawSeek(fd: i32, offset: i64, whence: i32) i64 {
  #if #os == .windows { _lseeki64(fd, offset, whence) } #else { lseek(fd, offset, whence) }
}

fn rawClose(fd: i32) i32 {
  #if #os == .windows { _close(fd) } #else { posixClose(fd) }
}

fn rawSync(fd: i32) i32 {
  #if #os == .windows { _commit(fd) } #else { posixFsync(fd) }
}

// A file held open, for reading, writing or both, with a position that every read and write moves. Nothing
// is buffered here: each 'read' and 'write' is one system call (or a few, for a write that goes in pieces),
// so a program that reads small pieces wraps the file in a 'LineReader' or reads big blocks itself. One owner,
// moved, never copied; dying closes the handle, and a failure of that close is lost, so a program that must
// know calls 'close' itself. Every failure is an 'FsError' naming the operation and the path, as the rest of
// this package's are. The bytes are as they are: no line ends are changed on Windows either.
pub struct File is Move {
  fd: i32;           // the descriptor; -1 once closed
  given: Path;       // as it was given, for the failures

  fn failed(self: &, op: &str, code: i32) FsError { failure(op, &given, code) }

  // The next bytes into 'buf', as many as it has room for or the file has left, whichever is less: how
  // many. 0 means the end of the file (or an empty 'buf'). A read can answer fewer bytes than there are
  // left, so a program that wants a full block asks again.
  pub fn read(self: &mut, buf: &mut Array[u8]) Result[usize, FsError] {
    if fd < 0i32 { return Err[usize, FsError](self.failed("read", posix.EBADF)); }
    if buf.len == 0usize { return Ok[usize, FsError](0usize); }
    var going = true;
    while going {
      let n = rawRead(fd, buf as *u8, buf.len);
      if n >= 0i64 { return Ok[usize, FsError](usize.from(n)); }
      if lastErrno() != eintr { going = false; }
    }
    Err[usize, FsError](self.failed("read", lastErrno()))
  }

  // All of 'data' at the position, however many system calls it takes; the position moves past it. A file
  // opened with 'open' is read-only and refuses it (EBADF).
  pub fn write(self: &mut, data: &Array[u8]) Result[void, FsError] {
    if fd < 0i32 { return Err[void, FsError](self.failed("write", posix.EBADF)); }
    var done = 0usize;
    while done < data.len {
      let n = rawWrite(fd, (data as *u8) + done, data.len - done);
      if n > 0i64 { done = done + usize.from(n); }
      else if n == 0i64 { return Err[void, FsError](self.failed("write", posix.EIO)); }
      else if lastErrno() != eintr { return Err[void, FsError](self.failed("write", lastErrno())); }
    }
    succeeded()
  }

  // Move to byte 'pos' from the start of the file (past its end is allowed: a write there leaves a gap).
  // Answers the new position.
  pub fn seek(self: &mut, pos: u64) Result[u64, FsError] {
    if pos > 0x7FFFFFFFFFFFFFFFu64 { return Err[u64, FsError](self.failed("seek", posix.EINVAL)); }
    self.moveTo("seek", i64.from(pos), seekStart)
  }

  // Move by 'delta' bytes from where the position is (negative goes back). Answers the new position;
  // a move before the start is refused (EINVAL).
  pub fn seekBy(self: &mut, delta: i64) Result[u64, FsError] {
    self.moveTo("seekBy", delta, seekCurrent)
  }

  // Move to 'delta' bytes from the end of the file (0 is the end, negative goes back). Answers the new
  // position, so 'seekEnd(0)' is the file's size.
  pub fn seekEnd(self: &mut, delta: i64) Result[u64, FsError] {
    self.moveTo("seekEnd", delta, seekFromEnd)
  }

  fn moveTo(self: &mut, op: &str, offset: i64, whence: i32) Result[u64, FsError] {
    if fd < 0i32 { return Err[u64, FsError](self.failed(op, posix.EBADF)); }
    let at = rawSeek(fd, offset, whence);
    if at < 0i64 { return Err[u64, FsError](self.failed(op, lastErrno())); }
    Ok[u64, FsError](u64.from(at))
  }

  // Ask the system to put what was written on the disk (fsync; _commit on Windows). Nothing is held back
  // by this package, so a program that does not need the bytes safely on the disk need not call it.
  pub fn flush(self: &mut) Result[void, FsError] {
    if fd < 0i32 { return Err[void, FsError](self.failed("flush", posix.EBADF)); }
    if rawSync(fd) != 0i32 { return Err[void, FsError](self.failed("flush", lastErrno())); }
    succeeded()
  }

  // Close the file now, and say whether that worked (a write the disk refused can show only here). It is
  // closed either way; closing again does nothing and answers Ok.
  pub fn close(self: &mut) Result[void, FsError] {
    if fd < 0i32 { return succeeded(); }
    let was = fd;
    fd = -1i32;
    if rawClose(was) != 0i32 { return Err[void, FsError](self.failed("close", lastErrno())); }
    succeeded()
  }

  // The path it was opened with
  pub fn path(self: &) &Path { &given }

  // Close the handle if 'close' has not
  fn final(self: &uni) {
    if fd >= 0i32 { rawClose(fd); }
  }
}

fn openWith(op: &str, path: &Path, flags: i32) Result[File, FsError] {
  if hasNul(path) { return fail[File](op, path, posix.EINVAL); }
  useUtf8();
  let fd = openFd(path, flags);
  if fd < 0i32 { return fail[File](op, path, openErrno(path)); }
  // Linux opens a folder for reading and fails only at the first read; refuse it here, as Windows does
  if isDir(path) { rawClose(fd); return fail[File](op, path, posix.EISDIR); }
  Ok[File, FsError](File(fd, path.clone()))
}

// Open an existing file for reading, at its start. A missing file is NotFound; a folder is refused
// (EISDIR), as 'readFile' refuses it.
pub fn open(path: &Path) Result[File, FsError] {
  openWith("open", path, openRead)
}

// Make a file for reading and writing, at its start: a new one if the path is free, and an existing
// one is emptied. A missing folder above it is NotFound.
pub fn create(path: &Path) Result[File, FsError] {
  openWith("create", path, openReadWrite | createFlag() | openTruncate)
}

// Open a file for writing only, made if the path is free (an existing one keeps its bytes), every write
// going to the end of the file whatever the position (O_APPEND; _O_APPEND on Windows). A read is refused
// (EBADF).
pub fn append(path: &Path) Result[File, FsError] {
  openWith("append", path, openWriteOnly | createFlag() | appendFlag())
}

// -------- lines --------

const lineBuffer = 65536usize;

// Lines read from a 'File', one 'readLine' at a time, as 'stdinput.readLine' reads them from standard input.
// It reads the file in 64 KiB blocks and finds the line ends in the block, so a line costs no call per byte
// and a long line (past the block) is gathered from as many blocks as it takes. It owns the file ('over'
// takes it), so the file's position is the reader's.
//
//   match fs.open("notes.txt") {
//     case let Ok(f) {
//       var lines = fs.LineReader.over(f);
//       var line = String();
//       var going = true;
//       while going {
//         match lines.readLine(&mut line) {
//           case let Ok(more) { if more { print <- line.view(), "\n"; } else { going = false; } }
//           case is Err { going = false; }
//         }
//       }
//     }
//     case is Err { }
//   }
pub struct LineReader is Move {
  file: File;
  buf: List[u8];     // lineBuffer bytes, the first 'end' of them read from the file
  pos: usize;        // the next unread byte of buf
  end: usize;        // bytes in buf that were read from the file

  // A reader of 'file' from where its position is now
  pub fn over(file: File) LineReader {
    var b = List[u8].withCapacity(lineBuffer);
    var i = 0usize;
    while i < lineBuffer { b.push(0u8); i = i + 1usize; }
    LineReader(file, b, 0usize, 0usize)
  }

  // The next line into 'line', replacing what it held, without its line end ('\n' or '\r\n'). Ok(false),
  // with 'line' empty, at the end of the file. A last line with no '\n' is a line, as it is for stdinput;
  // so is an empty one. The bytes go in as they came: String holds UTF-8 by convention and checks no
  // more than 'appendBytes' does, so a file that is not text makes a String that is not. It does not
  // validate UTF-8, matching String today.
  pub fn readLine(self: &mut, line: &mut String) Result[bool, FsError] {
    line.clear();
    var any = false;
    while true {
      if pos == end {
        match file.read(buf.viewMut()) {
          case let Ok(n) {
            if n == 0usize { return Ok[bool, FsError](any); }
            pos = 0usize;
            end = n;
          }
          case let Err(e) { return Err[bool, FsError](e); }
        }
      }
      let base: *u8 = buf.viewMut() as *u8;
      var i = pos;
      while i < end && *(base + i) != 10u8 { i = i + 1usize; }
      line.appendBytes(mem.sliceFromParts(base + pos, i - pos));
      any = true;
      if i < end {
        pos = i + 1usize;
        let keep = line.len();
        if keep > 0usize && line[keep - 1usize] == 13u8 { line.truncate(keep - 1usize); }
        return Ok[bool, FsError](true);
      }
      pos = end;
    }
    Ok[bool, FsError](any)
  }
}
