// Every file below a folder, the current one or the one the first argument
// names, with its size in bytes, depth first and in name order:
//
//   congo run packages/fs/examples/sizes.cone -- packages/fs

mod sizes;

import stdio use *;
import collections use *;
import fs;
import path use Path;

fn main(argc i32, argv **u8) i32 {
  let root = if argc > 1i32 {Path.from(String.fromCStr(cstr.fromPtr(*(argv + 1usize))).view())} else {Path.from(".")};
  match fs.walk(&root) {
    case let e Error {
      let m = e.message();
      eprintStr(m.view());
      eprintStr("\n");
      return 1i32;
    }
    case let all Ok {
      let entries = &all;
      var total = 0i64;
      var i = 0usize;
      while i < entries.len() {
        let entry = entries[i];
        if entry.isFile {
          match fs.stat(&entry.path) {
            case let s Ok {
              total = total + s.size;
              var size = String.empty();
              size.appendInt(s.size);
              size.padStart(10usize);
              printStr(size.view());
              printStr("  ");
              printStr(entry.path.view());
              printStr("\n");
            }
            case let e Error {
              let m = e.message();
              eprintStr(m.view());
              eprintStr("\n");
            }
          }
        }
        i = i + 1usize;
      }
      printInt(total);
      printStr(" bytes in all\n");
    }
  }
  0i32
}
