// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import path use Path;
import fs;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- fs.FsError(String.from("readFile"), Path.from("notes.txt"), Path.from(""), 2i32), "readFile notes.txt: No such file or directory", "one path");
  says(String() <- fs.FsError(String.from("rename"), Path.from("a.txt"), Path.from("b.txt"), 17i32), "rename a.txt to b.txt: File exists", "two paths");
  says(String() <- fs.FsError(String.from("sync"), Path.from(""), Path.from(""), 2i32), "sync: No such file or directory", "no path");
  done()
}
