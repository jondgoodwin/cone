// Folders: made one at a time and with their parents, refused where they
// cannot be made, listed in name order (UTF-8 names among them), walked,
// and removed, empty and whole; a link to a folder (a directory junction on
// Windows, made with cmd's 'mklink /J'; a symbolic link on POSIX, made with
// 'ln -s') listed as a link, not walked into, and removed without what it
// leads to; the guards 'removeAll' keeps; and the current folder read,
// changed, used and restored, with 'absolute' read from it. What differs by
// system (a '\' separates names only on Windows, as does a drive; names
// differing only in ASCII case are one name only on Windows) is checked the
// way each system does it, in the same number of checks.
//
// It works in a folder of its own under TEMP (TMPDIR or /tmp on POSIX),
// 'cone-fs-test-folders', which it clears if an interrupted run left it,
// makes, and removes at the end. Every path it touches is built from that
// folder, and nothing is removed until the folder's path has been checked to
// be TEMP's, absolute, with that name after it. The link leads to a folder
// inside it too. Paths are printed with the folder shown as '<root>'.

mod folders;

import testing use *;
import collections use *;
import libc;
import posix;
import path use Path;
import fs;

// The test's folder: TEMP's absolute path and the name, after checking
// that it is that and nothing shorter
fn makeRoot(name &str) Path {
  var variable cstr = "TMPDIR";
  if isWindows() { variable = "TEMP"; }
  let temp = libc.getenv(variable);
  require(temp != null or not isWindows(), "TEMP is set");
  let tempPath = if temp != null {Path.from(cstr.fromPtr(temp).view());} else {Path.from("/tmp");};
  var root = Path.from("");
  match fs.absolute(&tempPath) {
    case let t Ok { root = t.join(name); }
    case is Error { require(false, "TEMP has an absolute path"); }
  }
  let up = root.parent();
  let safe = root.isAbsolute() and root.view().endsWith(name) and up.view().len() > 3usize;
  require(safe, "the test's folder is under TEMP");
  root;
}

fn shown(root &Path, text &Array[u8]) String {
  var out = String.fromBytes(text);
  if not root.isEmpty() { out.replace(root.view(), "<root>" as &str); }
  out;
}

fn messageOf[T](root &Path, r Result[T, fs.FsError]) String {
  match r {
    case let e Error { let m = e.message(); shown(root, m.view()); }
    case is Ok { String.from("<succeeded>"); }
  }
}

fn ok[T](r Result[T, fs.FsError], label &Array[u8]) bool {
  let m = messageOf("", r);
  expectStr(m.view(), "<succeeded>", label);
}

fn failsWith[T](root &Path, r Result[T, fs.FsError], want &Array[u8], label &Array[u8]) bool {
  let m = messageOf(root, r);
  expectStr(m.view(), want, label);
}

// A listing shown on one line: each entry's path (the root as '<root>'),
// then '/' for a folder, '@' for a link, nothing for a file, then ' '
fn showEntries(root &Path, entries &List[fs.DirEntry]) String {
  var out = String.empty();
  var i = 0usize;
  while i < entries.len() {
    let e = entries[i];
    let p = shown(root, e.path.view());
    out.append(p.view());
    if e.isDir { out.append("/"); }
    if e.isLink { out.append("@"); }
    if e.isFile and (e.isDir or e.isLink) { out.append("!"); }
    out.append(" ");
    i = i + 1usize;
  }
  out;
}

fn listingIs(root &Path, dir &Path, want &Array[u8], label &Array[u8]) {
  match fs.readDir(dir) {
    case let l Ok { let s = showEntries(root, &l); expectStr(s.view(), want, label); }
    case let e Error {
      let m = e.message();
      let s = shown(root, m.view());
      expectStr(s.view(), want, label);
    }
  }
}

fn walkIs(root &Path, dir &Path, want &Array[u8], label &Array[u8]) {
  match fs.walk(dir) {
    case let l Ok { let s = showEntries(root, &l); expectStr(s.view(), want, label); }
    case let e Error {
      let m = e.message();
      let s = shown(root, m.view());
      expectStr(s.view(), want, label);
    }
  }
}

fn touch(p &Path) { ok(fs.writeFile(p, "x"), "write a file"); }

fn making(root &Path) {
  let one = root.join("one");
  ok(fs.makeDir(&one), "makeDir");
  expect(fs.isDir(&one), "made a folder");
  failsWith(root, fs.makeDir(&one), "makeDir <root>/one: File exists", "makeDir again");
  match fs.makeDir(&one) {
    case let e Error { expect(e.alreadyExists(), "makeDir again is alreadyExists"); }
    case is Ok { expect(false, "makeDir again fails"); }
  }
  let deep = root.join("two/three/four");
  failsWith(root, fs.makeDir(&deep), "makeDir <root>/two/three/four: No such file or directory",
    "makeDir without its parent");
  ok(fs.makeDirAll(&deep), "makeDirAll");
  expect(fs.isDir(&deep), "made with its parents");
  ok(fs.makeDirAll(&deep), "makeDirAll of a folder there is success");
  let trailing = root.join(if isWindows() {"five\\six\\";} else {"five/six/";});
  ok(fs.makeDirAll(&trailing), "makeDirAll with a trailing separator");
  let six = root.join("five/six");
  expect(fs.isDir(&six), "made through a trailing separator");

  // A file in the way
  let file = root.join("one/file");
  touch(&file);
  let under = root.join("one/file/sub");
  failsWith(root, fs.makeDirAll(&under), "makeDirAll <root>/one/file: Not a directory",
    "makeDirAll through a file");
  failsWith(root, fs.makeDirAll(&file), "makeDirAll <root>/one/file: Not a directory",
    "makeDirAll over a file");

  // Removing: an empty folder, not one with something in it
  let two = root.join("two");
  failsWith(root, fs.removeDir(&two), "removeDir <root>/two: Directory not empty", "removeDir of a full folder");
  ok(fs.removeDir(&deep), "removeDir of an empty folder");
  expect(not fs.exists(&deep), "removed");
  failsWith(root, fs.removeDir(&deep), "removeDir <root>/two/three/four: No such file or directory",
    "removeDir of a folder not there");
  ok(fs.removeAll(&two), "removeAll of a tree");
  expect(not fs.exists(&two), "the tree is gone");
  let five = root.join("five");
  ok(fs.removeAll(&five), "removeAll of another");
  ok(fs.removeAll(&five), "removeAll of nothing there is success");
  ok(fs.removeAll(&file), "removeAll of a file");
  expect(not fs.exists(&file), "the file is gone");
  ok(fs.removeDir(&one), "one is empty again");
}

fn listing(root &Path) {
  let list = root.join("list");
  ok(fs.makeDir(&list), "make list");
  // Made in an order that is not the listing's
  let names = new List[String] <- String.from("日本"), String.from("b"), String.from("Big"),
    String.from("a.txt"), String.from("é"), String.from("a"), String.from("Z.txt");
  var i = 0usize;
  while i < names.len() {
    let p = list.join(names[i].view());
    if names[i].endsWith(".txt") { touch(&p); } else { ok(fs.makeDir(&p), "make a folder to list"); }
    i = i + 1usize;
  }
  let inner = list.join("a/inner.txt");
  touch(&inner);
  let deeper = list.join("é/日本/deep.txt");
  let nested = list.join("é/日本");
  ok(fs.makeDir(&nested), "make é/日本");
  touch(&deeper);

  // Windows: names are one name whatever their ASCII case; POSIX: 'B' is
  // another folder (made, then removed, so the listings below read the same)
  let capitalB = list.join("B");
  if isWindows() {
    failsWith(root, fs.makeDir(&capitalB), "makeDir <root>/list/B: File exists",
      "Windows: 'B' is the folder 'b'");
    expect(fs.isDir(&capitalB), "Windows: 'B' names a folder");
  } else {
    ok(fs.makeDir(&capitalB), "POSIX: 'B' is another folder");
    ok(fs.removeDir(&capitalB), "and is removed again");
  }

  // Byte order: capitals before small letters, UTF-8 after ASCII
  listingIs(root, &list,
    "<root>/list/Big/ <root>/list/Z.txt <root>/list/a/ <root>/list/a.txt <root>/list/b/ <root>/list/é/ <root>/list/日本/ ",
    "readDir, sorted by bytes");
  let empty = list.join("b");
  listingIs(root, &empty, "", "readDir of an empty folder");
  let aTxt = list.join("a.txt");
  listingIs(root, &aTxt, "readDir <root>/list/a.txt: Not a directory", "readDir of a file");
  let none = list.join("none");
  listingIs(root, &none, "readDir <root>/list/none: No such file or directory", "readDir of nothing");
  // A trailing separator ('\' on Windows, where it separates)
  let slashed = list.join(if isWindows() {"a\\";} else {"a/";});
  listingIs(root, &slashed, if isWindows() {"<root>/list/a\\inner.txt ";} else {"<root>/list/a/inner.txt ";},
    "readDir with a trailing separator");

  walkIs(root, &list,
    "<root>/list/Big/ <root>/list/Z.txt <root>/list/a/ <root>/list/a/inner.txt <root>/list/a.txt <root>/list/b/ <root>/list/é/ <root>/list/é/日本/ <root>/list/é/日本/deep.txt <root>/list/日本/ ",
    "walk, depth first, each folder sorted");
  walkIs(root, &empty, "", "walk of an empty folder");
  walkIs(root, &none, "walk <root>/list/none: No such file or directory", "walk of nothing");

  ok(fs.removeAll(&list), "removeAll of the listed tree, UTF-8 names among it");
  expect(not fs.exists(&list), "listed tree gone");
}

// A link to a folder: a junction, Windows', made by cmd, or a symbolic link,
// made by the shell's 'ln -s'. Both paths are inside the test's folder, and
// quoted, since TEMP may hold a space
fn junction(link &Path, target &Path) bool {
  var command = String.empty();
  if isWindows() {
    var paths = String.from(link.view());
    paths.append("\" \"");
    paths.append(target.view());
    paths.replaceByte('/', '\\');
    command.append("mklink /J \"");
    command.append(paths.view());
    command.append("\" >nul");
  } else {
    command.append("ln -s '");
    command.append(target.view());
    command.append("' '");
    command.append(link.view());
    command.append("'");
  }
  libc.system(command.cstr()) == 0i32;
}

fn links(root &Path) {
  let target = root.join("target");
  let kept = root.join("target/kept.txt");
  let tree = root.join("tree");
  let link = root.join("tree/link");
  ok(fs.makeDir(&target), "make target");
  touch(&kept);
  ok(fs.makeDir(&tree), "make tree");
  require(junction(&link, &target), "mklink /J made a junction");

  listingIs(root, &tree, "<root>/tree/link@ ", "a junction is listed as a link");
  walkIs(root, &tree, "<root>/tree/link@ ", "walk does not go into a junction");
  // stat follows it
  expect(fs.isDir(&link), "stat follows a junction to its folder");
  let through = root.join("tree/link/kept.txt");
  expect(fs.isFile(&through), "a file through a junction");

  ok(fs.removeAll(&tree), "removeAll of a tree holding a junction");
  expect(not fs.exists(&tree), "the tree is gone");
  expect(fs.isFile(&kept), "what the junction led to is kept");

  // A junction given to removeAll itself: the link goes, its folder stays
  ok(fs.makeDir(&tree), "make tree again");
  require(junction(&link, &target), "mklink /J again");
  ok(fs.removeAll(&link), "removeAll of a junction");
  expect(not fs.exists(&link), "the junction is gone");
  expect(fs.isFile(&kept), "what it led to is still kept");
  ok(fs.removeAll(&tree), "remove tree");
  ok(fs.removeAll(&target), "remove target");
}

fn guards(root &Path) {
  failsWith(root, fs.removeAll(""), "removeAll: Invalid argument", "removeAll of an empty path");
  failsWith(root, fs.removeAll("."), "removeAll .: Invalid argument", "removeAll of '.'");
  failsWith(root, fs.removeAll(".."), "removeAll ..: Invalid argument", "removeAll of '..'");
  failsWith(root, fs.removeAll("x/.."), "removeAll x/..: Invalid argument", "removeAll of a path coming to '.'");
  failsWith(root, fs.removeAll("../.."), "removeAll ../..: Invalid argument", "removeAll ending in '..'");
  // A drive's root, a drive and a share are Windows'; POSIX has the root
  // spelled other ways instead
  if isWindows() {
    failsWith(root, fs.removeAll("C:\\"), "removeAll C:\\: Invalid argument", "removeAll of a drive's root");
    failsWith(root, fs.removeAll("C:"), "removeAll C:: Invalid argument", "removeAll of a drive");
  } else {
    failsWith(root, fs.removeAll("//"), "removeAll //: Invalid argument", "removeAll of a root written twice");
    failsWith(root, fs.removeAll("/."), "removeAll /.: Invalid argument", "removeAll of a root's '.'");
  }
  failsWith(root, fs.removeAll("/"), "removeAll /: Invalid argument", "removeAll of a root");
  if isWindows() {
    failsWith(root, fs.removeAll("\\\\server\\share"), "removeAll \\\\server\\share: Invalid argument",
      "removeAll of a share");
  } else {
    failsWith(root, fs.removeAll("/.."), "removeAll /..: Invalid argument", "removeAll of a root's '..'");
  }
  let withDot = root.join("x/.");
  failsWith(root, fs.removeAll(&withDot), "removeAll <root>/x/.: Invalid argument", "removeAll ending in '.'");
}

fn currentFolder(root &Path) {
  var before = Path.from("");
  match fs.currentDir() {
    case var c Ok { before <=> c; }
    case is Error { require(false, "currentDir"); }
  }
  expect(before.isAbsolute(), "currentDir is absolute");
  expect(not before.view().contains("\\"), "currentDir is normalized");

  let here = root.join("here é");
  ok(fs.makeDir(&here), "make 'here é'");
  ok(fs.setCurrentDir(&here), "setCurrentDir");
  match fs.currentDir() {
    case let c Ok {
      let want = here.normalize();
      expectStr(c.view(), want.view(), "currentDir is where it was set");
    }
    case is Error { expect(false, "currentDir after setCurrentDir"); }
  }
  // Relative paths read from it
  ok(fs.writeFile("rel.txt", "relative"), "write a relative path");
  let rel = here.join("rel.txt");
  expect(fs.isFile(&rel), "a relative path lands in the current folder");

  // absolute: the current folder's normalized path, then the name, '..' read
  let norm = here.normalize();
  var wantRel = String.from(norm.view());
  wantRel.append("/rel.txt");
  match fs.absolute("rel.txt") {
    case let a Ok { expectStr(a.view(), wantRel.view(), "absolute of a name"); }
    case is Error { expect(false, "absolute of a name"); }
  }
  let dotted = Path.from(if isWindows() {"sub\\..\\.\\rel.txt";} else {"sub/.././rel.txt";});
  match fs.absolute(&dotted) {
    case let a Ok { expectStr(a.view(), wantRel.view(), "absolute reads '.' and '..'"); }
    case is Error { expect(false, "absolute with '..'"); }
  }
  match fs.absolute("not-there.txt") {
    case let a Ok {
      let want = norm.join("not-there.txt");
      expectStr(a.view(), want.view(), "absolute of a name not there");
    }
    case is Error { expect(false, "absolute of a name not there"); }
  }
  match fs.absolute("") {
    case let a Ok { expectStr(a.view(), norm.view(), "absolute of \"\" is the current folder"); }
    case is Error { expect(false, "absolute of \"\""); }
  }
  match fs.absolute("..") {
    case let a Ok {
      let want = root.normalize();
      expectStr(a.view(), want.view(), "absolute of '..'");
    }
    case is Error { expect(false, "absolute of '..'"); }
  }
  let elsewhere = Path.from(if isWindows() {"C:\\Some\\..\\Where";} else {"/Some/../Where";});
  match fs.absolute(&elsewhere) {
    case let a Ok { expectStr(a.view(), if isWindows() {"C:/Where";} else {"/Where";}, "absolute of an absolute path"); }
    case is Error { expect(false, "absolute of an absolute path"); }
  }
  let missing = root.join("missing");
  failsWith(root, fs.setCurrentDir(&missing), "setCurrentDir <root>/missing: No such file or directory",
    "setCurrentDir to nothing");

  // Back where it started
  ok(fs.setCurrentDir(&before), "setCurrentDir back");
  match fs.currentDir() {
    case let c Ok { expectStr(c.view(), before.view(), "currentDir restored"); }
    case is Error { expect(false, "currentDir restored"); }
  }
  ok(fs.removeAll(&here), "remove 'here é'");
}

fn main() i32 {
  let root = makeRoot("cone-fs-test-folders");
  require(fs.removeAll(&root) is Ok, "clear what an earlier run left");
  require(fs.makeDir(&root) is Ok, "make the test's folder");

  making(&root);
  listing(&root);
  links(&root);
  guards(&root);
  currentFolder(&root);

  listingIs(&root, &root, "", "the test's folder is empty again");
  ok(fs.removeAll(&root), "remove the test's folder");
  expect(not fs.exists(&root), "the test's folder is gone");
  done();
}
