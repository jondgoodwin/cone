// The walk on flat ground: the numbers of the gait, the cycle's period, the
// feet's contact in the right phase windows, a planted foot staying where it
// is, the reach of the legs, the idle motion and a hard landing's crouch.
//
// A 1.75 m walker goes at 1.4 m/s for 8 seconds in 1/60 s steps. At that
// speed the stride is 0.80 H = 1.4 m and the cycle one second exactly, with
// the duty factor 0.62, so a foot is down for 0.62 s and swings for 0.38 s.
// Then it stops.

mod walk;

import testing use *;
import collections use List;
import geomath use *;
import bonepose use *;
import walkgait use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn flatGround(x: f32, z: f32) f32 { 0. }

fn testNumbers() {
  near(walkRunSpeed(0.93, 9.81), 2.1366, 0.001, "walk-run speed for a 0.93 m hip");
  near(strideLength(1.75, 1.4), 1.4, 0.0001, "stride at 1.4 m/s is 0.8 H");
  near(strideLength(1.75, 0.35), 0.7, 0.0001, "stride grows as the square root of speed (a quarter of the speed, half the stride)");
  near(strideLength(1.75, 10.), 2.45, 0.0001, "and is held to 1.4 H");
  near(dutyFactor(1.0), 0.62, 0.0001, "duty 0.62 walking");
  near(dutyFactor(4.0), 0.40, 0.0001, "duty 0.40 at 4 m/s");
  // The rocker is continuous at the ends of its three parts
  let r1 = rocker(1.75, 0.1199);
  let r2 = rocker(1.75, 0.1201);
  near(r1.x, r2.x, 0.001, "heel rocker meets flat: x");
  near(r1.y, r2.y, 0.001, "and y");
  let r3 = rocker(1.75, 0.5499);
  let r4 = rocker(1.75, 0.5501);
  near(r3.x, r4.x, 0.001, "flat meets toe rocker: x");
  near(r3.y, r4.y, 0.001, "and y");
  // The backward roll is joined the same way, lands toe down and leaves toe up
  let b1 = rockerBack(1.75, 0.1199);
  let b2 = rockerBack(1.75, 0.1201);
  near(b1.x, b2.x, 0.001, "backward roll meets flat: x");
  near(b1.y, b2.y, 0.001, "and y");
  let b3 = rockerBack(1.75, 0.5499);
  let b4 = rockerBack(1.75, 0.5501);
  near(b3.x, b4.x, 0.001, "flat meets the heel pivot: x");
  near(b3.y, b4.y, 0.001, "and y");
  near(rockerBack(1.75, 0.).z, -0.2094395, 0.0001, "backward, a foot lands toe down 12 degrees");
  near(rockerBack(1.75, 1.).z, 0.6108652, 0.0001, "and leaves toe up 35 degrees");
  // Flat: the ankle 0.039 H above the sole and 0.04 H ahead of the heel
  let flat = rocker(1.75, 0.3);
  near(flat.x, 0.04 * 1.75, 0.0001, "flat foot: the ankle 0.04 H ahead of the heel");
  near(flat.y, 0.039 * 1.75, 0.0001, "and 0.039 H up");
}

fn main() i32 {
  testNumbers();
  let h = 1.75f;
  let skel = humanoid(h);
  var pose = skel.restPose();
  var models = List[Transform3].empty();
  var w = Walker.make(h, 3u32);
  let dt = 1.f / 60.;
  let v = 1.4f;
  var z = 0.f;
  var frame = 0;
  var ankleHere = Vec3(0., 0., 0.);
  var planted = false;
  var driftWorst = 0.f;
  var lowest = 10.f;
  var highest = 0.f;
  var swingClear = 0.f;
  var stanceHigh = 0.f;
  var flatCount = 0;
  var swingCount = 0;
  var overReach = 0.f;
  var yAtT6 = 0.f;
  var yAtT7 = 0.f;
  var zrelAtT6 = 0.f;
  var zrelAtT7 = 0.f;
  var stances = 0;
  var wasSwinging = false;
  while frame < 480 {
    z = z - v * dt;
    let at = Vec3(0., 0., z);
    w.update(&skel, &mut pose, &mut models, at, 0., v, 0., true, (x, z) => 0., dt);
    let ankle = (*models[FOOT_L]).translation + at;
    let hip = (*models[THIGH_L]).translation + at;
    if frame >= 240 {
      // Planted: in the flat part of a stance the left ankle does not move
      let inFlat = !w.left.swinging && w.left.t > 0.16 && w.left.t < 0.54;
      if inFlat {
        flatCount = flatCount + 1;
        if !planted { ankleHere = ankle; planted = true; stances = stances + 1; }
        let d = (ankle - ankleHere).length();
        if d > driftWorst { driftWorst = d; }
        if absf(ankle.y - 0.039 * h) > stanceHigh { stanceHigh = absf(ankle.y - 0.039 * h); }
      } else {
        planted = false;
      }
      if w.left.swinging && w.left.t > 0.45 && w.left.t < 0.55 {
        swingCount = swingCount + 1;
        if ankle.y - 0.039 * h > swingClear { swingClear = ankle.y - 0.039 * h; }
      }
      let pelvisY = (*models[PELVIS]).translation.y;
      if pelvisY < lowest { lowest = pelvisY; }
      if pelvisY > highest { highest = pelvisY; }
      // The leg: hip to ankle, never past its reach
      let leg = (ankle - hip).length();
      if leg > overReach { overReach = leg; }
    }
    // Sampled a cycle (60 frames) apart: the same phase, the same pose
    if frame == 360 { yAtT6 = ankle.y; zrelAtT6 = ankle.z - z; }
    if frame == 420 { yAtT7 = ankle.y; zrelAtT7 = ankle.z - z; }
    frame = frame + 1;
  }
  near(yAtT7, yAtT6, 0.003, "periodic: the ankle's height a cycle later");
  near(zrelAtT7, zrelAtT6, 0.003, "periodic: the ankle's place against the body a cycle later");
  expectBool(stances >= 3, true, "at least three stances measured");
  near(driftWorst, 0., 0.01, "a foot in the flat of its stance stays put (within 1 cm)");
  near(stanceHigh, 0., 0.005, "and flat on the ground");
  expectBool(swingClear > 0.03, true, "the swing foot clears the ground by more than 3 cm at mid-swing");
  expectBool(swingClear < 0.15, true, "and by less than 15 cm");
  let full = (0.245 + 0.246) * h;
  expectBool(overReach < full, true, "the leg never past its full length");
  expectBool(overReach > 0.9 * full, true, "and walks fairly straight");
  let bob = highest - lowest;
  expectBool(bob > 0.015 && bob < 0.10, true, "the pelvis bobs by between 1.5 and 10 cm");
  // The phase windows: at the phase 0.31 (mid-stance of the left) the left is down
  // and at 0.81 it swings (duty 0.62)
  expectBool(w.speed > 1.39, true, "the speed settled at 1.4 m/s");

  // Phase windows against the walker's own phase, run again slowly to read them
  var w2 = Walker.make(h, 5u32);
  var p2 = skel.restPose();
  var m2 = List[Transform3].empty();
  var z2 = 0.f;
  var k = 0;
  var leftDownOk = true;
  var leftUpOk = true;
  var rightOk = true;
  while k < 300 {
    z2 = z2 - v * dt;
    w2.update(&skel, &mut p2, &mut m2, Vec3(0., 0., z2), 0., v, 0., true, &flatGround, dt);
    if k > 120 {
      let ph = w2.phase;
      if ph > 0.05 && ph < 0.57 && w2.left.swinging { leftDownOk = false; }
      if ph > 0.67 && ph < 0.97 && !w2.left.swinging { leftUpOk = false; }
      // The right foot is half a cycle on: it swings while the phase is in 0.17 to 0.47
      if ph > 0.17 && ph < 0.45 && !w2.right.swinging { rightOk = false; }
      if ph > 0.55 && ph < 0.95 && w2.right.swinging { rightOk = false; }
    }
    k = k + 1;
  }
  expectBool(leftDownOk, true, "the left foot is down while the phase is 0.05 to 0.57");
  expectBool(leftUpOk, true, "and swinging while it is 0.67 to 0.97");
  expectBool(rightOk, true, "the right foot is half a cycle behind");

  // Stopping: two more steps and then both feet flat and still
  var s = 0;
  while s < 240 {
    w.update(&skel, &mut pose, &mut models, Vec3(0., 0., z), 0., 0., 0., true, &flatGround, dt);
    s = s + 1;
  }
  expectBool(w.frozen, true, "stopped: the walker stands");
  let la = (*models[FOOT_L]).translation;
  let ra = (*models[FOOT_R]).translation;
  near(la.y, 0.039 * h, 0.005, "left foot flat");
  near(ra.y, 0.039 * h, 0.005, "right foot flat");
  near(la.z, ra.z, 0.05, "feet level with each other, not staggered");
  near(ra.x - la.x, 0.191 * h, 0.03, "feet a hip's width apart");
  // The idle layer: the chest moves with breath
  let c1 = pose.rotation(CHEST);
  var moved = false;
  s = 0;
  while s < 120 {
    w.update(&skel, &mut pose, &mut models, Vec3(0., 0., z), 0., 0., 0., true, &flatGround, dt);
    let c2 = pose.rotation(CHEST);
    if c1.dot(c2) < 0.99999 { moved = true; }
    s = s + 1;
  }
  expectBool(moved, true, "standing, the chest breathes");

  // A hard landing: the pelvis drops, then recovers
  let before = (*models[PELVIS]).translation.y;
  w.impact(8.);
  var low = before;
  s = 0;
  while s < 120 {
    w.update(&skel, &mut pose, &mut models, Vec3(0., 0., z), 0., 0., 0., true, &flatGround, dt);
    let py = (*models[PELVIS]).translation.y;
    if py < low { low = py; }
    s = s + 1;
  }
  expectBool(before - low > 0.2, true, "a landing at 8 m/s drops the pelvis more than 20 cm");
  near((*models[PELVIS]).translation.y, before, 0.03, "and it has recovered after 2 s");

  // A ground that is a closure holding what it needs: a slope of 0.1 m per metre
  // rising towards -z, 'rise' captured. Two walkers of the same height and seed
  // stand at z = -1 for a second, one on that slope and one on flat ground. Standing,
  // a heel is HEEL_BACK * h = 0.04 * 1.75 = 0.07 m behind the body (towards +z), at
  // z = -0.93, where the slope's height is 0.1 * 0.93 = 0.093 m; so the slope's
  // left ankle stands 0.093 m higher than the flat one's
  let rise = 0.1f;
  var ws = Walker.make(h, 3u32);
  var wf = Walker.make(h, 3u32);
  var ps = skel.restPose();
  var pf = skel.restPose();
  var ms = List[Transform3].empty();
  var mf = List[Transform3].empty();
  let here = Vec3(0., 0., -1.);
  s = 0;
  while s < 60 {
    ws.update(&skel, &mut ps, &mut ms, here, 0., 0., 0., true, (x, zz) => rise * (0. - zz), dt);
    wf.update(&skel, &mut pf, &mut mf, here, 0., 0., 0., true, &flatGround, dt);
    s = s + 1;
  }
  near((*ms[FOOT_L]).translation.y - (*mf[FOOT_L]).translation.y, 0.093, 0.005, "a closure ground: the left ankle stands 9.3 cm higher on the slope");
  near((*ms[FOOT_R]).translation.y - (*mf[FOOT_R]).translation.y, 0.093, 0.005, "and the right");

  // Setting off from standing, forward and backward, at a body's own ramp
  // (12 m/s^2 up to 1.8 m/s): the pelvis never plunges (the first stance
  // used to leave a foot 1 m behind the body, out of the leg's reach: the
  // pelvis fell by 56 cm forward and 68 cm backward), and no foot jumps
  var dirI = 0;
  while dirI < 2 {
    let dir = if dirI == 0 { 1.f } else { -1. };
    var wg = Walker.make(h, 7u32);
    var pg = skel.restPose();
    var mg = List[Transform3].empty();
    var sp = 0.f;
    var zg = 0.f;
    var n = 0;
    var lowestG = 10.f;
    var jump = 0.f;
    var lastAnkle = Vec3(0., 0., 0.);
    var lastStep = Vec3(0., 0., 0.);
    var steadyJump = 0.f;
    while n < 180 {
      sp = if sp < 1.8 { sp + 12. * dt } else { 1.8 };
      zg = zg - dir * sp * dt;
      let atG = Vec3(0., 0., zg);
      wg.update(&skel, &mut pg, &mut mg, atG, 0., dir * sp, 0., true, &flatGround, dt);
      let py = (*mg[PELVIS]).translation.y;
      let an = (*mg[FOOT_R]).translation + atG;
      if n > 1 {
        if py < lowestG { lowestG = py; }
        // the change in a foot's step from one frame to the next: a pop shows
        // here, and a steady swing's is small
        let stepV = an - lastAnkle;
        let dAcc = (stepV - lastStep).length();
        if n > 3 && n < 120 && dAcc > jump { jump = dAcc; }
        if n >= 120 && dAcc > steadyJump { steadyJump = dAcc; }
        lastStep = stepV;
      }
      lastAnkle = an;
      n = n + 1;
    }
    let drop = wg.standingPelvis() - lowestG;
    expectBool(drop < 0.14, true, "setting off the pelvis never drops more than 14 cm (forward or backward)");
    // The first swing covers its ground in half the time, so it is sharper than a steady one, but not a jump
    expectBool(jump < 3. * steadyJump, true, "and no foot pops: its change of step in the first steps is within 3 times a steady walk's");
    dirI = dirI + 1;
  }
  // A walker made late, or set down far away while walking (the caller sets 'started' false), is not drawn stretched: its feet
  // begin where a standing walker's are, so the pelvis, which hangs from the ankles, stays within a hand of standing height and every
  // bone within the walker's height of the model's origin. (Its feet used to start from the world's origin, so the first swing of the
  // foot that began one dragged the pelvis down towards the origin, 4 m or more when the ground there was far above or below.)
  {
    let sk = humanoid(1.75);
    var ps = sk.restPose();
    var ms = List[Transform3].empty();
    var wt = Walker.make(1.75, 1u32);
    // It walks a while at the origin, then is set down 300 m away on ground 40 m higher, and walks on from there
    var sn = 0;
    var sz = 0.f;
    while sn < 200 {
      sz = sz - 1.4 / 60.;
      wt.update(&sk, &mut ps, &mut ms, Vec3(0., 0., sz), 0., 1.4, 0., true, (x, z) => 0., 1. / 60.);
      sn = sn + 1;
    }
    wt.started = false;
    var sLowest = 100.f;
    var sFarthest = 0.f;
    sn = 0;
    while sn < 240 {
      sz = sz - 1.4 / 60.;
      let sat = Vec3(300., 40., 300. + sz);
      wt.update(&sk, &mut ps, &mut ms, sat, 0., 1.4, 0., true, (x, z) => 40., 1. / 60.);
      let spy = (*ms[PELVIS]).translation.y;
      if spy < sLowest { sLowest = spy; }
      var sb = 0usize;
      while sb < ms.len() {
        let sd = (*ms[sb]).translation.length();
        if sd > sFarthest { sFarthest = sd; }
        sb = sb + 1usize;
      }
      sn = sn + 1;
    }
    expectBool(wt.standingPelvis() - sLowest < 0.14, true, "set down far away, walking, the pelvis never drops more than 14 cm");
    expectBool(sFarthest < 1.75, true, "and no bone is farther than the walker's height from its origin");
  }
  done()
}
