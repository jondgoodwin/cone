// ======== Deflating: RFC 1951, with RFC 1950 and RFC 1952 around it ========
//
// A 'Deflater' is a value that holds a stream's whole state. Bytes go in with
// 'feed' in pieces of any size, 'finish' says the input is over, and 'pull'
// answers the compressed bytes a bounded piece at a time. The compressed
// bytes are the same however the input was split: only the data decides them,
// not the pieces it came in (the matcher waits for 262 bytes of look-ahead
// before it decides a position, unless the input is finished).
//
// Levels (the same for every format):
//   0  stored blocks of at most 65535 bytes (no compression)
//   1  LZ77 with a hash chain of three-byte strings (at most 16 candidates a
//      position), coded with the fixed Huffman code of RFC 1951 3.2.6, in one
//      block
//   2  the same matcher with at most 48 candidates, coded with a dynamic
//      Huffman code per block of 32768 tokens (RFC 1951 3.2.7), the code
//      lengths built by the two-lightest merge of Huffman 1952 and limited
//      to 15 bits (7 for the code-length code) by flattening the frequencies
//      until they fit
// Other level numbers act as 2.
//
// The matcher is the classic greedy one (zlib's deflate_fast without the
// level tuning): at each position the longest match within a chain of
// candidates, taken if it is 3 bytes or longer, every position a match covers
// entered in the hash chain. The window is the full 32 KiB. It is neither as
// fast as zlib nor as small, but a stream any inflater reads.
//
// What a streaming deflater does not do, and the one-shot helpers do: a
// stream whose compressed form is bigger than the data is not turned into
// stored blocks, because the end is not known when a block is written. The
// helpers 'rawDeflate', 'zlibCompress' and 'gzipCompress' store the whole
// input instead when that would be smaller, as imagedecode's writer always
// has.

// A bit writer: bits go in least-significant first
struct BitWriter {
  pub out List[u8];
  pub acc u64;
  pub n u32;

  pub fn put(self &mut, value u32, bits u32) {
    acc = acc | (u64.from(value) << u64.from(n));
    n = n + bits;
    while n >= 8u32 {
      out.push(u8.from(acc & 255u64));
      acc = acc >> 8u64;
      n = n - 8u32;
    }
  }

  // A Huffman code goes in most-significant bit first
  pub fn putCode(self &mut, code u32, bits u32) {
    var rev = 0u32;
    var i = 0u32;
    while i < bits {
      rev = (rev << 1u32) | ((code >> i) & 1u32);
      i += 1u32;
    }
    self.put(rev, bits);
  }

  // Pad to a byte boundary
  pub fn align(self &mut) {
    if n > 0u32 { self.put(0u32, 8u32 - n); }
  }
}

// A Huffman code for the encoder: bit length and canonical code of each symbol
struct Code {
  pub lens List[u8];
  pub codes List[u32];
}

// Code lengths for symbols with frequencies 'freq' (first 'n'), no longer
// than 'maxBits'. A symbol with frequency 0 gets length 0. Fewer than two
// used symbols: the used one (or symbol 0) gets length 1, which every inflater
// accepts.
fn huffmanLengths(freq &Array[u32], n usize, maxBits u8) List[u8] {
  var f = List[u32].withCapacity(n);
  var i = 0usize;
  while i < n { f.push(freq[i]); i += 1usize; }
  while true {
    let lens = huffmanOnce(f.view(), n);
    var maxLen = 0u8;
    i = 0usize;
    while i < n { if *lens[i] > maxLen { maxLen = *lens[i]; } i += 1usize; }
    if maxLen <= maxBits { return lens; }
    // Too deep: flatten the frequencies (halve, keeping used symbols used)
    i = 0usize;
    while i < n {
      if *f[i] > 0u32 { f.set(i, (*f[i] + 1u32) / 2u32); }
      i += 1usize;
    }
  }
  List[u8].empty();
}

// Huffman's merge by repeatedly joining the two lightest trees
fn huffmanOnce(freq &Array[u32], n usize) List[u8] {
  var lens = List[u8].withCapacity(n);
  var i = 0usize;
  while i < n { lens.push(0u8); i += 1usize; }
  // Nodes: leaves 0..n-1, then internal ones; weight, parent, alive
  var weight = List[u64].empty();
  var parent = List[i32].empty();
  var alive = List[bool].empty();
  var used = 0usize;
  i = 0usize;
  while i < n {
    weight.push(u64.from(freq[i]));
    parent.push(-1i32);
    alive.push(freq[i] > 0u32);
    if freq[i] > 0u32 { used += 1usize; }
    i += 1usize;
  }
  if used == 0usize { lens.set(0usize, 1u8); return lens; }
  if used == 1usize {
    i = 0usize;
    while i < n { if freq[i] > 0u32 { lens.set(i, 1u8); } i += 1usize; }
    return lens;
  }
  var left = used;
  while left > 1usize {
    // The two lightest alive nodes (ties to the lowest index: deterministic)
    var a = -1i32;
    var b = -1i32;
    var j = 0usize;
    while j < weight.len() {
      if *alive[j] {
        if a < 0i32 or *weight[j] < *weight[usize.from(a)] {
          b = a;
          a = i32.from(j);
        } elif b < 0i32 or *weight[j] < *weight[usize.from(b)] {
          b = i32.from(j);
        }
      }
      j += 1usize;
    }
    let id = i32.from(weight.len());
    weight.push(*weight[usize.from(a)] + *weight[usize.from(b)]);
    parent.push(-1i32);
    alive.push(true);
    alive.set(usize.from(a), false);
    alive.set(usize.from(b), false);
    parent.set(usize.from(a), id);
    parent.set(usize.from(b), id);
    left -= 1usize;
  }
  // A leaf's length is its depth
  i = 0usize;
  while i < n {
    if freq[i] > 0u32 {
      var d = 0u8;
      var p = *parent[i];
      while p >= 0i32 { d += 1u8; p = *parent[usize.from(p)]; }
      lens.set(i, d);
    }
    i += 1usize;
  }
  lens;
}

// The canonical codes of RFC 1951 3.2.2 for the lengths
fn canonicalCodes(lens &Array[u8], n usize) List[u32] {
  var count = List[u32].empty();
  var i = 0usize;
  while i < 17usize { count.push(0u32); i += 1usize; }
  i = 0usize;
  while i < n { if lens[i] > 0u8 { count.set(usize.from(lens[i]), *count[usize.from(lens[i])] + 1u32); } i += 1usize; }
  var next = List[u32].empty();
  i = 0usize;
  while i < 17usize { next.push(0u32); i += 1usize; }
  var code = 0u32;
  i = 1usize;
  while i < 16usize {
    code = (code + *count[i - 1usize]) << 1u32;
    next.set(i, code);
    i += 1usize;
  }
  var codes = List[u32].empty();
  i = 0usize;
  while i < n {
    let l = usize.from(lens[i]);
    if l > 0usize {
      codes.push(*next[l]);
      next.set(l, *next[l] + 1u32);
    } else {
      codes.push(0u32);
    }
    i += 1usize;
  }
  codes;
}

fn makeCode(lens List[u8]) Code {
  let codes = canonicalCodes(lens.view(), lens.len());
  new Code(lens, codes);
}

// The length code (257 to 285) and the extra bits a match length takes
fn lengthSymbol(len usize) usize {
  var s = 28usize;
  while usize.from(lenBase[s]) > len { s -= 1usize; }
  s;
}

fn distSymbol(d usize) usize {
  var s = 29usize;
  while usize.from(distBase[s]) > d { s -= 1usize; }
  s;
}

fn hash3(d &Array[u8], i usize) usize {
  usize.from(((u32.from(d[i]) << 10u32) ^ (u32.from(d[i + 1usize]) << 5u32) ^ u32.from(d[i + 2usize])) & 32767u32);
}

// Write tokens [from, to) with the codes
fn writeTokenCodes(w &mut BitWriter, tokens &Array[u32], from usize, to usize, lit &Code, dist &Code) {
  var i = from;
  while i < to {
    let t = tokens[i];
    if (t & 0x80000000u32) == 0u32 {
      w.putCode(*lit.codes[usize.from(t)], u32.from(*lit.lens[usize.from(t)]));
    } else {
      let len = usize.from((t >> 16u32) & 0x7FFFu32);
      let d = usize.from(t & 0xFFFFu32);
      let ls = lengthSymbol(len);
      w.putCode(*lit.codes[257usize + ls], u32.from(*lit.lens[257usize + ls]));
      w.put(u32.from(len - usize.from(lenBase[ls])), u32.from(lenExtra[ls]));
      let ds = distSymbol(d);
      w.putCode(*dist.codes[ds], u32.from(*dist.lens[ds]));
      w.put(u32.from(d - usize.from(distBase[ds])), u32.from(distExtra[ds]));
    }
    i += 1usize;
  }
}

// Write tokens [from, to) with the codes and the end-of-block code
fn writeTokens(w &mut BitWriter, tokens &Array[u32], from usize, to usize, lit &Code, dist &Code) {
  writeTokenCodes(w, tokens, from, to, lit, dist);
  w.putCode(*lit.codes[256usize], u32.from(*lit.lens[256usize]));
}

fn fixedCodes(lit &mut Code, dist &mut Code) {
  var l = List[u8].empty();
  var i = 0usize;
  while i < 288usize {
    l.push(if i < 144usize {8u8;} elif i < 256usize {9u8;} elif i < 280usize {7u8;} else {8u8;});
    i += 1usize;
  }
  *lit = makeCode(l);
  var d = List[u8].empty();
  i = 0usize;
  while i < 30usize { d.push(5u8); i += 1usize; }
  *dist = makeCode(d);
}

// A dynamic block of tokens [from, to)
fn writeDynamicBlock(w &mut BitWriter, tokens &Array[u32], from usize, to usize, last bool) {
  var lf = List[u32].empty();
  var i = 0usize;
  while i < 286usize { lf.push(0u32); i += 1usize; }
  var df = List[u32].empty();
  i = 0usize;
  while i < 30usize { df.push(0u32); i += 1usize; }
  lf.set(256usize, 1u32);
  i = from;
  while i < to {
    let t = tokens[i];
    if (t & 0x80000000u32) == 0u32 {
      lf.set(usize.from(t), *lf[usize.from(t)] + 1u32);
    } else {
      let ls = 257usize + lengthSymbol(usize.from((t >> 16u32) & 0x7FFFu32));
      lf.set(ls, *lf[ls] + 1u32);
      let ds = distSymbol(usize.from(t & 0xFFFFu32));
      df.set(ds, *df[ds] + 1u32);
    }
    i += 1usize;
  }
  let lit = makeCode(huffmanLengths(lf.view(), 286usize, 15u8));
  let dist = makeCode(huffmanLengths(df.view(), 30usize, 15u8));
  // Trim trailing unused lengths (at least 257 literal/length, 1 distance)
  var nlen = 286usize;
  while nlen > 257usize and *lit.lens[nlen - 1usize] == 0u8 { nlen -= 1usize; }
  var ndist = 30usize;
  while ndist > 1usize and *dist.lens[ndist - 1usize] == 0u8 { ndist -= 1usize; }
  // The lengths as a run-length coded sequence of code-length symbols
  var seq = List[u8].empty();       // symbol
  var extra = List[u8].empty();     // its extra-bits value
  var all = List[u8].empty();
  i = 0usize;
  while i < nlen { all.push(*lit.lens[i]); i += 1usize; }
  i = 0usize;
  while i < ndist { all.push(*dist.lens[i]); i += 1usize; }
  i = 0usize;
  while i < all.len() {
    let v = *all[i];
    var run = 1usize;
    while i + run < all.len() and *all[i + run] == v { run += 1usize; }
    if v == 0u8 and run >= 3usize {
      let r = if run > 138usize {138usize;} else {run;};
      if r >= 11usize { seq.push(18u8); extra.push(u8.from(r - 11usize)); }
      else { seq.push(17u8); extra.push(u8.from(r - 3usize)); }
      i += r;
    } elif v != 0u8 and run >= 4usize {
      // The length itself once, then repeats of 3 to 6
      seq.push(v);
      extra.push(0u8);
      var rest = run - 1usize;
      i += 1usize;
      while rest >= 3usize {
        let r = if rest > 6usize {6usize;} else {rest;};
        seq.push(16u8);
        extra.push(u8.from(r - 3usize));
        rest -= r;
        i += r;
      }
      while rest > 0usize { seq.push(v); extra.push(0u8); rest -= 1usize; i += 1usize; }
    } else {
      seq.push(v);
      extra.push(0u8);
      i += 1usize;
    }
  }
  var cf = List[u32].empty();
  i = 0usize;
  while i < 19usize { cf.push(0u32); i += 1usize; }
  i = 0usize;
  while i < seq.len() { cf.set(usize.from(*seq[i]), *cf[usize.from(*seq[i])] + 1u32); i += 1usize; }
  let cl = makeCode(huffmanLengths(cf.view(), 19usize, 7u8));
  var ncode = 19usize;
  while ncode > 4usize and *cl.lens[usize.from(clOrder[ncode - 1usize])] == 0u8 { ncode -= 1usize; }

  w.put(if last {1u32;} else {0u32;}, 1u32);
  w.put(2u32, 2u32);
  w.put(u32.from(nlen - 257usize), 5u32);
  w.put(u32.from(ndist - 1usize), 5u32);
  w.put(u32.from(ncode - 4usize), 4u32);
  i = 0usize;
  while i < ncode { w.put(u32.from(*cl.lens[usize.from(clOrder[i])]), 3u32); i += 1usize; }
  i = 0usize;
  while i < seq.len() {
    let s = usize.from(*seq[i]);
    w.putCode(*cl.codes[s], u32.from(*cl.lens[s]));
    if s == 16usize { w.put(u32.from(*extra[i]), 2u32); }
    elif s == 17usize { w.put(u32.from(*extra[i]), 3u32); }
    elif s == 18usize { w.put(u32.from(*extra[i]), 7u32); }
    i += 1usize;
  }
  writeTokens(w, tokens, from, to, &lit, &dist);
}

