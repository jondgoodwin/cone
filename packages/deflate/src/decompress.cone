// ======== Inflating a whole stream at once ========
//
// The one-shot helpers: a stream in memory, its bytes out. Each is an
// Inflater run to the end of its input with the whole output kept.

// Inflates the stream in 'inf' to its end. 'expected' is the output size if
// known (it reserves room and bounds the output), else 0, which bounds the
// output by 1 GiB. Answers the failure, or None; the output stays in 'inf' for 'takeOutput'.
fn inflateRun(inf: &mut Inflater, data: &Array[u8], start: usize, expected: usize) Option[DeflateError] {
  inf.limit = if expected > 0usize {u64.from(expected)} else {1073741824u64};
  // Room for the expected size, but never more than 64 MiB up front: a header can claim anything
  inf.hist.reserve(if expected > 0usize {if expected < 67108864usize {expected} else {67108864usize}} else {65536usize});
  inf.bi.buf.reserve(data.len - start);
  var i = start;
  while i < data.len { inf.bi.buf.push(data[i]); i = i + 1usize; }
  inf.finished = true;
  let s = inf.runAll();
  if s == Status.Failed {
    return Some[DeflateError](inf.err.copy());
  }
  None[DeflateError]
}

// The same, the output answered; the Inflater is given up.
fn inflateAll(inf: Inflater, data: &Array[u8], start: usize, expected: usize) Result[List[u8], DeflateError] {
  var run = inf;
  match inflateRun(&mut run, data, start, expected) {
    case let Some(e) { Error[List[u8], DeflateError](e.copy()) }
    case is None[DeflateError] { Ok[List[u8], DeflateError](run.takeOutput()) }
  }
}

// Decompress raw DEFLATE data (RFC 1951) starting at 'start'. 'expected' is
// the output size if known (it reserves room and bounds the output), else 0,
// which bounds the output by 1 GiB. Answers the bytes and, in 'used', how many
// input bytes the stream took.
pub fn inflate(data: &Array[u8], start: usize, expected: usize, used: &mut usize) Result[List[u8], DeflateError] {
  var inf = Inflater.make(Format.Raw);
  match inflateRun(&mut inf, data, start, expected) {
    case let Some(e) {
      return Error[List[u8], DeflateError](e.copy());
    }
    case is None[DeflateError] {
      *used = usize.from(inf.totalIn());
      return Ok[List[u8], DeflateError](inf.takeOutput());
    }
  }
}

// Decompress a zlib stream (RFC 1950): a two-byte header, DEFLATE data and
// the Adler-32 of the output. 'expected' as for 'inflate'. A preset
// dictionary is refused. The checksum is verified. Bytes after the Adler-32
// are not looked at.
pub fn zlibDecompress(data: &Array[u8], expected: usize) Result[List[u8], DeflateError] {
  if data.len < 6usize {
    return Error[List[u8], DeflateError](DeflateError.make(ErrorKind.Truncated, 0u64, "zlib: the stream is too short"));
  }
  inflateAll(Inflater.make(Format.Zlib), data, 0usize, expected)
}

// Decompress a gzip file (RFC 1952): every member, one after another, their
// outputs joined as 'gzip -d' joins them; zero bytes between or after
// members are ignored. 'expected' as for 'inflate' (the total of all members).
// Each member's CRC-32 and size are verified.
pub fn gzipDecompress(data: &Array[u8], expected: usize) Result[List[u8], DeflateError] {
  inflateAll(Inflater.make(Format.Gzip), data, 0usize, expected)
}
