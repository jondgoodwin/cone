// ======== The checksums: Adler-32 and CRC-32 ========

// Adler-32 (RFC 1950): two sums modulo 65521, the second of the first. The
// value of 'data' alone; 'Adler32' below continues across pieces.
pub fn adler32(data: &Array[u8]) u32 {
  var a = Adler32.start();
  a.update(data, 0usize, data.len);
  a.value()
}

// An Adler-32 in progress: feed it pieces, ask 'value' at any point. The
// value of no data is 1.
pub struct Adler32 {
  pub a: u32;
  pub b: u32;

  pub fn start() Adler32 { Adler32(1u32, 0u32) }

  // Takes in data[from, to)
  pub fn update(self: &mut, data: &Array[u8], from: usize, to: usize) {
    var x = a;
    var y = b;
    var i = from;
    while i < to {
      // 5552 bytes cannot overflow 32 bits before the modulo
      let stop = if i + 5552usize < to {i + 5552usize} else {to};
      while i < stop {
        x = x + u32.from(data[i]);
        y = y + x;
        i = i + 1usize;
      }
      x = x % 65521u32;
      y = y % 65521u32;
    }
    a = x;
    b = y;
  }

  pub fn value(self: &) u32 { (b << 16u32) | a }
}

// The CRC-32 of data alone (the check value of "123456789" is CBF43926). It
// makes the table each time: for many calls keep a 'Crc32'.
pub fn crc32(data: &Array[u8]) u32 {
  let t = Crc32.make();
  t.update(0u32, data, 0usize, data.len)
}

// CRC-32 (PNG's, zlib's and gzip's; polynomial 0xEDB88320 reflected), by
// tables made once: 'make' holds the byte-at-a-time table and fifteen more for
// taking sixteen bytes a step (the "slicing-by-16" form, from Kounavis and
// Berry's slicing-by-4, Intel, 2005; zlib-ng and zlib-rs use the same).
pub struct Crc32 {
  pub table: List[u32];

  pub fn make() Crc32 {
    var t = List[u32].withCapacity(4096usize);
    var n = 0u32;
    while n < 256u32 {
      var c = n;
      var k = 0u32;
      while k < 8u32 {
        c = if (c & 1u32) != 0u32 {0xEDB88320u32 ^ (c >> 1u32)} else {c >> 1u32};
        k = k + 1u32;
      }
      t.push(c);
      n = n + 1u32;
    }
    // table s, entry n: the CRC of the byte n followed by s zero bytes
    var s = 1usize;
    while s < 16usize {
      n = 0u32;
      while n < 256u32 {
        let prev = *t[(s - 1usize) * 256usize + usize.from(n)];
        t.push(*t[usize.from(prev & 0xFFu32)] ^ (prev >> 8u32));
        n = n + 1u32;
      }
      s = s + 1usize;
    }
    Crc32(t)
  }

  // The CRC of data[from, to), continuing from 'crc' (0 to start)
  pub fn update(self: &, crc: u32, data: &Array[u8], from: usize, to: usize) u32 {
    var c = crc ^ 0xFFFFFFFFu32;
    var i = from;
    // Raw access, with its arguments:
    // - 'tp' is the table's data pointer. A 'Crc32' from 'make' holds 4096 entries; the loop runs only when
    //   'table.len()' is 4096, and every index below is 256 * table number + a byte (at most 15 * 256 + 255
    //   = 4095), so each table load is inside the table. (An empty Crc32, which inflate keeps for non-gzip
    //   formats, skips the loop and meets the checked loads below.)
    // - 'dp' is the data's data pointer. The loop runs only while i + 16 <= to, and 'to' is at most data.len
    //   (checked before the loop), so the 8-byte loads at dp + i and dp + i + 8 end by i + 16 <= data.len.
    // - The 8-byte loads are little-endian words, as on every target Cone builds for.
    if to <= data.len && self.table.len() == 4096usize {
      let tp = self.table.view() as *u32;
      let dp = data as *u8;
      while i + 16usize <= to {
        let w0 = mem.readRaw[u64]((dp + i) as *u64);
        let w1 = mem.readRaw[u64]((dp + (i + 8usize)) as *u64);
        let a = u32.from(w0 & 0xFFFFFFFFu64) ^ c;
        let b = u32.from(w0 >> 32u64);
        let d = u32.from(w1 & 0xFFFFFFFFu64);
        let e = u32.from(w1 >> 32u64);
        c = mem.readRaw[u32](tp + (3840usize + usize.from(a & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (3584usize + usize.from((a >> 8u32) & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (3328usize + usize.from((a >> 16u32) & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (3072usize + usize.from(a >> 24u32)))
          ^ mem.readRaw[u32](tp + (2816usize + usize.from(b & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (2560usize + usize.from((b >> 8u32) & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (2304usize + usize.from((b >> 16u32) & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (2048usize + usize.from(b >> 24u32)))
          ^ mem.readRaw[u32](tp + (1792usize + usize.from(d & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (1536usize + usize.from((d >> 8u32) & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (1280usize + usize.from((d >> 16u32) & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (1024usize + usize.from(d >> 24u32)))
          ^ mem.readRaw[u32](tp + (768usize + usize.from(e & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (512usize + usize.from((e >> 8u32) & 0xFFu32)))
          ^ mem.readRaw[u32](tp + (256usize + usize.from((e >> 16u32) & 0xFFu32)))
          ^ mem.readRaw[u32](tp + usize.from(e >> 24u32));
        i = i + 16usize;
      }
    }
    while i + 4usize <= to {
      c = c ^ (u32.from(data[i]) | (u32.from(data[i + 1usize]) << 8u32)
        | (u32.from(data[i + 2usize]) << 16u32) | (u32.from(data[i + 3usize]) << 24u32));
      c = *table[768usize + usize.from(c & 0xFFu32)] ^ *table[512usize + usize.from((c >> 8u32) & 0xFFu32)]
        ^ *table[256usize + usize.from((c >> 16u32) & 0xFFu32)] ^ *table[usize.from(c >> 24u32)];
      i = i + 4usize;
    }
    while i < to {
      c = *table[usize.from((c ^ u32.from(data[i])) & 0xFFu32)] ^ (c >> 8u32);
      i = i + 1usize;
    }
    c ^ 0xFFFFFFFFu32
  }
}
