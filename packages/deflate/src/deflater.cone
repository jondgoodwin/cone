// ======== The streaming deflater ========

// The most tokens a level-2 block holds, and how many a level-1 deflater
// gathers before it writes them
fn blockTokens() usize { 32768usize }
fn fixedFlushTokens() usize { 8192usize }

// How many bytes of look-ahead the matcher wants before it decides a
// position while more input may come: the longest match (258), and three for
// the hash of the last position it enters
fn lookAhead() i64 { 262i64 }

// The level a deflater runs at: 0 stores, 1 to 9 are themselves (1 the
// fastest, 9 the smallest), a negative number is zlib's default, 6, and
// anything above 9 is 9
fn levelOf(level: i32) i32 {
  if level < 0 { return 6; }
  if level > 9 { return 9; }
  level
}

// Candidate positions the matcher looks at for one position, by level: the
// probe counts miniz_oxide gives its levels 1 to 9 (1, 6, 32, 16, 32, 128,
// 256, 512, 768).
fn chainLimitOf(level: i32) usize {
  if level <= 1 { return 1usize; }
  if level == 2 { return 6usize; }
  if level == 3 { return 32usize; }
  if level == 4 { return 16usize; }
  if level == 5 { return 32usize; }
  if level == 6 { return 128usize; }
  if level == 7 { return 256usize; }
  if level == 8 { return 512usize; }
  768usize
}

// The matcher: from position '*cur' (absolute, the byte at 'base' is buf[0]),
// turn bytes into tokens (a literal byte, or 0x80000000 | length << 16 |
// distance) until the data runs out (answers false; with 'final' false it
// stops while less than 'lookAhead()' bytes remain) or 'tokens' holds
// 'maxTokens' and another position is waiting (answers true). With 'insertAll'
// false a match enters only its first position in the hash chain, as miniz's
// level 1 does; true enters every position it covers. 'head' and
// 'prev' are the hash chains: 'head' by hash the newest position, 'prev' by
// position (modulo 32768) the one before it with the same hash.
fn lzScan(buf: &Array[u8], base: i64, cur: &mut i64, head: &mut List[i64], prev: &mut List[i64], tokens: &mut List[u32],
  chainLimit: usize, insertAll: bool, maxTokens: usize, final: bool) bool {
  let n = buf.len;
  let endPos = base + i64.from(n);
  while *cur < endPos {
    if !final && endPos - *cur < lookAhead() { return false; }
    if tokens.len() >= maxTokens { return true; }
    let i = *cur;
    let ib = usize.from(i - base);
    var bestLen = 0usize;
    var bestDist = 0usize;
    if ib + 3usize <= n {
      let h = hash3(buf, ib);
      var cand = *head[h];
      var chain = 0usize;
      while cand >= 0i64 && chain < chainLimit {
        if i - cand > 32768i64 { break; }
        let ci = usize.from(cand - base);
        // Match length at this candidate
        var l = 0usize;
        while l < 258usize && ib + l < n && buf[ci + l] == buf[ib + l] { l += 1usize; }
        if l > bestLen {
          bestLen = l;
          bestDist = usize.from(i - cand);
          if l == 258usize { break; }
        }
        cand = *prev[usize.from(cand & 32767i64)];
        chain += 1usize;
      }
    }
    if bestLen >= 3usize {
      tokens.push(0x80000000u32 | (u32.from(bestLen) << 16u32) | u32.from(bestDist));
      // Insert the positions the match covers: all of them, or just its first
      let covered = if insertAll {bestLen} else {1usize};
      var k = 0usize;
      while k < covered {
        if ib + k + 3usize <= n {
          let h = hash3(buf, ib + k);
          let p = i + i64.from(k);
          prev.set(usize.from(p & 32767i64), *head[h]);
          head.set(h, p);
        }
        k += 1usize;
      }
      *cur = i + i64.from(bestLen);
    } else {
      tokens.push(u32.from(buf[ib]));
      if ib + 3usize <= n {
        let h = hash3(buf, ib);
        prev.set(usize.from(i & 32767i64), *head[h]);
        head.set(h, i);
      }
      *cur = i + 1i64;
    }
  }
  false
}

// The lazy matcher of levels 4 to 9, after miniz_oxide's compress_normal. Where
// 'lzScan' takes the match it finds, this one holds a match of under 128 bytes
// back for one position: if the next position has a longer match, the byte
// here goes out as a literal and the longer match is held in its turn;
// otherwise the held match goes out. A match of 128 or more is taken at once.
// A match of 3 bytes farther than 8192 is dropped (miniz's far_and_small).
// Looking for the longer match at the next position, a held match of 32 or
// more shrinks the candidates to a quarter (at least 1), as miniz's second
// probe count does. Every position a match covers enters the hash chain.
// '*savedLen' and '*savedDist' are the held match (0 for none), found at
// position cur - 1; they live in the Deflater between calls, so a call may stop
// for want of look-ahead with a match held. Otherwise as 'lzScan'.
fn lzScanLazy(buf: &Array[u8], base: i64, cur: &mut i64, head: &mut List[i64], prev: &mut List[i64], tokens: &mut List[u32],
  chainLimit: usize, savedLen: &mut usize, savedDist: &mut usize, maxTokens: usize, final: bool) bool {
  let n = buf.len;
  let endPos = base + i64.from(n);
  while *cur < endPos {
    if !final && endPos - *cur < lookAhead() { return false; }
    if tokens.len() >= maxTokens { return true; }
    let i = *cur;
    let ib = usize.from(i - base);
    let held = *savedLen > 0usize;
    var bestLen = *savedLen;
    var bestDist = 0usize;
    if ib + 3usize <= n {
      let h = hash3(buf, ib);
      var limit = chainLimit;
      if bestLen >= 32usize {
        limit = chainLimit >> 2usize;
        if limit == 0usize { limit = 1usize; }
      }
      var cand = *head[h];
      var chain = 0usize;
      while cand >= 0i64 && chain < limit {
        if i - cand > 32768i64 { break; }
        let ci = usize.from(cand - base);
        // Only a candidate that agrees at bestLen can beat bestLen (and none can when the data ends first)
        if ib + bestLen < n && buf[ci + bestLen] == buf[ib + bestLen] {
          var l = 0usize;
          while l < 258usize && ib + l < n && buf[ci + l] == buf[ib + l] { l += 1usize; }
          if l > bestLen {
            bestLen = l;
            bestDist = usize.from(i - cand);
            if l == 258usize { break; }
          }
        }
        cand = *prev[usize.from(cand & 32767i64)];
        chain += 1usize;
      }
      prev.set(usize.from(i & 32767i64), *head[h]);
      head.set(h, i);
    }
    // The match found here, if it is a usable one (and, when one is held, longer)
    var newLen = if bestDist > 0usize && bestLen >= 3usize {bestLen} else {0usize};
    if newLen == 3usize && bestDist >= 8192usize { newLen = 0usize; }
    if held && newLen <= *savedLen {
      // The held match (found at i - 1) goes out; i is already in the chain
      tokens.push(0x80000000u32 | (u32.from(*savedLen) << 16u32) | u32.from(*savedDist));
      let end = i - 1i64 + i64.from(*savedLen);
      var p = i + 1i64;
      while p < end {
        let pb = usize.from(p - base);
        if pb + 3usize <= n {
          let h = hash3(buf, pb);
          prev.set(usize.from(p & 32767i64), *head[h]);
          head.set(h, p);
        }
        p += 1i64;
      }
      *cur = end;
      *savedLen = 0usize;
      *savedDist = 0usize;
    } else {
      // A literal for the held match's byte (i - 1), or for this one when
      // nothing is held and nothing found
      if held { tokens.push(u32.from(buf[ib - 1usize])); }
      if newLen == 0usize {
        tokens.push(u32.from(buf[ib]));
        *cur = i + 1i64;
      } else if newLen >= 128usize {
        tokens.push(0x80000000u32 | (u32.from(newLen) << 16u32) | u32.from(bestDist));
        let end = i + i64.from(newLen);
        var p = i + 1i64;
        while p < end {
          let pb = usize.from(p - base);
          if pb + 3usize <= n {
            let h = hash3(buf, pb);
            prev.set(usize.from(p & 32767i64), *head[h]);
            head.set(h, p);
          }
          p += 1i64;
        }
        *cur = end;
        *savedLen = 0usize;
        *savedDist = 0usize;
      } else {
        *savedLen = newLen;
        *savedDist = bestDist;
        *cur = i + 1i64;
      }
    }
  }
  false
}

// The gzip header of RFC 1952 section 2.3 for 'h': flags for the text mark,
// the extra field, the name and the comment (a name or comment is cut at a
// zero byte, which cannot be written); no header CRC-16
fn writeGzipHeader(out: &mut List[u8], h: &GzipHeader) {
  out.push(0x1Fu8);
  out.push(0x8Bu8);
  out.push(8u8);
  var nameLen = 0usize;
  while nameLen < h.name.len() && *h.name[nameLen] != 0u8 { nameLen += 1usize; }
  var commentLen = 0usize;
  while commentLen < h.comment.len() && *h.comment[commentLen] != 0u8 { commentLen += 1usize; }
  var extraLen = h.extra.len();
  if extraLen > 65535usize { extraLen = 65535usize; }
  var flg = 0u8;
  if h.text { flg = flg | 1u8; }
  if extraLen > 0usize { flg = flg | 4u8; }
  if nameLen > 0usize { flg = flg | 8u8; }
  if commentLen > 0usize { flg = flg | 16u8; }
  out.push(flg);
  out.push(u8.from(h.mtime & 255u32));
  out.push(u8.from((h.mtime >> 8u32) & 255u32));
  out.push(u8.from((h.mtime >> 16u32) & 255u32));
  out.push(u8.from(h.mtime >> 24u32));
  out.push(h.xfl);
  out.push(h.os);
  if extraLen > 0usize {
    out.push(u8.from(extraLen & 255usize));
    out.push(u8.from(extraLen >> 8usize));
    var k = 0usize;
    while k < extraLen { out.push(*h.extra[k]); k += 1usize; }
  }
  if nameLen > 0usize {
    var k = 0usize;
    while k < nameLen { out.push(*h.name[k]); k += 1usize; }
    out.push(0u8);
  }
  if commentLen > 0usize {
    var k = 0usize;
    while k < commentLen { out.push(*h.comment[k]); k += 1usize; }
    out.push(0u8);
  }
}

// RFC 1950 section 2.2: CMF 78 (deflate, 32 KiB window), FLG with the
// check bits; FLEVEL as zlib sets it: 0 for stored and level 1, 1 for levels 2
// to 5, 2 for level 6 (the default), 3 for levels 7 to 9
fn writeZlibHeader(out: &mut List[u8], level: i32) {
  let lv = levelOf(level);
  out.push(0x78u8);
  out.push(if lv <= 1 {0x01u8} else if lv <= 5 {0x5Eu8} else if lv == 6 {0x9Cu8} else {0xDAu8});
}

// The Adler-32, most significant byte first
fn writeZlibTrailer(out: &mut List[u8], adler: u32) {
  out.push(u8.from(adler >> 24u32));
  out.push(u8.from((adler >> 16u32) & 255u32));
  out.push(u8.from((adler >> 8u32) & 255u32));
  out.push(u8.from(adler & 255u32));
}

// The CRC-32 and the size modulo 2^32, least significant byte first
fn writeGzipTrailer(out: &mut List[u8], crc: u32, size: u64) {
  out.push(u8.from(crc & 255u32));
  out.push(u8.from((crc >> 8u32) & 255u32));
  out.push(u8.from((crc >> 16u32) & 255u32));
  out.push(u8.from(crc >> 24u32));
  let s = u32.from(size & 0xFFFFFFFFu64);
  out.push(u8.from(s & 255u32));
  out.push(u8.from((s >> 8u32) & 255u32));
  out.push(u8.from((s >> 16u32) & 255u32));
  out.push(u8.from(s >> 24u32));
}

// The XFL byte a compressor writes, as zlib does: 4 for the fastest levels, 2
// for the slowest (9), else 0
fn xflOf(level: i32) u8 {
  if level == 0 || level == 1 { return 4u8; }
  if level == 9 { return 2u8; }
  0u8
}

// Everything about a stream being deflated. Make one with 'make', 'feed' it,
// 'finish' it when the input is over, 'pull' the output.
//
//   mut def = deflate.Deflater.make(deflate.Format.Gzip, 2);
//   mut out = IoBuf(65536usize);
//   def.feed(chunk);                         // any size, split anywhere
//   while true {
//     out.clear();
//     imm s = def.pull(&mut out);            // at most the buffer's room at a time
//     ... write out.view() ...
//     if s != deflate.Status.MoreOutput { break; }
//   }
//   // NeedInput: feed the next chunk, or def.finish() and pull until Done
pub struct Deflater {
  format: Format;
  level: i32;
  // The input window: buf holds the bytes from absolute position 'base' on;
  // 'cur' is the next position to deal with
  buf: List[u8];
  base: i64;
  cur: i64;
  head: List[i64];
  prev: List[i64];
  tokens: List[u32];
  // Levels 4 to 9: the lazy matcher's held match, found at position cur - 1
  // (length 0 for none) and not yet written
  savedLen: usize;
  savedDist: usize;
  // The output so far: bw.out holds it, the first 'outPos' bytes delivered
  bw: BitWriter;
  outPos: usize;
  started: bool;
  // Level 1: the single fixed block's header is written
  fixedOpen: bool;
  finishing: bool;
  done: bool;
  fixLit: Code;
  fixDist: Code;
  haveFixed: bool;
  // The input's checksums and size, for the trailer
  adler: Adler32;
  crc: Crc32;
  crcv: u32;
  inTotal: u64;
  gz: GzipHeader;
  outTotal: u64;

  // A deflater for 'format' at 'level' (0 stored; 1 fixed Huffman and the
  // fewest candidates; 2 to 9 dynamic Huffman and more candidates the higher;
  // a negative level is the default, 6, and above 9 is 9). A gzip stream gets
  // a plain header (no time, no name, system 255) unless 'setGzipHeader' is
  // called before the first 'feed'.
  pub fn make(format: Format, level: i32) Deflater {
    let lv = levelOf(level);
    var head = List[i64]();
    var prev = List[i64]();
    if lv > 0 {
      head.reserve(32768usize);
      prev.reserve(32768usize);
      var i = 0usize;
      while i < 32768usize { head.push(-1i64); prev.push(-1i64); i += 1usize; }
    }
    let table = if format == Format.Gzip {Crc32.make()} else {Crc32(List[u32]())};
    var gz = GzipHeader.plain();
    gz.xfl = xflOf(lv);
    Deflater(format, lv, List[u8](), 0i64, 0i64, head, prev, List[u32](), 0usize, 0usize,
      BitWriter(List[u8](), 0u64, 0u32), 0usize, false, false, false, false,
      Code(List[u8](), List[u32]()), Code(List[u8](), List[u32]()), false,
      Adler32.start(), table, 0u32, 0u64, gz, 0u64)
  }

  // The gzip header to write (ignored for the other formats); call it
  // before the first 'feed' or 'pull'
  pub fn setGzipHeader(self: &mut, h: &GzipHeader) {
    if !started { gz = h.clone(); }
  }

  // Appends input. It is copied, so the caller's bytes are its own again at
  // once. Feed in pieces of any size; pull until NeedInput before feeding the
  // next, or the input piles up. Bytes fed after 'finish' are ignored.
  pub fn feed(self: &mut, chunk: &Array[u8]) {
    if finishing { return; }
    if format == Format.Zlib { adler.update(chunk, 0usize, chunk.len); }
    else if format == Format.Gzip { crcv = crc.update(crcv, chunk, 0usize, chunk.len); }
    inTotal = inTotal + u64.from(chunk.len);
    buf.appendSlice(chunk);
  }

  // Says that no more input will come; the stream is then completed by
  // pulling until Done
  pub fn finish(self: &mut) { finishing = true; }

  // The Transform's 'failure': a compressor never fails, so always None
  pub fn failure(self: &) Option[AnyError] { None[AnyError] }

  // Bytes of input fed so far
  pub fn totalIn(self: &) u64 { inTotal }

  // Bytes of output delivered so far
  pub fn totalOut(self: &) u64 { outTotal }

  // Whether the stream is complete and every byte of it delivered
  pub fn isDone(self: &) bool { done && outPos >= bw.out.len() }

  // Appends compressed bytes into the buffer's spare room (the Transform of
  // package streams), at most 'out.room()' of them, and answers what it waits
  // for: NeedInput (all input used; feed more or 'finish'), MoreOutput (more
  // is ready; pull again) or Done. The output of a block comes whole when the
  // block is full, so the compressed bytes lag the input by up to 32768
  // tokens; the room bounds what one pull hands over, not what the deflater
  // holds.
  pub fn pullBuf overload pull(self: &mut, out: &mut IoBuf) Status {
    let room = out.room();
    let n = self.ready(room);
    out.append(&bw.out.view()[outPos ..< outPos + n]);
    self.delivered(n, room)
  }

  // -------- inside --------

  // Works until 'max' bytes of output are waiting or the data runs out: how
  // many are waiting to be handed over, at most 'max'
  fn ready(self: &mut, max: usize) usize {
    self.begin();
    while bw.out.len() - outPos < max && !done {
      if !self.step() { break; }
    }
    let avail = bw.out.len() - outPos;
    if avail < max {avail} else {max}
  }

  // The first n waiting bytes were handed over, of the 'max' there was room
  // for: what the pull answers. With the room used up to the last byte it
  // cannot tell whether the matcher has more to write, since it works only as
  // far as the room asks, so it says MoreOutput and the next pull finds out
  fn delivered(self: &mut, n: usize, max: usize) Status {
    outPos = outPos + n;
    outTotal = outTotal + u64.from(n);
    self.trimOutput();
    if outPos < bw.out.len() { return Status.MoreOutput; }
    if done { return Status.Done; }
    if n == max && n > 0usize { return Status.MoreOutput; }
    Status.NeedInput
  }

  // The format's header, once
  fn begin(self: &mut) {
    if started { return; }
    started = true;
    if format == Format.Zlib { writeZlibHeader(&mut bw.out, level); }
    else if format == Format.Gzip { writeGzipHeader(&mut bw.out, &gz); }
  }

  // Free the delivered front of the output queue, when it is at least half
  fn trimOutput(self: &mut) {
    let total = bw.out.len();
    if outPos > 0usize && outPos >= total - outPos {
      var i = 0usize;
      while i < total - outPos { bw.out.set(i, *bw.out[outPos + i]); i += 1usize; }
      bw.out.truncate(total - outPos);
      outPos = 0usize;
    }
  }

  // One unit of work; false when it can do nothing without more input
  fn step(self: &mut) bool {
    self.slide();
    if level == 0 { return self.stepStored(); }
    let full = if level >= 4 {
      lzScanLazy(buf.view(), base, &mut cur, &mut head, &mut prev, &mut tokens, chainLimitOf(level), &mut savedLen, &mut savedDist,
        blockTokens(), finishing)
    } else {
      lzScan(buf.view(), base, &mut cur, &mut head, &mut prev, &mut tokens, chainLimitOf(level), level > 1,
        if level == 1 {fixedFlushTokens()} else {blockTokens()}, finishing)
    };
    if full {
      self.flushTokens();
      return true;
    }
    // The data is used up; finishing means the stream ends here
    if finishing {
      self.endStream();
      return true;
    }
    false
  }

  // Drop input that is no longer needed: the matcher reaches back 32768
  // bytes, the stored mode not at all
  fn slide(self: &mut) {
    let used = usize.from(cur - base);
    if used < 98304usize { return; }
    // Slide only when the used part is at least half of buf, so each slide's
    // copy of the unread input is paid for by the input it drops: the total
    // copied stays linear in the input, even when all of it was fed at once
    if used * 2usize < buf.len() { return; }
    let drop = if level == 0 {used} else {used - 32768usize};
    let keep = buf.len() - drop;
    var kept = List[u8].withCapacity(keep + 65536usize);
    kept.appendSlice(&buf.view()[drop ..< drop + keep]);
    buf = kept;
    base = base + i64.from(drop);
  }

  fn stepStored(self: &mut) bool {
    let pending = buf.len() - usize.from(cur - base);
    if pending > 65535usize {
      self.storedBlock(65535usize, false);
      return true;
    }
    if finishing {
      self.storedBlock(pending, true);
      self.finishTrailer();
      return true;
    }
    false
  }

  // A stored block of the next n bytes
  fn storedBlock(self: &mut, n: usize, last: bool) {
    bw.put(if last {1u32} else {0u32}, 1u32);
    bw.put(0u32, 2u32);
    bw.align();
    bw.put(u32.from(n), 16u32);
    bw.put(u32.from(n) ^ 0xFFFFu32, 16u32);
    let from = usize.from(cur - base);
    var k = 0usize;
    while k < n { bw.out.push(*buf[from + k]); k += 1usize; }
    cur = cur + i64.from(n);
  }

  fn ensureFixed(self: &mut) {
    if haveFixed { return; }
    fixedCodes(&mut fixLit, &mut fixDist);
    haveFixed = true;
  }

  // The tokens gathered are full: write them out (a level-2 block that is
  // not the last, or a level-1 run of the one fixed block)
  fn flushTokens(self: &mut) {
    if level == 1 {
      self.ensureFixed();
      if !fixedOpen {
        bw.put(1u32, 1u32);
        bw.put(1u32, 2u32);
        fixedOpen = true;
      }
      writeTokenCodes(&mut bw, tokens.view(), 0usize, tokens.len(), &fixLit, &fixDist);
    } else {
      writeDynamicBlock(&mut bw, tokens.view(), 0usize, tokens.len(), false);
    }
    tokens.clear();
  }

  // The last block, the padding, the trailer
  fn endStream(self: &mut) {
    if level == 1 {
      self.ensureFixed();
      if !fixedOpen {
        bw.put(1u32, 1u32);
        bw.put(1u32, 2u32);
        fixedOpen = true;
      }
      writeTokens(&mut bw, tokens.view(), 0usize, tokens.len(), &fixLit, &fixDist);
    } else {
      writeDynamicBlock(&mut bw, tokens.view(), 0usize, tokens.len(), true);
    }
    tokens.clear();
    self.finishTrailer();
  }

  fn finishTrailer(self: &mut) {
    bw.align();
    if format == Format.Zlib { writeZlibTrailer(&mut bw.out, adler.value()); }
    else if format == Format.Gzip { writeGzipTrailer(&mut bw.out, crcv, inTotal); }
    done = true;
  }
}
