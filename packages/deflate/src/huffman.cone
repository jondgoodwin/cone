// ======== Huffman tables for decoding ========
//
// The decoder is zlib's idea in a simpler dress: a table indexed by the
// next FastBits bits of input answers every code of that many bits or fewer
// with its symbol and length at once; a longer code falls to the canonical
// walk of RFC 1951 section 3.2.2 (Mark Adler's puff.c), one length at a
// time over the count of codes of each length. Deflate packs Huffman codes
// most-significant bit first into a stream read least-significant bit
// first, so the table is indexed by the code with its bits reversed.

// A canonical Huffman code ready to decode: 'fast' is indexed by the next
// FastBits bits (low bit first) and holds symbol * 16 + length for a code
// that short; for a longer code it holds k * 16 (length field 0), k >= 1, which
// names the (k - 1)th second-level table: it follows the first level at
// 2^FastBits + 1 + (k - 1) * 2^subBits, is indexed by the subBits bits after the first
// FastBits (subBits is the entry at 2^FastBits, maxLen - FastBits), and holds symbol * 16 + the code's whole length; 0 is no code; 'count' is the number of codes of each length 0 to 15
// and 'symbols' the symbols in order of code (by length, then value), for the
// longer codes' walk.
pub struct Huffman is Default {
  pub fast: List[u16];
  pub count: List[u16];
  pub symbols: List[u16];
  pub maxLen: u32;

  // A table from the code lengths of symbols 0 to n - 1 (0: unused). false
  // when the lengths are over-subscribed (more codes than bits allow).
  // An incomplete code is allowed only when it holds at most one code
  // (RFC 1951 permits a single distance code); a longer incomplete code is
  // refused, as zlib does.
  pub fn build(self: &mut, lengths: &Array[u8], n: usize) bool {
    fast.clear();
    count.clear();
    symbols.clear();
    var i = 0usize;
    while i < 16usize { count.push(0u16); i = i + 1usize; }
    i = 0usize;
    while i < (1usize << usize.from(FastBits)) { fast.push(0u16); i = i + 1usize; }
    i = 0usize;
    while i < n {
      count.set(usize.from(lengths[i]), *count[usize.from(lengths[i])] + 1u16);
      i = i + 1usize;
    }
    let total = n - usize.from(*count[0usize]);
    count.set(0usize, 0u16);
    // Over-subscribed or incomplete?
    var left = 1i32;
    var len = 1usize;
    maxLen = 0u32;
    while len < 16usize {
      left = left * 2i32 - i32.from(*count[len]);
      if left < 0i32 { return false; }
      if *count[len] > 0u16 { maxLen = u32.from(len); }
      len = len + 1usize;
    }
    if left > 0i32 && total > 1usize { return false; }
    // Where each length's first symbol goes in 'symbols'
    var offs = List[u16].withCapacity(16usize);
    offs.push(0u16);
    offs.push(0u16);
    len = 1usize;
    while len < 15usize {
      offs.push(*offs[len] + *count[len]);
      len = len + 1usize;
    }
    i = 0usize;
    while i < total { symbols.push(0u16); i = i + 1usize; }
    i = 0usize;
    while i < n {
      let l = usize.from(lengths[i]);
      if l != 0usize {
        symbols.set(usize.from(*offs[l]), u16.from(i));
        offs.set(l, *offs[l] + 1u16);
      }
      i = i + 1usize;
    }
    // The bits a second-level table is indexed by: maxLen - FastBits, or 0 when no code is longer than that.
    // It sits in the entry just after the first level, where the decoder reads it when it meets a pointer
    // (so the hot loop carries nothing for it); the second-level tables follow that entry.
    let subBits = if maxLen > FastBits { maxLen - FastBits } else { 0u32 };
    let rootSize = 1usize << usize.from(FastBits);
    let subSize = 1usize << usize.from(subBits);
    fast.push(u16.from(subBits));
    var subs = 0usize;     // second-level tables made so far
    // The tables: assign the canonical codes, reversed
    var code = 0u32;
    var k = 0usize;       // index in 'symbols'
    len = 1usize;
    while len <= usize.from(maxLen) {
      var c = 0u16;
      while c < *count[len] {
        let sym = *symbols[k];
        // The code's bits reversed into a 'len'-bit number
        var rev = 0u32;
        var b = 0usize;
        while b < len {
          rev = (rev << 1u32) | ((code >> u32.from(b)) & 1u32);
          b = b + 1usize;
        }
        if len <= usize.from(FastBits) {
          var e = usize.from(rev);
          while e < rootSize {
            fast.set(e, sym * 16u16 + u16.from(len));
            e = e + (1usize << len);
          }
        } else {
          // A longer code: its first FastBits bits (the low ones of 'rev') pick a second-level table, made
          // when first met. No short code shares that prefix (the code is prefix-free: over-subscription was
          // refused above), so the entry is 0 or a pointer. The rest of the bits index the table; every entry
          // filled lies below 'subSize', so inside this table, which lies inside 'fast'.
          let prefix = usize.from(rev) & (rootSize - 1usize);
          var ptr = *fast[prefix];
          if ptr == 0u16 {
            subs = subs + 1usize;
            ptr = u16.from(subs) * 16u16;
            fast.set(prefix, ptr);
            var z = 0usize;
            while z < subSize { fast.push(0u16); z = z + 1usize; }
          }
          let off = rootSize + 1usize + (usize.from(ptr >> 4u16) - 1usize) * subSize;
          var e = usize.from(rev) >> usize.from(FastBits);
          while e < subSize {
            fast.set(off + e, sym * 16u16 + u16.from(len));
            e = e + (1usize << (len - usize.from(FastBits)));
          }
        }
        code = code + 1u32;
        k = k + 1usize;
        c = c + 1u16;
      }
      code = code << 1u32;
      len = len + 1usize;
    }
    true
  }
}
