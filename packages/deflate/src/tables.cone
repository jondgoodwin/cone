// ======== The constants of RFC 1951 ========
//
// The static tables the inflater and the deflater share. They are
// immutable module-level arrays, carried over unchanged from imagedecode's
// inflate.cone (the same four arrays, moved, none added).

// How many bits the inflater's first-level Huffman table is indexed by. 10
// covers nearly every literal and length code of real data, in a 2 KiB table
// that stays in cache.
const FastBits = 10u32;

// Lengths 3 to 258: the base of each of the 29 codes (257 to 285) and how
// many extra bits follow it (RFC 1951 section 3.2.5)
let lenBase: Array[u16, 29] = [3u16, 4u16, 5u16, 6u16, 7u16, 8u16, 9u16, 10u16, 11u16, 13u16, 15u16, 17u16,
  19u16, 23u16, 27u16, 31u16, 35u16, 43u16, 51u16, 59u16, 67u16, 83u16, 99u16, 115u16, 131u16, 163u16,
  195u16, 227u16, 258u16];
let lenExtra: Array[u8, 29] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 2u8, 2u8, 2u8, 2u8,
  3u8, 3u8, 3u8, 3u8, 4u8, 4u8, 4u8, 4u8, 5u8, 5u8, 5u8, 5u8, 0u8];
// Distances 1 to 32768: 30 codes
let distBase: Array[u16, 30] = [1u16, 2u16, 3u16, 4u16, 5u16, 7u16, 9u16, 13u16, 17u16, 25u16, 33u16, 49u16,
  65u16, 97u16, 129u16, 193u16, 257u16, 385u16, 513u16, 769u16, 1025u16, 1537u16, 2049u16, 3073u16,
  4097u16, 6145u16, 8193u16, 12289u16, 16385u16, 24577u16];
let distExtra: Array[u8, 30] = [0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 2u8, 2u8, 3u8, 3u8, 4u8, 4u8, 5u8, 5u8, 6u8, 6u8,
  7u8, 7u8, 8u8, 8u8, 9u8, 9u8, 10u8, 10u8, 11u8, 11u8, 12u8, 12u8, 13u8, 13u8];
// The order the code-length code's lengths are sent in
let clOrder: Array[u8, 19] = [16u8, 17u8, 18u8, 0u8, 8u8, 7u8, 9u8, 6u8, 10u8, 5u8, 11u8, 4u8, 12u8, 3u8, 13u8,
  2u8, 14u8, 1u8, 15u8];
