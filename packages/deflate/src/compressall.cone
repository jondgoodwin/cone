// ======== Deflating a whole input at once ========
//
// The one-shot helpers: the data in memory, the stream out. Each runs a
// Deflater to the end of its input; and if the compressed form comes out
// bigger than storing the data would be, they store it instead (the
// streaming Deflater cannot, see compress.cone).

// Compress to a raw DEFLATE stream at 'level' (0 stored; 1 fixed Huffman and
// the fastest; 2 to 9 dynamic Huffman, slower and smaller the higher; negative
// is the default, 6, and above 9 is 9)
pub fn rawDeflate(data: &Array[u8], level: i32) List[u8] {
  var d = Deflater.make(Format.Raw, level);
  var chain = Chain.make(0xFFFFFFFFFFFFFFFFusize);
  var why = String();    // stays empty: the chain is unbounded
  _ = streams.runAll(&mut d, data, &mut chain, &mut why);
  // Data that does not compress is stored, as zlib does
  if level != 0 && chain.len() > data.len + 5usize * (data.len / 65535usize + 1usize) {
    return rawDeflate(data, 0);
  }
  // The List this function returns: the chain's bytes copied out once, here at the edge
  var out = List[u8]();
  out.resize(chain.len(), 0u8);
  _ = chain.copyOut(0usize, out.viewMut());
  out
}

// Compress to a zlib stream (header, DEFLATE, Adler-32), 32 KiB window,
// header 78 01 for stored and level 1, 78 5E for levels 2 to 5, 78 9C for
// level 6, 78 DA for levels 7 to 9
pub fn zlibCompress(data: &Array[u8], level: i32) List[u8] {
  var out = List[u8]();
  writeZlibHeader(&mut out, level);
  let body = rawDeflate(data, level);
  var i = 0usize;
  out.reserve(body.len() + 4usize);
  while i < body.len() { out.push(*body[i]); i += 1usize; }
  writeZlibTrailer(&mut out, adler32(data));
  out
}

// Compress to one gzip member (header, DEFLATE, CRC-32, size) with a plain
// header: no time, no name, system 255 (unknown)
pub fn gzipCompress(data: &Array[u8], level: i32) List[u8] {
  var h = GzipHeader.plain();
  h.xfl = xflOf(levelOf(level));
  gzipCompressWith(data, level, &h)
}

// Compress to one gzip member with the header 'h' (see GzipHeader)
pub fn gzipCompressWith(data: &Array[u8], level: i32, h: &GzipHeader) List[u8] {
  var out = List[u8]();
  writeGzipHeader(&mut out, h);
  let body = rawDeflate(data, level);
  var i = 0usize;
  out.reserve(body.len() + 8usize);
  while i < body.len() { out.push(*body[i]); i += 1usize; }
  writeGzipTrailer(&mut out, crc32(data), u64.from(data.len));
  out
}
