// The deflater against the inflater, over data of many shapes and sizes, at
// levels 0, 1, 2, 4, 6 and 9 and all three formats (levels.cone covers 1 to 9). Writer and
// reader could share a mistake, so the reader is checked against zlib's own
// streams in zoo.cone. The golden check values at the end are the CRC-32 of
// four of the streams, so any change to the bytes written is seen.
//
// Shapes: random bytes (no matches to find; the one-shot helpers store them),
// long runs (maximum-length matches at distance 1), a repeat 251 bytes long
// with noise, a six-letter alphabet (dynamic Huffman pays), and a repeat at
// the window's far edge (distance exactly 32768). Sizes around the places a
// codec's edges are: 0, 1, 2, 3, 257, 258, 259, 65535, 65536, 65537, 100000.
//
// The compressed bytes depend only on the data, not on how it was cut into
// pieces fed, nor on how the output was taken: every cutting must give the very
// same bytes as the whole input fed at once.

mod roundtrip;

import testing use *;
import collections use *;
import deflate use *;
import iobuf use IoBuf;

// Pulls into a list through a buffer of exactly 'max' bytes of room (IoBuf(n) may give a larger
// pool block, so setLen calls the front of it filled). A 'max' over 1 MiB pulls in 1 MiB pieces
// until the answer is not MoreOutput.
fn pullN[T](x: &mut T, out: &mut List[u8], max: usize) Status {
  let big = max > 1048576usize;
  let n = if big {1048576usize} else {max};
  var s = Status.MoreOutput;
  var more = true;
  while more {
    var buf = IoBuf(n);
    let pre = buf.capacity() - n;
    buf.setLen(pre);
    s = x.pull(&mut buf);
    out.appendSlice(&buf.view()[pre ..< buf.len()]);
    more = big && s == Status.MoreOutput;
  }
  s
}

fn data(kind: i32, n: usize) List[u8] {
  var d = List[u8].withCapacity(n);
  var s = 12345u64;
  var i = 0usize;
  while i < n {
    s = s * 6364136223846793005u64 + 1442695040888963407u64;
    if kind == 0 { d.push(u8.from((s >> 40u64) & 255u64)); }
    else if kind == 1 { d.push(u8.from((i / 100usize) & 255usize)); }
    else if kind == 2 { d.push(u8.from(((i * 7usize) % 251usize) + (if (s >> 60u64) == 0u64 {1usize} else {0usize}))); }
    else if kind == 3 { d.push(u8.from(97usize + usize.from((s >> 45u64) % 6u64))); }
    else { d.push(u8.from((i % 32768usize) * 31usize & 255usize)); }
    i += 1usize;
  }
  d
}

// Compress with a Deflater fed in pieces of 'chunk' bytes, the output taken
// 'maxPull' bytes at a time. false if it did not end Done.
fn compress(fmt: Format, level: i32, d: &Array[u8], chunk: usize, maxPull: usize, out: &mut List[u8]) bool {
  var def = Deflater.make(fmt, level);
  var pos = 0usize;
  var piece = List[u8]();
  var rounds = 0usize;
  while rounds < 100000000usize {
    rounds += 1usize;
    if pos < d.len {
      let n = if d.len - pos < chunk {d.len - pos} else {chunk};
      def.feed(&d[pos..<pos + n]);
      pos += n;
    }
    if pos >= d.len { def.finish(); }
    var st: Status = Status.MoreOutput;
    while st == Status.MoreOutput {
      piece.clear();
      st = pullN(&mut def, &mut piece, maxPull);
      if piece.len() > maxPull { return false; }
      var k = 0usize;
      while k < piece.len() { out.push(*piece[k]); k += 1usize; }
    }
    if st == Status.Done { return true; }
  }
  false
}

// Inflate with an Inflater fed 997 bytes at a time
fn decompress(fmt: Format, s: &Array[u8], out: &mut List[u8]) bool {
  var inf = Inflater.make(fmt);
  var pos = 0usize;
  var piece = List[u8]();
  var rounds = 0usize;
  while rounds < 100000000usize {
    rounds += 1usize;
    if pos < s.len {
      let n = if s.len - pos < 997usize {s.len - pos} else {997usize};
      inf.feed(&s[pos..<pos + n]);
      pos += n;
    }
    if pos >= s.len { inf.finish(); }
    var st: Status = Status.MoreOutput;
    while st == Status.MoreOutput {
      piece.clear();
      st = pullN(&mut inf, &mut piece, 4096usize);
      var k = 0usize;
      while k < piece.len() { out.push(*piece[k]); k += 1usize; }
    }
    if st == Status.Done { return true; }
    if st == Status.Failed { return false; }
  }
  false
}

fn formatName(f: Format) &str {
  if f == Format.Raw { return "raw"; }
  if f == Format.Zlib { return "zlib"; }
  "gzip"
}

fn main() i32 {
  let sizes: Array[usize, 11] = [0usize, 1usize, 2usize, 3usize, 257usize, 258usize, 259usize, 65535usize, 65536usize, 65537usize, 100000usize];
  // 0 stores, 1 is fixed Huffman, 2 is greedy, 4 6 9 match lazily (the cut-invariance of the held match)
  let levelList: Array[i32, 6] = [0, 1, 2, 4, 6, 9];
  var badRound = 0usize;
  var badChunk = 0usize;
  var badOneShot = 0usize;
  var badBound = 0usize;
  var runs = 0usize;
  var trace = String();
  var kind = 0;
  while kind < 5 {
    var si = 0usize;
    while si < 11usize {
      let n = sizes[si];
      let d = data(kind, n);
      var li = 0usize;
      while li < 6usize {
        let lv = levelList[li];
        var f = 0;
        while f < 3 {
          let fmt = if f == 0 {Format.Raw} else if f == 1 {Format.Zlib} else {Format.Gzip};
          // The reference cutting: all input at once, all output at once
          var reference = List[u8]();
          let refOk = compress(fmt, lv, d.view(), n + 1usize, 1000000usize, &mut reference);
          runs += 1usize;
          // It reads back to the data
          var back = List[u8]();
          if !refOk || !decompress(fmt, reference.view(), &mut back) || back.view() != d.view() {
            badRound += 1usize;
            trace.append(formatName(fmt)); trace.append(" kind"); trace.appendInt(i64.from(kind));
            trace.append(" n"); trace.appendInt(i64.from(n)); trace.append(" level"); trace.appendInt(i64.from(lv)); trace.append(" ");
          }
          // Every other cutting writes the very same bytes
          let cuts = if n <= 1000usize {5usize} else {3usize};
          var c = 0usize;
          while c < cuts {
            let chunk = if c == 0usize {4096usize} else if c == 1usize {333usize} else if c == 2usize {70001usize} else if c == 3usize {1usize} else {7usize};
            let pull = if c == 0usize {1usize + (n % 5usize)} else if c == 1usize {64usize} else if c == 2usize {65536usize} else if c == 3usize {1usize} else {100usize};
            if (pull == 1usize || chunk == 1usize) && n > 1000usize { c += 1usize; continue; }
            var other = List[u8]();
            if !compress(fmt, lv, d.view(), chunk, pull, &mut other) || other.view() != reference.view() {
              badChunk += 1usize;
              trace.append("cut "); trace.append(formatName(fmt)); trace.append(" kind"); trace.appendInt(i64.from(kind));
              trace.append(" n"); trace.appendInt(i64.from(n)); trace.append(" level"); trace.appendInt(i64.from(lv));
              trace.append(" chunk"); trace.appendInt(i64.from(chunk)); trace.append(" ");
            }
            c += 1usize;
          }
          // The one-shot helper: the same bytes unless it stored the input instead
          var shot = List[u8]();
          if fmt == Format.Raw { shot = rawDeflate(d.view(), lv); }
          else if fmt == Format.Zlib { shot = zlibCompress(d.view(), lv); }
          else { shot = gzipCompress(d.view(), lv); }
          if shot.view() != reference.view() {
            // allowed only when it chose stored blocks: not larger than the data plus 5 bytes a block and the framing
            let framing = if fmt == Format.Raw {0usize} else if fmt == Format.Zlib {6usize} else {18usize};
            if lv == 0 || shot.len() > n + 5usize * (n / 65535usize + 1usize) + framing || shot.len() > reference.len() { badOneShot += 1usize; }
          }
          // A stored stream is no more than 5 bytes a 64 KiB block over the data (plus framing)
          if lv == 0 {
            let framing = if fmt == Format.Raw {0usize} else if fmt == Format.Zlib {6usize} else {18usize};
            if reference.len() != n + 5usize * (if n == 0usize {1usize} else {(n + 65534usize) / 65535usize}) + framing { badBound += 1usize; }
          }
          f += 1;
        }
        li += 1usize;
      }
      si += 1usize;
    }
    kind += 1;
  }
  if trace.len() > 0usize { expectStr(trace.view(), "", "where it went wrong"); }
  expectInt(i64.from(badRound), 0i64, "streams that do not read back to their data");
  expectInt(i64.from(badChunk), 0i64, "cuttings that write other bytes than the whole input at once");
  expectInt(i64.from(badOneShot), 0i64, "one-shot helpers that differ from the stream (other than by storing)");
  expectInt(i64.from(badBound), 0i64, "stored streams of the wrong size");
  expectInt(i64.from(runs), 990i64, "combinations run");

  // The one-shot helpers' fallback: random data is stored, whatever the level
  let rnd = data(0, 70000usize);
  let r2 = zlibCompress(rnd.view(), 2);
  expectInt(i64.from(r2.len()), 70000i64 + 10i64 + 6i64, "random data is stored by the one-shot helper: 2 blocks, 5 bytes each, 6 for zlib");
  // while the streaming deflater codes it (a little bigger, never the stored size's double)
  var streamed = List[u8]();
  compress(Format.Zlib, 2, rnd.view(), 5000usize, 4096usize, &mut streamed);
  expect(streamed.len() > 70000usize && streamed.len() < 71500usize, "random data through the streaming deflater grows by under 2%");

  // Ratio sanity: dynamic Huffman beats the fixed code on six letters, and long runs are tiny
  let letters = data(3, 100000usize);
  expect(zlibCompress(letters.view(), 2).len() < zlibCompress(letters.view(), 1).len(), "dynamic Huffman beats fixed on six letters");
  expect(zlibCompress(letters.view(), 1).len() < 80000usize, "six letters take under 6.4 bits each at level 1 (one candidate, the fixed code)");
  let runs2 = data(1, 100000usize);
  expect(zlibCompress(runs2.view(), 2).len() < 3500usize, "long runs are tiny");
  let far = data(4, 70000usize);
  expect(zlibCompress(far.view(), 2).len() < 33500usize, "the repeat at distance 32768 is found");

  // Golden check values: CRC-32 of the streams below (each of which the
  // inflater above reads back to the data, in the combinations run earlier)
  let w = data(2, 20000usize);
  expectUInt(u64.from(crc32(zlibCompress(w.view(), 1).view())), 0xd98319a4u64, "golden: kind 2, 20000 bytes, zlib level 1");
  expectUInt(u64.from(crc32(zlibCompress(w.view(), 2).view())), 0xb2b51369u64, "golden: kind 2, 20000 bytes, zlib level 2");
  expectUInt(u64.from(crc32(gzipCompress(letters.view(), 2).view())), 0xab1d1e47u64, "golden: kind 3, 100000 bytes, gzip level 2");
  expectUInt(u64.from(crc32(rawDeflate(runs2.view(), 1).view())), 0xd77dc969u64, "golden: kind 1, 100000 bytes, raw level 1");
  // Levels 4 to 9 match lazily; each stream below was also decoded by Python's zlib to the data
  expectUInt(u64.from(crc32(zlibCompress(w.view(), 4).view())), 0x14cca460u64, "golden: kind 2, 20000 bytes, zlib level 4");
  expectUInt(u64.from(crc32(zlibCompress(w.view(), 6).view())), 0xf6b8202du64, "golden: kind 2, 20000 bytes, zlib level 6");
  expectUInt(u64.from(crc32(zlibCompress(w.view(), 9).view())), 0x431a3962u64, "golden: kind 2, 20000 bytes, zlib level 9");
  expectUInt(u64.from(crc32(gzipCompress(letters.view(), 4).view())), 0x1eff65dau64, "golden: kind 3, 100000 bytes, gzip level 4");
  expectUInt(u64.from(crc32(gzipCompress(letters.view(), 6).view())), 0x0991cdcdu64, "golden: kind 3, 100000 bytes, gzip level 6");
  expectUInt(u64.from(crc32(gzipCompress(letters.view(), 9).view())), 0xceffda5cu64, "golden: kind 3, 100000 bytes, gzip level 9");
  done()
}
