// Streams made by Python's zlib module (the reference implementation, used
// only to make tests/data/zoo.bin; "python make_zoo.py > zoo.bin" there
// regenerates it): 70 DEFLATE, zlib and gzip streams, each with what it
// inflates to (its length, its CRC-32 as Python worked it out, and the bytes
// themselves when there are 4096 or fewer). Every stream is inflated
//   - in one call;
//   - fed whole, then in pieces of 4096, 997 and 1 bytes (the last only
//     for the small ones), with the output taken in pieces of 65536, 1000
//     and 1 bytes;
// and every way must give exactly the bytes the reference says. (gzip.cone
// reads the members with header fields and the several-member file from the
// same data file and checks the fields and the member count.)

mod zoo;

import testing use *;
import collections use *;
import deflate use *;
import fs;
import path use Path;

fn le32(s &String, at usize) usize {
  usize.from(s[at]) + usize.from(s[at + 1usize]) * 256usize + usize.from(s[at + 2usize]) * 65536usize + usize.from(s[at + 3usize]) * 16777216usize;
}

fn formatOf(code u8) Format {
  if code == 0u8 { return Format.Raw; }
  if code == 1u8 { return Format.Zlib; }
  Format.Gzip;
}

// Inflates 's' in pieces of 'chunk' input bytes, taking 'maxPull' output
// bytes at a time. 0 when it ends Done, else which way it went wrong.
fn run(inf &mut Inflater, s &Array[u8], chunk usize, maxPull usize, out &mut List[u8]) i32 {
  mut pos = 0usize;
  mut piece = List[u8].empty();
  mut guard = 0usize;
  while true {
    guard += 1usize;
    if guard > 20000000usize { return 9; }
    if pos < s.len {
      imm n = if s.len - pos < chunk {s.len - pos;} else {chunk;};
      inf.feed(&s[pos..<pos + n]);
      pos += n;
      if pos == s.len { inf.finish(); }
    }
    mut st Status = Status.MoreOutput;
    while st == Status.MoreOutput {
      piece.clear();
      st = inf.pull(&mut piece, maxPull);
      mut k = 0usize;
      while k < piece.len() { out.push(*piece[k]); k += 1usize; }
      if piece.len() > maxPull { return 8; }
    }
    if st == Status.Done { return 0; }
    if st == Status.Failed { return 1; }
    // NeedInput with everything fed and finished: stuck
    if pos >= s.len { return 2; }
  }
  3;
}

fn main() i32 {
  imm path = Path.from("../../../../tests/data/zoo.bin");
  mut file = String.empty();
  match fs.readFile(&path) {
    case mut ok Ok { file <=> ok; }
    case imm e Error { expect(false, "the data file is there"); return done(); }
  }
  imm count = le32(&file, 0usize);
  expectInt(i64.from(count), 70i64, "streams in the file");
  mut at = 4usize;
  mut oneShotWrong = 0usize;
  mut streamWrong = 0usize;
  mut streamed = 0usize;
  mut r = 0usize;
  mut names = String.empty();
  while r < count {
    imm nameLen = usize.from(file[at]);
    imm name = file.sub(at + 1usize, at + 1usize + nameLen);
    at += 1usize + nameLen;
    imm fmt = formatOf(file[at]);
    imm streamLen = le32(&file, at + 1usize);
    at += 5usize;
    imm stream = &file.view().bytes()[at..<at + streamLen];
    at += streamLen;
    imm wantLen = le32(&file, at);
    imm wantCrc = u32.from(le32(&file, at + 4usize));
    at += 8usize;
    imm have = wantLen <= 4096usize;
    imm wantBytes = &file.view().bytes()[at..<at + (if have {wantLen;} else {0usize;})];
    if have { at += wantLen; }

    // One call
    mut one = List[u8].empty();
    mut oneOk = false;
    match fmt {
      case is Raw {
        mut used = 0usize;
        match inflate(stream, 0usize, 0usize, &mut used) {
          case mut ok Ok { one <=> ok; oneOk = used == streamLen; }
          case imm e Error { oneOk = false; }
        }
      }
      case is Zlib {
        match zlibDecompress(stream, 0usize) {
          case mut ok Ok { one <=> ok; oneOk = true; }
          case imm e Error { oneOk = false; }
        }
      }
      case is Gzip {
        match gzipDecompress(stream, 0usize) {
          case mut ok Ok { one <=> ok; oneOk = true; }
          case imm e Error { oneOk = false; }
        }
      }
    }
    if not oneOk or one.len() != wantLen or crc32(one.view()) != wantCrc or (have and one.view() != wantBytes) {
      oneShotWrong += 1usize;
      names.append(name.view());
      names.append(" ");
    }

    // The same stream through every chunking and every output piece size
    mut c = 0usize;
    while c < 4usize {
      imm chunk = if c == 0usize {stream.len + 1usize;} elif c == 1usize {4096usize;} elif c == 2usize {997usize;} else {1usize;};
      mut p = 0usize;
      while p < 3usize {
        imm pull = if p == 0usize {65536usize;} elif p == 1usize {1000usize;} else {1usize;};
        // The slowest combinations only for the small streams
        if (c == 3usize and stream.len > 700usize) or (p == 2usize and wantLen > 5000usize) {
          p += 1usize;
          continue;
        }
        mut inf = Inflater.make(fmt);
        mut out = List[u8].empty();
        imm code = run(&mut inf, stream, chunk, pull, &mut out);
        streamed += 1usize;
        if code != 0 or out.len() != wantLen or crc32(out.view()) != wantCrc or out.view() != one.view() {
          streamWrong += 1usize;
          names.append(name.view());
          names.append("/");
          names.appendInt(i64.from(chunk));
          names.append("/");
          names.appendInt(i64.from(pull));
          names.append(" ");
        }
        p += 1usize;
      }
      c += 1usize;
    }
    r += 1usize;
  }
  if names.len() > 0usize { expectStr(names.view(), "", "streams that went wrong"); }
  expectInt(i64.from(oneShotWrong), 0i64, "one-shot inflates that differ from the reference");
  expectInt(i64.from(streamWrong), 0i64, "streamed inflates that differ from the reference");
  expect(streamed > 500usize, "many streamed runs");
  done();
}
