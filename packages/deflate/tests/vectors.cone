mod vectors;

import testing use *;
import collections use *;
import deflate use *;

fn main() i32 {
  expectUInt(u64.from(adler32("Wikipedia")), 0x11E60398u64, "adler32 Wikipedia");
  expectUInt(u64.from(crc32("123456789")), 0xCBF43926u64, "crc32");
  imm z Array[u8, 16] = [120u8, 218u8, 203u8, 72u8, 205u8, 201u8, 201u8, 87u8, 200u8, 64u8, 144u8, 0u8, 58u8, 46u8, 6u8, 125u8];
  match zlibDecompress(&z, 0usize) {
    case imm ok Ok { expectStr(ok.view(), "hello hello hello", "hello"); }
    case imm e Error { expect(false, "hello"); }
  }
  done();
}
