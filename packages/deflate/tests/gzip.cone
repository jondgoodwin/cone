// gzip framing (RFC 1952): the header fields the reader keeps and the writer
// writes, several members in a row, zero padding, and 'takeRest'.
//
// Reading: tests/data/zoo.bin holds members made by hand in Python with every
// header field (see make_zoo.py): the time 1700000000, XFL 2, system 3, the
// name "test.txt", the comment "a comment", an extra field "AB" 3 "xyz", the
// header's CRC-16 and the text flag; and a file of four members in a row.
// Writing: the header's exact bytes are pinned here, and a stream written
// with every field reads back with every field.

mod gziptest;

import testing use *;
import collections use *;
import deflate use *;
import fs;
import path use Path;

fn le32(s &String, at usize) usize {
  usize.from(s[at]) + usize.from(s[at + 1usize]) * 256usize + usize.from(s[at + 2usize]) * 65536usize + usize.from(s[at + 3usize]) * 16777216usize;
}

// The bytes of the named stream in zoo.bin
fn zooStream(file &String, want &str) List[u8] {
  var at = 4usize;
  var r = 0usize;
  while r < le32(file, 0usize) {
    let nameLen = usize.from(file[at]);
    let name = file.sub(at + 1usize, at + 1usize + nameLen);
    at += 1usize + nameLen + 1usize;
    let streamLen = le32(file, at);
    at += 4usize;
    if name.view() == want {
      var out = List[u8].empty();
      var i = 0usize;
      while i < streamLen { out.push(file[at + i]); i += 1usize; }
      return out;
    }
    at += streamLen;
    let wantLen = le32(file, at);
    at += 8usize + (if wantLen <= 4096usize {wantLen;} else {0usize;});
    r += 1usize;
  }
  List[u8].empty();
}

fn text(b &Array[u8]) String { String.fromBytes(b); }

// Inflate a whole gzip stream with an Inflater, answering it (to ask its header)
fn readAll(s &Array[u8], out &mut List[u8]) Inflater {
  var inf = Inflater.make(Format.Gzip);
  inf.feed(s);
  inf.finish();
  var st Status = Status.MoreOutput;
  while st == Status.MoreOutput { st = inf.pull(out, 65536usize); }
  expect(st == Status.Done, "the gzip stream ends Done");
  inf;
}

fn same(a &Array[u8], b &Array[u8]) bool { a == b; }

fn let_append(out &mut List[u8], piece &List[u8]) {
  var k = 0usize;
  while k < piece.len() { out.push(*piece[k]); k += 1usize; }
}

fn main() i32 {
  var file = String.empty();
  match fs.readFile(&Path.from("../../../../tests/data/zoo.bin")) {
    case var ok Ok { file <=> ok; }
    case let e Error { expect(false, "the data file is there"); return done(); }
  }

  // ---------------- reading every header field ----------------
  var out = List[u8].empty();
  let all = zooStream(&file, "gzhdr-all");
  expect(all.len() > 0usize, "gzhdr-all is in the file");
  let inf1 = readAll(all.view(), &mut out);
  let h1 = inf1.gzipHeader();
  expectUInt(u64.from(h1.mtime), 1700000000u64, "all: time");
  expectUInt(u64.from(h1.xfl), 2u64, "all: XFL");
  expectUInt(u64.from(h1.os), 3u64, "all: system");
  expect(h1.text, "all: text flag");
  expectStr(text(h1.name.view()).view(), "test.txt", "all: name");
  expectStr(text(h1.comment.view()).view(), "a comment", "all: comment");
  expectInt(i64.from(h1.extra.len()), 7i64, "all: extra field length");
  let extraWant Array[u8, 7] = [65u8, 66u8, 3u8, 0u8, 120u8, 121u8, 122u8];
  expect(same(h1.extra.view(), &extraWant), "all: extra field bytes");
  expectInt(i64.from(out.len()), 3000i64, "all: 3000 bytes of data");
  expectInt(i64.from(inf1.memberCount()), 1i64, "all: one member");

  out = List[u8].empty();
  let nm = zooStream(&file, "gzhdr-name");
  let inf2 = readAll(nm.view(), &mut out);
  expectUInt(u64.from(inf2.gzipHeader().mtime), 1700000000u64, "name: time");
  expectStr(text(inf2.gzipHeader().name.view()).view(), "hello.txt", "name: name");
  expectInt(i64.from(inf2.gzipHeader().comment.len()), 0i64, "name: no comment");
  expect(not inf2.gzipHeader().text, "name: no text flag");

  out = List[u8].empty();
  let cm = zooStream(&file, "gzhdr-comment");
  let inf3 = readAll(cm.view(), &mut out);
  expectStr(text(inf3.gzipHeader().comment.view()).view(), "only a comment", "comment: comment");
  expectInt(i64.from(inf3.gzipHeader().name.len()), 0i64, "comment: no name");
  expectUInt(u64.from(inf3.gzipHeader().os), 255u64, "comment: system 255");

  out = List[u8].empty();
  let ex = zooStream(&file, "gzhdr-extra");
  let inf4 = readAll(ex.view(), &mut out);
  expectInt(i64.from(inf4.gzipHeader().extra.len()), 7i64, "extra: field length");

  out = List[u8].empty();
  let hc = zooStream(&file, "gzhdr-hcrc");
  let inf5 = readAll(hc.view(), &mut out);
  expectUInt(u64.from(inf5.gzipHeader().mtime), 5u64, "hcrc: time");
  expectUInt(u64.from(inf5.gzipHeader().xfl), 4u64, "hcrc: XFL");
  expectUInt(u64.from(inf5.gzipHeader().os), 0u64, "hcrc: system 0");
  expectStr(text(out.view()).view(), "hello hello hello", "hcrc: data");

  // ---------------- several members ----------------
  out = List[u8].empty();
  let multi = zooStream(&file, "multi");
  let infm = readAll(multi.view(), &mut out);
  expectInt(i64.from(infm.memberCount()), 4i64, "multi: four members");
  expectInt(i64.from(out.len()), 17i64 + 3000i64 + 4i64, "multi: their data joined");
  expectStr(text(&out.view()[0usize..<17usize]).view(), "hello hello hello", "multi: the first member's data");
  expectStr(text(&out.view()[3017usize..<3021usize]).view(), "tail", "multi: the last member's data");
  match gzipDecompress(multi.view(), 0usize) {
    case let ok Ok { expect(same(ok.view(), out.view()), "multi: the one-shot helper joins the members the same"); }
    case let e Error { expect(false, "multi: the one-shot helper joins the members the same"); }
  }
  // with zero padding between and after
  var padded = List[u8].empty();
  var i = 0usize;
  while i < multi.len() { padded.push(*multi[i]); i += 1usize; }
  padded.push(0u8); padded.push(0u8);
  match gzipDecompress(padded.view(), 0usize) {
    case let ok Ok { expect(same(ok.view(), out.view()), "multi: zero padding at the end is ignored"); }
    case let e Error { expect(false, "multi: zero padding at the end is ignored"); }
  }
  // the four members fed split in two at every offset (a split inside a header, a trailer, between members)
  {
    var badSplit = 0usize;
    var at = 0usize;
    while at <= multi.len() {
      var sp = Inflater.make(Format.Gzip);
      var got = List[u8].empty();
      var piece = List[u8].empty();
      var st Status = Status.NeedInput;
      if at > 0usize {
        sp.feed(&multi.view()[0usize..<at]);
        st = Status.MoreOutput;
        while st == Status.MoreOutput { piece.clear(); st = sp.pull(&mut piece, 700usize); let_append(&mut got, &piece); }
      }
      if at < multi.len() { sp.feed(&multi.view()[at..<multi.len()]); }
      sp.finish();
      st = Status.MoreOutput;
      while st == Status.MoreOutput { piece.clear(); st = sp.pull(&mut piece, 700usize); let_append(&mut got, &piece); }
      if st != Status.Done or not same(got.view(), out.view()) or sp.memberCount() != 4u32 { badSplit += 1usize; }
      at += 1usize;
    }
    expectInt(i64.from(badSplit), 0i64, "multi: split at every offset gives the same data and four members");
  }

  // one member at a time: Done after the first without 'finish', the rest taken
  {
    var one = Inflater.make(Format.Gzip);
    one.setMultiMember(false);
    one.feed(multi.view());
    var got = List[u8].empty();
    var st Status = Status.MoreOutput;
    while st == Status.MoreOutput { st = one.pull(&mut got, 100usize); }
    expect(st == Status.Done, "single-member: Done after the first member, no 'finish' needed");
    expectStr(text(got.view()).view(), "hello hello hello", "single-member: the first member's data");
    let rest = one.takeRest();
    // the other three members, read the same way one after another
    var again = Inflater.make(Format.Gzip);
    again.setMultiMember(false);
    again.feed(rest.view());
    var got2 = List[u8].empty();
    st = Status.MoreOutput;
    while st == Status.MoreOutput { st = again.pull(&mut got2, 100usize); }
    expect(st == Status.Done and got2.len() == 3000usize, "single-member: the second member is next in the rest");
    expect(rest.len() > 0usize and rest.len() < multi.len(), "single-member: what is left is the later members");
  }

  // ---------------- writing the header ----------------
  var hdr = GzipHeader.plain();
  hdr.mtime = 123456789u32;
  hdr.xfl = 0u8;
  hdr.os = 3u8;
  hdr.text = true;
  hdr.name = List[u8].empty();
  hdr.name.push('a'); hdr.name.push('.'); hdr.name.push('t'); hdr.name.push('x'); hdr.name.push('t');
  hdr.comment.push('c');
  hdr.extra.push(1u8); hdr.extra.push(2u8); hdr.extra.push(3u8);
  let hello = "hello hello hello";
  let written = gzipCompressWith(hello, 2, &hdr);
  // 1F 8B, deflate, flags text+extra+name+comment = 1+4+8+16, time 0x075BCD15 little-endian, XFL 0, system 3,
  // the extra field (length 3 little-endian, then its bytes), "a.txt" and 0, "c" and 0
  let want Array[u8, 30] = [0x1Fu8, 0x8Bu8, 8u8, 29u8, 0x15u8, 0xCDu8, 0x5Bu8, 0x07u8, 0u8, 3u8, 3u8, 0u8, 1u8, 2u8, 3u8,
    97u8, 46u8, 116u8, 120u8, 116u8, 0u8, 99u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
  expect(same(&written.view()[0usize..<23usize], &want[0usize..<23usize]), "the written header's bytes");
  out = List[u8].empty();
  let back = readAll(written.view(), &mut out);
  expectStr(text(out.view()).view(), "hello hello hello", "the written member reads back");
  expectUInt(u64.from(back.gzipHeader().mtime), 123456789u64, "written and read: time");
  expectUInt(u64.from(back.gzipHeader().os), 3u64, "written and read: system");
  expect(back.gzipHeader().text, "written and read: text flag");
  expectStr(text(back.gzipHeader().name.view()).view(), "a.txt", "written and read: name");
  expectStr(text(back.gzipHeader().comment.view()).view(), "c", "written and read: comment");
  expect(same(back.gzipHeader().extra.view(), &want[12usize..<15usize]) , "written and read: extra");
  // the trailer: CRC-32 of the data, then its length, both little-endian
  let wl = written.len();
  let crcv = crc32(hello);
  expect(*written[wl - 8usize] == u8.from(crcv & 255u32) and *written[wl - 5usize] == u8.from(crcv >> 24u32) and *written[wl - 4usize] == 17u8
    and *written[wl - 3usize] == 0u8, "the written trailer: CRC-32 and size");

  // a name with a zero byte is cut there; a plain header has no fields
  var cut = GzipHeader.plain();
  cut.name.push('a'); cut.name.push(0u8); cut.name.push('b');
  let w2 = gzipCompressWith(hello, 1, &cut);
  expect(*w2[3usize] == 8u8 and *w2[10usize] == 'a' and *w2[11usize] == 0u8, "a name is cut at a zero byte");
  let p0 = gzipCompress(hello, 0);
  let p1 = gzipCompress(hello, 1);
  let p2 = gzipCompress(hello, 2);
  expect(*p0[3usize] == 0u8 and *p0[8usize] == 4u8 and *p0[9usize] == 255u8, "plain header, level 0: XFL 4, system 255");
  expect(*p1[8usize] == 4u8 and *p2[8usize] == 0u8, "plain header: XFL 4 at level 1, 0 at level 2");
  expect(*p2[4usize] == 0u8 and *p2[5usize] == 0u8 and *p2[6usize] == 0u8 and *p2[7usize] == 0u8, "plain header: no time");

  // the streaming deflater writes the same header
  {
    var def = Deflater.make(Format.Gzip, 2);
    def.setGzipHeader(&hdr);
    def.feed(hello);
    def.finish();
    var o = List[u8].empty();
    def.pull(&mut o, 1000000usize);
    expect(same(o.view(), written.view()), "the streaming Deflater writes the same member as the helper");
  }

  // two compressed members and some zeros: one stream of both
  let a1 = gzipCompress("first ", 2);
  let a2 = gzipCompress("second", 1);
  var both = List[u8].empty();
  i = 0usize;
  while i < a1.len() { both.push(*a1[i]); i += 1usize; }
  i = 0usize;
  while i < a2.len() { both.push(*a2[i]); i += 1usize; }
  both.push(0u8);
  match gzipDecompress(both.view(), 0usize) {
    case let ok Ok { expectStr(text(ok.view()).view(), "first second", "two written members read as one"); }
    case let e Error { expect(false, "two written members read as one"); }
  }
  done();
}
