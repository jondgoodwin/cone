// Adler-32 and CRC-32: the published check values, the same value however the
// data is cut into pieces, the four-bytes-at-a-time CRC against the plain
// bit-by-bit definition at every alignment and length, and long data against
// values Python's zlib module gave (adler32 and crc32 of the generator's
// output, worked out once and written here).

mod checksums;

import testing use *;
import collections use *;
import deflate use *;

// CRC-32 by its definition, one bit at a time: no tables, nothing shared
// with the package's code
fn crcBitwise(data &Array[u8]) u32 {
  var c = 0xFFFFFFFFu32;
  var i = 0usize;
  while i < data.len {
    c = c ^ u32.from(data[i]);
    var k = 0u32;
    while k < 8u32 {
      c = if (c & 1u32) != 0u32 {0xEDB88320u32 ^ (c >> 1u32);} else {c >> 1u32;};
      k += 1u32;
    }
    i += 1usize;
  }
  c ^ 0xFFFFFFFFu32;
}

// Adler-32 by its definition: a running pair, a modulo at every byte
fn adlerPlain(data &Array[u8]) u32 {
  var a = 1u32;
  var b = 0u32;
  var i = 0usize;
  while i < data.len {
    a = (a + u32.from(data[i])) % 65521u32;
    b = (b + a) % 65521u32;
    i += 1usize;
  }
  (b << 16u32) | a;
}

fn gen(n usize, seed u64) List[u8] {
  var d = List[u8].empty();
  var s = seed;
  var i = 0usize;
  while i < n {
    s = s * 6364136223846793005u64 + 1442695040888963407u64;
    d.push(u8.from((s >> 40u64) & 255u64));
    i += 1usize;
  }
  d;
}

fn main() i32 {
  // Check values
  expectUInt(u64.from(crc32("123456789")), 0xCBF43926u64, "crc32 of 123456789");
  expectUInt(u64.from(adler32("123456789")), 0x091E01DEu64, "adler32 of 123456789");
  expectUInt(u64.from(crc32("")), 0u64, "crc32 of nothing");
  expectUInt(u64.from(adler32("")), 1u64, "adler32 of nothing");
  expectUInt(u64.from(adler32("Wikipedia")), 0x11E60398u64, "adler32 of Wikipedia");
  expectUInt(u64.from(crc32("a")), 0xE8B7BE43u64, "crc32 of a");
  expectUInt(u64.from(adler32("a")), 0x00620062u64, "adler32 of a");
  expectUInt(u64.from(crc32("The quick brown fox jumps over the lazy dog")), 0x414FA339u64, "crc32 of the fox");

  // In pieces: every split point of a 40-byte text
  let text = "The quick brown fox jumps over the lazy dog.";
  let crc = Crc32.make();
  var cut = 0usize;
  var allSame = true;
  while cut <= text.len {
    let part = crc.update(0u32, text, 0usize, cut);
    if crc.update(part, text, cut, text.len) != crc32(text) { allSame = false; }
    var ad = Adler32.start();
    ad.update(text, 0usize, cut);
    ad.update(text, cut, text.len);
    if ad.value() != adler32(text) { allSame = false; }
    cut += 1usize;
  }
  expect(allSame, "crc32 and adler32 are the same cut anywhere");

  // The four-at-a-time CRC against the definition, at every start and length
  let d = gen(300usize, 7u64);
  var agree = true;
  var from = 0usize;
  while from < 9usize {
    var n = 0usize;
    while n < 40usize {
      let piece = &d.view()[from..<from + n];
      if crc.update(0u32, d.view(), from, from + n) != crcBitwise(piece) { agree = false; }
      n += 1usize;
    }
    from += 1usize;
  }
  expect(agree, "crc32 equals the bitwise definition at every alignment and length");
  expectUInt(u64.from(crc.update(0u32, d.view(), 0usize, d.len())), u64.from(crcBitwise(d.view())), "crc32 of 300 bytes");

  // Adler-32 across the 5552-byte stretch the package sums between moduli
  let big = gen(70000usize, 11u64);
  expectUInt(u64.from(adler32(big.view())), u64.from(adlerPlain(big.view())), "adler32 of 70000 bytes");
  // A run of 0xFF bytes: the largest sums the stretch holds
  var ff = List[u8].empty();
  var i = 0usize;
  while i < 20000usize { ff.push(0xFFu8); i += 1usize; }
  expectUInt(u64.from(adler32(ff.view())), u64.from(adlerPlain(ff.view())), "adler32 of 20000 bytes of 255");
  expectUInt(u64.from(crc32(big.view())), u64.from(crcBitwise(big.view())), "crc32 of 70000 bytes");

  // Values from Python's zlib for the same generator (gen(70000, 11))
  expectUInt(u64.from(adler32(big.view())), 0x263f3dfau64, "adler32 of 70000 bytes, Python's");
  expectUInt(u64.from(crc32(big.view())), 0xbb2510cbu64, "crc32 of 70000 bytes, Python's");
  done();
}
