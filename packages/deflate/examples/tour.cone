// Compressing a text to gzip and back in one call, then inflating the same
// bytes the way a socket would hand them over: five at a time, the output
// taken eight bytes at a time.
//
//   congo run examples/tour.cone

mod tour;

import stdio use *;
import collections use *;
import deflate;
import iobuf use IoBuf;

// Pulls into a list through a buffer of exactly 'max' bytes of room (IoBuf(n) may give a larger
// pool block, so setLen calls the front of it filled)
fn pullN(x: &mut deflate.Inflater, out: &mut List[u8], max: usize) deflate.Status {
  var buf = IoBuf(max);
  let pre = buf.capacity() - max;
  buf.setLen(pre);
  let s = x.pull(&mut buf);
  out.appendSlice(&buf.view()[pre ..< buf.len()]);
  s
}

fn main() i32 {
  let text = "the quick brown fox jumps over the lazy dog, the quick brown fox jumps over the lazy dog";

  // One call each way. Level 2 is the dynamic Huffman code; 0 stores, 1 uses the fixed code.
  let packed = deflate.gzipCompress(text, 2);
  printInt(i64.from(text.len));
  printStr(" bytes became ");
  printInt(i64.from(packed.len()));
  printStr(" as a gzip file\n");
  match deflate.gzipDecompress(packed.view(), 0usize) {
    case let Ok(ok) { printStr(String.fromBytes(ok.view()).view()); printStr("\n"); }
    case let Err(e) { printStr(e.reason.view()); return 1i32; }
  }

  // The same stream fed in pieces: the state is the Inflater, which holds what
  // it needs between the calls
  var inf = deflate.Inflater.make(deflate.Format.Gzip);
  var out = List[u8]();
  var piece = List[u8]();
  var pulls = 0;
  var pos = 0usize;
  while pos < packed.len() {
    let n = if packed.len() - pos < 5usize {packed.len() - pos} else {5usize};
    inf.feed(&packed.view()[pos..<pos + n]);
    pos += n;
    if pos == packed.len() { inf.finish(); }
    var st: deflate.Status = deflate.Status.MoreOutput;
    while st == deflate.Status.MoreOutput {
      piece.clear();
      st = pullN(&mut inf, &mut piece, 8usize);
      pulls += 1;
      var k = 0usize;
      while k < piece.len() { out.push(*piece[k]); k += 1usize; }
    }
  }
  printStr(String.fromBytes(out.view()).view());
  printStr("\n");
  printInt(i64.from(pulls));
  printStr(" pulls\n");
  0i32
}
