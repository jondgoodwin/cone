// ======== Primitives: the distance from a point to a shape at the origin ========
//
// Each is a plain function of the point and the shape's sizes, negative
// inside. "Exact" means the true Euclidean distance, inside and out; a
// "bound" never exceeds it, so a sphere tracer stays safe, but is smaller
// away from the surface. The formulas are Inigo Quilez's catalogue
// (iquilezles.org/articles/distfunctions), written here from the
// mathematics. Round shapes about an axis have it along y.

// A sphere of 'radius'. Exact
pub fn sphere(p Vec3, radius f32) f32 { len3(p) - radius }

// A box reaching 'extent' either side of the origin on each axis. Exact
pub fn box(p Vec3, extent Vec3) f32 {
  let qx = absf(p.x) - extent.x;
  let qy = absf(p.y) - extent.y;
  let qz = absf(p.z) - extent.z;
  let outside = len3(new Vec3(maxf(qx, 0.), maxf(qy, 0.), maxf(qz, 0.)));
  outside + minf(maxf(qx, maxf(qy, qz)), 0.)
}

// A box of 'extent' whose edges and corners are rounded by 'radius' (its
// outside still reaches 'extent'). Exact
pub fn roundBox(p Vec3, extent Vec3, radius f32) f32 {
  box(p, new Vec3(extent.x - radius, extent.y - radius, extent.z - radius)) - radius
}

// A capsule: the points within 'radius' of the segment from a to b. Exact
pub fn capsule(p Vec3, a Vec3, b Vec3, radius f32) f32 {
  let pa = p - a;
  let ba = b - a;
  let bb = dot3(ba, ba);
  let h = if bb > 0. { clampf(dot3(pa, ba) / bb, 0., 1.) } else { 0. };
  len3(new Vec3(pa.x - ba.x * h, pa.y - ba.y * h, pa.z - ba.z * h)) - radius
}

// A torus about the y axis: a ring of radius 'major' in the plane y = 0,
// thickened by 'minor'. Exact
pub fn torus(p Vec3, major f32, minor f32) f32 {
  len2(len2(p.x, p.z) - major, p.y) - minor
}

// A cylinder about the y axis, 'radius' round, from y = -halfHeight to
// halfHeight, capped flat. Exact
pub fn cylinder(p Vec3, halfHeight f32, radius f32) f32 {
  let dx = len2(p.x, p.z) - radius;
  let dy = absf(p.y) - halfHeight;
  minf(maxf(dx, dy), 0.) + len2(maxf(dx, 0.), maxf(dy, 0.))
}

// A cone about the y axis, cut flat at both ends: radius 'bottom' at
// y = -halfHeight, 'top' at y = halfHeight (either may be 0). Exact
pub fn cone(p Vec3, halfHeight f32, bottom f32, top f32) f32 {
  // In the half-plane through the axis and p: (distance from the axis, height)
  let qx = len2(p.x, p.z);
  let qy = p.y;
  // To the nearer cap's disc
  let capR = if qy < 0. { bottom } else { top };
  let ax = qx - minf(qx, capR);
  let ay = absf(qy) - halfHeight;
  // To the slanted side, from (top, halfHeight) along (top - bottom, 2 halfHeight)
  let kx = top - bottom;
  let ky = 2. * halfHeight;
  let kk = kx * kx + ky * ky;
  let t = if kk > 0. { clampf(((top - qx) * kx + (halfHeight - qy) * ky) / kk, 0., 1.) } else { 0. };
  let sx = qx - top + kx * t;
  let sy = qy - halfHeight + ky * t;
  let inside = sx < 0. && ay < 0.;
  let d = sqrtf(minf(ax * ax + ay * ay, sx * sx + sy * sy));
  if inside { -d } else { d }
}

// A cone rounded at both ends: the hull of a sphere of radius 'bottom' at
// the origin and one of radius 'top' at (0, height, 0). Exact
pub fn roundCone(p Vec3, bottom f32, top f32, height f32) f32 {
  let b = (bottom - top) / height;
  let a = sqrtf(maxf(1. - b * b, 0.));
  let qx = len2(p.x, p.z);
  let qy = p.y;
  let k = qx * (0. - b) + qy * a;
  if k < 0. { return len2(qx, qy) - bottom; }
  if k > a * height { return len2(qx, qy - height) - top; }
  qx * a + qy * b - bottom
}

// A tapered capsule: the hull of a sphere of radius 'ra' at a and one of
// radius 'rb' at b, any two points (roundCone, placed and turned). A bone, a
// branch, a spike or a horn's segment; chained, a tube whose radius changes
// along a path. When one ball holds the other, it is that ball. Exact
pub fn taperedCapsule(p Vec3, a Vec3, b Vec3, ra f32, rb f32) f32 {
  let ba = b - a;
  let pa = p - a;
  let h = len3(ba);
  let dr = ra - rb;
  if h <= absf(dr) {
    return if ra > rb { len3(pa) - ra } else { len3(p - b) - rb };
  }
  let inv = 1. / h;
  let axis = new Vec3(ba.x * inv, ba.y * inv, ba.z * inv);
  // In the half-plane through the axis and p: (distance from the axis, along it)
  let y = dot3(pa, axis);
  let qx = len3(new Vec3(pa.x - axis.x * y, pa.y - axis.y * y, pa.z - axis.z * y));
  // The side's slope: the sine and cosine of its angle to the axis
  let sb = dr / h;
  let ca = sqrtf(maxf(1. - sb * sb, 0.));
  let k = qx * (0. - sb) + y * ca;
  if k < 0. { return len2(qx, y) - ra; }
  if k > ca * h { return len2(qx, y - h) - rb; }
  qx * ca + y * sb - ra
}

// The distance to the triangle a, b, c: a flat, two-sided sheet with no
// thickness, never negative. Less a thickness, a membrane, a sail, a leaf,
// a roof's plane; several, a polygon or a folded surface. A degenerate
// triangle is its edges. Exact
pub fn triangle(p Vec3, a Vec3, b Vec3, c Vec3) f32 {
  let ba = b - a;
  let cb = c - b;
  let ac = a - c;
  let pa = p - a;
  let pb = p - b;
  let pc = p - c;
  let n = cross3(ba, ac);
  let nn = dot3(n, n);
  // Over the triangle when p is on the inner side of all three edges
  if nn > 0. && dot3(cross3(ba, n), pa) >= 0. && dot3(cross3(cb, n), pb) >= 0. && dot3(cross3(ac, n), pc) >= 0. {
    return absf(dot3(n, pa)) / sqrtf(nn);
  }
  // Otherwise the nearest edge
  let ea = clampf(dot3(ba, pa) / maxf(dot3(ba, ba), 1e-30), 0., 1.);
  let eb = clampf(dot3(cb, pb) / maxf(dot3(cb, cb), 1e-30), 0., 1.);
  let ec = clampf(dot3(ac, pc) / maxf(dot3(ac, ac), 1e-30), 0., 1.);
  let qa = new Vec3(pa.x - ba.x * ea, pa.y - ba.y * ea, pa.z - ba.z * ea);
  let qb = new Vec3(pb.x - cb.x * eb, pb.y - cb.y * eb, pb.z - cb.z * eb);
  let qc = new Vec3(pc.x - ac.x * ec, pc.y - ac.y * ec, pc.z - ac.z * ec);
  sqrtf(minf(dot3(qa, qa), minf(dot3(qb, qb), dot3(qc, qc))))
}

// The distance to a membrane stretched between two spars, a0 to a1 and b0 to
// b1: the bilinear patch through the four points (a ruled sheet, flat when
// they lie in a plane, twisted when not; b0 = b1 makes it a triangle).
// 'scallop' cuts the b edge, when it is free skin between two bone tips,
// back toward the a spar by that fraction of the way at its middle, 4 u (1 -
// u) of it, where u runs along the spars. Panels that share a spar meet
// along it and nowhere else, so a fan of them is a frame's skin without the
// creases of a triangle fan: a wing, a sail, a fin, a leaf between veins.
// Two-sided, no thickness, never negative: less a half-thickness, a panel.
// The nearest point is found by sixteen steps of Gauss-Newton from the
// middle, over (u, w) with the fraction across v = w (1 - scallop 4 u (1 -
// u)), each step clamped to the unit square, and the straight edges on the
// sheet are taken too; so it is exact where the steps converge and otherwise
// the distance to some point on the sheet, never less than the true one. The
// tests measure its Lipschitz ratio on a twisted, scalloped panel
pub fn membrane(p Vec3, a0 Vec3, a1 Vec3, b0 Vec3, b1 Vec3, scallop f32) f32 {
  var u f32 = 0.5;
  var w f32 = 0.5;
  var i = 0;
  while i < 16 {
    let m = 1. - scallop * 4. * u * (1. - u);
    let v = w * m;
    let a = a0.lerp(a1, u);
    let b = b0.lerp(b1, u);
    let f = a.lerp(b, v) - p;
    let sv = b - a;
    let su = (a1 - a0) * (1. - v) + (b1 - b0) * v + sv * (w * scallop * -4. * (1. - 2. * u));
    let sw = sv * m;
    let g1 = dot3(su, f);
    let g2 = dot3(sw, f);
    let aa = dot3(su, su);
    let cc = dot3(sw, sw);
    let bb = dot3(su, sw);
    let eps = 0.000001 * (aa + cc) + 1e-20;
    let det = (aa + eps) * (cc + eps) - bb * bb;
    if det <= 0. { break; }
    u = clampf(u - ((cc + eps) * g1 - bb * g2) / det, 0., 1.);
    w = clampf(w - ((aa + eps) * g2 - bb * g1) / det, 0., 1.);
    i = i + 1;
  }
  let v = w * (1. - scallop * 4. * u * (1. - u));
  var d = len3(a0.lerp(a1, u).lerp(b0.lerp(b1, u), v) - p);
  d = minf(d, minf(capsule(p, a0, a1, 0.), minf(capsule(p, a0, b0, 0.), capsule(p, a1, b1, 0.))));
  if scallop <= 0. { d = minf(d, capsule(p, b0, b1, 0.)); }
  d
}

// The half-space below the plane through the points p with n.p + offset = 0,
// 'n' unit length (the solid side is where n.p + offset < 0). Exact
pub fn plane(p Vec3, n Vec3, offset f32) f32 { dot3(p, n) + offset }

// An ellipsoid of semi-axes 'radii'. Quilez's approximation: right on the
// surface and near it, but NOT a bound: the tests measured its gradient at
// up to 1.2 away from it (for semi-axes 1, 0.5, 0.75), so a sphere tracer
// should shorten its steps by that
pub fn ellipsoid(p Vec3, radii Vec3) f32 {
  let k0 = len3(new Vec3(p.x / radii.x, p.y / radii.y, p.z / radii.z));
  let k1 = len3(new Vec3(p.x / (radii.x * radii.x), p.y / (radii.y * radii.y), p.z / (radii.z * radii.z)));
  if k1 > 0. { k0 * (k0 - 1.) / k1 } else { 0. - minf(radii.x, minf(radii.y, radii.z)) }
}
