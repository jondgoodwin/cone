// ======== FnShape: a plain function of a point as a Shape ========
//
// CPU only: it holds a function reference, which GPU code may not make
// (sdfcore's Shape, gradient and normal are generic, and take any struct
// with a 'distance' method instead).

// A plain function of a point as a Shape
pub struct FnShape is Shape {
  pub f &fn(p Vec3) f32;

  pub fn distance(self &, p Vec3) f32 { f(p); }
}
