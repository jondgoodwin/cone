// ======== Meshing: surface nets, on the CPU ========
//
// A shape made into triangles for drawing: the field sampled on a grid of
// cubic cells, one vertex in each cell the surface crosses, and a quad
// across each grid edge whose ends lie on opposite sides of it, joining the
// four cells round that edge (Gibson's surface nets, 1998, as Lysenko's
// "naive surface nets" writes it up, 0fps.net, 2012). A cell's vertex is the
// average of the points where the surface crosses its edges (each found by
// linear interpolation of the two ends' distances), optionally moved onto
// the surface along the gradient, and its normal is the field's gradient
// there (central differences), not a face's.
//
// ONE VERTEX PER PIECE, SO THE MESH IS A MANIFOLD. Where the surface passes
// through a cell twice (two thin parts close together, or a gap narrower
// than a cell), naive surface nets gives the cell one vertex and the mesh a
// pinch: an edge four quads share, or a vertex two cones of quads meet at.
// Here a cell gets one vertex for each separate piece of surface crossing
// it, the pieces marching cubes would draw there (Nielson's dual marching
// cubes, 2004, by the same idea): on each face of the cell the surface's
// crossings are paired as the inside corners' runs round the face separate
// them (on a face with two inside corners diagonally opposite, each inside
// corner is cut off on its own), and the crossings a chain of such pairs
// joins are one piece. Neighbouring cells pair the crossings on the face
// they share the same way, so every quad edge is shared by exactly two
// quads, and a closed shape inside the grid gives a closed, manifold mesh.
// The one case left, two pieces of one face joined round both cells, needs
// a feature thinner than a cell on both sides of a face; PolyMesh's
// 'validate' reports it. A tube thinner than a cell (the horn's tip) keeps
// its topology but can fold a quad or two to face against the gradient. The pieces for each of the 256 ways a cell's
// corners fall are worked out once per mesh, in 'netTables'.
//
// SPARSE. The grid is tested in blocks of NetBlock cells a side: the
// distance at a block's centre, if it is more than half the block's
// diagonal (with a margin of 1%), means no point of the block is on the
// surface when the field is 1-Lipschitz (exact distances and bounds are),
// so every sample in it has the centre's sign and none is evaluated. A
// sample is evaluated only if some block holding it may meet the surface;
// every edge the surface crosses has both ends evaluated, so the mesh is
// bit for bit the one every sample would give (tests/meshing.cone checks).
//
// DETERMINISTIC. Everything is visited in a fixed order (z, then y, then x;
// the pieces of a cell by their first edge), sums are made in that order,
// and nothing depends on addresses or timing: the same shape and numbers
// give the same bits every run and in debug and release builds.
// 'meshHash' is a hash of those bits, for pinning them.
//
// Surface nets rounds sharp edges and corners off (a vertex is an average,
// not where the faces' planes meet): dual contouring, which keeps them, is
// not built.

// Cells a side of a block the sparse pass tests at once
const NetBlock = 4usize;

// A piece number meaning "the surface does not cross this edge"
const NoPiece = 255u8;

// A shape made into a surface net: vertices (one per piece of surface in a
// crossed cell), their gradient normals, and quads, four vertex indices
// each, counterclockwise seen from outside. 'toMesh' cuts the quads into
// triangles; 'toPolyMesh' keeps them, for 'validate'
pub struct SurfaceNet {
  pub positions List[Vec3];
  pub normals List[Vec3];
  pub quads List[u32];
  pub cellSize f32;
  pub cellsX u32;               // the grid's cells along x, y and z
  pub cellsY u32;
  pub cellsZ u32;
  pub evaluations u64;          // how many times the shape was asked its distance, in all
  pub sampled u64;              // of which at the grid's samples (of (cellsX + 1)(cellsY + 1)(cellsZ + 1))
  pub blocks u32;               // blocks in the sparse pass
  pub blocksSkipped u32;        // of which were far from the surface

  pub fn vertexCount(self &) usize { positions.len(); }
  pub fn quadCount(self &) usize { quads.len() / 4usize; }

  // Triangles: each quad cut along its shorter diagonal (the first, 0 to 2,
  // when they are equal), the positions and normals as they are
  pub fn toMesh(self &) mesh.Mesh {
    mut m = mesh.Mesh.empty();
    mut i = 0usize;
    while i < positions.len() {
      m.positions.push(*positions[i]);
      m.normals.push(*normals[i]);
      i = i + 1usize;
    }
    mut q = 0usize;
    while q < quads.len() {
      imm a = *quads[q];
      imm b = *quads[q + 1usize];
      imm c = *quads[q + 2usize];
      imm d = *quads[q + 3usize];
      imm ac = *positions[usize.from(c)] - *positions[usize.from(a)];
      imm bd = *positions[usize.from(d)] - *positions[usize.from(b)];
      if dot3(ac, ac) <= dot3(bd, bd) {
        m.indices.push(a); m.indices.push(b); m.indices.push(c);
        m.indices.push(a); m.indices.push(c); m.indices.push(d);
      } else {
        m.indices.push(a); m.indices.push(b); m.indices.push(d);
        m.indices.push(b); m.indices.push(c); m.indices.push(d);
      }
      q = q + 4usize;
    }
    m;
  }

  // The quads as a half-edge mesh; a quad it cannot add is reported into
  // 'problems' (none should be)
  pub fn toPolyMesh(self &, problems &mut List[String]) mesh.PolyMesh {
    mut counts = List[u32].withCapacity(quads.len() / 4usize);
    mut q = 0usize;
    while q < quads.len() {
      counts.push(4u32);
      q = q + 4usize;
    }
    mesh.PolyMesh.fromPolygons(positions.view(), counts.view(), quads.view(), problems);
  }
}

// ---- The pieces of a cell ----
//
// Corner c of a cell is at offset (c & 1, c >> 1 & 1, c >> 2 & 1). Edge e
// runs along axis a = e / 4, at offset o1 = e & 1 along axis (a + 1) % 3
// and o2 = e >> 1 & 1 along axis (a + 2) % 3.

struct NetTables {
  pieces List[u8];          // for each of the 256 corner signs: how many pieces
  edgePiece List[u8];         // 12 per sign: each edge's piece, or NoPiece
}

fn cornerBit(c u32, axis u32) u32 { (c >> axis) & 1u32; }

// The edge between two corners that differ along one axis
fn edgeBetween(c0 u32, c1 u32) u32 {
  imm d = c0 ^ c1;
  imm a = if d == 1u32 { 0u32; } elif d == 2u32 { 1u32; } else { 2u32; };
  assertDebug(d == 1u32 or d == 2u32 or d == 4u32);
  a * 4u32 + cornerBit(c0, (a + 1u32) % 3u32) + 2u32 * cornerBit(c0, (a + 2u32) % 3u32);
}

// The lower and upper corners of edge e
fn edgeStart(e u32) u32 {
  imm a = e / 4u32;
  ((e & 1u32) << ((a + 1u32) % 3u32)) | (((e >> 1u32) & 1u32) << ((a + 2u32) % 3u32));
}
fn edgeEnd(e u32) u32 { edgeStart(e) | (1u32 << (e / 4u32)); }

// Corner k (0 to 3, in order round it) of the face across 'axis' at 'side'
fn faceCorner(axis u32, side u32, k u32) u32 {
  imm u = 1u32 << ((axis + 1u32) % 3u32);
  imm v = 1u32 << ((axis + 2u32) % 3u32);
  imm base = side << axis;
  if k == 0u32 { base; } elif k == 1u32 { base | u; } elif k == 2u32 { base | u | v; } else { base | v; };
}

fn findRoot(parent &List[u32], e u32) u32 {
  mut r = e;
  while *parent[usize.from(r)] != r { r = *parent[usize.from(r)]; }
  r;
}

// Join two edges' pieces, the smaller root the root
fn joinEdges(parent &mut List[u32], a u32, b u32) {
  imm ra = findRoot(parent, a);
  imm rb = findRoot(parent, b);
  if ra < rb { parent.set(usize.from(rb), ra); } elif rb < ra { parent.set(usize.from(ra), rb); }
}

// For every way a cell's corners can fall (bit c set: corner c inside), its
// pieces: on each face, each run of inside corners round the face is cut
// off by one piece of the curve, joining the crossed edges at the run's two
// ends; the crossed edges those joins connect are one piece. Pieces are
// numbered by their first edge
fn netTables() NetTables {
  mut pieces = List[u8].withCapacity(256usize);
  mut edgePiece = List[u8].withCapacity(3072usize);
  mut config = 0u32;
  while config < 256u32 {
    mut parent = List[u32].withCapacity(12usize);
    mut e = 0u32;
    while e < 12u32 {
      parent.push(e);
      e = e + 1u32;
    }
    mut axis = 0u32;
    while axis < 3u32 {
      mut side = 0u32;
      while side < 2u32 {
        mut k = 0u32;
        while k < 4u32 {
          imm c0 = faceCorner(axis, side, k);
          imm c1 = faceCorner(axis, side, (k + 1u32) % 4u32);
          // A run of inside corners starts at c1: find where it ends
          if cornerBit(config, c0) == 0u32 and cornerBit(config, c1) == 1u32 {
            mut j = (k + 1u32) % 4u32;
            while cornerBit(config, faceCorner(axis, side, (j + 1u32) % 4u32)) == 1u32 { j = (j + 1u32) % 4u32; }
            imm d0 = faceCorner(axis, side, j);
            imm d1 = faceCorner(axis, side, (j + 1u32) % 4u32);
            joinEdges(&mut parent, edgeBetween(c0, c1), edgeBetween(d0, d1));
          }
          k = k + 1u32;
        }
        side = side + 1u32;
      }
      axis = axis + 1u32;
    }
    // Number the pieces by their first edge
    mut label = List[u8].withCapacity(12usize);
    e = 0u32;
    while e < 12u32 {
      label.push(NoPiece);
      e = e + 1u32;
    }
    mut n = 0u8;
    e = 0u32;
    while e < 12u32 {
      if cornerBit(config, edgeStart(e)) != cornerBit(config, edgeEnd(e)) {
        imm r = usize.from(findRoot(&parent, e));
        if *label[r] == NoPiece {
          label.set(r, n);
          n = n + 1u8;
        }
        edgePiece.push(*label[r]);
      } else {
        edgePiece.push(NoPiece);
      }
      e = e + 1u32;
    }
    assertDebug(n <= 4u8);
    pieces.push(n);
    config = config + 1u32;
  }
  new NetTables(pieces, edgePiece);
}

// The unit gradient by central differences, h either side ('gradient'),
// (1, 0, 0) where the field is flat. Central differences, not 'normal''s
// tetrahedron: the tetrahedron's error is first order in h (0.006 on the
// unit sphere at h = 0.0125, measured), the central differences' second
// (under 0.0002)
fn unitGradient[S Shape](shape &S, p Vec3, h f32) Vec3 {
  imm g = gradient(shape, p, h);
  imm len = len3(g);
  if len > 0. { g * (1. / len); } else { new Vec3(1., 0., 0.); };
}

// ---- The grid ----

// Grid coordinates along (a, a + 1, a + 2) back to (x, y, z)
fn axisToXyz(a usize, pa usize, pu usize, pv usize, x &mut usize, y &mut usize, z &mut usize) {
  if a == 0usize { *x = pa; *y = pu; *z = pv; }
  elif a == 1usize { *y = pa; *z = pu; *x = pv; }
  else { *z = pa; *x = pu; *y = pv; }
}

fn pickAxis(a usize, x usize, y usize, z usize) usize {
  if a == 0usize { x; } elif a == 1usize { y; } else { z; };
}

// The shape made into a surface net over 'box', in cubic cells 'cellSize' a
// side. The grid covers the box and one cell more on every side, so a box
// that holds the shape gives a closed mesh; a surface reaching the grid's
// edge is left open there. 'relax' times, each vertex is moved along the
// gradient by its distance (towards the surface), kept inside its cell; 0
// leaves the average of the crossings. With 'sparse', blocks far from the
// surface are not sampled (the result is the same)
pub fn surfaceNet[S Shape](shape &S, box Aabb3, cellSize f32, relax u32, sparse Bool) SurfaceNet {
  imm tables = netTables();
  imm cs = cellSize;
  imm lo = box.min - new Vec3(cs, cs, cs);
  imm extent = box.max - box.min;
  imm nx = usize.from(libc.ceilf(extent.x / cs)) + 2usize;
  imm ny = usize.from(libc.ceilf(extent.y / cs)) + 2usize;
  imm nz = usize.from(libc.ceilf(extent.z / cs)) + 2usize;
  imm px = nx + 1usize;
  imm py = ny + 1usize;
  imm pz = nz + 1usize;
  imm points = px * py * pz;
  mut evaluations = 0u64;
  mut sampled = 0u64;

  // The samples: first each skipped block's centre distance (its sign is
  // every one of its samples'), then the distance itself wherever a block
  // that may meet the surface needs it
  mut values = List[f32].withCapacity(points);
  mut needed = List[u8].withCapacity(points);
  mut i = 0usize;
  while i < points {
    values.push(0.);
    needed.push(if sparse { 0u8; } else { 1u8; });
    i = i + 1usize;
  }
  imm blocksX = (nx + NetBlock - 1usize) / NetBlock;
  imm blocksY = (ny + NetBlock - 1usize) / NetBlock;
  imm blocksZ = (nz + NetBlock - 1usize) / NetBlock;
  mut blocksSkipped = 0u32;
  if sparse {
    mut kz = 0usize;
    while kz < blocksZ {
      imm z0 = kz * NetBlock;
      imm z1 = if z0 + NetBlock < nz { z0 + NetBlock; } else { nz; };
      mut ky = 0usize;
      while ky < blocksY {
        imm y0 = ky * NetBlock;
        imm y1 = if y0 + NetBlock < ny { y0 + NetBlock; } else { ny; };
        mut kx = 0usize;
        while kx < blocksX {
          imm x0 = kx * NetBlock;
          imm x1 = if x0 + NetBlock < nx { x0 + NetBlock; } else { nx; };
          imm centre = new Vec3(lo.x + cs * 0.5 * f32.from(x0 + x1), lo.y + cs * 0.5 * f32.from(y0 + y1),
            lo.z + cs * 0.5 * f32.from(z0 + z1));
          imm sx = f32.from(x1 - x0);
          imm sy = f32.from(y1 - y0);
          imm sz = f32.from(z1 - z0);
          imm half = 0.5 * cs * sqrtf(sx * sx + sy * sy + sz * sz);
          imm d = shape.distance(centre);
          evaluations = evaluations + 1u64;
          imm far = absf(d) > half * 1.01;
          if far { blocksSkipped = blocksSkipped + 1u32; }
          mut z = z0;
          while z <= z1 {
            mut y = y0;
            while y <= y1 {
              mut x = x0;
              while x <= x1 {
                imm at = x + px * (y + py * z);
                if far {
                  if *needed[at] == 0u8 { values.set(at, d); }
                } else {
                  needed.set(at, 1u8);
                }
                x = x + 1usize;
              }
              y = y + 1usize;
            }
            z = z + 1usize;
          }
          kx = kx + 1usize;
        }
        ky = ky + 1usize;
      }
      kz = kz + 1usize;
    }
  }
  mut z = 0usize;
  while z < pz {
    mut y = 0usize;
    while y < py {
      mut x = 0usize;
      while x < px {
        imm at = x + px * (y + py * z);
        if *needed[at] == 1u8 {
          values.set(at, shape.distance(new Vec3(lo.x + cs * f32.from(x), lo.y + cs * f32.from(y), lo.z + cs * f32.from(z))));
          evaluations = evaluations + 1u64;
          sampled = sampled + 1u64;
        }
        x = x + 1usize;
      }
      y = y + 1usize;
    }
    z = z + 1usize;
  }

  // The cells: each crossed one's corner signs and its pieces' vertices, at
  // the average of each piece's crossings
  imm ncells = nx * ny * nz;
  mut configs = List[u8].withCapacity(ncells);
  mut firstVertex = List[u32].withCapacity(ncells);
  mut positions = List[Vec3].empty();
  mut cellOf = List[Vec3].empty();       // each vertex's cell's lowest corner
  z = 0usize;
  while z < nz {
    mut y = 0usize;
    while y < ny {
      mut x = 0usize;
      while x < nx {
        mut config = 0u32;
        mut c = 0u32;
        while c < 8u32 {
          imm at = (x + usize.from(cornerBit(c, 0u32))) + px * ((y + usize.from(cornerBit(c, 1u32))) + py * (z + usize.from(cornerBit(c, 2u32))));
          if *values[at] < 0. { config = config | (1u32 << c); }
          c = c + 1u32;
        }
        configs.push(u8.from(config));
        imm n = *tables.pieces[usize.from(config)];
        if n == 0u8 {
          firstVertex.push(mesh.NoIndex);
        } else {
          firstVertex.push(u32.from(positions.len()));
          imm corner = new Vec3(lo.x + cs * f32.from(x), lo.y + cs * f32.from(y), lo.z + cs * f32.from(z));
          mut piece = 0u8;
          while piece < n {
            mut sum = new Vec3(0., 0., 0.);
            mut count = 0u32;
            mut e = 0u32;
            while e < 12u32 {
              if *tables.edgePiece[usize.from(config * 12u32 + e)] == piece {
                imm c0 = edgeStart(e);
                imm c1 = edgeEnd(e);
                imm d0 = *values[(x + usize.from(cornerBit(c0, 0u32))) + px * ((y + usize.from(cornerBit(c0, 1u32))) + py * (z + usize.from(cornerBit(c0, 2u32))))];
                imm d1 = *values[(x + usize.from(cornerBit(c1, 0u32))) + px * ((y + usize.from(cornerBit(c1, 1u32))) + py * (z + usize.from(cornerBit(c1, 2u32))))];
                imm t = d0 / (d0 - d1);
                assertDebug(t >= 0. and t <= 1.);
                // The crossing in the cell's own coordinates, 0 to 1
                imm a = e / 4u32;
                imm within = new Vec3(if a == 0u32 { t; } else { f32.from(cornerBit(c0, 0u32)); },
                  if a == 1u32 { t; } else { f32.from(cornerBit(c0, 1u32)); },
                  if a == 2u32 { t; } else { f32.from(cornerBit(c0, 2u32)); });
                sum = sum + within;
                count = count + 1u32;
              }
              e = e + 1u32;
            }
            assertDebug(count >= 3u32);
            imm avg = sum * (1. / f32.from(count));
            positions.push(new Vec3(corner.x + cs * avg.x, corner.y + cs * avg.y, corner.z + cs * avg.z));
            cellOf.push(corner);
            piece = piece + 1u8;
          }
        }
        x = x + 1usize;
      }
      y = y + 1usize;
    }
    z = z + 1usize;
  }

  // Relaxation onto the surface, and the gradient normals
  imm h = cs * 0.1;
  mut normals = List[Vec3].withCapacity(positions.len());
  mut v = 0usize;
  while v < positions.len() {
    mut p = *positions[v];
    mut r = 0u32;
    while r < relax {
      imm d = shape.distance(p);
      imm g = unitGradient(shape, p, h);
      evaluations = evaluations + 7u64;
      imm lower = *cellOf[v];
      imm upper = lower + new Vec3(cs, cs, cs);
      p = new Vec3(clampf(p.x - g.x * d, lower.x, upper.x), clampf(p.y - g.y * d, lower.y, upper.y),
        clampf(p.z - g.z * d, lower.z, upper.z));
      r = r + 1u32;
    }
    positions.set(v, p);
    normals.push(unitGradient(shape, p, h));
    evaluations = evaluations + 6u64;
    v = v + 1usize;
  }

  // The quads: one across each grid edge the surface crosses, its four
  // cells counterclockwise round the edge seen from the outside end
  mut quads = List[u32].empty();
  z = 0usize;
  while z < pz {
    mut y = 0usize;
    while y < py {
      mut x = 0usize;
      while x < px {
        imm at = x + px * (y + py * z);
        imm inside = *values[at] < 0.;
        mut a = 0usize;
        while a < 3usize {
          imm u = (a + 1usize) % 3usize;
          imm w = (a + 2usize) % 3usize;
          imm pa = pickAxis(a, x, y, z);
          imm pu = pickAxis(u, x, y, z);
          imm pv = pickAxis(w, x, y, z);
          imm na = pickAxis(a, nx, ny, nz);
          imm nu = pickAxis(u, nx, ny, nz);
          imm nv = pickAxis(w, nx, ny, nz);
          if pa < na and pu >= 1usize and pu < nu and pv >= 1usize and pv < nv {
            imm step = pickAxis(a, 1usize, px, px * py);
            imm across = *values[at + step] < 0.;
            if inside != across {
              // The four cells, counterclockwise about +a
              mut vs = List[u32].withCapacity(4usize);
              mut k = 0usize;
              while k < 4usize {
                imm cu = if k == 1usize or k == 2usize { pu; } else { pu - 1usize; };
                imm cv = if k >= 2usize { pv; } else { pv - 1usize; };
                mut cx = 0usize;
                mut cy = 0usize;
                mut cz = 0usize;
                axisToXyz(a, pa, cu, cv, &mut cx, &mut cy, &mut cz);
                imm cell = cx + nx * (cy + ny * cz);
                imm config = u32.from(*configs[cell]);
                imm e = u32.from(a) * 4u32 + u32.from(pu - cu) + 2u32 * u32.from(pv - cv);
                imm piece = *tables.edgePiece[usize.from(config * 12u32 + e)];
                assertDebug(piece != NoPiece and *firstVertex[cell] != mesh.NoIndex);
                vs.push(*firstVertex[cell] + u32.from(piece));
                k = k + 1usize;
              }
              // Outward is +a when the lower end is inside
              if inside {
                quads.push(*vs[0usize]); quads.push(*vs[1usize]); quads.push(*vs[2usize]); quads.push(*vs[3usize]);
              } else {
                quads.push(*vs[0usize]); quads.push(*vs[3usize]); quads.push(*vs[2usize]); quads.push(*vs[1usize]);
              }
            }
          }
          a = a + 1usize;
        }
        x = x + 1usize;
      }
      y = y + 1usize;
    }
    z = z + 1usize;
  }
  new SurfaceNet(positions, normals, quads, cs, u32.from(nx), u32.from(ny), u32.from(nz), evaluations, sampled,
    u32.from(blocksX * blocksY * blocksZ), blocksSkipped);
}

// Levels of detail: 'count' surface nets of the shape over 'box', the first
// (level 0, the finest) in cells 'finest' a side, each next in cells twice
// as large, sparse and relaxed 'relax' times. Each level is meshed on its
// own from the field (none is simplified from another), so each is as
// true to the shape as its cells allow; 'toMesh' makes each a mesh for a
// renderer's chain of levels
pub fn netLevels[S Shape](shape &S, box Aabb3, finest f32, count u32, relax u32) List[SurfaceNet] {
  mut out = List[SurfaceNet].withCapacity(usize.from(count));
  mut cell = finest;
  mut i = 0u32;
  while i < count {
    out.push(surfaceNet(shape, box, cell, relax, true));
    cell = cell * 2.;
    i = i + 1u32;
  }
  out;
}

// A hash of a mesh's bits, for pinning a mesh and comparing it across runs,
// builds and machines: its vertex and index counts, then every position's
// and normal's coordinates as their f32 bits, then every index, each word
// folded in by noise's PCG hash, h = pcg(h ^ word), in that order. Two
// meshes with the same hash have, almost surely, the same bits
pub fn meshHash(m &mesh.Mesh) u32 {
  mut h = noise.pcg(u32.from(m.positions.len()));
  h = noise.pcg(h ^ u32.from(m.indices.len()));
  mut i = 0usize;
  while i < m.positions.len() {
    imm p = *m.positions[i];
    h = noise.pcg(h ^ (p.x as u32));
    h = noise.pcg(h ^ (p.y as u32));
    h = noise.pcg(h ^ (p.z as u32));
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.normals.len() {
    imm n = *m.normals[i];
    h = noise.pcg(h ^ (n.x as u32));
    h = noise.pcg(h ^ (n.y as u32));
    h = noise.pcg(h ^ (n.z as u32));
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.indices.len() {
    h = noise.pcg(h ^ *m.indices[i]);
    i = i + 1usize;
  }
  h;
}
