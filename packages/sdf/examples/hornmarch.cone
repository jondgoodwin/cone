// Written by tools/shaders/shaders.py from hornmarch.slang (sha256 64a5f831dd8a1401ffbd4b3dbce442f477152080326b700f40ea97b38d13ab9b): do not edit.
imm HORNMARCH_SPIRV [23168; u32] = [
  0x07230203u32, 0x00010500u32, 0x00280000u32, 0x00001af9u32, 0x00000000u32, 0x00020011u32,
  0x00000001u32, 0x0006000bu32, 0x00000066u32, 0x4c534c47u32, 0x6474732eu32, 0x3035342eu32,
  0x00000000u32, 0x0003000eu32, 0x00000000u32, 0x00000001u32, 0x0008000fu32, 0x00000000u32,
  0x00000002u32, 0x74726576u32, 0x614d7865u32, 0x00006e69u32, 0x00000029u32, 0x0000000du32,
  0x000f000fu32, 0x00000004u32, 0x0000002cu32, 0x67617266u32, 0x746e656du32, 0x6e69614du32,
  0x00000000u32, 0x00000041u32, 0x000003dau32, 0x000004b1u32, 0x000004b5u32, 0x000009a5u32,
  0x000009adu32, 0x0000043bu32, 0x0000003du32, 0x00030010u32, 0x0000002cu32, 0x00000007u32,
  0x00030003u32, 0x0000000bu32, 0x00000001u32, 0x00040005u32, 0x0000001au32, 0x6e726f63u32,
  0x00007265u32, 0x00050005u32, 0x00000002u32, 0x74726576u32, 0x614d7865u32, 0x00006e69u32,
