  0x00060006u32, 0x0000002fu32, 0x00000005u32, 0x44626972u32, 0x68747065u32, 0x00000000u32,
  0x00040006u32, 0x0000002fu32, 0x00000006u32, 0x00637261u32, 0x00050006u32, 0x0000002fu32,
  0x00000007u32, 0x6c6c6563u32, 0x00000073u32, 0x00040006u32, 0x0000002fu32, 0x00000008u32,
