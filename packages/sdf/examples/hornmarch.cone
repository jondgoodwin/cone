// hornmarch: a preview of the sdf package's horn, sphere-traced on the GPU
// with no mesh (meshing comes later). A ribbed, tapering, curling horn,
// Latham's and Raup's, turns under the dusk sky in black chitin: render's
// physically based layers (a dark rough base, a clear coat, a thin film
// whose thickness is warped noise drifting with time), lit by the sun and by
// the sky's image-based lighting, the sun shadowed and the sky occluded by
// the distance field itself. The frame is half-float, bloomed and
// tone-mapped (AgX) by render's Post. The shader, hornmarch.slang, calls
// sdf.slang's Horn, the same functions as the Cone package in the same
// order (the package's parity test checks them).
//
//   congo run packages/sdf/examples/hornmarch.cone
//   congo run packages/sdf/examples/hornmarch.cone -- --frames 120 --screenshot horn.bmp
//
// Keys:
//   F            the film on or off
//   T            the next tone mapper: AgX, ACES, Reinhard, none
//   Escape       quit; F11 fullscreen
//
// '--frames N' (or HORNMARCH_FRAMES) draws N frames and stops; otherwise it
// runs until quit. Time is the frame's number over 60 (seconds), so a run of
// N frames is the same every time; eight frames after the check such a run
// makes the window smaller, so it draws at two sizes under validation. At
// frame CHECK_FRAME (or the last, if sooner) it reads the frame back and
// checks it: the sky above is dusk (bluer than red), and the horn is drawn
// where the middle of its arc falls, unlike the sky at the screen's edge on
// that row. The CPU also sphere-traces that pixel's ray through the Cone
// package's horn and must hit it. '--screenshot FILE' writes that frame to
// FILE as a BMP, and the next beside it with no film ('-nofilm'). After the
// run it draws BENCH_FRAMES frames more into an offscreen target of
// 1920 x 1080, as fast as the GPU goes, and prints their mean time. It exits
// 0 only if every check passed, no Vulkan call failed and the validation
// layer said nothing.
//
// It needs a display, a GPU driver with Vulkan 1.3, SDL2.lib on LIB to link
// and SDL2.dll on PATH to run; with the Vulkan SDK, validation is on.
// GPU_POWER_PREFERENCE=low-power picks an integrated GPU where there are two.

mod hornmarch;

import stdio use *;
import libc;
import sdl;
import collections use *;
import geomath use *;
import gpu use *;
import render use *;
import window use *;
import sdf use *;

const CHECK_FRAME = 90;
const BENCH_FRAMES = 120;
const KEY_F = 102u32;
const KEY_T = 116u32;

// The horn: 3.4 long, 0.34 at the base, tapering to a point, curled 1.7
// radians, 22 ribs as thick as 0.12 of its radius; moved 1.1 along -x so it
// turns about its middle
const LENGTH f32 = 3.4;
const BASE f32 = 0.34;
const TAPER f32 = 0.97;
const CURL f32 = 1.7;
const RIBS = 22;
const RIB_DEPTH f32 = 0.12;
const OFFSET f32 = 1.1;

// The camera
const FOV f32 = 0.6981317;       // 40 degrees
fn eye() Vec3 { Vec3[0., 1.35, 6.2]; }
fn target() Vec3 { Vec3[0., 1.05, 0.]; }

// ---- Arguments ----

fn parseCount(s *u8) i32 {
  if (s as usize) == 0usize or *s == 0u8 { return -1; }
  mut n = 0;
  mut i = 0usize;
  while *(s + i) != 0u8 {
    imm c = *(s + i);
    if c < '0' or c > '9' { return -1; }
    n = n * 10 + i32[c - '0'];
    i = i + 1usize;
  }
  n;
}

fn cstrEquals(a *u8, b &[]u8) Bool {
  mut i = 0usize;
  while i < b.len {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len) == 0u8;
}

fn onOff(on Bool) &[]u8 { if on { "on"; } else { "off"; }; }

// ---- The camera and the horn's place ----

// The camera's basis, as the shader takes it: right and up scaled to the
// screen's edges
struct View {
  pub right Vec3;
  pub up Vec3;
  pub forward Vec3;
}

fn view(aspect f32) View {
  imm forward = (target() - eye()).normalize();
  imm right = forward.cross(Vec3[0., 1., 0.]).normalize();
  imm up = right.cross(forward);
  imm t = tan(FOV * 0.5);
  View[right * (t * aspect), up * t, forward];
}

// The horn's turn at time t: a quarter turn in 5 s
fn turnAt(t f32) Quat { Quat.angleAxis(t * 0.3, Vec3[0., 1., 0.]); }

// The world point of the horn's own point p, turned by 'turn'
fn hornToWorld(p Vec3, turn Quat) Vec3 { turn * (p - Vec3[OFFSET, 0., 0.]); }

// The scene's distance at world point p, as the shader's Scene has it
fn sceneDistance(horn &Horn, turn Quat, p Vec3) f32 {
  imm q = rotate(p, turn);
  horn.distance(Vec3[q.x + OFFSET, q.y, q.z]);
}

// Where pixel ('x', 'y') of a 'w' by 'h' frame looks
fn pixelRay(v &View, x i32, y i32, w u32, h u32) Vec3 {
  imm nx = (f32[x] + 0.5) / f32[w] * 2. - 1.;
  imm ny = 1. - (f32[y] + 0.5) / f32[h] * 2.;
  (v.forward + v.right * nx + v.up * ny).normalize();
}

// Where the world point p is drawn, in pixels
fn pixelOf(v &View, p Vec3, w u32, h u32, x &mut i32, y &mut i32) {
  imm d = p - eye();
  imm z = d.dot(v.forward);
  imm rl = v.right.length();
  imm ul = v.up.length();
  imm nx = d.dot(v.right) / (rl * rl) / z;
  imm ny = d.dot(v.up) / (ul * ul) / z;
  *x = i32[(nx + 1.) * 0.5 * f32[w]];
  *y = i32[(1. - ny) * 0.5 * f32[h]];
}

// The CPU's sphere trace of the ray from the eye along 'rd': whether it
// meets the horn
fn cpuHits(horn &Horn, turn Quat, rd Vec3) Bool {
  mut t f32 = 0.;
  mut i = 0;
  while i < 400 and t < 40. {
    imm d = sceneDistance(horn, turn, eye() + rd * t);
    if d < 0.0004 * t { return true; }
    t = t + d;
    i = i + 1;
  }
  false;
}

// The immediates, as hornmarch.slang's Immediates
fn immediates(v &View, t f32, film Bool, strength f32, turn Quat, w u32, h u32) [32; f32] {
  imm e = eye();
  [e.x, e.y, e.z, t,
    v.right.x, v.right.y, v.right.z, 0.,
    v.up.x, v.up.y, v.up.z, if film { 1.; } else { 0.; },
    v.forward.x, v.forward.y, v.forward.z, strength,
    LENGTH, BASE, TAPER, CURL,
    f32[RIBS], RIB_DEPTH, OFFSET, 0.,
    turn.x, turn.y, turn.z, turn.w,
    f32[w], f32[h], 0., 0.];
}

// ---- The check ----

fn channel(p *u8, w u32, x i32, y i32, c usize, bgra Bool) i32 {
  mut at = c;
  if bgra { at = 2usize - c; }
  i32[*(p + (usize[y] * usize[w] + usize[x]) * 4usize + at)];
}

fn luma(p *u8, w u32, x i32, y i32, bgra Bool) i32 {
  channel(p, w, x, y, 0usize, bgra) + channel(p, w, x, y, 1usize, bgra) + channel(p, w, x, y, 2usize, bgra);
}

fn printPixel(name &[]u8, p *u8, w u32, x i32, y i32, bgra Bool) {
  printStr(name); print <- " at ("; print <- x; print <- ", "; print <- y; print <- "): ";
  print <- channel(p, w, x, y, 0usize, bgra); print <- " "; print <- channel(p, w, x, y, 1usize, bgra); print <- " ";
  print <- channel(p, w, x, y, 2usize, bgra);
}

// ---- The demo ----

// One frame: the environment made (once), the horn traced into the
// half-float frame, bloomed and tone-mapped into 'target'
fn record(encoder &mut CommandEncoder, renderer &mut Renderer, post &mut Post, pipeline &RenderPipeline,
    data &[32; f32], target &Texture) {
  renderer.environment.bake(encoder);
  {
    imm attachment = RenderPassColorAttachment[view: post.hdr.createView(), clearValue: Color[0., 0., 0., 1.]];
    mut pass = encoder.beginRenderPass(&attachment);
    pass.setPipeline(pipeline);
    pass.setBindGroup(0u32, &renderer.environment.group);
    pass.setImmediates(0u32, data as *u8, 128u32);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
  }
  post.apply(encoder, target);
}

fn main(argc i32, argv **u8) i32 {
  mut maxFrames = 0;
  mut screenshot = String.empty();
  imm env = libc.getenv(&"HORNMARCH_FRAMES" as *u8);
  if (env as usize) != 0usize { maxFrames = parseCount(env); }
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize[a]);
    if cstrEquals(arg, "--frames") and a + 1 < argc {
      maxFrames = parseCount(*(argv + usize[a + 1]));
      a = a + 1;
    } elif cstrEquals(arg, "--screenshot") and a + 1 < argc {
      imm s = *(argv + usize[a + 1]);
      mut i = 0usize;
      while *(s + i) != 0u8 {
        screenshot.appendByte(*(s + i));
        i = i + 1usize;
      }
      a = a + 1;
    } else {
      print <- "Unknown argument; use --frames N and --screenshot FILE\n";
      return 2;
    }
    a = a + 1;
  }
  if maxFrames < 0 {
    print <- "--frames wants a whole number\n";
    return 2;
  }
  mut checkFrame = CHECK_FRAME;
  if maxFrames > 0 and maxFrames - 1 < checkFrame { checkFrame = maxFrames - 1; }

  imm horn = Horn.make(LENGTH, BASE, TAPER, CURL, RIBS, RIB_DEPTH);
  print <- "The horn: "; print <- LENGTH; print <- " long, "; print <- RIBS; print <- " ribs, curled ";
  print <- CURL; print <- " radians, distance at its base point "; print <- horn.distance(Vec3[0., 0., 0.]);
  print <- "\n";

  mut win = Window.openVulkan("Cone: the sdf horn, sphere-traced");
  if !win.isOpen() {
    print <- "No window could be opened\n";
    return 1;
  }
  mut instance = Instance.create("hornmarch");
  if !instance.isValid() {
    print <- "No Vulkan 1.3 instance could be made\n";
    return 1;
  }
  mut surface = instance.createSurface(win.sdlHandle());
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm powerEnv = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (powerEnv as usize) != 0usize {
    if libc.strcmp(powerEnv, &"low-power" as *u8) == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&surface, preference);
  if !adapter.isValid() {
    print <- "No GPU can draw to the window\n";
    return 1;
  }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  print <- "Validation layer: "; printStr(onOff(instance.validation));
  print <- "; synchronization validation: "; printStr(onOff(instance.syncValidation)); print <- "\n";
  mut device = adapter.requestDevice();
  imm size = win.size();
  mut swapchain = device.createSwapChain(&surface, u32[size.w], u32[size.h], TEXTURE_FORMAT_DEPTH32_FLOAT);
  // The renderer only for its environment: the sky made into image-based
  // lighting
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, swapchain.format, u32[size.w], u32[size.h]);
  if !renderer.isValid() or !post.isValid() {
    print <- "The renderer could not be made\n";
    return 1;
  }
  imm sky = Sky.dusk(radians(6.), radians(25.));
  renderer.setSky(&mut device, &sky);

  mut shader = device.createShaderModule(&HORNMARCH_SPIRV);
  imm layouts = [&renderer.environmentLayout];
  mut layout = device.createPipelineLayout(&layouts, 128u32);
  imm noBuffers = List[VertexBufferLayout].empty();
  imm desc = RenderPipelineDescriptor[layout: &layout, vertexModule: &shader, buffers: noBuffers.view(),
    fragmentModule: &shader, colorFormat: TEXTURE_FORMAT_RGBA16_FLOAT];
  mut pipeline = device.createRenderPipeline(&desc);
  if !pipeline.isValid() {
    print <- "The pipeline could not be made\n";
    return 1;
  }

  mut frames = 0;
  mut unshown = 0;
  mut checked = false;
  mut checksPassed = true;
  mut shotsWritten = true;
  mut extraShot = 0;
  mut film = true;
  imm frequency = f64[sdl.GetPerformanceFrequency()];
  mut firstTimed = 0u64;
  mut lastTimed = 0u64;
  mut lastTimedFrame = 0;
  while win.running and (maxFrames == 0 or frames < maxFrames) {
    mut event = sdl.Event.empty();
    while win.pollEvent(&mut event) {
      imm key = keyDown(&event);
      if key == KEY_F { film = !film; }
      if key == KEY_T { post.toneMapper = (post.toneMapper + 1u32) % 4u32; }
    }
    // The screenshot after the checked frame: no film
    imm extraNow = screenshot.len() > 0usize and checked and extraShot < 1;
    if extraNow { film = false; } elif screenshot.len() > 0usize and extraShot == 1 { film = true; extraShot = 2; }
    if maxFrames > 0 and frames == checkFrame + 8 { win.setSize(size.w * 2 / 3, size.h * 2 / 3); }
    if win.resized {
      imm s = win.size();
      swapchain.resize(u32[s.w], u32[s.h]);
      win.resized = false;
    }
    imm frame = swapchain.getCurrentTexture(&mut device);
    if !frame.ok() {
      sdl.Delay(10u32);
    } else {
      imm started = sdl.GetPerformanceCounter();
      imm w = frame.texture.width;
      imm h = frame.texture.height;
      imm t = f32[frames] / 60.;
      post.resize(&mut device, w, h);
      imm v = view(f32[w] / f32[h]);
      imm turn = turnAt(t);
      imm data = immediates(&v, t, film, 1., turn, w, h);
      mut encoder = device.createCommandEncoder();
      record(&mut encoder, &mut renderer, &mut post, &pipeline, &data, &frame.texture);
      imm bgra = frame.texture.format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB
        or frame.texture.format == TEXTURE_FORMAT_BGRA8_UNORM;
      imm checkNow = frames == checkFrame and !checked;
      if checkNow or extraNow {
        mut readback = device.createBuffer(u64[w] * u64[h] * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
        encoder.copyTextureToBuffer(&frame.texture, &readback);
        device.queue.submit(encoder.finish());
        if !swapchain.present(&mut device) { unshown = unshown + 1; }
        device.waitIdle();
        imm p = readback.mappedRange();
        if checkNow {
          checked = true;
          print <- "Frame "; print <- frames; print <- " ("; print <- u64[w]; print <- " x "; print <- u64[h];
          print <- "):\n";
          imm tx = i32[w / 2u32];
          imm ty = i32[h / 30u32];
          printPixel("  the sky above", p, w, tx, ty, bgra);
          imm high = channel(p, w, tx, ty, 2usize, bgra) > channel(p, w, tx, ty, 0usize, bgra);
          if high { print <- ": bluer than red\n"; } else { print <- ": NOT bluer than red\n"; checksPassed = false; }
          // The middle of the horn's arc
          imm mid = hornToWorld(horn.arc.point(LENGTH * 0.5), turn);
          mut hx = 0;
          mut hy = 0;
          pixelOf(&v, mid, w, h, &mut hx, &mut hy);
          if hx < 0 or hy < 0 or hx >= i32[w] or hy >= i32[h] {
            print <- "  the horn: off the screen\n";
            checksPassed = false;
          } else {
            printPixel("  the horn", p, w, hx, hy, bgra);
            imm sx = i32[w / 20u32];
            imm d = luma(p, w, hx, hy, bgra) - luma(p, w, sx, hy, bgra);
            if d > 30 or d < -30 { print <- ": drawn, unlike the sky at the edge\n"; }
            else { print <- ": NOT unlike the sky at the edge\n"; checksPassed = false; }
            imm hits = cpuHits(&horn, turn, pixelRay(&v, hx, hy, w, h));
            if hits { print <- "  the CPU's trace of that pixel's ray meets the horn too\n"; }
            else { print <- "  the CPU's trace of that pixel's ray does NOT meet the horn\n"; checksPassed = false; }
            imm misses = !cpuHits(&horn, turn, pixelRay(&v, i32[w / 20u32], hy, w, h));
            if misses { print <- "  and misses it at the screen's edge\n"; }
            else { print <- "  and does NOT miss it at the screen's edge\n"; checksPassed = false; }
          }
          if screenshot.len() > 0usize {
            imm shot = Image.fromTexels(p, i32[w], i32[h], bgra);
            imm written = shot.save(screenshot.view());
            print <- "Screenshot: "; printStr(screenshot.view());
            if written { print <- "\n"; } else { print <- " could NOT be written\n"; shotsWritten = false; }
          }
        } else {
          mut name = String.empty();
          if screenshot.endsWith(".bmp") { name = screenshot.sub(0usize, screenshot.len() - 4usize); }
          else { name = screenshot.copy(); }
          name <- "-nofilm.bmp";
          imm shot = Image.fromTexels(p, i32[w], i32[h], bgra);
          imm written = shot.save(name.view());
          print <- "Screenshot: "; printStr(name.view());
          if written { print <- "\n"; } else { print <- " could NOT be written\n"; shotsWritten = false; }
          extraShot = 1;
        }
      } else {
        device.queue.submit(encoder.finish());
        if !swapchain.present(&mut device) { unshown = unshown + 1; }
        if frames >= 10 {
          if firstTimed == 0u64 { firstTimed = started; }
          lastTimed = started;
          lastTimedFrame = frames;
        }
      }
      frames = frames + 1;
    }
  }
  device.waitIdle();

  print <- "Frames drawn: "; print <- frames; print <- "; presented: "; print <- swapchain.presents;
  print <- "; out of date when presented: "; print <- unshown; print <- "\n";
  if lastTimedFrame > 12 and lastTimed > firstTimed {
    imm frameMs = f64[lastTimed - firstTimed] / frequency * 1000. / f64[lastTimedFrame - 10];
    print <- "Frame time: "; print <- frameMs; print <- " ms a frame (presented in step with the display)\n";
  }

  // The GPU's cost of a frame at 1080p, drawn offscreen, nothing presented
  if frames > 0 {
    imm w = 1920u32;
    imm h = 1080u32;
    imm targetDesc = TextureDescriptor[w, h, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_RENDER_ATTACHMENT];
    mut target = device.createTexture(&targetDesc);
    mut benchPost = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, w, h);
    imm v = view(f32[w] / f32[h]);
    device.waitIdle();
    imm benchStart = sdl.GetPerformanceCounter();
    mut b = 0;
    while b < BENCH_FRAMES {
      imm t = f32[frames + b] / 60.;
      imm data = immediates(&v, t, true, 1., turnAt(t), w, h);
      mut encoder = device.createCommandEncoder();
      record(&mut encoder, &mut renderer, &mut benchPost, &pipeline, &data, &target);
      device.queue.submit(encoder.finish());
      device.endFrame();
      b = b + 1;
    }
    device.waitIdle();
    imm benchMs = f64[sdl.GetPerformanceCounter() - benchStart] / frequency * 1000. / f64[BENCH_FRAMES];
    print <- "GPU frame time, offscreen at 1920 x 1080: "; print <- benchMs; print <- " ms a frame (";
    print <- BENCH_FRAMES; print <- " frames, nothing presented)\n";
  }

  print <- "Vulkan failures: "; print <- u64[failures()];
  print <- "; validation messages: "; print <- u64[validationMessages()]; print <- "\n";
  if !checked { print <- "The frame was not checked\n"; }
  if (checked and !checksPassed) or !shotsWritten {
    print <- "FAILED\n";
    return 1;
  }
  if failures() != 0u32 or validationMessages() != 0u32 { return 1; }
  print <- "OK\n";
  0;
}

