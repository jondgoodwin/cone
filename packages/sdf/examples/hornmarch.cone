  0x00000031u32, 0x43637241u32, 0x736c6c65u32, 0x00000000u32, 0x00050006u32, 0x00000031u32,
  0x00000000u32, 0x6e756f63u32, 0x00000074u32, 0x00050006u32, 0x00000031u32, 0x00000001u32,
  0x70657473u32, 0x00000000u32, 0x00060006u32, 0x00000031u32, 0x00000002u32, 0x73726966u32,
  0x736f4374u32, 0x00000000u32, 0x00060006u32, 0x00000031u32, 0x00000003u32, 0x73726966u32,
