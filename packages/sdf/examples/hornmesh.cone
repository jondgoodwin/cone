// hornmesh: the sdf package's horn made into triangles on the CPU and drawn
// as a mesh. The horn hornmarch sphere-traces (3.4 long, 22 ribs, curled
// 1.7 radians) is meshed by surface nets at four levels of detail, cells of
// 0.01, 0.02, 0.04 and 0.08, into render's LodChain, and turns under the
// dusk sky in render's chitin (PbrMaterial.chitin: a dark rough base, a
// clear coat, a thin film whose thickness is warped noise drifting with
// time), lit by the sun and the sky's image-based lighting, bloomed and
// tone-mapped (AgX). The camera, the turn and the chitin's numbers are
// hornmarch's, so the two examples' frames line up; the mesh has no
// shadows and no ambient occlusion, which hornmarch traces through the
// field.
//
//   congo run --release packages/sdf/examples/hornmesh.cone
//   congo run --release packages/sdf/examples/hornmesh.cone -- --frames 120 --screenshot mesh.bmp --obj horn
//
// Keys:
//   L            the level drawn: by the horn's size on the screen, then 0 to 3
//   F            the film on or off
//   Escape       quit; F11 fullscreen
//
// It prints each level's cells, vertices, triangles, how many distances the
// sparse pass asked (against the grid's samples) and how long the meshing
// took, and each level's hash (meshHash): the same on every run. '--obj
// PREFIX' writes the levels as PREFIX-lod0.obj to PREFIX-lod3.obj.
//
// '--frames N' (or HORNMESH_FRAMES) draws N frames and stops; otherwise it
// runs until quit. Time is the frame's number over 60 (seconds), so a run of
// N frames is the same every time; eight frames after the check such a run
// makes the window smaller, so it draws at two sizes under validation. At
// frame CHECK_FRAME (or the last, if sooner) it draws level 0 and reads the
// frame back: the sky above is dusk (bluer than red), and the horn is drawn
// where the middle of its arc falls, unlike the sky at the screen's edge on
// that row. '--screenshot FILE' writes that frame to FILE as a BMP, and the
// next four beside it: levels 1, 2 and 3 ('-lod1', '-lod2', '-lod3') and
// level 0 with no film ('-nofilm'). After the run it draws BENCH_FRAMES
// frames more of level 0 into an offscreen target of 1920 x 1080, as fast as
// the GPU goes, and prints their mean time. It exits 0 only if every check
// passed, no Vulkan call failed and the validation layer said nothing.
//
// It needs a display, a GPU driver with Vulkan 1.3, SDL3.lib on LIB to link
// (Congo copies SDL3.dll from beside it to beside the program); with the
// Vulkan SDK, validation is on. GPU_POWER_PREFERENCE=low-power picks an
// integrated GPU where there are two.

mod hornmesh;

import stdio use *;
import libc;
import sdl;
import collections use *;
import geomath use *;
import mesh;
import gpu use *;
import render use *;
import window use *;
import sdf use *;
import sdfmesh use *;

const CHECK_FRAME = 90;
const BENCH_FRAMES = 120;
const LEVELS = 4u32;
const KEY_F = 102u32;
const KEY_L = 108u32;

// The horn, as hornmarch has it; moved 1.1 along -x so it turns about its
// middle
const LENGTH f32 = 3.4;
const BASE f32 = 0.34;
const TAPER f32 = 0.97;
const CURL f32 = 1.7;
const RIBS = 22;
const RIB_DEPTH f32 = 0.12;
const OFFSET f32 = 1.1;

// The meshes: level 0's cells, each next level's twice as large, each
// vertex relaxed onto the surface once
const FINEST f32 = 0.01;
const RELAX = 1u32;

// The camera, hornmarch's
fn eye() Vec3 { new Vec3(0., 1.35, 6.2); }
fn target() Vec3 { new Vec3(0., 1.05, 0.); }

// ---- Arguments ----

fn parseCount(s *u8) i32 {
  if (s as usize) == 0usize or *s == 0u8 { return -1; }
  mut n = 0;
  mut i = 0usize;
  while *(s + i) != 0u8 {
    imm c = *(s + i);
    if c < '0' or c > '9' { return -1; }
    n = n * 10 + i32.from(c - '0');
    i = i + 1usize;
  }
  n;
}

fn cstrEquals(a *u8, b &Array[u8]) bool {
  mut i = 0usize;
  while i < b.len {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len) == 0u8;
}

fn appendCstr(s &mut String, c *u8) {
  mut i = 0usize;
  while *(c + i) != 0u8 {
    s.appendByte(*(c + i));
    i = i + 1usize;
  }
}

fn onOff(on bool) &str {
  if on { return "on"; }
  "off";
}

// 'base' without its '.bmp', then 'suffix' and '.bmp'
fn shotName(base &String, suffix &Array[u8]) String {
  mut s = String.empty();
  if base.endsWith(".bmp") { s = base.sub(0usize, base.len() - 4usize); } else { s = base.copy(); }
  s <- suffix;
  s <- ".bmp";
  s;
}

// ---- The scene ----

// The horn's turn at time t: a quarter turn in 5 s, as hornmarch's
fn turnAt(t f32) Quat { Quat.angleAxis(t * 0.3, new Vec3(0., 1., 0.)); }

// The horn's model matrix: its own point p goes to turn (p - (OFFSET, 0, 0))
fn modelAt(turn Quat) Mat4 {
  Mat4.fromTrs(new Vec3(0., 0., 0.), turn, new Vec3(1., 1., 1.)) * Mat4.fromTranslation(new Vec3(0. - OFFSET, 0., 0.));
}

// ---- The check ----

fn pixelOf(viewProjection Mat4, p Vec3, w u32, h u32, x &mut i32, y &mut i32) {
  imm clip = viewProjection * new Vec4(p.x, p.y, p.z, 1.);
  *x = i32.from((clip.x / clip.w + 1.) * 0.5 * f32.from(w));
  *y = i32.from((1. - clip.y / clip.w) * 0.5 * f32.from(h));
}

fn channel(p *u8, w u32, x i32, y i32, c usize, bgra bool) i32 {
  mut at = c;
  if bgra { at = 2usize - c; }
  i32.from(*(p + (usize.from(y) * usize.from(w) + usize.from(x)) * 4usize + at));
}

fn luma(p *u8, w u32, x i32, y i32, bgra bool) i32 {
  channel(p, w, x, y, 0usize, bgra) + channel(p, w, x, y, 1usize, bgra) + channel(p, w, x, y, 2usize, bgra);
}

fn printPixel(name &str, p *u8, w u32, x i32, y i32, bgra bool) {
  printStr(name); print <- " at ("; print <- x; print <- ", "; print <- y; print <- "): ";
  print <- channel(p, w, x, y, 0usize, bgra); print <- " "; print <- channel(p, w, x, y, 1usize, bgra); print <- " ";
  print <- channel(p, w, x, y, 2usize, bgra);
}

// ---- The demo ----

fn main(argc i32, argv **u8) i32 {
  mut maxFrames = 0;
  mut screenshot = String.empty();
  mut objPrefix = String.empty();
  imm env = libc.getenv("HORNMESH_FRAMES");
  if (env as usize) != 0usize { maxFrames = parseCount(env); }
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--frames") and a + 1 < argc {
      maxFrames = parseCount(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--screenshot") and a + 1 < argc {
      appendCstr(&mut screenshot, *(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--obj") and a + 1 < argc {
      appendCstr(&mut objPrefix, *(argv + usize.from(a + 1)));
      a = a + 1;
    } else {
      print <- "Unknown argument; use --frames N, --screenshot FILE and --obj PREFIX\n";
      return 2;
    }
    a = a + 1;
  }
  if maxFrames < 0 {
    print <- "--frames wants a whole number\n";
    return 2;
  }
  mut checkFrame = CHECK_FRAME;
  if maxFrames > 0 and maxFrames - 1 < checkFrame { checkFrame = maxFrames - 1; }

  // The horn, meshed
  imm frequency = f64.from(sdl.GetPerformanceFrequency());
  imm horn = Horn.make(LENGTH, BASE, TAPER, CURL, RIBS, RIB_DEPTH);
  imm box = horn.bounds();
  mut meshes = List[mesh.Mesh].empty();
  mut cell = FINEST;
  mut level = 0u32;
  while level < LEVELS {
    imm started = sdl.GetPerformanceCounter();
    imm net = surfaceNet(&horn, box, cell, RELAX, true);
    imm m = net.toMesh();
    imm ms = f64.from(sdl.GetPerformanceCounter() - started) / frequency * 1000.;
    imm samples = u64.from(net.cellsX + 1u32) * u64.from(net.cellsY + 1u32) * u64.from(net.cellsZ + 1u32);
    print <- "Level "; print <- u64.from(level); print <- ": cells of "; print <- cell; print <- " ("; print <- u64.from(net.cellsX);
    print <- " x "; print <- u64.from(net.cellsY); print <- " x "; print <- u64.from(net.cellsZ); print <- "), ";
    print <- m.vertexCount(); print <- " vertices, "; print <- m.triangleCount(); print <- " triangles; ";
    print <- net.sampled; print <- " of "; print <- samples; print <- " samples evaluated ("; print <- u64.from(net.blocksSkipped);
    print <- " of "; print <- u64.from(net.blocks); print <- " blocks skipped), "; print <- net.evaluations;
    print <- " distances in all; "; print <- ms; print <- " ms; hash ";
    print <- u64.from(mesh.meshHash(&m)); print <- "\n";
    if objPrefix.len() > 0usize {
      mut name = objPrefix.copy();
      name <- "-lod";
      name.appendByte(u8.from('0') + u8.from(level));
      name <- ".obj";
      imm written = mesh.writeObj(&m, name.view());
      print <- "  written to "; printStr(name.view());
      if written { print <- "\n"; } else { print <- " FAILED\n"; }
    }
    meshes.push(m);
    cell = cell * 2.;
    level = level + 1u32;
  }

  mut win = Window.openVulkan("Cone: the sdf horn, meshed");
  if !win.isOpen() {
    print <- "No window could be opened\n";
    return 1;
  }
  mut instance = Instance.create("hornmesh");
  if !instance.isValid() {
    print <- "No Vulkan 1.3 instance could be made\n";
    return 1;
  }
  mut surface = instance.createSurface(win.sdlHandle());
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm powerEnv = libc.getenv("GPU_POWER_PREFERENCE");
  if (powerEnv as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(powerEnv), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&surface, preference);
  if !adapter.isValid() {
    print <- "No GPU can draw to the window\n";
    return 1;
  }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  print <- "Validation layer: "; printStr(onOff(instance.validation));
  print <- "; synchronization validation: "; printStr(onOff(instance.syncValidation)); print <- "\n";
  mut device = adapter.requestDevice();
  imm size = win.size();
  mut swapchain = device.createSwapChain(&surface, u32.from(size.w), u32.from(size.h), TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, swapchain.format, u32.from(size.w), u32.from(size.h));
  if !renderer.isValid() or !post.isValid() {
    print <- "The renderer could not be made\n";
    return 1;
  }
  imm sky = Sky.dusk(radians(6.), radians(25.));
  renderer.setSky(&mut device, &sky);
  imm light = sky.sunLight(new Color(2.0, 0.95, 0.45, 1.), new Color(0.05, 0.05, 0.08, 1.));

  // The levels, each drawn while the horn is at least so many pixels
  // across: level 0 above 500, 1 above 250, 2 above 120, 3 below
  mut chain = LodChain.empty(0.1);
  imm minSizes Array[f32, 4] = [500., 250., 120., 0.];
  mut i = 0usize;
  while i < meshes.len() {
    chain.add(renderer.addMesh(&mut device, meshes[i]), minSizes[i]);
    i = i + 1usize;
  }
  mut chitin = PbrMaterial.chitin(180., 520., 7u32);
  imm chitinM = renderer.addPbrMaterial(&mut device, &chitin);

  mut camera = Camera.make();
  camera.fov = radians(40.);
  camera.near = 0.3;
  camera.far = 100.;
  camera.background = new Color(0., 0., 0., 1.);
  camera.lookAt(eye(), target(), new Vec3(0., 1., 0.));
  // The horn's middle and a ball holding it, for its size on the screen
  imm boxCentre = box.center();
  imm boxRadius = box.halfExtents().length();

  mut list = DrawList.empty();
  mut frames = 0;
  mut unshown = 0;
  mut checked = false;
  mut checksPassed = true;
  mut shotsWritten = true;
  mut extraShot = 0;             // after the checked one: levels 1, 2, 3, then no film
  mut film = true;
  mut forced = -1;               // the level L chose, or -1: by size
  mut firstTimed = 0u64;
  mut lastTimed = 0u64;
  mut lastTimedFrame = 0;
  while win.running and (maxFrames == 0 or frames < maxFrames) {
    mut event = sdl.Event.empty();
    while win.pollEvent(&mut event) {
      imm key = keyDown(&event);
      if key == KEY_F { film = !film; }
      if key == KEY_L {
        forced = forced + 1;
        if forced >= i32.from(LEVELS) { forced = -1; }
        print <- "Level: "; if forced < 0 { print <- "by size\n"; } else { print <- forced; print <- "\n"; }
      }
    }
    imm shooting = screenshot.len() > 0usize and checked and extraShot < 4;
    mut drawLevel = forced;
    if maxFrames > 0 and frames == checkFrame and !checked { drawLevel = 0; }
    if shooting {
      drawLevel = if extraShot < 3 { extraShot + 1; } else { 0; };
      film = extraShot != 3;
    } elif screenshot.len() > 0usize and extraShot == 4 {
      film = true;
      extraShot = 5;
    }
    if chitin.film != film {
      chitin.film = film;
      renderer.setPbrMaterial(&mut device, chitinM, &chitin);
    }
    if maxFrames > 0 and frames == checkFrame + 8 { win.setSize(size.w * 2 / 3, size.h * 2 / 3); }
    if win.resized {
      imm s = win.size();
      swapchain.resize(u32.from(s.w), u32.from(s.h));
      win.resized = false;
    }
    imm frame = swapchain.getCurrentTexture(&mut device);
    if !frame.ok() {
      sdl.Delay(10u32);
    } else {
      imm started = sdl.GetPerformanceCounter();
      imm w = frame.texture.width;
      imm h = frame.texture.height;
      imm t = f32.from(frames) / 60.;
      renderer.time = t;
      post.resize(&mut device, w, h);
      imm turn = turnAt(t);
      imm model = modelAt(turn);
      if drawLevel < 0 {
        chain.selectBySize(camera.projectedSize(model * boxCentre, boxRadius, f32.from(h)));
      } else {
        chain.select(usize.from(drawLevel));
      }
      list.clear();
      list.add(chain.mesh(), chitinM, model);

      mut encoder = device.createCommandEncoder();
      renderer.render(&mut device, &mut encoder, &post.hdr, &frame.depth, &camera, &light, &list);
      post.apply(&mut encoder, &frame.texture);
      imm bgra = frame.texture.format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB
        or frame.texture.format == TEXTURE_FORMAT_BGRA8_UNORM;
      imm checkNow = frames == checkFrame and !checked;
      if checkNow or shooting {
        mut readback = device.createBuffer(u64.from(w) * u64.from(h) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
        encoder.copyTextureToBuffer(&frame.texture, &readback);
        device.queue.submit(encoder.finish());
        if !swapchain.present(&mut device) { unshown = unshown + 1; }
        device.waitIdle();
        imm p = readback.mappedRange();
        if checkNow {
          checked = true;
          print <- "Frame "; print <- frames; print <- " ("; print <- u64.from(w); print <- " x "; print <- u64.from(h);
          print <- "), level "; print <- chain.current; print <- ", "; print <- renderer.triangles; print <- " triangles:\n";
          imm tx = i32.from(w / 2u32);
          imm ty = i32.from(h / 30u32);
          printPixel("  the sky above", p, w, tx, ty, bgra);
          imm high = channel(p, w, tx, ty, 2usize, bgra) > channel(p, w, tx, ty, 0usize, bgra);
          if high { print <- ": bluer than red\n"; } else { print <- ": NOT bluer than red\n"; checksPassed = false; }
          imm viewProjection = camera.projectionMatrix(f32.from(w) / f32.from(h)) * camera.viewMatrix();
          mut hx = 0;
          mut hy = 0;
          pixelOf(viewProjection, model * horn.arc.point(LENGTH * 0.5), w, h, &mut hx, &mut hy);
          if hx < 0 or hy < 0 or hx >= i32.from(w) or hy >= i32.from(h) {
            print <- "  the horn: off the screen\n";
            checksPassed = false;
          } else {
            printPixel("  the horn", p, w, hx, hy, bgra);
            imm sx = i32.from(w / 20u32);
            imm d = luma(p, w, hx, hy, bgra) - luma(p, w, sx, hy, bgra);
            if d > 30 or d < -30 { print <- ": drawn, unlike the sky at the edge\n"; }
            else { print <- ": NOT unlike the sky at the edge\n"; checksPassed = false; }
          }
          if screenshot.len() > 0usize {
            imm shot = Image.fromTexels(p, i32.from(w), i32.from(h), bgra);
            imm written = shot.save(screenshot.view());
            print <- "Screenshot: "; printStr(screenshot.view());
            if written { print <- "\n"; } else { print <- " could NOT be written\n"; shotsWritten = false; }
          }
        } else {
          imm suffixes Array[&Array[u8], 4] = ["-lod1", "-lod2", "-lod3", "-nofilm"];
          imm name = shotName(&screenshot, suffixes[usize.from(extraShot)]);
          imm shot = Image.fromTexels(p, i32.from(w), i32.from(h), bgra);
          imm written = shot.save(name.view());
          print <- "Screenshot: "; printStr(name.view()); print <- " (level "; print <- chain.current; print <- ", ";
          print <- renderer.triangles; print <- " triangles)";
          if written { print <- "\n"; } else { print <- " could NOT be written\n"; shotsWritten = false; }
          extraShot = extraShot + 1;
        }
      } else {
        device.queue.submit(encoder.finish());
        if !swapchain.present(&mut device) { unshown = unshown + 1; }
        if frames >= 10 {
          if firstTimed == 0u64 { firstTimed = started; }
          lastTimed = started;
          lastTimedFrame = frames;
        }
      }
      frames = frames + 1;
    }
  }
  device.waitIdle();

  print <- "Frames drawn: "; print <- frames; print <- "; presented: "; print <- swapchain.presents;
  print <- "; out of date when presented: "; print <- unshown; print <- "\n";
  if lastTimedFrame > 12 and lastTimed > firstTimed {
    imm frameMs = f64.from(lastTimed - firstTimed) / frequency * 1000. / f64.from(lastTimedFrame - 10);
    print <- "Frame time: "; print <- frameMs; print <- " ms a frame (presented in step with the display)\n";
  }

  // The GPU's cost of a frame of level 0 at 1080p, drawn offscreen, nothing
  // presented
  if frames > 0 {
    imm w = 1920u32;
    imm h = 1080u32;
    imm targetDesc = new TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_RENDER_ATTACHMENT);
    mut target = device.createTexture(&targetDesc);
    imm depthDesc = new TextureDescriptor(w, h, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
    mut depth = device.createTexture(&depthDesc);
    mut benchPost = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, w, h);
    if !chitin.film {
      chitin.film = true;
      renderer.setPbrMaterial(&mut device, chitinM, &chitin);
    }
    chain.select(0usize);
    device.waitIdle();
    imm benchStart = sdl.GetPerformanceCounter();
    mut b = 0;
    while b < BENCH_FRAMES {
      imm t = f32.from(frames + b) / 60.;
      renderer.time = t;
      list.clear();
      list.add(chain.mesh(), chitinM, modelAt(turnAt(t)));
      mut encoder = device.createCommandEncoder();
      renderer.render(&mut device, &mut encoder, &benchPost.hdr, &depth, &camera, &light, &list);
      benchPost.apply(&mut encoder, &target);
      device.queue.submit(encoder.finish());
      device.endFrame();
      b = b + 1;
    }
    device.waitIdle();
    imm benchMs = f64.from(sdl.GetPerformanceCounter() - benchStart) / frequency * 1000. / f64.from(BENCH_FRAMES);
    print <- "GPU frame time, level 0, offscreen at 1920 x 1080: "; print <- benchMs; print <- " ms a frame (";
    print <- BENCH_FRAMES; print <- " frames, nothing presented)\n";
  }

  print <- "Vulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  if !checked { print <- "The frame was not checked\n"; }
  if (checked and !checksPassed) or !shotsWritten {
    print <- "FAILED\n";
    return 1;
  }
  if failures() != 0u32 or validationMessages() != 0u32 { return 1; }
  print <- "OK\n";
  0;
}
