// starship: Elizabeth's "Starship 1", the skeletal dragon ship, roughly
// reproduced as signed distance fields composed from the sdf package's
// primitives, meshed on the CPU by surface nets and drawn offscreen against
// stars and a red planet. Nothing here is in the library: this file is the
// whole description of the ship.
//
//   congo run --release packages/sdf/examples/starship.cone
//   congo run --release packages/sdf/examples/starship.cone -- --shots DIR/ship --obj DIR/ship
//
// THE SHIP, part by part, as the artist's procedure names them (the part
// table is Demos\starship\artist\parts.md in the design corpus; x runs from
// the snout to the tail, y is up, the wings reach along z; every part is
// mirrored across z = 0):
// - the gesture: one S-curve, traced on the reference at twelve points and
//   back-projected through the fitted camera onto the mid-plane: the head
//   dips, the neck rises in a C to a crest over the shoulders, the torso
//   falls straight, the tail lifts to a lance;
// - a lean core, a chain of tapered capsules along it;
// - over the neck, the rib comb: 18 slender round ribs arching out and
//   sweeping back, graded (their period and radius measured); along the
//   back, a dorsal ridge of knobs and paired processes; along the tail's
//   top, a fin comb of tall thin spines shrinking to the lance (all in
//   repeatAlongCells over the spine);
// - three strands a side along the flanks;
// - the lance: smooth, with a collar and two barbs where the comb ends;
// - the head: a long narrow armoured snout; the maw cut into its front and
//   ringed with amber lights; two mandibles curving forward past it;
// - the belly: a gondola of knotted lumps under the chest;
// - the shoulder: three bosses and a tall hooked horn;
// - each wing a FRAME: the main spar to the tip (carrying the lights), an
//   inner ridge-bone beside it, an upper spar along the top edge with
//   hooked spikes, a rear spar from the tip back up to a tall spike, two
//   cross-bones; and the membrane, taut triangles in the frame's panels,
//   scalloped between the spikes, meshed apart in a darker material;
// - over all of it, a faint relief of ridged fBm.
// The lights (the wings' strips, the head's pairs, the belly's specks, the
// maw's ring) are small spheres in an over-bright Blinn-Phong material, so
// they bloom.
//
// '--shots PREFIX' (default 'starship') writes PREFIX-hero.bmp (framed as
// the reference), PREFIX-side.bmp and PREFIX-front.bmp at 1920 x 1080;
// '--obj PREFIX' writes PREFIX-frame-lod0.obj, PREFIX-membrane-lod0.obj and
// the coarser levels.
//
// For measuring against the reference (tools/refmeasure):
// '--camera ex,ey,ez,tx,ty,tz,ux,uy,uz,fov' (repeatable) takes a shot from
// the eye (ex, ey, ez) looking at (tx, ty, tz) with (ux, uy, uz) up and a
// vertical field of view of 'fov' degrees, PREFIX-cam0.bmp, -cam1 and on,
// instead of the three shots; '--mask' writes beside each shot its
// silhouette, PREFIX-...-mask.bmp: the ship white (its lights too) on
// black, with no sky, stars, planet, bloom or tone mapping; '--coarse'
// meshes and draws only the coarser level, several times faster; '--size
// WxH' takes the shots W by H (W a multiple of 64) instead; '--without
// NAME' (repeatable) leaves one part out, for measuring what it is worth:
// gesture (the spine straightened), core, ribs, belly, ridge, spars,
// membrane, spikes, shoulder, fins, lance, head, maw, lights, strands,
// relief. It prints each mesh's counts, time and meshHash (the same every
// run: meshing is on the CPU), and exits 0 only if the hashes are the
// pinned ones (with every part drawn), every shot was written, no Vulkan
// call failed and the validation layer said nothing.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll on PATH (and SDL3.lib
// on LIB to link); no window and no display. GPU_POWER_PREFERENCE=low-power
// picks an integrated GPU where there are two.

mod starship;

import stdio use *;
import libc;
import sdl;
import collections use *;
import geomath use *;
import mesh;
import noise;
import sculpt;
import gpu use *;
import render use *;
import sdf use *;

// ---- The numbers ----

const SEGMENTS = 40;                // the body's polyline
const VERTEBRAE = 56;
const SEED = 1977u32;
const MEMBRANE f32 = 0.045;         // the membrane's half-thickness
const RELIEF f32 = 0.012;           // the relief on the frame, per unit of ridged fBm
const MEMBRANE_RELIEF f32 = 0.008;  // and on the membranes
const GRAIN f32 = 9.;               // its first octave's frequency
const STRETCH f32 = 0.4;            // its grain: features 1 / STRETCH times longer along x
const LEVELS = 2usize;
const FINEST f32 = 0.03;
// Each mesh's meshHash: the frame's levels, then the membrane's
imm PINNED Array[u32, 4] = [0x7a976e45u32, 0x87ff6630u32, 0xecb59af6u32, 0x6ff2c475u32];
imm PARTS Array[&[]u8, 2] = ["frame", "membrane"];
const WIDTH = 1920u32;
const HEIGHT = 1080u32;

// The parts, one bit each in this order, so any can be left out
imm PART_NAMES Array[&[]u8, 16] = ["gesture", "core", "ribs", "belly", "ridge", "spars", "membrane", "spikes",
  "shoulder", "fins", "lance", "head", "maw", "lights", "strands", "relief"];
const GESTURE = 1u32;
const CORE = 2u32;
const RIBS = 4u32;
const BELLY = 8u32;
const RIDGE = 16u32;
const SPARS = 32u32;
const SKIN = 64u32;
const SPIKES = 128u32;
const SHOULDER = 256u32;
const FINS = 512u32;
const LANCE = 1024u32;
const HEAD = 2048u32;
const MAW = 4096u32;
const LIGHTS = 8192u32;
const STRANDS = 16384u32;
const TEXTURE = 32768u32;
const ALL = 65535u32;

fn v(x f32, y f32, z f32) Vec3 { new Vec3(x, y, z); }
fn absf(a f32) f32 { libc.fabsf(a); }
fn minf(a f32, b f32) f32 { if a < b { a; } else { b; }; }
fn maxf(a f32, b f32) f32 { if a > b { a; } else { b; }; }
fn jitter(i i32, salt u32) f32 { noise.toSigned(noise.hash1(i, SEED + salt)); }

extern {
  fn @c("atof") atof(s *u8) f64;
}

// ---- The gesture: the line of action, an S ----

// The dorsal line, traced on the reference at twelve points and
// back-projected through the fitted camera onto the mid-plane: the snout,
// the head, the neck rising in a C to a crest over the shoulders (y 1.95),
// the torso falling straight, the tail's trough and the lance lifting
imm SPX Array[f32, 12] = [-0.73, -0.08, 0.72, 1.6, 2.65, 3.77, 5.28, 7.14, 8.88, 10.6, 11.94, 13.31];
imm SPY Array[f32, 12] = [-0.26, -0.03, 0.41, 1.16, 1.8, 1.95, 1.53, 0.98, 0.67, 0.66, 0.91, 1.17];

// Control point i; without the gesture, on the straight line from the
// first to the last
fn ctrl(i usize, straight Bool) Vec3 {
  if straight { return v(SPX[i], SPY[0usize] + (SPY[11usize] - SPY[0usize]) * (SPX[i] - SPX[0usize]) / (SPX[11usize] - SPX[0usize]), 0.); }
  v(SPX[i], SPY[i], 0.);
}

// Catmull-Rom between b and c
fn catmull(a Vec3, b Vec3, c Vec3, d Vec3, t f32) Vec3 {
  imm t2 = t * t;
  ((b * 2.) + (c - a) * t + (a * 2. - b * 5. + c * 4. - d) * t2 + (b * 3. - a - c * 3. + d) * (t2 * t)) * 0.5;
}

// The body's spine at t, 0 (the head, control point 1) to 1 (where the
// lance begins, control point 9)
fn spineAt(t f32, straight Bool) Vec3 {
  imm s = t * 8.;
  mut k = usize.from(i32.from(s));
  if k > 7usize { k = 7usize; }
  catmull(ctrl(k, straight), ctrl(k + 1usize, straight), ctrl(k + 2usize, straight), ctrl(k + 3usize, straight), s - f32.from(k));
}

// The core's radius at t: lean (about a third of the mask's envelope; the
// ribs, belly and wings make the rest), a neck, a chest at 0.62, a tail
fn radiusAt(t f32) f32 {
  imm c = (t - 0.62) / 0.15;
  0.16 + 0.1 * minf(t / 0.45, 1.) + 0.14 * libc.expf(0. - c * c) - 0.1 * maxf(0., (t - 0.75) / 0.25);
}

// Whether a part held by the ball 'r' about 'c' can change 'd' by a smooth
// union reaching 'k' (the quadratic smooth minimum blends only within 4k,
// so skipping a part that cannot leaves the union exactly as it is)
fn near(p Vec3, c Vec3, r f32, d f32, k f32) Bool { (p - c).length() - r < d + 4. * k; }

// Two tapered capsules end to end, through a, b and c
fn chain(p Vec3, a Vec3, b Vec3, c Vec3, r0 f32, r1 f32, r2 f32) f32 {
  minf(taperedCapsule(p, a, b, r0, r1), taperedCapsule(p, b, c, r1, r2));
}

// ---- The relief: ridged fBm added near the surface ----

// 'd' raised by 'amp' times ridged fBm (three octaves from GRAIN, gain 0.6);
// within 4 amp of the surface only
fn relief(p Vec3, d f32, amp f32, seed u32) f32 {
  if absf(d) > 4. * amp { return d; }
  d - amp * noise.ridged3(v(p.x * STRETCH, p.y, p.z) * GRAIN, SEED + seed, 3, 2., 0.6).value;
}

// ---- The vertebrae: the rib comb, the dorsal ridge and the fin comb ----

struct Vertebrae {
  pub up f32;            // +1 or -1: which way the frames' up axis points from the back
  pub swap Bool;         // up is the frames' binormal (else their normal)
  pub radius List[f32];  // the core's radius at each copy, found once
  pub has u32;           // the parts drawn

  pub fn repeatedDistance(self &, q Vec3, index i32, u f32) f32 {
    imm r = *radius[usize.from(index)];
    // Out to the side (mirrored), up and along (towards the tail), in the copy's frame
    imm l = if swap { v(absf(q.x), q.y * self.up, q.z); } else { v(absf(q.y), q.x * self.up, q.z); };
    mut d f32 = 3.4028235e38;
    // The dorsal ridge: a knob on the back, and over the torso a pair of
    // short processes
    if (has & RIDGE) != 0u32 {
      d = capsule(l, v(0., r * 0.85, -0.05), v(0., r * 0.85, 0.05), 0.03 + r * 0.25);
      if u > 0.42 and u < 0.8 {
        d = smoothUnion(d, taperedCapsule(l, v(r * 0.3, r * 0.8, 0.), v(r * 0.45, r + 0.18, 0.08), 0.04, 0.01), 0.02);
      }
    }
    // The rib comb over the neck: 18 slender round ribs (period 0.21 units,
    // radius 0.028, both measured), arching out from the spine and sweeping
    // back and down, their length graded, longest mid-neck
    if (has & RIBS) != 0u32 and u > 0.04 and u < 0.42 {
      imm g = sin(3.14159 * (u - 0.04) / 0.38);
      imm len = 0.45 + 0.5 * g;
      imm rr = 0.045;
      imm a = v(r * 0.3, r * 0.8, 0.);
      imm b = v(r + 0.5 * len, r * 0.6, 0.15 * len);
      imm c = v(r + 0.8 * len, -0.1 * len, 0.5 * len);
      d = smoothUnion(d, chain(l, a, b, c, rr * 1.2, rr, rr * 0.4), 0.02);
    }
    // The fin comb along the tail's top: tall thin spines swept back,
    // close-set, shrinking towards the lance (the period, 15 px, measured
    // irregular, so each one's height is jittered)
    if (has & FINS) != 0u32 and u > 0.62 and u < 0.99 {
      imm f = (u - 0.62) / 0.37;
      imm h = (0.75 - 0.55 * f) * (1. + 0.3 * jitter(index, 1u32));
      d = minf(d, taperedCapsule(l, v(0., r * 0.8, 0.), v(0., r + h, 0.7 * h), 0.035, 0.004));
    }
    d;
  }

  pub fn bound(self &, index i32, u f32) f32 {
    imm r = *radius[usize.from(index)];
    r + 1.4;
  }
}

// ---- The ship ----

struct Ship {
  pub spine List[Vec3];
  pub radii List[f32];
  pub cells CurveCells;
  pub vertebrae Vertebrae;
  // The wing on +z, its joints back-projected from the reference through
  // the fitted camera onto the wing's plane, in the order below; the three
  // roots then moved up and in to meet the torso's side (the squint showed
  // a gap between the body and the wing)
  pub wing List[Vec3];
  pub has u32;           // the parts drawn
  pub membrane Bool;     // the membranes alone, or everything else

  pub fn make(membrane Bool, has u32) Ship {
    imm straight = (has & GESTURE) == 0u32;
    mut spine = List[Vec3].empty();
    mut radii = List[f32].empty();
    mut i = 0;
    while i <= SEGMENTS {
      imm t = f32.from(i) / f32.from(SEGMENTS);
      spine.push(spineAt(t, straight));
      radii.push(radiusAt(t));
      i = i + 1;
    }
    imm path = sculpt.Path.fromPoints(spine.view(), false);
    imm curve = PathCurve.fromPath(&path);
    // Which of the frames' axes is up: the binormal on this path (the
    // side view showed the ribs standing up as a mane when the normal was
    // taken for up), and its sign
    imm f0 = curve.frameAt(0.);
    imm swap = absf(f0.binormal.y) > absf(f0.normal.y);
    imm upAxis = if swap { f0.binormal.y; } else { f0.normal.y; };
    imm up = if upAxis < 0. { -1.; } else { 1.; };
    mut radius = List[f32].empty();
    i = 0;
    while i < VERTEBRAE {
      radius.push(radiusAt((f32.from(i) + 0.5) / f32.from(VERTEBRAE)));
      i = i + 1;
    }
    mut wing = List[Vec3].empty();
    wing.push(v(5.4, 0.9, 0.45));      // 0 the main spar's root, in the torso's side
    wing.push(v(4.9, -0.85, 3.36));    // 1 the main spar, a third out
    wing.push(v(4.64, -1.32, 5.35));   // 2 two thirds out
    wing.push(v(3.42, -2.05, 7.76));   // 3 the tip
    wing.push(v(6.0, 0.8, 0.5));       // 4 the inner ridge-bone's root
    wing.push(v(5.11, -1.01, 4.32));   // 5 its middle
    wing.push(v(6.6, 1.0, 0.45));      // 6 the upper spar's root
    wing.push(v(7.29, -0.01, 1.48));   // 7 the upper spar
    wing.push(v(7.14, -0.32, 2.79));   // 8 its end
    wing.push(v(5.89, -1.16, 5.68));   // 9 the rear spar, from the tip back
    wing.push(v(7.26, -0.64, 4.41));   // 10 the rear spike's base
    wing.push(v(7.75, 0.1, 4.0));      // 11 the rear spike's point
    wing.push(v(4.82, -0.95, 3.76));   // 12, 13 a cross-bone, main spar to rear spar
    wing.push(v(6.75, -0.81, 4.78));
    wing.push(v(4.48, -1.37, 5.46));   // 14, 15 another
    wing.push(v(5.3, -1.38, 6.21));
    new Ship(spine, radii, curveCells(&curve, VERTEBRAE), new Vertebrae(up, swap, radius, has), wing, has, membrane);
  }

  pub fn w(self &, i usize) Vec3 { *wing[i]; }
  pub fn on(self &, part u32) Bool { (has & part) != 0u32; }
  pub fn straight(self &) Bool { (has & GESTURE) == 0u32; }

  // The core along the spine, and the strands along its flanks
  pub fn body(self &, q Vec3) f32 {
    mut d f32 = 3.4028235e38;
    mut i = 0usize;
    while i < usize.from(SEGMENTS) {
      imm a = *spine[i];
      imm b = *spine[i + 1usize];
      imm ra = *radii[i];
      imm rb = *radii[i + 1usize];
      if near(q, a, (b - a).length() + ra + 0.2, d, 0.06) {
        if self.on(CORE) { d = smoothUnion(d, taperedCapsule(q, a, b, ra, rb), 0.06); }
        // The strands along the flanks, three a side, behind the rib comb
        imm t = f32.from(i) / f32.from(SEGMENTS);
        if self.on(STRANDS) and t > 0.3 and t < 0.98 {
          imm low = taperedCapsule(q, a + v(0., ra * -0.35, ra * 0.95), b + v(0., rb * -0.35, rb * 0.95), 0.02 + ra * 0.16, 0.02 + rb * 0.16);
          imm high = taperedCapsule(q, a + v(0., ra * 0.5, ra * 0.75), b + v(0., rb * 0.5, rb * 0.75), 0.015 + ra * 0.1, 0.015 + rb * 0.1);
          imm under = taperedCapsule(q, a + v(0., ra * -0.85, ra * 0.5), b + v(0., rb * -0.85, rb * 0.5), 0.015 + ra * 0.12, 0.015 + rb * 0.12);
          d = smoothUnion(d, minf(minf(low, high), under), 0.03);
        }
      }
      i = i + 1usize;
    }
    d;
  }

  // The lance: smooth, continuing the spine to its point, a small collar
  // and two barbs where the comb ends
  pub fn lance(self &, q Vec3) f32 {
    imm a = ctrl(9usize, self.straight());
    imm b = ctrl(10usize, self.straight());
    imm c = ctrl(11usize, self.straight());
    mut d = chain(q, a, b, c, 0.16, 0.08, 0.006);
    imm dir = (b - a).normalize();
    d = smoothUnion(d, taperedCapsule(q, a - dir * 0.05, a + dir * 0.3, 0.24, 0.14), 0.04);
    d = minf(d, taperedCapsule(q, a + dir * 0.25 + v(0., 0., 0.12), a + dir * -0.15 + v(0., -0.3, 0.35), 0.05, 0.005));
    d;
  }

  // The head: a long narrow snout, armoured, tapering forward
  pub fn head(self &, q Vec3) f32 {
    imm n = ctrl(2usize, self.straight());
    imm h = ctrl(1usize, self.straight());
    imm s = ctrl(0usize, self.straight());
    mut d = chain(q, n, h, s, 0.22, 0.19, 0.11);
    // Armour: a ridge along the top and a plate either side
    d = smoothUnion(d, taperedCapsule(q, h + v(0.2, 0.2, 0.), s + v(0.1, 0.1, 0.), 0.07, 0.03), 0.04);
    d = smoothUnion(d, taperedCapsule(q, h + v(0., 0., 0.17), s + v(0.15, -0.02, 0.1), 0.08, 0.04), 0.04);
    d;
  }

  // The maw's dark slot, cut into the snout's front, and the mandibles:
  // two thin prongs from the jaw's sides curving forward past it
  pub fn maw(self &, q Vec3, d f32) f32 {
    imm s = ctrl(0usize, self.straight());
    mut e = smoothSubtract(d, sphere(q - (s + v(-0.06, -0.02, 0.)), 0.09), 0.02);
    e = smoothUnion(e, chain(q, s + v(0.75, -0.12, 0.2), s + v(0.15, -0.2, 0.3), s + v(-0.4, -0.18, 0.12), 0.05, 0.035, 0.006), 0.03);
    e;
  }

  // The belly: a gondola of knotted machinery under the chest
  pub fn belly(self &, q Vec3) f32 {
    mut d = ellipsoid(q - v(2.6, 0.95, 0.), v(0.55, 0.45, 0.45));
    d = smoothUnion(d, ellipsoid(q - v(3.4, 0.45, 0.), v(0.75, 0.75, 0.55)), 0.2);
    d = smoothUnion(d, ellipsoid(q - v(4.4, 0.05, 0.), v(0.75, 0.6, 0.5)), 0.2);
    d = smoothUnion(d, ellipsoid(q - v(5.2, 0.35, 0.), v(0.5, 0.45, 0.4)), 0.2);
    // Knots: a few lumps on its flanks
    mut k = 0;
    while k < 6 {
      imm x = 2.7 + 0.45 * f32.from(k);
      imm y = 0.75 - 0.25 * f32.from(k) + 0.1 * jitter(k, 3u32);
      d = smoothUnion(d, sphere(q - v(x, y, 0.4 + 0.08 * jitter(k, 4u32)), 0.17), 0.08);
      k = k + 1;
    }
    d;
  }

  // The shoulder: three bosses on the wing's root, and a tall hooked horn
  pub fn shoulder(self &, q Vec3) f32 {
    mut d = sphere(q - v(5.3, 0.35, 1.0), 0.3);
    d = smoothUnion(d, sphere(q - v(5.85, 0.9, 0.85), 0.28), 0.1);
    d = smoothUnion(d, sphere(q - v(6.57, 0.4, 0.95), 0.3), 0.1);
    d = smoothUnion(d, chain(q, v(6.5, 0.6, 0.9), v(7.1, 1.25, 1.0), v(7.9, 1.55, 0.9), 0.13, 0.07, 0.008), 0.05);
    d;
  }

  // The wing's frame: the main spar (armoured) to the tip, the inner
  // ridge-bone beside it, the upper spar along the top edge, the rear spar
  // from the tip back up to a tall spike, and two cross-bones
  pub fn spars(self &, q Vec3) f32 {
    mut b = chain(q, self.w(0usize), self.w(1usize), self.w(2usize), 0.15, 0.12, 0.09);
    b = minf(b, taperedCapsule(q, self.w(2usize), self.w(3usize), 0.09, 0.03));
    b = smoothUnion(b, chain(q, self.w(4usize), self.w(5usize), self.w(3usize).lerp(self.w(2usize), 0.15), 0.08, 0.06, 0.03), 0.03);
    b = smoothUnion(b, chain(q, self.w(6usize), self.w(7usize), self.w(8usize), 0.1, 0.08, 0.05), 0.03);
    b = smoothUnion(b, chain(q, self.w(3usize), self.w(9usize), self.w(10usize), 0.03, 0.06, 0.06), 0.03);
    b = minf(b, taperedCapsule(q, self.w(10usize), self.w(11usize), 0.06, 0.004));
    b = smoothUnion(b, taperedCapsule(q, self.w(12usize), self.w(13usize), 0.045, 0.035), 0.03);
    b = smoothUnion(b, taperedCapsule(q, self.w(14usize), self.w(15usize), 0.04, 0.03), 0.03);
    b;
  }

  // The hooked spikes along the upper spar, curving towards the tip
  pub fn spikes(self &, q Vec3) f32 {
    mut d f32 = 3.4028235e38;
    mut s = 0;
    while s < 3 {
      mut base = self.w(8usize);
      if s == 0 { base = self.w(6usize).lerp(self.w(7usize), 0.6); }
      if s == 1 { base = self.w(7usize).lerp(self.w(8usize), 0.5); }
      imm h = 0.5 - 0.08 * f32.from(s);
      d = minf(d, chain(q, base, base + v(0.15 * h, 0.7 * h, 0.2 * h), base + v(0.55 * h, 1.0 * h, 0.5 * h), 0.06, 0.035, 0.004));
      s = s + 1;
    }
    d;
  }

  // The membrane: taut skin in the frame's panels, a fan of triangles from
  // the main spar's root, thickened; the top edge scalloped between the
  // spikes
  pub fn membraneAt(self &, q Vec3) f32 {
    imm r = self.w(0usize);
    mut m = minf(triangle(q, r, self.w(1usize), self.w(9usize)), triangle(q, self.w(1usize), self.w(3usize), self.w(9usize)));
    m = minf(m, minf(triangle(q, r, self.w(9usize), self.w(10usize)), triangle(q, r, self.w(10usize), self.w(8usize))));
    m = minf(m, minf(triangle(q, r, self.w(8usize), self.w(7usize)), triangle(q, r, self.w(7usize), self.w(6usize))));
    m = m - MEMBRANE;
    if self.on(SPIKES) {
      imm a = self.w(8usize);
      imm b = self.w(10usize);
      imm mid = (a + b) * 0.5;
      imm span = (b - a).length();
      imm out = (mid - r).normalize();
      m = smoothSubtract(m, sphere(q - (mid + out * (0.5 * span)), 0.58 * span), 0.02);
    }
    m;
  }

  pub fn distance(self &, p Vec3) f32 {
    imm q = v(p.x, p.y, absf(p.z));
    if membrane {
      if !self.on(SKIN) { return 1.; }
      imm m = self.membraneAt(q);
      if !self.on(TEXTURE) { return m; }
      return relief(p, m, MEMBRANE_RELIEF, 2u32);
    }
    mut d = self.body(q);
    // The vertebrae reach less than 1.5 from the spine
    if (has & (RIBS | RIDGE | FINS)) != 0u32 {
      mut axis f32 = 3.4028235e38;
      mut i = 0usize;
      while i < usize.from(SEGMENTS) {
        axis = minf(axis, capsule(q, *spine[i], *spine[i + 1usize], 0.));
        i = i + 1usize;
      }
      if axis - 1.5 < d { d = minf(d, repeatAlongCells(&cells, &vertebrae, p)); }
    }
    if self.on(LANCE) and near(q, v(12., 0.9, 0.), 2.2, d, 0.04) { d = smoothUnion(d, self.lance(q), 0.04); }
    if near(q, v(0., 0., 0.), 1.6, d, 0.05) {
      if self.on(HEAD) { d = smoothUnion(d, self.head(q), 0.05); }
      if self.on(MAW) { d = self.maw(q, d); }
    }
    if self.on(BELLY) and near(q, v(3.9, 0.4, 0.), 2.2, d, 0.2) { d = smoothUnion(d, self.belly(q), 0.2); }
    if self.on(SHOULDER) and near(q, v(6.5, 0.9, 1.), 1.8, d, 0.1) { d = smoothUnion(d, self.shoulder(q), 0.1); }
    if near(q, v(5.6, -0.8, 4.4), 4.6, d, 0.08) {
      if self.on(SPARS) { d = smoothUnion(d, self.spars(q), 0.08); }
      if self.on(SPIKES) { d = smoothUnion(d, self.spikes(q), 0.02); }
    }
    if !self.on(TEXTURE) { return d; }
    relief(p, d, RELIEF, 1u32);
  }

  // A box holding the ship, or the membranes
  pub fn bounds(self &) Aabb3 {
    if membrane { return new Aabb3(v(2.9, -2.6, -8.3), v(8.4, 1.0, 8.3)); }
    new Aabb3(v(-1.6, -2.7, -8.3), v(13.9, 3.2, 8.3));
  }
}

// ---- The lights: small bright spheres, (x, y, z, radius) ----

fn lights(ship &Ship) List[Vec4] {
  mut l = List[Vec4].empty();
  imm s = ctrl(0usize, ship.straight());
  imm h = ctrl(1usize, ship.straight());
  mut side = -1.;
  while side < 2. {
    if ship.on(LIGHTS) {
      // The strip along each wing's main spar: 31 (period 13 px, measured
      // regular), below its leading side
      mut k = 0;
      while k < 31 {
        imm along = (f32.from(k) + 0.5) / 31.;
        imm at = if along < 0.5 { ship.w(0usize).lerp(ship.w(1usize), along * 2.); }
          else { ship.w(1usize).lerp(ship.w(2usize), (along - 0.5) * 2.); };
        l.push(new Vec4(at.x - 0.14, at.y - 0.1, at.z * side, 0.028));
        k = k + 1;
      }
      // Amber lights in pairs along the head's sides
      mut e = 0;
      while e < 2 {
        imm at = s.lerp(h, 0.45 + 0.3 * f32.from(e)) + v(0., 0.06, 0.19);
        l.push(new Vec4(at.x, at.y, at.z * side, 0.045));
        e = e + 1;
      }
      // Warm specks on the belly
      e = 0;
      while e < 4 {
        imm at = v(2.9 + 0.55 * f32.from(e), 0.7 - 0.3 * f32.from(e), 0.62);
        l.push(new Vec4(at.x, at.y, at.z * side, 0.04));
        e = e + 1;
      }
    }
    side = side + 2.;
  }
  // The maw: a ring of amber lights round the snout's front
  if ship.on(MAW) {
    imm dir = (s - h).normalize();
    mut k = 0;
    while k < 8 {
      imm a = 6.2831853 * f32.from(k) / 8.;
      imm at = s + dir * -0.02 + v(0., 0.11 * cos(a), 0.11 * sin(a));
      l.push(new Vec4(at.x, at.y, at.z, 0.04));
      k = k + 1;
    }
    l.push(new Vec4(s.x + 0.02, s.y - 0.02, 0., 0.07));
  }
  l;
}

// ---- The stars: short segments far away ----

fn stars(group u32) List[Vec3] {
  mut s = List[Vec3].empty();
  mut i = 0;
  while i < 700 {
    imm h = noise.hash2(i, i32.from(group), SEED);
    imm z = noise.toSigned(h.x);
    imm a = noise.toUnit(h.y) * 6.2831853;
    imm r = (1. - z * z).sqrt();
    imm d = v(r * cos(a), z, r * sin(a)) * 300.;
    s.push(d);
    s.push(d + v(0.12, 0.12, 0.));
    i = i + 1;
  }
  s;
}

// ---- Arguments ----

fn cstrEquals(a *u8, b &[]u8) Bool {
  mut i = 0usize;
  while i < b.len {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len) == 0u8;
}

fn appendCstr(s &mut String, c *u8) {
  mut i = 0usize;
  while *(c + i) != 0u8 {
    s.appendByte(*(c + i));
    i = i + 1usize;
  }
}

// A count's digits at 'at', and where they stop
fn digits(at *u8, n &mut u32) *u8 {
  mut p = at;
  *n = 0u32;
  while *p >= u8.from('0') and *p <= u8.from('9') {
    *n = *n * 10u32 + u32.from(*p - u8.from('0'));
    p = p + 1usize;
  }
  p;
}

// The shots' size from '--size WxH'; false unless the width is a multiple
// of 64 (the readback's rows must be 256 bytes) and both are given
fn parseSize(text *u8, w &mut u32, h &mut u32) Bool {
  imm x = digits(text, w);
  if *x != u8.from('x') { return false; }
  imm end = digits(x + 1usize, h);
  *end == 0u8 and *w > 0u32 and *h > 0u32 and *w % 64u32 == 0u32;
}

// A camera from '--camera': ten numbers, comma-separated, into 'out' (the
// eye, the target, up, then the field of view in degrees); false unless
// there were ten
fn parseCamera(text *u8, out &mut Array[f32, 10]) Bool {
  mut at = text;
  mut n = 0usize;
  while n < 10usize {
    out[n] = f32.from(atof(at));
    n = n + 1usize;
    while *at != 0u8 and *at != u8.from(',') { at = at + 1usize; }
    if *at == 0u8 { return n == 10usize; }
    at = at + 1usize;
  }
  false;
}

// The bit of the part named 'text', or 0
fn partBit(text *u8) u32 {
  mut i = 0usize;
  while i < 16usize {
    if cstrEquals(text, PART_NAMES[i]) { return 1u32 << u32.from(i); }
    i = i + 1usize;
  }
  0u32;
}

// ---- The demo ----

fn main(argc i32, argv **u8) i32 {
  mut shots = String.empty();
  shots <- "starship";
  mut objPrefix = String.empty();
  mut cameras = List[Array[f32, 10]].empty();
  mut masks = false;
  mut first = 0usize;           // the finest level meshed
  mut width = WIDTH;
  mut height = HEIGHT;
  mut has = ALL;
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--mask") { masks = true; a = a + 1; continue; }
    if cstrEquals(arg, "--coarse") { first = 1usize; a = a + 1; continue; }
    if a + 1 >= argc { print <- "Missing the value after an argument\n"; return 2; }
    if cstrEquals(arg, "--size") {
      if !parseSize(*(argv + usize.from(a + 1)), &mut width, &mut height) { print <- "--size wants WxH, W a multiple of 64\n"; return 2; }
    }
    elif cstrEquals(arg, "--shots") { shots = String.empty(); appendCstr(&mut shots, *(argv + usize.from(a + 1))); }
    elif cstrEquals(arg, "--obj") { appendCstr(&mut objPrefix, *(argv + usize.from(a + 1))); }
    elif cstrEquals(arg, "--camera") {
      mut c = new Array[f32, 10] <- fill 0f;
      if !parseCamera(*(argv + usize.from(a + 1)), &mut c) { print <- "--camera wants ten numbers: ex,ey,ez,tx,ty,tz,ux,uy,uz,fov\n"; return 2; }
      cameras.push(c);
    }
    elif cstrEquals(arg, "--without") {
      imm bit = partBit(*(argv + usize.from(a + 1)));
      if bit == 0u32 { print <- "--without wants a part: gesture, core, ribs, belly, ridge, spars, membrane, spikes, shoulder, fins, lance, head, maw, lights, strands or relief\n"; return 2; }
      has = has & (ALL ^ bit);
    }
    else { print <- "Unknown argument; use --shots PREFIX, --obj PREFIX, --camera ..., --size WxH, --without PART, --mask and --coarse\n"; return 2; }
    a = a + 2;
  }

  // The frame and the membranes, each meshed at LEVELS levels
  mut meshes = List[mesh.Mesh].empty();
  mut ok = true;
  mut part = 0usize;
  while part < 2usize {
    imm ship = Ship.make(part == 1usize, has);
    mut cell = FINEST;
    mut level = 0usize;
    while level < first { cell = cell * 2.; level = level + 1usize; }
    while level < LEVELS {
      imm started = sdl.GetPerformanceCounter();
      imm net = surfaceNet(&ship, ship.bounds(), cell, 1u32, true);
      imm m = net.toMesh();
      imm h = meshHash(&m);
      printStr(PARTS[part]); print <- ", level "; print <- level; print <- ": cells of "; print <- cell; print <- ", ";
      print <- m.vertexCount(); print <- " vertices, "; print <- m.triangleCount(); print <- " triangles, ";
      print <- net.evaluations; print <- " distances, ";
      print <- f64.from(sdl.GetPerformanceCounter() - started) / f64.from(sdl.GetPerformanceFrequency()); print <- " s; hash ";
      mut hex = String.empty();
      hex.appendHex(u64.from(h), 8usize);
      printStr(hex.view());
      if h == PINNED[part * LEVELS + level] { print <- " (as pinned)\n"; } else { print <- " (NOT as pinned)\n"; ok = false; }
      if objPrefix.len() > 0usize {
        mut name = objPrefix.copy();
        name <- "-";
        name <- PARTS[part];
        name <- "-lod";
        name.appendByte(u8.from('0') + u8.from(level));
        name <- ".obj";
        if !mesh.writeObj(&m, name.view()) { print <- "Could NOT write "; printStr(name.view()); print <- "\n"; ok = false; }
      }
      meshes.push(m);
      cell = cell * 2.;
      level = level + 1usize;
    }
    part = part + 1usize;
  }
  if has != ALL { print <- "Parts left out, so the hashes are not the pinned ones\n"; }

  // The GPU, no window
  mut instance = Instance.create("starship");
  mut none = Surface.none();
  imm powerEnv = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  if (powerEnv as usize) != 0usize and libc.strcmp(powerEnv, &"low-power" as *u8) == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  mut adapter = instance.requestAdapter(&none, preference);
  if !instance.isValid() or !adapter.isValid() {
    print <- "No GPU can draw\n";
    return 1;
  }
  print <- "Adapter: "; printStr(adapter.name.view());
  if instance.validation { print <- "; validation on\n"; } else { print <- "; validation off\n"; }
  mut device = adapter.requestDevice();
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);

  // Space: black, the planet's dim red light from below (for the
  // image-based lighting), a cold sun low on the right, behind the ship
  mut sky = Sky.dusk(radians(30.), radians(22.));
  sky.sunColor = new Color(6., 6.5, 8., 1.);
  sky.zenith = new Color(0.001, 0.0012, 0.003, 1.);
  sky.horizon = new Color(0.006, 0.004, 0.005, 1.);
  sky.glow = new Color(0.02, 0.022, 0.03, 1.);
  sky.ground = new Color(0.01, 0.003, 0.002, 1.);
  sky.groundFade = 3.;
  renderer.setSky(&mut device, &sky);
  imm light = sky.sunLight(new Color(3.0, 3.2, 3.8, 1.), new Color(0.05, 0.05, 0.05, 1.));

  // The frame: blue-grey metal under a coat; the membrane darker and rougher
  mut metal = PbrMaterial.standard(new Color(0.11, 0.12, 0.16, 1.), 0.85, 0.35);
  metal.clearcoat = 0.6;
  metal.clearcoatRoughness = 0.12;
  imm frameM = renderer.addPbrMaterial(&mut device, &metal);
  imm leather = PbrMaterial.standard(new Color(0.035, 0.04, 0.065, 1.), 0.5, 0.6);
  imm membraneM = renderer.addPbrMaterial(&mut device, &leather);
  imm warm = Material.plain(new Color(160., 70., 20., 1.));
  imm glowWarm = renderer.addMaterial(&mut device, &warm);
  imm blue = Material.plain(new Color(50., 60., 200., 1.));
  imm glowBlue = renderer.addMaterial(&mut device, &blue);
  imm frameMesh = renderer.addMesh(&mut device, meshes[0usize]);
  // Without the membrane its mesh is empty, and is not drawn
  imm skin = meshes[LEVELS - first].triangleCount() > 0usize;
  imm membraneMesh = if skin { renderer.addMesh(&mut device, meshes[LEVELS - first]); } else { frameMesh; };
  imm ballMesh = mesh.Mesh.sphere(1., 10);
  imm ball = renderer.addMesh(&mut device, &ballMesh);
  // The planet: a great rust-red ball below and beyond
  imm planetMesh = mesh.Mesh.sphere(1., 96);
  imm planet = renderer.addMesh(&mut device, &planetMesh);
  imm rust = PbrMaterial.standard(new Color(0.32, 0.1, 0.05, 1.), 0., 0.9);
  imm planetM = renderer.addPbrMaterial(&mut device, &rust);
  mut starMeshes = List[MeshHandle].empty();
  mut g = 0u32;
  while g < 3u32 {
    imm s = stars(g);
    mut idx = List[u32].empty();
    mut j = 0u32;
    while j < u32.from(s.len()) { idx.push(j); j = j + 1u32; }
    starMeshes.push(renderer.addLines(&mut device, s.view(), idx.view()));
    g = g + 1u32;
  }

  mut list = DrawList.empty();
  list.add(frameMesh, frameM, Mat4.identity());
  if skin { list.add(membraneMesh, membraneM, Mat4.identity()); }
  imm ship = Ship.make(false, has);
  imm glows = lights(&ship);
  mut i = 0usize;
  while i < glows.len() {
    imm l = *glows[i];
    imm material = if l.w > 0.03 { glowWarm; } else { glowBlue; };
    list.add(ball, material, Mat4.fromTrs(v(l.x, l.y, l.z), Quat.identity(), v(l.w, l.w, l.w)));
    i = i + 1usize;
  }
  // The silhouette: the ship and its lights in one flat white, lit by an
  // ambient white alone, so every pixel of it is 1
  imm flatWhite = Material.plain(new Color(1., 1., 1., 1.));
  imm white = renderer.addMaterial(&mut device, &flatWhite);
  mut maskList = DrawList.empty();
  maskList.add(frameMesh, white, Mat4.identity());
  if skin { maskList.add(membraneMesh, white, Mat4.identity()); }
  i = 0usize;
  while i < glows.len() {
    imm l = *glows[i];
    maskList.add(ball, white, Mat4.fromTrs(v(l.x, l.y, l.z), Quat.identity(), v(l.w, l.w, l.w)));
    i = i + 1usize;
  }
  imm flat = Light.directional(v(0., -1., 0.), new Color(0., 0., 0., 1.), new Color(1., 1., 1., 1.));
  list.add(planet, planetM, Mat4.fromTrs(v(171., -169., -13.), Quat.identity(), v(150., 150., 150.)));
  imm starColors Array[f32, 3] = [0.6, 1.5, 4.];
  i = 0usize;
  while i < 3usize {
    imm c = starColors[i];
    list.addLines(*starMeshes[i], Mat4.identity(), new Color(c, c, c * 1.1, 1.));
    i = i + 1usize;
  }

  // The shots: as the reference frames it, from the side, from ahead
  imm targetDesc = new TextureDescriptor(width, height, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut target = device.createTexture(&targetDesc);
  imm depthDesc = new TextureDescriptor(width, height, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  mut depth = device.createTexture(&depthDesc);
  mut post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, width, height);
  mut readback = device.createBuffer(u64.from(width) * u64.from(height) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  if !renderer.isValid() or !post.isValid() or !target.isValid() {
    print <- "The renderer could not be made\n";
    return 1;
  }
  mut camera = Camera.make();
  camera.fov = radians(35.);
  camera.near = 0.5;
  camera.far = 600.;
  imm names Array[&[]u8, 3] = ["-hero", "-side", "-front"];
  mut eyes = List[Vec3].empty();
  mut targets = List[Vec3].empty();
  mut ups = List[Vec3].empty();
  mut fovs = List[f32].empty();
  if cameras.len() == 0usize {
    eyes.push(v(-3., 12., 12.5)); eyes.push(v(5., 1.5, 19.)); eyes.push(v(-8., 3.5, 7.));
    targets.push(v(6., -0.3, 2.)); targets.push(v(5.5, 0.3, 0.)); targets.push(v(3.5, 0., 0.));
    ups.push(v(0.6, 1., 0.)); ups.push(v(0., 1., 0.)); ups.push(v(0., 1., 0.));
    fovs.push(35.); fovs.push(35.); fovs.push(35.);
  }
  mut c = 0usize;
  while c < cameras.len() {
    imm n = *cameras[c];
    eyes.push(v(n[0usize], n[1usize], n[2usize]));
    targets.push(v(n[3usize], n[4usize], n[5usize]));
    ups.push(v(n[6usize], n[7usize], n[8usize]));
    fovs.push(n[9usize]);
    c = c + 1usize;
  }
  imm bloom = post.bloom;
  imm toneMapper = post.toneMapper;
  imm passes = if masks { 2; } else { 1; };
  mut s = 0usize;
  while s < eyes.len() {
    camera.lookAt(*eyes[s], *targets[s], *ups[s]);
    camera.fov = radians(*fovs[s]);
    mut name = shots.copy();
    if cameras.len() == 0usize { name <- names[s]; }
    else {
      name <- "-cam";
      if s >= 10usize { name.appendByte(u8.from('0') + u8.from(s / 10usize % 10usize)); }
      name.appendByte(u8.from('0') + u8.from(s % 10usize));
    }
    mut pass = 0;
    while pass < passes {
      // The mask: no sky, no bloom, no tone mapping
      renderer.drawSky = pass == 0;
      post.bloom = if pass == 0 { bloom; } else { 0.; };
      post.toneMapper = if pass == 0 { toneMapper; } else { TONE_MAP_NONE; };
      mut encoder = device.createCommandEncoder();
      if pass == 0 { renderer.render(&mut device, &mut encoder, &post.hdr, &depth, &camera, &light, &list); }
      else { renderer.render(&mut device, &mut encoder, &post.hdr, &depth, &camera, &flat, &maskList); }
      post.apply(&mut encoder, &target);
      encoder.copyTextureToBuffer(&target, &readback);
      device.queue.submit(encoder.finish());
      device.endFrame();
      device.waitIdle();
      imm shot = Image.fromTexels(readback.mappedRange(), i32.from(width), i32.from(height), false);
      mut file = name.copy();
      if pass == 1 { file <- "-mask"; }
      file <- ".bmp";
      if shot.save(file.view()) { print <- "Shot: "; printStr(file.view()); print <- "\n"; }
      else { print <- "Could NOT write "; printStr(file.view()); print <- "\n"; ok = false; }
      pass = pass + 1;
    }
    s = s + 1usize;
  }

  print <- "Vulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  if !ok or failures() != 0u32 or validationMessages() != 0u32 { print <- "FAILED\n"; return 1; }
  print <- "OK\n";
  0;
}
