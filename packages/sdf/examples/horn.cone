// horn: the chitin horn, milestone 0 of the procedural reproduction plan.
// The sdf package's ribbed horn, with fine twisted flutes between its ribs,
// meshed on the CPU by surface nets at four levels of detail into render's
// LodChain, turns slowly under a blue-hour sky (streaks of cloud, a bright
// line along the horizon) in wet black chitin: a near-black base, a smooth
// clear coat, and an oil film on the coat whose thickness is warped noise
// drifting with time. Beside it, the same horn in the Blinn-Phong material,
// for comparison. Alone (key S, and the video), it stands on wet ground: dark
// mud under a coat that lies in patches, the same oil on it.
//
//   congo run --release packages/sdf/examples/horn.cone
//   congo run --release packages/sdf/examples/horn.cone -- --frames 120 --screenshot horn.bmp
//   congo run --release packages/sdf/examples/horn.cone -- --dump FOLDER
//
// Keys: F the film on or off; S the chitin horn alone on its ground, framed
// as the video frames it; Escape quit; F11 fullscreen.
//
// EVERYTHING DRAWN IS A PURE FUNCTION OF THE FRAME'S NUMBER (determinism
// rule 5): the world's time is the frame's number times a fixed step (1/60 s
// in the window, 1/30 s in a dump), never a clock, and the horn's turn, the
// camera and the film's drift are functions of that time and of constant
// seeds.
//
// THE CHECKS. The horn's four levels are meshed and their hashes (meshHash)
// compared with the hashes pinned below: meshing is on the CPU, so they are
// the same on every machine and GPU. Then the GPU evaluates the same horn's
// distance and normal at 4096 fixed points (hornparity.slang, the sdf parity
// test's pattern), and the program compares the bits with the CPU's: the
// distances within 2^-16 and the normals within 2^-12 (the sdf package's
// parity bounds), and prints a hash of each table; HORN_PARITY_OUT=FILE
// also writes the GPU's table there, so two GPUs' tables can be compared
// value by value. With '--frames N' (or HORN_FRAMES) it draws N frames and
// stops; at frame CHECK_FRAME (or the last) it reads the frame back: the sky
// above is bluer than red, and each horn is drawn where the middle of its
// arc falls, unlike the sky at the screen's edge on that row.
// '--screenshot FILE' writes that frame as a BMP, and the chitin horn alone,
// framed as the video frames it, as FILE-solo.bmp. After a run it draws
// BENCH_FRAMES frames offscreen at 1920 x 1080 and prints their mean time.
// It exits 0 only if every check passed, no Vulkan call failed and the
// validation layer said nothing.
//
// THE DUMP. '--dump FOLDER' opens no window: it draws the video's frames,
// 1920 x 1080 at 30 a second, VIDEO_FRAMES of them (14 s: one turn of the
// horn), each drawn at SUPERSAMPLE times the size and averaged down in
// linear light, into FOLDER/frame0000.bmp and on. '--start F', '--count N'
// and '--step K' dump every Kth of N frames from F. Level 0 is drawn
// throughout, so no level changes mid-shot. '--closeup' frames the horn
// close, as the reference's nearest spire is framed, for a side-by-side.
// Encode with ffmpeg: -framerate 30 -i frame%04d.bmp -c:v libx264 -crf 18
// -preset slow -pix_fmt yuv420p.
//
// It needs a GPU driver with Vulkan 1.3, SDL3.lib on LIB to link and
// SDL3.dll on PATH to run, and a display unless dumping; with the Vulkan SDK,
// validation is on. GPU_POWER_PREFERENCE=low-power picks an integrated GPU
// where there are two.

mod horn;

import stdio use *;
import libc;
import sdl;
import collections use *;
import geomath use *;
import mesh;
import noise;
import gpu use *;
import render use *;
import window use *;
import sdf use *;

const CHECK_FRAME = 90;
const BENCH_FRAMES = 120;
const LEVELS = 4u32;
const KEY_F = 102u32;
const KEY_S = 115u32;

// ---- The horn: hornmesh's, fluted; the pair turn about their middles ----

const LENGTH f32 = 3.4;
const BASE f32 = 0.34;
const TAPER f32 = 0.97;
const CURL f32 = 1.7;
const RIBS = 22;
const RIB_DEPTH f32 = 0.12;
const FLUTES = 40;
const FLUTE_DEPTH f32 = 0.018;
const FLUTE_TWIST f32 = 0.8;
const OFFSET f32 = 1.1;
const FINEST f32 = 0.01;
const RELAX = 1u32;

// The four levels' meshHash, pinned: the same on every run, build, machine
// and GPU, since meshing is on the CPU. (An 'imm', not a 'const': indexing
// a const array crashes conec.)
imm PINNED Array[u32, 4] = [0x85bc619fu32, 0xe640004fu32, 0x8ec31f5eu32, 0x29123678u32];

// ---- Time ----

const WINDOW_STEP f32 = 0.016666668;      // 1/60 s a frame in the window
const VIDEO_STEP f32 = 0.033333335;       // 1/30 s a frame in a dump
const VIDEO_FRAMES = 420;                 // 14 s
const VIDEO_WIDTH = 1920u32;
const VIDEO_HEIGHT = 1080u32;
const SUPERSAMPLE = 2u32;
const REVOLUTION f32 = 14.;               // seconds for one turn of the horn

// ---- The look, tuned by eye against the nearest spire of landscape 2 ----
//
// What the reference shows: a navy-black body, highlights near white and
// cool, a faint film tint on the spire (vivid only in the puddles), dark
// moody light from a bright sky above. What gets there: a dark sky overhead
// with bright structure in it (cloud streaks, a line at the horizon, a cool
// glow behind the camera) for the coat to reflect as highlights along the
// ribs; a cool key light high at the front left for the coat's sharp lobe; a
// film whose index is only a little above the coat's, so it tints rather
// than brightens. The PR lists every constant and why.

// The sky: blue hour. The sun (the key light) is high behind the camera, to
// the left, so its glow is reflected on the horn's front and never seen
fn sky() Sky {
  mut s = Sky.dusk(radians(30.), radians(300.));
  s.zenith = new Color(0.020, 0.032, 0.090, 1.);
  s.horizon = new Color(0.11, 0.13, 0.25, 1.);
  s.horizonSharpness = 4.;
  s.glow = new Color(0.30, 0.32, 0.50, 1.);
  s.glowSharpness = 6.;
  s.ground = new Color(0.016, 0.018, 0.030, 1.);
  s.groundFade = 6.;
  s.line = new Color(0.50, 0.56, 0.90, 1.);
  s.lineWidth = 0.05;
  s.cloud = new Color(0.85, 0.95, 1.40, 1.);
  s.cloudCover = 0.4;
  s.cloudScale = 1.3;
  s.cloudStretch = 5.;
  s.cloudHeading = 0.4;
  s.cloudSeed = 11u32;
  s;
}

// The sun as the directional light: cool white, strong enough that the
// coat's glints on the rib edges read white
fn light(s &Sky) Light { s.sunLight(new Color(3.2, 3.0, 3.6, 1.), new Color(0.03, 0.035, 0.06, 1.)); }

// The chitin: blue-black, a wet coat a little rougher than chitin's default
// so the key light's glints spread along the ribs, and an oil film of index
// 1.85 from 180 to 520 nm (second-order colours, magenta, teal, gold)
fn chitin() PbrMaterial {
  mut m = PbrMaterial.chitin(180., 520., 7u32);
  m.baseColor = new Color(0.004, 0.005, 0.009, 1.);
  m.roughness = 0.35;
  m.clearcoatRoughness = 0.07;
  m.filmIor = 1.85;
  m.filmScale = 1.2;
  m.filmDrift = 0.25;
  m.filmWarp = 1.5;
  m;
}

fn phong() Material { Material.shiny(new Color(0.012, 0.011, 0.014, 1.), 0.9, 90.); }

// ---- The scene at time t ----

fn ease(x f32) f32 {
  imm c = if x < 0. { 0.; } elif x > 1. { 1.; } else { x; };
  c * c * (3. - 2. * c);
}

// The horn's turn: one revolution in REVOLUTION seconds
fn turnAt(t f32) Quat { Quat.angleAxis(0.6 + t * (2. * pi / REVOLUTION), new Vec3(0., 1., 0.)); }

// The horn's model matrix at 'at', turned about its middle (the pair,
// floating)
fn modelAt(at Vec3, turn Quat) Mat4 {
  Mat4.fromTranslation(at) * Mat4.fromTrs(new Vec3(0., 0., 0.), turn, new Vec3(1., 1., 1.))
    * Mat4.fromTranslation(new Vec3(0. - OFFSET, 0., 0.));
}

// The horn standing alone, its base sunk a little in the ground, turning
// about its base as a spire on a turntable
const SINK f32 = 0.12;
fn soloModel(turn Quat) Mat4 {
  Mat4.fromTrs(new Vec3(0., 0. - SINK, 0.), turn, new Vec3(1., 1., 1.));
}

// The ground: a plane GROUND each way from the horn, its coordinates the
// world's, so its noise is in world units
const GROUND f32 = 150.;
fn groundMesh() mesh.Mesh {
  mut m = mesh.Mesh.plane(16, 1.);
  mut i = 0usize;
  while i < m.positions.len() {
    imm p = *m.positions[i];
    m.positions.set(i, new Vec3(p.x * GROUND, 0., p.z * GROUND));
    i = i + 1usize;
  }
  m;
}
fn groundModel() Mat4 { Mat4.fromTranslation(new Vec3(0., 0., 0.)); }

// The pair's places, and the camera that holds both
const SPACING f32 = 3.6;
fn pairEye() Vec3 { new Vec3(0., 1.5, 9.4); }
fn pairTarget() Vec3 { new Vec3(0., 1.0, 0.); }

// The video's camera at time t: a slow push-in, the eye easing a little
// round and down. 'closeup': at the video's start, but close, framed as the
// reference's nearest spire is (for the side-by-side)
fn soloCamera(camera &mut Camera, t f32, closeup Bool) {
  imm k = ease(t / (f32.from(VIDEO_FRAMES) * VIDEO_STEP));
  mut distance = 6.4 - 0.9 * k;
  imm azimuth = -0.16 + 0.30 * k;
  mut elevation = 0.30 - 0.06 * k;
  mut target = new Vec3(0., 1.0 + 0.05 * k, 0.);
  if closeup {
    distance = 4.1;
    elevation = 0.24;
    target = new Vec3(0., 1.1, 0.);
  }
  imm eye = target + new Vec3(sin(azimuth) * cos(elevation), sin(elevation), cos(azimuth) * cos(elevation)) * distance;
  camera.lookAt(eye, target, new Vec3(0., 1., 0.));
}

// The wet ground: dark mud under a blurred wet coat and the same oil
fn groundMaterial() PbrMaterial {
  mut m = PbrMaterial.chitin(220., 720., 23u32);
  m.baseColor = new Color(0.007, 0.0065, 0.009, 1.);
  m.roughness = 0.85;
  m.clearcoat = 0.3;
  m.clearcoatRoughness = 0.16;
  m.filmMin = 90.;
  m.filmMax = 420.;
  m.filmIor = 2.2;
  m.filmScale = 0.5;
  m.filmDrift = 0.03;
  m.filmWarp = 1.5;
  m.wetScale = 0.3;
  m.wetLevel = 0.0;
  m.wetSoftness = 0.35;
  m.wetSeed = 5u32;
  m;
}

// ---- Arguments ----

fn parseCount(s *u8) i32 {
  if (s as usize) == 0usize or *s == 0u8 { return -1; }
  mut n = 0;
  mut i = 0usize;
  while *(s + i) != 0u8 {
    imm c = *(s + i);
    if c < '0' or c > '9' { return -1; }
    n = n * 10 + i32.from(c - '0');
    i = i + 1usize;
  }
  n;
}

fn cstrEquals(a *u8, b &[]u8) Bool {
  mut i = 0usize;
  while i < b.len {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len) == 0u8;
}

fn appendCstr(s &mut String, c *u8) {
  mut i = 0usize;
  while *(c + i) != 0u8 {
    s.appendByte(*(c + i));
    i = i + 1usize;
  }
}

fn onOff(on Bool) &[]u8 {
  if on { return "on"; }
  "off";
}

// 'base' without its '.bmp', then 'suffix' and '.bmp'
fn shotName(base &String, suffix &[]u8) String {
  mut s = String.empty();
  if base.endsWith(".bmp") { s = base.sub(0usize, base.len() - 4usize); } else { s = base.copy(); }
  s <- suffix;
  s <- ".bmp";
  s;
}

// FOLDER/frame0000.bmp
fn frameName(folder &String, n i32) String {
  mut s = folder.copy();
  s <- "/frame";
  s.appendByte(u8.from('0') + u8.from((n / 1000) % 10));
  s.appendByte(u8.from('0') + u8.from((n / 100) % 10));
  s.appendByte(u8.from('0') + u8.from((n / 10) % 10));
  s.appendByte(u8.from('0') + u8.from(n % 10));
  s <- ".bmp";
  s;
}

// ---- The GPU's horn against the CPU's ----

const PARITY_WIDTH = 64u32;
const PARITY_HEIGHT = 256u32;

// Point 'a' (0 to 4095), as hornparity.slang's 'parityPoint'
fn parityPoint(a u32) Vec3 {
  imm gx = a % 16u32;
  imm gy = (a / 16u32) % 16u32;
  imm gz = a / 256u32;
  new Vec3(f32.from(gx) * 0.1875 - 0.5, f32.from(gy) * 0.1875 - 0.5, f32.from(gz) * 0.0625 - 0.5);
}

fn parityQuantity(horn &Horn, q u32, p Vec3) f32 {
  if q == 0u32 { return horn.distance(p); }
  imm n = normal(horn, p, 0.015625);
  if q == 1u32 { n.x; } elif q == 2u32 { n.y; } else { n.z; };
}

fn printHex(label &[]u8, h u32) {
  mut s = String.empty();
  s.appendHex(u64.from(h), 8usize);
  printStr(label); printStr(s.view());
}

// Draw hornparity.slang's table on 'device' and compare it with the CPU's;
// true if every quantity is within its bound
fn gpuParity(device &mut Device, horn &Horn) Bool {
  imm target = new TextureDescriptor(PARITY_WIDTH, PARITY_HEIGHT, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut color = device.createTexture(&target);
  mut readback = device.createBuffer(u64.from(PARITY_WIDTH * PARITY_HEIGHT * 4u32),
    BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut shader = device.createShaderModule(&HORNPARITY_SPIRV);
  mut layout = device.createEmptyPipelineLayout(0u32);
  imm noBuffers = List[VertexBufferLayout].empty();
  imm desc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, buffers: noBuffers.view(),
    fragmentModule: &shader, colorFormat: TEXTURE_FORMAT_RGBA8_UNORM);
  mut pipeline = device.createRenderPipeline(&desc);
  if !color.isValid() or !pipeline.isValid() {
    print <- "GPU parity: the pipeline could not be made\n";
    return false;
  }
  {
    mut encoder = device.createCommandEncoder();
    imm attachment = new RenderPassColorAttachment(view: color.createView(), clearValue: new Color(0., 0., 0., 0.));
    mut pass = encoder.beginRenderPass(&attachment);
    pass.setPipeline(&pipeline);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
    encoder.copyTextureToBuffer(&color, &readback);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
  }
  imm p = readback.mappedRange();
  // HORN_PARITY_OUT names a file for the GPU's table, its raw bytes, so two
  // GPUs' tables can be compared value by value
  imm outPath = libc.getenv(&"HORN_PARITY_OUT" as *u8);
  if (outPath as usize) != 0usize {
    imm file = libc.fopen(outPath, &"wb" as *u8);
    if (file as usize) != 0usize {
      libc.fwrite(p, 1usize, usize.from(PARITY_WIDTH * PARITY_HEIGHT * 4u32), file);
      libc.fclose(file);
    }
  }
  mut exact Array[u32, 4] = [0u32, 0u32, 0u32, 0u32];
  mut worst Array[f64, 4] = [0d, 0d, 0d, 0d];
  mut signsAgree = 0u32;
  mut nearSurface = 0u32;
  mut cpuHash = noise.pcg(0x686f726eu32);
  mut gpuHash = cpuHash;
  mut i = 0u32;
  while i < PARITY_WIDTH * PARITY_HEIGHT {
    imm q = i % 4u32;
    imm a = i / 4u32;
    imm at = p + usize.from(i * 4u32);
    imm gpuBits = u32.from(*at) | (u32.from(*(at + 1usize)) << 8u32) | (u32.from(*(at + 2usize)) << 16u32)
      | (u32.from(*(at + 3usize)) << 24u32);
    imm cpu = parityQuantity(horn, q, parityPoint(a));
    imm cpuBits = cpu as u32;
    cpuHash = noise.pcg(cpuHash ^ cpuBits);
    gpuHash = noise.pcg(gpuHash ^ gpuBits);
    if gpuBits == cpuBits {
      exact[usize.from(q)] = exact[usize.from(q)] + 1u32;
    } else {
      imm d = f64.from(gpuBits as f32) - f64.from(cpu);
      imm ad = if d < 0d { -d; } else { d; };
      if ad > worst[usize.from(q)] or ad != ad { worst[usize.from(q)] = ad; }
    }
    if q == 0u32 {
      imm g = gpuBits as f32;
      if (g < 0.) == (cpu < 0.) { signsAgree = signsAgree + 1u32; }
      if cpu < 0.02 and cpu > -0.02 { nearSurface = nearSurface + 1u32; }
    }
    i = i + 1u32;
  }
  imm samples = PARITY_WIDTH * PARITY_HEIGHT / 4u32;
  print <- "GPU parity, the horn at "; print <- u64.from(samples); print <- " points ("; print <- u64.from(nearSurface);
  print <- " within 0.02 of its surface):\n";
  imm names Array[&[]u8, 4] = ["distance", "normal x", "normal y", "normal z"];
  imm bounds Array[f64, 4] = [0.0000152587890625d, 0.000244140625d, 0.000244140625d, 0.000244140625d];
  mut ok = true;
  mut q = 0usize;
  while q < 4usize {
    print <- "  "; printStr(names[q]); print <- ": "; print <- u64.from(exact[q]); print <- " of "; print <- u64.from(samples);
    print <- " bit for bit, the rest within "; print <- worst[q]; print <- " (bound "; print <- bounds[q]; print <- ")\n";
    if worst[q] > bounds[q] or worst[q] != worst[q] { ok = false; }
    q = q + 1usize;
  }
  print <- "  the distance's sign agrees at "; print <- u64.from(signsAgree); print <- " of "; print <- u64.from(samples); print <- "\n";
  if signsAgree != samples { ok = false; }
  printHex("  table hash: CPU ", cpuHash); printHex(", GPU ", gpuHash);
  if cpuHash == gpuHash { print <- " (the same)\n"; } else { print <- " (they differ: see the counts above)\n"; }
  ok;
}

// ---- Reading a frame back ----

fn channel(p *u8, w u32, x i32, y i32, c usize, bgra Bool) i32 {
  mut at = c;
  if bgra { at = 2usize - c; }
  i32.from(*(p + (usize.from(y) * usize.from(w) + usize.from(x)) * 4usize + at));
}

fn luma(p *u8, w u32, x i32, y i32, bgra Bool) i32 {
  channel(p, w, x, y, 0usize, bgra) + channel(p, w, x, y, 1usize, bgra) + channel(p, w, x, y, 2usize, bgra);
}

fn printPixel(name &[]u8, p *u8, w u32, x i32, y i32, bgra Bool) {
  printStr(name); print <- " at ("; print <- x; print <- ", "; print <- y; print <- "): ";
  print <- channel(p, w, x, y, 0usize, bgra); print <- " "; print <- channel(p, w, x, y, 1usize, bgra); print <- " ";
  print <- channel(p, w, x, y, 2usize, bgra);
}

fn pixelOf(viewProjection Mat4, p Vec3, w u32, h u32, x &mut i32, y &mut i32) {
  imm clip = viewProjection * new Vec4(p.x, p.y, p.z, 1.);
  *x = i32.from((clip.x / clip.w + 1.) * 0.5 * f32.from(w));
  *y = i32.from((1. - clip.y / clip.w) * 0.5 * f32.from(h));
}

// Whether the horn modelled by 'model' is drawn where the middle of its arc
// falls, unlike the sky at the screen's edge on that row
fn checkHorn(name &[]u8, p *u8, w u32, h u32, bgra Bool, viewProjection Mat4, model Mat4, horn &Horn) Bool {
  mut hx = 0;
  mut hy = 0;
  pixelOf(viewProjection, model * horn.arc.point(LENGTH * 0.5), w, h, &mut hx, &mut hy);
  if hx < 0 or hy < 0 or hx >= i32.from(w) or hy >= i32.from(h) {
    print <- "  "; printStr(name); print <- ": off the screen\n";
    return false;
  }
  printStr("  "); printPixel(name, p, w, hx, hy, bgra);
  imm sx = i32.from(w / 40u32);
  imm d = luma(p, w, hx, hy, bgra) - luma(p, w, sx, hy, bgra);
  if d > 30 or d < -30 { print <- ": drawn, unlike the sky at the edge\n"; return true; }
  print <- ": NOT unlike the sky at the edge\n";
  false;
}

// sRGB's encoding of linear 'v', 0 to 1, as a byte
fn encodeSrgb(v f32) u8 {
  imm c = if v <= 0. { 0.; } elif v >= 1. { 1.; } else { v; };
  imm e = if c <= 0.0031308 { c * 12.92; } else { 1.055 * libc.powf(c, 1. / 2.4) - 0.055; };
  u8.from(e * 255. + 0.5);
}

// The tables the downsampling reads: each sRGB byte's linear value, and the
// sRGB byte of each linear value in 1/65535 steps (fine enough that the
// darkest bytes, 1/3300 apart in linear light, are each reached)
const ENCODE_STEPS = 65536usize;
fn decodeTable() *f32 {
  imm t = libc.malloc(256usize * 4usize) as *f32;
  mut v = 0usize;
  while v < 256usize {
    imm c = f32.from(v) / 255.;
    *(t + v) = if c <= 0.04045 { c / 12.92; } else { libc.powf((c + 0.055) / 1.055, 2.4); };
    v = v + 1usize;
  }
  t;
}
fn encodeTable() *u8 {
  imm t = libc.malloc(ENCODE_STEPS);
  mut i = 0usize;
  while i < ENCODE_STEPS {
    *(t + i) = encodeSrgb(f32.from(i) / f32.from(ENCODE_STEPS - 1usize));
    i = i + 1usize;
  }
  t;
}

// 'src', 'k' times 'w' by 'h' sRGB texels (RGBA), averaged down k x k in
// linear light into 'dst', w by h RGBA texels
fn downsample(src *u8, dst *u8, w u32, h u32, k u32, decode *f32, encode *u8) {
  imm sw = usize.from(w * k);
  imm kk = usize.from(k);
  imm scale = f32.from(ENCODE_STEPS - 1usize) / f32.from(k * k);
  mut y = 0usize;
  while y < usize.from(h) {
    mut x = 0usize;
    while x < usize.from(w) {
      imm out = dst + (y * usize.from(w) + x) * 4usize;
      mut c = 0usize;
      while c < 3usize {
        mut sum = 0.;
        mut j = 0usize;
        while j < kk {
          mut s = src + ((y * kk + j) * sw + x * kk) * 4usize + c;
          mut i = 0usize;
          while i < kk {
            sum = sum + *(decode + usize.from(*s));
            s = s + 4usize;
            i = i + 1usize;
          }
          j = j + 1usize;
        }
        mut q = usize.from(sum * scale + 0.5);
        if q >= ENCODE_STEPS { q = ENCODE_STEPS - 1usize; }
        *(out + c) = *(encode + q);
        c = c + 1usize;
      }
      *(out + 3usize) = 255u8;
      x = x + 1usize;
    }
    y = y + 1usize;
  }
}

// ---- The GPU ----

fn powerPreference() u32 {
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize {
    if libc.strcmp(env, &"low-power" as *u8) == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

fn printAdapter(instance &Instance, adapter &Adapter) {
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  print <- "Validation layer: "; printStr(onOff(instance.validation));
  print <- "; synchronization validation: "; printStr(onOff(instance.syncValidation)); print <- "\n";
}

// The meshes into the renderer as a chain of levels, each drawn while the
// horn is at least so many pixels across: level 0 above 500, 1 above 250,
// 2 above 120, 3 below
fn addLevels(renderer &mut Renderer, device &mut Device, meshes &List[mesh.Mesh]) LodChain {
  mut chain = LodChain.empty(0.1);
  imm minSizes Array[f32, 4] = [500., 250., 120., 0.];
  mut i = 0usize;
  while i < meshes.len() {
    chain.add(renderer.addMesh(device, meshes[i]), minSizes[i]);
    i = i + 1usize;
  }
  chain;
}

// 'count' of the video's frames from 'start', 'step' apart, offscreen,
// supersampled, into 'folder'; how many were written
fn drawDump(device &mut Device, meshes &List[mesh.Mesh], folder &String, start i32, count i32, step i32,
  closeup Bool, frequency f64) i32 {
  mut renderer = Renderer.create(device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  imm theSky = sky();
  renderer.setSky(device, &theSky);
  imm theLight = light(&theSky);
  mut chain = addLevels(&mut renderer, device, meshes);
  chain.select(0usize);
  imm coat = chitin();
  imm chitinM = renderer.addPbrMaterial(device, &coat);
  imm plane = groundMesh();
  imm ground = renderer.addMesh(device, &plane);
  imm mud = groundMaterial();
  imm groundM = renderer.addPbrMaterial(device, &mud);
  mut camera = Camera.make();
  camera.fov = radians(35.);
  camera.near = 0.3;
  camera.far = 400.;
  mut list = DrawList.empty();

  imm w = VIDEO_WIDTH * SUPERSAMPLE;
  imm h = VIDEO_HEIGHT * SUPERSAMPLE;
  imm targetDesc = new TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut target = device.createTexture(&targetDesc);
  imm depthDesc = new TextureDescriptor(w, h, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  mut depth = device.createTexture(&depthDesc);
  mut post = Post.create(device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, w, h);
  if !renderer.isValid() or !post.isValid() or !target.isValid() {
    print <- "The offscreen renderer could not be made\n";
    return 0;
  }
  mut readback = device.createBuffer(u64.from(w) * u64.from(h) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm out = libc.malloc(usize.from(VIDEO_WIDTH) * usize.from(VIDEO_HEIGHT) * 4usize);
  imm bigBytes = usize.from(w) * usize.from(h) * 4usize;
  imm big = libc.malloc(bigBytes);
  imm decode = decodeTable();
  imm encode = encodeTable();
  mut written = 0;
  mut gpuMs = 0d;
  mut downMs = 0d;
  mut saveMs = 0d;
  mut n = 0;
  while n < count {
    imm f = start + n * step;
    imm t = f32.from(f) * VIDEO_STEP;
    renderer.time = t;
    soloCamera(&mut camera, t, closeup);
    list.clear();
    list.add(chain.mesh(), chitinM, soloModel(turnAt(t)));
    list.add(ground, groundM, groundModel());
    imm began = sdl.GetPerformanceCounter();
    mut encoder = device.createCommandEncoder();
    renderer.render(device, &mut encoder, &post.hdr, &depth, &camera, &theLight, &list);
    post.apply(&mut encoder, &target);
    encoder.copyTextureToBuffer(&target, &readback);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    imm drawn = sdl.GetPerformanceCounter();
    gpuMs = gpuMs + f64.from(drawn - began) / frequency * 1000.;
    // Copied out of the mapped buffer first: reading it texel by texel is
    // many times slower (it is not cached)
    libc.memcpy(big, readback.mappedRange(), bigBytes);
    downsample(big, out, VIDEO_WIDTH, VIDEO_HEIGHT, SUPERSAMPLE, decode, encode);
    imm averaged = sdl.GetPerformanceCounter();
    downMs = downMs + f64.from(averaged - drawn) / frequency * 1000.;
    imm shot = Image.fromTexels(out, i32.from(VIDEO_WIDTH), i32.from(VIDEO_HEIGHT), false);
    imm name = frameName(folder, f);
    if shot.save(name.view()) { written = written + 1; }
    else { print <- "Could NOT write "; printStr(name.view()); print <- "\n"; }
    saveMs = saveMs + f64.from(sdl.GetPerformanceCounter() - averaged) / frequency * 1000.;
    n = n + 1;
  }
  device.waitIdle();
  libc.free(out);
  libc.free(big);
  libc.free(decode as *u8);
  libc.free(encode);
  print <- "Frames written: "; print <- written; print <- " of "; print <- count; print <- " ("; print <- u64.from(w);
  print <- " x "; print <- u64.from(h); print <- " drawn, averaged down to "; print <- u64.from(VIDEO_WIDTH); print <- " x ";
  print <- u64.from(VIDEO_HEIGHT); print <- " in linear light)\n";
  if count > 0 {
    print <- "Mean a frame: "; print <- gpuMs / f64.from(count); print <- " ms drawing and reading back, ";
    print <- downMs / f64.from(count); print <- " ms averaging, "; print <- saveMs / f64.from(count); print <- " ms writing\n";
  }
  written;
}

// ---- The demo ----

fn main(argc i32, argv **u8) i32 {
  mut maxFrames = 0;
  mut screenshot = String.empty();
  mut dump = String.empty();
  mut start = 0;
  mut count = VIDEO_FRAMES;
  mut step = 1;
  mut closeup = false;
  imm env = libc.getenv(&"HORN_FRAMES" as *u8);
  if (env as usize) != 0usize { maxFrames = parseCount(env); }
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--frames") and a + 1 < argc {
      maxFrames = parseCount(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--screenshot") and a + 1 < argc {
      appendCstr(&mut screenshot, *(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--dump") and a + 1 < argc {
      appendCstr(&mut dump, *(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--start") and a + 1 < argc {
      start = parseCount(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--count") and a + 1 < argc {
      count = parseCount(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--step") and a + 1 < argc {
      step = parseCount(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--closeup") {
      closeup = true;
    } else {
      print <- "Unknown argument; use --frames N, --screenshot FILE, --dump FOLDER, --start F, --count N, --step K";
      print <- " and --closeup\n";
      return 2;
    }
    a = a + 1;
  }
  if maxFrames < 0 or start < 0 or count < 0 or step < 1 {
    print <- "--frames, --start, --count and --step want whole numbers (--step at least 1)\n";
    return 2;
  }
  mut checkFrame = CHECK_FRAME;
  if maxFrames > 0 and maxFrames - 1 < checkFrame { checkFrame = maxFrames - 1; }
  imm dumping = dump.len() > 0usize;

  // The horn, meshed, and its hashes against the pinned
  imm frequency = f64.from(sdl.GetPerformanceFrequency());
  imm plain = Horn.make(LENGTH, BASE, TAPER, CURL, RIBS, RIB_DEPTH);
  imm horn = plain.fluted(FLUTES, FLUTE_DEPTH, FLUTE_TWIST);
  imm box = horn.bounds();
  mut meshes = List[mesh.Mesh].empty();
  mut hashesPinned = true;
  mut cell = FINEST;
  mut level = 0u32;
  while level < LEVELS {
    imm started = sdl.GetPerformanceCounter();
    imm net = surfaceNet(&horn, box, cell, RELAX, true);
    imm m = net.toMesh();
    imm ms = f64.from(sdl.GetPerformanceCounter() - started) / frequency * 1000.;
    imm h = meshHash(&m);
    print <- "Level "; print <- u64.from(level); print <- ": cells of "; print <- cell; print <- ", ";
    print <- m.vertexCount(); print <- " vertices, "; print <- m.triangleCount(); print <- " triangles, ";
    print <- ms; print <- " ms; "; printHex("hash ", h);
    if h == PINNED[usize.from(level)] { print <- " (as pinned)\n"; }
    else { printHex(" (NOT the pinned ", PINNED[usize.from(level)]); print <- ")\n"; hashesPinned = false; }
    meshes.push(m);
    cell = cell * 2.;
    level = level + 1u32;
  }

  // Dumping: any GPU, no window
  if dumping {
    mut instance = Instance.create("horn");
    if !instance.isValid() {
      print <- "No Vulkan 1.3 instance could be made\n";
      return 1;
    }
    mut none = Surface.none();
    mut adapter = instance.requestAdapter(&none, powerPreference());
    if !adapter.isValid() {
      print <- "No GPU can draw\n";
      return 1;
    }
    printAdapter(&instance, &adapter);
    mut device = adapter.requestDevice();
    imm parityOk = gpuParity(&mut device, &horn);
    imm written = drawDump(&mut device, &meshes, &dump, start, count, step, closeup, frequency);
    print <- "Vulkan failures: "; print <- u64.from(failures());
    print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
    if written != count or !hashesPinned or !parityOk or failures() != 0u32 or validationMessages() != 0u32 {
      print <- "FAILED\n";
      return 1;
    }
    print <- "OK\n";
    return 0;
  }

  // The window's GPU
  mut win = Window.openVulkan("Cone: the chitin horn");
  if !win.isOpen() {
    print <- "No window could be opened\n";
    return 1;
  }
  mut instance = Instance.create("horn");
  if !instance.isValid() {
    print <- "No Vulkan 1.3 instance could be made\n";
    return 1;
  }
  mut surface = instance.createSurface(win.sdlHandle());
  mut adapter = instance.requestAdapter(&surface, powerPreference());
  if !adapter.isValid() {
    print <- "No GPU can draw to the window\n";
    return 1;
  }
  printAdapter(&instance, &adapter);
  mut device = adapter.requestDevice();
  imm parityOk = gpuParity(&mut device, &horn);

  // The renderer and the scene
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  if !renderer.isValid() {
    print <- "The renderer could not be made\n";
    return 1;
  }
  imm theSky = sky();
  renderer.setSky(&mut device, &theSky);
  imm theLight = light(&theSky);
  mut chain = addLevels(&mut renderer, &mut device, &meshes);
  mut coat = chitin();
  imm chitinM = renderer.addPbrMaterial(&mut device, &coat);
  imm phongMaterial = phong();
  imm phongM = renderer.addMaterial(&mut device, &phongMaterial);
  imm plane = groundMesh();
  imm ground = renderer.addMesh(&mut device, &plane);
  imm mud = groundMaterial();
  imm groundM = renderer.addPbrMaterial(&mut device, &mud);
  mut camera = Camera.make();
  camera.fov = radians(35.);
  camera.near = 0.3;
  camera.far = 400.;
  camera.background = new Color(0., 0., 0., 1.);
  imm boxCentre = box.center();
  imm boxRadius = box.halfExtents().length();
  mut list = DrawList.empty();

  // The window
  imm size = win.size();
  mut swapchain = device.createSwapChain(&surface, u32.from(size.w), u32.from(size.h), TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, swapchain.format, u32.from(size.w), u32.from(size.h));
  if !post.isValid() {
    print <- "The post-processing could not be made\n";
    return 1;
  }
  imm leftAt = new Vec3(0. - SPACING * 0.5, 0., 0.);
  imm rightAt = new Vec3(SPACING * 0.5, 0., 0.);
  mut frames = 0;
  mut unshown = 0;
  mut checked = false;
  mut checksPassed = true;
  mut shotsWritten = true;
  mut soloShot = false;
  mut film = true;
  mut solo = false;
  mut firstTimed = 0u64;
  mut lastTimed = 0u64;
  mut lastTimedFrame = 0;
  while win.running and (maxFrames == 0 or frames < maxFrames) {
    mut event = sdl.Event.empty();
    while win.pollEvent(&mut event) {
      imm key = keyDown(&event);
      if key == KEY_F { film = !film; }
      if key == KEY_S { solo = !solo; }
    }
    imm shooting = screenshot.len() > 0usize and checked and !soloShot;
    mut drawSolo = solo;
    if maxFrames > 0 and frames == checkFrame and !checked { drawSolo = false; }
    if shooting { drawSolo = true; }
    if coat.film != film {
      coat.film = film;
      renderer.setPbrMaterial(&mut device, chitinM, &coat);
    }
    if maxFrames > 0 and frames == checkFrame + 8 { win.setSize(size.w * 2 / 3, size.h * 2 / 3); }
    if win.resized {
      imm s = win.size();
      swapchain.resize(u32.from(s.w), u32.from(s.h));
      win.resized = false;
    }
    imm frame = swapchain.getCurrentTexture(&mut device);
    if !frame.ok() {
      sdl.Delay(10u32);
    } else {
      imm started = sdl.GetPerformanceCounter();
      imm w = frame.texture.width;
      imm h = frame.texture.height;
      imm t = f32.from(frames) * WINDOW_STEP;
      renderer.time = t;
      post.resize(&mut device, w, h);
      imm turn = turnAt(t);
      list.clear();
      mut chitinModel = modelAt(rightAt, turn);
      imm phongModel = modelAt(leftAt, turn);
      if drawSolo {
        soloCamera(&mut camera, t, false);
        chitinModel = soloModel(turn);
        chain.selectBySize(camera.projectedSize(chitinModel * boxCentre, boxRadius, f32.from(h)));
        list.add(chain.mesh(), chitinM, chitinModel);
        list.add(ground, groundM, groundModel());
      } else {
        camera.lookAt(pairEye(), pairTarget(), new Vec3(0., 1., 0.));
        chain.selectBySize(camera.projectedSize(chitinModel * boxCentre, boxRadius, f32.from(h)));
        list.add(chain.mesh(), chitinM, chitinModel);
        list.add(chain.mesh(), phongM, phongModel);
      }

      mut encoder = device.createCommandEncoder();
      renderer.render(&mut device, &mut encoder, &post.hdr, &frame.depth, &camera, &theLight, &list);
      post.apply(&mut encoder, &frame.texture);
      imm bgra = frame.texture.format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB
        or frame.texture.format == TEXTURE_FORMAT_BGRA8_UNORM;
      imm checkNow = frames == checkFrame and !checked;
      if checkNow or shooting {
        mut readback = device.createBuffer(u64.from(w) * u64.from(h) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
        encoder.copyTextureToBuffer(&frame.texture, &readback);
        device.queue.submit(encoder.finish());
        if !swapchain.present(&mut device) { unshown = unshown + 1; }
        device.waitIdle();
        imm p = readback.mappedRange();
        mut name = screenshot.copy();
        if checkNow {
          checked = true;
          print <- "Frame "; print <- frames; print <- " ("; print <- u64.from(w); print <- " x "; print <- u64.from(h);
          print <- "), level "; print <- chain.current; print <- ", "; print <- renderer.triangles; print <- " triangles:\n";
          imm tx = i32.from(w / 2u32);
          imm ty = i32.from(h / 30u32);
          printStr("  "); printPixel("the sky above", p, w, tx, ty, bgra);
          if channel(p, w, tx, ty, 2usize, bgra) > channel(p, w, tx, ty, 0usize, bgra) { print <- ": bluer than red\n"; }
          else { print <- ": NOT bluer than red\n"; checksPassed = false; }
          imm viewProjection = camera.projectionMatrix(f32.from(w) / f32.from(h)) * camera.viewMatrix();
          if !checkHorn("the chitin horn", p, w, h, bgra, viewProjection, chitinModel, &horn) { checksPassed = false; }
          if !checkHorn("the Blinn-Phong horn", p, w, h, bgra, viewProjection, phongModel, &horn) { checksPassed = false; }
        } else {
          soloShot = true;
          name = shotName(&screenshot, "-solo");
        }
        if screenshot.len() > 0usize {
          imm shot = Image.fromTexels(p, i32.from(w), i32.from(h), bgra);
          imm written = shot.save(name.view());
          print <- "Screenshot: "; printStr(name.view());
          if written { print <- "\n"; } else { print <- " could NOT be written\n"; shotsWritten = false; }
        }
      } else {
        device.queue.submit(encoder.finish());
        if !swapchain.present(&mut device) { unshown = unshown + 1; }
        if frames >= 10 {
          if firstTimed == 0u64 { firstTimed = started; }
          lastTimed = started;
          lastTimedFrame = frames;
        }
      }
      frames = frames + 1;
    }
  }
  device.waitIdle();

  print <- "Frames drawn: "; print <- frames; print <- "; presented: "; print <- swapchain.presents;
  print <- "; out of date when presented: "; print <- unshown; print <- "\n";
  if lastTimedFrame > 12 and lastTimed > firstTimed {
    imm frameMs = f64.from(lastTimed - firstTimed) / frequency * 1000. / f64.from(lastTimedFrame - 10);
    print <- "Frame time: "; print <- frameMs; print <- " ms a frame (presented in step with the display)\n";
  }

  // The GPU's cost of a frame of the pair, level 0, at 1080p, offscreen
  if frames > 0 {
    imm w = 1920u32;
    imm h = 1080u32;
    imm targetDesc = new TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_RENDER_ATTACHMENT);
    mut target = device.createTexture(&targetDesc);
    imm depthDesc = new TextureDescriptor(w, h, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
    mut depth = device.createTexture(&depthDesc);
    mut benchPost = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, w, h);
    if !coat.film {
      coat.film = true;
      renderer.setPbrMaterial(&mut device, chitinM, &coat);
    }
    chain.select(0usize);
    camera.lookAt(pairEye(), pairTarget(), new Vec3(0., 1., 0.));
    device.waitIdle();
    imm benchStart = sdl.GetPerformanceCounter();
    mut b = 0;
    while b < BENCH_FRAMES {
      imm t = f32.from(frames + b) * WINDOW_STEP;
      renderer.time = t;
      list.clear();
      list.add(chain.mesh(), chitinM, modelAt(rightAt, turnAt(t)));
      list.add(chain.mesh(), phongM, modelAt(leftAt, turnAt(t)));
      mut encoder = device.createCommandEncoder();
      renderer.render(&mut device, &mut encoder, &benchPost.hdr, &depth, &camera, &theLight, &list);
      benchPost.apply(&mut encoder, &target);
      device.queue.submit(encoder.finish());
      device.endFrame();
      b = b + 1;
    }
    device.waitIdle();
    imm benchMs = f64.from(sdl.GetPerformanceCounter() - benchStart) / frequency * 1000. / f64.from(BENCH_FRAMES);
    print <- "GPU frame time, both horns at level 0, offscreen at 1920 x 1080: "; print <- benchMs;
    print <- " ms a frame ("; print <- BENCH_FRAMES; print <- " frames, nothing presented)\n";
  }

  print <- "Vulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  if !checked { print <- "The frame was not checked\n"; }
  if (checked and !checksPassed) or !shotsWritten or !hashesPinned or !parityOk {
    print <- "FAILED\n";
    return 1;
  }
  if failures() != 0u32 or validationMessages() != 0u32 { return 1; }
  print <- "OK\n";
  0;
}

