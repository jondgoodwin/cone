// Repetition along a curve, and the horn. Only a failure prints.
//
// - The arc: length pi curled a quarter turn has radius 2 about (2, 0, 0);
//   halfway, at 45 degrees, its point is (2 - sqrt 2, sqrt 2, 0), its
//   tangent (1, 1, 0) / sqrt 2, its normal (-1, 1, 0) / sqrt 2 (away from
//   the centre), its binormal +z; a point 1 further out projects there,
//   arc length pi / 2, distance 1. Its end is (2, 2, 0).
// - Its cells: the frames 'arc.cells' steps round by rotation are the
//   frames 'frameAt' finds by trigonometry, to 1e-6.
// - Exactness of the union: 'repeatAlong' prunes copies whose bounding
//   ball is farther than the best so far; over 2048 hashed points it gives
//   exactly the minimum over every copy (the same bits), for the horn and
//   for twisted beads. 'repeatAlongArc' (rotation-stepped frames) agrees
//   with it to 2e-6.
// - Twist: a flat box turned a quarter turn about the tangent at u = 1/2
//   lies across the other axis.
// - A sculpt.Path through 97 points of the same arc, read into frames and
//   arc lengths by sculpt (Path.curveFrames, Path.distances) and viewed as
//   a PathCurve, gives the arc's beads to 2e-3 (its pieces are chords); its
//   cells found once ('curveCellFrame' into a List, viewed as CurveCells,
//   'repeatAlongCells') give repeatAlong's bits, and 'curveCells' writes
//   the same frames into a List's slice ('viewMut').
// - The horn: at its base point, minus the base radius; a straight horn
//   with no ribs is a cone of balls, whose distance at radial distance x
//   and height y is x sqrt(1 - s^2) - r(y), s the radius's fall per unit
//   length (the union of balls of linearly falling radius); past the tip
//   along the end tangent, the distance less the tip radius (to 2e-3: the
//   last chord leaves the tangent by half a cell's turn).
// - Continuity across cell boundaries: at each boundary of the horn's 14
//   cells, points 1/1024 either side along the tangent, at offsets from
//   0.05 to 1 in each direction across, differ by no more than they are
//   apart (1 + 1/100).

mod curves;

import testing use *;
import libc;
import geomath use *;
import collections use *;
import noise;
import sculpt;
import sdf use *;

fn near(got f32, want f64, within f64, label &Array[u8]) { expectFloat(f64.from(got), want, within, label); }
fn sameVec(a Vec3, b Vec3) bool { a.x == b.x && a.y == b.y && a.z == b.z }

// A box shrinking along the curve and turned 'twist' radians over its length
struct Beads {
  pub size f32;
  pub twist f32;
  pub fn repeatedDistance(self &, q Vec3, index i32, u f32) f32 {
    let s = size * (1. - 0.5 * u);
    let c = cos(twist * u);
    let sn = sin(twist * u);
    box(new Vec3(q.x * c + q.y * sn, q.y * c - q.x * sn, q.z), new Vec3(s, s * 0.5, s * 0.25))
  }
  pub fn bound(self &, index i32, u f32) f32 { size * (1. - 0.5 * u) * 1.25 }
}

fn samplePoint(i i32) Vec3 {
  let h = noise.pcg3d(new noise.UVec3(u32.from(i), 4242u32, 17u32));
  new Vec3(noise.toSigned(h.x) * 2.5, noise.toSigned(h.y) * 2.5 + 1.5, noise.toSigned(h.z) * 1.5)
}

// The minimum over every copy, no pruning
fn everyCopy[S Repeated](arc &Arc, shape &S, p Vec3, n i32) f32 {
  var d f32 = 3.4028235e38;
  var k = 0;
  while k < n {
    let u = (f32.from(k) + 0.5) / f32.from(n);
    let v = shape.repeatedDistance(arc.frameAt(u * arc.len).toLocal(p), k, u);
    if v < d { d = v; }
    k = k + 1;
  }
  d
}

fn arcs() {
  let arc = Arc.make(pi, pi * 0.5);
  near(arc.radius, 2.0, 0.000001, "radius");
  let f = arc.frameAt(pi * 0.5);
  near(f.origin.x, 0.58578644, 0.000002, "halfway: x");
  near(f.origin.y, 1.41421356, 0.000002, "halfway: y");
  near(f.tangent.x, 0.70710678, 0.000001, "halfway: tangent x");
  near(f.tangent.y, 0.70710678, 0.000001, "halfway: tangent y");
  near(f.normal.x, -0.70710678, 0.000001, "halfway: normal x");
  near(f.normal.y, 0.70710678, 0.000001, "halfway: normal y");
  near(f.binormal.z, 1.0, 0.0, "binormal +z");
  let right = f.normal.cross(f.binormal);
  near(right.x - f.tangent.x, 0.0, 0.000001, "normal x binormal = tangent");
  let pr = arc.project(f.origin + f.normal);
  near(pr.s, 1.57079633, 0.000002, "projected: arc length");
  near(pr.distance, 1.0, 0.000002, "projected: distance");
  let end = arc.point(arc.len);
  near(end.x, 2.0, 0.000002, "end: x");
  near(end.y, 2.0, 0.000002, "end: y");
  let before = arc.project(new Vec3(-1., -1., 0.));
  near(before.s, 0.0, 0.0, "before the start: clamped");
  near(before.distance, 1.41421356, 0.000001, "before the start: to the start");
  let straight = Arc.make(3., 0.);
  near(straight.project(new Vec3(1., 2., 0.)).distance, 1.0, 0.0, "straight: distance");
  near(straight.nearest(new Vec3(1., 2., 0.)), 2.0, 0.0, "straight: arc length");

  // The cells' frames, stepped round, against trigonometry
  let cells = arc.cells(12);
  var c = cells.firstCos;
  var s = cells.firstSin;
  var worst = 0.0;
  var k = 0;
  while k < 12 {
    let want = arc.frameAt((f32.from(k) + 0.5) * cells.step);
    let o = new Vec3(arc.radius - arc.radius * c, arc.radius * s, 0.) - want.origin;
    let e = f64.from(o.length());
    if e > worst { worst = e; }
    let nc = c * cells.turnCos - s * cells.turnSin;
    s = s * cells.turnCos + c * cells.turnSin;
    c = nc;
    k = k + 1;
  }
  near(f32.from(worst), 0.0, 0.000002, "cells stepped round by rotation");
}

fn unions() {
  let arc = Arc.make(3., 2.);
  let cells = arc.cells(10);
  let beads = new Beads(0.25, 1.5);
  let horn = Horn.make(3., 0.3, 0.9, 2., 14, 0.12);
  var prunedBeads = 0;
  var prunedHorn = 0;
  var worstArc = 0.0;
  var i = 0;
  while i < 2048 {
    let p = samplePoint(i);
    if repeatAlong(&arc, &beads, p, 10) == everyCopy(&arc, &beads, p, 10) { prunedBeads = prunedBeads + 1; }
    if repeatAlong(&horn.arc, &horn, p, 14) == everyCopy(&horn.arc, &horn, p, 14) { prunedHorn = prunedHorn + 1; }
    let e = f64.from(repeatAlongArc(&arc, &cells, &beads, p) - repeatAlong(&arc, &beads, p, 10));
    let ae = if e < 0.0 { -e } else { e };
    if ae > worstArc { worstArc = ae; }
    i = i + 1;
  }
  expectInt(i64.from(prunedBeads), 2048, "beads: the pruned union is every copy's minimum");
  expectInt(i64.from(prunedHorn), 2048, "horn: the pruned union is every copy's minimum");
  near(f32.from(worstArc), 0.0, 0.000002, "repeatAlongArc agrees with repeatAlong");

  // Twist: at u = 1/2 a quarter turn, so the flat box (long along the
  // normal) lies along the binormal
  let line = Arc.make(2., 0.);
  let flat = new Beads(0.5, pi);
  // The copy's size at u = 1/2 is 0.375: 0.375 x 0.1875 x 0.09375
  near(repeatAlong(&line, &flat, new Vec3(0., 1., 0.5), 1), 0.5 - 0.375, 0.000001, "twisted: along the binormal");
  near(repeatAlong(&line, &flat, new Vec3(0.5, 1., 0.), 1), 0.5 - 0.1875, 0.000001, "twisted: across the normal");

  // A sculpt.Path through the same arc
  var pts = List[Vec3].empty();
  var j = 0;
  while j <= 96 {
    pts.push(arc.point(3. * f32.from(j) / 96.));
    j = j + 1;
  }
  let path = sculpt.Path.fromPoints(pts.view(), false);
  let pathFrames = path.curveFrames();
  let pathDistances = path.distances();
  let curve = PathCurve.make(pathFrames.view(), pathDistances.view());
  near(curve.length(), 3.0, 0.001, "path: its length");
  let plain = new Beads(0.25, 0.);
  var worstPath = 0.0;
  i = 0;
  while i < 512 {
    let p = samplePoint(i);
    let e = f64.from(repeatAlong(&curve, &plain, p, 10) - repeatAlong(&arc, &plain, p, 10));
    let ae = if e < 0.0 { -e } else { e };
    if ae > worstPath { worstPath = ae; }
    i = i + 1;
  }
  near(f32.from(worstPath), 0.0, 0.002, "a PathCurve through the arc gives its beads");
  // Its cells found once give repeatAlong's bits, for plain and twisted beads
  var cellFrames = List[CurveFrame].withCapacity(10usize);
  var k = 0;
  while k < 10 {
    cellFrames.push(curveCellFrame(&curve, k, 10));
    k = k + 1;
  }
  let pathCells = new CurveCells(cellFrames.view());
  // The same frames written into a List's slice, sized to the count
  var written = List[CurveFrame].withCapacity(10usize);
  k = 0;
  while k < 10 {
    written.push(*cellFrames[0usize]);
    k = k + 1;
  }
  curveCells(&curve, written.viewMut());
  var sameFrames = 0;
  k = 0;
  while k < 10 {
    let a = *written[usize.from(k)];
    let b = *cellFrames[usize.from(k)];
    if sameVec(a.origin, b.origin) && sameVec(a.normal, b.normal) && sameVec(a.binormal, b.binormal)
      && sameVec(a.tangent, b.tangent) {
      sameFrames = sameFrames + 1;
    }
    k = k + 1;
  }
  expect(sameFrames == 10, "curveCells writes curveCellFrame's frames");
  let twisted = new Beads(0.25, 1.5);
  var sameBits = 0;
  i = 0;
  while i < 2048 {
    let p = samplePoint(i);
    if repeatAlongCells(&pathCells, &plain, p) == repeatAlong(&curve, &plain, p, 10) { sameBits = sameBits + 1; }
    if repeatAlongCells(&pathCells, &twisted, p) == repeatAlong(&curve, &twisted, p, 10) { sameBits = sameBits + 1; }
    i = i + 1;
  }
  expect(sameBits == 4096, "repeatAlongCells gives repeatAlong's bits");
}

fn horns() {
  let horn = Horn.make(3., 0.3, 0.9, 2., 14, 0.12);
  near(horn.distance(new Vec3(0., 0., 0.)), -0.3, 0.000001, "at the base point");
  // A straight cone of balls: base 0.5 falling to 0.25 over 2
  let cone = Horn.make(2., 0.5, 0.5, 0., 0, 0.);
  let fall = 0.125;
  near(cone.distance(new Vec3(2., 1., 0.)), 2.0 * libc.sqrt(1.0 - fall * fall) - 0.375, 0.000002, "straight: the side");
  near(cone.distance(new Vec3(0., 3., 0.)), 1.0 - 0.25, 0.000002, "straight: past the tip");
  // Past a curled horn's tip along its tangent
  let tip = horn.arc.frameAt(3.);
  near(horn.distance(tip.origin + tip.tangent), 1.0 - 0.03, 0.002, "curled: past the tip");
  near(horn.distance(tip.origin), -0.03, 0.002, "curled: at the tip");

  // Continuity across the cells' boundaries
  var worst = 0.0;
  var k = 1;
  while k < 14 {
    let f = horn.arc.frameAt(f32.from(k) * 3. / 14.);
    var j = 0;
    while j < 20 {
      let off = 0.05 + f32.from(j) * 0.05;
      let dirs Array[Vec3, 4] = [f.normal, f.binormal, f.normal * -1., f.binormal * -1.];
      var di = 0usize;
      while di < 4usize {
        let at = f.origin + dirs[di] * off;
        let step = f.tangent * 0.0009765625;
        let e = f64.from(horn.distance(at + step) - horn.distance(at - step));
        let r = (if e < 0.0 { -e } else { e }) / 0.001953125;
        if r > worst { worst = r; }
        di = di + 1usize;
      }
      j = j + 1;
    }
    k = k + 1;
  }
  expect(worst <= 1.01, "continuous across every cell boundary");
}

fn main() i32 {
  arcs();
  unions();
  horns();
  done()
}
