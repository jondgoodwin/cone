// divExact and sqrtExact, division and square root from integer steps, are
// the CPU's own, bit for bit: 1,000,000 pairs of finite f32s from a hash (a
// quarter of them subnormal or near it, a quarter in a mesher's range, a
// crossing's d0 / (d0 - d1)), every one identical to the CPU's division,
// and 1,000,000 square roots to sqrtf; and the corners: exact squares, the
// least subnormal, the largest finite, ties to even among subnormals. Only a
// failure prints.

mod exact;

import testing use *;
import stdio use *;
import noise use pcg;
import sdf use *;


fn main() i32 {
  var divMismatch = 0u32;
  var divCompared = 0u32;
  var i = 0u32;
  while i < 1000000u32 {
    var ua = pcg(i * 2u32);
    var ub = pcg(i * 2u32 + 1u32);
    let kind = i % 4u32;
    if kind == 1u32 {
      // Subnormal or tiny: exponent 0 to 3
      ua = (ua & 0x807fffffu32) | ((ua >> 8u32) & 0x01800000u32);
      if (i & 8u32) != 0u32 { ub = (ub & 0x807fffffu32) | ((ub >> 8u32) & 0x01800000u32); }
    } else if kind == 2u32 {
      // A crossing: d0 and d1 of opposite signs, near a cell's size
      let d0 = f32.fromBits((ua & 0x007fffffu32) | 0x3c000000u32);
      let d1 = f32.fromBits((ub & 0x007fffffu32) | 0xbc000000u32 | ((ub & 0x00000300u32) << 15u32));
      ua = d0.bits();
      ub = (d0 - d1).bits();
    }
    let a = f32.fromBits(ua);
    let b = f32.fromBits(ub);
    let ea = (ua >> 23u32) & 0xffu32;
    let eb = (ub >> 23u32) & 0xffu32;
    if ea != 255u32 && eb != 255u32 && (ub & 0x7fffffffu32) != 0u32 {
      if (divExact(a, b)).bits() != (a / b).bits() {
        if divMismatch == 0u32 {
          print <- "divExact differs: "; print <- u64.from(ua); print <- " / "; print <- u64.from(ub); print <- "\n";
        }
        divMismatch = divMismatch + 1u32;
      }
      divCompared = divCompared + 1u32;
    }
    i = i + 1u32;
  }
  expectUInt(u64.from(divMismatch), 0u64, "divExact: every quotient the CPU's");
  expect(divCompared > 990000u32, "divExact: most pairs finite");

  var sqrtMismatch = 0u32;
  i = 0u32;
  while i < 1000000u32 {
    var u = pcg(i ^ 0x5bd1e995u32) & 0x7fffffffu32;
    if i % 4u32 == 1u32 { u = u & 0x00ffffffu32; }
    if ((u >> 23u32) & 0xffu32) != 255u32 && u != 0u32 {
      let x = f32.fromBits(u);
      if (sqrtExact(x)).bits() != (x.sqrt()).bits() {
        if sqrtMismatch == 0u32 { print <- "sqrtExact differs at "; print <- u64.from(u); print <- "\n"; }
        sqrtMismatch = sqrtMismatch + 1u32;
      }
    }
    i = i + 1u32;
  }
  expectUInt(u64.from(sqrtMismatch), 0u64, "sqrtExact: every root the CPU's");
  // Corners: exact squares, the smallest subnormal, the largest finite
  expectUInt(u64.from((sqrtExact(4.)).bits()), u64.from(2..bits()), "sqrtExact(4)");
  expectUInt(u64.from((sqrtExact(f32.fromBits(1u32))).bits()), u64.from(((f32.fromBits(1u32)).sqrt()).bits()), "sqrtExact(min subnormal)");
  expectUInt(u64.from((sqrtExact(f32.fromBits(0x7f7fffffu32))).bits()), u64.from(((f32.fromBits(0x7f7fffffu32)).sqrt()).bits()),
    "sqrtExact(max)");
  expectUInt(u64.from((divExact(f32.fromBits(1u32), 2.)).bits()), u64.from(((f32.fromBits(1u32)) / 2.).bits()),
    "divExact: half the least subnormal, to even");
  expectUInt(u64.from((divExact(f32.fromBits(3u32), 2.)).bits()), u64.from(((f32.fromBits(3u32)) / 2.).bits()),
    "divExact: 1.5 least subnormals, to even");
  done()
}
