// The sdf package against its Slang twin, sdf.slang, on a real GPU.
//
// parity.slang draws a 64 x 256 rgba8unorm target, each pixel one quantity
// (its column: a primitive, an operator, a fillet, the horn, its gradient,
// noise detail) at one sample point (its row), its 32 bits one byte per
// channel, so the readback holds the GPU's exact bits. This program computes
// the same table with the Cone package and compares, quantity by quantity,
// against the tolerance 'tolerance' gives it:
//
// - Exact: what uses only add, subtract, multiply, min, max, abs, floor
//   and comparisons, compiled with '-fp-mode precise' (no contraction): the
//   plane, the rotation, the mirror.
// - Within 2^-19 (about 2e-6): what takes a square root or divides, neither
//   of which Vulkan rounds correctly (to within 3 and 2.5 ulps); a last-place
//   difference in an intermediate can grow when a later step subtracts, so
//   the bound is absolute. Measured on the RTX 4060 and the UHD 770: at most
//   7.2e-7, the ellipsoid's.
// - Within 2^-16 (about 1.5e-5): the arc (atan2, cos, sin) and what is built
//   on it, the horn and repetition along the arc. Vulkan allows these an
//   absolute 2^-11 in (-pi, pi), so a driver could conform and fail here;
//   both GPUs measured at most 4.8e-7.
// - Within 2^-12: the horn's gradient and normal, differences of distances
//   over 2 h = 1/32. Measured at most 1.5e-5.
//
// The bounds are the measured differences with a margin, not Vulkan's, so
// that a change to the order of operations on one side shows.
//
// Every sample point is a multiple of 1/32, exact in binary.
//
// Only a failure prints. With SDF_PARITY_REPORT set, it also prints the
// adapter and, for each quantity, how many of the 256 agree bit for bit and
// the largest difference. GPU_POWER_PREFERENCE=low-power tests the
// integrated GPU where there are two.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll (which loads Vulkan);
// no window, no display of its own, and no Vulkan SDK (with it, validation
// and synchronization validation are on, and must say nothing).

mod parity;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import gpu use *;
import sdf use *;

const WIDTH = 64u32;
const HEIGHT = 256u32;
const QUANTITIES = 58u32;

fn bits(f f32) u32 { f as u32; }
fn fromBits(b u32) f32 { b as f32; }

// Sample point 'a' (0 to 255), as parity.slang's 'samplePoint'
fn samplePoint(a u32) Vec3 {
  imm gx = a % 16u32;
  imm gy = a / 16u32;
  Vec3[f32[gx] * 0.25 - 1.96875, f32[gy] * 0.25 - 0.46875, f32[gx ^ gy] * 0.125 - 0.96875];
}

// parity.slang's Beads: a box shrinking along an arc and turning about the
// tangent, 1.5 radians over its length
struct Beads {
  pub size f32;
  pub fn repeatedDistance(self &, q Vec3, index i32, u f32) f32 {
    imm s = size * (1. - 0.5 * u);
    imm c = cos(1.5 * u);
    imm sn = sin(1.5 * u);
    imm t = Vec3[q.x * c + q.y * sn, q.y * c - q.x * sn, q.z];
    box(t, Vec3[s, s * 0.5, s * 0.25]);
  }
  pub fn bound(self &, index i32, u f32) f32 { size * (1. - 0.5 * u) * 1.25; }
}

fn turn() Quat { Quat[0.36, 0.48, 0., 0.8]; }

// Quantity 'q' at sample point 'p': parity.slang's 'quantity'
fn quantity(q u32, p Vec3) f32 {
  imm a = sphere(p - Vec3[0.25, 1., 0.], 0.75);
  imm b = box(p - Vec3[-0.25, 0.5, 0.], Vec3[0.5, 0.5, 0.5]);
  if q == 0u32 { return sphere(p, 1.25); }
  if q == 1u32 { return box(p, Vec3[0.75, 1., 0.5]); }
  if q == 2u32 { return roundBox(p, Vec3[0.75, 1., 0.5], 0.25); }
  if q == 3u32 { return capsule(p, Vec3[-0.5, 0., 0.], Vec3[0.5, 1.5, 0.25], 0.375); }
  if q == 4u32 { return torus(p, 1., 0.25); }
  if q == 5u32 { return cylinder(p, 1., 0.5); }
  if q == 6u32 { return cone(p, 1., 0.75, 0.25); }
  if q == 7u32 { return roundCone(p, 0.5, 0.25, 1.5); }
  if q == 8u32 { return plane(p, Vec3[0.6, 0.8, 0.], 0.5); }
  if q == 9u32 { return ellipsoid(p, Vec3[1., 0.5, 0.75]); }
  if q == 10u32 { return union(a, b); }
  if q == 11u32 { return subtract(a, b); }
  if q == 12u32 { return intersect(a, b); }
  if q == 13u32 { return smoothUnion(a, b, 0.25); }
  if q == 14u32 { return smoothUnionBlend(a, b, 0.25).distance; }
  if q == 15u32 { return smoothUnionBlend(a, b, 0.25).blend; }
  if q == 16u32 { return smoothSubtract(a, b, 0.25); }
  if q == 17u32 { return smoothIntersect(a, b, 0.25); }
  if q == 18u32 { return onion(a, 0.125); }
  if q == 19u32 { return round(b, 0.125); }
  if q == 20u32 { return exclusive(a, b); }
  if q < 24u32 {
    imm r = rotate(p, turn());
    return if q == 21u32 { r.x; } elif q == 22u32 { r.y; } else { r.z; };
  }
  if q == 24u32 {
    imm pl = Placement[Vec3[0.5, 1., 0.], turn(), 1.5];
    return pl.distance(box(pl.toLocal(p), Vec3[0.5, 0.25, 0.375]));
  }
  if q < 27u32 {
    imm m = mirror(p, Vec3[0.6, 0.8, 0.], -1.);
    return if q == 25u32 { m.x; } else { m.y; };
  }
  if q == 27u32 { return sphere(repeat(p, Vec3[1., 1.5, 0.75]), 0.3); }
  if q == 28u32 { return sphere(repeatLimited(p, 0.75, Vec3[1., 2., 1.]), 0.25); }
  if q == 29u32 { return torus(elongate(p, Vec3[0.5, 0., 0.25]), 0.75, 0.2); }
  if q == 30u32 { return unionRound(a, b, 0.3); }
  if q == 31u32 { return intersectRound(a, b, 0.3); }
  if q == 32u32 { return subtractRound(a, b, 0.3); }
  if q == 33u32 { return unionChamfer(a, b, 0.3); }
  if q == 34u32 { return unionColumns(a, b, 0.5, 4.); }
  if q == 35u32 { return unionStairs(a, b, 0.5, 4.); }
  if q == 36u32 { return intersectStairs(a, b, 0.5, 4.); }
  if q == 37u32 { return subtractStairs(a, b, 0.5, 4.); }
  if q == 38u32 { return pipe(a, b, 0.1); }
  if q == 39u32 { return groove(a, b, 0.1, 0.1); }
  if q == 40u32 { return tongue(a, b, 0.1, 0.1); }
  if q == 41u32 { return engrave(a, b, 0.1); }
  if q < 44u32 {
    imm arc = Arc.make(3., 2.);
    imm pr = arc.project(p);
    return if q == 42u32 { pr.s; } else { pr.distance; };
  }
  imm horn = Horn.make(3., 0.3, 0.9, 2., 14, 0.12);
  if q == 44u32 { return horn.distance(p); }
  if q < 48u32 {
    imm g = gradient(&horn, p, 0.015625);
    return if q == 45u32 { g.x; } elif q == 46u32 { g.y; } else { g.z; };
  }
  if q < 51u32 {
    imm n = normal(&horn, p, 0.015625);
    return if q == 48u32 { n.x; } elif q == 49u32 { n.y; } else { n.z; };
  }
  if q == 51u32 {
    imm straight = Horn.make(2.5, 0.4, 0.5, 0., 9, 0.2);
    return straight.distance(p);
  }
  if q == 52u32 {
    imm beads = Beads[0.25];
    imm arc = Arc.make(3., 2.);
    return repeatAlong(&arc, &beads, p, 10);
  }
  if q == 53u32 { return displace(a, p, 7u32, 3, 2., 0.1); }
  if q == 54u32 { return fbmDetail(a, p, 7u32, 4, 0.5); }
  if q == 55u32 { return latticeSpheres(p * 2., 7u32); }
  if q == 56u32 {
    imm beads = Beads[0.25];
    imm arc = Arc.make(3., 2.);
    imm cells = arc.cells(10);
    return repeatAlongArc(&arc, &cells, &beads, p);
  }
  if q == 57u32 {
    imm curled = Horn.make(4., 0.35, 1., 4.5, 20, 0.15);
    return curled.distance(p);
  }
  0.;
}

// How far quantity 'q' may differ, absolutely. 0: bit for bit
fn tolerance(q u32) f64 {
  // Only add, subtract, multiply, min, max, abs, floor
  if q == 8u32 or (q >= 21u32 and q <= 23u32) or q == 25u32 or q == 26u32 { return 0d; }
  // The horn's gradient and normal: its distances' differences over 2 h
  if q >= 45u32 and q <= 50u32 { return 0.000244140625d; }
  // The arc and what is built on it: trigonometry
  if (q >= 42u32 and q <= 52u32) or q >= 56u32 { return 0.0000152587890625d; }
  // Square roots and divisions
  0.0000019073486328125d;
}

fn main() i32 {
  mut instance = Instance.create("sdf parity");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize {
    if libc.strcmp(env, &"low-power" as *u8) == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  imm report = (libc.getenv(&"SDF_PARITY_REPORT" as *u8) as usize) != 0usize;
  mut adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");

  imm target = TextureDescriptor[WIDTH, HEIGHT, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC];
  mut color = device.createTexture(&target);
  require(color.isValid(), "a 64 x 256 target");
  mut readback = device.createBuffer(u64[WIDTH * HEIGHT * 4u32], BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm p = readback.mappedRange();

  mut shader = device.createShaderModule(&PARITY_SPIRV);
  mut layout = device.createEmptyPipelineLayout(0u32);
  imm noBuffers = List[VertexBufferLayout].empty();
  imm desc = RenderPipelineDescriptor[layout: &layout, vertexModule: &shader, buffers: noBuffers.view(),
    fragmentModule: &shader, colorFormat: TEXTURE_FORMAT_RGBA8_UNORM];
  mut pipeline = device.createRenderPipeline(&desc);
  require(pipeline.isValid(), "the parity pipeline");
  {
    mut encoder = device.createCommandEncoder();
    imm attachment = RenderPassColorAttachment[view: color.createView(), clearValue: Color[0., 0., 0., 0.]];
    mut pass = encoder.beginRenderPass(&attachment);
    pass.setPipeline(&pipeline);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
    encoder.copyTextureToBuffer(&color, &readback);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
  }

  if report {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr("\nquantity  exact/256  max|diff|  tolerance\n");
  }
  mut q = 0u32;
  while q < QUANTITIES {
    mut exact = 0u32;
    mut maxDiff = 0d;
    mut a = 0u32;
    while a < HEIGHT {
      imm at = p + usize[(a * WIDTH + q) * 4u32];
      imm gpuBits = u32[*at] | (u32[*(at + 1usize)] << 8u32) | (u32[*(at + 2usize)] << 16u32)
        | (u32[*(at + 3usize)] << 24u32);
      imm cpuBits = bits(quantity(q, samplePoint(a)));
      if gpuBits == cpuBits {
        exact = exact + 1u32;
      } else {
        imm d = f64[fromBits(gpuBits)] - f64[fromBits(cpuBits)];
        imm ad = if d < 0d { -d; } else { d; };
        if ad > maxDiff or ad != ad { maxDiff = ad; }
      }
      a = a + 1u32;
    }
    if report {
      printUInt(u64[q]);
      printStr("  ");
      printUInt(u64[exact]);
      printStr("  ");
      printFloat(maxDiff);
      printStr("  ");
      printFloat(tolerance(q));
      printStr("\n");
    }
    imm ok = if tolerance(q) == 0d { exact == HEIGHT; } else { maxDiff <= tolerance(q); };
    if !ok {
      printStr("quantity ");
      printUInt(u64[q]);
      printStr(": ");
    }
    if tolerance(q) == 0d {
      expectUInt(u64[exact], u64[HEIGHT], "every sample bit for bit");
    } else {
      expectFloat(maxDiff, 0d, tolerance(q), "within the tolerance");
    }
    q = q + 1u32;
  }

  expectUInt(u64[failures()], 0u64, "no Vulkan call failed");
  expectUInt(u64[validationMessages()], 0u64, "no validation message");
  done();
}

