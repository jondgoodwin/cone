// The sdf package's primitives, operators, domain operators and fillets at
// points whose distances are known by hand. Only a failure prints.
//
// - Primitives: a point on an axis or a diagonal, outside, on and inside.
//   A cone with its apex at y = 1 and a base of radius 1 at y = -1 has its
//   side on the line from (1, -1) to (0, 1), whose outward normal is
//   (2, 1) / sqrt 5: the origin is 1 / sqrt 5 inside it, (2, 0) is
//   3 / sqrt 5 outside, its foot (0.8, -0.6) on the side.
// - Smooth union, k = 1/4: two equal distances d give d - k; distances 1
//   and 1.5 give h = 1/2 and 1 - h^2 k = 0.9375, blend h^2 / 2 = 0.125;
//   distances 1 apart or more (4 k) give the hard union.
// - Domain: a sphere asked at a translated, scaled or placed point gives the
//   moved shape's exact distance; a quarter turn about z carries +y to +x
//   in the shape's own space; repetition and mirroring by exact multiples.
// - Fillets: hg_sdf's quarter-round with a = b = 1/4, r = 1/2 is r - the
//   distance from (a, b) to (r, r): 0.5 - sqrt(0.125); far from both
//   shapes each fillet is the plain union.
// - Membranes: the flat 2 x 1 sheet between the spars (0,0,0)-(2,0,0) and
//   (0,0,1)-(2,0,1) is 1/2 from a point 1/2 above or below it, 0 on it, 1
//   from a point 1 beyond its u = 1 edge. Scalloped by 1/2, its free edge
//   is at z = 1 - 2 u (1 - u), 1/2 in the middle, so (1, 0, 0.9) is 0.4
//   from it (squared distance 0.16 + 2.4 du^2), (1, 0.3, 0.5) is 0.3 above
//   that edge point (squared distance 0.09 + 4 du^2 + ...), and the corner
//   (0, 0, 1) stays. With b0 = b1 = (0,0,2) it is the triangle (0,0,0), (2,0,0),
//   (0,0,2), and (0.5, 1, 0.5) is 1 above it. The twisted sheet between
//   (0,0,0)-(1,0,0) and (0,0,1)-(1,1,1) is (u, uv, v); at (1/2, 1/2) its
//   normal is (1/2, -1, 1/2) / sqrt(3/2), and the point 0.1 along it is 0.1
//   away (within 1e-4: the sheet's curvature radius there is over 1).

mod distances;

import testing use *;
import geomath use *;
import sdf use *;

const EPS f64 = 0.000002d;

fn near(got f32, want f64, label &[]u8) { expectFloat(f64.from(got), want, EPS, label); }

fn primitives() {
  near(sphere(new Vec3(3., 4., 0.), 2.), 3d, "sphere outside");
  near(sphere(new Vec3(0., 0., 0.), 2.), -2d, "sphere centre");
  near(box(new Vec3(2., 0., 0.), new Vec3(1., 1., 1.)), 1d, "box face");
  near(box(new Vec3(2., 2., 0.), new Vec3(1., 1., 1.)), 1.41421356d, "box edge");
  near(box(new Vec3(0., 0., 0.), new Vec3(1., 2., 3.)), -1d, "box centre");
  near(box(new Vec3(0.5, 0., 0.), new Vec3(1., 1., 1.)), -0.5d, "box inside");
  near(roundBox(new Vec3(3., 0., 0.), new Vec3(1., 1., 1.), 0.25), 2d, "round box face");
  near(roundBox(new Vec3(2., 2., 0.), new Vec3(1., 1., 1.), 0.25), 1.76776695d - 0.25d, "round box edge");
  near(capsule(new Vec3(0., 1., 2.), new Vec3(0., 0., 0.), new Vec3(0., 3., 0.), 0.5), 1.5d, "capsule side");
  near(capsule(new Vec3(0., -2., 0.), new Vec3(0., 0., 0.), new Vec3(0., 3., 0.), 0.5), 1.5d, "capsule end");
  near(capsule(new Vec3(0., 1., 0.), new Vec3(0., 0., 0.), new Vec3(0., 3., 0.), 0.5), -0.5d, "capsule axis");
  near(torus(new Vec3(3., 0., 0.), 2., 0.5), 0.5d, "torus outside");
  near(torus(new Vec3(0., 0., 0.), 2., 0.5), 1.5d, "torus hole");
  near(torus(new Vec3(0., 1., 2.), 2., 0.5), 0.5d, "torus above");
  near(torus(new Vec3(2., 0., 0.), 2., 0.5), -0.5d, "torus ring");
  near(cylinder(new Vec3(2., 0., 0.), 1., 1.), 1d, "cylinder side");
  near(cylinder(new Vec3(0., 3., 0.), 1., 1.), 2d, "cylinder cap");
  near(cylinder(new Vec3(2., 3., 0.), 1., 1.), 2.23606798d, "cylinder rim");
  near(cylinder(new Vec3(0., 0., 0.), 1., 1.), -1d, "cylinder centre");
  near(cone(new Vec3(0., 3., 0.), 1., 1., 0.), 2d, "cone apex");
  near(cone(new Vec3(0., -3., 0.), 1., 1., 0.), 2d, "cone base");
  near(cone(new Vec3(0., 0., 0.), 1., 1., 0.), -0.44721360d, "cone inside");
  near(cone(new Vec3(2., 0., 0.), 1., 1., 0.), 1.34164079d, "cone side");
  near(cone(new Vec3(0., 0., 3.), 1., 1., 1.), 2d, "a cone of equal radii is a cylinder");
  near(roundCone(new Vec3(0., -1., 0.), 0.5, 0.25, 2.), 0.5d, "round cone bottom");
  near(roundCone(new Vec3(0., 4., 0.), 0.5, 0.25, 2.), 1.75d, "round cone top");
  near(roundCone(new Vec3(0., 1., 0.), 0.5, 0.25, 2.), -0.375d, "round cone axis");
  // A tapered capsule up y is the round cone; along z, the same turned
  imm o = new Vec3(0., 0., 0.);
  imm up2 = new Vec3(0., 2., 0.);
  near(taperedCapsule(new Vec3(0., -1., 0.), o, up2, 0.5, 0.25), 0.5d, "tapered capsule bottom");
  near(taperedCapsule(new Vec3(0., 4., 0.), o, up2, 0.5, 0.25), 1.75d, "tapered capsule top");
  near(taperedCapsule(new Vec3(0., 1., 0.), o, up2, 0.5, 0.25), -0.375d, "tapered capsule axis");
  near(taperedCapsule(new Vec3(1.5, 1., 0.), o, up2, 0.5, 0.25), f64.from(roundCone(new Vec3(1.5, 1., 0.), 0.5, 0.25, 2.)),
    "tapered capsule side, as the round cone");
  near(taperedCapsule(new Vec3(1., 2.5, 2.), new Vec3(1., 1., 1.), new Vec3(1., 1., 3.), 0.5, 0.25),
    f64.from(roundCone(new Vec3(1.5, 1., 0.), 0.5, 0.25, 2.)), "tapered capsule along z, turned");
  near(taperedCapsule(new Vec3(0., 1., 2.), o, new Vec3(0., 3., 0.), 0.5, 0.5), 1.5d, "tapered capsule of equal radii");
  near(taperedCapsule(new Vec3(3., 0., 0.), o, new Vec3(0., 0.1, 0.), 1., 0.5), 2d, "tapered capsule, one ball in the other");
  near(taperedCapsule(o, up2, o, 0.25, 0.5), -0.5d, "tapered capsule reversed");
  // The triangle (0, 0, 0), (2, 0, 0), (0, 2, 0)
  imm tb = new Vec3(2., 0., 0.);
  imm tc = new Vec3(0., 2., 0.);
  near(triangle(new Vec3(0.5, 0.5, 3.), o, tb, tc), 3d, "triangle above");
  near(triangle(new Vec3(0.5, 0.5, -1.), o, tb, tc), 1d, "triangle below");
  near(triangle(new Vec3(0.5, 0.5, 0.), o, tb, tc), 0d, "triangle on it");
  near(triangle(new Vec3(-1., 1., 0.), o, tb, tc), 1d, "triangle beside an edge");
  near(triangle(new Vec3(3., 0., 0.), o, tb, tc), 1d, "triangle beyond a corner");
  near(triangle(new Vec3(2., 2., 0.), o, tb, tc), 1.41421356d, "triangle beyond the long edge");
  near(triangle(new Vec3(1., -1., 1.), o, tb, tc), 1.41421356d, "triangle below and beside an edge");
  near(triangle(new Vec3(1., 1., 1.), o, tb, tc), 1d, "triangle over the long edge");
  near(triangle(new Vec3(0.5, 0.5, 3.), o, tc, tb), 3d, "triangle wound the other way");
  near(triangle(new Vec3(3., 2., 0.), o, tb, o), 2.23606798d, "a degenerate triangle is its edges");
  near(plane(new Vec3(1., 2., 3.), new Vec3(0., 1., 0.), -1.), 1d, "plane");
  near(ellipsoid(new Vec3(2., 0., 0.), new Vec3(1., 0.5, 0.5)), 1d, "ellipsoid on its long axis");
  near(ellipsoid(new Vec3(0., 1., 0.), new Vec3(1., 0.5, 0.5)), 0.5d, "ellipsoid on a short axis");
}

fn operators() {
  near(union(1., 2.), 1d, "union");
  near(subtract(-1., -0.5), 0.5d, "subtract");
  near(intersect(1., 2.), 2d, "intersect");
  near(smoothUnion(1., 1., 0.25), 0.75d, "smooth union, equal");
  near(smoothUnion(1., 1.5, 0.25), 0.9375d, "smooth union, 1/2 apart");
  near(smoothUnion(1., 2., 0.25), 1d, "smooth union, 4 k apart");
  near(smoothUnion(1., 1.5, 0.), 1d, "smooth union, k 0");
  imm b1 = smoothUnionBlend(1., 1., 0.25);
  near(b1.distance, 0.75d, "blend, equal: distance");
  near(b1.blend, 0.5d, "blend, equal: half");
  imm b2 = smoothUnionBlend(1., 1.5, 0.25);
  near(b2.distance, 0.9375d, "blend: distance");
  near(b2.blend, 0.125d, "blend: towards the nearer");
  imm b3 = smoothUnionBlend(1.5, 1., 0.25);
  near(b3.blend, 0.875d, "blend: the other way");
  imm b4 = smoothUnionBlend(1., 3., 0.25);
  near(b4.blend, 0d, "blend: far apart, all the first");
  near(smoothSubtract(1., -1., 0.25), 1.25d, "smooth subtract");
  near(smoothIntersect(1., 1., 0.25), 1.25d, "smooth intersect");
  near(onion(-0.5, 0.25), 0.25d, "onion");
  near(round(1., 0.25), 0.75d, "round");
  near(exclusive(-1., 2.), -1d, "exclusive: in one");
  near(exclusive(-1., -2.), 1d, "exclusive: in both");
}

fn domains() {
  near(sphere(translate(new Vec3(3., 0., 0.), new Vec3(1., 0., 0.)), 1.), 1d, "translate");
  imm quarter = Quat.angleAxis(pi * 0.5, new Vec3(0., 0., 1.));
  imm r = rotate(new Vec3(0., 1., 0.), quarter);
  near(r.x, 1d, "a quarter turn: +y is the shape's +x");
  near(r.y, 0d, "a quarter turn: y");
  near(r.z, 0d, "a quarter turn: z");
  near(scaleDistance(sphere(scalePoint(new Vec3(6., 0., 0.), 2.), 1.), 2.), 4d, "scale");
  imm pl = new Placement(new Vec3(5., 0., 0.), Quat.identity(), 2.);
  near(pl.distance(box(pl.toLocal(new Vec3(9., 0., 0.)), new Vec3(1., 1., 1.))), 2d, "placement");
  imm turned = new Placement(new Vec3(0., 0., 0.), quarter, 1.);
  near(box(turned.toLocal(new Vec3(0., 2.5, 0.)), new Vec3(2., 1., 1.)), 0.5d, "a turned box's long side along y");
  imm m = mirrorX(new Vec3(-3., 1., 2.));
  near(m.x, 3d, "mirror x");
  imm mp = mirror(new Vec3(0., -2., 0.), new Vec3(0., 1., 0.), 0.);
  near(mp.y, 2d, "mirror in a plane: the other side");
  imm keep = mirror(new Vec3(0., 2., 0.), new Vec3(0., 1., 0.), 0.);
  near(keep.y, 2d, "mirror in a plane: this side");
  near(repeat(new Vec3(2.25, 0., 0.), new Vec3(1., 1., 1.)).x, 0.25d, "repeat");
  near(repeat(new Vec3(-2.75, 0., 0.), new Vec3(1., 1., 1.)).x, 0.25d, "repeat, negative");
  near(repeatLimited(new Vec3(5.25, 0., 0.), 1., new Vec3(2., 0., 0.)).x, 3.25d, "repeat limited: past the last");
  near(repeatLimited(new Vec3(1.25, 0., 0.), 1., new Vec3(2., 0., 0.)).x, 0.25d, "repeat limited: within");
  near(elongate(new Vec3(3., 0., 0.), new Vec3(1., 0., 0.)).x, 2d, "elongate: outside");
  near(elongate(new Vec3(0.5, 0., 0.), new Vec3(1., 0., 0.)).x, 0d, "elongate: the middle");
}

fn fillets() {
  near(unionRound(1., 2., 0.5), 1d, "round: far");
  near(unionRound(0.25, 0.25, 0.5), 0.5d - 0.35355339d, "round: in the fillet");
  near(intersectRound(-1., -2., 0.5), -1d, "intersect round: deep");
  near(subtractRound(-1., 2., 0.5), -1d, "subtract round: deep");
  near(unionChamfer(0.5, 0.5, 0.5), 0.35355339d, "chamfer");
  near(unionColumns(2., 1., 0.5, 4.), 1d, "columns: far");
  near(unionStairs(3., 2., 0.5, 4.), 2d, "stairs: far");
  near(intersectStairs(-3., -2., 0.5, 4.), -2d, "intersect stairs: deep");
  near(pipe(0.3, 0.4, 0.1), 0.4d, "pipe");
  near(groove(-1., 0., 0.2, 0.1), -0.8d, "groove");
  near(tongue(1., 0., 0.2, 0.1), 0.8d, "tongue");
  near(engrave(-1., 0., 0.2), -0.56568542d, "engrave");
  // Columns in the seam: at a = b the columns' ribs, never outside the
  // plain union or beyond the chamfer's diagonal
  mut t f32 = 0.;
  mut ok = true;
  while t < 0.5 {
    imm c = unionColumns(t, t, 0.5, 4.);
    if c > t + 0.000001 { ok = false; }
    t = t + 0.03125;
  }
  expect(ok, "columns never exceed the union");
}

fn membranes() {
  imm o = new Vec3(0., 0., 0.);
  imm x2 = new Vec3(2., 0., 0.);
  imm z1 = new Vec3(0., 0., 1.);
  imm xz = new Vec3(2., 0., 1.);
  near(membrane(new Vec3(1., 0.5, 0.5), o, x2, z1, xz, 0.), 0.5d, "membrane above");
  near(membrane(new Vec3(1., -0.5, 0.25), o, x2, z1, xz, 0.), 0.5d, "membrane below");
  near(membrane(new Vec3(1.5, 0., 0.75), o, x2, z1, xz, 0.), 0d, "membrane on it");
  near(membrane(new Vec3(3., 0., 0.5), o, x2, z1, xz, 0.), 1d, "membrane beyond an edge");
  near(membrane(new Vec3(1., 0., 0.9), o, x2, z1, xz, 0.5), 0.4d, "membrane: beyond the scallop");
  near(membrane(new Vec3(1., 0., 0.4), o, x2, z1, xz, 0.5), 0d, "membrane: inside the scallop");
  near(membrane(new Vec3(1., 0.3, 0.5), o, x2, z1, xz, 0.5), 0.3d, "membrane: above the scallop's edge");
  near(membrane(new Vec3(0., 0., 1.5), o, x2, z1, xz, 0.5), 0.5d, "membrane: the scallop keeps the corner");
  imm z2 = new Vec3(0., 0., 2.);
  near(membrane(new Vec3(0.5, 1., 0.5), o, x2, z2, z2, 0.), 1d, "membrane as a triangle");
  imm tw = new Vec3(0.5, 0.25, 0.5) + new Vec3(0.5, -1., 0.5) * (0.1 / 1.22474487);
  expectFloat(f64.from(membrane(tw, o, new Vec3(1., 0., 0.), z1, new Vec3(1., 1., 1.), 0.)), 0.1d, 0.0001d, "membrane twisted");
}

fn main() i32 {
  primitives();
  membranes();
  operators();
  domains();
  fillets();
  done();
}
