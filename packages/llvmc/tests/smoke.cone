mod smoke;

import stdio use *;
import collections use *;
import llvmc;

fn main() i32 {
  llvmc.InitializeAllTargetInfos();
  imm ctx = llvmc.ContextCreate();
  imm m = llvmc.ModuleCreateWithNameInContext("probe", ctx);
  imm i32t = llvmc.Int32TypeInContext(ctx);
  match llvmc.GetTypeKind(i32t) {
    case is IntegerTypeKind { print <- "integer\n"; }
    else { print <- "other\n"; }
  }
  imm text = llvmc.moduleToString(m);
  print <- text.view(), "|", text.len(), "\n";
  llvmc.DisposeModule(m);
  llvmc.ContextDispose(ctx);
  0i32;
}
