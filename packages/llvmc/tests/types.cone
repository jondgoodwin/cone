// Types, constants, globals and what LLVM answers about them: the scalar types and their widths, pointer,
// array, vector, struct (anonymous, named, opaque then given a body) and function types; the constants
// (integers, reals, null, undef, poison, strings, arrays, structs) read back and printed; a target's
// data layout (sizes, alignments, field offsets); globals with their linkage, visibility, section,
// alignment, thread-locality and initialiser; a COMDAT; attributes; metadata kinds and nodes.

mod types;

import stdio use *;
import collections use *;
import llvmc;

fn expect(ok: bool, label: &str) {
  if !ok { print <- "FAILED: ", label, "\n"; }
}

fn show(v: *llvmc.Value) {
  let t = llvmc.valueToString(v);
  print <- t.view(), "\n";
}

fn showType(t: *llvmc.Type) {
  let s = llvmc.typeToString(t);
  print <- s.view(), "\n";
}

fn main() i32 {
  llvmc.InitializeAllTargetInfos();
  llvmc.InitializeAllTargets();
  llvmc.InitializeAllTargetMCs();

  let ctx = llvmc.ContextCreate();
  let m = llvmc.ModuleCreateWithNameInContext("types", ctx);

  // ---- types ----
  let i1 = llvmc.Int1TypeInContext(ctx);
  let i8 = llvmc.Int8TypeInContext(ctx);
  let i16 = llvmc.Int16TypeInContext(ctx);
  let i32t = llvmc.Int32TypeInContext(ctx);
  let i64 = llvmc.Int64TypeInContext(ctx);
  let i24 = llvmc.IntTypeInContext(ctx, 24u32);
  let half = llvmc.HalfTypeInContext(ctx);
  let flt = llvmc.FloatTypeInContext(ctx);
  let dbl = llvmc.DoubleTypeInContext(ctx);
  let voidt = llvmc.VoidTypeInContext(ctx);
  let ptr = llvmc.PointerTypeInContext(ctx, 0u32);
  let ptr1 = llvmc.PointerTypeInContext(ctx, 1u32);
  expect(llvmc.GetIntTypeWidth(i1) == 1u32 && llvmc.GetIntTypeWidth(i8) == 8u32 && llvmc.GetIntTypeWidth(i16) == 16u32, "integer widths");
  expect(llvmc.GetIntTypeWidth(i32t) == 32u32 && llvmc.GetIntTypeWidth(i64) == 64u32 && llvmc.GetIntTypeWidth(i24) == 24u32, "integer widths");
  expect(llvmc.GetTypeKind(half) == llvmc.TypeKind.HalfTypeKind, "half");
  expect(llvmc.GetTypeKind(flt) == llvmc.TypeKind.FloatTypeKind, "float");
  expect(llvmc.GetTypeKind(dbl) == llvmc.TypeKind.DoubleTypeKind, "double");
  expect(llvmc.GetTypeKind(voidt) == llvmc.TypeKind.VoidTypeKind, "void");
  expect(llvmc.GetTypeKind(ptr) == llvmc.TypeKind.PointerTypeKind, "pointer");
  expect(llvmc.GetPointerAddressSpace(ptr) == 0u32 && llvmc.GetPointerAddressSpace(ptr1) == 1u32, "address spaces");
  expect(llvmc.TypeIsSized(i32t) != 0i32 && llvmc.TypeIsSized(voidt) == 0i32, "void is not sized");
  expect(llvmc.PointerType(i32t, 3u32) != null, "the typed-pointer spelling still makes a pointer");

  // arrays and vectors
  let arr = llvmc.ArrayType2(i32t, 10u64);
  expect(llvmc.GetTypeKind(arr) == llvmc.TypeKind.ArrayTypeKind, "array");
  expect(llvmc.GetArrayLength2(arr) == 10u64 && llvmc.GetArrayLength(arr) == 10u32, "array length");
  expect(llvmc.GetElementType(arr) == i32t, "array element type");
  let arr32 = llvmc.ArrayType(i8, 7u32);
  expect(llvmc.GetArrayLength2(arr32) == 7u64, "ArrayType's length");
  let vec = llvmc.VectorType(flt, 4u32);
  expect(llvmc.GetTypeKind(vec) == llvmc.TypeKind.VectorTypeKind, "vector");
  expect(llvmc.GetElementType(vec) == flt, "vector element type");
  showType(arr);
  showType(vec);

  // structs: anonymous, packed, named and opaque, then given a body
  var fields: Array[*llvmc.Type, 3] = [i8, i32t, i64];
  let anon = llvmc.StructTypeInContext(ctx, &fields[0], 3u32, 0i32);
  let packed = llvmc.StructTypeInContext(ctx, &fields[0], 3u32, 1i32);
  expect(llvmc.GetTypeKind(anon) == llvmc.TypeKind.StructTypeKind, "struct");
  expect(llvmc.CountStructElementTypes(anon) == 3u32, "three fields");
  expect(llvmc.StructGetTypeAtIndex(anon, 1u32) == i32t, "the second field is i32");
  showType(anon);
  showType(packed);
  let named = llvmc.StructCreateNamed(ctx, "node");
  expect(llvmc.IsOpaqueStruct(named) != 0i32, "a new named struct is opaque");
  var body: Array[*llvmc.Type, 2] = [i32t, ptr];
  llvmc.StructSetBody(named, &body[0], 2u32, 0i32);
  expect(llvmc.IsOpaqueStruct(named) == 0i32, "and has a body once given one");
  expect(llvmc.CountStructElementTypes(named) == 2u32, "the named struct has two fields");
  showType(named);

  // function types
  var ps: Array[*llvmc.Type, 2] = [i32t, dbl];
  let fty = llvmc.FunctionType(i64, &ps[0], 2u32, 0i32);
  let vfty = llvmc.FunctionType(voidt, &ps[0], 1u32, 1i32);
  expect(llvmc.GetReturnType(fty) == i64, "return type");
  expect(llvmc.CountParamTypes(fty) == 2u32, "parameter count");
  expect(llvmc.IsFunctionVarArg(fty) == 0i32 && llvmc.IsFunctionVarArg(vfty) != 0i32, "variadic");
  var got: Array[*llvmc.Type, 2] = [null, null];
  llvmc.GetParamTypes(fty, &got[0]);
  expect(got[0] == i32t && got[1] == dbl, "parameter types read back");
  showType(fty);
  showType(vfty);

  // ---- the data layout of the host, and sizes ----
  let triple = llvmc.defaultTargetTriple();
  var target: *llvmc.Target = null;
  match llvmc.targetFromTriple(triple.cstr()) {
    case let t Ok { target = t; }
    case let why Error { print <- "no target: ", why.view(), "\n"; }
  }
  let tm = llvmc.CreateTargetMachine(target, triple.cstr(), "generic", "", llvmc.CodeGenOptLevel.CodeGenLevelNone,
    llvmc.RelocMode.RelocDefault, llvmc.CodeModel.CodeModelDefault);
  let td = llvmc.CreateTargetDataLayout(tm);
  expect(llvmc.PointerSize(td) == 8u32, "pointer size");
  expect(llvmc.ABISizeOfType(td, i32t) == 4u64 && llvmc.ABISizeOfType(td, i64) == 8u64, "ABI sizes");
  expect(llvmc.ABISizeOfType(td, anon) == 16u64, "{i8, i32, i64} is 16 bytes");
  expect(llvmc.ABISizeOfType(td, packed) == 13u64, "the packed one is 13");
  expect(llvmc.ABIAlignmentOfType(td, anon) == 8u32 && llvmc.ABIAlignmentOfType(td, packed) == 1u32, "alignments");
  expect(llvmc.OffsetOfElement(td, anon, 0u32) == 0u64 && llvmc.OffsetOfElement(td, anon, 1u32) == 4u64
    && llvmc.OffsetOfElement(td, anon, 2u32) == 8u64, "field offsets");
  expect(llvmc.SizeOfTypeInBits(td, i24) == 24u64 && llvmc.StoreSizeOfType(td, i24) == 3u64, "an i24 is 24 bits, stored in 3 bytes");
  expect(llvmc.ABISizeOfType(td, arr) == 40u64, "[10 x i32] is 40 bytes");
  let rep = llvmc.takeMessage(llvmc.CopyStringRepOfTargetData(td));
  expect(rep.len() > 0usize, "the layout has a string");
  llvmc.SetModuleDataLayout(m, td);
  expect(llvmc.GetDataLayoutStr(m) != null, "the module holds its layout");
  print <- "sizes checked\n";

  // ---- constants ----
  let c42 = llvmc.ConstInt(i32t, 42u64, 0i32);
  let cm1 = llvmc.ConstInt(i32t, 18446744073709551615u64, 1i32);
  let big = llvmc.ConstInt(i64, 18446744073709551615u64, 0i32);
  show(c42);
  show(cm1);
  show(big);
  expect(llvmc.ConstIntGetZExtValue(c42) == 42u64, "ConstIntGetZExtValue");
  expect(llvmc.ConstIntGetZExtValue(big) == 18446744073709551615u64, "all 64 bits of a constant read back");
  expect(llvmc.IsConstant(c42) != 0i32 && llvmc.IsNull(c42) == 0i32, "42 is a non-null constant");
  expect(llvmc.IsNull(llvmc.ConstNull(i32t)) != 0i32, "ConstNull is null");
  expect(llvmc.IsUndef(llvmc.GetUndef(i32t)) != 0i32, "undef");
  expect(llvmc.IsPoison(llvmc.GetPoison(i32t)) != 0i32, "poison");
  expect(llvmc.IsAConstantInt(c42) != null && llvmc.IsAConstantInt(llvmc.ConstReal(dbl, 1.0)) == null, "ConstantInt casts");
  show(llvmc.ConstReal(dbl, 2.5));
  show(llvmc.ConstReal(flt, 0.125));
  show(llvmc.ConstNull(ptr));
  show(llvmc.ConstPointerNull(ptr));
  show(llvmc.GetUndef(i64));
  show(llvmc.GetPoison(dbl));

  // a string, an array, structs
  let str = llvmc.ConstStringInContext2(ctx, llvmc.bytesOf("hello"), 5usize, 0i32);
  show(str);
  expect(llvmc.GetArrayLength2(llvmc.TypeOf(str)) == 6u64, "the string has its zero");
  let bare = llvmc.ConstStringInContext2(ctx, llvmc.bytesOf("abc"), 3usize, 1i32);
  expect(llvmc.GetArrayLength2(llvmc.TypeOf(bare)) == 3u64, "and does not, when asked");
  var elems: Array[*llvmc.Value, 3] = [llvmc.ConstInt(i32t, 1u64, 0i32), llvmc.ConstInt(i32t, 2u64, 0i32), llvmc.ConstInt(i32t, 3u64, 0i32)];
  let carr = llvmc.ConstArray2(i32t, &elems[0], 3u64);
  show(carr);
  expect(llvmc.GetAggregateElement(carr, 1u32) == elems[1], "an element of a constant array");
  var sfields: Array[*llvmc.Value, 3] = [llvmc.ConstInt(i8, 7u64, 0i32), llvmc.ConstInt(i32t, 8u64, 0i32), llvmc.ConstInt(i64, 9u64, 0i32)];
  let cstruct = llvmc.ConstStructInContext(ctx, &sfields[0], 3u32, 0i32);
  show(cstruct);
  var nfields: Array[*llvmc.Value, 2] = [llvmc.ConstInt(i32t, 5u64, 0i32), llvmc.ConstPointerNull(ptr)];
  let cnamed = llvmc.ConstNamedStruct(named, &nfields[0], 2u32);
  show(cnamed);
  let sz = llvmc.SizeOf(i64);
  expect(llvmc.IsAConstantExpr(sz) != null || llvmc.IsAConstantInt(sz) != null, "SizeOf is a constant");

  // ---- globals ----
  let g = llvmc.AddGlobal(m, i32t, "counter");
  llvmc.SetInitializer(g, c42);
  llvmc.SetAlignment(g, 8u32);
  expect(llvmc.GetAlignment(g) == 8u32, "alignment");
  expect(llvmc.GetLinkage(g) == llvmc.Linkage.ExternalLinkage, "a new global is external");
  llvmc.SetLinkage(g, llvmc.Linkage.InternalLinkage);
  expect(llvmc.GetLinkage(g) == llvmc.Linkage.InternalLinkage, "internal now");
  llvmc.SetVisibility(g, llvmc.Visibility.HiddenVisibility);
  expect(llvmc.GetVisibility(g) == llvmc.Visibility.HiddenVisibility, "hidden");
  llvmc.SetUnnamedAddress(g, llvmc.UnnamedAddr.GlobalUnnamedAddr);
  expect(llvmc.GetUnnamedAddress(g) == llvmc.UnnamedAddr.GlobalUnnamedAddr, "unnamed_addr");
  llvmc.SetSection(g, "mydata");
  expect(llvmc.GetSection(g) != null, "a section is set");
  llvmc.SetThreadLocal(g, 1i32);
  expect(llvmc.GlobalGetValueType(g) == i32t, "the global's value type");
  expect(llvmc.IsDeclaration(g) == 0i32, "it has an initialiser");
  expect(llvmc.GetNamedGlobal(m, "counter") == g, "found by name");
  expect(llvmc.IsAGlobalVariable(g) != null && llvmc.IsAFunction(g) == null, "casts of a global");

  let k = llvmc.AddGlobal(m, arr, "table");
  var tbl: Array[*llvmc.Value, 10] = [elems[0], elems[1], elems[2], elems[0], elems[1], elems[2], elems[0], elems[1], elems[2], elems[0]];
  llvmc.SetInitializer(k, llvmc.ConstArray2(i32t, &tbl[0], 10u64));
  llvmc.SetGlobalConstant(k, 1i32);
  llvmc.SetLinkage(k, llvmc.Linkage.PrivateLinkage);
  let w = llvmc.AddGlobalInAddressSpace(m, i8, "shared", 1u32);
  llvmc.SetLinkage(w, llvmc.Linkage.WeakODRLinkage);
  llvmc.SetInitializer(w, llvmc.ConstInt(i8, 0u64, 0i32));
  let ext = llvmc.AddGlobal(m, i64, "elsewhere");
  expect(llvmc.IsDeclaration(ext) != 0i32, "a global with no initialiser is a declaration");
  llvmc.SetDLLStorageClass(ext, llvmc.DLLStorageClass.DLLImportStorageClass);
  expect(llvmc.GetDLLStorageClass(ext) == llvmc.DLLStorageClass.DLLImportStorageClass, "dllimport");
  llvmc.SetDLLStorageClass(ext, llvmc.DLLStorageClass.DefaultStorageClass);

  // a COMDAT
  let cd = llvmc.GetOrInsertComdat(m, "once");
  llvmc.SetComdatSelectionKind(cd, llvmc.ComdatSelectionKind.AnyComdatSelectionKind);
  llvmc.SetLinkage(w, llvmc.Linkage.LinkOnceODRLinkage);
  llvmc.SetComdat(w, cd);
  expect(llvmc.GetComdat(w) == cd, "the comdat of a global");

  // ---- attributes on a function ----
  var noParams: Array[*llvmc.Type, 1] = [i32t];
  let f = llvmc.AddFunction(m, "f", llvmc.FunctionType(i32t, &noParams[0], 1u32, 0i32));
  let nounwind = llvmc.GetEnumAttributeKindForName(llvmc.bytesOf("nounwind"), 8usize);
  expect(nounwind != 0u32, "nounwind is a known attribute");
  llvmc.AddAttributeAtIndex(f, llvmc.AttributeFunctionIndex, llvmc.CreateEnumAttribute(ctx, nounwind, 0u64));
  llvmc.AddAttributeAtIndex(f, llvmc.AttributeFunctionIndex, llvmc.CreateStringAttribute(ctx, llvmc.bytesOf("flavour"), 7u32, llvmc.bytesOf("plain"), 5u32));
  expect(llvmc.GetAttributeCountAtIndex(f, llvmc.AttributeFunctionIndex) == 2u32, "two function attributes");
  expect(llvmc.GetStringAttributeAtIndex(f, llvmc.AttributeFunctionIndex, llvmc.bytesOf("flavour"), 7u32) != null, "the string attribute is found");
  llvmc.RemoveStringAttributeAtIndex(f, llvmc.AttributeFunctionIndex, llvmc.bytesOf("flavour"), 7u32);
  expect(llvmc.GetAttributeCountAtIndex(f, llvmc.AttributeFunctionIndex) == 1u32, "and removed");
  var found: Array[*llvmc.Attribute, 1] = [null];
  llvmc.GetAttributesAtIndex(f, llvmc.AttributeFunctionIndex, &found[0]);
  expect(found[0] != null, "the attribute is read back");
  llvmc.AddAttributeAtIndex(f, 1u32, llvmc.CreateEnumAttribute(ctx, llvmc.GetEnumAttributeKindForName(llvmc.bytesOf("noundef"), 7usize), 0u64));
  llvmc.SetFunctionCallConv(f, llvmc.FastCallConv);
  expect(llvmc.GetFunctionCallConv(f) == llvmc.FastCallConv, "the calling convention");
  llvmc.SetGC(f, "shadow-stack");
  expect(llvmc.GetGC(f) != null, "gc name");
  llvmc.SetPersonalityFn(f, llvmc.AddFunction(m, "personality", llvmc.FunctionType(i32t, null, 0u32, 1i32)));
  expect(llvmc.HasPersonalityFn(f) != 0i32, "personality function");

  // ---- metadata ----
  let kind = llvmc.GetMDKindIDInContext(ctx, llvmc.bytesOf("note"), 4u32);
  expect(kind > 0u32, "a metadata kind");
  expect(llvmc.GetMDKindIDInContext(ctx, llvmc.bytesOf("note"), 4u32) == kind, "the same kind again");
  var mdv: Array[*llvmc.Value, 1] = [llvmc.ConstInt(i32t, 99u64, 0i32)];
  let node = llvmc.MDNodeInContext(ctx, &mdv[0], 1u32);
  llvmc.GlobalSetMetadata(g, kind, llvmc.ValueAsMetadata(node));
  var count = 0usize;
  let entries = llvmc.GlobalCopyAllMetadata(g, &count);
  expect(count == 1usize, "one metadata entry on the global");
  expect(llvmc.ValueMetadataEntriesGetKind(entries, 0u32) == kind, "of the kind set");
  expect(llvmc.ValueMetadataEntriesGetMetadata(entries, 0u32) != null, "with its node");
  llvmc.DisposeValueMetadataEntries(entries);
  expect(llvmc.GetNamedMetadataNumOperands(m, "nothing") == 0u32, "no named metadata");
  expect(llvmc.GetSyncScopeID(ctx, llvmc.bytesOf("singlethread"), 12usize) == 0u32, "the singlethread scope is 0");

  print <- "globals\n";
  show(g);
  show(k);
  show(w);
  show(ext);
  llvmc.GlobalClearMetadata(g);
  llvmc.DeleteGlobal(ext);
  expect(llvmc.GetNamedGlobal(m, "elsewhere") == null, "a deleted global is gone");

  // the symbols of a function, in the order they were added
  show(f);
  expect(llvmc.GetFirstFunction(m) == f, "the first function");
  expect(llvmc.GetNextFunction(f) != null, "the second one is the personality");
  llvmc.DeleteFunction(llvmc.GetNextFunction(f));

  llvmc.DisposeTargetData(td);
  llvmc.DisposeTargetMachine(tm);
  llvmc.DisposeModule(m);
  llvmc.ContextDispose(ctx);
  0i32
}
