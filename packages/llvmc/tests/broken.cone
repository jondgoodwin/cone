// LLVM's verifier refuses a module that is not well formed, and says why. Three modules are built wrong
// on purpose: a block with no terminator, a ret of the wrong type, and a branch to a block of another
// function. Each fails VerifyModule (through checkModule, which copies the message into a String and
// disposes it) and the message is printed. The raw call is made too, with the failure action that returns the
// status instead of aborting: it answers 1 and fills in a char* that DisposeMessage frees.

mod broken;

import stdio use *;
import collections use *;
import llvmc;

fn expect(ok bool, label &str) {
  if not ok { print <- "FAILED: ", label, "\n"; }
}

fn show(label &str, m *llvmc.Module) {
  print <- "== ", label, "\n";
  match llvmc.checkModule(m) {
    case is None { print <- "verifies (it should not)\n"; }
    case let why Some { print <- why.view(); }
  }
}

fn main() i32 {
  let ctx = llvmc.ContextCreate();
  let i32t = llvmc.Int32TypeInContext(ctx);
  let i64t = llvmc.Int64TypeInContext(ctx);
  let voidt = llvmc.VoidTypeInContext(ctx);
  let bld = llvmc.CreateBuilderInContext(ctx);

  // A block that never ends
  let m1 = llvmc.ModuleCreateWithNameInContext("noterm", ctx);
  let f1 = llvmc.AddFunction(m1, "noterm", llvmc.FunctionType(voidt, null, 0u32, 0i32));
  let b1 = llvmc.AppendBasicBlockInContext(ctx, f1, "entry");
  llvmc.PositionBuilderAtEnd(bld, b1);
  llvmc.BuildAdd(bld, llvmc.ConstInt(i32t, 1u64, 0i32), llvmc.ConstInt(i32t, 2u64, 0i32), "x");
  show("a block with no terminator", m1);

  // 'ret i64' in a function that returns i32
  let m2 = llvmc.ModuleCreateWithNameInContext("wrongret", ctx);
  let f2 = llvmc.AddFunction(m2, "wrongret", llvmc.FunctionType(i32t, null, 0u32, 0i32));
  llvmc.PositionBuilderAtEnd(bld, llvmc.AppendBasicBlockInContext(ctx, f2, "entry"));
  llvmc.BuildRet(bld, llvmc.ConstInt(i64t, 7u64, 0i32));
  show("a ret of the wrong type", m2);

  // A branch into another function's block
  let m3 = llvmc.ModuleCreateWithNameInContext("crossbranch", ctx);
  let fa = llvmc.AddFunction(m3, "a", llvmc.FunctionType(voidt, null, 0u32, 0i32));
  let fb = llvmc.AddFunction(m3, "b", llvmc.FunctionType(voidt, null, 0u32, 0i32));
  let ba = llvmc.AppendBasicBlockInContext(ctx, fa, "entry");
  let bb = llvmc.AppendBasicBlockInContext(ctx, fb, "entry");
  llvmc.PositionBuilderAtEnd(bld, bb);
  llvmc.BuildRetVoid(bld);
  llvmc.PositionBuilderAtEnd(bld, ba);
  llvmc.BuildBr(bld, bb);
  show("a branch to another function's block", m3);

  // The raw call and its out-parameter
  var message *u8 = null;
  let status = llvmc.VerifyModule(m2, llvmc.VerifierFailureAction.ReturnStatusAction, &message);
  expect(status == 1i32, "VerifyModule answers 1 for a broken module");
  expect(message != null, "and fills in the message");
  let text = llvmc.takeMessage(message);
  expect(text.view().startsWith("Function return type does not match operand type of return inst!"), "the verifier's own words");

  // A good module answers 0 and leaves the message empty (a char* to dispose all the same)
  let m4 = llvmc.ModuleCreateWithNameInContext("fine", ctx);
  let f4 = llvmc.AddFunction(m4, "fine", llvmc.FunctionType(voidt, null, 0u32, 0i32));
  llvmc.PositionBuilderAtEnd(bld, llvmc.AppendBasicBlockInContext(ctx, f4, "entry"));
  llvmc.BuildRetVoid(bld);
  var message2 *u8 = null;
  let status2 = llvmc.VerifyModule(m4, llvmc.VerifierFailureAction.ReturnStatusAction, &message2);
  expect(status2 == 0i32, "VerifyModule answers 0 for a good module");
  print <- "good module: status ", status2, "\n";
  if message2 != null { llvmc.DisposeMessage(message2); }

  llvmc.DisposeBuilder(bld);
  llvmc.DisposeModule(m1);
  llvmc.DisposeModule(m2);
  llvmc.DisposeModule(m3);
  llvmc.DisposeModule(m4);
  llvmc.ContextDispose(ctx);
  0i32;
}
