verifies
; ModuleID = 'object'
source_filename = "object"

define i32 @add(i32 %a, i32 %b) {
entry:
  %sum = add i32 %a, %b
  ret i32 %sum
}

define i32 @max(i32 %a, i32 %b) {
entry:
  %bigger = icmp sgt i32 %a, %b
  br i1 %bigger, label %first, label %second

first:                                            ; preds = %entry
  br label %join

second:                                           ; preds = %entry
  br label %join

join:                                             ; preds = %second, %first
  %result = phi i32 [ %a, %first ], [ %b, %second ]
  ret i32 %result
}

define i32 @sumto(i32 %n) {
entry:
  br label %loop

loop:                                             ; preds = %loop, %entry
  %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc2, %loop ]
  %acc2 = add i32 %acc, %i
  %i2 = add i32 %i, 1
  %more = icmp slt i32 %i2, %n
  br i1 %more, label %loop, label %done

done:                                             ; preds = %loop
  ret i32 %acc2
}

define i32 @classify(i32 %n) {
entry:
  switch i32 %n, label %other [
    i32 0, label %c0
    i32 1, label %c1
    i32 5, label %c5
  ]

other:                                            ; preds = %entry
  br label %join

c0:                                               ; preds = %entry
  br label %join

c1:                                               ; preds = %entry
  br label %join

c5:                                               ; preds = %entry
  br label %join

join:                                             ; preds = %c5, %c1, %c0, %other
  %answer = phi i32 [ 7, %other ], [ 100, %c0 ], [ 200, %c1 ], [ 500, %c5 ]
  ret i32 %answer
}
