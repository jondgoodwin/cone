// One function that uses the instruction builder's whole range (the integer and floating-point arithmetic,
// the comparisons with every predicate the compiler uses, the casts, memory, aggregates, vectors,
// atomics, a call), verified and printed; then the same IR read back and edited: instructions walked
// forwards and backwards, their operands, parents and opcodes, the uses of a value, a block moved,
// inserted and removed, a value replaced, an instruction cloned and erased, the builder positioned
// before an instruction, intrinsics looked up. The module has no target, so the text is the same everywhere.

mod instructions;

import stdio use *;
import collections use *;
import llvmc;

fn expect(ok bool, label &str) {
  if not ok { print <- "FAILED: ", label, "\n"; }
}

fn main() i32 {
  imm ctx = llvmc.ContextCreate();
  imm m = llvmc.ModuleCreateWithNameInContext("instructions", ctx);
  imm bld = llvmc.CreateBuilderInContext(ctx);
  imm i1 = llvmc.Int1TypeInContext(ctx);
  imm i8 = llvmc.Int8TypeInContext(ctx);
  imm i16 = llvmc.Int16TypeInContext(ctx);
  imm i32t = llvmc.Int32TypeInContext(ctx);
  imm i64 = llvmc.Int64TypeInContext(ctx);
  imm flt = llvmc.FloatTypeInContext(ctx);
  imm dbl = llvmc.DoubleTypeInContext(ctx);
  imm voidt = llvmc.VoidTypeInContext(ctx);
  imm ptr = llvmc.PointerTypeInContext(ctx, 0u32);
  imm ptr1 = llvmc.PointerTypeInContext(ctx, 1u32);

  // a callee, declared only
  mut cps Array[*llvmc.Type, 2] = [i32t, ptr];
  imm callee = llvmc.AddFunction(m, "callee", llvmc.FunctionType(i32t, &cps[0], 2u32, 0i32));

  // sink(i32 a, i32 b, double x, ptr p) i32
  mut sps Array[*llvmc.Type, 4] = [i32t, i32t, dbl, ptr];
  imm sink = llvmc.AddFunction(m, "sink", llvmc.FunctionType(i32t, &sps[0], 4u32, 0i32));
  imm a = llvmc.GetParam(sink, 0u32);
  imm b = llvmc.GetParam(sink, 1u32);
  imm x = llvmc.GetParam(sink, 2u32);
  imm p = llvmc.GetParam(sink, 3u32);
  llvmc.SetValueName2(a, llvmc.bytesOf("a"), 1usize);
  llvmc.SetValueName2(b, llvmc.bytesOf("b"), 1usize);
  llvmc.SetValueName2(x, llvmc.bytesOf("x"), 1usize);
  llvmc.SetValueName2(p, llvmc.bytesOf("p"), 1usize);
  imm entry = llvmc.AppendBasicBlockInContext(ctx, sink, "entry");
  llvmc.PositionBuilderAtEnd(bld, entry);

  // integer arithmetic
  imm i_add = llvmc.BuildAdd(bld, a, b, "add");
  imm i_sub = llvmc.BuildSub(bld, a, b, "sub");
  imm i_mul = llvmc.BuildMul(bld, a, b, "mul");
  imm i_sdiv = llvmc.BuildSDiv(bld, a, b, "sdiv");
  imm i_udiv = llvmc.BuildUDiv(bld, a, b, "udiv");
  imm i_xdiv = llvmc.BuildExactSDiv(bld, a, b, "exactsdiv");
  imm i_srem = llvmc.BuildSRem(bld, a, b, "srem");
  imm i_urem = llvmc.BuildURem(bld, a, b, "urem");
  imm i_shl = llvmc.BuildShl(bld, a, b, "shl");
  imm i_lshr = llvmc.BuildLShr(bld, a, b, "lshr");
  imm i_ashr = llvmc.BuildAShr(bld, a, b, "ashr");
  imm i_and = llvmc.BuildAnd(bld, a, b, "and");
  imm i_or = llvmc.BuildOr(bld, a, b, "or");
  imm i_xor = llvmc.BuildXor(bld, a, b, "xor");
  imm i_neg = llvmc.BuildNeg(bld, a, "neg");
  imm i_not = llvmc.BuildNot(bld, a, "not");

  // floating point
  imm f_add = llvmc.BuildFAdd(bld, x, x, "fadd");
  imm f_sub = llvmc.BuildFSub(bld, x, f_add, "fsub");
  imm f_mul = llvmc.BuildFMul(bld, x, x, "fmul");
  imm f_div = llvmc.BuildFDiv(bld, f_mul, x, "fdiv");
  imm f_rem = llvmc.BuildFRem(bld, f_div, x, "frem");
  imm f_neg = llvmc.BuildFNeg(bld, f_rem, "fneg");

  // comparisons: every integer predicate, and the real ones the compiler uses
  imm c_eq = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntEQ, a, b, "eq");
  imm c_ne = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntNE, a, b, "ne");
  imm c_ugt = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntUGT, a, b, "ugt");
  imm c_uge = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntUGE, a, b, "uge");
  imm c_ult = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntULT, a, b, "ult");
  imm c_ule = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntULE, a, b, "ule");
  imm c_sgt = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntSGT, a, b, "sgt");
  imm c_sge = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntSGE, a, b, "sge");
  imm c_slt = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntSLT, a, b, "slt");
  imm c_sle = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntSLE, a, b, "sle");
  imm d_oeq = llvmc.BuildFCmp(bld, llvmc.RealPredicate.RealOEQ, x, f_add, "oeq");
  imm d_ogt = llvmc.BuildFCmp(bld, llvmc.RealPredicate.RealOGT, x, f_add, "ogt");
  imm d_oge = llvmc.BuildFCmp(bld, llvmc.RealPredicate.RealOGE, x, f_add, "oge");
  imm d_olt = llvmc.BuildFCmp(bld, llvmc.RealPredicate.RealOLT, x, f_add, "olt");
  imm d_ole = llvmc.BuildFCmp(bld, llvmc.RealPredicate.RealOLE, x, f_add, "ole");
  imm d_one = llvmc.BuildFCmp(bld, llvmc.RealPredicate.RealONE, x, f_add, "one");
  imm d_une = llvmc.BuildFCmp(bld, llvmc.RealPredicate.RealUNE, x, f_add, "une");
  imm both = llvmc.BuildAnd(bld, c_eq, d_oeq, "both");
  imm pick = llvmc.BuildSelect(bld, both, i_add, i_sub, "pick");
  imm fpick = llvmc.BuildSelect(bld, c_slt, f_add, f_sub, "fpick");

  // casts
  imm t8 = llvmc.BuildTrunc(bld, a, i8, "trunc");
  imm z32 = llvmc.BuildZExt(bld, t8, i32t, "zext");
  imm s64 = llvmc.BuildSExt(bld, a, i64, "sext");
  imm fsi = llvmc.BuildFPToSI(bld, x, i64, "fptosi");
  imm fui = llvmc.BuildFPToUI(bld, x, i32t, "fptoui");
  imm sif = llvmc.BuildSIToFP(bld, a, dbl, "sitofp");
  imm uif = llvmc.BuildUIToFP(bld, b, flt, "uitofp");
  imm ftr = llvmc.BuildFPTrunc(bld, x, flt, "fptrunc");
  imm fex = llvmc.BuildFPExt(bld, ftr, dbl, "fpext");
  imm p2i = llvmc.BuildPtrToInt(bld, p, i64, "ptrtoint");
  imm i2p = llvmc.BuildIntToPtr(bld, p2i, ptr, "inttoptr");
  imm bc = llvmc.BuildBitCast(bld, a, flt, "bitcast");
  imm asc = llvmc.BuildAddrSpaceCast(bld, p, ptr1, "addrspacecast");
  imm ic = llvmc.BuildIntCast2(bld, t8, i16, 1i32, "intcast");

  // memory
  imm slot = llvmc.BuildAlloca(bld, i32t, "slot");
  llvmc.SetAlignment(slot, 4u32);
  imm st = llvmc.BuildStore(bld, i_add, slot);
  imm ld = llvmc.BuildLoad2(bld, i32t, slot, "loaded");
  imm arrty = llvmc.ArrayType2(i32t, 8u64);
  mut idx Array[*llvmc.Value, 2] = [llvmc.ConstInt(i64, 0u64, 0i32), llvmc.ConstInt(i64, 3u64, 0i32)];
  imm gep = llvmc.BuildGEP2(bld, arrty, p, &idx[0], 2u32, "gep");
  imm gepib = llvmc.BuildInBoundsGEP2(bld, arrty, p, &idx[0], 2u32, "gepib");
  mut sfs Array[*llvmc.Type, 3] = [i8, i32t, i64];
  imm sty = llvmc.StructTypeInContext(ctx, &sfs[0], 3u32, 0i32);
  imm sgep = llvmc.BuildStructGEP2(bld, sty, p, 2u32, "sgep");
  llvmc.BuildMemSet(bld, p, llvmc.ConstInt(i8, 0u64, 0i32), llvmc.ConstInt(i64, 16u64, 0i32), 1u32);
  llvmc.BuildMemCpy(bld, p, 1u32, gep, 1u32, llvmc.ConstInt(i64, 8u64, 0i32));
  llvmc.BuildMemMove(bld, p, 1u32, gepib, 1u32, llvmc.ConstInt(i64, 4u64, 0i32));
  imm rmw = llvmc.BuildAtomicRMW(bld, llvmc.AtomicRMWBinOp.AtomicRMWBinOpAdd, slot, a, llvmc.AtomicOrdering.AtomicOrderingSequentiallyConsistent, 0i32);
  imm cas = llvmc.BuildAtomicCmpXchg(bld, slot, a, b, llvmc.AtomicOrdering.AtomicOrderingAcquireRelease, llvmc.AtomicOrdering.AtomicOrderingMonotonic, 0i32);
  imm cas_old = llvmc.BuildExtractValue(bld, cas, 0u32, "cas.old");
  imm nul = llvmc.BuildIsNull(bld, p, "isnull");
  imm nnul = llvmc.BuildIsNotNull(bld, p, "isnotnull");

  // aggregates and vectors
  imm agg0 = llvmc.GetUndef(sty);
  imm agg1 = llvmc.BuildInsertValue(bld, agg0, t8, 0u32, "ins0");
  imm agg2 = llvmc.BuildInsertValue(bld, agg1, a, 1u32, "ins1");
  imm agg_a = llvmc.BuildExtractValue(bld, agg2, 1u32, "ext1");
  imm vty = llvmc.VectorType(i32t, 4u32);
  imm v0 = llvmc.BuildInsertElement(bld, llvmc.GetUndef(vty), a, llvmc.ConstInt(i32t, 2u64, 0i32), "vins");
  imm v1 = llvmc.BuildExtractElement(bld, v0, llvmc.ConstInt(i32t, 2u64, 0i32), "vext");
  imm fr = llvmc.BuildFreeze(bld, v1, "frozen");

  // a call, with its calling convention and tail flag
  mut args Array[*llvmc.Value, 2] = [fr, p];
  imm call = llvmc.BuildCall2(bld, llvmc.GlobalGetValueType(callee), callee, &args[0], 2u32, "call");
  llvmc.SetInstructionCallConv(call, llvmc.FastCallConv);
  llvmc.SetTailCall(call, 1i32);

  // keep a few results alive: sum them into the return value
  imm r1 = llvmc.BuildAdd(bld, call, agg_a, "r1");
  imm r2 = llvmc.BuildAdd(bld, r1, cas_old, "r2");
  imm r3 = llvmc.BuildAdd(bld, r2, ld, "r3");
  imm ret = llvmc.BuildRet(bld, r3);

  match llvmc.checkModule(m) {
    case is None { print <- "verifies\n"; }
    case imm why Some { print <- "does not verify: ", why.view(), "\n"; }
  }
  imm text = llvmc.moduleToString(m);
  print <- text.view();

  // ---- read it back ----
  expect(llvmc.CountBasicBlocks(sink) == 1u32, "one block");
  expect(llvmc.GetEntryBasicBlock(sink) == entry and llvmc.GetFirstBasicBlock(sink) == entry, "the entry block");
  expect(llvmc.GetNextBasicBlock(entry) == null, "and no second");
  expect(llvmc.GetBasicBlockParent(entry) == sink, "the block's function");
  expect(llvmc.GetBasicBlockTerminator(entry) == ret, "the terminator");
  expect(llvmc.GetInsertBlock(bld) == entry, "the builder's block");
  expect(llvmc.GetFirstInstruction(entry) == i_add, "the first instruction is the add");
  expect(llvmc.GetNextInstruction(i_add) == i_sub, "and the next the sub");
  expect(llvmc.GetPreviousInstruction(i_sub) == i_add, "and back");
  expect(llvmc.GetPreviousInstruction(i_add) == null, "nothing before the first");
  expect(llvmc.GetInstructionParent(i_xor) == entry, "an instruction's block");
  expect(llvmc.GetInstructionOpcode(i_sdiv) == llvmc.Opcode.SDiv and llvmc.GetInstructionOpcode(i_udiv) == llvmc.Opcode.UDiv, "division opcodes");
  expect(llvmc.GetInstructionOpcode(i_shl) == llvmc.Opcode.Shl and llvmc.GetInstructionOpcode(i_ashr) == llvmc.Opcode.AShr, "shift opcodes");
  expect(llvmc.GetInstructionOpcode(f_neg) == llvmc.Opcode.FNeg and llvmc.GetInstructionOpcode(f_rem) == llvmc.Opcode.FRem, "float opcodes");
  expect(llvmc.GetInstructionOpcode(c_eq) == llvmc.Opcode.ICmp and llvmc.GetInstructionOpcode(d_oeq) == llvmc.Opcode.FCmp, "compare opcodes");
  expect(llvmc.GetInstructionOpcode(pick) == llvmc.Opcode.Select, "select opcode");
  expect(llvmc.GetInstructionOpcode(t8) == llvmc.Opcode.Trunc and llvmc.GetInstructionOpcode(z32) == llvmc.Opcode.ZExt
    and llvmc.GetInstructionOpcode(s64) == llvmc.Opcode.SExt, "extension opcodes");
  expect(llvmc.GetInstructionOpcode(p2i) == llvmc.Opcode.PtrToInt and llvmc.GetInstructionOpcode(i2p) == llvmc.Opcode.IntToPtr
    and llvmc.GetInstructionOpcode(bc) == llvmc.Opcode.BitCast and llvmc.GetInstructionOpcode(asc) == llvmc.Opcode.AddrSpaceCast, "pointer cast opcodes");
  expect(llvmc.GetInstructionOpcode(slot) == llvmc.Opcode.Alloca and llvmc.GetInstructionOpcode(st) == llvmc.Opcode.Store
    and llvmc.GetInstructionOpcode(ld) == llvmc.Opcode.Load and llvmc.GetInstructionOpcode(gep) == llvmc.Opcode.GetElementPtr, "memory opcodes");
  expect(llvmc.GetInstructionOpcode(rmw) == llvmc.Opcode.AtomicRMW and llvmc.GetInstructionOpcode(cas) == llvmc.Opcode.AtomicCmpXchg, "atomic opcodes");
  expect(llvmc.GetInstructionOpcode(agg2) == llvmc.Opcode.InsertValue and llvmc.GetInstructionOpcode(agg_a) == llvmc.Opcode.ExtractValue, "aggregate opcodes");
  expect(llvmc.GetInstructionOpcode(call) == llvmc.Opcode.Call and llvmc.GetInstructionOpcode(fr) == llvmc.Opcode.Freeze, "call and freeze");
  expect(llvmc.GetInstructionOpcode(v0) == llvmc.Opcode.InsertElement and llvmc.GetInstructionOpcode(v1) == llvmc.Opcode.ExtractElement, "vector opcodes");
  expect(llvmc.IsAAllocaInst(slot) != null and llvmc.IsALoadInst(ld) != null and llvmc.IsAStoreInst(st) != null, "memory casts");
  expect(llvmc.IsACallInst(call) != null and llvmc.IsASelectInst(pick) != null and llvmc.IsAReturnInst(ret) != null, "call, select, return casts");
  expect(llvmc.IsAGetElementPtrInst(gep) != null and llvmc.IsAAtomicRMWInst(rmw) != null and llvmc.IsAAtomicCmpXchgInst(cas) != null, "gep and atomic casts");
  expect(llvmc.IsAInsertValueInst(agg2) != null and llvmc.IsAExtractValueInst(agg_a) != null, "aggregate casts");
  expect(llvmc.IsABitCastInst(bc) != null and llvmc.IsAAddrSpaceCastInst(asc) != null, "bitcast casts");
  expect(llvmc.IsAPHINode(call) == null and llvmc.IsAInstruction(call) != null, "a call is no phi, but an instruction");
  expect(llvmc.IsAArgument(a) != null and llvmc.IsAConstant(a) == null, "an argument is no constant");
  expect(llvmc.GetAllocatedType(slot) == i32t, "the alloca's type");
  expect(llvmc.GetAlignment(slot) == 4u32, "its alignment");
  expect(llvmc.IsInBounds(gepib) != 0i32 and llvmc.IsInBounds(gep) == 0i32, "inbounds");
  expect(llvmc.GetGEPSourceElementType(gep) == arrty, "the gep's source element type");
  expect(llvmc.GetNumIndices(agg_a) == 1u32, "one extractvalue index");
  expect(*llvmc.GetIndices(agg_a) == 1u32, "which is 1");
  expect(llvmc.GetOrdering(rmw) == llvmc.AtomicOrdering.AtomicOrderingSequentiallyConsistent, "the rmw's ordering");
  llvmc.SetOrdering(rmw, llvmc.AtomicOrdering.AtomicOrderingAcquireRelease);
  expect(llvmc.GetOrdering(rmw) == llvmc.AtomicOrdering.AtomicOrderingAcquireRelease, "reset");
  expect(llvmc.GetCmpXchgSuccessOrdering(cas) == llvmc.AtomicOrdering.AtomicOrderingAcquireRelease, "the cmpxchg's success ordering");
  expect(llvmc.GetCmpXchgFailureOrdering(cas) == llvmc.AtomicOrdering.AtomicOrderingMonotonic, "and failure ordering");
  expect(llvmc.IsAtomic(rmw) != 0i32 and llvmc.IsAtomic(ld) == 0i32, "atomic or not");
  expect(llvmc.GetVolatile(ld) == 0i32, "not volatile");
  expect(llvmc.GetCalledValue(call) == callee, "the callee");
  expect(llvmc.GetCalledFunctionType(call) == llvmc.GlobalGetValueType(callee), "its type");
  expect(llvmc.GetNumArgOperands(call) == 2u32, "two arguments");
  expect(llvmc.GetInstructionCallConv(call) == llvmc.FastCallConv, "the call's convention");
  expect(llvmc.GetNumOperands(i_add) == 2i32 and llvmc.GetOperand(i_add, 1u32) == b, "operands");
  expect(llvmc.GetOperand(ret, 0u32) == r3, "the return's operand");
  imm gv = llvmc.AddGlobal(m, i32t, "gv");
  imm cast = llvmc.ConstAddrSpaceCast(gv, ptr1);
  expect(llvmc.IsAConstantExpr(cast) != null, "a cast of a global is a constant expression");
  expect(llvmc.GetConstOpcode(cast) == llvmc.Opcode.AddrSpaceCast, "whose opcode is addrspacecast");
  expect(llvmc.ConstBitCast(gv, ptr) == gv, "a bitcast to the same pointer type is the global");
  imm sz = llvmc.SizeOf(i64);
  expect(llvmc.TypeOf(sz) == i64, "SizeOf is an i64 constant");
  expect(llvmc.TypeOf(sgep) == ptr and llvmc.TypeOf(asc) == ptr1, "pointer types");

  // the uses of a value: a is used by many instructions
  mut uses = 0u32;
  mut u = llvmc.GetFirstUse(a);
  while u != null {
    if llvmc.GetUser(u) != null { uses = uses + 1u32; }
    u = llvmc.GetNextUse(u);
  }
  expect(uses > 20u32, "a has many uses");

  // instructions edited: replace, clone, erase
  imm extra = llvmc.BuildAdd(bld, a, a, "extra");
  llvmc.PositionBuilderBefore(bld, ret);
  imm clone = llvmc.InstructionClone(extra);
  llvmc.InsertIntoBuilder(bld, clone);
  expect(llvmc.GetInstructionParent(clone) == entry, "a clone inserted before the return");
  expect(llvmc.GetNextInstruction(clone) == ret, "right before it");
  llvmc.ReplaceAllUsesWith(clone, i_add);
  llvmc.InstructionEraseFromParent(clone);
  expect(llvmc.GetNextInstruction(llvmc.GetPreviousInstruction(ret)) == ret, "erased");

  // blocks: add, move, remove
  imm second = llvmc.AppendBasicBlockInContext(ctx, sink, "second");
  imm third = llvmc.InsertBasicBlockInContext(ctx, second, "third");
  expect(llvmc.CountBasicBlocks(sink) == 3u32, "three blocks");
  mut blocks Array[*llvmc.BasicBlock, 3] = [null, null, null];
  llvmc.GetBasicBlocks(sink, &blocks[0]);
  expect(blocks[0] == entry and blocks[1] == third and blocks[2] == second, "in order: entry, third, second");
  llvmc.MoveBasicBlockBefore(second, third);
  llvmc.GetBasicBlocks(sink, &blocks[0]);
  expect(blocks[1] == second and blocks[2] == third, "second moved before third");
  llvmc.RemoveBasicBlockFromParent(third);
  expect(llvmc.CountBasicBlocks(sink) == 2u32, "one removed from its function");
  llvmc.AppendExistingBasicBlock(sink, third);
  expect(llvmc.CountBasicBlocks(sink) == 3u32, "and appended again");

  // a second function: branches, successors, a phi's incoming edges
  imm g = llvmc.AddFunction(m, "g", llvmc.FunctionType(i32t, &cps[0], 1u32, 0i32));
  imm ge = llvmc.AppendBasicBlockInContext(ctx, g, "entry");
  imm gl = llvmc.AppendBasicBlockInContext(ctx, g, "left");
  imm gr = llvmc.AppendBasicBlockInContext(ctx, g, "right");
  imm gj = llvmc.AppendBasicBlockInContext(ctx, g, "join");
  llvmc.PositionBuilderAtEnd(bld, ge);
  imm cond = llvmc.BuildICmp(bld, llvmc.IntPredicate.IntSGT, llvmc.GetParam(g, 0u32), llvmc.ConstInt(i32t, 0u64, 0i32), "cond");
  imm cb = llvmc.BuildCondBr(bld, cond, gl, gr);
  llvmc.PositionBuilderAtEnd(bld, gl);
  llvmc.BuildBr(bld, gj);
  llvmc.PositionBuilderAtEnd(bld, gr);
  llvmc.BuildBr(bld, gj);
  llvmc.PositionBuilderAtEnd(bld, gj);
  imm phi = llvmc.BuildPhi(bld, i32t, "phi");
  mut pv Array[*llvmc.Value, 2] = [llvmc.ConstInt(i32t, 1u64, 0i32), llvmc.ConstInt(i32t, 2u64, 0i32)];
  mut pb Array[*llvmc.BasicBlock, 2] = [gl, gr];
  llvmc.AddIncoming(phi, &pv[0], &pb[0], 2u32);
  llvmc.BuildRet(bld, phi);
  expect(llvmc.GetNumSuccessors(cb) == 2u32, "a conditional branch has two successors");
  expect(llvmc.GetSuccessor(cb, 0u32) == gl and llvmc.GetSuccessor(cb, 1u32) == gr, "which are left and right");
  llvmc.SetSuccessor(cb, 1u32, gj);
  expect(llvmc.GetSuccessor(cb, 1u32) == gj, "one is changed");
  llvmc.SetSuccessor(cb, 1u32, gr);
  expect(llvmc.CountIncoming(phi) == 2u32, "two incoming edges");
  expect(llvmc.GetIncomingValue(phi, 1u32) == pv[1] and llvmc.GetIncomingBlock(phi, 0u32) == gl, "read back");
  expect(llvmc.IsAPHINode(phi) != null, "a phi is a PHINode");
  llvmc.PositionBuilder(bld, ge, cond);
  expect(llvmc.GetInsertBlock(bld) == ge, "positioned at an instruction");

  // intrinsics
  imm memcpyId = llvmc.LookupIntrinsicID(llvmc.bytesOf("llvm.memcpy"), 11usize);
  expect(memcpyId != 0u32, "llvm.memcpy is an intrinsic");
  expect(llvmc.LookupIntrinsicID(llvmc.bytesOf("not.an.intrinsic"), 16usize) == 0u32, "and this is not");
  mut over Array[*llvmc.Type, 3] = [ptr, ptr, i64];
  imm memcpyFn = llvmc.GetIntrinsicDeclaration(m, memcpyId, &over[0], 3usize);
  expect(llvmc.GetIntrinsicID(memcpyFn) == memcpyId, "the declaration is that intrinsic");
  expect(llvmc.IntrinsicGetType(ctx, memcpyId, &over[0], 3usize) != null, "its type");
  imm decl = llvmc.valueToString(memcpyFn);
  print <- decl.view(), "\n";
  imm copy = llvmc.CloneModule(m);
  expect(llvmc.GetNamedFunction(copy, "sink") != null and llvmc.GetNamedFunction(copy, "sink") != sink, "a cloned module has its own functions");
  llvmc.DisposeModule(copy);

  print <- "read back\n";
  llvmc.DisposeBuilder(bld);
  llvmc.DisposeModule(m);
  llvmc.ContextDispose(ctx);
  0i32;
}
