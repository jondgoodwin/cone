  store i32 %x, ptr %slot, align 4
  %loaded = load i32, ptr %slot, align 4
  %plus0 = add i32 %loaded, 0
  %times1 = mul i32 %plus0, 1
  %sum = add i32 %times1, 5
  ret i32 %sum
}
