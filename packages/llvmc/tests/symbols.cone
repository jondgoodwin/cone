  mut nulls = 0usize;
  mut same = 0usize;
  mut i = 0usize;
  while i < all.len() {
    imm a *u8 = *all[i];
    if a == null { nulls = nulls + 1usize; }
    mut j = i + 1usize;
    while j < all.len() {
      imm b *u8 = *all[j];
      if a == b { same = same + 1usize; }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  print <- all.len(), " declared functions, ", nulls, " null addresses, ", same, " addresses shared\n";
  0i32;
