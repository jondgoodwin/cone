// llvm-c/Target.h: a target's data layout (sizes, alignments, struct offsets), and the initialisers
// that register the targets with LLVM.
//
// The five LLVMInitializeAll... functions are 'static inline' in the C header: they expand
// llvm/Config/Targets.def, AsmPrinters.def and AsmParsers.def, which the LLVM build writes for the
// targets it was configured with, and so they are not symbols of any library. They are Cone functions
// here (inline, calling the per-target initialisers, which are exported), for the targets the compiler
// build links: X86, WebAssembly and SPIRV, the three the LLVM 23.1.2 build on Windows is configured
// with and CLAUDE.md names for Linux. The asm parsers are X86 and WebAssembly (SPIRV has none), as that
// build's AsmParsers.def lists them. A program that wants another target adds its initialisers.

pub struct @opaque TargetData {}            // LLVMTargetDataRef

pub extern {

  // Target information
  fn SetModuleDataLayout(m *Module, dl *TargetData);
  fn DisposeTargetData(td *TargetData);
  fn CopyStringRepOfTargetData(td *TargetData) *u8;
  fn PointerSize(td *TargetData) u32;
  fn SizeOfTypeInBits(td *TargetData, ty *Type) u64;
  fn StoreSizeOfType(td *TargetData, ty *Type) u64;
  fn ABISizeOfType(td *TargetData, ty *Type) u64;
  fn ABIAlignmentOfType(td *TargetData, ty *Type) u32;
  fn OffsetOfElement(td *TargetData, structTy *Type, element u32) u64;

  // The per-target initialisers (declared by macro in Target.h, from Targets.def, AsmPrinters.def and
  // AsmParsers.def)
  fn InitializeX86TargetInfo();
  fn InitializeX86Target();
  fn InitializeX86TargetMC();
  fn InitializeX86AsmPrinter();
  fn InitializeX86AsmParser();
  fn InitializeWebAssemblyTargetInfo();
  fn InitializeWebAssemblyTarget();
  fn InitializeWebAssemblyTargetMC();
  fn InitializeWebAssemblyAsmPrinter();
  fn InitializeWebAssemblyAsmParser();
  fn InitializeSPIRVTargetInfo();
  fn InitializeSPIRVTarget();
  fn InitializeSPIRVTargetMC();
  fn InitializeSPIRVAsmPrinter();
}

// What the C header's static inline functions do, for the three targets above
pub fn InitializeAllTargetInfos() inline {
  InitializeX86TargetInfo();
  InitializeWebAssemblyTargetInfo();
  InitializeSPIRVTargetInfo();
}
pub fn InitializeAllTargets() inline {
  InitializeX86Target();
  InitializeWebAssemblyTarget();
  InitializeSPIRVTarget();
}
pub fn InitializeAllTargetMCs() inline {
  InitializeX86TargetMC();
  InitializeWebAssemblyTargetMC();
  InitializeSPIRVTargetMC();
}
pub fn InitializeAllAsmPrinters() inline {
  InitializeX86AsmPrinter();
  InitializeWebAssemblyAsmPrinter();
  InitializeSPIRVAsmPrinter();
}
pub fn InitializeAllAsmParsers() inline {
  InitializeX86AsmParser();
  InitializeWebAssemblyAsmParser();
}
