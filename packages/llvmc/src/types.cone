// llvm-c/Types.h: the handles of LLVM's objects. Each is a pointer to a type of
// its own that nothing can look inside (an @opaque struct), so a *Value is not a *Type
// and the compiler says so; the C typedef LLVMValueRef is written *Value here.

pub struct @opaque MemoryBuffer {}        // LLVMMemoryBufferRef
pub struct @opaque Context {}             // LLVMContextRef
pub struct @opaque Module {}              // LLVMModuleRef
pub struct @opaque Type {}                // LLVMTypeRef
pub struct @opaque Value {}               // LLVMValueRef
pub struct @opaque BasicBlock {}          // LLVMBasicBlockRef
pub struct @opaque Metadata {}            // LLVMMetadataRef
pub struct @opaque Builder {}             // LLVMBuilderRef
pub struct @opaque DIBuilder {}           // LLVMDIBuilderRef
pub struct @opaque Use {}                 // LLVMUseRef
pub struct @opaque Attribute {}           // LLVMAttributeRef
pub struct @opaque Comdat {}              // LLVMComdatRef

// LLVMValueMetadataEntry is the one handle in Types.h the C header does not hide
// behind a pointer typedef: a function takes and answers a 'LLVMValueMetadataEntry *'
pub struct @opaque ValueMetadataEntry {}
