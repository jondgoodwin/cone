// llvm-c/Core.h: contexts, modules, types, values, constants, globals and functions,
// basic blocks, instructions and the instruction builder, memory buffers.
// Every enumerator below is the value LLVM 23.1.2's own header gives it (a C program
// compiled against the header printed each one).

// LLVMOpcode: llvm-c/Core.h lines 61-150
pub enum Opcode: u32 {
  Ret = 1, UncondBr = 70, CondBr = 71, Switch = 3, IndirectBr = 4, Invoke = 5, Unreachable = 7,
  CallBr = 67, FNeg = 66, Add = 8, FAdd = 9, Sub = 10, FSub = 11, Mul = 12, FMul = 13, UDiv = 14,
  SDiv = 15, FDiv = 16, URem = 17, SRem = 18, FRem = 19, Shl = 20, LShr = 21, AShr = 22, And = 23, Or = 24,
  Xor = 25, Alloca = 26, Load = 27, Store = 28, GetElementPtr = 29, Trunc = 30, ZExt = 31, SExt = 32,
  FPToUI = 33, FPToSI = 34, UIToFP = 35, SIToFP = 36, FPTrunc = 37, FPExt = 38, PtrToInt = 39,
  PtrToAddr = 69, IntToPtr = 40, BitCast = 41, AddrSpaceCast = 60, ICmp = 42, FCmp = 43, PHI = 44,
  Call = 45, Select = 46, UserOp1 = 47, UserOp2 = 48, VAArg = 49, ExtractElement = 50, InsertElement = 51,
  ShuffleVector = 52, ExtractValue = 53, InsertValue = 54, Freeze = 68, Fence = 55, AtomicCmpXchg = 56,
  AtomicRMW = 57, Resume = 58, LandingPad = 59, CleanupRet = 61, CatchRet = 62, CatchPad = 63,
  CleanupPad = 64, CatchSwitch = 65
}

// LLVMTypeKind: llvm-c/Core.h lines 152-175
pub enum TypeKind: u32 {
  VoidTypeKind = 0, HalfTypeKind = 1, FloatTypeKind = 2, DoubleTypeKind = 3, X86_FP80TypeKind = 4,
  FP128TypeKind = 5, PPC_FP128TypeKind = 6, LabelTypeKind = 7, IntegerTypeKind = 8, FunctionTypeKind = 9,
  StructTypeKind = 10, ArrayTypeKind = 11, PointerTypeKind = 12, VectorTypeKind = 13,
  MetadataTypeKind = 14, TokenTypeKind = 16, ScalableVectorTypeKind = 17, BFloatTypeKind = 18,
  X86_AMXTypeKind = 19, TargetExtTypeKind = 20, ByteTypeKind = 21
}

// LLVMLinkage: llvm-c/Core.h lines 177-198
pub enum Linkage: u32 {
  ExternalLinkage = 0, AvailableExternallyLinkage = 1, LinkOnceAnyLinkage = 2, LinkOnceODRLinkage = 3,
  LinkOnceODRAutoHideLinkage = 4, WeakAnyLinkage = 5, WeakODRLinkage = 6, AppendingLinkage = 7,
  InternalLinkage = 8, PrivateLinkage = 9, DLLImportLinkage = 10, DLLExportLinkage = 11,
  ExternalWeakLinkage = 12, GhostLinkage = 13, CommonLinkage = 14, LinkerPrivateLinkage = 15,
  LinkerPrivateWeakLinkage = 16
}

// LLVMVisibility: llvm-c/Core.h lines 200-204
pub enum Visibility: u32 {
  DefaultVisibility = 0, HiddenVisibility = 1, ProtectedVisibility = 2
}

// LLVMUnnamedAddr: llvm-c/Core.h lines 206-210
pub enum UnnamedAddr: u32 {
  NoUnnamedAddr = 0, LocalUnnamedAddr = 1, GlobalUnnamedAddr = 2
}

// LLVMDLLStorageClass: llvm-c/Core.h lines 212-216
pub enum DLLStorageClass: u32 {
  DefaultStorageClass = 0, DLLImportStorageClass = 1, DLLExportStorageClass = 2
}

// LLVMIntPredicate: llvm-c/Core.h lines 298-309
pub enum IntPredicate: u32 {
  IntEQ = 32, IntNE = 33, IntUGT = 34, IntUGE = 35, IntULT = 36, IntULE = 37, IntSGT = 38, IntSGE = 39,
  IntSLT = 40, IntSLE = 41
}

// LLVMRealPredicate: llvm-c/Core.h lines 311-328
pub enum RealPredicate: u32 {
  RealPredicateFalse = 0, RealOEQ = 1, RealOGT = 2, RealOGE = 3, RealOLT = 4, RealOLE = 5, RealONE = 6,
  RealORD = 7, RealUNO = 8, RealUEQ = 9, RealUGT = 10, RealUGE = 11, RealULT = 12, RealULE = 13,
  RealUNE = 14, RealPredicateTrue = 15
}

// LLVMAtomicOrdering: llvm-c/Core.h lines 338-363
pub enum AtomicOrdering: u32 {
  AtomicOrderingNotAtomic = 0, AtomicOrderingUnordered = 1, AtomicOrderingMonotonic = 2,
  AtomicOrderingAcquire = 4, AtomicOrderingRelease = 5, AtomicOrderingAcquireRelease = 6,
  AtomicOrderingSequentiallyConsistent = 7
}

// LLVMAtomicRMWBinOp: llvm-c/Core.h lines 365-414
pub enum AtomicRMWBinOp: u32 {
  AtomicRMWBinOpXchg = 0, AtomicRMWBinOpAdd = 1, AtomicRMWBinOpSub = 2, AtomicRMWBinOpAnd = 3,
  AtomicRMWBinOpNand = 4, AtomicRMWBinOpOr = 5, AtomicRMWBinOpXor = 6, AtomicRMWBinOpMax = 7,
  AtomicRMWBinOpMin = 8, AtomicRMWBinOpUMax = 9, AtomicRMWBinOpUMin = 10, AtomicRMWBinOpFAdd = 11,
  AtomicRMWBinOpFSub = 12, AtomicRMWBinOpFMax = 13, AtomicRMWBinOpFMin = 14, AtomicRMWBinOpUIncWrap = 15,
  AtomicRMWBinOpUDecWrap = 16, AtomicRMWBinOpUSubCond = 17, AtomicRMWBinOpUSubSat = 18,
  AtomicRMWBinOpFMaximum = 19, AtomicRMWBinOpFMinimum = 20, AtomicRMWBinOpFMaximumNum = 21,
  AtomicRMWBinOpFMinimumNum = 22
}

// A function's calling convention and an attribute's index go in as a C 'unsigned',
// so they are u32 constants (the C enum LLVMCallConv names values, and a function
// takes the number). LLVMAttributeFunctionIndex is C's -1 in an unsigned: 4294967295.
// LLVMCallConv: llvm-c/Core.h lines 218-260 (values as the header's own compile gives them)
pub const CCallConv = 0u32;
pub const FastCallConv = 8u32;
pub const ColdCallConv = 9u32;
pub const GHCCallConv = 10u32;
pub const HiPECallConv = 11u32;
pub const AnyRegCallConv = 13u32;
pub const PreserveMostCallConv = 14u32;
pub const PreserveAllCallConv = 15u32;
pub const SwiftCallConv = 16u32;
pub const CXXFASTTLSCallConv = 17u32;
pub const X86StdcallCallConv = 64u32;
pub const X86FastcallCallConv = 65u32;
pub const ARMAPCSCallConv = 66u32;
pub const ARMAAPCSCallConv = 67u32;
pub const ARMAAPCSVFPCallConv = 68u32;
pub const MSP430INTRCallConv = 69u32;
pub const X86ThisCallCallConv = 70u32;
pub const PTXKernelCallConv = 71u32;
pub const PTXDeviceCallConv = 72u32;
pub const SPIRFUNCCallConv = 75u32;
pub const SPIRKERNELCallConv = 76u32;
pub const IntelOCLBICallConv = 77u32;
pub const X8664SysVCallConv = 78u32;
pub const Win64CallConv = 79u32;
pub const X86VectorCallCallConv = 80u32;
pub const HHVMCallConv = 81u32;
pub const HHVMCCallConv = 82u32;
pub const X86INTRCallConv = 83u32;
pub const AVRINTRCallConv = 84u32;
pub const AVRSIGNALCallConv = 85u32;
pub const AVRBUILTINCallConv = 86u32;
pub const AMDGPUVSCallConv = 87u32;
pub const AMDGPUGSCallConv = 88u32;
pub const AMDGPUPSCallConv = 89u32;
pub const AMDGPUCSCallConv = 90u32;
pub const AMDGPUKERNELCallConv = 91u32;
pub const X86RegCallCallConv = 92u32;
pub const AMDGPUHSCallConv = 93u32;
pub const MSP430BUILTINCallConv = 94u32;
pub const AMDGPULSCallConv = 95u32;
pub const AMDGPUESCallConv = 96u32;

// llvm-c/Core.h lines 479-488 (the anonymous enum before LLVMAttributeIndex)
pub const AttributeReturnIndex = 0u32;
pub const AttributeFunctionIndex = 4294967295u32;

pub extern {

  // Types and Enumerations
  fn Shutdown();
  fn GetVersion(major: *u32, minor: *u32, patch: *u32);
  fn CreateMessage(message: cstr) *u8;
  fn DisposeMessage(message: *u8);

  // Contexts
  fn ContextCreate() *Context;
  fn ContextDispose(c: *Context);
  fn GetMDKindIDInContext(c: *Context, name: *u8, sLen: u32) u32;
  fn GetSyncScopeID(c: *Context, name: *u8, sLen: usize) u32;
  fn GetEnumAttributeKindForName(name: *u8, sLen: usize) u32;
  fn CreateEnumAttribute(c: *Context, kindID: u32, val: u64) *Attribute;
  fn CreateTypeAttribute(c: *Context, kindID: u32, type_ref: *Type) *Attribute;
  fn CreateStringAttribute(c: *Context, k: *u8, kLength: u32, v: *u8, vLength: u32) *Attribute;

  // Modules
  fn ModuleCreateWithNameInContext(moduleID: cstr, c: *Context) *Module;
  fn CloneModule(m: *Module) *Module;
  fn DisposeModule(m: *Module);
  fn GetDataLayoutStr(m: *Module) *u8;
  fn SetDataLayout(m: *Module, dataLayoutStr: cstr);
  fn GetTarget(m: *Module) *u8;
  fn SetTarget(m: *Module, triple: cstr);
  fn PrintModuleToFile(m: *Module, filename: cstr, errorMessage: **u8) i32;
  fn PrintModuleToString(m: *Module) *u8;
  fn GetNamedMetadataNumOperands(m: *Module, name: cstr) u32;
  fn AddFunction(m: *Module, name: cstr, functionTy: *Type) *Value;
  fn GetNamedFunction(m: *Module, name: cstr) *Value;
  fn GetFirstFunction(m: *Module) *Value;
  fn GetNextFunction(func: *Value) *Value;

  // Types
  fn GetTypeKind(ty: *Type) TypeKind;
  fn TypeIsSized(ty: *Type) i32;
  fn PrintTypeToString(val: *Type) *u8;

  // Integer Types
  fn Int1TypeInContext(c: *Context) *Type;
  fn Int8TypeInContext(c: *Context) *Type;
  fn Int16TypeInContext(c: *Context) *Type;
  fn Int32TypeInContext(c: *Context) *Type;
  fn Int64TypeInContext(c: *Context) *Type;
  fn IntTypeInContext(c: *Context, numBits: u32) *Type;
  fn GetIntTypeWidth(integerTy: *Type) u32;

  // Floating Point Types
  fn HalfTypeInContext(c: *Context) *Type;
  fn FloatTypeInContext(c: *Context) *Type;
  fn DoubleTypeInContext(c: *Context) *Type;

  // Function Types
  fn FunctionType(returnType: *Type, paramTypes: **Type, paramCount: u32, isVarArg: i32) *Type;
  fn IsFunctionVarArg(functionTy: *Type) i32;
  fn GetReturnType(functionTy: *Type) *Type;
  fn CountParamTypes(functionTy: *Type) u32;
  fn GetParamTypes(functionTy: *Type, dest: **Type);

  // Structure Types
  fn StructTypeInContext(c: *Context, elementTypes: **Type, elementCount: u32, packed: i32) *Type;
  fn StructCreateNamed(c: *Context, name: cstr) *Type;
  fn StructSetBody(structTy: *Type, elementTypes: **Type, elementCount: u32, packed: i32);
  fn CountStructElementTypes(structTy: *Type) u32;
  fn StructGetTypeAtIndex(structTy: *Type, i: u32) *Type;
  fn IsOpaqueStruct(structTy: *Type) i32;

  // Sequential Types
  fn GetElementType(ty: *Type) *Type;
  fn ArrayType(elementType: *Type, elementCount: u32) *Type;
  fn ArrayType2(elementType: *Type, elementCount: u64) *Type;
  fn GetArrayLength(arrayTy: *Type) u32;
  fn GetArrayLength2(arrayTy: *Type) u64;
  fn PointerType(elementType: *Type, addressSpace: u32) *Type;
  fn PointerTypeInContext(c: *Context, addressSpace: u32) *Type;
  fn GetPointerAddressSpace(pointerTy: *Type) u32;
  fn VectorType(elementType: *Type, elementCount: u32) *Type;

  // Other Types
  fn VoidTypeInContext(c: *Context) *Type;
  fn TargetExtTypeInContext(
    c: *Context, name: cstr, typeParams: **Type, typeParamCount: u32, intParams: *u32, intParamCount: u32) *Type;
  fn GetTargetExtTypeTypeParam(targetExtTy: *Type, idx: u32) *Type;

  // General APIs
  fn TypeOf(val: *Value) *Type;
  fn GetValueName2(val: *Value, length: *usize) *u8;
  fn SetValueName2(val: *Value, name: *u8, nameLen: usize);
  fn PrintValueToString(val: *Value) *u8;
  fn ReplaceAllUsesWith(oldVal: *Value, newVal: *Value);
  fn IsConstant(val: *Value) i32;
  fn IsUndef(val: *Value) i32;
  fn IsPoison(val: *Value) i32;

  // Usage
  fn GetFirstUse(val: *Value) *Use;
  fn GetNextUse(u: *Use) *Use;
  fn GetUser(u: *Use) *Value;

  // User value
  fn GetOperand(val: *Value, index: u32) *Value;
  fn SetOperand(user: *Value, index: u32, val: *Value);
  fn GetNumOperands(val: *Value) i32;

  // Constants
  fn ConstNull(ty: *Type) *Value;
  fn GetUndef(ty: *Type) *Value;
  fn GetPoison(ty: *Type) *Value;
  fn IsNull(val: *Value) i32;
  fn ConstPointerNull(ty: *Type) *Value;

  // Scalar constants
  fn ConstInt(intTy: *Type, n: u64, signExtend: i32) *Value;
  fn ConstReal(realTy: *Type, n: f64) *Value;
  fn ConstIntGetZExtValue(constantVal: *Value) u64;

  // Composite Constants
  fn ConstStringInContext2(c: *Context, str: *u8, length: usize, dontNullTerminate: i32) *Value;
  fn ConstStructInContext(c: *Context, constantVals: **Value, count: u32, packed: i32) *Value;
  fn ConstArray(elementTy: *Type, constantVals: **Value, length: u32) *Value;
  fn ConstArray2(elementTy: *Type, constantVals: **Value, length: u64) *Value;
  fn ConstNamedStruct(structTy: *Type, constantVals: **Value, count: u32) *Value;
  fn GetAggregateElement(c: *Value, idx: u32) *Value;

  // Constant Expressions
  fn GetConstOpcode(constantVal: *Value) Opcode;
  fn SizeOf(ty: *Type) *Value;
  fn ConstBitCast(constantVal: *Value, toType: *Type) *Value;
  fn ConstAddrSpaceCast(constantVal: *Value, toType: *Type) *Value;

  // Global Values
  fn IsDeclaration(global: *Value) i32;
  fn GetLinkage(global: *Value) Linkage;
  fn SetLinkage(global: *Value, linkage: Linkage);
  fn GetSection(global: *Value) *u8;
  fn SetSection(global: *Value, section: cstr);
  fn GetVisibility(global: *Value) Visibility;
  fn SetVisibility(global: *Value, viz: Visibility);
  fn GetDLLStorageClass(global: *Value) DLLStorageClass;
  fn SetDLLStorageClass(global: *Value, cls: DLLStorageClass);
  fn GetUnnamedAddress(global: *Value) UnnamedAddr;
  fn SetUnnamedAddress(global: *Value, unnamedAddr: UnnamedAddr);
  fn GlobalGetValueType(global: *Value) *Type;

  // Values with alignment
  fn GetAlignment(v: *Value) u32;
  fn SetAlignment(v: *Value, bytes: u32);
  fn GlobalSetMetadata(global: *Value, kind: u32, md: *Metadata);
  fn GlobalClearMetadata(global: *Value);
  fn GlobalCopyAllMetadata(value: *Value, numEntries: *usize) *ValueMetadataEntry;
  fn DisposeValueMetadataEntries(entries: *ValueMetadataEntry);
  fn ValueMetadataEntriesGetKind(entries: *ValueMetadataEntry, index: u32) u32;
  fn ValueMetadataEntriesGetMetadata(entries: *ValueMetadataEntry, index: u32) *Metadata;

  // Global Variables
  fn AddGlobal(m: *Module, ty: *Type, name: cstr) *Value;
  fn AddGlobalInAddressSpace(m: *Module, ty: *Type, name: cstr, addressSpace: u32) *Value;
  fn GetNamedGlobal(m: *Module, name: cstr) *Value;
  fn DeleteGlobal(globalVar: *Value);
  fn SetInitializer(globalVar: *Value, constantVal: *Value);
  fn SetThreadLocal(globalVar: *Value, isThreadLocal: i32);
  fn SetGlobalConstant(globalVar: *Value, isConstant: i32);

  // Function values
  fn DeleteFunction(func: *Value);
  fn HasPersonalityFn(func: *Value) i32;
  fn GetPersonalityFn(func: *Value) *Value;
  fn SetPersonalityFn(func: *Value, personalityFn: *Value);
  fn LookupIntrinsicID(name: *u8, nameLen: usize) u32;
  fn GetIntrinsicID(func: *Value) u32;
  fn GetIntrinsicDeclaration(module: *Module, id: u32, overloadTypes: **Type, overloadCount: usize) *Value;
  fn IntrinsicGetType(ctx: *Context, id: u32, overloadTypes: **Type, overloadCount: usize) *Type;
  fn GetFunctionCallConv(func: *Value) u32;
  fn SetFunctionCallConv(func: *Value, cc: u32);
  fn GetGC(func: *Value) *u8;
  fn SetGC(func: *Value, name: cstr);
  fn AddAttributeAtIndex(f: *Value, idx: u32, a: *Attribute);
  fn GetAttributeCountAtIndex(f: *Value, idx: u32) u32;
  fn GetAttributesAtIndex(f: *Value, idx: u32, attrs: **Attribute);
  fn GetStringAttributeAtIndex(f: *Value, idx: u32, k: *u8, kLen: u32) *Attribute;
  fn RemoveStringAttributeAtIndex(f: *Value, idx: u32, k: *u8, kLen: u32);

  // Function Parameters
  fn CountParams(func: *Value) u32;
  fn GetParam(func: *Value, index: u32) *Value;
  fn GetParamParent(inst: *Value) *Value;

  // Metadata
  fn MetadataAsValue(c: *Context, md: *Metadata) *Value;
  fn ValueAsMetadata(val: *Value) *Metadata;
  fn MDNodeInContext(c: *Context, vals: **Value, count: u32) *Value;

  // Basic Block
  fn GetBasicBlockParent(bb: *BasicBlock) *Value;
  fn GetBasicBlockTerminator(bb: *BasicBlock) *Value;
  fn CountBasicBlocks(func: *Value) u32;
  fn GetBasicBlocks(func: *Value, basicBlocks: **BasicBlock);
  fn GetFirstBasicBlock(func: *Value) *BasicBlock;
  fn GetNextBasicBlock(bb: *BasicBlock) *BasicBlock;
  fn GetEntryBasicBlock(func: *Value) *BasicBlock;
  fn AppendExistingBasicBlock(func: *Value, bb: *BasicBlock);
  fn AppendBasicBlockInContext(c: *Context, func: *Value, name: cstr) *BasicBlock;
  fn InsertBasicBlockInContext(c: *Context, bb: *BasicBlock, name: cstr) *BasicBlock;
  fn RemoveBasicBlockFromParent(bb: *BasicBlock);
  fn MoveBasicBlockBefore(bb: *BasicBlock, movePos: *BasicBlock);
  fn GetFirstInstruction(bb: *BasicBlock) *Value;

  // Instructions
  fn GetMetadata(val: *Value, kindID: u32) *Value;
  fn SetMetadata(val: *Value, kindID: u32, node: *Value);
  fn GetInstructionParent(inst: *Value) *BasicBlock;
  fn GetNextInstruction(inst: *Value) *Value;
  fn GetPreviousInstruction(inst: *Value) *Value;
  fn InstructionEraseFromParent(inst: *Value);
  fn GetInstructionOpcode(inst: *Value) Opcode;
  fn InstructionClone(inst: *Value) *Value;

  // Call Sites and Invocations
  fn GetNumArgOperands(instr: *Value) u32;
  fn SetInstructionCallConv(instr: *Value, cc: u32);
  fn GetInstructionCallConv(instr: *Value) u32;
  fn AddCallSiteAttribute(c: *Value, idx: u32, a: *Attribute);
  fn GetCallSiteAttributeCount(c: *Value, idx: u32) u32;
  fn GetCallSiteAttributes(c: *Value, idx: u32, attrs: **Attribute);
  fn GetCalledFunctionType(c: *Value) *Type;
  fn GetCalledValue(instr: *Value) *Value;
  fn SetTailCall(callInst: *Value, isTailCall: i32);

  // Terminators
  fn GetNumSuccessors(term: *Value) u32;
  fn GetSuccessor(term: *Value, i: u32) *BasicBlock;
  fn SetSuccessor(term: *Value, i: u32, block: *BasicBlock);

  // Allocas
  fn GetAllocatedType(alloca: *Value) *Type;

  // GEPs
  fn IsInBounds(gep: *Value) i32;
  fn GetGEPSourceElementType(gep: *Value) *Type;

  // PHI Nodes
  fn AddIncoming(phiNode: *Value, incomingValues: **Value, incomingBlocks: **BasicBlock, count: u32);
  fn CountIncoming(phiNode: *Value) u32;
  fn GetIncomingValue(phiNode: *Value, index: u32) *Value;
  fn GetIncomingBlock(phiNode: *Value, index: u32) *BasicBlock;

  // InsertValue
  fn GetNumIndices(inst: *Value) u32;
  fn GetIndices(inst: *Value) *u32;

  // Instruction Builders
  fn CreateBuilderInContext(c: *Context) *Builder;
  fn PositionBuilder(builder: *Builder, block: *BasicBlock, instr: *Value);
  fn PositionBuilderBefore(builder: *Builder, instr: *Value);
  fn PositionBuilderAtEnd(builder: *Builder, block: *BasicBlock);
  fn GetInsertBlock(builder: *Builder) *BasicBlock;
  fn InsertIntoBuilder(builder: *Builder, instr: *Value);
  fn DisposeBuilder(builder: *Builder);
  fn GetCurrentDebugLocation2(builder: *Builder) *Metadata;
  fn SetCurrentDebugLocation2(builder: *Builder, loc: *Metadata);
  fn SetCurrentDebugLocation(builder: *Builder, l: *Value);
  fn BuildRetVoid(b: *Builder) *Value;
  fn BuildRet(b: *Builder, v: *Value) *Value;
  fn BuildBr(b: *Builder, dest: *BasicBlock) *Value;
  fn BuildCondBr(b: *Builder, cond: *Value, thenVal: *BasicBlock, otherwise: *BasicBlock) *Value;
  fn BuildSwitch(b: *Builder, v: *Value, otherwise: *BasicBlock, numCases: u32) *Value;
  fn BuildUnreachable(b: *Builder) *Value;
  fn AddCase(switchInst: *Value, onVal: *Value, dest: *BasicBlock);
  fn BuildAdd(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildFAdd(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildSub(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildFSub(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildMul(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildFMul(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildUDiv(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildSDiv(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildExactSDiv(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildFDiv(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildURem(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildSRem(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildFRem(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildShl(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildLShr(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildAShr(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildAnd(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildOr(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildXor(b: *Builder, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildNeg(b: *Builder, v: *Value, name: cstr) *Value;
  fn BuildFNeg(b: *Builder, v: *Value, name: cstr) *Value;
  fn BuildNot(b: *Builder, v: *Value, name: cstr) *Value;
  fn BuildMalloc(b: *Builder, ty: *Type, name: cstr) *Value;
  fn BuildMemSet(b: *Builder, ptr: *Value, val: *Value, len: *Value, align: u32) *Value;
  fn BuildMemCpy(b: *Builder, dst: *Value, dstAlign: u32, src: *Value, srcAlign: u32, size: *Value) *Value;
  fn BuildMemMove(b: *Builder, dst: *Value, dstAlign: u32, src: *Value, srcAlign: u32, size: *Value) *Value;
  fn BuildAlloca(b: *Builder, ty: *Type, name: cstr) *Value;
  fn BuildFree(b: *Builder, pointerVal: *Value) *Value;
  fn BuildLoad2(b: *Builder, ty: *Type, pointerVal: *Value, name: cstr) *Value;
  fn BuildStore(b: *Builder, val: *Value, ptr: *Value) *Value;
  fn BuildGEP2(b: *Builder, ty: *Type, pointer: *Value, indices: **Value, numIndices: u32, name: cstr) *Value;
  fn BuildInBoundsGEP2(
    b: *Builder, ty: *Type, pointer: *Value, indices: **Value, numIndices: u32, name: cstr) *Value;
  fn BuildStructGEP2(b: *Builder, ty: *Type, pointer: *Value, idx: u32, name: cstr) *Value;
  fn GetVolatile(inst: *Value) i32;
  fn GetOrdering(memoryAccessInst: *Value) AtomicOrdering;
  fn SetOrdering(memoryAccessInst: *Value, ordering: AtomicOrdering);
  fn BuildTrunc(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildZExt(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildSExt(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildFPToUI(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildFPToSI(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildUIToFP(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildSIToFP(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildFPTrunc(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildFPExt(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildPtrToInt(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildIntToPtr(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildBitCast(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildAddrSpaceCast(b: *Builder, val: *Value, destTy: *Type, name: cstr) *Value;
  fn BuildIntCast2(b: *Builder, val: *Value, destTy: *Type, isSigned: i32, name: cstr) *Value;
  fn BuildICmp(b: *Builder, op: IntPredicate, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildFCmp(b: *Builder, op: RealPredicate, lhs: *Value, rhs: *Value, name: cstr) *Value;
  fn BuildPhi(b: *Builder, ty: *Type, name: cstr) *Value;
  fn BuildCall2(b: *Builder, t: *Type, func: *Value, args: **Value, numArgs: u32, name: cstr) *Value;
  fn BuildSelect(b: *Builder, cond: *Value, thenVal: *Value, otherwise: *Value, name: cstr) *Value;
  fn BuildExtractElement(b: *Builder, vecVal: *Value, index: *Value, name: cstr) *Value;
  fn BuildInsertElement(b: *Builder, vecVal: *Value, eltVal: *Value, index: *Value, name: cstr) *Value;
  fn BuildExtractValue(b: *Builder, aggVal: *Value, index: u32, name: cstr) *Value;
  fn BuildInsertValue(b: *Builder, aggVal: *Value, eltVal: *Value, index: u32, name: cstr) *Value;
  fn BuildFreeze(b: *Builder, val: *Value, name: cstr) *Value;
  fn BuildIsNull(b: *Builder, val: *Value, name: cstr) *Value;
  fn BuildIsNotNull(b: *Builder, val: *Value, name: cstr) *Value;
  fn BuildAtomicRMW(
    b: *Builder, op: AtomicRMWBinOp, ptr: *Value, val: *Value, ordering: AtomicOrdering, singleThread: i32) *Value;
  fn BuildAtomicRMWSyncScope(
    b: *Builder, op: AtomicRMWBinOp, ptr: *Value, val: *Value, ordering: AtomicOrdering, ssid: u32) *Value;
  fn BuildAtomicCmpXchg(
    b: *Builder, ptr: *Value, cmp: *Value, newVal: *Value, successOrdering: AtomicOrdering,
    failureOrdering: AtomicOrdering, singleThread: i32) *Value;
  fn IsAtomic(inst: *Value) i32;
  fn GetAtomicSyncScopeID(atomicInst: *Value) u32;
  fn SetAtomicSyncScopeID(atomicInst: *Value, ssid: u32);
  fn GetCmpXchgSuccessOrdering(cmpXchgInst: *Value) AtomicOrdering;
  fn GetCmpXchgFailureOrdering(cmpXchgInst: *Value) AtomicOrdering;

  // Memory Buffers
  fn GetBufferStart(memBuf: *MemoryBuffer) *u8;
  fn GetBufferSize(memBuf: *MemoryBuffer) usize;
  fn DisposeMemoryBuffer(memBuf: *MemoryBuffer);

  // The checked casts of a value (the LLVM_DECLARE_VALUE_CAST macro, llvm-c/Core.h line 2228):
  // each answers the value itself when it is of that kind, null when it is not
  fn IsAAddrSpaceCastInst(val: *Value) *Value;
  fn IsAAllocaInst(val: *Value) *Value;
  fn IsAArgument(val: *Value) *Value;
  fn IsAAtomicCmpXchgInst(val: *Value) *Value;
  fn IsAAtomicRMWInst(val: *Value) *Value;
  fn IsABasicBlock(val: *Value) *Value;
  fn IsABitCastInst(val: *Value) *Value;
  fn IsACallInst(val: *Value) *Value;
  fn IsAConstant(val: *Value) *Value;
  fn IsAConstantExpr(val: *Value) *Value;
  fn IsAConstantInt(val: *Value) *Value;
  fn IsAExtractValueInst(val: *Value) *Value;
  fn IsAFunction(val: *Value) *Value;
  fn IsAGetElementPtrInst(val: *Value) *Value;
  fn IsAGlobalVariable(val: *Value) *Value;
  fn IsAInsertValueInst(val: *Value) *Value;
  fn IsAInstruction(val: *Value) *Value;
  fn IsALoadInst(val: *Value) *Value;
  fn IsAPHINode(val: *Value) *Value;
  fn IsAReturnInst(val: *Value) *Value;
  fn IsASelectInst(val: *Value) *Value;
  fn IsAStoreInst(val: *Value) *Value;
}
