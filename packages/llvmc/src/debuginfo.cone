  DWARFSourceLanguageC89 = 0, DWARFSourceLanguageC = 1, DWARFSourceLanguageAda83 = 2,
  DWARFSourceLanguageC_plus_plus = 3, DWARFSourceLanguageCobol74 = 4, DWARFSourceLanguageCobol85 = 5,
  DWARFSourceLanguageFortran77 = 6, DWARFSourceLanguageFortran90 = 7, DWARFSourceLanguagePascal83 = 8,
  DWARFSourceLanguageModula2 = 9, DWARFSourceLanguageJava = 10, DWARFSourceLanguageC99 = 11,
  DWARFSourceLanguageAda95 = 12, DWARFSourceLanguageFortran95 = 13, DWARFSourceLanguagePLI = 14,
  DWARFSourceLanguageObjC = 15, DWARFSourceLanguageObjC_plus_plus = 16, DWARFSourceLanguageUPC = 17,
  DWARFSourceLanguageD = 18, DWARFSourceLanguagePython = 19, DWARFSourceLanguageOpenCL = 20,
  DWARFSourceLanguageGo = 21, DWARFSourceLanguageModula3 = 22, DWARFSourceLanguageHaskell = 23,
  DWARFSourceLanguageC_plus_plus_03 = 24, DWARFSourceLanguageC_plus_plus_11 = 25,
  DWARFSourceLanguageOCaml = 26, DWARFSourceLanguageRust = 27, DWARFSourceLanguageC11 = 28,
  DWARFSourceLanguageSwift = 29, DWARFSourceLanguageJulia = 30, DWARFSourceLanguageDylan = 31,
  DWARFSourceLanguageC_plus_plus_14 = 32, DWARFSourceLanguageFortran03 = 33,
  DWARFSourceLanguageFortran08 = 34, DWARFSourceLanguageRenderScript = 35, DWARFSourceLanguageBLISS = 36,
  DWARFSourceLanguageKotlin = 37, DWARFSourceLanguageZig = 38, DWARFSourceLanguageCrystal = 39,
  DWARFSourceLanguageC_plus_plus_17 = 40, DWARFSourceLanguageC_plus_plus_20 = 41,
  DWARFSourceLanguageC17 = 42, DWARFSourceLanguageFortran18 = 43, DWARFSourceLanguageAda2005 = 44,
  DWARFSourceLanguageAda2012 = 45, DWARFSourceLanguageHIP = 46, DWARFSourceLanguageAssembly = 47,
  DWARFSourceLanguageC_sharp = 48, DWARFSourceLanguageMojo = 49, DWARFSourceLanguageGLSL = 50,
  DWARFSourceLanguageGLSL_ES = 51, DWARFSourceLanguageHLSL = 52, DWARFSourceLanguageOpenCL_CPP = 53,
  DWARFSourceLanguageCPP_for_OpenCL = 54, DWARFSourceLanguageSYCL = 55, DWARFSourceLanguageRuby = 56,
