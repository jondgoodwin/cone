// LLVMDWARFEmissionKind: llvm-c/DebugInfo.h lines 153-157
pub enum DWARFEmissionKind: u32 {
  DWARFEmissionNone = 0, DWARFEmissionFull = 1, DWARFEmissionLineTablesOnly = 2
}

// LLVMDIFlags is a set of bits that are combined with |, and its values are not distinct (FixedEnum is
// EnumClass), so it is u32 constants and every flags parameter is a u32.
// LLVMDIFlags: llvm-c/DebugInfo.h lines 35-74 (values as the header's own compile gives them)
pub const DIFlagZero = 0u32;
pub const DIFlagPrivate = 1u32;
pub const DIFlagProtected = 2u32;
pub const DIFlagPublic = 3u32;
pub const DIFlagFwdDecl = 4u32;
pub const DIFlagAppleBlock = 8u32;
pub const DIFlagReservedBit4 = 16u32;
pub const DIFlagVirtual = 32u32;
pub const DIFlagArtificial = 64u32;
pub const DIFlagExplicit = 128u32;
pub const DIFlagPrototyped = 256u32;
pub const DIFlagObjcClassComplete = 512u32;
pub const DIFlagObjectPointer = 1024u32;
pub const DIFlagVector = 2048u32;
pub const DIFlagStaticMember = 4096u32;
pub const DIFlagLValueReference = 8192u32;
pub const DIFlagRValueReference = 16384u32;
pub const DIFlagReserved = 32768u32;
pub const DIFlagSingleInheritance = 65536u32;
pub const DIFlagMultipleInheritance = 131072u32;
pub const DIFlagVirtualInheritance = 196608u32;
pub const DIFlagIntroducedVirtual = 262144u32;
pub const DIFlagBitField = 524288u32;
pub const DIFlagNoReturn = 1048576u32;
pub const DIFlagTypePassByValue = 4194304u32;
pub const DIFlagTypePassByReference = 8388608u32;
pub const DIFlagEnumClass = 16777216u32;
pub const DIFlagFixedEnum = 16777216u32;
pub const DIFlagThunk = 33554432u32;
pub const DIFlagNonTrivial = 67108864u32;
pub const DIFlagBigEndian = 134217728u32;
pub const DIFlagLittleEndian = 268435456u32;
pub const DIFlagIndirectVirtualBase = 36u32;
pub const DIFlagAccessibility = 3u32;
pub const DIFlagPtrToMemberRep = 196608u32;

pub extern {

  // Debug Information
  fn CreateDIBuilder(m: *Module) *DIBuilder;
  fn DIBuilderFinalize(builder: *DIBuilder);
  fn DIBuilderCreateCompileUnit(
    builder: *DIBuilder, lang: DWARFSourceLanguage, fileRef: *Metadata, producer: *u8, producerLen: usize,
    isOptimized: i32, flags: *u8, flagsLen: usize, runtimeVer: u32, splitName: *u8, splitNameLen: usize,
    kind: DWARFEmissionKind, dwoId: u32, splitDebugInlining: i32, debugInfoForProfiling: i32, sysRoot: *u8,
    sysRootLen: usize, sdk: *u8, sdkLen: usize) *Metadata;
  fn DIBuilderCreateFile(
    builder: *DIBuilder, filename: *u8, filenameLen: usize, directory: *u8, directoryLen: usize) *Metadata;
  fn DIBuilderCreateFunction(
    builder: *DIBuilder, scope: *Metadata, name: *u8, nameLen: usize, linkageName: *u8, linkageNameLen: usize,
    file: *Metadata, lineNo: u32, ty: *Metadata, isLocalToUnit: i32, isDefinition: i32, scopeLine: u32,
    flags: u32, isOptimized: i32) *Metadata;
  fn DIBuilderCreateDebugLocation(
    ctx: *Context, line: u32, column: u32, scope: *Metadata, inlinedAt: *Metadata) *Metadata;
  fn DIBuilderCreateSubroutineType(
    builder: *DIBuilder, file: *Metadata, parameterTypes: **Metadata, numParameterTypes: u32, flags: u32) *Metadata;
  fn GetSubprogram(func: *Value) *Metadata;
  fn SetSubprogram(func: *Value, sp: *Metadata);
  fn InstructionGetDebugLoc(inst: *Value) *Metadata;
}
