// llvm-c/DebugInfo.h: the part of the debug-information builder the compiler uses: a compile unit, files,
// subprograms with a subroutine type, a debug location, and attaching a subprogram to a function.

// LLVMDWARFSourceLanguage: llvm-c/DebugInfo.h lines 79-148
