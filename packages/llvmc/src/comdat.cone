// llvm-c/Comdat.h: COMDAT groups of a module's globals.

// LLVMComdatSelectionKind: llvm-c/Comdat.h lines 30-39
pub enum ComdatSelectionKind: u32 {
  AnyComdatSelectionKind = 0, ExactMatchComdatSelectionKind = 1, LargestComdatSelectionKind = 2,
  NoDeduplicateComdatSelectionKind = 3, SameSizeComdatSelectionKind = 4
}

pub extern {

  // Comdats
  fn GetOrInsertComdat(m: *Module, name: cstr) *Comdat;
  fn GetComdat(v: *Value) *Comdat;
  fn SetComdat(v: *Value, c: *Comdat);
  fn SetComdatSelectionKind(c: *Comdat, kind: ComdatSelectionKind);
}
