// llvm-c/Error.h: LLVMErrorRef, what the new pass manager's RunPasses answers. An error must be consumed:
// GetErrorMessage (then DisposeErrorMessage on its text) or ConsumeError, or LLVM aborts.
// (Named ErrorRef, LLVM's own name, so that a bare 'Error' in Cone code is always collections' trait.)

pub struct @opaque ErrorRef {}              // LLVMErrorRef

pub extern {

  // Error Handling
  fn ConsumeError(err: *ErrorRef);
  fn GetErrorMessage(err: *ErrorRef) *u8;
  fn DisposeErrorMessage(errMsg: *u8);
}
