// llvm-c/TargetMachine.h: a target, a machine for one triple, and its code generation to an object file,
// an assembly file or a memory buffer.

pub struct @opaque Target {}                // LLVMTargetRef
pub struct @opaque TargetMachine {}         // LLVMTargetMachineRef

// LLVMCodeGenOptLevel: llvm-c/TargetMachine.h lines 39-44
pub enum CodeGenOptLevel: u32 {
  CodeGenLevelNone = 0, CodeGenLevelLess = 1, CodeGenLevelDefault = 2, CodeGenLevelAggressive = 3;
}

// LLVMRelocMode: llvm-c/TargetMachine.h lines 46-54
pub enum RelocMode: u32 {
  RelocDefault = 0, RelocStatic = 1, RelocPIC = 2, RelocDynamicNoPic = 3, RelocROPI = 4, RelocRWPI = 5,
  RelocROPI_RWPI = 6;
}

// LLVMCodeModel: llvm-c/TargetMachine.h lines 56-64
pub enum CodeModel: u32 {
  CodeModelDefault = 0, CodeModelJITDefault = 1, CodeModelTiny = 2, CodeModelSmall = 3,
  CodeModelKernel = 4, CodeModelMedium = 5, CodeModelLarge = 6;
}

// LLVMCodeGenFileType: llvm-c/TargetMachine.h lines 66-69
pub enum CodeGenFileType: u32 {
  AssemblyFile = 0, ObjectFile = 1;
}

pub extern {

  // TargetMachine.h
  fn GetTargetFromTriple(triple: cstr, t: **Target, errorMessage: **u8) i32;
  fn CreateTargetMachine(
    t: *Target, triple: cstr, cpu: cstr, features: cstr, level: CodeGenOptLevel, reloc: RelocMode,
    codeModel: CodeModel) *TargetMachine;
  fn DisposeTargetMachine(t: *TargetMachine);
  fn CreateTargetDataLayout(t: *TargetMachine) *TargetData;
  fn TargetMachineEmitToFile(
    t: *TargetMachine, m: *Module, filename: cstr, codegen: CodeGenFileType, errorMessage: **u8) i32;
  fn TargetMachineEmitToMemoryBuffer(
    t: *TargetMachine, m: *Module, codegen: CodeGenFileType, errorMessage: **u8, outMemBuf: **MemoryBuffer) i32;
  fn GetDefaultTargetTriple() *u8;
  fn GetHostCPUName() *u8;
  fn GetHostCPUFeatures() *u8;
}
