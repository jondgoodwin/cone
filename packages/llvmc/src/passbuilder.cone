// llvm-c/Transforms/PassBuilder.h: the new pass manager: RunPasses runs a pass pipeline written as text
// ('default<O2>', 'instcombine,simplifycfg') over a module.

pub struct @opaque PassBuilderOptions {}    // LLVMPassBuilderOptionsRef

pub extern {

  // New Pass Manager
  fn RunPasses(m *Module, passes cstr, tm *TargetMachine, options *PassBuilderOptions) *Error;
  fn CreatePassBuilderOptions() *PassBuilderOptions;
  fn DisposePassBuilderOptions(options *PassBuilderOptions);
}
