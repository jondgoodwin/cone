// sculptbrush's strokes in a shape's own coordinates, on a skinmesh bar (two
// edges, 2 long, square section) subdivided twice, checked with the testing
// package; only a failure prints, so anatomy.out holds the summary alone.
//
// A bar along y from 0 to 2 with a half-extent r: the surface point at "along"
// a, "around" b lies at height about 2a and at distance about r (a little
// more at a corner) from the axis. The same coordinates on a bar twice as
// thick give the same height and twice the distance: a recipe lands on the
// same anatomy when proportions change.

mod anatomy;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;
import skinmesh use *;
import sculptbrush use *;

fn bar(r: f32) PolyMesh {
  var g = SkinGraph.empty();
  let a = g.addNode(new Vec3(0., 0., 0.), r, r);
  g.setRoot(a);
  let b = g.grow(a, new Vec3(0., 1., 0.), r, r);
  g.grow(b, new Vec3(0., 2., 0.), r, r);
  let s = skinStandard(&g);
  let f = subdivideSkin(&s, 2u32);
  smooth(&f.mesh, 0., 0u32)
}

fn lateral(p: Vec3) f32 { (p.x * p.x + p.z * p.z).sqrt() }

fn main() i32 {
  let thin = bar(0.1);
  let thick = bar(0.2);
  let h1 = anatomyHit(&thin, 0., 0.5, 0.3);
  expect(h1.exact, "anatomy: a place on the limb is found on a face");
  expectFloat(f64.from(h1.point.y), 1., 0.08, "anatomy: along 0.5 of a bar 2 long is at about y = 1");
  expect(lateral(h1.point) > 0.07 && lateral(h1.point) < 0.14, "anatomy: on the surface, about the radius from the axis");
  let h2 = anatomyHit(&thick, 0., 0.5, 0.3);
  expectFloat(f64.from(h2.point.y), f64.from(h1.point.y), 0.001, "anatomy: the same height on a thicker bar");
  expectFloat(f64.from(lateral(h2.point) / lateral(h1.point)), 2., 0.05, "anatomy: twice the distance from the axis on a bar twice as thick");
  // Moving along moves along
  let hA = anatomyPoint(&thin, 0., 0.25, 0.3);
  let hB = anatomyPoint(&thin, 0., 0.75, 0.3);
  expect(hB.y - hA.y > 0.8 && hB.y - hA.y < 1.2, "anatomy: along 0.25 to 0.75 is half the bar's length");
  // A different side
  let hC = anatomyPoint(&thin, 0., 0.5, 0.45);
  expect((hC - h1.point).length() > 0.03, "anatomy: another 'around' is another place");
  // A place no face encloses still gets a point on the limb
  let hZ = anatomyHit(&thin, 0., 0.5, 5.0);
  expect(lateral(hZ.point) > 0.05 && lateral(hZ.point) < 0.15, "anatomy: a place off the numbers' range gives the nearest vertex, on the surface");
  // A limb that is not there: the origin
  let none = anatomyHit(&thin, 7., 0.5, 0.3);
  expect(!none.exact && none.face == NoIndex, "anatomy: no such limb is not exact");
  // A stroke in anatomy coordinates: a run along the side lands on the surface and a stroke made from it works
  let places = alongPlaces(0., 0.2, 0.8, 0.3, 6u32);
  let path = anatomyPath(&thin, &places);
  expectInt(i64.from(path.len()), 7i64, "anatomy: n + 1 points along a run");
  var onSurface = true;
  var i = 0usize;
  while i < path.len() {
    let l = lateral(*path[i]);
    if l < 0.07 || l > 0.14 { onSurface = false; }
    i = i + 1usize;
  }
  expect(onSurface, "anatomy: every point of the run is on the surface");
  let st = Stroke.make(Brush.of(BrushInflate), anatomyPath(&thin, &places), 0.1, 1.);
  let q = sculptStroke(&thin, &st);
  var moved = 0;
  var v = 0usize;
  while v < thin.positions.len() {
    if (*q.positions[v] - *thin.positions[v]).lengthSquared() > 0. { moved = moved + 1; }
    v = v + 1usize;
  }
  expect(moved > 10, "anatomy: the stroke from the run changes the mesh");
  // The same recipe on the thick bar acts at the same relative place
  let path2 = anatomyPath(&thick, &places);
  expectFloat(f64.from((*path2[3usize]).y), f64.from((*path[3usize]).y), 0.001, "anatomy: the run is at the same heights on the thicker bar");
  // aroundPlaces
  let ring = aroundPlaces(0., 0.5, 0.1, 0.4, 3u32);
  expectInt(i64.from(ring.len()), 4i64, "anatomy: a run round is n + 1 places");
  expectFloat(f64.from((*ring[3usize]).z), 0.4, 0.00001, "anatomy: ending at the last 'around'");
  done()
}
