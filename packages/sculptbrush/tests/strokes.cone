// sculptbrush's stroke engine: the paths and their methods, the curves along a
// stroke, symmetry, the gates (mask, face set, front faces), alphas, the
// report, and that a recipe gives the same bits twice; checked with the
// testing package, only a failure printing, so strokes.out holds the summary.
//
// The plate is a square grid facing +y; a stroke along x at spacing 0.1 of a
// radius 0.3 is a dab every 0.03: a stroke of length 1.2 has 1.2 / 0.03 + 1 = 41
// dabs (the sum may lose or gain the last by rounding, so the check allows one).

mod strokes;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import sculpt use *;
import sculptbrush use *;

imm near = 0.00001d;

fn absf(a f32) f32 {if a < 0. {-a;} else {a;};}

fn cp(src &List[Vec3]) List[Vec3] {
  mut out = List[Vec3].empty();
  mut i = 0usize;
  while i < src.len() { out.push(*src[i]); i = i + 1usize; }
  out;
}

fn plate(n u32, size f32) PolyMesh {
  mut pos = List[Vec3].empty();
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut j = 0u32;
  while j <= n {
    mut i = 0u32;
    while i <= n {
      pos.push(new Vec3((f32.from(i) / f32.from(n) - 0.5) * size, 0., (f32.from(j) / f32.from(n) - 0.5) * size));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  j = 0u32;
  while j < n {
    mut i = 0u32;
    while i < n {
      imm a = j * (n + 1u32) + i;
      counts.push(4u32);
      idx.push(a);
      idx.push(a + n + 1u32);
      idx.push(a + n + 2u32);
      idx.push(a + 1u32);
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  mut problems = List[String].empty();
  PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems);
}

fn line(x0 f32, x1 f32, z f32) List[Vec3] {
  mut pts = List[Vec3].empty();
  pts.push(new Vec3(x0, 0., z));
  pts.push(new Vec3(x1, 0., z));
  pts;
}

fn dabsOf(p &PolyMesh, st &Stroke) u32 {
  mut s = Sculptor.of(p);
  s.stroke(st).dabs;
}

fn sameBits(a &PolyMesh, b &PolyMesh) bool {
  if a.positions.len() != b.positions.len() { return false; }
  mut v = 0usize;
  while v < a.positions.len() {
    imm p = *a.positions[v];
    imm q = *b.positions[v];
    if p.x != q.x or p.y != q.y or p.z != q.z { return false; }
    v = v + 1usize;
  }
  true;
}

fn methods() {
  imm p = plate(40u32, 2.);
  // Space: a dab every 0.03 along 1.2
  mut st = Stroke.make(Brush.of(BrushDraw), line(-0.6, 0.6, 0.), 0.3, 1.);
  st.project = false;
  imm n = dabsOf(&p, &st);
  expect(n >= 40u32 and n <= 42u32, "space: a dab every spacing x radius along the path");
  // A wider spacing, fewer dabs
  mut wide = Stroke.make(Brush.of(BrushDraw), line(-0.6, 0.6, 0.), 0.3, 1.);
  wide.project = false;
  wide.spacing = 0.5;
  imm nw = dabsOf(&p, &wide);
  expect(nw >= 8u32 and nw <= 10u32, "space: at spacing 0.5, one dab every 0.15");
  // Dots: one at each point
  mut pts = line(-0.6, 0.6, 0.);
  pts.push(new Vec3(0., 0., 0.4));
  mut dots = Stroke.make(Brush.of(BrushDraw), cp(&pts), 0.3, 1.);
  dots.project = false;
  dots.method = StrokeDots;
  expectInt(i64.from(dabsOf(&p, &dots)), 3i64, "dots: one dab at each point");
  // Anchored: one dab, radius the drag
  mut anch = Stroke.make(Brush.of(BrushDraw), line(0., 0.4, 0.), 0.1, 1.);
  anch.project = false;
  anch.method = StrokeAnchored;
  imm qa = sculptStroke(&p, &anch);
  mut far = 0.;
  mut v = 0usize;
  while v < p.positions.len() {
    if (*qa.positions[v] - *p.positions[v]).lengthSquared() > 0. {
      imm d = (*p.positions[v] - new Vec3(0., 0., 0.)).length();
      if d > far { far = d; }
    }
    v = v + 1usize;
  }
  expect(far > 0.3 and far < 0.4, "anchored: the radius is the length of the drag (0.4), not the stroke's 0.1");
  expectInt(i64.from(dabsOf(&p, &anch)), 1i64, "anchored: one dab");
  // Line: the straight run from the first to the last point, ignoring the points between
  mut mid = line(-0.6, 0.6, 0.);
  mid.push(new Vec3(0.6, 0., 0.6));
  mut ln = Stroke.make(Brush.of(BrushDraw), cp(&mid), 0.3, 1.);
  ln.project = false;
  ln.method = StrokeLine;
  imm qln = sculptStroke(&p, &ln);
  mut anyZ = false;
  v = 0usize;
  while v < p.positions.len() {
    if (*qln.positions[v] - *p.positions[v]).lengthSquared() > 0. and (*p.positions[v]).z < -0.31 { anyZ = true; }
    v = v + 1usize;
  }
  expect(!anyZ, "line: the straight run from the first point to the last");
  // Curve: a spline through three points bows towards the middle one
  mut cpts = List[Vec3].empty();
  cpts.push(new Vec3(-0.6, 0., 0.));
  cpts.push(new Vec3(0., 0., 0.4));
  cpts.push(new Vec3(0.6, 0., 0.));
  mut cv = Stroke.make(Brush.of(BrushDraw), cp(&cpts), 0.15, 1.);
  cv.project = false;
  cv.method = StrokeCurve;
  imm qc = sculptStroke(&p, &cv);
  imm top = nearestY(&p, &qc, new Vec3(0., 0., 0.4));
  expect(top > 0.0001, "curve: the path passes through the middle point");
  // Space with the same three points is a polyline: the vertex half way between the first and middle points
  mut sp = Stroke.make(Brush.of(BrushDraw), cp(&cpts), 0.15, 1.);
  sp.project = false;
  imm qs = sculptStroke(&p, &sp);
  imm midV = nearestY(&p, &qs, new Vec3(-0.3, 0., 0.2));
  imm midC = nearestY(&p, &qc, new Vec3(-0.3, 0., 0.2));
  expect(midV > 0.0001 and midC != midV, "curve: the spline's bend differs from the polyline's");
  // The bezier helper is cubic and passes through its ends
  imm bz = bezierPoints(new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), new Vec3(1., 1., 0.), new Vec3(0., 1., 0.), 8u32);
  expectInt(i64.from(bz.len()), 9i64, "bezier: n + 1 points");
  expectFloat(f64.from((*bz[8usize]).y), 1., near, "bezier: ends at the last control point");
  expectFloat(f64.from((*bz[4usize]).x), 0.75, near, "bezier: its midpoint (3/8 + 3/8 of the middle points' x)");
}

// The height of the nearest vertex's change
fn nearestY(a &PolyMesh, b &PolyMesh, at Vec3) f32 {
  mut best = 0usize;
  mut bd = 3.0e38;
  mut v = 0usize;
  while v < a.positions.len() {
    imm d = (*a.positions[v] - at).lengthSquared();
    if d < bd { bd = d; best = v; }
    v = v + 1usize;
  }
  (*b.positions[best]).y - (*a.positions[best]).y;
}

fn curves() {
  imm p = plate(60u32, 2.);
  // A radius ramp from 0.2 to 1 along the stroke: the start is narrow
  mut st = Stroke.make(Brush.of(BrushDraw), line(-0.6, 0.6, 0.), 0.3, 1.);
  st.project = false;
  st.radiusCurve = rampCurve(0.2, 1.);
  imm q = sculptStroke(&p, &st);
  mut widthStart = 0.;
  mut widthEnd = 0.;
  mut v = 0usize;
  while v < p.positions.len() {
    if (*q.positions[v] - *p.positions[v]).lengthSquared() > 0. {
      imm x = (*p.positions[v]).x;
      imm z = absf((*p.positions[v]).z);
      if x < -0.5 and z > widthStart { widthStart = z; }
      if x > 0.5 and z > widthEnd { widthEnd = z; }
    }
    v = v + 1usize;
  }
  expect(widthStart < 0.3 * 0.4 and widthEnd > 0.3 * 0.7, "radius curve: narrow where the stroke starts, wide where it ends");
  // A strength ramp: the start is lighter
  mut st2 = Stroke.make(Brush.of(BrushDraw), line(-0.6, 0.6, 0.), 0.3, 1.);
  st2.project = false;
  st2.strengthCurve = rampCurve(0.1, 1.);
  imm q2 = sculptStroke(&p, &st2);
  imm h0 = nearestY(&p, &q2, new Vec3(-0.5, 0., 0.));
  imm h1 = nearestY(&p, &q2, new Vec3(0.5, 0., 0.));
  expect(h0 < h1 * 0.7, "strength curve: lighter where the stroke starts");
  // A pressure curve: lighter at both ends than in the middle
  mut st3 = Stroke.make(Brush.of(BrushDraw), line(-0.6, 0.6, 0.), 0.3, 1.);
  st3.project = false;
  st3.strengthCurve = pressureCurve(0.2);
  imm q3 = sculptStroke(&p, &st3);
  imm e0 = nearestY(&p, &q3, new Vec3(-0.5, 0., 0.));
  imm m0 = nearestY(&p, &q3, new Vec3(0., 0., 0.));
  expect(e0 < m0 * 0.7, "pressure curve: lighter at the ends");
}

fn symmetry() {
  imm p = plate(40u32, 2.);
  mut st = Stroke.dab(Brush.of(BrushDraw), new Vec3(0.4, 0., 0.2), 0.3, 1.);
  st.mirrorAcross(new Vec3(0., 0., 0.), new Vec3(1., 0., 0.));
  imm q = sculptStroke(&p, &st);
  imm map = mirrorMap(&p, new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), 0.0001);
  mut ok = true;
  mut any = 0;
  mut v = 0usize;
  while v < p.positions.len() {
    imm m = *map[v];
    if m != NoIndex {
      imm a = *q.positions[v];
      imm b = *q.positions[usize.from(m)];
      if absf(a.y - b.y) > 0.00001 or absf(a.z - b.z) > 0.00001 or absf(a.x + b.x) > 0.00001 { ok = false; }
      if a.y > 0.0001 { any = any + 1; }
    }
    v = v + 1usize;
  }
  expect(ok and any > 10, "symmetry: a dab and its mirror image: the result is its own reflection");
  expectInt(i64.from(dabsOf(&p, &st)), 2i64, "symmetry: one plane makes two dabs");
  // Two planes make four
  mut st2 = Stroke.dab(Brush.of(BrushDraw), new Vec3(0.4, 0., 0.2), 0.3, 1.);
  st2.mirrorAcross(new Vec3(0., 0., 0.), new Vec3(1., 0., 0.));
  st2.mirrorAcross(new Vec3(0., 0., 0.), new Vec3(0., 0., 1.));
  expectInt(i64.from(dabsOf(&p, &st2)), 4i64, "symmetry: two planes make four dabs");
  // A grab is mirrored too, its move reflected
  mut pts = List[Vec3].empty();
  pts.push(new Vec3(0.5, 0., 0.));
  pts.push(new Vec3(0.6, 0.2, 0.));
  mut g = Stroke.make(Brush.of(BrushGrab), pts, 0.3, 1.);
  g.mirrorAcross(new Vec3(0., 0., 0.), new Vec3(1., 0., 0.));
  imm qg = sculptStroke(&p, &g);
  imm right = nearestY(&p, &qg, new Vec3(0.5, 0., 0.));
  imm left = nearestY(&p, &qg, new Vec3(-0.5, 0., 0.));
  expectFloat(f64.from(right), f64.from(left), near, "symmetry: a grab's mirror lifts the other side the same");
  imm dxr = (*qg.positions[nearestVertexIndex(&p, new Vec3(0.5, 0., 0.))] - *p.positions[nearestVertexIndex(&p, new Vec3(0.5, 0., 0.))]).x;
  imm dxl = (*qg.positions[nearestVertexIndex(&p, new Vec3(-0.5, 0., 0.))] - *p.positions[nearestVertexIndex(&p, new Vec3(-0.5, 0., 0.))]).x;
  expectFloat(f64.from(dxr), -f64.from(dxl), near, "symmetry: and the sideways move is reflected");
}

fn nearestVertexIndex(m &PolyMesh, p Vec3) usize {
  mut best = 0usize;
  mut bd = 3.0e38;
  mut v = 0usize;
  while v < m.positions.len() {
    imm d = (*m.positions[v] - p).lengthSquared();
    if d < bd { bd = d; best = v; }
    v = v + 1usize;
  }
  best;
}

fn gates() {
  imm p = plate(40u32, 2.);
  // A mask of 1 on half the plate: x > 0 does not move
  mut half = List[f32].empty();
  mut v = 0usize;
  while v < p.positions.len() {
    half.push(if (*p.positions[v]).x > 0. {1.;} else {0.;});
    v = v + 1usize;
  }
  imm masked = withMaskValues(&p, &half);
  mut st = Stroke.make(Brush.of(BrushDraw), line(-0.5, 0.5, 0.), 0.3, 1.);
  st.project = false;
  imm q = sculptStroke(&masked, &st);
  mut leaked = 0;
  mut moved = 0;
  v = 0usize;
  while v < p.positions.len() {
    if (*q.positions[v] - *p.positions[v]).lengthSquared() > 0. {
      if (*p.positions[v]).x > 0. { leaked = leaked + 1; } else { moved = moved + 1; }
    }
    v = v + 1usize;
  }
  expect(leaked == 0 and moved > 10, "mask: masked vertices stay, the rest move");
  // A face set limit: assign set 1 to the faces with x < 0, stroke limited to set 1
  mut faces = List[u32].empty();
  mut f = 0usize;
  while f < p.faceCount() {
    if p.faceCentroid(u32.from(f)).x < 0. { faces.push(u32.from(f)); }
    f = f + 1usize;
  }
  imm withSets = faceSetAssign(&p, &faces, 2u32);
  mut lim = Stroke.make(Brush.of(BrushDraw), line(-0.5, 0.5, 0.), 0.3, 1.);
  lim.project = false;
  lim.faceSet = 2u32;
  imm ql = sculptStroke(&withSets, &lim);
  mut outside = 0;
  mut inside = 0;
  v = 0usize;
  while v < p.positions.len() {
    if (*ql.positions[v] - *p.positions[v]).lengthSquared() > 0. {
      if (*p.positions[v]).x > 0.001 { outside = outside + 1; } else { inside = inside + 1; }
    }
    v = v + 1usize;
  }
  expect(outside == 0 and inside > 10, "face set: a stroke limited to a face set leaves the rest");
  // Front faces only: a thin flattened sphere, a dab on top does not reach the underside
  imm s0 = subdivide(&PolyMesh.cube(1.), 3u32);
  imm thin = deform(&s0, q2 => new Vec3(q2.x, q2.y * 0.1, q2.z));
  imm topV = nearestVertexIndex(&thin, new Vec3(0., 0.1, 0.));
  imm topP = *thin.positions[topV];
  mut both = Stroke.dab(Brush.of(BrushInflate), topP, 0.5, 1.);
  both.project = false;
  imm qb = sculptStroke(&thin, &both);
  mut front = Stroke.dab(Brush.of(BrushInflate), topP, 0.5, 1.);
  front.project = false;
  front.frontOnly = true;
  imm qf = sculptStroke(&thin, &front);
  mut underBoth = 0;
  mut underFront = 0;
  v = 0usize;
  while v < thin.positions.len() {
    if (*thin.positions[v]).y < 0. {
      if (*qb.positions[v] - *thin.positions[v]).lengthSquared() > 0. { underBoth = underBoth + 1; }
      if (*qf.positions[v] - *thin.positions[v]).lengthSquared() > 0. { underFront = underFront + 1; }
    }
    v = v + 1usize;
  }
  expect(underBoth > 0 and underFront == 0, "front faces only: the underside of a thin shape is not reached");
}

fn halfAlpha() Alpha {
  mut half = Alpha.empty();
  half.w = 2u32;
  half.h = 2u32;
  half.values.push(1.);
  half.values.push(0.);
  half.values.push(1.);
  half.values.push(0.);
  half.followStroke = false;
  half;
}

fn alphas() {
  imm p = plate(60u32, 2.);
  // An alpha of 1 in its left half and 0 in its right: stamps only half a dab (not following the stroke)
  imm a = alphaFrom(8u32, (u, v) => u * v);
  expect(a.w == 8u32 and a.h == 8u32, "alpha: size x size samples");
  imm half = halfAlpha();
  mut st = Stroke.dab(Brush.of(BrushDraw), new Vec3(0., 0., 0.), 0.4, 1.);
  st.project = false;
  st.setAlpha(half);
  imm q = sculptStroke(&p, &st);
  // The fixed frame on a plate facing +y has its first axis along x: the alpha runs from 1 at
  // x = -radius to 0 at x = +radius, so the dab is taller on the left than the right
  mut left = 0.;
  mut right = 0.;
  mut v = 0usize;
  while v < p.positions.len() {
    imm x = (*p.positions[v]).x;
    imm z = (*p.positions[v]).z;
    imm dy = (*q.positions[v]).y - (*p.positions[v]).y;
    if absf(z) < 0.02 and x < -0.12 and x > -0.2 { left = left + dy; }
    if absf(z) < 0.02 and x > 0.12 and x < 0.2 { right = right + dy; }
    v = v + 1usize;
  }
  expect(left > 0. and right > 0. and left > right * 2., "alpha: the stamp's texture shapes the dab: heavy on its 1 side, light on its 0 side");
  imm probe = halfAlpha();
  expectFloat(f64.from(probe.sample(0., 0.)), 1., near, "alpha sample: at a 1 texel");
  expectFloat(f64.from(probe.sample(1., 0.)), 0., near, "alpha sample: at a 0 texel");
  expectFloat(f64.from(probe.sample(0.5, 0.)), 0.5, near, "alpha sample: bilinear between");
  expectFloat(f64.from(probe.sample(1.2, 0.)), 0., near, "alpha sample: nothing outside");
}

fn reports() {
  imm p = plate(40u32, 2.);
  mut s = Sculptor.of(&p);
  imm st = Stroke.dab(Brush.of(BrushDraw), new Vec3(0., 0., 0.), 0.5, 1.);
  imm r = s.stroke(&st);
  expectInt(i64.from(r.dabs), 1i64, "report: one dab");
  expect(r.touched > 10u32, "report: counts the vertices moved");
  expectFloat(f64.from(r.maxMove), 0.006, 0.0001d, "report: the farthest any vertex moved");
  expect(!r.needsDensity, "report: a gentle draw needs no density");
  // The report on an empty stroke
  mut none = Stroke.make(Brush.of(BrushDraw), List[Vec3].empty(), 0.5, 1.);
  none.project = false;
  imm r2 = s.stroke(&none);
  expectInt(i64.from(r2.dabs), 0i64, "report: a stroke with no points makes no dabs");
  // A zero radius does nothing
  imm z = Stroke.dab(Brush.of(BrushDraw), new Vec3(0., 0., 0.), 0., 1.);
  expectInt(i64.from(s.stroke(&z).dabs), 0i64, "report: a zero radius makes no dabs");
}

fn recipe() {
  imm s0 = subdivide(&PolyMesh.cube(1.), 3u32);
  mut strokes = List[Stroke].empty();
  mut k = 0;
  while k < 12 {
    imm ang = f32.from(k) * 0.5;
    mut b = Brush.of(if k % 3 == 0 {BrushDraw;} elif k % 3 == 1 {BrushCrease;} else {BrushSmooth;});
    mut pts = List[Vec3].empty();
    pts.push(new Vec3(ang * 0.1, 0.8, 0.));
    pts.push(new Vec3(ang * 0.1 + 0.3, 0.8, 0.2));
    strokes.push(Stroke.make(b, pts, 0.25, 0.8));
    k = k + 1;
  }
  imm a = sculptStrokes(&s0, &strokes);
  imm b = sculptStrokes(&s0, &strokes);
  expect(sameBits(&a, &b), "determinism: the same recipe twice gives the same bits");
  expect(!sameBits(&a, &s0), "determinism: and the recipe did something");
  // Splitting the recipe over two Sculptors changes nothing
  mut sc = Sculptor.of(&s0);
  k = 0;
  while k < 12 { sc.stroke(&*strokes[usize.from(u32.from(k))]); k = k + 1; }
  expect(sameBits(&a, &sc.finish()), "determinism: strokes one at a time are the recipe in one call");
}

fn main() i32 {
  methods();
  curves();
  symmetry();
  gates();
  alphas();
  reports();
  recipe();
  done();
}
