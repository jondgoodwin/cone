// ======== The stroke engine: a Sculptor applies strokes to a mesh ========
//
// A 'Sculptor' holds a working copy of a mesh and applies 'Stroke's to it, one
// after another, moving vertices and nothing else (topology and every channel
// are kept; Mask strokes write the "mask" channel). A recipe of 200 strokes is
// 200 calls to 'stroke' on one Sculptor; 'finish' gives the mesh back.
//
// One stroke
// - The path: the stroke's points, laid out by its method (space, dots,
//   anchored, line, curve), a dab every spacing x radius along it, the radius
//   and strength scaled by the stroke's curves at that place along it, each dab
//   centre snapped onto the surface (nearest point on the mesh as the stroke
//   began) when 'project' is on.
// - A dab: the vertices within the radius of its centre, each with a weight
//   falloff(distance / radius) times 1 minus its mask, times an alpha sample,
//   cut by the gates (front faces only, a face set, the mask). The dab's normal
//   is the weight-averaged vertex normal, as Blender's area normal; vertex
//   normals are recomputed from the vertices as they are at each dab. The brush's
//   kernel turns those weights into a displacement per vertex (kernels.cone).
// - Symmetry: after each dab, the same dab in the mirror of each subset of the
//   stroke's planes (centre, direction and movement reflected), so three
//   planes make eight dabs. Radial symmetry is not built.
// - Dabs find their vertices through a spatial hash built when the stroke
//   begins. Vertices move, so a query asks for the radius plus the farthest
//   anything has moved since the hash was built (the sum of the dabs' largest
//   moves), and the hash is rebuilt when that grows past half a radius; the
//   vertices it returns are then tested at their present places. The result
//   does not depend on when the hash was rebuilt.
// - Grab, Elastic Deform, Move Topological and Pose are one movement, not a
//   run of dabs: the first point is where the surface is taken hold of, the
//   last where it is dragged to; the weights are found once on the surface as
//   it was.
//
// Determinism. Everything a kernel does is +, -, *, / and sqrt on f32, in a
// fixed order (candidates ascending by vertex number, sums in that order), so
// the same recipe gives the same bits on every machine. The exception is a
// falloff that calls exp: FalloffGauss; avoid it in a recipe meant to be exact.

// What a stroke reported
pub struct StrokeReport {
  pub dabs u32;              // dabs made, mirrored ones counted
  pub touched u32;           // vertices moved at least once
  pub maxMove f32;           // the farthest any vertex moved (from where the stroke began)
  pub longestEdge f32;       // the longest edge at a vertex the stroke moved, at the end
  pub edgeToRadius f32;      // that over the stroke's radius
  pub needsDensity bool;     // the surface was stretched thin: subdivide or remesh before going on (edgeToRadius over 0.35)
}

// One dab's frame
pub struct DabCtx {
  pub c Vec3;         // centre
  pub n Vec3;         // the area normal (unit)
  pub dir Vec3;       // the stroke's direction in the tangent plane (unit), or zero
  pub hasDir bool;
  pub delta Vec3;     // how far the centre moved since the last dab
  pub r f32;          // radius
  pub s f32;          // strength at this place on the stroke
  pub sign f32;       // +1, or -1 for the inverted action
}

// The vertices a dab touches
pub struct DabData {
  pub vs List[u32];      // ascending
  pub w List[f32];       // each above 0
  pub nrm List[Vec3];    // the vertex normals at the dab
}

// How a dab weighs its vertices
const ModeRadial = 0u32;     // falloff(distance / radius)
const ModeStrips = 1u32;     // falloff of a rectangle: half-length radius along the stroke, aspect x radius across
const ModeDam = 2u32;        // falloff of a narrow ellipse
const ModeUnit = 3u32;       // 1 for everything within reach (the kernel weighs)

pub struct Sculptor {
  pub mesh PolyMesh;
  pub base List[Vec3];       // the persistent base ('captureBase'), for Layer
  pub hasBase bool;
  pub start List[Vec3];      // positions as the current stroke began
  pub grid PointGrid;
  pub gridBound f32;
  pub cell f32;
  pub touchedFlag List[bool];
  pub touchedList List[u32];
  pub allowed List[bool];    // per vertex: inside the stroke's face set
  pub allowedOn bool;
  pub maskCh u32;
  pub dabCount u32;
  pub maxMove f32;
  pub bigStretch f32;

  // A sculptor over a copy of the mesh
  pub fn of(m &PolyMesh) Sculptor {
    mut work = smooth(m, 0., 0u32);
    imm nv = work.positions.len();
    mut flags = List[bool].withCapacity(nv);
    mut i = 0usize;
    while i < nv { flags.push(false); i = i + 1usize; }
    imm g = PointGrid.build(&work.positions, 1.);
    new Sculptor(work, List[Vec3].empty(), false, List[Vec3].empty(), g, 0., 1., flags, List[u32].empty(),
      List[bool].empty(), false, NoIndex, 0u32, 0., 0.);
  }

  // Remember the positions now as the base that Layer raises from, across strokes
  // (Blender's persistent base); until then Layer raises from where the stroke began
  pub fn captureBase(self &mut) {
    base = copyVec3s(&mesh.positions);
    hasBase = true;
  }

  pub fn clearBase(self &mut) {
    hasBase = false;
  }

  // The sculpted mesh (a copy; the sculptor goes on)
  pub fn finish(self &) PolyMesh {
    smooth(&mesh, 0., 0u32);
  }

  // The positions the current surface has, a copy
  pub fn positionsNow(self &) List[Vec3] { copyVec3s(&mesh.positions); }

  // -------- one stroke --------

  // A point put on the surface as the stroke began: onto the tangent plane at the nearest
  // vertex (found through the stroke's hash, at the stroke's start positions), looking
  // out to a quarter radius, then two, then four. The error is the surface's departure from
  // its tangent plane over an edge, far under a radius. A point with no vertex that near stays.
  fn snap(self &, p Vec3, rad f32) Vec3 {
    mut near = grid.nearestWithin(p, 0.25 * rad);
    if near == NoIndex { near = grid.nearestWithin(p, 2. * rad); }
    if near == NoIndex { near = grid.nearestWithin(p, 4. * rad); }
    if near == NoIndex { return p; }
    imm n = vertexNormalOf(&mesh, &start, near);
    imm x = *start[usize.from(near)];
    p - n * (p - x).dot(n);
  }

  pub fn stroke(self &mut, st &Stroke) StrokeReport {
    imm nv = mesh.positions.len();
    // Clear the last stroke's marks
    mut k = 0usize;
    while k < touchedList.len() {
      touchedFlag.set(usize.from(*touchedList[k]), false);
      k = k + 1usize;
    }
    touchedList = List[u32].empty();
    maxMove = 0.;
    dabCount = 0u32;
    start = copyVec3s(&mesh.positions);
    cell = if st.radius > 0. {st.radius;} else {1.;};
    grid = PointGrid.build(&mesh.positions, cell);
    gridBound = 0.;
    maskCh = mesh.findFloatChannel(VertexDomain, "mask");
    if st.brush.kind == BrushMask and maskCh == NoIndex {
      maskCh = mesh.addFloatChannel(VertexDomain, "mask", 0.);
    }
    // The face set limit, as vertices
    allowedOn = st.faceSet != NoIndex;
    if allowedOn {
      allowed = List[bool].withCapacity(nv);
      mut v = 0usize;
      while v < nv { allowed.push(false); v = v + 1usize; }
      imm ids = faceSetIds(&mesh);
      mut f = 0usize;
      while f < mesh.faceCount() {
        if *ids[f] == st.faceSet {
          imm vs = mesh.faceVertices(u32.from(f));
          mut j = 0usize;
          while j < vs.len() { allowed.set(usize.from(*vs[j]), true); j = j + 1usize; }
        }
        f = f + 1usize;
      }
    }
    if st.points.len() > 0usize and st.radius > 0. {
      imm kind = st.brush.kind;
      if kind == BrushGrab or kind == BrushElastic or kind == BrushMoveTopological or kind == BrushPose {
        self.moveOnce(st);
      } else {
        self.runDabs(st);
      }
    }
    self.report(st);
  }

  // The stroke's summary
  fn report(self &, st &Stroke) StrokeReport {
    mut longest = 0.;
    mut k = 0usize;
    while k < touchedList.len() {
      imm v = *touchedList[k];
      imm hs = mesh.vertexOutgoing(v);
      imm p = *mesh.positions[usize.from(v)];
      mut j = 0usize;
      while j < hs.len() {
        imm len = (*mesh.positions[usize.from(mesh.toVertex(*hs[j]))] - p).length();
        if len > longest { longest = len; }
        j = j + 1usize;
      }
      k = k + 1usize;
    }
    imm ratio = if st.radius > 0. {longest / st.radius;} else {0.;};
    new StrokeReport(dabCount, u32.from(touchedList.len()), maxMove, longest, ratio, ratio > 0.35);
  }

  // -------- dabs along a path --------

  fn runDabs(self &mut, st &Stroke) {
    // The raw path, then the dab places along it
    mut line = List[Vec3].empty();
    imm np = st.points.len();
    if st.method == StrokeLine and np >= 2usize {
      line.push(*st.points[0usize]);
      line.push(*st.points[np - 1usize]);
    } elif st.method == StrokeCurve {
      line = splinePoints(&st.points, 8u32);
    } else {
      line = copyVec3s(&st.points);
    }
    mut path = new DabPath(List[Vec3].empty(), List[f32].empty());
    mut rads = List[f32].empty();
    if st.method == StrokeDots {
      mut i = 0usize;
      while i < line.len() {
        path.at.push(*line[i]);
        imm t = if line.len() > 1usize {f32.from(i) / f32.from(line.len() - 1usize);} else {0.;};
        path.t.push(t);
        i = i + 1usize;
      }
    } elif st.method == StrokeAnchored {
      path.at.push(*line[0usize]);
      path.t.push(0.);
    } else {
      path = spaceDabs(st, &line);
    }
    // The radius along the stroke (the anchored one's is its drag)
    mut i = 0usize;
    while i < path.at.len() {
      imm base = st.radius * st.radiusCurve.weight(*path.t[i]);
      rads.push(if base > 0. {base;} else {0.;});
      i = i + 1usize;
    }
    mut anchorDir = new Vec3(0., 0., 0.);
    if st.method == StrokeAnchored and np >= 2usize {
      imm drag = *st.points[np - 1usize] - *st.points[0usize];
      if drag.length() > 0. {
        rads.set(0usize, drag.length());
        anchorDir = drag.normalize();
      }
    }
    // The dabs, each snapped to the surface
    mut prev = *path.at[0usize];
    i = 0usize;
    while i < path.at.len() {
      imm raw = *path.at[i];
      mut dir = new Vec3(0., 0., 0.);
      if st.method == StrokeAnchored {
        dir = anchorDir;
      } elif path.at.len() > 1usize {
        imm a = if i > 0usize {*path.at[i - 1usize];} else {raw;};
        imm b = if i + 1usize < path.at.len() {*path.at[i + 1usize];} else {raw;};
        dir = b - a;
        if dir.lengthSquared() > 0. { dir = dir.normalize(); }
      }
      imm delta = raw - prev;
      prev = raw;
      imm c = if st.project {self.snap(raw, st.radius);} else {raw;};
      self.dabSymmetric(st, c, dir, delta, *path.t[i], *rads[i]);
      i = i + 1usize;
    }
  }

  // The dab, then its mirrors
  fn dabSymmetric(self &mut, st &Stroke, c Vec3, dir Vec3, delta Vec3, t f32, rad f32) {
    self.dab(st, c, dir, delta, t, rad);
    imm np = st.symmetry.len();
    if np == 0usize { return; }
    imm combos = 1u32 << u32.from(np);
    mut mask = 1u32;
    while mask < combos {
      mut mc = c;
      mut md = dir;
      mut mdel = delta;
      mut j = 0usize;
      while j < np {
        if (mask & (1u32 << u32.from(j))) != 0u32 {
          imm pl = &*st.symmetry[j];
          mc = reflectPoint(mc, pl.origin, pl.normal);
          md = md - pl.normal * (2. * md.dot(pl.normal));
          mdel = mdel - pl.normal * (2. * mdel.dot(pl.normal));
        }
        j = j + 1usize;
      }
      self.dab(st, mc, md, mdel, t, rad);
      mask = mask + 1u32;
    }
  }

  // One dab
  fn dab(self &mut, st &Stroke, c Vec3, dir Vec3, delta Vec3, t f32, rad f32) {
    if rad <= 0. { return; }
    imm kind = st.brush.kind;
    imm s = st.strength * st.strengthCurve.weight(t);
    imm sign = if st.subtract {-1.;} else {1.;};
    mut mode = ModeRadial;
    mut reach = rad;
    if kind == BrushClayStrips {
      mode = ModeStrips;
      if st.brush.aspect > 1. { reach = rad * st.brush.aspect; }
    }
    if kind == BrushDam { mode = ModeDam; }
    mut got = self.gather(st, c, dir, rad, reach, mode, kind != BrushMask);
    if got.data.vs.len() == 0usize { return; }
    // The centre was snapped to the surface as the stroke began; earlier dabs of the stroke
    // have moved it since. Lift the centre along the normal by how far the vertex nearest
    // it (across the surface) has moved from where it started, so a stroke goes on working
    // on the surface it is making (as Blender's does, finding its hit each dab).
    mut centre = c;
    if st.project and kind != BrushSnakeHook {
      mut near = NoIndex;
      mut nearD = 3.0e38;
      mut j = 0usize;
      while j < got.data.vs.len() {
        imm x = *mesh.positions[usize.from(*got.data.vs[j])] - c;
        imm tx = x - got.n * x.dot(got.n);
        imm dd = tx.lengthSquared();
        if dd < nearD {
          nearD = dd;
          near = *got.data.vs[j];
        }
        j = j + 1usize;
      }
      if near != NoIndex {
        imm lift = (*mesh.positions[usize.from(near)] - *start[usize.from(near)]).dot(got.n);
        if absf(lift) > 0.0001 * rad {
          centre = c + got.n * lift;
          got = self.gather(st, centre, dir, rad, reach, mode, kind != BrushMask);
          if got.data.vs.len() == 0usize { return; }
        }
      }
    }
    dabCount = dabCount + 1u32;
    // The stroke direction in the tangent plane
    mut dirT = dir - got.n * dir.dot(got.n);
    mut hasDir = false;
    if dirT.lengthSquared() > 0.0000000001 {
      dirT = dirT.normalize();
      hasDir = true;
    } else {
      dirT = new Vec3(0., 0., 0.);
    }
    imm cx = new DabCtx(centre, got.n, dirT, hasDir, delta, rad, s, sign);
    if kind == BrushMask {
      self.paintMask(&cx, &got.data);
    } elif kind == BrushSmooth or kind == BrushSlideRelax {
      mut pass = 0u32;
      while pass < st.brush.iterations {
        imm lam = if s < 1. {s * 0.5;} else {0.5;};
        imm f1 = cx.sign * lam;
        self.applyDisp(&got.data, &relaxDisp(self, st, &got.data, f1, kind == BrushSlideRelax));
        if st.brush.taubin and kind == BrushSmooth {
          imm mu = f1 / (0.1 * f1 - 1.);
          self.applyDisp(&got.data, &relaxDisp(self, st, &got.data, mu, false));
        }
        pass = pass + 1u32;
      }
    } else {
      imm disp = kernelDisp(self, st, &cx, &got.data);
      self.applyDisp(&got.data, &disp);
    }
    // The hash goes stale as things move
    if gridBound > 0.5 * cell {
      grid = PointGrid.build(&mesh.positions, cell);
      gridBound = 0.;
    }
  }

  // Write the displacements, mark the vertices moved
  fn applyDisp(self &mut, d &DabData, disp &List[Vec3]) {
    mut biggest = 0.;
    mut i = 0usize;
    while i < d.vs.len() {
      imm v = usize.from(*d.vs[i]);
      imm mv = *disp[i];
      imm len2 = mv.lengthSquared();
      if len2 > 0. {
        mesh.positions.set(v, *mesh.positions[v] + mv);
        if len2 > biggest { biggest = len2; }
        if !*touchedFlag[v] {
          touchedFlag.set(v, true);
          touchedList.push(*d.vs[i]);
        }
        imm total = (*mesh.positions[v] - *start[v]).length();
        if total > maxMove { maxMove = total; }
      }
      i = i + 1usize;
    }
    gridBound = gridBound + biggest.sqrt();
  }

  // The mask brush: paint towards 1 (or, inverted, towards 0)
  fn paintMask(self &mut, cx &DabCtx, d &DabData) {
    imm amount = 0.25 * cx.s;
    mut i = 0usize;
    while i < d.vs.len() {
      imm v = *d.vs[i];
      imm old = mesh.float(maskCh, v);
      imm moved = old + cx.sign * amount * *d.w[i];
      mesh.setFloat(maskCh, v, clampf(moved, 0., 1.));
      i = i + 1usize;
    }
  }

  // -------- gathering a dab's vertices --------

  // The vertices within 'reach' of c, with their weights by 'mode' and the
  // gates, and the area normal. 'masked' is false for the mask brush, which
  // paints where it likes.
  fn gather(self &, st &Stroke, c Vec3, dir Vec3, rad f32, reach f32, mode u32, masked bool) Gathered {
    imm cands = grid.within(c, reach + gridBound);
    mut vs = List[u32].empty();
    mut nrms = List[Vec3].empty();
    mut dists = List[f32].empty();
    mut sumN = new Vec3(0., 0., 0.);
    mut nearN = new Vec3(0., 1., 0.);
    mut nearD = 3.0e38;
    mut i = 0usize;
    while i < cands.len() {
      imm v = *cands[i];
      imm p = *mesh.positions[usize.from(v)];
      imm dist = (p - c).length();
      if dist < reach {
        imm nr = vertexNormalOf(&mesh, &mesh.positions, v);
        vs.push(v);
        nrms.push(nr);
        dists.push(dist);
        if dist < nearD {
          nearD = dist;
          nearN = nr;
        }
        sumN = sumN + nr * st.falloff.weight(dist / rad);
      }
      i = i + 1usize;
    }
    mut n = nearN;
    if sumN.lengthSquared() > 0.0000000001 { n = sumN.normalize(); }
    // The frame for strips, dams and alphas
    imm useDir = dir - n * dir.dot(n);
    imm hasDir = useDir.lengthSquared() > 0.0000000001;
    imm ua = if hasDir {useDir.normalize();} else {fixedAxis(n);};
    imm va = n.cross(ua);
    imm fixedU = fixedAxis(n);
    imm fixedV = n.cross(fixedU);
    mut out = new DabData(List[u32].empty(), List[f32].empty(), List[Vec3].empty());
    i = 0usize;
    while i < vs.len() {
      imm v = *vs[i];
      imm p = *mesh.positions[usize.from(v)];
      imm x = p - c;
      mut w = 1.;
      if mode == ModeRadial {
        w = st.falloff.weight(*dists[i] / rad);
      } elif mode == ModeStrips {
        imm u = absf(x.dot(ua)) / rad;
        imm q = absf(x.dot(va)) / (rad * st.brush.aspect);
        w = st.falloff.weight(if u > q {u;} else {q;});
      } elif mode == ModeDam {
        imm u = x.dot(ua) / rad;
        imm q = x.dot(va) / (rad * 0.35);
        w = st.falloff.weight((u * u + q * q).sqrt());
      }
      if w > 0. and masked and st.useMask and maskCh != NoIndex {
        w = w * (1. - clampf(mesh.float(maskCh, v), 0., 1.));
      }
      if w > 0. and st.frontOnly and (*nrms[i]).dot(n) <= 0. { w = 0.; }
      if w > 0. and allowedOn and !*allowed[usize.from(v)] { w = 0.; }
      if w > 0. and st.hasAlpha {
        imm au = if st.alpha.followStroke {x.dot(ua);} else {x.dot(fixedU);};
        imm av = if st.alpha.followStroke {x.dot(va);} else {x.dot(fixedV);};
        w = w * st.alpha.sample(0.5 + 0.5 * au / rad, 0.5 + 0.5 * av / rad);
      }
      if w > 0. {
        out.vs.push(v);
        out.w.push(w);
        out.nrm.push(*nrms[i]);
      }
      i = i + 1usize;
    }
    new Gathered(out, n);
  }

  // -------- one movement: grab, elastic deform, move topological, pose --------

  fn moveOnce(self &mut, st &Stroke) {
    imm np = st.points.len();
    if np < 2usize { return; }
    mut c0 = *st.points[0usize];
    imm end = *st.points[np - 1usize];
    if st.project {
      c0 = self.snap(c0, st.radius);
    }
    // The first one on its own, then each mirror of it
    imm npl = st.symmetry.len();
    imm combos = 1u32 << u32.from(npl);
    mut mask = 0u32;
    while mask < combos {
      mut mc = c0;
      mut me = end;
      mut j = 0usize;
      while j < npl {
        if (mask & (1u32 << u32.from(j))) != 0u32 {
          imm pl = &*st.symmetry[j];
          mc = reflectPoint(mc, pl.origin, pl.normal);
          me = reflectPoint(me, pl.origin, pl.normal);
        }
        j = j + 1usize;
      }
      if st.brush.kind == BrushPose {
        self.poseOnce(st, mc, me);
      } else {
        self.grabOnce(st, mc, me - mc);
      }
      mask = mask + 1u32;
    }
  }

  fn grabOnce(self &mut, st &Stroke, c Vec3, move Vec3) {
    imm kind = st.brush.kind;
    imm s = if st.strength > 1. {1.;} else {st.strength;};
    mut got = new Gathered(new DabData(List[u32].empty(), List[f32].empty(), List[Vec3].empty()), new Vec3(0., 1., 0.));
    if kind == BrushElastic {
      got = self.gather(st, c, new Vec3(0., 0., 0.), st.radius, st.radius * ElasticReach, ModeUnit, true);
    } elif kind == BrushMoveTopological {
      got = self.gatherSurface(st, c);
    } else {
      got = self.gather(st, c, new Vec3(0., 0., 0.), st.radius, st.radius, ModeRadial, true);
    }
    if got.data.vs.len() == 0usize { return; }
    dabCount = dabCount + 1u32;
    mut disp = List[Vec3].withCapacity(got.data.vs.len());
    mut i = 0usize;
    while i < got.data.vs.len() {
      imm w = *got.data.w[i];
      if kind == BrushElastic {
        imm x = *mesh.positions[usize.from(*got.data.vs[i])] - c;
        disp.push(kelvinBiscale(x, move, st.radius, st.brush.poisson) * (w * s));
      } else {
        disp.push(move * (w * s));
      }
      i = i + 1usize;
    }
    self.applyDisp(&got.data, &disp);
  }

  // Move Topological's dab: weights by distance along the surface
  fn gatherSurface(self &, st &Stroke, c Vec3) Gathered {
    imm maskName = if st.useMask {"mask";} else {"";};
    imm wts = surfaceBrushWeightsAt(&mesh, c, st.radius, &st.falloff, maskName);
    mut out = new DabData(List[u32].empty(), List[f32].empty(), List[Vec3].empty());
    mut sumN = new Vec3(0., 0., 0.);
    mut v = 0usize;
    while v < wts.len() {
      if *wts[v] > 0. {
        imm nr = vertexNormalOf(&mesh, &mesh.positions, u32.from(v));
        sumN = sumN + nr * *wts[v];
        out.vs.push(u32.from(v));
        out.w.push(*wts[v]);
        out.nrm.push(nr);
      }
      v = v + 1usize;
    }
    imm n = if sumN.lengthSquared() > 0.0000000001 {sumN.normalize();} else {new Vec3(0., 1., 0.);};
    // The gates
    mut kept = new DabData(List[u32].empty(), List[f32].empty(), List[Vec3].empty());
    mut i = 0usize;
    while i < out.vs.len() {
      mut w = *out.w[i];
      if st.frontOnly and (*out.nrm[i]).dot(n) <= 0. { w = 0.; }
      if allowedOn and !*allowed[usize.from(*out.vs[i])] { w = 0.; }
      if w > 0. {
        kept.vs.push(*out.vs[i]);
        kept.w.push(w);
        kept.nrm.push(*out.nrm[i]);
      }
      i = i + 1usize;
    }
    new Gathered(kept, n);
  }

  // Pose: the segment under the click, out to 'reach' radii along the surface,
  // turned about the pivot where it meets the rest, by the angle the drag from
  // the click to 'end' makes about the pivot
  fn poseOnce(self &mut, st &Stroke, c Vec3, end Vec3) {
    imm nv = mesh.positions.len();
    imm reach = st.radius * st.brush.reach;
    // Seed the sweep at the vertex nearest the click and its ring
    mut seeds = List[u32].empty();
    mut offs = List[f32].empty();
    imm near = grid.nearestWithin(c, reach + gridBound);
    if near == NoIndex { return; }
    seeds.push(near);
    offs.push((*mesh.positions[usize.from(near)] - c).length());
    imm ring0 = mesh.vertexNeighbors(near);
    mut k = 0usize;
    while k < ring0.len() {
      seeds.push(*ring0[k]);
      offs.push((*mesh.positions[usize.from(*ring0[k])] - c).length());
      k = k + 1usize;
    }
    imm dist = surfaceDistances(&mesh, &seeds, &offs, reach);
    // The pivot: the middle of the vertices at the segment's far edge
    mut pivot = st.brush.pivot;
    if !st.brush.fixedPivot {
      mut sum = new Vec3(0., 0., 0.);
      mut cnt = 0.;
      mut v = 0usize;
      while v < nv {
        if *dist[v] < reach and *dist[v] >= 0.85 * reach {
          sum = sum + *mesh.positions[v];
          cnt = cnt + 1.;
        }
        v = v + 1usize;
      }
      pivot = if cnt > 0. {sum * (1. / cnt);} else {c;};
    }
    imm u = c - pivot;
    imm w2 = end - pivot;
    if u.lengthSquared() <= 0. or w2.lengthSquared() <= 0. { return; }
    imm uh = u.normalize();
    imm wh = w2.normalize();
    imm axis = uh.cross(wh);
    imm qw = 1. + uh.dot(wh);
    // The weights, the mask, the face set
    mut data = new DabData(List[u32].empty(), List[f32].empty(), List[Vec3].empty());
    mut v = 0usize;
    while v < nv {
      if *dist[v] < reach {
        mut w = st.falloff.weight(*dist[v] / reach);
        if w > 0. and st.useMask and maskCh != NoIndex {
          w = w * (1. - clampf(mesh.float(maskCh, u32.from(v)), 0., 1.));
        }
        if w > 0. and allowedOn and !*allowed[v] { w = 0.; }
        if w > 0. {
          data.vs.push(u32.from(v));
          data.w.push(w);
        }
      }
      v = v + 1usize;
    }
    if data.vs.len() == 0usize { return; }
    dabCount = dabCount + 1u32;
    imm s = if st.strength > 1. {1.;} else {st.strength;};
    mut disp = List[Vec3].withCapacity(data.vs.len());
    mut i = 0usize;
    while i < data.vs.len() {
      imm f = s * *data.w[i];
      // The quaternion fraction f of the way from none to the whole turn, by normalised lerp
      imm qx = axis * f;
      imm qs = (1. - f) + f * qw;
      imm len = (qx.lengthSquared() + qs * qs).sqrt();
      imm qv = if len > 0. {qx * (1. / len);} else {new Vec3(0., 0., 0.);};
      imm qq = if len > 0. {qs / len;} else {1.;};
      imm x = *mesh.positions[usize.from(*data.vs[i])] - pivot;
      imm t1 = qv.cross(x);
      imm rotated = x + t1 * (2. * qq) + qv.cross(t1) * 2.;
      disp.push(rotated - x);
      i = i + 1usize;
    }
    self.applyDisp(&data, &disp);
  }
}

// What a gather returns: the dab's vertices and the area normal
pub struct Gathered {
  pub data DabData;
  pub n Vec3;
}

// How far (in radii) an elastic deform reaches
const ElasticReach = 3.5;

// -------- small helpers --------

fn absf(a f32) f32 {if a < 0. {-a;} else {a;};}
fn clampf(v f32, lo f32, hi f32) f32 {if v < lo {lo;} elif v > hi {hi;} else {v;};}

fn copyVec3s(src &List[Vec3]) List[Vec3] {
  mut out = List[Vec3].withCapacity(src.len());
  mut i = 0usize;
  while i < src.len() {
    out.push(*src[i]);
    i = i + 1usize;
  }
  out;
}

// A unit vector perpendicular to n, the same for the same n
fn fixedAxis(n Vec3) Vec3 {
  imm ref = if absf(n.x) < 0.9 {new Vec3(1., 0., 0.);} else {new Vec3(0., 1., 0.);};
  imm t = ref - n * ref.dot(n);
  t.normalize();
}

// The unit normal at a vertex from its faces' corners (the cross product of a
// corner's two sides is twice the corner triangle's area, so a bigger corner
// weighs more), (0, 1, 0) for a vertex with no face
fn vertexNormalOf(m &PolyMesh, pos &List[Vec3], v u32) Vec3 {
  imm hs = m.vertexOutgoing(v);
  imm p = *pos[usize.from(v)];
  mut sum = new Vec3(0., 0., 0.);
  mut k = 0usize;
  while k < hs.len() {
    imm h = *hs[k];
    if m.face(h) != NoIndex {
      imm a = *pos[usize.from(m.toVertex(h))] - p;
      imm b = *pos[usize.from(m.fromVertex(m.prev(h)))] - p;
      sum = sum + a.cross(b);
    }
    k = k + 1usize;
  }
  if sum.lengthSquared() > 0. { sum.normalize(); } else { new Vec3(0., 1., 0.); };
}

// One stroke on a copy of a mesh
pub fn sculptStroke(m &PolyMesh, st &Stroke) PolyMesh {
  mut s = Sculptor.of(m);
  s.stroke(st);
  s.finish();
}

// A recipe: the strokes in order on a copy of a mesh
pub fn sculptStrokes(m &PolyMesh, strokes &List[Stroke]) PolyMesh {
  mut s = Sculptor.of(m);
  mut i = 0usize;
  while i < strokes.len() {
    s.stroke(&*strokes[i]);
    i = i + 1usize;
  }
  s.finish();
}
