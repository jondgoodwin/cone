// The frame package: the loop a world runs in. The loop's owner (here a native
// runner over the window and sdl packages; later a platform layer, or a
// browser's requestAnimationFrame) calls the world, and the world never owns a
// 'while running' of its own. The boundary between them is World[S], a struct
// of the world's callbacks, and S, the state they share:
//
//   import frame use World, Config, Host, Step;
//
//   struct State { pub angle: f32; }          // the world's state: its own type
//   fn start(host: &mut Host) Option[State] { Some[State](State(0.)) }   // make it
//   fn event(host: &mut Host, st: &uni State, e: &imm sdl.Event) { ... }
//   fn simulate(host: &mut Host, st: &uni State, step: &imm Step, scratch: &mut Arena) { ... }
//   fn draw(host: &mut Host, st: &uni State, alpha: f32, scratch: &mut Arena) { ... }
//   fn quit(host: &mut Host, st: &uni State) i32 { 0 }
//
//   fn main(argc: i32, argv: **u8) i32 {
//     run(Config.fromArgs(argc, argv), &worldOf(&start, &event, &simulate, &draw, &quit))
//   }
//
// 'run[S]' takes S from what 'start' returns, so no type is named twice. The
// program keeps its own 'main', which calls 'run': how a host plugs in is not
// decided, so nothing here takes 'main' away. 'network', 'publish' and
// 'present' do nothing unless the world sets those fields of its World.
//
// THE STATE belongs to 'run': 'start' builds it and returns it, 'run' holds it
// in a local declared after the Host and lends it as '&uni S' to one callback
// at a time, and it is finalized, in field order, when 'run' ends, before the
// window dies. So a world that finalizes (GPU objects) needs no global, no
// 'init', no hand-written teardown, and no thread-local. A callback matches a
// field of it in place: 'match &uni st.gfx { case var &uni Some(g) { ... } }'.
// A world with no state of its own returns 'Some[NoState](NoState())'.
// Values known before 'start' (the command line's flags) stay module globals.
//
// ONE FRAME is a list of named phases in a declared order (PHASE_INPUT ...
// PHASE_PRESENT), each timed:
//
//   input     every waiting event drained, each handed to 'event' with its
//             nanosecond timestamp (sdl.Event.timestamp, on GetTicksNS's clock)
//   simulate  0..n fixed steps from an accumulator of elapsed world time, at
//             most Config.maxCatchUp; the rest are dropped and counted
//   network   the server-communication slot: queues in and out, never blocking
//             (no transport yet, so it is empty)
//   publish   the world copies what render reads out of what simulate wrote
//   render    'draw' records the frame, between the last two states by 'alpha'
//   present   show it, and wait until the next can be drawn (the present wait)
//
// The GPU's own time for a frame is not measured yet: that wants timestamp
// queries, which the vulkan and gpu packages do not bind.
//
// PHASES FENCE THEIR WRITES: each phase's outputs are complete before the next
// phase reads them, and a phase reads only what the phases before it wrote.
// On one thread that is just calling them in order; it is what lets a phase
// move to a job or an actor later as a change of scheduler, not of the world.
// A debug build checks the order ('Host.beginPhase').
//
// TIME. The world clock is SDL3's GetTicksNS (u64 nanoseconds, the clock every
// event's timestamp is on), or, in synthetic mode, a clock advanced by a
// script of frame intervals, which makes step counts and alpha exact and a run
// reproducible. Simulated time is the number of steps taken times the step's
// length, both integers, so it is exact and never drifts: 'Host.simNs()'.
// Phase timings always use the real clock.
//
// STATISTICS from the first frame: every phase's time, and the whole frame's
// (start to start), each as p50, p95, p99 and the MAXIMUM, with the frame the
// maximum came in, and the catch-up steps dropped. A no-stall budget is judged
// on the maximum, so maxima are recorded, never only means. They print when
// the run ends (Config.printStats) and are 'host.stats' to the world.
//
// THE SCRATCH ARENA. Each frame the runner makes an arena (the arena package),
// hands it to simulate and draw, and lets it die at the end of the frame:
// that is its reset, and the borrow rules keep anything allocated in it from
// outliving the frame. (An arena has no reset that keeps its blocks, so each
// frame allocates its first block, Config.scratchBytes, and frees it.)
//
// THE FIRST FRAME runs no step: the clock is read as it begins, so nothing has
// elapsed, and it draws the world as start left it. Time spent in start is
// never owed.
//
// One thread for now; nothing a world writes assumes it: each phase is a
// callback of its own, handed only what it may read or write.

mod frame;

import libc;
import sdl;
import stdio use *;
import collections use List, String;
import arena use Arena;
import window use Window;

// The phases of a frame, in the order they run
pub const PHASE_INPUT = 0u32;
pub const PHASE_SIMULATE = 1u32;
pub const PHASE_NETWORK = 2u32;
pub const PHASE_PUBLISH = 3u32;
pub const PHASE_RENDER = 4u32;
pub const PHASE_PRESENT = 5u32;
pub const PHASE_COUNT = 6u32;

// A phase's name, as the statistics print it
pub fn phaseName(phase: u32) &str {
  if phase == PHASE_INPUT { return "input"; }
  if phase == PHASE_SIMULATE { return "simulate"; }
  if phase == PHASE_NETWORK { return "network"; }
  if phase == PHASE_PUBLISH { return "publish"; }
  if phase == PHASE_RENDER { return "render"; }
  if phase == PHASE_PRESENT { return "present"; }
  "?"
}

// The state a world's callbacks share is its own type, 'S': whatever 'start'
// builds and returns. 'run' keeps it in a local, declared after the Host, and
// lends it to one callback at a time as '&uni S', so a callback may change it
// and none can keep a borrow past its call. When 'run' ends the state is
// finalized, in field order, before the window dies. A world with nothing of
// its own to hold uses 'NoState'.
pub struct NoState {}

// What a world gives a loop's owner to run: its callbacks, each handed the Host
// and the state. 'worldOf' takes the five every world needs and leaves the
// other three doing nothing; a world that wants one sets the field.
pub struct World[S] {
  // Once, before the first frame: make the state, and what the world draws with
  // (the window is host.window(), unless the run is headless). None ends the
  // run, with exit code 1 and no 'quit'.
  pub start: &fn(host: &mut Host) Option[S];

  // Each event waiting at the top of a frame, in order, before any step. The
  // runner has already handled what every window handles (quit, Escape
  // unless Config.escapeQuits is false, F11, a resize, which sets
  // host.window().resized). With escapeQuits false the Escape key arrives
  // here like any key, and the world stops the run, or not, with host.stop().
  pub event: &fn(host: &mut Host, st: &uni S, e: &imm sdl.Event);

  // One fixed step of 'step.dt' seconds: the world moves from its state at
  // 'step.index' to the next. Called 0..Config.maxCatchUp times a frame.
  pub simulate: &fn(host: &mut Host, st: &uni S, step: &imm Step, scratch: &mut Arena);

  // The render phase: record the frame, the picture 'alpha' of the way from
  // the state before the last step to the state after it (0 <= alpha < 1).
  pub draw: &fn(host: &mut Host, st: &uni S, alpha: f32, scratch: &mut Arena);

  // Once, after the last frame: the run's exit code, which 'run' returns. The
  // state is finalized after it returns.
  pub quit: &fn(host: &mut Host, st: &uni S) i32;

  // The server-communication slot, each frame after the steps: read
  // 'net.inbound', add to 'net.outbound', never wait. Default: nothing.
  pub network: &fn(host: &mut Host, st: &uni S, net: &mut NetQueues);

  // Each frame after network: copy what render reads out of what simulate
  // wrote, so render never reads the simulation's own state. Default: nothing.
  pub publish: &fn(host: &mut Host, st: &uni S);

  // Each frame after render: show the frame, and wait until the next can be
  // drawn. A world whose render presents leaves it out. Default: nothing.
  pub present: &fn(host: &mut Host, st: &uni S);

}

// A World with the five callbacks every world needs, and nothing in the other
// three slots. S comes from what 'start' returns.
pub fn worldOf[S](start: &fn(host: &mut Host) Option[S],
    event: &fn(host: &mut Host, st: &uni S, e: &imm sdl.Event),
    simulate: &fn(host: &mut Host, st: &uni S, step: &imm Step, scratch: &mut Arena),
    draw: &fn(host: &mut Host, st: &uni S, alpha: f32, scratch: &mut Arena),
    quit: &fn(host: &mut Host, st: &uni S) i32) World[S] {
  World[S](start, event, simulate, draw, quit, &noNetwork[S], &noPublish[S], &noPresent[S])
}

fn noNetwork[S](host: &mut Host, st: &uni S, net: &mut NetQueues) {}
fn noPublish[S](host: &mut Host, st: &uni S) {}
fn noPresent[S](host: &mut Host, st: &uni S) {}

// The loop, run by the program's 'main'. Its answer is quit's, or 1 if the
// host could not open or 'start' failed.
pub fn run[S](config: Config, world: &World[S]) i32 {
  var host = Host.open(config);
  if !host.isOpen() { return 1i32; }
  var started = world.start(&mut host);
  match &uni started {
    case var &uni Some(state) {
      var net = NetQueues();   // the network slot's queues, the loop's own
      while host.beginFrame() {
        var scratch = Arena.withRoom(host.scratchBytes());

        host.beginPhase(PHASE_INPUT);
        var e = sdl.Event();
        while host.nextEvent(&mut e) {
          let ev = e;           // an event is handed on immutable (&imm, so it can be matched)
          world.event(&mut host, &uni *state, &imm ev);
        }
        host.endPhase(PHASE_INPUT);

        host.beginPhase(PHASE_SIMULATE);
        while host.nextStep() {
          let step = host.step();
          world.simulate(&mut host, &uni *state, &imm step, &mut scratch);
        }
        host.endPhase(PHASE_SIMULATE);

        host.beginPhase(PHASE_NETWORK);
        net.ticks = host.netTicks();
        world.network(&mut host, &uni *state, &mut net);
        host.endNet(&mut net);
        host.endPhase(PHASE_NETWORK);

        host.beginPhase(PHASE_PUBLISH);
        world.publish(&mut host, &uni *state);
        host.endPhase(PHASE_PUBLISH);

        host.beginPhase(PHASE_RENDER);
        let alpha = host.alpha();
        world.draw(&mut host, &uni *state, alpha, &mut scratch);
        host.endPhase(PHASE_RENDER);

        host.beginPhase(PHASE_PRESENT);
        world.present(&mut host, &uni *state);
        host.endPhase(PHASE_PRESENT);

        host.endFrame();
      }
      let code = world.quit(&mut host, &uni *state);
      host.finish();
      return code;
    }
    else { return 1i32; }
  }
  1i32
}

// How a run goes. 'Config.defaults()' is 60 steps a second, one physics
// substep, rendering at the display's rate with vsync (the swapchain's), at
// most 5 catch-up steps a frame, a 30 Hz network tick, until the window
// closes, printing the statistics at the end.
pub struct Config {
  pub title: String;         // the window's title
  pub stepNs: u64;           // one simulation step, in nanoseconds
  pub substeps: u32;         // physics substeps a step (for the world's physics to divide by)
  pub maxCatchUp: u32;       // the most steps a frame runs; the rest are dropped and counted
  pub netTickNs: u64;        // the network tick, in nanoseconds
  pub frames: u64;           // stop after this many frames; 0: until asked to stop
  pub headless: bool;        // no window, no display: SDL's events only
  pub synthetic: bool;       // the world clock advances by 'intervals', not in real time
  pub intervals: List[u64];  // synthetic mode: each frame's interval in ns, cycled; empty: one step each
  pub scratchBytes: usize;   // the room the per-frame scratch arena starts with
  pub printStats: bool;      // print the statistics when the run ends
  pub escapeQuits: bool;     // Escape stops the run (true); false: the world gets the key in 'event' and decides, with host.stop()

  pub fn defaults() Config {
    Config(String(), 1000000000u64 / 60u64, 1u32, 5u32, 1000000000u64 / 30u64, 0u64,
      false, false, List[u64](), 65536usize, true, true)
  }

  // The defaults, and what the command line says: '--frames N' stops after N
  // frames and runs on the synthetic clock, one step a frame, so the run is
  // the same every time; '--headless' opens no window (and is synthetic too);
  // '--quiet' prints no statistics. Anything else is the program's.
  pub fn fromArgs(argc: i32, argv: **u8) Config {
    var c = Config.defaults();
    var a = 1i32;
    while a < argc {
      let arg = *(argv + usize.from(a));
      if libc.strcmp(cstr.fromPtr(arg), "--frames") == 0i32 && a + 1i32 < argc {
        c.frames = parseCount(*(argv + usize.from(a + 1i32)));
        c.synthetic = true;
        a = a + 1i32;
      } else if libc.strcmp(cstr.fromPtr(arg), "--headless") == 0i32 {
        c.headless = true;
        c.synthetic = true;
      } else if libc.strcmp(cstr.fromPtr(arg), "--quiet") == 0i32 {
        c.printStats = false;
      }
      a = a + 1i32;
    }
    c
  }

  // Steps of 1/hz seconds (to the nanosecond below)
  pub fn setStepHz(self: &mut, hz: u32) {
    stepNs = 1000000000u64 / u64.from(hz);
  }

  // The window's title
  pub fn setTitle(self: &mut, text: &str) {
    title.clear();
    title.append(text);
  }
}

// A whole number from a C string, 0 if it is not one
fn parseCount(s: *u8) u64 {
  var n = 0u64;
  var i = 0usize;
  while *(s + i) != 0u8 {
    let c = *(s + i);
    if c < '0' || c > '9' { return 0u64; }
    n = n * 10u64 + u64.from(c - '0');
    i = i + 1usize;
  }
  n
}
