// Phases run in their declared order: a debug build panics when one begins
// after a later one has ended in the same frame. Here render ends, and input
// begins after it.
//
// It needs SDL3.dll, and no display.

mod outoforder;

import stdio use *;
import frame use *;

fn main() i32 {
  mut c = Config.defaults();
  c.headless = true;
  c.synthetic = true;
  c.printStats = false;
  mut host = Host.open(c);
  host.beginFrame();
  host.beginPhase(PHASE_RENDER);
  host.endPhase(PHASE_RENDER);
  printStr("input after render\n");
  host.beginPhase(PHASE_INPUT);
  printStr("not reached\n");
  0i32;
}
