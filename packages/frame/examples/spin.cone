// spin: a lit, textured sphere turning in a window -- Pegasus's horseworld
// earth, in Cone, drawn by Vulkan -- as a world the frame package runs. The
// render package draws it (through the gpu package), frame's runner gives it
// a window and its loop, and geomath places the sphere and the camera.
//
// The sphere turns by SIMULATED time: each fixed step (60 a second) sets its
// angle from the steps taken, and each frame draws it between the last two
// steps' angles by frame's interpolation factor, so its speed is the same at
// any frame rate. What render reads is published from what simulate wrote.
//
// It stops on Escape, when the window is closed, or after 600 frames, and
// then prints how many frames it drew, the color it found at the middle of
// the window on the tenth, which is the sphere's, and frame's per-phase
// timings. F11 toggles fullscreen; the window may be resized.
//
//   congo run packages/frame/examples/spin.cone
//   congo run packages/frame/examples/spin.cone -- --frames 120
//   congo run packages/frame/examples/spin.cone -- --headless --frames 120
//
// '--frames N' draws N frames on frame's synthetic clock, one step a frame,
// so the run and the color it reads are the same every time. '--headless'
// opens no window and draws nothing: the steps, the interpolation and the
// angle alone, exact. GPU_POWER_PREFERENCE=low-power picks the integrated GPU.
//
// It needs a display, a GPU driver with Vulkan 1.3, SDL3.lib on LIB to link
// and SDL3.dll on PATH to run. With the Vulkan SDK, validation is on.

mod spin is World;

import stdio use *;
import libc;
import sdl;
import geomath use *;
import mesh use Mesh;
import gpu use *;
import render use *;
import window use *;
import arena use Arena;
import frame use World, Config, Host, Step;

// The sphere turns 0.8 radians a second of simulated time
const spinrate = 0.8f64;

// The simulation's state, which only simulate writes: the angle after the
// last step, and after the one before
mut angle f32 = 0.;
mut before f32 = 0.;

// What render reads, which only publish writes
mut shownFrom f32 = 0.;
mut shownTo f32 = 0.;

// The GPU side, made by start and released by quit. Its fields die in the
// order they are declared, so the device outlives what it made, and the
// instance the device.
struct Gfx {
  pub readback Buffer;         // frame 10's pixels, copied in render, read in present
  pub target SurfaceTexture;   // the swapchain's texture the next frame draws into
  pub renderer Renderer;
  pub swapchain SwapChain;
  pub device Device;
  pub adapter Adapter;
  pub surface Surface;
  pub instance Instance;
  pub ball MeshHandle;
  pub material MaterialHandle;
  pub list DrawList;
  pub camera Camera;
  pub light Light;
}

// Made in start. (A global Option cannot be matched in place, only a borrow
// of a local can, so each callback swaps it out into a local and back.)
mut gfx Option[Gfx];

// Frames drawn, and the color at the middle of the window on the tenth
mut drawn = 0;
mut centre Array[i32, 3] = [3; 0];

fn @initpure init() {
  gfx = None[Gfx][];
}

fn takeGfx() Option[Gfx] {
  mut g Option[Gfx] = None[Gfx][];
  g <=> gfx;
  g;
}

pub fn start(host &mut Host) Bool {
  if !host.hasWindow() { return true; }       // headless: the simulation alone
  mut instance = Instance.create("spin");
  mut surface = instance.createSurface(host.window().sdlHandle());
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize {
    if libc.strcmp(env, &"low-power" as *u8) == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&surface, preference);
  if !adapter.isValid() {
    print <- "No GPU can draw to the window\n";
    return false;
  }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  mut device = adapter.requestDevice();
  imm size = host.window().size();
  mut swapchain = device.createSwapChain(&surface, u32[size.w], u32[size.h], TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut renderer = Renderer.create(&mut device, swapchain.format, TEXTURE_FORMAT_DEPTH32_FLOAT);
  if !renderer.isValid() {
    print <- "The renderer could not be made\n";
    return false;
  }

  // The camera at (0, 0, 3.5) looks down -z at the sphere, on a dark blue sky
  mut camera = Camera.make();
  camera.origin = Vec3[0., 0., 3.5];
  camera.background = Color[0.05, 0.05, 0.15, 1.];

  // horseworld's light: a low evening sun, up and to the left, behind the camera
  imm light = Light.from(Vec3[-3.5, 5.5, 10.], Color[0.78, 0.70, 0.55, 1.], Color[0.52, 0.55, 0.60, 1.]);

  // A sphere with horseworld earth's diffuse color, and a checkerboard for a
  // texture: eight squares around, four from pole to pole
  imm sphere = Mesh.sphere(1., 32);
  imm ball = renderer.addMesh(&mut device, &sphere);
  imm checks = Image.checker(256, 128, 8, 4, Color[0.9, 0.3, 0.1, 1.], Color[0.95, 0.9, 0.8, 1.]);
  imm tex = renderer.addTexture(&mut device, &checks);
  imm earth = Material.textured(Color[0.5882, 0.5882, 0.5882, 1.], tex);
  imm material = renderer.addMaterial(&mut device, &earth);

  // The first frame's texture: each present acquires the next
  imm target = swapchain.getCurrentTexture(&mut device);
  gfx = Some[Gfx][Gfx[Buffer.none(), target, renderer, swapchain, device, adapter, surface, instance,
    ball, material, DrawList.empty(), camera, light]];
  true;
}

// The window's own events are frame's; a resize is the swapchain's
pub fn event(host &mut Host, e &imm sdl.Event) {
  if !host.hasWindow() or !host.window().resized { return; }
  host.window().resized = false;
  imm s = host.window().size();
  mut g = takeGfx();
  match &mut g {
    case mut some &mut Some { some.value.swapchain.resize(u32[s.w], u32[s.h]); }
    else {}
  }
  gfx = g;
}

// One step: the angle at the end of it, from the steps taken times the step,
// so it is exact however many steps a frame runs
pub fn simulate(host &mut Host, step &imm Step, scratch &mut Arena) {
  before = angle;
  imm endNs = step.startNs + step.ns;
  angle = f32[spinrate * f64[endNs] / 1.0e9f64];
}

// What render will read: the last two steps' angles
pub fn publish(host &mut Host) {
  shownFrom = before;
  shownTo = angle;
}

// Record the frame: the sphere 'alpha' of the way from the step before to the last
pub fn draw(host &mut Host, alpha f32, scratch &mut Arena) {
  imm a = shownFrom + (shownTo - shownFrom) * alpha;
  mut g = takeGfx();
  match &mut g {
    case mut some &mut Some { drawBall(&mut some.value, a); }
    else {}
  }
  gfx = g;
}

fn drawBall(g &mut Gfx, a f32) {
  if !g.target.ok() { return; }
  imm tilt = Quat.angleAxis(0.4, Vec3[1., 0., 0.]);
  g.list.clear();
  g.list.add(g.ball, g.material, Mat4.fromTrs(Vec3[0., 0., 0.], tilt * Quat.angleAxis(a, Vec3[0., 1., 0.]),
    Vec3[1., 1., 1.]));
  mut encoder = g.device.createCommandEncoder();
  g.renderer.render(&mut g.device, &mut encoder, &g.target.texture, &g.target.depth, &g.camera, &g.light, &g.list);
  drawn = drawn + 1;

  // What was drawn at the middle of the window on the tenth frame: copied
  // now, read once presented
  if drawn == 10 {
    imm w = g.target.texture.width;
    imm h = g.target.texture.height;
    g.readback = g.device.createBuffer(u64[w] * u64[h] * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    encoder.copyTextureToBuffer(&g.target.texture, &g.readback);
  }
  g.device.queue.submit(encoder.finish());
}

// Show the frame, and wait for the next texture to draw into: the present wait
pub fn present(host &mut Host) {
  mut g = takeGfx();
  match &mut g {
    case mut some &mut Some { showAndAcquire(&mut some.value); }
    else {}
  }
  gfx = g;
}

fn showAndAcquire(g &mut Gfx) {
  if g.target.ok() {
    g.swapchain.present(&mut g.device);
    if drawn == 10 and g.readback.size > 0u64 {
      g.device.waitIdle();
      imm w = g.target.texture.width;
      imm h = g.target.texture.height;
      imm p = g.readback.mappedRange() + usize[(h / 2u32 * w + w / 2u32) * 4u32];
      imm bgra = g.target.texture.format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB
        or g.target.texture.format == TEXTURE_FORMAT_BGRA8_UNORM;
      centre[0] = i32[*(p + (if bgra {2usize;} else {0usize;}))];
      centre[1] = i32[*(p + 1usize)];
      centre[2] = i32[*(p + (if bgra {0usize;} else {2usize;}))];
      g.readback = Buffer.none();
    }
  } else {
    sdl.Delay(10u32);       // minimized: nothing to draw into
  }
  g.target = g.swapchain.getCurrentTexture(&mut g.device);
}

pub fn quit(host &mut Host) i32 {
  print <- "Steps "; print <- host.stats.steps; print <- ", simulated ";
  print <- host.simNs(); print <- " ns, angle "; print <- f64[angle]; print <- "\n";
  if !host.hasWindow() { return 0i32; }
  mut code = 0i32;
  mut g = takeGfx();
  match &mut g {
    case mut some &mut Some { some.value.device.waitIdle(); }
    else {}
  }
  g = None[Gfx][];      // the GPU's objects go before the window does
  print <- "Frames drawn: "; print <- drawn; print <- "\n";
  print <- "Middle of the window on frame 10: ";
  print <- centre[0]; print <- " "; print <- centre[1]; print <- " "; print <- centre[2]; print <- "\n";
  print <- "Vulkan failures: "; print <- u64[failures()];
  print <- "; validation messages: "; print <- u64[validationMessages()]; print <- "\n";
  if failures() != 0u32 or validationMessages() != 0u32 { code = 1i32; }
  code;
}

fn main(argc i32, argv **u8) i32 {
  initAll();
  mut config = Config.fromArgs(argc, argv);
  config.setTitle("Cone: a lit, textured, turning sphere");
  if config.frames == 0u64 { config.frames = 600u64; }
  imm code = run(config);
  finalAll();
  code;
}
