// A float in a log message is core's FloatText, the text a String's '<-'
// writes: '<-' of an f64, and 'appendF32' for an f32's own shortest text.

mod messagefloat;

import stdio use *;
import trace;

fn main() {
  var m = trace.Message() <- "took ", 0.25, " s of ", 1e-7, ", ratio ", 2.0 / 3.0;
  m <- ", f32 ";
  m.appendF32(1.0f32 / 3.0f32);
  printStr(m.text());
  printStr("\n");
}
