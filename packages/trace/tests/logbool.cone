// A generic that logs a bool: '$"..."' to a Log with the bool held by value ('T') or through a
// borrow ('&T'). A borrow is taken by no overload of the record's 'value', so it is written as
// the bool's text, as it is outside a generic.

mod logbool;

import stdio use *;
import trace use Level, Log;

let log: Log;

fn @initpure init() {
  log = Log.make("app", Level.Info);
}

struct Printer is trace.Sink {
  pub n: i64;

  pub fn enabled(self: &, k: &trace.Info) bool {true}

  pub fn record(self: &, e: &trace.Event) {
    print <- e.message, "\n";
  }
}

fn byValue[T](x: T) {
  log <- $"value {x}";
}

fn byBorrow[T](x: &T) {
  log <- $"borrow {x}";
}

fn both[T](x: T) {
  byValue(x);
  byBorrow(&x);
}

fn main() i32 {
  trace.install(Uni[Printer](0));
  trace.setDefaultLevel(Level.Info);
  both(true);
  both(false);
  // Plain, outside a generic: a bool and a borrow of one
  let c = true;
  let r = &c;
  log <- $"plain {c} {r}";
  0i32
}
