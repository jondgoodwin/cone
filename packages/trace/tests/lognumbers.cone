// A generic that logs a number: '$"..."' to a Log with the number held by value ('T') or
// through a borrow ('&T'), for every number type. A borrow is taken by no overload of the
// record's 'value', so it is written as the number's text, as it is outside a generic.

mod lognumbers;

import stdio use *;
import trace use Level, Log;

let log: Log;

fn @initpure init() {
  log = Log.make("app", Level.Info);
}

struct Printer is trace.Sink {
  pub n: i64;

  pub fn enabled(self: &, k: &trace.Info) bool {true}

  pub fn record(self: &, e: &trace.Event) {
    print <- e.message, "\n";
  }
}

fn byValue[T](x: T) {
  log <- $"value {x}";
}

fn byBorrow[T](x: &T) {
  log <- $"borrow {x}";
}

fn both[T](x: T) {
  byValue(x);
  byBorrow(&x);
}

fn main() i32 {
  trace.install(Uni[Printer](0));
  trace.setDefaultLevel(Level.Info);
  both(-1i8);
  both(-2i16);
  both(-3i32);
  both(-4i64);
  both(-5isize);
  both(6u8);
  both(7u16);
  both(8u32);
  both(9u64);
  both(10usize);
  both(1.5f32);
  both(2.25f64);
  // Plain, outside a generic: a number and a borrow of one
  let n = 11i32;
  let r = &n;
  log <- $"plain {n} {r}";
  0i32
}
