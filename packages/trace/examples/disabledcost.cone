// What an event of a kind that is off costs: a disabled 'emit' in a hot loop
// against the same loop without it. The kind is off because its target's level
// is below its own, with a sink installed (the case a shipped program meets).
// Each loop adds its counter into a sum the program prints, so neither is
// folded away; the emit's argument is a call that would show in the sum if it
// ran. Five rounds of each, the best taken.
//
//   congo run --release packages/trace/examples/disabledcost.cone -- [count]
//
// Prints 'empty_ps <n>', 'disabled_ps <n>' (picoseconds a pass, the best
// round) and 'cost_ps <n>', their difference.

mod disabledcost;

import stdio use *;
import trace use Level, Kind1;

let hot: Kind1[u64];

fn @initpure init() {
  hot = Kind1[u64].make("hot", "bench", Level.Debug, "i");
}

struct Nowhere is trace.Sink {
  pub n: u64;
  pub fn enabled(self: &, k: &trace.Info) bool {true}
  pub fn record(self: &, e: &trace.Event) {}
}

var calls = 0u64;

// The argument: counts if it is ever evaluated
fn costly(i: u64) u64 {
  calls = calls + 1u64;
  i * 3u64
}

fn digits(p: *u8) u64 {
  var n = 0u64;
  var q = p;
  while *q >= 48u8 && *q <= 57u8 {
    n = n * 10u64 + u64.from(*q - 48u8);
    q = q + 1usize;
  }
  n
}

fn empty(n: u64) u64 {
  var sum = 0u64;
  var i = 0u64;
  while i < n {
    sum = sum + (i ^ (sum >> 3u64));
    i = i + 1u64;
  }
  sum
}

fn disabled(n: u64) u64 {
  var sum = 0u64;
  var i = 0u64;
  while i < n {
    sum = sum + (i ^ (sum >> 3u64));
    hot.emit(costly(i));
    i = i + 1u64;
  }
  sum
}

// Picoseconds a pass of the faster of five rounds
fn best(n: u64, withEmit: bool, sum: &mut u64) u64 {
  var least = 0xFFFFFFFFFFFFFFFFu64;
  var round = 0;
  while round < 5 {
    let t0 = trace.ticks();
    let s = if withEmit {disabled(n)} else {empty(n)};
    let t1 = trace.ticks();
    *sum = *sum + s;
    let ps = (t1 - t0) * 1000000000000u64 / trace.clockFrequency() / n;
    if ps < least {
      least = ps;
    }
    round = round + 1;
  }
  least
}

fn main(argc: i32, argv: **u8) i32 {
  var n = 200000000u64;
  if argc > 1i32 {
    n = digits(*(argv + 1usize));
  }
  expectInstalled(trace.install(Uni[Nowhere](0u64)));
  trace.setLevel("bench", Level.Info);      // below the kind's Debug: off
  var sum = 0u64;
  let e = best(n, false, &mut sum);
  let d = best(n, true, &mut sum);
  print <- "count ", n, "\n";
  print <- "empty_ps ", e, "\n";
  print <- "disabled_ps ", d, "\n";
  print <- "cost_ps ", if d > e {d - e} else {0u64}, "\n";
  print <- "evaluated ", calls, "\n";
  print <- "checksum ", sum, "\n";
  0
}

fn expectInstalled(ok: bool) {
  if !ok {
    panic("disabledcost: the sink was not installed");
  }
}
