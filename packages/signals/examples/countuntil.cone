// Counts until Ctrl-C (or a terminate) and then ends cleanly: press Ctrl-C and it prints the count and a clean-exit
// line. To need no keyboard (as when the package's examples are run by a script) it raises its own Interrupt at the
// 3000th count, the same flag a real Ctrl-C sets.

mod countuntil;

import stdio use *;
import signals use *;
import thread;
import time use Duration;

fn main() i32 {
  initAll();
  var ok = false;
  match install(SignalSet.all()) {
    case is Ok {ok = true;}
    case is Err {}
  }
  if !ok {
    print <- "could not install the signal handler\n";
    return 1i32;
  }
  print <- "counting; press Ctrl-C to stop\n";
  var n = 0u64;
  while !take(Signal.Interrupt) && !take(Signal.Terminate) {
    n = n + 1u64;
    if n == 3000u64 {
      match raise(Signal.Interrupt) {
        case is Ok {}
        case is Err {}
      }
    }
    thread.sleep(Duration.fromMillis(1));
  }
  print <- "interrupted after ", n, " counts; shutting down cleanly\n";
  0i32
}
