// Where the time of a step goes: a 32 x 32 cloth hung by its top row, 10 substeps, in a wind,
// with parts of the step left out in turn. Each line is the fastest of 200 steps (the least
// disturbed by other work on the machine) after 50 of warm-up, in microseconds.
//
//   congo run --release packages/xpbdsoftbody/examples/profile.cone

mod profile;

import stdio use *;
import time use Instant;
import collections use *;
import geomath use *;
import xpbdsoftbody use *;

fn cloth(n u32) SoftBody {
  var c = clothGrid(new Vec3(-0.5, 1., -0.5), new Vec3(1., 0., 0.), new Vec3(0., 0., 1.), n, n, &Fabric.light());
  var i = 0u32;
  while i <= n { c.pin(i); i = i + 1u32; }
  c.substeps = 10u32;
  c;
}

fn timeIt(label &str, c &mut SoftBody) {
  var s = 0;
  while s < 50 { c.step(1. / 60., new Vec3(4., 0., 0.5)); s = s + 1; }
  var best = 1000000000000i64;
  s = 0;
  while s < 200 {
    let t0 = Instant.now();
    c.step(1. / 60., new Vec3(4., 0., 0.5));
    let ns = t0.elapsed().nanos();
    if ns < best { best = ns; }
    s = s + 1;
  }
  printStr(label); printStr(": "); printInt(best / 1000i64); printStr(" us\n");
}

fn main() i32 {
  var a = cloth(32u32);
  print <- "stretch "; print <- i64.from(a.dist.len()); print <- ", bending "; print <- i64.from(a.bend.len());
  print <- ", triangles "; print <- i64.from(a.tris.len() / 3usize); print <- "\n";
  timeIt("full step", &mut a);
  var b = cloth(32u32); b.airDensity = 0.; timeIt("without wind", &mut b);
  var c = cloth(32u32); c.bend.clear(); timeIt("without bending", &mut c);
  var d = cloth(32u32); d.dist.clear(); timeIt("without stretch", &mut d);
  var e = cloth(32u32); e.dist.clear(); e.bend.clear(); e.airDensity = 0.; timeIt("prediction and velocity only", &mut e);
  // with gravity off and the cloth flat, every constraint is evaluated and none moves anything
  var f = cloth(32u32); f.bend.clear(); f.airDensity = 0.; f.gravity = new Vec3(0., 0., 0.); timeIt("stretch only, at rest", &mut f);
  var g = cloth(32u32); g.dist.clear(); g.airDensity = 0.; g.gravity = new Vec3(0., 0., 0.); timeIt("bending only, at rest", &mut g);
  var g2 = cloth(32u32); g2.dist.clear(); g2.airDensity = 0.; g2.gravity = new Vec3(0., 0., 0.); g2.useCurvatureBending();
  timeIt("bending only, curvature model, at rest", &mut g2);
  var h = cloth(32u32); h.dist.clear(); h.bend.clear(); timeIt("wind only", &mut h);
  0i32;
}
