// Cost per step of the soft bodies. Build it optimised and run it:
//
//   congo run --release packages/xpbdsoftbody/examples/bench.cone
//
// Each line is the mean time of one 'step' (1/60 s) over 300 steps after 60
// of warm-up, for:
//  - a 32 x 32 cloth (33 x 33 = 1,089 particles, 3,008 stretch and 2,944
//    bending constraints), top row pinned, in a 4 m/s wind, 10 and 20 substeps;
//    with the sphere collider and self collision it also costs;
//  - a 100-link rope (101 particles, 100 segments and 99 skip-one bending
//    constraints), both ends pinned, 20 substeps;
//  - the 'writeMesh' that follows each cloth step.

mod bench;

import stdio use *;
import time use Instant;
import collections use *;
import geomath use *;
import mesh use Mesh;
import xpbdsoftbody use *;

fn cloth(substeps u32, sphere bool, selfCollide bool) SoftBody {
  mut c = clothGrid(new Vec3(-0.5, 1., -0.5), new Vec3(1., 0., 0.), new Vec3(0., 0., 1.), 32u32, 32u32, &Fabric.light());
  mut i = 0u32;
  while i <= 32u32 {
    c.pin(i);
    i = i + 1u32;
  }
  if sphere { c.addCollider(Collider.sphere(new Vec3(0., 0.2, 0.3), 0.25)); }
  c.selfCollide = selfCollide;
  c.selfRadius = 0.012;
  c.substeps = substeps;
  c;
}

fn timeCloth(label &str, c &mut SoftBody) {
  mut s = 0;
  while s < 60 {
    c.step(1. / 60., new Vec3(4., 0., 0.5));
    s = s + 1;
  }
  imm t0 = Instant.now();
  s = 0;
  while s < 300 {
    c.step(1. / 60., new Vec3(4., 0., 0.5));
    s = s + 1;
  }
  imm ns = t0.elapsed().nanos();
  printStr(label);
  printStr(": ");
  printInt(ns / 300i64 / 1000i64);
  printStr(" us per step\n");
}

fn main() i32 {
  mut a = cloth(10u32, false, false);
  timeCloth("cloth 32x32, 10 substeps", &mut a);
  mut b = cloth(20u32, false, false);
  timeCloth("cloth 32x32, 20 substeps", &mut b);
  mut c = cloth(10u32, true, false);
  timeCloth("cloth 32x32, 10 substeps, sphere", &mut c);
  mut d = cloth(10u32, true, true);
  timeCloth("cloth 32x32, 10 substeps, sphere and self collision", &mut d);

  mut out = Mesh.empty();
  mut scratch = List[Vec3].empty();
  writeMesh(&a, &mut out, true, &mut scratch);
  imm t0 = Instant.now();
  mut s = 0;
  while s < 300 {
    writeMesh(&a, &mut out, true, &mut scratch);
    s = s + 1;
  }
  printStr("writeMesh, 32x32 double sided: ");
  printInt(t0.elapsed().nanos() / 300i64 / 1000i64);
  printStr(" us\n");

  mut pts = List[Vec3].empty();
  mut i = 0;
  while i <= 100 {
    pts.push(new Vec3(0.06 * f32.from(i), 0., 0.));
    i = i + 1;
  }
  mut rope = rope(pts.view(), 0.1, 1e-6, 1e-3, 0.01);
  rope.pin(0u32);
  rope.pin(100u32);
  rope.substeps = 20u32;
  s = 0;
  while s < 60 {
    rope.step(1. / 60., new Vec3(1., 0., 0.));
    s = s + 1;
  }
  imm t1 = Instant.now();
  s = 0;
  while s < 300 {
    rope.step(1. / 60., new Vec3(1., 0., 0.));
    s = s + 1;
  }
  printStr("rope, 100 links, 20 substeps: ");
  printInt(t1.elapsed().nanos() / 300i64 / 1000i64);
  printStr(" us per step\n");
  0i32;
}
