// shots: a flag on a pole in the wind, a cloth draped over a sphere, a rope
// bridge under a load, and a balloon envelope inflated, drawn offscreen on a
// real GPU: the bodies are stepped on the CPU, their meshes written into
// render's dynamic meshes (one 'writeDynamicMesh' a frame), and each scene read
// back as a frame.
//
//   congo run packages/xpbdsoftbody/examples/shots.cone
//   XPBD_SHOT=shot congo run packages/xpbdsoftbody/examples/shots.cone
//
// With XPBD_SHOT set to a prefix it writes <prefix>-flag.bmp, <prefix>-drape.bmp,
// <prefix>-bridge.bmp and <prefix>-balloon.bmp. It checks from the simulation
// and from the pixels: the flag's far edge is downwind of the pole and
// fluttering (its sideways travel), no draped particle is inside the sphere,
// the loaded bridge sags by the statics' amount, the envelope reached its
// volume, and in each frame the pixel at a point on the cloth is not the
// background's. It needs a GPU with Vulkan 1.3 and SDL3.dll; with the Vulkan
// SDK, validation is on and must say nothing. GPU_POWER_PREFERENCE=low-power
// picks an integrated GPU.
//
// Drawing, as render's own tests do: a Renderer, a DrawList of meshes and
// materials, a camera, one frame read back. The cloth is double sided
// (writeMesh's second set of vertices) because the lit pipeline culls back faces.

mod shots;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use Mesh;
import xpbdsoftbody use *;
import gpu use *;
import render use *;
import path use Path;

const W = 640u32;
const H = 480u32;

fn tube() Mesh {
  var m = Mesh.empty();
  let sides = 14usize;
  var k = 0usize;
  while k < sides {
    let a = 2. * pi * f32.from(k) / f32.from(sides);
    m.positions.push(new Vec3(cos(a), 0., sin(a)));
    m.normals.push(new Vec3(cos(a), 0., sin(a)));
    m.positions.push(new Vec3(cos(a), 1., sin(a)));
    m.normals.push(new Vec3(cos(a), 0., sin(a)));
    k = k + 1usize;
  }
  k = 0usize;
  while k < sides {
    let k1 = (k + 1usize) % sides;
    let v0 = u32.from(2usize * k);
    let v1 = u32.from(2usize * k + 1usize);
    let v2 = u32.from(2usize * k1 + 1usize);
    let v3 = u32.from(2usize * k1);
    m.indices.push(v0);
    m.indices.push(v2);
    m.indices.push(v1);
    m.indices.push(v0);
    m.indices.push(v3);
    m.indices.push(v2);
    k = k + 1usize;
  }
  m;
}

// a tube of radius r from a to b
fn limb(a Vec3, b Vec3, r f32) Mat4 {
  let d = b - a;
  Mat4.fromTrs(a, Quat.fromVectors(new Vec3(0., 1., 0.), d), new Vec3(r, d.length(), r));
}

fn ball(p Vec3, r f32) Mat4 { Mat4.fromTrs(p, Quat.identity(), new Vec3(r, r, r)); }

fn slab(center Vec3, size Vec3) Mat4 { Mat4.fromTrs(center, Quat.identity(), size); }

// the pixel at a world point, as (r, g, b)
fn pixelAt(p *u8, camera &Camera, world Vec3) (i32, i32, i32) {
  let vp = camera.projectionMatrix(f32.from(W) / f32.from(H)) * camera.viewMatrix();
  let ndc = vp.projectPoint(world);
  let px = usize.from((ndc.x + 1.) * 0.5 * f32.from(W));
  let py = usize.from((1. - ndc.y) * 0.5 * f32.from(H));
  let at = (py * usize.from(W) + px) * 4usize;
  (i32.from(*(p + at)), i32.from(*(p + at + 1usize)), i32.from(*(p + at + 2usize)));
}

fn save(prefix *u8, name &str, p *u8) bool {
  var file = String.empty();
  var i = 0usize;
  while *(prefix + i) != 0u8 { file.appendByte(*(prefix + i)); i = i + 1usize; }
  file.append("-");
  file.append(name);
  file.append(".bmp");
  let img = Image.fromTexels(p, i32.from(W), i32.from(H), false);
  if img.save(&Path.from(file.view())) { print <- "wrote "; printStr(file.view()); print <- "\n"; return true; }
  false;
}

fn main() i32 {
  var ok = true;
  var instance = Instance.create("xpbdsoftbody shots");
  if !instance.isValid() { print <- "FAIL: no Vulkan instance\n"; return 1i32; }
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  var device = adapter.requestDevice();
  if !device.isValid() { print <- "FAIL: no device\n"; return 1i32; }
  let target = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var color = device.createTexture(&target);
  let depthDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);
  var readback = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_FORMAT_DEPTH32_FLOAT);
  if !renderer.isValid() { print <- "FAIL: no renderer\n"; return 1i32; }

  let tubeMesh = renderer.addMesh(&mut device, &tube());
  let ballMesh = renderer.addMesh(&mut device, &Mesh.sphere(1., 24));
  let cubeMesh = renderer.addMesh(&mut device, &Mesh.cube(0.5));
  let grass = renderer.addMaterial(&mut device, &Material.plain(new Color(0.30, 0.42, 0.28, 1.)));
  let wood = renderer.addMaterial(&mut device, &Material.plain(new Color(0.45, 0.30, 0.18, 1.)));
  let redCloth = renderer.addMaterial(&mut device, &Material.shiny(new Color(0.80, 0.12, 0.10, 1.), 0.1, 16.));
  let blueCloth = renderer.addMaterial(&mut device, &Material.shiny(new Color(0.15, 0.30, 0.75, 1.), 0.1, 16.));
  let stone = renderer.addMaterial(&mut device, &Material.plain(new Color(0.62, 0.62, 0.60, 1.)));
  let rope = renderer.addMaterial(&mut device, &Material.plain(new Color(0.70, 0.60, 0.40, 1.)));
  let yellow = renderer.addMaterial(&mut device, &Material.shiny(new Color(0.90, 0.75, 0.15, 1.), 0.2, 24.));
  let sun = Light.directional(new Vec3(0.3, -0.6, -0.5).normalize(), Color.gray(1.8), Color.gray(0.5));
  let shot = libc.getenv("XPBD_SHOT");
  var scratch = List[Vec3].empty();

  // ================= the flag =================
  {
    var flag = clothGrid(new Vec3(0., 2.6, 0.), new Vec3(1.5, 0., 0.), new Vec3(0., -1., 0.), 30u32, 20u32, &Fabric.light());
    var j = 0u32;
    while j <= 20u32 {
      flag.pin(j * 31u32);
      j = j + 1u32;
    }
    flag.substeps = 10u32;
    flag.damping = 0.1;
    var s = 0;
    var zlo = 1e9;
    var zhi = -1e9;
    while s < 900 {
      flag.step(1. / 60., new Vec3(6., 0., 0.4));
      if s >= 450 {
        let z = (*flag.pos[30usize + 10usize * 31usize]).z;
        if z < zlo { zlo = z; }
        if z > zhi { zhi = z; }
      }
      s = s + 1;
    }
    let tip = *flag.pos[30usize + 10usize * 31usize];
    print <- "flag: far edge x "; print <- tip.x; print <- ", sideways travel "; print <- zhi - zlo; print <- " m over 7.5 s\n";
    if tip.x < 0.8 { print <- "FAIL: the flag is not downwind of its pole\n"; ok = false; }
    if zhi - zlo < 0.1 { print <- "FAIL: the flag is not fluttering\n"; ok = false; }
    var m = Mesh.empty();
    writeMesh(&flag, &mut m, true, &mut scratch);
    let h = renderer.addDynamicMesh(&mut device, u32.from(outputVertexCount(&flag, true)), u32.from(outputIndexCount(&flag, true)));
    if !renderer.writeDynamicMesh(&mut device, h, &m) { print <- "FAIL: the flag mesh did not fit\n"; ok = false; }
    var list = DrawList.empty();
    list.add(cubeMesh, grass, slab(new Vec3(0., -0.05, 0.), new Vec3(8., 0.1, 8.)));
    list.add(tubeMesh, wood, limb(new Vec3(0., 0., 0.), new Vec3(0., 3.0, 0.), 0.04));
    list.add(ballMesh, yellow, ball(new Vec3(0., 3.04, 0.), 0.07));
    list.add(h, redCloth, Mat4.identity());
    var camera = Camera.make();
    camera.lookAt(new Vec3(1.6, 2.0, 4.6), new Vec3(0.8, 2.0, 0.), new Vec3(0., 1., 0.));
    camera.background = new Color(0.55, 0.70, 0.90, 1.);
    var encoder = device.createCommandEncoder();
    renderer.render(&mut device, &mut encoder, &color, &depth, &camera, &sun, &list);
    encoder.copyTextureToBuffer(&color, &readback);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    let p = readback.mappedRange();
    let px = pixelAt(p, &camera, *flag.pos[15usize + 10usize * 31usize]);
    print <- "flag: pixel on the cloth "; print <- px.0; print <- ", "; print <- px.1; print <- ", "; print <- px.2; print <- "\n";
    if px.0 < 120 or px.2 > 140 { print <- "FAIL: the cloth's pixel is not the red cloth's\n"; ok = false; }
    if (shot as usize) != 0usize { if !save(shot,"flag", p) { ok = false; } }
    renderer.removeMesh(&mut device, h);
  }

  // ================= the drape =================
  {
    let c = new Vec3(0., 0.5, 0.);
    var fabric = Fabric.heavy();
    fabric.bend = 3000.;    // a soft, limp cloth
    var cloth = clothGrid(new Vec3(-0.65, 1.1, -0.65), new Vec3(1.3, 0., 0.), new Vec3(0., 0., 1.3), 36u32, 36u32, &fabric);
    cloth.addCollider(Collider.sphere(c, 0.4));
    cloth.addCollider(Collider.plane(new Vec3(0., 0., 0.), new Vec3(0., 1., 0.)));
    cloth.substeps = 10u32;
    cloth.damping = 1.;
    cloth.strainLimit = 0.01;
    cloth.friction = 0.6;
    var s = 0;
    while s < 500 {
      cloth.step(1. / 60., new Vec3(0., 0., 0.));
      s = s + 1;
    }
    var inside = 0;
    var i = 0usize;
    while i < cloth.pos.len() {
      if (*cloth.pos[i] - c).length() < 0.4 - 0.001 { inside = inside + 1; }
      i = i + 1usize;
    }
    print <- "drape: particles inside the sphere: "; print <- inside; print <- " of "; print <- i64.from(cloth.pos.len()); print <- "\n";
    if inside != 0 { print <- "FAIL: cloth inside the sphere\n"; ok = false; }
    var m = Mesh.empty();
    writeMesh(&cloth, &mut m, true, &mut scratch);
    let h = renderer.addDynamicMesh(&mut device, u32.from(outputVertexCount(&cloth, true)), u32.from(outputIndexCount(&cloth, true)));
    if !renderer.writeDynamicMesh(&mut device, h, &m) { print <- "FAIL: the cloth mesh did not fit\n"; ok = false; }
    var list = DrawList.empty();
    list.add(cubeMesh, grass, slab(new Vec3(0., -0.05, 0.), new Vec3(6., 0.1, 6.)));
    list.add(ballMesh, stone, ball(c, 0.4));
    list.add(h, blueCloth, Mat4.identity());
    var camera = Camera.make();
    camera.lookAt(new Vec3(1.6, 1.5, 2.2), new Vec3(0., 0.4, 0.), new Vec3(0., 1., 0.));
    camera.background = new Color(0.55, 0.70, 0.90, 1.);
    var encoder = device.createCommandEncoder();
    renderer.render(&mut device, &mut encoder, &color, &depth, &camera, &sun, &list);
    encoder.copyTextureToBuffer(&color, &readback);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    let p = readback.mappedRange();
    let px = pixelAt(p, &camera, *cloth.pos[18usize * 37usize + 18usize]);
    print <- "drape: pixel on the cloth over the sphere's top "; print <- px.0; print <- ", "; print <- px.1; print <- ", "; print <- px.2; print <- "\n";
    if px.2 < 90 or px.0 > 150 { print <- "FAIL: the cloth's pixel is not the blue cloth's\n"; ok = false; }
    if (shot as usize) != 0usize { if !save(shot,"drape", p) { ok = false; } }
    renderer.removeMesh(&mut device, h);
  }

  // ================= the rope bridge =================
  {
    let n = 24u32;
    var pts = List[Vec3].empty();
    var i = 0u32;
    while i <= n {
      let t = f32.from(i) / f32.from(n);
      pts.push(new Vec3(-2.75 + 5.5 * t, 2.0 - 1.2 * (1. - libc.fabsf(2. * t - 1.)), 0.));
      i = i + 1u32;
    }
    var r = chain(pts.view(), 0.1, 1e-7, 0.02);
    var k = 0usize;
    while k < r.dist.len() {
      r.dist[k].rest = 6. / f32.from(n);
      k = k + 1usize;
    }
    r.pin(0u32);
    r.pin(n);
    r.mass.set(12usize, 20.);
    r.invMass.set(12usize, 0.05);
    r.substeps = 30u32;
    r.iterations = 2u32;
    r.damping = 3.;
    var s = 0;
    while s < 500 {
      r.step(1. / 60., new Vec3(0., 0., 0.));
      s = s + 1;
    }
    let sag = 2.0 - (*r.pos[12usize]).y;
    print <- "bridge: the 20 kg load sank "; print <- sag; print <- " m (statics for a weightless rope: 1.199)\n";
    if libc.fabsf(sag - 1.199) > 0.07 { print <- "FAIL: the bridge's sag is off the statics\n"; ok = false; }
    var m = Mesh.empty();
    writeTube(&r, &mut m, 0.03, 8u32);
    let h = renderer.addDynamicMesh(&mut device, u32.from(m.positions.len()), u32.from(m.indices.len()));
    if !renderer.writeDynamicMesh(&mut device, h, &m) { print <- "FAIL: the rope mesh did not fit\n"; ok = false; }
    var list = DrawList.empty();
    list.add(cubeMesh, grass, slab(new Vec3(0., -0.55, 0.), new Vec3(9., 0.1, 4.)));
    list.add(cubeMesh, wood, slab(new Vec3(-2.9, 0.9, 0.), new Vec3(0.3, 2.9, 0.4)));
    list.add(cubeMesh, wood, slab(new Vec3(2.9, 0.9, 0.), new Vec3(0.3, 2.9, 0.4)));
    list.add(h, rope, Mat4.identity());
    list.add(cubeMesh, stone, slab(*r.pos[12usize] + new Vec3(0., -0.15, 0.), new Vec3(0.3, 0.3, 0.3)));
    var camera = Camera.make();
    camera.lookAt(new Vec3(0., 1.6, 7.5), new Vec3(0., 1.2, 0.), new Vec3(0., 1., 0.));
    camera.background = new Color(0.55, 0.70, 0.90, 1.);
    var encoder = device.createCommandEncoder();
    renderer.render(&mut device, &mut encoder, &color, &depth, &camera, &sun, &list);
    encoder.copyTextureToBuffer(&color, &readback);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    let p = readback.mappedRange();
    let px = pixelAt(p, &camera, *r.pos[6usize]);
    print <- "bridge: pixel on the rope "; print <- px.0; print <- ", "; print <- px.1; print <- ", "; print <- px.2; print <- "\n";
    if px.2 > 150 and px.0 < 150 { print <- "FAIL: the rope's pixel is the sky's\n"; ok = false; }
    if (shot as usize) != 0usize { if !save(shot,"bridge", p) { ok = false; } }
    renderer.removeMesh(&mut device, h);
  }

  // ================= the balloon envelope =================
  {
    let pattern = Mesh.sphere(0.6, 24);
    var b = pressureBody(&pattern, &Fabric.heavy(), 1., 1., 1e-7);
    b.gravity = new Vec3(0., 0., 0.);
    b.iterations = 3u32;
    b.damping = 2.;
    b.airDensity = 0.;
    let grow = libc.powf(1.6666667, 1. / 200.);
    var s = 0;
    while s < 500 {
      if s < 200 { b.scaleRest(grow); }
      b.step(1. / 60., new Vec3(0., 0., 0.));
      s = s + 1;
    }
    let ratio = b.volume() / b.pressure.restVolume;
    print <- "balloon: volume "; print <- b.volume(); print <- " m3, "; print <- ratio; print <- " of the target\n";
    if libc.fabsf(ratio - 1.) > 0.03 { print <- "FAIL: the envelope did not reach its volume\n"; ok = false; }
    var m = Mesh.empty();
    writeMesh(&b, &mut m, false, &mut scratch);
    let h = renderer.addDynamicMesh(&mut device, u32.from(m.positions.len()), u32.from(m.indices.len()));
    if !renderer.writeDynamicMesh(&mut device, h, &m) { print <- "FAIL: the envelope mesh did not fit\n"; ok = false; }
    var list = DrawList.empty();
    list.add(cubeMesh, grass, slab(new Vec3(0., -1.1, 0.), new Vec3(8., 0.1, 8.)));
    list.add(h, yellow, Mat4.identity());
    var camera = Camera.make();
    camera.lookAt(new Vec3(2.5, 1.2, 4.2), new Vec3(0., 0., 0.), new Vec3(0., 1., 0.));
    camera.background = new Color(0.55, 0.70, 0.90, 1.);
    var encoder = device.createCommandEncoder();
    renderer.render(&mut device, &mut encoder, &color, &depth, &camera, &sun, &list);
    encoder.copyTextureToBuffer(&color, &readback);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    let p = readback.mappedRange();
    let px = pixelAt(p, &camera, new Vec3(0., 0., 0.));
    print <- "balloon: pixel at the centre "; print <- px.0; print <- ", "; print <- px.1; print <- ", "; print <- px.2; print <- "\n";
    if px.0 < 100 { print <- "FAIL: the envelope's pixel is not the yellow's\n"; ok = false; }
    if (shot as usize) != 0usize { if !save(shot,"balloon", p) { ok = false; } }
  }

  if failures() != 0u32 { print <- "FAIL: a Vulkan call failed\n"; ok = false; }
  if validationMessages() != 0u32 { print <- "FAIL: validation messages\n"; ok = false; }
  if ok { print <- "ok\n"; return 0i32; }
  1i32;
}
