// The cost of a banner: a cloth hung by its left edge from a pole, in a steady wind, stepped
// 1/60 s at a time. Each line is a configuration of the solver and, over 300 steps after 60 of
// warm-up, the median, the fastest and the 95th-percentile time of a step, in microseconds, with
// the cloth's state after them: its far corner (a finite place, or the run is meaningless) and its
// worst stretch (a fraction of the rest length).
//
//   congo run --release packages/xpbdsoftbody/examples/banner.cone
//
// A banner of 64 x 64 squares (4,225 particles, 12,416 stretch and 12,160 bending constraints,
// 8,192 triangles) is the cost a scene's flag or sail can ask for; 32 x 32 is the size the
// package was first measured at (5.5 ms on 12 Oct, one thread, dihedral bending, 10 substeps).
// The tuned lines are the ones a banner should use: 4 substeps, bending by the curvature model,
// long range tethers to hold its stretch, and threads. (Times depend on what else the machine
// is doing; the fastest of the steps is the least disturbed.)

mod bannerbench;

import stdio use *;
import time use Instant;
import collections use *;
import geomath use *;
import xpbdsoftbody use *;

fn banner(n u32, substeps u32, curvature bool, tethers bool) SoftBody {
  var c = clothGrid(new Vec3(0., 3., 0.), new Vec3(2., 0., 0.), new Vec3(0., -2., 0.), n, n, &Fabric.light());
  var i = 0u32;
  while i <= n { c.pin(i * (n + 1u32)); i = i + 1u32; }
  if curvature { c.useCurvatureBending(); }
  if tethers {
    addTethers(&mut c, 1.02);
    c.strainLimit = 0.05;
  }
  c.substeps = substeps;
  c;
}

fn sortInto(v &mut List[i64]) {
  var i = 1usize;
  while i < v.len() {
    let x = *v[i];
    var j = i;
    while j > 0usize and *v[j - 1usize] > x {
      v.set(j, *v[j - 1usize]);
      j = j - 1usize;
    }
    v.set(j, x);
    i = i + 1usize;
  }
}

fn worstStretch(b &SoftBody) f32 {
  var worst = 0.;
  var k = 0usize;
  while k < b.dist.len() {
    let c = *b.dist[k];
    let s = ((*b.pos[usize.from(c.a)] - *b.pos[usize.from(c.b)]).length() - c.rest) / c.rest;
    if s > worst { worst = s; }
    k = k + 1usize;
  }
  worst;
}

fn timeIt(label &str, c &mut SoftBody, workers &mut Workers) {
  var s = 0;
  while s < 60 { c.stepPool(workers, 1. / 60., new Vec3(4., 0., 0.5)); s = s + 1; }
  var times = List[i64].empty();
  s = 0;
  while s < 300 {
    let t0 = Instant.now();
    c.stepPool(workers, 1. / 60., new Vec3(4., 0., 0.5));
    times.push(t0.elapsed().nanos() / 1000i64);
    s = s + 1;
  }
  sortInto(&mut times);
  let tip = *c.pos[c.pos.len() - 1usize];
  printStr(label); printStr(": p50 "); printInt(*times[150usize]); printStr(" us, min "); printInt(*times[0usize]);
  printStr(", p95 "); printInt(*times[285usize]);
  print <- "   [far corner "; print <- tip.x; print <- " "; print <- tip.y; print <- " "; print <- tip.z;
  print <- ", worst stretch "; print <- worstStretch(c); print <- "]\n";
}

fn main() i32 {
  var none = Workers.none();
  var a = banner(32u32, 10u32, false, false);
  timeIt("32x32, 10 substeps, dihedral, 1 thread            ", &mut a, &mut none);
  var b = banner(64u32, 10u32, false, false);
  timeIt("64x64, 10 substeps, dihedral, 1 thread            ", &mut b, &mut none);
  var c = banner(64u32, 4u32, false, true);
  timeIt("64x64, 4 substeps, dihedral, tethers, 1 thread    ", &mut c, &mut none);
  var d = banner(64u32, 4u32, true, true);
  timeIt("64x64, 4 substeps, curvature, tethers, 1 thread   ", &mut d, &mut none);
  var w2 = Workers.make(2u32);
  var e = banner(64u32, 4u32, true, true);
  timeIt("64x64, 4 substeps, curvature, tethers, 2 threads  ", &mut e, &mut w2);
  var w4 = Workers.make(4u32);
  var f = banner(64u32, 4u32, true, true);
  timeIt("64x64, 4 substeps, curvature, tethers, 4 threads  ", &mut f, &mut w4);
  var w6 = Workers.make(6u32);
  var g = banner(64u32, 4u32, true, true);
  timeIt("64x64, 4 substeps, curvature, tethers, 6 threads  ", &mut g, &mut w6);
  var h = banner(64u32, 10u32, true, true);
  timeIt("64x64, 10 substeps, curvature, tethers, 4 threads ", &mut h, &mut w4);
  // over-relaxation of the stretch projections, on the 4-thread, 4-substep banner
  var om = 1.2;
  while om < 1.9 {
    var r = banner(64u32, 4u32, true, true);
    r.relaxation = om;
    print <- "relaxation "; print <- om; print <- ": ";
    timeIt("64x64, 4 substeps, curvature, tethers, 4 threads  ", &mut r, &mut w4);
    om = om + 0.2;
  }
  w2.stop();
  w4.stop();
  w6.stop();
  0i32;
}
