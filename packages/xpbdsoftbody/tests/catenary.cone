// A rope hung between two pins settles to a catenary.
//
// The formula (independent of the simulation): a uniform inextensible rope of
// length L hung between two points s apart at one height hangs as
//   y(x) = y0 + a (cosh((x - s/2) / a) - cosh(s / (2a))),
// where a solves L = 2 a sinh(s / (2a)). Here s = 3 and L = 4, so a = 0.8..; the
// lowest point is a (1 - cosh(s/2a)) below the pins, about 1.1 m. The rope has
// 40 links; the chain's own sag differs from the continuous curve by O(1/N^2).
// Also a chain (no bend constraint) hangs the same, and a rope's far end swings
// when the near end is carried by a moving anchor.

mod catenary;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import xpbdsoftbody use *;

fn cosh(x f32) f32 {0.5 * (libc.expf(x) + libc.expf(-x))}
fn sinh(x f32) f32 {0.5 * (libc.expf(x) - libc.expf(-x))}

// a with 2 a sinh(s / 2a) = len, by bisection
fn catenaryA(s f32, len f32) f32 {
  var lo = 0.05;
  var hi = 50.;
  var k = 0;
  while k < 80 {
    let mid = 0.5 * (lo + hi);
    // 2 a sinh(s/2a) falls from large to s as a grows
    if 2. * mid * sinh(s / (2. * mid)) > len { lo = mid; } else { hi = mid; }
    k = k + 1;
  }
  0.5 * (lo + hi)
}

fn sagged(n u32, span f32, height f32) List[Vec3] {
  var pts = List[Vec3].empty();
  var i = 0u32;
  while i <= n {
    let t = f32.from(i) / f32.from(n);
    pts.push(new Vec3(span * t, height - 4. * t * (1. - t) * 1.2, 0.));
    i = i + 1u32;
  }
  pts
}

fn main() i32 {
  let n = 40u32;
  let span = 3.;
  // lay the 40 links 0.1 m each along a bowed line (length about 4.0), then pin the ends
  var pts = List[Vec3].empty();
  var i = 0u32;
  while i <= n {
    pts.push(new Vec3(0.1 * f32.from(i), 2., 0.));
    i = i + 1u32;
  }
  var rope = chain(pts.view(), 0.5, 1e-9, 0.01);
  expectInt(i64.from(rope.particleCount()), 41i64, "41 particles");
  let bowed = sagged(n, span, 2.);
  i = 0u32;
  while i <= n {
    rope.pos.set(usize.from(i), *bowed[usize.from(i)]);
    i = i + 1u32;
  }
  rope.pin(0u32);
  rope.pin(n);
  rope.substeps = 20u32;
  rope.damping = 3.;
  rope.thickness = 0.001;
  var s = 0;
  while s < 900 {
    rope.step(1. / 60., new Vec3(0., 0., 0.));
    s = s + 1;
  }
  // total length and the catenary
  var len = 0.;
  i = 0u32;
  while i < n {
    len = len + (*rope.pos[usize.from(i + 1u32)] - *rope.pos[usize.from(i)]).length();
    i = i + 1u32;
  }
  expectFloat(f64.from(len), 4.0, 0.01, "total length stays 4.0 within 0.01 (stretch under 0.25%)");
  let a = catenaryA(span, len);
  var worst = 0.;
  i = 0u32;
  while i <= n {
    let p = *rope.pos[usize.from(i)];
    let want = 2. + a * (cosh((p.x - 0.5 * span) / a) - cosh(span / (2. * a)));
    let e = libc.fabsf(p.y - want);
    if e > worst { worst = e; }
    i = i + 1u32;
  }
  expectFloat(f64.from(worst), 0.0, 0.004, "every particle within 4 mm of the catenary");
  let lowest = a * (1. - cosh(span / (2. * a)));
  expectFloat(f64.from((*rope.pos[20usize]).y - 2.), f64.from(lowest), 0.002, "midpoint sag matches the formula within 2 mm");
  expectFloat(f64.from(rope.kineticEnergy()), 0.0, 0.0001, "at rest");
  done()
}
