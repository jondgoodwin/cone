// The analytic gradients against central finite differences, and the dihedral
// angle against angles worked out by hand.
//
// Two triangles on the edge a = (0,0,0), b = (1,0,0) with wings c above the edge
// in y (c = (0.5, 1, 0)) and d below (d = (0.5, -1, 0)): flat, angle 0. Lift both
// wings by raising them out of the plane (z = +h, the same direction) and the
// surface folds one way: the angle is atan2(...) = -atan(h / 1) for each wing
// lifted by h at unit height, so at h = 1 each wing is 45 degrees up and the
// angle between the normals is -90 degrees: -pi/2.

mod gradients;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import xpbdsoftbody use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

fn angleAt(p &Array[Vec3]) f32 {dihedralAngle(p[0usize], p[1usize], p[2usize], p[3usize]);}

fn dot3(a Vec3, b Vec3) f32 {a.dot(b);}

fn gradientCheck(a Vec3, b Vec3, c Vec3, d Vec3, label &Array[u8]) {
  imm g = dihedralGradient(a, b, c, d);
  imm grads = [g.ga, g.gb, g.gc, g.gd];
  imm base = [a, b, c, d];
  imm eps = 0.001;
  mut worst = 0.;
  mut i = 0usize;
  while i < 4usize {
    mut axis = 0;
    while axis < 3 {
      mut up = [base[0usize], base[1usize], base[2usize], base[3usize]];
      mut dn = [base[0usize], base[1usize], base[2usize], base[3usize]];
      imm dir = if axis == 0 {new Vec3(eps, 0., 0.);} elif axis == 1 {new Vec3(0., eps, 0.);} else {new Vec3(0., 0., eps);};
      up[i] = base[i] + dir;
      dn[i] = base[i] - dir;
      imm fd = (angleAt(&up) - angleAt(&dn)) / (2. * eps);
      imm an = if axis == 0 {grads[i].x;} elif axis == 1 {grads[i].y;} else {grads[i].z;};
      imm e = libc.fabsf(fd - an);
      if e > worst { worst = e; }
      axis = axis + 1;
    }
    i = i + 1usize;
  }
  near(worst, 0., 0.01, label);
}

fn main() i32 {
  imm a = new Vec3(0., 0., 0.);
  imm b = new Vec3(1., 0., 0.);
  near(dihedralAngle(a, b, new Vec3(0.5, 1., 0.), new Vec3(0.5, -1., 0.)), 0., 0.00001, "flat is 0");
  near(dihedralAngle(a, b, new Vec3(0.5, 1., 1.), new Vec3(0.5, -1., 1.)), -pi / 2., 0.0001, "both wings 45 degrees up is -pi/2");
  near(dihedralAngle(a, b, new Vec3(0.5, 1., -1.), new Vec3(0.5, -1., -1.)), pi / 2., 0.0001, "the other way is +pi/2");
  near(dihedralAngle(a, b, new Vec3(0.5, 1., 0.), new Vec3(0.5, -1., 0.5)), -0.4636476, 0.0001, "one wing 0.5 up: -atan(0.5)");

  gradientCheck(a, b, new Vec3(0.5, 1., 0.), new Vec3(0.5, -1., 0.), "bend gradient, flat");
  gradientCheck(a, b, new Vec3(0.4, 0.9, 0.3), new Vec3(0.7, -1.1, 0.2), "bend gradient, a mild fold");
  gradientCheck(new Vec3(0.1, 0.2, -0.1), new Vec3(1.2, 0.1, 0.3), new Vec3(0.5, 0.9, 0.8), new Vec3(0.3, -0.7, 0.9),
    "bend gradient, skew edge");
  gradientCheck(a, b, new Vec3(0.5, 1., 1.), new Vec3(0.5, -1., 1.), "bend gradient, 90 degree fold");

  // the gradient sums to zero (translation invariance) and has no torque about the edge
  imm g = dihedralGradient(new Vec3(0.1, 0.2, -0.1), new Vec3(1.2, 0.1, 0.3), new Vec3(0.5, 0.9, 0.8), new Vec3(0.3, -0.7, 0.9));
  imm total = g.ga + g.gb + g.gc + g.gd;
  near(total.length(), 0., 0.00001, "gradient sums to zero");

  // volume of a tetrahedron (0,0,0),(1,0,0),(0,1,0),(0,0,1) wound outward: 1/6
  mut pos = List[Vec3].empty();
  pos.push(new Vec3(0., 0., 0.));
  pos.push(new Vec3(1., 0., 0.));
  pos.push(new Vec3(0., 1., 0.));
  pos.push(new Vec3(0., 0., 1.));
  mut tris = List[u32].empty();
  imm ix = [0u32, 2u32, 1u32,  0u32, 1u32, 3u32,  0u32, 3u32, 2u32,  1u32, 2u32, 3u32];
  mut k = 0usize;
  while k < 12usize {
    tris.push(ix[k]);
    k = k + 1usize;
  }
  near(meshVolume(pos.view(), tris.view()), 1. / 6., 0.00001, "tetrahedron volume is 1/6");
  done();
}
