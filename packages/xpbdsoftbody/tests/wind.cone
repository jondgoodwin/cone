// Wind on a triangle: drag along the flow and lift across it, against the
// force worked out by hand.
//
// One triangle of area 0.5 m2, three particles of 0.1 kg (0.3 kg), no gravity,
// air density 1.2, in a wind of 10 m/s along +z. The dynamic pressure times
// area is q = 1/2 * 1.2 * 100 * 0.5 = 30 N.
//
//  - Facing the wind squarely (normal along z): sin(alpha) = 1, drag
//    q (Cf + Cd) = 30 * 1.02 = 30.6 N, and no lift (cos(alpha) = 0): the whole
//    push is along z, an acceleration of 102 m/s2.
//  - Tilted 45 degrees (normal (.7071, 0, .7071)): drag q (Cf + Cd sin 45) =
//    30 * 0.72711 along z, lift q Cl 2 sin 45 cos 45 = 30 along x, away from
//    the face the wind meets (the plate's windward face looks towards -x, -z).
//  - Edge on (normal along x): sin(alpha) = 0: only skin friction, q Cf = 0.6 N.
// The step is a single substep of 1 ms, so the force is that of the moment the
// plate starts to move (the speeds are read off positions, which f32 holds to
// 6e-8 m: a 1 ms step resolves them to 6e-5 m/s).

mod wind;

import testing use *;
import collections use *;
import geomath use *;
import xpbdsoftbody use *;

fn plate(normal Vec3) SoftBody {
  // two edges in the plane, so that e1 x e2 = normal
  imm up = if normal.dot(new Vec3(0., 1., 0.)) > 0.9 {new Vec3(1., 0., 0.);} else {new Vec3(0., 1., 0.);};
  imm e1 = up - normal * up.dot(normal);
  imm e1u = e1.normalize();
  imm e2 = normal.cross(e1u);
  // area 0.5: legs of length 1 along e1u and e2: e1u x e2 = e1u x (n x e1u) = n
  mut b = SoftBody.empty();
  b.addParticle(new Vec3(0., 0., 0.), 0.1);
  b.addParticle(e1u, 0.1);
  b.addParticle(e2, 0.1);
  b.tris.push(0u32);
  b.tris.push(1u32);
  b.tris.push(2u32);
  b.gravity = new Vec3(0., 0., 0.);
  b.damping = 0.;
  b.substeps = 1u32;
  b;
}

fn push(b &mut SoftBody) Vec3 {
  b.step(0.001, new Vec3(0., 0., 10.));
  // the mean velocity of the three particles is the plate's; times 0.3 kg over dt is the force
  imm v = (*b.vel[0usize] + *b.vel[1usize] + *b.vel[2usize]) * (1. / 3.);
  v * (0.3 / 0.001);
}

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

fn main() i32 {
  mut square = plate(new Vec3(0., 0., 1.));
  imm f0 = push(&mut square);
  near(f0.z, 30.6, 0.1, "facing the wind: drag q (Cf + Cd) = 30.6 N");
  near(f0.x, 0., 0.01, "and no lift: x");
  near(f0.y, 0., 0.01, "y");

  mut tilted = plate(new Vec3(0.70710678, 0., 0.70710678));
  imm f1 = push(&mut tilted);
  near(f1.z, 30. * (0.02 + 0.70710678), 0.1, "tilted 45 degrees: drag along the wind");
  near(f1.x, 30., 0.1, "lift across it, q Cl sin(2 alpha) = 30 N, away from the windward face");
  near(f1.y, 0., 0.01, "and none sideways");

  // the same plate seen from behind is pushed the same way: the face the wind meets is the windward one
  mut behind = plate(new Vec3(-0.70710678, 0., -0.70710678));
  imm f2 = push(&mut behind);
  near(f2.z, 30. * (0.02 + 0.70710678), 0.1, "turned over: the same drag");
  near(f2.x, 30., 0.1, "and the same lift, still away from the face the wind meets");

  mut edge = plate(new Vec3(1., 0., 0.));
  imm f3 = push(&mut edge);
  near(f3.z, 0.6, 0.02, "edge on: only skin friction, q Cf = 0.6 N");
  near(f3.x, 0., 0.01, "no lift when the plate is along the flow");

  // zero coefficients, zero wind force
  mut off = plate(new Vec3(0., 0., 1.));
  off.dragCoeff = 0.;
  off.skinCoeff = 0.;
  off.liftCoeff = 0.;
  imm f4 = push(&mut off);
  near(f4.length(), 0., 0.001, "coefficients of zero give no force");

  // a wind that moves with the plate pushes nothing: relative velocity counts
  mut moving = plate(new Vec3(0., 0., 1.));
  moving.vel.set(0usize, new Vec3(0., 0., 10.));
  moving.vel.set(1usize, new Vec3(0., 0., 10.));
  moving.vel.set(2usize, new Vec3(0., 0., 10.));
  moving.step(0.001, new Vec3(0., 0., 10.));
  near((*moving.vel[0usize]).z, 10., 0.001, "a plate already moving with the wind is not pushed");
  done();
}
