// A pressure body inflates to its target volume.
//
// A UV sphere of radius 0.6 (mesh.Mesh.sphere, 16 segments, with its seam and
// poles duplicated: welding makes it a closed mesh of 226 particles) is made a
// soft body whose fabric is cut for radius 1 (restScale = 1/0.6) and filled to
// the volume of that pattern. In no gravity it must grow to radius 1: volume
// 4/3 pi (the tessellated sphere's own volume, scaled), every particle about
// 1 m from the centre, and the welded mesh must have kept its topology.

mod pressure;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import mesh use Mesh;
import xpbdsoftbody use *;

fn radiusSpread(b &SoftBody) (f32, f32, f32) {
  var c = new Vec3(0., 0., 0.);
  var i = 0usize;
  while i < b.pos.len() {
    c = c + *b.pos[i];
    i = i + 1usize;
  }
  c = c * (1. / f32.from(b.pos.len()));
  var lo = 1e9;
  var hi = 0.;
  var sum = 0.;
  i = 0usize;
  while i < b.pos.len() {
    let r = (*b.pos[i] - c).length();
    if r < lo { lo = r; }
    if r > hi { hi = r; }
    sum = sum + r;
    i = i + 1usize;
  }
  (lo, hi, sum / f32.from(b.pos.len()));
}

fn main() i32 {
  let m = Mesh.sphere(0.6, 16);
  var b = pressureBody(&m, &Fabric.heavy(), 1., 1., 1e-7);
  expectInt(i64.from(b.particleCount()), 242i64, "seam and pole copies welded: 15 rings of 16 plus two poles");
  expectInt(i64.from(b.vertexMap.len()), i64.from(m.positions.len()), "the output keeps the mesh's own vertices");
  let v0 = b.volume();
  let target = v0 * 1.6666667 * 1.6666667 * 1.6666667;
  // a closed mesh: every edge has two triangles, so Euler's formula holds: V - E + F = 2
  expectInt(i64.from(b.particleCount()) - i64.from(b.dist.len()) + i64.from(b.tris.len() / 3usize), 2i64, "welded mesh is a closed sphere: V - E + F = 2");
  b.gravity = new Vec3(0., 0., 0.);
  b.substeps = 10u32;
  b.iterations = 3u32;
  b.damping = 2.;
  // inflate: the fabric grows to 1/0.6 of its size over 200 steps, then rests for 400
  let grow = libc.powf(1.6666667, 1. / 200.);
  var s = 0;
  while s < 600 {
    if s < 200 { b.scaleRest(grow); }
    b.step(1. / 60., new Vec3(0., 0., 0.));
    s = s + 1;
  }
  expectFloat(f64.from(b.pressure.restVolume), f64.from(target), 0.01, "the target is the pattern's volume");
  let v = b.volume();
  expectFloat(f64.from(v / target), 1.0, 0.03, "inflated to within 3% of the target volume");
  let sp = radiusSpread(&b);
  expectFloat(f64.from(sp.2), 1.0, 0.03, "mean radius about 1 m (the pattern's)");
  expectFloat(f64.from(sp.0), 1.0, 0.08, "no particle far inside");
  expectFloat(f64.from(sp.1), 1.0, 0.08, "none far out");
  expectFloat(f64.from(b.kineticEnergy()), 0.0, 0.3, "settled (a pressure body wants 2 or 3 iterations: with one the stiff fabric and the volume constraint leave a small ripple)");

  // half the pressure: smaller, and lighter than the full pattern
  var half = pressureBody(&m, &Fabric.heavy(), 1., 1., 1e-7);
  half.gravity = new Vec3(0., 0., 0.);
  half.iterations = 3u32;
  half.damping = 2.;
  s = 0;
  while s < 600 {
    if s < 200 { half.scaleRest(grow); }
    if s == 200 { half.pressure.target = 0.5; }
    half.step(1. / 60., new Vec3(0., 0., 0.));
    s = s + 1;
  }
  expectFloat(f64.from(half.volume() / (target * 0.5)), 1.0, 0.05, "pressure 0.5 gives half the volume");
  done();
}
