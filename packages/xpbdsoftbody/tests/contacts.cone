// Contacts: a particle dropped on each kind of shape comes to rest one
// thickness off its surface; friction holds a particle on a slope or lets it
// slide; self collision keeps a rope's far parts apart.
//
// Every body here is one particle of 0.01 kg with a thickness of 0.02 m, so
// the surface distance at rest is worked out by hand from the shape.

mod contacts;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import xpbdsoftbody use *;

fn near(got: f32, want: f32, within: f32, label: &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label)
}

fn drop(at: Vec3) SoftBody {
  var b = SoftBody.empty();
  b.addParticle(at, 0.01);
  b.thickness = 0.02;
  b.damping = 1.;
  b
}

fn settle(b: &mut SoftBody, steps: i32) {
  var s = 0;
  while s < steps {
    b.step(1. / 60., new Vec3(0., 0., 0.));
    s = s + 1;
  }
}

// a unit sphere at (2, 0, 0): the field is its distance, the normal outward
fn sphereField(p: Vec3) Vec4 {
  let d = p - new Vec3(2., 0., 0.);
  let len = d.length();
  let n = d * (1. / len);
  new Vec4(n.x, n.y, n.z, len - 0.3)
}

fn shapes() {
  // sphere radius 0.5 at the origin: rests at 0.5 + 0.02 above its top
  var b = drop(new Vec3(0.01, 1., 0.));
  b.addCollider(Collider.sphere(new Vec3(0., 0., 0.), 0.5));
  settle(&mut b, 240);
  near((*b.pos[0usize]).length(), 0.52, 0.001, "sphere: rests at radius + thickness from the centre");

  // a capsule from (-1,0,0) to (1,0,0), radius 0.2: above the middle it rests at 0.22 over the axis
  var c = drop(new Vec3(0.3, 1., 0.));
  c.addCollider(Collider.capsule(new Vec3(-1., 0., 0.), new Vec3(1., 0., 0.), 0.2));
  settle(&mut c, 240);
  near((*c.pos[0usize]).y, 0.22, 0.001, "capsule: rests at radius + thickness over the axis");
  // beyond its end it rounds off: a particle dropped over the end cap (x = 1.1) rests on the cap
  var e = drop(new Vec3(1.05, 1., 0.));
  e.friction = 5.;
  e.addCollider(Collider.capsule(new Vec3(-1., 0., 0.), new Vec3(1., 0., 0.), 0.2));
  settle(&mut e, 240);
  near((*e.pos[0usize] - new Vec3(1., 0., 0.)).length(), 0.22, 0.001, "capsule: the end cap is a hemisphere");

  // a box 1 x 0.4 x 1 centred at the origin turned 30 degrees about z: its top face
  // tilts, the particle comes to rest 0.02 off that face (friction is high, it stays put)
  let turn = Quat.angleAxis(radians(30.), new Vec3(0., 0., 1.));
  var x = drop(new Vec3(0., 1., 0.));
  x.friction = 5.;
  x.addCollider(Collider.box(new Vec3(0., 0., 0.), new Vec3(0.5, 0.2, 0.5), turn));
  settle(&mut x, 240);
  let up = turn * new Vec3(0., 1., 0.);
  near((*x.pos[0usize]).dot(up), 0.2 + 0.02, 0.002, "box: rests 0.02 off the turned top face");

  // a plane
  var p = drop(new Vec3(3., 2., 3.));
  p.addCollider(Collider.plane(new Vec3(0., 0.5, 0.), new Vec3(0., 1., 0.)));
  settle(&mut p, 240);
  near((*p.pos[0usize]).y, 0.52, 0.0005, "plane: rests at the plane + thickness");

  // a heightfield: a ramp rising 0.5 per metre in x, on a 9 x 9 grid of 0.5 m cells
  var h = List[f32].empty();
  var iz = 0;
  while iz < 9 {
    var ix = 0;
    while ix < 9 {
      h.push(0.5 * 0.5 * f32.from(ix));
      ix = ix + 1;
    }
    iz = iz + 1;
  }
  var g = drop(new Vec3(1., 2., 2.));
  g.friction = 5.;
  g.addHeightfield(new Heightfield(0., 0., 0.5, 9u32, 9u32, h));
  settle(&mut g, 240);
  // the surface y = 0.5 x has unit normal (-0.5, 1, 0)/sqrt(1.25): 0.02 off it, vertically 0.02 * sqrt(1.25)
  let q = *g.pos[0usize];
  near(q.y - 0.5 * q.x, 0.02 * 1.1180340, 0.002, "heightfield: rests 0.02 off the ramp, measured along its normal");

  // a field closure: the unit-ish sphere at (2, 0, 0) radius 0.3
  var f = drop(new Vec3(2.01, 1., 0.));
  f.stepWith(1. / 60., new Vec3(0., 0., 0.), &sphereField);
  var s = 0;
  while s < 240 {
    f.stepWith(1. / 60., new Vec3(0., 0., 0.), &sphereField);
    s = s + 1;
  }
  near((*f.pos[0usize] - new Vec3(2., 0., 0.)).length(), 0.32, 0.001, "field closure: rests at its radius + thickness");
}

// A slope of 20 degrees: the plane's normal leans back from vertical by 20 degrees. A
// particle on it slides when mu < tan 20 = 0.364. Coulomb: a = g (sin - mu cos).
fn friction() {
  let t = radians(20.);
  let normal = new Vec3(-sin(t), cos(t), 0.);
  var sticks = drop(new Vec3(0., 0.02, 0.));
  sticks.friction = 0.6;
  sticks.addCollider(Collider.plane(new Vec3(0., 0., 0.), normal));
  settle(&mut sticks, 120);
  let p0 = *sticks.pos[0usize];
  settle(&mut sticks, 120);
  near((*sticks.pos[0usize] - p0).length(), 0., 0.005, "friction 0.6 on a 20 degree slope: it stays");

  var slides = drop(new Vec3(0., 0.02, 0.));
  slides.friction = 0.05;
  slides.damping = 0.;
  slides.addCollider(Collider.plane(new Vec3(0., 0., 0.), normal));
  settle(&mut slides, 60);
  let q0 = *slides.pos[0usize];
  settle(&mut slides, 120);
  let travelled = (*slides.pos[0usize] - q0).length();
  // from the speed at t = 1 s: v1 = a, then 2 s more: v1 * 2 + 0.5 a * 4; a = 9.81 (sin 20 - 0.05 cos 20) = 2.89
  let a = 9.81 * (sin(t) - 0.05 * cos(t));
  let want = a * 1. * 2. + 0.5 * a * 4.;
  near(travelled, want, 0.15 * want, "friction 0.05: it slides at about g (sin - mu cos), within 15%");
}

// A ring of rope, 40 links of 0.03 m, almost closed: its two end particles start
// 5 mm apart, so close that without self collision they stay there. Built
// straight (so the particles' rest places, which self collision measures
// neighbourhood by, are far apart), then bent into the ring. Returns the least
// distance between the two ends over 120 steps.
fn ringGap(collide: bool) f32 {
  let n = 41;
  let link = 0.03f;
  let radius = (40. * link + 0.005) / (2. * pi);
  var pts = List[Vec3].empty();
  var i = 0;
  while i < n {
    pts.push(new Vec3(link * f32.from(i), 0., 0.));
    i = i + 1;
  }
  var rope = chain(pts.view(), 0.1, 1e-6, 0.005);
  i = 0;
  while i < n {
    let a = link * f32.from(i) / radius;
    rope.pos.set(usize.from(i), new Vec3(radius * cos(a), radius * sin(a), 0.));
    i = i + 1;
  }
  rope.gravity = new Vec3(0., 0., 0.);
  rope.airDensity = 0.;
  rope.damping = 2.;
  rope.selfCollide = collide;
  rope.selfRadius = 0.02;
  var least = 1e9f;
  var s = 0;
  while s < 120 {
    rope.step(1. / 60., new Vec3(0., 0., 0.));
    let gap = (*rope.pos[0usize] - *rope.pos[40usize]).length();
    if gap < least { least = gap; }
    s = s + 1;
  }
  least
}

fn selfCollision() {
  let free = ringGap(false);
  expectBool(free < 0.01, true, "without self collision the ends stay on top of each other");
  let held = ringGap(true);
  expectBool(held > 0.039, true, "with it they are never closer than 2 radii (0.04 m) at the end of a step");
}

fn main() i32 {
  shapes();
  friction();
  selfCollision();
  done()
}
