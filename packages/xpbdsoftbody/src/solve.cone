// ======== The XPBD step and the constraint projections ========
//
// A step (Muller, Macklin, Chentanez, Jeschke and Kim 2020, "Detailed Rigid
// Body Simulation with Extended Position Based Dynamics", the small-steps
// scheme; Macklin, Muller and Chentanez 2016, "XPBD: Position-Based
// Simulation of Compliant Constrained Dynamics"). For each of n substeps of
// h = dt / n:
//
//   1. move the attached particles with the anchor frame;
//   2. wind forces on the triangles and rope segments from the present state;
//   3. predict: v += h (g + f w), x += h v, remembering the old x;
//   4. solve once (or 'iterations' times), in a fixed order: contacts, pressure,
//      bending, curvature, long range tethers, stretch (stretch last, so the
//      positions that go on satisfy the edges best); each with XPBD's
//      compliant correction
//        dlambda = (-C - a lambda) / (sum w |grad C|^2 + a),  a = compliance / h^2,
//        dx_i = w_i dlambda grad_i C;
//   5. optional strain limiting, contacts again, self collision: positions
//      projected out, with Coulomb friction on the tangential displacement of
//      the substep (Macklin et al. 2014, "Unified Particle Physics");
//   6. v = (x - x_old) / h, then damping.
//
// Lambdas are zero at the first iteration of each substep. Every loop runs in
// index order and no random numbers are used, so the same inputs give the same
// bits (on one compiler build and one C runtime: atan2 and the square root are
// the C library's and the compiler's).
//
// What one Gauss-Seidel pass per substep leaves unconverged is a stretch in a
// loaded cloth or rope that grows as the substeps get larger (a 32 x 32 cloth
// hanging by its top edge, stretch compliance 4e-3, shows 6% at its worst edge
// with 8 substeps, 1.5% with 20; the mean is a quarter of that): the remedies
// are more substeps or iterations, strain limiting, and long range tethers.

fn zero3() Vec3 inline {new Vec3(0., 0., 0.);}

// The signed angle between the planes of triangles (a, b, c) and (b, a, d),
// radians: 0 when they lie flat in one plane with c and d on opposite sides of
// the shared edge, positive when the surface folds one way, negative the other.
// It is the angle between the two triangles' normals about the edge a-b.
pub fn dihedralAngle(pa Vec3, pb Vec3, pc Vec3, pd Vec3) f32 {
  imm e = pb - pa;
  imm elen = e.length();
  if elen < 1e-9 { return 0.; }
  imm eh = e * (1. / elen);
  imm nc = e.cross(pc - pa);
  imm nd = (-e).cross(pd - pb);
  imm lc = nc.length();
  imm ld = nd.length();
  if lc < 1e-12 or ld < 1e-12 { return 0.; }
  imm ucn = nc * (1. / lc);
  imm udn = nd * (1. / ld);
  atan2(ucn.cross(udn).dot(eh), ucn.dot(udn));
}

// The gradient of 'dihedralAngle' with respect to its four points: the edge's
// from the feet of the wings on the edge (Bridson, Marino and Fedkiw 2003,
// "Simulation of clothing with folds and wrinkles"; Tamstorf and Grinspun
// 2013 for the signed form). No acos, so it has no singularity when flat.
// Returns (ga, gb, gc, gd), zero for a degenerate pair of triangles.
pub struct BendGrad {
  pub ga Vec3;
  pub gb Vec3;
  pub gc Vec3;
  pub gd Vec3;
}

pub fn dihedralGradient(pa Vec3, pb Vec3, pc Vec3, pd Vec3) BendGrad {
  imm e = pb - pa;
  imm e2 = e.lengthSquared();
  imm z = zero3();
  if e2 < 1e-18 { return new BendGrad(z, z, z, z); }
  imm elen = e2.sqrt();
  imm nc = e.cross(pc - pa);
  imm nd = (-e).cross(pd - pb);
  imm lc2 = nc.lengthSquared();
  imm ld2 = nd.lengthSquared();
  if lc2 < 1e-18 or ld2 < 1e-18 { return new BendGrad(z, z, z, z); }
  imm gc = nc * (-elen / lc2);
  imm gd = nd * (-elen / ld2);
  imm tc = (pc - pa).dot(e) / e2;
  imm td = (pd - pa).dot(e) / e2;
  imm ga = gc * (-(1. - tc)) + gd * (-(1. - td));
  imm gb = gc * (-tc) + gd * (-td);
  new BendGrad(ga, gb, gc, gd);
}

// The volume of a closed triangle mesh: sum of signed tetrahedra against the
// centroid of the points (the centroid only for precision: the sum is the
// same for any origin when the mesh is closed)
pub fn meshVolume(pos &Array[Vec3], tris &Array[u32]) f32 {
  mut c = zero3();
  mut i = 0usize;
  while i < pos.len() {
    c = c + pos[i];
    i = i + 1usize;
  }
  if pos.len() > 0usize { c = c * (1. / f32.from(pos.len())); }
  mut v = 0.;
  mut t = 0usize;
  while t + 2usize < tris.len() {
    imm a = pos[usize.from(tris[t])] - c;
    imm b = pos[usize.from(tris[t + 1usize])] - c;
    imm d = pos[usize.from(tris[t + 2usize])] - c;
    v = v + a.dot(b.cross(d));
    t = t + 3usize;
  }
  v / 6.;
}

// The constraints are always swept forward, in the order they were made.
// Alternating the direction from substep to substep was tried and made a rope
// and a pressure body vibrate at the substep rate.
//
// 'first' is the first iteration of a substep, where every lambda is zero
// (XPBD resets them each substep): saying so here saves a pass that zeroes them.
fn projectDistances(b &mut SoftBody, h f32, first bool) {
  imm inv2 = 1. / (h * h);
  mut pos = b.pos.viewMut();
  imm inv = b.invMass.view();
  mut dist = b.dist.viewMut();
  mut k = 0usize;
  imm n = dist.len();
  while k < n {
    imm c = dist[k];
    k = k + 1usize;
    imm ia = usize.from(c.a);
    imm ib = usize.from(c.b);
    imm wa = inv[ia];
    imm wb = inv[ib];
    imm w = wa + wb;
    if w > 0. {
      imm pa = pos[ia];
      imm pb = pos[ib];
      imm d = pa - pb;
      imm len = d.length();
      if len > 1e-9 {
        imm alpha = c.compliance * inv2;
        imm lam = if first {0.;} else {c.lambda;};
        imm dl = (-(len - c.rest) - alpha * lam) / (w + alpha);
        dist[k - 1usize].lambda = lam + dl;
        imm s = dl / len;
        pos[ia] = pa + d * (s * wa);
        pos[ib] = pb - d * (s * wb);
      }
    }
  }
}

// The dihedral angle and gradient of 'dihedralAngle' and 'dihedralGradient',
// fused: the angle from atan2 of unnormalised quantities (the common positive
// factor |nc||nd| cancels), so no square root but the edge's.
fn projectBends(b &mut SoftBody, h f32, first bool) {
  imm inv2 = 1. / (h * h);
  imm pi2 = 2. * pi;
  mut pos = b.pos.viewMut();
  imm inv = b.invMass.view();
  mut bend = b.bend.viewMut();
  mut k = 0usize;
  imm n = bend.len();
  while k < n {
    imm c = bend[k];
    k = k + 1usize;
    imm ia = usize.from(c.a);
    imm ib = usize.from(c.b);
    imm ic = usize.from(c.c);
    imm id = usize.from(c.d);
    imm wa = inv[ia];
    imm wb = inv[ib];
    imm wc = inv[ic];
    imm wd = inv[id];
    if wa + wb + wc + wd > 0. {
      imm pa = pos[ia];
      imm pb = pos[ib];
      imm pc = pos[ic];
      imm pd = pos[id];
      imm e = pb - pa;
      imm e2 = e.lengthSquared();
      imm nc = e.cross(pc - pa);
      imm nd = (-e).cross(pd - pb);
      imm lc2 = nc.lengthSquared();
      imm ld2 = nd.lengthSquared();
      if e2 > 1e-18 and lc2 > 1e-18 and ld2 > 1e-18 {
        imm elen = e2.sqrt();
        mut err = atan2(nc.cross(nd).dot(e) / elen, nc.dot(nd)) - c.rest;
        if err > pi { err = err - pi2; }
        if err < -pi { err = err + pi2; }
        imm gc = nc * (-elen / lc2);
        imm gd = nd * (-elen / ld2);
        imm tc = (pc - pa).dot(e) / e2;
        imm td = (pd - pa).dot(e) / e2;
        imm ga = gc * (tc - 1.) + gd * (td - 1.);
        imm gb = gc * (-tc) + gd * (-td);
        imm sum = wa * ga.lengthSquared() + wb * gb.lengthSquared() + wc * gc.lengthSquared() + wd * gd.lengthSquared();
        if sum > 1e-12 {
          imm alpha = c.compliance * inv2;
          imm lam = if first {0.;} else {c.lambda;};
          imm dl = (-err - alpha * lam) / (sum + alpha);
          bend[k - 1usize].lambda = lam + dl;
          pos[ia] = pa + ga * (wa * dl);
          pos[ib] = pb + gb * (wb * dl);
          pos[ic] = pc + gc * (wc * dl);
          pos[id] = pd + gd * (wd * dl);
        }
      }
    }
  }
}

// A rope's curvature: C = |p_a - 2 p_b + p_c| - rest, gradient u, -2u, u for the
// unit vector u along that sum. First order in the turn between two segments,
// which a distance between particles two apart is not (second order, so it
// hardly resists a gentle bend).
fn projectCurves(b &mut SoftBody, h f32, first bool) {
  imm inv2 = 1. / (h * h);
  mut pos = b.pos.viewMut();
  imm inv = b.invMass.view();
  mut curves = b.curves.viewMut();
  mut k = 0usize;
  imm n = curves.len();
  while k < n {
    imm c = curves[k];
    k = k + 1usize;
    imm ia = usize.from(c.a);
    imm ib = usize.from(c.b);
    imm ic = usize.from(c.c);
    imm wa = inv[ia];
    imm wb = inv[ib];
    imm wc = inv[ic];
    imm sum = wa + 4. * wb + wc;
    if sum > 0. {
      imm pa = pos[ia];
      imm pb = pos[ib];
      imm pc = pos[ic];
      imm q = pa - pb * 2. + pc;
      imm len = q.length();
      if len > 1e-9 {
        imm u = q * (1. / len);
        imm alpha = c.compliance * inv2;
        imm lam = if first {0.;} else {c.lambda;};
        imm dl = (-(len - c.rest) - alpha * lam) / (sum + alpha);
        curves[k - 1usize].lambda = lam + dl;
        pos[ia] = pa + u * (wa * dl);
        pos[ib] = pb - u * (2. * wb * dl);
        pos[ic] = pc + u * (wc * dl);
      }
    }
  }
}

// Strain limiting (Provot 1995, "Deformation constraints in a mass-spring model
// to describe rigid cloth behavior"): each edge stretched past rest * (1 +
// limit) is brought back to that length, shared by inverse mass. A few passes
// of this cost a fraction of the solve and bound the stretch that a small
// number of Gauss-Seidel iterations leaves in a loaded cloth or a rope.
fn limitStrain(b &mut SoftBody) {
  imm cap = 1. + b.strainLimit;
  imm n = b.dist.len();
  mut pass = 0u32;
  while pass < b.limitPasses {
    mut k = 0usize;
    while k < n {
      imm c = *b.dist[k];
      k = k + 1usize;
      imm ia = usize.from(c.a);
      imm ib = usize.from(c.b);
      imm wa = *b.invMass[ia];
      imm wb = *b.invMass[ib];
      if wa + wb <= 0. { continue; }
      imm pa = *b.pos[ia];
      imm pb = *b.pos[ib];
      imm d = pa - pb;
      imm len = d.length();
      imm longest = c.rest * cap;
      if len > longest and len > 1e-9 {
        imm s = (len - longest) / (len * (wa + wb));
        b.pos.set(ia, pa - d * (s * wa));
        b.pos.set(ib, pb + d * (s * wb));
      }
    }
    pass = pass + 1u32;
  }
}

// Long range attachments: a particle farther from its anchor than its tether is
// brought back by the excess (an inequality: slack costs nothing)
fn projectTethers(b &mut SoftBody) {
  mut k = 0usize;
  imm n = b.tethers.len();
  while k < n {
    imm t = *b.tethers[k];
    imm ip = usize.from(t.particle);
    imm ia = usize.from(t.anchor);
    imm wp = *b.invMass[ip];
    imm wa = *b.invMass[ia];
    imm w = wp + wa;
    if w > 0. {
      imm pp = *b.pos[ip];
      imm pa = *b.pos[ia];
      imm d = pp - pa;
      imm len = d.length();
      if len > t.maxLength and len > 1e-9 {
        imm s = (len - t.maxLength) / (len * w);
        b.pos.set(ip, pp - d * (s * wp));
        b.pos.set(ia, pa + d * (s * wa));
      }
    }
    k = k + 1usize;
  }
}

// The pressure constraint (Muller, Heidelberger, Hennix and Ratcliff 2007,
// "Position Based Dynamics", section on overpressure) in XPBD's form, with
// C = V - target * V0 for the whole closed mesh at once. dV/dp_i is a sixth of
// the sum of p_j x p_k over the triangles (i, j, k) using i.
fn projectPressure(b &mut SoftBody, h f32, grad &mut List[Vec3]) {
  if !b.pressure.active { return; }
  imm n = b.pos.len();
  mut c = zero3();
  mut i = 0usize;
  while i < n {
    c = c + *b.pos[i];
    i = i + 1usize;
  }
  c = c * (1. / f32.from(n));
  i = 0usize;
  while i < n {
    grad.set(i, zero3());
    i = i + 1usize;
  }
  mut vol = 0.;
  mut t = 0usize;
  while t + 2usize < b.tris.len() {
    imm ia = usize.from(*b.tris[t]);
    imm ib = usize.from(*b.tris[t + 1usize]);
    imm ic = usize.from(*b.tris[t + 2usize]);
    imm pa = *b.pos[ia] - c;
    imm pb = *b.pos[ib] - c;
    imm pc = *b.pos[ic] - c;
    vol = vol + pa.dot(pb.cross(pc));
    grad.set(ia, *grad[ia] + pb.cross(pc));
    grad.set(ib, *grad[ib] + pc.cross(pa));
    grad.set(ic, *grad[ic] + pa.cross(pb));
    t = t + 3usize;
  }
  vol = vol / 6.;
  mut sum = 0.;
  i = 0usize;
  while i < n {
    imm g = *grad[i] * (1. / 6.);
    grad.set(i, g);
    sum = sum + *b.invMass[i] * g.lengthSquared();
    i = i + 1usize;
  }
  if sum < 1e-12 { return; }
  imm alpha = b.pressure.compliance / (h * h);
  imm err = vol - b.pressure.target * b.pressure.restVolume;
  imm dl = (-err - alpha * b.pressure.lambda) / (sum + alpha);
  b.pressure.lambda = b.pressure.lambda + dl;
  i = 0usize;
  while i < n {
    b.pos.set(i, *b.pos[i] + *grad[i] * (*b.invMass[i] * dl));
    i = i + 1usize;
  }
}

// Move the attached particles to where the anchor frame puts them at fraction f
// of the step, and give them the velocity of that motion
fn moveAttached(b &mut SoftBody, f f32, h f32) {
  if b.anchors.len() == 0usize { return; }
  imm tr = b.frameFrom.translation.lerp(b.frameTo.translation, f);
  imm rot = b.frameFrom.rotation.slerp(b.frameTo.rotation, f);
  imm sc = b.frameFrom.scale.lerp(b.frameTo.scale, f);
  imm frame = new Transform3(tr, rot, sc);
  mut k = 0usize;
  while k < b.anchors.len() {
    imm a = *b.anchors[k];
    imm ip = usize.from(a.particle);
    imm target = frame.transformPoint(a.offset);
    b.vel.set(ip, (target - *b.pos[ip]) * (1. / h));
    b.pos.set(ip, target);
    k = k + 1usize;
  }
}

fn runStep(b &mut SoftBody, dt f32, wind Vec3, field &<fn(p Vec3) Vec4, hasField bool) {
  imm n = b.pos.len();
  if n == 0usize or dt <= 0. { return; }
  imm subs = if b.substeps < 1u32 {1u32;} else {b.substeps;};
  imm h = dt / f32.from(subs);
  mut grad = List[Vec3].empty();
  if b.pressure.active {
    mut i = 0usize;
    while i < n {
      grad.push(zero3());
      i = i + 1usize;
    }
  }
  imm gravity = b.gravity;
  imm damp = 1. / (1. + b.damping * h);
  imm invH = 1. / h;
  imm anyContact = hasField or b.colliders.len() > 0usize or b.heightfields.len() > 0usize;
  mut s = 0u32;
  while s < subs {
    moveAttached(b, f32.from(s + 1u32) / f32.from(subs), h);
    applyWind(b, wind);
    // predict
    {
      mut pos = b.pos.viewMut();
      mut prev = b.prev.viewMut();
      mut vel = b.vel.viewMut();
      imm inv = b.invMass.view();
      imm force = b.force.view();
      mut i = 0usize;
      while i < n {
        imm p = pos[i];
        prev[i] = p;
        imm w = inv[i];
        if w > 0. {
          imm v = vel[i] + (gravity + force[i] * w) * h;
          vel[i] = v;
          pos[i] = p + v * h;
        }
        i = i + 1usize;
      }
    }
    b.pressure.lambda = 0.;
    // solve
    mut it = 0u32;
    while it < b.iterations {
      if anyContact { collideAll(b, field); }
      projectPressure(b, h, &mut grad);
      projectBends(b, h, it == 0u32);
      projectCurves(b, h, it == 0u32);
      projectTethers(b);
      projectDistances(b, h, it == 0u32);
      it = it + 1u32;
    }
    if b.strainLimit >= 0. { limitStrain(b); }
    if anyContact { collideAll(b, field); }
    if b.strainLimit >= 0. and anyContact { limitStrain(b); }
    if b.selfCollide { selfCollide(b); }
    // velocities
    {
      imm pos = b.pos.view();
      imm prev = b.prev.view();
      mut vel = b.vel.viewMut();
      imm inv = b.invMass.view();
      mut i = 0usize;
      while i < n {
        if inv[i] > 0. { vel[i] = (pos[i] - prev[i]) * (invH * damp); }
        i = i + 1usize;
      }
    }
    s = s + 1u32;
  }
  b.frameFrom = b.frameTo;
}
