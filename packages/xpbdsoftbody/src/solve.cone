// ======== The constraint helpers: dihedral angles, curvature weights, volume, strain limits, pressure ========
//
// The step itself is in step.cone and its inner loops (stretch, bending,
// curvature, tethers, the wind and the integration) in kernels.cone. What is
// here are the pieces that stay on one thread: the angle and gradient functions
// the bending constraint is built from and tested against, the weights of the
// curvature model of bending, and the closed-mesh volume and the pressure
// constraint on it.

fn zero3() Vec3 inline {new Vec3(0., 0., 0.);}

// The signed angle between the planes of triangles (a, b, c) and (b, a, d),
// radians: 0 when they lie flat in one plane with c and d on opposite sides of
// the shared edge, positive when the surface folds one way, negative the other.
// It is the angle between the two triangles' normals about the edge a-b.
pub fn dihedralAngle(pa Vec3, pb Vec3, pc Vec3, pd Vec3) f32 {
  imm e = pb - pa;
  imm elen = e.length();
  if elen < 1e-9 { return 0.; }
  imm eh = e * (1. / elen);
  imm nc = e.cross(pc - pa);
  imm nd = (-e).cross(pd - pb);
  imm lc = nc.length();
  imm ld = nd.length();
  if lc < 1e-12 or ld < 1e-12 { return 0.; }
  imm ucn = nc * (1. / lc);
  imm udn = nd * (1. / ld);
  atan2(ucn.cross(udn).dot(eh), ucn.dot(udn));
}

// The gradient of 'dihedralAngle' with respect to its four points: the edge's
// from the feet of the wings on the edge (Bridson, Marino and Fedkiw 2003,
// "Simulation of clothing with folds and wrinkles"; Tamstorf and Grinspun
// 2013 for the signed form). No acos, so it has no singularity when flat.
// Returns (ga, gb, gc, gd), zero for a degenerate pair of triangles.
pub struct BendGrad {
  pub ga Vec3;
  pub gb Vec3;
  pub gc Vec3;
  pub gd Vec3;
}

pub fn dihedralGradient(pa Vec3, pb Vec3, pc Vec3, pd Vec3) BendGrad {
  imm e = pb - pa;
  imm e2 = e.lengthSquared();
  imm z = zero3();
  if e2 < 1e-18 { return new BendGrad(z, z, z, z); }
  imm elen = e2.sqrt();
  imm nc = e.cross(pc - pa);
  imm nd = (-e).cross(pd - pb);
  imm lc2 = nc.lengthSquared();
  imm ld2 = nd.lengthSquared();
  if lc2 < 1e-18 or ld2 < 1e-18 { return new BendGrad(z, z, z, z); }
  imm gc = nc * (-elen / lc2);
  imm gd = nd * (-elen / ld2);
  imm tc = (pc - pa).dot(e) / e2;
  imm td = (pd - pa).dot(e) / e2;
  imm ga = gc * (-(1. - tc)) + gd * (-(1. - td));
  imm gb = gc * (-tc) + gd * (-td);
  new BendGrad(ga, gb, gc, gd);
}

// The curvature model's weights for a hinge (a, b the edge, c and d the far corners) at its
// rest shape: K = (f(b,c,d), -f(a,c,d), f(a,b,d), -f(a,b,c)) with f(p,q,r) = n . ((q - p) x (r - p)),
// twice the signed area against the plane's normal n. For four points in a plane K sums to zero
// and sum K_i p_i = 0 (Mobius's relation among the signed areas of four coplanar points), so a flat
// hinge has curvature vector H = sum K_i x_i = 0, and a folded one has H along the fold's
// normal: |H| = e h_c h_d theta for a small fold theta, e the edge's length and h_c, h_d the
// heights of c and d above it. This is the operator of Bergou et al. 2006, "A quadratic bending
// model for inextensible surfaces", whose weights are cotangents: for a flat hinge the weights
// are fixed up to a factor by the relation above, and the factor is set here by the fold's
// cost: a constraint |H| = 0 of compliance alpha * (e h_c h_d)^2 stores the energy
// theta^2 / (2 alpha) of a fold, the dihedral constraint's, so the same compliance serves both.
// Returns (K0, K1, K2, K3, (e h_c h_d)^2).
pub struct CurvatureWeights {
  pub k0 f32;
  pub k1 f32;
  pub k2 f32;
  pub k3 f32;
  pub gain2 f32;
}

pub fn curvatureWeights(pa Vec3, pb Vec3, pc Vec3, pd Vec3) CurvatureWeights {
  imm nrm = (pb - pa).cross(pc - pa);
  imm nl = nrm.length();
  if nl < 1e-12 { return new CurvatureWeights(0., 0., 0., 0., 0.); }
  imm n = nrm * (1. / nl);
  imm f123 = n.dot((pc - pb).cross(pd - pb));
  imm f023 = n.dot((pc - pa).cross(pd - pa));
  imm f013 = n.dot((pb - pa).cross(pd - pa));
  imm f012 = n.dot((pb - pa).cross(pc - pa));
  imm e = (pb - pa).length();
  // heights of c and d over the edge: twice the area over its length
  imm g = fabs(f012) * fabs(f013) / e;
  new CurvatureWeights(f123, -f023, f013, -f012, g * g);
}

// Switch the body's bending to the curvature model: the weights of each hinge from the positions
// now, so call it while the cloth is in its rest shape. The rest angles are not used, so a hinge
// that is folded at rest is held flat: the number of those (a rest angle past 0.3 rad) is
// returned, and the model is for cloth that is flat at rest.
pub fn useCurvatureModel(b &mut SoftBody) usize {
  mut folded = 0usize;
  mut k = 0usize;
  while k < b.bend.len() {
    imm c = *b.bend[k];
    imm w = curvatureWeights(*b.pos[usize.from(c.a)], *b.pos[usize.from(c.b)], *b.pos[usize.from(c.c)], *b.pos[usize.from(c.d)]);
    b.bend[k].k0 = w.k0;
    b.bend[k].k1 = w.k1;
    b.bend[k].k2 = w.k2;
    b.bend[k].k3 = w.k3;
    b.bend[k].gain2 = w.gain2;
    if fabs(c.rest) > 0.3 { folded = folded + 1usize; }
    k = k + 1usize;
  }
  b.bendModel = BEND_CURVATURE;
  folded;
}

// atan2 as the bending loop computes it (kernels.cone), for the tests
pub fn fastAtan2(y f32, x f32) f32 {atan2Fast(y, x);}

// The volume of a closed triangle mesh: sum of signed tetrahedra against the
// centroid of the points (the centroid only for precision: the sum is the
// same for any origin when the mesh is closed)
pub fn meshVolume(pos &Array[Vec3], tris &Array[u32]) f32 {
  mut c = zero3();
  mut i = 0usize;
  while i < pos.len() {
    c = c + pos[i];
    i = i + 1usize;
  }
  if pos.len() > 0usize { c = c * (1. / f32.from(pos.len())); }
  mut v = 0.;
  mut t = 0usize;
  while t + 2usize < tris.len() {
    imm a = pos[usize.from(tris[t])] - c;
    imm b = pos[usize.from(tris[t + 1usize])] - c;
    imm d = pos[usize.from(tris[t + 2usize])] - c;
    v = v + a.dot(b.cross(d));
    t = t + 3usize;
  }
  v / 6.;
}

// The pressure constraint (Muller, Heidelberger, Hennix and Ratcliff 2007,
// "Position Based Dynamics", section on overpressure) in XPBD's form, with
// C = V - target * V0 for the whole closed mesh at once. dV/dp_i is a sixth of
// the sum of p_j x p_k over the triangles (i, j, k) using i.
fn projectPressure(b &mut SoftBody, h f32, grad &mut List[Vec3]) {
  if !b.pressure.active { return; }
  imm n = b.pos.len();
  mut c = zero3();
  mut i = 0usize;
  while i < n {
    c = c + *b.pos[i];
    i = i + 1usize;
  }
  c = c * (1. / f32.from(n));
  i = 0usize;
  while i < n {
    grad.set(i, zero3());
    i = i + 1usize;
  }
  mut vol = 0.;
  mut t = 0usize;
  while t + 2usize < b.tris.len() {
    imm ia = usize.from(*b.tris[t]);
    imm ib = usize.from(*b.tris[t + 1usize]);
    imm ic = usize.from(*b.tris[t + 2usize]);
    imm pa = *b.pos[ia] - c;
    imm pb = *b.pos[ib] - c;
    imm pc = *b.pos[ic] - c;
    vol = vol + pa.dot(pb.cross(pc));
    grad.set(ia, *grad[ia] + pb.cross(pc));
    grad.set(ib, *grad[ib] + pc.cross(pa));
    grad.set(ic, *grad[ic] + pa.cross(pb));
    t = t + 3usize;
  }
  vol = vol / 6.;
  mut sum = 0.;
  i = 0usize;
  while i < n {
    imm g = *grad[i] * (1. / 6.);
    grad.set(i, g);
    sum = sum + *b.invMass[i] * g.lengthSquared();
    i = i + 1usize;
  }
  if sum < 1e-12 { return; }
  imm alpha = b.pressure.compliance / (h * h);
  imm err = vol - b.pressure.target * b.pressure.restVolume;
  imm dl = (-err - alpha * b.pressure.lambda) / (sum + alpha);
  b.pressure.lambda = b.pressure.lambda + dl;
  i = 0usize;
  while i < n {
    b.pos.set(i, *b.pos[i] + *grad[i] * (*b.invMass[i] * dl));
    i = i + 1usize;
  }
}

// Move the attached particles to where the anchor frame puts them at fraction f
// of the step, and give them the velocity of that motion
fn moveAttached(b &mut SoftBody, f f32, h f32) {
  if b.anchors.len() == 0usize { return; }
  imm tr = b.frameFrom.translation.lerp(b.frameTo.translation, f);
  imm rot = b.frameFrom.rotation.slerp(b.frameTo.rotation, f);
  imm sc = b.frameFrom.scale.lerp(b.frameTo.scale, f);
  imm frame = new Transform3(tr, rot, sc);
  mut k = 0usize;
  while k < b.anchors.len() {
    imm a = *b.anchors[k];
    imm ip = usize.from(a.particle);
    imm target = frame.transformPoint(a.offset);
    b.vel.set(ip, (target - *b.pos[ip]) * (1. / h));
    b.pos.set(ip, target);
    k = k + 1usize;
  }
}
