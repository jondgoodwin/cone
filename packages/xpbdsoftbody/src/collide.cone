// ======== Collision: simple shapes, a heightfield, a field, and itself ========
//
// A particle is a sphere of radius 'thickness'. For each shape the signed
// distance sd from the particle's centre to the surface and the outward unit
// normal n are found; when sd < thickness the particle is moved out along n by
// the depth thickness - sd. The shapes are static within a substep (a caller
// moves a collider by rewriting it between steps), and friction is Coulomb's on
// the particle's tangential displacement over the substep, applied as a
// position correction (Macklin et al. 2014): the displacement is cancelled up
// to mu times the depth, so a particle held by static friction does not move
// and one that slides loses mu * depth per substep.
//
// The package does not import rigidcollide: a caller who wants its shapes
// wraps a closest-point query in the 'field' closure of 'stepWith'.
//
// Particles collide with shapes, not triangles against shapes: a triangle
// larger than a particle's thickness can pass over a feature narrower than
// itself (a thin edge). Thickness is the margin for that.

// Where is p relative to the collider: the signed distance in w, the
// outward unit normal in xyz
fn colliderDistance(c &Collider, p Vec3) Vec4 {
  if c.kind == COLLIDER_SPHERE {
    imm d = p - c.a;
    imm len = d.length();
    if len < 1e-9 { return new Vec4(0., 1., 0., -c.radius); }
    imm nn = d * (1. / len);
    return new Vec4(nn.x, nn.y, nn.z, len - c.radius);
  }
  if c.kind == COLLIDER_CAPSULE {
    imm ab = c.b - c.a;
    imm l2 = ab.lengthSquared();
    mut t = 0.;
    if l2 > 1e-12 { t = fclamp((p - c.a).dot(ab) / l2, 0., 1.); }
    imm q = c.a + ab * t;
    imm d = p - q;
    imm len = d.length();
    if len < 1e-9 { return new Vec4(0., 1., 0., -c.radius); }
    imm nn = d * (1. / len);
    return new Vec4(nn.x, nn.y, nn.z, len - c.radius);
  }
  if c.kind == COLLIDER_PLANE {
    imm sd = (p - c.a).dot(c.b);
    return new Vec4(c.b.x, c.b.y, c.b.z, sd);
  }
  // box
  imm loc = c.rotation.conjugate() * (p - c.a);
  imm hx = c.b;
  imm dx = fabs(loc.x) - hx.x;
  imm dy = fabs(loc.y) - hx.y;
  imm dz = fabs(loc.z) - hx.z;
  if dx > 0. or dy > 0. or dz > 0. {
    imm closest = loc.clamp(-hx, hx);
    imm d = loc - closest;
    imm len = d.length();
    imm nl = d * (1. / len);
    imm nw = c.rotation * nl;
    return new Vec4(nw.x, nw.y, nw.z, len);
  }
  // inside: out through the nearest face
  mut nl = new Vec3(0., 0., 0.);
  mut sd = dx;
  if dx >= dy and dx >= dz {
    nl = new Vec3(if loc.x < 0. {-1.;} else {1.;}, 0., 0.);
  } elif dy >= dz {
    sd = dy;
    nl = new Vec3(0., if loc.y < 0. {-1.;} else {1.;}, 0.);
  } else {
    sd = dz;
    nl = new Vec3(0., 0., if loc.z < 0. {-1.;} else {1.;});
  }
  imm nw = c.rotation * nl;
  new Vec4(nw.x, nw.y, nw.z, sd);
}

// The heightfield's surface under p: the signed distance to the tangent plane
// of the bilinear surface, with its normal; w large when p is off the grid
fn heightfieldDistance(g &Heightfield, p Vec3) Vec4 {
  imm r = g.heightAt(p.x, p.z);
  if !r.1 { return new Vec4(0., 1., 0., 1e30); }
  imm e = g.cell * 0.5;
  imm hx0 = g.heightAt(p.x - e, p.z);
  imm hx1 = g.heightAt(p.x + e, p.z);
  imm hz0 = g.heightAt(p.x, p.z - e);
  imm hz1 = g.heightAt(p.x, p.z + e);
  mut dhx = 0.;
  mut dhz = 0.;
  if hx0.1 and hx1.1 { dhx = (hx1.0 - hx0.0) / (2. * e); }
  if hz0.1 and hz1.1 { dhz = (hz1.0 - hz0.0) / (2. * e); }
  imm nn = new Vec3(-dhx, 1., -dhz).normalize();
  new Vec4(nn.x, nn.y, nn.z, (p.y - r.0) * nn.y);
}

// Push particle i out of a surface with signed distance sd and normal n, with
// friction against its motion over the substep
fn resolveContact(b &mut SoftBody, i usize, p Vec3, nn Vec3, depth f32) Vec3 {
  mut q = p + nn * depth;
  if b.friction > 0. {
    imm move = q - *b.prev[i];
    imm tang = move - nn * move.dot(nn);
    imm tl = tang.length();
    if tl > 1e-9 {
      imm k = fmin(1., b.friction * depth / tl);
      q = q - tang * k;
    }
  }
  q;
}

fn collideAll(b &mut SoftBody, field &<fn(p Vec3) Vec4) {
  imm n = b.pos.len();
  imm nc = b.colliders.len();
  imm nh = b.heightfields.len();
  imm r = b.thickness;
  mut i = 0usize;
  while i < n {
    if *b.invMass[i] > 0. {
      mut p = *b.pos[i];
      mut c = 0usize;
      while c < nc {
        imm sd = colliderDistance(&*b.colliders[c], p);
        if sd.w < r { p = resolveContact(b, i, p, new Vec3(sd.x, sd.y, sd.z), r - sd.w); }
        c = c + 1usize;
      }
      c = 0usize;
      while c < nh {
        imm sd = heightfieldDistance(&*b.heightfields[c], p);
        if sd.w < r { p = resolveContact(b, i, p, new Vec3(sd.x, sd.y, sd.z), r - sd.w); }
        c = c + 1usize;
      }
      imm sf = field(p);
      if sf.w < r { p = resolveContact(b, i, p, new Vec3(sf.x, sf.y, sf.z), r - sf.w); }
      b.pos.set(i, p);
    }
    i = i + 1usize;
  }
}

// ---- self collision ----
//
// Particles closer than 2 * selfRadius are pushed apart, shared by inverse
// mass, unless they were that close when built (neighbours in the cloth, which
// the constraints already hold: Muller's "Ten Minute Physics" cloth self
// collision test). The neighbours are found in a uniform hash grid with cells
// 2 * selfRadius wide, rebuilt each substep by a counting sort, so the order of
// pairs is fixed. Particles, not triangles: a pair of triangles can still cross
// between particles, so keep the cloth's resolution at the spacing wanted.

fn hashCell(x i32, y i32, z i32, size u32) u32 {
  imm h = (u32.from(x) * 73856093u32) ^ (u32.from(y) * 19349663u32) ^ (u32.from(z) * 83492791u32);
  h % size;
}

fn selfCollide(b &mut SoftBody) {
  imm n = b.pos.len();
  imm diam = 2. * b.selfRadius;
  if n < 2usize or diam <= 0. { return; }
  imm inv = 1. / diam;
  imm size = u32.from(2usize * n + 1usize);
  b.cellStart.clear();
  b.cellItems.clear();
  b.cellOf.clear();
  mut i = 0usize;
  while i <= usize.from(size) {
    b.cellStart.push(0u32);
    i = i + 1usize;
  }
  i = 0usize;
  while i < n {
    imm p = *b.pos[i];
    imm hc = hashCell(i32.from(floorf(p.x * inv)), i32.from(floorf(p.y * inv)), i32.from(floorf(p.z * inv)), size);
    b.cellOf.push(hc);
    b.cellStart[usize.from(hc)] = *b.cellStart[usize.from(hc)] + 1u32;
    b.cellItems.push(0u32);
    i = i + 1usize;
  }
  // prefix sums: cellStart[c] is where cell c's items begin
  mut acc = 0u32;
  i = 0usize;
  while i < usize.from(size) {
    imm cnt = *b.cellStart[i];
    b.cellStart[i] = acc;
    acc = acc + cnt;
    i = i + 1usize;
  }
  b.cellStart[usize.from(size)] = acc;
  // fill, using cellStart as cursors and then restoring it
  i = 0usize;
  while i < n {
    imm hc = usize.from(*b.cellOf[i]);
    imm at = *b.cellStart[hc];
    b.cellItems[usize.from(at)] = u32.from(i);
    b.cellStart[hc] = at + 1u32;
    i = i + 1usize;
  }
  mut c = usize.from(size);
  while c > 0usize {
    b.cellStart[c] = *b.cellStart[c - 1usize];
    c = c - 1usize;
  }
  b.cellStart[0usize] = 0u32;
  // pairs
  imm d2 = diam * diam;
  i = 0usize;
  while i < n {
    imm pi_ = *b.pos[i];
    imm cx = i32.from(floorf(pi_.x * inv));
    imm cy = i32.from(floorf(pi_.y * inv));
    imm cz = i32.from(floorf(pi_.z * inv));
    mut dx = -1i32;
    while dx <= 1i32 {
      mut dy = -1i32;
      while dy <= 1i32 {
        mut dz = -1i32;
        while dz <= 1i32 {
          imm hc = usize.from(hashCell(cx + dx, cy + dy, cz + dz, size));
          mut k = usize.from(*b.cellStart[hc]);
          imm kend = usize.from(*b.cellStart[hc + 1usize]);
          while k < kend {
            imm j = usize.from(*b.cellItems[k]);
            k = k + 1usize;
            if j <= i { continue; }
            imm pa = *b.pos[i];
            imm pb = *b.pos[j];
            imm d = pa - pb;
            imm l2 = d.lengthSquared();
            if l2 >= d2 or l2 < 1e-14 { continue; }
            if (*b.rest[i] - *b.rest[j]).lengthSquared() < d2 { continue; }
            imm wa = *b.invMass[i];
            imm wb = *b.invMass[j];
            if wa + wb <= 0. { continue; }
            imm len = l2.sqrt();
            imm s = (diam - len) / (len * (wa + wb));
            b.pos.set(i, pa + d * (s * wa));
            b.pos.set(j, pb - d * (s * wb));
          }
          dz = dz + 1i32;
        }
        dy = dy + 1i32;
      }
      dx = dx + 1i32;
    }
    i = i + 1usize;
  }
}
