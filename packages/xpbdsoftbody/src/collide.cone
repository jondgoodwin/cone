// ======== Collision: simple shapes, a heightfield, a field, and itself ========
//
// A particle is a sphere of radius 'thickness'. For each shape the signed
// distance sd from the particle's centre to the surface and the outward unit
// normal n are found; when sd < thickness the particle is moved out along n by
// the depth thickness - sd. The shapes are static within a substep (a caller
// moves a collider by rewriting it between steps), and friction is Coulomb's on
// the particle's tangential displacement over the substep, applied as a
// position correction (Macklin et al. 2014): the displacement is cancelled up
// to mu times the depth, so a particle held by static friction does not move
// and one that slides loses mu * depth per substep.
//
// The package does not import rigidcollide: a caller who wants its shapes
// wraps a closest-point query in the 'field' closure of 'stepWith'.
//
// Particles collide with shapes, not triangles against shapes: a triangle
// larger than a particle's thickness can pass over a feature narrower than
// itself (a thin edge). Thickness is the margin for that.

// Where is p relative to the collider: the signed distance in w, the
// outward unit normal in xyz
fn colliderDistance(c: &Collider, p: Vec3) Vec4 {
  if c.kind == COLLIDER_SPHERE {
    let d = p - c.a;
    let len = d.length();
    if len < 1e-9 { return Vec4(0., 1., 0., -c.radius); }
    let nn = d * (1. / len);
    return Vec4(nn.x, nn.y, nn.z, len - c.radius);
  }
  if c.kind == COLLIDER_CAPSULE {
    let ab = c.b - c.a;
    let l2 = ab.lengthSquared();
    var t = 0.f;
    if l2 > 1e-12 { t = fclamp((p - c.a).dot(ab) / l2, 0., 1.); }
    let q = c.a + ab * t;
    let d = p - q;
    let len = d.length();
    if len < 1e-9 { return Vec4(0., 1., 0., -c.radius); }
    let nn = d * (1. / len);
    return Vec4(nn.x, nn.y, nn.z, len - c.radius);
  }
  if c.kind == COLLIDER_PLANE {
    let sd = (p - c.a).dot(c.b);
    return Vec4(c.b.x, c.b.y, c.b.z, sd);
  }
  // box
  let loc = c.rotation.conjugate() * (p - c.a);
  let hx = c.b;
  let dx = loc.x.abs() - hx.x;
  let dy = loc.y.abs() - hx.y;
  let dz = loc.z.abs() - hx.z;
  if dx > 0. || dy > 0. || dz > 0. {
    let closest = loc.clamp(-hx, hx);
    let d = loc - closest;
    let len = d.length();
    let nl = d * (1. / len);
    let nw = c.rotation * nl;
    return Vec4(nw.x, nw.y, nw.z, len);
  }
  // inside: out through the nearest face
  var nl = Vec3(0., 0., 0.);
  var sd = dx;
  if dx >= dy && dx >= dz {
    nl = Vec3(if loc.x < 0. {-1.} else {1.}, 0., 0.);
  } else if dy >= dz {
    sd = dy;
    nl = Vec3(0., if loc.y < 0. {-1.} else {1.}, 0.);
  } else {
    sd = dz;
    nl = Vec3(0., 0., if loc.z < 0. {-1.} else {1.});
  }
  let nw = c.rotation * nl;
  Vec4(nw.x, nw.y, nw.z, sd)
}

// The heightfield's surface under p: the signed distance to the tangent plane
// of the bilinear surface, with its normal; w large when p is off the grid
fn heightfieldDistance(g: &Heightfield, p: Vec3) Vec4 {
  let r = g.heightAt(p.x, p.z);
  if !r.1 { return Vec4(0., 1., 0., 1e30); }
  let e = g.cell * 0.5;
  let hx0 = g.heightAt(p.x - e, p.z);
  let hx1 = g.heightAt(p.x + e, p.z);
  let hz0 = g.heightAt(p.x, p.z - e);
  let hz1 = g.heightAt(p.x, p.z + e);
  var dhx = 0.f;
  var dhz = 0.f;
  if hx0.1 && hx1.1 { dhx = (hx1.0 - hx0.0) / (2. * e); }
  if hz0.1 && hz1.1 { dhz = (hz1.0 - hz0.0) / (2. * e); }
  let nn = Vec3(-dhx, 1., -dhz).normalize();
  Vec4(nn.x, nn.y, nn.z, (p.y - r.0) * nn.y)
}

// Push particle i out of a surface with signed distance sd and normal n, with
// friction against its motion over the substep
fn resolveContact(b: &mut SoftBody, i: usize, p: Vec3, nn: Vec3, depth: f32) Vec3 {
  var q = p + nn * depth;
  if b.friction > 0. {
    let move = q - *b.prev[i];
    let tang = move - nn * move.dot(nn);
    let tl = tang.length();
    if tl > 1e-9 {
      let k = fmin(1., b.friction * depth / tl);
      q = q - tang * k;
    }
  }
  q
}

// A contact with a shape of a rigid body: the particle is pushed out by its
// share of the depth, depth / (w_particle + w_body) times its own inverse mass,
// and the body gets the equal and opposite impulse (the particle's mass times its
// displacement over the substep). Friction is Coulomb's on the particle's sliding
// over the body's surface point, limited by the normal share, and its impulse
// goes to the body too. 'sd' is the signed distance to the surface, nn its
// outward normal.
fn resolveBodyContact(b: &mut SoftBody, i: usize, p: Vec3, nn: Vec3, sd: f32, bi: usize) Vec3 {
  let h = b.stepH;
  let depth = b.thickness - sd;
  let c = *b.bodies[bi];
  let cp = p - nn * sd;
  let wP = *b.invMass[i];
  let moves = c.invMass > 0.;
  let wB = if moves {c.invMassAlong(cp, nn) * f32.from(c.couplings.max(1u32))} else {0.};
  let lam = depth / (wP + wB);
  var q = p + nn * (lam * wP);
  var j = nn * (-lam / h);
  if b.friction > 0. {
    let move = (q - *b.prev[i]) - c.velocityAt(cp) * h;
    let tang = move - nn * move.dot(nn);
    let tl = tang.length();
    if tl > 1e-9 {
      let k = fmin(1., b.friction * lam * wP / tl);
      q = q - tang * k;
      j = j + tang * (k / (wP * h));
    }
  }
  if moves {
    b.bodies[bi].impulse = b.bodies[bi].impulse + j;
    b.bodies[bi].angImpulse = b.bodies[bi].angImpulse + (cp - c.pos).cross(j);
  }
  q
}

// Count the particles in contact with each coupled body, for mass splitting
fn countBodyContacts(b: &mut SoftBody) {
  var i = 0usize;
  while i < b.bodies.len() {
    b.bodies[i].couplings = b.bodies[i].anchored;
    i = i + 1usize;
  }
  let n = b.pos.len();
  let nc = b.colliders.len();
  let r = b.thickness;
  i = 0usize;
  while i < n {
    if *b.invMass[i] > 0. {
      let p = *b.pos[i];
      var c = 0usize;
      while c < nc {
        let bi = b.colliders[c].body;
        if bi != NO_BODY {
          let sd = colliderDistance(&*b.colliders[c], p);
          if sd.w < r { b.bodies[usize.from(bi)].couplings = b.bodies[usize.from(bi)].couplings + 1u32; }
        }
        c = c + 1usize;
      }
    }
    i = i + 1usize;
  }
}

fn collideAll(b: &mut SoftBody, field: &<fn(p: Vec3) Vec4) {
  let n = b.pos.len();
  let nc = b.colliders.len();
  let nh = b.heightfields.len();
  let r = b.thickness;
  if b.bodies.len() > 0usize { countBodyContacts(b); }
  var i = 0usize;
  while i < n {
    if *b.invMass[i] > 0. {
      var p = *b.pos[i];
      var c = 0usize;
      while c < nc {
        let sd = colliderDistance(&*b.colliders[c], p);
        if sd.w < r {
          let nrm = Vec3(sd.x, sd.y, sd.z);
          let bi = b.colliders[c].body;
          if bi == NO_BODY {
            p = resolveContact(b, i, p, nrm, r - sd.w);
          } else {
            p = resolveBodyContact(b, i, p, nrm, sd.w, usize.from(bi));
          }
        }
        c = c + 1usize;
      }
      c = 0usize;
      while c < nh {
        let sd = heightfieldDistance(&*b.heightfields[c], p);
        if sd.w < r { p = resolveContact(b, i, p, Vec3(sd.x, sd.y, sd.z), r - sd.w); }
        c = c + 1usize;
      }
      let sf = field(p);
      if sf.w < r { p = resolveContact(b, i, p, Vec3(sf.x, sf.y, sf.z), r - sf.w); }
      b.pos.set(i, p);
    }
    i = i + 1usize;
  }
}

// ---- self collision ----
//
// Particles closer than 2 * selfRadius are pushed apart, shared by inverse
// mass, unless they were that close when built (neighbours in the cloth, which
// the constraints already hold: Muller's "Ten Minute Physics" cloth self
// collision test). The neighbours are found in a uniform hash grid with cells
// 2 * selfRadius wide, rebuilt each substep by a counting sort, so the order of
// pairs is fixed. Particles, not triangles: a pair of triangles can still cross
// between particles, so keep the cloth's resolution at the spacing wanted.

fn hashCell(x: i32, y: i32, z: i32, size: u32) u32 {
  let h = (u32.from(x) * 73856093u32) ^ (u32.from(y) * 19349663u32) ^ (u32.from(z) * 83492791u32);
  h % size
}

fn selfCollide(b: &mut SoftBody) {
  let n = b.pos.len();
  let diam = 2. * b.selfRadius;
  if n < 2usize || diam <= 0. { return; }
  let inv = 1. / diam;
  let size = u32.from(2usize * n + 1usize);
  b.cellStart.clear();
  b.cellItems.clear();
  b.cellOf.clear();
  var i = 0usize;
  while i <= usize.from(size) {
    b.cellStart.push(0u32);
    i = i + 1usize;
  }
  i = 0usize;
  while i < n {
    let p = *b.pos[i];
    let hc = hashCell(i32.from((p.x * inv).floor()), i32.from((p.y * inv).floor()), i32.from((p.z * inv).floor()), size);
    b.cellOf.push(hc);
    b.cellStart[usize.from(hc)] = *b.cellStart[usize.from(hc)] + 1u32;
    b.cellItems.push(0u32);
    i = i + 1usize;
  }
  // prefix sums: cellStart[c] is where cell c's items begin
  var acc = 0u32;
  i = 0usize;
  while i < usize.from(size) {
    let cnt = *b.cellStart[i];
    b.cellStart[i] = acc;
    acc = acc + cnt;
    i = i + 1usize;
  }
  b.cellStart[usize.from(size)] = acc;
  // fill, using cellStart as cursors and then restoring it
  i = 0usize;
  while i < n {
    let hc = usize.from(*b.cellOf[i]);
    let at = *b.cellStart[hc];
    b.cellItems[usize.from(at)] = u32.from(i);
    b.cellStart[hc] = at + 1u32;
    i = i + 1usize;
  }
  var c = usize.from(size);
  while c > 0usize {
    b.cellStart[c] = *b.cellStart[c - 1usize];
    c = c - 1usize;
  }
  b.cellStart[0usize] = 0u32;
  // pairs
  let d2 = diam * diam;
  i = 0usize;
  while i < n {
    let pi_ = *b.pos[i];
    let cx = i32.from((pi_.x * inv).floor());
    let cy = i32.from((pi_.y * inv).floor());
    let cz = i32.from((pi_.z * inv).floor());
    var dx = -1i32;
    while dx <= 1i32 {
      var dy = -1i32;
      while dy <= 1i32 {
        var dz = -1i32;
        while dz <= 1i32 {
          let hc = usize.from(hashCell(cx + dx, cy + dy, cz + dz, size));
          var k = usize.from(*b.cellStart[hc]);
          let kend = usize.from(*b.cellStart[hc + 1usize]);
          while k < kend {
            let j = usize.from(*b.cellItems[k]);
            k = k + 1usize;
            if j <= i { continue; }
            let pa = *b.pos[i];
            let pb = *b.pos[j];
            let d = pa - pb;
            let l2 = d.lengthSquared();
            if l2 >= d2 || l2 < 1e-14 { continue; }
            if (*b.rest[i] - *b.rest[j]).lengthSquared() < d2 { continue; }
            let wa = *b.invMass[i];
            let wb = *b.invMass[j];
            if wa + wb <= 0. { continue; }
            let len = l2.sqrt();
            let s = (diam - len) / (len * (wa + wb));
            b.pos.set(i, pa + d * (s * wa));
            b.pos.set(j, pb - d * (s * wb));
          }
          dz = dz + 1i32;
        }
        dy = dy + 1i32;
      }
      dx = dx + 1i32;
    }
    i = i + 1usize;
  }
}
