// ======== Generators: cloth, rope, chain and envelopes ========

// What a fabric is made of. 'density' is kg per square metre; the compliances
// are XPBD's, each the inverse of an energy stiffness (0 is rigid). Stretch and
// shear are metres per newton: a link of compliance a stretches a * T under
// tension T. Bend is radians squared per joule: a hinge of compliance a stores
// (angle error)^2 / (2 a) joules. Cotton's bending rigidity (about 1e-4 to
// 1e-3 N m) is a hinge stiffness near 1e-3 J/rad^2, a compliance near 1e3; a
// compliance of 1 or less is a plate. A negative bend compliance leaves bending
// out.
pub struct Fabric {
  pub density f32;
  pub stretch f32;
  pub shear f32;
  pub bend f32;
  pub thickness f32;       // particle radius for collisions, metres

  // Light cloth: a curtain or flag (about 0.2 kg per square metre)
  pub fn light() Fabric {new Fabric(0.2, 1e-5, 1e-4, 500., 0.01);}

  // Heavy cloth: canvas, a cloak or a balloon's envelope (about 0.5 kg per square metre)
  pub fn heavy() Fabric {new Fabric(0.5, 1e-5, 1e-4, 50., 0.01);}
}

// ---- building a surface from triangles ----

struct EdgeRec {
  a u32;
  b u32;
  opp0 u32;
  opp1 u32;
  count u32;
}

fn edgeKey(a u32, b u32) u64 {
  if a < b {(u64.from(a) << 32u64) | u64.from(b);}
  else {(u64.from(b) << 32u64) | u64.from(a);}
}

// Give the body its triangles, particle masses from the triangle areas, a
// stretch constraint for each edge and a bending constraint for each edge two
// triangles share, all held at the present shape. 'rest' scales the rest
// lengths (1: as built). Triangles must be wound the same way throughout.
fn buildSurface(b &mut SoftBody, tris &Array[u32], f &Fabric, restScale f32) {
  let np = b.pos.len();
  var area = List[f32].empty();
  var i = 0usize;
  while i < np {
    area.push(0.);
    i = i + 1usize;
  }
  var t = 0usize;
  while t + 2usize < tris.len() {
    let a = tris[t];
    let bb = tris[t + 1usize];
    let c = tris[t + 2usize];
    let pa = *b.pos[usize.from(a)];
    let ar = 0.5 * (*b.pos[usize.from(bb)] - pa).cross(*b.pos[usize.from(c)] - pa).length();
    area.set(usize.from(a), *area[usize.from(a)] + ar / 3.);
    area.set(usize.from(bb), *area[usize.from(bb)] + ar / 3.);
    area.set(usize.from(c), *area[usize.from(c)] + ar / 3.);
    b.tris.push(a);
    b.tris.push(bb);
    b.tris.push(c);
    t = t + 3usize;
  }
  i = 0usize;
  while i < np {
    let m = fmax(*area[i] * f.density, 1e-5);
    b.mass.set(i, m);
    b.invMass.set(i, 1. / m);
    i = i + 1usize;
  }
  var recs = List[EdgeRec].empty();
  var index = Dict[u64, u32].deterministic();
  t = 0usize;
  while t + 2usize < tris.len() {
    var e = 0usize;
    while e < 3usize {
      let a = tris[t + e];
      let bb = tris[t + (e + 1usize) % 3usize];
      let opp = tris[t + (e + 2usize) % 3usize];
      let key = edgeKey(a, bb);
      var found = 0xFFFFFFFFu32;
      match index.getCopy(&key) {
        case let h Some { found = h; }
        case is None { }
      }
      if found == 0xFFFFFFFFu32 {
        index.insert(key, u32.from(recs.len()));
        recs.push(new EdgeRec(a, bb, opp, 0xFFFFFFFFu32, 1u32));
      } else {
        let fi = usize.from(found);
        recs[fi].count = recs[fi].count + 1u32;
        if recs[fi].count == 2u32 { recs[fi].opp1 = opp; }
      }
      e = e + 1usize;
    }
    t = t + 3usize;
  }
  var k = 0usize;
  while k < recs.len() {
    let r = *recs[k];
    let pa = *b.pos[usize.from(r.a)];
    let pb = *b.pos[usize.from(r.b)];
    b.dist.push(new DistanceC(r.a, r.b, pa.distance(pb) * restScale, f.stretch, 0.));
    if r.count == 2u32 and f.bend >= 0. {
      b.addBend(r.a, r.b, r.opp0, r.opp1, f.bend);
    }
    k = k + 1usize;
  }
  b.thickness = f.thickness;
}

// ---- cloth ----

// A rectangular cloth: the corner 'origin', edges 'across' and 'down' (vectors
// whose lengths are the sides), cut into nx by ny squares of two triangles
// each, (nx + 1)(ny + 1) particles row by row along 'across'. The front face is
// the side 'across' x 'down' points to. Diagonal edges are the shear
// constraints (Fabric.shear), the rest stretch (Fabric.stretch); every interior
// edge is bent (Fabric.bend). Output vertices are the particles, with uvs
// (0, 0) at 'origin' to (1, 1) at the far corner; v runs along 'down'.
pub fn clothGrid(origin Vec3, across Vec3, down Vec3, nx u32, ny u32, f &Fabric) SoftBody {
  var b = SoftBody.empty();
  let cols = nx + 1u32;
  var tris = List[u32].empty();
  var j = 0u32;
  while j <= ny {
    var i = 0u32;
    while i <= nx {
      let u = f32.from(i) / f32.from(nx);
      let v = f32.from(j) / f32.from(ny);
      b.addParticle(origin + across * u + down * v, 1.);
      b.vertexMap.push(j * cols + i);
      b.vertexUvs.push(new Vec2(u, v));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  j = 0u32;
  while j < ny {
    var i = 0u32;
    while i < nx {
      let a = j * cols + i;
      let bb = a + 1u32;
      let c = a + cols;
      let d = c + 1u32;
      // quads split along the bb-c diagonal; both triangles face across x down
      tris.push(a);
      tris.push(bb);
      tris.push(c);
      tris.push(bb);
      tris.push(d);
      tris.push(c);
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  buildSurface(&mut b, tris.view(), f, 1.);
  b.vertexTris = tris;
  // diagonals are shear
  var k = 0usize;
  while k < b.dist.len() {
    let c = *b.dist[k];
    let ra = c.a / cols;
    let rb = c.b / cols;
    let ca = c.a % cols;
    let cb = c.b % cols;
    if ra != rb and ca != cb { b.dist[k].compliance = f.shear; }
    k = k + 1usize;
  }
  b;
}

// A soft body from a triangle mesh: vertices at the same place (a uv seam, the
// poles of a sphere) are welded into one particle (within 'weld' metres), the
// edges become stretch constraints and the edges between triangles bending
// ones. 'restScale' scales every rest length (an envelope sewn bigger than the
// shape it starts in). The output keeps the mesh's own vertices, uvs and
// indices.
pub fn fromMesh(m &Mesh, f &Fabric, weld f32, restScale f32) SoftBody {
  var b = SoftBody.empty();
  let nv = m.positions.len();
  let inv = 1. / weld;
  var cells = Dict[u64, u32].deterministic();
  var i = 0usize;
  while i < nv {
    let p = *m.positions[i];
    let cx = i32.from(floorf(p.x * inv));
    let cy = i32.from(floorf(p.y * inv));
    let cz = i32.from(floorf(p.z * inv));
    var hit = 0xFFFFFFFFu32;
    var dx = -1i32;
    while dx <= 1i32 and hit == 0xFFFFFFFFu32 {
      var dy = -1i32;
      while dy <= 1i32 and hit == 0xFFFFFFFFu32 {
        var dz = -1i32;
        while dz <= 1i32 and hit == 0xFFFFFFFFu32 {
          let wk = weldKey(cx + dx, cy + dy, cz + dz);
          match cells.getCopy(&wk) {
            case let h Some {
              if (*b.pos[usize.from(h)] - p).lengthSquared() <= weld * weld { hit = h; }
            }
            case is None { }
          }
          dz = dz + 1i32;
        }
        dy = dy + 1i32;
      }
      dx = dx + 1i32;
    }
    if hit == 0xFFFFFFFFu32 {
      hit = b.addParticle(p, 1.);
      cells.insert(weldKey(cx, cy, cz), hit);
    }
    b.vertexMap.push(hit);
    i = i + 1usize;
  }
  var tris = List[u32].empty();
  var t = 0usize;
  while t < m.indices.len() {
    tris.push(*b.vertexMap[usize.from(*m.indices[t])]);
    t = t + 1usize;
  }
  i = 0usize;
  while i < m.uvs.len() {
    b.vertexUvs.push(*m.uvs[i]);
    i = i + 1usize;
  }
  buildSurface(&mut b, tris.view(), f, restScale);
  i = 0usize;
  while i < m.indices.len() {
    b.vertexTris.push(*m.indices[i]);
    i = i + 1usize;
  }
  b;
}

fn weldKey(x i32, y i32, z i32) u64 {
  ((u64.from(x as u32) & 0x1FFFFFu64) << 42u64) | ((u64.from(y as u32) & 0x1FFFFFu64) << 21u64)
    | (u64.from(z as u32) & 0x1FFFFFu64);
}

// A closed envelope: the mesh 'm' made a soft body that pressure inflates. Its
// edges are sewn 'restScale' times as long as the mesh draws them (so the
// fabric is cut for the inflated shape, as a balloon's gores are), and the
// volume constraint holds it at 'pressure' times the volume of the mesh scaled
// by restScale (1: that of the cut pattern; above 1 it stretches). The mesh
// must be closed and outward-wound. A restScale far from 1 starts the envelope
// out of its pattern and inflates it in one violent step; to inflate gently
// build with restScale 1 and call 'scaleRest' a little each step.
pub fn pressureBody(m &Mesh, f &Fabric, restScale f32, pressure f32, compliance f32) SoftBody {
  var b = fromMesh(m, f, 1e-4, restScale);
  b.pressure = new PressureC(true, b.volume() * restScale * restScale * restScale, pressure, compliance, 0.);
  b;
}

// ---- ropes and chains ----

// A rope through the points: a particle at each, a stretch constraint between
// neighbours and, when 'bend' is not negative, a curvature constraint on each
// three in a row (CurveC), held at the curvature the points have, which is how
// a rope resists bending: its compliance is the rope's softness (0 makes a rigid
// rod, a large one a free chain; a compliance of 1e-3 m/N lets 1 N bend a link
// by about a millimetre). 'linearDensity' is kg per metre, 'radius' the rope's
// radius for collisions and wind. The first and last particles are free; pin
// them or attach them as the use asks.
pub fn rope(points &Array[Vec3], linearDensity f32, stretch f32, bend f32, radius f32) SoftBody {
  var b = SoftBody.empty();
  let n = points.len();
  var i = 0usize;
  while i < n {
    var len = 0.;
    if i > 0usize { len = len + (points[i] - points[i - 1usize]).length() * 0.5; }
    if i + 1usize < n { len = len + (points[i + 1usize] - points[i]).length() * 0.5; }
    b.addParticle(points[i], fmax(len * linearDensity, 1e-5));
    i = i + 1usize;
  }
  i = 0usize;
  while i + 1usize < n {
    b.addDistance(u32.from(i), u32.from(i + 1usize), stretch);
    b.ropeSegments.push(u32.from(i));
    b.ropeSegments.push(u32.from(i + 1usize));
    i = i + 1usize;
  }
  if bend >= 0. {
    i = 0usize;
    while i + 2usize < n {
      b.addCurve(u32.from(i), u32.from(i + 1usize), u32.from(i + 2usize), bend);
      i = i + 1usize;
    }
  }
  b.thickness = radius;
  b.ropeRadius = radius;
  b;
}

// A rope of 'segments' links hanging in a straight line from 'start' to 'end'
pub fn ropeBetween(start Vec3, end Vec3, segments u32, linearDensity f32, stretch f32, bend f32, radius f32) SoftBody {
  var pts = List[Vec3].empty();
  var i = 0u32;
  while i <= segments {
    pts.push(start.lerp(end, f32.from(i) / f32.from(segments)));
    i = i + 1u32;
  }
  rope(pts.view(), linearDensity, stretch, bend, radius);
}

// A chain: a rope with no bending resistance (links turn freely), the form of a
// hanging lantern's chain
pub fn chain(points &Array[Vec3], linearDensity f32, stretch f32, radius f32) SoftBody {
  rope(points, linearDensity, stretch, -1., radius);
}

// ---- long range attachments ----

// Give every particle a tether to the nearest pinned or attached particle, as
// long as the distance along the stretch constraints between them (their rest
// lengths summed along the shortest path: Dijkstra's, by repeated relaxation,
// since the graph's order is usually near a good one) times 'slack' (1.0: the
// cloth cannot stretch past its rest length from its pins; 1.02: 2% more).
// Call it after pinning. Kim, Chentanez and Muller 2012, "Long Range
// Attachments - a method to simulate inextensible clothing in computer games".
//
// A particle held to a body that moves (a BodyAnchor of a Coupled with mass) is a
// tethered particle, not a pin: for the length of a substep it is as heavy as the
// body, a rope's heavy end, and the tether to the pin it hangs from is what holds
// it where the rope's length puts it (a Gauss-Seidel pass over a chain does not
// carry a heavy load's weight down the chain: the stretch it leaves grows with
// the mass ratio and the links).
pub fn addTethers(b &mut SoftBody, slack f32) {
  let n = b.pos.len();
  var held = List[bool].empty();
  var i = 0usize;
  while i < n { held.push(false); i = i + 1usize; }
  i = 0usize;
  while i < b.bodyAnchors.len() {
    let a = *b.bodyAnchors[i];
    if (*b.bodies[usize.from(a.body)]).invMass > 0. { held.set(usize.from(a.particle), true); }
    i = i + 1usize;
  }
  var best = List[f32].empty();
  var src = List[u32].empty();
  i = 0usize;
  while i < n {
    if *b.invMass[i] == 0. and not *held[i] {
      best.push(0.);
      src.push(u32.from(i));
    } else {
      best.push(1e30);
      src.push(0xFFFFFFFFu32);
    }
    i = i + 1usize;
  }
  let edges = b.dist.len();
  var changed = true;
  var pass = 0usize;
  while changed and pass <= n {
    changed = false;
    pass = pass + 1usize;
    var k = 0usize;
    while k < edges {
      let c = *b.dist[k];
      let ia = usize.from(c.a);
      let ib = usize.from(c.b);
      k = k + 1usize;
      if *best[ia] + c.rest < *best[ib] {
        best.set(ib, *best[ia] + c.rest);
        src.set(ib, *src[ia]);
        changed = true;
      }
      if *best[ib] + c.rest < *best[ia] {
        best.set(ia, *best[ib] + c.rest);
        src.set(ia, *src[ib]);
        changed = true;
      }
    }
  }
  i = 0usize;
  while i < n {
    if (*b.invMass[i] > 0. or *held[i]) and *src[i] != 0xFFFFFFFFu32 {
      b.tethers.push(new TetherC(u32.from(i), *src[i], *best[i] * slack));
    }
    i = i + 1usize;
  }
}
