// ======== Wind: aerodynamic drag and lift on each triangle ========
//
// Each triangle is a flat plate in the air moving past it at 'vr' = wind - the
// triangle's velocity (the mean of its corners'). With q = 1/2 rho |vr|^2, area
// A, unit normal n, flow direction d = vr / |vr| and s = |n . d| (the sine of
// the angle of attack alpha, between the flow and the plate):
//
//   drag   = q A (Cf + Cd s) d          along the flow: skin friction on the
//                                       whole area plus pressure drag on the
//                                       area the flow sees (A s)
//   lift   = q A Cl sin(2 alpha) l      perpendicular to the flow, away from the
//                                       windward face; sin(2 alpha) is the thin
//                                       flat plate's lift curve, 2 pi sin cos at
//                                       small angles (Cl = 1 gives pi)
//
// A third of the force goes to each corner. It is the usual game-cloth model
// (the same split as NVIDIA Flex's cloth and PhysX's drag and lift
// coefficients), not CFD: no stall, no wake, no shielding of one triangle by
// another. A rope's segment is a cylinder: cross-flow drag only, 1/2 rho Cd d L
// |v_perp| v_perp, on each segment's component of the flow across it.

fn applyWind(b &mut SoftBody, wind Vec3) {
  imm n = b.pos.len();
  mut force = b.force.viewMut();
  imm pos = b.pos.view();
  imm vel = b.vel.view();
  imm tris = b.tris.view();
  mut i = 0usize;
  while i < n {
    force[i] = zero3();
    i = i + 1usize;
  }
  imm rho = b.airDensity;
  if rho <= 0. { return; }
  mut t = 0usize;
  imm nt = tris.len();
  while t + 2usize < nt {
    imm i0 = usize.from(tris[t]);
    imm i1 = usize.from(tris[t + 1usize]);
    imm i2 = usize.from(tris[t + 2usize]);
    t = t + 3usize;
    imm p0 = pos[i0];
    imm p1 = pos[i1];
    imm p2 = pos[i2];
    imm cr = (p1 - p0).cross(p2 - p0);
    imm a2 = cr.length();
    if a2 < 1e-10 { continue; }
    imm area = 0.5 * a2;
    imm nrm = cr * (1. / a2);
    imm vtri = (vel[i0] + vel[i1] + vel[i2]) * (1. / 3.);
    imm vr = wind - vtri;
    imm speed = vr.length();
    if speed < 1e-4 { continue; }
    imm d = vr * (1. / speed);
    imm nd = nrm.dot(d);
    imm sa = fabs(nd);
    imm q = 0.5 * rho * speed * speed * area;
    mut f = d * (q * (b.skinCoeff + b.dragCoeff * sa));
    // lift: perpendicular to d, away from the face the wind meets
    imm nf = if nd < 0. {nrm;} else {-nrm;};
    imm lp = nf * -1. + d * nf.dot(d);
    f = f + lp * (q * b.liftCoeff * 2. * sa);
    imm third = f * (1. / 3.);
    force[i0] = force[i0] + third;
    force[i1] = force[i1] + third;
    force[i2] = force[i2] + third;
  }
  // ropes
  if b.ropeRadius > 0. {
    imm segs = b.ropeSegments.view();
    mut k = 0usize;
    while k + 1usize < segs.len() {
      imm ia = usize.from(segs[k]);
      imm ib = usize.from(segs[k + 1usize]);
      k = k + 2usize;
      imm pa = pos[ia];
      imm pb = pos[ib];
      imm axis = pb - pa;
      imm len = axis.length();
      if len < 1e-9 { continue; }
      imm u = axis * (1. / len);
      imm vseg = (vel[ia] + vel[ib]) * 0.5;
      imm vr = wind - vseg;
      imm vperp = vr - u * vr.dot(u);
      imm sp = vperp.length();
      if sp < 1e-4 { continue; }
      imm f = vperp * (0.5 * rho * b.ropeDrag * 2. * b.ropeRadius * len * sp);
      force[ia] = force[ia] + f * 0.5;
      force[ib] = force[ib] + f * 0.5;
    }
  }
}
