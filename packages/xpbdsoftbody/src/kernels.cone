// ======== The step's inner loops, over raw pointers ========
//
// The loops that run for every particle or every constraint of a batch live
// here, written over a StepView: raw pointers into the body's lists, valid for
// one substep (nothing is pushed to a list while it is used). A loop takes a
// range [lo, hi) of its items, so the same code runs the whole range on one
// thread or a slice of it on each of several (workers.cone). Nothing in a range
// touches a particle another range of the same batch touches (the batches are
// colours, batch.cone), and the wind gathers into the particle that owns the
// sum, so every slicing gives the same bits.
//
// Items are not bounds-checked here: the caller (solve.cone) makes the ranges
// from the lists' own lengths.

pub const R_WIND_TRI = 0u32;      // aerodynamic force of each triangle in the range
pub const R_WIND_GATHER = 1u32;   // sum the triangles' forces onto each particle in the range
pub const R_PREDICT = 2u32;       // semi-implicit Euler for each particle
pub const R_DIST = 3u32;          // stretch constraints
pub const R_BEND = 4u32;          // dihedral bending constraints
pub const R_CURVE = 5u32;         // rope curvature constraints
pub const R_VELOCITY = 6u32;      // new velocities from the moved positions
pub const R_BEND_CURV = 7u32;     // bending by the curvature vector
pub const R_TETHER = 8u32;        // long range tethers
pub const R_LIMIT = 9u32;         // strain limiting

pub struct StepView is Sendable {
  pub pos *Vec3;
  pub prev *Vec3;
  pub vel *Vec3;
  pub force *Vec3;
  pub invMass *f32;
  pub tris *u32;
  pub triForce *Vec3;
  pub adjStart *u32;
  pub adj *u32;
  pub dist *DistanceC;
  pub bend *BendC;
  pub curves *CurveC;
  pub tethers *TetherC;
  pub h f32;               // the substep
  pub hBend f32;           // the time the bend constraints take this substep (a multiple of h)
  pub first bool;          // the first iteration of the substep: every multiplier is zero
  pub damp f32;            // 1 / (1 + damping h)
  pub omega f32;           // over-relaxation of the stretch projections (1: none)
  pub strainCap f32;       // 1 + the strain limit
  pub gravity Vec3;
  pub wind Vec3;
  pub windOn bool;
  pub rho f32;
  pub skin f32;
  pub drag f32;
  pub lift f32;
  // a lattice of wind velocities (SoftBody.windGrid), nx by ny by nz, x fastest; gnx 0: none
  pub grid *Vec3;
  pub gridOrigin Vec3;
  pub gridInv f32;         // 1 / cell
  pub gnx u32;
  pub gny u32;
  pub gnz u32;
}

// The wind at p: trilinear between the lattice's samples (held at the edge
// beyond it), or the one velocity the step was given when there is no lattice
fn windAt(v &StepView, p Vec3) Vec3 {
  if v.gnx == 0u32 { return v.wind; }
  sampleWindGrid(v.grid, v.gridOrigin, v.gridInv, v.gnx, v.gny, v.gnz, p)
}

fn clampIndex(t f32, n u32) f32 {
  let top = f32.from(n - 1u32);
  if t < 0. {0.} elif t > top {top} else {t};
}

pub fn sampleWindGrid(grid *Vec3, origin Vec3, inv f32, nx u32, ny u32, nz u32, p Vec3) Vec3 {
  let fx = clampIndex((p.x - origin.x) * inv, nx);
  let fy = clampIndex((p.y - origin.y) * inv, ny);
  let fz = clampIndex((p.z - origin.z) * inv, nz);
  let ix0 = usize.from(fx);
  let iy0 = usize.from(fy);
  let iz0 = usize.from(fz);
  let ix1 = if ix0 + 1usize < usize.from(nx) {ix0 + 1usize} else {ix0};
  let iy1 = if iy0 + 1usize < usize.from(ny) {iy0 + 1usize} else {iy0};
  let iz1 = if iz0 + 1usize < usize.from(nz) {iz0 + 1usize} else {iz0};
  let tx = fx - f32.from(ix0);
  let ty = fy - f32.from(iy0);
  let tz = fz - f32.from(iz0);
  let row = usize.from(nx);
  let layer = row * usize.from(ny);
  let c000 = *(grid + iz0 * layer + iy0 * row + ix0);
  let c100 = *(grid + iz0 * layer + iy0 * row + ix1);
  let c010 = *(grid + iz0 * layer + iy1 * row + ix0);
  let c110 = *(grid + iz0 * layer + iy1 * row + ix1);
  let c001 = *(grid + iz1 * layer + iy0 * row + ix0);
  let c101 = *(grid + iz1 * layer + iy0 * row + ix1);
  let c011 = *(grid + iz1 * layer + iy1 * row + ix0);
  let c111 = *(grid + iz1 * layer + iy1 * row + ix1);
  let x00 = c000 + (c100 - c000) * tx;
  let x10 = c010 + (c110 - c010) * tx;
  let x01 = c001 + (c101 - c001) * tx;
  let x11 = c011 + (c111 - c011) * tx;
  let y0 = x00 + (x10 - x00) * ty;
  let y1 = x01 + (x11 - x01) * ty;
  y0 + (y1 - y0) * tz
}

// atan2 to about 1e-5 radians: the arctangent of the ratio of the smaller to the
// larger magnitude by an odd degree-9 polynomial (the coefficients are the
// minimax fit given in Abramowitz and Stegun 4.4.49's spirit, refit for degree 9),
// then unfolded to the quadrant. The libm call it replaces was a quarter of a
// bend's cost; a bend error of 1e-5 rad is far below what the constraint resolves.
fn atan2Fast(y f32, x f32) f32 inline {
  let ax = fabs(x);
  let ay = fabs(y);
  let hi = if ax > ay {ax} else {ay};
  let lo = if ax > ay {ay} else {ax};
  if hi < 1e-30 { return 0.; }
  let a = lo / hi;
  let s = a * a;
  var r = a * (0.9998660 + s * (-0.3302995 + s * (0.1801410 + s * (-0.0851330 + s * 0.0208351))));
  if ay > ax { r = 1.5707964 - r; }
  if x < 0. { r = 3.1415927 - r; }
  if y < 0. { r = -r; }
  r
}

fn windTriRange(v &StepView, lo usize, hi usize) {
  let wind = v.wind;
  let rho = v.rho;
  var t = lo;
  while t < hi {
    let i0 = usize.from(*(v.tris + 3usize * t));
    let i1 = usize.from(*(v.tris + 3usize * t + 1usize));
    let i2 = usize.from(*(v.tris + 3usize * t + 2usize));
    let p0 = *(v.pos + i0);
    let p1 = *(v.pos + i1);
    let p2 = *(v.pos + i2);
    let cr = (p1 - p0).cross(p2 - p0);
    let a2 = cr.length();
    var third = new Vec3(0., 0., 0.);
    if a2 >= 1e-10 {
      let area = 0.5 * a2;
      let nrm = cr * (1. / a2);
      let vtri = (*(v.vel + i0) + *(v.vel + i1) + *(v.vel + i2)) * (1. / 3.);
      let vr = (if v.gnx == 0u32 {wind} else {windAt(v, (p0 + p1 + p2) * (1. / 3.))}) - vtri;
      let speed = vr.length();
      if speed >= 1e-4 {
        let d = vr * (1. / speed);
        let nd = nrm.dot(d);
        let sa = fabs(nd);
        let q = 0.5 * rho * speed * speed * area;
        let nf = if nd < 0. {nrm} else {-nrm};
        let lp = nf * -1. + d * nf.dot(d);
        let f = d * (q * (v.skin + v.drag * sa)) + lp * (q * v.lift * 2. * sa);
        third = f * (1. / 3.);
      }
    }
    *(v.triForce + t) = third;
    t = t + 1usize;
  }
}

fn windGatherRange(v &StepView, lo usize, hi usize) {
  var i = lo;
  while i < hi {
    var f = new Vec3(0., 0., 0.);
    if v.windOn {
      var k = usize.from(*(v.adjStart + i));
      let kend = usize.from(*(v.adjStart + i + 1usize));
      while k < kend {
        f = f + *(v.triForce + usize.from(*(v.adj + k)));
        k = k + 1usize;
      }
    }
    *(v.force + i) = f;
    i = i + 1usize;
  }
}

fn predictRange(v &StepView, lo usize, hi usize) {
  let h = v.h;
  var i = lo;
  while i < hi {
    let p = *(v.pos + i);
    *(v.prev + i) = p;
    let w = *(v.invMass + i);
    if w > 0. {
      let vel = *(v.vel + i) + (v.gravity + *(v.force + i) * w) * h;
      *(v.vel + i) = vel;
      *(v.pos + i) = p + vel * h;
    }
    i = i + 1usize;
  }
}

fn velocityRange(v &StepView, lo usize, hi usize) {
  let k = (1. / v.h) * v.damp;
  var i = lo;
  while i < hi {
    if *(v.invMass + i) > 0. { *(v.vel + i) = (*(v.pos + i) - *(v.prev + i)) * k; }
    i = i + 1usize;
  }
}

// ---- stretch ----
//
// C = |pa - pb| - rest, gradients +-u, XPBD's correction with compliance alpha / h^2.
// At the first iteration the multiplier is zero and the correction is
// -C / (wa + wb + alpha / h^2); it is stored as the constraint's multiplier,
// whose size over h^2 is the force (breaking reads it).
fn distRange(v &StepView, lo usize, hi usize) {
  let inv2 = 1. / (v.h * v.h);
  let first = v.first;
  var k = lo;
  while k < hi {
    let cp = v.dist + k;
    let c = *cp;
    k = k + 1usize;
    let ia = usize.from(c.a);
    let ib = usize.from(c.b);
    let wa = *(v.invMass + ia);
    let wb = *(v.invMass + ib);
    let w = wa + wb;
    if w > 0. {
      let pa = *(v.pos + ia);
      let pb = *(v.pos + ib);
      let d = pa - pb;
      let len = d.length();
      if len > 1e-9 {
        let alpha = c.compliance * inv2;
        let lam = if first {0.} else {c.lambda};
        let dl = (-(len - c.rest) - alpha * lam) / (w + alpha) * v.omega;
        (*cp).lambda = lam + dl;
        let s = dl / len;
        *(v.pos + ia) = pa + d * (s * wa);
        *(v.pos + ib) = pb - d * (s * wb);
      }
    }
  }
}

// ---- bending ----
//
// The dihedral angle between triangles (a, b, c) and (b, a, d) held at its rest
// value (Muller et al. 2007 "Position Based Dynamics", with the gradients of
// Bridson, Marino and Fedkiw 2003 and the angle from atan2 of unnormalised
// quantities, as the unfused form has always had). The divisions are shared.
fn bendRange(v &StepView, lo usize, hi usize) {
  let hb = v.hBend;
  let inv2 = 1. / (hb * hb);
  let first = v.first;
  let pi2 = 6.2831855;
  var k = lo;
  while k < hi {
    let cp = v.bend + k;
    let c = *cp;
    k = k + 1usize;
    let ia = usize.from(c.a);
    let ib = usize.from(c.b);
    let ic = usize.from(c.c);
    let id = usize.from(c.d);
    let wa = *(v.invMass + ia);
    let wb = *(v.invMass + ib);
    let wc = *(v.invMass + ic);
    let wd = *(v.invMass + id);
    if wa + wb + wc + wd > 0. {
      let pa = *(v.pos + ia);
      let pb = *(v.pos + ib);
      let pc = *(v.pos + ic);
      let pd = *(v.pos + id);
      let e = pb - pa;
      let e2 = e.lengthSquared();
      let nc = e.cross(pc - pa);
      let nd = (-e).cross(pd - pb);
      let lc2 = nc.lengthSquared();
      let ld2 = nd.lengthSquared();
      if e2 > 1e-18 and lc2 > 1e-18 and ld2 > 1e-18 {
        // three divisions where seven were: 1/e^2, one for both 1/|nc|^2 and 1/|nd|^2, and the angle's
        let ie2 = 1. / e2;
        let elen = e2.sqrt();
        let both = 1. / (lc2 * ld2);
        let ilc = ld2 * both;
        let ild = lc2 * both;
        var err = atan2Fast(nc.cross(nd).dot(e) * (elen * ie2), nc.dot(nd)) - c.rest;
        if err > 3.1415927 { err = err - pi2; }
        if err < -3.1415927 { err = err + pi2; }
        let gc = nc * (-elen * ilc);
        let gd = nd * (-elen * ild);
        let tc = (pc - pa).dot(e) * ie2;
        let td = (pd - pa).dot(e) * ie2;
        let ga = gc * (tc - 1.) + gd * (td - 1.);
        let gb = gc * (-tc) + gd * (-td);
        let sum = wa * ga.lengthSquared() + wb * gb.lengthSquared() + wc * gc.lengthSquared() + wd * gd.lengthSquared();
        if sum > 1e-12 {
          let alpha = c.compliance * inv2;
          let lam = if first {0.} else {c.lambda};
          let dl = (-err - alpha * lam) / (sum + alpha);
          (*cp).lambda = lam + dl;
          *(v.pos + ia) = pa + ga * (wa * dl);
          *(v.pos + ib) = pb + gb * (wb * dl);
          *(v.pos + ic) = pc + gc * (wc * dl);
          *(v.pos + id) = pd + gd * (wd * dl);
        }
      }
    }
  }
}

// ---- strain limiting ----
//
// Provot 1995: a stretch edge longer than rest * (1 + limit) is brought back to that length, shared by
// inverse mass. Taken a batch at a time like the stretch constraints.
fn limitRange(v &StepView, lo usize, hi usize) {
  let cap = v.strainCap;
  var k = lo;
  while k < hi {
    let c = *(v.dist + k);
    k = k + 1usize;
    let ia = usize.from(c.a);
    let ib = usize.from(c.b);
    let wa = *(v.invMass + ia);
    let wb = *(v.invMass + ib);
    if wa + wb > 0. {
      let pa = *(v.pos + ia);
      let pb = *(v.pos + ib);
      let d = pa - pb;
      let l2 = d.lengthSquared();
      let longest = c.rest * cap;
      if l2 > longest * longest {
        let len = l2.sqrt();
        let s = (len - longest) / (len * (wa + wb));
        *(v.pos + ia) = pa - d * (s * wa);
        *(v.pos + ib) = pb + d * (s * wb);
      }
    }
  }
}

// ---- long range tethers ----
//
// A particle farther from its anchor than its tether is brought back by the excess (an inequality:
// slack costs nothing). The anchor is a pin and never moves, so no two tethers touch the same
// particle's position and they may be taken in any order, or at once.
fn tetherRange(v &StepView, lo usize, hi usize) {
  var k = lo;
  while k < hi {
    let t = *(v.tethers + k);
    k = k + 1usize;
    let ip = usize.from(t.particle);
    if *(v.invMass + ip) > 0. {
      let pa = *(v.pos + usize.from(t.anchor));
      let pp = *(v.pos + ip);
      let d = pp - pa;
      let l2 = d.lengthSquared();
      if l2 > t.maxLength * t.maxLength and l2 > 1e-18 {
        let len = l2.sqrt();
        *(v.pos + ip) = pa + d * (t.maxLength / len);
      }
    }
  }
}

// ---- bending by the curvature vector ----
//
// A hinge's curvature vector H = K0 a + K1 b + K2 c + K3 d (solve.cone says where K comes from) is zero
// when the hinge is flat and has the length e h_c h_d theta when it is folded by a small angle theta.
// C = |H| with gradients K_i H / |H|; the compliance is the hinge's times (e h_c h_d)^2, so a fold of theta
// costs theta^2 / (2 compliance) as in the dihedral constraint. No angle, no cross product, no
// per-constraint divisions but two: it costs about what a stretch constraint does.
fn bendCurvRange(v &StepView, lo usize, hi usize) {
  let hb = v.hBend;
  let inv2 = 1. / (hb * hb);
  let first = v.first;
  var k = lo;
  while k < hi {
    let cp = v.bend + k;
    let c = *cp;
    k = k + 1usize;
    let ia = usize.from(c.a);
    let ib = usize.from(c.b);
    let ic = usize.from(c.c);
    let id = usize.from(c.d);
    let wa = *(v.invMass + ia);
    let wb = *(v.invMass + ib);
    let wc = *(v.invMass + ic);
    let wd = *(v.invMass + id);
    let sum = wa * c.k0 * c.k0 + wb * c.k1 * c.k1 + wc * c.k2 * c.k2 + wd * c.k3 * c.k3;
    if sum > 0. {
      let pa = *(v.pos + ia);
      let pb = *(v.pos + ib);
      let pc = *(v.pos + ic);
      let pd = *(v.pos + id);
      let hv = pa * c.k0 + pb * c.k1 + pc * c.k2 + pd * c.k3;
      let len = hv.length();
      if len > 1e-12 {
        let u = hv * (1. / len);
        let alpha = c.compliance * c.gain2 * inv2;
        let lam = if first {0.} else {c.lambda};
        let dl = (-len - alpha * lam) / (sum + alpha);
        (*cp).lambda = lam + dl;
        *(v.pos + ia) = pa + u * (wa * c.k0 * dl);
        *(v.pos + ib) = pb + u * (wb * c.k1 * dl);
        *(v.pos + ic) = pc + u * (wc * c.k2 * dl);
        *(v.pos + id) = pd + u * (wd * c.k3 * dl);
      }
    }
  }
}

// ---- rope curvature ----
fn curveRange(v &StepView, lo usize, hi usize) {
  let inv2 = 1. / (v.h * v.h);
  let first = v.first;
  var k = lo;
  while k < hi {
    let cp = v.curves + k;
    let c = *cp;
    k = k + 1usize;
    let ia = usize.from(c.a);
    let ib = usize.from(c.b);
    let ic = usize.from(c.c);
    let wa = *(v.invMass + ia);
    let wb = *(v.invMass + ib);
    let wc = *(v.invMass + ic);
    let sum = wa + 4. * wb + wc;
    if sum > 0. {
      let pa = *(v.pos + ia);
      let pb = *(v.pos + ib);
      let pc = *(v.pos + ic);
      let q = pa - pb * 2. + pc;
      let len = q.length();
      if len > 1e-9 {
        let u = q * (1. / len);
        let alpha = c.compliance * inv2;
        let lam = if first {0.} else {c.lambda};
        let dl = (-(len - c.rest) - alpha * lam) / (sum + alpha);
        (*cp).lambda = lam + dl;
        *(v.pos + ia) = pa + u * (wa * dl);
        *(v.pos + ib) = pb - u * (2. * wb * dl);
        *(v.pos + ic) = pc + u * (wc * dl);
      }
    }
  }
}

// Run one kind of loop over [lo, hi)
pub fn runRegion(v &StepView, kind u32, lo usize, hi usize) {
  if kind == R_DIST { distRange(v, lo, hi); }
  elif kind == R_BEND { bendRange(v, lo, hi); }
  elif kind == R_PREDICT { predictRange(v, lo, hi); }
  elif kind == R_VELOCITY { velocityRange(v, lo, hi); }
  elif kind == R_WIND_TRI { windTriRange(v, lo, hi); }
  elif kind == R_WIND_GATHER { windGatherRange(v, lo, hi); }
  elif kind == R_CURVE { curveRange(v, lo, hi); }
  elif kind == R_BEND_CURV { bendCurvRange(v, lo, hi); }
  elif kind == R_TETHER { tetherRange(v, lo, hi); }
  elif kind == R_LIMIT { limitRange(v, lo, hi); }
}
