// Row 659, case 1 and 4: PR 7's pipeline (socket -> inflate -> sha256 -> file) on today's stages and on the new core,
// in one program, so the two run on the same build and alternate.
//
//   congo run --release packages/streamproto/examples/sample.cone -- <old|new1|new4> [MiB of inflated data]
//
//   old    today's SocketSource, TransformStage, HashStage, FileSink (window 256 KiB, 64 KiB chunks)
//   new1   the new core, each producer awaits its piece's answer (one unanswered piece)
//   new4   the new core, each producer keeps up to four unanswered pieces (kept futures)
//
// It prints the milliseconds from the server's start to the file written, the rate, the tail (from the server's
// last write done to the file sink's report, in ms), the messages the workers handled, and 'ok'.

mod sample;

import stdio use *;
import collections use *;
import iobuf use IoBuf;
import fs;
import path use Path;
import iocore use SocketAddr, IoError, Access;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import time use Instant;
import actors;
import aio use Socket, File;
import streams use *;
import stages use *;
import stageio use *;
import streamproto use *;
import deflate;
import cryptohash;

fn corpus(n: usize) List[u8] {
  let w: Array[&str, 5] = ["alpha ", "beta ", "gamma ", "delta ", "epsilon "];
  var d = List[u8].withCapacity(n + 16usize);
  var s = 7u64;
  while d.len() < n {
    s = s * 6364136223846793005u64 + 1442695040888963407u64;
    let word = w[usize.from((s >> 40u64) % 5u64)];
    var i = 0usize;
    while i < word.len { d.push(word[i]); i += 1usize; }
  }
  d.truncate(n);
  d
}

fn socketOf(r: Result[Socket, IoError]) Socket {
  var res = r;
  var s = Socket.none();
  match &mut res {
    case var &mut Ok(ok) {s <-> *ok;}
    case let &mut Err(e) {
      printStr("socketOf failed: code ");
      printUInt(u64.from(e.code));
      printStr("\n");
      panic("socketOf: the operation failed");
    }
  }
  s
}

fn digits(p: *u8) u32 {
  var n = 0u32;
  var q = p;
  while *q >= 48u8 && *q <= 57u8 {
    n = n * 10u32 + u32.from(*q - 48u8);
    q = q + 1usize;
  }
  n
}

fn same(a: &Array[u8], b: &Array[u8]) bool { a == b }

struct Result0 {
  pub bytes: Atomic[u64];
  pub digestOk: Atomic[u64];
  pub digestErr: Atomic[u64];
  pub failed: Atomic[u64];
  pub sentAt: Atomic[u64];       // the steady clock when the server's last write finished
}

let outcome: Result0;

fn @initpure init() {
  outcome = Result0(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

actor Server {
  gz: List[u8];

  pub fn init(self: &new, gz: List[u8]) {
    *self = Self(gz: gz);
  }

  pub async fn serve(self, port: OneshotSender[u16]) {
    let listener = socketOf(await aio.listen(SocketAddr.localhost(0u16)));
    let addr = await listener.localAddr();
    var p = port;
    match addr {
      case let Ok(a) { p.send(a.port()); }
      case is Err { p.send(0u16); return; }
    }
    let conn = socketOf(await listener.accept());
    var at = 0usize;
    var more = true;
    while more && at < gz.len() {
      let n = if gz.len() - at < 65536usize {gz.len() - at} else {65536usize};
      var buf = IoBuf(n);
      buf.append(&gz.view()[at ..< at + n]);
      at = at + n;
      let sent = await conn.write(buf);
      match sent {
        case is Err { more = false; }
        else {}
      }
    }
    outcome.sentAt.store(u64.from(Instant.now().nanos()));
  }
}

actor Checker is DigestSink[Array[u8, 32]] {
  want: List[u8];

  pub fn init(self: &new, want: List[u8]) {
    *self = Self(want: want);
  }

  pub async fn digest(self, r: Result[Array[u8, 32], AnyError]) {
    match r {
      case let Ok(d) { if same(&d, want.view()) { outcome.digestOk.add(1u64); } }
      case is Err { outcome.digestErr.add(1u64); }
    }
  }
}

// The new core's pipeline: the file is opened first (the sink takes an open file), then the stages are made
// from the sink end back, and the socket end is started
actor Wire {
  pub async fn run(self, port: u16, name: String, want: List[u8], a1: usize, a2: usize, fileTx: OneshotSender[Result[u64, AnyError]]) {
    let opened = await aio.openFile(&Path.from(name.view()), Access.Create);
    var file = File.none();
    match opened {
      case let Ok(f) { file = f; }
      case let Err(e) {
        var tx = fileTx;
        tx.send(Err[u64, AnyError](AnyError.from(e)));
        return;
      }
    }
    let sink = FileTo(file, fileTx);
    let hash = HashPass[cryptohash.Sha256](StreamTo[IoBuf].at(sink, 1u64), cryptohash.Sha256.make(), Checker(want));
    let inf = TransformPass[deflate.Inflater](StreamTo[IoBuf].at(hash, 1u64), deflate.Inflater.make(deflate.Format.Gzip), a2);
    let src = SocketFrom(a1);
    src.run(SocketAddr.localhost(port), StreamTo[IoBuf].at(inf, 1u64));
  }
}

fn main(argc: i32, argv: **u8) i32 {
  initAll();
  var mode = 0u32;                          // 0 old, 1 new
  var mib = 64u32;
  var a1 = 0u32;
  var a2 = 0u32;
  if argc > 1i32 {
    let m = *(argv + 1usize);
    if *m == 110u8 { mode = 1u32; }         // "new"
  }
  if argc > 2i32 { mib = digits(*(argv + 2usize)); }
  if argc > 3i32 { a1 = digits(*(argv + 3usize)); }
  if argc > 4i32 { a2 = digits(*(argv + 4usize)); }
  let size = usize.from(mib) * 1048576usize;
  let data = corpus(size);
  let gz = deflate.gzipCompress(data.view(), 6);
  let digest = cryptohash.sha256(data.view());
  var want = List[u8]();
  want.appendSlice(&digest);
  let name = "streamproto_sample.tmp";

  var portTx: OneshotSender[u16];
  var portRx: OneshotReceiver[u16];
  portTx, portRx = Oneshot[u16].make();
  var fileTx: OneshotSender[Result[u64, AnyError]];
  var fileRx: OneshotReceiver[Result[u64, AnyError]];
  fileTx, fileRx = Oneshot[Result[u64, AnyError]].make();

  let m0 = actors.stats().messages;
  let t0 = Instant.now();
  {
    let server = Server(gz);
    server.serve(portTx);
    var port = 0u16;
    match portRx.recv() {
      case let Some(p) { port = p; }
      case is None {}
    }
    if mode == 0u32 {
      let sink = FileSink(String.from(name), fileTx);
      let hash = HashStage[cryptohash.Sha256](sink, cryptohash.Sha256.make(), Checker(want));
      let inf = TransformStage[deflate.Inflater](hash, deflate.Inflater.make(deflate.Format.Gzip));
      let src = SocketSource(inf);
      src.start(SocketAddr.localhost(port));
    } else {
      let w = Wire();
      w.run(port, String.from(name), want, usize.from(a1), usize.from(a2), fileTx);
    }
  }
  match fileRx.recv() {
    case let Some(r) {
      match r {
        case let Ok(n) { outcome.bytes.store(n); }
        case is Err { outcome.failed.add(1u64); }
      }
    }
    case is None { outcome.failed.add(1u64); }
  }
  let doneAt = u64.from(Instant.now().nanos());
  let ns = u64.from(t0.elapsed().nanos());
  finalAll();
  let msgs = actors.stats().messages - m0;
  let ok = outcome.digestOk.load() == 1u64 && outcome.failed.load() == 0u64 && outcome.bytes.load() == u64.from(size);
  _ = fs.removeFile(&Path.from(name));
  let tail = doneAt - outcome.sentAt.load();
  printStr(if mode == 0u32 {"old"} else {"new"});
  if mode != 0u32 { printStr(" a1="); printUInt(u64.from(a1)); printStr(" a2="); printUInt(u64.from(a2)); }
  printStr(" "); printUInt(u64.from(mib)); printStr(" MiB: ");
  printUInt(ns / 1000000u64); printStr(" ms, ");
  printUInt(u64.from(size) * 1000u64 / ns); printStr(" MB/s, tail ");
  printUInt(tail / 1000u64); printStr(" us, msgs "); printUInt(msgs); printStr(" ");
  printStr(if ok {"ok"} else {"WRONG"}); printStr("\n");
  if ok {0i32} else {1i32}
}
