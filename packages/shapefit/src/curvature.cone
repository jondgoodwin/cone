// ======== Curvature per vertex, and what kind of patch each vertex lies on ========
//
// Principal curvatures and directions by Rusinkiewicz's method ("Estimating
// Curvatures and Their Derivatives on Triangle Meshes", 2004): for each
// triangle, the second fundamental form is the least-squares fit that takes the
// edge vectors to the differences of the vertex normals along them; each corner
// takes it into the frame of its vertex, weighted by the corner's share of the
// vertex's Voronoi area (Meyer et al. 2003, with the obtuse-triangle rule); a
// vertex's sum is diagonalised to give its principal curvatures and directions.
// A polygon is taken as the fan of triangles from its first corner.
//
// The sign convention: with the normals pointing outward, a sphere of radius r
// has k1 = k2 = +1/r (convex is positive, a cup negative). k1 is the greater of
// the two, k2 the lesser; dir1 and dir2 are their unit directions, in the
// tangent plane.
//
// Patch classes, with e the curvature (1/length) below which a surface counts as
// flat:
//   PatchFlat   both |k1| and |k2| at most e
//   PatchDome   both above e (convex in both directions)
//   PatchCup    both below -e (concave in both)
//   PatchSaddle k1 above e and k2 below -e
//   PatchRidge  k1 above e and |k2| at most e (convex along one way, straight the other)
//   PatchValley k2 below -e and |k1| at most e

pub const PatchFlat = 0u32;
pub const PatchDome = 1u32;
pub const PatchCup = 2u32;
pub const PatchSaddle = 3u32;
pub const PatchRidge = 4u32;
pub const PatchValley = 5u32;

pub fn patchName(c u32) &str {
  if c == PatchFlat { "flat"; }
  elif c == PatchDome { "dome"; }
  elif c == PatchCup { "cup"; }
  elif c == PatchSaddle { "saddle"; }
  elif c == PatchRidge { "ridge"; }
  else { "valley"; };
}

pub struct Curvature {
  pub k1 List[f32];        // per vertex: the greater principal curvature
  pub k2 List[f32];        // the lesser
  pub dir1 List[Vec3];     // the direction of k1
  pub dir2 List[Vec3];     // the direction of k2
  pub normal List[Vec3];   // the vertex normals used

  pub fn mean(self &, v usize) f32 { 0.5 * (*k1[v] + *k2[v]); }
  pub fn gaussian(self &, v usize) f32 { *k1[v] * *k2[v]; }
}

fn classify(k1 f32, k2 f32, e f32) u32 {
  if k1 > e and k2 > e { PatchDome; }
  elif k1 < -e and k2 < -e { PatchCup; }
  elif k1 > e and k2 < -e { PatchSaddle; }
  elif k1 > e and k2 >= -e { PatchRidge; }
  elif k2 < -e and k1 <= e { PatchValley; }
  else { PatchFlat; };
}

// The class of a patch with the principal curvatures k1 and k2, and flatness limit e
pub fn classifyPatch(k1 f32, k2 f32, e f32) u32 { classify(k1, k2, e); }

// The class of each vertex
pub fn classifyVertices(c &Curvature, e f32) List[u32] {
  mut out = List[u32].withCapacity(c.k1.len());
  mut v = 0usize;
  while v < c.k1.len() { out.push(classify(*c.k1[v], *c.k2[v], e)); v += 1usize; }
  out;
}

// The flatness limit as a curvature: 1 / (factor x the diagonal of the mesh's
// bounding box); a surface whose radius of curvature exceeds that is flat
pub fn flatCurvature(m &PolyMesh, factor f32) f32 {
  imm b = m.bounds();
  imm diag = (b.max - b.min).length();
  if diag > 0. { 1. / (factor * diag); } else { 1.; };
}

// Rotate the frame (u, v) about the axis that takes its normal u x v onto 'nn',
// so that it lies in the plane with normal nn (Rusinkiewicz's rot_coord_sys)
fn rotateFrame(u DVec3, v DVec3, nn DVec3, nu &mut DVec3, nv &mut DVec3) {
  *nu = u;
  *nv = v;
  imm on = crossd(u, v);
  imm nd = on.dot(nn);
  if nd <= -1.d { *nu = -u; *nv = -v; return; }
  imm perp = nn - on * nd;
  imm dperp = (on + nn) * (1.d / (1.d + nd));
  *nu = u - dperp * u.dot(perp);
  *nv = v - dperp * v.dot(perp);
}

fn cornerAreas(p0 DVec3, p1 DVec3, p2 DVec3, ca &mut List[f64]) {
  imm e0 = p2 - p1;
  imm e1 = p0 - p2;
  imm e2 = p1 - p0;
  imm area = 0.5d * crossd(e0, e1).length();
  imm l0 = e0.lengthSquared();
  imm l1 = e1.lengthSquared();
  imm l2 = e2.lengthSquared();
  imm w0 = l0 * (l1 + l2 - l0);
  imm w1 = l1 * (l2 + l0 - l1);
  imm w2 = l2 * (l0 + l1 - l2);
  if area < 1.0e-300d { ca.set(0usize, 0.d); ca.set(1usize, 0.d); ca.set(2usize, 0.d); return; }
  if w0 <= 0.d {
    imm c1 = -0.25d * l2 * area / e0.dot(e2);
    imm c2 = -0.25d * l1 * area / e0.dot(e1);
    ca.set(1usize, c1); ca.set(2usize, c2); ca.set(0usize, area - c1 - c2);
  } elif w1 <= 0.d {
    imm c2 = -0.25d * l0 * area / e1.dot(e0);
    imm c0 = -0.25d * l2 * area / e1.dot(e2);
    ca.set(2usize, c2); ca.set(0usize, c0); ca.set(1usize, area - c2 - c0);
  } elif w2 <= 0.d {
    imm c0 = -0.25d * l1 * area / e2.dot(e1);
    imm c1 = -0.25d * l0 * area / e2.dot(e0);
    ca.set(0usize, c0); ca.set(1usize, c1); ca.set(2usize, area - c0 - c1);
  } else {
    imm s = 0.5d * area / (w0 + w1 + w2);
    ca.set(0usize, s * (w1 + w2)); ca.set(1usize, s * (w2 + w0)); ca.set(2usize, s * (w0 + w1));
  }
}

// The triangles of a mesh as vertex numbers, three to a triangle, a polygon as a fan
pub fn fanTriangles(m &PolyMesh) List[u32] {
  mut tris = List[u32].empty();
  mut f = 0usize;
  while f < m.faceCount() {
    imm vs = m.faceVertices(u32.from(f));
    mut k = 1usize;
    while k + 1usize < vs.len() {
      tris.push(*vs[0usize]); tris.push(*vs[k]); tris.push(*vs[k + 1usize]);
      k += 1usize;
    }
    f += 1usize;
  }
  tris;
}

// The principal curvatures and directions at every vertex (see the top)
pub fn curvature(m &PolyMesh) Curvature {
  imm nv = m.vertexCount();
  imm tris = fanTriangles(m);
  imm nt = tris.len() / 3usize;
  imm normals = m.vertexNormals();
  mut pos = List[DVec3].withCapacity(nv);
  mut i = 0usize;
  while i < nv { pos.push(DVec3.from(*m.positions[i])); i += 1usize; }
  mut nrm = List[DVec3].withCapacity(nv);
  i = 0usize;
  while i < nv { nrm.push(unitd(DVec3.from(*normals[i]))); i += 1usize; }

  // Each vertex's tangent frame, from an edge leaving it
  mut pu = List[DVec3].withCapacity(nv);
  mut pv2 = List[DVec3].withCapacity(nv);
  i = 0usize;
  while i < nv { pu.push(new DVec3(0.d, 0.d, 0.d)); pv2.push(new DVec3(0.d, 0.d, 0.d)); i += 1usize; }
  mut seen = List[bool].withCapacity(nv);
  i = 0usize;
  while i < nv { seen.push(false); i += 1usize; }
  i = 0usize;
  while i < nt {
    mut j = 0usize;
    while j < 3usize {
      imm a = usize.from(*tris[3usize * i + j]);
      imm b = usize.from(*tris[3usize * i + (j + 1usize) % 3usize]);
      if not *seen[a] {
        seen.set(a, true);
        pu.set(a, *pos[b] - *pos[a]);
      }
      j += 1usize;
    }
    i += 1usize;
  }
  i = 0usize;
  while i < nv {
    imm n = *nrm[i];
    imm t = unitd(crossd(n, crossd(*pu[i], n)));
    imm t2 = if t.lengthSquared() > 0.5d { t; } else { perpendicularTo(if n.lengthSquared() > 0.5d { n; } else { new DVec3(0.d, 0.d, 1.d); }); };
    pu.set(i, t2);
    pv2.set(i, crossd(n, t2));
    i += 1usize;
  }

  // Voronoi area of each vertex
  mut area = zeros(nv);
  mut cas = zeros(3usize * nt);
  mut ca = zeros(3usize);
  i = 0usize;
  while i < nt {
    imm a = usize.from(*tris[3usize * i]);
    imm b = usize.from(*tris[3usize * i + 1usize]);
    imm c = usize.from(*tris[3usize * i + 2usize]);
    cornerAreas(*pos[a], *pos[b], *pos[c], &mut ca);
    cas.set(3usize * i, *ca[0]); cas.set(3usize * i + 1usize, *ca[1]); cas.set(3usize * i + 2usize, *ca[2]);
    area.set(a, *area[a] + *ca[0]); area.set(b, *area[b] + *ca[1]); area.set(c, *area[c] + *ca[2]);
    i += 1usize;
  }

  mut c1 = zeros(nv);
  mut c12 = zeros(nv);
  mut c2 = zeros(nv);
  i = 0usize;
  while i < nt {
    imm vi = [usize.from(*tris[3usize * i]), usize.from(*tris[3usize * i + 1usize]), usize.from(*tris[3usize * i + 2usize])];
    imm e = [*pos[vi[2]] - *pos[vi[1]], *pos[vi[0]] - *pos[vi[2]], *pos[vi[1]] - *pos[vi[0]]];
    imm fn3 = crossd(e[0], e[1]);
    if fn3.lengthSquared() > 1.0e-300d {
      imm t = unitd(e[0]);
      imm n = unitd(fn3);
      imm b = crossd(n, t);
      // Least squares for the face's second fundamental form (e, f, g)
      mut w = zeros(9usize);
      mut mm = zeros(3usize);
      mut j = 0usize;
      while j < 3usize {
        imm u = e[j].dot(t);
        imm v = e[j].dot(b);
        w.set(0usize, *w[0] + u * u);
        w.set(1usize, *w[1] + u * v);
        w.set(8usize, *w[8] + v * v);
        imm dn = *nrm[vi[(j + 2usize) % 3usize]] - *nrm[vi[(j + 1usize) % 3usize]];
        imm dnu = dn.dot(t);
        imm dnv = dn.dot(b);
        mm.set(0usize, *mm[0] + dnu * u);
        mm.set(1usize, *mm[1] + dnu * v + dnv * u);
        mm.set(2usize, *mm[2] + dnv * v);
        j += 1usize;
      }
      w.set(4usize, *w[0] + *w[8]);
      w.set(3usize, *w[1]);
      w.set(5usize, *w[1]);
      w.set(7usize, *w[1]);
      // w = [[a, b, 0], [b, a + c, b], [0, b, c]]
      if solveLinear(&mut w, &mut mm, 3usize) {
        imm ee = *mm[0];
        imm ff = *mm[1];
        imm gg = *mm[2];
        j = 0usize;
        while j < 3usize {
          imm v = vi[j];
          if *area[v] > 0.d {
            // The vertex frame laid in the face's plane, then the form seen in it
            mut nu = new DVec3(0.d, 0.d, 0.d);
            mut nv = new DVec3(0.d, 0.d, 0.d);
            rotateFrame(*pu[v], *pv2[v], n, &mut nu, &mut nv);
            imm u1 = nu.dot(t);
            imm v1 = nu.dot(b);
            imm u2 = nv.dot(t);
            imm v2 = nv.dot(b);
            imm ku = ee * u1 * u1 + 2.d * ff * u1 * v1 + gg * v1 * v1;
            imm kuv = ee * u1 * u2 + ff * (u1 * v2 + u2 * v1) + gg * v1 * v2;
            imm kv = ee * u2 * u2 + 2.d * ff * u2 * v2 + gg * v2 * v2;
            imm wgt = *cas[3usize * i + j] / *area[v];
            c1.set(v, *c1[v] + wgt * ku);
            c12.set(v, *c12[v] + wgt * kuv);
            c2.set(v, *c2[v] + wgt * kv);
          }
          j += 1usize;
        }
      }
    }
    i += 1usize;
  }

  mut out = new Curvature(List[f32].withCapacity(nv), List[f32].withCapacity(nv), List[Vec3].withCapacity(nv),
    List[Vec3].withCapacity(nv), List[Vec3].withCapacity(nv));
  i = 0usize;
  while i < nv {
    imm half = 0.5d * (*c1[i] - *c2[i]);
    imm rad = sqrtd(half * half + *c12[i] * *c12[i]);
    imm mid = 0.5d * (*c1[i] + *c2[i]);
    imm th = 0.5d * libc.atan2(2.d * *c12[i], *c1[i] - *c2[i]);
    imm d1 = *pu[i] * libc.cos(th) + *pv2[i] * libc.sin(th);
    imm d2 = crossd(*nrm[i], d1);
    out.k1.push(f32.from(mid + rad));
    out.k2.push(f32.from(mid - rad));
    out.dir1.push(d1.toVec3());
    out.dir2.push(d2.toVec3());
    out.normal.push((*nrm[i]).toVec3());
    i += 1usize;
  }
  out;
}

// The curvatures smoothed: each of k1 and k2 averaged with its neighbours' for
// 'steps' rounds (each round every vertex becomes the mean of itself and its
// neighbours, all at once). The directions are kept.
pub fn smoothCurvature(m &PolyMesh, c &Curvature, steps u32) Curvature {
  mut a = smoothField(m, &c.k1, steps);
  mut b = smoothField(m, &c.k2, steps);
  // keep k1 >= k2 after averaging
  mut i = 0usize;
  while i < a.len() {
    if *b[i] > *a[i] { imm t = *a[i]; a.set(i, *b[i]); b.set(i, t); }
    i += 1usize;
  }
  mut d1 = List[Vec3].empty(); mut d2 = List[Vec3].empty(); mut nn = List[Vec3].empty();
  i = 0usize;
  while i < a.len() { d1.push(*c.dir1[i]); d2.push(*c.dir2[i]); nn.push(*c.normal[i]); i += 1usize; }
  new Curvature(a, b, d1, d2, nn);
}

// A per-vertex field averaged with its neighbours for 'steps' rounds
pub fn smoothField(m &PolyMesh, field &List[f32], steps u32) List[f32] {
  mut cur = List[f32].withCapacity(field.len());
  mut i = 0usize;
  while i < field.len() { cur.push(*field[i]); i += 1usize; }
  mut s = 0u32;
  while s < steps {
    mut nxt = List[f32].withCapacity(field.len());
    i = 0usize;
    while i < field.len() {
      imm nb = m.vertexNeighbors(u32.from(i));
      mut sum = *cur[i];
      mut k = 0usize;
      while k < nb.len() { sum = sum + *cur[usize.from(*nb[k])]; k += 1usize; }
      nxt.push(sum / f32.from(nb.len() + 1usize));
      i += 1usize;
    }
    cur = nxt;
    s += 1u32;
  }
  cur;
}

// Write the curvatures into the mesh as vertex channels "k1", "k2", "mean",
// "gaussian" and "patch" (the class as a number: PatchFlat and the rest), so
// that later operators and pictures can read them. Returns the channel number of "patch".
pub fn curvatureChannels(m &mut PolyMesh, c &Curvature, e f32) u32 {
  imm ck1 = m.addFloatChannel(VertexDomain, "k1", 0.);
  imm ck2 = m.addFloatChannel(VertexDomain, "k2", 0.);
  imm cm = m.addFloatChannel(VertexDomain, "mean", 0.);
  imm cg = m.addFloatChannel(VertexDomain, "gaussian", 0.);
  imm cp = m.addFloatChannel(VertexDomain, "patch", 0.);
  mut v = 0usize;
  while v < c.k1.len() {
    m.setFloat(ck1, u32.from(v), *c.k1[v]);
    m.setFloat(ck2, u32.from(v), *c.k2[v]);
    m.setFloat(cm, u32.from(v), c.mean(v));
    m.setFloat(cg, u32.from(v), c.gaussian(v));
    m.setFloat(cp, u32.from(v), f32.from(classify(*c.k1[v], *c.k2[v], e)));
    v += 1usize;
  }
  cp;
}
