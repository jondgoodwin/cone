// ======== Silhouettes: render-free outlines from several views, and their comparison ========
//
// A silhouette is what a mesh covers seen along one direction, orthographically.
// No renderer is involved: each triangle is projected onto the view's plane and
// filled into a grid of cells (a cell is covered if its centre lies inside a
// projected triangle), the same grid for two meshes so they can be compared. The
// outline is the boundary of the covered cells, followed as closed loops
// (counterclockwise for an outer boundary, so a hole runs clockwise) and then
// simplified (collinear runs merged, then Douglas-Peucker to 0.7 of a cell), a
// polygon in the view plane's units.
//
// Two silhouettes are compared by
// - IoU: covered cells in both over covered cells in either (area overlap);
// - Hausdorff distance between the outline polygons: the greatest distance from a
//   point of one outline to the other outline (both directions, the larger),
//   sampled at a spacing of one cell.
// Both are in the grid's resolution: choose it for the accuracy wanted (one cell
// is the window's longest side over the resolution).

pub struct View {
  pub right DVec3;      // the view plane's axes (unit, perpendicular)
  pub up DVec3;
  pub forward DVec3;    // the direction the viewer looks along, into the scene

  // The view looking along 'forward', 'up' as high as it can be on the page
  pub fn look(forward Vec3, up Vec3) View {
    let f = unitd(DVec3.from(forward));
    var r = unitd(crossd(f, DVec3.from(up)));
    if r.lengthSquared() < 0.5d { r = perpendicularTo(f); }
    new View(r, crossd(r, f), f)
  }

  // The 2-D point of a 3-D point in this view
  pub fn project(self &, p DVec3) DVec3 { new DVec3(p.dot(right), p.dot(up), p.dot(forward)) }
}

// Front, back, left, right, top and bottom, for a model facing -z with y up (the
// front view looks along +z at the face)
pub fn standardViews() List[View] {
  var out = List[View].empty();
  out.push(View.look(new Vec3(0., 0., 1.), new Vec3(0., 1., 0.)));
  out.push(View.look(new Vec3(0., 0., -1.), new Vec3(0., 1., 0.)));
  out.push(View.look(new Vec3(1., 0., 0.), new Vec3(0., 1., 0.)));
  out.push(View.look(new Vec3(-1., 0., 0.), new Vec3(0., 1., 0.)));
  out.push(View.look(new Vec3(0., -1., 0.), new Vec3(0., 0., 1.)));
  out.push(View.look(new Vec3(0., 1., 0.), new Vec3(0., 0., -1.)));
  out
}

// n views from around the y axis, evenly, the first looking along +z
pub fn turntableViews(n usize) List[View] {
  var out = List[View].empty();
  var i = 0usize;
  while i < n {
    let a = 2. * pi * f32.from(i) / f32.from(n);
    out.push(View.look(new Vec3(sin(a), 0., cos(a)), new Vec3(0., 1., 0.)));
    i += 1usize;
  }
  out
}

// The grid: world (x, y) in the view plane to cell (x - x0) * scale, (y - y0) * scale
pub struct Window {
  pub x0 f64;
  pub y0 f64;
  pub scale f64;      // cells per unit
  pub w usize;
  pub h usize;

  pub fn cell(self &) f64 { 1.d / scale }
}

// A window that holds both meshes in the view, the longer side 'res' cells, with a margin
pub fn windowFor(a &PolyMesh, b &PolyMesh, v &View, res usize) Window {
  var lox = 1.0e30d; var loy = 1.0e30d; var hix = -1.0e30d; var hiy = -1.0e30d;
  var pass = 0;
  while pass < 2 {
    let m = if pass == 0 { a } else { b };
    var i = 0usize;
    while i < m.positions.len() {
      let q = v.project(DVec3.from(*m.positions[i]));
      lox = mind(lox, q.x); hix = maxd(hix, q.x);
      loy = mind(loy, q.y); hiy = maxd(hiy, q.y);
      i += 1usize;
    }
    pass += 1;
  }
  if hix < lox { return new Window(0.d, 0.d, 1.d, 1usize, 1usize); }
  let ext = maxd(hix - lox, hiy - loy) * 1.04d + 1.0e-9d;
  let sc = f64.from(res) / ext;
  let cx = 0.5d * (lox + hix);
  let cy = 0.5d * (loy + hiy);
  let w = usize.from(libc.ceil((hix - lox) * 1.04d * sc)) + 2usize;
  let h = usize.from(libc.ceil((hiy - loy) * 1.04d * sc)) + 2usize;
  new Window(cx - 0.5d * f64.from(w) / sc, cy - 0.5d * f64.from(h) / sc, sc, w, h)
}

// The covered cells (1) and uncovered (0) of the mesh in the view, row by row from y = y0
pub fn rasterize(m &PolyMesh, v &View, win &Window) List[u8] {
  var cells = List[u8].withCapacity(win.w * win.h);
  var i = 0usize;
  while i < win.w * win.h { cells.push(0u8); i += 1usize; }
  let tris = fanTriangles(m);
  var px = List[DVec3].withCapacity(m.positions.len());
  i = 0usize;
  while i < m.positions.len() {
    let q = v.project(DVec3.from(*m.positions[i]));
    px.push(new DVec3((q.x - win.x0) * win.scale, (q.y - win.y0) * win.scale, 0.d));
    i += 1usize;
  }
  i = 0usize;
  while i < tris.len() / 3usize {
    let a = *px[usize.from(*tris[3usize * i])];
    let b = *px[usize.from(*tris[3usize * i + 1usize])];
    let c = *px[usize.from(*tris[3usize * i + 2usize])];
    let area = (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
    if absd(area) > 1.0e-12d {
      let x0 = maxd(0.d, libc.floor(mind(a.x, mind(b.x, c.x)) - 0.5d));
      let x1 = mind(f64.from(win.w) - 1.d, libc.ceil(maxd(a.x, maxd(b.x, c.x)) - 0.5d));
      let y0 = maxd(0.d, libc.floor(mind(a.y, mind(b.y, c.y)) - 0.5d));
      let y1 = mind(f64.from(win.h) - 1.d, libc.ceil(maxd(a.y, maxd(b.y, c.y)) - 0.5d));
      var y = usize.from(y0);
      while f64.from(y) <= y1 {
        var x = usize.from(x0);
        while f64.from(x) <= x1 {
          let qx = f64.from(x) + 0.5d;
          let qy = f64.from(y) + 0.5d;
          let w0 = ((b.x - qx) * (c.y - qy) - (b.y - qy) * (c.x - qx)) / area;
          let w1 = ((c.x - qx) * (a.y - qy) - (c.y - qy) * (a.x - qx)) / area;
          let w2 = 1.d - w0 - w1;
          if w0 >= -1.0e-9d and w1 >= -1.0e-9d and w2 >= -1.0e-9d { cells.set(y * win.w + x, 1u8); }
          x += 1usize;
        }
        y += 1usize;
      }
    }
    i += 1usize;
  }
  cells
}

pub fn coveredCells(cells &List[u8]) usize {
  var n = 0usize;
  var i = 0usize;
  while i < cells.len() { if *cells[i] != 0u8 { n += 1usize; } i += 1usize; }
  n
}

// Area overlap of two coverages on one grid: cells in both over cells in either
pub fn iou(a &List[u8], b &List[u8]) f32 {
  var both = 0usize;
  var either = 0usize;
  var i = 0usize;
  while i < a.len() {
    let x = *a[i] != 0u8;
    let y = *b[i] != 0u8;
    if x and y { both += 1usize; }
    if x or y { either += 1usize; }
    i += 1usize;
  }
  if either == 0usize { 1. } else { f32.from(both) / f32.from(either) };
}

fn filled(cells &List[u8], w usize, h usize, x i64, y i64) bool {
  if x < 0 or y < 0 or x >= i64.from(w) or y >= i64.from(h) { false } else { *cells[usize.from(y) * w + usize.from(x)] != 0u8 };
}

// The outline of the covered cells as closed loops in the window's world units (see the top)
pub fn traceOutline(cells &List[u8], win &Window) List[List[Vec2]] {
  let w = win.w;
  let h = win.h;
  let cw = w + 1usize;
  var out1 = List[u32].withCapacity(cw * (h + 1usize));
  var out2 = List[u32].withCapacity(cw * (h + 1usize));
  var i = 0usize;
  while i < cw * (h + 1usize) { out1.push(NoIndex); out2.push(NoIndex); i += 1usize; }
  var y = 0usize;
  while y < h {
    var x = 0usize;
    while x < w {
      if *cells[y * w + x] != 0u8 {
        let xi = i64.from(x);
        let yi = i64.from(y);
        // interior on the left of each directed edge
        if not filled(cells, w, h, xi, yi - 1) { addEdge(&mut out1, &mut out2, y * cw + x, y * cw + x + 1usize); }
        if not filled(cells, w, h, xi + 1, yi) { addEdge(&mut out1, &mut out2, y * cw + x + 1usize, (y + 1usize) * cw + x + 1usize); }
        if not filled(cells, w, h, xi, yi + 1) { addEdge(&mut out1, &mut out2, (y + 1usize) * cw + x + 1usize, (y + 1usize) * cw + x); }
        if not filled(cells, w, h, xi - 1, yi) { addEdge(&mut out1, &mut out2, (y + 1usize) * cw + x, y * cw + x); }
      }
      x += 1usize;
    }
    y += 1usize;
  }
  var loops = List[List[Vec2]].empty();
  var s = 0usize;
  while s < cw * (h + 1usize) {
    while *out1[s] != NoIndex or *out2[s] != NoIndex {
      var corners = List[u32].empty();
      var cur = s;
      var going = true;
      while going {
        corners.push(u32.from(cur));
        var nx = *out1[cur];
        if nx != NoIndex { out1.set(cur, NoIndex); } else { nx = *out2[cur]; out2.set(cur, NoIndex); }
        cur = usize.from(nx);
        if cur == s { going = false; }
        if nx == NoIndex { going = false; }
      }
      // merge collinear runs
      var pts = List[Vec2].empty();
      var k = 0usize;
      while k < corners.len() {
        let pc = usize.from(*corners[(k + corners.len() - 1usize) % corners.len()]);
        let cc = usize.from(*corners[k]);
        let nc = usize.from(*corners[(k + 1usize) % corners.len()]);
        let d1x = i64.from(cc % cw) - i64.from(pc % cw);
        let d1y = i64.from(cc / cw) - i64.from(pc / cw);
        let d2x = i64.from(nc % cw) - i64.from(cc % cw);
        let d2y = i64.from(nc / cw) - i64.from(cc / cw);
        if d1x != d2x or d1y != d2y {
          pts.push(new Vec2(f32.from(win.x0 + f64.from(cc % cw) / win.scale), f32.from(win.y0 + f64.from(cc / cw) / win.scale)));
        }
        k += 1usize;
      }
      if pts.len() >= 3usize { loops.push(simplifyLoop(&pts, 0.7d / win.scale)); }
    }
    s += 1usize;
  }
  loops
}

fn addEdge(o1 &mut List[u32], o2 &mut List[u32], from usize, to usize) {
  if *o1[from] == NoIndex { o1.set(from, u32.from(to)); } else { o2.set(from, u32.from(to)); }
}

fn segDistance(p Vec2, a Vec2, b Vec2) f64 {
  segmentDistance(new DVec3(f64.from(p.x), f64.from(p.y), 0.d), new DVec3(f64.from(a.x), f64.from(a.y), 0.d),
    new DVec3(f64.from(b.x), f64.from(b.y), 0.d))
}

// Douglas-Peucker on a closed loop: split at the vertex farthest from the first, then each half
fn simplifyLoop(pts &List[Vec2], tol f64) List[Vec2] {
  let n = pts.len();
  var far = 0usize;
  var fd = -1.d;
  var i = 1usize;
  while i < n {
    let d = f64.from(pts[i].distance(*pts[0usize]));
    if d > fd { fd = d; far = i; }
    i += 1usize;
  }
  var keep = List[bool].withCapacity(n);
  i = 0usize;
  while i < n { keep.push(false); i += 1usize; }
  keep.set(0usize, true);
  keep.set(far, true);
  var stack = List[usize].empty();
  stack.push(0usize); stack.push(far);
  stack.push(far); stack.push(n);       // n stands for vertex 0 again
  while stack.len() > 0usize {
    let hi = *stack[stack.len() - 1usize];
    let lo = *stack[stack.len() - 2usize];
    stack.pop(); stack.pop();
    let a = *pts[lo];
    let b = *pts[hi % n];
    var worst = -1.d;
    var wi = lo;
    var k = lo + 1usize;
    while k < hi {
      let d = segDistance(*pts[k], a, b);
      if d > worst { worst = d; wi = k; }
      k += 1usize;
    }
    if worst > tol {
      keep.set(wi, true);
      stack.push(lo); stack.push(wi);
      stack.push(wi); stack.push(hi);
    }
  }
  var out = List[Vec2].empty();
  i = 0usize;
  while i < n { if *keep[i] { out.push(*pts[i]); } i += 1usize; }
  out
}

// The area enclosed by the loops (outer boundaries add, holes subtract)
pub fn loopsArea(loops &List[List[Vec2]]) f32 {
  var a = 0.d;
  var i = 0usize;
  while i < loops.len() {
    let l = loops[i];
    var k = 0usize;
    while k < l.len() {
      let p = *l[k];
      let q = *l[(k + 1usize) % l.len()];
      a = a + f64.from(p.x) * f64.from(q.y) - f64.from(q.x) * f64.from(p.y);
      k += 1usize;
    }
    i += 1usize;
  }
  f32.from(0.5d * a)
}

// The greatest distance from a point of the outline 'a' to the outline 'b', sampled every 'step'
fn directedHausdorff(a &List[List[Vec2]], b &List[List[Vec2]], step f64) f64 {
  var worst = 0.d;
  var i = 0usize;
  while i < a.len() {
    let l = a[i];
    var k = 0usize;
    while k < l.len() {
      let p = *l[k];
      let q = *l[(k + 1usize) % l.len()];
      let len = f64.from(p.distance(q));
      let n = usize.from(libc.ceil(len / step)) + 1usize;
      var s = 0usize;
      while s <= n {
        let t = f32.from(s) / f32.from(n);
        let pt = p.lerp(q, t);
        var best = 1.0e30d;
        var j = 0usize;
        while j < b.len() {
          let m = b[j];
          var e = 0usize;
          while e < m.len() {
            best = mind(best, segDistance(pt, *m[e], *m[(e + 1usize) % m.len()]));
            e += 1usize;
          }
          j += 1usize;
        }
        worst = maxd(worst, best);
        s += 1usize;
      }
      k += 1usize;
    }
    i += 1usize;
  }
  worst
}

// The Hausdorff distance between two outlines (the larger of the two directed distances)
pub fn outlineHausdorff(a &List[List[Vec2]], b &List[List[Vec2]], step f32) f32 {
  f32.from(maxd(directedHausdorff(a, b, f64.from(step)), directedHausdorff(b, a, f64.from(step))))
}

pub struct SilhouetteScore {
  pub iou f32;             // area overlap, 0 to 1
  pub hausdorff f32;       // between the outlines, in the meshes' units
  pub areaA f32;           // the covered area of each, in squared units
  pub areaB f32;
}

// Compare two meshes (already in the same frame) from each view
pub fn compareSilhouettes(a &PolyMesh, b &PolyMesh, views &List[View], res usize) List[SilhouetteScore] {
  var out = List[SilhouetteScore].empty();
  var i = 0usize;
  while i < views.len() {
    let win = windowFor(a, b, views[i], res);
    let ca = rasterize(a, views[i], &win);
    let cb = rasterize(b, views[i], &win);
    let oa = traceOutline(&ca, &win);
    let ob = traceOutline(&cb, &win);
    let cell2 = win.cell() * win.cell();
    out.push(new SilhouetteScore(iou(&ca, &cb), outlineHausdorff(&oa, &ob, f32.from(win.cell())),
      f32.from(f64.from(coveredCells(&ca)) * cell2), f32.from(f64.from(coveredCells(&cb)) * cell2)));
    i += 1usize;
  }
  out
}
