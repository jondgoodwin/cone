// ======== Synthetic shapes: meshes whose true form is known ========
//
// The tests and the demonstrations measure a mesh against a shape whose form
// is known exactly. These make such meshes as PolyMesh: a surface of revolution
// (a sphere, a cylinder, a capsule are special cases), and a grid over a height
// function. A face faces outward (counterclockwise seen from outside).

// A surface of revolution about the y axis. 'profile' lists (radius, y) from the top
// to the bottom; a point of radius 0 becomes a single pole vertex, any other a ring
// of 'segs' vertices (the first on +x, going round towards +z). 'capTop' and
// 'capBottom' close a ring at that end with one polygon.
pub fn revolve(profile: &Array[Vec2], segs: usize, capTop: bool, capBottom: bool) PolyMesh {
  var pos = List[Vec3].empty();
  var start = List[usize].empty();    // per row: its first vertex
  var rowPole = List[bool].empty();
  var j = 0usize;
  while j < profile.len {
    let r = profile[j].x;
    let y = profile[j].y;
    start.push(pos.len());
    if r < 0.000000001 {
      pos.push(Vec3(0., y, 0.));
      rowPole.push(true);
    } else {
      var i = 0usize;
      while i < segs {
        let a = 2. * pi * f32.from(i) / f32.from(segs);
        pos.push(Vec3(r * cos(a), y, r * sin(a)));
        i += 1usize;
      }
      rowPole.push(false);
    }
    j += 1usize;
  }
  var counts = List[u32].empty();
  var idx = List[u32].empty();
  j = 0usize;
  while j + 1usize < profile.len {
    let u0 = *start[j];
    let l0 = *start[j + 1usize];
    let upole = *rowPole[j];
    let lpole = *rowPole[j + 1usize];
    var i = 0usize;
    while i < segs {
      let i1 = (i + 1usize) % segs;
      if upole && lpole {
        // nothing between two poles
      } else if upole {
        counts.push(3u32);
        idx.push(u32.from(u0)); idx.push(u32.from(l0 + i1)); idx.push(u32.from(l0 + i));
      } else if lpole {
        counts.push(3u32);
        idx.push(u32.from(u0 + i1)); idx.push(u32.from(l0)); idx.push(u32.from(u0 + i));
      } else {
        counts.push(4u32);
        idx.push(u32.from(u0 + i1)); idx.push(u32.from(l0 + i1)); idx.push(u32.from(l0 + i)); idx.push(u32.from(u0 + i));
      }
      i += 1usize;
    }
    j += 1usize;
  }
  if capTop && profile.len > 0usize && !*rowPole[0usize] {
    counts.push(u32.from(segs));
    var i = segs;
    while i > 0usize { i -= 1usize; idx.push(u32.from(*start[0usize] + i)); }
  }
  if capBottom && profile.len > 0usize && !*rowPole[profile.len - 1usize] {
    counts.push(u32.from(segs));
    var i = 0usize;
    while i < segs { idx.push(u32.from(*start[profile.len - 1usize] + i)); i += 1usize; }
  }
  var problems = List[String].empty();
  PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems)
}

// A sphere of the radius about the origin: 'rings' bands of latitude, 'segs' of longitude
pub fn sphereMesh(radius: f32, rings: usize, segs: usize) PolyMesh {
  var prof = List[Vec2].empty();
  var j = 0usize;
  while j <= rings {
    let t = pi * f32.from(j) / f32.from(rings);
    prof.push(Vec2(if j == 0usize || j == rings { 0. } else { radius * sin(t) }, radius * cos(t)));
    j += 1usize;
  }
  revolve(prof.view(), segs, false, false)
}

// A cylinder about the y axis, closed by a polygon at each end, 'rows' bands tall
pub fn cylinderMesh(radius: f32, height: f32, rows: usize, segs: usize) PolyMesh {
  var prof = List[Vec2].empty();
  var j = 0usize;
  while j <= rows {
    prof.push(Vec2(radius, 0.5 * height - height * f32.from(j) / f32.from(rows)));
    j += 1usize;
  }
  revolve(prof.view(), segs, true, true)
}

// A capsule about the y axis: the points within 'radius' of the segment of the length 'length'
// along it, centred at the origin; 'caps' rings of latitude on each hemisphere
pub fn capsuleMesh(radius: f32, length: f32, rows: usize, caps: usize, segs: usize) PolyMesh {
  var prof = List[Vec2].empty();
  var j = 0usize;
  while j <= caps {
    let t = 0.5 * pi * f32.from(j) / f32.from(caps);
    prof.push(Vec2(if j == 0usize { 0. } else { radius * sin(t) }, 0.5 * length + radius * cos(t)));
    j += 1usize;
  }
  j = 1usize;
  while j <= rows {
    prof.push(Vec2(radius, 0.5 * length - length * f32.from(j) / f32.from(rows)));
    j += 1usize;
  }
  j = 1usize;
  while j <= caps {
    let t = 0.5 * pi * f32.from(j) / f32.from(caps);
    prof.push(Vec2(if j == caps { 0. } else { radius * cos(t) }, -0.5 * length - radius * sin(t)));
    j += 1usize;
  }
  revolve(prof.view(), segs, false, false)
}

// A square grid in the xz plane, 'n' quads each way, side 'size' centred at the origin,
// each vertex lifted to y = height(x, z); faces up where the height is flat
pub fn gridMesh[F: fn(x: f32, z: f32) f32](n: usize, size: f32, height: &F) PolyMesh {
  var pos = List[Vec3].empty();
  var j = 0usize;
  while j <= n {
    var i = 0usize;
    while i <= n {
      let x = size * (f32.from(i) / f32.from(n) - 0.5);
      let z = size * (f32.from(j) / f32.from(n) - 0.5);
      pos.push(Vec3(x, height(x, z), z));
      i += 1usize;
    }
    j += 1usize;
  }
  var counts = List[u32].empty();
  var idx = List[u32].empty();
  j = 0usize;
  while j < n {
    var i = 0usize;
    while i < n {
      let a = j * (n + 1usize) + i;
      counts.push(4u32);
      idx.push(u32.from(a)); idx.push(u32.from(a + n + 1usize)); idx.push(u32.from(a + n + 2usize)); idx.push(u32.from(a + 1usize));
      i += 1usize;
    }
    j += 1usize;
  }
  var problems = List[String].empty();
  PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), &mut problems)
}

// Every vertex of the mesh moved to f(p): for moving a made shape into place
pub fn movePoints[F: fn(p: Vec3) Vec3](m: &mut PolyMesh, f: &F) {
  var i = 0usize;
  while i < m.positions.len() {
    m.positions.set(i, f(*m.positions[i]));
    i += 1usize;
  }
}
