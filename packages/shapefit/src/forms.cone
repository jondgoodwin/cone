// ======== Form: a fitted shape, and the signed distance to it ========
//
// A Form is a kind and a list of parameters, with how well it fitted. One
// distance function serves every kind, so one refinement (fits.cone) and one
// residual map (residual.cone) serve them all. Distances are signed, positive
// outside the form (on the side of a plane its normal points to; outside a
// sphere, ellipsoid, cylinder or capsule; for a general quadric, away from the
// centroid of the points it was fitted to). Parameters, by kind:
//
//   FormPlane          point (3), unit normal (3)
//   FormSphere         centre (3), radius
//   FormEllipsoid      centre (3), semi-axes (3), rotation vector (3): the axes
//                      are the columns of the rotation (Rodrigues) of that vector,
//                      the semi-axes along them in order. FormEllipsoidAxis is
//                      the same with the rotation held at zero (axes along x, y, z)
//   FormQuadric        the ten coefficients of  a x^2 + b y^2 + c z^2 + d xy +
//                      e xz + f yz + g x + h y + i z + j
//   FormCylinder       a point on the axis (3), unit axis direction (3), radius,
//                      then the least and greatest position along the axis of the
//                      points fitted (as distances from that point). The distance
//                      is to the infinite cylinder
//   FormCapsule        one end of the axis segment (3), the other end (3), radius

pub const FormPlane = 0u32;
pub const FormSphere = 1u32;
pub const FormEllipsoid = 2u32;
pub const FormEllipsoidAxis = 3u32;
pub const FormQuadric = 4u32;
pub const FormCylinder = 5u32;
pub const FormCapsule = 6u32;

pub struct Form {
  pub kind u32;
  pub params List[f64];
  pub ok bool;            // false if the fit failed (too few points, a degenerate arrangement)
  pub count usize;        // points fitted (those with weight above zero)
  pub rms f64;            // weighted root-mean-square residual
  pub maxAbs f64;         // greatest absolute residual
  pub iterations u32;     // refinement steps taken

  pub fn make(kind u32, params List[f64]) Form {
    new Form(kind, params, true, 0usize, 0.d, 0.d, 0u32);
  }

  pub fn failed(kind u32) Form {
    new Form(kind, List[f64].empty(), false, 0usize, 0.d, 0.d, 0u32);
  }

  pub fn name(self &) &str {
    if kind == FormPlane { "plane"; }
    elif kind == FormSphere { "sphere"; }
    elif kind == FormEllipsoid { "ellipsoid"; }
    elif kind == FormEllipsoidAxis { "axis-aligned ellipsoid"; }
    elif kind == FormQuadric { "quadric"; }
    elif kind == FormCylinder { "cylinder"; }
    else { "capsule"; };
  }

  // Parameter k as an f32, for reporting
  pub fn param(self &, k usize) f32 { f32.from(*params[k]); }
}

fn pv(p &List[f64], k usize) DVec3 { new DVec3(*p[k], *p[k + 1usize], *p[k + 2usize]); }

// The rotation (as nine numbers, row-major) for the rotation vector w: about
// w's direction by its length (Rodrigues)
fn rotationOf(w DVec3) List[f64] {
  imm th = w.length();
  imm k = if th > 1.0e-12d { w * (1.d / th); } else { new DVec3(0.d, 0.d, 1.d); };
  imm s = if th > 1.0e-12d { libc.sin(th); } else { 0.d; };
  imm c = if th > 1.0e-12d { libc.cos(th); } else { 1.d; };
  imm t = 1.d - c;
  mut r = List[f64].withCapacity(9usize);
  r.push(c + k.x * k.x * t);        r.push(k.x * k.y * t - k.z * s);  r.push(k.x * k.z * t + k.y * s);
  r.push(k.y * k.x * t + k.z * s);  r.push(c + k.y * k.y * t);        r.push(k.y * k.z * t - k.x * s);
  r.push(k.z * k.x * t - k.y * s);  r.push(k.z * k.y * t + k.x * s);  r.push(c + k.z * k.z * t);
  r;
}

// The rotation vector of a rotation matrix (row-major), the inverse of rotationOf
fn rotationVectorOf(r &List[f64]) DVec3 {
  imm tr = *r[0] + *r[4] + *r[8];
  mut cs = (tr - 1.d) * 0.5d;
  if cs > 1.d { cs = 1.d; }
  if cs < -1.d { cs = -1.d; }
  imm th = libc.acos(cs);
  imm ax = new DVec3(*r[7] - *r[5], *r[2] - *r[6], *r[3] - *r[1]);
  if th < 1.0e-9d { return ax * 0.5d; }
  if th > 3.14159d {
    // A half turn: the axis from the diagonal, signs from the off-diagonals
    imm kx = sqrtd((*r[0] + 1.d) * 0.5d);
    imm ky = sqrtd((*r[4] + 1.d) * 0.5d);
    imm kz = sqrtd((*r[8] + 1.d) * 0.5d);
    mut v = new DVec3(kx, if *r[1] + *r[3] < 0.d { -ky; } else { ky; }, if *r[2] + *r[6] < 0.d { -kz; } else { kz; });
    if kx < 1.0e-6d { v = new DVec3(0.d, ky, if *r[5] + *r[7] < 0.d { -kz; } else { kz; }); }
    return v * th;
  }
  ax * (th / (2.d * libc.sin(th)));
}

// The distance from q, in the frame of an ellipsoid with semi-axes (a, b, c)
// at the origin, to its surface, negative inside. Exact: the nearest point is
// q_i r_i^2 / (r_i^2 + t) where t is the root of sum (r_i q_i / (r_i^2 + t))^2 = 1
// (Eberly), found by Newton's method kept inside a bracket.
fn ellipsoidDistance(q DVec3, a f64, b f64, c f64) f64 {
  imm f0 = sqd(q.x / a) + sqd(q.y / b) + sqd(q.z / c) - 1.d;
  imm rmin = mind(a, mind(b, c));
  if q.lengthSquared() < 1.0e-24d { return -rmin; }
  imm a2 = a * a;
  imm b2 = b * b;
  imm c2 = c * c;
  imm m2 = rmin * rmin;
  imm ex = a * q.x;
  imm ey = b * q.y;
  imm ez = c * q.z;
  mut lo = -m2;
  mut hi = sqrtd(ex * ex + ey * ey + ez * ez) - m2;
  if hi <= lo { hi = lo + 1.d; }
  mut t = 0.5d * (lo + hi);
  mut iter = 0;
  while iter < 80 {
    imm da = a2 + t;
    imm db = b2 + t;
    imm dc = c2 + t;
    imm fa = ex / da;
    imm fb = ey / db;
    imm fc = ez / dc;
    imm g = fa * fa + fb * fb + fc * fc - 1.d;
    if g > 0.d { lo = t; } else { hi = t; }
    imm dg = -2.d * (fa * fa / da + fb * fb / db + fc * fc / dc);
    mut nt = if dg < 0.d { t - g / dg; } else { 0.5d * (lo + hi); };
    if nt <= lo or nt >= hi { nt = 0.5d * (lo + hi); }
    if absd(nt - t) < 1.0e-14d * (1.d + absd(t)) { t = nt; iter = 1000; } else { t = nt; iter += 1; }
  }
  imm px = a2 * q.x / (a2 + t);
  imm py = b2 * q.y / (b2 + t);
  imm pz = c2 * q.z / (c2 + t);
  imm d = sqrtd(sqd(q.x - px) + sqd(q.y - py) + sqd(q.z - pz));
  if f0 < 0.d { -d; } else { d; };
}

// The value of a quadric (ten coefficients) at x, and its gradient
fn quadricValue(p &List[f64], x DVec3, grad &mut DVec3) f64 {
  imm v = *p[0] * x.x * x.x + *p[1] * x.y * x.y + *p[2] * x.z * x.z + *p[3] * x.x * x.y + *p[4] * x.x * x.z
    + *p[5] * x.y * x.z + *p[6] * x.x + *p[7] * x.y + *p[8] * x.z + *p[9];
  *grad = new DVec3(2.d * *p[0] * x.x + *p[3] * x.y + *p[4] * x.z + *p[6],
    2.d * *p[1] * x.y + *p[3] * x.x + *p[5] * x.z + *p[7],
    2.d * *p[2] * x.z + *p[4] * x.x + *p[5] * x.y + *p[8]);
  v;
}

// The distance from x to a quadric's surface by repeated first-order steps
// (x moved by -f grad / |grad|^2 until it lies on the surface); signed by f at x
fn quadricDistance(p &List[f64], x DVec3) f64 {
  mut g = new DVec3(0.d, 0.d, 0.d);
  imm f0 = quadricValue(p, x, &mut g);
  mut q = x;
  mut it = 0;
  while it < 8 {
    imm f = quadricValue(p, q, &mut g);
    imm gg = g.lengthSquared();
    if gg < 1.0e-30d { it = 100; } else {
      q = q - g * (f / gg);
      it += 1;
    }
  }
  imm d = (x - q).length();
  if f0 < 0.d { -d; } else { d; };
}

// The distance from x to the segment a b
fn segmentDistance(x DVec3, a DVec3, b DVec3) f64 {
  imm ab = b - a;
  imm len2 = ab.lengthSquared();
  mut t = 0.d;
  if len2 > 1.0e-30d { t = (x - a).dot(ab) / len2; }
  if t < 0.d { t = 0.d; }
  if t > 1.d { t = 1.d; }
  (x - (a + ab * t)).length();
}

// The signed distance from x to the form given by kind and parameters
fn distanceTo(kind u32, p &List[f64], x DVec3) f64 {
  if kind == FormPlane {
    imm n = unitd(pv(p, 3usize));
    n.dot(x - pv(p, 0usize));
  } elif kind == FormSphere {
    (x - pv(p, 0usize)).length() - *p[3];
  } elif kind == FormEllipsoid or kind == FormEllipsoidAxis {
    imm r = rotationOf(pv(p, 6usize));
    imm v = x - pv(p, 0usize);
    imm q = new DVec3(*r[0] * v.x + *r[3] * v.y + *r[6] * v.z, *r[1] * v.x + *r[4] * v.y + *r[7] * v.z,
      *r[2] * v.x + *r[5] * v.y + *r[8] * v.z);
    ellipsoidDistance(q, absd(*p[3]) + 1.0e-12d, absd(*p[4]) + 1.0e-12d, absd(*p[5]) + 1.0e-12d);
  } elif kind == FormQuadric {
    quadricDistance(p, x);
  } elif kind == FormCylinder {
    imm d = unitd(pv(p, 3usize));
    imm v = x - pv(p, 0usize);
    imm perp = v - d * v.dot(d);
    perp.length() - *p[6];
  } else {
    segmentDistance(x, pv(p, 0usize), pv(p, 3usize)) - *p[6];
  };
}

// The signed distance from a point to a form
pub fn formDistance(f &Form, x Vec3) f32 {
  f32.from(distanceTo(f.kind, &f.params, DVec3.from(x)));
}

// The ellipsoid's three axis directions (unit vectors) as the columns of its rotation
pub fn ellipsoidAxis(f &Form, k usize) Vec3 {
  imm r = rotationOf(pv(&f.params, 6usize));
  new Vec3(f32.from(*r[k]), f32.from(*r[3usize + k]), f32.from(*r[6usize + k]));
}

// A form's centre: a plane's point, a sphere's or ellipsoid's centre, a cylinder's
// axis point at the middle of the fitted span, a capsule's axis midpoint
pub fn formCenter(f &Form) Vec3 {
  if f.kind == FormCylinder {
    imm d = unitd(pv(&f.params, 3usize));
    imm c = pv(&f.params, 0usize) + d * (0.5d * (*f.params[7] + *f.params[8]));
    c.toVec3();
  } elif f.kind == FormCapsule {
    ((pv(&f.params, 0usize) + pv(&f.params, 3usize)) * 0.5d).toVec3();
  } elif f.kind == FormQuadric {
    // The centre of the quadric: solve 2 A c = -b
    mut a = zeros(9usize);
    a.set(0usize, 2.d * *f.params[0]); a.set(1usize, *f.params[3]); a.set(2usize, *f.params[4]);
    a.set(3usize, *f.params[3]); a.set(4usize, 2.d * *f.params[1]); a.set(5usize, *f.params[5]);
    a.set(6usize, *f.params[4]); a.set(7usize, *f.params[5]); a.set(8usize, 2.d * *f.params[2]);
    mut b = List[f64].empty();
    b.push(-*f.params[6]); b.push(-*f.params[7]); b.push(-*f.params[8]);
    if solveLinear(&mut a, &mut b, 3usize) { new Vec3(f32.from(*b[0]), f32.from(*b[1]), f32.from(*b[2])); }
    else { new Vec3(0., 0., 0.); };
  } else {
    pv(&f.params, 0usize).toVec3();
  };
}
