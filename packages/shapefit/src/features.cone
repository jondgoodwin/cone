// ======== Features on a field: peaks, pits, and crease lines ========
//
// A residual (or any per-vertex field: a curvature, a height) shows where a shape
// has a feature the fitted form lacks. These find them:
//
// - Peaks and pits (never on the mesh's border, where "higher than every neighbour"
//   only means the neighbours are missing): a vertex whose value is higher (lower) than every vertex that
//   shares an edge with it and at least 'minHeight' above (below) zero, then
//   thinned so that no two kept ones are closer than 'minSeparation', the stronger
//   keeping its place. Returned strongest first.
// - Creases: ridge lines and valley lines of the field. At each vertex the field is
//   fitted by a quadratic over its neighbours (two rings) in the tangent plane, by
//   weighted least squares; the Hessian's eigen-directions say how the field bends.
//   A vertex is on a RIDGE if the field bends down across it by more than
//   'minBend' (its most negative second derivative) and the vertex is no lower
//   than its neighbours that lie most nearly along that direction, on either side
//   (the crest of the bend), and the field bends the other way less than half as
//   much (so a bump or a dent, which bends both ways, is no crease); a VALLEY is the same upside down. Flagged vertices
//   that are neighbours are chained into lines (a line is a list of vertex
//   numbers, each step along an edge), and lines of fewer than 'minLength' vertices
//   are dropped.

pub struct Creases {
  pub ridges: List[List[u32]];
  pub valleys: List[List[u32]];
  pub ridgeFlag: List[bool];      // per vertex: on a ridge line that was kept
  pub valleyFlag: List[bool];
}

// The local maxima of the field (or, with 'pits', the local minima), see the top
pub fn findExtrema(m: &PolyMesh, field: &List[f32], minHeight: f32, minSeparation: f32, pits: bool) List[u32] {
  let nv = m.vertexCount();
  var cand = List[u32].empty();
  var v = 0usize;
  while v < nv {
    let val = if pits { -*field[v] } else { *field[v] };
    if val >= minHeight && val > 0. && !m.isBoundaryVertex(u32.from(v)) {
      let nb = m.vertexNeighbors(u32.from(v));
      var top = nb.len() > 0usize;
      var k = 0usize;
      while k < nb.len() {
        let o = if pits { -*field[usize.from(*nb[k])] } else { *field[usize.from(*nb[k])] };
        if o >= val { top = false; }
        k += 1usize;
      }
      if top { cand.push(u32.from(v)); }
    }
    v += 1usize;
  }
  // strongest first, ties by vertex number
  cand.sortBy((a, b) => {
    let fa = if pits { -*field[usize.from(*a)] } else { *field[usize.from(*a)] };
    let fb = if pits { -*field[usize.from(*b)] } else { *field[usize.from(*b)] };
    if fa > fb { -1i32 } elif fa < fb { 1i32 } elif *a < *b { -1i32 } else { 1i32 }
  });
  var kept = List[u32].empty();
  var i = 0usize;
  while i < cand.len() {
    var near = false;
    var k = 0usize;
    while k < kept.len() {
      if m.positions[usize.from(*cand[i])].distance(*m.positions[usize.from(*kept[k])]) < minSeparation { near = true; }
      k += 1usize;
    }
    if !near { kept.push(*cand[i]); }
    i += 1usize;
  }
  kept
}

pub fn findPeaks(m: &PolyMesh, field: &List[f32], minHeight: f32, minSeparation: f32) List[u32] {
  findExtrema(m, field, minHeight, minSeparation, false)
}

pub fn findPits(m: &PolyMesh, field: &List[f32], minDepth: f32, minSeparation: f32) List[u32] {
  findExtrema(m, field, minDepth, minSeparation, true)
}

// The vertices within two edges of v (not v), without repeats, in discovery order
fn twoRing(m: &PolyMesh, v: u32) List[u32] {
  var out = List[u32].empty();
  let first = m.vertexNeighbors(v);
  var k = 0usize;
  while k < first.len() { out.push(*first[k]); k += 1usize; }
  k = 0usize;
  while k < first.len() {
    let second = m.vertexNeighbors(*first[k]);
    var j = 0usize;
    while j < second.len() {
      let c = *second[j];
      if c != v {
        var seen = false;
        var q = 0usize;
        while q < out.len() { if *out[q] == c { seen = true; } q += 1usize; }
        if !seen { out.push(c); }
      }
      j += 1usize;
    }
    k += 1usize;
  }
  out
}

// Chain flagged vertices (neighbours along an edge) into lines of at least minLength vertices
fn chainLines(m: &PolyMesh, flag: &List[bool], minLength: usize) List[List[u32]] {
  let nv = m.vertexCount();
  var used = List[bool].withCapacity(nv);
  var v = 0usize;
  while v < nv { used.push(false); v += 1usize; }
  var lines = List[List[u32]].empty();
  // Start from the ends first (one flagged neighbour), then from anything left
  var pass = 0;
  while pass < 2 {
    v = 0usize;
    while v < nv {
      if *flag[v] && !*used[v] {
        let nb = m.vertexNeighbors(u32.from(v));
        var deg = 0;
        var k = 0usize;
        while k < nb.len() { if *flag[usize.from(*nb[k])] { deg += 1; } k += 1usize; }
        if pass == 1 || deg <= 1 {
          var line = List[u32].empty();
          var cur = v;
          line.push(u32.from(cur));
          used.set(cur, true);
          var going = true;
          while going {
            let cn = m.vertexNeighbors(u32.from(cur));
            // continue to the unused flagged neighbour that keeps the direction
            var bestN = NoIndex;
            var bestScore = -2.0;
            var j = 0usize;
            while j < cn.len() {
              let c = usize.from(*cn[j]);
              if *flag[c] && !*used[c] {
                var score = 0.0;
                if line.len() >= 2usize {
                  let prev = DVec3.from(*m.positions[usize.from(*line[line.len() - 2usize])]);
                  let here = DVec3.from(*m.positions[cur]);
                  let go = unitd(DVec3.from(*m.positions[c]) - here);
                  score = go.dot(unitd(here - prev));
                } else { score = 0.0; }
                if bestN == NoIndex || score > bestScore { bestN = *cn[j]; bestScore = score; }
              }
              j += 1usize;
            }
            if bestN == NoIndex { going = false; } else {
              cur = usize.from(bestN);
              line.push(bestN);
              used.set(cur, true);
            }
          }
          if line.len() >= minLength { lines.push(line); }
        }
      }
      v += 1usize;
    }
    pass += 1;
  }
  lines
}

// Ridge and valley lines of the field (see the top). 'minBend' is the least
// second derivative (field units per length squared) that counts as a crease.
pub fn findCreases(m: &PolyMesh, field: &List[f32], minBend: f32, minLength: usize) Creases {
  let nv = m.vertexCount();
  let normals = m.vertexNormals();
  var ridge = List[bool].withCapacity(nv);
  var valley = List[bool].withCapacity(nv);
  var v = 0usize;
  while v < nv {
    ridge.push(false);
    valley.push(false);
    v += 1usize;
  }
  v = 0usize;
  while v < nv {
    let ring = twoRing(m, u32.from(v));
    let n = unitd(DVec3.from(*normals[v]));
    if ring.len() >= 5usize && n.lengthSquared() > 0.5 {
      let e1 = perpendicularTo(n);
      let e2 = crossd(n, e1);
      let p0 = DVec3.from(*m.positions[v]);
      // normal equations for  df = gx u + gy v + 0.5 hxx u^2 + hxy u v + 0.5 hyy v^2
      var a = zeros(25usize);
      var b = zeros(5usize);
      var k = 0usize;
      while k < ring.len() {
        let d = DVec3.from(*m.positions[usize.from(*ring[k])]) - p0;
        let u = d.dot(e1);
        let w2 = d.dot(e2);
        let df = f64.from(*field[usize.from(*ring[k])] - *field[v]);
        let wgt = 1.0 / (d.lengthSquared() + 1.0e-30);
        let row = [u, w2, 0.5 * u * u, u * w2, 0.5 * w2 * w2];
        var r = 0usize;
        while r < 5usize {
          var c = 0usize;
          while c < 5usize { a.set(r * 5usize + c, *a[r * 5usize + c] + wgt * row[r] * row[c]); c += 1usize; }
          b.set(r, *b[r] + wgt * row[r] * df);
          r += 1usize;
        }
        k += 1usize;
      }
      // a little ridge regularisation keeps a thin neighbourhood solvable
      var tr = 0.0;
      k = 0usize;
      while k < 5usize { tr = tr + *a[k * 5usize + k]; k += 1usize; }
      k = 0usize;
      while k < 5usize { a.set(k * 5usize + k, *a[k * 5usize + k] + 1.0e-9 * tr + 1.0e-300); k += 1usize; }
      if solveLinear(&mut a, &mut b, 5usize) {
        // The Hessian [[hxx, hxy], [hxy, hyy]]: eigenvalues and directions
        let hxx = *b[2];
        let hxy = *b[3];
        let hyy = *b[4];
        let half = 0.5 * (hxx - hyy);
        let rad = sqrtd(half * half + hxy * hxy);
        let mid = 0.5 * (hxx + hyy);
        let lamHi = mid + rad;
        let lamLo = mid - rad;
        // angle of the eigenvector of lamHi, the other perpendicular
        let th = 0.5 * libc.atan2(2.0 * hxy, hxx - hyy);
        let dirHi = e1 * libc.cos(th) + e2 * libc.sin(th);
        let dirLo = crossd(n, dirHi);
        // ridge: bends down most across dirLo
        // and the bend the other way is less than half as strong: a bump bends both ways, a ridge one
        if lamLo < -f64.from(minBend) && lamHi > 0.5 * lamLo && crestAlong(m, field, v, dirLo, true) { ridge.set(v, true); }
        if lamHi > f64.from(minBend) && lamLo < 0.5 * lamHi && crestAlong(m, field, v, dirHi, false) { valley.set(v, true); }
      }
    }
    v += 1usize;
  }
  let rl = chainLines(m, &ridge, minLength);
  let vl = chainLines(m, &valley, minLength);
  var rf = List[bool].withCapacity(nv);
  var vf = List[bool].withCapacity(nv);
  v = 0usize;
  while v < nv { rf.push(false); vf.push(false); v += 1usize; }
  var i = 0usize;
  while i < rl.len() { var k = 0usize; while k < rl[i].len() { rf.set(usize.from(*rl[i][k]), true); k += 1usize; } i += 1usize; }
  i = 0usize;
  while i < vl.len() { var k = 0usize; while k < vl[i].len() { vf.set(usize.from(*vl[i][k]), true); k += 1usize; } i += 1usize; }
  new Creases(rl, vl, rf, vf)
}

// Whether vertex v is at least as high (as low, if 'high' is false) as its neighbours
// that lie most nearly along the direction d, forwards and backwards. A side with no
// neighbour within 60 degrees of the direction is taken as satisfied (a border).
fn crestAlong(m: &PolyMesh, field: &List[f32], v: usize, d: DVec3, high: bool) bool {
  let nb = m.vertexNeighbors(u32.from(v));
  let p0 = DVec3.from(*m.positions[v]);
  var bestF = -1.0;
  var bestB = -1.0;
  var nF = NoIndex;
  var nB = NoIndex;
  var k = 0usize;
  while k < nb.len() {
    let o = DVec3.from(*m.positions[usize.from(*nb[k])]) - p0;
    let c = unitd(o).dot(d);
    if c > bestF { bestF = c; nF = *nb[k]; }
    if -c > bestB { bestB = -c; nB = *nb[k]; }
    k += 1usize;
  }
  var ok = true;
  if nF != NoIndex && bestF > 0.5 {
    if high { if *field[usize.from(nF)] > *field[v] { ok = false; } } else { if *field[usize.from(nF)] < *field[v] { ok = false; } }
  }
  if nB != NoIndex && bestB > 0.5 {
    if high { if *field[usize.from(nB)] > *field[v] { ok = false; } } else { if *field[usize.from(nB)] < *field[v] { ok = false; } }
  }
  ok
}
