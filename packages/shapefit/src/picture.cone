// ======== Pictures: a software canvas to show the measurements ========
//
// The instruments produce numbers per vertex; a picture of them is how a person
// sees where a shape is wrong. This is a small CPU renderer, with no GPU or window
// needed, so the example (and anyone's tests) can write PNG sheets anywhere:
// an orthographic view (the silhouette module's View and Window) of a PolyMesh,
// Gouraud-shaded by a light at the viewer with a colour per vertex, lines and dots
// on top (outlines, crease lines, peaks and pits), a bitmap font in capitals, and
// the PNG save. A Viewport is a tile of the canvas, so a sheet holds many views.

pub struct Viewport {
  pub x i32;
  pub y i32;
  pub w i32;
  pub h i32;
}

pub struct Canvas {
  pub w i32;
  pub h i32;
  pub rgba List[u8];       // rows from the top
  pub depth List[f32];     // per pixel: the nearest depth drawn

  pub fn make(w i32, h i32, bg Vec3) Canvas {
    var rgba = List[u8].withCapacity(usize.from(w) * usize.from(h) * 4usize);
    var depth = List[f32].withCapacity(usize.from(w) * usize.from(h));
    var i = 0usize;
    while i < usize.from(w) * usize.from(h) {
      rgba.push(byteOf(bg.x)); rgba.push(byteOf(bg.y)); rgba.push(byteOf(bg.z)); rgba.push(255u8);
      depth.push(1.0e30);
      i += 1usize;
    }
    new Canvas(w, h, rgba, depth)
  }

  pub fn setPixel(self &mut, x i32, y i32, c Vec3) {
    if x >= 0 and y >= 0 and x < w and y < h {
      let i = (usize.from(y) * usize.from(w) + usize.from(x)) * 4usize;
      rgba.set(i, byteOf(c.x)); rgba.set(i + 1usize, byteOf(c.y)); rgba.set(i + 2usize, byteOf(c.z));
    }
  }

  pub fn fillRect(self &mut, x i32, y i32, rw i32, rh i32, c Vec3) {
    var j = 0;
    while j < rh {
      var i = 0;
      while i < rw { setPixel(x + i, y + j, c); i += 1; }
      j += 1;
    }
  }

  // A line between two pixels (not depth tested)
  pub fn line(self &mut, x0 i32, y0 i32, x1 i32, y1 i32, c Vec3) {
    let dx = if x1 > x0 { x1 - x0 } else { x0 - x1 };
    let dy = if y1 > y0 { y1 - y0 } else { y0 - y1 };
    let n = if dx > dy { dx } else { dy };
    var k = 0;
    while k <= n {
      let t = if n == 0 { 0. } else { f32.from(k) / f32.from(n) };
      setPixel(x0 + i32.from(libc.floorf(f32.from(x1 - x0) * t + 0.5)), y0 + i32.from(libc.floorf(f32.from(y1 - y0) * t + 0.5)), c);
      k += 1;
    }
  }

  // A filled disc of the radius about a pixel
  pub fn dot(self &mut, cx i32, cy i32, r i32, c Vec3) {
    var j = -r;
    while j <= r {
      var i = -r;
      while i <= r {
        if i * i + j * j <= r * r + r { setPixel(cx + i, cy + j, c); }
        i += 1;
      }
      j += 1;
    }
  }

  // Capital letters, digits and a few signs in a 5 x 7 font, each pixel 'scale' square;
  // lower case is drawn as upper. Returns the x after the text.
  pub fn text(self &mut, x i32, y i32, s &str, scale i32, c Vec3) i32 {
    var cx = x;
    var k = 0usize;
    while k < s.len() {
      let bits = glyph(s[k]);
      var r = 0;
      while r < 7 {
        var q = 0;
        while q < 5 {
          if bits[usize.from(r * 5 + q)] == 35u8 { fillRect(cx + q * scale, y + r * scale, scale, scale, c); }
          q += 1;
        }
        r += 1;
      }
      cx = cx + 6 * scale;
      k += 1usize;
    }
    cx
  }

  // Write the canvas as a PNG into the folder
  pub fn save(self &, dir &str, name &str) bool {
    var r = Raster.empty();
    r.width = w;
    r.height = h;
    r.depth = 8;
    r.colorSpace = ColorSpace.Srgb;
    r.pixels8.resize(usize.from(w) * usize.from(h) * 4usize, 255u8);
    var i = 0usize;
    while i < rgba.len() { r.pixels8.set(i, *rgba[i]); i += 1usize; }
    let png = encodePng(&r, 2);
    var full = String.from(dir);
    full.append("/");
    full.append(name);
    let op = Path.from(full.view());
    var ok = false;
    match fs.writeFile(&op, png.view()) {
      case let good Ok { ok = true; }
      case let bad Error { ok = false; }
    }
    ok
  }
}

fn byteOf(v f32) u8 {
  let x = if v < 0. { 0. } elif v > 1. { 1. } else { v };
  u8.from(i32.from(libc.floorf(x * 255. + 0.5)))
}

// A number as text with the given digits after the point: numberText(-3.14159, 2) is "-3.14"
pub fn numberText(v f32, decimals i32) String {
  var s = String.empty();
  var x = f64.from(v);
  if x < 0.d { s.append("-"); x = -x; }
  var scale = 1.d;
  var d = 0;
  while d < decimals { scale = scale * 10.d; d += 1; }
  let r = libc.floor(x * scale + 0.5d);
  let whole = libc.floor(r / scale);
  s.appendUInt(u64.from(whole));
  if decimals > 0 {
    s.append(".");
    let frac = r - whole * scale;
    var digits = String.empty();
    digits.appendUInt(u64.from(frac));
    var pad = decimals - i32.from(digits.len());
    while pad > 0 { s.append("0"); pad -= 1; }
    s.append(digits.view());
  }
  s
}

// ---- colour maps ----

// Blue for negative, white at 0, red for positive; x runs -1 to 1 (clamped)
pub fn divergingColor(x f32) Vec3 {
  let t = if x < -1. { -1. } elif x > 1. { 1. } else { x };
  if t >= 0. { new Vec3(1., 1. - 0.85 * t, 1. - 0.9 * t) } else { new Vec3(1. + 0.9 * t, 1. + 0.55 * t, 1.) }
}

// A colour for each patch class: flat grey, dome red, cup blue, saddle yellow, ridge orange, valley teal
pub fn patchColor(c u32) Vec3 {
  if c == PatchFlat { new Vec3(0.8, 0.8, 0.8) }
  elif c == PatchDome { new Vec3(0.88, 0.25, 0.22) }
  elif c == PatchCup { new Vec3(0.2, 0.4, 0.85) }
  elif c == PatchSaddle { new Vec3(0.95, 0.85, 0.2) }
  elif c == PatchRidge { new Vec3(0.95, 0.55, 0.15) }
  else { new Vec3(0.15, 0.7, 0.65) }
}

// A colour per vertex from a field, scaled so that +-range is the full colour
pub fn fieldColors(field &List[f32], range f32) List[Vec3] {
  var out = List[Vec3].withCapacity(field.len());
  var i = 0usize;
  while i < field.len() { out.push(divergingColor(*field[i] / range)); i += 1usize; }
  out
}

pub fn patchColors(classes &List[u32]) List[Vec3] {
  var out = List[Vec3].withCapacity(classes.len());
  var i = 0usize;
  while i < classes.len() { out.push(patchColor(*classes[i])); i += 1usize; }
  out
}

// ---- mapping the view to the tile ----

// The pixel (x, y from the top) of the view-plane point (px, py) in the tile
fn tileX(vp &Viewport, win &Window, px f64) f64 {
  f64.from(vp.x) + 0.5d * (f64.from(vp.w) - f64.from(win.w)) + (px - win.x0) * win.scale
}
fn tileY(vp &Viewport, win &Window, py f64) f64 {
  f64.from(vp.y) + 0.5d * (f64.from(vp.h) - f64.from(win.h)) + (f64.from(win.h) - (py - win.y0) * win.scale)
}

// A window for the mesh (or two meshes) in the view, fitted to the tile with a margin
pub fn tileWindow(a &PolyMesh, b &PolyMesh, v &View, vp &Viewport) Window {
  let side = if vp.w < vp.h { vp.w } else { vp.h };
  windowFor(a, b, v, usize.from(side - 8))
}

// Draw the mesh into the tile: lit by a light at the viewer, each vertex coloured
// ('colors' per vertex, or empty for grey). Depth is tested against the canvas's.
pub fn drawMesh(cv &mut Canvas, vp &Viewport, win &Window, m &PolyMesh, v &View, colors &List[Vec3]) {
  let tris = fanTriangles(m);
  let normals = m.vertexNormals();
  let nv = m.vertexCount();
  var sx = List[f64].withCapacity(nv);
  var sy = List[f64].withCapacity(nv);
  var sz = List[f64].withCapacity(nv);
  var i = 0usize;
  while i < nv {
    let q = v.project(DVec3.from(*m.positions[i]));
    sx.push(tileX(vp, win, q.x));
    sy.push(tileY(vp, win, q.y));
    sz.push(q.z);
    i += 1usize;
  }
  let toward = -v.forward;
  i = 0usize;
  while i < tris.len() / 3usize {
    let ia = usize.from(*tris[3usize * i]);
    let ib = usize.from(*tris[3usize * i + 1usize]);
    let ic = usize.from(*tris[3usize * i + 2usize]);
    let ax = *sx[ia]; let ay = *sy[ia];
    let bx = *sx[ib]; let byy = *sy[ib];
    let cx = *sx[ic]; let cy = *sy[ic];
    let area = (bx - ax) * (cy - ay) - (byy - ay) * (cx - ax);
    if absd(area) > 1.0e-9d {
      let x0 = usize.from(maxd(f64.from(vp.x), libc.floor(mind(ax, mind(bx, cx)) - 0.5d)));
      let x1 = usize.from(mind(f64.from(vp.x + vp.w) - 1.d, libc.ceil(maxd(ax, maxd(bx, cx)) - 0.5d)));
      let y0 = usize.from(maxd(f64.from(vp.y), libc.floor(mind(ay, mind(byy, cy)) - 0.5d)));
      let y1 = usize.from(mind(f64.from(vp.y + vp.h) - 1.d, libc.ceil(maxd(ay, maxd(byy, cy)) - 0.5d)));
      let na = unitd(DVec3.from(*normals[ia]));
      let nb = unitd(DVec3.from(*normals[ib]));
      let nc = unitd(DVec3.from(*normals[ic]));
      let have = colors.len() == nv;
      let ca = if have { *colors[ia] } else { new Vec3(0.78, 0.78, 0.8) };
      let cb = if have { *colors[ib] } else { new Vec3(0.78, 0.78, 0.8) };
      let cc = if have { *colors[ic] } else { new Vec3(0.78, 0.78, 0.8) };
      var y = y0;
      while y <= y1 {
        var x = x0;
        while x <= x1 {
          let qx = f64.from(x) + 0.5d;
          let qy = f64.from(y) + 0.5d;
          let w0 = ((bx - qx) * (cy - qy) - (byy - qy) * (cx - qx)) / area;
          let w1 = ((cx - qx) * (ay - qy) - (cy - qy) * (ax - qx)) / area;
          let w2 = 1.d - w0 - w1;
          if w0 >= -1.0e-9d and w1 >= -1.0e-9d and w2 >= -1.0e-9d {
            let z = f32.from(w0 * *sz[ia] + w1 * *sz[ib] + w2 * *sz[ic]);
            let di = y * usize.from(cv.w) + x;
            if z < *cv.depth[di] {
              cv.depth.set(di, z);
              let n = unitd(na * w0 + nb * w1 + nc * w2);
              // the light's side is the viewer's; faces turned away are lit from behind, dimmer
              let lit = absd(n.dot(toward));
              let k = f32.from(0.3d + 0.7d * lit);
              let col = (ca * f32.from(w0) + cb * f32.from(w1) + cc * f32.from(w2)) * k;
              cv.setPixel(i32.from(x), i32.from(y), col);
            }
          }
          x += 1usize;
        }
        y += 1usize;
      }
    }
    i += 1usize;
  }
}

// A light rig fixed to the view, so that two shapes drawn in the same view are lit
// alike: a key light and a fill light (directions the light travels FROM, in the
// view's frame: x right, y up, z toward the viewer), an ambient term, and a soft
// specular highlight from the key (Blinn-Phong). Wrapped diffuse ('wrap' 0 to 1)
// softens the terminator as skin's scattering does.
pub struct Lighting {
  pub key Vec3;
  pub keyStrength f32;
  pub fill Vec3;
  pub fillStrength f32;
  pub ambient f32;
  pub wrap f32;
  pub specular f32;
  pub shininess f32;

  // The portrait rig: key from the upper left in front, fill low from the right,
  // a little ambient, a soft highlight; the form reads in its planes
  pub fn portrait() Lighting {
    new Lighting(new Vec3(-0.55, 0.55, 0.63), 0.85, new Vec3(0.75, -0.1, 0.65), 0.28, 0.12, 0.25, 0.12, 24.)
  }
}

fn viewToWorld(v &View, d Vec3) DVec3 {
  unitd(v.right * f64.from(d.x) + v.up * f64.from(d.y) - v.forward * f64.from(d.z))
}

// Draw the mesh into the tile, lit by 'light' (see Lighting), each vertex coloured
// ('colors' per vertex, or empty for a skin-like grey). Faces seen from behind are
// lit as if their normals were turned toward the viewer. Depth is tested against
// the canvas's.
pub fn drawMeshLit(cv &mut Canvas, vp &Viewport, win &Window, m &PolyMesh, v &View, colors &List[Vec3], light &Lighting) {
  let tris = fanTriangles(m);
  let normals = m.vertexNormals();
  let nv = m.vertexCount();
  var sx = List[f64].withCapacity(nv);
  var sy = List[f64].withCapacity(nv);
  var sz = List[f64].withCapacity(nv);
  var i = 0usize;
  while i < nv {
    let q = v.project(DVec3.from(*m.positions[i]));
    sx.push(tileX(vp, win, q.x));
    sy.push(tileY(vp, win, q.y));
    sz.push(q.z);
    i += 1usize;
  }
  let toward = -v.forward;
  let kd = viewToWorld(v, light.key);
  let fd = viewToWorld(v, light.fill);
  let hk = unitd(kd + toward);
  let wrap = f64.from(light.wrap);
  i = 0usize;
  while i < tris.len() / 3usize {
    let ia = usize.from(*tris[3usize * i]);
    let ib = usize.from(*tris[3usize * i + 1usize]);
    let ic = usize.from(*tris[3usize * i + 2usize]);
    let ax = *sx[ia]; let ay = *sy[ia];
    let bx = *sx[ib]; let byy = *sy[ib];
    let cx = *sx[ic]; let cy = *sy[ic];
    let area = (bx - ax) * (cy - ay) - (byy - ay) * (cx - ax);
    if absd(area) > 1.0e-9d {
      let x0 = usize.from(maxd(f64.from(vp.x), libc.floor(mind(ax, mind(bx, cx)) - 0.5d)));
      let x1 = usize.from(mind(f64.from(vp.x + vp.w) - 1.d, libc.ceil(maxd(ax, maxd(bx, cx)) - 0.5d)));
      let y0 = usize.from(maxd(f64.from(vp.y), libc.floor(mind(ay, mind(byy, cy)) - 0.5d)));
      let y1 = usize.from(mind(f64.from(vp.y + vp.h) - 1.d, libc.ceil(maxd(ay, maxd(byy, cy)) - 0.5d)));
      let na = unitd(DVec3.from(*normals[ia]));
      let nb = unitd(DVec3.from(*normals[ib]));
      let nc = unitd(DVec3.from(*normals[ic]));
      let have = colors.len() == nv;
      let grey = new Vec3(0.80, 0.70, 0.64);
      let ca = if have { *colors[ia] } else { grey };
      let cb = if have { *colors[ib] } else { grey };
      let cc = if have { *colors[ic] } else { grey };
      var y = y0;
      while y <= y1 {
        var x = x0;
        while x <= x1 {
          let qx = f64.from(x) + 0.5d;
          let qy = f64.from(y) + 0.5d;
          let w0 = ((bx - qx) * (cy - qy) - (byy - qy) * (cx - qx)) / area;
          let w1 = ((cx - qx) * (ay - qy) - (cy - qy) * (ax - qx)) / area;
          let w2 = 1.d - w0 - w1;
          if w0 >= -1.0e-9d and w1 >= -1.0e-9d and w2 >= -1.0e-9d {
            let z = f32.from(w0 * *sz[ia] + w1 * *sz[ib] + w2 * *sz[ic]);
            let di = y * usize.from(cv.w) + x;
            if z < *cv.depth[di] {
              cv.depth.set(di, z);
              var n = unitd(na * w0 + nb * w1 + nc * w2);
              if n.dot(toward) < 0.d { n = n * -1.d; }
              let dk = maxd(0.d, (n.dot(kd) + wrap) / (1.d + wrap));
              let df = maxd(0.d, (n.dot(fd) + wrap) / (1.d + wrap));
              let sp = libc.pow(maxd(0.d, n.dot(hk)), f64.from(light.shininess)) * f64.from(light.specular);
              let k = f32.from(f64.from(light.ambient) + f64.from(light.keyStrength) * dk + f64.from(light.fillStrength) * df);
              let base = (ca * f32.from(w0) + cb * f32.from(w1) + cc * f32.from(w2)) * k;
              let s = f32.from(sp);
              cv.setPixel(i32.from(x), i32.from(y), new Vec3(base.x + s, base.y + s, base.z + s));
            }
          }
          x += 1usize;
        }
        y += 1usize;
      }
    }
    i += 1usize;
  }
}

// A polyline on the surface (3-D points), drawn depth-tested against the mesh just drawn
pub fn drawPolyline3(cv &mut Canvas, vp &Viewport, win &Window, v &View, pts &List[Vec3], c Vec3) {
  var k = 0usize;
  while k + 1usize < pts.len() {
    let p = v.project(DVec3.from(*pts[k]));
    let q = v.project(DVec3.from(*pts[k + 1usize]));
    let x0 = tileX(vp, win, p.x); let y0 = tileY(vp, win, p.y);
    let x1 = tileX(vp, win, q.x); let y1 = tileY(vp, win, q.y);
    let n = i32.from(maxd(absd(x1 - x0), absd(y1 - y0))) + 1;
    var s = 0;
    while s <= n {
      let t = f64.from(s) / f64.from(n);
      let px = i32.from(libc.floor(x0 + (x1 - x0) * t));
      let py = i32.from(libc.floor(y0 + (y1 - y0) * t));
      let z = f32.from(p.z + (q.z - p.z) * t);
      if px >= vp.x and py >= vp.y and px < vp.x + vp.w and py < vp.y + vp.h {
        // within a hair of the surface drawn there, or in front
        if z <= *cv.depth[usize.from(py) * usize.from(cv.w) + usize.from(px)] + f32.from(3.d / win.scale) {
          cv.setPixel(px, py, c);
        }
      }
      s += 1;
    }
    k += 1usize;
  }
}

// A marker at a 3-D point (not depth tested; a dot of the radius in pixels)
pub fn drawMarker3(cv &mut Canvas, vp &Viewport, win &Window, v &View, p Vec3, r i32, c Vec3) {
  let q = v.project(DVec3.from(p));
  cv.dot(i32.from(libc.floor(tileX(vp, win, q.x))), i32.from(libc.floor(tileY(vp, win, q.y))), r, c);
}

// Closed outlines in the view plane (the silhouette module's loops), as lines on the tile
pub fn drawLoops(cv &mut Canvas, vp &Viewport, win &Window, loops &List[List[Vec2]], c Vec3) {
  var i = 0usize;
  while i < loops.len() {
    let l = loops[i];
    var k = 0usize;
    while k < l.len() {
      let p = *l[k];
      let q = *l[(k + 1usize) % l.len()];
      cv.line(i32.from(libc.floor(tileX(vp, win, f64.from(p.x)))), i32.from(libc.floor(tileY(vp, win, f64.from(p.y)))),
        i32.from(libc.floor(tileX(vp, win, f64.from(q.x)))), i32.from(libc.floor(tileY(vp, win, f64.from(q.y)))), c);
      k += 1usize;
    }
    i += 1usize;
  }
}

// A colour bar: blue to white to red across the rectangle, with the end labels
pub fn drawColorBar(cv &mut Canvas, x i32, y i32, w i32, h i32, lo &str, hi &str) {
  var i = 0;
  while i < w {
    cv.fillRect(x + i, y, 1, h, divergingColor(2. * f32.from(i) / f32.from(w - 1) - 1.));
    i += 1;
  }
  cv.text(x, y + h + 3, lo, 2, new Vec3(0.1, 0.1, 0.1));
  cv.text(x + w - 12 * i32.from(hi.len()), y + h + 3, hi, 2, new Vec3(0.1, 0.1, 0.1));
}

// The 5 x 7 bitmap of a character, 35 bytes of '#' and '.', row by row
fn glyph(ch u8) &str {
  let c = if ch >= 97u8 and ch <= 122u8 { ch - 32u8 } else { ch };
  if c == 48u8 { ".###.#...##..###.#.###..##...#.###." }
  elif c == 49u8 { "..#...##....#....#....#....#...###." }
  elif c == 50u8 { ".###.#...#....#...#...#...#...#####" }
  elif c == 51u8 { ".###.#...#....#..##.....##...#.###." }
  elif c == 52u8 { "...#...##..#.#.#..#.#####...#....#." }
  elif c == 53u8 { "######....####.....#....##...#.###." }
  elif c == 54u8 { "..##..#...#....####.#...##...#.###." }
  elif c == 55u8 { "#####....#...#...#...#....#....#..." }
  elif c == 56u8 { ".###.#...##...#.###.#...##...#.###." }
  elif c == 57u8 { ".###.#...##...#.####....#...#..##.." }
  elif c == 65u8 { ".###.#...##...#######...##...##...#" }
  elif c == 66u8 { "####.#...##...#####.#...##...#####." }
  elif c == 67u8 { ".###.#...##....#....#....#...#.###." }
  elif c == 68u8 { "####.#...##...##...##...##...#####." }
  elif c == 69u8 { "######....#....####.#....#....#####" }
  elif c == 70u8 { "######....#....####.#....#....#...." }
  elif c == 71u8 { ".###.#...##....#.####...##...#.###." }
  elif c == 72u8 { "#...##...##...#######...##...##...#" }
  elif c == 73u8 { ".###...#....#....#....#....#...###." }
  elif c == 74u8 { "..###...#....#....#....#.#..#..##.." }
  elif c == 75u8 { "#...##..#.#.#..##...#.#..#..#.#...#" }
  elif c == 76u8 { "#....#....#....#....#....#....#####" }
  elif c == 77u8 { "#...###.###.#.##.#.##...##...##...#" }
  elif c == 78u8 { "#...###..##.#.##..###...##...##...#" }
  elif c == 79u8 { ".###.#...##...##...##...##...#.###." }
  elif c == 80u8 { "####.#...##...#####.#....#....#...." }
  elif c == 81u8 { ".###.#...##...##...##.#.##..#..##.#" }
