// shapefit's penalised spline: 'fitPenalisedSpline', checked with geomath's 'bsplineAt' against values worked out
// by hand and against the Python fit it replaces.
//
// A penalty on second differences leaves every straight line untouched (a line's coefficients, 2x + 1 sampled at
// the knots, have second differences 0), so a spline fitted to points exactly on a line returns that line at any
// penalty; and as the penalty grows, the fit tends to the best straight line.
//
// - y = 2x + 1 at 20 points on [0, 1], 12 coefficients, penalty 0.1, 10 and 1000: 2x + 1 to 1e-4 at 50 places.
// - The points (0, 0), (1, 1), (2, 0) on [0, 2], 8 coefficients, penalty 1e8: the best straight line through them
//   is the mean, 1/3 (the x values are symmetric, so the slope is 0): 0.3333 everywhere to 1e-3.
// - Even about the middle, 10 coefficients on [-1, 1]: y = x^2 at 15 points (penalty 0) gives mirrored
//   coefficients, slope 0 at 0 and 0.25 at both -0.5 and 0.5 to 1e-3; y = x, which no even curve follows, still
//   gives slope 0 at 0 and equal values at 0.3 and -0.3.
// - Uneven points on (x - 0.5)^2 + 0.1 x over [0, 1], even about the middle: slope at 0.5 is 0 to 1e-6; with
//   the flag off it is not (the data's own slope there is 0.1).
// - Refusals, each one problem line and an empty list: penalty 0 with 3 points and 8 coefficients; 3 coefficients;
//   513 coefficients; unequal lists.
// - The real case: one track of the knight's nose top (the upper strip's column 7 of 29 slices, widths 0 to 4.68,
//   values from 34.1 to 27.3, range 7.0087), fitted by assemble2_ps.py with FIT=ps PSN=12: 23 coefficients over
//   [-4.68, 4.68], even, penalty 0.001778 (its cross-validated choice). The Python fit's value at each of the 29
//   widths is pasted below (numpy and scipy, f64, with its 1e-9 ridge); the Cone curve must agree within 1e-4 of
//   the track's range, 7.0e-4. The largest difference seen is recorded in the report, not here.

mod splinefits;

import testing use *;
import collections use *;
import geomath use *;
import shapefit use *;

fn line(coefs: &Array[f32], what: &Array[u8]) {
  var i = 0usize;
  while i < 50usize {
    let x = f32.from(i) / 49.;
    expectFloat(bsplineAt(coefs, 0., 1., x), 2. * x + 1., 0.0001, what);
    i += 1usize;
  }
}

fn lines() {
  var xs = List[f32]();
  var ys = List[f32]();
  var i = 0usize;
  while i < 20usize {
    let x = f32.from(i) / 19.;
    xs.push(x);
    ys.push(2. * x + 1.);
    i += 1usize;
  }
  var problems = List[String]();
  let pens: Array[f32, 3] = [0.1, 10., 1000.];
  var p = 0usize;
  while p < 3usize {
    let c = fitPenalisedSpline(xs.view(), ys.view(), 0., 1., 12u32, pens[p], false, &mut problems);
    expectInt(i64.from(c.len()), 12, "a line: 12 coefficients");
    line(c.view(), "a line at any penalty");
    p += 1usize;
  }
  expectInt(i64.from(problems.len()), 0, "a line: no problem lines");
}

fn straightest() {
  let xs: Array[f32, 3] = [0., 1., 2.];
  let ys: Array[f32, 3] = [0., 1., 0.];
  var problems = List[String]();
  let c = fitPenalisedSpline(&xs, &ys, 0., 2., 8u32, 100000000., false, &mut problems);
  var i = 0usize;
  while i < 20usize {
    expectFloat(bsplineAt(c.view(), 0., 2., f32.from(i) / 10.), 1. / 3., 0.001, "huge penalty: the best straight line");
    i += 1usize;
  }
}

fn evens() {
  var xs = List[f32]();
  var ys = List[f32]();
  var i = 0usize;
  while i < 15usize {
    let x = -1. + 2. * f32.from(i) / 14.;
    xs.push(x);
    ys.push(x * x);
    i += 1usize;
  }
  var problems = List[String]();
  let c = fitPenalisedSpline(xs.view(), ys.view(), -1., 1., 10u32, 0., true, &mut problems);
  expectFloat(bsplineSlopeAt(c.view(), -1., 1., 0.), 0., 0.00001, "even fit: level at 0");
  i = 0usize;
  while i < 10usize {
    expectFloat(*c[i], *c[9usize - i], 0.000001, "even fit: mirrored coefficients");
    i += 1usize;
  }
  expectFloat(bsplineAt(c.view(), -1., 1., 0.5), 0.25, 0.001, "even fit of x squared");
  expectFloat(bsplineAt(c.view(), -1., 1., -0.5), 0.25, 0.001, "even fit of x squared, the other side");

  // y = x: the even curve cannot follow a line; it comes out level at the middle all the same
  var ly = List[f32]();
  i = 0usize;
  while i < xs.len() { ly.push(*xs[i]); i += 1usize; }
  let cl = fitPenalisedSpline(xs.view(), ly.view(), -1., 1., 10u32, 0.01, true, &mut problems);
  expectFloat(bsplineSlopeAt(cl.view(), -1., 1., 0.), 0., 0.00001, "even fit of a line: level at 0");
  expectFloat(bsplineAt(cl.view(), -1., 1., 0.3), bsplineAt(cl.view(), -1., 1., -0.3), 0.000001, "even fit of a line: even");

  // uneven points, one side thinner than the other
  var ux = List[f32]();
  var uy = List[f32]();
  i = 0usize;
  while i < 12usize {
    let t = f32.from(i) / 11.;
    let x = t * t;
    ux.push(x);
    uy.push((x - 0.5) * (x - 0.5) + 0.1 * x);
    i += 1usize;
  }
  let ce = fitPenalisedSpline(ux.view(), uy.view(), 0., 1., 12u32, 0.001, true, &mut problems);
  expectFloat(bsplineSlopeAt(ce.view(), 0., 1., 0.5), 0., 0.000001, "uneven points, even fit: level at the middle");
  let cf = fitPenalisedSpline(ux.view(), uy.view(), 0., 1., 12u32, 0.001, false, &mut problems);
  expect((bsplineSlopeAt(cf.view(), 0., 1., 0.5)).abs() > 0.01, "without the flag the slope at the middle is not 0");
  expectInt(i64.from(problems.len()), 0, "evens: no problem lines");
}

fn refusals() {
  let xs: Array[f32, 3] = [0., 1., 2.];
  let ys: Array[f32, 3] = [0., 1., 0.];
  var problems = List[String]();
  var c = fitPenalisedSpline(&xs, &ys, 0., 2., 8u32, 0., false, &mut problems);
  expectInt(i64.from(c.len()), 0, "penalty 0, 3 points, 8 coefficients: empty");
  expectInt(i64.from(problems.len()), 1, "penalty 0, 3 points, 8 coefficients: one problem line");
  c = fitPenalisedSpline(&xs, &ys, 0., 2., 3u32, 1., false, &mut problems);
  expectInt(i64.from(c.len()), 0, "3 coefficients: empty");
  expectInt(i64.from(problems.len()), 2, "3 coefficients: one more problem line");
  c = fitPenalisedSpline(&xs, &ys, 0., 2., 513u32, 1., false, &mut problems);
  expectInt(i64.from(c.len()), 0, "513 coefficients: empty");
  expectInt(i64.from(problems.len()), 3, "513 coefficients: one more problem line");
  let short: Array[f32, 2] = [0., 1.];
  c = fitPenalisedSpline(&xs, &short, 0., 2., 8u32, 1., false, &mut problems);
  expectInt(i64.from(c.len()), 0, "unequal lists: empty");
  expectInt(i64.from(problems.len()), 4, "unequal lists: one more problem line");
  // 512 is allowed
  let big = fitPenalisedSpline(&xs, &ys, 0., 2., 512u32, 1., false, &mut problems);
  expectInt(i64.from(big.len()), 512, "512 coefficients: accepted");
}

// The knight's nose-top track: widths, values, and the Python fit's values at them
fn noseTop() {
  let xs: Array[f32, 29] = [0., 0.25374585, 0.506747419, 0.758262612, 1.00755369, 1.25388944, 1.49654731,
    1.73481556, 1.96799529, 2.19540255, 2.41637032, 2.63025045, 2.83641561, 3.03426108, 3.22320653, 3.40269776,
    3.5722083, 3.73124093, 3.87932919, 4.01603871, 4.14096849, 4.2537521, 4.35405873, 4.44159414, 4.5161016,
    4.57736256, 4.62519732, 4.65946558, 4.68006682];
  let ys: Array[f32, 29] = [34.0982514, 34.0455905, 33.9156059, 33.7665423, 33.6207905, 33.4747027, 33.3469206,
    33.2024552, 33.0544774, 32.737215, 32.2809185, 31.8477467, 31.26721, 30.3591966, 29.7524968, 29.0917923,
    28.0705962, 27.4306223, 27.2773477, 27.3454449, 27.1958099, 27.1513432, 27.1318172, 27.0895713, 27.1184121,
    27.1369818, 27.2322512, 27.2470228, 27.3027595];
  let py: Array[f32, 29] = [34.0977402, 34.042712, 33.9177473, 33.7706493, 33.6178628, 33.4720876, 33.3470269,
    33.2209418, 33.0300133, 32.7348379, 32.3260139, 31.8075815, 31.1970675, 30.5074038, 29.7390726, 28.9072567,
    28.138717, 27.5801425, 27.2965611, 27.1954132, 27.1727124, 27.1611598, 27.1441691, 27.1376264, 27.1480173,
    27.1733469, 27.2066449, 27.239046, 27.2623206];
  var problems = List[String]();
  let c = fitPenalisedSpline(&xs, &ys, -4.680066820132398, 4.680066820132398, 23u32, 0.0017782794100389228, true,
    &mut problems);
  expectInt(i64.from(c.len()), 23, "nose top: 23 coefficients");
  var worst: f32 = 0.;
  var i = 0usize;
  while i < 29usize {
    let d = (bsplineAt(c.view(), -4.680066820132398, 4.680066820132398, xs[i]) - py[i]).abs();
    if d > worst {worst = d;}
    i += 1usize;
  }
  expectFloat(worst, 0., 0.0007, "nose top: Cone and Python agree within 1e-4 of the 7.0 range");
}

fn main() i32 {
  lines();
  straightest();
  evens();
  refusals();
  noseTop();
  done()
}
