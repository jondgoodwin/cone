// shapefit's linear algebra: the Jacobi eigen solver and the linear solve.

mod linalg;

import testing use *;
import collections use *;
import shapefit use *;

fn main() i32 {
  // [[2, 1, 0], [1, 2, 0], [0, 0, 5]]: eigenvalues 1, 3, 5
  var a = List[f64].empty();
  a.push(2.0); a.push(1.0); a.push(0.0);
  a.push(1.0); a.push(2.0); a.push(0.0);
  a.push(0.0); a.push(0.0); a.push(5.0);
  var vals = List[f64].empty();
  var vecs = List[f64].empty();
  jacobiEigen(&mut a, 3usize, &mut vals, &mut vecs);
  expectFloat(*vals[0], 1.0, 0.000000001, "smallest eigenvalue");
  expectFloat(*vals[1], 3.0, 0.000000001, "middle eigenvalue");
  expectFloat(*vals[2], 5.0, 0.000000001, "largest eigenvalue");
  // the eigenvector of 5 is the z axis, of 1 is (1, -1, 0) / sqrt 2 with its larger component positive
  expectFloat(*vecs[2usize * 3usize + 2usize], 1.0, 0.000000001, "z axis");
  expectFloat(absd(*vecs[0]), 0.7071067811865476, 0.000000001, "x of (1,-1,0)/sqrt2");

  // 2x + y = 5, x + 3y = 10 : x = 1, y = 3
  var m = List[f64].empty();
  m.push(2.0); m.push(1.0); m.push(1.0); m.push(3.0);
  var b = List[f64].empty();
  b.push(5.0); b.push(10.0);
  expectBool(solveLinear(&mut m, &mut b, 2usize), true, "solvable");
  expectFloat(*b[0], 1.0, 0.000000001, "x");
  expectFloat(*b[1], 3.0, 0.000000001, "y");
  done()
}

fn absd(a f64) f64 { if a < 0.0 { -a } else { a } }
