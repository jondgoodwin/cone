// shapefit's linear algebra: the Jacobi eigen solver and the linear solve.

mod linalg;

import testing use *;
import collections use *;
import shapefit use *;

fn main() i32 {
  // [[2, 1, 0], [1, 2, 0], [0, 0, 5]]: eigenvalues 1, 3, 5
  var a = List[f64].empty();
  a.push(2.0); a.push(1.0); a.push(0.0);
  a.push(1.0); a.push(2.0); a.push(0.0);
  a.push(0.0); a.push(0.0); a.push(5.0);
  var vals = List[f64].empty();
  var vecs = List[f64].empty();
  jacobiEigen(&mut a, 3usize, &mut vals, &mut vecs);
  expectFloat(*vals[0], 1.0, 0.000000001, "smallest eigenvalue");
  expectFloat(*vals[1], 3.0, 0.000000001, "middle eigenvalue");
  expectFloat(*vals[2], 5.0, 0.000000001, "largest eigenvalue");
  // the eigenvector of 5 is the z axis, of 1 is (1, -1, 0) / sqrt 2 with its larger component positive
  expectFloat(*vecs[2usize * 3usize + 2usize], 1.0, 0.000000001, "z axis");
  expectFloat((*vecs[0]).abs(), 0.7071067811865476, 0.000000001, "x of (1,-1,0)/sqrt2");

  // 2x + y = 5, x + 3y = 10 : x = 1, y = 3
  var m = List[f64].empty();
  m.push(2.0); m.push(1.0); m.push(1.0); m.push(3.0);
  var b = List[f64].empty();
  b.push(5.0); b.push(10.0);
  expectBool(solveLinear(&mut m, &mut b, 2usize), true, "solvable");
  expectFloat(*b[0], 1.0, 0.000000001, "x");
  expectFloat(*b[1], 3.0, 0.000000001, "y");
  tiesKeepTheirOrder();
  done()
}

// Equal eigenvalues keep their columns' order: for each of the 81 diagonal 4 x 4 matrices with entries 1, 2 or 3
// (every way the equal values can be laid out), the eigenvector columns come out sorted by value and, among equal
// values, by the row of the diagonal they started on.
fn tiesKeepTheirOrder() {
  let n = 4usize;
  var bad = 0;
  var code = 0usize;
  while code < 81usize {
    var d = List[f64].empty();
    var c = code;
    var i = 0usize;
    while i < n { d.push(f64.from(c % 3usize + 1usize)); c = c / 3usize; i += 1usize; }
    var a = List[f64].empty();
    i = 0usize;
    while i < n * n { a.push(if i / n == i % n { *d[i / n] } else { 0.0 }); i += 1usize; }
    var vals = List[f64].empty();
    var vecs = List[f64].empty();
    jacobiEigen(&mut a, n, &mut vals, &mut vecs);
    // the stable order of the diagonal's rows: by value, then by row
    var want = List[usize].empty();
    var v = 1usize;
    while v <= 3usize {
      i = 0usize;
      while i < n { if *d[i] == f64.from(v) { want.push(i); } i += 1usize; }
      v += 1usize;
    }
    var k = 0usize;
    while k < n {
      if (*vecs[*want[k] * n + k]).abs() < 0.5 { bad += 1; }      // column k should be the axis of row want[k]
      k += 1usize;
    }
    code += 1usize;
  }
  expectInt(i64.from(bad), 0, "equal eigenvalues keep the order of their columns");
}

