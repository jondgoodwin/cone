// shapefit's silhouettes: orthographic outlines from views without rendering,
// their area, and the comparison of two meshes by overlap and Hausdorff distance.

mod silhouettetests;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import shapefit use *;

fn main() i32 {
  let views = standardViews();
  expectInt(i64.from(views.len()), 6, "six standard views");
  expectFloat(views[0usize].right.x, -1.0, 0.0000001, "the front view looks along +z, so -x is to its right");
  expectFloat(views[0usize].up.y, 1.0, 0.0000001, "and y up");

  // A cylinder of radius 1 and height 2 (32 sides): from the front a rectangle 2 x 2, from above a polygon near the circle
  let cyl = cylinderMesh(1., 2., 4usize, 64usize);
  let win = windowFor(&cyl, &cyl, &views[0usize], 400usize);
  let cells = rasterize(&cyl, &views[0usize], &win);
  let out = traceOutline(&cells, &win);
  expectInt(i64.from(out.len()), 1, "one outline");
  expectFloat(f64.from(loopsArea(&out)), 4.0, 0.06, "front area is 2 x 2");
  expect(out[0usize].len() <= 8usize, "a rectangle needs few points");
  let topWin = windowFor(&cyl, &cyl, &views[4usize], 400usize);
  let topCells = rasterize(&cyl, &views[4usize], &topWin);
  let top = traceOutline(&topCells, &topWin);
  expectFloat(f64.from(loopsArea(&top)), 3.1365, 0.05, "top area is the 64-gon's, near pi");

  // Identical meshes overlap completely and have no distance
  let same = compareSilhouettes(&cyl, &cyl, &views, 300usize);
  expectFloat(f64.from(same[0usize].iou), 1.0, 0.0000001, "iou with itself");
  expectFloat(f64.from(same[2usize].hausdorff), 0.0, 0.0000001, "Hausdorff with itself");

  // A sphere against a sphere 1.2 times larger: the overlap is 1 / 1.44, the outlines 0.2 apart
  let s1 = sphereMesh(1., 24usize, 48usize);
  let s2 = sphereMesh(1.2, 24usize, 48usize);
  let cmp = compareSilhouettes(&s1, &s2, &views, 400usize);
  var v = 0usize;
  while v < 6usize {
    expectFloat(f64.from(cmp[v].iou), 0.6944, 0.02, "sphere overlap");
    expectFloat(f64.from(cmp[v].hausdorff), 0.2, 0.03, "sphere outlines 0.2 apart");
    v += 1usize;
  }
  expectFloat(f64.from(cmp[0usize].areaB / cmp[0usize].areaA), 1.44, 0.04, "areas scale as the square");

  // A shifted copy: a sphere moved 0.5 sideways. From the front the shift is across the view, from the side along it
  var moved = sphereMesh(1., 24usize, 48usize);
  movePoints(&mut moved, p => p + Vec3(0.5, 0., 0.));
  let sh = compareSilhouettes(&s1, &moved, &views, 400usize);
  expectFloat(f64.from(sh[0usize].hausdorff), 0.5, 0.03, "shifted across the view");
  expectFloat(f64.from(sh[2usize].hausdorff), 0.0, 0.02, "shifted along the view: the same outline");
  expectFloat(f64.from(sh[2usize].iou), 1.0, 0.01, "and the same cover");
  expect(sh[0usize].iou < 0.7, "the overlap drops across the view");

  // Turntable views
  let tt = turntableViews(8usize);
  expectInt(i64.from(tt.len()), 8, "eight turntable views");
  expectFloat(tt[2usize].forward.x, 1.0, 0.000001, "the third looks along +x");
  done()
}
