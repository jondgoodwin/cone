// shapefit's curvature and patch classes, on shapes whose curvature is known:
// a sphere (1/r each way), a cylinder (1/r across, 0 along), a plane (0), a bowl
// and a dome and a saddle over a grid (the curvatures of y = +-(x^2 -+ z^2)/2 at
// the origin are +-1 and +-1; the normals point up, so a dome is positive).

mod curvaturetests;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;
import shapefit use *;

fn absf(a f32) f32 { if a < 0. { -a; } else { a; }; }

fn main() i32 {
  // Sphere of radius 2: every interior vertex has k1 = k2 = 0.5
  let sph = sphereMesh(2., 24usize, 32usize);
  let cs = curvature(&sph);
  var worst = 0.;
  var v = 0usize;
  while v < sph.vertexCount() {
    // away from the poles' fans
    if absf(sph.positions[v].y) < 1.6 {
      worst = if absf(*cs.k1[v] - 0.5) > worst { absf(*cs.k1[v] - 0.5); } else { worst; };
      worst = if absf(*cs.k2[v] - 0.5) > worst { absf(*cs.k2[v] - 0.5); } else { worst; };
    }
    v += 1usize;
  }
  expect(worst < 0.01, "sphere curvature is 1/r everywhere off the poles");
  expectFloat(cs.mean(5usize + 32usize * 4usize), 0.5, 0.01, "sphere mean curvature");
  expectFloat(cs.gaussian(5usize + 32usize * 4usize), 0.25, 0.01, "sphere Gaussian curvature");
  let cls = classifyVertices(&cs, 0.1);
  expectInt(i64.from(*cls[5usize + 32usize * 4usize]), i64.from(PatchDome), "sphere vertices are domes");

  // Cylinder of radius 1, height 4: a side vertex has k1 = 1 across, k2 = 0 along (the axis)
  let cyl = cylinderMesh(1., 4., 8usize, 32usize);
  let cc = curvature(&cyl);
  // vertices are in rows of 32; row 4 is mid-height
  let mid = 4usize * 32usize + 3usize;
  expectFloat(*cc.k1[mid], 1., 0.01, "cylinder k1");
  expectFloat(*cc.k2[mid], 0., 0.01, "cylinder k2");
  expectFloat(absf(cc.dir2[mid].y), 1., 0.01, "cylinder k2 runs along the axis");
  expectInt(i64.from(classifyPatch(*cc.k1[mid], *cc.k2[mid], 0.1)), i64.from(PatchRidge), "cylinder side is a ridge");
  expectInt(i64.from(classifyPatch(-*cc.k2[mid], -*cc.k1[mid], 0.1)), i64.from(PatchValley), "its inside is a valley");

  // Grids over y = h(x, z), size 2 and 16 quads; the centre vertex is (8, 8)
  let centre = 8usize * 17usize + 8usize;
  let flat = gridMesh(16usize, 2., (x, z) => 0.);
  let cf = curvature(&flat);
  expectFloat(*cf.k1[centre], 0., 0.0001, "plane k1");
  expectFloat(*cf.k2[centre], 0., 0.0001, "plane k2");
  expectInt(i64.from(classifyPatch(*cf.k1[centre], *cf.k2[centre], 0.1)), i64.from(PatchFlat), "plane is flat");

  let dome = gridMesh(16usize, 2., (x, z) => -0.5 * (x * x + z * z));
  let cd = curvature(&dome);
  expectFloat(*cd.k1[centre], 1., 0.02, "dome k1");
  expectFloat(*cd.k2[centre], 1., 0.02, "dome k2");
  expectInt(i64.from(classifyPatch(*cd.k1[centre], *cd.k2[centre], 0.1)), i64.from(PatchDome), "dome");

  let bowl = gridMesh(16usize, 2., (x, z) => 0.5 * (x * x + z * z));
  let cb = curvature(&bowl);
  expectFloat(*cb.k1[centre], -1., 0.02, "bowl k1");
  expectFloat(*cb.k2[centre], -1., 0.02, "bowl k2");
  expectInt(i64.from(classifyPatch(*cb.k1[centre], *cb.k2[centre], 0.1)), i64.from(PatchCup), "cup");

  let sad = gridMesh(16usize, 2., (x, z) => 0.5 * (x * x - z * z));
  let csd = curvature(&sad);
  expectFloat(*csd.k1[centre], 1., 0.02, "saddle k1");
  expectFloat(*csd.k2[centre], -1., 0.02, "saddle k2");
  expectFloat(csd.mean(centre), 0., 0.02, "saddle mean curvature");
  expectFloat(csd.gaussian(centre), -1., 0.04, "saddle Gaussian curvature");
  expectInt(i64.from(classifyPatch(*csd.k1[centre], *csd.k2[centre], 0.1)), i64.from(PatchSaddle), "saddle");
  // k1 (convex) runs along z, where y = (x^2 - z^2)/2 falls away on both sides
  expectFloat(absf(csd.dir1[centre].z), 1., 0.02, "saddle k1 direction");

  // The channels
  var m = gridMesh(16usize, 2., (x, z) => 0.5 * (x * x - z * z));
  let eps = 0.1;
  let pc = curvatureChannels(&mut m, &csd, eps);
  expectFloat(m.float(pc, u32.from(centre)), f32.from(PatchSaddle), 0.0001, "patch channel");
  expectInt(i64.from(m.validate().len()), 0, "mesh stays valid with the channels");
  expect(m.findFloatChannel(VertexDomain, "gaussian") != NoIndex, "gaussian channel exists");

  // Smoothing keeps k1 >= k2
  let sm = smoothCurvature(&sad, &csd, 2u32);
  expect(*sm.k1[centre] >= *sm.k2[centre], "smoothed curvature keeps k1 above k2");
  expectStr(patchName(PatchRidge), "ridge", "patch names");
  done();
}
