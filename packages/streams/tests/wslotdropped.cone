// Filling a slot that a truncateTo dropped is a panic that says so.

mod wslotdropped;

import stdio use *;
import streams use *;

fn main() {
  var w = Writer.make(100usize);
  let m = w.mark();
  let s = w.slot[u16]();
  w.truncateTo(m);
  printStr("truncated\n");
  w.fillLE(s, 1u16);
  printStr("not reached\n");
}
