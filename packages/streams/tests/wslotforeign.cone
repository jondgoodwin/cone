// Filling a slot through a writer other than the one that made it is a panic.

mod wslotforeign;

import stdio use *;
import streams use *;

fn main() {
  var a = Writer.make(100usize);
  var b = Writer.make(100usize);
  let s = a.slot[u32]();
  printStr("a slot of a, filled through b\n");
  b.fillLE(s, 1u32);
  printStr("not reached\n");
}
