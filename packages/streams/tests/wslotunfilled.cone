// finish with a slot not filled is a panic at the caller's line.

mod wslotunfilled;

import stdio use *;
import streams use *;

fn main() {
  var w = Writer.make(100usize);
  let s = w.slot[u32]();
  w.put("abc");
  printStr("one slot left unfilled\n");
  _ = w.finish();
  printStr("not reached\n");
}
