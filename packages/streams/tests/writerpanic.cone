// A writer told it wrote more than the room it gave has a bug: 'advance' says
// so with a panic at the caller's line, rather than letting the buffer's length
// pass its capacity. Up to the room is taken.

mod writerpanic;

import stdio use *;
import streams use Writer;

fn main() {
  var w = Writer.make(100usize);
  let room = w.room();
  w.advance(room);
  printStr("the whole room taken, room left: ");
  printUInt(u64.from(w.room()));
  printStr("\n");
  w.advance(1usize);
  printStr("not reached\n");
}
