// Truncating to a mark through a writer other than the one that made it is a panic.

mod wmarkforeign;

import stdio use *;
import streams use *;

fn main() {
  var a = Writer.make(100usize);
  var b = Writer.make(100usize);
  let m = a.mark();
  printStr("a mark of a, used through b\n");
  b.truncateTo(m);
  printStr("not reached\n");
}
