// A lengthPrefixed body whose length does not fit the prefix's number is a panic.

mod wlenoverflow;

import stdio use *;
import streams use *;

fn body300(w: &mut Writer) {
  w.repeat(7u8, 300usize);
}

fn main() {
  var w = Writer.make(100usize);
  printStr("300 bytes in a one-byte prefix\n");
  w.lengthPrefixedBE[u8](&body300);
  printStr("not reached\n");
}
