// A writer from Writer.make still panics when the pool refuses a block, as it
// always did (only tryMake's writers record the refusal): the pool is bounded
// to 8 MiB and the writer asked for more.

mod makepanic;

import stdio use *;
import iobuf use *;
import streams use Writer;

fn main() {
  setLimits(8388608usize, 0usize);
  var w = Writer.make(4096usize);
  w.repeat(1u8, 100000usize);
  printStr("under the limit\n");
  w.repeat(2u8, 40000000usize);
  printStr("not reached\n");
}
