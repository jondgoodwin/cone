// ======== Layer 1, driving a transform to its end: feed, finish, pull ========
//
// The loop a caller writes when it holds all of a transform's input and wants all its output: feed the
// input, say there is no more, and pull into a buffer until the transform answers anything but
// MoreOutput. Written once here for any Transform, so a one-shot helper is its two lines, and the loops that
// also cap the output or feed a piece at a time (a stage between actors, an entry reader) keep their own.
//
//   var out = List[u8]();
//   let st = runAll(&mut inflater, gzBytes, &mut out);       // feed all, finish, pull to the end
//   // st: Done (out holds the whole output), NeedInput (the input ended before the stream did), or Failed
//
//   pullAll(&mut t, &mut out)         pulls what the transform has now into 'out', through one 64 KiB
//                                     buffer that it reuses, until the status is not MoreOutput; answers
//                                     that status (NeedInput: feed more; Done; Failed)
//   runAll(&mut t, input, &mut out)   'feed(input)' in one call, 'finish()', then 'pullAll'
//
// Everything a pull wrote is appended to 'out', also on Failed: what was delivered before the failure is
// good (the Transform's rules). The input is fed in one call; a transform takes any size, split anywhere.

// Pulls 't' until it says anything but MoreOutput, appending what it makes to 'out': the status it ended on
pub fn pullAll[T: Transform](t: &mut T, out: &mut List[u8]) Status {
  var buf = IoBuf(65536usize);
  var st = Status.MoreOutput;
  while st == Status.MoreOutput {
    buf.clear();
    st = t.pull(&mut buf);
    out.appendSlice(buf.view());
  }
  st
}

// Feeds 't' all of 'input', finishes it, and pulls it to the end, appending its output to 'out': the final status
pub fn runAll[T: Transform](t: &mut T, input: &Array[u8], out: &mut List[u8]) Status {
  t.feed(input);
  t.finish();
  pullAll(t, out)
}
