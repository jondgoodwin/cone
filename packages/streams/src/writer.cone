// ======== Layer 2, writing: a Writer over buffers being filled ========
//
// The producing side of a Reader: whoever has bytes to put out asks the writer
// for room, writes into it, and says how many it wrote; or hands it bytes and
// numbers to put, and the writer finds the room. When the buffer is full, or
// the stage is done, the whole buffer is handed on (moved, to the next stage or
// to a send), and the writer starts again on a fresh one.
//
// TWO WAYS TO FILL, one writer. A stage that has a Transform pull into the
// buffer's spare room, or reads straight into it, uses 'spare' and 'advance'.
// Code that builds bytes (a file's header, a datagram, a frame) uses the puts:
// they take everything, and when the buffer in use fills it joins a Chain of
// filled buffers the writer holds and a fresh one goes on. The writer does no
// I/O, takes no lock and calls nothing; the caller takes the filled buffers
// when it likes ('take' or 'popFull' one at a time, 'finish' for all).
//
//   var w = Writer.make(65536usize);        // a 64 KiB buffer, empty
//   let n = fillFrom(w.spare());            // write into the room...
//   w.advance(n);                           // ...and say how much
//   if w.isFull() {send(w.take());}         // the buffer moves on; w holds a new one
//
//   var w = Writer.make(4096usize);
//   w.putBE[u32](0x47475546u32);            // a number, most significant byte first
//   w.putLE[u64](tensorCount);              // least significant first
//   w.putUintBE(frameLen, 3usize);          // an odd width: HTTP/2's 24-bit length
//   w.put(name.view());                     // a slice, all of it, rolling over as needed
//   let count = w.slot[u16]();              // room for a number known only later...
//   w.fillBE(count, n);                     // ...filled when it is
//   w.lengthPrefixedBE[u32](w => {          // or: the length of what the closure writes
//     w.put(body);
//   });
//   let all = w.finish();                   // a Chain: every byte, in order
//
// THE FILL-IN-PLACE CALLS act on the buffer in use:
//
//   w.spare()       the room after the written bytes, '&mut Array[u8]', to fill
//   w.advance(n)    n bytes of the room are written (a panic past the room)
//   w.room()  w.isFull()  w.isEmpty()  w.view()  w.buffer()
//   w.len()         the bytes held: those in the buffers held and in use
//
// THE PUTS take everything (a panic, at the caller's line, only if the pool
// has no buffer to give):
//
//   w.put(bytes)         copy it all in; a new buffer whenever the current one fills
//   w.putSome(bytes)     copy in as many as fit in the buffer in use: how many
//   w.putByte(b)  w.repeat(b, n)  w.pad(align)    (pad: zeros up to a multiple of align of total())
//   w.putLE(v)  w.putBE(v)     v a number of a fixed width (u8 to u64, i8 to i64, f32, f64; not usize);
//                        the order is in the name. A number that does not fit the room
//                        left in the buffer starts a new one, so it is never split
//   w.putUintLE(v, n)  w.putUintBE(v, n)    the low n bytes (1 to 8) of a u64; a panic if v needs more
//   w.putFrom(r, n)      n bytes of a Reader, consumed; whole front segments that lie within n move
//                        as they are when the buffer in use is empty, the rest is copied
//   w.total()            the bytes written since the writer was made, whatever has been taken
//
// TAKING:
//
//   w.take()        the oldest buffer held; or, when none is held, the buffer in use, written
//                   bytes and all, moved out, and a fresh one of the same size takes its place
//   w.popFull()     the oldest buffer held, or the buffer in use when it is full, or None: never
//                   a buffer that holds an unfilled slot or follows one
//   w.finish()      every byte held, the buffer in use included, as a Chain, in order; a panic, at
//                   the caller's line, if a slot is unfilled
//   w.intoBuf()     the buffer in use moved out; the writer is spent (holds none). For a writer
//                   that has held nothing
//
// SLOTS, for a number known only later (a count, a checksum):
//
//   w.slot[T]()     reserves size(T) bytes, never split, and gives a Slot[T]
//   w.fillLE(s, v)  w.fillBE(s, v)    write it: a panic for a slot of another writer or one filled twice
//   w.lengthPrefixedLE[T](f)  w.lengthPrefixedBE[T](f)    a slot, f(w), and the slot filled with the
//                   bytes f wrote; a panic if they do not fit T
//
// A slot holds its buffer: while one is unfilled, 'take' and 'popFull' give no buffer from its buffer
// on, so the bytes stay where the fill can reach them and nothing is copied.
//
// A WRITER THAT CANNOT PANIC, for the buffers a peer's bytes cause (a server
// building a response while a flood may have used the pool up):
//
//   var w = Writer.tryMake(4096usize)   // None if even the first block is refused
//   ...puts, slots, lengthPrefixed, putBuf, as above...
//   if w.starved() {...}                // asked at any time, or once at the end
//   match w.tryFinish() {               // Some(chain), or None when starved
//
// Its blocks come from IoBuf.tryMake. On the first refusal the writer records
// it and stays so: every later put, slot, fill and lengthPrefixed is dropped (a
// slot after it is a dummy, and filling it, or a slot left open, is no panic).
// The flag is set only where a block is asked for, at a rollover; the buffer in
// use becomes one with no room, so a put that fits costs what it always did and
// a put after the refusal fails its room check and lands in the same place.
// A starved writer drops what it holds; send only what you popped before it
// starved: what is held may end mid-put or mid-frame, so 'popFull' and 'take'
// give nothing once starved. 'tryFinish' gives None and every byte held goes
// back to the pool. 'finish' on a
// starved writer is a panic (a program that asks for Option uses tryFinish).
// 'Writer.tryEmpty(size)' is the same without a first block, asked for at the
// first put, for a writer built where it cannot fail (a struct's field).
// 'putBuf(buf)' moves a filled buffer in whole, no copy: the buffer in use if
// it holds bytes, then buf, then a fresh buffer in use (fallible there).
// A writer from 'make' or 'over' is as it was: a refused block is a panic.
//
// WHY THE BYTES ARE SAFE. The stores are IoBuf's (putNum, putUint, setNum and
// Chain.setNum): each is one check of the room and one store of the number's
// bytes, never a pointer that leaves iobuf. The numbers are the fixed-width
// ones (u8 to u64, i8 to i64, f32, f64); usize and isize are refused, as their
// width is the machine's and a format written with them is not portable.
// Machines are little-endian.
//
// Like Reader this lives inside one stage: it does no I/O, takes no lock and
// never waits. The buffers are IoBufs from the buffer pool, so 'take' hands a
// stage's output on without a copy and a dropped writer returns its blocks.

// The serial of a slot reserved after the pool refused: it is never filled
const noSlot = 0xFFFFFFFFFFFFFFFFusize;

// Which writer a slot came from: never 0
let nextWriterId: Atomic[u64];

fn @initpure init() {
  nextWriterId = Atomic[u64].of(0u64);
}

// The room a slot reserved, where it is, and whether it has been filled
struct SlotRec {
  ord: usize;        // the ordinal of the buffer that holds it
  at: usize;         // its offset in that buffer
  filled: bool;
}

// Room reserved for a number in a Writer, to be filled later
pub struct Slot[T] {
  writer: u64;       // the writer that made it
  serial: usize;     // its place in that writer's slots, counting from the writer's start
}

// A buffer being filled, the filled ones it holds, and its size, for the next after 'take'
pub struct Writer is Move {
  buf: IoBuf;               // the buffer in use
  chain: Chain;             // the filled buffers held, oldest first; the buffer in use follows them
  size: usize;              // the room a fresh buffer is made with
  first: usize;             // the ordinal of the chain's oldest buffer (the buffer in use is first + the chain's segments)
  popped: usize;            // the bytes handed out of the writer so far
  wid: u64;               // this writer's id
  recs: List[SlotRec];      // the slots since the last time none was open
  base: usize;              // the serial of recs[0]
  open: usize;              // slots not yet filled
  fallible: bool;           // blocks come from IoBuf.tryMake: a refusal is recorded, not a panic
  refused: bool;            // the pool refused a block (fallible only): every put since is dropped

  // A writer over a fresh buffer with room for at least size bytes
  pub fn make(size: usize) Writer {
    Writer.over2(IoBuf(size), size, false)
  }

  // A writer whose blocks all come from IoBuf.tryMake, the first included:
  // None when the pool refuses that one. When the pool later refuses a block
  // the writer records it (see 'starved'), drops every put after, and
  // never panics for it. For the buffers a peer's bytes cause
  pub fn tryMake(size: usize) Option[Writer] {
    match IoBuf.tryMake(size) {
      case var Some(b) {Some[Writer](Writer.over2(b, size, true))}
      else {None[Writer]}
    }
  }

  // A fallible writer that holds no block yet (the pool is asked at the
  // first put, with blocks of at least size after): for a writer made
  // where it cannot fail, as a struct's own. Starved if that first ask is refused
  pub fn tryEmpty(size: usize) Writer {
    Writer.over2(IoBuf(), size, true)
  }

  // Whether the pool refused a block (a writer from tryMake): what was put
  // since is not all there. Set where a block is asked for, so a put that
  // fits the room never looks at it
  pub fn starved(self: &) bool {refused}

  // A writer over a buffer a caller has started (its written bytes stay); a
  // fresh buffer is as large as this one's capacity
  pub fn over(buf: IoBuf) Writer {
    let size = buf.capacity();
    Writer.over2(buf, size, false)
  }

  fn over2(buf: IoBuf, size: usize, fallible: bool) Writer {
    Writer(buf, Chain.make(0xFFFFFFFFFFFFFFFFusize), size, 0usize, 0usize,
      nextWriterId.add(1u64) + 1u64, List[SlotRec](), 0usize, 0usize, fallible, false)
  }

  // ---- The buffer in use ----

  // The room after the written bytes, to fill
  pub fn spare(self: &mut) &mut Array[u8] {buf.spare()}

  // Say that n bytes of the room are now written: a panic, at the caller's
  // line, past the room
  pub fn advance(self: &mut, n: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if n > buf.room() {panic("streams: Writer.advance past the room", file, line);}
    buf.setLen(buf.len() + n);
  }

  // Copy in as many of bytes as fit in the buffer in use: how many
  pub fn putSome(self: &mut, bytes: &Array[u8]) usize {buf.append(bytes)}

  // A filled buffer of the caller's moved into the stream whole, never copied
  // (not even a small one: it is a segment of its own, as a DATA frame's body
  // is). The buffer in use, if it holds bytes, is held first, then b, then a
  // fresh buffer goes on (fallible: the pool may refuse it, and the writer is
  // starved, b already held). A buffer in use that holds nothing stays in
  // use after b. An empty b is dropped. A starved writer drops b
  pub fn putBuf(self: &mut, b: IoBuf, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if refused || b.len() == 0usize {return;}
    if buf.len() == 0usize {
      _ = chain.push(b);
      return;
    }
    var last = IoBuf();
    last <-> buf;
    _ = chain.push(last);
    _ = chain.push(b);
    match self.fresh(size, file, line) {
      case var Some(f) {buf = f;}
      else {self.starve();}
    }
  }

  // How many bytes are held (in the buffers held and the one in use), and how
  // many more fit in the buffer in use
  pub fn len(self: &) usize {chain.len() + buf.len()}
  pub fn room(self: &) usize {buf.room()}
  pub fn isEmpty(self: &) bool {chain.isEmpty() && buf.isEmpty()}
  pub fn isFull(self: &) bool {buf.room() == 0usize}

  // The bytes written to the buffer in use
  pub fn view(self: &) &Array[u8] {buf.view()}

  // The buffer in use itself, for a Transform's 'pull' to write into: it fills
  // the spare room and sets the length, as 'spare' and 'advance' do
  pub fn buffer(self: &mut) &mut IoBuf {&mut buf}

  // The bytes written since the writer was made, whatever has been taken
  pub fn total(self: &) usize {popped + chain.len() + buf.len()}

  // ---- Taking ----

  // The oldest buffer held, with its bytes, moved out; when none is held, the
  // buffer in use with its written bytes, moved out and a fresh empty one of
  // the same size in its place. A buffer that holds an unfilled slot, or
  // follows one, is not given: a panic. A pool that has no more to give panics,
  // as 'IoBuf(size)' does
  pub fn take(self: &mut, file: &Array[u8] = srcFile(), line: u32 = srcLine()) IoBuf {
    if refused {return IoBuf();}
    if chain.segments() > 0usize {
      match self.popHeld() {
        case let Some(b) {return b;}
        case is None[IoBuf] {panic("streams: Writer.take with a slot not filled", file, line);}
      }
    }
    if open != 0usize && !refused {panic("streams: Writer.take with a slot not filled", file, line);}
    var out = IoBuf();
    out <-> buf;
    popped = popped + out.len();
    if !refused {
      match self.fresh(size, file, line) {
        case var Some(f) {buf = f;}
        else {refused = true;}
      }
    }
    out
  }

  // The buffer with its written bytes, moved out, and none left in the
  // writer: for the last hand-over of a stage that has held nothing
  pub fn intoBuf(self: &mut) IoBuf {
    var out = IoBuf();
    out <-> buf;
    popped = popped + out.len();
    out
  }

  // The oldest buffer held, unless it holds or follows an unfilled slot
  fn popHeld(self: &mut) Option[IoBuf] {
    match self.oldestOpen() {
      case let Some(ord) {if first >= ord {return None[IoBuf];}}
      case is None[usize] {}
    }
    match chain.popFront() {
      case var Some(held) {
        first = first + 1usize;
        popped = popped + held.len();
        Some[IoBuf](held)
      }
      case is None[IoBuf] {None[IoBuf]}
    }
  }

  // The ordinal of the oldest buffer that holds an unfilled slot, or None
  fn oldestOpen(self: &) Option[usize] {
    if open == 0usize {return None[usize];}
    var i = 0usize;
    while i < recs.len() {
      if !recs[i].filled {return Some[usize](recs[i].ord);}
      i = i + 1usize;
    }
    None[usize]
  }

  // The oldest filled buffer, or None: a buffer held, or the buffer in use
  // when it is full; never one that holds an unfilled slot or follows one
  pub fn popFull(self: &mut) Option[IoBuf] {
    if refused {return None[IoBuf];}
    if chain.segments() == 0usize {
      if buf.room() != 0usize || buf.len() == 0usize {return None[IoBuf];}
      _ = self.rollFor(1usize);
    }
    self.popHeld()
  }

  // Every byte held, in order, as a Chain, the buffer in use included: a
  // panic, at the caller's line, if a slot is unfilled. The writer holds
  // nothing after, and can go on being put to
  pub fn finish(self: &mut, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Chain {
    if refused {panic("streams: Writer.finish on a starved writer (a writer from tryMake ends with tryFinish)", file, line);}
    if open != 0usize {panic("streams: Writer.finish with a slot not filled", file, line);}
    if buf.len() != 0usize {
      var last = IoBuf();
      last <-> buf;
      _ = chain.push(last);
    }
    var all = Chain.make(0xFFFFFFFFFFFFFFFFusize);
    all <-> chain;
    popped = popped + all.len();
    first = 0usize;
    recs.clear();
    base = 0usize;
    all
  }

  // As finish for a writer from tryMake: None when the pool refused a block,
  // and then every byte held goes back to the pool. Not starved, it is
  // finish, a panic over an unfilled slot included
  pub fn tryFinish(self: &mut, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Option[Chain] {
    if !refused {return Some[Chain](self.finish(file, line));}
    var all = Chain.make(0xFFFFFFFFFFFFFFFFusize);
    all <-> chain;
    popped = popped + all.len();
    buf = IoBuf();
    first = 0usize;
    recs.clear();
    base = 0usize;
    open = 0usize;
    None[Chain]
  }

  // ---- Rolling ----

  // A block of at least n bytes: IoBuf(n), or for a fallible writer IoBuf.tryMake
  fn fresh(self: &, n: usize, file: &Array[u8], line: u32) Option[IoBuf] {
    if fallible {return IoBuf.tryMake(n);}
    Some[IoBuf](IoBuf(n, file, line))
  }

  // The pool refused: what the buffer in use holds goes to the chain, where
  // 'popFull' can still reach it, and the buffer in use is one with no room,
  // so every put fails its room check and comes here
  fn starve(self: &mut) {
    refused = true;
    if buf.len() != 0usize {
      var last = IoBuf();
      last <-> buf;
      _ = chain.push(last);
    } else {
      buf = IoBuf();
    }
  }

  // The buffer in use goes to the chain and a fresh one goes on, with room for
  // at least n bytes. False when the pool refused (fallible only) or did before
  fn rollFor(self: &mut, n: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) bool {
    if refused {return false;}
    if n > buf.capacity() && buf.len() == 0usize {
      match self.fresh(n, file, line) {
        case var Some(b) {buf = b;}
        else {
          self.starve();
          return false;
        }
      }
      return true;
    }
    match self.fresh(if n > size {n} else {size}, file, line) {
      case var Some(f) {
        f <-> buf;
        _ = chain.push(f);
        true
      }
      else {
        self.starve();
        false
      }
    }
  }

  // ---- Putting ----

  // All of bytes, a new buffer whenever the current one fills
  pub fn put(self: &mut, bytes: &Array[u8]) {
    var at = buf.append(bytes);
    while at < bytes.len {
      if !self.rollFor(1usize) {return;}
      at = at + buf.append(&bytes[at ..< bytes.len]);
    }
  }

  pub fn putByte(self: &mut, b: u8) {
    if !buf.putNum[u8](b, false) {
      if self.rollFor(1usize) {_ = buf.putNum[u8](b, false);}
    }
  }

  // n bytes of value b
  pub fn repeat(self: &mut, b: u8, n: usize) {
    var left = n;
    while left > 0usize {
      let k = buf.putRepeat(b, left);
      left = left - k;
      if left > 0usize && !self.rollFor(1usize) {return;}
    }
  }

  // Zeros up to the next multiple of align of 'total()' (none if already there)
  pub fn pad(self: &mut, align: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if align == 0usize {panic("streams: Writer.pad to an alignment of 0", file, line);}
    let rem = self.total() % align;
    if rem != 0usize {self.repeat(0u8, align - rem);}
  }

  // A number, its least significant byte first
  pub fn putLE[T](self: &mut, v: T) inline where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 || T is f32 || T is f64 {
    if !buf.putNum[T](v, false) {
      if self.rollFor(mem.sizeof[T]()) {_ = buf.putNum[T](v, false);}
    }
  }

  // A number, its most significant byte first
  pub fn putBE[T](self: &mut, v: T) inline where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 || T is f32 || T is f64 {
    if !buf.putNum[T](v, true) {
      if self.rollFor(mem.sizeof[T]()) {_ = buf.putNum[T](v, true);}
    }
  }

  // The low nbytes (1 to 8) of v, least significant first: a panic, at the
  // caller's line, if v does not fit them
  pub fn putUintLE(self: &mut, v: u64, nbytes: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    self.putUint(v, nbytes, false, file, line);
  }

  // The low nbytes (1 to 8) of v, most significant first: a panic if v does not fit them
  pub fn putUintBE(self: &mut, v: u64, nbytes: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    self.putUint(v, nbytes, true, file, line);
  }

  fn putUint(self: &mut, v: u64, nbytes: usize, big: bool, file: &Array[u8], line: u32) {
    if nbytes == 0usize || nbytes > 8usize {panic("streams: Writer.putUint takes 1 to 8 bytes", file, line);}
    if nbytes < 8usize && (v >> u64.from(8usize * nbytes)) != 0u64 {
      panic("streams: Writer.putUint: the value needs more bytes than asked", file, line);
    }
    if !buf.putUint(v, nbytes, big, file, line) {
      if self.rollFor(nbytes, file, line) {_ = buf.putUint(v, nbytes, big, file, line);}
    }
  }

  // ---- Slots ----

  // Room for a number, to be filled later: contiguous, so the fill is one store
  pub fn slot[T](self: &mut) Slot[T] where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 || T is f32 || T is f64 {
    let n = mem.sizeof[T]();
    if buf.room() < n && !self.rollFor(n) {return Slot[T](wid, noSlot);}
    let at = buf.len();
    _ = buf.putRepeat(0u8, n);
    recs.push(SlotRec(first + chain.segments(), at, false));
    open = open + 1usize;
    Slot[T](wid, base + recs.len() - 1usize)
  }

  // Fill a slot, the number's least significant byte first
  pub fn fillLE[T](self: &mut, s: Slot[T], v: T, file: &Array[u8] = srcFile(), line: u32 = srcLine()) where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 || T is f32 || T is f64 {
    self.fill[T](s, v, false, file, line);
  }

  // Fill a slot, the number's most significant byte first
  pub fn fillBE[T](self: &mut, s: Slot[T], v: T, file: &Array[u8] = srcFile(), line: u32 = srcLine()) where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 || T is f32 || T is f64 {
    self.fill[T](s, v, true, file, line);
  }

  fn fill[T](self: &mut, s: Slot[T], v: T, big: bool, file: &Array[u8], line: u32) where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 || T is f32 || T is f64 {
    if s.writer != wid {panic("streams: Writer.fill with a slot of another writer", file, line);}
    if refused {return;}
    if s.serial < base || s.serial - base >= recs.len() || recs[s.serial - base].filled {
      panic("streams: Writer.fill with a slot already filled", file, line);
    }
    let r = &mut recs[s.serial - base];
    let curOrd = first + chain.segments();
    let done = if r.ord == curOrd {buf.setNum[T](r.at, v, big)} else {chain.setNum[T](r.ord - first, r.at, v, big)};
    if !done {panic("streams: Writer.fill: the slot's bytes are gone", file, line);}
    r.filled = true;
    open = open - 1usize;
    if open == 0usize {
      base = base + recs.len();
      recs.clear();
    }
  }

  // ---- The scoped form ----

  // A slot for a T, f(w), and the slot filled with the number of bytes f
  // wrote, least significant first: a panic, at the caller's line, if they
  // do not fit a T
  pub fn lengthPrefixedLE[T](self: &mut, f: &fn(w: &mut Writer), file: &Array[u8] = srcFile(), line: u32 = srcLine()) where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 {
    self.lengthPrefixed[T](f, false, file, line);
  }

  // As lengthPrefixedLE, most significant first
  pub fn lengthPrefixedBE[T](self: &mut, f: &fn(w: &mut Writer), file: &Array[u8] = srcFile(), line: u32 = srcLine()) where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 {
    self.lengthPrefixed[T](f, true, file, line);
  }

  fn lengthPrefixed[T](self: &mut, f: &fn(w: &mut Writer), big: bool, file: &Array[u8], line: u32) where T is u8 || T is u16 || T is u32 || T is u64 || T is i8 || T is i16 || T is i32 || T is i64 {
    let s = self.slot[T]();
    let start = self.total();
    f(self);
    if refused {return;}
    let n = self.total() - start;
    match T.tryFrom(n) {
      case let Ok(t) {self.fill[T](s, t, big, file, line);}
      case let Err(e) {panic("streams: Writer.lengthPrefixed: the length does not fit its number", file, line);}
    }
  }

  // ---- From a Reader ----

  // n bytes from the front of r, consumed. Whole front segments that lie
  // within n move as they are when the buffer in use is empty; the rest is
  // copied. A panic, at the caller's line, if r holds fewer than n
  pub fn putFrom(self: &mut, r: &mut Reader, n: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    if n > r.len() {panic("streams: Writer.putFrom more than the reader holds", file, line);}
    var left = n;
    while left > 0usize {
      if refused {
        r.consume(left);
        return;
      }
      let seg = r.contiguousLen();
      if buf.len() == 0usize && seg <= left {
        match r.popFront() {
          case let Some(b) {
            left = left - b.len();
            _ = chain.push(b);
          }
          case is None[IoBuf] {panic("streams: Writer.putFrom: the reader ran dry", file, line);}
        }
      } else {
        let want = if seg < left {seg} else {left};
        match r.peek(want) {
          case let Some(v) {self.put(v);}
          case is None[&Array[u8]] {panic("streams: Writer.putFrom: the reader ran dry", file, line);}
        }
        r.consume(want);
        left = left - want;
      }
    }
  }
}
