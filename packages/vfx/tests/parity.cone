// The vfx package's particle evaluation against its Slang twin, vfx.slang,
// on a real GPU.
//
// parity.slang draws a 16 x 256 rgba8unorm target, each pixel one quantity
// of a particle's state (its column) for one (spawn index, age) (its row),
// its 32 bits one byte per channel, so the readback holds the GPU's exact
// bits; the emitter comes from a uniform buffer written from
// EmitterParams.words, so the packing is checked too. This program computes
// the same table with particleAt and compares, for three emitters: a flame
// (a disc, drag, buoyancy, a wobble, fades, every jitter, a turned and moved
// placement), sparks (a sphere, gravity alone, no drag: the series forms)
// and a fountain (a point, a wide cone, buoyancy that never cools, four
// colour keys).
//
// - Exact: whether the particle is alive, and the spawn arithmetic (which
//   rows are born and dead agree bit for bit).
// - Within a tolerance relative to the size of the value (at least 1): the
//   rest, which go through exp, sin, cos, square roots and divisions, none
//   of which Vulkan rounds correctly. The bounds are the differences
//   measured on the RTX 4060 and the UHD 770 with a margin, not Vulkan's,
//   so that a change to the order of operations on one side shows.
//
// Only a failure prints. With VFX_PARITY_REPORT set, it also prints the
// adapter and, for each emitter and quantity, how many of the 256 agree bit
// for bit and the largest relative difference. GPU_POWER_PREFERENCE=low-power
// tests the integrated GPU where there are two.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll (which loads Vulkan);
// no window, no display of its own, and no Vulkan SDK (with it, validation
// and synchronization validation are on, and must say nothing).

mod parity;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import collections use *;
import gpu use *;
import vfx use *;

const WIDTH = 16u32;
const HEIGHT = 256u32;
const QUANTITIES = 15u32;

fn bits(f f32) u32 { f as u32; }
fn fromBits(b u32) f32 { b as f32; }

// Row 'a': its spawn index and its age (parity.slang's)
fn sampleIndex(a u32) u32 { a * 37u32 + (a % 3u32) * 1000000u32; }
fn sampleAge(a u32) f32 { f32.from(a % 16u32) * 0.0625 - 0.0625; }

// Quantity 'q' of row 'a' (parity.slang's 'quantity')
fn quantity(e &EmitterParams, q u32, a u32) f32 {
  if q >= 13u32 {
    imm now = particleNow(e, sampleIndex(a));
    return if q == 13u32 { now.position.x; } else { now.color.w; };
  }
  imm p = particleAt(e, sampleIndex(a), sampleAge(a));
  if q == 0u32 { return p.position.x; }
  if q == 1u32 { return p.position.y; }
  if q == 2u32 { return p.position.z; }
  if q == 3u32 { return p.velocity.x; }
  if q == 4u32 { return p.velocity.y; }
  if q == 5u32 { return p.velocity.z; }
  if q == 6u32 { return p.size; }
  if q == 7u32 { return p.color.x; }
  if q == 8u32 { return p.color.y; }
  if q == 9u32 { return p.color.z; }
  if q == 10u32 { return p.color.w; }
  if q == 11u32 { return p.life; }
  if p.alive { 1.; } else { 0.; };
}

// How far quantity 'q' may differ, relative to max(1, |value|). 0: bit for bit
fn tolerance(q u32) f64 {
  if q == 12u32 { return 0d; }
  // Position and velocity: through the launch angles' sin and cos (Vulkan
  // allows them an absolute 2^-11 in (-pi, pi)), exp, square roots and
  // divisions. Measured at most 5.6e-6 on the RTX 4060 and 8.5e-5 on the
  // UHD 770 (the horizontal axes, by its sin and cos); within 2^-12
  if q <= 5u32 or q == 13u32 { return 0.000244140625d; }
  // Size, colour, life: products and one division of the age by the
  // lifetime. Measured at most 3.6e-7 on both; within 2^-19
  0.0000019073486328125d;
}

fn emitters(which u32) EmitterParams {
  mut e = Emitter.make();
  if which == 0u32 {
    e.rate = 400.;
    e.lifetime = 0.6;
    e.lifetimeJitter = 0.3;
    e.shape = SHAPE_DISC;
    e.radius = 0.08;
    e.spread = radians(12.);
    e.speed = 5.;
    e.speedJitter = 0.25;
    e.drag = 2.;
    e.gravity = new Vec3(0., -9.81, 0.);
    e.buoyancy = 25.;
    e.cooling = 4.;
    e.wobble = 0.2;
    e.wobbleRate = 9.;
    e.sizeJitter = 0.3;
    e.fadeIn = 0.1;
    e.colors = [new Color(1.5, 1.6, 2., 6.), new Color(1., 0.7, 0.25, 4.), new Color(1., 0.3, 0.05, 2.),
      new Color(0.5, 0.1, 0.02, 0.)];
    e.colorAt = [0., 0.15, 0.5, 1.];
    imm place = Mat4.fromTrs(new Vec3(1.5, -2., 0.25), Quat.angleAxis(0.4, new Vec3(0.6, 0., 0.8)), new Vec3(1., 1., 1.));
    imm event = Event.at(1783u32, 10d, place);
    return EmitterParams.bind(&e, &event, 10.4375d);
  }
  if which == 1u32 {
    e.rate = 1000.;
    e.lifetime = 1.5;
    e.lifetimeJitter = 0.5;
    e.shape = SHAPE_SPHERE;
    e.radius = 0.25;
    e.spread = radians(180.);
    e.speed = 12.;
    e.gravity = new Vec3(0., -9.81, 0.);
    e.cooling = 0.;
    e.fadeOut = 0.25;
    imm event = Event.at(42u32, 0d, Mat4.fromTranslation(new Vec3(0., 30., -5.)));
    return EmitterParams.bind(&e, &event, 0.75d);
  }
  e.rate = 50.;
  e.lifetime = 3.;
  e.spread = radians(90.);
  e.speed = 3.;
  e.speedJitter = 0.5;
  e.drag = 0.5;
  e.buoyancy = 4.;
  e.cooling = 0.;
  e.sizeStart = 0.05;
  e.sizeEnd = 0.4;
  e.colors = [new Color(0.2, 0.4, 1., 3.), new Color(0.6, 0.2, 1., 2.), new Color(1., 1., 1., 1.), new Color(0., 0., 0., 0.)];
  e.colorAt = [0.1, 0.3, 0.6, 0.9];
  imm event = Event.at(7u32, 2d, Mat4.identity());
  EmitterParams.bind(&e, &event, 3.5d);
}

fn main() i32 {
  mut instance = Instance.create("vfx parity");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize {
    if libc.strcmp(env, &"low-power" as *u8) == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  imm report = (libc.getenv(&"VFX_PARITY_REPORT" as *u8) as usize) != 0usize;
  mut adapter = instance.requestAdapter(&none, preference);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");

  imm target = new TextureDescriptor(WIDTH, HEIGHT, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut color = device.createTexture(&target);
  require(color.isValid(), "a 16 x 256 target");
  mut readback = device.createBuffer(u64.from(WIDTH * HEIGHT * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm p = readback.mappedRange();

  mut shader = device.createShaderModule(&PARITY_SPIRV);
  imm entries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT)];
  mut groupLayout = device.createBindGroupLayout(&entries);
  imm groupLayouts = [&groupLayout];
  mut layout = device.createPipelineLayout(&groupLayouts, 0u32);
  imm noBuffers = List[VertexBufferLayout].empty();
  imm desc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, buffers: noBuffers.view(),
    fragmentModule: &shader, colorFormat: TEXTURE_FORMAT_RGBA8_UNORM);
  mut pipeline = device.createRenderPipeline(&desc);
  require(pipeline.isValid(), "the parity pipeline");
  mut uniforms = device.createBuffer(272u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
  imm groupEntries = [BindGroupEntry.buffer(0u32, &uniforms)];
  mut group = device.createBindGroup(&groupLayout, &groupEntries);

  if report {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr("\nemitter quantity  exact/256  max relative diff  tolerance\n");
  }
  mut which = 0u32;
  while which < 3u32 {
    imm e = emitters(which);
    imm words = e.words();
    device.queue.writeBuffer(&uniforms, 0u64, &words as *u8, 272u64);
    {
      mut encoder = device.createCommandEncoder();
      imm attachment = new RenderPassColorAttachment(view: color.createView(), clearValue: new Color(0., 0., 0., 0.));
      mut pass = encoder.beginRenderPass(&attachment);
      pass.setPipeline(&pipeline);
      pass.setBindGroup(0u32, &group);
      pass.draw(3u32, 1u32, 0u32, 0u32);
      pass.end();
      encoder.copyTextureToBuffer(&color, &readback);
      device.queue.submit(encoder.finish());
      device.endFrame();
      device.waitIdle();
    }
    mut alive = 0u32;
    mut q = 0u32;
    while q < QUANTITIES {
      mut exact = 0u32;
      mut maxDiff = 0d;
      mut a = 0u32;
      while a < HEIGHT {
        imm at = p + usize.from((a * WIDTH + q) * 4u32);
        imm gpuBits = u32.from(*at) | (u32.from(*(at + 1usize)) << 8u32) | (u32.from(*(at + 2usize)) << 16u32)
          | (u32.from(*(at + 3usize)) << 24u32);
        imm cpu = quantity(&e, q, a);
        if q == 12u32 and cpu == 1. { alive = alive + 1u32; }
        if gpuBits == bits(cpu) {
          exact = exact + 1u32;
        } else {
          imm d = f64.from(fromBits(gpuBits)) - f64.from(cpu);
          mut scale = f64.from(libc.fabsf(cpu));
          if scale < 1d { scale = 1d; }
          mut ad = if d < 0d { -d; } else { d; };
          ad = ad / scale;
          if ad > maxDiff or ad != ad { maxDiff = ad; }
        }
        a = a + 1u32;
      }
      if report {
        printUInt(u64.from(which));
        printStr("  ");
        printUInt(u64.from(q));
        printStr("  ");
        printUInt(u64.from(exact));
        printStr("  ");
        printFloat(maxDiff);
        printStr("  ");
        printFloat(tolerance(q));
        printStr("\n");
      }
      imm ok = if tolerance(q) == 0d { exact == HEIGHT; } else { maxDiff <= tolerance(q); };
      if !ok {
        printStr("emitter ");
        printUInt(u64.from(which));
        printStr(", quantity ");
        printUInt(u64.from(q));
        printStr(": ");
      }
      if tolerance(q) == 0d {
        expectUInt(u64.from(exact), u64.from(HEIGHT), "every sample bit for bit");
      } else {
        expectFloat(maxDiff, 0d, tolerance(q), "within the tolerance");
      }
      q = q + 1u32;
    }
    // The rows test living particles, not only dead ones
    if report { printStr("alive: "); printUInt(u64.from(alive)); printStr("\n"); }
    expect(alive > 64u32, "a quarter of the rows alive at least");
    which = which + 1u32;
  }

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}

