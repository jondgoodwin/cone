// ======== ParticleRenderer: emitters drawn on the GPU ========
//
// Each emitter added gets a uniform buffer of its parameters (an
// EmitterParams, written by 'update') and a bind group; drawing it is one
// draw of 'count' instances and no vertex buffer, each instance a particle
// that its vertex shader evaluates (sprites.slang). Blending is additive
// (ONE, ONE): light added, in any order, so nothing is sorted. (STYLE_SMOKE is
// the exception: premultiplied alpha, ONE, ONE_MINUS_SRC_ALPHA, also unsorted,
// which suits soft puffs of one colour.) The pass loads
// the frame and the depth the scene left (render's 'keepDepth'), tests
// against that depth and writes none.

// How an emitter's particles are drawn
pub const STYLE_SPRITES = 0u32;    // glowing sprites, stretched along their motion
pub const STYLE_TRAILS = 1u32;     // ribbon trails, each particle's own path
pub const STYLE_SMOKE = 2u32;      // soft round puffs drawn OVER what is behind them (alpha blended, not
                                   // added): a colour key's alpha is its opacity, 0 to 1

const FRAME_BYTES = 96u64;
const EMITTER_BYTES = 272u64;
const TRAIL_SEGMENTS = 8u32;       // sprites.slang's

// Names one emitter of a ParticleRenderer
pub struct EmitterHandle {
  pub index u32;
}

struct EmitterSlot {
  uniforms Buffer;
  group BindGroup;
  style u32;
  count u32;                       // particles drawn, as of the last update
}

pub struct ParticleRenderer {
  pub shader ShaderModule;
  pub frameLayout BindGroupLayout;
  pub emitterLayout BindGroupLayout;
  pub layout PipelineLayout;
  pub spritePipeline RenderPipeline;
  pub trailPipeline RenderPipeline;
  pub smokePipeline RenderPipeline;
  pub frameUniforms Buffer;
  pub frameGroup BindGroup;
  slots List[EmitterSlot];
  pub drawCalls u32;               // how many draws the last render made
  pub particles u64;               // and how many particles they drew (living or not)

  // A renderer of particles into targets of 'colorFormat' (render's HDR
  // frame, TEXTURE_FORMAT_RGBA16_FLOAT) tested against a depth texture of
  // 'depthFormat'. Check 'isValid'.
  pub fn create(device &mut Device, colorFormat u32, depthFormat u32) ParticleRenderer {
    var shader = device.createShaderModule(&SPRITES_SPIRV);
    let frameEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX)];
    var frameLayout = device.createBindGroupLayout(&frameEntries);
    let emitterEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX)];
    var emitterLayout = device.createBindGroupLayout(&emitterEntries);
    let groupLayouts = [&frameLayout, &emitterLayout];
    var layout = device.createPipelineLayout(&groupLayouts, 0u32);
    let noBuffers = List[VertexBufferLayout].empty();
    let spriteDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader,
      vertexEntryPoint: "spriteVertex", buffers: noBuffers.view(), fragmentModule: &shader,
      fragmentEntryPoint: "glowFragment", colorFormat: colorFormat, depthFormat: depthFormat,
      depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS_EQUAL, blendEnabled: true,
      colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE,
      alphaSrcFactor: BLEND_FACTOR_ZERO, alphaDstFactor: BLEND_FACTOR_ONE);
    var spritePipeline = device.createRenderPipeline(&spriteDesc);
    let trailDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader,
      vertexEntryPoint: "trailVertex", buffers: noBuffers.view(), fragmentModule: &shader,
      fragmentEntryPoint: "glowFragment", colorFormat: colorFormat, depthFormat: depthFormat,
      depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS_EQUAL, blendEnabled: true,
      colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE,
      alphaSrcFactor: BLEND_FACTOR_ZERO, alphaDstFactor: BLEND_FACTOR_ONE);
    var trailPipeline = device.createRenderPipeline(&trailDesc);
    let smokeDesc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader,
      vertexEntryPoint: "smokeVertex", buffers: noBuffers.view(), fragmentModule: &shader,
      fragmentEntryPoint: "smokeFragment", colorFormat: colorFormat, depthFormat: depthFormat,
      depthWriteEnabled: false, depthCompare: COMPARE_FUNCTION_LESS_EQUAL, blendEnabled: true,
      colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var smokePipeline = device.createRenderPipeline(&smokeDesc);
    var frameUniforms = device.createBuffer(FRAME_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    let frameGroupEntries = [BindGroupEntry.buffer(0u32, &frameUniforms)];
    var frameGroup = device.createBindGroup(&frameLayout, &frameGroupEntries);
    new ParticleRenderer(shader, frameLayout, emitterLayout, layout, spritePipeline, trailPipeline, smokePipeline, frameUniforms,
      frameGroup, List[EmitterSlot].empty(), 0u32, 0u64)
  }

  // Whether everything it draws with was made
  pub fn isValid(self &) bool {
    spritePipeline.isValid() and trailPipeline.isValid() and smokePipeline.isValid() and frameGroup.isValid() and frameUniforms.isValid()
  }

  // An emitter to draw in 'style' (STYLE_...); it draws nothing until
  // 'update' binds it to an event
  pub fn addEmitter(self &mut, device &mut Device, style u32) EmitterHandle {
    var uniforms = device.createBuffer(EMITTER_BYTES, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    let entries = [BindGroupEntry.buffer(0u32, &uniforms)];
    var group = device.createBindGroup(&emitterLayout, &entries);
    let index = u32.from(slots.len());
    slots.push(new EmitterSlot(uniforms, group, style, 0u32));
    new EmitterHandle(index)
  }

  // How many emitters it has
  pub fn emitterCount(self &) usize { slots.len() }

  // Bind the emitter 'h' to 'emitter' started by 'event', at 'now' (seconds,
  // the event's clock), from the next submission on. Answers how many
  // particles it will draw (living or not: those that might be).
  pub fn update(self &mut, device &mut Device, h EmitterHandle, emitter &Emitter, event &Event, now f64) u32 {
    if usize.from(h.index) >= slots.len() { return 0u32; }
    let params = EmitterParams.bind(emitter, event, now);
    let words = params.words();
    var slot = &mut slots[usize.from(h.index)];
    device.queue.writeBuffer(&slot.uniforms, 0u64, &words as *u8, EMITTER_BYTES);
    slot.count = params.seeds.w;
    slot.count
  }

  // Record one render pass adding every emitter's particles into 'target'
  // (what render drew the scene into, its contents kept), depth tested
  // against 'depth' (kept by render's 'keepDepth'), seen by 'camera'
  pub fn render(self &mut, device &mut Device, encoder &mut CommandEncoder, target &Texture, depth &Texture,
      camera &Camera) {
    drawCalls = 0u32;
    particles = 0u64;
    if target.width == 0u32 or target.height == 0u32 { return; }
    let aspect = f32.from(target.width) / f32.from(target.height);
    let viewProjection = camera.projectionMatrix(aspect) * camera.viewMatrix();
    let placement = camera.placement();
    // A camera that sees in a mirror sees the world reflected: the sprites and ribbons
    // face its reflected eye, and its up is the reflection of its own
    let eye = camera.position();
    let placedUp = new Vec3(placement.m[4], placement.m[5], placement.m[6]).normalize();
    let up = if camera.reflected { camera.reflectionMatrix().transformVector(placedUp).normalize() } else { placedUp };
    var frame = new Array[f32, 24] <- fill 0f;
    var k = 0usize;
    while k < 16usize {
      frame[k] = viewProjection.m[k];
      k = k + 1usize;
    }
    frame[16] = eye.x;
    frame[17] = eye.y;
    frame[18] = eye.z;
    frame[19] = 1.;
    frame[20] = up.x;
    frame[21] = up.y;
    frame[22] = up.z;
    device.queue.writeBuffer(&frameUniforms, 0u64, &frame as *u8, FRAME_BYTES);

    let color = new RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_LOAD,
      clearValue: new Color(0., 0., 0., 0.));
    let depthAttachment = new RenderPassDepthStencilAttachment(view: depth.createView(), depthLoadOp: LOAD_OP_LOAD,
      depthStoreOp: STORE_OP_DISCARD);
    var pass = encoder.beginRenderPassWithDepth(&color, &depthAttachment);
    var bound = 99u32;
    var i = 0usize;
    while i < slots.len() {
      let slot = slots[i];
      if slot.count > 0u32 {
        if bound != slot.style {
          if slot.style == STYLE_TRAILS {
            pass.setPipeline(&trailPipeline);
          } elif slot.style == STYLE_SMOKE {
            pass.setPipeline(&smokePipeline);
          } else {
            pass.setPipeline(&spritePipeline);
          }
          pass.setBindGroup(0u32, &frameGroup);
          bound = slot.style;
        }
        pass.setBindGroup(1u32, &slot.group);
        let vertices = if slot.style == STYLE_TRAILS { 6u32 * TRAIL_SEGMENTS } else { 6u32 };
        pass.draw(vertices, slot.count, 0u32, 0u32);
        drawCalls = drawCalls + 1u32;
        particles = particles + u64.from(slot.count);
      }
      i = i + 1usize;
    }
    pass.end();
  }
}

