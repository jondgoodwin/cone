// hash: the seed a program's hashers start from.
//
// core's 'Hasher.seeded()' mixes this one number into every hash it makes, so
// the numbers differ from run to run and nobody outside the process can tell
// which keys collide (core's 'processSeed' is this function). It is 64 random
// bits from the OS, drawn the first time anything asks, from any thread, and
// then the same for the rest of the process. The OS's generator is, on
// Windows, the C runtime's 'rand_s', which the UCRT answers from the system's
// own (RtlGenRandom) and which needs no library beyond the ones every program
// links; elsewhere, POSIX's 'getentropy' (the kernel's, in the C library of
// Linux and macOS alike). Only the side the build takes is generated.

// The seed once drawn, 0 until then. Read and set only atomically; conestd's
// 'init' (conestd.cone) gives it its value
let hashSeed core.Atomic[u64];

// The C runtime's 32 random bits from the OS: 0 if it drew them, else an error
extern fn rand_s(value *u32) i32;

// Fills the 'len' bytes at 'buf' (at most 256) with the kernel's random bytes:
// 0 if it did, else -1
extern fn getentropy(buf *u8, len usize) i32;

pub fn cone_hashSeed() u64 {
  let drawn = hashSeed.load();
  if drawn != 0u64 {return drawn;}

  var low = 0u32;
  var high = 0u32;
  var bits = 0u64;
  var fresh = 0u64;
  var got = false;
  if core.isWindows() {
    got = rand_s(&mut low as *u32) == 0 && rand_s(&mut high as *u32) == 0;
    bits = (u64.from(high) << 32u64) | u64.from(low);
  }
  else {
    got = getentropy(&mut bits as *u8, 8usize) == 0;
  }
  if got {
    fresh = bits;
  }
  else {
    // The OS refused, which it does not: the clock and where this global sits
    // are not secret, but are different every run
    fresh = (u64.from(libc.time(null)) * 0x9e3779b97f4a7c15u64) ^ u64.from((&hashSeed as *u64) as usize);
  }
  if fresh == 0u64 {fresh = 0x9e3779b97f4a7c15u64;}

  // Two threads drawing at once settle on whichever stored first
  let settled = hashSeed.compareSwap(0u64, fresh);
  if settled.1 {fresh} else {settled.0}
}
