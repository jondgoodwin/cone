// conestd: the runtime every native Cone program links beside its own
// objects, under core and stdio. Its files are one module: the end of every
// panic (panic.cone), the head of the chain of traced roots and its walk
// (roots.cone), printing (stdio.cone, and floatfmt.cone for a float's text), and the hook a compute kernel's
// barriers call on the CPU (barrier.cone), the seed a program's hashers
// start from (hash.cone), and the raw blocks layer, where the heap's memory
// comes from (rawblocks.cone). What it needs that Cone cannot say is C: in
// mainthread.c, recording, before 'main' runs, which thread the program started
// on; in heapregion.c, the heap's region, the static object of function
// addresses that every collection made without a region points to; and in
// cnames.c, the C library's names Cone cannot spell (its standard streams,
// errno, time, and the numbers that differ by C library), which libc binds.
//
// It is a C-named module, so each public function and global is a C symbol
// of its own name: 'cone_panic', 'cone_gcframes', 'printStr'. Those are the
// names the compiler emits calls and loads of itself (cone_panicIndex,
// cone_panicSlice, cone_panicAlloc, cone_gcframes, cone_traceRoots,
// cone_barrierHook, cone_barrierCtx) and the
// ones core's and stdio's 'extern' declarations bind to, each with the same
// parameters, so a program's object links against this one exactly as it
// did against C's. What is private is this object's own. Being C-named, the
// module gets no prelude, so it imports core and names what it uses of it
// through it ('core.mem'). Like libc, which it writes through, it binds the
// C runtime of Windows or the C library of Linux, a call at a time: where the
// two differ it chooses by core's 'isWindows()', so that only the target's
// call is generated.
//
// CMake compiles this folder with the conec it has just built, into one
// object, and archives that with the C files' as conestd.lib; Congo and the
// test runner link that library, and nothing imports this module.

mod @c conestd;

import core;
import libc;

// The module's init, run by the C runtime before 'main' as this object loads
// (a C-named module is reached by its C names, so no program imports it and
// the program's stitched init does not call it): it gives the module's atomic
// globals their value, zero, which core's constructor makes
fn @initpure init() {
  hashSeed = core.Atomic[u64].of(0u64);
  panicHook = core.Atomic[usize].of(0usize);
}

// Text on its way to a C stream: gathered, then written in one piece where it
// fits, as one call of C's printf writes its text. Standard error is not
// buffered on Windows, so a line written piece by piece could have another
// thread's text land inside it. A text that outgrows the buffer is written as
// it fills, the same bytes in more than one write. With no stream, it holds
// at most what the buffer does
struct Text {
  stream *libc.FILE;
  len usize;
  bytes Array[u8, 1024];

  fn byte(self &mut, b u8) {
    if len == 1024usize {
      if stream == null {return;}
      self.write();
    }
    bytes[len] = b;
    len = len + 1usize;
  }

  // The bytes of s up to its first NUL, as C's '%.*s' writes a counted string
  fn text(self &mut, s &str) {
    let b &Array[u8] = s;
    var i = 0usize;
    while i < b.len {
      if b[i] == 0u8 {return;}
      self.byte(b[i]);
      i = i + 1usize;
    }
  }

  // n in decimal, as C's '%u', '%lu', '%zu' and '%llu' write it
  fn decimal(self &mut, n u64) {
    var digits = new Array[u8, 20] <- fill 0u8;
    var count = 0usize;
    var rest = n;
    var going = true;
    while going {
      digits[count] = u8.from(rest % 10u64) + '0';
      count = count + 1usize;
      rest = rest / 10u64;
      going = rest > 0u64;
    }
    while count > 0usize {
      count = count - 1usize;
      self.byte(digits[count]);
    }
  }

  // What is gathered, as text (all of it is what 'text' and 'decimal' put in)
  fn view(self &) &str {
    &bytes[0usize..<len] as &str
  }

  // Write what is gathered to the stream
  fn write(self &mut) {
    if len > 0usize {
      libc.fwrite(&mut bytes[0usize] as *u8, len, 1usize, stream);
    }
    len = 0usize;
  }
}

fn newText(stream *libc.FILE) Text {
  new Text(stream, 0usize, new Array[u8, 1024] <- fill 0u8)
}
