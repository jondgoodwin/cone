// rawblocks: the raw blocks layer, core's 'RawBlocks'.
//
// Where the runtime gets the bytes that hold a program's values and gives them
// back: under the heap's region, the regions of 'Uni', 'Rc', 'Arc' and the other
// managed references, a collection's block, an arena's blocks, and an actor's
// chunks and large objects. This is the only file that names where those bytes
// come from, and today it is the C library's 'malloc', 'realloc' and 'free',
// each function forwarding to its one call. Nothing is added: no size classes,
// no caching, no configuration, no system calls. A later allocator replaces
// these three functions and no caller.
//
// The functions are core's declarations ('RawBlocks.alloc', 'resize',
// 'release'), which core's include file binds to these symbols, and the
// heap's region (heapregion.c) points at them. The contract is core's, above
// 'RawBlocks'. 'align' is not acted on yet: 'malloc' aligns to 16 bytes, which
// is every block's alignment here.
//
// There is no room, no answer. A block that the C library cannot give panics,
// naming the bytes asked for (cone_panicAlloc, as the compiler's own
// allocation does), because the callers of these functions, collections among
// them, take the block as theirs: a null kept as a block with the room that was
// asked for is a write through null on the next push (Bug 80). A request for no
// bytes is never a failure, whatever the C library answers for it.

fn noRoom(bytes: usize, line: u32 = core.srcLine()) Never {
  let file: cstr = "rawblocks.cone";
  cone_panicAlloc(bytes, file.ptr(), 14usize, line)
}

pub fn @noalias cone_rawBlockAlloc(bytes: usize, align: usize) *u8 {
  let p = libc.malloc(bytes);
  if p == null && bytes != 0usize { noRoom(bytes); }
  p
}

pub fn cone_rawBlockResize(block: *u8, oldBytes: usize, newBytes: usize, align: usize) *u8 {
  let p = libc.realloc(block, newBytes);
  if p == null && newBytes != 0usize { noRoom(newBytes); }
  p
}

pub fn cone_rawBlockRelease(block: *u8) {
  libc.free(block);
}
