// stdio: the console, one for standard output and standard error, which the
// stdio package declares with 'extern'. Output arrives as records: a send
// statement's pieces are written into one writer (core's TextOut), and when the
// writer dies it hands the finished record to 'consoleDeliver'. A record is
// taken away whole, under the console's lock, so output from several threads
// never tears a record, and one thread's records appear in the order sent.
//
// Standard output and standard error are two outputs of the ONE console; the
// stream is a tag on the record. Where the record goes:
//
// - to a terminal: written at once. (Standard error is written at once
//   whatever it is.)
// - to a file or a pipe: appended to the console's own buffer, which is written
//   when the next record would not fit, when standard error writes (first, so
//   the two stay in order), by 'print.flush()' and when the program ends. A
//   record larger than the buffer is written at once, its parts in one
//   gathered call where the system has one (writev), still whole.
//
// The buffer is the console's, not C's: C's own 'stdout' buffer is no longer
// used for what Cone prints, so a C function in the same program that prints
// with printf has its text in C's buffer, written when C's library flushes it
// (at exit, after the console's, or at a newline on a terminal). 'print.flush()'
// flushes C's 'stdout' too, so the order holds where a program flushes between
// the two. A panic writes its message directly and synchronously, after the
// console's buffer is written.
//
// Three slots take the place of the code below once an engine is installed
// (cone_consoleInstall, called by the actors runtime when it starts, which
// installs its owner): a function handed each finished record, one handed a
// text sent alone, and one that controls the engine (flush, and a panic's
// best-effort drain). Installing writes out what waits under the console's lock
// and then switches, so nothing is lost or reordered. From then on the code
// below writes nothing but a panic's message (panic.cone) and what a thread
// that read the empty slot just before the switch was sending.
//
// The operating system's side (the lock, the terminal test, the write) is
// console.c.

extern fn cone_consoleLock();
extern fn cone_consoleUnlock();
extern fn cone_consoleIsTty(fd: i32) i32;
extern fn cone_consoleWrite(fd: i32, p: *u8, n: usize);
extern fn cone_consoleWriteParts(fd: i32, parts: *usize, count: usize);
extern fn cone_consoleAtExit(finish: &fn @c());

// The functions an engine installs: one takes a finished record; one takes a
// text sent alone, as its stream and bytes; one controls it, with op 0, to wait
// until everything sent has been written; op 1, a panic's, to wait for that
// while the engine makes progress, without waiting on anything it might hold
// (it gives up when 500 ms pass with no progress, or 10 s in all, and a second
// call after a give-up returns at once); and op 2, a panic's last step, to write
// one line to standard error saying how many lines were queued but not written,
// if op 1 gave up with some unwritten (the actors' console.cone)
alias ConsoleEngine = &fn(record: &uni core.TextOut);
alias ConsoleBytes = &fn(fd: i32, p: *u8, n: usize);
alias ConsoleControl = &fn(op: u32);

// The installed engine's addresses, 0 for the code below. conestd's 'init'
// gives them their value
let consoleEngine: core.Atomic[usize];
let consoleEngineBytes: core.Atomic[usize];
let consoleEngineControl: core.Atomic[usize];

const consoleCap = 16384usize;
// What waits to be written to standard output, and how much of it
// (all three are atomics, read and written only under cone_consoleLock, in the
// relaxed order: the lock orders them. The buffer is a block conestd's 'init'
// makes and never frees, held as its address: a panic prints after 'finalAll',
// so nothing may take it down first. Before 'init' (another module's may print)
// the address is 0 and a record is written at once, unbuffered)
let consoleBuf: core.Atomic[usize];
let consoleLen: core.Atomic[usize];
// Whether standard output is a terminal: 0 until the first record asks, then 1 + the answer
let consoleOutTty: core.Atomic[i32];
// Whether this thread is inside the engine, holding its lock: a panic in there
// must not wait for it
var @threadlocal inConsole = false;

// Install an engine: what waits is written, under the lock, then the slots switch
pub fn cone_consoleInstall(take: usize, bytes: usize, control: usize) {
  cone_consoleLock();
  inConsole = true;
  consolePending();
  consoleEngineBytes.store(bytes);
  consoleEngineControl.store(control);
  consoleEngine.store(take);
  inConsole = false;
  cone_consoleUnlock();
}

// What waits is written (the lock is held)
fn consolePending() {
  if consoleLen.loadOrdered(core.MemOrder.Relaxed) > 0usize {
    cone_consoleWrite(1i32, consoleBuf.loadOrdered(core.MemOrder.Relaxed) as *u8, consoleLen.loadOrdered(core.MemOrder.Relaxed));
    consoleLen.storeOrdered(0usize, core.MemOrder.Relaxed);
  }
}

// n bytes at p added to the buffer, which has room (the lock is held)
fn bufferAppend(p: *u8, n: usize) {
  let len = consoleLen.loadOrdered(core.MemOrder.Relaxed);
  core.mem.moveRaw[u8]((consoleBuf.loadOrdered(core.MemOrder.Relaxed) as *u8) + len, p, n);
  consoleLen.storeOrdered(len + n, core.MemOrder.Relaxed);
}

// Whether standard output is a terminal, asked once (the lock is held)
fn consoleTty() bool {
  if consoleOutTty.loadOrdered(core.MemOrder.Relaxed) == 0i32 {
    let isTty = if cone_consoleIsTty(1i32) != 0i32 { 2i32 } else { 1i32 };
    consoleOutTty.storeOrdered(isTty, core.MemOrder.Relaxed);
  }
  consoleOutTty.loadOrdered(core.MemOrder.Relaxed) == 2i32
}

// n bytes at p as one record of stream fd, 1 or 2
fn consoleOne(fd: i32, p: *u8, n: usize) {
  if n == 0usize {return;}
  if consoleEngine.load() != 0usize {
    let take = consoleEngineBytes.load() as ConsoleBytes;
    take(fd, p, n);
    return;
  }
  cone_consoleLock();
  inConsole = true;
  if fd == 2i32 {
    consolePending();
    cone_consoleWrite(2i32, p, n);
  }
  else if consoleTty() {
    cone_consoleWrite(1i32, p, n);
  }
  else {
    if n > consoleCap - consoleLen.loadOrdered(core.MemOrder.Relaxed) {consolePending();}
    if n >= consoleCap || consoleBuf.loadOrdered(core.MemOrder.Relaxed) == 0usize {
      cone_consoleWrite(1i32, p, n);
    }
    else {
      bufferAppend(p, n);
    }
  }
  inConsole = false;
  cone_consoleUnlock();
}

// Core's TextOut, the writer a value writes its text into, keeps what is slow
// or rare here (core is all inline). A record starts in the writer's own store
// and chains heap blocks on after it, in order; a window onto another value's
// bytes asks its lender for room.

// Make room for 'need' more bytes: whether there is now
pub fn cone_textGrow(w: &uni core.TextOut, need: usize) bool {
  if w.mode == 1u32 {
    let spiller = w.spill as core.TextSpill;
    spiller(w, need);
    return w.len + need <= w.cap;
  }
  if w.mode == 2u32 {return false;}
  // A record: seal the current bytes, chain on a block big enough
  var size = 1024usize;
  if w.last != null {size = (*w.last).cap * 2usize;}
  if size > 65536usize {size = 65536usize;}
  if size < need {size = need;}
  let header = core.mem.sizeof[core.TextChunk]();
  let raw = core.RawBlocks.alloc(header + size, 16usize);
  if raw == null {return false;}
  let chunk = raw as *core.TextChunk;
  (*chunk).next = null;
  (*chunk).len = 0usize;
  (*chunk).cap = size;
  if w.last == null {
    w.inlen = w.len;
    w.first = chunk;
  }
  else {
    (*w.last).len = w.len;
    (*w.last).next = chunk;
  }
  w.last = chunk;
  w.base = raw + header;
  w.len = 0usize;
  w.cap = size;
  true
}

// The writer dies: the function its maker gave takes the record away, then the
// blocks go back
pub fn cone_textFinish(w: &uni core.TextOut) {
  if w.done != 0usize {
    let finish = w.done as core.TextDone;
    finish(w);
  }
  var c = w.first;
  while c != null {
    let following = (*c).next;
    core.RawBlocks.release(c as *u8);
    c = following;
  }
  w.first = null;
  w.last = null;
}

// A record's size in bytes
fn textSize(w: &core.TextOut) usize {
  if w.last == null {return w.len;}
  var total = w.inlen;
  var c = w.first;
  while c != w.last {
    total = total + (*c).len;
    c = (*c).next;
  }
  total + w.len
}

// Hand 'visit' each part of the record in order, as a pointer and a count: the
// store's bytes, then each block's
fn textParts(w: &core.TextOut, visit: core.TextVisit, ctx: *u8) {
  let store = &w.store as *u8;
  if w.last == null {
    if w.len > 0usize {visit(store, w.len, ctx);}
    return;
  }
  if w.inlen > 0usize {visit(store, w.inlen, ctx);}
  let header = core.mem.sizeof[core.TextChunk]();
  var c = w.first;
  while c != w.last {
    if (*c).len > 0usize {visit((c as *u8) + header, (*c).len, ctx);}
    c = (*c).next;
  }
  if w.len > 0usize {visit(w.base, w.len, ctx);}
}

// The parts of a record, gathered to be written in one call
struct Gather {
  fd: i32;
  count: usize;
  items: Array[usize, 64];
}

fn gatherPart(p: *u8, n: usize, ctx: *u8) {
  let g = ctx as &mut Gather;
  if g.count == 32usize {
    cone_consoleWriteParts(g.fd, &mut g.items[0usize] as *usize, g.count);
    g.count = 0usize;
  }
  g.items[g.count * 2usize] = p as usize;
  g.items[g.count * 2usize + 1usize] = n;
  g.count = g.count + 1usize;
}

// The record, written now to stream fd in as few calls as the system takes
fn consoleParts(fd: i32, w: &core.TextOut) {
  var g = Gather(fd, 0usize, Array[usize, 64]() <- fill 0usize);
  textParts(w, &gatherPart, &mut g as *u8);
  if g.count > 0usize {
    cone_consoleWriteParts(fd, &mut g.items[0usize] as *usize, g.count);
  }
}

// A part of a record, appended to the buffer
fn bufferPart(p: *u8, n: usize, ctx: *u8) {
  bufferAppend(p, n);
}

// A record of several parts, or any size, as one record of stream fd
fn consoleMany(fd: i32, w: &core.TextOut) {
  let size = textSize(w);
  if size == 0usize {return;}
  cone_consoleLock();
  inConsole = true;
  if fd == 2i32 {
    consolePending();
    consoleParts(2i32, w);
  }
  else if consoleTty() {
    consoleParts(1i32, w);
  }
  else {
    if size > consoleCap - consoleLen.loadOrdered(core.MemOrder.Relaxed) {consolePending();}
    if size >= consoleCap || consoleBuf.loadOrdered(core.MemOrder.Relaxed) == 0usize {
      consoleParts(1i32, w);
    }
    else {
      textParts(w, &bufferPart, null);
    }
  }
  inConsole = false;
  cone_consoleUnlock();
}

// Take a finished record away: what the writer a stream makes (stdio's
// 'record') calls as it dies, with its tag the stream, 1 or 2
pub fn consoleDeliver(w: &uni core.TextOut) {
  let engine = consoleEngine.load();
  if engine != 0usize {
    let take = engine as ConsoleEngine;
    take(w);
    return;
  }
  consoleMany(i32.from(w.tagOf()), w);
}

// Write what waits: the engine's first, if one is installed (op 0 waits until
// all that was sent has been written; op 1 is a failed main's and op 3 a panic's, which wait on nothing
// it might hold, waits while the engine makes progress, and gives up), then the console's own
fn consoleFlush(op: u32) {
  let control = consoleEngineControl.load();
  if control != 0usize {
    let ctl = control as ConsoleControl;
    ctl(op);
  }
  cone_consoleLock();
  inConsole = true;
  consolePending();
  inConsole = false;
  cone_consoleUnlock();
}

// A panic or a failed main writes what the program printed before, if the
// thread does not hold the console's lock itself
fn consoleFlushForPanic() {
  if !inConsole {consoleFlush(1u32);}
}

// A panic, which ends the program once it has written (cone_panic; a failed
// main goes on, and uses the one above): op 3 is op 1 and, when the engine's
// owner has not written what is queued, the panicking thread writes it itself
fn consoleFlushForAbort() {
  if !inConsole {consoleFlush(3u32);}
}

// A panic's last step: the engine reports lines it dropped, if any
fn consoleReportForPanic() {
  let control = consoleEngineControl.load();
  if control != 0usize && !inConsole {
    let ctl = control as ConsoleControl;
    ctl(2u32);
  }
}

// At the program's end
fn consoleExit() {
  consoleFlush(0u32);
}

// conestd's 'init' (conestd.cone) arranges the console's end
fn consoleInit() {
  cone_consoleAtExit(&consoleExit);
}

// A C string, as C's '%s' writes one: its bytes up to the NUL, or '(null)'
// for a null pointer, as the Windows C runtime writes that
fn consoleCStr(fd: i32, p: *u8) {
  if p == null {
    consoleOne(fd, &"(null)" as *u8, 6usize);
    return;
  }
  consoleOne(fd, p, libc.strlen(cstr.fromPtr(p)));
}

// One piece as a record of its own, written into a writer of its own
fn consoleInt(fd: i32, nbr: i64) {
  var w = core.TextOut.record(0usize, null, u32.from(fd));
  w.putI64(nbr);
  consoleDeliver(&uni w);
}

fn consoleUInt(fd: i32, nbr: u64) {
  var w = core.TextOut.record(0usize, null, u32.from(fd));
  w.putU64(nbr);
  consoleDeliver(&uni w);
}

fn consoleFloat(fd: i32, nbr: f64) {
  var w = core.TextOut.record(0usize, null, u32.from(fd));
  w.putF64(nbr);
  consoleDeliver(&uni w);
}

// One code point as its UTF-8 bytes: one to four, by its size. NUL, and a
// value past U+10FFFF, write nothing
fn consoleChar(fd: i32, code: u64) {
  if code == 0u64 || code >= 0x110000u64 {return;}
  var w = core.TextOut.record(0usize, null, u32.from(fd));
  w.putChar(char.from(u32.from(code)));
  consoleDeliver(&uni w);
}

// Standard output

pub fn printStr(str: &str) {
  let b: &Array[u8] = str;
  consoleOne(1i32, b as *u8, b.len);
}

pub fn printCStr(p: *u8) {
  consoleCStr(1i32, p);
}

pub fn printInt(nbr: i64) {
  consoleInt(1i32, nbr);
}

pub fn printUInt(nbr: u64) {
  consoleUInt(1i32, nbr);
}

pub fn printFloat(nbr: f64) {
  consoleFloat(1i32, nbr);
}

pub fn printChar(code: u64) {
  consoleChar(1i32, code);
}

// What waits is written, and so is what C's own stdout holds
pub fn printFlush() {
  consoleFlush(0u32);
  libc.fflush(libc.stdout());
}

// Standard error, which is written at once (after what waits for standard output)

pub fn eprintStr(str: &str) {
  let b: &Array[u8] = str;
  consoleOne(2i32, b as *u8, b.len);
}

pub fn eprintCStr(p: *u8) {
  consoleCStr(2i32, p);
}

pub fn eprintInt(nbr: i64) {
  consoleInt(2i32, nbr);
}

pub fn eprintUInt(nbr: u64) {
  consoleUInt(2i32, nbr);
}

pub fn eprintFloat(nbr: f64) {
  consoleFloat(2i32, nbr);
}

pub fn eprintChar(code: u64) {
  consoleChar(2i32, code);
}

pub fn eprintFlush() {
  consoleFlush(0u32);
  libc.fflush(libc.stderr());
}

// ---- Standard input -------------------------------------------------------------------------------------
//
// The reads of the stdin package ('readLine', 'readAll', 'readBytes'). The raw read is console.c's
// cone_stdinRead (up to n bytes, waiting for at least one; 0 at the end; the system's error number made
// negative); the buffer that sits over it is here, so a line read leaves what follows it for the next
// call. A thread that reads holds cone_stdinLock for the read and blocks in it, so a second reader waits
// its turn: these are for a program with no actors, and an actor's behaviour does not call them. The
// console's lock (the printing above) is never taken, so a read that waits stops no printing.
//
// The buffer is a block made on the first read that needs it and never freed, held as its address like the
// console's (its position and length are atomics read and written only under the stdin lock, relaxed).
// Do not mix these reads with C's own 'stdin' (libc.fread) in one program: C's buffer would hold bytes this
// one never sees.

extern fn cone_stdinLock();
extern fn cone_stdinUnlock();
extern fn cone_stdinRead(buf: *u8, n: usize) i64;

const stdinCap = 65536usize;
let stdinBuf: core.Atomic[usize];
let stdinPos: core.Atomic[usize];
let stdinLen: core.Atomic[usize];

// Up to n bytes of standard input into p: how many (0 at the end of the input), or an error number made
// negative. With 'line' not 0, no more than up to and including the first '\n' that is there (what is
// copied ends with it when it was found). Waits for input only when the buffer is empty. A read at least
// as large as the buffer, with nothing buffered and no 'line', goes straight into p.
pub fn cone_stdinChunk(p: *u8, n: usize, line: i32) i64 {
  if n == 0usize {return 0i64;}
  cone_stdinLock();
  var pos = stdinPos.loadOrdered(core.MemOrder.Relaxed);
  var len = stdinLen.loadOrdered(core.MemOrder.Relaxed);
  if pos == len {
    if n >= stdinCap && line == 0i32 {
      let direct = cone_stdinRead(p, n);
      cone_stdinUnlock();
      return direct;
    }
    if stdinBuf.loadOrdered(core.MemOrder.Relaxed) == 0usize {
      let block = core.RawBlocks.alloc(stdinCap, 16usize);
      if block == null {
        cone_stdinUnlock();
        return -12i64;
      }
      stdinBuf.storeOrdered(block as usize, core.MemOrder.Relaxed);
    }
    let got = cone_stdinRead(stdinBuf.loadOrdered(core.MemOrder.Relaxed) as *u8, stdinCap);
    if got <= 0i64 {
      cone_stdinUnlock();
      return got;
    }
    pos = 0usize;
    len = usize.from(got);
  }
  let base = stdinBuf.loadOrdered(core.MemOrder.Relaxed) as *u8;
  var take = len - pos;
  if take > n {take = n;}
  if line != 0i32 {
    var i = 0usize;
    var found = false;
    while i < take && !found {
      if *(base + pos + i) == 10u8 {found = true;}
      i = i + 1usize;
    }
    if found {take = i;}
  }
  core.mem.moveRaw[u8](p, base + pos, take);
  stdinPos.storeOrdered(pos + take, core.MemOrder.Relaxed);
  stdinLen.storeOrdered(len, core.MemOrder.Relaxed);
  cone_stdinUnlock();
  i64.from(take)
}
