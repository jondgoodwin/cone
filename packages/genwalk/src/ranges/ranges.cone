// A submodule of genwalk with a public generator and a private one it hands on to,
// re-exported by the root

mod ranges;

fn isEven(n i64) bool { n % 2i64 == 0i64; }

fn steps(n i64) yields i64 {
  mut i = 0i64;
  while i < n { yield i; i = i + 1i64; }
}

pub fn evens(n i64) yields i64 {
  each v in steps(n) {
    if isEven(v) { yield v; }
  }
}

pub struct Ring {
  pub size i64;

  pub fn turn(self &, from i64) yields i64 {
    mut i = 0i64;
    while i < size {
      yield (from + i) % size;
      i = i + 1i64;
    }
  }
}
