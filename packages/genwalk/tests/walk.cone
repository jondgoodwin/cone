// The generators of genwalk, walked from another package. Every value printed is
// worked out by hand from the values put in:
// - count(4): 0 1 2 3;
// - clamped(6, 2, 4): 0 to 5, each held between 2 and 4: 2 2 2 3 4 4;
// - items over a list of 5 6 7, and over two points (1,2) and (3,4), whose
//   x * 10 + y are 12 and 34;
// - the tree in order: 10 20 30 40 50 60 70, then its values by position
//   (the array's order): 40 20 60 10 30 50 70;
// - a counter at 10 asked for 3: 11 12 13, left at 13, then 2 more: 14 15;
// - a bag of 1 2 3, walked by 'each' as it is, and backward: 1 2 3 and 3 2 1;
//   the same generators at a second bag of two points (8,9) and (6,7): their
//   y backward, 7 9.

mod walk;

import stdio use *;
import testing use *;
import collections use *;
import genwalk use *;

struct Pt {
  pub x i64;
  pub y i64;
}

fn num(v i64) {
  printInt(v);
  printStr(" ");
}

fn main() i32 {
  each v in count(4i64) { num(v); }
  printStr("\n");

  each v in clamped(6i64, 2i64, 4i64) { num(v); }
  printStr("\n");

  mut ints = new List[i64];
  ints.push(5i64); ints.push(6i64); ints.push(7i64);
  each v in items(&ints) { num(*v); }
  printStr("\n");

  mut pts = new List[Pt];
  pts.push(new Pt(1i64, 2i64)); pts.push(new Pt(3i64, 4i64));
  each p in items(&pts) { num(p.x * 10i64 + p.y); }
  printStr("\n");

  imm tree = new Tree([
    new Node(40i64, 1i64, 2i64),
    new Node(20i64, 3i64, 4i64),
    new Node(60i64, 5i64, 6i64),
    new Node(10i64, -1i64, -1i64),
    new Node(30i64, -1i64, -1i64),
    new Node(50i64, -1i64, -1i64),
    new Node(70i64, -1i64, -1i64)]);
  each n in tree.walk() { num(n.val); }
  printStr("\n");
  each v in tree.vals() { num(v); }
  printStr("\n");

  mut c = new Counter(10i64);
  each v in c.up(3i64) { num(v); }
  expectInt(c.n, 13i64, "counter after 3");
  each v in c.up(2i64) { num(v); }
  expectInt(c.n, 15i64, "counter after 5");
  printStr("\n");

  mut bag = new Bag[i64](new List[i64]);
  bag.all.push(1i64); bag.all.push(2i64); bag.all.push(3i64);
  each v in bag { num(*v); }
  each v in bag.backward() { num(*v); }
  printStr("\n");

  mut pbag = new Bag[Pt](new List[Pt]);
  pbag.all.push(new Pt(8i64, 9i64));
  pbag.all.push(new Pt(6i64, 7i64));
  each p in pbag.backward() { num(p.y); }
  printStr("\n");

  each v in evenCount(9i64) { num(v); }
  printStr("\n");

  done();
}
