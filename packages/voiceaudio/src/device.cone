// ======== The microphone and the speaker, over SDL3's audio streams ========
//
// Both are SDL "device streams": the stream takes (or gives) samples in the format the program asks for, and SDL
// converts between that and what the device runs at (channels, rate, format), so no resampling is written here.
// A stream is thread safe: one thread may `queue` into the Speaker while another calls `cutOff`.
//
// WHICH DRIVER IS NEVER LEFT TO CHANCE. Every open takes a `Driver`, a value the caller builds with one of
// `Driver.disk`, `Driver.dummy` or `Driver.system`: `disk` reads the microphone from a raw file and writes the
// speaker to one, `dummy` accepts audio and plays nothing (and records silence), and only `system` touches the
// machine's real devices. The open sets SDL's driver hint to what the Driver names, starts SDL's audio, and checks
// SDL's answer to "which driver is in use" BEFORE opening any device: a mismatch stops there, with no device open.
// Tests build only `disk` and `dummy`.
//
// The `disk` driver (SDL's own, for testing) records from a raw file of f32 little endian samples, mono, at
// DISK_RATE (44100 Hz: SDL 3.4.16 fixes the disk device's rate at that, whatever the stream asks for, and the
// stream converts; measured, and the SDL_AUDIO_FREQUENCY hint does not change it), and after the file's end records
// silence forever; it writes the speaker's output the same way. Its pace is real time times `timescale` (a text
// such as "1" for real time, "0.05" for 20 times faster, "0" for as fast as the CPU allows, which fills memory
// with silence at tens of MB a second once the file has ended, so keep such a device short lived).
// A stream opened at DISK_RATE meets the file sample for sample; at any other rate SDL's converter sits between.

// The disk driver's device rate
pub const DISK_RATE = 44100u32;

// Samples the microphone takes from SDL at a time (its scratch buffer, 0.5 s at 16 kHz)
const MIC_CHUNK = 8192usize;

// Which driver SDL is to use
pub const DRIVER_DISK = 1u32;
pub const DRIVER_DUMMY = 2u32;
pub const DRIVER_SYSTEM = 3u32;

// Why an open failed
pub struct AudioError is Error {
  pub reason: i32;          // 1: SDL's audio would not start, 2: SDL chose another driver than asked, 3: the stream would not open
  pub text: String;

  pub fn toText(self: &, out: &uni TextOut) { out <- text.view(); }
}

fn audioError(reason: i32, message: &str) AudioError { AudioError(reason, String.from(message)) }

pub struct Driver {
  pub kind: u32;
  pub inFile: String;       // disk: the raw f32 file the microphone reads
  pub outFile: String;      // disk: the raw file the speaker writes
  pub timescale: String;    // disk: "1" real time, "0.05" twenty times faster
  pub deviceFrames: u32;    // system: the device's buffer in frames (small makes a cut-off quick), 0 for SDL's choice

  // The disk driver: microphone from 'inFile', speaker to 'outFile', both raw mono f32 at DISK_RATE
  pub fn disk(inFile: &str, outFile: &str, timescale: &str) Driver {
    Driver(DRIVER_DISK, String.from(inFile), String.from(outFile), String.from(timescale), 0u32)
  }

  // The dummy driver: accepts audio and plays nothing; the microphone is silence
  pub fn dummy() Driver {
    Driver(DRIVER_DUMMY, String(), String(), String(), 0u32)
  }

  // The machine's real devices. Never in a test: this is the call that makes sound and listens.
  pub fn system(deviceFrames: u32) Driver {
    Driver(DRIVER_SYSTEM, String(), String(), String(), deviceFrames)
  }

  fn wanted(self: &) &str {
    if kind == DRIVER_DISK { return "disk"; }
    if kind == DRIVER_DUMMY { return "dummy"; }
    ""
  }

  // Name the driver to SDL, start its audio, and check which driver it chose. Every caller that gets Ok must
  // answer with `release`. No device is opened here.
  fn acquire(self: &) Result[void, AudioError] {
    if kind != DRIVER_SYSTEM {
      let want = String.from(self.wanted());
      sdl.SetHint("SDL_AUDIO_DRIVER", want.cstr());
    }
    if kind == DRIVER_DISK {
      sdl.SetHint("SDL_AUDIO_DISK_INPUT_FILE", inFile.cstr());
      sdl.SetHint("SDL_AUDIO_DISK_OUTPUT_FILE", outFile.cstr());
      sdl.SetHint("SDL_AUDIO_DISK_TIMESCALE", timescale.cstr());
    }
    if kind == DRIVER_SYSTEM && deviceFrames > 0u32 {
      var f = String();
      f <- u64.from(deviceFrames);
      sdl.SetHint("SDL_AUDIO_DEVICE_SAMPLE_FRAMES", f.cstr());
    }
    if !sdl.InitSubSystem(sdl.INIT_AUDIO) {
      return Err[void, AudioError](audioError(1i32, "SDL audio would not start"));
    }
    if kind != DRIVER_SYSTEM {
      let name = sdl.GetCurrentAudioDriver();
      var ok = name as usize != 0usize;
      if ok {
        let want = self.wanted();
        var i = 0usize;
        while i < want.len() { if *(name + i) != want[i] { ok = false; } i = i + 1usize; }
        if *(name + want.len()) != 0u8 { ok = false; }
      }
      if !ok {
        sdl.QuitSubSystem(sdl.INIT_AUDIO);
        return Err[void, AudioError](audioError(2i32, "SDL chose another audio driver than the one asked for; no device was opened"));
      }
    }
    Ok[void, AudioError](nil)
  }

  fn release(self: &) { sdl.QuitSubSystem(sdl.INIT_AUDIO); }
}

// The microphone: mono f32 at 'rate'. Nothing runs on a thread of ours: SDL fills the stream, and `read` takes
// what has arrived.
pub struct Microphone {
  stream: *sdl.AudioStream;
  pub rate: u32;
  taken: usize;
  scratch: List[f32];       // SDL writes here, once sized at open (no zero-fill or allocation per read)

  pub fn open(driver: &Driver, rate: u32) Result[Microphone, AudioError] {
    driver.acquire()?;
    let spec = sdl.AudioSpec(sdl.AUDIO_F32, 1i32, i32.from(rate));
    let stream = sdl.OpenAudioDeviceStream(sdl.AUDIO_DEVICE_DEFAULT_RECORDING, &spec, null, null);
    if stream as usize == 0usize {
      driver.release();
      return Err[Microphone, AudioError](audioError(3i32, "the recording stream would not open"));
    }
    sdl.ResumeAudioStreamDevice(stream);
    var scratch = List[f32]();
    scratch.resize(MIC_CHUNK, 0.);
    Ok[Microphone, AudioError](Microphone(stream, rate, 0usize, scratch))
  }

  // Take up to one chunk of the waiting samples into the scratch buffer (at most 'max'); answers how many.
  // Allocates and zero-fills nothing: the scratch was sized when the microphone opened.
  fn take(self: &mut, max: usize) usize {
    var n = self.available();
    if n > max { n = max; }
    if n > MIC_CHUNK { n = MIC_CHUNK; }
    if n == 0usize { return 0usize; }
    var got = 0i32;
    {
      let m = scratch.viewMut();
      got = sdl.GetAudioStreamData(stream, (&mut m[0usize] as *u8), i32.from(n * 4usize));
    }
    if got <= 0i32 { return 0usize; }
    let g = usize.from(got) / 4usize;
    taken = taken + g;
    g
  }

  // Samples ready to read
  pub fn available(self: &) usize {
    let b = sdl.GetAudioStreamAvailable(stream);
    if b <= 0i32 { return 0usize; }
    usize.from(b) / 4usize
  }

  // Append up to 'max' of the waiting samples to 'out'; answers how many were appended
  pub fn read(self: &mut, out: &mut List[f32], max: usize) usize {
    var total = 0usize;
    var more = true;
    while more && total < max {
      let g = self.take(max - total);
      if g == 0usize { more = false; } else {
        let v = scratch.view();
        out.appendSlice(mem.sliceFromParts(&v[0usize] as *f32, g));
        total = total + g;
      }
    }
    total
  }

  // Samples read so far
  pub fn samplesTaken(self: &) usize { taken }

  // Read everything waiting into the detector; the utterances that ended go to 'out'. Answers samples read.
  pub fn pump(self: &mut, vad: &mut Vad, out: &mut List[Utterance]) usize {
    // chunk by chunk through the scratch buffer: the detector gives the same utterances however the
    // samples arrive (tests/vadpush), and no list is made per call
    var total = 0usize;
    var more = true;
    while more && total < 1000000usize {
      let g = self.take(1000000usize - total);
      if g == 0usize { more = false; } else {
        let v = scratch.view();
        vad.push(mem.sliceFromParts(&v[0usize] as *f32, g), out);
        total = total + g;
      }
    }
    total
  }

  pub fn close(self: &mut) {
    sdl.DestroyAudioStream(stream);
    sdl.QuitSubSystem(sdl.INIT_AUDIO);
  }
}

// The speaker: mono f32 at 'rate' (24000 for Kokoro's speech). `queue` appends to what is waiting, `cutOff`
// throws what is waiting away at once.
pub struct Speaker {
  stream: *sdl.AudioStream;
  pub rate: u32;
  queued: usize;
  gaps: u64;                // see `underruns` and `boundaryGaps`
  starved: u64;
  flushed: bool;            // a `flush` or `cutOff` came after the last `queue`: the next gap is a boundary

  pub fn open(driver: &Driver, rate: u32) Result[Speaker, AudioError] {
    driver.acquire()?;
    let spec = sdl.AudioSpec(sdl.AUDIO_F32, 1i32, i32.from(rate));
    let stream = sdl.OpenAudioDeviceStream(sdl.AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, null, null);
    if stream as usize == 0usize {
      driver.release();
      return Err[Speaker, AudioError](audioError(3i32, "the playback stream would not open"));
    }
    sdl.ResumeAudioStreamDevice(stream);
    Ok[Speaker, AudioError](Speaker(stream, rate, 0usize, 0u64, 0u64, false))
  }

  // Append samples to the queue; false if SDL refused them. A `queue` that finds the stream empty after sound
  // was queued before is a gap in the sound: counted in `underruns` when no `flush` or `cutOff` came between
  // (the speech ran dry mid-sentence), else in `boundaryGaps` (the silence after a sentence, expected).
  pub fn queue(self: &mut, x: &Array[f32]) bool {
    if x.len == 0usize { return true; }
    // "empty" is under a millisecond waiting: SDL's converter holds a few samples back until a flush
    if queued > 0usize && self.waiting() * 1000usize / usize.from(rate) == 0usize {
      if flushed { gaps = gaps + 1u64; } else { starved = starved + 1u64; }
    }
    flushed = false;
    let ok = sdl.PutAudioStreamData(stream, (&x[0usize] as *u8), i32.from(x.len * 4usize));
    if ok { queued = queued + x.len; }
    ok
  }

  // What was queued is all there is for now (the end of a sentence): SDL's converter, when the stream and the
  // device differ in rate, holds a few samples back until told, so call this after the last `queue` of a sentence
  pub fn flush(self: &mut) { sdl.FlushAudioStream(stream); flushed = true; }

  // Times `queue` found the stream empty in the middle of speech (no `flush` or `cutOff` since the last queue):
  // the producer was too slow. Counted only when `queue` is called; a stream that runs dry and is not queued to
  // again is not seen.
  pub fn underruns(self: &) u64 { starved }

  // Times `queue` found the stream empty after a `flush` or a `cutOff`: the expected silence between sentences
  pub fn boundaryGaps(self: &) u64 { gaps }

  // Samples waiting in the stream (not yet taken by the device)
  pub fn waiting(self: &) usize {
    let b = sdl.GetAudioStreamQueued(stream);
    if b <= 0i32 { return 0usize; }
    usize.from(b) / 4usize
  }

  // Milliseconds of sound waiting in the stream
  pub fn waitingMs(self: &) u32 { u32.from(self.waiting() * 1000usize / usize.from(rate)) }

  // Everything waiting is thrown away; the device keeps what it already took, which is its buffer
  // (`Driver.system(frames)` sets how big that is)
  pub fn cutOff(self: &mut) { sdl.ClearAudioStream(stream); flushed = true; }

  // Samples handed to `queue` so far
  pub fn samplesQueued(self: &) usize { queued }

  pub fn pause(self: &mut) { sdl.PauseAudioStreamDevice(stream); }
  pub fn resume(self: &mut) { sdl.ResumeAudioStreamDevice(stream); }

  // Wait (polling every 2 ms) until nothing is waiting in the stream or 'timeoutMs' passes; true if it emptied.
  // What the device already took may still be playing.
  pub fn drain(self: &mut, timeoutMs: u32) bool {
    var waited = 0u32;
    while self.waiting() > 0usize {
      if waited >= timeoutMs { return false; }
      thread.sleep(Duration.fromMillis(2));
      waited = waited + 2u32;
    }
    true
  }

  pub fn close(self: &mut) {
    sdl.DestroyAudioStream(stream);
    sdl.QuitSubSystem(sdl.INIT_AUDIO);
  }
}
