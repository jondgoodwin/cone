// A prop's surface as signed distances: what a hand's fingers touch.
//
// A PropSurface is a union of primitives (a sphere, a capsule, a box, a
// cylinder, a torus, an ellipsoid, a plane), each placed by a transform in
// the prop's own space. Its distance at a point is the smallest of the
// primitives': negative inside, positive outside, the distance to the nearest
// surface where it is a true distance. The formulas are the exact or bounded
// ones Inigo Quilez lists ("Distance functions", iquilezles.org): a ball's
// radius off, a capsule the distance to its segment less its radius, a box the
// length of the outside excess plus the deepest overshoot inside, a
// cylinder the same from its two radii, a torus the distance to its ring, an
// ellipsoid by the bound k0 (k0 - 1) / k1 (not a true distance, but zero on
// the surface and signed, which is all a closing finger needs).
//
// The grip solver asks one question of a surface: is this point (a finger's
// segment, less its flesh) inside? Any shape that answers is a prop: the
// primitives here make a hammer, a pin, a cup and a ball of dough, and a
// program may add a primitive without changing the solver.

pub const PRIM_SPHERE = 0u32;      // radius: p.x
pub const PRIM_CAPSULE = 1u32;     // radius p.x, half the segment's length p.y, along the primitive's y
pub const PRIM_BOX = 2u32;         // half extents p
pub const PRIM_CYLINDER = 3u32;    // radius p.x, half height p.y, along y
pub const PRIM_TORUS = 4u32;       // the ring's radius p.x, the tube's p.y; the ring in the primitive's xz plane
pub const PRIM_ELLIPSOID = 5u32;   // radii p
pub const PRIM_PLANE = 6u32;       // the plane y = 0, solid below it

pub struct Prim {
  pub kind: u32;
  pub placement: Transform3;        // the primitive's own space in the prop's
  pub p: Vec3;
}

fn maxv(a: f32, b: f32) f32 { if a > b { return a; } b }
fn minv(a: f32, b: f32) f32 { if a < b { return a; } b }

// A primitive's signed distance at a point in its own space
pub fn primDistance(kind: u32, p: Vec3, q: Vec3) f32 {
  if kind == PRIM_SPHERE { return q.length() - p.x; }
  if kind == PRIM_CAPSULE {
    let y = clampf(q.y, -p.y, p.y);
    return (Vec3(q.x, q.y - y, q.z)).length() - p.x;
  }
  if kind == PRIM_BOX {
    let dx = q.x.abs() - p.x;
    let dy = q.y.abs() - p.y;
    let dz = q.z.abs() - p.z;
    let out = (Vec3(dx.max(0.), dy.max(0.), dz.max(0.))).length();
    return out + maxv(dx, maxv(dy, dz)).min(0.);
  }
  if kind == PRIM_CYLINDER {
    let dr = (q.x * q.x + q.z * q.z).sqrt() - p.x;
    let dh = q.y.abs() - p.y;
    let out = (dr.max(0.) * dr.max(0.) + dh.max(0.) * dh.max(0.)).sqrt();
    return maxv(dr, dh).min(0.) + out;
  }
  if kind == PRIM_TORUS {
    let ring = (q.x * q.x + q.z * q.z).sqrt() - p.x;
    return (ring * ring + q.y * q.y).sqrt() - p.y;
  }
  if kind == PRIM_ELLIPSOID {
    let a = Vec3(q.x / p.x, q.y / p.y, q.z / p.z);
    let b = Vec3(q.x / (p.x * p.x), q.y / (p.y * p.y), q.z / (p.z * p.z));
    let k0 = a.length();
    let k1 = b.length();
    if k1 < 0.0000001 { return -minv(p.x, minv(p.y, p.z)); }
    return k0 * (k0 - 1.) / k1;
  }
  // The plane
  q.y
}

pub struct PropSurface {
  pub prims: List[Prim];

  pub fn empty() PropSurface { PropSurface(List[Prim].empty()) }

  pub fn add(self: &mut, kind: u32, placement: Transform3, p: Vec3) { prims.push(Prim(kind, placement, p)); }

  pub fn sphere(self: &mut, centre: Vec3, radius: f32) {
    self.add(PRIM_SPHERE, Transform3(centre, Quat.identity(), Vec3(1., 1., 1.)), Vec3(radius, 0., 0.));
  }

  // A cylinder along the segment 'a' to 'b'
  pub fn cylinder(self: &mut, a: Vec3, b: Vec3, radius: f32) {
    let axis = b - a;
    let q = Quat.fromVectors(Vec3(0., 1., 0.), axis);
    self.add(PRIM_CYLINDER, Transform3((a + b) * 0.5, q, Vec3(1., 1., 1.)), Vec3(radius, axis.length() * 0.5, 0.));
  }

  pub fn capsule(self: &mut, a: Vec3, b: Vec3, radius: f32) {
    let axis = b - a;
    let q = Quat.fromVectors(Vec3(0., 1., 0.), axis);
    self.add(PRIM_CAPSULE, Transform3((a + b) * 0.5, q, Vec3(1., 1., 1.)), Vec3(radius, axis.length() * 0.5, 0.));
  }

  pub fn box(self: &mut, centre: Vec3, rot: Quat, half: Vec3) {
    self.add(PRIM_BOX, Transform3(centre, rot, Vec3(1., 1., 1.)), half);
  }

  // A ring of radius 'major' with tube radius 'minor', its axis along 'axis'
  pub fn torus(self: &mut, centre: Vec3, axis: Vec3, major: f32, minor: f32) {
    let q = Quat.fromVectors(Vec3(0., 1., 0.), axis);
    self.add(PRIM_TORUS, Transform3(centre, q, Vec3(1., 1., 1.)), Vec3(major, minor, 0.));
  }

  pub fn ellipsoid(self: &mut, centre: Vec3, rot: Quat, radii: Vec3) {
    self.add(PRIM_ELLIPSOID, Transform3(centre, rot, Vec3(1., 1., 1.)), radii);
  }

  // The plane through 'point' with outward normal 'n', solid behind it
  pub fn plane(self: &mut, point: Vec3, n: Vec3) {
    self.add(PRIM_PLANE, Transform3(point, Quat.fromVectors(Vec3(0., 1., 0.), n), Vec3(1., 1., 1.)), Vec3(0., 0., 0.));
  }

  // The signed distance to the surface at 'p' (the prop's space)
  pub fn distance(self: &, p: Vec3) f32 {
    var best = 1000000.f;
    var i = 0usize;
    while i < prims.len() {
      let pr = prims[i];
      let inPrim = pr.placement.rotation.conjugate() * (p - pr.placement.translation);
      let d = primDistance(pr.kind, pr.p, inPrim);
      if d < best { best = d; }
      i = i + 1usize;
    }
    best
  }

  // The surface moved by a placement: every primitive placed by 'xf' after its own
  pub fn placed(self: &, xf: Transform3) PropSurface {
    var out = PropSurface.empty();
    var i = 0usize;
    while i < prims.len() {
      let pr = prims[i];
      out.prims.push(Prim(pr.kind, xf * pr.placement, pr.p));
      i = i + 1usize;
    }
    out
  }

  // The surface's gradient (an outward direction) at 'p', by central differences
  pub fn normal(self: &, p: Vec3) Vec3 {
    let e = 0.0005f;
    let dx = self.distance(p + Vec3(e, 0., 0.)) - self.distance(p - Vec3(e, 0., 0.));
    let dy = self.distance(p + Vec3(0., e, 0.)) - self.distance(p - Vec3(0., e, 0.));
    let dz = self.distance(p + Vec3(0., 0., e)) - self.distance(p - Vec3(0., 0., e));
    (Vec3(dx, dy, dz)).normalize()
  }
}
