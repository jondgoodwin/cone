// Forward kinematics of the fingers, the hand's bones, and the stock poses.
//
// FORWARD KINEMATICS. A finger is a chain of three segments from its base
// joint. The base joint turns by SPREAD about the palm's normal, then
// TWIST about the finger's own axis, then bends by FLEXION 0 about the
// finger's bending axis (the rest direction crossed with the palm's normal,
// which turns it towards the palm); the second and third joints bend by
// flexion 1 and 2 about the same axis. In the order the rotations apply to
// the bone: spread * twist * flexion (flexion first, in the bone's own frame),
// so a thumb's twist turns the whole bent thumb about its metacarpal, which is
// how it opposes the fingers. Each segment's end is the next joint: a segment
// is its length along the rest direction, carried by the rotations of the
// joints before it. This is bonepose's forward kinematics exactly (a child's
// transform is its parent's times its own local translation and rotation),
// and 'attachHand' puts the same chain on a skeleton, so a drawn hand and the
// contact solver always agree.
//
// THE STOCK POSES are the standard hand configurations (Napier 1956, "The
// prehensile movements of the human hand"; Cutkosky 1989, "On grasp choice,
// grasp models and the design of hands for manufacturing tasks") as joint
// angles. 'open' and 'closed' pairs make a grip shape (grip.cone): the
// solver closes from one towards the other until the fingers touch the object.
// A free finger's distal joint follows its middle joint by about 2/3 (Lee and
// Kroemer 1991), which the closed poses keep.

pub struct FingerPoints {
  pub joint Array[Vec3, 4];       // the base, the second joint, the third, and the tip
  pub rot Array[Quat, 3];         // each segment's rotation in the hand frame
}

// A finger's local rotations: the base joint's, then the second and third joints'
pub fn fingerRotations(spec &HandSpec, f usize, pose &HandPose) Array[Quat, 3] {
  imm fs = spec.fingers[f];
  imm qSpread = Quat.angleAxis(pose.get(f, SPREAD) * fs.spreadSign * spec.h, spec.palmNormal);
  imm qTwist = Quat.angleAxis(-pose.get(f, TWIST) * spec.h, fs.dir);
  imm q0 = qSpread * qTwist * Quat.angleAxis(pose.get(f, FLEX0), fs.flexAxis);
  imm q1 = Quat.angleAxis(pose.get(f, FLEX1), fs.flexAxis);
  imm q2 = Quat.angleAxis(pose.get(f, FLEX2), fs.flexAxis);
  [q0, q1, q2];
}

// The joints of finger 'f' in a pose, in the hand frame
pub fn fingerPoints(spec &HandSpec, f usize, pose &HandPose) FingerPoints {
  imm fs = spec.fingers[f];
  imm q = fingerRotations(spec, f, pose);
  imm r0 = q[0];
  imm r1 = r0 * q[1];
  imm r2 = r1 * q[2];
  imm j0 = fs.base;
  imm j1 = j0 + r0 * (fs.dir * fs.len[0]);
  imm j2 = j1 + r1 * (fs.dir * fs.len[1]);
  imm j3 = j2 + r2 * (fs.dir * fs.len[2]);
  new FingerPoints([j0, j1, j2, j3], [r0, r1, r2]);
}

// ---- bones ----

// The finger bones on a skeleton
pub struct HandBones {
  pub hand usize;                 // the bone they hang from (the wrist)
  pub bone List[usize];           // five fingers by three bones: finger f's segment k is bone[3 f + k]
  pub tip List[usize];            // each finger's tip socket

  pub fn at(self &, f usize, k usize) usize { *bone[3usize * f + k]; }
}

fn translation(p Vec3) Transform3 { new Transform3(p, Quat.identity(), new Vec3(1., 1., 1.)); }

// Add the fifteen finger bones (and five tip sockets) under 'handBone'
pub fn attachHand(skel &mut Skeleton, handBone usize, spec &HandSpec) HandBones {
  mut out = new HandBones(handBone, List[usize].empty(), List[usize].empty());
  mut f = 0usize;
  while f < FINGERS {
    imm fs = spec.fingers[f];
    imm b0 = skel.addBone(i32.from(handBone), translation(fs.base));
    imm b1 = skel.addBone(i32.from(b0), translation(fs.dir * fs.len[0]));
    imm b2 = skel.addBone(i32.from(b1), translation(fs.dir * fs.len[1]));
    out.bone.push(b0);
    out.bone.push(b1);
    out.bone.push(b2);
    out.tip.push(skel.addSocket(b2, translation(fs.dir * fs.len[2])));
    f = f + 1usize;
  }
  out;
}

// Write a hand pose into a skeleton pose (the finger bones' local rotations)
pub fn applyHandPose(pose &mut Pose, bones &HandBones, spec &HandSpec, hp &HandPose) {
  mut f = 0usize;
  while f < FINGERS {
    imm q = fingerRotations(spec, f, hp);
    pose.setRotation(bones.at(f, 0usize), q[0]);
    pose.setRotation(bones.at(f, 1usize), q[1]);
    pose.setRotation(bones.at(f, 2usize), q[2]);
    f = f + 1usize;
  }
}

// ---- the stock poses ----

fn rad(d f32) f32 { d * pi / 180.; }

// The fingers straight, a little spread, the thumb out
pub fn poseOpen() HandPose {
  HandPose.zero().putFinger(THUMB, rad(30.), rad(8.), rad(5.), rad(0.), rad(10.))
    .putFinger(INDEX, rad(8.), 0., 0., 0., 0.).putFinger(MIDDLE, 0., 0., 0., 0., 0.)
    .putFinger(RING, rad(6.), 0., 0., 0., 0.).putFinger(PINKY, rad(14.), 0., 0., 0., 0.);
}

// The hand at ease: each finger a little more bent than the one before it (the cascade)
pub fn poseRelaxed() HandPose {
  HandPose.zero().putFinger(THUMB, rad(18.), rad(14.), rad(12.), rad(10.), rad(14.))
    .putFinger(INDEX, rad(3.), rad(14.), rad(18.), rad(10.), 0.).putFinger(MIDDLE, 0., rad(20.), rad(26.), rad(14.), 0.)
    .putFinger(RING, rad(2.), rad(26.), rad(32.), rad(18.), 0.).putFinger(PINKY, rad(5.), rad(32.), rad(38.), rad(22.), 0.);
}

// The fingers together and straight, the thumb alongside: the flat hand
pub fn poseFlat() HandPose {
  HandPose.zero().putFinger(THUMB, rad(6.), rad(6.), rad(4.), 0., rad(4.))
    .putFinger(INDEX, 0., 0., 0., 0., 0.).putFinger(MIDDLE, 0., 0., 0., 0., 0.)
    .putFinger(RING, 0., 0., 0., 0., 0.).putFinger(PINKY, rad(2.), 0., 0., 0., 0.);
}

// The fist: every finger bent as far as it goes, the thumb across
pub fn poseFist() HandPose {
  HandPose.zero().putFinger(THUMB, rad(20.), rad(48.), rad(58.), rad(60.), rad(40.))
    .putFinger(INDEX, 0., rad(88.), rad(105.), rad(70.), 0.).putFinger(MIDDLE, 0., rad(90.), rad(108.), rad(72.), 0.)
    .putFinger(RING, 0., rad(90.), rad(108.), rad(72.), 0.).putFinger(PINKY, 0., rad(88.), rad(105.), rad(70.), 0.);
}

// Before a power grip closes: the fingers part and a little bent, the thumb opposed
pub fn posePowerOpen() HandPose {
  HandPose.zero().putFinger(THUMB, rad(60.), rad(10.), rad(10.), rad(8.), 0.)
    .putFinger(INDEX, rad(10.), rad(25.), rad(15.), rad(8.), 0.).putFinger(MIDDLE, rad(2.), rad(28.), rad(18.), rad(10.), 0.)
    .putFinger(RING, rad(4.), rad(30.), rad(20.), rad(10.), 0.).putFinger(PINKY, rad(10.), rad(32.), rad(22.), rad(10.), 0.);
}

// The power grip fully closed (a fist with the thumb wrapped)
pub fn posePowerClosed() HandPose {
  HandPose.zero().putFinger(THUMB, rad(40.), rad(46.), rad(56.), rad(60.), rad(48.))
    .putFinger(INDEX, rad(2.), rad(88.), rad(105.), rad(70.), 0.).putFinger(MIDDLE, 0., rad(90.), rad(108.), rad(72.), 0.)
    .putFinger(RING, rad(2.), rad(90.), rad(108.), rad(72.), 0.).putFinger(PINKY, rad(4.), rad(88.), rad(105.), rad(70.), 0.);
}

// Before a pinch: thumb and index apart and rounded, the others curled out of the way
pub fn posePinchOpen() HandPose {
  HandPose.zero().putFinger(THUMB, rad(30.), rad(22.), rad(14.), rad(6.), rad(34.))
    .putFinger(INDEX, rad(6.), rad(30.), rad(22.), rad(10.), 0.).putFinger(MIDDLE, 0., rad(60.), rad(70.), rad(40.), 0.)
    .putFinger(RING, 0., rad(70.), rad(80.), rad(50.), 0.).putFinger(PINKY, 0., rad(78.), rad(88.), rad(55.), 0.);
}

// A pinch closed to its limit: thumb and index tips brought as far round as they go
pub fn posePinchClosed() HandPose {
  HandPose.zero().putFinger(THUMB, rad(40.), rad(42.), rad(40.), rad(30.), rad(46.))
    .putFinger(INDEX, rad(4.), rad(62.), rad(70.), rad(40.), 0.).putFinger(MIDDLE, 0., rad(60.), rad(70.), rad(40.), 0.)
    .putFinger(RING, 0., rad(70.), rad(80.), rad(50.), 0.).putFinger(PINKY, 0., rad(78.), rad(88.), rad(55.), 0.);
}

// Before a hook: the fingers straight out, the thumb at rest
pub fn poseHookOpen() HandPose {
  HandPose.zero().putFinger(THUMB, rad(22.), rad(10.), rad(8.), rad(6.), rad(12.))
    .putFinger(INDEX, rad(6.), rad(8.), rad(6.), rad(4.), 0.).putFinger(MIDDLE, 0., rad(8.), rad(6.), rad(4.), 0.)
    .putFinger(RING, rad(2.), rad(8.), rad(6.), rad(4.), 0.).putFinger(PINKY, rad(5.), rad(10.), rad(8.), rad(4.), 0.);
}

// The hook closed: the fingers bent at the middle and end joints (the knuckles hardly), the thumb free
pub fn poseHookClosed() HandPose {
  HandPose.zero().putFinger(THUMB, rad(22.), rad(12.), rad(10.), rad(8.), rad(14.))
    .putFinger(INDEX, rad(4.), rad(30.), rad(100.), rad(66.), 0.).putFinger(MIDDLE, 0., rad(32.), rad(104.), rad(68.), 0.)
    .putFinger(RING, rad(2.), rad(34.), rad(106.), rad(70.), 0.).putFinger(PINKY, rad(4.), rad(36.), rad(108.), rad(72.), 0.);
}

// The claw of kneading: the knuckles up, the fingers curled at the tips
pub fn poseClaw() HandPose {
  HandPose.zero().putFinger(THUMB, rad(30.), rad(22.), rad(20.), rad(16.), rad(22.))
    .putFinger(INDEX, rad(6.), rad(34.), rad(60.), rad(34.), 0.).putFinger(MIDDLE, 0., rad(36.), rad(64.), rad(36.), 0.)
    .putFinger(RING, rad(3.), rad(38.), rad(66.), rad(38.), 0.).putFinger(PINKY, rad(8.), rad(40.), rad(68.), rad(38.), 0.);
}
