// The arm: bring the wrist to where a grip needs it.
//
// poseik's 'reachHand' brings the hand bone's GRIP SOCKET to a place and an
// orientation, solving the arm (shoulder, elbow, wrist) with two-bone IK and
// then turning the hand. A grip here is a placement of the hand bone itself (the wrist), so
// 'reachWrist' converts: the socket's target is the wrist's placement carried by
// the socket's own offset on the hand bone, and the call is poseik's.

// Reach with the hand bone ('right' or left) to 'wrist' (model space), the elbow towards 'pole'. 'weight' (0 to 1)
// blends from the pose's own hand to the grip. Returns poseik's result: whether the arm reached, and where the wrist ended.
pub fn reachWrist(skel: &Skeleton, pose: &mut Pose, models: &mut List[Transform3], right: bool, wrist: Transform3, pole: Vec3,
    weight: f32) ReachResult {
  let socket = if right { SOCKET_HAND_R_GRIP } else { SOCKET_HAND_L_GRIP };
  let off = (*skel.sockets[socket]).offset;
  let gripPos = wrist.translation + wrist.rotation * off.translation;
  let gripRot = (wrist.rotation * off.rotation).normalize();
  reachHand(skel, pose, models, right, gripPos, gripRot, pole, weight)
}
