// The closurelib package: closures written in bodies other packages use. A
// closure is a struct the compiler makes from the literal, and a body an
// importer expands (an inline function, a generic's instance) is compiled again
// in the importer's object, so the importer makes the closure's struct again
// from the text the include file carries. This package is the sample of that:
// a closure in an inline function that names a private function, one in a
// generic function with state of its own, one in a function compiled here alone,
// and a generic that is given a closure.

mod closurelib;

// Private: the closure in 'scaled' names it, and so travels with the body
fn base() i64 { 100i64; }

pub fn scaled(x i64, k i64) i64 inline {
  imm f = fn(v i64) i64 { v * k + base(); };
  f(x);
}

pub fn twice[T](v T, n i32) i32 {
  mut calls = fn() [mut c = n] i32 { c += 1; c; };
  calls();
  calls();
}

pub fn plain(n i32) i32 {
  imm g = fn(x i32) i32 { x + n; };
  g(1);
}

// Sum of f over 1..n
pub fn sumOf[F fn(x i64) i64](f &mut F, n i64) i64 {
  mut total = 0i64;
  mut i = 1i64;
  while i <= n {
    total += f(i);
    i += 1i64;
  }
  total;
}

// A callable taken by reference: the signature is a trait the importer's
// closure, struct or plain function meets, and the call dispatches through
// the vtable the importer's object builds
pub fn applyTo(f &<fn(x i64) i64, v i64) i64 { f(v); }

pub fn applyMut(f &<mut fn(x i64) i64, v i64) i64 { f(v); }

// Expanded in the importer's object, with a private function the body names
pub fn applyPlus(f &<fn(x i64) i64, v i64) i64 inline { f(v) + base(); }

// An owner of a callable made here and handed over: the closure's struct is
// compiled in this object, its vtable and its use in the importer's
pub fn counter(start i64) So[fn(x i64) i64] {
  new So[fn(x i64) i64](fn(x i64) [mut at = start] i64 { at += x; at; });
}

// A callable kept in a field, called as the field's name
pub struct Hook {
  pub run So[fn(x i64) i64];
  pub fn fire(self &mut, v i64) i64 { run(v); }
}
