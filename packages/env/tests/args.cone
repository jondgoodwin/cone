// env.args(): this program's arguments, its name first. A test is run with
// none, so the list is the program's name alone, and that name is this test's.
// The arguments beyond ASCII (UTF-8 on Windows whatever the code page) are
// pinned in the process package's tests, which start a child with them and
// read them back through process.args, which is env.args.

mod args;

import testing use *;
import collections use *;
import env;

fn main() i32 {
  let a = env.args();
  expectUInt(u64.from(a.len()), 1u64, "a test is run with no arguments: the name alone");
  require(a.len() >= 1usize, "the program's name is there");
  let me = a[0usize].view();
  expect(me.len > 0usize, "the name is not empty");
  expect(me.contains("args"), "the name is this test's");
  done()
}
