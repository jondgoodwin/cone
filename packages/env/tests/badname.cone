// Setting a variable whose name holds '=' is a program error, and a panic
// at the line of the call, as Rust's 'set_var' panics: .err pins the line.

mod badname;

import stdio use *;
import env;

fn main() i32 {
  printStr("setting a variable named A=B\n");
  env.set("A=B", "x");
  printStr("not reached\n");
  0i32;
}
