// The env package: the program's environment variables, read, set and
// removed. A program it starts inherits them as they are when it starts.
//
//   mod where;
//   import collections use *;
//   import env;
//
//   fn main() {
//     match env.get("CONE_PACKAGES") {
//       case imm v Some { ... v.value.view() ... }
//       case is None { ... }
//     }
//     env.set("CONE_PACKAGES", "C:/cone/packages");
//     env.unset("CONE_PACKAGES");
//   }
//
// A variable not being set is not a failure: 'get' answers None. Setting
// and removing cannot fail but for a program error, a name that is no name
// (empty, or holding '=' or a NUL byte) or a value holding a NUL, which is a
// panic at the caller's line, as Rust's 'set_var' panics; running out of
// memory is a panic too, as everywhere in Cone.
//
// Names and values are bytes, UTF-8 by Cone's convention. The first call
// sets the C library's character type (LC_CTYPE) to UTF-8 when the program
// has left it at "C", as the fs package does, so that on Windows a name or
// value beyond ASCII reaches the environment, and a child, as UTF-8.
//
// Changing the environment while another thread reads it is not safe in C,
// and so not here: set variables before starting threads.
//
// **What is Windows' here.** The package is written over ISO C ('getenv')
// and POSIX ('setenv', 'unsetenv'), whose Windows versions the posix package
// maps onto the C runtime. Windows differs from POSIX in two ways the
// package does not hide:
// - names are compared without regard to ASCII case: 'Path' and 'PATH' are
//   one variable;
// - a variable cannot be set to the empty value through the C runtime:
//   'set(name, "")' removes it, and 'get' then answers None.

mod env;

import libc;
import posix;
import collections use String;

mut utf8Checked = false;

// Make the C runtime read names and values as UTF-8, unless the program
// has chosen a character type of its own. Once is enough.
fn useUtf8() {
  if utf8Checked { return; }
  utf8Checked = true;
  imm now = libc.setlocale(libc.LC_CTYPE, 0usize as *u8);
  if now != 0usize as *u8 and libc.strcmp(now, &[]"C") == 0i32 {
    libc.setlocale(libc.LC_CTYPE, &[]".UTF-8");
  }
}

fn hasByte(s &[]u8, b u8) Bool {
  mut i = 0usize;
  while i < s.len {
    if s[i] == b { return true; }
    i = i + 1usize;
  }
  false;
}

// A name 'getenv' can look up: one with no NUL. One with '=' or none at all
// is simply never set.
fn lookable(name &[]u8) Bool { name.len > 0usize and not hasByte(name, 0u8) and not hasByte(name, '='); }

// Panic, at the line of the caller, unless name can be set
fn checkName(name &[]u8, file &[]u8, line u32) {
  if name.len == 0usize { panic("env: an empty name is no variable's", file, line); }
  if hasByte(name, '=') { panic("env: a variable's name may not hold '='", file, line); }
  if hasByte(name, 0u8) { panic("env: a variable's name may not hold a NUL byte", file, line); }
}

// The variable's value, or None when it is not set
pub fn get(name &[]u8) Option[String] {
  if not lookable(name) { return None[String][]; }
  useUtf8();
  mut c = String.from(name);
  imm v = libc.getenv(c.cstr());
  if v == 0usize as *u8 { return None[String][]; }
  Some[String][String.fromCStr(v)];
}

// Set the variable to value, replacing any value it had. On Windows an
// empty value removes it.
pub fn set(name &[]u8, value &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) {
  checkName(name, file, line);
  if hasByte(value, 0u8) { panic("env: a variable's value may not hold a NUL byte", file, line); }
  useUtf8();
  mut n = String.from(name);
  mut v = String.from(value);
  if posix.setenv(n.cstr(), v.cstr(), 1i32) != 0i32 {
    panic("env: the environment has no room for the variable", file, line);
  }
}

// Remove the variable. One not set is left so.
pub fn unset(name &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) {
  checkName(name, file, line);
  useUtf8();
  mut n = String.from(name);
  if posix.unsetenv(n.cstr()) != 0i32 {
    panic("env: the environment could not remove the variable", file, line);
  }
}
