// The env package: what this process's environment is. The program's
// arguments, and its environment variables, read, set and removed. A program
// it starts inherits the variables as they are when it starts.
//
//   mod config;
//   import collections use *;
//   import env;
//
//   fn main() {
//     let all = env.args();          // List[String]: [0] is the program's name
//     match env.get("CONE_PACKAGES") {
//       case imm v Some { ... v.view() ... }
//       case is None { ... }
//     }
//     env.set("CONE_PACKAGES", "C:/cone/packages");
//     env.unset("CONE_PACKAGES");
//   }
//
// What it has:
//
//   env.args()               this program's arguments, its name first, in UTF-8
//   env.get(name)            the variable's value, an Option[String]
//   env.set(name, value)     set it, replacing any value it had
//   env.unset(name)          remove it
//
// 'args()' answers this program's own arguments, its name first, in UTF-8
// whatever the system's code page, as Windows' parser (CommandLineToArgvW)
// splits its command line: 'main''s argv says the same for ASCII, and loses
// whatever the code page cannot hold. On POSIX they are argv's own bytes,
// read from /proc/self/cmdline (so on POSIX 'args' is Linux's; there is no
// other POSIX system for it yet). 'main(argc, argv)' stays, for C interop; a
// program that only wants its arguments needs no 'process' for them.
//
// A variable not being set is not a failure: 'get' answers None. Setting
// and removing cannot fail but for a program error, a name that is no name
// (empty, or holding '=' or a NUL byte) or a value holding a NUL, or either
// not UTF-8, which is a
// panic at the caller's line, as Rust's 'set_var' panics; running out of
// memory is a panic too, as everywhere in Cone.
//
// Names and values are text ('&str'), UTF-8, whatever locale
// the program has set: a variable inherited beyond ASCII reads as the UTF-8
// of what Windows holds (on POSIX, as the bytes the system holds), and one set
// reaches a child as that.
//
// Changing the environment while another thread reads it is not safe in C,
// and so not here: set variables before starting threads.
//
// **What differs by system.** The package is written over POSIX's 'getenv',
// 'setenv' and 'unsetenv', the posix package's, which on POSIX are the C
// library's own, and whose Windows versions read and change the C runtime's
// wide environment in UTF-8 (the runtime's own narrow 'getenv', libc's, reads
// variables a program inherited in the ANSI code page). Windows differs from
// POSIX in two ways the package does not hide:
// - on Windows names are compared without regard to ASCII case: 'Path' and
//   'PATH' are one variable; on POSIX they are two;
// - on Windows a variable cannot be set to the empty value through the C
//   runtime: 'set(name, "")' removes it, and 'get' then answers None; on POSIX
//   it is set, to the empty text.

mod env;

import libc;
import posix;
import collections use String, List;

// ---------------------------------------------------------------------------
// Windows: the program's own command line, which kernel32 holds and shell32
// splits. The variables are the posix package's.
// ---------------------------------------------------------------------------

extern {
  fn @c(system) WideCharToMultiByte(page: u32, flags: u32, from: *u16, fromLen: i32, to: *u8, toLen: i32,
      fallback: *u8, usedFallback: *i32) i32;
  fn @c(system) GetCommandLineW() *u16;
  fn @c(system) LocalFree(p: *u8) usize;
  fn @c(system) CommandLineToArgvW(line: *u16, count: &mut i32) **u16;
}

const utf8Page = 65001u32;                       // CP_UTF8

// UTF-16 as UTF-8, up to its 0. A lone surrogate, which is no character,
// becomes U+FFFD.
fn narrow(p: *u16) String {
  var out = String();
  let size = WideCharToMultiByte(utf8Page, 0u32, p, -1i32, null, 0i32, null, null);
  if size <= 0i32 { return out; }
  let buf = libc.malloc(usize.from(size));
  WideCharToMultiByte(utf8Page, 0u32, p, -1i32, buf, size, null, null);
  // Counted up to the 0, the 0 is among the bytes
  out.appendBytes(mem.sliceFromParts(buf, usize.from(size) - 1usize));
  libc.free(buf);
  out
}

// This program's arguments on POSIX, its own name first: argv's bytes, which
// the kernel keeps as the NUL-ended strings of /proc/self/cmdline
fn argsPosix() List[String] {
  var out = List[String]();
  let f = libc.fopen("/proc/self/cmdline", "rb");
  if f == null { return out; }
  var whole = String();
  var buf = Array[u8, 4096]() <- fill 0u8;
  let bp: *u8 = &[]buf as *u8;
  var going = true;
  while going {
    let n = libc.fread(bp, 1usize, 4096usize, f);
    if n > 0usize { whole.appendBytes(mem.sliceFromParts(bp, n)); }
    going = n == 4096usize;
  }
  libc.fclose(f);
  var begin = 0usize;
  var i = 0usize;
  while i < whole.len() {
    if whole[i] == 0u8 {
      out.push(whole.sub(begin, i));
      begin = i + 1usize;
    }
    i = i + 1usize;
  }
  out
}

fn argsWindows() List[String] {
  var out = List[String]();
  var n = 0i32;
  let argv = CommandLineToArgvW(GetCommandLineW(), &mut n);
  if argv as usize == 0usize { return out; }
  var i = 0usize;
  let count = usize.from(n);
  while i < count {
    out.push(narrow(*(argv + i)));
    i = i + 1usize;
  }
  LocalFree(argv as *u8);
  out
}

// This program's arguments, its own name first, as Windows' parser
// (CommandLineToArgvW) splits its command line, each in UTF-8, whatever the
// system's code page: what 'main''s argv holds when every one is ASCII
pub fn args() List[String] {
  #if #os == .windows {argsWindows()} #else {argsPosix()}
}

fn hasByte(s: &Array[u8], b: u8) bool {
  var i = 0usize;
  while i < s.len {
    if s[i] == b { return true; }
    i = i + 1usize;
  }
  false
}

// A name 'getenv' can look up: one with no NUL. One with '=' or none at all
// is simply never set.
fn lookable(name: &Array[u8]) bool { name.len > 0usize && !hasByte(name, 0u8) && !hasByte(name, '=') }

// Panic, at the line of the caller, unless name can be set
fn checkName(name: &Array[u8], file: &Array[u8], line: u32) {
  if name.len == 0usize { panic("env: an empty name is no variable's", file, line); }
  if hasByte(name, '=') { panic("env: a variable's name may not hold '='", file, line); }
  if hasByte(name, 0u8) { panic("env: a variable's name may not hold a NUL byte", file, line); }
}

// The variable's value, or None when it is not set
pub fn get(name: &str) Option[String] {
  if !lookable(name) { return None; }
  var c = String.from(name);
  let v = posix.getenv(c.cstr());
  if v == null { return None; }
  Some[String](String.fromCStr(cstr.fromPtr(v)))    // (v is not null)
}

// Set the variable to value, replacing any value it had. On Windows an
// empty value removes it.
pub fn set(name: &str, value: &str, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
  checkName(name, file, line);
  if hasByte(value, 0u8) { panic("env: a variable's value may not hold a NUL byte", file, line); }
  var n = String.from(name);
  var v = String.from(value);
  let r = posix.setenv(n.cstr(), v.cstr(), 1i32);
  if r == posix.EINVAL { panic("env: a variable's name and value must be UTF-8", file, line); }
  if r != 0i32 { panic("env: the environment has no room for the variable", file, line); }
}

// Remove the variable. One not set is left so.
pub fn unset(name: &str, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
  checkName(name, file, line);
  var n = String.from(name);
  let r = posix.unsetenv(n.cstr());
  if r == posix.EINVAL { panic("env: a variable's name must be UTF-8", file, line); }
  if r != 0i32 { panic("env: the environment could not remove the variable", file, line); }
}
