// The client measured over loopback, against a server on a thread of its
// own (httpconn's driver, answering every GET 200 with 64 bytes), plain and
// over TLS (the tls package's test certificates, its test root the
// client's only trust anchor). Run it from the repository's root, in a
// release build:
//
//   congo run --release packages/httpclient/examples/bench.cone
//
// On Linux, raise the descriptor limit first (ulimit -n 65536): part 2's
// thousand connections, both ends in this process, are more than the default
// 1,024. "Private bytes" there are the process's data size (VmData),
// Windows' PrivateUsage here.
//
// 0. One at a time, the server's driver on the client's own Loop: beside
//    httpconn's examples/load.cone ('one thread: 1 connections'), what the
//    client adds to each request.
// 1. Many small GETs: one at a time on a kept connection (warm); 64 at once
//    through six connections, the client's queue holding the rest (warm);
//    one at a time, each on a new connection (cold: the idle one closed
//    before the next, so over TLS each resumes the last's session); and over
//    TLS, each on a new client, a full handshake every time. Latency is from
//    the fetch being asked for to its Done, queueing in the client included.
// 2. Memory per pooled idle connection: a thousand plain connections (and
//    two hundred TLS ones) opened by as many GETs at once, then left idle;
//    the process's private bytes and the pool's buffers before and after,
//    both ends of each connection being in this process.

mod bench;

import stdio use *;
import libc;
import thread;
import sync use *;
import fs;
import path use Path;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, SocketAddr, forever;
import diag use Histogram;
import http use *;
import httpconn;
import tls;
import httpclient use *;

extern {
  fn @c(system) GetCurrentProcess() usize;
  fn @c(system) K32GetProcessMemoryInfo(process: usize, counters: *u8, cb: u32) i32;
}

// The bytes the process has committed for itself: Windows' PrivateUsage
// (PROCESS_MEMORY_COUNTERS_EX), Linux's data size (VmData)
fn privateBytes() u64 {
  if isWindows() {
    var c = Array[usize, 10]() <- fill 0usize;
    let p = &mut c as *u8;
    *(p as *u32) = 80u32;
    K32GetProcessMemoryInfo(GetCurrentProcess(), p, 80u32);
    u64.from(c[9usize])
  } else {
    dataBytes()
  }
}

// Linux: the sixth number of /proc/self/statm (size resident shared text lib
// data dt), in 4096-byte pages: the process's writable private memory
fn dataBytes() u64 {
  let f = libc.fopen("/proc/self/statm", "rb");
  if f == null {return 0u64;}
  var buf = Array[u8, 256]() <- fill 0u8;
  let bp: *u8 = &[]buf as *u8;
  let n = libc.fread(bp, 1usize, 255usize, f);
  libc.fclose(f);
  var field = 0u32;
  var value = 0u64;
  var k = 0usize;
  while k < n {
    let c = buf[k];
    if c >= '0' && c <= '9' {
      if field == 5u32 {value = value * 10u64 + u64.from(c - '0');}
    } else {
      field = field + 1u32;
    }
    k = k + 1usize;
  }
  value * 4096u64
}

fn certs(name: &str) Path {
  var p = String.from("packages/tls/tests/certs/");
  p.append(name);
  Path.fromString(p)
}

fn readText(name: &str) String {
  var out = String.empty();
  let file = certs(name);
  match fs.readFile(&file) {
    case var Ok(r) {out <-> r;}
    case let Error(e) {}
  }
  out
}

// ---------------------------------------------------------------------------
// The server, on a thread of its own
// ---------------------------------------------------------------------------

struct TlsMaker {
  server: tls.Server;

  pub fn make(self: &mut) Uni[httpconn.Layer] {Uni[tls.Stream](server.stream())}
}

struct ServerArgs {
  pub portTx: Sender[u16];
  pub stop: Arc[imm, Atomic[bool]];
}

fn portOf(drv: &mut httpconn.Driver, lp: &Loop, r: Result[httpconn.ListenerId, iocore.IoError]) u16 {
  var port = 0u16;
  match r {
    case let Ok(l) {
      match drv.localAddr(lp, l) {
        case let Ok(a) {port = a.port();}
        case let Error(e) {}
      }
    }
    case let Error(e) {}
  }
  port
}

fn serveThread(a: ServerArgs) u64 {
  setLimits(268435456usize, 268435456usize);
  var lp = Loop.mustMake();
  var cfg = httpconn.Config.make();
  cfg.acceptDepth = 64u32;
  var drv = httpconn.Driver.make(cfg);
  let plain = drv.listen(&mut lp, SocketAddr.localhost(0u16), httpconn.Sink.Here(1u64));
  a.portTx.send(portOf(&mut drv, &lp, plain));
  let serverPem = certs("server.pem");
  let serverKey = certs("server.key");
  match tls.Server.make(tls.ServerConfig.make(&serverPem, &serverKey)) {
    case let Ok(s) {
      let secure = drv.listenWith(&mut lp, SocketAddr.localhost(0u16), Uni[TlsMaker](TlsMaker(s)),
        httpconn.Sink.Here(1u64));
      a.portTx.send(portOf(&mut drv, &lp, secure));
    }
    case let Error(e) {
      printStr(e.message().view());
      printStr(" (run from the repository's root)\n");
      a.portTx.send(0u16);
    }
  }
  var evs = List[httpconn.Event].empty();
  var served = 0u64;
  while !a.stop.load() {
    drv.poll(&mut lp, Instant.now() + Duration.fromMillis(20i64), &mut evs);
    var k = 0usize;
    while k < evs.len() {
      let e = &mut evs[k];
      if e.kind == httpconn.EventKind.Request {
        drv.respond(e.req, ResponseHead.make(200u16), BodyLength.sized(64u64));
        var b = IoBuf(64usize);
        b.setLen(64usize);
        drv.sendData(e.req, b);
        drv.finish(e.req);
        served = served + 1u64;
      }
      k = k + 1usize;
    }
    evs.clear();
  }
  drv.abortAll(&mut lp);
  drv.pump(&mut lp, &mut evs);
  served
}

// ---------------------------------------------------------------------------
// The GETs
// ---------------------------------------------------------------------------

struct Run {
  pub n: u64;
  pub lat: Histogram;
  pub done: u64;
  pub bad: u64;
  pub took: Duration;
  pub sent: u64;
  pub reused: u64;
}

// n GETs of base, 'inFlight' asked for at a time; 'cold': every idle
// connection closed before the next is asked for
fn gets(cl: &mut Client, lp: &mut Loop, base: &str, n: u64, inFlight: u64, cold: bool) Run {
  var run = Run(n, Histogram.make(), 0u64, 0u64, Duration.zero(), 0u64, 0u64);
  let s0 = cl.stats();
  var asked = 0u64;
  var out = List[Event].empty();
  let t0 = Instant.now();
  while run.done + run.bad < n {
    while asked < n && asked - run.done - run.bad < inFlight {
      if cold {cl.closeIdle(lp);}
      cl.get(lp, base, Sink.Here(1u64));
      asked = asked + 1u64;
    }
    cl.poll(lp, forever(), &mut out);
    var k = 0usize;
    while k < out.len() {
      let e = &mut out[k];
      k = k + 1usize;
      if e.kind == EventKind.Data {cl.release(e.id, e.buf.len());}
      else if e.kind == EventKind.Done {
        run.done = run.done + 1u64;
        run.lat.record((e.timing.ended - e.timing.queued).nanos());
      } else if e.isTerminal() {
        run.bad = run.bad + 1u64;
        if run.bad < 4u64 {
          printStr("  failed: ");
          printStr(e.failure.message().view());
          printStr("\n");
        }
      }
    }
    out.clear();
  }
  run.took = Instant.now() - t0;
  let s1 = cl.stats();
  run.sent = s1.sent - s0.sent;
  run.reused = s1.reused - s0.reused;
  run
}

fn report(label: &str, r: &Run) {
  printStr(label);
  printStr(": ");
  printUInt(r.done);
  printStr(" GETs in ");
  printUInt(u64.from(r.took.millis()));
  printStr(" ms, ");
  if r.took.nanos() > 0i64 {printUInt(u64.from(i64.from(r.done) * 1000000000i64 / r.took.nanos()));}
  printStr(" a second; ");
  printUInt(r.reused);
  printStr(" of ");
  printUInt(r.sent);
  printStr(" on a kept connection");
  if r.bad > 0u64 {
    printStr(", ");
    printUInt(r.bad);
    printStr(" NOT DONE");
  }
  printStr("\n  ");
  r.lat.printLine("latency, asked to Done");
}

fn tlsConfig() Config {
  var cfg = Config.make();
  cfg.tlsConfig.verify = tls.Verifier.roots(readText("ca.pem").view());
  cfg.tlsConfig.offline = true;
  cfg
}

// A full handshake every time: each GET on a client of its own
fn freshClients(lp: &mut Loop, base: &str, n: u64) Run {
  var run = Run(n, Histogram.make(), 0u64, 0u64, Duration.zero(), 0u64, 0u64);
  let t0 = Instant.now();
  var k = 0u64;
  while k < n {
    var cl = Client.make(tlsConfig());
    let r = gets(&mut cl, lp, base, 1u64, 1u64, false);
    run.done = run.done + r.done;
    run.bad = run.bad + r.bad;
    run.lat.merge(&r.lat);
    run.sent = run.sent + r.sent;
    cl.abortAll(lp);
    var out = List[Event].empty();
    cl.pump(lp, &mut out);
    k = k + 1u64;
  }
  run.took = Instant.now() - t0;
  run
}

// One at a time with the server on the client's own Loop and thread (its
// driver handed its completions), to set beside httpconn's own one-thread
// measurement: what the client adds to each request
fn sameLoop(n: u64) Run {
  var lp = Loop.mustMake();
  var sdrv = httpconn.Driver.make(httpconn.Config.make());
  let l = sdrv.listen(&mut lp, SocketAddr.localhost(0u16), httpconn.Sink.Here(1u64));
  let port = portOf(&mut sdrv, &lp, l);
  var base = String.from("http://127.0.0.1:");
  base.appendUInt(u64.from(port));
  base.append("/x");
  var cl = Client.make(Config.make());
  var run = Run(n, Histogram.make(), 0u64, 0u64, Duration.zero(), 0u64, 0u64);
  var out = List[Event].empty();
  var sevs = List[httpconn.Event].empty();
  var comps = List[iocore.Completion].empty();
  var busy = false;
  var t0 = Instant.now();
  var total = 0u64;
  while total < n + 100u64 {
    if !busy {
      cl.get(&mut lp, base.view(), Sink.Here(1u64));
      busy = true;
    }
    cl.pump(&mut lp, &mut out);
    sdrv.pump(&mut lp, &mut sevs);
    var limit = cl.wakeAt();
    let w = sdrv.wakeAt();
    if w < limit {limit = w;}
    if out.len() > 0usize || sevs.len() > 0usize {limit = Instant();}
    lp.poll(limit, &mut comps);
    var k = 0usize;
    while k < comps.len() {
      let c = &mut comps[k];
      if !cl.complete(&mut lp, c) {sdrv.complete(&mut lp, c);}
      k = k + 1usize;
    }
    comps.clear();
    sdrv.pump(&mut lp, &mut sevs);
    k = 0usize;
    while k < sevs.len() {
      let e = &mut sevs[k];
      if e.kind == httpconn.EventKind.Request {
        sdrv.respond(e.req, ResponseHead.make(200u16), BodyLength.sized(64u64));
        var b = IoBuf(64usize);
        b.setLen(64usize);
        sdrv.sendData(e.req, b);
        sdrv.finish(e.req);
      }
      k = k + 1usize;
    }
    sevs.clear();
    cl.pump(&mut lp, &mut out);
    k = 0usize;
    while k < out.len() {
      let e = &mut out[k];
      k = k + 1usize;
      if e.kind == EventKind.Data {cl.release(e.id, e.buf.len());}
      else if e.isTerminal() {
        busy = false;
        total = total + 1u64;
        // The first hundred warm it
        if total == 100u64 {t0 = Instant.now();}
        if total > 100u64 {
          if e.kind == EventKind.Done {
            run.done = run.done + 1u64;
            run.lat.record((e.timing.ended - e.timing.queued).nanos());
          } else {
            run.bad = run.bad + 1u64;
          }
        }
      }
    }
    out.clear();
  }
  run.took = Instant.now() - t0;
  run.sent = n;
  run.reused = n;
  cl.abortAll(&mut lp);
  sdrv.abortAll(&mut lp);
  cl.pump(&mut lp, &mut out);
  sdrv.pump(&mut lp, &mut sevs);
  run
}

// ---------------------------------------------------------------------------
// Memory per pooled idle connection
// ---------------------------------------------------------------------------

fn settle(cl: &mut Client, lp: &mut Loop) {
  var out = List[Event].empty();
  let until = Instant.now() + Duration.fromMillis(300i64);
  while Instant.now() < until {
    cl.poll(lp, until, &mut out);
    out.clear();
  }
}

// n GETs at once, their connections then left idle in the pool: the
// memory that took, printed
fn fill(cl: &mut Client, lp: &mut Loop, base: &str, n: u32, label: &str) {
  trim();
  let before = privateBytes();
  let lentBefore = stats().heldBytes - stats().idleBytes;
  let r = gets(cl, lp, base, u64.from(n), u64.from(n), false);
  settle(cl, lp);
  trim();
  let after = privateBytes();
  let lentAfter = stats().heldBytes - stats().idleBytes;
  printStr(label);
  printStr(": ");
  printUInt(u64.from(cl.stats().idleNow));
  printStr(" pooled idle connections (");
  printUInt(r.done);
  printStr(" GETs Done): private bytes +");
  printUInt((after - before) / 1024u64);
  printStr(" KiB, ");
  printUInt((after - before) / u64.from(n));
  printStr(" bytes a connection, both its ends; pool buffers lent +");
  printUInt(u64.from(lentAfter - lentBefore) / u64.from(n));
  printStr(" bytes a connection\n");
}

// Twice: first with the client's and the drivers' tables grown for them
// (the connections' records, and the requests' for n at once), then again
// with those tables already grown, their records reused
fn idleMemory(lp: &mut Loop, base: &str, n: u32, secure: bool) {
  var cfg = if secure {tlsConfig()} else {Config.make()};
  cfg.maxPerOrigin = n;
  cfg.maxTotal = n;
  var cl = Client.make(cfg);
  // Warm: the pool's first blocks, a few records
  {
    var w = gets(&mut cl, lp, base, 64u64, 64u64, false);
  }
  cl.closeIdle(lp);
  settle(&mut cl, lp);
  fill(&mut cl, lp, base, n, if secure {"TLS, tables grown for them"} else {"plain, tables grown for them"});
  cl.closeIdle(lp);
  settle(&mut cl, lp);
  fill(&mut cl, lp, base, n, if secure {"TLS, tables already grown"} else {"plain, tables already grown"});
  var out = List[Event].empty();
  cl.abortAll(lp);
  cl.pump(lp, &mut out);
}

fn main() i32 {
  var portTx: Sender[u16];
  var portRx: Receiver[u16];
  portTx, portRx = Channel[u16].make();
  let stop = Arc[imm, Atomic[bool]](Atomic[bool].of(false));
  let srv = thread.start(ServerArgs(portTx, stop), &serveThread);
  var plain = 0u16;
  var secure = 0u16;
  match portRx.recv() {
    case let Some(p) {plain = p;}
    case is None[u16] {}
  }
  match portRx.recv() {
    case let Some(p) {secure = p;}
    case is None[u16] {}
  }
  if plain == 0u16 || secure == 0u16 {return 1i32;}
  var plainUrl = String.from("http://127.0.0.1:");
  plainUrl.appendUInt(u64.from(plain));
  plainUrl.append("/x");
  var secureUrl = String.from("https://127.0.0.1:");
  secureUrl.appendUInt(u64.from(secure));
  secureUrl.append("/x");
  setLimits(268435456usize, 268435456usize);
  var lp = Loop.mustMake();
  printStr(tls.backendVersion() as &str);
  printStr("\n");
  let one = sameLoop(20000u64);
  report("plain, one thread (server on the client's loop), one at a time", &one);

  {
    var cl = Client.make(Config.make());
    gets(&mut cl, &mut lp, plainUrl.view(), 1000u64, 1u64, false);
    let a = gets(&mut cl, &mut lp, plainUrl.view(), 20000u64, 1u64, false);
    report("plain, warm, one at a time", &a);
    let b = gets(&mut cl, &mut lp, plainUrl.view(), 50000u64, 64u64, false);
    report("plain, warm, 64 at once over 6 connections", &b);
    let c = gets(&mut cl, &mut lp, plainUrl.view(), 2000u64, 1u64, true);
    report("plain, cold: a new connection each", &c);
    cl.abortAll(&mut lp);
  }
  {
    var cl = Client.make(tlsConfig());
    gets(&mut cl, &mut lp, secureUrl.view(), 500u64, 1u64, false);
    let a = gets(&mut cl, &mut lp, secureUrl.view(), 20000u64, 1u64, false);
    report("TLS, warm, one at a time", &a);
    let b = gets(&mut cl, &mut lp, secureUrl.view(), 50000u64, 64u64, false);
    report("TLS, warm, 64 at once over 6 connections", &b);
    let c = gets(&mut cl, &mut lp, secureUrl.view(), 1000u64, 1u64, true);
    report("TLS, cold: a new connection each, its session resumed", &c);
    cl.abortAll(&mut lp);
  }
  let f = freshClients(&mut lp, secureUrl.view(), 300u64);
  report("TLS, cold: a new client each, a full handshake", &f);

  idleMemory(&mut lp, plainUrl.view(), 1000u32, false);
  idleMemory(&mut lp, secureUrl.view(), 200u32, true);

  stop.store(true);
  srv.join();
  0i32
}
