// Retries and redirects, against a loopback server on the client's Loop.
// Retries: a GET whose connection is reset before any response is sent
// again and answered; a POST in the same plight is not (its method is not
// idempotent), nor is it once a response has begun; a PUT is (idempotent);
// a server that always resets gets maxRetries + 1 attempts, then Failed.
// Redirects: a chain of three followed on one kept connection, its
// Response the last one's with the URL that gave it; the limit (the
// request's own, and the config's 10), and 0 delivering the 3xx itself; 303
// and 301 make a POST a GET without its body; 307 keeps the method and
// body; credentials kept within an origin and dropped across origins; a
// Location that cannot be followed, and a 3xx with none.

mod retry;

import testing use *;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, SocketAddr, Completion, forever;
import http use *;
import httpconn;
import httpclient use *;

// ---------------------------------------------------------------------------
// The loopback server: httpconn's own driver on the client's Loop. What it
// answers is chosen by the request's path:
//   /hello             200 "hello" (and any path not below)
//   /echo              200, the method, a space, and the request's body
//   /nobody            204
//   /close             no answer: the connection is reset
//   /closeonce         the first time, as /close; after, 200 "second"
//   /redirect/N        302 to /redirect/N-1; /redirect/0 is 200 "landed"
//   /status/C?L        status C, Location L when L is given, body "moved"
//   /headers           200 "auth=A;cookie=C;method=M;body=B" ('-' for none)
//   /big/N             200, N bytes, byte i being i % 251, sent as taken
//   /stall             200 with 1 MiB to come; 64 KiB of it sent, then nothing
//   /hang              nothing at all
//   /order/L           200 L
// Every request's target is kept in 'order', in the order they came.
// ---------------------------------------------------------------------------

const tokSrv = 100u64;

struct Srv {
  pub drv httpconn.Driver;
  pub pool Pool;
  pub accepted u64;
  pub open u64;
  pub maxOpen u64;
  pub requests u64;
  pub closedOnce bool;
  pub order List[String];
  pub reqs List[httpconn.ReqId];
  pub conns List[httpconn.ConnId];
  pub methods List[Method];
  pub targets List[String];
  pub bodies List[String];
  pub auths List[String];
  pub cookies List[String];
  pub streams List[httpconn.ReqId];
  pub sent List[u64];
  pub totals List[u64];
}

fn server(pool Pool) Srv {
  new Srv(drv: httpconn.Driver.make(httpconn.Config.make(), pool), pool: pool, accepted: 0u64,
    open: 0u64, maxOpen: 0u64, requests: 0u64, closedOnce: false, order: List[String].empty(),
    reqs: List[httpconn.ReqId].empty(), conns: List[httpconn.ConnId].empty(), methods: List[Method].empty(),
    targets: List[String].empty(), bodies: List[String].empty(), auths: List[String].empty(),
    cookies: List[String].empty(), streams: List[httpconn.ReqId].empty(), sent: List[u64].empty(),
    totals: List[u64].empty());
}

fn listen(sv &mut Srv, lp &mut Loop) u16 {
  mut port = 0u16;
  match sv.drv.listen(lp, SocketAddr.localhost(0u16), httpconn.Sink.Here[tokSrv]) {
    case imm r Ok {
      match sv.drv.localAddr(lp, r) {
        case imm a Ok {port = a.port();}
        case imm e Error {}
      }
    }
    case imm e Error {}
  }
  port;
}

fn reply(sv &mut Srv, req httpconn.ReqId, head bool, status u16, location &Array[u8], body &Array[u8]) {
  mut h = ResponseHead.make(status);
  if location.len > 0usize {h.headers.add("Location", location);}
  sv.drv.respond(req, h, BodyLength.sized(u64.from(body.len)));
  if body.len > 0usize and not head {
    mut b = sv.pool.mustTake(body.len);
    b.append(body);
    sv.drv.sendData(req, b);
    sv.drv.finish(req);
  }
}

fn number(s &str) u64 {
  match collections.parseUInt(s) {
    case imm v Some {v;}
    case is None[u64] {0u64;}
  }
}

// Stream j's next pieces, as many as the connection takes now
fn pumpStream(sv &mut Srv, j usize) {
  imm req = *sv.streams[j];
  while *sv.sent[j] < *sv.totals[j] {
    imm at = *sv.sent[j];
    imm left = *sv.totals[j] - at;
    imm n = if left < 65536u64 {usize.from(left);} else {65536usize;};
    mut b = sv.pool.mustTake(n);
    imm s = b.spare();
    mut i = 0usize;
    while i < n {
      s[i] = u8.from((at + u64.from(i)) % 251u64);
      i = i + 1usize;
    }
    b.setLen(n);
    match sv.drv.sendData(req, b) {
      case is None[IoBuf] {sv.sent.set(j, at + u64.from(n));}
      else {return;}
    }
  }
  sv.drv.finish(req);
  dropStream(sv, j);
}

fn dropStream(sv &mut Srv, j usize) {
  imm last = sv.streams.len() - 1usize;
  sv.streams.swap(j, last);
  sv.sent.swap(j, last);
  sv.totals.swap(j, last);
  sv.streams.pop();
  sv.sent.pop();
  sv.totals.pop();
}

fn findStream(sv &Srv, req httpconn.ReqId) usize {
  mut j = 0usize;
  while j < sv.streams.len() {
    if *sv.streams[j] == req {return j;}
    j = j + 1usize;
  }
  sv.streams.len();
}

// The answer to request k, read whole
fn answer(sv &mut Srv, lp &mut Loop, k usize) {
  imm req = *sv.reqs[k];
  imm full = sv.targets[k].copy();
  imm t = full.view();
  mut q = 0usize;
  while q < t.len and t[q] != '?' {q = q + 1usize;}
  imm path = &t[0usize .. q];
  imm query = &t[(if q < t.len {q + 1usize;} else {q;}) ..];
  imm head = *sv.methods[k] == Method.Head[];
  if path == "/echo" {
    mut b = String.from(methodToken(*sv.methods[k]));
    b.append(" ");
    b.append(sv.bodies[k].view());
    reply(sv, req, head, 200u16, "", b.view());
  } elif path == "/nobody" {
    reply(sv, req, head, 204u16, "", "");
  } elif path == "/close" {
    sv.drv.abort(lp, *sv.conns[k]);
  } elif path == "/closeonce" {
    if not sv.closedOnce {
      sv.closedOnce = true;
      sv.drv.abort(lp, *sv.conns[k]);
    } else {
      reply(sv, req, head, 200u16, "", "second");
    }
  } elif path.len > 10usize and &path[0usize .. 10usize] == "/redirect/" {
    imm n = number(&path[10usize ..]);
    if n == 0u64 {
      reply(sv, req, head, 200u16, "", "landed");
    } else {
      mut loc = String.from("/redirect/");
      loc.appendUInt(n - 1u64);
      reply(sv, req, head, 302u16, loc.view(), "moved");
    }
  } elif path.len > 8usize and &path[0usize .. 8usize] == "/status/" {
    reply(sv, req, head, u16.from(number(&path[8usize ..])), query, "moved");
  } elif path == "/headers" {
    mut b = String.from("auth=");
    b.append(sv.auths[k].view());
    b.append(";cookie=");
    b.append(sv.cookies[k].view());
    b.append(";method=");
    b.append(methodToken(*sv.methods[k]));
    b.append(";body=");
    b.append(if sv.bodies[k].len() == 0usize {"-";} else {sv.bodies[k].view();});
    reply(sv, req, head, 200u16, "", b.view());
  } elif path.len > 5usize and &path[0usize .. 5usize] == "/big/" {
    imm n = number(&path[5usize ..]);
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(n));
    sv.streams.push(req);
    sv.sent.push(0u64);
    sv.totals.push(n);
    pumpStream(sv, sv.streams.len() - 1usize);
  } elif path == "/stall" {
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(1048576u64));
    mut b = sv.pool.mustTake(65536usize);
    b.setLen(65536usize);
    sv.drv.sendData(req, b);
  } elif path == "/hang" {
  } elif path.len > 7usize and &path[0usize .. 7usize] == "/order/" {
    reply(sv, req, head, 200u16, "", &path[7usize ..]);
  } else {
    reply(sv, req, head, 200u16, "", "hello");
  }
}

fn findReq(sv &Srv, req httpconn.ReqId) usize {
  mut k = 0usize;
  while k < sv.reqs.len() {
    if *sv.reqs[k] == req {return k;}
    k = k + 1usize;
  }
  sv.reqs.len();
}

fn forget(sv &mut Srv, k usize) {
  imm last = sv.reqs.len() - 1usize;
  sv.reqs.swap(k, last);
  sv.conns.swap(k, last);
  sv.methods.swap(k, last);
  sv.targets.swap(k, last);
  sv.bodies.swap(k, last);
  sv.auths.swap(k, last);
  sv.cookies.swap(k, last);
  sv.reqs.pop();
  sv.conns.pop();
  sv.methods.pop();
  sv.targets.pop();
  sv.bodies.pop();
  sv.auths.pop();
  sv.cookies.pop();
}

fn fieldOr(h &Headers, name &str) String {
  match h.get(name) {
    case imm v Some {String.fromBytes(v);}
    case is None[&Array[u8]] {String.from("-");}
  }
}

fn serve(sv &mut Srv, lp &mut Loop, e &mut httpconn.Event) {
  imm kind = e.kind;
  if kind == httpconn.EventKind.Accepted[] {
    sv.accepted = sv.accepted + 1u64;
    sv.open = sv.open + 1u64;
    if sv.open > sv.maxOpen {sv.maxOpen = sv.open;}
  } elif kind == httpconn.EventKind.Closed[] {
    sv.open = sv.open - 1u64;
  } elif kind == httpconn.EventKind.Request[] {
    sv.requests = sv.requests + 1u64;
    sv.order.push(e.request.target.copy());
    sv.reqs.push(e.req);
    sv.conns.push(e.conn);
    sv.methods.push(e.request.method);
    sv.targets.push(e.request.target.copy());
    sv.bodies.push(String.empty());
    sv.auths.push(fieldOr(&e.request.headers, "Authorization"));
    sv.cookies.push(fieldOr(&e.request.headers, "Cookie"));
  } elif kind == httpconn.EventKind.Data[] {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {(&mut sv.bodies[k]).appendBytes(e.buf.view());}
    sv.drv.release(e.req, e.buf.len());
  } elif kind == httpconn.EventKind.End[] {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {answer(sv, lp, k);}
  } elif kind == httpconn.EventKind.Writable[] {
    imm j = findStream(sv, e.req);
    if j < sv.streams.len() {pumpStream(sv, j);}
  } elif e.isTerminal() {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {forget(sv, k);}
    imm j = findStream(sv, e.req);
    if j < sv.streams.len() {dropStream(sv, j);}
  }
}

// One turn of the loop: the client's completions to it, the server's to
// its driver; the server's events answered; the client's appended to out
fn step(cl &mut Client, sv &mut Srv, lp &mut Loop, out &mut List[Event], until Instant) {
  mut sevs = List[httpconn.Event].empty();
  cl.pump(lp, out);
  sv.drv.pump(lp, &mut sevs);
  mut limit = until;
  imm a = cl.wakeAt();
  if a < limit {limit = a;}
  imm b = sv.drv.wakeAt();
  if b < limit {limit = b;}
  if out.len() > 0usize or sevs.len() > 0usize {limit = new Instant();}
  mut comps = List[Completion].empty();
  lp.poll(limit, &mut comps);
  mut k = 0usize;
  while k < comps.len() {
    imm c = &mut comps[k];
    if not cl.complete(lp, c) {sv.drv.complete(lp, c);}
    k = k + 1usize;
  }
  comps.clear();
  sv.drv.pump(lp, &mut sevs);
  k = 0usize;
  while k < sevs.len() {
    serve(sv, lp, &mut sevs[k]);
    k = k + 1usize;
  }
  cl.pump(lp, out);
}

// The server's every connection reset, and its buffers home
fn stopServer(sv &mut Srv, lp &mut Loop) {
  sv.drv.abortAll(lp);
  mut sevs = List[httpconn.Event].empty();
  sv.drv.pump(lp, &mut sevs);
}

fn url(port u16, path &str) String {
  mut u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u;
}

// ---------------------------------------------------------------------------
// What the client saw
// ---------------------------------------------------------------------------

struct Seen {
  pub status u16;
  pub body String;
  pub url String;
  pub kinds String;          // each event's kind's first letter, in order
  pub finals u64;
  pub last EventKind;
  pub failure String;
  pub stage Stage;
  pub timing Timing;
}

fn seen() Seen {
  new Seen(status: 0u16, body: String.empty(), url: String.empty(), kinds: String.empty(), finals: 0u64,
    last: EventKind.Done[], failure: String.empty(), stage: Stage.Url[], timing: Timing.zero());
}

fn note(cl &mut Client, s &mut Seen, e &mut Event) {
  imm n = eventName(e.kind);
  s.kinds.appendByte(n[0usize]);
  if e.kind == EventKind.Response[] {
    s.status = e.response.status;
    s.url = e.url.copy();
  } elif e.kind == EventKind.Data[] {
    s.body.appendBytes(e.buf.view());
    cl.release(e.id, e.buf.len());
  } elif e.isTerminal() {
    s.finals = s.finals + 1u64;
    s.last = e.kind;
    s.timing = e.timing;
    if e.kind == EventKind.Failed[] {
      s.failure = e.failure.message();
      s.stage = e.failure.stage;
    }
  }
}

// Drive until fetch id has its final answer, its events noted in s
fn finishOf(cl &mut Client, sv &mut Srv, lp &mut Loop, id FetchId, s &mut Seen) {
  mut out = List[Event].empty();
  imm giveUp = Instant.now() + Duration.fromSeconds(10i64);
  imm before = s.finals;
  while s.finals == before and Instant.now() < giveUp {
    step(cl, sv, lp, &mut out, giveUp);
    mut k = 0usize;
    while k < out.len() {
      imm e = &mut out[k];
      if e.id == id {note(cl, s, e);}
      k = k + 1usize;
    }
    out.clear();
  }
  requireUInt(s.finals, before + 1u64, "the fetch has its final answer in time");
}

// A request sent and driven to its final answer: what was seen
fn fetchSeen(cl &mut Client, sv &mut Srv, lp &mut Loop, r Request) Seen {
  mut s = seen();
  imm id = cl.send(lp, r, Sink.Here[1u64]);
  finishOf(cl, sv, lp, id, &mut s);
  s;
}

// Drive for a while
fn idleFor(cl &mut Client, sv &mut Srv, lp &mut Loop, d Duration) {
  mut out = List[Event].empty();
  imm until = Instant.now() + d;
  while Instant.now() < until {
    step(cl, sv, lp, &mut out, until);
    mut k = 0usize;
    while k < out.len() {
      imm e = &mut out[k];
      if e.kind == EventKind.Data[] {cl.release(e.id, e.buf.len());}
      k = k + 1usize;
    }
    out.clear();
  }
}

fn main() i32 {
  imm pool = Pool.make();
  mut lp = Loop.mustMake();
  mut sv = server(pool);
  imm port = listen(&mut sv, &mut lp);
  imm port2 = listen(&mut sv, &mut lp);
  require(port != 0u16 and port2 != 0u16, "the server listens on two ports: two origins");
  mut cl = Client.make(Config.make(), pool);

  // ---- Retries ----
  // A GET reset before its response: sent again on a new connection
  sv.closedOnce = false;
  imm g = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(port, "/closeonce").view()));
  expect(g.last == EventKind.Done[], "GET reset once: Done");
  expectStr(g.body.view(), "second", "...answered the second time");
  expectUInt(u64.from(g.timing.attempts), 2u64, "...two attempts");
  expectStr(g.kinds.view(), "RDED", "...and only the answer's events");
  expectUInt(cl.stats().retries, 1u64, "stats: one retry");

  // A POST in the same plight: not sent again
  sv.closedOnce = false;
  mut post = Request.make("POST", url(port, "/closeonce").view());
  post.body = String.from("once only");
  imm p = fetchSeen(&mut cl, &mut sv, &mut lp, post);
  expect(p.last == EventKind.Failed[], "POST reset: Failed");
  expect(p.stage == Stage.Read[] or p.stage == Stage.Closed[], "...the connection reset under it");
  expectUInt(u64.from(p.timing.attempts), 1u64, "...one attempt, no retry");
  expectUInt(cl.stats().retries, 1u64, "stats: still one retry");

  // A PUT is idempotent: sent again
  sv.closedOnce = false;
  mut put = Request.make("PUT", url(port, "/closeonce").view());
  put.body = String.from("twice is once");
  imm u = fetchSeen(&mut cl, &mut sv, &mut lp, put);
  expect(u.last == EventKind.Done[] and u.timing.attempts == 2u32, "PUT reset once: Done on its second attempt");

  // A server that always resets: maxRetries (2) retries, then Failed
  imm before = sv.requests;
  imm a = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(port, "/close").view()));
  expect(a.last == EventKind.Failed[], "always reset: Failed");
  expectUInt(u64.from(a.timing.attempts), 3u64, "...after three attempts");
  expectUInt(sv.requests - before, 3u64, "...the server saw three");
  expect(a.failure.startsWith("read: closed: a receive failed") or a.failure.startsWith("closed: closed:"),
    "...the connection's failure");

  // Never once a response has begun: a body cut off mid-way is not retried
  imm before2 = sv.requests;
  mut stall = Request.get(url(port, "/stall").view());
  stall.deadline = Instant.now() + Duration.fromMillis(100i64);
  imm st = fetchSeen(&mut cl, &mut sv, &mut lp, stall);
  expect(st.last == EventKind.TimedOut[], "a stalled body: TimedOut at its deadline");
  expectUInt(sv.requests - before2, 1u64, "...sent once");

  // ---- Redirects ----
  imm r3 = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(port, "/redirect/3").view()));
  expect(r3.last == EventKind.Done[], "three redirects: Done");
  expectStr(r3.body.view(), "landed", "...the last one's body");
  expectStr(r3.url.view(), url(port, "/redirect/0").view(), "...and its URL");
  expectStr(r3.kinds.view(), "RDED", "...only the answer's events");
  expectUInt(u64.from(r3.timing.redirects), 3u64, "...three redirects");
  expectUInt(u64.from(r3.timing.attempts), 4u64, "...four requests");
  expect(r3.timing.reused, "...the last on a kept connection");

  mut lim = Request.get(url(port, "/redirect/3").view());
  lim.maxRedirects = 2u32;
  imm l2 = fetchSeen(&mut cl, &mut sv, &mut lp, lim);
  expect(l2.last == EventKind.Failed[] and l2.stage == Stage.Redirect[], "a limit of two: Failed at the third");
  expectStr(l2.failure.view(), "redirect: too large: more than 2 redirects", "...saying so");

  imm ten = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(port, "/redirect/10").view()));
  expect(ten.last == EventKind.Done[] and ten.timing.redirects == 10u32, "ten redirects: the default limit, Done");
  imm eleven = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(port, "/redirect/11").view()));
  expectStr(eleven.failure.view(), "redirect: too large: more than 10 redirects", "eleven: Failed");

  mut none = Request.get(url(port, "/redirect/3").view());
  none.maxRedirects = 0u32;
  imm z = fetchSeen(&mut cl, &mut sv, &mut lp, none);
  expect(z.last == EventKind.Done[] and z.status == 302u16, "a limit of 0: the 302 is the answer");
  expectStr(z.body.view(), "moved", "...with its body");

  // 303 and 301 make a POST a GET, its body gone; 307 keeps both
  mut p303 = Request.make("POST", url(port, "/status/303?/headers").view());
  p303.body = String.from("form");
  p303.headers.add("Content-Type", "application/x-www-form-urlencoded");
  imm s303 = fetchSeen(&mut cl, &mut sv, &mut lp, p303);
  expectStr(s303.body.view(), "auth=-;cookie=-;method=GET;body=-", "303 after a POST: a GET, no body");
  mut p301 = Request.make("POST", url(port, "/status/301?/headers").view());
  p301.body = String.from("form");
  imm s301 = fetchSeen(&mut cl, &mut sv, &mut lp, p301);
  expectStr(s301.body.view(), "auth=-;cookie=-;method=GET;body=-", "301 after a POST: a GET, no body");
  mut p307 = Request.make("POST", url(port, "/status/307?/headers").view());
  p307.body = String.from("kept");
  imm s307 = fetchSeen(&mut cl, &mut sv, &mut lp, p307);
  expectStr(s307.body.view(), "auth=-;cookie=-;method=POST;body=kept", "307 after a POST: the same POST, its body");
  mut put308 = Request.make("PUT", url(port, "/status/308?/headers").view());
  put308.body = String.from("again");
  imm s308 = fetchSeen(&mut cl, &mut sv, &mut lp, put308);
  expectStr(s308.body.view(), "auth=-;cookie=-;method=PUT;body=again", "308 after a PUT: the same PUT, its body");

  // Credentials: kept within an origin, dropped across origins
  mut same = Request.get(url(port, "/status/302?/headers").view());
  same.headers.add("Authorization", "Bearer secret");
  same.headers.add("Cookie", "c=1");
  imm ss = fetchSeen(&mut cl, &mut sv, &mut lp, same);
  expectStr(ss.body.view(), "auth=Bearer secret;cookie=c=1;method=GET;body=-", "the same origin: credentials kept");
  mut away = String.from("/status/302?");
  away.append(url(port2, "/headers").view());
  mut cross = Request.get(url(port, away.view()).view());
  cross.headers.add("Authorization", "Bearer secret");
  cross.headers.add("Cookie", "c=1");
  cross.headers.add("X-Other", "kept");
  imm cs = fetchSeen(&mut cl, &mut sv, &mut lp, cross);
  expectStr(cs.body.view(), "auth=-;cookie=-;method=GET;body=-", "another origin (another port): credentials dropped");
  expectStr(cs.url.view(), url(port2, "/headers").view(), "...answered by it");

  // A Location that cannot be followed; a 3xx with none
  imm bad = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(port, "/status/302?http://[::1").view()));
  expectStr(bad.failure.view(),
    "redirect: malformed: the Location 'http://[::1' cannot be followed: url: an IPv6 address in a URL ends with ']' (at 7)",
    "a Location that does not parse: Failed");
  imm ftp = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(port, "/status/301?ftp://example.com/").view()));
  expectStr(ftp.failure.view(),
    "redirect: malformed: the Location 'ftp://example.com/' cannot be followed: it is not an http or https URL",
    "a Location of another scheme: Failed");
  imm noLoc = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(port, "/status/302").view()));
  expect(noLoc.last == EventKind.Done[] and noLoc.status == 302u16, "a 302 with no Location: the answer itself");

  // Every fetch answered once; every buffer home
  imm s = cl.stats();
  expectUInt(s.fetches, s.done + s.failed + s.cancelled + s.timedOut, "every fetch has had its one final answer");
  expectUInt(s.redirects, 3u64 + 2u64 + 10u64 + 10u64 + 4u64 + 2u64, "stats: the redirects followed");
  cl.abortAll(&mut lp);
  idleFor(&mut cl, &mut sv, &mut lp, Duration.fromMillis(50i64));
  stopServer(&mut sv, &mut lp);
  expectUInt(pool.stats().lent, 0u64, "every buffer back in the pool");
  done();
}
