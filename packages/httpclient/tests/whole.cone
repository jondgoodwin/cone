// A whole fetch in one call, against a loopback server on a thread of its
// own (fetchWhole drives only the client's loop): a body; a body after two
// redirects, with the URL that gave it; a body of 100,000 bytes checked
// byte by byte; one past its limit, Failed at Stage.Limit; a bad URL; the
// events of another fetch that arrive meanwhile kept for the next poll,
// every one of them; and getWhole, with a loop and client of its own.

mod whole;

import testing use *;
import collections use List, String;
import time use Instant, Duration;
import thread;
import sync use Arc, Sender, Receiver, Channel;
import iobuf use *;
import iocore use Loop, SocketAddr, Completion, forever;
import http use *;
import httpconn;
import httpclient use *;

// ---------------------------------------------------------------------------
// The loopback server: httpconn's own driver on the client's Loop. What it
// answers is chosen by the request's path:
//   /hello             200 "hello" (and any path not below)
//   /echo              200, the method, a space, and the request's body
//   /nobody            204
//   /close             no answer: the connection is reset
//   /closeonce         the first time, as /close; after, 200 "second"
//   /redirect/N        302 to /redirect/N-1; /redirect/0 is 200 "landed"
//   /status/C?L        status C, Location L when L is given, body "moved"
//   /headers           200 "auth=A;cookie=C;method=M;body=B" ('-' for none)
//   /big/N             200, N bytes, byte i being i % 251, sent as taken
//   /stall             200 with 1 MiB to come; 64 KiB of it sent, then nothing
//   /hang              nothing at all
//   /order/L           200 L
// Every request's target is kept in 'order', in the order they came.
// ---------------------------------------------------------------------------

const tokSrv = 100u64;

struct Srv {
  pub drv: httpconn.Driver;
  pub accepted: u64;
  pub open: u64;
  pub maxOpen: u64;
  pub requests: u64;
  pub closedOnce: bool;
  pub order: List[String];
  pub reqs: List[httpconn.ReqId];
  pub conns: List[httpconn.ConnId];
  pub methods: List[Method];
  pub targets: List[String];
  pub bodies: List[String];
  pub auths: List[String];
  pub cookies: List[String];
  pub streams: List[httpconn.ReqId];
  pub sent: List[u64];
  pub totals: List[u64];
}

fn server() Srv {
  Srv(drv: httpconn.Driver.make(httpconn.Config.make()), accepted: 0u64,
    open: 0u64, maxOpen: 0u64, requests: 0u64, closedOnce: false, order: List[String].empty(),
    reqs: List[httpconn.ReqId].empty(), conns: List[httpconn.ConnId].empty(), methods: List[Method].empty(),
    targets: List[String].empty(), bodies: List[String].empty(), auths: List[String].empty(),
    cookies: List[String].empty(), streams: List[httpconn.ReqId].empty(), sent: List[u64].empty(),
    totals: List[u64].empty())
}

fn listen(sv: &mut Srv, lp: &mut Loop) u16 {
  var port = 0u16;
  match sv.drv.listen(lp, SocketAddr.localhost(0u16), httpconn.Sink.Here(tokSrv)) {
    case let Ok(r) {
      match sv.drv.localAddr(lp, r) {
        case let Ok(a) {port = a.port();}
        case let Err(e) {}
      }
    }
    case let Err(e) {}
  }
  port
}

fn reply(sv: &mut Srv, req: httpconn.ReqId, head: bool, status: u16, location: &Array[u8], body: &Array[u8]) {
  var h = ResponseHead.make(status);
  if location.len > 0usize {h.headers.add("Location", location);}
  sv.drv.respond(req, h, BodyLength.sized(u64.from(body.len)));
  if body.len > 0usize && !head {
    var b = IoBuf(body.len);
    b.append(body);
    sv.drv.sendData(req, b);
    sv.drv.finish(req);
  }
}

fn number(s: &str) u64 { collections.parseUInt(s) || 0u64 }

// Stream j's next pieces, as many as the connection takes now
fn pumpStream(sv: &mut Srv, j: usize) {
  let req = *sv.streams[j];
  while *sv.sent[j] < *sv.totals[j] {
    let at = *sv.sent[j];
    let left = *sv.totals[j] - at;
    let n = if left < 65536u64 {usize.from(left)} else {65536usize};
    var b = IoBuf(n);
    let s = b.spare();
    var i = 0usize;
    while i < n {
      s[i] = u8.from((at + u64.from(i)) % 251u64);
      i = i + 1usize;
    }
    b.setLen(n);
    match sv.drv.sendData(req, b) {
      case is None[IoBuf] {sv.sent.set(j, at + u64.from(n));}
      else {return;}
    }
  }
  sv.drv.finish(req);
  dropStream(sv, j);
}

fn dropStream(sv: &mut Srv, j: usize) {
  let last = sv.streams.len() - 1usize;
  sv.streams.swap(j, last);
  sv.sent.swap(j, last);
  sv.totals.swap(j, last);
  sv.streams.pop();
  sv.sent.pop();
  sv.totals.pop();
}

fn findStream(sv: &Srv, req: httpconn.ReqId) usize {
  var j = 0usize;
  while j < sv.streams.len() {
    if *sv.streams[j] == req {return j;}
    j = j + 1usize;
  }
  sv.streams.len()
}

// The answer to request k, read whole
fn answer(sv: &mut Srv, lp: &mut Loop, k: usize) {
  let req = *sv.reqs[k];
  let full = sv.targets[k].copy();
  let t = full.view();
  var q = 0usize;
  while q < t.len && t[q] != '?' {q = q + 1usize;}
  let path = &t[0usize ..< q];
  let query = &t[(if q < t.len {q + 1usize} else {q}) ..];
  let head = *sv.methods[k] == Method.Head;
  if path == "/echo" {
    var b = String.from(methodToken(*sv.methods[k]));
    b.append(" ");
    b.append(sv.bodies[k].view());
    reply(sv, req, head, 200u16, "", b.view());
  } else if path == "/nobody" {
    reply(sv, req, head, 204u16, "", "");
  } else if path == "/close" {
    sv.drv.abort(lp, *sv.conns[k]);
  } else if path == "/closeonce" {
    if !sv.closedOnce {
      sv.closedOnce = true;
      sv.drv.abort(lp, *sv.conns[k]);
    } else {
      reply(sv, req, head, 200u16, "", "second");
    }
  } else if path.len > 10usize && &path[0usize ..< 10usize] == "/redirect/" {
    let n = number(&path[10usize ..]);
    if n == 0u64 {
      reply(sv, req, head, 200u16, "", "landed");
    } else {
      var loc = String.from("/redirect/");
      loc.appendUInt(n - 1u64);
      reply(sv, req, head, 302u16, loc.view(), "moved");
    }
  } else if path.len > 8usize && &path[0usize ..< 8usize] == "/status/" {
    reply(sv, req, head, u16.from(number(&path[8usize ..])), query, "moved");
  } else if path == "/headers" {
    var b = String.from("auth=");
    b.append(sv.auths[k].view());
    b.append(";cookie=");
    b.append(sv.cookies[k].view());
    b.append(";method=");
    b.append(methodToken(*sv.methods[k]));
    b.append(";body=");
    b.append(if sv.bodies[k].len() == 0usize {"-"} else {sv.bodies[k].view()});
    reply(sv, req, head, 200u16, "", b.view());
  } else if path.len > 5usize && &path[0usize ..< 5usize] == "/big/" {
    let n = number(&path[5usize ..]);
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(n));
    sv.streams.push(req);
    sv.sent.push(0u64);
    sv.totals.push(n);
    pumpStream(sv, sv.streams.len() - 1usize);
  } else if path == "/stall" {
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(1048576u64));
    var b = IoBuf(65536usize);
    b.setLen(65536usize);
    sv.drv.sendData(req, b);
  } else if path == "/hang" {
  } else if path.len > 7usize && &path[0usize ..< 7usize] == "/order/" {
    reply(sv, req, head, 200u16, "", &path[7usize ..]);
  } else {
    reply(sv, req, head, 200u16, "", "hello");
  }
}

fn findReq(sv: &Srv, req: httpconn.ReqId) usize {
  var k = 0usize;
  while k < sv.reqs.len() {
    if *sv.reqs[k] == req {return k;}
    k = k + 1usize;
  }
  sv.reqs.len()
}

fn forget(sv: &mut Srv, k: usize) {
  let last = sv.reqs.len() - 1usize;
  sv.reqs.swap(k, last);
  sv.conns.swap(k, last);
  sv.methods.swap(k, last);
  sv.targets.swap(k, last);
  sv.bodies.swap(k, last);
  sv.auths.swap(k, last);
  sv.cookies.swap(k, last);
  sv.reqs.pop();
  sv.conns.pop();
  sv.methods.pop();
  sv.targets.pop();
  sv.bodies.pop();
  sv.auths.pop();
  sv.cookies.pop();
}

fn fieldOr(h: &Headers, name: &str) String {
  match h.get(name) {
    case let Some(v) {String.fromBytes(v)}
    case is None[&Array[u8]] {String.from("-")}
  }
}

fn serve(sv: &mut Srv, lp: &mut Loop, e: &mut httpconn.Event) {
  let kind = e.kind;
  if kind == httpconn.EventKind.Accepted {
    sv.accepted = sv.accepted + 1u64;
    sv.open = sv.open + 1u64;
    if sv.open > sv.maxOpen {sv.maxOpen = sv.open;}
  } else if kind == httpconn.EventKind.Closed {
    sv.open = sv.open - 1u64;
  } else if kind == httpconn.EventKind.Request {
    sv.requests = sv.requests + 1u64;
    sv.order.push(e.request.target.copy());
    sv.reqs.push(e.req);
    sv.conns.push(e.conn);
    sv.methods.push(e.request.method);
    sv.targets.push(e.request.target.copy());
    sv.bodies.push(String.empty());
    sv.auths.push(fieldOr(&e.request.headers, "Authorization"));
    sv.cookies.push(fieldOr(&e.request.headers, "Cookie"));
  } else if kind == httpconn.EventKind.Data {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {(&mut sv.bodies[k]).appendBytes(e.buf.view());}
    sv.drv.release(e.req, e.buf.len());
  } else if kind == httpconn.EventKind.End {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {answer(sv, lp, k);}
  } else if kind == httpconn.EventKind.Writable {
    let j = findStream(sv, e.req);
    if j < sv.streams.len() {pumpStream(sv, j);}
  } else if e.isTerminal() {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {forget(sv, k);}
    let j = findStream(sv, e.req);
    if j < sv.streams.len() {dropStream(sv, j);}
  }
}

// One turn of the loop: the client's completions to it, the server's to
// its driver; the server's events answered; the client's appended to out
fn step(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, out: &uni List[Event], until: Instant) {
  var sevs = List[httpconn.Event].empty();
  cl.pump(lp, out);
  sv.drv.pump(lp, &uni sevs);
  var limit = until;
  let a = cl.wakeAt();
  if a < limit {limit = a;}
  let b = sv.drv.wakeAt();
  if b < limit {limit = b;}
  if out.len() > 0usize || sevs.len() > 0usize {limit = Instant();}
  var comps = List[Completion].empty();
  lp.poll(limit, &mut comps);
  var k = 0usize;
  while k < comps.len() {
    let c = &mut comps[k];
    if !cl.complete(lp, c) {sv.drv.complete(lp, c);}
    k = k + 1usize;
  }
  comps.clear();
  sv.drv.pump(lp, &uni sevs);
  k = 0usize;
  while k < sevs.len() {
    serve(sv, lp, &mut sevs[k]);
    k = k + 1usize;
  }
  cl.pump(lp, out);
}

// The server's every connection reset, and its buffers home
fn stopServer(sv: &mut Srv, lp: &mut Loop) {
  sv.drv.abortAll(lp);
  var sevs = List[httpconn.Event].empty();
  sv.drv.pump(lp, &uni sevs);
}

fn url(port: u16, path: &str) String {
  var u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u
}

// ---------------------------------------------------------------------------
// What the client saw
// ---------------------------------------------------------------------------

struct Seen {
  pub status: u16;
  pub body: String;
  pub url: String;
  pub kinds: String;          // each event's kind's first letter, in order
  pub finals: u64;
  pub last: EventKind;
  pub failure: String;
  pub stage: Stage;
  pub timing: Timing;
}

fn seen() Seen {
  Seen(status: 0u16, body: String.empty(), url: String.empty(), kinds: String.empty(), finals: 0u64,
    last: EventKind.Done, failure: String.empty(), stage: Stage.Url, timing: Timing.zero())
}

fn note(cl: &mut Client, s: &mut Seen, e: &mut Event) {
  let n = eventName(e.kind);
  s.kinds.appendByte(n[0usize]);
  if e.kind == EventKind.Response {
    s.status = e.response.status;
    s.url = e.url.copy();
  } else if e.kind == EventKind.Data {
    s.body.appendBytes(e.buf.view());
    cl.release(e.id, e.buf.len());
  } else if e.isTerminal() {
    s.finals = s.finals + 1u64;
    s.last = e.kind;
    s.timing = e.timing;
    if e.kind == EventKind.Failed {
      s.failure = e.failure.message();
      s.stage = e.failure.stage;
    }
  }
}

// Drive until fetch id has its final answer, its events noted in s
fn finishOf(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, id: FetchId, s: &mut Seen) {
  var out = List[Event].empty();
  let giveUp = Instant.now() + Duration.fromSeconds(10i64);
  let before = s.finals;
  while s.finals == before && Instant.now() < giveUp {
    step(cl, sv, lp, &uni out, giveUp);
    var k = 0usize;
    while k < out.len() {
      let e = &mut out[k];
      if e.id == id {note(cl, s, e);}
      k = k + 1usize;
    }
    out.clear();
  }
  requireUInt(s.finals, before + 1u64, "the fetch has its final answer in time");
}

// A request sent and driven to its final answer: what was seen
fn fetchSeen(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, r: Request) Seen {
  var s = seen();
  let id = cl.send(lp, r, Sink.Here(1u64));
  finishOf(cl, sv, lp, id, &mut s);
  s
}

// Drive for a while
fn idleFor(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, d: Duration) {
  var out = List[Event].empty();
  let until = Instant.now() + d;
  while Instant.now() < until {
    step(cl, sv, lp, &uni out, until);
    var k = 0usize;
    while k < out.len() {
      let e = &mut out[k];
      if e.kind == EventKind.Data {cl.release(e.id, e.buf.len());}
      k = k + 1usize;
    }
    out.clear();
  }
}

// The server, on a thread of its own until told to stop
struct ServerArgs {
  pub portTx: Sender[u16];
  pub stop: Arc[imm, Atomic[bool]];
}

fn serveThread(a: ServerArgs) u64 {
  var lp = Loop.mustMake();
  var sv = server();
  a.portTx.send(listen(&mut sv, &mut lp));
  var evs = List[httpconn.Event].empty();
  while !a.stop.load() {
    sv.drv.poll(&mut lp, Instant.now() + Duration.fromMillis(20i64), &uni evs);
    var k = 0usize;
    while k < evs.len() {
      serve(&mut sv, &mut lp, &mut evs[k]);
      k = k + 1usize;
    }
    evs.clear();
  }
  stopServer(&mut sv, &mut lp);
  sv.requests
}

fn main() i32 {
  // Names and URLs are text, a '&str'
  let stageText: &str = stageName(Stage.Url);
  let intentText: &str = intentName(Intent.Urgent);
  let eventText: &str = eventName(EventKind.Done);
  let sample = Request.get("http://127.0.0.1/");
  let methodText: &str = sample.methodName();
  let failure = Failure.make(Stage.Url, 0u32, ErrorKind.Malformed, "text");
  let failText: &str = failure.error.detail.view();
  assert(stageText == "url" && intentText == "urgent" && eventText == "Done" && methodText == "GET" && failText == "text");
  var portTx: Sender[u16];
  var portRx: Receiver[u16];
  portTx, portRx = Channel[u16].make();
  let stop = Arc[imm, Atomic[bool]](Atomic[bool].of(false));
  let srv = thread.start(ServerArgs(portTx, stop), &serveThread);
  var port = 0u16;
  match portRx.recv() {
    case let Some(p) {port = p;}
    case is None[u16] {}
  }
  require(port != 0u16, "the server listens, on its own thread");
  var lp = Loop.mustMake();
  var cl = Client.make(Config.make());

  let h = cl.fetchWhole(&mut lp, Request.get(url(port, "/hello").view()), 1024usize);
  expect(h.isOk(), "fetchWhole: Done");
  expectUInt(u64.from(h.status), 200u64, "...200");
  expectStr(h.body.view(), "hello", "...its body");
  expect(h.headers.has("Content-Length"), "...its fields");
  expectStr(h.url.view(), url(port, "/hello").view(), "...its URL");

  let r = cl.fetchWhole(&mut lp, Request.get(url(port, "/redirect/2").view()), 1024usize);
  expectStr(r.body.view(), "landed", "after two redirects: the last one's body");
  expectStr(r.url.view(), url(port, "/redirect/0").view(), "...its URL");
  expectUInt(u64.from(r.timing.redirects), 2u64, "...two redirects");

  let b = cl.fetchWhole(&mut lp, Request.get(url(port, "/big/100000").view()), 1048576usize);
  expectUInt(u64.from(b.body.len()), 100000u64, "100,000 bytes");
  var same = true;
  var i = 0usize;
  let v = b.body.view();
  while i < v.len {
    if v[i] != u8.from(u64.from(i) % 251u64) {same = false;}
    i = i + 1usize;
  }
  expect(same, "...every byte");

  let big = cl.fetchWhole(&mut lp, Request.get(url(port, "/big/2097152").view()), 1048576usize);
  expect(big.outcome == EventKind.Failed && big.failure.stage == Stage.Limit, "2 MiB past a 1 MiB limit: Failed");
  expectStr(big.failure.message().view(), "limit: too large: the body is longer than the limit it was fetched with",
    "...saying why");
  expect(big.body.len() <= 1048576usize, "...what it gathered within the limit");

  let bad = cl.fetchWhole(&mut lp, Request.get("http://exa mple.com/"), 1024usize);
  expect(bad.outcome == EventKind.Failed && bad.failure.stage == Stage.Url, "a bad URL: Failed at Stage.Url");

  // Another fetch's events, arriving while fetchWhole drives the loop, wait
  // for the next poll
  let other = cl.get(&mut lp, url(port, "/hello").view(), Sink.Here(7u64));
  let w = cl.fetchWhole(&mut lp, Request.get(url(port, "/big/300000").view()), 1048576usize);
  expect(w.isOk(), "a whole fetch beside another");
  var kinds = String.empty();
  var body = String.empty();
  var out = List[Event].empty();
  let giveUp = Instant.now() + Duration.fromSeconds(10i64);
  while !kinds.endsWith("D") && Instant.now() < giveUp {
    cl.poll(&mut lp, giveUp, &uni out);
    var k = 0usize;
    while k < out.len() {
      let e = &mut out[k];
      if e.id == other {
        kinds.appendByte(eventName(e.kind)[0usize]);
        if e.kind == EventKind.Data {
          body.appendBytes(e.buf.view());
          cl.release(e.id, e.buf.len());
        }
      }
      k = k + 1usize;
    }
    out.clear();
  }
  expectStr(kinds.view(), "RDED", "...the other's events, every one, at the next poll");
  expectStr(body.view(), "hello", "...its body");

  // getWhole: a loop and a client of its own
  let g = getWhole(url(port, "/hello").view(), 1024usize);
  expect(g.isOk() && g.body.view() == "hello", "getWhole: Done, its body");

  let s = cl.stats();
  expectUInt(s.fetches, s.done + s.failed + s.cancelled + s.timedOut, "every fetch has had its one final answer");
  cl.abortAll(&mut lp);
  var evs = List[Event].empty();
  cl.pump(&mut lp, &uni evs);
  stop.store(true);
  let served = srv.join();
  expectUInt(served, 9u64, "the server read nine requests (the bad URL never sent)");
  expectUInt(stats().lent, 0u64, "every buffer back in the pool");
  done()
}
