// The scheduler, against a loopback server on the client's Loop, with one
// connection to the origin (maxPerOrigin 1), so the order the server sees
// is the order the client chose. Checked: twenty requests at the four
// intents and with scores, one reprioritized to the front while it waits
// and one cancelled while it waits, plus three equal ones (first come,
// first served), arrive in exactly the order the rules give, each with
// exactly one final answer, the cancelled one never sent; a request asked
// for later at a higher intent overtakes every one still waiting; a
// deadline passes for a request waiting (never sent) and for one under way
// (its connection reset); a cancel group cancelled from another thread
// ends the request under way and those waiting in it, and the loop wakes
// for it at once, while a request outside the group goes on; a group's
// deadline; a group already cancelled.

mod order;

import testing use *;
import collections use List, String;
import time use Instant, Duration;
import thread;
import iobuf use *;
import iocore use Loop, SocketAddr, Completion, CancelGroup, forever;
import http use *;
import httpconn;
import httpclient use *;

// ---------------------------------------------------------------------------
// The loopback server: httpconn's own driver on the client's Loop. What it
// answers is chosen by the request's path:
//   /hello             200 "hello" (and any path not below)
//   /echo              200, the method, a space, and the request's body
//   /nobody            204
//   /close             no answer: the connection is reset
//   /closeonce         the first time, as /close; after, 200 "second"
//   /redirect/N        302 to /redirect/N-1; /redirect/0 is 200 "landed"
//   /status/C?L        status C, Location L when L is given, body "moved"
//   /headers           200 "auth=A;cookie=C;method=M;body=B" ('-' for none)
//   /big/N             200, N bytes, byte i being i % 251, sent as taken
//   /stall             200 with 1 MiB to come; 64 KiB of it sent, then nothing
//   /hang              nothing at all
//   /order/L           200 L
// Every request's target is kept in 'order', in the order they came.
// ---------------------------------------------------------------------------

const tokSrv = 100u64;

struct Srv {
  pub drv httpconn.Driver;
  pub pool Pool;
  pub accepted u64;
  pub open u64;
  pub maxOpen u64;
  pub requests u64;
  pub closedOnce bool;
  pub order List[String];
  pub reqs List[httpconn.ReqId];
  pub conns List[httpconn.ConnId];
  pub methods List[Method];
  pub targets List[String];
  pub bodies List[String];
  pub auths List[String];
  pub cookies List[String];
  pub streams List[httpconn.ReqId];
  pub sent List[u64];
  pub totals List[u64];
}

fn server(pool Pool) Srv {
  new Srv(drv: httpconn.Driver.make(httpconn.Config.make(), pool), pool: pool, accepted: 0u64,
    open: 0u64, maxOpen: 0u64, requests: 0u64, closedOnce: false, order: List[String].empty(),
    reqs: List[httpconn.ReqId].empty(), conns: List[httpconn.ConnId].empty(), methods: List[Method].empty(),
    targets: List[String].empty(), bodies: List[String].empty(), auths: List[String].empty(),
    cookies: List[String].empty(), streams: List[httpconn.ReqId].empty(), sent: List[u64].empty(),
    totals: List[u64].empty());
}

fn listen(sv &mut Srv, lp &mut Loop) u16 {
  mut port = 0u16;
  match sv.drv.listen(lp, SocketAddr.localhost(0u16), httpconn.Sink.Here[tokSrv]) {
    case imm r Ok {
      match sv.drv.localAddr(lp, r.value) {
        case imm a Ok {port = a.value.port();}
        case imm e Error {}
      }
    }
    case imm e Error {}
  }
  port;
}

fn reply(sv &mut Srv, req httpconn.ReqId, head bool, status u16, location &Array[u8], body &Array[u8]) {
  mut h = ResponseHead.make(status);
  if location.len > 0usize {h.headers.add("Location", location);}
  sv.drv.respond(req, h, BodyLength.sized(u64.from(body.len)));
  if body.len > 0usize and not head {
    mut b = sv.pool.mustTake(body.len);
    b.append(body);
    sv.drv.sendData(req, b);
    sv.drv.finish(req);
  }
}

fn number(s &Array[u8]) u64 {
  match collections.parseUInt(s) {
    case imm v Some {v.value;}
    case is None[u64] {0u64;}
  }
}

// Stream j's next pieces, as many as the connection takes now
fn pumpStream(sv &mut Srv, j usize) {
  imm req = *sv.streams[j];
  while *sv.sent[j] < *sv.totals[j] {
    imm at = *sv.sent[j];
    imm left = *sv.totals[j] - at;
    imm n = if left < 65536u64 {usize.from(left);} else {65536usize;};
    mut b = sv.pool.mustTake(n);
    imm s = b.spare();
    mut i = 0usize;
    while i < n {
      s[i] = u8.from((at + u64.from(i)) % 251u64);
      i = i + 1usize;
    }
    b.setLen(n);
    match sv.drv.sendData(req, b) {
      case is None[IoBuf] {sv.sent.set(j, at + u64.from(n));}
      else {return;}
    }
  }
  sv.drv.finish(req);
  dropStream(sv, j);
}

fn dropStream(sv &mut Srv, j usize) {
  imm last = sv.streams.len() - 1usize;
  sv.streams.swap(j, last);
  sv.sent.swap(j, last);
  sv.totals.swap(j, last);
  sv.streams.pop();
  sv.sent.pop();
  sv.totals.pop();
}

fn findStream(sv &Srv, req httpconn.ReqId) usize {
  mut j = 0usize;
  while j < sv.streams.len() {
    if *sv.streams[j] == req {return j;}
    j = j + 1usize;
  }
  sv.streams.len();
}

// The answer to request k, read whole
fn answer(sv &mut Srv, lp &mut Loop, k usize) {
  imm req = *sv.reqs[k];
  imm full = sv.targets[k].copy();
  imm t = full.view();
  mut q = 0usize;
  while q < t.len and t[q] != '?' {q = q + 1usize;}
  imm path = &t[0usize .. q];
  imm query = &t[(if q < t.len {q + 1usize;} else {q;}) ..];
  imm head = *sv.methods[k] == Method.Head[];
  if path == "/echo" {
    mut b = String.from(methodToken(*sv.methods[k]));
    b.append(" ");
    b.append(sv.bodies[k].view());
    reply(sv, req, head, 200u16, "", b.view());
  } elif path == "/nobody" {
    reply(sv, req, head, 204u16, "", "");
  } elif path == "/close" {
    sv.drv.abort(lp, *sv.conns[k]);
  } elif path == "/closeonce" {
    if not sv.closedOnce {
      sv.closedOnce = true;
      sv.drv.abort(lp, *sv.conns[k]);
    } else {
      reply(sv, req, head, 200u16, "", "second");
    }
  } elif path.len > 10usize and &path[0usize .. 10usize] == "/redirect/" {
    imm n = number(&path[10usize ..]);
    if n == 0u64 {
      reply(sv, req, head, 200u16, "", "landed");
    } else {
      mut loc = String.from("/redirect/");
      loc.appendUInt(n - 1u64);
      reply(sv, req, head, 302u16, loc.view(), "moved");
    }
  } elif path.len > 8usize and &path[0usize .. 8usize] == "/status/" {
    reply(sv, req, head, u16.from(number(&path[8usize ..])), query, "moved");
  } elif path == "/headers" {
    mut b = String.from("auth=");
    b.append(sv.auths[k].view());
    b.append(";cookie=");
    b.append(sv.cookies[k].view());
    b.append(";method=");
    b.append(methodToken(*sv.methods[k]));
    b.append(";body=");
    b.append(if sv.bodies[k].len() == 0usize {"-";} else {sv.bodies[k].view();});
    reply(sv, req, head, 200u16, "", b.view());
  } elif path.len > 5usize and &path[0usize .. 5usize] == "/big/" {
    imm n = number(&path[5usize ..]);
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(n));
    sv.streams.push(req);
    sv.sent.push(0u64);
    sv.totals.push(n);
    pumpStream(sv, sv.streams.len() - 1usize);
  } elif path == "/stall" {
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(1048576u64));
    mut b = sv.pool.mustTake(65536usize);
    b.setLen(65536usize);
    sv.drv.sendData(req, b);
  } elif path == "/hang" {
  } elif path.len > 7usize and &path[0usize .. 7usize] == "/order/" {
    reply(sv, req, head, 200u16, "", &path[7usize ..]);
  } else {
    reply(sv, req, head, 200u16, "", "hello");
  }
}

fn findReq(sv &Srv, req httpconn.ReqId) usize {
  mut k = 0usize;
  while k < sv.reqs.len() {
    if *sv.reqs[k] == req {return k;}
    k = k + 1usize;
  }
  sv.reqs.len();
}

fn forget(sv &mut Srv, k usize) {
  imm last = sv.reqs.len() - 1usize;
  sv.reqs.swap(k, last);
  sv.conns.swap(k, last);
  sv.methods.swap(k, last);
  sv.targets.swap(k, last);
  sv.bodies.swap(k, last);
  sv.auths.swap(k, last);
  sv.cookies.swap(k, last);
  sv.reqs.pop();
  sv.conns.pop();
  sv.methods.pop();
  sv.targets.pop();
  sv.bodies.pop();
  sv.auths.pop();
  sv.cookies.pop();
}

fn fieldOr(h &Headers, name &Array[u8]) String {
  match h.get(name) {
    case imm v Some {String.from(v.value);}
    case is None[&Array[u8]] {String.from("-");}
  }
}

fn serve(sv &mut Srv, lp &mut Loop, e &mut httpconn.Event) {
  imm kind = e.kind;
  if kind == httpconn.EventKind.Accepted[] {
    sv.accepted = sv.accepted + 1u64;
    sv.open = sv.open + 1u64;
    if sv.open > sv.maxOpen {sv.maxOpen = sv.open;}
  } elif kind == httpconn.EventKind.Closed[] {
    sv.open = sv.open - 1u64;
  } elif kind == httpconn.EventKind.Request[] {
    sv.requests = sv.requests + 1u64;
    sv.order.push(e.request.target.copy());
    sv.reqs.push(e.req);
    sv.conns.push(e.conn);
    sv.methods.push(e.request.method);
    sv.targets.push(e.request.target.copy());
    sv.bodies.push(String.empty());
    sv.auths.push(fieldOr(&e.request.headers, "Authorization"));
    sv.cookies.push(fieldOr(&e.request.headers, "Cookie"));
  } elif kind == httpconn.EventKind.Data[] {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {(&mut sv.bodies[k]).append(e.buf.view());}
    sv.drv.release(e.req, e.buf.len());
  } elif kind == httpconn.EventKind.End[] {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {answer(sv, lp, k);}
  } elif kind == httpconn.EventKind.Writable[] {
    imm j = findStream(sv, e.req);
    if j < sv.streams.len() {pumpStream(sv, j);}
  } elif e.isTerminal() {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {forget(sv, k);}
    imm j = findStream(sv, e.req);
    if j < sv.streams.len() {dropStream(sv, j);}
  }
}

// One turn of the loop: the client's completions to it, the server's to
// its driver; the server's events answered; the client's appended to out
fn step(cl &mut Client, sv &mut Srv, lp &mut Loop, out &mut List[Event], until Instant) {
  mut sevs = List[httpconn.Event].empty();
  cl.pump(lp, out);
  sv.drv.pump(lp, &mut sevs);
  mut limit = until;
  imm a = cl.wakeAt();
  if a < limit {limit = a;}
  imm b = sv.drv.wakeAt();
  if b < limit {limit = b;}
  if out.len() > 0usize or sevs.len() > 0usize {limit = new Instant();}
  mut comps = List[Completion].empty();
  lp.poll(limit, &mut comps);
  mut k = 0usize;
  while k < comps.len() {
    imm c = &mut comps[k];
    if not cl.complete(lp, c) {sv.drv.complete(lp, c);}
    k = k + 1usize;
  }
  comps.clear();
  sv.drv.pump(lp, &mut sevs);
  k = 0usize;
  while k < sevs.len() {
    serve(sv, lp, &mut sevs[k]);
    k = k + 1usize;
  }
  cl.pump(lp, out);
}

// The server's every connection reset, and its buffers home
fn stopServer(sv &mut Srv, lp &mut Loop) {
  sv.drv.abortAll(lp);
  mut sevs = List[httpconn.Event].empty();
  sv.drv.pump(lp, &mut sevs);
}

fn url(port u16, path &Array[u8]) String {
  mut u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u;
}

// ---------------------------------------------------------------------------
// What the client saw
// ---------------------------------------------------------------------------

struct Seen {
  pub status u16;
  pub body String;
  pub url String;
  pub kinds String;          // each event's kind's first letter, in order
  pub finals u64;
  pub last EventKind;
  pub failure String;
  pub stage Stage;
  pub timing Timing;
}

fn seen() Seen {
  new Seen(status: 0u16, body: String.empty(), url: String.empty(), kinds: String.empty(), finals: 0u64,
    last: EventKind.Done[], failure: String.empty(), stage: Stage.Url[], timing: Timing.zero());
}

fn note(cl &mut Client, s &mut Seen, e &mut Event) {
  imm n = eventName(e.kind);
  s.kinds.appendByte(n[0usize]);
  if e.kind == EventKind.Response[] {
    s.status = e.response.status;
    s.url = e.url.copy();
  } elif e.kind == EventKind.Data[] {
    s.body.append(e.buf.view());
    cl.release(e.id, e.buf.len());
  } elif e.isTerminal() {
    s.finals = s.finals + 1u64;
    s.last = e.kind;
    s.timing = e.timing;
    if e.kind == EventKind.Failed[] {
      s.failure = e.failure.message();
      s.stage = e.failure.stage;
    }
  }
}

// Drive until fetch id has its final answer, its events noted in s
fn finishOf(cl &mut Client, sv &mut Srv, lp &mut Loop, id FetchId, s &mut Seen) {
  mut out = List[Event].empty();
  imm giveUp = Instant.now() + Duration.fromSeconds(10i64);
  imm before = s.finals;
  while s.finals == before and Instant.now() < giveUp {
    step(cl, sv, lp, &mut out, giveUp);
    mut k = 0usize;
    while k < out.len() {
      imm e = &mut out[k];
      if e.id == id {note(cl, s, e);}
      k = k + 1usize;
    }
    out.clear();
  }
  requireUInt(s.finals, before + 1u64, "the fetch has its final answer in time");
}

// A request sent and driven to its final answer: what was seen
fn fetchSeen(cl &mut Client, sv &mut Srv, lp &mut Loop, r Request) Seen {
  mut s = seen();
  imm id = cl.send(lp, r, Sink.Here[1u64]);
  finishOf(cl, sv, lp, id, &mut s);
  s;
}

// Drive for a while
fn idleFor(cl &mut Client, sv &mut Srv, lp &mut Loop, d Duration) {
  mut out = List[Event].empty();
  imm until = Instant.now() + d;
  while Instant.now() < until {
    step(cl, sv, lp, &mut out, until);
    mut k = 0usize;
    while k < out.len() {
      imm e = &mut out[k];
      if e.kind == EventKind.Data[] {cl.release(e.id, e.buf.len());}
      k = k + 1usize;
    }
    out.clear();
  }
}

// Every fetch's final answers, counted by its id; how many of each kind
struct Finals {
  pub ids List[FetchId];
  pub counts List[u32];
  pub kinds List[EventKind];
  pub ended List[Instant];
  pub done u64;
  pub cancelled u64;
  pub timedOut u64;
  pub failed u64;
  pub after u64;          // events for a fetch after its final answer
}

fn finals() Finals {
  new Finals(List[FetchId].empty(), List[u32].empty(), List[EventKind].empty(), List[Instant].empty(), 0u64,
    0u64, 0u64, 0u64, 0u64);
}

fn slot(f &Finals, id FetchId) usize {
  mut k = 0usize;
  while k < f.ids.len() {
    if *f.ids[k] == id {return k;}
    k = k + 1usize;
  }
  f.ids.len();
}

// Drive until n final answers have come, counting each
fn collect(cl &mut Client, sv &mut Srv, lp &mut Loop, fs &mut Finals, n u64) {
  mut out = List[Event].empty();
  imm giveUp = Instant.now() + Duration.fromSeconds(10i64);
  while fs.done + fs.cancelled + fs.timedOut + fs.failed < n and Instant.now() < giveUp {
    step(cl, sv, lp, &mut out, giveUp);
    mut k = 0usize;
    while k < out.len() {
      imm e = &mut out[k];
      k = k + 1usize;
      imm j = slot(fs, e.id);
      if j < fs.ids.len() {
        fs.after = fs.after + 1u64;
        if e.isTerminal() {fs.counts.set(j, *fs.counts[j] + 1u32);}
        continue;
      }
      if e.kind == EventKind.Data[] {cl.release(e.id, e.buf.len());}
      if e.isTerminal() {
        fs.ids.push(e.id);
        fs.counts.push(1u32);
        fs.kinds.push(e.kind);
        fs.ended.push(Instant.now());
        if e.kind == EventKind.Done[] {fs.done = fs.done + 1u64;}
        elif e.kind == EventKind.Cancelled[] {fs.cancelled = fs.cancelled + 1u64;}
        elif e.kind == EventKind.TimedOut[] {fs.timedOut = fs.timedOut + 1u64;}
        else {fs.failed = fs.failed + 1u64;}
      }
    }
    out.clear();
  }
  requireUInt(fs.done + fs.cancelled + fs.timedOut + fs.failed, n, "every final answer in time");
}

// How fetch id ended, and when (from the call that asked for it)
fn kindOf(fs &Finals, id FetchId) EventKind {
  imm j = slot(fs, id);
  if j < fs.ids.len() {*fs.kinds[j];} else {EventKind.Data[];};
}

fn endedAt(fs &Finals, id FetchId) Instant {
  imm j = slot(fs, id);
  if j < fs.ids.len() {*fs.ended[j];} else {new Instant();};
}

// The server's order, from index 'from', each target's last segment
// joined by spaces
fn orderSince(sv &Srv, from usize) String {
  mut out = String.empty();
  mut k = from;
  while k < sv.order.len() {
    imm t = sv.order[k].view();
    mut s = t.len;
    while s > 0usize and t[s - 1usize] != '/' {s = s - 1usize;}
    if out.len() > 0usize {out.append(" ");}
    out.append(&t[s ..]);
    k = k + 1usize;
  }
  out;
}

fn ordered(port u16, label &Array[u8], intent Intent, score i64) Request {
  mut path = String.from("/order/");
  path.append(label);
  mut r = Request.get(url(port, path.view()).view());
  r.intent = intent;
  r.score = score;
  r;
}

fn numbered(n u64) String {
  mut s = String.empty();
  s.appendUInt(n);
  s;
}

// A group cancelled from another thread, after a while
struct Canceller {
  pub g CancelGroup;
  pub after Duration;
}

fn cancelLater(a Canceller) bool {
  thread.sleep(a.after);
  a.g.cancel();
}

fn main() i32 {
  imm pool = Pool.make();
  mut lp = Loop.mustMake();
  mut sv = server(pool);
  imm port = listen(&mut sv, &mut lp);
  require(port != 0u16, "the server listens");
  mut cfg = Config.make();
  cfg.maxPerOrigin = 1u32;
  mut cl = Client.make(cfg, pool);

  // ---- The order under a full pool ----
  // Twenty, at intents in turn and scores rising; then the first moved to
  // the front, the last cancelled, and three equal ones after
  mut ids = List[FetchId].empty();
  mut i = 0u64;
  while i < 20u64 {
    imm m = i % 4u64;
    imm intent = if m == 0u64 {Intent.Background[];} elif m == 1u64 {Intent.Prefetch[];}
      elif m == 2u64 {Intent.Visible[];} else {Intent.Urgent[];};
    ids.push(cl.send(&mut lp, ordered(port, numbered(i).view(), intent, i64.from(i)), Sink.Here[1u64]));
    i = i + 1u64;
  }
  expect(cl.reprioritize(*ids[0usize], Intent.Urgent[], 100i64), "the first moved to the front, waiting");
  expect(cl.cancel(&mut lp, *ids[19usize]), "the last cancelled, waiting");
  expect(not cl.cancel(&mut lp, *ids[19usize]), "...a second cancel: its answer is decided");
  cl.send(&mut lp, ordered(port, "f1", Intent.Visible[], 0i64), Sink.Here[1u64]);
  cl.send(&mut lp, ordered(port, "f2", Intent.Visible[], 0i64), Sink.Here[1u64]);
  cl.send(&mut lp, ordered(port, "f3", Intent.Visible[], 0i64), Sink.Here[1u64]);
  expectUInt(u64.from(cl.queued()), 22u64, "twenty-two wait");
  mut fs = finals();
  collect(&mut cl, &mut sv, &mut lp, &mut fs, 23u64);
  expectStr(orderSince(&sv, 0usize).view(),
    "0 15 11 7 3 18 14 10 6 2 f1 f2 f3 17 13 9 5 1 16 12 8 4",
    "the order: the moved one, then by intent, then score, then as asked");
  expectUInt(fs.done, 22u64, "twenty-two Done");
  expectUInt(fs.cancelled, 1u64, "one Cancelled");
  expect(kindOf(&fs, *ids[19usize]) == EventKind.Cancelled[], "...the one cancelled waiting, never sent");
  expectUInt(fs.after, 0u64, "nothing after any final answer");
  expectUInt(sv.accepted, 1u64, "one connection carried them all");

  // ---- A later, higher request overtakes those waiting ----
  imm from = sv.order.len();
  mut hang = Request.get(url(port, "/hang").view());
  hang.deadline = Instant.now() + Duration.fromMillis(100i64);
  hang.intent = Intent.Background[];
  imm hid = cl.send(&mut lp, hang, Sink.Here[2u64]);
  imm b1 = cl.send(&mut lp, ordered(port, "b1", Intent.Background[], 0i64), Sink.Here[2u64]);
  cl.send(&mut lp, ordered(port, "b2", Intent.Background[], 0i64), Sink.Here[2u64]);
  // Driven until the hanging one is under way, the others waiting
  mut out = List[Event].empty();
  imm until = Instant.now() + Duration.fromSeconds(5i64);
  while sv.order.len() == from and Instant.now() < until {
    step(&mut cl, &mut sv, &mut lp, &mut out, until);
    out.clear();
  }
  expectUInt(u64.from(cl.queued()), 2u64, "two wait behind the one under way");
  imm u = cl.send(&mut lp, ordered(port, "u", Intent.Urgent[], 0i64), Sink.Here[2u64]);
  mut fs2 = finals();
  collect(&mut cl, &mut sv, &mut lp, &mut fs2, 4u64);
  expectStr(orderSince(&sv, from).view(), "hang u b1 b2", "the urgent one, asked last, goes next");
  expect(kindOf(&fs2, hid) == EventKind.TimedOut[], "the one under way: TimedOut at its deadline");
  expect(kindOf(&fs2, u) == EventKind.Done[] and kindOf(&fs2, b1) == EventKind.Done[], "the rest Done");

  // ---- Deadlines: one waiting, one under way ----
  imm from3 = sv.order.len();
  imm t0 = Instant.now();
  mut h2 = Request.get(url(port, "/hang").view());
  h2.deadline = t0 + Duration.fromMillis(300i64);
  imm h2id = cl.send(&mut lp, h2, Sink.Here[3u64]);
  mut q = ordered(port, "q", Intent.Visible[], 0i64);
  q.deadline = t0 + Duration.fromMillis(100i64);
  imm qid = cl.send(&mut lp, q, Sink.Here[3u64]);
  mut fs3 = finals();
  collect(&mut cl, &mut sv, &mut lp, &mut fs3, 2u64);
  expect(kindOf(&fs3, qid) == EventKind.TimedOut[], "waiting: TimedOut");
  expect(kindOf(&fs3, h2id) == EventKind.TimedOut[], "under way: TimedOut");
  imm qAt = (endedAt(&fs3, qid) - t0).millis();
  imm hAt = (endedAt(&fs3, h2id) - t0).millis();
  expect(qAt >= 100i64 and qAt < 200i64, "...the one waiting at 100 ms, give or take the tick");
  expect(hAt >= 300i64 and hAt < 400i64, "...the one under way at 300 ms");
  expectStr(orderSince(&sv, from3).view(), "hang", "the one waiting never sent");

  // ---- A cancel group, cancelled from another thread ----
  imm from4 = sv.order.len();
  imm g = CancelGroup.make();
  mut h3 = Request.get(url(port, "/hang").view());
  h3.deadline = Instant.now() + Duration.fromSeconds(3i64);
  h3.group = Some[CancelGroup][g];
  h3.intent = Intent.Urgent[];
  imm h3id = cl.send(&mut lp, h3, Sink.Here[4u64]);
  mut inGroup = List[FetchId].empty();
  mut k = 0u32;
  while k < 3u32 {
    mut r = ordered(port, "g", Intent.Prefetch[], 0i64);
    r.group = Some[CancelGroup][g];
    inGroup.push(cl.send(&mut lp, r, Sink.Here[4u64]));
    k = k + 1u32;
  }
  imm outside = cl.send(&mut lp, ordered(port, "outside", Intent.Background[], 0i64), Sink.Here[4u64]);
  imm c0 = Instant.now();
  {
    imm th = thread.start(new Canceller(g, Duration.fromMillis(50i64)), &cancelLater);
    mut fs4 = finals();
    collect(&mut cl, &mut sv, &mut lp, &mut fs4, 5u64);
    expectUInt(fs4.cancelled, 4u64, "the group's four Cancelled: one under way, three waiting");
    expect(kindOf(&fs4, h3id) == EventKind.Cancelled[], "...the one under way among them");
    expect(kindOf(&fs4, outside) == EventKind.Done[], "the one outside the group goes on: Done");
    imm cAt = (endedAt(&fs4, h3id) - c0).millis();
    expect(cAt >= 50i64 and cAt < 150i64, "the cancel wakes the loop at once");
  }
  expectStr(orderSince(&sv, from4).view(), "hang outside", "the group's waiting ones never sent");
  expect(g.isCancelled(), "the group is cancelled: a state");
  mut late = ordered(port, "late", Intent.Urgent[], 0i64);
  late.group = Some[CancelGroup][g];
  mut fs5 = finals();
  imm lid = cl.send(&mut lp, late, Sink.Here[5u64]);
  collect(&mut cl, &mut sv, &mut lp, &mut fs5, 1u64);
  expect(kindOf(&fs5, lid) == EventKind.Cancelled[], "asked in a cancelled group: Cancelled at once");

  // ---- A group's deadline ----
  imm d0 = Instant.now();
  imm gd = CancelGroup.until(d0 + Duration.fromMillis(80i64));
  mut h4 = Request.get(url(port, "/hang").view());
  h4.group = Some[CancelGroup][gd];
  mut fs6 = finals();
  imm h4id = cl.send(&mut lp, h4, Sink.Here[6u64]);
  collect(&mut cl, &mut sv, &mut lp, &mut fs6, 1u64);
  expect(kindOf(&fs6, h4id) == EventKind.TimedOut[], "a group's deadline: TimedOut");
  imm dAt = (endedAt(&fs6, h4id) - d0).millis();
  expect(dAt >= 80i64 and dAt < 180i64, "...at it");

  // Every fetch answered once; every buffer home
  imm s = cl.stats();
  expectUInt(s.fetches, s.done + s.failed + s.cancelled + s.timedOut, "every fetch has had its one final answer");
  expectUInt(s.fetches, 23u64 + 4u64 + 2u64 + 5u64 + 1u64 + 1u64, "...thirty-six of them");
  cl.abortAll(&mut lp);
  idleFor(&mut cl, &mut sv, &mut lp, Duration.fromMillis(50i64));
  stopServer(&mut sv, &mut lp);
  expectUInt(pool.stats().lent, 0u64, "every buffer back in the pool");
  done();
}
