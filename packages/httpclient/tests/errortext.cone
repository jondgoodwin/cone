// The one line each error of this package gives a person is pinned here, with the
// number fields in play, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use String;
import httpclient use *;
import http use ErrorKind;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- Failure.make(Stage.Url, 0u32, ErrorKind.Malformed, "no scheme"), "url: malformed: no scheme", "no OS code");
  says(String() <- Failure.make(Stage.Connect, 0u32, ErrorKind.Closed, "refused"), "connect: closed: refused", "connect");
  let os = String() <- Failure.make(Stage.Connect, 5u32, ErrorKind.Closed, "refused"); expect(os.view().startsWith("connect: closed: refused (") && os.view().endsWith(")") && os.view().len() > 28usize, "an OS code adds its text");
  done()
}
