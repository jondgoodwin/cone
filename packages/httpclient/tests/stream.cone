// Bodies, credit and back-pressure, against a loopback server on the
// client's Loop (both ends' buffers from one pool, so the pool's bytes lent
// are what the two ends hold). Checked: a 16 MiB body streamed whole, every
// byte checked, the bytes lent never past a bound far below the body; a
// slow consumer, holding what it was given and releasing a little at a
// time, slowing the link rather than filling memory (the same bound); a
// fetch cancelled mid-body, Cancelled and nothing after, its connection
// reset; and a body sent through a bounded channel to a slow thread, every
// event arriving there in order, the final answer last, with the same
// bound.

mod stream;

import testing use *;
import collections use List, String;
import time use Instant, Duration;
import thread;
import sync use Sender, Receiver, Channel;
import iobuf use *;
import iocore use Loop, SocketAddr, Completion, forever;
import http use *;
import httpconn;
import httpclient use *;

// ---------------------------------------------------------------------------
// The loopback server: httpconn's own driver on the client's Loop. What it
// answers is chosen by the request's path:
//   /hello             200 "hello" (and any path not below)
//   /echo              200, the method, a space, and the request's body
//   /nobody            204
//   /close             no answer: the connection is reset
//   /closeonce         the first time, as /close; after, 200 "second"
//   /redirect/N        302 to /redirect/N-1; /redirect/0 is 200 "landed"
//   /status/C?L        status C, Location L when L is given, body "moved"
//   /headers           200 "auth=A;cookie=C;method=M;body=B" ('-' for none)
//   /big/N             200, N bytes, byte i being i % 251, sent as taken
//   /stall             200 with 1 MiB to come; 64 KiB of it sent, then nothing
//   /hang              nothing at all
//   /order/L           200 L
// Every request's target is kept in 'order', in the order they came.
// ---------------------------------------------------------------------------

const tokSrv = 100u64;

struct Srv {
  pub drv: httpconn.Driver;
  pub pool: Pool;
  pub accepted: u64;
  pub open: u64;
  pub maxOpen: u64;
  pub requests: u64;
  pub closedOnce: bool;
  pub order: List[String];
  pub reqs: List[httpconn.ReqId];
  pub conns: List[httpconn.ConnId];
  pub methods: List[Method];
  pub targets: List[String];
  pub bodies: List[String];
  pub auths: List[String];
  pub cookies: List[String];
  pub streams: List[httpconn.ReqId];
  pub sent: List[u64];
  pub totals: List[u64];
}

fn server(pool: Pool) Srv {
  Srv(drv: httpconn.Driver.make(httpconn.Config.make(), pool), pool: pool, accepted: 0u64,
    open: 0u64, maxOpen: 0u64, requests: 0u64, closedOnce: false, order: List[String].empty(),
    reqs: List[httpconn.ReqId].empty(), conns: List[httpconn.ConnId].empty(), methods: List[Method].empty(),
    targets: List[String].empty(), bodies: List[String].empty(), auths: List[String].empty(),
    cookies: List[String].empty(), streams: List[httpconn.ReqId].empty(), sent: List[u64].empty(),
    totals: List[u64].empty())
}

fn listen(sv: &mut Srv, lp: &mut Loop) u16 {
  var port = 0u16;
  match sv.drv.listen(lp, SocketAddr.localhost(0u16), httpconn.Sink.Here(tokSrv)) {
    case let r Ok {
      match sv.drv.localAddr(lp, r) {
        case let a Ok {port = a.port();}
        case let e Error {}
      }
    }
    case let e Error {}
  }
  port
}

fn reply(sv: &mut Srv, req: httpconn.ReqId, head: bool, status: u16, location: &Array[u8], body: &Array[u8]) {
  var h = ResponseHead.make(status);
  if location.len > 0usize {h.headers.add("Location", location);}
  sv.drv.respond(req, h, BodyLength.sized(u64.from(body.len)));
  if body.len > 0usize && !head {
    var b = sv.pool.mustTake(body.len);
    b.append(body);
    sv.drv.sendData(req, b);
    sv.drv.finish(req);
  }
}

fn number(s: &str) u64 {
  match collections.parseUInt(s) {
    case let v Some {v}
    case is None[u64] {0u64}
  }
}

// Stream j's next pieces, as many as the connection takes now
fn pumpStream(sv: &mut Srv, j: usize) {
  let req = *sv.streams[j];
  while *sv.sent[j] < *sv.totals[j] {
    let at = *sv.sent[j];
    let left = *sv.totals[j] - at;
    let n = if left < 65536u64 {usize.from(left)} else {65536usize};
    var b = sv.pool.mustTake(n);
    let s = b.spare();
    var i = 0usize;
    while i < n {
      s[i] = u8.from((at + u64.from(i)) % 251u64);
      i = i + 1usize;
    }
    b.setLen(n);
    match sv.drv.sendData(req, b) {
      case is None[IoBuf] {sv.sent.set(j, at + u64.from(n));}
      else {return;}
    }
  }
  sv.drv.finish(req);
  dropStream(sv, j);
}

fn dropStream(sv: &mut Srv, j: usize) {
  let last = sv.streams.len() - 1usize;
  sv.streams.swap(j, last);
  sv.sent.swap(j, last);
  sv.totals.swap(j, last);
  sv.streams.pop();
  sv.sent.pop();
  sv.totals.pop();
}

fn findStream(sv: &Srv, req: httpconn.ReqId) usize {
  var j = 0usize;
  while j < sv.streams.len() {
    if *sv.streams[j] == req {return j;}
    j = j + 1usize;
  }
  sv.streams.len()
}

// The answer to request k, read whole
fn answer(sv: &mut Srv, lp: &mut Loop, k: usize) {
  let req = *sv.reqs[k];
  let full = sv.targets[k].copy();
  let t = full.view();
  var q = 0usize;
  while q < t.len && t[q] != '?' {q = q + 1usize;}
  let path = &t[0usize ..< q];
  let query = &t[(if q < t.len {q + 1usize} else {q}) ..];
  let head = *sv.methods[k] == Method.Head;
  if path == "/echo" {
    var b = String.from(methodToken(*sv.methods[k]));
    b.append(" ");
    b.append(sv.bodies[k].view());
    reply(sv, req, head, 200u16, "", b.view());
  } elif path == "/nobody" {
    reply(sv, req, head, 204u16, "", "");
  } elif path == "/close" {
    sv.drv.abort(lp, *sv.conns[k]);
  } elif path == "/closeonce" {
    if !sv.closedOnce {
      sv.closedOnce = true;
      sv.drv.abort(lp, *sv.conns[k]);
    } else {
      reply(sv, req, head, 200u16, "", "second");
    }
  } elif path.len > 10usize && &path[0usize ..< 10usize] == "/redirect/" {
    let n = number(&path[10usize ..]);
    if n == 0u64 {
      reply(sv, req, head, 200u16, "", "landed");
    } else {
      var loc = String.from("/redirect/");
      loc.appendUInt(n - 1u64);
      reply(sv, req, head, 302u16, loc.view(), "moved");
    }
  } elif path.len > 8usize && &path[0usize ..< 8usize] == "/status/" {
    reply(sv, req, head, u16.from(number(&path[8usize ..])), query, "moved");
  } elif path == "/headers" {
    var b = String.from("auth=");
    b.append(sv.auths[k].view());
    b.append(";cookie=");
    b.append(sv.cookies[k].view());
    b.append(";method=");
    b.append(methodToken(*sv.methods[k]));
    b.append(";body=");
    b.append(if sv.bodies[k].len() == 0usize {"-"} else {sv.bodies[k].view()});
    reply(sv, req, head, 200u16, "", b.view());
  } elif path.len > 5usize && &path[0usize ..< 5usize] == "/big/" {
    let n = number(&path[5usize ..]);
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(n));
    sv.streams.push(req);
    sv.sent.push(0u64);
    sv.totals.push(n);
    pumpStream(sv, sv.streams.len() - 1usize);
  } elif path == "/stall" {
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(1048576u64));
    var b = sv.pool.mustTake(65536usize);
    b.setLen(65536usize);
    sv.drv.sendData(req, b);
  } elif path == "/hang" {
  } elif path.len > 7usize && &path[0usize ..< 7usize] == "/order/" {
    reply(sv, req, head, 200u16, "", &path[7usize ..]);
  } else {
    reply(sv, req, head, 200u16, "", "hello");
  }
}

fn findReq(sv: &Srv, req: httpconn.ReqId) usize {
  var k = 0usize;
  while k < sv.reqs.len() {
    if *sv.reqs[k] == req {return k;}
    k = k + 1usize;
  }
  sv.reqs.len()
}

fn forget(sv: &mut Srv, k: usize) {
  let last = sv.reqs.len() - 1usize;
  sv.reqs.swap(k, last);
  sv.conns.swap(k, last);
  sv.methods.swap(k, last);
  sv.targets.swap(k, last);
  sv.bodies.swap(k, last);
  sv.auths.swap(k, last);
  sv.cookies.swap(k, last);
  sv.reqs.pop();
  sv.conns.pop();
  sv.methods.pop();
  sv.targets.pop();
  sv.bodies.pop();
  sv.auths.pop();
  sv.cookies.pop();
}

fn fieldOr(h: &Headers, name: &str) String {
  match h.get(name) {
    case let v Some {String.fromBytes(v)}
    case is None[&Array[u8]] {String.from("-")}
  }
}

fn serve(sv: &mut Srv, lp: &mut Loop, e: &mut httpconn.Event) {
  let kind = e.kind;
  if kind == httpconn.EventKind.Accepted {
    sv.accepted = sv.accepted + 1u64;
    sv.open = sv.open + 1u64;
    if sv.open > sv.maxOpen {sv.maxOpen = sv.open;}
  } elif kind == httpconn.EventKind.Closed {
    sv.open = sv.open - 1u64;
  } elif kind == httpconn.EventKind.Request {
    sv.requests = sv.requests + 1u64;
    sv.order.push(e.request.target.copy());
    sv.reqs.push(e.req);
    sv.conns.push(e.conn);
    sv.methods.push(e.request.method);
    sv.targets.push(e.request.target.copy());
    sv.bodies.push(String.empty());
    sv.auths.push(fieldOr(&e.request.headers, "Authorization"));
    sv.cookies.push(fieldOr(&e.request.headers, "Cookie"));
  } elif kind == httpconn.EventKind.Data {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {(&mut sv.bodies[k]).appendBytes(e.buf.view());}
    sv.drv.release(e.req, e.buf.len());
  } elif kind == httpconn.EventKind.End {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {answer(sv, lp, k);}
  } elif kind == httpconn.EventKind.Writable {
    let j = findStream(sv, e.req);
    if j < sv.streams.len() {pumpStream(sv, j);}
  } elif e.isTerminal() {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {forget(sv, k);}
    let j = findStream(sv, e.req);
    if j < sv.streams.len() {dropStream(sv, j);}
  }
}

// One turn of the loop: the client's completions to it, the server's to
// its driver; the server's events answered; the client's appended to out
fn step(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, out: &mut List[Event], until: Instant) {
  var sevs = List[httpconn.Event].empty();
  cl.pump(lp, out);
  sv.drv.pump(lp, &mut sevs);
  var limit = until;
  let a = cl.wakeAt();
  if a < limit {limit = a;}
  let b = sv.drv.wakeAt();
  if b < limit {limit = b;}
  if out.len() > 0usize || sevs.len() > 0usize {limit = Instant();}
  var comps = List[Completion].empty();
  lp.poll(limit, &mut comps);
  var k = 0usize;
  while k < comps.len() {
    let c = &mut comps[k];
    if !cl.complete(lp, c) {sv.drv.complete(lp, c);}
    k = k + 1usize;
  }
  comps.clear();
  sv.drv.pump(lp, &mut sevs);
  k = 0usize;
  while k < sevs.len() {
    serve(sv, lp, &mut sevs[k]);
    k = k + 1usize;
  }
  cl.pump(lp, out);
}

// The server's every connection reset, and its buffers home
fn stopServer(sv: &mut Srv, lp: &mut Loop) {
  sv.drv.abortAll(lp);
  var sevs = List[httpconn.Event].empty();
  sv.drv.pump(lp, &mut sevs);
}

fn url(port: u16, path: &str) String {
  var u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u
}

// ---------------------------------------------------------------------------
// What the client saw
// ---------------------------------------------------------------------------

struct Seen {
  pub status: u16;
  pub body: String;
  pub url: String;
  pub kinds: String;          // each event's kind's first letter, in order
  pub finals: u64;
  pub last: EventKind;
  pub failure: String;
  pub stage: Stage;
  pub timing: Timing;
}

fn seen() Seen {
  Seen(status: 0u16, body: String.empty(), url: String.empty(), kinds: String.empty(), finals: 0u64,
    last: EventKind.Done, failure: String.empty(), stage: Stage.Url, timing: Timing.zero())
}

fn note(cl: &mut Client, s: &mut Seen, e: &mut Event) {
  let n = eventName(e.kind);
  s.kinds.appendByte(n[0usize]);
  if e.kind == EventKind.Response {
    s.status = e.response.status;
    s.url = e.url.copy();
  } elif e.kind == EventKind.Data {
    s.body.appendBytes(e.buf.view());
    cl.release(e.id, e.buf.len());
  } elif e.isTerminal() {
    s.finals = s.finals + 1u64;
    s.last = e.kind;
    s.timing = e.timing;
    if e.kind == EventKind.Failed {
      s.failure = e.failure.message();
      s.stage = e.failure.stage;
    }
  }
}

// Drive until fetch id has its final answer, its events noted in s
fn finishOf(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, id: FetchId, s: &mut Seen) {
  var out = List[Event].empty();
  let giveUp = Instant.now() + Duration.fromSeconds(10i64);
  let before = s.finals;
  while s.finals == before && Instant.now() < giveUp {
    step(cl, sv, lp, &mut out, giveUp);
    var k = 0usize;
    while k < out.len() {
      let e = &mut out[k];
      if e.id == id {note(cl, s, e);}
      k = k + 1usize;
    }
    out.clear();
  }
  requireUInt(s.finals, before + 1u64, "the fetch has its final answer in time");
}

// A request sent and driven to its final answer: what was seen
fn fetchSeen(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, r: Request) Seen {
  var s = seen();
  let id = cl.send(lp, r, Sink.Here(1u64));
  finishOf(cl, sv, lp, id, &mut s);
  s
}

// Drive for a while
fn idleFor(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, d: Duration) {
  var out = List[Event].empty();
  let until = Instant.now() + d;
  while Instant.now() < until {
    step(cl, sv, lp, &mut out, until);
    var k = 0usize;
    while k < out.len() {
      let e = &mut out[k];
      if e.kind == EventKind.Data {cl.release(e.id, e.buf.len());}
      k = k + 1usize;
    }
    out.clear();
  }
}

const mib = 1048576u64;

// The pool's bytes lent now: both ends' buffers
fn lent(pool: &Pool) u64 {
  let s = pool.stats();
  u64.from(s.heldBytes - s.idleBytes)
}

// Whether buf holds the body's bytes from offset 'at'
fn pattern(buf: &Array[u8], at: u64) bool {
  var i = 0usize;
  while i < buf.len {
    if buf[i] != u8.from((at + u64.from(i)) % 251u64) {return false;}
    i = i + 1usize;
  }
  true
}

// What a body's reader found
struct Read {
  pub bytes: u64;
  pub good: bool;
  pub last: EventKind;
  pub finals: u64;
  pub peakLent: u64;
  pub peakHeld: u64;        // bytes the consumer held unreleased, at the most
}

// Fetch /big/n, the consumer releasing at most 'perStep' bytes a turn of
// the loop (0: all at once): what it read
fn readBig(cl: &mut Client, sv: &mut Srv, lp: &mut Loop, pool: &Pool, port: u16, n: u64, perStep: usize) Read {
  var path = String.from("/big/");
  path.appendUInt(n);
  let id = cl.get(lp, url(port, path.view()).view(), Sink.Here(1u64));
  var r = Read(0u64, true, EventKind.Data, 0u64, 0u64, 0u64);
  var kept = List[IoBuf].empty();
  var keptBytes = 0usize;
  var out = List[Event].empty();
  let giveUp = Instant.now() + Duration.fromSeconds(60i64);
  while (r.finals == 0u64 || kept.len() > 0usize) && Instant.now() < giveUp {
    step(cl, sv, lp, &mut out, giveUp);
    var k = 0usize;
    while k < out.len() {
      let e = &mut out[k];
      k = k + 1usize;
      if e.id != id {continue;}
      if e.kind == EventKind.Data {
        if !pattern(e.buf.view(), r.bytes) {r.good = false;}
        r.bytes = r.bytes + u64.from(e.buf.len());
        if perStep == 0usize {
          cl.release(e.id, e.buf.len());
        } else {
          keptBytes = keptBytes + e.buf.len();
          var b = IoBuf.empty();
          b <-> e.buf;
          kept.push(b);
        }
      } elif e.isTerminal() {
        r.finals = r.finals + 1u64;
        r.last = e.kind;
      }
    }
    out.clear();
    if u64.from(keptBytes) > r.peakHeld {r.peakHeld = u64.from(keptBytes);}
    let l = lent(pool);
    if l > r.peakLent {r.peakLent = l;}
    // The slow consumer: the oldest of what it holds, perStep at a time
    var freed = 0usize;
    var gone = 0usize;
    while gone < kept.len() && freed < perStep {
      freed = freed + kept[gone].len();
      gone = gone + 1usize;
    }
    if gone > 0usize {
      var rest = List[IoBuf].empty();
      var j = gone;
      while j < kept.len() {
        var b = IoBuf.empty();
        let slotRef = &mut kept[j];
        b <-> *slotRef;
        rest.push(b);
        j = j + 1usize;
      }
      kept <-> rest;           // what was released dies here, home to the pool
      keptBytes = keptBytes - freed;
      cl.release(id, freed);
    }
  }
  r
}

// A channel's reader, on its own thread: every event of one fetch, in
// order, the final answer last; slow, a millisecond every eight events
struct ChanRead {
  pub bytes: u64;
  pub good: bool;
  pub responses: u64;
  pub ends: u64;
  pub finals: u64;
  pub doneLast: bool;
}

fn chanReader(rx: Receiver[Event]) ChanRead {
  var r = ChanRead(0u64, true, 0u64, 0u64, 0u64, false);
  var inbox = rx;
  var seen = 0u64;
  while true {
    var e = Event.make(EventKind.Data, 0u64, FetchId.none());
    match inbox.recv() {
      case var s Some {e <-> s;}
      case is None[Event] {break;}
    }
    seen = seen + 1u64;
    if seen % 8u64 == 0u64 {thread.sleep(Duration.fromMillis(1i64));}
    if r.finals > 0u64 {r.good = false;}
    if e.kind == EventKind.Response {r.responses = r.responses + 1u64;}
    elif e.kind == EventKind.Data {
      if !pattern(e.buf.view(), r.bytes) {r.good = false;}
      r.bytes = r.bytes + u64.from(e.buf.len());
    } elif e.kind == EventKind.End {r.ends = r.ends + 1u64;}
    elif e.isTerminal() {
      r.finals = r.finals + 1u64;
      r.doneLast = e.kind == EventKind.Done;
      break;
    }
  }
  r
}

fn main() i32 {
  let pool = Pool.make();
  var lp = Loop.mustMake();
  var sv = server(pool);
  let port = listen(&mut sv, &mut lp);
  require(port != 0u16, "the server listens");
  var cl = Client.make(Config.make(), pool);

  // A 16 MiB body, released as it comes
  let fast = readBig(&mut cl, &mut sv, &mut lp, &pool, port, 16u64 * mib, 0usize);
  expect(fast.last == EventKind.Done && fast.finals == 1u64, "16 MiB: Done, once");
  expectUInt(fast.bytes, 16u64 * mib, "...every byte");
  expect(fast.good, "...each the right one");
  expect(fast.peakLent <= 2u64 * mib, "...the bytes lent never past 2 MiB");

  // A slow consumer: 16 KiB released a turn; the link slows, memory does not grow
  let slow = readBig(&mut cl, &mut sv, &mut lp, &pool, port, 8u64 * mib, 16384usize);
  expect(slow.last == EventKind.Done && slow.finals == 1u64, "8 MiB to a slow consumer: Done, once");
  expectUInt(slow.bytes, 8u64 * mib, "...every byte");
  expect(slow.good, "...each the right one");
  expect(slow.peakHeld <= 262144u64 + 65536u64, "...the consumer never held more than the window (256 KiB)");
  expect(slow.peakLent <= 2u64 * mib, "...the bytes lent never past 2 MiB");

  // Cancelled mid-body: Cancelled, nothing after; its connection reset
  {
    let id = cl.get(&mut lp, url(port, "/stall").view(), Sink.Here(2u64));
    var out = List[Event].empty();
    var kinds = String.empty();
    var cancelled = false;
    var finals = 0u64;
    let giveUp = Instant.now() + Duration.fromSeconds(10i64);
    let openBefore = sv.open;
    while finals == 0u64 && Instant.now() < giveUp {
      step(&mut cl, &mut sv, &mut lp, &mut out, giveUp);
      var k = 0usize;
      while k < out.len() {
        let e = &mut out[k];
        k = k + 1usize;
        kinds.appendByte(eventName(e.kind)[0usize]);
        if e.kind == EventKind.Data {
          cl.release(e.id, e.buf.len());
          if !cancelled {
            expect(cl.cancel(&mut lp, id), "cancel mid-body: its answer to come");
            cancelled = true;
          }
        }
        if e.isTerminal() {finals = finals + 1u64;}
      }
      out.clear();
    }
    idleFor(&mut cl, &mut sv, &mut lp, Duration.fromMillis(50i64));
    expect(kinds.startsWith("RD") && kinds.endsWith("C"), "Response, Data..., then Cancelled");
    expectUInt(finals, 1u64, "...one final answer, nothing after it");
    expect(sv.open < openBefore || sv.open == 0u64, "...its connection reset: the server's side closed");
  }

  // Through a bounded channel to a slow thread
  {
    var tx: Sender[Event];
    var rx: Receiver[Event];
    tx, rx = Channel[Event].bounded(4u64);
    let reader = thread.start(rx, &chanReader);
    let id = cl.get(&mut lp, url(port, "/big/4194304").view(), Sink.Chan(3u64, tx));
    var out = List[Event].empty();
    var peak = 0u64;
    let giveUp = Instant.now() + Duration.fromSeconds(60i64);
    while (cl.live() > 0u32 || cl.held() > 0usize) && Instant.now() < giveUp {
      step(&mut cl, &mut sv, &mut lp, &mut out, giveUp);
      out.clear();
      let l = lent(&pool);
      if l > peak {peak = l;}
    }
    let r = reader.join();
    expectUInt(r.bytes, 4u64 * mib, "4 MiB through a channel of 4: every byte");
    expect(r.good, "...each the right one, nothing after the final answer");
    expect(r.responses == 1u64 && r.ends == 1u64 && r.finals == 1u64 && r.doneLast,
      "...one Response, one End, one Done, last");
    expect(peak <= 2u64 * mib, "...the bytes lent never past 2 MiB");
    expect(cl.stats().held > 0u64, "...the channel was full at times: events held, none lost");
    expectUInt(cl.stats().dropped, 0u64, "...none dropped");
  }

  let s = cl.stats();
  expectUInt(s.fetches, s.done + s.failed + s.cancelled + s.timedOut, "every fetch has had its one final answer");
  cl.abortAll(&mut lp);
  idleFor(&mut cl, &mut sv, &mut lp, Duration.fromMillis(50i64));
  stopServer(&mut sv, &mut lp);
  expectUInt(pool.stats().lent, 0u64, "every buffer back in the pool");
  done()
}
