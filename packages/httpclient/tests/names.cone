// The text of httpclient's enums, every variant: a stage's and an intent's lower-case
// name, and an event kind's variant name (which its debug form is too). Pinned so the
// text cannot drift when the way it is asked for changes.

mod names;

import testing use *;
import collections use String;
import httpclient use *;

fn main() i32 {
  expectStr(stageName(Stage.Url), "url", "stage Url");
  expectStr(stageName(Stage.Queue), "queue", "stage Queue");
  expectStr(stageName(Stage.Resolve), "resolve", "stage Resolve");
  expectStr(stageName(Stage.Connect), "connect", "stage Connect");
  expectStr(stageName(Stage.Read), "read", "stage Read");
  expectStr(stageName(Stage.Write), "write", "stage Write");
  expectStr(stageName(Stage.Http), "http", "stage Http");
  expectStr(stageName(Stage.Tls), "tls", "stage Tls");
  expectStr(stageName(Stage.Closed), "closed", "stage Closed");
  expectStr(stageName(Stage.Limit), "limit", "stage Limit");
  expectStr(stageName(Stage.Redirect), "redirect", "stage Redirect");
  expectStr(intentName(Intent.Urgent), "urgent", "intent Urgent");
  expectStr(intentName(Intent.Visible), "visible", "intent Visible");
  expectStr(intentName(Intent.Prefetch), "prefetch", "intent Prefetch");
  expectStr(intentName(Intent.Background), "background", "intent Background");
  expectStr(eventName(EventKind.Response), "Response", "event Response");
  expectStr(eventName(EventKind.Data), "Data", "event Data");
  expectStr(eventName(EventKind.End), "End", "event End");
  expectStr(eventName(EventKind.Done), "Done", "event Done");
  expectStr(eventName(EventKind.Failed), "Failed", "event Failed");
  expectStr(eventName(EventKind.Cancelled), "Cancelled", "event Cancelled");
  expectStr(eventName(EventKind.TimedOut), "TimedOut", "event TimedOut");
  let d = EventKind.Done;
  expectStr((String() <- toDebug(&d)).view(), "Done", "an event kind's debug form is its variant");
  done()
}
