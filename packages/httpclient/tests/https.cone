// HTTPS, offline: a TLS server on 127.0.0.1 (the tls package's test
// certificates, its test root given to the client as its only trust
// anchor) on the client's Loop. Checked: five GETs one after another on one
// TLS connection, one handshake; two at once, the kept connection reused and
// a new one resuming from a ticket the kept one was sent, while it is still
// open; three at once after both close, two resuming from the tickets the
// client's one context cached (TLS contexts are shared per client) and the
// third finding none left; an http origin beside it; a
// server whose certificate the client does not trust failing its fetch at
// Stage.Tls, and the one waiting behind it too, never retried.

mod https;

import testing use *;
import fs;
import path use Path;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use Loop, SocketAddr, Completion, forever;
import http use *;
import httpconn;
import tls;
import httpclient use *;

// ---------------------------------------------------------------------------
// The loopback server: httpconn's own driver on the client's Loop. What it
// answers is chosen by the request's path:
//   /hello             200 "hello" (and any path not below)
//   /echo              200, the method, a space, and the request's body
//   /nobody            204
//   /close             no answer: the connection is reset
//   /closeonce         the first time, as /close; after, 200 "second"
//   /redirect/N        302 to /redirect/N-1; /redirect/0 is 200 "landed"
//   /status/C?L        status C, Location L when L is given, body "moved"
//   /headers           200 "auth=A;cookie=C;method=M;body=B" ('-' for none)
//   /big/N             200, N bytes, byte i being i % 251, sent as taken
//   /stall             200 with 1 MiB to come; 64 KiB of it sent, then nothing
//   /hang              nothing at all
//   /order/L           200 L
// Every request's target is kept in 'order', in the order they came.
// ---------------------------------------------------------------------------

const tokSrv = 100u64;

struct Srv {
  pub drv httpconn.Driver;
  pub pool Pool;
  pub accepted u64;
  pub open u64;
  pub maxOpen u64;
  pub requests u64;
  pub closedOnce bool;
  pub order List[String];
  pub reqs List[httpconn.ReqId];
  pub conns List[httpconn.ConnId];
  pub methods List[Method];
  pub targets List[String];
  pub bodies List[String];
  pub auths List[String];
  pub cookies List[String];
  pub streams List[httpconn.ReqId];
  pub sent List[u64];
  pub totals List[u64];
}

fn server(pool Pool) Srv {
  new Srv(drv: httpconn.Driver.make(httpconn.Config.make(), pool), pool: pool, accepted: 0u64,
    open: 0u64, maxOpen: 0u64, requests: 0u64, closedOnce: false, order: List[String].empty(),
    reqs: List[httpconn.ReqId].empty(), conns: List[httpconn.ConnId].empty(), methods: List[Method].empty(),
    targets: List[String].empty(), bodies: List[String].empty(), auths: List[String].empty(),
    cookies: List[String].empty(), streams: List[httpconn.ReqId].empty(), sent: List[u64].empty(),
    totals: List[u64].empty());
}

fn listen(sv &mut Srv, lp &mut Loop) u16 {
  mut port = 0u16;
  match sv.drv.listen(lp, SocketAddr.localhost(0u16), httpconn.Sink.Here[tokSrv]) {
    case imm r Ok {
      match sv.drv.localAddr(lp, r.value) {
        case imm a Ok {port = a.value.port();}
        case imm e Error {}
      }
    }
    case imm e Error {}
  }
  port;
}

fn reply(sv &mut Srv, req httpconn.ReqId, head bool, status u16, location &Array[u8], body &Array[u8]) {
  mut h = ResponseHead.make(status);
  if location.len > 0usize {h.headers.add("Location", location);}
  sv.drv.respond(req, h, BodyLength.sized(u64.from(body.len)));
  if body.len > 0usize and not head {
    mut b = sv.pool.mustTake(body.len);
    b.append(body);
    sv.drv.sendData(req, b);
    sv.drv.finish(req);
  }
}

fn number(s &str) u64 {
  match collections.parseUInt(s) {
    case imm v Some {v.value;}
    case is None[u64] {0u64;}
  }
}

// Stream j's next pieces, as many as the connection takes now
fn pumpStream(sv &mut Srv, j usize) {
  imm req = *sv.streams[j];
  while *sv.sent[j] < *sv.totals[j] {
    imm at = *sv.sent[j];
    imm left = *sv.totals[j] - at;
    imm n = if left < 65536u64 {usize.from(left);} else {65536usize;};
    mut b = sv.pool.mustTake(n);
    imm s = b.spare();
    mut i = 0usize;
    while i < n {
      s[i] = u8.from((at + u64.from(i)) % 251u64);
      i = i + 1usize;
    }
    b.setLen(n);
    match sv.drv.sendData(req, b) {
      case is None[IoBuf] {sv.sent.set(j, at + u64.from(n));}
      else {return;}
    }
  }
  sv.drv.finish(req);
  dropStream(sv, j);
}

fn dropStream(sv &mut Srv, j usize) {
  imm last = sv.streams.len() - 1usize;
  sv.streams.swap(j, last);
  sv.sent.swap(j, last);
  sv.totals.swap(j, last);
  sv.streams.pop();
  sv.sent.pop();
  sv.totals.pop();
}

fn findStream(sv &Srv, req httpconn.ReqId) usize {
  mut j = 0usize;
  while j < sv.streams.len() {
    if *sv.streams[j] == req {return j;}
    j = j + 1usize;
  }
  sv.streams.len();
}

// The answer to request k, read whole
fn answer(sv &mut Srv, lp &mut Loop, k usize) {
  imm req = *sv.reqs[k];
  imm full = sv.targets[k].copy();
  imm t = full.view();
  mut q = 0usize;
  while q < t.len and t[q] != '?' {q = q + 1usize;}
  imm path = &t[0usize .. q];
  imm query = &t[(if q < t.len {q + 1usize;} else {q;}) ..];
  imm head = *sv.methods[k] == Method.Head[];
  if path == "/echo" {
    mut b = String.from(methodToken(*sv.methods[k]));
    b.append(" ");
    b.append(sv.bodies[k].view());
    reply(sv, req, head, 200u16, "", b.view());
  } elif path == "/nobody" {
    reply(sv, req, head, 204u16, "", "");
  } elif path == "/close" {
    sv.drv.abort(lp, *sv.conns[k]);
  } elif path == "/closeonce" {
    if not sv.closedOnce {
      sv.closedOnce = true;
      sv.drv.abort(lp, *sv.conns[k]);
    } else {
      reply(sv, req, head, 200u16, "", "second");
    }
  } elif path.len > 10usize and &path[0usize .. 10usize] == "/redirect/" {
    imm n = number(&path[10usize ..]);
    if n == 0u64 {
      reply(sv, req, head, 200u16, "", "landed");
    } else {
      mut loc = String.from("/redirect/");
      loc.appendUInt(n - 1u64);
      reply(sv, req, head, 302u16, loc.view(), "moved");
    }
  } elif path.len > 8usize and &path[0usize .. 8usize] == "/status/" {
    reply(sv, req, head, u16.from(number(&path[8usize ..])), query, "moved");
  } elif path == "/headers" {
    mut b = String.from("auth=");
    b.append(sv.auths[k].view());
    b.append(";cookie=");
    b.append(sv.cookies[k].view());
    b.append(";method=");
    b.append(methodToken(*sv.methods[k]));
    b.append(";body=");
    b.append(if sv.bodies[k].len() == 0usize {"-";} else {sv.bodies[k].view();});
    reply(sv, req, head, 200u16, "", b.view());
  } elif path.len > 5usize and &path[0usize .. 5usize] == "/big/" {
    imm n = number(&path[5usize ..]);
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(n));
    sv.streams.push(req);
    sv.sent.push(0u64);
    sv.totals.push(n);
    pumpStream(sv, sv.streams.len() - 1usize);
  } elif path == "/stall" {
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(1048576u64));
    mut b = sv.pool.mustTake(65536usize);
    b.setLen(65536usize);
    sv.drv.sendData(req, b);
  } elif path == "/hang" {
  } elif path.len > 7usize and &path[0usize .. 7usize] == "/order/" {
    reply(sv, req, head, 200u16, "", &path[7usize ..]);
  } else {
    reply(sv, req, head, 200u16, "", "hello");
  }
}

fn findReq(sv &Srv, req httpconn.ReqId) usize {
  mut k = 0usize;
  while k < sv.reqs.len() {
    if *sv.reqs[k] == req {return k;}
    k = k + 1usize;
  }
  sv.reqs.len();
}

fn forget(sv &mut Srv, k usize) {
  imm last = sv.reqs.len() - 1usize;
  sv.reqs.swap(k, last);
  sv.conns.swap(k, last);
  sv.methods.swap(k, last);
  sv.targets.swap(k, last);
  sv.bodies.swap(k, last);
  sv.auths.swap(k, last);
  sv.cookies.swap(k, last);
  sv.reqs.pop();
  sv.conns.pop();
  sv.methods.pop();
  sv.targets.pop();
  sv.bodies.pop();
  sv.auths.pop();
  sv.cookies.pop();
}

fn fieldOr(h &Headers, name &str) String {
  match h.get(name) {
    case imm v Some {String.fromBytes(v.value);}
    case is None[&Array[u8]] {String.from("-");}
  }
}

fn serve(sv &mut Srv, lp &mut Loop, e &mut httpconn.Event) {
  imm kind = e.kind;
  if kind == httpconn.EventKind.Accepted[] {
    sv.accepted = sv.accepted + 1u64;
    sv.open = sv.open + 1u64;
    if sv.open > sv.maxOpen {sv.maxOpen = sv.open;}
  } elif kind == httpconn.EventKind.Closed[] {
    sv.open = sv.open - 1u64;
  } elif kind == httpconn.EventKind.Request[] {
    sv.requests = sv.requests + 1u64;
    sv.order.push(e.request.target.copy());
    sv.reqs.push(e.req);
    sv.conns.push(e.conn);
    sv.methods.push(e.request.method);
    sv.targets.push(e.request.target.copy());
    sv.bodies.push(String.empty());
    sv.auths.push(fieldOr(&e.request.headers, "Authorization"));
    sv.cookies.push(fieldOr(&e.request.headers, "Cookie"));
  } elif kind == httpconn.EventKind.Data[] {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {(&mut sv.bodies[k]).appendBytes(e.buf.view());}
    sv.drv.release(e.req, e.buf.len());
  } elif kind == httpconn.EventKind.End[] {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {answer(sv, lp, k);}
  } elif kind == httpconn.EventKind.Writable[] {
    imm j = findStream(sv, e.req);
    if j < sv.streams.len() {pumpStream(sv, j);}
  } elif e.isTerminal() {
    imm k = findReq(sv, e.req);
    if k < sv.reqs.len() {forget(sv, k);}
    imm j = findStream(sv, e.req);
    if j < sv.streams.len() {dropStream(sv, j);}
  }
}

// One turn of the loop: the client's completions to it, the server's to
// its driver; the server's events answered; the client's appended to out
fn step(cl &mut Client, sv &mut Srv, lp &mut Loop, out &mut List[Event], until Instant) {
  mut sevs = List[httpconn.Event].empty();
  cl.pump(lp, out);
  sv.drv.pump(lp, &mut sevs);
  mut limit = until;
  imm a = cl.wakeAt();
  if a < limit {limit = a;}
  imm b = sv.drv.wakeAt();
  if b < limit {limit = b;}
  if out.len() > 0usize or sevs.len() > 0usize {limit = new Instant();}
  mut comps = List[Completion].empty();
  lp.poll(limit, &mut comps);
  mut k = 0usize;
  while k < comps.len() {
    imm c = &mut comps[k];
    if not cl.complete(lp, c) {sv.drv.complete(lp, c);}
    k = k + 1usize;
  }
  comps.clear();
  sv.drv.pump(lp, &mut sevs);
  k = 0usize;
  while k < sevs.len() {
    serve(sv, lp, &mut sevs[k]);
    k = k + 1usize;
  }
  cl.pump(lp, out);
}

// The server's every connection reset, and its buffers home
fn stopServer(sv &mut Srv, lp &mut Loop) {
  sv.drv.abortAll(lp);
  mut sevs = List[httpconn.Event].empty();
  sv.drv.pump(lp, &mut sevs);
}

fn url(port u16, path &str) String {
  mut u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u;
}

// ---------------------------------------------------------------------------
// What the client saw
// ---------------------------------------------------------------------------

struct Seen {
  pub status u16;
  pub body String;
  pub url String;
  pub kinds String;          // each event's kind's first letter, in order
  pub finals u64;
  pub last EventKind;
  pub failure String;
  pub stage Stage;
  pub timing Timing;
}

fn seen() Seen {
  new Seen(status: 0u16, body: String.empty(), url: String.empty(), kinds: String.empty(), finals: 0u64,
    last: EventKind.Done[], failure: String.empty(), stage: Stage.Url[], timing: Timing.zero());
}

fn note(cl &mut Client, s &mut Seen, e &mut Event) {
  imm n = eventName(e.kind);
  s.kinds.appendByte(n[0usize]);
  if e.kind == EventKind.Response[] {
    s.status = e.response.status;
    s.url = e.url.copy();
  } elif e.kind == EventKind.Data[] {
    s.body.appendBytes(e.buf.view());
    cl.release(e.id, e.buf.len());
  } elif e.isTerminal() {
    s.finals = s.finals + 1u64;
    s.last = e.kind;
    s.timing = e.timing;
    if e.kind == EventKind.Failed[] {
      s.failure = e.failure.message();
      s.stage = e.failure.stage;
    }
  }
}

// Drive until fetch id has its final answer, its events noted in s
fn finishOf(cl &mut Client, sv &mut Srv, lp &mut Loop, id FetchId, s &mut Seen) {
  mut out = List[Event].empty();
  imm giveUp = Instant.now() + Duration.fromSeconds(10i64);
  imm before = s.finals;
  while s.finals == before and Instant.now() < giveUp {
    step(cl, sv, lp, &mut out, giveUp);
    mut k = 0usize;
    while k < out.len() {
      imm e = &mut out[k];
      if e.id == id {note(cl, s, e);}
      k = k + 1usize;
    }
    out.clear();
  }
  requireUInt(s.finals, before + 1u64, "the fetch has its final answer in time");
}

// A request sent and driven to its final answer: what was seen
fn fetchSeen(cl &mut Client, sv &mut Srv, lp &mut Loop, r Request) Seen {
  mut s = seen();
  imm id = cl.send(lp, r, Sink.Here[1u64]);
  finishOf(cl, sv, lp, id, &mut s);
  s;
}

// Drive for a while
fn idleFor(cl &mut Client, sv &mut Srv, lp &mut Loop, d Duration) {
  mut out = List[Event].empty();
  imm until = Instant.now() + d;
  while Instant.now() < until {
    step(cl, sv, lp, &mut out, until);
    mut k = 0usize;
    while k < out.len() {
      imm e = &mut out[k];
      if e.kind == EventKind.Data[] {cl.release(e.id, e.buf.len());}
      k = k + 1usize;
    }
    out.clear();
  }
}

// The tls package's test certificates
fn certs(name &str) Path {
  mut p = String.from("../../../../../tls/tests/certs/");
  p.append(name);
  Path.fromString(p);
}

fn readText(name &str) String {
  mut out = String.empty();
  imm file = certs(name);
  match fs.readFile(&file) {
    case mut r Ok {out <=> r.value;}
    case imm e Error {}
  }
  out;
}

// The listener's layers: a TLS server session each, from one context
struct TlsMaker {
  server tls.Server;
  pool Pool;

  pub fn make(self &mut) So[httpconn.Layer] {new So[tls.Stream](server.stream(pool));}
}

fn tlsServer(cert &str, key &str) tls.Server {
  imm certFile = certs(cert);
  imm keyFile = certs(key);
  match tls.Server.make(tls.ServerConfig.make(&certFile, &keyFile)) {
    case imm r Ok {
      imm s = r.value;
      return s;
    }
    case imm e Error {}
  }
  panic("no TLS server: run the test from its build folder");
}

fn listenTls(sv &mut Srv, lp &mut Loop, s tls.Server) u16 {
  mut port = 0u16;
  match sv.drv.listenWith(lp, SocketAddr.localhost(0u16), new So[TlsMaker](new TlsMaker(s, sv.pool)),
      httpconn.Sink.Here[tokSrv]) {
    case imm r Ok {
      match sv.drv.localAddr(lp, r.value) {
        case imm a Ok {port = a.value.port();}
        case imm e Error {}
      }
    }
    case imm e Error {}
  }
  port;
}

fn secure(port u16, path &str) String {
  mut u = String.from("https://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u;
}

// n GETs of /hello asked for at once, driven to their final answers: how
// many were Done
fn atOnce(cl &mut Client, sv &mut Srv, lp &mut Loop, port u16, n u32) u32 {
  mut k = 0u32;
  while k < n {
    cl.get(lp, secure(port, "/hello").view(), Sink.Here[2u64]);
    k = k + 1u32;
  }
  mut out = List[Event].empty();
  mut dones = 0u32;
  mut finals = 0u32;
  imm giveUp = Instant.now() + Duration.fromSeconds(10i64);
  while finals < n and Instant.now() < giveUp {
    step(cl, sv, lp, &mut out, giveUp);
    mut j = 0usize;
    while j < out.len() {
      imm e = &mut out[j];
      if e.kind == EventKind.Data[] {cl.release(e.id, e.buf.len());}
      if e.isTerminal() {
        finals = finals + 1u32;
        if e.kind == EventKind.Done[] {dones = dones + 1u32;}
      }
      j = j + 1usize;
    }
    out.clear();
  }
  dones;
}

fn main() i32 {
  imm pool = Pool.make();
  mut lp = Loop.mustMake();
  mut sv = server(pool);
  imm good = listenTls(&mut sv, &mut lp, tlsServer("server.pem", "server.key"));
  imm untrusted = listenTls(&mut sv, &mut lp, tlsServer("untrusted.pem", "untrusted.key"));
  imm plain = listen(&mut sv, &mut lp);
  require(good != 0u16 and untrusted != 0u16 and plain != 0u16, "three servers listen");
  mut cfg = Config.make();
  cfg.tlsConfig.verify = tls.Verifier.roots(readText("ca.pem").view());
  cfg.tlsConfig.offline = true;
  cfg.maxPerOrigin = 3u32;
  mut cl = Client.make(cfg, pool);

  // Five GETs one after another: one TLS connection, one handshake each side
  imm t0 = tls.stats();
  mut k = 0u32;
  mut oks = 0u32;
  while k < 5u32 {
    imm s = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(secure(good, "/hello").view()));
    if s.last == EventKind.Done[] and s.status == 200u16 and s.body.view() == "hello" {oks = oks + 1u32;}
    if k > 0u32 and not s.timing.reused {oks = 0u32;}
    k = k + 1u32;
  }
  expectUInt(u64.from(oks), 5u64, "five HTTPS GETs, each Done, the later four on the kept connection");
  expectUInt(sv.accepted, 1u64, "...one connection");
  imm t1 = tls.stats();
  expectUInt(t1.handshakes - t0.handshakes, 2u64, "...one handshake, on each side");

  // Two at once, the kept connection pooled: it takes one, and a new
  // connection the other, resuming from a ticket the kept one was sent
  // after its handshake, while it is still open
  expectUInt(u64.from(atOnce(&mut cl, &mut sv, &mut lp, good, 2u32)), 2u64, "two at once beside the kept connection: Done");
  expectUInt(sv.accepted, 2u64, "...one more connection");
  imm t1a = tls.stats();
  expectUInt(t1a.handshakes - t1.handshakes, 2u64, "...one more handshake, on each side");
  expectUInt(t1a.resumed - t1.resumed, 2u64, "...resumed, on each side, the kept connection still open");

  // The kept connections closed: their tickets stay cached, to resume
  expectUInt(u64.from(cl.closeIdle(&mut lp)), 2u64, "closeIdle: the two idle connections");
  idleFor(&mut cl, &mut sv, &mut lp, Duration.fromMillis(50i64));
  expectUInt(u64.from(cl.stats().openNow), 0u64, "...closed");
  imm t1b = tls.stats();

  // Three at once: three new connections, two resuming from the two
  // tickets cached (the first connection's second, the second's one), the
  // third finding none left (each is used once)
  expectUInt(u64.from(atOnce(&mut cl, &mut sv, &mut lp, good, 3u32)), 3u64, "three at once: Done");
  expectUInt(sv.accepted, 5u64, "...three more connections");
  imm t2 = tls.stats();
  expectUInt(t2.handshakes - t1b.handshakes, 6u64, "...three handshakes, on each side");
  expectUInt(t2.resumed - t1b.resumed, 4u64, "...two of them resuming, on each side");
  mut out = List[Event].empty();

  // An http origin beside it
  imm p = fetchSeen(&mut cl, &mut sv, &mut lp, Request.get(url(plain, "/hello").view()));
  expect(p.last == EventKind.Done[] and p.body.view() == "hello", "http beside https: Done");
  expectUInt(u64.from(cl.stats().origins), 2u64, "two origins pooled");

  // A certificate the client does not trust: Failed at Stage.Tls, and the
  // one waiting for the same origin too; neither retried
  mut cfg1 = Config.make();
  cfg1.tlsConfig.verify = tls.Verifier.roots(readText("ca.pem").view());
  cfg1.tlsConfig.offline = true;
  cfg1.maxPerOrigin = 1u32;
  mut c1 = Client.make(cfg1, pool);
  imm a = c1.get(&mut lp, secure(untrusted, "/hello").view(), Sink.Here[3u64]);
  imm b = c1.get(&mut lp, secure(untrusted, "/hello").view(), Sink.Here[3u64]);
  mut sa = seen();
  mut sb = seen();
  imm giveUp2 = Instant.now() + Duration.fromSeconds(10i64);
  while (sa.finals == 0u64 or sb.finals == 0u64) and Instant.now() < giveUp2 {
    step(&mut c1, &mut sv, &mut lp, &mut out, giveUp2);
    mut j = 0usize;
    while j < out.len() {
      imm e = &mut out[j];
      if e.id == a {note(&mut c1, &mut sa, e);}
      if e.id == b {note(&mut c1, &mut sb, e);}
      j = j + 1usize;
    }
    out.clear();
  }
  expect(sa.last == EventKind.Failed[] and sa.stage == Stage.Tls[], "an untrusted certificate: Failed at Stage.Tls");
  expect(sa.failure.contains("unable to get local issuer certificate"), "...saying why");
  expectUInt(u64.from(sa.timing.attempts), 1u64, "...not retried");
  expect(sb.last == EventKind.Failed[] and sb.stage == Stage.Tls[], "the one waiting for that origin: Failed too");
  expectUInt(c1.stats().connects, 1u64, "...one connection tried");
  c1.abortAll(&mut lp);

  imm s = cl.stats();
  expectUInt(s.fetches, s.done + s.failed + s.cancelled + s.timedOut, "every fetch has had its one final answer");
  cl.abortAll(&mut lp);
  idleFor(&mut cl, &mut sv, &mut lp, Duration.fromMillis(50i64));
  stopServer(&mut sv, &mut lp);
  expectUInt(pool.stats().lent, 0u64, "every buffer back in the pool");
  done();
}
