// The Client: its tables, the driver's events it reads, and the scheduler.
//
// How it is built. Fetches and pooled connections are records in two
// tables, each in blocks of 64 that never move while the client lives,
// reused through free lists, as httpconn's are; a FetchId is a record's
// index and generation. Origins are records of their own, one per scheme,
// host and port the client has fetched from, each holding its queue of
// waiting fetches, its idle HTTP/1.1 connections and its shared HTTP/2 ones
// (a connection's protocol is its driver's 'protocol', asked at every pump
// until its TLS handshake has chosen one). Every connection and every
// request the client makes is its driver's, with a Here sink whose token
// names the client's record (and its generation), so the driver's events
// come back to the record they are about; the client's own timers (a
// fetch's deadline and group) are submitted with the driver's upperToken.
// An HTTP/3 connection is a pooled connection too, marked 'quic', whose
// requests and events are the plug-in's (its tokens the same shape); its
// name's lookup is an upperToken operation of the client's (bit 39 set),
// and an origin holds at most one ('h3c'), being made or shared.
//
// 'pump' takes the driver's events, turning each request's into the
// fetch's (or following a redirect, or retrying), each connection's into
// the pool's state; then the scheduler hands free connections to the best
// waiting fetches and opens connections where fetches wait; then the driver
// is pumped again so what was asked goes out, until nothing moves. Every
// final answer goes through 'finishFetch', which frees the record: so each
// fetch is answered once, by construction (I1).

const recsPerBlock = 64u32;
const genMask = 0xFFFFFFu32;
const watchGenMask = 0x7FFFu32;     // the generation a watch token keeps: 15 bits (the driver's 8 take room from its 48, and bit 39 is the kind)
const resolveBit = 0x8000000000u64; // bit 39 of an upper token: an HTTP/3 attempt's name lookup, not a fetch's watch
const resolveSize = 1024usize;      // a lookup's buffer: room for 32 addresses
const h3BrokenFor = 300i64;         // seconds an origin's HTTP/3 is not tried after an attempt fell back


// A fetch's state
const fFree = 0u32;
const fQueued = 1u32;       // waiting for a connection
const fActive = 2u32;       // its request on a connection

// A pooled connection's state
const pFree = 0u32;
const pConnecting = 1u32;
const pIdle = 2u32;
const pBusy = 3u32;
const pClosing = 4u32;      // on its way out: counted nowhere
const pShared = 5u32;       // HTTP/2: open, carrying any number of fetches, one a stream each

// What a pooled connection speaks, as far as the client knows
const protoUnknown = 0u32;  // not yet chosen: its TLS handshake (ALPN) is still under way
const protoH1 = 1u32;
const protoH2 = 2u32;
const protoH3 = 3u32;       // a QUIC connection of the HTTP/3 plug-in's: known from the start

// What scheduleH3 did for an origin
const h3No = 0u32;          // its fetches are TCP's
const h3Held = 1u32;        // they are HTTP/3's, and none could go now
const h3Did = 2u32;         // they are HTTP/3's: some went, or an attempt was made

// How a fetch ends
const endNone = 0u32;
const endDone = 1u32;
const endFailed = 2u32;
const endCancelled = 3u32;
const endTimedOut = 4u32;
const endLimit = 5u32;      // fetchWhole's limit passed: Failed, Stage.Limit

// The driver sinks' tokens: a connection's, a request's (+ generation << 32
// + index)
const tokConn = 0x4000000000000000u64;
const tokReq = 0x8000000000000000u64;
const kWatch = 1u8;

const sendChunk = 65536usize;          // the most of a body one send carries
const drainLimit = 65536usize;         // a redirect's body read past this is cut off

// A fetch
struct Fetch {
  gen: u32;                  // its pool handle's generation (a token carries the low 24 bits)
  state: u32;
  seq: u64;                  // the order asked
  intent: Intent;
  score: i64;
  sink: Sink;
  method: Method;
  methodText: String;
  url: Url;
  headers: HttpHeaders;
  body: String;
  origin: u32;
  conn: u32;                 // its pooled connection, while active
  connGen: u32;              // that connection's generation: its cell may be reused by another
  req: httpconn.ReqId;       // its request on the driver, the last attempt's
  qreq: H3Req;               // ...or on the HTTP/3 plug-in (none when the attempt is the driver's)
  deadline: Instant;
  group: Option[CancelGroup];
  watch: OpId;               // the timer for its deadline and group, or none
  ending: u32;               // asked to end while under way: endCancelled, endTimedOut, endLimit
  delivered: bool;           // its Response has gone to its sink
  following: bool;           // the response under way is a redirect to follow
  cutting: bool;             // ...whose body was cut off
  location: String;
  redirectStatus: u16;
  drained: usize;
  held: usize;               // body bytes delivered Here, not yet released
  sent: usize;               // body bytes sent, this attempt
  retries: u32;
  maxRedirects: u32;
  timing: Timing;
  // A streamed request body (sendUpload, pushBody, endBody): a queue of pieces, taken as the connection takes them.
  // Such a fetch is never sent twice (canRetry), and a redirect that would send the body again is its answer
  streamed: bool;
  upLen: BodyLength;         // the body's framing, said at sendUpload
  upq: Deque[IoBuf];         // pieces pushed and not yet taken by the connection
  upPushed: u64;             // bytes pushed
  upEnded: bool;             // endBody was called
  upFinished: bool;          // the connection was told the body is whole
  upGone: bool;              // the body is wanted no more (a response came before it was all sent): pieces pushed are dropped
  upWritable: bool;          // the connection has room: the last piece offered was taken, or it said Writable
  upAsked: bool;             // a BodyRoom event was sent since the last push
  qver: u64;                 // the version of its entry in its origin's queue (0: not waiting)
  qord: u64;                 // its place in the order it was queued (a failed origin's fetches are answered in it)
  head: RequestHead;         // the request's head, built at its first dispatch (see 'dispatch'), until a redirect changes it
  hasHead: bool;

  fn methodName(self: &) &str {
    if method == Method.Other {methodText.view()} else {methodToken(method)}
  }
}

// A pooled connection
struct PConn {
  gen: u32;                  // its pool handle's generation (a token carries the low 24 bits)
  state: u32;
  id: httpconn.ConnId;
  origin: u32;
  active: u32;               // fetches on it: one while busy (HTTP/1.1), any number shared (HTTP/2)
  uses: u32;                 // exchanges given it
  opened: Instant;           // when it was asked for: its lifetime runs from then
  proto: u32;                // what it speaks: protoUnknown until its driver has chosen
  awaiting: bool;            // connected, its protocol still to be chosen: in the client's 'undecided'
  quic: bool;                // the HTTP/3 plug-in's (qid), not the driver's (id)
  qid: u64;                  // ...its number there, once its name is looked up and its connect begun
  lookup: OpId;              // ...its name's lookup, while it runs
  h3By: Instant;             // ...connected by then, or it falls back (http3Timeout)
  idleStamp: u64;            // when it last became idle (the core's recency), or 0 while it is not
}

// The client's tables of fetches and pooled connections (the pool kind is spelled here
// and nowhere else; FetchId stays its own type, since it has its own methods)
alias Fetches = GenPool[Fetch];
alias PConns = GenPool[PConn];

// What of its Config a client keeps once made: its limits (the driver has
// the connection's, the TLS context the TLS config's)
pub struct Limits {
  pub maxPerOrigin: u32;
  pub maxTotal: u32;
  pub maxLifetime: Duration;
  pub maxQueued: u32;
  pub maxRetries: u32;
  pub maxRedirects: u32;
  pub userAgent: String;
  pub priorKnowledge: bool;      // http connections speak HTTP/2 from their first byte (the driver's h2PriorKnowledge)
  pub h3Origins: List[String];   // the origins (Url.origin) known to speak HTTP/3
  pub h3Timeout: Duration;
  pub maxStreams: u32;          // streams the client puts on one HTTP/2 connection (the peer's own limit may be lower; no limit of ours is 4294967295)
}

// An origin: its pool and its queue
struct Origin {
  key: String;               // 'https://example.com:443'
  secure: bool;
  host: String;              // without an IPv6 address's brackets
  port: u16;
  queue: PriorityQueue[FetchKey, WaitRef];   // fetches waiting, the first out first, entries invalidated lazily (the core's)
  wlive: u32;                // ...of them live: the fetches waiting
  idle: List[u32];           // pooled connections idle, the latest last
  shared: List[u32];         // HTTP/2 connections open (pShared), the first the one kept
  open: u32;                 // connections connecting, idle, busy or shared
  connecting: u32;
  undecided: u32;            // ...of them connected, their protocol still to be chosen
  h2: bool;                  // the last connection whose protocol was chosen spoke HTTP/2
  h3Port: u16;               // HTTP/3 is on this UDP port of its host (0: none known)
  h3Until: Instant;          // ...until then (an Alt-Svc's max-age; forever for prior knowledge)
  h3Prior: bool;             // ...by prior knowledge, which an Alt-Svc 'clear' leaves
  h3Broken: Instant;         // HTTP/3 is not tried before then (an attempt fell back)
  h3c: u32;                  // its HTTP/3 connection, being made or open, or noEntry
  gen: u32;                  // its cell's generation (the core's queues name it with it)
  refs: u32;                 // fetches that name it, waiting or under way
  recs: u32;                 // connection records that name it, closing ones too
  dirty: bool;               // on the core's list of origins the scheduler is to visit
  oVer: u32;                 // the version of its entry in the core's queue of origins that may open a connection
  lastUse: u64;              // the core's clock when a fetch last named it
  connected: bool;           // a connection to it has connected (what it learned is worth keeping)
  dk: String;                // its key in the core's Dict
}

// The client's table of origins (the pool kind is spelled here and nowhere else)
alias Origins = GenPool[Origin];

// What the client's connections' transports tell its pool of themselves: the driver's and the HTTP/3 plug-in's
// own state, which moves without the pool being told (the pool's ConnFacts)
struct Wire is ConnFacts {
  drv: httpconn.Driver;
  h3: Uni[Http3];                    // the HTTP/3 plug-in: the config's maker's, or NoHttp3

  pub fn isIdle(self: &, c: ConnRef) bool {drv.isIdle(c.id)}

  pub fn takes(self: &, c: ConnRef) bool {
    if !c.quic {return drv.takesRequests(c.id);}
    h3.takesRequests(c.qid)
  }

  pub fn protocol(self: &, c: ConnRef) Option[Version] {drv.protocol(c.id)}

  pub fn h3Room(self: &, c: ConnRef) bool {h3.hasRoom(c.qid)}
}

// A client of HTTP and HTTPS servers on one Loop (see the package's header)
pub struct Client {
  wire: Wire;                 // its driver and its HTTP/3 plug-in
  tlsc: Result[tls.Client, Failure];    // its https connections' TLS context, or why it could not be made
  cc: ClientCore;          // the pool: its tables, its decisions and its limits. This client is its host: it carries out the commands
  dev: List[httpconn.Event];
  comps: List[Completion];
  ready: List[Event];        // events for this thread, until pump hands them over
  h3evs: List[H3Event];

  // A client whose connections take cfg's limits and buffers from pool. Its
  // TLS context is made now from cfg.tlsConfig; if that fails (a root bundle
  // with no certificate), every https fetch fails with why (Stage.Tls). The
  // config is taken apart: the driver gets the connection's part, the TLS
  // context the TLS config, and the pool its limits
  pub fn make(cfg: Config, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Client {
    if cfg.maxPerOrigin == 0u32 || cfg.maxTotal == 0u32 {
      panic("httpclient: maxPerOrigin and maxTotal are at least 1", file, line);
    }
    let given, http2, maxPerOrigin, maxTotal, idleTimeout, maxLifetime, maxQueued, maxRetries, maxRedirects,
      userAgent, var conn, http3, http3Origins, h3Timeout, maxOrigins, givenStreams = cfg.(tlsConfig, http2, maxPerOrigin,
      maxTotal, idleTimeout, maxLifetime, maxQueued, maxRetries, maxRedirects, userAgent, conn, http3, http3Origins,
      http3Timeout, maxOrigins, maxStreamsPerConnection);
    // 0 is no limit of the client's own (the peer's still holds)
    let maxStreams = if givenStreams == 0u32 {4294967295u32} else {givenStreams};
    conn.protocol.idleTimeout = idleTimeout;
    conn.h2IdleTimeout = idleTimeout;
    var tlsConfig = given;
    tlsConfig.alpn = alpnFor(&tlsConfig.alpn, http2);
    // The HTTP/3 plug-in, made by the program's maker from the TLS config
    // (its verifier is the one QUIC's handshake uses too)
    var h3on = false;
    match http3 {
      case let Some(mk) {h3on = true;}
      else {}
    }
    let h3 = http3From(http3, &tlsConfig);
    var h3Origins = List[String]();
    var k = 0usize;
    while k < http3Origins.len() {
      match Url.parse(http3Origins[k].view()) {
        case let Ok(u) {if u.isSecure() {h3Origins.push(u.origin());}}
        case let Err(x) {}
      }
      k = k + 1usize;
    }
    let tlsc = match tls.Client.make(tlsConfig) {
      case var Ok(r) {Ok[tls.Client, Failure](r)}
      case var Err(e) {
        Err[tls.Client, Failure](Failure.make(Stage.Tls, e.osError, ErrorKind.Unsupported, (String() <- e).view()))
      }
    };
    let priorKnowledge = conn.h2PriorKnowledge;
    let d = httpconn.Driver.make(conn);
    let lim = Limits(maxPerOrigin, maxTotal, maxLifetime, maxQueued, maxRetries, maxRedirects, userAgent, priorKnowledge,
      h3Origins, h3Timeout, maxStreams);
    Client(wire: Wire(d, h3), tlsc: tlsc, cc: ClientCore.make(lim, maxOrigins, h3on), dev: List[httpconn.Event](),
      comps: List[Completion](), ready: List[Event](), h3evs: List[H3Event]())
  }

  // Its counters, as they are now
  pub fn stats(self: &) ClientStats {
    var s = cc.st;
    s.queuedNow = cc.queuedN;
    s.activeNow = cc.liveFetches - cc.queuedN;
    s.openNow = cc.total;
    var idle = 0u32;
    var o = 0usize;
    while o < cc.origins.bound() {
      if !cc.origins.isLive(u32.from(o)) {o = o + 1usize; continue;}
      let og = cc.origins.borrowAt(u32.from(o)).unwrap();
      idle = idle + u32.from(og.idle.len());
      var j = 0usize;
      while j < og.shared.len() {
        if (self.cc.pconns.borrowAt(*og.shared[j]).unwrap()).active == 0u32 {idle = idle + 1u32;}
        j = j + 1usize;
      }
      if og.h3c != noEntry {
        let p = self.cc.pconns.borrowAt(og.h3c).unwrap();
        if p.state == pShared && p.active == 0u32 {idle = idle + 1u32;}
      }
      o = o + 1usize;
    }
    s.idleNow = idle;
    s.origins = u32.from(cc.origins.len());
    s
  }

  // Its driver's counters: connections, requests and bytes
  pub fn driverStats(self: &) httpconn.DriverStats {wire.drv.stats()}

  // Fetches not yet answered
  pub fn live(self: &) u32 {cc.liveFetches}

  // Connections its HTTP/3 plug-in still holds (0 without one): a client
  // being let go waits for them as for its driver's
  pub fn http3Live(self: &) usize {wire.h3.live()}

  // Fetches waiting for a connection
  pub fn queued(self: &) u32 {cc.queuedN}

  // Whether id names a fetch not yet answered
  pub fn isLive(self: &, id: FetchId) bool {self.fetchIndex(id) != noEntry}

  // ---------------------------------------------------------------------------
  // The tables
  // ---------------------------------------------------------------------------

  // The record in cell i, or null if the cell is free: an answered fetch's or a
  // closed connection's record is removed at once. A caller that may be handed
  // an index that has ended asks 'fetchLive' / 'pconnLive' before it reads
  // (a fetch's 'conn' is one: its connection may have closed first)
  fn fetchLive(self: &, i: u32) bool {cc.fetches.isLive(i)}

  fn pconnLive(self: &, i: u32) bool {cc.pconns.isLive(i)}

  // Whether the connection fetch f was dispatched on is still open: its cell
  // holds that same connection, not one that took the cell after it closed
  fn fetchConnLive(self: &, f: &Fetch) bool {
    match cc.pconns.borrowAt(f.conn) {
      case let Some(p) {p.gen == f.connGen}
      case is None {false}
    }
  }

  fn idOf(self: &, fi: u32) FetchId {FetchId(fi, (self.cc.fetches.borrowAt(fi).unwrap()).gen)}

  // The live fetch id names, or noEntry
  fn fetchIndex(self: &, id: FetchId) u32 {
    if id.isNone() {return noEntry;}
    match cc.fetches.borrowAt(id.index) {
      case let Some(f) {if f.gen != id.gen {return noEntry;}}
      else {return noEntry;}
    }
    id.index
  }

  fn newFetch(self: &mut) u32 {cc.newFetch()}

  fn freeFetchRec(self: &mut, i: u32) {cc.freeFetchRec(i);}

  fn newConn(self: &mut) u32 {cc.newConn()}

  fn freeConnRec(self: &mut, i: u32) {cc.freeConnRec(i);}

  // The client's scheduler is to look at origin oi again
  fn touch(self: &mut, oi: u32) {
    cc.markDirty(oi);
    cc.wantSchedule = true;
  }

  // ---------------------------------------------------------------------------
  // Fetching
  // ---------------------------------------------------------------------------

  // A GET of a URL written as text, its events to sink (see the package's
  // header, FETCHING)
  pub fn get(self: &mut, lp: &mut Loop, text: &str, sink: Sink, file: &Array[u8] = srcFile(), line: u32 = srcLine()) FetchId {
    self.send(lp, Request.get(text), sink, file, line)
  }

  // A request, its events to sink (see the package's header, FETCHING). A
  // request whose fields are the client's to write (Host, Content-Length,
  // Transfer-Encoding), or whose method is not a token or is CONNECT, is a
  // program error: a panic at the caller's line
  pub fn send(self: &mut, lp: &mut Loop, req: Request, sink: Sink, file: &Array[u8] = srcFile(), line: u32 = srcLine()) FetchId {
    var r = req;
    if !isToken(r.methodName()) {panic("httpclient: the request's method is not a token", file, line);}
    if r.method == Method.Connect {panic("httpclient: CONNECT is not supported", file, line);}
    if r.headers.has("Host") {panic("httpclient: Host is written from the request's URL, not its fields", file, line);}
    if r.headers.has("Content-Length") || r.headers.has("Transfer-Encoding") {
      panic("httpclient: framing fields are the client's to write, from the request's body", file, line);
    }
    let id = cc.ask(r, sink, Instant.now());
    self.drain(lp);
    id
  }

  // A request whose body is streamed (see the package's header, A STREAMED BODY): the request's own
  // body must be empty; its head goes out as the connection is chosen, framing says the body's length
  // (sized: Content-Length; unsized: chunked on HTTP/1.1, plain DATA on HTTP/2 and HTTP/3), and the
  // body follows piece by piece through pushBody and endBody
  pub fn sendUpload(self: &mut, lp: &mut Loop, req: Request, sink: Sink, framing: BodyLength, file: &Array[u8] = srcFile(), line: u32 = srcLine()) FetchId {
    if req.body.len() > 0usize {panic("httpclient: a streamed request's own body must be empty", file, line);}
    if framing.isEmpty() {panic("httpclient: a streamed request's framing must be sized or unsized", file, line);}
    let id = self.send(lp, req, sink, file, line);
    let fi = self.fetchIndex(id);
    if fi != noEntry {
      // (not dispatched yet: send only queues it, so the mode is set before any request is made)
      let f = self.cc.fetches.borrowMutAt(fi).unwrap();
      f.streamed = true;
      f.upLen = framing;
    }
    id
  }

  // A piece of a streamed fetch's body, queued; it is the connection's from here. A fetch that has
  // ended, or whose body is wanted no more, drops it. More than a sized body's length, or any after
  // endBody, is a program error
  pub fn pushBody(self: &mut, lp: &mut Loop, id: FetchId, b: IoBuf, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    let fi = self.fetchIndex(id);
    if fi == noEntry {return;}
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    if f.upGone {return;}      // (also a fetch whose redirect has dropped the body)
    if !f.streamed {panic("httpclient: pushBody on a fetch that was not made by sendUpload", file, line);}
    if f.upEnded {panic("httpclient: pushBody after endBody", file, line);}
    let n = u64.from(b.len());
    if n == 0u64 {return;}
    f.upPushed = f.upPushed + n;
    if f.upLen.isSized() && f.upPushed > f.upLen.length {
      panic("httpclient: the streamed body is longer than the length it was sent with", file, line);
    }
    if f.upGone {return;}
    f.upq.push(b);
    f.upAsked = false;
    if f.upWritable && f.state == fActive {self.feedUpload(lp, fi);}
  }

  // A streamed fetch's body is whole. Short of a sized body's length is a program error
  pub fn endBody(self: &mut, lp: &mut Loop, id: FetchId, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    let fi = self.fetchIndex(id);
    if fi == noEntry {return;}
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    if f.upGone {return;}
    if !f.streamed {panic("httpclient: endBody on a fetch that was not made by sendUpload", file, line);}
    if f.upEnded {return;}
    if f.upLen.isSized() && f.upPushed != f.upLen.length {
      panic("httpclient: the streamed body is shorter than the length it was sent with", file, line);
    }
    f.upEnded = true;
    if f.upGone {return;}
    if f.upWritable && f.state == fActive {self.feedUpload(lp, fi);}
  }


  // The program is done with n bytes of a fetch's body that Data events to
  // this thread handed it: credit back to its connection, which reads again
  pub fn release(self: &mut, id: FetchId, n: usize) {
    let fi = self.fetchIndex(id);
    if fi == noEntry || n == 0usize {return;}
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    let m = if n < f.held {n} else {f.held};
    if m == 0usize {return;}
    f.held = f.held - m;
    self.creditReq(f.req, f.qreq, m);
  }

  // n body bytes of a request released to what carries it: the HTTP/3
  // plug-in's request when qreq names one, else the driver's
  fn creditReq(self: &mut, req: httpconn.ReqId, qreq: H3Req, n: usize) {
    if qreq.isNone() {
      wire.drv.release(req, n);
      return;
    }
    wire.h3.release(qreq, n);
  }

  // Fetch fi's request under way, given up (Cancelled comes)
  fn cancelReq(self: &mut, lp: &mut Loop, fi: u32) {
    let f = self.cc.fetches.borrowAt(fi).unwrap();
    let req = f.req;
    let qreq = f.qreq;
    if qreq.isNone() {
      wire.drv.cancel(lp, req);
      return;
    }
    wire.h3.cancel(lp, qreq);
  }

  // Ask a fetch to end (see the package's header, CANCEL AND DEADLINES):
  // true while its answer is still to come
  pub fn cancel(self: &mut, lp: &mut Loop, id: FetchId) bool {
    let fi = self.fetchIndex(id);
    if fi == noEntry {return false;}
    self.cancelFetch(lp, fi, endCancelled);
    true
  }

  // A fetch's intent and score, changed: a waiting fetch takes its new place
  // in the order at once. True while its answer is still to come
  pub fn reprioritize(self: &mut, id: FetchId, intent: Intent, score: i64) bool {
    let fi = self.fetchIndex(id);
    if fi == noEntry {return false;}
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    f.intent = intent;
    f.score = score;
    cc.rekeyWaiting(fi);
    true
  }

  // Every idle pooled connection closed (politely): how many
  pub fn closeIdle(self: &mut, lp: &mut Loop) u32 {
    var n = 0u32;
    var o = 0usize;
    while o < cc.origins.bound() {
      if !cc.origins.isLive(u32.from(o)) {o = o + 1usize; continue;}
      // Each retire may reshape the pools, so each use of the origin borrows it afresh
      let oi = u32.from(o);
      while self.cc.origins.borrowAt(oi).unwrap().idle.len() > 0usize {
        let first = *self.cc.origins.borrowAt(oi).unwrap().idle[0usize];
        self.retire(lp, first, true);
        n = n + 1u32;
      }
      // An HTTP/2 connection carrying no fetch is idle too
      var j = self.cc.origins.borrowAt(oi).unwrap().shared.len();
      while j > 0usize {
        j = j - 1usize;
        let pc = *self.cc.origins.borrowAt(oi).unwrap().shared[j];
        if (self.cc.pconns.borrowAt(pc).unwrap()).active == 0u32 {
          self.retire(lp, pc, true);
          n = n + 1u32;
        }
      }
      // ...and an HTTP/3 one
      let qc = self.cc.origins.borrowAt(oi).unwrap().h3c;
      if qc != noEntry {
        let p = self.cc.pconns.borrowAt(qc).unwrap();
        if p.state == pShared && p.active == 0u32 {
          self.retire(lp, qc, true);
          n = n + 1u32;
        }
      }
      o = o + 1usize;
    }
    n
  }

  // Every fetch answered Cancelled, every connection reset
  pub fn abortAll(self: &mut, lp: &mut Loop) {
    var i = 0u32;
    while usize.from(i) < cc.fetches.bound() {
      if !self.fetchLive(i) {i = i + 1u32; continue;}
      let f = self.cc.fetches.borrowAt(i).unwrap();
      if f.state == fQueued {self.finishFetch(lp, i, endCancelled, None);}
      else if f.state == fActive {(self.cc.fetches.borrowMutAt(i).unwrap()).ending = endCancelled;}
      i = i + 1u32;
    }
    wire.drv.abortAll(lp);
    // HTTP/3: the lookups under way given up, every connection reset
    var k = cc.attempts.len();
    while k > 0usize {
      k = k - 1usize;
      let pc = *cc.attempts[k];
      let p = self.cc.pconns.borrowAt(pc).unwrap();
      if !p.lookup.isNone() {self.dropAttempt(lp, pc, false);}
    }
    wire.h3.abortAll(lp);
    cc.wantSchedule = false;
  }

  // ---------------------------------------------------------------------------
  // Events to sinks
  // ---------------------------------------------------------------------------

  // Hand e to its sink: the events for this thread, until pump hands them over
  fn emit(self: &mut, e: Event) {
    cc.st.events = cc.st.events + 1u64;
    ready.push(e);
  }

  // Events for this thread, moved to out: how many
  fn handOver(self: &mut, out: &uni List[Event]) usize {
    let n = ready.len();
    if n == 0usize {return 0usize;}
    if out.len() == 0usize {
      // The two lists change places: out's emptiness is ready's next
      *out <-> ready;
      return n;
    }
    each e in ready.drain() {out.push(e);}
    n
  }

  // ---------------------------------------------------------------------------
  // Driving
  // ---------------------------------------------------------------------------

  // The latest a poll of the loop may wait to (see the package's header,
  // THE CLIENT)
  pub fn wakeAt(self: &) Instant {
    if ready.len() > 0usize || cc.wantSchedule {return Instant();}
    var w = wire.drv.wakeAt();
    let pw = wire.h3.wakeAt();
    if pw < w {w = pw;}
    // An HTTP/3 attempt's deadline: it falls back then
    var k = 0usize;
    while k < cc.attempts.len() {
      let due = (self.cc.pconns.borrowAt(*cc.attempts[k]).unwrap()).h3By;
      if due < w {w = due;}
      k = k + 1usize;
    }
    w
  }

  // Poll the loop, at most until 'until' and not at all while events are
  // ready; hand the client what completed; drive what it touched; append the
  // events for this thread to out: how many. Nor does it wait when its
  // first pump delivered events
  pub fn poll(self: &mut, lp: &mut Loop, until: Instant, out: &uni List[Event]) usize {
    var n = self.pump(lp, out);
    var limit = until;
    let w = self.wakeAt();
    if w < limit {limit = w;}
    if n > 0usize {limit = Instant();}
    var cs = List[Completion]();
    cs <-> comps;
    lp.poll(limit, &mut cs);
    var k = 0usize;
    while k < cs.len() {
      let c = &mut cs[k];
      if !self.complete(lp, c) {cc.st.unclaimed = cc.st.unclaimed + 1u64;}
      k = k + 1usize;
    }
    cs.clear();
    comps <-> cs;
    n + self.pump(lp, out)
  }

  // A completion from the loop: true if it was this client's (its driver's,
  // or one of its own timers), which takes what it needs from it
  pub fn complete(self: &mut, lp: &mut Loop, comp: &mut Completion) bool {
    if wire.drv.complete(lp, comp) {return true;}
    if wire.h3.complete(lp, comp) {return true;}
    if !wire.drv.isUpperToken(comp.token) {return false;}
    let n = comp.token & 0xFFFFFFFFFFu64;
    if (n & resolveBit) != 0u64 {
      self.looked(lp, comp);
      return true;
    }
    let fi = u32.from(n & u64.from(genMask));
    let gen = u32.from((n >> 24u64) & u64.from(watchGenMask));
    if !self.fetchLive(fi) {return true;}
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    if (f.gen & watchGenMask) != gen || f.watch != comp.id {return true;}
    f.watch = OpId.none();
    self.cancelFetch(lp, fi, if comp.status == diag.outcomeDone {endTimedOut} else {endCancelled});
    true
  }

  // Drive everything the completions and calls have touched, and append the
  // events for this thread to out: how many
  pub fn pump(self: &mut, lp: &mut Loop, out: &uni List[Event]) usize {
    var rounds = 0u32;
    while rounds < 64u32 {
      let got = self.takeDriverEvents(lp) + self.takeH3Events(lp);
      cc.learnAll(&wire);
      self.attemptsDue(lp);
      // (the pool begins a pass only when an event has asked for one)
      let did = self.schedule(lp);
      if !did && got == 0usize {break;}
      rounds = rounds + 1u32;
    }
    self.handOver(out)
  }

  // The driver's events, each to the fetch or connection it is about: how
  // many
  fn takeDriverEvents(self: &mut, lp: &mut Loop) usize {
    var evs = List[httpconn.Event]();
    evs <-> dev;
    let n = wire.drv.pump(lp, &uni evs);
    each e in evs.drain() {
      let t = e.token;
      let index = u32.from(t & 0xFFFFFFFFu64);
      let gen = u32.from((t >> 32u64) & u64.from(genMask));
      if (t & tokReq) != 0u64 {
        if self.fetchLive(index) {
          let f = self.cc.fetches.borrowAt(index).unwrap();
          if (f.gen & genMask) == gen && f.state == fActive && f.req == e.req {
            self.onRequest(lp, index, e);
            continue;
          }
        }
        // A request the client no longer follows: its body's credit back
        if e.kind == httpconn.EventKind.Data {wire.drv.release(e.req, e.buf.len());}
      } else if (t & tokConn) != 0u64 {
        if self.pconnLive(index) {
          let p = self.cc.pconns.borrowAt(index).unwrap();
          if (p.gen & genMask) == gen {self.onConn(lp, index, &e);}
        }
      }
    }
    dev <-> evs;
    n
  }
  // ---------------------------------------------------------------------------
  // The pool's commands, carried out
  // ---------------------------------------------------------------------------

  // The commands an event left queued in the pool, carried out in order
  fn drain(self: &mut, lp: &mut Loop) {
    while true {
      match cc.take() {
        case let Some(c) {self.exec(lp, c);}
        else {break;}
      }
    }
  }

  // The scheduler's decisions, each carried out before the next is asked (the pool reads what its connections
  // say of themselves as it decides, and the commands before it have changed that): whether any sent a request
  // or opened a connection
  fn schedule(self: &mut, lp: &mut Loop) bool {
    var did = false;
    while true {
      match cc.next(&wire) {
        case let Some(c) {
          if self.exec(lp, c) {did = true;}
        }
        else {break;}
      }
    }
    did
  }

  // One command carried out: true when it sent a request or began a connection
  fn exec(self: &mut, lp: &mut Loop, command: Command) bool {
    var c = command;
    let k = c.kind;
    if k == CommandKind.Answer {
      if !c.watch.isNone() {lp.cancel(c.watch);}
      if c.held > 0usize {self.creditReq(c.req, c.qreq, c.held);}
      var ev = Event.make(EventKind.Done, 0u64, FetchId.none());
      ev <-> c.event;
      self.emit(ev);
      return false;
    }
    if k == CommandKind.Send {
      let fi = c.fetch.index;
      let quic = c.quic;
      let cid = c.id;
      let qid = c.qid;
      let token = c.token;
      let head, body = c.(head, body);
      if !quic {
        let rq = wire.drv.request(lp, cid, head, body, httpconn.Sink.Here(token));
        cc.sent(fi, rq, H3Req.none());
        return true;
      }
      // HTTP/3: its body, if any, goes at once (the plug-in tells Writable only
      // after a refusal)
      let q = wire.h3.request(lp, qid, head, body, token);
      cc.sent(fi, httpconn.ReqId.none(), q);
      let f2 = self.cc.fetches.borrowAt(fi).unwrap();
      if !q.isNone() && (f2.body.len() > 0usize || f2.streamed) {self.sendBody(lp, fi);}
      return true;
    }
    if k == CommandKind.Open {
      let sink = httpconn.Sink.Here(tokConn | (u64.from(c.gen & genMask) << 32u64) | u64.from(c.pc));
      if !c.secure {
        let id = wire.drv.connect(lp, c.host.view(), c.port, sink);
        cc.opened(c.pc, id);
        return true;
      }
      var why: Option[Failure] = None;
      match &tlsc {
        case let &Ok(t) {
          let id = wire.drv.connectWith(lp, c.host.view(), c.port, Uni[tls.Stream](t.stream(c.host.view())), sink);
          cc.opened(c.pc, id);
        }
        case let &Err(x) {why = Some[Failure](x.clone());}
      }
      match why {
        case var Some(fl) {
          // No TLS context: nothing for this origin can be fetched
          cc.connectFailed(c.pc, fl);
        }
        else {}
      }
      return true;
    }
    if k == CommandKind.Close {
      if !c.quic {wire.drv.close(lp, c.id);} else {wire.h3.close(lp, c.qid);}
      return false;
    }
    if k == CommandKind.Cancel {
      if c.qreq.isNone() {wire.drv.cancel(lp, c.req);} else {wire.h3.cancel(lp, c.qreq);}
      return false;
    }
    if k == CommandKind.OpenH3 {
      self.openH3(lp, c.pc);
      return true;
    }
    if k == CommandKind.Watch {
      // Its deadline and group, watched by one timer on the loop
      let fi = c.fetch.index;
      let fgen = (self.cc.fetches.borrowAt(fi).unwrap()).gen;
      let wt = wire.drv.upperToken(lp, kWatch, (u64.from(fgen & watchGenMask) << 24u64) | u64.from(fi));
      let dl = c.deadline;
      let g = c.group;
      match g {
        case let Some(gv) {
          let at = if dl < forever() {dl} else {Instant.now() + Duration.fromHours(87600i64)};
          let op = lp.afterIn(at, Target.Here(wt), gv);
          cc.watching(fi, op);
        }
        else {
          if dl < forever() {
            let op = lp.after(dl, Target.Here(wt));
            cc.watching(fi, op);
          }
        }
      }
      return false;
    }
    false
  }

  // ---------------------------------------------------------------------------
  // Connections
  // ---------------------------------------------------------------------------

  // A pooled connection's event: connected, or closed
  fn onConn(self: &mut, lp: &mut Loop, pc: u32, e: &httpconn.Event) {
    if e.kind == httpconn.EventKind.Connected {
      cc.connected(pc, &wire);
      self.drain(lp);
      return;
    }
    if e.kind != httpconn.EventKind.Closed {return;}
    let fl = if e.clean {Failure.none()} else {Failure.fromConn(&e.failure)};
    cc.closed(pc, e.clean, fl, e.failure.stage == httpconn.Stage.Tls);
    self.drain(lp);
  }

  // Connection pc leaves the pool (closed now, politely, when 'close'): its Close carried out
  fn retire(self: &mut, lp: &mut Loop, pc: u32, close: bool) {
    cc.retire(pc, close);
    self.drain(lp);
  }

  // Fetch fi's one final answer: sent to its sink, and the fetch freed
  fn finishFetch(self: &mut, lp: &mut Loop, fi: u32, how: u32, fl: Option[Failure]) {
    cc.finish(fi, how, fl);
    self.drain(lp);
  }

  // Fetch fi is cancelled (how: endCancelled, endTimedOut, endLimit)
  fn cancelFetch(self: &mut, lp: &mut Loop, fi: u32, how: u32) {
    cc.cancelFetch(fi, how);
    self.drain(lp);
  }

  // ---------------------------------------------------------------------------
  // HTTP/3 (see the package's header, HTTP/3)
  // ---------------------------------------------------------------------------

  // Whether the config named a plug-in (else h3 is NoHttp3)
  fn hasH3(self: &) bool {cc.h3on}


  // An Alt-Svc field on a response to fetch fi (over TCP): its h3
  // alternative for the fetch's origin cached with its max-age, or a 'clear'
  // taken. Read only when there is a plug-in to use it
  fn learnAltSvc(self: &mut, fi: u32, headers: &HttpHeaders) {
    if !self.hasH3() {return;}
    let f = self.cc.fetches.borrowAt(fi).unwrap();
    if f.origin == noEntry {return;}
    let og = self.cc.origins.borrowMutAt(u32.from(f.origin)).unwrap();
    if !og.secure {return;}
    var k = 0usize;
    while k < headers.len() {
      if fieldIs(headers.nameAt(k), "alt-svc") {
        let host = og.host.clone();
        match readAltSvc(headers.valueAt(k), host.view()) {
          case is Clear {
            if !og.h3Prior {
              og.h3Port = 0u16;
              og.h3Until = Instant();
            }
            return;
          }
          case let H3(a) {
            if !og.h3Prior {
              let now = Instant.now();
              if og.h3Port == 0u16 || og.h3Until <= now {cc.st.altSvc = cc.st.altSvc + 1u64;}
              let age = if a.maxAge > 31536000u64 {31536000u64} else {a.maxAge};
              og.h3Port = a.port;
              og.h3Until = now + Duration.fromSeconds(i64.from(age));
            }
            return;
          }
          else {}
        }
      }
      k = k + 1usize;
    }
  }

  // An HTTP/3 attempt for origin oi: its host looked up (bounded by the
  // attempt's deadline), then the plug-in's connect to its first IPv4
  // address, on the Alt-Svc's port
  fn openH3(self: &mut, lp: &mut Loop, oi: u32) {
    let og = self.cc.origins.borrowMutAt(u32.from(oi)).unwrap();
    let pc = self.newConn();
    self.cc.attachConn(pc, oi);
    let p = self.cc.pconns.borrowMutAt(pc).unwrap();
    p.quic = true;
    p.proto = protoH3;
    p.h3By = Instant.now() + cc.cfg.h3Timeout;
    og.open = og.open + 1u32;
    og.connecting = og.connecting + 1u32;
    og.h3c = pc;
    cc.total = cc.total + 1u32;
    cc.st.connects = cc.st.connects + 1u64;
    cc.st.h3Attempts = cc.st.h3Attempts + 1u64;
    cc.attempts.push(pc);
    let pgen = p.gen;
    let limit = p.h3By;
    let host = og.host.clone();
    let h3Port = og.h3Port;
    let tok = wire.drv.upperToken(lp, kWatch, resolveBit | (u64.from(pgen & watchGenMask) << 24u64) | u64.from(pc));
    let op = lp.submitBy(resolveOp(host.view(), h3Port, IoBuf(resolveSize)), Target.Here(tok), limit);
    self.cc.pconns.borrowMutAt(pc).unwrap().lookup = op;
  }

  // An HTTP/3 attempt's lookup has answered: the connect, or the fallback
  fn looked(self: &mut, lp: &mut Loop, comp: &mut Completion) {
    let n = comp.token & 0xFFFFFFFFFFu64;
    let pc = u32.from(n & u64.from(genMask));
    let gen = u32.from((n >> 24u64) & u64.from(watchGenMask));
    if !self.pconnLive(pc) {return;}
    let p = self.cc.pconns.borrowMutAt(pc).unwrap();
    if (p.gen & watchGenMask) != gen || p.state != pConnecting || !p.quic || p.lookup != comp.id {return;}
    p.lookup = OpId.none();
    self.touch(p.origin);
    var addr = SocketAddr.localhost(0u16);
    var found = false;
    if comp.isDone() {
      let all = addressesIn(&comp.buf);
      var k = 0usize;
      while k < all.len() && !found {
        if !all[k].isV6() {
          addr = *all[k];
          found = true;
        }
        k = k + 1usize;
      }
    }
    if !found {
      self.dropAttempt(lp, pc, true);
      return;
    }
    let og = self.cc.origins.borrowAt(u32.from(p.origin)).unwrap();
    let host = og.host.clone();
    let token = tokConn | (u64.from(p.gen & genMask) << 32u64) | u64.from(pc);
    let res = wire.h3.connect(lp, addr, host.view(), token);
    match res {
      case let Ok(q) {self.cc.pconns.borrowMutAt(pc).unwrap().qid = q;}
      case let Err(x) {self.dropAttempt(lp, pc, true);}
    }
  }

  // An HTTP/3 attempt given up: its lookup cancelled, or its connection
  // aborted (its Closed frees the record); when it fell back, the origin's
  // HTTP/3 is not tried again for h3BrokenFor, and its fetches take TCP
  fn dropAttempt(self: &mut, lp: &mut Loop, pc: u32, fellBack: bool) {
    let p = self.cc.pconns.borrowMutAt(pc).unwrap();
    let og = self.cc.origins.borrowMutAt(u32.from(p.origin)).unwrap();
    removeValue(&mut cc.attempts, pc);
    if og.h3c == pc {og.h3c = noEntry;}
    if fellBack {
      og.h3Broken = Instant.now() + Duration.fromSeconds(h3BrokenFor);
      cc.st.h3Fallbacks = cc.st.h3Fallbacks + 1u64;
    }
    if p.state == pConnecting {
      og.connecting = og.connecting - 1u32;
      og.open = og.open - 1u32;
      cc.total = cc.total - 1u32;
    }
    self.touch(p.origin);
    if !p.lookup.isNone() {
      lp.cancel(p.lookup);
      p.lookup = OpId.none();
    }
    let qid = p.qid;
    if qid == 0u64 {
      self.freeConnRec(pc);
      return;
    }
    p.state = pClosing;
    wire.h3.abort(lp, qid);
  }

  // The HTTP/3 cc.attempts whose deadline has passed fall back
  fn attemptsDue(self: &mut, lp: &mut Loop) {
    if cc.attempts.len() == 0usize {return;}
    let now = Instant.now();
    var k = cc.attempts.len();
    while k > 0usize {
      k = k - 1usize;
      if k >= cc.attempts.len() {continue;}
      let pc = *cc.attempts[k];
      if now >= (self.cc.pconns.borrowAt(pc).unwrap()).h3By {self.dropAttempt(lp, pc, true);}
    }
  }

  // The plug-in's events, each to the fetch or connection it is about: how many
  fn takeH3Events(self: &mut, lp: &mut Loop) usize {
    var evs = List[H3Event]();
    evs <-> h3evs;
    wire.h3.turn(lp);
    let n = wire.h3.takeEvents(&mut evs);
    each e in evs.drain() {
      let t = e.token;
      let index = u32.from(t & 0xFFFFFFFFu64);
      let gen = u32.from((t >> 32u64) & u64.from(genMask));
      if (t & tokReq) != 0u64 {
        if self.fetchLive(index) {
          let f = self.cc.fetches.borrowAt(index).unwrap();
          // A late Failed for a fetch whose connection has already closed is
          // dropped here (fetchConnLive is false). Nothing is lost: the close
          // path, failFetchesOn, has already failed every fetch still open on
          // that connection, so each gets its one Failed (Bug 86, #1219)
          if (f.gen & genMask) == gen && f.state == fActive && f.conn != noEntry && self.fetchConnLive(f) &&
              (self.cc.pconns.borrowAt(f.conn).unwrap()).quic && f.qreq == e.req {
            self.onH3Request(lp, index, e);
            continue;
          }
        }
        // A request the client no longer follows: its body's credit back
        if e.kind == H3Kind.Data {self.creditReq(httpconn.ReqId.none(), e.req, e.buf.len());}
      } else if (t & tokConn) != 0u64 {
        if self.pconnLive(index) {
          let p = self.cc.pconns.borrowAt(index).unwrap();
          if (p.gen & genMask) == gen && p.quic {self.onH3Conn(lp, index, &e);}
        }
      }
    }
    h3evs <-> evs;
    n
  }

  // An HTTP/3 connection's event: connected (it takes fetches now), or
  // closed (one that never connected falls back)
  fn onH3Conn(self: &mut, lp: &mut Loop, pc: u32, e: &H3Event) {
    let p = self.cc.pconns.borrowMutAt(pc).unwrap();
    let og = self.cc.origins.borrowMutAt(u32.from(p.origin)).unwrap();
    if e.kind == H3Kind.Connected {
      if p.state == pConnecting {
        removeValue(&mut cc.attempts, pc);
        og.connecting = og.connecting - 1u32;
        p.state = pShared;
        og.connected = true;
        self.cc.noteIdle(pc);
        self.touch(p.origin);
      }
      return;
    }
    if e.kind != H3Kind.Closed {return;}
    // A close ends every fetch still on the connection (the plug-in answers
    // each request before it, but a fetch it left unanswered would wait for
    // its deadline): each fails at once, or is retried as any other loss of
    // its connection would be
    let oidx = p.origin;
    self.failFetchesOn(lp, pc, e);
    let was = self.cc.pconns.borrowAt(pc).unwrap().state;
    removeValue(&mut cc.attempts, pc);
    let og2 = self.cc.origins.borrowMutAt(u32.from(oidx)).unwrap();
    if og2.h3c == pc {og2.h3c = noEntry;}
    if was == pConnecting {
      // Its handshake failed: TCP for a while
      og2.connecting = og2.connecting - 1u32;
      og2.open = og2.open - 1u32;
      cc.total = cc.total - 1u32;
      og2.h3Broken = Instant.now() + Duration.fromSeconds(h3BrokenFor);
      cc.st.h3Fallbacks = cc.st.h3Fallbacks + 1u64;
    } else if was == pShared {
      og2.open = og2.open - 1u32;
      cc.total = cc.total - 1u32;
    }
    cc.st.closed = cc.st.closed + 1u64;
    self.touch(oidx);
    self.freeConnRec(pc);
  }

  // The fetches still under way on HTTP/3 connection pc, whose Closed event e
  // has come: each fails with the connection's failure (a Closed one of ours
  // when it ended cleanly), through reqFailed, so that a fetch the retry
  // rules allow goes to another connection
  fn failFetchesOn(self: &mut, lp: &mut Loop, pc: u32, e: &H3Event) {
    var i = 0u32;
    while usize.from(i) < cc.fetches.bound() {
      if !self.fetchLive(i) {i = i + 1u32; continue;}
      let f = self.cc.fetches.borrowAt(i).unwrap();
      if f.state == fActive && f.conn == pc && self.fetchConnLive(f) {
        var fl = Failure.make(Stage.Closed, 0u32, ErrorKind.Closed, "the HTTP/3 connection closed before the exchange ended");
        if !e.clean {fl = e.failure.clone();}
        self.reqFailed(lp, i, fl);
      }
      i = i + 1u32;
    }
  }

  // A streamed fetch's queued pieces, as many as its connection takes now; then, the body being
  // all pushed, the connection is told it is whole, else the pusher is told there is room
  fn feedUpload(self: &mut, lp: &mut Loop, fi: u32) {
    let f0 = self.cc.fetches.borrowMutAt(fi).unwrap();
    f0.upWritable = true;
    if f0.upGone || f0.upFinished {return;}
    while true {
      var b = match self.cc.fetches.borrowMutAt(fi).unwrap().upq.popFront() {
        case var Some(got) {got}
        else {break;}
      };
      match self.offerPiece(fi, b) {
        case var Some(back) {
          // refused: kept at the front; Writable comes when there is room
          let f1 = self.cc.fetches.borrowMutAt(fi).unwrap();
          f1.upq.pushFront(back);
          f1.upWritable = false;
          return;
        }
        else {}
      }
    }
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    if f.upEnded {
      f.upFinished = true;
      let qreq = f.qreq;
      if qreq.isNone() {
        wire.drv.finish(f.req);
      } else {
        wire.h3.finish(qreq);
      }
      return;
    }
    if !f.upAsked {
      f.upAsked = true;
      self.emit(Event.make(EventKind.BodyRoom, f.sink.token, self.idOf(fi)));
    }
  }

  // As much of fetch fi's body as its connection takes now
  fn sendBody(self: &mut, lp: &mut Loop, fi: u32) {
    if self.cc.fetches.borrowAt(fi).unwrap().streamed {
      self.feedUpload(lp, fi);
      return;
    }
    // The body is viewed only where its bytes are copied: a view held across the
    // driver's calls would be one into a String the driver might change. Every call may
    // reshape the pool, so the fetch is borrowed afresh after each
    while true {
      let g = self.cc.fetches.borrowAt(fi).unwrap();
      let sent = g.sent;
      let blen = g.body.len();
      if sent >= blen {break;}
      let left = blen - sent;
      let n = if left < sendChunk {left} else {sendChunk};
      // A pool that refuses the buffer (iobuf's tryMake) ends the fetch: its
      // exchange is cancelled, and it ends Failed, Overloaded (reqStopped)
      var b = match IoBuf.tryMake(n) {
        case var Some(got) {got}
        else {
          let h = self.cc.fetches.borrowMutAt(fi).unwrap();
          if h.ending == endNone {h.ending = endFailed;}
          self.cancelReq(lp, fi);
          return;
        }
      };
      // As bytes: a piece may end inside a UTF-8 character (or the body not be UTF-8
      // at all), which a 'str' slice refuses
      let all = self.cc.fetches.borrowAt(fi).unwrap().body.view() as &Array[u8];
      b.append(&all[sent ..< sent + n]);
      if self.sendPiece(fi, b) {
        self.cc.fetches.borrowMutAt(fi).unwrap().sent = sent + n;
      } else {
        return;      // refused: Writable comes when there is room
      }
    }
    let g2 = self.cc.fetches.borrowAt(fi).unwrap();
    let qreq = g2.qreq;
    let rq = g2.req;
    if qreq.isNone() {
      wire.drv.finish(rq);
      return;
    }
    wire.h3.finish(qreq);
  }

  // A piece of fetch fi's body to what carries its request: whether it was taken
  fn sendPiece(self: &mut, fi: u32, b: IoBuf) bool {
    match self.offerPiece(fi, b) {
      case is None[IoBuf] {true}
      else {false}
    }
  }

  // The same, the piece handed back when the connection refused it
  fn offerPiece(self: &mut, fi: u32, b: IoBuf) Option[IoBuf] {
    let f = self.cc.fetches.borrowAt(fi).unwrap();
    let req = f.req;
    let qreq = f.qreq;
    if qreq.isNone() {return wire.drv.sendData(req, b);}
    wire.h3.sendData(qreq, b)
  }

  // ---------------------------------------------------------------------------
  // Requests
  // ---------------------------------------------------------------------------

  // An event of fetch fi's request on the driver, taken by value: what it
  // carries goes on whole into the fetch's own event
  fn onRequest(self: &mut, lp: &mut Loop, fi: u32, e: httpconn.Event) {
    let k = e.kind;
    if k == httpconn.EventKind.Response {
      self.learnAltSvc(fi, &e.response.headers);
      let response, body = e.(response, body);
      self.reqResponse(fi, response, body);
    } else if k == httpconn.EventKind.Data {
      self.reqData(lp, fi, e.(buf));
    } else if k == httpconn.EventKind.End {
      self.reqEnd(fi, e.(trailers));
    } else if k == httpconn.EventKind.Writable {
      self.sendBody(lp, fi);
    } else if k == httpconn.EventKind.Done {
      self.reqDone(lp, fi);
    } else if k == httpconn.EventKind.Failed {
      self.reqFailed(lp, fi, Failure.fromConn(&e.failure));
    } else if k == httpconn.EventKind.Cancelled || k == httpconn.EventKind.TimedOut {
      self.reqStopped(lp, fi, k == httpconn.EventKind.TimedOut);
    }
  }

  // The same of fetch fi's request on the HTTP/3 plug-in
  fn onH3Request(self: &mut, lp: &mut Loop, fi: u32, e: H3Event) {
    let k = e.kind;
    if k == H3Kind.Response {
      let response, body = e.(response, body);
      self.reqResponse(fi, response, body);
    } else if k == H3Kind.Data {
      self.reqData(lp, fi, e.(buf));
    } else if k == H3Kind.End {
      self.reqEnd(fi, e.(trailers));
    } else if k == H3Kind.Writable {
      self.sendBody(lp, fi);
    } else if k == H3Kind.Done {
      self.reqDone(lp, fi);
    } else if k == H3Kind.Failed {
      self.reqFailed(lp, fi, e.(failure));
    } else if k == H3Kind.Cancelled {
      self.reqStopped(lp, fi, false);
    }
  }

  // Fetch fi's response head: a redirect to follow is kept to itself, else
  // it goes to the fetch's sink
  fn reqResponse(self: &mut, fi: u32, response: ResponseHead, body: BodyLength) {
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    f.timing.firstByte = Instant.now();
    // The body not all sent, and wanted no more: whatever the response is, it ends the body (a redirect
    // that follows as a GET drops it; any other is the answer, a streamed body being sent once)
    if f.streamed && !f.upFinished && !f.upGone {
      f.upGone = true;
      f.upq.clear();
      self.emit(Event.make(EventKind.BodyEnded, f.sink.token, self.idOf(fi)));
    }
    if cc.redirectOf(fi, &response) {return;}
    let g = self.cc.fetches.borrowAt(fi).unwrap();
    var ev = Event.make(EventKind.Response, g.sink.token, self.idOf(fi));
    ev.response = response;
    ev.body = body;
    ev.url = g.url.text();
    self.emit(ev);
  }

  // Body bytes of fetch fi's response: a redirect's dropped, else to its sink
  fn reqData(self: &mut, lp: &mut Loop, fi: u32, buf: IoBuf) {
    let n = buf.len();
    let r = cc.redirectBody(fi, n);
    if r != 0u32 {
      // A redirect's body: read and dropped, cut off past drainLimit
      let f = self.cc.fetches.borrowAt(fi).unwrap();
      let rq = f.req;
      let qrq = f.qreq;
      self.creditReq(rq, qrq, n);
      if r == 2u32 {self.cancelReq(lp, fi);}
      return;
    }
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    var ev = Event.make(EventKind.Data, f.sink.token, self.idOf(fi));
    ev.buf = buf;
    f.held = f.held + n;
    self.emit(ev);
  }

  // Fetch fi's response is whole
  fn reqEnd(self: &mut, fi: u32, trailers: HttpHeaders) {
    let f = self.cc.fetches.borrowMutAt(fi).unwrap();
    if f.following {return;}
    var ev = Event.make(EventKind.End, f.sink.token, self.idOf(fi));
    ev.trailers = trailers;
    self.emit(ev);
  }

  // Fetch fi's exchange ended well: its connection is free again (or carries
  // on), and the fetch is Done, or follows its redirect
  fn reqDone(self: &mut, lp: &mut Loop, fi: u32) {
    cc.requestDone(fi, &wire);
    self.drain(lp);
  }

  // Fetch fi's exchange failed with fl: retried when that is safe, else Failed
  fn reqFailed(self: &mut, lp: &mut Loop, fi: u32, fl: Failure) {
    cc.requestFailed(fi, fl, &wire);
    self.drain(lp);
  }

  // Fetch fi's exchange was cancelled, or timed out (the driver's own timeout)
  fn reqStopped(self: &mut, lp: &mut Loop, fi: u32, timedOut: bool) {
    cc.requestStopped(fi, timedOut, &wire);
    self.drain(lp);
  }

  // ---------------------------------------------------------------------------
  // One call
  // ---------------------------------------------------------------------------

  // A request fetched whole: the loop driven until its final answer, its body
  // gathered up to limit bytes (past it, Failed at Stage.Limit). Other
  // fetches' events that arrive meanwhile wait for the next poll
  pub fn fetchWhole(self: &mut, lp: &mut Loop, req: Request, limit: usize, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Response {
    let id = self.send(lp, req, Sink.Here(0u64), file, line);
    var resp = Response.blank();
    var others = List[Event]();
    var going = true;
    var evs = List[Event]();
    while going {
      self.poll(lp, forever(), &uni evs);
      each e in evs.drain() {
        if e.id != id {
          others.push(e);
        } else if e.kind == EventKind.Response {
          let response, url = e.(response, url);
          let status, version, headers = response.(status, version, headers);
          resp.status = status;
          resp.version = version;
          resp.headers = headers;
          resp.url = url;
        } else if e.kind == EventKind.Data {
          let n = e.buf.len();
          if !streams.gather(&mut resp.body, e.buf.view(), limit) {
            let fi = self.fetchIndex(id);
            if fi != noEntry {self.cancelFetch(lp, fi, endLimit);}
          }
          self.release(id, n);
        } else if e.isTerminal() {
          resp.outcome = e.kind;
          let failure, timing = e.(failure, timing);
          resp.failure = failure;
          resp.timing = timing;
          going = false;
        }
      }
    }
    // What came for others goes first at the next poll
    while ready.len() > 0usize {
      match ready.pop() {
        case let Some(e) {evs.push(e);}
        case is None[Event] {}
      }
    }
    while evs.len() > 0usize {
      match evs.pop() {
        case let Some(e) {others.push(e);}
        case is None[Event] {}
      }
    }
    ready = others;
    resp
  }

  // Its death: the fetch and connection tables free their own, every record's
  // values with them, as the origins' does. The connections are its driver's,
  // which dies with it; the sockets the loop's
}

// One URL fetched whole, with a loop and a client of its own made for it
// and gone after (see the package's header, FETCHING)
pub fn getWhole(text: &str, limit: usize) Response {
  var lp = Loop.mustMake();
  var c = Client.make(Config.make());
  var r = c.fetchWhole(&mut lp, Request.get(text), limit);
  c.abortAll(&mut lp);
  var evs = List[Event]();
  c.pump(&mut lp, &uni evs);
  r
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

// The ALPN list a client's TLS offers: the config's, with "h2" put first
// when it offers HTTP/2 (unless already there) and taken out when it does not
fn alpnFor(names: &List[String], http2: bool) List[String] {
  var out = List[String]();
  var has = false;
  var k = 0usize;
  while k < names.len() {
    if names[k].view() == "h2" {has = true;}
    k = k + 1usize;
  }
  if http2 && !has {out.push(String.from("h2"));}
  k = 0usize;
  while k < names.len() {
    if http2 || names[k].view() != "h2" {out.push(names[k].clone());}
    k = k + 1usize;
  }
  out
}
