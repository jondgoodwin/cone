// The process package: run another program and wait for it, synchronously,
// with what it writes captured; and this program's own arguments and path.
//
//   mod build;
//   import collections use *;
//   import process;
//   import time use Duration;
//
//   fn main() i32 {
//     mut args = List[String].empty();
//     args.push(String.from("conec"));
//     args.push(String.from("-o"));
//     args.push(String.from("build/debug"));
//     args.push(String.from("app.conebuild"));
//     match process.run(args.view(), new process.Options(timeout: Duration.fromSeconds(60))) {
//       case imm ok Ok {
//         imm o = &ok;
//         if o.timedOut { ... }                  // stopped after 60 s
//         if o.exitCode != 0u32 { ... o.stderr.view() ... }
//       }
//       case imm e Error {
//         imm m = e.message();                   // 'run conec: The system cannot find the file specified'
//         ...
//       }
//     }
//     0i32;
//   }
//
// What it has:
//
//   process.run(args, opts, dir)  run args[0] with the rest as its arguments, in
//                                 the folder 'dir' (a Path; none: the current one)
//   process.runLine(line, opts, dir)  run a command line written out by hand
//   process.Options               timeout, inherit, crashReport; each has a default
//   process.Output                exitCode, timedOut, stdout, stderr, success()
//   process.ProcessError          op, program, dir, code, message(), notFound()
//   process.commandLine(args)     the line 'run' hands Windows for args
//   process.args()                this program's arguments, in UTF-8
//   process.currentExe()          this program's executable, a Path
//
// Two systems run programs by two designs, and the package gives the same
// interface over both; where they differ it is said below ('isWindows()', a
// constant of the compile, chooses, so only the target's calls are generated).
//
// **Paths.** A folder is a 'path' package 'Path': the working folder is the
// last parameter of 'run' and 'runLine', a '&Path' that defaults to "", the
// current folder ('process.run(args, new Options(), "build")': a string literal
// there is made a Path for the call, and a Path in a variable is lent, not given
// away). It is a parameter, not a field of Options, since a field's default
// must be a constant and a Path cannot be one (a parameter's default literal is
// made at the call). The ProcessError holds the 'Path' it was given. The program and its arguments
// are text, not paths: 'args' is a list of Strings, 'run' takes its program as
// 'args[0]', which may be a bare name the system finds (see "Finding the
// program"), and 'runLine' takes the line as a '&str'.
//
// **Running.** 'run' starts the program, waits until it ends, and answers
// an Output. By default the child reads its standard input from NUL (/dev/null
// on POSIX; it finds nothing there, never this program's keyboard), and what
// it writes to its standard output and its standard error is captured, the
// two kept apart, byte for byte: on Windows a C program's text mode writes
// '\n' as '\r\n', and that is what comes back. Both are read at once, so a
// child that writes a great deal to both never stalls on a full pipe. With
// 'inherit: true' the child shares this program's standard input, output and
// error instead, and nothing is captured: what 'congo run' wants. Flush what
// this program has printed first ('stdio.printFlush()'), or the child's lines
// come before it.
//
// A child shares this program's console, where it has one, so Ctrl+C
// reaches both. From a program with no console, a console child is started
// with CREATE_NO_WINDOW, so that no window opens for it. (On POSIX a child
// has this program's terminal, and its process group unless it has a time
// limit.)
//
// **The exit code is a value, not an error.** 'exitCode' is all 32 bits of
// it, a u32: 0, 1, 255, or on Windows an NTSTATUS such as 3221225477
// (0xC0000005, an access violation) or 3221226505 (0xC0000409), what a Cone
// panic ends with there. On POSIX a program that exits answers its status, 0
// to 255, and one a signal ended answers 128 plus the signal, as a shell
// reports it (134 for abort, which a Cone panic ends in; 139 for a
// segmentation fault). 'success()' is exit code 0 within the time. Go's 'Run' makes
// a nonzero exit an error; here, as in Python's 'run' and Rust's 'output',
// it is the answer, which the caller reads. An Error is only a program that
// could not be started: none of that name, a folder that is not there, an
// argument the system cannot be given.
//
// **The time limit.** With 'timeout', a Duration of the time package, above
// zero, the child is stopped when that long has passed since it started
// (measured on the time package's steady clock, and waited for in whole
// milliseconds, rounded up), and so is every
// program it has started and not yet seen end: on Windows it runs in a job
// object of its own, and the whole job is ended; on POSIX it runs in a
// process group of its own, and every process of the group is killed
// (SIGKILL), those that left the group with it. The Output then says
// 'timedOut', its exit code is 1, and what it wrote until then is kept. With
// no limit nothing is put in a job or a group, and a program it starts that is still
// running when it ends is left running, which a linker's helper may need to
// be. A child that ends, though, while a program it started still holds its
// output open has not finished writing: 'run' waits for that too, as Python's
// does, which only a time limit cuts short.
//
// **A crash.** A child that crashes -- a Cone panic ends in a crash on
// Windows, abort's fail-fast -- is handed by Windows to its crash reporting,
// Windows Error Reporting, as any program's crash is. That holds the dying
// child, and its executable locked, while it writes a report: a fifth of a
// second on a quiet machine, and many seconds when many crash at once, since
// one service handles them all. A test runner, whose children panic on
// purpose, wants none of that: with 'crashReport: false' the child runs as
// this program's debuggee, so its crash comes here first, and ends the
// child at once, with the exit code Windows would have given it (the
// exception's own code: 3221226505 for a panic), and nothing is reported.
// Nothing else changes for it: the exceptions it handles itself are its
// own, the programs it starts are no debugger's, and its heap is the one it
// would have had (Windows gives a program started under a debugger its
// checking debug heap, so its environment has _NO_DEBUG_HEAP=1 added, where
// that is not set already). Neither a job object's
// DIE_ON_UNHANDLED_EXCEPTION nor an error mode keeps a fail-fast from Windows
// Error Reporting; a debugger is what does. No other debugger can attach to
// such a child. On POSIX a crash is a signal, which ends the child as the
// answer says; what the system does besides is a core dump, which a crash
// reporter (Ubuntu's apport) may take on, so with 'crashReport: false' the
// child is started with core dumps off (the limit on their size is set to
// zero around the start, and put back).
//
// **The environment.** The child inherits this program's environment as it
// is when 'run' is called: set a variable with the env package first. There
// is no environment of the child's own to pass yet.
//
// **Arguments.** Windows hands a program one command line, and the program
// splits it. 'run' writes args as the line that Windows' own splitter,
// CommandLineToArgvW, and the C runtime's both read back as they were: an
// argument with a space, a tab, a line break or a '"', or an empty one, in
// double quotes, each '"' escaped with a backslash, and the backslashes
// before a '"' doubled ('commandLine' shows the line). The program's name,
// first, is read by a simpler rule, so it is quoted only when it holds a
// space or a tab, and may not hold a '"' at all. Everything is UTF-8, and
// goes to Windows as UTF-16; an argument that is not UTF-8 is refused
// (ERROR_NO_UNICODE_TRANSLATION), as is one holding a NUL
// (ERROR_INVALID_PARAMETER). A batch file ('.bat', '.cmd') is run by
// cmd.exe, which reads its line by cmd's rules, not these: an argument from
// outside the program is not safe on a batch file's line.
//
// On POSIX a program is given its arguments as a list, so 'run' does no
// quoting: every string, a space, a quote, a line break or none at all, reaches
// the child as it is (bytes; one holding a NUL byte, which ends a C string, is
// refused), 'commandLine' is Windows' text and nothing 'run' reads there.
//
// 'runLine' hands Windows a line as it is written, for a program with rules
// of its own: 'cmd /c' and what follows it, as Congo runs 'vcvars64.bat'. On
// POSIX the line is the shell's: 'runLine' runs '/bin/sh -c' with it.
//
// **Finding the program.** As Windows' CreateProcessW finds it: a name with
// no folder is looked for in the folder this program's executable is in,
// then the current folder, then Windows' system folders, then each folder
// on PATH, with '.exe' added when it has no extension. A relative path is
// read from this program's current folder, never from 'dir'. On POSIX, as
// 'execvp' does: a name with a '/' in it is a path, read from this program's
// current folder (never from 'dir' either), and a name without one is looked
// for in each folder on PATH.
//
// **Failure.** An Error holds a ProcessError: what was being done ('op'),
// the program, the folder it was to start in, and the system's error number
// ('code': on Windows GetLastError's, on POSIX errno's). Its 'message()' is
// one line for a person, in the system's own words (on Windows in English
// where it has them): 'run nosuch: The system cannot find the file
// specified', 'run conec in build/x: The directory name is invalid'; on POSIX
// 'run nosuch: No such file or directory'. 'notFound()' asks whether there was
// no such program (on POSIX also true of a folder that is not there, as the
// system gives ENOENT for both).
//
// **This program.** 'args()' is this program's own arguments, its name
// first, in UTF-8 whatever the system's code page, as Windows' parser splits
// them: 'main''s argv says the same for ASCII, and loses whatever the code
// page cannot hold (on POSIX they are argv's bytes, read from /proc/self/cmdline).
// 'currentExe()' is the path of this program's executable, a 'Path',
// normalized, every separator '/' (on POSIX read from /proc/self/exe).
//
// **What differs by system.** The package's interface (a list of arguments, a
// folder, a time limit; an exit code and two captured outputs) is not
// Windows': it is what Go, Rust, Python, Zig and Odin each give. Its
// insides differ, said here as plainly as can be. On Windows it is written over
// kernel32 (CreateProcessW, named pipes read with overlapped I/O, a job
// object, the debugging functions) and shell32's CommandLineToArgvW, with
// nothing of ISO C or POSIX beneath it, since neither can start a program with its outputs apart, in a
// folder, under a time limit. On POSIX it is posix_spawn with pipes read by
// poll (a process group stopped by a signal, a working folder set by
// posix_spawn's own file action, an argument list that needs no quoting, an
// exit code of 0 to 255, and beside it in the Output the signal that ended the
// child, if one did), with nothing of Windows'.

mod process;

import libc;
import posix;
import collections use String, List;
import path use Path;
import time;

// ---------------------------------------------------------------------------
// Windows: kernel32, and shell32's command-line parser. Everything the
// package asks of the OS is in this section.
// ---------------------------------------------------------------------------

struct SecurityAttributes {
  pub nLength u32;
  pub lpSecurityDescriptor *u8;
  pub bInheritHandle i32;
}

// STARTUPINFOEXW: STARTUPINFOW and the attribute list after it
struct StartupInfoEx {
  pub cb u32;
  pub lpReserved *u16;
  pub lpDesktop *u16;
  pub lpTitle *u16;
  pub dwX u32;
  pub dwY u32;
  pub dwXSize u32;
  pub dwYSize u32;
  pub dwXCountChars u32;
  pub dwYCountChars u32;
  pub dwFillAttribute u32;
  pub dwFlags u32;
  pub wShowWindow u16;
  pub cbReserved2 u16;
  pub lpReserved2 *u8;
  pub hStdInput usize;
  pub hStdOutput usize;
  pub hStdError usize;
  pub lpAttributeList *u8;
}

struct ProcessInformation {
  pub hProcess usize;
  pub hThread usize;
  pub dwProcessId u32;
  pub dwThreadId u32;
}

struct Overlapped {
  pub internal usize;
  pub internalHigh usize;
  pub offset u32;
  pub offsetHigh u32;
  pub hEvent usize;
}

// DEBUG_EVENT, its union read as words at its 8-byte alignment: an
// exception's code is the low half of word 0, and dwFirstChance the low half
// of word 19, after the 152-byte EXCEPTION_RECORD; a file handle is word 0
struct DebugEvent {
  pub code u32;
  pub pid u32;
  pub tid u32;
  pub u Array[u64, 20];
}

extern {
  fn @c(system) CreateProcessW(app *u16, cmd *u16, pattr *u8, tattr *u8, inherit i32, flags u32,
      env *u8, cwd *u16, si &mut StartupInfoEx, pi &mut ProcessInformation) i32;
  fn @c(system) CreateFileW(name *u16, access u32, share u32, sa &SecurityAttributes,
      disposition u32, flags u32, template usize) usize;
  fn @c(system) CreateNamedPipeW(name *u16, openMode u32, pipeMode u32, instances u32,
      outSize u32, inSize u32, timeout u32, sa *u8) usize;
  fn @c(system) CreateEventW(sa *u8, manual i32, initial i32, name *u16) usize;
  fn @c(system) ReadFile(h usize, buf *u8, size u32, read *u32, ov &mut Overlapped) i32;
  fn @c(system) GetOverlappedResult(h usize, ov &mut Overlapped, got &mut u32, block i32) i32;
  fn @c(system) CancelIoEx(h usize, ov &mut Overlapped) i32;
  fn @c(system) WaitForSingleObject(h usize, ms u32) u32;
  fn @c(system) WaitForMultipleObjects(count u32, handles *usize, all i32, ms u32) u32;
  fn @c(system) GetExitCodeProcess(h usize, code &mut u32) i32;
  fn @c(system) TerminateProcess(h usize, code u32) i32;
  fn @c(system) ResumeThread(h usize) u32;
  fn @c(system) CloseHandle(h usize) i32;
  fn @c(system) GetLastError() u32;
  fn @c(system) CreateJobObjectW(sa *u8, name *u16) usize;
  fn @c(system) AssignProcessToJobObject(job usize, h usize) i32;
  fn @c(system) TerminateJobObject(job usize, code u32) i32;
  fn @c(system) WaitForDebugEvent(ev &mut DebugEvent, ms u32) i32;
  fn @c(system) ContinueDebugEvent(pid u32, tid u32, status u32) i32;
  fn @c(system) DebugActiveProcessStop(pid u32) i32;
  fn @c(system) GetEnvironmentStringsW() *u16;
  fn @c(system) FreeEnvironmentStringsW(block *u16) i32;
  fn @c(system) InitializeProcThreadAttributeList(list *u8, count u32, flags u32, size &mut usize) i32;
  fn @c(system) UpdateProcThreadAttribute(list *u8, flags u32, attribute usize, value *u8,
      size usize, previous *u8, returned *usize) i32;
  fn @c(system) DeleteProcThreadAttributeList(list *u8);
  fn @c(system) GetStdHandle(which u32) usize;
  fn @c(system) GetCurrentProcess() usize;
  fn @c(system) DuplicateHandle(fromProcess usize, from usize, toProcess usize, to &mut usize,
      access u32, inherit i32, options u32) i32;
  fn @c(system) GetConsoleWindow() usize;
  fn @c(system) GetCurrentProcessId() u32;
  fn @c(system) GetCurrentThreadId() u32;
  fn @c(system) MultiByteToWideChar(page u32, flags u32, from *u8, fromLen i32, to *u16, toLen i32) i32;
  fn @c(system) WideCharToMultiByte(page u32, flags u32, from *u16, fromLen i32, to *u8, toLen i32,
      fallback *u8, usedFallback *i32) i32;
  fn @c(system) FormatMessageW(flags u32, source *u8, id u32, language u32, buf *u16, size u32,
      args *u8) u32;
  fn @c(system) GetModuleFileNameW(module usize, buf *u16, size u32) u32;
  fn @c(system) GetCommandLineW() *u16;
  fn @c(system) LocalFree(p *u8) usize;
  fn @c(system) CommandLineToArgvW(line *u16, count &mut i32) **u16;
}

const genericRead = 0x80000000u32;
const genericWrite = 0x40000000u32;
const shareReadWrite = 3u32;                     // FILE_SHARE_READ | FILE_SHARE_WRITE
const openExisting = 3u32;                       // OPEN_EXISTING
const pipeAccessInbound = 1u32;                  // PIPE_ACCESS_INBOUND
const flagOverlapped = 0x40000000u32;            // FILE_FLAG_OVERLAPPED
const flagFirstInstance = 0x80000u32;            // FILE_FLAG_FIRST_PIPE_INSTANCE
const pipeRejectRemote = 8u32;                   // PIPE_TYPE_BYTE | PIPE_REJECT_REMOTE_CLIENTS
const pipeSize = 65536u32;
const useStdHandles = 0x100u32;                  // STARTF_USESTDHANDLES
const createSuspended = 0x4u32;                  // CREATE_SUSPENDED
const createNoWindow = 0x8000000u32;             // CREATE_NO_WINDOW
const extendedStartupInfo = 0x80000u32;          // EXTENDED_STARTUPINFO_PRESENT
const attributeHandleList = 0x20002usize;        // PROC_THREAD_ATTRIBUTE_HANDLE_LIST
const waitTimeout = 0x102u32;                    // WAIT_TIMEOUT
const infinite = 0xFFFFFFFFu32;                  // INFINITE
const stdInput = 0xFFFFFFF6u32;                  // STD_INPUT_HANDLE, (DWORD)-10
const stdOutput = 0xFFFFFFF5u32;                 // STD_OUTPUT_HANDLE, (DWORD)-11
const stdError = 0xFFFFFFF4u32;                  // STD_ERROR_HANDLE, (DWORD)-12
const invalidHandle = 0xFFFFFFFFFFFFFFFFusize;   // INVALID_HANDLE_VALUE
const duplicateSameAccess = 2u32;                // DUPLICATE_SAME_ACCESS
const formatFromSystem = 0x1200u32;              // FORMAT_MESSAGE_FROM_SYSTEM | IGNORE_INSERTS
const english = 0x409u32;                        // MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US)
const utf8Page = 65001u32;                       // CP_UTF8
const invalidUtf8Fails = 8u32;                   // MB_ERR_INVALID_CHARS
const stoppedCode = 1u32;                        // the exit code a child stopped by a timeout gets
const debugOnlyThisProcess = 0x2u32;             // DEBUG_ONLY_THIS_PROCESS
const unicodeEnvironment = 0x400u32;             // CREATE_UNICODE_ENVIRONMENT
const exceptionDebugEvent = 1u32;                // EXCEPTION_DEBUG_EVENT
const createProcessDebugEvent = 3u32;            // CREATE_PROCESS_DEBUG_EVENT
const exitProcessDebugEvent = 5u32;              // EXIT_PROCESS_DEBUG_EVENT
const loadDllDebugEvent = 6u32;                  // LOAD_DLL_DEBUG_EVENT
const dbgContinue = 0x00010002u32;               // DBG_CONTINUE
const dbgNotHandled = 0x80010001u32;             // DBG_EXCEPTION_NOT_HANDLED
const statusBreakpoint = 0x80000003u32;          // STATUS_BREAKPOINT
const debugSlice = 10u32;                        // ms waited at a time, between a debuggee's events

// Windows' error numbers the package gives or reads
pub const errorFileNotFound = 2u32;              // ERROR_FILE_NOT_FOUND
pub const errorPathNotFound = 3u32;              // ERROR_PATH_NOT_FOUND
pub const errorInvalidParameter = 87u32;         // ERROR_INVALID_PARAMETER
pub const errorInvalidName = 123u32;             // ERROR_INVALID_NAME
pub const errorDirectory = 267u32;               // ERROR_DIRECTORY
pub const errorNoUnicodeTranslation = 1113u32;   // ERROR_NO_UNICODE_TRANSLATION
const errorBrokenPipe = 109u32;                  // ERROR_BROKEN_PIPE
const errorIoPending = 997u32;                   // ERROR_IO_PENDING

// ---------------------------------------------------------------------------
// POSIX: the C library's posix_spawn and its file actions, pipes, poll, wait
// and kill. Declared on every platform, called only on POSIX.
// ---------------------------------------------------------------------------

// struct pollfd: a file descriptor, the events asked for and those that came
struct PollFd {
  pub fd i32;
  pub events i16;
  pub revents i16;
}

// struct rlimit: a soft and a hard limit
struct RLimit {
  pub soft u64;
  pub hard u64;
}

extern {
  fn @c("posix_spawnp") spawnProgram(pid *i32, file cstr, actions *u8, attr *u8, argv **u8, envp **u8) i32;
  fn @c("posix_spawn_file_actions_init") actionsInit(actions *u8) i32;
  fn @c("posix_spawn_file_actions_destroy") actionsDestroy(actions *u8) i32;
  fn @c("posix_spawn_file_actions_adddup2") actionsDup2(actions *u8, fd i32, to i32) i32;
  fn @c("posix_spawn_file_actions_addopen") actionsOpen(actions *u8, fd i32, path cstr, flags i32, mode u32) i32;
  fn @c("posix_spawn_file_actions_addchdir_np") actionsChdir(actions *u8, path cstr) i32;
  fn @c("posix_spawnattr_init") attrInit(attr *u8) i32;
  fn @c("posix_spawnattr_destroy") attrDestroy(attr *u8) i32;
  fn @c("posix_spawnattr_setflags") attrFlags(attr *u8, flags i16) i32;
  fn @c("posix_spawnattr_setpgroup") attrGroup(attr *u8, group i32) i32;
  fn @c("pipe2") makePipe2(fds *i32, flags i32) i32;
  fn @c("poll") pollFds(fds *PollFd, count u64, ms i32) i32;
  fn @c("read") readFd(fd i32, buf *u8, count usize) isize;
  fn @c("close") closeFd(fd i32) i32;
  fn @c("waitpid") waitPid(pid i32, status *i32, options i32) i32;
  fn @c("kill") killPid(pid i32, signal i32) i32;
  fn @c("getrlimit") getLimit(resource i32, limit *RLimit) i32;
  fn @c("setrlimit") setLimit(resource i32, limit *RLimit) i32;
  fn @c("readlink") readLink(path cstr, buf *u8, size usize) isize;
  fn @c cone_environ() **u8;
}

const errnoInterrupted = 4i32;             // EINTR
const errnoNoEntry = 2u32;                 // ENOENT
const errnoInvalid = 22u32;                // EINVAL
const errnoNotDirectory = 20u32;           // ENOTDIR
const closeOnExec = 0x80000i32;            // O_CLOEXEC
const openReadOnly = 0i32;                 // O_RDONLY
const pollIn = 1i16;                       // POLLIN
const spawnSetGroup = 2i16;                // POSIX_SPAWN_SETPGROUP
const waitNoHang = 1i32;                   // WNOHANG
const signalKill = 9i32;                   // SIGKILL
const limitCore = 4i32;                    // RLIMIT_CORE

// ---------------------------------------------------------------------------
// Failure
// ---------------------------------------------------------------------------

// Why a program could not be run, or a question about this one not answered
pub struct ProcessError {
  // The function that failed: "run", "runLine", "currentExe"
  pub op String;
  // The program, as 'run' was given it ('runLine''s whole line)
  pub program String;
  // The working folder it was to start in, or "" for this program's own
  pub dir Path;
  // The system's error number: on Windows GetLastError's (errorFileNotFound,
  // errorDirectory, ...), on POSIX errno's (ENOENT, ...)
  pub code u32;

  // One line for a person: 'run nosuch: The system cannot find the file
  // specified', or 'run conec in build/x: The directory name is invalid'
  pub fn message(self &) String {
    var out = String.from(op.view());
    if not program.isEmpty() {
      out.append(" ");
      out.append(program.view());
    }
    if not dir.isEmpty() {
      out.append(" in ");
      out.append(dir.view());
    }
    out.append(": ");
    let text = systemText(code);
    out.append(text.view());
    out
  }

  // Whether it failed because there is no such program (or no folder on its
  // path), ERROR_FILE_NOT_FOUND or ERROR_PATH_NOT_FOUND; on POSIX ENOENT
  pub fn notFound(self &) bool {
    if isWindows() {code == errorFileNotFound or code == errorPathNotFound} else {code == errnoNoEntry}
  }
}

// The error number for an argument the system cannot be given (a NUL byte, no
// program at all): ERROR_INVALID_PARAMETER, or POSIX's EINVAL
fn invalidParameter() u32 { if isWindows() {errorInvalidParameter} else {errnoInvalid}; }

fn failure(op &str, program &str, dir &Path, code u32) ProcessError {
  new ProcessError(String.from(op), String.from(program), dir.copy(), code)
}

// The system's text for an error number: Windows' own (in English where it
// has it), or on POSIX the C library's strerror
fn systemText(code u32) String {
  if isWindows() {windowsText(code)} else {String.from(libc.strerror(i32.from(code)).view())}
}

// Windows' text for an error number, in English where the system has it,
// with no line end or full stop; 'Windows error N' where it has none
fn windowsText(code u32) String {
  var buf = new Array[u16, 512] <- fill 0u16;
  let bp *u16 = &[]buf as *u16;
  var n = FormatMessageW(formatFromSystem, null, code, english, bp, 512u32, null);
  if n == 0u32 {
    n = FormatMessageW(formatFromSystem, null, code, 0u32, bp, 512u32, null);
  }
  var out = String.empty();
  if n == 0u32 {
    out.append("Windows error ");
    out.appendUInt(u64.from(code));
    return out;
  }
  let text = narrow(bp, i32.from(n));
  let trimmed = text.trim();
  out.append(trimmed.view());
  if out.endsWith(".") {
    let cut = out.sub(0usize, out.len() - 1usize);
    return cut;
  }
  out
}

// ---------------------------------------------------------------------------
// UTF-8 and UTF-16
// ---------------------------------------------------------------------------

// s as UTF-16 ending in a 0, in a block from libc's malloc the caller frees;
// a null pointer when s is not UTF-8
fn widen(s &Array[u8]) *u16 {
  if s.len == 0usize {
    let p = libc.malloc(2usize) as *u16;
    *p = 0u16;
    return p;
  }
  if s.len > 0x3FFFFFFFusize { return null; }
  let len = i32.from(s.len);
  let n = MultiByteToWideChar(utf8Page, invalidUtf8Fails, s as *u8, len, null, 0i32);
  if n == 0i32 { return null; }
  let count = usize.from(n);
  let p = libc.malloc((count + 1usize) * 2usize) as *u16;
  MultiByteToWideChar(utf8Page, invalidUtf8Fails, s as *u8, len, p, n);
  *(p + count) = 0u16;
  p
}

// UTF-16 as UTF-8: n units from p, or up to its 0 when n is -1. A lone
// surrogate, which is no character, becomes U+FFFD.
fn narrow(p *u16, n i32) String {
  var out = String.empty();
  if n == 0i32 { return out; }
  let size = WideCharToMultiByte(utf8Page, 0u32, p, n, null, 0i32, null, null);
  if size <= 0i32 { return out; }
  let buf = libc.malloc(usize.from(size));
  WideCharToMultiByte(utf8Page, 0u32, p, n, buf, size, null, null);
  // Counted up to the 0, the 0 is among the bytes
  let len = if n < 0i32 {usize.from(size) - 1usize} else {usize.from(size)};
  out.appendBytes(mem.sliceFromParts(buf, len));
  libc.free(buf);
  out
}

// ---------------------------------------------------------------------------
// The command line
// ---------------------------------------------------------------------------

fn hasByte(s &Array[u8], b u8) bool {
  var i = 0usize;
  while i < s.len {
    if s[i] == b { return true; }
    i = i + 1usize;
  }
  false
}

fn appendBackslashes(out &mut String, n usize) {
  var k = 0usize;
  while k < n {
    out.appendByte('\\');
    k = k + 1usize;
  }
}

// One argument after the program, written so that CommandLineToArgvW, and
// the C runtime's own parser, read it back as it is: as it is when nothing
// in it needs quoting; otherwise in double quotes, each '"' after a
// backslash, and the backslashes before a '"' (or before the closing one)
// doubled
fn quoteArg(out &mut String, a &Array[u8]) {
  var plain = a.len > 0usize;
  var i = 0usize;
  while i < a.len {
    let c = a[i];
    if c == ' ' or c == '\t' or c == '\n' or c == 0x0Bu8 or c == '"' { plain = false; }
    i = i + 1usize;
  }
  if plain {
    out.append(a as &str);
    return;
  }
  out.appendByte('"');
  var slashes = 0usize;
  i = 0usize;
  while i < a.len {
    let c = a[i];
    if c == '\\' {
      slashes = slashes + 1usize;
    }
    else {
      if c == '"' {
        appendBackslashes(out, slashes * 2usize + 1usize);
      }
      else {
        appendBackslashes(out, slashes);
      }
      slashes = 0usize;
      out.appendByte(c);
    }
    i = i + 1usize;
  }
  appendBackslashes(out, slashes * 2usize);
  out.appendByte('"');
}

// The program, first on the line, which Windows reads by a rule of its own:
// up to the next space, or, after a '"', up to the next '"', backslashes and
// all. So it is quoted only where it holds a space or a tab, or is empty,
// and can hold no '"', which 'run' refuses.
fn quoteProgram(out &mut String, p &Array[u8]) {
  if p.len > 0usize and not hasByte(p, ' ') and not hasByte(p, '\t') {
    out.append(p as &str);
    return;
  }
  out.appendByte('"');
  out.append(p as &str);
  out.appendByte('"');
}

// The command line 'run' hands Windows for args: the program, then each
// argument, quoted where it must be, one space between them. A program
// holding a '"' cannot be written, and is written as it is.
pub fn commandLine(args &Array[String]) String {
  var out = String.empty();
  var i = 0usize;
  while i < args.len {
    if i == 0usize {
      quoteProgram(&mut out, args[i].view());
    }
    else {
      out.appendByte(' ');
      quoteArg(&mut out, args[i].view());
    }
    i = i + 1usize;
  }
  out
}

// ---------------------------------------------------------------------------
// Running
// ---------------------------------------------------------------------------

// How to run a program; each has a default
pub struct Options {
  // Stop it, and every program it started, once this has passed; zero (or
  // less) waits as long as it runs
  pub timeout time.Duration = new time.Duration();
  // Share this program's standard input, output and error rather than
  // reading from NUL and capturing what it writes
  pub inherit bool = false;
  // Let a crash, a panic's among them, go to the system's crash reporting,
  // as any program's does; false ends it here at once, with the exit code
  // the crash gives, and reports nothing (below, "A crash")
  pub crashReport bool = true;
}

// What a run gives back
pub struct Output {
  // Its exit code, all 32 bits: 0, 1, 255, or 3221226505 (0xC0000409),
  // what a Cone panic exits with on Windows
  pub exitCode u32;
  // The signal that ended it, on POSIX, when one did (9 for SIGKILL, 6 for
  // abort's SIGABRT), else 0; always 0 on Windows. A child killed by signal 9
  // has exit code 137, as one that exits 137 does: this tells them apart
  pub signal u32;
  // Whether it was stopped because its time ran out; its exit code is then 1
  pub timedOut bool;
  // What it wrote to its standard output and its standard error, apart,
  // byte for byte; empty when it inherited them
  pub stdout String;
  pub stderr String;

  // It finished in time, with exit code 0
  pub fn success(self &) bool { exitCode == 0u32 and not timedOut }
}

// Run a program and wait for it: args[0] is the program, the rest its
// arguments. Its exit code is in the Output, whatever it is; an Error is a
// program that could not be started. It starts in 'dir', a Path lent or a
// string literal (made one for the call), or in this program's current folder
// when 'dir' is left out or empty.
pub fn run(args &Array[String], opts Options = new Options(), dir &Path = "") Result[Output, ProcessError] {
  if args.len == 0usize {
    return Error[Output, ProcessError](failure("run", "", dir, invalidParameter()));
  }
  let program = args[0usize].view();
  var i = 0usize;
  while i < args.len {
    if hasByte(args[i].view(), 0u8) {
      return Error[Output, ProcessError](failure("run", program, dir, invalidParameter()));
    }
    i = i + 1usize;
  }
  // The program's name may not hold a '"' on Windows, which cannot write it
  if isWindows() and hasByte(program, '"') {
    return Error[Output, ProcessError](failure("run", program, dir, errorInvalidName));
  }
  if isWindows() {
    let line = commandLine(args);
    start("run", program, line.view(), dir, opts)
  }
  else {
    startPosix("run", program, args, dir, opts)
  }
}

// Run a command line as it is, for a program that reads its own line by
// rules of its own, as 'cmd /c' does (on POSIX, the shell's: '/bin/sh -c');
// otherwise as 'run'
pub fn runLine(line &str, opts Options = new Options(), dir &Path = "") Result[Output, ProcessError] {
  if hasByte(line, 0u8) {
    return Error[Output, ProcessError](failure("runLine", line, dir, invalidParameter()));
  }
  if isWindows() {
    start("runLine", line, line, dir, opts)
  }
  else {
    var shell = List[String].empty();
    shell.push(String.from("/bin/sh"));
    shell.push(String.from("-c"));
    shell.push(String.from(line));
    startPosix("runLine", line, shell.view(), dir, opts)
  }
}

// One of the child's streams, read without blocking: our end of its pipe,
// the read in flight, and what has come
struct Stream {
  pub pipe usize;
  pub ov Overlapped;
  pub buf *u8;
  pub data String;
  pub active bool;
}

fn noStream() Stream {
  new Stream(0usize, new Overlapped(0usize, 0usize, 0u32, 0u32, 0usize), null, String.empty(), false)
}

// Each pipe a name of its own: this process, this thread, and a count
var @threadlocal pipeSerial = 0u32;

// A pipe for one of the child's outputs: our end, to read without blocking,
// goes in s; the child's end, inheritable, is returned, or 0 on failure
fn makePipe(s &mut Stream) usize {
  var tries = 0u32;
  while tries < 8u32 {
    tries = tries + 1u32;
    pipeSerial = pipeSerial + 1u32;
    var name = String.from("\\\\.\\pipe\\cone-process-");
    name.appendUInt(u64.from(GetCurrentProcessId()));
    name.append("-");
    name.appendUInt(u64.from(GetCurrentThreadId()));
    name.append("-");
    name.appendUInt(u64.from(pipeSerial));
    let wname = widen(name.view());
    let ours = CreateNamedPipeW(wname, pipeAccessInbound | flagOverlapped | flagFirstInstance,
      pipeRejectRemote, 1u32, pipeSize, pipeSize, 0u32, null);
    if ours != invalidHandle {
      let sa = new SecurityAttributes(24u32, null, 1i32);
      let theirs = CreateFileW(wname, genericWrite, 0u32, &sa, openExisting, 0u32, 0usize);
      libc.free(wname as *u8);
      let event = CreateEventW(null, 1i32, 0i32, null);
      if theirs == invalidHandle or event == 0usize {
        closeIf(theirs);
        closeIf(event);
        CloseHandle(ours);
        return 0usize;
      }
      s.pipe = ours;
      s.ov.hEvent = event;
      s.buf = libc.malloc(usize.from(pipeSize));
      s.active = true;
      return theirs;
    }
    libc.free(wname as *u8);
  }
  0usize
}

// The NUL device, inheritable, to read from or write to
fn openNul(access u32) usize {
  let sa = new SecurityAttributes(24u32, null, 1i32);
  let wname = widen("NUL");
  let h = CreateFileW(wname, access, shareReadWrite, &sa, openExisting, 0u32, 0usize);
  libc.free(wname as *u8);
  if h == invalidHandle {0usize} else {h};
}

// An inheritable copy of one of this program's standard handles, or NUL
// where it has none
fn inheritStd(which u32, access u32) usize {
  let h = GetStdHandle(which);
  if h != 0usize and h != invalidHandle {
    var copy = 0usize;
    let me = GetCurrentProcess();
    if DuplicateHandle(me, h, me, &mut copy, 0u32, 1i32, duplicateSameAccess) != 0i32 {
      return copy;
    }
  }
  openNul(access)
}

fn closeIf(h usize) {
  if h != 0usize and h != invalidHandle { CloseHandle(h); }
}

// Start the next read; a pipe the child has closed, all its handles gone,
// ends the stream (ERROR_BROKEN_PIPE)
fn readNext(s &mut Stream) {
  s.ov.internal = 0usize;
  s.ov.internalHigh = 0usize;
  if ReadFile(s.pipe, s.buf, pipeSize, null, &mut s.ov) == 0i32 {
    if GetLastError() != errorIoPending { s.active = false; }
  }
}

// A read has finished: keep what it brought, and start the next
fn harvest(s &mut Stream) {
  var got = 0u32;
  if GetOverlappedResult(s.pipe, &mut s.ov, &mut got, 0i32) == 0i32 {
    s.active = false;
    return;
  }
  if got > 0u32 { s.data.appendBytes(mem.sliceFromParts(s.buf, usize.from(got))); }
  readNext(s);
}

// Stop reading: cancel the read in flight, and wait until Windows is done
// with the buffer, keeping whatever it brought
fn cancel(s &mut Stream) {
  if not s.active { return; }
  CancelIoEx(s.pipe, &mut s.ov);
  var got = 0u32;
  if GetOverlappedResult(s.pipe, &mut s.ov, &mut got, 1i32) != 0i32 and got > 0u32 {
    s.data.appendBytes(mem.sliceFromParts(s.buf, usize.from(got)));
  }
  s.active = false;
}

fn closeStream(s &mut Stream) {
  closeIf(s.pipe);
  closeIf(s.ov.hEvent);
  if s.buf as usize != 0usize { libc.free(s.buf); }
}

// Milliseconds left until deadline, rounded up, for a wait; INFINITE when
// there is none
fn remaining(timed bool, deadline time.Instant) u32 {
  if not timed { return infinite; }
  let left = (deadline - time.Instant.now()).nanos();
  if left <= 0i64 { return 0u32; }
  let ms = (left + 999999i64) / 1000000i64;
  if ms >= i64.from(infinite) {infinite - 1u32} else {u32.from(ms)};
}

// Stop the child, and with it every program it started, where they are in
// its job
fn stop(job usize, child usize) {
  if job != 0usize {
    if TerminateJobObject(job, stoppedCode) != 0i32 { return; }
  }
  TerminateProcess(child, stoppedCode);
}

// A child run as this program's debuggee ('crashReport: false'): its
// process, the debug event being handled, whether the loader's breakpoint
// has come, and whether it has exited
struct Debuggee {
  pub on bool;
  pub child usize;
  pub seenBreakpoint bool;
  pub exited bool;
  pub ev DebugEvent;
}

// Handle the debuggee's events that come within ms milliseconds; whether it
// has exited. Only the thread that started it may, and until one does, it
// is stopped. A crash comes to a debugger as a second-chance exception,
// before Windows' crash reporting would see it, and ends the child there
// with the exception's code, the exit code Windows would have given it.
// Everything else goes on as with no debugger: a first-chance exception to
// the child's own handlers, the loader's breakpoint aside
fn pump(d &mut Debuggee, ms u32) bool {
  var within = ms;
  while not d.exited and WaitForDebugEvent(&mut d.ev, within) != 0i32 {
    within = 0u32;
    var status = dbgContinue;
    if d.ev.code == exceptionDebugEvent {
      let code = u32.from(d.ev.u[0usize]);
      let firstChance = u32.from(d.ev.u[19usize]) != 0u32;
      if firstChance and code == statusBreakpoint and not d.seenBreakpoint {
        d.seenBreakpoint = true;
      }
      elif firstChance {
        status = dbgNotHandled;
      }
      elif TerminateProcess(d.child, code) == 0i32 {
        status = dbgNotHandled;
      }
    }
    elif d.ev.code == createProcessDebugEvent or d.ev.code == loadDllDebugEvent {
      // The image's file, the debugger's to close
      closeIf(usize.from(d.ev.u[0usize]));
    }
    elif d.ev.code == exitProcessDebugEvent {
      d.exited = true;
    }
    ContinueDebugEvent(d.ev.pid, d.ev.tid, status);
  }
  d.exited
}

// The environment a debuggee is started with: this program's, with
// _NO_DEBUG_HEAP=1 added where it is not set, since Windows gives a program
// started under a debugger its checking debug heap otherwise, and a program
// that runs clean on its usual heap can end in STATUS_HEAP_CORRUPTION on
// that one. A block for CreateProcessW, from malloc, or null for this
// program's own
fn debuggeeEnvironment() *u16 {
  let block = GetEnvironmentStringsW();
  if block as usize == 0usize { return null; }
  let name &Array[u8] = "_NO_DEBUG_HEAP=";
  var found = false;
  // Each string, to the empty one that ends the block
  var i = 0usize;
  while *(block + i) != 0u16 {
    var j = 0usize;
    while j < name.len and *(block + i + j) == u16.from(name[j]) { j = j + 1usize; }
    if j == name.len { found = true; }
    while *(block + i) != 0u16 { i = i + 1usize; }
    i = i + 1usize;
  }
  let added &Array[u8] = "_NO_DEBUG_HEAP=1";
  var extra = 0usize;
  if not found { extra = added.len + 1usize; }
  let out = libc.malloc((i + extra + 1usize) * 2usize) as *u16;
  var k = 0usize;
  while k < i {
    *(out + k) = *(block + k);
    k = k + 1usize;
  }
  if not found {
    var m = 0usize;
    while m < added.len {
      *(out + k) = u16.from(added[m]);
      k = k + 1usize;
      m = m + 1usize;
    }
    *(out + k) = 0u16;
    k = k + 1usize;
  }
  *(out + k) = 0u16;
  FreeEnvironmentStringsW(block);
  out
}

// How long to wait for a stream or the child: until the deadline, or a
// slice of it when there are a debuggee's events to handle between
fn waitFor(timed bool, deadline time.Instant, debugging bool) u32 {
  let left = remaining(timed, deadline);
  if debugging and left > debugSlice {debugSlice} else {left};
}

// Start line, read what it writes, wait for it
fn start(op &str, program &str, line &str, dir &Path, opts Options) Result[Output, ProcessError] {
  let wline = widen(line);
  if wline as usize == 0usize {
    return Error[Output, ProcessError](failure(op, program, dir, errorNoUnicodeTranslation));
  }
  var wdir *u16 = null;
  if not dir.isEmpty() {
    if hasByte(dir.view(), 0u8) {
      libc.free(wline as *u8);
      return Error[Output, ProcessError](failure(op, program, dir, errorInvalidParameter));
    }
    wdir = widen(dir.view());
    if wdir as usize == 0usize {
      libc.free(wline as *u8);
      return Error[Output, ProcessError](failure(op, program, dir, errorNoUnicodeTranslation));
    }
  }

  // The child's three standard handles, each inheritable
  var so = noStream();
  var se = noStream();
  var childIn = 0usize;
  var childOut = 0usize;
  var childErr = 0usize;
  if opts.inherit {
    childIn = inheritStd(stdInput, genericRead);
    childOut = inheritStd(stdOutput, genericWrite);
    childErr = inheritStd(stdError, genericWrite);
  }
  else {
    childIn = openNul(genericRead);
    childOut = makePipe(&mut so);
    childErr = makePipe(&mut se);
  }

  // Only those three are inherited: no other handle this program has open,
  // a pipe another thread's run is making among them
  var handles = new Array[usize, 3] <- fill 0usize;
  handles[0usize] = childIn;
  handles[1usize] = childOut;
  handles[2usize] = childErr;
  let hp *usize = &[]handles as *usize;
  var listSize = 0usize;
  InitializeProcThreadAttributeList(null, 1u32, 0u32, &mut listSize);
  let list = libc.malloc(listSize);
  var failed = true;
  var code = 0u32;
  if childIn == 0usize or childOut == 0usize or childErr == 0usize {
    code = GetLastError();
  }
  elif InitializeProcThreadAttributeList(list, 1u32, 0u32, &mut listSize) == 0i32 {
    code = GetLastError();
  }
  elif UpdateProcThreadAttribute(list, 0u32, attributeHandleList, hp as *u8, 24usize,
      null, null) == 0i32 {
    code = GetLastError();
    DeleteProcThreadAttributeList(list);
  }
  else {
    failed = false;
  }

  var pi = new ProcessInformation(0usize, 0usize, 0u32, 0u32);
  let timed = opts.timeout > time.Duration.zero();
  if not failed {
    var si = new StartupInfoEx(112u32, null, null, null,
      0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, useStdHandles, 0u16, 0u16, null,
      childIn, childOut, childErr, list);
    var flags = extendedStartupInfo;
    if timed { flags = flags | createSuspended; }
    var environment *u16 = null;
    if not opts.crashReport {
      flags = flags | debugOnlyThisProcess;
      environment = debuggeeEnvironment();
      if environment as usize != 0usize { flags = flags | unicodeEnvironment; }
    }
    // A console program started from a program with no console would open a
    // window of its own
    if GetConsoleWindow() == 0usize { flags = flags | createNoWindow; }
    if CreateProcessW(null, wline, null, null, 1i32, flags,
        environment as *u8, wdir, &mut si, &mut pi) == 0i32 {
      failed = true;
      code = GetLastError();
    }
    if environment as usize != 0usize { libc.free(environment as *u8); }
    DeleteProcThreadAttributeList(list);
  }
  libc.free(list);
  libc.free(wline as *u8);
  if wdir as usize != 0usize { libc.free(wdir as *u8); }
  // The child's ends are the child's now: with ours closed, a pipe ends when
  // the child, and whatever it started, has closed it
  closeIf(childIn);
  closeIf(childOut);
  closeIf(childErr);
  if failed {
    closeStream(&mut so);
    closeStream(&mut se);
    if code == 0u32 { code = errorInvalidParameter; }
    return Error[Output, ProcessError](failure(op, program, dir, code));
  }

  // With a time limit, the child goes in a job of its own before it runs,
  // so that the programs it starts are in it too and stop with it
  var job = 0usize;
  var deadline = time.Instant.fromNanos(0i64);
  if timed {
    job = CreateJobObjectW(null, null);
    if job != 0usize and AssignProcessToJobObject(job, pi.hProcess) == 0i32 {
      CloseHandle(job);
      job = 0usize;
    }
    deadline = time.Instant.now() + opts.timeout;
    ResumeThread(pi.hThread);
  }

  // Run as this program's debuggee, its events are handled while it runs
  var dbg = new Debuggee(not opts.crashReport, pi.hProcess, false, false,
    new DebugEvent(0u32, 0u32, 0u32, new Array[u64, 20] <- fill 0u64));

  // Both outputs at once, so that a child blocked writing one is never
  // waiting on a reader blocked on the other
  var timedOut = false;
  if so.active { readNext(&mut so); }
  if se.active { readNext(&mut se); }
  var events = new Array[usize, 2] <- fill 0usize;
  let ep *usize = &[]events as *usize;
  while so.active or se.active {
    if dbg.on { pump(&mut dbg, 0u32); }
    var n = 0u32;
    if so.active {
      events[0usize] = so.ov.hEvent;
      n = 1u32;
    }
    if se.active {
      events[usize.from(n)] = se.ov.hEvent;
      n = n + 1u32;
    }
    // A debuggee is stopped at each of its events until it is handled, so
    // with one the wait is for its events, which end it at once, and the
    // outputs are only looked at, not waited for
    var within = remaining(timed, deadline);
    if dbg.on { within = 0u32; }
    let r = WaitForMultipleObjects(n, ep, 0i32, within);
    if r == waitTimeout and dbg.on and not (timed and remaining(timed, deadline) == 0u32) {
      // Nothing read: wait for its next event, for a slice at most
      pump(&mut dbg, waitFor(timed, deadline, true));
    }
    elif r == waitTimeout {
      timedOut = true;
      stop(job, pi.hProcess);
      cancel(&mut so);
      cancel(&mut se);
    }
    elif r >= n {
      // The wait itself failed: stop reading
      cancel(&mut so);
      cancel(&mut se);
    }
    elif so.active and events[usize.from(r)] == so.ov.hEvent {
      harvest(&mut so);
    }
    else {
      harvest(&mut se);
    }
  }

  if dbg.on {
    // Its events until it exits, or its time runs out
    while not pump(&mut dbg, waitFor(timed, deadline, true)) and not timedOut {
      if timed and remaining(timed, deadline) == 0u32 {
        timedOut = true;
        stop(job, pi.hProcess);
      }
    }
    // Stopped, it still has its last events to give: for up to ten seconds,
    // and then it is let go
    var waits = 0u32;
    while not pump(&mut dbg, 50u32) and waits < 200u32 { waits = waits + 1u32; }
    if not dbg.exited { DebugActiveProcessStop(pi.dwProcessId); }
  }
  elif not timedOut and WaitForSingleObject(pi.hProcess, remaining(timed, deadline)) == waitTimeout {
    timedOut = true;
    stop(job, pi.hProcess);
  }
  WaitForSingleObject(pi.hProcess, infinite);
  var exitCode = 0u32;
  GetExitCodeProcess(pi.hProcess, &mut exitCode);
  CloseHandle(pi.hThread);
  CloseHandle(pi.hProcess);
  closeIf(job);
  closeStream(&mut so);
  closeStream(&mut se);
  var out = String.empty();
  var err = String.empty();
  out <=> so.data;
  err <=> se.data;
  Ok[Output, ProcessError](new Output(exitCode, 0u32, timedOut, out, err))
}

// ---------------------------------------------------------------------------
// POSIX: running a program, with posix_spawn
// ---------------------------------------------------------------------------

// One of the child's streams: our end of its pipe (-1 once closed) and what
// has come through it
struct Reader {
  pub fd i32;
  pub data String;
}

fn closeFdIf(fd i32) {
  if fd >= 0i32 { closeFd(fd); }
}

// Milliseconds left until deadline, rounded up, for a poll; -1, no limit,
// when there is none
fn remainingMs(timed bool, deadline time.Instant) i32 {
  if not timed { return -1i32; }
  let left = (deadline - time.Instant.now()).nanos();
  if left <= 0i64 { return 0i32; }
  let ms = (left + 999999i64) / 1000000i64;
  if ms > 2000000000i64 {2000000000i32} else {i32.from(ms)};
}

// A program's exit code from the status waitpid gave: the status it exited
// with, 0 to 255, or 128 and the signal that ended it
fn exitStatus(status i32) u32 {
  let signal = status & 0x7Fi32;
  if signal == 0i32 { return u32.from((status >> 8i32) & 0xFFi32); }
  u32.from(128i32 + signal)
}

// The signal that ended a child, from the status waitpid gave: 0 for one that
// exited
fn signalOf(status i32) u32 { u32.from(status & 0x7Fi32) }

// A copy of the bytes with a NUL after them, in a block from malloc
fn copyCString(s &Array[u8]) *u8 {
  let p = libc.malloc(s.len + 1usize);
  if s.len > 0usize { libc.memcpy(p, s as *u8, s.len); }
  p[s.len] = 0u8;
  p
}

// Stop the child and, where it was started in a group of its own, every
// program in it
fn stopGroup(pid i32, grouped bool) {
  if grouped {
    if killPid(0i32 - pid, signalKill) == 0i32 { return; }
  }
  killPid(pid, signalKill);
}

// Take what is waiting in a stream's pipe; an end, or a failure other than an
// interrupted call, closes it
fn readReady(r &mut Reader, buf *u8) {
  let n = readFd(r.fd, buf, 65536usize);
  if n > 0isize {
    r.data.appendBytes(mem.sliceFromParts(buf, usize.from(n)));
  }
  elif n == 0isize or *libc.errno() != errnoInterrupted {
    closeFd(r.fd);
    r.fd = -1i32;
  }
}

// Start args (the program first) with posix_spawn, read what it writes,
// wait for it
fn startPosix(op &str, program &str, args &Array[String], dir &Path, opts Options) Result[Output, ProcessError] {
  // The working folder must be a folder there is
  var cdir = String.empty();
  if not dir.isEmpty() {
    if hasByte(dir.view(), 0u8) {
      return Error[Output, ProcessError](failure(op, program, dir, errnoInvalid));
    }
    cdir = String.from(dir.view());
    var st = new posix.Stat(0u64, 0u64, 0u16, 0u32, 0u32, 0u32, 0u64, 0i64, 0i64, 0i64, 0i64);
    if posix.stat(cdir.cstr(), &mut st) != 0i32 {
      return Error[Output, ProcessError](failure(op, program, dir, u32.from(*libc.errno())));
    }
    if (st.st_mode & posix.S_IFMT) != posix.S_IFDIR {
      return Error[Output, ProcessError](failure(op, program, dir, errnoNotDirectory));
    }
  }

  // A program named by a relative path is read from this program's folder,
  // not from the child's
  // ('program' is what an error names; the program to run is the first
  // argument, which for a command line is the shell)
  let name = args[0usize].view();
  var file = String.from(name);
  let named &Array[u8] = name;
  if not dir.isEmpty() and hasByte(named, '/') and named[0usize] != '/' {
    let here = posix.getcwd(null, 0usize);
    if here != null {
      file = String.fromCStr(cstr.fromPtr(here));
      libc.free(here);
      file.appendByte('/');
      file.append(name);
    }
  }

  let count = args.len;
  let argv = libc.malloc((count + 1usize) * 8usize) as **u8;
  var k = 0usize;
  while k < count {
    *(argv + k) = copyCString(args[k].view());
    k = k + 1usize;
  }
  *(argv + count) = null;

  // The child's standard input from /dev/null and its output and error to
  // pipes of ours; close-on-exec, so no other program started meanwhile
  // holds them
  var so = new Reader(-1i32, String.empty());
  var se = new Reader(-1i32, String.empty());
  var outFds = new Array[i32, 2] <- fill 0i32;
  var errFds = new Array[i32, 2] <- fill 0i32;
  let outp *i32 = &[]outFds as *i32;
  let errp *i32 = &[]errFds as *i32;
  var actions = new Array[u64, 32] <- fill 0u64;
  var attr = new Array[u64, 64] <- fill 0u64;
  // (opaque to us, and aligned for the pointers they hold: a block of words)
  let aw *u64 = &[]actions as *u64;
  let tw *u64 = &[]attr as *u64;
  let ap *u8 = aw as *u8;
  let tp *u8 = tw as *u8;
  let timed = opts.timeout > time.Duration.zero();
  var rc = actionsInit(ap);
  if rc == 0i32 { rc = attrInit(tp); }
  if rc == 0i32 and not opts.inherit {
    if makePipe2(outp, closeOnExec) != 0i32 {
      rc = *libc.errno();
    }
    elif makePipe2(errp, closeOnExec) != 0i32 {
      rc = *libc.errno();
      closeFd(outFds[0usize]);
      closeFd(outFds[1usize]);
    }
    else {
      so.fd = outFds[0usize];
      se.fd = errFds[0usize];
      rc = actionsOpen(ap, 0i32, "/dev/null", openReadOnly, 0u32);
      if rc == 0i32 { rc = actionsDup2(ap, outFds[1usize], 1i32); }
      if rc == 0i32 { rc = actionsDup2(ap, errFds[1usize], 2i32); }
    }
  }
  if rc == 0i32 and cdir.len() > 0usize { rc = actionsChdir(ap, cdir.cstr()); }
  if rc == 0i32 and timed {
    rc = attrFlags(tp, spawnSetGroup);
    if rc == 0i32 { rc = attrGroup(tp, 0i32); }
  }

  // A crash that is not to be reported leaves no core dump for the system to
  // take: the limit is zero for the child, whose it becomes, and put back
  var saved = new RLimit(0u64, 0u64);
  var limited = false;
  if rc == 0i32 and not opts.crashReport {
    if getLimit(limitCore, &mut saved as *RLimit) == 0i32 {
      var none = new RLimit(0u64, saved.hard);
      setLimit(limitCore, &mut none as *RLimit);
      limited = true;
    }
  }
  var pid = 0i32;
  if rc == 0i32 {
    rc = spawnProgram(&mut pid as *i32, file.cstr(), ap, tp, argv, cone_environ());
  }
  if limited { setLimit(limitCore, &mut saved as *RLimit); }

  actionsDestroy(ap);
  attrDestroy(tp);
  k = 0usize;
  while k < count {
    libc.free(*(argv + k));
    k = k + 1usize;
  }
  libc.free(argv as *u8);
  // The child's ends are the child's now: with ours closed, a pipe ends when
  // the child, and whatever it started, has closed it
  if not opts.inherit and so.fd >= 0i32 {
    closeFd(outFds[1usize]);
    closeFd(errFds[1usize]);
  }
  if rc != 0i32 {
    closeFdIf(so.fd);
    closeFdIf(se.fd);
    return Error[Output, ProcessError](failure(op, program, dir, u32.from(rc)));
  }

  // A child with a time limit is its group's leader, so a stop reaches what
  // it started
  let deadline = if timed {time.Instant.now() + opts.timeout} else {time.Instant.fromNanos(0i64)};

  // Both outputs at once, so that a child blocked writing one is never
  // waiting on a reader blocked on the other
  var timedOut = false;
  let buf = libc.malloc(65536usize);
  var polls = new Array[PollFd, 2] <- fill new PollFd(-1i32, pollIn, 0i16);
  let pp *PollFd = &[]polls as *PollFd;
  var reading = so.fd >= 0i32 or se.fd >= 0i32;
  while reading {
    polls[0usize].fd = so.fd;
    polls[0usize].revents = 0i16;
    polls[1usize].fd = se.fd;
    polls[1usize].revents = 0i16;
    let ready = pollFds(pp, 2u64, remainingMs(timed, deadline));
    if ready == 0i32 {
      timedOut = true;
      stopGroup(pid, timed);
      reading = false;
    }
    elif ready < 0i32 {
      // An interrupted call is tried again, any other failure ends the reading
      if *libc.errno() != errnoInterrupted { reading = false; }
    }
    else {
      if so.fd >= 0i32 and polls[0usize].revents != 0i16 { readReady(&mut so, buf); }
      if se.fd >= 0i32 and polls[1usize].revents != 0i16 { readReady(&mut se, buf); }
      reading = so.fd >= 0i32 or se.fd >= 0i32;
    }
  }
  libc.free(buf);
  closeFdIf(so.fd);
  closeFdIf(se.fd);

  // Wait for the child, until its time runs out
  var status = 0i32;
  var reaped = false;
  if timed and not timedOut {
    while not reaped and not timedOut {
      let w = waitPid(pid, &mut status as *i32, waitNoHang);
      if w == pid {
        reaped = true;
      }
      elif w < 0i32 and *libc.errno() != errnoInterrupted {
        reaped = true;
      }
      elif remainingMs(timed, deadline) == 0i32 {
        timedOut = true;
        stopGroup(pid, timed);
      }
      else {
        // A millisecond's wait, by a poll with nothing to poll
        pollFds(null, 0u64, 1i32);
      }
    }
  }
  while not reaped {
    let w = waitPid(pid, &mut status as *i32, 0i32);
    if w == pid or *libc.errno() != errnoInterrupted { reaped = true; }
  }
  var out = String.empty();
  var err = String.empty();
  out <=> so.data;
  err <=> se.data;
  let exitCode = if timedOut {stoppedCode} else {exitStatus(status)};
  Ok[Output, ProcessError](new Output(exitCode, signalOf(status), timedOut, out, err))
}

// ---------------------------------------------------------------------------
// This program
// ---------------------------------------------------------------------------

// This program's arguments on POSIX, its own name first: argv's bytes, which
// the kernel keeps as the NUL-ended strings of /proc/self/cmdline
fn argsPosix() List[String] {
  var out = List[String].empty();
  let f = libc.fopen("/proc/self/cmdline", "rb");
  if f == null { return out; }
  var whole = String.empty();
  var buf = new Array[u8, 4096] <- fill 0u8;
  let bp *u8 = &[]buf as *u8;
  var going = true;
  while going {
    let n = libc.fread(bp, 1usize, 4096usize, f);
    if n > 0usize { whole.appendBytes(mem.sliceFromParts(bp, n)); }
    going = n == 4096usize;
  }
  libc.fclose(f);
  var begin = 0usize;
  var i = 0usize;
  while i < whole.len() {
    if whole[i] == 0u8 {
      out.push(whole.sub(begin, i));
      begin = i + 1usize;
    }
    i = i + 1usize;
  }
  out
}

// The path of this program's executable on POSIX, where /proc/self/exe links
fn currentExePosix() Result[Path, ProcessError] {
  var size = 256usize;
  while size <= 0x10000usize {
    let buf = libc.malloc(size);
    let n = readLink("/proc/self/exe", buf, size);
    if n < 0isize {
      let code = u32.from(*libc.errno());
      libc.free(buf);
      return Error[Path, ProcessError](failure("currentExe", "", "", code));
    }
    if usize.from(n) < size {
      let got = String.fromBytes(mem.sliceFromParts(buf, usize.from(n)));
      libc.free(buf);
      let exe = Path.from(got.view());
      return Ok[Path, ProcessError](exe.normalize());
    }
    libc.free(buf);
    size = size * 2usize;
  }
  Error[Path, ProcessError](failure("currentExe", "", "", errnoInvalid))
}

// This program's arguments, its own name first, as Windows' parser
// (CommandLineToArgvW) splits its command line, each in UTF-8, whatever the
// system's code page: what 'main''s argv holds when every one is ASCII
pub fn args() List[String] {
  if isWindows() {argsWindows()} else {argsPosix()}
}

fn argsWindows() List[String] {
  var out = List[String].empty();
  var n = 0i32;
  let argv = CommandLineToArgvW(GetCommandLineW(), &mut n);
  if argv as usize == 0usize { return out; }
  var i = 0usize;
  let count = usize.from(n);
  while i < count {
    out.push(narrow(*(argv + i), -1i32));
    i = i + 1usize;
  }
  LocalFree(argv as *u8);
  out
}

// The path of this program's executable, normalized ('C:/work/build/app.exe')
pub fn currentExe() Result[Path, ProcessError] {
  if isWindows() {currentExeWindows()} else {currentExePosix()}
}

fn currentExeWindows() Result[Path, ProcessError] {
  var size = 260u32;
  while size <= 0x10000u32 {
    let buf = libc.malloc(usize.from(size) * 2usize) as *u16;
    let n = GetModuleFileNameW(0usize, buf, size);
    if n == 0u32 {
      let code = GetLastError();
      libc.free(buf as *u8);
      return Error[Path, ProcessError](failure("currentExe", "", "", code));
    }
    if n < size {
      let got = narrow(buf, i32.from(n));
      libc.free(buf as *u8);
      let exe = Path.from(got.view());
      return Ok[Path, ProcessError](exe.normalize());
    }
    libc.free(buf as *u8);
    size = size * 2u32;
  }
  Error[Path, ProcessError](failure("currentExe", "", "", errorInvalidParameter))
}
