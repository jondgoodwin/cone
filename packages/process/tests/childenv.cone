// A child's environment and its standard input bytes (Options.env, removeEnv, clearEnv and input). The child is this
// test's own executable, started again with '--child' and a mode.
//
// Environment: a variable set for the child is seen by it; one set for the child replaces the inherited one of its
// name (on Windows whatever the case of the name, on POSIX only the same name); one removed is gone; a name both
// removed and set is set; a cleared environment holds only what was set; names and values beyond ASCII; names and
// values the system cannot hold are refused; and this program's own environment is as it was after every call.
// With 'crashReport: false' too, where Windows' block gets one more variable.
//
// Input: 0 bytes, a few, and a megabyte with standard output captured, through a child that writes a megabyte before
// it reads a byte (a writer that wrote it all first would wait on a child that waits on it) and one that echoes as it
// reads; a child that never reads it, which ends the writing quietly; the input with a time limit and with an
// environment together.

mod childenv;

import testing use *;
import collections use *;
import libc;
import path use Path;
import env;
import process;
import time use Duration;
import iobuf;

extern {
  fn @c(system) GetEnvironmentStringsW() *u16;
}
extern {
  fn @c cone_environ() **u8;
}

fn os(windows: &str, posix: &str) &str { #if #os == .windows {windows} #else {posix} }
fn osCode(windows: u64, posix: u64) u64 { #if #os == .windows {windows} #else {posix} }

fn out(s: &Array[u8]) { libc.fwrite(s as *u8, 1usize, s.len, libc.stdout()); }
fn err(s: &Array[u8]) { libc.fwrite(s as *u8, 1usize, s.len, libc.stderr()); }

fn hexOf(s: &Array[u8]) String {
  let digits: &Array[u8] = "0123456789abcdef";
  var h = String();
  var i = 0usize;
  while i < s.len {
    h.appendByte(digits[usize.from(s[i] >> 4u8)]);
    h.appendByte(digits[usize.from(s[i] & 15u8)]);
    i = i + 1usize;
  }
  h
}

fn eol() &str { os("\r\n", "\n") }

// The byte 'i' of the test's input: lower-case letters and spaces, which no text mode alters
fn payloadByte(i: usize) u8 {
  if i % 61usize == 60usize { return ' '; }
  'a' + u8.from(i % 26usize)
}

fn payload(n: usize) String {
  var s = String();
  var i = 0usize;
  while i < n {
    s.appendByte(payloadByte(i));
    i = i + 1usize;
  }
  s
}

fn sumOf(s: &Array[u8]) u64 {
  var t = 0u64;
  var i = 0usize;
  while i < s.len {
    t = t + u64.from(s[i]);
    i = i + 1usize;
  }
  t
}

// "count sum" of a text's bytes
fn countSum(s: &Array[u8]) String {
  var r = String();
  r.appendUInt(u64.from(s.len));
  r.appendByte(' ');
  r.appendUInt(sumOf(s));
  r
}

// What the child has read of its input, as "count sum"; with 'echo' also writing each piece to its output as it
// reads it
fn readInput(echo: bool) String {
  var buf = Array[u8, 4096]() <- fill 0u8;
  let bp: *u8 = &[]buf as *u8;
  var total = 0u64;
  var sum = 0u64;
  var n = libc.fread(bp, 1usize, 4096usize, libc.stdin());
  while n > 0usize {
    total = total + u64.from(n);
    var i = 0usize;
    while i < n {
      sum = sum + u64.from(buf[i]);
      i = i + 1usize;
    }
    if echo { libc.fwrite(bp, 1usize, n, libc.stdout()); }
    n = libc.fread(bp, 1usize, 4096usize, libc.stdin());
  }
  var s = String();
  s.appendUInt(total);
  s.appendByte(' ');
  s.appendUInt(sum);
  s
}

fn sameBytes(a: &Array[u8], b: &Array[u8]) bool {
  if a.len != b.len { return false; }
  var i = 0usize;
  while i < a.len {
    if a[i] != b[i] { return false; }
    i = i + 1usize;
  }
  true
}

// The bytes of s as Options.input wants them: read-only and shared
fn bytesOf(s: &Array[u8]) iobuf.Bytes {
  var b = iobuf.IoBuf(if s.len > 0usize {s.len} else {1usize});
  _ = b.append(s);
  b.freeze()
}

// Whether an environment entry "NAME=value" is of this name (Windows: without regard to ASCII case)
fn entryNamed(e: &Array[u8], name: &Array[u8]) bool {
  var k = #if #os == .windows {1usize} #else {0usize};
  while k < e.len && e[k] != '=' { k = k + 1usize; }
  if k != name.len { return false; }
  var i = 0usize;
  while i < k {
    var x = e[i];
    var y = name[i];
    #if #os == .windows {
      if x >= 'a' && x <= 'z' { x = x - 32u8; }
      if y >= 'a' && y <= 'z' { y = y - 32u8; }
    }
    if x != y { return false; }
    i = i + 1usize;
  }
  true
}

fn child(a: &List[String]) i32 {
  let mode = &a[2usize];
  if mode.equals("envget") {
    match env.get(a[3usize].view()) {
      case let Some(v) { let h = hexOf(v.view()); out(h.view()); }
      case is None { out("<none>"); }
    }
    return 0i32;
  }
  if mode.equals("envnames") {
    // Every name in the environment this child was given, one to a line, ASCII only
    var names = String();
    #if #os == .windows {
      let block = GetEnvironmentStringsW();
      var i = 0usize;
      while *(block + i) != 0u16 {
        var j = i;
        while *(block + j) != 0u16 { j = j + 1usize; }
        var k = i + 1usize;
        while k < j && *(block + k) != 61u16 { k = k + 1usize; }
        var m = i;
        while m < k {
          let c = *(block + m);
          names.appendByte(if c < 128u16 {u8.from(c)} else {'?'});
          m = m + 1usize;
        }
        names.appendByte('\n');
        i = j + 1usize;
      }
    } #else {
      let vars = cone_environ();
      var i = 0usize;
      while *(vars + i) != null {
        let entry = *(vars + i);
        var j = 0usize;
        while entry[j] != 0u8 && entry[j] != '=' {
          names.appendByte(entry[j]);
          j = j + 1usize;
        }
        names.appendByte('\n');
        i = i + 1usize;
      }
    }
    out(names.view());
    return 0i32;
  }
  if mode.equals("envmatch") {
    // Every entry whose name is a[3]'s, as "NAME=value|" (names matched without regard to case on Windows, ASCII)
    var found = String();
    let want = a[3usize].view();
    #if #os == .windows {
      let block = GetEnvironmentStringsW();
      var i = 0usize;
      while *(block + i) != 0u16 {
        var j = i;
        while *(block + j) != 0u16 { j = j + 1usize; }
        var e = String();
        var m = i;
        while m < j {
          let c = *(block + m);
          e.appendByte(if c < 128u16 {u8.from(c)} else {'?'});
          m = m + 1usize;
        }
        if entryNamed(e.view(), want) { found.append(e.view()); found.append("|"); }
        i = j + 1usize;
      }
    } #else {
      let vars = cone_environ();
      var i = 0usize;
      while *(vars + i) != null {
        let entry = *(vars + i);
        var e = String();
        var j = 0usize;
        while entry[j] != 0u8 { e.appendByte(entry[j]); j = j + 1usize; }
        if entryNamed(e.view(), want) { found.append(e.view()); found.append("|"); }
        i = i + 1usize;
      }
    }
    out(found.view());
    return 0i32;
  }
  if mode.equals("incount") {
    let s = readInput(false);
    out(s.view());
    return 0i32;
  }
  if mode.equals("inecho") {
    let s = readInput(true);
    err(s.view());
    return 0i32;
  }
  if mode.equals("outfirst") {
    // A megabyte to its output before it reads a byte of its input
    var chunk = Array[u8, 4096]() <- fill 'o';
    let cp: *u8 = &[]chunk as *u8;
    var done = 0usize;
    while done < 1048576usize {
      libc.fwrite(cp, 1usize, 4096usize, libc.stdout());
      done = done + 4096usize;
    }
    libc.fflush(libc.stdout());
    let s = readInput(false);
    err(s.view());
    return 0i32;
  }
  if mode.equals("noread") {
    out("did not read\n");
    return 7i32;
  }
  err("no such mode\n");
  2i32
}

fn childCommand(exe: &str, mode: &str) List[String] {
  var c = List[String]();
  c.push(String.from(exe));
  c.push(String.from("--child"));
  c.push(String.from(mode));
  c
}

fn emptyOutput() process.Output {
  process.Output(0u32, 0u32, false, String(), String())
}

fn ran(r: Result[process.Output, process.ProcessError], label: &Array[u8]) process.Output {
  var o = emptyOutput();
  match r {
    case var Ok(ok) { o <-> ok; }
    case let Err(e) {
      let m = String() <- e;
      expectStr(m.view(), "<started>", label);
    }
  }
  o
}

fn var1(name: &str, value: &str) process.EnvVars {
  var v = process.EnvVars();
  v.push(process.EnvVar(String.from(name), String.from(value)));
  v
}

fn cp(l: &process.EnvVars) process.EnvVars {
  var c = process.EnvVars();
  let v = l.view();
  var i = 0usize;
  while i < v.len {
    c.push(process.EnvVar(String.from(v[i].name.view()), String.from(v[i].value.view())));
    i = i + 1usize;
  }
  c
}

fn cpn(l: &List[String]) List[String] {
  var c = List[String]();
  let v = l.view();
  var i = 0usize;
  while i < v.len {
    c.push(String.from(v[i].view()));
    i = i + 1usize;
  }
  c
}

fn names1(name: &str) List[String] {
  var v = List[String]();
  v.push(String.from(name));
  v
}

// What the child reads of a variable: its UTF-8 in hex, or <none>
fn seen(exe: &str, name: &str, opts: process.Options) String {
  var c = childCommand(exe, "envget");
  c.push(String.from(name));
  let o = ran(process.run(c.view(), opts), "envget");
  String.from(o.stdout.view())
}

// A run that must be refused, with the system's code for a bad parameter
fn refused(exe: &str, opts: process.Options, label: &Array[u8]) {
  let c = childCommand(exe, "envget");
  match process.run(c.view(), opts) {
    case let Err(e) { expectUInt(u64.from(e.code), osCode(87u64, 22u64), label); }
    case is Ok { expectStr("<started>", "<refused>", label); }
  }
}

fn here(name: &str, want: &str) bool {
  match env.get(name) { case let Some(v) { v.equals(want) } case is None { false } }
}

fn environment(exe: &str) {
  // A baseline every child inherits, set before
  env.set("CONE_ENVT_OLD", "old");
  env.set("CONE_ENVT_GONE", "here");

  // The child sees what was set for it, and this program does not
  let newVars = var1("CONE_ENVT_NEW", "new");
  expectStr(seen(exe, "CONE_ENVT_NEW", process.Options(env: Some(cp(&newVars)))).view(), "6e6577",
    "a variable set for the child is seen by it");
  expectBool(env.get("CONE_ENVT_NEW") is None, true, "and is not set here");
  expectStr(seen(exe, "CONE_ENVT_OLD", process.Options(env: Some(cp(&newVars)))).view(), "6f6c64",
    "the inherited ones are still there");
  expectStr(seen(exe, "CONE_ENVT_NEW", process.Options()).view(), "<none>",
    "and the next run, with no option, has none of it");

  // An override replaces the inherited one, here as it was
  let overVars = var1("CONE_ENVT_OLD", "over");
  expectStr(seen(exe, "CONE_ENVT_OLD", process.Options(env: Some(cp(&overVars)))).view(), "6f766572",
    "an override replaces the inherited value");
  expectBool(here("CONE_ENVT_OLD", "old"), true, "and this program's own is as it was");
  let lowerVars = var1("cone_envt_old", "lower");
  expectStr(seen(exe, "CONE_ENVT_OLD", process.Options(env: Some(cp(&lowerVars)))).view(), os("6c6f776572", "6f6c64"),
    "a name of another case replaces on Windows, is another variable on POSIX");

  // The inherited "Path" (Windows; POSIX's is "PATH") is replaced by "PATH", not joined by it: one entry, the new value
  var pathOnly = childCommand(exe, "envmatch");
  pathOnly.push(String.from("PATH"));
  let pathVars = var1("PATH", "newpath");
  let setPath = ran(process.run(pathOnly.view(), process.Options(env: Some(cp(&pathVars)))), "envmatch PATH");
  expectStr(setPath.stdout.view(), "PATH=newpath|",
    "PATH set for the child replaces the inherited Path: one entry, with the new value");
  let pathGone = names1("PATH");
  let noPath = ran(process.run(pathOnly.view(), process.Options(removeEnv: Some(cpn(&pathGone)))), "envmatch PATH removed");
  expectStr(noPath.stdout.view(), "", "PATH removed for the child removes the inherited Path too");
  #if #os == .windows {
    let lowerPath = var1("path", "lowerpath");
    let setLower = ran(process.run(pathOnly.view(), process.Options(env: Some(cp(&lowerPath)))), "envmatch path");
    expectStr(setLower.stdout.view(), "path=lowerpath|", "a lower-case name replaces it too, leaving one entry");
  }

  // Removed ones are gone, here they remain
  let goneNames = names1("CONE_ENVT_GONE");
  expectStr(seen(exe, "CONE_ENVT_GONE", process.Options(removeEnv: Some(cpn(&goneNames)))).view(), "<none>",
    "a removed variable is gone from the child");
  expectStr(seen(exe, "CONE_ENVT_OLD", process.Options(removeEnv: Some(cpn(&goneNames)))).view(), "6f6c64",
    "and the others stay");
  expectBool(here("CONE_ENVT_GONE", "here"), true, "and it is still here");
  let neverNames = names1("CONE_ENVT_NEVER_SET");
  expectStr(seen(exe, "CONE_ENVT_OLD", process.Options(removeEnv: Some(cpn(&neverNames)))).view(), "6f6c64",
    "removing a name that is not there is no error");
  let backVars = var1("CONE_ENVT_GONE", "back");
  expectStr(seen(exe, "CONE_ENVT_GONE", process.Options(env: Some(cp(&backVars)), removeEnv: Some(cpn(&goneNames)))).view(),
    "6261636b", "a name removed and set is set");
  var twice = var1("CONE_ENVT_T", "first");
  twice.push(process.EnvVar(String.from("CONE_ENVT_T"), String.from("second")));
  expectStr(seen(exe, "CONE_ENVT_T", process.Options(env: Some(cp(&twice)))).view(), "7365636f6e64",
    "a name set twice is the last one's");

  // A cleared environment holds only what was set
  var clearVars = var1("CONE_ENVT_ONLY", "x");
  clearVars.push(process.EnvVar(String.from("CONE_ENVT_TWO"), String.from("y")));
  var n = childCommand(exe, "envnames");
  let names = ran(process.run(n.view(), process.Options(env: Some(cp(&clearVars)), clearEnv: true)), "envnames");
  var two = String.from("CONE_ENVT_ONLY");
  two.append(eol());
  two.append("CONE_ENVT_TWO");
  two.append(eol());
  expectStr(names.stdout.view(), two.view(), "a cleared environment holds only what was set");
  expectStr(seen(exe, "CONE_ENVT_OLD", process.Options(clearEnv: true)).view(), "<none>",
    "an inherited one is not in it");
  let onlyVars = var1("CONE_ENVT_ONLY", "x");
  let un = ran(process.run(n.view(), process.Options(env: Some(cp(&onlyVars)), clearEnv: true, crashReport: false)),
    "envnames, crashes unreported");
  var heapLine = String.from("CONE_ENVT_ONLY");
  heapLine.append(eol());
  #if #os == .windows { heapLine.append("_NO_DEBUG_HEAP\r\n"); }
  expectStr(un.stdout.view(), heapLine.view(),
    "a cleared environment, crashes unreported: on Windows with its one added variable");
  let nVars = var1("CONE_ENVT_NEW", "n");
  expectStr(seen(exe, "CONE_ENVT_NEW", process.Options(env: Some(cp(&nVars)), crashReport: false)).view(), "6e",
    "a variable set for a child run unreported");

  // Beyond ASCII, in the name and the value
  let utfVars = var1("CONE_ENVT_é日", "é日本");
  expectStr(seen(exe, "CONE_ENVT_é日", process.Options(env: Some(cp(&utfVars)))).view(), "c3a9e697a5e69cac",
    "a name and a value beyond ASCII");
  expectBool(env.get("CONE_ENVT_é日") is None, true, "which this program does not have");

  // What no environment can hold
  let emptyName = var1("", "v");
  refused(exe, process.Options(env: Some(cp(&emptyName))), "an empty name is refused");
  let eqName = var1("A=B", "v");
  refused(exe, process.Options(env: Some(cp(&eqName))), "a name with '=' is refused");
  let nulName = var1("A\0B", "v");
  refused(exe, process.Options(env: Some(cp(&nulName))), "a name with a NUL is refused");
  let nulValue = var1("CONE_ENVT_V", "a\0b");
  refused(exe, process.Options(env: Some(cp(&nulValue))), "a value with a NUL is refused");
  let badNames = names1("A=B");
  refused(exe, process.Options(removeEnv: Some(cpn(&badNames))), "a removed name with '=' is refused");

  env.unset("CONE_ENVT_OLD");
  env.unset("CONE_ENVT_GONE");
}

fn input(exe: &str) {
  let c = childCommand(exe, "incount");
  let zero = ran(process.run(c.view(), process.Options(input: Some(bytesOf("")))), "0 bytes");
  expectStr(zero.stdout.view(), "0 0", "0 bytes of input: the child reads end of input at once");
  let fewText = "hello\nthere";
  let few = ran(process.run(c.view(), process.Options(input: Some(bytesOf(fewText)))), "a few bytes");
  let wantFew = countSum(fewText);
  expectStr(few.stdout.view(), wantFew.view(), "a few bytes of input arrive, and then end of input");
  let utf = "é日本\n";
  let u = ran(process.run(c.view(), process.Options(input: Some(bytesOf(utf)))), "UTF-8");
  let wantUtf = countSum(utf);
  expectStr(u.stdout.view(), wantUtf.view(), "bytes beyond ASCII arrive as they are");

  // Not text: 0x00 and every byte 0x80-0xFF (none of which is UTF-8, or a text mode's to alter), echoed back exactly
  var raw = List[u8]();
  raw.push(0u8);
  var rb = 128usize;
  while rb < 256usize { raw.push(u8.from(rb)); rb = rb + 1usize; }
  raw.push(0u8);
  raw.push(254u8);
  let rawIn = bytesOf(raw.view());
  let rawEcho = ran(process.run(c.view(), process.Options(input: Some(rawIn))), "non-UTF-8");
  let wantRaw = countSum(raw.view());
  expectStr(rawEcho.stdout.view(), wantRaw.view(), "non-UTF-8 input, a NUL among it: every byte arrives (count and sum)");
  let rawE = childCommand(exe, "inecho");
  let rawBack = ran(process.run(rawE.view(), process.Options(input: Some(bytesOf(raw.view())))), "non-UTF-8 echo");
  expectBool(sameBytes(rawBack.stdout.view(), raw.view()), true, "and is echoed back exactly, byte for byte");

  // A megabyte in, with the output captured: the child echoes as it reads
  let big = payload(1048576usize);
  let wantBig = countSum(big.view());
  let e = childCommand(exe, "inecho");
  let echoed = ran(process.run(e.view(), process.Options(input: Some(bytesOf(big.view())),timeout: Duration.fromSeconds(60))), "echo");
  expectStr(echoed.stderr.view(), wantBig.view(), "a megabyte of input is read whole");
  expectBool(echoed.stdout.equals(big.view()), true, "and echoed back, byte for byte, while it is written");
  expectBool(echoed.exitCode == 0u32 && !echoed.timedOut, true, "the echo ended in time");

  // A child that writes a megabyte before it reads a byte
  let f = childCommand(exe, "outfirst");
  let first = ran(process.run(f.view(), process.Options(input: Some(bytesOf(big.view())),timeout: Duration.fromSeconds(60))),
    "output first");
  expectUInt(u64.from(first.stdout.len()), 1048576u64, "a child that writes a megabyte first is not waiting on a writer");
  expectStr(first.stderr.view(), wantBig.view(), "and then reads all of its input");
  expectBool(first.timedOut, false, "in time");

  // A child that never reads: the writing ends, and nothing else is wrong
  let nr = childCommand(exe, "noread");
  let never = ran(process.run(nr.view(), process.Options(input: Some(bytesOf(big.view())),timeout: Duration.fromSeconds(60))),
    "no read");
  var said = String.from("did not read");
  said.append(eol());
  expectStr(never.stdout.view(), said.view(), "a child that reads none of a megabyte ends as it would");
  expectUInt(u64.from(never.exitCode), 7u64, "with its own code");

  // With a variable too, and a time limit that is never reached
  let bothVars = var1("CONE_ENVT_BOTH", "b");
  let b = ran(process.run(c.view(), process.Options(input: Some(bytesOf("abc")),env: Some(cp(&bothVars)),
    timeout: Duration.fromSeconds(30))), "input and env");
  let wantAbc = countSum("abc");
  expectStr(b.stdout.view(), wantAbc.view(), "input with an environment and a time limit");
}

fn main() i32 {
  let a = process.args();
  if a.len() >= 3usize && a[1usize].equals("--child") { return child(&a); }
  var exe = Path.from("");
  match process.currentExe() {
    case var Ok(e) { exe <-> e; }
    case is Err { require(false, "currentExe"); }
  }
  environment(exe.view());
  input(exe.view());
  done()
}
