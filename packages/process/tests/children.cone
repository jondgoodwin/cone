// Programs run and waited for. The child is this test's own executable,
// started again with '--child' and what to do, so the test needs nothing of
// the machine's but the system itself: no cmd.exe, no other program (on POSIX
// the shell, for 'runLine', and PATH).
//
// What it covers: standard output and standard error captured apart, byte
// for byte; a megabyte written to each at once, in turns (the deadlock a
// reader of one pipe at a time would meet); exit codes 0, 1, 255, and on
// Windows a crash's 3221225477 and 4294967295, on POSIX 139 and 2; a Cone
// panic's (3221226505 on Windows, 134, abort's signal and 128, on POSIX); with
// 'crashReport: false', a
// panic's code, output and line the same, with a time limit and without, a
// breakpoint's crash ending with its own code (a debugger's STATUS_BREAKPOINT
// on Windows, SIGTRAP's 133 on POSIX), captured output and a time
// limit as without the option; a child that sleeps, stopped by
// its time limit, and one whose own child sleeps, both stopped (the
// grandchild's death checked by its process id); the working folder, a
// UTF-8 one among them, given as a literal and as a Path variable (which the
// run leaves as it was: it is used again); standard input read from NUL
// (/dev/null); a variable set before the run inherited, beyond ASCII, as the
// system holds it (UTF-16 on Windows, the bytes on POSIX) and as the env
// package reads it; arguments round-tripped through the child's parsers
// (every string of up to four of 'a', space, tab, '"' and '\', and UTF-8
// ones), Windows' CommandLineToArgvW and the C runtime's both, on POSIX
// argv's own; a raw command line (the shell's on POSIX); a child that shares
// this test's output, whose line this test's .out pins; and each failure to
// start: no such program, no such folder, no arguments, a NUL, bytes that are
// not UTF-8 (refused on Windows, passed on POSIX), a '"' in the program's
// name (refused on Windows, a program that is not there on POSIX). Each check
// is made on both systems, with the answer that system gives, so the count
// is the same.
//
// It works in a folder of its own under TEMP (TMPDIR or /tmp on POSIX),
// 'cone-process-test', which it clears if an interrupted run left it, makes,
// and removes at the end, after checking the folder's path is TEMP's with
// that name after it.

mod children;

import testing use *;
import collections use *;
import stdio;
import libc;
import path use Path;
import fs;
import env;
import process;
import time use Duration, Instant;

// Windows'
extern {
  fn @c(system) ExitProcess(code u32);
  fn @c(system) Sleep(ms u32);
  fn @c(system) GetCurrentProcessId() u32;
  fn @c(system) OpenProcess(access u32, inherit i32, pid u32) usize;
  fn @c(system) WaitForSingleObject(h usize, ms u32) u32;
  fn @c(system) CloseHandle(h usize) i32;
  fn @c(system) GetEnvironmentVariableW(name *u16, buf *u16, size u32) u32;
  fn @c(system) DebugBreak();
}

// POSIX's
extern {
  fn @c getpid() i32;
  fn @c usleep(us u32) i32;
  fn @c _exit(code i32);
  fn @c kill(pid i32, signal i32) i32;
  fn @c raise(signal i32) i32;
}

const synchronize = 0x100000u32;     // SYNCHRONIZE

// The answer for this system: Windows' or POSIX's
fn os(windows &str, posix &str) &str { if isWindows() {windows;} else {posix;}; }
fn osCode(windows u64, posix u64) u64 { if isWindows() {windows;} else {posix;}; }

// A line end as the C runtime's text mode writes it: '\r\n' on Windows
fn eol() &str { os("\r\n", "\n"); }

// The folder under which the test works: TEMP's on Windows, TMPDIR's or /tmp
fn tempText() String {
  var variable cstr = "TMPDIR";
  if isWindows() { variable = "TEMP"; }
  let temp = libc.getenv(variable);
  require(temp != null or not isWindows(), "TEMP is set");
  if temp != null {String.from(cstr.fromPtr(temp).view());} else {String.from("/tmp");};
}

// A system's own spelling of a program to sleep, in milliseconds
fn pause(ms u32) {
  if isWindows() {Sleep(ms);} else {usleep(ms * 1000u32);}
}

// This process's id
fn processId() u32 {
  if isWindows() {GetCurrentProcessId();} else {u32.from(getpid());};
}

// -------- the child --------

fn out(s &Array[u8]) { libc.fwrite(s as *u8, 1usize, s.len, libc.stdout()); }
fn err(s &Array[u8]) { libc.fwrite(s as *u8, 1usize, s.len, libc.stderr()); }

fn number(s &String) u64 {
  match parseUInt(s.view()) {
    case let n Some { n; }
    case is None { 0u64; }
  }
}

fn isAscii(s &Array[u8]) bool {
  var i = 0usize;
  while i < s.len {
    if s[i] >= 0x80u8 { return false; }
    i = i + 1usize;
  }
  true;
}

// The child's arguments, each in hex followed by a ','. Where every one is ASCII,
// the C runtime's own argv must agree with Windows' parser, or it exits 9.
fn childArgs(a &List[String], argc i32, argv **u8) i32 {
  var ascii = true;
  var i = 0usize;
  while i < a.len() {
    if not isAscii(a[i].view()) { ascii = false; }
    i = i + 1usize;
  }
  if ascii {
    if usize.from(argc) != a.len() {
      err("the C runtime counts the arguments otherwise\n");
      return 9i32;
    }
    i = 0usize;
    while i < a.len() {
      let p = *(argv + i);
      if cstr.fromPtr(p).view() != a[i].view() {
        err("the C runtime reads an argument otherwise\n");
        return 9i32;
      }
      i = i + 1usize;
    }
  }
  i = 3usize;
  while i < a.len() {
    let h = hexOf(a[i].view());
    out(h.view());
    out(",");
    i = i + 1usize;
  }
  0i32;
}

// Bytes as hex, two digits each, so that nothing the C runtime's text mode
// does to a line end can change them on the way back
fn hexOf(s &Array[u8]) String {
  var h = String.empty();
  var i = 0usize;
  while i < s.len {
    h.appendHex(u64.from(s[i]), 2usize);
    i = i + 1usize;
  }
  h;
}

// n bytes to each stream, 4096 at a time, in turns: stdout cycles 'a' to 'z'
// by chunk, stderr 'A' to 'Z'
fn childStreams(n usize) i32 {
  var chunk = new Array[u8, 4096] <- fill 0u8;
  let cp *u8 = &[]chunk as *u8;
  var done = 0usize;
  var k = 0usize;
  while done < n {
    let size = if n - done < 4096usize {n - done;} else {4096usize;};
    var j = 0usize;
    while j < 4096usize { chunk[j] = 'a' + u8.from(k % 26usize); j = j + 1usize; }
    libc.fwrite(cp, 1usize, size, libc.stdout());
    j = 0usize;
    while j < 4096usize { chunk[j] = 'A' + u8.from(k % 26usize); j = j + 1usize; }
    libc.fwrite(cp, 1usize, size, libc.stderr());
    done = done + size;
    k = k + 1usize;
  }
  0i32;
}

fn child(a &List[String], argc i32, argv **u8) i32 {
  let mode = a[2usize];
  if mode.equals("args") { return childArgs(a, argc, argv); }
  if mode.equals("hello") {
    out("to stdout\n");
    err("to stderr\n");
    return 0i32;
  }
  if mode.equals("exit") {
    libc.fflush(libc.stdout());
    if isWindows() {ExitProcess(u32.from(number(a[3usize])));} else {_exit(i32.from(number(a[3usize])));};
  }
  if mode.equals("streams") { return childStreams(usize.from(number(a[3usize]))); }
  if mode.equals("panic") {
    out("before the panic\n");
    panic("on purpose");
  }
  if mode.equals("break") {
    // A breakpoint no debugger handles: a crash, STATUS_BREAKPOINT on
    // Windows, SIGTRAP on POSIX
    out("before the breakpoint\n");
    libc.fflush(libc.stdout());
    if isWindows() {DebugBreak();} else {raise(5i32);};
    return 0i32;
  }
  if mode.equals("sleep") {
    pause(u32.from(number(a[3usize])));
    out("woke\n");
    return 0i32;
  }
  if mode.equals("grandchild") {
    // Says who it is, then sleeps
    var id = String.empty();
    id.appendUInt(u64.from(processId()));
    let idPath = Path.from(a[3usize].view());
    fs.writeFile(&idPath, id.view());
    pause(u32.from(number(a[4usize])));
    return 0i32;
  }
  if mode.equals("tree") {
    // Starts a grandchild sharing its output, and waits for it
    var g = List[String].empty();
    g.push(a[0usize].copy());
    g.push(String.from("--child"));
    g.push(String.from("grandchild"));
    g.push(a[3usize].copy());
    g.push(a[4usize].copy());
    let r = process.run(g.view(), new process.Options(inherit: true));
    out("the grandchild ended\n");
    return 0i32;
  }
  if mode.equals("cwd") {
    match fs.currentDir() {
      case let d Ok { out(d.view()); }
      case is Error { out("<error>"); }
    }
    return 0i32;
  }
  if mode.equals("stdin") {
    var buf = new Array[u8, 256] <- fill 0u8;
    let bp *u8 = &[]buf as *u8;
    var total = 0u64;
    var n = libc.fread(bp, 1usize, 256usize, libc.stdin());
    while n > 0usize {
      total = total + u64.from(n);
      n = libc.fread(bp, 1usize, 256usize, libc.stdin());
    }
    var s = String.empty();
    s.appendUInt(total);
    out(s.view());
    return 0i32;
  }
  if mode.equals("env") {
    // Read as the system holds it, each unit in decimal: what the child
    // inherited, before any C runtime converts it. Windows keeps UTF-16;
    // POSIX keeps the bytes
    let name = a[3usize].view();
    if isWindows() {
      var wname = new Array[u16, 64] <- fill 0u16;
      var i = 0usize;
      while i < name.len and i < 63usize {
        wname[i] = u16.from(name[i]);
        i = i + 1usize;
      }
      var buf = new Array[u16, 256] <- fill 0u16;
      let n = GetEnvironmentVariableW(&[]wname as *u16, &[]buf as *u16, 256u32);
      if n == 0u32 {
        out("<none>");
        return 0i32;
      }
      var s = String.empty();
      i = 0usize;
      while i < usize.from(n) {
        if i > 0usize { s.appendByte(' '); }
        s.appendUInt(u64.from(buf[i]));
        i = i + 1usize;
      }
      out(s.view());
      return 0i32;
    }
    var cname = String.from(name);
    let held = libc.getenv(cname.cstr());
    if held == null {
      out("<none>");
      return 0i32;
    }
    var s = String.empty();
    var j = 0usize;
    while held[j] != 0u8 {
      if j > 0usize { s.appendByte(' '); }
      s.appendUInt(u64.from(held[j]));
      j = j + 1usize;
    }
    out(s.view());
    return 0i32;
  }
  if mode.equals("envget") {
    // The same variable as the env package reads it, its UTF-8 in hex
    match env.get(a[3usize].view()) {
      case let v Some { let h = hexOf(v.view()); out(h.view()); }
      case is None { out("<none>"); }
    }
    return 0i32;
  }
  err("no such mode\n");
  2i32;
}

// -------- the parent: helpers --------

// The test's folder: TEMP's absolute path and the name, after checking
// that it is that and nothing shorter
fn makeRoot(name &str) Path {
  let tempText = tempText();
  let tempPath = Path.from(tempText.view());
  var root = Path.from("");
  match fs.absolute(&tempPath) {
    case let t Ok { root = t.join(name); }
    case is Error { require(false, "TEMP has an absolute path"); }
  }
  let up = root.parent();
  let safe = root.isAbsolute() and root.view().endsWith(name) and up.view().len() > 3usize;
  require(safe, "the test's folder is under TEMP");
  root;
}

// This executable, '--child' and a mode
fn childCommand(exe &str, mode &str) List[String] {
  var c = List[String].empty();
  c.push(String.from(exe));
  c.push(String.from("--child"));
  c.push(String.from(mode));
  c;
}

fn emptyOutput() process.Output {
  new process.Output(0u32, 0u32, false, String.empty(), String.empty());
}

// The Output of a run that must have started
fn ran(r Result[process.Output, process.ProcessError], label &Array[u8]) process.Output {
  var o = emptyOutput();
  match r {
    case var ok Ok { o <=> ok; }
    case let e Error {
      let m = e.message();
      expectStr(m.view(), "<started>", label);
    }
  }
  o;
}

// The message of a run that must have failed, with the strings named
// replaced, and its code
fn failedWith(r Result[process.Output, process.ProcessError], exe &str, root &str, code u32, want &Array[u8], label &Array[u8]) {
  match r {
    case let e Error {
      var m = e.message();
      if root.len > 0usize { m.replace(root, "<root>" as &str); }
      if exe.len > 0usize { m.replace(exe, "<exe>" as &str); }
      expectStr(m.view(), want, label);
      expectUInt(u64.from(e.code), u64.from(code), label);
    }
    case is Ok { expectStr("<started>", want, label); }
  }
}

// -------- the parent: the checks --------

fn captured(exe &str) {
  let c = childCommand(exe, "hello");
  let o = ran(process.run(c.view()), "hello");
  // The C runtime's standard output is in text mode on Windows: '\n' goes out
  // as '\r\n'
  expectStr(o.stdout.view(), os("to stdout\r\n", "to stdout\n"), "stdout captured");
  expectStr(o.stderr.view(), os("to stderr\r\n", "to stderr\n"), "stderr captured apart");
  expectUInt(u64.from(o.exitCode), 0u64, "hello exits 0");
  expectBool(o.success(), true, "hello succeeds");
  expectBool(o.timedOut, false, "hello in time");
}

fn exitsWith(exe &str, code u64) {
  var c = childCommand(exe, "exit");
  var n = String.empty();
  n.appendUInt(code);
  c.push(n.copy());
  var label = String.from("exit code ");
  label.append(n.view());
  let o = ran(process.run(c.view()), label.view());
  expectUInt(u64.from(o.exitCode), code, label.view());
  // It exited: no signal ended it, whatever the code (139 is a status here,
  // not the segmentation fault's signal)
  expectUInt(u64.from(o.signal), 0u64, label.view());
  expectBool(o.success(), code == 0u64, label.view());
  expectStr(o.stdout.view(), "", label.view());
}

fn exitCodes(exe &str) {
  exitsWith(exe, 0u64);
  exitsWith(exe, 1u64);
  exitsWith(exe, 255u64);
  // An access violation's code, STATUS_ACCESS_VIOLATION (POSIX: a status of
  // 139, which is also the code for the segmentation fault's signal)
  exitsWith(exe, osCode(3221225477u64, 139u64));
  exitsWith(exe, osCode(4294967295u64, 2u64));
}

fn panics(exe &str) {
  let c = childCommand(exe, "panic");
  let o = ran(process.run(c.view()), "panic");
  // abort, which a Cone panic ends in: the fast-fail code, 0xC0000409; on
  // POSIX SIGABRT, 128 and 6
  expectUInt(u64.from(o.exitCode), osCode(3221226505u64, 134u64), "a panic's exit code");
  // On POSIX abort is the signal 6, and the exit code 134 says it as a shell
  // does; on Windows there are no signals
  expectUInt(u64.from(o.signal), osCode(0u64, 6u64), "a panic's signal");
  expectStr(o.stdout.view(), os("before the panic\r\n", "before the panic\n"), "what it wrote before the panic");
  expectBool(o.stderr.startsWith("panic at "), true, "the panic's line on stderr");
  expectBool(o.stderr.contains("on purpose"), true, "the panic's message on stderr");
  expectBool(o.success(), false, "a panic is no success");
}

// With 'crashReport: false': a crash ends the child here, with the exit
// code Windows would have given it, and everything else is as without it
fn crashesUnreported(exe &str) {
  let c = childCommand(exe, "panic");
  let o = ran(process.run(c.view(), new process.Options(crashReport: false)), "unreported panic");
  expectUInt(u64.from(o.exitCode), osCode(3221226505u64, 134u64), "an unreported panic's exit code");
  expectStr(o.stdout.view(), os("before the panic\r\n", "before the panic\n"), "what it wrote before an unreported panic");
  expectBool(o.stderr.startsWith("panic at "), true, "an unreported panic's line on stderr");
  expectBool(o.stderr.contains("on purpose"), true, "an unreported panic's message on stderr");

  // In a job, as a time limit puts it
  let t = ran(process.run(c.view(), new process.Options(timeout: Duration.fromSeconds(30), crashReport: false)),
    "unreported panic in time");
  expectUInt(u64.from(t.exitCode), osCode(3221226505u64, 134u64), "an unreported panic's exit code, with a time limit");
  expectBool(t.timedOut, false, "an unreported panic in time");
  expectStr(t.stdout.view(), os("before the panic\r\n", "before the panic\n"), "what it wrote before, with a time limit");

  // A breakpoint is a crash after the loader's own, which a debugger is given
  // (POSIX: SIGTRAP, 128 and 5)
  let b = childCommand(exe, "break");
  let k = ran(process.run(b.view(), new process.Options(crashReport: false)), "unreported breakpoint");
  expectUInt(u64.from(k.exitCode), osCode(2147483651u64, 133u64), "an unreported breakpoint's exit code, STATUS_BREAKPOINT or SIGTRAP");
  expectStr(k.stdout.view(), os("before the breakpoint\r\n", "before the breakpoint\n"), "what it wrote before the breakpoint");

  // The heap it would have had with no debugger: _NO_DEBUG_HEAP=1, '1' in
  // UTF-16 (the rest of its environment is this test's: 'environment').
  // POSIX has no such variable added: the child's environment is this
  // program's, here a variable set for the purpose
  if not isWindows() { env.set("CONE_PROCESS_TEST_PLAIN", "1"); }
  var v = childCommand(exe, "env");
  v.push(String.from(os("_NO_DEBUG_HEAP", "CONE_PROCESS_TEST_PLAIN")));
  let heap = ran(process.run(v.view(), new process.Options(crashReport: false)), "unreported env");
  expectStr(heap.stdout.view(), "49", "_NO_DEBUG_HEAP=1, crashes unreported");
  if not isWindows() { env.unset("CONE_PROCESS_TEST_PLAIN"); }

  let h = childCommand(exe, "hello");
  let o2 = ran(process.run(h.view(), new process.Options(crashReport: false)), "unreported hello");
  expectStr(o2.stdout.view(), os("to stdout\r\n", "to stdout\n"), "stdout captured, crashes unreported");
  expectStr(o2.stderr.view(), os("to stderr\r\n", "to stderr\n"), "stderr captured, crashes unreported");
  expectBool(o2.success(), true, "hello succeeds, crashes unreported");

  let size = 1048576usize;
  var s = childCommand(exe, "streams");
  s.push(String.from("1048576"));
  let big = ran(process.run(s.view(), new process.Options(timeout: Duration.fromSeconds(30), crashReport: false)),
    "unreported streams");
  expectBool(big.timedOut, false, "a megabyte each, crashes unreported: in time");
  expectUInt(u64.from(big.stdout.len()), u64.from(size), "a megabyte to stdout, crashes unreported");
  expectUInt(u64.from(big.stderr.len()), u64.from(size), "a megabyte to stderr, crashes unreported");

  var z = childCommand(exe, "sleep");
  z.push(String.from("10000"));
  let began = Instant.now();
  let slept = ran(process.run(z.view(), new process.Options(timeout: Duration.fromMillis(300), crashReport: false)),
    "unreported sleep");
  let took = began.elapsed();
  expectBool(slept.timedOut, true, "a sleeping child stopped by its time limit, crashes unreported");
  expectUInt(u64.from(slept.exitCode), 1u64, "a stopped child's exit code, crashes unreported");
  expectBool(took >= Duration.fromMillis(300) and took < Duration.fromSeconds(5), true,
    "stopped after 300 ms, not 10 s, crashes unreported");
}

fn bigStreams(exe &str) {
  let size = 1048576usize;
  var c = childCommand(exe, "streams");
  c.push(String.from("1048576"));
  let o = ran(process.run(c.view(), new process.Options(timeout: Duration.fromSeconds(30))), "streams");
  expectBool(o.timedOut, false, "a megabyte each: in time");
  expectUInt(u64.from(o.stdout.len()), u64.from(size), "a megabyte to stdout");
  expectUInt(u64.from(o.stderr.len()), u64.from(size), "a megabyte to stderr");
  var right = o.stdout.len() == size and o.stderr.len() == size;
  var i = 0usize;
  while right and i < size {
    let k = (i / 4096usize) % 26usize;
    if o.stdout[i] != 'a' + u8.from(k) or o.stderr[i] != 'A' + u8.from(k) { right = false; }
    i = i + 1usize;
  }
  expectBool(right, true, "each megabyte byte for byte, in order");
}

fn timesOut(exe &str) {
  var c = childCommand(exe, "sleep");
  c.push(String.from("10000"));
  let began = Instant.now();
  let o = ran(process.run(c.view(), new process.Options(timeout: Duration.fromMillis(300))), "sleep");
  let took = began.elapsed();
  expectBool(o.timedOut, true, "a sleeping child stopped by its time limit");
  expectUInt(u64.from(o.exitCode), 1u64, "a stopped child's exit code");
  // On POSIX it was killed by SIGKILL, 9 (the exit code says 1 on both)
  expectUInt(u64.from(o.signal), osCode(0u64, 9u64), "a stopped child's signal");
  expectStr(o.stdout.view(), "", "a stopped child never woke");
  expectBool(took >= Duration.fromMillis(300) and took < Duration.fromSeconds(5), true, "stopped after 300 ms, not 10 s");
  expectBool(o.success(), false, "a stopped child is no success");

  // Given long enough, the same child finishes
  var d = childCommand(exe, "sleep");
  d.push(String.from("50"));
  let p = ran(process.run(d.view(), new process.Options(timeout: Duration.fromSeconds(20))), "short sleep");
  expectBool(p.timedOut, false, "a short sleep in time");
  expectStr(p.stdout.view(), os("woke\r\n", "woke\n"), "a short sleep woke");
}

// A child that starts a grandchild and waits for it: the time limit stops
// both, and the grandchild's process is gone after
fn treeStopped(exe &str, root &Path) {
  let idFile = root.join("grandchild.txt");
  var c = childCommand(exe, "tree");
  c.push(String.from(idFile.view()));
  c.push(String.from("20000"));
  let began = Instant.now();
  let o = ran(process.run(c.view(), new process.Options(timeout: Duration.fromMillis(1500))), "tree");
  let took = began.elapsed();
  expectBool(o.timedOut, true, "a child waiting on a grandchild stopped");
  expectBool(took < Duration.fromSeconds(8), true, "stopped well before the grandchild would wake");
  expectStr(o.stdout.view(), "", "the child never saw its grandchild end");
  var id = 0u64;
  match fs.readFile(&idFile) {
    case let t Ok { id = number(&t); }
    case is Error {}
  }
  require(id != 0u64, "the grandchild said who it was");
  var gone = false;
  if isWindows() {
    let h = OpenProcess(synchronize, 0i32, u32.from(id));
    gone = h == 0usize;
    if not gone {
      gone = WaitForSingleObject(h, 3000u32) == 0u32;
      CloseHandle(h);
    }
  } else {
    // Signal 0 only asks whether the process is there: gone within three
    // seconds (init reaps it when its parent, killed too, has left it)
    var waited = 0u32;
    gone = kill(i32.from(id), 0i32) != 0i32;
    while not gone and waited < 3000u32 {
      pause(50u32);
      waited = waited + 50u32;
      gone = kill(i32.from(id), 0i32) != 0i32;
    }
  }
  expectBool(gone, true, "the grandchild stopped with it");
}

fn workingFolder(exe &str, root &Path) {
  let c = childCommand(exe, "cwd");
  // A Path variable, lent: the same one is given again below
  let o = ran(process.run(c.view(), new process.Options(), root), "cwd");
  expectStr(o.stdout.view(), root.view(), "started in the folder given");

  // A string literal where the folder is wanted is made a Path: 'C:\Windows'
  // exists on every Windows ('/usr' on every Linux), and the child reads its
  // folder back normalized
  let systemFolder = Path.from(os("C:\\Windows", "/usr"));
  let w = ran(process.run(c.view(), new process.Options(), &systemFolder), "cwd from a literal");
  expectStr(w.stdout.view(), os("C:/Windows", "/usr"), "started in a folder given as a literal");
  // And '.' is this program's own folder
  let dot = ran(process.run(c.view(), new process.Options(), "."), "cwd from '.'");
  match fs.currentDir() {
    case let d Ok { expectStr(dot.stdout.view(), d.view(), "a literal '.' is this program's folder"); }
    case is Error { expect(false, "this program's folder"); }
  }

  // The same folder written with '\' (on POSIX, where '\' is a name's byte,
  // with a '/' after it)
  var back = String.from(root.view());
  if isWindows() { back.replaceByte('/', '\\'); } else { back.appendByte('/'); }
  let backPath = Path.from(back.view());
  let b = ran(process.run(c.view(), new process.Options(), &backPath), "cwd with backslashes");
  expectStr(b.stdout.view(), root.view(), "a folder written with '\\'");

  // A UTF-8 name
  let utf = root.join("dossier é 日本");
  fs.makeDir(&utf);
  let u = ran(process.run(c.view(), new process.Options(), &utf), "cwd UTF-8");
  expectStr(u.stdout.view(), utf.view(), "a folder named in UTF-8");

  // A relative program is found from this program's folder, not the
  // child's ('congo test' runs a test in the folder its executable is in),
  // and on Windows a name with no extension gains '.exe' (on POSIX a name
  // with no '/' is looked for in PATH, which is made to hold this program's
  // folder for the purpose)
  var rel = childCommand(os(".\\children.exe", "./children"), "cwd");
  let r = ran(process.run(rel.view(), new process.Options(), root), "relative program");
  expectStr(r.stdout.view(), root.view(), "a relative program, read from this program's folder");
  var oldPath = String.empty();
  if not isWindows() {
    let exeFolder = Path.from(exe).parent();
    match env.get("PATH") {
      case let held Some { oldPath = held.copy(); }
      case is None {}
    }
    var searched = String.from(exeFolder.view());
    searched.appendByte(':');
    searched.append(oldPath.view());
    env.set("PATH", searched.view());
  }
  var bare = childCommand("children", "cwd");
  let n = ran(process.run(bare.view(), new process.Options(), root), "program with no extension");
  expectStr(n.stdout.view(), root.view(), "a program named with no '.exe'");
  if not isWindows() { env.set("PATH", oldPath.view()); }

  // 'runLine' takes the folder the same way
  var line = String.from("\"");
  line.append(exe);
  line.append("\" --child cwd");
  let rl = ran(process.runLine(line.view(), new process.Options(), root), "runLine in a folder");
  expectStr(rl.stdout.view(), root.view(), "runLine started in the Path given");
  let rlw = ran(process.runLine(line.view(), new process.Options(), &systemFolder), "runLine in a literal folder");
  expectStr(rlw.stdout.view(), os("C:/Windows", "/usr"), "runLine started in a literal folder");

  // None of the Paths was consumed by the runs that took it
  expect(utf.view().endsWith("/dossier é 日本"), "the Path variable is unchanged");
  expectStr(backPath.view(), back.view(), "the other Path variable is unchanged");
  expect(root.isAbsolute(), "root is unchanged after four runs");

  // None given: this program's own
  let here = ran(process.run(c.view()), "cwd inherited");
  match fs.currentDir() {
    case let d Ok { expectStr(here.stdout.view(), d.view(), "this program's folder by default"); }
    case is Error { expect(false, "this program's folder"); }
  }
  // An empty Path, given, is the same as none given
  let nowhere = Path.from("");
  let empty = ran(process.run(c.view(), new process.Options(), &nowhere), "cwd from an empty Path");
  expectStr(empty.stdout.view(), here.stdout.view(), "an empty Path is this program's folder");
}

fn standardInput(exe &str) {
  let c = childCommand(exe, "stdin");
  let o = ran(process.run(c.view()), "stdin");
  expectStr(o.stdout.view(), "0", "standard input is NUL: nothing to read");
}

fn environment(exe &str) {
  env.set("CONE_PROCESS_TEST", "inherited, é 日本");
  var c = childCommand(exe, "env");
  c.push(String.from("CONE_PROCESS_TEST"));
  let o = ran(process.run(c.view()), "env");
  // 'inherited, é 日本' in UTF-16 (on Windows), in its UTF-8 bytes (on POSIX)
  let held = os("105 110 104 101 114 105 116 101 100 44 32 233 32 26085 26412",
    "105 110 104 101 114 105 116 101 100 44 32 195 169 32 230 151 165 230 156 172");
  expectStr(o.stdout.view(), held, "a variable set before the run, UTF-8 into UTF-16");
  let d = ran(process.run(c.view(), new process.Options(crashReport: false)), "env, crashes unreported");
  expectStr(d.stdout.view(), held, "a variable set before the run, crashes unreported");
  var g = childCommand(exe, "envget");
  g.push(String.from("CONE_PROCESS_TEST"));
  let r = ran(process.run(g.view()), "envget");
  expectStr(r.stdout.view(), "696e686572697465642c20c3a920e697a5e69cac",
    "an inherited variable read by env.get, UTF-8 again");
  env.unset("CONE_PROCESS_TEST");
  let p = ran(process.run(c.view()), "env unset");
  expectStr(p.stdout.view(), "<none>", "a variable removed before the run");
}

// Every string of up to four of these
fn allStrings(list &mut List[String]) {
  let alphabet &Array[u8] = "a \t\"\\";
  list.push(String.empty());
  var from = 0usize;
  var len = 1usize;
  while len <= 4usize {
    let end = list.len();
    var i = from;
    while i < end {
      var j = 0usize;
      while j < alphabet.len {
        var s = list[i].copy();
        s.appendByte(alphabet[j]);
        list.push(s);
        j = j + 1usize;
      }
      i = i + 1usize;
    }
    from = end;
    len = len + 1usize;
  }
}

// What the child printed, split after each ','
fn splitComma(s &String) List[String] {
  var parts = List[String].empty();
  var start = 0usize;
  var i = 0usize;
  while i < s.len() {
    if s[i] == ',' {
      parts.push(s.sub(start, i));
      start = i + 1usize;
    }
    i = i + 1usize;
  }
  parts;
}

fn roundTrip(exe &str, items &List[String], label &Array[u8]) {
  var c = childCommand(exe, "args");
  var i = 0usize;
  while i < items.len() {
    c.push(items[i].copy());
    i = i + 1usize;
  }
  let o = ran(process.run(c.view()), label);
  expectUInt(u64.from(o.exitCode), 0u64, label);
  expectStr(o.stderr.view(), "", label);
  let back = splitComma(&o.stdout);
  expectUInt(u64.from(back.len()), u64.from(items.len()), label);
  var wrong = 0usize;
  i = 0usize;
  while i < items.len() and i < back.len() {
    let sent = hexOf(items[i].view());
    if back[i].view() != sent.view() {
      if wrong < 5usize {
        stdio.printStr("  sent [");
        stdio.printStr(sent.view());
        stdio.printStr("], received [");
        stdio.printStr(back[i].view());
        stdio.printStr("]\n");
      }
      wrong = wrong + 1usize;
    }
    i = i + 1usize;
  }
  expectUInt(u64.from(wrong), 0u64, label);
}

fn arguments(exe &str) {
  var every = List[String].empty();
  allStrings(&mut every);
  expectUInt(u64.from(every.len()), 781u64, "every string of up to four");
  roundTrip(exe, &every, "every string of up to four of a, space, tab, quote, backslash");

  var some = List[String].empty();
  some.push(String.from("é"));
  some.push(String.from("日本 語"));
  some.push(String.from("C:\\dir with space\\"));
  some.push(String.from("\\\\server\\share\\"));
  some.push(String.from("a\\\\\\\"b"));
  some.push(String.from("\"\""));
  some.push(String.empty());
  some.push(String.from("line\nbreak"));
  some.push(String.from("--flag=a b"));
  roundTrip(exe, &some, "UTF-8, paths, quotes, the empty string, a line break");
}

fn rawLine(exe &str) {
  // The program quoted, then arguments as the line writes them
  var line = String.from("\"");
  line.append(exe);
  line.append("\" --child args \"x y\" z \"\"");
  let o = ran(process.runLine(line.view()), "runLine");
  expectUInt(u64.from(o.exitCode), 0u64, "runLine exit code");
  let back = splitComma(&o.stdout);
  expectUInt(u64.from(back.len()), 3u64, "runLine's arguments");
  if back.len() == 3usize {
    let x = hexOf("x y");
    let z = hexOf("z");
    expectStr(back[0usize].view(), x.view(), "runLine's first");
    expectStr(back[1usize].view(), z.view(), "runLine's second");
    expectStr(back[2usize].view(), "", "runLine's third");
  }
}

fn inherited(exe &str) {
  // The child writes into this test's own output, which its .out pins
  stdio.printStr("a child sharing this output:\n");
  stdio.printFlush();
  let c = childCommand(exe, "hello");
  let o = ran(process.run(c.view(), new process.Options(inherit: true)), "inherit");
  expectUInt(u64.from(o.exitCode), 0u64, "inheriting child's exit code");
  expectStr(o.stdout.view(), "", "nothing captured when inherited");
  expectStr(o.stderr.view(), "", "nothing captured from stderr when inherited");
}

fn failures(exe &str, root &Path) {
  var none = List[String].empty();
  none.push(String.from("cone-process-test-no-such-program"));
  let r = process.run(none.view());
  failedWith(r, "", "", 2u32,
    os("run cone-process-test-no-such-program: The system cannot find the file specified",
       "run cone-process-test-no-such-program: No such file or directory"), "no such program");
  match process.run(none.view()) {
    case let e Error { expectBool(e.notFound(), true, "notFound"); }
    case is Ok { expect(false, "notFound"); }
  }

  let missing = root.join("missing");
  let c = childCommand(exe, "hello");
  failedWith(process.run(c.view(), new process.Options(), &missing), exe, root.view(),
    u32.from(osCode(267u64, 2u64)),
    os("run <exe> in <root>/missing: The directory name is invalid",
       "run <exe> in <root>/missing: No such file or directory"), "no such folder");
  // The error holds the folder as a Path, and the variable it was made from is as it was
  match process.run(c.view(), new process.Options(), &missing) {
    case let e Error {
      expectStr(e.dir.view(), missing.view(), "the error holds the working folder given");
      expect(e.dir.isAbsolute(), "and it is a Path");
    }
    case is Ok { expect(false, "no such folder fails"); }
  }
  // A literal folder that is not there, too
  if isWindows() {
    match process.run(c.view(), new process.Options(), "C:\\cone-process-test-no-such-folder") {
      case let e Error {
        expectStr(e.dir.view(), "C:\\cone-process-test-no-such-folder", "a literal folder held by the error");
        expectUInt(u64.from(e.code), 267u64, "a literal folder not there");
      }
      case is Ok { expect(false, "a literal folder not there fails"); }
    }
  } else {
    match process.run(c.view(), new process.Options(), "/cone-process-test-no-such-folder") {
      case let e Error {
        expectStr(e.dir.view(), "/cone-process-test-no-such-folder", "a literal folder held by the error");
        expectUInt(u64.from(e.code), 2u64, "a literal folder not there");
      }
      case is Ok { expect(false, "a literal folder not there fails"); }
    }
  }

  var empty = List[String].empty();
  failedWith(process.run(empty.view()), "", "", u32.from(osCode(87u64, 22u64)),
    os("run: The parameter is incorrect", "run: Invalid argument"), "no arguments");

  var nul = childCommand(exe, "args");
  nul.push(String.from("a\x00b"));
  failedWith(process.run(nul.view()), exe, "", u32.from(osCode(87u64, 22u64)),
    os("run <exe>: The parameter is incorrect", "run <exe>: Invalid argument"), "a NUL");

  // Windows' UTF-16 command line cannot hold what is not UTF-8; POSIX hands
  // the child its bytes as they are
  var bad = childCommand(exe, "args");
  bad.push(String.from("\xFF"));
  if isWindows() {
    failedWith(process.run(bad.view()), exe, "", 1113u32,
      "run <exe>: No mapping for the Unicode character exists in the target multi-byte code page", "not UTF-8");
  } else {
    let passed = ran(process.run(bad.view()), "not UTF-8");
    expectStr(passed.stdout.view(), "ff,", "not UTF-8");
    expectUInt(u64.from(passed.exitCode), 0u64, "not UTF-8 exit code");
  }

  // A '"' in the program's name: Windows cannot write it on its command line;
  // POSIX has no such rule, and the program is just not there
  var quoted = List[String].empty();
  quoted.push(String.from("a\"b"));
  failedWith(process.run(quoted.view()), "", "", u32.from(osCode(123u64, 2u64)),
    os("run a\"b: The filename, directory name, or volume label syntax is incorrect",
       "run a\"b: No such file or directory"), "a quote in the program");
}

fn me(exe &Path) {
  expectBool(exe.isAbsolute(), true, "currentExe is absolute");
  expectStr(exe.name(), os("children.exe", "children"), "currentExe names this test");
  expect(not exe.view().contains("\\"), "currentExe is normalized");
  let a = process.args();
  expectBool(a.len() == 1usize, true, "this test is run with no arguments");
}

fn main(argc i32, argv **u8) i32 {
  let a = process.args();
  if a.len() >= 3usize and a[1usize].equals("--child") { return child(&a, argc, argv); }

  var exe = Path.from("");
  match process.currentExe() {
    case var e Ok { exe <=> e; }
    case is Error { require(false, "currentExe"); }
  }
  let root = makeRoot("cone-process-test");
  if fs.exists(&root) { fs.removeAll(&root); }
  require(fs.makeDir(&root) is Ok, "the test's folder made");

  me(&exe);
  captured(exe.view());
  exitCodes(exe.view());
  panics(exe.view());
  crashesUnreported(exe.view());
  bigStreams(exe.view());
  timesOut(exe.view());
  treeStopped(exe.view(), &root);
  workingFolder(exe.view(), &root);
  standardInput(exe.view());
  environment(exe.view());
  arguments(exe.view());
  rawLine(exe.view());
  inherited(exe.view());
  failures(exe.view(), &root);

  let removed = fs.removeAll(&root);
  expect(removed is Ok, "the test's folder removed");
  done();
}
