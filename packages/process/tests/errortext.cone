// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import path use Path;
import process;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- process.ProcessError(String.from("run"), String.from("nosuch"), Path.from(""), 2u32), #if #os == .windows {"run nosuch: The system cannot find the file specified"} #else {"run nosuch: No such file or directory"}, "no dir");
  says(String() <- process.ProcessError(String.from("currentExe"), String(), Path.from("build/x"), 2u32), #if #os == .windows {"currentExe in build/x: The system cannot find the file specified"} #else {"currentExe in build/x: No such file or directory"}, "dir, no program");
  done()
}
