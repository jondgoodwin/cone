// pollTransmitAll: every byte ready to send at once, as a Chain of the
// buffers they lie in, the same bytes in the same order pollTransmit gives
// one buffer at a time. Each scene is played twice, drained each way, and the
// two must send the same bytes at the same points:
//
// 1. A server's sized response with a body of three whole buffers (each
//    larger than the core copies beside the head): several segments at once,
//    then nothing.
// 2. A chunked response, its framing gathered in small writes after whole
//    buffers.
// 3. A client's request with 'Expect: 100-continue': its head goes, its body
//    is held (not in the chain) until expectTimeout passes, then goes.

mod transmitall;

import testing use *;
import collections use String;
import time use Instant, Duration;
import iobuf use *;
import http use *;
import http1 use *;

fn feed(c: &mut Connection, text: &Array[u8], at: Instant) {
  var i = 0usize;
  while i < text.len {
    var b = IoBuf(4096usize);
    let n = b.append(&text[i ..< text.len]);
    c.handleInput(b, at);
    i = i + n;
  }
}

// What the connection has to send now, drained one way or the other; 'segs'
// counts the buffers it came in
fn drain(c: &mut Connection, at: Instant, all: bool, segs: &mut usize) String {
  var s = String.empty();
  if all {
    var ch = c.pollTransmitAll(at);
    *segs = *segs + ch.segments();
    while true {
      match ch.popFront() {
        case var Some(b) {s.appendBytes(b.view());}
        else {break;}
      }
    }
    let again = c.pollTransmitAll(at);
    if again.len() != 0usize {s.append("[MORE]");}
  } else {
    while true {
      let b = c.pollTransmit(at);
      if b.len() == 0usize {break;}
      *segs = *segs + 1usize;
      s.appendBytes(b.view());
    }
  }
  s
}

// Body buffer i: n bytes of a pattern
fn bodyBuf(i: usize, n: usize) IoBuf {
  var b = IoBuf(n);
  let room = b.whole();
  var k = 0usize;
  while k < n {
    room[k] = 97u8 + u8.from((i * 7usize + k) % 26usize);
    k = k + 1usize;
  }
  b.setLen(n);
  b
}

// Scene 1 or 2: a server answers a GET with three body buffers
fn serve(sized: bool, all: bool, segs: &mut usize) String {
  let t = Instant.fromNanos(1000000000i64);
  var c = Connection.server(Config.make(), t);
  feed(&mut c, "GET / HTTP/1.1\r\nHost: h\r\n\r\n", t);
  while true {
    match c.pollEvent() {
      case is NeedData {break;}
      case is Paused {break;}
      case is Closed {break;}
      else {}
    }
  }
  let body = if sized {BodyLength.sized(60000u64)} else {BodyLength.unsized()};
  c.sendResponse(ResponseHead.make(200u16), body);
  var i = 0usize;
  while i < 3usize {
    _ = c.sendData(bodyBuf(i, 20000usize));
    i = i + 1usize;
  }
  c.finish();
  var s = drain(&mut c, t, all, segs);
  expectUInt(u64.from(c.queued()), 0u64, "nothing left queued");
  expectUInt(c.bytesSent(), u64.from(s.len()), "bytesSent counts what went");
  s
}

// Scene 3: a PUT with Expect: 100-continue, its body held until the expect
// timeout. The bytes sent at each point, with '|' between the points
fn expectBody(all: bool, segs: &mut usize) String {
  let t = Instant.fromNanos(1000000000i64);
  var c = Connection.client(Config.make(), t);
  var h = RequestHead.get("/f", "h");
  h.method = Method.Put;
  h.headers.add("Expect", "100-continue");
  c.sendRequest(h, BodyLength.sized(6u64));
  _ = c.sendData(bodyBuf(0usize, 3usize));
  _ = c.sendData(bodyBuf(1usize, 3usize));
  c.finish();
  var s = drain(&mut c, t, all, segs);
  s.append("|");
  let later = t + Duration.fromSeconds(2i64);
  c.handleTimeout(later);
  let rest = drain(&mut c, later, all, segs);
  s.appendBytes(rest.view());
  s
}

fn main() i32 {
  var one = 0usize;
  var many = 0usize;
  let a = serve(true, false, &mut one);
  let b = serve(true, true, &mut many);
  expect(a.len() > 60000usize, "a sized response with its 60,000-byte body");
  expectStr(b.view(), a.view(), "sized: the same bytes either way");
  expectUInt(u64.from(many), u64.from(one), "...in the same buffers");
  expect(many > 1usize, "...several of them, in one chain");

  one = 0usize;
  many = 0usize;
  let ca = serve(false, false, &mut one);
  let cb = serve(false, true, &mut many);
  expectStr(cb.view(), ca.view(), "chunked: the same bytes either way");
  expectUInt(u64.from(many), u64.from(one), "...in the same buffers");

  one = 0usize;
  many = 0usize;
  let ea = expectBody(false, &mut one);
  let eb = expectBody(true, &mut many);
  expectStr(eb.view(), ea.view(), "Expect: the same bytes at the same points");
  expect(ea.view()[ea.len() - 1usize] != 124u8, "the body went after the timeout");
  done()
}
