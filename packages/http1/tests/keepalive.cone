// A client core and a server core wired to each other in memory, on virtual
// time: what one transmits the other is handed. One connection carries 200
// exchanges in turn (GETs of sized bodies, chunked POSTs echoed back
// chunked, HEADs, 204s), every body checked byte for byte, both ends
// counting every exchange and neither closing. Then the ways a connection
// ends: the client's 'Connection: close'; the server finishing while idle;
// a response before the request's body was sent (both ends close after
// it); and the client aborting. And the bound on sending: sendData hands a
// buffer back once the queue is past its watermark.

mod keepalive;

import testing use *;
import collections use String;
import time use Instant, Duration;
import iobuf use *;
import http use *;
import http1 use *;

fn at() Instant {Instant.fromNanos(1000000000i64)}

// Everything each side has to send, handed to the other, until neither has
// more
fn pump(c: &mut Connection, s: &mut Connection) {
  var moved = true;
  while moved {
    moved = false;
    while true {
      let b = c.pollTransmit(at());
      if b.len() == 0usize {break;}
      s.handleInput(b, at());
      moved = true;
    }
    while true {
      let b = s.pollTransmit(at());
      if b.len() == 0usize {break;}
      c.handleInput(b, at());
      moved = true;
    }
  }
}

// The byte at offset i of body n
fn bodyByte(n: u64, i: u64) u8 {u8.from((n * 7u64 + i * 13u64) % 251u64)}

fn fill(pool: &Pool, n: u64, len: usize) IoBuf {
  var b = pool.mustTake(len);
  let room = b.whole();
  var i = 0usize;
  while i < len {
    room[i] = bodyByte(n, u64.from(i));
    i = i + 1usize;
  }
  b.setLen(len);
  b
}

// What the server is answering
struct Serving {
  pub target: String;
  pub head: bool;
  pub body: String;
  pub requests: u64;
}

// The server's side of the exchange: read the request, answer it by its
// target: '/get/N' a sized body of N mod 300 bytes, '/echo' the body back
// chunked, '/204' no content, HEAD the length alone, '/early' a 413 at once
fn serve(s: &mut Connection, pool: &Pool, sv: &mut Serving) {
  while true {
    match s.pollEvent() {
      case var e Request {
        sv.target = String.from(e.head.target.view());
        sv.head = e.head.method == Method.Head;
        sv.body.clear();
        sv.requests = sv.requests + 1u64;
        if sv.target.equals("/early") {
          s.sendResponse(ResponseHead.make(413u16), BodyLength.empty());
        }
      }
      case var d Data {
        sv.body.appendBytes(d.buf.view());
        s.release(d.buf.len());
      }
      case is End {
        let t = sv.target.view();
        if sv.head {
          s.sendResponse(ResponseHead.make(200u16), BodyLength.sized(1234u64));
        } elif t == "/204" {
          s.sendResponse(ResponseHead.make(204u16), BodyLength.empty());
        } elif t == "/echo" {
          s.sendResponse(ResponseHead.make(200u16), BodyLength.unsized());
          var b = pool.mustTake(sv.body.len() + 1usize);
          b.append(sv.body.view());
          s.sendData(b);
          s.finish();
        } elif sv.target.startsWith("/get/") {
          var n = 0u64;
          var i = 5usize;
          while i < t.len {
            n = n * 10u64 + u64.from(t[i] - '0');
            i = i + 1usize;
          }
          let len = usize.from(n % 300u64);
          s.sendResponse(ResponseHead.make(200u16), BodyLength.sized(u64.from(len)));
          if len > 0usize {s.sendData(fill(pool, n, len));}
          s.finish();
        }
      }
      case is Closed {return;}
      case is NeedData {return;}
      case is Paused {return;}
      case is Failed {return;}
      case is Response {return;}
      case is Interim {return;}
    }
  }
}

// The client's side: the response's status and body, until it ends
struct Got {
  pub status: u16;
  pub body: String;
  pub ended: bool;
  pub closed: bool;
  pub failed: bool;
}

fn got() Got {new Got(0u16, String.empty(), false, false, false)}

fn read(c: &mut Connection, g: &mut Got) {
  while true {
    match c.pollEvent() {
      case var e Response {g.status = e.head.status;}
      case var d Data {
        g.body.appendBytes(d.buf.view());
        c.release(d.buf.len());
      }
      case is End {g.ended = true;}
      case is Closed {
        g.closed = true;
        return;
      }
      case is Failed {g.failed = true;}
      case is NeedData {return;}
      case is Paused {return;}
      case is Request {return;}
      case is Interim {}
    }
  }
}

// One exchange: the request sent, both sides driven until the response is
// whole
fn exchange(c: &mut Connection, s: &mut Connection, pool: &Pool, sv: &mut Serving, head: RequestHead,
    body: &Array[u8], chunked: bool, g: &mut Got) {
  if chunked {
    c.sendRequest(head, BodyLength.unsized());
    // in pieces of up to 100 bytes, each a chunk
    var i = 0usize;
    while i < body.len {
      let e = if i + 100usize < body.len {i + 100usize} else {body.len};
      var b = pool.mustTake(e - i);
      b.append(&body[i ..< e]);
      c.sendData(b);
      i = e;
    }
    c.finish();
  } else {
    c.sendRequest(head, BodyLength.empty());
  }
  var rounds = 0u32;
  while !g.ended && !g.closed && rounds < 10u32 {
    pump(c, s);
    serve(s, pool, sv);
    pump(c, s);
    read(c, g);
    rounds = rounds + 1u32;
  }
}

fn reuse(pool: &Pool) {
  var c = Connection.client(Config.make(), *pool, at());
  var s = Connection.server(Config.make(), *pool, at());
  var sv = new Serving(String.empty(), false, String.empty(), 0u64);
  var wrong = 0u64;
  var n = 0u64;
  while n < 200u64 {
    var g = got();
    let kind = n % 4u64;
    if kind == 0u64 || kind == 1u64 {
      var t = String.from("/get/");
      t.appendUInt(n * 37u64);
      exchange(&mut c, &mut s, pool, &mut sv, RequestHead.get(t.view(), "h"), "", false, &mut g);
      let want = usize.from((n * 37u64) % 300u64);
      let v = g.body.view();
      var ok = g.status == 200u16 && v.len == want;
      var i = 0usize;
      while ok && i < v.len {
        if v[i] != bodyByte(n * 37u64, u64.from(i)) {ok = false;}
        i = i + 1usize;
      }
      if !ok {wrong = wrong + 1u64;}
    } elif kind == 2u64 {
      var text = String.empty();
      var i = 0u64;
      while i < n * 3u64 + 1u64 {
        text.appendByte(u8.from(97u64 + (i + n) % 26u64));
        i = i + 1u64;
      }
      exchange(&mut c, &mut s, pool, &mut sv, RequestHead.make("POST", "/echo", "h"), text.view(), true, &mut g);
      if g.status != 200u16 || !g.body.equals(text.view()) {wrong = wrong + 1u64;}
    } else {
      if n % 8u64 == 3u64 {
        exchange(&mut c, &mut s, pool, &mut sv, RequestHead.make("HEAD", "/h", "h"), "", false, &mut g);
      } else {
        exchange(&mut c, &mut s, pool, &mut sv, RequestHead.get("/204", "h"), "", false, &mut g);
      }
      if g.body.len() != 0usize || !g.ended {wrong = wrong + 1u64;}
    }
    if !g.ended || g.closed || g.failed {wrong = wrong + 1u64;}
    n = n + 1u64;
  }
  expectUInt(wrong, 0u64, "200 exchanges on one connection, every body right");
  expectUInt(c.exchangeCount(), 200u64, "the client counted 200");
  expectUInt(s.exchangeCount(), 200u64, "so did the server");
  expectUInt(sv.requests, 200u64, "200 requests read");
  expect(c.canSendRequest() && !s.isClosed(), "and the connection is still open");
  expect(c.bytesSent() == s.bytesReceived() && s.bytesSent() == c.bytesReceived(), "every byte sent was received");
}

fn closing(pool: &Pool) {
  {
    var c = Connection.client(Config.make(), *pool, at());
    var s = Connection.server(Config.make(), *pool, at());
    var sv = new Serving(String.empty(), false, String.empty(), 0u64);
    var g = got();
    var h = RequestHead.get("/get/5", "h");
    h.headers.add("Connection", "close");
    exchange(&mut c, &mut s, pool, &mut sv, h, "", false, &mut g);
    pump(&mut c, &mut s);
    read(&mut c, &mut g);
    expect(g.ended && g.body.len() == 5usize, "the response to 'Connection: close'");
    expect(c.isClosed() && c.shouldClose(), "the client closes after it");
    expect(s.isClosed() && s.shouldClose(), "so does the server");
  }
  {
    var c = Connection.client(Config.make(), *pool, at());
    var s = Connection.server(Config.make(), *pool, at());
    var sv = new Serving(String.empty(), false, String.empty(), 0u64);
    var g = got();
    exchange(&mut c, &mut s, pool, &mut sv, RequestHead.get("/get/9", "h"), "", false, &mut g);
    expect(c.canSendRequest(), "kept alive");
    c.handleInput(IoBuf.empty(), at());    // the server closed its end
    var g2 = got();
    read(&mut c, &mut g2);
    expect(g2.closed && !g2.failed, "the server finished while idle: closed, cleanly");
    expect(!c.canSendRequest(), "and no request may follow");
  }
  {
    // A request whose body the server answers before reading: both close
    var c = Connection.client(Config.make(), *pool, at());
    var s = Connection.server(Config.make(), *pool, at());
    var sv = new Serving(String.empty(), false, String.empty(), 0u64);
    var g = got();
    c.sendRequest(RequestHead.make("POST", "/early", "h"), BodyLength.sized(100000u64));
    pump(&mut c, &mut s);
    serve(&mut s, pool, &mut sv);
    expect(s.isClosed(), "the server answered before the body: it will close");
    pump(&mut c, &mut s);
    read(&mut c, &mut g);
    expect(g.status == 413u16 && g.ended, "the client reads the early answer");
    expect(c.isClosed(), "and closes: its body is abandoned");
    var refused = false;
    match c.sendData(fill(pool, 0u64, 100usize)) {
      case is Some {refused = true;}
      case is None[IoBuf] {}
    }
    expect(!refused && c.queued() == 0usize, "what it still sends is dropped");
  }
  {
    var c = Connection.client(Config.make(), *pool, at());
    c.sendRequest(RequestHead.get("/", "h"), BodyLength.empty());
    c.abort();
    var g = got();
    read(&mut c, &mut g);
    expect(g.closed && c.shouldClose() && c.queued() == 0usize, "an abort ends it at once, its output dropped");
  }
}

fn watermark(pool: &Pool) {
  var cfg = Config.make();
  cfg.writeWatermark = 10000usize;
  var c = Connection.client(cfg, *pool, at());
  c.sendRequest(RequestHead.make("POST", "/up", "h"), BodyLength.unsized());
  var accepted = 0u64;
  var back = 0u64;
  var k = 0u64;
  while k < 5u64 {
    match c.sendData(fill(pool, k, 3000usize)) {
      case is Some {back = back + 1u64;}
      case is None[IoBuf] {accepted = accepted + 1u64;}
    }
    k = k + 1u64;
  }
  expectUInt(accepted, 3u64, "three 3000-byte chunks fit under a 10000-byte watermark with the head");
  expectUInt(back, 2u64, "the rest are handed back");
  expect(c.writeRoom() < 3000usize, "writeRoom says so");
  while true {
    let b = c.pollTransmit(at());
    if b.len() == 0usize {break;}
  }
  expectUInt(u64.from(c.writeRoom()), 10000u64, "sent: room again");
}

fn main() i32 {
  {
    let pool = Pool.make();
    reuse(&pool);
    closing(&pool);
    watermark(&pool);
    expectUInt(pool.stats().lent, 0u64, "every buffer back in the pool");
  }
  done()
}
