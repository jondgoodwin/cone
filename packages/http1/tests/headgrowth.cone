// A head is read where it lies, in the input's first segment, and copied
// together (once, into a block the input keeps only while it holds bytes) only
// when it crosses a segment's edge, up to the role's bound. Checked, by the
// buffer pool's lent bytes: a client awaiting a head holds no buffer for it,
// and a head's first bytes, in one segment, take no buffer beside the one
// they came in. A 20 KiB head, over several segments, is read whole: fed
// at once, and fed 4 KiB at a time with an event asked for after each piece,
// by a client and by a server. A head of exactly its bound is read, and one
// byte more is refused as before: maxResponseHeadBytes (64 KiB) for a
// client, maxHeadBytes (32 KiB) for a server, answered 431.

mod headgrowth;

import testing use *;
import collections use String;
import time use Instant;
import iobuf use *;
import http use *;
import http1 use *;

fn feed(c: &mut Connection, text: &Array[u8], at: Instant) {
  var i = 0usize;
  while i < text.len {
    var b = IoBuf(4096usize);
    let n = b.append(&text[i ..< text.len]);
    c.handleInput(b, at);
    i = i + n;
  }
}

fn drain(c: &mut Connection, at: Instant) String {
  var s = String.empty();
  var ch = c.pollTransmit(at);
  while true {
    match ch.popFront() {
      case var Some(b) {s.appendBytes(b.view());}
      else {break;}
    }
  }
  s
}

// A head of exactly total bytes: 'first', field lines of 1,000 bytes of
// value, then an X-End field whose value takes up what is left
fn sized(first: &str, total: usize) String {
  var s = String.from(first);
  var i = 0usize;
  while total - s.len() - 2usize > 2000usize {
    s.append("X-Pad-");
    s.appendUInt(u64.from(i));
    s.append(": ");
    var j = 0usize;
    while j < 1000usize {
      s.append("p");
      j = j + 1usize;
    }
    s.append("\r\n");
    i = i + 1usize;
  }
  let rest = total - s.len() - 2usize - 9usize;   // "X-End: " and its CRLF
  s.append("X-End: ");
  var j = 0usize;
  while j < rest {
    s.append("e");
    j = j + 1usize;
  }
  s.append("\r\n\r\n");
  s
}

// How many fields, and how long X-End's value is
fn putFields(log: &mut String, h: &Headers) {
  log.appendUInt(u64.from(h.len()));
  log.append(" fields, X-End ");
  match h.get("X-End") {
    case let Some(v) {
      log.appendUInt(u64.from(v.len));
      log.append(" bytes");
    }
    else {log.append("missing");}
  }
}

// The next event, said briefly
fn next(c: &mut Connection) String {
  var log = String.empty();
  match c.pollEvent() {
    case var Request(e) {
      log.append("request, ");
      putFields(&mut log, &e.head.headers);
    }
    case var Response(e) {
      log.append("response, ");
      putFields(&mut log, &e.head.headers);
    }
    case is NeedData {log.append("need data");}
    case var Failed(f) {
      log.append("failed ");
      log.append(f.error.message().view());
    }
    else {log.append("other");}
  }
  log
}

// A client with its GET sent, awaiting the response's head
fn awaiting(t: Instant) Connection {
  var c = Connection.client(Config.make(), t);
  c.sendRequest(RequestHead.get("/", "example.com"), BodyLength.empty());
  drain(&mut c, t);
  c
}

// Feeds text 4 KiB at a time, asking for an event after each piece but the
// last: each says NeedData. The event after the last piece, said briefly
fn trickle(c: &mut Connection, text: &Array[u8], at: Instant) String {
  var i = 0usize;
  var waits = true;
  while i < text.len {
    var b = IoBuf(4096usize);
    let n = b.append(&text[i ..< text.len]);
    c.handleInput(b, at);
    i = i + n;
    if i < text.len {
      let e = next(c);
      if e.view() != "need data" {waits = false;}
    }
  }
  expect(waits, "...each piece before the last asks for more");
  next(c)
}

fn main() i32 {
  let t = Instant.fromNanos(1000000000i64);
  let resp = "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n";
  let req = "GET / HTTP/1.1\r\nHost: h\r\n";

  // The buffer: none while a head is awaited; 4 KiB for its first bytes
  {
    var c = awaiting(t);
    let before = stats().lentBytes;
    expectStr(next(&mut c).view(), "need data", "a client awaits its response's head");
    expectUInt(u64.from(stats().lentBytes - before), 0u64, "...holding no buffer for it");
    let h = sized(resp, 20480usize);
    feed(&mut c, &h.view()[0usize ..< 100usize], t);
    expectStr(next(&mut c).view(), "need data", "100 bytes of it arrive");
    expectUInt(u64.from(stats().lentBytes - before), 4096u64, "...held: the 4 KiB they came in, and no head buffer (the head is read where it lies)");
  }

  // A 20 KiB head, past the first buffer, read whole
  {
    let h = sized(resp, 20480usize);
    expectUInt(u64.from(h.len()), 20480u64, "the response head is 20 KiB");
    var c = awaiting(t);
    feed(&mut c, h.view(), t);
    expectStr(next(&mut c).view(), "response, 21 fields, X-End 1215 bytes", "a client reads it, fed at once");
    var d = awaiting(t);
    expectStr(trickle(&mut d, h.view(), t).view(), "response, 21 fields, X-End 1215 bytes", "...and fed 4 KiB at a time");
  }
  {
    let h = sized(req, 20480usize);
    var s = Connection.server(Config.make(), t);
    feed(&mut s, h.view(), t);
    expectStr(next(&mut s).view(), "request, 20 fields, X-End 1226 bytes", "a server reads a 20 KiB request head (Host is its authority), fed at once");
    var r = Connection.server(Config.make(), t);
    expectStr(trickle(&mut r, h.view(), t).view(), "request, 20 fields, X-End 1226 bytes", "...and fed 4 KiB at a time");
  }

  // A client: exactly maxResponseHeadBytes read, one byte more refused
  {
    let h = sized(resp, 65536usize);
    expectUInt(u64.from(h.len()), 65536u64, "the response head is exactly 64 KiB");
    var c = awaiting(t);
    feed(&mut c, h.view(), t);
    expectStr(next(&mut c).view(), "response, 65 fields, X-End 1743 bytes", "...and is read");
  }
  {
    let h = sized(resp, 65537usize);
    expectUInt(u64.from(h.len()), 65537u64, "the response head is 64 KiB and a byte");
    var c = awaiting(t);
    feed(&mut c, h.view(), t);
    expectStr(next(&mut c).view(), "failed too large: the head is longer than maxResponseHeadBytes", "...and is refused");
  }

  // A server: exactly maxHeadBytes read, one byte more refused with 431
  {
    let h = sized(req, 32768usize);
    expectUInt(u64.from(h.len()), 32768u64, "the request head is exactly 32 KiB");
    var s = Connection.server(Config.make(), t);
    feed(&mut s, h.view(), t);
    expectStr(next(&mut s).view(), "request, 32 fields, X-End 1370 bytes", "...and is read");
  }
  {
    let h = sized(req, 32769usize);
    expectUInt(u64.from(h.len()), 32769u64, "the request head is 32 KiB and a byte");
    var s = Connection.server(Config.make(), t);
    feed(&mut s, h.view(), t);
    expectStr(next(&mut s).view(), "failed too large: the head is longer than maxHeadBytes", "...and is refused");
    expect(drain(&mut s, t).startsWith("HTTP/1.1 431 "), "...answered 431");
  }
  done()
}
