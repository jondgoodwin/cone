// A driver that hands a connection more than its read credit has a bug:
// the core says so with a panic at the driver's line, rather than holding
// bytes past its bound (I9). Up to the credit is taken.

mod overfeed;

import stdio use *;
import time use Instant;
import iobuf use *;
import http1 use *;

fn main() {
  var cfg = Config.make();
  cfg.maxBuffered = 16384usize;
  cfg.maxHeadBytes = 16384usize;       // a whole head must fit what it buffers
  var s = Connection.server(cfg, Instant.fromNanos(0i64));
  var a = IoBuf(16384usize);
  a.setLen(16000usize);
  s.handleInput(a, Instant.fromNanos(0i64));
  printStr("16000 bytes taken, credit left: ");
  printUInt(u64.from(s.readCredit()));
  printStr("\n");
  var b = IoBuf(4096usize);
  b.setLen(385usize);
  s.handleInput(b, Instant.fromNanos(0i64));
  printStr("not reached\n");
}
