// Local time: Zone.toLocal and Zone.fromLocal (LocalResult), on the committed
// files of tests/data (IANA release 2026f), and no new fixture: America/New_York
// (slim and fat) has a gap and an overlap every year, Australia/Lord_Howe has
// them of half an hour, America/Sao_Paulo had them until 2019 and has none
// since, and Europe/Moscow has had no daylight saving time since 2014.
//
// The expected values were worked out by hand and then compared with Python's
// zoneinfo reading the same slim file (datetime.fold 0 and 1 give the instants
// of a gap's or an overlap's two readings; the program that printed them is not
// kept, the values are all written below). The hand work, for New York 2026,
// whose changes are 2026-03-08T07:00:00Z (EST, UTC-5, to EDT, UTC-4) and
// 2026-11-01T06:00:00Z (EDT back to EST):
//   - Wall 02:30 on 8 March does not exist: 02:30 with EDT's offset is 06:30Z,
//     before the change, where the clock still said EST, so that reading is
//     wrong; with EST's offset it is 07:30Z, after the change, where the clock
//     says EDT, also wrong. So Gap(06:30Z, 07:30Z): the reading with the offset
//     after the change (EDT, the earlier instant) first.
//   - Wall 01:30 on 1 November exists twice: 05:30Z (EDT, before the change at
//     06:00Z) and 06:30Z (EST, after it). So Ambiguous(05:30Z, 06:30Z).
// The DateTimes are written as RFC 3339 text for comparison, with a 'Z' that
// means UTC for an instant and is only the text's ending for a wall clock reading.

mod localtime;

import testing use *;
import collections use *;
import time use Timestamp;
import calendar use Zone, DateTime, LocalResult;
import fs;
import path use Path;

fn loadFile(name: &str) String {
  var p = String.from("../../../../tests/data/");
  p.append(name);
  var file = String();
  match fs.readFile(&Path.from(p.view())) {
    case var Ok(ok) { file <-> ok; }
    case let Err(e) { require(false, "the data file is there"); }
  }
  file
}

fn zoneOf(file: &String) Zone {
  Zone.fromTzif(file.view()).expect("the test's file is read")
}

fn dt(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, nanos: i64) DateTime {
  match DateTime.fromYmdHms(y, mo, d, h, mi, s, nanos) {
    case let Some(x) { return x; }
    case is None { }
  }
  require(false, "the test's date and time exist");
  DateTime.fromTimestamp(Timestamp.fromUnixSeconds(0))
}

fn instant(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, nanos: i64) Timestamp {
  match dt(y, mo, d, h, mi, s, nanos).toTimestamp() {
    case let Some(t) { return t; }
    case is None { }
  }
  require(false, "the test's instant is in range");
  Timestamp.fromUnixSeconds(0)
}

fn named(kind: &str, label: &str) String {
  var m = String.from(kind);
  m.append(" ");
  m.append(label);
  m
}

// The wall clock at a UTC instant
fn wallAt(z: &Zone, kind: &str, label: &str, y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, nanos: i64, want: &str) {
  let got = z.toLocal(instant(y, mo, d, h, mi, s, nanos));
  expectStr(got.rfc3339().view(), want, named(kind, label).view());
}

// A wall clock reading that is one instant
fn single(z: &Zone, kind: &str, label: &str, y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, nanos: i64, want: &str) {
  match z.fromLocal(dt(y, mo, d, h, mi, s, nanos)) {
    case let Single(u) { expectStr(u.rfc3339().view(), want, named(kind, label).view()); }
    case let Gap(g) { expect(false, named(kind, "is a gap, not Single: ").view()); }
    case let Ambiguous(a) { expect(false, named(kind, "is ambiguous, not Single: ").view()); }
  }
}

// One that is skipped
fn gap(z: &Zone, kind: &str, label: &str, y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, nanos: i64, before: &str, after: &str) {
  match z.fromLocal(dt(y, mo, d, h, mi, s, nanos)) {
    case let Single(u) { expect(false, named(kind, "is Single, not a Gap: ").view()); }
    case let Gap(g) {
      expectStr(g.before.rfc3339().view(), before, named(kind, label).view());
      expectStr(g.after.rfc3339().view(), after, named(kind, label).view());
    }
    case let Ambiguous(a) { expect(false, named(kind, "is ambiguous, not a Gap: ").view()); }
  }
}

// One that is read twice
fn twice(z: &Zone, kind: &str, label: &str, y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, nanos: i64, earlier: &str, later: &str) {
  match z.fromLocal(dt(y, mo, d, h, mi, s, nanos)) {
    case let Single(u) { expect(false, named(kind, "is Single, not ambiguous: ").view()); }
    case let Gap(g) { expect(false, named(kind, "is a gap, not ambiguous: ").view()); }
    case let Ambiguous(a) {
      expectStr(a.earlier.rfc3339().view(), earlier, named(kind, label).view());
      expectStr(a.later.rfc3339().view(), later, named(kind, label).view());
    }
  }
}

// New York, in 2026: the change at 2026-03-08T07:00:00Z and the one at 2026-11-01T06:00:00Z
fn newYork(z: &Zone, kind: &str) {
  // instant to wall clock, a second either side of each change (EST is UTC-5, EDT UTC-4)
  wallAt(z, kind, "NY 2026-03-08T06:59:59Z", 2026, 3, 8, 6, 59, 59, 0, "2026-03-08T01:59:59Z");
  wallAt(z, kind, "NY 2026-03-08T07:00:00Z", 2026, 3, 8, 7, 0, 0, 0, "2026-03-08T03:00:00Z");
  wallAt(z, kind, "NY 2026-11-01T05:59:59Z", 2026, 11, 1, 5, 59, 59, 0, "2026-11-01T01:59:59Z");
  wallAt(z, kind, "NY 2026-11-01T06:00:00Z", 2026, 11, 1, 6, 0, 0, 0, "2026-11-01T01:00:00Z");
  wallAt(z, kind, "NY 2026-11-01T06:00:00.5Z", 2026, 11, 1, 6, 0, 0, 500000000, "2026-11-01T01:00:00.5Z");
  wallAt(z, kind, "NY 2026-01-01T03:00:00Z crosses midnight", 2026, 1, 1, 3, 0, 0, 0, "2025-12-31T22:00:00Z");
  wallAt(z, kind, "NY 2026-07-04T02:00:00Z crosses midnight", 2026, 7, 4, 2, 0, 0, 0, "2026-07-03T22:00:00Z");
  // wall clock to instant, ordinary: before the spring change, after it, before the fall
  // change, after it (02:00 is EST again)
  single(z, kind, "NY 2026-03-08 01:59:59", 2026, 3, 8, 1, 59, 59, 0, "2026-03-08T06:59:59Z");
  single(z, kind, "NY 2026-03-08 03:00:00", 2026, 3, 8, 3, 0, 0, 0, "2026-03-08T07:00:00Z");
  single(z, kind, "NY 2026-11-01 00:59:59", 2026, 11, 1, 0, 59, 59, 0, "2026-11-01T04:59:59Z");
  single(z, kind, "NY 2026-11-01 02:00:00", 2026, 11, 1, 2, 0, 0, 0, "2026-11-01T07:00:00Z");
  single(z, kind, "NY 2026-01-15 07:00:00", 2026, 1, 15, 7, 0, 0, 0, "2026-01-15T12:00:00Z");
  single(z, kind, "NY 2026-07-04 08:00:00.25", 2026, 7, 4, 8, 0, 0, 250000000, "2026-07-04T12:00:00.25Z");
  // the gap: 02:00:00 to 02:59:59.999999999 on 2026-03-08
  gap(z, kind, "NY 2026-03-08 02:00:00", 2026, 3, 8, 2, 0, 0, 0, "2026-03-08T06:00:00Z", "2026-03-08T07:00:00Z");
  gap(z, kind, "NY 2026-03-08 02:30:00", 2026, 3, 8, 2, 30, 0, 0, "2026-03-08T06:30:00Z", "2026-03-08T07:30:00Z");
  gap(z, kind, "NY 2026-03-08 02:59:59.5", 2026, 3, 8, 2, 59, 59, 500000000,
    "2026-03-08T06:59:59.5Z", "2026-03-08T07:59:59.5Z");
  // the overlap: 01:00:00 to 01:59:59.999999999 on 2026-11-01
  twice(z, kind, "NY 2026-11-01 01:00:00", 2026, 11, 1, 1, 0, 0, 0, "2026-11-01T05:00:00Z", "2026-11-01T06:00:00Z");
  twice(z, kind, "NY 2026-11-01 01:30:00", 2026, 11, 1, 1, 30, 0, 0, "2026-11-01T05:30:00Z", "2026-11-01T06:30:00Z");
  twice(z, kind, "NY 2026-11-01 01:59:59", 2026, 11, 1, 1, 59, 59, 0, "2026-11-01T05:59:59Z", "2026-11-01T06:59:59Z");
}

// Lord Howe, whose changes are half an hour: 2026-04-04T15:00:00Z (+11 to +1030)
// and 2026-10-03T15:30:00Z (+1030 to +11)
fn lordHowe(z: &Zone, kind: &str) {
  wallAt(z, kind, "LH 2026-04-04T14:59:59Z", 2026, 4, 4, 14, 59, 59, 0, "2026-04-05T01:59:59Z");
  wallAt(z, kind, "LH 2026-04-04T15:00:00Z", 2026, 4, 4, 15, 0, 0, 0, "2026-04-05T01:30:00Z");
  wallAt(z, kind, "LH 2026-10-03T15:29:59Z", 2026, 10, 3, 15, 29, 59, 0, "2026-10-04T01:59:59Z");
  wallAt(z, kind, "LH 2026-10-03T15:30:00Z", 2026, 10, 3, 15, 30, 0, 0, "2026-10-04T02:30:00Z");
  // the overlap is 01:30 to 01:59:59 on 2026-04-05; 01:45 is 14:45Z at +11 and 15:15Z at +1030
  twice(z, kind, "LH 2026-04-05 01:45:00", 2026, 4, 5, 1, 45, 0, 0, "2026-04-04T14:45:00Z", "2026-04-04T15:15:00Z");
  single(z, kind, "LH 2026-04-05 01:29:59", 2026, 4, 5, 1, 29, 59, 0, "2026-04-04T14:29:59Z");
  single(z, kind, "LH 2026-04-05 02:00:00", 2026, 4, 5, 2, 0, 0, 0, "2026-04-04T15:30:00Z");
  // the gap is 02:00 to 02:29:59 on 2026-10-04; 02:15 is 15:15Z at +11 and 15:45Z at +1030
  gap(z, kind, "LH 2026-10-04 02:15:00", 2026, 10, 4, 2, 15, 0, 0, "2026-10-03T15:15:00Z", "2026-10-03T15:45:00Z");
  single(z, kind, "LH 2026-10-04 02:30:00", 2026, 10, 4, 2, 30, 0, 0, "2026-10-03T15:30:00Z");
}

fn newYorkFarFuture(z: &Zone, kind: &str) {
  // past the listed transitions of a fat file (2037), the footer's rule alone: the second
  // Sunday of March 2050 is the 13th (1 March 2050 is a Tuesday), the first of November the 6th
  gap(z, kind, "NY 2050-03-13 02:30:00", 2050, 3, 13, 2, 30, 0, 0, "2050-03-13T06:30:00Z", "2050-03-13T07:30:00Z");
  twice(z, kind, "NY 2050-11-06 01:30:00", 2050, 11, 6, 1, 30, 0, 0, "2050-11-06T05:30:00Z", "2050-11-06T06:30:00Z");
  single(z, kind, "NY 2100-07-01 08:00:00", 2100, 7, 1, 8, 0, 0, 0, "2100-07-01T12:00:00Z");
}

// Sao Paulo: -03 now, and daylight saving time until 2019. Its changes then:
// 2018-11-04T03:00:00Z (-03 to -02) and 2019-02-17T02:00:00Z (-02 to -03)
fn saoPaulo(z: &Zone, kind: &str) {
  wallAt(z, kind, "SP 2018-11-04T02:59:59Z", 2018, 11, 4, 2, 59, 59, 0, "2018-11-03T23:59:59Z");
  wallAt(z, kind, "SP 2018-11-04T03:00:00Z", 2018, 11, 4, 3, 0, 0, 0, "2018-11-04T01:00:00Z");
  wallAt(z, kind, "SP 2019-02-17T01:59:59Z", 2019, 2, 17, 1, 59, 59, 0, "2019-02-16T23:59:59Z");
  wallAt(z, kind, "SP 2019-02-17T02:00:00Z", 2019, 2, 17, 2, 0, 0, 0, "2019-02-16T23:00:00Z");
  gap(z, kind, "SP 2018-11-04 00:30:00", 2018, 11, 4, 0, 30, 0, 0, "2018-11-04T02:30:00Z", "2018-11-04T03:30:00Z");
  twice(z, kind, "SP 2019-02-16 23:30:00", 2019, 2, 16, 23, 30, 0, 0, "2019-02-17T01:30:00Z", "2019-02-17T02:30:00Z");
  // no daylight saving time since: every reading is one instant, in June or in December
  wallAt(z, kind, "SP 2026-06-01T12:00:00Z", 2026, 6, 1, 12, 0, 0, 0, "2026-06-01T09:00:00Z");
  wallAt(z, kind, "SP 2026-12-25T02:00:00Z", 2026, 12, 25, 2, 0, 0, 0, "2026-12-24T23:00:00Z");
  single(z, kind, "SP 2026-06-01 09:00:00", 2026, 6, 1, 9, 0, 0, 0, "2026-06-01T12:00:00Z");
  single(z, kind, "SP 2026-11-01 02:30:00", 2026, 11, 1, 2, 30, 0, 0, "2026-11-01T05:30:00Z");
  single(z, kind, "SP 2100-01-01 00:00:00", 2100, 1, 1, 0, 0, 0, 0, "2100-01-01T03:00:00Z");
}

// Moscow: +03 since 2014, no daylight saving time
fn moscow(z: &Zone, kind: &str) {
  wallAt(z, kind, "MSK 2026-06-01T12:00:00Z", 2026, 6, 1, 12, 0, 0, 0, "2026-06-01T15:00:00Z");
  wallAt(z, kind, "MSK 2026-12-31T22:00:00Z", 2026, 12, 31, 22, 0, 0, 0, "2027-01-01T01:00:00Z");
  single(z, kind, "MSK 2026-06-01 15:00:00", 2026, 6, 1, 15, 0, 0, 0, "2026-06-01T12:00:00Z");
  single(z, kind, "MSK 2026-03-29 02:30:00", 2026, 3, 29, 2, 30, 0, 0, "2026-03-28T23:30:00Z");
  single(z, kind, "MSK 2026-10-25 01:30:00", 2026, 10, 25, 1, 30, 0, 0, "2026-10-24T22:30:00Z");
}

// A wall clock year past a Timestamp's range (2262) still answers, from the rules alone
fn beyondTimestamps(z: &Zone, kind: &str) {
  single(z, kind, "NY 3000-07-01 08:00:00", 3000, 7, 1, 8, 0, 0, 0, "3000-07-01T12:00:00Z");
  single(z, kind, "NY 3000-01-01 08:00:00", 3000, 1, 1, 8, 0, 0, 0, "3000-01-01T13:00:00Z");
}

fn main() i32 {
  let nyS = loadFile("America_New_York.slim.tzif");
  let nyF = loadFile("America_New_York.fat.tzif");
  let lh = loadFile("Australia_Lord_Howe.slim.tzif");
  let spS = loadFile("America_Sao_Paulo.slim.tzif");
  let spF = loadFile("America_Sao_Paulo.fat.tzif");
  let mS = loadFile("Europe_Moscow.slim.tzif");
  let mF = loadFile("Europe_Moscow.fat.tzif");
  newYork(&zoneOf(&nyS), "slim");
  newYork(&zoneOf(&nyF), "fat");
  newYorkFarFuture(&zoneOf(&nyS), "slim");
  newYorkFarFuture(&zoneOf(&nyF), "fat");
  beyondTimestamps(&zoneOf(&nyS), "slim");
  lordHowe(&zoneOf(&lh), "slim");
  saoPaulo(&zoneOf(&spS), "slim");
  saoPaulo(&zoneOf(&spF), "fat");
  moscow(&zoneOf(&mS), "slim");
  moscow(&zoneOf(&mF), "fat");
  return done();
}
