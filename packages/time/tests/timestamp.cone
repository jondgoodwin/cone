// Timestamp: now agrees with libc.time() to the second; Unix seconds and
// nanoseconds round trip, before 1970 too, where whole seconds round toward
// the past; plus and minus a Duration, the Duration between two, and
// comparison.

mod timestamp;

import testing use *;
import libc;
import time use Duration, Timestamp;

fn now() {
  imm before = libc.time(null);
  imm t = Timestamp.now();
  imm after = libc.time(null);
  // libc.time() counts whole seconds, rounded down, as unixSeconds does
  expect(t.unixSeconds() >= before and t.unixSeconds() <= after, "Timestamp.now() agrees with libc.time() to the second");
  // Somewhere after 2026-01-01 (1767225600) and before 2100
  expect(t.unixSeconds() > 1767225600i64 and t.unixSeconds() < 4102444800i64, "and is a plausible date");
}

fn unixSeconds() {
  imm t = Timestamp.fromUnixSeconds(1759449600);   // 2025-10-03 00:00:00 UTC
  expectInt(t.unixSeconds(), 1759449600, "fromUnixSeconds round trips");
  expectInt(t.unixNanos(), 1759449600000000000, "as nanoseconds");
  expectInt(Timestamp.fromUnixNanos(1759449600123456789).unixSeconds(), 1759449600, "a fraction rounds down");
  expectInt(Timestamp.fromUnixNanos(1759449600123456789).unixNanos(), 1759449600123456789, "fromUnixNanos round trips");
  expectInt(Timestamp.fromUnixSeconds(0).unixNanos(), 0, "the epoch is 0");
  expect(new Timestamp() == Timestamp.fromUnixSeconds(0), "new Timestamp() is the epoch");
}

fn before1970() {
  imm moon = Timestamp.fromUnixSeconds(-14182940);   // 1969-07-20 20:17:40 UTC
  expectInt(moon.unixSeconds(), -14182940, "a pre-1970 second round trips");
  expectInt(moon.unixNanos(), -14182940000000000, "as nanoseconds");
  expect(moon < Timestamp.fromUnixSeconds(0), "before the epoch is less");
  // Half a second before the epoch is in the second -1, as Unix time has it
  expectInt(Timestamp.fromUnixNanos(-500000000).unixSeconds(), -1, "-0.5 s rounds down to -1");
  expectInt(Timestamp.fromUnixNanos(-1000000000).unixSeconds(), -1, "-1 s exactly is -1");
  expectInt(Timestamp.fromUnixNanos(-1000000001).unixSeconds(), -2, "-1.000000001 s rounds down to -2");
  expectInt(Timestamp.fromUnixSeconds(-6307200000).unixSeconds(), -6307200000, "two hundred years back");
}

fn arithmetic() {
  imm t = Timestamp.fromUnixSeconds(1000);
  imm d = Duration.fromMinutes(2);
  expectInt((t + d).unixSeconds(), 1120, "Timestamp + Duration");
  expectInt((t - d).unixSeconds(), 880, "Timestamp - Duration");
  expectInt(((t + d) - t).seconds(), 120, "Timestamp - Timestamp");
  expectInt((t - (t + d)).seconds(), -120, "Timestamp - a later Timestamp is negative");
  expectInt((Timestamp.fromUnixSeconds(0) - Duration.fromSeconds(1)).unixSeconds(), -1, "back across the epoch");
  expect(t + d > t and t - d < t, "> and <");
  expect(t >= t and t <= t, ">= and <=");
  expect(t == Timestamp.fromUnixNanos(1000000000000), "==");
  expect(t != t + Duration.fromNanos(1), "!=");
}

fn main() i32 {
  now();
  unixSeconds();
  before1970();
  arithmetic();
  done();
}
