// localetables: the number and date conventions of the locales the locale package knows,
// from Unicode CLDR 49.0.0. Written by localetables.py, which says how each is made; change
// that and run it, never this file. Ids, in order: 0 invariant, 1 en, 2 de.

fn decimalOf(id: u8) char {
  if id == 1u8 {return '.';}
  if id == 2u8 {return ',';}
  '.'
}

fn groupOf(id: u8) char {
  if id == 1u8 {return ',';}
  if id == 2u8 {return '.';}
  ','
}

fn groupSizeOf(id: u8) u8 {
  if id == 1u8 {return 3u8;}
  if id == 2u8 {return 3u8;}
  3u8
}

fn dayDotOf(id: u8) bool {
  if id == 1u8 {return false;}
  if id == 2u8 {return true;}
  false
}

fn hasShortOf(id: u8) bool {
  if id == 1u8 {return false;}
  if id == 2u8 {return true;}
  false
}

fn shortOrderOf(id: u8) u8 {
  if id == 1u8 {return 0u8;}
  if id == 2u8 {return 0u8;}
  0u8
}

fn shortSepOf(id: u8) char {
  if id == 1u8 {return '-';}
  if id == 2u8 {return '.';}
  '-'
}

fn shortPadOf(id: u8) bool {
  if id == 1u8 {return false;}
  if id == 2u8 {return true;}
  false
}

fn monthWideOf(id: u8, i: usize) &str inline {
  if id == 1u8 {let a: Array[&str, 12] = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]; return a[i];}
  if id == 2u8 {let a: Array[&str, 12] = ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"]; return a[i];}
  let a: Array[&str, 12] = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  a[i]
}

fn monthAbbrOf(id: u8, i: usize) &str inline {
  if id == 1u8 {let a: Array[&str, 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]; return a[i];}
  if id == 2u8 {let a: Array[&str, 12] = ["Jan.", "Feb.", "März", "Apr.", "Mai", "Juni", "Juli", "Aug.", "Sept.", "Okt.", "Nov.", "Dez."]; return a[i];}
  let a: Array[&str, 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  a[i]
}

fn dayWideOf(id: u8, i: usize) &str inline {
  if id == 1u8 {let a: Array[&str, 7] = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]; return a[i];}
  if id == 2u8 {let a: Array[&str, 7] = ["Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag"]; return a[i];}
  let a: Array[&str, 7] = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
  a[i]
}
