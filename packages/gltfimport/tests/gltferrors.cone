// What the loader refuses, and says. A tiny valid asset (one triangle, three
// zero positions in a data: uri) is damaged one way at a time, and each damage
// must be a failure with a reason that names the trouble, never a crash or
// a silently wrong model. Compressed files are refused by name, with what
// supporting them would take.

mod gltferrors;

import testing use *;
import collections use *;
import gltfimport use *;
import stdio use *;

// 36 zero bytes, base64: three positions at the origin
let zeros = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";

// The asset with 'asset' as its asset object, 'top' extra members at the top
// level (must end with a comma or be empty), 'prim' extra members of the
// primitive, 'acc' extra members of the accessor, and 'buf' extra members of
// the buffer
fn make(asset: &str, top: &str, prim: &str, acc: &str, buf: &str) String {
  var s = String.from("{\"asset\":");
  s.append(asset);
  s.append(",");
  s.append(top);
  s.append("\"scenes\":[{\"nodes\":[0]}],\"nodes\":[{\"mesh\":0}],");
  s.append("\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0}");
  s.append(prim);
  s.append("}]}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"");
  s.append(acc);
  s.append("}],\"bufferViews\":[{\"buffer\":0,\"byteLength\":36}],\"buffers\":[{\"byteLength\":36,");
  s.append("\"uri\":\"data:application/octet-stream;base64,");
  s.append(zeros);
  s.append("\"");
  s.append(buf);
  s.append("}]}");
  s
}

fn rep(s: String, a: &str, b: &str) String {
  var c = s.copy();
  c.replace(a, b);
  c
}

fn good() String { make("{\"version\":\"2.0\"}", "", "", "", "") }

// Whether loading 'json' fails with a reason containing 'want'
fn fails(json: String, want: &str, label: &str) {
  match loadGltfBytes(json.view(), true) {
    case let Ok(g) { expect(false, label); }
    case let Error(e) {
      if !expect(e.reason.contains(want), label) {
        printStr(e.reason.view());
        printStr("\n");
      }
    }
  }
}

fn main() i32 {
  // The undamaged asset loads
  match loadGltfBytes(good().view(), true) {
    case let Ok(g) {
      expectInt(i64.from(g.meshes[0usize].primitives[0usize].mesh.positions.len()), 3i64, "the good asset loads");
    }
    case let Error(e) { expect(false, e.reason.view()); }
  }

  // Compression: refused by name, with what it would take
  fails(make("{\"version\":\"2.0\"}", "\"extensionsRequired\":[\"KHR_draco_mesh_compression\"],", "", "", ""),
    "Draco's decoder", "Draco required");
  fails(make("{\"version\":\"2.0\"}", "\"extensionsRequired\":[\"KHR_draco_mesh_compression\"],", "", "", ""),
    "dependency", "Draco says what it would take");
  fails(make("{\"version\":\"2.0\"}", "\"extensionsRequired\":[\"EXT_meshopt_compression\"],", "", "", ""),
    "meshopt's decoder", "meshopt required");
  fails(make("{\"version\":\"2.0\"}", "\"extensionsRequired\":[\"EXT_meshopt_compression\"],", "", "", ""),
    "about a day", "meshopt says what it would take");
  // Draco on a primitive whose accessors have no data of their own
  let dracoPrim = make("{\"version\":\"2.0\"}", "", ",\"extensions\":{\"KHR_draco_mesh_compression\":{\"bufferView\":0,\"attributes\":{\"POSITION\":0}}}", "", "");
  fails(rep(dracoPrim.copy(), "{\"bufferView\":0,\"componentType\"", "{\"componentType\""), "Draco", "Draco primitive without fallback");
  match loadGltfBytes(dracoPrim.view(), true) {
    case let Ok(g) { expectInt(i64.from(g.warnings.len()), 1i64, "Draco with uncompressed fallback loads, with a warning"); }
    case let Error(e) { expect(false, e.reason.view()); }
  }
  fails(make("{\"version\":\"2.0\"}", "\"extensionsRequired\":[\"KHR_materials_clearcoat\"],", "", "", ""),
    "KHR_materials_clearcoat", "an unknown required extension is named");

  // The document
  fails(make("{\"version\":\"1.0\"}", "", "", "", ""), "2.0", "version 1.0");
  fails(String.from("{\"asset\": "), "line 1", "truncated JSON");
  fails(String.from("[1,2]"), "not an object", "JSON that is not an object");
  fails(String.from("{\"asset\":{\"version\":\"2.0\"},}"), "key must be a string", "a trailing comma");

  // Buffers and accessors
  fails(rep(good(), "\"count\":3", "\"count\":99"), "reaches past", "an accessor past its view");
  fails(rep(good(), "5126", "9999"), "component type", "an unknown component type");
  fails(rep(good(), "VEC3", "VEC9"), "unknown type", "an unknown accessor type");
  fails(make("{\"version\":\"2.0\"}", "", ",\"indices\":0", "", ""), "unsigned integers", "indices that are floats");
  fails(rep(make("{\"version\":\"2.0\"}", "", "", "", ""), "base64,AAAA", "base64,@@@@"),
    "base64", "bad base64");
  fails(rep(make("{\"version\":\"2.0\"}", "", "", "", ""), "\"byteLength\":36,\"uri", "\"byteLength\":3600,\"uri"),
    "shorter than its byteLength", "a buffer shorter than it says");
  fails(rep(make("{\"version\":\"2.0\"}", "", "", "", ""), "data:application/octet-stream;base64,", "cube.bin#"),
    "no folder", "an external file with no folder");
  fails(make("{\"version\":\"2.0\"}", "", ",\"material\":4", "", ""), "material", "a missing material");
  fails(rep(make("{\"version\":\"2.0\"}", "", "", "", ""), "\"nodes\":[{\"mesh\":0}]", "\"nodes\":[{\"mesh\":7}]"),
    "mesh that does not exist", "a missing mesh");

  // Graph
  fails(rep(make("{\"version\":\"2.0\"}", "", "", "", ""), "\"nodes\":[{\"mesh\":0}]", "\"nodes\":[{\"children\":[1]},{\"children\":[0]}]"),
    "ancestor", "a cycle of nodes");
  fails(rep(make("{\"version\":\"2.0\"}", "", "", "", ""), "\"nodes\":[{\"mesh\":0}]", "\"nodes\":[{\"children\":[2]},{\"children\":[2]},{}]"),
    "two parents", "a node with two parents");

  // Points and lines are skipped with a warning, not a failure
  let lines = make("{\"version\":\"2.0\"}", "", ",\"mode\":1", "", "");
  match loadGltfBytes(lines.view(), true) {
    case let Ok(g) {
      expectInt(i64.from(g.meshes[0usize].primitives.len()), 0i64, "a lines primitive is not loaded");
      expectInt(i64.from(g.warnings.len()), 1i64, "and is named in the warnings");
    }
    case let Error(e) { expect(false, e.reason.view()); }
  }
  // GLB damage
  fails(String.from("glTF\x02\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"), "JSON", "a GLB with no JSON chunk");
  done()
}
