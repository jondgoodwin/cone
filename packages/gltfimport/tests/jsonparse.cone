// The JSON reader against RFC 8259's grammar: numbers (checked against the
// values their text means), strings with every escape and the surrogate
// pairs, nesting and lookup, and the texts it must refuse, each with the line
// and column of the trouble.

mod jsonparse;

import testing use *;
import collections use *;
import gltfimport use *;

fn parse(text: &str) Json {
  match parseJson(text) {
    case var ok Ok {
      var j = Json(List[JNode].empty(), List[u32].empty());
      j <-> ok;
      return j;
    }
    case let e Error { return Json(List[JNode].empty(), List[u32].empty()); }
  }
}

fn number(text: &str, want: f64, label: &str) {
  let j = parse(text);
  if !require(j.nodes.len() > 0usize, label) { return; }
  let got = j.num(0u32, -999.);
  // Relative to the size, to a few units in the last place
  let tol = if want < 0. {-want} else {want} * 0.000000000001;
  expectFloat(got, want, if tol > 0.000000000001 {tol} else {0.000000000001}, label);
}

fn refused(text: &str, line: u32, col: u32, label: &str) {
  match parseJson(text) {
    case let j Ok { expect(false, label); }
    case let e Error {
      expectUInt(u64.from(e.line), u64.from(line), label);
      expectUInt(u64.from(e.column), u64.from(col), label);
    }
  }
}

fn main() i32 {
  number("0", 0.0, "zero");
  number("-0.5", -0.5, "negative fraction");
  number("1e3", 1000.0, "exponent");
  number("1.5E-2", 0.015, "negative exponent");
  number("123456789012345678", 123456789012345678.0, "eighteen digits");
  number("0.1", 0.1, "a tenth");
  number("2.5e+10", 25000000000.0, "plus exponent");
  number("1e22", 1e22, "ten to the 22");
  number("3.14159265358979", 3.14159265358979, "pi");
  number("-1234.5678e-3", -1.2345678, "all parts");
  number("0.000001", 0.000001, "a millionth");
  number("  \n 7 \t", 7.0, "white space around");

  // Strings
  let j = parse("{\"s\":\"a\\\"b\\\\c\\/d\\b\\f\\n\\r\\t\\u00e9\\ud83d\\ude00z\"}");
  let s = j.getStr(0u32, "s", "");
  let want: Array[u8, 20] = [97u8, 34u8, 98u8, 92u8, 99u8, 47u8, 100u8, 8u8, 12u8, 10u8, 13u8, 9u8, 0xC3u8, 0xA9u8,
    0xF0u8, 0x9Fu8, 0x98u8, 0x80u8, 122u8, 0u8];
  expectInt(i64.from(s.len()), 19i64, "decoded string length");
  var same = true;
  var i = 0usize;
  while i < 19usize && i < s.len() { if s[i] != want[i] { same = false; } i += 1usize; }
  expect(same, "every escape decoded, e acute as two bytes, the emoji as four");

  // Structure
  let k = parse("{\"a\":[1,2,{\"b\":true}],\"c\":null,\"d\":{},\"e\":[],\"a\":99}");
  expect(k.isObject(0u32), "root is an object");
  let a = k.get(0u32, "a");
  expectInt(i64.from(k.len(a)), 3i64, "array length");
  expectFloat(k.num(k.at(a, 1usize), 0.), 2., 0.0001, "second element");
  expect(k.flag(k.get(k.at(a, 2usize), "b"), false), "nested true");
  expect(k.get(0u32, "c") != NoNode && k.kindOf(k.get(0u32, "c")) == JsonKind.Null, "null");
  expectInt(i64.from(k.len(k.get(0u32, "d"))), 0i64, "empty object");
  expectInt(i64.from(k.len(k.get(0u32, "e"))), 0i64, "empty array");
  expectInt(k.getInt(0u32, "missing", -5i64), -5i64, "a missing key answers the fallback");
  expect(k.get(0u32, "missing") == NoNode, "and NoNode");
  expectFloat(k.num(k.at(a, 0usize), 0.), 1., 0.0001, "the first of two duplicate keys answers (a is the array)");
  expectInt(i64.from(k.len(0u32)), 5i64, "five entries including the duplicate");

  // A byte-order mark is allowed
  let bom: Array[u8, 5] = [0xEFu8, 0xBBu8, 0xBFu8, '4', '2'];
  match parseJson(&bom) {
    case let ok Ok { expectFloat(ok.num(0u32, 0.), 42., 0.0001, "a BOM is skipped"); }
    case let e Error { expect(false, "a BOM is skipped"); }
  }

  // Refusals, with where
  refused("01", 1u32, 2u32, "a leading zero");
  refused("1.", 1u32, 3u32, "a fraction with no digits");
  refused("-", 1u32, 2u32, "a lone minus");
  refused("[1,]", 1u32, 4u32, "a trailing comma in an array");
  refused("{\"a\" 1}", 1u32, 6u32, "a missing colon");
  refused("tru", 1u32, 1u32, "a truncated literal");
  refused("\"abc", 1u32, 5u32, "an unterminated string");
  refused("\"a\nb\"", 1u32, 3u32, "a raw newline in a string");
  refused("[1] x", 1u32, 5u32, "text after the value");
  refused("{\n  \"a\": ?\n}", 2u32, 8u32, "an unknown character, on line 2");
  refused("\"\\ud800\"", 1u32, 8u32, "a lone high surrogate");
  refused("\"\\x\"", 1u32, 4u32, "a bad escape");
  refused("", 1u32, 1u32, "an empty text");
  // Nesting too deep is an error, not a crash
  var deep = String.empty();
  var n = 0;
  while n < 300 { deep.append("["); n += 1; }
  match parseJson(deep.view()) {
    case let ok Ok { expect(false, "300 levels deep"); }
    case let e Error { expect(e.reason.contains("deeply"), "300 levels deep is refused"); }
  }
  done()
}
