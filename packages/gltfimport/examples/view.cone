// view: load a glTF and render it to a picture. The model is
//
//   congo run packages/gltfimport/examples/view.cone                     (a model it makes)
//   congo run packages/gltfimport/examples/view.cone -- model.glb        (your own .gltf or .glb)
//   congo run packages/gltfimport/examples/view.cone -- --out shot.png --size 1024
//
// With no model it writes its own: a .glb of a ground, a pedestal and four
// things on it, built here byte by byte from mesh's generators (positions,
// normals, uvs, 16-bit indices), with five materials and two images (a
// checkerboard PNG made by imagedecode's own writer, and a JPEG read from
// imagedecode's test data, 'tests/data/b420.jpg', or the file named by
// '--jpeg'); then loads the file it wrote, as any program would load a model:
//
//   ground          a plane with the checkerboard as its base colour
//   gold sphere     metallic 1, roughness 0.25
//   crate           the JPEG as base colour, through a KHR_texture_transform
//                   (scale 0.5, offset (0.25, 0.25): a magnified middle),
//                   which this example bakes into the uvs
//   glass cube      alpha blend, roughness 0.05
//   bulb            black with an emissive colour and KHR_materials_emissive_strength 8,
//                   which glows under bloom
//
// The nodes are a hierarchy (the pedestal holds the four, which are
// translated, rotated and scaled within it). The renderer here is render's
// PBR path: each glTF material becomes a PbrMaterial, each image a texture
// (sRGB for colour, linear for the rest), each node with a mesh a draw, the
// frame lit by the dusk sky and its image-based lighting, then bloomed and
// tone mapped. No window is opened: the frame is drawn into a texture, read
// back, and written as a PNG by imagedecode's encoder.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.lib on LIB to link (Congo
// copies SDL3.dll beside it); GPU_POWER_PREFERENCE=low-power picks an
// integrated GPU where there are two. Exit status 0 if the picture shows the
// ground, the sphere and the emissive bulb where they should be.

mod view;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import imagedecode use *;
import gltfimport use *;
import gpu use *;
import render use *;
import fs;
import path use Path;

// ---- a glb writer ----

struct Bin {
  pub b: List[u8];

  pub fn putU8(self: &mut, v: u8) { b.push(v); }
  pub fn putU16(self: &mut, v: u32) { b.push(u8.from(v & 255u32)); b.push(u8.from((v >> 8u32) & 255u32)); }
  pub fn putU32(self: &mut, v: u32) { self.putU16(v & 0xFFFFu32); self.putU16(v >> 16u32); }
  pub fn putF32(self: &mut, v: f32) { self.putU32(v as u32); }
  pub fn align4(self: &mut) { while b.len() % 4usize != 0usize { b.push(0u8); } }
}

struct Glb {
  pub bin: Bin;
  pub views: String;
  pub nviews: usize;
  pub accessors: String;
  pub naccessors: usize;
}

// The bytes since 'start' as the next buffer view: its number
fn endView(g: &mut Glb, start: usize) usize {
  if g.nviews > 0usize { g.views.append(","); }
  g.views.append("{\"buffer\":0,\"byteOffset\":");
  g.views.appendInt(i64.from(start));
  g.views.append(",\"byteLength\":");
  g.views.appendInt(i64.from(g.bin.b.len() - start));
  g.views.append("}");
  g.bin.align4();
  g.nviews += 1usize;
  g.nviews - 1usize
}

fn addAccessor(g: &mut Glb, view: usize, ctype: i32, count: usize, tname: &str, extra: &str) usize {
  if g.naccessors > 0usize { g.accessors.append(","); }
  g.accessors.append("{\"bufferView\":");
  g.accessors.appendInt(i64.from(view));
  g.accessors.append(",\"componentType\":");
  g.accessors.appendInt(i64.from(ctype));
  g.accessors.append(",\"count\":");
  g.accessors.appendInt(i64.from(count));
  g.accessors.append(",\"type\":\"");
  g.accessors.append(tname);
  g.accessors.append("\"");
  g.accessors.append(extra);
  g.accessors.append("}");
  g.naccessors += 1usize;
  g.naccessors - 1usize
}

// A mesh's attributes and indices into the buffer: the JSON of its primitive
// (for material 'material')
fn addPrimitive(g: &mut Glb, m: &Mesh, material: i32) String {
  let n = m.positions.len();
  var s = g.bin.b.len();
  var min = *m.positions[0usize];
  var max = *m.positions[0usize];
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    g.bin.putF32(p.x); g.bin.putF32(p.y); g.bin.putF32(p.z);
    if p.x < min.x { min.x = p.x; } if p.y < min.y { min.y = p.y; } if p.z < min.z { min.z = p.z; }
    if p.x > max.x { max.x = p.x; } if p.y > max.y { max.y = p.y; } if p.z > max.z { max.z = p.z; }
    i += 1usize;
  }
  let pa = addAccessor(g, endView(g, s), 5126, n, "VEC3", "");
  s = g.bin.b.len();
  i = 0usize;
  while i < n { let v = *m.normals[i]; g.bin.putF32(v.x); g.bin.putF32(v.y); g.bin.putF32(v.z); i += 1usize; }
  let na = addAccessor(g, endView(g, s), 5126, n, "VEC3", "");
  s = g.bin.b.len();
  // glTF's v runs down the image: mesh's uv v is up, so it is written as 1 - v
  i = 0usize;
  while i < n { let v = *m.uvs[i]; g.bin.putF32(v.x); g.bin.putF32(1. - v.y); i += 1usize; }
  let ta = addAccessor(g, endView(g, s), 5126, n, "VEC2", "");
  s = g.bin.b.len();
  i = 0usize;
  while i < m.indices.len() { g.bin.putU16(*m.indices[i]); i += 1usize; }
  let ia = addAccessor(g, endView(g, s), 5123, m.indices.len(), "SCALAR", "");
  var j = String.from("{\"attributes\":{\"POSITION\":");
  j.appendInt(i64.from(pa));
  j.append(",\"NORMAL\":");
  j.appendInt(i64.from(na));
  j.append(",\"TEXCOORD_0\":");
  j.appendInt(i64.from(ta));
  j.append("},\"indices\":");
  j.appendInt(i64.from(ia));
  j.append(",\"material\":");
  j.appendInt(i64.from(material));
  j.append("}");
  j
}

// An image's bytes as a buffer view: its number
fn addBlob(g: &mut Glb, d: &Array[u8]) usize {
  let s = g.bin.b.len();
  var i = 0usize;
  while i < d.len { g.bin.putU8(d[i]); i += 1usize; }
  endView(g, s)
}

fn checkerPng() List[u8] {
  // 64 x 64 squares of 8, a warm and a cool grey, a faint grid line
  var o = PngWrite.make(2u8, 8u8);
  o.srgb = true;
  var samples = List[u16].empty();
  var y = 0;
  while y < 64 {
    var x = 0;
    while x < 64 {
      let odd = ((x / 8) + (y / 8)) % 2 == 1;
      let edge = x % 8 == 0 || y % 8 == 0;
      var r = if odd {150u16} else {205u16};
      var g = if odd {155u16} else {200u16};
      var b = if odd {170u16} else {190u16};
      if edge { r = r - 25u16; g = g - 25u16; b = b - 25u16; }
      samples.push(r); samples.push(g); samples.push(b);
      x += 1;
    }
    y += 1;
  }
  encodePngSamples(64, 64, samples.view(), &o)
}

fn readBytes(path: &str) List[u8] {
  var out = List[u8].empty();
  let p = Path.from(path);
  match fs.readFile(&p) {
    case var Ok(ok) {
      var s = String.empty();
      s <=> ok;
      var i = 0usize;
      while i < s.len() { out.push(s[i]); i += 1usize; }
    }
    case let Error(e) { }
  }
  out
}

// The demo model as a .glb file's bytes
fn demoGlb(jpegPath: &str) List[u8] {
  var g = Glb(Bin(List[u8].empty()), String.empty(), 0usize, String.empty(), 0usize);
  let ground = Mesh.plane(1, 5.);
  let sphere = Mesh.sphere(1., 40);
  let cube = Mesh.cube(1.);
  var meshes = String.from("[");
  meshes.append("{\"name\":\"ground\",\"primitives\":[");
  meshes.append(addPrimitive(&mut g, &ground, 0).view());
  meshes.append("]},{\"name\":\"sphere\",\"primitives\":[");
  meshes.append(addPrimitive(&mut g, &sphere, 1).view());
  meshes.append("]},{\"name\":\"crate\",\"primitives\":[");
  meshes.append(addPrimitive(&mut g, &cube, 2).view());
  meshes.append("]},{\"name\":\"glass\",\"primitives\":[");
  meshes.append(addPrimitive(&mut g, &cube, 3).view());
  meshes.append("]},{\"name\":\"bulb\",\"primitives\":[");
  meshes.append(addPrimitive(&mut g, &sphere, 4).view());
  meshes.append("]}]");
  let png = checkerPng();
  let pngView = addBlob(&mut g, png.view());
  let jpeg = readBytes(jpegPath);
  var images = String.from("[{\"name\":\"checker\",\"bufferView\":");
  images.appendInt(i64.from(pngView));
  images.append(",\"mimeType\":\"image/png\"}");
  if jpeg.len() > 0usize {
    images.append(",{\"name\":\"picture\",\"bufferView\":");
    images.appendInt(i64.from(addBlob(&mut g, jpeg.view())));
    images.append(",\"mimeType\":\"image/jpeg\"}");
  }
  images.append("]");

  var j = String.from("{\"asset\":{\"version\":\"2.0\",\"generator\":\"gltfimport example\"},");
  j.append("\"extensionsUsed\":[\"KHR_texture_transform\",\"KHR_materials_emissive_strength\"],");
  j.append("\"scene\":0,\"scenes\":[{\"nodes\":[0,1]}],");
  j.append("\"nodes\":[{\"name\":\"ground\",\"mesh\":0,\"scale\":[6,1,6]},");
  j.append("{\"name\":\"pedestal\",\"translation\":[0,0.3,0],\"children\":[2,3,4,5]},");
  j.append("{\"name\":\"sphere\",\"mesh\":1,\"translation\":[-1.9,0.65,0.3],\"scale\":[0.65,0.65,0.65]},");
  j.append("{\"name\":\"crate\",\"mesh\":2,\"translation\":[0,0.6,0],\"rotation\":[0,0.2164396,0,0.9762960],\"scale\":[0.6,0.6,0.6]},");
  j.append("{\"name\":\"glass\",\"mesh\":3,\"translation\":[1.8,0.55,0.2],\"rotation\":[0,0.3826834,0,0.9238795],\"scale\":[0.55,0.55,0.55]},");
  j.append("{\"name\":\"bulb\",\"mesh\":4,\"translation\":[0.1,1.55,-0.4],\"scale\":[0.18,0.18,0.18]}],");
  j.append("\"meshes\":");
  j.append(meshes.view());
  j.append(",\"images\":");
  j.append(images.view());
  j.append(",\"samplers\":[{\"magFilter\":9729,\"minFilter\":9987,\"wrapS\":10497,\"wrapT\":10497}],");
  j.append("\"textures\":[{\"source\":0,\"sampler\":0},{\"source\":");
  j.append(if jpeg.len() > 0usize {"1"} else {"0"});
  j.append(",\"sampler\":0}],");
  j.append("\"materials\":[");
  j.append("{\"name\":\"ground\",\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":0,\"extensions\":{\"KHR_texture_transform\":{\"scale\":[3,3]}}},\"metallicFactor\":0,\"roughnessFactor\":0.85}},");
  j.append("{\"name\":\"gold\",\"pbrMetallicRoughness\":{\"baseColorFactor\":[1.0,0.766,0.336,1],\"metallicFactor\":1,\"roughnessFactor\":0.25}},");
  j.append("{\"name\":\"crate\",\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":1,\"extensions\":{\"KHR_texture_transform\":{\"scale\":[0.5,0.5],\"offset\":[0.25,0.25]}}},\"metallicFactor\":0,\"roughnessFactor\":0.6}},");
  j.append("{\"name\":\"glass\",\"alphaMode\":\"BLEND\",\"pbrMetallicRoughness\":{\"baseColorFactor\":[0.2,0.6,1,0.35],\"metallicFactor\":0,\"roughnessFactor\":0.05}},");
  j.append("{\"name\":\"bulb\",\"emissiveFactor\":[1,0.4,0.1],\"pbrMetallicRoughness\":{\"baseColorFactor\":[0.02,0.02,0.02,1],\"metallicFactor\":0,\"roughnessFactor\":0.5},");
  j.append("\"extensions\":{\"KHR_materials_emissive_strength\":{\"emissiveStrength\":8}}}],");
  j.append("\"buffers\":[{\"byteLength\":");
  j.appendInt(i64.from(g.bin.b.len()));
  j.append("}],\"bufferViews\":[");
  j.append(g.views.view());
  j.append("],\"accessors\":[");
  j.append(g.accessors.view());
  j.append("]}");
  while j.len() % 4usize != 0usize { j.appendByte(' '); }
  // The container: header, JSON chunk, BIN chunk
  var out = Bin(List[u8].empty());
  out.putU32(0x46546C67u32);
  out.putU32(2u32);
  out.putU32(u32.from(12usize + 8usize + j.len() + 8usize + g.bin.b.len()));
  out.putU32(u32.from(j.len()));
  out.putU32(0x4E4F534Au32);
  var i = 0usize;
  while i < j.len() { out.putU8(j[i]); i += 1usize; }
  out.putU32(u32.from(g.bin.b.len()));
  out.putU32(0x004E4942u32);
  i = 0usize;
  while i < g.bin.b.len() { out.putU8(*g.bin.b[i]); i += 1usize; }
  var res = List[u8].empty();
  res <=> out.b;
  res
}

// ---- from a Gltf to the renderer ----

// A render Image of a decoded picture (rows bottom first)
fn toImage(r: &Raster) Image {
  Image(r.width, r.height, 4, r.bottomUp(4))
}

fn color3(c: Color, k: f32) Color { Color(c.red * k, c.green * k, c.blue * k, c.alpha) }

fn cstrEquals(a: *u8, b: &str) bool {
  var i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8
}

fn argString(p: *u8) String {
  var s = String.empty();
  var i = 0usize;
  while *(p + i) != 0u8 { s.appendByte(*(p + i)); i = i + 1usize; }
  s
}

fn main(argc: i32, argv: **u8) i32 {
  var modelPath = String.empty();
  var outPath = String.from("gltfview.png");
  var jpegPath = String.from("packages/imagedecode/tests/data/b420.jpg");
  var size = 768;
  var a = 1;
  while a < argc {
    let arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--out") && a + 1 < argc { outPath = argString(*(argv + usize.from(a + 1))); a += 1; }
    elif cstrEquals(arg, "--jpeg") && a + 1 < argc { jpegPath = argString(*(argv + usize.from(a + 1))); a += 1; }
    elif cstrEquals(arg, "--size") && a + 1 < argc {
      size = 0;
      let s = *(argv + usize.from(a + 1));
      var i = 0usize;
      while *(s + i) != 0u8 { size = size * 10 + i32.from(*(s + i) - '0'); i += 1usize; }
      a += 1;
    } else { modelPath = argString(arg); }
    a += 1;
  }

  // The model: a file named, or the one made here and written beside the picture
  var gltf = Gltf.empty();
  var loadedFrom = String.empty();
  if modelPath.len() == 0usize {
    let bytes = demoGlb(jpegPath.view());
    modelPath = String.from("gltfview-demo.glb");
    let wp = Path.from(modelPath.view());
    fs.writeFile(&wp, bytes.view());
    printStr("Wrote the demo model: "); printStr(modelPath.view()); printStr(" ("); print <- bytes.len(); printStr(" bytes)\n");
  }
  match loadGltf(&Path.from(modelPath.view()), true) {
    case var Ok(ok) { gltf <=> ok; }
    case let Error(e) { printStr("Could not load: "); printStr(e.reason.view()); printStr("\n"); return 1; }
  }
  printStr("Loaded "); printStr(modelPath.view()); printStr(": ");
  print <- gltf.nodes.len(); printStr(" nodes, "); print <- gltf.meshes.len(); printStr(" meshes, ");
  print <- gltf.materials.len(); printStr(" materials, "); print <- gltf.images.len(); printStr(" images");
  printStr("\n");
  var w = 0usize;
  while w < gltf.warnings.len() { printStr("  warning: "); printStr(gltf.warnings[w].view()); printStr("\n"); w += 1usize; }
  var im = 0usize;
  while im < gltf.images.len() {
    printStr("  image "); print <- im; printStr(": ");
    if gltf.images[im].raster.isEmpty() { printStr("not decoded "); printStr(gltf.images[im].error.view()); }
    else {
      print <- gltf.images[im].raster.width; printStr(" x "); print <- gltf.images[im].raster.height;
      printStr(if gltf.images[im].raster.depth == 16 {", 16-bit"} else {", 8-bit"});
    }
    printStr("\n");
    im += 1usize;
  }

  // The GPU, with no window
  var instance = Instance.create("gltf view");
  if !instance.isValid() { printStr("No Vulkan 1.3 instance\n"); return 1; }
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let powerEnv = libc.getenv("GPU_POWER_PREFERENCE");
  if (powerEnv as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(powerEnv), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() { printStr("No GPU\n"); return 1; }
  printStr("Adapter: "); printStr(adapter.name.view()); printStr("\n");
  var device = adapter.requestDevice();
  let sz = u32.from(size);
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, sz, sz);
  if !renderer.isValid() || !post.isValid() { printStr("The renderer could not be made\n"); return 1; }
  let targetDesc = TextureDescriptor(sz, sz, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var target = device.createTexture(&targetDesc);
  let depthDesc = TextureDescriptor(sz, sz, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  var depth = device.createTexture(&depthDesc);

  // Textures: one per use, colour in sRGB and the rest linear
  var colorTex = List[TextureHandle].empty();     // by glTF texture
  var linearTex = List[TextureHandle].empty();
  var normalTex = List[TextureHandle].empty();
  var t = 0usize;
  while t < gltf.textures.len() {
    let src = gltf.textures[t].source;
    if src >= 0i32 && !gltf.images[usize.from(src)].raster.isEmpty() {
      let img = toImage(&gltf.images[usize.from(src)].raster);
      colorTex.push(renderer.addTexture(&mut device, &img));
      linearTex.push(renderer.addLinearTexture(&mut device, &img));
      normalTex.push(renderer.addNormalTexture(&mut device, &img));
    } else {
      colorTex.push(TextureHandle.none());
      linearTex.push(TextureHandle.none());
      normalTex.push(TextureHandle.none());
    }
    t += 1usize;
  }
  // Materials: glTF's into render's PbrMaterial, and meshes (one per
  // primitive) with the base colour's texture transform baked into the uvs
  var materialHandles = List[MaterialHandle].empty();
  var m = 0usize;
  while m < gltf.materials.len() {
    let gm = gltf.materials[m];
    var pm = PbrMaterial.standard(gm.baseColor, gm.metallic, gm.roughness);
    if gm.baseColorTexture.texture >= 0i32 { pm.texture = *colorTex[usize.from(gm.baseColorTexture.texture)]; }
    if gm.metallicRoughnessTexture.texture >= 0i32 { pm.metallicRoughnessTexture = *linearTex[usize.from(gm.metallicRoughnessTexture.texture)]; }
    if gm.normalTexture.texture >= 0i32 { pm.normalTexture = *normalTex[usize.from(gm.normalTexture.texture)]; pm.normalScale = gm.normalScale; }
    if gm.occlusionTexture.texture >= 0i32 { pm.occlusionTexture = *linearTex[usize.from(gm.occlusionTexture.texture)]; pm.occlusionStrength = gm.occlusionStrength; }
    pm.emissive = gm.emissive;
    pm.emissiveStrength = gm.emissiveStrength;
    pm.alphaMode = gm.alphaMode;
    pm.alphaCutoff = gm.alphaCutoff;
    materialHandles.push(renderer.addPbrMaterial(&mut device, &pm));
    m += 1usize;
  }
  // The default material (glTF's: white, metallic, rough) for primitives with none
  let defaultMaterial = renderer.addPbrMaterial(&mut device, &PbrMaterial.standard(Color(1., 1., 1., 1.), 1., 1.));
  var meshHandles = List[List[MeshHandle]].empty();    // by glTF mesh, a handle per primitive
  var gi = 0usize;
  while gi < gltf.meshes.len() {
    var hs = List[MeshHandle].empty();
    var p = 0usize;
    while p < gltf.meshes[gi].primitives.len() {
      var copy = copyMesh(&gltf.meshes[gi].primitives[p].mesh);
      let mat = gltf.meshes[gi].primitives[p].material;
      if mat >= 0i32 { bakeTextureTransform(&mut copy, &gltf.materials[usize.from(mat)].baseColorTexture); }
      hs.push(renderer.addMesh(&mut device, &copy));
      p += 1usize;
    }
    meshHandles.push(hs);
    gi += 1usize;
  }

  // The sky and the sun
  let sky = Sky.dusk(radians(24.), radians(35.));
  renderer.setSky(&mut device, &sky);
  let light = sky.sunLight(Color(2.6, 1.6, 0.9, 1.), Color(0.08, 0.09, 0.12, 1.));
  var camera = Camera.make();
  camera.fov = radians(46.);
  camera.near = 0.2;
  camera.far = 100.;
  camera.background = Color(0., 0., 0., 1.);
  camera.lookAt(Vec3(0.3, 2.4, 7.2), Vec3(0., 0.7, 0.), Vec3(0., 1., 0.));
  post.bloom = 0.05;

  // Draw every node that has a mesh
  var list = DrawList.empty();
  let instances = meshInstances(&gltf);
  var draws = 0usize;
  var k = 0usize;
  while k < instances.len() {
    let mi = instances[k];
    var p = 0usize;
    while p < gltf.meshes[mi.mesh].primitives.len() {
      let mat = gltf.meshes[mi.mesh].primitives[p].material;
      list.add(*meshHandles[mi.mesh][p], if mat >= 0i32 {*materialHandles[usize.from(mat)]} else {defaultMaterial}, mi.world);
      draws += 1usize;
      p += 1usize;
    }
    k += 1usize;
  }
  printStr("Drawing "); print <- draws; printStr(" primitives\n");

  // Two frames (the first makes the environment), the second read back
  var readback = device.createBuffer(u64.from(sz) * u64.from(sz) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var f = 0;
  while f < 2 {
    renderer.time = 0.;
    var encoder = device.createCommandEncoder();
    renderer.render(&mut device, &mut encoder, &post.hdr, &depth, &camera, &light, &list);
    post.apply(&mut encoder, &target);
    if f == 1 { encoder.copyTextureToBuffer(&target, &readback); }
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    f += 1;
  }
  let px = readback.mappedRange();
  printStr("Frame: "); print <- u64.from(renderer.drawCalls); printStr(" draws, "); print <- renderer.triangles; printStr(" triangles\n");

  // The picture as a Raster, top row first, written as a PNG
  var shot = Raster.empty();
  shot.width = size;
  shot.height = size;
  shot.depth = 8;
  shot.colorSpace = ColorSpace.Srgb;
  shot.pixels8.resize(usize.from(size) * usize.from(size) * 4usize, 255u8);
  var y = 0usize;
  while y < usize.from(size) {
    var x = 0usize;
    while x < usize.from(size) {
      let s = (y * usize.from(size) + x) * 4usize;
      shot.pixels8.set(s, *(px + s));
      shot.pixels8.set(s + 1usize, *(px + s + 1usize));
      shot.pixels8.set(s + 2usize, *(px + s + 2usize));
      x += 1usize;
    }
    y += 1usize;
  }
  let png = encodePng(&shot, 2);
  let op = Path.from(outPath.view());
  fs.writeFile(&op, png.view());
  printStr("Wrote "); printStr(outPath.view()); printStr(" ("); print <- png.len(); printStr(" bytes)\n");

  // A check, for the demo: the ground is lit and is not the sky; the bulb glows
  // (it is the brightest red in the frame, near the top of the pedestal)
  var maxRed = 0i32;
  var lit = 0usize;
  var i = 0usize;
  while i < usize.from(size) * usize.from(size) {
    let r = i32.from(*(px + i * 4usize));
    if r > maxRed { maxRed = r; }
    if r > 20 { lit += 1usize; }
    i += 1usize;
  }
  printStr("Brightest red "); print <- maxRed; printStr(", pixels not dark "); print <- lit; printStr("\n");
  printStr("Vulkan failures: "); print <- u64.from(failures()); printStr("; validation messages: "); print <- u64.from(validationMessages()); printStr("\n");
  if lit < usize.from(size) * usize.from(size) / 4usize || maxRed < 200 { printStr("FAILED: the picture is mostly dark\n"); return 1; }
  if failures() != 0u32 || validationMessages() != 0u32 { return 1; }
  printStr("OK\n");
  0
}
