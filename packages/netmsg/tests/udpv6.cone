// A server and a client over IPv6 loopback ([::1]): the handshake runs and
// both ends hear Joined. (The client binds ::1, the server's
// loopback.)

mod udpv6;

import testing use *;
import collections use *;
import sync use *;
import time use Duration;
import iocore use SocketAddr;
import actors;
import netmsg use *;

fn main() i32 {
  var txS Sender[NetEvent];
  var rxS Receiver[NetEvent];
  txS, rxS = Channel[NetEvent].make();
  var txC Sender[NetEvent];
  var rxC Receiver[NetEvent];
  txC, rxC = Channel[NetEvent].make();
  {
    let cfg = NetConfig.defaults();
    let server = mustListen(SocketAddr.v6Localhost(0u16), cfg, channelHandler(txS));
    let client = mustConnect(SocketAddr.v6Localhost(server.port), cfg, channelHandler(txC));
    var gotS = false;
    var gotC = false;
    match rxS.recvTimeout(Duration.fromSeconds(3i64)) {
      case let e Some { gotS = true; }
      case is None[NetEvent] {}
    }
    match rxC.recvTimeout(Duration.fromSeconds(3i64)) {
      case let e Some { gotC = true; }
      case is None[NetEvent] {}
    }
    expect(gotS and gotC, "joined over IPv6 loopback");
    client.endpoint.shutdown();
    server.endpoint.shutdown();
  }
  done();
}
