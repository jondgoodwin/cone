// Sequence numbers and message ids are 16 bits and wrap: a connection sending
// a packet a millisecond for 70 seconds, with a reliable message in each and a
// value on a latest-wins stream, passes both 65536 more than once. Over a link
// that loses 10% and reorders some. Every message arrives once, in order; the
// values never go backwards; the acknowledgements keep working across the wrap
// (nothing is left waiting, the loss measure stays near the link's).

mod wrap;

import testing use *;
import collections use *;
import time use Duration, Instant, Clock;
import netmsg use *;

struct Heard {
  pub next u64;          // the message due next
  pub wrong u64;
  pub lastValue u64;
  pub values u64;
  pub backwards u64;
}

fn numberOf(data &Array[u8]) u64 {
  var n = 0u64;
  var i = 0usize;
  while i < data.len {
    n = (n << 8u64) | u64.from(data[i]);
    i = i + 1usize;
  }
  n
}

fn numberBytes(n u64) List[u8] {
  var b = List[u8].empty();
  putU32(&mut b, u32.from(n));
  b
}

fn absorb(evs &mut List[CoreEvent], h &mut Heard) {
  each e in evs.drain() {
    match e {
      case let r Reliable {
        if numberOf(r.data.view()) != h.next {h.wrong = h.wrong + 1u64;}
        h.next = h.next + 1u64;
      }
      case let l Latest {
        let v = numberOf(l.data.view());
        if h.values > 0u64 and v <= h.lastValue {h.backwards = h.backwards + 1u64;}
        h.lastValue = v;
        h.values = h.values + 1u64;
      }
      case let c Closed {}
    }
  }
}

fn main() i32 {
  var cfg = NetConfig.defaults();
  cfg.goodRate = 1000u32;
  cfg.resendMinMs = 10i64;
  var clock = Clock.synth();
  let link = new LinkConfig(100u32, 5i64, 3i64, 20u32, 20u32, 8i64);
  var p = SimPair.make(cfg, link, link, 77u64, clock.now());
  var hb = new Heard(0u64, 0u64, 0u64, 0u64, 0u64);
  var ha = new Heard(0u64, 0u64, 0u64, 0u64, 0u64);
  var sent = 0u64;
  var refused = 0u64;
  var ms = 0i64;
  while ms < 70000i64 {
    clock.advance(Duration.fromMillis(1i64));
    ms = ms + 1i64;
    if p.a.sendReliable(numberBytes(sent).view()) {sent = sent + 1u64;} else {refused = refused + 1u64;}
    p.a.sendLatest(4u16, numberBytes(u64.from(ms)).view());
    p.step(clock.now());
    absorb(&mut p.eventsB, &mut hb);
    absorb(&mut p.eventsA, &mut ha);
  }
  // Let the last of them land
  var tail = 0i64;
  while tail < 3000i64 {
    clock.advance(Duration.fromMillis(1i64));
    tail = tail + 1i64;
    p.step(clock.now());
    absorb(&mut p.eventsB, &mut hb);
  }
  expectUInt(refused, 0u64, "the window never filled");
  expectUInt(hb.next, sent, "every message arrived");
  expect(sent > 69000u64, "about 70,000 of them: the 16-bit message ids wrapped");
  expectUInt(hb.wrong, 0u64, "each once, in order");
  expectUInt(hb.backwards, 0u64, "latest values never went backwards");
  expect(hb.values > 45000u64, "most values arrived");
  expect(p.b.stats().latestStale > 1000u64, "and the late ones, passed by newer, were dropped as stale");
  expectUInt(hb.values, p.b.stats().latestDelivered, "the application heard what the connection counted as delivered");
  expect(p.b.stats().packetsDuplicate > 500u64, "duplicated packets arrived and were counted, not acted on twice");
  expect(p.a.stats().packetsSent > 66000u64, "more than 65536 packets went each way: the sequence wrapped");
  expectUInt(u64.from(p.a.reliablePending()), 0u64, "nothing left waiting for an acknowledgement");
  expect(p.a.lossPermille() > 40u32 and p.a.lossPermille() < 200u32, "and the loss measure is near the link's 10%");
  expect(p.a.isActive() and p.b.isActive(), "still connected");
  done()
}
