// The connection handshake, step by step on a synthetic clock: Request,
// Challenge, Response, Accept; a spoofed address that cannot finish it; a
// cookie that expires; a Request too small to answer; retries and the
// attempt that gets no answer; a refusal; and packets of another session.

mod handshake;

import testing use *;
import collections use *;
import time use Duration, Instant;
import netmsg use *;

const sec = 1000000000i64;

fn at(ms: i64) Instant {Instant.fromNanos(ms * 1000000i64)}

// The datagram a dialer sends at 'now', if any
fn dialed(d: &mut ClientHandshake, now: Instant) List[u8] {
  var out = List[List[u8]].empty();
  d.poll(now, &mut out);
  var r = List[u8].empty();
  if out.len() > 0usize {
    match out.pop() {
      case let p Some { r = p; }
      case is None[List[u8]] {}
    }
  }
  r
}

fn main() i32 {
  let cfg = NetConfig.defaults();
  let gate = ChallengeGate.make(12345u64);
  var reply = List[u8].empty();

  // The whole handshake
  var d = ClientHandshake.make(cfg, 0x1111222233334444u64, at(0i64));
  let request = dialed(&mut d, at(0i64));
  expectUInt(u64.from(request.len()), 1200u64, "a Request is padded to 1200 bytes");
  expect(d.handshakeState() == HandshakeState.Requesting, "requesting");
  expect(dialed(&mut d, at(100i64)).len() == 0usize, "nothing more before the retry time");
  let v1 = gate.handle("127.0.0.1:5000", request.view(), at(1i64), &mut reply);
  expect(v1 == GateVerdict.Reply, "the gate answers a Request");
  expectUInt(u64.from(reply.len()), 21u64, "with a 21-byte Challenge: no amplification");
  let challenge = copyBytes(reply.view());
  expect(d.receive(challenge.view()) == HandshakeEvent.Nothing, "the dialer takes the Challenge");
  expect(d.handshakeState() == HandshakeState.Responding, "and goes on to respond");
  let response = dialed(&mut d, at(2i64));
  expectUInt(u64.from(response.len()), 1200u64, "the Response is padded too");
  let v2 = gate.handle("127.0.0.1:5000", response.view(), at(3i64), &mut reply);
  var session = 0u64;
  match v2 {
    case let a Accept { session = a.session; }
    else {}
  }
  expect(session != 0u64, "the gate accepts the Response, naming the session");
  expectUInt(u64.from(reply.len()), 13u64, "in a 13-byte Accept");
  expect(d.receive(reply.view()) == HandshakeEvent.Connected, "the dialer is connected");
  expect(d.isConnected(), "connected");
  expectUInt(d.sessionId(), session, "and agrees about the session");
  var cur = PacketReader.start();
  cur.skip(challenge.view(), 13usize);
  let cookie = cur.rdU64(challenge.view());
  expectUInt(session, 0x1111222233334444u64 ^ cookie, "the session is the client's salt xor the cookie");

  // A Response with a wrong cookie, or from another address, or too late, is ignored
  var e = ClientHandshake.make(cfg, 0xAAAAu64, at(0i64));
  let req2 = dialed(&mut e, at(0i64));
  gate.handle("10.0.0.1:7000", req2.view(), at(0i64), &mut reply);
  e.receive(reply.view());
  let resp2 = dialed(&mut e, at(1i64));
  expect(gate.handle("10.0.0.2:7000", resp2.view(), at(2i64), &mut reply) == GateVerdict.Ignore, "a Response from another address is ignored: the cookie is for the first");
  expect(gate.handle("10.0.0.1:7001", resp2.view(), at(2i64), &mut reply) == GateVerdict.Ignore, "so is one from another port");
  var forged = copyBytes(resp2.view());
  forged.set(20usize, 0u8);
  forged.set(19usize, 1u8);
  expect(gate.handle("10.0.0.1:7000", forged.view(), at(2i64), &mut reply) == GateVerdict.Ignore, "a forged cookie is ignored");
  expect(gate.handle("10.0.0.1:7000", resp2.view(), at(5000i64), &mut reply) != GateVerdict.Ignore, "the right one, 5 s later, is accepted");
  expect(gate.handle("10.0.0.1:7000", resp2.view(), at(25000i64), &mut reply) == GateVerdict.Ignore, "but not 25 s later: the cookie has expired");

  // A Request too small to be worth answering
  var small = copyBytes(req2.view());
  small.truncate(1199usize);
  expect(gate.handle("10.0.0.1:7000", small.view(), at(0i64), &mut reply) == GateVerdict.Ignore, "a short Request is ignored");
  expectUInt(u64.from(reply.len()), 0u64, "and nothing is sent");
  var junk = List[u8].empty();
  putZeros(&mut junk, 1200usize);
  expect(gate.handle("10.0.0.1:7000", junk.view(), at(0i64), &mut reply) == GateVerdict.Ignore, "garbage is ignored");

  // A client that gets no answer: Requests repeat every 250 ms, then it fails
  var f = ClientHandshake.make(cfg, 0x42u64, at(0i64));
  var sent = 0u32;
  var t = 0i64;
  while t < 5000i64 {
    if dialed(&mut f, at(t)).len() > 0usize {sent = sent + 1u32;}
    t = t + 10i64;
  }
  expectUInt(u64.from(sent), 20u64, "20 Requests in 5 s");
  dialed(&mut f, at(5000i64));
  expect(f.isFailed(), "and the attempt fails");
  expect(!f.wasRefused(), "unanswered, not refused");

  // A refusal
  var g = ClientHandshake.make(cfg, 0x77u64, at(0i64));
  dialed(&mut g, at(0i64));
  gate.handle("1.2.3.4:5", request.view(), at(0i64), &mut reply);
  var salt7 = ClientHandshake.make(cfg, 0x77u64, at(0i64));
  let rq = dialed(&mut salt7, at(0i64));
  gate.handle("1.2.3.4:5", rq.view(), at(0i64), &mut reply);
  g.receive(reply.view());
  let rs = dialed(&mut g, at(1i64));
  let denied = ChallengeGate.denied(ChallengeGate.saltOf(rs.view()));
  expect(g.receive(denied.view()) == HandshakeEvent.Refused, "a Denied refuses it");
  expect(g.isFailed() && g.wasRefused(), "failed, refused");

  // Packets of another session are not a connection's
  var a = ConnectionCore.make(cfg, 0xABCDu64, at(0i64));
  var b = ConnectionCore.make(cfg, 0xABCEu64, at(0i64));
  a.sendReliable("hi");
  var pk = List[List[u8]].empty();
  var evs = List[CoreEvent].empty();
  a.poll(at(10i64), &mut pk, &mut evs);
  expectUInt(u64.from(pk.len()), 1u64, "a sends a packet");
  expect(!b.receive(pk[0usize].view(), at(11i64), &mut evs), "b, of another session, refuses it");
  expectUInt(u64.from(evs.len()), 0u64, "and hears nothing");
  expectUInt(b.stats().packetsInvalid, 1u64, "counted as invalid");
  done()
}
