// The in-process pair with the simulated link in its path: the real protocol
// between two actors in one process, no socket. The link loses 20% of the
// packets each way and delays them 30 ms plus up to 20 ms. Every reliable
// message still arrives once and in order, each takes at least the link's
// delay, and the values arrive in increasing order.

mod simulated;

import testing use *;
import collections use *;
import sync use *;
import time use Duration, Instant;
import actors;
import netmsg use *;

fn numberOf(data &Array[u8]) u64 {
  var n = 0u64;
  var i = 0usize;
  while i < data.len {
    n = (n << 8u64) | u64.from(data[i]);
    i = i + 1usize;
  }
  n
}

fn big(n usize) List[u8] {
  var b = List[u8].empty();
  var i = 0usize;
  while i < n {
    b.push(7u8);
    i = i + 1usize;
  }
  b
}

fn numberBytes(n u64) List[u8] {
  var b = List[u8].empty();
  putU32(&mut b, u32.from(n));
  b
}

struct Tally {
  pub next u64;
  pub wrong u64;
  pub lastValue u64;
  pub values u64;
  pub backwards u64;
  pub left u64;
  pub firstAt Instant;
  pub refused u64;
  pub refusedWrong u64;
}

fn note(e &NetEvent, t &mut Tally, joined &mut List[Connection]) {
  match e {
    case let j &Joined { joined.push(j.conn); }
    case let m &Message {
      if t.next == 0u64 {t.firstAt = Instant.now();}
      if numberOf(m.data.view()) != t.next {t.wrong = t.wrong + 1u64;}
      t.next = t.next + 1u64;
    }
    case let u &Update {
      let v = numberOf(u.data.view());
      if t.values > 0u64 && v <= t.lastValue {t.backwards = t.backwards + 1u64;}
      t.lastValue = v;
      t.values = t.values + 1u64;
    }
    case let l &Left { t.left = t.left + 1u64; }
    case let r &Refused {
      // Only the oversize message and value this test offers are refused, with the limits the default packet gives
      if r.limit == (if r.reliable {1173usize} else {1171usize}) && r.size == r.limit + 1usize {t.refused = t.refused + 1u64;}
      else {t.refusedWrong = t.refusedWrong + 1u64;}
    }
  }
}

fn main() i32 {
  var txA Sender[NetEvent];
  var rxA Receiver[NetEvent];
  txA, rxA = Channel[NetEvent].make();
  var txB Sender[NetEvent];
  var rxB Receiver[NetEvent];
  txB, rxB = Channel[NetEvent].make();
  {
    let link = new LinkConfig(200u32, 30i64, 20i64, 20u32, 20u32, 40i64);
    var pair = pairSimulated(NetConfig.defaults(), link, link, 11u64, channelHandler(txA), 1u32, channelHandler(txB), 1u32);
    var ta = new Tally(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, Instant.now(), 0u64, 0u64);
    var tb = new Tally(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, Instant.now(), 0u64, 0u64);
    var ca = List[Connection].empty();
    var cb = List[Connection].empty();
    let started = Instant.now();
    var sent = false;
    var tick = 0u64;
    let until = started + Duration.fromSeconds(60i64);
    var settle = until;
    var all = false;
    while Instant.now() < settle {
      match rxA.recvTimeout(Duration.fromMillis(3i64)) {
        case let e Some { note(&e, &mut ta, &mut ca); }
        case is None[NetEvent] {}
      }
      match rxB.tryRecv() {
        case let e Some { note(&e, &mut tb, &mut cb); }
        case is None[NetEvent] {}
      }
      if ca.len() == 1usize && cb.len() == 1usize {
        if !sent {
          sent = true;
          var i = 0u64;
          while i < 100u64 {
            ca[0usize].sendReliable(numberBytes(i));
            cb[0usize].sendReliable(numberBytes(i));
            i = i + 1u64;
          }
          // One message over a packet from a, one value from b: refused, not sent, no panic
          ca[0usize].sendReliable(big(1174usize));
          cb[0usize].sendLatest(1u16, big(1172usize));
        }
        tick = tick + 1u64;
        ca[0usize].sendLatest(1u16, numberBytes(tick));
        cb[0usize].sendLatest(1u16, numberBytes(tick));
      }
      if !all && ta.next == 100u64 && tb.next == 100u64 {
        all = true;
        settle = Instant.now() + Duration.fromMillis(800i64);
      }
    }
    expect(all, "all 100 messages arrived both ways inside a minute");
    expectUInt(ta.wrong + tb.wrong, 0u64, "each once, in order");
    expectUInt(ta.backwards + tb.backwards, 0u64, "values never went backwards");
    expect(ta.values > 0u64 && tb.values > 0u64, "values arrived");
    expect((tb.firstAt - started).millis() >= 30i64, "the first message took at least the link's delay");
    expectUInt(ta.left + tb.left, 0u64, "still connected");
    expectUInt(ta.refused, 1u64, "a's message over one packet was refused, and a heard so");
    expectUInt(tb.refused, 1u64, "b's value over one packet likewise");
    expectUInt(ta.refusedWrong + tb.refusedWrong, 0u64, "with the sizes and limits of the default packet");
    pair.stop();
    pair.a.close();
  }
  done()
}
