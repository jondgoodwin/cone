// netmsg.scratchSizes: the sizes of one connection's working storage, as netbench prints them. The line names
// each piece in order and ends in a newline; Bytes is an Arc and two usizes, 24 bytes on a 64-bit target.

mod sizes;

import testing use *;
import netmsg use *;

fn main() i32 {
  let s = scratchSizes();
  let v = s.view();
  expect(v.startsWith("SentSlot="), "begins with the first piece");
  expect(v.contains(" RelSlot="), "names the reliable ring's slot");
  expect(v.contains(" StreamOut="), "names a stream's out state");
  expect(v.contains(" ConnectionCore="), "names the core");
  expect(v.contains(" Connection="), "names the actor's state");
  expect(v.contains(" Bytes=24 "), "a Bytes is 24 bytes");
  expect(v.endsWith("\n"), "ends in a newline");
  done()
}
