// What a client binds its UDP socket to, read back through localAddress(): a
// client of a loopback server binds that family's loopback (so the firewall is
// never asked) at the port the system chose, which is 'port'. A server's
// localAddress() is the address it listens at.

mod clientbind;

import testing use *;
import collections use *;
import sync use *;
import time use Duration;
import iocore use SocketAddr;
import actors;
import netmsg use *;

fn joined(rx: &mut Receiver[NetEvent]) bool {
  match rx.recvTimeout(Duration.fromSeconds(3i64)) {
    case let e Some { true }
    case is None[NetEvent] { false }
  }
}

fn textWith(host: &str, port: u16) String {
  var s = String.from(host);
  s.appendUInt(u64.from(port));
  s
}

// A server at 'listenAt' and a client of it: where each is bound
fn check(listenAt: SocketAddr, host: &str, what: &str) {
  var txS: Sender[NetEvent];
  var rxS: Receiver[NetEvent];
  txS, rxS = Channel[NetEvent].make();
  var txC: Sender[NetEvent];
  var rxC: Receiver[NetEvent];
  txC, rxC = Channel[NetEvent].make();
  let cfg = NetConfig.defaults();
  let server = mustListen(listenAt, cfg, channelHandler(txS));
  let client = mustConnect(server.localAddress(), cfg, channelHandler(txC));

  expect(server.port != 0u16, what);
  expectUInt(u64.from(server.localAddress().port()), u64.from(server.port), "the server's localAddress has its port");
  expectStr(server.localAddress().text().view(), textWith(host, server.port).view(), "and the address it listens at");
  expect(client.port != 0u16, "the client has a port of the system's choosing");
  expectUInt(u64.from(client.localAddress().port()), u64.from(client.port), "the client's localAddress has that port");
  expectStr(client.localAddress().text().view(), textWith(host, client.port).view(), "and the loopback address of the server's family");
  expect(joined(&mut rxS) && joined(&mut rxC), "and they join");
  client.endpoint.shutdown();
  server.endpoint.shutdown();
}

fn main() i32 {
  check(SocketAddr.localhost(0u16), "127.0.0.1:", "an IPv4 server has a port");
  check(SocketAddr.v6Localhost(0u16), "[0:0:0:0:0:0:0:1]:", "an IPv6 server has a port");
  done()
}
