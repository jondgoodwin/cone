// What a client binds its UDP socket to: the loopback address of the server's
// family when the server is on loopback (so the firewall is never asked), the
// wildcard of that family otherwise, always port 0.

mod clientbind;

import testing use *;
import iocore use SocketAddr;
import netmsg use *;

fn main() i32 {
  expectStr(clientBindAddress(&SocketAddr.localhost(4000u16)).text().view(), "127.0.0.1:0", "an IPv4 loopback server: the client binds 127.0.0.1");
  expectStr(clientBindAddress(&SocketAddr.v4(127u8, 5u8, 6u8, 7u8, 4000u16)).text().view(), "127.0.0.1:0", "anywhere in 127.0.0.0/8 too");
  expectStr(clientBindAddress(&SocketAddr.v6Localhost(4000u16)).text().view(), "[0:0:0:0:0:0:0:1]:0", "an IPv6 loopback server: the client binds ::1");
  expectStr(clientBindAddress(&SocketAddr.v4(10u8, 0u8, 0u8, 7u8, 4000u16)).text().view(), "0.0.0.0:0", "another IPv4 server: the wildcard");
  {
    imm other6 Array[u8, 16] = [0x20u8, 0x01u8, 0x0du8, 0xb8u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8];
    expectStr(clientBindAddress(&SocketAddr.v6(&other6, 4000u16)).text().view(), "[0:0:0:0:0:0:0:0]:0", "another IPv6 server: the IPv6 wildcard");
  }
  expect(clientBindAddress(&SocketAddr.v6Localhost(4000u16)).isV6(), "and the family is kept");
  done();
}
