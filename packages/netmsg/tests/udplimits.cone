// What happens at the edges of a connection, over real sockets: a server that
// is full refuses the next client; a client with nobody to answer gives up; a
// peer that goes silent times the connection out on both sides; a server that
// shuts down tells its clients.

mod udplimits;

import testing use *;
import collections use *;
import sync use *;
import time use Duration, Instant;
import iocore use SocketAddr;
import actors;
import netmsg use *;

fn reasonText(r: CloseReason) &str {
  match r {
    case is Local {"local"}
    case is Remote {"remote"}
    case is TimedOut {"timeout"}
    case is Overflow {"overflow"}
    case is Refused {"refused"}
    case is NoAnswer {"noanswer"}
  }
}

// The next event as text (J1, L1:reason), or "none" if none comes in 'ms'; a
// Joined's connection is kept
fn next(rx: &mut Receiver[NetEvent], ms: i64, conns: &mut List[Connection]) String {
  var s = String.empty();
  match rx.recvTimeout(Duration.fromMillis(ms)) {
    case Some(e) {
      match &e {
        case &Joined(j) { s.append("J"); s.appendUInt(u64.from(j.id)); conns.push(j.conn); }
        case &Left(l) { s.append("L"); s.appendUInt(u64.from(l.id)); s.append(":"); s.append(reasonText(l.reason)); }
        case &Refused(r) { s.append("R"); s.appendUInt(u64.from(r.id)); }
        case &Message(m) { s.append("M"); s.appendUInt(u64.from(m.id)); }
        case &Update(u) { s.append("U"); s.appendUInt(u64.from(u.id)); }
      }
      return s;
    }
    case is None[NetEvent] {}
  }
  String.from("none")
}

fn main() i32 {
  var dump = List[Connection].empty();

  // A full server refuses the next client
  {
    var txS: Sender[NetEvent];
    var rxS: Receiver[NetEvent];
    txS, rxS = Channel[NetEvent].make();
    var txA: Sender[NetEvent];
    var rxA: Receiver[NetEvent];
    txA, rxA = Channel[NetEvent].make();
    var txB: Sender[NetEvent];
    var rxB: Receiver[NetEvent];
    txB, rxB = Channel[NetEvent].make();
    var cfg = NetConfig.defaults();
    cfg.maxClients = 1usize;
    cfg.connectTimeoutMs = 3000i64;
    let server = mustListen(SocketAddr.localhost(0u16), cfg, channelHandler(txS));
    let a = mustConnect(SocketAddr.localhost(server.port), cfg, channelHandler(txA));
    expectStr(next(&mut rxA, 3000i64, &mut dump).view(), "J1", "the first client joins");
    expectStr(next(&mut rxS, 3000i64, &mut dump).view(), "J1", "the server has it");
    let b = mustConnect(SocketAddr.localhost(server.port), cfg, channelHandler(txB));
    expectStr(next(&mut rxB, 3000i64, &mut dump).view(), "L1:refused", "the second is refused: the server is full");
    expectStr(next(&mut rxS, 300i64, &mut dump).view(), "none", "and the server hears nothing of it");
    // The server shuts down: its client is told
    server.endpoint.shutdown();
    expectStr(next(&mut rxA, 3000i64, &mut dump).view(), "L1:remote", "the client is told the server went");
    a.endpoint.shutdown();
    b.endpoint.shutdown();
  }

  // Nobody answers: the attempt fails
  {
    var txS: Sender[NetEvent];
    var rxS: Receiver[NetEvent];
    txS, rxS = Channel[NetEvent].make();
    var txA: Sender[NetEvent];
    var rxA: Receiver[NetEvent];
    txA, rxA = Channel[NetEvent].make();
    var cfg = NetConfig.defaults();
    cfg.connectTimeoutMs = 700i64;
    cfg.connectRetryMs = 100i64;
    let gone = mustListen(SocketAddr.localhost(0u16), cfg, channelHandler(txS));
    let port = gone.port;
    gone.endpoint.shutdown();
    let a = mustConnect(SocketAddr.localhost(port), cfg, channelHandler(txA));
    expectStr(next(&mut rxA, 3000i64, &mut dump).view(), "L1:noanswer", "a client with nobody to answer gives up");
    a.endpoint.shutdown();
  }

  // The peer goes silent: both sides time out
  {
    var txS: Sender[NetEvent];
    var rxS: Receiver[NetEvent];
    txS, rxS = Channel[NetEvent].make();
    var txA: Sender[NetEvent];
    var rxA: Receiver[NetEvent];
    txA, rxA = Channel[NetEvent].make();
    var cfg = NetConfig.defaults();
    cfg.timeoutMs = 1200i64;
    let server = mustListen(SocketAddr.localhost(0u16), cfg, channelHandler(txS));
    var relay = startLossyRelay(SocketAddr.localhost(server.port), LinkConfig.perfect(), LinkConfig.perfect(), 1u64);
    let a = mustConnect(SocketAddr.localhost(relay.port), cfg, channelHandler(txA));
    expectStr(next(&mut rxA, 3000i64, &mut dump).view(), "J1", "joined through the relay");
    expectStr(next(&mut rxS, 3000i64, &mut dump).view(), "J1", "the server has it");
    relay.stop();
    expectStr(next(&mut rxA, 3000i64, &mut dump).view(), "L1:timeout", "the client times out");
    expectStr(next(&mut rxS, 3000i64, &mut dump).view(), "L1:timeout", "so does the server");
    a.endpoint.shutdown();
    server.endpoint.shutdown();
  }
  done()
}
