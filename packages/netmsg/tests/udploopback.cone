// A server and a client over real UDP sockets on loopback, each an endpoint
// actor on its own pump thread: the handshake, then reliable messages and
// latest-wins values both ways, then the client closes and both hear it.

mod udploopback;

import testing use *;
import collections use *;
import sync use *;
import time use Duration, Instant;
import iocore use SocketAddr;
import actors;
import netmsg use *;

fn reasonText(r CloseReason) &str {
  match r {
    case is Local {"local";}
    case is Remote {"remote";}
    case is TimedOut {"timeout";}
    case is Overflow {"overflow";}
    case is Refused {"refused";}
    case is NoAnswer {"noanswer";}
  }
}

fn describe(e &NetEvent) String {
  mut s = String.empty();
  match e {
    case imm j &Joined { s.append("J"); s.appendUInt(u64.from(j.id)); }
    case imm l &Left { s.append("L"); s.appendUInt(u64.from(l.id)); s.append(":"); s.append(reasonText(l.reason)); }
    case imm m &Message {
      s.append("M"); s.appendUInt(u64.from(m.id)); s.append(":");
      s.append(String.fromBytes(m.data.view()).view());
    }
    case imm u &Update {
      s.append("U"); s.appendUInt(u64.from(u.id)); s.append(":"); s.appendUInt(u64.from(u.stream));
      s.append(":"); s.append(String.fromBytes(u.data.view()).view());
    }
  }
  s;
}

fn bytes(s &str) List[u8] {
  mut b = List[u8].empty();
  putBytes(&mut b, s);
  b;
}

fn has(xs &List[String], t &str) bool {
  mut i = 0usize;
  while i < xs.len() {
    if xs[i].view() == t {return true;}
    i = i + 1usize;
  }
  false;
}

fn numbered(n u64) List[u8] {
  mut s = String.empty();
  s.appendUInt(n);
  bytes(s.view());
}

// Take events until 'n' have come or 5 s pass; Joined's connection is kept
fn take(rx &mut Receiver[NetEvent], n usize, texts &mut List[String], conn &mut List[Connection]) {
  imm until = Instant.now() + Duration.fromSeconds(5i64);
  while texts.len() < n and Instant.now() < until {
    match rx.recvTimeout(Duration.fromMillis(200i64)) {
      case imm e Some {
        texts.push(describe(&e));
        match e {
          case imm j Joined { conn.push(j.conn); }
          else {}
        }
      }
      case is None[NetEvent] {}
    }
  }
}

fn main() i32 {
  mut txS Sender[NetEvent];
  mut rxS Receiver[NetEvent];
  txS, rxS = Channel[NetEvent].make();
  mut txC Sender[NetEvent];
  mut rxC Receiver[NetEvent];
  txC, rxC = Channel[NetEvent].make();
  {
    imm cfg = Config.defaults();
    imm server = mustListen(SocketAddr.localhost(0u16), cfg, channelHandler(txS));
    expect(server.port != 0u16, "the server has a port");
    imm client = mustConnect(SocketAddr.localhost(server.port), cfg, channelHandler(txC));

    mut hs = List[String].empty();
    mut hc = List[String].empty();
    mut cs = List[Connection].empty();
    mut cc = List[Connection].empty();
    take(&mut rxS, 1usize, &mut hs, &mut cs);
    take(&mut rxC, 1usize, &mut hc, &mut cc);
    expectStr(hs[0usize].view(), "J1", "the server has a client");
    expectStr(hc[0usize].view(), "J1", "the client is connected");
    require(cs.len() == 1usize and cc.len() == 1usize, "both have a connection to send through");

    // Reliable messages and values, both ways
    mut i = 0u64;
    while i < 50u64 {
      cc[0usize].sendReliable(numbered(i));
      cs[0usize].sendReliable(numbered(1000u64 + i));
      i = i + 1u64;
    }
    cc[0usize].sendLatest(5u16, bytes("pos"));
    cs[0usize].sendLatest(6u16, bytes("snap"));
    take(&mut rxS, 52usize, &mut hs, &mut cs);
    take(&mut rxC, 52usize, &mut hc, &mut cc);
    expectUInt(u64.from(hs.len()), 52u64, "the server heard 50 messages and a value");
    expectUInt(u64.from(hc.len()), 52u64, "so did the client");
    mut inOrder = true;
    mut n = 0u64;
    i = 0u64;
    while i < 51u64 {
      imm t = hs[usize.from(1u64 + i)].view();
      if t.startsWith("M1:") {
        mut want = String.from("M1:");
        want.appendUInt(n);
        if t != want.view() {inOrder = false;}
        n = n + 1u64;
      }
      i = i + 1u64;
    }
    expect(inOrder, "the server's messages came in order");
    expectUInt(n, 50u64, "50 of them");
    expect(has(&hs, "U1:5:pos"), "the latest value arrived");
    expect(has(&hc, "U1:6:snap"), "and the client's");

    client.endpoint.shutdown();
    // The client's shutdown closes its connection: the server hears it
    take(&mut rxS, 53usize, &mut hs, &mut cs);
    expectStr(hs[hs.len() - 1usize].view(), "L1:remote", "the server is told the client left");
    take(&mut rxC, 53usize, &mut hc, &mut cc);
    expectStr(hc[hc.len() - 1usize].view(), "L1:local", "the client is told it closed");
    server.endpoint.shutdown();
  }
  done();
}
