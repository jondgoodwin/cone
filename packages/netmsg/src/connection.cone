// A connection, as the application sees it: an actor it sends messages to and
// whose events arrive at its EventHandler. The same actor serves the three ways a
// connection can be made, so an application is written once:
//
//   over UDP        a ConnectionCore drives the protocol; its packets go out through the
//                   endpoint's socket and arrive from it
//   in-process      two Connections handed each other's handle deliver the
//                   messages directly: no socket, no packets, no latency. This
//                   is single player: the server and the player in one process
//   simulated       the same two actors, but with the protocol running between
//                   them across a simulated lossy link, so that prediction and
//                   interpolation can be tried with no socket

const connUdp = 0u32;
const connDirect = 1u32;
const connSim = 2u32;

// How many reliable messages may wait for the application's credit before the
// connection gives up on it (CloseReason.Overflow)
const outboxBound = 256usize;

// A latest-wins value waiting for credit: only the newest of its stream is kept
struct PendingUpdate {
  stream: u16;
  data: Bytes;
}

// A Connection is a ValueSource of NetEvents: it sends them to its handler (a
// ValueSink[NetEvent]) only against the credit the handler has granted. Two lanes
// wait for credit, and a control event (Joined, Left, Refused) needs none:
//  - reliable: an ordered queue of Messages with Refused and Left behind them, so a
//    Left follows every message. Past outboxBound waiting messages the application
//    is not keeping up, and the connection ends with CloseReason.Overflow.
//  - latest-wins: one slot for each stream; a newer value replaces the one waiting,
//    and the replaced one is counted in ConnectionStats.latestStale.
// The credit it holds never exceeds the first grant (the window), so a unit the
// handler returns for a control event cannot inflate it. The handler's 'stop' closes
// the connection (CloseReason.Local). A connection shares its handler with the
// others of its server, so it sends no 'end' to it: Left is the end of a
// connection's events. The handler's one 'end' (Ending.Finished) comes from the
// Endpoint at its shutdown, after the Left of every connection it held.
pub actor Connection is ValueSource {
  kind: u32;
  id: u32;
  handler: EventHandler;
  window: u32;                  // the first credit granted; 0 before it
  avail: u32;                   // credit held
  outbox: Deque[NetEvent];      // the reliable lane, waiting for credit
  waiting: usize;               // the data events (Message) in outbox
  slots: Deque[PendingUpdate];  // the latest-wins lane
  staleOut: u64;                // values replaced in a slot before they were sent
  peer: ConnectionCore;
  open: bool;
  forced: bool;                 // the reason it ended is not the peer's
  forcedReason: CloseReason;

  // over UDP
  addr: SocketAddr;
  ep: Option[Endpoint];         // its packets go out through the endpoint's socket
  reported: i64;                // the deadline the endpoint was last told of

  // in-process and simulated
  partner: Option[Connection];
  sim: LinkSim;                 // simulated: the link to the partner

  fn init(self: &new, kind: u32, id: u32, handler: EventHandler, cfg: NetConfig, session: u64, addr: SocketAddr,
      ep: Option[Endpoint], link: LinkConfig, seed: u64) {
    *self = Self(kind: kind, id: id, handler: handler, window: 0u32, avail: 0u32,
      outbox: Deque[NetEvent](), waiting: 0usize, slots: Deque[PendingUpdate](), staleOut: 0u64, peer: ConnectionCore.make(cfg, session, Instant.now()),
      open: true, forced: false, forcedReason: CloseReason.Local,
      addr: addr, ep: ep, reported: -1i64,
      partner: None[Connection], sim: LinkSim.make(link, seed));
    if kind == connUdp {
      self.announce();
    }
  }

  // ------------------------------------------------------------------
  // What the application sends
  // ------------------------------------------------------------------

  // A reliable message: it arrives once, in order. At most maxReliableBytes
  // (1173 with the default packet size). A larger one is refused: nothing is
  // sent and this connection's handler hears NetEvent.Refused (fragmentation
  // is not built; the connection goes on). The same on every kind of
  // connection. If so many messages are waiting that the window is full, the
  // peer is not keeping up and the connection ends with CloseReason.Overflow.
  pub async fn sendReliable(self, data: Bytes) {
    if !open {return;}
    if data.len() > peer.maxReliable() {
      self.refuse(true, 0u16, RefusalKind.TooLarge, data.len(), peer.maxReliable());
      return;
    }
    if kind == connDirect {
      match &partner {
        case let &Some[Connection](p) { p.inMessage(data); }
        else {}
      }
      return;
    }
    if !peer.sendReliable(data) {
      self.fail(CloseReason.Overflow);
      return;
    }
    self.reschedule();
  }

  // The newest value of a latest-wins stream: sent in the next packet with
  // room unless a newer value replaces it first, and never resent. At most
  // maxLatestBytes (1171 by default); a larger value, or one for a 65th
  // stream, is refused as a message is (NetEvent.Refused).
  pub async fn sendLatest(self, stream: u16, data: Bytes) {
    if !open {return;}
    if data.len() > peer.maxLatest() {
      self.refuse(false, stream, RefusalKind.TooLarge, data.len(), peer.maxLatest());
      return;
    }
    if kind == connDirect {
      match &partner {
        case let &Some[Connection](p) { p.inUpdate(stream, data); }
        else {}
      }
      return;
    }
    if !peer.sendLatest(stream, data) {
      self.refuse(false, stream, RefusalKind.TooManyStreams, data.len(), maxStreams);
      return;
    }
    self.reschedule();
  }

  // How much a stream's waiting value counts when a packet cannot carry all of
  // them: its priority grows by 'weight' each packet it waits, and the highest
  // goes first (default 1)
  pub async fn setStreamWeight(self, stream: u16, weight: u32) {
    if kind != connDirect {
      peer.setStreamWeight(stream, weight);
    }
  }

  // End the connection: the other end is told
  pub async fn close(self) {
    self.closeNow();
  }

  // What the connection has measured: round trip time, loss, packets. All
  // zeros for an in-process connection, which has no link
  pub async fn stats(self) ConnectionStats {
    var s = peer.stats();
    s.latestStale = s.latestStale + staleOut;
    s
  }

  // The handler has used n events: n more may be sent (ValueSource)
  pub async fn credit(self, n: u32) {
    if window == 0u32 {window = n;}
    if n >= window - avail {
      avail = window;
    } else {
      avail = avail + n;
    }
    self.flush();
  }

  // The handler wants no more events: end the connection (ValueSource)
  pub async fn stop(self, why: Ending) {
    self.closeNow();
  }

  // ------------------------------------------------------------------
  // Messages between the module's own actors
  // ------------------------------------------------------------------

  // End it now and answer when the disconnect packets are handed to the socket
  async fn closeAndWait(self) u32 {
    self.closeNow();
    0u32
  }

  // Join to the other end (in-process and simulated)
  async fn link(self, other: Connection) {
    partner = Some[Connection](other);
    self.announce();
  }

  // A datagram for this connection arrived
  async fn packet(self, data: IoBuf) {
    if !open {return;}
    var evs = List[CoreEvent]();
    let dg = data.freeze();
    peer.receive(&dg, Instant.now(), &mut evs);
    self.dispatch(evs);
    self.run();
  }

  // Time to look at the connection (the endpoint's timer, or the simulation's)
  async fn tick(self) {
    reported = -1i64;
    self.run();
  }

  async fn inMessage(self, data: Bytes) {
    if open {
      self.emit(NetEvent.Message(id, data));
    }
  }

  async fn inUpdate(self, stream: u16, data: Bytes) {
    if open {
      self.emit(NetEvent.Update(id, stream, data));
    }
  }

  async fn inClosed(self) {
    self.finish(CloseReason.Remote);
  }

  // ------------------------------------------------------------------
  // Inside
  // ------------------------------------------------------------------

  // Tell the application a send was refused
  fn refuse(self, reliable: bool, stream: u16, why: RefusalKind, size: usize, limit: usize) {
    self.emit(NetEvent.Refused(id, reliable, stream, why, size, limit));
  }

  fn announce(self) {
    handler.attach(selfactor);
    self.emit(NetEvent.Joined(id, selfactor));
    self.reschedule();
  }

  // An event for the application: control events go at once or behind the
  // messages before them, data waits for credit (see the actor's comment)
  fn emit(self, ev: NetEvent) {
    match ev {
      case let Update(u) {
        let stream, d = u.(stream, data);
        var i = 0usize;
        while i < slots.len() {
          if slots[i].stream == stream {
            let s = &mut slots[i];
            s.data = d;
            staleOut = staleOut + 1u64;
            self.flush();
            return;
          }
          i = i + 1usize;
        }
        slots.push(PendingUpdate(stream, d));
      }
      case is Message {
        if forced {return;}
        if waiting >= outboxBound {
          self.overflow();
          return;
        }
        waiting = waiting + 1usize;
        outbox.push(ev);
      }
      else { outbox.push(ev); }
    }
    self.flush();
  }

  // Send what the credit allows: the reliable lane in order, a control event
  // needing none, then the newest value of each stream
  fn flush(self) {
    while true {
      match outbox.popFront() {
        case let Some(ev) {
          let control = match ev {
            case is Message { false }
            else { true }
          };
          if control {
            handler.accept(ev);
          } else if avail > 0u32 {
            avail = avail - 1u32;
            waiting = waiting - 1usize;
            handler.accept(ev);
          } else {
            outbox.pushFront(ev);
            break;
          }
        }
        else { break; }
      }
    }
    while outbox.len() == 0usize && avail > 0u32 {
      match slots.popFront() {
        case let Some(p) {
          avail = avail - 1u32;
          let stream, d = p.(stream, data);
          handler.accept(NetEvent.Update(id, stream, d));
        }
        else { break; }
      }
    }
  }

  // The application is not keeping up: too many messages wait for it
  fn overflow(self) {
    if kind == connDirect {
      match &partner {
        case let &Some[Connection](p) { p.inClosed(); }
        else {}
      }
      self.finish(CloseReason.Overflow);
    } else {
      self.fail(CloseReason.Overflow);
    }
  }

  fn closeNow(self) {
    if !open {return;}
    if kind == connDirect {
      match &partner {
        case let &Some[Connection](p) { p.inClosed(); }
        else {}
      }
      self.finish(CloseReason.Local);
      return;
    }
    peer.close();
    self.run();
  }

  // The connection ends for a reason of this side's: tell the other end and
  // the application
  fn fail(self, reason: CloseReason) {
    forced = true;
    forcedReason = reason;
    peer.close();
    self.run();
  }

  // Poll the protocol: send what it has, tell the application what happened
  fn run(self) {
    if !open {return;}
    let now = Instant.now();
    var pk = Packets();
    var evs = List[CoreEvent]();
    peer.poll(now, &mut pk, &mut evs);
    each p in pk.drain() {
      if kind == connSim {
        sim.send(now, p);
      } else {
        match &ep {
          case let &Some[Endpoint](e) { e.send(addr, p); }
          else {}
        }
      }
    }
    if kind == connSim {
      var arrived = Packets();
      sim.deliver(now, &mut arrived);
      match &partner {
        case let &Some[Connection](q) {
          each d in arrived.drain() { q.packet(d); }
        }
        else {}
      }
    }
    self.dispatch(evs);
    self.reschedule();
  }

  // Give the application the events the protocol produced
  fn dispatch(self, var evs: List[CoreEvent]) {
    each e in evs.drain() {
      match e {
        case let Reliable(r) {
          let d = r.(data);
          if open {self.emit(NetEvent.Message(id, d));}
        }
        case let Latest(l) {
          let stream, d = l.(stream, data);
          if open {self.emit(NetEvent.Update(id, stream, d));}
        }
        case let Closed(c) {
          if forced {
            self.finish(forcedReason);
          } else {
            self.finish(c.reason);
          }
        }
      }
    }
  }

  // Tell the endpoint when the connection next needs a tick
  fn reschedule(self) {
    if kind != connUdp || !open {return;}
    let at = peer.nextDeadline().nanos();
    if at != reported {
      reported = at;
      match &ep {
        case let &Some[Endpoint](e) { e.deadline(id, at); }
        else {}
      }
    }
  }

  // It has ended: the application hears once, the endpoint lets it go
  fn finish(self, reason: CloseReason) {
    if !open {return;}
    open = false;
    // A value still waiting for credit is dropped: nothing follows Left
    while slots.len() > 0usize {
      slots.popFront();
      staleOut = staleOut + 1u64;
    }
    self.emit(NetEvent.Left(id, reason));
    match &ep {
      case let &Some[Endpoint](e) { e.gone(id); }
      else {}
    }
    ep = None[Endpoint];
    partner = None[Connection];
  }
}

// The two ends of an in-process connection
pub struct ConnectionPair {
  pub a: Connection;
  pub b: Connection;
}

// Two connections joined in this process, delivering messages directly: no
// socket and no packets, so nothing is lost or late and the order is the
// order sent. Each handler hears Joined (with the Connection to send through),
// then the other end's messages. This is single player: the server actor and
// the player talk through the same messages they would over UDP. 'idA' is the
// id a's events carry (the server numbers its clients; a server's handler
// shared by several pairs gives each a different id), 'idB' b's.
pub fn pairInProcess(ha: EventHandler, idA: u32, hb: EventHandler, idB: u32) ConnectionPair {
  let cfg = NetConfig.defaults();
  let none = SocketAddr.localhost(0u16);
  let a = Connection(connDirect, idA, ha, cfg, 0u64, none, None[Endpoint], LinkConfig.perfect(), 0u64);
  let b = Connection(connDirect, idB, hb, cfg, 0u64, none, None[Endpoint], LinkConfig.perfect(), 0u64);
  a.link(b);
  b.link(a);
  ConnectionPair(a, b)
}

// The driver of a simulated pair: a thread that ticks both ends every
// millisecond. stop() ends it
pub struct SimulatedPair {
  pub a: Connection;
  pub b: Connection;
  stopTx: Sender[u32];
  doneRx: Receiver[u32];

  // Stop the clock and wait for it. The connections stay: they can still be
  // closed, and nothing more moves between them
  pub fn stop(self: &mut) {
    stopTx.send(1u32);
    doneRx.recv();
  }
}

struct SimArgs is Sendable {
  pub a: Connection;
  pub b: Connection;
  pub stop: Receiver[u32];
  pub done: Sender[u32];
}

fn simMain(var x: SimArgs) u32 {
  while true {
    match x.stop.tryRecv() {
      case let Some(s) { break; }
      case is None[u32] {}
    }
    thread.sleep(Duration.fromMillis(1i64));
    x.a.tick();
    x.b.tick();
  }
  x.done.send(1u32);
  0u32
}

// Two connections in this process with the real protocol running between
// them across a simulated link: 'toB' is what a's packets suffer, 'toA' what
// b's do. The packets are real; only the socket is missing. A thread ticks
// both ends, so the link's delays are real time (millisecond resolution).
// Call stop() when done.
pub fn pairSimulated(cfg: NetConfig, toB: LinkConfig, toA: LinkConfig, seed: u64, ha: EventHandler, idA: u32, hb: EventHandler, idB: u32) SimulatedPair {
  let none = SocketAddr.localhost(0u16);
  let session = 0x5151515151515151u64;
  let a = Connection(connSim, idA, ha, cfg, session, none, None[Endpoint], toB, seed);
  let b = Connection(connSim, idB, hb, cfg, session, none, None[Endpoint], toA, seed ^ 0xA5A5A5A5A5A5A5A5u64);
  a.link(b);
  b.link(a);
  var stopTx: Sender[u32];
  var stopRx: Receiver[u32];
  stopTx, stopRx = Channel[u32].make();
  var doneTx: Sender[u32];
  var doneRx: Receiver[u32];
  doneTx, doneRx = Channel[u32].make();
  let th = thread.start(SimArgs(a, b, stopRx, doneTx), &simMain);
  th.detach();
  SimulatedPair(a, b, stopTx, doneRx)
}
