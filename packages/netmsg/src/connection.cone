// A connection, as the application sees it: an actor it sends messages to and
// whose events arrive at its EventHandler. The same actor serves the three ways a
// connection can be made, so an application is written once:
//
//   over UDP        a ConnectionCore drives the protocol; its packets go out through its
//                   own UdpSender (the endpoint's socket's sending side), awaited by the
//                   connection's own worker, and arrive from the endpoint; it keeps its
//                   own deadline in an actors.Timer held for its life
//   in-process      two Connections handed each other's handle deliver the
//                   messages directly: no socket, no packets, no latency. This
//                   is single player: the server and the player in one process
//   simulated       the same two actors, but with the protocol running between
//                   them across a simulated lossy link, so that prediction and
//                   interpolation can be tried with no socket

const connUdp = 0u32;
const connDirect = 1u32;
const connSim = 2u32;

// How many reliable messages may wait for the application's credit before the
// connection gives up on it (CloseReason.Overflow)
const outboxBound = 256usize;

// A latest-wins value waiting for credit: only the newest of its stream is kept.
// The Connection keeps one for each stream position, 'waiting' when the data is
// a value not yet sent
struct PendingUpdate {
  stream: u16;
  data: Option[Bytes];
  waiting: bool;
}

// A Connection is a ValueSource of NetEvents: it sends them to its handler (a
// ValueSink[NetEvent]) only against the credit the handler has granted. Two lanes
// wait for credit, and a control event (Joined, Left, Refused) needs none:
//  - reliable: an ordered queue of Messages with Refused and Left behind them, so a
//    Left follows every message. Past outboxBound waiting messages the application
//    is not keeping up, and the connection ends with CloseReason.Overflow.
//  - latest-wins: one slot for each stream (at most maxStreams, in a fixed table),
//    sent in the order the streams began waiting; a newer value replaces the one
//    waiting and keeps its turn, and the replaced one is counted in
//    ConnectionStats.latestStale.
// The credit it holds never exceeds the first grant (the window), so a unit the
// handler returns for a control event cannot inflate it. The handler's 'stop' closes
// the connection (CloseReason.Local). A connection shares its handler with the
// others of its server, so it sends no 'end' to it: Left is the end of a
// connection's events. The handler's one 'end' (Ending.Finished) comes from the
// Endpoint at its shutdown, after the Left of every connection it held.
// A full send buffer: the kind NoBufferSpace (WSAENOBUFS, ENOBUFS), or the
// system's number for a full non-blocking socket, which has no kind: Winsock's
// WSAEWOULDBLOCK, Linux's EAGAIN
fn bufferFull(e: IoError) bool {
  if e.kind() == IoErrorKind.NoBufferSpace {return true;}
  #if #os == .windows {e.code == 10035u32} #else {e.code == 11u32}
}

// An in-process stream bound to a cell (bindLatest): the in-process kind has no
// core to hold it, so the Connection does. 'seen' is the cell version last delivered
struct CellBind {
  stream: u16;
  cell: Option[LatestReader];
  seen: u64;
}

// A stream whose incoming values go into a cell (bindIncoming). The protocol's
// own sequence rules (newest only) have already run when a value reaches it
struct InBind {
  stream: u16;
  cell: Option[LatestWriter];
}

pub actor Connection is ValueSource {
  kind: u32;
  id: u32;
  handler: EventHandler;
  window: u32;                  // the first credit granted; 0 before it
  avail: u32;                   // credit held
  outbox: Deque[NetEvent];      // the reliable lane, waiting for credit
  waiting: usize;               // the data events (Message) in outbox
  // The latest-wins lane, in two tables of maxStreams (64) entries: the value
  // waiting for credit of each stream, by the stream's position in the core's
  // table of incoming streams (fixed for the connection's life, see ConnectionCore), and a
  // ring of the positions that wait, in the order they began waiting, so a
  // stream with a high position is not starved by one with a low one
  pend: Array[PendingUpdate, 64];
  ring: Array[usize, 64];
  ringHead: usize;              // where the ring's first position is
  ringLen: usize;               // positions waiting: never more than maxStreams, as each stream waits once
  // In-process (no core): the streams heard of, by position, in the order they
  // first came; never removed, so a position is fixed for the connection's life
  directIds: Array[u16, 64];
  nDirect: usize;
  // In-process: the streams bound to cells (bindLatest), in the order bound
  binds: Array[CellBind, 64];
  nBinds: usize;
  inBinds: List[InBind];        // the incoming streams bound to cells (bindIncoming); an unbound entry has no cell
  cellRefusedIn: u64;           // incoming values longer than their cell takes
  cellSkippedOut: u64;          // in-process: cell versions passed over between two flushCells
  staleOut: u64;                // values replaced in a slot before they were sent
  sendErrors: u64;              // sends the socket answered with an error
  slotsRefused: u64;            // updates dropped for an in-process stream beyond the maxStreams a connection carries
  peer: ConnectionCore;
  open: bool;
  forced: bool;                 // the reason it ended is not the peer's
  forcedReason: CloseReason;

  // over UDP
  addr: SocketAddr;
  ep: Option[Endpoint];         // told when the connection has ended
  tx: UdpSender;                // the endpoint's socket's sending side (none for the other kinds)
  outq: Deque[IoBuf];           // packets polled and not yet handed to the socket
  parent: CancelGroup;          // the endpoint's group (a fresh one for the other kinds)
  timer: actors.Timer;          // the connection's own deadline, held for its life (UDP): 'clock' waits on it; ended by 'parent' or finish

  // in-process and simulated
  partner: Option[Connection];
  sim: LinkSim;                 // simulated: the link to the partner

  fn init(self: &new, kind: u32, id: u32, handler: EventHandler, cfg: NetConfig, session: u64, addr: SocketAddr,
      ep: Option[Endpoint], tx: UdpSender, parent: CancelGroup, link: LinkConfig, seed: u64) {
    *self = Self(kind: kind, id: id, handler: handler, window: 0u32, avail: 0u32,
      outbox: Deque[NetEvent](), waiting: 0usize,
      pend: Array[PendingUpdate, 64]() <- fill PendingUpdate(0u16, None[Bytes], false),
      ring: Array[usize, 64]() <- fill 0usize, ringHead: 0usize, ringLen: 0usize,
      directIds: Array[u16, 64]() <- fill 0u16, nDirect: 0usize,
      binds: Array[CellBind, 64]() <- fill CellBind(0u16, None[LatestReader], 0u64), nBinds: 0usize, inBinds: List[InBind](), cellRefusedIn: 0u64, cellSkippedOut: 0u64,
      staleOut: 0u64, sendErrors: 0u64, slotsRefused: 0u64, peer: ConnectionCore.make(cfg, session, Instant.now()),
      open: true, forced: false, forcedReason: CloseReason.Local,
      addr: addr, ep: ep, tx: tx, outq: Deque[IoBuf](), parent: parent,
      timer: actors.Timer.within(&parent),
      partner: None[Connection], sim: LinkSim.make(link, seed));
    if kind == connUdp {
      self.announce();
    }
  }

  // ------------------------------------------------------------------
  // What the application sends
  // ------------------------------------------------------------------

  // A reliable message: it arrives once, in order. At most maxReliableBytes
  // (1173 with the default packet size). A larger one is refused: nothing is
  // sent and this connection's handler hears NetEvent.Refused (fragmentation
  // is not built; the connection goes on). The same on every kind of
  // connection. If so many messages are waiting that the window is full, the
  // peer is not keeping up and the connection ends with CloseReason.Overflow.
  pub async fn sendReliable(self, data: Bytes) {
    if !open {return;}
    if data.len() > peer.maxReliable() {
      self.refuse(true, 0u16, RefusalKind.TooLarge, data.len(), peer.maxReliable());
      return;
    }
    if kind == connDirect {
      match &partner {
        case let &Some[Connection](p) { p.inMessage(data); }
        else {}
      }
      return;
    }
    if !peer.sendReliable(data) {
      self.fail(CloseReason.Overflow);
    } else {
      self.reschedule();
    }
    while true {
      match outq.popFront() {
        case let Some(p) { self.sendDone(await tx.sendTo(addr, p)); }
        else { break; }
      }
    }
  }

  // The newest value of a latest-wins stream: sent in the next packet with
  // room unless a newer value replaces it first, and never resent. At most
  // maxLatestBytes (1171 by default); a larger value, or one for a 65th
  // stream, is refused as a message is (NetEvent.Refused).
  pub async fn sendLatest(self, stream: u16, data: Bytes) {
    if !open {return;}
    if data.len() > peer.maxLatest() {
      self.refuse(false, stream, RefusalKind.TooLarge, data.len(), peer.maxLatest());
      return;
    }
    if kind == connDirect {
      match &partner {
        case let &Some[Connection](p) { p.inUpdate(stream, data); }
        else {}
      }
      return;
    }
    if !peer.sendLatest(stream, data) {
      self.refuse(false, stream, RefusalKind.TooManyStreams, data.len(), maxStreams);
      return;
    }
    self.reschedule();
  }

  // Bind a stream to a cell: from now the stream's value is the cell's newest,
  // taken at each send slot (the packet copies it from the cell, under the
  // stream's 'weight' like a sendLatest stream) and sent when newer than the
  // last one sent. A value waiting from sendLatest on this stream is dropped; a
  // stream already bound is rebound: the old cell is let go and nothing more
  // of it is sent, the new cell is sent from its first value on. The stream
  // keeps its sequence. A cell that takes values over maxLatestBytes, or a 65th
  // stream, is refused as a sendLatest is (NetEvent.Refused). In-process, a bound
  // cell's newest is delivered when flushCells is called, and has no weight.
  pub async fn bindLatest(self, stream: u16, cell: LatestReader, weight: u32) {
    if !open {return;}
    if cell.capacity() > peer.maxLatest() {
      self.refuse(false, stream, RefusalKind.TooLarge, cell.capacity(), peer.maxLatest());
      return;
    }
    if kind == connDirect {
      var k = 0usize;
      while k < nBinds && binds[k].stream != stream {k = k + 1usize;}
      if k == nBinds {
        if nBinds >= maxStreams {
          self.refuse(false, stream, RefusalKind.TooManyStreams, cell.capacity(), maxStreams);
          return;
        }
        nBinds = nBinds + 1usize;
      }
      binds[k] = CellBind(stream, Some[LatestReader](cell), 0u64);
      return;
    }
    if !peer.bindLatest(stream, cell, weight) {
      self.refuse(false, stream, RefusalKind.TooManyStreams, cell.capacity(), maxStreams);
      return;
    }
    self.reschedule();
  }

  // Let go of a stream's cell: nothing more of the cell is sent, and the stream
  // is sendLatest's again
  pub async fn unbindLatest(self, stream: u16) {
    if !open {return;}
    if kind == connDirect {
      var k = 0usize;
      while k < nBinds && binds[k].stream != stream {k = k + 1usize;}
      if k < nBinds {binds[k].cell = None[LatestReader];}
      return;
    }
    if peer.unbindLatest(stream) {
      self.reschedule();
    }
  }

  // This stream's newest incoming value goes into the cell, not to the handler
  // (no Update event): the receiver reads it from the cell's reader. A value
  // longer than the cell's capacity is dropped and counted in
  // ConnectionStats.cellRefused. A stream already bound is rebound: the old cell
  // is let go and keeps what it held, the new cell gets only values that arrive
  // from now on. A value that arrived before the bind was an Update and stays
  // one, even when it still waits for the handler's credit. The stream's
  // sequence is the protocol's, so an older value never follows a newer one.
  pub async fn bindIncoming(self, stream: u16, cell: LatestWriter) {
    if !open {return;}
    var k = 0usize;
    while k < inBinds.len() && inBinds[k].stream != stream {k = k + 1usize;}
    if k == inBinds.len() {
      if k >= maxStreams {
        self.refuse(false, stream, RefusalKind.TooManyStreams, cell.capacity(), maxStreams);
        return;
      }
      inBinds.push(InBind(stream, Some[LatestWriter](cell)));
      return;
    }
    inBinds[k].cell = Some[LatestWriter](cell);
  }

  // Let go of an incoming stream's cell: its values are Updates again. An
  // unbound stream is a no-op
  pub async fn unbindIncoming(self, stream: u16) {
    var k = 0usize;
    while k < inBinds.len() && inBinds[k].stream != stream {k = k + 1usize;}
    if k < inBinds.len() {inBinds[k].cell = None[LatestWriter];}
  }

  // Send what the bound cells hold now. In-process, each bound cell newer than
  // the last one delivered is delivered at once as an Update, in order with the
  // messages sent before and after it (one frame of lockstep single player: state,
  // then the frame's end). Over UDP and simulated, it looks at the cells now rather
  // than at the next send slot, and what is newer goes in a packet when the
  // pacing allows
  pub async fn flushCells(self) {
    if !open {return;}
    if kind == connDirect {
      self.deliverCells();
      return;
    }
    self.run();
    while true {
      match outq.popFront() {
        case let Some(p) { self.sendDone(await tx.sendTo(addr, p)); }
        else { break; }
      }
    }
  }

  // How much a stream's waiting value counts when a packet cannot carry all of
  // them: its priority grows by 'weight' each packet it waits, and the highest
  // goes first (default 1)
  pub async fn setStreamWeight(self, stream: u16, weight: u32) {
    if kind != connDirect {
      peer.setStreamWeight(stream, weight);
    }
  }

  // End the connection: the other end is told
  pub async fn close(self) {
    self.closeNow();
    while true {
      match outq.popFront() {
        case let Some(p) { self.sendDone(await tx.sendTo(addr, p)); }
        else { break; }
      }
    }
  }

  // What the connection has measured: round trip time, loss, packets. All
  // zeros for an in-process connection, which has no link
  pub async fn stats(self) ConnectionStats {
    var s = peer.stats();
    s.latestStale = s.latestStale + staleOut;
    s.sendErrors = sendErrors;
    s.streamsRefused = s.streamsRefused + slotsRefused;
    s.cellSkipped = s.cellSkipped + cellSkippedOut;
    s.cellRefused = s.cellRefused + cellRefusedIn;
    s
  }

  // As if the socket had answered a send with the system's error number 'code'.
  // For tests: a full send buffer, or a socket closed under the connection,
  // cannot be made to happen on demand
  pub async fn sendAnswered(self, code: u32) {
    self.sendFailed(IoError(code));
  }

  // The handler has used n events: n more may be sent (ValueSource)
  pub async fn credit(self, n: u32) {
    if window == 0u32 {window = n;}
    if n >= window - avail {
      avail = window;
    } else {
      avail = avail + n;
    }
    self.flush();
  }

  // The handler wants no more events: end the connection (ValueSource)
  pub async fn stop(self, why: Ending) {
    self.closeNow();
    while true {
      match outq.popFront() {
        case let Some(p) { self.sendDone(await tx.sendTo(addr, p)); }
        else { break; }
      }
    }
  }

  // ------------------------------------------------------------------
  // Messages between the module's own actors
  // ------------------------------------------------------------------

  // End it now and answer when the disconnect packets are handed to the socket
  async fn closeAndWait(self) u32 {
    self.closeNow();
    while true {
      match outq.popFront() {
        case let Some(p) { self.sendDone(await tx.sendTo(addr, p)); }
        else { break; }
      }
    }
    0u32
  }

  // Join to the other end (in-process and simulated)
  async fn link(self, other: Connection) {
    partner = Some[Connection](other);
    self.announce();
  }

  // A datagram for this connection arrived
  async fn packet(self, data: IoBuf) {
    if !open {return;}
    var evs = List[CoreEvent]();
    let dg = data.freeze();
    peer.receive(&dg, Instant.now(), &mut evs);
    self.dispatch(evs);
    self.run();
    while true {
      match outq.popFront() {
        case let Some(p) { self.sendDone(await tx.sendTo(addr, p)); }
        else { break; }
      }
    }
  }

  // Time to look at the connection: the simulation's clock
  async fn tick(self) {
    self.run();
    while true {
      match outq.popFront() {
        case let Some(p) { self.sendDone(await tx.sendTo(addr, p)); }
        else { break; }
      }
    }
  }

  // The connection's deadline, for its life (over UDP): each time the timer's
  // deadline comes, the protocol is polled if its deadline is due, or the
  // deadline is set again. It ends when the timer does (finish, or the
  // endpoint's group)
  async fn clock(self) {
    while await timer.next() {
      if !open {break;}
      if peer.nextDeadline().nanos() <= Instant.now().nanos() {
        self.run();
      } else {
        self.reschedule();
      }
      while true {
        match outq.popFront() {
          case let Some(p) { self.sendDone(await tx.sendTo(addr, p)); }
          else { break; }
        }
      }
    }
  }

  async fn inMessage(self, data: Bytes) {
    if open {
      self.emit(NetEvent.Message(id, data));
    }
  }

  async fn inUpdate(self, stream: u16, data: Bytes) {
    if open {
      // The stream's position: there is no core between the ends, so this end
      // keeps its own table. A stream past maxStreams is dropped and counted
      var pos = 0usize;
      while pos < nDirect && directIds[pos] != stream {pos = pos + 1usize;}
      if pos == nDirect {
        // One entry a stream, and at most maxStreams of them: a handler that
        // takes no updates holds at most that many buffers. The core keeps an
        // incoming stream to the same limit; this bounds the in-process kind
        if nDirect >= maxStreams {
          slotsRefused = slotsRefused + 1u64;
          return;
        }
        directIds[nDirect] = stream;
        nDirect = nDirect + 1usize;
      }
      self.emitUpdate(pos, stream, data);
    }
  }

  async fn inClosed(self) {
    self.finish(CloseReason.Remote);
  }

  // ------------------------------------------------------------------
  // Inside
  // ------------------------------------------------------------------

  // Tell the application a send was refused
  fn refuse(self, reliable: bool, stream: u16, why: RefusalKind, size: usize, limit: usize) {
    self.emit(NetEvent.Refused(id, reliable, stream, why, size, limit));
  }

  fn announce(self) {
    handler.attach(selfactor);
    self.emit(NetEvent.Joined(id, selfactor));
    if kind == connUdp {selfactor.clock();}
    self.reschedule();
  }

  // An event for the application: control events go at once or behind the
  // messages before them, data waits for credit (see the actor's comment)
  fn emit(self, ev: NetEvent) {
    match ev {
      case is Update {
        // Updates go through emitUpdate, which has the stream's position
        return;
      }
      case is Message {
        if forced {return;}
        if waiting >= outboxBound {
          self.overflow();
          return;
        }
        waiting = waiting + 1usize;
        outbox.push(ev);
      }
      else { outbox.push(ev); }
    }
    self.flush();
  }

  // The newest value of a stream, at its position: it replaces the value
  // waiting there, or begins to wait, last in the ring
  fn emitUpdate(self, pos: usize, stream: u16, d: Bytes) {
    if self.intoCell(stream, d) {return;}
    let s = &mut pend[pos];
    if s.waiting {
      s.data = Some[Bytes](d);
      staleOut = staleOut + 1u64;
    } else {
      s.stream = stream;
      s.data = Some[Bytes](d);
      s.waiting = true;
      ring[(ringHead + ringLen) % 64usize] = pos;
      ringLen = ringLen + 1usize;
    }
    self.flush();
  }

  // An incoming value on a stream bound to a cell goes into it (true), or is
  // dropped and counted when it is longer than the cell takes; false when the
  // stream is not bound
  fn intoCell(self, stream: u16, d: Bytes) bool {
    var k = 0usize;
    while k < inBinds.len() {
      if inBinds[k].stream == stream {
        match &mut inBinds[k].cell {
          case let &mut Some[LatestWriter](w) {
            if !w.put(d.view()) {cellRefusedIn = cellRefusedIn + 1u64;}
            return true;
          }
          else { return false; }
        }
      }
      k = k + 1usize;
    }
    false
  }

  // Send what the credit allows: the reliable lane in order, a control event
  // needing none, then the newest value of each stream
  fn flush(self) {
    while true {
      match outbox.popFront() {
        case let Some(ev) {
          let control = match ev {
            case is Message { false }
            else { true }
          };
          if control {
            handler.accept(ev);
          } else if avail > 0u32 {
            avail = avail - 1u32;
            waiting = waiting - 1usize;
            handler.accept(ev);
          } else {
            outbox.pushFront(ev);
            break;
          }
        }
        else { break; }
      }
    }
    while outbox.len() == 0usize && avail > 0u32 && ringLen > 0usize {
      let pos = ring[ringHead];
      ringHead = (ringHead + 1usize) % 64usize;
      ringLen = ringLen - 1usize;
      let s = &mut pend[pos];
      s.waiting = false;
      match s.data.take() {
        case let Some(d) {
          avail = avail - 1u32;
          handler.accept(NetEvent.Update(id, s.stream, d));
        }
        else {}
      }
    }
  }

  // In-process: deliver each bound cell's newest, if newer than the last
  // delivered, as an Update on its stream, in the order the streams were bound
  fn deliverCells(self) {
    var k = 0usize;
    while k < nBinds && open {
      let b = &mut binds[k];
      k = k + 1usize;
      var data = None[Bytes];
      match &b.cell {
        case let &Some[LatestReader](r) {
          if r.version() > b.seen {
            var buf = IoBuf(if r.capacity() > 0usize {r.capacity()} else {1usize});
            match r.readNewer(b.seen, buf.spare()) {
              case let Some(got) {
                buf.setLen(got.len);
                if b.seen > 0u64 && got.version > b.seen + 1u64 {
                  cellSkippedOut = cellSkippedOut + (got.version - b.seen - 1u64);
                }
                b.seen = got.version;
                data = Some[Bytes](buf.freeze());
              }
              else {}
            }
          }
        }
        else {}
      }
      match data {
        case let Some(d) {
          match &partner {
            case let &Some[Connection](q) { q.inUpdate(binds[k - 1usize].stream, d); }
            else {}
          }
        }
        else {}
      }
    }
  }

  // The application is not keeping up: too many messages wait for it
  fn overflow(self) {
    if kind == connDirect {
      match &partner {
        case let &Some[Connection](p) { p.inClosed(); }
        else {}
      }
      self.finish(CloseReason.Overflow);
    } else {
      self.fail(CloseReason.Overflow);
    }
  }

  fn closeNow(self) {
    if !open {return;}
    if kind == connDirect {
      match &partner {
        case let &Some[Connection](p) { p.inClosed(); }
        else {}
      }
      self.finish(CloseReason.Local);
      return;
    }
    peer.close();
    self.run();
  }

  // The connection ends for a reason of this side's: tell the other end and
  // the application
  fn fail(self, reason: CloseReason) {
    forced = true;
    forcedReason = reason;
    peer.close();
    self.run();
  }

  // What the socket answered to a datagram: an error is counted in the stats
  // (ConnectionStats.sendErrors), and any but a full send buffer ends the
  // connection with CloseReason.SendFailed (once: finish ignores a second call).
  // A full buffer is a datagram lost, as the network may lose it; the protocol
  // resends what matters
  fn sendDone(self, r: Result[usize, IoError]) {
    match r {
      case let Err(e) { self.sendFailed(e); }
      else {}
    }
  }

  fn sendFailed(self, e: IoError) {
    sendErrors = sendErrors + 1u64;
    if !bufferFull(e) {
      self.finish(CloseReason.SendFailed);
    }
  }

  // Poll the protocol: send what it has, tell the application what happened
  fn run(self) {
    if !open {return;}
    let now = Instant.now();
    var pk = Packets();
    var evs = List[CoreEvent]();
    peer.poll(now, &mut pk, &mut evs);
    each p in pk.drain() {
      if kind == connSim {
        sim.send(now, p);
      } else {
        outq.push(p);
      }
    }
    if kind == connSim {
      var arrived = Packets();
      sim.deliver(now, &mut arrived);
      match &partner {
        case let &Some[Connection](q) {
          each d in arrived.drain() { q.packet(d); }
        }
        else {}
      }
    }
    self.dispatch(evs);
    self.reschedule();
  }

  // Give the application the events the protocol produced
  // A packet's input cells are written first, so a handler hearing its message
  // reads this packet's value, as it does in-process
  fn dispatch(self, var evs: List[CoreEvent]) {
    var rest = List[CoreEvent]();
    each e in evs.drain() {
      match e {
        case let Latest(l) {
          let stream, d, pos = l.(stream, data, pos);
          if !(open && self.intoCell(stream, d)) {rest.push(CoreEvent.Latest(stream, d, pos));}
        }
        else { rest.push(e); }
      }
    }
    each e in rest.drain() {
      match e {
        case let Reliable(r) {
          let d = r.(data);
          if open {self.emit(NetEvent.Message(id, d));}
        }
        case let Latest(l) {
          let stream, d, pos = l.(stream, data, pos);
          if open {self.emitUpdate(pos, stream, d);}
        }
        case let Closed(c) {
          if forced {
            self.finish(forcedReason);
          } else {
            self.finish(c.reason);
          }
        }
      }
    }
  }

  // Keep the connection's own deadline: the timer is set to the protocol's next
  // one. A later one is a store (the timer finds it when it comes), an earlier
  // one moves the timer's entry, and one already due fires at this worker's
  // next step
  fn reschedule(self) {
    if kind != connUdp || !open {return;}
    timer.set(peer.nextDeadline());
  }

  // It has ended: the application hears once, the endpoint lets it go
  fn finish(self, reason: CloseReason) {
    if !open {return;}
    open = false;
    timer.stop();
    // The cells' readers are let go
    var c = 0usize;
    while c < nBinds {
      binds[c].cell = None[LatestReader];
      c = c + 1usize;
    }
    var ib = 0usize;
    while ib < inBinds.len() {
      inBinds[ib].cell = None[LatestWriter];
      ib = ib + 1usize;
    }
    // A value still waiting for credit is dropped: nothing follows Left
    while ringLen > 0usize {
      let s = &mut pend[ring[ringHead]];
      ringHead = (ringHead + 1usize) % 64usize;
      ringLen = ringLen - 1usize;
      s.waiting = false;
      s.data = None[Bytes];
      staleOut = staleOut + 1u64;
    }
    self.emit(NetEvent.Left(id, reason));
    match &ep {
      case let &Some[Endpoint](e) { e.gone(id, addr); }
      else {}
    }
    ep = None[Endpoint];
    partner = None[Connection];
  }
}

// The two ends of an in-process connection
pub struct ConnectionPair {
  pub a: Connection;
  pub b: Connection;
}

// Two connections joined in this process, delivering messages directly: no
// socket and no packets, so nothing is lost or late and the order is the
// order sent. Each handler hears Joined (with the Connection to send through),
// then the other end's messages. This is single player: the server actor and
// the player talk through the same messages they would over UDP. 'idA' is the
// id a's events carry (the server numbers its clients; a server's handler
// shared by several pairs gives each a different id), 'idB' b's.
pub fn pairInProcess(ha: EventHandler, idA: u32, hb: EventHandler, idB: u32) ConnectionPair {
  let cfg = NetConfig.defaults();
  let none = SocketAddr.localhost(0u16);
  let a = Connection(connDirect, idA, ha, cfg, 0u64, none, None[Endpoint], UdpSender.none(), CancelGroup.make(), LinkConfig.perfect(), 0u64);
  let b = Connection(connDirect, idB, hb, cfg, 0u64, none, None[Endpoint], UdpSender.none(), CancelGroup.make(), LinkConfig.perfect(), 0u64);
  a.link(b);
  b.link(a);
  ConnectionPair(a, b)
}

// The driver of a simulated pair: a thread that ticks both ends every
// millisecond. stop() ends it
pub struct SimulatedPair {
  pub a: Connection;
  pub b: Connection;
  stopTx: Sender[u32];
  doneRx: Receiver[u32];

  // Stop the clock and wait for it. The connections stay: they can still be
  // closed, and nothing more moves between them
  pub fn stop(self: &mut) {
    stopTx.send(1u32);
    doneRx.recv();
  }
}

struct SimArgs is Sendable {
  pub a: Connection;
  pub b: Connection;
  pub stop: Receiver[u32];
  pub done: Sender[u32];
}

fn simMain(var x: SimArgs) u32 {
  while true {
    match x.stop.tryRecv() {
      case let Some(s) { break; }
      case is None[u32] {}
    }
    thread.sleep(Duration.fromMillis(1i64));
    x.a.tick();
    x.b.tick();
  }
  x.done.send(1u32);
  0u32
}

// Two connections in this process with the real protocol running between
// them across a simulated link: 'toB' is what a's packets suffer, 'toA' what
// b's do. The packets are real; only the socket is missing. A thread ticks
// both ends, so the link's delays are real time (millisecond resolution).
// Call stop() when done.
pub fn pairSimulated(cfg: NetConfig, toB: LinkConfig, toA: LinkConfig, seed: u64, ha: EventHandler, idA: u32, hb: EventHandler, idB: u32) SimulatedPair {
  let none = SocketAddr.localhost(0u16);
  let session = 0x5151515151515151u64;
  let a = Connection(connSim, idA, ha, cfg, session, none, None[Endpoint], UdpSender.none(), CancelGroup.make(), toB, seed);
  let b = Connection(connSim, idB, hb, cfg, session, none, None[Endpoint], UdpSender.none(), CancelGroup.make(), toA, seed ^ 0xA5A5A5A5A5A5A5A5u64);
  a.link(b);
  b.link(a);
  var stopTx: Sender[u32];
  var stopRx: Receiver[u32];
  stopTx, stopRx = Channel[u32].make();
  var doneTx: Sender[u32];
  var doneRx: Receiver[u32];
  doneTx, doneRx = Channel[u32].make();
  let th = thread.start(SimArgs(a, b, stopRx, doneTx), &simMain);
  th.detach();
  SimulatedPair(a, b, stopTx, doneRx)
}
