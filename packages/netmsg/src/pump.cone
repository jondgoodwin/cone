// The thread that owns a UDP socket for the actors. An actor cannot wait, so
// the socket belongs to one thread running an iocore Loop: it receives the
// datagrams and hands each to the endpoint actor as a message, sends the
// datagrams the connections give it, and wakes the endpoint when it asked to
// be woken. Nothing of the protocol is here; it only moves bytes and time
// between the socket and the actors.
//
//   actors -> pump:  a Sender[Cmd] and the Waker of the pump's Loop (Outbox)
//   pump -> actors:  messages to the Endpoint actor

// What the pump is told to do
pub enum Cmd {
  pub struct Send {pub addr SocketAddr; pub data List[u8];}   // one datagram to addr
  pub struct Wake {pub at i64;}                                // call the endpoint's tick at this instant
  Stop;                                                        // send what is queued, then end
}

// How actors reach the pump: its command channel and the waker that makes
// its Loop look at it
pub struct Outbox is Sendable {
  tx Sender[Cmd];
  waker Waker;

  pub fn clone(self &) Outbox {new Outbox(tx.clone(), self.waker);}

  pub fn send(self &, addr SocketAddr, data List[u8]) {
    tx.send(Cmd.Send(addr, data));
    waker.wake();
  }

  pub fn wakeAt(self &, at i64) {
    tx.send(Cmd.Wake(at));
    waker.wake();
  }

  pub fn stop(self &) {
    tx.send(Cmd.Stop);
    waker.wake();
  }
}

// The pump says whether it is up
enum Started {
  pub struct Up {pub port u16; pub waker Waker;}
  pub struct Down {pub code u32;}
}

struct PumpArgs is Sendable {
  pub bind SocketAddr;
  pub cmds Receiver[Cmd];
  pub started Sender[Started];
  pub epRx Receiver[Endpoint];
}

// Datagrams bigger than this are cut when received
const recvRoom = 2048usize;

// The pump's thread: bind, say so, wait for the endpoint actor, then serve
fn pumpMain(a &mut PumpArgs) u32 {
  mut lp = Loop.mustMake();
  mut sock = Handle.none();
  match lp.bindUdp(a.bind) {
    case imm h Ok { sock = h; }
    case imm e Error {
      a.started.send(Started.Down(e.code));
      return 1u32;
    }
  }
  mut port = 0u16;
  match lp.localAddr(sock) {
    case imm la Ok { port = la.port(); }
    case imm e Error {}
  }
  a.started.send(Started.Up(port, lp.waker()));

  // The endpoint actor is made after the socket is bound (its address is known
  // by then); until it is handed over, datagrams wait in the socket's queue
  mut ep Option[Endpoint] = None;
  match a.epRx.recv() {
    case imm e Some { ep = Some[Endpoint](e); }
    case is None[Endpoint] { return 0u32; }
  }
  imm pool = Pool.make();
  lp.submit(Op.RecvFrom(sock, pool.mustTake(recvRoom)), Target.Here(1u64));
  mut out = List[Completion].empty();
  mut wakeAt = -1i64;
  mut running = true;
  mut failures = 0u32;
  mut inflightSends = 0usize;
  while running {
    imm until = if wakeAt >= 0i64 {Instant.fromNanos(wakeAt);} else {forever();};
    lp.poll(until, &mut out);
    each c in out.drain() {
      if c.token == 1u64 {
        // The receive ended: a datagram, or a failure
        if c.isDone() {
          failures = 0u32;
          match &ep {
            case imm e &Some[Endpoint] { e.datagram(c.peer, copyBytes(c.buf.view())); }
            else {}
          }
        } else {
          failures = failures + 1u32;
        }
        if failures > 1000u32 {
          running = false;
        } else {
          lp.submit(Op.RecvFrom(sock, pool.mustTake(recvRoom)), Target.Here(1u64));
        }
      } else {
        if inflightSends > 0usize {inflightSends = inflightSends - 1usize;}
      }
    }
    // What the actors asked for
    while running {
      match a.cmds.tryRecv() {
        case imm cmd Some {
          match cmd {
            case imm s Send {
              mut b = pool.mustTake(max(s.data.len(), 1usize));
              b.append(s.data.view());
              lp.submit(Op.SendTo(sock, s.addr, b), Target.Here(2u64));
              inflightSends = inflightSends + 1usize;
            }
            case imm w Wake {
              if wakeAt < 0i64 or w.at < wakeAt {wakeAt = w.at;}
            }
            case is Stop { running = false; }
          }
        }
        case is None[Cmd] { break; }
      }
    }
    if wakeAt >= 0i64 and Instant.now().nanos() >= wakeAt {
      wakeAt = -1i64;
      match &ep {
        case imm e &Some[Endpoint] { e.tick(); }
        else {}
      }
    }
  }
  // Let the datagrams already handed over go out (Stop, or a socket that has
  // failed): wait for them, a moment at most
  imm limit = Instant.now() + Duration.fromMillis(300i64);
  while inflightSends > 0usize and Instant.now() < limit {
    lp.poll(limit, &mut out);
    each c in out.drain() {
      if c.token != 1u64 and inflightSends > 0usize {inflightSends = inflightSends - 1usize;}
    }
  }
  0u32;
}

fn max(a usize, b usize) usize {
  if a > b {a;} else {b;}
}
