// Opening a connection: Fiedler's challenge handshake ("Client Server
// Connection"), so that a spoofed source address cannot open one and a server
// cannot be used to amplify an attack. Sans-IO like the rest of the core.
//
//   client                                      server
//   Request   {client salt}, padded to 1200  ->
//                                            <- Challenge {client salt, cookie}
//   Response  {client salt, cookie}, padded  ->
//                                            <- Accept    {session}
//   Payload packets, each carrying the session, both ways
//
// The cookie is a keyed hash (SipHash-2-4) of the client's address, its salt
// and the time (in ten-second steps, the last two honoured), under a key only
// the server holds. So the server holds nothing for a client that has only
// sent a Request: it recomputes the cookie when the Response comes and
// believes the client can receive at the address it claims only if it sent
// the right one. Both ends then know the session, the client's salt xor the
// cookie, which every later packet carries; a packet with another session is
// dropped. The Request and the Response are padded to 1200 bytes and the
// Challenge is 21: an attacker's spoofed Request makes the server send a
// reply a sixtieth the size of what was sent to it.
//
// No encryption in v1: the session is a shared secret between the ends, and
// an attacker who can read the packets can read and forge everything. The
// place for it is here: the Accept and each payload packet are where a key
// agreed in the handshake would be used.

// The least size of a Request or a Response
pub const handshakeSize = 1200usize;

const epochNs = 10000000000i64;
const msNs2 = 1000000i64;

// A fresh 64-bit number from a generator seeded from the OS: client salts
pub fn freshSeed() u64 {
  processSeed() ^ u64.from(Instant.now().nanos())
}

// What the ChallengeGate decided about a datagram from an address it knows nothing
// about yet
pub enum GateVerdict {
  Ignore;                                  // not for it
  Reply;                                   // send the reply it wrote back to the address
  pub struct Accept {pub session: u64;}     // a client proved its address: here is its session; the reply is its Accept
}

// The server's side of the handshake, holding one secret key
pub struct ChallengeGate {
  k0: u64;
  k1: u64;

  // A gate with a key of 128 bits made from 'seed', which should be secret and
  // unpredictable (freshSeed())
  pub fn make(seed: u64) ChallengeGate {
    var rng = Rng.make(seed);
    ChallengeGate(rng.next(), rng.next())
  }

  fn cookie(self: &, addr: &str, salt: u64, epoch: i64) u64 {
    var m = streams.Writer.make(16usize + addr.len);
    m.putBE[u64](salt);
    m.putBE[u64](u64.from(epoch));
    m.put(addr);
    let all = m.intoBuf();
    sipHash24(k0, k1, all.view())
  }

  // The start of a datagram: its protocol id and kind. The kind, or None
  // when it is short or of another protocol
  fn kindOf(c: &mut streams.ByteCursor) Option[u8] {
    let magic = c.getBE[u32]()?;
    let kind = c.getByte()?;
    if magic != protocolId {return None[u8];}
    Some[u8](kind)
  }

  // Look at a datagram that came from 'addr' (its address as text) and is
  // not part of a connection. For Reply and Accept, 'reply' has the datagram
  // to send back put into it (a fresh Writer for each call); for Ignore it
  // is untouched.
  pub fn handle(self: &, addr: &str, data: &Array[u8], now: Instant, reply: &mut streams.Writer) GateVerdict {
    var c = streams.ByteCursor.over(data);
    let Some(kind) = ChallengeGate.kindOf(&mut c) else {return GateVerdict.Ignore;};
    let Some(salt) = c.getBE[u64]() else {return GateVerdict.Ignore;};
    let epoch = now.nanos() / epochNs;
    if kind == kindRequest {
      if data.len < handshakeSize {return GateVerdict.Ignore;}
      reply.putBE[u32](protocolId);
      reply.putByte(kindChallenge);
      reply.putBE[u64](salt);
      reply.putBE[u64](self.cookie(addr, salt, epoch));
      return GateVerdict.Reply;
    }
    if kind == kindResponse {
      if data.len < handshakeSize {return GateVerdict.Ignore;}
      let Some(got) = c.getBE[u64]() else {return GateVerdict.Ignore;};
      if got != self.cookie(addr, salt, epoch) && got != self.cookie(addr, salt, epoch - 1i64) {return GateVerdict.Ignore;}
      let session = salt ^ got;
      reply.putBE[u32](protocolId);
      reply.putByte(kindAccept);
      reply.putBE[u64](session);
      return GateVerdict.Accept(session);
    }
    GateVerdict.Ignore
  }

  // The datagram that tells a client its connection was refused (the server
  // is full)
  pub fn denied(salt: u64) IoBuf {
    var p = streams.Writer.make(13usize);
    p.putBE[u32](protocolId);
    p.putByte(kindDenied);
    p.putBE[u64](salt);
    p.intoBuf()
  }

  // The client salt in a Response datagram, or 0 if it is not one
  pub fn saltOf(data: &Array[u8]) u64 {
    var c = streams.ByteCursor.over(data);
    let Some(kind) = ChallengeGate.kindOf(&mut c) else {return 0u64;};
    if kind != kindResponse {return 0u64;}
    c.getBE[u64]() || 0u64
  }
}

// Where a client's connection attempt stands
pub enum HandshakeState {
  Requesting,     // sending Requests, waiting for the Challenge
  Responding,     // sending Responses, waiting for the Accept
  Connected,
  Failed
}

// What a datagram told the client
pub enum HandshakeEvent {
  Nothing,
  Connected,
  Refused
}

// The client's side of the handshake
pub struct ClientHandshake {
  cfg: NetConfig;
  salt: u64;
  cookie: u64;
  session: u64;
  state: HandshakeState;
  startedAt: i64;
  lastSent: i64;
  refused: bool;

  // A connection attempt that begins now, under 'salt' (freshSeed())
  pub fn make(cfg: NetConfig, salt: u64, now: Instant) ClientHandshake {
    ClientHandshake(cfg, salt, 0u64, 0u64, HandshakeState.Requesting, now.nanos(), now.nanos() - cfg.connectRetryMs * msNs2, false)
  }

  pub fn handshakeState(self: &) HandshakeState {state}
  pub fn isConnected(self: &) bool {state == HandshakeState.Connected}
  pub fn isFailed(self: &) bool {state == HandshakeState.Failed}
  pub fn wasRefused(self: &) bool {refused}
  pub fn sessionId(self: &) u64 {session}

  // When to call poll next: the next Request or Response is due, or the
  // attempt times out
  pub fn nextDeadline(self: &) Instant {
    var at = startedAt + cfg.connectTimeoutMs * msNs2;
    if state == HandshakeState.Requesting || state == HandshakeState.Responding {
      let retry = lastSent + cfg.connectRetryMs * msNs2;
      if retry < at {at = retry;}
    }
    Instant.fromNanos(at)
  }

  // Append the datagram due, if any: a Request or a Response (each repeated
  // every connectRetryMs until answered). The attempt fails when
  // connectTimeoutMs pass with no Accept.
  pub fn poll(self: &mut, now: Instant, out: &mut Packets) {
    let t = now.nanos();
    if state != HandshakeState.Requesting && state != HandshakeState.Responding {return;}
    if t - startedAt >= cfg.connectTimeoutMs * msNs2 {
      state = HandshakeState.Failed;
      return;
    }
    if t - lastSent < cfg.connectRetryMs * msNs2 {return;}
    lastSent = t;
    var p = streams.Writer.make(handshakeSize);
    p.putBE[u32](protocolId);
    if state == HandshakeState.Requesting {
      p.putByte(kindRequest);
      p.putBE[u64](salt);
    } else {
      p.putByte(kindResponse);
      p.putBE[u64](salt);
      p.putBE[u64](cookie);
    }
    p.repeat(0u8, handshakeSize - p.len());
    out.push(p.intoBuf());
  }

  // A datagram from the server. A Challenge moves on to the Responses; an
  // Accept connects; a Denied is a refusal. A payload packet of the right
  // session also connects (the Accept may have been lost): the caller gives
  // that packet to the connection, too.
  pub fn receive(self: &mut, data: &Array[u8]) HandshakeEvent {
    if state != HandshakeState.Requesting && state != HandshakeState.Responding {return HandshakeEvent.Nothing;}
    var c = streams.ByteCursor.over(data);
    let Some(kind) = ChallengeGate.kindOf(&mut c) else {return HandshakeEvent.Nothing;};
    if kind == kindChallenge {
      let Some(s) = c.getBE[u64]() else {return HandshakeEvent.Nothing;};
      let Some(ck) = c.getBE[u64]() else {return HandshakeEvent.Nothing;};
      if s == salt && state == HandshakeState.Requesting {
        cookie = ck;
        session = salt ^ ck;
        state = HandshakeState.Responding;
        lastSent = startedAt - cfg.connectRetryMs * msNs2;     // answer at once
      }
      return HandshakeEvent.Nothing;
    }
    if state != HandshakeState.Responding {return HandshakeEvent.Nothing;}
    if kind == kindAccept || kind == kindPayload {
      let Some(s) = c.getBE[u64]() else {return HandshakeEvent.Nothing;};
      if s == session {
        state = HandshakeState.Connected;
        return HandshakeEvent.Connected;
      }
      return HandshakeEvent.Nothing;
    }
    if kind == kindDenied {
      let Some(s) = c.getBE[u64]() else {return HandshakeEvent.Nothing;};
      if s == salt {
        state = HandshakeState.Failed;
        refused = true;
        return HandshakeEvent.Refused;
      }
    }
    HandshakeEvent.Nothing
  }
}
