// A UDP endpoint: the actor that owns a socket, opens connections, and routes
// each datagram to the actor of the connection it belongs to. A server's
// endpoint accepts any number of clients (up to NetConfig.maxClients); a
// client's has the one connection it dialed.
//
//   imm server = mustListen(SocketAddr.localhost(0u16), NetConfig.defaults(), handler);
//   imm client = mustConnect(SocketAddr.localhost(server.port), NetConfig.defaults(), handler2);
//   ...
//   server.endpoint.shutdown();
//   client.endpoint.shutdown();
//
// THE SOCKET IS AIO'S. The endpoint holds an aio.UdpSocket, a handle on one of
// the I/O thread's sockets (one thread for every aio user in the program), and
// does its I/O by awaiting, as any actor does. Nothing of the protocol is in
// that; it moves bytes and time between the socket and the connections:
//
//   receive   one behaviour that loops: 'await sock.recvManyIn(batch, ...)' (the
//             next datagram and any already waiting, up to 64 for a server, 8
//             for a client, into the one DatagramBatch the endpoint keeps), then each datagram is handled in place
//             (onDatagram). It is paused at the await, so the actor handles its
//             other messages meanwhile.
//   send      each connection sends its own datagrams, through a UdpSender (this
//             socket's sending side) that it holds, awaited on its own worker. The
//             endpoint sends only its own handshake datagrams (Challenge, Accept,
//             Denied, and a client's Request and Response): 'sendOwn', a message to
//             itself, 'await sock.sendTo(addr, buf)'.
//   timer     only a client's dialing has one here: 'wake(at)', 'await
//             aio.sleepUntil(at)', then the dialer is polled. Each connection keeps its
//             own deadline with its own timer, in a cancel group under 'group'.
//   shutdown  closes the connections (each answers when its own datagrams are handed
//             to the socket), waits (300 ms at most) for the endpoint's own, cancels
//             'group' (which ends the receive and every timer) and drops the socket,
//             which closes it; a send through a connection's UdpSender then answers
//             InvalidInput and is dropped.
//
// DEFAULTS CHOSEN HERE (the move from a thread of its own per endpoint, which
// had its own iocore Loop, to aio): the socket is bound by a first message,
// 'open', and listen/connect wait for its answer on a Oneshot (so they block
// their caller until the socket is bound, as they did while the pump thread
// started; called from a behaviour they need a second worker to bind on, and
// panic with one worker rather than deadlock). A datagram longer than
// recvRoom arrives cut (recvMany's wasCut): it is dropped, and does
// not count toward the failures that end the receive. 1000 failures in a row end the
// receive, as they ended the pump. A program that ends in the instant it
// calls shutdown() (without waiting for the peers to hear it) may lose the
// disconnect datagrams still queued for the I/O thread: an actor paused on I/O
// is not "running", so the program's end does not wait for it (aio's header,
// THE PROGRAM'S END); the peers then time out as for any lost datagram.
//
// EVENTS reach the application through one EventHandler, a ValueSink[NetEvent]
// shared by all the connections (see events.cone and Connection); the endpoint's
// own Left (a dial that failed, with no connection) goes to it directly.

// A connection an endpoint holds
struct ConnectionSlot {
  addr: SocketAddr;        // the other end's address
  id: u32;
  conn: Connection;
  session: u64;
}

// Where each connection's slot is in 'slots', by the other end's address
alias SlotsByAddr = Dict[SocketAddr, usize];

// The deadline of a connection that has not asked for one
const farFuture = 0x7FFFFFFFFFFFFFFFi64;

// The room asked of the pool for each receive (its smallest buffer holds 4 KiB,
// and that is what a datagram may be): a longer one is Truncated
const recvRoom = 2048usize;

// How many datagrams one receive may take at once: a server has many peers, a
// client one (aio takes at most 64)
const serverBatch = 64u32;
const clientBatch = 8u32;

// The most receives that fail one after the other before the endpoint stops receiving
const maxFailures = 1000u32;

// How long shutdown waits for the datagrams already handed to the socket
const flushMillis = 300i64;

pub actor Endpoint {
  server: bool;
  cfg: NetConfig;
  handler: EventHandler;
  sock: UdpSocket;             // bound by 'open'; UdpSocket.none() before, and after shutdown
  group: CancelGroup;           // cancelled by shutdown: ends the receive and the timer
  timer: CancelGroup;           // the armed timer's group, a child of 'group'
  timerGen: u32;                // which timer is the armed one
  inflight: usize;              // datagrams handed to the socket and not yet sent
  gate: ChallengeGate;
  slots: List[ConnectionSlot];
  byAddr: SlotsByAddr;          // the slot's index in 'slots', for each slot's address
  nextId: u32;
  armed: i64;                   // the instant the timer will next wake us; -1 none
  stopped: bool;

  // a client's
  dialer: ClientHandshake;
  dialing: bool;
  remote: SocketAddr;

  fn init(self: &new, server: bool, cfg: NetConfig, handler: EventHandler, remote: SocketAddr, seed: u64) {
    var rng = Rng.make(seed);
    let salt = rng.next();
    let gateSeed = rng.next();
    let g = CancelGroup.make();
    *self = Self(server: server, cfg: cfg, handler: handler, sock: UdpSocket.none(),
      group: g, timer: g.child(), timerGen: 0u32, inflight: 0usize,
      gate: ChallengeGate.make(gateSeed), slots: List[ConnectionSlot](), byAddr: SlotsByAddr(), nextId: 1u32,
      armed: -1i64, stopped: false,
      dialer: ClientHandshake.make(cfg, salt, Instant.now()), dialing: !server,
      remote: remote);
  }

  // How many connections are open now
  pub async fn connections(self) u32 {
    u32.from(slots.len())
  }

  // End every connection (each tells its peer), send what is queued, close the
  // socket. Call it before the program ends. The sink's one 'end' follows; it can
  // reach a sink before a connection's 'Left' when the sink is withholding credit,
  // so treat 'end' as every connection gone.
  pub async fn shutdown(self) {
    if stopped {return;}
    stopped = true;
    var conns = List[Connection]();
    var i = 0usize;
    while i < slots.len() {
      conns.push(slots[i].conn);
      i = i + 1usize;
    }
    while conns.len() > 0usize {
      match conns.pop() {
        case let Some(c) { let r = await c.closeAndWait(); }
        case is None[Connection] {}
      }
    }
    // The ValueSource contract: one 'end' to the handler, after every Left. A
    // Connection sends none (its Left is its own end), because the handler is shared.
    handler.end(Ending.Finished);
    // The disconnect datagrams are in flight: wait for the socket to take them
    let limit = Instant.now() + Duration.fromMillis(flushMillis);
    while inflight > 0usize && Instant.now() < limit {
      let z = await aio.sleep(Duration.fromMillis(1i64));
    }
    let c = group.cancel();
    sock = UdpSocket.none();
  }

  // ------------------------------------------------------------------
  // The socket
  // ------------------------------------------------------------------

  // Bind the socket at 'bind' and say what it got (the address, with the port
  // the system chose when port 0 was asked) or why it could not; then receive.
  // The first message the endpoint is sent
  async fn open(self, bind: SocketAddr, up: OneshotSender[Result[SocketAddr, IoError]]) {
    var tx = up;
    let made = await aio.bindUdp(bind);
    var failure = IoError.ofKind(IoErrorKind.Other);
    match made {
      case let Ok(ok) { sock = ok; }
      case let Err(e) { failure = e; }
    }
    if sock.isNone() {
      tx.send(Err[SocketAddr, IoError](failure));
      return;
    }
    // What the system bound: the address asked for, and the port it chose
    var bound = bind;
    let la = await sock.localAddr();
    match &la {
      case let &Ok(a) { bound = *a; }
      else {}
    }
    tx.send(Ok[SocketAddr, IoError](bound));
    if !server {
      self.rearm();   // a client starts dialing
    }
    selfactor.receive();
  }

  // Receive datagrams until shutdown cancels the receive: the next one to arrive
  // and any already waiting (up to the batch), each handled in place in arrival
  // order. A datagram longer than recvRoom comes cut (wasCut) and is
  // dropped: its first bytes alone would look like a packet. The endpoint makes
  // one DatagramBatch and keeps it for its life: each receive is lent it and
  // answers it, and each filled buffer is swapped out of its slot for a fresh
  // one and sent on (nothing slides; a failed receive hands the batch back too)
  async fn receive(self) {
    let n = if server {serverBatch} else {clientBatch};
    var failures = 0u32;
    var batch = DatagramBatch.make(n, recvRoom);
    while !stopped && failures <= maxFailures {
      // The batch goes to the socket and comes back in the answer
      let r = await sock.recvManyIn(batch, IoLimits.within(group));
      match r {
        case var Ok(ok) {
          failures = 0u32;
          batch = ok;
          let cnt = batch.count();
          var k = 0u32;
          while k < cnt {
            let from = batch.from(k);
            // The buffer the socket filled goes on to the connection as it is
            let buf = batch.swapOut(k, IoBuf(recvRoom));
            if !batch.wasCut(k) {
              self.onDatagram(from, buf);
            }
            k = k + 1u32;
          }
        }
        case var Err(f) {
          // The batch comes back with the failure (None only where the kernel
          // still holds it: then a new one is made)
          let e, back = f.(error, batch);
          match back {
            case var Some(b) {batch = b;}
            else {batch = DatagramBatch.make(n, recvRoom);}
          }
          if aio.isCancelled(e) {return;}
          if !aio.isTruncated(e) {failures = failures + 1u32;}
        }
      }
    }
  }

  // One of the endpoint's own datagrams to send (a handshake's), to 'addr'
  async fn sendOwn(self, addr: SocketAddr, data: IoBuf) {
    if sock.isNone() {return;}
    inflight = inflight + 1usize;
    let r = await sock.sendTo(addr, data);
    inflight = inflight - 1usize;
  }

  // The timer 'g' of generation 'gen' is for the instant 'at': when it comes,
  // the dialer is polled
  async fn wake(self, at: i64, gen: u32, g: CancelGroup) {
    let r = await aio.sleepUntilIn(Instant.fromNanos(at), IoLimits.within(g));
    if slept(r) && gen == timerGen && !stopped {
      self.fire();
    }
  }

  // ------------------------------------------------------------------
  // From the connections
  // ------------------------------------------------------------------

  // A connection has ended
  // (a connection that its address's new session replaced is already out of
  // the table: its id is not the slot's, and the new one stays)
  async fn gone(self, id: u32, addr: SocketAddr) {
    let k = self.find(&addr);
    if k != notFound && slots[k].id == id {
      self.removeSlot(k);
    }
  }

  // ------------------------------------------------------------------
  // Inside
  // ------------------------------------------------------------------

  // A datagram arrived, from 'from'
  fn onDatagram(self, from: SocketAddr, data: IoBuf) {
    if stopped {return;}
    if !server && from != remote {return;}
    let kind = if data.len() > 4usize {data.view()[4usize]} else {255u8};
    if kind == kindPayload || kind == kindDisconnect {
      let k = self.find(&from);
      if dialing {
        // Not both at once in practice (a dial that connects ends the dialing),
        // so the copy for the connection is never made on the way a game runs
        if k != notFound {
          slots[k].conn.packet(copyPacket(data.view()));
        }
        self.dial(data);
        return;
      }
      if k != notFound {
        slots[k].conn.packet(data);
      }
      return;
    }
    if !server {
      self.dial(data);
      return;
    }
    var reply = streams.Writer.make(32usize);
    // The gate keeps its state by the address's text; only a handshake makes it
    let key = from.text();
    let verdict = gate.handle(key.view(), data.view(), Instant.now(), &mut reply);
    match verdict {
      case is Ignore {}
      case is Reply { self.transmit(from, reply.intoBuf()); }
      case let Accept(a) { self.admit(from, a.session, reply.intoBuf(), data.view()); }
    }
  }

  // The timer is due: the dialer is
  fn fire(self) {
    armed = -1i64;
    let now = Instant.now();
    if dialing {
      var out = Packets();
      dialer.poll(now, &mut out);
      each p in out.drain() { self.transmit(remote, p); }
      if dialer.isFailed() {
        dialing = false;
        // Id 1 is no live connection: only a dial that connects makes one (with id 1,
        // in 'dial', which ends the dialing), and a server never dials
        handler.accept(NetEvent.Left(1u32, if dialer.wasRefused() {CloseReason.Refused} else {CloseReason.NoAnswer}));
      }
    }
    self.rearm();
  }

  fn find(self: &, addr: &SocketAddr) usize {
    match byAddr.getCopy(addr) {
      case let Some(k) { return k; }
      else {}
    }
    notFound
  }

  // Take slot k out of the table: the last slot moves into its place (the
  // order of 'slots' is otherwise kept) and its entry is re-pointed
  fn removeSlot(self, k: usize) {
    let dropped = byAddr.remove(&slots[k].addr);
    let last = slots.len() - 1usize;
    if k != last {
      slots.swap(k, last);
    }
    slots.pop();
    if k != last {
      let moved = slots[k].addr;
      byAddr.insert(moved, k);
    }
  }

  // Queue one of the endpoint's own datagrams for the socket (a message to ourselves)
  fn transmit(self, to: SocketAddr, data: IoBuf) {
    selfactor.sendOwn(to, data);
  }

  // Arm the timer for the dialer's deadline, if it is earlier than the one
  // armed: the armed one's group is cancelled. Nothing to do when not dialing
  fn rearm(self) {
    if stopped || !dialing {return;}
    let at = dialer.nextDeadline().nanos();
    if at != farFuture && (armed < 0i64 || at < armed) {
      armed = at;
      let c = timer.cancel();
      timer = group.child();
      timerGen = timerGen + 1u32;
      selfactor.wake(at, timerGen, timer);
    }
  }

  // A client proved it receives at its address: open its connection, or
  // answer a Response that has already been taken
  fn admit(self, from: SocketAddr, session: u64, accept: IoBuf, response: &Array[u8]) {
    let k = self.find(&from);
    if k != notFound {
      if slots[k].session == session {
        // The Accept was lost; say it again
        self.transmit(from, accept);
        return;
      }
      // The same address, a new session: the old connection is dead
      slots[k].conn.close();
      self.removeSlot(k);
    } else if slots.len() >= cfg.maxClients {
      self.transmit(from, ChallengeGate.denied(ChallengeGate.saltOf(response)));
      return;
    }
    let id = nextId;
    nextId = nextId + 1u32;
    let conn = Connection(connUdp, id, handler, cfg, session, from,
      Some[Endpoint](selfactor), sock.sender(), group.child(), LinkConfig.perfect(), 0u64);
    byAddr.insert(from, slots.len());
    slots.push(ConnectionSlot(from, id, conn, session));
    self.transmit(from, accept);
  }

  // The client side of the handshake: a datagram from the server
  fn dial(self, data: IoBuf) {
    let ev = dialer.receive(data.view());
    match ev {
      case is Connected {
        let id = 1u32;
        let conn = Connection(connUdp, id, handler, cfg, dialer.sessionId(), remote,
          Some[Endpoint](selfactor), sock.sender(), group.child(), LinkConfig.perfect(), 0u64);
        byAddr.insert(remote, slots.len());
        slots.push(ConnectionSlot(remote, id, conn, dialer.sessionId()));
        dialing = false;
        // The datagram that connected us may be a payload packet
        conn.packet(data);
      }
      case is Refused {
        dialing = false;
        // As in 'fire': dialing was on, so id 1 is no live connection
        handler.accept(NetEvent.Left(1u32, CloseReason.Refused));
      }
      case is Nothing {}
    }
  }
}

// Whether a timer ran its course: not cancelled, and not failed
fn slept(r: Result[void, IoError]) bool {
  match r {
    case let Err(e) {false}
    else {true}
  }
}

// ---------------------------------------------------------------------------
// Starting one
// ---------------------------------------------------------------------------

// An endpoint bound to a UDP port: the actor to shut down, and the port the
// socket has (the system's choice when port 0 was asked). A server's and a
// client's alike
pub struct BoundEndpoint {
  pub endpoint: Endpoint;
  pub port: u16;
  bound: SocketAddr;

  // The address the socket is bound to, with the port the system chose (what
  // POSIX's getsockname and Rust's local_addr give); its port is 'port'
  pub fn localAddress(self: &) SocketAddr { bound }
}

// Binding takes a second worker when the caller is one: the endpoint binds on
// the I/O thread and answers from a worker, and this call waits for it
fn requireAWorker() {
  if actors.workerIndex() != actors.noWorker && actors.stats().workers < 2u32 {
    panic("netmsg: listen and connect called from a behaviour need a second worker to bind the socket");
  }
}

// The endpoint, its socket bound at 'bind' (the other end of a client's is
// 'remote'): the error that stopped it binding, or the endpoint and the
// address the socket got
fn start(server: bool, bind: SocketAddr, remote: SocketAddr, cfg: NetConfig, h: EventHandler) Result[BoundEndpoint, IoError] {
  requireAWorker();
  let ep = Endpoint(server, cfg, h, remote, freshSeed());
  var tx: OneshotSender[Result[SocketAddr, IoError]];
  var rx: OneshotReceiver[Result[SocketAddr, IoError]];
  tx, rx = Oneshot[Result[SocketAddr, IoError]].make();
  ep.open(bind, tx);
  let Some(answer) = rx.recv() else {return Err[BoundEndpoint, IoError](IoError.aborted());};
  let a = answer?;
  Ok[BoundEndpoint, IoError](BoundEndpoint(ep, a.port(), a))
}

// What a client binds its UDP socket to, port 0, for a server at 'server': the
// loopback address of the server's family when the server is on loopback (a
// socket bound to the wildcard can ask the firewall for permission even when it
// only talks to this machine), otherwise the wildcard address of that family
fn clientBindAddress(server: &SocketAddr) SocketAddr {
  if server.isLoopback() {
    if server.isV6() {
      return SocketAddr.v6Localhost(0u16);
    }
    return SocketAddr.localhost(0u16);
  }
  if server.isV6() {
    var zeros = List[u8]();
    putZeros(&mut zeros, 16usize);
    SocketAddr.v6(zeros.view(), 0u16)
  } else {
    SocketAddr.v4(0u8, 0u8, 0u8, 0u8, 0u16)
  }
}

// Listen for clients at 'bind' (port 0 has the system choose one: 'port'
// says which). Every client's events go to 'h'. Call 'endpoint.shutdown()'
// before the program ends.
pub fn listen(bind: SocketAddr, cfg: NetConfig, h: EventHandler) Result[BoundEndpoint, IoError] {
  start(true, bind, bind, cfg, h)
}

// Connect to the server at 'server': the handshake runs in the background,
// and 'h' hears Joined when it is done, or Left (NoAnswer or Refused) if it
// fails. Call 'endpoint.shutdown()' before the program ends.
pub fn connect(server: SocketAddr, cfg: NetConfig, h: EventHandler) Result[BoundEndpoint, IoError] {
  start(false, clientBindAddress(&server), server, cfg, h)
}

// Like listen and connect, but a panic if the socket cannot be bound. (They do
// not unwrap the Result: Cone moves no value out of a matched variant's
// field.)
pub fn mustListen(bind: SocketAddr, cfg: NetConfig, h: EventHandler) BoundEndpoint {
  match &start(true, bind, bind, cfg, h) {
    case let &Ok(b) { return *b; }
    else {}
  }
  panic("netmsg: cannot bind the server's UDP socket")
}

pub fn mustConnect(server: SocketAddr, cfg: NetConfig, h: EventHandler) BoundEndpoint {
  match &start(false, clientBindAddress(&server), server, cfg, h) {
    case let &Ok(b) { return *b; }
    else {}
  }
  panic("netmsg: cannot bind the client's UDP socket")
}
