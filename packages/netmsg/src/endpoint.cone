// A UDP endpoint: the actor that owns a socket, opens connections, and routes
// each datagram to the actor of the connection it belongs to. A server's
// endpoint accepts any number of clients (up to NetConfig.maxClients); a
// client's has the one connection it dialed.
//
//   imm server = mustListen(SocketAddr.localhost(0u16), NetConfig.defaults(), handler);
//   imm client = mustConnect(SocketAddr.localhost(server.port), NetConfig.defaults(), handler2);
//   ...
//   server.endpoint.shutdown();
//   client.endpoint.shutdown();
//
// THE SOCKET IS AIO'S. The endpoint holds an aio.UdpSocket, a handle on one of
// the I/O thread's sockets (one thread for every aio user in the program), and
// does its I/O by awaiting, as any actor does. Nothing of the protocol is in
// that; it moves bytes and time between the socket and the connections:
//
//   receive   one behaviour that loops: 'await sock.recvFromIn(buf, ...)', then
//             the datagram is handled in place (onDatagram). It is paused
//             at the await, so the actor handles its other messages meanwhile.
//   send      a message to the endpoint (Connection.run sends one per packet):
//             'await sock.sendTo(addr, buf)'. Several are in flight at once.
//   timer     'wake(at)': 'await aio.sleepUntil(at)', then the due connections
//             are ticked. At most one timer is armed: the earliest deadline any
//             connection (or the dialer) has asked for; asking for an earlier
//             one cancels the armed one's cancel group.
//   shutdown  closes the connections, waits (300 ms at most) for the datagrams
//             handed to the socket, cancels 'group' (which ends the receive and
//             the timer) and drops the socket, which closes it.
//
// DEFAULTS CHOSEN HERE (the move from a thread of its own per endpoint, which
// had its own iocore Loop, to aio): the socket is bound by a first message,
// 'open', and listen/connect wait for its answer on a Oneshot (so they block
// their caller until the socket is bound, as they did while the pump thread
// started; called from a behaviour they need a second worker to bind on, and
// panic with one worker rather than deadlock). A datagram longer than
// recvRoom is Truncated (aio.isTruncated): it is dropped, and does not count
// toward the failures that end the receive. 1000 failures in a row end the
// receive, as they ended the pump. A program that ends in the instant it
// calls shutdown() (without waiting for the peers to hear it) may lose the
// disconnect datagrams still queued for the I/O thread: an actor paused on I/O
// is not "running", so the program's end does not wait for it (aio's header,
// THE PROGRAM'S END); the peers then time out as for any lost datagram.
//
// STILL SHARED: events reach the application through one EventHandler closure
// under Arc[Mutex] for all connections, because actors cannot yet be generic or
// take a trait; it becomes direct actor messages once they can.

// A connection an endpoint holds
struct ConnectionSlot {
  key: String;             // the other end's address as text
  id: u32;
  conn: Connection;
  session: u64;
  due: i64;                // when the connection asked to be ticked (steady-clock ns)
}

// The deadline of a connection that has not asked for one
const farFuture = 0x7FFFFFFFFFFFFFFFi64;

// The room asked of the pool for each receive (its smallest buffer holds 4 KiB,
// and that is what a datagram may be): a longer one is Truncated
const recvRoom = 2048usize;

// The most receives that fail one after the other before the endpoint stops receiving
const maxFailures = 1000u32;

// How long shutdown waits for the datagrams already handed to the socket
const flushMillis = 300i64;

pub actor Endpoint {
  server: bool;
  cfg: NetConfig;
  handler: EventHandler;
  pool: Pool;
  sock: UdpSocket;             // bound by 'open'; UdpSocket.none() before, and after shutdown
  group: CancelGroup;           // cancelled by shutdown: ends the receive and the timer
  timer: CancelGroup;           // the armed timer's group, a child of 'group'
  timerGen: u32;                // which timer is the armed one
  inflight: usize;              // datagrams handed to the socket and not yet sent
  gate: ChallengeGate;
  slots: List[ConnectionSlot];
  nextId: u32;
  armed: i64;                   // the instant the timer will next wake us; -1 none
  stopped: bool;

  // a client's
  dialer: ClientHandshake;
  dialing: bool;
  remote: SocketAddr;
  remoteKey: String;

  fn init(self: &new, server: bool, cfg: NetConfig, handler: EventHandler, remote: SocketAddr, seed: u64) {
    var rng = Rng.make(seed);
    let salt = rng.next();
    let gateSeed = rng.next();
    let g = CancelGroup.make();
    *self = Self(server: server, cfg: cfg, handler: handler, pool: Pool.make(), sock: UdpSocket.none(),
      group: g, timer: g.child(), timerGen: 0u32, inflight: 0usize,
      gate: ChallengeGate.make(gateSeed), slots: List[ConnectionSlot].empty(), nextId: 1u32,
      armed: -1i64, stopped: false,
      dialer: ClientHandshake.make(cfg, salt, Instant.now()), dialing: !server,
      remote: remote, remoteKey: remote.text());
  }

  // How many connections are open now
  pub async do connections(self) u32 {
    u32.from(slots.len())
  }

  // End every connection (each tells its peer), send what is queued, close the
  // socket. Call it before the program ends.
  pub async do shutdown(self) {
    if stopped {return;}
    stopped = true;
    var conns = List[Connection].empty();
    var i = 0usize;
    while i < slots.len() {
      conns.push(slots[i].conn);
      i = i + 1usize;
    }
    while conns.len() > 0usize {
      match conns.pop() {
        case let c Some { let r = await c.closeAndWait(); }
        case is None[Connection] {}
      }
    }
    // The disconnect datagrams are in flight: wait for the socket to take them
    let limit = Instant.now() + Duration.fromMillis(flushMillis);
    while inflight > 0usize && Instant.now() < limit {
      let z = await aio.sleep(Duration.fromMillis(1i64));
    }
    let c = group.cancel();
    var dead = UdpSocket.none();
    dead <-> sock;
  }

  // ------------------------------------------------------------------
  // The socket
  // ------------------------------------------------------------------

  // Bind the socket at 'bind' and say what it got (the address, with the port
  // the system chose when port 0 was asked) or why it could not; then receive.
  // The first message the endpoint is sent
  async do open(self, bind: SocketAddr, up: OneshotSender[Result[SocketAddr, IoError]]) {
    var tx = up;
    var made = await aio.bindUdp(bind);
    match &mut made {
      case var ok &mut Ok { sock <-> *ok; }
      else {}
    }
    if sock.isNone() {
      match &made {
        case let e &Error { tx.send(Error[SocketAddr, IoError](*e)); }
        else { tx.send(Error[SocketAddr, IoError](IoError(1u32))); }
      }
      return;
    }
    // What the system bound: the address asked for, and the port it chose
    var bound = bind;
    let la = await sock.localAddr();
    match &la {
      case let a &Ok { bound = *a; }
      else {}
    }
    tx.send(Ok[SocketAddr, IoError](bound));
    if !server {
      self.rearm();   // a client starts dialing
    }
    selfactor.receive();
  }

  // Receive datagrams, one at a time, until shutdown cancels the receive
  async do receive(self) {
    var failures = 0u32;
    while !stopped && failures <= maxFailures {
      let r = await sock.recvFromIn(pool.mustTake(recvRoom), IoLimits.within(group));
      match &r {
        case let ok &Ok {
          failures = 0u32;
          self.onDatagram(ok.from, copyBytes(ok.buf.view()));
        }
        case let e &Error {
          if aio.isCancelled(*e) {return;}
          if !aio.isTruncated(*e) {failures = failures + 1u32;}
        }
      }
    }
  }

  // A packet to send: one datagram to 'addr'
  async do send(self, addr: SocketAddr, data: List[u8]) {
    if sock.isNone() {return;}
    var b = pool.mustTake(max(data.len(), 1usize));
    b.append(data.view());
    inflight = inflight + 1usize;
    let r = await sock.sendTo(addr, b);
    inflight = inflight - 1usize;
  }

  // The timer 'g' of generation 'gen' is for the instant 'at': when it comes,
  // the connections and the dialer that are due are ticked
  async do wake(self, at: i64, gen: u32, g: CancelGroup) {
    let r = await aio.sleepUntilIn(Instant.fromNanos(at), IoLimits.within(g));
    if slept(r) && gen == timerGen && !stopped {
      self.fire();
    }
  }

  // ------------------------------------------------------------------
  // From the connections
  // ------------------------------------------------------------------

  // A connection says when it next needs a tick
  async do deadline(self, id: u32, at: i64) {
    var i = 0usize;
    while i < slots.len() {
      if slots[i].id == id {
        slots[i].due = at;
      }
      i = i + 1usize;
    }
    self.rearm();
  }

  // A connection has ended
  async do gone(self, id: u32) {
    var i = 0usize;
    while i < slots.len() {
      if slots[i].id == id {
        slots.swap(i, slots.len() - 1usize);
        slots.pop();
        return;
      }
      i = i + 1usize;
    }
  }

  // ------------------------------------------------------------------
  // Inside
  // ------------------------------------------------------------------

  // A datagram arrived, from 'from'
  fn onDatagram(self, from: SocketAddr, data: List[u8]) {
    if stopped {return;}
    let key = from.text();
    if !server && key != remoteKey {return;}
    let kind = if data.len() > 4usize {*data[4usize]} else {255u8};
    if kind == kindPayload || kind == kindDisconnect {
      let k = self.find(key.view());
      if k != notFound {
        slots[k].conn.packet(copyBytes(data.view()));
      }
      if dialing {
        self.dial(data);
      }
      return;
    }
    if !server {
      self.dial(data);
      return;
    }
    var reply = List[u8].empty();
    let verdict = gate.handle(key.view(), data.view(), Instant.now(), &mut reply);
    match verdict {
      case is Ignore {}
      case is Reply { self.transmit(from, reply); }
      case let a Accept { self.admit(from, key.view(), a.session, reply, data.view()); }
    }
  }

  // The timer is due: some connection, or the dialer, is due
  fn fire(self) {
    armed = -1i64;
    let now = Instant.now();
    if dialing {
      var out = List[List[u8]].empty();
      dialer.poll(now, &mut out);
      each p in out.drain() { self.transmit(remote, p); }
      if dialer.isFailed() {
        dialing = false;
        (&mut *handler).call(NetEvent.Left(1u32, if dialer.wasRefused() {CloseReason.Refused} else {CloseReason.NoAnswer}));
      }
    }
    var i = 0usize;
    while i < slots.len() {
      let s = &mut slots[i];
      if s.due <= now.nanos() {
        s.due = farFuture;
        s.conn.tick();
      }
      i = i + 1usize;
    }
    self.rearm();
  }

  fn find(self: &, key: &str) usize {
    var i = 0usize;
    while i < slots.len() {
      if slots[i].key == key {return i;}
      i = i + 1usize;
    }
    notFound
  }

  // Queue a datagram for the socket (a message to ourselves, as a connection's are)
  fn transmit(self, to: SocketAddr, data: List[u8]) {
    selfactor.send(to, data);
  }

  // Arm the timer for the earliest deadline there is, if it is earlier than
  // the one armed: the armed one's group is cancelled
  fn rearm(self) {
    if stopped {return;}
    var at = farFuture;
    if dialing {
      at = dialer.nextDeadline().nanos();
    }
    var i = 0usize;
    while i < slots.len() {
      if slots[i].due < at {at = slots[i].due;}
      i = i + 1usize;
    }
    if at != farFuture && (armed < 0i64 || at < armed) {
      armed = at;
      let c = timer.cancel();
      timer = group.child();
      timerGen = timerGen + 1u32;
      selfactor.wake(at, timerGen, timer);
    }
  }

  // A client proved it receives at its address: open its connection, or
  // answer a Response that has already been taken
  fn admit(self, from: SocketAddr, key: &str, session: u64, accept: List[u8], response: &Array[u8]) {
    let k = self.find(key);
    if k != notFound {
      if slots[k].session == session {
        // The Accept was lost; say it again
        self.transmit(from, accept);
        return;
      }
      // The same address, a new session: the old connection is dead
      slots[k].conn.close();
      slots.swap(k, slots.len() - 1usize);
      slots.pop();
    } elif slots.len() >= cfg.maxClients {
      self.transmit(from, ChallengeGate.denied(ChallengeGate.saltOf(response)));
      return;
    }
    let id = nextId;
    nextId = nextId + 1u32;
    let conn = Connection(connUdp, id, handler, cfg, session, from,
      Some[Endpoint](selfactor), LinkConfig.perfect(), 0u64);
    slots.push(ConnectionSlot(String.from(key), id, conn, session, Instant.now().nanos()));
    self.transmit(from, accept);
  }

  // The client side of the handshake: a datagram from the server
  fn dial(self, data: List[u8]) {
    let ev = dialer.receive(data.view());
    match ev {
      case is Connected {
        let id = 1u32;
        let conn = Connection(connUdp, id, handler, cfg, dialer.sessionId(), remote,
          Some[Endpoint](selfactor), LinkConfig.perfect(), 0u64);
        slots.push(ConnectionSlot(String.from(remoteKey.view()), id, conn, dialer.sessionId(), Instant.now().nanos()));
        dialing = false;
        // The datagram that connected us may be a payload packet
        conn.packet(data);
      }
      case is Refused {
        dialing = false;
        (&mut *handler).call(NetEvent.Left(1u32, CloseReason.Refused));
      }
      case is Nothing {}
    }
  }
}

fn max(a: usize, b: usize) usize {
  if a > b {a} else {b}
}

// Whether a timer ran its course: not cancelled, and not failed
fn slept(r: Result[void, IoError]) bool {
  match r {
    case let e Error {false}
    else {true}
  }
}

// ---------------------------------------------------------------------------
// Starting one
// ---------------------------------------------------------------------------

// An endpoint bound to a UDP port: the actor to shut down, and the port the
// socket has (the system's choice when port 0 was asked). A server's and a
// client's alike
pub struct BoundEndpoint {
  pub endpoint: Endpoint;
  pub port: u16;
  bound: SocketAddr;

  // The address the socket is bound to, with the port the system chose (what
  // POSIX's getsockname and Rust's local_addr give); its port is 'port'
  pub fn localAddress(self: &) SocketAddr { bound }
}

// Binding takes a second worker when the caller is one: the endpoint binds on
// the I/O thread and answers from a worker, and this call waits for it
fn requireAWorker() {
  if actors.workerIndex() != actors.noWorker && actors.stats().workers < 2u32 {
    panic("netmsg: listen and connect called from a behaviour need a second worker to bind the socket");
  }
}

// The endpoint, its socket bound at 'bind' (the other end of a client's is
// 'remote'): the error that stopped it binding, or the endpoint and the
// address the socket got
fn start(server: bool, bind: SocketAddr, remote: SocketAddr, cfg: NetConfig, h: EventHandler) Result[BoundEndpoint, IoError] {
  requireAWorker();
  let ep = Endpoint(server, cfg, h, remote, freshSeed());
  var tx: OneshotSender[Result[SocketAddr, IoError]];
  var rx: OneshotReceiver[Result[SocketAddr, IoError]];
  tx, rx = Oneshot[Result[SocketAddr, IoError]].make();
  ep.open(bind, tx);
  match rx.recv() {
    case let answer Some {
      match &answer {
        case let a &Ok { return Ok[BoundEndpoint, IoError](BoundEndpoint(ep, a.port(), *a)); }
        case let e &Error { return Error[BoundEndpoint, IoError](*e); }
      }
    }
    case is None[Result[SocketAddr, IoError]] {}
  }
  Error[BoundEndpoint, IoError](IoError(1u32))
}

// What a client binds its UDP socket to, port 0, for a server at 'server': the
// loopback address of the server's family when the server is on loopback (a
// socket bound to the wildcard can ask the firewall for permission even when it
// only talks to this machine), otherwise the wildcard address of that family
fn clientBindAddress(server: &SocketAddr) SocketAddr {
  if server.isLoopback() {
    if server.isV6() {
      return SocketAddr.v6Localhost(0u16);
    }
    return SocketAddr.localhost(0u16);
  }
  if server.isV6() {
    var zeros = List[u8].empty();
    putZeros(&mut zeros, 16usize);
    SocketAddr.v6(zeros.view(), 0u16)
  } else {
    SocketAddr.v4(0u8, 0u8, 0u8, 0u8, 0u16)
  }
}

// Listen for clients at 'bind' (port 0 has the system choose one: 'port'
// says which). Every client's events go to 'h'. Call 'endpoint.shutdown()'
// before the program ends.
pub fn listen(bind: SocketAddr, cfg: NetConfig, h: EventHandler) Result[BoundEndpoint, IoError] {
  start(true, bind, bind, cfg, h)
}

// Connect to the server at 'server': the handshake runs in the background,
// and 'h' hears Joined when it is done, or Left (NoAnswer or Refused) if it
// fails. Call 'endpoint.shutdown()' before the program ends.
pub fn connect(server: SocketAddr, cfg: NetConfig, h: EventHandler) Result[BoundEndpoint, IoError] {
  start(false, clientBindAddress(&server), server, cfg, h)
}

// Like listen and connect, but a panic if the socket cannot be bound. (They do
// not unwrap the Result: Cone moves no value out of a matched variant's
// field.)
pub fn mustListen(bind: SocketAddr, cfg: NetConfig, h: EventHandler) BoundEndpoint {
  match &start(true, bind, bind, cfg, h) {
    case let b &Ok { return *b; }
    else {}
  }
  panic("netmsg: cannot bind the server's UDP socket")
}

pub fn mustConnect(server: SocketAddr, cfg: NetConfig, h: EventHandler) BoundEndpoint {
  match &start(false, clientBindAddress(&server), server, cfg, h) {
    case let b &Ok { return *b; }
    else {}
  }
  panic("netmsg: cannot bind the client's UDP socket")
}
