// What the application hears from a connection, and the handler that carries
// it there.
//
// Every connection, whether it crosses a network or joins two actors in one
// process, tells the application the same few things, as NetEvents delivered to a
// ValueSink[NetEvent] (an EventHandler): an actor of the application's own, or one
// of the two small adapters here that carry them to a closure ('eventHandler') or
// a channel ('channelHandler'). They arrive one at a time per connection, in the
// order they happened, as a stream of values with credit (stages, valuesink.cone).

// Why a send was refused
pub enum RefusalKind {
  TooLarge,         // over maxReliableBytes (a message) or maxLatestBytes (a value)
  TooManyStreams   // a 65th latest-wins stream
}

// What happened on a connection. 'id' names the connection: the server numbers
// the clients as they join, from 1; a client's one connection is 1.
pub enum NetEvent {
  // The connection is open: send to it through 'conn'
  pub struct Joined {pub id: u32; pub conn: Connection;}
  // It has ended. Nothing more arrives for this id
  pub struct Left {pub id: u32; pub reason: CloseReason;}
  // A send was refused and nothing was sent: the message or value is bigger
  // than one packet carries (fragmentation is not built), or the connection
  // already has the most streams. It comes to the handler of the connection
  // that was sent on, once for each refusal; the connection goes on. 'size' is
  // the bytes offered and 'limit' the most allowed.
  pub struct Refused {pub id: u32; pub reliable: bool; pub stream: u16; pub why: RefusalKind; pub size: usize; pub limit: usize;}
  // A reliable message from the other end: each arrives once, in the order sent
  pub struct Message {pub id: u32; pub data: List[u8];}
  // The newest value of a latest-wins stream; an older one never follows it
  pub struct Update {pub id: u32; pub stream: u16; pub data: List[u8];}
}

// WHERE EVENTS GO. An EventHandler is a ValueSink[NetEvent], so a connection (a
// ValueSource) sends an event only against credit its sink has granted, one unit per
// event: a sink that is slow slows its connection, or ends it (see Connection), and
// never blocks it. Joined, Left and Refused are control items: they pass without
// credit. ONE SINK SERVES EVERY CONNECTION of a server, so a sink with several sources
// must tell them apart from the item: it keeps the Connection each Joined(id, conn)
// carries, credits that one by NetEvent.id as it uses events, and forgets it on Left.
// The adapters below do exactly this: each grants a window of 64 when a connection
// attaches and one more unit per event it has handled. An application actor that is
// its own ValueSink does the same, or credits as it likes.
pub alias EventHandler = ValueSink[NetEvent];

// The window the adapters grant each connection
const handlerWindow = 64u32;

// The connections a sink has been told of, by NetEvent.id, to credit the right one
struct Roster {
  conns: Dict[u32, Connection];

  // An event is about to be handled: remember a connection that joined
  fn noteJoined(self: &mut, ev: &NetEvent) {
    match ev {
      case let &Joined(j) { self.conns.insert(j.id, j.conn); }
      else {}
    }
  }

  // The event has been handled: credit its connection one unit, or let it go on Left
  fn used(self: &mut, id: u32, left: bool) {
    if left {
      self.conns.remove(&id);
      return;
    }
    match self.conns.get(&id) {
      case let Some(c) { c.credit(1u32); }
      else {}
    }
  }
}

fn idOf(ev: &NetEvent) u32 {
  match ev {
    case let &Joined(j) { j.id }
    case let &Left(l) { l.id }
    case let &Refused(r) { r.id }
    case let &Message(m) { m.id }
    case let &Update(u) { u.id }
  }
}

fn isLeft(ev: &NetEvent) bool {
  match ev {
    case is Left { true }
    else { false }
  }
}

// An EventHandler that calls f with each event
pub actor ClosureSink is ValueSink[NetEvent] {
  f: Uni[fn(ev: NetEvent) + Sendable];
  roster: Roster;

  pub fn init(self: &new, f: Uni[fn(ev: NetEvent) + Sendable]) {
    *self = Self(f: f, roster: Roster(Dict[u32, Connection]()));
  }

  pub async fn attach(self, up: ValueSource) {
    up.credit(handlerWindow);
  }

  pub async fn accept(self, ev: NetEvent) {
    let id = idOf(&ev);
    let left = isLeft(&ev);
    roster.noteJoined(&ev);
    f(ev);
    roster.used(id, left);
  }

  pub async fn end(self, how: Ending) {}
}

// An EventHandler that puts each event on a channel, for a thread to take
pub actor ChannelSink is ValueSink[NetEvent] {
  tx: Sender[NetEvent];
  roster: Roster;

  pub fn init(self: &new, tx: Sender[NetEvent]) {
    *self = Self(tx: tx, roster: Roster(Dict[u32, Connection]()));
  }

  pub async fn attach(self, up: ValueSource) {
    up.credit(handlerWindow);
  }

  pub async fn accept(self, ev: NetEvent) {
    let id = idOf(&ev);
    let left = isLeft(&ev);
    roster.noteJoined(&ev);
    tx.send(ev);
    roster.used(id, left);
  }

  pub async fn end(self, how: Ending) {}
}

// An EventHandler that calls f with each event
pub fn eventHandler(f: Uni[fn(ev: NetEvent) + Sendable]) EventHandler {
  let s: EventHandler = ClosureSink(f);
  s
}

// An EventHandler that puts each event on a channel, for a thread to take
pub fn channelHandler(tx: Sender[NetEvent]) EventHandler {
  let s: EventHandler = ChannelSink(tx);
  s
}
