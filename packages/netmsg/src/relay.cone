// A relay that makes a real network behave badly: it takes datagrams from
// clients on a UDP port of its own, passes each to the server through a
// LinkSim, and brings the server's answers back the same way, so a client and
// a server on loopback meet loss, delay, jitter, duplication and reordering
// with real sockets and the real protocol, in both directions. For tests and
// demos; it is not part of the protocol.
//
//   imm relay = startLossyRelay(SocketAddr.localhost(server.port),
//                          LinkConfig.lossy(200u32, 30i64, 20i64), LinkConfig.lossy(200u32, 30i64, 20i64), 1u64);
//   // clients connect to SocketAddr.localhost(relay.port)
//   ...
//   relay.stop();
//
// An actor on aio's UdpSockets, as an Endpoint is (endpoint.cone's header):
// one behaviour receives on the front socket, one on each client's own socket
// to the server (a "leg", made when the client first speaks), and one wakes
// every millisecond to deliver the datagrams the links hold back that have come
// due. The delays are real time, to a millisecond.

// One client's way through the relay
struct Leg {
  client: SocketAddr;
  key: String;
  up: UdpSocket;              // the socket this client's datagrams reach the server from
  toServer: LinkSim;
  toClient: LinkSim;
}

// The most receives on one socket that fail one after the other before it is let go
const relayMaxFailures = 1000u32;

actor Relay {
  server: SocketAddr;
  toServer: LinkConfig;
  toClient: LinkConfig;
  seed: u64;
  pool: Pool;
  front: UdpSocket;
  legs: List[Leg];
  group: CancelGroup;
  stopped: bool;

  fn init(self: &new, server: SocketAddr, toServer: LinkConfig, toClient: LinkConfig, seed: u64) {
    *self = Self(server: server, toServer: toServer, toClient: toClient, seed: seed, pool: Pool.make(),
      front: UdpSocket.none(), legs: List[Leg].empty(), group: CancelGroup.make(), stopped: false);
  }

  // Bind the front socket (on loopback, a port of the system's choice), say
  // which, and start receiving and delivering. The first message
  async do open(self, up: OneshotSender[Result[SocketAddr, IoError]]) {
    var tx = up;
    var made = await aio.bindUdp(SocketAddr.localhost(0u16));
    match &mut made {
      case var ok &mut Ok { front <-> *ok; }
      else {}
    }
    if front.isNone() {
      tx.send(Error[SocketAddr, IoError](IoError(1u32)));
      return;
    }
    var bound = SocketAddr.localhost(0u16);
    let la = await front.localAddr();
    match &la {
      case let a &Ok { bound = *a; }
      else {}
    }
    tx.send(Ok[SocketAddr, IoError](bound));
    selfactor.receiveFront();
    selfactor.tick();
  }

  // Stop: end every receive and timer, close every socket, and say so
  async do stop(self, done: OneshotSender[u32]) {
    var tx = done;
    stopped = true;
    let c = group.cancel();
    var dead = UdpSocket.none();
    dead <-> front;
    legs = List[Leg].empty();
    tx.send(1u32);
  }

  // Datagrams from clients: each goes through its leg's link to the server
  async do receiveFront(self) {
    var failures = 0u32;
    while !stopped && failures <= relayMaxFailures {
      let r = await front.recvFromIn(pool.mustTake(recvRoom), IoLimits.within(group));
      var client = SocketAddr.localhost(0u16);
      var data = List[u8].empty();
      var got = false;
      match &r {
        case let ok &Ok {
          client = ok.from;
          data = copyBytes(ok.buf.view());
          got = true;
          failures = 0u32;
        }
        case let e &Error {
          if aio.isCancelled(*e) {return;}
          if !aio.isTruncated(*e) {failures = failures + 1u32;}
        }
      }
      if got && !stopped {
        let key = client.text();
        var found = self.leg(key.view());
        if found == legs.len() {
          // The client's first datagram: its socket to the server
          var made = await aio.bindUdp(SocketAddr.localhost(0u16));
          if stopped {return;}
          var up = UdpSocket.none();
          match &mut made {
            case var ok &mut Ok { up <-> *ok; }
            else {}
          }
          if up.isNone() {return;}
          let n = u64.from(legs.len());
          legs.push(Leg(client, key, up,
            LinkSim.make(toServer, seed + 2u64 * n), LinkSim.make(toClient, seed + 2u64 * n + 1u64)));
          selfactor.receiveLeg(legs.len() - 1usize);
          found = legs.len() - 1usize;
        }
        legs[found].toServer.send(Instant.now(), data);
        self.deliver();
      }
    }
  }

  // Datagrams from the server to leg n's client
  async do receiveLeg(self, n: usize) {
    var failures = 0u32;
    while !stopped && n < legs.len() && failures <= relayMaxFailures {
      let r = await legs[n].up.recvFromIn(pool.mustTake(recvRoom), IoLimits.within(group));
      match &r {
        case let ok &Ok {
          failures = 0u32;
          if !stopped && n < legs.len() {
            legs[n].toClient.send(Instant.now(), copyBytes(ok.buf.view()));
            self.deliver();
          }
        }
        case let e &Error {
          if aio.isCancelled(*e) {return;}
          if !aio.isTruncated(*e) {failures = failures + 1u32;}
        }
      }
    }
  }

  // Every millisecond: what the links hold back that is due goes out
  async do tick(self) {
    while !stopped {
      let r = await aio.sleepIn(Duration.fromMillis(1i64), IoLimits.within(group));
      self.deliver();
    }
  }

  // One datagram out of leg n: to the server (upstream) or to the client
  async do out(self, n: usize, upstream: bool, data: List[u8]) {
    if stopped || n >= legs.len() {return;}
    var b = pool.mustTake(max(data.len(), 1usize));
    b.append(data.view());
    if upstream {
      let r = await legs[n].up.sendTo(server, b);
    } else {
      let r = await front.sendTo(legs[n].client, b);
    }
  }

  // The leg of the client at 'key', or legs.len() if it has none
  fn leg(self: &, key: &str) usize {
    var k = 0usize;
    while k < legs.len() {
      if legs[k].key == key {return k;}
      k = k + 1usize;
    }
    legs.len()
  }

  // What is due goes out
  fn deliver(self) {
    if stopped {return;}
    let now = Instant.now();
    var d = List[List[u8]].empty();
    var i = 0usize;
    while i < legs.len() {
      legs[i].toServer.deliver(now, &mut d);
      each p in d.drain() { selfactor.out(i, true, p); }
      legs[i].toClient.deliver(now, &mut d);
      each p in d.drain() { selfactor.out(i, false, p); }
      i = i + 1usize;
    }
  }
}

pub struct LossyRelay {
  pub port: u16;
  relay: Relay;

  // Stop the relay and wait for it
  pub fn stop(self: &mut) {
    var tx: OneshotSender[u32];
    var rx: OneshotReceiver[u32];
    tx, rx = Oneshot[u32].make();
    relay.stop(tx);
    rx.recv();
  }
}

// Start a relay to the server at 'server': 'toServer' is what happens to the
// clients' datagrams, 'toClient' to the server's answers. The seed makes the
// losses repeatable. Clients connect to localhost at 'port'.
pub fn startLossyRelay(server: SocketAddr, toServer: LinkConfig, toClient: LinkConfig, seed: u64) LossyRelay {
  requireAWorker();
  let relay = Relay(server, toServer, toClient, seed);
  var tx: OneshotSender[Result[SocketAddr, IoError]];
  var rx: OneshotReceiver[Result[SocketAddr, IoError]];
  tx, rx = Oneshot[Result[SocketAddr, IoError]].make();
  relay.open(tx);
  match rx.recv() {
    case let answer Some {
      match &answer {
        case let a &Ok { return LossyRelay(a.port(), relay); }
        else {}
      }
    }
    case is None[Result[SocketAddr, IoError]] {}
  }
  panic("netmsg: the relay could not start")
}
