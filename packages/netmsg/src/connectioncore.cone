// The connection core: one connection's half of the protocol, with no socket,
// no clock and no thread. A ConnectionCore takes the packets that arrived (with the
// time) and the data the application wants sent, and gives back the packets
// to send, the events to tell the application, and the time it next needs
// to be called. The same ConnectionCore runs inside an actor, inside a test on a
// synthetic clock, and on either side of a connection.
//
// The design is Glenn Fiedler's (Gaffer On Games): every packet carries its
// own sequence number, the latest sequence received, and a bitfield of the 32
// before it, so each acknowledgement is sent about 33 times and survives
// heavy loss. A packet is never resent; what was in it is: a reliable
// message is kept until a packet that carried it is acknowledged and goes in
// later packets until then, and latest-wins data is sent once and superseded
// by a newer value.

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

// The first four bytes of every packet: 'NMS1', the protocol and its version
pub const protocolId = 0x4E4D5331u32;

// The kinds of packet (the byte after the protocol id)
pub const kindRequest = 0u8;
pub const kindChallenge = 1u8;
pub const kindResponse = 2u8;
pub const kindAccept = 3u8;
pub const kindPayload = 4u8;
pub const kindDisconnect = 5u8;
pub const kindDenied = 6u8;

// A payload packet's fixed part: protocol id 4, kind 1, session 8, sequence 2,
// ack 2, ack bits 4, then a count of reliable messages 1 and of latest-wins
// items 1
pub const headerSize = 23usize;

// Bytes a reliable message adds to its data (id 2, length and flags 2) and a
// latest-wins item adds (stream 2, sequence 2, length and flags 2)
pub const reliableOverhead = 4usize;
pub const latestOverhead = 6usize;

// Slots in each ring: packets sent and received, reliable messages in
// flight. A power of two, and far more than the 33 packets an ack covers
const ringSize = 1024usize;

// Reliable messages queued or unacknowledged at once
pub const reliableWindow = 1024usize;

// Latest-wins streams one connection carries, each way: a send for a 65th
// stream is refused (TooManyStreams); an update from the peer on a 65th, or one
// waiting for the application on a 65th, is dropped and counted
// (ConnectionStats.streamsRefused)
pub const maxStreams = 64usize;

// Disconnect packets sent when a connection closes, so one of them gets
// through
const disconnectCopies = 5usize;

const msNs = 1000000i64;

// Sends are paced by a token bucket: a token comes back every interval (the good
// or bad rate's) and the bucket holds burstTokens at most. A packet takes a
// token. A connection that sends rarely finds the bucket full, so an update
// goes at once with no timer; one that sends at the rate waits for the next
// token. In any window the packets sent are at most the window over the
// interval, plus burstTokens.
const burstTokens = 2i64;
const secNs = 1000000000i64;
const notFound = 0xFFFFFFFFusize;

// ---------------------------------------------------------------------------
// Configuration, events, statistics
// ---------------------------------------------------------------------------

// The knobs of a connection, the same on both ends, and the limits a server puts
// on its peers. The limits are what a misbehaving peer can make a server spend:
//   maxClients     connections a server holds at once (64)
//   maxPerAddress  of those, from one IP address (32); an IPv6 address counts by
//                  its /64 (its first four groups), and an IPv4-mapped IPv6
//                  address by the IPv4 address in it. It is not lower because
//                  carrier-grade NAT puts many users behind one IPv4 address,
//                  and a proxy in front of the server does the same
//   admitRate      new connections admitted a second across the whole server
//                  (50), in a bucket that holds twice that many, so a burst of
//                  100 gets in at once and the rest as it refills; 0 is no
//                  limit
//   a session from a socket address (IP and port) that already has a connection
//   replaces it (a reconnect); replacements from one socket address are held to
//   one a second. A replacement takes no place and no admission
//   maxStreams     latest-wins streams one connection carries each way (64)
// A client past a limit hears the same refusal as at maxClients (Left, Refused).
// A server that raises maxClients to thousands must raise the others beside it
// when its clients share addresses: netbench's all come from 127.0.0.1, and
// at 50 a second 1,000 to 5,000 of them would take 20 to 100 seconds to join, so
// netbench, and any measurement that starts clients from one machine, sets
// maxPerAddress (to its client count or more) and admitRate (to 0) wherever it
// sets maxClients. A limit that tests never meet is one a server behind a proxy
// meets first, so loopback has no exemption.
pub struct NetConfig {
  pub maxPacket: usize;       // the largest datagram sent, bytes (1200)
  pub goodRate: u32;          // packets a second sent in good conditions (30)
  pub badRate: u32;           // ... when the round trip is long (10)
  pub badRttMs: i64;          // a smoothed round trip above this is bad (250)
  pub keepAliveMs: i64;       // a packet at least this often, with nothing to say (100)
  pub timeoutMs: i64;         // no packet this long ends the connection (10000)
  pub resendMinMs: i64;       // a reliable message is not resent sooner (40)
  pub connectRetryMs: i64;    // a handshake packet is repeated this often (250)
  pub connectTimeoutMs: i64;  // a handshake that takes this long has failed (5000)
  pub maxClients: usize;      // a server's connections (64)
  pub maxPerAddress: usize;   // a server's connections from one IP address, IPv6 by its /64 (32)
  pub admitRate: u32;         // new connections a server admits a second, with a burst of twice that (50)

  pub fn defaults() NetConfig {
    NetConfig(1200usize, 30u32, 10u32, 250i64, 100i64, 10000i64, 40i64, 250i64, 5000i64, 64usize, 32usize, 50u32)
  }
}

// Why a connection ended
pub enum CloseReason {
  Local,       // this side closed it
  Remote,      // the other side did
  TimedOut,    // no packet arrived for the timeout
  Overflow,    // too many reliable messages were waiting: to be sent, or for the local application to take
  Refused,     // a connection attempt was refused: the server was full
  NoAnswer,   // a connection attempt got no answer in time
  SendFailed  // the socket failed a send (anything but a full send buffer): it cannot be trusted with more
}

// What happened that the application should hear of
pub enum CoreEvent {
  pub struct Reliable {pub data: Bytes;}                        // a reliable message, in order
  pub struct Latest {pub stream: u16; pub data: Bytes; pub pos: usize;}  // the newest value of a stream, and the stream's position among those heard of (never changes)
  pub struct Closed {pub reason: CloseReason;}                   // the connection ended
}

// What a connection has measured
pub struct ConnectionStats {
  pub packetsSent: u64;
  pub packetsReceived: u64;       // valid, new packets
  pub packetsDuplicate: u64;      // valid packets that had arrived before
  pub packetsInvalid: u64;        // refused: wrong session, short, malformed
  pub bytesSent: u64;
  pub bytesReceived: u64;
  pub reliableSent: u64;          // reliable messages in packets, resends included
  pub reliableResent: u64;        // ... of which resends
  pub reliableDelivered: u64;     // reliable messages given to the application
  pub latestSent: u64;
  pub latestDelivered: u64;
  pub latestStale: u64;           // arrived late: an older value than one already delivered
  pub sendErrors: u64;            // datagrams the socket refused (a full send buffer, or a failure that ended the connection)
  pub streamsRefused: u64;        // updates dropped for a latest-wins stream past the maxStreams a connection carries (the peer's, or ones waiting for the application)
  pub cellSkipped: u64;           // cell versions passed over: a bound stream's cell (bindLatest) was more than one version past the last one sent, and the ones between were never sent
  pub cellRefused: u64;           // incoming values dropped because the cell bound to their stream (bindIncoming) takes fewer bytes than they have
  pub rttMs: i64;                 // smoothed round trip time; 0 before the first sample
  pub rttVarMs: i64;
  pub lossPermille: u32;          // of our packets, in a thousand, that never got acknowledged
  pub good: bool;                 // sending at the good rate
}

// ---------------------------------------------------------------------------
// The state of a connection
// ---------------------------------------------------------------------------

// The largest reliable message, and the largest latest-wins value, a
// connection with this configuration carries, in bytes
pub fn maxReliableBytes(cfg: NetConfig) usize {cfg.maxPacket - headerSize - reliableOverhead}
pub fn maxLatestBytes(cfg: NetConfig) usize {cfg.maxPacket - headerSize - latestOverhead}

// A packet sent: kept until the ring slot is needed again
struct SentSlot {
  seq: u16;
  used: bool;
  acked: bool;
  sentAt: i64;
  msgs: List[u16];            // the reliable messages it carried
}

// A reliable message waiting to be acknowledged
struct RelSlot {
  id: u16;
  used: bool;
  acked: bool;
  lastSent: i64;              // when a packet last carried it; -1 never
  data: Option[Bytes];        // the caller's bytes, kept to resend; None when unused or parked
  heap: List[u8];             // a message that had to wait for credit, kept as a copy of its own bytes
  parked: bool;               // the message is in 'heap', not in 'data'
}

// A reliable message a packet carried
struct RelRecv {
  id: u16;
  data: Bytes;
}

// A latest-wins stream going out
struct StreamOut {
  key: u16;
  weight: u32;                // priority gained each packet while a value waits
  acc: u32;                   // priority gathered so far
  nextSeq: u16;
  pending: bool;
  data: Option[Bytes];        // the caller's bytes, until a packet carries them
  cell: Option[LatestReader]; // a bound stream (bindLatest): the cell whose newest value each packet takes
  seen: u64;                  // the cell version last sent; 0 none yet
}

// A latest-wins stream coming in: the newest sequence delivered
struct StreamIn {
  key: u16;
  seq: u16;
}

// The start of a packet: protocol id, kind, session. The kind, or None when
// the packet is too short, or is of another protocol or session
fn readPrefix(c: &mut streams.ByteCursor, protocol: u32, session: u64) Option[u8] {
  let magic = c.getBE[u32]()?;
  let kind = c.getByte()?;
  let sess = c.getBE[u64]()?;
  if magic != protocol || sess != session {return None[u8];}
  Some[u8](kind)
}

// The bytes a slot holds: none when it is unused
fn lenOf(d: &Option[Bytes]) usize {
  match d {
    case let &Some[Bytes](b) { b.len() }
    else { 0usize }
  }
}

fn relLen(s: &RelSlot) usize {
  if s.parked {s.heap.len()} else {lenOf(&s.data)}
}

fn relPut(p: &mut streams.Writer, s: &RelSlot) {
  if s.parked {p.put(s.heap.view());} else {putData(p, &s.data);}
}

fn putData(p: &mut streams.Writer, d: &Option[Bytes]) {
  match d {
    case let &Some[Bytes](b) { p.put(b.view()); }
    else {}
  }
}

// The rest of a payload packet, after its prefix, parsed whole into 'pk': false
// when it is short, malformed, or has bytes left over, and then 'pk' holds no
// messages or values. 'pk' is the core's own, kept from packet to packet: its
// two lists are cleared here and refilled, and keep their room, so a packet
// costs no allocation once the lists have held a packet's most (255 each)
fn parseBody(c: &mut streams.ByteCursor, dg: &Bytes, pk: &mut Parsed) bool {
  pk.rel.clear();
  pk.lat.clear();
  if !parseInto(c, dg, pk) {
    pk.rel.clear();
    pk.lat.clear();
    return false;
  }
  true
}

fn parseInto(c: &'a mut streams.ByteCursor, dg: &Bytes, pk: &mut Parsed) bool {
  let Some(seq) = c.getBE[u16]() else {return false;};
  let Some(ack) = c.getBE[u16]() else {return false;};
  let Some(bits) = c.getBE[u32]() else {return false;};
  pk.seq = seq;
  pk.ack = ack;
  pk.bits = bits;
  let Some(nRel) = c.getByte() else {return false;};
  let Some(nLat) = c.getByte() else {return false;};
  var i = 0u8;
  while i < nRel {
    let Some(id) = c.getBE[u16]() else {return false;};
    let Some(lf) = c.getBE[u16]() else {return false;};
    // The top two bits are reserved for fragmentation (not built): a
    // message that sets either is refused
    if (lf >> 14u16) != 0u16 {return false;}
    let from = c.pos();
    let Some(body) = c.getBytes(usize.from(lf & 0x3FFFu16)) else {return false;};
    pk.rel.push(RelRecv(id, dg.slice(from, from + body.len)));
    i = i + 1u8;
  }
  i = 0u8;
  while i < nLat {
    let Some(stream) = c.getBE[u16]() else {return false;};
    let Some(lseq) = c.getBE[u16]() else {return false;};
    let Some(lf) = c.getBE[u16]() else {return false;};
    if (lf >> 14u16) != 0u16 {return false;}
    let from = c.pos();
    let Some(body) = c.getBytes(usize.from(lf & 0x3FFFu16)) else {return false;};
    pk.lat.push(LatestItem(stream, lseq, dg.slice(from, from + body.len)));
    i = i + 1u8;
  }
  c.isEmpty()
}

// The reliable messages that arrived before the ones ahead of them: a ring of
// ringSize slots, message id in slot id % ringSize, each holding the message's
// own copy or None. The window is reliableWindow ids ahead of the next one to
// give out, and equals ringSize, so no two ids waiting share a slot
alias RecvRing = List[Option[List[u8]]];

// What one packet carries, parsed before any of it is acted on. The core keeps
// one, and each packet is parsed into it in turn
struct Parsed {
  seq: u16;
  ack: u16;
  bits: u32;
  rel: List[RelRecv];
  lat: List[LatestItem];
}

struct LatestItem {
  stream: u16;
  seq: u16;
  data: Bytes;
}

pub enum CoreState {
  Active, Closing, Closed
}

// One connection's half of the protocol
pub struct ConnectionCore {
  cfg: NetConfig;
  session: u64;
  state: CoreState;
  closeReason: CloseReason;

  // packets
  nextSeq: u16;
  sent: List[SentSlot];
  seen: List[u32];            // sequence + 1 of the packet received in each slot; 0 none
  remoteSeq: u16;             // the newest packet sequence received
  gotAny: bool;
  scan: u16;                  // the oldest sent packet whose fate is not yet known
  ackedMax: u16;              // the newest ack received
  gotAck: bool;

  // reliable messages
  rel: List[RelSlot];
  relOldest: u16;             // the oldest id not yet acknowledged
  relNext: u16;               // the id the next message gets
  recv: RecvRing;             // received out of order, waiting for the ones before them: id's slot is id % ringSize (own copies, see takeReliable)
  relDeliver: u16;            // the next id to give the application
  parsed: Parsed;             // the packet being received, its two lists kept from packet to packet

  // latest-wins streams: two tables inside the core, each of maxStreams (64;
  // an Array's size is a literal) entries, the first nOuts and nIns in use, in
  // the order the streams were first used or heard of. Nothing removes an
  // entry, so an entry's position is the same for the connection's life: an
  // incoming stream's position goes up with each of its values
  // (CoreEvent.Latest.pos) and the Connection keeps its waiting values by it
  outs: Array[StreamOut, 64];
  nOuts: usize;
  waitingOuts: usize;         // outs entries whose value waits for a packet
  nCells: usize;              // outs entries bound to a cell (bindLatest)
  ins: Array[StreamIn, 64];
  nIns: usize;

  // time
  lastRecv: i64;
  lastSend: i64;
  fullAt: i64;                // when the send bucket is full again; at or before now, it is full
  ackDirty: bool;             // a reliable message arrived that no packet of ours has acknowledged
  closeSent: bool;
  cellCheckAt: i64;           // while a cell is bound: when a send slot next looks at the cells. A cell cannot say it changed, so
                              // each slot looks; a poll that finds nothing new moves this one interval on, or the deadline
                              // would stay in the past and the connection's clock would spin (see nextDeadline)

  // measurements
  hasRtt: bool;
  srtt: i64;                  // ns
  rttvar: i64;
  lossFx: i64;                // fraction of packets lost, in 1/65536
  good: bool;
  goodSince: i64;             // when the round trip last became acceptable; -1
  penalty: i64;               // how long it must stay acceptable to go back to good
  lastPenaltyAt: i64;
  st: ConnectionStats;

  // A new connection that begins now, with the session both ends know
  pub fn make(cfg: NetConfig, session: u64, now: Instant) ConnectionCore {
    var sent = List[SentSlot].withCapacity(ringSize);
    var seen = List[u32].withCapacity(ringSize);
    var rel = List[RelSlot].withCapacity(ringSize);
    var recv = RecvRing.withCapacity(ringSize);
    var i = 0usize;
    while i < ringSize {
      sent.push(SentSlot(0u16, false, false, 0i64, List[u16]()));
      seen.push(0u32);
      recv.push(None[List[u8]]);
      rel.push(RelSlot(0u16, false, false, -1i64, None[Bytes], List[u8](), false));
      i = i + 1usize;
    }
    let t = now.nanos();
    ConnectionCore(cfg, session, CoreState.Active, CloseReason.Local,
      0u16, sent, seen, 65535u16, false, 0u16, 0u16, false,
      rel, 0u16, 0u16, recv, 0u16, Parsed(0u16, 0u16, 0u32, List[RelRecv](), List[LatestItem]()),
      Array[StreamOut, 64]() <- fill StreamOut(0u16, 1u32, 0u32, 0u16, false, None[Bytes], None[LatestReader], 0u64), 0usize, 0usize, 0usize,
      Array[StreamIn, 64]() <- fill StreamIn(0u16, 0u16), 0usize,
      t, t - cfg.keepAliveMs * msNs, t, false, false, t,
      false, 0i64, 0i64, 0i64, true, -1i64, 4i64 * secNs, t,
      ConnectionStats(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0i64, 0i64, 0u32, true))
  }

  pub fn sessionId(self: &) u64 {session}
  pub fn isActive(self: &) bool {state == CoreState.Active}
  pub fn isClosed(self: &) bool {state == CoreState.Closed}

  // The largest reliable message, in bytes
  pub fn maxReliable(self: &) usize {cfg.maxPacket - headerSize - reliableOverhead}

  // The largest latest-wins value, in bytes
  pub fn maxLatest(self: &) usize {cfg.maxPacket - headerSize - latestOverhead}

  // ------------------------------------------------------------------
  // What the application sends
  // ------------------------------------------------------------------

  // Queue a reliable message: it arrives once, in order, whatever the link
  // does. False, and nothing queued, when it is bigger than maxReliable() or
  // reliableWindow() messages are already waiting: the application decides
  // what to do about a peer that is not keeping up. A message of no bytes is
  // a message.
  pub fn sendReliable(self: &mut, data: Bytes) bool {
    if state != CoreState.Active || data.len() > self.maxReliable() {return false;}
    let waiting = usize.from(relNext - relOldest);
    if waiting >= reliableWindow {return false;}
    let s = &mut rel[usize.from(relNext) % ringSize];
    s.id = relNext;
    s.used = true;
    s.acked = false;
    s.lastSent = -1i64;
    // A message with others waiting ahead of it has to wait for credit: it is
    // kept as a copy of its own bytes (the caller's buffer, a pool buffer of
    // 4 KiB at least, goes back). One that can go at the next poll is not copied.
    let behind = relNext != relOldest && rel[usize.from(relNext - 1u16) % ringSize].lastSent < 0i64;
    if behind {
      s.heap = copyBytes(data.view());
      s.parked = true;
      s.data = None[Bytes];
    } else {
      s.parked = false;
      s.data = Some[Bytes](data);
    }
    relNext = relNext + 1u16;
    true
  }

  // Reliable messages not yet acknowledged (queued or in flight)
  pub fn reliablePending(self: &) usize {usize.from(relNext - relOldest)}

  // Set the value of a latest-wins stream: it goes in the next packet that has
  // room, unless a newer value replaces it first, and is never resent. False
  // when the value is bigger than maxLatest() or the connection already has
  // maxStreams() streams.
  pub fn sendLatest(self: &mut, stream: u16, data: Bytes) bool {
    if state != CoreState.Active || data.len() > self.maxLatest() {return false;}
    var k = self.findOut(stream);
    if k == notFound {
      if nOuts >= maxStreams {return false;}
      outs[nOuts] = StreamOut(stream, 1u32, 0u32, 0u16, false, None[Bytes], None[LatestReader], 0u64);
      k = nOuts;
      nOuts = nOuts + 1usize;
    }
    let s = &mut outs[k];
    s.data = Some[Bytes](data);
    if !s.pending {
      s.pending = true;
      waitingOuts = waitingOuts + 1usize;
    }
    true
  }

  // How much a stream's waiting value counts when a packet has room for only
  // some: its priority grows by 'weight' with every packet it waits through,
  // and the highest goes first. 1 for a stream not set.
  pub fn setStreamWeight(self: &mut, stream: u16, weight: u32) {
    var k = self.findOut(stream);
    if k == notFound {
      if nOuts >= maxStreams {return;}
      outs[nOuts] = StreamOut(stream, weight, 0u32, 0u16, false, None[Bytes], None[LatestReader], 0u64);
      nOuts = nOuts + 1usize;
      return;
    }
    outs[k].weight = weight;
  }

  // Bind a stream to a cell: from now each send slot carries the cell's newest
  // value on the stream, if newer than the last one sent, under 'weight' (as
  // setStreamWeight's). A value waiting from sendLatest is dropped; a stream
  // already bound lets go of its old cell (its reader is dropped here) and
  // starts afresh on the new one, whose versions are its own. The stream keeps
  // its wire sequence, so the receiver takes the new cell's first value as
  // newer than the old one's last. False, and nothing bound, when the cell takes
  // values longer than maxLatest() or the connection already has maxStreams().
  pub fn bindLatest(self: &mut, stream: u16, cell: LatestReader, weight: u32) bool {
    if state != CoreState.Active || cell.capacity() > self.maxLatest() {return false;}
    var k = self.findOut(stream);
    if k == notFound {
      if nOuts >= maxStreams {return false;}
      outs[nOuts] = StreamOut(stream, weight, 0u32, 0u16, false, None[Bytes], None[LatestReader], 0u64);
      k = nOuts;
      nOuts = nOuts + 1usize;
    }
    let s = &mut outs[k];
    if s.pending {
      s.pending = false;
      s.data = None[Bytes];
      waitingOuts = waitingOuts - 1usize;
    }
    match &s.cell {
      case is Some[LatestReader] {}
      else { nCells = nCells + 1usize; }
    }
    s.cell = Some[LatestReader](cell);
    s.seen = 0u64;
    s.weight = weight;
    s.acc = 0u32;
    // The next poll that can send looks at the cell
    cellCheckAt = lastSend;
    true
  }

  // Let go of a stream's cell: the stream is sendLatest's again, and what was
  // last sent stays the receiver's newest. False when it was not bound.
  pub fn unbindLatest(self: &mut, stream: u16) bool {
    let k = self.findOut(stream);
    if k == notFound {return false;}
    let s = &mut outs[k];
    match &s.cell {
      case is Some[LatestReader] {}
      else { return false; }
    }
    s.cell = None[LatestReader];
    s.seen = 0u64;
    s.acc = 0u32;
    nCells = nCells - 1usize;
    true
  }

  // The connection has ended: its cells' readers are let go
  fn dropCells(self: &mut) {
    var i = 0usize;
    while i < nOuts {
      outs[i].cell = None[LatestReader];
      i = i + 1usize;
    }
    nCells = 0usize;
  }

  // Whether the cell bound to outs[i] holds a version newer than the last one sent
  fn cellNewer(self: &, i: usize) bool {
    let s = &outs[i];
    match &s.cell {
      case let &Some[LatestReader](r) { r.version() > s.seen }
      else { false }
    }
  }

  // Whether any bound cell holds a version newer than the last one sent
  fn anyCellNewer(self: &) bool {
    if nCells == 0usize {return false;}
    var i = 0usize;
    while i < nOuts {
      if self.cellNewer(i) {return true;}
      i = i + 1usize;
    }
    false
  }

  fn findOut(self: &, stream: u16) usize {
    var i = 0usize;
    while i < nOuts {
      if outs[i].key == stream {return i;}
      i = i + 1usize;
    }
    notFound
  }

  fn findIn(self: &, stream: u16) usize {
    var i = 0usize;
    while i < nIns {
      if ins[i].key == stream {return i;}
      i = i + 1usize;
    }
    notFound
  }

  // Ask for the connection to end: the next poll sends the disconnect packets
  // and gives the Closed event
  pub fn close(self: &mut) {
    if state == CoreState.Active {
      state = CoreState.Closing;
    }
  }

  // ------------------------------------------------------------------
  // Measurements
  // ------------------------------------------------------------------

  // The smoothed round trip time, 0 until a packet has been acknowledged
  pub fn rtt(self: &) Duration {Duration.fromNanos(srtt)}

  pub fn rttVariation(self: &) Duration {Duration.fromNanos(rttvar)}

  // Of the packets sent, the fraction that never got acknowledged, in a
  // thousand
  pub fn lossPermille(self: &) u32 {u32.from((lossFx * 1000i64) / 65536i64)}

  // Sending at the good rate (false: the round trip is long)
  pub fn isGood(self: &) bool {good}

  pub fn stats(self: &) ConnectionStats {
    var s = st;
    s.rttMs = srtt / msNs;
    s.rttVarMs = rttvar / msNs;
    s.lossPermille = self.lossPermille();
    s.good = good;
    s
  }

  // How long before a reliable message is sent again: the smoothed round trip
  // plus four times its variation (RFC 6298's timeout), not under the
  // configured minimum; 100 ms before there is a measurement
  fn resendDelay(self: &) i64 {
    var d = 100i64 * msNs;
    if hasRtt {d = srtt + 4i64 * rttvar;}
    if d < cfg.resendMinMs * msNs {d = cfg.resendMinMs * msNs;}
    if d > 2i64 * secNs {d = 2i64 * secNs;}
    d
  }

  // The earliest instant a packet may go: when the bucket next holds a token
  fn tokenAt(self: &) i64 {
    fullAt - (burstTokens - 1i64) * self.interval()
  }

  fn interval(self: &) i64 {
    var rate = if good {cfg.goodRate} else {cfg.badRate};
    if rate == 0u32 {rate = 1u32;}
    secNs / i64.from(rate)
  }

  // ------------------------------------------------------------------
  // Time
  // ------------------------------------------------------------------

  // Whether there is anything to put in a packet now
  fn hasWork(self: &, t: i64) bool {
    if ackDirty || waitingOuts > 0usize || self.anyCellNewer() {return true;}
    let delay = self.resendDelay();
    var id = relOldest;
    while id != relNext {
      let s = &rel[usize.from(id) % ringSize];
      if s.used && !s.acked && (s.lastSent < 0i64 || t - s.lastSent >= delay) {return true;}
      id = id + 1u16;
    }
    false
  }

  // When the connection next needs poll to be called, if nothing arrives
  // first: the moment it may send a packet it wants to send, or the time it
  // gives up on the peer. After that call, ask again.
  pub fn nextDeadline(self: &) Instant {
    if state != CoreState.Active {return Instant.fromNanos(lastSend);}
    var at = lastRecv + cfg.timeoutMs * msNs;
    // When a packet could carry something
    var want = lastSend + cfg.keepAliveMs * msNs;
    if ackDirty || waitingOuts > 0usize {
      want = lastSend;
    } else {
      let delay = self.resendDelay();
      var id = relOldest;
      while id != relNext {
        let s = &rel[usize.from(id) % ringSize];
        if s.used && !s.acked {
          var due = lastSend;
          if s.lastSent >= 0i64 {due = s.lastSent + delay;}
          if due < want {want = due;}
        }
        id = id + 1u16;
      }
    }
    // A bound cell cannot say it changed, so every send slot looks: a newer
    // version already there goes at the next token; else the next look is
    // cellCheckAt, which a poll that found nothing moved on (see poll). Past
    // and left there, it would be a deadline that is always due
    if nCells > 0usize {
      if self.anyCellNewer() {
        if lastSend < want {want = lastSend;}
      } else if cellCheckAt < want {
        want = cellCheckAt;
      }
    }
    let tok = self.tokenAt();
    if want < tok {want = tok;}
    if want < at {at = want;}
    Instant.fromNanos(at)
  }

  // Move time on to 'now': appends to 'out' the packets to send (none, one,
  // or the disconnect copies) and to 'events' what happened. Call it when
  // nextDeadline says, after a packet arrives, and after sending.
  pub fn poll(self: &mut, now: Instant, out: &mut Packets, events: &mut List[CoreEvent]) {
    let t = now.nanos();
    if state == CoreState.Closed {return;}
    if state == CoreState.Closing {
      if !closeSent {
        var c = 0usize;
        while c < disconnectCopies {
          out.push(self.disconnectPacket());
          c = c + 1usize;
        }
        closeSent = true;
      }
      state = CoreState.Closed;
      self.dropCells();
      closeReason = CloseReason.Local;
      events.push(CoreEvent.Closed(CloseReason.Local));
      return;
    }
    if t - lastRecv >= cfg.timeoutMs * msNs {
      state = CoreState.Closed;
      self.dropCells();
      closeReason = CloseReason.TimedOut;
      events.push(CoreEvent.Closed(CloseReason.TimedOut));
      return;
    }
    self.updateMode(t);
    if t < self.tokenAt() {return;}
    if self.hasWork(t) || t - lastSend >= cfg.keepAliveMs * msNs {
      out.push(self.buildPacket(t));
      // Take a token: one interval more to refill, counted from now if the
      // bucket was already full
      var base = fullAt;
      if base < t {base = t;}
      fullAt = base + self.interval();
      lastSend = t;
      ackDirty = false;
    }
    // A send slot with cells bound: this look is done, the next is an interval
    // on (found nothing, or sent: either way the deadline moves forward)
    if nCells > 0usize {cellCheckAt = t + self.interval();}
  }

  // Fiedler's two-state rate control: sending at the good rate, until the
  // smoothed round trip goes over the limit; then at the bad rate until it
  // has stayed under the limit for 'penalty', which doubles (up to a minute)
  // when conditions turn bad again soon after being good, and halves (down to
  // a second) for every ten seconds spent good
  fn updateMode(self: &mut, t: i64) {
    if !hasRtt {return;}
    let over = srtt > cfg.badRttMs * msNs;
    if good {
      if over {
        good = false;
        goodSince = -1i64;
        if t - lastPenaltyAt < 10i64 * secNs {
          penalty = penalty * 2i64;
          if penalty > 60i64 * secNs {penalty = 60i64 * secNs;}
        }
        lastPenaltyAt = t;
      } else {
        if t - lastPenaltyAt >= 10i64 * secNs {
          penalty = penalty / 2i64;
          if penalty < secNs {penalty = secNs;}
          lastPenaltyAt = t;
        }
      }
    } else {
      if over {
        goodSince = -1i64;
      } else {
        if goodSince < 0i64 {goodSince = t;}
        if t - goodSince >= penalty {
          good = true;
          goodSince = -1i64;
          lastPenaltyAt = t;
        }
      }
    }
  }

  // ------------------------------------------------------------------
  // Building a packet
  // ------------------------------------------------------------------

  fn disconnectPacket(self: &) IoBuf {
    var w = streams.Writer.make(13usize);
    w.putBE[u32](protocolId);
    w.putByte(kindDisconnect);
    w.putBE[u64](session);
    w.intoBuf()
  }

  // The bit i of the ack bitfield: whether packet (remoteSeq - 1 - i) arrived
  fn ackBits(self: &) u32 {
    var bits = 0u32;
    var i = 0u32;
    while i < 32u32 {
      let q = remoteSeq - 1u16 - u16.from(i);
      if seen[usize.from(q) % ringSize] == u32.from(q) + 1u32 {
        bits = bits | (1u32 << i);
      }
      i = i + 1u32;
    }
    bits
  }

  // One payload packet: reliable messages that are due, then the latest-wins
  // values in order of priority, as many as fit
  fn buildPacket(self: &mut, t: i64) IoBuf {
    // One buffer holds the packet: the budget below keeps it within maxPacket
    var p = streams.Writer.make(cfg.maxPacket);
    let seq = nextSeq;
    nextSeq = nextSeq + 1u16;
    p.putBE[u32](protocolId);
    p.putByte(kindPayload);
    p.putBE[u64](session);
    p.putBE[u16](seq);
    p.putBE[u16](remoteSeq);
    p.putBE[u32](self.ackBits());
    let relCount = p.slot[u8]();
    let latCount = p.slot[u8]();

    // The slot this packet is remembered in
    if sent[usize.from(seq) % ringSize].used && !sent[usize.from(seq) % ringSize].acked {
      // Nothing came back for a packet a whole ring ago: count it lost
      self.noteFate(true);
    }
    let slot = &mut sent[usize.from(seq) % ringSize];
    slot.seq = seq;
    slot.used = true;
    slot.acked = false;
    slot.sentAt = t;
    slot.msgs.clear();

    // Reliable messages that are due, oldest first, while they fit
    var budget = cfg.maxPacket - p.len();
    var nRel = 0u8;
    let delay = self.resendDelay();
    var id = relOldest;
    while id != relNext && nRel < 255u8 {
      let s = &mut rel[usize.from(id) % ringSize];
      if s.used && !s.acked && (s.lastSent < 0i64 || t - s.lastSent >= delay) {
        let need = reliableOverhead + relLen(s);
        if need > budget {break;}
        p.putBE[u16](id);
        p.putBE[u16](u16.from(relLen(s)));
        relPut(&mut p, s);
        budget = budget - need;
        if s.lastSent >= 0i64 {st.reliableResent = st.reliableResent + 1u64;}
        s.lastSent = t;
        slot.msgs.push(id);
        nRel = nRel + 1u8;
        st.reliableSent = st.reliableSent + 1u64;
      }
      id = id + 1u16;
    }
    p.fillBE[u8](relCount, nRel);

    // Latest-wins values: every waiting stream gains priority; the highest
    // that fit go in, and the ones that do not keep what they gathered. The
    // waiting streams are put in order once, highest priority first and, among
    // equals, the one earlier in 'outs' first, and each that fits is taken in
    // that order. That makes the choices of taking the best of those that
    // still fit again and again: the budget only falls, so a stream that did
    // not fit when its turn came cannot fit later, and a stream's priority does
    // not change while the packet is built (only a stream taken has its zeroed)
    //
    // A stream bound to a cell (bindLatest) waits whenever its cell holds a
    // version newer than the last one sent, and gathers priority and is
    // ordered like any other. Its value is not a Bytes: it is copied from the
    // cell straight into the datagram, behind a header written first, and the
    // header is cut back (a mark) when the copy finds nothing, or a value that
    // grew past the room since the choice. Then the stream keeps what it
    // gathered and 'seen' stays, so the value is tried again in the next packet.
    // A stream with both (sendLatest on a bound stream) sends that value first.
    var nLat = 0u8;
    if waitingOuts > 0usize || nCells > 0usize {
      var order = Array[usize, 64]() <- fill 0usize;
      var n = 0usize;
      var i = 0usize;
      while i < nOuts {
        let live = outs[i].pending || self.cellNewer(i);
        let s = &mut outs[i];
        if live {
          s.acc = s.acc + s.weight;
          // Insertion sort, after the equal ones already placed (stable)
          var k = n;
          while k > 0usize && outs[order[k - 1usize]].acc < outs[i].acc {
            order[k] = order[k - 1usize];
            k = k - 1usize;
          }
          order[k] = i;
          n = n + 1usize;
        }
        i = i + 1usize;
      }
      var m = 0usize;
      while m < n && nLat < 255u8 {
        let s = &mut outs[order[m]];
        m = m + 1usize;
        if !s.pending {
          if latestOverhead > budget {continue;}
          let mk = p.mark();
          p.putBE[u16](s.key);
          p.putBE[u16](s.nextSeq);
          let lenAt = p.slot[u16]();
          let res = match &s.cell {
            case let &Some[LatestReader](r) { r.readNewer(s.seen, p.spare()) }
            else { None[CellRead] }
          };
          match res {
            case let Some(got) {
              if latestOverhead + got.len <= budget {
                p.advance(got.len);
                p.fillBE[u16](lenAt, u16.from(got.len));
                p.release(mk);
                if s.seen > 0u64 && got.version > s.seen + 1u64 {
                  st.cellSkipped = st.cellSkipped + (got.version - s.seen - 1u64);
                }
                s.seen = got.version;
                budget = budget - (latestOverhead + got.len);
                s.nextSeq = s.nextSeq + 1u16;
                s.acc = 0u32;
                nLat = nLat + 1u8;
                st.latestSent = st.latestSent + 1u64;
                continue;
              }
            }
            else {}
          }
          p.truncateTo(mk);
          p.release(mk);
          continue;
        }
        if latestOverhead + lenOf(&s.data) > budget {continue;}
        p.putBE[u16](s.key);
        p.putBE[u16](s.nextSeq);
        p.putBE[u16](u16.from(lenOf(&s.data)));
        putData(&mut p, &s.data);
        budget = budget - (latestOverhead + lenOf(&s.data));
        s.nextSeq = s.nextSeq + 1u16;
        s.pending = false;
        s.acc = 0u32;
        s.data = None[Bytes];
        waitingOuts = waitingOuts - 1usize;
        nLat = nLat + 1u8;
        st.latestSent = st.latestSent + 1u64;
      }
    }
    p.fillBE[u8](latCount, nLat);
    st.packetsSent = st.packetsSent + 1u64;
    st.bytesSent = st.bytesSent + u64.from(p.len());
    p.intoBuf()
  }

  // ------------------------------------------------------------------
  // A packet arrives
  // ------------------------------------------------------------------

  // Read one packet. False when it is not ours: too short, not a payload
  // packet of this session, malformed. A good one is acted on: its
  // acknowledgements, its reliable messages (given to 'events' in order) and
  // its latest-wins values (given if newer than any delivered)
  pub fn receive(self: &mut, dg: &Bytes, now: Instant, events: &mut List[CoreEvent]) bool {
    if state != CoreState.Active {return false;}
    let data = dg.view();
    var c = streams.ByteCursor.over(data);
    let kind = match readPrefix(&mut c, protocolId, session) {
      case let Some(k) {k}
      else {
        st.packetsInvalid = st.packetsInvalid + 1u64;
        return false;
      }
    };
    if kind != kindPayload && kind != kindDisconnect {
      st.packetsInvalid = st.packetsInvalid + 1u64;
      return false;
    }
    if kind == kindDisconnect {
      // The other end is closing the connection (a Disconnect is 13 bytes)
      if data.len != 13usize {
        st.packetsInvalid = st.packetsInvalid + 1u64;
        return false;
      }
      state = CoreState.Closed;
      self.dropCells();
      closeReason = CloseReason.Remote;
      events.push(CoreEvent.Closed(CloseReason.Remote));
      return true;
    }
    if !parseBody(&mut c, dg, &mut parsed) {
      st.packetsInvalid = st.packetsInvalid + 1u64;
      return false;
    }
    let pseq = parsed.seq;

    // It is ours
    let t = now.nanos();
    lastRecv = t;
    let slot = usize.from(pseq) % ringSize;
    if seen[slot] == u32.from(pseq) + 1u32 {
      st.packetsDuplicate = st.packetsDuplicate + 1u64;
      self.dropParsed();
      return true;
    }
    if gotAny && seqNewer(remoteSeq, pseq) && seqAhead(remoteSeq, pseq) >= u16.from(ringSize) {
      // So old that its slot belongs to a newer packet
      st.packetsDuplicate = st.packetsDuplicate + 1u64;
      self.dropParsed();
      return true;
    }
    seen[slot] = u32.from(pseq) + 1u32;
    if !gotAny || seqNewer(pseq, remoteSeq) {
      remoteSeq = pseq;
      gotAny = true;
    }
    st.packetsReceived = st.packetsReceived + 1u64;
    st.bytesReceived = st.bytesReceived + u64.from(data.len);

    self.acknowledge(parsed.ack, parsed.bits, t);

    // Reliable messages: kept by id, given out in order. They arrive in
    // order, so each is usually delivered at once, still a slice of the datagram
    each m in parsed.rel.drain() {
      let id, body = m.(id, data);
      self.takeReliable(id, body, events);
      ackDirty = true;
    }

    // Latest-wins values: only a newer one than any delivered gets through
    each item in parsed.lat.drain() {
      var j = self.findIn(item.stream);
      if j == notFound {
        // A peer may name any of 65,536 streams: past the limit a new one is
        // dropped and counted (the same limit the sending side keeps), and the
        // connection stays open
        if nIns >= maxStreams {
          st.streamsRefused = st.streamsRefused + 1u64;
          continue;
        }
        ins[nIns] = StreamIn(item.stream, item.seq - 1u16);
        j = nIns;
        nIns = nIns + 1usize;
      }
      if seqNewer(item.seq, ins[j].seq) {
        ins[j].seq = item.seq;
        let stream, d = item.(stream, data);
        events.push(CoreEvent.Latest(stream, d, j));
        st.latestDelivered = st.latestDelivered + 1u64;
      } else {
        st.latestStale = st.latestStale + 1u64;
      }
    }
    true
  }

  // Keep a reliable message that arrived, if it is new and inside the window
  // The next one in order is given at once, still a slice of its datagram. One
  // that comes before the ones ahead of it is parked as a copy of its own bytes
  // on the heap: a slice would keep its whole datagram (a pool buffer of 4 KiB
  // at least) until the gap is filled, 256 of them 1 MiB, and an IoBuf copy
  // would be 4 KiB as well. It is copied into a buffer again when delivered.
  fn takeReliable(self: &mut, id: u16, data: Bytes, events: &mut List[CoreEvent]) {
    let ahead = usize.from(id - relDeliver);
    if ahead >= reliableWindow {return;}
    if id == relDeliver {
      events.push(CoreEvent.Reliable(data));
      st.reliableDelivered = st.reliableDelivered + 1u64;
      relDeliver = relDeliver + 1u16;
      self.deliverReliable(events);
    } else {
      // The ids waiting are all inside the window, which is the ring's size,
      // so a slot that is taken is this id's own copy, already kept
      let slot = &mut recv[usize.from(id) % ringSize];
      match slot {
        case is None { *slot = Some[List[u8]](copyBytes(data.view())); }
        else {}
      }
    }
  }

  // Give the application every reliable message that is next in order
  fn deliverReliable(self: &mut, events: &mut List[CoreEvent]) {
    while true {
      match recv[usize.from(relDeliver) % ringSize].take() {
        case let Some(d) {
          events.push(CoreEvent.Reliable(copyPacket(d.view()).freeze()));
          st.reliableDelivered = st.reliableDelivered + 1u64;
          relDeliver = relDeliver + 1u16;
        }
        case is None {return;}
      }
    }
  }

  // Let go of what a packet that is not acted on carried: its lists hold slices
  // of its datagram, which would keep the buffer until the next packet
  fn dropParsed(self: &mut) {
    parsed.rel.clear();
    parsed.lat.clear();
  }

  // The peer says it has received packet 'ack' and those 'bits' selects
  // before it: mark them, take round trip samples, and let go of the reliable
  // messages they carried
  fn acknowledge(self: &mut, ack: u16, bits: u32, t: i64) {
    self.ackOne(ack, t);
    var i = 0u32;
    while i < 32u32 {
      if ((bits >> i) & 1u32) != 0u32 {
        self.ackOne(ack - 1u16 - u16.from(i), t);
      }
      i = i + 1u32;
    }
    if !gotAck || seqNewer(ack, ackedMax) {
      ackedMax = ack;
      gotAck = true;
    }
    self.resolve();
    // Release the acknowledged messages at the front of the queue
    while relOldest != relNext {
      let s = &mut rel[usize.from(relOldest) % ringSize];
      if !s.acked {break;}
      s.used = false;
      s.data = None[Bytes];
      s.parked = false;
      s.heap = List[u8]();
      relOldest = relOldest + 1u16;
    }
  }

  fn ackOne(self: &mut, seq: u16, t: i64) {
    let slot = &mut sent[usize.from(seq) % ringSize];
    if !slot.used || slot.seq != seq || slot.acked {return;}
    slot.acked = true;
    let sentAt = slot.sentAt;
    var k = 0usize;
    while k < slot.msgs.len() {
      let id = *slot.msgs[k];
      // The message is still queued (a later ack of an old packet may name
      // one already released and its slot reused)
      if usize.from(id - relOldest) < usize.from(relNext - relOldest) {
        let m = &mut rel[usize.from(id) % ringSize];
        if m.used && m.id == id {m.acked = true;}
      }
      k = k + 1usize;
    }
    self.sampleRtt(t - sentAt);
  }

  // RFC 6298's smoothing of round trip samples
  fn sampleRtt(self: &mut, sample: i64) {
    var s = sample;
    if s < 0i64 {s = 0i64;}
    if !hasRtt {
      srtt = s;
      rttvar = s / 2i64;
      hasRtt = true;
      return;
    }
    var diff = srtt - s;
    if diff < 0i64 {diff = 0i64 - diff;}
    rttvar = (rttvar * 3i64 + diff) / 4i64;
    srtt = (srtt * 7i64 + s) / 8i64;
  }

  // Decide the fate of the oldest sent packets: acknowledged, or so far behind
  // the newest ack (more than the 33 an ack covers) that no ack can come
  fn resolve(self: &mut) {
    while scan != nextSeq {
      let slot = &sent[usize.from(scan) % ringSize];
      if slot.used && slot.seq == scan {
        if slot.acked {
          self.noteFate(false);
        } else if gotAck && seqAhead(ackedMax, scan) > 32u16 {
          self.noteFate(true);
        } else {
          return;
        }
        // Its fate is counted once: the slot is free
        sent[usize.from(scan) % ringSize].used = false;
      }
      scan = scan + 1u16;
    }
  }

  // One packet's fate into the loss measure (a moving average over about 64)
  fn noteFate(self: &mut, lost: bool) {
    let x = if lost {65536i64} else {0i64};
    lossFx = lossFx + (x - lossFx) / 64i64;
  }
}
