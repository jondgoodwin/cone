// The connection core: one connection's half of the protocol, with no socket,
// no clock and no thread. A ConnectionCore takes the packets that arrived (with the
// time) and the data the application wants sent, and gives back the packets
// to send, the events to tell the application, and the time it next needs
// to be called. The same ConnectionCore runs inside an actor, inside a test on a
// synthetic clock, and on either side of a connection.
//
// The design is Glenn Fiedler's (Gaffer On Games): every packet carries its
// own sequence number, the latest sequence received, and a bitfield of the 32
// before it, so each acknowledgement is sent about 33 times and survives
// heavy loss. A packet is never resent; what was in it is: a reliable
// message is kept until a packet that carried it is acknowledged and goes in
// later packets until then, and latest-wins data is sent once and superseded
// by a newer value.

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

// The first four bytes of every packet: 'NMS1', the protocol and its version
pub const protocolId = 0x4E4D5331u32;

// The kinds of packet (the byte after the protocol id)
pub const kindRequest = 0u8;
pub const kindChallenge = 1u8;
pub const kindResponse = 2u8;
pub const kindAccept = 3u8;
pub const kindPayload = 4u8;
pub const kindDisconnect = 5u8;
pub const kindDenied = 6u8;

// A payload packet's fixed part: protocol id 4, kind 1, session 8, sequence 2,
// ack 2, ack bits 4, then a count of reliable messages 1 and of latest-wins
// items 1
pub const headerSize = 23usize;

// Bytes a reliable message adds to its data (id 2, length and flags 2) and a
// latest-wins item adds (stream 2, sequence 2, length and flags 2)
pub const reliableOverhead = 4usize;
pub const latestOverhead = 6usize;

// Slots in each ring: packets sent and received, reliable messages in
// flight. A power of two, and far more than the 33 packets an ack covers
const ringSize = 1024usize;

// Reliable messages queued or unacknowledged at once
pub const reliableWindow = 1024usize;

// Latest-wins streams one connection carries
pub const maxStreams = 64usize;

// Disconnect packets sent when a connection closes, so one of them gets
// through
const disconnectCopies = 5usize;

const msNs = 1000000i64;
const secNs = 1000000000i64;
const notFound = 0xFFFFFFFFusize;

// ---------------------------------------------------------------------------
// Configuration, events, statistics
// ---------------------------------------------------------------------------

// The knobs of a connection, the same on both ends
pub struct NetConfig {
  pub maxPacket usize;       // the largest datagram sent, bytes (1200)
  pub goodRate u32;          // packets a second sent in good conditions (30)
  pub badRate u32;           // ... when the round trip is long (10)
  pub badRttMs i64;          // a smoothed round trip above this is bad (250)
  pub keepAliveMs i64;       // a packet at least this often, with nothing to say (100)
  pub timeoutMs i64;         // no packet this long ends the connection (10000)
  pub resendMinMs i64;       // a reliable message is not resent sooner (40)
  pub connectRetryMs i64;    // a handshake packet is repeated this often (250)
  pub connectTimeoutMs i64;  // a handshake that takes this long has failed (5000)
  pub maxClients usize;      // a server's connections (64)

  pub fn defaults() NetConfig {
    new NetConfig(1200usize, 30u32, 10u32, 250i64, 100i64, 10000i64, 40i64, 250i64, 5000i64, 64usize)
  }
}

// Why a connection ended
pub enum CloseReason {
  Local,       // this side closed it
  Remote,      // the other side did
  TimedOut,    // no packet arrived for the timeout
  Overflow,    // too many reliable messages were waiting to be sent
  Refused,     // a connection attempt was refused: the server was full
  NoAnswer;    // a connection attempt got no answer in time
}

// What happened that the application should hear of
pub enum CoreEvent {
  pub struct Reliable {pub data List[u8];}                      // a reliable message, in order
  pub struct Latest {pub stream u16; pub data List[u8];}        // the newest value of a stream
  pub struct Closed {pub reason CloseReason;}                   // the connection ended
}

// What a connection has measured
pub struct ConnectionStats {
  pub packetsSent u64;
  pub packetsReceived u64;       // valid, new packets
  pub packetsDuplicate u64;      // valid packets that had arrived before
  pub packetsInvalid u64;        // refused: wrong session, short, malformed
  pub bytesSent u64;
  pub bytesReceived u64;
  pub reliableSent u64;          // reliable messages in packets, resends included
  pub reliableResent u64;        // ... of which resends
  pub reliableDelivered u64;     // reliable messages given to the application
  pub latestSent u64;
  pub latestDelivered u64;
  pub latestStale u64;           // arrived late: an older value than one already delivered
  pub rttMs i64;                 // smoothed round trip time; 0 before the first sample
  pub rttVarMs i64;
  pub lossPermille u32;          // of our packets, in a thousand, that never got acknowledged
  pub good bool;                 // sending at the good rate
}

// ---------------------------------------------------------------------------
// The state of a connection
// ---------------------------------------------------------------------------

// The largest reliable message, and the largest latest-wins value, a
// connection with this configuration carries, in bytes
pub fn maxReliableBytes(cfg NetConfig) usize {cfg.maxPacket - headerSize - reliableOverhead}
pub fn maxLatestBytes(cfg NetConfig) usize {cfg.maxPacket - headerSize - latestOverhead}

// A packet sent: kept until the ring slot is needed again
struct SentSlot {
  seq u16;
  used bool;
  acked bool;
  sentAt i64;
  msgs List[u16];            // the reliable messages it carried
}

// A reliable message waiting to be acknowledged
struct RelSlot {
  id u16;
  used bool;
  acked bool;
  lastSent i64;              // when a packet last carried it; -1 never
  data List[u8];
}

// A reliable message received out of order, waiting for the ones before it
struct RelRecv {
  id u16;
  used bool;
  data List[u8];
}

// A latest-wins stream going out
struct StreamOut {
  key u16;
  weight u32;                // priority gained each packet while a value waits
  acc u32;                   // priority gathered so far
  nextSeq u16;
  pending bool;
  data List[u8];
}

// A latest-wins stream coming in: the newest sequence delivered
struct StreamIn {
  key u16;
  seq u16;
}

// What one packet carries, parsed before any of it is acted on
struct Parsed {
  seq u16;
  ack u16;
  bits u32;
  rel List[RelRecv];
  lat List[LatestItem];
}

struct LatestItem {
  stream u16;
  seq u16;
  data List[u8];
}

pub enum CoreState {
  Active, Closing, Closed;
}

// One connection's half of the protocol
pub struct ConnectionCore {
  cfg NetConfig;
  session u64;
  state CoreState;
  closeReason CloseReason;

  // packets
  nextSeq u16;
  sent List[SentSlot];
  seen List[u32];            // sequence + 1 of the packet received in each slot; 0 none
  remoteSeq u16;             // the newest packet sequence received
  gotAny bool;
  scan u16;                  // the oldest sent packet whose fate is not yet known
  ackedMax u16;              // the newest ack received
  gotAck bool;

  // reliable messages
  rel List[RelSlot];
  relOldest u16;             // the oldest id not yet acknowledged
  relNext u16;               // the id the next message gets
  recv List[RelRecv];
  relDeliver u16;            // the next id to give the application

  // latest-wins streams
  outs List[StreamOut];
  ins List[StreamIn];

  // time
  lastRecv i64;
  lastSend i64;
  nextSendAt i64;
  ackDirty bool;             // a reliable message arrived that no packet of ours has acknowledged
  closeSent bool;

  // measurements
  hasRtt bool;
  srtt i64;                  // ns
  rttvar i64;
  lossFx i64;                // fraction of packets lost, in 1/65536
  good bool;
  goodSince i64;             // when the round trip last became acceptable; -1
  penalty i64;               // how long it must stay acceptable to go back to good
  lastPenaltyAt i64;
  st ConnectionStats;

  // A new connection that begins now, with the session both ends know
  pub fn make(cfg NetConfig, session u64, now Instant) ConnectionCore {
    var sent = List[SentSlot].withCapacity(ringSize);
    var seen = List[u32].withCapacity(ringSize);
    var rel = List[RelSlot].withCapacity(ringSize);
    var recv = List[RelRecv].withCapacity(ringSize);
    var i = 0usize;
    while i < ringSize {
      sent.push(new SentSlot(0u16, false, false, 0i64, List[u16].empty()));
      seen.push(0u32);
      rel.push(new RelSlot(0u16, false, false, -1i64, List[u8].empty()));
      recv.push(new RelRecv(0u16, false, List[u8].empty()));
      i = i + 1usize;
    }
    let t = now.nanos();
    new ConnectionCore(cfg, session, CoreState.Active, CloseReason.Local,
      0u16, sent, seen, 65535u16, false, 0u16, 0u16, false,
      rel, 0u16, 0u16, recv, 0u16,
      List[StreamOut].empty(), List[StreamIn].empty(),
      t, t - cfg.keepAliveMs * msNs, t, false, false,
      false, 0i64, 0i64, 0i64, true, -1i64, 4i64 * secNs, t,
      new ConnectionStats(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0i64, 0i64, 0u32, true))
  }

  pub fn sessionId(self &) u64 {session}
  pub fn isActive(self &) bool {state == CoreState.Active}
  pub fn isClosed(self &) bool {state == CoreState.Closed}

  // The largest reliable message, in bytes
  pub fn maxReliable(self &) usize {cfg.maxPacket - headerSize - reliableOverhead}

  // The largest latest-wins value, in bytes
  pub fn maxLatest(self &) usize {cfg.maxPacket - headerSize - latestOverhead}

  // ------------------------------------------------------------------
  // What the application sends
  // ------------------------------------------------------------------

  // Queue a reliable message: it arrives once, in order, whatever the link
  // does. False, and nothing queued, when it is bigger than maxReliable() or
  // reliableWindow() messages are already waiting: the application decides
  // what to do about a peer that is not keeping up. A message of no bytes is
  // a message.
  pub fn sendReliable(self &mut, data &Array[u8]) bool {
    if state != CoreState.Active or data.len > self.maxReliable() {return false;}
    let waiting = usize.from(relNext - relOldest);
    if waiting >= reliableWindow {return false;}
    let s = &mut rel[usize.from(relNext) % ringSize];
    s.id = relNext;
    s.used = true;
    s.acked = false;
    s.lastSent = -1i64;
    s.data.clear();
    putBytes(&mut s.data, data);
    relNext = relNext + 1u16;
    true
  }

  // Reliable messages not yet acknowledged (queued or in flight)
  pub fn reliablePending(self &) usize {usize.from(relNext - relOldest)}

  // Set the value of a latest-wins stream: it goes in the next packet that has
  // room, unless a newer value replaces it first, and is never resent. False
  // when the value is bigger than maxLatest() or the connection already has
  // maxStreams() streams.
  pub fn sendLatest(self &mut, stream u16, data &Array[u8]) bool {
    if state != CoreState.Active or data.len > self.maxLatest() {return false;}
    var k = self.findOut(stream);
    if k == notFound {
      if outs.len() >= maxStreams {return false;}
      outs.push(new StreamOut(stream, 1u32, 0u32, 0u16, false, List[u8].empty()));
      k = outs.len() - 1usize;
    }
    let s = &mut outs[k];
    s.data.clear();
    putBytes(&mut s.data, data);
    s.pending = true;
    true
  }

  // How much a stream's waiting value counts when a packet has room for only
  // some: its priority grows by 'weight' with every packet it waits through,
  // and the highest goes first. 1 for a stream not set.
  pub fn setStreamWeight(self &mut, stream u16, weight u32) {
    var k = self.findOut(stream);
    if k == notFound {
      if outs.len() >= maxStreams {return;}
      outs.push(new StreamOut(stream, weight, 0u32, 0u16, false, List[u8].empty()));
      return;
    }
    outs[k].weight = weight;
  }

  fn findOut(self &, stream u16) usize {
    var i = 0usize;
    while i < outs.len() {
      if outs[i].key == stream {return i;}
      i = i + 1usize;
    }
    notFound
  }

  fn findIn(self &, stream u16) usize {
    var i = 0usize;
    while i < ins.len() {
      if ins[i].key == stream {return i;}
      i = i + 1usize;
    }
    notFound
  }

  // Ask for the connection to end: the next poll sends the disconnect packets
  // and gives the Closed event
  pub fn close(self &mut) {
    if state == CoreState.Active {
      state = CoreState.Closing;
    }
  }

  // ------------------------------------------------------------------
  // Measurements
  // ------------------------------------------------------------------

  // The smoothed round trip time, 0 until a packet has been acknowledged
  pub fn rtt(self &) Duration {Duration.fromNanos(srtt)}

  pub fn rttVariation(self &) Duration {Duration.fromNanos(rttvar)}

  // Of the packets sent, the fraction that never got acknowledged, in a
  // thousand
  pub fn lossPermille(self &) u32 {u32.from((lossFx * 1000i64) / 65536i64)}

  // Sending at the good rate (false: the round trip is long)
  pub fn isGood(self &) bool {good}

  pub fn stats(self &) ConnectionStats {
    var s = st;
    s.rttMs = srtt / msNs;
    s.rttVarMs = rttvar / msNs;
    s.lossPermille = self.lossPermille();
    s.good = good;
    s
  }

  // How long before a reliable message is sent again: the smoothed round trip
  // plus four times its variation (RFC 6298's timeout), not under the
  // configured minimum; 100 ms before there is a measurement
  fn resendDelay(self &) i64 {
    var d = 100i64 * msNs;
    if hasRtt {d = srtt + 4i64 * rttvar;}
    if d < cfg.resendMinMs * msNs {d = cfg.resendMinMs * msNs;}
    if d > 2i64 * secNs {d = 2i64 * secNs;}
    d
  }

  fn interval(self &) i64 {
    var rate = if good {cfg.goodRate} else {cfg.badRate};
    if rate == 0u32 {rate = 1u32;}
    secNs / i64.from(rate)
  }

  // ------------------------------------------------------------------
  // Time
  // ------------------------------------------------------------------

  // Whether there is anything to put in a packet now
  fn hasWork(self &, t i64) bool {
    if ackDirty {return true;}
    var i = 0usize;
    while i < outs.len() {
      if outs[i].pending {return true;}
      i = i + 1usize;
    }
    let delay = self.resendDelay();
    var id = relOldest;
    while id != relNext {
      let s = rel[usize.from(id) % ringSize];
      if s.used and not s.acked and (s.lastSent < 0i64 or t - s.lastSent >= delay) {return true;}
      id = id + 1u16;
    }
    false
  }

  // When the connection next needs poll to be called, if nothing arrives
  // first: the moment it may send a packet it wants to send, or the time it
  // gives up on the peer. After that call, ask again.
  pub fn nextDeadline(self &) Instant {
    if state != CoreState.Active {return Instant.fromNanos(lastSend);}
    var at = lastRecv + cfg.timeoutMs * msNs;
    // When a packet could carry something
    var want = lastSend + cfg.keepAliveMs * msNs;
    var i = 0usize;
    var any = ackDirty;
    while i < outs.len() {
      if outs[i].pending {any = true;}
      i = i + 1usize;
    }
    if any {
      want = lastSend;
    } else {
      let delay = self.resendDelay();
      var id = relOldest;
      while id != relNext {
        let s = rel[usize.from(id) % ringSize];
        if s.used and not s.acked {
          var due = lastSend;
          if s.lastSent >= 0i64 {due = s.lastSent + delay;}
          if due < want {want = due;}
        }
        id = id + 1u16;
      }
    }
    if want < nextSendAt {want = nextSendAt;}
    if want < at {at = want;}
    Instant.fromNanos(at)
  }

  // Move time on to 'now': appends to 'out' the packets to send (none, one,
  // or the disconnect copies) and to 'events' what happened. Call it when
  // nextDeadline says, after a packet arrives, and after sending.
  pub fn poll(self &mut, now Instant, out &mut List[List[u8]], events &mut List[CoreEvent]) {
    let t = now.nanos();
    if state == CoreState.Closed {return;}
    if state == CoreState.Closing {
      if not closeSent {
        var c = 0usize;
        while c < disconnectCopies {
          out.push(self.disconnectPacket());
          c = c + 1usize;
        }
        closeSent = true;
      }
      state = CoreState.Closed;
      closeReason = CloseReason.Local;
      events.push(CoreEvent.Closed(CloseReason.Local));
      return;
    }
    if t - lastRecv >= cfg.timeoutMs * msNs {
      state = CoreState.Closed;
      closeReason = CloseReason.TimedOut;
      events.push(CoreEvent.Closed(CloseReason.TimedOut));
      return;
    }
    self.updateMode(t);
    if t < nextSendAt {return;}
    if self.hasWork(t) or t - lastSend >= cfg.keepAliveMs * msNs {
      out.push(self.buildPacket(t));
      nextSendAt = t + self.interval();
      lastSend = t;
      ackDirty = false;
    }
  }

  // Fiedler's two-state rate control: sending at the good rate, until the
  // smoothed round trip goes over the limit; then at the bad rate until it
  // has stayed under the limit for 'penalty', which doubles (up to a minute)
  // when conditions turn bad again soon after being good, and halves (down to
  // a second) for every ten seconds spent good
  fn updateMode(self &mut, t i64) {
    if not hasRtt {return;}
    let over = srtt > cfg.badRttMs * msNs;
    if good {
      if over {
        good = false;
        goodSince = -1i64;
        if t - lastPenaltyAt < 10i64 * secNs {
          penalty = penalty * 2i64;
          if penalty > 60i64 * secNs {penalty = 60i64 * secNs;}
        }
        lastPenaltyAt = t;
      } else {
        if t - lastPenaltyAt >= 10i64 * secNs {
          penalty = penalty / 2i64;
          if penalty < secNs {penalty = secNs;}
          lastPenaltyAt = t;
        }
      }
    } else {
      if over {
        goodSince = -1i64;
      } else {
        if goodSince < 0i64 {goodSince = t;}
        if t - goodSince >= penalty {
          good = true;
          goodSince = -1i64;
          lastPenaltyAt = t;
        }
      }
    }
  }

  // ------------------------------------------------------------------
  // Building a packet
  // ------------------------------------------------------------------

  fn disconnectPacket(self &) List[u8] {
    var p = List[u8].withCapacity(13usize);
    putU32(&mut p, protocolId);
    putU8(&mut p, kindDisconnect);
    putU64(&mut p, session);
    p
  }

  // The bit i of the ack bitfield: whether packet (remoteSeq - 1 - i) arrived
  fn ackBits(self &) u32 {
    var bits = 0u32;
    var i = 0u32;
    while i < 32u32 {
      let q = remoteSeq - 1u16 - u16.from(i);
      if seen[usize.from(q) % ringSize] == u32.from(q) + 1u32 {
        bits = bits | (1u32 << i);
      }
      i = i + 1u32;
    }
    bits
  }

  // One payload packet: reliable messages that are due, then the latest-wins
  // values in order of priority, as many as fit
  fn buildPacket(self &mut, t i64) List[u8] {
    var p = List[u8].withCapacity(cfg.maxPacket);
    let seq = nextSeq;
    nextSeq = nextSeq + 1u16;
    putU32(&mut p, protocolId);
    putU8(&mut p, kindPayload);
    putU64(&mut p, session);
    putU16(&mut p, seq);
    putU16(&mut p, remoteSeq);
    putU32(&mut p, self.ackBits());
    let relCountAt = p.len();
    putU8(&mut p, 0u8);
    let latCountAt = p.len();
    putU8(&mut p, 0u8);

    // The slot this packet is remembered in
    if sent[usize.from(seq) % ringSize].used and not sent[usize.from(seq) % ringSize].acked {
      // Nothing came back for a packet a whole ring ago: count it lost
      self.noteFate(true);
    }
    let slot = &mut sent[usize.from(seq) % ringSize];
    slot.seq = seq;
    slot.used = true;
    slot.acked = false;
    slot.sentAt = t;
    slot.msgs.clear();

    // Reliable messages that are due, oldest first, while they fit
    var budget = cfg.maxPacket - p.len();
    var nRel = 0u8;
    let delay = self.resendDelay();
    var id = relOldest;
    while id != relNext and nRel < 255u8 {
      let s = &mut rel[usize.from(id) % ringSize];
      if s.used and not s.acked and (s.lastSent < 0i64 or t - s.lastSent >= delay) {
        let need = reliableOverhead + s.data.len();
        if need > budget {break;}
        putU16(&mut p, id);
        putU16(&mut p, u16.from(s.data.len()));
        putBytes(&mut p, s.data.view());
        budget = budget - need;
        if s.lastSent >= 0i64 {st.reliableResent = st.reliableResent + 1u64;}
        s.lastSent = t;
        slot.msgs.push(id);
        nRel = nRel + 1u8;
        st.reliableSent = st.reliableSent + 1u64;
      }
      id = id + 1u16;
    }
    p.set(relCountAt, nRel);

    // Latest-wins values: every waiting stream gains priority; the highest
    // that fit go in, and the ones that do not keep what they gathered
    var i = 0usize;
    while i < outs.len() {
      let s = &mut outs[i];
      if s.pending {s.acc = s.acc + s.weight;}
      i = i + 1usize;
    }
    var nLat = 0u8;
    while nLat < 255u8 {
      var best = notFound;
      i = 0usize;
      while i < outs.len() {
        let s = outs[i];
        if s.pending and latestOverhead + s.data.len() <= budget {
          if best == notFound or s.acc > outs[best].acc {best = i;}
        }
        i = i + 1usize;
      }
      if best == notFound {break;}
      let s = &mut outs[best];
      putU16(&mut p, s.key);
      putU16(&mut p, s.nextSeq);
      putU16(&mut p, u16.from(s.data.len()));
      putBytes(&mut p, s.data.view());
      budget = budget - (latestOverhead + s.data.len());
      s.nextSeq = s.nextSeq + 1u16;
      s.pending = false;
      s.acc = 0u32;
      s.data.clear();
      nLat = nLat + 1u8;
      st.latestSent = st.latestSent + 1u64;
    }
    p.set(latCountAt, nLat);
    st.packetsSent = st.packetsSent + 1u64;
    st.bytesSent = st.bytesSent + u64.from(p.len());
    p
  }

  // ------------------------------------------------------------------
  // A packet arrives
  // ------------------------------------------------------------------

  // Read one packet. False when it is not ours: too short, not a payload
  // packet of this session, malformed. A good one is acted on: its
  // acknowledgements, its reliable messages (given to 'events' in order) and
  // its latest-wins values (given if newer than any delivered)
  pub fn receive(self &mut, data &Array[u8], now Instant, events &mut List[CoreEvent]) bool {
    if state != CoreState.Active {return false;}
    var c = PacketReader.start();
    let magic = c.rdU32(data);
    let kind = c.rdU8(data);
    let sess = c.rdU64(data);
    if not c.ok or magic != protocolId or sess != session or (kind != kindPayload and kind != kindDisconnect) {
      st.packetsInvalid = st.packetsInvalid + 1u64;
      return false;
    }
    if kind == kindDisconnect {
      // The other end is closing the connection (a Disconnect is 13 bytes)
      if data.len != 13usize {
        st.packetsInvalid = st.packetsInvalid + 1u64;
        return false;
      }
      state = CoreState.Closed;
      closeReason = CloseReason.Remote;
      events.push(CoreEvent.Closed(CloseReason.Remote));
      return true;
    }
    var pk = new Parsed(c.rdU16(data), c.rdU16(data), c.rdU32(data), List[RelRecv].empty(), List[LatestItem].empty());
    let nRel = c.rdU8(data);
    let nLat = c.rdU8(data);
    var i = 0u8;
    while i < nRel and c.ok {
      let id = c.rdU16(data);
      let lf = c.rdU16(data);
      // The top two bits are reserved for fragmentation (not built): a
      // message that sets either is refused
      if (lf >> 14u16) != 0u16 {c.ok = false;}
      let body = c.rdBytes(data, usize.from(lf & 0x3FFFu16));
      pk.rel.push(new RelRecv(id, true, body));
      i = i + 1u8;
    }
    i = 0u8;
    while i < nLat and c.ok {
      let stream = c.rdU16(data);
      let seq = c.rdU16(data);
      let lf = c.rdU16(data);
      if (lf >> 14u16) != 0u16 {c.ok = false;}
      let body = c.rdBytes(data, usize.from(lf & 0x3FFFu16));
      pk.lat.push(new LatestItem(stream, seq, body));
      i = i + 1u8;
    }
    if not c.ok or c.pos != data.len {
      st.packetsInvalid = st.packetsInvalid + 1u64;
      return false;
    }

    // It is ours
    let t = now.nanos();
    lastRecv = t;
    let slot = usize.from(pk.seq) % ringSize;
    if seen[slot] == u32.from(pk.seq) + 1u32 {
      st.packetsDuplicate = st.packetsDuplicate + 1u64;
      return true;
    }
    if gotAny and seqNewer(remoteSeq, pk.seq) and seqAhead(remoteSeq, pk.seq) >= u16.from(ringSize) {
      // So old that its slot belongs to a newer packet
      st.packetsDuplicate = st.packetsDuplicate + 1u64;
      return true;
    }
    seen[slot] = u32.from(pk.seq) + 1u32;
    if not gotAny or seqNewer(pk.seq, remoteSeq) {
      remoteSeq = pk.seq;
      gotAny = true;
    }
    st.packetsReceived = st.packetsReceived + 1u64;
    st.bytesReceived = st.bytesReceived + u64.from(data.len);

    self.acknowledge(pk.ack, pk.bits, t);

    // Reliable messages: kept by id, given out in order
    while pk.rel.len() > 0usize {
      match pk.rel.pop() {
        case let m Some {
          var msg = m;
          self.takeReliable(msg.id, &mut msg.data);
          ackDirty = true;
        }
        case is None[RelRecv] {}
      }
    }
    self.deliverReliable(events);

    // Latest-wins values: only a newer one than any delivered gets through
    var k = 0usize;
    while k < pk.lat.len() {
      let item = &mut pk.lat[k];
      var j = self.findIn(item.stream);
      if j == notFound {
        ins.push(new StreamIn(item.stream, item.seq - 1u16));
        j = ins.len() - 1usize;
      }
      if seqNewer(item.seq, ins[j].seq) {
        ins[j].seq = item.seq;
        var d = List[u8].empty();
        d <=> item.data;
        events.push(CoreEvent.Latest(item.stream, d));
        st.latestDelivered = st.latestDelivered + 1u64;
      } else {
        st.latestStale = st.latestStale + 1u64;
      }
      k = k + 1usize;
    }
    true
  }

  // Keep a reliable message that arrived, if it is new and inside the window
  fn takeReliable(self &mut, id u16, data &mut List[u8]) {
    let ahead = usize.from(id - relDeliver);
    if ahead >= reliableWindow {return;}
    let s = &mut recv[usize.from(id) % ringSize];
    if s.used {return;}
    s.id = id;
    s.used = true;
    s.data <=> *data;
  }

  // Give the application every reliable message that is next in order
  fn deliverReliable(self &mut, events &mut List[CoreEvent]) {
    while true {
      let s = &mut recv[usize.from(relDeliver) % ringSize];
      if not s.used or s.id != relDeliver {return;}
      var d = List[u8].empty();
      d <=> s.data;
      s.used = false;
      events.push(CoreEvent.Reliable(d));
      st.reliableDelivered = st.reliableDelivered + 1u64;
      relDeliver = relDeliver + 1u16;
    }
  }

  // The peer says it has received packet 'ack' and those 'bits' selects
  // before it: mark them, take round trip samples, and let go of the reliable
  // messages they carried
  fn acknowledge(self &mut, ack u16, bits u32, t i64) {
    self.ackOne(ack, t);
    var i = 0u32;
    while i < 32u32 {
      if ((bits >> i) & 1u32) != 0u32 {
        self.ackOne(ack - 1u16 - u16.from(i), t);
      }
      i = i + 1u32;
    }
    if not gotAck or seqNewer(ack, ackedMax) {
      ackedMax = ack;
      gotAck = true;
    }
    self.resolve();
    // Release the acknowledged messages at the front of the queue
    while relOldest != relNext {
      let s = &mut rel[usize.from(relOldest) % ringSize];
      if not s.acked {break;}
      s.used = false;
      s.data.clear();
      relOldest = relOldest + 1u16;
    }
  }

  fn ackOne(self &mut, seq u16, t i64) {
    let slot = &mut sent[usize.from(seq) % ringSize];
    if not slot.used or slot.seq != seq or slot.acked {return;}
    slot.acked = true;
    let sentAt = slot.sentAt;
    var k = 0usize;
    while k < slot.msgs.len() {
      let id = *slot.msgs[k];
      // The message is still queued (a later ack of an old packet may name
      // one already released and its slot reused)
      if usize.from(id - relOldest) < usize.from(relNext - relOldest) {
        let m = &mut rel[usize.from(id) % ringSize];
        if m.used and m.id == id {m.acked = true;}
      }
      k = k + 1usize;
    }
    self.sampleRtt(t - sentAt);
  }

  // RFC 6298's smoothing of round trip samples
  fn sampleRtt(self &mut, sample i64) {
    var s = sample;
    if s < 0i64 {s = 0i64;}
    if not hasRtt {
      srtt = s;
      rttvar = s / 2i64;
      hasRtt = true;
      return;
    }
    var diff = srtt - s;
    if diff < 0i64 {diff = 0i64 - diff;}
    rttvar = (rttvar * 3i64 + diff) / 4i64;
    srtt = (srtt * 7i64 + s) / 8i64;
  }

  // Decide the fate of the oldest sent packets: acknowledged, or so far behind
  // the newest ack (more than the 33 an ack covers) that no ack can come
  fn resolve(self &mut) {
    while scan != nextSeq {
      let slot = sent[usize.from(scan) % ringSize];
      if slot.used and slot.seq == scan {
        if slot.acked {
          self.noteFate(false);
        } elif gotAck and seqAhead(ackedMax, scan) > 32u16 {
          self.noteFate(true);
        } else {
          return;
        }
        // Its fate is counted once: the slot is free
        sent[usize.from(scan) % ringSize].used = false;
      }
      scan = scan + 1u16;
    }
  }

  // One packet's fate into the loss measure (a moving average over about 64)
  fn noteFate(self &mut, lost bool) {
    let x = if lost {65536i64} else {0i64};
    lossFx = lossFx + (x - lossFx) / 64i64;
  }
}
