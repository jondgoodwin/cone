// A toy game over netmsg: a server actor moves three bodies at 30 Hz and sends
// each client a snapshot of them as a latest-wins value; clients send their
// input and chat as reliable messages and print what they hear. The server
// and the players are written once; how they are joined is the only thing
// that changes between the modes:
//
//   congo run examples/demo.cone                  both of the following, one after the other
//   congo run examples/demo.cone inprocess        no sockets: two players and the server in one
//                                                 process, joined by in-process pairs
//   congo run examples/demo.cone loopback         real UDP on 127.0.0.1, a relay in the path
//                                                 that loses 20% of the datagrams each way and
//                                                 delays the rest 25 ms plus up to 10 ms
//   congo run examples/demo.cone serve PORT       a server for other machines, 60 s
//   congo run examples/demo.cone connect HOST PORT NAME
//                                                 a player, 8 s, against such a server
//
// The snapshot is a toy (a tick, then three bodies' ids and positions as
// numbers); what a real world sends, and how a client interpolates and
// predicts, belongs to the application, not to netmsg.

mod demo;

import stdio use *;
import collections use *;
import sync use *;
import time use Duration, Instant;
import thread;
import process;
import iocore use SocketAddr;
import actors;
import netmsg use *;

const bodyCount = 3usize;
const edge = 10000i32;

struct Body {
  pub x: i32;
  pub y: i32;
  pub vx: i32;
  pub vy: i32;
}

struct Seat {
  pub id: u32;
  pub conn: Connection;
  pub name: String;
}

fn textOf(d: &List[u8]) String {String.fromBytes(d.view())}

fn bytesOf(s: &str) List[u8] {
  var b = List[u8].empty();
  putBytes(&mut b, s);
  b
}

// ---------------------------------------------------------------------------
// The server
// ---------------------------------------------------------------------------

actor GameServer {
  bodies: List[Body];
  seats: List[Seat];
  ticks: u32;

  fn init(self: &new) {
    var b = List[Body].empty();
    b.push(Body(1000, 1000, 120, 70));
    b.push(Body(5000, 8000, -90, -40));
    b.push(Body(9000, 3000, -60, 110));
    *self = Self(bodies: b, seats: List[Seat].empty(), ticks: 0u32);
  }

  // Everything the connections tell it arrives here, whichever way they are made
  pub async do onNet(self, ev: NetEvent) {
    match ev {
      case let Joined(j) {
        seats.push(Seat(j.id, j.conn, String.from("?")));
        var s = String.from("server: client ");
        s.appendUInt(u64.from(j.id));
        s.append(" joined\n");
        printStr(s.view());
      }
      case let Left(l) {
        self.remove(l.id);
        var s = String.from("server: client ");
        s.appendUInt(u64.from(l.id));
        s.append(" left\n");
        printStr(s.view());
      }
      case let Message(m) { self.heard(m.id, textOf(&m.data)); }
      case let Update(u) {}
      case let Refused(r) {}
    }
  }

  // One step of the world and a snapshot to everyone
  pub async do tick(self) {
    ticks = ticks + 1u32;
    var i = 0usize;
    while i < bodies.len() {
      let b = &mut bodies[i];
      b.x = b.x + b.vx;
      b.y = b.y + b.vy;
      if b.x < 0i32 || b.x > edge {b.vx = 0i32 - b.vx; b.x = b.x + b.vx;}
      if b.y < 0i32 || b.y > edge {b.vy = 0i32 - b.vy; b.y = b.y + b.vy;}
      i = i + 1usize;
    }
    var s = 0usize;
    while s < seats.len() {
      seats[s].conn.sendLatest(1u16, self.snapshot());
      s = s + 1usize;
    }
  }

  // The toy snapshot: tick, then for each body its id and position
  fn snapshot(self: &) List[u8] {
    var p = List[u8].empty();
    putU32(&mut p, ticks);
    putU8(&mut p, u8.from(bodies.len()));
    var i = 0usize;
    while i < bodies.len() {
      putU8(&mut p, u8.from(i));
      putU32(&mut p, u32.from(bodies[i].x));
      putU32(&mut p, u32.from(bodies[i].y));
      i = i + 1usize;
    }
    p
  }

  fn find(self: &, id: u32) usize {
    var i = 0usize;
    while i < seats.len() {
      if seats[i].id == id {return i;}
      i = i + 1usize;
    }
    seats.len()
  }

  fn remove(self, id: u32) {
    let k = self.find(id);
    if k < seats.len() {
      seats.swap(k, seats.len() - 1usize);
      seats.pop();
    }
  }

  fn tell(self: &, k: usize, text: &str) {
    seats[k].conn.sendReliable(bytesOf(text));
  }

  // A reliable message from client 'id': hello NAME, input DX DY, or chat TEXT
  fn heard(self, id: u32, text: String) {
    let k = self.find(id);
    if k >= seats.len() {return;}
    let words = text.split(' ');
    if words.len() == 0usize {return;}
    let verb = words[0usize].view();
    if verb == "hello" && words.len() > 1usize {
      seats[k].name = String.from(words[1usize].view());
      var w = String.from("welcome ");
      w.appendUInt(u64.from(id));
      self.tell(k, w.view());
      var j = String.from("news ");
      j.append(words[1usize].view());
      j.append(" joined");
      self.everyone(j.view());
    } elif verb == "input" && words.len() == 3usize {
      // Client n steers body n - 1 (mod 3)
      let b = &mut bodies[usize.from(id - 1u32) % bodyCount];
      match parseInt(words[1usize].view()) {
        case let Some(dx) { b.vx = i32.from(dx); }
        case is None[i64] {}
      }
      match parseInt(words[2usize].view()) {
        case let Some(dy) { b.vy = i32.from(dy); }
        case is None[i64] {}
      }
    } elif verb == "chat" && text.len() > 5usize {
      var c = String.from("chat ");
      c.append(seats[k].name.view());
      c.append(": ");
      c.append(text.view().slice(5usize, text.len()));
      self.everyone(c.view());
    }
  }

  fn everyone(self: &, text: &str) {
    var s = 0usize;
    while s < seats.len() {
      self.tell(s, text);
      s = s + 1usize;
    }
  }
}

// ---------------------------------------------------------------------------
// A player
// ---------------------------------------------------------------------------

actor Player {
  name: String;
  conn: Option[Connection];
  snapshots: u32;
  lastTick: u32;
  lastX: i32;
  lastY: i32;
  heardChat: u32;
  report: Sender[String];

  fn init(self: &new, name: String, report: Sender[String]) {
    *self = Self(name: name, conn: None[Connection], snapshots: 0u32, lastTick: 0u32, lastX: 0i32, lastY: 0i32,
      heardChat: 0u32, report: report);
  }

  pub async do onNet(self, ev: NetEvent) {
    match ev {
      case let Joined(j) {
        conn = Some[Connection](j.conn);
        j.conn.sendReliable(bytesOf(self.hello().view()));
      }
      case let Left(l) {
        var s = String.from(name.view());
        s.append(": the connection ended\n");
        printStr(s.view());
      }
      case let Message(m) {
        let text = textOf(&m.data);
        if text.view().startsWith("chat ") || text.view().startsWith("news ") {
          heardChat = heardChat + 1u32;
          var s = String.from(name.view());
          s.append(" hears: ");
          s.append(text.view());
          s.append("\n");
          printStr(s.view());
        }
      }
      case let Update(u) {
        // The snapshot's tick and the first body's position
        var c = PacketReader.start();
        lastTick = c.rdU32(u.data.view());
        c.skip(u.data.view(), 2usize);
        lastX = i32.from(c.rdU32(u.data.view()));
        lastY = i32.from(c.rdU32(u.data.view()));
        snapshots = snapshots + 1u32;
      }
      case let Refused(r) {}
    }
  }

  fn hello(self: &) String {
    var h = String.from("hello ");
    h.append(name.view());
    h
  }

  // Steer: send the input as a reliable message
  pub async do steer(self, dx: i32, dy: i32) {
    match &conn {
      case let &Some[Connection](c) {
        var t = String.from("input ");
        t.appendInt(i64.from(dx));
        t.append(" ");
        t.appendInt(i64.from(dy));
        c.sendReliable(bytesOf(t.view()));
      }
      else {}
    }
  }

  pub async do chat(self, text: String) {
    match &conn {
      case let &Some[Connection](c) {
        var t = String.from("chat ");
        t.append(text.view());
        c.sendReliable(bytesOf(t.view()));
      }
      else {}
    }
  }

  // Say what this player saw
  pub async do finish(self) {
    var s = String.from(name.view());
    s.append(" saw ");
    s.appendUInt(u64.from(snapshots));
    s.append(" snapshots, the last of tick ");
    s.appendUInt(u64.from(lastTick));
    s.append(" with body 0 at (");
    s.appendInt(i64.from(lastX));
    s.append(", ");
    s.appendInt(i64.from(lastY));
    s.append("), and ");
    s.appendUInt(u64.from(heardChat));
    s.append(" chat/news lines");
    report.send(s);
  }
}

fn serverHandler(srv: GameServer) EventHandler {
  eventHandler(Uni[fn(ev: NetEvent) + Sendable](fn(ev: NetEvent) [srv] { srv.onNet(ev); }))
}

fn playerHandler(p: Player) EventHandler {
  eventHandler(Uni[fn(ev: NetEvent) + Sendable](fn(ev: NetEvent) [p] { p.onNet(ev); }))
}

// ---------------------------------------------------------------------------
// Running it
// ---------------------------------------------------------------------------

// The game for 'seconds': the server ticks at 30 Hz; the players steer and chat
fn play(srv: GameServer, a: Player, b: Player, seconds: i64) {
  let steps = seconds * 30i64;
  var i = 0i64;
  while i < steps {
    srv.tick();
    if i % 15i64 == 3i64 {a.steer(i32.from((i % 7i64) * 20i64 - 60i64), 40i32);}
    if i % 15i64 == 8i64 {b.steer(30i32, i32.from((i % 5i64) * 25i64 - 50i64));}
    if i == 10i64 {a.chat(String.from("hello from Ann"));}
    if i == 20i64 {b.chat(String.from("hi Ann, Bob here"));}
    thread.sleep(Duration.fromMillis(33i64));
    i = i + 1i64;
  }
  thread.sleep(Duration.fromMillis(400i64));
}

fn printReports(rx: &mut Receiver[String], n: usize) {
  var k = 0usize;
  while k < n {
    match rx.recvTimeout(Duration.fromSeconds(5i64)) {
      case let Some(s) { print <- s.view(), "\n"; }
      case is None[String] {}
    }
    k = k + 1usize;
  }
}

fn inProcess() {
  print <- "== in-process: no sockets, the server and two players in one process ==\n";
  var tx: Sender[String];
  var rx: Receiver[String];
  tx, rx = Channel[String].make();
  {
    let srv = GameServer();
    let ann = Player(String.from("Ann"), tx.clone());
    let bob = Player(String.from("Bob"), tx.clone());
    let pairA = pairInProcess(serverHandler(srv), 1u32, playerHandler(ann), 1u32);
    let pairB = pairInProcess(serverHandler(srv), 2u32, playerHandler(bob), 1u32);
    play(srv, ann, bob, 3i64);
    ann.finish();
    bob.finish();
    printReports(&mut rx, 2usize);
    pairA.a.close();
    pairB.a.close();
    thread.sleep(Duration.fromMillis(100i64));
  }
}

fn overLoopback() {
  print <- "== loopback UDP, 20% loss each way, 25-35 ms delay, through a relay ==\n";
  var tx: Sender[String];
  var rx: Receiver[String];
  tx, rx = Channel[String].make();
  {
    let srv = GameServer();
    let cfg = NetConfig.defaults();
    let server = mustListen(SocketAddr.localhost(0u16), cfg, serverHandler(srv));
    let link = LinkConfig(200u32, 25i64, 10i64, 20u32, 20u32, 30i64);
    var relay = startLossyRelay(SocketAddr.localhost(server.port), link, link, 3u64);
    let ann = Player(String.from("Ann"), tx.clone());
    let bob = Player(String.from("Bob"), tx.clone());
    let ca = mustConnect(SocketAddr.localhost(relay.port), cfg, playerHandler(ann));
    let cb = mustConnect(SocketAddr.localhost(relay.port), cfg, playerHandler(bob));
    thread.sleep(Duration.fromMillis(600i64));
    play(srv, ann, bob, 4i64);
    ann.finish();
    bob.finish();
    printReports(&mut rx, 2usize);
    ca.endpoint.shutdown();
    cb.endpoint.shutdown();
    server.endpoint.shutdown();
    relay.stop();
  }
}

// An IPv4 address a.b.c.d
fn parseAddress(host: &str, port: u16) SocketAddr {
  let parts = String.from(host).split('.');
  var n = List[u8].empty();
  var i = 0usize;
  while i < parts.len() {
    match parseUInt(parts[i].view()) {
      case let Some(v) { n.push(u8.from(v)); }
      case is None[u64] {}
    }
    i = i + 1usize;
  }
  if n.len() != 4usize {
    print <- "demo: the address must be four numbers: a.b.c.d\n";
    return SocketAddr.localhost(port);
  }
  SocketAddr.v4(*n[0usize], *n[1usize], *n[2usize], *n[3usize], port)
}

fn serve(port: u16) {
  print <- "== serving on UDP port ", u64.from(port), " for 60 seconds ==\n";
  {
    let srv = GameServer();
    let server = mustListen(SocketAddr.v4(0u8, 0u8, 0u8, 0u8, port), NetConfig.defaults(), serverHandler(srv));
    var i = 0i64;
    while i < 60i64 * 30i64 {
      srv.tick();
      thread.sleep(Duration.fromMillis(33i64));
      i = i + 1i64;
    }
    server.endpoint.shutdown();
  }
}

fn connectTo(host: &str, port: u16, name: &str) {
  print <- "== ", name, " connecting to ", host, ":", u64.from(port), " ==\n";
  var tx: Sender[String];
  var rx: Receiver[String];
  tx, rx = Channel[String].make();
  {
    let me = Player(String.from(name), tx);
    let c = mustConnect(parseAddress(host, port), NetConfig.defaults(), playerHandler(me));
    var i = 0i64;
    while i < 8i64 * 30i64 {
      if i % 15i64 == 3i64 {me.steer(25i32, i32.from((i % 9i64) * 10i64 - 40i64));}
      if i == 30i64 {me.chat(String.from("hello everyone"));}
      thread.sleep(Duration.fromMillis(33i64));
      i = i + 1i64;
    }
    me.finish();
    printReports(&mut rx, 1usize);
    c.endpoint.shutdown();
  }
}

fn main() {
  let args = process.args();
  if args.len() >= 3usize && args[1usize].view() == "serve" {
    match parseUInt(args[2usize].view()) {
      case let Some(p) { serve(u16.from(p)); }
      case is None[u64] { print <- "demo: serve PORT\n"; }
    }
  } elif args.len() >= 5usize && args[1usize].view() == "connect" {
    match parseUInt(args[3usize].view()) {
      case let Some(p) { connectTo(args[2usize].view(), u16.from(p), args[4usize].view()); }
      case is None[u64] { print <- "demo: connect HOST PORT NAME\n"; }
    }
  } elif args.len() >= 2usize && args[1usize].view() == "inprocess" {
    inProcess();
  } elif args.len() >= 2usize && args[1usize].view() == "loopback" {
    overLoopback();
  } else {
    inProcess();
    overLoopback();
  }
}
