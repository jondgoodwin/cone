// Option's and Result's isTrue, which a condition asks: true on Some and on Ok.
// The values are Logs, which say when they are finalized, so the lines pin that
// the test lends the value and consumes nothing: each is finalized once, at the
// end of main, after every test of it. Each line was worked out by hand from the
// source.

mod istrue;

import stdio use *;

struct Log {
  pub n: i32;
  fn final(self: &uni) { print <- "  final ", n, "\n"; }
}

fn main() {
  let some: Option[Log] = Some[Log](Log(1));
  let none: Option[Log] = None[Log];
  let ok: Result[Log, i32] = Ok[Log, i32](Log(2));
  let err: Result[Log, i32] = Err[Log, i32](3);

  print <- "called:\n";
  print <- "  Some ", some.isTrue(), "\n";
  print <- "  None ", none.isTrue(), "\n";
  print <- "  Ok ", ok.isTrue(), "\n";
  print <- "  Err ", err.isTrue(), "\n";

  print <- "conditions:\n";
  if some { print <- "  if Some\n"; }
  if none { print <- "  if None\n"; } else { print <- "  else None\n"; }
  if ok { print <- "  if Ok\n"; }
  if err { print <- "  if Err\n"; } else { print <- "  else Err\n"; }

  print <- "still held:\n";
  match some {
    case let Some(v) { print <- "  Some ", v.n, "\n"; }
    case is None { }
  }

  print <- "end of main:\n";
}
