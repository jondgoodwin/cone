// Option's unwrap on None is a panic, reported at the line of the call (unwrap
// passes its caller's srcFile and srcLine on), so the .err names this file. Its
// .exit is a panic's, abort's status (badorder says more). What the program
// printed before is kept: a panic flushes stdout first.

mod unwrapnone;

import stdio use *;

fn main() {
  let full: Option[i32] = Some(1);
  print <- "Some unwraps to ", full.unwrap(), "\n";
  let empty: Option[i32] = None;
  print <- "None does not\n";
  let n = empty.unwrap();
  print <- "never printed ", n, "\n";
}
