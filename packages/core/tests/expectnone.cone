// Option's expect on None is a panic with the caller's message, reported at the
// line of the call, so the .err names this file. Its .exit is a panic's (badorder
// says more).

mod expectnone;

import stdio use *;

fn main() {
  let full: Option[i32] = Some(1);
  print <- "Some gives ", full.expect("a value is there"), "\n";
  let empty: Option[i32] = None;
  print <- "None does not\n";
  let n = empty.expect("the setting was read at startup");
  print <- "never printed ", n, "\n";
}
