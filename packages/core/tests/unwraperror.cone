// Result's unwrap on an Error is a panic, reported at the line of the call, so
// the .err names this file. The error itself is not printed: E may be any type,
// and core has no way to print one. Its .exit is a panic's (badorder says more).

mod unwraperror;

import stdio use *;

fn main() {
  let good: Result[i32, i32] = Ok(1);
  print <- "Ok unwraps to ", good.unwrap(), "\n";
  let bad: Result[i32, i32] = Error(2);
  print <- "an Error does not\n";
  let n = bad.unwrap();
  print <- "never printed ", n, "\n";
}
