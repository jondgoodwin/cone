// Result's helpers (WI error-handling, issue 4): unwrap, expect, map, mapError,
// andThen, ok, error, asRef, asMut and flatten, each on Ok and on Err. As in
// optionhelpers, the values are Logs, which say when they are finalized, so the
// lines pin what each helper moves and what it drops: Ok's value and the error
// alike are finalized once, and the side a helper does not answer is dropped
// inside it. Each line was worked out by hand from the source. The panics of
// unwrap and expect on an Err are the tests unwraperror and expecterror.

mod resulthelpers;

import stdio use *;

struct Log {
  pub n: i32;
  fn final(self: &uni) { print <- "  final ", n, "\n"; }
}

fn ok(n: i32) Result[Log, Log] { Ok[Log, Log](Log(n)) }
fn err(n: i32) Result[Log, Log] { Err[Log, Log](Log(n)) }

fn show(r: &Result[i32, i32]) {
  match r {
    case let Ok(v) { print <- "  Ok ", *v, "\n"; }
    case let Err(e) { print <- "  Error ", *e, "\n"; }
  }
}

fn main() {
  print <- "unwrap:\n";
  let a = ok(1).unwrap();
  print <- "  got ", a.n, "\n";

  print <- "expect:\n";
  let b = ok(2).expect("there is a 2");
  print <- "  got ", b.n, "\n";

  print <- "map:\n";
  let m = ok(3).map(fn(l: Log) i32 { l.n * 10 });                    // 3 dies inside the closure
  match m {
    case let Ok(v) { print <- "  Ok ", v, "\n"; }
    case let Err(e) { print <- "  Error ", e.n, "\n"; }
  }
  let me = err(4).map(fn(l: Log) i32 { l.n * 10 });                   // the error passes through
  match me {
    case let Ok(v) { print <- "  Ok ", v, "\n"; }
    case let Err(e) { print <- "  Error ", e.n, "\n"; }
  }

  print <- "mapError:\n";
  let em = err(5).mapError(fn(l: Log) i32 { l.n * 100 });             // 5 dies inside the closure
  match em {
    case let Ok(v) { print <- "  Ok ", v.n, "\n"; }
    case let Err(e) { print <- "  Error ", e, "\n"; }
  }
  let eo = ok(6).mapError(fn(l: Log) i32 { l.n * 100 });              // Ok passes through
  match eo {
    case let Ok(v) { print <- "  Ok ", v.n, "\n"; }
    case let Err(e) { print <- "  Error ", e, "\n"; }
  }

  print <- "andThen:\n";
  let r7: Result[i32, i32] = Ok(7);
  show(&r7.andThen(fn(x: i32) Result[i32, i32] { Ok[i32, i32](x + 1) }));
  show(&r7.andThen(fn(x: i32) Result[i32, i32] { Err[i32, i32](x - 1) }));
  let e9: Result[i32, i32] = Err(9);
  show(&e9.andThen(fn(x: i32) Result[i32, i32] { Ok[i32, i32](x + 1) }));

  print <- "ok:\n";
  let o = ok(10).ok();
  print <- "  Some ", o.unwrap().n, "\n";
  let on = err(11).ok();                                              // 11 dropped inside
  print <- "  of an Error is none: ", on is None, "\n";

  print <- "error:\n";
  let e = err(12).error();
  print <- "  Some ", e.unwrap().n, "\n";
  let en = ok(13).error();                                            // 13 dropped inside
  print <- "  of Ok is none: ", en is None, "\n";

  print <- "asRef:\n";
  let view = ok(14);
  match view.asRef() {
    case let Ok(r) { print <- "  sees Ok ", r.n, "\n"; }
    case let Err(r) { print <- "  sees Error ", r.n, "\n"; }
  }
  let eview = err(15);
  match eview.asRef() {
    case let Ok(r) { print <- "  sees Ok ", r.n, "\n"; }
    case let Err(r) { print <- "  sees Error ", r.n, "\n"; }
  }
  print <- "  both still held: ", view is Ok, " ", eview is Err, "\n";

  print <- "asMut:\n";
  var edit = ok(16);
  match edit.asMut() {
    case let Ok(r) { r.n = 17; }
    case let Err(r) { r.n = 0; }
  }
  var eedit = err(18);
  match eedit.asMut() {
    case let Ok(r) { r.n = 0; }
    case let Err(r) { r.n = 19; }
  }
  print <- "  now ", edit.asRef().unwrap().n, " and ", eedit.asRef().error().unwrap().n, "\n";

  print <- "flatten:\n";
  let okok: Result[Result[i32, i32], i32] = Ok[Result[i32, i32], i32](Ok[i32, i32](20));
  let flat: Result[i32, i32] = okok.flatten();
  show(&flat);
  let okerr: Result[Result[i32, i32], i32] = Ok[Result[i32, i32], i32](Err[i32, i32](21));
  show(&okerr.flatten());
  let outer: Result[Result[i32, i32], i32] = Err[Result[i32, i32], i32](22);
  show(&outer.flatten());

  print <- "end of main:\n";
}
