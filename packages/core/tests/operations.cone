// Every operation of Atomic[T], in its everyday form and its 'Ordered' form
// with each ordering it may take, on integers of each width and signedness.
// Each expected value is worked out by hand: a read-modify-write answers the
// value before it, add and sub wrap, and a compareSwap stores only when the
// value is the one expected. One thread sees the same values whatever the
// ordering; which instruction each form becomes is the compiler suite's to pin
// (concurrency_atomic_ops).

mod operations;

import testing use *;

fn u64s() {
  imm a = Atomic[u64].of(10u64);
  expectUInt(a.load(), 10u64, "of then load");
  a.store(12u64);
  expectUInt(a.load(), 12u64, "store");
  expectUInt(a.swap(20u64), 12u64, "swap answers the value before");
  expectUInt(a.add(5u64), 20u64, "add answers the value before");
  expectUInt(a.sub(3u64), 25u64, "sub answers the value before");
  expectUInt(a.load(), 22u64, "after add 5 and sub 3");
  expectUInt(a.bitAnd(0x0Fu64), 22u64, "bitAnd answers the value before");
  expectUInt(a.load(), 6u64, "22 and 15");
  expectUInt(a.bitOr(0x30u64), 6u64, "bitOr answers the value before");
  expectUInt(a.load(), 54u64, "6 or 48");
  expectUInt(a.bitXor(0x06u64), 54u64, "bitXor answers the value before");
  expectUInt(a.load(), 48u64, "54 xor 6");

  mut seen = 0u64;
  mut ok = false;
  seen, ok = a.compareSwap(48u64, 49u64);
  expectUInt(seen, 48u64, "compareSwap sees 48");
  expectBool(ok, true, "and stores");
  seen, ok = a.compareSwap(48u64, 50u64);
  expectUInt(seen, 49u64, "compareSwap sees 49");
  expectBool(ok, false, "and does not store");
  expectUInt(a.load(), 49u64, "the failed compareSwap left it");

  // Add and sub wrap
  imm m = Atomic[u64].of(0xFFFFFFFFFFFFFFFFu64);
  expectUInt(m.add(1u64), 0xFFFFFFFFFFFFFFFFu64, "add at the top");
  expectUInt(m.load(), 0u64, "wraps to 0");
  expectUInt(m.sub(1u64), 0u64, "sub at 0");
  expectUInt(m.load(), 0xFFFFFFFFFFFFFFFFu64, "wraps to the top");
}

fn ordered() {
  imm a = Atomic[i32].of(0i32);
  a.storeOrdered(1i32, MemOrder.Relaxed[]);
  a.storeOrdered(2i32, MemOrder.Release[]);
  a.storeOrdered(3i32, MemOrder.SeqCst[]);
  expectInt(i64[a.loadOrdered(MemOrder.Relaxed[])], 3, "loadOrdered Relaxed");
  expectInt(i64[a.loadOrdered(MemOrder.Acquire[])], 3, "loadOrdered Acquire");
  expectInt(i64[a.loadOrdered(MemOrder.SeqCst[])], 3, "loadOrdered SeqCst");

  expectInt(i64[a.addOrdered(1i32, MemOrder.Relaxed[])], 3, "addOrdered Relaxed");
  expectInt(i64[a.addOrdered(1i32, MemOrder.Acquire[])], 4, "addOrdered Acquire");
  expectInt(i64[a.addOrdered(1i32, MemOrder.Release[])], 5, "addOrdered Release");
  expectInt(i64[a.addOrdered(1i32, MemOrder.AcqRel[])], 6, "addOrdered AcqRel");
  expectInt(i64[a.addOrdered(1i32, MemOrder.SeqCst[])], 7, "addOrdered SeqCst");
  expectInt(i64[a.subOrdered(10i32, MemOrder.AcqRel[])], 8, "subOrdered");
  expectInt(i64[a.load()], -2, "8 minus 10 is -2");
  expectInt(i64[a.swapOrdered(12i32, MemOrder.Acquire[])], -2, "swapOrdered");
  expectInt(i64[a.bitAndOrdered(4i32, MemOrder.Release[])], 12, "bitAndOrdered");
  expectInt(i64[a.bitOrOrdered(3i32, MemOrder.Relaxed[])], 4, "bitOrOrdered");
  expectInt(i64[a.bitXorOrdered(1i32, MemOrder.SeqCst[])], 7, "bitXorOrdered");
  expectInt(i64[a.load()], 6, "7 xor 1");

  // An ordering held in a variable reaches the arm that names it
  mut order MemOrder = MemOrder.Relaxed[];
  expectInt(i64[a.addOrdered(1i32, order)], 6, "addOrdered through a variable");
  order = MemOrder.AcqRel[];
  expectInt(i64[a.addOrdered(1i32, order)], 7, "and another");

  // compareSwap's failure ordering with each success ordering it allows
  mut seen = 0i32;
  mut ok = false;
  seen, ok = a.compareSwapOrdered(8i32, 9i32, MemOrder.Relaxed[], MemOrder.Relaxed[]);
  expectBool(ok, true, "Relaxed, Relaxed stores");
  seen, ok = a.compareSwapOrdered(9i32, 10i32, MemOrder.Release[], MemOrder.Relaxed[]);
  expectBool(ok, true, "Release, Relaxed stores");
  seen, ok = a.compareSwapOrdered(10i32, 11i32, MemOrder.AcqRel[], MemOrder.Acquire[]);
  expectBool(ok, true, "AcqRel, Acquire stores");
  seen, ok = a.compareSwapOrdered(10i32, 12i32, MemOrder.Acquire[], MemOrder.Acquire[]);
  expectInt(i64[seen], 11, "Acquire, Acquire sees 11");
  expectBool(ok, false, "and does not store");
  seen, ok = a.compareSwapOrdered(11i32, 12i32, MemOrder.SeqCst[], MemOrder.SeqCst[]);
  expectBool(ok, true, "SeqCst, SeqCst stores");
  expectInt(i64[a.load()], 12, "after the compareSwaps");
}

fn widths() {
  imm b = Atomic[u8].of(255u8);
  expectUInt(u64[b.add(1u8)], 255, "u8 add at 255");
  expectUInt(u64[b.load()], 0, "wraps to 0");
  imm h = Atomic[i16].of(-5i16);
  expectInt(i64[h.add(10i16)], -5, "i16 add");
  expectInt(i64[h.load()], 5, "to 5");
  imm z = Atomic[usize].of(1usize);
  expectUInt(u64[z.bitOr(6usize)], 1, "usize bitOr");
  expectUInt(u64[z.load()], 7, "to 7");
  imm s = Atomic[isize].of(3isize);
  expectInt(i64[s.sub(4isize)], 3, "isize sub");
  expectInt(i64[s.load()], -1, "to -1");
  imm w = Atomic[i64].of(-1i64);
  expectInt(w.bitXor(-1i64), -1, "i64 bitXor");
  expectInt(w.load(), 0, "to 0");
}

// The value taken out by the one holding it
fn inner() {
  mut a = Atomic[u32].of(40u32);
  a.add(2u32);
  expectUInt(u64[a.inner()], 42, "inner");
}

fn main() i32 {
  u64s();
  ordered();
  widths();
  inner();
  done();
}
