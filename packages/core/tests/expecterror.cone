// Result's expect on an Error is a panic with the caller's message, reported at
// the line of the call, so the .err names this file. Its .exit is a panic's
// (badorder says more).

mod expecterror;

import stdio use *;

fn main() {
  let good: Result[i32, i32] = Ok(1);
  print <- "Ok gives ", good.expect("parsed"), "\n";
  let bad: Result[i32, i32] = Error(2);
  print <- "an Error does not\n";
  let n = bad.expect("the config file parses");
  print <- "never printed ", n, "\n";
}
