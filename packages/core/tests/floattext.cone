// FloatText: the shortest text that reads back as the same float, at the
// edges. Each expected text is Python's repr of the same f64 (an f32's is the
// shortest that reads back as that f32, which numpy's repr of a float32
// gives); the slow proof that every text reads back, and that no shorter one
// does, is packages/json/examples/floatproof.cone.

mod floattext;

import stdio use *;

fn show(label: &str, x: f64) {
  printStr(label);
  printStr(" ");
  printStr(FloatText(x).text());
  printStr("\n");
}

fn show32(label: &str, x: f32) {
  printStr(label);
  printStr(" ");
  printStr(FloatText.ofF32(x).text());
  printStr("\n");
}


fn main() {
  show("zero", 0.0);
  show("negative zero", f64.fromBits(0x8000000000000000u64));
  show("one", 1.0);
  show("minus one and a half", -1.5);
  show("0.1", 0.1);
  show("0.2", 0.2);
  show("0.3", 0.3);
  show("0.1 + 0.2", 0.1 + 0.2);
  show("1/3", 1.0 / 3.0);
  show("least denormal", f64.fromBits(1u64));
  show("greatest denormal", f64.fromBits(0x000FFFFFFFFFFFFFu64));
  show("least normal", f64.fromBits(0x0010000000000000u64));
  show("greatest finite", f64.fromBits(0x7FEFFFFFFFFFFFFFu64));
  show("2^53 - 1", 9007199254740991.0);
  show("2^53", 9007199254740992.0);
  show("2^53 + 2", 9007199254740994.0);
  show("9007199254740993", 9007199254740993.0);
  show("1e15", 1e15);
  show("1e16", 1e16);
  show("1e22", 1e22);
  show("1e23", 1e23);
  show("0.0001", 0.0001);
  show("0.00001", 0.00001);
  show("123456.789", 123456.789);
  show("5e-324", 5e-324);
  show("inf", f64.fromBits(0x7FF0000000000000u64));
  show("-inf", f64.fromBits(0xFFF0000000000000u64));
  show("nan", f64.fromBits(0x7FF8000000000000u64));
  show("negative nan", f64.fromBits(0xFFF8000000000001u64));
  show32("f32 0.1", 0.1f32);
  show32("f32 1/3", 1.0f32 / 3.0f32);
  show32("f32 16777216", 16777216.0f32);
  show32("f32 greatest finite", f32.fromBits(0x7F7FFFFFu32));
  show32("f32 least denormal", f32.fromBits(1u32));
  show32("f32 negative zero", f32.fromBits(0x80000000u32));

  // FloatText.shortest: the digits (no trailing zero), the power of ten of the
  // last, and the sign; each is the digits of the text above
  digits("digits 0.1", 0.1);
  digits("digits -1.5", -1.5);
  digits("digits 100", 100.0);
  digits("digits 1e22", 1e22);
  digits("digits 1e23", 1e23);
  digits("digits 123456.789", 123456.789);
  digits("digits least denormal", f64.fromBits(1u64));
  digits("digits greatest finite", f64.fromBits(0x7FEFFFFFFFFFFFFFu64));
  digits("digits 2^53 + 2", 9007199254740994.0);
  digits("digits zero", 0.0);
  digits("digits negative zero", f64.fromBits(0x8000000000000000u64));
  digits("digits -inf", f64.fromBits(0xFFF0000000000000u64));
  digits("digits nan", f64.fromBits(0x7FF8000000000000u64));
  digits32("digits f32 0.1", 0.1f32);
  digits32("digits f32 16777216", 16777216.0f32);
  digits32("digits f32 greatest finite", f32.fromBits(0x7F7FFFFFu32));
  digits32("digits f32 least denormal", f32.fromBits(1u32));
  digits32("digits f32 -inf", f32.fromBits(0xFF800000u32));
}

fn showDigits(label: &str, fd: FloatDigits) {
  printStr(label);
  printStr(" ");
  printInt(i64.from(fd.digits));
  printStr(" e");
  printInt(i64.from(fd.exponent));
  printStr(if fd.negative {" neg"} else {" pos"});
  printStr("\n");
}

fn digits(label: &str, x: f64) { showDigits(label, FloatText.shortest(x)); }

fn digits32(label: &str, x: f32) { showDigits(label, FloatText.shortestF32(x)); }
