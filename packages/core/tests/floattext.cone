// FloatText: the shortest text that reads back as the same float, at the
// edges. Each expected text is Python's repr of the same f64 (an f32's is the
// shortest that reads back as that f32, which numpy's repr of a float32
// gives); the slow proof that every text reads back, and that no shorter one
// does, is packages/json/examples/floatproof.cone.

mod floattext;

import stdio use *;

fn show(label: &str, x: f64) {
  printStr(label);
  printStr(" ");
  printStr(FloatText(x).text());
  printStr("\n");
}

fn show32(label: &str, x: f32) {
  printStr(label);
  printStr(" ");
  printStr(FloatText.ofF32(x).text());
  printStr("\n");
}

fn bits(b: u64) f64 {b as f64}

fn main() {
  show("zero", 0.0);
  show("negative zero", bits(0x8000000000000000u64));
  show("one", 1.0);
  show("minus one and a half", -1.5);
  show("0.1", 0.1);
  show("0.2", 0.2);
  show("0.3", 0.3);
  show("0.1 + 0.2", 0.1 + 0.2);
  show("1/3", 1.0 / 3.0);
  show("least denormal", bits(1u64));
  show("greatest denormal", bits(0x000FFFFFFFFFFFFFu64));
  show("least normal", bits(0x0010000000000000u64));
  show("greatest finite", bits(0x7FEFFFFFFFFFFFFFu64));
  show("2^53 - 1", 9007199254740991.0);
  show("2^53", 9007199254740992.0);
  show("2^53 + 2", 9007199254740994.0);
  show("9007199254740993", 9007199254740993.0);
  show("1e15", 1e15);
  show("1e16", 1e16);
  show("1e22", 1e22);
  show("1e23", 1e23);
  show("0.0001", 0.0001);
  show("0.00001", 0.00001);
  show("123456.789", 123456.789);
  show("5e-324", 5e-324);
  show("inf", bits(0x7FF0000000000000u64));
  show("-inf", bits(0xFFF0000000000000u64));
  show("nan", bits(0x7FF8000000000000u64));
  show("negative nan", bits(0xFFF8000000000001u64));
  show32("f32 0.1", 0.1f32);
  show32("f32 1/3", 1.0f32 / 3.0f32);
  show32("f32 16777216", 16777216.0f32);
  show32("f32 greatest finite", 0x7F7FFFFFu32 as f32);
  show32("f32 least denormal", 1u32 as f32);
  show32("f32 negative zero", 0x80000000u32 as f32);
}
