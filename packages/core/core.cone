// core's include file, written by hand: the prelude's declarations as a
// package importing core would compile against them. Everything core has is
// 'inline', generic or 'extern' (malloc is the C runtime's), so this says what
// src/core.cone says and core's object defines nothing.
//
// The compiler loads the prelude itself, from the package search path, where a
// Congo package's src/core.cone is found ahead of this file; so no compile
// reads this file today. It is here so that core has the shape every package
// has: a manifest, its source under src/, and its include file at the root.

mod core;

pub enum Option[T] {
  struct None {}
  struct Some {pub value T;}
}

pub enum Result[T,E] {
  struct Ok {pub value T;}
  struct Error {pub value E;}
}

pub use Option;
pub use Result;

pub extern fn @c malloc(size usize) *u8;

pub struct @move so {
  fn alloc(size usize) *u8 inline {malloc(size);}
}

pub struct rc {
  cnt usize;
  fn alloc(size usize) *u8 inline {malloc(size);}
  fn init() rc inline {rc[1usize];}
}
