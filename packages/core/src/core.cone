// The core package: the prelude. The compiler loads it before any module of the
// program and wildcard-imports it into every module, so its public names are in
// reach everywhere without an 'import'. A compile without a build description
// finds it on the package search path like any package, and nowhere else.
//
// Everything here is 'inline', generic, 'extern' or an intrinsic, so core's
// object defines nothing. Congo compiles core on its own like any package, and that compile
// generates core's include file, which says what this file says; every package
// Congo compiles after it loads the prelude from that include file, which its
// build description's package line for core names.
//
// The C runtime's allocator is libc's, whose package declares it once for the
// whole program. core imports libc, which, being a C-named module, gets no
// prelude of its own, so the import makes no loop; Congo builds libc before
// core. A panic's work is conestd's, the runtime every program links.

mod core;

// libc's 'malloc' is folded in publicly, so it stays a bare name of every
// module, as a region's own allocator writes it; 'libc' itself is not. A module
// that imports libc and folds its names in too meets the same declaration by
// two routes nobody wrote, which is one binding, not a collision
import libc pub use malloc;

// A variant declared as a type, 'Some T;', holds that type itself: it has no
// field name, and a pattern that binds it ('case imm n Some') gets the T
pub enum Option[T] {
  None;
  Some T;
}

pub enum Result[T,E] {
  Ok T;
  Error E;
}

// A variant is a name of its enum, so these two statements are what make Some,
// None, Ok and Error bare names of core. They are 'pub', and every module's
// automatic import of core folds its public names, which carries them on into
// every program
pub use Option;
pub use Result;

// 'str', the body of text: bytes, UTF-8 by convention, held only through a
// reference that carries their count ('&str', 'So[str]', 'Rc[str]'). The
// compiler makes the type (corelib.c); this is its methods, written once, and
// a 'String' or any owner of either reaches them. Positions are bytes, and a
// position that is not the start of a character is a program error where a
// method says so.
pub struct @opaque str {
  // The number of bytes, not characters
  pub fn len(self &) usize inline {
    imm b &Array[u8] = self;
    b.len;
  }

  pub fn isEmpty(self &) bool inline {
    imm b &Array[u8] = self;
    b.len == 0usize;
  }

  // The bytes themselves
  pub fn bytes(self &) &Array[u8] inline { self; }

  // The code points, in order: a cursor whose 'next' gives each as a char. A
  // byte that is not part of well-formed UTF-8 reads as U+FFFD, one for each
  // such byte, so every char given is valid. Code points, not graphemes: a
  // letter and its combining accent are two.
  pub fn chars(self &) StrChars inline { new StrChars(self, 0usize); }

  // The code points with the byte index each starts at, a cursor whose 'next'
  // gives a StrCharIndex (its 'offset' and its 'ch')
  pub fn charIndices(self &) StrCharIndices inline { new StrCharIndices(self, 0usize); }

  // How many code points there are, counted by walking the text (O(n)); 'len' is
  // the byte count. The count of what 'chars' gives.
  pub fn charCount(self &) usize inline {
    imm b &Array[u8] = self;
    mut i = 0usize;
    mut count = 0usize;
    while i < b.len {
      i = i + strCharWidth(b, i);
      count = count + 1usize;
    }
    count;
  }

  // The byte at index; an index past the end is a program error
  pub fn `[]`(self &, index usize) u8 inline {
    imm b &Array[u8] = self;
    b[index];
  }

  // Whether a character starts at byte index, or the text ends there: the
  // places a slice may begin or end. Past the end it is false.
  pub fn isCharBoundary(self &, index usize) bool inline {
    imm b &Array[u8] = self;
    if index > b.len { false; }
    else if index == b.len { true; }
    else { (b[index] & 0xC0u8) != 0x80u8; }
  }

  // The part from byte start up to, not including, byte end: what
  // '&s[start..end]' is. A range out of order or past the end, and a bound
  // that falls inside a character, are program errors, as in Rust.
  pub fn slice(self &, start usize, end usize, file &Array[u8] = srcFile(), line u32 = srcLine()) &str inline {
    strCheckRange(self, start, end, file, line);
    imm b &Array[u8] = self;
    &b[start..end] as &str;
  }

  // '&s[start..]'
  pub fn sliceFrom(self &, start usize, file &Array[u8] = srcFile(), line u32 = srcLine()) &str inline {
    imm b &Array[u8] = self;
    self.slice(start, b.len, file, line);
  }

  // '&s[start...last]', the byte at last included
  pub fn sliceThrough(self &, start usize, last usize, file &Array[u8] = srcFile(), line u32 = srcLine()) &str inline {
    self.slice(start, last + 1usize, file, line);
  }

  // Whether the text begins, or ends, with these bytes
  pub fn startsWith(self &, prefix &str) bool inline {
    imm b &Array[u8] = self;
    imm p &Array[u8] = prefix;
    p.len <= b.len and strBytesAt(b, 0usize, p);
  }

  pub fn endsWith(self &, suffix &str) bool inline {
    imm b &Array[u8] = self;
    imm p &Array[u8] = suffix;
    p.len <= b.len and strBytesAt(b, b.len - p.len, p);
  }

  // Where needle first starts, as a byte index, or None. An empty needle is
  // found at 0.
  pub fn find(self &, needle &str) Option[usize] inline {
    self.findFrom(needle, 0usize);
  }

  // Where needle first starts at or after byte index from
  pub fn findFrom(self &, needle &str, from usize) Option[usize] inline {
    imm b &Array[u8] = self;
    imm n &Array[u8] = needle;
    mut i = from;
    while i + n.len <= b.len {
      if strBytesAt(b, i, n) { return Some[usize][i]; }
      i = i + 1usize;
    }
    None[usize][];
  }

  pub fn contains(self &, needle &str) bool inline {
    match self.findFrom(needle, 0usize) {
      case is Some[usize] {true;}
      case is None[usize] {false;}
    }
  }

  // The text without the ASCII whitespace (space, tab, line feed, form feed,
  // carriage return) at its start, at its end, or at both
  pub fn trimStart(self &) &str inline {
    imm b &Array[u8] = self;
    mut a = 0usize;
    while a < b.len and strIsSpace(b[a]) { a = a + 1usize; }
    &b[a..] as &str;
  }

  pub fn trimEnd(self &) &str inline {
    imm b &Array[u8] = self;
    mut e = b.len;
    while e > 0usize and strIsSpace(b[e - 1usize]) { e = e - 1usize; }
    &b[..e] as &str;
  }

  pub fn trim(self &) &str inline {
    imm b &Array[u8] = self;
    mut a = 0usize;
    mut e = b.len;
    while a < e and strIsSpace(b[a]) { a = a + 1usize; }
    while e > a and strIsSpace(b[e - 1usize]) { e = e - 1usize; }
    &b[a..e] as &str;
  }

  // -1, 0 or 1 as the bytes sort before, with or after o's, a text that is
  // the start of a longer one first. UTF-8's byte order is code-point order.
  pub fn compare(self &, o &str) i32 inline {
    imm a &Array[u8] = self;
    imm b &Array[u8] = o;
    mut i = 0usize;
    while i < a.len and i < b.len {
      if a[i] < b[i] { return -1i32; }
      if a[i] > b[i] { return 1i32; }
      i = i + 1usize;
    }
    if a.len < b.len { -1i32; } else if a.len > b.len { 1i32; } else { 0i32; }
  }

  // The same bytes
  pub fn eq overload `==`(self &, o &str) bool inline {
    imm a &Array[u8] = self;
    imm b &Array[u8] = o;
    a.len == b.len and strBytesAt(a, 0usize, b);
  }

  // By byte: the order of the code points they spell
  pub fn lt overload `<`(self &, o &str) bool inline { self.compare(o) < 0i32; }
  pub fn le overload `<=`(self &, o &str) bool inline { self.compare(o) <= 0i32; }
  pub fn gt overload `>`(self &, o &str) bool inline { self.compare(o) > 0i32; }
  pub fn ge overload `>=`(self &, o &str) bool inline { self.compare(o) >= 0i32; }

  // What identifies the text to a Hasher: its bytes, then the terminator that
  // marks where they end (Hasher.writeStr). Every kind of text feeds the same,
  // so a literal, a String and a So[str] of the same bytes hash alike, and a
  // collection looks a key up by whichever it holds
  pub fn hash(self &, h &mut Hasher) inline {
    imm b &Array[u8] = self;
    h.writeStr(b);
  }
}

// 'Array[T]', the body of T values whose count is known only at run time, held
// only through a reference that carries the count: its borrow is the slice,
// '&Array[T]', and 'So[Array[T]]',
// 'Rc[Array[T]]', 'Arc[Array[T]]' and 'Gc[Array[T]]' are each a pointer and a
// count. With sizes, 'Array[T, n]', it is the value array of n elements in
// place, which the compiler makes (arrayTypeLower); this is the same name
// without a size. The compiler gives the struct its generic parameter and its
// size, and this its methods, written once, which a 'List' and any owner of
// the body reach.
pub struct @opaque Array[T] {
  // The number of elements. Not 'inline', so that a type folding it in can fill
  // a trait's slot with it (a slot points at a function that exists)
  pub fn len(self &) usize { self.len; }

  // The elements before index 'at' and those from it on, as two slices of the same
  // elements (a panic if 'at' is past the end). With 'len', this is what makes a
  // list, which folds both in, a ParallelIterable
  pub fn split(self &, at usize) (&Array[T], &Array[T]) {
    if at > self.len {
      panic("Array.split: the index is past the end");
    }
    imm p = self as *T;
    (mem.sliceFromParts[T](p, at), mem.sliceFromParts[T](p + at, self.len - at));
  }

  // A cursor over the elements, front to back: 'next' gives a borrow of each
  pub fn iter(self &) ArrayIter[T] { new ArrayIter[T](self, 0usize); }

  // The elements with their positions: 'next' gives a tuple of the position and
  // a borrow of the element, and 'each i, x in a.indexed()' unpacks it
  pub fn indexed(self &) ArrayIndexed[T] { new ArrayIndexed[T](self, 0usize); }

  // The elements for changing in place: a cursor whose 'next' gives a '&mut' of each
  // element, so 'each x in a.mutItems()' gives 'x' as a '&mut'. Its 'indexed()' gives
  // the position with the '&mut' item; a bare 'a.indexed()' lends '&' on any slice
  pub fn mutItems(self &mut) ArrayMutItems[T] { new ArrayMutItems[T](self, 0usize); }

  // The elements in runs of 'n', for reading: each item is a slice of 'n' elements,
  // the last of what is left if 'n' does not divide the count. A panic if 'n' is 0.
  // 'each c in a.chunks(4)' walks them; 'parallel each' cuts them between chunks
  pub fn chunks(self &, n usize, file &Array[u8] = srcFile(), line u32 = srcLine()) ArrayChunks[T] {
    if n == 0usize {
      panic("chunks: the chunk size is 0", file, line);
    }
    new ArrayChunks[T](self, n, 0usize);
  }

  // The elements in runs of 'n', for changing in place: each item is a '&mut' slice
  // of 'n' elements (the last may be shorter), which no other chunk reaches, so a
  // 'parallel each' may give each pass one. A panic if 'n' is 0
  pub fn mutChunks(self &mut, n usize, file &Array[u8] = srcFile(), line u32 = srcLine()) ArrayMutChunks[T] {
    if n == 0usize {
      panic("mutChunks: the chunk size is 0", file, line);
    }
    new ArrayMutChunks[T](self, n, 0usize);
  }

  // The elements as rows of 'N': 'a.asArrays[3]()' is the same memory seen as a slice of
  // 'Array[T, 3]', so 'rows[i][k]' is element 'i * 3 + k' and nothing is copied. 'N' is
  // written in brackets (nothing in the arguments says it). A panic if the count is not a
  // multiple of 'N' (reported at the caller's line); 'N' of 0 is a panic too
  pub fn asArrays[N usize](self &, file &Array[u8] = srcFile(), line u32 = srcLine()) &Array[Array[T, N]] {
    if N == 0usize {
      panic("asArrays: the row length is 0", file, line);
    }
    if self.len % N != 0usize {
      panic("asArrays: the count is not a multiple of the row length", file, line);
    }
    imm p = self as *T;
    imm q = p as *Array[T, N];
    mem.sliceFromParts[Array[T, N]](q, self.len / N);
  }

  // 'asArrays' for changing in place, a '&mut' slice (a method cannot be told apart by its
  // receiver's permission, so it has a name of its own, as 'mutChunks' has beside 'chunks'):
  // writing through 'rows[i][k]' changes element 'i * N + k' of the original
  pub fn mutArrays[N usize](self &mut, file &Array[u8] = srcFile(), line u32 = srcLine()) &mut Array[Array[T, N]] {
    if N == 0usize {
      panic("mutArrays: the row length is 0", file, line);
    }
    if self.len % N != 0usize {
      panic("mutArrays: the count is not a multiple of the row length", file, line);
    }
    imm p = self as *T;
    imm q = p as *Array[T, N];
    mem.sliceFromPartsMut[Array[T, N]](q, self.len / N);
  }
}

// A cursor over a slice's elements in runs of 'size', which 'chunks' gives: 'next'
// gives each run as a slice until it answers None. 'pos' is the element the next
// run starts at. With 'len' and 'split' (which cuts between runs, 'at' counted in
// runs) it is a ParallelIterable, and 'parallel each' walks it with 'at'.
pub struct ArrayChunks['a, T] is Iterator[&Array[T]] {
  pub items &'a Array[T];
  pub size usize;
  pub pos usize;

  // How many runs it has yet to give
  pub fn len(self &) usize {
    imm left = items.len - pos;
    left / size + if left % size == 0usize { 0usize; } else { 1usize; };
  }

  // Run number 'k' of those it has yet to give (a panic past the last)
  pub fn at(self &, k usize) &'a Array[T] {
    if k >= self.len() {
      panic("ArrayChunks.at: the chunk is past the end");
    }
    imm from = pos + k * size;
    imm left = items.len - from;
    imm count = if left < size { left; } else { size; };
    mem.sliceFromParts[T]((items as *T) + from, count);
  }

  pub fn next(self &mut) Option[&'a Array[T]] {
    if pos >= items.len { return None[&Array[T]][]; }
    imm left = items.len - pos;
    imm count = if left < size { left; } else { size; };
    imm c = mem.sliceFromParts[T]((items as *T) + pos, count);
    pos = pos + count;
    Some[&Array[T]][c];
  }

  // The runs before run number 'at' and those from it on, as two cursors over the
  // same elements (a panic if 'at' is past the end)
  pub fn split(self &, at usize) (ArrayChunks['a, T], ArrayChunks['a, T]) {
    if at > self.len() {
      panic("ArrayChunks.split: the index is past the end");
    }
    imm cut = if at == self.len() { items.len; } else { pos + at * size; };
    imm p = items as *T;
    (new ArrayChunks[T](mem.sliceFromParts[T](p, cut), size, pos),
      new ArrayChunks[T](mem.sliceFromParts[T](p + cut, items.len - cut), size, 0usize));
  }

  // The runs with their numbers, counted from 0 as the runs it gives are
  pub fn indexed(self) ChunksIndexed['a, T] { new ChunksIndexed[T](self, 0usize); }

  // Walked side by side with another cursor, as 'zip' does two collections: the
  // pairs of a run and what the other gives, ending with the shorter. When the other
  // is one that can be cut and walked by position too, so is the zip (a Zip)
  pub fn zip[B, J Iterator[B]](self, other J) Zip[&'a Array[T], B, ArrayChunks['a, T], J] {
    new Zip[&Array[T], B, ArrayChunks[T], J](self, other);
  }
}

// A cursor over runs and their numbers, which 'indexed' gives: 'next' gives a tuple
// of the run's number and the run
pub struct ChunksIndexed['a, T] is Iterator[(usize, &Array[T])] {
  pub chunks ArrayChunks['a, T];
  pub index usize;

  pub fn next(self &mut) Option[(usize, &'a Array[T])] {
    match chunks.next() {
      case imm c Some {
        imm i = index;
        index = i + 1usize;
        return Some[(usize, &Array[T])][(i, c)];
      }
      case is None { return None[(usize, &Array[T])][]; }
    }
  }

  // How many runs are left, and run number k of them with its number
  pub fn len(self &) usize { chunks.len(); }

  pub fn at(self &, k usize) (usize, &'a Array[T]) { (index + k, chunks.at(k)); }
}

// The same for changing: 'mutChunks' gives it, and each run is a '&mut' slice
pub struct ArrayMutChunks['a, T] is Iterator[&mut Array[T]] {
  pub items &'a mut Array[T];
  pub size usize;
  pub pos usize;

  pub fn len(self &) usize {
    imm left = items.len - pos;
    left / size + if left % size == 0usize { 0usize; } else { 1usize; };
  }

  pub fn at(self &, k usize) &'a mut Array[T] {
    if k >= self.len() {
      panic("ArrayMutChunks.at: the chunk is past the end");
    }
    imm from = pos + k * size;
    imm left = items.len - from;
    imm count = if left < size { left; } else { size; };
    mem.sliceFromPartsMut[T]((items as *T) + from, count);
  }

  pub fn next(self &mut) Option[&'a mut Array[T]] {
    if pos >= items.len { return None[&mut Array[T]][]; }
    imm left = items.len - pos;
    imm count = if left < size { left; } else { size; };
    imm c = mem.sliceFromPartsMut[T]((items as *T) + pos, count);
    pos = pos + count;
    Some[&mut Array[T]][c];
  }

  pub fn split(self &, at usize) (ArrayMutChunks['a, T], ArrayMutChunks['a, T]) {
    if at > self.len() {
      panic("ArrayMutChunks.split: the index is past the end");
    }
    imm cut = if at == self.len() { items.len; } else { pos + at * size; };
    imm p = items as *T;
    (new ArrayMutChunks[T](mem.sliceFromPartsMut[T](p, cut), size, pos),
      new ArrayMutChunks[T](mem.sliceFromPartsMut[T](p + cut, items.len - cut), size, 0usize));
  }

  pub fn indexed(self) MutChunksIndexed['a, T] { new MutChunksIndexed[T](self, 0usize); }

  pub fn zip[B, J Iterator[B]](self, other J) Zip[&'a mut Array[T], B, ArrayMutChunks['a, T], J] {
    new Zip[&mut Array[T], B, ArrayMutChunks[T], J](self, other);
  }
}

pub struct MutChunksIndexed['a, T] is Iterator[(usize, &mut Array[T])] {
  pub chunks ArrayMutChunks['a, T];
  pub index usize;

  pub fn next(self &mut) Option[(usize, &'a mut Array[T])] {
    match chunks.next() {
      case imm c Some {
        imm i = index;
        index = i + 1usize;
        return Some[(usize, &mut Array[T])][(i, c)];
      }
      case is None { return None[(usize, &mut Array[T])][]; }
    }
  }

  pub fn len(self &) usize { chunks.len(); }

  pub fn at(self &, k usize) (usize, &'a mut Array[T]) { (index + k, chunks.at(k)); }
}

// A cursor over a slice's elements, which 'iter' gives: 'next' gives a borrow of
// each in turn until it answers None. The elements may not change while it is used.
// ('each' reads its two fields to walk the slice as a counted loop.)
pub struct ArrayIter['a, T] is Iterator[&T] {
  pub items &'a Array[T];
  pub pos usize;

  pub fn next(self &mut) Option[&'a T] {
    if pos >= items.len { return None[&T][]; }
    imm i = pos;
    pos = i + 1usize;
    Some[&T][&items[i]];
  }

  // How many elements are left, the one at k of them, and the cursors over the
  // elements before the place 'at' of them and those from it on (a ParallelIterable
  // and RandomAccess, which a zip of cursors needs to be walked by 'parallel each')
  pub fn len(self &) usize { items.len - pos; }

  pub fn at(self &, k usize) &'a T { &items[pos + k]; }

  pub fn split(self &, at usize) (ArrayIter['a, T], ArrayIter['a, T]) {
    if at > self.len() {
      panic("ArrayIter.split: the index is past the end");
    }
    imm p = items as *T;
    imm cut = pos + at;
    (new ArrayIter[T](mem.sliceFromParts[T](p, cut), pos),
      new ArrayIter[T](mem.sliceFromParts[T](p + cut, items.len - cut), 0usize));
  }
}

// A cursor over a slice's elements and their positions, which 'indexed' gives:
// 'next' gives the position and a borrow of the element, as a tuple
// ('each' reads its two fields to walk the slice as a counted loop.)
pub struct ArrayIndexed['a, T] is Iterator[(usize, &T)] {
  pub items &'a Array[T];
  pub pos usize;

  pub fn next(self &mut) Option[(usize, &'a T)] {
    if pos >= items.len { return None[(usize, &T)][]; }
    imm i = pos;
    pos = i + 1usize;
    Some[(usize, &T)][(i, &items[i])];
  }

  // How many elements are left, and element number k of them with its position
  // (what 'parallel each' walks by)
  pub fn len(self &) usize { items.len - pos; }

  pub fn at(self &, k usize) (usize, &'a T) {
    imm i = pos + k;
    (i, &items[i]);
  }
}

// A cursor over a slice's elements for changing them, which 'mutItems' gives: 'next'
// gives a '&mut' of each in turn. ('each' reads its two fields to walk the slice as
// a counted loop; 'parallel each' walks it by 'len' and 'at'.)
pub struct ArrayMutItems['a, T] is Iterator[&mut T] {
  pub items &'a mut Array[T];
  pub pos usize;

  pub fn next(self &mut) Option[&'a mut T] {
    if pos >= items.len { return None[&mut T][]; }
    imm i = pos;
    pos = i + 1usize;
    Some[&mut T][&mut items[i]];
  }

  pub fn len(self &) usize { items.len - pos; }

  pub fn at(self &, k usize) &'a mut T { &mut items[pos + k]; }

  // The same with the positions: the item is a '&mut' too
  pub fn indexed(self) MutItemsIndexed['a, T] { new MutItemsIndexed[T](items, pos); }

  pub fn zip[B, J Iterator[B]](self, other J) Zip[&'a mut T, B, ArrayMutItems['a, T], J] {
    new Zip[&mut T, B, ArrayMutItems[T], J](self, other);
  }
}

// A cursor over a slice's elements and their positions for changing the elements,
// which a mutable cursor's 'indexed' gives: 'next' gives the position and a '&mut'
// of the element, as a tuple
pub struct MutItemsIndexed['a, T] is Iterator[(usize, &mut T)] {
  pub items &'a mut Array[T];
  pub pos usize;

  pub fn next(self &mut) Option[(usize, &'a mut T)] {
    if pos >= items.len { return None[(usize, &mut T)][]; }
    imm i = pos;
    pos = i + 1usize;
    Some[(usize, &mut T)][(i, &mut items[i])];
  }

  pub fn len(self &) usize { items.len - pos; }

  pub fn at(self &, k usize) (usize, &'a mut T) {
    imm i = pos + k;
    (i, &mut items[i]);
  }
}

// Two sources walked side by side, which 'zip' gives: 'next' gives a tuple of
// what each cursor gives, and answers None as soon as either runs out. When the
// second runs out after the first has given a value, that value is dropped.
pub struct Zip[A, B, I Iterator[A], J Iterator[B]] is Iterator[(A, B)] {
  first I;
  second J;

  pub fn next(self &mut) Option[(A, B)] {
    match first.next() {
      case imm x Some {
        imm a = x;
        match second.next() {
          case imm y Some { return Some[(A, B)][(a, y)]; }
          case is None { return None[(A, B)][]; }
        }
      }
      case is None { return None[(A, B)][]; }
    }
  }

  // The pairs with their numbers, counted from 0: a tuple of the number and
  // what each source gives
  pub fn indexed(self) ZipIndexed[A, B, I, J] { new ZipIndexed[A, B, I, J](self, 0usize); }

  // A third source walked beside the two: a Zip3, whose items are flat triples (not a
  // pair and a third), so that three variables unpack them. It ends with the shortest
  pub fn zip[C, K Iterator[C]](self, other K) Zip3[A, B, C, I, J, K] {
    new Zip3[A, B, C, I, J, K](self.first, self.second, other);
  }

  // When BOTH sources can be walked by position (RandomAccess) and cut
  // (ParallelIterable), so can the zip, as Rayon's: its length is the shorter's, it
  // is cut at the same place in both, and the pair at k is what each gives at k. A
  // source that cannot (a generator, a Deque's cursor) leaves these out
  pub fn len(self &) usize where I is RandomAccess[A] and J is RandomAccess[B] {
    imm a = first.len();
    imm b = second.len();
    if a < b { a; } else { b; };
  }

  pub fn at(self &, k usize) (A, B) where I is RandomAccess[A] and J is RandomAccess[B] {
    (first.at(k), second.at(k));
  }

  pub fn split(self &, at usize) (Zip[A, B, I, J], Zip[A, B, I, J])
      where I is ParallelIterable[A, I] and J is ParallelIterable[B, J] {
    imm f = first.split(at);
    imm s = second.split(at);
    (new Zip[A, B, I, J](f.0, s.0), new Zip[A, B, I, J](f.1, s.1));
  }
}

// A zip with the pairs numbered, which a zip's 'indexed' gives: 'next' gives a
// tuple of the number and what each source gives
pub struct ZipIndexed[A, B, I Iterator[A], J Iterator[B]] is Iterator[(usize, A, B)] {
  pub zip Zip[A, B, I, J];
  pub index usize;

  pub fn next(self &mut) Option[(usize, A, B)] {
    match zip.next() {
      case imm p Some {
        imm i = index;
        index = i + 1usize;
        imm pair = p;
        return Some[(usize, A, B)][(i, pair.0, pair.1)];
      }
      case is None { return None[(usize, A, B)][]; }
    }
  }

  pub fn len(self &) usize where I is RandomAccess[A] and J is RandomAccess[B] { zip.len(); }

  pub fn at(self &, k usize) (usize, A, B) where I is RandomAccess[A] and J is RandomAccess[B] {
    imm pair = zip.at(k);
    (index + k, pair.0, pair.1);
  }
}

// Three sources walked side by side, which a zip's own 'zip' gives: 'next' gives a
// flat tuple of what each gives, and answers None as soon as any runs out. As a Zip
// is, it is RandomAccess and ParallelIterable when ALL THREE sources are: its length
// is the shortest's and it is cut at the same place in all three.
pub struct Zip3[A, B, C, I Iterator[A], J Iterator[B], K Iterator[C]] is Iterator[(A, B, C)] {
  first I;
  second J;
  third K;

  pub fn next(self &mut) Option[(A, B, C)] {
    match first.next() {
      case imm x Some {
        imm a = x;
        match second.next() {
          case imm y Some {
            imm b = y;
            match third.next() {
              case imm z Some { return Some[(A, B, C)][(a, b, z)]; }
              case is None { return None[(A, B, C)][]; }
            }
          }
          case is None { return None[(A, B, C)][]; }
        }
      }
      case is None { return None[(A, B, C)][]; }
    }
  }

  // The triples with their numbers, counted from 0: a flat tuple of the number and
  // what each source gives
  pub fn indexed(self) Zip3Indexed[A, B, C, I, J, K] { new Zip3Indexed[A, B, C, I, J, K](self, 0usize); }

  pub fn len(self &) usize
      where I is RandomAccess[A] and J is RandomAccess[B] and K is RandomAccess[C] {
    imm a = first.len();
    imm b = second.len();
    imm c = third.len();
    imm ab = if a < b { a; } else { b; };
    if ab < c { ab; } else { c; };
  }

  pub fn at(self &, k usize) (A, B, C)
      where I is RandomAccess[A] and J is RandomAccess[B] and K is RandomAccess[C] {
    (first.at(k), second.at(k), third.at(k));
  }

  pub fn split(self &, at usize) (Zip3[A, B, C, I, J, K], Zip3[A, B, C, I, J, K])
      where I is ParallelIterable[A, I] and J is ParallelIterable[B, J] and K is ParallelIterable[C, K] {
    imm f = first.split(at);
    imm s = second.split(at);
    imm t = third.split(at);
    (new Zip3[A, B, C, I, J, K](f.0, s.0, t.0), new Zip3[A, B, C, I, J, K](f.1, s.1, t.1));
  }
}

// A three-way zip with the triples numbered, which its 'indexed' gives: 'next' gives
// a flat tuple of the number and what each of the three gives
pub struct Zip3Indexed[A, B, C, I Iterator[A], J Iterator[B], K Iterator[C]] is Iterator[(usize, A, B, C)] {
  pub zip Zip3[A, B, C, I, J, K];
  pub index usize;

  pub fn next(self &mut) Option[(usize, A, B, C)] {
    match zip.next() {
      case imm p Some {
        imm i = index;
        index = i + 1usize;
        imm triple = p;
        return Some[(usize, A, B, C)][(i, triple.0, triple.1, triple.2)];
      }
      case is None { return None[(usize, A, B, C)][]; }
    }
  }

  pub fn len(self &) usize
      where I is RandomAccess[A] and J is RandomAccess[B] and K is RandomAccess[C] { zip.len(); }

  pub fn at(self &, k usize) (usize, A, B, C)
      where I is RandomAccess[A] and J is RandomAccess[B] and K is RandomAccess[C] {
    imm triple = zip.at(k);
    (index + k, triple.0, triple.1, triple.2);
  }
}

// Walk two sources side by side: 'each x, y in zip(xs, ys)' gives each pair of
// what their 'iter' cursors give, and ends with the shorter of the two
pub fn zip[A, I, C Iterable[A, I], B, J, D Iterable[B, J]](xs &C, ys &D) Zip[A, B, I, J]
    where I is Iterator[A] and J is Iterator[B] {
  new Zip[A, B, I, J](xs.iter(), ys.iter());
}

// 'cstr', a borrowed C string: one pointer to bytes that end in a NUL, which is
// what C's 'const char *' is, so a C binding declares its strings with it
// ('extern fn puts(s cstr) i32'). Its length is found by scanning for the NUL.
// The compiler makes the type (corelib.c), so the C-named modules can name it;
// this is its field and its methods.
//
// What reaches C as one: a literal, which converts where a 'cstr' is wanted
// ('fromLiteral'); a String's 'cstr()' (collections); an owner of text,
// 'cstr.fromOwned'. A general '&str' promises no NUL after its bytes (it may be
// a part of a longer text), so it is copied into a String first:
// 'String.from(s).cstr()'.
pub struct cstr {
  p *u8;

  // The C string a pointer already is. The caller promises it points at bytes
  // that end in a NUL and stay as they are while the cstr is used: this is the
  // way from C's raw pointers (an 'argv' entry, what 'getenv' answers when it
  // is not null) to a cstr.
  pub fn fromPtr(ptr *u8) cstr inline { new cstr(ptr); }

  // What a literal becomes where a cstr is wanted. A literal's bytes are
  // followed by a NUL, in the program for as long as it runs.
  pub fn fromLiteral(text &str) cstr inline {
    imm b &Array[u8] = text;
    new cstr(b as *u8);
  }

  // The C string of an owner of text, which keeps a NUL after its bytes. A NUL
  // inside the text would end the string early for C, so it is a panic.
  pub fn fromOwned(owner &So[str], file &Array[u8] = srcFile(), line u32 = srcLine()) cstr inline {
    imm b &Array[u8] = &**owner;
    if libc.memchr(b as *u8, 0i32, b.len) != null {
      panic("cstr: text holding a NUL byte cannot be a C string", file, line);
    }
    new cstr(b as *u8);
  }

  // The pointer, for a C function that takes a buffer and not a string
  pub fn ptr(self) *u8 inline { p; }

  // How many bytes come before the NUL
  pub fn len(self) usize inline { libc.strlen(self); }

  // Its text, found by scanning for the NUL and not checked to be UTF-8 (text
  // is UTF-8 by convention). Copy it into a String to keep it. A cstr is a
  // pointer, held by value; the text is the bytes it points at, so the view
  // does not borrow the cstr itself.
  pub fn view(self) &str inline { mem.sliceFromParts(p, libc.strlen(self)) as &str; }
}

// A panic unless start up to end is a range of the text between characters.
// Apart from 'slice' so that nothing there branches ahead of the borrow it
// returns (a GPU target refuses a reference chosen at run time)
fn strCheckRange(s &str, start usize, end usize, file &Array[u8], line u32) inline {
  if start > end or not (s.isCharBoundary(start) and s.isCharBoundary(end)) {
    panic("str: a range out of order, past the end, or beginning or ending inside a character", file, line);
  }
}

// Whether the bytes of 'b' are those of 'a' from index 'at', the caller having
// made sure they fit. A loop of its own and not a slice comparison, which would
// instantiate a generic in every compile that loads core.
fn strBytesAt(a &Array[u8], at usize, b &Array[u8]) bool inline {
  mut i = 0usize;
  mut same = true;
  while same and i < b.len {
    same = a[at + i] == b[i];
    i = i + 1usize;
  }
  same;
}

// ASCII whitespace as Rust's is_ascii_whitespace has it
fn strIsSpace(b u8) bool inline {
  b == ' ' or b == '\t' or b == '\n' or b == '\r' or b == 0x0Cu8;
}

// A UTF-8 continuation byte: 10xxxxxx
fn strIsCont(b u8) bool inline {
  (b & 0xC0u8) == 0x80u8;
}

// Whether b is between lo and hi, both included
fn strInRange(b u8, lo u8, hi u8) bool inline {
  b >= lo and b <= hi;
}

// How many bytes the character starting at byte index i takes: its well-formed
// UTF-8 sequence's length (1 to 4), or 1 for a byte that begins none. That is
// Go's decoding: each byte of an ill-formed run is one replacement character,
// and so is an overlong form (C0, C1, E0 80..9F, F0 80..8F), a surrogate (ED
// A0..BF) and anything past U+10FFFF (F4 90.., F5..FF). i is inside the text.
fn strCharWidth(b &Array[u8], i usize) usize inline {
  imm b0 = b[i];
  imm left = b.len - i;
  mut width = 1usize;
  if b0 >= 0xC2u8 and b0 <= 0xDFu8 {
    if left >= 2usize and strIsCont(b[i + 1usize]) { width = 2usize; }
  }
  elif b0 >= 0xE0u8 and b0 <= 0xEFu8 {
    if left >= 3usize and strIsCont(b[i + 2usize]) {
      imm b1 = b[i + 1usize];
      mut second = strIsCont(b1);
      if b0 == 0xE0u8 { second = strInRange(b1, 0xA0u8, 0xBFu8); }
      elif b0 == 0xEDu8 { second = strInRange(b1, 0x80u8, 0x9Fu8); }
      if second { width = 3usize; }
    }
  }
  elif b0 >= 0xF0u8 and b0 <= 0xF4u8 {
    if left >= 4usize and strIsCont(b[i + 2usize]) and strIsCont(b[i + 3usize]) {
      imm b1 = b[i + 1usize];
      mut second = strIsCont(b1);
      if b0 == 0xF0u8 { second = strInRange(b1, 0x90u8, 0xBFu8); }
      elif b0 == 0xF4u8 { second = strInRange(b1, 0x80u8, 0x8Fu8); }
      if second { width = 4usize; }
    }
  }
  width;
}

// The code point of the character at byte index i that takes 'width' bytes
// (strCharWidth): U+FFFD for a byte that begins no well-formed sequence, so a
// char made here is always a valid one
fn strCharValue(b &Array[u8], i usize, width usize) char inline {
  imm b0 = u32.from(b[i]);
  mut code = 0xFFFDu32;
  if width == 1usize {
    if b0 < 0x80u32 { code = b0; }
  }
  elif width == 2usize {
    code = ((b0 & 0x1Fu32) << 6u32) | (u32.from(b[i + 1usize]) & 0x3Fu32);
  }
  elif width == 3usize {
    code = ((b0 & 0x0Fu32) << 12u32) | ((u32.from(b[i + 1usize]) & 0x3Fu32) << 6u32)
      | (u32.from(b[i + 2usize]) & 0x3Fu32);
  }
  else {
    code = ((b0 & 0x07u32) << 18u32) | ((u32.from(b[i + 1usize]) & 0x3Fu32) << 12u32)
      | ((u32.from(b[i + 2usize]) & 0x3Fu32) << 6u32) | (u32.from(b[i + 3usize]) & 0x3Fu32);
  }
  char.from(code);
}

// A cursor over a text's code points: 'next' gives each in turn, as a char, and
// None past the last. A byte that is not part of well-formed UTF-8 reads as
// U+FFFD, so every char it gives is valid. It borrows the text, which may not
// change while the cursor is used.
pub struct StrChars['a] is Iterator[char] {
  text &'a str;
  pos usize;

  pub fn next(self &mut) Option[char] inline {
    imm b &Array[u8] = text;
    if pos >= b.len { return None[char][]; }
    imm width = strCharWidth(b, pos);
    imm c = strCharValue(b, pos, width);
    pos = pos + width;
    Some[char][c];
  }
}

// A code point with the byte index it starts at
pub struct StrCharIndex {
  pub offset usize;
  pub ch char;
}

// A cursor over a text's code points, each with the byte index it starts at: the
// positions a lexer reports, and a slice may begin or end at. Otherwise as
// StrChars is.
pub struct StrCharIndices['a] is Iterator[StrCharIndex] {
  text &'a str;
  pos usize;

  pub fn next(self &mut) Option[StrCharIndex] inline {
    imm b &Array[u8] = text;
    if pos >= b.len { return None[StrCharIndex][]; }
    imm width = strCharWidth(b, pos);
    imm at = new StrCharIndex(pos, strCharValue(b, pos, width));
    pos = pos + width;
    Some[StrCharIndex][at];
  }
}

// ITERATION: the two shapes an iteration walks, named for the code that is
// generic over them. A type is an 'Iterator[T]' by having 'next', and an
// 'Iterable[T, I]' by having 'iter'; none declares either, as no type declares
// that it is Stack (collections), so 'StrChars' and every cursor of the
// collections are iterators already, and a user's own struct with the method is.
// A function asks for one as a static bound, decided where it is called and
// compiled for the type's own methods:
//
//   fn count[T, S Iterator[T]](it &mut S) usize { ... it.next() ... }
//
// 'T' is what 'next' gives, so a cursor that lends its values is an 'Iterator[&V]'
// and 'count' above takes it with T = '&V'. The '&V' of a bound is written with no
// lifetime, and is met by a cursor whose 'next' returns the lifetime its own
// struct declares ('Option[&'a V]', as DequeItems has). The same bound as a
// virtual reference, '&<mut Iterator[&V]', takes it through one compiled
// function; a call through the trait reads the trait's signature, which ties a
// result to the whole cursor.
//
// 'iter' gives the cursor a collection walks itself with. The trait names the
// cursor's type as a second argument, 'I', because a trait cannot yet name a type
// its implementer chooses (there are no associated types): 'fn count[T, I,
// C Iterable[T, I]](c &C) where I is Iterator[T]'. Both are inferred from the
// argument.
pub trait Iterator[T] {
  // The next value, and None once there are no more
  pub fn next(self &mut) Option[T];

  // THE ADAPTERS: the steps that work on a whole sequence, shared by every cursor
  // that declares 'is Iterator[T]' (the collections' cursors, 'zip', a generator, and
  // a struct of one's own that says so): 'xs.iter().map(x => *x * k).filter(y => *y > 9).sum()'.
  // A step returns a cursor again and does no work until a terminal method walks the
  // chain once and consumes it. Each step is a generic instance holding the cursor it
  // wraps and a closure of its own type ('F fn(x T) U'), so a chain compiles to one
  // loop with the closures' bodies inline and no call through a pointer for any item.
  // A type that has 'next' but does not declare 'is Iterator[T]' still meets an
  // Iterator bound, as it always did, and gets none of these.
  //
  // An item is whatever the cursor gives, so a cursor that lends ('xs.iter()', whose
  // items are '&V') gives closures borrows: 'map(x => *x * 2)', 'filter(y => *y > 3)'
  // (a filter's closure is given a borrow of the item, as a find's is: a borrow of a
  // borrow here, which an operator reads through). A step that needs a number, 'sum',
  // 'min' and 'max', is there where the items are numbers, so a lending cursor is
  // mapped to values first: 'map(x => *x).sum()'. So is 'find' on one, which hands an
  // item back: each step's 'next' has a signature that names no lifetime, so a borrow
  // it answers is held to lend from the step, and cannot leave the function that
  // walks the chain.

  // The items through 'f': the closure is typed from the item and its result is the
  // new item's type, 'xs.iter().map(x => *x * k)'
  pub fn map[U, F fn(x T) U](self, f F) IterMap[T, U, Self, F] inline {
    new IterMap[T, U, Self, F](self, f);
  }

  // The items 'f' answers true for. 'f' is given a borrow of the item
  pub fn filter[F fn(x &T) bool](self, f F) IterFilter[T, Self, F] inline {
    new IterFilter[T, Self, F](self, f);
  }

  // At most the first n items. n is any integer, a literal included. The method is
  // generic in n's type so that a cursor declaring the trait does not need, to be
  // made, the cursor of a cursor of a cursor without end: a generic method is made
  // when called
  pub fn take[N Integer](self, n N) IterTake[T, Self] inline {
    new IterTake[T, Self](self, usize.from(n));
  }

  // The items after the first n (none when there are not more than n)
  pub fn skip[N Integer](self, n N) IterSkip[T, Self] inline {
    new IterSkip[T, Self](self, usize.from(n));
  }

  // The terminal methods walk the chain once, from where the cursor is, and leave it
  // advanced (a cursor held in a variable carries on from there, as 'each' leaves it)

  // 'init', then 'f' given the result so far and each item in turn
  pub fn fold[A, F fn(acc A, x T) A](self &mut, init A, f F) A inline {
    mut g = f;
    mut acc = init;
    while true {
      match self.next() {
        case imm e Some { acc = g(acc, e); }
        case is None { break; }
      }
    }
    acc;
  }

  // Whether 'f' is true of some item (false for none), stopping at the first
  pub fn any[F fn(x T) bool](self &mut, f F) bool inline {
    mut g = f;
    while true {
      match self.next() {
        case imm e Some { if g(e) { return true; } }
        case is None { break; }
      }
    }
    false;
  }

  // Whether 'f' is true of every item (true for none), stopping at the first it is false of
  pub fn all[F fn(x T) bool](self &mut, f F) bool inline {
    mut g = f;
    while true {
      match self.next() {
        case imm e Some { if !g(e) { return false; } }
        case is None { break; }
      }
    }
    true;
  }

  // How many items there are
  pub fn count(self &mut) usize inline {
    mut n = 0usize;
    while true {
      match self.next() {
        case imm e Some { n = n + 1usize; }
        case is None { break; }
      }
    }
    n;
  }

  // The first item 'f' answers true for, or None. 'f' is given a borrow of the item
  pub fn find[F fn(x &T) bool](self &mut, f F) Option[T] inline {
    mut g = f;
    while true {
      match self.next() {
        case imm e Some {
          imm v = e;
          if g(&v) { return Some[T][v]; }
        }
        case is None { break; }
      }
    }
    None[T][];
  }

  // The total of number items (0 for none)
  pub fn sum(self &mut) T inline where T is Integer or T is f32 or T is f64 {
    mut s = T.from(0i32);
    while true {
      match self.next() {
        case imm e Some { s = s + e; }
        case is None { break; }
      }
    }
    s;
  }

  // The smallest number item (the first of equals), or None for no items
  pub fn min(self &mut) Option[T] inline where T is Integer or T is f32 or T is f64 {
    match self.next() {
      case is None { return None[T][]; }
      case imm first Some {
        mut best = first;
        while true {
          match self.next() {
            case imm e Some {
              imm v = e;
              if v < best { best = v; }
            }
            case is None { break; }
          }
        }
        return Some[T][best];
      }
    }
  }

  // The largest number item (the first of equals), or None for no items
  pub fn max(self &mut) Option[T] inline where T is Integer or T is f32 or T is f64 {
    match self.next() {
      case is None { return None[T][]; }
      case imm first Some {
        mut best = first;
        while true {
          match self.next() {
            case imm e Some {
              imm v = e;
              if v > best { best = v; }
            }
            case is None { break; }
          }
        }
        return Some[T][best];
      }
    }
  }
}

// The steps the adapters make: each holds the cursor it wraps and gives the Option
// of what comes out, and is itself an Iterator, so a chain goes on. Not named in a
// program.
pub struct IterMap[T, U, I Iterator[T], F fn(x T) U] is Iterator[U] {
  pub src I;
  pub f F;

  pub fn next(self &mut) Option[U] inline {
    match src.next() {
      case imm e Some { return Some[U][f(e)]; }
      case is None { return None[U][]; }
    }
  }
}

pub struct IterFilter[T, I Iterator[T], F fn(x &T) bool] is Iterator[T] {
  pub src I;
  pub f F;

  pub fn next(self &mut) Option[T] inline {
    while true {
      match src.next() {
        case imm e Some {
          imm v = e;
          if f(&v) { return Some[T][v]; }
        }
        case is None { return None[T][]; }
      }
    }
    None[T][];
  }
}

// The first 'left' items, then None
pub struct IterTake[T, I Iterator[T]] is Iterator[T] {
  pub src I;
  pub left usize;

  pub fn next(self &mut) Option[T] inline {
    if left == 0usize { return None[T][]; }
    left = left - 1usize;
    src.next();
  }
}

// All but the first 'toSkip' items: the skipped are taken (and dropped) on the first call
pub struct IterSkip[T, I Iterator[T]] is Iterator[T] {
  pub src I;
  pub toSkip usize;

  pub fn next(self &mut) Option[T] inline {
    while toSkip > 0usize {
      toSkip = toSkip - 1usize;
      match src.next() {
        case imm e Some { }
        case is None { toSkip = 0usize; return None[T][]; }
      }
    }
    src.next();
  }
}

// Something that gives a cursor over what it holds, without being consumed
pub trait Iterable[T, I] where I is Iterator[T] {
  pub fn iter(self &) I;
}

// PARALLEL ITERATION: what a 'parallel each' walks. A type is a
// 'ParallelIterable[T, P]' by having 'len', how many items it holds, and 'split',
// which cuts it at an index into two pieces of type P, the items before it and
// those from it on, each a ParallelIterable of its own that can be walked at
// the same time as the other. None declares it: a list is one by the 'len' and
// 'split' it folds in from Array (whose pieces are slices), and a type of one's
// own is by having the two. P is a parameter for the reason Iterable's I is: a
// trait cannot name a type its implementer chooses.
//
// A source with neither, a cursor, a generator, a file or a channel, hands its
// items out one after another and cannot be cut, so 'parallel each' refuses it.
// Today 'parallel each' walks number ranges, arrays, slices and lists, which the
// compiler cuts into index ranges itself (an array or a slice has no methods to
// cut with), and the runs 'chunks' and 'mutChunks' give, which it cuts between runs
// through their 'len' and 'at'; it does not yet call 'split' of a type of one's own.
pub trait ParallelIterable[T, P] {
  // How many items it holds
  pub fn len(self &) usize;
  // The items before index 'at', and the items from it on
  pub fn split(self &, at usize) (P, P);
}

// What a zip needs of each of its sources to be walked by 'parallel each', beside
// ParallelIterable: 'len' items, and item number k of them, 'at' (a panic past the
// last). The cursors 'chunks', 'mutChunks', 'mutItems' and 'iter' give, and the
// ones their 'indexed' gives, have both, and so has a zip of two that do. Met by
// the methods alone, as the other shapes are.
pub trait RandomAccess[T] {
  pub fn len(self &) usize;
  pub fn at(self &, k usize) T;
}

// A panic ends the program where something that must not happen has: an index
// out of bounds, memory exhausted, an invariant broken. It is a bug report, not
// error handling, which is Option's and Result's. The runtime does the work
// (packages/conestd/panic.cone): stdout is flushed, one line goes to stderr,
// 'panic at <file>:<line>: <message>', the hook runs if one is set, and the
// program aborts. Nothing unwinds, and no finalizer runs. Each function here
// returns 'Never': a call to it does not return, so it may end any block,
// one that must produce a value included.
//
// Each reports where it was CALLED. Its 'file' and 'line' default to
// 'srcFile()' and 'srcLine()', which, written as a default, answer where each
// call taking the default is. A helper of a program's own that panics
// declares the same two parameters and passes them on, and so reports its
// caller too.

// Where this call is written: its source file's name, without the folders,
// and its line. Written as a parameter's default value, where each call taking
// the default is. Constants. The file's name is text: a parameter declared
// '&Array[u8]' takes it too, since any '&str' converts to a slice of bytes
pub fn @intrinsic srcFile() &str;
pub fn @intrinsic srcLine() u32;

pub extern {
  // End the program, reporting msg and where
  fn @c("cone_panic") panic(msg &str, file &Array[u8] = srcFile(), line u32 = srcLine()) Never;
  // The function a panic calls once its line is written, before the program
  // ends: to log it, say, or report it elsewhere. Setting it is atomic, from
  // any thread and at any time, and the last one set is the one called. It
  // runs on the panicking thread, and a panic inside it ends the program at once
  fn @c("cone_setPanicHook") setPanicHook(hook &fn(msg &str, file &str, line u32));
}

// Whether this compile is a debug build: 'conec --debug', or 'build: debug' in
// the build description Congo writes. A constant, so the side of an 'if' on it
// that this build does not take is never generated and never reaches the object
pub fn @intrinsic isDebugBuild() bool;

// TEMPORARY, a provisional mechanism whose final design is open. Constants of
// the compile as isDebugBuild is, so the side of an 'if' on them that this
// build does not take is never generated (both sides are still type checked).
// The OS the compile targets, from its target triple: no flag
pub fn @intrinsic isWindows() bool;
pub fn @intrinsic isLinux() bool;
pub fn @intrinsic isMacOS() bool;
pub fn @intrinsic isWasm() bool;
// Whether conec's command line defined name, '-D name' or '-D name=123', and
// the integer it was given: 1 for '-D name', 0 when it was not defined. The
// name is a string literal
pub fn @intrinsic isDefined(name &Array[u8]) bool;
pub fn @intrinsic definedInt(name &Array[u8]) i64;

// Panic unless cond holds. Checked in every build, release included
pub fn assert(cond bool, msg &str = "assertion failed", file &Array[u8] = srcFile(),
    line u32 = srcLine()) inline {
  if !cond {panic(msg, file, line);}
}

// Panic unless cond holds, in a debug build only [Jon 27 Sep]. A macro, so its
// condition is substituted where it is used rather than evaluated first: in a
// release build the whole use is folded away and the condition never runs,
// whatever it would have done. 'srcFile()' and 'srcLine()' written in a macro's
// body answer where the macro is used, so the panic names the caller's line.
// A macro takes no default, so the form with a message has a name of its own
pub macro assertDebug[cond] {
  if isDebugBuild() {assert(cond, "assertion failed", srcFile(), srcLine());} else {}
}
pub macro assertDebugMsg[cond, msg] {
  if isDebugBuild() {assert(cond, msg, srcFile(), srcLine());} else {}
}

// Code the author knows cannot be reached, reached
pub fn unreachable(msg &str ="reached code marked unreachable", file &Array[u8] = srcFile(),
    line u32 = srcLine()) Never inline {
  panic(msg, file, line);
}

// Code not written yet
pub fn todo(msg &str ="not yet implemented", file &Array[u8] = srcFile(),
    line u32 = srcLine()) Never inline {
  panic(msg, file, line);
}

// Which invocation of a compute dispatch is running, what a compute entry
// point ('fn @compute(64) bake(inv Invocation, ...)') may take as a
// parameter: its id in the whole dispatch, in its workgroup and its
// workgroup's, each three-dimensional; its flat index within the workgroup
// (x fastest); and how many workgroups the dispatch has. On the GPU the
// compiler fills it from the invocation's built-ins; on the CPU the same
// function is called in a loop that fills it. Plain data, 52 bytes.
pub struct Invocation {
  pub globalId Array[u32, 3];
  pub localId Array[u32, 3];
  pub groupId Array[u32, 3];
  pub localIndex u32;
  pub groupCount Array[u32, 3];
}

// A compute workgroup's barriers: every invocation of the workgroup waits at
// one until all have reached it, and what each wrote before it, to the
// workgroup's '@workgroup' globals (workgroupBarrier) or to the buffers the
// kernel binds (storageBarrier), every other reads after it. Every invocation
// of the workgroup must reach the same barrier, so one is never written where
// some invocations of a workgroup go and others do not. On the CPU each calls
// the hook this thread has set with 'setBarrierHook', and is nothing when it
// has set none, as when a kernel runs one invocation at a time.
pub fn @intrinsic workgroupBarrier() {}
pub fn @intrinsic storageBarrier() {}

pub extern {
  // The function a barrier calls on the CPU, on this thread: what a kernel's
  // CPU twin that runs a workgroup's invocations on threads sets each one's
  // to, a real barrier. It is handed 'ctx' and the barrier's kind, 0 for
  // workgroupBarrier and 1 for storageBarrier. Each thread has its own; one
  // that has set none, or cleared it, calls nothing at a barrier. On a GPU
  // the hook is never called
  fn @c("cone_setBarrierHook") setBarrierHook(hook &fn(ctx *u8, kind u32), ctx *u8);
  fn @c("cone_clearBarrierHook") clearBarrierHook();
}

// The two regions every module reaches. A region is a struct declaring the
// built-in trait 'RegionRef', and the compiler knows neither of these by name:
// it calls the methods each declares at each reference event, and what one
// leaves out says what it does. Each method is handed the allocation's header,
// the region's own fields, which is where 'alloc' returned. They are private,
// called by the compiler alone, and inline, like everything in core.
//
// 'So' is the single owner: it declares 'Move', so a copy of a reference is a
// move, and its one owner going away is the value's death, which ends in
// 'free'. A region ref declaring neither 'Move' nor 'aliasRef' would share its
// references freely, and its owners' going would do nothing.
pub struct So is RegionRef, Move {
  fn alloc(size usize) *u8 inline {libc.malloc(size);}
  // A bare 'free' here is this method, so C's is named through its package
  fn free(self &uni So) inline {libc.free(self as *u8);}
}

// 'Rc' counts its owners in its header. 'aliasRef' is called for each copy that
// becomes another owner, 'dealiasRef' for each owner going away, answering whether
// that was the last; only then does the value die, ending in 'free'. The count
// is a plain number, so two threads changing it at once would lose a change:
// 'Rc' does not declare 'ThreadSafe', and its owners belong to one thread.
// The sync package's 'Arc' is the one whose count is atomic.
pub struct Rc is RegionRef {
  cnt usize;
  fn alloc(size usize) *u8 inline {libc.malloc(size);}
  fn init(self &new) inline {*self = new Rc(1usize);}
  fn aliasRef(self &uni Rc) inline {cnt = cnt + 1usize;}
  fn dealiasRef(self &uni Rc) bool inline {cnt = cnt - 1usize; cnt == 0usize;}
  fn free(self &uni Rc) inline {libc.free(self as *u8);}
}

// 'Rwcell', the lock permission for owners on one thread: 'Rc[Rwcell, T]'.
// A lock permission is a struct declaring the built-in trait
// 'LockPermission', written in a managed reference's permission slot; its
// value, the lock, is kept in each allocation's header after the region's
// part, and the reference reaches its value only by a borrow through it,
// '&mut *r' or '&*r', which takes the lock for as long as the borrow lasts.
// The compiler calls 'init' on the lock as the allocation is made,
// 'acquireMut' as a borrow that may write begins and 'releaseMut' as it
// ends, and 'acquireRead' and 'releaseRead' for a read-only one; an
// acquiring method taking a file and a line is handed the borrow's. Rwcell's
// lock is a count of the borrows holding it: several read-only ones, or one
// that may write, as the sync package's Rwlock allows across threads. On one
// thread a borrow that conflicts with one still held could never be given
// it, since the holder is the thread itself, so it panics instead of waiting.
// It does not declare 'ThreadSafe', so it fits only a region whose owners
// stay on one thread.
pub struct Rwcell is LockPermission {
  // 0 free, n > 0 held by n read-only borrows, -1 by one that may write
  borrows isize;
  fn init(self &new) inline {*self = new Rwcell(0isize);}
  // The acquiring methods are handed where the borrow is, which the panic names
  fn acquireMut(self &uni Rwcell, file &Array[u8], line u32) inline {
    if borrows != 0isize {
      panic("Rwcell: a borrow that may write, while another borrow holds the lock", file, line);
    }
    borrows = -1isize;
  }
  fn releaseMut(self &uni Rwcell) inline {borrows = 0isize;}
  fn acquireRead(self &uni Rwcell, file &Array[u8], line u32) inline {
    if borrows < 0isize {
      panic("Rwcell: a read-only borrow, while a borrow that may write holds the lock", file, line);
    }
    borrows = borrows + 1isize;
  }
  fn releaseRead(self &uni Rwcell) inline {borrows = borrows - 1isize;}
}

// A type's record: what only the compiler knows about a value's type, for a
// region that must act on values whose types it cannot name. The compiler
// builds one constant record per type ('mem.typeRecord[T]()' is its address),
// and hands it to a region ref whose 'alloc' asks for it by taking it after the
// size: 'fn alloc(size usize, ty *TypeRecord) *u8'. It is declared here, and
// the compiler fills in exactly these fields, in this order.
pub struct TypeRecord {
  // The value's size and alignment, in bytes, for the target
  pub size usize;
  pub align usize;
  // The value's death where it sits, less any free, called with its address:
  // what 'mem.finalize' runs. A function that does nothing where the type
  // needs no finalizing, which bit 0 of 'flags' also says
  pub finalize &fn(p *u8);
  // Every traced reference the value holds where it sits (a reference into a
  // region declaring 'Traced'), handed to its region's 'mark', called with its
  // address and a mode the region's collector chooses, which 'mark' is handed
  // on: what 'mem.trace' runs. A function that does nothing where the type
  // holds none, which bit 1 of 'flags' also says
  pub trace &fn(p *u8, mode u32);
  // Bit 0: finalizing the value does something. Bit 1: the value holds a
  // traced reference
  pub flags u32;
}

// The ordering an atomic operation of 'mem' promises for the memory around it,
// on the C11 model: 'Relaxed' orders nothing but the operation itself;
// 'Acquire' keeps what follows a load after it; 'Release' keeps what precedes
// a store before it; 'AcqRel' is both, for a read-modify-write; 'SeqCst' is
// both, and every 'SeqCst' operation of the program is also in one order that
// all threads see. A call writes it as a constant, 'MemOrder.SeqCst[]', which
// the compiler reads where the call is made.
pub enum MemOrder u8 {
  Relaxed, Acquire, Release, AcqRel, SeqCst;
}

// 'mem': what only the compiler knows about a type's memory, and the raw moves
// in and out of it that a collection builds on, each named through it:
// 'mem.sizeof[T]()'. Each function but 'sliceEq' is an intrinsic: the compiler
// supplies it, from what its registry defines the name to mean in Cone's terms,
// and the reference manual's Intrinsics page states every edge case.
// '@intrinsic' is allowed only in the core package, and each declaration must
// say what the registry says. None has a symbol: every call is expanded where it
// is made. A body, where the registry allows one, is the fallback a back end
// with no lowering of its own uses, and what 'conec --intrinsic-fallback' runs
// in place of the lowering, so the two can be tested against each other.
//
// It stands in for a submodule, 'core.mem', which is what it is meant to be:
// one name, 'mem', is folded into every module, rather than each of its
// functions', so a module may declare its own 'finalize' or 'sizeof'. A
// submodule of core cannot be reached today -- a direct compile reads only
// core/src/core.cone, and core's include file writes a submodule as a private
// block -- so it is an opaque struct, which holds no value, whose functions are
// reached by the same path a submodule's would be.
pub struct @opaque mem {
  // The size and the alignment of a T, in bytes, for the target: constants
  pub fn @intrinsic sizeof[T]() usize;
  pub fn @intrinsic alignof[T]() usize;
  // Whether finalizing a T does anything
  pub fn @intrinsic needsFinal[T]() bool;
  // Run the death of the T at p where it sits, without freeing its memory
  pub fn @intrinsic finalize[T](p *T);
  // T's record: its size, its alignment, its finalizer, its trace. A constant
  pub fn @intrinsic typeRecord[T]() *TypeRecord;
  // Whether a T holds a traced reference where it sits: a constant
  pub fn @intrinsic holdsTraced[T]() bool;
  // Hand every traced reference in the T at p to its region's 'mark', with
  // mode where 'mark' takes it
  pub fn @intrinsic trace[T](p *T, mode u32);
  // Trace every root: each traced reference the running functions hold on
  // the stack, in their locals, parameters and temporaries, handed to its
  // region's 'mark' with mode, as 'trace' hands those a value holds
  pub fn @intrinsic traceRoots(mode u32);
  // A slice of the len values starting at p
  pub fn @intrinsic sliceFromParts[T](p *T, len usize) &Array[T];
  pub fn @intrinsic sliceFromPartsMut[T](p *T, len usize) &mut Array[T];
  // Whether a and b hold equal elements: the same count, and each element
  // '==' to its partner, compared through references, so that a T declaring
  // its '==' on references is asked as it is and no element is copied. Not an
  // intrinsic: this body is what '==' and '!=' on two slices call, an
  // instance for each element type, which the compiler finds here by its name
  pub fn sliceEq[T](a &Array[T], b &Array[T]) bool {
    if a.len != b.len {return false;}
    mut i = 0usize;
    while i < a.len {
      if &a[i] == &b[i] {i = i + 1usize;} else {return false;}
    }
    true;
  }
  // Move the T at p out, leaving the slot dead; nothing there is finalized
  pub fn @intrinsic readRaw[T](p *T) T {*p;}
  // Move value into the slot at p, which holds nothing live: nothing is finalized
  pub fn @intrinsic writeRaw[T](p *T, value T);
  // Move count values from 'from' to 'to'; the two ranges may overlap
  pub fn @intrinsic moveRaw[T](to *T, from *T, count usize) {
    if to < from {
      mut i = 0usize;
      while i < count {
        mem.writeRaw[T](to + i, mem.readRaw[T](from + i));
        i = i + 1usize;
      }
    }
    else {
      mut i = count;
      while i > 0usize {
        i = i - 1usize;
        mem.writeRaw[T](to + i, mem.readRaw[T](from + i));
      }
    }
  }

  // The atomic operations on the T at p, each indivisible: no other thread
  // sees it half done. T is an integer type of 8 to 64 bits, bool or a raw
  // pointer (add, sub, min and max take an integer, and and, or and xor an
  // integer or a bool). The order is a constant MemOrder. A read-modify-write answers the
  // value p held before it, and add and sub wrap. The fallback bodies are the
  // plain operations, which are right only while one thread reaches p.
  pub fn @intrinsic atomicLoad[T](p *T, order MemOrder) T {*p;}
  pub fn @intrinsic atomicStore[T](p *T, value T, order MemOrder) {*p = value;}
  pub fn @intrinsic atomicSwap[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = value; old;
  }
  pub fn @intrinsic atomicAdd[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old + value; old;
  }
  pub fn @intrinsic atomicSub[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old - value; old;
  }
  pub fn @intrinsic atomicAnd[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old & value; old;
  }
  pub fn @intrinsic atomicOr[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old | value; old;
  }
  pub fn @intrinsic atomicXor[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old ^ value; old;
  }
  // The lesser and the greater of the two, compared as T is: signed for a
  // signed T
  pub fn @intrinsic atomicMin[T](p *T, value T, order MemOrder) T {
    imm old = *p; if value < old {*p = value;} old;
  }
  pub fn @intrinsic atomicMax[T](p *T, value T, order MemOrder) T {
    imm old = *p; if value > old {*p = value;} old;
  }
  // Store desired at p if it holds expected: the value p held, and whether
  // the store was made. 'failure' is the order when it was not
  pub fn @intrinsic atomicCompareSwap[T](p *T, expected T, desired T,
      success MemOrder, failure MemOrder) T, bool {
    imm old = *p;
    if old == expected {
      *p = desired;
      return old, true;
    }
    old, false;
  }

  // An integer's bits, T an integer type of 8 to 64 bits; each is also a
  // method of every integer type, 'x.leadingZeros()'. A count of the bits of 0
  // is the width. The amount of a rotate or a masked shift is taken modulo the
  // width, and shrMasked is arithmetic for a signed T, logical for an unsigned
  // one, where '<<' and '>>' give 0, or the sign, past the width. The fallback
  // bodies go a bit at a time
  pub fn @intrinsic countOnes[T](x T) u32 {
    mut v = x;
    mut n = 0u32;
    while v != T.from(0) {
      v = v & (v - T.from(1));
      n = n + 1u32;
    }
    n;
  }
  pub fn @intrinsic leadingZeros[T](x T) u32 {
    imm width = u32.from(mem.sizeof[T]()) * 8u32;
    mut n = 0u32;
    while n < width {
      if ((x >> T.from(width - 1u32 - n)) & T.from(1)) != T.from(0) {break;}
      n = n + 1u32;
    }
    n;
  }
  pub fn @intrinsic trailingZeros[T](x T) u32 {
    imm width = u32.from(mem.sizeof[T]()) * 8u32;
    mut n = 0u32;
    while n < width {
      if ((x >> T.from(n)) & T.from(1)) != T.from(0) {break;}
      n = n + 1u32;
    }
    n;
  }
  // The bits rotated in are shifted logically, a signed T's sign copies masked off
  pub fn @intrinsic rotateLeft[T](x T, n u32) T {
    imm width = u32.from(mem.sizeof[T]()) * 8u32;
    imm k = n % width;
    if k == 0u32 {return x;}
    (x << T.from(k)) | ((x >> T.from(width - k)) & ~(~T.from(0) << T.from(k)));
  }
  pub fn @intrinsic rotateRight[T](x T, n u32) T {
    imm width = u32.from(mem.sizeof[T]()) * 8u32;
    imm k = n % width;
    if k == 0u32 {return x;}
    ((x >> T.from(k)) & ~(~T.from(0) << T.from(width - k))) | (x << T.from(width - k));
  }
  pub fn @intrinsic shlMasked[T](x T, n u32) T {
    x << T.from(n % (u32.from(mem.sizeof[T]()) * 8u32));
  }
  pub fn @intrinsic shrMasked[T](x T, n u32) T {
    x >> T.from(n % (u32.from(mem.sizeof[T]()) * 8u32));
  }

  // The full 128-bit product of a and b, its high 64 bits and its low 64 bits
  // exclusive-or'd: the mixing step of the wyhash family, one multiply on a
  // 64-bit target. The low half alone is 'a * b', so the high half alone is
  // 'mulFold(a, b) ^ (a * b)'. The fallback body forms the product from 32-bit
  // halves
  pub fn @intrinsic mulFold(a u64, b u64) u64 {
    imm lowmask = 0xFFFFFFFFu64;
    imm a0 = a & lowmask;
    imm a1 = a >> 32u64;
    imm b0 = b & lowmask;
    imm b1 = b >> 32u64;
    imm p00 = a0 * b0;
    imm p01 = a0 * b1;
    imm p10 = a1 * b0;
    imm p11 = a1 * b1;
    imm mid = (p00 >> 32u64) + (p01 & lowmask) + (p10 & lowmask);
    imm high = p11 + (p01 >> 32u64) + (p10 >> 32u64) + (mid >> 32u64);
    high ^ (a * b);
  }
}

// ATOMIC VALUES: Atomic[T], an integer, a bool or a raw pointer that several
// threads may read and change at once without a lock, each change
// indivisible. It is here rather than in the sync package because it needs
// nothing of the OS, as Rust keeps its atomics in 'core::sync::atomic'; sync
// keeps what does (the futex, the locks, the channels, 'Arc'). Being core's,
// its name is in every module, no import needed.
//
//   mod hits;
//
//   struct Stats {
//     pub name u32;
//     pub hits Atomic[u64];        // atomic because of its type
//   }
//
//   fn count(stats &Stats) {
//     stats.hits.add(1u64);        // one indivisible add
//     imm n = stats.hits.load();   // the number itself
//   }
//
// An Atomic is changed only by its own operations, and those work through any
// reference to it, even an 'imm' one: 'imm' means that nothing changes except
// inside the atomic values it holds [Jon 26 Sep]. So a value holding one --
// in a field, an array, a tuple or an enum's variant, however deep -- is never
// placed in read-only memory, even as an 'imm' global, and may not be a
// 'const'. The compiler knows this through the marker Atomic declares,
// 'AtomicValue'; it knows nothing else of this type.
//
// T is an integer type of 8 to 64 bits ('usize' and 'isize' among them), a
// bool, or a raw pointer, '*T': what the type's 'where' clause says, and just
// what the AtomicValue marker admits. Any other T is refused where the Atomic
// is named. Which operations an Atomic has depends on its T, each method's
// own 'where' clause saying when it exists:
//
//   Atomic[T].of(v)          a new atomic value holding v
//   a.load()                 the value
//   a.store(v)               put v there
//   a.swap(v)                put v there, answering the value before
//   a.compareSwap(e, d)      put d there if the value is e, answering the
//                            value seen and whether d was stored
//   a.inner()                the value, taken out of an Atomic the caller
//                            holds by value: nobody else can be reaching it
//                            -- these for every T; and
//   a.bitAnd(v), a.bitOr(v), a.bitXor(v)
//                            the bitwise operation with v, answering the
//                            value before ('and' and 'or' are keywords):
//                            for an integer or a bool, as flags
//   a.add(v), a.sub(v)       add or subtract v, answering the value before;
//                            both wrap: for an integer only
//   a.min(v), a.max(v)       keep the lesser or the greater of the value and
//                            v, answering the value before, compared signed
//                            for a signed T: for an integer only
//
// So 'Atomic[bool]' is a flag, set with store or bitOr and tested with load,
// and 'Atomic[*Node]' is the head of a lock-free list, moved on with
// compareSwap. 'flag.add(true)' is refused where it is written, saying that
// add exists only where T is Integer.
//
// Each operation above is sequentially consistent (MemOrder.SeqCst), the
// strongest ordering: every thread sees all such operations in one order,
// and nothing before or after one moves across it. That is right for nearly
// every use. An expert who needs a weaker ordering names it with the same
// operation's 'Ordered' form, which takes a MemOrder after the other
// arguments: a.loadOrdered(MemOrder.Acquire[]), a.addOrdered(1u64,
// MemOrder.Relaxed[]), a.compareSwapOrdered(e, d, success, failure). An
// ordering the operation cannot have -- a load's Release or AcqRel, a store's
// Acquire or AcqRel, a compareSwap failure ordering of Release, AcqRel or one
// stronger than its success ordering -- is a panic, since the ordering is
// only known as the program runs (mem's operations refuse it where it is
// written, which these forms cannot, taking it as a parameter). Each form
// chooses its instruction by a 'match' on the ordering as it runs. Inlining a
// call whose ordering is a constant can fold that branch away, and the
// optimizer conec runs today does so only sometimes, so where one branch less
// matters, mem.atomicAdd and the rest take the ordering at the call and are
// always the one instruction.
//
// THE HOLE, until the compiler's rules around atomics are built: the
// operations take their receiver as '&opaq', which any reference becomes, so
// nothing yet refuses a plain read or write of an atomic's whole value where
// another thread may reach it: '*r = s' through a '&mut Stats' replaces
// 'hits' plainly. The 'atomic' permission, and plain writes only through a
// unique path, are the rules to come.
//
// How it is laid out. An Atomic[T] is its T, nothing more: the same size and
// alignment. Each operation reaches the value through a raw pointer to it and
// calls mem's intrinsic for the operation, one atomic instruction.

pub struct Atomic[T] is AtomicValue, Move where T is Integer or T is bool or T is Pointer {
  value T;

  // A new atomic value holding v
  pub fn of(v T) Atomic[T] {new Atomic[T](v);}

  // The value, taken out of an Atomic held by value, which nobody else can be
  // reaching: an ordinary read
  pub fn inner(self) T {value;}

  pub fn load(self &opaq) T {
    mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);
  }
  pub fn store(self &opaq, v T) {
    mem.atomicStore[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn swap(self &opaq, v T) T {
    mem.atomicSwap[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn add(self &opaq, v T) T where T is Integer {
    mem.atomicAdd[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn sub(self &opaq, v T) T where T is Integer {
    mem.atomicSub[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn min(self &opaq, v T) T where T is Integer {
    mem.atomicMin[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn max(self &opaq, v T) T where T is Integer {
    mem.atomicMax[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitAnd(self &opaq, v T) T where T is Integer or T is bool {
    mem.atomicAnd[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitOr(self &opaq, v T) T where T is Integer or T is bool {
    mem.atomicOr[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitXor(self &opaq, v T) T where T is Integer or T is bool {
    mem.atomicXor[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn compareSwap(self &opaq, expected T, desired T) T, bool {
    mem.atomicCompareSwap[T](self as *T, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
  }

  // The same operations with the ordering named. Each arm passes its ordering
  // as a constant, as core's operations require.
  pub fn loadOrdered(self &opaq, order MemOrder) T {
    match order {
      case is MemOrder.Relaxed {mem.atomicLoad[T](self as *T, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicLoad[T](self as *T, MemOrder.Acquire[]);}
      case is MemOrder.SeqCst {mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);}
      else {
        panic("core: loadOrdered given Release or AcqRel, which a load cannot have");
        mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);
      }
    }
  }
  pub fn storeOrdered(self &opaq, v T, order MemOrder) {
    match order {
      case is MemOrder.Relaxed {mem.atomicStore[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Release {mem.atomicStore[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.SeqCst {mem.atomicStore[T](self as *T, v, MemOrder.SeqCst[]);}
      else {panic("core: storeOrdered given Acquire or AcqRel, which a store cannot have");}
    }
  }
  pub fn swapOrdered(self &opaq, v T, order MemOrder) T {
    match order {
      case is MemOrder.Relaxed {mem.atomicSwap[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicSwap[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicSwap[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicSwap[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicSwap[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn addOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicAdd[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicAdd[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicAdd[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicAdd[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicAdd[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn subOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicSub[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicSub[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicSub[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicSub[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicSub[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn minOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicMin[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicMin[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicMin[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicMin[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicMin[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn maxOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicMax[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicMax[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicMax[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicMax[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicMax[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitAndOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicAnd[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicAnd[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicAnd[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicAnd[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicAnd[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitOrOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicOr[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicOr[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicOr[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicOr[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicOr[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitXorOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicXor[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicXor[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicXor[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicXor[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicXor[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }

  // 'failure' is the ordering when d is not stored, which is a load: it may
  // be Relaxed, Acquire or SeqCst, and no stronger than 'success'
  pub fn compareSwapOrdered(self &opaq, expected T, desired T,
      success MemOrder, failure MemOrder) T, bool {
    imm p = self as *T;
    match failure {
      case is MemOrder.Relaxed {
        match success {
          case is MemOrder.Relaxed {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Relaxed[], MemOrder.Relaxed[]);}
          case is MemOrder.Acquire {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Acquire[], MemOrder.Relaxed[]);}
          case is MemOrder.Release {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Release[], MemOrder.Relaxed[]);}
          case is MemOrder.AcqRel {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.AcqRel[], MemOrder.Relaxed[]);}
          else {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.Relaxed[]);}
        }
      }
      case is MemOrder.Acquire {
        match success {
          case is MemOrder.Acquire {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Acquire[], MemOrder.Acquire[]);}
          case is MemOrder.AcqRel {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.AcqRel[], MemOrder.Acquire[]);}
          case is MemOrder.SeqCst {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.Acquire[]);}
          else {
            panic("core: compareSwapOrdered given an Acquire failure ordering with a success ordering weaker than it");
            mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
          }
        }
      }
      case is MemOrder.SeqCst {
        match success {
          case is MemOrder.SeqCst {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);}
          else {
            panic("core: compareSwapOrdered given a SeqCst failure ordering with a success ordering weaker than it");
            mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
          }
        }
      }
      else {
        panic("core: compareSwapOrdered given a Release or AcqRel failure ordering, which a compareSwap that stores nothing cannot have");
        mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
      }
    }
  }
}

// HASHING: what a value feeds a hasher (Hash), and the algorithm that turns what
// it fed into a number (Hasher), kept apart as Rust's Hash and Hasher are and as
// Swift's 'hash(into:)' is. A key type says what identifies it, in 'hash'; a
// collection owns the Hasher, so changing the algorithm changes no key type.
//
//   struct Id is Hash {            // no 'hash' written: the compiler supplies one
//     pub slot u32;                // that feeds each field, in order
//     pub gen u32;
//     pub fn `==`(self, o Id) bool {slot == o.slot and gen == o.gen;}
//   }
//
//   mut h = Hasher.seeded();       // seeded once per process, at random
//   id.hash(&mut h);
//   imm number = h.finish();
//
// The rule that ties hashing to equality: if a == b then a and b feed the same
// things, so a type that is Hash has a '==' (refused otherwise). Variable-length
// values feed a terminator after their bytes ('writeStr'), so that ("ab", "c")
// and ("a", "bc") differ as the parts of one key. Floats are not Hash, since NaN
// is not equal to itself and -0 is equal to 0. A struct that declares Hash and
// writes no 'hash' is given one that feeds its fields, in order (never its
// bytes: padding is undefined), and the compiler refuses it where a field is a
// float or not Hash. Every integer type and bool is Hash, feeding its bits.
//
// The compiler knows this trait and the Hasher by their names and this package
// (compiler/c/ir/types/struct.c, structHashCheck), as it knows TypeRecord.
pub trait Hash {
  pub fn hash(self &, h &mut Hasher);
}

pub extern {
  // The seed this process hashes with unless a hasher is built with another:
  // 64 random bits from the OS, drawn the first time anything asks, on any
  // thread, and the same for the rest of the process. Never 0. A table that
  // keeps this seed visits its entries in a different order on every run
  fn @c("cone_hashSeed") processSeed() u64;
}

// The algorithm. A word a value feeds it ('writeU64') is xored into the state
// and the state multiplied by an odd constant, 128 bits wide, the two halves of
// the product folded together by xor: foldhash's step, of the wyhash family, one
// multiply. A run of bytes ('writeBytes') goes through wyhash, final version 4.3,
// seeded with the state, which takes 16 bytes at a time. The state starts as the
// seed and every word is mixed into it, so without the seed nobody can tell
// which keys collide: that is the defence against hostile ones. Seeded from the
// process's random seed ('seeded'), or with a fixed one ('withSeed') that gives
// the same numbers on every run.
pub struct Hasher {
  state u64;

  // A hasher with the process's seed (processSeed): different on every run
  pub fn seeded() Hasher inline {Hasher.withSeed(processSeed());}

  // A hasher with this seed: the same numbers for the same feed on every run,
  // and different seeds give different numbers
  pub fn withSeed(seed u64) Hasher inline {
    new Hasher(seed ^ mem.mulFold(seed ^ 0x2d358dccaa6c78a5u64, 0x8bb84b93962eacc9u64));
  }

  // Feed a word
  pub fn writeU64(self &mut, v u64) inline {
    state = mem.mulFold(state ^ v, 0x9e3779b97f4a7c15u64);
  }
  pub fn writeU32(self &mut, v u32) inline {self.writeU64(u64.from(v));}
  pub fn writeU16(self &mut, v u16) inline {self.writeU64(u64.from(v));}
  pub fn writeU8(self &mut, v u8) inline {self.writeU64(u64.from(v));}

  // Feed bytes: wyhash of them, seeded with the state, becomes the state. These
  // bytes alone, with nothing marking where they end: for a value of fixed size
  pub fn writeBytes(self &mut, b &Array[u8]) inline {
    state = Hasher.wyhash(b, state);
  }

  // Feed a value of any length, text or bytes: its bytes, then the terminator
  // 0xFF (a byte UTF-8 never holds, as Rust's 'write_str' ends with), so that
  // where one such value ends and the next begins is part of what is fed
  pub fn writeStr(self &mut, b &Array[u8]) inline {
    self.writeBytes(b);
    self.writeU8(0xFFu8);
  }

  // The number this feed comes to. Asking does not change the hasher: more may
  // be fed afterwards
  pub fn finish(self &) u64 inline {
    mem.mulFold(state ^ 0x4b33a62ed433d4a3u64, 0x4d5a2da51de1aa47u64);
  }

  // wyhash, final version 4.3 (Wang Yi, public domain), its default secret, of
  // the bytes with this seed: the published function itself, whose own numbers
  // are its tests. For a seed or a hash that is not a running Hasher's state
  pub fn wyhash(b &Array[u8], seed u64) u64 inline {
    if b.len == 0usize {Hasher.wyhashAt(null, 0usize, seed);}
    else {Hasher.wyhashAt(&b[0usize] as *u8, b.len, seed);}
  }

  // wyhash of the len bytes at p, little-endian reads. One multiply and fold
  // per 16 bytes
  fn wyhashAt(p *u8, len usize, seed u64) u64 inline {
    mut s = seed ^ mem.mulFold(seed ^ 0x2d358dccaa6c78a5u64, 0x8bb84b93962eacc9u64);
    mut a = 0u64;
    mut b = 0u64;
    if len <= 16usize {
      if len >= 4usize {
        imm q = (len >> 3usize) << 2usize;
        a = (Hasher.read4(p) << 32u64) | Hasher.read4(p + q);
        b = (Hasher.read4(p + (len - 4usize)) << 32u64) | Hasher.read4(p + (len - 4usize - q));
      }
      else if len > 0usize {
        a = (u64.from(mem.readRaw[u8](p)) << 16u64)
          | (u64.from(mem.readRaw[u8](p + (len >> 1usize))) << 8u64)
          | u64.from(mem.readRaw[u8](p + (len - 1usize)));
      }
    }
    else {
      mut i = len;
      mut q = p;
      if i >= 48usize {
        mut see1 = s;
        mut see2 = s;
        while i >= 48usize {
          s = mem.mulFold(Hasher.read8(q) ^ 0x8bb84b93962eacc9u64, Hasher.read8(q + 8usize) ^ s);
          see1 = mem.mulFold(Hasher.read8(q + 16usize) ^ 0x4b33a62ed433d4a3u64, Hasher.read8(q + 24usize) ^ see1);
          see2 = mem.mulFold(Hasher.read8(q + 32usize) ^ 0x4d5a2da51de1aa47u64, Hasher.read8(q + 40usize) ^ see2);
          q = q + 48usize;
          i = i - 48usize;
        }
        s = s ^ see1 ^ see2;
      }
      while i > 16usize {
        s = mem.mulFold(Hasher.read8(q) ^ 0x8bb84b93962eacc9u64, Hasher.read8(q + 8usize) ^ s);
        i = i - 16usize;
        q = q + 16usize;
      }
      a = Hasher.read8(q + (i - 16usize));
      b = Hasher.read8(q + (i - 8usize));
    }
    // The last step multiplies a and b into the halves of their product, the low
    // half in a and the high in b (the high is the fold less the low), and mixes
    // those with the secret and the length
    a = a ^ 0x8bb84b93962eacc9u64;
    b = b ^ s;
    imm low = a * b;
    imm high = mem.mulFold(a, b) ^ low;
    mem.mulFold(low ^ 0x2d358dccaa6c78a5u64 ^ u64.from(len), high ^ 0x8bb84b93962eacc9u64);
  }

  // Four and eight bytes at p, little-endian, however p is aligned
  fn read4(p *u8) u64 inline {
    u64.from(mem.readRaw[u8](p))
      | (u64.from(mem.readRaw[u8](p + 1usize)) << 8u64)
      | (u64.from(mem.readRaw[u8](p + 2usize)) << 16u64)
      | (u64.from(mem.readRaw[u8](p + 3usize)) << 24u64);
  }
  fn read8(p *u8) u64 inline {
    Hasher.read4(p) | (Hasher.read4(p + 4usize) << 32u64);
  }
}
