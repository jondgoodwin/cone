// The core package: the prelude. The compiler loads it before any module of the
// program and wildcard-imports it into every module, so its public names are in
// reach everywhere without an 'import'. A compile without a build description
// finds it on the package search path like any package, and nowhere else.
//
// Everything here is 'inline', generic, 'extern' or an intrinsic, so core's
// object defines nothing. Congo compiles core on its own like any package, and that compile
// generates core's include file, which says what this file says; every package
// Congo compiles after it loads the prelude from that include file, which its
// build description's package line for core names.
//
// The C runtime's allocator is libc's, whose package declares it once for the
// whole program. core imports libc, which, being a C-named module, gets no
// prelude of its own, so the import makes no loop; Congo builds libc before
// core. A panic's work is conestd's, the runtime every program links.

mod core;

// libc's 'malloc' is folded in publicly, so it stays a bare name of every
// module, as a region's own allocator writes it; 'libc' itself is not. A module
// that imports libc and folds its names in too meets the same declaration by
// two routes nobody wrote, which is one binding, not a collision
import libc pub use malloc;

pub enum Option[T] {
  struct None {}
  struct Some {pub value T;}
}

pub enum Result[T,E] {
  struct Ok {pub value T;}
  struct Error {pub value E;}
}

// A variant is a name of its enum, so these two statements are what make Some,
// None, Ok and Error bare names of core. They are 'pub', and every module's
// automatic import of core folds its public names, which carries them on into
// every program
pub use Option;
pub use Result;

// A panic ends the program where something that must not happen has: an index
// out of bounds, memory exhausted, an invariant broken. It is a bug report, not
// error handling, which is Option's and Result's. The runtime does the work
// (packages/conestd/panic.cone): stdout is flushed, one line goes to stderr,
// 'panic at <file>:<line>: <message>', the hook runs if one is set, and the
// program aborts. Nothing unwinds, and no finalizer runs. Each function here
// returns 'Never': a call to it does not return, so it may end any block,
// one that must produce a value included.
//
// Each reports where it was CALLED. Its 'file' and 'line' default to
// 'srcFile()' and 'srcLine()', which, written as a default, answer where each
// call taking the default is. A helper of a program's own that panics
// declares the same two parameters and passes them on, and so reports its
// caller too.

// Where this call is written: its source file's name, without the folders,
// and its line. Written as a parameter's default value, where each call taking
// the default is. Constants
pub fn @intrinsic srcFile() &[]u8;
pub fn @intrinsic srcLine() u32;

pub extern {
  // End the program, reporting msg and where
  fn @c("cone_panic") panic(msg &[]u8, file &[]u8 = srcFile(), line u32 = srcLine()) Never;
  // The function a panic calls once its line is written, before the program
  // ends: to log it, say, or report it elsewhere. Setting it is atomic, from
  // any thread and at any time, and the last one set is the one called. It
  // runs on the panicking thread, and a panic inside it ends the program at once
  fn @c("cone_setPanicHook") setPanicHook(hook &fn(msg &[]u8, file &[]u8, line u32));
}

// Whether this compile is a debug build: 'conec --debug', or 'build: debug' in
// the build description Congo writes. A constant, so the side of an 'if' on it
// that this build does not take is never generated and never reaches the object
pub fn @intrinsic isDebugBuild() Bool;

// TEMPORARY, a provisional mechanism whose final design is open. Constants of
// the compile as isDebugBuild is, so the side of an 'if' on them that this
// build does not take is never generated (both sides are still type checked).
// The OS the compile targets, from its target triple: no flag
pub fn @intrinsic isWindows() Bool;
pub fn @intrinsic isLinux() Bool;
pub fn @intrinsic isMacOS() Bool;
pub fn @intrinsic isWasm() Bool;
// Whether conec's command line defined name, '-D name' or '-D name=123', and
// the integer it was given: 1 for '-D name', 0 when it was not defined. The
// name is a string literal
pub fn @intrinsic isDefined(name &[]u8) Bool;
pub fn @intrinsic definedInt(name &[]u8) i64;

// Panic unless cond holds. Checked in every build, release included
pub fn assert(cond Bool, msg &[]u8 = "assertion failed", file &[]u8 = srcFile(),
    line u32 = srcLine()) inline {
  if !cond {panic(msg, file, line);}
}

// Panic unless cond holds, in a debug build only [Jon 27 Sep]. A macro, so its
// condition is substituted where it is used rather than evaluated first: in a
// release build the whole use is folded away and the condition never runs,
// whatever it would have done. 'srcFile()' and 'srcLine()' written in a macro's
// body answer where the macro is used, so the panic names the caller's line.
// A macro takes no default, so the form with a message has a name of its own
pub macro assertDebug[cond] {
  if isDebugBuild() {assert(cond, "assertion failed", srcFile(), srcLine());} else {}
}
pub macro assertDebugMsg[cond, msg] {
  if isDebugBuild() {assert(cond, msg, srcFile(), srcLine());} else {}
}

// Code the author knows cannot be reached, reached
pub fn unreachable(msg &[]u8 = "reached code marked unreachable", file &[]u8 = srcFile(),
    line u32 = srcLine()) Never inline {
  panic(msg, file, line);
}

// Code not written yet
pub fn todo(msg &[]u8 = "not yet implemented", file &[]u8 = srcFile(),
    line u32 = srcLine()) Never inline {
  panic(msg, file, line);
}

// Which invocation of a compute dispatch is running, what a compute entry
// point ('fn @compute(64) bake(inv Invocation, ...)') may take as a
// parameter: its id in the whole dispatch, in its workgroup and its
// workgroup's, each three-dimensional; its flat index within the workgroup
// (x fastest); and how many workgroups the dispatch has. On the GPU the
// compiler fills it from the invocation's built-ins; on the CPU the same
// function is called in a loop that fills it. Plain data, 52 bytes.
pub struct Invocation {
  pub globalId Array[u32, 3];
  pub localId Array[u32, 3];
  pub groupId Array[u32, 3];
  pub localIndex u32;
  pub groupCount Array[u32, 3];
}

// A compute workgroup's barriers: every invocation of the workgroup waits at
// one until all have reached it, and what each wrote before it, to the
// workgroup's '@workgroup' globals (workgroupBarrier) or to the buffers the
// kernel binds (storageBarrier), every other reads after it. Every invocation
// of the workgroup must reach the same barrier, so one is never written where
// some invocations of a workgroup go and others do not. The CPU runs a kernel
// one invocation at a time, so there each is nothing.
pub fn @intrinsic workgroupBarrier() {}
pub fn @intrinsic storageBarrier() {}

// The two regions every module reaches. A region is a struct declaring the
// built-in trait 'RegionRef', and the compiler knows neither of these by name:
// it calls the methods each declares at each reference event, and what one
// leaves out says what it does. Each method is handed the allocation's header,
// the region's own fields, which is where 'alloc' returned. They are private,
// called by the compiler alone, and inline, like everything in core.
//
// 'So' is the single owner: it declares 'Move', so a copy of a reference is a
// move, and its one owner going away is the value's death, which ends in
// 'free'. A region ref declaring neither 'Move' nor 'aliasRef' would share its
// references freely, and its owners' going would do nothing.
pub struct So is RegionRef, Move {
  fn alloc(size usize) *u8 inline {libc.malloc(size);}
  // A bare 'free' here is this method, so C's is named through its package
  fn free(self &uni So) inline {libc.free(self as *u8);}
}

// 'Rc' counts its owners in its header. 'aliasRef' is called for each copy that
// becomes another owner, 'dealiasRef' for each owner going away, answering whether
// that was the last; only then does the value die, ending in 'free'. The count
// is a plain number, so two threads changing it at once would lose a change:
// 'Rc' does not declare 'ThreadSafe', and its owners belong to one thread.
// The sync package's 'Arc' is the one whose count is atomic.
pub struct Rc is RegionRef {
  cnt usize;
  fn alloc(size usize) *u8 inline {libc.malloc(size);}
  fn init(self &new) inline {*self = new Rc(1usize);}
  fn aliasRef(self &uni Rc) inline {cnt = cnt + 1usize;}
  fn dealiasRef(self &uni Rc) Bool inline {cnt = cnt - 1usize; cnt == 0usize;}
  fn free(self &uni Rc) inline {libc.free(self as *u8);}
}

// 'Rwcell', the lock permission for owners on one thread: 'Rc[Rwcell, T]'.
// A lock permission is a struct declaring the built-in trait
// 'LockPermission', written in a managed reference's permission slot; its
// value, the lock, is kept in each allocation's header after the region's
// part, and the reference reaches its value only by a borrow through it,
// '&mut *r' or '&*r', which takes the lock for as long as the borrow lasts.
// The compiler calls 'init' on the lock as the allocation is made,
// 'acquireMut' as a borrow that may write begins and 'releaseMut' as it
// ends, and 'acquireRead' and 'releaseRead' for a read-only one; an
// acquiring method taking a file and a line is handed the borrow's. Rwcell's
// lock is a count of the borrows holding it: several read-only ones, or one
// that may write, as the sync package's Rwlock allows across threads. On one
// thread a borrow that conflicts with one still held could never be given
// it, since the holder is the thread itself, so it panics instead of waiting.
// It does not declare 'ThreadSafe', so it fits only a region whose owners
// stay on one thread.
pub struct Rwcell is LockPermission {
  // 0 free, n > 0 held by n read-only borrows, -1 by one that may write
  borrows isize;
  fn init(self &new) inline {*self = new Rwcell(0isize);}
  // The acquiring methods are handed where the borrow is, which the panic names
  fn acquireMut(self &uni Rwcell, file &[]u8, line u32) inline {
    if borrows != 0isize {
      panic("Rwcell: a borrow that may write, while another borrow holds the lock", file, line);
    }
    borrows = -1isize;
  }
  fn releaseMut(self &uni Rwcell) inline {borrows = 0isize;}
  fn acquireRead(self &uni Rwcell, file &[]u8, line u32) inline {
    if borrows < 0isize {
      panic("Rwcell: a read-only borrow, while a borrow that may write holds the lock", file, line);
    }
    borrows = borrows + 1isize;
  }
  fn releaseRead(self &uni Rwcell) inline {borrows = borrows - 1isize;}
}

// A type's record: what only the compiler knows about a value's type, for a
// region that must act on values whose types it cannot name. The compiler
// builds one constant record per type ('mem.typeRecord[T]()' is its address),
// and hands it to a region ref whose 'alloc' asks for it by taking it after the
// size: 'fn alloc(size usize, ty *TypeRecord) *u8'. It is declared here, and
// the compiler fills in exactly these fields, in this order.
pub struct TypeRecord {
  // The value's size and alignment, in bytes, for the target
  pub size usize;
  pub align usize;
  // The value's death where it sits, less any free, called with its address:
  // what 'mem.finalize' runs. A function that does nothing where the type
  // needs no finalizing, which bit 0 of 'flags' also says
  pub finalize &fn(p *u8);
  // Every traced reference the value holds where it sits (a reference into a
  // region declaring 'Traced'), handed to its region's 'mark', called with its
  // address and a mode the region's collector chooses, which 'mark' is handed
  // on: what 'mem.trace' runs. A function that does nothing where the type
  // holds none, which bit 1 of 'flags' also says
  pub trace &fn(p *u8, mode u32);
  // Bit 0: finalizing the value does something. Bit 1: the value holds a
  // traced reference
  pub flags u32;
}

// The ordering an atomic operation of 'mem' promises for the memory around it,
// on the C11 model: 'Relaxed' orders nothing but the operation itself;
// 'Acquire' keeps what follows a load after it; 'Release' keeps what precedes
// a store before it; 'AcqRel' is both, for a read-modify-write; 'SeqCst' is
// both, and every 'SeqCst' operation of the program is also in one order that
// all threads see. A call writes it as a constant, 'MemOrder.SeqCst[]', which
// the compiler reads where the call is made.
pub enum MemOrder u8 {
  Relaxed, Acquire, Release, AcqRel, SeqCst;
}

// 'mem': what only the compiler knows about a type's memory, and the raw moves
// in and out of it that a collection builds on, each named through it:
// 'mem.sizeof[T]()'. Each function but 'sliceEq' is an intrinsic: the compiler
// supplies it, from what its registry defines the name to mean in Cone's terms,
// and the reference manual's Intrinsics page states every edge case.
// '@intrinsic' is allowed only in the core package, and each declaration must
// say what the registry says. None has a symbol: every call is expanded where it
// is made. A body, where the registry allows one, is the fallback a back end
// with no lowering of its own uses, and what 'conec --intrinsic-fallback' runs
// in place of the lowering, so the two can be tested against each other.
//
// It stands in for a submodule, 'core.mem', which is what it is meant to be:
// one name, 'mem', is folded into every module, rather than each of its
// functions', so a module may declare its own 'finalize' or 'sizeof'. A
// submodule of core cannot be reached today -- a direct compile reads only
// core/src/core.cone, and core's include file writes a submodule as a private
// block -- so it is an opaque struct, which holds no value, whose functions are
// reached by the same path a submodule's would be.
pub struct @opaque mem {
  // The size and the alignment of a T, in bytes, for the target: constants
  pub fn @intrinsic sizeof[T]() usize;
  pub fn @intrinsic alignof[T]() usize;
  // Whether finalizing a T does anything
  pub fn @intrinsic needsFinal[T]() Bool;
  // Run the death of the T at p where it sits, without freeing its memory
  pub fn @intrinsic finalize[T](p *T);
  // T's record: its size, its alignment, its finalizer, its trace. A constant
  pub fn @intrinsic typeRecord[T]() *TypeRecord;
  // Whether a T holds a traced reference where it sits: a constant
  pub fn @intrinsic holdsTraced[T]() Bool;
  // Hand every traced reference in the T at p to its region's 'mark', with
  // mode where 'mark' takes it
  pub fn @intrinsic trace[T](p *T, mode u32);
  // Trace every root: each traced reference the running functions hold on
  // the stack, in their locals, parameters and temporaries, handed to its
  // region's 'mark' with mode, as 'trace' hands those a value holds
  pub fn @intrinsic traceRoots(mode u32);
  // A slice of the len values starting at p
  pub fn @intrinsic sliceFromParts[T](p *T, len usize) &[]T;
  pub fn @intrinsic sliceFromPartsMut[T](p *T, len usize) &[]mut T;
  // Whether a and b hold equal elements: the same count, and each element
  // '==' to its partner, compared through references, so that a T declaring
  // its '==' on references is asked as it is and no element is copied. Not an
  // intrinsic: this body is what '==' and '!=' on two slices call, an
  // instance for each element type, which the compiler finds here by its name
  pub fn sliceEq[T](a &[]T, b &[]T) Bool {
    if a.len != b.len {return false;}
    mut i = 0usize;
    while i < a.len {
      if &a[i] == &b[i] {i = i + 1usize;} else {return false;}
    }
    true;
  }
  // Move the T at p out, leaving the slot dead; nothing there is finalized
  pub fn @intrinsic readRaw[T](p *T) T {*p;}
  // Move value into the slot at p, which holds nothing live: nothing is finalized
  pub fn @intrinsic writeRaw[T](p *T, value T);
  // Move count values from 'from' to 'to'; the two ranges may overlap
  pub fn @intrinsic moveRaw[T](to *T, from *T, count usize) {
    if to < from {
      mut i = 0usize;
      while i < count {
        mem.writeRaw[T](to + i, mem.readRaw[T](from + i));
        i = i + 1usize;
      }
    }
    else {
      mut i = count;
      while i > 0usize {
        i = i - 1usize;
        mem.writeRaw[T](to + i, mem.readRaw[T](from + i));
      }
    }
  }

  // The atomic operations on the T at p, each indivisible: no other thread
  // sees it half done. T is an integer type of 8 to 64 bits, Bool or a raw
  // pointer (add, sub, min and max take an integer, and and, or and xor an
  // integer or a Bool). The order is a constant MemOrder. A read-modify-write answers the
  // value p held before it, and add and sub wrap. The fallback bodies are the
  // plain operations, which are right only while one thread reaches p.
  pub fn @intrinsic atomicLoad[T](p *T, order MemOrder) T {*p;}
  pub fn @intrinsic atomicStore[T](p *T, value T, order MemOrder) {*p = value;}
  pub fn @intrinsic atomicSwap[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = value; old;
  }
  pub fn @intrinsic atomicAdd[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old + value; old;
  }
  pub fn @intrinsic atomicSub[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old - value; old;
  }
  pub fn @intrinsic atomicAnd[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old & value; old;
  }
  pub fn @intrinsic atomicOr[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old | value; old;
  }
  pub fn @intrinsic atomicXor[T](p *T, value T, order MemOrder) T {
    imm old = *p; *p = old ^ value; old;
  }
  // The lesser and the greater of the two, compared as T is: signed for a
  // signed T
  pub fn @intrinsic atomicMin[T](p *T, value T, order MemOrder) T {
    imm old = *p; if value < old {*p = value;} old;
  }
  pub fn @intrinsic atomicMax[T](p *T, value T, order MemOrder) T {
    imm old = *p; if value > old {*p = value;} old;
  }
  // Store desired at p if it holds expected: the value p held, and whether
  // the store was made. 'failure' is the order when it was not
  pub fn @intrinsic atomicCompareSwap[T](p *T, expected T, desired T,
      success MemOrder, failure MemOrder) T, Bool {
    imm old = *p;
    if old == expected {
      *p = desired;
      return old, true;
    }
    old, false;
  }

  // An integer's bits, T an integer type of 8 to 64 bits; each is also a
  // method of every integer type, 'x.leadingZeros()'. A count of the bits of 0
  // is the width. The amount of a rotate or a masked shift is taken modulo the
  // width, and shrMasked is arithmetic for a signed T, logical for an unsigned
  // one, where '<<' and '>>' give 0, or the sign, past the width. The fallback
  // bodies go a bit at a time
  pub fn @intrinsic countOnes[T](x T) u32 {
    mut v = x;
    mut n = 0u32;
    while v != T.from(0) {
      v = v & (v - T.from(1));
      n = n + 1u32;
    }
    n;
  }
  pub fn @intrinsic leadingZeros[T](x T) u32 {
    imm width = u32.from(mem.sizeof[T]()) * 8u32;
    mut n = 0u32;
    while n < width {
      if ((x >> T.from(width - 1u32 - n)) & T.from(1)) != T.from(0) {break;}
      n = n + 1u32;
    }
    n;
  }
  pub fn @intrinsic trailingZeros[T](x T) u32 {
    imm width = u32.from(mem.sizeof[T]()) * 8u32;
    mut n = 0u32;
    while n < width {
      if ((x >> T.from(n)) & T.from(1)) != T.from(0) {break;}
      n = n + 1u32;
    }
    n;
  }
  // The bits rotated in are shifted logically, a signed T's sign copies masked off
  pub fn @intrinsic rotateLeft[T](x T, n u32) T {
    imm width = u32.from(mem.sizeof[T]()) * 8u32;
    imm k = n % width;
    if k == 0u32 {return x;}
    (x << T.from(k)) | ((x >> T.from(width - k)) & ~(~T.from(0) << T.from(k)));
  }
  pub fn @intrinsic rotateRight[T](x T, n u32) T {
    imm width = u32.from(mem.sizeof[T]()) * 8u32;
    imm k = n % width;
    if k == 0u32 {return x;}
    ((x >> T.from(k)) & ~(~T.from(0) << T.from(width - k))) | (x << T.from(width - k));
  }
  pub fn @intrinsic shlMasked[T](x T, n u32) T {
    x << T.from(n % (u32.from(mem.sizeof[T]()) * 8u32));
  }
  pub fn @intrinsic shrMasked[T](x T, n u32) T {
    x >> T.from(n % (u32.from(mem.sizeof[T]()) * 8u32));
  }
}

// ATOMIC VALUES: Atomic[T], an integer, a Bool or a raw pointer that several
// threads may read and change at once without a lock, each change
// indivisible. It is here rather than in the sync package because it needs
// nothing of the OS, as Rust keeps its atomics in 'core::sync::atomic'; sync
// keeps what does (the futex, the locks, the channels, 'Arc'). Being core's,
// its name is in every module, no import needed.
//
//   mod hits;
//
//   struct Stats {
//     pub name u32;
//     pub hits Atomic[u64];        // atomic because of its type
//   }
//
//   fn count(stats &Stats) {
//     stats.hits.add(1u64);        // one indivisible add
//     imm n = stats.hits.load();   // the number itself
//   }
//
// An Atomic is changed only by its own operations, and those work through any
// reference to it, even an 'imm' one: 'imm' means that nothing changes except
// inside the atomic values it holds [Jon 26 Sep]. So a value holding one --
// in a field, an array, a tuple or an enum's variant, however deep -- is never
// placed in read-only memory, even as an 'imm' global, and may not be a
// 'const'. The compiler knows this through the marker Atomic declares,
// 'AtomicValue'; it knows nothing else of this type.
//
// T is an integer type of 8 to 64 bits ('usize' and 'isize' among them), a
// Bool, or a raw pointer, '*T': what the type's 'where' clause says, and just
// what the AtomicValue marker admits. Any other T is refused where the Atomic
// is named. Which operations an Atomic has depends on its T, each method's
// own 'where' clause saying when it exists:
//
//   Atomic[T].of(v)          a new atomic value holding v
//   a.load()                 the value
//   a.store(v)               put v there
//   a.swap(v)                put v there, answering the value before
//   a.compareSwap(e, d)      put d there if the value is e, answering the
//                            value seen and whether d was stored
//   a.inner()                the value, taken out of an Atomic the caller
//                            holds by value: nobody else can be reaching it
//                            -- these for every T; and
//   a.bitAnd(v), a.bitOr(v), a.bitXor(v)
//                            the bitwise operation with v, answering the
//                            value before ('and' and 'or' are keywords):
//                            for an integer or a Bool, as flags
//   a.add(v), a.sub(v)       add or subtract v, answering the value before;
//                            both wrap: for an integer only
//   a.min(v), a.max(v)       keep the lesser or the greater of the value and
//                            v, answering the value before, compared signed
//                            for a signed T: for an integer only
//
// So 'Atomic[Bool]' is a flag, set with store or bitOr and tested with load,
// and 'Atomic[*Node]' is the head of a lock-free list, moved on with
// compareSwap. 'flag.add(true)' is refused where it is written, saying that
// add exists only where T is Integer.
//
// Each operation above is sequentially consistent (MemOrder.SeqCst), the
// strongest ordering: every thread sees all such operations in one order,
// and nothing before or after one moves across it. That is right for nearly
// every use. An expert who needs a weaker ordering names it with the same
// operation's 'Ordered' form, which takes a MemOrder after the other
// arguments: a.loadOrdered(MemOrder.Acquire[]), a.addOrdered(1u64,
// MemOrder.Relaxed[]), a.compareSwapOrdered(e, d, success, failure). An
// ordering the operation cannot have -- a load's Release or AcqRel, a store's
// Acquire or AcqRel, a compareSwap failure ordering of Release, AcqRel or one
// stronger than its success ordering -- is a panic, since the ordering is
// only known as the program runs (mem's operations refuse it where it is
// written, which these forms cannot, taking it as a parameter). Each form
// chooses its instruction by a 'match' on the ordering as it runs. Inlining a
// call whose ordering is a constant can fold that branch away, and the
// optimizer conec runs today does so only sometimes, so where one branch less
// matters, mem.atomicAdd and the rest take the ordering at the call and are
// always the one instruction.
//
// THE HOLE, until the compiler's rules around atomics are built: the
// operations take their receiver as '&opaq', which any reference becomes, so
// nothing yet refuses a plain read or write of an atomic's whole value where
// another thread may reach it: '*r = s' through a '&mut Stats' replaces
// 'hits' plainly. The 'atomic' permission, and plain writes only through a
// unique path, are the rules to come.
//
// How it is laid out. An Atomic[T] is its T, nothing more: the same size and
// alignment. Each operation reaches the value through a raw pointer to it and
// calls mem's intrinsic for the operation, one atomic instruction.

pub struct Atomic[T] is AtomicValue, Move where T is Integer or T is Bool or T is Pointer {
  value T;

  // A new atomic value holding v
  pub fn of(v T) Atomic[T] {new Atomic[T](v);}

  // The value, taken out of an Atomic held by value, which nobody else can be
  // reaching: an ordinary read
  pub fn inner(self) T {value;}

  pub fn load(self &opaq) T {
    mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);
  }
  pub fn store(self &opaq, v T) {
    mem.atomicStore[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn swap(self &opaq, v T) T {
    mem.atomicSwap[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn add(self &opaq, v T) T where T is Integer {
    mem.atomicAdd[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn sub(self &opaq, v T) T where T is Integer {
    mem.atomicSub[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn min(self &opaq, v T) T where T is Integer {
    mem.atomicMin[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn max(self &opaq, v T) T where T is Integer {
    mem.atomicMax[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitAnd(self &opaq, v T) T where T is Integer or T is Bool {
    mem.atomicAnd[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitOr(self &opaq, v T) T where T is Integer or T is Bool {
    mem.atomicOr[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn bitXor(self &opaq, v T) T where T is Integer or T is Bool {
    mem.atomicXor[T](self as *T, v, MemOrder.SeqCst[]);
  }
  pub fn compareSwap(self &opaq, expected T, desired T) T, Bool {
    mem.atomicCompareSwap[T](self as *T, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
  }

  // The same operations with the ordering named. Each arm passes its ordering
  // as a constant, as core's operations require.
  pub fn loadOrdered(self &opaq, order MemOrder) T {
    match order {
      case is MemOrder.Relaxed {mem.atomicLoad[T](self as *T, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicLoad[T](self as *T, MemOrder.Acquire[]);}
      case is MemOrder.SeqCst {mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);}
      else {
        panic("core: loadOrdered given Release or AcqRel, which a load cannot have");
        mem.atomicLoad[T](self as *T, MemOrder.SeqCst[]);
      }
    }
  }
  pub fn storeOrdered(self &opaq, v T, order MemOrder) {
    match order {
      case is MemOrder.Relaxed {mem.atomicStore[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Release {mem.atomicStore[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.SeqCst {mem.atomicStore[T](self as *T, v, MemOrder.SeqCst[]);}
      else {panic("core: storeOrdered given Acquire or AcqRel, which a store cannot have");}
    }
  }
  pub fn swapOrdered(self &opaq, v T, order MemOrder) T {
    match order {
      case is MemOrder.Relaxed {mem.atomicSwap[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicSwap[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicSwap[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicSwap[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicSwap[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn addOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicAdd[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicAdd[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicAdd[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicAdd[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicAdd[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn subOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicSub[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicSub[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicSub[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicSub[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicSub[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn minOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicMin[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicMin[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicMin[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicMin[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicMin[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn maxOrdered(self &opaq, v T, order MemOrder) T where T is Integer {
    match order {
      case is MemOrder.Relaxed {mem.atomicMax[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicMax[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicMax[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicMax[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicMax[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitAndOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is Bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicAnd[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicAnd[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicAnd[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicAnd[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicAnd[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitOrOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is Bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicOr[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicOr[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicOr[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicOr[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicOr[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }
  pub fn bitXorOrdered(self &opaq, v T, order MemOrder) T where T is Integer or T is Bool {
    match order {
      case is MemOrder.Relaxed {mem.atomicXor[T](self as *T, v, MemOrder.Relaxed[]);}
      case is MemOrder.Acquire {mem.atomicXor[T](self as *T, v, MemOrder.Acquire[]);}
      case is MemOrder.Release {mem.atomicXor[T](self as *T, v, MemOrder.Release[]);}
      case is MemOrder.AcqRel {mem.atomicXor[T](self as *T, v, MemOrder.AcqRel[]);}
      else {mem.atomicXor[T](self as *T, v, MemOrder.SeqCst[]);}
    }
  }

  // 'failure' is the ordering when d is not stored, which is a load: it may
  // be Relaxed, Acquire or SeqCst, and no stronger than 'success'
  pub fn compareSwapOrdered(self &opaq, expected T, desired T,
      success MemOrder, failure MemOrder) T, Bool {
    imm p = self as *T;
    match failure {
      case is MemOrder.Relaxed {
        match success {
          case is MemOrder.Relaxed {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Relaxed[], MemOrder.Relaxed[]);}
          case is MemOrder.Acquire {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Acquire[], MemOrder.Relaxed[]);}
          case is MemOrder.Release {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Release[], MemOrder.Relaxed[]);}
          case is MemOrder.AcqRel {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.AcqRel[], MemOrder.Relaxed[]);}
          else {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.Relaxed[]);}
        }
      }
      case is MemOrder.Acquire {
        match success {
          case is MemOrder.Acquire {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.Acquire[], MemOrder.Acquire[]);}
          case is MemOrder.AcqRel {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.AcqRel[], MemOrder.Acquire[]);}
          case is MemOrder.SeqCst {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.Acquire[]);}
          else {
            panic("core: compareSwapOrdered given an Acquire failure ordering with a success ordering weaker than it");
            mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
          }
        }
      }
      case is MemOrder.SeqCst {
        match success {
          case is MemOrder.SeqCst {mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);}
          else {
            panic("core: compareSwapOrdered given a SeqCst failure ordering with a success ordering weaker than it");
            mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
          }
        }
      }
      else {
        panic("core: compareSwapOrdered given a Release or AcqRel failure ordering, which a compareSwap that stores nothing cannot have");
        mem.atomicCompareSwap[T](p, expected, desired, MemOrder.SeqCst[], MemOrder.SeqCst[]);
      }
    }
  }
}
