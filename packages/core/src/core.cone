// The core package: the prelude. The compiler loads it before any module of the
// program and wildcard-imports it into every module, so its public names are in
// reach everywhere without an 'import'. A compile without a build description
// finds it on the package search path like any package, and nowhere else.
//
// Everything here is 'inline', generic or 'extern', so core's object defines
// nothing. Congo compiles core on its own like any package, and that compile
// generates core's include file, which says what this file says; every package
// Congo compiles after it loads the prelude from that include file, which its
// build description's package line for core names.
//
// The C runtime's allocator is libc's, whose package declares it once for the
// whole program. core imports libc, which, being a C-named module, gets no
// prelude of its own, so the import makes no loop; Congo builds libc before
// core.

mod core;

// libc's 'malloc' is folded in publicly, so it stays a bare name of every
// module, as a region's own allocator writes it; 'libc' itself is not. A module
// that imports libc and folds its names in too meets the same declaration by
// two routes nobody wrote, which is one binding, not a collision
import libc pub use malloc;

pub enum Option[T] {
  struct None {}
  struct Some {pub value T;}
}

pub enum Result[T,E] {
  struct Ok {pub value T;}
  struct Error {pub value E;}
}

// A variant is a name of its enum, so these two statements are what make Some,
// None, Ok and Error bare names of core. They are 'pub', and every module's
// automatic import of core folds its public names, which carries them on into
// every program
pub use Option;
pub use Result;

pub struct @move so {
  fn alloc(size usize) *u8 inline {libc.malloc(size);}
}

pub struct rc {
  cnt usize;
  fn alloc(size usize) *u8 inline {libc.malloc(size);}
  fn init() rc inline {rc[1usize];}
}
