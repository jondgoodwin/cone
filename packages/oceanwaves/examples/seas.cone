// seas: the sea at Beaufort 1, 3, 5, 7 and 9, calm to storm, drawn headless on a real GPU.
//
//   congo run --release packages/oceanwaves/examples/seas.cone -- --out PREFIX
//   GPU_POWER_PREFERENCE=low-power congo run --release ...   (the Intel)
//
// For each sea state it prints the significant wave height the spectrum gives and the surface has, the
// peak period and wavelength, the CPU time of one ocean update (spectrum evolution and four inverse FFTs
// for each of three cascades of 128 x 128) and of the texture upload, the fraction of the surface in foam,
// and the GPU time of drawing the sea (the mean of 30 frames, timestamp queries). With --out it writes
// PREFIX-beaufort<N>.bmp. The camera is 5 m above the mean level at the middle of the sea, looking
// down-wind.

mod seas;

import stdio use *;
import libc;
import time;
import geomath use *;
import collections use *;
import gpu use *;
import render use *;
import path as filepath;
import oceanwaves use *;

fn cstrEquals(a *u8, b &str) bool {
  mut i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8;
}

fn cstrToString(s *u8) String {
  mut r = String.empty();
  mut i = 0usize;
  while *(s + i) != 0u8 { r.appendByte(*(s + i)); i = i + 1usize; }
  r;
}

fn main(argc i32, argv **u8) i32 {
  mut prefix = String.empty();
  mut eyeHeight = 5.;      // --high: a camera 70 m up looking down, to see the waves' pattern
  mut a = 1;
  while a < argc {
    if cstrEquals(*(argv + usize.from(a)), "--out") and a + 1 < argc {
      prefix = cstrToString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(*(argv + usize.from(a)), "--height") and a + 1 < argc {
      mut v = 0.;
      mut i = 0usize;
      imm s = *(argv + usize.from(a + 1));
      while *(s + i) != 0u8 { v = v * 10. + f32.from(*(s + i) - 48u8); i = i + 1usize; }
      eyeHeight = v;
      a = a + 1;
    }
    a = a + 1;
  }
  mut instance = Instance.create("oceanwaves seas");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  if !adapter.isValid() { print <- "No GPU\n"; return 1i32; }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  mut device = adapter.requestDevice();
  imm W = 1280u32;
  imm H = 720u32;
  imm outDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut out = device.createTexture(&outDesc);
  imm depthDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  mut depth = device.createTexture(&depthDesc);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, W, H);
  mut queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32);
  mut resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);
  mut timeBuf = device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  if !renderer.isValid() or !post.isValid() or !queries.isValid() { print <- "renderer failed\n"; return 1i32; }

  mut sky = Sky.dusk(radians(22.), radians(70.));
  sky.sunColor = new Color(30., 27., 22., 1.);
  sky.zenith = new Color(0.14, 0.3, 0.72, 1.);
  sky.horizon = new Color(0.6, 0.72, 0.88, 1.);
  sky.glow = new Color(0.5, 0.4, 0.3, 1.);
  sky.ground = new Color(0.2, 0.25, 0.3, 1.);
  sky.cloudCover = 0.4;
  renderer.setSky(&mut device, &sky);
  imm light = sky.sunLight(new Color(3.2, 3.0, 2.6, 1.), new Color(0.25, 0.3, 0.4, 1.));
  post.exposure = 0.9;
  post.bloom = 0.03;
  imm look = OceanLook.temperate(&sky);

  imm forces = [1, 3, 5, 7, 9];
  mut k = 0usize;
  while k < 5usize {
    imm force = forces[k];
    imm sea = SeaState.beaufort(force, 0.);
    mut ocean = Ocean.make(OceanSpec.withTile(sea, 21u32, 900.));
    // run the ocean up to t = 30 s in 0.5 s steps so the foam has history
    mut t = 0.5d;
    while t <= 30d { ocean.update(t); t = t + 0.5d; }
    imm tU = time.Instant.now();
    mut reps = 0;
    while reps < 10 { ocean.update(30d + 0.05d * f64.from(reps + 1)); reps = reps + 1; }
    imm updateMs = tU.elapsed().secondsF64() * 100d;
    // the height query, as a floating body asks it
    imm tH = time.Instant.now();
    mut hsum = 0.;
    mut hq = 0;
    while hq < 20000 {
      hsum = hsum + ocean.heightAt(f32.from(hq % 200) * 3.1, f32.from(hq / 200) * 2.7);
      hq = hq + 1;
    }
    imm heightUs = tH.elapsed().secondsF64() * 1.0e6d / 20000d;
    imm sprayAll = ocean.sprayAt(0., 0., 150., 0.3, 12usize);
    print <- "\n== Beaufort "; print <- i64.from(force); print <- ": wind "; print <- sea.windSpeed; print <- " m/s ==\n";
    print <- "spectrum Hs "; print <- sea.significantHeight(); print <- " m, expected from the cascades "; print <- ocean.expectedSignificantHeight();
    print <- " m, the surface now 4 rms "; print <- 4. * ocean.rmsHeight(); print <- " m; peak period "; print <- sea.peakPeriod();
    print <- " s, wavelength "; print <- sea.peakWavelength(); print <- " m\n";
    mut foamed = 0usize;
    mut total = 0usize;
    mut below = [0usize, 0usize, 0usize, 0usize];
    mut jmin = 10.;
    mut q = 0usize;
    while q < ocean.cascades[1usize].foam.len() {
      if *ocean.cascades[1usize].foam[q] > 0.3 { foamed = foamed + 1usize; }
      imm j = *ocean.cascades[1usize].jacobian[q];
      if j < jmin { jmin = j; }
      if j < 0. { below[0usize] = below[0usize] + 1usize; }
      if j < 0.35 { below[1usize] = below[1usize] + 1usize; }
      if j < 0.6 { below[2usize] = below[2usize] + 1usize; }
      if j < 0.85 { below[3usize] = below[3usize] + 1usize; }
      total = total + 1usize;
      q = q + 1usize;
    }
    print <- "total Jacobian: smallest "; print <- jmin; print <- "; share of the surface under 0, 0.35, 0.6, 0.85: ";
    print <- 100. * f32.from(below[0usize]) / f32.from(total); print <- ", "; print <- 100. * f32.from(below[1usize]) / f32.from(total);
    print <- ", "; print <- 100. * f32.from(below[2usize]) / f32.from(total); print <- ", "; print <- 100. * f32.from(below[3usize]) / f32.from(total);
    print <- " percent; foam over 0.3 on "; print <- 100. * f32.from(foamed) / f32.from(total); print <- " percent\n";
    mut sr = OceanRenderer.create(&mut renderer, &mut device, &ocean, look);
    if !sr.isValid() { print <- "ocean renderer failed\n"; return 1i32; }
    // the upload: the first after a pause is slow on some drivers, so the median of 31
    mut ups = List[f64].empty();
    mut u = 0;
    while u < 31 {
      sr.upload(&mut renderer, &mut device, &ocean);
      ups.push(sr.uploadSeconds * 1000d);
      u = u + 1;
    }
    mut ui = 1usize;
    while ui < ups.len() {
      mut uj = ui;
      while uj > 0usize and *ups[uj - 1usize] > *ups[uj] { ups.swap(uj - 1usize, uj); uj = uj - 1usize; }
      ui = ui + 1usize;
    }
    imm uploadMs = *ups[ups.len() / 2usize];
    print <- "heightAt: "; print <- heightUs; print <- " us a call (checksum "; print <- hsum; print <- "); spray: "; print <- u64.from(sprayAll.len());
    print <- " spots within 150 m at foam over 0.3";
    if sprayAll.len() > 0usize { print <- ", the freshest "; print <- sprayAll[0usize].strength; }
    print <- "\n";
    print <- "CPU: ocean update "; print <- updateMs; print <- " ms, texture upload "; print <- uploadMs; print <- " ms\n";

    mut camera = Camera.make();
    camera.fov = radians(60.);
    camera.near = 0.3;
    camera.far = 30000.;
    camera.background = new Color(0.4, 0.55, 0.8, 1.);
    imm eye = new Vec3(0., eyeHeight + ocean.heightAt(0., 0.), 0.);
    camera.lookAt(eye, new Vec3(100., 1., 20.), new Vec3(0., 1., 0.));
    mut list = DrawList.empty();
    sr.addToList(&mut list, eye.x, eye.z);

    mut samples = List[f64].empty();
    mut f = 0u32;
    while f < 130u32 {
      mut encoder = device.createCommandEncoder();
      encoder.writeTimestamp(&queries, 0u32);
      renderer.render(&mut device, &mut encoder, &post.hdr, &depth, &camera, &light, &list);
      encoder.writeTimestamp(&queries, 1u32);
      post.apply(&mut encoder, &out);
      encoder.resolveQuerySet(&queries, 0u32, 2u32, &resolved, 0u64);
      encoder.copyBufferToBuffer(&resolved, 0u64, &timeBuf, 0u64, 16u64);
      device.queue.submit(encoder.finish());
      device.endFrame();
      device.waitIdle();
      if f >= 30u32 {
        imm ticks = timeBuf.mappedRange() as *u64;
        samples.push(f64.from(*(ticks + 1usize) - *ticks) * f64.from(device.timestampPeriod) * 1.0e-6d);
      }
      f = f + 1u32;
    }
    mut si = 1usize;
    while si < samples.len() {
      mut sj = si;
      while sj > 0usize and *samples[sj - 1usize] > *samples[sj] { samples.swap(sj - 1usize, sj); sj = sj - 1usize; }
      si = si + 1usize;
    }
    print <- "GPU: draw p50 "; print <- *samples[samples.len() / 2usize]; print <- " ms (min "; print <- *samples[0usize]; print <- ", max ";
    print <- *samples[samples.len() - 1usize]; print <- ") over 100 frames\n";
    if prefix.len() > 0usize {
      mut shot = device.createBuffer(u64.from(W) * u64.from(H) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
      mut encoder = device.createCommandEncoder();
      renderer.render(&mut device, &mut encoder, &post.hdr, &depth, &camera, &light, &list);
      post.apply(&mut encoder, &out);
      encoder.copyTextureToBuffer(&out, &shot);
      device.queue.submit(encoder.finish());
      device.endFrame();
      device.waitIdle();
      imm image = Image.fromTexels(shot.mappedRange(), i32.from(W), i32.from(H), false);
      mut name = prefix.copy();
      name <- "-beaufort"; name.appendInt(i64.from(force)); name <- ".bmp";
      image.save(&filepath.Path.from(name.view()));
      print <- "wrote "; printStr(name.view()); print <- "\n";
    }
    k = k + 1usize;
  }
  print <- "\nVulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  0i32;
}
