// ======== Drawing the ocean through render ========
//
// An OceanRenderer makes render's custom pipeline (render/src/custom.cone) from ocean.slang, uploads the
// cascades' fields as r32float textures each frame ('upload'), and keeps two meshes of vertices at rest:
// a fine square of 1.3 m cells round the camera, which the waves displace, and a coarse ring of 48 m
// cells out to 6 km, which they do not (the displacement fades to nothing before the fine square's edge
// and the ring is flat; the slopes and foam still shade it, so the far sea has waves in its colour). Both
// are moved to the camera's cell each frame in whole cells of the coarse grid, so a vertex never moves
// in the world's coordinates and the waves do not swim. A scene draws them with 'addToList'.
//
// It needs three cascades of one size (OceanSpec.forSea makes them).

pub const NEAR_HALF = 336f32;        // the fine square's half side, m: 7 coarse cells
pub const FAR_CELL = 48f32;
const FAR_CELLS = 256;               // the coarse grid's cells a side (12.3 km)
const NEAR_CELLS = 512;              // the fine square's cells a side (1.3125 m)

// How the sea looks (display units, as render's lights are)
pub struct OceanLook {
  pub sunDirection Vec3;       // toward the sun, unit
  pub sunGlint Color;          // the sun's glint in the water
  pub skyZenith Color;         // what the water reflects overhead
  pub skyHorizon Color;        // and along the horizon, where it fogs to
  pub deep Color;              // the body of the water
  pub shallow Color;           // seen through a crest
  pub foamBrightness f32;      // 1 as made; above 1 more of the surface counts as foam
  pub fogDensity f32;          // 1 / m: the distance at which the sea has become the horizon's colour

  pub fn temperate(sky &Sky) OceanLook {
    new OceanLook(sky.sunDirection, new Color(4., 3.7, 3., 1.), sky.zenith, sky.horizon, new Color(0.012, 0.075, 0.105, 1.),
      new Color(0.1, 0.42, 0.34, 1.), 1., 0.00018)
  }
}

pub struct OceanRenderer {
  pub pipeline PipelineHandle;
  pub material MaterialHandle;
  pub near MeshHandle;
  pub far MeshHandle;
  pub height TextureHandle;
  pub dispX TextureHandle;
  pub dispZ TextureHandle;
  pub slopeX TextureHandle;
  pub slopeZ TextureHandle;
  pub foam TextureHandle;
  pub look OceanLook;
  n usize;
  stage List[f32];
  pub uploadSeconds f64;

  // The renderer's resources for 'ocean'; check 'isValid'
  pub fn create(renderer &mut Renderer, device &mut Device, ocean &Ocean, look OceanLook) OceanRenderer {
    let n = ocean.cascades[0usize].spec.n;
    let textures = [TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT, TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT, TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT,
      TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT, TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT, TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT];
    let desc = new CustomPipeline(spirv: &OCEAN_SPIRV, textures: &textures, streams: 1u32, paramBytes: 160u64,
      cullMode: CULL_MODE_NONE);
    let pipeline = renderer.addPipeline(device, &desc);
    var zero = List[f32].withCapacity(3usize * n * n);
    zero.resize(3usize * n * n, 0.);
    let h = renderer.addFieldTexture(device, u32.from(3usize * n), u32.from(n), zero.view());
    let dx = renderer.addFieldTexture(device, u32.from(3usize * n), u32.from(n), zero.view());
    let dz = renderer.addFieldTexture(device, u32.from(3usize * n), u32.from(n), zero.view());
    let sx = renderer.addFieldTexture(device, u32.from(3usize * n), u32.from(n), zero.view());
    let sz = renderer.addFieldTexture(device, u32.from(3usize * n), u32.from(n), zero.view());
    let fm = renderer.addFieldTexture(device, u32.from(3usize * n), u32.from(n), zero.view());
    let maps = [h, dx, dz, sx, sz, fm];
    let params = paramsOf(ocean, &look);
    let material = renderer.addCustomMaterial(device, pipeline, params.view(), &maps);
    let nearMesh = renderer.addMesh(device, &gridMesh(NEAR_HALF, NEAR_CELLS, 0.));
    let farMesh = renderer.addMesh(device, &gridMesh(FAR_CELL * f32.from(FAR_CELLS) * 0.5, FAR_CELLS, NEAR_HALF));
    new OceanRenderer(pipeline, material, nearMesh, farMesh, h, dx, dz, sx, sz, fm, look, n, List[f32].empty(), 0.0)
  }

  pub fn isValid(self &) bool { !material.isNone() && !near.isNone() && !far.isNone() }

  // Write the cascades' present fields into the textures, and the parameters (the look, the sea's size)
  pub fn upload(self &mut, renderer &mut Renderer, device &mut Device, ocean &Ocean) {
    let t0 = time.Instant.now();
    let total = 3usize * n * n;
    stage.resize(total, 0.);
    var field = 0;
    while field < 6 {
      var c = 0usize;
      while c < 3usize {
        let cs = ocean.cascades[c];
        let src = if field == 0 { cs.height.view() } elif field == 1 { cs.dispX.view() } elif field == 2 { cs.dispZ.view() }
          elif field == 3 { cs.slopeX.view() } elif field == 4 { cs.slopeZ.view() } else { cs.foam.view() };
        var z = 0usize;
        while z < n {
          var x = 0usize;
          while x < n {
            stage.set(z * 3usize * n + c * n + x, src[z * n + x]);
            x = x + 1usize;
          }
          z = z + 1usize;
        }
        c = c + 1usize;
      }
      let handle = if field == 0 { height } elif field == 1 { dispX } elif field == 2 { dispZ }
        elif field == 3 { slopeX } elif field == 4 { slopeZ } else { foam };
      renderer.writeFieldTexture(device, handle, stage.view());
      field = field + 1;
    }
    let params = paramsOf(ocean, &look);
    renderer.setCustomParams(device, material, params.view());
    uploadSeconds = t0.elapsed().secondsF64();
  }

  // Add the sea to a draw list for a camera at (x, z)
  pub fn addToList(self &, list &mut DrawList, x f32, z f32) {
    let sx = libc.floorf(x / FAR_CELL) * FAR_CELL;
    let sz = libc.floorf(z / FAR_CELL) * FAR_CELL;
    list.add(near, material, Mat4.fromTranslation(new Vec3(sx, 0., sz)));
    list.add(far, material, Mat4.fromTranslation(new Vec3(sx, 0., sz)));
  }
}

// The material's parameters as ocean.slang's Params has them
fn paramsOf(ocean &Ocean, look &OceanLook) List[f32] {
  let cs = &ocean.cascades;
  let n = f32.from(cs[0usize].spec.n);
  // how much each cascade displaces the vertices: by the mesh's spacing (1.3 m): a wave needs 4 vertices
  // across its shortest wavelength to be moved, fading in from 2 to 4 vertices a wavelength
  var lod = [0.f, 0., 0.];
  var c = 0usize;
  while c < 3usize {
    let shortest = 6.28318530718 / cs[c].spec.kMax;
    let vertices = shortest / (2. * NEAR_HALF / f32.from(NEAR_CELLS));
    lod[c] = fclampf((vertices - 2.) / 2., 0., 1.);
    c = c + 1usize;
  }
  var p = List[f32].withCapacity(40usize);
  p.push(cs[0usize].spec.length); p.push(cs[1usize].spec.length); p.push(cs[2usize].spec.length); p.push(n);
  p.push(look.sunDirection.x); p.push(look.sunDirection.y); p.push(look.sunDirection.z); p.push(0.);
  p.push(look.sunGlint.red); p.push(look.sunGlint.green); p.push(look.sunGlint.blue); p.push(0.);
  p.push(look.skyZenith.red); p.push(look.skyZenith.green); p.push(look.skyZenith.blue); p.push(0.);
  p.push(look.skyHorizon.red); p.push(look.skyHorizon.green); p.push(look.skyHorizon.blue); p.push(0.);
  p.push(look.deep.red); p.push(look.deep.green); p.push(look.deep.blue); p.push(0.);
  p.push(look.shallow.red); p.push(look.shallow.green); p.push(look.shallow.blue); p.push(0.);
  p.push(ocean.spec.choppiness); p.push(fclampf(ocean.expectedSignificantHeight(), 0.05, 100.)); p.push(NEAR_HALF * 0.62); p.push(NEAR_HALF * 0.97);
  p.push(look.foamBrightness); p.push(look.fogDensity); p.push(2. * NEAR_HALF / f32.from(NEAR_CELLS)); p.push(0.);
  p.push(lod[0usize]); p.push(lod[1usize]); p.push(lod[2usize]); p.push(0.);
  p
}

// A square grid of cells (positions at y = 0, normal up, uv 0) from -half to +half each way, with the
// middle square of half side 'hole' left out (0: none)
fn gridMesh(half f32, cells i32, hole f32) Mesh {
  var m = Mesh.empty();
  let step = 2. * half / f32.from(cells);
  var j = 0;
  while j <= cells {
    var i = 0;
    while i <= cells {
      m.positions.push(new Vec3(-half + f32.from(i) * step, 0., -half + f32.from(j) * step));
      m.normals.push(new Vec3(0., 1., 0.));
      m.uvs.push(new Vec2(0., 0.));
      i = i + 1;
    }
    j = j + 1;
  }
  j = 0;
  while j < cells {
    var i = 0;
    while i < cells {
      let cx = -half + (f32.from(i) + 0.5) * step;
      let cz = -half + (f32.from(j) + 0.5) * step;
      let inside = hole > 0. && libc.fabsf(cx) < hole && libc.fabsf(cz) < hole;
      if !inside {
        let a = u32.from(j * (cells + 1) + i);
        let b = a + 1u32;
        let c = a + u32.from(cells + 1);
        let d = c + 1u32;
        m.indices.push(a); m.indices.push(c); m.indices.push(b);
        m.indices.push(b); m.indices.push(c); m.indices.push(d);
      }
      i = i + 1;
    }
    j = j + 1;
  }
  m
}

