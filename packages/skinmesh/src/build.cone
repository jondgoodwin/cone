// ======== Growing the skin ========

pub const SkinCapFlat = 0u32;   // an end closed by one quad
pub const SkinCapDome = 1u32;   // an end closed by a rounded cap: a smaller ring beyond it, then one quad

// How the skin is built
pub struct SkinOptions {
  pub cuts u32;          // extra rings along each edge, evenly spaced (0: none)
  pub cap u32;           // SkinCapFlat or SkinCapDome
  pub smooth f32;        // at a smooth branch, the rings stand this many radii further out
  pub gap f32;           // at a loose joint, the radii from the node to its rings
  pub mitreLimit f32;    // the most a ring is widened at a bend (1 / cos of half the turn)

  pub fn standard() SkinOptions { new SkinOptions(0u32, SkinCapFlat, 0.15, 0.5, 2.); }
}

// What a skin is: the mesh, the bones, the vertex weights and a list of what
// could not be done as asked
pub struct Skin {
  pub mesh PolyMesh;
  pub rig Armature;
  pub weights SkinWeights;
  pub problems List[String];
  pub limbs u32;
  pub triangles u32;      // faces of 3 at the junctions, left when no neighbour could join them
}

const NoNode = 0xFFFFFFFFu32;

fn maxF(a f32, b f32) f32 { if a > b {a;} else {b;}; }
fn minF(a f32, b f32) f32 { if a < b {a;} else {b;}; }

// v without its part along d (d unit)
fn without(v Vec3, d Vec3) Vec3 { v - d * v.dot(d); }

// A unit direction near 'want' square to d; (0, 0, 0) if want lies along d
fn squareTo(want Vec3, d Vec3) Vec3 {
  imm w = without(want, d);
  imm len = w.length();
  if len > 0.001 * want.length() and len > 0.0000001 { w * (1. / len); } else { new Vec3(0., 0., 0.); };
}

// The corner k (0 to 3) of a ring at c: counterclockwise about x cross z ... about the
// axis the frame was made square to, x along the frame's x, z = x cross axis. The corners
// are (+x, -z), (-x, -z), (-x, +z), (+x, +z) times the half-extents.
fn ringCorner(k usize, c Vec3, x Vec3, z Vec3, rx f32, rz f32) Vec3 {
  imm sx = if k == 0usize or k == 3usize {1.;} else {-1.;};
  imm sz = if k >= 2usize {1.;} else {-1.;};
  c + x * (sx * rx) + z * (sz * rz);
}

// Everything the build keeps while it works
struct Builder {
  // The graph, read once
  g SkinGraph;
  opt SkinOptions;
  problems List[String];
  // Adjacency of the usable edges, by node
  adjStart List[u32];
  adjEdges List[u32];
  usable List[bool];
  // Each edge as grown from the root: start and end node, direction, ring x axis, length
  eStart List[u32];
  eEnd List[u32];
  eDir List[Vec3];
  eX List[Vec3];
  eLen List[f32];
  eLimb List[u32];
  eAlong0 List[f32];       // distance along its limb at the edge's start
  limbLen List[f32];
  nParent List[u32];       // the edge that reached the node (NoNode: a root)
  nRoot List[bool];
  order List[u32];         // the oriented edges in the order they were reached
  // Rings: 4 consecutive vertices each, ring r at vertices 4r to 4r + 3
  ringCentre List[Vec3];
  ringNormal List[Vec3];
  // The two rings (ring numbers) at each end of an edge: [2e] its start, [2e + 1] its end
  endRing List[u32];
  // Vertices
  pos List[Vec3];
  vAlong List[f32];
  vAround List[f32];
  vLimb List[f32];
  vOwner List[u32];        // the edge whose bone moves it most
  vOther List[u32];        // the edge whose bone shares it (NoNode: none)
  vW List[f32];            // that other bone's share
  // Faces
  fCount List[u32];
  fIdx List[u32];
  fUv List[Vec2];
  triangles u32;

  fn make(g SkinGraph, opt SkinOptions) Builder {
    new Builder(g, opt, List[String].empty(), List[u32].empty(), List[u32].empty(), List[bool].empty(),
      List[u32].empty(), List[u32].empty(), List[Vec3].empty(), List[Vec3].empty(), List[f32].empty(),
      List[u32].empty(), List[f32].empty(), List[f32].empty(), List[u32].empty(), List[bool].empty(),
      List[u32].empty(), List[Vec3].empty(), List[Vec3].empty(), List[u32].empty(),
      List[Vec3].empty(), List[f32].empty(), List[f32].empty(), List[f32].empty(), List[u32].empty(),
      List[u32].empty(), List[f32].empty(), List[u32].empty(), List[u32].empty(), List[Vec2].empty(), 0u32);
  }

  fn degree(self &, n u32) usize { usize.from(*adjStart[usize.from(n) + 1usize] - *adjStart[usize.from(n)]); }
  fn incident(self &, n u32, i usize) u32 { *adjEdges[usize.from(*adjStart[usize.from(n)]) + i]; }
  fn isLoose(self &, n u32) bool { (*g.flags[usize.from(n)] & SkinLoose) != 0u32; }

  // The node at the other end of edge e from n
  fn otherEnd(self &, e u32, n u32) u32 {
    if *g.edgeA[usize.from(e)] == n { *g.edgeB[usize.from(e)]; } else { *g.edgeA[usize.from(e)]; };
  }

  // The unit direction from node n along edge e, away from n
  fn awayFrom(self &, n u32, e u32) Vec3 {
    (*g.position[usize.from(self.otherEnd(e, n))] - *g.position[usize.from(n)]).normalize();
  }

  // ---- the usable edges, and their growth from the roots ----

  fn adjacency(self &mut) {
    imm nn = g.position.len();
    imm ne = g.edgeA.len();
    mut count = List[u32].empty();
    mut i = 0usize;
    while i < nn { count.push(0u32); i = i + 1usize; }
    i = 0usize;
    while i < ne {
      imm a = *g.edgeA[i];
      imm b = *g.edgeB[i];
      mut ok = usize.from(a) < nn and usize.from(b) < nn and a != b;
      if ok {
        ok = (*g.position[usize.from(b)] - *g.position[usize.from(a)]).length() > 0.000001;
      }
      if !ok {
        mut s = String.from("edge ");
        s.appendUInt(u64.from(i));
        s.append(" joins a node to itself, joins a missing node or has no length; it is left out");
        problems.push(s);
      }
      usable.push(ok);
      if ok {
        count.set(usize.from(a), *count[usize.from(a)] + 1u32);
        count.set(usize.from(b), *count[usize.from(b)] + 1u32);
      }
      i = i + 1usize;
    }
    adjStart.push(0u32);
    i = 0usize;
    while i < nn {
      adjStart.push(*adjStart[i] + *count[i]);
      i = i + 1usize;
    }
    i = 0usize;
    while i < usize.from(*adjStart[nn]) { adjEdges.push(0u32); i = i + 1usize; }
    mut fill = List[u32].empty();
    i = 0usize;
    while i < nn { fill.push(0u32); i = i + 1usize; }
    i = 0usize;
    while i < ne {
      if *usable[i] {
        imm a = usize.from(*g.edgeA[i]);
        imm b = usize.from(*g.edgeB[i]);
        adjEdges.set(usize.from(*adjStart[a] + *fill[a]), u32.from(i));
        fill.set(a, *fill[a] + 1u32);
        adjEdges.set(usize.from(*adjStart[b] + *fill[b]), u32.from(i));
        fill.set(b, *fill[b] + 1u32);
      }
      i = i + 1usize;
    }
  }

  // Orient every usable edge away from its tree's root, in breadth-first order,
  // and give it its ring x axis: the start node's hint, else the parent edge's
  // axis turned with the least rotation to this edge, else the world x (or z)
  fn grow(self &mut) {
    imm nn = g.position.len();
    imm ne = g.edgeA.len();
    mut i = 0usize;
    while i < ne {
      eStart.push(NoNode);
      eEnd.push(NoNode);
      eDir.push(new Vec3(0., 0., 1.));
      eX.push(new Vec3(1., 0., 0.));
      eLen.push(0.);
      eLimb.push(0u32);
      eAlong0.push(0.);
      i = i + 1usize;
    }
    mut visited = List[bool].empty();
    i = 0usize;
    while i < nn {
      visited.push(false);
      nParent.push(NoNode);
      nRoot.push(false);
      i = i + 1usize;
    }
    mut pass = 0usize;
    while pass < 2usize {
      i = 0usize;
      while i < nn {
        imm wanted = if pass == 0usize {(*g.flags[i] & SkinRoot) != 0u32;} else {true;};
        if wanted and !*visited[i] {
          visited.set(i, true);
          nRoot.set(i, true);
          self.growFrom(u32.from(i), &mut visited);
        }
        i = i + 1usize;
      }
      pass = pass + 1usize;
    }
    // Limbs: a run of edges through nodes of degree two that are not roots
    mut limbs = 0u32;
    mut o = 0usize;
    while o < order.len() {
      imm e = usize.from(*order[o]);
      imm u = *eStart[e];
      imm p = *nParent[usize.from(u)];
      if p != NoNode and self.degree(u) == 2usize and !*nRoot[usize.from(u)] {
        eLimb.set(e, *eLimb[usize.from(p)]);
        eAlong0.set(e, *eAlong0[usize.from(p)] + *eLen[usize.from(p)]);
      } else {
        eLimb.set(e, limbs);
        eAlong0.set(e, 0.);
        limbs = limbs + 1u32;
        limbLen.push(0.);
      }
      imm l = usize.from(*eLimb[e]);
      limbLen.set(l, maxF(*limbLen[l], *eAlong0[e] + *eLen[e]));
      o = o + 1usize;
    }
  }

  fn growFrom(self &mut, root u32, visited &mut List[bool]) {
    mut queue = List[u32].empty();
    queue.push(root);
    mut head = 0usize;
    while head < queue.len() {
      imm u = *queue[head];
      head = head + 1usize;
      mut i = 0usize;
      while i < self.degree(u) {
        imm e = self.incident(u, i);
        i = i + 1usize;
        if *eStart[usize.from(e)] == NoNode {
          imm v = self.otherEnd(e, u);
          eStart.set(usize.from(e), u);
          eEnd.set(usize.from(e), v);
          imm d = self.awayFrom(u, e);
          eDir.set(usize.from(e), d);
          eLen.set(usize.from(e), (*g.position[usize.from(v)] - *g.position[usize.from(u)]).length());
          // The ring x axis
          mut x = squareTo(*g.hint[usize.from(u)], d);
          if x.lengthSquared() == 0. {
            imm p = *nParent[usize.from(u)];
            if p != NoNode {
              imm turned = Quat.fromVectors(*eDir[usize.from(p)], d) * *eX[usize.from(p)];
              x = squareTo(turned, d);
            }
          }
          if x.lengthSquared() == 0. { x = squareTo(new Vec3(1., 0., 0.), d); }
          if x.lengthSquared() == 0. { x = squareTo(new Vec3(0., 0., 1.), d); }
          eX.set(usize.from(e), x);
          order.push(e);
          if *visited[usize.from(v)] {
            mut s = String.from("edge ");
            s.appendUInt(u64.from(e));
            s.append(" closes a cycle; the skin is built as if it did not, and its rings may twist");
            problems.push(s);
          } else {
            visited.set(usize.from(v), true);
            nParent.set(usize.from(v), e);
            queue.push(v);
          }
        }
      }
    }
  }

  // ---- vertices, rings, faces ----

  // The along value of the point the fraction s of the way along edge e
  fn alongOf(self &, e u32, s f32) f32 {
    imm l = usize.from(*eLimb[usize.from(e)]);
    imm total = *limbLen[l];
    if total > 0. { (*eAlong0[usize.from(e)] + s * *eLen[usize.from(e)]) / total; } else { 0.; };
  }

  // A ring of 4 vertices: its number. Centre c, the frame (x, axis) it is
  // counterclockwise about, the half-extents; the vertices belong to edge e
  // (their along from the fraction s of it), shared with edge 'other' by w
  fn addRing(self &mut, c Vec3, x Vec3, axis Vec3, rx f32, rz f32, mitre Vec3, mitreBy f32,
      e u32, s f32, other u32, w f32) u32 {
    imm z = x.cross(axis);
    imm along = self.alongOf(e, s);
    mut k = 0usize;
    while k < 4usize {
      mut p = ringCorner(k, c, x, z, rx, rz);
      if mitreBy != 1. {
        imm off = p - c;
        p = c + off + mitre * (off.dot(mitre) * (mitreBy - 1.));
      }
      pos.push(p);
      vAlong.push(along);
      vAround.push(f32.from(k) * 0.25);
      vLimb.push(f32.from(*eLimb[usize.from(e)]));
      vOwner.push(e);
      vOther.push(other);
      vW.push(w);
      k = k + 1usize;
    }
    ringCentre.push(c);
    ringNormal.push(axis);
    u32.from(ringCentre.len() - 1usize);
  }

  fn setEndRing(self &mut, e u32, atEnd bool, ring u32) {
    endRing.set(2usize * usize.from(e) + if atEnd {1usize;} else {0usize;}, ring);
  }

  fn ringAt(self &, e u32, atEnd bool) u32 {
    *endRing[2usize * usize.from(e) + if atEnd {1usize;} else {0usize;}];
  }

  // Ring r's corner k as seen counterclockwise about 'forward' after skipping
  // 'shift' corners
  fn cornerOf(self &, r u32, flip bool, shift usize, k usize) u32 {
    imm m = (k + shift) % 4usize;
    4u32 * r + u32.from(if flip {(4usize - m) % 4usize;} else {m;});
  }

  fn addFace(self &mut, vs &List[u32], uvs &List[Vec2]) {
    fCount.push(u32.from(vs.len()));
    mut i = 0usize;
    while i < vs.len() {
      fIdx.push(*vs[i]);
      fUv.push(*uvs[i]);
      i = i + 1usize;
    }
  }

  // A face by vertices, each given its own (around, along) as its uv
  fn addFaceVerts(self &mut, vs &List[u32]) {
    mut uvs = List[Vec2].empty();
    mut i = 0usize;
    while i < vs.len() {
      imm v = usize.from(*vs[i]);
      uvs.push(new Vec2(*vAround[v], *vAlong[v]));
      i = i + 1usize;
    }
    self.addFace(vs, &uvs);
  }

  // A band of quads from ring u to ring v, with 'cuts' rings between them
  // (made here, belonging to edge e, blending with 'nbStart' near the start
  // and 'nbEnd' near the end), no twist: the corner of v met by corner 0 of u
  // is the nearest. The vertices of the end rings are theirs already.
  fn tube(self &mut, u u32, v u32, cuts u32, e u32, nbStart u32, nbEnd u32) {
    imm cu = *ringCentre[usize.from(u)];
    imm cv = *ringCentre[usize.from(v)];
    imm fwd = cv - cu;
    imm flipU = (*ringNormal[usize.from(u)]).dot(fwd) < 0.;
    imm flipV = (*ringNormal[usize.from(v)]).dot(fwd) < 0.;
    // The shift of v's corners that makes the band least twisted
    mut best = 0usize;
    mut bestCost = 1000000000.;
    mut sh = 0usize;
    while sh < 4usize {
      mut cost = 0.;
      mut k = 0usize;
      while k < 4usize {
        imm a = *pos[usize.from(self.cornerOf(u, flipU, 0usize, k))];
        imm b = *pos[usize.from(self.cornerOf(v, flipV, sh, k))];
        cost = cost + a.distanceSquared(b);
        k = k + 1usize;
      }
      if cost < bestCost - 0.0000001 { bestCost = cost; best = sh; }
      sh = sh + 1usize;
    }
    // The rings from u to v
    mut rings = List[u32].empty();
    mut shifts = List[usize].empty();
    mut flips = List[bool].empty();
    rings.push(u);
    shifts.push(0usize);
    flips.push(flipU);
    imm n = usize.from(cuts);
    mut i = 1usize;
    while i <= n {
      imm s = f32.from(i) / f32.from(n + 1usize);
      imm base = u32.from(pos.len());
      imm au = *vAlong[usize.from(4u32 * u)];
      imm av = *vAlong[usize.from(4u32 * v)];
      mut k = 0usize;
      while k < 4usize {
        imm a = *pos[usize.from(self.cornerOf(u, flipU, 0usize, k))];
        imm b = *pos[usize.from(self.cornerOf(v, flipV, best, k))];
        pos.push(a.lerp(b, s));
        vAlong.push(au + (av - au) * s);
        vAround.push(f32.from(k) * 0.25);
        vLimb.push(*vLimb[usize.from(4u32 * u)]);
        vOwner.push(e);
        if s < 0.5 { vOther.push(nbStart); vW.push(if nbStart == NoNode {0.;} else {0.5 - s;}); }
        else { vOther.push(nbEnd); vW.push(if nbEnd == NoNode {0.;} else {s - 0.5;}); }
        k = k + 1usize;
      }
      ringCentre.push(cu.lerp(cv, s));
      ringNormal.push(fwd.normalize());
      rings.push(u32.from(ringCentre.len() - 1usize));
      shifts.push(0usize);
      flips.push(false);
      i = i + 1usize;
    }
    rings.push(v);
    shifts.push(best);
    flips.push(flipV);
    // The quads
    mut r = 0usize;
    while r + 1usize < rings.len() {
      imm r0 = *rings[r];
      imm r1 = *rings[r + 1usize];
      mut k = 0usize;
      while k < 4usize {
        mut vs = List[u32].empty();
        vs.push(self.cornerOf(r0, *flips[r], *shifts[r], k));
        vs.push(self.cornerOf(r0, *flips[r], *shifts[r], k + 1usize));
        vs.push(self.cornerOf(r1, *flips[r + 1usize], *shifts[r + 1usize], k + 1usize));
        vs.push(self.cornerOf(r1, *flips[r + 1usize], *shifts[r + 1usize], k));
        mut uvs = List[Vec2].empty();
        imm v0 = *vAlong[usize.from(4u32 * r0)];
        imm v1 = *vAlong[usize.from(4u32 * r1)];
        uvs.push(new Vec2(f32.from(k) * 0.25, v0));
        uvs.push(new Vec2(f32.from(k + 1usize) * 0.25, v0));
        uvs.push(new Vec2(f32.from(k + 1usize) * 0.25, v1));
        uvs.push(new Vec2(f32.from(k) * 0.25, v1));
        self.addFace(&vs, &uvs);
        k = k + 1usize;
      }
      r = r + 1usize;
    }
  }

  // A cap: one quad closing ring r on the side 'out' (a direction)
  fn capQuad(self &mut, r u32, out Vec3) {
    imm flip = (*ringNormal[usize.from(r)]).dot(out) < 0.;
    mut vs = List[u32].empty();
    mut k = 0usize;
    while k < 4usize {
      vs.push(self.cornerOf(r, flip, 0usize, k));
      k = k + 1usize;
    }
    self.addFaceVerts(&vs);
  }

  // The end of a tube closed: flat, or by a dome
  fn closeEnd(self &mut, r u32, out Vec3, e u32, rx f32, rz f32) {
    if opt.cap == SkinCapDome {
      imm c = *ringCentre[usize.from(r)];
      imm h = 0.6 * (rx + rz) * 0.5;
      imm sc = 0.65;
      imm along = *vAlong[usize.from(4u32 * r)];
      mut k = 0usize;
      while k < 4usize {
        imm p = *pos[usize.from(4u32 * r) + k];
        pos.push(c + out * h + (p - c) * sc);
        vAlong.push(along);
        vAround.push(f32.from(k) * 0.25);
        vLimb.push(*vLimb[usize.from(4u32 * r)]);
        vOwner.push(e);
        vOther.push(NoNode);
        vW.push(0.);
        k = k + 1usize;
      }
      ringCentre.push(c + out * h);
      ringNormal.push(*ringNormal[usize.from(r)]);
      imm d = u32.from(ringCentre.len() - 1usize);
      self.tube(r, d, 0u32, e, NoNode, NoNode);
      self.capQuad(d, out);
    } else {
      self.capQuad(r, out);
    }
  }

  // ---- the nodes ----

  // The edge whose bone shares the ring that edge e has at node n (NoNode: none)
  fn partner(self &, n u32, e u32) u32 {
    imm deg = self.degree(n);
    if deg == 2usize and !self.isLoose(n) and self.turnOk(n) {
      imm a = self.incident(n, 0usize);
      if a == e { self.incident(n, 1usize); } else { a; };
    } elif deg >= 3usize and *eStart[usize.from(e)] == n { *nParent[usize.from(n)]; }
    else { NoNode; };
  }

  // A node of degree two whose two edges do not fold back on each other
  fn turnOk(self &, n u32) bool {
    imm q1 = self.awayFrom(n, self.incident(n, 0usize));
    imm q2 = self.awayFrom(n, self.incident(n, 1usize));
    q1.dot(q2) < 0.9998;
  }

  fn node(self &mut, n u32) {
    imm deg = self.degree(n);
    imm rx = *g.radiusX[usize.from(n)];
    imm rz = *g.radiusZ[usize.from(n)];
    imm c = *g.position[usize.from(n)];
    if deg == 0usize {
      self.isolated(n);
    } elif deg == 1usize {
      imm e = self.incident(n, 0usize);
      imm atEnd = *eEnd[usize.from(e)] == n;
      imm s = if atEnd {1.;} else {0.;};
      imm r = self.addRing(c, *eX[usize.from(e)], *eDir[usize.from(e)], rx, rz, new Vec3(0., 0., 0.), 1., e, s, NoNode, 0.);
      self.setEndRing(e, atEnd, r);
    } elif deg == 2usize {
      self.joint(n);
    } else {
      self.junction(n);
    }
  }

  // A lone node: a box
  fn isolated(self &mut, n u32) {
    imm c = *g.position[usize.from(n)];
    imm rx = *g.radiusX[usize.from(n)];
    imm rz = *g.radiusZ[usize.from(n)];
    imm ry = 0.5 * (rx + rz);
    // Two rings, counterclockwise about +y, bottom and top
    imm x = new Vec3(1., 0., 0.);
    imm up = new Vec3(0., 1., 0.);
    imm z = x.cross(up);
    imm lo = self.loneRing(c - up * ry, x, z, rx, rz, up);
    imm hi = self.loneRing(c + up * ry, x, z, rx, rz, up);
    self.tube(lo, hi, 0u32, NoNode, NoNode, NoNode);
    self.capQuad(lo, up * -1.);
    self.capQuad(hi, up);
  }

  fn loneRing(self &mut, c Vec3, x Vec3, z Vec3, rx f32, rz f32, axis Vec3) u32 {
    mut k = 0usize;
    while k < 4usize {
      pos.push(ringCorner(k, c, x, z, rx, rz));
      vAlong.push(0.);
      vAround.push(f32.from(k) * 0.25);
      vLimb.push(-1.);
      vOwner.push(NoNode);
      vOther.push(NoNode);
      vW.push(0.);
      k = k + 1usize;
    }
    ringCentre.push(c);
    ringNormal.push(axis);
    u32.from(ringCentre.len() - 1usize);
  }

  // A node with two edges
  fn joint(self &mut, n u32) {
    imm e1 = self.incident(n, 0usize);
    imm e2 = self.incident(n, 1usize);
    // The parent edge first, if there is one
    imm first = if *eEnd[usize.from(e2)] == n and *eEnd[usize.from(e1)] != n {e2;} else {e1;};
    imm second = if first == e1 {e2;} else {e1;};
    imm rx = *g.radiusX[usize.from(n)];
    imm rz = *g.radiusZ[usize.from(n)];
    imm c = *g.position[usize.from(n)];
    imm q1 = self.awayFrom(n, first);
    imm q2 = self.awayFrom(n, second);
    imm fold = (q1 + q2).length();
    imm loose = self.isLoose(n) or q1.dot(q2) >= 0.9998;
    if !loose {
      // One ring in the plane that bisects the bend
      imm t = (q2 - q1).normalize();
      imm din = q1 * -1.;
      mut x = squareTo(*g.hint[usize.from(n)], t);
      if x.lengthSquared() == 0. {
        x = squareTo(Quat.fromVectors(din, t) * *eX[usize.from(first)], t);
      }
      if x.lengthSquared() == 0. { x = squareTo(*eX[usize.from(first)], t); }
      if x.lengthSquared() == 0. { x = squareTo(new Vec3(1., 0., 0.), t); }
      if x.lengthSquared() == 0. { x = squareTo(new Vec3(0., 0., 1.), t); }
      // Widen the ring along the bend so the tube keeps its thickness: 1 / cos of half the turn
      imm cosTurn = din.dot(q2);
      imm half = ((1. + cosTurn) * 0.5).sqrt();
      mut mitre = if half > 0.001 {1. / half;} else {opt.mitreLimit;};
      if mitre > opt.mitreLimit { mitre = opt.mitreLimit; }
      imm m = (q1 + q2).normalize();
      imm r = self.addRing(c, x, t, rx, rz, m, if fold < 0.0001 {1.;} else {mitre;},
        first, if *eEnd[usize.from(first)] == n {1.;} else {0.;}, second, 0.5);
      self.setEndRing(first, *eEnd[usize.from(first)] == n, r);
      self.setEndRing(second, *eEnd[usize.from(second)] == n, r);
    } else {
      // A ring of its own for each edge, a little way along it, and a band across the joint
      imm gap = opt.gap * maxF(rx, rz);
      imm r1 = self.looseRing(n, first, gap, rx, rz);
      imm r2 = self.looseRing(n, second, gap, rx, rz);
      self.setEndRing(first, *eEnd[usize.from(first)] == n, r1);
      self.setEndRing(second, *eEnd[usize.from(second)] == n, r2);
      self.tube(r1, r2, 0u32, first, NoNode, NoNode);
    }
  }

  fn looseRing(self &mut, n u32, e u32, gap f32, rx f32, rz f32) u32 {
    imm c = *g.position[usize.from(n)] + self.awayFrom(n, e) * gap;
    imm atEnd = *eEnd[usize.from(e)] == n;
    self.addRing(c, *eX[usize.from(e)], *eDir[usize.from(e)], rx, rz, new Vec3(0., 0., 0.), 1., e,
      if atEnd {1.;} else {0.;}, NoNode, 0.);
  }

  // A node with three edges or more: a ring on each edge, standing off far
  // enough that every ring is a face of the convex hull of all the rings'
  // corners; the hull's other faces are the junction
  fn junction(self &mut, n u32) {
    imm deg = self.degree(n);
    imm rx = *g.radiusX[usize.from(n)];
    imm rz = *g.radiusZ[usize.from(n)];
    imm r = maxF(rx, rz);
    imm c = *g.position[usize.from(n)];
    mut qs = List[Vec3].empty();
    mut xs = List[Vec3].empty();
    mut i = 0usize;
    while i < deg {
      imm e = self.incident(n, i);
      imm q = self.awayFrom(n, e);
      qs.push(q);
      mut x = squareTo(*eX[usize.from(e)], q);
      if x.lengthSquared() == 0. { x = squareTo(new Vec3(1., 0., 0.), q); }
      if x.lengthSquared() == 0. { x = squareTo(new Vec3(0., 0., 1.), q); }
      xs.push(x);
      i = i + 1usize;
    }
    // Standoffs: the least t_i such that ring i lies beyond every other ring's corners
    mut t = List[f32].empty();
    i = 0usize;
    while i < deg { t.push(0.5 * r); i = i + 1usize; }
    imm margin = 0.02 * r;
    imm cap = 12. * r;
    mut iter = 0u32;
    mut moving = true;
    while moving and iter < 80u32 {
      moving = false;
      mut nt = List[f32].empty();
      i = 0usize;
      while i < deg {
        mut need = 0.5 * r;
        mut j = 0usize;
        while j < deg {
          if j != i {
            imm zj = (*xs[j]).cross(*qs[j]);
            mut k = 0usize;
            while k < 4usize {
              imm p = ringCorner(k, *qs[j] * *t[j], *xs[j], zj, rx, rz);
              need = maxF(need, p.dot(*qs[i]) + margin);
              k = k + 1usize;
            }
          }
          j = j + 1usize;
        }
        if need > cap { need = cap; }
        if absF(need - *t[i]) > 0.00001 * r { moving = true; }
        nt.push(need);
        i = i + 1usize;
      }
      t = nt;
      iter = iter + 1u32;
    }
    if moving {
      mut s = String.from("two edges meet node ");
      s.appendUInt(u64.from(n));
      s.append(" at a very small angle; its junction may have a hole");
      problems.push(s);
    }
    imm extra = if self.isLoose(n) {0.;} else {opt.smooth * r;};
    // The rings
    mut pts = List[Vec3].empty();
    mut rings = List[u32].empty();
    i = 0usize;
    while i < deg {
      imm e = self.incident(n, i);
      imm atEnd = *eEnd[usize.from(e)] == n;
      imm ti = *t[i] + extra;
      imm nb = self.partner(n, e);
      imm rg = self.addRing(c + *qs[i] * ti, *xs[i], *qs[i], rx, rz, new Vec3(0., 0., 0.), 1., e,
        if atEnd {1.;} else {0.;}, nb, if nb == NoNode {0.;} else {0.5;});
      self.setEndRing(e, atEnd, rg);
      rings.push(rg);
      mut k = 0usize;
      while k < 4usize {
        pts.push(*pos[usize.from(4u32 * rg) + k]);
        k = k + 1usize;
      }
      i = i + 1usize;
    }
    imm hull = convexHull3(&pts, 0.00002 * r);
    imm quads = quadrangulate(&hull, &pts);
    // The faces that are not one of the rings
    mut f = 0usize;
    while f < quads.faceCount() {
      mut isRing = false;
      if quads.size(f) == 4usize {
        imm r0 = quads.corner(f, 0usize) / 4u32;
        isRing = quads.corner(f, 1usize) / 4u32 == r0 and quads.corner(f, 2usize) / 4u32 == r0
          and quads.corner(f, 3usize) / 4u32 == r0;
      }
      if !isRing {
        mut vs = List[u32].empty();
        mut k = 0usize;
        while k < quads.size(f) {
          imm lv = quads.corner(f, k);
          vs.push(*rings[usize.from(lv / 4u32)] * 4u32 + (lv % 4u32));
          k = k + 1usize;
        }
        if vs.len() == 3usize { triangles = triangles + 1u32; }
        self.addFaceVerts(&vs);
      }
      f = f + 1usize;
    }
  }

  // ---- everything ----

  fn edgeSides(self &mut) {
    // The tubes, and the caps at the ends of degree-one nodes
    mut o = 0usize;
    while o < order.len() {
      imm e = *order[o];
      imm a = self.ringAt(e, false);
      imm b = self.ringAt(e, true);
      imm s = *eStart[usize.from(e)];
      imm t = *eEnd[usize.from(e)];
      imm d = *eDir[usize.from(e)];
      if (*ringCentre[usize.from(b)] - *ringCentre[usize.from(a)]).dot(d) < 0.01 * *eLen[usize.from(e)] {
        mut msg = String.from("edge ");
        msg.appendUInt(u64.from(e));
        msg.append(" is too short for the rings at its ends; its tube is folded");
        problems.push(msg);
      }
      self.tube(a, b, opt.cuts, e, self.partner(s, e), self.partner(t, e));
      o = o + 1usize;
    }
    mut n = 0usize;
    while n < g.position.len() {
      if self.degree(u32.from(n)) == 1usize {
        imm e = self.incident(u32.from(n), 0usize);
        imm atEnd = *eEnd[usize.from(e)] == u32.from(n);
        imm r = self.ringAt(e, atEnd);
        self.closeEnd(r, self.awayFrom(u32.from(n), e) * -1., e, *g.radiusX[n], *g.radiusZ[n]);
      }
      n = n + 1usize;
    }
  }
}
