// ======== The armature a graph gives, and the skin's weights ========

// One bone for each edge that was grown, numbered in the order the edges were
// reached from the root, so a bone's parent has a lower number. Bone i runs
// from node 'startNode[i]' (its head) to 'endNode[i]' (its tail); its parent is
// the bone of the edge that reached its head (-1 at a root); 'edge[i]' is the
// graph's edge it is.
pub struct Armature {
  pub head List[Vec3];
  pub tail List[Vec3];
  pub parent List[i32];
  pub edge List[u32];
  pub startNode List[u32];
  pub endNode List[u32];

  pub fn empty() Armature {
    new Armature(List[Vec3].empty(), List[Vec3].empty(), List[i32].empty(), List[u32].empty(),
      List[u32].empty(), List[u32].empty())
  }

  pub fn boneCount(self &) usize { head.len() }

  pub fn copy(self &) Armature {
    new Armature(copyOf[Vec3](&head), copyOf[Vec3](&tail), copyOf[i32](&parent), copyOf[u32](&edge),
      copyOf[u32](&startNode), copyOf[u32](&endNode))
  }

  // The bone made from graph edge e, or -1 if it has none
  pub fn boneOfEdge(self &, e u32) i32 {
    var i = 0usize;
    while i < edge.len() {
      if *edge[i] == e { return i32.from(i); }
      i = i + 1usize;
    }
    -1i32
  }

  // The same bones as bonepose's skeleton in its rest pose: bone i's local +y runs along
  // the bone (head to tail), its origin at the head, its parent's frame its parent
  pub fn skeleton(self &) Skeleton {
    var sk = Skeleton.empty();
    var world = List[Transform3].empty();
    var i = 0usize;
    while i < head.len() {
      let dir = (*tail[i] - *head[i]).normalize();
      let w = new Transform3(*head[i], Quat.fromVectors(new Vec3(0., 1., 0.), dir), new Vec3(1., 1., 1.));
      world.push(w);
      let p = *parent[i];
      if p >= 0i32 {
        sk.addBone(p, (*world[usize.from(p)]).inverse() * w);
      } else {
        sk.addBone(-1i32, w);
      }
      i = i + 1usize;
    }
    sk
  }
}

// Up to four bones and weights for each vertex, the layout creaturerig's
// VertexWeights uses: four a vertex, an unused slot bone 0 with weight 0, the
// weights summing to 1 (all 0 for a vertex of a node with no edge)
pub struct SkinWeights {
  pub joints List[u32];
  pub weights List[f32];

  pub fn vertexCount(self &) usize { joints.len() / 4usize }
  pub fn joint(self &, v usize, k usize) usize { usize.from(*joints[v * 4usize + k]) }
  pub fn weight(self &, v usize, k usize) f32 { *weights[v * 4usize + k] }

  // What bone b carries of vertex v (0 if it is not among its four)
  pub fn weightOf(self &, v usize, b usize) f32 {
    var sum = 0.f;
    var k = 0usize;
    while k < 4usize {
      if self.joint(v, k) == b { sum = sum + self.weight(v, k); }
      k = k + 1usize;
    }
    sum
  }

  // The weights as vertex channels "weight_0", "weight_1" ... of a mesh with
  // those vertices (a channel a bone): they ride through any operator that
  // carries channels, subdivision included, and 'weightsFromChannels' reads
  // them back
  pub fn toChannels(self &, m &mut PolyMesh, bones usize) {
    var b = 0usize;
    while b < bones {
      var name = String.from("weight_");
      name.appendUInt(u64.from(b));
      let ch = m.addFloatChannel(VertexDomain, name.view(), 0.);
      var v = 0usize;
      while v < self.vertexCount() {
        m.setFloat(ch, u32.from(v), self.weightOf(v, b));
        v = v + 1usize;
      }
      b = b + 1usize;
    }
  }
}

// The best four weights of each vertex of a mesh from its channels
// "weight_0" to "weight_{bones - 1}", normalized
pub fn weightsFromChannels(m &PolyMesh, bones usize) SkinWeights {
  var chans = List[u32].empty();
  var b = 0usize;
  while b < bones {
    var name = String.from("weight_");
    name.appendUInt(u64.from(b));
    chans.push(m.findFloatChannel(VertexDomain, name.view()));
    b = b + 1usize;
  }
  var out = new SkinWeights(List[u32].empty(), List[f32].empty());
  var v = 0usize;
  while v < m.positions.len() {
    var bj = List[u32].empty();
    var bw = List[f32].empty();
    var k = 0usize;
    while k < 4usize { bj.push(0u32); bw.push(0.); k = k + 1usize; }
    b = 0usize;
    while b < bones {
      let ch = *chans[b];
      let w = if ch == NoIndex {0.} else {m.float(ch, u32.from(v))};
      // Insert into the best four, ties kept in bone order
      if w > *bw[3usize] {
        var s = 3usize;
        while s > 0usize && w > *bw[s - 1usize] {
          bw.set(s, *bw[s - 1usize]);
          bj.set(s, *bj[s - 1usize]);
          s = s - 1usize;
        }
        bw.set(s, w);
        bj.set(s, u32.from(b));
      }
      b = b + 1usize;
    }
    var sum = 0.f;
    k = 0usize;
    while k < 4usize { sum = sum + *bw[k]; k = k + 1usize; }
    k = 0usize;
    while k < 4usize {
      out.joints.push(if *bw[k] > 0. {*bj[k]} else {0u32});
      out.weights.push(if sum > 0. {*bw[k] / sum} else {0.});
      k = k + 1usize;
    }
    v = v + 1usize;
  }
  out
}
