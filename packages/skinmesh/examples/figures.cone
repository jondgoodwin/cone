// figures: skinmesh's graphs grown into skins, drawn by a small software
// renderer (no GPU) to PNG sheets in C:/src/skinmesh-shots.
//
//   congo run packages/skinmesh/examples/figures.cone
//
//   skin-figures.png      a human, a four-legged creature, a hand with fingers and a tree branch: the base
//                         mesh (flat shaded, quads outlined, triangles yellow) from the front and in three quarters
//   skin-smooth.png       the same four, subdivided twice, coloured by limb
//   skin-joints.png       joints and branches: a smooth and a loose bend, a Y, a T, a cross, a branch of
//                         five, an end with a flat cap and with a dome, a tube cut into rings
//   skin-weights.png      the human and the creature coloured by one bone's weight, with the bones drawn
//   skin-channels.png     the human coloured by "along", and by "around"
//
// Exit status 0 if every skin built clean (no problems, closed and manifold, outward).

mod figures;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import imagedecode use *;
import fs;
import path use Path;
import skinmesh use *;

// ---------------------------------------------------------------- a canvas

struct Canvas {
  w i32;
  h i32;
  px List[u8];
  zb List[f32];
  // The tile being drawn into
  cx0 i32;
  cy0 i32;
  cx1 i32;
  cy1 i32;

  fn make(w i32, h i32) Canvas {
    var c = new Canvas(w, h, List[u8].empty(), List[f32].empty(), 0, 0, w, h);
    c.px.resize(usize.from(w) * usize.from(h) * 4usize, 255u8);
    c.zb.resize(usize.from(w) * usize.from(h), -1000000.);
    c
  }

  fn tile(self &mut, x0 i32, y0 i32, x1 i32, y1 i32, bg Vec3) {
    cx0 = x0; cy0 = y0; cx1 = x1; cy1 = y1;
    var y = y0;
    while y < y1 {
      var x = x0;
      while x < x1 {
        self.setPixel(x, y, bg);
        zb.set(usize.from(y * w + x), -1000000.);
        x = x + 1;
      }
      y = y + 1;
    }
  }

  fn setPixel(self &mut, x i32, y i32, c Vec3) {
    let i = usize.from(y * w + x) * 4usize;
    px.set(i, byteOf(c.x));
    px.set(i + 1usize, byteOf(c.y));
    px.set(i + 2usize, byteOf(c.z));
  }

  fn plot(self &mut, x i32, y i32, z f32, c Vec3) {
    if x >= cx0 && x < cx1 && y >= cy0 && y < cy1 {
      let i = usize.from(y * w + x);
      if z > *zb[i] {
        zb.set(i, z);
        self.setPixel(x, y, c);
      }
    }
  }

  // A triangle in screen space with depths, filled
  fn triangle(self &mut, a Vec3, b Vec3, c Vec3, col Vec3) {
    let minx = imax(cx0, i32.from(libc.floorf(fmin3(a.x, b.x, c.x))));
    let maxx = imin(cx1 - 1, i32.from(libc.ceilf(fmax3(a.x, b.x, c.x))));
    let miny = imax(cy0, i32.from(libc.floorf(fmin3(a.y, b.y, c.y))));
    let maxy = imin(cy1 - 1, i32.from(libc.ceilf(fmax3(a.y, b.y, c.y))));
    let den = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
    if den > -0.0000001 && den < 0.0000001 { return; }
    var y = miny;
    while y <= maxy {
      var x = minx;
      while x <= maxx {
        let px_ = f32.from(x) + 0.5;
        let py_ = f32.from(y) + 0.5;
        let l0 = ((b.y - c.y) * (px_ - c.x) + (c.x - b.x) * (py_ - c.y)) / den;
        let l1 = ((c.y - a.y) * (px_ - c.x) + (a.x - c.x) * (py_ - c.y)) / den;
        let l2 = 1. - l0 - l1;
        if l0 >= -0.0001 && l1 >= -0.0001 && l2 >= -0.0001 {
          self.plot(x, y, l0 * a.z + l1 * b.z + l2 * c.z, col);
        }
        x = x + 1;
      }
      y = y + 1;
    }
  }

  // A line with a depth test, a little in front of the surface
  fn line(self &mut, a Vec3, b Vec3, col Vec3, bias f32, thick i32) {
    let dx = b.x - a.x;
    let dy = b.y - a.y;
    let steps = i32.from(fmax3(absf(dx), absf(dy), 1.)) + 1;
    var i = 0;
    while i <= steps {
      let t = f32.from(i) / f32.from(steps);
      let x = a.x + dx * t;
      let y = a.y + dy * t;
      let z = a.z + (b.z - a.z) * t + bias;
      var ox = 0;
      while ox < thick {
        var oy = 0;
        while oy < thick {
          self.plot(i32.from(x) + ox, i32.from(y) + oy, z, col);
          oy = oy + 1;
        }
        ox = ox + 1;
      }
      i = i + 1;
    }
  }
}

fn absf(a f32) f32 { if a < 0. {-a} else {a} }
fn imax(a i32, b i32) i32 { if a > b {a} else {b} }
fn imin(a i32, b i32) i32 { if a < b {a} else {b} }
fn fmin3(a f32, b f32, c f32) f32 { let m = if a < b {a} else {b}; if m < c {m} else {c} }
fn fmax3(a f32, b f32, c f32) f32 { let m = if a > b {a} else {b}; if m > c {m} else {c} }

fn byteOf(v f32) u8 {
  var x = i32.from(v * 255. + 0.5);
  if x < 0 { x = 0; }
  if x > 255 { x = 255; }
  u8.from(x)
}

// ---------------------------------------------------------------- the view

struct View {
  yaw f32;
  pitch f32;

  // A point turned: yaw about y, then pitch about x
  fn turn(self, p Vec3) Vec3 {
    let cy = cos(yaw);
    let sy = sin(yaw);
    let x1 = p.x * cy + p.z * sy;
    let z1 = -p.x * sy + p.z * cy;
    let cp = cos(pitch);
    let sp = sin(pitch);
    new Vec3(x1, p.y * cp - z1 * sp, p.y * sp + z1 * cp)
  }
}

const ModeGrey = 0u32;
const ModeLimb = 1u32;
const ModeBone = 2u32;
const ModeAlong = 3u32;
const ModeAround = 4u32;

// A hue wheel colour for an index
fn palette(i usize) Vec3 {
  let k = i % 8usize;
  if k == 0usize { new Vec3(0.85, 0.45, 0.40) }
  elif k == 1usize { new Vec3(0.40, 0.65, 0.85) }
  elif k == 2usize { new Vec3(0.55, 0.78, 0.45) }
  elif k == 3usize { new Vec3(0.90, 0.75, 0.35) }
  elif k == 4usize { new Vec3(0.70, 0.52, 0.85) }
  elif k == 5usize { new Vec3(0.45, 0.80, 0.78) }
  elif k == 6usize { new Vec3(0.88, 0.58, 0.72) }
  else { new Vec3(0.65, 0.65, 0.65) }
}

// A ramp, 0 blue, 0.5 pale, 1 red
fn heat(t f32) Vec3 {
  let u = if t < 0. {0.} elif t > 1. {1.} else {t};
  if u < 0.5 {
    let s = u * 2.;
    new Vec3(0.20 + 0.75 * s, 0.30 + 0.65 * s, 0.85 + 0.10 * s)
  } else {
    let s = (u - 0.5) * 2.;
    new Vec3(0.95, 0.95 - 0.70 * s, 0.95 - 0.75 * s)
  }
}

// Draw a mesh into the current tile: fitted, shaded, quads outlined
fn drawMesh(cv &mut Canvas, pm &PolyMesh, view &View, mode u32, bone u32, w &SkinWeights, outline bool) {
  let tw = f32.from(cv.cx1 - cv.cx0);
  let th = f32.from(cv.cy1 - cv.cy0);
  // Fit
  var lo = new Vec3(1000000., 1000000., 1000000.);
  var hi = new Vec3(-1000000., -1000000., -1000000.);
  var v = 0usize;
  while v < pm.positions.len() {
    let p = view.turn(*pm.positions[v]);
    lo = lo.min(p);
    hi = hi.max(p);
    v = v + 1usize;
  }
  let ext = hi - lo;
  let sc = fmin3(tw * 0.88 / fmax3(ext.x, 0.0001, 0.0001), th * 0.88 / fmax3(ext.y, 0.0001, 0.0001), 1000000.);
  let mid = (lo + hi) * 0.5;
  var sp = List[Vec3].empty();
  v = 0usize;
  while v < pm.positions.len() {
    let p = view.turn(*pm.positions[v]) - mid;
    sp.push(new Vec3(f32.from(cv.cx0) + tw * 0.5 + p.x * sc, f32.from(cv.cy0) + th * 0.5 - p.y * sc, p.z * sc));
    v = v + 1usize;
  }
  let light = new Vec3(-0.35, 0.55, 0.75).normalize();
  let limbCh = pm.findFloatChannel(VertexDomain, "limb");
  let alongCh = pm.findFloatChannel(VertexDomain, "along");
  let aroundCh = pm.findFloatChannel(VertexDomain, "around");
  var f = 0usize;
  while f < pm.faceCount() {
    let vs = pm.faceVertices(u32.from(f));
    let n = view.turn(pm.faceNormal(u32.from(f)));
    var base = new Vec3(0.78, 0.80, 0.84);
    if mode != ModeGrey {
      var acc = 0.f;
      var k = 0usize;
      while k < vs.len() {
        let vi = *vs[k];
        if mode == ModeLimb && limbCh != NoIndex { acc = acc + pm.float(limbCh, vi); }
        if mode == ModeAlong && alongCh != NoIndex { acc = acc + pm.float(alongCh, vi); }
        if mode == ModeAround && aroundCh != NoIndex { acc = acc + pm.float(aroundCh, vi); }
        if mode == ModeBone { acc = acc + w.weightOf(usize.from(vi), usize.from(bone)); }
        k = k + 1usize;
      }
      acc = acc / f32.from(vs.len());
      if mode == ModeLimb { base = palette(usize.from(i32.from(acc + 0.5))); }
      elif mode == ModeAround { base = palette(usize.from(i32.from(acc * 4. + 0.5))); }
      else { base = heat(acc); }
    }
    if vs.len() == 3usize { base = base * 0.45 + new Vec3(0.55, 0.50, 0.0); }
    elif vs.len() > 4usize { base = base * 0.45 + new Vec3(0.55, 0.0, 0.55); }
    var shade = 0.30 + 0.70 * fmax3(n.dot(light), 0., 0.);
    var col = base * shade;
    if n.z < 0. { col = new Vec3(0.9, 0.1, 0.1); }
    var k = 1usize;
    while k + 1usize < vs.len() {
      cv.triangle(*sp[usize.from(*vs[0usize])], *sp[usize.from(*vs[k])], *sp[usize.from(*vs[k + 1usize])], col);
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  if outline {
    f = 0usize;
    while f < pm.faceCount() {
      let vs = pm.faceVertices(u32.from(f));
      var k = 0usize;
      while k < vs.len() {
        cv.line(*sp[usize.from(*vs[k])], *sp[usize.from(*vs[(k + 1usize) % vs.len()])], new Vec3(0.12, 0.12, 0.16), 0.6, 1);
        k = k + 1usize;
      }
      f = f + 1usize;
    }
  }
}

// The bones as lines on top, heads dotted
fn drawBones(cv &mut Canvas, pm &PolyMesh, rig &Armature, view &View) {
  let tw = f32.from(cv.cx1 - cv.cx0);
  let th = f32.from(cv.cy1 - cv.cy0);
  var lo = new Vec3(1000000., 1000000., 1000000.);
  var hi = new Vec3(-1000000., -1000000., -1000000.);
  var v = 0usize;
  while v < pm.positions.len() {
    let p = view.turn(*pm.positions[v]);
    lo = lo.min(p);
    hi = hi.max(p);
    v = v + 1usize;
  }
  let ext = hi - lo;
  let sc = fmin3(tw * 0.88 / fmax3(ext.x, 0.0001, 0.0001), th * 0.88 / fmax3(ext.y, 0.0001, 0.0001), 1000000.);
  let mid = (lo + hi) * 0.5;
  var i = 0usize;
  while i < rig.boneCount() {
    let a = view.turn(*rig.head[i]) - mid;
    let b = view.turn(*rig.tail[i]) - mid;
    let pa = new Vec3(f32.from(cv.cx0) + tw * 0.5 + a.x * sc, f32.from(cv.cy0) + th * 0.5 - a.y * sc, 1000000.);
    let pb = new Vec3(f32.from(cv.cx0) + tw * 0.5 + b.x * sc, f32.from(cv.cy0) + th * 0.5 - b.y * sc, 1000000.);
    cv.line(pa, pb, new Vec3(0.05, 0.05, 0.05), 0., 2);
    cv.line(pa + new Vec3(-2., -2., 0.), pa + new Vec3(2., 2., 0.), new Vec3(0.9, 0.1, 0.1), 0., 5);
    i = i + 1usize;
  }
}

// ---------------------------------------------------------------- output

fn save(cv &Canvas, name &str) {
  var r = Raster.empty();
  r.width = cv.w;
  r.height = cv.h;
  r.depth = 8;
  r.colorSpace = ColorSpace.Srgb;
  var i = 0usize;
  while i < cv.px.len() { r.pixels8.push(*cv.px[i]); i = i + 1usize; }
  let png = encodePng(&r, 2);
  var full = String.from("C:/src/skinmesh-shots/");
  full.append(name);
  let op = Path.from(full.view());
  fs.writeFile(&op, png.view());
  printStr("wrote "); printStr(full.view()); printStr(" ("); print <- png.len(); printStr(" bytes)\n");
}

// ---------------------------------------------------------------- the graphs

fn v3(x f32, y f32, z f32) Vec3 { new Vec3(x, y, z) }

// A person standing in an A pose, facing +z
fn human() SkinGraph {
  var g = SkinGraph.empty();
  let pelvis = g.addNode(v3(0., 0.93, 0.), 0.07, 0.07);
  g.setRoot(pelvis);
  let waist = g.grow(pelvis, v3(0., 1.12, 0.), 0.15, 0.10);
  let chest = g.grow(waist, v3(0., 1.32, 0.01), 0.10, 0.08);
  let neck = g.grow(chest, v3(0., 1.66, 0.), 0.05, 0.05);
  let head = g.grow(neck, v3(0., 1.78, 0.015), 0.09, 0.10);
  g.grow(head, v3(0., 1.94, 0.015), 0.075, 0.085);
  // Arms
  var side = -1.f;
  var s = 0;
  while s < 2 {
    let shoulder = g.grow(chest, v3(side * 0.42, 1.44, 0.), 0.055, 0.055);
    let elbow = g.grow(shoulder, v3(side * 0.62, 1.18, 0.), 0.05, 0.05);
    let wrist = g.grow(elbow, v3(side * 0.78, 0.95, 0.03), 0.038, 0.032);
    g.grow(wrist, v3(side * 0.85, 0.84, 0.04), 0.04, 0.016);
    // Legs
    let knee = g.grow(pelvis, v3(side * 0.24, 0.50, 0.025), 0.07, 0.07);
    let ankle = g.grow(knee, v3(side * 0.20, 0.09, 0.), 0.05, 0.05);
    g.grow(ankle, v3(side * 0.20, 0.04, 0.16), 0.05, 0.03);
    side = 1.;
    s = s + 1;
  }
  g
}

// A four-legged creature with a tail and a long head
fn creature() SkinGraph {
  var g = SkinGraph.empty();
  let hips = g.addNode(v3(0., 0.62, -0.50), 0.09, 0.10);
  g.setRoot(hips);
  let mid = g.grow(hips, v3(0., 0.68, 0.), 0.17, 0.15);
  let shoulders = g.grow(mid, v3(0., 0.68, 0.50), 0.10, 0.11);
  let neck = g.grow(shoulders, v3(0., 0.82, 0.78), 0.09, 0.09);
  let head = g.grow(neck, v3(0., 0.86, 0.98), 0.075, 0.08);
  g.grow(head, v3(0., 0.80, 1.18), 0.05, 0.05);
  // Tail
  let tail1 = g.grow(hips, v3(0., 0.66, -0.80), 0.045, 0.045);
  let tail2 = g.grow(tail1, v3(0., 0.62, -1.05), 0.035, 0.035);
  g.grow(tail2, v3(0., 0.74, -1.28), 0.02, 0.02);
  var side = -1.f;
  var s = 0;
  while s < 2 {
    // Fore leg
    let elbow = g.grow(shoulders, v3(side * 0.28, 0.36, 0.52), 0.06, 0.06);
    let wrist = g.grow(elbow, v3(side * 0.24, 0.13, 0.54), 0.04, 0.04);
    g.grow(wrist, v3(side * 0.24, 0.03, 0.62), 0.045, 0.035);
    // Hind leg
    let knee = g.grow(hips, v3(side * 0.30, 0.34, -0.40), 0.07, 0.07);
    let hock = g.grow(knee, v3(side * 0.24, 0.18, -0.64), 0.04, 0.04);
    g.grow(hock, v3(side * 0.24, 0.03, -0.54), 0.045, 0.035);
    side = 1.;
    s = s + 1;
  }
  g
}

// A hand, palm to +z, fingers up +y: a bar of knuckles across the palm's top, the fingers off it
fn hand() SkinGraph {
  var g = SkinGraph.empty();
  let wrist = g.addNode(v3(0., 0., 0.), 0.026, 0.016);
  g.setRoot(wrist);
  let palm = g.grow(wrist, v3(0., 0.075, 0.), 0.026, 0.014);
  let kMid = g.grow(palm, v3(0., 0.135, 0.), 0.010, 0.010);
  let kInd = g.grow(kMid, v3(0.036, 0.130, 0.), 0.009, 0.009);
  let kRing = g.grow(kMid, v3(-0.036, 0.130, 0.), 0.009, 0.009);
  let kLit = g.grow(kRing, v3(-0.070, 0.120, 0.), 0.008, 0.008);
  // Fingers: knuckle, three bones
  var f = 0;
  while f < 4 {
    let from = if f == 0 {kInd} elif f == 1 {kMid} elif f == 2 {kRing} else {kLit};
    let px = if f == 0 {0.036f} elif f == 1 {0.0} elif f == 2 {-0.036} else {-0.070};
    let py = if f == 0 {0.130f} elif f == 1 {0.135} elif f == 2 {0.130} else {0.120};
    let len = if f == 0 {1.0f} elif f == 1 {1.1} elif f == 2 {1.0} else {0.8};
    let lean = px * 0.18;
    let j1 = g.grow(from, v3(px + lean * 0.4, py + 0.045 * len, 0.002), 0.0085, 0.0085);
    let j2 = g.grow(j1, v3(px + lean * 0.8, py + 0.075 * len, 0.004), 0.0078, 0.0078);
    g.grow(j2, v3(px + lean * 1.2, py + 0.100 * len, 0.006), 0.0070, 0.0070);
    f = f + 1;
  }
  // Thumb off the palm
  let t0 = g.grow(palm, v3(0.060, 0.090, 0.010), 0.012, 0.012);
  let t1 = g.grow(t0, v3(0.085, 0.125, 0.020), 0.0105, 0.010);
  let t2 = g.grow(t1, v3(0.102, 0.158, 0.026), 0.0095, 0.009);
  g.grow(t2, v3(0.112, 0.185, 0.030), 0.0085, 0.008);
  g
}

// A branching limb of a tree: a trunk with side branches that fork
fn tree() SkinGraph {
  var g = SkinGraph.empty();
  let base = g.addNode(v3(0., 0., 0.), 0.13, 0.13);
  g.setRoot(base);
  let t1 = g.grow(base, v3(0., 0.45, 0.), 0.11, 0.11);
  let t2 = g.grow(t1, v3(0.04, 0.95, 0.), 0.095, 0.095);
  let t3 = g.grow(t2, v3(0.02, 1.45, 0.02), 0.075, 0.075);
  let t4 = g.grow(t3, v3(-0.05, 1.90, 0.03), 0.055, 0.055);
  g.grow(t4, v3(-0.08, 2.35, 0.03), 0.03, 0.03);
  // A side branch low on the trunk, with a fork
  let b1 = g.grow(t2, v3(0.55, 1.35, 0.10), 0.05, 0.05);
  let b1a = g.grow(b1, v3(0.95, 1.55, 0.25), 0.04, 0.04);
  g.grow(b1a, v3(1.30, 1.95, 0.30), 0.022, 0.022);
  g.grow(b1a, v3(1.30, 1.50, 0.45), 0.022, 0.022);
  // Another to the other side and back
  let b2 = g.grow(t3, v3(-0.50, 1.95, -0.25), 0.045, 0.045);
  let b2a = g.grow(b2, v3(-0.90, 2.20, -0.45), 0.035, 0.035);
  g.grow(b2a, v3(-1.20, 2.60, -0.45), 0.02, 0.02);
  g.grow(b2a, v3(-1.25, 2.15, -0.75), 0.02, 0.02);
  g.grow(b2, v3(-0.45, 2.35, -0.05), 0.022, 0.022);
  // A short spur
  g.grow(t1, v3(-0.35, 0.80, 0.0), 0.03, 0.03);
  g
}

// A 90 degree bend in two edges
fn bend(loose bool) SkinGraph {
  var g = SkinGraph.empty();
  let a = g.addNode(v3(0., 0., 0.), 0.12, 0.12);
  g.setRoot(a);
  let b = g.grow(a, v3(0., 1., 0.), 0.12, 0.12);
  g.grow(b, v3(1., 1., 0.), 0.12, 0.12);
  g.setLoose(b, loose);
  g
}

// A stem and n arms leaving its top, spread over a cone of the given half angle
fn star(n i32, spread f32) SkinGraph {
  var g = SkinGraph.empty();
  let a = g.addNode(v3(0., 0., 0.), 0.1, 0.1);
  g.setRoot(a);
  let top = g.grow(a, v3(0., 1., 0.), 0.1, 0.1);
  var k = 0;
  while k < n {
    let ang = 2. * pi * f32.from(k) / f32.from(n) + 0.3;
    let c = if n == 2 {1.f} else {1.};
    g.grow(top, v3(sin(spread) * cos(ang) * 1.1, 1. + cos(spread) * 1.1 * c, sin(spread) * sin(ang) * 1.1), 0.08, 0.08);
    k = k + 1;
  }
  g
}

// A straight bar of two edges, for caps and cuts
fn tubeGraph() SkinGraph {
  var g = SkinGraph.empty();
  let a = g.addNode(v3(0., 0., 0.), 0.15, 0.10);
  g.setRoot(a);
  let b = g.grow(a, v3(0., 0.8, 0.), 0.10, 0.10);
  g.grow(b, v3(0.3, 1.5, 0.), 0.12, 0.06);
  g
}

// ---------------------------------------------------------------- checks

// Closed, manifold, outward: the mesh's own validation, no boundary edge, and a positive volume
fn volumeOf(pm &PolyMesh) f32 {
  var vol = 0.f;
  var f = 0usize;
  while f < pm.faceCount() {
    let vs = pm.faceVertices(u32.from(f));
    let p0 = *pm.positions[usize.from(*vs[0usize])];
    var k = 1usize;
    while k + 1usize < vs.len() {
      let p1 = *pm.positions[usize.from(*vs[k])];
      let p2 = *pm.positions[usize.from(*vs[k + 1usize])];
      vol = vol + p0.dot(p1.cross(p2)) / 6.;
      k = k + 1usize;
    }
    f = f + 1usize;
  }
  vol
}

fn report(name &str, s &Skin) bool {
  var boundary = 0usize;
  var e = 0usize;
  while e < s.mesh.edgeCount() {
    if s.mesh.isBoundaryEdge(u32.from(e)) { boundary = boundary + 1usize; }
    e = e + 1usize;
  }
  let bad = s.mesh.validate();
  let vol = volumeOf(&s.mesh);
  printStr(name);
  printStr(": "); print <- s.mesh.vertexCount(); printStr(" vertices, "); print <- s.mesh.faceCount();
  printStr(" faces, "); print <- s.triangles; printStr(" junction triangles, "); print <- s.rig.boneCount();
  printStr(" bones, "); print <- s.limbs; printStr(" limbs, boundary edges "); print <- boundary;
  printStr(", volume "); print <- vol; printStr(", problems "); print <- s.problems.len() + bad.len(); printStr("\n");
  var i = 0usize;
  while i < s.problems.len() { printStr("    "); printStr((*s.problems[i]).view()); printStr("\n"); i = i + 1usize; }
  i = 0usize;
  while i < bad.len() && i < 5usize { printStr("    mesh: "); printStr((*bad[i]).view()); printStr("\n"); i = i + 1usize; }
  s.problems.len() == 0usize && bad.len() == 0usize && boundary == 0usize && vol > 0.
}

fn main() i32 {
  let dir = Path.from("C:/src/skinmesh-shots");
  fs.makeDirAll(&dir);
  var ok = true;
  let names = ["human", "creature", "hand", "tree"];
  var graphs = List[SkinGraph].empty();
  graphs.push(human());
  graphs.push(creature());
  graphs.push(hand());
  graphs.push(tree());
  var skins = List[Skin].empty();
  var fines = List[Skin].empty();
  var i = 0usize;
  while i < 4usize {
    let s = skinStandard(&*graphs[i]);
    ok = report(names[i], &s) && ok;
    let f = subdivideSkin(&s, 2u32);
    skins.push(s);
    fines.push(f);
    i = i + 1usize;
  }
  // Base meshes: front and three quarters
  var cv = Canvas.make(2560, 1440);
  i = 0usize;
  while i < 4usize {
    let x0 = i32.from(i) * 640;
    cv.tile(x0, 0, x0 + 640, 720, new Vec3(0.96, 0.96, 0.94));
    drawMesh(&mut cv, &(*skins[i]).mesh, &new View(0., 0.), ModeGrey, 0u32, &(*skins[i]).weights, true);
    cv.tile(x0, 720, x0 + 640, 1440, new Vec3(0.96, 0.96, 0.94));
    drawMesh(&mut cv, &(*skins[i]).mesh, &new View(0.6, 0.25), ModeGrey, 0u32, &(*skins[i]).weights, true);
    i = i + 1usize;
  }
  save(&cv, "skin-figures.png");
  // Subdivided, by limb
  i = 0usize;
  while i < 4usize {
    let x0 = i32.from(i) * 640;
    cv.tile(x0, 0, x0 + 640, 720, new Vec3(0.96, 0.96, 0.94));
    drawMesh(&mut cv, &(*fines[i]).mesh, &new View(0., 0.), ModeLimb, 0u32, &(*fines[i]).weights, false);
    cv.tile(x0, 720, x0 + 640, 1440, new Vec3(0.96, 0.96, 0.94));
    drawMesh(&mut cv, &(*fines[i]).mesh, &new View(0.6, 0.25), ModeLimb, 0u32, &(*fines[i]).weights, false);
    i = i + 1usize;
  }
  save(&cv, "skin-smooth.png");
  // Joints and branches
  var js = List[Skin].empty();
  js.push(skinStandard(&bend(false)));
  js.push(skinStandard(&bend(true)));
  js.push(skinStandard(&star(2, 0.9)));
  js.push(skinStandard(&star(3, 1.0)));
  js.push(skinStandard(&star(4, 0.8)));
  js.push(skinStandard(&star(5, 0.6)));
  js.push(skinStandard(&bend(false)));
  var dome = SkinOptions.standard();
  dome.cap = SkinCapDome;
  dome.cuts = 2u32;
  js.pop();
  js.push(skin(&tubeGraph(), dome));
  js.push(skinStandard(&tubeGraph()));
  i = 0usize;
  while i < 8usize {
    let x0 = i32.from(i % 4usize) * 640;
    let y0 = i32.from(i / 4usize) * 720;
    cv.tile(x0, y0, x0 + 640, y0 + 720, new Vec3(0.96, 0.96, 0.94));
    ok = report("joint", &(*js[i])) && ok;
    let vw = new View(0.5, 0.35);
    drawMesh(&mut cv, &(*js[i]).mesh, &vw, ModeGrey, 0u32, &(*js[i]).weights, true);
    i = i + 1usize;
  }
  save(&cv, "skin-joints.png");
  // Weights: one bone each, the bones drawn
  var shown = List[u32].empty();
  shown.push(4u32); shown.push(9u32); shown.push(14u32); shown.push(2u32);
  i = 0usize;
  while i < 4usize {
    let x0 = i32.from(i) * 640;
    let a = i % 2usize;
    let b = i / 2usize;
    let vw = new View(0.4, 0.15);
    let sk = if b == 0usize {&(*skins[0usize])} else {&(*skins[1usize])};
    let x1 = (i32.from(i)) * 640;
    cv.tile(x1, 0, x1 + 640, 720, new Vec3(0.96, 0.96, 0.94));
    drawMesh(&mut cv, &(*fines[0usize]).mesh, &vw, ModeBone, *shown[i], &(*fines[0usize]).weights, false);
    drawBones(&mut cv, &(*fines[0usize]).mesh, &(*fines[0usize]).rig, &vw);
    cv.tile(x1, 720, x1 + 640, 1440, new Vec3(0.96, 0.96, 0.94));
    drawMesh(&mut cv, &(*fines[1usize]).mesh, &vw, ModeBone, *shown[i], &(*fines[1usize]).weights, false);
    drawBones(&mut cv, &(*fines[1usize]).mesh, &(*fines[1usize]).rig, &vw);
    i = i + 1usize;
  }
  save(&cv, "skin-weights.png");
  // Channels: along, around, on the human and the tree
  i = 0usize;
  while i < 4usize {
    let x1 = i32.from(i) * 640;
    let which = if i < 2usize {0usize} else {3usize};
    let vw = new View(0.4, 0.15);
    cv.tile(x1, 0, x1 + 640, 720, new Vec3(0.96, 0.96, 0.94));
    drawMesh(&mut cv, &(*fines[which]).mesh, &vw, if i % 2usize == 0usize {ModeAlong} else {ModeAround}, 0u32,
      &(*fines[which]).weights, false);
    cv.tile(x1, 720, x1 + 640, 1440, new Vec3(0.96, 0.96, 0.94));
    drawMesh(&mut cv, &(*skins[which]).mesh, &vw, if i % 2usize == 0usize {ModeAlong} else {ModeAround}, 0u32,
      &(*skins[which]).weights, true);
    i = i + 1usize;
  }
  save(&cv, "skin-channels.png");
  if ok { 0 } else { 1 }
}
