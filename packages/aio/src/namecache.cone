// The names looked up, kept and merged: the process's name cache (the package's
// header, THE BLOCKING POOL'S WORK). 'resolve' runs 'resolveShared' on a thread
// of iocore's DNS lane instead of the bare lookup; it answers from here when it
// can.
//
// How it works. A table of entries, one per (name, port), under one lock. A
// lookup whose key is not in the table puts a pending entry there and does the
// lookup itself (the leader: iocore's 'resolveWork', outside the lock); one
// that finds a pending entry waits on the table's Condvar for the leader to
// end it, and has the leader's answer: the lookups in flight for one name are
// one lookup. A lookup that finds an answer not yet old gives it from the
// table: a success is kept 30 s, a failure 5 s ('getaddrinfo' says nothing of
// a lifetime, and the OS keeps its own cache beneath this one), and at most
// 1,024 entries are kept, the one used longest ago going first. All three are
// 'configureNameCache''s. A joiner waits on a lane thread, as the lookup it
// replaces would have been running on one; the queue holds the rest, and each
// finds the answer when its turn comes. A lookup that waits for room, or
// ends at its deadline or cancel, does so in the lane (iocore's waiting list);
// this only shortens the work a thread does.

// What the cache holds for one name and port: pending while the leader looks
// it up, then the answer (ok: the addresses' bytes as the lookup's buffer held
// them, 'n' of them; else the error number) and how long it holds
struct NameEntry {
  key: List[u8];             // the name, lower case, then the port's two bytes
  pending: bool;
  ok: bool;
  code: u32;
  n: usize;
  data: List[u8];
  made: Instant;
  ttlNs: i64;
  used: u64;
}

struct NameCache {
  lock: Mutex;
  changed: Condvar;          // a pending entry has ended
  entries: List[NameEntry];
  okFor: Duration;
  failFor: Duration;
  maxEntries: usize;
  tick: u64;
  resolves: u64;
  hits: u64;
  joined: u64;
  evicted: u64;
}

// The cache's counts and settings, as they are now
pub struct NameCacheStats {
  pub entries: usize;        // answers kept now (and lookups pending)
  pub resolves: u64;         // lookups made on the system (leaders)
  pub hits: u64;             // lookups answered from a kept answer
  pub joined: u64;           // lookups that waited for a lookup in flight and had its answer
  pub evicted: u64;          // answers dropped for the entry bound
  pub okFor: Duration;
  pub failFor: Duration;
  pub maxEntries: usize;
}

let nameCacheAt: Atomic[usize];

const noEntry = 0xFFFFFFFFFFFFFFFFusize;

fn theNameCache() &mut NameCache {
  var at = nameCacheAt.load();
  if at == 0usize {
    ioLock.lock();
    at = nameCacheAt.load();
    if at == 0usize {
      let p = libc.malloc(mem.sizeof[NameCache]()) as *NameCache;
      if p as usize == 0usize {die("aio: out of memory for the name cache");}
      mem.writeRaw[NameCache](p, NameCache(
        lock: Mutex.make(), changed: Condvar.make(), entries: List[NameEntry](),
        okFor: Duration.fromMillis(30000i64), failFor: Duration.fromMillis(5000i64),
        maxEntries: 1024usize, tick: 0u64, resolves: 0u64, hits: 0u64, joined: 0u64, evicted: 0u64));
      nameCacheAt.store(p as usize);
      at = p as usize;
    }
    ioLock.unlock();
  }
  at as *NameCache as &mut NameCache
}

// The settings: how long a success and a failure are kept, and how many
// entries. The defaults are 30 s, 5 s and 1,024; a bound of 0 is 1
pub fn configureNameCache(okFor: Duration, failFor: Duration, maxEntries: usize) {
  let c = theNameCache();
  c.lock.lock();
  c.okFor = okFor;
  c.failFor = failFor;
  c.maxEntries = if maxEntries == 0usize {1usize} else {maxEntries};
  c.lock.unlock();
}

// The cache's counts and settings
pub fn nameCacheStats() NameCacheStats {
  let c = theNameCache();
  c.lock.lock();
  let s = NameCacheStats(c.entries.len(), c.resolves, c.hits, c.joined, c.evicted,
    c.okFor, c.failFor, c.maxEntries);
  c.lock.unlock();
  s
}

// Every kept answer dropped, and the counts set to 0 (lookups pending go on)
pub fn clearNameCache() {
  let c = theNameCache();
  c.lock.lock();
  var k = 0usize;
  while k < c.entries.len() {
    if c.entries[k].pending {
      k = k + 1usize;
    } else {
      _ = c.entries.swapRemove(k);
    }
  }
  c.resolves = 0u64;
  c.hits = 0u64;
  c.joined = 0u64;
  c.evicted = 0u64;
  c.lock.unlock();
}

fn sameBytes(a: &Array[u8], b: &Array[u8]) bool {
  if a.len != b.len {return false;}
  var k = 0usize;
  while k < a.len {
    if a[k] != b[k] {return false;}
    k = k + 1usize;
  }
  true
}

fn findEntry(c: &mut NameCache, key: &List[u8]) usize {
  var k = 0usize;
  while k < c.entries.len() {
    if sameBytes(c.entries[k].key.view(), key.view()) {return k;}
    k = k + 1usize;
  }
  noEntry
}

// Answers beyond the bound go, the one used longest ago first (a pending entry
// is not one). The lock is held
fn evictOver(c: &mut NameCache) {
  while c.entries.len() > c.maxEntries {
    var best = noEntry;
    var bestUsed = 0u64;
    var k = 0usize;
    while k < c.entries.len() {
      if !c.entries[k].pending && (best == noEntry || c.entries[k].used < bestUsed) {
        best = k;
        bestUsed = c.entries[k].used;
      }
      k = k + 1usize;
    }
    if best == noEntry {return;}
    _ = c.entries.swapRemove(best);
    c.evicted = c.evicted + 1u64;
  }
}

// iocore's lookup, through the cache: buf holds the name, and holds the
// addresses when it ends, each with port 'arg', as 'resolveWork' leaves it
fn resolveShared(arg: u64, buf: &mut IoBuf) Outcome {
  let c = theNameCache();
  let key = makeKey(buf.view(), arg);
  var joined = false;
  c.lock.lock();
  while true {
    let at = findEntry(c, &key);
    if at == noEntry {break;}
    if c.entries[at].pending {
      if !joined {
        joined = true;
        c.joined = c.joined + 1u64;
      }
      c.changed.condWait(&c.lock);
      continue;
    }
    let age = c.entries[at].made.elapsed().nanos();
    if age >= c.entries[at].ttlNs {
      _ = c.entries.swapRemove(at);
      continue;
    }
    c.tick = c.tick + 1u64;
    c.entries[at].used = c.tick;
    if !joined {c.hits = c.hits + 1u64;}
    if c.entries[at].ok {
      buf.clear();
      buf.append(c.entries[at].data.view());
      let n = c.entries[at].n;
      c.lock.unlock();
      return Outcome.Done(n);
    }
    else {
      let code = c.entries[at].code;
      c.lock.unlock();
      return Outcome.Failed(code);
    }
  }
  // None: this lookup is the leader
  c.tick = c.tick + 1u64;
  c.resolves = c.resolves + 1u64;
  c.entries.push(NameEntry(key: makeKey(buf.view(), arg), pending: true, ok: false, code: 0u32, n: 0usize,
    data: List[u8](), made: Instant.now(), ttlNs: 0i64, used: c.tick));
  evictOver(c);
  c.lock.unlock();
  let o = resolveWork(arg, buf);
  c.lock.lock();
  // The pending entry is still there: only answers are dropped or evicted
  let at = findEntry(c, &key);
  if at != noEntry {
    c.tick = c.tick + 1u64;
    c.entries[at].pending = false;
    c.entries[at].made = Instant.now();
    c.entries[at].used = c.tick;
    match o {
      case let Done(d) {
        c.entries[at].ok = true;
        c.entries[at].n = d.n;
        c.entries[at].data.appendSlice(buf.view());
        c.entries[at].ttlNs = c.okFor.nanos();
      }
      case let Failed(f) {
        c.entries[at].code = f.code;
        c.entries[at].ttlNs = c.failFor.nanos();
      }
      else {
        _ = c.entries.swapRemove(at);
      }
    }
    evictOver(c);
  }
  c.changed.notifyAll();
  c.lock.unlock();
  o
}

// The cache's key: the name in lower case (names are not case-sensitive) and
// the port's two bytes
fn makeKey(name: &Array[u8], port: u64) List[u8] {
  var key = List[u8]();
  var i = 0usize;
  while i < name.len {
    let ch = name[i];
    key.push(if ch >= 65u8 && ch <= 90u8 {ch + 32u8} else {ch});
    i = i + 1usize;
  }
  key.push(u8.from(port & 0xFFu64));
  key.push(u8.from((port >> 8u64) & 0xFFu64));
  key
}
