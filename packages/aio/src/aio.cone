// The aio package: I/O an actor awaits. A behaviour of an actor writes
//
//   imm r = await conn.read(buf);
//
// and pauses there, as it would awaiting another actor's reply; the read is
// done by the I/O thread's completion loop, and when it has finished, its
// answer comes back to the actor as a message, and the rest of the behaviour
// runs with it, perhaps on another worker. Nothing waits on the worker
// meanwhile: the actor handles its other messages.
//
//   mod hello;
//   import iobuf use IoBuf;
//   import iocore use SocketAddr, IoError;
//   import actors;
//   import aio use Socket;
//
//   // The Socket an answer holds: Socket.none() if it failed
//   fn socketOf(r: Result[Socket, IoError]) Socket {
//     match r {
//       case let Ok(s) {s}
//       case is Error {Socket.none()}
//     }
//   }
//
//   actor Client {
//     pub async fn send(self, port u16) {
//       imm conn = socketOf(await aio.connect(SocketAddr.localhost(port)));
//       mut buf = IoBuf(64usize);
//       buf.append("hello");
//       imm sent = await conn.write(buf);          // pauses until all of it is sent
//       match sent {
//         case imm n Ok {...n bytes were sent...}
//         case imm e Error {...e.code is Windows' error number...}
//       }
//     }                                           // conn closes here
//   }
//
// (tests/manual.cone, the reference manual's example, is a server and this
// client, run.)
//
// What there is:
//
//   aio.listen(addr)        a TCP socket listening at addr       Result[Socket, IoError]
//   aio.connect(addr)       a TCP socket connected to addr       Result[Socket, IoError]
//   s.accept()              the next connection on a listening s  Result[Socket, IoError]
//   s.read(buf)             what arrives, appended to buf, an IoBuf moved in
//                                                                Result[IoBuf, IoError]
//   s.read()                what arrives, in a buffer the I/O side takes: none is
//                           held while it waits                   Result[IoBuf, IoError]
//   s.read(room)            the same, the buffer with room for at least 'room' bytes (a usize)
//                                                                (READS WITH NO BUFFER)
//   s.write(buf)            all of buf, an IoBuf moved in         Result[usize, IoError]
//   s.localAddr()           the address s is bound to            Result[SocketAddr, IoError]
//   aio.openFile(path, access)  a file, opened with iocore's Access   Result[File, IoError]
//   f.readAt(at, buf)       what is in the file from byte offset at, appended to buf
//                                                                Result[IoBuf, IoError]
//   f.writeAt(at, buf)      all of buf, at byte offset at         Result[usize, IoError]
//   aio.bindUdp(addr)      a UDP socket bound to addr            Result[UdpSocket, IoError]
//   u.recvFrom(buf)        one datagram, appended to buf, an IoBuf moved in, and its sender
//                                                                Result[Datagram, IoError]
//   u.sendTo(addr, buf)    all of buf as one datagram to addr    Result[usize, IoError]
//   u.localAddr()          the address u is bound to             Result[SocketAddr, IoError]
//   aio.connectIn(addr, lim)  s.acceptIn(lim)  s.readIn(buf, lim)  s.writeIn(buf, lim)
//   f.readAtIn(at, buf, lim)  f.writeAtIn(at, buf, lim)
//   u.recvFromIn(buf, lim)  u.sendToIn(addr, buf, lim)
//                           the same eight, limited by lim, a IoLimits    (CANCEL AND DEADLINES)
//   s.readIn(lim)  s.readIn(room, lim)
//                           the two reads with no buffer, limited by lim
//   aio.setReadQuiet(d)     how long a read with no buffer may hold one (2 ms)
//   s.cancelRead()  s.cancelWrite()   end the read (accept, receive) or the write (send) in flight
//                           on the handle, alone (ONE OPERATION ALONE); also on a UdpSocket and a File
//   aio.opStats()           how many operations began on a record's own side, and on a spill block;
//                           the records open (RECORDS)
//   IoLimits.none()  IoLimits.until(deadline)  IoLimits.within(group)  IoLimits(group, deadline)
//   aio.sleep(d)  aio.sleepUntil(at)   a pause of d (a Duration) / until at (an Instant)
//                                                                Result[void, IoError]
//   aio.sleepIn(d, lim)  aio.sleepUntilIn(at, lim)   the same two, limited by lim     (SLEEPING)
//   aio.resolve(host, port)  a name looked up: its addresses       Result[List[SocketAddr], IoError]
//   aio.stat(path)         a file's size, attributes, time of last write   Result[FileStat, IoError]
//   aio.run(args, opts, dir)  a child process run and waited for, its output captured
//                                                                Result[process.Output, IoError]
//   aio.runLine(line, opts, dir)  the same for a command line written out by hand
//   aio.resolveIn(host, port, lim)  aio.statIn(path, lim)  aio.runIn(args, opts, dir, lim)
//   aio.runLineIn(line, opts, dir, lim)
//                           the same four, limited by lim                  (THE BLOCKING POOL'S WORK)
//   aio.isCancelled(e)  aio.isTimedOut(e)  aio.isTruncated(e)
//                           what an IoError says of how an operation ended
//   Socket.none()  File.none()  UdpSocket.none()
//                           a Socket, File or UdpSocket naming nothing: to swap one out of a Result
//   s.isNone()  s.handle()  f.isNone()  f.handle()  u.isNone()  u.handle()
//   Datagram {buf, from}    what a recvFrom answers: the datagram's bytes and its sender
//
// Each of the operations (and each sleep) makes an OPERATION, an actors.Awaitable[R], which
// does nothing until an 'await' in a behaviour starts it; the 'await''s value
// is its R. Made and never awaited, it is dropped, and nothing is done.
//
// WHAT THE SECOND HALF SEES. Each operation declares its own result, a Result:
// the success, or the operating system's failure, as a synchronous call that
// can fail answers. 'await' adds nothing to it, and the compiler refuses an
// 'await' on an operation whose value is not used (it holds the failure). A
// read's success is the buffer it was given back, the bytes that arrived
// appended to what it held: its length grows by the count, and does not grow
// at the clean end of the stream, the peer's close (iocore's Done(0)). The
// buffer is the read's one output, so it comes back in the answer rather
// than a count alone; a failed read's buffer goes home to its pool. A write's
// success is the count written, all of the buffer, which goes home. Accept's,
// connect's and listen's is the new Socket, which comes out of the Result by
// matching it: 'case let Ok(s)'.
//
// READS WITH NO BUFFER. 's.read()' is a read whose caller holds no buffer, and
// the connection holds none while it waits for the other end to speak: a
// thousand idle connections pin no memory, where a thousand 'read(IoBuf(4096))'
// pin 4 MiB (and the kernel locks the pages). The I/O side takes the buffer,
// from the pools, when bytes have come: 4 KiB, or the room 's.read(room)' asks
// for (a layer over aio that reads TLS records asks for 16 KiB; aio itself
// knows nothing of TLS). It comes back in the answer as a read's does, its
// length the bytes that arrived; at the clean end of the stream it is empty,
// and a buffer is never taken for a failed read. A read's bytes are the same
// either way; only when the buffer is taken differs, and so does the cost.
//
// Two ways to wait, and which one is chosen. WAITING WITHOUT A BUFFER is
// iocore's Op.RecvReady, a zero-byte receive: it ends when bytes are there (or
// the stream has ended), then a Recv with a buffer takes them. It costs a
// second trip through the system per read (iocore measured about 4 us more a
// round trip, 19 us against 15). WAITING WITH ONE is a Recv with a buffer
// started at once, which is the cheaper path when bytes are already coming.
// A read chooses by the socket's last: if its last read with no buffer was
// answered less than 'setReadQuiet' (2 ms) after it was started, the socket is
// CALM and this read takes a buffer at once; otherwise it waits without one. A
// socket's first read has no last, and waits without. And a read that began
// with a buffer and has waited the quiet time without a byte gives the buffer
// up (the receive is ended by a deadline of the quiet time, and begun again as
// a zero-byte one), so that a connection that was busy and has gone quiet pins
// nothing from then on, and its next read waits without a buffer. The most
// buffers pinned at once are those of the reads that began calm in the last
// quiet time. The hint is a flag in the socket's record (RECORDS), and the
// stage the read is in is in the read side that holds it.
// 'setReadQuiet' with a zero Duration makes every read wait without a buffer;
// with a long one a socket's reads after its first take one at once.
// 'read(buf)' is neither: the caller's buffer is in flight from the start, as
// before.
//
// The read is advanced on the I/O thread from one operation to the next: the
// side keeps the OpId of the iocore operation outstanding, replacing it with
// each new one, and the caller's deadline and group (its limits) for the whole
// read. A receive begun with a buffer carries a deadline of the quiet time
// when that is earlier than the caller's; when it ends TimedOut by that
// deadline, the buffer has come back with the answer and goes home, and the
// same side begins the read again as a zero-byte one, with the same limits. A
// read ended by a cancel, a deadline (the caller's, or its group's) or its
// socket's closing is answered as every operation is, exactly once; one still
// waiting when the program ends is abandoned like any awaited operation (THE
// PROGRAM'S END). The caller's deadline bounds the whole read, both of its
// operations.
//
// CANCEL AND DEADLINES. An operation is answered exactly once, as in iocore:
// Done (the Result's success), Failed (its error, the system's code),
// Cancelled or TimedOut. The last two are errors too, an IoError of a kind of
// its own (iocore's IoErrorKind: Os for a failure of the system, Cancelled,
// TimedOut), which 'isCancelled' and 'isTimedOut' read; their code is 0, and a
// genuine system error is never mistaken for either. (A fourth kind,
// Truncated, is a datagram cut to the room, UDP's.) The buffer a
// read or a write was given goes home to its pool. What limits an operation is
// a IoLimits, given to the 'In' form of the call: a cancel group (iocore's
// CancelGroup, a value that is copied, sent to other actors or threads, and
// whose one 'cancel()' ends every operation in it) and an absolute deadline
// (an Instant), the tighter of it and the group's (a group made 'until', or a
// 'childUntil' of one, carries its own). From a group's cancel on, an
// operation started in it is answered Cancelled at once; a deadline already
// past answers TimedOut at once. A cancel and a completion that race are
// settled by iocore: the answer is whichever came first (the Done, if the
// operation had finished), and there is never a second. A socket dropped
// while an operation on it is in flight ends it Cancelled, as a cancel does.
// The operation is one the I/O thread starts when the 'await' does, so a
// cancel from another actor or thread may arrive before it has started: the
// group's state, not the order of the calls, decides.
//
// ONE OPERATION ALONE. 's.cancelRead()' and 's.cancelWrite()' (on a Socket, a
// UdpSocket and a File) end the read, accept or receive in flight on the
// handle's read side, or the write or send on its write side, and nothing else
// of the handle's or of any group: the operation is answered Cancelled, with
// its buffer given back, as a group's cancel answers it, and a read with no
// buffer is ended whichever of its two operations it is in. They may be called
// from any thread and are idempotent. They reach the operation on the record's
// own side that has been STARTED (by its 'await'): there is nothing yet to end
// in one that has only been made, or that is not on the record's side because
// the side was busy (RECORDS, the second operation at once); a group or a
// deadline reaches those. With no operation in flight a cancel does nothing.
//
// RECORDS. Each Socket, UdpSocket and File has a RECORD, made with it on the I/O
// thread and freed when it is closed and nothing is using it. A record has two
// SIDES, a read side and a write side (accept and a UDP receive use the read
// side; send and a UDP send the write side). A side holds what its operation
// needs and no more: the buffer (to send, or to read into: while the system
// holds it, iocore does), the limits (the group and deadline), the reply to
// wake, the iocore OpId of the operation in flight (kept, so that
// 'cancelRead' and 'cancelWrite' can end it, and so that a read with no buffer
// can go from one operation to the next on the same side), and, for the
// operation's answer, a place of its own for it. An operation on a free side
// TAKES it when the operation is made ('conn.read(buf)': a bit set in the
// record's life word, by a compare-and-swap, from any thread) and the side is
// the operation: it is the Awaitable's context (actors.Awaitable.of: no closure
// is made), it is queued to the I/O thread as it is (it begins with the queue's
// link), the I/O thread starts the iocore operation from it with a token that
// names the record by slot and generation (an answer for a record freed and
// reused is known and dropped), and the typed answer is written into the side's
// place by the I/O thread. What the actor is told is that the answer is there:
// actors.answerLent, which allocates nothing; the actor's worker moves the
// answer out of the side into a place of its own, and gives the side back,
// before the behaviour goes on, so that a loop of reads takes the same side
// each time. Nothing is allocated for an operation on a record's own side:
// none of the Awaitable's closure, the job block, the hook's closure, the
// boxed reply, or the read's record, which an operation made before (opStats
// counts the operations begun on a record's own side and on the fallback).
//
// THE SECOND OPERATION AT ONCE. A side busy (an operation made and not yet
// answered, or only made and held, or whose answer has not been taken) cannot be
// taken again: two reads in flight on one socket, or a read made while another
// is held, are the fallback, as .NET's cached socket arguments are: the operation
// gets a SPILL BLOCK, a side (and place for its answer) of its own, allocated
// for the one operation and freed when its answer has been taken. It is correct
// and costs one allocation; a File takes many reads at once by design, and all
// but the first of them spill. A Socket.none() has no record, and each
// operation on it takes a spill block, to fail as it must. Operations that make
// a handle (listen, connect, bindUdp, openFile), a timer, a lookup, a file's
// metadata and a child process are not on a handle's side: they are jobs with
// their own allocations, as before, since each is one per connection or per
// request rather than per read.
//
// THE RECORD'S LIFE. The record is freed by whoever finds it closed with both
// sides idle: the I/O thread when the Socket's close job runs (the close cancels
// every operation in flight; each still answers, Cancelled), or the thread that
// takes the last answer out of a side, which asks the I/O thread to free it. On
// Windows the kernel holds a closed socket's receive until its completion
// arrives; the record, which holds no buffer the kernel uses (the buffer is
// iocore's by then), waits for that answer all the same, since the answer is
// written into it.
//
// A SOCKET is a handle on one of the I/O thread's sockets and its record: plain
// data, which moves (it may be sent in a message, to another actor). It declares
// itself Sendable, a promise taken on trust, for the record's address it holds:
// the record is freed only after the Socket is dropped, and a side is used by one
// operation at a time (RECORDS). Dropping it closes
// the socket: its finalizer queues the close on the I/O thread, behind the
// operations queued before it, and every operation then in flight on it is
// cancelled (iocore's 'close'). A Socket waiting in a paused behaviour's
// record stays open until the behaviour ends, as any value does.
//
// THE I/O THREAD. One thread, started by the first operation awaited, owns
// the actor runtime's iocore Loop and waits in its poll; it is the one thread
// that touches the Loop, as iocore asks. The actors' workers never wait on
// I/O (they could not: an actor's behaviour runs to its 'await' and
// returns). An 'await' on an operation hands it to the I/O thread through a
// QUEUE: a list of jobs under a Mutex, which the I/O thread takes whole after
// each poll, and a Waker that ends the poll at once. A socket's, UDP socket's
// and file's operations are started on the Loop with a Target.Here: the answer
// comes to the I/O thread's own poll, with the token that names the side, and
// the I/O thread writes it into the side and tells the actor (RECORDS). The
// other operations (a timer, a lookup, a connect) use a Target.Hook, iocore's
// target for another runtime's code: when the operation's one answer comes, the
// hook turns it into the operation's result and writes it into the reply the
// 'await' is waiting for. Either way the reply goes to the actor's mailbox as
// any reply does -- one push, and, if the actor was idle, its scheduling.
// Nothing of the actor runs on the I/O thread.
//
// AN ACTOR'S LIFE. An operation in flight holds a count of the actor that
// awaits it, in its reply's envelope, as a request to another actor does: the
// actor lives until the answer comes, whether or not anything else holds it.
// A socket whose peer never answers keeps its reader alive for as long.
//
// THE PROGRAM'S END. The package's finalizer, which finalAll() runs before
// the actors package's, waits until no actor is queued or running (an actor
// paused on I/O is neither), then ends the I/O: the I/O thread stops taking
// jobs, and its Loop dies, which cancels every operation still in flight and
// then closes every socket. Their answers are not delivered: each paused
// behaviour is ABANDONED. Its reply's envelope is dropped, letting go of the
// actor's count, and an actor with nothing else holding it dies; its pending
// table then drops the records still parked, so every value a paused
// behaviour held is finalized, in the order its 'await' would have had them
// die, and the rest of the behaviour never runs. An operation awaited after
// that is abandoned the same way at once. Then the actors package's own
// finalizer waits for quiet again (a finalizer that ran may have sent a
// message) and stops the workers. A program that wants its actors' awaited I/O
// finished before it ends calls 'actors.waitUntilIdle()' last in 'main' (an
// INTERIM call: the actors package's header, WAITING FOR IDLE).
//
// A UDP SOCKET is a UdpSocket, a kind of its own beside Socket and File: a
// stream operation on it (read, write, accept), or a datagram one on a Socket,
// does not compile. Like a Socket it is plain data that moves, and dropping it
// closes the socket behind the operations queued before the close, every one
// then in flight on it cancelled. 'bindUdp' binds by iocore's 'bindUdp' on the
// I/O thread (port 0 has the system choose one, which 'localAddr' tells), as
// 'listen' listens; it has no 'In' form. The socket is not connected: each
// datagram names its other end. 'recvFrom' is iocore's RecvFrom: ONE datagram,
// appended to the buffer's room, the answer a Datagram, its 'buf' the buffer
// given (its length grown by the datagram's) and its 'from' the sender. A
// datagram of no bytes is a datagram, not an end: the buffer's length does not
// grow. A buffer with no room fails (122), as a read's does. A datagram longer
// than the room fails with an IoError of the kind Truncated ('aio.isTruncated',
// code 10040, WSAEMSGSIZE, on both systems): the rest of it is lost, the next
// one is whole, and the buffer, as a failed read's, goes home to its pool, the
// bytes that fitted with it. 'sendTo' is iocore's SendTo: all of the buffer as
// ONE datagram, the buffer going home; the count is its length; UDP promises no
// delivery, so the answer says the system took the datagram. A datagram too
// large for the network fails (10040, an Os error). One receive at a time per
// socket is the supported use, as iocore says; datagrams that arrive while none
// is outstanding wait in the socket's buffer, which the OS bounds.
//
// A FILE is the same for a file the I/O thread's Loop holds: plain data that
// moves, and dropping it closes the file, behind the operations queued before
// the close, every one then in flight on it cancelled. 'openFile' opens by
// iocore's 'openFile' on the I/O thread (Access.Read an existing file;
// Access.Create a new one, or an existing one emptied, to read and write;
// Access.Update an existing one or a new one, its bytes kept, to read and
// write) and answers the File, or the system's failure (ERROR_FILE_NOT_FOUND
// for a name that is not there, on both systems). The path is copied, so the
// caller's Path is its own. 'readAt' and 'writeAt' are iocore's ReadAt and
// WriteAt: at the byte offset given, with no cursor shared between operations,
// so many may be in flight on one file at once. A read appends what is there
// to its buffer, up to the buffer's room; reading from the end of the file or
// past it is Done with the buffer as it went, as a socket's end of stream is,
// and a buffer with no room fails (122), as a socket's does. A write's success
// is the count written, all of the buffer. The buffer goes home as a
// socket's does. 'openFile' has no 'In' form: opening is one call to the
// system that iocore does not hold in flight, so there is nothing to cancel
// once it has started; the two operations on a file have theirs.
//
// SLEEPING. 'sleep(d)' and 'sleepUntil(at)' are iocore's timers ('after',
// 'afterIn') awaited: the behaviour pauses, and the I/O thread's Loop answers
// when the time comes. 'd' counts from the moment the I/O thread starts the
// timer, a moment after the 'await'; 'at' is absolute, and one already past is
// answered at once. The success holds nothing (Result[void, IoError]). The 'In'
// forms take an IoLimits as the other operations do, and honour the group's
// deadline as iocore's 'afterIn' does: a sleep due after the deadline (lim's,
// or its group's, the tighter) is answered TimedOut at the deadline, one due
// at or before it is Done at its time; the group's cancel answers Cancelled,
// at once if the group is cancelled already. lim's deadline is given to the
// timer as a group of its own (a child of lim's group, or a new one), since
// iocore's timer takes a group alone. Dropped unawaited, a sleep does nothing.
//
// THE BLOCKING POOL'S WORK. 'resolve', 'stat' and 'run' are the three things
// iocore's blocking pool (its THE BLOCKING POOL) does for work with no
// completion form, each awaited as the rest: the operation is started on the
// I/O thread's Loop with an iocore Op, a thread of the pool does it, and the
// answer comes to the actor as any other. The job is answered exactly once, as
// iocore says: a job still queued for a thread is taken out by a cancel or a
// deadline (Cancelled, TimedOut, never run); one a thread has taken cannot be
// stopped, and answers when it ends, except that a deadline answers TimedOut
// at the deadline (past iocore's 1 ms grace) and the work goes on, its answer
// dropped. A lane whose queue is full refuses a job at once (Failed 170,
// ERROR_BUSY). The pool's lanes: 'resolve' uses the DNS lane (2 threads), 'stat'
// and 'run' the general lane (4 threads). Each of these takes a buffer
// (IoBuf(n), made for the call) for iocore's op to carry its answer in; it goes
// home with the answer.
//
// 'resolve(host, port)' is iocore's 'resolveOp' (getaddrinfo, the stream socket
// type): 'host' is a name or an address as text, and every address found is a
// SocketAddr with 'port' (its default 0): IPv4 and IPv6 as the system gives
// them, in its order. A name with no address fails with the system's number
// (Winsock's, 11001 WSAHOST_NOT_FOUND for a name that is not there; on Linux
// getaddrinfo's failure is given the Winsock number that names the same). The
// list is not empty when the answer is Ok.
//
// 'stat(path)' is iocore's 'statOp': the FileStat has the size in bytes, the
// attributes (Windows' FILE_ATTRIBUTE_ bits, on Linux made from the mode: 0x10
// a directory, 0x80 a plain file, 0x1 read-only) and the time of last write, a
// Timestamp; 'isDir()' reads the bit. A path that is not there fails with
// ERROR_FILE_NOT_FOUND (2) on both systems. The path is copied; a path that is
// not UTF-8 fails (ERROR_NO_UNICODE_TRANSLATION, 1113). Folders and files are
// told apart by the attributes; a symbolic link is followed on Linux, as 'stat'
// does.
//
// CHILD PROCESSES. 'run' and 'runLine' are the process package's synchronous
// 'run' and 'runLine', awaited: the same arguments (the same Options: a
// 'timeout' that stops the child and everything it started, 'inherit', 'crashReport';
// the same folder), the same Output (exit code, a signal on POSIX, 'timedOut',
// standard output and standard error captured apart), and the same rules for
// the program ('process' says them: how Windows finds it and quotes the
// arguments, what '/bin/sh -c' is). Only the waiting is different: the
// process package's call runs on a thread of the pool's general lane, and the
// actor's behaviour pauses until it ends. An exit code is an answer (Ok); an
// Error is a program that could not be started, an IoError of the system's
// number (the process package's ProcessError code, which is errno on Linux,
// turned into the Windows number iocore uses for IoError everywhere). The
// ProcessError's text (the program's name, the folder) is not carried: the
// caller has them. 'args' and 'dir' are copied.
//
// What the pool's thread does not give: a child's pipes to read or write
// while it runs, or to wait for it apart from starting it. A run is spawn,
// wait and the captured standard output and standard error in one awaited
// call, as the process package's is, because that is the process package's
// whole interface; a Child you spawn, then await, and whose output you read
// piece by piece would need that package to offer a spawn that returns the
// pipes, and the pipes to be handles iocore's Loop holds (a new op in iocore).
// A deadline or a cancel does not stop a child that is running: put a
// 'timeout' in the Options for that. A child still running when the program
// ends is left to the system (its pool thread is not waited for, as iocore says);
// the memory of its answer is not freed.
//
// METHOD CHOICES (defaults, not rulings):
//  - 'run' is the process package's synchronous 'run' on a thread of iocore's
//    general lane, not a new op in iocore's loop (no async process wait exists
//    there, and a pipe cannot be given to the Loop). The thread waits for the
//    child, as that package's 'run' does; at most four children (the lane's
//    threads) run at once, and a fifth waits queued (a cancel group takes it
//    out), more than 1,024 queued are refused (ERROR_BUSY).
//  - The answer of a run (the Output) is left by the pool thread in a block of
//    its own, which the I/O thread's hook reads; whichever of the two comes
//    last frees the block, by a small state word the two swap (the run's
//    state below). A job that comes back unrun comes back with its buffer,
//    which is how the hook knows it, so each run takes a one-byte buffer
//    made for the call.
//  - A start failure is an IoError with the system's number (Windows') on both
//    systems; iocore has one function more for it, 'systemCode', which turns an
//    errno into that number.
//  - A read with no buffer ('read()') is two operations, a RecvReady and a Recv,
//    advanced on the I/O thread when the first is answered to it (the loop
//    forbids a hook to call back into the loop); the quiet time is 2 ms, the
//    room 4 KiB, and "calm" is "the socket's last such read was answered within
//    the quiet time" (READS WITH NO BUFFER). None of these was ruled on.
//  - A handle's operations are a RECORD's two sides, taken at the call that
//    makes the operation, not at its 'await': an Awaitable made and held keeps
//    its side busy, and the next operation on that side spills. The other
//    way, taking it at the 'await', would let the buffer sit in the
//    Awaitable, which is a context word and has no room for it.
//  - The fallback is a spill block per operation (one allocation), not the
//    general job path it was before: one path serves both, the answer is typed
//    the same, and the cost of the fallback is one allocation where it was
//    four. A single operation's cancel ('cancelRead', 'cancelWrite') reaches
//    only an operation on a record's own side.
//  - The record's table is the slots package's SlotTable, one thread's (the I/O
//    thread's); its chunks are the C library's blocks, since a chunk is taken a
//    few times in a table's life and never given back, which the iobuf
//    package's per-thread block caches have nothing to serve.
//  - Socket, UdpSocket and File declare themselves Sendable, a promise taken on
//    trust, because they hold the record's address (RECORDS).
//  - 'stat' and 'resolve' make their buffer for the call, not
//    one the caller passes; 'resolve' has the port as its second parameter
//    with a default of 0, and gives a List, whole.
//  - There is no 'readFile' (iocore's 'readFileOp'): a file opened with
//    'openFile' and read with 'readAt' does what it does, with the buffer the
//    caller chooses.
//
// On Windows and Linux, as iocore is; TCP sockets, UDP sockets and files (a
// socket does one operation at a time per direction, as iocore's do; a file
// many at once, at any offsets), names, file metadata and child processes. Not
// here: 'fileio', the file service with classes and a queue-depth governor (a
// package of its own, to come), a file's metadata by its handle, a child's
// pipes while it runs (above), and a socket's half-close.

mod aio;

import libc;
import thread;
import sync use Mutex;
import collections use List, String;
import iobuf use IoBuf;
import slots use SlotTable, Slot;
import time use Instant, Duration;
import iocore use Loop, Waker, Op, OpId, Target, Sink, Completion, Handle, SocketAddr, IoError, CancelGroup, Access, Outcome, Lane, FileStat, forever, resolveOp, addressesIn, statOp, fileStatIn, systemCode, errorOperationAborted;
import path use Path;
import process;
import actors;
import diag;

fn @initpure init() {
  ioLock = Mutex.make();
  io = Atomic[usize].of(0usize);
  ended = Atomic[bool].of(false);
  readQuiet = Atomic[i64].of(2000000i64);
}

// A panic, reported at the line calling 'die'
fn die(msg: &str, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Never {
  panic(msg, file, line)
}

// ---------------------------------------------------------------------------
// The I/O thread and its queue
// ---------------------------------------------------------------------------

// A job's header, first in its block: the next job queued, and the functions
// made for the job's type, which take the block
struct JobHead {
  pub next: *JobHead;
  pub run: &fn(job: *u8, lp: &mut Loop);
  pub drop: &fn(job: *u8);
}

// A job: its header, then what it is. J has 'run(self: &mut, lp &mut Loop)'
struct Job[J] {
  pub head: JobHead;
  pub body: J;
}

// The I/O thread, once started: its queue, under ioLock, and its loop's
// waker, set before 'ready' and never changed. It lives as long as the
// process, the waker with it: a thread that queued a job just before the end
// may still be waking the loop after the thread has been joined
struct IoThread {
  pub head: *JobHead;
  pub tail: *JobHead;
  pub waker: Waker;
  pub ready: Atomic[u32];       // 1 once the thread has put its waker here
  pub os: thread.Thread[u32];
  // The rest is the I/O thread's, never touched by another (RECORDS): the
  // table of records, one per handle; the operations on a spill block in
  // flight, as a list; and counts
  pub recs: SlotTable[Rec];
  pub spills: *Spill;
  pub fast: u64;                // operations started on a record's own side
  pub spilled: u64;             // ...and on a spill block, the side being busy
}

// Guards the queue, 'io' and 'ended'
let ioLock: Mutex;

// The I/O thread, or 0 before the first operation is awaited. Read and written
// under ioLock by any thread; an atomic held by a 'let' global, set in 'init'
let io: Atomic[usize];

// The program is ending: no job is taken from now on (under ioLock). An atomic
// held by a 'let' global, set in 'init'
let ended: Atomic[bool];

// The I/O thread's Loop is dying: what it delivers is abandoned. Read and
// written by the I/O thread alone, so each thread has its own copy
var @threadlocal abandoning = false;

fn nullJob() *JobHead {null}

// A job's block, its body moved in
fn newJob[J](body: J) *u8 {
  let p = libc.malloc(mem.sizeof[Job[J]]()) as *Job[J];
  if p as usize == 0usize {
    die("aio: out of memory for an operation");
  }
  (*p).head = JobHead(nullJob(), &runJob[J], &dropJob[J]);
  mem.writeRaw[J](&(*p).body as *J, body);
  p as *u8
}

// On the I/O thread: the job's body moved out, its block freed, and run
fn runJob[J](job: *u8, lp: &mut Loop) {
  let p = job as *Job[J];
  var body = mem.readRaw[J](&(*p).body as *J);
  libc.free(job);
  body.run(lp);
}

// A job never run: its body dropped (an operation's reply among it,
// abandoning what awaits it), its block freed
fn dropJob[J](job: *u8) {
  let p = job as *Job[J];
  let body = mem.readRaw[J](&(*p).body as *J);
  libc.free(job);
}

fn dropHead(h: *JobHead) {
  let f = (*h).drop;
  f(h as *u8);
}

// Queue a job for the I/O thread, starting the thread if this is the first;
// once the program is ending, the job is dropped instead
fn enqueue(job: *u8) {
  let h = job as *JobHead;
  (*h).next = nullJob();         // a record's job is used again and again: its link is not fresh
  ioLock.lock();
  if ended.load() {
    ioLock.unlock();
    dropHead(h);
    return;
  }
  if io.load() == 0usize {
    startIo();
  }
  let t = io.load() as *IoThread;
  if (*t).tail as usize == 0usize {
    (*t).head = h;
  } else {
    (*(*t).tail).next = h;
  }
  (*t).tail = h;
  ioLock.unlock();
  (*t).waker.wake();
}

// What the I/O thread is handed: its IoThread, where it puts its loop's waker
struct IoArg {
  pub t: usize;
}

// Start the I/O thread, under ioLock: its Loop is made on it, and its waker
// is in place before this returns
fn startIo() {
  // What the records rely on: a value's owner word is the one before it, and
  // each side's place holds the largest answer of its direction
  var probe = blankAnsR();
  if (&probe.v[0usize] as *u8 as usize) - (&probe as *AnsR as usize) != 8usize {
    die("aio: an AnsR's value is not the word after its owner");
  }
  if mem.sizeof[SocketAddr]() > 32usize {
    die("aio: a SocketAddr is larger than the place a send's destination waits in");
  }
  if mem.sizeof[Result[IoBuf, IoError]]() > 96usize || mem.sizeof[Result[Datagram, IoError]]() > 96usize
      || mem.sizeof[Result[Socket, IoError]]() > 96usize || mem.sizeof[Result[usize, IoError]]() > 32usize {
    die("aio: an answer is larger than the place the record keeps for it");
  }
  let t = libc.calloc(1usize, mem.sizeof[IoThread]()) as *IoThread;
  if t as usize == 0usize {
    die("aio: out of memory for the I/O thread");
  }
  mem.writeRaw[thread.Thread[u32]](&(*t).os as *thread.Thread[u32],
    thread.startWith(thread.Options(name: "aio I/O"), IoArg(t as usize), &ioMain));
  while (*t).ready.load() == 0u32 {
    sync.futexWait(&(*t).ready, 0u32);
  }
  io.store(t as usize);
}

// The I/O thread: it waits in its Loop's poll, and after each, takes the
// jobs queued and runs them -- each starts an operation on the Loop, whose
// answer goes to its hook. Once the program is ending it drops what is
// queued, and its Loop dies: every operation in flight is cancelled and
// every socket closed, and what the Loop delivers then is abandoned
fn ioMain(arg: IoArg) u32 {
  {
    let me = arg.t as *IoThread;
    var lp = Loop.mustMake();
    mem.writeRaw[Waker](&(*me).waker as *Waker, lp.waker());
    mem.writeRaw[SlotTable[Rec]](&(*me).recs as *SlotTable[Rec], SlotTable[Rec].make(64u32));
    onIo = true;
    (*me).ready.store(1u32);
    sync.futexWake(&(*me).ready);
    var out = List[Completion].empty();
    var more = true;
    while more {
      lp.poll(forever(), &mut out);
      ioLock.lock();
      let t = io.load() as *IoThread;
      var h = nullJob();
      if t as usize != 0usize {
        h = (*t).head;
        (*t).head = nullJob();
        (*t).tail = nullJob();
      }
      let stop = ended.load();
      ioLock.unlock();
      // The answers that came to this thread itself: the records' operations
      sidesDone(me, &mut lp, &mut out, stop);
      while h as usize != 0usize {
        let next = (*h).next;
        if stop {
          dropHead(h);
        } else {
          let f = (*h).run;
          f(h as *u8, &mut lp);
        }
        h = next;
      }
      more = !stop;
    }
    // An operation still waiting is abandoned, as every awaited operation is:
    // its reply is dropped, letting go of the actor that awaits it
    dropSides(me);
    abandoning = true;
  }
  // The table is kept as long as the process unless no record is left in it:
  // a Socket, File or UdpSocket dropped (or a spill block's answer released)
  // after this finds its memory still there
  let mine = arg.t as *IoThread;
  if (*mine).recs.len() == 0usize {
    mem.finalize[SlotTable[Rec]](&(*mine).recs as *SlotTable[Rec]);
    mem.writeRaw[SlotTable[Rec]](&(*mine).recs as *SlotTable[Rec], SlotTable[Rec].make(64u32));
  }
  0u32
}

// The package's finalizer, run by finalAll() before the actors package's:
// once no actor is queued or running, the I/O ends, and every behaviour
// still paused on it is abandoned (the package's header, THE PROGRAM'S END)
fn final() {
  actors.waitQuiet();
  ioLock.lock();
  ended.store(true);
  let t = io.load() as *IoThread;
  ioLock.unlock();
  if t as usize == 0usize {
    return;
  }
  (*t).waker.wake();
  let th = mem.readRaw[thread.Thread[u32]](&(*t).os as *thread.Thread[u32]);
  th.join();
}

// ---------------------------------------------------------------------------
// Operations: what an 'await' starts, and how each answer comes back
// ---------------------------------------------------------------------------

// The seam starts an operation: the reply its answer goes back in is written
// into the job, which goes to the I/O thread (actors.Awaitable's closure)
fn startJob[J](ctx: *u8, rp: actors.Reply) {
  let p = ctx as *Job[J];
  (*p).body.reply = rp;
  enqueue(ctx);
}

// A job's block until the 'await' starts it: 'take' hands it on, and an
// Awaitable that dies unawaited, its closure finalized, drops the job it still
// holds (its body dropped, an operation's reply among it)
struct JobHold is Move {
  job: *u8;

  fn take(self: &mut) *u8 {
    let j = job;
    job = null;
    j
  }

  fn final(self: &uni) {
    if job as usize != 0usize {
      dropHead(job as *JobHead);
    }
  }
}

// The operation awaited: its job, made now, started by the 'await'
fn awaitable[J, R](body: J) actors.Awaitable[R] {
  actors.Awaitable[R].make(fn(rp: actors.Reply) [var held = JobHold(newJob[J](body))] {
    startJob[J](held.take(), rp);
  })
}

// What limits an awaited operation (the package's header, CANCEL AND
// DEADLINES): a cancel group, one cancel of which ends it, and an absolute
// deadline, the tighter of it and the group's. Made by 'none', 'until' or
// 'within', or by hand: 'IoLimits(Some[CancelGroup](g), d)'
pub struct IoLimits {
  pub group: Option[CancelGroup];
  pub deadline: Instant;

  // Neither: the operation ends when it finishes
  pub fn none() IoLimits {IoLimits(None, forever())}

  // Answered TimedOut if not finished by deadline
  pub fn until(deadline: Instant) IoLimits {IoLimits(None, deadline)}

  // Ended by the group's cancel, and by its deadline if it has one
  pub fn within(group: CancelGroup) IoLimits {IoLimits(Some[CancelGroup](group), forever())}
}

// Whether an operation ended because it was cancelled: its group's cancel, or
// its socket closed
pub fn isCancelled(e: IoError) bool {e.isCancelled()}

// Whether an operation ended because its deadline passed
pub fn isTimedOut(e: IoError) bool {e.isTimedOut()}

// Whether a receive ended because the datagram was longer than the buffer's room
pub fn isTruncated(e: IoError) bool {e.isTruncated()}

// An iocore operation, awaited: the Op, what limits it, the reply its answer
// goes back in, and the function that makes the answer an R
struct OpJob[R] {
  pub op: Op;
  pub limits: IoLimits;
  pub reply: actors.Reply;
  pub answer: &fn(c: &mut Completion) R;

  // Start the operation on the I/O thread's Loop, its answer to a hook that
  // holds the reply, in its group if it has one
  fn run(self, lp: &mut Loop) {
    let rp, o, limits, answer = self.(reply, op, limits, answer);
    let to = Target.Hook(0u64, Sink.make(waiting[R](rp, answer)));
    submitLimited(lp, o, to, &limits);
  }
}

// Start an operation on the I/O thread's Loop, in the group lim names if it
// names one, bounded by its deadline if it has one
fn submitLimited(lp: &mut Loop, o: Op, to: Target, lim: &IoLimits) OpId {
  submitLimitedBy(lp, o, to, lim, lim.deadline)
}

// The same with a deadline of the caller's choosing in place of lim's (the
// tighter of the two, which the caller has found). The operation's OpId
fn submitLimitedBy(lp: &mut Loop, o: Op, to: Target, lim: &IoLimits, deadline: Instant) OpId {
  match lim.group {
    case let Some(g) {lp.submitIn(o, to, g, deadline)}
    else {
      if deadline < forever() {
        lp.submitBy(o, to, deadline)
      } else {
        lp.submit(o, to)
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Records: one per handle, a side for each direction (the package's header,
// RECORDS)
// ---------------------------------------------------------------------------

// A record's life word: closed (its handle has been closed; no operation may
// begin on it), and a busy bit for each side, set from the moment an operation
// takes the side until the awaiting actor has taken the answer out of it. The
// record is freed by whoever finds it closed with both sides idle
const lifeClosed = 1u32;
const lifeBusyRead = 2u32;
const lifeBusyWrite = 4u32;
const lifeBusy = 6u32;

// What a side is doing: which operation, and so which typed answer
const opRecv = 1u32;          // read(buf): Result[IoBuf, IoError]
const opRecvAny = 2u32;       // read(), read(room): the same, with a buffer the I/O side takes
const opAccept = 3u32;        // Result[Socket, IoError]
const opSend = 4u32;          // write(buf): Result[usize, IoError]
const opReadAt = 5u32;        // a file's read: Result[IoBuf, IoError]
const opWriteAt = 6u32;       // a file's write: Result[usize, IoError]
const opRecvFrom = 7u32;      // a datagram: Result[Datagram, IoError]
const opSendTo = 8u32;        // Result[usize, IoError]

// The room a read with no buffer of its own is given when it names none: the
// pool's smallest block
fn defaultRoom() usize {4096usize}

// A read that holds a buffer gives it up if no byte has come in this long (2
// ms by default), and waits with a zero-byte receive instead; a socket whose
// last read came in less than this is "calm", and its next read takes a buffer
// at once. Read by the I/O thread, set by 'setReadQuiet' (an atomic held by a
// 'let' global, set in 'init')
let readQuiet: Atomic[i64];

fn quietNanos() i64 {readQuiet.load()}

// Set how long a read with no buffer may hold one before giving it up (the
// package's header, READS WITH NO BUFFER): zero makes every such read wait
// with a zero-byte receive, a long time makes a socket's reads take a buffer
// at once after its first. Affects reads started from now on
pub fn setReadQuiet(d: Duration) {
  readQuiet.store(d.nanos());
}

// Where a read with no buffer is: a zero-byte receive is outstanding; a receive
// with a buffer, started at once, is; the receive with a buffer that takes what
// the zero-byte one said had come
fn stageReady() u32 {0u32}
fn stageStraight() u32 {1u32}
fn stageTake() u32 {2u32}

// The place an answer is written in, before the awaiting actor takes it out:
// the owning side's address first (the word before the value, which is how
// 'releaseAns' finds its side from the value's address), then the value. The
// read side's holds the largest answer of a read: a Datagram's Result; the
// write side's a count's
struct AnsR {
  pub owner: *Side;
  pub v: Array[u64, 12];
}

struct AnsW {
  pub owner: *Side;
  pub v: Array[u64, 4];
}

fn blankAnsR() AnsR {AnsR(null, Array[u64, 12]() <- fill 0u64)}
fn blankAnsW() AnsW {AnsW(null, Array[u64, 4]() <- fill 0u64)}

// One direction of one handle: the operation now using it, whatever that
// operation holds while it is in flight, and where its answer waits. It is a
// job (its header first), so that the queue to the I/O thread takes it as it
// is. Fields are written by whoever has taken the side (the busy bit), and by
// the I/O thread while the operation is in flight, never by two at once
struct Side {
  pub head: JobHead;
  pub rec: *Rec;                  // null for a spill block's
  pub h: Handle;
  pub reply: actors.Reply;
  pub limits: IoLimits;
  pub buf: IoBuf;                 // the buffer to send, or to read into: in flight it is iocore's
  pub arg: u64;                   // a file operation's byte offset; a read with no buffer: the room of the one it takes
  pub opid: OpId;                 // the iocore operation now in flight, kept for cancel
  pub since: i64;                 // when the operation now outstanding was started (the steady clock)
  pub ansp: *u8;                  // where its answer is written (the value after its AnsR's or AnsW's owner word)
  pub what: u32;
  pub stage: u32;                 // a read with no buffer: stageReady ...
  pub write: bool;
  pub ours: bool;                 // a read with no buffer: its deadline is quietNanos', tighter than the caller's
}

fn blankSide() Side {
  Side(JobHead(nullJob(), &runSide, &dropSide), null, Handle.none(), actors.Reply(), IoLimits.none(),
    IoBuf.empty(), 0u64, OpId.none(), 0i64, null, 0u32, 0u32, false, false)
}

// The record of a handle: made with it (on the I/O thread), freed when it is
// closed and nothing is using it. It lives in a table of stable cells, found
// by its slot and generation (the iocore operation's token) or by the address
// a Socket, File or UdpSocket holds
struct Rec {
  pub life: Atomic[u32];
  pub index: u32;
  pub gen: u32;
  pub calm: bool;                 // its last read with no buffer came quickly (READS WITH NO BUFFER)
  pub rd: Side;
  pub rdAns: AnsR;
  pub wr: Side;
  pub wrAns: AnsW;
}

fn blankRec() Rec {
  Rec(Atomic[u32].of(0u32), 0u32, 0u32, false, blankSide(), blankAnsR(), blankSide(), blankAnsW())
}

// A side with no record, made for an operation when the record's own is busy,
// or there is no record (a Socket.none()): the side, then its answer's place;
// and, while the operation is in flight, the I/O thread's list of them
struct Spill {
  pub side: Side;
  pub ans: AnsR;
  pub prev: *Spill;
  pub next: *Spill;
}

fn nullSide() *Side {null}
fn nullRec() *Rec {null}

// True on the I/O thread alone
var @threadlocal onIo = false;

fn tableOf(t: *IoThread) *SlotTable[Rec] {&(*t).recs as *SlotTable[Rec]}

// A record for the handle just made, in the table: on the I/O thread
fn newRec(t: *IoThread) *Rec {
  let tb = tableOf(t) as &mut SlotTable[Rec];
  let slot = tb.add(blankRec());
  let r = tb.get(slot);
  (*r).index = slot.index;
  (*r).gen = slot.gen;
  (*r).rd.rec = r;
  (*r).wr.rec = r;
  (*r).wr.write = true;
  (*r).rd.ansp = &(*r).rdAns.v[0usize] as *u8;
  (*r).wr.ansp = &(*r).wrAns.v[0usize] as *u8;
  (*r).rdAns.owner = &(*r).rd as *Side;
  (*r).wrAns.owner = &(*r).wr as *Side;
  r
}

// A record freed: on the I/O thread. Whatever its sides still hold is let go
fn freeRec(rec: *Rec) {
  let t = io.load() as *IoThread;
  let tb = tableOf(t) as &mut SlotTable[Rec];
  tb.removeAt((*rec).index);
}

// The values the module's handles are made into, on the I/O thread
fn newSocket(h: Handle) Socket {
  if h.isNone() {
    return Socket.none();
  }
  let t = io.load() as *IoThread;
  Socket(h, newRec(t))
}

fn newFile(h: Handle) File {
  if h.isNone() {
    return File.none();
  }
  let t = io.load() as *IoThread;
  File(h, newRec(t))
}

fn newUdp(h: Handle) UdpSocket {
  if h.isNone() {
    return UdpSocket.none();
  }
  let t = io.load() as *IoThread;
  UdpSocket(h, newRec(t))
}

// The side an operation on this handle uses: the record's own for the
// direction if it is free (taken now, by setting its busy bit), else a spill
// block, made for the one operation (the package's header, RECORDS: the
// fallback). The caller fills it, and the operation begins when the awaited
// Awaitable is started
fn beginSide(rec: *Rec, h: Handle, write: bool, what: u32) *Side {
  if rec as usize != 0usize {
    let bit = if write {lifeBusyWrite} else {lifeBusyRead};
    var v = (*rec).life.load();
    while (v & (lifeClosed | bit)) == 0u32 {
      let seen, ok = (*rec).life.compareSwap(v, v | bit);
      if ok {
        var s = &(*rec).rd as *Side;
        if write {
          s = &(*rec).wr as *Side;
        }
        (*s).what = what;
        (*s).h = h;
        return s;
      }
      v = seen;
    }
  }
  let blk = libc.malloc(mem.sizeof[Spill]()) as *Spill;
  if blk as usize == 0usize {
    die("aio: out of memory for an operation");
  }
  mem.writeRaw[Spill](blk, Spill(blankSide(), blankAnsR(), null, null));
  let s = &(*blk).side as *Side;
  (*blk).ans.owner = s;
  (*s).ansp = &(*blk).ans.v[0usize] as *u8;
  (*s).write = write;
  (*s).what = what;
  (*s).h = h;
  s
}

// The side as an Awaitable[R]: nothing is allocated; its context word is the
// side
fn sideAwaitable[R](s: *Side) actors.Awaitable[R] {
  actors.Awaitable[R].of(s as *u8, &startSide, &dropSide)
}

// The seam starts the operation: the reply its answer goes back in is written
// into the side, which goes to the I/O thread as it is
fn startSide(ctx: *u8, rp: actors.Reply) {
  (*(ctx as *Side)).reply = rp;
  enqueue(ctx);
}

// An Awaitable that dies unawaited, or a queue dropped at the program's end:
// what the side holds is let go and the side given back
fn dropSide(job: *u8) {
  let s = job as *Side;
  resetSide(s);
  releaseSide(s);
}

// What a side holds is let go: its buffer goes home, its reply is dropped,
// its limits forgotten
fn resetSide(s: *Side) {
  var b = IoBuf.empty();
  b <-> (*s).buf;
  var r = actors.Reply();
  r <-> (*s).reply;
  (*s).limits = IoLimits.none();
  (*s).opid = OpId.none();
}

// The side is the actor's no more, answer taken or never made: its busy bit is
// cleared, and the record freed if it is closed and the other side idle. A
// spill block is freed. Any thread
fn releaseSide(s: *Side) {
  let rec = (*s).rec;
  if rec as usize == 0usize {
    mem.finalize[Side](s);
    libc.free(s as *u8);
    return;
  }
  let bit = if (*s).write {lifeBusyWrite} else {lifeBusyRead};
  let old = (*rec).life.bitAnd(~bit);
  if (old & lifeClosed) != 0u32 && (old & lifeBusy & ~bit) == 0u32 {
    if onIo {
      freeRec(rec);
    } else {
      // Both sides are idle, so the read side's job header is free to carry
      // the record's reaping to the I/O thread
      (*rec).rd.head.run = &runReap;
      (*rec).rd.head.drop = &dropReap;
      enqueue(&(*rec).rd as *u8);
    }
  }
}

// The awaiting actor has taken the answer from where 'deliver' put it: the
// word before the value names its side
fn releaseAns(p: *u8) {
  let s = *((p - 8usize) as **Side);
  releaseSide(s);
}

// A record found closed and idle by another thread: freed here
fn runReap(job: *u8, lp: &mut Loop) {
  freeRec((*(job as *Side)).rec);
}

fn dropReap(job: *u8) {}

// The token of a side's iocore operations: a record's side by its slot,
// generation and direction (so that an answer for a record freed and reused
// is known and dropped), a spill block's by its address
fn tokenOf(s: *Side) u64 {
  let rec = (*s).rec;
  if rec as usize == 0usize {
    return u64.from(s as usize) | 2u64;
  }
  let dir = if (*s).write {1u64} else {0u64};
  (u64.from((*rec).gen) << 32u64) | (u64.from((*rec).index) << 2u64) | dir
}

// The side a token names, or null if it names none (token 0, or a record gone)
fn sideOf(t: *IoThread, token: u64) *Side {
  if token == 0u64 {
    return nullSide();
  }
  let tag = token & 3u64;
  if tag == 2u64 {
    return usize.from(token & ~3u64) as *Side;
  }
  let tb = tableOf(t) as &mut SlotTable[Rec];
  let rec = tb.get(Slot(u32.from((token >> 2u64) & 0x3FFFFFFFu64), u32.from(token >> 32u64)));
  if rec as usize == 0usize {
    return nullSide();
  }
  if tag == 1u64 {
    return &(*rec).wr as *Side;
  }
  &(*rec).rd as *Side
}

// A spill block in flight is on the I/O thread's list (a Side is the first thing
// in its Spill)
fn linkSpill(t: *IoThread, side: *Side) {
  let s = side as *Spill;
  let head = (*t).spills;
  (*s).prev = null;
  (*s).next = head;
  if head as usize != 0usize {
    (*head).prev = s;
  }
  (*t).spills = s;
}

fn unlinkSpill(t: *IoThread, side: *Side) {
  let s = side as *Spill;
  let before = (*s).prev;
  let after = (*s).next;
  if before as usize != 0usize {
    (*before).next = after;
  } else {
    (*t).spills = after;
  }
  if after as usize != 0usize {
    (*after).prev = before;
  }
}

// The queue hands the I/O thread a side whose operation is to begin
fn runSide(job: *u8, lp: &mut Loop) {
  let s = job as *Side;
  let t = io.load() as *IoThread;
  if (*s).rec as usize == 0usize {
    linkSpill(t, s);
    (*t).spilled = (*t).spilled + 1u64;
  } else {
    (*t).fast = (*t).fast + 1u64;
  }
  if (*s).what == opRecvAny {
    var first = stageReady();
    let rec = (*s).rec;
    if rec as usize != 0usize && (*rec).calm {
      first = stageStraight();
    }
    issueStage(lp, s, first);
  } else {
    issuePlain(lp, s);
  }
}

fn takeBuf(s: *Side) IoBuf {
  var b = IoBuf.empty();
  b <-> (*s).buf;
  b
}

// Start the side's operation, its answer to this thread, the iocore OpId kept
fn issuePlain(lp: &mut Loop, s: *Side) {
  let h = (*s).h;
  let w = (*s).what;
  let to = Target.Here(tokenOf(s));
  var id = OpId.none();
  if w == opRecv {
    id = submitLimited(lp, Op.Recv(h, takeBuf(s)), to, &(*s).limits);
  } else if w == opAccept {
    id = submitLimited(lp, Op.Accept(h), to, &(*s).limits);
  } else if w == opSend {
    id = submitLimited(lp, Op.Send(h, takeBuf(s)), to, &(*s).limits);
  } else if w == opReadAt {
    id = submitLimited(lp, Op.ReadAt(h, (*s).arg, takeBuf(s)), to, &(*s).limits);
  } else if w == opWriteAt {
    id = submitLimited(lp, Op.WriteAt(h, (*s).arg, takeBuf(s)), to, &(*s).limits);
  } else if w == opRecvFrom {
    id = submitLimited(lp, Op.RecvFrom(h, takeBuf(s)), to, &(*s).limits);
  } else {
    // The destination was left in the place the answer will be written in
    let dest = mem.readRaw[SocketAddr]((*s).ansp as *SocketAddr);
    id = submitLimited(lp, Op.SendTo(h, dest, takeBuf(s)), to, &(*s).limits);
  }
  (*s).opid = id;
}

// Start the next operation of a read with no buffer, in the stage given. The
// side keeps the OpId of the one outstanding, so a cancel reaches whichever
// stage the read is in; the caller's deadline and group bound the whole read
// (the side's limits), and a receive begun with a buffer carries a deadline
// of the quiet time as well, when that is the earlier
fn issueStage(lp: &mut Loop, s: *Side, stage: u32) {
  (*s).stage = stage;
  (*s).ours = false;
  let now = Instant.now();
  (*s).since = now.nanos();
  let to = Target.Here(tokenOf(s));
  let h = (*s).h;
  var id = OpId.none();
  if stage == stageReady() {
    id = submitLimited(lp, Op.RecvReady(h), to, &(*s).limits);
  } else if stage == stageStraight() {
    var until = (*s).limits.deadline;
    let soon = now + Duration.fromNanos(quietNanos());
    if soon < until {
      until = soon;
      (*s).ours = true;
    }
    id = submitLimitedBy(lp, Op.Recv(h, IoBuf(usize.from((*s).arg))), to, &(*s).limits, until);
  } else {
    id = submitLimited(lp, Op.Recv(h, IoBuf(usize.from((*s).arg))), to, &(*s).limits);
  }
  (*s).opid = id;
}

// Whether the socket's last read with no buffer came quickly: a hint, kept in
// its record (a spill block has none: it starts without a buffer and keeps no
// hint)
fn isCalm(s: *Side) bool {
  let rec = (*s).rec;
  rec as usize != 0usize && (*rec).calm
}

fn setCalm(s: *Side, calm: bool) {
  let rec = (*s).rec;
  if rec as usize != 0usize {
    (*rec).calm = calm;
  }
}

// An answer to one of the sides' operations, on the I/O thread
fn sideDone(t: *IoThread, lp: &mut Loop, c: Completion, stop: bool) {
  var done = c;
  let s = sideOf(t, done.token);
  if s as usize == 0usize {
    return;
  }
  if stop {
    abandonSide(t, s);
    return;
  }
  if (*s).what == opRecvAny {
    let stage = (*s).stage;
    if stage == stageReady() && done.status == diag.outcomeDone {
      // Bytes have come: take them, with a buffer made now. Came quickly or not,
      // the socket's next read starts in the mode that suits
      let waited = Instant.now().nanos() - (*s).since;
      setCalm(s, waited < quietNanos());
      issueStage(lp, s, stageTake());
      return;
    }
    if stage == stageStraight() {
      if done.status == diag.outcomeTimedOut && (*s).ours {
        // Quiet: the buffer goes home (with the answer), and the read waits
        // without one: the same side, its OpId replaced by the new operation's
        setCalm(s, false);
        issueStage(lp, s, stageReady());
        return;
      }
      if done.status == diag.outcomeDone {
        setCalm(s, true);
      }
    }
  }
  finish(t, s, &mut done);
}

// The operation is over: its typed answer is written in the side, and the
// awaiting actor told where it is
fn finish(t: *IoThread, s: *Side, c: &mut Completion) {
  if (*s).rec as usize == 0usize {
    unlinkSpill(t, s);
  }
  (*s).opid = OpId.none();
  let w = (*s).what;
  // What the answer does not hand on (a failed read's buffer, a sent buffer)
  // goes home to its pool before the actor is told, so that the actor finds it
  // home
  if w == opRecv || w == opRecvAny || w == opReadAt {
    let v = readAnswer(c);
    letGo(c);
    deliver[Result[IoBuf, IoError]](s, v);
  } else if w == opAccept {
    let v = socketAnswer(c);
    letGo(c);
    deliver[Result[Socket, IoError]](s, v);
  } else if w == opRecvFrom {
    let v = datagramAnswer(c);
    letGo(c);
    deliver[Result[Datagram, IoError]](s, v);
  } else {
    let v = writeAnswer(c);
    letGo(c);
    deliver[Result[usize, IoError]](s, v);
  }
}

// The buffer an answer still holds goes home
fn letGo(c: &mut Completion) {
  var b = IoBuf.empty();
  b <-> c.buf;
}

// The answer v written in the side's place for it, the reply told: the actor's
// worker takes the value from there when it resumes and then releases the
// side (actors.answerLent). The side is not touched after this call: the
// answer may have been taken, and the side released, before it returns
fn deliver[R](s: *Side, v: R) {
  let p = (*s).ansp as *R;
  mem.writeRaw[R](p, v);
  (*s).limits = IoLimits.none();
  var back = actors.Reply();
  back <-> (*s).reply;
  actors.answerLent[R](back, p, &takeAns[R]);
}

// The awaiting actor's worker takes the answer out of its place, into one of
// its own, and the side is free again before the behaviour goes on
fn takeAns[R](p: *u8, to: *u8) {
  mem.writeRaw[R](to as *R, mem.readRaw[R](p as *R));
  releaseAns(p);
}

// The loop is dying: this operation's answer is not delivered, and the actor
// that awaits it is let go (its reply dropped)
fn abandonSide(t: *IoThread, s: *Side) {
  if (*s).rec as usize == 0usize {
    unlinkSpill(t, s);
  }
  resetSide(s);
  releaseSide(s);
}

// The answers that came to the I/O thread itself (nothing else here asks for
// one): each is a side's
fn sidesDone(t: *IoThread, lp: &mut Loop, out: &mut List[Completion], stop: bool) {
  var more = true;
  while more {
    match out.pop() {
      case var Some(c) {sideDone(t, lp, c, stop);}
      else {more = false;}
    }
  }
}

// The I/O thread is ending: every operation still waiting is dropped, its
// reply with it (letting go of the actor that awaits it)
fn dropSides(t: *IoThread) {
  var p = (*t).spills;
  (*t).spills = null;
  while p as usize != 0usize {
    let next = (*p).next;
    mem.finalize[Side](p as *Side);
    libc.free(p as *u8);
    p = next;
  }
  let tb = tableOf(t) as &mut SlotTable[Rec];
  var i = 0u32;
  while usize.from(i) < tb.bound() {
    let r = tb.at(i);
    if r as usize != 0usize {
      resetSide(&(*r).rd as *Side);
      resetSide(&(*r).wr as *Side);
    }
    i = i + 1u32;
  }
}

// The count of a handle's in-flight read or write, ended on its own (CANCEL
// AND DEADLINES, a handle's single operation): the record's slot and
// generation, so that a record freed meanwhile is known
struct CancelJob {
  pub slot: u32;
  pub gen: u32;
  pub write: bool;

  fn run(self: &mut, lp: &mut Loop) {
    let t = io.load() as *IoThread;
    let tb = tableOf(t) as &mut SlotTable[Rec];
    let rec = tb.get(Slot(slot, gen));
    if rec as usize != 0usize {
      var s = &(*rec).rd as *Side;
      if write {
        s = &(*rec).wr as *Side;
      }
      if !(*s).opid.isNone() {
        lp.cancel((*s).opid);
      }
    }
  }
}

// Ask a record's read or write in flight to end, from any thread: nothing if
// there is none, or it has not yet reached the I/O thread
fn cancelSide(rec: *Rec, write: bool) {
  if rec as usize == 0usize {
    return;
  }
  enqueue(newJob[CancelJob](CancelJob((*rec).index, (*rec).gen, write)));
}

// What the records have done so far (opStats)
pub struct OpStats {
  pub fast: u64;           // operations begun on a record's own side: nothing allocated
  pub spilled: u64;        // ...on a spill block, the side being busy (or no record): the fallback
  pub records: u64;        // records now in the table: one for each Socket, File and UdpSocket open
}

// Counts of the operations begun on the records' own sides and on spill
// blocks, and the records now open: zero before the first operation is awaited
pub fn opStats() OpStats {
  ioLock.lock();
  let t = io.load() as *IoThread;
  ioLock.unlock();
  if t as usize == 0usize {
    return OpStats(0u64, 0u64, 0u64);
  }
  OpStats((*t).fast, (*t).spilled, u64.from((*t).recs.len()))
}

// The hook an operation in flight holds: a closure that keeps the reply and
// the function that makes the answer an R. It runs on the I/O thread with the
// operation's one answer, whichever of the four it is: it makes its R and
// writes it into the reply, which goes to the actor awaiting it. Once the
// Loop is dying, the answer is dropped, and what awaits it abandoned (the
// reply's envelope dropped with the hook). A hook that dies undelivered
// abandons what awaits it the same way, the reply it holds dying with it
fn waiting[R](rp: actors.Reply, answer: &fn(c: &mut Completion) R) Uni[fn(c: Completion) + Sendable] {
  Uni[fn(c: Completion) + Sendable](fn(c: Completion) [var reply = rp, answer] {
    if abandoning {
      return;
    }
    var done = c;
    let v = answer(&mut done);
    var back = actors.Reply();
    back <-> reply;
    actors.answerNow[R](back, v);
  })
}

// Each operation's answer, from its Completion: Done is the success, and
// anything else the error, Failed's the system's code, Cancelled's and
// TimedOut's their own. A buffer the answer does not hand on dies with the
// Completion, home to its pool

fn endError(c: &Completion) IoError {
  if c.status == diag.outcomeCancelled {return IoError.cancelled();}
  if c.status == diag.outcomeTimedOut {return IoError.timedOut();}
  IoError(c.code)
}

fn readAnswer(c: &mut Completion) Result[IoBuf, IoError] {
  if c.status == diag.outcomeDone {
    var b = IoBuf.empty();
    b <-> c.buf;
    return Ok[IoBuf, IoError](b);
  }
  Error[IoBuf, IoError](endError(c))
}

fn writeAnswer(c: &mut Completion) Result[usize, IoError] {
  if c.status == diag.outcomeDone {
    return Ok[usize, IoError](c.n);
  }
  Error[usize, IoError](endError(c))
}

fn socketAnswer(c: &mut Completion) Result[Socket, IoError] {
  if c.status == diag.outcomeDone {
    return Ok[Socket, IoError](newSocket(c.handle));
  }
  Error[Socket, IoError](endError(c))
}

// WSAEMSGSIZE, the code iocore answers a datagram longer than the room with
fn msgSizeCode() u32 {10040u32}

// A receive's answer: the datagram, in its buffer, and who sent it. A datagram
// cut to the room is the error Truncated, and its buffer, like a failed read's,
// goes home to its pool
fn datagramAnswer(c: &mut Completion) Result[Datagram, IoError] {
  if c.status == diag.outcomeDone {
    var b = IoBuf.empty();
    b <-> c.buf;
    return Ok[Datagram, IoError](Datagram(b, c.peer));
  }
  if c.status == diag.outcomeFailed && c.code == msgSizeCode() {
    return Error[Datagram, IoError](IoError.truncated());
  }
  Error[Datagram, IoError](endError(c))
}

// A timer's: Done is the success, a Result with nothing in it
fn sleepAnswer(c: &mut Completion) Result[void, IoError] {
  if c.status == diag.outcomeDone {
    return Ok[void, IoError](nil);
  }
  Error[void, IoError](endError(c))
}

// A name looked up: the addresses, from the buffer the lookup filled
fn resolveAnswer(c: &mut Completion) Result[List[SocketAddr], IoError] {
  if c.status == diag.outcomeDone {
    return Ok[List[SocketAddr], IoError](addressesIn(&c.buf));
  }
  Error[List[SocketAddr], IoError](endError(c))
}

// A file's metadata, from the buffer the query filled
fn statAnswer(c: &mut Completion) Result[FileStat, IoError] {
  if c.status == diag.outcomeDone {
    return Ok[FileStat, IoError](fileStatIn(&c.buf));
  }
  Error[FileStat, IoError](endError(c))
}

fn opAwaitable[R](op: Op, answer: &fn(c: &mut Completion) R, limits: IoLimits) actors.Awaitable[R] {
  awaitable[OpJob[R], R](OpJob[R](op, limits, actors.Reply(), answer))
}

// A timer, started on the I/O thread's Loop: it answers Done at 'at' (or, if
// 'relative', 'after' from the moment the I/O thread starts it, a moment after
// the 'await'), unless lim ends it first. lim's group is the timer's cancel
// group, and lim's deadline narrows that group's (a group made for the purpose
// when there is none): a timer due after the deadline answers TimedOut at the
// deadline, as iocore's 'afterIn' does
struct SleepJob {
  pub at: Instant;
  pub after: Duration;
  pub relative: bool;
  pub limits: IoLimits;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let at, after, relative, limits, rp = self.(at, after, relative, limits, reply);
    let due = if relative {Instant.now() + after} else {at};
    let to = Target.Hook(0u64, Sink.make(waiting[Result[void, IoError]](rp, &sleepAnswer)));
    match limits.group {
      case let Some(g) {
        if limits.deadline < forever() {
          lp.afterIn(due, to, g.childUntil(limits.deadline));
        } else {
          lp.afterIn(due, to, g);
        }
      }
      else {
        if limits.deadline < due {
          lp.afterIn(due, to, CancelGroup.until(limits.deadline));
        } else {
          lp.after(due, to);
        }
      }
    }
  }
}

// A listening socket, made on the I/O thread's Loop, which holds it
struct ListenJob {
  pub addr: SocketAddr;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let addr, rp = self.(addr, reply);
    match lp.listen(addr) {
      case let Ok(ok) {actors.answerNow[Result[Socket, IoError]](rp, Ok[Socket, IoError](newSocket(ok)));}
      case let Error(e) {actors.answerNow[Result[Socket, IoError]](rp, Error[Socket, IoError](e));}
    }
  }
}

// A UDP socket bound on the I/O thread's Loop, which holds it
struct BindUdpJob {
  pub addr: SocketAddr;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let addr, rp = self.(addr, reply);
    match lp.bindUdp(addr) {
      case let Ok(ok) {actors.answerNow[Result[UdpSocket, IoError]](rp, Ok[UdpSocket, IoError](newUdp(ok)));}
      case let Error(e) {actors.answerNow[Result[UdpSocket, IoError]](rp, Error[UdpSocket, IoError](e));}
    }
  }
}

// A file opened on the I/O thread's Loop, which holds it
struct OpenFileJob {
  pub path: Path;
  pub access: Access;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let path, access, rp = self.(path, access, reply);
    match lp.openFile(&path, access) {
      case let Ok(ok) {actors.answerNow[Result[File, IoError]](rp, Ok[File, IoError](newFile(ok)));}
      case let Error(e) {actors.answerNow[Result[File, IoError]](rp, Error[File, IoError](e));}
    }
  }
}

// A child process, run by a thread of iocore's blocking pool: the process
// package's 'run' (or 'runLine'), which waits for it. The package's header,
// METHOD CHOICES, tells how the pool thread and the I/O thread share the state below
//
// The state of a run, in a block of its own (libc's malloc): what it is to
// run, and where its answer is left. 'state' says who frees the block (the
// words below); 'out' is the pool thread's, until 'state' is runFinished
pub struct RunState {
  pub state: Atomic[u32];
  pub isLine: bool;
  pub line: String;
  pub args: List[String];
  pub opts: process.Options;
  pub dir: Path;
  pub out: Result[process.Output, IoError];
}

// 'state': a run not yet started by a pool thread; started; abandoned by the
// answer (a deadline's, past the grace: the thread frees the block when it is
// done); finished (the thread has left the answer in 'out')
fn runPending() u32 {0u32}
fn runStarted() u32 {1u32}
fn runAbandoned() u32 {2u32}
fn runFinished() u32 {3u32}

// ERROR_OPERATION_ABORTED, what a run's answer says before the thread has left one
fn abortedCode() u32 {errorOperationAborted}

fn noOutput() Result[process.Output, IoError] {
  Error[process.Output, IoError](IoError(abortedCode()))
}

fn freeRun(p: *RunState) {
  mem.finalize[RunState](p);
  libc.free(p as *u8);
}

// What the process package answered, as this package's Result: the Output, or
// the IoError of the number the system gave (Windows' on every system)
fn runResult(r: Result[process.Output, process.ProcessError]) Result[process.Output, IoError] {
  match r {
    case let Ok(o) {Ok[process.Output, IoError](o)}
    case let Error(e) {Error[process.Output, IoError](IoError(systemCode(e.code)))}
  }
}

// On a pool thread: run the program, wait for it, and leave the answer in the
// block, which the arg names. A block the answer has abandoned already is
// freed here, unrun; one it abandons while the program runs is freed on its end
fn runWork(arg: u64, buf: &mut IoBuf) Outcome {
  let p = usize.from(arg) as *RunState;
  let st = p as &mut RunState;
  if st.state.swap(runStarted()) == runAbandoned() {
    freeRun(p);
    return Outcome.Failed(abortedCode());
  }
  var r: Result[process.Output, IoError];
  if st.isLine {
    r = runResult(process.runLine(st.line.view(), st.opts, &st.dir));
  } else {
    r = runResult(process.run(st.args.view(), st.opts, &st.dir));
  }
  st.out = r;
  if st.state.swap(runFinished()) == runAbandoned() {
    freeRun(p);
    return Outcome.Failed(abortedCode());
  }
  Outcome.Done(0usize)
}

// A run's answer, on the I/O thread; the block is named by the token. Done:
// the pool thread has left its answer, and the block is freed here. Anything
// else: a job that never ran (taken out of its lane's queue by a cancel or a
// deadline, or refused for want of room) comes back with its buffer, and the
// block is freed here; one that did not (a deadline's prompt TimedOut, with no
// buffer, while the program runs) leaves the block to the thread, unless the
// thread has finished meanwhile
fn runAnswer(c: &mut Completion) Result[process.Output, IoError] {
  let p = usize.from(c.token) as *RunState;
  if c.status == diag.outcomeDone {
    var ans = noOutput();
    ans <-> (*p).out;
    freeRun(p);
    return ans;
  }
  if c.buf.capacity() > 0usize {
    freeRun(p);
  } else if (*p).state.swap(runAbandoned()) == runFinished() {
    freeRun(p);
  }
  Error[process.Output, IoError](endError(c))
}

// A child process to run, started on the I/O thread's Loop: its block made
// there, so that a job dropped unawaited has made none. The job takes a buffer
// of one byte, which it does not use: it tells the
// answer whether the run was started (a job that comes back with it never ran)
struct RunJob {
  pub isLine: bool;
  pub line: String;
  pub args: List[String];
  pub opts: process.Options;
  pub dir: Path;
  pub limits: IoLimits;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let isLine, l, a, opts, dir, limits, rp = self.(isLine, line, args, opts, dir, limits, reply);
    let st = libc.malloc(mem.sizeof[RunState]()) as *RunState;
    if st as usize == 0usize {
      die("aio: out of memory for a child process");
    }
    mem.writeRaw[RunState](st, RunState(Atomic[u32].of(runPending()), isLine, l, a, opts, dir.copy(), noOutput()));
    let key = u64.from(st as usize);
    let to = Target.Hook(key, Sink.make(waiting[Result[process.Output, IoError]](rp, &runAnswer)));
    submitLimited(lp, Op.Call(Lane.general(), &runWork, key, IoBuf(1usize)), to, &limits);
  }
}

// A socket's address, read on the I/O thread
struct LocalAddrJob {
  pub h: Handle;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let h, rp = self.(h, reply);
    actors.answerNow[Result[SocketAddr, IoError]](rp, lp.localAddr(h));
  }
}

// A socket closed, its Socket dropped: every operation in flight on it is
// cancelled. Nothing awaits it
struct CloseJob {
  pub h: Handle;
  pub rec: *Rec;

  fn run(self: &mut, lp: &mut Loop) {
    lp.close(h);
    if rec as usize != 0usize {
      // The record is freed now if no operation holds a side of it; else by
      // whoever lets go of the last (releaseSide)
      let old = (*rec).life.bitOr(lifeClosed);
      if (old & lifeBusy) == 0u32 {
        freeRec(rec);
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Sockets
// ---------------------------------------------------------------------------

// A TCP socket the I/O thread holds (the package's header, A SOCKET): it
// moves, and dropping it closes the socket
pub struct Socket is Move, Sendable {
  h: Handle;
  rec: *Rec;                // its record (RECORDS): null for a Socket naming nothing

  // A Socket naming nothing, which closes nothing: to swap one out of a
  // Result, or into a field before one is there
  pub fn none() Socket {Socket(Handle.none(), nullRec())}

  pub fn isNone(self: &) bool {h.isNone()}

  // The iocore handle it names, on the I/O thread's Loop
  pub fn handle(self: &) Handle {h}

  // The next connection on this listening socket (the listener's read side)
  pub fn accept(self: &) actors.Awaitable[Result[Socket, IoError]] {
    self.acceptIn(IoLimits.none())
  }

  // The next connection, ended if lim says so (the package's header, CANCEL
  // AND DEADLINES)
  pub fn acceptIn(self: &, lim: IoLimits) actors.Awaitable[Result[Socket, IoError]] {
    let s = beginSide(rec, h, false, opAccept);
    (*s).limits = lim;
    sideAwaitable[Result[Socket, IoError]](s)
  }

  // What arrives, appended to buf, which is moved in and comes back in the
  // answer; at the clean end of the stream, buf comes back as it was. A buf
  // with no room fails (ERROR_INSUFFICIENT_BUFFER, 122)
  pub fn readBuf overload read(self: &, buf: IoBuf) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readBufIn(buf, IoLimits.none())
  }

  // A read ended if lim says so; then the buffer goes home to its pool
  pub fn readBufIn overload readIn(self: &, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[IoBuf, IoError]] {
    let s = beginSide(rec, h, false, opRecv);
    var b = buf;
    b <-> (*s).buf;
    (*s).limits = lim;
    sideAwaitable[Result[IoBuf, IoError]](s)
  }

  // What arrives, in a buffer the I/O side takes: the caller holds none, and
  // none is held while the read waits for the connection to be heard from
  // (the package's header, READS WITH NO BUFFER). The buffer is 4 KiB and
  // comes back in the answer like a read's; at the clean end of the stream it
  // comes back empty
  pub fn readAny overload read(self: &) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readAnyIn(IoLimits.none())
  }

  // A read with no buffer, ended if lim says so
  pub fn readAnyIn overload readIn(self: &, lim: IoLimits) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readRoomIn(defaultRoom(), lim)
  }

  // A read with no buffer, the buffer made with room for at least 'room'
  // bytes (the pools' block that fits): for a layer that knows what it wants,
  // a TLS session's record is 16 KiB
  pub fn readRoom overload read(self: &, room: usize) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readRoomIn(room, IoLimits.none())
  }

  pub fn readRoomIn overload readIn(self: &, room: usize, lim: IoLimits) actors.Awaitable[Result[IoBuf, IoError]] {
    let s = beginSide(rec, h, false, opRecvAny);
    (*s).arg = u64.from(room);
    (*s).limits = lim;
    sideAwaitable[Result[IoBuf, IoError]](s)
  }

  // All of buf, which is moved in and goes home once sent: the count
  pub fn write(self: &, buf: IoBuf) actors.Awaitable[Result[usize, IoError]] {
    self.writeIn(buf, IoLimits.none())
  }

  // A write ended if lim says so, part of buf perhaps sent
  pub fn writeIn(self: &, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[usize, IoError]] {
    let s = beginSide(rec, h, true, opSend);
    var b = buf;
    b <-> (*s).buf;
    (*s).limits = lim;
    sideAwaitable[Result[usize, IoError]](s)
  }

  // Ask the read (or accept) in flight on this socket to end: it is answered
  // Cancelled, as a group's cancel answers it, with the buffer given back.
  // Reaches the operation on the socket's own read side that has been started
  // by its 'await'; none in flight, or one not yet started, is not affected,
  // and a second read at once (the one that took a spill block, RECORDS)
  // cannot be reached this way. From any thread, idempotent
  pub fn cancelRead(self: &) {
    cancelSide(rec, false);
  }

  // The same for the write in flight
  pub fn cancelWrite(self: &) {
    cancelSide(rec, true);
  }

  // The address the socket is bound to: a listening socket's port, where the
  // system chose it
  pub fn localAddr(self: &) actors.Awaitable[Result[SocketAddr, IoError]] {
    awaitable[LocalAddrJob, Result[SocketAddr, IoError]](LocalAddrJob(h, actors.Reply()))
  }

  fn final(self: &uni) {
    if !h.isNone() {
      enqueue(newJob[CloseJob](CloseJob(h, rec)));
    }
  }
}

// ---------------------------------------------------------------------------
// UDP sockets
// ---------------------------------------------------------------------------

// A datagram received: its bytes, in the buffer the receive was given, and the
// address it came from
pub struct Datagram {
  pub buf: IoBuf;
  pub from: SocketAddr;
}

// A UDP socket the I/O thread holds (the package's header, A UDP SOCKET): a
// kind of its own beside Socket and File, so that a stream operation on it, or
// a datagram operation on a TCP socket, does not compile. It moves, and
// dropping it closes the socket
pub struct UdpSocket is Move, Sendable {
  h: Handle;
  rec: *Rec;                // its record (RECORDS): null for a UdpSocket naming nothing

  // A UdpSocket naming nothing, which closes nothing: to swap one out of a
  // Result, or into a field before one is there
  pub fn none() UdpSocket {UdpSocket(Handle.none(), nullRec())}

  pub fn isNone(self: &) bool {h.isNone()}

  // The iocore handle it names, on the I/O thread's Loop
  pub fn handle(self: &) Handle {h}

  // The next datagram to arrive, appended to buf, which is moved in and comes
  // back in the answer with the sender's address. A datagram of no bytes is a
  // datagram (the buffer's length is unchanged). A datagram longer than buf's
  // room is the error Truncated (code 10040, WSAEMSGSIZE), the rest of it lost,
  // and the buffer goes home to its pool, as a failed read's does. A buf with
  // no room fails (ERROR_INSUFFICIENT_BUFFER, 122)
  pub fn recvFrom(self: &, buf: IoBuf) actors.Awaitable[Result[Datagram, IoError]] {
    self.recvFromIn(buf, IoLimits.none())
  }

  // A receive ended if lim says so; then the buffer goes home to its pool
  pub fn recvFromIn(self: &, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[Datagram, IoError]] {
    let s = beginSide(rec, h, false, opRecvFrom);
    var b = buf;
    b <-> (*s).buf;
    (*s).limits = lim;
    sideAwaitable[Result[Datagram, IoError]](s)
  }

  // All of buf as one datagram to addr, buf moved in and going home once sent:
  // the count, its length. UDP promises no delivery: the answer says the
  // system took the datagram. One too large for the network fails (10040)
  pub fn sendTo(self: &, addr: SocketAddr, buf: IoBuf) actors.Awaitable[Result[usize, IoError]] {
    self.sendToIn(addr, buf, IoLimits.none())
  }

  // A send ended if lim says so
  pub fn sendToIn(self: &, addr: SocketAddr, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[usize, IoError]] {
    let s = beginSide(rec, h, true, opSendTo);
    var b = buf;
    b <-> (*s).buf;
    mem.writeRaw[SocketAddr]((*s).ansp as *SocketAddr, addr);   // left in the answer's place until the send begins
    (*s).limits = lim;
    sideAwaitable[Result[usize, IoError]](s)
  }

  // Ask the receive in flight on this socket to end, as Socket's cancelRead
  pub fn cancelRead(self: &) {
    cancelSide(rec, false);
  }

  // The same for the send in flight
  pub fn cancelWrite(self: &) {
    cancelSide(rec, true);
  }

  // The address the socket is bound to: its port, where the system chose it
  pub fn localAddr(self: &) actors.Awaitable[Result[SocketAddr, IoError]] {
    awaitable[LocalAddrJob, Result[SocketAddr, IoError]](LocalAddrJob(h, actors.Reply()))
  }

  fn final(self: &uni) {
    if !h.isNone() {
      enqueue(newJob[CloseJob](CloseJob(h, rec)));
    }
  }
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

// A file the I/O thread holds (the package's header, A FILE): it moves, and
// dropping it closes the file
pub struct File is Move, Sendable {
  h: Handle;
  rec: *Rec;                // its record (RECORDS): null for a File naming nothing

  // A File naming nothing, which closes nothing: to swap one out of a
  // Result, or into a field before one is there
  pub fn none() File {File(Handle.none(), nullRec())}

  pub fn isNone(self: &) bool {h.isNone()}

  // The iocore handle it names, on the I/O thread's Loop
  pub fn handle(self: &) Handle {h}

  // What is in the file from byte offset 'at', appended to buf, which is moved
  // in and comes back in the answer; from the end of the file or past it, buf
  // comes back as it was. A buf with no room fails (ERROR_INSUFFICIENT_BUFFER,
  // 122)
  pub fn readAt(self: &, at: u64, buf: IoBuf) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readAtIn(at, buf, IoLimits.none())
  }

  // A read ended if lim says so; then the buffer goes home to its pool
  pub fn readAtIn(self: &, at: u64, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[IoBuf, IoError]] {
    let s = beginSide(rec, h, false, opReadAt);
    var b = buf;
    b <-> (*s).buf;
    (*s).arg = at;
    (*s).limits = lim;
    sideAwaitable[Result[IoBuf, IoError]](s)
  }

  // All of buf, which is moved in and goes home once written, at byte offset
  // 'at': the count
  pub fn writeAt(self: &, at: u64, buf: IoBuf) actors.Awaitable[Result[usize, IoError]] {
    self.writeAtIn(at, buf, IoLimits.none())
  }

  // A write ended if lim says so, part of buf perhaps written
  pub fn writeAtIn(self: &, at: u64, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[usize, IoError]] {
    let s = beginSide(rec, h, true, opWriteAt);
    var b = buf;
    b <-> (*s).buf;
    (*s).arg = at;
    (*s).limits = lim;
    sideAwaitable[Result[usize, IoError]](s)
  }

  // Ask the read in flight on this file's read side to end, as Socket's
  // cancelRead (a file takes many reads at once; the others took spill blocks
  // and are reached by a group or deadline only)
  pub fn cancelRead(self: &) {
    cancelSide(rec, false);
  }

  // The same for the write
  pub fn cancelWrite(self: &) {
    cancelSide(rec, true);
  }

  fn final(self: &uni) {
    if !h.isNone() {
      enqueue(newJob[CloseJob](CloseJob(h, rec)));
    }
  }
}

// The file at path, opened as access says (the package's header, A FILE)
pub fn openFile(path: &Path, access: Access) actors.Awaitable[Result[File, IoError]] {
  awaitable[OpenFileJob, Result[File, IoError]](OpenFileJob(path.copy(), access, actors.Reply()))
}

// A TCP socket listening at addr, for accept; port 0 has the system choose
// one, which localAddr tells
pub fn listen(addr: SocketAddr) actors.Awaitable[Result[Socket, IoError]] {
  awaitable[ListenJob, Result[Socket, IoError]](ListenJob(addr, actors.Reply()))
}

// A UDP socket bound to addr, for recvFrom and sendTo; port 0 has the system
// choose one, which localAddr tells
pub fn bindUdp(addr: SocketAddr) actors.Awaitable[Result[UdpSocket, IoError]] {
  awaitable[BindUdpJob, Result[UdpSocket, IoError]](BindUdpJob(addr, actors.Reply()))
}

// A TCP socket connected to addr
pub fn connect(addr: SocketAddr) actors.Awaitable[Result[Socket, IoError]] {
  connectIn(addr, IoLimits.none())
}

// A TCP socket connected to addr, ended if lim says so
pub fn connectIn(addr: SocketAddr, lim: IoLimits) actors.Awaitable[Result[Socket, IoError]] {
  opAwaitable[Result[Socket, IoError]](Op.Connect(addr), &socketAnswer, lim)
}

// Pauses for d, counted from the 'await': Ok(nil) when it has passed
pub fn sleep(d: Duration) actors.Awaitable[Result[void, IoError]] {
  sleepIn(d, IoLimits.none())
}

// A sleep ended if lim says so (the package's header, SLEEPING)
pub fn sleepIn(d: Duration, lim: IoLimits) actors.Awaitable[Result[void, IoError]] {
  awaitable[SleepJob, Result[void, IoError]](SleepJob(Instant.now(), d, true, lim, actors.Reply()))
}

// Pauses until the instant 'at' (one already past is Ok at once): Ok(nil)
pub fn sleepUntil(at: Instant) actors.Awaitable[Result[void, IoError]] {
  sleepUntilIn(at, IoLimits.none())
}

// A sleepUntil ended if lim says so (the package's header, SLEEPING)
pub fn sleepUntilIn(at: Instant, lim: IoLimits) actors.Awaitable[Result[void, IoError]] {
  awaitable[SleepJob, Result[void, IoError]](SleepJob(at, Duration.zero(), false, lim, actors.Reply()))
}

// ---------------------------------------------------------------------------
// The blocking pool's work: names, file metadata, child processes
// ---------------------------------------------------------------------------

// The room a lookup or a query is given: the name or the path it holds, and
// more than the answer needs
fn roomFor(text: &Array[u8]) usize {
  if text.len > 4096usize {text.len} else {4096usize}
}

// The addresses host names (a name, or an address as text), each with port,
// looked up by iocore's 'resolveOp' on the pool's DNS lane (the package's
// header, THE BLOCKING POOL'S WORK). A name with no address is the system's
// failure (Winsock's number: 11001, WSAHOST_NOT_FOUND, for a name that is not
// there)
pub fn resolve(host: &str, port: u16 = 0u16) actors.Awaitable[Result[List[SocketAddr], IoError]] {
  resolveIn(host, port, IoLimits.none())
}

// A lookup ended if lim says so: a deadline past the grace answers TimedOut
// while the lookup goes on
pub fn resolveIn(host: &str, port: u16, lim: IoLimits) actors.Awaitable[Result[List[SocketAddr], IoError]] {
  opAwaitable[Result[List[SocketAddr], IoError]](
    resolveOp(host, port, IoBuf(roomFor(host))), &resolveAnswer, lim)
}

// A file's size, attributes and time of last write, by iocore's 'statOp' on
// the pool's general lane; a path that is not there fails with
// ERROR_FILE_NOT_FOUND (2) on both systems
pub fn stat(path: &Path) actors.Awaitable[Result[FileStat, IoError]] {
  statIn(path, IoLimits.none())
}

// A query ended if lim says so
pub fn statIn(path: &Path, lim: IoLimits) actors.Awaitable[Result[FileStat, IoError]] {
  opAwaitable[Result[FileStat, IoError]](
    statOp(path, Lane.general(), IoBuf(roomFor(path.view()))), &statAnswer, lim)
}

fn copyArgs(args: &Array[String]) List[String] {
  var copy = List[String].empty();
  var i = 0usize;
  while i < args.len {
    copy.push(String.from(args[i].view()));
    i = i + 1usize;
  }
  copy
}

fn runAwaitable(isLine: bool, line: &str, args: List[String], opts: process.Options, dir: &Path, lim: IoLimits) actors.Awaitable[Result[process.Output, IoError]] {
  awaitable[RunJob, Result[process.Output, IoError]](
    RunJob(isLine, String.from(line), args, opts, dir.copy(), lim, actors.Reply()))
}

// Runs args[0] with the rest as its arguments, in the folder dir (the current
// one if empty), and waits for it to end, as the process package's 'run': the
// Output holds its exit code and what it wrote to its standard output and
// standard error, apart; a program that could not be started is the Error
// (its system error number: ERROR_FILE_NOT_FOUND, 2, for none of that name).
// The behaviour pauses meanwhile, and a thread of the blocking pool waits for
// the child (the package's header, CHILD PROCESSES). 'opts' is the process
// package's Options: a 'timeout' stops the child and everything it started
pub fn run(args: &Array[String], opts: process.Options = process.Options(), dir: &Path = "") actors.Awaitable[Result[process.Output, IoError]] {
  runAwaitable(false, "", copyArgs(args), opts, dir, IoLimits.none())
}

// A run ended if lim says so: a job still queued for a thread is taken out
// (Cancelled, TimedOut), and one running is answered when it ends, or, for a
// deadline, TimedOut at once with the child left running (set 'opts.timeout' to
// stop it)
pub fn runIn(args: &Array[String], opts: process.Options, dir: &Path, lim: IoLimits) actors.Awaitable[Result[process.Output, IoError]] {
  runAwaitable(false, "", copyArgs(args), opts, dir, lim)
}

// Runs a command line written out by hand, as the process package's 'runLine'
// ('cmd /c ...' on Windows; the shell's '/bin/sh -c' line on Linux)
pub fn runLine(line: &str, opts: process.Options = process.Options(), dir: &Path = "") actors.Awaitable[Result[process.Output, IoError]] {
  runAwaitable(true, line, List[String].empty(), opts, dir, IoLimits.none())
}

// A runLine ended if lim says so, as 'runIn'
pub fn runLineIn(line: &str, opts: process.Options, dir: &Path, lim: IoLimits) actors.Awaitable[Result[process.Output, IoError]] {
  runAwaitable(true, line, List[String].empty(), opts, dir, lim)
}
