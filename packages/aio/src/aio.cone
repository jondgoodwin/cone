// The aio package: I/O an actor awaits. A behaviour of an actor writes
//
//   imm r = await conn.read(buf);
//
// and pauses there, as it would awaiting another actor's reply; the read is
// done by the I/O thread's completion loop, and when it has finished, its
// answer comes back to the actor as a message, and the rest of the behaviour
// runs with it, perhaps on another worker. Nothing waits on the worker
// meanwhile: the actor handles its other messages.
//
//   mod hello;
//   import iobuf use IoBuf;
//   import iocore use SocketAddr, IoError;
//   import actors;
//   import aio use Socket;
//
//   // The Socket an answer holds: Socket.none() if it failed
//   fn socketOf(r: Result[Socket, IoError]) Socket {
//     match r {
//       case let Ok(s) {s}
//       case is Error {Socket.none()}
//     }
//   }
//
//   actor Client {
//     pub async fn send(self, port u16) {
//       imm conn = socketOf(await aio.connect(SocketAddr.localhost(port)));
//       mut buf = IoBuf(64usize);
//       buf.append("hello");
//       imm sent = await conn.write(buf);          // pauses until all of it is sent
//       match sent {
//         case imm n Ok {...n bytes were sent...}
//         case imm e Error {...e.code is Windows' error number...}
//       }
//     }                                           // conn closes here
//   }
//
// (tests/manual.cone, the reference manual's example, is a server and this
// client, run.)
//
// What there is:
//
//   aio.listen(addr)        a TCP socket listening at addr       Result[Socket, IoError]
//   aio.connect(addr)       a TCP socket connected to addr       Result[Socket, IoError]
//   s.accept()              the next connection on a listening s  Result[Socket, IoError]
//   s.read(buf)             what arrives, appended to buf, an IoBuf moved in
//                                                                Result[IoBuf, IoError]
//   s.read()                what arrives, in a buffer the I/O side takes: none is
//                           held while it waits                   Result[IoBuf, IoError]
//   s.read(room)            the same, the buffer with room for at least 'room' bytes (a usize)
//                                                                (READS WITH NO BUFFER)
//   s.write(buf)            all of buf, an IoBuf moved in         Result[usize, IoError]
//   s.localAddr()           the address s is bound to            Result[SocketAddr, IoError]
//   aio.openFile(path, access)  a file, opened with iocore's Access   Result[File, IoError]
//   f.readAt(at, buf)       what is in the file from byte offset at, appended to buf
//                                                                Result[IoBuf, IoError]
//   f.writeAt(at, buf)      all of buf, at byte offset at         Result[usize, IoError]
//   aio.bindUdp(addr)      a UDP socket bound to addr            Result[UdpSocket, IoError]
//   u.recvFrom(buf)        one datagram, appended to buf, an IoBuf moved in, and its sender
//                                                                Result[Datagram, IoError]
//   u.sendTo(addr, buf)    all of buf as one datagram to addr    Result[usize, IoError]
//   u.localAddr()          the address u is bound to             Result[SocketAddr, IoError]
//   aio.connectIn(addr, lim)  s.acceptIn(lim)  s.readIn(buf, lim)  s.writeIn(buf, lim)
//   f.readAtIn(at, buf, lim)  f.writeAtIn(at, buf, lim)
//   u.recvFromIn(buf, lim)  u.sendToIn(addr, buf, lim)
//                           the same eight, limited by lim, a IoLimits    (CANCEL AND DEADLINES)
//   s.readIn(lim)  s.readIn(room, lim)
//                           the two reads with no buffer, limited by lim
//   aio.setReadQuiet(d)     how long a read with no buffer may hold one (2 ms)
//   s.cancelRead()  s.cancelWrite()   end every read (accept, receive) or every write (send) in
//                           flight on the handle (ONE DIRECTION OF A HANDLE); also on a UdpSocket and a File
//   aio.opStats()           the records in use and made, the operations cancelRead and cancelWrite
//                           asked to end, the answers taken on the awaiting actor's worker, a
//                           record's size (ONE RECORD PER OPERATION)
//   aio.testLateQuiet(on)   TEST-ONLY, not for programs (Cone has no test-only visibility, so it is
//                           public): while on, reads with no buffer that begin with one go through
//                           the bad case's late path when answered (READS WITH NO BUFFER)
//   IoLimits.none()  IoLimits.until(deadline)  IoLimits.within(group)  IoLimits(group, deadline)
//   aio.sleep(d)  aio.sleepUntil(at)   a pause of d (a Duration) / until at (an Instant)
//                                                                Result[void, IoError]
//   aio.sleepIn(d, lim)  aio.sleepUntilIn(at, lim)   the same two, limited by lim     (SLEEPING)
//   aio.resolve(host, port)  a name looked up: its addresses       Result[List[SocketAddr], IoError]
//   aio.stat(path)         a file's size, attributes, time of last write   Result[FileStat, IoError]
//   aio.run(args, opts, dir)  a child process run and waited for, its output captured
//                                                                Result[process.Output, IoError]
//   aio.runLine(line, opts, dir)  the same for a command line written out by hand
//   aio.resolveIn(host, port, lim)  aio.statIn(path, lim)  aio.runIn(args, opts, dir, lim)
//   aio.runLineIn(line, opts, dir, lim)
//                           the same four, limited by lim                  (THE BLOCKING POOL'S WORK)
//   aio.isCancelled(e)  aio.isTimedOut(e)  aio.isTruncated(e)
//                           what an IoError says of how an operation ended
//   Socket.none()  File.none()  UdpSocket.none()
//                           a Socket, File or UdpSocket naming nothing: to swap one out of a Result
//   s.isNone()  s.handle()  f.isNone()  f.handle()  u.isNone()  u.handle()
//   Datagram {buf, from}    what a recvFrom answers: the datagram's bytes and its sender
//
// Each of the operations (and each sleep) makes an OPERATION, an actors.Awaitable[R], which
// does nothing until an 'await' in a behaviour starts it; the 'await''s value
// is its R. Made and never awaited, it is dropped, and nothing is done.
//
// WHAT THE SECOND HALF SEES. Each operation declares its own result, a Result:
// the success, or the operating system's failure, as a synchronous call that
// can fail answers. 'await' adds nothing to it, and the compiler refuses an
// 'await' on an operation whose value is not used (it holds the failure). A
// read's success is the buffer it was given back, the bytes that arrived
// appended to what it held: its length grows by the count, and does not grow
// at the clean end of the stream, the peer's close (iocore's Done(0)). The
// buffer is the read's one output, so it comes back in the answer rather
// than a count alone; a failed read's buffer goes home to its pool. A write's
// success is the count written, all of the buffer, which goes home. Accept's,
// connect's and listen's is the new Socket, which comes out of the Result by
// matching it: 'case let Ok(s)'.
//
// READS WITH NO BUFFER. 's.read()' is a read whose caller holds no buffer, and
// the connection holds none while it waits for the other end to speak: a
// thousand idle connections pin no memory, where a thousand 'read(IoBuf(4096))'
// pin 4 MiB (and the kernel locks the pages). The I/O side takes the buffer,
// from the pools, when bytes have come: 4 KiB, or the room 's.read(room)' asks
// for (a layer over aio that reads TLS records asks for 16 KiB; aio itself
// knows nothing of TLS). It comes back in the answer as a read's does, its
// length the bytes that arrived; at the clean end of the stream it is empty,
// and a buffer is never taken for a failed read. A read's bytes are the same
// either way; only when the buffer is taken differs, and so does the cost.
//
// Two ways to wait, and which one is chosen. WAITING WITHOUT A BUFFER is
// iocore's Op.RecvReady, a zero-byte receive: it ends when bytes are there (or
// the stream has ended), then a Recv with a buffer takes them. It costs a
// second trip through the system per read (iocore measured about 4 us more a
// round trip, 19 us against 15). WAITING WITH ONE is a Recv with a buffer
// started at once, which is the cheaper path when bytes are already coming.
// A read chooses by the socket's last: if its last read with no buffer was
// answered less than 'setReadQuiet' (2 ms) after it was started, the socket is
// CALM and this read takes a buffer at once; otherwise it waits without one. A
// socket's first read has no last, and waits without. And a read that began
// with a buffer and has waited the quiet time without a byte gives the buffer
// up (the receive is ended by a deadline of the quiet time, and begun again as
// a zero-byte one), so that a connection that was busy and has gone quiet pins
// nothing from then on, and its next read waits without a buffer. The most
// buffers pinned at once are those of the reads that began calm in the last
// quiet time. The hint is a bit of the handle's hint word, which iocore's Loop
// keeps for the layer that opened the handle ('lp.hint'), the one thing aio
// keeps that lives as long as the socket; the stage the read is in is in the
// read's record.
// 'setReadQuiet' with a zero Duration makes every read wait without a buffer;
// with a long one a socket's reads after its first take one at once.
// 'read(buf)' is neither: the caller's buffer is in flight from the start, as
// before.
//
// The read is advanced on the I/O thread from one operation to the next on ONE
// RECORD, started again: after a zero-byte receive's answer a buffer is put in
// (over None) and the record is started as a receive; the record keeps the
// caller's deadline and group (its limits) for the whole read. A receive begun
// with a buffer carries a deadline of the quiet time when that is earlier than
// the caller's; when it ends TimedOut by that deadline, the buffer has come
// back in the record and goes home (None over it), and the same record begins
// the read again as a zero-byte one, with the same limits. (In the bad case,
// that receive answered early while the kernel still holds it, nothing is
// answered: when the kernel gives the record back, a receive it finished
// after all is the read's answer, its bytes kept, and one it cancelled holds
// none, and the read goes on as a zero-byte one.) A
// read ended by a cancel, a deadline (the caller's, or its group's) or its
// socket's closing is answered as every operation is, exactly once; one still
// waiting when the program ends is abandoned like any awaited operation (THE
// PROGRAM'S END). The caller's deadline bounds the whole read, both of its
// operations.
//
// CANCEL AND DEADLINES. An operation is answered exactly once, as in iocore:
// Done (the Result's success), Failed (its error, the system's code),
// Cancelled or TimedOut. The last two are errors too, an IoError of a kind of
// its own (iocore's IoErrorKind: Os for a failure of the system, Cancelled,
// TimedOut), which 'isCancelled' and 'isTimedOut' read; their code is 0, and a
// genuine system error is never mistaken for either. (A fourth kind,
// Truncated, is a datagram cut to the room, UDP's.) The buffer a
// read or a write was given goes home to its pool. What limits an operation is
// a IoLimits, given to the 'In' form of the call: a cancel group (iocore's
// CancelGroup, a value that is copied, sent to other actors or threads, and
// whose one 'cancel()' ends every operation in it) and an absolute deadline
// (an Instant), the tighter of it and the group's (a group made 'until', or a
// 'childUntil' of one, carries its own). From a group's cancel on, an
// operation started in it is answered Cancelled at once; a deadline already
// past answers TimedOut at once. A cancel and a completion that race are
// settled by iocore: the answer is whichever came first (the Done, if the
// operation had finished), and there is never a second. A socket dropped
// while an operation on it is in flight ends it Cancelled, as a cancel does.
// The operation is one the I/O thread starts when the 'await' does, so a
// cancel from another actor or thread may arrive before it has started: the
// group's state, not the order of the calls, decides.
//
// ONE DIRECTION OF A HANDLE. 's.cancelRead()' and 's.cancelWrite()' (on a
// Socket, a UdpSocket and a File) end EVERY operation in flight on the
// handle's read side (accept, receive, a datagram's receive, a file's read),
// or on its write side (send, a datagram's send, a file's write), and nothing
// else of the handle's or of any group: each is answered Cancelled, with its
// buffer given back, as a group's cancel answers it, and a read with no buffer
// is ended whichever of its two operations it is in. A file's many reads at
// once, or two reads at once on a socket, are all ended. The cancel is a small
// record of its own queued to the I/O thread (nothing is allocated), which asks
// iocore's 'cancelHandle'; they may be called from any thread and are
// idempotent. They reach the operations that have been STARTED (by their
// 'await') when the cancel reaches the I/O thread: there is nothing yet to end
// in one that has only been made; a group or a deadline reaches those. With
// no operation in flight a cancel does nothing.
//
// ONE RECORD PER OPERATION. Every awaited operation (a socket's, a datagram
// socket's and a file's, a connect, a sleep, a lookup, a file's metadata, a
// child process) is ONE RECORD of iocore's (an OpRec, its OpCore and aio's
// part after it: the reply, what the record is doing, a read with no buffer's
// stage, a run's request and answer), taken from aio's pool, which lives as
// long as the process. aio keeps no record of its own of anything: a Socket,
// a UdpSocket and a File are a Handle. The record is the carrier:
//
// - The call that makes the operation ('conn.read(buf)') takes a record on its
//   own thread (iocore's 'pool.take', under the pool's lock) and puts in the
//   request and the buffer. The record is the Awaitable's context
//   (actors.Awaitable.of: no closure); the 'await' puts the reply in and queues
//   the record to the I/O thread by its own link; dropped unawaited, the
//   Awaitable dissolves the record where it is dropped, its buffer home.
// - The I/O thread starts it on the Loop ('lp.start'); its answer comes back
//   on the Loop's done list, and the I/O thread either starts the same record
//   again (a read with no buffer's next stage) or SPRINGS the reply: the
//   record is lent to the answer's 'take' (actors.answerLentIn), and 'take'
//   DISSOLVES it -- reads it whole and takes it apart, once -- and makes the
//   answer from its pieces, the Result written straight into the awaiting
//   actor's place: Ok(buf), or the error from the status and the code; a
//   failed read's buffer, or a sent one, goes home with the rest. Where the
//   awaiting actor's slot holds the answer, 'take' runs on the I/O thread,
//   before the answer is pushed (the record dissolved there, batched); where it
//   does not (most actors: a slot holds 16 bytes of answer), the answer is
//   lent and 'take' runs on the awaiting actor's worker as it reaches the
//   reply, before the behaviour goes on (the record dissolved there, under the
//   pool's lock). Nothing is allocated for an operation: no closure, no job
//   block, no hook, no box for the answer, no record of aio's.
// - A record is lent only once the Loop holds nothing of it: off its handle's
//   in-flight list, off the grouped list and the done list, its timer
//   cancelled, no job away (iocore's RECORDS, a record let go). A trust claim:
//   from the spring on, only 'take' touches the record, on whichever thread
//   runs it, and a cancel, a close or a group's cancel on the same handle
//   cannot reach it. aio checks it at the spring ('isLetGo'; a panic if not).
// - The one bad case: a deadline's grace runs out while the kernel still
//   holds the record and its buffer (iocore's RECORDS). The actor is answered
//   TimedOut at once, by a value made on the I/O thread with nothing from the
//   record (actors.answerNowIn: the Reply left spent in the record, which may
//   allocate a box for the answer, on this rare path alone); the record stays
//   until the kernel gives it back, and is then dissolved like any other, its
//   buffer home, nothing delivered.
// - Two operations at once on one handle are two records. A handle's close is
//   a small record too, queued behind the operations queued before it.
// - A record is reached by a raw pointer, and a store through one does not
//   finalize the value it replaces (the manual's safe-pointers page): a Move
//   field of a record (its buffer, its reply, a run's part) is assigned
//   through a reference ('setBuf'), so that what it held is let go.
//
// The synchronous calls that make a handle or read one -- listen, bindUdp,
// openFile, localAddr -- are one per handle, not per operation: each is a job
// block of its own on the I/O thread's other queue (one allocation), as
// before.
//
// A SOCKET is a handle on one of the I/O thread's sockets: plain data, a
// Handle, which moves (it may be sent in a message, to another actor). Dropping
// it closes
// the socket: its finalizer queues the close on the I/O thread, behind the
// operations queued before it, and every operation then in flight on it is
// cancelled (iocore's 'close'). A Socket waiting in a paused behaviour's
// record stays open until the behaviour ends, as any value does.
//
// THE I/O THREAD. One thread, started by the first operation awaited, owns
// the actor runtime's iocore Loop and waits in its poll; it is the one thread
// that touches the Loop, as iocore asks. The actors' workers never wait on
// I/O (they could not: an actor's behaviour runs to its 'await' and
// returns). An 'await' on an operation hands its record to the I/O thread
// through a QUEUE: records linked by their own link (and the jobs, a list of
// their own) under a Mutex, which the I/O thread takes whole after each poll,
// and a Waker that ends the poll at once. After each poll the I/O thread takes
// the records the Loop has answered (lp.takeDone), each started again or
// sprung (ONE RECORD PER OPERATION), then runs the jobs and starts the records
// queued. Either way the reply goes to the actor's mailbox as any reply does
// -- one push, and, if the actor was idle, its scheduling. Nothing of the
// actor runs on the I/O thread.
//
// AN ACTOR'S LIFE. An operation in flight holds a count of the actor that
// awaits it, in its reply's envelope, as a request to another actor does: the
// actor lives until the answer comes, whether or not anything else holds it.
// A socket whose peer never answers keeps its reader alive for as long.
//
// THE PROGRAM'S END. The package's finalizer, which finalAll() runs before
// the actors package's, waits until no actor is queued or running (an actor
// paused on I/O is neither; one with an answer waiting in its mailbox, a lent
// one among them, is queued, so its 'take' has run, and its record is
// dissolved, before this goes on), then ends the I/O, in this order: the I/O
// thread stops taking from its queues, and what is queued there and not yet
// started is dissolved unstarted (each reply dropped unsent, each buffer home);
// then its Loop dies, which cancels and drains every operation still in flight,
// closes every socket, and dissolves every record it still holds, their
// answers abandoned (a record away with its job, a child still running, is
// dissolved when its job ends, the same way); only then is anything else of
// aio's let go (its pool and the I/O thread's block are kept for the life of
// the process). Each paused behaviour is ABANDONED: its reply's envelope is
// dropped, letting go of the actor's count, and an actor with nothing else
// holding it dies; its pending table then drops the records still parked, so
// every value a paused behaviour held is finalized, in the order its 'await'
// would have had them die, and the rest of the behaviour never runs. An
// operation awaited after that is abandoned the same way at once, its record
// dissolved where it is queued. Then the actors package's own finalizer waits
// for quiet again (a finalizer that ran may have sent a message) and stops the
// workers. A program that wants its actors' awaited I/O finished before it
// ends calls 'actors.waitUntilIdle()' last in 'main' (an INTERIM call: the
// actors package's header, WAITING FOR IDLE).
//
// A UDP SOCKET is a UdpSocket, a kind of its own beside Socket and File: a
// stream operation on it (read, write, accept), or a datagram one on a Socket,
// does not compile. Like a Socket it is plain data that moves, and dropping it
// closes the socket behind the operations queued before the close, every one
// then in flight on it cancelled. 'bindUdp' binds by iocore's 'bindUdp' on the
// I/O thread (port 0 has the system choose one, which 'localAddr' tells), as
// 'listen' listens; it has no 'In' form. The socket is not connected: each
// datagram names its other end. 'recvFrom' is iocore's RecvFrom: ONE datagram,
// appended to the buffer's room, the answer a Datagram, its 'buf' the buffer
// given (its length grown by the datagram's) and its 'from' the sender. A
// datagram of no bytes is a datagram, not an end: the buffer's length does not
// grow. A buffer with no room fails (122), as a read's does. A datagram longer
// than the room fails with an IoError of the kind Truncated ('aio.isTruncated',
// code 10040, WSAEMSGSIZE, on both systems): the rest of it is lost, the next
// one is whole, and the buffer, as a failed read's, goes home to its pool, the
// bytes that fitted with it. 'sendTo' is iocore's SendTo: all of the buffer as
// ONE datagram, the buffer going home; the count is its length; UDP promises no
// delivery, so the answer says the system took the datagram. A datagram too
// large for the network fails (10040, an Os error). One receive at a time per
// socket is the supported use, as iocore says; datagrams that arrive while none
// is outstanding wait in the socket's buffer, which the OS bounds.
//
// A FILE is the same for a file the I/O thread's Loop holds: plain data that
// moves, and dropping it closes the file, behind the operations queued before
// the close, every one then in flight on it cancelled. 'openFile' opens by
// iocore's 'openFile' on the I/O thread (Access.Read an existing file;
// Access.Create a new one, or an existing one emptied, to read and write;
// Access.Update an existing one or a new one, its bytes kept, to read and
// write) and answers the File, or the system's failure (ERROR_FILE_NOT_FOUND
// for a name that is not there, on both systems). The path is copied, so the
// caller's Path is its own. 'readAt' and 'writeAt' are iocore's ReadAt and
// WriteAt: at the byte offset given, with no cursor shared between operations,
// so many may be in flight on one file at once. A read appends what is there
// to its buffer, up to the buffer's room; reading from the end of the file or
// past it is Done with the buffer as it went, as a socket's end of stream is,
// and a buffer with no room fails (122), as a socket's does. A write's success
// is the count written, all of the buffer. The buffer goes home as a
// socket's does. 'openFile' has no 'In' form: opening is one call to the
// system that iocore does not hold in flight, so there is nothing to cancel
// once it has started; the two operations on a file have theirs.
//
// SLEEPING. 'sleep(d)' and 'sleepUntil(at)' are iocore's timers awaited (a
// record of diag.kindTimer): the behaviour pauses, and the I/O thread's Loop answers
// when the time comes. 'd' counts from the moment the I/O thread starts the
// timer, a moment after the 'await'; 'at' is absolute, and one already past is
// answered at once. The success holds nothing (Result[void, IoError]). The 'In'
// forms take an IoLimits as the other operations do, and honour the group's
// deadline as iocore's 'afterIn' does: a sleep due after the deadline (lim's,
// or its group's, the tighter) is answered TimedOut at the deadline, one due
// at or before it is Done at its time; the group's cancel answers Cancelled,
// at once if the group is cancelled already. lim's deadline is given to the
// timer as a group of its own (a child of lim's group, or a new one, which
// allocates), since iocore's timer takes a group alone. Dropped unawaited, a
// sleep does nothing.
//
// THE BLOCKING POOL'S WORK. 'resolve', 'stat' and 'run' are the three things
// iocore's blocking pool (its THE BLOCKING POOL) does for work with no
// completion form, each awaited as the rest: the operation is started on the
// I/O thread's Loop with an iocore Op, a thread of the pool does it, and the
// answer comes to the actor as any other. The job is answered exactly once, as
// iocore says: a job still queued for a thread is taken out by a cancel or a
// deadline (Cancelled, TimedOut, never run); one a thread has taken cannot be
// stopped, and answers when it ends, except that a deadline answers TimedOut
// at the deadline (past iocore's 1 ms grace) and the work goes on, its answer
// dropped. A lane whose queue is full refuses a job at once (Failed 170,
// ERROR_BUSY). The pool's lanes: 'resolve' uses the DNS lane (2 threads), 'stat'
// and 'run' the general lane (4 threads). 'resolve' and 'stat' take a buffer
// (IoBuf(n), made for the call) for iocore's op to carry its answer in; it goes
// home with the answer. A run's request and its answer are in its record,
// which the pool's thread works on while it is away.
//
// 'resolve(host, port)' is iocore's 'resolveOp' (getaddrinfo, the stream socket
// type): 'host' is a name or an address as text, and every address found is a
// SocketAddr with 'port' (its default 0): IPv4 and IPv6 as the system gives
// them, in its order. A name with no address fails with the system's number
// (Winsock's, 11001 WSAHOST_NOT_FOUND for a name that is not there; on Linux
// getaddrinfo's failure is given the Winsock number that names the same). The
// list is not empty when the answer is Ok.
//
// 'stat(path)' is iocore's 'statOp': the FileStat has the size in bytes, the
// attributes (Windows' FILE_ATTRIBUTE_ bits, on Linux made from the mode: 0x10
// a directory, 0x80 a plain file, 0x1 read-only) and the time of last write, a
// Timestamp; 'isDir()' reads the bit. A path that is not there fails with
// ERROR_FILE_NOT_FOUND (2) on both systems. The path is copied; a path that is
// not UTF-8 fails (ERROR_NO_UNICODE_TRANSLATION, 1113). Folders and files are
// told apart by the attributes; a symbolic link is followed on Linux, as 'stat'
// does.
//
// CHILD PROCESSES. 'run' and 'runLine' are the process package's synchronous
// 'run' and 'runLine', awaited: the same arguments (the same Options: a
// 'timeout' that stops the child and everything it started, 'inherit', 'crashReport';
// the same folder), the same Output (exit code, a signal on POSIX, 'timedOut',
// standard output and standard error captured apart), and the same rules for
// the program ('process' says them: how Windows finds it and quotes the
// arguments, what '/bin/sh -c' is). Only the waiting is different: the
// process package's call runs on a thread of the pool's general lane, and the
// actor's behaviour pauses until it ends. An exit code is an answer (Ok); an
// Error is a program that could not be started, an IoError of the system's
// number (the process package's ProcessError code, which is errno on Linux,
// turned into the Windows number iocore uses for IoError everywhere). The
// ProcessError's text (the program's name, the folder) is not carried: the
// caller has them. 'args' and 'dir' are copied.
//
// What the pool's thread does not give: a child's pipes to read or write
// while it runs, or to wait for it apart from starting it. A run is spawn,
// wait and the captured standard output and standard error in one awaited
// call, as the process package's is, because that is the process package's
// whole interface; a Child you spawn, then await, and whose output you read
// piece by piece would need that package to offer a spawn that returns the
// pipes, and the pipes to be handles iocore's Loop holds (a new op in iocore).
// A deadline or a cancel does not stop a child that is running: put a
// 'timeout' in the Options for that. A child still running when the program
// ends is left to the system (its pool thread is not waited for, as iocore
// says); its record is dissolved when the child ends, if the process is still
// there.
//
// METHOD CHOICES (defaults, not rulings):
//  - 'run' is the process package's synchronous 'run' on a thread of iocore's
//    general lane, not a new op in iocore's loop (no async process wait exists
//    there, and a pipe cannot be given to the Loop). The thread waits for the
//    child, as that package's 'run' does; at most four children (the lane's
//    threads) run at once, and a fifth waits queued (a cancel group takes it
//    out), more than 1,024 queued are refused (ERROR_BUSY).
//  - The answer of a run (the Output) is left by the pool thread in the run's
//    record (its run part, an Option), which waits for its job in every case,
//    so nothing else decides who frees what. The run part is held out of
//    line, by an owner of its own (one allocation more per run), so that
//    every other record stays small.
//  - A start failure is an IoError with the system's number (Windows') on both
//    systems; iocore has one function more for it, 'systemCode', which turns an
//    errno into that number.
//  - A read with no buffer ('read()') is two operations, a RecvReady and a Recv,
//    on one record started twice on the I/O thread; the quiet time is 2 ms, the
//    room 4 KiB, and "calm" is "the socket's last such read was answered within
//    the quiet time" (READS WITH NO BUFFER). None of these was ruled on.
//  - An operation's record is taken at the call that makes the operation, not
//    at its 'await': the buffer is in the record from then on, and the
//    Awaitable, a context word, names it.
//  - The answer is made by the 'take' the reply is sprung with, which
//    dissolves the record (ONE RECORD PER OPERATION), so that a lent answer
//    needs no place of its own: on the awaiting actor's worker when it is
//    lent, on the I/O thread when the slot holds it.
//  - A handle's close is a record (opClose), as a cancel is; listen, bindUdp,
//    openFile and localAddr stay jobs (one per handle).
//  - 'stat' and 'resolve' make their buffer for the call, not
//    one the caller passes; 'resolve' has the port as its second parameter
//    with a default of 0, and gives a List, whole.
//  - There is no 'readFile' (iocore's 'readFileOp'): a file opened with
//    'openFile' and read with 'readAt' does what it does, with the buffer the
//    caller chooses.
//
// On Windows and Linux, as iocore is; TCP sockets, UDP sockets and files (a
// socket does one operation at a time per direction, as iocore's do; a file
// many at once, at any offsets), names, file metadata and child processes. Not
// here: 'fileio', the file service with classes and a queue-depth governor (a
// package of its own, to come), a file's metadata by its handle, a child's
// pipes while it runs (above), and a socket's half-close.

mod aio;

import libc;
import thread;
import sync use Mutex;
import collections use List, String;
import iobuf use IoBuf;
import time use Instant, Duration;
import iocore use Loop, Waker, Op, OpCore, OpRec, OpPool, Completion, Handle, SocketAddr, IoError, CancelGroup, Access, Outcome, Lane, FileStat, forever, resolveOp, addressesIn, statOp, fileStatIn, systemCode, errorOperationAborted;
import path use Path;
import process;
import actors;
import diag;

fn @initpure init() {
  ioLock = Mutex.make();
  io = Atomic[usize].of(0usize);
  ended = Atomic[bool].of(false);
  readQuiet = Atomic[i64].of(2000000i64);
  poolAt = Atomic[usize].of(0usize);
  cancelsAsked = Atomic[u64].of(0u64);
  takenAway = Atomic[u64].of(0u64);
}

// A panic, reported at the line calling 'die'
fn die(msg: &str, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Never {
  panic(msg, file, line)
}

// ---------------------------------------------------------------------------
// The records: aio's pool, and what aio keeps in each (the package's header,
// ONE RECORD PER OPERATION)
// ---------------------------------------------------------------------------

// What a record is doing, and so which typed answer it gives
const opRecv = 1u32;          // read(buf): Result[IoBuf, IoError]
const opRecvAny = 2u32;       // read(), read(room): the same, with a buffer the I/O thread takes
const opAccept = 3u32;        // Result[Socket, IoError]
const opSend = 4u32;          // write(buf): Result[usize, IoError]
const opReadAt = 5u32;        // a file's read: Result[IoBuf, IoError]
const opWriteAt = 6u32;       // a file's write: Result[usize, IoError]
const opRecvFrom = 7u32;      // a datagram: Result[Datagram, IoError]
const opSendTo = 8u32;        // Result[usize, IoError]
const opConnect = 9u32;       // Result[Socket, IoError]
const opSleep = 10u32;        // Result[void, IoError]
const opResolve = 11u32;      // Result[List[SocketAddr], IoError]
const opStat = 12u32;         // Result[FileStat, IoError]
const opRun = 13u32;          // Result[process.Output, IoError]
const opCancel = 14u32;       // cancelRead, cancelWrite: no answer
const opClose = 15u32;        // a handle's close, its Socket, File or UdpSocket dropped: no answer

// What aio keeps in a record with the operation, after iocore's OpCore: the
// reply the awaiting behaviour's answer goes back in (put in by the 'await';
// until then a Reply() that wants no answer), what the record is doing, a read
// with no buffer's stage and policy state, and a run's request and answer
struct Ask is Sendable {
  reply: actors.Reply;
  what: u32;
  stage: u32;                   // a read with no buffer: stageReady ...; a sleep: sleepAt or sleepAfter
  ours: bool;                   // a read with no buffer: its deadline now is the quiet time's, tighter than the caller's
  write: bool;                  // a cancel's direction
  since: i64;                   // a read with no buffer: when its stage was started (the steady clock)
  arg: u64;                     // a read with no buffer: the room of the buffer it takes; a relative sleep's nanoseconds
  limit: Instant;               // the caller's deadline (lim's), the whole of a read with no buffer
  run: Option[Uni[RunPart]];    // a run's request, and its answer once a pool thread has run it: out of line
}

// A child process to run, and its answer: written by the pool's thread that
// runs it, while the record is away (iocore's THE BLOCKING POOL)
struct RunPart {
  isLine: bool;
  line: String;
  args: List[String];
  opts: process.Options;
  dir: Path;
  out: Option[Result[process.Output, IoError]];
}

// The process's pool of records: made by the first operation, never freed (an
// Awaitable may be dropped, or a lent answer taken, on a worker after the I/O
// thread has gone). An atomic held by a 'let' global, set in 'init'; the pool
// itself is a block of libc's
let poolAt: Atomic[usize];

fn thePool() &OpPool[Ask] {
  var at = poolAt.load();
  if at == 0usize {
    ioLock.lock();
    at = makePool();
    ioLock.unlock();
  }
  at as *OpPool[Ask] as &OpPool[Ask]
}

// The pool, made if it is not yet: ioLock is held (by thePool, or by startIo,
// so that the I/O thread finds it made)
fn makePool() usize {
  var at = poolAt.load();
  if at == 0usize {
    let cell = libc.malloc(mem.sizeof[OpPool[Ask]]()) as *OpPool[Ask];
    if cell as usize == 0usize {
      die("aio: out of memory for the pool of records");
    }
    mem.writeRaw[OpPool[Ask]](cell, OpPool[Ask].make());
    at = cell as usize;
    poolAt.store(at);
  }
  at
}

// Counts for opStats: records cancelled by cancelRead and cancelWrite, and
// answers taken (their records dissolved) on another thread than the I/O
// thread's: the awaiting actor's worker, the answer lent. Atomics held by 'let'
// globals, set in 'init'
let cancelsAsked: Atomic[u64];
let takenAway: Atomic[u64];

// True on the I/O thread alone
var @threadlocal onIo = false;

// The record's buffer replaced by b, through a reference, so that the one it
// held (if any) is dropped: home to its pool. (Not '(*p).buf = b': a store
// through a raw pointer does not finalize the value it replaces -- the
// manual's safe-pointers page -- and the buffer would never go home)
fn setBuf(p: *OpCore, b: Option[IoBuf]) {
  let c = p as &mut OpCore;
  c.buf = b;
}

// A record taken for an operation on h (Handle.none() for one that names no
// handle), what it is doing and the kind of iocore operation, limited by lim:
// any thread
fn takeRec(what: u32, kind: u32, h: Handle, lim: IoLimits) *OpRec[Ask] {
  let p = thePool().take(Ask(actors.Reply(), what, 0u32, false, false, 0i64, 0u64, forever(), None));
  let c = &mut (*p).core;
  c.kind = kind;
  c.handle = h;
  let g, d = lim.(group, deadline);
  c.group = g;
  c.deadline = d;
  (*p).ask.limit = d;
  p
}

// Record p read out whole and its cell free, on any thread: the I/O thread's
// give-backs are batched (iocore's dissolveHere), any other thread's under the
// pool's lock
fn dissolveAt(p: *u8) OpRec[Ask] {
  let pl = thePool();
  if onIo {
    return pl.dissolveHere(p as *OpRec[Ask]);
  }
  pl.dissolve(p as *OpRec[Ask])
}

// The record as an Awaitable[R]: nothing is allocated; its context word is
// the record
fn recAwaitable[R](p: *OpRec[Ask]) actors.Awaitable[R] {
  actors.Awaitable[R].of(p as *u8, &startRec, &dropRec)
}

// The seam starts the operation: the reply goes into the record, which goes
// to the I/O thread by its own queue link
fn startRec(ctx: *u8, rp: actors.Reply) {
  let a = &mut (*(ctx as *OpRec[Ask])).ask;
  a.reply = rp;
  enqueueRec(ctx as *OpCore);
}

// An Awaitable dropped unawaited: its record dissolved here, on the caller's
// thread, its buffer going home
fn dropRec(ctx: *u8) {
  let gone = dissolveAt(ctx);
}

// ---------------------------------------------------------------------------
// The I/O thread and its queue
// ---------------------------------------------------------------------------

// A job's header, first in its block: the next job queued, and the functions
// made for the job's type, which take the block. Jobs are what is one per
// handle and synchronous on the I/O thread: listen, bindUdp, openFile,
// localAddr
struct JobHead {
  pub next: *JobHead;
  pub run: &fn(job: *u8, lp: &mut Loop);
  pub drop: &fn(job: *u8);
}

// A job: its header, then what it is. J has 'run(self, lp &mut Loop)'
struct Job[J] {
  pub head: JobHead;
  pub body: J;
}

// The I/O thread, once started: its two queues, under ioLock -- jobs, and
// records linked by their own 'qnext' -- and its loop's waker, set before
// 'ready' and never changed. It lives as long as the process, the waker with
// it: a thread that queued something just before the end may still be waking
// the loop after the thread has been joined
struct IoThread {
  pub head: *JobHead;
  pub tail: *JobHead;
  pub rhead: *OpCore;
  pub rtail: *OpCore;
  pub waker: Waker;
  pub ready: Atomic[u32];       // 1 once the thread has put its waker here
  pub os: thread.Thread[u32];
}

// Guards the queues, 'io', 'ended' and the pool's making
let ioLock: Mutex;

// The I/O thread, or 0 before the first operation is awaited. Read and written
// under ioLock by any thread; an atomic held by a 'let' global, set in 'init'
let io: Atomic[usize];

// The program is ending: nothing is taken from the queues from now on (under
// ioLock). An atomic held by a 'let' global, set in 'init'
let ended: Atomic[bool];

fn nullJob() *JobHead {null}
fn nullCore() *OpCore {null}

// A job's block, its body moved in
fn newJob[J](body: J) *u8 {
  let p = libc.malloc(mem.sizeof[Job[J]]()) as *Job[J];
  if p as usize == 0usize {
    die("aio: out of memory for an operation");
  }
  (*p).head = JobHead(nullJob(), &runJob[J], &dropJob[J]);
  mem.writeRaw[J](&(*p).body as *J, body);
  p as *u8
}

// On the I/O thread: the job's body moved out, its block freed, and run
fn runJob[J](job: *u8, lp: &mut Loop) {
  let p = job as *Job[J];
  var body = mem.readRaw[J](&(*p).body as *J);
  libc.free(job);
  body.run(lp);
}

// A job never run: its body dropped (its reply among it, abandoning what
// awaits it), its block freed
fn dropJob[J](job: *u8) {
  let p = job as *Job[J];
  let body = mem.readRaw[J](&(*p).body as *J);
  libc.free(job);
}

fn dropHead(h: *JobHead) {
  let f = (*h).drop;
  f(h as *u8);
}

// Queue a job for the I/O thread, starting the thread if this is the first;
// once the program is ending, the job is dropped instead
fn enqueue(job: *u8) {
  let h = job as *JobHead;
  (*h).next = nullJob();
  ioLock.lock();
  if ended.load() {
    ioLock.unlock();
    dropHead(h);
    return;
  }
  if io.load() == 0usize {
    startIo();
  }
  let t = io.load() as *IoThread;
  if (*t).tail as usize == 0usize {
    (*t).head = h;
  } else {
    (*(*t).tail).next = h;
  }
  (*t).tail = h;
  ioLock.unlock();
  (*t).waker.wake();
}

// Queue a record for the I/O thread, by its own link: an operation to start,
// a cancel or a close. Once the program is ending it is dissolved unstarted
// instead, here: its reply dropped unsent (what awaits it abandoned), its
// buffer home
fn enqueueRec(p: *OpCore) {
  (*p).qnext = nullCore();
  ioLock.lock();
  if ended.load() {
    ioLock.unlock();
    let gone = dissolveAt(p as *u8);
    return;
  }
  if io.load() == 0usize {
    startIo();
  }
  let t = io.load() as *IoThread;
  if (*t).rtail as usize == 0usize {
    (*t).rhead = p;
  } else {
    (*(*t).rtail).qnext = p;
  }
  (*t).rtail = p;
  ioLock.unlock();
  (*t).waker.wake();
}

// What the I/O thread is handed: its IoThread, where it puts its loop's waker
struct IoArg {
  pub t: usize;
}

// Start the I/O thread, under ioLock: its Loop is made on it, and its waker
// is in place before this returns
fn startIo() {
  let pool = makePool();
  let t = libc.calloc(1usize, mem.sizeof[IoThread]()) as *IoThread;
  if t as usize == 0usize {
    die("aio: out of memory for the I/O thread");
  }
  mem.writeRaw[thread.Thread[u32]](&(*t).os as *thread.Thread[u32],
    thread.startWith(thread.Options(name: "aio I/O"), IoArg(t as usize), &ioMain));
  while (*t).ready.load() == 0u32 {
    sync.futexWait(&(*t).ready, 0u32);
  }
  io.store(t as usize);
}

// The I/O thread: it waits in its Loop's poll, and after each takes the
// records the Loop has answered (each is answered, or begun again), and then
// what is queued: jobs, which it runs, and records, which it starts. Once the
// program is ending (THE PROGRAM'S END), what is queued is dissolved
// unstarted, and only then does its Loop die, cancelling and draining every
// operation in flight and dissolving the records it still holds, their
// answers abandoned
fn ioMain(arg: IoArg) u32 {
  let me = arg.t as *IoThread;
  let pool = thePool();
  {
    var lp = Loop.mustMake();
    mem.writeRaw[Waker](&(*me).waker as *Waker, lp.waker());
    onIo = true;
    (*me).ready.store(1u32);
    sync.futexWake(&(*me).ready);
    var out = List[Completion].empty();
    var got = List[*OpCore].empty();
    var more = true;
    while more {
      lp.poll(forever(), &mut out);
      out.clear();
      ioLock.lock();
      let h = (*me).head;
      (*me).head = nullJob();
      (*me).tail = nullJob();
      let r = (*me).rhead;
      (*me).rhead = nullCore();
      (*me).rtail = nullCore();
      let stop = ended.load();
      ioLock.unlock();
      if stop {
        dropJobs(h);
        dissolveUnstarted(r);
        more = false;
      } else {
        lp.takeDone(&mut got);
        var k = 0usize;
        while k < got.len() {
          doneRec(&mut lp, *got[k]);
          k = k + 1usize;
        }
        got.clear();
        runJobs(h, &mut lp);
        startRecs(r, &mut lp);
      }
      pool.flushHere();
    }
  }
  pool.flushHere();
  0u32
}

fn runJobs(first: *JobHead, lp: &mut Loop) {
  var h = first;
  while h as usize != 0usize {
    let next = (*h).next;
    let f = (*h).run;
    f(h as *u8, lp);
    h = next;
  }
}

fn dropJobs(first: *JobHead) {
  var h = first;
  while h as usize != 0usize {
    let next = (*h).next;
    dropHead(h);
    h = next;
  }
}

fn startRecs(first: *OpCore, lp: &mut Loop) {
  var p = first;
  while p as usize != 0usize {
    let next = (*p).qnext;
    startOne(lp, p);
    p = next;
  }
}

// The records queued at the program's end: dissolved unstarted, each reply
// dropped unsent (what awaits it abandoned), each buffer home
fn dissolveUnstarted(first: *OpCore) {
  var p = first;
  while p as usize != 0usize {
    let next = (*p).qnext;
    let gone = dissolveAt(p as *u8);
    p = next;
  }
}

// The package's finalizer, run by finalAll() before the actors package's:
// once no actor is queued or running, the I/O ends, and every behaviour
// still paused on it is abandoned (the package's header, THE PROGRAM'S END)
fn final() {
  actors.waitQuiet();
  ioLock.lock();
  ended.store(true);
  let t = io.load() as *IoThread;
  ioLock.unlock();
  if t as usize == 0usize {
    return;
  }
  (*t).waker.wake();
  let th = mem.readRaw[thread.Thread[u32]](&(*t).os as *thread.Thread[u32]);
  th.join();
}

// ---------------------------------------------------------------------------
// Starting a record, and what comes back
// ---------------------------------------------------------------------------

// What limits an awaited operation (the package's header, CANCEL AND
// DEADLINES): a cancel group, one cancel of which ends it, and an absolute
// deadline, the tighter of it and the group's. Made by 'none', 'until' or
// 'within', or by hand: 'IoLimits(Some[CancelGroup](g), d)'
pub struct IoLimits {
  pub group: Option[CancelGroup];
  pub deadline: Instant;

  // Neither: the operation ends when it finishes
  pub fn none() IoLimits {IoLimits(None, forever())}

  // Answered TimedOut if not finished by deadline
  pub fn until(deadline: Instant) IoLimits {IoLimits(None, deadline)}

  // Ended by the group's cancel, and by its deadline if it has one
  pub fn within(group: CancelGroup) IoLimits {IoLimits(Some[CancelGroup](group), forever())}
}

// Whether an operation ended because it was cancelled: its group's cancel, or
// its socket closed
pub fn isCancelled(e: IoError) bool {e.isCancelled()}

// Whether an operation ended because its deadline passed
pub fn isTimedOut(e: IoError) bool {e.isTimedOut()}

// Whether a receive ended because the datagram was longer than the buffer's room
pub fn isTruncated(e: IoError) bool {e.isTruncated()}

// The room a read with no buffer of its own is given when it names none: the
// pool's smallest block
fn defaultRoom() usize {4096usize}

// A read that holds a buffer gives it up if no byte has come in this long (2
// ms by default), and waits with a zero-byte receive instead; a socket whose
// last read came in less than this is "calm", and its next read takes a buffer
// at once. Read by the I/O thread, set by 'setReadQuiet' (an atomic held by a
// 'let' global, set in 'init')
let readQuiet: Atomic[i64];

// The quiet time, in nanoseconds; a negative word is the time, less one,
// negated, with the test's late path asked for (testLateQuiet)
fn quietNanos() i64 {quietOf(readQuiet.load())}

fn quietOf(v: i64) i64 {if v < 0i64 {0i64 - v - 1i64} else {v}}

// Set how long a read with no buffer may hold one before giving it up (the
// package's header, READS WITH NO BUFFER): zero makes every such read wait
// with a zero-byte receive, a long time makes a socket's reads take a buffer
// at once after its first. Affects reads started from now on
pub fn setReadQuiet(d: Duration) {
  readQuiet.store(d.nanos());
}

// Where a read with no buffer is: a zero-byte receive is outstanding; a receive
// with a buffer, started at once, is; the receive with a buffer that takes what
// the zero-byte one said had come
fn stageReady() u32 {0u32}
fn stageStraight() u32 {1u32}
fn stageTake() u32 {2u32}
fn stageForced() u32 {3u32}         // stageStraight's, under the test's late path (testLateQuiet)

// A sleep's time: absolute (the record's deadline) or relative (its 'arg',
// nanoseconds from the moment the I/O thread starts it)
const sleepAt = 0u32;
const sleepAfter = 1u32;

// The handle's hint word (iocore's lp.hint): its last read with no buffer
// came quickly (READS WITH NO BUFFER)
const hintCalm = 1u32;

fn setCalm(lp: &mut Loop, h: Handle, calm: bool) {
  let v = lp.hint(h);
  lp.setHint(h, if calm {v | hintCalm} else {v & ~hintCalm});
}

// A record from the queue, on the I/O thread: a cancel or a close is done
// here and dissolved; an operation is started on the Loop
fn startOne(lp: &mut Loop, p: *OpCore) {
  let rp = p as *OpRec[Ask];
  let w = (*rp).ask.what;
  if w == opCancel {
    let n = lp.cancelHandle((*p).handle, (*rp).ask.write);
    cancelsAsked.add(u64.from(n));
    let gone = dissolveAt(p as *u8);
    return;
  }
  if w == opClose {
    lp.close((*p).handle);
    let gone = dissolveAt(p as *u8);
    return;
  }
  if w == opRecvAny {
    if (lp.hint((*p).handle) & hintCalm) != 0u32 {
      setBuf(p, Some[IoBuf](IoBuf(usize.from((*rp).ask.arg))));
      beginStage(lp, rp, stageStraight());
    } else {
      beginStage(lp, rp, stageReady());
    }
    return;
  }
  if w == opSleep {
    timeSleep(rp);
  }
  lp.start(p);
}

// Start a read with no buffer in the stage given, on the same record: a
// zero-byte receive (no buffer in the record), or a receive with the buffer
// the record holds. The caller's deadline and group bound the whole read; a
// receive begun at once with a buffer carries a deadline of the quiet time as
// well, when that is the earlier ('ours')
fn beginStage(lp: &mut Loop, rp: *OpRec[Ask], stage: u32) {
  let a = &mut (*rp).ask;
  let c = &mut (*rp).core;
  let now = Instant.now();
  a.stage = stage;
  a.ours = false;
  a.since = now.nanos();
  c.deadline = a.limit;
  if stage == stageReady() {
    c.kind = diag.kindRecvReady;
  } else {
    c.kind = diag.kindRecv;
    if stage == stageStraight() {
      let v = readQuiet.load();
      let soon = now + Duration.fromNanos(quietOf(v));
      if soon < a.limit {
        c.deadline = soon;
        a.ours = true;
      }
      if v < 0i64 {
        a.stage = stageForced();
      }
    }
  }
  lp.start(rp as *OpCore);
}

// A sleep's time and group, as it starts: due at its time (or 'arg' from now),
// unless lim ends it first. lim's group is the timer's cancel group, and lim's
// deadline narrows that group's (a group made for the purpose when there is
// none): a timer due after the deadline answers TimedOut at the deadline, as
// iocore's 'afterIn' does
fn timeSleep(rp: *OpRec[Ask]) {
  let c = &mut (*rp).core;
  let limit = (*rp).ask.limit;
  var due = c.deadline;
  if (*rp).ask.stage == sleepAfter {
    due = Instant.now() + Duration.fromNanos(i64.from((*rp).ask.arg));
  }
  var narrowed: Option[CancelGroup] = None;
  match c.group {
    case let Some(g) {
      if limit < forever() {narrowed = Some[CancelGroup](g.childUntil(limit));}
    }
    else {
      if limit < due {narrowed = Some[CancelGroup](CancelGroup.until(limit));}
    }
  }
  match narrowed {
    case let Some(g) {c.group = Some[CancelGroup](g);}
    else {}
  }
  c.deadline = due;
}

// A record the Loop has answered (lp.takeDone), on the I/O thread
fn doneRec(lp: &mut Loop, p: *OpCore) {
  let rp = p as *OpRec[Ask];
  let w = (*rp).ask.what;
  // A read with no buffer begun with one, ended by its own quiet deadline: not
  // the caller's answer
  let quiet = w == opRecvAny && (*rp).ask.ours
    && ((*rp).ask.stage == stageStraight() || (*rp).ask.stage == stageForced());
  if (p as &OpCore).isEarly() {
    // The bad case: the kernel still holds the record. The actor is answered
    // TimedOut now, by a value made here, and the record is left until the
    // kernel gives it back -- unless it was the read's own quiet time, which
    // answers nothing: the read goes on when the record is back
    if !quiet {
      answerTimedOut(rp);
    }
    return;
  }
  if (p as &OpCore).isLate() {
    if quiet {
      lateQuiet(lp, rp);
      return;
    }
    // Answered early: dissolved now, its buffer home, the spent reply dropped
    let gone = dissolveAt(p as *u8);
    return;
  }
  if w == opRecvAny {
    let stage = (*rp).ask.stage;
    if stage == stageReady() && (*p).status == diag.outcomeDone {
      // Bytes have come: a buffer is put in (over None), and the same record
      // takes them. Came quickly or not, the socket's next read starts in the
      // mode that suits
      let waited = Instant.now().nanos() - (*rp).ask.since;
      setCalm(lp, (*p).handle, waited < quietNanos());
      setBuf(p, Some[IoBuf](IoBuf(usize.from((*rp).ask.arg))));
      beginStage(lp, rp, stageTake());
      return;
    }
    if stage == stageStraight() {
      if (*p).status == diag.outcomeTimedOut && (*rp).ask.ours {
        // Quiet: the buffer, back with the answer, goes home (None over it),
        // and the read waits without one, on the same record
        setCalm(lp, (*p).handle, false);
        setBuf(p, None);
        beginStage(lp, rp, stageReady());
        return;
      }
      if (*p).status == diag.outcomeDone {
        setCalm(lp, (*p).handle, true);
      }
    } else if stage == stageForced() {
      // A test's (testLateQuiet): this receive taken through the late path, as
      // if the kernel had held it past the grace and finished it then
      lateQuiet(lp, rp);
      return;
    }
  }
  answerRec(rp);
}

// The quiet read's record back from the kernel late (the bad case, the read's
// own quiet deadline, which answered nobody). Its outcome is the kernel's
// (iocore's RECORDS): a receive that finished after all, Done, is the read's
// answer, its bytes kept (an end of the stream, Done(0), too); one that was
// cancelled holds no bytes: its buffer goes home, and the read waits without
// one, on the same record
fn lateQuiet(lp: &mut Loop, rp: *OpRec[Ask]) {
  let p = rp as *OpCore;
  if (*p).status == diag.outcomeDone {
    setCalm(lp, (*p).handle, true);
    answerRec(rp);
    return;
  }
  setCalm(lp, (*p).handle, false);
  setBuf(p, None);
  beginStage(lp, rp, stageReady());
}

// TEST-ONLY, not for programs (public only because Cone has no test-only
// visibility). While on, each read with no buffer begun with one is taken,
// when it is answered, through the late path of the bad case (lateQuiet), as
// if the kernel had held its receive past the grace of its quiet deadline and
// finished it then. The bad case itself cannot be made to happen on purpose.
// It costs a production read nothing: the switch is the sign of the quiet
// time's word, which a read begun with a buffer reads anyway, and a read under
// it has a stage of its own. setReadQuiet turns it off
pub fn testLateQuiet(on: bool) {
  let q = quietNanos();
  readQuiet.store(if on {0i64 - q - 1i64} else {q});
}

// The operation is over: the reply is sprung in place, its record LENT to
// 'take', which dissolves it and makes the answer from its pieces, straight
// into the awaiting actor's place -- here, before the answer is pushed, when
// the actor's slot holds the answer, or on the awaiting actor's worker as it
// reaches the reply, when it is lent (actors.answerLentIn). The record is not
// touched here after this. The Loop holds nothing of it (iocore's RECORDS, a
// record let go), which is checked
fn answerRec(rp: *OpRec[Ask]) {
  if !(rp as *OpCore as &OpCore).isLetGo() {
    die("aio: a record lent while its Loop still holds it");
  }
  let w = (*rp).ask.what;
  let back = &mut (*rp).ask.reply;
  if w == opRecv || w == opRecvAny || w == opReadAt {
    actors.answerLentIn[Result[IoBuf, IoError]](back, rp as *Result[IoBuf, IoError], &takeRead);
  } else if w == opAccept || w == opConnect {
    actors.answerLentIn[Result[Socket, IoError]](back, rp as *Result[Socket, IoError], &takeSocket);
  } else if w == opRecvFrom {
    actors.answerLentIn[Result[Datagram, IoError]](back, rp as *Result[Datagram, IoError], &takeDatagram);
  } else if w == opSleep {
    actors.answerLentIn[Result[void, IoError]](back, rp as *Result[void, IoError], &takeSleep);
  } else if w == opResolve {
    actors.answerLentIn[Result[List[SocketAddr], IoError]](back, rp as *Result[List[SocketAddr], IoError], &takeResolve);
  } else if w == opStat {
    actors.answerLentIn[Result[FileStat, IoError]](back, rp as *Result[FileStat, IoError], &takeStat);
  } else if w == opRun {
    actors.answerLentIn[Result[process.Output, IoError]](back, rp as *Result[process.Output, IoError], &takeRun);
  } else {
    actors.answerLentIn[Result[usize, IoError]](back, rp as *Result[usize, IoError], &takeCount);
  }
}

// The bad case's answer, TimedOut, made here with nothing from the record and
// written by answerNowIn, the Reply left spent in the record, which waits for
// the kernel (iocore's RECORDS, the one bad case)
fn answerTimedOut(rp: *OpRec[Ask]) {
  let w = (*rp).ask.what;
  let back = &mut (*rp).ask.reply;
  let e = IoError.timedOut();
  if w == opRecv || w == opRecvAny || w == opReadAt {
    actors.answerNowIn[Result[IoBuf, IoError]](back, Error[IoBuf, IoError](e));
  } else if w == opAccept || w == opConnect {
    actors.answerNowIn[Result[Socket, IoError]](back, Error[Socket, IoError](e));
  } else if w == opRecvFrom {
    actors.answerNowIn[Result[Datagram, IoError]](back, Error[Datagram, IoError](e));
  } else if w == opSleep {
    actors.answerNowIn[Result[void, IoError]](back, Error[void, IoError](e));
  } else if w == opResolve {
    actors.answerNowIn[Result[List[SocketAddr], IoError]](back, Error[List[SocketAddr], IoError](e));
  } else if w == opStat {
    actors.answerNowIn[Result[FileStat, IoError]](back, Error[FileStat, IoError](e));
  } else if w == opRun {
    actors.answerNowIn[Result[process.Output, IoError]](back, Error[process.Output, IoError](e));
  } else {
    actors.answerNowIn[Result[usize, IoError]](back, Error[usize, IoError](e));
  }
}

// ---------------------------------------------------------------------------
// The answers, made once, at the record's dissolution (each 'take')
// ---------------------------------------------------------------------------

// A lent record's dissolution, by its take: counted when it is on another
// thread than the I/O thread's (opStats)
fn dissolveTaken(p: *u8) OpRec[Ask] {
  if !onIo {
    takenAway.add(1u64);
  }
  dissolveAt(p)
}

// Done is the success, and anything else the error: Failed's the system's
// code, Cancelled's and TimedOut's their own
fn errorOf(status: u32, code: u32) IoError {
  if status == diag.outcomeCancelled {return IoError.cancelled();}
  if status == diag.outcomeTimedOut {return IoError.timedOut();}
  IoError(code)
}

// The buffer the record held, or an empty one
fn bufOf(buf: Option[IoBuf]) IoBuf {
  match buf {
    case var Some(b) {b}
    else {IoBuf.empty()}
  }
}

fn readResult(status: u32, code: u32, buf: Option[IoBuf]) Result[IoBuf, IoError] {
  if status != diag.outcomeDone {
    return Error[IoBuf, IoError](errorOf(status, code));
  }
  Ok[IoBuf, IoError](bufOf(buf))
}

// A read's: the buffer, the bytes that came appended. A failed read's buffer
// goes home, with the rest of the record
fn takeRead(p: *u8, to: *u8) {
  let rec = dissolveTaken(p);
  let core, ask = rec.(core, ask);
  let status = core.status;
  let code = core.code;
  let buf = core.(buf);
  mem.writeRaw[Result[IoBuf, IoError]](to as *Result[IoBuf, IoError], readResult(status, code, buf));
}

// Accept's and connect's: the new Socket
fn takeSocket(p: *u8, to: *u8) {
  let rec = dissolveTaken(p);
  let core, ask = rec.(core, ask);
  var v = Error[Socket, IoError](errorOf(core.status, core.code));
  if core.status == diag.outcomeDone {
    v = Ok[Socket, IoError](newSocket(core.newHandle));
  }
  mem.writeRaw[Result[Socket, IoError]](to as *Result[Socket, IoError], v);
}

// WSAEMSGSIZE, the code iocore answers a datagram longer than the room with
fn msgSizeCode() u32 {10040u32}

fn datagramResult(status: u32, code: u32, from: SocketAddr, buf: Option[IoBuf]) Result[Datagram, IoError] {
  if status == diag.outcomeDone {
    return Ok[Datagram, IoError](Datagram(bufOf(buf), from));
  }
  if status == diag.outcomeFailed && code == msgSizeCode() {
    return Error[Datagram, IoError](IoError.truncated());
  }
  Error[Datagram, IoError](errorOf(status, code))
}

// A receive's: the datagram, in its buffer, and who sent it. A datagram cut to
// the room is the error Truncated, and its buffer, like a failed read's, goes
// home
fn takeDatagram(p: *u8, to: *u8) {
  let rec = dissolveTaken(p);
  let core, ask = rec.(core, ask);
  let status = core.status;
  let code = core.code;
  let from = core.peer();
  let buf = core.(buf);
  mem.writeRaw[Result[Datagram, IoError]](to as *Result[Datagram, IoError], datagramResult(status, code, from, buf));
}

// A write's: the count, all of the buffer, which goes home
fn takeCount(p: *u8, to: *u8) {
  let rec = dissolveTaken(p);
  let core, ask = rec.(core, ask);
  var v = Error[usize, IoError](errorOf(core.status, core.code));
  if core.status == diag.outcomeDone {
    v = Ok[usize, IoError](core.n);
  }
  mem.writeRaw[Result[usize, IoError]](to as *Result[usize, IoError], v);
}

// A timer's: Done is the success, a Result with nothing in it
fn takeSleep(p: *u8, to: *u8) {
  let rec = dissolveTaken(p);
  let core, ask = rec.(core, ask);
  var v = Error[void, IoError](errorOf(core.status, core.code));
  if core.status == diag.outcomeDone {
    v = Ok[void, IoError](nil);
  }
  mem.writeRaw[Result[void, IoError]](to as *Result[void, IoError], v);
}

fn resolveResult(status: u32, code: u32, buf: Option[IoBuf]) Result[List[SocketAddr], IoError] {
  if status != diag.outcomeDone {
    return Error[List[SocketAddr], IoError](errorOf(status, code));
  }
  let b = bufOf(buf);
  Ok[List[SocketAddr], IoError](addressesIn(&b))
}

// A name looked up: the addresses, from the buffer the lookup filled
fn takeResolve(p: *u8, to: *u8) {
  let rec = dissolveTaken(p);
  let core, ask = rec.(core, ask);
  let status = core.status;
  let code = core.code;
  let buf = core.(buf);
  mem.writeRaw[Result[List[SocketAddr], IoError]](to as *Result[List[SocketAddr], IoError], resolveResult(status, code, buf));
}

fn statResult(status: u32, code: u32, buf: Option[IoBuf]) Result[FileStat, IoError] {
  if status != diag.outcomeDone {
    return Error[FileStat, IoError](errorOf(status, code));
  }
  let b = bufOf(buf);
  Ok[FileStat, IoError](fileStatIn(&b))
}

// A file's metadata, from the buffer the query filled
fn takeStat(p: *u8, to: *u8) {
  let rec = dissolveTaken(p);
  let core, ask = rec.(core, ask);
  let status = core.status;
  let code = core.code;
  let buf = core.(buf);
  mem.writeRaw[Result[FileStat, IoError]](to as *Result[FileStat, IoError], statResult(status, code, buf));
}

// ERROR_OPERATION_ABORTED, what a run's answer says if the pool's thread left none
fn abortedCode() u32 {errorOperationAborted}

fn runAnswer(status: u32, code: u32, run: Option[Uni[RunPart]]) Result[process.Output, IoError] {
  if status != diag.outcomeDone {
    return Error[process.Output, IoError](errorOf(status, code));
  }
  match run {
    case var Some(owner) {
      let part = *owner;
      let out = part.(out);
      match out {
        case var Some(o) {o}
        else {Error[process.Output, IoError](IoError(abortedCode()))}
      }
    }
    else {Error[process.Output, IoError](IoError(abortedCode()))}
  }
}

// A run's: the Output the pool's thread left in the record, or the error
fn takeRun(p: *u8, to: *u8) {
  let rec = dissolveTaken(p);
  let core, ask = rec.(core, ask);
  let status = core.status;
  let code = core.code;
  let run = ask.(run);
  mem.writeRaw[Result[process.Output, IoError]](to as *Result[process.Output, IoError], runAnswer(status, code, run));
}

// What the process package answered, as this package's Result: the Output, or
// the IoError of the number the system gave (Windows' on every system)
fn runResult(r: Result[process.Output, process.ProcessError]) Result[process.Output, IoError] {
  match r {
    case let Ok(o) {Ok[process.Output, IoError](o)}
    case let Error(e) {Error[process.Output, IoError](IoError(systemCode(e.code)))}
  }
}

// On a pool thread: the run's record is away, its run part this thread's
// (iocore's THE BLOCKING POOL); 'arg' is the record. The program is run and
// waited for, and its answer left in the record, which comes home with it
fn runWork(arg: u64, buf: &mut IoBuf) Outcome {
  let rp = usize.from(arg) as *OpRec[Ask];
  match &mut (*rp).ask.run {
    case var &mut Some(owner) {
      let part = &mut **owner;
      var r: Result[process.Output, IoError];
      if part.isLine {
        r = runResult(process.runLine(part.line.view(), part.opts, &part.dir));
      } else {
        r = runResult(process.run(part.args.view(), part.opts, &part.dir));
      }
      part.out = Some[Result[process.Output, IoError]](r);
      Outcome.Done(0usize)
    }
    else {Outcome.Failed(abortedCode())}
  }
}

// What the records have done so far (opStats)
pub struct OpStats {
  pub inUse: u64;          // records taken and not yet dissolved: an operation each, made, in flight or answered and not taken
  pub made: u64;           // records the pool has made (chunks of 64), free or taken
  pub cancelsAsked: u64;   // operations cancelRead and cancelWrite have asked to end
  pub takenAway: u64;      // answers taken, their records dissolved, on another thread than the I/O thread's
  pub recordBytes: u64;    // the size of one record (iocore's OpCore and aio's part)
}

// The pool's counts, and the two above: zero before the first record is taken
pub fn opStats() OpStats {
  let at = poolAt.load();
  if at == 0usize {
    return OpStats(0u64, 0u64, cancelsAsked.load(), takenAway.load(), u64.from(mem.sizeof[OpRec[Ask]]()));
  }
  let pl = at as *OpPool[Ask] as &OpPool[Ask];
  OpStats(u64.from(pl.inUse()), u64.from(pl.size()), cancelsAsked.load(), takenAway.load(),
    u64.from(mem.sizeof[OpRec[Ask]]()))
}

// ---------------------------------------------------------------------------
// The jobs: what is one per handle and synchronous on the I/O thread
// ---------------------------------------------------------------------------

// The seam starts a job: the reply its answer goes back in is written into
// the job, which goes to the I/O thread (actors.Awaitable's closure)
fn startJob[J](ctx: *u8, rp: actors.Reply) {
  let p = ctx as *Job[J];
  (*p).body.reply = rp;
  enqueue(ctx);
}

// A job's block until the 'await' starts it: 'take' hands it on, and an
// Awaitable that dies unawaited, its closure finalized, drops the job it still
// holds (its body dropped, its reply among it)
struct JobHold is Move {
  job: *u8;

  fn take(self: &mut) *u8 {
    let j = job;
    job = null;
    j
  }

  fn final(self: &uni) {
    if job as usize != 0usize {
      dropHead(job as *JobHead);
    }
  }
}

// The job awaited: its block, made now, started by the 'await'
fn awaitable[J, R](body: J) actors.Awaitable[R] {
  actors.Awaitable[R].make(fn(rp: actors.Reply) [var held = JobHold(newJob[J](body))] {
    startJob[J](held.take(), rp);
  })
}

// A listening socket, made on the I/O thread's Loop, which holds it
struct ListenJob {
  pub addr: SocketAddr;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let addr, rp = self.(addr, reply);
    match lp.listen(addr) {
      case let Ok(ok) {actors.answerNow[Result[Socket, IoError]](rp, Ok[Socket, IoError](newSocket(ok)));}
      case let Error(e) {actors.answerNow[Result[Socket, IoError]](rp, Error[Socket, IoError](e));}
    }
  }
}

// A UDP socket bound on the I/O thread's Loop, which holds it
struct BindUdpJob {
  pub addr: SocketAddr;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let addr, rp = self.(addr, reply);
    match lp.bindUdp(addr) {
      case let Ok(ok) {actors.answerNow[Result[UdpSocket, IoError]](rp, Ok[UdpSocket, IoError](newUdp(ok)));}
      case let Error(e) {actors.answerNow[Result[UdpSocket, IoError]](rp, Error[UdpSocket, IoError](e));}
    }
  }
}

// A file opened on the I/O thread's Loop, which holds it
struct OpenFileJob {
  pub path: Path;
  pub access: Access;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let path, access, rp = self.(path, access, reply);
    match lp.openFile(&path, access) {
      case let Ok(ok) {actors.answerNow[Result[File, IoError]](rp, Ok[File, IoError](newFile(ok)));}
      case let Error(e) {actors.answerNow[Result[File, IoError]](rp, Error[File, IoError](e));}
    }
  }
}

// A socket's address, read on the I/O thread
struct LocalAddrJob {
  pub h: Handle;
  pub reply: actors.Reply;

  fn run(self, lp: &mut Loop) {
    let h, rp = self.(h, reply);
    actors.answerNow[Result[SocketAddr, IoError]](rp, lp.localAddr(h));
  }
}

// The values the module's handles are made into
fn newSocket(h: Handle) Socket {
  if h.isNone() {
    return Socket.none();
  }
  Socket(h)
}

fn newFile(h: Handle) File {
  if h.isNone() {
    return File.none();
  }
  File(h)
}

fn newUdp(h: Handle) UdpSocket {
  if h.isNone() {
    return UdpSocket.none();
  }
  UdpSocket(h)
}

// A handle's read or write in flight, every one, asked to end (cancelRead,
// cancelWrite): a small record queued, which the I/O thread turns into
// iocore's cancelHandle. From any thread
fn cancelSide(h: Handle, write: bool) {
  if h.isNone() {
    return;
  }
  let p = takeRec(opCancel, 0u32, h, IoLimits.none());
  (*p).ask.write = write;
  enqueueRec(p as *OpCore);
}

// A handle closed, its Socket, File or UdpSocket dropped: a small record
// queued behind the operations queued before it. Nothing awaits it
fn closeHandle(h: Handle) {
  if h.isNone() {
    return;
  }
  enqueueRec(takeRec(opClose, 0u32, h, IoLimits.none()) as *OpCore);
}

// ---------------------------------------------------------------------------
// Sockets
// ---------------------------------------------------------------------------

// A TCP socket the I/O thread holds (the package's header, A SOCKET): it
// moves, and dropping it closes the socket
pub struct Socket is Move, Sendable {
  h: Handle;

  // A Socket naming nothing, which closes nothing: to swap one out of a
  // Result, or into a field before one is there
  pub fn none() Socket {Socket(Handle.none())}

  pub fn isNone(self: &) bool {h.isNone()}

  // The iocore handle it names, on the I/O thread's Loop
  pub fn handle(self: &) Handle {h}

  // The next connection on this listening socket
  pub fn accept(self: &) actors.Awaitable[Result[Socket, IoError]] {
    self.acceptIn(IoLimits.none())
  }

  // The next connection, ended if lim says so (the package's header, CANCEL
  // AND DEADLINES)
  pub fn acceptIn(self: &, lim: IoLimits) actors.Awaitable[Result[Socket, IoError]] {
    recAwaitable[Result[Socket, IoError]](takeRec(opAccept, diag.kindAccept, h, lim))
  }

  // What arrives, appended to buf, which is moved in and comes back in the
  // answer; at the clean end of the stream, buf comes back as it was. A buf
  // with no room fails (ERROR_INSUFFICIENT_BUFFER, 122)
  pub fn readBuf overload read(self: &, buf: IoBuf) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readBufIn(buf, IoLimits.none())
  }

  // A read ended if lim says so; then the buffer goes home to its pool
  pub fn readBufIn overload readIn(self: &, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[IoBuf, IoError]] {
    let p = takeRec(opRecv, diag.kindRecv, h, lim);
    setBuf(p as *OpCore, Some[IoBuf](buf));
    recAwaitable[Result[IoBuf, IoError]](p)
  }

  // What arrives, in a buffer the I/O side takes: the caller holds none, and
  // none is held while the read waits for the connection to be heard from
  // (the package's header, READS WITH NO BUFFER). The buffer is 4 KiB and
  // comes back in the answer like a read's; at the clean end of the stream it
  // comes back empty
  pub fn readAny overload read(self: &) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readAnyIn(IoLimits.none())
  }

  // A read with no buffer, ended if lim says so
  pub fn readAnyIn overload readIn(self: &, lim: IoLimits) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readRoomIn(defaultRoom(), lim)
  }

  // A read with no buffer, the buffer made with room for at least 'room'
  // bytes (the pools' block that fits): for a layer that knows what it wants,
  // a TLS session's record is 16 KiB
  pub fn readRoom overload read(self: &, room: usize) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readRoomIn(room, IoLimits.none())
  }

  pub fn readRoomIn overload readIn(self: &, room: usize, lim: IoLimits) actors.Awaitable[Result[IoBuf, IoError]] {
    let p = takeRec(opRecvAny, diag.kindRecvReady, h, lim);
    (*p).ask.arg = u64.from(room);
    recAwaitable[Result[IoBuf, IoError]](p)
  }

  // All of buf, which is moved in and goes home once sent: the count
  pub fn write(self: &, buf: IoBuf) actors.Awaitable[Result[usize, IoError]] {
    self.writeIn(buf, IoLimits.none())
  }

  // A write ended if lim says so, part of buf perhaps sent
  pub fn writeIn(self: &, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[usize, IoError]] {
    let p = takeRec(opSend, diag.kindSend, h, lim);
    setBuf(p as *OpCore, Some[IoBuf](buf));
    recAwaitable[Result[usize, IoError]](p)
  }

  // Ask every read (and accept) in flight on this socket to end (the package's
  // header, ONE DIRECTION OF A HANDLE): each is answered Cancelled, as a
  // group's cancel answers it, with its buffer given back. One made and not
  // yet started by its 'await' is not affected. From any thread, idempotent
  pub fn cancelRead(self: &) {
    cancelSide(h, false);
  }

  // The same for every write in flight
  pub fn cancelWrite(self: &) {
    cancelSide(h, true);
  }

  // The address the socket is bound to: a listening socket's port, where the
  // system chose it
  pub fn localAddr(self: &) actors.Awaitable[Result[SocketAddr, IoError]] {
    awaitable[LocalAddrJob, Result[SocketAddr, IoError]](LocalAddrJob(h, actors.Reply()))
  }

  fn final(self: &uni) {
    closeHandle(h);
  }
}

// ---------------------------------------------------------------------------
// UDP sockets
// ---------------------------------------------------------------------------

// A datagram received: its bytes, in the buffer the receive was given, and the
// address it came from
pub struct Datagram {
  pub buf: IoBuf;
  pub from: SocketAddr;
}

// A UDP socket the I/O thread holds (the package's header, A UDP SOCKET): a
// kind of its own beside Socket and File, so that a stream operation on it, or
// a datagram operation on a TCP socket, does not compile. It moves, and
// dropping it closes the socket
pub struct UdpSocket is Move, Sendable {
  h: Handle;

  // A UdpSocket naming nothing, which closes nothing: to swap one out of a
  // Result, or into a field before one is there
  pub fn none() UdpSocket {UdpSocket(Handle.none())}

  pub fn isNone(self: &) bool {h.isNone()}

  // The iocore handle it names, on the I/O thread's Loop
  pub fn handle(self: &) Handle {h}

  // The next datagram to arrive, appended to buf, which is moved in and comes
  // back in the answer with the sender's address. A datagram of no bytes is a
  // datagram (the buffer's length is unchanged). A datagram longer than buf's
  // room is the error Truncated (code 10040, WSAEMSGSIZE), the rest of it lost,
  // and the buffer goes home to its pool, as a failed read's does. A buf with
  // no room fails (ERROR_INSUFFICIENT_BUFFER, 122)
  pub fn recvFrom(self: &, buf: IoBuf) actors.Awaitable[Result[Datagram, IoError]] {
    self.recvFromIn(buf, IoLimits.none())
  }

  // A receive ended if lim says so; then the buffer goes home to its pool
  pub fn recvFromIn(self: &, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[Datagram, IoError]] {
    let p = takeRec(opRecvFrom, diag.kindRecvFrom, h, lim);
    setBuf(p as *OpCore, Some[IoBuf](buf));
    recAwaitable[Result[Datagram, IoError]](p)
  }

  // All of buf as one datagram to addr, buf moved in and going home once sent:
  // the count, its length. UDP promises no delivery: the answer says the
  // system took the datagram. One too large for the network fails (10040)
  pub fn sendTo(self: &, addr: SocketAddr, buf: IoBuf) actors.Awaitable[Result[usize, IoError]] {
    self.sendToIn(addr, buf, IoLimits.none())
  }

  // A send ended if lim says so
  pub fn sendToIn(self: &, addr: SocketAddr, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[usize, IoError]] {
    let p = takeRec(opSendTo, diag.kindSendTo, h, lim);
    setBuf(p as *OpCore, Some[IoBuf](buf));
    (*p).core.setPeer(addr);
    recAwaitable[Result[usize, IoError]](p)
  }

  // Ask every receive in flight on this socket to end, as Socket's cancelRead
  pub fn cancelRead(self: &) {
    cancelSide(h, false);
  }

  // The same for every send in flight
  pub fn cancelWrite(self: &) {
    cancelSide(h, true);
  }

  // The address the socket is bound to: its port, where the system chose it
  pub fn localAddr(self: &) actors.Awaitable[Result[SocketAddr, IoError]] {
    awaitable[LocalAddrJob, Result[SocketAddr, IoError]](LocalAddrJob(h, actors.Reply()))
  }

  fn final(self: &uni) {
    closeHandle(h);
  }
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

// A file the I/O thread holds (the package's header, A FILE): it moves, and
// dropping it closes the file
pub struct File is Move, Sendable {
  h: Handle;

  // A File naming nothing, which closes nothing: to swap one out of a
  // Result, or into a field before one is there
  pub fn none() File {File(Handle.none())}

  pub fn isNone(self: &) bool {h.isNone()}

  // The iocore handle it names, on the I/O thread's Loop
  pub fn handle(self: &) Handle {h}

  // What is in the file from byte offset 'at', appended to buf, which is moved
  // in and comes back in the answer; from the end of the file or past it, buf
  // comes back as it was. A buf with no room fails (ERROR_INSUFFICIENT_BUFFER,
  // 122)
  pub fn readAt(self: &, at: u64, buf: IoBuf) actors.Awaitable[Result[IoBuf, IoError]] {
    self.readAtIn(at, buf, IoLimits.none())
  }

  // A read ended if lim says so; then the buffer goes home to its pool
  pub fn readAtIn(self: &, at: u64, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[IoBuf, IoError]] {
    let p = takeRec(opReadAt, diag.kindReadAt, h, lim);
    setBuf(p as *OpCore, Some[IoBuf](buf));
    (*p).core.at = at;
    recAwaitable[Result[IoBuf, IoError]](p)
  }

  // All of buf, which is moved in and goes home once written, at byte offset
  // 'at': the count
  pub fn writeAt(self: &, at: u64, buf: IoBuf) actors.Awaitable[Result[usize, IoError]] {
    self.writeAtIn(at, buf, IoLimits.none())
  }

  // A write ended if lim says so, part of buf perhaps written
  pub fn writeAtIn(self: &, at: u64, buf: IoBuf, lim: IoLimits) actors.Awaitable[Result[usize, IoError]] {
    let p = takeRec(opWriteAt, diag.kindWriteAt, h, lim);
    setBuf(p as *OpCore, Some[IoBuf](buf));
    (*p).core.at = at;
    recAwaitable[Result[usize, IoError]](p)
  }

  // Ask every read in flight on this file to end, as Socket's cancelRead (a
  // file takes many reads at once: each is ended)
  pub fn cancelRead(self: &) {
    cancelSide(h, false);
  }

  // The same for every write
  pub fn cancelWrite(self: &) {
    cancelSide(h, true);
  }

  fn final(self: &uni) {
    closeHandle(h);
  }
}

// The file at path, opened as access says (the package's header, A FILE)
pub fn openFile(path: &Path, access: Access) actors.Awaitable[Result[File, IoError]] {
  awaitable[OpenFileJob, Result[File, IoError]](OpenFileJob(path.copy(), access, actors.Reply()))
}

// A TCP socket listening at addr, for accept; port 0 has the system choose
// one, which localAddr tells
pub fn listen(addr: SocketAddr) actors.Awaitable[Result[Socket, IoError]] {
  awaitable[ListenJob, Result[Socket, IoError]](ListenJob(addr, actors.Reply()))
}

// A UDP socket bound to addr, for recvFrom and sendTo; port 0 has the system
// choose one, which localAddr tells
pub fn bindUdp(addr: SocketAddr) actors.Awaitable[Result[UdpSocket, IoError]] {
  awaitable[BindUdpJob, Result[UdpSocket, IoError]](BindUdpJob(addr, actors.Reply()))
}

// A TCP socket connected to addr
pub fn connect(addr: SocketAddr) actors.Awaitable[Result[Socket, IoError]] {
  connectIn(addr, IoLimits.none())
}

// A TCP socket connected to addr, ended if lim says so
pub fn connectIn(addr: SocketAddr, lim: IoLimits) actors.Awaitable[Result[Socket, IoError]] {
  let p = takeRec(opConnect, diag.kindConnect, Handle.none(), lim);
  (*p).core.setPeer(addr);
  recAwaitable[Result[Socket, IoError]](p)
}

// Pauses for d, counted from the 'await': Ok(nil) when it has passed
pub fn sleep(d: Duration) actors.Awaitable[Result[void, IoError]] {
  sleepIn(d, IoLimits.none())
}

// A sleep ended if lim says so (the package's header, SLEEPING)
pub fn sleepIn(d: Duration, lim: IoLimits) actors.Awaitable[Result[void, IoError]] {
  let p = takeRec(opSleep, diag.kindTimer, Handle.none(), lim);
  (*p).ask.stage = sleepAfter;
  let ns = d.nanos();
  (*p).ask.arg = if ns > 0i64 {u64.from(ns)} else {0u64};
  recAwaitable[Result[void, IoError]](p)
}

// Pauses until the instant 'at' (one already past is Ok at once): Ok(nil)
pub fn sleepUntil(at: Instant) actors.Awaitable[Result[void, IoError]] {
  sleepUntilIn(at, IoLimits.none())
}

// A sleepUntil ended if lim says so (the package's header, SLEEPING)
pub fn sleepUntilIn(at: Instant, lim: IoLimits) actors.Awaitable[Result[void, IoError]] {
  let p = takeRec(opSleep, diag.kindTimer, Handle.none(), lim);
  (*p).ask.stage = sleepAt;
  (*p).core.deadline = at;
  recAwaitable[Result[void, IoError]](p)
}

// ---------------------------------------------------------------------------
// The blocking pool's work: names, file metadata, child processes
// ---------------------------------------------------------------------------

// The room a lookup or a query is given: the name or the path it holds, and
// more than the answer needs
fn roomFor(text: &Array[u8]) usize {
  if text.len > 4096usize {text.len} else {4096usize}
}

// An iocore Call (resolveOp's, statOp's) into the record: its buffer, lane,
// work and argument
fn fillCall(c: &mut OpCore, op: Op) {
  match op {
    case let Call(o) {
      let buf, lane, work, arg = o.(buf, lane, work, arg);
      c.buf = Some[IoBuf](buf);
      c.lane = lane;
      c.work = work;
      c.at = arg;
    }
    else {}
  }
}

// The addresses host names (a name, or an address as text), each with port,
// looked up by iocore's 'resolveOp' on the pool's DNS lane (the package's
// header, THE BLOCKING POOL'S WORK). A name with no address is the system's
// failure (Winsock's number: 11001, WSAHOST_NOT_FOUND, for a name that is not
// there)
pub fn resolve(host: &str, port: u16 = 0u16) actors.Awaitable[Result[List[SocketAddr], IoError]] {
  resolveIn(host, port, IoLimits.none())
}

// A lookup ended if lim says so: a deadline past the grace answers TimedOut
// while the lookup goes on
pub fn resolveIn(host: &str, port: u16, lim: IoLimits) actors.Awaitable[Result[List[SocketAddr], IoError]] {
  let p = takeRec(opResolve, diag.kindCall, Handle.none(), lim);
  fillCall(&mut (*p).core, resolveOp(host, port, IoBuf(roomFor(host))));
  recAwaitable[Result[List[SocketAddr], IoError]](p)
}

// A file's size, attributes and time of last write, by iocore's 'statOp' on
// the pool's general lane; a path that is not there fails with
// ERROR_FILE_NOT_FOUND (2) on both systems
pub fn stat(path: &Path) actors.Awaitable[Result[FileStat, IoError]] {
  statIn(path, IoLimits.none())
}

// A query ended if lim says so
pub fn statIn(path: &Path, lim: IoLimits) actors.Awaitable[Result[FileStat, IoError]] {
  let p = takeRec(opStat, diag.kindCall, Handle.none(), lim);
  fillCall(&mut (*p).core, statOp(path, Lane.general(), IoBuf(roomFor(path.view()))));
  recAwaitable[Result[FileStat, IoError]](p)
}

fn copyArgs(args: &Array[String]) List[String] {
  var copy = List[String].empty();
  var i = 0usize;
  while i < args.len {
    copy.push(String.from(args[i].view()));
    i = i + 1usize;
  }
  copy
}

// A child process's run as a record: a Call on the general lane whose work
// (runWork) is handed the record itself, its run part the request
fn runAwaitable(isLine: bool, line: &str, args: List[String], opts: process.Options, dir: &Path, lim: IoLimits) actors.Awaitable[Result[process.Output, IoError]] {
  let p = takeRec(opRun, diag.kindCall, Handle.none(), lim);
  let a = &mut (*p).ask;
  a.run = Some[Uni[RunPart]](Uni[RunPart](RunPart(isLine, String.from(line), args, opts, dir.copy(), None)));
  let c = &mut (*p).core;
  c.lane = Lane.general();
  c.work = &runWork;
  c.at = u64.from(p as usize);
  recAwaitable[Result[process.Output, IoError]](p)
}

// Runs args[0] with the rest as its arguments, in the folder dir (the current
// one if empty), and waits for it to end, as the process package's 'run': the
// Output holds its exit code and what it wrote to its standard output and
// standard error, apart; a program that could not be started is the Error
// (its system error number: ERROR_FILE_NOT_FOUND, 2, for none of that name).
// The behaviour pauses meanwhile, and a thread of the blocking pool waits for
// the child (the package's header, CHILD PROCESSES). 'opts' is the process
// package's Options: a 'timeout' stops the child and everything it started
pub fn run(args: &Array[String], opts: process.Options = process.Options(), dir: &Path = "") actors.Awaitable[Result[process.Output, IoError]] {
  runAwaitable(false, "", copyArgs(args), opts, dir, IoLimits.none())
}

// A run ended if lim says so: a job still queued for a thread is taken out
// (Cancelled, TimedOut), and one running is answered when it ends, or, for a
// deadline, TimedOut at once with the child left running (set 'opts.timeout' to
// stop it)
pub fn runIn(args: &Array[String], opts: process.Options, dir: &Path, lim: IoLimits) actors.Awaitable[Result[process.Output, IoError]] {
  runAwaitable(false, "", copyArgs(args), opts, dir, lim)
}

// Runs a command line written out by hand, as the process package's 'runLine'
// ('cmd /c ...' on Windows; the shell's '/bin/sh -c' line on Linux)
pub fn runLine(line: &str, opts: process.Options = process.Options(), dir: &Path = "") actors.Awaitable[Result[process.Output, IoError]] {
  runAwaitable(true, line, List[String].empty(), opts, dir, IoLimits.none())
}

// A runLine ended if lim says so, as 'runIn'
pub fn runLineIn(line: &str, opts: process.Options, dir: &Path, lim: IoLimits) actors.Awaitable[Result[process.Output, IoError]] {
  runAwaitable(true, line, List[String].empty(), opts, dir, lim)
}
