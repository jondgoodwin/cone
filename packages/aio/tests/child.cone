// aio.run and aio.runLine: an actor runs a child process and pauses meanwhile;
// the child is started by process.launch, its pipes read and its exit awaited
// as operations of iocore's Loop, and the actor's worker is free. One actor runs the basic cases in turn and reports numbers on a
// channel; main checks them. The programs are the system's own (Windows:
// 'cmd /c ...' and 'ping -n N 127.0.0.1', which waits N-1 seconds; Linux:
// 'echo', 'sh -c' lines and 'sleep N'):
//
//   run(["cmd","/c","echo","hello"]) (Linux: ["echo","hello"]) -- Done, exit
//     code 0, standard output "hello" and a line end, standard error empty;
//   runLine of 'exit 3' -- Done, exit code 3 (an exit code is an answer);
//   runLine writing "oops" to its standard error -- stderr holds it, stdout is empty;
//   a program that is not there -- an Err, a system failure, NotFound
//     (ERROR_FILE_NOT_FOUND, ENOENT); a folder that is not there -- an Err;
//   a child slower than Options.timeout -- Done, 'timedOut', in time.
//
// Then: twenty children at once (all Done); twelve children of a second each
// at once (more than four: all Done together in well under the three seconds
// a cap of four would take); a child that takes about a second, and, while it
// runs, another actor sleeping in 100 ms steps -- the sleeper finishes first
// (nothing waits on a worker); a running child in a cancel group main cancels
// -- Cancelled at once; a running child under a deadline -- TimedOut at the
// deadline (the child stopped, and waited for).
//
// A run with 'crashReport: false' goes the same way (process.launch carries that option): twelve at once, all Done
// together, and a fifth beside four timeout-stopped ones, in a cancel group main cancels -- Cancelled at once.

mod child;

import testing use *;
import collections use List, String;
import path use Path;
import time use Instant, Duration;
import thread;
import sync use Channel, Sender, Receiver;
import iocore use IoError, CancelGroup;
import ioerror use IoErrorKind;
import process;
import fs;
import actors;
import aio use IoLimits;

fn take(rx: &mut Receiver[u64]) u64 { rx.recv() || 999u64 }

fn b(v: bool) u64 {if v {1u64} else {0u64}}

fn ms(since: Instant) u64 {
  let n = since.elapsed().millis();
  if n < 0i64 {0u64} else {u64.from(n)}
}

// How a run ended: 1 done, 2 cancelled, 3 timed out, 4 a failure of the system
fn endedBy(r: &Result[process.Output, IoError]) u64 {
  match r {
    case let &Err(e) {
      if e.isCancelled() {2u64}
      else if e.isTimedOut() {3u64}
      else {4u64}
    }
    else {1u64}
  }
}

// 1 for a failure of the kind NotFound, else 0
fn notFoundOf(r: &Result[process.Output, IoError]) u64 {
  match r {
    case let &Err(e) {if e.kind() == IoErrorKind.NotFound {1u64} else {0u64}}
    else {0u64}
  }
}

// The Output an answer holds, a blank one for a failure
fn outputOf(r: Result[process.Output, IoError]) process.Output {
  var res = r;
  var o = process.Output(0u32, 0u32, false, String(), String());
  match &mut res {
    case var &mut Ok(ok) {o <-> *ok;}
    else {}
  }
  o
}

// The system's way to say hello, as arguments
fn echoArgs() List[String] {
  var a = List[String]();
  #if #os == .windows {
    a.push(String.from("cmd"));
    a.push(String.from("/c"));
  }
  a.push(String.from("echo"));
  a.push(String.from("hello"));
  a
}

// A command line that takes about 'secs' seconds
fn slowLine(secs: u64) String {
  var s = String();
  #if #os == .windows {
    s.append("cmd /c ping -n ");
    s.appendUInt(secs + 1u64);
    s.append(" 127.0.0.1 >nul");
  } #else {
    s.append("sleep ");
    s.appendUInt(secs);
  }
  s
}

actor Runner {
  out: Sender[u64];

  pub async fn basic(self) {
    {
      let args = echoArgs();
      let r = await aio.run(args.view());
      let how = endedBy(&r);
      let o = outputOf(r);
      out.send(how);
      out.send(u64.from(o.exitCode));
      out.send(b(o.stdout.startsWith("hello") && o.stdout.len() > 5usize));
      out.send(b(o.stderr.isEmpty()));
    }
    {
      let r = await aio.runLine(#if #os == .windows {"cmd /c exit 3"} #else {"exit 3"});
      let how = endedBy(&r);
      let o = outputOf(r);
      out.send(how);
      out.send(u64.from(o.exitCode));
      out.send(b(o.success()));
    }
    {
      let r = await aio.runLine(#if #os == .windows {"cmd /c echo oops>&2"} #else {"echo oops >&2"});
      let how = endedBy(&r);
      let o = outputOf(r);
      out.send(how);
      out.send(b(o.stderr.startsWith("oops")));
      out.send(b(o.stdout.isEmpty()));
    }
    {
      var args = List[String]();
      args.push(String.from("aio-no-such-program"));
      let r = await aio.run(args.view());
      out.send(endedBy(&r));
      out.send(notFoundOf(&r));
    }
    {
      let args = echoArgs();
      let r = await aio.run(args.view(), process.Options(), "aio-no-such-folder");
      out.send(endedBy(&r));
    }
    {
      let t = Instant.now();
      let r = await aio.runLine(slowLine(4u64).view(), process.Options(timeout: Duration.fromMillis(300i64)));
      let how = endedBy(&r);
      let o = outputOf(r);
      out.send(how);
      out.send(b(o.timedOut));
      out.send(b(ms(t) < 2500u64));
    }
  }
}

// A child that says hello
actor Echoer {
  pub async fn go(self, out: Sender[u64]) {
    let args = echoArgs();
    let r = await aio.run(args.view());
    let how = endedBy(&r);
    let o = outputOf(r);
    out.send(b(how == 1u64 && o.exitCode == 0u32 && o.stdout.startsWith("hello")));
  }
}

// A child of about a second
actor Slow {
  pub async fn go(self, out: Sender[u64]) {
    let r = await aio.runLine(slowLine(1u64).view());
    let how = endedBy(&r);
    let o = outputOf(r);
    out.send(if how == 1u64 && o.exitCode == 0u32 {12u64} else {19u64});
  }
}

// Five 100 ms sleeps while the child runs
actor Napper {
  pub async fn go(self, out: Sender[u64]) {
    var k = 0u64;
    while k < 5u64 {
      let nap = await aio.sleep(Duration.fromMillis(100i64));
      k = k + 1u64;
    }
    out.send(11u64);
  }
}

// A child writing 1 MiB to its standard output and 1 MiB to its standard error: both are collected whole (neither
// pipe holds the child up while the other is read)
actor Big {
  pub async fn go(self, out: Sender[u64]) {
    var data = List[u8]();
    var k = 0usize;
    while k < 1048576usize {
      data.push(120u8);
      k = k + 1usize;
    }
    let file = Path.from("aiochild.tmp");
    _ = fs.writeFile(&file, data.view());
    let r = await aio.runLine(#if #os == .windows {"cmd /c \"type aiochild.tmp & type aiochild.tmp 1>&2\""} #else {"cat aiochild.tmp; cat aiochild.tmp >&2"});
    _ = fs.removeFile(&file);
    let how = endedBy(&r);
    let o = outputOf(r);
    out.send(how);
    out.send(u64.from(o.stdout.len()));
    out.send(u64.from(o.stderr.len()));
  }
}

// A child of about a second, one of many at once
actor Crowd {
  pub async fn go(self, out: Sender[u64]) {
    let r = await aio.runLine(slowLine(1u64).view());
    let how = endedBy(&r);
    let o = outputOf(r);
    out.send(b(how == 1u64 && o.exitCode == 0u32));
  }
}

// A 'crashReport: false' child of about a second, one of many at once
actor QuietCrowd {
  pub async fn go(self, out: Sender[u64]) {
    let r = await aio.runLine(slowLine(1u64).view(), process.Options(crashReport: false));
    let how = endedBy(&r);
    let o = outputOf(r);
    out.send(b(how == 1u64 && o.exitCode == 0u32));
  }
}

// A 'crashReport: false' child that runs for a second, then is stopped by its timeout
actor Holder {
  pub async fn go(self, out: Sender[u64]) {
    let r = await aio.runLine(slowLine(5u64).view(), process.Options(timeout: Duration.fromMillis(1000i64), crashReport: false));
    let how = endedBy(&r);
    let o = outputOf(r);
    out.send(b(how == 1u64 && o.timedOut));
  }
}

// A 'crashReport: false' child running beside the four, in a group main cancels
actor Waiter {
  pub async fn go(self, g: CancelGroup, out: Sender[u64]) {
    let t = Instant.now();
    let r = await aio.runLineIn(slowLine(1u64).view(), process.Options(crashReport: false), "", IoLimits.within(g));
    out.send(endedBy(&r));
    out.send(ms(t));
  }
}

// A running child in a group main cancels
actor Cancelee {
  pub async fn go(self, g: CancelGroup, out: Sender[u64]) {
    let t = Instant.now();
    let r = await aio.runLineIn(slowLine(5u64).view(), process.Options(), "", IoLimits.within(g));
    out.send(endedBy(&r));
    out.send(ms(t));
  }
}

// A running child under a deadline
actor Deadliner {
  pub async fn go(self, out: Sender[u64]) {
    let t = Instant.now();
    let r = await aio.runLineIn(slowLine(5u64).view(), process.Options(timeout: Duration.fromMillis(1500i64)), "",
      IoLimits.until(t + Duration.fromMillis(100i64)));
    out.send(endedBy(&r));
    out.send(ms(t));
    // Let the child end by its own timeout
    let rest = await aio.sleep(Duration.fromMillis(1700i64));
    out.send(1u64);
  }
}

fn main() i32 {
  initAll();
  var tx: Sender[u64];
  var rx: Receiver[u64];
  tx, rx = Channel[u64].make();
  let r = Runner(tx.clone());
  r.basic();

  expectUInt(take(&mut rx), 1u64, "echo hello: Done");
  expectUInt(take(&mut rx), 0u64, "...exit code 0");
  expectUInt(take(&mut rx), 1u64, "...standard output holds hello and a line end");
  expectUInt(take(&mut rx), 1u64, "...standard error is empty");

  expectUInt(take(&mut rx), 1u64, "exit 3: Done");
  expectUInt(take(&mut rx), 3u64, "...exit code 3, an answer and no error");
  expectUInt(take(&mut rx), 0u64, "...not a success");

  expectUInt(take(&mut rx), 1u64, "a child writing to standard error: Done");
  expectUInt(take(&mut rx), 1u64, "...standard error holds it");
  expectUInt(take(&mut rx), 1u64, "...standard output is empty");

  expectUInt(take(&mut rx), 4u64, "a program that is not there: a failure of the system");
  expectUInt(take(&mut rx), 1u64, "...NotFound");
  expectUInt(take(&mut rx), 4u64, "a folder that is not there: a failure of the system");

  expectUInt(take(&mut rx), 1u64, "a child slower than its timeout: Done");
  expectUInt(take(&mut rx), 1u64, "...timedOut");
  expectUInt(take(&mut rx), 1u64, "...stopped in time, not after four seconds");

  // Twelve children of a second at once: more than four run together
  {
    let t = Instant.now();
    var k = 0u64;
    while k < 12u64 {
      let c = Crowd();
      c.go(tx.clone());
      k = k + 1u64;
    }
    var all = 0u64;
    k = 0u64;
    while k < 12u64 {
      all = all + take(&mut rx);
      k = k + 1u64;
    }
    expectUInt(all, 12u64, "twelve children at once: each Done");
    expect(ms(t) < 2500u64, "...together, not four at a time");
  }

  // 1 MiB on each stream
  {
    let big = Big();
    big.go(tx.clone());
    expectUInt(take(&mut rx), 1u64, "a child writing 1 MiB to each stream: Done");
    expectUInt(take(&mut rx), 1048576u64, "...standard output whole");
    expectUInt(take(&mut rx), 1048576u64, "...standard error whole");
  }

  // Twenty at once
  {
    var k = 0u64;
    while k < 20u64 {
      let e = Echoer();
      e.go(tx.clone());
      k = k + 1u64;
    }
  }
  var said = 0u64;
  {
    var k = 0u64;
    while k < 20u64 {
      said = said + take(&mut rx);
      k = k + 1u64;
    }
  }
  expectUInt(said, 20u64, "twenty children at once: each Done, saying hello");

  // A child of a second, and a sleeper meanwhile
  let slow = Slow();
  slow.go(tx.clone());
  let nap = Napper();
  nap.go(tx.clone());
  expectUInt(take(&mut rx), 11u64, "a sleeper finishes while the child still runs");
  expectUInt(take(&mut rx), 12u64, "...and the child ends Done, exit code 0");

  // Twelve 'crashReport: false' children of a second at once: no cap of four (they were a pool thread's each)
  {
    let t = Instant.now();
    var k = 0u64;
    while k < 12u64 {
      let c = QuietCrowd();
      c.go(tx.clone());
      k = k + 1u64;
    }
    var all = 0u64;
    k = 0u64;
    while k < 12u64 {
      all = all + take(&mut rx);
      k = k + 1u64;
    }
    expectUInt(all, 12u64, "twelve crashReport:false children at once: each Done");
    expect(ms(t) < 2500u64, "...together, not four at a time");
  }

  // Four 'crashReport: false' children stopped by their timeouts, and a fifth running in a group main cancels
  {
    var k = 0u64;
    while k < 4u64 {
      let h = Holder();
      h.go(tx.clone());
      k = k + 1u64;
    }
  }
  thread.sleep(Duration.fromMillis(300i64));
  let g = CancelGroup.make();
  let w = Waiter();
  w.go(g, tx.clone());
  thread.sleep(Duration.fromMillis(150i64));
  expect(g.cancel(), "the group was live");
  expectUInt(take(&mut rx), 2u64, "a fifth crashReport:false child, running beside four: Cancelled");
  expect(take(&mut rx) < 900u64, "...at once");
  var held = 0u64;
  {
    var k = 0u64;
    while k < 4u64 {
      held = held + take(&mut rx);
      k = k + 1u64;
    }
  }
  expectUInt(held, 4u64, "the four children were stopped by their timeouts, Done");

  // A running child in a group that is cancelled
  {
    let g2 = CancelGroup.make();
    let ce = Cancelee();
    ce.go(g2, tx.clone());
    thread.sleep(Duration.fromMillis(300i64));
    expect(g2.cancel(), "the group was live");
    expectUInt(take(&mut rx), 2u64, "a running child in a cancelled group: Cancelled");
    expect(take(&mut rx) < 1500u64, "...at once, not when the child ended");
  }

  // A running child under a deadline
  let d = Deadliner();
  d.go(tx.clone());
  expectUInt(take(&mut rx), 3u64, "a running child under a deadline: TimedOut");
  expect(take(&mut rx) < 1000u64, "...at the deadline, not when the child ended");
  expectUInt(take(&mut rx), 1u64, "...and the child ended by its own timeout meanwhile");
  finalAll();
  done()
}
