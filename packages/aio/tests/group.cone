// One cancel ends every operation in the group, wherever they are. Four
// Waiters, four actors, each with a connection of its own whose peer says
// nothing, await a read in the same group; main, a plain thread and no actor,
// cancels the group once they are all waiting. Each read ends Cancelled. A
// fifth Waiter that starts its read after the cancel is answered Cancelled
// too, for a group cancelled is a state. A sixth reads under a deadline of its
// own and no group: the cancel does not reach it, and it ends TimedOut.

mod group;

import testing use *;
import thread;
import time use Duration;
import sync use Channel, Sender, Receiver;
import iobuf use IoBuf;
import iocore use SocketAddr, IoError, CancelGroup;
import actors;
import aio use Socket, IoLimits;

const members = 4u64;

fn socketOf(r: Result[Socket, IoError]) Socket {
  var res = r;
  var s = Socket.none();
  match &mut res {
    case var &mut Ok(ok) {s <-> *ok;}
    else {}
  }
  s
}

fn take(rx: &mut Receiver[u64]) u64 { rx.recv() || 999u64 }

// How an answer ended: 1 done, 2 cancelled, 3 timed out, 4 failed
fn ended[T](r: Result[T, IoError]) u64 {
  match r {
    case let Err(e) {
      if aio.isCancelled(e) {2u64}
      else if aio.isTimedOut(e) {3u64}
      else {4u64}
    }
    else {1u64}
  }
}

actor Waiter {

  // A connection whose peer is silent, then a read in g (or under a
  // deadline of 600 ms, if g is not to be used); 'ready' says it is about to
  // read, 'result' how the read ended
  pub async fn hold(self, g: CancelGroup, useGroup: bool, ready: Sender[u64], result: Sender[u64]) {
    let l = await aio.listen(SocketAddr.localhost(0u16));
    let ls = socketOf(l);
    let a = await ls.localAddr();
    var port = 0u16;
    match a {
      case let Ok(addr) {port = addr.port();}
      else {}
    }
    let c = await aio.connect(SocketAddr.localhost(port));
    let cli = socketOf(c);
    let ac = await ls.accept();
    let srv = socketOf(ac);
    ready.send(1u64);
    if useGroup {
      let r = await srv.readIn(IoBuf(4096usize), IoLimits.within(g));
      result.send(ended[iobuf.IoBuf](r));
    } else {
      let r = await srv.readIn(IoBuf(4096usize),
        IoLimits.until(time.Instant.now() + Duration.fromMillis(600i64)));
      result.send(ended[iobuf.IoBuf](r));
    }
  }
}

fn main() i32 {
  initAll();
  var rtx: Sender[u64];
  var rrx: Receiver[u64];
  rtx, rrx = Channel[u64].make();
  var dtx: Sender[u64];
  var drx: Receiver[u64];
  dtx, drx = Channel[u64].make();
  let g = CancelGroup.make();
  {
    var i = 0u64;
    while i < members {
      let w = Waiter();
      w.hold(g, true, rtx.clone(), dtx.clone());
      i = i + 1u64;
    }
    let outsider = Waiter();
    outsider.hold(g, false, rtx.clone(), dtx.clone());
    i = 0u64;
    while i < members + 1u64 {
      take(&mut rrx);
      i = i + 1u64;
    }
    thread.sleep(Duration.fromMillis(50i64));
    expect(g.cancel(), "the first cancel found the group live");
    let late = Waiter();
    late.hold(g, true, rtx.clone(), dtx.clone());
  }
  var cancelled = 0u64;
  var timedOut = 0u64;
  var other = 0u64;
  var i = 0u64;
  while i < members + 2u64 {
    let how = take(&mut drx);
    if how == 2u64 {cancelled = cancelled + 1u64;}
    else if how == 3u64 {timedOut = timedOut + 1u64;}
    else {other = other + 1u64;}
    i = i + 1u64;
  }
  finalAll();
  expectUInt(cancelled, members + 1u64, "the four reads in the group, and one started after, were cancelled");
  expectUInt(timedOut, 1u64, "the read outside the group timed out at its own deadline");
  expectUInt(other, 0u64, "nothing else");
  done()
}
