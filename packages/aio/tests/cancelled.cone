// An operation that did not finish is answered like any other: its 'await'
// gives an Error whose code says it was cancelled. Here the cancel is a
// socket dropped while an operation on it is in flight: Closer makes a read
// of a connection whose peer never sends, sends the socket to itself in a
// message, and awaits the read; the message then runs and drops the socket,
// which closes it, and the read in flight ends Cancelled.

mod cancelled;

import stdio use *;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import iobuf use Pool;
import iocore use SocketAddr, IoError;
import actors;
import aio use Socket;

fn socketOf(r: Result[Socket, IoError]) Socket {
  var res = r;
  var s = Socket.none();
  match &mut res {
    case var ok &mut Ok {s <=> *ok;}
    else {}
  }
  s
}

actor Closer {
  pool: Pool;

  pub async do run(self, done: OneshotSender[u64]) {
    let l = await aio.listen(SocketAddr.localhost(0u16));
    let ls = socketOf(l);
    let a = await ls.localAddr();
    var port = 0u16;
    match a {
      case let addr Ok {port = addr.port();}
      else {}
    }
    let c = await aio.connect(SocketAddr.localhost(port));
    let conn = socketOf(c);
    let reading = conn.read(pool.mustTake(4096usize));
    selfactor.close(conn);
    printStr("reading\n");
    let r = await reading;
    match r {
      case let e Error {
        if aio.isCancelled(e) {printStr("read: cancelled\n");}
        elif aio.isTimedOut(e) {printStr("read: timed out\n");}
        else {printStr("read: failed\n");}
      }
      else {printStr("read: finished\n");}
    }
    var d = done;
    d.send(1u64);
  }

  pub async do close(self, s: Socket) {
    printStr("closing\n");
  }
}

fn main() {
  initAll();
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  {
    let c = new Closer(Pool.make());
    c.run(tx);
  }
  rx.recv();
  finalAll();
  printStr("end\n");
}
