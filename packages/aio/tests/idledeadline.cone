// actors.waitUntilIdleFor: the wait with a deadline. A short timer finishes
// well inside the limit: true, and its second half has run. A server parked on
// accept() with no client never finishes: the 300 ms limit passes, the call
// returns false (after about 300 ms, not at once, not never), the accepting
// behaviour has not run its second half, and finalAll then abandons it
// cleanly: it returns, the Note the behaviour held is dropped, and no
// parked record is left.

mod idledeadline;

import stdio use *;
import time use Duration, Instant;
import iocore use SocketAddr, IoError;
import actors;
import aio use Socket;

let ran: Atomic[u64];       // second halves that ran (bit per actor)
let dropped: Atomic[u64];   // Notes dropped (sum of their n)

fn @initpure init() {
  ran = Atomic[u64].of(0u64);
  dropped = Atomic[u64].of(0u64);
}

struct Note {
  pub n: u64;
  fn final(self: &uni) {dropped.add(n);}
}

fn socketOf(r: Result[Socket, IoError]) Socket { r || Socket.none() }

actor Napper {
  pub async fn nap(self) {
    let x = await aio.sleep(Duration.fromMillis(50i64));
    ran.add(1u64);
  }
}

actor Server {
  pub async fn serve(self) {
    let keep = Note(10u64);
    let ls = socketOf(await aio.listen(SocketAddr.localhost(0u16)));
    let c = socketOf(await ls.accept());
    ran.add(2u64);
  }
}

fn main() {
  initAll();
  let before = aio.opStats();
  let n = Napper();
  n.nap();
  let okFirst = actors.waitUntilIdleFor(Duration.fromSeconds(30i64));
  printStr("timer finished in time: "); printStr(if okFirst {"yes"} else {"no"}); printStr("\n");
  printStr("its second half ran (bits): "); printUInt(ran.load()); printStr("\n");

  let s = Server();
  s.serve();
  let began = Instant.now();
  let okSecond = actors.waitUntilIdleFor(Duration.fromMillis(300i64));
  let ms = began.elapsed().millis();
  printStr("server parked on accept: finished in time: "); printStr(if okSecond {"yes"} else {"no"}); printStr("\n");
  printStr("waited about the limit: "); printStr(if ms >= 250i64 && ms < 5000i64 {"yes"} else {"no"}); printStr("\n");
  printStr("second halves that ran (bits): "); printUInt(ran.load()); printStr("\n");
  printStr("Notes dropped before the end: "); printUInt(dropped.load()); printStr("\n");

  finalAll();
  printStr("Notes dropped after finalAll: "); printUInt(dropped.load()); printStr("\n");
  printStr("second halves that ran (bits): "); printUInt(ran.load()); printStr("\n");
  printStr("records in use: "); printUInt(aio.opStats().inUse - before.inUse); printStr("\n");
  let pb = actors.parkBlocks();
  printStr("park blocks not given back: "); printUInt(pb.taken - pb.given); printStr("\n");
  printStr("end\n");
}
