// An actor reads and writes a real file: 'aio.openFile', 'readAt' and 'writeAt',
// each an 'await' that pauses the behaviour while the I/O thread's Loop does it
// (a pool lane's thread on Linux, the completion port on Windows).
//
// Filer creates a file and writes three blocks of 4,096 bytes into it out of
// order (the blocks at 8,192, 0 and 4,096), each block a pattern of its own;
// reads each back and compares the bytes; reads at the end of the file and past
// it (Done, the buffer as it went), a read that crosses the end (the 2,288
// bytes that are there), and a read with no room (122, as a socket's); patches
// 16 bytes in the middle; then opens the file again three ways: to read (what
// was written is there, and a write to it fails), to update (the bytes are
// kept, and a write changes only those bytes) and to create (it is emptied). A
// file that is not there fails to open with ERROR_FILE_NOT_FOUND (2). At the
// end the file made last is sent in a message to another actor, Peeker, which
// reads it: a File moves, as a Socket does. The test removes its file.

mod files;

import stdio use *;
import fs;
import path use Path;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import iobuf use IoBuf, Pool;
import iocore use IoError, Access;
import actors;
import aio use File;

fn fileOf(r: Result[File, IoError]) File {
  var res = r;
  var f = File.none();
  match &mut res {
    case var ok &mut Ok {f <-> *ok;}
    else {}
  }
  f
}

fn note(what: &str, yes: bool) {
  printStr(what);
  if yes {printStr(": yes\n");} else {printStr(": NO\n");}
}

fn num(what: &str, n: u64) {
  printStr(what);
  printStr(": ");
  printUInt(n);
  printStr("\n");
}

// The error code of a failed answer, 0 for a success
fn codeOf[T](r: Result[T, IoError]) u64 {
  match r {
    case let e Error {u64.from(e.code)}
    else {0u64}
  }
}

// What a write answered: its count, or 1000000 and the error code
fn countOf(r: Result[usize, IoError]) u64 {
  match r {
    case let n Ok {u64.from(n)}
    case let e Error {1000000u64 + u64.from(e.code)}
  }
}

// A block of n bytes, byte i being i mod 251 xor seed
fn block(pool: &Pool, n: usize, seed: u8) IoBuf {
  var b = pool.mustTake(n);
  let room = b.whole();
  var i = 0usize;
  while i < n {
    room[i] = u8.from(i % 251usize) ^ seed;
    i = i + 1usize;
  }
  b.setLen(n);
  b
}

// Whether the n bytes of b from 'from' are those of a block of seed, byte
// 'base' of it on
fn isRun(b: &IoBuf, from: usize, n: usize, base: usize, seed: u8) bool {
  let v = b.view();
  if v.len < from + n {return false;}
  var i = 0usize;
  while i < n {
    if v[from + i] != u8.from((base + i) % 251usize) ^ seed {return false;}
    i = i + 1usize;
  }
  true
}

// Whether the n bytes of b from 'from' are the start of a block of seed
fn isBlock(b: &IoBuf, from: usize, n: usize, seed: u8) bool {
  isRun(b, from, n, 0usize, seed)
}

// The buffer a read's answer holds, or an empty one
fn bufOf(r: Result[IoBuf, IoError]) IoBuf {
  var res = r;
  var b = IoBuf.empty();
  match &mut res {
    case var ok &mut Ok {b <-> *ok;}
    else {}
  }
  b
}

actor Peeker {
  pool: Pool;

  // Reads the first block of a file sent to it
  pub async do peek(self, f: File, done: OneshotSender[u64]) {
    let b = bufOf(await f.readAt(0u64, pool.mustTake(4096usize)));
    note("the sent file reads in the other actor", b.len() == 4096usize && isBlock(&b, 0usize, 4096usize, 11u8));
    var d = done;
    d.send(1u64);
  }
}

actor Filer {
  pool: Pool;
  peeker: Peeker;

  pub async do run(self, done: OneshotSender[u64]) {
    let name = Path.from("aiofiles.tmp");

    let f = fileOf(await aio.openFile(&name, Access.Create));
    note("created", !f.isNone());

    // Three blocks, written out of order
    num("block 2 wrote", countOf(await f.writeAt(8192u64, block(&pool, 4096usize, 33u8))));
    num("block 0 wrote", countOf(await f.writeAt(0u64, block(&pool, 4096usize, 11u8))));
    num("block 1 wrote", countOf(await f.writeAt(4096u64, block(&pool, 4096usize, 22u8))));

    // Each read back
    let r0 = bufOf(await f.readAt(0u64, pool.mustTake(4096usize)));
    note("block 0 read back", r0.len() == 4096usize && isBlock(&r0, 0usize, 4096usize, 11u8));
    let r1 = bufOf(await f.readAt(4096u64, pool.mustTake(4096usize)));
    note("block 1 read back", r1.len() == 4096usize && isBlock(&r1, 0usize, 4096usize, 22u8));
    let r2 = bufOf(await f.readAt(8192u64, pool.mustTake(4096usize)));
    note("block 2 read back", r2.len() == 4096usize && isBlock(&r2, 0usize, 4096usize, 33u8));

    // The end of the file: Done, the buffer as it went
    let cap = pool.mustTake(4096usize).capacity();
    let eb = bufOf(await f.readAt(12288u64, pool.mustTake(4096usize)));
    note("read at the end: done, nothing added", eb.len() == 0usize && eb.capacity() == cap);
    let pb = bufOf(await f.readAt(1000000u64, pool.mustTake(4096usize)));
    note("read past the end: done, nothing added", pb.len() == 0usize && pb.capacity() == cap);

    // A read that crosses the end gets what is there
    let c0 = bufOf(await f.readAt(10000u64, pool.mustTake(4096usize)));
    num("read across the end got", u64.from(c0.len()));
    note("  and they are the bytes", c0.len() == 2288usize && isRun(&c0, 0usize, 2288usize, 1808usize, 33u8));

    // A read with no room
    num("read with no room: error code", codeOf[IoBuf](await f.readAt(0u64, IoBuf.empty())));

    // Sixteen bytes over the middle of block 1 (at 4,096 + 100)
    var patch = pool.mustTake(16usize);
    patch.append("0123456789ABCDEF");
    num("patch wrote", countOf(await f.writeAt(4196u64, patch)));
    let rp = bufOf(await f.readAt(4096u64, pool.mustTake(4096usize)));
    note("the patch reads back", rp.len() == 4096usize && rp.view()[100usize] == '0' && rp.view()[115usize] == 'F');
    note("  and the bytes around it are as they were", isBlock(&rp, 0usize, 100usize, 22u8)
      && rp.view()[116usize] == (u8.from(116usize % 251usize) ^ 22u8));

    // Opened again, to read: what was written is there; a write to it fails
    let again = fileOf(await aio.openFile(&name, Access.Read));
    note("opened again to read", !again.isNone());
    let k0 = bufOf(await again.readAt(0u64, pool.mustTake(4096usize)));
    note("  and what was written is there", k0.len() == 4096usize && isBlock(&k0, 0usize, 4096usize, 11u8));
    note("  a write to it fails", countOf(await again.writeAt(0u64, block(&pool, 16usize, 5u8))) >= 1000000u64);

    // To update: the bytes are kept, a write changes only its own
    let upd = fileOf(await aio.openFile(&name, Access.Update));
    note("opened to update", !upd.isNone());
    let u0 = bufOf(await upd.readAt(8192u64, pool.mustTake(4096usize)));
    note("  its bytes are kept", u0.len() == 4096usize && isBlock(&u0, 0usize, 4096usize, 33u8));
    num("  a write of 16 bytes wrote", countOf(await upd.writeAt(0u64, block(&pool, 16usize, 44u8))));
    let u1 = bufOf(await upd.readAt(0u64, pool.mustTake(4096usize)));
    note("  the 16 bytes are new", isBlock(&u1, 0usize, 16usize, 44u8));
    note("  and the rest is not", u1.view()[16usize] == (u8.from(16usize % 251usize) ^ 11u8));

    // A file that is not there
    let missing = Path.from("aiofiles-missing.tmp");
    num("opening a file that is not there: error code", codeOf[File](await aio.openFile(&missing, Access.Read)));

    // To create: emptied, then block 0 written, and the file sent on
    let made = fileOf(await aio.openFile(&name, Access.Create));
    note("opened to create", !made.isNone());
    let m0 = bufOf(await made.readAt(0u64, pool.mustTake(4096usize)));
    note("  it was emptied", m0.len() == 0usize);
    num("  block 0 wrote", countOf(await made.writeAt(0u64, block(&pool, 4096usize, 11u8))));
    peeker.peek(made, done);
  }
}

fn main() {
  initAll();
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  {
    let f = Filer(Pool.make(), Peeker(Pool.make()));
    f.run(tx);
  }
  rx.recv();
  finalAll();
  fs.removeFile(&Path.from("aiofiles.tmp"));
  printStr("end\n");
}
