// A program that waits (actors.waitUntilIdle) before it ends leaves nothing
// pending: aio's finalizer writes nothing on stderr (the empty .err file).

mod pendingnone;

import stdio use *;
import time use Duration;
import actors;
import aio;

actor Sleeper {

  pub async fn nap(self) {
    let r = await aio.sleep(Duration.fromMillis(50i64));
    printStr("slept\n");
  }
}

fn main() {
  initAll();
  let s = Sleeper();
  s.nap();
  actors.waitUntilIdle();
  finalAll();
  printStr("end\n");
}
