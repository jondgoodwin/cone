// One DatagramBatch reused across many receives: the receiver's batch is moved
// into each recvMany and back, and each filled buffer is swapped for a fresh
// one, so the batch's own memory is never remade. After a warm-up, 10,000
// datagrams are sent and received one at a time through one batch of eight
// slots, and the program's own malloc, calloc and realloc (each passes through a
// counter here to the C library's, as alloc.cone's do), less the actor runtime's
// for messages (actors.messageAllocs), count what is allocated meanwhile. A
// receive that made a list or a record of its own would allocate 10,000 times
// or more; the batch's receive allocates a handful at most (a lane starting, a
// pool growing), which the bound allows, and the buffers lent do not grow at
// all: eight in the batch the whole time, each one sent on and swapped for a
// fresh one.
//
// Then 500 more with a datagram too long for its room (cut), swapped out and
// dropped as netmsg does, and a last check that every buffer is home and every
// record dissolved.

mod recvbatch;

import testing use *;
import stdio use *;
import libc;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import iobuf use IoBuf, stats;
import iocore use SocketAddr, IoError, DatagramBatch;
import actors;
import aio use UdpSocket;

var mallocs: Atomic[u64];

// What the run saw
struct Seen {
  pub lentBefore: Atomic[u64];
  pub lentAfter: Atomic[u64];
  pub allocsUsed: Atomic[u64];
  pub received: Atomic[u64];
  pub wrongCount: Atomic[u64];
  pub cutSeen: Atomic[u64];
  pub batchLost: Atomic[u64];
}

let seen: Seen;

fn @initpure init() {
  mallocs = Atomic[u64].of(0u64);
  seen = Seen(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

#if #os == .windows {
  extern {
    fn @c("_malloc_base") winMalloc(size: usize) *u8;
    fn @c("_calloc_base") winCalloc(n: usize, size: usize) *u8;
    fn @c("_realloc_base") winRealloc(p: *u8, size: usize) *u8;
  }
} #else {
  extern {
    fn @c("__libc_malloc") lxMalloc(size: usize) *u8;
    fn @c("__libc_calloc") lxCalloc(n: usize, size: usize) *u8;
    fn @c("__libc_realloc") lxRealloc(p: *u8, size: usize) *u8;
  }
}

// What the program has allocated, less what the actor runtime has for its messages
fn allocs() u64 {mallocs.load() - actors.messageAllocs()}

pub fn @c("malloc") countMalloc(size: usize) *u8 {
  mallocs.add(1u64);
  #if #os == .windows {winMalloc(size)} #else {lxMalloc(size)}
}

pub fn @c("calloc") countCalloc(n: usize, size: usize) *u8 {
  mallocs.add(1u64);
  #if #os == .windows {winCalloc(n, size)} #else {lxCalloc(n, size)}
}

pub fn @c("realloc") countRealloc(p: *u8, size: usize) *u8 {
  mallocs.add(1u64);
  #if #os == .windows {winRealloc(p, size)} #else {lxRealloc(p, size)}
}

fn udpOf(r: Result[UdpSocket, IoError]) UdpSocket {
  var res = r;
  var s = UdpSocket.none();
  match &mut res {
    case var &mut Ok(ok) {s <-> *ok;}
    case let &mut Err(e) {
      printStr("udpOf failed: code ");
      printUInt(u64.from(e.code));
      printStr("\n");
      panic("udpOf: the operation failed");
    }
  }
  s
}

fn filled(n: usize) IoBuf {
  var b = IoBuf(n);
  b.setLen(n);
  b
}

const rounds = 10000u64;
const room = 2048usize;

actor Looper {
  pub async fn run(self, done: OneshotSender[u64]) {
    let a = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    let b = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    var to = SocketAddr.localhost(0u16);
    match await b.localAddr() {
      case let Ok(x) {to = x;}
      else {}
    }
    var batch = DatagramBatch.make(8u32, room);
    var i = 0u64;
    var base = 0u64;
    var lentStart = 0u64;
    // 200 to warm every cache, then the counted 10,000
    while i < 200u64 + rounds {
      if i == 200u64 {
        lentStart = stats().lent;
        seen.lentBefore.store(lentStart);
        base = allocs();
      }
      let w = await a.sendTo(to, filled(64usize));
      let r = await b.recvMany(batch);
      match r {
        case var Ok(ok) {
          batch = ok;
          var k = 0u32;
          while k < batch.count() {
            let sent = batch.swapOut(k, IoBuf(room));
            if sent.len() != 64usize || batch.wasCut(k) {seen.wrongCount.add(1u64);}
            k = k + 1u32;
          }
          if i >= 200u64 {seen.received.add(u64.from(batch.count()));}
        }
        case var Err(f) {
          seen.wrongCount.add(1u64);
          let e, back = f.(error, batch);
          match back {
            case var Some(x) {batch = x;}
            else {
              seen.batchLost.add(1u64);
              batch = DatagramBatch.make(8u32, room);
            }
          }
        }
      }
      i = i + 1u64;
    }
    seen.allocsUsed.store(allocs() - base);
    seen.lentAfter.store(stats().lent);

    // A datagram too long for the room (the pool's smallest buffer holds 4 KiB, so
    // 5000 bytes): cut, flagged, swapped out and dropped
    var cuts = 0u64;
    i = 0u64;
    while i < 500u64 {
      let w = await a.sendTo(to, filled(5000usize));
      let r = await b.recvMany(batch);
      match r {
        case var Ok(ok) {
          batch = ok;
          var k = 0u32;
          while k < batch.count() {
            if batch.wasCut(k) {cuts = cuts + 1u64;}
            let dropped = batch.swapOut(k, IoBuf(room));
            k = k + 1u32;
          }
        }
        case var Err(f) {
          seen.wrongCount.add(1u64);
          let e, back = f.(error, batch);
          match back {
            case var Some(x) {batch = x;}
            else {batch = DatagramBatch.make(8u32, room);}
          }
        }
      }
      i = i + 1u64;
    }
    seen.cutSeen.store(cuts);
    var dn = done;
    dn.send(1u64);
  }
}

fn main() i32 {
  initAll();
  // One worker, so that each thread's caches are warmed by the warm-up
  actors.configure(actors.Options(workers: 1u32));
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  {
    let l = Looper();
    l.run(tx);
  }
  match rx.recv() {
    case is None[u64] {expect(false, "the looper said it was done");}
    else {}
  }
  finalAll();
  #if #defined("ALLOC_REPORT") {
    printStr("allocations in 10,000 receives: ");
    printUInt(seen.allocsUsed.load());
    printStr("\n");
  }
  expectUInt(seen.received.load(), rounds, "every datagram of the counted rounds received once");
  expectUInt(seen.wrongCount.load(), 0u64, "every answer Ok, each datagram 64 bytes and not cut");
  expectUInt(seen.batchLost.load(), 0u64, "no failed receive lost its batch");
  expectUInt(seen.lentAfter.load(), seen.lentBefore.load(), "the buffers lent did not grow across 10,000 receives");
  expect(seen.allocsUsed.load() < 100u64, "10,000 receives through one batch allocated a handful at most");
  expectUInt(seen.cutSeen.load(), 500u64, "every datagram of the cut rounds came flagged cut");
  expectUInt(stats().lent, 0u64, "every buffer came home");
  expectUInt(aio.opStats().inUse, 0u64, "every record dissolved");
  done()
}
