// UDP sends and receives tried on the awaiting actor's worker (iocore's
// WORKER-SIDE ISSUE, now for recvFrom and sendTo too).
//
// 1. A sends 100 datagrams to B before B receives any; B's 100 recvFrom's find
//    them waiting, each answered whole, in order, with A as the sender. Most are
//    answered on the worker (opStats().answeredHere rises by at least 90 for
//    the receives, and the sends' own count by as much again).
// 2. A receive with nothing waiting is answered when a datagram comes (the
//    pending path: a Later actor sends after a sleep).
// 3. A cut datagram already waiting, received on the worker path, answers
//    Truncated, the buffer home, and the next datagram is whole. On Windows
//    this is the case the spec could not verify: WSAEMSGSIZE returned at the
//    call, and the record must not be answered a second time (inUse == 0).
// 4. A receive with a deadline already past answers TimedOut; a receive whose
//    deadline falls while it waits answers TimedOut.
// 5. A pending receive in a cancel group answers Cancelled when the group is
//    cancelled.
// 6. Closing (dropping) the UdpSocket with a receive pending answers Cancelled.
//
// At the end every buffer is home (lent == 0) and every record dissolved.

mod udpworker;

import testing use *;
import stdio use printStr, printUInt;
import sync use Oneshot, OneshotSender, OneshotReceiver, Channel, Sender, Receiver;
import iobuf use IoBuf, stats;
import iocore use SocketAddr, IoError, CancelGroup;
import time use Instant, Duration;
import thread;
import actors;
import aio use UdpSocket, IoLimits;

const count = 100u64;

struct Got {
  pub bound: Atomic[u64];         // 1 if both sockets bound
  pub sentOk: Atomic[u64];        // sends answered with their count (1 byte... see datagram)
  pub recvOk: Atomic[u64];        // receives answered whole, in order, from A
  pub recvHere: Atomic[u64];      // answeredHere's rise over phase 1's receives
  pub sendHere: Atomic[u64];      // answeredHere's rise over phase 1's sends
  pub late: Atomic[u64];          // the pending receive's answer: its length
  pub cut: Atomic[u64];           // 1 if the waiting cut datagram answered Truncated
  pub whole: Atomic[u64];         // the length of the datagram after it
  pub past: Atomic[u64];          // 1 if a deadline already past answered TimedOut
  pub waited: Atomic[u64];        // 1 if a deadline that fell while waiting answered TimedOut
  pub grouped: Atomic[u64];       // 1 if a pending receive in a cancelled group answered Cancelled
  pub dropped: Atomic[u64];       // 1 if a pending receive of a dropped socket answered Cancelled
  pub badBytes: Atomic[u64];      // datagram bytes received not as sent (position pattern), all phases
}

let got: Got;

fn @initpure init() {
  got = Got(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

fn udpOf(r: Result[UdpSocket, IoError]) UdpSocket {
  var res = r;
  var s = UdpSocket.none();
  match &mut res {
    case var &mut Ok(ok) {s <-> *ok;}
    case let &mut Err(e) {
      printStr("udpOf failed: code ");
      printUInt(u64.from(e.code));
      printStr("\n");
      panic("udpOf: the operation failed");
    }
  }
  s
}

fn portOf(r: Result[SocketAddr, IoError]) u16 {
  match r {
    case let Ok(a) {a.port()}
    else {0u16}
  }
}

// Byte j of datagram number i: a position pattern, so a shifted, swapped or
// stale byte shows
fn patternByte(i: u8, j: usize) u8 {u8.from((usize.from(i) * 7usize + j) % 251usize)}

// Check a received datagram's bytes against patternByte; bad bytes are counted
fn checkDatagram(b: &IoBuf, i: u8) {
  let q = b.view();
  var j = 0usize;
  while j < b.len() {
    if q[j] != patternByte(i, j) {got.badBytes.store(got.badBytes.load() + 1u64);}
    j = j + 1usize;
  }
}

// n bytes, byte j being patternByte(i, j)
fn datagram(n: usize, i: u8) IoBuf {
  var b = IoBuf(64usize);
  let w = b.whole();
  var j = 0usize;
  while j < n {
    w[j] = patternByte(i, j);
    j = j + 1usize;
  }
  b.setLen(n);
  b
}

actor Later {
  // Sends one datagram of 7 bytes to port, after ms
  pub async fn send(self, s: UdpSocket, port: u16, ms: i64) {
    let r = await aio.sleep(Duration.fromMillis(ms));
    let sent = await s.sendTo(SocketAddr.localhost(port), datagram(7usize, 9u8));
  }
}

actor Peer {

  pub async fn run(self, g: CancelGroup, ready: Sender[u64], done: OneshotSender[u64]) {
    let a = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    let b = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    let pa = portOf(await a.localAddr());
    let pb = portOf(await b.localAddr());
    if pa != 0u16 && pb != 0u16 {got.bound.store(1u64);}
    let to = SocketAddr.localhost(pb);

    // 1. A hundred datagrams waiting before the first receive
    let s0 = aio.opStats().answeredHere;
    var i = 0u64;
    while i < count {
      let r = await a.sendTo(to, datagram(10usize + usize.from(i), u8.from(i)));
      match r {
        case let Ok(n) {if n == 10usize + usize.from(i) {got.sentOk.store(got.sentOk.load() + 1u64);}}
        else {}
      }
      i = i + 1u64;
    }
    let s1 = aio.opStats().answeredHere;
    got.sendHere.store(s1 - s0);
    i = 0u64;
    while i < count {
      var r = await b.recvFrom(IoBuf(4096usize));
      match &mut r {
        case var &mut Ok(ok) {
          if ok.buf.len() == 10usize + usize.from(i) && ok.from.port() == pa
              && ok.buf.view()[0usize] == patternByte(u8.from(i), 0usize) {got.recvOk.store(got.recvOk.load() + 1u64);}
          checkDatagram(&ok.buf, u8.from(i));
        }
        else {}
      }
      i = i + 1u64;
    }
    got.recvHere.store(aio.opStats().answeredHere - s1);

    // 2. Nothing waiting: a datagram comes 100 ms later (a sleep, then a send by Later)
    let later = Later();
    later.send(a, pb, 100i64);
    let pend = await b.recvFrom(IoBuf(4096usize));
    var seen = 0u64;
    match pend {
      case let Ok(ok) {seen = u64.from(ok.buf.len()); checkDatagram(&ok.buf, 9u8);}
      else {}
    }
    got.late.store(seen);

    // 3. A cut datagram already waiting, then a whole one
    let c = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    let sentLong = await c.sendTo(to, datagram(40usize, 3u8));
    var small = IoBuf(64usize);
    small.setLen(small.capacity() - 6usize);
    let cut = await b.recvFrom(small);
    match cut {
      case let Err(e) {if aio.isTruncated(e) {got.cut.store(1u64);}}
      else {}
    }
    let sentNext = await c.sendTo(to, datagram(12usize, 4u8));
    var next = await b.recvFrom(IoBuf(4096usize));
    match &mut next {
      case var &mut Ok(ok) {got.whole.store(u64.from(ok.buf.len())); checkDatagram(&ok.buf, 4u8);}
      else {}
    }

    // 4. A deadline already past, and one that falls while waiting
    let timed = await b.recvFromIn(IoBuf(4096usize), IoLimits.until(Instant.fromNanos(1i64)));
    match timed {
      case let Err(e) {if aio.isTimedOut(e) {got.past.store(1u64);}}
      else {}
    }
    let soon = await b.recvFromIn(IoBuf(4096usize),
      IoLimits.until(Instant.now() + Duration.fromMillis(80i64)));
    match soon {
      case let Err(e) {if aio.isTimedOut(e) {got.waited.store(1u64);}}
      else {}
    }

    // 5. A pending receive in a group the main thread cancels
    ready.send(1u64);
    let grp = await b.recvFromIn(IoBuf(4096usize), IoLimits.within(g));
    match grp {
      case let Err(e) {if aio.isCancelled(e) {got.grouped.store(1u64);}}
      else {}
    }

    // 6. Dropping the socket with a receive pending
    let d = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    let reading = d.recvFrom(IoBuf(4096usize));
    selfactor.close(d);
    let dr = await reading;
    match dr {
      case let Err(e) {if aio.isCancelled(e) {got.dropped.store(1u64);}}
      else {}
    }
    var dn = done;
    dn.send(1u64);
  }

  pub async fn close(self, s: UdpSocket) {}
}

fn main() i32 {
  initAll();
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  var rtx: Sender[u64];
  var rrx: Receiver[u64];
  rtx, rrx = Channel[u64].make();
  let g = CancelGroup.make();
  {
    let peer = Peer();
    peer.run(g, rtx, tx);
    rrx.recv();
    thread.sleep(Duration.fromMillis(150i64));
    expect(g.cancel(), "the group was live");
  }
  match rx.recv() {
    case is None[u64] {expect(false, "the peer said it was done");}
    else {}
  }
  finalAll();
  expectUInt(got.bound.load(), 1u64, "two sockets bound");
  expectUInt(got.sentOk.load(), count, "every send answered its count");
  expectUInt(got.recvOk.load(), count, "every receive answered whole, in order, from A");
  expectUInt(got.badBytes.load(), 0u64, "every byte of every datagram received as sent");
  expect(got.recvHere.load() >= 90u64, "at least 90 of the 100 receives were answered on the worker");
  expect(got.sendHere.load() >= 90u64, "at least 90 of the 100 sends were answered on the worker");
  expectUInt(got.late.load(), 7u64, "a receive with nothing waiting was answered when a datagram came");
  expectUInt(got.cut.load(), 1u64, "a cut datagram already waiting answered Truncated");
  expectUInt(got.whole.load(), 12u64, "the next datagram was whole");
  expectUInt(got.past.load(), 1u64, "a deadline already past answered TimedOut");
  expectUInt(got.waited.load(), 1u64, "a deadline that fell while waiting answered TimedOut");
  expectUInt(got.grouped.load(), 1u64, "a pending receive in a cancelled group answered Cancelled");
  expectUInt(got.dropped.load(), 1u64, "a dropped socket's pending receive answered Cancelled");
  expectUInt(stats().lent, 0u64, "every buffer came home");
  expectUInt(aio.opStats().inUse, 0u64, "every record dissolved");
  done()
}
