// The example of the reference manual's section on I/O an actor awaits
// (doc/reference/refconcio.html, "Awaiting I/O"), compiled and run, so the
// page cannot drift from what the package does. The page shows the block
// between the "manual:" lines verbatim; what it leaves out is main, which
// starts the two actors and waits for the server to say it is done before
// finalAll() ends the program. The warning the page shows, an 'await' whose
// result is thrown away, is the suite's concurrency_await_operation_unused.

mod manual;

import stdio use *;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import iobuf use IoBuf, Pool;
import iocore use SocketAddr, IoError;
import actors;
import aio use Socket;

fn say(s &str, n u64) {printStr(s); printStr(" "); printUInt(n); printStr("\n");}

// manual: begin
// The Socket an answer holds, swapped out of it: Socket.none() if it failed
fn socketOf(r Result[Socket, IoError]) Socket {
  mut res = r;
  mut s = Socket.none();
  match &mut res {
    case mut ok &mut Ok {s <=> ok.value;}
    case imm e &mut Error {say("failed", u64.from(e.value.code));}
  }
  s;
}

actor Client {
  pool Pool;

  pub async do send(self, port u16) {
    imm conn = socketOf(await aio.connect(SocketAddr.localhost(port)));
    mut buf = pool.mustTake(64usize);
    buf.append("hello");
    imm sent = await conn.write(buf);          // pauses until all of it is sent
    match sent {
      case imm e Error {say("write failed", u64.from(e.value.code));}
      else {}
    }
  }                                           // conn closes here
}

actor Server {
  pool Pool;
  client Client;

  pub async do serve(self) u64 {
    imm listener = socketOf(await aio.listen(SocketAddr.localhost(0u16)));
    imm addr = await listener.localAddr();     // the port the system chose
    match addr {
      case imm a Ok {client.send(a.value.port());}
      case imm e Error {say("no address", u64.from(e.value.code));}
    }
    imm conn = socketOf(await listener.accept());
    imm none = await conn.read(IoBuf.empty());           // a buffer with no room
    match none {
      case imm e Error {say("no room: error", u64.from(e.value.code));}
      else {}
    }
    mut total = 0u64;
    mut more = true;
    while more {
      imm got = await conn.read(pool.mustTake(4096usize));
      match got {
        case imm b Ok {
          if b.value.len() == 0usize {
            say("end of stream", total);                 // the peer closed
            more = false;
          } else {
            say("received", u64.from(b.value.len()));
            total = total + u64.from(b.value.len());
          }
        }
        case imm e Error {
          say("read failed", u64.from(e.value.code));
          more = false;
        }
      }
    }
    total;
  }
}
// manual: end

actor Starter {
  pub async do start(self, done OneshotSender[u64]) {
    imm server = new Server(Pool.make(), new Client(Pool.make()));
    imm total = await server.serve();
    mut d = done;
    d.send(total);
  }
}

fn main() {
  initAll();
  mut tx OneshotSender[u64];
  mut rx OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  {
    imm s = new Starter();
    s.start(tx);
  }
  rx.recv();
  finalAll();
}
