// The example of the reference manual's section on I/O an actor awaits
// (doc/manual/conc-io.html#await-io, "Awaiting I/O"), compiled and run, so the
// page cannot drift from what the package does. The page shows the block
// between the "manual:" lines verbatim; what it leaves out is main, which
// starts the two actors and waits for the server to say it is done before
// finalAll() ends the program. The warning the page shows, an 'await' whose
// result is thrown away, is the suite's concurrency_await_operation_unused.

mod manual;

import stdio use *;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import iobuf use IoBuf;
import iocore use SocketAddr, IoError;
import actors;
import aio use Socket;

fn say(s: &str, n: u64) {printStr(s); printStr(" "); printUInt(n); printStr("\n");}

// manual: begin
// The Socket an answer holds, swapped out of it: Socket.none() if it failed
fn socketOf(r: Result[Socket, IoError]) Socket {
  var res = r;
  var s = Socket.none();
  match &mut res {
    case var &mut Ok(ok) {s <-> *ok;}
    case let &mut Error(e) {say("failed", u64.from((*e).code));}
  }
  s
}

actor Client {

  pub async fn send(self, port: u16) {
    let conn = socketOf(await aio.connect(SocketAddr.localhost(port)));
    var buf = IoBuf(64usize);
    buf.append("hello");
    let sent = await conn.write(buf);          // pauses until all of it is sent
    match sent {
      case let Error(e) {say("write failed", u64.from(e.code));}
      else {}
    }
  }                                           // conn closes here
}

actor Server {
  client: Client;

  pub async fn serve(self) u64 {
    let listener = socketOf(await aio.listen(SocketAddr.localhost(0u16)));
    let addr = await listener.localAddr();     // the port the system chose
    match addr {
      case let Ok(a) {client.send(a.port());}
      case let Error(e) {say("no address", u64.from(e.code));}
    }
    let conn = socketOf(await listener.accept());
    let none = await conn.read(IoBuf.empty());           // a buffer with no room
    match none {
      case let Error(e) {say("no room: error", u64.from(e.code));}
      else {}
    }
    var total = 0u64;
    var more = true;
    while more {
      let got = await conn.read(IoBuf(4096usize));
      match got {
        case let Ok(b) {
          if b.len() == 0usize {
            say("end of stream", total);                 // the peer closed
            more = false;
          } else {
            say("received", u64.from(b.len()));
            total = total + u64.from(b.len());
          }
        }
        case let Error(e) {
          say("read failed", u64.from(e.code));
          more = false;
        }
      }
    }
    total
  }
}
// manual: end

actor Starter {
  pub async fn start(self, done: OneshotSender[u64]) {
    let server = Server(Client());
    let total = await server.serve();
    var d = done;
    d.send(total);
  }
}

fn main() {
  initAll();
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  {
    let s = Starter();
    s.start(tx);
  }
  rx.recv();
  finalAll();
}
