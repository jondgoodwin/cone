// A job queued for a hosted service with the wrong service type: a Host is
// plain data (not Host[S], the package's header, HOSTED SERVICES), so the S
// of 'hostPost' is checked against the type the host was made for, at run
// time, and a mismatch is a panic at the caller's line, before anything is
// queued

mod hostwrongtype;

import stdio use *;
import time use Instant;
import iocore use Loop, Completion, forever;
import aio use Host;

let h: Host;

fn @initpure init() {
  h = aio.host[Right](&makeRight);
}

fn makeRight() Right {Right(0u64)}

struct Right {
  n: u64;
  pub fn turn(self: &mut, lp: &mut Loop) {}
  pub fn complete(self: &mut, lp: &mut Loop, c: &mut Completion) bool {false}
  pub fn wakeAt(self: &) Instant {forever()}
  pub fn end(self: &mut, lp: &mut Loop) {}
}

struct Wrong {
  m: u64;
  pub fn turn(self: &mut, lp: &mut Loop) {}
  pub fn complete(self: &mut, lp: &mut Loop, c: &mut Completion) bool {false}
  pub fn wakeAt(self: &) Instant {forever()}
  pub fn end(self: &mut, lp: &mut Loop) {}
}

struct BumpJob {
  pub fn run(self, lp: &mut Loop, s: &mut Wrong) {s.m = s.m + 1u64;}
}

fn main() {
  initAll();
  printStr("queueing\n");
  aio.hostPost[Wrong, BumpJob](h, BumpJob());
  printStr("queued\n");
  finalAll();
}
