// Several datagrams in one receive: UdpSocket.recvMany, into a DatagramBatch the
// receiver keeps for life and lends to each receive. Linux takes every
// datagram waiting, up to the batch's slots, in one call (recvmmsg); Windows
// one a call, behind the same answer, so each phase loops until every
// datagram is in, and the first call's count is expected by system. The one
// batch of a phase serves every call of it: each filled buffer is swapped out
// for a fresh one, and nothing else moves.
//
// 1. A sends ten datagrams of different lengths before B receives; B's
//    recvMany of a sixteen-slot batch: Linux answers all ten at once with six
//    slots untouched, Windows one (fifteen untouched), then the rest one by one.
//    In arrival order, each with A as its sender, and every byte of every
//    datagram as sent (a position pattern).
// 2. A datagram longer than its slot's room is in the answer cut to the room
//    with its bit set (wasCut); the datagrams around it are whole.
// 3. Two senders, three datagrams each, told apart by each datagram's sender.
// 4. A batch of no slots, and a batch whose middle slot has no room: InvalidInput,
//    the second naming slot 1, and each batch back in the answer, intact. The
//    refused batch, its slot refilled, then takes two waiting datagrams.
// 5. A receive with nothing waiting and a deadline that falls: TimedOut, the
//    batch back with every slot as it was.
// 6. The same batch, in a pending receive in a cancel group the main thread
//    cancels: Cancelled, the batch back with every slot as it was.
//
// At the end every buffer is home (lent == 0) and every record dissolved.

mod recvmany;

import testing use *;
import sync use Oneshot, OneshotSender, OneshotReceiver, Channel, Sender, Receiver;
import collections use List;
import iobuf use IoBuf, stats;
import iocore use SocketAddr, IoError, CancelGroup, DatagramBatch;
import ioerror use IoErrorKind;
import time use Instant, Duration;
import thread;
import actors;
import aio use UdpSocket, IoLimits, RecvFailed;

struct Got {
  pub bound: Atomic[u64];         // 1 if the sockets bound
  pub first: Atomic[u64];         // phase 1: the first call's datagram count
  pub firstSpare: Atomic[u64];    // phase 1: the first call's slots untouched
  pub inOrder: Atomic[u64];       // phase 1: datagrams received in order, whole, from A
  pub cutOk: Atomic[u64];         // phase 2: datagrams as expected, the long one cut and flagged
  pub twoOk: Atomic[u64];         // phase 3: datagrams from the sender expected
  pub badBytes: Atomic[u64];      // bytes not as sent, all phases
  pub empty: Atomic[u64];         // phase 4: 1 if a batch of no slots answered InvalidInput
  pub emptyBack: Atomic[u64];     // phase 4: 1 if that answer carried the batch back
  pub noRoom: Atomic[u64];        // phase 4: 1 if a slot with no room answered InvalidInput
  pub noRoomSlot: Atomic[u64];    // phase 4: the slot that answer named
  pub noRoomBack: Atomic[u64];    // phase 4: 1 if that answer carried the batch back, its other slots as they were
  pub laterFirst: Atomic[u64];    // phase 4: the refused batch's first call's datagram count
  pub laterOk: Atomic[u64];       // phase 4: datagrams in order and whole across its calls
  pub timed: Atomic[u64];         // phase 5: 1 if TimedOut
  pub timedBack: Atomic[u64];     // phase 5: 1 if the batch came back, every slot as it was
  pub grouped: Atomic[u64];       // phase 6: 1 if Cancelled
  pub groupedBack: Atomic[u64];   // phase 6: 1 if the batch came back, every slot as it was
}

let got: Got;

fn @initpure init() {
  got = Got(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64));
}

fn udpOf(r: Result[UdpSocket, IoError]) UdpSocket {
  var res = r;
  var s = UdpSocket.none();
  match &mut res {
    case var &mut Ok(ok) {s <-> *ok;}
    else {}
  }
  s
}

fn portOf(r: Result[SocketAddr, IoError]) u16 {
  match r {
    case let Ok(a) {a.port()}
    else {0u16}
  }
}

// Byte j of datagram number i: a position pattern, so a shifted, swapped or
// stale byte shows
fn patternByte(i: u8, j: usize) u8 {u8.from((usize.from(i) * 7usize + j) % 251usize)}

// n bytes, byte j being patternByte(i, j)
fn datagram(n: usize, i: u8) IoBuf {
  var b = IoBuf(256usize);
  let w = b.whole();
  var j = 0usize;
  while j < n {
    w[j] = patternByte(i, j);
    j = j + 1usize;
  }
  b.setLen(n);
  b
}

// A buffer with exactly 'room' bytes of room: the datagram goes after what is in it
fn roomBuf(room: usize) IoBuf {
  var b = IoBuf(room);
  b.setLen(b.capacity() - room);
  b
}

// A batch of n slots, each with exactly 'room' bytes of room
fn batchOf(n: u32, room: usize) Uni[DatagramBatch] {
  var b = DatagramBatch.make(n, 64usize);
  var k = 0u32;
  while k < n {
    let old = b.swapOut(k, roomBuf(room));
    k = k + 1u32;
  }
  b
}

// The batch with each slot the last receive filled swapped for a fresh one of
// 'room' (the filled buffers go home)
fn renewed(batch: Uni[DatagramBatch], room: usize) Uni[DatagramBatch] {
  var b = batch;
  let cnt = b.count();
  var k = 0u32;
  while k < cnt {
    let old = b.swapOut(k, roomBuf(room));
    k = k + 1u32;
  }
  b
}

// The batch a failed receive handed back (a new one where none came)
fn kept(f: RecvFailed, n: u32, room: usize) Uni[DatagramBatch] {
  let e, back = f.(error, batch);
  match back {
    case var Some(b) {b}
    else {batchOf(n, room)}
  }
}

// Whether every one of the batch's n slots still has exactly 'room' of room
fn intact(b: &DatagramBatch, n: u32, room: usize) bool {
  if b.size() != n {return false;}
  var k = 0u32;
  while k < n {
    if b.bufAt(k).room() != room {return false;}
    k = k + 1u32;
  }
  true
}

// Whether the buffer holds its last 'have' bytes as datagram number i sent
// them (a datagram cut to its room holds the first 'have' of them); bad bytes
// are counted
fn holds(d: &IoBuf, have: usize, i: u8) bool {
  let v = d.view();
  if v.len < have {return false;}
  let from = v.len - have;
  var j = 0usize;
  var good = true;
  while j < have {
    if v[from + j] != patternByte(i, j) {
      good = false;
      got.badBytes.store(got.badBytes.load() + 1u64);
    }
    j = j + 1usize;
  }
  good
}

fn isInvalid(f: &RecvFailed) bool {f.error.kind() == IoErrorKind.InvalidInput}

actor Peer {

  pub async fn run(self, g: CancelGroup, ready: Sender[u64], done: OneshotSender[u64]) {
    let a = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    let b = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    let c = udpOf(await aio.bindUdp(SocketAddr.localhost(0u16)));
    let pa = portOf(await a.localAddr());
    let pb = portOf(await b.localAddr());
    let pc = portOf(await c.localAddr());
    if pa != 0u16 && pb != 0u16 && pc != 0u16 {got.bound.store(1u64);}
    let to = SocketAddr.localhost(pb);

    // 1. Ten waiting, sixteen slots
    var i = 0u64;
    while i < 10u64 {
      let r = await a.sendTo(to, datagram(10usize + usize.from(i), u8.from(i)));
      i = i + 1u64;
    }
    let settle = await aio.sleep(Duration.fromMillis(30i64));
    var seen = 0u64;
    var calls = 0u64;
    var batch = batchOf(16u32, 4096usize);
    while seen < 10u64 && calls < 20u64 {
      let r = await b.recvMany(batch);
      match r {
        case var Ok(ok) {
          batch = ok;
          let cnt = batch.count();
          if calls == 0u64 {
            got.first.store(u64.from(cnt));
            got.firstSpare.store(u64.from(batch.size() - cnt));
          }
          var k = 0u32;
          while k < cnt {
            let d = batch.bufAt(k);
            let n = 10usize + usize.from(seen);
            if d.len() == n && batch.from(k).port() == pa && holds(d, n, u8.from(seen)) && !batch.wasCut(k) {
              got.inOrder.store(got.inOrder.load() + 1u64);
            }
            seen = seen + 1u64;
            k = k + 1u32;
          }
          batch = renewed(batch, 4096usize);
        }
        case var Err(f) {batch = kept(f, 16u32, 4096usize);}
      }
      calls = calls + 1u64;
    }

    // 2. A cut datagram: 40 bytes (number 3) into rooms of 24, between 12 and 5
    let s1 = await a.sendTo(to, datagram(12usize, 2u8));
    let s2 = await a.sendTo(to, datagram(40usize, 3u8));
    let s3 = await a.sendTo(to, datagram(5usize, 4u8));
    let settle2 = await aio.sleep(Duration.fromMillis(30i64));
    seen = 0u64;
    calls = 0u64;
    batch = batchOf(8u32, 24usize);
    while seen < 3u64 && calls < 10u64 {
      let r = await b.recvMany(batch);
      match r {
        case var Ok(ok) {
          batch = ok;
          let cnt = batch.count();
          var k = 0u32;
          while k < cnt {
            let d = batch.bufAt(k);
            let wantLen = if seen == 0u64 {12usize} else if seen == 1u64 {40usize} else {5usize};
            let cut = wantLen > 24usize;
            let have = if cut {24usize} else {wantLen};
            if holds(d, have, u8.from(2u64 + seen)) && batch.wasCut(k) == cut && d.room() == (if cut {0usize} else {24usize - wantLen})
                && batch.from(k).port() == pa {
              got.cutOk.store(got.cutOk.load() + 1u64);
            }
            seen = seen + 1u64;
            k = k + 1u32;
          }
          batch = renewed(batch, 24usize);
        }
        case var Err(f) {batch = kept(f, 8u32, 24usize);}
      }
      calls = calls + 1u64;
    }

    // 3. Two senders, A and C alternating, three each
    i = 0u64;
    while i < 6u64 {
      if i % 2u64 == 0u64 {
        let r = await a.sendTo(to, datagram(8usize + usize.from(i), u8.from(10u64 + i)));
      } else {
        let r = await c.sendTo(to, datagram(8usize + usize.from(i), u8.from(10u64 + i)));
      }
      let pause = await aio.sleep(Duration.fromMillis(3i64));
      i = i + 1u64;
    }
    let settle3 = await aio.sleep(Duration.fromMillis(30i64));
    seen = 0u64;
    calls = 0u64;
    batch = batchOf(8u32, 4096usize);
    while seen < 6u64 && calls < 20u64 {
      let r = await b.recvMany(batch);
      match r {
        case var Ok(ok) {
          batch = ok;
          let cnt = batch.count();
          var k = 0u32;
          while k < cnt {
            let d = batch.bufAt(k);
            let want = if seen % 2u64 == 0u64 {pa} else {pc};
            if batch.from(k).port() == want && holds(d, 8usize + usize.from(seen), u8.from(10u64 + seen)) {
              got.twoOk.store(got.twoOk.load() + 1u64);
            }
            seen = seen + 1u64;
            k = k + 1u32;
          }
          batch = renewed(batch, 4096usize);
        }
        case var Err(f) {batch = kept(f, 8u32, 4096usize);}
      }
      calls = calls + 1u64;
    }

    // 4. A batch of no slots; a middle slot with no room (the batch back, the
    // slot named); the refused batch, its slot refilled, taking two datagrams
    let er = await b.recvMany(batchOf(0u32, 64usize));
    match er {
      case var Err(f) {
        if isInvalid(&f) {got.empty.store(1u64);}
        let eb, back = f.(error, batch);
        match back {
          case let Some(x) {if x.size() == 0u32 {got.emptyBack.store(1u64);}}
          else {}
        }
      }
      else {}
    }
    var three = batchOf(3u32, 64usize);
    let nothing = three.swapOut(1u32, IoBuf());
    let nr = await b.recvMany(three);
    match nr {
      case var Err(f) {
        if isInvalid(&f) {got.noRoom.store(1u64);}
        got.noRoomSlot.store(u64.from(f.slot));
        let eb, back = f.(error, batch);
        match back {
          case var Some(x) {
            if x.size() == 3u32 && x.bufAt(0u32).room() == 64usize && x.bufAt(1u32).room() == 0usize && x.bufAt(2u32).room() == 64usize {
              got.noRoomBack.store(1u64);
            }
            let old = x.swapOut(1u32, roomBuf(64usize));
            batch = x;
          }
          else {batch = batchOf(3u32, 64usize);}
        }
      }
      case var Ok(ok) {batch = ok;}
    }
    let t1 = await a.sendTo(to, datagram(30usize, 20u8));
    let t2 = await a.sendTo(to, datagram(31usize, 21u8));
    let settle4 = await aio.sleep(Duration.fromMillis(30i64));
    seen = 0u64;
    calls = 0u64;
    while seen < 2u64 && calls < 10u64 {
      let mr = await b.recvMany(batch);
      match mr {
        case var Ok(ok) {
          batch = ok;
          let cnt = batch.count();
          if calls == 0u64 {got.laterFirst.store(u64.from(cnt));}
          var k = 0u32;
          while k < cnt {
            let n = 30usize + usize.from(seen);
            if holds(batch.bufAt(k), n, u8.from(20u64 + seen)) {
              got.laterOk.store(got.laterOk.load() + 1u64);
            }
            seen = seen + 1u64;
            k = k + 1u32;
          }
          batch = renewed(batch, 64usize);
        }
        case var Err(f) {batch = kept(f, 3u32, 64usize);}
      }
      calls = calls + 1u64;
    }

    // 5. A deadline that falls while waiting: the batch comes back as it went
    batch = batchOf(4u32, 64usize);
    let timed = await b.recvManyIn(batch, IoLimits.until(Instant.now() + Duration.fromMillis(80i64)));
    match timed {
      case var Err(f) {
        if aio.isTimedOut(f.error) {got.timed.store(1u64);}
        let eb, back = f.(error, batch);
        match back {
          case var Some(x) {
            if intact(&*x, 4u32, 64usize) {got.timedBack.store(1u64);}
            batch = x;
          }
          else {batch = batchOf(4u32, 64usize);}
        }
      }
      case var Ok(ok) {batch = ok;}
    }

    // 6. A pending receive in a group the main thread cancels, on the same batch
    ready.send(1u64);
    let grp = await b.recvManyIn(batch, IoLimits.within(g));
    match grp {
      case var Err(f) {
        if aio.isCancelled(f.error) {got.grouped.store(1u64);}
        let eb, back = f.(error, batch);
        match back {
          case let Some(x) {if intact(&*x, 4u32, 64usize) {got.groupedBack.store(1u64);}}
          else {}
        }
      }
      case var Ok(ok) {batch = ok;}
    }
    var dn = done;
    dn.send(1u64);
  }
}

fn main() i32 {
  initAll();
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  var rtx: Sender[u64];
  var rrx: Receiver[u64];
  rtx, rrx = Channel[u64].make();
  let g = CancelGroup.make();
  {
    let peer = Peer();
    peer.run(g, rtx, tx);
    rrx.recv();
    thread.sleep(Duration.fromMillis(150i64));
    expect(g.cancel(), "the group was live");
  }
  match rx.recv() {
    case is None[u64] {expect(false, "the peer said it was done");}
    else {}
  }
  finalAll();
  expectUInt(got.bound.load(), 1u64, "three sockets bound");
  #if #os == .windows {
    expectUInt(got.first.load(), 1u64, "1: Windows answers one datagram a call");
    expectUInt(got.firstSpare.load(), 15u64, "1: fifteen slots untouched");
    expectUInt(got.laterFirst.load(), 1u64, "4: Windows answers one datagram a call");
  } #else {
    expectUInt(got.first.load(), 10u64, "1: Linux answers all ten in one call");
    expectUInt(got.firstSpare.load(), 6u64, "1: six slots untouched");
    expectUInt(got.laterFirst.load(), 2u64, "4: Linux answers both waiting datagrams in one call");
  }
  expectUInt(got.inOrder.load(), 10u64, "1: ten datagrams in order, whole, from A, no cut bit");
  expectUInt(got.cutOk.load(), 3u64, "2: three datagrams as expected, the long one cut to its room and flagged");
  expectUInt(got.twoOk.load(), 6u64, "3: six datagrams from the right sender, whole");
  expectUInt(got.badBytes.load(), 0u64, "every byte of every datagram as sent");
  expectUInt(got.empty.load(), 1u64, "4: a batch of no slots is InvalidInput");
  expectUInt(got.emptyBack.load(), 1u64, "4: and comes back in the answer");
  expectUInt(got.noRoom.load(), 1u64, "4: a slot with no room is InvalidInput");
  expectUInt(got.noRoomSlot.load(), 1u64, "4: and the answer names slot 1");
  expectUInt(got.noRoomBack.load(), 1u64, "4: and the batch comes back, its other slots as they were");
  expectUInt(got.laterOk.load(), 2u64, "4: the refused batch, refilled, takes both datagrams in order");
  expectUInt(got.timed.load(), 1u64, "5: a deadline that fell answered TimedOut");
  expectUInt(got.timedBack.load(), 1u64, "5: and the batch came back, every slot as it was");
  expectUInt(got.grouped.load(), 1u64, "6: a pending receive in a cancelled group answered Cancelled");
  expectUInt(got.groupedBack.load(), 1u64, "6: and the batch came back, every slot as it was");
  expectUInt(stats().lent, 0u64, "every buffer came home");
  expectUInt(aio.opStats().inUse, 0u64, "every record dissolved");
  done()
}
