// The twin of lentcancel.cone for the other branch of an answer
// (actors.answerLentIn): the reply FITS a slot of the awaiting actor's mailbox, so
// it is not lent; 'take' runs at once, on the thread that springs the answer
// (the Loop's, or the starter's or canceller's where the operation ends there),
// and the record is dissolved then, not later on Holder's worker. Holder is
// lentcancel's with one more behaviour whose argument makes every slot of its
// mailbox big enough for the read's reply (the PIN below checks that). The same
// scenario: two reads in flight on one handle, the first takes the 100 bytes the
// peer sent while Holder is busy, Holder asks cancelRead; then two reads at once
// and one cancelRead ends both. What is checked:
//
// - the cancel asked one operation to end: the second read, in flight (the
//   first's record is already gone);
// - while Holder was busy NO record was in use: both reads were answered (the
//   second Cancelled) and each record dissolved when its answer was sprung,
//   where lentcancel.cone's two are still lent, waiting to be taken;
// - the first read's answer is whole (100 bytes), the second's Cancelled;
//   afterwards no record is in use;
// - the second cancel asked both reads in flight to end, and both ended
//   Cancelled; every buffer is home.

mod lentcancelinline;

import testing use *;
import thread;
import sync use Oneshot, OneshotSender, OneshotReceiver;
import time use Duration;
import iobuf use IoBuf;
import iocore use SocketAddr, IoError;
import actors;
import aio use Socket;

struct Got {
  pub asked: Atomic[u64];       // operations the cancel asked to end
  pub inUseBusy: Atomic[u64];   // records in use while Holder was busy, over the start
  pub first: Atomic[u64];       // the first read's bytes, or 999999
  pub second: Atomic[u64];      // 1 if the second read ended Cancelled
  pub taken: Atomic[u64];       // answers taken off the I/O thread, over the start
  pub inUseEnd: Atomic[u64];    // records in use at the end, over the start
  pub askedBoth: Atomic[u64];   // operations the second cancel asked to end
  pub bothCancelled: Atomic[u64];   // the two reads it ended, Cancelled
  pub bothEnded: Atomic[u64];       // ...ended at all
}

let got: Got;

fn @initpure init() {
  got = Got(Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(999999u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64), Atomic[u64].of(0u64),
    Atomic[u64].of(0u64));
}

fn socketOf(r: Result[Socket, IoError]) Socket { r || Socket.none() }

fn filled(n: usize) IoBuf {
  var b = IoBuf(n);
  b.setLen(n);
  b
}

actor Holder {
  a: Socket;
  b: Socket;
  base: aio.OpStats;

  pub async fn start(self, done: OneshotSender[u64]) {
    let ls = socketOf(await aio.listen(SocketAddr.localhost(0u16)));
    var port = 0u16;
    match await ls.localAddr() {
      case let Ok(x) {port = x.port();}
      else {}
    }
    a = socketOf(await aio.connect(SocketAddr.localhost(port)));
    b = socketOf(await ls.accept());
    base = aio.opStats();
    // The peer's 100 bytes, sent before the reads begin: they wait in the
    // socket for the first read
    let w = await a.write(filled(100usize));
    selfactor.first();
    selfactor.second();
    selfactor.busy(done);
  }

  pub async fn first(self) {
    let r = await b.read(IoBuf(4096usize));
    match r {
      case let Ok(buf) {got.first.store(u64.from(buf.len()));}
      else {}
    }
  }

  pub async fn second(self) {
    let r = await b.read(IoBuf(4096usize));
    match r {
      case let Err(e) {if aio.isCancelled(e) {got.second.store(1u64);}}
      else {}
    }
  }

  // Busy, with no await: the two reads have begun, the first has taken the
  // bytes, and its answer waits, lent, in this mailbox; then the cancel. The
  // finish is sent last, behind the two answers
  pub async fn busy(self, done: OneshotSender[u64]) {
    thread.sleep(Duration.fromMillis(300i64));
    let c0 = aio.opStats().cancelsAsked;
    b.cancelRead();
    thread.sleep(Duration.fromMillis(200i64));
    got.asked.store(aio.opStats().cancelsAsked - c0);
    got.inUseBusy.store(aio.opStats().inUse - base.inUse);
    selfactor.finish(done);
  }

  pub async fn finish(self, done: OneshotSender[u64]) {
    let now = aio.opStats();
    got.taken.store(now.takenAway - base.takenAway);
    got.inUseEnd.store(now.inUse - base.inUse);
    // Two reads at once, then one cancel for both
    selfactor.another();
    selfactor.another();
    selfactor.cancelBoth();
    var d = done;
    d.send(1u64);
  }

  pub async fn another(self) {
    let r = await b.read(IoBuf(4096usize));
    match r {
      case let Err(e) {if aio.isCancelled(e) {got.bothCancelled.add(1u64);}}
      else {}
    }
    got.bothEnded.add(1u64);
  }

  // Never called: its argument is what gives every slot of Holder's mailbox room
  // for a read's reply
  pub async fn pad(self, x: Array[u8, 96]) {
  }

  pub async fn cancelBoth(self) {
    let c0 = aio.opStats().cancelsAsked;
    b.cancelRead();
    thread.sleep(Duration.fromMillis(200i64));
    got.askedBoth.store(aio.opStats().cancelsAsked - c0);
  }
}

// PIN. A slot's payload is its largest message rounded to 16 bytes; Holder's
// largest message holds 'pad's 96 bytes, so the payload is at least 96, and a
// reply's value follows 16 bytes of resume record. The read's reply must fit what
// is left; if the reply type grows, or a slot shrinks, this fails here, not as a
// count that is off. lentcancel.cone is the other branch.
fn pinInline() {
  expect(mem.sizeof[Result[IoBuf, IoError]]() <= 96usize - 16usize,
    "PIN: the read's reply fits a slot's value room, so it is answered at once");
}

fn main() i32 {
  initAll();
  pinInline();
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  {
    let h = Holder(Socket.none(), Socket.none(), aio.opStats());
    h.start(tx);
  }
  match rx.recv() {
    case is None[u64] {expect(false, "Holder said it was done");}
    else {}
  }
  var waited = 0u32;
  while got.bothEnded.load() < 2u64 && waited < 500u32 {
    thread.sleep(Duration.fromMillis(10i64));
    waited = waited + 1u32;
  }
  finalAll();
  expectUInt(got.asked.load(), 1u64, "the cancel asked one read to end: the one in flight, not the answered one");
  expectUInt(got.inUseBusy.load(), 0u64, "no record was in use while Holder was busy: each was dissolved when its answer was sprung, none lent");
  expectUInt(got.first.load(), 100u64, "the answered read's answer is whole");
  expectUInt(got.second.load(), 1u64, "the read in flight was Cancelled");
  expectUInt(got.inUseEnd.load(), 0u64, "and afterwards none is");
  expectUInt(got.askedBoth.load(), 2u64, "one cancelRead asked both reads in flight to end");
  expectUInt(got.bothCancelled.load(), 2u64, "and both ended Cancelled");
  let st = iobuf.stats();
  expectUInt(st.lent, 0u64, "every buffer is home");
  done()
}
