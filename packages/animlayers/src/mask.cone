// BoneMask: a weight, 0 to 1, for every bone of a skeleton.

pub struct BoneMask {
  pub w List[f32];

  // Every bone at 'v'
  pub fn all(count usize, v f32) BoneMask {
    var l = List[f32].empty();
    l.resize(count, v);
    new BoneMask(l);
  }

  pub fn none(count usize) BoneMask { BoneMask.all(count, 0.); }

  pub fn copy(self &) BoneMask { self.scaled(1.); }

  pub fn count(self &) usize { w.len(); }

  pub fn weight(self &, b usize) f32 { *w[b]; }

  pub fn set(self &mut, b usize, v f32) { w.set(b, v); }

  // Bone 'root' and every bone below it set to 'v'
  pub fn setSubtree(self &mut, skel &Skeleton, root usize, v f32) {
    var inside = List[bool].empty();
    var i = 0usize;
    while i < skel.boneCount() {
      let p = skel.parentOf(i);
      let member = i == root or (p >= 0i32 and *inside[usize.from(p)]);
      inside.push(member);
      if member { w.set(i, v); }
      i = i + 1usize;
    }
  }

  // The listed bones set to 'v'
  pub fn setBones(self &mut, bones &List[usize], v f32) {
    var i = 0usize;
    while i < bones.len() { w.set(*bones[i], v); i = i + 1usize; }
  }

  // A subtree: 'root' and what hangs from it at 1, the rest at 0
  pub fn subtree(skel &Skeleton, root usize) BoneMask {
    var m = BoneMask.none(skel.boneCount());
    m.setSubtree(skel, root, 1.);
    m;
  }

  // Every weight multiplied by 'k'
  pub fn scaled(self &, k f32) BoneMask {
    var out = List[f32].empty();
    var i = 0usize;
    while i < w.len() { out.push(*w[i] * k); i = i + 1usize; }
    new BoneMask(out);
  }

  // The bone-by-bone product with another mask
  pub fn times(self &, o &BoneMask) BoneMask {
    var out = List[f32].empty();
    var i = 0usize;
    while i < w.len() { out.push(*w[i] * *o.w[i]); i = i + 1usize; }
    new BoneMask(out);
  }

  // One minus every weight
  pub fn inverted(self &) BoneMask {
    var out = List[f32].empty();
    var i = 0usize;
    while i < w.len() { out.push(1. - *w[i]); i = i + 1usize; }
    new BoneMask(out);
  }

  // The larger of two masks, bone by bone
  pub fn union(self &, o &BoneMask) BoneMask {
    var out = List[f32].empty();
    var i = 0usize;
    while i < w.len() {
      let a = *w[i];
      let b = *o.w[i];
      out.push(if a > b { a; } else { b; });
      i = i + 1usize;
    }
    new BoneMask(out);
  }
}
