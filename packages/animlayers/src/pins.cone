// LimbPin: a limb's end held at a place after the layers have moved the body above it.
//
// A layer that sways the pelvis, or bends the spine, moves the thigh with it and so the foot, and a planted foot
// slides. The pin is the answer every animation system has: solve the limb again to the place the end must be (two-bone
// IK, bonepose's aimLimb: the law of cosines and a pole for the bend), and turn the end bone to the orientation it must
// have (a sole flat on the ground). A weight fades it, so a foot can be let go (a step) and put back down.

pub struct LimbPin {
  pub top usize;            // the limb's first bone (thigh, upper arm): the next two bones are its middle and end
  pub target Vec3;          // where the end bone's origin must be, MODEL space
  pub endRot Quat;          // and the rotation the end bone must have, model space
  pub pole Vec3;            // the direction the middle joint bends towards
  pub minInterior f32;      // the smallest interior angle at the middle joint (a knee that cannot fold past it)
  pub weight f32;           // 0 leaves the limb alone, 1 holds it to the target

  // A pin from a place in the WORLD: 'world' is the model's placement in the world (model to world)
  pub fn fromWorld(top usize, world &Transform3, pos Vec3, rot Quat, pole Vec3, minInterior f32) LimbPin {
    imm inv = world.inverse();
    new LimbPin(top, inv.transformPoint(pos), inv.rotation * rot, pole, minInterior, 1.);
  }
}

// Hold the limb to the pin. 'models' must be current for the pose; it is brought up to date from the limb on.
pub fn applyPin(skel &Skeleton, pose &mut Pose, models &mut List[Transform3], pin &LimbPin) {
  if pin.weight <= 0.00001 { return; }
  imm mid = usize.from(skel.childOf(pin.top));
  imm end = usize.from(skel.childOf(mid));
  imm now = (*models[end]).translation;
  imm target = now.lerp(pin.target, pin.weight);
  aimLimb(skel, pose, models, pin.top, target, pin.pole, pin.minInterior);
  imm rot = (*models[end]).rotation.slerp(pin.endRot, pin.weight);
  skel.setModelRotation(pose, models, end, rot);
  skel.recompose(pose, models, end);
}

pub fn applyPins(skel &Skeleton, pose &mut Pose, models &mut List[Transform3], pins &List[LimbPin]) {
  mut i = 0usize;
  while i < pins.len() {
    applyPin(skel, pose, models, pins[i]);
    i = i + 1usize;
  }
}
