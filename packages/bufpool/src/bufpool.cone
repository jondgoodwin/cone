// The bufpool package: THE BUFFER POOL, a static region of power-of-two buffers.
// It is a region in Cone's run-time region model (core's 'MemRegion': alloc,
// resize, release, and the size an alloc gives), one object for the whole
// process, as the heap's is, and anything that takes a region can be handed it:
//
//   import bufpool use *;
//   import collections use *;
//
//   fn main() {
//     var bytes = List[u8](3000usize, bufferPool());   // room for 4096: all of it is the list's
//     bytes.push(7u8);
//   }                                                   // its block goes home to the pool
//
//   bufferPool()          the buffer pool region, a '*MemRegion'        (THE REGION)
//
// What it is for: to grab a power-of-two buffer and use it as a collection of
// bytes, nothing more elaborate than that. I/O is its biggest user (the iobuf
// package's IoBuf draws on it by default), and the name is not meant to stop
// other uses. Out of memory is a null block, as the heap's and every region's is,
// and a caller that cannot go on without a block panics (IoBuf does, at its
// caller's line).
//
// THE REGION. Five classes of blocks: 4, 16, 64, 256 KiB and 1 MiB. A request is
// served from the smallest class that holds it, so a block is never more than
// four times what was asked, and the region's SIZE function answers the class's
// size: a list asked for 3,000 bytes has a capacity of 4,096 and uses it all (the
// holder takes the room the size function says; core's MemRegion header comment
// has the promise). A request over 1 MiB is not pooled: a block of its own from
// the OS, rounded up to whole pages, counted against the bound, never kept idle,
// and given back to the OS when it is released.
//   - alloc(bytes, align) is a block of the class that holds 'bytes', page-aligned
//     (and aligned to its own size, a power of two, since its slab is aligned to
//     2 MiB); an 'align' over a page is refused with a panic;
//   - release(block, bytes) takes the block home BY ITS SIZE: the class is the
//     one that holds 'bytes', and 'bytes' is the room the block was given or any
//     byte count with the same answer, which is what a collection hands back.
//     It needs no token and no class, since the block leads to its slab by its
//     address (SLABS);
//   - resize(block, old, new, align) keeps the block when the class that holds
//     'new' is the one that holds 'old', and otherwise moves to the class that
//     fits, copying, and releases the old one;
//   - size(bytes, align) is the class's size, or the pages for an oversize one.
// A block may be released on any thread, whichever took it.
//
// The mechanism underneath is "fixed-size blocks with per-thread caches". Its raw
// calls (blockTake, blockPut, holdOversize, releaseOversize) are private: safe
// code could return a block twice through them. A later user of the mechanism
// (a stock of equal-sized blocks, such as the mailbox rings' segments) gets an
// owning handle (as core's AlignedBlock), designed when it comes. What the
// package exports of it:
//
//   registerClass(blockSize, cacheBlocks)    a class; during init; a panic once the pool is in use  (CLASSES)
//   flushThread()        this thread's cache goes back to the stock now; its end does too (THREADS)
//   trimStock()          this thread's cache, and every idle slab, go back to the OS  (THE OS)
//   trimEverything()     the same after every thread's cache is flushed; a panic if another
//                        thread still has a cache (nothing else is safe to do with it)
//   setLimits(maxBytes, keepBytes)  the process-wide bounds
//   addRoomWake(f), armRoomWake()   a refused caller learns room has come back  (ROOM WAKE)
//   blockStats()         the counters, a BlockStats
//   osBlocks(), osBytes()  what the pool holds from the OS now
//   classSize(c), page, largestClass, classCount        (the region's classes)
//
// SLABS. A SLAB is one allocation from the OS (VirtualAlloc, mmap) of 2 MiB,
// carved into 2 MiB / blockSize blocks; blocks never move, and the slab goes
// back to the OS whole, when every one of its blocks is home in the stock. Every
// slab is ALIGNED TO 2 MiB, and the page just before it is its HEADER, the slab's
// record: a block leads to its slab by masking its address with 2 MiB - 1 and
// stepping back a page, so no token travels with a block. (Precedent: mimalloc's
// aligned segments.) How the alignment is made, written to one contract on both
// systems: the OS is asked for 2 MiB + 2 MiB + a page, the aligned 2 MiB (and
// the header page before it) is picked out of it. On Windows the rest stays
// reserved and uncommitted (VirtualAlloc reserves it all; only the header and the
// blocks carved so far are committed; VirtualFree releases the whole reservation, from the base
// the header remembers). On Linux the rest is unmapped at both edges (mmap, then
// munmap of the head and the tail). The header page is not counted in the bound
// or in osBytes(), only the bytes of blocks that hold something: see BYTES COUNTED. A block is at
// least 8 bytes: while it sits idle in the stock its first word links it to the
// next. Classes are registered while modules initialise, before any thread takes
// a block: at most 10, each with a cache of at most 32 blocks. The pool registers
// the five sizes twice, as classes 0 to 4 (the PLAIN BANK) and 5 to 9 (the
// TRY BANK, which only tryAllocate takes from; see THE BANKS).
//
// THREADS. Each thread has a CACHE: for each class a stack of idle blocks (an
// array of block pointers in the thread's own record, so that taking one touches
// nothing of the block, and a return nothing of its slab), at most cacheBlocks
// of them, and so at most cacheBlocks * blockSize bytes. A take pops the thread's
// own stack and a return pushes it, touching no lock and no other thread's
// memory. An empty stack refills from the central stock a batch at a time (half
// the bound, at least one); a full one gives its OLDEST batch back, so a block
// cannot sit at the bottom of a cache pinning a slab. A block thus goes home to
// the cache of whichever thread it dies on. A class with cacheBlocks of 0 has no
// cache: each take and return is one locked step.
//
// The cache is a malloc'd record found through one '@threadlocal' pointer,
// not stored in the '@threadlocal' itself, because nothing finalizes a thread's
// copy of a '@threadlocal' yet when its thread ends (the manual's mod-globals
// says so). Every record is on a registry. WHEN A THREAD ENDS, whoever started
// it, its blocks go back to the stock and its record is retired for the next
// thread to reuse: the module's init registers bufpoolThreadEnded with conestd's
// thread-exit slot (threadexit.c: a fiber-local slot's callback on Windows, a
// pthread key's destructor on Linux), and a thread's first record arms it, so a
// thread that never takes or returns a block pays nothing. After its exit flush
// the thread is FINISHED: its 'myCache' is the late record, every line's cap 0,
// so a block taken or returned on it later (by another exit callback) goes
// straight to the stock, counted apart, and no record is made that nobody would
// flush. Once the module's final has begun ('stopping'), and while the process
// is ending (threadexit.c asks), a thread's end gives nothing back: it only
// marks its record ended. The final flushes the calling thread's record and the
// ended ones, and leaves a running thread's alone (a detached thread, an iocore
// worker, may be taking from it that moment; its blocks go back with the
// process). flushThread does the same early, for a thread that lives
// on idle. If the slot is not to be had (cone_threadExitAdd answers 0: its table
// is full, or the system refused the slot), nothing is armed, a thread's end
// gives nothing back, and flushThread is the pool's only give-back from a
// thread; the pool otherwise works as ever and does not panic for it.
//
// THE STOCK. For each class, a lock and a list of slabs; each slab has its own
// free list of returned blocks and a bump mark for the blocks never yet
// handed out, so a fresh slab touches no memory until its blocks are used. The
// stock takes the first slab with a block to give. One process-wide bound
// (default 64 MiB) limits the bytes held from the OS, slabs and oversize
// blocks together: a slab that would pass it first has the idle slabs of
// every class given back, then the thread's own cache flushed, then the idle blocks
// of the slabs that remain decommitted (BYTES COUNTED), and if that is
// not enough blockTake answers null. A second bound (default 8 MiB) is the
// idle bytes the stock keeps: when blocks come home and the idle bytes pass it,
// slabs wholly idle are given back to the OS, a whole slab at a time, but never
// below the bound, so a steady load does not make the OS calls it saved.
//
// BYTES COUNTED (row 658). The bound counts bytes that hold something, not address space, in two ways.
//   - CARVED, NOT WHOLE: a slab's blocks are committed and counted a COMMIT CHUNK (64 KiB, or the block if
//     larger) at a time, as the bump mark carves them: a slab's first take counts one chunk, not 2 MiB. The
//     growth path pays one commit call (Windows; on Linux the mapping is readable already and the chunk is
//     only counted) per chunk ever carved, never one per take or return. osBytes() and the memory
//     trace report these committed bytes.
//   - IDLE, NOT PINNED: a slab with one block still lent cannot go back whole, and its idle blocks would hold
//     the bound's bytes for nothing. When a take is refused at the bound, after the idle slabs are given back
//     and this thread's cache is flushed, the idle blocks of the slabs that remain are DECOMMITTED
//     (decommitForRoom): taken off their free list, marked in the slab's bitmap (the header page's 'bits', 512
//     at most: blocks of a page or more), and their pages given back to the OS (VirtualFree MEM_DECOMMIT;
//     madvise MADV_DONTNEED then PROT_NONE), and their bytes leave 'held'. A take of the slab uses the free
//     list, then the bump mark, then a decommitted block, recommitted after its bytes are counted again
//     (never by making room under a lock: the take counts first, outside it). The class lock is held across
//     the marking and the decommit, so a take cannot bring a marked block back under the late decommit. A
//     decommitted block is never touched until it is recommitted (its pages fault on Windows and read zero on
//     Linux after MADV_DONTNEED). stockBytes is the COMMITTED idle bytes. The take and return fast paths, a
//     spill and a refill's batch are unchanged: the new work is in a slab with nothing committed to take
//     and on the refusal path only.
//
// THE BANKS. A flood of a peer's small buffers must not leave the program's own
// constructions without a slab, whichever way the peer's blocks are freed. So
// tryAllocate takes from slabs of its own, the try bank: a second set of classes
// of the same five sizes, with their own stock, slab lists and caches. The plain
// bank grows to maxBytes, as ever. The try bank gets a new slab (or an oversize
// block) only while the bytes held, both banks together, plus the slab stay
// within maxBytes less a reserve, a quarter of maxBytes (at least five slabs, at
// most half). So the plain bank can always grow by the reserve, however the try
// bank's blocks lie. A free block of the try bank is always safe to give. A
// block goes home to the bank it came from: release reads the slab's 'home', a
// copy of its class written once on a line of the header page of its own.
//
// COUNTS. Each thread counts its own takes and returns, per class, in its
// record (plain numbers, no atomics: one add on the path); the stats add them
// up. So they are exact once the threads that took and returned have stopped;
// read while others run, they are a sum of moments. The OS counters and the
// stock's are exact: kept under its locks or atomically.
//
// ROOM WAKE. A caller that tryAllocate (or IoBuf.tryMake) refused can wait for room instead of
// retrying on a timer. The waiting layer registers a function at module initialisation
// (addRoomWake: at most four, a panic once a thread has a record), and a waiter's protocol is:
//   1. a take is refused;  2. armRoomWake();  3. retry the take once;
//   4. if it is refused too, park outside the pool, on its own terms;
//   5. when woken, armRoomWake() again before retrying the parked takes, so that room that arrives
//      during the retry pass fires again.
// The order is the whole argument. A room event is made where room is made, after it is made and
// outside every lock of the pool: the blocks of a stockPut (a spill, a flush, a thread's end, a late
// return, a return with no cache), the bytes of 'held' lowered by freeSlabs and by releaseOversize.
// An event reads the armed word once (one atomic load when nobody waits); when armed it disarms it
// and calls every registered function, so a burst of room is one wake, and a waiter that arms again
// asks for the next. No wake is lost, by two pairs. A stockPut's blocks are published by the class
// lock's release, and its event reads the word after it; the waiter's arm comes before its retry,
// which takes the same lock. The retry's lock comes after the event's unlock (it sees the blocks) or
// before it (the arm is then before the event's read, which sees it armed). 'held' is atomic and
// every operation on it and on the armed word is sequentially consistent: the arm, then the retry's
// reserve; the sub, then the event's read. 'reserve' raises 'held' by a compare-and-swap and never
// raises it and lowers it again, because a refusal made by a count that goes away a moment later would
// leave a waiter that has room in hand with no event to wake it. A refused take of one class can
// be helped by a return of another (the retry's trim gives back a slab the return left idle), so
// every stockPut is an event, and a wasted wake is a spurious one: allowed. A retry that finds room
// leaves the wake armed: at most one spurious run. THE WAKE FUNCTION is called on whatever thread
// made the room, a thread's exit callback among them, and for any room, not for one caller: it may
// post a message or a completion or set a flag; it must not take or return a pool block, call back
// into the pool or block. 'Must not block' is the rule that stays a rule (breaking it hangs, it
// corrupts nothing); the rest is not what safety rests on: a wake that takes blocks, returns them,
// calls trimStock or does all three, is safe at every site that makes room, shown by
// tests/roomreenter.cone (Windows, and Linux under ASan): a spill (a line that is the whole batch
// too), a return with no cache, a late return, flushThread, a thread's end (where 'myCache' is
// already the late record, so the wake's takes and returns go straight to the stock), trimEverything,
// freeSlabs, releaseOversize, a take that gives idle slabs back to make room for its own slab, and the
// final. What makes it so: room made while a cache line is half moved (a spill's batch still in
// the line, a refill's batch landing in the line's own slots) or while the registry's lock is held is
// only noted (noteRoom), and announced (roomAnnounce) once the line is whole, after the block that
// caused the spill is in it, and after the lock is released. A wake that does these things may
// be wasteful (a second event, a spurious wake), never unsafe. KNOWN LIMITS: (a) blocks idle in another thread's cache are not room
// until that thread spills, flushes or ends, so a waiter can wait while memory sits in busy
// threads' caches (R2, row 649); the waiting layer's own timer retry can stay as a slow backstop
// until R2 answers. (b) An OS refusal of memory the bound allows (VirtualAlloc, mmap, malloc
// failing) is not room and runs no event: a waiter refused in the instant a concurrent attempt's
// reserved bytes were given back after such a refusal waits for the next real event.
//
// The module's init makes the region and registers the five classes twice; its final
// gives every idle slab back to the OS, after every module that uses the pool has
// finalized.
//
// CAVEATS (what only the program can keep true):
// - A thread's cache is touched only by that thread, by its end and flushThread
//   (both under the registry's lock) and by the module's final, which flushes
//   only the calling thread's and ended threads' records (a thread still running
//   at the final keeps its cache). trimEverything flushes every
//   cache, so it panics unless every other thread's record is retired (the thread
//   ended, or called flushThread): a cache cannot be emptied from outside while
//   its thread may be taking from it or returning to it.
// - A block is returned once, with the size it was given (the class is found by
//   it). A block the pool did not give leads to a header that is not there;
//   returning one to a class it did not come from panics when the stock sees it.
// - The module's final gives back every slab whose blocks are all home; a
//   slab with a block still lent (a leak) is left, and osBlocks() shows it.

mod bufpool;

import libc;
import sync use Mutex;
import trace use Level, Kind4;

// MEMORY TRACING (target "memory"; schema in packages/memtrace/README.md). The pool takes its memory from the OS
// (VirtualAlloc, mmap), which no malloc shim sees, so it counts its own supply: bufpool.reserve (address space
// asked for, n bytes), bufpool.commit (memory made usable, n bytes: a slab's header and first chunk, each
// later chunk, a block recommitted), bufpool.release (given back, n bytes: a slab freed whole, with what is
// committed of it, or idle blocks decommitted at the bound), all Debug, one per slab, chunk or oversize block (elem 2 MiB slab, or 0 oversize), and
// bufpool.cache (Trace): the bytes one thread's cache holds after a batch moved between it and the stock (a
// refill or a spill; the per-block fast paths carry no check): inst is the cache's address (a key of its
// own, so the report sums the last aux of each cache at each sample): n its misses so far, aux the bytes held.
let bufReserve: Kind4[u64, u64, u64, u64];
let bufCommit: Kind4[u64, u64, u64, u64];
let bufRelease: Kind4[u64, u64, u64, u64];
let bufCache: Kind4[u64, u64, u64, u64];

// The bytes this cache holds in its lines
fn cacheHeld(tc: *ThreadCache) u64 {
  let g = glob();
  var total = 0u64;
  var c = 0usize;
  while c < (*g).nClasses {
    total = total + u64.from((*lineAt(tc, c)).count) * u64.from((*classAt(g, c)).blockSize);
    c = c + 1usize;
  }
  total
}

// ---------------------------------------------------------------------------
// The slabs come from the OS: VirtualAlloc and VirtualFree on Windows, mmap
// and munmap on Linux. '#if #os == .windows' chooses, so only the target's
// calls are generated; every extern is declared everywhere
// ---------------------------------------------------------------------------

extern {
  fn @c(system) VirtualAlloc(addr: *u8, size: usize, kind: u32, protect: u32) *u8;
  fn @c(system) VirtualFree(addr: *u8, size: usize, kind: u32) i32;
  fn @c mmap(addr: *u8, size: usize, protect: i32, flags: i32, fd: i32, offset: i64) *u8;
  fn @c munmap(addr: *u8, size: usize) i32;
  fn @c mprotect(addr: *u8, size: usize, protect: i32) i32;
  fn @c madvise(addr: *u8, size: usize, advice: i32) i32;
  // conestd's threadexit.c: the process's one thread-exit slot (THREADS)
  fn @c cone_threadExitAdd(callback: &fn @c ()) u32;
  fn @c cone_threadExitArm(id: u32);
}

const memCommit = 0x1000u32;
const memReserve = 0x2000u32;
const memDecommit = 0x4000u32;
const memRelease = 0x8000u32;
const pageReadWrite = 0x04u32;
const pageNoAccess = 0x01u32;

// Linux: readable and writable, private and anonymous; mmap answers (void*)-1
// when it fails
const protReadWrite = 3i32;
const protNone = 0i32;
const madvDontNeed = 4i32;
const mapPrivateAnonymous = 0x22i32;
const mapFailed = 0xFFFFFFFFFFFFFFFFusize;

// Blocks (slabs and oversize blocks) and bytes held from the OS by the pool,
// for leak checks
let liveBlocks: Atomic[u64];
let liveBytes: Atomic[u64];

// A slab is 2 MiB: 512 blocks of 4 KiB down to 2 of 1 MiB. It is aligned to
// 2 MiB, and the page before it is its header
const slabBytes = 2097152usize;

// A block's alignment, and the unit every oversize capacity is a multiple of
pub const page = 4096usize;

const maxClasses = 10usize;    // the five sizes twice: the plain bank, then tryAllocate's
const maxCache = 32u32;

// A new slab: slabBytes bytes aligned to slabBytes, the page before them
// committed (the header), and 'first' bytes of the blocks committed (a multiple of
// the commit chunk; on Linux the mapping is all readable and writable at once, and
// 'first' is only what the pool counts). Answers the aligned base and the base of
// the whole reservation, which osFreeSlab wants back. Null when the OS refuses
fn osAllocSlab(first: usize) *u8, *u8 {
  let total = slabBytes + slabBytes + page;
  #if #os == .windows {
    let r = VirtualAlloc(null, total, memReserve, pageNoAccess);
    if r as usize == 0usize {return null, null;}
    let aligned = (r as usize + page + slabBytes - 1usize) & (0usize - slabBytes);
    let c = VirtualAlloc((aligned - page) as *u8, first + page, memCommit, pageReadWrite);
    if c as usize == 0usize {
      VirtualFree(r, 0usize, memRelease);
      return null, null;
    }
    liveBlocks.addOrdered(1u64, MemOrder.Relaxed);
    liveBytes.addOrdered(u64.from(first), MemOrder.Relaxed);
    bufReserve.emit(u64.from(slabBytes), u64.from(total), 0u64, 0u64);
    bufCommit.emit(u64.from(slabBytes), u64.from(first + page), 0u64, 0u64);
    return aligned as *u8, r;
  } #else {
    let p = mmap(null, total, protReadWrite, mapPrivateAnonymous, 0i32 - 1i32, 0i64);
    if p as usize == mapFailed {return null, null;}
    let aligned = (p as usize + page + slabBytes - 1usize) & (0usize - slabBytes);
    let head = aligned - page - p as usize;
    if head > 0usize {munmap(p, head);}
    let tail = p as usize + total - (aligned + slabBytes);
    if tail > 0usize {munmap((aligned + slabBytes) as *u8, tail);}
    liveBlocks.addOrdered(1u64, MemOrder.Relaxed);
    liveBytes.addOrdered(u64.from(first), MemOrder.Relaxed);
    bufReserve.emit(u64.from(slabBytes), u64.from(total), 0u64, 0u64);
    bufCommit.emit(u64.from(slabBytes), u64.from(first + page), 0u64, 0u64);
    aligned as *u8, (aligned - page) as *u8
  }
}

// A slab's whole reservation back to the OS: 'osBase' is what osAllocSlab
// answered second, 'committed' the bytes of its blocks that are committed now
fn osFreeSlab(osBase: *u8, committed: usize) {
  #if #os == .windows {VirtualFree(osBase, 0usize, memRelease);} #else {munmap(osBase, slabBytes + page);}
  liveBlocks.subOrdered(1u64, MemOrder.Relaxed);
  liveBytes.subOrdered(u64.from(committed), MemOrder.Relaxed);
  bufRelease.emit(u64.from(slabBytes), u64.from(committed + page), 0u64, u64.from(slabBytes + slabBytes + page));
}

// 'bytes' more of a slab's never-carved blocks made usable, at 'addr': the next commit chunk,
// on the growth path. Windows commits them; on Linux they are readable and writable already,
// and this only counts. False when the OS refuses
fn osExtend(addr: *u8, bytes: usize) bool {
  var ok = true;
  #if #os == .windows {
    ok = VirtualAlloc(addr, bytes, memCommit, pageReadWrite) as usize != 0usize;
  } #else {
    ok = true;
  }
  if ok {
    liveBytes.addOrdered(u64.from(bytes), MemOrder.Relaxed);
    bufCommit.emit(u64.from(slabBytes), u64.from(bytes), 0u64, 0u64);
  }
  ok
}

// Idle blocks given back to the OS but kept in their slab: the pages go (Windows MEM_DECOMMIT;
// Linux MADV_DONTNEED, so they read zero, then PROT_NONE, so a stale touch faults) and the
// address range stays. Only at the bound, with the class's lock held; osRecommit is its inverse
fn osDecommit(addr: *u8, bytes: usize) {
  #if #os == .windows {
    VirtualFree(addr, bytes, memDecommit);
  } #else {
    madvise(addr, bytes, madvDontNeed);
    mprotect(addr, bytes, protNone);
  }
  liveBytes.subOrdered(u64.from(bytes), MemOrder.Relaxed);
  bufRelease.emit(u64.from(slabBytes), u64.from(bytes), 0u64, 0u64);
}

// A decommitted run made usable again (its pages read zero). False when the OS refuses
fn osRecommit(addr: *u8, bytes: usize) bool {
  var ok = true;
  #if #os == .windows {
    ok = VirtualAlloc(addr, bytes, memCommit, pageReadWrite) as usize != 0usize;
  } #else {
    ok = mprotect(addr, bytes, protReadWrite) == 0i32;
  }
  if ok {
    liveBytes.addOrdered(u64.from(bytes), MemOrder.Relaxed);
    bufCommit.emit(u64.from(slabBytes), u64.from(bytes), 0u64, 0u64);
  }
  ok
}

// An oversize block of size bytes (whole pages), page-aligned and of its own
fn osAlloc(size: usize) *u8 {
  var b = null as *u8;
  #if #os == .windows {
    b = VirtualAlloc(null, size, memCommit | memReserve, pageReadWrite);
  } #else {
    b = mmap(null, size, protReadWrite, mapPrivateAnonymous, 0i32 - 1i32, 0i64);
    if b as usize == mapFailed {b = null;}
  }
  if b as usize != 0usize {
    liveBlocks.addOrdered(1u64, MemOrder.Relaxed);
    liveBytes.addOrdered(u64.from(size), MemOrder.Relaxed);
    bufReserve.emit(0u64, u64.from(size), 0u64, 0u64);
    bufCommit.emit(0u64, u64.from(size), 0u64, 0u64);
  }
  b
}

fn osFree(block: *u8, size: usize) {
  #if #os == .windows {VirtualFree(block, 0usize, memRelease);} #else {munmap(block, size);}
  liveBlocks.subOrdered(1u64, MemOrder.Relaxed);
  liveBytes.subOrdered(u64.from(size), MemOrder.Relaxed);
  bufRelease.emit(0u64, u64.from(size), 0u64, u64.from(size));
}

// What the pool holds from the OS now: slabs and oversize blocks, and their bytes
// (a slab's committed blocks, less its decommitted ones; its header page is not counted)
pub fn osBlocks() u64 {liveBlocks.load()}
pub fn osBytes() u64 {liveBytes.load()}

// ---------------------------------------------------------------------------
// The mechanism: slabs, classes, the thread caches and the stock
// ---------------------------------------------------------------------------

// A slab's record, in the page before the slab. Reached only under its class's
// lock
struct SlabRec {
  base: *u8;         // the first block: 2 MiB aligned
  osBase: *u8;       // what osFreeSlab wants
  cls: u32;          // its class, checked at a return
  total: u32;        // blocks in the slab
  carved: u32;       // blocks handed out at least once: the bump mark
  used: u32;         // blocks outside the stock: cached or lent
  listed: u32;       // 1 while on the class's list of slabs with a block to give
  freeHead: *u8;     // returned blocks, linked
  nextP: *SlabRec;   // the list of slabs with a block to give
  prevP: *SlabRec;
  nextA: *SlabRec;   // the list of every slab
  prevA: *SlabRec;
  decommitted: u32;  // blocks off the free list whose pages are decommitted (the bits below); in the stock, not 'used'
  commitEnd: u32;    // bytes from 'base' that are committed (and counted in 'held'): the carved blocks, rounded up to a commit chunk
  pad: Array[u64, 5];  // 'home' is alone on the next 64-byte line of the header page
  home: u32;         // its class again, written once before the slab is listed, read without the lock
  homePad: u32;
  pad2: Array[u64, 7];
  bits: Array[u64, 8];  // bit i set: block i is decommitted (blocks of a page or more only: 512 at most)
  fresh: Array[u64, 8]; // while decommitSlab runs: the bits it has just set (so a run is decommitted once); else 0
}

fn freshOf(s: *SlabRec) *u64 {(&(*s).fresh) as *u64}
fn freshTest(s: *SlabRec, i: usize) bool {
  ((*(freshOf(s) + (i >> 6usize)) >> u64.from(i & 63usize)) & 1u64) != 0u64
}
fn freshSet(s: *SlabRec, i: usize) {
  let w = freshOf(s) + (i >> 6usize);
  *w = *w | (1u64 << u64.from(i & 63usize));
}
fn freshClear(s: *SlabRec, i: usize) {
  let w = freshOf(s) + (i >> 6usize);
  *w = *w & ((1u64 << u64.from(i & 63usize)) ^ 0xFFFFFFFFFFFFFFFFu64);
}

// Under the class lock: a slab's decommit bitmap
fn bitsOf(s: *SlabRec) *u64 {(&(*s).bits) as *u64}
fn bitTest(s: *SlabRec, i: usize) bool {
  ((*(bitsOf(s) + (i >> 6usize)) >> u64.from(i & 63usize)) & 1u64) != 0u64
}
fn bitSet(s: *SlabRec, i: usize) {
  let w = bitsOf(s) + (i >> 6usize);
  *w = *w | (1u64 << u64.from(i & 63usize));
}
fn bitClear(s: *SlabRec, i: usize) {
  let w = bitsOf(s) + (i >> 6usize);
  *w = *w & ((1u64 << u64.from(i & 63usize)) ^ 0xFFFFFFFFFFFFFFFFu64);
}

// What one stockTake carries through takeLocked: bytes it has already counted into 'held' (CREDIT, spent
// by the commits that follow, the rest given back at the end), the least bytes the take would need to
// go on when the bound refused it, and whether the OS refused a commit
struct TakeCtx {
  credit: u64;
  need: u64;
  failed: u32;
}

// A class's stock. Every field is reached under 'lock', except the class's
// constants, set once at registration, and the counters other threads read
// to total (idleBlocks, slabs)
struct ClassState {
  lock: Mutex;
  index: u32;
  blockSize: usize;
  perSlab: u32;
  cacheCap: u32;
  batch: u32;
  active: u32;
  all: *SlabRec;
  partial: *SlabRec;       // the head: the next slab to give from
  partialTail: *SlabRec;
  slabs: usize;
  idleBlocks: usize;       // blocks in free lists: returned, idle in the stock
  lateTakes: Atomic[u64];  // takes and returns on finished threads, which count in no record
  lateReturns: Atomic[u64];
}

// One thread's stack of idle blocks of a class
struct CacheLine {
  count: u32;
  cap: u32;
  slots: Array[*u8, 32];
}

// One thread's cache, malloc'd and on the registry for good
struct ThreadCache {
  lines: Array[CacheLine, 10];
  takes: Array[u64, 10];
  returns: Array[u64, 10];
  misses: u64;               // takes that had to go to the stock
  nextReg: *ThreadCache;     // every record ever made
  nextFree: *ThreadCache;    // the retired ones, for reuse
  live: u32;                 // 1 while a thread has it
}

// Everything the mechanism shares, one malloc'd record found by 'gAddr'
struct Globals {
  classes: Array[ClassState, 10];
  regLock: Mutex;
  regHead: *ThreadCache;
  freeRecs: *ThreadCache;
  lateRec: *ThreadCache;     // a finished thread's 'myCache': every line's cap 0, on no registry
  exitId: u32;               // the pool's number in conestd's thread-exit slot, or 0 when it has none
  stopping: Atomic[u32];     // 1 once the module's final has begun; set under regLock, read first by a thread's end
  nClasses: usize;
  maxBytes: Atomic[u64];
  keepBytes: Atomic[u64];
  held: Atomic[u64];         // bytes held from the OS, or about to be
  osAllocs: Atomic[u64];     // slabs and oversize blocks got from the OS
  osFrees: Atomic[u64];      // and given back
  bigLent: Atomic[u64];      // oversize blocks lent now
  bigBytes: Atomic[u64];     // and their bytes
  bigTakes: Atomic[u64];     // oversize blocks ever lent
  refused: Atomic[u64];      // tryAllocate's refusals
  flushHook: usize;          // test-only (setFlushHook): the address of a hook flushCache calls, 0 in a program
  roomState: Atomic[u32];    // ROOM WAKE: bit 0, a waiter has armed the wake; bit 1, the test-only hook is set
  roomWakeCount: u32;        // the wakes registered, at most maxRoomWakes, set in module initialisation
  roomWakes: Array[usize, 4];  // their addresses
  roomHook: usize;           // test-only (setRoomHook): the address of a hook the room event calls, 0 in a program
  decommitHook: usize;       // test-only (setDecommitHook): the address of a hook decommitSlab calls, 0 in a program
}

pub const defaultMaxBytes = 67108864usize;     // 64 MiB held from the OS at most
pub const defaultKeepBytes = 8388608usize;     // 8 MiB of idle blocks kept

let gAddr: Atomic[usize];

var @threadlocal myCache: *ThreadCache = null;

// The slab a block is in: its address masked to 2 MiB, the page before
fn slabOf(b: *u8) *SlabRec {
  (((b as usize) & (0usize - slabBytes)) - page) as *SlabRec
}

// Called by the module's init, after it has made 'gAddr'
fn blocksInit() {
  let g = libc.calloc(1usize, mem.sizeof[Globals]()) as *Globals;
  if g as usize == 0usize {
    panic("bufpool: out of memory for the block stock");
  }
  (*g).regLock = Mutex.make();
  var c = 0usize;
  while c < maxClasses {
    (*classAt(g, c)).lock = Mutex.make();
    (*classAt(g, c)).lateTakes = Atomic[u64].of(0u64);
    (*classAt(g, c)).lateReturns = Atomic[u64].of(0u64);
    c = c + 1usize;
  }
  // calloc'd: every line's count and cap are 0, so it caches nothing
  (*g).lateRec = libc.calloc(1usize, mem.sizeof[ThreadCache]()) as *ThreadCache;
  if (*g).lateRec as usize == 0usize {
    panic("bufpool: out of memory for the block stock");
  }
  (*g).stopping = Atomic[u32].of(0u32);
  (*g).maxBytes = Atomic[u64].of(u64.from(defaultMaxBytes));
  (*g).keepBytes = Atomic[u64].of(u64.from(defaultKeepBytes));
  (*g).held = Atomic[u64].of(0u64);
  (*g).osAllocs = Atomic[u64].of(0u64);
  (*g).osFrees = Atomic[u64].of(0u64);
  (*g).bigLent = Atomic[u64].of(0u64);
  (*g).bigBytes = Atomic[u64].of(0u64);
  (*g).bigTakes = Atomic[u64].of(0u64);
  (*g).refused = Atomic[u64].of(0u64);
  (*g).roomState = Atomic[u32].of(0u32);
  gAddr.store(g as usize);
}

fn glob() *Globals {gAddr.loadOrdered(MemOrder.Relaxed) as *Globals}

fn classAt(g: *Globals, c: usize) *ClassState {
  ((&(*g).classes) as *ClassState) + c
}

fn lineAt(tc: *ThreadCache, c: usize) *CacheLine {
  ((&(*tc).lines) as *CacheLine) + c
}

fn slotsOf(ln: *CacheLine) **u8 {
  (&(*ln).slots) as **u8
}

fn takesAt(tc: *ThreadCache, c: usize) *u64 {
  ((&(*tc).takes) as *u64) + c
}

fn returnsAt(tc: *ThreadCache, c: usize) *u64 {
  ((&(*tc).returns) as *u64) + c
}

// An idle block in the stock: its first word links it to the next
fn linkNext(b: *u8) *u8 {*(b as **u8)}
fn setNext(b: *u8, next: *u8) {*(b as **u8) = next;}

// Register a class of blocks of blockSize bytes (at least 8, a multiple of 8, at
// most a slab) carved from slabs of 2 MiB, each thread keeping up to cacheBlocks
// (at most 32) of them. Answers its number. During module initialisation only
pub fn registerClass(blockSize: usize, cacheBlocks: u32) usize {
  let g = glob();
  (*g).regLock.lock();
  if (*g).regHead as usize != 0usize {    // a record exists (live or retired): its lines hold the caps copied at its making
    (*g).regLock.unlock();
    panic("bufpool: registerClass after the pool is in use; register classes in module initialisation");
  }
  let c = (*g).nClasses;
  if c >= maxClasses {
    (*g).regLock.unlock();
    panic("bufpool: too many block classes");
  }
  if blockSize < 8usize || blockSize > slabBytes || blockSize % 8usize != 0usize || cacheBlocks > maxCache {
    (*g).regLock.unlock();
    panic("bufpool: a block class needs blocks of 8 bytes or more (a multiple of 8) in a slab of 2 MiB, and a cache of 32 at most");
  }
  let cs = classAt(g, c);
  (*cs).index = u32.from(c);
  (*cs).blockSize = blockSize;
  (*cs).perSlab = u32.from(slabBytes / blockSize);
  (*cs).cacheCap = cacheBlocks;
  let half = cacheBlocks / 2u32;
  (*cs).batch = if half == 0u32 {1u32} else {half};
  (*cs).active = 1u32;
  (*g).nClasses = c + 1usize;
  (*g).regLock.unlock();
  c
}

// The process-wide bounds, in bytes held from the OS and idle bytes kept. A
// zero leaves the bound as it is
pub fn setLimits(maxBytes: usize, keepBytes: usize) {
  let g = glob();
  if maxBytes != 0usize {(*g).maxBytes.store(u64.from(maxBytes));}
  if keepBytes != 0usize {(*g).keepBytes.store(u64.from(keepBytes));}
}

// ---------------------------------------------------------------------------
// The room wake: a refused caller learns that room has come back (ROOM WAKE)
// ---------------------------------------------------------------------------

const roomArmedBit = 1u32;
const roomHookBit = 2u32;
const maxRoomWakes = 4u32;

// Register a function the pool calls when room may have come back to a caller it
// refused, and that caller has armed the wake (armRoomWake). During module
// initialisation only: a panic once a thread has a record, as registerClass. At
// most four. The function is called on whatever thread made the room (a thread
// returning a block, one ending, one trimming), outside every lock of the pool,
// and it is called for ANY room, not for one caller: it must only post a
// message or a completion or set a flag. It must not take or return a pool
// block, nor call back into the pool, and it must not block
pub fn addRoomWake(f: &fn @c ()) {
  let g = glob();
  (*g).regLock.lock();
  if (*g).regHead as usize != 0usize {
    (*g).regLock.unlock();
    panic("bufpool: addRoomWake after the pool is in use; register wakes in module initialisation");
  }
  let n = (*g).roomWakeCount;
  if n >= maxRoomWakes {
    (*g).regLock.unlock();
    panic("bufpool: too many room wakes");
  }
  var held = f;    // kept as an address, as setFlushHook does
  *(((&(*g).roomWakes) as *usize) + usize.from(n)) = mem.readRaw[usize](&mut held as *usize);
  (*g).roomWakeCount = n + 1u32;
  (*g).regLock.unlock();
}

// A caller the pool refused (tryAllocate or IoBuf.tryMake answered null) arms the
// wake, THEN retries once; if that is refused it parks on its own terms. The
// order is the whole argument: room made after the arm finds the wake armed and
// calls the registered functions once (they are then disarmed); room made before
// it is seen by the retry. A waiter woken calls this again before it retries, so
// room that arrives during its retry pass fires again. A wake may be spurious (a
// retry that finds room leaves the wake armed). Sequentially consistent, as the
// room events' reads are
pub fn armRoomWake() {
  (*glob()).roomState.bitOr(roomArmedBit);
}

// A room event: room has just been made, outside every lock of the pool. When no
// waiter has armed the wake this is one atomic load
fn roomEvent(g: *Globals) inline {
  let s = (*g).roomState.load();
  if s != 0u32 {
    roomEventArmed(g, s);
  }
}

// Room made where the event cannot be made yet (the thread's cache line is half moved, or the
// registry's lock is held) is noted, and announced where the state is whole again
var @threadlocal roomPending: u32 = 0u32;

fn noteRoom() {
  roomPending = 1u32;
}

fn roomAnnounce(g: *Globals) {
  if roomPending != 0u32 {
    roomPending = 0u32;
    roomEvent(g);
  }
}

fn roomEventArmed(g: *Globals, s: u32) {
  if s & roomHookBit != 0u32 {
    runRoomHook(g);       // test-only park point: after the room is made, before the flag is read
  }
  let was = (*g).roomState.bitAnd(0xFFFFFFFFu32 - roomArmedBit);   // the one that sees it armed disarms it, and calls
  if was & roomArmedBit == 0u32 {
    return;
  }
  var i = 0usize;
  let n = usize.from((*g).roomWakeCount);
  while i < n {
    var p = *(((&(*g).roomWakes) as *usize) + i);
    let w = mem.readRaw[&fn @c ()](&mut p as *(&fn @c ()));
    w();
    i = i + 1usize;
  }
}

// A test-only hook, as setFlushHook: f is called by every room event that runs while the hook is
// set, on the thread making the room, after the room is made and before the event reads the
// armed flag, so a test can hold the returner there while a waiter arms and retries. A program
// does not set it. The hook costs a program nothing: the bit that says it is set shares the
// word the event loads anyway
pub fn setRoomHook(f: &fn()) {
  var held = f;
  (*glob()).roomHook = mem.readRaw[usize](&mut held as *usize);
  (*glob()).roomState.bitOr(roomHookBit);
}

fn runRoomHook(g: *Globals) {
  var p = (*g).roomHook;
  if p != 0usize {
    let hook = mem.readRaw[&fn()](&mut p as *(&fn()));
    hook();
  }
}

// ---------------------------------------------------------------------------
// The thread's cache
// ---------------------------------------------------------------------------

fn threadCache() *ThreadCache {
  let tc = myCache;
  if tc as usize != 0usize {
    return tc;
  }
  makeCache()
}

// The calling thread's record: a retired one, or a new one on the registry
fn makeCache() *ThreadCache {
  let g = glob();
  (*g).regLock.lock();
  var tc = (*g).freeRecs;
  if tc as usize != 0usize {
    (*g).freeRecs = (*tc).nextFree;
    (*tc).nextFree = null;
  } else {
    tc = libc.calloc(1usize, mem.sizeof[ThreadCache]()) as *ThreadCache;
    if tc as usize == 0usize {
      (*g).regLock.unlock();
      panic("bufpool: out of memory for a thread's cache");
    }
    (*tc).nextReg = (*g).regHead;
    (*g).regHead = tc;
  }
  (*tc).live = 1u32;
  var c = 0usize;
  while c < maxClasses {
    (*lineAt(tc, c)).cap = (*classAt(g, c)).cacheCap;
    c = c + 1usize;
  }
  (*g).regLock.unlock();
  myCache = tc;
  cone_threadExitArm((*g).exitId);    // so bufpoolThreadEnded runs when this thread ends
  tc
}

// The thread is ending: conestd's thread-exit slot calls this on it, while its
// thread-locals are still there. Its cache goes back to the stock and its record
// is retired, as flushThread does, but under the registry's lock, so that
// trimEverything (the module's final) cannot flush the same lines at the same
// moment. Then the thread is FINISHED: its 'myCache' is the late record, whose
// lines hold nothing, so a block dropped on it after this (by another exit
// callback, or a thread-local's destructor) goes straight to the stock and no
// cache is made that nobody would flush. Once the module's final has begun
// ('stopping') nothing is given back: the record is only marked ended (not live,
// not reused), so the final flushes it if it has not yet walked past it
fn @c bufpoolThreadEnded() {
  let g = glob();
  let tc = myCache;
  myCache = (*g).lateRec;
  if tc as usize == 0usize || tc == (*g).lateRec {
    return;
  }
  (*g).regLock.lock();
  var gave = false;
  if (*g).stopping.load() == 0u32 {   // the final has not begun (the lock orders this against it)
    flushCache(tc, false);            // under the registry's lock: the room event is made after it
    (*tc).live = 0u32;
    (*tc).nextFree = (*g).freeRecs;
    (*g).freeRecs = tc;
    gave = true;
  } else {
    (*tc).live = 0u32;                // ended: the final flushes it if it has not yet walked past it; nothing is given back here
  }
  (*g).regLock.unlock();
  if gave {roomAnnounce(g);}      // 'myCache' is the late record: a wake that takes or returns goes straight to the stock
}

// A take on a finished thread: one block from the stock, through a slot on the
// stack (the late record is shared by every finished thread, so nothing of it is
// written but its counts, which no total reads)
fn lateTake(g: *Globals, c: usize) *u8 {
  let cs = classAt(g, c);
  var one = null as *u8;
  if stockTake(g, cs, 1u32, &one, true) == 0u32 {
    return null;
  }
  (*cs).lateTakes.add(1u64);
  one
}

// A return on a finished thread: straight to the stock
fn lateReturn(g: *Globals, c: usize, b: *u8) {
  let cs = classAt(g, c);
  var one = b;
  stockPut(g, cs, &one, 1u32, true);
  (*cs).lateReturns.add(1u64);
}

// ---------------------------------------------------------------------------
// Taking and returning
// ---------------------------------------------------------------------------

// A block of class c, or null when the bound, or the OS, will not give one
fn blockTake(c: usize) *u8 {
  let tc = threadCache();
  let t = takesAt(tc, c);
  *t = *t + 1u64;
  let ln = lineAt(tc, c);
  let n = (*ln).count;
  if n != 0u32 {
    (*ln).count = n - 1u32;
    return *(slotsOf(ln) + usize.from(n - 1u32));
  }
  refill(tc, c, ln)
}

// The cache is empty: a batch from the stock, one block of it answered
fn refill(tc: *ThreadCache, c: usize, ln: *CacheLine) *u8 {
  let g = glob();
  if tc == (*g).lateRec {
    return lateTake(g, c);
  }
  (*tc).misses = (*tc).misses + 1u64;
  let cs = classAt(g, c);
  let want = if (*ln).cap == 0u32 {1u32} else {(*cs).batch};
  // The batch lands in the line's own slots, so room made on the way (a slab given back to make
  // room for this one) is announced after the line is whole, and the block read before it
  let got = stockTake(g, cs, want, slotsOf(ln), false);
  if got == 0u32 {
    let t = takesAt(tc, c);
    *t = *t - 1u64;
    roomAnnounce(g);
    return null;
  }
  (*ln).count = got - 1u32;
  bufCache.emit(0u64, (*tc).misses, u64.from(tc as usize), cacheHeld(tc));
  let b = *(slotsOf(ln) + usize.from(got - 1u32));
  roomAnnounce(g);
  b
}

// Block b of class c comes home
fn blockPut(c: usize, b: *u8) {
  let tc = threadCache();
  let r = returnsAt(tc, c);
  *r = *r + 1u64;
  let ln = lineAt(tc, c);
  if (*ln).count >= (*ln).cap {
    if tc == (*glob()).lateRec {
      lateReturn(glob(), c, b);
      return;
    }
    spill(tc, c, ln);
    if (*ln).cap == 0u32 {
      // no cache: the block goes straight to the stock
      let e = slotsOf(ln);
      *e = b;
      stockPut(glob(), classAt(glob(), c), e, 1u32, true);
      return;
    }
    // the spill's room is announced once the block is in the line: a wake that returns blocks
    // must find the line whole
    *(slotsOf(ln) + usize.from((*ln).count)) = b;
    (*ln).count = (*ln).count + 1u32;
    roomAnnounce(glob());
    return;
  }
  *(slotsOf(ln) + usize.from((*ln).count)) = b;
  (*ln).count = (*ln).count + 1u32;
}

// The cache is full: its oldest batch back to the stock, the rest moved down
fn spill(tc: *ThreadCache, c: usize, ln: *CacheLine) {
  let n = (*ln).count;
  if n == 0u32 {
    return;
  }
  let g = glob();
  let cs = classAt(g, c);
  let k = if (*cs).batch < n {(*cs).batch} else {n};
  stockPut(g, cs, slotsOf(ln), k, false);     // announced by blockPut, after the line is whole
  mem.moveRaw[*u8](slotsOf(ln), slotsOf(ln) + usize.from(k), usize.from(n - k));
  (*ln).count = n - k;
  bufCache.emit(0u64, (*tc).misses, u64.from(tc as usize), cacheHeld(tc));
}

// All of this thread's cache back to the stock, and its record retired for
// the next thread: early, before the thread ends, which does the same itself
// (THREADS)
pub fn flushThread() {
  let tc = myCache;
  if tc as usize == 0usize || tc == (*glob()).lateRec {
    return;
  }
  let g = glob();
  (*g).regLock.lock();       // under the lock, as a thread's end is, so that the final's flush cannot empty these lines too
  flushCache(tc, false);
  (*tc).live = 0u32;
  (*tc).nextFree = (*g).freeRecs;
  (*g).freeRecs = tc;
  (*g).regLock.unlock();
  myCache = null;
  roomAnnounce(g);
}

// A test-only hook: f is called by decommitSlab (the bound's limit path) after it has taken a slab's
// idle blocks off the free list and marked them, and before it decommits them, with the class's lock
// held, so a test can hold the decommitter there while another thread tries to take from the class.
// No program sets it
pub fn setDecommitHook(f: &fn()) {
  var held = f;
  (*glob()).decommitHook = mem.readRaw[usize](&mut held as *usize);
}

fn runDecommitHook(g: *Globals) {
  var p = (*g).decommitHook;
  if p != 0usize {
    let hook = mem.readRaw[&fn()](&mut p as *(&fn()));
    hook();
  }
}

// A test-only consistency walk of every slab, under each class's lock: the free list, the decommit
// bitmap and the counts agree (every carved block is lent or cached, on the free list or decommitted;
// a block on the free list is not marked; the marks are the count; the committed part is a whole number
// of chunks that covers the carved blocks; a slab is listed while it has something to give), and, when the
// pool is quiet, the bytes the slabs hold (committed, less decommitted) and the oversize blocks' are what
// 'held' and osBytes() say. Answers the number of disagreements found: 0 is a sound stock
pub fn checkSlabs() u64 {
  let g = glob();
  var faults = 0u64;
  var bytes = 0u64;
  var c = 0usize;
  while c < (*g).nClasses {
    let cs = classAt(g, c);
    let bs = (*cs).blockSize;
    (*cs).lock.lock();
    var idle = 0usize;
    var s = (*cs).all;
    while s as usize != 0usize {
      let carved = usize.from((*s).carved);
      var free = 0usize;
      var b = (*s).freeHead;
      while b as usize != 0usize && free <= carved {
        free = free + 1usize;
        let i = ((b as usize) - ((*s).base as usize)) / bs;
        if slabOf(b) != s || i >= carved || (bs >= page && bitTest(s, i)) {faults = faults + 1u64;}
        b = linkNext(b);
      }
      var marked = 0usize;
      var i = 0usize;
      while i < 512usize {
        if bitTest(s, i) {
          marked = marked + 1usize;
          if i >= carved {faults = faults + 1u64;}
        }
        i = i + 1usize;
      }
      if marked != usize.from((*s).decommitted) {faults = faults + 1u64;}
      if free + marked + usize.from((*s).used) != carved {faults = faults + 1u64;}
      let ce = usize.from((*s).commitEnd);
      if ce < carved * bs || ce > slabBytes || ce % commitChunk != 0usize {faults = faults + 1u64;}
      if ((*s).listed != 0u32) != ((*s).used < (*s).total) {faults = faults + 1u64;}
      idle = idle + free;
      bytes = bytes + u64.from(ce - marked * bs);
      s = (*s).nextA;
    }
    if idle != (*cs).idleBlocks {faults = faults + 1u64;}
    (*cs).lock.unlock();
    c = c + 1usize;
  }
  bytes = bytes + (*g).bigBytes.load();
  if bytes != (*g).held.load() || bytes != liveBytes.load() {faults = faults + 1u64;}
  faults
}

// A test-only hook, a slow-path field (never read by a take or a return): f is
// called by every flushCache (a thread's end, flushThread, trimStock,
// trimEverything), on the flushing thread, after it has read a line's count and
// before it empties the line, so a test can hold a dying thread there while
// another thread trims. f does nothing on a thread the test did not mean (the
// test marks its own thread). No program sets it
pub fn setFlushHook(f: &fn()) {
  var held = f;    // kept as an address: a borrowed reference cannot be stored in a global's field
  (*glob()).flushHook = mem.readRaw[usize](&mut held as *usize);
}

// The test-only park point, called with the line's count read and not yet emptied
fn runFlushHook(g: *Globals) {
  var p = (*g).flushHook;
  if p != 0usize {
    let hook = mem.readRaw[&fn()](&mut p as *(&fn()));
    hook();
  }
}

// Every block of tc's lines back to the stock. 'fire' says whether each batch's room
// event is made here; a caller that holds the registry's lock passes false and
// makes the event itself, after it unlocks
fn flushCache(tc: *ThreadCache, fire: bool) {
  let g = glob();
  var c = 0usize;
  while c < maxClasses {
    let ln = lineAt(tc, c);
    let n = (*ln).count;
    if n != 0u32 {
      runFlushHook(g);    // test-only park point: n is read, the line is not yet emptied
      (*ln).count = 0u32;
      stockPut(g, classAt(g, c), slotsOf(ln), n, fire);
    }
    c = c + 1usize;
  }
}

// ---------------------------------------------------------------------------
// The central stock
// ---------------------------------------------------------------------------

// Up to want blocks of class c, written to dest; at least one, or 0 when the
// bound or the OS refuses a slab
fn stockTake(g: *Globals, cs: *ClassState, want: u32, dest: **u8, fire: bool) u32 {
  var ctx = TakeCtx(0u64, 0u64, 0u32);
  let cx = &mut ctx as *TakeCtx;
  var got = 0u32;
  while true {
    (*cx).need = 0u64;
    (*cs).lock.lock();
    got = takeLocked(g, cs, want, dest, cx);
    (*cs).lock.unlock();
    if got > 0u32 || (*cx).failed != 0u32 {
      break;
    }
    if (*cx).need != 0u64 {
      // A slab of the class has blocks to give but the bound would not count the bytes they need (a
      // commit chunk to carve, a decommitted block to bring back): make room for them, outside the
      // lock, as a new slab would, and take again with the bytes counted
      if (*cx).need > (*cx).credit {
        if !reserveRoom(g, usize.from((*cx).need - (*cx).credit), limitOf(g, cs), fire) {
          break;
        }
        (*cx).credit = (*cx).need;
      }
    } else if !newSlab(g, cs, fire) {
      break;
    }
  }
  if (*cx).credit != 0u64 {         // counted and not spent: given back
    (*g).held.sub((*cx).credit);
    if fire {roomEvent(g);} else {noteRoom();}
  }
  got
}

// Under the lock: pop blocks from the slabs that have them, in each slab's order: the free list of
// committed blocks, the bump mark (carving: the next commit chunk is counted and committed when the
// mark leaves the committed part), then a decommitted block of the slab; a slab that cannot give
// because the bound or the OS refuses the bytes it needs is passed over to the next
fn takeLocked(g: *Globals, cs: *ClassState, want: u32, dest: **u8, cx: *TakeCtx) u32 {
  var got = 0u32;
  var s = (*cs).partial;
  while got < want && s as usize != 0usize {
    let nextS = (*s).nextP;
    got = takeFrom(g, cs, s, want, dest, got, cx);
    if (*s).used == (*s).total {
      unlistPartial(cs, s);
    }
    s = nextS;
  }
  got
}

// Bytes to be counted into 'held' for a commit under the lock: spent from the take's credit, or reserved
// (never reserveRoom: no making room under a class lock). False when the bound refuses
fn payFor(g: *Globals, cs: *ClassState, bytes: usize, cx: *TakeCtx) bool {
  let n = u64.from(bytes);
  if (*cx).credit >= n {
    (*cx).credit = (*cx).credit - n;
    return true;
  }
  reserve(g, bytes, limitOf(g, cs))
}

fn noteNeed(cx: *TakeCtx, bytes: usize) {
  let n = u64.from(bytes);
  if (*cx).need == 0u64 || n < (*cx).need {(*cx).need = n;}
}

// Bytes paid for a commit the OS then refused: kept as credit, which the take gives back at its end
fn refundTo(cx: *TakeCtx, bytes: usize) {
  (*cx).credit = (*cx).credit + u64.from(bytes);
  (*cx).failed = 1u32;
}

// Under the lock: from slab s, blocks into dest[start..want]; the count then in dest
fn takeFrom(g: *Globals, cs: *ClassState, s: *SlabRec, want: u32, dest: **u8, start: u32, cx: *TakeCtx) u32 {
  var got = start;
  var more = true;
  while got < want && more {
    let h = (*s).freeHead;
    if h as usize != 0usize {
      (*s).freeHead = linkNext(h);
      (*cs).idleBlocks = (*cs).idleBlocks - 1usize;
      *(dest + usize.from(got)) = h;
      (*s).used = (*s).used + 1u32;
      got = got + 1u32;
    } else {
      var c = null as *u8;
      if (*s).carved < (*s).total {c = carveOne(g, cs, s, cx);}
      if c as usize != 0usize {
        *(dest + usize.from(got)) = c;
        (*s).used = (*s).used + 1u32;
        got = got + 1u32;
      } else if (*s).decommitted > 0u32 {
        let n = recommitRun(g, cs, s, want - got, dest + usize.from(got), cx);
        (*s).used = (*s).used + n;
        got = got + n;
        if n == 0u32 {more = false;}
      } else {
        more = false;
      }
    }
  }
  got
}

// Under the lock: the slab's next never-carved block, its bytes committed (and counted) if the mark
// leaves the committed part, one commit chunk at a time; null when the bound or the OS refuses them
fn carveOne(g: *Globals, cs: *ClassState, s: *SlabRec, cx: *TakeCtx) *u8 {
  let at = usize.from((*s).carved) * (*cs).blockSize;
  let end = at + (*cs).blockSize;
  let have = usize.from((*s).commitEnd);
  if end > have {
    let ext = chunkCeil(end) - have;
    if !payFor(g, cs, ext, cx) {
      noteNeed(cx, ext);
      return null;
    }
    if !osExtend((*s).base + have, ext) {
      refundTo(cx, ext);
      return null;
    }
    (*s).commitEnd = u32.from(have + ext);
  }
  (*s).carved = (*s).carved + 1u32;
  (*s).base + at
}

// Under the lock: up to maxN decommitted blocks of the slab, adjacent ones in one call, brought back and
// written to dest; the bytes are counted first, a refusal of the run falls back to one block. Answers the count
fn recommitRun(g: *Globals, cs: *ClassState, s: *SlabRec, maxN: u32, dest: **u8, cx: *TakeCtx) u32 {
  let bs = (*cs).blockSize;
  let carved = usize.from((*s).carved);
  var i = 0usize;
  while i < carved && !bitTest(s, i) {i = i + 1usize;}
  if i >= carved {return 0u32;}
  var r = 1usize;
  while r < usize.from(maxN) && i + r < carved && bitTest(s, i + r) {r = r + 1usize;}
  if !payFor(g, cs, r * bs, cx) {
    r = 1usize;
    if !payFor(g, cs, bs, cx) {
      noteNeed(cx, bs);
      return 0u32;
    }
  }
  if !osRecommit((*s).base + i * bs, r * bs) {
    refundTo(cx, r * bs);
    return 0u32;
  }
  var k = 0usize;
  while k < r {
    bitClear(s, i + k);
    *(dest + k) = (*s).base + (i + k) * bs;
    k = k + 1usize;
  }
  (*s).decommitted = (*s).decommitted - u32.from(r);
  u32.from(r)
}

// A commit chunk, and a size rounded up to whole chunks
const commitChunk = 65536usize;

fn chunkCeil(n: usize) usize {
  (n + commitChunk - 1usize) & (0usize - commitChunk)
}

fn unlistPartial(cs: *ClassState, s: *SlabRec) {
  let p = (*s).prevP;
  let n = (*s).nextP;
  if p as usize != 0usize {(*p).nextP = n;} else {(*cs).partial = n;}
  if n as usize != 0usize {(*n).prevP = p;} else {(*cs).partialTail = p;}
  (*s).nextP = null;
  (*s).prevP = null;
  (*s).listed = 0u32;
}

fn listPartial(cs: *ClassState, s: *SlabRec) {
  (*s).nextP = null;
  (*s).prevP = (*cs).partialTail;
  if (*cs).partialTail as usize != 0usize {
    (*(*cs).partialTail).nextP = s;
  } else {
    (*cs).partial = s;
  }
  (*cs).partialTail = s;
  (*s).listed = 1u32;
}

// The n blocks at src come home to the stock, each to the slab its address
// leads to; then idle slabs beyond the bound on idle bytes go back to the OS
//
// Only the class is checked, not that the block is out: a block released twice goes on the free
// list twice and is then given to two takers. Safe code cannot do it: a block has one owner (a
// List, a String, a buffer) that releases it once when it dies, and the entry points that release
// (the region's 'release' and the pool's own: blockPut, releaseOversize and poolRelease, all private)
// take a raw pointer, which is trusted. A caller that returns a block twice breaks the header's rule "a block is returned once".
//
// Room is made, so the room event is made after the lock is released ('fire'; a caller that holds
// the registry's lock passes false)
fn stockPut(g: *Globals, cs: *ClassState, src: **u8, n: u32, fire: bool) {
  (*cs).lock.lock();
  var i = 0usize;
  let count = usize.from(n);
  while i < count {
    let b = *(src + i);
    let s = slabOf(b);
    if (*s).cls != (*cs).index {
      panic("bufpool: a block was returned to a class it did not come from, or is not the pool's");
    }
    setNext(b, (*s).freeHead);
    (*s).freeHead = b;
    (*s).used = (*s).used - 1u32;
    if (*s).listed == 0u32 {
      listPartial(cs, s);
    }
    i = i + 1usize;
  }
  (*cs).idleBlocks = (*cs).idleBlocks + count;
  var doomed = null as *SlabRec;
  let keep = (*g).keepBytes.load();
  if idleBytes(g) > keep {
    doomed = reclaim(g, cs, keep);
  }
  (*cs).lock.unlock();
  if fire {roomEvent(g);} else {noteRoom();}
  freeSlabs(g, doomed, fire);
}

// Total bytes idle in the stock, every class. The other classes' counts are
// read without their locks: a hint
fn idleBytes(g: *Globals) u64 {
  var total = 0u64;
  var c = 0usize;
  let n = (*g).nClasses;
  while c < n {
    let cs = classAt(g, c);
    total = total + u64.from((*cs).idleBlocks * (*cs).blockSize);
    c = c + 1usize;
  }
  total
}

// Under the lock: unlink the wholly idle slabs of cs that can go while the
// stock still keeps 'keep' idle bytes (keep 0: every one). A list linked by
// nextA, for freeSlabs
fn reclaim(g: *Globals, cs: *ClassState, keep: u64) *SlabRec {
  var doomed = null as *SlabRec;
  var idle = idleBytes(g);
  var s = (*cs).all;
  while s as usize != 0usize {
    let next = (*s).nextA;
    if (*s).used == 0u32 {
      let idleHere = usize.from((*s).carved - (*s).decommitted);    // its free list: the decommitted blocks hold no bytes
      let own = u64.from(idleHere * (*cs).blockSize);
      if idle >= keep + own {
        if (*s).listed != 0u32 {unlistPartial(cs, s);}
        let p = (*s).prevA;
        if p as usize != 0usize {(*p).nextA = next;} else {(*cs).all = next;}
        if next as usize != 0usize {(*next).prevA = p;}
        (*cs).slabs = (*cs).slabs - 1usize;
        (*cs).idleBlocks = (*cs).idleBlocks - idleHere;
        idle = idle - own;
        (*s).nextA = doomed;
        (*s).prevA = null;
        doomed = s;
      }
    }
    s = next;
  }
  doomed
}

// Outside any lock: give slabs, unlinked by reclaim, back to the OS (a slab's
// record is in the memory that goes, so what is wanted of it is read first)
fn freeSlabs(g: *Globals, head: *SlabRec, fire: bool) {
  if head as usize == 0usize {return;}
  var s = head;
  while s as usize != 0usize {
    let next = (*s).nextA;
    let osBase = (*s).osBase;
    // the bytes it holds: its committed part less its decommitted blocks
    let committed = usize.from((*s).commitEnd) - usize.from((*s).decommitted) * (*classAt(g, usize.from((*s).cls))).blockSize;
    osFreeSlab(osBase, committed);
    (*g).held.sub(u64.from(committed));
    (*g).osFrees.add(1u64);
    s = next;
  }
  if fire {roomEvent(g);} else {noteRoom();}     // 'held' is lower
}

// ---------------------------------------------------------------------------
// The OS, and the bound
// ---------------------------------------------------------------------------

// Count size bytes against a bound on the bytes held; whether it holds
//
// A refusal leaves 'held' as it was: it is read and then raised by a compare-and-swap, never raised
// and lowered again, because a caller that fails a concurrent caller's reserve by a count that goes
// away a moment later would be refused with room in hand and no event to wake it (ROOM WAKE)
fn reserve(g: *Globals, size: usize, limit: u64) bool {
  let n = u64.from(size);
  var cur = (*g).held.load();
  while true {
    if cur + n > limit {
      return false;
    }
    let seen, ok = (*g).held.compareSwap(cur, cur + n);
    if ok {
      return true;
    }
    cur = seen;
  }
  false
}

// Count size bytes against a bound, making room if need be: every wholly
// idle slab of every class back to the OS, then this thread's cache
fn reserveRoom(g: *Globals, size: usize, limit: u64, fire: bool) bool {
  if reserve(g, size, limit) {return true;}
  trimStockOf(g, fire);
  if reserve(g, size, limit) {return true;}
  let tc = myCache;
  if tc as usize != 0usize {flushCache(tc, fire);}
  trimStockOf(g, fire);
  if reserve(g, size, limit) {return true;}
  decommitForRoom(g, size, limit, fire)
}

// The limit path's last recovery. The idle blocks of slabs that still have a block lent or cached
// are bytes the bound counts and nothing uses, and no slab of them can go back whole. So here they go
// back page by page: the idle blocks of a class (the class holding the most idle bytes first, then the
// next, and in a class one slab at a time) are taken off their free lists, marked in their slab's
// bitmap and decommitted, and their bytes leave 'held'. It stops as soon as the bytes fit, so one
// refusal does not strip every class. Nothing is kept: at the limit the keep bound does not apply.
// Either bank's idle blocks serve: the plain bank's lowers 'held' for the try bank's mark too
fn decommitForRoom(g: *Globals, size: usize, limit: u64, fire: bool) bool {
  let n = (*g).nClasses;
  var visited = 0u32;
  var freed = 0usize;
  var ok = false;
  while !ok {
    var best = n;
    var bestBytes = 0usize;
    var c = 0usize;
    while c < n {
      let cs = classAt(g, c);
      let bytes = (*cs).idleBlocks * (*cs).blockSize;     // a hint, read without the lock
      if (visited & (1u32 << u32.from(c))) == 0u32 && (*cs).blockSize >= page && bytes > bestBytes {
        best = c;
        bestBytes = bytes;
      }
      c = c + 1usize;
    }
    if best == n {break;}
    visited = visited | (1u32 << u32.from(best));
    let cs = classAt(g, best);
    (*cs).lock.lock();
    var s = (*cs).partial;
    while s as usize != 0usize && !fits(g, size, limit) {
      if (*s).freeHead as usize != 0usize {freed = freed + decommitSlab(g, cs, s);}
      s = (*s).nextP;
    }
    (*cs).lock.unlock();
    ok = reserve(g, size, limit);
  }
  if freed != 0usize {
    if fire {roomEvent(g);} else {noteRoom();}     // 'held' is lower
  }
  ok
}

// Whether size more bytes would fit now (a read, not a reservation)
fn fits(g: *Globals, size: usize, limit: u64) bool {
  (*g).held.load() + u64.from(size) <= limit
}

// Under the class lock: every block on slab s's free list decommitted. Each is unlinked (a free block's
// link lives in the block itself, which is about to go) and marked in the bitmap, 'decommitted' counts
// it, and its bytes leave 'held' and osBytes(). Adjacent decommitted blocks go in one call. THE LOCK IS
// HELD ACROSS THE CALLS, on purpose: were it dropped between marking a block and decommitting it, a take
// could bring the marked block back (recommit) and hand it out, and the late decommit would then take its
// memory from under its new holder. The path is the bound's only, so a system call under the lock costs
// nothing that matters. Answers the bytes given back
fn decommitSlab(g: *Globals, cs: *ClassState, s: *SlabRec) usize {
  let bs = (*cs).blockSize;
  let base = (*s).base;
  var n = 0usize;
  var b = (*s).freeHead;
  while b as usize != 0usize {
    let next = linkNext(b);
    let i = ((b as usize) - (base as usize)) / bs;
    bitSet(s, i);
    freshSet(s, i);
    n = n + 1usize;
    b = next;
  }
  (*s).freeHead = null;
  (*cs).idleBlocks = (*cs).idleBlocks - n;
  (*s).decommitted = (*s).decommitted + u32.from(n);
  let carved = usize.from((*s).carved);
  var i = 0usize;
  while i < carved {
    if bitTest(s, i) {
      var j = i;
      var any = false;
      while j < carved && bitTest(s, j) {
        if freshTest(s, j) {any = true; freshClear(s, j);}
        j = j + 1usize;
      }
      if any {
        runDecommitHook(g);     // test-only park point: the run is marked, not yet decommitted, the lock held
        osDecommit(base + i * bs, (j - i) * bs);
      }
      i = j;
    } else {
      i = i + 1usize;
    }
  }
  (*g).held.sub(u64.from(n * bs));
  n * bs
}

// The bytes held, both banks together, that the try bank grows to: maxBytes less
// the reserve, a quarter of maxBytes, at least five slabs (one for each of the
// five size classes the program's own constructions may need), at most half
fn tryMark(g: *Globals) u64 {
  let max = usize.from((*g).maxBytes.load());
  var r = max / 4usize;
  if r < 5usize * slabBytes {r = 5usize * slabBytes;}
  if r > max / 2usize {r = max / 2usize;}
  u64.from(max - r)
}

// The bound a class's new slab is counted against: its bank's
fn limitOf(g: *Globals, cs: *ClassState) u64 {
  if (*cs).index >= classCount {tryMark(g)} else {(*g).maxBytes.load()}
}

// A new slab for class cs, got from the OS and listed; false when the bound or
// the OS refuses it
fn newSlab(g: *Globals, cs: *ClassState, fire: bool) bool {
  // Only what the first take can carve is counted and committed: one commit chunk (a block larger than
  // a chunk is its own first chunk); carving commits and counts the rest as it goes
  let first = chunkCeil((*cs).blockSize);
  if !reserveRoom(g, first, limitOf(g, cs), fire) {
    return false;
  }
  var base = null as *u8;
  var osBase = null as *u8;
  base, osBase = osAllocSlab(first);
  if base as usize == 0usize {
    (*g).held.sub(u64.from(first));
    return false;
  }
  (*g).osAllocs.add(1u64);
  let s = (base - page) as *SlabRec;     // its header, committed and zeroed by the OS
  (*s).commitEnd = u32.from(first);
  (*s).base = base;
  (*s).osBase = osBase;
  (*s).cls = (*cs).index;
  (*s).home = (*cs).index;
  (*s).total = (*cs).perSlab;
  (*cs).lock.lock();
  (*s).nextA = (*cs).all;
  if (*cs).all as usize != 0usize {(*(*cs).all).prevA = s;}
  (*cs).all = s;
  (*cs).slabs = (*cs).slabs + 1usize;
  listPartial(cs, s);
  (*cs).lock.unlock();
  true
}

// Every wholly idle slab of every class back to the OS
fn trimStockOf(g: *Globals, fire: bool) {
  var c = 0usize;
  let n = (*g).nClasses;
  while c < n {
    let cs = classAt(g, c);
    (*cs).lock.lock();
    let doomed = reclaim(g, cs, 0u64);
    (*cs).lock.unlock();
    freeSlabs(g, doomed, fire);
    c = c + 1usize;
  }
}

// This thread's cache back to the stock, and every wholly idle slab to the OS
pub fn trimStock() {
  let tc = myCache;
  if tc as usize != 0usize {flushCache(tc, true);}
  trimStockOf(glob(), true);
}

// Every thread's cache back to the stock, and every wholly idle slab to the
// OS. A cache is emptied only by its own thread (or by that thread's end, which
// runs under the registry's lock), so this is for when every other thread has
// ended or called flushThread: if another record is live it panics, naming the
// cause, where flushing it would hand a block out twice. Under the lock, which
// every path that makes a record live or retires it also takes, the check holds
// for the whole walk. A leak check does not need it: stats().lent counts a block
// in a cache as home (trimStock is the call for idle slabs)
pub fn trimEverything() {
  let g = glob();
  let me = myCache;
  (*g).regLock.lock();
  var tc = (*g).regHead;
  while tc as usize != 0usize {
    if tc != me && (*tc).live != 0u32 {
      (*g).regLock.unlock();
      panic("bufpool: trimEverything while another thread holds a cache; use trimStock, or end the thread first (or have it call flushThread)");
    }
    tc = (*tc).nextReg;
  }
  flushRegistry(g);
  (*g).regLock.unlock();
  roomAnnounce(g);
  trimStockOf(g, true);
}

// Every record on the registry flushed, with the registry's lock held
fn flushRegistry(g: *Globals) {
  var tc = (*g).regHead;
  while tc as usize != 0usize {
    flushCache(tc, false);
    tc = (*tc).nextReg;
  }
}

// The module's final: the caller's cache and every ended thread's flushed, and the
// idle slabs back to the OS. A thread still running (an iocore worker, any
// detached thread) may be taking from its cache this moment, so its record is
// left alone: flushing it would hand a block out twice. Its blocks go back to the
// OS with the process, and its slabs stay (a cached block is lent to the stock)
fn trimAllCachesFinal() {
  let g = glob();
  let me = myCache;
  (*g).regLock.lock();
  var tc = (*g).regHead;
  while tc as usize != 0usize {
    if tc == me || (*tc).live == 0u32 {
      flushCache(tc, false);
    }
    tc = (*tc).nextReg;
  }
  (*g).regLock.unlock();
  trimStockOf(g, true);
}

// Oversize blocks, which are not pooled: a block of size bytes of its own,
// counted against the bound, or null when the bound or the OS refuses it
fn holdOversize(size: usize) *u8 {
  let g = glob();
  holdOversizeWithin(g, size, (*g).maxBytes.load())
}

// The same, counted against 'limit' bytes held
fn holdOversizeWithin(g: *Globals, size: usize, limit: u64) *u8 {
  if !reserveRoom(g, size, limit, true) {
    return null;
  }
  let b = osAlloc(size);
  if b as usize == 0usize {
    (*g).held.sub(u64.from(size));
    return null;
  }
  (*g).osAllocs.add(1u64);
  (*g).bigLent.add(1u64);
  (*g).bigBytes.add(u64.from(size));
  (*g).bigTakes.add(1u64);
  b
}

fn releaseOversize(b: *u8, size: usize) {
  let g = glob();
  osFree(b, size);
  (*g).held.sub(u64.from(size));
  (*g).osFrees.add(1u64);
  (*g).bigLent.sub(1u64);
  (*g).bigBytes.sub(u64.from(size));
  roomEvent(g);
}

// ---------------------------------------------------------------------------
// Counters
// ---------------------------------------------------------------------------

pub struct BlockStats {
  pub maxBytes: usize;
  pub keepBytes: usize;
  pub heldBytes: usize;     // the committed bytes of slabs, and oversize blocks, from the OS
  pub lentBytes: usize;     // blocks out of the cache and stock, and oversize blocks
  pub cachedBytes: usize;   // idle in threads' caches
  pub idleBytes: usize;     // held and not lent: cached, idle in the stock, and carved into a commit chunk but not yet taken
  pub stockBytes: usize;    // idle in the stock, carved and returned: committed (a decommitted block is not counted)
  pub lent: u64;            // blocks lent now (oversize too)
  pub takes: u64;           // blocks ever lent
  pub reuses: u64;          // takes served by the thread's own cache
  pub osAllocs: u64;        // slabs and oversize blocks got from the OS
  pub osFrees: u64;         // and given back
  pub slabs: usize;         // slabs held
  pub threads: usize;       // thread caches on the registry
  pub refused: u64;         // takes tryAllocate refused
}

pub fn blockStats() BlockStats {
  let g = glob();
  var takes = 0u64;
  var misses = 0u64;
  var lentBytes = 0usize;
  var lent = 0u64;
  var cachedBytes = 0usize;
  var stockBytes = 0usize;
  var slabs = 0usize;
  var threads = 0usize;
  (*g).regLock.lock();
  var c = 0usize;
  let n = (*g).nClasses;
  while c < n {
    let cs = classAt(g, c);
    var t = 0u64;
    var r = 0u64;
    var cached = 0usize;
    var tc = (*g).regHead;
    while tc as usize != 0usize {
      t = t + *takesAt(tc, c);
      r = r + *returnsAt(tc, c);
      cached = cached + usize.from((*lineAt(tc, c)).count);
      tc = (*tc).nextReg;
    }
    t = t + (*cs).lateTakes.load();
    r = r + (*cs).lateReturns.load();
    takes = takes + t;
    let out = if t > r {t - r} else {0u64};
    lent = lent + out;
    lentBytes = lentBytes + usize.from(out) * (*cs).blockSize;
    cachedBytes = cachedBytes + cached * (*cs).blockSize;
    stockBytes = stockBytes + (*cs).idleBlocks * (*cs).blockSize;
    slabs = slabs + (*cs).slabs;
    c = c + 1usize;
  }
  var tc = (*g).regHead;
  while tc as usize != 0usize {
    misses = misses + (*tc).misses;
    threads = threads + 1usize;
    tc = (*tc).nextReg;
  }
  (*g).regLock.unlock();
  let held = usize.from((*g).held.load());
  let bigBytes = usize.from((*g).bigBytes.load());
  let bigLent = (*g).bigLent.load();
  let bigTakes = (*g).bigTakes.load();
  misses = misses + bigTakes;     // each took the OS
  lent = lent + bigLent;
  lentBytes = lentBytes + bigBytes;
  takes = takes + bigTakes;
  BlockStats(usize.from((*g).maxBytes.load()), usize.from((*g).keepBytes.load()), held, lentBytes,
    cachedBytes, if held > lentBytes {held - lentBytes} else {0usize}, stockBytes, lent, takes,
    if takes > misses {takes - misses} else {0u64}, (*g).osAllocs.load(), (*g).osFrees.load(),
    slabs, threads, (*g).refused.load())
}

// ---------------------------------------------------------------------------
// The region: the five classes, and MemRegion's four functions over them
// ---------------------------------------------------------------------------

// The classes, 4 KiB to 1 MiB, each four times the last; a larger request is
// 'oversize', a block of its own
pub const classCount = 5u32;
pub const largestClass = 1048576usize;

pub fn classSize(c: u32) usize {
  if c == 0u32 {4096usize}
  else if c == 1u32 {16384usize}
  else if c == 2u32 {65536usize}
  else if c == 3u32 {262144usize}
  else {1048576usize}
}

// How many idle blocks of each class a thread keeps
fn cacheBlocksFor(c: u32) u32 {
  if c == 0u32 {32u32}
  else if c == 1u32 {2u32}
  else if c == 2u32 {2u32}
  else if c == 3u32 {1u32}
  else {0u32}
}

// The class a request of size bytes is served from, or classCount for oversize
fn classFor(size: usize) usize {
  var c = 0u32;
  while c < classCount {
    if size <= classSize(c) {return usize.from(c);}
    c = c + 1u32;
  }
  usize.from(classCount)
}

// size rounded up to whole pages
fn pageCeil(size: usize) usize {
  (size + page - 1usize) & (0usize - page)
}

// The region: one object for the process, made by init (a global may be
// initialised only by a literal, and these are function addresses)
let poolRegion: MemRegion;

// The buffer pool region, for any construction that takes one: 'List[u8](3000,
// bufferPool())'. A block it gives is page-aligned; its size function answers
// the class's size
pub fn bufferPool() *MemRegion {&poolRegion as *MemRegion}

fn poolAlloc(r: *MemRegion, bytes: usize, align: usize) *u8 {
  if align > page {
    panic("bufpool: the buffer pool aligns blocks to a page; a larger alignment is not served");
  }
  let c = classFor(bytes);
  if c == usize.from(classCount) {
    return holdOversize(pageCeil(bytes));
  }
  blockTake(c)
}

// The block 'bufferPool().allocate(bytes, page)' gives, but taken from the try
// bank (THE BANKS) and one the pool may REFUSE (null): a free block of the bank
// is always given; a new slab or an oversize block only while the bytes held
// stay within maxBytes less the reserve. For the blocks a peer's bytes cause, so
// that no flood can leave the constructions a program makes on its own account
// (plain, which panic past maxBytes) without room. Release it as any block
pub fn tryAllocate(bytes: usize) *u8 {
  let g = glob();
  let c = classFor(bytes);
  var b = null as *u8;
  if c == usize.from(classCount) {
    b = holdOversizeWithin(g, pageCeil(bytes), tryMark(g));
  } else {
    b = blockTake(c + usize.from(classCount));
  }
  if b as usize == 0usize {(*g).refused.add(1u64);}
  b
}

// A block goes home to the bank it came from: its slab's 'home' says which, and
// is checked against the size it is released with
fn poolRelease(r: *MemRegion, block: *u8, bytes: usize) {
  if block as usize == 0usize {return;}
  let c = classFor(bytes);
  if c == usize.from(classCount) {
    releaseOversize(block, pageCeil(bytes));
  } else {
    let home = usize.from((*slabOf(block)).home);
    if home % usize.from(classCount) != c {
      panic("bufpool: a block was released with a size of another class than it came from");
    }
    blockPut(home, block);
  }
}

// A block of the same class stays where it is, in its own bank. Moving to
// another class takes a block of the PLAIN bank (a resize is the holder's own
// account, not a tryAllocate) and sends the old one home to its own bank
// through poolRelease, which reads its slab: no block crosses banks
fn poolResize(r: *MemRegion, block: *u8, oldBytes: usize, newBytes: usize, align: usize) *u8 {
  if block as usize == 0usize {
    return poolAlloc(r, newBytes, align);
  }
  let co = classFor(oldBytes);
  let cn = classFor(newBytes);
  if co == cn && (co != usize.from(classCount) || pageCeil(oldBytes) == pageCeil(newBytes)) {
    return block;
  }
  let fresh = poolAlloc(r, newBytes, align);
  if fresh as usize == 0usize {return null;}
  libc.memcpy(fresh, block, if oldBytes < newBytes {oldBytes} else {newBytes});
  poolRelease(r, block, oldBytes);
  fresh
}

fn poolSize(r: *MemRegion, bytes: usize, align: usize) usize {
  let c = classFor(bytes);
  if c == usize.from(classCount) {pageCeil(bytes)} else {classSize(u32.from(c))}
}

fn @initpure init() {
  bufReserve = Kind4[u64, u64, u64, u64].make("bufpool.reserve", "memory", Level.Debug, "elem", "n", "inst", "aux");
  bufCommit = Kind4[u64, u64, u64, u64].make("bufpool.commit", "memory", Level.Debug, "elem", "n", "inst", "aux");
  bufRelease = Kind4[u64, u64, u64, u64].make("bufpool.release", "memory", Level.Debug, "elem", "n", "inst", "aux");
  bufCache = Kind4[u64, u64, u64, u64].make("bufpool.cache", "memory", Level.Trace, "elem", "n", "inst", "aux");
  liveBlocks = Atomic[u64].of(0u64);
  liveBytes = Atomic[u64].of(0u64);
  gAddr = Atomic[usize].of(0usize);
  blocksInit();
  var bank = 0u32;
  while bank < 2u32 {       // the plain bank, classes 0 to 4; the try bank, 5 to 9
    var c = 0u32;
    while c < classCount {
      registerClass(classSize(c), cacheBlocksFor(c));
      c = c + 1u32;
    }
    bank = bank + 1u32;
  }
  poolRegion = MemRegion(&poolAlloc, &poolResize, &poolRelease, &poolSize);
  (*glob()).exitId = cone_threadExitAdd(&bufpoolThreadEnded);
}

// The pool's end: every cache flushed and every slab with all its blocks home
// given back to the OS. After every module that uses the pool has finalized, no
// block is lent; one still lent (a leak) keeps its slab, which 'osBlocks()' would
// show. From here on a thread that ends gives nothing back ('stopping'). The
// stock itself is never freed, so a block returned later still has a home
fn final() {
  let g = glob();
  (*g).regLock.lock();
  (*g).stopping.store(1u32);
  (*g).regLock.unlock();
  trimAllCachesFinal();
}
