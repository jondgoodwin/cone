// How fast the decoders are. Give it picture files (PNG or JPEG) as
// arguments; it decodes each a few times and prints the best time and the
// speed, as megabytes a second of decoded RGBA and of file. Run it in release
// mode:
//
//   congo run --release packages/imagedecode/examples/bench.cone big.png big.jpg
//
// With no arguments it makes a 2048 x 2048 picture (a smooth landscape of
// noise-free curves with a speckle), compresses it with this package's own
// PNG writer and prints the PNG decode speed alone.

mod bench;

import collections use *;
import imagedecode use *;
import time use *;
import fs;
import path use Path;
import process;
import stdio use *;

fn report(name &str, fileBytes usize, r &Raster, best i64) {
  imm outBytes = usize.from(r.width) * usize.from(r.height) * 4usize;
  printStr(name);
  printStr(": ");
  printInt(i64.from(r.width));
  printStr(" x ");
  printInt(i64.from(r.height));
  printStr(", file ");
  printInt(i64.from(fileBytes / 1024usize));
  printStr(" KiB, best ");
  printInt(best / 1000000i64);
  printStr(" ms, ");
  printInt(i64.from(outBytes) * 1000i64 / best);
  printStr(" MB/s of RGBA out, ");
  printInt(i64.from(fileBytes) * 1000i64 / best);
  printStr(" MB/s of file in\n");
}

fn timeDecode(name &str, data &Array[u8]) {
  mut best = 0x7FFFFFFFFFFFFFFFi64;
  mut last = Raster.empty();
  mut run = 0;
  while run < 5 {
    imm t0 = Instant.now();
    match decode(data) {
      case mut ok Ok { last <=> ok; }
      case imm e Error { printStr(name); printStr(": "); printStr(e.reason.view()); printStr("\n"); return; }
    }
    imm ns = t0.elapsed().nanos();
    if ns < best { best = ns; }
    run += 1;
  }
  report(name, data.len, &last, best);
}

fn main() i32 {
  imm args = process.args();
  if args.len() > 1usize {
    mut i = 1usize;
    while i < args.len() {
      imm p = Path.from(args[i].view());
      match fs.readFile(&p) {
        case mut ok Ok {
          mut s = String.empty();
          s <=> ok;
          timeDecode(args[i].view(), s.view());
        }
        case imm e Error { printStr("cannot read "); printStr(args[i].view()); printStr("\n"); }
      }
      i += 1usize;
    }
    return 0i32;
  }
  // A picture of our own
  mut r = Raster.empty();
  r.width = 2048;
  r.height = 2048;
  r.hasAlpha = false;
  r.pixels8.resize(2048usize * 2048usize * 4usize, 0u8);
  mut y = 0usize;
  while y < 2048usize {
    mut x = 0usize;
    while x < 2048usize {
      imm o = (y * 2048usize + x) * 4usize;
      imm v = (x * 3usize + y * 2usize) / 16usize + ((x ^ y) & 7usize);
      r.pixels8.set(o, u8.from(v & 255usize));
      r.pixels8.set(o + 1usize, u8.from((x / 8usize) & 255usize));
      r.pixels8.set(o + 2usize, u8.from((y / 8usize + (x * y) / 65536usize) & 255usize));
      r.pixels8.set(o + 3usize, 255u8);
      x += 1usize;
    }
    y += 1usize;
  }
  imm t0 = Instant.now();
  imm png = encodePng(&r, 2);
  printStr("encode (dynamic Huffman, adaptive filters): ");
  printInt(t0.elapsed().nanos() / 1000000i64);
  printStr(" ms, ");
  printInt(i64.from(png.len() / 1024usize));
  printStr(" KiB\n");
  timeDecode("generated png", png.view());
  0i32;
}
