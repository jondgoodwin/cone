// ======== PNG: ISO/IEC 15948, W3C PNG Specification (Third Edition) ========
//
// All five colour types (greyscale, truecolour, palette, greyscale with
// alpha, truecolour with alpha) at every bit depth the specification allows
// (1, 2, 4, 8 and 16), the five scanline filters, Adam7 interlacing, the
// tRNS transparency chunk (a palette's alpha table, or one colour key),
// and the gAMA and sRGB chunks (recorded in the Raster, not applied: a
// renderer decides what to do with the encoding). Every chunk's CRC-32 is
// checked. Pictures with samples of 16 bits come out as RGBA16, all others
// RGBA8; a 1, 2 or 4-bit sample is scaled up to 8 bits by the specification's
// replication (v * 255 / (2^d - 1)).
//
// Refused with a message, never a crash: a bad signature, a chunk that runs
// past the file, a CRC mismatch, an unknown critical chunk, an impossible
// colour type and bit depth, a picture over 2^26 pixels a side-product (the
// 'maxPixels' of the decode), a stream that inflates to the wrong size,
// a filter type over 4, a missing palette or IDAT, an unfinished stream.

// The colour types
const PngGray = 0u8;
const PngRgb = 2u8;
const PngPalette = 3u8;
const PngGrayAlpha = 4u8;
const PngRgba = 6u8;

// Adam7: each pass's first column and row, and the step between its pixels
// (specification section 8.2)
imm adamX0 Array[u32, 7] = [0u32, 4u32, 0u32, 2u32, 0u32, 1u32, 0u32];
imm adamY0 Array[u32, 7] = [0u32, 0u32, 4u32, 0u32, 2u32, 0u32, 1u32];
imm adamDx Array[u32, 7] = [8u32, 8u32, 4u32, 4u32, 2u32, 2u32, 1u32];
imm adamDy Array[u32, 7] = [8u32, 8u32, 8u32, 4u32, 4u32, 2u32, 2u32];

fn pngFail(why &str) Result[Raster, DecodeError] {
  Error[Raster, DecodeError](new DecodeError(String.from(why)));
}

fn be32(d &Array[u8], at usize) u32 {
  (u32.from(d[at]) << 24u32) | (u32.from(d[at + 1usize]) << 16u32) | (u32.from(d[at + 2usize]) << 8u32) | u32.from(d[at + 3usize]);
}

// Samples a pixel has for a colour type
fn pngChannels(ct u8) usize {
  if ct == PngRgb { return 3usize; }
  if ct == PngGrayAlpha { return 2usize; }
  if ct == PngRgba { return 4usize; }
  1usize;
}

// The Paeth predictor (specification 9.4)
fn paeth(a i32, b i32, c i32) i32 {
  imm p = a + b - c;
  imm pa = if p > a {p - a;} else {a - p;};
  imm pb = if p > b {p - b;} else {b - p;};
  imm pc = if p > c {p - c;} else {c - p;};
  if pa <= pb and pa <= pc { return a; }
  if pb <= pc { return b; }
  c;
}

// Reverse the filter of the scanline at 'row' (its filter byte at buf[row],
// 'len' bytes of data after it) in place. 'prev' is the start of the
// previous unfiltered scanline's data, or 'noRow' for the first. bpp is the
// bytes per complete pixel, at least 1. false on a filter type over 4.
fn unfilterRow(buf &mut Array[u8], row usize, len usize, prev usize, bpp usize) bool {
  imm ft = buf[row];
  imm start = row + 1usize;
  imm hasPrev = prev != noRow;
  if ft == 0u8 { return true; }
  if ft == 1u8 {
    // Sub: add the byte bpp to the left
    mut i = bpp;
    while i < len {
      buf[start + i] = buf[start + i] + buf[start + i - bpp];
      i += 1usize;
    }
    return true;
  }
  if ft == 2u8 {
    // Up
    if hasPrev {
      mut i = 0usize;
      while i < len {
        buf[start + i] = buf[start + i] + buf[prev + i];
        i += 1usize;
      }
    }
    return true;
  }
  if ft == 3u8 {
    // Average of left and up (rounded down)
    mut i = 0usize;
    while i < len {
      imm left = if i >= bpp {u32.from(buf[start + i - bpp]);} else {0u32;};
      imm up = if hasPrev {u32.from(buf[prev + i]);} else {0u32;};
      buf[start + i] = buf[start + i] + u8.from((left + up) >> 1u32);
      i += 1usize;
    }
    return true;
  }
  if ft == 4u8 {
    mut i = 0usize;
    while i < len {
      imm a = if i >= bpp {i32.from(buf[start + i - bpp]);} else {0i32;};
      imm b = if hasPrev {i32.from(buf[prev + i]);} else {0i32;};
      imm c = if i >= bpp and hasPrev {i32.from(buf[prev + i - bpp]);} else {0i32;};
      buf[start + i] = buf[start + i] + u8.from(paeth(a, b, c));
      i += 1usize;
    }
    return true;
  }
  false;
}

const noRow = 0xFFFFFFFFFFFFFFFFusize;

// What the header and ancillary chunks say
struct PngInfo {
  pub width u32;
  pub height u32;
  pub depth u8;
  pub colorType u8;
  pub interlace u8;
  pub palette List[u8];       // RGB triples
  pub trnsPalette List[u8];   // alpha per palette entry
  pub hasKey bool;
  pub keyR u16;
  pub keyG u16;
  pub keyB u16;
  pub gamma f32;
  pub srgb bool;
}

// The number of data bytes of a scanline of 'w' pixels
fn rowBytes(info &PngInfo, w usize) usize {
  (w * pngChannels(info.colorType) * usize.from(info.depth) + 7usize) / 8usize;
}

// Whether depth and colour type go together (specification table 6)
fn validDepth(ct u8, d u8) bool {
  if ct == PngGray { return d == 1u8 or d == 2u8 or d == 4u8 or d == 8u8 or d == 16u8; }
  if ct == PngPalette { return d == 1u8 or d == 2u8 or d == 4u8 or d == 8u8; }
  if ct == PngRgb or ct == PngGrayAlpha or ct == PngRgba { return d == 8u8 or d == 16u8; }
  false;
}

// The most pixels a decode accepts (so a hostile header cannot ask for
// terabytes); 2^28 is a 16384 x 16384 picture
pub const maxPixels = 268435456usize;

// Decode a PNG file's bytes
pub fn decodePng(data &Array[u8]) Result[Raster, DecodeError] {
  if data.len < 33usize { return pngFail("png: the file is too short"); }
  imm sig Array[u8, 8] = [137u8, 80u8, 78u8, 71u8, 13u8, 10u8, 26u8, 10u8];
  mut s = 0usize;
  while s < 8usize {
    if data[s] != sig[s] { return pngFail("png: not a PNG file (bad signature)"); }
    s += 1usize;
  }
  imm crc = Crc32.make();
  mut info = new PngInfo(0u32, 0u32, 0u8, 0u8, 0u8, List[u8].empty(), List[u8].empty(), false, 0u16, 0u16, 0u16, 0., false);
  mut idat = List[u8].empty();
  mut sawHeader = false;
  mut sawEnd = false;
  mut sawPlte = false;
  mut pos = 8usize;
  while pos + 12usize <= data.len and not sawEnd {
    imm len = usize.from(be32(data, pos));
    imm tag = be32(data, pos + 4usize);
    if len > 0x7FFFFFFFusize or pos + 12usize + len > data.len {
      return pngFail("png: a chunk runs past the end of the file");
    }
    imm body = pos + 8usize;
    imm want = be32(data, body + len);
    if crc.update(0u32, data, pos + 4usize, body + len) != want {
      return pngFail("png: a chunk's CRC does not match");
    }
    if tag == 0x49484452u32 {
      // IHDR
      if len != 13usize or sawHeader { return pngFail("png: bad IHDR"); }
      sawHeader = true;
      info.width = be32(data, body);
      info.height = be32(data, body + 4usize);
      info.depth = data[body + 8usize];
      info.colorType = data[body + 9usize];
      info.interlace = data[body + 12usize];
      if info.width == 0u32 or info.height == 0u32 { return pngFail("png: the picture has no pixels"); }
      if not validDepth(info.colorType, info.depth) { return pngFail("png: colour type and bit depth do not go together"); }
      if data[body + 10usize] != 0u8 { return pngFail("png: unknown compression method"); }
      if data[body + 11usize] != 0u8 { return pngFail("png: unknown filter method"); }
      if info.interlace > 1u8 { return pngFail("png: unknown interlace method"); }
      if usize.from(info.width) > maxPixels or usize.from(info.height) > maxPixels
        or usize.from(info.width) * usize.from(info.height) > maxPixels {
        return pngFail("png: the picture is too large");
      }
    } elif not sawHeader {
      return pngFail("png: the first chunk is not IHDR");
    } elif tag == 0x504C5445u32 {
      // PLTE
      if len % 3usize != 0usize or len == 0usize or len > 768usize { return pngFail("png: bad palette"); }
      info.palette.clear();
      mut i = 0usize;
      while i < len { info.palette.push(data[body + i]); i += 1usize; }
      sawPlte = true;
    } elif tag == 0x49444154u32 {
      // IDAT
      idat.reserve(len);
      mut i = 0usize;
      while i < len { idat.push(data[body + i]); i += 1usize; }
    } elif tag == 0x49454E44u32 {
      sawEnd = true;
    } elif tag == 0x74524E53u32 {
      // tRNS
      if info.colorType == PngPalette {
        info.trnsPalette.clear();
        mut i = 0usize;
        while i < len { info.trnsPalette.push(data[body + i]); i += 1usize; }
      } elif info.colorType == PngGray and len == 2usize {
        info.hasKey = true;
        info.keyR = u16.from(data[body]) * 256u16 + u16.from(data[body + 1usize]);
      } elif info.colorType == PngRgb and len == 6usize {
        info.hasKey = true;
        info.keyR = u16.from(data[body]) * 256u16 + u16.from(data[body + 1usize]);
        info.keyG = u16.from(data[body + 2usize]) * 256u16 + u16.from(data[body + 3usize]);
        info.keyB = u16.from(data[body + 4usize]) * 256u16 + u16.from(data[body + 5usize]);
      }
      // (tRNS with an alpha channel is not allowed; ignored)
    } elif tag == 0x67414D41u32 {
      // gAMA: the file gamma times 100000
      if len == 4usize { info.gamma = f32.from(be32(data, body)) / 100000.; }
    } elif tag == 0x73524742u32 {
      info.srgb = true;
    } else {
      // An unknown chunk: ancillary (bit 5 of its first letter set) is skipped,
      // a critical one cannot be
      imm first = u8.from(tag >> 24u32);
      if (first & 32u8) == 0u8 { return pngFail("png: an unknown critical chunk"); }
    }
    pos = pos + 12usize + len;
  }
  if not sawHeader { return pngFail("png: no IHDR"); }
  if idat.len() == 0usize { return pngFail("png: no image data"); }
  if info.colorType == PngPalette and not sawPlte { return pngFail("png: a palette picture with no palette"); }

  imm w = usize.from(info.width);
  imm h = usize.from(info.height);
  imm bitsPerPixel = pngChannels(info.colorType) * usize.from(info.depth);
  imm bpp = if bitsPerPixel >= 8usize {bitsPerPixel / 8usize;} else {1usize;};

  // The size of the filtered data
  mut total = 0usize;
  if info.interlace == 0u8 {
    total = h * (rowBytes(&info, w) + 1usize);
  } else {
    mut p = 0usize;
    while p < 7usize {
      imm pw = passSize(info.width, adamX0[p], adamDx[p]);
      imm ph = passSize(info.height, adamY0[p], adamDy[p]);
      if pw > 0usize and ph > 0usize { total = total + ph * (rowBytes(&info, pw) + 1usize); }
      p += 1usize;
    }
  }

  mut raw = List[u8].empty();
  match zlibDecompress(idat.view(), total) {
    case mut ok Ok { raw <=> ok; }
    case imm e Error {
      return Error[Raster, DecodeError](new DecodeError(e.reason.copy()));
    }
  }
  if raw.len() != total { return pngFail("png: the image data is the wrong size"); }

  // Output
  imm sixteen = info.depth == 16u8;
  mut out = Raster.empty();
  out.width = i32.from(w);
  out.height = i32.from(h);
  out.depth = if sixteen {16;} else {8;};
  out.hasAlpha = info.colorType == PngGrayAlpha or info.colorType == PngRgba
    or info.hasKey or info.trnsPalette.len() > 0usize;
  out.gamma = info.gamma;
  out.colorSpace = if info.srgb {ColorSpace.Srgb;} elif info.gamma == 1. {ColorSpace.Linear;}
    elif info.gamma > 0. {ColorSpace.Gamma;} else {ColorSpace.Unspecified;};
  if sixteen { out.pixels16.resize(w * h * 4usize, 0u16); } else { out.pixels8.resize(w * h * 4usize, 0u8); }

  if info.interlace == 0u8 {
    if not pngPass(raw.viewMut(), 0usize, &info, w, h, 0usize, 1usize, 0usize, 1usize, w, &mut out) {
      return pngFail("png: bad scanline filter");
    }
  } else {
    mut off = 0usize;
    mut p = 0usize;
    while p < 7usize {
      imm pw = passSize(info.width, adamX0[p], adamDx[p]);
      imm ph = passSize(info.height, adamY0[p], adamDy[p]);
      if pw > 0usize and ph > 0usize {
        if not pngPass(raw.viewMut(), off, &info, pw, ph, usize.from(adamX0[p]), usize.from(adamDx[p]),
          usize.from(adamY0[p]), usize.from(adamDy[p]), w, &mut out) {
          return pngFail("png: bad scanline filter");
        }
        off = off + ph * (rowBytes(&info, pw) + 1usize);
      }
      p += 1usize;
    }
  }
  Ok[Raster, DecodeError](out);
}

// How many pixels of a side of 'n' a pass reaches: from 'start' every 'step'
fn passSize(n u32, start u32, step u32) usize {
  if n <= start { return 0usize; }
  usize.from((n - start + step - 1u32) / step);
}

// Unfilter and convert one pass (the whole picture when not interlaced):
// 'pw' by 'ph' pixels whose filtered scanlines start at 'off' in 'buf'; pixel
// (x, y) of the pass lands at column x0 + x * dx, row y0 + y * dy of the
// picture, which is 'w' wide.
fn pngPass(buf &mut Array[u8], off usize, info &PngInfo, pw usize, ph usize, x0 usize, dx usize, y0 usize,
  dy usize, w usize, out &mut Raster) bool {
  imm rb = rowBytes(info, pw);
  imm bitsPerPixel = pngChannels(info.colorType) * usize.from(info.depth);
  imm bpp = if bitsPerPixel >= 8usize {bitsPerPixel / 8usize;} else {1usize;};
  mut prev = noRow;
  mut y = 0usize;
  while y < ph {
    imm row = off + y * (rb + 1usize);
    if not unfilterRow(buf, row, rb, prev, bpp) { return false; }
    imm picY = y0 + y * dy;
    imm dst = (picY * w + x0) * 4usize;
    if info.depth == 16u8 {
      convertRow16(buf, row + 1usize, info, pw, dst, dx * 4usize, out.pixels16.viewMut());
    } else {
      convertRow8(buf, row + 1usize, info, pw, dst, dx * 4usize, out.pixels8.viewMut());
    }
    prev = row + 1usize;
    y += 1usize;
  }
  true;
}

// Convert one unfiltered scanline of 'n' pixels at buf[src] into RGBA8 at
// dst[at], each pixel 'step' bytes after the last
fn convertRow8(buf &Array[u8], src usize, info &PngInfo, n usize, at usize, step usize, dst &mut Array[u8]) {
  imm ct = info.colorType;
  imm depth = usize.from(info.depth);
  mut o = at;
  mut x = 0usize;
  if ct == PngRgba {
    while x < n {
      imm s = src + x * 4usize;
      dst[o] = buf[s];
      dst[o + 1usize] = buf[s + 1usize];
      dst[o + 2usize] = buf[s + 2usize];
      dst[o + 3usize] = buf[s + 3usize];
      o += step;
      x += 1usize;
    }
  } elif ct == PngRgb {
    imm key = info.hasKey;
    imm kr = u8.from(info.keyR & 255u16);
    imm kg = u8.from(info.keyG & 255u16);
    imm kb = u8.from(info.keyB & 255u16);
    imm keyHigh = info.keyR > 255u16 or info.keyG > 255u16 or info.keyB > 255u16;
    while x < n {
      imm s = src + x * 3usize;
      imm r = buf[s];
      imm g = buf[s + 1usize];
      imm b = buf[s + 2usize];
      dst[o] = r;
      dst[o + 1usize] = g;
      dst[o + 2usize] = b;
      dst[o + 3usize] = if key and not keyHigh and r == kr and g == kg and b == kb {0u8;} else {255u8;};
      o += step;
      x += 1usize;
    }
  } elif ct == PngGrayAlpha {
    while x < n {
      imm s = src + x * 2usize;
      imm g = buf[s];
      dst[o] = g;
      dst[o + 1usize] = g;
      dst[o + 2usize] = g;
      dst[o + 3usize] = buf[s + 1usize];
      o += step;
      x += 1usize;
    }
  } else {
    // Greyscale or palette: one sample of 'depth' bits a pixel, packed
    // most-significant bit first
    imm isPal = ct == PngPalette;
    imm mask = (1u32 << u32.from(depth)) - 1u32;
    imm scale = 255u32 / mask;
    imm palN = info.palette.len() / 3usize;
    while x < n {
      mut v = 0u32;
      if depth == 8usize {
        v = u32.from(buf[src + x]);
      } else {
        imm bit = x * depth;
        imm byte = u32.from(buf[src + bit / 8usize]);
        imm shift = 8u32 - u32.from(depth) - u32.from(bit % 8usize);
        v = (byte >> shift) & mask;
      }
      if isPal {
        imm i = usize.from(v);
        if i < palN {
          dst[o] = *info.palette[i * 3usize];
          dst[o + 1usize] = *info.palette[i * 3usize + 1usize];
          dst[o + 2usize] = *info.palette[i * 3usize + 2usize];
        } else {
          dst[o] = 0u8;
          dst[o + 1usize] = 0u8;
          dst[o + 2usize] = 0u8;
        }
        dst[o + 3usize] = if i < info.trnsPalette.len() {*info.trnsPalette[i];} else {255u8;};
      } else {
        imm g = u8.from(v * scale);
        dst[o] = g;
        dst[o + 1usize] = g;
        dst[o + 2usize] = g;
        // The key is compared at the file's depth
        dst[o + 3usize] = if info.hasKey and u32.from(info.keyR) == v {0u8;} else {255u8;};
      }
      o += step;
      x += 1usize;
    }
  }
}

// The same for 16-bit samples (big-endian in the file), into RGBA16
fn convertRow16(buf &Array[u8], src usize, info &PngInfo, n usize, at usize, step usize, dst &mut Array[u16]) {
  imm ct = info.colorType;
  mut o = at;
  mut x = 0usize;
  while x < n {
    if ct == PngRgba {
      imm s = src + x * 8usize;
      dst[o] = be16(buf, s);
      dst[o + 1usize] = be16(buf, s + 2usize);
      dst[o + 2usize] = be16(buf, s + 4usize);
      dst[o + 3usize] = be16(buf, s + 6usize);
    } elif ct == PngRgb {
      imm s = src + x * 6usize;
      imm r = be16(buf, s);
      imm g = be16(buf, s + 2usize);
      imm b = be16(buf, s + 4usize);
      dst[o] = r;
      dst[o + 1usize] = g;
      dst[o + 2usize] = b;
      dst[o + 3usize] = if info.hasKey and r == info.keyR and g == info.keyG and b == info.keyB {0u16;} else {65535u16;};
    } elif ct == PngGrayAlpha {
      imm s = src + x * 4usize;
      imm g = be16(buf, s);
      dst[o] = g;
      dst[o + 1usize] = g;
      dst[o + 2usize] = g;
      dst[o + 3usize] = be16(buf, s + 2usize);
    } else {
      imm g = be16(buf, src + x * 2usize);
      dst[o] = g;
      dst[o + 1usize] = g;
      dst[o + 2usize] = g;
      dst[o + 3usize] = if info.hasKey and g == info.keyR {0u16;} else {65535u16;};
    }
    o += step;
    x += 1usize;
  }
}

fn be16(d &Array[u8], at usize) u16 { u16.from(d[at]) * 256u16 + u16.from(d[at + 1usize]); }
