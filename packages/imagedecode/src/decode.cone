// ======== Which format? ========

// What stopped a decode
pub struct DecodeError {
  pub reason: String;

  pub fn message(self: &) String { reason.copy() }
}

// What a file's first bytes say it is
pub enum ImageFormat {
  Png, Jpeg, Unknown;
}

pub fn sniff(data: &Array[u8]) ImageFormat {
  if data.len >= 8usize && data[0usize] == 137u8 && data[1usize] == 80u8 && data[2usize] == 78u8 && data[3usize] == 71u8 {
    return ImageFormat.Png;
  }
  if data.len >= 3usize && data[0usize] == 0xFFu8 && data[1usize] == 0xD8u8 && data[2usize] == 0xFFu8 {
    return ImageFormat.Jpeg;
  }
  ImageFormat.Unknown
}

// Decode a PNG or a JPEG, whichever the bytes are (a JPEG with its Exif
// orientation applied). BMP is render's Image.fromBmp; anything else is
// refused by name.
pub fn decode(data: &Array[u8]) Result[Raster, DecodeError] {
  let f = sniff(data);
  if f == ImageFormat.Png { return decodePng(data); }
  if f == ImageFormat.Jpeg { return decodeJpeg(data); }
  if data.len >= 2usize && data[0usize] == 'B' && data[1usize] == 'M' {
    return Error[Raster, DecodeError](new DecodeError(String.from("image: a BMP; render's Image.fromBmp reads those")));
  }
  if data.len >= 12usize && data[0usize] == 'R' && data[1usize] == 'I' && data[2usize] == 'F' && data[3usize] == 'F'
    && data[8usize] == 'W' && data[9usize] == 'E' && data[10usize] == 'B' && data[11usize] == 'P' {
    return Error[Raster, DecodeError](new DecodeError(String.from("image: WebP is not supported (it needs a VP8 decoder)")));
  }
  if data.len >= 12usize && data[0usize] == 0xABu8 && data[1usize] == 'K' && data[2usize] == 'T' && data[3usize] == 'X' {
    return Error[Raster, DecodeError](new DecodeError(String.from("image: KTX2 is not supported (GPU-compressed textures need their transcoder)")));
  }
  Error[Raster, DecodeError](new DecodeError(String.from("image: not a PNG or a JPEG")))
}
