// ======== JPEG: from coefficients to pixels ========

// libjpeg's jidctint.c constants: the factors of the Loeffler, Ligtenberg and
// Moschytz IDCT times 2^13, rounded
const Fix0_298631336 = 2446i32;
const Fix0_390180644 = 3196i32;
const Fix0_541196100 = 4433i32;
const Fix0_765366865 = 6270i32;
const Fix0_899976223 = 7373i32;
const Fix1_175875602 = 9633i32;
const Fix1_501321110 = 12299i32;
const Fix1_847759065 = 15137i32;
const Fix1_961570560 = 16069i32;
const Fix2_053119869 = 16819i32;
const Fix2_562915447 = 20995i32;
const Fix3_072711026 = 25172i32;

fn clamp255(v i32) u8 {
  if v < 0i32 { return 0u8; }
  if v > 255i32 { return 255u8; }
  u8.from(v);
}

// The inverse DCT of the block at c[off], dequantised by q[qoff], into 8
// rows of 8 samples at out[outOff] with 'stride' between rows (+128, clamped).
// 'ws' is 64 words of scratch. T.81 A.3.3 by the "islow" method: a pass over
// the columns into ws (scaled up by 2^2), a pass over the rows scaled down by
// 2^(13 + 2 + 3).
fn idctBlock(c &Array[i16], off usize, q &Array[i32], qoff usize, ws &mut Array[i32], out &mut Array[u8], outOff usize,
  stride usize) {
  mut col = 0usize;
  while col < 8usize {
    imm i0 = off + col;
    imm q0 = qoff + col;
    if c[i0 + 8usize] == 0i16 and c[i0 + 16usize] == 0i16 and c[i0 + 24usize] == 0i16 and c[i0 + 32usize] == 0i16
      and c[i0 + 40usize] == 0i16 and c[i0 + 48usize] == 0i16 and c[i0 + 56usize] == 0i16 {
      imm dc = (i32.from(c[i0]) * q[q0]) << 2i32;
      ws[col] = dc;
      ws[col + 8usize] = dc;
      ws[col + 16usize] = dc;
      ws[col + 24usize] = dc;
      ws[col + 32usize] = dc;
      ws[col + 40usize] = dc;
      ws[col + 48usize] = dc;
      ws[col + 56usize] = dc;
    } else {
      // Even part: rotation by sqrt(2) cos and sin of 3 pi / 8 on rows 2 and 6
      mut z2 = i32.from(c[i0 + 16usize]) * q[q0 + 16usize];
      mut z3 = i32.from(c[i0 + 48usize]) * q[q0 + 48usize];
      mut z1 = (z2 + z3) * Fix0_541196100;
      imm tmp2 = z1 + z3 * (-Fix1_847759065);
      imm tmp3 = z1 + z2 * Fix0_765366865;
      z2 = i32.from(c[i0]) * q[q0];
      z3 = i32.from(c[i0 + 32usize]) * q[q0 + 32usize];
      imm tmp0 = (z2 + z3) << 13i32;
      imm tmp1 = (z2 - z3) << 13i32;
      imm tmp10 = tmp0 + tmp3;
      imm tmp13 = tmp0 - tmp3;
      imm tmp11 = tmp1 + tmp2;
      imm tmp12 = tmp1 - tmp2;
      // Odd part: rows 7, 5, 3, 1
      mut t0 = i32.from(c[i0 + 56usize]) * q[q0 + 56usize];
      mut t1 = i32.from(c[i0 + 40usize]) * q[q0 + 40usize];
      mut t2 = i32.from(c[i0 + 24usize]) * q[q0 + 24usize];
      mut t3 = i32.from(c[i0 + 8usize]) * q[q0 + 8usize];
      z1 = t0 + t3;
      z2 = t1 + t2;
      z3 = t0 + t2;
      mut z4 = t1 + t3;
      imm z5 = (z3 + z4) * Fix1_175875602;
      t0 = t0 * Fix0_298631336;
      t1 = t1 * Fix2_053119869;
      t2 = t2 * Fix3_072711026;
      t3 = t3 * Fix1_501321110;
      z1 = z1 * (-Fix0_899976223);
      z2 = z2 * (-Fix2_562915447);
      z3 = z3 * (-Fix1_961570560) + z5;
      z4 = z4 * (-Fix0_390180644) + z5;
      t0 += z1 + z3;
      t1 += z2 + z4;
      t2 += z2 + z3;
      t3 += z1 + z4;
      // Descale by 13 - 2 bits, rounding
      ws[col] = (tmp10 + t3 + 1024i32) >> 11i32;
      ws[col + 56usize] = (tmp10 - t3 + 1024i32) >> 11i32;
      ws[col + 8usize] = (tmp11 + t2 + 1024i32) >> 11i32;
      ws[col + 48usize] = (tmp11 - t2 + 1024i32) >> 11i32;
      ws[col + 16usize] = (tmp12 + t1 + 1024i32) >> 11i32;
      ws[col + 40usize] = (tmp12 - t1 + 1024i32) >> 11i32;
      ws[col + 24usize] = (tmp13 + t0 + 1024i32) >> 11i32;
      ws[col + 32usize] = (tmp13 - t0 + 1024i32) >> 11i32;
    }
    col += 1usize;
  }
  mut row = 0usize;
  while row < 8usize {
    imm w = row * 8usize;
    imm o = outOff + row * stride;
    if ws[w + 1usize] == 0i32 and ws[w + 2usize] == 0i32 and ws[w + 3usize] == 0i32 and ws[w + 4usize] == 0i32
      and ws[w + 5usize] == 0i32 and ws[w + 6usize] == 0i32 and ws[w + 7usize] == 0i32 {
      imm v = clamp255(((ws[w] + 16i32) >> 5i32) + 128i32);
      out[o] = v;
      out[o + 1usize] = v;
      out[o + 2usize] = v;
      out[o + 3usize] = v;
      out[o + 4usize] = v;
      out[o + 5usize] = v;
      out[o + 6usize] = v;
      out[o + 7usize] = v;
    } else {
      mut z2 = ws[w + 2usize];
      mut z3 = ws[w + 6usize];
      mut z1 = (z2 + z3) * Fix0_541196100;
      imm tmp2 = z1 + z3 * (-Fix1_847759065);
      imm tmp3 = z1 + z2 * Fix0_765366865;
      imm tmp0 = (ws[w] + ws[w + 4usize]) << 13i32;
      imm tmp1 = (ws[w] - ws[w + 4usize]) << 13i32;
      imm tmp10 = tmp0 + tmp3;
      imm tmp13 = tmp0 - tmp3;
      imm tmp11 = tmp1 + tmp2;
      imm tmp12 = tmp1 - tmp2;
      mut t0 = ws[w + 7usize];
      mut t1 = ws[w + 5usize];
      mut t2 = ws[w + 3usize];
      mut t3 = ws[w + 1usize];
      z1 = t0 + t3;
      z2 = t1 + t2;
      z3 = t0 + t2;
      mut z4 = t1 + t3;
      imm z5 = (z3 + z4) * Fix1_175875602;
      t0 = t0 * Fix0_298631336;
      t1 = t1 * Fix2_053119869;
      t2 = t2 * Fix3_072711026;
      t3 = t3 * Fix1_501321110;
      z1 = z1 * (-Fix0_899976223);
      z2 = z2 * (-Fix2_562915447);
      z3 = z3 * (-Fix1_961570560) + z5;
      z4 = z4 * (-Fix0_390180644) + z5;
      t0 += z1 + z3;
      t1 += z2 + z4;
      t2 += z2 + z3;
      t3 += z1 + z4;
      // 13 + 2 + 3 bits, rounding, then the level shift
      out[o] = clamp255(((tmp10 + t3 + 131072i32) >> 18i32) + 128i32);
      out[o + 7usize] = clamp255(((tmp10 - t3 + 131072i32) >> 18i32) + 128i32);
      out[o + 1usize] = clamp255(((tmp11 + t2 + 131072i32) >> 18i32) + 128i32);
      out[o + 6usize] = clamp255(((tmp11 - t2 + 131072i32) >> 18i32) + 128i32);
      out[o + 2usize] = clamp255(((tmp12 + t1 + 131072i32) >> 18i32) + 128i32);
      out[o + 5usize] = clamp255(((tmp12 - t1 + 131072i32) >> 18i32) + 128i32);
      out[o + 3usize] = clamp255(((tmp13 + t0 + 131072i32) >> 18i32) + 128i32);
      out[o + 4usize] = clamp255(((tmp13 - t0 + 131072i32) >> 18i32) + 128i32);
    }
    row += 1usize;
  }
}

// Chroma (or any component) upsampled to the picture's size: libjpeg's fancy
// upsampling where it applies, replication elsewhere. 'src' is the plane of
// 'stride' samples a row, the component 'cw' by 'ch' samples of it; the
// result is 'w' by 'h'.
fn upsample(src &Array[u8], stride usize, cw usize, ch usize, hr usize, vr usize, w usize, h usize,
  hmax usize, vmax usize, hc usize, vc usize) List[u8] {
  mut out = List[u8].empty();
  out.resize(w * h, 0u8);
  imm dst = out.viewMut();
  if hr == 1usize and vr == 1usize {
    mut y = 0usize;
    while y < h {
      mut x = 0usize;
      while x < w { dst[y * w + x] = src[y * stride + x]; x += 1usize; }
      y += 1usize;
    }
  } elif hr == 2usize and vr == 1usize and cw > 2usize {
    // h2v1 fancy: 3/4 the nearer sample and 1/4 the further
    mut y = 0usize;
    while y < h {
      imm r = y * stride;
      mut x = 0usize;
      while x < cw {
        imm this = u32.from(src[r + x]);
        imm last = u32.from(src[r + (if x > 0usize {x - 1usize;} else {0usize;})]);
        imm next = u32.from(src[r + (if x + 1usize < cw {x + 1usize;} else {cw - 1usize;})]);
        if 2usize * x < w { dst[y * w + 2usize * x] = u8.from((3u32 * this + last + 1u32) >> 2u32); }
        if 2usize * x + 1usize < w { dst[y * w + 2usize * x + 1usize] = u8.from((3u32 * this + next + 2u32) >> 2u32); }
        x += 1usize;
      }
      y += 1usize;
    }
  } elif hr == 2usize and vr == 2usize and cw > 2usize {
    // h2v2 fancy: the same in both directions, nine-sixteenths of the
    // nearest sample, 3/16 each of the nearest in the other two, 1/16 the corner
    mut sums = List[u32].empty();
    sums.resize(cw, 0u32);
    imm cs = sums.viewMut();
    mut y = 0usize;
    while y < h {
      imm near = y / 2usize;
      imm far0 = if y % 2usize == 0usize {if near > 0usize {near - 1usize;} else {0usize;};}
        else {if near + 1usize < ch {near + 1usize;} else {ch - 1usize;};};
      mut x = 0usize;
      while x < cw {
        cs[x] = 3u32 * u32.from(src[near * stride + x]) + u32.from(src[far0 * stride + x]);
        x += 1usize;
      }
      x = 0usize;
      while x < cw {
        imm this = cs[x];
        imm last = cs[if x > 0usize {x - 1usize;} else {0usize;}];
        imm next = cs[if x + 1usize < cw {x + 1usize;} else {cw - 1usize;}];
        if 2usize * x < w { dst[y * w + 2usize * x] = u8.from((3u32 * this + last + 8u32) >> 4u32); }
        if 2usize * x + 1usize < w { dst[y * w + 2usize * x + 1usize] = u8.from((3u32 * this + next + 7u32) >> 4u32); }
        x += 1usize;
      }
      y += 1usize;
    }
  } elif hr == 1usize and vr == 2usize {
    // h1v2 fancy (libjpeg-turbo): 3/4 and 1/4 vertically
    mut y = 0usize;
    while y < h {
      imm near = y / 2usize;
      imm upper = y % 2usize == 0usize;
      imm far0 = if upper {if near > 0usize {near - 1usize;} else {0usize;};}
        else {if near + 1usize < ch {near + 1usize;} else {ch - 1usize;};};
      imm bias = if upper {1u32;} else {2u32;};
      mut x = 0usize;
      while x < w {
        dst[y * w + x] = u8.from((3u32 * u32.from(src[near * stride + x]) + u32.from(src[far0 * stride + x]) + bias) >> 2u32);
        x += 1usize;
      }
      y += 1usize;
    }
  } else {
    // Replicate: the sample whose footprint holds the pixel
    mut y = 0usize;
    while y < h {
      imm sy = y * vc / vmax;
      mut x = 0usize;
      while x < w {
        imm sx = x * hc / hmax;
        dst[y * w + x] = src[sy * stride + sx];
        x += 1usize;
      }
      y += 1usize;
    }
  }
  out;
}

// The JFIF YCbCr to RGB of libjpeg (jdcolor.c) in 16-bit fixed point
struct YccTables {
  pub crR List[i32];
  pub cbB List[i32];
  pub crG List[i32];
  pub cbG List[i32];

  pub fn make() YccTables {
    mut t = new YccTables(List[i32].empty(), List[i32].empty(), List[i32].empty(), List[i32].empty());
    mut i = 0i32;
    while i < 256i32 {
      imm x = i - 128i32;
      t.crR.push((91881i32 * x + 32768i32) >> 16i32);
      t.cbB.push((116130i32 * x + 32768i32) >> 16i32);
      t.crG.push(-46802i32 * x);
      t.cbG.push(-22554i32 * x + 32768i32);
      i += 1i32;
    }
    t;
  }
}

// Turn a decoded frame into a Raster
fn finishJpeg(st &mut JState, orient bool) Result[Raster, DecodeError] {
  imm w = st.frame.width;
  imm h = st.frame.height;
  imm nc = st.frame.comps.len();
  imm hmax = st.frame.hmax;
  imm vmax = st.frame.vmax;
  // Inverse DCT of every block
  mut ws = List[i32].empty();
  ws.resize(64usize, 0i32);
  mut c = 0usize;
  while c < nc {
    imm tq = st.frame.comps[c].tq;
    if not *st.hasQuant[tq] { return jFail("jpeg: a component uses a quantisation table that was never defined"); }
    imm bw = st.frame.comps[c].bw;
    imm bh = st.frame.comps[c].bh;
    imm stride = bw * 8usize;
    imm cp = &mut st.frame.comps[c];
    cp.plane.resize(stride * bh * 8usize, 0u8);
    imm plane = cp.plane.viewMut();
    imm coefs = cp.coefs.view();
    mut brow = 0usize;
    while brow < bh {
      mut bx = 0usize;
      while bx < bw {
        idctBlock(coefs, (brow * bw + bx) * 64usize, st.quant.view(), tq * 64usize, ws.viewMut(), plane,
          brow * 8usize * stride + bx * 8usize, stride);
        bx += 1usize;
      }
      brow += 1usize;
    }
    cp.coefs.clear();
    c += 1usize;
  }
  // Every component at the picture's size
  mut full = List[List[u8]].empty();
  c = 0usize;
  while c < nc {
    imm ch = st.frame.comps[c].h;
    imm cv = st.frame.comps[c].v;
    imm stride = st.frame.comps[c].bw * 8usize;
    imm hr = if hmax % ch == 0usize {hmax / ch;} else {0usize;};
    imm vr = if vmax % cv == 0usize {vmax / cv;} else {0usize;};
    full.push(upsample(st.frame.comps[c].plane.view(), stride, st.frame.comps[c].w, st.frame.comps[c].hgt, hr, vr, w, h, hmax, vmax, ch, cv));
    c += 1usize;
  }
  // Colour
  mut out = Raster.empty();
  out.width = i32.from(w);
  out.height = i32.from(h);
  out.depth = 8;
  out.hasAlpha = false;
  out.colorSpace = ColorSpace.Unspecified;
  out.orientation = st.orientation;
  out.pixels8.resize(w * h * 4usize, 0u8);
  imm px = out.pixels8.viewMut();
  imm tab = YccTables.make();
  imm n = w * h;
  if nc == 1usize {
    imm g = full[0usize].view();
    mut i = 0usize;
    while i < n {
      imm v = g[i];
      px[i * 4usize] = v;
      px[i * 4usize + 1usize] = v;
      px[i * 4usize + 2usize] = v;
      px[i * 4usize + 3usize] = 255u8;
      i += 1usize;
    }
  } elif nc == 3usize or nc == 4usize {
    imm p0 = full[0usize].view();
    imm p1 = full[1usize].view();
    imm p2 = full[2usize].view();
    // Whether the three are Y, Cb, Cr: Adobe's transform flag says; without
    // one, the ids R, G, B say not
    imm isRgb = if st.adobe {st.adobeTransform == 0u8 and nc == 3usize;}
      else {st.frame.comps[0usize].id == 'R' and st.frame.comps[1usize].id == 'G' and st.frame.comps[2usize].id == 'B';};
    imm crR = tab.crR.view();
    imm cbB = tab.cbB.view();
    imm crG = tab.crG.view();
    imm cbG = tab.cbG.view();
    if nc == 3usize {
      mut i = 0usize;
      while i < n {
        if isRgb {
          px[i * 4usize] = p0[i];
          px[i * 4usize + 1usize] = p1[i];
          px[i * 4usize + 2usize] = p2[i];
        } else {
          imm y = i32.from(p0[i]);
          imm cb = usize.from(p1[i]);
          imm cr = usize.from(p2[i]);
          px[i * 4usize] = clamp255(y + crR[cr]);
          px[i * 4usize + 1usize] = clamp255(y + ((cbG[cb] + crG[cr]) >> 16i32));
          px[i * 4usize + 2usize] = clamp255(y + cbB[cb]);
        }
        px[i * 4usize + 3usize] = 255u8;
        i += 1usize;
      }
    } else {
      // Four components: Adobe's CMYK or YCCK, stored inverted (255 is no ink),
      // so red is cyan times black over 255
      imm p3 = full[3usize].view();
      imm ycck = st.adobe and st.adobeTransform == 2u8;
      mut i = 0usize;
      while i < n {
        mut cc = i32.from(p0[i]);
        mut mm = i32.from(p1[i]);
        mut yy = i32.from(p2[i]);
        if ycck {
          imm y = i32.from(p0[i]);
          imm cb = usize.from(p1[i]);
          imm cr = usize.from(p2[i]);
          cc = i32.from(clamp255(y + crR[cr]));
          mm = i32.from(clamp255(y + ((cbG[cb] + crG[cr]) >> 16i32)));
          yy = i32.from(clamp255(y + cbB[cb]));
        }
        imm kk = i32.from(p3[i]);
        px[i * 4usize] = u8.from((cc * kk + 127i32) / 255i32);
        px[i * 4usize + 1usize] = u8.from((mm * kk + 127i32) / 255i32);
        px[i * 4usize + 2usize] = u8.from((yy * kk + 127i32) / 255i32);
        px[i * 4usize + 3usize] = 255u8;
        i += 1usize;
      }
    }
  } else {
    return jFail("jpeg: two-component pictures are not supported");
  }
  if orient and st.orientation > 1i32 { orientRaster(&mut out, st.orientation); }
  Ok[Raster, DecodeError](out);
}

// Turn the picture the way Exif orientation 'o' (2 to 8) says it should be
// shown: the pixel at (x, y) of the result comes from the source pixel the
// table gives. 5 to 8 swap width and height.
pub fn orientRaster(r &mut Raster, o i32) {
  if o < 2i32 or o > 8i32 { return; }
  imm w = usize.from(r.width);
  imm h = usize.from(r.height);
  imm ow = if o >= 5i32 {h;} else {w;};
  imm oh = if o >= 5i32 {w;} else {h;};
  mut np = List[u8].empty();
  np.resize(w * h * 4usize, 0u8);
  imm dst = np.viewMut();
  imm src = r.pixels8.view();
  mut y = 0usize;
  while y < oh {
    mut x = 0usize;
    while x < ow {
      mut sx = x;
      mut sy = y;
      if o == 2i32 { sx = w - 1usize - x; }
      elif o == 3i32 { sx = w - 1usize - x; sy = h - 1usize - y; }
      elif o == 4i32 { sy = h - 1usize - y; }
      elif o == 5i32 { sx = y; sy = x; }
      elif o == 6i32 { sx = y; sy = h - 1usize - x; }
      elif o == 7i32 { sx = w - 1usize - y; sy = h - 1usize - x; }
      else { sx = w - 1usize - y; sy = x; }
      imm s = (sy * w + sx) * 4usize;
      imm d = (y * ow + x) * 4usize;
      dst[d] = src[s];
      dst[d + 1usize] = src[s + 1usize];
      dst[d + 2usize] = src[s + 2usize];
      dst[d + 3usize] = src[s + 3usize];
      x += 1usize;
    }
    y += 1usize;
  }
  r.pixels8 <=> np;
  r.width = i32.from(ow);
  r.height = i32.from(oh);
}
