// ======== DEFLATE and zlib, writing: RFC 1951 and RFC 1950 ========
//
// The other half of inflate, here so a picture can be saved as a PNG (a
// screenshot, a baked texture) and so the decoder's tests can make their own
// streams. Three levels:
//   0  stored blocks (no compression)
//   1  LZ77 with a hash chain of three-byte strings, coded with the fixed
//      Huffman code of RFC 1951 3.2.6
//   2  the same matches coded with a dynamic Huffman code per block
//      (RFC 1951 3.2.7), the code lengths built by the two-smallest merge of
//      Huffman 1952 and limited to 15 bits (7 for the code-length code) by
//      flattening the frequencies until they fit
// The matcher is the classic greedy one (zlib's deflate_fast without the
// level tuning): at each position the longest match within a chain of at most
// 48 candidates, taken if it is 3 bytes or longer. It is neither as fast as
// zlib nor as small, but a stream any inflater reads.

// A bit writer: bits go in least-significant first
struct BitWriter {
  pub out List[u8];
  pub acc u64;
  pub n u32;

  pub fn put(self &mut, value u32, bits u32) {
    acc = acc | (u64.from(value) << u64.from(n));
    n = n + bits;
    while n >= 8u32 {
      out.push(u8.from(acc & 255u64));
      acc = acc >> 8u64;
      n = n - 8u32;
    }
  }

  // A Huffman code goes in most-significant bit first
  pub fn putCode(self &mut, code u32, bits u32) {
    mut rev = 0u32;
    mut i = 0u32;
    while i < bits {
      rev = (rev << 1u32) | ((code >> i) & 1u32);
      i += 1u32;
    }
    self.put(rev, bits);
  }

  // Pad to a byte boundary
  pub fn align(self &mut) {
    if n > 0u32 { self.put(0u32, 8u32 - n); }
  }
}

// A Huffman code for the encoder: bit length and canonical code of each symbol
struct Code {
  pub lens List[u8];
  pub codes List[u32];
}

// Code lengths for symbols with frequencies 'freq' (first 'n'), no longer
// than 'maxBits'. A symbol with frequency 0 gets length 0. Fewer than two
// used symbols: the used one (or symbol 0) gets length 1, which every inflater
// accepts.
fn huffmanLengths(freq &Array[u32], n usize, maxBits u8) List[u8] {
  mut f = List[u32].withCapacity(n);
  mut i = 0usize;
  while i < n { f.push(freq[i]); i += 1usize; }
  while true {
    imm lens = huffmanOnce(f.view(), n);
    mut maxLen = 0u8;
    i = 0usize;
    while i < n { if *lens[i] > maxLen { maxLen = *lens[i]; } i += 1usize; }
    if maxLen <= maxBits { return lens; }
    // Too deep: flatten the frequencies (halve, keeping used symbols used)
    i = 0usize;
    while i < n {
      if *f[i] > 0u32 { f.set(i, (*f[i] + 1u32) / 2u32); }
      i += 1usize;
    }
  }
  List[u8].empty();
}

// Huffman's merge by repeatedly joining the two lightest trees
fn huffmanOnce(freq &Array[u32], n usize) List[u8] {
  mut lens = List[u8].withCapacity(n);
  mut i = 0usize;
  while i < n { lens.push(0u8); i += 1usize; }
  // Nodes: leaves 0..n-1, then internal ones; weight, parent, alive
  mut weight = List[u64].empty();
  mut parent = List[i32].empty();
  mut alive = List[bool].empty();
  mut used = 0usize;
  i = 0usize;
  while i < n {
    weight.push(u64.from(freq[i]));
    parent.push(-1i32);
    alive.push(freq[i] > 0u32);
    if freq[i] > 0u32 { used += 1usize; }
    i += 1usize;
  }
  if used == 0usize { lens.set(0usize, 1u8); return lens; }
  if used == 1usize {
    i = 0usize;
    while i < n { if freq[i] > 0u32 { lens.set(i, 1u8); } i += 1usize; }
    return lens;
  }
  mut left = used;
  while left > 1usize {
    // The two lightest alive nodes (ties to the lowest index: deterministic)
    mut a = -1i32;
    mut b = -1i32;
    mut j = 0usize;
    while j < weight.len() {
      if *alive[j] {
        if a < 0i32 or *weight[j] < *weight[usize.from(a)] {
          b = a;
          a = i32.from(j);
        } elif b < 0i32 or *weight[j] < *weight[usize.from(b)] {
          b = i32.from(j);
        }
      }
      j += 1usize;
    }
    imm id = i32.from(weight.len());
    weight.push(*weight[usize.from(a)] + *weight[usize.from(b)]);
    parent.push(-1i32);
    alive.push(true);
    alive.set(usize.from(a), false);
    alive.set(usize.from(b), false);
    parent.set(usize.from(a), id);
    parent.set(usize.from(b), id);
    left -= 1usize;
  }
  // A leaf's length is its depth
  i = 0usize;
  while i < n {
    if freq[i] > 0u32 {
      mut d = 0u8;
      mut p = *parent[i];
      while p >= 0i32 { d += 1u8; p = *parent[usize.from(p)]; }
      lens.set(i, d);
    }
    i += 1usize;
  }
  lens;
}

// The canonical codes of RFC 1951 3.2.2 for the lengths
fn canonicalCodes(lens &Array[u8], n usize) List[u32] {
  mut count = List[u32].empty();
  mut i = 0usize;
  while i < 17usize { count.push(0u32); i += 1usize; }
  i = 0usize;
  while i < n { if lens[i] > 0u8 { count.set(usize.from(lens[i]), *count[usize.from(lens[i])] + 1u32); } i += 1usize; }
  mut next = List[u32].empty();
  i = 0usize;
  while i < 17usize { next.push(0u32); i += 1usize; }
  mut code = 0u32;
  i = 1usize;
  while i < 16usize {
    code = (code + *count[i - 1usize]) << 1u32;
    next.set(i, code);
    i += 1usize;
  }
  mut codes = List[u32].empty();
  i = 0usize;
  while i < n {
    imm l = usize.from(lens[i]);
    if l > 0usize {
      codes.push(*next[l]);
      next.set(l, *next[l] + 1u32);
    } else {
      codes.push(0u32);
    }
    i += 1usize;
  }
  codes;
}

fn makeCode(lens List[u8]) Code {
  imm codes = canonicalCodes(lens.view(), lens.len());
  new Code(lens, codes);
}

// The length code (257 to 285) and the extra bits a match length takes
fn lengthSymbol(len usize) usize {
  mut s = 28usize;
  while usize.from(lenBase[s]) > len { s -= 1usize; }
  s;
}

fn distSymbol(d usize) usize {
  mut s = 29usize;
  while usize.from(distBase[s]) > d { s -= 1usize; }
  s;
}

// The LZ77 pass: tokens are a literal byte (value < 256) or a match
// (0x80000000 | length << 16 | distance)
fn lz77(data &Array[u8], tokens &mut List[u32], chainLimit usize) {
  imm n = data.len;
  imm hashSize = 1usize << 15usize;
  mut head = List[i32].withCapacity(hashSize);
  mut i = 0usize;
  while i < hashSize { head.push(-1i32); i += 1usize; }
  mut prev = List[i32].withCapacity(n);
  i = 0usize;
  while i < n { prev.push(-1i32); i += 1usize; }
  i = 0usize;
  while i < n {
    mut bestLen = 0usize;
    mut bestDist = 0usize;
    if i + 3usize <= n {
      imm h = hash3(data, i);
      mut cand = *head[h];
      mut chain = 0usize;
      while cand >= 0i32 and chain < chainLimit {
        imm c = usize.from(cand);
        if i - c > 32768usize { break; }
        // Match length at this candidate
        mut l = 0usize;
        while l < 258usize and i + l < n and data[c + l] == data[i + l] { l += 1usize; }
        if l > bestLen {
          bestLen = l;
          bestDist = i - c;
          if l == 258usize { break; }
        }
        cand = *prev[c];
        chain += 1usize;
      }
    }
    if bestLen >= 3usize {
      tokens.push(0x80000000u32 | (u32.from(bestLen) << 16u32) | u32.from(bestDist));
      // Insert every position the match covers
      mut k = 0usize;
      while k < bestLen {
        if i + k + 3usize <= n {
          imm h = hash3(data, i + k);
          prev.set(i + k, *head[h]);
          head.set(h, i32.from(i + k));
        }
        k += 1usize;
      }
      i += bestLen;
    } else {
      tokens.push(u32.from(data[i]));
      if i + 3usize <= n {
        imm h = hash3(data, i);
        prev.set(i, *head[h]);
        head.set(h, i32.from(i));
      }
      i += 1usize;
    }
  }
}

fn hash3(d &Array[u8], i usize) usize {
  usize.from(((u32.from(d[i]) << 10u32) ^ (u32.from(d[i + 1usize]) << 5u32) ^ u32.from(d[i + 2usize])) & 32767u32);
}

// Write tokens [from, to) with the codes (the end-of-block code is added)
fn writeTokens(w &mut BitWriter, tokens &Array[u32], from usize, to usize, lit &Code, dist &Code) {
  mut i = from;
  while i < to {
    imm t = tokens[i];
    if (t & 0x80000000u32) == 0u32 {
      w.putCode(*lit.codes[usize.from(t)], u32.from(*lit.lens[usize.from(t)]));
    } else {
      imm len = usize.from((t >> 16u32) & 0x7FFFu32);
      imm d = usize.from(t & 0xFFFFu32);
      imm ls = lengthSymbol(len);
      w.putCode(*lit.codes[257usize + ls], u32.from(*lit.lens[257usize + ls]));
      w.put(u32.from(len - usize.from(lenBase[ls])), u32.from(lenExtra[ls]));
      imm ds = distSymbol(d);
      w.putCode(*dist.codes[ds], u32.from(*dist.lens[ds]));
      w.put(u32.from(d - usize.from(distBase[ds])), u32.from(distExtra[ds]));
    }
    i += 1usize;
  }
  w.putCode(*lit.codes[256usize], u32.from(*lit.lens[256usize]));
}

fn fixedCodes(lit &mut Code, dist &mut Code) {
  mut l = List[u8].empty();
  mut i = 0usize;
  while i < 288usize {
    l.push(if i < 144usize {8u8;} elif i < 256usize {9u8;} elif i < 280usize {7u8;} else {8u8;});
    i += 1usize;
  }
  *lit = makeCode(l);
  mut d = List[u8].empty();
  i = 0usize;
  while i < 30usize { d.push(5u8); i += 1usize; }
  *dist = makeCode(d);
}

// A dynamic block of tokens [from, to)
fn writeDynamicBlock(w &mut BitWriter, tokens &Array[u32], from usize, to usize, last bool) {
  mut lf = List[u32].empty();
  mut i = 0usize;
  while i < 286usize { lf.push(0u32); i += 1usize; }
  mut df = List[u32].empty();
  i = 0usize;
  while i < 30usize { df.push(0u32); i += 1usize; }
  lf.set(256usize, 1u32);
  i = from;
  while i < to {
    imm t = tokens[i];
    if (t & 0x80000000u32) == 0u32 {
      lf.set(usize.from(t), *lf[usize.from(t)] + 1u32);
    } else {
      imm ls = 257usize + lengthSymbol(usize.from((t >> 16u32) & 0x7FFFu32));
      lf.set(ls, *lf[ls] + 1u32);
      imm ds = distSymbol(usize.from(t & 0xFFFFu32));
      df.set(ds, *df[ds] + 1u32);
    }
    i += 1usize;
  }
  imm lit = makeCode(huffmanLengths(lf.view(), 286usize, 15u8));
  imm dist = makeCode(huffmanLengths(df.view(), 30usize, 15u8));
  // Trim trailing unused lengths (at least 257 literal/length, 1 distance)
  mut nlen = 286usize;
  while nlen > 257usize and *lit.lens[nlen - 1usize] == 0u8 { nlen -= 1usize; }
  mut ndist = 30usize;
  while ndist > 1usize and *dist.lens[ndist - 1usize] == 0u8 { ndist -= 1usize; }
  // The lengths as a run-length coded sequence of code-length symbols
  mut seq = List[u8].empty();       // symbol
  mut extra = List[u8].empty();     // its extra-bits value
  mut all = List[u8].empty();
  i = 0usize;
  while i < nlen { all.push(*lit.lens[i]); i += 1usize; }
  i = 0usize;
  while i < ndist { all.push(*dist.lens[i]); i += 1usize; }
  i = 0usize;
  while i < all.len() {
    imm v = *all[i];
    mut run = 1usize;
    while i + run < all.len() and *all[i + run] == v { run += 1usize; }
    if v == 0u8 and run >= 3usize {
      imm r = if run > 138usize {138usize;} else {run;};
      if r >= 11usize { seq.push(18u8); extra.push(u8.from(r - 11usize)); }
      else { seq.push(17u8); extra.push(u8.from(r - 3usize)); }
      i += r;
    } elif v != 0u8 and run >= 4usize {
      // The length itself once, then repeats of 3 to 6
      seq.push(v);
      extra.push(0u8);
      mut rest = run - 1usize;
      i += 1usize;
      while rest >= 3usize {
        imm r = if rest > 6usize {6usize;} else {rest;};
        seq.push(16u8);
        extra.push(u8.from(r - 3usize));
        rest -= r;
        i += r;
      }
      while rest > 0usize { seq.push(v); extra.push(0u8); rest -= 1usize; i += 1usize; }
    } else {
      seq.push(v);
      extra.push(0u8);
      i += 1usize;
    }
  }
  mut cf = List[u32].empty();
  i = 0usize;
  while i < 19usize { cf.push(0u32); i += 1usize; }
  i = 0usize;
  while i < seq.len() { cf.set(usize.from(*seq[i]), *cf[usize.from(*seq[i])] + 1u32); i += 1usize; }
  imm cl = makeCode(huffmanLengths(cf.view(), 19usize, 7u8));
  mut ncode = 19usize;
  while ncode > 4usize and *cl.lens[usize.from(clOrder[ncode - 1usize])] == 0u8 { ncode -= 1usize; }

  w.put(if last {1u32;} else {0u32;}, 1u32);
  w.put(2u32, 2u32);
  w.put(u32.from(nlen - 257usize), 5u32);
  w.put(u32.from(ndist - 1usize), 5u32);
  w.put(u32.from(ncode - 4usize), 4u32);
  i = 0usize;
  while i < ncode { w.put(u32.from(*cl.lens[usize.from(clOrder[i])]), 3u32); i += 1usize; }
  i = 0usize;
  while i < seq.len() {
    imm s = usize.from(*seq[i]);
    w.putCode(*cl.codes[s], u32.from(*cl.lens[s]));
    if s == 16usize { w.put(u32.from(*extra[i]), 2u32); }
    elif s == 17usize { w.put(u32.from(*extra[i]), 3u32); }
    elif s == 18usize { w.put(u32.from(*extra[i]), 7u32); }
    i += 1usize;
  }
  writeTokens(w, tokens, from, to, &lit, &dist);
}

// Compress to a raw DEFLATE stream at 'level' (0 stored, 1 fixed Huffman,
// 2 dynamic Huffman; other values are 2)
pub fn deflate(data &Array[u8], level i32) List[u8] {
  mut w = new BitWriter(List[u8].withCapacity(data.len / 2usize + 64usize), 0u64, 0u32);
  if level == 0 {
    // Stored blocks of at most 65535 bytes (an empty input is one empty block)
    mut pos = 0usize;
    while true {
      imm n = if data.len - pos > 65535usize {65535usize;} else {data.len - pos;};
      imm last = pos + n >= data.len;
      w.put(if last {1u32;} else {0u32;}, 1u32);
      w.put(0u32, 2u32);
      w.align();
      w.put(u32.from(n), 16u32);
      w.put(u32.from(n) ^ 0xFFFFu32, 16u32);
      mut k = 0usize;
      while k < n { w.out.push(data[pos + k]); k += 1usize; }
      pos += n;
      if last { break; }
    }
    mut res = List[u8].empty();
    res <=> w.out;
    return res;
  }
  mut tokens = List[u32].empty();
  lz77(data, &mut tokens, if level == 1 {16usize;} else {48usize;});
  if level == 1 {
    mut lit = makeCode(List[u8].empty());
    mut dist = makeCode(List[u8].empty());
    fixedCodes(&mut lit, &mut dist);
    w.put(1u32, 1u32);
    w.put(1u32, 2u32);
    writeTokens(&mut w, tokens.view(), 0usize, tokens.len(), &lit, &dist);
  } else {
    // Blocks of 32768 tokens
    mut from = 0usize;
    while true {
      imm to = if tokens.len() - from > 32768usize {from + 32768usize;} else {tokens.len();};
      writeDynamicBlock(&mut w, tokens.view(), from, to, to == tokens.len());
      from = to;
      if from >= tokens.len() { break; }
    }
  }
  w.align();
  mut res = List[u8].empty();
  res <=> w.out;
  // Data that does not compress is stored, as zlib does
  if res.len() > data.len + 5usize * (data.len / 65535usize + 1usize) { return deflate(data, 0); }
  res;
}

// Compress to a zlib stream (header, DEFLATE, Adler-32), 32 KiB window,
// header 78 01 for stored, 78 9C otherwise
pub fn zlibCompress(data &Array[u8], level i32) List[u8] {
  mut out = List[u8].empty();
  out.push(0x78u8);
  out.push(if level == 0 {0x01u8;} else {0x9Cu8;});
  imm body = deflate(data, level);
  mut i = 0usize;
  while i < body.len() { out.push(*body[i]); i += 1usize; }
  imm a = adler32(data);
  out.push(u8.from(a >> 24u32));
  out.push(u8.from((a >> 16u32) & 255u32));
  out.push(u8.from((a >> 8u32) & 255u32));
  out.push(u8.from(a & 255u32));
  out;
}
