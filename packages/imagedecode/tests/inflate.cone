8, 101u8, 116u8, 97u8, 32u8, 98u8, 138u8, 19u8, 107u8, 159u8];
imm zE Array[u8, 8] = [120u8, 156u8, 3u8, 0u8, 0u8, 0u8, 0u8, 1u8];
imm zHello Array[u8, 16] = [120u8, 218u8, 203u8, 72u8, 205u8, 201u8, 201u8, 87u8, 200u8, 64u8, 144u8, 0u8, 58u8, 46u8, 6u8, 125u8];
imm zAbc Array[u8, 13] = [120u8, 218u8, 75u8, 76u8, 74u8, 78u8, 68u8, 69u8, 0u8, 65u8, 124u8, 6u8, 229u8];

// The generators the oracle's data came from: a linear congruential
// generator (glibc's constants) taking the bits above the low 8
fn nextRand(s &mut u64) u64 {
  *s = (*s * 1103515245u64 + 12345u64) & 0x7FFFFFFFu64;
  *s >> 8u64;
}

fn genA(n usize) List[u8] {
  imm words Array[&str, 12] = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu"];
  mut s = 7u64;
  mut out = List[u8].empty();
  while out.len() < n {
    imm w = words[usize.from(nextRand(&mut s) % 12u64)];
    mut i = 0usize;
    while i < w.len() { out.push(w[i]); i = i + 1usize; }
    out.push(' ');
  }
  out.truncate(n);
  out;
}

fn genB(n usize) List[u8] {
  mut s = 99u64;
  mut out = List[u8].empty();
  while out.len() < n { out.push(u8.from(nextRand(&mut s) & 255u64)); }
  out;
}

fn genC(n usize) List[u8] {
  mut out = List[u8].empty();
  while out.len() < n { out.push(0u8); }
  out;
}

fn same(a &Array[u8], b &Array[u8]) bool {
  if a.len != b.len { return false; }
  mut i = 0usize;
  while i < a.len {
    if a[i] != b[i] { return false; }
    i = i + 1usize;
  }
  true;
}

// Decode 'z' and compare with 'want'
fn check(z &Array[u8], want &List[u8], label &str) {
  match zlibDecompress(z, want.len()) {
    case imm ok Ok { expect(same(ok.view(), want.view()), label); }
    case imm e Error { expect(false, label); }
  }
  // and with the size not given
  match zlibDecompress(z, 0usize) {
    case imm ok Ok { expect(same(ok.view(), want.view()), label); }
    case imm e Error { expect(false, label); }
  }
}

fn refused(z &Array[u8], label &str) {
  match zlibDecompress(z, 0usize) {
    case imm ok Ok { expect(false, label); }
    case imm e Error { expect(e.reason.len() > 0usize, label); }
  }
}

fn copyOf(a &Array[u8]) List[u8] {
  mut out = List[u8].empty();
  mut i = 0usize;
  while i < a.len { out.push(a[i]); i = i + 1usize; }
  out;
}

fn main() i32 {
  imm a = genA(3000usize);
  check(&zA9, &a, "level 9 words");
  check(&zA1, &a, "level 1 words");
  check(&zA6, &a, "level 6 words");
  imm b = genB(600usize);
  check(&zB6, &b, "random bytes");
  imm c = genC(5000usize);
  check(&zC9, &c, "5000 zeros");
  imm a300 = genA(300usize);
  check(&zA0, &a300, "stored block");
  check(&zE, &List[u8].empty(), "empty");
  imm h = copyOf("hello hello hello");
  check(&zHello, &h, "fixed Huffman hello");
  imm abc = copyOf("abcabcabcabcabcabc");
  check(&zAbc, &abc, "fixed Huffman abc");

  // Adler-32 and CRC-32 of "Wikipedia" / "123456789", the published values
  expectUInt(u64.from(adler32("Wikipedia")), 0x11E60398u64, "adler32 Wikipedia");
  imm crc = Crc32.make();
  expectUInt(u64.from(crc.update(0u32, "123456789", 0usize, 9usize)), 0xCBF43926u64, "crc32 check value");
  // CRC continues across pieces
  imm part = crc.update(0u32, "123456789", 0usize, 4usize);
  expectUInt(u64.from(crc.update(part, "123456789", 4usize, 9usize)), 0xCBF43926u64, "crc32 in two pieces");

  // Corrupt streams
  mut bad = copyOf(&zA9);
  bad.set(100usize, *bad[100usize] ^ 0x55u8);
  refused(bad.view(), "a flipped byte");
  mut cut = copyOf(&zA9);
  cut.truncate(300usize);
  refused(cut.view(), "a cut stream");
  mut sum = copyOf(&zA9);
  imm last = sum.len() - 1usize;
  sum.set(last, *sum[last] ^ 1u8);
  refused(sum.view(), "a bad Adler-32");
  mut hdr = copyOf(&zA9);
  hdr.set(1usize, 0u8);
  refused(hdr.view(), "a bad header check");
  mut garbage = List[u8].empty();
  mut i = 0usize;
  while i < 200usize { garbage.push(u8.from((i * 37usize + 11usize) & 255usize)); i = i + 1usize; }
  garbage.set(0usize, 0x78u8);
  garbage.set(1usize, 0x9Cu8);
  refused(garbage.view(), "garbage after a valid header");
  done();
}
