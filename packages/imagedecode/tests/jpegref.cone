// JPEG against a reference decode. The files in tests/data were made by
// tests/data/make_jpeg.py and make_jpeg2.py: small synthetic pictures (gradients, discs, a
// diagonal, text and speckle, drawn by Pillow, no downloaded content) saved by
// Pillow's libjpeg-turbo in each mode this decoder supports, beside a PNG of
// what libjpeg-turbo itself decodes the file to (RGB, fancy upsampling, the
// "islow" IDCT; the oracle, used only to make those files). This test
// decodes the JPEG and the PNG with this package and compares every channel
// of every pixel: no difference over 2 allowed.
//
//   b444 b422 b420      baseline at three subsamplings, 61 x 43 (a partial MCU
//                       at the right and bottom edges for the subsampled ones)
//   gray                one component
//   p444 p422 p420      progressive (spectral selection and successive
//   pgray               approximation), the same pictures
//   opt420              custom Huffman tables ("optimize")
//   q5 q100             the extremes of quantisation
//   odd420 odd422p      130 x 97: odd sizes
//   b440 b411 bmix b441 b4h3  samplings Pillow cannot write, from a small encoder in the oracle script: 4:4:0, 4:1:1, a mix of horizontal and vertical halving, 4:2:2 with restarts, and a 3:1 that no fancy filter covers
//   rst420 rstp420      restart intervals, baseline and progressive
//   orient2 ... orient8 the Exif orientations on a 40 x 24 picture; the
//                       reference is the picture turned upright
//
// To regenerate the data (Pillow needed only for that, never to run tests): in
// tests/data run "python make_jpeg.py ." then "python make_jpeg2.py ." (each script says what it makes).
// The data files are found from the test's own folder, build/<mode>/tests/<name>.

mod jpegref;

import testing use *;
import collections use *;
import imagedecode use *;
import fs;
import path use Path;
import stdio use *;

fn readData(name: &str) String {
  var p = String.from("../../../../tests/data/");
  p.append(name);
  let path = Path.from(p.view());
  match fs.readFile(&path) {
    case var ok Ok {
      var out = String.empty();
      out <-> ok;
      return out;
    }
    case let e Error { return String.empty(); }
  }
}

// The largest difference in any channel between two pictures, or 1000 if
// they differ in size
fn maxDiff(a: &Raster, b: &Raster) i32 {
  if a.width != b.width || a.height != b.height || a.depth != 8 || b.depth != 8 { return 1000i32; }
  var worst = 0i32;
  var i = 0usize;
  while i < a.pixels8.len() {
    // Compare red, green and blue; alpha is full in both
    let d = i32.from(*a.pixels8[i]) - i32.from(*b.pixels8[i]);
    let m = if d < 0i32 {-d} else {d};
    if m > worst { worst = m; }
    i += 1usize;
  }
  worst
}

fn check(name: &str, tolerance: i32) {
  var jn = String.from(name);
  jn.append(".jpg");
  var pn = String.from(name);
  pn.append(".png");
  let jpg = readData(jn.view());
  let png = readData(pn.view());
  if !expect(jpg.len() > 0usize && png.len() > 0usize, jn.view()) { return; }
  var a = Raster.empty();
  match decodeJpeg(jpg.view()) {
    case var ok Ok { a <-> ok; }
    case let e Error { expect(false, jn.view()); return; }
  }
  var b = Raster.empty();
  match decodePng(png.view()) {
    case var ok Ok { b <-> ok; }
    case let e Error { expect(false, pn.view()); return; }
  }
  let worst = maxDiff(&a, &b);
  printStr(name);
  printStr(": largest difference ");
  printInt(i64.from(worst));
  printStr("\n");
  expect(worst <= tolerance, jn.view());
}

// cmyk.jpg: a 32 x 16 CMYK picture written by Pillow (inverted, Adobe-marked):
// cyan x * 8, magenta y * 16, yellow 128, black 20 on the left half and 0 on
// the right. Red is (1 - c)(1 - k) and so on; JPEG at quality 95 is within 8.
fn checkCmyk() {
  let jpg = readData("cmyk.jpg");
  match decodeJpeg(jpg.view()) {
    case let r Ok {
      var worst = 0i32;
      var y = 0;
      while y < 16 {
        var x = 0;
        while x < 32 {
          let k = if x < 16 {20i32} else {0i32};
          let c = x * 8;
          let m = y * 16;
          let yl = 128;
          let er = (255 - c) * (255 - k) / 255;
          let eg = (255 - m) * (255 - k) / 255;
          let eb = (255 - yl) * (255 - k) / 255;
          let dr = i32.from(r.at8(x, y, 0)) - er;
          let dg = i32.from(r.at8(x, y, 1)) - eg;
          let db = i32.from(r.at8(x, y, 2)) - eb;
          let ar = if dr < 0 {-dr} else {dr};
          let ag = if dg < 0 {-dg} else {dg};
          let ab = if db < 0 {-db} else {db};
          if ar > worst { worst = ar; }
          if ag > worst { worst = ag; }
          if ab > worst { worst = ab; }
          x += 1;
        }
        y += 1;
      }
      printStr("cmyk: largest difference from the CMYK formula ");
      printInt(i64.from(worst));
      printStr("\n");
      expect(worst <= 8i32, "cmyk.jpg");
    }
    case let e Error { expect(false, "cmyk.jpg decodes"); }
  }
}

fn main() i32 {
  checkCmyk();
  check("b444", 2i32);
  check("b422", 2i32);
  check("b420", 2i32);
  check("gray", 2i32);
  check("p444", 2i32);
  check("p422", 2i32);
  check("p420", 2i32);
  check("pgray", 2i32);
  check("opt420", 2i32);
  check("q5", 2i32);
  check("q100", 2i32);
  check("odd420", 2i32);
  check("odd422p", 2i32);
  check("rst420", 2i32);
  check("rstp420", 2i32);
  check("b440", 2i32);
  check("b411", 2i32);
  check("bmix", 2i32);
  check("b441", 2i32);
  check("b4h3", 2i32);
  check("orient2", 2i32);
  check("orient3", 2i32);
  check("orient4", 2i32);
  check("orient5", 2i32);
  check("orient6", 2i32);
  check("orient7", 2i32);
  check("orient8", 2i32);
  done()
}
