// ---- The OpenXR loader, found when it is first wanted ----
//
// 'load' opens the OpenXR loader (openxr_loader.dll; libopenxr_loader.so.1;
// libopenxr_loader.dylib), takes xrGetInstanceProcAddr from it, and finds the
// three functions needing no instance (the API layers and the instance's
// extensions, and xrCreateInstance), once. It is the first use of the package
// that does it: 'available' calls it, and so does each global-level function
// and 'InstanceFns.load'. The module's 'init' does not, so a program that
// imports the package (every program that links render does) and never opens a
// headset never asks the OS for openxr_loader.dll and pays nothing at start-up
// ('loadAttempted' says whether it has). A machine with no loader is not an
// error here: 'available' is false, and whoever makes the instance reports it.
// A loader with no runtime behind it is found here too, and answers later: the
// extension query returns 'ERROR_RUNTIME_UNAVAILABLE' and 'createInstance' fails
// the same way. The instance's functions are not global: each belongs to the
// instance it was found for ('InstanceFns').

extern {
  fn @initpure @c(system) LoadLibraryA(name: *u8) usize;
  fn @initpure @c(system) GetProcAddress(module: usize, name: *u8) usize;
  fn @initpure @c dlopen(name: *u8, flags: i32) usize;
  fn @initpure @c dlsym(handle: usize, name: *u8) usize;
}

// dlopen's RTLD_NOW: Linux's and macOS's value alike
const rtldNow = 2i32;

// The OpenXR loader library of this OS, opened: 0 if there is none
fn openLoader() usize {
  if isWindows() {
    return LoadLibraryA(&"openxr_loader.dll" as *u8);
  }
  if isMacOS() {
    var h = dlopen(&"libopenxr_loader.1.dylib" as *u8, rtldNow);
    if h == 0usize { h = dlopen(&"libopenxr_loader.dylib" as *u8, rtldNow); }
    return h;
  }
  dlopen(&"libopenxr_loader.so.1" as *u8, rtldNow)
}

// A function of the opened loader library
fn loaderSymbol(library: usize, name: *u8) usize {
  if isWindows() { GetProcAddress(library, name) } else { dlsym(library, name) }
}

// What 'load' found, kept where every thread may read it: the state (0 not
// tried, 1 being tried by a thread, 2 done) and the global-level functions'
// addresses, atomics because 'init' cannot know the loader (it is not opened
// until wanted) and a global may be changed after start-up only so
let loadState: Atomic[u32];
let foundGipa: Atomic[usize];
let foundEnumLayers: Atomic[usize];
let foundEnumExtensions: Atomic[usize];
let foundCreateInstance: Atomic[usize];
let foundMissing: Atomic[u32];

fn @initpure init() {
  loadState = Atomic[u32].of(0u32);
  foundGipa = Atomic[usize].of(0usize);
  foundEnumLayers = Atomic[usize].of(0usize);
  foundEnumExtensions = Atomic[usize].of(0usize);
  foundCreateInstance = Atomic[usize].of(0usize);
  foundMissing = Atomic[u32].of(0u32);
}

// Open the loader and find the global-level functions, the first time any
// thread asks; a thread asking while another is doing it waits until it is
// done (it takes a few milliseconds)
fn ensureLoaded() {
  if loadState.load() == 2u32 { return; }
  let _, mine = loadState.compareSwap(0u32, 1u32);
  if !mine {
    while loadState.load() != 2u32 {}
    return;
  }
  let library = openLoader();
  var gipa = 0usize;
  if library != 0usize { gipa = loaderSymbol(library, &"xrGetInstanceProcAddr" as *u8); }
  let found = GlobalFns.find(gipa as *u8 as PFN_GetInstanceProcAddr);
  foundGipa.store(found.pfnGetInstanceProcAddr);
  foundEnumLayers.store(found.pfnEnumerateApiLayerProperties);
  foundEnumExtensions.store(found.pfnEnumerateInstanceExtensionProperties);
  foundCreateInstance.store(found.pfnCreateInstance);
  foundMissing.store(found.missing);
  loadState.store(2u32);
}

// The global-level functions as 'load' found them (it is run first, if it has
// not been): nothing found when there is no OpenXR loader
fn globalFns() GlobalFns {
  ensureLoaded();
  var t = GlobalFns();
  t.pfnGetInstanceProcAddr = foundGipa.load();
  t.pfnEnumerateApiLayerProperties = foundEnumLayers.load();
  t.pfnEnumerateInstanceExtensionProperties = foundEnumExtensions.load();
  t.pfnCreateInstance = foundCreateInstance.load();
  t.missing = foundMissing.load();
  t
}

// Whether 'load' has been run in this program, by a call to it, to 'available'
// or to anything that needs the loader. A program that never opens a headset
// leaves it false: nothing asked the OS for the loader's library.
pub fn loadAttempted() bool { loadState.load() != 0u32 }

// Open the OpenXR loader if that has not been done, and answer whether it was
// found and gave every global-level function: the same as 'available', named
// for what it does the first time. Nothing but the first call (or the first
// call of 'available') opens anything.
pub fn load() bool {
  let g = globalFns();
  g.pfnGetInstanceProcAddr != 0usize && g.missing == 0u32
}

// Whether the OpenXR loader was found and gave every global-level function
// (opening it first, if 'load' has not). This says nothing about a runtime:
// the loader reports that later, when the instance is made. When it is false,
// calling 'createInstance' and the other global-level functions calls address
// 0 and crashes: check this first.
pub fn available() bool { load() }

// Look a function up through an xrGetInstanceProcAddr: its address, or 0
// where the loader or the runtime does not have it
fn lookup(getInstanceProcAddr: PFN_GetInstanceProcAddr, instance: Instance, name: *u8) usize {
  var address = 0usize;
  let r = getInstanceProcAddr(instance, name, &mut address);
  if r < 0i32 { return 0usize; }
  address
}

// The functions needing no instance. 'init' finds them through the OS loader;
// 'find' takes any xrGetInstanceProcAddr, which is how a test stands one in.
pub struct GlobalFns {
  pfnGetInstanceProcAddr: usize = 0usize;
  pfnEnumerateApiLayerProperties: usize = 0usize;
  pfnEnumerateInstanceExtensionProperties: usize = 0usize;
  pfnCreateInstance: usize = 0usize;
  // How many of its functions were not found
  pub missing: u32 = 0u32;

  // Keep 'getInstanceProcAddr' and look the other three up through it. A null
  // one gives a table with nothing found and nothing counted missing
  pub fn find(getInstanceProcAddr: PFN_GetInstanceProcAddr) GlobalFns {
    var t = GlobalFns();
    if getInstanceProcAddr as usize == 0usize { return t; }
    var missing = 0u32;
    t.pfnGetInstanceProcAddr = getInstanceProcAddr as usize;
    let none = 0usize as Instance;
    t.pfnEnumerateApiLayerProperties = lookup(getInstanceProcAddr, none, &"xrEnumerateApiLayerProperties" as *u8);
    if t.pfnEnumerateApiLayerProperties == 0usize { missing = missing + 1u32; }
    t.pfnEnumerateInstanceExtensionProperties = lookup(getInstanceProcAddr, none, &"xrEnumerateInstanceExtensionProperties" as *u8);
    if t.pfnEnumerateInstanceExtensionProperties == 0usize { missing = missing + 1u32; }
    t.pfnCreateInstance = lookup(getInstanceProcAddr, none, &"xrCreateInstance" as *u8);
    if t.pfnCreateInstance == 0usize { missing = missing + 1u32; }
    t.missing = missing;
    t
  }

  pub fn getInstanceProcAddr(self: &, instance: Instance, name: *u8, function: &mut usize) i32 {
    (pfnGetInstanceProcAddr as *u8 as PFN_GetInstanceProcAddr)(instance, name, function)
  }
  pub fn enumerateApiLayerProperties(self: &, propertyCapacityInput: u32, propertyCountOutput: &mut u32,
    properties: *ApiLayerProperties) i32 {
    (pfnEnumerateApiLayerProperties as *u8 as PFN_EnumerateApiLayerProperties)(propertyCapacityInput,
      propertyCountOutput, properties)
  }
  pub fn enumerateInstanceExtensionProperties(self: &, layerName: *u8, propertyCapacityInput: u32,
    propertyCountOutput: &mut u32, properties: *ExtensionProperties) i32 {
    (pfnEnumerateInstanceExtensionProperties as *u8 as PFN_EnumerateInstanceExtensionProperties)(layerName,
      propertyCapacityInput, propertyCountOutput, properties)
  }
  pub fn createInstance(self: &, createInfo: &InstanceCreateInfo, instance: &mut Instance) i32 {
    (pfnCreateInstance as *u8 as PFN_CreateInstance)(createInfo, instance)
  }
}

// ---- The global-level functions, called on what 'init' found ----

pub fn getInstanceProcAddr(instance: Instance, name: *u8, function: &mut usize) i32 {
  globalFns().getInstanceProcAddr(instance, name, function)
}
pub fn enumerateApiLayerProperties(propertyCapacityInput: u32, propertyCountOutput: &mut u32,
  properties: *ApiLayerProperties) i32 {
  globalFns().enumerateApiLayerProperties(propertyCapacityInput, propertyCountOutput, properties)
}
pub fn enumerateInstanceExtensionProperties(layerName: *u8, propertyCapacityInput: u32, propertyCountOutput: &mut u32,
  properties: *ExtensionProperties) i32 {
  globalFns().enumerateInstanceExtensionProperties(layerName, propertyCapacityInput, propertyCountOutput, properties)
}
pub fn createInstance(createInfo: &InstanceCreateInfo, instance: &mut Instance) i32 {
  globalFns().createInstance(createInfo, instance)
}

// The loader's xrGetInstanceProcAddr as an address (0 when there is no loader):
// what a runtime-neutral helper hands to a function that wants one
pub fn getInstanceProcAddrAddress() usize { globalFns().pfnGetInstanceProcAddr }
