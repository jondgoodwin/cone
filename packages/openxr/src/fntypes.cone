// ---- The functions, as function-reference types ----
//
// An alias each, as the vulkan package has them: the type 'load' casts an
// address to. Each is '&fn @c': the address is OpenXR's, a C function, called
// as C calls it (XRAPI_CALL is __stdcall in the header, which on 64-bit Windows
// is the one convention there is). An XrResult is an i32, an XrTime and an
// XrDuration an i64, a handle a pointer, an atom (XrSystemId, XrPath) a u64.

// The one function found by the OS's loader: every other is found through it.
// PFN_xrVoidFunction is a function pointer, written here as the address, usize.
pub alias PFN_GetInstanceProcAddr = &fn @c (instance: Instance, name: *u8, function: &mut usize) i32;

// Global: need no instance, found by xrGetInstanceProcAddr with a null instance
pub alias PFN_EnumerateApiLayerProperties = &fn @c (propertyCapacityInput: u32, propertyCountOutput: &mut u32,
  properties: *ApiLayerProperties) i32;
pub alias PFN_EnumerateInstanceExtensionProperties = &fn @c (layerName: *u8, propertyCapacityInput: u32,
  propertyCountOutput: &mut u32, properties: *ExtensionProperties) i32;
pub alias PFN_CreateInstance = &fn @c (createInfo: &InstanceCreateInfo, instance: &mut Instance) i32;

pub alias PFN_DestroyInstance = &fn @c (instance: Instance) i32;
pub alias PFN_GetInstanceProperties = &fn @c (instance: Instance, instanceProperties: &mut InstanceProperties) i32;
pub alias PFN_PollEvent = &fn @c (instance: Instance, eventData: &mut EventDataBuffer) i32;
pub alias PFN_ResultToString = &fn @c (instance: Instance, value: i32, buffer: *u8) i32;
pub alias PFN_StructureTypeToString = &fn @c (instance: Instance, value: i32, buffer: *u8) i32;
pub alias PFN_GetSystem = &fn @c (instance: Instance, getInfo: &SystemGetInfo, systemId: &mut u64) i32;
pub alias PFN_GetSystemProperties = &fn @c (instance: Instance, systemId: u64, properties: &mut SystemProperties) i32;
pub alias PFN_EnumerateEnvironmentBlendModes = &fn @c (instance: Instance, systemId: u64,
  viewConfigurationType: i32, environmentBlendModeCapacityInput: u32,
  environmentBlendModeCountOutput: &mut u32, environmentBlendModes: *i32) i32;
pub alias PFN_CreateSession = &fn @c (instance: Instance, createInfo: &SessionCreateInfo, session: &mut Session) i32;
pub alias PFN_DestroySession = &fn @c (session: Session) i32;
pub alias PFN_EnumerateReferenceSpaces = &fn @c (session: Session, spaceCapacityInput: u32,
  spaceCountOutput: &mut u32, spaces: *i32) i32;
pub alias PFN_CreateReferenceSpace = &fn @c (session: Session, createInfo: &ReferenceSpaceCreateInfo,
  space: &mut Space) i32;
pub alias PFN_GetReferenceSpaceBoundsRect = &fn @c (session: Session, referenceSpaceType: i32,
  bounds: &mut Extent2Df) i32;
pub alias PFN_LocateSpace = &fn @c (space: Space, baseSpace: Space, time: i64, location: &mut SpaceLocation) i32;
pub alias PFN_DestroySpace = &fn @c (space: Space) i32;
pub alias PFN_EnumerateViewConfigurations = &fn @c (instance: Instance, systemId: u64,
  viewConfigurationTypeCapacityInput: u32, viewConfigurationTypeCountOutput: &mut u32,
  viewConfigurationTypes: *i32) i32;
pub alias PFN_GetViewConfigurationProperties = &fn @c (instance: Instance, systemId: u64,
  viewConfigurationType: i32, configurationProperties: &mut ViewConfigurationProperties) i32;
pub alias PFN_EnumerateViewConfigurationViews = &fn @c (instance: Instance, systemId: u64,
  viewConfigurationType: i32, viewCapacityInput: u32, viewCountOutput: &mut u32, views: *ViewConfigurationView) i32;
pub alias PFN_EnumerateSwapchainFormats = &fn @c (session: Session, formatCapacityInput: u32,
  formatCountOutput: &mut u32, formats: *i64) i32;
pub alias PFN_CreateSwapchain = &fn @c (session: Session, createInfo: &SwapchainCreateInfo,
  swapchain: &mut Swapchain) i32;
pub alias PFN_DestroySwapchain = &fn @c (swapchain: Swapchain) i32;
pub alias PFN_EnumerateSwapchainImages = &fn @c (swapchain: Swapchain, imageCapacityInput: u32,
  imageCountOutput: &mut u32, images: *SwapchainImageBaseHeader) i32;
pub alias PFN_AcquireSwapchainImage = &fn @c (swapchain: Swapchain, acquireInfo: &SwapchainImageAcquireInfo,
  index: &mut u32) i32;
pub alias PFN_WaitSwapchainImage = &fn @c (swapchain: Swapchain, waitInfo: &SwapchainImageWaitInfo) i32;
pub alias PFN_ReleaseSwapchainImage = &fn @c (swapchain: Swapchain, releaseInfo: &SwapchainImageReleaseInfo) i32;
pub alias PFN_BeginSession = &fn @c (session: Session, beginInfo: &SessionBeginInfo) i32;
pub alias PFN_EndSession = &fn @c (session: Session) i32;
pub alias PFN_RequestExitSession = &fn @c (session: Session) i32;
pub alias PFN_WaitFrame = &fn @c (session: Session, frameWaitInfo: &FrameWaitInfo, frameState: &mut FrameState) i32;
pub alias PFN_BeginFrame = &fn @c (session: Session, frameBeginInfo: &FrameBeginInfo) i32;
pub alias PFN_EndFrame = &fn @c (session: Session, frameEndInfo: &FrameEndInfo) i32;
pub alias PFN_LocateViews = &fn @c (session: Session, viewLocateInfo: &ViewLocateInfo,
  viewState: &mut ViewState, viewCapacityInput: u32, viewCountOutput: &mut u32, views: *View) i32;
pub alias PFN_StringToPath = &fn @c (instance: Instance, pathString: *u8, path: &mut u64) i32;
pub alias PFN_PathToString = &fn @c (instance: Instance, path: u64, bufferCapacityInput: u32,
  bufferCountOutput: &mut u32, buffer: *u8) i32;
pub alias PFN_CreateActionSet = &fn @c (instance: Instance, createInfo: &ActionSetCreateInfo, actionSet: &mut ActionSet) i32;
pub alias PFN_DestroyActionSet = &fn @c (actionSet: ActionSet) i32;
pub alias PFN_CreateAction = &fn @c (actionSet: ActionSet, createInfo: &ActionCreateInfo, action: &mut Action) i32;
pub alias PFN_DestroyAction = &fn @c (action: Action) i32;
pub alias PFN_SuggestInteractionProfileBindings = &fn @c (instance: Instance,
  suggestedBindings: &InteractionProfileSuggestedBinding) i32;
pub alias PFN_AttachSessionActionSets = &fn @c (session: Session, attachInfo: &SessionActionSetsAttachInfo) i32;
pub alias PFN_GetCurrentInteractionProfile = &fn @c (session: Session, topLevelUserPath: u64,
  interactionProfile: &mut InteractionProfileState) i32;
pub alias PFN_GetActionStateBoolean = &fn @c (session: Session, getInfo: &ActionStateGetInfo,
  state: &mut ActionStateBoolean) i32;
pub alias PFN_GetActionStateFloat = &fn @c (session: Session, getInfo: &ActionStateGetInfo,
  state: &mut ActionStateFloat) i32;
pub alias PFN_GetActionStateVector2f = &fn @c (session: Session, getInfo: &ActionStateGetInfo,
  state: &mut ActionStateVector2f) i32;
pub alias PFN_GetActionStatePose = &fn @c (session: Session, getInfo: &ActionStateGetInfo,
  state: &mut ActionStatePose) i32;
pub alias PFN_SyncActions = &fn @c (session: Session, syncInfo: &ActionsSyncInfo) i32;
pub alias PFN_CreateActionSpace = &fn @c (session: Session, createInfo: &ActionSpaceCreateInfo, space: &mut Space) i32;
pub alias PFN_ApplyHapticFeedback = &fn @c (session: Session, hapticActionInfo: &HapticActionInfo,
  hapticFeedback: *HapticBaseHeader) i32;
pub alias PFN_StopHapticFeedback = &fn @c (session: Session, hapticActionInfo: &HapticActionInfo) i32;
pub alias PFN_CreateVulkanInstanceKHR = &fn @c (instance: Instance, createInfo: &VulkanInstanceCreateInfoKHR,
  vulkanInstance: &mut vulkan.Instance, vulkanResult: &mut i32) i32;
pub alias PFN_CreateVulkanDeviceKHR = &fn @c (instance: Instance, createInfo: &VulkanDeviceCreateInfoKHR,
  vulkanDevice: &mut vulkan.Device, vulkanResult: &mut i32) i32;
pub alias PFN_GetVulkanGraphicsDevice2KHR = &fn @c (instance: Instance,
  getInfo: &VulkanGraphicsDeviceGetInfoKHR, vulkanPhysicalDevice: &mut vulkan.PhysicalDevice) i32;
pub alias PFN_GetVulkanGraphicsRequirements2KHR = &fn @c (instance: Instance, systemId: u64,
  graphicsRequirements: &mut GraphicsRequirementsVulkanKHR) i32;
pub alias PFN_ConvertWin32PerformanceCounterToTimeKHR = &fn @c (instance: Instance, performanceCounter: *i64,
  time: &mut i64) i32;
pub alias PFN_ConvertTimeToWin32PerformanceCounterKHR = &fn @c (instance: Instance, time: i64,
  performanceCounter: &mut i64) i32;
