// ---- Constants: structure types, enumerations and flag bits ----
//
// An enumeration is i32 (C's int, and what the structs' fields hold), a flag
// set is a u64 (XrFlags64). The values are the specification's.

// XrStructureType: the structs the package declares
pub const TYPE_UNKNOWN = 0i32;
pub const TYPE_API_LAYER_PROPERTIES = 1i32;
pub const TYPE_EXTENSION_PROPERTIES = 2i32;
pub const TYPE_INSTANCE_CREATE_INFO = 3i32;
pub const TYPE_SYSTEM_GET_INFO = 4i32;
pub const TYPE_SYSTEM_PROPERTIES = 5i32;
pub const TYPE_VIEW_LOCATE_INFO = 6i32;
pub const TYPE_VIEW = 7i32;
pub const TYPE_SESSION_CREATE_INFO = 8i32;
pub const TYPE_SWAPCHAIN_CREATE_INFO = 9i32;
pub const TYPE_SESSION_BEGIN_INFO = 10i32;
pub const TYPE_VIEW_STATE = 11i32;
pub const TYPE_FRAME_END_INFO = 12i32;
pub const TYPE_EVENT_DATA_BUFFER = 16i32;
pub const TYPE_EVENT_DATA_INSTANCE_LOSS_PENDING = 17i32;
pub const TYPE_EVENT_DATA_SESSION_STATE_CHANGED = 18i32;
pub const TYPE_INSTANCE_PROPERTIES = 32i32;
pub const TYPE_FRAME_WAIT_INFO = 33i32;
pub const TYPE_COMPOSITION_LAYER_PROJECTION = 35i32;
pub const TYPE_REFERENCE_SPACE_CREATE_INFO = 37i32;
pub const TYPE_EVENT_DATA_REFERENCE_SPACE_CHANGE_PENDING = 40i32;
pub const TYPE_VIEW_CONFIGURATION_VIEW = 41i32;
pub const TYPE_SPACE_LOCATION = 42i32;
pub const TYPE_FRAME_STATE = 44i32;
pub const TYPE_VIEW_CONFIGURATION_PROPERTIES = 45i32;
pub const TYPE_FRAME_BEGIN_INFO = 46i32;
pub const TYPE_COMPOSITION_LAYER_PROJECTION_VIEW = 48i32;
pub const TYPE_EVENT_DATA_EVENTS_LOST = 49i32;
pub const TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO = 55i32;
pub const TYPE_SWAPCHAIN_IMAGE_WAIT_INFO = 56i32;
pub const TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO = 57i32;
// XR_KHR_vulkan_enable (the images and the binding are the same structs in
// XR_KHR_vulkan_enable2, whose names this package gives them)
pub const TYPE_GRAPHICS_BINDING_VULKAN_KHR = 1000025000i32;
pub const TYPE_SWAPCHAIN_IMAGE_VULKAN_KHR = 1000025001i32;
pub const TYPE_GRAPHICS_REQUIREMENTS_VULKAN_KHR = 1000025002i32;
// XR_KHR_vulkan_enable2
pub const TYPE_VULKAN_INSTANCE_CREATE_INFO_KHR = 1000090000i32;
pub const TYPE_VULKAN_DEVICE_CREATE_INFO_KHR = 1000090001i32;
pub const TYPE_VULKAN_GRAPHICS_DEVICE_GET_INFO_KHR = 1000090003i32;
// The same values under XR_KHR_vulkan_enable2's names
pub const TYPE_GRAPHICS_BINDING_VULKAN2_KHR = 1000025000i32;
pub const TYPE_SWAPCHAIN_IMAGE_VULKAN2_KHR = 1000025001i32;
pub const TYPE_GRAPHICS_REQUIREMENTS_VULKAN2_KHR = 1000025002i32;

// XrFormFactor
pub const FORM_FACTOR_HEAD_MOUNTED_DISPLAY = 1i32;
pub const FORM_FACTOR_HANDHELD_DISPLAY = 2i32;

// XrViewConfigurationType
pub const VIEW_CONFIGURATION_TYPE_PRIMARY_MONO = 1i32;
pub const VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO = 2i32;

// XrEnvironmentBlendMode
pub const ENVIRONMENT_BLEND_MODE_OPAQUE = 1i32;
pub const ENVIRONMENT_BLEND_MODE_ADDITIVE = 2i32;
pub const ENVIRONMENT_BLEND_MODE_ALPHA_BLEND = 3i32;

// XrReferenceSpaceType. LOCAL_FLOOR is OpenXR 1.1's (XR_EXT_local_floor in
// 1.0, whose type value this is too).
pub const REFERENCE_SPACE_TYPE_VIEW = 1i32;
pub const REFERENCE_SPACE_TYPE_LOCAL = 2i32;
pub const REFERENCE_SPACE_TYPE_STAGE = 3i32;
pub const REFERENCE_SPACE_TYPE_LOCAL_FLOOR = 1000426000i32;

// XrSpaceLocationFlags
pub const SPACE_LOCATION_ORIENTATION_VALID_BIT = 1u64;
pub const SPACE_LOCATION_POSITION_VALID_BIT = 2u64;
pub const SPACE_LOCATION_ORIENTATION_TRACKED_BIT = 4u64;
pub const SPACE_LOCATION_POSITION_TRACKED_BIT = 8u64;

// XrViewStateFlags
pub const VIEW_STATE_ORIENTATION_VALID_BIT = 1u64;
pub const VIEW_STATE_POSITION_VALID_BIT = 2u64;
pub const VIEW_STATE_ORIENTATION_TRACKED_BIT = 4u64;
pub const VIEW_STATE_POSITION_TRACKED_BIT = 8u64;

