// ---- The instance-level functions ----

// The functions of one instance, found for it by 'InstanceFns.load' through
// xrGetInstanceProcAddr: every core function of OpenXR 1.0 that the package
// binds (the instance, system, session, space, view, swapchain and frame calls
// and the event poll), and, from the extensions, XR_KHR_vulkan_enable2's four
// and XR_KHR_win32_convert_performance_counter_time's two, which are found
// only when the instance was made with that extension enabled and so are
// optional here ('hasVulkanEnable2', 'hasWin32Time'). It belongs to the
// instance it was found for: another instance has a table of its own.
pub struct InstanceFns {
  pfnDestroyInstance: usize = 0usize;
  pfnGetInstanceProperties: usize = 0usize;
  pfnPollEvent: usize = 0usize;
  pfnResultToString: usize = 0usize;
  pfnStructureTypeToString: usize = 0usize;
  pfnGetSystem: usize = 0usize;
  pfnGetSystemProperties: usize = 0usize;
  pfnEnumerateEnvironmentBlendModes: usize = 0usize;
  pfnCreateSession: usize = 0usize;
  pfnDestroySession: usize = 0usize;
  pfnEnumerateReferenceSpaces: usize = 0usize;
  pfnCreateReferenceSpace: usize = 0usize;
  pfnGetReferenceSpaceBoundsRect: usize = 0usize;
  pfnLocateSpace: usize = 0usize;
  pfnDestroySpace: usize = 0usize;
  pfnEnumerateViewConfigurations: usize = 0usize;
  pfnGetViewConfigurationProperties: usize = 0usize;
  pfnEnumerateViewConfigurationViews: usize = 0usize;
  pfnEnumerateSwapchainFormats: usize = 0usize;
  pfnCreateSwapchain: usize = 0usize;
  pfnDestroySwapchain: usize = 0usize;
  pfnEnumerateSwapchainImages: usize = 0usize;
  pfnAcquireSwapchainImage: usize = 0usize;
  pfnWaitSwapchainImage: usize = 0usize;
  pfnReleaseSwapchainImage: usize = 0usize;
  pfnBeginSession: usize = 0usize;
  pfnEndSession: usize = 0usize;
  pfnRequestExitSession: usize = 0usize;
  pfnWaitFrame: usize = 0usize;
  pfnBeginFrame: usize = 0usize;
  pfnEndFrame: usize = 0usize;
  pfnLocateViews: usize = 0usize;
  pfnStringToPath: usize = 0usize;
  pfnPathToString: usize = 0usize;
  pfnCreateVulkanInstanceKHR: usize = 0usize;
  pfnCreateVulkanDeviceKHR: usize = 0usize;
  pfnGetVulkanGraphicsDevice2KHR: usize = 0usize;
  pfnGetVulkanGraphicsRequirements2KHR: usize = 0usize;
  pfnConvertWin32PerformanceCounterToTimeKHR: usize = 0usize;
  pfnConvertTimeToWin32PerformanceCounterKHR: usize = 0usize;
  // How many required functions were not found
  pub missing: u32 = 0u32;

  // Find the functions of 'instance' through the OS loader's
  // xrGetInstanceProcAddr, which the module's 'init' found. 'missing' is how
  // many required ones were not found (all of them, when there is no loader)
  pub fn load(instance: Instance) InstanceFns {
    InstanceFns.loadWith(globals.pfnGetInstanceProcAddr as *u8 as PFN_GetInstanceProcAddr, instance)
  }

  // The same through any xrGetInstanceProcAddr (a test's stand-in)
  pub fn loadWith(getInstanceProcAddr: PFN_GetInstanceProcAddr, instance: Instance) InstanceFns {
    var t = InstanceFns();
    if getInstanceProcAddr as usize == 0usize { t.missing = 34u32; return t; }
    var missing = 0u32;
    t.pfnDestroyInstance = lookup(getInstanceProcAddr, instance, &"xrDestroyInstance" as *u8);
    if t.pfnDestroyInstance == 0usize { missing = missing + 1u32; }
    t.pfnGetInstanceProperties = lookup(getInstanceProcAddr, instance, &"xrGetInstanceProperties" as *u8);
    if t.pfnGetInstanceProperties == 0usize { missing = missing + 1u32; }
    t.pfnPollEvent = lookup(getInstanceProcAddr, instance, &"xrPollEvent" as *u8);
    if t.pfnPollEvent == 0usize { missing = missing + 1u32; }
    t.pfnResultToString = lookup(getInstanceProcAddr, instance, &"xrResultToString" as *u8);
    if t.pfnResultToString == 0usize { missing = missing + 1u32; }
    t.pfnStructureTypeToString = lookup(getInstanceProcAddr, instance, &"xrStructureTypeToString" as *u8);
    if t.pfnStructureTypeToString == 0usize { missing = missing + 1u32; }
    t.pfnGetSystem = lookup(getInstanceProcAddr, instance, &"xrGetSystem" as *u8);
    if t.pfnGetSystem == 0usize { missing = missing + 1u32; }
    t.pfnGetSystemProperties = lookup(getInstanceProcAddr, instance, &"xrGetSystemProperties" as *u8);
    if t.pfnGetSystemProperties == 0usize { missing = missing + 1u32; }
    t.pfnEnumerateEnvironmentBlendModes = lookup(getInstanceProcAddr, instance, &"xrEnumerateEnvironmentBlendModes" as *u8);
    if t.pfnEnumerateEnvironmentBlendModes == 0usize { missing = missing + 1u32; }
    t.pfnCreateSession = lookup(getInstanceProcAddr, instance, &"xrCreateSession" as *u8);
    if t.pfnCreateSession == 0usize { missing = missing + 1u32; }
    t.pfnDestroySession = lookup(getInstanceProcAddr, instance, &"xrDestroySession" as *u8);
    if t.pfnDestroySession == 0usize { missing = missing + 1u32; }
    t.pfnEnumerateReferenceSpaces = lookup(getInstanceProcAddr, instance, &"xrEnumerateReferenceSpaces" as *u8);
    if t.pfnEnumerateReferenceSpaces == 0usize { missing = missing + 1u32; }
    t.pfnCreateReferenceSpace = lookup(getInstanceProcAddr, instance, &"xrCreateReferenceSpace" as *u8);
    if t.pfnCreateReferenceSpace == 0usize { missing = missing + 1u32; }
    t.pfnGetReferenceSpaceBoundsRect = lookup(getInstanceProcAddr, instance, &"xrGetReferenceSpaceBoundsRect" as *u8);
    if t.pfnGetReferenceSpaceBoundsRect == 0usize { missing = missing + 1u32; }
    t.pfnLocateSpace = lookup(getInstanceProcAddr, instance, &"xrLocateSpace" as *u8);
    if t.pfnLocateSpace == 0usize { missing = missing + 1u32; }
    t.pfnDestroySpace = lookup(getInstanceProcAddr, instance, &"xrDestroySpace" as *u8);
    if t.pfnDestroySpace == 0usize { missing = missing + 1u32; }
    t.pfnEnumerateViewConfigurations = lookup(getInstanceProcAddr, instance, &"xrEnumerateViewConfigurations" as *u8);
    if t.pfnEnumerateViewConfigurations == 0usize { missing = missing + 1u32; }
    t.pfnGetViewConfigurationProperties = lookup(getInstanceProcAddr, instance, &"xrGetViewConfigurationProperties" as *u8);
    if t.pfnGetViewConfigurationProperties == 0usize { missing = missing + 1u32; }
    t.pfnEnumerateViewConfigurationViews = lookup(getInstanceProcAddr, instance, &"xrEnumerateViewConfigurationViews" as *u8);
    if t.pfnEnumerateViewConfigurationViews == 0usize { missing = missing + 1u32; }
    t.pfnEnumerateSwapchainFormats = lookup(getInstanceProcAddr, instance, &"xrEnumerateSwapchainFormats" as *u8);
    if t.pfnEnumerateSwapchainFormats == 0usize { missing = missing + 1u32; }
    t.pfnCreateSwapchain = lookup(getInstanceProcAddr, instance, &"xrCreateSwapchain" as *u8);
    if t.pfnCreateSwapchain == 0usize { missing = missing + 1u32; }
    t.pfnDestroySwapchain = lookup(getInstanceProcAddr, instance, &"xrDestroySwapchain" as *u8);
    if t.pfnDestroySwapchain == 0usize { missing = missing + 1u32; }
    t.pfnEnumerateSwapchainImages = lookup(getInstanceProcAddr, instance, &"xrEnumerateSwapchainImages" as *u8);
    if t.pfnEnumerateSwapchainImages == 0usize { missing = missing + 1u32; }
    t.pfnAcquireSwapchainImage = lookup(getInstanceProcAddr, instance, &"xrAcquireSwapchainImage" as *u8);
    if t.pfnAcquireSwapchainImage == 0usize { missing = missing + 1u32; }
    t.pfnWaitSwapchainImage = lookup(getInstanceProcAddr, instance, &"xrWaitSwapchainImage" as *u8);
    if t.pfnWaitSwapchainImage == 0usize { missing = missing + 1u32; }
    t.pfnReleaseSwapchainImage = lookup(getInstanceProcAddr, instance, &"xrReleaseSwapchainImage" as *u8);
    if t.pfnReleaseSwapchainImage == 0usize { missing = missing + 1u32; }
    t.pfnBeginSession = lookup(getInstanceProcAddr, instance, &"xrBeginSession" as *u8);
    if t.pfnBeginSession == 0usize { missing = missing + 1u32; }
    t.pfnEndSession = lookup(getInstanceProcAddr, instance, &"xrEndSession" as *u8);
    if t.pfnEndSession == 0usize { missing = missing + 1u32; }
    t.pfnRequestExitSession = lookup(getInstanceProcAddr, instance, &"xrRequestExitSession" as *u8);
    if t.pfnRequestExitSession == 0usize { missing = missing + 1u32; }
    t.pfnWaitFrame = lookup(getInstanceProcAddr, instance, &"xrWaitFrame" as *u8);
    if t.pfnWaitFrame == 0usize { missing = missing + 1u32; }
    t.pfnBeginFrame = lookup(getInstanceProcAddr, instance, &"xrBeginFrame" as *u8);
    if t.pfnBeginFrame == 0usize { missing = missing + 1u32; }
    t.pfnEndFrame = lookup(getInstanceProcAddr, instance, &"xrEndFrame" as *u8);
    if t.pfnEndFrame == 0usize { missing = missing + 1u32; }
    t.pfnLocateViews = lookup(getInstanceProcAddr, instance, &"xrLocateViews" as *u8);
    if t.pfnLocateViews == 0usize { missing = missing + 1u32; }
    t.pfnStringToPath = lookup(getInstanceProcAddr, instance, &"xrStringToPath" as *u8);
    if t.pfnStringToPath == 0usize { missing = missing + 1u32; }
    t.pfnPathToString = lookup(getInstanceProcAddr, instance, &"xrPathToString" as *u8);
    if t.pfnPathToString == 0usize { missing = missing + 1u32; }
    t.pfnCreateVulkanInstanceKHR = lookup(getInstanceProcAddr, instance, &"xrCreateVulkanInstanceKHR" as *u8);
    t.pfnCreateVulkanDeviceKHR = lookup(getInstanceProcAddr, instance, &"xrCreateVulkanDeviceKHR" as *u8);
    t.pfnGetVulkanGraphicsDevice2KHR = lookup(getInstanceProcAddr, instance, &"xrGetVulkanGraphicsDevice2KHR" as *u8);
    t.pfnGetVulkanGraphicsRequirements2KHR = lookup(getInstanceProcAddr, instance, &"xrGetVulkanGraphicsRequirements2KHR" as *u8);
    t.pfnConvertWin32PerformanceCounterToTimeKHR = lookup(getInstanceProcAddr, instance, &"xrConvertWin32PerformanceCounterToTimeKHR" as *u8);
    t.pfnConvertTimeToWin32PerformanceCounterKHR = lookup(getInstanceProcAddr, instance, &"xrConvertTimeToWin32PerformanceCounterKHR" as *u8);
    t.missing = missing;
    t
  }

  // Whether XR_KHR_vulkan_enable2's four functions were found (the extension
  // was enabled on the instance 'load' was given)
  pub fn hasVulkanEnable2(self: &) bool {
    pfnCreateVulkanInstanceKHR != 0usize && pfnCreateVulkanDeviceKHR != 0usize && pfnGetVulkanGraphicsDevice2KHR != 0usize && pfnGetVulkanGraphicsRequirements2KHR != 0usize
  }

  // Whether the two functions converting between Windows performance-counter
  // ticks and XrTime were found (XR_KHR_win32_convert_performance_counter_time)
  pub fn hasWin32Time(self: &) bool {
    pfnConvertWin32PerformanceCounterToTimeKHR != 0usize && pfnConvertTimeToWin32PerformanceCounterKHR != 0usize
  }

  pub fn destroyInstance(self: &, instance: Instance) i32 {
    (pfnDestroyInstance as *u8 as PFN_DestroyInstance)(instance)
  }
  pub fn getInstanceProperties(self: &, instance: Instance, instanceProperties: &mut InstanceProperties) i32 {
    (pfnGetInstanceProperties as *u8 as PFN_GetInstanceProperties)(instance, instanceProperties)
  }
  pub fn pollEvent(self: &, instance: Instance, eventData: &mut EventDataBuffer) i32 {
    (pfnPollEvent as *u8 as PFN_PollEvent)(instance, eventData)
  }
  pub fn resultToString(self: &, instance: Instance, value: i32, buffer: *u8) i32 {
    (pfnResultToString as *u8 as PFN_ResultToString)(instance, value, buffer)
  }
  pub fn structureTypeToString(self: &, instance: Instance, value: i32, buffer: *u8) i32 {
    (pfnStructureTypeToString as *u8 as PFN_StructureTypeToString)(instance, value, buffer)
  }
  pub fn getSystem(self: &, instance: Instance, getInfo: &SystemGetInfo, systemId: &mut u64) i32 {
    (pfnGetSystem as *u8 as PFN_GetSystem)(instance, getInfo, systemId)
  }
  pub fn getSystemProperties(self: &, instance: Instance, systemId: u64, properties: &mut SystemProperties) i32 {
    (pfnGetSystemProperties as *u8 as PFN_GetSystemProperties)(instance, systemId, properties)
  }
  pub fn enumerateEnvironmentBlendModes(self: &, instance: Instance, systemId: u64,
    viewConfigurationType: i32, environmentBlendModeCapacityInput: u32,
    environmentBlendModeCountOutput: &mut u32, environmentBlendModes: *i32) i32 {
    (pfnEnumerateEnvironmentBlendModes as *u8 as PFN_EnumerateEnvironmentBlendModes)(
      instance, systemId, viewConfigurationType, environmentBlendModeCapacityInput, environmentBlendModeCountOutput, environmentBlendModes)
  }
  pub fn createSession(self: &, instance: Instance, createInfo: &SessionCreateInfo, session: &mut Session) i32 {
    (pfnCreateSession as *u8 as PFN_CreateSession)(instance, createInfo, session)
  }
  pub fn destroySession(self: &, session: Session) i32 {
    (pfnDestroySession as *u8 as PFN_DestroySession)(session)
  }
  pub fn enumerateReferenceSpaces(self: &, session: Session, spaceCapacityInput: u32,
    spaceCountOutput: &mut u32, spaces: *i32) i32 {
    (pfnEnumerateReferenceSpaces as *u8 as PFN_EnumerateReferenceSpaces)(
      session, spaceCapacityInput, spaceCountOutput, spaces)
  }
  pub fn createReferenceSpace(self: &, session: Session, createInfo: &ReferenceSpaceCreateInfo,
    space: &mut Space) i32 {
    (pfnCreateReferenceSpace as *u8 as PFN_CreateReferenceSpace)(session, createInfo, space)
  }
  pub fn getReferenceSpaceBoundsRect(self: &, session: Session, referenceSpaceType: i32, bounds: &mut Extent2Df) i32 {
    (pfnGetReferenceSpaceBoundsRect as *u8 as PFN_GetReferenceSpaceBoundsRect)(session, referenceSpaceType, bounds)
  }
  pub fn locateSpace(self: &, space: Space, baseSpace: Space, time: i64, location: &mut SpaceLocation) i32 {
    (pfnLocateSpace as *u8 as PFN_LocateSpace)(space, baseSpace, time, location)
  }
  pub fn destroySpace(self: &, space: Space) i32 {
    (pfnDestroySpace as *u8 as PFN_DestroySpace)(space)
  }
  pub fn enumerateViewConfigurations(self: &, instance: Instance, systemId: u64,
    viewConfigurationTypeCapacityInput: u32, viewConfigurationTypeCountOutput: &mut u32,
    viewConfigurationTypes: *i32) i32 {
    (pfnEnumerateViewConfigurations as *u8 as PFN_EnumerateViewConfigurations)(
      instance, systemId, viewConfigurationTypeCapacityInput, viewConfigurationTypeCountOutput, viewConfigurationTypes)
  }
  pub fn getViewConfigurationProperties(self: &, instance: Instance, systemId: u64,
    viewConfigurationType: i32, configurationProperties: &mut ViewConfigurationProperties) i32 {
    (pfnGetViewConfigurationProperties as *u8 as PFN_GetViewConfigurationProperties)(
      instance, systemId, viewConfigurationType, configurationProperties)
  }
  pub fn enumerateViewConfigurationViews(self: &, instance: Instance, systemId: u64,
    viewConfigurationType: i32, viewCapacityInput: u32, viewCountOutput: &mut u32,
    views: *ViewConfigurationView) i32 {
    (pfnEnumerateViewConfigurationViews as *u8 as PFN_EnumerateViewConfigurationViews)(
      instance, systemId, viewConfigurationType, viewCapacityInput, viewCountOutput, views)
  }
  pub fn enumerateSwapchainFormats(self: &, session: Session, formatCapacityInput: u32,
    formatCountOutput: &mut u32, formats: *i64) i32 {
    (pfnEnumerateSwapchainFormats as *u8 as PFN_EnumerateSwapchainFormats)(
      session, formatCapacityInput, formatCountOutput, formats)
  }
  pub fn createSwapchain(self: &, session: Session, createInfo: &SwapchainCreateInfo, swapchain: &mut Swapchain) i32 {
    (pfnCreateSwapchain as *u8 as PFN_CreateSwapchain)(session, createInfo, swapchain)
  }
  pub fn destroySwapchain(self: &, swapchain: Swapchain) i32 {
    (pfnDestroySwapchain as *u8 as PFN_DestroySwapchain)(swapchain)
  }
  pub fn enumerateSwapchainImages(self: &, swapchain: Swapchain, imageCapacityInput: u32,
    imageCountOutput: &mut u32, images: *SwapchainImageBaseHeader) i32 {
    (pfnEnumerateSwapchainImages as *u8 as PFN_EnumerateSwapchainImages)(
      swapchain, imageCapacityInput, imageCountOutput, images)
  }
  pub fn acquireSwapchainImage(self: &, swapchain: Swapchain, acquireInfo: &SwapchainImageAcquireInfo,
    index: &mut u32) i32 {
    (pfnAcquireSwapchainImage as *u8 as PFN_AcquireSwapchainImage)(swapchain, acquireInfo, index)
  }
  pub fn waitSwapchainImage(self: &, swapchain: Swapchain, waitInfo: &SwapchainImageWaitInfo) i32 {
    (pfnWaitSwapchainImage as *u8 as PFN_WaitSwapchainImage)(swapchain, waitInfo)
  }
  pub fn releaseSwapchainImage(self: &, swapchain: Swapchain, releaseInfo: &SwapchainImageReleaseInfo) i32 {
    (pfnReleaseSwapchainImage as *u8 as PFN_ReleaseSwapchainImage)(swapchain, releaseInfo)
  }
  pub fn beginSession(self: &, session: Session, beginInfo: &SessionBeginInfo) i32 {
    (pfnBeginSession as *u8 as PFN_BeginSession)(session, beginInfo)
  }
  pub fn endSession(self: &, session: Session) i32 {
    (pfnEndSession as *u8 as PFN_EndSession)(session)
  }
  pub fn requestExitSession(self: &, session: Session) i32 {
    (pfnRequestExitSession as *u8 as PFN_RequestExitSession)(session)
  }
  pub fn waitFrame(self: &, session: Session, frameWaitInfo: &FrameWaitInfo, frameState: &mut FrameState) i32 {
    (pfnWaitFrame as *u8 as PFN_WaitFrame)(session, frameWaitInfo, frameState)
  }
  pub fn beginFrame(self: &, session: Session, frameBeginInfo: &FrameBeginInfo) i32 {
    (pfnBeginFrame as *u8 as PFN_BeginFrame)(session, frameBeginInfo)
  }
  pub fn endFrame(self: &, session: Session, frameEndInfo: &FrameEndInfo) i32 {
    (pfnEndFrame as *u8 as PFN_EndFrame)(session, frameEndInfo)
  }
  pub fn locateViews(self: &, session: Session, viewLocateInfo: &ViewLocateInfo, viewState: &mut ViewState,
    viewCapacityInput: u32, viewCountOutput: &mut u32, views: *View) i32 {
    (pfnLocateViews as *u8 as PFN_LocateViews)(
      session, viewLocateInfo, viewState, viewCapacityInput, viewCountOutput, views)
  }
  pub fn stringToPath(self: &, instance: Instance, pathString: *u8, path: &mut u64) i32 {
    (pfnStringToPath as *u8 as PFN_StringToPath)(instance, pathString, path)
  }
  pub fn pathToString(self: &, instance: Instance, path: u64, bufferCapacityInput: u32,
    bufferCountOutput: &mut u32, buffer: *u8) i32 {
    (pfnPathToString as *u8 as PFN_PathToString)(instance, path, bufferCapacityInput, bufferCountOutput, buffer)
  }
  pub fn createVulkanInstanceKHR(self: &, instance: Instance, createInfo: &VulkanInstanceCreateInfoKHR,
    vulkanInstance: &mut vulkan.Instance, vulkanResult: &mut i32) i32 {
    (pfnCreateVulkanInstanceKHR as *u8 as PFN_CreateVulkanInstanceKHR)(
      instance, createInfo, vulkanInstance, vulkanResult)
  }
  pub fn createVulkanDeviceKHR(self: &, instance: Instance, createInfo: &VulkanDeviceCreateInfoKHR,
    vulkanDevice: &mut vulkan.Device, vulkanResult: &mut i32) i32 {
    (pfnCreateVulkanDeviceKHR as *u8 as PFN_CreateVulkanDeviceKHR)(instance, createInfo, vulkanDevice, vulkanResult)
  }
  pub fn getVulkanGraphicsDevice2KHR(self: &, instance: Instance, getInfo: &VulkanGraphicsDeviceGetInfoKHR,
    vulkanPhysicalDevice: &mut vulkan.PhysicalDevice) i32 {
    (pfnGetVulkanGraphicsDevice2KHR as *u8 as PFN_GetVulkanGraphicsDevice2KHR)(
      instance, getInfo, vulkanPhysicalDevice)
  }
  pub fn getVulkanGraphicsRequirements2KHR(self: &, instance: Instance, systemId: u64,
    graphicsRequirements: &mut GraphicsRequirementsVulkanKHR) i32 {
    (pfnGetVulkanGraphicsRequirements2KHR as *u8 as PFN_GetVulkanGraphicsRequirements2KHR)(
      instance, systemId, graphicsRequirements)
  }
  pub fn convertWin32PerformanceCounterToTimeKHR(self: &, instance: Instance, performanceCounter: *i64,
    time: &mut i64) i32 {
    (pfnConvertWin32PerformanceCounterToTimeKHR as *u8 as PFN_ConvertWin32PerformanceCounterToTimeKHR)(
      instance, performanceCounter, time)
  }
  pub fn convertTimeToWin32PerformanceCounterKHR(self: &, instance: Instance, time: i64,
    performanceCounter: &mut i64) i32 {
    (pfnConvertTimeToWin32PerformanceCounterKHR as *u8 as PFN_ConvertTimeToWin32PerformanceCounterKHR)(
      instance, time, performanceCounter)
  }
}
