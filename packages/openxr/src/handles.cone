// ---- Versions ----

// XR_MAKE_VERSION(major, minor, patch): the major in the top 16 bits, the
// minor in the next 16, the patch in the low 32
pub fn makeVersion(major: u64, minor: u64, patch: u64) u64 {
  ((major & 0xFFFFu64) << 48u64) | ((minor & 0xFFFFu64) << 32u64) | (patch & 0xFFFFFFFFu64)
}
pub fn versionMajor(v: u64) u64 { (v >> 48u64) & 0xFFFFu64 }
pub fn versionMinor(v: u64) u64 { (v >> 32u64) & 0xFFFFu64 }
pub fn versionPatch(v: u64) u64 { v & 0xFFFFFFFFu64 }

// The API versions an application asks for in 'ApplicationInfo.apiVersion'.
// (XR_API_VERSION_1_0 in the header carries the header's patch number; a
// runtime and the loader look at the major and the minor.)
pub const API_VERSION_1_0 = 281474976710656u64;    // makeVersion(1, 0, 0)
pub const API_VERSION_1_1 = 281479271677952u64;    // makeVersion(1, 1, 0)

// ---- Handles and atoms ----

// A handle is a pointer to an opaque struct on 64-bit (XR_DEFINE_HANDLE),
// '0usize as openxr.Instance' being XR_NULL_HANDLE. An atom (XrSystemId,
// XrPath) is a u64, 0 its null (XR_NULL_SYSTEM_ID, XR_NULL_PATH).
pub struct @opaque Instance_T {}
pub struct @opaque Session_T {}
pub struct @opaque Space_T {}
pub struct @opaque Action_T {}
pub struct @opaque Swapchain_T {}
pub struct @opaque ActionSet_T {}
pub alias Instance = *Instance_T;
pub alias Session = *Session_T;
pub alias Space = *Space_T;
pub alias Action = *Action_T;
pub alias Swapchain = *Swapchain_T;
pub alias ActionSet = *ActionSet_T;

// ---- Limits ----

pub const MAX_EXTENSION_NAME_SIZE = 128usize;
pub const MAX_API_LAYER_NAME_SIZE = 256usize;
pub const MAX_API_LAYER_DESCRIPTION_SIZE = 256usize;
pub const MAX_SYSTEM_NAME_SIZE = 256usize;
pub const MAX_APPLICATION_NAME_SIZE = 128usize;
pub const MAX_ENGINE_NAME_SIZE = 128usize;
pub const MAX_RUNTIME_NAME_SIZE = 128usize;
pub const MAX_RESULT_STRING_SIZE = 64usize;
pub const MAX_STRUCTURE_NAME_SIZE = 64usize;
pub const MAX_ACTION_SET_NAME_SIZE = 64usize;
pub const MAX_LOCALIZED_ACTION_SET_NAME_SIZE = 128usize;
pub const MAX_ACTION_NAME_SIZE = 64usize;
pub const MAX_LOCALIZED_ACTION_NAME_SIZE = 128usize;

pub const TRUE = 1u32;
pub const FALSE = 0u32;

// XR_INFINITE_DURATION
pub const INFINITE_DURATION = 9223372036854775807i64;
pub const NO_DURATION = 0i64;
// XR_MIN_HAPTIC_DURATION: the shortest pulse the device can make
pub const MIN_HAPTIC_DURATION = -1i64;
// XR_FREQUENCY_UNSPECIFIED: the runtime picks the frequency
pub const FREQUENCY_UNSPECIFIED = 0.0f32;

// ---- Results ----

// XrResult, every value the specification's core defines, as i32 (a runtime
// may return a value an enumeration would not list). A success is not
// negative: 'succeeded'. SUCCESS alone is "no news"; a positive result (
// SESSION_LOSS_PENDING, FRAME_DISCARDED) is a success that says something.
pub const SUCCESS = 0i32;
pub const TIMEOUT_EXPIRED = 1i32;
pub const SESSION_LOSS_PENDING = 3i32;
pub const EVENT_UNAVAILABLE = 4i32;
pub const SPACE_BOUNDS_UNAVAILABLE = 7i32;
pub const SESSION_NOT_FOCUSED = 8i32;
pub const FRAME_DISCARDED = 9i32;
pub const ERROR_VALIDATION_FAILURE = -1i32;
pub const ERROR_RUNTIME_FAILURE = -2i32;
pub const ERROR_OUT_OF_MEMORY = -3i32;
pub const ERROR_API_VERSION_UNSUPPORTED = -4i32;
pub const ERROR_INITIALIZATION_FAILED = -6i32;
pub const ERROR_FUNCTION_UNSUPPORTED = -7i32;
pub const ERROR_FEATURE_UNSUPPORTED = -8i32;
pub const ERROR_EXTENSION_NOT_PRESENT = -9i32;
pub const ERROR_LIMIT_REACHED = -10i32;
pub const ERROR_SIZE_INSUFFICIENT = -11i32;
pub const ERROR_HANDLE_INVALID = -12i32;
pub const ERROR_INSTANCE_LOST = -13i32;
pub const ERROR_SESSION_RUNNING = -14i32;
pub const ERROR_SESSION_NOT_RUNNING = -16i32;
pub const ERROR_SESSION_LOST = -17i32;
pub const ERROR_SYSTEM_INVALID = -18i32;
pub const ERROR_PATH_INVALID = -19i32;
pub const ERROR_PATH_COUNT_EXCEEDED = -20i32;
pub const ERROR_PATH_FORMAT_INVALID = -21i32;
pub const ERROR_PATH_UNSUPPORTED = -22i32;
pub const ERROR_LAYER_INVALID = -23i32;
pub const ERROR_LAYER_LIMIT_EXCEEDED = -24i32;
pub const ERROR_SWAPCHAIN_RECT_INVALID = -25i32;
pub const ERROR_SWAPCHAIN_FORMAT_UNSUPPORTED = -26i32;
pub const ERROR_ACTION_TYPE_MISMATCH = -27i32;
pub const ERROR_SESSION_NOT_READY = -28i32;
pub const ERROR_SESSION_NOT_STOPPING = -29i32;
pub const ERROR_TIME_INVALID = -30i32;
pub const ERROR_REFERENCE_SPACE_UNSUPPORTED = -31i32;
pub const ERROR_FILE_ACCESS_ERROR = -32i32;
pub const ERROR_FILE_CONTENTS_INVALID = -33i32;
pub const ERROR_FORM_FACTOR_UNSUPPORTED = -34i32;
pub const ERROR_FORM_FACTOR_UNAVAILABLE = -35i32;
pub const ERROR_API_LAYER_NOT_PRESENT = -36i32;
pub const ERROR_CALL_ORDER_INVALID = -37i32;
pub const ERROR_GRAPHICS_DEVICE_INVALID = -38i32;
pub const ERROR_POSE_INVALID = -39i32;
pub const ERROR_INDEX_OUT_OF_RANGE = -40i32;
pub const ERROR_VIEW_CONFIGURATION_TYPE_UNSUPPORTED = -41i32;
pub const ERROR_ENVIRONMENT_BLEND_MODE_UNSUPPORTED = -42i32;
pub const ERROR_NAME_DUPLICATED = -44i32;
pub const ERROR_NAME_INVALID = -45i32;
pub const ERROR_ACTIONSET_NOT_ATTACHED = -46i32;
pub const ERROR_ACTIONSETS_ALREADY_ATTACHED = -47i32;
pub const ERROR_LOCALIZED_NAME_DUPLICATED = -48i32;
pub const ERROR_LOCALIZED_NAME_INVALID = -49i32;
pub const ERROR_GRAPHICS_REQUIREMENTS_CALL_MISSING = -50i32;
pub const ERROR_RUNTIME_UNAVAILABLE = -51i32;

// XR_SUCCEEDED and XR_FAILED
pub fn succeeded(r: i32) bool { r >= 0i32 }
pub fn failed(r: i32) bool { r < 0i32 }

// An XrResult's name, without the XR_ prefix; "unknown XrResult" for a value
// this package does not list (an extension's, say). The runtime's own text for
// any value is 'InstanceFns.resultToString'.
pub fn resultName(r: i32) &str {
  if r == SUCCESS { return "SUCCESS"; }
  if r == TIMEOUT_EXPIRED { return "TIMEOUT_EXPIRED"; }
  if r == SESSION_LOSS_PENDING { return "SESSION_LOSS_PENDING"; }
  if r == EVENT_UNAVAILABLE { return "EVENT_UNAVAILABLE"; }
  if r == SPACE_BOUNDS_UNAVAILABLE { return "SPACE_BOUNDS_UNAVAILABLE"; }
  if r == SESSION_NOT_FOCUSED { return "SESSION_NOT_FOCUSED"; }
  if r == FRAME_DISCARDED { return "FRAME_DISCARDED"; }
  if r == ERROR_VALIDATION_FAILURE { return "ERROR_VALIDATION_FAILURE"; }
  if r == ERROR_RUNTIME_FAILURE { return "ERROR_RUNTIME_FAILURE"; }
  if r == ERROR_OUT_OF_MEMORY { return "ERROR_OUT_OF_MEMORY"; }
  if r == ERROR_API_VERSION_UNSUPPORTED { return "ERROR_API_VERSION_UNSUPPORTED"; }
  if r == ERROR_INITIALIZATION_FAILED { return "ERROR_INITIALIZATION_FAILED"; }
  if r == ERROR_FUNCTION_UNSUPPORTED { return "ERROR_FUNCTION_UNSUPPORTED"; }
  if r == ERROR_FEATURE_UNSUPPORTED { return "ERROR_FEATURE_UNSUPPORTED"; }
  if r == ERROR_EXTENSION_NOT_PRESENT { return "ERROR_EXTENSION_NOT_PRESENT"; }
  if r == ERROR_LIMIT_REACHED { return "ERROR_LIMIT_REACHED"; }
  if r == ERROR_SIZE_INSUFFICIENT { return "ERROR_SIZE_INSUFFICIENT"; }
  if r == ERROR_HANDLE_INVALID { return "ERROR_HANDLE_INVALID"; }
  if r == ERROR_INSTANCE_LOST { return "ERROR_INSTANCE_LOST"; }
  if r == ERROR_SESSION_RUNNING { return "ERROR_SESSION_RUNNING"; }
  if r == ERROR_SESSION_NOT_RUNNING { return "ERROR_SESSION_NOT_RUNNING"; }
  if r == ERROR_SESSION_LOST { return "ERROR_SESSION_LOST"; }
  if r == ERROR_SYSTEM_INVALID { return "ERROR_SYSTEM_INVALID"; }
  if r == ERROR_PATH_INVALID { return "ERROR_PATH_INVALID"; }
  if r == ERROR_PATH_COUNT_EXCEEDED { return "ERROR_PATH_COUNT_EXCEEDED"; }
  if r == ERROR_PATH_FORMAT_INVALID { return "ERROR_PATH_FORMAT_INVALID"; }
  if r == ERROR_PATH_UNSUPPORTED { return "ERROR_PATH_UNSUPPORTED"; }
  if r == ERROR_LAYER_INVALID { return "ERROR_LAYER_INVALID"; }
  if r == ERROR_LAYER_LIMIT_EXCEEDED { return "ERROR_LAYER_LIMIT_EXCEEDED"; }
  if r == ERROR_SWAPCHAIN_RECT_INVALID { return "ERROR_SWAPCHAIN_RECT_INVALID"; }
  if r == ERROR_SWAPCHAIN_FORMAT_UNSUPPORTED { return "ERROR_SWAPCHAIN_FORMAT_UNSUPPORTED"; }
  if r == ERROR_ACTION_TYPE_MISMATCH { return "ERROR_ACTION_TYPE_MISMATCH"; }
  if r == ERROR_SESSION_NOT_READY { return "ERROR_SESSION_NOT_READY"; }
  if r == ERROR_SESSION_NOT_STOPPING { return "ERROR_SESSION_NOT_STOPPING"; }
  if r == ERROR_TIME_INVALID { return "ERROR_TIME_INVALID"; }
  if r == ERROR_REFERENCE_SPACE_UNSUPPORTED { return "ERROR_REFERENCE_SPACE_UNSUPPORTED"; }
  if r == ERROR_FILE_ACCESS_ERROR { return "ERROR_FILE_ACCESS_ERROR"; }
  if r == ERROR_FILE_CONTENTS_INVALID { return "ERROR_FILE_CONTENTS_INVALID"; }
  if r == ERROR_FORM_FACTOR_UNSUPPORTED { return "ERROR_FORM_FACTOR_UNSUPPORTED"; }
  if r == ERROR_FORM_FACTOR_UNAVAILABLE { return "ERROR_FORM_FACTOR_UNAVAILABLE"; }
  if r == ERROR_API_LAYER_NOT_PRESENT { return "ERROR_API_LAYER_NOT_PRESENT"; }
  if r == ERROR_CALL_ORDER_INVALID { return "ERROR_CALL_ORDER_INVALID"; }
  if r == ERROR_GRAPHICS_DEVICE_INVALID { return "ERROR_GRAPHICS_DEVICE_INVALID"; }
  if r == ERROR_POSE_INVALID { return "ERROR_POSE_INVALID"; }
  if r == ERROR_INDEX_OUT_OF_RANGE { return "ERROR_INDEX_OUT_OF_RANGE"; }
  if r == ERROR_VIEW_CONFIGURATION_TYPE_UNSUPPORTED { return "ERROR_VIEW_CONFIGURATION_TYPE_UNSUPPORTED"; }
  if r == ERROR_ENVIRONMENT_BLEND_MODE_UNSUPPORTED { return "ERROR_ENVIRONMENT_BLEND_MODE_UNSUPPORTED"; }
  if r == ERROR_NAME_DUPLICATED { return "ERROR_NAME_DUPLICATED"; }
  if r == ERROR_NAME_INVALID { return "ERROR_NAME_INVALID"; }
  if r == ERROR_ACTIONSET_NOT_ATTACHED { return "ERROR_ACTIONSET_NOT_ATTACHED"; }
  if r == ERROR_ACTIONSETS_ALREADY_ATTACHED { return "ERROR_ACTIONSETS_ALREADY_ATTACHED"; }
  if r == ERROR_LOCALIZED_NAME_DUPLICATED { return "ERROR_LOCALIZED_NAME_DUPLICATED"; }
  if r == ERROR_LOCALIZED_NAME_INVALID { return "ERROR_LOCALIZED_NAME_INVALID"; }
  if r == ERROR_GRAPHICS_REQUIREMENTS_CALL_MISSING { return "ERROR_GRAPHICS_REQUIREMENTS_CALL_MISSING"; }
  if r == ERROR_RUNTIME_UNAVAILABLE { return "ERROR_RUNTIME_UNAVAILABLE"; }
  "unknown XrResult"
}

// ---- Session states ----

// XrSessionState: the states 'EventDataSessionStateChanged' reports
pub const SESSION_STATE_UNKNOWN = 0i32;
pub const SESSION_STATE_IDLE = 1i32;
pub const SESSION_STATE_READY = 2i32;
pub const SESSION_STATE_SYNCHRONIZED = 3i32;
pub const SESSION_STATE_VISIBLE = 4i32;
pub const SESSION_STATE_FOCUSED = 5i32;
pub const SESSION_STATE_STOPPING = 6i32;
pub const SESSION_STATE_LOSS_PENDING = 7i32;
pub const SESSION_STATE_EXITING = 8i32;

pub fn sessionStateName(s: i32) &str {
  if s == SESSION_STATE_IDLE { return "IDLE"; }
  if s == SESSION_STATE_READY { return "READY"; }
  if s == SESSION_STATE_SYNCHRONIZED { return "SYNCHRONIZED"; }
  if s == SESSION_STATE_VISIBLE { return "VISIBLE"; }
  if s == SESSION_STATE_FOCUSED { return "FOCUSED"; }
  if s == SESSION_STATE_STOPPING { return "STOPPING"; }
  if s == SESSION_STATE_LOSS_PENDING { return "LOSS_PENDING"; }
  if s == SESSION_STATE_EXITING { return "EXITING"; }
  "UNKNOWN"
}
