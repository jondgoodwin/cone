// Generated by layout.py from the package's src/: do not edit. The size and
// alignment of every struct the openxr package declares, and the offset of
// each of its fields, as Cone lays them out. layout.out is what layout.c
// prints for the same structs as Khronos's openxr.h declares them, compiled by
// cl.exe, so a difference is a struct transcribed wrongly on one side or the
// other.

mod layout;

import stdio use *;
import libc;
import openxr;

fn size(name: &str, n: usize, a: usize) {
  printStr(name); printStr(" size "); printUInt(u64.from(n)); printStr(" align "); printUInt(u64.from(a)); printStr("\n");
}

fn o(name: &str, base: usize, p: *u8) {
  printStr(name); printStr(" "); printUInt(u64.from((p as usize) - base)); printStr("\n");
}

