    let raw = libc.calloc(1usize, mem.sizeof[openxr.Vector2f]()) as *openxr.Vector2f;
    var v = mem.readRaw[openxr.Vector2f](raw);
    let b = &mut v as *u8 as usize;
    o("Vector2f.x", b, &mut v.x as *u8);
    o("Vector2f.y", b, &mut v.y as *u8);
    libc.free(raw as *u8);
  }
