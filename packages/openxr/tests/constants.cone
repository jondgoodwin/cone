// The openxr package's constants, checked without OpenXR. Only a failure
// prints.
//
// An extension's enum values are not arbitrary: the specification gives the
// value of the value 'offset' of extension number 'n' as
// 1000000000 + (n - 1) * 1000 + offset. So each extension constant is checked
// against its extension's number (XR_KHR_vulkan_enable is extension 26,
// XR_KHR_vulkan_enable2 is 91, XR_EXT_local_floor is 427) and its offset, an
// independent check of the typed-in value. The versions are checked against
// 'makeVersion'; each struct's default 'type' against its structure type; the
// session states against their order in the specification; and a result's name
// against its value.

mod constants;

import testing use *;
import vulkan;
import openxr use *;

fn ext(n: i32, offset: i32) i32 { 1000000000i32 + (n - 1i32) * 1000i32 + offset }

fn main() i32 {
  // Versions
  expectUInt(API_VERSION_1_0, makeVersion(1u64, 0u64, 0u64), "1.0");
  expectUInt(API_VERSION_1_1, makeVersion(1u64, 1u64, 0u64), "1.1");
  let v = makeVersion(1u64, 1u64, 65u64);
  expectUInt(versionMajor(v), 1u64, "major");
  expectUInt(versionMinor(v), 1u64, "minor");
  expectUInt(versionPatch(v), 65u64, "patch");
  expectUInt(v >> 48u64, 1u64, "the major is in the top 16 bits");

  // Extension values
  expectInt(i64.from(TYPE_GRAPHICS_BINDING_VULKAN_KHR), i64.from(ext(26i32, 0i32)), "GRAPHICS_BINDING_VULKAN_KHR");
  expectInt(i64.from(TYPE_SWAPCHAIN_IMAGE_VULKAN_KHR), i64.from(ext(26i32, 1i32)), "SWAPCHAIN_IMAGE_VULKAN_KHR");
  expectInt(i64.from(TYPE_GRAPHICS_REQUIREMENTS_VULKAN_KHR), i64.from(ext(26i32, 2i32)), "GRAPHICS_REQUIREMENTS_VULKAN_KHR");
  expectInt(i64.from(TYPE_VULKAN_INSTANCE_CREATE_INFO_KHR), i64.from(ext(91i32, 0i32)), "VULKAN_INSTANCE_CREATE_INFO_KHR");
  expectInt(i64.from(TYPE_VULKAN_DEVICE_CREATE_INFO_KHR), i64.from(ext(91i32, 1i32)), "VULKAN_DEVICE_CREATE_INFO_KHR");
  expectInt(i64.from(TYPE_VULKAN_GRAPHICS_DEVICE_GET_INFO_KHR), i64.from(ext(91i32, 3i32)), "VULKAN_GRAPHICS_DEVICE_GET_INFO_KHR");
  expectInt(i64.from(TYPE_GRAPHICS_BINDING_VULKAN2_KHR), i64.from(TYPE_GRAPHICS_BINDING_VULKAN_KHR), "the binding's two names");
  expectInt(i64.from(TYPE_SWAPCHAIN_IMAGE_VULKAN2_KHR), i64.from(TYPE_SWAPCHAIN_IMAGE_VULKAN_KHR), "the image's two names");
  expectInt(i64.from(TYPE_GRAPHICS_REQUIREMENTS_VULKAN2_KHR), i64.from(TYPE_GRAPHICS_REQUIREMENTS_VULKAN_KHR),
    "the requirements' two names");
  expectInt(i64.from(REFERENCE_SPACE_TYPE_LOCAL_FLOOR), i64.from(ext(427i32, 0i32)), "REFERENCE_SPACE_TYPE_LOCAL_FLOOR");

  // Core structure types in the specification's order
  expectInt(i64.from(TYPE_API_LAYER_PROPERTIES), 1, "API_LAYER_PROPERTIES");
  expectInt(i64.from(TYPE_EXTENSION_PROPERTIES), 2, "EXTENSION_PROPERTIES");
  expectInt(i64.from(TYPE_INSTANCE_CREATE_INFO), 3, "INSTANCE_CREATE_INFO");
  expectInt(i64.from(TYPE_SYSTEM_GET_INFO), 4, "SYSTEM_GET_INFO");
  expectInt(i64.from(TYPE_SYSTEM_PROPERTIES), 5, "SYSTEM_PROPERTIES");
  expectInt(i64.from(TYPE_VIEW_LOCATE_INFO), 6, "VIEW_LOCATE_INFO");
  expectInt(i64.from(TYPE_VIEW), 7, "VIEW");
  expectInt(i64.from(TYPE_SESSION_CREATE_INFO), 8, "SESSION_CREATE_INFO");
  expectInt(i64.from(TYPE_SWAPCHAIN_CREATE_INFO), 9, "SWAPCHAIN_CREATE_INFO");
  expectInt(i64.from(TYPE_SESSION_BEGIN_INFO), 10, "SESSION_BEGIN_INFO");
  expectInt(i64.from(TYPE_VIEW_STATE), 11, "VIEW_STATE");
  expectInt(i64.from(TYPE_FRAME_END_INFO), 12, "FRAME_END_INFO");
  expectInt(i64.from(TYPE_EVENT_DATA_BUFFER), 16, "EVENT_DATA_BUFFER");
  expectInt(i64.from(TYPE_EVENT_DATA_INSTANCE_LOSS_PENDING), 17, "EVENT_DATA_INSTANCE_LOSS_PENDING");
  expectInt(i64.from(TYPE_EVENT_DATA_SESSION_STATE_CHANGED), 18, "EVENT_DATA_SESSION_STATE_CHANGED");
  expectInt(i64.from(TYPE_INSTANCE_PROPERTIES), 32, "INSTANCE_PROPERTIES");
  expectInt(i64.from(TYPE_FRAME_WAIT_INFO), 33, "FRAME_WAIT_INFO");
  expectInt(i64.from(TYPE_COMPOSITION_LAYER_PROJECTION), 35, "COMPOSITION_LAYER_PROJECTION");
  expectInt(i64.from(TYPE_REFERENCE_SPACE_CREATE_INFO), 37, "REFERENCE_SPACE_CREATE_INFO");
  expectInt(i64.from(TYPE_EVENT_DATA_REFERENCE_SPACE_CHANGE_PENDING), 40, "EVENT_DATA_REFERENCE_SPACE_CHANGE_PENDING");
  expectInt(i64.from(TYPE_VIEW_CONFIGURATION_VIEW), 41, "VIEW_CONFIGURATION_VIEW");
  expectInt(i64.from(TYPE_SPACE_LOCATION), 42, "SPACE_LOCATION");
  expectInt(i64.from(TYPE_FRAME_STATE), 44, "FRAME_STATE");
  expectInt(i64.from(TYPE_VIEW_CONFIGURATION_PROPERTIES), 45, "VIEW_CONFIGURATION_PROPERTIES");
  expectInt(i64.from(TYPE_FRAME_BEGIN_INFO), 46, "FRAME_BEGIN_INFO");
  expectInt(i64.from(TYPE_COMPOSITION_LAYER_PROJECTION_VIEW), 48, "COMPOSITION_LAYER_PROJECTION_VIEW");
  expectInt(i64.from(TYPE_EVENT_DATA_EVENTS_LOST), 49, "EVENT_DATA_EVENTS_LOST");
  expectInt(i64.from(TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO), 55, "SWAPCHAIN_IMAGE_ACQUIRE_INFO");
  expectInt(i64.from(TYPE_SWAPCHAIN_IMAGE_WAIT_INFO), 56, "SWAPCHAIN_IMAGE_WAIT_INFO");
  expectInt(i64.from(TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO), 57, "SWAPCHAIN_IMAGE_RELEASE_INFO");

  // Enumerations and flags
  expectInt(i64.from(SESSION_STATE_IDLE), 1, "IDLE");
  expectInt(i64.from(SESSION_STATE_READY), 2, "READY");
  expectInt(i64.from(SESSION_STATE_SYNCHRONIZED), 3, "SYNCHRONIZED");
  expectInt(i64.from(SESSION_STATE_VISIBLE), 4, "VISIBLE");
  expectInt(i64.from(SESSION_STATE_FOCUSED), 5, "FOCUSED");
  expectInt(i64.from(SESSION_STATE_STOPPING), 6, "STOPPING");
  expectInt(i64.from(SESSION_STATE_LOSS_PENDING), 7, "LOSS_PENDING");
  expectInt(i64.from(SESSION_STATE_EXITING), 8, "EXITING");
  expectInt(i64.from(VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO), 2, "primary stereo");
  expectInt(i64.from(REFERENCE_SPACE_TYPE_LOCAL), 2, "local");
  expectInt(i64.from(REFERENCE_SPACE_TYPE_STAGE), 3, "stage");
  expectInt(i64.from(ENVIRONMENT_BLEND_MODE_OPAQUE), 1, "opaque");
  expectUInt(SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | SWAPCHAIN_USAGE_TRANSFER_SRC_BIT, 9u64, "usage bits");
  expectUInt(VIEW_STATE_ORIENTATION_VALID_BIT | VIEW_STATE_POSITION_VALID_BIT, 3u64, "view state bits");
  expectUInt(SPACE_LOCATION_POSITION_TRACKED_BIT, 8u64, "position tracked");

  // Results and their names
  expectInt(i64.from(ERROR_RUNTIME_FAILURE), -2, "RUNTIME_FAILURE");
  expectInt(i64.from(ERROR_RUNTIME_UNAVAILABLE), -51, "RUNTIME_UNAVAILABLE");
  expectBool(succeeded(SESSION_LOSS_PENDING), true, "a positive result succeeds");
  expectBool(failed(ERROR_HANDLE_INVALID), true, "a negative result fails");
  expectBool(succeeded(ERROR_HANDLE_INVALID), false, "and does not succeed");
  expectStr(resultName(SUCCESS), "SUCCESS", "SUCCESS's name");
  expectStr(resultName(ERROR_RUNTIME_UNAVAILABLE), "ERROR_RUNTIME_UNAVAILABLE", "RUNTIME_UNAVAILABLE's name");
  expectStr(resultName(-1234567i32), "unknown XrResult", "an unlisted value");
  expectStr(sessionStateName(SESSION_STATE_FOCUSED), "FOCUSED", "a state's name");

  // Each struct's type is its own by default, and its next null
  let ci = InstanceCreateInfo(applicationInfo: zeroed[ApplicationInfo](), enabledApiLayerNames: null, enabledExtensionNames: null);
  expectInt(i64.from(ci.type), 3, "InstanceCreateInfo's type");
  let fw = FrameWaitInfo();
  expectInt(i64.from(fw.type), 33, "FrameWaitInfo's type");
  expectInt(i64.from(emptyView().type), 7, "View's type");
  expectInt(i64.from(FrameState().type), 44, "FrameState's type");
  expectInt(i64.from(SessionBeginInfo().primaryViewConfigurationType), 2, "a session begins in stereo");
  expectInt(i64.from(SystemGetInfo().formFactor), 1, "a system is asked for a headset");
  expectInt(i64.from(GraphicsBindingVulkanKHR(instance: 0usize as vulkan.Instance, physicalDevice: 0usize as vulkan.PhysicalDevice,
    device: 0usize as vulkan.Device, queueFamilyIndex: 0u32).type), 1000025000, "the Vulkan binding's type");
  expectInt(i64.from(SwapchainCreateInfo(usageFlags: 1u64, format: 0i64, width: 1u32, height: 1u32).sampleCount), 1, "one sample");
  expectBool(ci.next as usize == 0usize, true, "next is null");
  let p = identityPose();
  expectFloat(p.orientation.w, 1., 0.00001, "the identity pose turns nothing");
  done()
}
