// How long a loop asleep in iocore's poll takes to learn that the GPU has
// finished a job (Target.Loop), against a thread waiting on the job's frame
// itself (Target.Here and 'waitFor'). Each round submits one small job (a
// scramble of 64 words, read back) and times it from submit until the
// waiting thread holds the answer; the rounds alternate between the two, a
// frame ended after each. The GPU's own time is in both, so their
// difference is the cost of the watcher thread, the post to the loop's port
// and the loop's wake.
//
//   congo test wake --release, then run build\release\examples\wake\wake.exe
//   (GPU_POWER_PREFERENCE=low-power for the integrated GPU)

mod wake;

import stdio use *;
import libc;
import collections use List;
import time use Instant, Duration;
import gpu use *;
import gpuwork use *;
import iocore;
import diag use Histogram;

const ROUNDS = 2000usize;

fn preference() u32 {
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize and libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

fn scrambleJob(device &mut Device, kernel &Kernel, words &Array[u32]) Job {
  mut job = Job.make(device);
  imm input = job.give(upload(device, words));
  imm output = job.give(zeroed(device, words.len));
  job.dispatch(device, kernel, &[input, output], 1u32);
  job.readback(device, output);
  job;
}

fn main() i32 {
  mut instance = Instance.create("gpuwork wake");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, preference());
  mut device = adapter.requestDevice();
  if !device.isValid() {
    printStr("no device\n");
    return 1i32;
  }
  mut kernel = Kernel.make(&device, &SCRAMBLE_SPIRV, "scrambleMain", &[READ, READ_WRITE]);
  mut words = List[u32].empty();
  mut i = 0u32;
  while i < 64u32 {
    words.push(i * 2654435761u32);
    i = i + 1u32;
  }
  mut lp = iocore.Loop.mustMake();
  mut io = List[iocore.Completion].empty();
  mut got = List[Completion].empty();
  mut viaLoop = Histogram.make();
  mut viaWait = Histogram.make();
  mut wrong = 0u64;
  {
    mut works = Works.make();
    mut r = 0usize;
    while r < ROUNDS {
      {
        imm job = scrambleJob(&mut device, &kernel, words.view());
        imm to = onLoop(&mut lp, iocore.Target.Here[1u64], 1u64);
        imm t0 = Instant.now();
        works.submit(&mut device, job, to);
        while io.len() == 0usize { lp.poll(iocore.forever(), &mut io); }
        imm t1 = Instant.now();
        if r >= 50usize { viaLoop.record((t1 - t0).nanos()); }
        if works.poll(&device, &mut got) != 1usize or !got[0usize].ok { wrong = wrong + 1u64; }
        io.clear();
        got.clear();
        device.endFrame();
      }
      {
        imm job = scrambleJob(&mut device, &kernel, words.view());
        imm t0 = Instant.now();
        imm ticket = works.submit(&mut device, job, Target.Here[2u64]);
        works.waitFor(&mut device, ticket, &mut got);
        imm t1 = Instant.now();
        if r >= 50usize { viaWait.record((t1 - t0).nanos()); }
        if got.len() != 1usize or !got[0usize].ok { wrong = wrong + 1u64; }
        got.clear();
      }
      r = r + 1usize;
    }
  }
  printStr(adapter.name.view());
  printStr("\n");
  viaLoop.printLine("submit to a loop woken in poll (Target.Loop)");
  viaWait.printLine("submit to waitFor returning (Target.Here)   ");
  printStr("rounds that went wrong: ");
  printUInt(wrong);
  printStr("\n");
  0i32;
}

