// The gpuwork package: handing wide, repetitive work to the GPU. The CPU runs
// the program and coordinates; kernels, GPU programs run once for each of
// thousands of invocations, do the wide work; data moves between them only
// when it must. A library (noise, sdf, sculpt, mesh) records a job over
// buffers, submits it, and later gets exactly one answer for it, carrying
// its buffers back. It is built on the gpu package (devices, buffers,
// compute pipelines, dispatch) and nothing of Vulkan's appears in it.
//
//   mut kernel = Kernel.make(&device, &BAKE_SPIRV, "bake", &[READ, READ_WRITE]);
//   kernel.setTwin2(&bake);                        // its CPU version: the same Cone function
//   mut works = Works.make();
//   mut job = Job.make(&mut device);
//   imm params = job.give(uploadValue(&mut device, &settings));   // buffers moved in
//   imm out = job.give(zeroed(&mut device, 4096usize));
//   job.dispatch(&mut device, &kernel, &[params, out], 16u32);
//   imm back = job.readback(&mut device, out);     // explicit: the CPU reads it
//   imm ticket = works.submit(&mut device, job, Target.Here[7u64]);
//   ...
//   works.poll(&device, &mut done);                // once a frame: never waits
//   // or: works.waitFor(&mut device, ticket, &mut done)   (tools and tests)
//   // or, a frame loop asleep in iocore's poll, woken when the GPU is done:
//   //   works.submit(&mut device, job, onLoop(&mut lp, iocore.Target.Here[9u64], 7u64));
//   //   lp.poll(until, &mut io);                    // the answer: Done, c.n the ticket
//   //   works.poll(&device, &mut done);             // its Completion, the buffers back
//   imm words = done[0usize].words(back);          // the GPU's results
//   mut kept = done[0usize].take(out);             // still on the GPU: the next job's input
//   // a Cone kernel's failure: done[0usize].ok false, done[0usize].failures[0usize]
//
//   Kernel.make(device, spirv, entryPoint, access)   a kernel, made once  (KERNELS)
//   readSpirv(file)  kernel.isValid()  .bindings .workgroup .hasTwin .isCone .name
//   kernel.fileName(id)  READ  READ_WRITE  MAX_KERNEL_BINDINGS  MAX_CONE_KERNEL_BINDINGS
//   upload(device, words)  uploadValue(device, &value)  zeroed(device, n)  (BUFFERS)
//   wordsOf(buffer)
//   Job.make(device)  job.give(buffer)  job.dispatch(device, kernel, slots, x, y, z)  (JOBS)
//   job.readback(device, slot)  job.count()  job.failed
//   Works.make()  works.submit(device, job, to)  works.poll(device, out)    (WORKS)
//   works.flush(device)  works.waitFor(device, ticket, out)  works.waitAll(device, out)
//   works.inFlight()
//   Target.Loop[token, completer]  onLoop(lp, to, token)          (DELIVERY INTO AN IOCORE LOOP)
//   onLoopIn(lp, to, group, deadline, token)  ERROR_JOB_REFUSED  ERROR_JOB_LOST
//   ERROR_KERNEL_FAILED
//   Target.Here[token]  Ticket  Completion: c.ticket c.token c.ok c.buffers c.frame
//     c.submitted c.completed c.failures, c.take(slot) c.words(slot) c.count()  (ANSWERS)
//   KernelFailure: .kernel .dispatch .count .kind .fileId .file .line         (FAILURES ON THE GPU)
//     .invocation .index, f.kindName() f.message()  kernelFailures()
//   FAILED_INDEX  FAILED_RANGE  FAILED_PANIC  FAILED_ALLOCATION  ERROR_BUFFER_WORDS
//   kernel.setTwin1(&f) ... kernel.setTwin7(&f)  kernel.setTwin(f)        (THE TWIN)
//   Invocation  Words: w.u32s() .f32sMut() .atomicU32s() .atomicI32s() ...
//   runTwin(kernel, buffers, x, y, z)  kernel.together  MAX_TOGETHER_INVOCATIONS
//   checkParity(device, kernel, buffers, x, y, z): Parity
//   refusals()
//
// KERNELS. A Kernel is a compute entry point of SPIR-V, made into a pipeline
// once and used by any number of jobs. Its parameters are bound in order:
// binding i is parameter i, group 0, each one storage buffer, READ (a
// read-only slice, '&[]T', or a struct passed by value, which is a small
// read-only storage buffer: there are no push constants, which WebGPU lacks)
// or READ_WRITE (a slice it writes, '&[]mut T'); at most 8. A buffer holds
// 32-bit numbers (u32, i32, f32) and structs and fixed arrays of them. Its
// workgroup's size is read from the SPIR-V. These are the rules of the Cone
// compiler's compute entry points
// ('fn @compute(64) bake(inv Invocation, parts &[]Part, out &[]mut f32)',
// compiled with 'conec --triple=spirv1.6-unknown-vulkan1.3'; the Invocation
// is not a binding, and may stand anywhere among the parameters), and a
// kernel from elsewhere that keeps them is loaded the same way (the tests
// have Slang fixtures, compiled by tools/shaders/, beside Cone kernels;
// gpuwork itself depends on no shading language). A kernel compiled from
// Cone is known by its module's "cone.file <id> <name>" strings (an
// OpSourceExtension for each source file, which conec always writes): it
// has an error buffer, bound after its buffers (FAILURES ON THE GPU), so it
// binds at most 7 buffers (MAX_CONE_KERNEL_BINDINGS), and 'Kernel.make'
// refuses one of 8. A Cone package's kernels are built by Congo into
// <package>.spv, which it copies beside every program that imports the
// package; 'readSpirv("<package>.spv")' reads it from the program's own
// folder (tools/congo/README.md, "Kernels for the GPU").
//
// JOBS AND OWNERSHIP. A job owns the buffers given to it ('give' moves one
// in and answers its slot). Its dispatches bind them by slot, each seeing
// what the job's earlier dispatches wrote, so a chain (evaluate, then mesh,
// then deform) runs on the GPU without returning to the CPU. Submitting the
// job MOVES its buffers with it: the caller holds none of them while the GPU
// may use them, so nothing can touch them, and the job's Completion hands
// them back, in their slots, once the GPU's fence for it has signalled. This
// is iocore's pattern for I/O: an owned buffer moved into the operation, and
// the answer carrying it back. Raw pointers never cross between the CPU and
// the GPU; buffers and offsets do. A buffer handed back is still in the
// GPU's memory, its contents there: given to the next job, it is that job's
// input with no copy, so data stays resident unless the CPU asks for it.
// Reading back is explicit: 'readback' records a copy into a buffer the CPU
// maps, in memory it caches, whose words the Completion gives ('words'),
// copied out in one block (release, RTX 4060 Laptop: 3 MB in 0.4 ms, 40 MB
// in 6 ms). 'zeroed' has the GPU fill its buffer, so no zeros cross from
// the CPU (40 MB in 0.25 ms of the CPU's time, 2 ms to the job done).
//
// A job is recorded into the device's current frame (the gpu package's
// frames in flight), and is complete when the GPU has finished that frame.
// A program that presents ends its frames with the swapchain's 'present'; a
// program with no swapchain ends them with 'works.flush' (or 'waitFor' ends
// the frame of the job it waits for). A job is submitted in the frame it
// was recorded in.
//
// TARGETS AND ANSWERS. Every job submitted gets exactly one Completion: its
// ticket, its token, whether it ran and no Cone kernel in it failed ('ok'),
// its buffers back, when it was submitted and when its completion was seen,
// and its kernels' failures on the GPU. Where it goes is its Target,
// as in iocore: 'Target.Here[token]' delivers it to this Works' own 'poll'
// (or 'waitFor', 'waitAll'). 'poll' never waits: a frame loop calls it once a
// frame and takes what has finished. 'waitFor' blocks until one job is done,
// for tools and tests. The token is plain data gpuwork hands back and never
// reads. Moving to actors later adds a target (a message to an actor) and
// changes nothing else. A Works belongs to the thread that submits through
// it, as a CommandEncoder does.
//
// DELIVERY INTO AN IOCORE LOOP. 'Target.Loop[token, completer]' (or
// 'onLoop(lp, to, token)', which makes the completer with
// 'lp.external(to, IoBuf.empty())'; 'onLoopIn' with a cancel group and a
// deadline) ties the job to an iocore external operation. The job's
// commands then signal a fence of their own (gpu's Fence, never reset, so
// another thread may wait on it), and the Works' watcher, a thread started
// with its first Loop job, waits on each such fence in the order submitted
// and ends the operation when it is signalled. Its answer goes into the
// iocore Loop through the completion port, to the operation's own iocore
// target (Here, Post, Chan, Once or Status), waking a loop asleep in poll:
// a frame loop sleeps in iocore's poll and learns of the GPU's work as of
// any I/O. The answer is Done with the job's ticket number ('c.n'); Failed
// with ERROR_JOB_REFUSED for a job that did not run, ERROR_JOB_LOST for
// one whose fence could not be waited for, or ERROR_KERNEL_FAILED for one in
// which a Cone kernel failed on the GPU; and Cancelled for a job whose
// cancel was asked (lp.cancel, a Request, its group) while it ran. A job on
// the GPU cannot be stopped, so a cancel never makes the answer come early:
// it comes when the GPU has finished, saying the cancel was asked. A job
// whose operation was answered before it was submitted (its group already
// cancelled, its deadline past) is not run. A deadline that passes while
// the job runs is iocore's: TimedOut, promptly, and the watcher's later
// ending dropped.
//
// The buffers do not travel in the iocore answer, which is Sendable and
// I/O-shaped (an IoBuf); a gpu Buffer is the device's thread's. They stay
// in the Works, and the job's Completion, buffers and all, is in the Works'
// 'poll' (or 'waitFor', 'waitAll') once the watcher has seen the fence,
// which it records before it ends the operation: a loop woken by the answer
// finds the Completion in its next 'poll', every time. The answer is the
// wake and the ticket; the Completion is the ownership coming back. A Loop
// job is complete when the GPU has finished it, without waiting for its
// frame to end, so several may run in one frame (each takes two of the
// frame's 16 command buffers). The watcher is ended with its Works, after
// it has seen every fence given it and ended every operation (each fence
// was submitted, so the wait is the GPU's remaining work), and its thread is
// joined: a Works with a Loop job in flight ends without hanging, the
// operation still answered, the buffers dying with it.
//
// MEASURED, release, RTX 4060 Laptop and UHD 770 (examples/wake.cone; a
// scramble of 64 words read back, 1,950 rounds each): from submit to a
// loop woken in poll, p50 164 to 205 us, p99 330 to 380 us on the RTX;
// p50 205 to 246 us, p99 440 to 820 us on the UHD (four runs each). A
// thread blocking on the job's frame itself ('waitFor') is no faster: p50
// 188 to 238 us and 205 to 246 us. The watcher's hop is within the histogram's resolution (iocore
// measures an external operation ended on another thread, to a loop asleep
// in poll, at 5 us p50).
//
// FAILURES ON THE GPU. A GPU has no program to end: in a Cone kernel, a
// failed index or range check, a panic, an assert, an unreachable or a todo
// records what failed in the kernel's error buffer and stops that
// invocation, the others going on. gpuwork gives each dispatch of a Cone
// kernel an error buffer of its own (8 words, zeroed before the dispatch,
// bound after the kernel's buffers), copies it after the dispatch into a
// buffer the CPU maps, and reads it when the job is complete. If word 0, the
// count of failed invocations, is not 0, the dispatch failed: its failure is
// a KernelFailure in the job's Completion ('c.failures', one for each
// failing dispatch, in the order dispatched), the Completion is not ok, and
// the failure is printed to stderr and counted ('kernelFailures()'):
//
//   gpuwork: kernel 'oob' (dispatch 0) failed: index out of bounds at
//     kernels.cone:104, invocation (37, 0, 0), index 165; 1 invocation failed
//
// naming the kernel, the dispatch's place in its job, what failed (its
// 'kind', word 1), the source file (word 2, a file id, named by the
// module's "cone.file" strings) and line (word 3), the first failed
// invocation's globalId (words 4 to 6), the index out of bounds or the
// range's end (word 7), and how many invocations failed. A Loop job in
// which a kernel failed answers its iocore operation Failed, with
// ERROR_KERNEL_FAILED. A failure on the GPU is reported, not raised: the
// program goes on, its job's buffers back, and decides what the failure
// means (a CPU panic is one thing it may do).
//
// THE TWIN. Every kernel can have a CPU version, its twin: a function called
// once for each Invocation of a dispatch, with the dispatch's buffers. A Cone
// kernel's own function is its twin, compiled for the CPU, where a compute
// entry point is an ordinary function: 'kernel.setTwin3(&bake)' for
// 'fn @compute(64) bake(inv Invocation, s Settings, parts &[]Part,
// out &[]mut f32)', one of 'setTwin1' to 'setTwin7' for each count of
// buffers, the Invocation first. Each slice parameter is given its buffer as
// a slice of as many elements as the buffer holds (its element's size read
// from the SPIR-V's ArrayStride), as on the GPU, and each struct parameter
// its buffer's first bytes (a buffer too small for it refuses the run); a
// parameter that is a struct where the SPIR-V binds a slice is refused (only
// sizes can be compared, so a slice where it binds a 16-byte struct is not).
// A slice of atomics, '&[]mut Atomic[u32]' or '&[]mut Atomic[i32]' (a
// counter whose 'add' hands each invocation its slot), is a slice parameter
// like any other. A kernel from
// elsewhere has a twin written as an adapter, 'setTwin(f)', given the
// buffers as Words (32-bit words, read as u32s, i32s, f32s, atomics of u32
// or i32 ('atomicU32s', 'atomicI32s') or one struct) and calling a Cone
// function written as the kernel is. Either way the
// kernel's body is one Cone function both sides call: a loop over
// invocations is how the CPU runs a kernel. 'runTwin' runs it over buffers
// of words, workgroup by workgroup in a fixed order. A kernel without
// barriers runs invocation by invocation, in a fixed order, on the calling
// thread. A kernel with them ('kernel.together': 'Kernel.make' finds an
// OpControlBarrier, which 'workgroupBarrier()' and 'storageBarrier()' each
// are, in its entry point or any function it calls, however deep) runs each
// workgroup's invocations together: one thread for each invocation of a
// workgroup (at most MAX_TOGETHER_INVOCATIONS, 256, WebGPU's limit and the
// compiler's; more is refused), started by 'runTwin' and joined before it
// returns, each running its invocation of every workgroup in turn. Each
// thread sets its barrier hook (core's 'setBarrierHook', thread-local) to a
// generation-counting futex barrier the workgroup's threads meet at, so a
// barrier waits for every invocation of the workgroup, as on the GPU, and
// orders every write before it before every read after it; a
// storageBarrier waits as a workgroupBarrier does. The threads meet there
// again after each workgroup, so the workgroups run one after another and
// the one native copy of each '@workgroup' global is the running
// workgroup's own. Nothing resets it between workgroups: on the GPU
// workgroup memory starts undefined, so a correct kernel writes its
// '@workgroup' memory before it reads it, and one that reads first gets, on
// its twin, what the last workgroup left. Every invocation must reach every
// barrier its workgroup's others do, as on the GPU (barriers in uniform
// control flow): one that returns early, or fails, leaves the others waiting
// for ever. So a prefix sum across a workgroup, or a tree reduction, whose
// invocations read after a barrier what others wrote, gives the GPU's answer
// on its twin (tests/kernels.cone runs each 100 times, bit for bit).
// 'checkParity' runs a kernel on the GPU and its twin on the CPU over the
// same starting buffers and compares every word each wrote, bit for bit:
// anything that shapes geometry must be the same on every GPU and on the
// twin (the determinism rules for compute are in the repository's
// CLAUDE.md). Invocation is core's, which the compiler's compute entry
// points take: global id, local id, group id (each three u32s), the flat
// local index (x fastest) and the group count.
//
// REFUSALS. A request gpuwork cannot honour (a kernel with more than 8
// bindings, or a Cone kernel with more than 7, a direct twin that does not
// fit its kernel, a dispatch whose slots do not match its kernel's bindings or
// name a buffer twice, which WebGPU refuses, a readback of a buffer that
// cannot be copied) is printed to stderr ("gpuwork: ...") and counted
// ('refusals()'); a job something was refused in is not run, and completes
// not ok, with its buffers back, when its frame is done. The gpu package's
// own failures are its 'failures()'.
//
// Not here yet: the parallel building blocks as library functions
// (count-then-write, prefix sums, compaction; tests/kernels.cone has a
// compaction, a workgroup's sum, a workgroup's prefix sum and a tree
// reduction written as kernels); a pool of twin threads kept across
// dispatches (today each 'runTwin' of a kernel with barriers starts its
// own); delivery to
// an actor; a Here job that completes without its frame ending (a Loop job
// does); reusing bind groups across
// jobs; GPU memory as a region; textures; and whether a read-only input is
// moved into a job or shared immutably (today every buffer is moved); a
// direct twin whose Invocation is not its first parameter. (Congo builds the
// kernels of a library marked for the GPU; the tests' kernels.cone, a
// program, has its own compiled by tests/kernels.py.)
//
// Its files are one module, and only this one, the root, imports:
//
//   gpuwork.cone  refusals, kernelFailures
//   kernel.cone   Kernel, its direct twin, and what is read from the SPIR-V:
//                 its workgroup, its bindings' shapes, its Cone source files,
//                 whether it has barriers; readSpirv
//   job.cone      buffers made and read back, Job, and a Cone kernel's error
//                 buffer and KernelFailure
//   works.cone    Ticket, Target, Completion and Works
//   twin.cone     Words, runTwin (a workgroup together on threads, for a
//                 kernel with barriers), checkParity and Parity

mod gpuwork;

import libc;
import collections use List, String;
import time use Instant;
import thread;
import sync use Arc, Sender, Receiver, Channel;
import iobuf use IoBuf;
import iocore;
import gpu use *;
import fs;
import path;
import process;

// ---------------------------------------------------------------------------
// Failures
// ---------------------------------------------------------------------------

mut refusalCount = 0u32;

// How many requests gpuwork has refused (each also printed to stderr);
// gpu's 'failures()' counts the layer beneath
pub fn refusals() u32 { refusalCount; }

mut kernelFailureCount = 0u32;

// How many Cone kernels' dispatches have failed on the GPU (each also
// printed to stderr, and in its job's Completion as a KernelFailure)
pub fn kernelFailures() u32 { kernelFailureCount; }

// Report a refusal, and count it
fn fail(msg &[]u8) {
  refusalCount = refusalCount + 1u32;
  say(msg);
}

// Report a kernel's failure on the GPU, and count it
fn failKernel(msg &[]u8) {
  kernelFailureCount = kernelFailureCount + 1u32;
  say(msg);
}

// Print a line to stderr, "gpuwork: " first
fn say(msg &[]u8) {
  mut m = String.from("gpuwork: ");
  m <- msg;
  m.appendByte('\n');
  imm v &[]u8 = m.view();
  libc.fflush(libc.stdout());
  libc.fwrite(v, 1usize, v.len, libc.stderr());
}
