// ---- The CPU twin: a kernel run on the CPU, and parity with the GPU ----

// One of a dispatch's buffers as its twin sees it: 32-bit words, read as
// u32s, i32s or f32s (their bits), as atomics of u32 or i32 (core's
// Atomic, four bytes, its number and nothing more, as on the GPU), or as one
// struct, as the GPU's kernel binds the same buffer. Plain data, copied
// freely: a view of words the twin
// runner owns, valid for the run, the CPU's counterpart of a binding. Its
// first two fields are laid out as a slice is (a pointer, then a count of
// elements), which a direct twin's slice parameter is read from.
pub struct Words {
  ptr *u32;
  elems usize;                 // a slice binding's elements (its words for a struct)
  pub len usize;               // its words
  slice bool;                  // bound as a slice, as the kernel's SPIR-V says

  pub fn u32s(self) &Array[u32] { mem.sliceFromParts[u32](ptr, len); }
  pub fn u32sMut(self) &mut Array[u32] { mem.sliceFromPartsMut[u32](ptr, len); }
  pub fn i32s(self) &Array[i32] { mem.sliceFromParts[i32](ptr as *i32, len); }
  pub fn i32sMut(self) &mut Array[i32] { mem.sliceFromPartsMut[i32](ptr as *i32, len); }
  pub fn f32s(self) &Array[f32] { mem.sliceFromParts[f32](ptr as *f32, len); }
  pub fn f32sMut(self) &mut Array[f32] { mem.sliceFromPartsMut[f32](ptr as *f32, len); }
  // As '&mut Array[Atomic[u32]]' or '&mut Array[Atomic[i32]]', what a kernel declares
  // for a counter or slots its invocations claim ('count[0usize].add(1u32)')
  pub fn atomicU32s(self) &mut Array[Atomic[u32]] { mem.sliceFromPartsMut[Atomic[u32]](ptr as *Atomic[u32], len); }
  pub fn atomicI32s(self) &mut Array[Atomic[i32]] { mem.sliceFromPartsMut[Atomic[i32]](ptr as *Atomic[i32], len); }

  // Its first words as a T (a by-value struct parameter)
  pub fn value[T](self) T { mem.readRaw[T](ptr as *T); }
}

// The most invocations a workgroup whose twin runs them together may have,
// each on a thread of its own: WebGPU's maxComputeInvocationsPerWorkgroup
pub const MAX_TOGETHER_INVOCATIONS = 256u32;

// Run 'kernel''s CPU twin over 'buffers' (binding i the words of
// 'buffers[i]', which it reads and writes in place) as a dispatch of 'x' by
// 'y' by 'z' workgroups would: once for each invocation, workgroup by
// workgroup (x fastest). A kernel without barriers runs invocation by
// invocation within a workgroup (x fastest), on this thread, in that fixed
// order; a kernel with them ('kernel.together') runs each workgroup's
// invocations together, one thread each, meeting at every barrier (see
// 'runTogether'). A direct twin ('setTwin1' to 'setTwin7') is given each
// slice binding as a slice of as many elements as the buffer holds, as the
// GPU's kernel sees it, and each struct binding's struct. False, and nothing
// run, if the kernel has no twin, the buffers are not one for each binding,
// a direct twin's struct is larger than its buffer, or a kernel with
// barriers has a workgroup of more than MAX_TOGETHER_INVOCATIONS.
pub fn runTwin(kernel &Kernel, buffers &mut List[List[u32]], x u32, y u32 = 1u32, z u32 = 1u32) bool {
  if !kernel.hasTwin or buffers.len() != usize.from(kernel.bindings) {
    fail("runTwin: the kernel has no twin, or the buffers are not one for each binding");
    return false;
  }
  let size = kernel.workgroup[0usize] * kernel.workgroup[1usize] * kernel.workgroup[2usize];
  if kernel.together and size > MAX_TOGETHER_INVOCATIONS {
    fail("runTwin: a kernel with barriers has a workgroup of more than 256 invocations, a thread each");
    return false;
  }
  var words = List[Words].empty();
  var b = 0usize;
  while b < buffers.len() {
    let inner = &mut buffers[b];
    let v = inner.viewMut();
    let p = if v.len > 0usize { &mut v[0usize] as *u32; } else { null as *u32; };
    let slice = kernel.hasDirect and kernel.shapes[b] == SHAPE_SLICE;
    let elems = if slice { v.len * 4usize / usize.from(kernel.strides[b]); } else { v.len; };
    if kernel.hasDirect and !slice and v.len * 4usize < usize.from(kernel.needs[b]) {
      fail("runTwin: a buffer is smaller than the struct its direct twin reads from it");
      return false;
    }
    words.push(new Words(p, elems, v.len, slice));
    b = b + 1usize;
  }
  let view = words.view();
  if kernel.together {
    runTogether(kernel, view, x, y, z);
    return true;
  }
  let wx = kernel.workgroup[0usize];
  let wy = kernel.workgroup[1usize];
  let wz = kernel.workgroup[2usize];
  var gz = 0u32;
  while gz < z {
    var gy = 0u32;
    while gy < y {
      var gx = 0u32;
      while gx < x {
        var lz = 0u32;
        while lz < wz {
          var ly = 0u32;
          while ly < wy {
            var lx = 0u32;
            while lx < wx {
              let inv = new Invocation([gx * wx + lx, gy * wy + ly, gz * wz + lz], [lx, ly, lz], [gx, gy, gz],
                lx + wx * (ly + wy * lz), [x, y, z]);
              kernel.twin(inv, view);
              lx = lx + 1u32;
            }
            ly = ly + 1u32;
          }
          lz = lz + 1u32;
        }
        gx = gx + 1u32;
      }
      gy = gy + 1u32;
    }
    gz = gz + 1u32;
  }
  true;
}

// ---- A workgroup's invocations together, on threads ----

// A dispatch run together: the generation-counting barrier its invocations
// meet at (the last of 'size' to arrive resets 'arrived' and moves
// 'generation' on, waking the others, who sleep on it until it has moved),
// and what each thread needs to run its invocation of every workgroup. It
// lives on the stack of 'runTogether', which joins every thread before it
// returns.
struct Together {
  arrived Atomic[u32];
  generation Atomic[u32];
  size u32;                    // invocations a workgroup: the threads
  kernel *Kernel;
  words *Words;                // the bindings,
  count usize;                 // as many
  groups Array[u32, 3];        // the dispatch's workgroups, each way
}

// The barrier: each thread's hook, ctx its Together, whatever the kind (a
// thread waits for every other at a storageBarrier as at a workgroupBarrier,
// and the futex's atomics order every write before it, workgroup and storage
// memory alike, before every read after it)
fn togetherWait(ctx *u8, kind u32) {
  let t = ctx as *Together;
  let gen = (*t).generation.load();
  if (*t).arrived.add(1u32) == (*t).size - 1u32 {
    (*t).arrived.store(0u32);
    (*t).generation.store(gen + 1u32);
    sync.futexWakeAll(&(*t).generation);
  } else {
    while (*t).generation.load() == gen {
      sync.futexWait(&(*t).generation, gen);
    }
  }
}

// What a thread is given: its dispatch, and its invocation's place in each
// workgroup (its flat local index). Its pointer is to the Together that
// 'runTogether' keeps alive until every thread is joined.
struct Lane is Sendable {
  together *Together;
  index u32;
}

// One thread's work: its invocation of each workgroup in turn, x fastest, its
// barrier hook set to the dispatch's barrier; after each workgroup, a wait
// at that barrier, so that no thread starts the next workgroup, and writes
// its '@workgroup' globals, while another still reads this one's
fn runLane(lane Lane) {
  let t = lane.together;
  let k = (*t).kernel;
  let ctx = t as *u8;
  setBarrierHook(&togetherWait, ctx);
  let view = mem.sliceFromParts[Words]((*t).words, (*t).count);
  let wx = (*k).workgroup[0usize];
  let wy = (*k).workgroup[1usize];
  let wz = (*k).workgroup[2usize];
  let x = (*t).groups[0usize];
  let y = (*t).groups[1usize];
  let z = (*t).groups[2usize];
  let l = lane.index;
  let lx = l % wx;
  let ly = (l / wx) % wy;
  let lz = l / (wx * wy);
  var gz = 0u32;
  while gz < z {
    var gy = 0u32;
    while gy < y {
      var gx = 0u32;
      while gx < x {
        let inv = new Invocation([gx * wx + lx, gy * wy + ly, gz * wz + lz], [lx, ly, lz], [gx, gy, gz], l,
          [x, y, z]);
        (*k).twin(inv, view);
        togetherWait(ctx, 0u32);
        gx = gx + 1u32;
      }
      gy = gy + 1u32;
    }
    gz = gz + 1u32;
  }
  clearBarrierHook();
}

// Run a kernel with barriers over 'view', in 'x' by 'y' by 'z' workgroups:
// one thread for each invocation of a workgroup, started here and joined
// before it returns, each running its invocation of every workgroup, one
// workgroup after another. So the one native copy of each '@workgroup'
// global is the workgroup running's own, as on the GPU each workgroup has
// its own; and nothing resets it between workgroups, as nothing does on the
// GPU, where workgroup memory starts undefined.
fn runTogether(kernel &Kernel, view &Array[Words], x u32, y u32, z u32) {
  let size = kernel.workgroup[0usize] * kernel.workgroup[1usize] * kernel.workgroup[2usize];
  var t = new Together(Atomic[u32].of(0u32), Atomic[u32].of(0u32), size, kernel as *Kernel,
    if view.len > 0usize { &view[0usize] as *Words; } else { null as *Words; }, view.len, [x, y, z]);
  let pt = &mut t as *Together;
  {
    // A handle dropped joins its thread: every one, at the block's end
    var lanes = List[thread.Thread[void]].empty();
    var l = 0u32;
    while l < size {
      lanes.push(thread.start(new Lane(pt, l), &runLane));
      l = l + 1u32;
    }
  }
}

// How a kernel's GPU run and its CPU twin compared: every word of every
// buffer the kernel writes (READ_WRITE), bit for bit
pub struct Parity {
  pub ran bool;                // both ran
  pub compared u64;            // words compared
  pub mismatched u64;          // words that differ
  pub firstBinding u32;        // the first that differs: its binding and index,
  pub firstIndex u64;
  pub gpuWord u32;             // and the two words
  pub cpuWord u32;

  // Whether the two agree, every bit of every word written
  pub fn exact(self &) bool { ran and mismatched == 0u64 and compared > 0u64; }
}

// Run 'kernel' on the GPU and its CPU twin on the CPU, each over its own
// copy of 'buffers' (binding i starting as 'buffers[i]'), in 'x' by 'y' by
// 'z' workgroups, and compare what each wrote, bit for bit. It waits for the
// GPU (ending the device's frame): for tests and tools.
pub fn checkParity(device &mut Device, kernel &Kernel, buffers &List[List[u32]], x u32, y u32 = 1u32,
    z u32 = 1u32) Parity {
  var result = new Parity(false, 0u64, 0u64, 0u32, 0u64, 0u32, 0u32);
  if !kernel.hasTwin or buffers.len() != usize.from(kernel.bindings) {
    fail("checkParity: the kernel has no twin, or the buffers are not one for each binding");
    return result;
  }
  // The GPU's run: its own Works, so that no one else's completions are taken
  var works = Works.make();
  var job = Job.make(device);
  var slots = List[u32].empty();
  var b = 0usize;
  while b < buffers.len() {
    slots.push(job.give(upload(device, buffers[b].view())));
    b = b + 1usize;
  }
  job.dispatch(device, kernel, slots.view(), x, y, z);
  var backs = List[u32].empty();
  b = 0usize;
  while b < buffers.len() {
    backs.push(if kernel.accessOf(u32.from(b)) == READ_WRITE { job.readback(device, u32.from(b)); } else { 0u32; });
    b = b + 1usize;
  }
  let ticket = works.submit(device, job, Target.Here(0u64));
  var done = List[Completion].empty();
  works.waitFor(device, ticket, &mut done);
  if done.len() != 1usize or !done[0usize].ok { return result; }

  // The twin's run, over copies
  var cpu = List[List[u32]].empty();
  b = 0usize;
  while b < buffers.len() {
    let src = buffers[b].view();
    var copy = List[u32].withCapacity(src.len);
    var i = 0usize;
    while i < src.len {
      copy.push(src[i]);
      i = i + 1usize;
    }
    cpu.push(copy);
    b = b + 1usize;
  }
  if !runTwin(kernel, &mut cpu, x, y, z) { return result; }
  result.ran = true;

  // Word by word
  b = 0usize;
  while b < buffers.len() {
    if kernel.accessOf(u32.from(b)) == READ_WRITE {
      let gpuWords = done[0usize].words(*backs[b]);
      let cpuWords = cpu[b].view();
      var i = 0usize;
      while i < cpuWords.len {
        let g = if i < gpuWords.len() { *gpuWords[i]; } else { 0u32; };
        if g != cpuWords[i] {
          if result.mismatched == 0u64 {
            result.firstBinding = u32.from(b);
            result.firstIndex = u64.from(i);
            result.gpuWord = g;
            result.cpuWord = cpuWords[i];
          }
          result.mismatched = result.mismatched + 1u64;
        }
        result.compared = result.compared + 1u64;
        i = i + 1usize;
      }
    }
    b = b + 1usize;
  }
  result;
}
