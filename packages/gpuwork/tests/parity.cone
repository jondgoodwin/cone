// gpuwork's parity harness on a real GPU: a kernel run on the GPU and its
// CPU twin on the CPU, every word each writes compared bit for bit.
//
// The kernel is noisebake.slang's bakeMain, a fixture over noise.slang (the
// library does not depend on Slang): noise's fBm (4 octaves, lacunarity 2,
// gain 0.5, seed 7) at 16 x 16 x 16 points, voxel (x, y, z) at
// (-2.03125 + x / 16, 0.53125 + y / 16, 1.25 + z / 16), every coordinate a
// multiple of 1/32, so exact in binary, each one multiply and one add in
// the same order on both sides. It writes the value and the derivative (four
// f32s a voxel) and the voxel's lattice hash (a u32). Its twin is 'bake'
// below, in the shape of a Cone compute entry point, over noise's
// Cone functions, called once for each Invocation.
//
// fBm and its derivative use only add, subtract, multiply and floor,
// compiled with '-fp-mode precise', and the hash is integer arithmetic, so
// all 20,480 words must be identical.
//
// Only a failure prints. With GPUWORK_REPORT set, it also prints the adapter.
// GPU_POWER_PREFERENCE=low-power tests the integrated GPU where there are
// two. It needs a GPU driver with Vulkan 1.3 and SDL3.dll; with the Vulkan
// SDK, validation and synchronization validation are on, and must say
// nothing.

mod parity;

import testing use *;
import stdio use *;
import libc;
import collections use List;
import geomath use Vec3;
import gpu use *;
import gpuwork use *;
import noise use fbm3, hash3;

const SIZE = 16u32;

fn preference() u32 {
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize and libc.strcmp(env, &"low-power" as *u8) == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

// The 32 bits of an f32 ('as' reinterprets)
fn bits(f f32) u32 { f as u32; }

// What the kernel is given by value: noisebake.slang's Bake, byte for byte
struct Bake {
  ox f32;
  oy f32;
  oz f32;
  step f32;
  seed u32;
  size u32;
}

// The kernel, as a Cone compute entry point declares it
// ('fn @compute(64) bake(inv Invocation, b Bake, out &[]mut f32,
// hashes &[]mut u32)'): voxel inv.globalId's fBm and hash
fn bake(inv Invocation, b Bake, out &[]mut f32, hashes &[]mut u32) {
  imm x = inv.globalId[0usize];
  imm y = inv.globalId[1usize];
  imm z = inv.globalId[2usize];
  if x >= b.size or y >= b.size or z >= b.size { return; }
  imm p = new Vec3(b.ox + f32.from(x) * b.step, b.oy + f32.from(y) * b.step, b.oz + f32.from(z) * b.step);
  imm n = fbm3(p, b.seed, 4, 2., 0.5);
  imm v = usize.from(x + b.size * (y + b.size * z));
  out[4usize * v] = n.value;
  out[4usize * v + 1usize] = n.d.x;
  out[4usize * v + 2usize] = n.d.y;
  out[4usize * v + 3usize] = n.d.z;
  hashes[v] = hash3(i32.from(x), i32.from(y), i32.from(z), b.seed).x;
}

// Its twin, as gpuwork calls it: the bindings as words
fn bakeTwin(inv Invocation, buffers &[]Words) {
  bake(inv, buffers[0usize].value[Bake](), buffers[1usize].f32sMut(), buffers[2usize].u32sMut());
}

// 'count' zero words
fn zeros(count usize) List[u32] {
  mut l = List[u32].withCapacity(count);
  mut i = 0usize;
  while i < count {
    l.push(0u32);
    i = i + 1usize;
  }
  l;
}

fn main() i32 {
  mut instance = Instance.create("gpuwork parity");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  if (libc.getenv(&"GPUWORK_REPORT" as *u8) as usize) != 0usize {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr("\n");
  }

  mut kernel = Kernel.make(&device, &NOISEBAKE_SPIRV, "bakeMain", &[READ, READ_WRITE, READ_WRITE]);
  require(kernel.isValid(), "the bake kernel");
  expectUInt(u64.from(kernel.workgroup[0usize]) * 100u64 + u64.from(kernel.workgroup[1usize]) * 10u64
    + u64.from(kernel.workgroup[2usize]), 444u64, "its workgroup, 4 x 4 x 4, read from the SPIR-V");
  expectBool(kernel.hasTwin, false, "no twin until given one");
  kernel.setTwin(&bakeTwin);

  imm voxels = usize.from(SIZE * SIZE * SIZE);
  mut buffers = List[List[u32]].empty();
  mut params = List[u32].empty();
  params.push(bits(-2.03125));
  params.push(bits(0.53125));
  params.push(bits(1.25));
  params.push(bits(0.0625));
  params.push(7u32);
  params.push(SIZE);
  buffers.push(params);
  buffers.push(zeros(4usize * voxels));
  buffers.push(zeros(voxels));

  imm groups = SIZE / 4u32;
  imm p = checkParity(&mut device, &kernel, &buffers, groups, groups, groups);
  expectBool(p.ran, true, "the GPU and the twin both ran");
  expectUInt(p.compared, 20480u64, "every word written compared: 4 a voxel and its hash");
  if !expectUInt(p.mismatched, 0u64, "every word the same, bit for bit") {
    printStr("first difference: binding ");
    printUInt(u64.from(p.firstBinding));
    printStr(", word ");
    printUInt(p.firstIndex);
    printStr("\n");
  }
  expectBool(p.exact(), true, "exact parity");
  expectUInt(u64.from(refusals()), 0u64, "nothing refused");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}

