// cone-spirv-end

// A direct twin of the wrong shape: a struct where 'lengths' binds a slice
fn wrongShape(inv Invocation, s Scale, out &[]mut f32) {}

// hash2's twin through the Words adapter
fn hashTwin(inv Invocation, buffers &[]Words) {
  hash2(inv, buffers[0usize].u32s(), buffers[1usize].u32sMut());
}

// compact's twin through the Words adapter: the counter its atomic view
fn compactTwin(inv Invocation, buffers &[]Words) {
  compact(inv, buffers[0usize].u32s(), buffers[1usize].atomicU32s(), buffers[2usize].u32sMut());
}

// Sort 'w' ascending (insertion sort: a test's few hundred words)
fn sortWords(w &mut List[u32]) {
  imm v = w.viewMut();
  mut i = 1usize;
  while i < v.len {
    imm x = v[i];
    mut j = i;
    while j > 0usize and v[j - 1usize] > x {
      v[j] = v[j - 1usize];
      j = j - 1usize;
    }
    v[j] = x;
    i = i + 1usize;
  }
}

fn sameWords(a &[]u32, b &[]u32) Bool {
  if a.len != b.len { return false; }
  mut i = 0usize;
  while i < a.len {
    if a[i] != b[i] { return false; }
    i = i + 1usize;
  }
  true;
}

// Run 'kernel' (compact) on its twin over 'input', a zero counter and an
// output as long as the input, and expect the GPU's count and, sorted, its
// values kept
fn compactOnTwin(kernel &Kernel, input &List[u32], gpuCount u32, gpuKept &[]u32, what &[]u8) {
  mut buffers = List[List[u32]].empty();
  mut copy = List[u32].empty();
  mut i = 0usize;
  while i < input.len() {
    copy.push(*input[i]);
    i = i + 1usize;
  }
  buffers.push(copy);
  buffers.push(zeros(1usize));
  buffers.push(zeros(input.len()));
  expectBool(runTwin(kernel, &mut buffers, 16u32), true, what);
  imm count = *buffers[1usize][0usize];
  expectUInt(u64.from(count), u64.from(gpuCount), what);
  mut kept = List[u32].empty();
  i = 0usize;
  while i < usize.from(count) {
    kept.push(*buffers[2usize][i]);
    i = i + 1usize;
  }
  sortWords(&mut kept);
  expect(sameWords(kept.view(), gpuKept), what);
}

fn preference() u32 {
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize and libc.strcmp(env, &"low-power" as *u8) == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

// The 32 bits of an f32 ('as' reinterprets)
fn bits(f f32) u32 { f as u32; }

// 'count' zero words
fn zeros(count usize) List[u32] {
  mut l = List[u32].withCapacity(count);
  mut i = 0usize;
  while i < count {
    l.push(0u32);
    i = i + 1usize;
  }
  l;
}

// 'count' words, word i 'a * i + b'
fn ramp(count usize, a u32, b u32) List[u32] {
  mut l = List[u32].withCapacity(count);
  mut i = 0u32;
  while usize.from(i) < count {
    l.push(a * i + b);
    i = i + 1u32;
  }
  l;
}

fn sameStr(a &[]u8, b &[]u8) Bool {
  if a.len != b.len { return false; }
  mut i = 0usize;
  while i < a.len {
    if a[i] != b[i] { return false; }
    i = i + 1usize;
  }
  true;
}

// Run 'kernel' over 'buffers' on the GPU and its twin on the CPU, and
// expect every word written the same
fn parity(device &mut Device, kernel &Kernel, buffers &List[List[u32]], x u32, y u32, what &[]u8) {
  imm p = checkParity(device, kernel, buffers, x, y);
  expectBool(p.ran, true, what);
  if !expect(p.exact(), what) {
    printStr("  compared ");
    printUInt(p.compared);
    printStr(", mismatched ");
    printUInt(p.mismatched);
    printStr(", first at binding ");
    printUInt(u64.from(p.firstBinding));
    printStr(" word ");
    printUInt(p.firstIndex);
    printStr(": GPU ");
    printUInt(u64.from(p.gpuWord));
    printStr(", CPU ");
    printUInt(u64.from(p.cpuWord));
    printStr("\n");
  }
}

// A job of one dispatch of 'kernel' (one read-write binding, 'n' words, in
// 'groups' workgroups), read back, submitted Here and waited for: its
// Completion, and the words read back
fn runOne(device &mut Device, works &mut Works, kernel &Kernel, n usize, groups u32, done &mut List[Completion]) {
  mut job = Job.make(device);
  imm out = job.give(zeroed(device, n));
  job.dispatch(device, kernel, &[out], groups);
  job.readback(device, out);
  imm ticket = works.submit(device, job, Target.Here[0u64]);
  works.waitFor(device, ticket, done);
}

// Expect failure 'f' to be as described
fn expectFailure(f &KernelFailure, kernel &[]u8, dispatch u32, count u32, kind u32, line u32, x u32, index u32,
    what &[]u8) {
  mut ok = sameStr(f.kernel.view(), kernel) and f.dispatch == dispatch and f.count == count and f.kind == kind
    and sameStr(f.file.view(), "kernels.cone") and f.line == line and f.invocation[0usize] == x
    and f.invocation[1usize] == 0u32 and f.invocation[2usize] == 0u32 and f.index == index;
  if !expect(ok, what) {
    printStr("  got: ");
    imm m = f.message();
    printStr(m.view());
    printStr("\n");
  }
}

fn main() i32 {
  mut instance = Instance.create("gpuwork kernels");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  if (libc.getenv(&"GPUWORK_REPORT" as *u8) as usize) != 0usize {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr("\n");
  }

  // ---- 1. Parity with the CPU twins ----
  mut scaleK = Kernel.make(&device, &KERNELS_SPIRV, "scale", &[READ, READ, READ_WRITE]);
  require(scaleK.isValid(), "the scale kernel");
  expectBool(scaleK.isCone, true, "a Cone kernel, known by its module's cone.file strings");
  expectUInt(u64.from(scaleK.workgroup[0usize]), 64u64, "its workgroup, from @compute(64)");
  scaleK.setTwin3(&scale);
  expectBool(scaleK.hasTwin, true, "its direct twin, the kernel's own function");
  {
    mut buffers = List[List[u32]].empty();
    mut s = List[u32].empty();
    s.push(bits(1.3125));
    s.push(bits(-0.0390625));
    buffers.push(s);
    mut a = List[u32].empty();
    mut i = 0u32;
    while i < 200u32 {
      a.push(bits(f32.from(i) * 0.37 - 5.1));
      i = i + 1u32;
    }
    buffers.push(a);
    buffers.push(zeros(200usize));
    parity(&mut device, &scaleK, &buffers, 4u32, 1u32, "scale: every word the twin's, bit for bit");
  }

  mut lengthsK = Kernel.make(&device, &KERNELS_SPIRV, "lengths", &[READ, READ_WRITE]);
  require(lengthsK.isValid(), "the lengths kernel");
  lengthsK.setTwin2(&lengths);
  {
    mut buffers = List[List[u32]].empty();
    mut pts = List[u32].empty();
    mut i = 0u32;
    while i < 90u32 {
      pts.push(bits(f32.from(i) * 0.25 - 3.0));
      i = i + 1u32;
    }
    buffers.push(pts);              // 30 points of 12 bytes
    buffers.push(zeros(40usize));   // 40 outputs: the last 10 stay zero
    parity(&mut device, &lengthsK, &buffers, 1u32, 1u32, "lengths: a slice of 12-byte structs, the twin's");
    mut cpu = List[List[u32]].empty();
    mut again = List[u32].empty();
    i = 0u32;
    while i < 90u32 {
      again.push(bits(f32.from(i) * 0.25 - 3.0));
      i = i + 1u32;
    }
    cpu.push(again);
    cpu.push(zeros(40usize));
    runTwin(&lengthsK, &mut cpu, 1u32);
    expect(*cpu[1usize][29usize] != 0u32 and *cpu[1usize][30usize] == 0u32,
      "the direct twin's slice holds 30 points, as the GPU's does");
  }

  mut hashK = Kernel.make(&device, &KERNELS_SPIRV, "hash2", &[READ, READ_WRITE]);
  require(hashK.isValid(), "the hash2 kernel");
  expectUInt(u64.from(hashK.workgroup[0usize]) * 10u64 + u64.from(hashK.workgroup[1usize]), 88u64,
    "its workgroup, 8 x 8");
  hashK.setTwin(&hashTwin);
  {
    mut buffers = List[List[u32]].empty();
    buffers.push(ramp(37usize, 2654435761u32, 12345u32));
    buffers.push(zeros(32usize * 24usize));
    parity(&mut device, &hashK, &buffers, 4u32, 3u32, "hash2: 32 x 24 cells, the Words twin's");
  }

  mut sevenK = Kernel.make(&device, &KERNELS_SPIRV, "seven", &[READ, READ, READ, READ, READ, READ, READ_WRITE]);
  require(sevenK.isValid(), "seven buffers: the most a Cone kernel binds");
  sevenK.setTwin7(&seven);
  {
    mut buffers = List[List[u32]].empty();
    mut k = 0u32;
    while k < 6u32 {
      buffers.push(ramp(100usize, k + 3u32, k * 1000u32));
      k = k + 1u32;
    }
    buffers.push(zeros(100usize));
    parity(&mut device, &sevenK, &buffers, 2u32, 1u32, "seven: the twin's");
  }
  expectUInt(u64.from(refusals()), 0u64, "nothing refused so far");

  // ---- 2. Refused ----
  imm eight = Kernel.make(&device, &KERNELS_SPIRV, "seven",
    &[READ, READ, READ, READ, READ, READ, READ, READ_WRITE]);
  expectBool(eight.isValid(), false, "a Cone kernel of eight buffers refused: its error buffer would be the ninth");
  expectUInt(u64.from(refusals()), 1u64, "and counted");
  mut wrong = Kernel.make(&device, &KERNELS_SPIRV, "lengths", &[READ, READ_WRITE]);
  wrong.setTwin2(&wrongShape);
  expectBool(wrong.hasTwin, false, "a direct twin taking a struct where the kernel binds a slice refused");
  expectUInt(u64.from(refusals()), 2u64, "and counted");

  // ---- 3. Failures on the GPU ----
  mut works = Works.make();
  mut got = List[Completion].empty();
  mut oobK = Kernel.make(&device, &KERNELS_SPIRV, "oob", &[READ_WRITE]);
  require(oobK.isValid(), "the oob kernel");
  runOne(&mut device, &mut works, &oobK, 128usize, 2u32, &mut got);
  require(got.len() == 1usize, "the oob job's Completion");
  {
    imm c = got[0usize];
    expectBool(c.ok, false, "a job whose kernel failed is not ok");
    require(c.failures.len() == 1usize, "one failure, the dispatch's");
    imm f = c.failures[0usize];
    expectFailure(f, "oob", 0u32, 1u32, FAILED_INDEX, oobLine(), 37u32, 165u32,
      "index out of bounds, kernels.cone, its line, invocation 37, index 37 + 128");
    imm m = f.message();
    mut want = String.from("kernel 'oob' (dispatch 0) failed: index out of bounds at kernels.cone:");
    want <- u64.from(oobLine());
    want <- ", invocation (37, 0, 0), index 165; 1 invocation failed";
    expect(sameStr(m.view(), want.view()), "the report's line");
    imm out = c.words(1u32);
    mut others = true;
    mut i = 0u32;
    while i < 128u32 {
      imm want1 = if i == 37u32 { 0u32; } else { i + 1u32; };
      if *out[usize.from(i)] != want1 { others = false; }
      i = i + 1u32;
    }
    expect(others, "the failing invocation stopped; every other ran");
  }
  expectUInt(u64.from(kernelFailures()), 1u64, "counted");
  got.clear();

  // Several dispatches in one job: scale, then checked, then panics
  mut checkedK = Kernel.make(&device, &KERNELS_SPIRV, "checked", &[READ_WRITE]);
  mut panicsK = Kernel.make(&device, &KERNELS_SPIRV, "panics", &[READ_WRITE]);
  require(checkedK.isValid() and panicsK.isValid(), "the checked and panics kernels");
  {
    mut job = Job.make(&mut device);
    mut sw = List[u32].empty();
    sw.push(bits(2.0));
    sw.push(bits(1.0));
    imm sIn = job.give(upload(&mut device, sw.view()));
    mut aw = List[u32].empty();
    mut i = 0u32;
    while i < 64u32 {
      aw.push(bits(f32.from(i)));
      i = i + 1u32;
    }
    imm aIn = job.give(upload(&mut device, aw.view()));
    imm sOut = job.give(zeroed(&mut device, 64usize));
    imm cOut = job.give(zeroed(&mut device, 128usize));
    imm pOut = job.give(zeroed(&mut device, 64usize));
    job.dispatch(&mut device, &scaleK, &[sIn, aIn, sOut], 1u32);
    job.dispatch(&mut device, &checkedK, &[cOut], 2u32);
    job.dispatch(&mut device, &panicsK, &[pOut], 1u32);
    imm sBack = job.readback(&mut device, sOut);
    imm cBack = job.readback(&mut device, cOut);
    imm ticket = works.submit(&mut device, job, Target.Here[0u64]);
    works.waitFor(&mut device, ticket, &mut got);
    require(got.len() == 1usize, "the three-dispatch job's Completion");
    imm c = got[0usize];
    expectBool(c.ok, false, "not ok");
    require(c.failures.len() == 2usize, "two failures: the second and third dispatches'");
    imm f1 = c.failures[0usize];
    imm first = f1.invocation[0usize];
    expect(first == 5u32 or first == 77u32, "the assert: the first to fail, 5 or 77");
    expectFailure(f1, "checked", 1u32, 2u32, FAILED_PANIC, checkedLine(), first, 0u32,
      "an assert: dispatch 1, two invocations failed, a panic, its line");
    expectFailure(c.failures[1usize], "panics", 2u32, 1u32, FAILED_PANIC, panicsLine(), 3u32, 0u32,
      "a panic: dispatch 2, invocation 3, its line");
    imm sw2 = c.words(sBack);
    mut scaled = true;
    i = 0u32;
    while i < 64u32 {
      if *sw2[usize.from(i)] != bits(f32.from(i) * 2.0 + 1.0) { scaled = false; }
      i = i + 1u32;
    }
    expect(scaled, "the first dispatch, which did not fail, wrote every word");
    imm cw = c.words(cBack);
    expect(*cw[5usize] == 0u32 and *cw[77usize] == 0u32 and *cw[6usize] == 12u32 and *cw[127usize] == 254u32,
      "the asserting invocations stopped, the others ran");
  }
  expectUInt(u64.from(kernelFailures()), 3u64, "each failing dispatch counted");
  got.clear();

  // A range past the end
  mut windowK = Kernel.make(&device, &KERNELS_SPIRV, "window", &[READ_WRITE]);
  require(windowK.isValid(), "the window kernel");
  runOne(&mut device, &mut works, &windowK, 64usize, 1u32, &mut got);
  require(got.len() == 1usize and got[0usize].failures.len() == 1usize, "the window job's failure");
  expectFailure(got[0usize].failures[0usize], "window", 0u32, 1u32, FAILED_RANGE, windowLine(), 9u32, 68u32,
    "a slice range: invocation 9, the range's end 64 + 4");
  got.clear();

  // One kernel twice in a job: each dispatch its own zeroed error buffer
  {
    mut job = Job.make(&mut device);
    imm a = job.give(zeroed(&mut device, 64usize));
    imm b = job.give(zeroed(&mut device, 64usize));
    job.dispatch(&mut device, &oobK, &[a], 1u32);
    job.dispatch(&mut device, &oobK, &[b], 1u32);
    imm ticket = works.submit(&mut device, job, Target.Here[0u64]);
    works.waitFor(&mut device, ticket, &mut got);
    require(got.len() == 1usize and got[0usize].failures.len() == 2usize, "two failures, one a dispatch");
    expect(got[0usize].failures[0usize].count == 1u32 and got[0usize].failures[1usize].count == 1u32
      and got[0usize].failures[1usize].dispatch == 1u32, "each counted alone: its error buffer was zeroed");
  }
  got.clear();

  // A clean job after them
  {
    mut job = Job.make(&mut device);
    imm s = job.give(upload(&mut device, &[bits(1.0), bits(0.0)]));
    imm a = job.give(upload(&mut device, &[bits(4.0), bits(5.0)]));
    imm o = job.give(zeroed(&mut device, 2usize));
    job.dispatch(&mut device, &scaleK, &[s, a, o], 1u32);
    imm ticket = works.submit(&mut device, job, Target.Here[0u64]);
    works.waitFor(&mut device, ticket, &mut got);
    require(got.len() == 1usize, "the clean job's Completion");
    expect(got[0usize].ok and got[0usize].failures.len() == 0usize, "ok, no failures");
  }
  got.clear();
  expectUInt(u64.from(kernelFailures()), 6u64, "six failing dispatches in all");

  // ---- 4. Loop jobs ----
  mut lp = iocore.Loop.mustMake();
  mut io = List[iocore.Completion].empty();
  {
    mut job = Job.make(&mut device);
    imm o = job.give(zeroed(&mut device, 64usize));
    job.dispatch(&mut device, &oobK, &[o], 1u32);
    works.submit(&mut device, job, onLoop(&mut lp, iocore.Target.Here[71u64], 7u64));
    imm limit = Instant.now() + Duration.fromSeconds(5i64);
    while io.len() < 1usize and Instant.now() < limit { lp.poll(limit, &mut io); }
    require(io.len() == 1usize, "the failing Loop job's answer");
    expectBool(io[0usize].isDone(), false, "not Done");
    expectUInt(u64.from(io[0usize].code), u64.from(ERROR_KERNEL_FAILED), "Failed, ERROR_KERNEL_FAILED");
    io.clear();
    works.poll(&device, &mut got);
    require(got.len() == 1usize, "its Completion in the Works' poll");
    expect(!got[0usize].ok and got[0usize].failures.len() == 1usize
      and got[0usize].failures[0usize].invocation[0usize] == 37u32, "not ok, the failure in it");
  }
  got.clear();
  {
    mut job = Job.make(&mut device);
    imm s = job.give(upload(&mut device, &[bits(1.0), bits(0.0)]));
    imm a = job.give(upload(&mut device, &[bits(4.0), bits(5.0)]));
    imm o = job.give(zeroed(&mut device, 2usize));
    job.dispatch(&mut device, &scaleK, &[s, a, o], 1u32);
    works.submit(&mut device, job, onLoop(&mut lp, iocore.Target.Here[72u64], 8u64));
    imm limit = Instant.now() + Duration.fromSeconds(5i64);
    while io.len() < 1usize and Instant.now() < limit { lp.poll(limit, &mut io); }
    require(io.len() == 1usize, "the clean Loop job's answer");
    expectBool(io[0usize].isDone(), true, "Done");
    io.clear();
    works.poll(&device, &mut got);
    require(got.len() == 1usize and got[0usize].ok, "its Completion, ok");
  }
  got.clear();

  // ---- 5. Atomics and workgroup memory ----
  mut compactK = Kernel.make(&device, &KERNELS_SPIRV, "compact", &[READ, READ_WRITE, READ_WRITE]);
  require(compactK.isValid(), "the compact kernel");
  compactK.setTwin3(&compact);
  expectBool(compactK.hasTwin, true, "a direct twin taking '&[]mut Atomic[u32]'");
  mut compactW = Kernel.make(&device, &KERNELS_SPIRV, "compact", &[READ, READ_WRITE, READ_WRITE]);
  compactW.setTwin(&compactTwin);
  {
    imm input = ramp(1000usize, 2654435761u32, 12345u32);
    mut want = List[u32].empty();
    mut i = 0usize;
    while i < input.len() {
      if *input[i] % 3u32 == 0u32 { want.push(*input[i]); }
      i = i + 1usize;
    }
    sortWords(&mut want);
    // The GPU's
    mut job = Job.make(&mut device);
    imm inS = job.give(upload(&mut device, input.view()));
    imm countS = job.give(zeroed(&mut device, 1usize));
    imm outS = job.give(zeroed(&mut device, 1000usize));
    job.dispatch(&mut device, &compactK, &[inS, countS, outS], 16u32);
    imm countB = job.readback(&mut device, countS);
    imm outB = job.readback(&mut device, outS);
    imm ticket = works.submit(&mut device, job, Target.Here[0u64]);
    works.waitFor(&mut device, ticket, &mut got);
    require(got.len() == 1usize and got[0usize].ok, "the compaction job, ok");
    imm gpuCount = *got[0usize].words(countB)[0usize];
    mut gpuKept = List[u32].empty();
    imm ow = got[0usize].words(outB);
    i = 0usize;
    while i < usize.from(gpuCount) and i < ow.len() {
      gpuKept.push(*ow[i]);
      i = i + 1usize;
    }
    sortWords(&mut gpuKept);
    expectUInt(u64.from(gpuCount), u64.from(want.len()), "compact on the GPU: a slot for each multiple of 3");
    expect(sameWords(gpuKept.view(), want.view()), "compact on the GPU: the values kept, sorted");
    // Each twin's: the direct one, and the Words adapter's atomic view
    compactOnTwin(&compactK, &input, gpuCount, gpuKept.view(), "compact, direct twin");
    compactOnTwin(&compactW, &input, gpuCount, gpuKept.view(), "compact, Words twin");
  }
  got.clear();

  mut extremesK = Kernel.make(&device, &KERNELS_SPIRV, "extremes", &[READ, READ_WRITE]);
  require(extremesK.isValid(), "the extremes kernel");
  extremesK.setTwin2(&extremes);
  expectBool(extremesK.hasTwin, true, "a direct twin taking '&[]mut Atomic[i32]'");
  {
    mut buffers = List[List[u32]].empty();
    buffers.push(ramp(1000usize, 37u32, 0xFFFFB1E0u32));   // 37 i - 20000, as i32 bits
    mut acc = List[u32].empty();
    acc.push(0x7FFFFFFFu32);
    acc.push(0x80000000u32);
    acc.push(0u32);
    buffers.push(acc);
    parity(&mut device, &extremesK, &buffers, 16u32, 1u32, "extremes: i32 min, max and add, the twin's");
    runTwin(&extremesK, &mut buffers, 16u32);
    expect(*buffers[1usize][0usize] == 0xFFFFB1E0u32 and *buffers[1usize][1usize] == 16963u32
      and *buffers[1usize][2usize] == 0xFFE8D45Cu32, "extremes: -20000, 16963 and -1518500");
  }

  mut groupSumsK = Kernel.make(&device, &KERNELS_SPIRV, "groupSums", &[READ, READ_WRITE]);
  require(groupSumsK.isValid(), "the groupSums kernel");
  groupSumsK.setTwin2(&groupSums);
  {
    mut buffers = List[List[u32]].empty();
    buffers.push(ramp(310usize, 2654435761u32, 99u32));
    buffers.push(zeros(5usize));
    parity(&mut device, &groupSumsK, &buffers, 5u32, 1u32,
      "groupSums: workgroup memory and a barrier, five workgroups, the twin's");
    mut want = 0u32;
    mut i = 256usize;
    while i < 310usize {
      want = want + *buffers[0usize][i];
      i = i + 1usize;
    }
    runTwin(&groupSumsK, &mut buffers, 5u32);
    expect(*buffers[1usize][4usize] == want, "groupSums: the last workgroup's, its 54 inputs and 10 zeros");
  }

  expectUInt(u64.from(kernelFailures()), 7u64, "seven failing dispatches in all");
  expectUInt(u64.from(refusals()), 2u64, "the two refusals only");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}
