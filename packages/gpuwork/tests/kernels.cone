// Kernels written in Cone, run on the GPU through gpuwork, and the same
// functions compiled for the CPU as their twins.
//
// The kernels are the lines between '// cone-kernels-begin' and
// '// cone-kernels-end' below. This program compiles them for the CPU as
// part of itself; tests/kernels.py compiles the same lines for Vulkan with
// conec, each on the line it has here, and embeds the SPIR-V below them
// (KERNELS_SPIRV). So a failure on the GPU names this file, kernels.cone,
// and its line here.
//
// 1. Parity, bit for bit, through checkParity: 'scale' (a by-value struct
//    and two f32 slices) and 'lengths' (a slice of 12-byte structs) with
//    direct twins, the kernel's own function ('setTwin3', 'setTwin2');
//    'hash2' (an 8 x 8 workgroup over a 2-D grid, integers) through the
//    Words adapter ('setTwin'); 'seven', seven buffers, the most a Cone
//    kernel binds ('setTwin7'). A direct twin's slice is as long as the
//    buffer's elements, as on the GPU: 'lengths' writes only as many
//    outputs as it has points.
// 2. Refused: a Cone kernel of eight buffers (its error buffer would be the
//    ninth), and a direct twin whose parameter is a struct where the kernel
//    binds a slice.
// 3. Failures on the GPU, each read from the dispatch's error buffer when
//    the job is done, the Completion not ok, its 'failures' saying what,
//    where and in which invocation, and the other invocations having run:
//    an index out of bounds in one invocation ('oob'); an assert failing in
//    two ('checked', counted 2); a panic ('panics'); a slice range past the
//    end ('window'). A job of several dispatches reports each that failed,
//    by its place in the job; one kernel dispatched twice in a job, each
//    with its own zeroed error buffer; a job after a failure is clean.
// 4. A Loop job whose kernel fails: its iocore answer Failed,
//    ERROR_KERNEL_FAILED, and its Completion the failure; a clean one Done.
//
// Only a failure prints (each GPU failure is also reported on stderr, as
// gpuwork reports it). With GPUWORK_REPORT set, it prints the adapter.
// GPU_POWER_PREFERENCE=low-power tests the integrated GPU where there are
// two. It needs a GPU driver with Vulkan 1.3 and SDL3.dll; with the Vulkan
// SDK, validation and synchronization validation are on, and must say
// nothing.

mod kernels;

import testing use *;
import stdio use *;
import libc;
import collections use List, String;
import time use Instant, Duration;
import gpu use *;
import gpuwork use *;
import iocore;
import iobuf use IoBuf;

// cone-kernels-begin
struct Scale {
  pub factor f32;
  pub offset f32;
}

struct P3 {
  pub x f32;
  pub y f32;
  pub z f32;
}

// out[i] = a[i] * factor + offset
fn @compute(64) scale(inv Invocation, s Scale, a &[]f32, out &[]mut f32) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len {
    out[i] = a[i] * s.factor + s.offset;
  }
}

// Each point's squared length, for as many points as there are
fn @compute(64) lengths(inv Invocation, points &[]P3, out &[]mut f32) {
  imm i = usize.from(inv.globalId[0]);
  if i < points.len and i < out.len {
    imm p = points[i];
    out[i] = p.x * p.x + p.y * p.y + p.z * p.z;
  }
}

// A hash of each cell of a 2-D grid, from its seed and its place
fn @compute(8, 8) hash2(inv Invocation, seeds &[]u32, out &[]mut u32) {
  imm i = usize.from(inv.globalId[0] + inv.groupCount[0] * 8u32 * inv.globalId[1]);
  if i < out.len {
    mut h = seeds[i % seeds.len] ^ (inv.globalId[0] * 73856093u32) ^ (inv.globalId[1] * 19349663u32);
    h = h * 747796405u32 + 2891336453u32;
    h = ((h >> ((h >> 28u32) + 4u32)) ^ h) * 277803737u32;
    out[i] = (h >> 22u32) ^ h;
  }
}

// Seven buffers, the most a Cone kernel binds
fn @compute(64) seven(inv Invocation, a &[]u32, b &[]u32, c &[]u32, d &[]u32, e &[]u32, f &[]u32,
    out &[]mut u32) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len {
    out[i] = a[i] + 2u32 * b[i] + 3u32 * c[i] + 5u32 * d[i] + 7u32 * e[i] + 11u32 * f[i];
  }
}

// Invocation 37 indexes past the end; every other writes its id plus one
fn @compute(64) oob(inv Invocation, out &[]mut u32) {
  imm i = usize.from(inv.globalId[0]);
  if inv.globalId[0] == 37u32 { out[i + out.len] = 1u32; }
  if i < out.len { out[i] = inv.globalId[0] + 1u32; }
}
fn oobLine() u32 { srcLine() - 3u32; }

// Invocations 5 and 77 fail an assert; every other writes twice its id
fn @compute(64) checked(inv Invocation, out &[]mut u32) {
  imm g = inv.globalId[0];
  assert(g != 5u32 and g != 77u32, "not five or seventy-seven");
  imm i = usize.from(g);
  if i < out.len { out[i] = g * 2u32; }
}
fn checkedLine() u32 { srcLine() - 4u32; }

// Invocation 3 panics
fn @compute(64) panics(inv Invocation, out &[]mut u32) {
  if inv.globalId[0] == 3u32 { panic("three"); }
  imm i = usize.from(inv.globalId[0]);
  if i < out.len { out[i] = 9u32; }
}
fn panicsLine() u32 { srcLine() - 4u32; }

// Invocation 9 takes a range of its output running 4 past the end
fn @compute(64) window(inv Invocation, out &[]mut u32) {
  imm i = usize.from(inv.globalId[0]);
  if i < out.len {
    imm end = if inv.globalId[0] == 9u32 { out.len + 4usize; } else { i + 1usize; };
    imm s = &mut out[i..end];
    s[0usize] = 7u32;
  }
}
fn windowLine() u32 { srcLine() - 4u32; }
// cone-kernels-end

