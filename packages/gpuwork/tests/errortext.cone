// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import gpuwork use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  let oob = KernelFailure(String.from("oob"), 3u32, 4294967295u32, FAILED_INDEX, 7u32, String.from("kernels.cone"), 57u32, [37u32, 4294967295u32, 0u32], 1037u32);
  says(String() <- oob, "kernel 'oob' (dispatch 3) failed: index out of bounds at kernels.cone:57, invocation (37, 4294967295, 0), index 1037; 4294967295 invocations failed", "index");
  let rng = KernelFailure(String.from("r"), 0u32, 1u32, FAILED_RANGE, 9u32, String(), 5u32, [1u32, 2u32, 3u32], 12u32);
  says(String() <- rng, "kernel 'r' (dispatch 0) failed: slice range out of bounds at file 9:5, invocation (1, 2, 3), range end 12; 1 invocation failed", "range, no file name");
  let odd = KernelFailure(String.from("p"), 1u32, 2u32, 99u32, 0u32, String.from("a.cone"), 1u32, [0u32, 0u32, 0u32], 0u32);
  says(String() <- odd, "kernel 'p' (dispatch 1) failed: unknown failure 99 at a.cone:1, invocation (0, 0, 0); 2 invocations failed", "unknown kind");
  let pan = KernelFailure(String.from("p"), 0u32, 1u32, FAILED_PANIC, 0u32, String.from("a.cone"), 2u32, [0u32, 0u32, 0u32], 0u32);
  says(String() <- pan, "kernel 'p' (dispatch 0) failed: panic at a.cone:2, invocation (0, 0, 0); 1 invocation failed", "panic");
  done()
}
