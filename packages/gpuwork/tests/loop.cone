// gpuwork's jobs delivered into an iocore Loop (Target.Loop): the job's
// operation in the loop is ended by the Works' watcher thread when the GPU
// has finished the job, so a loop asleep in poll wakes with the answer, and
// the job's Completion, its buffers back, is then in the Works' poll.
//
// 1. A job (scramble.slang's scrambleMain, out[i] = pcg(words[i] ^ i), over
//    64 words) with Target.Loop, its frame never ended: the loop, asleep in
//    poll, wakes with one answer, Done with the job's ticket and the
//    operation's own token; the Works' poll then has its Completion at once,
//    ok, its three buffers back, its words the CPU's.
// 2. Chained: the output taken from that Completion, still on the GPU,
//    given to a second Loop job made with 'onLoop', scrambled again: the
//    words pcg(pcg(w ^ i) ^ i).
// 3. Three Loop jobs in one frame, none ended: all three answered, in the
//    order submitted (a Loop job does not wait for its frame).
// 4. A cancel asked while the job is on the GPU: the job cannot stop, so
//    the answer comes when it is done, Cancelled, and its Completion is ok
//    with its buffers back. A job whose group was cancelled before it was
//    submitted: answered Cancelled at once, not run; its Completion not ok,
//    its buffers back.
// 5. A refused job: Failed, gpuwork.ERROR_JOB_REFUSED; not ok, its buffer
//    back.
// 6. A Here job beside a Loop job in one Works: each delivered its way. A
//    Loop job waited for with 'waitFor', as a tool would: its Completion,
//    and its answer in the loop as well.
// 7. A Works that dies with a Loop job in flight: its end waits for the
//    watcher, the operation is still answered exactly once (Done). Twenty
//    such Works: none has a watcher before its first Loop job; each one's
//    watcher is a thread of the process while it lives and gone once it
//    has ended; and the process's handle count is where it was: no watcher
//    is left behind.
//
// Between sections the frame is ended, as a frame loop's frames end: a
// frame holds 16 command buffers, and each job takes two (its own, and the
// uploads before it).
//
// Only a failure prints. GPU_POWER_PREFERENCE=low-power tests the
// integrated GPU where there are two. It needs a GPU driver with Vulkan 1.3
// and SDL3.dll; with the Vulkan SDK, validation and synchronization
// validation are on, and must say nothing.

mod loop;

import testing use *;
import stdio use *;
import libc;
import collections use List;
import time use Instant, Duration;
import gpu use *;
import gpuwork use *;
import iocore;
import iobuf use IoBuf;
import diag;
import noise use pcg;

extern {
  fn @c(system) GetCurrentProcess() usize;
  fn @c(system) GetProcessHandleCount(process usize, count *u32) i32;
  fn @c(system) GetCurrentProcessId() u32;
  fn @c(system) CreateToolhelp32Snapshot(flags u32, process u32) usize;
  fn @c(system) Thread32First(snap usize, entry *ThreadEntry) i32;
  fn @c(system) Thread32Next(snap usize, entry *ThreadEntry) i32;
  fn @c(system) CloseHandle(h usize) i32;
}

// Toolhelp's THREADENTRY32
struct ThreadEntry {
  size u32;
  usage u32;
  thread u32;
  owner u32;
  basePriority i32;
  deltaPriority i32;
  flags u32;
}

fn handleCount() u32 {
  mut n = 0u32;
  GetProcessHandleCount(GetCurrentProcess(), &mut n as *u32);
  n;
}

// Whether this process has a thread whose id is 'id'
fn hasThread(id u32) Bool {
  imm snap = CreateToolhelp32Snapshot(4u32, 0u32);    // TH32CS_SNAPTHREAD
  imm me = GetCurrentProcessId();
  mut e = new ThreadEntry(28u32, 0u32, 0u32, 0u32, 0i32, 0i32, 0u32);
  mut found = false;
  mut more = Thread32First(snap, &mut e as *ThreadEntry) != 0i32;
  while more {
    if e.owner == me and e.thread == id { found = true; }
    e.size = 28u32;
    more = Thread32Next(snap, &mut e as *ThreadEntry) != 0i32;
  }
  CloseHandle(snap);
  found;
}

fn preference() u32 {
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize and libc.strcmp(env, &"low-power" as *u8) == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

// Poll the loop until it holds 'n' answers, for at most 5 seconds
fn waitIo(lp &mut iocore.Loop, out &mut List[iocore.Completion], n usize) {
  imm limit = Instant.now() + Duration.fromSeconds(5i64);
  while out.len() < n and Instant.now() < limit {
    lp.poll(limit, out);
  }
}

// How many of 'got' differ from 'want' (a missing word differs)
fn differences(got &List[u32], want &List[u32]) u64 {
  mut n = 0u64;
  mut i = 0usize;
  while i < want.len() {
    if i >= got.len() or *got[i] != *want[i] { n = n + 1u64; }
    i = i + 1usize;
  }
  n;
}

// A scramble job over 'words': its input, its output, and the output read
// back (slots 0, 1, 2)
fn scrambleJob(device &mut Device, kernel &Kernel, words &[]u32) Job {
  mut job = Job.make(device);
  imm input = job.give(upload(device, words));
  imm output = job.give(zeroed(device, words.len));
  job.dispatch(device, kernel, &[input, output], 1u32);
  job.readback(device, output);
  job;
}

// Submit a scramble job over 'words' to 'to'
fn submitScramble(works &mut Works, device &mut Device, kernel &Kernel, words &[]u32, to Target) Ticket {
  imm job = scrambleJob(device, kernel, words);
  works.submit(device, job, to);
}

fn main() i32 {
  mut instance = Instance.create("gpuwork loop");
  require(instance.isValid(), "a Vulkan 1.3 instance");  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  mut kernel = Kernel.make(&device, &SCRAMBLE_SPIRV, "scrambleMain", &[READ, READ_WRITE]);
  require(kernel.isValid(), "the scramble kernel");

  mut words = List[u32].empty();
  mut once = List[u32].empty();
  mut twice = List[u32].empty();
  mut i = 0u32;
  while i < 64u32 {
    imm w = i * 2654435761u32;
    words.push(w);
    once.push(pcg(w ^ i));
    twice.push(pcg(pcg(w ^ i) ^ i));
    i = i + 1u32;
  }

  mut lp = iocore.Loop.mustMake();
  mut io = List[iocore.Completion].empty();
  mut got = List[Completion].empty();
  {
  mut works = Works.make();

  // ---- 1. A loop asleep in poll, woken by the GPU ----
  imm frame1 = device.frameNumber;
  imm op1 = lp.external(iocore.Target.Here[501u64], IoBuf.empty());
  imm first = submitScramble(&mut works, &mut device, &kernel, words.view(), Target.Loop[11u64, op1]);
  imm asleep = Instant.now();
  lp.poll(asleep + Duration.fromSeconds(5i64), &mut io);
  waitIo(&mut lp, &mut io, 1usize);
  expect(Instant.now() - asleep < Duration.fromSeconds(2i64), "woken by the GPU, not by the poll's time");
  expectUInt(u64.from(device.frameNumber), frame1, "its frame never ended");
  require(io.len() == 1usize, "one answer in the loop");
  expectUInt(io[0usize].token, 501u64, "the operation's own token");
  expectBool(io[0usize].isDone(), true, "Done");
  expectUInt(u64.from(io[0usize].n), first.id, "carrying the job's ticket");
  io.clear();
  expectUInt(u64.from(works.poll(&device, &mut got)), 1u64, "the Completion in the Works' poll at once");
  {
    imm c = &mut got[0usize];
    expect(c.ticket == first and c.token == 11u64 and c.ok, "its ticket and token, and it ran");
    expectUInt(u64.from(c.count()), 3u64, "its three buffers back");
    expectUInt(differences(&c.words(2u32), &once), 0u64, "every word the CPU's");
  }

  // ---- 2. Chained: the output, never read back, into a second job ----
  mut onGpu = got[0usize].take(1u32);
  got.clear();
  mut second = Job.make(&mut device);
  imm input = second.give(onGpu);
  imm output = second.give(zeroed(&mut device, 64usize));
  second.dispatch(&device, &kernel, &[input, output], 1u32);
  imm back2 = second.readback(&mut device, output);
  imm ticket2 = works.submit(&mut device, second, onLoop(&mut lp, iocore.Target.Here[502u64], 22u64));
  waitIo(&mut lp, &mut io, 1usize);
  require(io.len() == 1usize, "the second job's answer");
  expect(io[0usize].token == 502u64 and io[0usize].isDone() and u64.from(io[0usize].n) == ticket2.id,
    "Done, its token and ticket");
  io.clear();
  expectUInt(u64.from(works.poll(&device, &mut got)), 1u64, "its Completion");
  expectUInt(differences(&got[0usize].words(back2), &twice), 0u64, "scrambled twice, from a buffer that stayed on the GPU");
  got.clear();
  device.endFrame();         // as a frame loop's frames end (a frame holds 16 command buffers)

  // ---- 3. Three jobs in one frame, none ended ----
  imm frame3 = device.frameNumber;
  imm t31 = submitScramble(&mut works, &mut device, &kernel, words.view(), onLoop(&mut lp, iocore.Target.Here[531u64], 31u64));
  imm t32 = submitScramble(&mut works, &mut device, &kernel, words.view(), onLoop(&mut lp, iocore.Target.Here[532u64], 32u64));
  imm t33 = submitScramble(&mut works, &mut device, &kernel, words.view(), onLoop(&mut lp, iocore.Target.Here[533u64], 33u64));
  waitIo(&mut lp, &mut io, 3usize);
  expectUInt(u64.from(device.frameNumber), frame3, "one frame, not ended");
  require(io.len() == 3usize, "three answers");
  expect(u64.from(io[0usize].n) == t31.id and u64.from(io[1usize].n) == t32.id and u64.from(io[2usize].n) == t33.id,
    "in the order submitted");
  io.clear();
  expectUInt(u64.from(works.poll(&device, &mut got)), 3u64, "three Completions");
  expect(got[0usize].token == 31u64 and got[1usize].token == 32u64 and got[2usize].token == 33u64, "in order");
  expectUInt(differences(&got[2usize].words(2u32), &once), 0u64, "the third's words");
  got.clear();
  device.endFrame();

  // ---- 4. Cancels ----
  imm op4 = lp.external(iocore.Target.Here[541u64], IoBuf.empty());
  imm id4 = op4.id();
  submitScramble(&mut works, &mut device, &kernel, words.view(), Target.Loop[41u64, op4]);
  expectBool(lp.cancel(id4), true, "the cancel asked while the job is on the GPU");
  waitIo(&mut lp, &mut io, 1usize);
  require(io.len() == 1usize, "its answer");
  expectUInt(u64.from(io[0usize].status), u64.from(diag.outcomeCancelled), "Cancelled");
  io.clear();
  expectUInt(u64.from(works.waitAll(&mut device, &mut got)), 1u64, "its Completion");
  expectBool(got[0usize].ok, true, "it ran: a job on the GPU cannot be stopped");
  expectUInt(u64.from(got[0usize].count()), 3u64, "its buffers back");
  expectUInt(differences(&got[0usize].words(2u32), &once), 0u64, "and its words");
  got.clear();

  imm group = iocore.CancelGroup.make();
  group.cancel();
  submitScramble(&mut works, &mut device, &kernel, words.view(),
    onLoopIn(&mut lp, iocore.Target.Here[542u64], group, iocore.forever(), 42u64));
  waitIo(&mut lp, &mut io, 1usize);
  require(io.len() == 1usize, "the cancelled group's answer");
  expectUInt(u64.from(io[0usize].status), u64.from(diag.outcomeCancelled), "Cancelled at submit");
  io.clear();
  expectUInt(u64.from(works.waitAll(&mut device, &mut got)), 1u64, "its Completion");
  expect(got[0usize].token == 42u64 and !got[0usize].ok, "not run");
  expectUInt(u64.from(got[0usize].count()), 3u64, "its buffers back");
  got.clear();
  device.endFrame();

  // ---- 5. A refused job ----
  mut refused = Job.make(&mut device);
  imm only = refused.give(zeroed(&mut device, 4usize));
  expectBool(refused.dispatch(&device, &kernel, &[only], 1u32), false, "one slot for two bindings refused");
  works.submit(&mut device, refused, onLoop(&mut lp, iocore.Target.Here[551u64], 51u64));
  waitIo(&mut lp, &mut io, 1usize);
  require(io.len() == 1usize, "the refused job's answer");
  expectUInt(u64.from(io[0usize].status), u64.from(diag.outcomeFailed), "Failed");
  expectUInt(u64.from(io[0usize].code), u64.from(ERROR_JOB_REFUSED), "ERROR_JOB_REFUSED");
  io.clear();
  expectUInt(u64.from(works.waitAll(&mut device, &mut got)), 1u64, "its Completion");
  expect(!got[0usize].ok and got[0usize].count() == 1u32 and got[0usize].buffers[0usize].isValid(), "not ok, its buffer back");
  got.clear();
  device.endFrame();

  // ---- 6. A Here job beside a Loop job ----
  imm here = submitScramble(&mut works, &mut device, &kernel, words.view(), Target.Here[61u64]);
  submitScramble(&mut works, &mut device, &kernel, words.view(), onLoop(&mut lp, iocore.Target.Here[562u64], 62u64));
  waitIo(&mut lp, &mut io, 1usize);
  expect(io.len() == 1usize and io[0usize].token == 562u64, "the Loop job's answer, its frame not ended");
  io.clear();
  expectUInt(u64.from(works.poll(&device, &mut got)), 1u64, "only the Loop job complete: the Here job waits for its frame");
  expectUInt(got[0usize].token, 62u64, "the Loop job's");
  got.clear();
  expectUInt(u64.from(works.waitFor(&mut device, here, &mut got)), 1u64, "the Here job, waited for");
  expectUInt(got[0usize].token, 61u64, "the Here job's");
  got.clear();
  imm blocking = submitScramble(&mut works, &mut device, &kernel, words.view(), onLoop(&mut lp, iocore.Target.Here[563u64], 63u64));
  expectUInt(u64.from(works.waitFor(&mut device, blocking, &mut got)), 1u64, "a Loop job waited for, as a tool would");
  expect(got[0usize].token == 63u64 and got[0usize].ok, "its Completion");
  expectUInt(differences(&got[0usize].words(2u32), &once), 0u64, "and its words");
  got.clear();
  waitIo(&mut lp, &mut io, 1usize);
  expect(io.len() == 1usize and io[0usize].token == 563u64 and io[0usize].isDone(), "its answer in the loop too");
  io.clear();
  }

  // ---- 7. A Works that dies with a Loop job in flight ----
  device.endFrame();
  {
    mut doomed = Works.make();
    submitScramble(&mut doomed, &mut device, &kernel, words.view(), onLoop(&mut lp, iocore.Target.Here[571u64], 71u64));
  }
  waitIo(&mut lp, &mut io, 1usize);
  expect(io.len() == 1usize and io[0usize].token == 571u64 and io[0usize].isDone(), "still answered, Done");
  io.clear();
  imm handles = handleCount();
  mut alive = 0u32;
  mut gone = 0u32;
  mut k = 0u32;
  while k < 20u32 {
    mut id = 0u32;
    {
      mut w = Works.make();
      expectUInt(u64.from(w.watcherThread()), 0u64, "no watcher before a Loop job");
      submitScramble(&mut w, &mut device, &kernel, words.view(), onLoop(&mut lp, iocore.Target.Here[572u64], 72u64));
      id = w.watcherThread();
      if id != 0u32 and hasThread(id) { alive = alive + 1u32; }
    }
    if !hasThread(id) { gone = gone + 1u32; }
    device.endFrame();
    k = k + 1u32;
  }
  waitIo(&mut lp, &mut io, 20usize);
  expectUInt(u64.from(io.len()), 20u64, "twenty answers");
  io.clear();
  expectUInt(u64.from(alive), 20u64, "each Works's watcher a thread of the process while it lives");
  expectUInt(u64.from(gone), 20u64, "and gone once its Works has ended: no watcher left behind");
  expectUInt(u64.from(handleCount()), u64.from(handles), "no handle left behind: every watcher joined");

  device.endFrame();
  device.waitIdle();

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}

