// ======== The small constants of RFC 7932 ========
//
// The tables the decoder reads by index. The larger ones (the static dictionary, the transforms, the three
// context lookup tables) are generated from the RFC's text by brotlitables.py and live in dictionary.cone and
// contextluts.cone.

// Block counts (section 6): for each of the 26 codes, the extra bits and the smallest count
let blockLenBits: Array[u8, 26] = [2u8, 2u8, 2u8, 2u8, 3u8, 3u8, 3u8, 3u8, 4u8, 4u8, 4u8, 4u8, 5u8, 5u8, 5u8, 5u8,
  6u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 24u8];
let blockLenBase: Array[u32, 26] = [1u32, 5u32, 9u32, 13u32, 17u32, 25u32, 33u32, 41u32, 49u32, 65u32, 81u32, 97u32,
  113u32, 145u32, 177u32, 209u32, 241u32, 305u32, 369u32, 497u32, 753u32, 1265u32, 2289u32, 4337u32, 8433u32,
  16625u32];

// Insert lengths (section 5): for each of the 24 insert length codes, the extra bits and the smallest length
let insertBits: Array[u8, 24] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 2u8, 2u8, 3u8, 3u8, 4u8, 4u8, 5u8, 5u8, 6u8,
  7u8, 8u8, 9u8, 10u8, 12u8, 14u8, 24u8];
let insertBase: Array[u32, 24] = [0u32, 1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 8u32, 10u32, 14u32, 18u32, 26u32, 34u32,
  50u32, 66u32, 98u32, 130u32, 194u32, 322u32, 578u32, 1090u32, 2114u32, 6210u32, 22594u32];

// Copy lengths (section 5): the same for the 24 copy length codes
let copyBits: Array[u8, 24] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 2u8, 2u8, 3u8, 3u8, 4u8, 4u8, 5u8,
  5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 24u8];
let copyBase: Array[u32, 24] = [2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32, 9u32, 10u32, 12u32, 14u32, 18u32, 22u32,
  30u32, 38u32, 54u32, 70u32, 102u32, 134u32, 198u32, 326u32, 582u32, 1094u32, 2118u32];

// An insert-and-copy symbol's cell (its value >> 6, section 5): where the insert length code and the copy length
// code start (the 3 bits each of the symbol add to them)
let cellInsert: Array[u8, 11] = [0u8, 0u8, 0u8, 0u8, 8u8, 8u8, 0u8, 16u8, 8u8, 16u8, 16u8];
let cellCopy: Array[u8, 11] = [0u8, 8u8, 0u8, 8u8, 0u8, 8u8, 16u8, 0u8, 16u8, 8u8, 16u8];

// The order the code-length code's lengths are sent in (section 3.5)
let clOrder: Array[u8, 18] = [1u8, 2u8, 3u8, 4u8, 0u8, 5u8, 17u8, 6u8, 16u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8];

// The variable-length code those lengths are sent in (section 3.5), indexed by the next 4 bits: how many bits
// the code takes and the length it stands for
let clCodeBits: Array[u8, 16] = [2u8, 2u8, 2u8, 3u8, 2u8, 2u8, 2u8, 4u8, 2u8, 2u8, 2u8, 3u8, 2u8, 2u8, 2u8, 4u8];
let clCodeValue: Array[u8, 16] = [0u8, 4u8, 3u8, 2u8, 0u8, 4u8, 3u8, 1u8, 0u8, 4u8, 3u8, 2u8, 0u8, 4u8, 3u8, 5u8];

// Distance changes of the short codes 4 to 15 (section 4): code 4 + k and 10 + k, k 0 to 5
let shortDelta: Array[i32, 6] = [-1i32, 1i32, -2i32, 2i32, -3i32, 3i32];
