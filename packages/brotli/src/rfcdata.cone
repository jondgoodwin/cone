// ======== The RFC's tables, as bytes ========

// The generated data of the RFC, as bytes, so that a test can check it against the CRC-32 values the RFC
// states. 0: the static dictionary (Appendix A), 122,784 bytes. 1: the transforms, as the 648 bytes of
// Appendix B's serialization (each prefix and a zero, the kind as a byte, each suffix and a zero). 2, 3, 4:
// Lut0, Lut1 and Lut2 of section 7.1, 256 bytes each. Anything else: empty.
pub fn rfcData(which: u32) List[u8] {
  var r = List[u8]();
  if which == 0u32 {
    var n = 4usize;
    while n <= 24usize {
      r.appendSlice(dictChunk(n).bytes());
      n = n + 1usize;
    }
  } else if which == 1u32 {
    let text = transformText.bytes();
    var t = 0usize;
    while t < 121usize {
      var j = 0usize;
      while j < usize.from(transformPrefixLen[t]) { r.push(text[usize.from(transformPrefixOff[t]) + j]); j = j + 1usize; }
      r.push(0u8);
      r.push(transformKind[t]);
      j = 0usize;
      while j < usize.from(transformSuffixLen[t]) { r.push(text[usize.from(transformSuffixOff[t]) + j]); j = j + 1usize; }
      r.push(0u8);
      t = t + 1usize;
    }
  } else if which >= 2u32 && which <= 4u32 {
    var i = 0usize;
    while i < 256usize {
      r.push(if which == 2u32 {lut0[i]} else if which == 3u32 {lut1[i]} else {lut2[i]});
      i = i + 1usize;
    }
  }
  r
}
