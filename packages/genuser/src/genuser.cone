// The genuser package: generators that hand on to another package's, so that a
// program importing this one walks generators from two packages through the
// include files of both.

mod genuser;

import genwalk;

// A free generator handing on to genwalk's, twice
pub fn countTwice(n i64) yields i64 {
  yield each genwalk.count(n);
  yield each genwalk.count(n);
}

// A method that walks genwalk's generator with a loop and scales what it yields
pub struct Scaler {
  pub k i64;

  pub fn run(self &, n i64) yields i64 {
    each v in genwalk.count(n) {
      yield v * k;
    }
  }
}
