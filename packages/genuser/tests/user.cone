// genuser's generators, which hand on to genwalk's, walked from a program that
// imports genuser. Every value is worked out by hand:
// - countTwice(3): genwalk.count(3) is 0 1 2, twice: 0 1 2 0 1 2;
// - Scaler(10).run(3): 0 1 2 each times 10: 0 10 20.

mod user;

import stdio use *;
import testing use *;
import genuser use *;

fn main() i32 {
  each v in countTwice(3i64) { printInt(v); printStr(" "); }
  printStr("\n");
  imm s = new Scaler(10i64);
  each v in s.run(3i64) { printInt(v); printStr(" "); }
  printStr("\n");
  done();
}
