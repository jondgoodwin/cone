// The sdl package: raw bindings to SDL2, the part of it a window with an
// OpenGL context needs: starting SDL's video, opening and sizing a window,
// making its OpenGL context, finding OpenGL's functions, swapping the frame,
// the clock, and the event queue.
//
// '@c("SDL_")' makes it a C-named module: each function below takes its C name,
// the prefix and then the name as written, so 'Init' binds to SDL_Init. The
// types and constants have no symbol, and are named here without the prefix.
// Everything is as C has it: C types, C strings ('*u8', ending in a zero), and
// the SDL_ names shortened only by the prefix.
//
// Built for SDL 2.x (the development kit 2.32 was used). Linking needs
// SDL2.lib on LIB, and running needs SDL2.dll on PATH.

mod @c("SDL_") sdl;

pub extern {
  // Starting and stopping
  fn Init(flags u32) i32;
  fn Quit();
  fn GetError() *u8;
  fn ClearError();

  // Windows
  fn CreateWindow(title *u8, x u32, y u32, w i32, h i32, flags u32) *Window;
  fn DestroyWindow(window *Window);
  fn GetWindowSize(window *Window, w &mut i32, h &mut i32);
  fn SetWindowFullscreen(window *Window, flags u32) i32;
  fn SetWindowTitle(window *Window, title *u8);
  fn GetDisplayBounds(displayIndex i32, rect &mut Rect) i32;

  // OpenGL contexts. Set the attributes before the window is created: they
  // choose the pixel format and the context the window gets.
  fn GL_SetAttribute(attr i32, value i32) i32;
  fn GL_CreateContext(window *Window) *GLContext;
  fn GL_DeleteContext(glcontext *GLContext);
  fn GL_MakeCurrent(window *Window, glcontext *GLContext) i32;
  fn GL_SetSwapInterval(interval i32) i32;
  fn GL_SwapWindow(window *Window);
  fn GL_GetProcAddress(name *u8) *u8;

  // The clock
  fn GetTicks() u32;
  fn Delay(ms u32);

  // Events: 1 while one was waiting (and is now in 'event'), else 0
  fn PollEvent(event &mut Event) i32;
}

pub struct @opaque Window {}      // Opaque
pub struct @opaque GLContext {}   // Opaque

// SDL_Rect
pub struct Rect {
  pub x i32;
  pub y i32;
  pub w i32;
  pub h i32;
}

// SDL_Event, a union of every kind of event, 56 bytes in SDL 2. Read 'type',
// then look at the event as the struct that kind has: '&event as &KeyboardEvent'.
// The buffer is larger than SDL's union needs, which is harmless.
pub struct Event {
  pub type u32;
  pub timestamp u32;   // In milliseconds
  pub buffer [248; u8];

  // An event to fill: 'mut event = Event.empty(); while sdl.PollEvent(&mut event) ...'
  pub fn empty() Event { Event[0u32, 0u32, [248; 0u8]]; }
}

// SDL_WindowEvent: type is WINDOWEVENT
pub struct WindowEvent {
  pub type u32;
  pub timestamp u32;
  pub windowID u32;
  pub event u8;        // WINDOWEVENT_RESIZED, ...
  pub padding1 u8;
  pub padding2 u8;
  pub padding3 u8;
  pub data1 i32;       // For RESIZED, the new width
  pub data2 i32;       // and height
}

// SDL_KeyboardEvent: type is KEYDOWN or KEYUP
pub struct KeyboardEvent {
  pub type u32;        // ::SDL_KEYDOWN or ::SDL_KEYUP
  pub timestamp u32;   // In milliseconds, populated using SDL_GetTicks()
  pub windowID u32;    // The window with keyboard focus, if any
  pub state u8;        // ::SDL_PRESSED or ::SDL_RELEASED
  pub repeat u8;       // Non-zero if this is a key repeat
  pub padding2 u8;
  pub padding3 u8;
  pub keysym Keysym;   // The key that was pressed or released
}

pub struct Keysym {
  pub scancode u32;    // SDL_Scancode SDL physical key code - see ::SDL_Scancode for details
  pub sym u32;         // SDL_Keycode SDL virtual key code - see ::SDL_Keycode for details
  pub modifier u16;    // current key modifiers
  pub unused u32;
}

// Init's subsystems
pub const INIT_VIDEO = 0x20u32;

// CreateWindow's position, and its flags
pub const WINDOWPOS_CENTERED = 0x2FFF0000u;
pub const WINDOW_FULLSCREEN = 0x1u;
pub const WINDOW_OPENGL = 2u;
pub const WINDOW_RESIZABLE = 0x20u;
pub const WINDOW_FULLSCREEN_DESKTOP = 0x1001u;

// SDL_GLattr, for GL_SetAttribute
pub const GL_DOUBLEBUFFER = 5;
pub const GL_DEPTH_SIZE = 6;
pub const GL_MULTISAMPLEBUFFERS = 13;
pub const GL_MULTISAMPLESAMPLES = 14;
pub const GL_CONTEXT_MAJOR_VERSION = 17;
pub const GL_CONTEXT_MINOR_VERSION = 18;
pub const GL_CONTEXT_PROFILE_MASK = 21;
pub const GL_SHARE_WITH_CURRENT_CONTEXT = 22;

// SDL_GLprofile
pub const GL_CONTEXT_PROFILE_CORE = 1;
pub const GL_CONTEXT_PROFILE_COMPATIBILITY = 2;

// Event types
pub const QUIT = 256u;
pub const WINDOWEVENT = 0x200u;
pub const KEYDOWN = 768u;
pub const KEYUP = 769u;

// A WindowEvent's 'event'
pub const WINDOWEVENT_RESIZED = 5u8;
pub const WINDOWEVENT_SIZE_CHANGED = 6u8;

// Key codes (a Keysym's 'sym') this package's users have needed
pub const K_ESCAPE = 27u;
pub const K_F11 = 0x40000044u;   // SDL_SCANCODE_F11 (68) | SDLK_SCANCODE_MASK
