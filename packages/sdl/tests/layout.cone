// Generated by layout.py from the package's src/: do not edit. The size and
// alignment of every struct the sdl package declares, and the offset of
// each of its fields, as Cone lays them out. layout.out is what layout.c
// prints for the same structs as SDL3's headers declare them, compiled by
// cl.exe, so a difference is a struct transcribed wrongly.

mod layout;

import stdio use *;
import libc;
import sdl;

fn size(name &str, n usize, a usize) {
  printStr(name); printStr(" size "); printUInt(u64.from(n)); printStr(" align "); printUInt(u64.from(a)); printStr("\n");
}

fn o(name &str, base usize, p *u8) {
  printStr(name); printStr(" "); printUInt(u64.from((p as usize) - base)); printStr("\n");
}

fn main() i32 {
  size("Rect", mem.sizeof[sdl.Rect](), mem.alignof[sdl.Rect]());
  {
    imm raw = libc.calloc(1usize, mem.sizeof[sdl.Rect]()) as *sdl.Rect;
    mut v = mem.readRaw[sdl.Rect](raw);
    imm b = &mut v as *u8 as usize;
    o("Rect.x", b, &mut v.x as *u8);
    o("Rect.y", b, &mut v.y as *u8);
    o("Rect.w", b, &mut v.w as *u8);
    o("Rect.h", b, &mut v.h as *u8);
    libc.free(raw as *u8);
  }
  size("Event", mem.sizeof[sdl.Event](), mem.alignof[sdl.Event]());
