// Every check of the testing package, each given values that pass, so none
// prints a line and the test ends with '19 checks passed' and exit status 0.
// It also shows the widenings a check accepts: an i32 or i8 value where
// expectInt takes an i64, a u8 or usize where expectUInt takes a u64, and an
// f32 where expectFloat takes an f64; and that a check returns true when it
// passes.

mod passing;

import testing use *;

fn main() i32 {
  expect(2 + 2 == 4, "a condition that holds");
  expectInt(7i64 * 6i64, 42, "i64");
  expectInt(-3i32, -3, "i32 widened");
  expectInt(-128i8, -128, "i8 widened");
  expectUInt(18446744073709551615u64, 18446744073709551615u64, "u64, the largest");
  expectUInt(200u8, 200u64, "u8 widened");
  imm word &[]u8 = "four";
  expectUInt(word.len, 4u64, "usize widened");
  // 0.1 is not exact in binary, as f32 or f64, but within a millionth of it
  expectFloat(0.1f32, 0.1d, 0.000001, "f32 widened, within a millionth");
  // In f64 (the suffix d), 0.1 + 0.2 is not 0.3, but within rounding of it
  expectBool(0.1d + 0.2d == 0.3d, false, "0.1 + 0.2 is not exactly 0.3");
  expectFloat(0.1d + 0.2d, 0.3d, 0.000000001, "0.1 + 0.2 within rounding of 0.3");
  // The tolerance is inclusive: 1.5 is exactly 0.5 from 1 and from 2
  expectFloat(1.5, 1., 0.5, "a difference equal to the tolerance");
  expectStr("cone", "cone", "same bytes");
  expectStr("", "", "two empty strings");
  expectBool(1 < 2, true, "true");
  expectBool(1 > 2, false, "false");
  // A passing check returns true, so it can be checked in turn
  expectBool(expectInt(1, 1, "inner check"), true, "a pass returns true");
  require(true, "a require that passes goes on");
  requireInt(5, 5, "requireInt that passes");
  done();
}
