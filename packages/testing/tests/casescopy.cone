// A case's name is copied by beginCase, so it may be dropped before a check
// fails, and a name over 120 bytes is cut and ends in '...', on a UTF-8
// boundary. Written from the rules in the package's header:
//
// - a name built in a String the function that began the case then drops prints
//   whole: 'dropped name: after drop: expected 2, got 1';
// - a name of 121 'a's keeps 117 and then '...' (120 bytes);
// - a name of 116 'a's, an e with an acute accent (two bytes, at bytes 116
//   and 117) and ten 'b's is cut at byte 117 inside the accent, so it backs up
//   to 116: 116 'a's and '...';
// - three failures, three cases: '3 checks, 3 failed in 3 cases'.

mod casescopy;

import testing use *;
import collections use *;

fn begin() {
  var s = String();
  s <- "dropped name";
  beginCase(s.view());
}

fn main() i32 {
  begin();
  var junk = String();
  junk <- "overwrite the freed stack and heap with other text";
  expectInt(1, 2, "after drop");
  endCase();
  beginCase("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
  expectInt(1, 2, "long");
  endCase();
  beginCase("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaébbbbbbbbbb");
  expectInt(1, 2, "accent");
  endCase();
  done()
}
