// Checks of the testing package that fail on purpose, so the test pins each
// failure's line and the exit status, 1, that 'done' returns when any check
// failed (failing.exit). Every expected line was written from the rules in
// the package's header, not taken from a run:
//
// - each failure prints 'label: expected W, got G' and the test goes on;
// - an unsigned value prints unsigned;
// - a float prints to six decimal places, rounded (0.1234567 is 0.123457), a
//   noise value as small as an f32's rounding error prints as 0.000000 with no
//   sign, 1e20 prints as '%g' does, and NaN and the infinities by name; the
//   tolerance prints as '%g' does;
// - strings print in double quotes, so a trailing space shows;
// - a failing check returns false.
//
// Eighteen checks run: sixteen fail, and the two that pass are the check of
// the returned false and the last one.

mod failing;

import testing use *;

fn main() i32 {
  expect(1 > 2, "a condition that fails");
  expectInt(6i64 * 7i64, 43, "i64");
  expectInt(-5i32, 5, "sign");
  expectUInt(18446744073709551615u64, 0u64, "u64 prints unsigned");
  expectFloat(0.6, 0.5, 0.0001, "float");
  expectFloat(-2.25, 2.25, 0.001, "negative");
  expectFloat(0.1234567, 3.000042, 0.5, "six places");
  expectFloat(-0.0000000437114f32, 1., 0.5, "noise");
  expectFloat(100000000000000000000., 0., 1., "large");
  mut zero = 0.;
  expectFloat(zero / zero, 0., 1., "nan");
  expectFloat(1. / zero, 0., 1., "inf");
  expectFloat(-1. / zero, 0., 1., "minus inf");
  expectStr("cone ", "cone", "trailing space");
  expectStr("", "x", "empty");
  expectBool(1 > 2, true, "bool");
  expectBool(expectInt(1, 2, "inner"), false, "a failure returns false");
  expectInt(1, 1, "passing");
  done();
}
