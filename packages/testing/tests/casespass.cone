// A table of inputs checked with a case per row. Every row passes, so the
// output is the summary alone, with the case count. Six checks run (one in
// each of three cases, a second in the first, then two outside any case), so
// '6 checks passed in 3 cases'.

mod casespass;

import testing use *;

fn main() i32 {
  let names = ["two", "three", "four"];
  let ins = [2i64, 3i64, 4i64];
  var i = 0usize;
  while i < 3usize {
    beginCase(names[i]);
    expectInt(ins[i] * ins[i], ins[i] * ins[i], "square");
    if i == 0usize {expect(ins[i] == 2i64, "is two");};
    endCase();
    i = i + 1usize;
  }
  expect(true, "outside a case");
  expect(true, "and again");
  done()
}
