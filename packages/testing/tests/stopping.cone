// A 'require' check that fails stops the test: it prints its failure line,
// then the summary after 'stopped:', and ends the program with exit status 1
// (stopping.exit), so the check after it never runs and 'done' is never
// reached. The failure before it was counted and went on, as an 'expect'
// does, and a 'require' that passes goes on too.

mod stopping;

import stdio;
import testing use *;

fn main() i32 {
  expectInt(1, 2, "before");
  require(true, "a require that passes");
  requireStr("abc", "abd", "the stop");
  stdio.printStr("never printed\n");
  expectInt(3, 4, "never checked");
  done();
}
