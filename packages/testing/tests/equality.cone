// expectEq: two values of an Eq type, compared by '=='. Passing checks print
// nothing; the two failing ones print the label and both values in their debug
// form ('got ..., want ...'), and the test exits 1
// (equality.exit). Expected output written from the package's header rules:
// six checks run, the third and sixth fail.

mod equality;

import testing use *;
import collections use *;

struct Pt is Eq { x: i32; y: i32 }

fn main() i32 {
  expectEq(&3i32, &3i32, "numbers");
  expectEq(&Pt(1, 2), &Pt(1, 2), "a derived struct");
  expectEq(&Pt(1, 2), &Pt(1, 3), "a struct that differs");
  var a = List[String]();
  a.push(String.from("x"));
  var b = List[String]();
  b.push(String.from("x"));
  expectEq(&a, &b, "lists of strings");
  let some: Option[i32] = Some[i32](1);
  let same: Option[i32] = Some[i32](1);
  expectEq(&some, &same, "options");
  let none: Option[i32] = None;
  expectEq(&some, &none, "an option that differs");
  done()
}
