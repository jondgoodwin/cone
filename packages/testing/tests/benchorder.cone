// A body a thousand times heavier measures slower: only the ordering is
// checked, across a factor of 1,000, never a number of ns. It depends on a
// clock, so congo.toml lists it as 'quiet' (it runs alone, last).

mod benchorder;

import testing use *;

fn spin(n: u64) u64 {
  var s = 1u64;
  var i = 0u64;
  while i < n {
    s = (s ^ (s << 13u64)) + i;
    s = s ^ (s >> 7u64);
    i = i + 1u64;
  };
  s
}

fn main() i32 {
  var cfg = BenchConfig.standard();
  cfg.warmupMs = 10u32;
  cfg.rounds = 9u32;
  cfg.print = false;
  let light = benchWith("light", &cfg, fn() { mem.blackBox(spin(mem.blackBox(10u64))); });
  let heavy = benchWith("heavy", &cfg, fn() { mem.blackBox(spin(mem.blackBox(10000u64))); });
  expect(heavy.medianNs > light.medianNs, "the heavy body is slower");
  done()
}
