// A table with failing rows. A failing check's line starts with its case's
// name (which may hold a space); a check after endCase prints as it always
// did; a failing require inside a case names the case too, then stops. Written
// from the rules in the package's header, not taken from a run:
//
// - 'ten' fails: 'ten: square: expected 99, got 100'; 'nine' passes;
// - 'bad text' fails: 'bad text: text: expected "cone", got "cone "';
// - the check after the cases fails with no case name;
// - in 'last' the first require passes and the second stops the test.
//
// Six checks run, four fail, in four cases:
// 'stopped: 6 checks, 4 failed in 4 cases', exit status 1.

mod casesfail;

import testing use *;

fn main() i32 {
  beginCase("ten");
  expectInt(10i64 * 10i64, 99i64, "square");
  endCase();
  beginCase("nine");
  expectInt(9i64 * 9i64, 81i64, "square");
  endCase();
  beginCase("bad text");
  expectStr("cone ", "cone", "text");
  endCase();
  expectInt(1, 2, "after the cases");
  beginCase("last");
  requireInt(1, 1, "passes");
  requireInt(1, 2, "stops here");
  done()
}
