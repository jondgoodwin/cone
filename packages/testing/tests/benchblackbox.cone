// 'mem.blackBox' returns what it was given, for an integer, a float and a struct,
// and a body of 'mem.blackBox(f(mem.blackBox(1)))' with a pure 'f' runs every call:
// 'f' counts its calls on an atomic, a side effect the optimiser cannot drop,
// so the count is the number of calls the loop made (1 sizing batch of 1 call,
// then 2 rounds of 1 call: 3).

mod benchblackbox;

import testing use *;

struct Pair {
  pub a: i64;
  pub b: f64;
}

let calls: Atomic[u64];

fn @initpure init() {
  calls = Atomic[u64].of(0u64);
}

fn f(x: i64) i64 {
  calls.add(1u64);
  x * 2i64
}

fn main() i32 {
  expectInt(mem.blackBox(-42i64), -42i64, "i64 comes back");
  expectFloat(mem.blackBox(2.5), 2.5, 0., "f64 comes back");
  let p = mem.blackBox(Pair(7i64, 0.25));
  expectInt(p.a, 7i64, "struct field a comes back");
  expectFloat(p.b, 0.25, 0., "struct field b comes back");

  var cfg = BenchConfig.standard();
  cfg.warmupMs = 0u32;
  cfg.rounds = 2u32;
  cfg.batchMs = 0u32;
  cfg.print = false;
  let r = benchWith("blackbox", &cfg, fn() { mem.blackBox(f(mem.blackBox(1i64))); });
  expectUInt(calls.load(), 1u64 + 2u64 * r.iters, "every call ran");
  done()
}
