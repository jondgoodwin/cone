// How a package's test uses the testing package. A real test lives in its
// package's tests/ folder and imports that package by name, 'import mylib;';
// to stand alone, this one checks two functions of its own. Run it with
//
//   congo run packages/testing/examples/sums.cone
//
// and it prints one failure, on purpose, then the summary, and exits 1:
//
//   mean of 1 and 2 and 4: expected 2.333333 within 0.0001, got 2.000000
//   6 checks, 1 failed
//
// As a test, tests/sums.cone, it would sit beside tests/sums.out holding
// those two lines and tests/sums.exit holding 1. Fix 'mean' and the output is
// '6 checks passed', and the exit status 0, which needs no .exit file.

mod sums;

import testing use *;

// The code under test
fn sum(a i64, b i64) i64 {
  a + b;
}

// The mean of three numbers, wrong on purpose: it drops the fractional part
fn mean3(a f64, b f64, c f64) f64 {
  f64[i64[(a + b + c) / 3.]];
}

fn main() i32 {
  expectInt(sum(2, 3), 5, "sum of 2 and 3");
  expectInt(sum(-2, 2), 0, "sum of -2 and 2");
  expectFloat(mean3(1., 2., 3.), 2., 0.0001, "mean of 1 and 2 and 3");
  expectFloat(mean3(1., 2., 4.), 2.333333, 0.0001, "mean of 1 and 2 and 4");
  expectBool(sum(1, 1) == 2, true, "one and one is two");
  // A check whose failure would make the rest meaningless stops the test
  require(sum(0, 0) == 0, "zero is the identity");
  done();
}
