// The testing package: checks for a package's tests. A test is a program in
// the package's tests/ folder that imports the package it tests, and this one,
// by name; 'congo test' runs it and compares what it prints and the status it
// exits with. This package is ordinary library code, the first phase of how
// Cone tests: nothing in it is known to the compiler.
//
//   mod sums;
//   import testing use *;
//   import mylib;
//
//   fn main() i32 {
//     expectInt(mylib.sum(2, 3), 5, "sum of 2 and 3");
//     expectFloat(mylib.mean(1., 2.), 1.5, 0.000001, "mean of 1 and 2");
//     expect(mylib.isEven(4), "4 is even");
//     done();
//   }
//
// Each check counts itself and, when it passes, prints nothing. When it fails,
// it prints one line, the label and then what was expected against what was
// got,
//
//   sum of 2 and 3: expected 5, got 6
//
// and the test goes on, so one run reports every check that fails. 'done'
// prints the summary, '3 checks passed' or '3 checks, 1 failed', and returns
// the exit status, 0 or 1, which 'main' returns. The summary is part of the
// output the test's .out file pins, so the file also pins how many checks ran.
// A test that cannot run here returns 'skip(reason)' instead, which congo
// reports as skipped with the reason.
//
// Each 'expect' function has a 'require' twin that stops the test when its
// check fails: it prints the failure line, then 'stopped: 2 checks, 1 failed',
// and ends the program with exit status 1 through the C library's 'exit', which
// writes out what was printed first. Use it where going on would make no
// sense, as when a later check reads something this one found missing. Each
// test is its own program, so stopping one stops nothing else.
//
// Every 'expect' and 'require' function returns true when its check passed,
// for a test that wants to branch on it.
//
// How values print:
// - integers exactly;
// - floats to six decimal places, rounded, so the noise in the last digits of
//   an f32 does not show ('-0.000000' prints as '0.000000'); NaN and infinity
//   as 'nan', 'inf' and '-inf'; a value of nine million million or more as the
//   shortest text that reads back ('1e+20'). A float check also prints its tolerance
//   so ('1.0'). When the tolerance is below a millionth, a failing expected
//   and got can print alike. A float literal with no suffix is an f32, so it
//   carries an f32's rounding into the f64 a check takes: against an f64
//   result, with a tolerance finer than about a ten-millionth of the value,
//   write the expected value as an f64, '0.1';
// - strings as given, in double quotes, so leading and trailing spaces show;
// - bool as 'true' or 'false'.
//
// Each kind of value has a check of its own name (expectInt, expectUInt, ...)
// rather than one overloaded name, because overloads for i64 and u64 make a
// check of two plain integer literals ambiguous: the compiler does not prefer
// an exact match over a coercion.
//
// Benchmarks: 'bench(name, &body)' times a function and prints one line,
//
//   fastSum: 12.4 ns/call (median of 21, MAD 0.3)
//
// 'body' is a function, a closure or a struct with '()', taking nothing, met
// statically as 'sortBy' meets its order so a call can inline. The loop warms
// up (100 ms), sizes a batch by doubling its calls until one batch takes about
// 1 ms, so a clock read (tens of ns) is shared by thousands of calls, then
// times 21 such batches and reports ns per call: the median, the least and
// greatest ('minNs', 'maxNs') and the median absolute deviation ('madNs'),
// returned in a BenchResult. With the standard settings a bench takes about
// 0.2 s (the 100 ms warm-up, the doubling, and 21 rounds of about 1 ms; a body
// of milliseconds per call takes longer, one batch being at least one call).
// 'benchWith(name, &cfg, &body)' takes the settings, from
// 'BenchConfig.standard()' with a field changed ('print' off silences the line,
// for a test, whose pinned .out cannot hold a time). Wrap what the body computes
// in 'blackBox' so the optimiser cannot delete or hoist it: for a pure
// function 'f', 'blackBox(f(blackBox(x)))'.
//
// The numbers belong in the stdout of an example program run by 'congo run',
// never in a test's pinned .out file: a time changes on every run. A test of
// the loop checks counts and orderings, never a time. A run beside other work
// is noise; keeping a machine quiet for timing is the business of the lanes'
// timing windows, and no thread is pinned to a core. Not here yet: comparing
// a run with a saved baseline; allocation counts per call (a planned
// follow-up, which needs a hook in core's allocator); benchmarks found by
// name or by an attribute, which wait for attributes.
//
// Not here yet, deferred to the careful design of testing, which is not yet
// made: a failure naming the expression it checked
// and the line it is on, which needs the compiler to hand a function its
// caller's expression text and location; test functions marked in source
// ('@test') and a test build; a test reaching a package's private submodules;
// fixtures, setup and teardown beyond a program's own; and mocks.

mod testing;

import stdio;
import libc;
import time;
import collections use List;

// Where 'blackBox' lets an address escape
let sink: Atomic[usize];

// How many checks have run, and how many of them failed. A check may run on
// any thread, so each count is an atomic held by a 'let' global
let checks: Atomic[u64];
let failures: Atomic[u64];

fn @initpure init() {
  sink = Atomic[usize].of(0usize);
  checks = Atomic[u64].of(0u64);
  failures = Atomic[u64].of(0u64);
}

// -------- checks that record a failure and go on --------

// The condition holds. A failure prints 'label: failed'.
pub fn expect(cond: bool, label: &Array[u8]) bool {
  if cond {
    pass()
  } else {
    fail(label);
    stdio.printStr("failed\n");
    false
  }
}

// Two signed integers are equal. An i32, i16 or i8 value is widened to i64.
pub fn expectInt(got: i64, want: i64, label: &Array[u8]) bool {
  if got == want {
    pass()
  } else {
    fail(label);
    stdio.printStr("expected ");
    stdio.printInt(want);
    stdio.printStr(", got ");
    stdio.printInt(got);
    stdio.printStr("\n");
    false
  }
}

// Two unsigned integers are equal. A usize, u32, u16 or u8 value is widened
// to u64.
pub fn expectUInt(got: u64, want: u64, label: &Array[u8]) bool {
  if got == want {
    pass()
  } else {
    fail(label);
    stdio.printStr("expected ");
    stdio.printUInt(want);
    stdio.printStr(", got ");
    stdio.printUInt(got);
    stdio.printStr("\n");
    false
  }
}

// Two floats differ by no more than the tolerance, 'within'. An f32 value is
// widened to f64. A NaN is never within any tolerance of anything. A failure
// prints 'label: expected 0.500000 within 0.0001, got 0.600000'.
pub fn expectFloat(got: f64, want: f64, within: f64, label: &Array[u8]) bool {
  let diff = if got < want {want - got} else {got - want};
  if diff <= within {
    pass()
  } else {
    fail(label);
    stdio.printStr("expected ");
    printFixed(want);
    stdio.printStr(" within ");
    stdio.printFloat(within);
    stdio.printStr(", got ");
    printFixed(got);
    stdio.printStr("\n");
    false
  }
}

// Two strings hold the same bytes. A failure prints both in double quotes.
pub fn expectStr(got: &Array[u8], want: &Array[u8], label: &Array[u8]) bool {
  if got == want {
    pass()
  } else {
    fail(label);
    stdio.printStr("expected \"");
    stdio.printStr(want as &str);
    stdio.printStr("\", got \"");
    stdio.printStr(got as &str);
    stdio.printStr("\"\n");
    false
  }
}

// Two Bools are equal. A failure prints 'label: expected true, got false'.
pub fn expectBool(got: bool, want: bool, label: &Array[u8]) bool {
  if got == want {
    pass()
  } else {
    fail(label);
    stdio.printStr("expected ");
    printBool(want);
    stdio.printStr(", got ");
    printBool(got);
    stdio.printStr("\n");
    false
  }
}

// Two values of any Eq type are equal by '=='. Both are lent, so a type that moves
// (a String, a list) is compared where it is. A failure prints
// 'label: got <got>, want <want>', both sides in their debug form (core's toDebug:
// the type's own, or the one the compiler writes when asked).
pub fn expectEq[T: Eq](got: &T, want: &T, label: &Array[u8]) bool {
  if got == want {
    pass()
  } else {
    fail(label);
    stdio.print <- "got ", toDebug(got), ", want ", toDebug(want), "\n";
    false
  }
}

// -------- checks that stop the test when they fail --------

// Each is its 'expect' twin, and when the check fails, prints the summary
// with 'stopped:' before it and ends the program with exit status 1.

pub fn require(cond: bool, label: &Array[u8]) bool {
  if expect(cond, label) {true} else {stop()}
}

pub fn requireInt(got: i64, want: i64, label: &Array[u8]) bool {
  if expectInt(got, want, label) {true} else {stop()}
}

pub fn requireUInt(got: u64, want: u64, label: &Array[u8]) bool {
  if expectUInt(got, want, label) {true} else {stop()}
}

pub fn requireFloat(got: f64, want: f64, within: f64, label: &Array[u8]) bool {
  if expectFloat(got, want, within, label) {true} else {stop()}
}

pub fn requireStr(got: &Array[u8], want: &Array[u8], label: &Array[u8]) bool {
  if expectStr(got, want, label) {true} else {stop()}
}

pub fn requireBool(got: bool, want: bool, label: &Array[u8]) bool {
  if expectBool(got, want, label) {true} else {stop()}
}

pub fn requireEq[T: Eq](got: &T, want: &T, label: &Array[u8]) bool {
  if expectEq(got, want, label) {true} else {stop()}
}

// -------- the end of a test --------

// Prints '5 checks passed', or '5 checks, 2 failed', and returns the exit
// status for 'main' to return: 0 when every check passed, 1 when any failed.
pub fn done() i32 {
  summary();
  if failures.load() == 0u64 {0i32} else {1i32}
}

// For a test that cannot run its checks here (a file it needs is absent):
// prints 'skipped: ' and the reason, and returns the status for 'main' to
// return, 77, which 'congo test' reports as skipped, with the reason, rather
// than passed or failed. Nothing is compared with the test's .out file, so a
// run that skips never claims the checks it did not make.
pub fn skip(reason: &Array[u8]) i32 {
  stdio.printStr("skipped: ");
  stdio.printStr(reason as &str);
  stdio.printStr("\n");
  77i32
}

// -------- benchmarks --------

// What one 'bench' measured, in ns per call
pub struct BenchResult {
  pub rounds: usize;     // samples taken
  pub iters: u64;        // calls in each sample
  pub medianNs: f64;     // the median of the samples
  pub minNs: f64;
  pub maxNs: f64;
  pub madNs: f64;        // the median absolute deviation of the samples from their median
}

// The settings of a run. 'BenchConfig.standard()' is the defaults; change a
// field of it for a slow body (fewer 'rounds') or a smoke test (1 round, no warm-up).
pub struct BenchConfig {
  pub warmupMs: u32;     // untimed warm-up: 100
  pub rounds: u32;       // samples: 21, odd so the median is a sample
  pub batchMs: u32;      // the length a sample's batch of calls grows to: 1
  pub print: bool;       // print the line: true. Turn it off for any caller collecting
                         // BenchResults quietly (a lane script, a later 'congo bench', a test,
                         // whose pinned .out cannot hold a time)

  pub fn standard() BenchConfig {BenchConfig(100u32, 21u32, 1u32, true)}
}

// Time 'body' with the standard settings, print its line, return the result
pub fn bench[F: fn()](name: &Array[u8], body: &F) BenchResult {
  let cfg = BenchConfig.standard();
  benchWith(name, &cfg, body)
}

// Time 'body' with the settings given, print 'name: 12.4 ns/call (median of 21, MAD 0.3)',
// return the result. At least one round is taken.
pub fn benchWith[F: fn()](name: &Array[u8], cfg: &BenchConfig, body: &F) BenchResult {
  let batchNs = i64.from(cfg.batchMs) * 1000000i64;
  let warmNs = i64.from(cfg.warmupMs) * 1000000i64;
  let rounds = if cfg.rounds == 0u32 {1usize} else {usize.from(cfg.rounds)};

  // Warm up, and size the batch: double its calls until it takes the batch
  // length, then go on with batches of that size until the warm-up time is spent
  var iters = 1u64;
  var spent = 0i64;
  var sized = false;
  while !sized || spent < warmNs {
    let t = batchNsOf(body, iters);
    spent = spent + t;
    if !sized {
      if t >= batchNs || iters >= 1099511627776u64 {sized = true;} else {iters = iters * 2u64;};
    };
  };

  // The rounds, each ns per call
  var per = Samples();
  var i = 0usize;
  while i < rounds {
    let t = batchNsOf(body, iters);
    per.push(f64.from(t) / f64.from(iters));
    i = i + 1usize;
  };
  per.sort();
  let med = medianOf(&per);
  let lo = *per[0usize];
  let hi = *per[rounds - 1usize];
  // The deviations from the median, in place, then their median
  i = 0usize;
  while i < rounds {
    let d = *per[i] - med;
    per[i] = if d < 0. {-d} else {d};
    i = i + 1usize;
  };
  per.sort();
  let mad = medianOf(&per);

  if cfg.print {
    stdio.printStr(name as &str);
    stdio.printStr(": ");
    printTenths(med);
    stdio.printStr(" ns/call (median of ");
    stdio.printUInt(u64.from(rounds));
    stdio.printStr(", MAD ");
    printTenths(mad);
    stdio.printStr(")\n");
  };
  BenchResult(rounds, iters, med, lo, hi, mad)
}

// A value the optimiser cannot see through: returns 'v', after the address of
// a copy of it has gone through an atomic exchange that every thread could
// read, so the compiler must have 'v' in memory and must read it back.
//
// The rule: wrap both the inputs and the result of what you time,
// 'blackBox(f(blackBox(3)))'. Wrapping the result keeps the call from being
// deleted as unused; wrapping the inputs keeps it from being folded, because a
// constant input still folds ('blackBox(f(3))' computes 'f(3)' at compile time
// and times only the sink). The sink costs about 6 ns a
// call (one atomic exchange; measured once on the developer's laptop, release
// build, as an empty body against 'blackBox(1u64)': 0.0 against 5.8 and 6.3
// ns), so 'blackBox(f(blackBox(x)))' adds about 12 ns to 'f'. The figures
// 'bench' prints include it and are not corrected for it: read a result under
// about 20 ns with that cost beside it. What the optimiser does with it, read
// from the IR: a pure call whose result goes unused is deleted; one wrapped
// in 'blackBox' alone, on a constant, is folded to its value at compile time
// (the exchange stays, the work goes); with the inner 'blackBox' the argument
// is read back from memory and the work is done on every call.
pub fn blackBox[T](v: T) T {
  var held = v;
  sink.swap(&held as usize);
  held
}

// -------- inside the package --------

// The ns a batch of 'n' calls of 'body' takes
fn batchNsOf[F: fn()](body: &F, n: u64) i64 {
  let start = time.Instant.now();
  var k = 0u64;
  while k < n {
    body();
    k = k + 1u64;
  };
  start.elapsed().nanos()
}

// The ns per call of each round of a bench
alias Samples = List[f64];

// The median of sorted values: the middle one, or the mean of the middle two
fn medianOf(p: &Samples) f64 {
  let n = p.len();
  if n % 2usize == 1usize {
    *p[n / 2usize]
  } else {
    (*p[n / 2usize - 1usize] + *p[n / 2usize]) / 2.
  }
}

// One decimal place, rounded
fn printTenths(v: f64) {
  let n = u64.from(v * 10. + 0.5);
  stdio.printUInt(n / 10u64);
  stdio.printStr(".");
  stdio.printUInt(n % 10u64);
}

fn pass() bool {
  checks.add(1u64);
  true
}

// Counts a failure and starts its line with the label
fn fail(label: &Array[u8]) {
  checks.add(1u64);
  failures.add(1u64);
  stdio.printStr(label as &str);
  stdio.printStr(": ");
}

// Ends the program at a failed 'require' check. The C library's exit writes
// out what was printed before the program ends.
fn stop() bool {
  stdio.printStr("stopped: ");
  summary();
  libc.exit(1i32);
  false
}

fn summary() {
  let ran = checks.load();
  let failed = failures.load();
  stdio.printUInt(ran);
  if ran == 1u64 {stdio.printStr(" check");} else {stdio.printStr(" checks");};
  if failed == 0u64 {
    stdio.printStr(" passed\n");
  } else {
    stdio.printStr(", ");
    stdio.printUInt(failed);
    stdio.printStr(" failed\n");
  };
}

fn printBool(b: bool) {
  if b {stdio.printStr("true");} else {stdio.printStr("false");};
}

// Six decimal places, rounded half away from zero. NaN and the infinities are
// spelled here, since C runtimes spell them differently; any other magnitude
// too large to scale into a u64 prints as the shortest text that reads back.
fn printFixed(v: f64) {
  let mag = if v < 0. {-v} else {v};
  if v != v {
    stdio.printStr("nan");
  } else if mag - mag != 0. {
    // Only an infinity minus itself is not 0 (NaN, the other, is past)
    if v < 0. {stdio.printStr("-inf");} else {stdio.printStr("inf");};
  } else if mag < 9000000000000. {
    let n = u64.from(mag * 1000000. + 0.5);
    if v < 0. && n > 0u64 {stdio.printStr("-");};
    stdio.printUInt(n / 1000000u64);
    stdio.printStr(".");
    let frac = n % 1000000u64;
    var pad = 100000u64;
    while pad > 1u64 && frac < pad {
      stdio.printStr("0");
      pad = pad / 10u64;
    };
    stdio.printUInt(frac);
  } else {
    stdio.printFloat(v);
  };
}
