// The cancelgroups package: the one carrier of "stop this work" for all of
// Cone's concurrency. A CancelGroup is a value handed to many operations,
// loops and actors, on any threads, whose one 'cancel' asks every one of them
// to end: the browser's AbortSignal, tokio's cancellation token. The I/O
// loops (iocore), the actors runtime and 'parallel each' all reach it here,
// which is why it lives below all three: this package imports no I/O and no
// actors. A message sent to an actor carries the group its sender works in, and
// the behaviour handling it works in that group (actors.currentGroup()); a
// CancelGroup is 16 bytes, which the actors package's slot header is sized for.
//
//   import cancelgroups use *;
//
//   let g = CancelGroup.make();
//   let job = g.child();                    // cancelled with g, or by its own cancel
//   ...
//   while !job.isCancelled() {              // a flag load, a few ns, in any loop
//     ...one piece of work...
//   }
//   ...elsewhere, any thread...
//   g.cancel();                             // true the first time
//   match job.cause() {case let Some(c) {...} else {}}   // why: Cancelled
//
//   CancelGroup.make()   .until(deadline)      a group; one with a deadline
//   g.child()  g.childUntil(d)  g.shield(d)    a child; one with a tighter deadline; cleanup's
//   g.cancel()  g.cancelWith(cause)            ask every operation to end; say why
//   g.isCancelled()  g.cause()                 the state; its reason (None while live)
//   g.deadline()  g.isShield()  g.id()
//   g.watch(loopId, &w)                        a loop to tell on a cancel (WAKING LOOPS)
//   Cause: Cancelled, TimedOut, SiblingFinished, Shutdown
//   Cancelled(cause)                           the error of work that was cancelled (an Error, Sendable):
//                                              what actors.checkCancelled() answers, for '?'
//   Wakeup                                    what a loop gives 'watch'
//   forever()                                  a deadline that never comes
//
// HOW IT IS BUILT. A group is an Arc to its state. The state holds one word,
// the flag and its cause together: 0 while live, else the cause's code. A
// cancel stores the code once (the first cancel's cause stays), then tells the
// loops. A child reaches its parent's state through a raw pointer ('up') that
// its own owner of the parent keeps alive, so 'isCancelled' walks the chain of
// flags with plain loads: no Arc is copied, no count touched, and the walk is
// declared inline, so it compiles into the caller's loop. A copy of an
// Arc-held parent per level cost 54 ns at depth 3 and 880 times a loop's pace
// under 24 workers (the proof of concept of 31 Oct 2026); now a check is
// one load per level. A shield has no 'up': its parent's cancel does not
// reach it.
//
// DEADLINES. A group with a deadline of its own (until, childUntil with a
// tighter one, shield) arms ONE timer, on a thread of this package's that is
// started with the first one, which cancels the group with the cause TimedOut
// when the deadline comes. A loop therefore never reads the clock to learn
// of a deadline (Instant.now() costs about 23 ns); it reads the flag, and
// 'cause' says it was the clock. A child that inherits its parent's deadline
// arms nothing: the parent's flag reaches it. The timer holds the group's
// state until it fires or until the last handle on the group is dropped,
// whichever comes first (a TimerGuard, held by every handle, disarms it), so a
// request's group that finished in time leaves nothing behind. The timer is
// the wheel's (package timewheel), up to a millisecond late and never early.
// 'deadline()' stays the tighter of the group's own and its parent's, for
// the loops that apply it to their own operations.
//
// WAKING LOOPS. A loop that blocks (iocore's poll) is told by a posted
// message, never by a callback the canceller runs: 'watch' gives the group a
// Wakeup of the loop's own, whose 'signal' posts the loop a packet. The
// group keeps one per loop, for itself and each ancestor up to a shield, and
// a cancel signals them under the group's lock. The registration and the
// cancel take that lock, and the registering loop reads the flag again after
// it, so a cancel and a registration racing on two threads are ordered by the
// lock: either the cancel sees the loop and tells it, or the loop sees the
// flag set. A loop that has gone is dropped from the list at the next
// registration.

mod cancelgroups;

import sync use Arc, Mutex, Condvar;
import collections use List, String;
import time use Instant, Duration;
import libc;
import thread;
import timewheel use Wheel, TimerId, Expiry;

let groupSeq: Atomic[u64];

// The timer's world, all under 'timerLock': the wheel; the slot table of the
// groups armed in it (a wheel token is a slot's index), with the free slots;
// what an arm found already due; and whether the thread has started
let timerLock: Mutex;
let timerWake: Condvar;
let timersAt: Atomic[usize];
let timerStarted: Atomic[u32];

// What 'timerLock' guards, in one block the program never frees: reached by a
// raw pointer, so that the checker does not see a global reaching the Arc of
// every group armed (a call that might replace it would then refuse every use
// of a group's state)
struct Timers {
  wheel: Wheel;
  slots: List[Option[Arc[imm, GroupState]]];
  free: List[u32];
  due: List[Expiry];
}

fn timers() &mut Timers {
  let p = timersAt.load() as *Timers;
  p as &mut Timers
}

fn @initpure init() {
  groupSeq = Atomic[u64].of(0u64);
  timerLock = Mutex.make();
  timerWake = Condvar.make();
  let t = libc.malloc(mem.sizeof[Timers]()) as *Timers;
  mem.writeRaw[Timers](t, Timers(Wheel.make(Instant.now()), List[Option[Arc[imm, GroupState]]](),
    List[u32](), List[Expiry]()));
  timersAt = Atomic[usize].of(t as usize);
  timerStarted = Atomic[u32].of(0u32);
}

// An instant that never comes: the deadline of a group that has none
pub fn forever() Instant {Instant.fromNanos(0x7FFFFFFFFFFFFFFFi64)}

// Why a group was cancelled. The first cancel's cause is the one kept
pub enum Cause {
  // Someone asked: 'cancel()'
  Cancelled,
  // Its deadline came
  TimedOut,
  // A sibling finished the job (a search that found its answer): the rest stop
  SiblingFinished,
  // The program, or the part of it that owns this work, is shutting down
  Shutdown
}

// The error of work that was cancelled, why: what 'actors.checkCancelled()' answers
// when the group the code works in is cancelled, so that '?' passes it on and the
// code after the check runs its clean-up (a function returning a Result takes it as an
// 'Err(Cancelled)' of an error enum with a variant holding one, or as an AnyError)
pub struct Cancelled is Error, Sendable {
  pub cause: Cause;

  pub fn toText(self: &, out: &uni TextOut) { out <- self.message().view(); }
  pub fn message(self: &) String {
    var s = String();
    match cause {
      case Cause.Cancelled { s.append("cancelled"); }
      case Cause.TimedOut { s.append("cancelled: its deadline came"); }
      case Cause.SiblingFinished { s.append("cancelled: a sibling finished the job"); }
      case Cause.Shutdown { s.append("cancelled: shutting down"); }
    }
    s
  }
}

const codeLive = 0u32;
const codeCancelled = 1u32;
const codeTimedOut = 2u32;
const codeSibling = 3u32;
const codeShutdown = 4u32;

fn codeOf(c: Cause) u32 {
  match c {
    case Cause.Cancelled {codeCancelled}
    case Cause.TimedOut {codeTimedOut}
    case Cause.SiblingFinished {codeSibling}
    case Cause.Shutdown {codeShutdown}
  }
}

fn causeOf(code: u32) Option[Cause] {
  if code == codeCancelled {return Some[Cause](Cause.Cancelled);}
  if code == codeTimedOut {return Some[Cause](Cause.TimedOut);}
  if code == codeSibling {return Some[Cause](Cause.SiblingFinished);}
  if code == codeShutdown {return Some[Cause](Cause.Shutdown);}
  None
}

// What a loop gives a group to be told by (see WAKING LOOPS). 'signal' posts
// the loop a message and answers false if the loop has gone. 'isGone' is how a
// dead watcher is dropped without a lock of its own: it asks the loop's liveness
// directly (an atomic read), so 'watch', already under the group's lock, can
// sweep out the entries of loops that have died without posting to them and
// without taking any lock of the loop's. It must not block.
// What an implementer promises: 'watch' keeps it as a 'Uni[Wakeup + Sendable +
// ShapeKeeping]', so it must be 'Sendable' and 'ShapeKeeping' (the compiler
// infers the latter and refuses the call to 'watch' naming the offending call
// if not): 'signal' and 'isGone' reshape no collection they reach through a
// shared mutable path, i.e. they post and read an atomic, they do not push to,
// clear or replace a list the caller of 'cancel' may hold a borrow into
pub trait Wakeup {
  pub fn signal(self: &) bool;
  pub fn isGone(self: &) bool;
}

// A group's state, shared through an Arc by every copy of it and by every
// operation in it. It declares Sendable, a promise taken on trust: the flag
// word and the first loop's id are atomics; the lists change only under
// 'lock'; 'up' points at a state a handle in 'parent' keeps alive
pub struct GroupState is Sendable, Move {
  state: Atomic[u32];        // 0 live, else the cause's code: flag and cause in one word
  up: *GroupState;           // the parent's state while its cancel reaches this group, else null
  first: Atomic[u64];        // the first loop registered: the fast path
  deadline: Instant;         // the tighter of its own and its parent's (a shield: its own)
  shield: bool;              // its parent's cancel and deadline do not reach it
  parent: Option[CancelGroup];
  lock: Mutex;
  reg: *Registry;            // private: a *Registry, see 'registry'. Under 'lock'
  gid: u64;

  // Its state changed under its lock through a shared reference
  fn lists(self: &) &mut GroupState {
    let p = self as *GroupState;
    p as &mut GroupState
  }

  // The loops this group tells, made empty on the first call. The ONE place
  // 'reg' is cast back to the Registry type; every other use goes through here.
  // The registry holds trait objects, which the reshape check takes to reach
  // "anything" unless marked '+ ShapeKeeping' (Bug 30); the wakers are marked,
  // so a group reaches no more than its other fields do.
  // LIFETIME: the registry is allocated here, under 'lock', by the first
  // 'watch' (a group nobody watches never has one, and 'cancelWith' and
  // 'final' look at 'reg' before calling this). Only this group's own
  // 'final' frees it, when the state's last owner (an Arc) goes: so it
  // outlives every handle, timer slot and ancestor walk that can reach it.
  // Callers hold 'lock' (final needs none: it is the last owner)
  fn registry(self: &) &mut Registry {
    let st = self.lists();
    if st.reg as usize == 0usize {
      let block = libc.malloc(mem.sizeof[Registry]()) as *Registry;
      mem.writeRaw[Registry](block, Registry(List[u64](), List[Uni[Wakeup + Sendable + ShapeKeeping]]()));
      st.reg = block;
    }
    st.reg as &mut Registry
  }

  // Cancel with a cause: true if this call did it. The first cause is kept
  fn cancelWith(self: &, code: u32) bool {
    let was, ok = state.compareSwap(codeLive, code);
    if !ok {return false;}
    let st = self.lists();
    st.lock.lock();
    if st.reg as usize != 0usize {
      let r = self.registry();
      var k = 0usize;
      while k < r.wakers.len() {
        r.wakers[k].signal();
        k = k + 1usize;
      }
    }
    st.lock.unlock();
    true
  }

  fn final(self: &uni) {
    if reg as usize != 0usize {
      let r = self.registry();
      mem.finalize[Registry](r as *Registry);
      libc.free(reg as *u8);
    }
  }
}

// The loops a group tells. They live out of line, so that most groups, which
// never have one, pay 8 bytes. The wakers are '+ ShapeKeeping' (see
// 'Wakeup'), so holding them does not make a group reach "anything"
struct Registry {
  loops: List[u64];                     // the loops registered: their ids...
  wakers: List[Uni[Wakeup + Sendable + ShapeKeeping]]; // ...and how to tell them
}

// What a handle holds to keep its group's timer armed: when the last handle
// goes, so does this, and the timer lets go of the group (see DEADLINES)
struct TimerGuard is Sendable, Move {
  slot: u32;
  id: TimerId;

  fn final(self: &uni) {disarm(slot, id);}
}

// A cancel group (see the package's header). Copying it makes another handle
// on the same group
pub struct CancelGroup {
  s: Arc[imm, GroupState];
  guard: Option[Arc[imm, TimerGuard]];   // keeps the group's own timer armed; None if it has none

  // A new group, live, with no deadline
  pub fn make() CancelGroup {CancelGroup.made(forever(), false, None, false)}

  // A new group, live, which cancels itself with the cause TimedOut at deadline
  pub fn until(deadline: Instant) CancelGroup {CancelGroup.made(deadline, false, None, true)}

  fn made(deadline: Instant, shield: bool, parent: Option[CancelGroup], own: bool) CancelGroup {
    var up = 0usize as *GroupState;
    if !shield {
      match parent {
        case let Some(p) {up = p.s as *GroupState;}
        else {}
      }
    }
    let a = Arc[imm, GroupState](GroupState(
      state: Atomic[u32].of(codeLive), up: up, first: Atomic[u64].of(0u64), deadline: deadline,
      shield: shield, parent: parent, lock: Mutex.make(),
      reg: 0usize as *Registry,
      gid: groupSeq.add(1u64) + 1u64));
    var g: Option[Arc[imm, TimerGuard]] = None;
    if own && deadline < forever() {g = arm(a, deadline);}
    CancelGroup(a, g)
  }

  // A child: cancelled when this group is, or by its own cancel (which does
  // not reach this group); its deadline this group's
  pub fn child(self: &) CancelGroup {
    CancelGroup.made(s.deadline, false, Some[CancelGroup](*self), false)
  }

  // A child whose deadline is the tighter of this group's and 'deadline'
  pub fn childUntil(self: &, deadline: Instant) CancelGroup {
    if deadline < s.deadline {
      CancelGroup.made(deadline, false, Some[CancelGroup](*self), true)
    } else {
      CancelGroup.made(s.deadline, false, Some[CancelGroup](*self), false)
    }
  }

  // A shield, for cleanup: a group that this group's cancel and deadline do
  // not reach, its deadline its own, so work started to clean up after a
  // cancel runs, bounded by its own deadline. Its own cancel still ends it
  pub fn shield(self: &, deadline: Instant) CancelGroup {
    CancelGroup.made(deadline, true, Some[CancelGroup](*self), true)
  }

  // Ask every operation in the group, and in its children, to end: each
  // still answers once, saying how it ended. True the first time; false
  // once it was cancelled already (idempotent). From any thread
  pub fn cancel(self: &) bool {s.cancelWith(codeCancelled)}

  // The same, giving the reason ('Cause.SiblingFinished' when the job is
  // done, 'Cause.Shutdown' when the program ends). The first cause is kept
  pub fn cancelWith(self: &, cause: Cause) bool {s.cancelWith(codeOf(cause))}

  // Whether this group is cancelled: by its own cancel, its deadline, or an
  // ancestor's, up to a shield. A state: true from the cancel on. A load per
  // level of ancestry, inlined into the caller
  pub fn isCancelled(self: &) bool inline {
    var p = s as *GroupState;
    while p as usize != 0usize {
      let q = p as &GroupState;
      if q.state.loadOrdered(MemOrder.Acquire) != codeLive {return true;}
      p = q.up;
    }
    false
  }

  // Why it is cancelled: the cause of the nearest group, from this one up to
  // a shield, that was cancelled; None while it is live
  pub fn cause(self: &) Option[Cause] {
    var p = s as *GroupState;
    while p as usize != 0usize {
      let q = p as &GroupState;
      let c = q.state.loadOrdered(MemOrder.Acquire);
      if c != codeLive {return causeOf(c);}
      p = q.up;
    }
    None
  }

  // Its deadline: the tighter of its own and its parent's, forever() when
  // it has none
  pub fn deadline(self: &) Instant {s.deadline}

  // Whether it is a shield
  pub fn isShield(self: &) bool {s.shield}

  // Its id, unique in the process: 1, 2, 3...
  pub fn id(self: &) u64 {s.gid}

  // Tell the loop when this group, or an ancestor up to a shield, is
  // cancelled: once per loop. 'w' is copied into the group when the loop is
  // not yet in it. Each call also drops the entries of loops that have died,
  // found by their 'isGone' (an atomic read, so no lock but the group's own
  // is taken and nothing is posted to a dead loop)
  pub fn watch[W: Wakeup + Sendable](self: &, loopId: u64, w: &W) {
    if s.first.load() == loopId {return;}
    self.watchChain(loopId, w);
  }

  fn watchChain[W: Wakeup + Sendable](self: &, loopId: u64, w: &W) {
    let st = s.lists();
    st.lock.lock();
    let r = st.registry();
    var found = false;
    var k = 0usize;
    while k < r.loops.len() {
      if *r.loops[k] == loopId {
        found = true;
        k = k + 1usize;
      } else if r.wakers[k].isGone() {
        // A loop that has died: its entry goes, last into its place
        let last = r.loops.len() - 1usize;
        r.loops.swap(k, last);
        r.wakers.swap(k, last);
        r.loops.pop();
        r.wakers.pop();
      } else {
        k = k + 1usize;
      }
    }
    if !found {
      r.loops.push(loopId);
      let u = Uni[W](*w);
      r.wakers.push(u);
      if r.loops.len() == 1usize {st.first.store(loopId);}
    }
    st.lock.unlock();
    if !s.shield {
      match s.parent {
        case let Some(p) {p.watchChain(loopId, w);}
        else {}
      }
    }
  }
}

// ---------------------------------------------------------------------------
// The timer thread
// ---------------------------------------------------------------------------

// What the thread is handed: nothing; it reaches the globals
struct TimerArg is Sendable {
  pub unused: u32;
}

// Arm a timer that cancels 'a' with TimedOut at 'deadline'. The group is held
// by the timer until it fires or the returned guard goes
fn arm(a: Arc[imm, GroupState], deadline: Instant) Option[Arc[imm, TimerGuard]] {
  if timerStarted.compareSwap(0u32, 1u32).1 {
    let t = thread.startWith(thread.Options(name: "cancel timers"), TimerArg(0u32), &timerMain);
    t.detach();
  }
  let tm = timers();
  timerLock.lock();
  // The wheel's time brought up to now first: it may have idled for long
  tm.wheel.expired(Instant.now(), &mut tm.due);
  var slot = 0u32;
  if tm.free.len() > 0usize {
    slot = tm.free.pop().unwrap();
    tm.slots[usize.from(slot)] = Some[Arc[imm, GroupState]](a);
  } else {
    slot = u32.from(tm.slots.len());
    tm.slots.push(Some[Arc[imm, GroupState]](a));
  }
  let before = tm.wheel.nextExpiry();
  let id = tm.wheel.insert(deadline, u64.from(slot));
  let after = tm.wheel.nextExpiry();
  var earlier = true;
  match before {
    case let Some(b) {
      match after {
        case let Some(x) {earlier = x < b;}
        else {}
      }
    }
    else {}
  }
  let overdue = tm.due.len() > 0usize;
  timerLock.unlock();
  if earlier || overdue {timerWake.notifyOne();}
  Some[Arc[imm, TimerGuard]](Arc[imm, TimerGuard](TimerGuard(slot, id)))
}

// The last handle on a group went before its deadline: the timer lets go of it
fn disarm(slot: u32, id: TimerId) {
  var held: Option[Arc[imm, GroupState]] = None;
  let tm = timers();
  timerLock.lock();
  if tm.wheel.cancel(id) {
    held = tm.slots[usize.from(slot)];
    tm.slots[usize.from(slot)] = None;
    tm.free.push(slot);
  }
  timerLock.unlock();
  // 'held' goes here, outside the lock: it may be the group's last owner
}

// Take what has fired into 'firing', the slots freed (under the lock)
fn collectDue(firing: &mut List[Arc[imm, GroupState]]) {
  let tm = timers();
  var k = 0usize;
  while k < tm.due.len() {
    let slot = usize.from((*tm.due[k]).token);
    match tm.slots[slot] {
      case let Some(a) {firing.push(a);}
      else {}
    }
    tm.slots[slot] = None;
    tm.free.push(u32.from(slot));
    k = k + 1usize;
  }
  tm.due.clear();
}

fn timerMain(a: TimerArg) {
  var firing = List[Arc[imm, GroupState]]();
  let tm = timers();
  timerLock.lock();
  while true {
    let now = Instant.now();
    tm.wheel.expired(now, &mut tm.due);
    if tm.due.len() > 0usize {
      collectDue(&mut firing);
      timerLock.unlock();
      var k = 0usize;
      while k < firing.len() {
        (*firing[k]).cancelWith(codeTimedOut);
        k = k + 1usize;
      }
      firing.clear();
      timerLock.lock();
    } else {
      match tm.wheel.nextExpiry() {
        case let Some(t) {
          var d = t - now;
          if d.nanos() <= 0i64 {d = Duration.fromNanos(100000i64);}
          timerWake.condWaitTimeout(&timerLock, d);
        }
        else {timerWake.condWait(&timerLock);}
      }
    }
  }
}

// How many timers are armed now (groups with a deadline that has neither
// fired nor lost its last handle). For tests and for finding leaks
pub fn armedTimers() usize {
  timerLock.lock();
  let n = timers().wheel.len();
  timerLock.unlock();
  n
}
