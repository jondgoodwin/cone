// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import cancelgroups use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- Cancelled(Cause.Cancelled), "cancelled", "cancelled");
  says(String() <- Cancelled(Cause.TimedOut), "cancelled: its deadline came", "deadline");
  says(String() <- Cancelled(Cause.SiblingFinished), "cancelled: a sibling finished the job", "sibling");
  says(String() <- Cancelled(Cause.Shutdown), "cancelled: shutting down", "shutdown");
  done()
}
