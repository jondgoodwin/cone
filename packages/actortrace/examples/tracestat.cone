// The trace reader as a command: counts per kind, per actor and per behaviour,
// and the mailbox wait and run-time percentiles of a file the logger wrote.
//
//   congo run --release packages/actortrace/examples/tracestat.cone -- trace.bin

mod tracestat;

import stdio use *;
import actortrace;

fn main(argc: i32, argv: **u8) i32 {
  if argc < 2i32 {
    printStr("usage: tracestat <trace file>\n");
    return 2i32;
  }
  if !actortrace.report(cstr.fromPtr(*(argv + 1usize))) {
    printStr("tracestat: not a trace file, or cannot be read\n");
    return 1i32;
  }
  0i32
}
