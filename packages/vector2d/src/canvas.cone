// ======== Canvas: the drawing calls ========
//
// A Canvas is a pixel-space drawing surface that records, not draws: its
// calls tessellate into a Batch (and note the text), and a VectorRenderer
// turns the recording into pixels. It is plain data with no GPU in it, so it
// is tested on the CPU. Units are pixels, x right, y DOWN, unless the
// transform says otherwise; paths are given in user units and go through the
// current transform before they are flattened, so a stroke's width is scaled
// by the transform's mean scale.

pub const TEXT_LEFT = 0u32;
pub const TEXT_CENTER = 1u32;
pub const TEXT_RIGHT = 2u32;

// A string to draw: its anchor (the fraction ax across and ay down the text
// block is put at x, y), size (pixels of em), colour and wrap width (0: none)
pub struct TextOp {
  pub text: String;
  pub x: f32;
  pub y: f32;
  pub ax: f32;
  pub ay: f32;
  pub size: f32;
  pub color: Color;
  pub maxWidth: f32;
  pub align: u32;
  pub outlineColor: Color;
  pub outlineWidth: f32;
}

pub struct Canvas {
  pub width: f32;
  pub height: f32;
  pub batch: Batch;
  pub texts: List[TextOp];
  pub tolerance: f32;                 // flattening, in pixels
  ctm: Mat2D;
  stack: List[Mat2D];

  pub fn make(width: f32, height: f32) Canvas {
    new Canvas(width, height, Batch.make(), List[TextOp].empty(), 0.1, Mat2D.identity(), List[Mat2D].empty())
  }

  pub fn clear(self: &mut) {
    batch.clear();
    texts.clear();
    ctm = Mat2D.identity();
    stack.clear();
  }

  pub fn resize(self: &mut, w: f32, h: f32) { width = w; height = h; }

  // ---- transform ----
  pub fn save(self: &mut) { stack.push(ctm); }
  pub fn restore(self: &mut) {
    if stack.len() > 0usize { ctm = *stack[stack.len() - 1usize]; stack.pop(); }
  }
  pub fn transform(self: &mut, m: Mat2D) { ctm = ctm.then(m); }
  pub fn translate(self: &mut, x: f32, y: f32) { ctm = ctm.then(Mat2D.translation(x, y)); }
  pub fn scale(self: &mut, x: f32, y: f32) { ctm = ctm.then(Mat2D.scaling(x, y)); }
  pub fn rotate(self: &mut, angle: f32) { ctm = ctm.then(Mat2D.rotation(angle)); }
  pub fn current(self: &) Mat2D { ctm }

  // The paint with its gradient points taken to pixel space
  fn paintPx(self: &, paint: &Paint) Paint {
    if paint.kind == PAINT_SOLID { return *paint; }
    Paint.linear(ctm.apply(paint.p0), paint.c0, ctm.apply(paint.p1), paint.c1)
  }

  // ---- fill ----
  pub fn fill(self: &mut, path: &VectorPath, paint: &Paint) {
    let pp = self.paintPx(paint);
    let contours = flatten(path, ctm, tolerance);
    var i = 0usize;
    while i < contours.len() {
      fillPolygon(&mut batch, &contours[i].pts, &pp);
      i = i + 1usize;
    }
  }

  // ---- stroke ----
  pub fn stroke(self: &mut, path: &VectorPath, paint: &Paint, style: &StrokeStyle) {
    self.strokeArrows(path, paint, style, &ArrowStyle.none(), &ArrowStyle.none());
  }

  // Stroke 'path'; each open subpath gets 'startArrow' at its first point and
  // 'endArrow' at its last, the line shortened to meet the head
  pub fn strokeArrows(self: &mut, path: &VectorPath, paint: &Paint, style: &StrokeStyle, startArrow: &ArrowStyle, endArrow: &ArrowStyle) {
    let pp = self.paintPx(paint);
    let scale = ctm.meanScale();
    let w = style.width * scale;
    let contours = flatten(path, ctm, tolerance);
    var ci = 0usize;
    while ci < contours.len() {
      var pts = List[Vec2].empty();
      var k = 0usize;
      while k < contours[ci].pts.len() { pts.push(*contours[ci].pts[k]); k = k + 1usize; }
      let closed = contours[ci].closed;
      var headA = List[Vec2].empty();
      var headB = List[Vec2].empty();
      if !closed && pts.len() >= 2usize {
        if endArrow.kind != ARROW_NONE {
          let tip = *pts[pts.len() - 1usize];
          let dir = trimEnd(&mut pts, endArrow.length * scale * retract(endArrow));
          headB = arrowHead(&mut batch, &pp, endArrow, tip, dir, scale, w);
        }
        if startArrow.kind != ARROW_NONE {
          reversePts(&mut pts);
          let tip = *pts[pts.len() - 1usize];
          let dir = trimEnd(&mut pts, startArrow.length * scale * retract(startArrow));
          headA = arrowHead(&mut batch, &pp, startArrow, tip, dir, scale, w);
          reversePts(&mut pts);
        }
      }
      if style.dashes.len() >= 2usize {
        var scaled = List[f32].empty();
        k = 0usize;
        while k < style.dashes.len() { scaled.push(*style.dashes[k] * scale); k = k + 1usize; }
        let pieces = dashPolyline(&pts, closed, &scaled, style.dashPhase * scale);
        k = 0usize;
        while k < pieces.len() {
          strokePolyline(&mut batch, pieces[k], false, w, style.cap, style.join, style.miterLimit, &pp);
          k = k + 1usize;
        }
      } else {
        strokePolyline(&mut batch, &pts, closed, w, style.cap, style.join, style.miterLimit, &pp);
      }
      drawHeadOutline(&mut batch, &headA, endArrowKind(startArrow), w, &pp, style);
      drawHeadOutline(&mut batch, &headB, endArrowKind(endArrow), w, &pp, style);
      ci = ci + 1usize;
    }
  }

  // ---- shapes ----
  pub fn fillRect(self: &mut, x: f32, y: f32, w: f32, h: f32, color: Color) {
    var p = VectorPath.make();
    p.rect(x, y, w, h);
    self.fill(&p, &Paint.solid(color));
  }

  pub fn fillRoundRect(self: &mut, x: f32, y: f32, w: f32, h: f32, r: f32, paint: &Paint) {
    var p = VectorPath.make();
    p.roundRect(x, y, w, h, r);
    self.fill(&p, paint);
  }

  pub fn strokeRoundRect(self: &mut, x: f32, y: f32, w: f32, h: f32, r: f32, paint: &Paint, style: &StrokeStyle) {
    var p = VectorPath.make();
    p.roundRect(x, y, w, h, r);
    self.stroke(&p, paint, style);
  }

  pub fn fillEllipse(self: &mut, cx: f32, cy: f32, rx: f32, ry: f32, paint: &Paint) {
    var p = VectorPath.make();
    p.ellipse(cx, cy, rx, ry);
    self.fill(&p, paint);
  }

  pub fn strokeEllipse(self: &mut, cx: f32, cy: f32, rx: f32, ry: f32, paint: &Paint, style: &StrokeStyle) {
    var p = VectorPath.make();
    p.ellipse(cx, cy, rx, ry);
    self.stroke(&p, paint, style);
  }

  pub fn line(self: &mut, x0: f32, y0: f32, x1: f32, y1: f32, paint: &Paint, style: &StrokeStyle) {
    var p = VectorPath.make();
    p.moveTo(x0, y0);
    p.lineTo(x1, y1);
    self.stroke(&p, paint, style);
  }

  // ---- text ----
  // Text with the point (ax, ay) of its block (fractions across and down) at (x, y)
  pub fn text(self: &mut, s: &str, x: f32, y: f32, ax: f32, ay: f32, size: f32, color: Color) {
    let p = ctm.apply(new Vec2(x, y));
    texts.push(new TextOp(String.from(s), p.x, p.y, ax, ay, size * ctm.meanScale(), color, 0., TEXT_LEFT,
      new Color(0., 0., 0., 0.), 0.));
  }

  pub fn textBlock(self: &mut, s: &str, x: f32, y: f32, ax: f32, ay: f32, size: f32, color: Color, maxWidth: f32, align: u32) {
    let p = ctm.apply(new Vec2(x, y));
    texts.push(new TextOp(String.from(s), p.x, p.y, ax, ay, size * ctm.meanScale(), color, maxWidth * ctm.meanScale(), align,
      new Color(0., 0., 0., 0.), 0.));
  }

  // The same with a coloured outline (a halo, so a label reads over lines)
  pub fn textHalo(self: &mut, s: &str, x: f32, y: f32, ax: f32, ay: f32, size: f32, color: Color, halo: Color, haloWidth: f32) {
    let p = ctm.apply(new Vec2(x, y));
    texts.push(new TextOp(String.from(s), p.x, p.y, ax, ay, size * ctm.meanScale(), color, 0., TEXT_LEFT, halo, haloWidth));
  }

  pub fn triangleCount(self: &) usize { batch.triangleCount() }
}

fn reversePts(pts: &mut List[Vec2]) {
  let n = pts.len();
  var i = 0usize;
  while i < n / 2usize {
    let a = *pts[i];
    let b = *pts[n - 1usize - i];
    pts.set(i, b);
    pts.set(n - 1usize - i, a);
    i = i + 1usize;
  }
}

fn endArrowKind(a: &ArrowStyle) u32 { a.kind }

// How far an arrow shortens its line, as a fraction of the head's length
fn retract(a: &ArrowStyle) f32 {
  if a.kind == ARROW_OPEN || a.kind == ARROW_BAR { return 0.; }
  if a.kind == ARROW_CIRCLE { return 1.; }
  1.
}

// Shortens the polyline's end by 'dist' (the line ends there, the arrow's tip is
// where it was); returns the unit direction of travel into the tip
fn trimEnd(pts: &mut List[Vec2], dist: f32) Vec2 {
  let last = *pts[pts.len() - 1usize];
  var dir = new Vec2(1., 0.);
  // direction: from the point at least a pixel back
  var k = pts.len() - 1usize;
  while k > 0usize {
    k = k - 1usize;
    let q = *pts[k];
    if q.distance(last) > 0.5 || k == 0usize { dir = (last - q).normalize(); break; }
  }
  var left = dist;
  while left > 0. && pts.len() > 2usize {
    let a = *pts[pts.len() - 2usize];
    let b = *pts[pts.len() - 1usize];
    let seg = a.distance(b);
    if seg <= left { left = left - seg; pts.pop(); } else { break; }
  }
  if left > 0. && pts.len() >= 2usize {
    let a = *pts[pts.len() - 2usize];
    let b = *pts[pts.len() - 1usize];
    let seg = a.distance(b);
    if seg > 0. {
      let t = minf(left, seg * 0.9) / seg;
      pts.pop();
      pts.push(b.lerp(a, t));
    }
  }
  dir
}

// The polygon of a head: points tip-first. Triangles and diamonds are filled
// here; the returned points are the outline (for the stroke around it).
fn arrowHead(batch: &mut Batch, paint: &Paint, a: &ArrowStyle, tip: Vec2, dir: Vec2, scale: f32, w: f32) List[Vec2] {
  var pts = List[Vec2].empty();
  let len = a.length * scale;
  let half = a.width * scale * 0.5;
  let side = dir.perp();
  let back = tip - dir * len;
  if a.kind == ARROW_TRIANGLE {
    pts.push(tip);
    pts.push(back + side * half);
    pts.push(back - side * half);
  } elif a.kind == ARROW_DIAMOND {
    pts.push(tip);
    pts.push(tip - dir * (len * 0.5) + side * half);
    pts.push(back);
    pts.push(tip - dir * (len * 0.5) - side * half);
  } elif a.kind == ARROW_CIRCLE {
    let c = tip - dir * (len * 0.5);
    var k = 0u32;
    while k < 24u32 {
      let t = V2_TWO_PI * f32.from(k) / 24.;
      pts.push(c + (dir * cos(t) + side * sin(t)) * (len * 0.5));
      k = k + 1u32;
    }
  } elif a.kind == ARROW_OPEN {
    pts.push(back + side * half);
    pts.push(tip);
    pts.push(back - side * half);
  } elif a.kind == ARROW_BAR {
    pts.push(tip + side * half);
    pts.push(tip - side * half);
  }
  if a.kind == ARROW_TRIANGLE || a.kind == ARROW_DIAMOND || a.kind == ARROW_CIRCLE {
    if a.filled { fillPolygon(batch, &pts, paint); }
    else { fillPolygon(batch, &pts, &Paint.solid(a.fill)); }
  }
  pts
}

fn drawHeadOutline(batch: &mut Batch, head: &List[Vec2], kind: u32, w: f32, paint: &Paint, style: &StrokeStyle) {
  if head.len() < 2usize { return; }
  let closedShape = kind == ARROW_TRIANGLE || kind == ARROW_DIAMOND || kind == ARROW_CIRCLE;
  strokePolyline(batch, head, closedShape, w, CAP_BUTT, JOIN_MITER, 4., paint);
}
