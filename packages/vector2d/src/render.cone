// ======== VectorRenderer: a canvas on the GPU ========
//
// One vertex buffer holds the canvas's triangles (converted to clip space as
// they are copied; 32 bytes a vertex) and one draw puts them on the target with
// vector2d.slang. Text is msdftext's: one overlay text a string, drawn after
// the vectors, so text is always above shapes (draw in layers, one canvas and one
// render each, when something must cover text). Anti-aliasing is the
// tessellator's edge coverage, so the target needs no multisampling.

const VERTEX_BYTES = 32u64;

pub struct VectorRenderer {
  shader ShaderModule;
  layout PipelineLayout;
  pub pipeline RenderPipeline;
  vbuf Buffer;
  capacity u64;                    // bytes
  pub text TextRenderer;
  handles List[TextHandle];
  format u32;
  pub triangles u32;               // the last render's
  pub texts u32;

  // A renderer for targets of 'format', drawing text from 'atlas'. Check 'isValid'.
  pub fn create(device &mut Device, atlas &Atlas, format u32) VectorRenderer {
    mut shader = device.createShaderModule(&VECTOR2D_SPIRV);
    mut layout = device.createEmptyPipelineLayout(0u32);
    imm attributes = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X2, 0u64, 0u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X2, 8u64, 1u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 16u64, 2u32)];
    imm buffers = [new VertexBufferLayout(arrayStride: VERTEX_BYTES, attributes: &attributes)];
    imm desc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, vertexEntryPoint: "vertexMain",
      buffers: &buffers, fragmentModule: &shader, fragmentEntryPoint: "fragmentMain", colorFormat: format,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    mut pipeline = device.createRenderPipeline(&desc);
    mut vbuf = device.createBuffer(VERTEX_BYTES * 3u64, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
    mut text = TextRenderer.create(device, atlas, format, format, TEXTURE_FORMAT_DEPTH32_FLOAT);
    new VectorRenderer(shader, layout, pipeline, vbuf, VERTEX_BYTES * 3u64, text, List[TextHandle].empty(), format, 0u32, 0u32);
  }

  pub fn isValid(self &) bool { pipeline.isValid() and text.isValid(); }

  // Record a pass drawing 'canvas' into 'target' (kept as it is: clear it first,
  // or pass 'clear' to start from that colour)
  pub fn render(self &mut, device &mut Device, encoder &mut CommandEncoder, target &Texture, canvas &Canvas,
      font &Font, atlas &mut Atlas, clear bool, clearColor Color) {
    imm nverts = canvas.batch.vertexCount();
    triangles = u32.from(nverts / 3usize);
    // The texts first: layout may add glyphs to the atlas
    texts = u32.from(canvas.texts.len());
    mut i = 0usize;
    while i < canvas.texts.len() {
      if i >= handles.len() { handles.push(text.addText(device, SPACE_OVERLAY)); }
      imm op = canvas.texts[i];
      mut opts = LayoutOptions.make(op.size);
      opts.maxWidth = op.maxWidth;
      opts.align = op.align;
      imm layout = layoutText(font, atlas, op.text.view(), &opts);
      mut style = TextStyle.plain(op.color);
      if op.outlineWidth > 0. { style.outlineColor = op.outlineColor; style.outlineWidth = op.outlineWidth; }
      imm x0 = op.x - op.ax * layout.width;
      imm y0 = op.y - op.ay * layout.height;
      text.set(device, *handles[i], &layout, &style, overlayTransform(canvas.width, canvas.height, x0, y0));
      i = i + 1usize;
    }
    while i < handles.len() { text.clearText(*handles[i]); i = i + 1usize; }
    text.syncAtlas(device, atlas);

    if nverts > 0usize {
      imm need = u64.from(nverts) * VERTEX_BYTES;
      if need > capacity {
        device.queue.releaseBuffer(&mut vbuf);
        capacity = need * 2u64;
        vbuf = device.createBuffer(capacity, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
      }
      mut data = List[f32].withCapacity(canvas.batch.verts.len());
      imm sx = 2. / canvas.width;
      imm sy = 2. / canvas.height;
      mut v = 0usize;
      while v < nverts {
        imm b = v * VERTEX_FLOATS;
        data.push(*canvas.batch.verts[b] * sx - 1.);
        data.push(1. - *canvas.batch.verts[b + 1usize] * sy);
        mut k = 2usize;
        while k < VERTEX_FLOATS { data.push(*canvas.batch.verts[b + k]); k = k + 1usize; }
        v = v + 1usize;
      }
      imm raw *f32 = data.view() as *f32;
      device.queue.writeBuffer(&vbuf, 0u64, raw as *u8, need);
    }
    imm op = if clear { LOAD_OP_CLEAR; } else { LOAD_OP_LOAD; };
    imm color = new RenderPassColorAttachment(view: target.createView(), loadOp: op, clearValue: clearColor);
    mut pass = encoder.beginRenderPass(&color);
    if nverts > 0usize {
      pass.setPipeline(&pipeline);
      pass.setVertexBuffer(0u32, &vbuf, 0u64);
      pass.draw(u32.from(nverts), 1u32, 0u32, 0u32);
    }
    pass.end();
    text.renderOverlay(encoder, target);
  }
}

// The size a string takes at 'size' pixels of em (wrapped at maxWidth if it is above 0)
pub fn measureText(font &Font, atlas &mut Atlas, s &Array[u8], size f32, maxWidth f32) Vec2 {
  mut opts = LayoutOptions.make(size);
  opts.maxWidth = maxWidth;
  imm layout = layoutText(font, atlas, s, &opts);
  new Vec2(layout.width, layout.height);
}

