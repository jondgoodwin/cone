// ======== Batch and Paint: the triangles a canvas makes ========
//
// The renderer draws one thing: triangles whose vertices carry a pixel
// position, a pair of EDGE COVERAGES and a colour. The fragment shader draws
// colour * (cx * cy): both are 1 inside a shape and fall linearly to 0 across
// a one-pixel fringe at its edges (cx across a stroke, cy along it; a fill uses
// cx only). A fringe centred on the true edge, linearly interpolated by the
// rasteriser, gives the pixel the area of the shape that covers it, to within
// the error of a linear ramp: this is analytic edge coverage, with no
// multisampling. A vertex is 8 floats: x, y, cx, cy, r, g, b, a.

pub const VERTEX_FLOATS = 8usize;

pub const PAINT_SOLID = 0u32;
pub const PAINT_LINEAR = 1u32;

// What a shape is filled with: one colour, or a linear gradient between two
// colours along the line p0 to p1 (held at the ends). The colour is worked out
// at each triangle corner and interpolated, which is exact for a linear
// gradient. Points are in the canvas's pixel space.
pub struct Paint {
  pub kind: u32;
  pub c0: Color;
  pub c1: Color;
  pub p0: Vec2;
  pub p1: Vec2;

  pub fn solid(c: Color) Paint { new Paint(PAINT_SOLID, c, c, new Vec2(0., 0.), new Vec2(1., 0.)) }
  pub fn linear(p0: Vec2, c0: Color, p1: Vec2, c1: Color) Paint { new Paint(PAINT_LINEAR, c0, c1, p0, p1) }

  pub fn at(self, p: Vec2) Color {
    if kind == PAINT_SOLID { return c0; }
    let d = p1 - p0;
    let len2 = d.lengthSquared();
    var t = 0.0f;
    if len2 > 0. { t = clampf((p - p0).dot(d) / len2, 0., 1.); }
    new Color(c0.red + (c1.red - c0.red) * t, c0.green + (c1.green - c0.green) * t,
      c0.blue + (c1.blue - c0.blue) * t, c0.alpha + (c1.alpha - c0.alpha) * t)
  }
}

pub struct Batch {
  pub verts: List[f32];

  pub fn make() Batch { new Batch(List[f32].empty()) }
  pub fn clear(self: &mut) { verts.clear(); }
  pub fn vertexCount(self: &) usize { verts.len() / VERTEX_FLOATS }
  pub fn triangleCount(self: &) usize { verts.len() / (VERTEX_FLOATS * 3usize) }

  pub fn emit(self: &mut, p: Vec2, cv: Vec2, c: Color) {
    verts.push(p.x);
    verts.push(p.y);
    verts.push(cv.x);
    verts.push(cv.y);
    verts.push(c.red);
    verts.push(c.green);
    verts.push(c.blue);
    verts.push(c.alpha);
  }

  // One triangle; each corner has its position, coverage pair and paint colour
  pub fn tri(self: &mut, paint: &Paint, fade: f32, p0: Vec2, v0: Vec2, p1: Vec2, v1: Vec2, p2: Vec2, v2: Vec2) {
    self.emit(p0, v0, fadeColor(paint.at(p0), fade));
    self.emit(p1, v1, fadeColor(paint.at(p1), fade));
    self.emit(p2, v2, fadeColor(paint.at(p2), fade));
  }

  // A quad p0 p1 p2 p3 as two triangles
  pub fn quad(self: &mut, paint: &Paint, fade: f32, p0: Vec2, v0: Vec2, p1: Vec2, v1: Vec2, p2: Vec2, v2: Vec2, p3: Vec2, v3: Vec2) {
    self.tri(paint, fade, p0, v0, p1, v1, p2, v2);
    self.tri(paint, fade, p0, v0, p2, v2, p3, v3);
  }
}

fn fadeColor(c: Color, fade: f32) Color { new Color(c.red, c.green, c.blue, c.alpha * fade) }

// The stroke's line ends
pub const CAP_BUTT = 0u32;
pub const CAP_SQUARE = 1u32;
pub const CAP_ROUND = 2u32;
// Where two segments meet
pub const JOIN_MITER = 0u32;
pub const JOIN_BEVEL = 1u32;
pub const JOIN_ROUND = 2u32;

// How a path is stroked. Width is in canvas units (scaled by the transform's
// mean scale); a dash pattern alternates dash and gap lengths, starting 'dashPhase'
// into it; an empty pattern is a solid line.
pub struct StrokeStyle {
  pub width: f32;
  pub cap: u32;
  pub join: u32;
  pub miterLimit: f32;
  pub dashes: List[f32];
  pub dashPhase: f32;

  pub fn make(width: f32) StrokeStyle { new StrokeStyle(width, CAP_BUTT, JOIN_MITER, 4., List[f32].empty(), 0.) }
  pub fn dashed(width: f32, dash: f32, gap: f32) StrokeStyle {
    var s = StrokeStyle.make(width);
    s.dashes.push(dash);
    s.dashes.push(gap);
    s
  }
}

// Arrowhead kinds
pub const ARROW_NONE = 0u32;
pub const ARROW_TRIANGLE = 1u32;     // a solid (or hollow) triangle
pub const ARROW_OPEN = 2u32;         // a vee of two strokes
pub const ARROW_DIAMOND = 3u32;      // UML composition and aggregation
pub const ARROW_CIRCLE = 4u32;
pub const ARROW_BAR = 5u32;          // a bar across the line

// An arrowhead at a line's end: 'length' along the line, 'width' across, in
// canvas units. The head is filled with 'fill' (give the background's colour
// for a hollow head) and outlined in the line's paint.
pub struct ArrowStyle {
  pub kind: u32;
  pub length: f32;
  pub width: f32;
  pub filled: bool;                 // filled with the line's paint; else with 'fill'
  pub fill: Color;

  pub fn none() ArrowStyle { new ArrowStyle(ARROW_NONE, 0., 0., true, new Color(0., 0., 0., 0.)) }
  pub fn make(kind: u32, length: f32, width: f32) ArrowStyle { new ArrowStyle(kind, length, width, true, new Color(0., 0., 0., 0.)) }
  pub fn hollow(kind: u32, length: f32, width: f32, fill: Color) ArrowStyle { new ArrowStyle(kind, length, width, false, fill) }
}
