// ======== Filling: a polygon to triangles ========
//
// The interior is triangulated (a fan for a convex outline; ear clipping, mesh's
// 'triangulatePolygon', for a concave one) with every corner moved half a
// pixel inward along its miter, and a fringe of quads joins that ring to one
// half a pixel outside the outline, coverage 1 falling to 0: the shape's
// edge is the middle of the ramp. Method: CPU triangulation with analytic edge
// coverage (NanoVG's fill, Skia's AA fringe).
// Limits: each outline is filled on its own (no holes: a ring is a thick
// stroked circle, or two fills), and an outline that crosses itself is
// triangulated as if it did not (overlaps of the even-odd kind are not cut out).

fn signedArea2(pts: &List[Vec2]) f32 {
  var s = 0.0f;
  let n = pts.len();
  var i = 0usize;
  while i < n {
    let a = *pts[i];
    let b = *pts[(i + 1usize) % n];
    s = s + (a.x * b.y - b.x * a.y);
    i = i + 1usize;
  }
  s
}

fn isConvex(pts: &List[Vec2]) bool {
  let n = pts.len();
  var sign = 0.0f;
  var i = 0usize;
  while i < n {
    let a = *pts[i];
    let b = *pts[(i + 1usize) % n];
    let c = *pts[(i + 2usize) % n];
    let cr = (b - a).cross(c - b);
    if absf(cr) > 0.0001 {
      if sign == 0. { sign = cr; }
      else if sign * cr < 0. { return false; }
    }
    i = i + 1usize;
  }
  true
}

// Fills the closed outline 'pts' (pixel space)
pub fn fillPolygon(batch: &mut Batch, pts: &List[Vec2], paint: &Paint) {
  let n = pts.len();
  if n < 3usize { return; }
  let area = signedArea2(pts);
  if absf(area) < 0.0001 { return; }
  // Inward normal of an edge: the left of a counterclockwise outline
  let orient = if area > 0. { 1.0f } else { -1.0f };
  // Smallest extent, to keep tiny shapes from inverting
  var lo = *pts[0usize];
  var hi = *pts[0usize];
  var i = 1usize;
  while i < n { lo = lo.min(*pts[i]); hi = hi.max(*pts[i]); i = i + 1usize; }
  let extent = minf(hi.x - lo.x, hi.y - lo.y);
  let dist = minf(0.5, extent * 0.3);

  var inner = List[Vec2].withCapacity(n);
  var outer = List[Vec2].withCapacity(n);
  i = 0usize;
  while i < n {
    let prev = *pts[(i + n - 1usize) % n];
    let p = *pts[i];
    let next = *pts[(i + 1usize) % n];
    let n0 = (p - prev).normalize().perp() * orient;
    let n1 = (next - p).normalize().perp() * orient;
    let denom = 1. + n0.dot(n1);
    var off = Vec2(0., 0.);
    if denom > 0.0001 {
      off = (n0 + n1) * (1. / denom);
      let len = off.length();
      if len > 4. { off = off * (4. / len); }
    } else {
      off = n0;
    }
    inner.push(p + off * dist);
    outer.push(p - off * dist);
    i = i + 1usize;
  }
  let one = Vec2(1., 1.);
  let zero = Vec2(0., 1.);
  // Interior
  if isConvex(pts) {
    i = 1usize;
    while i + 1usize < n {
      batch.tri(paint, 1., *inner[0usize], one, *inner[i], one, *inner[i + 1usize], one);
      i = i + 1usize;
    }
  } else {
    let idx = triangulatePolygon(pts.view());
    i = 0usize;
    while i + 2usize < idx.len() {
      let a = usize.from(*idx[i]);
      let b = usize.from(*idx[i + 1usize]);
      let c = usize.from(*idx[i + 2usize]);
      batch.tri(paint, 1., *inner[a], one, *inner[b], one, *inner[c], one);
      i = i + 3usize;
    }
  }
  // Fringe
  i = 0usize;
  while i < n {
    let j = (i + 1usize) % n;
    batch.quad(paint, 1., *inner[i], one, *inner[j], one, *outer[j], zero, *outer[i], zero);
    i = i + 1usize;
  }
}
