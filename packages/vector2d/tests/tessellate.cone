// The vector2d tessellator, checked on the CPU against areas and lengths worked
// out by hand. A triangle whose corners carry the edge coverages f (across) and
// g (along) and whose area is A has, over it, the integral of f*g equal to
// A/12 * (sum f_i g_i + (sum f_i)(sum g_i)). The integral of coverage over the
// whole batch is then the shape's drawn area in pixels, which must equal the
// true area: the fringe is centred on the edge.
//
// - a 100 x 50 filled rectangle: 5000; a circle of radius 30: pi r^2 (flattening
//   to 0.1 px loses under 0.1%); a rounded rectangle 120 x 60, radius 15:
//   7200 - (4 - pi) 225; a concave L-shape of 60 x 60 less a 30 x 30 corner: 2700.
// - strokes: a line of length 100, width 4: 400 with butt caps; with square caps
//   (100 + 4) * 4 = 416; with round caps 400 + pi 2^2; an L of two 50-long arms
//   width 4 with a miter join covers (50 + 2) * 4 * 2 - 2 * 2 ... counted below.
// - dashes: a 100-long line in 10-on, 5-off covers 7 dashes of which the last is
//   cut to 5: 65 long.
// - a quadratic Bezier is flattened to within its tolerance of the curve.
// - a gradient fill: the colour at the two ends and the middle.
// - arrowheads: a solid triangle head of length 20, width 12 is 120 square pixels.

mod tessellate;

import testing use *;
import collections use *;
import geomath use *;
import vector2d use *;


fn integral(b: &Batch) f64 {
  var sum = 0.0;
  let n = b.triangleCount();
  var t = 0usize;
  while t < n {
    var px = Array[f32, 3]() <- fill 0f;
    var py = Array[f32, 3]() <- fill 0f;
    var f = Array[f32, 3]() <- fill 0f;
    var g = Array[f32, 3]() <- fill 0f;
    var k = 0usize;
    while k < 3usize {
      let base = (t * 3usize + k) * VERTEX_FLOATS;
      px[k] = *b.verts[base];
      py[k] = *b.verts[base + 1usize];
      f[k] = *b.verts[base + 2usize];
      g[k] = *b.verts[base + 3usize];
      k = k + 1usize;
    }
    let area = f64.from((px[1] - px[0]) * (py[2] - py[0]) - (px[2] - px[0]) * (py[1] - py[0])) * 0.5;
    var fg = 0.0;
    var sf = 0.0;
    var sg = 0.0;
    k = 0usize;
    while k < 3usize {
      fg = fg + f64.from(f[k] * g[k]);
      sf = sf + f64.from(f[k]);
      sg = sg + f64.from(g[k]);
      k = k + 1usize;
    }
    let a = if area < 0.0 { -area } else { area };
    sum = sum + a / 12.0 * (fg + sf * sg);
    t = t + 1usize;
  }
  sum
}

fn near(got: f64, want: f64, rel: f64, label: &Array[u8]) {
  expectFloat(got, want, rel * want, label);
}

fn white() Paint { Paint.solid(Color(1., 1., 1., 1.)) }

fn fills() {
  var c = Canvas.make(400., 300.);
  var p = VectorPath.make();
  p.rect(10., 10., 100., 50.);
  c.fill(&p, &white());
  near(integral(&c.batch), 5000.0, 0.003, "rectangle 100 x 50");

  c.clear();
  var q = VectorPath.make();
  q.circle(100., 100., 30.);
  c.fill(&q, &white());
  near(integral(&c.batch), 3.14159265 * 900.0, 0.01, "circle radius 30");

  c.clear();
  var r = VectorPath.make();
  r.roundRect(20., 20., 120., 60., 15.);
  c.fill(&r, &white());
  near(integral(&c.batch), 7200.0 - (4.0 - 3.14159265) * 225.0, 0.006, "rounded rectangle");

  c.clear();
  var l = VectorPath.make();
  l.moveTo(0., 0.);
  l.lineTo(60., 0.);
  l.lineTo(60., 30.);
  l.lineTo(30., 30.);
  l.lineTo(30., 60.);
  l.lineTo(0., 60.);
  l.close();
  c.fill(&l, &white());
  near(integral(&c.batch), 2700.0, 0.01, "concave L (ear clipped)");

  // Transform: the same rectangle scaled 2 and turned a quarter keeps its area x4
  c.clear();
  c.save();
  c.translate(100., 100.);
  c.rotate(1.5707964);
  c.scale(2., 2.);
  var s = VectorPath.make();
  s.rect(0., 0., 10., 5.);
  c.fill(&s, &white());
  c.restore();
  near(integral(&c.batch), 200.0, 0.01, "scaled and turned rectangle");
}

fn lineLength(cap: u32, join: u32) f64 {
  var c = Canvas.make(400., 300.);
  var st = StrokeStyle.make(4.);
  st.cap = cap;
  st.join = join;
  c.line(50., 50., 150., 50., &white(), &st);
  integral(&c.batch)
}

fn strokes() {
  near(lineLength(CAP_BUTT, JOIN_MITER), 400.0, 0.004, "butt line 100 x 4");
  near(lineLength(CAP_SQUARE, JOIN_MITER), 416.0, 0.004, "square caps add width/2 each end");
  near(lineLength(CAP_ROUND, JOIN_MITER), 400.0 + 3.14159265 * 4.0, 0.01, "round caps add a disc");

  // An L of two 50 arms, width 4, miter join: the two bars overlap in a 2 x 2 corner
  // the miter fills: area = 50*4 + 50*4 + the outer corner square 2 x 2 (the bars,
  // each 50 long from the vertex, leave the corner out)
  var c = Canvas.make(400., 300.);
  var p = VectorPath.make();
  p.moveTo(50., 50.);
  p.lineTo(100., 50.);
  p.lineTo(100., 100.);
  var st = StrokeStyle.make(4.);
  c.stroke(&p, &white(), &st);
  near(integral(&c.batch), 4.0 * 100.0 + 4.0, 0.01, "L stroke with a miter join: 2 arms plus the 2 x 2 corner");

  // Bevel: the corner square is cut by its diagonal, half of it (2) is added
  var c2 = Canvas.make(400., 300.);
  st.join = JOIN_BEVEL;
  c2.stroke(&p, &white(), &st);
  near(integral(&c2.batch), 400.0 + 2.0, 0.012, "bevel join adds half the corner square");

  // Round: a quarter disc of radius 2 (pi)
  var c3 = Canvas.make(400., 300.);
  st.join = JOIN_ROUND;
  c3.stroke(&p, &white(), &st);
  near(integral(&c3.batch), 400.0 + 3.14159265, 0.012, "round join adds a quarter disc");

  // A closed square 40 x 40 with width 2: outer 42^2 - inner 38^2 = 320
  var c4 = Canvas.make(400., 300.);
  var sq = VectorPath.make();
  sq.rect(10., 10., 40., 40.);
  var st2 = StrokeStyle.make(2.);
  c4.stroke(&sq, &white(), &st2);
  // (the segments' fringes overlap inside each of the four inner corners, which the sum counts twice: ~1.4% over, where blending would not)
  near(integral(&c4.batch), 320.0, 0.02, "closed square ring");

  // Thin line: 0.5 wide, 100 long, is drawn 1 wide at half alpha: 50 of alpha-weighted coverage
  var c5 = Canvas.make(400., 300.);
  var st3 = StrokeStyle.make(0.5);
  c5.line(10., 10., 110., 10., &white(), &st3);
  // alpha is in the colour, not the coverage: check the vertices carry alpha 0.5
  expectFloat(f64.from(*c5.batch.verts[7usize]), 0.5, 0.001, "a thin line carries alpha = width");
}

fn dashes() {
  var c = Canvas.make(400., 300.);
  var st = StrokeStyle.dashed(4., 10., 5.);
  c.line(10., 10., 110., 10., &white(), &st);
  // dashes at 0-10, 15-25, ..., 90-100; the 7th is 90-100 (full), the line is 100: seven dashes of 10 = 70? 0,15,30,45,60,75,90 -> 7 dashes, the last ends at 100
  near(integral(&c.batch), 4.0 * 70.0, 0.01, "7 dashes of 10 in a 100 line, width 4");
  // A phase of 5 starts halfway through the first dash: 5 + 10*6 + (90..100 is dash 7 from 85..95 -> 5 left)
  var c2 = Canvas.make(400., 300.);
  st.dashPhase = 5.;
  c2.line(10., 10., 110., 10., &white(), &st);
  // pattern starting 5 into the dash: on 0-5, off 5-10, on 10-20, ..., dashes at 10+15k: 10-20,25-35,...,85-95 (6 full) plus 0-5 and 100-?
  // on 0-5 (5), on 10-20 ... 85-95 (6 full = 60), 100 is the end: 5 + 60 = 65 plus nothing
  near(integral(&c2.batch), 4.0 * 65.0, 0.012, "phase 5 starts mid-dash");
}

fn curves() {
  // A quadratic from (0,0) via (50,100) to (100,0): its length by integration 147.89...; the
  // flattened polyline must be within tolerance of the curve at the middle: (50, 50)
  var p = VectorPath.make();
  p.moveTo(0., 0.);
  p.quadTo(50., 100., 100., 0.);
  let cs = flatten(&p, Mat2D.identity(), 0.1);
  expectInt(i64.from(cs.len()), 1i64, "one contour");
  let pts = &cs[0usize].pts;
  expect(pts.len() > 8usize, "a bow is cut into several segments");
  // Every vertex lies on the curve: y = 100 x (100 - x) / 2500 ... (x, y) with x = 100t, y = 100 * 2t(1-t)
  var worst = 0.0f;
  var i = 0usize;
  while i < pts.len() {
    let q = *pts[i];
    let t = q.x / 100.;
    let want = 200. * t * (1. - t);
    let d = (q.y - want).abs();
    if d > worst { worst = d; }
    i = i + 1usize;
  }
  expectFloat(f64.from(worst), 0.0, 0.0001, "flattened points lie on the curve");
  // chord sag: between consecutive points the curve is within 0.1 of the chord
  var sag = 0.0f;
  i = 1usize;
  while i < pts.len() {
    let a = *pts[i - 1usize];
    let b = *pts[i];
    let mid = a.lerp(b, 0.5);
    let tm = mid.x / 100.;
    let cy = 200. * tm * (1. - tm);
    let dd = (mid.y - cy).abs();
    if dd > sag { sag = dd; }
    i = i + 1usize;
  }
  expect(sag < 0.11, "chords within the 0.1 pixel tolerance");
  // A quarter arc of a circle is a cubic whose midpoint is at radius r within 0.03%
  var a = VectorPath.make();
  a.arc(0., 0., 100., 0., 1.5707964);
  let ac = flatten(&a, Mat2D.identity(), 0.05);
  var worstR = 0.0f;
  i = 0usize;
  while i < ac[0usize].pts.len() {
    let q = *ac[0usize].pts[i];
    let dr = (q.length() - 100.).abs();
    if dr > worstR { worstR = dr; }
    i = i + 1usize;
  }
  expect(worstR < 0.05, "an arc's points are within 0.05 of the circle");
}

fn paints() {
  let g = Paint.linear(Vec2(0., 0.), Color(1., 0., 0., 1.), Vec2(100., 0.), Color(0., 0., 1., 1.));
  expectFloat(f64.from(g.at(Vec2(-5., 3.)).red), 1.0, 0.0001, "before the start: first colour");
  expectFloat(f64.from(g.at(Vec2(50., 3.)).red), 0.5, 0.0001, "middle: half red");
  expectFloat(f64.from(g.at(Vec2(50., 3.)).blue), 0.5, 0.0001, "middle: half blue");
  expectFloat(f64.from(g.at(Vec2(200., 3.)).blue), 1.0, 0.0001, "past the end: last colour");
}

fn arrows() {
  var c = Canvas.make(400., 300.);
  var p = VectorPath.make();
  p.moveTo(10., 100.);
  p.lineTo(200., 100.);
  var st = StrokeStyle.make(1.);
  c.strokeArrows(&p, &white(), &st, &ArrowStyle.none(), &ArrowStyle.make(ARROW_TRIANGLE, 20., 12.));
  let total = integral(&c.batch);
  // The line, trimmed by the head's length: 170 long x 1 wide = 170. The head: the filled triangle
  // 20 x 12 / 2 = 120, and its outline stroked 1 wide: 2 sqrt(20^2 + 6^2) + 12 = 53.77 long
  expectFloat(total, 170.0 + 120.0 + 53.77, 6.0, "line trimmed to meet the head (170) + head (120) + its outline (53.8)");
}

fn main() i32 {
  fills();
  strokes();
  dashes();
  curves();
  paints();
  arrows();
  done()
}
