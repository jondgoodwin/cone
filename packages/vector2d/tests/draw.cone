// Vector shapes drawn on a real GPU with no window, read back and measured
// against geometry worked out by hand (white on black, red channel = coverage).
// GPU_POWER_PREFERENCE=low-power tests the integrated GPU; VECTOR2D_SHOTS=<folder>
// writes each frame as a .bmp. Needs a driver with Vulkan 1.3 and SDL3.dll.
//
// 1. A rectangle with its corner at (10.5, 10.25): the pixel (10, 20) is covered
//    across half its width (0.5), the pixel (10, 10) by 0.5 x 0.75 = 0.375, the
//    pixel (30, 10) by 0.75 along its top edge, the interior is 1 and the outside 0.
// 2. A circle of radius 40 has, summed over the pixels, area pi r^2 within 1%.
// 3. A diagonal line (not axis aligned) 3 wide and 100 long: the sum is 300 within 2%.
// 4. A 50% white rectangle over a 100% grey (0.4) one: 0.4 + 0.5 (1 - 0.4) = 0.7.
// 5. A stroked circle's ring, dashes and an arrow head draw something (non-zero
//    ink) and nothing outside their bounds.
// 6. Text: a label drawn over the vectors puts ink in its box and none outside it.
// 7. Thirty-two thousand triangles (a hair-line fan) render, and the draw count is one.

mod draw;

import testing use *;
import libc;
import stdio use *;
import fs;
import path use Path;
import collections use *;
import geomath use *;
import gpu use *;
import msdftext use *;
import vector2d use *;

const W = 400u32;
const H = 300u32;

fn cov(p: *u8, x: u32, y: u32) f64 {
  if x >= W || y >= H { return 0.0; }
  f64.from(*(p + usize.from((y * W + x) * 4u32))) / 255.0
}

fn sumArea(p: *u8) f64 {
  var s = 0.0;
  var y = 0u32;
  while y < H {
    var x = 0u32;
    while x < W { s = s + cov(p, x, y); x = x + 1u32; }
    y = y + 1u32;
  }
  s
}

fn shot(p: *u8, name: &str) {
  let env = libc.getenv("VECTOR2D_SHOTS");
  if (env as usize) == 0usize { return; }
  var file = String.fromCStr(cstr.fromPtr(env));
  file.append(name);
  let rowBytes = W * 3u32;
  let pad = (4u32 - rowBytes % 4u32) % 4u32;
  let size = 54u32 + (rowBytes + pad) * H;
  var b = List[u8].withCapacity(usize.from(size));
  b.push('B');
  b.push('M');
  var words = Array[u32, 13]() <- fill 0u32;
  words[0] = size;
  words[2] = 54u32;
  words[3] = 40u32;
  words[4] = W;
  words[5] = H;
  words[6] = 0x00180001u32;
  var w = 0usize;
  while w < 13usize {
    b.push(u8.from(words[w] & 255u32));
    b.push(u8.from((words[w] >> 8u32) & 255u32));
    b.push(u8.from((words[w] >> 16u32) & 255u32));
    b.push(u8.from((words[w] >> 24u32) & 255u32));
    w = w + 1usize;
  }
  var y = H;
  while y > 0u32 {
    y = y - 1u32;
    var x = 0u32;
    while x < W {
      let at = p + usize.from((y * W + x) * 4u32);
      b.push(*(at + 2usize));
      b.push(*(at + 1usize));
      b.push(*at);
      x = x + 1u32;
    }
    var q = 0u32;
    while q < pad { b.push(0u8); q = q + 1u32; }
  }
  let out = Path.fromLiteral(file.view());
  fs.writeFile(&out, b.view());
}

// The device is the last field: fields are dropped first to last, and everything made from the device goes before it
struct Rig {
  target: Texture;
  readback: Buffer;
  renderer: VectorRenderer;
  atlas: Atlas;
  device: Device;
}

fn render(rig: &mut Rig, canvas: &Canvas, font: &Font, name: &str) *u8 {
  var encoder = rig.device.createCommandEncoder();
  rig.renderer.render(&mut rig.device, &mut encoder, &rig.target, canvas, font, &mut rig.atlas, true, Color(0., 0., 0., 1.));
  encoder.copyTextureToBuffer(&rig.target, &rig.readback);
  rig.device.queue.submit(encoder.finish());
  rig.device.endFrame();
  rig.device.waitIdle();
  let p = rig.readback.mappedRange();
  shot(p, name);
  p
}

fn white() Paint { Paint.solid(Color(1., 1., 1., 1.)) }

fn run(font: &Font) {
  var instance = Instance.create("vector2d test");
  var none = Surface.none();
  var preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  var adapter = instance.requestAdapter(&none, preference);
  var device = adapter.requestDevice();
  if !device.isValid() { print <- "no usable GPU\n"; return; }
  let targetDesc = TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var target = device.createTexture(&targetDesc);
  var readback = device.createBuffer(u64.from(W * H * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var atlas = Atlas.create(AtlasConfig.standard());
  var renderer = VectorRenderer.create(&mut device, &atlas, TEXTURE_FORMAT_RGBA8_UNORM);
  require(renderer.isValid(), "the renderer's pipelines are valid");
  var rig = Rig(target, readback, renderer, atlas, device);

  // 1. Edge coverage
  var c = Canvas.make(f32.from(W), f32.from(H));
  var p = VectorPath.make();
  p.rect(10.5, 10.25, 50., 30.5);
  c.fill(&p, &white());
  let px = render(&mut rig, &c, font, "rect.bmp");
  expectFloat(cov(px, 10u32, 20u32), 0.5, 0.04, "left edge pixel is half covered");
  // A fill's corner pixel gets the larger of its two edges' coverage (0.75 x 0.5 would be 0.375): between the two
  expect(cov(px, 10u32, 10u32) > 0.36 && cov(px, 10u32, 10u32) < 0.55, "corner pixel is between the product (0.375) and the larger edge (0.5)");
  expectFloat(cov(px, 30u32, 10u32), 0.75, 0.04, "top edge pixel is three quarters covered");
  expectFloat(cov(px, 30u32, 25u32), 1.0, 0.01, "interior");
  expectFloat(cov(px, 5u32, 25u32), 0.0, 0.01, "outside");
  expectFloat(cov(px, 61u32, 25u32), 0.0, 0.02, "right of the right edge (60.5): pixel 60 is half, 61 none");
  expectFloat(cov(px, 60u32, 25u32), 0.5, 0.04, "right edge pixel is half covered");

  // 2. Circle
  c.clear();
  var q = VectorPath.make();
  q.circle(200., 150., 40.);
  c.fill(&q, &white());
  let pc = render(&mut rig, &c, font, "circle.bmp");
  expectFloat(sumArea(pc), 3.14159265 * 1600.0, 50.27, "circle area within 1%");

  // 3. Diagonal line
  c.clear();
  var st = StrokeStyle.make(3.);
  c.line(50., 50., 120.71, 120.71, &white(), &st);
  let pl = render(&mut rig, &c, font, "diagonal.bmp");
  expectFloat(sumArea(pl), 300.0, 6.0, "diagonal 100 x 3 line, area within 2%");

  // 4. Blending
  c.clear();
  c.fillRect(20., 20., 100., 100., Color(0.4, 0.4, 0.4, 1.));
  c.fillRect(60., 60., 100., 100., Color(1., 1., 1., 0.5));
  let pb = render(&mut rig, &c, font, "blend.bmp");
  expectFloat(cov(pb, 90u32, 90u32), 0.7, 0.02, "50% white over 0.4 grey");
  expectFloat(cov(pb, 40u32, 40u32), 0.4, 0.01, "grey alone");
  expectFloat(cov(pb, 140u32, 140u32), 0.5, 0.02, "50% white over black");

  // 5. Ring, dashes, arrow
  c.clear();
  var ring = VectorPath.make();
  ring.circle(100., 100., 60.);
  c.stroke(&ring, &white(), &StrokeStyle.make(6.));
  var dashed = VectorPath.make();
  dashed.moveTo(200., 50.);
  dashed.cubicTo(250., 50., 300., 150., 350., 150.);
  c.strokeArrows(&dashed, &white(), &StrokeStyle.dashed(3., 12., 6.), &ArrowStyle.none(), &ArrowStyle.make(ARROW_TRIANGLE, 18., 12.));
  let pr = render(&mut rig, &c, font, "ring.bmp");
  let ink = sumArea(pr);
  // ring: 2 pi 60 x 6 = 2262; the dashed curve ~ 170 long, two thirds on, 3 wide ~ 340 plus the head ~108
  expect(ink > 2262.0 + 300.0 && ink < 2262.0 + 700.0, "ring, dashed curve and head put ink down");
  expectFloat(cov(pr, 100u32, 40u32), 1.0, 0.02, "ring's top (y = 40, 6 wide) is solid");
  expectFloat(cov(pr, 100u32, 100u32), 0.0, 0.01, "the ring is empty inside");

  // 6. Text
  c.clear();
  c.fillRect(0., 0., 400., 300., Color(0., 0., 0., 1.));
  c.text("Diagram", 200., 150., 0.5, 0.5, 32., Color(1., 1., 1., 1.));
  let pt = render(&mut rig, &c, font, "text.bmp");
  var inside = 0.0;
  var outside = 0.0;
  var y = 0u32;
  while y < H {
    var x = 0u32;
    while x < W {
      let v = cov(pt, x, y);
      if x >= 90u32 && x < 310u32 && y >= 120u32 && y < 180u32 { inside = inside + v; } else { outside = outside + v; }
      x = x + 1u32;
    }
    y = y + 1u32;
  }
  expect(inside > 200.0, "text leaves ink in its box");
  expectFloat(outside, 0.0, 0.5, "and none outside it");

  // 7. Many triangles
  c.clear();
  var k = 0u32;
  while k < 4000u32 {
    let a = f32.from(k) * 0.00157;
    c.line(200., 150., 200. + 140. * cos(a), 150. + 140. * sin(a), &white(), &StrokeStyle.make(1.));
    k = k + 1u32;
  }
  let pm = render(&mut rig, &c, font, "fan.bmp");
  print <- "a fan of 4000 lines is ", u64.from(rig.renderer.triangles), " triangles\n";
  expect(rig.renderer.triangles > 30000u32, "tens of thousands of triangles drawn");
  expect(sumArea(pm) > 1000.0, "the fan puts ink down");
}

fn main() i32 {
  var fontFile = Path.fromLiteral("C:/Windows/Fonts/arial.ttf");
  match fs.readFile(&fontFile) {
    case let Ok(bytes) {
      match Font.load(bytes.view()) {
        case let Ok(f) { run(&f); }
        case is Err { print <- "bad font\n"; return 1; }
      }
    }
    case is Err {
      match Font.load(&DEMO_FONT) {
        case let Ok(f) { run(&f); }
        case is Err { return 1; }
      }
    }
  }
  done()
}
