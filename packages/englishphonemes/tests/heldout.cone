// The phoneme strings against misaki's (0.9.4, no fallback: an unknown word is the unknown mark) on 63 sentences
// written after the tagger's rules were tuned on tests/misaki.cone's 224 (tests/data/misaki-heldout.tsv: the text,
// misaki's American phonemes, misaki's British phonemes). The first run, before any rule was added for them, agreed
// on 59 of the 63 (93.7 per cent; the four misses were heteronyms the tagger tagged wrongly: use, wound, permit);
// two rules were added after that (the word after "please", and "can't"-like words as modals), which fixed two.
// Needs the lexicons in C:/src/speech-models/kokoro (made by the converter, not in the repository): skipped when
// they are absent.

mod heldout;

import testing use *;
import stdio use *;
import collections use List, String;
import fs;
import path use Path;
import englishphonemes use *;

fn runDialect(rows: &List[String], column: usize, british: bool, name: &str) usize {
  let lex = match Lexicon.load("C:/src/speech-models/kokoro", british) {
    case var Ok(l) { l }
    case let Err(m) { print <- m.message().view(), "\n"; return 0usize; }
  };
  let g2p = G2p.make(lex, false, "❓");
  var same = 0usize;
  var total = 0usize;
  var i = 0usize;
  while i < rows.len() {
    let parts = String.from(rows[i].view().trimEnd()).split(u8.from('\t'));
    if parts.len() == 3usize {
      total = total + 1usize;
      let got = g2p.phonemize(parts[0usize].view());
      if got.phonemes.view() == parts[column].view() {
        same = same + 1usize;
      } else {
        print <- name, " MISS: ", parts[0usize].view(), "\n  want ", parts[column].view(), "\n  got  ", got.phonemes.view(), "\n";
      }
    }
    i = i + 1usize;
  }
  print <- name, ": ", same, " of ", total, " sentences the same as misaki\n";
  same
}

fn main() i32 {
  if !fs.exists(&Path.from("C:/src/speech-models/kokoro/us_gold.tsv")) {
    return skip("the converted lexicons are not in C:/src/speech-models/kokoro");
  }
  var text = String.empty();
  match fs.readFile(&Path.from("../../../../tests/data/misaki-heldout.tsv")) {
    case var Ok(ok) { text <-> ok; }
    case let Err(e) { expect(false, "the data file is there"); return done(); }
  }
  let rows = text.lines();
  runDialect(&rows, 1usize, false, "american");
  runDialect(&rows, 2usize, true, "british");
  done()
}
