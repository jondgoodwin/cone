// ======== englishphonemes: English text to Kokoro's phonemes ========
//
// A port of misaki's English grapheme-to-phoneme rules (misaki 0.9.4, MIT; the lexicons are misaki's) without spaCy
// and without espeak-ng. What it does, in order, for a line of text:
//
//   1. tokens: words, numbers and each piece of punctuation, with a part-of-speech tag for each
//      (tokenize.cone; a heuristic tagger in place of spaCy's, which matters to ~800 words whose pronunciation
//      depends on it, to "a", "the", "to", "in" and a few more)
//   2. misaki's G2P over the tokens (g2p.cone, lexicon.cone): sub-token splitting, currency, the longest part of a
//      word the lexicon knows, numbers as words (numbers.cone), the stress marks Kokoro wants, the effect of the
//      next sound on "the" and "to"
//   3. a word in neither lexicon: the rule-based fallback (fallback.cone), or with 'useFallback' false the unknown
//      mark, as misaki does with no fallback
//   4. chunking (chunks.cone): the model takes at most 510 phonemes, so long text is cut after a sentence end where
//      it can be (misaki's KPipeline)
//
//   imm lexicon = Lexicon.load("C:/src/speech-models/kokoro", false)?;        // american; true: british
//   imm g2p = G2p.make(lexicon, true, "");
//   imm r = g2p.phonemize("Hello world, this is a test of 3 numbers.");
//   // r.phonemes: həlˈO wˈɜɹld, ðɪs ɪz ɐ tˈɛst ʌv θɹˈi nˈʌmbəɹz.   r.fallbackWords: 0
//
// Tests: tests/numbers.cone, tests/misaki.cone (sentences against misaki's phonemes, every miss listed).

mod englishphonemes;

import collections use List, String, Dict;
import fs;
import path use Path;
