// ======== Items and pair bookkeeping shared by the three indexes ========

// One item: its box and handle, and three words each index uses as it likes
// (the BVH keeps the leaf node in 'x'; the octree keeps node, next and
// previous in x, y, z; the grid keeps its cell count in x and its place in
// the oversize list in y). 'moved' says a pair update is owed. Which
// occupant of a slot an item is lives in the pool's cell (pools.GenPool).
struct Item[T: Copy] {
  box: Aabb3;
  handle: T;
  moved: bool;
  x: u32;
  y: u32;
  z: u32;
}

// The items, in a GenPool: a slot is a cell index and never moves, so that
// per-item side tables and the BVH's leaves can be indexed by slot, and a
// Proxy is the pool's Handle (slot and generation). Slots are not dense: walk
// 0 up to 'bound()' and ask 'isLive'
struct Items[T: Copy] {
  pool: pools.GenPool[Item[T]];
  count: usize;

  fn create() Items[T] {Items[T](pools.GenPool[Item[T]].make(), 0usize)}

  fn add(self: &mut, box: Aabb3, handle: T) Proxy {
    count = count + 1usize;
    let h = pool.add(Item[T](box, handle, false, NONE, NONE, NONE));
    Proxy(h.index, h.gen)
  }

  // The item in slot 'i', which must be live
  fn cell(self: &, i: usize) *Item[T] {pool.at(u32.from(i))}

  // Slots 0 up to this are the ones to walk
  fn bound(self: &) usize {pool.bound()}

  fn alive(self: &, p: Proxy) bool {
    if p.slot == NONE {return false;}
    pool.get(pools.Handle(p.slot, p.gen)) as usize != 0usize
  }

  // Frees the slot of a live proxy
  fn release(self: &mut, slot: u32) {
    pool.removeAt(slot);
    count = count - 1usize;
  }

  fn isLive(self: &, slot: usize) bool {pool.isLive(u32.from(slot))}

  fn proxyOf(self: &, slot: u32) Proxy {
    let h = pool.slotAt(slot);
    Proxy(h.index, h.gen)
  }
}

// ---- pairs ----
//
// Each item's current overlap partners, kept symmetric, so that after an
// item moves its new partners can be diffed against its old ones in time
// proportional to their number. 'sync' is given the slots that now overlap
// item 'm' and reports which pairs are new and which have ended.
struct PairBook {
  partners: List[List[u32]];
  mark: List[u32];
  oldMark: List[u32];
  stamp: u32;

  fn create() PairBook {
    PairBook(List[List[u32]](), List[u32](), List[u32](), 0u32)
  }

  fn ensure(self: &mut, slot: u32) {
    while partners.len() <= usize.from(slot) {
      partners.push(List[u32]());
      mark.push(0u32);
      oldMark.push(0u32);
    }
  }

  fn removeFrom(self: &mut, owner: u32, other: u32) {
    let oi = usize.from(owner);
    var i = 0usize;
    while i < partners[oi].len() {
      if *partners[oi][i] == other {
        let last = partners[oi].len() - 1usize;
        partners[oi].swap(i, last);
        partners[oi].truncate(last);
        return;
      }
      i = i + 1usize;
    }
  }

  fn sync(self: &mut, m: u32, found: &List[u32], added: &mut List[u32], ended: &mut List[u32]) {
    ensure(m);
    stamp = stamp + 1u32;
    let s = stamp;
    let mi = usize.from(m);
    var i = 0usize;
    while i < found.len() {
      let o = *found[i];
      if o != m {
        ensure(o);
        mark.set(usize.from(o), s);
      }
      i = i + 1usize;
    }
    i = 0usize;
    while i < partners[mi].len() {
      oldMark.set(usize.from(*partners[mi][i]), s);
      i = i + 1usize;
    }
    // ended: old partners no longer found
    var keep = 0usize;
    let n = partners[mi].len();
    i = 0usize;
    while i < n {
      let o = *partners[mi][i];
      if *mark[usize.from(o)] == s {
        partners[mi].set(keep, o);
        keep = keep + 1usize;
      }
      else {
        ended.push(o);
        removeFrom(o, m);
      }
      i = i + 1usize;
    }
    partners[mi].truncate(keep);
    // added: found and not old (a duplicate in 'found' is added once: the
    // old mark is set as it is added)
    i = 0usize;
    while i < found.len() {
      let o = *found[i];
      if o != m && *oldMark[usize.from(o)] != s {
        oldMark.set(usize.from(o), s);
        added.push(o);
        partners[mi].push(o);
        partners[usize.from(o)].push(m);
      }
      i = i + 1usize;
    }
  }

  // Item 'm' is leaving: gives its partners (to report the pairs ending) and
  // forgets the pairs
  fn forget(self: &mut, m: u32, ended: &mut List[u32]) {
    if usize.from(m) >= partners.len() {return;}
    let mi = usize.from(m);
    var i = 0usize;
    while i < partners[mi].len() {
      let o = *partners[mi][i];
      ended.push(o);
      removeFrom(o, m);
      i = i + 1usize;
    }
    partners[mi].clear();
  }
}
