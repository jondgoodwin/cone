// The BVH, checked two ways: by hand-worked cases on a few boxes, and
// against brute force over random scenes (every query kind, through
// inserts, removes, moves, refits and rebuilds). Only a failure prints.
//
// Hand cases, boxes A = [0,1]^3, B = [2,3]x[0,1]x[0,1], C = [5,6]^3:
// - the ray from (-1, .5, .5) along +x enters A at t = 1 and B at t = 3
//   (the direction is a unit); along a doubled direction (2,0,0) at 0.5 and 1.5;
// - a ray starting inside A enters at 0;
// - a ball of radius 1.5 at (1.5, .5, .5) touches A (nearest face 0.5 away)
//   and B, not C;
// - the nearest to (4, .5, .5): B is 1 away (squared 1), A 3 away (9), C: dx 1,
//   dy 0, dz 0 = 1... so C is at (5-4)^2 = 1 in x, and 0 in y and z
//   (.5 is not inside [5,6] on y: dy = 4.5): C is 1 + 20.25 + 20.25 = 41.5.

mod grid;

import testing use *;
import collections use *;
import geomath use *;
import spatialindex use *;

struct Rng {
  s: u64;
  fn next(self: &mut) u64 {
    s = s ^ (s >> 12u64);
    s = s ^ (s << 25u64);
    s = s ^ (s >> 27u64);
    s * 2685821657736338717u64
  }
  // A float in [0, 1)
  fn unit(self: &mut) f32 {f32.from(next() >> 40u64) / 16777216.}
  fn range(self: &mut, lo: f32, hi: f32) f32 {lo + (hi - lo) * unit()}
}

fn asc(a: &u64, b: &u64) i32 {
  if *a < *b {-1i32} else if *a > *b {1i32} else {0i32}
}

fn v3(x: f32, y: f32, z: f32) Vec3 {new Vec3(x, y, z)}

fn randomBox(rng: &mut Rng, world: f32, maxSize: f32) Aabb3 {
  let c = v3(rng.range(0., world), rng.range(0., world), rng.range(0., world));
  let h = v3(rng.range(0.1, maxSize), rng.range(0.1, maxSize), rng.range(0.1, maxSize));
  Aabb3.fromCenter(c, h)
}

var @threadlocal totalFound = 0i64;

fn sameSets(got: &mut List[u64], want: &mut List[u64]) bool {
  totalFound = totalFound + i64.from(want.len());
  got.sortBy(&asc);
  want.sortBy(&asc);
  if got.len() != want.len() {return false;}
  var i = 0usize;
  while i < got.len() {
    if *got[i] != *want[i] {return false;}
    i = i + 1usize;
  }
  true
}

// A scene kept beside the index: the truth the queries are checked against
struct Scene {
  idx: HashGrid[u64];
  boxes: List[Aabb3];
  live: List[bool];
  proxies: List[Proxy];
}

fn makeScene() Scene {
  new Scene(HashGrid[u64].create(4.), List[Aabb3].empty(), List[bool].empty(), List[Proxy].empty())
}

fn addTo(s: &mut Scene, b: Aabb3) {
  let id = u64.from(s.boxes.len());
  s.proxies.push(s.idx.insert(b, id));
  s.boxes.push(b);
  s.live.push(true);
}

// Checks every query kind at random against brute force; returns mismatches
fn checkQueries(s: &mut Scene, rng: &mut Rng, world: f32, rounds: i32) i64 {
  var bad = 0i64;
  var r = 0i32;
  while r < rounds {
    r = r + 1i32;
    // box overlap
    let q = Aabb3.fromCenter(v3(rng.range(0., world), rng.range(0., world), rng.range(0., world)),
      v3(rng.range(1., 15.), rng.range(1., 15.), rng.range(1., 15.)));
    var got = List[u64].empty();
    var want = List[u64].empty();
    var c1 = fn(h: u64, p: Proxy) bool { got.push(h); true };
    s.idx.overlapAabb(q, &mut c1);
    var i = 0usize;
    while i < s.boxes.len() {
      if *s.live[i] && s.boxes[i].overlaps(q) {want.push(u64.from(i));}
      i = i + 1usize;
    }
    if !sameSets(&mut got, &mut want) {bad = bad + 1i64;}

    // sphere overlap
    let ball = new Sphere(v3(rng.range(0., world), rng.range(0., world), rng.range(0., world)), rng.range(1., 20.));
    var got2 = List[u64].empty();
    var want2 = List[u64].empty();
    var c2 = fn(h: u64, p: Proxy) bool { got2.push(h); true };
    s.idx.overlapSphere(ball, &mut c2);
    i = 0usize;
    while i < s.boxes.len() {
      if *s.live[i] && ball.overlapsAabb(*s.boxes[i]) {want2.push(u64.from(i));}
      i = i + 1usize;
    }
    if !sameSets(&mut got2, &mut want2) {bad = bad + 1i64;}

    // frustum
    let eye = v3(rng.range(-20., world + 20.), rng.range(-20., world + 20.), rng.range(-20., world + 20.));
    let target = v3(rng.range(0., world), rng.range(0., world), rng.range(0., world));
    let vp = Mat4.perspective(rng.range(0.4, 1.8), 1.3, 1., rng.range(30., 150.)) * Mat4.lookAt(eye, target, v3(0., 1., 0.));
    let fr = Frustum.fromMatrix(vp);
    var got3 = List[u64].empty();
    var want3 = List[u64].empty();
    var c3 = fn(h: u64, p: Proxy) bool { got3.push(h); true };
    s.idx.frustum(&fr, &mut c3);
    i = 0usize;
    while i < s.boxes.len() {
      if *s.live[i] && fr.testAabb(*s.boxes[i]) != Outside {want3.push(u64.from(i));}
      i = i + 1usize;
    }
    if !sameSets(&mut got3, &mut want3) {bad = bad + 1i64;}

    // rays: all hits, and the nearest
    var dir = v3(rng.range(-1., 1.), rng.range(-1., 1.), rng.range(-1., 1.));
    if r % 5i32 == 0i32 {dir = v3(1., 0., 0.);}
    if r % 7i32 == 0i32 {dir = v3(0., 0., -2.);}
    let ray = new Ray3(v3(rng.range(-10., world + 10.), rng.range(0., world), rng.range(0., world)), dir);
    let maxT = rng.range(20., 200.);
    var got4 = List[u64].empty();
    var want4 = List[u64].empty();
    var c4 = fn(h: u64, p: Proxy, t: f32) bool { got4.push(h); true };
    s.idx.rayAll(ray, maxT, &mut c4);
    var bestT = FAR;
    var bestId = 0u64;
    i = 0usize;
    while i < s.boxes.len() {
      if *s.live[i] {
        match ray.intersectAabb(*s.boxes[i]) {
          case let t Some {
            if t <= maxT {
              want4.push(u64.from(i));
              if t < bestT {bestT = t; bestId = u64.from(i);}
            }
          }
          case is None { }
        }
      }
      i = i + 1usize;
    }
    if !sameSets(&mut got4, &mut want4) {bad = bad + 1i64;}
    match s.idx.rayNearest(ray, maxT) {
      case let hit Some {
        if want4.len() == 0usize {bad = bad + 1i64;}
        else if absDiff(hit.t, bestT) > 0.0005 {bad = bad + 1i64;}
      }
      case is None {
        if want4.len() != 0usize {bad = bad + 1i64;}
      }
    }

    // k nearest
    let pt = v3(rng.range(-5., world + 5.), rng.range(-5., world + 5.), rng.range(-5., world + 5.));
    let k = 1usize + usize.from(rng.next() % 12u64);
    var near = List[Neighbor[u64]].empty();
    s.idx.nearest(pt, k, &mut near);
    var ds = List[f32].empty();
    i = 0usize;
    while i < s.boxes.len() {
      if *s.live[i] {ds.push(s.boxes[i].closestPoint(pt).distanceSquared(pt));}
      i = i + 1usize;
    }
    // selection of the k smallest, by repeated minimum
    let expect = if ds.len() < k {ds.len()} else {k};
    if near.len() != expect {bad = bad + 1i64;}
    else {
      var n = 0usize;
      while n < expect {
        var mi = n;
        var j = n + 1usize;
        while j < ds.len() {
          if *ds[j] < *ds[mi] {mi = j;}
          j = j + 1usize;
        }
        ds.swap(n, mi);
        if absDiff(near[n].distSq, *ds[n]) > 0.001 {bad = bad + 1i64;}
        n = n + 1usize;
      }
    }
  }
  bad
}

fn absDiff(a: f32, b: f32) f32 {if a > b {a - b} else {b - a}}

fn main() i32 {
  // ---- hand cases ----
  var hand = HashGrid[u64].create(1.);
  let pa = hand.insert(new Aabb3(v3(0., 0., 0.), v3(1., 1., 1.)), 10u64);
  let pb = hand.insert(new Aabb3(v3(2., 0., 0.), v3(3., 1., 1.)), 20u64);
  let pc = hand.insert(new Aabb3(v3(5., 5., 5.), v3(6., 6., 6.)), 30u64);
  expectInt(i64.from(hand.len()), 3i64, "three items");
  match hand.rayNearest(new Ray3(v3(-1., 0.5, 0.5), v3(1., 0., 0.)), 100.) {
    case let h Some {
      expectUInt(h.handle, 10u64, "ray nearest is A");
      expectFloat(h.t, 1., 0.00001, "ray enters A at t = 1");
    }
    case is None { expect(false, "ray hits something"); }
  }
  match hand.rayNearest(new Ray3(v3(-1., 0.5, 0.5), v3(2., 0., 0.)), 100.) {
    case let h Some { expectFloat(h.t, 0.5, 0.00001, "doubled direction: t = 0.5"); }
    case is None { expect(false, "ray hits something (doubled)"); }
  }
  match hand.rayNearest(new Ray3(v3(0.5, 0.5, 0.5), v3(1., 0., 0.)), 100.) {
    case let h Some { expectFloat(h.t, 0., 0.00001, "ray from inside enters at 0"); }
    case is None { expect(false, "ray from inside hits"); }
  }
  match hand.rayNearest(new Ray3(v3(-1., 0.5, 0.5), v3(1., 0., 0.)), 0.5) {
    case let h Some { expect(false, "reach 0.5 stops short of A"); }
    case is None { }
  }
  var hits = 0i32;
  var count = fn(h: u64, p: Proxy, t: f32) bool { hits = hits + 1i32; true };
  hand.rayAll(new Ray3(v3(-1., 0.5, 0.5), v3(1., 0., 0.)), 100., &mut count);
  expectInt(i64.from(hits), 2i64, "ray along x meets A and B");

  var ids = List[u64].empty();
  var collect = fn(h: u64, p: Proxy) bool { ids.push(h); true };
  hand.overlapSphere(new Sphere(v3(1.5, 0.5, 0.5), 1.5), &mut collect);
  expectInt(i64.from(ids.len()), 2i64, "ball touches A and B");
  var near = List[Neighbor[u64]].empty();
  hand.nearest(v3(4., 0.5, 0.5), 3usize, &mut near);
  expectInt(i64.from(near.len()), 3i64, "three nearest");
  expectUInt(near[0usize].handle, 20u64, "B nearest");
  expectFloat(near[0usize].distSq, 1., 0.00001, "B is 1 away squared");
  expectUInt(near[1usize].handle, 10u64, "A second");
  expectFloat(near[1usize].distSq, 9., 0.00001, "A is 3 away squared");
  expectUInt(near[2usize].handle, 30u64, "C third");
  expectFloat(near[2usize].distSq, 41.5, 0.0001, "C squared distance");

  // removal and stale proxies
  expect(hand.remove(pb), "B removed");
  expect(!hand.remove(pb), "B cannot be removed twice");
  expect(!hand.contains(pb), "B's proxy is dead");
  expect(hand.contains(pa) && hand.contains(pc), "A and C live");
  let pd = hand.insert(new Aabb3(v3(2., 0., 0.), v3(3., 1., 1.)), 40u64);
  expect(!hand.contains(pb), "B's proxy stays dead after its slot is reused");
  expect(hand.contains(pd), "D live");
  expectInt(i64.from(hand.len()), 3i64, "three again");

  // ---- random scenes ----
  var rng = new Rng(88172645463325252u64);
  var s = makeScene();
  var i = 0;
  while i < 1500 {
    addTo(&mut s, randomBox(&mut rng, 100., 4.));
    i = i + 1;
  }
  expectInt(checkQueries(&mut s, &mut rng, 100., 60i32), 0i64, "queries after dynamic inserts");

  // moves, removes and inserts
  var round = 0;
  while round < 4 {
    round = round + 1;
    var j = 0usize;
    while j < s.boxes.len() {
      let roll = rng.next() % 10u64;
      if *s.live[j] {
        if roll < 4u64 {
          let nb = randomBox(&mut rng, 100., 4.);
          s.idx.move(*s.proxies[j], nb, nb.center() - s.boxes[j].center());
          s.boxes.set(j, nb);
        }
        else if roll < 5u64 {
          expect(s.idx.remove(*s.proxies[j]), "remove live");
          s.live.set(j, false);
        }
        else if roll < 7u64 {
          // a small jitter
          let b = *s.boxes[j];
          let nb = new Aabb3(b.min + v3(0.02, 0., 0.), b.max + v3(0.02, 0., 0.));
          s.idx.move(*s.proxies[j], nb, v3(0.02, 0., 0.));
          s.boxes.set(j, nb);
        }
      }
      j = j + 1usize;
    }
    i = 0;
    while i < 100 {
      addTo(&mut s, randomBox(&mut rng, 100., 4.));
      i = i + 1;
    }
    expectInt(checkQueries(&mut s, &mut rng, 100., 25i32), 0i64, "queries after moves, removes and inserts");
  }

  // mixed sizes: many small, a few huge, and a tight cluster
  var mx = makeScene();
  i = 0;
  while i < 500 {
    addTo(&mut mx, randomBox(&mut rng, 100., 1.));
    i = i + 1;
  }
  i = 0;
  while i < 20 {
    addTo(&mut mx, randomBox(&mut rng, 100., 40.));
    i = i + 1;
  }
  i = 0;
  while i < 300 {
    addTo(&mut mx, randomBox(&mut rng, 5., 0.5));
    i = i + 1;
  }
  expectInt(checkQueries(&mut mx, &mut rng, 100., 60i32), 0i64, "queries on mixed sizes and a cluster");

  // ---- pairs ----
  var ps = makeScene();
  i = 0;
  while i < 400 {
    addTo(&mut ps, randomBox(&mut rng, 40., 3.));
    i = i + 1;
  }
  var known = List[u64].empty();
  var ev = PairEvents[u64].create();
  var pairBad = 0i64;
  var step = 0;
  while step < 8 {
    step = step + 1;
    if step > 1 {
      var m = 0usize;
      while m < ps.boxes.len() {
        let roll = rng.next() % 10u64;
        if *ps.live[m] {
          if roll < 3u64 {
            let nb = randomBox(&mut rng, 40., 3.);
            ps.idx.move(*ps.proxies[m], nb, nb.center() - ps.boxes[m].center());
            ps.boxes.set(m, nb);
          }
          else if roll == 3u64 {
            ps.idx.remove(*ps.proxies[m]);
            ps.live.set(m, false);
          }
        }
        m = m + 1usize;
      }
      i = 0;
      while i < 20 {
        addTo(&mut ps, randomBox(&mut rng, 40., 3.));
        i = i + 1;
      }
    }
    ev.clear();
    ps.idx.updatePairs(&mut ev);
    // apply the events to the known set
    var e = 0usize;
    while e < ev.removed.len() {
      let key = pairKey(ev.removed[e].a, ev.removed[e].b);
      var f = 0usize;
      var found = false;
      while f < known.len() {
        if *known[f] == key {
          let last = known.len() - 1usize;
          known.swap(f, last);
          known.truncate(last);
          found = true;
          break;
        }
        f = f + 1usize;
      }
      if !found {pairBad = pairBad + 1i64;}
      e = e + 1usize;
    }
    e = 0usize;
    while e < ev.added.len() {
      known.push(pairKey(ev.added[e].a, ev.added[e].b));
      e = e + 1usize;
    }
    // truth: brute force over the fat boxes
    var truth = List[u64].empty();
    var a = 0usize;
    while a < ps.boxes.len() {
      if *ps.live[a] {
        var b = a + 1usize;
        while b < ps.boxes.len() {
          if *ps.live[b] && ps.idx.pairBox(*ps.proxies[a]).overlaps(ps.idx.pairBox(*ps.proxies[b])) {
            truth.push(pairKey(u64.from(a), u64.from(b)));
          }
          b = b + 1usize;
        }
      }
      a = a + 1usize;
    }
    if !sameSets(&mut known, &mut truth) {pairBad = pairBad + 1i64;}
    // and allPairs says the same
    var all = List[Pair[u64]].empty();
    ps.idx.allPairs(&mut all);
    var allKeys = List[u64].empty();
    e = 0usize;
    while e < all.len() {
      allKeys.push(pairKey(all[e].a, all[e].b));
      e = e + 1usize;
    }
    if !sameSets(&mut allKeys, &mut truth) {pairBad = pairBad + 1i64;}
  }
  expectInt(pairBad, 0i64, "incremental pairs and allPairs match brute force through 8 updates");
  expect(totalFound > 5000i64, "the queries found plenty (not vacuous)");
  done()
}

fn pairKey(a: u64, b: u64) u64 {
  if a < b {a * 1000000u64 + b} else {b * 1000000u64 + a}
}
