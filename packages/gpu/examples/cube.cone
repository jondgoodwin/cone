  0x75706e69u32, 0x6f632e74u32, 0x00726f6cu32, 0x000a0005u32, 0x00000032u32, 0x72746e65u32,
  0x696f5079u32, 0x6150746eu32, 0x5f6d6172u32, 0x67617266u32, 0x746e656du32, 0x6e69614du32,
  0x00000000u32, 0x00060005u32, 0x0000002du32, 0x67617266u32, 0x746e656du32, 0x6e69614du32,
