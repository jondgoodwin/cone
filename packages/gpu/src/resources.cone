// ---- Formats and the rest translated ----

// A texture format's Vulkan format
fn vkFormat(format u32) u32 {
  if format == TEXTURE_FORMAT_RGBA8_UNORM { return vulkan.FORMAT_R8G8B8A8_UNORM; }
  if format == TEXTURE_FORMAT_RGBA8_UNORM_SRGB { return vulkan.FORMAT_R8G8B8A8_SRGB; }
  if format == TEXTURE_FORMAT_BGRA8_UNORM { return vulkan.FORMAT_B8G8R8A8_UNORM; }
  if format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB { return vulkan.FORMAT_B8G8R8A8_SRGB; }
  if format == TEXTURE_FORMAT_DEPTH32_FLOAT { return vulkan.FORMAT_D32_SFLOAT; }
  if format == TEXTURE_FORMAT_RGBA16_FLOAT { return vulkan.FORMAT_R16G16B16A16_SFLOAT; }
  if format == TEXTURE_FORMAT_R32_FLOAT { return vulkan.FORMAT_R32_SFLOAT; }
  if format == TEXTURE_FORMAT_R32_UINT { return vulkan.FORMAT_R32_UINT; }
  vulkan.FORMAT_UNDEFINED;
}

// The bytes of one texel of a texture format
fn bytesPerTexel(format u32) u32 {
  if format == TEXTURE_FORMAT_RGBA16_FLOAT { return 8u32; }
  4u32;
}

// Whether a format may be a storage texture's: WebGPU's storage formats that
// the layer offers
fn isStorageFormat(format u32) Bool {
  format == TEXTURE_FORMAT_R32_FLOAT or format == TEXTURE_FORMAT_R32_UINT or format == TEXTURE_FORMAT_RGBA16_FLOAT
    or format == TEXTURE_FORMAT_RGBA8_UNORM;
}

fn textureFormat(vkFormat u32) u32 {
  if vkFormat == vulkan.FORMAT_R8G8B8A8_UNORM { return TEXTURE_FORMAT_RGBA8_UNORM; }
  if vkFormat == vulkan.FORMAT_R8G8B8A8_SRGB { return TEXTURE_FORMAT_RGBA8_UNORM_SRGB; }
  if vkFormat == vulkan.FORMAT_B8G8R8A8_UNORM { return TEXTURE_FORMAT_BGRA8_UNORM; }
  if vkFormat == vulkan.FORMAT_B8G8R8A8_SRGB { return TEXTURE_FORMAT_BGRA8_UNORM_SRGB; }
  if vkFormat == vulkan.FORMAT_D32_SFLOAT { return TEXTURE_FORMAT_DEPTH32_FLOAT; }
  if vkFormat == vulkan.FORMAT_R16G16B16A16_SFLOAT { return TEXTURE_FORMAT_RGBA16_FLOAT; }
  if vkFormat == vulkan.FORMAT_R32_SFLOAT { return TEXTURE_FORMAT_R32_FLOAT; }
  if vkFormat == vulkan.FORMAT_R32_UINT { return TEXTURE_FORMAT_R32_UINT; }
  TEXTURE_FORMAT_UNDEFINED;
}

// The aspect of a view of 'vkFormat': depth, or color
fn aspectOf(vkFormat u32) u32 {
  if vkFormat == vulkan.FORMAT_D32_SFLOAT { return vulkan.IMAGE_ASPECT_DEPTH_BIT; }
  vulkan.IMAGE_ASPECT_COLOR_BIT;
}

fn vertexFormat(format u32) u32 {
  if format == VERTEX_FORMAT_FLOAT32 { return vulkan.FORMAT_R32_SFLOAT; }
  if format == VERTEX_FORMAT_FLOAT32X2 { return vulkan.FORMAT_R32G32_SFLOAT; }
  if format == VERTEX_FORMAT_FLOAT32X3 { return vulkan.FORMAT_R32G32B32_SFLOAT; }
  if format == VERTEX_FORMAT_FLOAT32X4 { return vulkan.FORMAT_R32G32B32A32_SFLOAT; }
  if format == VERTEX_FORMAT_UNORM8X4 { return vulkan.FORMAT_R8G8B8A8_UNORM; }
  vulkan.FORMAT_UNDEFINED;
}

fn topology(t u32) u32 {
  if t == PRIMITIVE_TOPOLOGY_POINT_LIST { return vulkan.PRIMITIVE_TOPOLOGY_POINT_LIST; }
  if t == PRIMITIVE_TOPOLOGY_LINE_LIST { return vulkan.PRIMITIVE_TOPOLOGY_LINE_LIST; }
  if t == PRIMITIVE_TOPOLOGY_LINE_STRIP { return vulkan.PRIMITIVE_TOPOLOGY_LINE_STRIP; }
  if t == PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP { return vulkan.PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP; }
  vulkan.PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
}

fn shaderStages(visibility u32) u32 {
  mut stages = 0u32;
  if (visibility & SHADER_STAGE_VERTEX) != 0u32 { stages = stages | vulkan.SHADER_STAGE_VERTEX_BIT; }
  if (visibility & SHADER_STAGE_FRAGMENT) != 0u32 { stages = stages | vulkan.SHADER_STAGE_FRAGMENT_BIT; }
  if (visibility & SHADER_STAGE_COMPUTE) != 0u32 { stages = stages | vulkan.SHADER_STAGE_COMPUTE_BIT; }
  stages;
}

fn descriptorType(kind u32, bufferType u32) u32 {
  if kind == BINDING_KIND_SAMPLER { return vulkan.DESCRIPTOR_TYPE_SAMPLER; }
  if kind == BINDING_KIND_TEXTURE { return vulkan.DESCRIPTOR_TYPE_SAMPLED_IMAGE; }
  if kind == BINDING_KIND_STORAGE_TEXTURE { return vulkan.DESCRIPTOR_TYPE_STORAGE_IMAGE; }
  if bufferType == BUFFER_BINDING_TYPE_UNIFORM { return vulkan.DESCRIPTOR_TYPE_UNIFORM_BUFFER; }
  vulkan.DESCRIPTOR_TYPE_STORAGE_BUFFER;
}

// ---- Buffers ----

struct BufferBackend {
  pub device vulkan.Device;
  pub buffer vulkan.Buffer;
  pub memory vulkan.DeviceMemory;
  pub mapped *u8;
}

// A buffer of bytes the GPU reads or writes
pub struct Buffer {
  pub backend BufferBackend;
  pub size u64;
  pub usage u32;

  pub fn isValid(self &) Bool { backend.memory.h != 0u64; }

  // No buffer: what a field holds before a buffer is made for it (not valid)
  pub fn none() Buffer {
    Buffer[BufferBackend[0usize as vulkan.Device, vulkan.Buffer[0u64], vulkan.DeviceMemory[0u64], nullp()], 0u64, 0u32];
  }

  // Its bytes, for a buffer the CPU maps (MAP_READ or MAP_WRITE); null for
  // any other. What the GPU wrote is there once the frame that wrote it is
  // done ('device.waitIdle', or FRAMES_IN_FLIGHT frames later).
  pub fn mappedRange(self &) *u8 { backend.mapped; }

  // Its end, once the GPU is idle
  fn final(self &uni) {
    if backend.buffer.h != 0u64 {
      vulkan.deviceWaitIdle(backend.device);
      vulkan.destroyBuffer(backend.device, backend.buffer, nullp());
    }
    if backend.memory.h != 0u64 { vulkan.freeMemory(backend.device, backend.memory, nullp()); }
  }
}

// ---- Textures ----

// What 'createTexture' makes. A 2-D texture of several layers
// ('depthOrArrayLayers'), square, six or a multiple of six of them, may be
// seen as a cube ('createViewWith', TEXTURE_VIEW_DIMENSION_CUBE), as WebGPU's
// may; 'mipLevelCount' levels of detail, each half the one before (at least
// 1 x 1). A 3-D texture ('dimension' TEXTURE_DIMENSION_3D) is
// 'depthOrArrayLayers' deep, and has no layers.
pub struct TextureDescriptor {
  pub width u32;
  pub height u32;
  pub format u32;                  // TEXTURE_FORMAT_...
  pub usage u32;                   // TEXTURE_USAGE_... OR-ed
  pub mipLevelCount u32 = 1u32;
  pub depthOrArrayLayers u32 = 1u32;
  pub dimension u32 = TEXTURE_DIMENSION_2D;
}

// What 'createViewWith' makes: WebGPU's GPUTextureViewDescriptor. A count of
// 0 is WebGPU's count left out: the rest of the levels; the rest of the
// layers for an array, six for a cube, one for 2-D.
pub struct TextureViewDescriptor {
  pub dimension u32 = TEXTURE_VIEW_DIMENSION_2D;
  pub baseMipLevel u32 = 0u32;
  pub mipLevelCount u32 = 0u32;
  pub baseArrayLayer u32 = 0u32;
  pub arrayLayerCount u32 = 0u32;
}

struct TextureBackend {
  pub image vulkan.Image;
  pub view vulkan.ImageView;       // the view: of the whole texture, in a Texture
  pub kind u32;                    // KIND_...: the layout it rests in
  pub owned Bool;                  // made by the device, and ended with the Texture
  pub device vulkan.Device;
  pub memory vulkan.DeviceMemory;
  pub baseMip u32 = 0u32;          // what the view sees: levels and layers
  pub mipCount u32 = 1u32;
  pub baseLayer u32 = 0u32;
  pub layerCount u32 = 1u32;
  pub views *ViewCache = 0usize as *ViewCache;  // a device-made texture's; null otherwise
}

// The views 'createViewWith' has made of a texture, each kept until the
// texture ends: WebGPU's views are the texture's, not destroyed on their own
struct ViewCache {
  pub count u32;
  pub capacity u32;
  pub entries *ViewEntry;
}

struct ViewEntry {
  pub key u64;                     // the descriptor, packed
  pub view vulkan.ImageView;
}

// A texture: one the device made ('createTexture'), or a swapchain's, which
// the swapchain owns (and its depth texture)
pub struct Texture {
  pub backend TextureBackend;
  pub width u32;
  pub height u32;
  pub format u32;                  // TEXTURE_FORMAT_...
  pub usage u32;                   // TEXTURE_USAGE_...
  pub mipLevelCount u32 = 1u32;
  pub depthOrArrayLayers u32 = 1u32;
  pub dimension u32 = TEXTURE_DIMENSION_2D;

  pub fn isValid(self &) Bool { backend.view.h != 0u64; }

  // A view of the whole texture (made with it): 2-D, a 2-D array if it
  // has several layers, or 3-D
  pub fn createView(self &) TextureView {
    TextureView[backend, width, height, format];
  }

  // A view of some of its levels and layers, as 'desc' says, seen as 2-D, a
  // 2-D array or a cube (or, of a 3-D texture, some of its levels, 3-D);
  // its width and height are its first level's. A
  // render pass draws into a view of one level and one layer. The view is
  // made once, the first time it is asked for, and kept as long as the
  // texture (an invalid view if it cannot be made: check 'isValid').
  pub fn createViewWith(self &, desc &TextureViewDescriptor) TextureView {
    mut result = TextureView[backend, width, height, format];
    result.backend.view = vulkan.ImageView[0u64];
    if backend.image.h == 0u64 or (backend.views as usize) == 0usize { return result; }
    imm volume = dimension == TEXTURE_DIMENSION_3D;
    if volume != (desc.dimension == TEXTURE_VIEW_DIMENSION_3D) {
      fail("createViewWith: a 3-D texture is viewed 3-D, and only a 3-D texture is");
      return result;
    }
    imm baseMip = desc.baseMipLevel;
    imm baseLayer = desc.baseArrayLayer;
    mut mips = desc.mipLevelCount;
    if mips == 0u32 and baseMip < mipLevelCount { mips = mipLevelCount - baseMip; }
    mut layers = desc.arrayLayerCount;
    // A 3-D texture's depth is not layers: it has one
    imm textureLayers = if volume { 1u32; } else { depthOrArrayLayers; };
    if layers == 0u32 {
      if desc.dimension == TEXTURE_VIEW_DIMENSION_CUBE {
        layers = 6u32;
      } elif desc.dimension == TEXTURE_VIEW_DIMENSION_2D or volume {
        layers = 1u32;
      } elif baseLayer < textureLayers {
        layers = textureLayers - baseLayer;
      }
    }
    if mips == 0u32 or baseMip + mips > mipLevelCount or layers == 0u32 or baseLayer + layers > textureLayers
        or ((desc.dimension == TEXTURE_VIEW_DIMENSION_2D or volume) and layers != 1u32)
        or (desc.dimension == TEXTURE_VIEW_DIMENSION_CUBE and layers != 6u32) {
      fail("createViewWith: the levels or layers are not the texture's, or not the dimension's");
      return result;
    }
    mut viewType = vulkan.IMAGE_VIEW_TYPE_2D;
    if desc.dimension == TEXTURE_VIEW_DIMENSION_2D_ARRAY { viewType = vulkan.IMAGE_VIEW_TYPE_2D_ARRAY; }
    if desc.dimension == TEXTURE_VIEW_DIMENSION_CUBE { viewType = vulkan.IMAGE_VIEW_TYPE_CUBE; }
    if volume { viewType = vulkan.IMAGE_VIEW_TYPE_3D; }
    imm key = u64.from(desc.dimension) | (u64.from(baseMip) << 8u64) | (u64.from(mips) << 16u64) | (u64.from(baseLayer) << 24u64)
      | (u64.from(layers) << 40u64);
    imm cache = backend.views;
    mut found = vulkan.ImageView[0u64];
    mut i = 0usize;
    while i < usize.from(cache.count) {
      imm e = cache.entries + i;
      if e.key == key { found = e.view; }
      i = i + 1usize;
    }
    if found.h == 0u64 {
      if cache.count == cache.capacity {
        fail("createViewWith: more views of one texture than it keeps");
        return result;
      }
      imm vk = vkFormat(format);
      imm vci = vulkan.ImageViewCreateInfo[image: backend.image, viewType: viewType, format: vk,
        components: vulkan.ComponentMapping[], subresourceRange: vulkan.ImageSubresourceRange[aspectMask: aspectOf(vk),
        baseMipLevel: baseMip, levelCount: mips, baseArrayLayer: baseLayer, layerCount: layers]];
      if !check(vulkan.createImageView(backend.device, &vci, nullp(), &mut found), "vkCreateImageView") {
        return result;
      }
      imm slot = cache.entries + usize.from(cache.count);
      *slot = ViewEntry[key, found];
      cache.count = cache.count + 1u32;
    }
    result.backend.view = found;
    result.backend.baseMip = baseMip;
    result.backend.mipCount = mips;
    result.backend.baseLayer = baseLayer;
    result.backend.layerCount = layers;
    result.width = mipSize(width, baseMip);
    result.height = mipSize(height, baseMip);
    result;
  }

  // Its end, if the device made it, once the GPU is idle
  fn final(self &uni) {
    if backend.owned and backend.image.h != 0u64 {
      vulkan.deviceWaitIdle(backend.device);
      if backend.view.h != 0u64 { vulkan.destroyImageView(backend.device, backend.view, nullp()); }
      endViews(backend.device, backend.views);
      vulkan.destroyImage(backend.device, backend.image, nullp());
    }
    if backend.owned and backend.memory.h != 0u64 { vulkan.freeMemory(backend.device, backend.memory, nullp()); }
  }
}

// A level's width or height: the texture's halved 'level' times, at least 1
fn mipSize(size u32, level u32) u32 {
  imm s = size >> level;
  if s == 0u32 { return 1u32; }
  s;
}

// A cache of room for 'capacity' views
fn newViews(capacity u32) *ViewCache {
  imm cache = libc.calloc(1usize, mem.sizeof[ViewCache]()) as *ViewCache;
  cache.capacity = capacity;
  cache.entries = libc.calloc(usize.from(capacity), mem.sizeof[ViewEntry]()) as *ViewEntry;
  cache;
}

// Destroy the views in 'cache', and free it
fn endViews(device vulkan.Device, cache *ViewCache) {
  if (cache as usize) == 0usize { return; }
  mut i = 0usize;
  while i < usize.from(cache.count) {
    imm e = cache.entries + i;
    vulkan.destroyImageView(device, e.view, nullp());
    i = i + 1usize;
  }
  libc.free(cache.entries as *u8);
  libc.free(cache as *u8);
}

// A view of a texture, which a render pass draws into, or a bind group
// hands shaders to sample
pub struct TextureView {
  pub backend TextureBackend;
  pub width u32;
  pub height u32;
  pub format u32;

  pub fn isValid(self &) Bool { backend.view.h != 0u64; }
}

// What 'getCurrentTexture' answers: a texture to draw into this frame, if
// 'ok', and the swapchain's depth texture, if it keeps one
pub struct SurfaceTexture {
  pub texture Texture;
  pub depth Texture;
  pub status u32;                  // SURFACE_TEXTURE_...

  pub fn ok(self &) Bool {
    status == SURFACE_TEXTURE_SUCCESS_OPTIMAL or status == SURFACE_TEXTURE_SUCCESS_SUBOPTIMAL;
  }
}

fn noTexture() Texture {
  Texture[TextureBackend[vulkan.Image[0u64], vulkan.ImageView[0u64], KIND_NONE, false, 0usize as vulkan.Device,
    vulkan.DeviceMemory[0u64]], 0u32, 0u32, TEXTURE_FORMAT_UNDEFINED, 0u32];
}
