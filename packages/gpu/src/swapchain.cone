// ---- Swapchains ----

struct SwapChainBackend {
  device: vulkan.Device;
  fns: DevFns;
  physical: vulkan.PhysicalDevice;
  ifns: InstFns;                // its instance's functions
  surface: vulkan.SurfaceKHR;
  swapchain: vulkan.SwapchainKHR;
  format: u32;                  // Vulkan's
  colorSpace: u32;
  usage: u32;
  copyable: bool;               // its images may be copied from
  images: Array[vulkan.Image, 8];
  views: Array[vulkan.ImageView, 8];
  renderDone: Array[vulkan.Semaphore, 8];     // one per image: presentation waits for it
  initialized: Array[bool, 8];                // moved out of 'undefined' once acquired
  acquire: Array[vulkan.Semaphore, 2];        // one per frame in flight
  count: u32;
  current: u32;                 // the acquired image
  hasImage: bool;
  stale: bool;                  // to be made again before the next image
  wantWidth: u32;               // the size asked for, where the surface leaves it to the swapchain
  wantHeight: u32;
  depthFormat: u32;             // Vulkan's; UNDEFINED: no depth texture
  depthImage: vulkan.Image;     // one, shared by the frames in flight (a barrier orders them)
  depthMemory: vulkan.DeviceMemory;
  depthView: vulkan.ImageView;
  depthReady: bool;             // moved out of 'undefined'
  memory: vulkan.PhysicalDeviceMemoryProperties;
}

// The images a surface shows, one drawn while another is shown, and a
// depth texture of their size if asked for
pub struct SwapChain {
  backend: SwapChainBackend;
  pub width: u32;
  pub height: u32;
  pub format: u32;                  // TEXTURE_FORMAT_...
  pub depthFormat: u32;             // TEXTURE_FORMAT_...: UNDEFINED if none
  pub presents: u64;                // images presented so far

  pub fn isValid(self: &) bool { backend.swapchain.h != 0u64 }

  // Ask for textures of this size from the next frame on (the window was
  // resized). A swapchain found out of date is made again anyway; this makes
  // it so before the first failure, as a resize event can.
  pub fn resize(self: &mut, width: u32, height: u32) {
    backend.wantWidth = width;
    backend.wantHeight = height;
    backend.stale = true;
  }

  // The texture to draw into this frame, and the depth texture, beginning
  // the device's frame if it is not begun. Check 'ok()' on what it answers:
  // a minimized window has none (SKIPPED), and draws nothing.
  pub fn getCurrentTexture(self: &mut, device: &mut Device) SurfaceTexture {
    var result = SurfaceTexture(noTexture(), noTexture(), SURFACE_TEXTURE_ERROR);
    if (backend.device as *u8 as usize) == 0usize { return result; }
    if backend.hasImage {
      fail("getCurrentTexture called twice without a present between");
      return result;
    }
    if backend.stale {
      if !self.configure() {
        result.status = SURFACE_TEXTURE_SKIPPED;
        return result;
      }
    }
    if !self.isValid() {
      result.status = SURFACE_TEXTURE_SKIPPED;
      return result;
    }
    beginQueueFrame(&mut device.queue);
    let slot = usize.from(device.queue.backend.frameIndex);
    var index = 0u32;
    var r = backend.fns.acquireNextImageKHR(backend.device, backend.swapchain, NO_TIMEOUT, backend.acquire[slot],
      vulkan.Fence(0u64), &mut index);
    if r == vulkan.ERROR_OUT_OF_DATE_KHR {
      backend.stale = true;
      if !self.configure() {
        result.status = SURFACE_TEXTURE_SKIPPED;
        return result;
      }
      r = backend.fns.acquireNextImageKHR(backend.device, backend.swapchain, NO_TIMEOUT, backend.acquire[slot],
        vulkan.Fence(0u64), &mut index);
      if r == vulkan.ERROR_OUT_OF_DATE_KHR {
        result.status = SURFACE_TEXTURE_OUTDATED;
        return result;
      }
    }
    if r == vulkan.SUBOPTIMAL_KHR {
      backend.stale = true;
      result.status = SURFACE_TEXTURE_SUCCESS_SUBOPTIMAL;
    } else if check(r, "vkAcquireNextImageKHR") {
      result.status = SURFACE_TEXTURE_SUCCESS_OPTIMAL;
    } else {
      return result;
    }
    backend.current = index;
    backend.hasImage = true;
    device.queue.backend.acquired = backend.acquire[slot];
    device.queue.backend.waiting = true;

    // An image acquired for the first time is in no layout yet: move it to
    // the one kept between commands (this submission waits for the acquire)
    let i = usize.from(index);
    if !backend.initialized[i] {
      let cmd = nextCommandBuffer(&mut device.queue);
      if !isNull(cmd) {
        transition(&device.queue.fns, cmd, backend.images[i], vulkan.IMAGE_ASPECT_COLOR_BIT,
          vulkan.IMAGE_LAYOUT_UNDEFINED, vulkan.IMAGE_LAYOUT_PRESENT_SRC_KHR,
          vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_NONE,
          vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_NONE);
        check(device.queue.fns.endCommandBuffer(cmd), "vkEndCommandBuffer");
        submitCommands(&mut device.queue, cmd, vulkan.Fence(0u64), 0u32, null);
        backend.initialized[i] = true;
      }
    }
    result.texture = Texture(TextureBackend(backend.images[i], backend.views[i], KIND_SURFACE, false,
      backend.device, backend.fns, vulkan.DeviceMemory(0u64)), width, height, format, TEXTURE_USAGE_RENDER_ATTACHMENT);

    // The depth texture, moved to its attachment layout when it is new
    if backend.depthView.h != 0u64 {
      if !backend.depthReady {
        let cmd = uploadCommands(&mut device.queue);
        if !isNull(cmd) { firstLayout(&backend.fns, cmd, backend.depthImage, KIND_DEPTH); }
        backend.depthReady = true;
      }
      result.depth = Texture(TextureBackend(backend.depthImage, backend.depthView, KIND_DEPTH, false,
        backend.device, backend.fns, vulkan.DeviceMemory(0u64)), width, height, depthFormat, TEXTURE_USAGE_RENDER_ATTACHMENT);
    }
    result
  }

  // Show the texture drawn this frame, ending the device's frame. Answers
  // whether it was presented; one that is not is out of date, and the
  // swapchain is made again before the next frame.
  pub fn present(self: &mut, device: &mut Device) bool {
    if !backend.hasImage { return false; }
    backend.hasImage = false;
    let i = usize.from(backend.current);
    let signal = vulkan.SemaphoreSubmitInfo(semaphore: backend.renderDone[i],
      stageMask: vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT);
    if !endFrameSignalling(device, 1u32, &signal as *vulkan.SemaphoreSubmitInfo) { return false; }
    var sem = backend.renderDone[i];
    var sc = backend.swapchain;
    var index = backend.current;
    let pi = vulkan.PresentInfoKHR(waitSemaphoreCount: 1u32, pWaitSemaphores: &mut sem as *vulkan.Semaphore,
      swapchainCount: 1u32, pSwapchains: &mut sc as *vulkan.SwapchainKHR, pImageIndices: &mut index as *u32,
      pResults: null);
    let r = device.queue.fns.queuePresentKHR(device.queue.backend.handle, &pi);
    if r == vulkan.SUCCESS || r == vulkan.SUBOPTIMAL_KHR {
      presents = presents + 1u64;
      if r == vulkan.SUBOPTIMAL_KHR { backend.stale = true; }
      return true;
    }
    if r == vulkan.ERROR_OUT_OF_DATE_KHR {
      backend.stale = true;
      return false;
    }
    check(r, "vkQueuePresentKHR");
    false
  }

  // Make the swapchain (again) now, at the surface's size, or at the size
  // asked for where the surface leaves it to the swapchain, once the device
  // is idle, and its depth texture with it. Answers false when there is
  // nothing to make: the window has no area, or it failed.
  // 'getCurrentTexture' does this itself when the swapchain is out of date
  // or was resized.
  pub fn configure(self: &mut) bool {
    let device = backend.device;
    let fns = backend.fns;
    var caps = zeroed[vulkan.SurfaceCapabilitiesKHR]();
    if !check(backend.ifns.getPhysicalDeviceSurfaceCapabilitiesKHR(backend.physical, backend.surface, &mut caps),
        "vkGetPhysicalDeviceSurfaceCapabilitiesKHR") {
      return false;
    }
    var w = caps.currentExtent.width;
    var h = caps.currentExtent.height;
    if w == 0xFFFFFFFFu32 {
      w = clamp(backend.wantWidth, caps.minImageExtent.width, caps.maxImageExtent.width);
      h = clamp(backend.wantHeight, caps.minImageExtent.height, caps.maxImageExtent.height);
    }
    if w == 0u32 || h == 0u32 { return false; }    // minimized: stays stale until it has an area

    // The format: 8-bit BGRA or RGBA in sRGB, else whatever comes first
    if backend.format == vulkan.FORMAT_UNDEFINED {
      // How many formats, asked first, then all of them
      var n = 0u32;
      check(backend.ifns.getPhysicalDeviceSurfaceFormatsKHR(backend.physical, backend.surface, &mut n,
        null), "vkGetPhysicalDeviceSurfaceFormatsKHR");
      var formats = List[vulkan.SurfaceFormatKHR].empty();
      formats.resize(usize.from(n), vulkan.SurfaceFormatKHR(0u32, 0u32));
      let r = backend.ifns.getPhysicalDeviceSurfaceFormatsKHR(backend.physical, backend.surface, &mut n,
        formats.viewMut() as *vulkan.SurfaceFormatKHR);
      if r != vulkan.INCOMPLETE { check(r, "vkGetPhysicalDeviceSurfaceFormatsKHR"); }
      formats.truncate(usize.from(n));
      if n == 0u32 {
        fail("the surface offers no formats");
        return false;
      }
      backend.format = formats[0].format;
      backend.colorSpace = formats[0].colorSpace;
      var i = 0usize;
      while i < usize.from(n) {
        let f = formats[i].format;
        if (f == vulkan.FORMAT_B8G8R8A8_SRGB || f == vulkan.FORMAT_R8G8B8A8_SRGB)
            && formats[i].colorSpace == vulkan.COLOR_SPACE_SRGB_NONLINEAR_KHR {
          backend.format = f;
          backend.colorSpace = formats[i].colorSpace;
          i = usize.from(n);
        } else {
          i = i + 1usize;
        }
      }
      backend.usage = vulkan.IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
      if (caps.supportedUsageFlags & vulkan.IMAGE_USAGE_TRANSFER_SRC_BIT) != 0u32 {
        backend.usage = backend.usage | vulkan.IMAGE_USAGE_TRANSFER_SRC_BIT;
        backend.copyable = true;
      }
    }

    // One image more than the least, to draw into while others wait to be shown
    var count = caps.minImageCount + 1u32;
    if caps.maxImageCount != 0u32 && count > caps.maxImageCount { count = caps.maxImageCount; }
    if count > MAX_SWAPCHAIN_IMAGES { count = MAX_SWAPCHAIN_IMAGES; }

    fns.deviceWaitIdle(device);
    let old = backend.swapchain;
    let ci = vulkan.SwapchainCreateInfoKHR(surface: backend.surface, minImageCount: count,
      imageFormat: backend.format, imageColorSpace: backend.colorSpace, imageExtent: vulkan.Extent2D(w, h),
      imageUsage: backend.usage, pQueueFamilyIndices: null, preTransform: caps.currentTransform,
      oldSwapchain: old);
    var sc = vulkan.SwapchainKHR(0u64);
    let made = check(fns.createSwapchainKHR(device, &ci, nullp(), &mut sc), "vkCreateSwapchainKHR");
    self.release();
    if old.h != 0u64 { fns.destroySwapchainKHR(device, old, nullp()); }
    backend.swapchain = sc;
    if !made { return false; }

    // How many images, asked first. The driver may make more than 'count';
    // 'backend' keeps at most MAX_SWAPCHAIN_IMAGES of them
    var n = 0u32;
    check(fns.getSwapchainImagesKHR(device, sc, &mut n, null), "vkGetSwapchainImagesKHR");
    var found = List[vulkan.Image].empty();
    found.resize(usize.from(n), vulkan.Image(0u64));
    check(fns.getSwapchainImagesKHR(device, sc, &mut n, found.viewMut() as *vulkan.Image), "vkGetSwapchainImagesKHR");
    found.truncate(usize.from(n));
    if n > MAX_SWAPCHAIN_IMAGES { n = MAX_SWAPCHAIN_IMAGES; }
    var k = 0usize;
    while k < usize.from(n) {
      backend.images[k] = *found[k];
      k = k + 1usize;
    }
    backend.count = n;
    let sci = vulkan.SemaphoreCreateInfo();
    var i = 0usize;
    while i < usize.from(n) {
      let vci = vulkan.ImageViewCreateInfo(image: backend.images[i], format: backend.format,
        components: vulkan.ComponentMapping(), subresourceRange: vulkan.ImageSubresourceRange());
      var view = vulkan.ImageView(0u64);
      check(fns.createImageView(device, &vci, nullp(), &mut view), "vkCreateImageView");
      backend.views[i] = view;
      var sem = vulkan.Semaphore(0u64);
      check(fns.createSemaphore(device, &sci, nullp(), &mut sem), "vkCreateSemaphore");
      backend.renderDone[i] = sem;
      backend.initialized[i] = false;
      i = i + 1usize;
    }

    // The depth texture, at the new size
    if backend.depthFormat != vulkan.FORMAT_UNDEFINED {
      var image = vulkan.Image(0u64);
      var memory = vulkan.DeviceMemory(0u64);
      var view = vulkan.ImageView(0u64);
      makeImage(&fns, device, &backend.memory, w, h, backend.depthFormat, vulkan.IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
        &mut image, &mut memory, &mut view);
      backend.depthImage = image;
      backend.depthMemory = memory;
      backend.depthView = view;
      backend.depthReady = false;
    }
    width = w;
    height = h;
    format = textureFormat(backend.format);
    backend.stale = false;
    true
  }

  // Destroy the images' views and semaphores (the swapchain owns the
  // images), and the depth texture
  fn release(self: &mut) {
    var i = 0usize;
    while i < usize.from(backend.count) {
      backend.fns.destroyImageView(backend.device, backend.views[i], nullp());
      backend.fns.destroySemaphore(backend.device, backend.renderDone[i], nullp());
      i = i + 1usize;
    }
    backend.count = 0u32;
    if backend.depthView.h != 0u64 { backend.fns.destroyImageView(backend.device, backend.depthView, nullp()); }
    if backend.depthImage.h != 0u64 { backend.fns.destroyImage(backend.device, backend.depthImage, nullp()); }
    if backend.depthMemory.h != 0u64 { backend.fns.freeMemory(backend.device, backend.depthMemory, nullp()); }
    backend.depthView = vulkan.ImageView(0u64);
    backend.depthImage = vulkan.Image(0u64);
    backend.depthMemory = vulkan.DeviceMemory(0u64);
  }

  fn final(self: &uni) {
    if (backend.device as *u8 as usize) == 0usize { return; }
    backend.fns.deviceWaitIdle(backend.device);
    var j = 0usize;
    while j < usize.from(backend.count) {
      backend.fns.destroyImageView(backend.device, backend.views[j], nullp());
      backend.fns.destroySemaphore(backend.device, backend.renderDone[j], nullp());
      j = j + 1usize;
    }
    if backend.depthView.h != 0u64 { backend.fns.destroyImageView(backend.device, backend.depthView, nullp()); }
    if backend.depthImage.h != 0u64 { backend.fns.destroyImage(backend.device, backend.depthImage, nullp()); }
    if backend.depthMemory.h != 0u64 { backend.fns.freeMemory(backend.device, backend.depthMemory, nullp()); }
    if backend.swapchain.h != 0u64 { backend.fns.destroySwapchainKHR(backend.device, backend.swapchain, nullp()); }
    var i = 0usize;
    while i < 2usize {
      if backend.acquire[i].h != 0u64 { backend.fns.destroySemaphore(backend.device, backend.acquire[i], nullp()); }
      i = i + 1usize;
    }
  }
}

fn clamp(v: u32, lo: u32, hi: u32) u32 {
  if v < lo { return lo; }
  if v > hi { return hi; }
  v
}
