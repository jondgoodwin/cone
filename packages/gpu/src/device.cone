// ---- Device and CommandQueue: the Device, the end of a frame, and the memory,
// image and pipeline-layout helpers the Device uses ----

// A logical GPU: what makes buffers, textures, shaders, pipelines, command
// encoders and swapchains
pub struct Device {
  backend DeviceBackend;
  pub queue CommandQueue;
  pub frameNumber u64;             // frames ended so far
  pub timestampPeriod f32 = 0.;    // nanoseconds a timestamp's tick; 0: its queue keeps no time
  pub maxAnisotropy f32 = 0.;      // the most anisotropic filtering a sampler may ask for; 0: the GPU has none

  pub fn isValid(self &) bool { (backend.device as *u8 as usize) != 0usize; }

  // Begin a frame, if one is not begun: wait until the GPU has finished the
  // frame that last used this frame's state, and reset its command pools.
  // 'getCurrentTexture', 'createCommandEncoder', 'writeBuffer' and
  // 'createTexture' begin one themselves.
  pub fn beginFrame(self &mut) { beginQueueFrame(&mut queue); }

  // End a frame that presents nothing (a swapchain's 'present' ends its own):
  // its fence is signalled once all it submitted is done
  pub fn endFrame(self &mut) {
    if !queue.backend.inFrame { return; }
    endFrameSignalling(self, 0u32, null);
  }

  // Wait until the GPU has finished everything submitted
  pub fn waitIdle(self &mut) {
    if self.isValid() { check(vulkan.deviceWaitIdle(backend.device), "vkDeviceWaitIdle"); }
  }

  // Whether the GPU has finished frame 'frame' (the 'frameNumber' it was
  // recorded under: every command submitted in it, and the uploads before
  // them). Never waits. False while the frame is still being recorded, since
  // its fence is signalled only when it ends ('endFrame', or a swapchain's
  // 'present').
  pub fn frameDone(self &, frame u64) bool {
    if frame >= frameNumber { return false; }
    if !self.isValid() { return true; }
    // Its state comes round again FRAMES_IN_FLIGHT frames on, and the frame
    // that reuses it waited for its fence when it began
    imm reuser = frame + u64.from(FRAMES_IN_FLIGHT);
    if reuser < frameNumber or (reuser == frameNumber and queue.backend.inFrame) { return true; }
    imm i = usize.from(frame % u64.from(FRAMES_IN_FLIGHT));
    if !queue.backend.frames[i].pending { return true; }
    mut fence = queue.backend.frames[i].fence;
    vulkan.waitForFences(backend.device, 1u32, &mut fence as *vulkan.Fence, vulkan.TRUE, 0u64) == vulkan.SUCCESS;
  }

  // Wait until the GPU has finished frame 'frame', and nothing submitted
  // after it. A frame still being recorded is not waited for, since it would
  // never finish: end it first.
  pub fn waitFrame(self &mut, frame u64) {
    if frame >= frameNumber or self.frameDone(frame) { return; }
    imm i = usize.from(frame % u64.from(FRAMES_IN_FLIGHT));
    mut fence = queue.backend.frames[i].fence;
    check(vulkan.waitForFences(backend.device, 1u32, &mut fence as *vulkan.Fence, vulkan.TRUE, NO_TIMEOUT),
      "vkWaitForFences");
  }

  // A fence of its own, unsignalled, for one submission
  // ('queue.submitSignalling' or 'queue.signal'), which another thread may
  // wait on: it is never reset or reused, as a frame's fence is. Check
  // 'isValid'.
  pub fn createFence(self &) Fence {
    mut fence = new vulkan.Fence(0u64);
    if self.isValid() {
      imm fci = new vulkan.FenceCreateInfo();
      check(vulkan.createFence(backend.device, &fci, nullp(), &mut fence), "vkCreateFence");
    }
    new Fence(backend.device, fence, false);
  }

  // A command encoder, recording into a command buffer of this frame's
  pub fn createCommandEncoder(self &mut) CommandEncoder {
    beginQueueFrame(&mut queue);
    imm cmd = nextCommandBuffer(&mut queue);
    new CommandEncoder(new EncoderBackend(cmd));
  }

  // A swapchain presenting to 'surface', its textures 'width' by 'height'
  // (the window's drawable size, window's 'size'), in an sRGB format where
  // the surface offers one, presented in step with the display's refresh
  // (WebGPU's "fifo"). With 'depthFormat' TEXTURE_FORMAT_DEPTH32_FLOAT, it
  // also keeps a depth texture of its size, made again with it
  // (TEXTURE_FORMAT_UNDEFINED: none). Check 'isValid'.
  pub fn createSwapChain(self &mut, surface &Surface, width u32, height u32, depthFormat u32) SwapChain {
    mut sc = new SwapChain(new SwapChainBackend(backend.device, backend.physical, surface.backend.surface,
      new vulkan.SwapchainKHR(0u64), vulkan.FORMAT_UNDEFINED, 0u32, 0u32, false,
      new Array[vulkan.Image, 8] <- fill new vulkan.Image(0u64),
      new Array[vulkan.ImageView, 8] <- fill new vulkan.ImageView(0u64),
      new Array[vulkan.Semaphore, 8] <- fill new vulkan.Semaphore(0u64), new Array[bool, 8] <- fill false,
      new Array[vulkan.Semaphore, 2] <- fill new vulkan.Semaphore(0u64), 0u32, 0u32, false, true, width, height,
      vkFormat(depthFormat), new vulkan.Image(0u64), new vulkan.DeviceMemory(0u64), new vulkan.ImageView(0u64), false,
      queue.backend.memory),
      0u32, 0u32, TEXTURE_FORMAT_UNDEFINED, depthFormat, 0u64);
    if !self.isValid() or !surface.isValid() { return sc; }
    imm sci = new vulkan.SemaphoreCreateInfo();
    mut i = 0usize;
    while i < 2usize {
      mut sem = new vulkan.Semaphore(0u64);
      check(vulkan.createSemaphore(backend.device, &sci, nullp(), &mut sem), "vkCreateSemaphore");
      sc.backend.acquire[i] = sem;
      i = i + 1usize;
    }
    sc.configure();
    sc;
  }

  // A buffer of 'size' bytes, for 'usage' (BUFFER_USAGE_... OR-ed). One the
  // CPU maps (MAP_READ or MAP_WRITE) is in memory the CPU sees, and mapped
  // for as long as it lives: one it only reads (MAP_READ alone) in memory
  // the CPU caches, where the GPU has it, so reading it back is fast; any
  // other is in the GPU's own memory, written by 'queue.writeBuffer' (with
  // COPY_DST) or cleared by 'queue.clearBuffer'. Check 'isValid'.
  pub fn createBuffer(self &mut, size u64, usage u32) Buffer {
    mut vkUsage = 0u32;
    if (usage & BUFFER_USAGE_COPY_SRC) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_TRANSFER_SRC_BIT; }
    if (usage & (BUFFER_USAGE_COPY_DST | BUFFER_USAGE_QUERY_RESOLVE)) != 0u32 {
      vkUsage = vkUsage | vulkan.BUFFER_USAGE_TRANSFER_DST_BIT;
    }
    if (usage & BUFFER_USAGE_INDEX) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_INDEX_BUFFER_BIT; }
    if (usage & BUFFER_USAGE_VERTEX) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_VERTEX_BUFFER_BIT; }
    if (usage & BUFFER_USAGE_UNIFORM) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_UNIFORM_BUFFER_BIT; }
    if (usage & BUFFER_USAGE_STORAGE) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_STORAGE_BUFFER_BIT; }
    if (usage & BUFFER_USAGE_INDIRECT) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_INDIRECT_BUFFER_BIT; }
    imm mapping = usage & (BUFFER_USAGE_MAP_READ | BUFFER_USAGE_MAP_WRITE);
    mut b = new BufferBackend(backend.device, new vulkan.Buffer(0u64), new vulkan.DeviceMemory(0u64), nullp(), true);
    if self.isValid() { b = allocateBuffer(backend.device, &queue.backend.memory, size, vkUsage, mapping); }
    new Buffer(b, size, usage);
  }

  // A texture 'desc' describes, in the GPU's own memory: one to draw into,
  // its usage TEXTURE_USAGE_RENDER_ATTACHMENT (and TEXTURE_USAGE_COPY_SRC to
  // read it back), its format a color format or TEXTURE_FORMAT_DEPTH32_FLOAT;
  // one shaders sample, its usage TEXTURE_USAGE_TEXTURE_BINDING (and
  // TEXTURE_USAGE_COPY_DST, for 'queue.writeTexture' to fill it), of a color
  // format; with both usages, a color texture drawn into by some passes
  // and sampled by later ones (an HDR frame, a bloom chain, a cube map drawn
  // face by face and level by level); or a storage texture that compute
  // shaders read and write texel by texel, its usage
  // TEXTURE_USAGE_STORAGE_BINDING (with TEXTURE_BINDING too, if later passes
  // sample it), of r32float, r32uint, rgba16float or rgba8unorm. A 3-D
  // texture ('dimension' TEXTURE_DIMENSION_3D) is sampled or a storage
  // texture, not drawn into, and at most MAX_TEXTURE_DIMENSION_3D each way.
  // It is moved to the layout it rests in ahead of the next submission.
  // Check 'isValid'.
  pub fn createTexture(self &mut, desc &TextureDescriptor) Texture {
    mut result = new Texture(new TextureBackend(new vulkan.Image(0u64), new vulkan.ImageView(0u64), KIND_NONE, true,
      backend.device, new vulkan.DeviceMemory(0u64)), desc.width, desc.height, desc.format, desc.usage,
      desc.mipLevelCount, desc.depthOrArrayLayers, desc.dimension);
    if !self.isValid() { return result; }
    imm attachment = (desc.usage & TEXTURE_USAGE_RENDER_ATTACHMENT) != 0u32;
    imm sampled = (desc.usage & TEXTURE_USAGE_TEXTURE_BINDING) != 0u32;
    imm storage = (desc.usage & TEXTURE_USAGE_STORAGE_BINDING) != 0u32;
    imm volume = desc.dimension == TEXTURE_DIMENSION_3D;
    if !attachment and !sampled and !storage {
      fail("createTexture: a texture is drawn into (TEXTURE_USAGE_RENDER_ATTACHMENT), sampled (TEXTURE_USAGE_TEXTURE_BINDING), a storage texture (TEXTURE_USAGE_STORAGE_BINDING), or more than one");
      return result;
    }
    if desc.dimension != TEXTURE_DIMENSION_2D and !volume {
      fail("createTexture: a texture is 2-D or 3-D");
      return result;
    }
    imm format = vkFormat(desc.format);
    if format == vulkan.FORMAT_UNDEFINED {
      fail("createTexture: the format is not one offered");
      return result;
    }
    // The levels halve all three sides of a 3-D texture, the width and
    // height of a 2-D one
    mut largest = umax(desc.width, desc.height);
    if volume { largest = umax(largest, desc.depthOrArrayLayers); }
    if desc.mipLevelCount == 0u32 or desc.mipLevelCount > 16u32 or desc.depthOrArrayLayers == 0u32
        or (largest >> (desc.mipLevelCount - 1u32)) == 0u32 {
      fail("createTexture: no levels or layers, or more levels than halving its size allows");
      return result;
    }
    imm depth = desc.format == TEXTURE_FORMAT_DEPTH32_FLOAT;
    if sampled and depth {
      fail("createTexture: a depth texture is not sampled yet");
      return result;
    }
    if storage and (attachment or !isStorageFormat(desc.format)) {
      fail("createTexture: a storage texture is r32float, r32uint, rgba16float or rgba8unorm, and not drawn into (yet)");
      return result;
    }
    if volume and (attachment or largest > MAX_TEXTURE_DIMENSION_3D) {
      fail("createTexture: a 3-D texture is not drawn into (yet), and is at most 2048 texels each way");
      return result;
    }
    mut kind = KIND_COLOR;
    mut vkUsage = vulkan.IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
    if depth {
      kind = KIND_DEPTH;
      vkUsage = vulkan.IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT;
    }
    if sampled {
      kind = KIND_SAMPLED;
      vkUsage = 0u32;
      if attachment {
        kind = KIND_RENDER_SAMPLED;
        vkUsage = vulkan.IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
      }
    }
    if storage {
      kind = KIND_STORAGE;
      vkUsage = vulkan.IMAGE_USAGE_STORAGE_BIT;
    }
    if (desc.usage & TEXTURE_USAGE_COPY_SRC) != 0u32 { vkUsage = vkUsage | vulkan.IMAGE_USAGE_TRANSFER_SRC_BIT; }
    if (desc.usage & TEXTURE_USAGE_COPY_DST) != 0u32 { vkUsage = vkUsage | vulkan.IMAGE_USAGE_TRANSFER_DST_BIT; }
    if (desc.usage & TEXTURE_USAGE_TEXTURE_BINDING) != 0u32 { vkUsage = vkUsage | vulkan.IMAGE_USAGE_SAMPLED_BIT; }
    // Six square layers, or a multiple of six, may be seen as a cube (wgpu's
    // rule: WebGPU decides at the view)
    mut flags = 0u32;
    if !volume and desc.depthOrArrayLayers % 6u32 == 0u32 and desc.width == desc.height {
      flags = vulkan.IMAGE_CREATE_CUBE_COMPATIBLE_BIT;
    }
    mut image = new vulkan.Image(0u64);
    mut memory = new vulkan.DeviceMemory(0u64);
    mut view = new vulkan.ImageView(0u64);
    if !makeImageLevels(backend.device, &queue.backend.memory, desc.width, desc.height, format, vkUsage,
        desc.mipLevelCount, desc.depthOrArrayLayers, flags, volume, &mut image, &mut memory, &mut view) {
      return result;
    }
    result.backend.image = image;
    result.backend.memory = memory;
    result.backend.view = view;
    result.backend.kind = kind;
    result.backend.mipCount = desc.mipLevelCount;
    result.backend.layerCount = if volume { 1u32; } else { desc.depthOrArrayLayers; };
    // Room for a view of each level of each layer, a cube and an array view
    // of each level, and a few more
    result.backend.views = newViews(desc.mipLevelCount * (desc.depthOrArrayLayers + 2u32) + 8u32);
    imm cmd = uploadCommands(&mut queue);
    if !isNull(cmd) { firstLayout(cmd, image, kind); }
    result;
  }

  // A shader module from SPIR-V: 32-bit words, as tools/shaders/shaders.py
  // embeds them. A compute entry point's workgroup must be within WebGPU's
  // limits (MAX_COMPUTE_WORKGROUP_SIZE_X and the rest). Check 'isValid'.
  pub fn createShaderModule(self &, spirv &[]u32) ShaderModule {
    mut module = new vulkan.ShaderModule(0u64);
    if self.isValid() and spirv.len > 0usize and workgroupsWithinLimits(spirv) {
      imm ci = new vulkan.ShaderModuleCreateInfo(codeSize: spirv.len * 4usize, pCode: &spirv[0] as *u32);
      check(vulkan.createShaderModule(backend.device, &ci, nullp(), &mut module), "vkCreateShaderModule");
    }
    new ShaderModule(new ShaderModuleBackend(backend.device, module));
  }

  // A bind group layout: the bindings a bind group of it has, each a
  // uniform or storage buffer, a sampler, a texture or a storage texture,
  // seen by the stages its 'visibility' names.
  // Bindings are numbered below MAX_BINDINGS. Check 'isValid'.
  pub fn createBindGroupLayout(self &, entries &[]BindGroupLayoutEntry) BindGroupLayout {
    mut result = new BindGroupLayout(new BindGroupLayoutBackend(backend.device, new vulkan.DescriptorSetLayout(0u64),
      new Array[u32, 16] <- fill 0u32, new Array[u32, 3] <- fill 0u32, new Array[u32, 3] <- fill 0u32));
    if !self.isValid() { return result; }
    if entries.len > usize.from(MAX_BINDINGS) {
      fail("createBindGroupLayout: more than 16 entries");
      return result;
    }
    mut bindings = new Array[vulkan.DescriptorSetLayoutBinding, 16] <- fill new vulkan.DescriptorSetLayoutBinding(
      pImmutableSamplers: null);
    mut i = 0usize;
    while i < entries.len {
      imm e = entries[i];
      if e.binding >= MAX_BINDINGS {
        fail("createBindGroupLayout: a binding numbered 16 or more");
        return result;
      }
      imm storageBuffer = e.kind == BINDING_KIND_BUFFER and e.bufferType != BUFFER_BINDING_TYPE_UNIFORM;
      imm storageTexture = e.kind == BINDING_KIND_STORAGE_TEXTURE;
      if !bindingWithinWebGPU(&e) { return result; }
      imm type = descriptorType(e.kind, e.bufferType);
      bindings[i].binding = e.binding;
      bindings[i].descriptorType = type;
      bindings[i].stageFlags = shaderStages(e.visibility);
      result.backend.types[usize.from(e.binding)] = type;
      // What each stage sees, counted for the pipeline layout's limits
      mut s = 0usize;
      while s < 3usize {
        if (e.visibility & (1u32 << u32.from(s))) != 0u32 {
          if storageBuffer { result.backend.storageBuffers[s] = result.backend.storageBuffers[s] + 1u32; }
          if storageTexture { result.backend.storageTextures[s] = result.backend.storageTextures[s] + 1u32; }
        }
        s = s + 1usize;
      }
      i = i + 1usize;
    }
    imm ci = new vulkan.DescriptorSetLayoutCreateInfo(bindingCount: u32.from(entries.len),
      pBindings: &bindings as *vulkan.DescriptorSetLayoutBinding);
    mut layout = new vulkan.DescriptorSetLayout(0u64);
    check(vulkan.createDescriptorSetLayout(backend.device, &ci, nullp(), &mut layout), "vkCreateDescriptorSetLayout");
    result.backend.layout = layout;
    result;
  }

  // A pipeline layout: the bind groups a pipeline of it binds, in order
  // (group 0 first, at most MAX_BIND_GROUPS), and 'immediateSize' bytes of
  // immediates (a multiple of 4, at most MAX_IMMEDIATE_SIZE; 0 for none).
  // No stage may see more than MAX_STORAGE_BUFFERS_PER_SHADER_STAGE storage
  // buffers or MAX_STORAGE_TEXTURES_PER_SHADER_STAGE storage textures in all
  // (WebGPU's limits). Check 'isValid'.
  pub fn createPipelineLayout(self &, bindGroupLayouts &[]&BindGroupLayout, immediateSize u32) PipelineLayout {
    if bindGroupLayouts.len > usize.from(MAX_BIND_GROUPS) {
      fail("createPipelineLayout: more than 4 bind groups");
      return new PipelineLayout(new PipelineLayoutBackend(backend.device, new vulkan.PipelineLayout(0u64)), 0u32);
    }
    mut sets = new Array[vulkan.DescriptorSetLayout, 4] <- fill new vulkan.DescriptorSetLayout(0u64);
    mut buffers = new Array[u32, 3] <- fill 0u32;
    mut textures = new Array[u32, 3] <- fill 0u32;
    mut i = 0usize;
    while i < bindGroupLayouts.len {
      sets[i] = bindGroupLayouts[i].backend.layout;
      mut s = 0usize;
      while s < 3usize {
        buffers[s] = buffers[s] + bindGroupLayouts[i].backend.storageBuffers[s];
        textures[s] = textures[s] + bindGroupLayouts[i].backend.storageTextures[s];
        s = s + 1usize;
      }
      i = i + 1usize;
    }
    mut s = 0usize;
    while s < 3usize {
      if buffers[s] > MAX_STORAGE_BUFFERS_PER_SHADER_STAGE or textures[s] > MAX_STORAGE_TEXTURES_PER_SHADER_STAGE {
        fail("createPipelineLayout: a stage sees more than 8 storage buffers or 4 storage textures (WebGPU's limits)");
        return new PipelineLayout(new PipelineLayoutBackend(backend.device, new vulkan.PipelineLayout(0u64)), 0u32);
      }
      s = s + 1usize;
    }
    makePipelineLayout(backend.device, u32.from(bindGroupLayouts.len), &sets, immediateSize);
  }

  // A pipeline layout with no bind groups, only 'immediateSize' bytes of
  // immediates (0 for none)
  pub fn createEmptyPipelineLayout(self &, immediateSize u32) PipelineLayout {
    imm sets = new Array[vulkan.DescriptorSetLayout, 4] <- fill new vulkan.DescriptorSetLayout(0u64);
    makePipelineLayout(backend.device, 0u32, &sets, immediateSize);
  }

  // A render pipeline, as 'desc' describes it: what its shaders are, how
  // vertices are read from vertex buffers, how triangles are rasterized, and
  // the formats of the color target and (if any) the depth texture it draws
  // into. The viewport and the scissor rectangle are set as it draws (a
  // render pass sets them to the whole target when it begins). Check
  // 'isValid'.
  pub fn createRenderPipeline(self &, desc &RenderPipelineDescriptor) RenderPipeline {
    mut result = new RenderPipeline(new PipelineBackend(backend.device, new vulkan.Pipeline(0u64), desc.layout.backend.layout));
    if !self.isValid() { return result; }

    // The two stages
    mut vertexName = String.from(desc.vertexEntryPoint);
    mut fragmentName = String.from(desc.fragmentEntryPoint);
    mut stages = new Array[vulkan.PipelineShaderStageCreateInfo, 2] <- fill new vulkan.PipelineShaderStageCreateInfo(
      module: new vulkan.ShaderModule(0u64), pName: nullp(), pSpecializationInfo: nullp());
    stages[0].stage = vulkan.SHADER_STAGE_VERTEX_BIT;
    stages[0].module = desc.vertexModule.backend.module;
    stages[0].pName = vertexName.cstr();
    stages[1].stage = vulkan.SHADER_STAGE_FRAGMENT_BIT;
    stages[1].module = desc.fragmentModule.backend.module;
    stages[1].pName = fragmentName.cstr();

    // The vertex buffers, and their attributes
    if desc.buffers.len > usize.from(MAX_VERTEX_BUFFERS) {
      fail("createRenderPipeline: more than 8 vertex buffers");
      return result;
    }
    mut bindings = new Array[vulkan.VertexInputBindingDescription, 8] <- fill new vulkan.VertexInputBindingDescription(0u32, 0u32);
    mut attributes = new Array[vulkan.VertexInputAttributeDescription, 16] <- fill new vulkan.VertexInputAttributeDescription(
      0u32, 0u32, 0u32, 0u32);
    mut attributeCount = 0usize;
    mut b = 0usize;
    while b < desc.buffers.len {
      imm layout = desc.buffers[b];
      bindings[b].binding = u32.from(b);
      bindings[b].stride = u32.from(layout.arrayStride);
      if layout.stepMode == VERTEX_STEP_MODE_INSTANCE { bindings[b].inputRate = vulkan.VERTEX_INPUT_RATE_INSTANCE; }
      mut a = 0usize;
      while a < layout.attributes.len {
        if attributeCount == usize.from(MAX_VERTEX_ATTRIBUTES) {
          fail("createRenderPipeline: more than 16 vertex attributes");
          return result;
        }
        imm attribute = layout.attributes[a];
        attributes[attributeCount] = new vulkan.VertexInputAttributeDescription(attribute.shaderLocation, u32.from(b),
          vertexFormat(attribute.format), u32.from(attribute.offset));
        attributeCount = attributeCount + 1usize;
        a = a + 1usize;
      }
      b = b + 1usize;
    }
    imm vertexInput = new vulkan.PipelineVertexInputStateCreateInfo(
      vertexBindingDescriptionCount: u32.from(desc.buffers.len),
      pVertexBindingDescriptions: &bindings as *vulkan.VertexInputBindingDescription,
      vertexAttributeDescriptionCount: u32.from(attributeCount),
      pVertexAttributeDescriptions: &attributes as *vulkan.VertexInputAttributeDescription);
    imm inputAssembly = new vulkan.PipelineInputAssemblyStateCreateInfo(topology: topology(desc.topology));
    imm viewport = new vulkan.PipelineViewportStateCreateInfo(viewportCount: 1u32,
      pViewports: null, scissorCount: 1u32, pScissors: null);

    // Rasterization: which faces are culled, and which way round a front
    // face goes (the viewport is flipped, so the screen's way round is
    // Vulkan's)
    mut cull = vulkan.CULL_MODE_NONE;
    if desc.cullMode == CULL_MODE_FRONT { cull = vulkan.CULL_MODE_FRONT_BIT; }
    if desc.cullMode == CULL_MODE_BACK { cull = vulkan.CULL_MODE_BACK_BIT; }
    mut front = vulkan.FRONT_FACE_COUNTER_CLOCKWISE;
    if desc.frontFace == FRONT_FACE_CW { front = vulkan.FRONT_FACE_CLOCKWISE; }
    imm raster = new vulkan.PipelineRasterizationStateCreateInfo(cullMode: cull, frontFace: front);
    imm multisample = new vulkan.PipelineMultisampleStateCreateInfo(pSampleMask: null);

    // Depth
    imm hasDepth = desc.depthFormat != TEXTURE_FORMAT_UNDEFINED;
    mut depthState = new vulkan.PipelineDepthStencilStateCreateInfo(front: new vulkan.StencilOpState(),
      back: new vulkan.StencilOpState());
    if hasDepth {
      depthState.depthTestEnable = vulkan.TRUE;
      if desc.depthWriteEnabled { depthState.depthWriteEnable = vulkan.TRUE; }
      depthState.depthCompareOp = desc.depthCompare - 1u32;    // Vulkan's order, from 0
    }

    // One color target, written whole unless the descriptor blends
    mut blendAttachment = new vulkan.PipelineColorBlendAttachmentState();
    if desc.blendEnabled {
      blendAttachment.blendEnable = vulkan.TRUE;
      blendAttachment.srcColorBlendFactor = blendFactor(desc.colorSrcFactor);
      blendAttachment.dstColorBlendFactor = blendFactor(desc.colorDstFactor);
      blendAttachment.srcAlphaBlendFactor = blendFactor(desc.alphaSrcFactor);
      blendAttachment.dstAlphaBlendFactor = blendFactor(desc.alphaDstFactor);
    }
    imm blend = new vulkan.PipelineColorBlendStateCreateInfo(attachmentCount: 1u32,
      pAttachments: &blendAttachment as *vulkan.PipelineColorBlendAttachmentState, blendConstants: new Array[f32, 4] <- fill 0f);
    imm dynamics Array[u32, 2] = [vulkan.DYNAMIC_STATE_VIEWPORT, vulkan.DYNAMIC_STATE_SCISSOR];
    imm dynamic = new vulkan.PipelineDynamicStateCreateInfo(dynamicStateCount: 2u32,
      pDynamicStates: &dynamics as *u32);
    imm colorFormats Array[u32, 1] = [vkFormat(desc.colorFormat)];
    mut rendering = new vulkan.PipelineRenderingCreateInfo(colorAttachmentCount: 1u32,
      pColorAttachmentFormats: &colorFormats as *u32);
    if hasDepth { rendering.depthAttachmentFormat = vkFormat(desc.depthFormat); }

    imm ci = new vulkan.GraphicsPipelineCreateInfo(pNext: &rendering as *u8, stageCount: 2u32,
      pStages: &stages as *vulkan.PipelineShaderStageCreateInfo,
      pVertexInputState: &vertexInput as *vulkan.PipelineVertexInputStateCreateInfo,
      pInputAssemblyState: &inputAssembly as *vulkan.PipelineInputAssemblyStateCreateInfo,
      pTessellationState: nullp(),
      pViewportState: &viewport as *vulkan.PipelineViewportStateCreateInfo,
      pRasterizationState: &raster as *vulkan.PipelineRasterizationStateCreateInfo,
      pMultisampleState: &multisample as *vulkan.PipelineMultisampleStateCreateInfo,
      pDepthStencilState: &depthState as *vulkan.PipelineDepthStencilStateCreateInfo,
      pColorBlendState: &blend as *vulkan.PipelineColorBlendStateCreateInfo,
      pDynamicState: &dynamic as *vulkan.PipelineDynamicStateCreateInfo,
      layout: desc.layout.backend.layout, renderPass: new vulkan.RenderPass(0u64),
      basePipelineHandle: new vulkan.Pipeline(0u64));
    mut pipeline = new vulkan.Pipeline(0u64);
    check(vulkan.createGraphicsPipelines(backend.device, new vulkan.PipelineCache(0u64), 1u32,
      &ci as *vulkan.GraphicsPipelineCreateInfo, nullp(), &mut pipeline as *vulkan.Pipeline), "vkCreateGraphicsPipelines");
    result.backend.pipeline = pipeline;
    result;
  }

  // A compute pipeline, as 'desc' describes it: its shader's entry point
  // and the layout of what it binds. Check 'isValid'.
  pub fn createComputePipeline(self &, desc &ComputePipelineDescriptor) ComputePipeline {
    mut result = new ComputePipeline(new PipelineBackend(backend.device, new vulkan.Pipeline(0u64), desc.layout.backend.layout));
    if !self.isValid() or !desc.module.isValid() or !desc.layout.isValid() { return result; }
    mut name = String.from(desc.entryPoint);
    imm stage = new vulkan.PipelineShaderStageCreateInfo(stage: vulkan.SHADER_STAGE_COMPUTE_BIT,
      module: desc.module.backend.module, pName: name.cstr(), pSpecializationInfo: nullp());
    imm ci = new vulkan.ComputePipelineCreateInfo(stage: stage, layout: desc.layout.backend.layout,
      basePipelineHandle: new vulkan.Pipeline(0u64));
    mut pipeline = new vulkan.Pipeline(0u64);
    check(vulkan.createComputePipelines(backend.device, new vulkan.PipelineCache(0u64), 1u32,
      &ci as *vulkan.ComputePipelineCreateInfo, nullp(), &mut pipeline as *vulkan.Pipeline), "vkCreateComputePipelines");
    result.backend.pipeline = pipeline;
    result;
  }

  // A query set of 'count' queries (at most MAX_QUERY_COUNT) of 'type':
  // QUERY_TYPE_TIMESTAMP, the GPU's clock, written by
  // 'encoder.writeTimestamp' and copied into a buffer by
  // 'encoder.resolveQuerySet'. The device must keep time
  // ('timestampPeriod' above 0). Check 'isValid'.
  pub fn createQuerySet(self &, type u32, count u32) QuerySet {
    mut result = new QuerySet(new QuerySetBackend(backend.device, new vulkan.QueryPool(0u64)), type, count);
    if !self.isValid() { return result; }
    if type != QUERY_TYPE_TIMESTAMP or count == 0u32 or count > MAX_QUERY_COUNT or timestampPeriod <= 0. {
      fail("createQuerySet: timestamps only, 1 to 4096 of them, on a device that keeps time");
      return result;
    }
    imm ci = new vulkan.QueryPoolCreateInfo(queryType: vulkan.QUERY_TYPE_TIMESTAMP, queryCount: count);
    mut pool = new vulkan.QueryPool(0u64);
    check(vulkan.createQueryPool(backend.device, &ci, nullp(), &mut pool), "vkCreateQueryPool");
    result.backend.pool = pool;
    result;
  }

  // A sampler, filtering and wrapping as 'desc' says. Check 'isValid'.
  pub fn createSampler(self &, desc &SamplerDescriptor) Sampler {
    mut sampler = new vulkan.Sampler(0u64);
    if self.isValid() {
      mut mipmapMode = vulkan.SAMPLER_MIPMAP_MODE_NEAREST;
      if desc.mipmapFilter == FILTER_MODE_LINEAR { mipmapMode = vulkan.SAMPLER_MIPMAP_MODE_LINEAR; }
      mut ci = new vulkan.SamplerCreateInfo(magFilter: vkFilter(desc.magFilter),
        minFilter: vkFilter(desc.minFilter), mipmapMode: mipmapMode, addressModeU: vkAddressMode(desc.addressModeU),
        addressModeV: vkAddressMode(desc.addressModeV), addressModeW: vkAddressMode(desc.addressModeW),
        minLod: desc.lodMinClamp, maxLod: desc.lodMaxClamp);
      // Anisotropic filtering where asked for (above 1) and the device has it,
      // as much as it can do if that is less
      mut want = f32.from(desc.maxAnisotropy);
      if want > maxAnisotropy { want = maxAnisotropy; }
      if want > 1. {
        ci.anisotropyEnable = vulkan.TRUE;
        ci.maxAnisotropy = want;
      }
      check(vulkan.createSampler(backend.device, &ci, nullp(), &mut sampler), "vkCreateSampler");
    }
    new Sampler(new SamplerBackend(backend.device, sampler));
  }

  // A bind group of 'layout': what each of its bindings is given ('entries',
  // one for each binding the layout has, of the kind it has: a buffer, a
  // texture's view or a sampler). Check 'isValid'.
  pub fn createBindGroup(self &, layout &BindGroupLayout, entries &[]BindGroupEntry) BindGroup {
    mut result = new BindGroup(new BindGroupBackend(backend.device, new vulkan.DescriptorPool(0u64), new vulkan.DescriptorSet(0u64)));
    if !self.isValid() { return result; }
    if entries.len > usize.from(MAX_BINDINGS) {
      fail("createBindGroup: more than 16 entries");
      return result;
    }
    // A pool of its own, holding just its set: destroying the pool frees it
    // How many of each descriptor type: uniform and storage buffers,
    // samplers, sampled images, storage images
    imm types Array[u32, 5] = [vulkan.DESCRIPTOR_TYPE_UNIFORM_BUFFER, vulkan.DESCRIPTOR_TYPE_STORAGE_BUFFER,
      vulkan.DESCRIPTOR_TYPE_SAMPLER, vulkan.DESCRIPTOR_TYPE_SAMPLED_IMAGE, vulkan.DESCRIPTOR_TYPE_STORAGE_IMAGE];
    mut counts = new Array[u32, 5] <- fill 0u32;
    mut i = 0usize;
    while i < entries.len {
      if entries[i].binding >= MAX_BINDINGS { return result; }
      imm type = layout.backend.types[usize.from(entries[i].binding)];
      // A storage buffer's binding: WebGPU's alignment and size limits
      if type == vulkan.DESCRIPTOR_TYPE_STORAGE_BUFFER {
        imm b = entries[i].backend;
        mut size = b.size;
        if size == WHOLE_SIZE and b.bufferSize >= b.offset { size = b.bufferSize - b.offset; }
        if b.offset % MIN_STORAGE_BUFFER_OFFSET_ALIGNMENT != 0u64 or size > MAX_STORAGE_BUFFER_BINDING_SIZE {
          fail("createBindGroup: a storage buffer bound from an offset not a multiple of 256, or more than 128 MiB of it");
          return result;
        }
      }
      mut t = 0usize;
      while t < 5usize {
        if types[t] == type { counts[t] = counts[t] + 1u32; }
        t = t + 1usize;
      }
      i = i + 1usize;
    }
    mut sizes = new Array[vulkan.DescriptorPoolSize, 5] <- fill new vulkan.DescriptorPoolSize(vulkan.DESCRIPTOR_TYPE_UNIFORM_BUFFER, 1u32);
    mut sizeCount = 0usize;
    mut t = 0usize;
    while t < 5usize {
      if counts[t] > 0u32 {
        sizes[sizeCount] = new vulkan.DescriptorPoolSize(types[t], counts[t]);
        sizeCount = sizeCount + 1usize;
      }
      t = t + 1usize;
    }
    imm pci = new vulkan.DescriptorPoolCreateInfo(maxSets: 1u32, poolSizeCount: u32.from(sizeCount),
      pPoolSizes: &sizes as *vulkan.DescriptorPoolSize);
    mut pool = new vulkan.DescriptorPool(0u64);
    if !check(vulkan.createDescriptorPool(backend.device, &pci, nullp(), &mut pool), "vkCreateDescriptorPool") {
      return result;
    }
    result.backend.pool = pool;
    mut setLayout = layout.backend.layout;
    imm ai = new vulkan.DescriptorSetAllocateInfo(descriptorPool: pool, descriptorSetCount: 1u32,
      pSetLayouts: &mut setLayout as *vulkan.DescriptorSetLayout);
    mut set = new vulkan.DescriptorSet(0u64);
    if !check(vulkan.allocateDescriptorSets(backend.device, &ai, &mut set as *vulkan.DescriptorSet),
        "vkAllocateDescriptorSets") {
      return result;
    }
    result.backend.set = set;

    mut infos = new Array[vulkan.DescriptorBufferInfo, 16] <- fill new vulkan.DescriptorBufferInfo(new vulkan.Buffer(0u64), 0u64, 0u64);
    mut images = new Array[vulkan.DescriptorImageInfo, 16] <- fill new vulkan.DescriptorImageInfo(new vulkan.Sampler(0u64),
      new vulkan.ImageView(0u64), vulkan.IMAGE_LAYOUT_UNDEFINED);
    mut writes = new Array[vulkan.WriteDescriptorSet, 16] <- fill new vulkan.WriteDescriptorSet(
      dstSet: new vulkan.DescriptorSet(0u64), pImageInfo: null,
      pBufferInfo: null, pTexelBufferView: null);
    i = 0usize;
    while i < entries.len {
      imm e = entries[i];
      writes[i].dstSet = set;
      writes[i].dstBinding = e.binding;
      writes[i].descriptorCount = 1u32;
      writes[i].descriptorType = layout.backend.types[usize.from(e.binding)];
      if e.backend.kind == BINDING_KIND_BUFFER {
        mut range = e.backend.size;
        if range == WHOLE_SIZE { range = vulkan.WHOLE_SIZE; }
        infos[i] = new vulkan.DescriptorBufferInfo(e.backend.buffer, e.backend.offset, range);
        writes[i].pBufferInfo = (&infos as *u8 + i * mem.sizeof[vulkan.DescriptorBufferInfo]()) as *vulkan.DescriptorBufferInfo;
      } else {
        // A texture is bound in the layout it rests in (a sampled one the
        // shader-read layout, a storage texture the general); a sampler has none
        images[i] = new vulkan.DescriptorImageInfo(e.backend.sampler, e.backend.view, e.backend.imageLayout);
        writes[i].pImageInfo = (&images as *u8 + i * mem.sizeof[vulkan.DescriptorImageInfo]()) as *vulkan.DescriptorImageInfo;
      }
      i = i + 1usize;
    }
    vulkan.updateDescriptorSets(backend.device, u32.from(entries.len), &writes as *vulkan.WriteDescriptorSet, 0u32, nullp());
    result;
  }

  // Its end, after its buffers and swapchains, once the GPU is idle
  fn final(self &uni) {
    if !self.isValid() { return; }
    vulkan.deviceWaitIdle(backend.device);
    mut i = 0usize;
    while i < 2usize {
      mut d = 0usize;
      while d < usize.from(queue.backend.frames[i].releasedCount) {
        vulkan.destroyBuffer(backend.device, queue.backend.frames[i].released[d].buffer, nullp());
        vulkan.freeMemory(backend.device, queue.backend.frames[i].released[d].memory, nullp());
        d = d + 1usize;
      }
      vulkan.destroyCommandPool(backend.device, queue.backend.frames[i].pool, nullp());
      vulkan.destroyFence(backend.device, queue.backend.frames[i].fence, nullp());
      mut r = 0usize;
      while r < usize.from(queue.backend.frames[i].retiredCount) {
        vulkan.destroyBuffer(backend.device, queue.backend.frames[i].retired[r].buffer, nullp());
        vulkan.freeMemory(backend.device, queue.backend.frames[i].retired[r].memory, nullp());
        r = r + 1usize;
      }
      if queue.backend.frames[i].staging.buffer.h != 0u64 {
        vulkan.destroyBuffer(backend.device, queue.backend.frames[i].staging.buffer, nullp());
        vulkan.freeMemory(backend.device, queue.backend.frames[i].staging.memory, nullp());
      }
      i = i + 1usize;
    }
    vulkan.destroyDevice(backend.device, nullp());
  }
}

// End the current frame: one submission, of the frame's uploads if there
// are any, which waits for the acquired swapchain image if nothing did,
// signals 'signalCount' semaphores and the frame's fence (a signal covers
// every command submitted before it), and moves on to the next frame
fn endFrameSignalling(device &mut Device, signalCount u32, signals *vulkan.SemaphoreSubmitInfo) bool {
  imm i = usize.from(device.queue.backend.frameIndex);
  imm ok = submitCommands(&mut device.queue, nullCommandBuffer(), device.queue.backend.frames[i].fence,
    signalCount, signals);
  device.queue.backend.frames[i].pending = ok;
  device.queue.backend.frameIndex = (device.queue.backend.frameIndex + 1u32) % FRAMES_IN_FLIGHT;
  device.queue.backend.inFrame = false;
  device.frameNumber = device.frameNumber + 1u64;
  ok;
}

// The first memory type of those in 'bits' that has all of 'want'
fn memoryType(props &vulkan.PhysicalDeviceMemoryProperties, bits u32, want u32) u32 {
  mut i = 0u32;
  while i < props.memoryTypeCount {
    if (bits & (1u32 << i)) != 0u32 and (props.memoryTypes[usize.from(i)].propertyFlags & want) == want { return i; }
    i = i + 1u32;
  }
  0xFFFFFFFFu32;
}

// Memory of a type in 'bits' with 'want', of 'size' bytes: its own
// allocation
fn allocate(device vulkan.Device, props &vulkan.PhysicalDeviceMemoryProperties, req &vulkan.MemoryRequirements,
    want u32) vulkan.DeviceMemory {
  mut memory = new vulkan.DeviceMemory(0u64);
  imm typeIndex = memoryType(props, req.memoryTypeBits, want);
  if typeIndex == 0xFFFFFFFFu32 {
    fail("no memory type suits the buffer or texture");
    return memory;
  }
  imm mai = new vulkan.MemoryAllocateInfo(allocationSize: req.size, memoryTypeIndex: typeIndex);
  check(vulkan.allocateMemory(device, &mai, nullp(), &mut memory), "vkAllocateMemory");
  memory;
}

// The memory type for a buffer the CPU maps as 'mapping' says (MAP_READ,
// MAP_WRITE, both), of those in 'bits'. One it writes is in coherent memory
// (write-combined, uncached, where the GPU has it: right for writes, which
// the CPU never reads back); one it writes and reads, coherent and cached
// if there is such, else as one it writes. One it only reads is in cached
// memory, which the CPU reads as fast as its own (on the RTX 4060 Laptop,
// 40 MB copied out in 6 ms from cached memory, 135 ms from uncached, which
// the CPU reads without caching or prefetching): coherent and cached if
// there is such, else cached, which its 'mappedRange' then invalidates,
// else coherent, as one it writes.
fn mappedMemoryType(props &vulkan.PhysicalDeviceMemoryProperties, bits u32, mapping u32) u32 {
  imm visible = vulkan.MEMORY_PROPERTY_HOST_VISIBLE_BIT;
  imm coherent = vulkan.MEMORY_PROPERTY_HOST_COHERENT_BIT;
  imm cached = vulkan.MEMORY_PROPERTY_HOST_CACHED_BIT;
  mut t = 0xFFFFFFFFu32;
  if (mapping & BUFFER_USAGE_MAP_READ) != 0u32 {
    t = memoryType(props, bits, visible | coherent | cached);
    if t == 0xFFFFFFFFu32 and (mapping & BUFFER_USAGE_MAP_WRITE) == 0u32 {
      t = memoryType(props, bits, visible | cached);
    }
  }
  if t == 0xFFFFFFFFu32 { t = memoryType(props, bits, visible | coherent); }
  t;
}

// A buffer of 'size' bytes with Vulkan's 'usage', in memory of its own: the
// CPU's, and mapped, if 'mapping' (MAP_READ, MAP_WRITE or both: how the CPU
// uses it), else the GPU's
fn allocateBuffer(device vulkan.Device, props &vulkan.PhysicalDeviceMemoryProperties, size u64, usage u32,
    mapping u32) BufferBackend {
  mut result = new BufferBackend(device, new vulkan.Buffer(0u64), new vulkan.DeviceMemory(0u64), nullp(), true);
  imm mapped = mapping != 0u32;
  imm bci = new vulkan.BufferCreateInfo(size: size, usage: usage, pQueueFamilyIndices: null);
  mut buffer = new vulkan.Buffer(0u64);
  if !check(vulkan.createBuffer(device, &bci, nullp(), &mut buffer), "vkCreateBuffer") { return result; }
  result.buffer = buffer;
  mut req = zeroed[vulkan.MemoryRequirements]();
  vulkan.getBufferMemoryRequirements(device, buffer, &mut req);
  mut memory = new vulkan.DeviceMemory(0u64);
  if mapped {
    imm typeIndex = mappedMemoryType(props, req.memoryTypeBits, mapping);
    if typeIndex == 0xFFFFFFFFu32 {
      fail("no memory type suits the buffer or texture");
      return result;
    }
    result.coherent = (props.memoryTypes[usize.from(typeIndex)].propertyFlags
      & vulkan.MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0u32;
    imm mai = new vulkan.MemoryAllocateInfo(allocationSize: req.size, memoryTypeIndex: typeIndex);
    check(vulkan.allocateMemory(device, &mai, nullp(), &mut memory), "vkAllocateMemory");
  } else {
    memory = allocate(device, props, &req, vulkan.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
  }
  if memory.h == 0u64 { return result; }
  result.memory = memory;
  check(vulkan.bindBufferMemory(device, buffer, memory, 0u64), "vkBindBufferMemory");
  if mapped {
    mut p = nullp();
    if check(vulkan.mapMemory(device, memory, 0u64, vulkan.WHOLE_SIZE, 0u32, &mut p), "vkMapMemory") {
      result.mapped = p;
    }
  }
  result;
}

// A 2-D image 'width' by 'height' of 'format' and Vulkan's 'usage', in the
// GPU's memory, of its own, and a view of all of it
fn makeImage(device vulkan.Device, props &vulkan.PhysicalDeviceMemoryProperties, width u32, height u32,
    format u32, usage u32, image &mut vulkan.Image, memory &mut vulkan.DeviceMemory, view &mut vulkan.ImageView) bool {
  makeImageLevels(device, props, width, height, format, usage, 1u32, 1u32, 0u32, false, image, memory, view);
}

// The same, of 'levels' mip levels and 'layers' layers, made with 'flags'
// (cube-compatible, say); the view is of every level and layer, 2-D or, with
// several layers, a 2-D array. A 'volume' is 3-D, 'layers' deep, its view 3-D.
fn makeImageLevels(device vulkan.Device, props &vulkan.PhysicalDeviceMemoryProperties, width u32, height u32,
    format u32, usage u32, levels u32, layers u32, flags u32, volume bool, image &mut vulkan.Image,
    memory &mut vulkan.DeviceMemory, view &mut vulkan.ImageView) bool {
  mut imageType = vulkan.IMAGE_TYPE_2D;
  mut depth = 1u32;
  mut arrayLayers = layers;
  if volume {
    imageType = vulkan.IMAGE_TYPE_3D;
    depth = layers;
    arrayLayers = 1u32;
  }
  imm ici = new vulkan.ImageCreateInfo(flags: flags, imageType: imageType, format: format,
    extent: new vulkan.Extent3D(width, height, depth), mipLevels: levels, arrayLayers: arrayLayers, usage: usage,
    pQueueFamilyIndices: null);
  if !check(vulkan.createImage(device, &ici, nullp(), image), "vkCreateImage") { return false; }
  mut req = zeroed[vulkan.MemoryRequirements]();
  vulkan.getImageMemoryRequirements(device, *image, &mut req);
  *memory = allocate(device, props, &req, vulkan.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
  if memory.h == 0u64 { return false; }
  if !check(vulkan.bindImageMemory(device, *image, *memory, 0u64), "vkBindImageMemory") { return false; }
  mut viewType = vulkan.IMAGE_VIEW_TYPE_2D;
  if arrayLayers > 1u32 { viewType = vulkan.IMAGE_VIEW_TYPE_2D_ARRAY; }
  if volume { viewType = vulkan.IMAGE_VIEW_TYPE_3D; }
  imm vci = new vulkan.ImageViewCreateInfo(image: *image, viewType: viewType, format: format,
    components: new vulkan.ComponentMapping(), subresourceRange: new vulkan.ImageSubresourceRange(aspectMask: aspectOf(format),
    levelCount: levels, layerCount: arrayLayers));
  check(vulkan.createImageView(device, &vci, nullp(), view), "vkCreateImageView");
}

fn makePipelineLayout(device vulkan.Device, setCount u32, sets &Array[vulkan.DescriptorSetLayout, 4],
    immediateSize u32) PipelineLayout {
  mut result = new PipelineLayout(new PipelineLayoutBackend(device, new vulkan.PipelineLayout(0u64)), immediateSize);
  if (device as *u8 as usize) == 0usize { return result; }
  if immediateSize > MAX_IMMEDIATE_SIZE or (immediateSize & 3u32) != 0u32 {
    fail("a pipeline layout's immediates are more than 128 bytes, or not a multiple of 4");
    return result;
  }
  imm range = new vulkan.PushConstantRange(immediateStages(), 0u32, immediateSize);
  mut ranges = 0u32;
  if immediateSize > 0u32 { ranges = 1u32; }
  imm ci = new vulkan.PipelineLayoutCreateInfo(setLayoutCount: setCount,
    pSetLayouts: sets as *vulkan.DescriptorSetLayout, pushConstantRangeCount: ranges,
    pPushConstantRanges: &range as *vulkan.PushConstantRange);
  mut layout = new vulkan.PipelineLayout(0u64);
  check(vulkan.createPipelineLayout(device, &ci, nullp(), &mut layout), "vkCreatePipelineLayout");
  result.backend.layout = layout;
  result;
}
